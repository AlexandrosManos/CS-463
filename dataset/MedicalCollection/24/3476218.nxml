thor"><name><surname>Sabatowski</surname><given-names>R</given-names></name><name><surname>Huber</surname><given-names>M</given-names></name><name><surname>Meuser</surname><given-names>T</given-names></name><name><surname>Radbruch</surname><given-names>L</given-names></name></person-group><article-title>SUNCT syndrome: a treatment option with local opioid blockade of the superior cervical ganglion? A case report</article-title><source>Cephalalgia</source><year>2001</year><volume>21</volume><fpage>154</fpage><lpage>156</lpage><pub-id pub-id-type="doi">10.1046/j.1468-2982.2001.00180.x</pub-id><pub-id pub-id-type="pmid">11422100</pub-id></mixed-citation></ref><ref id="CR10"><label>10.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kuhn</surname><given-names>J</given-names></name><name><surname>Vosskaemper</surname><given-names>M</given-names></name><name><surname>Bewermeyer</surname><given-names>H</given-names></name></person-group><article-title>SUNCT syndrome: a possible bilateral case responding to topiramate</article-title><source>Neurology</source><year>2005</year><volume>64</volume><fpage>2159</fpage><pub-id pub-id-type="doi">10.1212/01.WNL.0000166029.87816.A3</pub-id><pub-id pub-id-type="pmid">15985603</pub-id></mixed-citation></ref><ref id="CR11"><label>11.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cohen</surname><given-names>A</given-names></name></person-group><article-title>Short-lasting unilateral neuralgiform headache attacks with conjuctival injection and tearing</article-title><source>Cephalalagia</source><year>2007</year><volume>27</volume><fpage>824</fpage><lpage>832</lpage><pub-id pub-id-type="doi">10.1111/j.1468-2982.2007.01352.x</pub-id></mixed-citation></ref><ref id="CR12"><label>12.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Matharu</surname><given-names>MS</given-