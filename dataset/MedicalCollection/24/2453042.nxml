</source><year>2007</year><volume>357</volume><fpage>1705</fpage><lpage>1715</lpage><!--PubMed citation query: 'N Engl J Med||357|1705||bib11|'--><pub-id pub-id-type="pmid">17960013</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Psyrri</surname><given-names>A</given-names></name><name><surname>DiMaio</surname><given-names>D</given-names></name></person-group><article-title>Human papillomavirus in cervical and head-and-neck cancer</article-title><source>Nat Clin Pract Oncol</source><year>2008</year><volume>5</volume><fpage>24</fpage><lpage>31</lpage><!--PubMed citation query: 'Nat Clin Pract Oncol||5|24||bib12|'--><pub-id pub-id-type="pmid">18097454</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Psyrri</surname><given-names>A</given-names></name><name><surname>Kwong</surname><given-names>M</given-names></name><name><surname>DiStasio</surname><given-names>S</given-names></name><name><surname>Lekakis</surname><given-names>L</given-names></name><name><surname>Kassar</surname><given-names>M</given-names></name><name><surname>Sasaki</surname><given-names>C</given-names></name><name><surname>Wilson</surname><given-names>LD</given-names></name><name><surname>Haffty</surname><given-names>BG</given-names></name><name><surname>Son</surname><given-names>YH</given-names></name><name><surname>Ross</surname><given-names>DA</given-names></name><name><surname>Weinberger</surname><given-names>PM</given-names></name><name><surname>Chung</surname><given-names>GG</given-names></name><name><surname>Zelterman</surname><given-names>D</given-names></name><name><surname>Burtness</surname><given-names>BA</given-names></name><name><surname>Cooper</surname><given-names>DL</given-names></name></person-group><article-title>Cisplatin, fluorouracil, and leucovorin induction chemotherapy followed by concurrent cisplatin chemoradiother