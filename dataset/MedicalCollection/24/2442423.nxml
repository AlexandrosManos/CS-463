<surname>Depino</surname><given-names>AM</given-names></name><name><surname>Alonso</surname><given-names>M</given-names></name><name><surname>Ferrari</surname><given-names>C</given-names></name><name><surname>del Rey</surname><given-names>A</given-names></name><name><surname>Anthony</surname><given-names>D</given-names></name><name><surname>Besedovsky</surname><given-names>H</given-names></name><etal/></person-group><article-title>Learning modulation by endogenous hippocampal IL-1: blockade of endogenous IL-1 facilitates memory formation</article-title><source>Hippocampus</source><year>2004</year><volume>14</volume><fpage>526</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">15224987</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Depino</surname><given-names>A</given-names></name><name><surname>Earl</surname><given-names>C</given-names></name><name><surname>Kaczmarczyk</surname><given-names>E</given-names></name><name><surname>Ferrari</surname><given-names>C</given-names></name><name><surname>Besedovsky</surname><given-names>H</given-names></name><name><surname>del Rey</surname><given-names>A</given-names></name><etal/></person-group><article-title>Microglial activation with atypical pro-inflammatory cytokine expression in a rat model of Parkinson's disease</article-title><source>Eur J Neurosci</source><year>2003</year><volume>18</volume><fpage>2731</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">14656322</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dinarello</surname><given-names>CA</given-names></name></person-group><article-title>Interleukin-1 and interleukin-1 antagonism</article-title><source>Blood</source><year>1991</year><volume>77</volume><fpage>1627</fpage><lpage>52</lpage><pub-id pub-id-type="pmid">1826616</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-grou