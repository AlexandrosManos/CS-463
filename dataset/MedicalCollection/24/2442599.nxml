"doi">10.1080/07853890310004138</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pienim&#x000e4;ki</surname><given-names>TT</given-names></name><name><surname>Tarvainen</surname><given-names>TK</given-names></name><name><surname>Siira</surname><given-names>PT</given-names></name><name><surname>Vanharanta</surname><given-names>H</given-names></name></person-group><article-title>Progressive Strengthening and Stretching Exercises and Ultrasound for Chronic Lateral Epicondylitis</article-title><source>Physiotherapy</source><year>1996</year><volume>82</volume><fpage>522</fpage><lpage>530</lpage><pub-id pub-id-type="doi">10.1016/S0031-9406(05)66275-X</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Visnes</surname><given-names>H</given-names></name><name><surname>Bahr</surname><given-names>R</given-names></name></person-group><article-title>The evolution of eccentric training as treatment for patellar tendinopathy (jumper's knee): a critical review of exercise programmes</article-title><source>Br J Sports Med</source><year>2007</year><volume>41</volume><fpage>217</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">17261559</pub-id><pub-id pub-id-type="doi">10.1136/bjsm.2006.032417</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van Tulder</surname><given-names>M</given-names></name><name><surname>Malmivaara</surname><given-names>A</given-names></name><name><surname>Koes</surname><given-names>B</given-names></name></person-group><article-title>Repetitive strain injury</article-title><source>Lancet</source><year>2007</year><volume>369</volume><fpage>1815</fpage><lpage>22</lpage><pub-id pub-id-type="pmid">17531890</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(07)60820-4</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Woodley</surname><given-names>BL</given-names></name><name><surname>Newsham-West</surname><given-names>RJ</given-names></name><name><surname>Baxter</surname><given-names>GD</given-names></name></person-group><article-title>Chronic tendinopathy: effectiveness of eccentric exercise</article-title><source>Br J Sports Med</source><year>2007</year><volume>41</volume><fpage>188</fpage><lpage>98</lpage><comment>discussion 199.</comment><pub-id pub-id-type="pmid">17062655</pub-id><pub-id pub-id-type="doi">10.1136/bjsm.2006.029769</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kingma</surname><given-names>JJ</given-names></name><name><surname>de Knikker</surname><given-names>R</given-names></name><name><surname>Wittink</surname><given-names>HM</given-names></name><name><surname>Takken</surname><given-names>T</given-names></name></person-group><article-title>Eccentric overload training in patients with chronic Achilles tendinopathy: a systematic review</article-title><source>Br J Sports Med</source><year>2007</year><volume>41</volume><fpage>e3</fpage><pub-id pub-id-type="pmid">17035479</pub-id><pub-id pub-id-type="doi">10.1136/bjsm.2006.030916</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bisset</surname><given-names>L</given-names></name><name><surname>Beller</surname><given-names>E</given-names></name><name><surname>Jull</surname><given-names>G</given-names></name><name><surname>Brooks</surname><given-names>P</given-names></name><name><surname>Darnell</surname><given-names>R</given-names></name><name><surname>Vicenzino</surname><given-names>B</given-names></name></person-group><article-title>Mobilisation with movement and exercise, corticosteroid injection, or wait and see for tennis elbow: randomised trial</article-title><source>Bmj</source><year