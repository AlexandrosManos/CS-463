son-group person-group-type="author"><name><surname>Kral</surname><given-names>JG</given-names></name><name><surname>Paez</surname><given-names>W</given-names></name><name><surname>Wolfe</surname><given-names>BM</given-names></name></person-group><article-title>Vagal nerve function in obesity: therapeutic implications</article-title><source><italic>World Journal of Surgery</italic></source><year>2009</year><volume>33</volume><issue>10</issue><fpage>1995</fpage><lpage>2006</lpage><pub-id pub-id-type="other">2-s2.0-70349314685</pub-id><pub-id pub-id-type="pmid">19618240</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Camilleri</surname><given-names>M</given-names></name><name><surname>Toouli</surname><given-names>J</given-names></name><name><surname>Herrera</surname><given-names>MF</given-names></name><name><surname>Kow</surname><given-names>L</given-names></name><name><surname>Pantoja</surname><given-names>JP</given-names></name><name><surname>Billington</surname><given-names>CJ</given-names></name><etal/></person-group><article-title>Selection of electrical algorithms to treat obesity with intermittent vagal block using an implantable medical device</article-title><source><italic>Surgery for Obesity and Related Diseases</italic></source><year>2009</year><volume>5</volume><fpage>224</fpage><lpage>230</lpage><pub-id pub-id-type="pmid">18996767</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Camilleri</surname><given-names>M</given-names></name><name><surname>Toouli</surname><given-names>J</given-names></name><name><surname>Herrera</surname><given-names>MF</given-names></name><etal/></person-group><article-title>Intra-abdominal vagal blocking (VBLOC therapy): clinical results with a new implantable medical device</article-title><source><it