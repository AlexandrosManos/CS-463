><name><surname>Miyazaki</surname><given-names>H</given-names></name><name><surname>Fukazawa</surname><given-names>K</given-names></name><name><surname>Sawada</surname><given-names>K</given-names></name><name><surname>Koike</surname><given-names>T</given-names></name><name><surname>Kuwabara</surname><given-names>M</given-names></name><name><surname>Ikeda</surname><given-names>H</given-names></name><name><surname>Ikebuchi</surname><given-names>K</given-names></name></person-group><article-title>Ex vivo expansion of human UC blood primitive hematopoietic progenitors and transplantable stem cells using human primary BM stromal cells and human AB serum</article-title><source>Cytotherapy</source><year>2002</year><volume>4</volume><fpage>109</fpage><lpage>118</lpage><pub-id pub-id-type="pmid">12006206</pub-id><pub-id pub-id-type="doi">10.1080/146532402317381811</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heng</surname><given-names>BC</given-names></name><name><surname>Cao</surname><given-names>T</given-names></name><name><surname>Stanton</surname><given-names>LW</given-names></name><name><surname>Robson</surname><given-names>P</given-names></name><name><surname>Olsen</surname><given-names>B</given-names></name></person-group><article-title>Strategies for directing the differentiation of stem cells into the osteogenic lineage in vitro</article-title><source>J Bone Miner Res</source><year>2004</year><volume>19</volume><fpage>1379</fpage><lpage>1394</lpage><pub-id pub-id-type="pmid">15312238</pub-id><pub-id pub-id-type="doi">10.1359/JBMR.040714</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>zur Nieden</surname><given-names>NI</given-names></name><name><surname>Kempka</surname><given-names>G</given-names></name><name><surname>Rancourt</surname><given-names>DE</given-names></name><name><surname>Ahr</surname><give