itation citation-type="journal"><person-group person-group-type="author"><name><surname>Gladden</surname><given-names>LB</given-names></name></person-group><article-title>Lactate metabolism: a new paradigm for the third millennium</article-title><source>J Physiol</source><year>2004</year><volume>558</volume><fpage>5</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">15131240</pub-id><pub-id pub-id-type="doi">10.1113/jphysiol.2003.058701</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Levy</surname><given-names>B</given-names></name><name><surname>Gibot</surname><given-names>S</given-names></name><name><surname>Franck</surname><given-names>P</given-names></name><name><surname>Cravoisy</surname><given-names>A</given-names></name><name><surname>Bollaert</surname><given-names>PE</given-names></name></person-group><article-title>Relation between muscle Na+K+ ATPase activity and raised lactate concentrations in septic shock: a prospective study</article-title><source>Lancet</source><year>2005</year><volume>365</volume><fpage>871</fpage><lpage>875</lpage><pub-id pub-id-type="pmid">15752531</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(05)71045-X</pub-id></citation></ref></ref-list></back></article>