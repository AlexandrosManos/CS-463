oup person-group-type="author"><name><surname>Kuttner</surname><given-names>L</given-names></name></person-group><article-title>Management of young children's acute pain and anxiety during invasive medical procedures</article-title><source><italic>Pediatrician</italic></source><year>1989</year><volume>16</volume><issue>1-2</issue><fpage>39</fpage><lpage>44</lpage><pub-id pub-id-type="pmid">2657691</pub-id></citation></ref><ref id="B20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lang</surname><given-names>EV</given-names></name><name><surname>Benotsch</surname><given-names>EG</given-names></name><name><surname>Fick</surname><given-names>LJ</given-names></name><etal/></person-group><article-title>Adjunctive non-pharmacological analgesia for invasive medical procedures: a randomised trial</article-title><source><italic>The Lancet</italic></source><year>2000</year><volume>355</volume><issue>9214</issue><fpage>1486</fpage><lpage>1490</lpage></citation></ref><ref id="B21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lang</surname><given-names>EV</given-names></name><name><surname>Joyce</surname><given-names>JS</given-names></name><name><surname>Spiegel</surname><given-names>D</given-names></name><name><surname>Hamilton</surname><given-names>D</given-names></name><name><surname>Lee</surname><given-names>KK</given-names></name></person-group><article-title>Self-hypnotic relaxation during interventional radiological procedures: effects on pain perception and intravenous drug use</article-title><source><italic>International Journal of Clinical and Experimental Hypnosis</italic></source><year>1996</year><volume>44</volume><issue>2</issue><fpage>106</fpage><lpage>119</lpage><pub-id pub-id-type="pmid">8871338</pub-id></citation></ref><ref id="B22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Manne</surname><given-names>SL</given-names></name><name><surname>Redd</surname><given-names>WH</given-names></name><name><surname>Jacobsen</surname><given-names>PB</given-names></name><name><surname>Gorfinkle</surname><given-names>K</given-names></name><name><surname>Schorr</surname><given-names>O</given-names></name><name><surname>Rapkin</surname><given-names>B</given-names></name></person-group><article-title>Behavioral intervention to reduce child and parent distress during venipuncture</article-title><source><italic>Journal of Consulting and Clinical Psychology</italic></source><year>1990</year><volume>58</volume><issue>5</issue><fpage>565</fpage><lpage>572</lpage><pub-id pub-id-type="pmid">2254503</pub-id></citation></ref><ref id="B23"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Piira</surname><given-names>T</given-names></name><name><surname>Sugiura</surname><given-names>T</given-names></name><name><surname>Champion</surname><given-names>GD</given-names></name><name><surname>Donnelly</surname><given-names>N</given-names></name><name><surname>Cole</surname><given-names>ASJ</given-names></name></person-group><article-title>The role of parental presence in the context of children's medical procedures: a systematic review</article-title><source><italic>Child: Care, Health and Development</italic></source><year>2005</year><volume>31</volume><issue>2</issue><fpage>233</fpage><lpage>243</lpage></citation></ref><ref id="B24"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pretzlik</surname><given-names>U</given-names></name><name><surname>Sylva</surname><given-names>K</given-names></name></person-group><article-title>Paediatric patients' distress and coping: an observational measure</article-title><source><italic>Archives of Disease in Childhood</italic></source><year>1999</year><volume>81</volume><issue>6</issue><fpage>528</fpage><lpage>530</lpage>