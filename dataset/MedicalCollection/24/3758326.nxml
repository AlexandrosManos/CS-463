td align="left" rowspan="1" colspan="1">Replication Korea<xref ref-type="table-fn" rid="nt105">e</xref></td><td align="left" rowspan="1" colspan="1">0.696</td><td align="left" rowspan="1" colspan="1">0.801</td><td align="left" rowspan="1" colspan="1">1.761 (1.377&#x02013;2.251)</td><td align="left" rowspan="1" colspan="1">4.03&#x000d7;10<sup>&#x02212;6</sup></td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">T</td><td align="left" rowspan="1" colspan="1">Meta-<italic>P</italic><xref ref-type="table-fn" rid="nt106">f</xref></td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">1.41&#x000d7;10<sup>&#x02212;15</sup></td></tr><tr><td align="left" rowspan="1" colspan="1">rs6993775</td><td align="left" rowspan="1" colspan="1">8</td><td align="left" rowspan="1" colspan="1">11407398</td><td align="left" rowspan="1" colspan="1"><italic>BLK</italic></td><td align="left" rowspan="1" colspan="1">A</td><td align="left" rowspan="1" colspan="1">GWAS Taiwan</td><td align="left" rowspan="1" colspan="1">0.719</td><td align="left" rowspan="1" colspan="1">0.783</td><td align="left" rowspan="1" colspan="1">1.409 (1.197&#x02013;1.660)</td><td align="left" rowspan="1" colspan="1">3.86&#x000d7;10<sup>&#x02212;5</sup></td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">T</td><td align="left" rowspan="1" colspan="1">Replication Taiwan</td><td align="left" rowspan="1" colspan="1">0.726</td><td align="left" rowspan="1" colspan="1">0.797</td><td align="left" rowspan="1" colspan="1">1.486 (1.155&#x02013;1.912)</td><td align="left" rowspan="1" col