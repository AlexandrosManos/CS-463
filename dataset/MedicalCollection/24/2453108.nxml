tation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>C</given-names></name><name><surname>Rose</surname><given-names>G</given-names></name></person-group><article-title>Posttraining paradoxical sleep in rats is increased after spatial learning in the Morris water maze</article-title><source>Behavioral neuroscience</source><year>1997</year><volume>111</volume><fpage>1197</fpage><lpage>1204</lpage><pub-id pub-id-type="pmid">9438789</pub-id><pub-id pub-id-type="doi">10.1037/0735-7044.111.6.1197</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McEwen</surname><given-names>B</given-names></name></person-group><article-title>Stress and hippocampal plasticity</article-title><source>Annual review of neuroscience</source><year>1999</year><volume>22</volume><fpage>105</fpage><lpage>22</lpage><pub-id pub-id-type="pmid">10202533</pub-id><pub-id pub-id-type="doi">10.1146/annurev.neuro.22.1.105</pub-id></citation></ref><ref id="B17"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Selye</surname><given-names>H</given-names></name></person-group><article-title>Stress &#x02013; the physiology and pathology of exposure to systemic stress</article-title><source>Montreal: Acta Inc Med Publ</source><year>1950</year></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Andersen</surname><given-names>M</given-names></name><name><surname>Martins</surname><given-names>P</given-names></name><name><surname>D'Almeida</surname><given-names>V</given-names></name><name><surname>Bignotto</surname><given-names>M</given-names></name><name><surname>Tufik</surname><given-names>S</given-names></name></person-group><article-title>Endocrinological and catecholaminergic alterations during sleep deprivation and recovery in male rats</article-title><source>Journal of sleep research</source><year>2005</year><volume>14</volume><fpage>83</fpage><lpage>90</lpage><pub-id pub-id-type="pmid">15743338</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2869.2004.00428.x</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cirelli</surname><given-names>C</given-names></name><name><surname>Tononi</surname><given-names>G</given-names></name></person-group><article-title>Differential expression of plasticity-related genes in waking and sleep and their regulation by the noradrenergic system</article-title><source>The Journal of neuroscience</source><year>2000</year><volume>20</volume><fpage>9187</fpage><lpage>9194</lpage><pub-id pub-id-type="pmid">11124996</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cirelli</surname><given-names>C</given-names></name><name><surname>Tononi</surname><given-names>G</given-names></name></person-group><article-title>The search for the molecular correlates of sleep and wakefulness</article-title><source>Sleep Medicine Reviews</source><year>2001</year><volume>5</volume><fpage>399</fpage><lpage>410</lpage><pub-id pub-id-type="doi">10.1053/smrv.2001.0160</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tononi</surname><given-names>G</given-names></name><name><surname>Cirelli</surname><given-names>C</given-names></name></person-group><article-title>Sleep function and synaptic homeostasis</article-title><source>Sleep medicine reviews</source><year>2006</year><volume>10</volume><fpage>49</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">16376591</pub-id><pub-id pub-id-type="doi">10.1016/j.smrv.2005.05.002</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cirelli</surname><given-names>C</given-names></name><name>