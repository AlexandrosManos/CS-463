ation-type="journal"><person-group person-group-type="author"><name><surname>Walker</surname><given-names>M</given-names></name><name><surname>Stickgold</surname><given-names>R</given-names></name></person-group><article-title>Sleep, memory, and plasticity</article-title><source>Annual review of psychology</source><year>2006</year><volume>57</volume><fpage>139</fpage><lpage>166</lpage><pub-id pub-id-type="pmid">16318592</pub-id><pub-id pub-id-type="doi">10.1146/annurev.psych.56.091103.070307</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cirelli</surname><given-names>C</given-names></name></person-group><article-title>Cellular consequences of sleep deprivation in the brain</article-title><source>Sleep medicine reviews</source><year>2006</year><volume>10</volume><fpage>307</fpage><lpage>321</lpage><pub-id pub-id-type="pmid">16920372</pub-id><pub-id pub-id-type="doi">10.1016/j.smrv.2006.04.001</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Porkka-Heiskanen</surname><given-names>T</given-names></name></person-group><article-title>Gene expression during sleep, wakefulness and sleep deprivation</article-title><source>Frontiers in bioscience</source><year>2003</year><volume>8</volume><fpage>s421</fpage><lpage>s437</lpage><pub-id pub-id-type="pmid">12700105</pub-id><pub-id pub-id-type="doi">10.2741/1073</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Basheer</surname><given-names>R</given-names></name><name><surname>Brown</surname><given-names>R</given-names></name><name><surname>Ramesh</surname><given-names>V</given-names></name><name><surname>Begum</surname><given-names>S</given-names></name><name><surname>McCarley</surname><given-names>R</given-names></name></person-group><article-title>Sleep deprivation-induced protein changes in