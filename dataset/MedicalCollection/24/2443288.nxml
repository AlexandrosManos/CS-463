lm1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Helm</surname><given-names>P</given-names></name><name><surname>Helm</surname><given-names>S</given-names></name></person-group><year>1984</year><article-title>Decrease in menarcheal age from 1966 to 1983 in Denmark.</article-title><source>Acta Obstet Gynecol Scand</source><volume>63</volume><fpage>633</fpage><lpage>635</lpage><pub-id pub-id-type="pmid">6516812</pub-id></citation></ref><ref id="pone.0002728-Bojlen1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bojlen</surname><given-names>K</given-names></name><name><surname>Rasch</surname><given-names>G</given-names></name><name><surname>Bentzon</surname><given-names>MW</given-names></name></person-group><year>1954</year><article-title>The age incidence of the menarche in Copenhagen.</article-title><source>Acta Obstet Gynecol Scand</source><volume>33</volume><fpage>404</fpage><lpage>433</lpage><pub-id pub-id-type="pmid">14375884</pub-id></citation></ref><ref id="pone.0002728-Helm2"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Helm</surname><given-names>P</given-names></name><name><surname>Grolund</surname><given-names>L</given-names></name></person-group><year>1998</year><article-title>A halt in the secular trend towards earlier menarche in Denmark.</article-title><source>Acta Obstet Gynecol Scand</source><volume>77</volume><fpage>198</fpage><lpage>200</lpage><pub-id pub-id-type="pmid">9512327</pub-id></citation></ref><ref id="pone.0002728-Andersen1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Andersen</surname><given-names>E</given-names></name></person-group><year>1968</year><article-title>Skeletal maturation of Danish school children in relation to height, sexual development, and social conditions.</article-title><sour