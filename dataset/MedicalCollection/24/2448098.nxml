<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Ulster Med J</journal-id><journal-title>The Ulster Medical Journal</journal-title><issn pub-type="ppub">0041-6193</issn></journal-meta><article-meta><article-id pub-id-type="pmid">3739062</article-id><article-id pub-id-type="pmc">2448098</article-id><article-id pub-id-type="pmid">3739062</article-id><article-categories><subj-group subj-group-type="heading"><subject>Articles</subject></subj-group></article-categories><title-group><article-title>Investigation of non-cardiac chest pain &#x02014; which oesophageal test?</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Lee</surname><given-names>R J E</given-names></name></contrib><contrib contrib-type="author"><name><surname>Collins</surname><given-names>B J</given-names></name></contrib><contrib contrib-type="author"><name><surname>Spence</surname><given-names>R A J</given-names></name></contrib><contrib contrib-type="author"><name><surname>Crookes</surname><given-names>P F</given-names></name></contrib><contrib contrib-type="author"><name><surname>Campbell</surname><given-names>N P S</given-names></name></contrib><contrib contrib-type="author"><name><surname>Adgey</surname><given-names>A A J</given-names></name></contrib></contrib-group><pub-date pub-type="ppub"><month>04</month><year>1986</year></pub-date><volume>55</volume><issue>1</issue><fpage>49</fpage><lpage>56</lpage><abstract><p>Five different tests were used to evaluate oesophageal function in 22 patients who presented to a cardiac unit with acute chest pain but whose cardiological investigations were negative. Eight patients had an abnormality on oesophagoscopy, 10 had an abnormal pH monitoring study, six had a positive acid infusion test, 10 had an abnormal manometric study and six had an abnormal oseophageal transit scintiscan. Concordance for the three tests of gastro-oesophageal reflux disease was low at 28%, and for the two tests of oesophageal motility only 55%. Only two patients had normal results in all five tests.</p></abstract></article-meta></front><body><supplementary-material content-type="scanned-pages"><graphic xlink:href="ulstermedj00088-0054.tif" xlink:title="scanned-page" xlink:role="49" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="ulstermedj00088-0055.tif" xlink:title="scanned-page" xlink:role="50" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="ulstermedj00088-0056.tif" xlink:title="scanned-page" xlink:role="51" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="ulstermedj00088-0057.tif" xlink:title="scanned-page" xlink:role="52" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="ulstermedj00088-0058.tif" xlink:title="scanned-page" xlink:role="53" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="ulstermedj00088-0059.tif" xlink:title="scanned-page" xlink:role="54" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="ulstermedj00088-0060.tif" xlink:title="scanned-page" xlink:role="55" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="ulstermedj00088-0061.tif" xlink:title="scanned-page" xlink:role="56" mimetype="image" mime-subtype="tiff"/></supplementary-material></body></article>