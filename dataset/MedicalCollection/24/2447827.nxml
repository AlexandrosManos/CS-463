mes></name><name><surname>Lange</surname><given-names>MP</given-names></name></person-group><article-title>What do patients know about their heart failure?</article-title><source>Applied Nursing Research</source><year>2002</year><volume>15</volume><fpage>200</fpage><lpage>208</lpage><pub-id pub-id-type="pmid">12444578</pub-id><pub-id pub-id-type="doi">10.1053/apnr.2002.35959</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vogels</surname><given-names>R</given-names><suffix>L.C.</suffix></name><name><surname>Scheltens</surname><given-names>P</given-names></name><name><surname>Schroeder-Tanka</surname><given-names>JM</given-names></name><name><surname>Weinstein</surname><given-names>HC</given-names></name></person-group><article-title>Cognitive impairment in heart failure: A systematic review of the literature</article-title><source>Eur J Heart Fail</source><year>2007</year><volume>9</volume><fpage>440</fpage><lpage>449</lpage><pub-id pub-id-type="pmid">17174152</pub-id><pub-id pub-id-type="doi">10.1016/j.ejheart.2006.11.001</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hedemalm</surname><given-names>A</given-names></name><name><surname>Schaufelberger</surname><given-names>M</given-names></name><name><surname>Ekman</surname><given-names>I</given-names></name></person-group><article-title>A review of records from follow-up visits for immigrant and Swedish patients at a heart failure clinic</article-title><source>European Journal of Cardiovascular Nursing (EUR-J-CARDIOVASC-NURS)</source><year>2007</year><volume>6</volume><fpage>216</fpage><lpage>222</lpage><pub-id pub-id-type="doi">10.1016/j.ejcnurse.2006.09.005</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Evangelista</surname><given-names>LS</given-names></name><name><surname>Dracup</surname><given-names>K</given-names></name><name><surname>Doering</surname><given-names>LV</given-names></name></person-group><article-title>Treatment-seeking delays in heart failure patients</article-title><source>Journal of Heart and Lung Transplantation (J Heart Lung Transplant)</source><year>2000</year><volume>19</volume><fpage>932</fpage><lpage>938</lpage><pub-id pub-id-type="doi">10.1016/S1053-2498(00)00186-8</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ekman</surname><given-names>I</given-names></name><name><surname>Cleland</surname><given-names>JG</given-names></name><name><surname>Andersson</surname><given-names>B</given-names></name><name><surname>Swedberg</surname><given-names>K</given-names></name></person-group><article-title>Exploring symptoms in chronic heart failure</article-title><source>European Journal of Heart Failure (Eur J Heart Fail)</source><year>2005</year><volume>7</volume><fpage>699</fpage><lpage>703</lpage><pub-id pub-id-type="doi">10.1016/j.ejheart.2005.07.003</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ngo-Metzger</surname><given-names>Q</given-names></name><name><surname>Massagli</surname><given-names>MP</given-names></name><name><surname>Clarridge</surname><given-names>BR</given-names></name><name><surname>Manocchia</surname><given-names>M</given-names></name><name><surname>Davis</surname><given-names>RB</given-names></name><name><surname>Iezzoni</surname><given-names>LI</given-names></name><name><surname>Phillips</surname><given-names>RS</given-names></name></person-group><article-title>Linguistic and cultural barriers to care</article-title><source>Journal of General Internal Medicine (J Gen Intern Med)</source><year>2003</year><volume>18</volume><fpage>44</fpage><lpage>52</lpage><pub-id pub-id-type="doi">10.1046/j.1525-1497.2003.20205.x</pub-id></citation></ref><ref id="B25"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kleinman</surname><given-names>A</given-names></name></person-group><source>Patients and healers in the context of culture</source><year>1980</year><publisher-name>London , University of California Press Ltd</publisher-name></citation></ref></ref-list></back></article>