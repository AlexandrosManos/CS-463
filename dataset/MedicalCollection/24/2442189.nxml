">&#x0002a;&#x0002a;</xref></td><td align="left" rowspan="1" colspan="1">2.08 <italic>&#x0005b;0.94&#x02013;4.06&#x0005d; </italic><xref ref-type="table-fn" rid="nt106">&#x0002a;</xref></td><td align="left" rowspan="1" colspan="1">0.88 <italic>&#x0005b;0.38&#x02013;2.07&#x0005d;</italic></td><td align="left" rowspan="1" colspan="1">1.08 <italic>&#x0005b;0.62&#x02013;1.90&#x0005d;</italic></td><td align="left" rowspan="1" colspan="1">0.92 <italic>&#x0005b;0.55&#x02013;1.55&#x0005d;</italic></td><td align="left" rowspan="1" colspan="1">1.00 <italic>&#x0005b;0.59&#x02013;1.71&#x0005d;</italic></td></tr><tr><td align="left" rowspan="1" colspan="1">25&#x02013;39</td><td align="left" rowspan="1" colspan="1">ref</td><td align="left" rowspan="1" colspan="1">ref</td><td align="left" rowspan="1" colspan="1">ref</td><td align="left" rowspan="1" colspan="1">ref</td><td align="left" rowspan="1" colspan="1">ref</td><td align="left" rowspan="1" colspan="1">ref</td></tr><tr><td align="left" rowspan="1" colspan="1">40&#x02013;54</td><td align="left" rowspan="1" colspan="1">1.61 <italic>&#x0005b;0.59&#x02013;4.43&#x0005d;</italic></td><td align="left" rowspan="1" colspan="1">0.80 <italic>&#x0005b;0.31&#x02013;2.07&#x0005d;</italic></td><td align="left" rowspan="1" colspan="1">0.81 <italic>&#x0005b;0.39&#x02013;1.69&#x0005d;</italic></td><td align="left" rowspan="1" colspan="1">0.69 &#x0005b;0.41&#x02013;1.17&#x0005d;</td><td align="left" rowspan="1" colspan="1">0.76 <italic>&#x0005b;0.48&#x02013;1.19&#x0005d;</italic></td><td align="left" rowspan="1" colspan="1">0.78 <italic>&#x0005b;0.48&#x02013;1.28&#x0005d;</italic></td></tr><tr><td align="left" rowspan="1" colspan="1">55 &#x0002b;</td><td align="left" rowspan="1" colspan="1">1.38 <italic>&#x0005b;0.49&#x02013;3.91&#x0005d;</italic></td><td align="left" rowspan="1" colspan="1">1.18 <italic>&#x0005b;0.49&#x02013;2.82&#x0005d;</italic></td><td align="left" rowspan="1" colspan="1">1.31 <italic>&#x0005b;0.66&#x02013;2.59&#x0005d;</ita