urnal"><person-group person-group-type="author"><name><surname>Brower</surname><given-names>RG</given-names></name><name><surname>Matthay</surname><given-names>M</given-names></name><name><surname>Schoenfeld</surname><given-names>D</given-names></name></person-group><article-title>Meta-analysis of acute lung injury and acute respiratory distress syndrome trials</article-title><source>Am J Respir Crit Care Med</source><year>2002</year><volume>166</volume><fpage>1515</fpage><lpage>1517</lpage><pub-id pub-id-type="pmid">12450936</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hager</surname><given-names>DN</given-names></name><name><surname>Krishnan</surname><given-names>JA</given-names></name><name><surname>Hayden</surname><given-names>DL</given-names></name><name><surname>Brower</surname><given-names>RG</given-names></name><collab>ARDS Clinical Trials Network</collab></person-group><article-title>Tidal volume reduction in patients with acute lung injury when plateau pressures are not high</article-title><source>Am J Respir Crit Care Med</source><year>2005</year><volume>172</volume><fpage>1241</fpage><lpage>1245</lpage><pub-id pub-id-type="pmid">16081547</pub-id><pub-id pub-id-type="doi">10.1164/rccm.200501-048CP</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Steinbrook</surname><given-names>R</given-names></name></person-group><article-title>How best to ventilate? Trial design and patient safety in studies of the Acute Respiratory Distress Syndrome</article-title><source>N Engl J Med</source><year>2003</year><volume>348</volume><fpage>1393</fpage><lpage>1401</lpage><pub-id pub-id-type="pmid">12672870</pub-id><pub-id pub-id-type="doi">10.1056/NEJMhpr030349</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Steinbrook</surname><given-names>R</given-names></name></person-group><article-title>Trial design and patient safety &#x02013; the debate continues</article-title><source>N Engl J Med</source><year>2003</year><volume>349</volume><fpage>629</fpage><lpage>630</lpage><pub-id pub-id-type="pmid">12917298</pub-id><pub-id pub-id-type="doi">10.1056/NEJMp038133</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Deans</surname><given-names>KJ</given-names></name><name><surname>Minneci</surname><given-names>PC</given-names></name><name><surname>Cui</surname><given-names>X</given-names></name><name><surname>Banks</surname><given-names>SM</given-names></name><name><surname>Natanson</surname><given-names>C</given-names></name><name><surname>Eichacker</surname><given-names>PQ</given-names></name></person-group><article-title>Mechanical ventilation in ARDS: one size does not fit all</article-title><source>Crit Care Med</source><year>2005</year><volume>33</volume><fpage>1141</fpage><lpage>1143</lpage><pub-id pub-id-type="pmid">15891350</pub-id><pub-id pub-id-type="doi">10.1097/01.CCM.0000162384.71993.A3</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brower</surname><given-names>R</given-names></name><name><surname>Thompson</surname><given-names>BT</given-names></name><collab>ARDS Network Investigators</collab></person-group><article-title>Tidal volumes in acute respiratory distress syndrome &#x02013; one size does not fit all</article-title><source>Crit Care Med</source><year>2006</year><volume>34</volume><fpage>263</fpage><lpage>264</lpage><pub-id pub-id-type="pmid">16374199</pub-id><pub-id pub-id-type="doi">10.1097/01.CCM.0000191132.12653.05</pub-id></citation></ref></ref-list></back></article>