<given-names>WS</given-names></name><name><surname>Skuta</surname><given-names>GL</given-names></name><name><surname>Watnick</surname><given-names>RL</given-names></name><name><surname>Elner</surname><given-names>VM</given-names></name></person-group><article-title>The effects of subconjunctival mitomycin-C on glaucoma filtration surgery in rabbits.</article-title><source>Arch Ophthalmol</source><year>1991</year><volume>109</volume><fpage>1725</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">1841585</pub-id></citation></ref><ref id="r16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Singh</surname><given-names>G</given-names></name><name><surname>Wilson</surname><given-names>MR</given-names></name><name><surname>Foster</surname><given-names>CS</given-names></name></person-group><article-title>Mitomycin C eye drops as treatment for pterygium.</article-title><source>Ophthalmology</source><year>1988</year><volume>95</volume><fpage>813</fpage><lpage>21</lpage><pub-id pub-id-type="pmid">3211484</pub-id></citation></ref><ref id="r17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Frucht-Pery</surname><given-names>J</given-names></name><name><surname>Rozenman</surname><given-names>Y</given-names></name></person-group><article-title>Mitomycin C therapy for corneal intraepithelial neoplasia.</article-title><source>Am J Ophthalmol</source><year>1994</year><volume>117</volume><fpage>164</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">8116744</pub-id></citation></ref><ref id="r18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Azar</surname><given-names>DT</given-names></name><name><surname>Jain</surname><given-names>S</given-names></name></person-group><article-title>Topical MMC for subepithelial fibrosis after refractive corneal surgery.</article-title><source>Ophthalmology</source><year>2001</