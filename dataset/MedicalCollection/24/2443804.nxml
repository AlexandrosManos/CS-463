-group-type="author"><name><surname>Gandhi</surname><given-names>CS</given-names></name><name><surname>Clark</surname><given-names>E</given-names></name><name><surname>Loots</surname><given-names>E</given-names></name><name><surname>Pralle</surname><given-names>A</given-names></name><name><surname>Isacoff</surname><given-names>EY</given-names></name></person-group><article-title>The orientation and molecular movement of a k(+) channel voltage-sensing domain</article-title><source>Neuron</source><year>2003</year><volume>40</volume><fpage>515</fpage><lpage>525</lpage><pub-id pub-id-type="pmid">14642276</pub-id><pub-id pub-id-type="doi">10.1016/S0896-6273(03)00646-9</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldstein</surname><given-names>SA</given-names></name></person-group><article-title>A structural vignette common to voltage sensors and conduction pores: canaliculi</article-title><source>Neuron</source><year>1996</year><volume>16</volume><fpage>717</fpage><lpage>722</lpage><pub-id pub-id-type="pmid">8607990</pub-id><pub-id pub-id-type="doi">10.1016/S0896-6273(00)80092-6</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Larsson</surname><given-names>HP</given-names></name><name><surname>Baker</surname><given-names>OS</given-names></name><name><surname>Dhillon</surname><given-names>DS</given-names></name><name><surname>Isacoff</surname><given-names>EY</given-names></name></person-group><article-title>Transmembrane movement of the shaker K+ channel S4</article-title><source>Neuron</source><year>1996</year><volume>16</volume><fpage>387</fpage><lpage>397</lpage><pub-id pub-id-type="pmid">8789953</pub-id><pub-id pub-id-type="doi">10.1016/S0896-6273(00)80056-2</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Islas</surname><given-na