"><thead><tr><th align="left" rowspan="1" colspan="1">Parameter</th><th align="center" rowspan="1" colspan="1">Result</th><th align="center" rowspan="1" colspan="1">Normal values</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">Complete blood count</td><td align="center" rowspan="1" colspan="1">Normal</td><td align="center" rowspan="1" colspan="1">&#x02009;</td></tr><tr><td align="left" rowspan="1" colspan="1">Renal functions</td><td align="center" rowspan="1" colspan="1">Normal</td><td align="center" rowspan="1" colspan="1">&#x02009;</td></tr><tr><td align="left" rowspan="1" colspan="1">Thyroid stimulating hormone (TSH)</td><td align="center" rowspan="1" colspan="1">&#x0003e;100&#x02009;mU/L</td><td align="center" rowspan="1" colspan="1">0.20&#x02013;4.50&#x02009;mU/L</td></tr><tr><td align="left" rowspan="1" colspan="1">Free T3</td><td align="center" rowspan="1" colspan="1">&#x0003c;0.4&#x02009;pmol/L</td><td align="center" rowspan="1" colspan="1">3.8&#x02013;8.6&#x02009;pmol/L</td></tr><tr><td align="left" rowspan="1" colspan="1">Free T4</td><td align="center" rowspan="1" colspan="1">&#x0003c;5.15&#x02009;pmol/L</td><td align="center" rowspan="1" colspan="1">12&#x02013;22&#x02009;pmol/L</td></tr><tr><td align="left" rowspan="1" colspan="1">Antithyroglobulin antibodies (ATG)</td><td align="center" rowspan="1" colspan="1">470&#x02009;IU/mL</td><td align="center" rowspan="1" colspan="1">&#x0003c;60&#x02009;IU/mL</td></tr><tr><td align="left" rowspan="1" colspan="1">Prolactin</td><td align="center" rowspan="1" colspan="1">28.2&#x02009;ng/mL</td><td align="center" rowspan="1" colspan="1">2&#x02013;18&#x02009;ng/mL</td></tr><tr><td align="left" rowspan="1" colspan="1">Follicle stimulating hormone (FSH)</td><td align="center" rowspan="1" colspan="1">8.24&#x02009;mIU/mL</td><td align="center" rowspan="1" colspan="1">0.3&#x02013;2&#x02009;mIU/mL</td></tr><tr><td align="left" rowspan="1" colspan="1">Luteinizing hormone (LH)</td><td align="center" rowspa