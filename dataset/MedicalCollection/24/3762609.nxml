="top" rowspan="1" colspan="1">Peak expiratory ratio (FEV<sub>1</sub>/FVC) (mean, SD)</td><td align="left" valign="top" rowspan="1" colspan="1">0.476 (0.131)</td><td align="left" valign="top" rowspan="1" colspan="1">0.455 (0.126)</td><td align="left" valign="top" rowspan="1" colspan="1">0.499 (0.133)</td><td align="left" valign="top" rowspan="1" colspan="1">0.067<xref ref-type="table-fn" rid="tfn4-copd-8-389">d</xref></td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">FEV<sub>1</sub> bronchodilator reversibility (mean, SD)</td><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1"/></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;Volume change (mL)</td><td align="left" valign="top" rowspan="1" colspan="1">122.5 (124.1)</td><td align="left" valign="top" rowspan="1" colspan="1">104.8 (113.9)</td><td align="left" valign="top" rowspan="1" colspan="1">142.7 (133.0)</td><td align="left" valign="top" rowspan="1" colspan="1">0.145<xref ref-type="table-fn" rid="tfn4-copd-8-389">d</xref></td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;Percentage change</td><td align="left" valign="top" rowspan="1" colspan="1">5.5 (5.5)</td><td align="left" valign="top" rowspan="1" colspan="1">4.8 (5.0)</td><td align="left" valign="top" rowspan="1" colspan="1">6.4 (5.9)</td><td align="left" valign="top" rowspan="1" colspan="1">0.137<xref ref-type="table-fn" rid="tfn4-copd-8-389">d</xref></td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">GOLD stage (n, % of stage group, 95% CI)</td><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">0.003<xref ref-type="table-fn" rid="tfn1-copd-8-389">a<