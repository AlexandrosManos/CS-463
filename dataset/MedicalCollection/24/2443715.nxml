-8674(86)90817-2</pub-id><pub-id pub-id-type="pmid">3096579</pub-id></mixed-citation></ref><ref id="B7"><mixed-citation publication-type="journal"><name><surname>Bellefroid</surname><given-names>EJ</given-names></name><etal/><article-title>The human genome contains hundreds of genes coding for finger proteins of the Kruppel type</article-title><source>DNA</source><year>1989</year><volume>8</volume><issue>6</issue><fpage>377</fpage><lpage>87</lpage><pub-id pub-id-type="pmid">2505992</pub-id></mixed-citation></ref><ref id="B8"><mixed-citation publication-type="journal"><name><surname>Miller</surname><given-names>J</given-names></name><name><surname>McLachlan</surname><given-names>AD</given-names></name><name><surname>Klug</surname><given-names>A</given-names></name><article-title>Repetitive zinc-binding domains in the protein transcription factor IIIA from Xenopus oocytes</article-title><source>Embo J</source><year>1985</year><volume>4</volume><issue>6</issue><fpage>1609</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">4040853</pub-id></mixed-citation></ref><ref id="B9"><mixed-citation publication-type="journal"><name><surname>Theunissen</surname><given-names>O</given-names></name><etal/><article-title>RNA and DNA binding zinc fingers in Xenopus TFIIIA</article-title><source>Cell</source><year>1992</year><volume>71</volume><issue>4</issue><fpage>679</fpage><lpage>90</lpage><pub-id pub-id-type="doi">10.1016/0092-8674(92)90601-8</pub-id><pub-id pub-id-type="pmid">1423623</pub-id></mixed-citation></ref><ref id="B10"><mixed-citation publication-type="journal"><name><surname>Grondin</surname><given-names>B</given-names></name><name><surname>Bazinet</surname><given-names>M</given-names></name><name><surname>Aubry</surname><given-names>M</given-names></name><article-title>The KRAB zinc finger gene ZNF74 encodes an RNA-binding protein tightly associated with the nuclear matrix</article-title><source>J Biol Chem</source><year>1996</year><volume>271</volume><issue>26</issue><