.8</td><td align="char" char="." rowspan="1" colspan="1">25.5</td><td align="char" char="." rowspan="1" colspan="1">40.2</td></tr><tr><td rowspan="1" colspan="1">Italy</td><td align="char" char="." rowspan="1" colspan="1">12</td><td align="char" char="." rowspan="1" colspan="1">1964</td><td align="char" char="." rowspan="1" colspan="1">99</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="char" char="." rowspan="1" colspan="1">31 818</td><td align="char" char="." rowspan="1" colspan="1">14.9</td><td align="center" rowspan="1" colspan="1">1965&#x02013;1995</td><td align="char" char="." rowspan="1" colspan="1">1.3</td><td align="char" char="." rowspan="1" colspan="1">4.0</td><td align="char" char="." rowspan="1" colspan="1">0.7</td><td align="char" char="." rowspan="1" colspan="1">2.0</td><td align="char" char="." rowspan="1" colspan="1">0.0</td><td align="char" char="." rowspan="1" colspan="1">1.0</td><td align="char" char="(" rowspan="1" colspan="1">56.3 (12.9)</td><td align="char" char="." rowspan="1" colspan="1">72.4</td><td align="char" char="." rowspan="1" colspan="1">62.1</td><td align="char" char="." rowspan="1" colspan="1">38.4</td></tr><tr><td rowspan="1" colspan="1">Lithuania</td><td align="char" char="." rowspan="1" colspan="1">1</td><td align="char" char="." rowspan="1" colspan="1">812</td><td align="char" char="." rowspan="1" colspan="1">14</td><td align="char" char="." rowspan="1" colspan="1">24</td><td align="char" char="." rowspan="1" colspan="1">7478</td><td align="char" char="." rowspan="1" colspan="1">9.0</td><td align="center" rowspan="1" colspan="1">1981&#x02013;2002</td><td align="char" char="." rowspan="1" colspan="1">2.0</td><td align="char" char="." rowspan="1" colspan="1">4.0</td><td align="char" char="." rowspan="1" colspan="1">1.0</td><td align="char" char="." rowspan="1" colspan="1">2.0</td><td align="char" char="." rowspan="1" colspan="1">1.0</td><td align="char" char="." rowspan="1" colspan="1">2.0</td><td align="ch