-type="journal"><person-group person-group-type="author"><name><surname>Bonassi</surname><given-names>S</given-names></name><etal/></person-group><article-title>Are chromosome aberrations in circulating lymphocytes predictive of a future cancer onset in humans? Preliminary results of an Italian cohort study</article-title><source>Cancer Genet. Cytogenet.</source><year>1995</year><volume>79</volume><fpage>133</fpage><lpage>135</lpage><pub-id pub-id-type="pmid">7889505</pub-id></citation></ref><ref id="bib9"><label>9.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hagmar</surname><given-names>L</given-names></name><etal/></person-group><article-title>Chromosomal aberrations in lymphocytes predict human cancer: a report from the European Study Group on Cytogenetic Biomarkers and Health (ESCH)</article-title><source>Cancer Res.</source><year>1998</year><volume>58</volume><fpage>4117</fpage><lpage>4121</lpage><pub-id pub-id-type="pmid">9751622</pub-id></citation></ref><ref id="bib10"><label>10.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bonassi</surname><given-names>S</given-names></name><etal/></person-group><article-title>Chromosomal aberrations in lymphocytes predict human cancer independently of exposure to carcinogens</article-title><source>Cancer Res.</source><year>2000</year><volume>60</volume><fpage>1619</fpage><lpage>1625</lpage><pub-id pub-id-type="pmid">10749131</pub-id></citation></ref><ref id="bib11"><label>11.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rossner</surname><given-names>P</given-names></name><etal/></person-group><article-title>Chromosomal aberration in lymphocytes of healthy subjects and risk of cancer</article-title><source>Environ. Health Perspect.</source><year>2005</year><volume>113</volume><fpage>517</fpage><lpage>520</lpage><pub-id pub-id-type="pmid">15866756</pub-id></citation></ref