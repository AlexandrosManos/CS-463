e><etal/></person-group><article-title>Folate deficiency causes uracil misincorporation into human DNA and chromosome breakage, implications for cancer and neuronal damage</article-title><source>Proc. Natl Acad. Sci. USA</source><year>1997</year><volume>94</volume><fpage>3290</fpage><lpage>3295</lpage><pub-id pub-id-type="pmid">9096386</pub-id></citation></ref><ref id="bib26"><label>26.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kimura</surname><given-names>M</given-names></name><etal/></person-group><article-title>Methylenetetrahydrofolate reductase C677T polymorphism, folic acid and riboflavin are important determinants of genome stability in cultured human lymphocytes</article-title><source>J. Nutr.</source><year>2004</year><volume>134</volume><fpage>48</fpage><lpage>56</lpage><pub-id pub-id-type="pmid">14704292</pub-id></citation></ref><ref id="bib27"><label>27.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bonassi</surname><given-names>S</given-names></name><etal/></person-group><article-title>An increased micronucleus frequency in peripheral blood lymphocytes predicts the risk of cancer in humans</article-title><source>Carcinogenesis</source><year>2007</year><volume>28</volume><fpage>625</fpage><lpage>631</lpage><pub-id pub-id-type="pmid">16973674</pub-id></citation></ref><ref id="bib28"><label>28.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Su&#x000e1;rez</surname><given-names>S</given-names></name><etal/></person-group><article-title>Increased frequency of micronuclei in peripheral blood lymphocytes of subjects infected with <italic>Helicobacter pylori</italic></article-title><source>Mutat. Res.</source><year>2007</year><volume>626</volume><fpage>162</fpage><lpage>170</lpage><pub-id pub-id-type="pmid">17112778</pub-id></citation></ref><ref id="bib29"><label>29.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smerhovsky</surname><given-names>Z</given-names></name><etal/></person-group><article-title>Risk of cancer in an occupationally exposed cohort with increased level of chromosomal aberrations</article-title><source>Environ. Health Perspect.</source><year>2001</year><volume>109</volume><fpage>41</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">11171523</pub-id></citation></ref></ref-list></back></article>