<given-names>EA</given-names></name><name><surname>Becker</surname><given-names>EB</given-names></name></person-group><article-title>Review of community-based research: Assessing partnership approaches to improve public health</article-title><source>Annual Review of Public Health</source><year>1998</year><volume>19</volume><fpage>173</fpage><lpage>172</lpage><pub-id pub-id-type="pmid">9611617</pub-id><pub-id pub-id-type="doi">10.1146/annurev.publhealth.19.1.173</pub-id></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Minkler</surname><given-names>M</given-names></name><name><surname>Wallerstein</surname><given-names>N</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Minkler M, Wallerstein N</surname></name></person-group><article-title>Introduction to community based participatory research</article-title><source>Community Based Participatory Research for Health</source><year>2003</year><publisher-name>San Fransico: Jossey Bass</publisher-name><fpage>3</fpage><lpage>26</lpage></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Foster-Fishman</surname><given-names>P</given-names></name><name><surname>Nowell</surname><given-names>B</given-names></name><name><surname>Deacon</surname><given-names>Z</given-names></name><name><surname>Nievar</surname><given-names>M</given-names></name><name><surname>McCann</surname><given-names>P</given-names></name></person-group><article-title>Using Methods That Matter: The Impact of Reflection, Dialogue, and Voice</article-title><source>American Journal of Community Psychology</source><year>2005</year><volume>36</volume><fpage>275</fpage><lpage>291</lpage><pub-id pub-id-type="pmid">16389500</pub-id><pub-id pub-id-type="doi">10.1007/s10464-005-8626-y</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author