no Africans from the south-eastern equatorial rain forest of Nigeria</article-title><source>International Journal of Dermatology</source><year>2007</year><volume>46</volume><fpage>754</fpage><lpage>756</lpage><pub-id pub-id-type="pmid">17614810</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-4632.2007.03272.x</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Okoro</surname><given-names>A</given-names></name></person-group><article-title>Albinism in Nigeria. A clinical and social study</article-title><source>The British Journal of Dermatology</source><year>1975</year><volume>92</volume><fpage>485</fpage><lpage>492</lpage><pub-id pub-id-type="pmid">1174464</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lookingbill</surname><given-names>DP</given-names></name><name><surname>Lookingbill</surname><given-names>GL</given-names></name><name><surname>Leppard</surname><given-names>B</given-names></name></person-group><article-title>Actinic damage and skin cancer in albinos in northern Tanzania: findings in 164 patients enrolled in an outreach skin care program</article-title><source>Journal of the American Academy of Dermatology</source><year>1995</year><volume>32</volume><fpage>653</fpage><lpage>658</lpage><pub-id pub-id-type="pmid">7896957</pub-id><pub-id pub-id-type="doi">10.1016/0190-9622(95)90352-6</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hong</surname><given-names>E</given-names></name><name><surname>Zeeb</surname><given-names>H</given-names></name><name><surname>Repacholi</surname><given-names>M</given-names></name></person-group><article-title>Albinism in Africa as a public health issue</article-title><source>BMC Public Health</source><year>2006</year><volume>6</volume><fpage>212</fpage><pub-id pub-id-type="pmid">16916463<