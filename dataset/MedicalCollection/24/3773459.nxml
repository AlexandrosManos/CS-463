ume><issue>4</issue><fpage>897</fpage><lpage>899</lpage><pub-id pub-id-type="other">2-s2.0-0036784108</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Uruga</surname><given-names>H</given-names></name><name><surname>Fujii</surname><given-names>T</given-names></name><name><surname>Kurosaki</surname><given-names>A</given-names></name><etal/></person-group><article-title>Pulmonary tumor thrombotic microangiopathy: a clinical analysis of 30 autopsy cases</article-title><source><italic>Internal Medicine</italic></source><year>2013</year><volume>52</volume><issue>12</issue><fpage>1317</fpage><lpage>1323</lpage><pub-id pub-id-type="pmid">23774540</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Patrignani</surname><given-names>A</given-names></name><name><surname>Purcaro</surname><given-names>A</given-names></name><name><surname>Calcagnoli</surname><given-names>F</given-names></name><name><surname>Mandolesi</surname><given-names>A</given-names></name><name><surname>Bearzi</surname><given-names>I</given-names></name><name><surname>Ciampani</surname><given-names>N</given-names></name></person-group><article-title>Pulmonary tumor thrombotic microangiopathy: the challenge of the antemortem diagnosis</article-title><source><italic>Journal of Cardiovascular Medicine</italic></source><year>2013</year></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Keenan</surname><given-names>NG</given-names></name><name><surname>Nicholson</surname><given-names>AG</given-names></name><name><surname>Oldershaw</surname><given-names>PJ</given-names></name></person-group><article-title>Fatal acute pulmonary hypertension caused by pulmonary tumour thrombotic microangiopathy</article-title><source><italic>International Journal of Cardiology</italic></source><year>2008</year><volume>124</volume><issue>1</issue><fpage>e11</fpage><lpage>e13</lpage><pub-id pub-id-type="other">2-s2.0-38149103068</pub-id><pub-id pub-id-type="pmid">17349704</pub-id></element-citation></ref></ref-list></back><floats-group><fig id="fig1" orientation="portrait" position="float"><label>Figure 1</label><caption><p>Computer tomography scans of the chest revealed ground glass opacities around the bronchovascular bundles in the lower lobe of the right lung.</p></caption><graphic xlink:href="CRIM.PULMONOLOGY2013-259080.001"/></fig><fig id="fig2" orientation="portrait" position="float"><label>Figure 2</label><caption><p>A lung perfusion scan showed multiple wedge-shaped perfusion defects in both lungs.</p></caption><graphic xlink:href="CRIM.PULMONOLOGY2013-259080.002"/></fig><fig id="fig3" orientation="portrait" position="float"><label>Figure 3</label><caption><p>Obstruction of the pulmonary artery and endothelial fibrocystic hyperplasia was determined by transbronchial lung biopsy specimens from the lower lobe of the right lung (hematoxylin and eosin staining, &#x000d7;40).</p></caption><graphic xlink:href="CRIM.PULMONOLOGY2013-259080.003"/></fig></floats-group></article>