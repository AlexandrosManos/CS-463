/fpage>&#x02013;<lpage>361</lpage></mixed-citation></ref><ref id="pone.0052531-Agosta1"><label>6</label><mixed-citation publication-type="journal"><name><surname>Agosta</surname><given-names>F</given-names></name>, <name><surname>Canu</surname><given-names>E</given-names></name>, <name><surname>Sarro</surname><given-names>L</given-names></name>, <name><surname>Comi</surname><given-names>G</given-names></name>, <name><surname>Filippi</surname><given-names>M</given-names></name> (<year>2012</year>) <article-title>Neuroimaging findings in frontotemporal lobar degeneration spectrum of disorders</article-title>. <source>Cortex; a Journal Devoted to the Study of the Nervous System and Behavior</source><volume>48</volume>: <fpage>389</fpage>&#x02013;<lpage>413</lpage></mixed-citation></ref><ref id="pone.0052531-Borroni2"><label>7</label><mixed-citation publication-type="journal"><name><surname>Borroni</surname><given-names>B</given-names></name>, <name><surname>Brambati</surname><given-names>SM</given-names></name>, <name><surname>Agosti</surname><given-names>C</given-names></name>, <name><surname>Gipponi</surname><given-names>S</given-names></name>, <name><surname>Bellelli</surname><given-names>G</given-names></name>, <etal>et al</etal> (<year>2007</year>) <article-title>Evidence of white matter changes on diffusion tensor imaging in frontotemporal dementia</article-title>. <source>Archives of Neurology</source><volume>64</volume>: <fpage>246</fpage>&#x02013;<lpage>251</lpage><pub-id pub-id-type="pmid">17296841</pub-id></mixed-citation></ref><ref id="pone.0052531-Chan1"><label>8</label><mixed-citation publication-type="journal"><name><surname>Chan</surname><given-names>D</given-names></name>, <name><surname>Fox</surname><given-names>NC</given-names></name>, <name><surname>Jenkins</surname><given-names>R</given-names></name>, <name><surname>Scahill</surname><given-names>RI</given-names></name>, <name><surname>Crum</surname><given-names>WR</given-names></name>, <etal>et al</etal> (<year>2001</year>) <article-title>Rates of global and regional cerebral atrophy in AD and frontotemporal dementia</article-title>. <source>Neurology</source><volume>57</volume>: <fpage>1756</fpage>&#x02013;<lpage>1763</lpage><pub-id pub-id-type="pmid">11723259</pub-id></mixed-citation></ref><ref id="pone.0052531-Boccardi1"><label>9</label><mixed-citation publication-type="journal"><name><surname>Boccardi</surname><given-names>M</given-names></name>, <name><surname>Sabattoli</surname><given-names>F</given-names></name>, <name><surname>Laakso</surname><given-names>MP</given-names></name>, <name><surname>Testa</surname><given-names>C</given-names></name>, <name><surname>Rossi</surname><given-names>R</given-names></name>, <etal>et al</etal> (<year>2005</year>) <article-title>Frontotemporal dementia as a neural system disease</article-title>. <source>Neurobiology of Aging</source><volume>26</volume>: <fpage>37</fpage>&#x02013;<lpage>44</lpage><pub-id pub-id-type="pmid">15585344</pub-id></mixed-citation></ref><ref id="pone.0052531-Frisoni1"><label>10</label><mixed-citation publication-type="journal"><name><surname>Frisoni</surname><given-names>GB</given-names></name>, <name><surname>Laakso</surname><given-names>MP</given-names></name>, <name><surname>Beltramello</surname><given-names>A</given-names></name>, <name><surname>Geroldi</surname><given-names>C</given-names></name>, <name><surname>Bianchetti</surname><given-names>A</given-names></name>, <etal>et al</etal> (<year>1999</year>) <article-title>Hippocampal and entorhinal cortex atrophy in frontotemporal dementia and alzheimer&#x02019;s disease</article-title>. <source>Neurology</source><volume>52</volume>: <fpage>91</fpage>&#x02013;<lpage>100</lpage><pub-id pub-id-type="pmid">9921854</pub-id></mixed-citation></ref><ref id="pone.0052531-Laakso1"><label>11</label><mixed-citation publication-type="journal"><name><surname>Laakso</surname><given-names>MP</given-names></name>, <name><surname>Frisoni</surname><given-names>GB</given-names></name>, <name><surname>Kononen</surname><given-names>M</given-names></name>, <name><surname>Mikkonen</surname><given-names>M</given-names></name>, <name><surname>Beltramello</surname><given-names>A</given-names></name>, <etal>et al</etal> (<year>2000</year>) <article-title>Hippocampus and entorhinal cortex in frontotemporal dementia and alzheimer&#x02019;s disease: A morphometric MRI study</article-title>. <source>Biological Psychiatry</source><volume>47</volume>: <fpage>1056</fpage>&#x02013;<lpage>1063</lpage><pub-id pub-id-type="pmid">10862805</pub-id></mixed-citation></ref><ref id="pone.0052531-Davatzikos1"><label>12</label><mixed-citation publication-type="journal"><name><surname>Davatzikos</surname><given-names>C</given-names></name>, <name><surname>Resnick</surname><given-names>SM</given-names></name>, <name><surname>Wu</surname><given-names>X</given-names></name>, <name><surname>Parmpi</surname><given-names>P</given-names></name>, <name><surname>Clark</surname><given-names>CM</given-names></name> (<year>2008</year>) <article-title>Individual patient diagnosis of AD and FTD via high-dimensional pattern classification of MRI</article-title>. <source>NeuroImage</source><volume>41</volume>: <fpage>1220</fpage>&#x02013;<lpage>1227</lpage><pub-id pub-id-type="pmid">18474436</pub-id></mixed-citation></ref><ref id="pone.0052531-Seelaar1"><label>13</label><mixed-citation publication-type="journal"><name><surname>Seelaar</surname><given-names>H</given-names></name>, <name><surname>Rohrer</surname><given-names>JD</given-names></name>, <name><surname>Pijnenburg</surname><given-names>YA</given-names></name>, <name><surname>Fox</surname><given-names>NC</given-names></name>, <name><surname>van Swieten</surname><given-names>JC</given-names></name> (<year>2011</year>) <article-title>Clinical, genetic and pathological heterogeneity of frontotemporal dementia: A review</article-title>. <source>Journal of Neurology, Neurosurgery, and Psychiatry</source><vo