ame><name><surname>Arnesen</surname><given-names>E</given-names></name></person-group><article-title>Determining lifestyle correlates of body mass index using multilevel analyses: The Tromso study,1979&#x02013;2001</article-title><source>Am J Epedimiol</source><year>2005</year><volume>162</volume><fpage>1179</fpage><lpage>88</lpage><pub-id pub-id-type="doi">10.1093/aje/kwi328</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>JE</given-names></name><name><surname>Kaye</surname><given-names>SA</given-names></name><name><surname>Folsom</surname><given-names>AR</given-names></name></person-group><article-title>Parity-related weight change in women</article-title><source>Int J Obes Relat Metab Disord</source><year>1992</year><volume>16</volume><fpage>627</fpage><lpage>31</lpage><pub-id pub-id-type="pmid">1328085</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gunderson</surname><given-names>EP</given-names></name><name><surname>Abrams</surname><given-names>B</given-names></name></person-group><article-title>Epidemiology of gestational weight gain and body weight changes after pregnancy</article-title><source>Epidemiol Rev</source><year>2000</year><volume>22</volume><fpage>261</fpage><pub-id pub-id-type="pmid">11218377</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Williamson</surname><given-names>DF</given-names></name><name><surname>Madans</surname><given-names>J</given-names></name><name><surname>Pamuk</surname><given-names>E</given-names></name><name><surname>Flegal</surname><given-names>KM</given-names></name><name><surname>Kendrick</surname><given-names>JS</given-names></name><name><surname>Serdula</surname><given-names>MK</given-names></name></person-group><article-title>A prospective study of childbearing and 10-year weight gain in US white women 25 to 45 years of age</article-title><source>Int J Obes Relat Metab Disord</source><year>1994</year><volume>18</volume><fpage>561</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">7951478</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schauberger</surname><given-names>CW</given-names></name><name><surname>Rooney</surname><given-names>BL</given-names></name><name><surname>Brimer</surname><given-names>LM</given-names></name></person-group><article-title>Factors that influence weight loss in the puerperium</article-title><source>Obstet Gynecol</source><year>1992</year><volume>79</volume><fpage>424</fpage><pub-id pub-id-type="pmid">1738527</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harris</surname><given-names>HE</given-names></name><name><surname>Ellison</surname><given-names>GT</given-names></name><name><surname>Holliday</surname><given-names>M</given-names></name><name><surname>Lucassen</surname><given-names>E</given-names></name></person-group><article-title>The impact of pregnancy on the long-term weight gain of primiparous women in England</article-title><source>Int J Obes Rel Metab Disord</source><year>1997</year><volume>21</volume><fpage>747</fpage><pub-id pub-id-type="doi">10.1038/sj.ijo.0800466</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rossner</surname><given-names>S</given-names></name><name><surname>Ohlin</surname><given-names>A</given-names></name></person-group><article-title>Pregnancy as a risk factor for obesity: lessons from the Stockholm Pregnancy and Weight Development Study</article-title><source>Obes Res</source><year>1995</year><volume>3</volume><fpage>267s</fpage><lpage>275s</lpage><pub-id pub-id-type="pmid">8581786</pub-id></citation></ref><ref id=