<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Ulster Med J</journal-id><journal-id journal-id-type="pmc">ulstermedj</journal-id><journal-title>The Ulster Medical Journal</journal-title><issn pub-type="ppub">0041-6193</issn><publisher><publisher-name>Ulster Medical Society</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">1535743</article-id><article-id pub-id-type="pmc">2448785</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research Article</subject></subj-group></article-categories><title-group><article-title>Shrinkage of uterine fibroids by preoperative LHRH analogue injection.</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>McClelland</surname><given-names>H. R.</given-names></name></contrib><contrib contrib-type="author"><name><surname>Quinn</surname><given-names>A. J.</given-names></name></contrib></contrib-group><aff>Gynaecological Unit, Ulster Hospital, Dundonald, Belfast.</aff><pub-date pub-type="ppub"><month>4</month><year>1992</year></pub-date><volume>61</volume><issue>1</issue><fpage>51</fpage><lpage>55</lpage><abstract><p>Six patients with large uterine fibroids were given a single subcutaneous implant of an LHRH analogue (goserelin 3.5 mg) prior to elective hysterectomy. Overall fibroid volume decreased by 30-47% within six weeks of implantation. All patients reported improvement in their symptoms of pressure and pain, and were rendered amenorrhoeic prior to surgery.</p></abstract></article-meta></front><body><supplementary-material content-type="scanned-pages"><graphic xlink:href="ulstermedj00074-0054.tif" xlink:title="scanned-page" xlink:role="51" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="ulstermedj00074-0055.tif" xlink:title="scanned-page" xlink:role="52" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="ulstermedj00074-0056.tif" xlink:title="scanned-page" xlink:role="53" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="ulstermedj00074-0057.tif" xlink:title="scanned-page" xlink:role="54" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="ulstermedj00074-0058.tif" xlink:title="scanned-page" xlink:role="55" mimetype="image" mime-subtype="tiff"/></supplementary-material></body></article>