e><source>Ann Intern Med</source><year>1998</year><volume>129</volume><fpage>875</fpage><lpage>877</lpage><pub-id pub-id-type="pmid">9867729</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moos</surname><given-names>V</given-names></name><name><surname>Kunkel</surname><given-names>D</given-names></name><name><surname>Marth</surname><given-names>T</given-names></name><name><surname>Feurle</surname><given-names>GE</given-names></name><name><surname>LaScola</surname><given-names>B</given-names></name><name><surname>Ignatius</surname><given-names>R</given-names></name><name><surname>Zeitz</surname><given-names>M</given-names></name><name><surname>Schneider</surname><given-names>T</given-names></name></person-group><article-title>Reduced peripheral and mucosal <italic>Tropheryma whipplei</italic>-specific Th1 response in patients with Whipple's disease</article-title><source>J Immunol</source><year>2006</year><volume>177</volume><fpage>2015</fpage><lpage>2022</lpage><pub-id pub-id-type="pmid">16849516</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mahnel</surname><given-names>R</given-names></name><name><surname>Kalt</surname><given-names>A</given-names></name><name><surname>Ring</surname><given-names>S</given-names></name><name><surname>Stallmach</surname><given-names>A</given-names></name><name><surname>Strober</surname><given-names>W</given-names></name><name><surname>Marth</surname><given-names>T</given-names></name></person-group><article-title>Immunosuppressive therapy in Whipple's disease patients is associated with the appearance of gastrointestinal manifestations</article-title><source>Am J Gastroenterol</source><year>2005</year><volume>100</volume><fpage>1167</fpage><lpage>1173</lpage><pub-id pub-id-type="pmid">15842595</pub-id><pub-id pub-id-type="doi">10.1111/j.1572-0241.2005.40128.x</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gillen</surname><given-names>CD</given-names></name><name><surname>Coddington</surname><given-names>R</given-names></name><name><surname>Monteith</surname><given-names>PG</given-names></name><name><surname>Taylor</surname><given-names>RH</given-names></name></person-group><article-title>Extraintestinal lymphoma in association with Whipple's disease</article-title><source>Gut</source><year>1993</year><volume>34</volume><fpage>1627</fpage><lpage>1629</lpage><pub-id pub-id-type="pmid">7694890</pub-id><pub-id pub-id-type="doi">10.1136/gut.34.11.1627</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gruner</surname><given-names>U</given-names></name><name><surname>Goesch</surname><given-names>P</given-names></name><name><surname>Donner</surname><given-names>A</given-names></name><name><surname>Peters</surname><given-names>U</given-names></name></person-group><article-title>Whipple disease and non-Hodgkin lymphoma</article-title><source>Z Gastroenterol</source><year>2001</year><volume>39</volume><fpage>305</fpage><lpage>309</lpage><pub-id pub-id-type="pmid">11367979</pub-id><pub-id pub-id-type="doi">10.1055/s-2001-12865</pub-id></citation></ref></ref-list></back></article>