f><ref id="pone.0002730-MacCulloch1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>MacCulloch</surname><given-names>RD</given-names></name><name><surname>Murphy</surname><given-names>RW</given-names></name><name><surname>Kupriyanova</surname><given-names>LA</given-names></name></person-group><year>1995</year><article-title>Clonal variation in the parthenogenetic rock lizard <italic>Lacerta armeniaca</italic>.</article-title><source>Genome</source><volume>38</volume><fpage>1057</fpage><lpage>1060</lpage><pub-id pub-id-type="pmid">18470230</pub-id></citation></ref><ref id="pone.0002730-MacCulloch2"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>MacCulloch</surname><given-names>RD</given-names></name><name><surname>Murphy</surname><given-names>RW</given-names></name><name><surname>Kupriyanova</surname><given-names>LA</given-names></name><name><surname>Darevsky</surname><given-names>IS</given-names></name></person-group><year>1997</year><article-title>The Caucasian rock lizard <italic>Lacerta rostombekovi</italic>: a monoclonal parthenogenetic vertebrate.</article-title><source>Biochemical Systematics and Ecology</source><volume>25</volume><fpage>33</fpage><lpage>37</lpage></citation></ref><ref id="pone.0002730-Murphy1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Murphy</surname><given-names>RW</given-names></name><name><surname>Darevsky</surname><given-names>IS</given-names></name><name><surname>MacCulloch</surname><given-names>RD</given-names></name></person-group><year>1997</year><article-title>Old age, multiple formations or genetic plasticity? Clonal diversity in the uniparental Caucasian rock lizard <italic>Lacerta dahli</italic>.</article-title><source>Genetica</source><volume>101</volume><fpage>125</fpage><lpage>130</lpage><pub-id pub-id-type="pmid">16220367</pub-id></citation></ref