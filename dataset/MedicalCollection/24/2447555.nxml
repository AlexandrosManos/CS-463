><name><surname>Servi</surname><given-names>D</given-names></name><name><surname>Laffel</surname><given-names>G</given-names></name><name><surname>Sweitzer</surname><given-names>BJ</given-names></name><name><surname>Shea</surname><given-names>BF</given-names></name><name><surname>Hallisey</surname><given-names>R</given-names></name></person-group><article-title>Incidence of adverse drug events and potential adverse drug events. Implications for prevention. ADE Prevention Study Group</article-title><source>JAMA</source><year>1995</year><volume>274</volume><fpage>29</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">7791255</pub-id><pub-id pub-id-type="doi">10.1001/jama.274.1.29</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Calabrese</surname><given-names>AD</given-names></name><name><surname>Erstad</surname><given-names>BL</given-names></name><name><surname>Brandl</surname><given-names>K</given-names></name><name><surname>Barletta</surname><given-names>JF</given-names></name><name><surname>Kane</surname><given-names>SL</given-names></name><name><surname>Sherman</surname><given-names>DS</given-names></name></person-group><article-title>Medication administration errors in adult patients in the ICU</article-title><source>Intensive Care Med</source><year>2001</year><volume>27</volume><fpage>1592</fpage><lpage>1598</lpage><pub-id pub-id-type="pmid">11685299</pub-id><pub-id pub-id-type="doi">10.1007/s001340101065</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leape</surname><given-names>LL</given-names></name><name><surname>Bates</surname><given-names>DW</given-names></name><name><surname>Cullen</surname><given-names>DJ</given-names></name><name><surname>Cooper</surname><given-names>J</given-names></name><name><surname>Demonaco</surname><given-names>HJ</given-names></name><name><surname>Gallivan</surname><given-names>T</given-names></name><name><surname>Hallisey</surname><given-names>R</given-names></name><name><surname>Ives</surname><given-names>J</given-names></name><name><surname>Laird</surname><given-names>N</given-names></name><name><surname>Laffel</surname><given-names>G</given-names></name><name><surname>Nemeskal</surname><given-names>R</given-names></name><name><surname>Petersen</surname><given-names>LA</given-names></name><name><surname>Porter</surname><given-names>K</given-names></name><name><surname>Servi</surname><given-names>D</given-names></name><name><surname>Shea</surname><given-names>BF</given-names></name><name><surname>Small</surname><given-names>SD</given-names></name><name><surname>Sweitzer</surname><given-names>BJ</given-names></name><name><surname>Thompson</surname><given-names>T</given-names></name><name><surname>Vander Vliet</surname><given-names>M</given-names></name><collab>for the ADE Prevention Study Group</collab></person-group><article-title>Systems analysis of adverse drug events. ADE Prevention Study Group</article-title><source>JAMA</source><year>1995</year><volume>274</volume><fpage>35</fpage><lpage>43</lpage><pub-id pub-id-type="pmid">7791256</pub-id><pub-id pub-id-type="doi">10.1001/jama.274.1.35</pub-id></citation></ref><ref id="B15"><citation citation-type="book"><source>The United States Pharmacopeial Convention: 1999</source><year>1999</year><publisher-name>Rockville, MD: United States Pharmacopeia</publisher-name><fpage>1131</fpage><lpage>1132</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parshuram</surname><given-names>CS</given-names></name><name><surname>Ng</surname><given-names>GYT</given-names></name><name><surname>Ho</surname><given-names>TKL</given-names></name><name><surname>Klein</surname><given-names>J</given-names></name><name><surname>Moore</surname><given-names>AM</given-names></name><name><surname>Bohn</surname><given-names>D</given-nam