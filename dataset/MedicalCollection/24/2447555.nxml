 Clin</source><year>2005</year><volume>21</volume><fpage>1</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">15579349</pub-id><pub-id pub-id-type="doi">10.1016/j.ccc.2004.07.006</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rothschild</surname><given-names>JM</given-names></name><name><surname>Landrigan</surname><given-names>CP</given-names></name><name><surname>Cronin</surname><given-names>JW</given-names></name><name><surname>Kaushal</surname><given-names>R</given-names></name><name><surname>Lockley</surname><given-names>SW</given-names></name><name><surname>Burdick</surname><given-names>E</given-names></name><name><surname>Stone</surname><given-names>PH</given-names></name><name><surname>Lilly</surname><given-names>CM</given-names></name><name><surname>Katz</surname><given-names>JT</given-names></name><name><surname>Czeisler</surname><given-names>CA</given-names></name><name><surname>Bates</surname><given-names>DW</given-names></name></person-group><article-title>The Critical Care Safety Study: The incidence and nature of adverse events and serious medical errors in intensive care</article-title><source>Crit Care Med</source><year>2005</year><volume>33</volume><fpage>1694</fpage><lpage>1700</lpage><pub-id pub-id-type="pmid">16096443</pub-id><pub-id pub-id-type="doi">10.1097/01.CCM.0000171609.91035.BD</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><article-title>Pharmacy-nursing shared vision for safe medication use in hospitals: executive summary session</article-title><source>Am J Health Syst Pharm</source><year>2003</year><volume>60</volume><fpage>1046</fpage><lpage>1052</lpage><pub-id pub-id-type="pmid">12938664</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hussain</surname><given-names>E</given-names></name><name><surname>Kao</surname><given-names>E</given-names></name></p