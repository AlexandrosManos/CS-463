ematic review</article-title><source>Epidemiol Rev</source><year>2001</year><volume>23</volume><fpage>313</fpage><lpage>342</lpage><!--PubMed citation query: 'Epidemiol Rev||23|313||bib11|'--><pub-id pub-id-type="pmid">12192740</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gunnell</surname><given-names>D</given-names></name><name><surname>Oliver</surname><given-names>SE</given-names></name><name><surname>Donovan</surname><given-names>JL</given-names></name><name><surname>Peters</surname><given-names>TJ</given-names></name><name><surname>Gillatt</surname><given-names>D</given-names></name><name><surname>Persad</surname><given-names>R</given-names></name><name><surname>Hamdy</surname><given-names>FC</given-names></name><name><surname>Meal</surname><given-names>DE</given-names></name><name><surname>Holly</surname><given-names>JMP</given-names></name></person-group><article-title>Do height-related variations in insulin-like growth factors underlie the associations of stature with chronic diseases</article-title><source>J Clin Endocrinol Metab</source><year>2004</year><volume>81</volume><fpage>213</fpage><lpage>218</lpage><!--PubMed citation query: 'J Clin Endocrinol Metab||81|213||bib12|'--></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hardell</surname><given-names>L</given-names></name><name><surname>Carlberg</surname><given-names>M</given-names></name><name><surname>S&#x000f6;derguist</surname><given-names>F</given-names></name><name><surname>Mild</surname><given-names>KH</given-names></name><name><surname>Morgan</surname><given-names>LL</given-names></name></person-group><article-title>Long-term use of cellular phones and brain tumours: Increased risk associated with use for &#x02a7e;10 years</article-title><source>Occup Environ Med</source><year>2007</year><volume>64</volume><fpage>626</fpage><lpage>632</lpage><!--PubMed citation query: 'Occup Environ Med||64|626||bib13|'--><pub-id pub-id-type="pmid">17409179</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Helseth</surname><given-names>A</given-names></name><name><surname>Tretli</surname><given-names>S</given-names></name></person-group><article-title>Pre-morbid height and weight as risk factors for development of central nervous system neoplasms</article-title><source>Neuroepidemiology</source><year>1989</year><volume>8</volume><fpage>277</fpage><lpage>282</lpage><!--PubMed citation query: 'Neuroepidemiology||8|277||bib14|'--><pub-id pub-id-type="pmid">2586697</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hepworth</surname><given-names>SJ</given-names></name><name><surname>Schoemaker</surname><given-names>MJ</given-names></name><name><surname>Muir</surname><given-names>KR</given-names></name><name><surname>Swerdlow</surname><given-names>AJ</given-names></name><name><surname>van Tongeren</surname><given-names>MJ</given-names></name><name><surname>McKinney</surname><given-names>PA</given-names></name></person-group><article-title>Mobile phone use and risk of glioma in adults: case&#x02013;control study</article-title><source>BMJ (Clinical research ed)</source><year>2006</year><volume>332</volume><fpage>883</fpage><lpage>887</lpage><!--PubMed citation query: 'BMJ (Clinical research ed)||332|883||bib15|'--></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hu</surname><given-names>J</given-names></name><name><surname>Little</surname><given-names>J</given-names></name><name><surname>Xu</surname><given-names>T</given-names></name><name><surname>Zhao</surname><given-names>X</given-names></name><name><surname>Guo</surname><given-names>L</given-names></name><name><surname>Jia</surname><give