erson-group-type="author"><name><surname>Lee</surname><given-names>KW</given-names></name><name><surname>Kuo</surname><given-names>WR</given-names></name><name><surname>Tsai</surname><given-names>SM</given-names></name><name><surname>Wu</surname><given-names>DC</given-names></name><name><surname>Wang</surname><given-names>WM</given-names></name><name><surname>Fang</surname><given-names>FM</given-names></name><name><surname>Chiang</surname><given-names>FY</given-names></name><name><surname>Ho</surname><given-names>KY</given-names></name><name><surname>Wang</surname><given-names>LF</given-names></name><name><surname>Tai</surname><given-names>CF</given-names></name><etal></etal></person-group><article-title>Different impact from betel quid, alcohol and cigarette: risk factors for pharyngeal and laryngeal cancer</article-title><source>International Journal of Cancer</source><year>2005</year><volume>117</volume><fpage>831</fpage><lpage>836</lpage><pub-id pub-id-type="doi">10.1002/ijc.21237</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yang</surname><given-names>YH</given-names></name><name><surname>Lee</surname><given-names>HY</given-names></name><name><surname>Tung</surname><given-names>S</given-names></name><name><surname>Shieh</surname><given-names>TY</given-names></name></person-group><article-title>Epidemiological survey of oral submucous fibrosis and leukoplakia in aborigines of Taiwan</article-title><source>Journal of Oral Pathological Medicine</source><year>2001</year><volume>30</volume><fpage>213</fpage><lpage>219</lpage><pub-id pub-id-type="pmid">11302240</pub-id><pub-id pub-id-type="doi">10.1034/j.1600-0714.2001.300404.x</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>CH</given-names></name><name><surname>Ko</surname><given-names>YC</given-names></name><name><surname>Huang<