e><given-names>R</given-names></name><name><surname>Pocham</surname><given-names>N</given-names></name></person-group><article-title>Legal harm reduction among intravenous drug users</article-title><source>Journal of the Medical Association of Thailand</source><year>2006</year><volume>89</volume><fpage>1545</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">17100399</pub-id></citation></ref><ref id="B29"><citation citation-type="book"><source>WHO Guidelines on HIV Infection and AIDS in Prisons</source><year>1993</year><publisher-name>Geneva: World Health Organization</publisher-name></citation></ref><ref id="B30"><citation citation-type="book"><source>Best Practice in HIV/AIDS Prevention and Care for Injecting Drug Abusers: The Triangular Clinic in Kermanshah, Islamic Republic of Iran</source><year>2004</year><publisher-name>Geneva: World Health Organization</publisher-name></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wood</surname><given-names>E</given-names></name><name><surname>Li</surname><given-names>K</given-names></name><name><surname>Small</surname><given-names>W</given-names></name><name><surname>Montaner</surname><given-names>JS</given-names></name><name><surname>Schechter</surname><given-names>MT</given-names></name><name><surname>Kerr</surname><given-names>T</given-names></name></person-group><article-title>Recent incarceration independently associated with syringe sharing by injection drug users</article-title><source>Public Health Reports</source><year>2005</year><volume>120</volume><fpage>150</fpage><lpage>156</lpage><pub-id pub-id-type="pmid">15842116</pub-id></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brewer</surname><given-names>TF</given-names></name><name><surname>Vlahov</surname><given-names>D</given-names></name><name><surname>Taylor</surname><given-names>E</given-names></name><name><surname>Hall</surname><given-names>D</given-names></name><name><surname>Munoz</surname><given-names>A</given-names></name><name><surname>Polk</surname><given-names>BF</given-names></name></person-group><article-title>Transmission of HIV-1 within a statewide prison system</article-title><source>AIDS</source><year>1988</year><volume>2</volume><fpage>363</fpage><lpage>367</lpage><pub-id pub-id-type="pmid">3146264</pub-id><pub-id pub-id-type="doi">10.1097/00002030-198810000-00005</pub-id></citation></ref><ref id="B33"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hasnain</surname><given-names>M</given-names></name></person-group><article-title>Cultual Approach to HIV/AIDS Harm Reduction in Muslim Countries</article-title><source>Harm Reduction Journal</source><year>2005</year><volume>2</volume><fpage>23</fpage><pub-id pub-id-type="pmid">16253145</pub-id><pub-id pub-id-type="doi">10.1186/1477-7517-2-23</pub-id></citation></ref><ref id="B34"><citation citation-type="other"><person-group person-group-type="author"><collab>Botswana Institute for Development Policy Analysis</collab></person-group><source>Study on knowledge, attitude and behaviour toward HIV/AIDS in the vocational training sector</source><year>2005</year></citation></ref></ref-list></back></article>