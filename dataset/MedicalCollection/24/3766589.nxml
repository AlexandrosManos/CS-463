e><italic>British Journal of Haematology</italic></source><year>2006</year><volume>134</volume><issue>5</issue><fpage>510</fpage><lpage>516</lpage><pub-id pub-id-type="other">2-s2.0-33746496632</pub-id><pub-id pub-id-type="pmid">16848795</pub-id></element-citation></ref></ref-list></back><floats-group><fig id="fig1" orientation="portrait" position="float"><label>Figure 1</label><caption><p>Initial chest X-ray: bilateral alveolointerstitial infiltrate.</p></caption><graphic xlink:href="CRIM.MEDICINE2013-315073.001"/></fig><fig id="fig2" orientation="portrait" position="float"><label>Figure 2</label><caption><p>Control chest X-ray: normal.</p></caption><graphic xlink:href="CRIM.MEDICINE2013-315073.002"/></fig></floats-group></article>