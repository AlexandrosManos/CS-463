el>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Corriere</surname><given-names>JN</given-names><suffix>Jr.</suffix></name><name><surname>Sandler</surname><given-names>CM</given-names></name></person-group><article-title>Delayed post-traumatic rupture of the bladder</article-title><source><italic>Journal of the Royal College of Surgeons of Edinburgh</italic></source><year>1974</year><volume>19</volume><issue>4</issue><fpage>247</fpage><lpage>248</lpage><pub-id pub-id-type="pmid">4841755</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sandler</surname><given-names>CM</given-names></name><name><surname>Hall</surname><given-names>JT</given-names></name><name><surname>Rodriguez</surname><given-names>MB</given-names></name><name><surname>Corriere</surname><given-names>JN</given-names><suffix>Jr.</suffix></name></person-group><article-title>Bladder injury in blunt pelvic trauma</article-title><source><italic>Radiology</italic></source><year>1986</year><volume>158</volume><issue>3</issue><fpage>633</fpage><lpage>638</lpage><pub-id pub-id-type="other">2-s2.0-0022602489</pub-id><pub-id pub-id-type="pmid">3945731</pub-id></element-citation></ref><ref id="B16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Quagliano</surname><given-names>PV</given-names></name><name><surname>Delair</surname><given-names>SM</given-names></name><name><surname>Malhotra</surname><given-names>AK</given-names></name></person-group><article-title>Diagnosis of blunt bladder injury: a prospective comparative study of computed tomography cystography and conventional retrograde cystography</article-title><source><italic>Journal of Trauma</italic></source><year>2006</year><volume>61</volume><issue>2</issue><fpage>410</fpage><lpage>421</lpage><pub-id pub-id-type="other">2-s2.0-33747591196</pub-id><pub-id pub-id-type="pmid">16917459</pub-id></element-citation></ref></ref-list></back><floats-group><fig id="fig1" orientation="portrait" position="float"><label>Figure 1</label><caption><p>Pelvic X-ray of the patient showing no fracture.</p></caption><graphic xlink:href="CRIM.UROLOGY2012-430746.001"/></fig><fig id="fig2" orientation="portrait" position="float"><label>Figure 2</label><caption><p>(a) CT image outlines the distended urinary bladder (UB). (b) CT image showing irregularity and thickening on the right side of UB wall.</p></caption><graphic xlink:href="CRIM.UROLOGY2012-430746.002"/></fig><fig id="fig3" orientation="portrait" position="float"><label>Figure 3</label><caption><p>Conventional retrograde cystogram showing extravasation of contrast material outside the UB, denoting intraperitoneal UB rupture.</p></caption><graphic xlink:href="CRIM.UROLOGY2012-430746.003"/></fig><fig id="fig4" orientation="portrait" position="float"><label>Figure 4</label><caption><p>(a) Laparoscopic view showing Foley's catheter balloon outside the UB and intraperitoneally. (b) The tear in the UB wall which was repaired laparoscopically.</p></caption><graphic xlink:href="CRIM.UROLOGY2012-430746.004"/></fig><fig id="fig5" orientation="portrait" position="float"><label>Figure 5</label><caption><p>Retrograde cystography showing no contrast extravasation after 10 days of the repair.</p></caption><graphic xlink:href="CRIM.UROLOGY2012-430746.005"/></fig></floats-group></article>