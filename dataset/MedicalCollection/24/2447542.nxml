rson-group><article-title>How well is enzyme function conserved as a function of pairwise sequence identity?</article-title><source>J Mol Biol</source><year>2003</year><volume>333</volume><fpage>863</fpage><lpage>882</lpage><pub-id pub-id-type="pmid">14568541</pub-id><pub-id pub-id-type="doi">10.1016/j.jmb.2003.08.057</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Joshi</surname><given-names>T</given-names></name><name><surname>Chen</surname><given-names>Y</given-names></name><name><surname>Becker</surname><given-names>JM</given-names></name><name><surname>Alexandrov</surname><given-names>N</given-names></name><name><surname>Xu</surname><given-names>D</given-names></name></person-group><article-title>Genome-scale gene function prediction using multiple sources of high-throughput data in yeast <italic>Saccharomyces cerevisiae</italic>.</article-title><source>OMICS</source><year>2004</year><volume>8</volume><fpage>322</fpage><lpage>333</lpage><pub-id pub-id-type="pmid">15703479</pub-id><pub-id pub-id-type="doi">10.1089/omi.2004.8.322</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Karaoz</surname><given-names>U</given-names></name><name><surname>Murali</surname><given-names>TM</given-names></name><name><surname>Letovsky</surname><given-names>S</given-names></name><name><surname>Zheng</surname><given-names>Y</given-names></name><name><surname>Ding</surname><given-names>C</given-names></name><name><surname>Cantor</surname><given-names>CR</given-names></name><name><surname>Kasif</surname><given-names>S</given-names></name></person-group><article-title>Whole-genome annotation by using evidence integration in functional-linkage networks.</article-title><source>Proc Natl Acad Sci USA</source><year>2004</year><volume>101</volume><fpage>2888</fpage><lpage>2893</lpage><pub-id pub-id-type="pmid">14981259</pub-id><pub-id