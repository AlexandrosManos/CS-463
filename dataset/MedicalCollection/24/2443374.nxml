e="journal"><person-group person-group-type="author"><name><surname>Cantor</surname><given-names>CR</given-names></name><name><surname>Fields</surname><given-names>CA</given-names></name></person-group><article-title>Genome sequencing conference. III: Evolution and progress</article-title><source>Genomics</source><year>1992</year><volume>12</volume><fpage>419</fpage><lpage>420</lpage><pub-id pub-id-type="pmid">1346783</pub-id><pub-id pub-id-type="doi">10.1016/0888-7543(92)90397-B</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fu</surname><given-names>YX</given-names></name><name><surname>Li</surname><given-names>WH</given-names></name></person-group><article-title>Statistical tests of neutrality of mutations</article-title><source>Genetics</source><year>1993</year><volume>133</volume><fpage>693</fpage><lpage>709</lpage><pub-id pub-id-type="pmid">8454210</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hillis</surname><given-names>DM</given-names></name></person-group><article-title>Phylogenetic analysis</article-title><source>Curr Biol</source><year>1997</year><volume>7</volume><fpage>R129</fpage><lpage>131</lpage><pub-id pub-id-type="pmid">9162471</pub-id><pub-id pub-id-type="doi">10.1016/S0960-9822(97)70070-8</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>VanBuskirk</surname><given-names>KM</given-names></name><name><surname>Cole-Tobian</surname><given-names>JL</given-names></name><name><surname>Baisor</surname><given-names>M</given-names></name><name><surname>Sevova</surname><given-names>ES</given-names></name><name><surname>Bockarie</surname><given-names>M</given-names></name><name><surname>King</surname><given-names>CL</given-names></name><name><surname>Adams</surname><given-names>JH</given-names></name></person-group><ar