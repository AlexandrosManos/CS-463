="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adesida</surname><given-names>AB</given-names></name><name><surname>Grady</surname><given-names>LM</given-names></name><name><surname>Khan</surname><given-names>WS</given-names></name><name><surname>Millward-Sadler</surname><given-names>SJ</given-names></name><name><surname>Salter</surname><given-names>DM</given-names></name><name><surname>Hardingham</surname><given-names>TE</given-names></name></person-group><article-title>Human meniscus cells express hypoxia inducible factor-1a and increased SOX9 in response to low oxygen tension in cell aggregate culture.</article-title><source>Arthritis Research &#x00026; Therapy</source><year>2007</year><volume>9</volume><fpage>R69</fpage><pub-id pub-id-type="pmid">17640365</pub-id><pub-id pub-id-type="doi">10.1186/ar2267</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ishida</surname><given-names>K</given-names></name><name><surname>Kuroda</surname><given-names>R</given-names></name><name><surname>Miwa</surname><given-names>M</given-names></name><name><surname>Tabata</surname><given-names>Y</given-names></name><name><surname>Hokugo</surname><given-names>A</given-names></name><name><surname>Kawamoto</surname><given-names>T</given-names></name><name><surname>Sasaki</surname><given-names>K</given-names></name><name><surname>Doita</surname><given-names>M</given-names></name><name><surname>Kurosaka</surname><given-names>M</given-names></name></person-group><article-title>The regenerative effects of platelet-rich plasma on meniscal cells in vitro and its in vivo application with biodegradable gelatin hydrogel.</article-title><source>Tissue Engineering</source><year>2007</year><volume>13</volume><fpage>1103-1112</fpage><pub-id pub-id-type="pmid">17348798</pub-id><pub-id pub-id-type="doi">10.1089/ten.2006.0193</pub-id></citation></ref><ref id="B20"><citation c