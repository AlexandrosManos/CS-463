critically ill</article-title><source>Intensive Care Med</source><year>2007</year><volume>33</volume><fpage>929</fpage><lpage>940</lpage><pub-id pub-id-type="pmid">17401550</pub-id><pub-id pub-id-type="doi">10.1007/s00134-007-0603-5</pub-id></citation></ref><ref id="B4"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pun</surname><given-names>BT</given-names></name><name><surname>Gordon</surname><given-names>SM</given-names></name><name><surname>Peterson</surname><given-names>JF</given-names></name><name><surname>Shintani</surname><given-names>AK</given-names></name><name><surname>Jackson</surname><given-names>JC</given-names></name><name><surname>Foss</surname><given-names>J</given-names></name><name><surname>Harding</surname><given-names>SD</given-names></name><name><surname>Bernard</surname><given-names>GR</given-names></name><name><surname>Dittus</surname><given-names>RS</given-names></name><name><surname>Ely</surname><given-names>EW</given-names></name></person-group><article-title>Large-scale implementation of sedation and delirium monitoring in the intensive care unit: a report from two medical centers</article-title><source>Crit Care Med</source><year>2005</year><volume>33</volume><fpage>1199</fpage><lpage>1205</lpage><pub-id pub-id-type="pmid">15942331</pub-id><pub-id pub-id-type="doi">10.1097/01.CCM.0000166867.78320.AC</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Devlin</surname><given-names>JW</given-names></name><name><surname>Marquis</surname><given-names>F</given-names></name><name><surname>Riker</surname><given-names>RR</given-names></name><name><surname>Robbins</surname><given-names>T</given-names></name><name><surname>Garpestad</surname><given-names>E</given-names></name><name><surname>Fong</surname><given-names>JJ</given-names></name><name><surname>Didomenico</surname><given-names>D</given-names></name><name><surname>Skrobik<