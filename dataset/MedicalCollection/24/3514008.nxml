lication-type="journal"><person-group person-group-type="author"><name><surname>Hardin</surname><given-names>M</given-names></name><name><surname>Silverman</surname><given-names>EK</given-names></name><name><surname>Barr</surname><given-names>RG</given-names></name><etal/></person-group><article-title>The clinical features of the overlap between COPD and asthma</article-title><source>Respir Res</source><year>2011</year><volume>12</volume><fpage>127</fpage><pub-id pub-id-type="pmid">21951550</pub-id></element-citation></ref><ref id="b19-copd-7-779"><label>19.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mapel</surname><given-names>DW</given-names></name><name><surname>Dutro</surname><given-names>MP</given-names></name><name><surname>Marton</surname><given-names>JP</given-names></name><name><surname>Woodruff</surname><given-names>K</given-names></name><name><surname>Make</surname><given-names>B</given-names></name></person-group><article-title>Identifying and characterizing COPD patients in US managed care. A retrospective, cross-sectional analysis of administrative claims data</article-title><source>BMC Health Serv Res</source><year>2011</year><volume>11</volume><fpage>43</fpage><pub-id pub-id-type="pmid">21345188</pub-id></element-citation></ref><ref id="b20-copd-7-779"><label>20.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kanervisto</surname><given-names>M</given-names></name><name><surname>Saarelainen</surname><given-names>S</given-names></name><name><surname>Vasankari</surname><given-names>T</given-names></name><etal/></person-group><article-title>COPD, chronic bronchitis and capacity for day-to-day activities: negative impact of illness on the health-related quality of life</article-title><source>Chron Respir Dis</source><year>2010</year><volume>7</volume><issue>4</issue><fpage>207</fpage><lpage>215</lpage><pub-id pub-id-type="pmid">21084545</pub-id></element-citation></ref><ref id="b21-copd-7-779"><label>21.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bolge</surname><given-names>SC</given-names></name><name><surname>Doan</surname><given-names>JF</given-names></name><name><surname>Kannan</surname><given-names>H</given-names></name><name><surname>Baran</surname><given-names>RW</given-names></name></person-group><article-title>Association of insomnia with quality of life, work productivity, and activity impairment</article-title><source>Qual Life Res</source><year>2009</year><volume>18</volume><issue>4</issue><fpage>415</fpage><lpage>422</lpage><pub-id pub-id-type="pmid">19288223</pub-id></element-citation></ref><ref id="b22-copd-7-779"><label>22.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>DiBonaventura</surname><given-names>M</given-names></name><name><surname>Wagner</surname><given-names>JS</given-names></name><name><surname>Yuan</surname><given-names>Y</given-names></name><name><surname>L&#x02019;Italien</surname><given-names>G</given-names></name><name><surname>Langley</surname><given-names>P</given-names></name><name><surname>Ray Kim</surname><given-names>W</given-names></name></person-group><article-title>The impact of hepatitis C on labor force participation, absenteeism, presenteeism and non-work activities</article-title><source>J Med Econ</source><year>2011</year><volume>14</volume><issue>2</issue><fpage>253</fpage><lpage>261</lpage><pub-id pub-id-type="pmid">21385147</pub-id></element-citation></ref><ref id="b23-copd-7-779"><label>23.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Finkelstein</surname><given-names>EA</given-names></name><name><surname>Allaire</surname><given-names>BT</given-names></name><name><surname>Dibonaventura</surname><given-names>MD</given-names></name><name><surname>Burgess</su