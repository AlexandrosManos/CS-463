-names></name><name><surname>Hsu</surname><given-names>CY</given-names></name><name><surname>Chang</surname><given-names>KJ</given-names></name><etal/><article-title>Selective use of ultrasonography for the detection of pneumoperitoneum</article-title><source>Acad Emerg Med</source><year>2002</year><volume>9</volume><fpage>643</fpage><lpage>5</lpage><pub-id pub-id-type="doi">10.1111/j.1553-2712.2002.tb02307.x</pub-id><pub-id pub-id-type="pmid">12045083</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><name><surname>Chadha</surname><given-names>D</given-names></name><name><surname>Kedar</surname><given-names>RP</given-names></name><name><surname>Malde</surname><given-names>HM</given-names></name><article-title>Sonographic detection of pneumoperitoneum: An experimental and clinical study</article-title><source>Australas Radiol</source><year>1993</year><volume>37</volume><fpage>182</fpage><lpage>5</lpage><pub-id pub-id-type="doi">10.1111/j.1440-1673.1993.tb00046.x</pub-id><pub-id pub-id-type="pmid">8512509</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Radwan</surname><given-names>MM</given-names></name><name><surname>Abu-Zidan</surname><given-names>FM</given-names></name><article-title>Focussed Assessment Sonography for Trauma (FAST) and CT scan in blunt abdominal trauma: surgeon's perspective</article-title><source>Afr Health Sci</source><year>2006</year><volume>6</volume><fpage>187</fpage><lpage>90</lpage><pub-id pub-id-type="pmid">17140344</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Abu-Zidan</surname><given-names>FM</given-names></name><name><surname>Sheikh</surname><given-names>M</given-names></name><name><surname>Jaddallah</surname><given-names>F</given-names></name><name><surname>Windsor</surname><given-names>JA</given-names></name><article-title>Blunt abdominal trauma: Comparison of ultrasonography and computed tomography</article-title><source>Austral Radiol</source><year>1999</year><volume>43</volume><fpage>440</fpage><lpage>3</lpage><pub-id pub-id-type="doi">10.1046/j.1440-1673.1999.00708.x</pub-id></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="journal"><name><surname>Garc&#x000ed;a Santos</surname><given-names>JM</given-names></name><article-title>Direct sonographic signs of acute duodenal ulcer</article-title><source>Abdom Imaging</source><year>1999</year><volume>24</volume><fpage>226</fpage><lpage>7</lpage><pub-id pub-id-type="doi">10.1007/s002619900485</pub-id><pub-id pub-id-type="pmid">10227883</pub-id></mixed-citation></ref></ref-list></back></article>