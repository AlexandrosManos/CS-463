-title>Neuronal cell death</article-title><source>Neuron</source><volume>20</volume><year>1998</year><fpage>633</fpage><lpage>647</lpage><pub-id pub-id-type="pmid">9581757</pub-id></citation></ref><ref id="ReedandPaternostro1999"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reed</surname><given-names>J.C.</given-names></name><name><surname>Paternostro</surname><given-names>G.</given-names></name></person-group><article-title>Post-mitochondrial regulation of apoptosis during heart failure</article-title><source>Proc. Natl. Acad. Sci. USA</source><volume>96</volume><year>1999</year><fpage>7614</fpage><lpage>7616</lpage><pub-id pub-id-type="pmid">10393865</pub-id></citation></ref><ref id="Rehemtullaetal1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rehemtulla</surname><given-names>A.</given-names></name><name><surname>Hamilton</surname><given-names>C.A.</given-names></name><name><surname>Chinnaiyan</surname><given-names>A.M.</given-names></name><name><surname>Dixit</surname><given-names>V.M.</given-names></name></person-group><article-title>Ultraviolet radiation-induced apoptosis is mediated by activation of CD-95 (Fas/APO-1)</article-title><source>J. Biol. Chem</source><volume>272</volume><year>1997</year><fpage>25783</fpage><lpage>25786</lpage><pub-id pub-id-type="pmid">9325306</pub-id></citation></ref><ref id="RodriguezandLazebnik1999"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rodriguez</surname><given-names>J.</given-names></name><name><surname>Lazebnik</surname><given-names>Y.</given-names></name></person-group><article-title>Caspase-9 and Apaf-1 form an active holoenzyme</article-title><source>Genes Dev</source><volume>13</volume><year>1999</year><fpage>3179</fpage><lpage>3184</lpage><pub-id pub-id-type="pmid">10617566</pub-id></citation></ref><ref id="Rodriguezetal2000"><citation citation-type="journal"><person-group perso