<surname>De Pinieux</surname><given-names>G</given-names></name><name><surname>Charrois</surname><given-names>O</given-names></name><name><surname>Kerboull</surname><given-names>M</given-names></name><name><surname>Courpied</surname><given-names>JP</given-names></name><article-title>Surgical treatment of pigmented villonodular synovitis of the hip</article-title><source>J Bone Joint Surg Am</source><year>2005</year><volume>87</volume><fpage>1019</fpage><lpage>1024</lpage><pub-id pub-id-type="doi">10.2106/JBJS.C.01297</pub-id><pub-id pub-id-type="pmid">15866964</pub-id></mixed-citation></ref><ref id="B6"><mixed-citation publication-type="journal"><name><surname>Murphey</surname><given-names>MD</given-names></name><name><surname>Rhee</surname><given-names>JH</given-names></name><name><surname>Lewis</surname><given-names>RB</given-names></name><name><surname>Fanburg-Smith</surname><given-names>JC</given-names></name><name><surname>Flemming</surname><given-names>DJ</given-names></name><name><surname>Walker</surname><given-names>EA</given-names></name><article-title>Pigmented villonodular synovitis: radiologic-pathologic correlation</article-title><source>Radiographics</source><year>2008</year><volume>28</volume><fpage>1493</fpage><lpage>1518</lpage><pub-id pub-id-type="doi">10.1148/rg.285085134</pub-id><pub-id pub-id-type="pmid">18794322</pub-id></mixed-citation></ref><ref id="B7"><mixed-citation publication-type="journal"><name><surname>Rahman</surname><given-names>A</given-names></name><name><surname>Isenberg</surname><given-names>DA</given-names></name><article-title>Systemic lupus erythematosus</article-title><source>N Engl J Med</source><year>2008</year><volume>358</volume><fpage>929</fpage><lpage>939</lpage><pub-id pub-id-type="doi">10.1056/NEJMra071297</pub-id><pub-id pub-id-type="pmid">18305268</pub-id></mixed-citation></ref><ref id="B8"><mixed-citation publication-type="journal"><name><surname>Houssiau</surname><given-names>FA</given-names></name><name><surname