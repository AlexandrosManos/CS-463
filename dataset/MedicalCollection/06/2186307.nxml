rganisation and Management</source><year>2004</year><volume>18</volume><fpage>179</fpage><lpage>194</lpage><pub-id pub-id-type="doi">10.1108/14777260410548428</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crutcher</surname><given-names>RA</given-names></name><name><surname>Then</surname><given-names>K</given-names></name><name><surname>Edwards</surname><given-names>A</given-names></name><name><surname>Taylor</surname><given-names>K</given-names></name><name><surname>Norton</surname><given-names>P</given-names></name></person-group><article-title>Multi-professional education in diabetes</article-title><source>Medical Teacher</source><year>2004</year><volume>26</volume><fpage>435</fpage><lpage>443</lpage><pub-id pub-id-type="pmid">15369884</pub-id><pub-id pub-id-type="doi">10.1080/01421590410001711607</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McNeill</surname><given-names>D</given-names></name><name><surname>Kelly</surname><given-names>E</given-names></name></person-group><article-title>How the national healthcare quality and disparities reports can catalyse quality improvement</article-title><source>Medical Care</source><year>2005</year><volume>43</volume><fpage>182</fpage><lpage>188</lpage><pub-id pub-id-type="pmid">15655432</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Williams</surname><given-names>B</given-names></name></person-group><article-title>Developing critical reflection for professional practice through problem-based learning</article-title><source>Journal of Advanced Nursing</source><year>2001</year><volume>34</volume><fpage>27</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">11430603</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2648.2001.3411737.x</pub-id></citation></ref><ref id="B26"><citation ci