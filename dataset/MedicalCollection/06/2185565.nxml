><publisher-name>Academic Press, Inc.</publisher-name><publisher-loc>San Diego, CA</publisher-loc></citation></ref><ref id="Hilleretal1996"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hiller</surname><given-names>M.M.</given-names></name><name><surname>Finger</surname><given-names>A.</given-names></name><name><surname>Schweiger</surname><given-names>M.</given-names></name><name><surname>Wolf</surname><given-names>D.H.</given-names></name></person-group><article-title>ER degradation of a misfolded luminal protein by the cytosolic ubiquitin&#x02013;proteasome pathway</article-title><source>Science.</source><volume>273</volume><year>1996</year><fpage>1725</fpage><lpage>1728</lpage><pub-id pub-id-type="pmid">8781238</pub-id></citation></ref><ref id="Johnsonetal1995"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnson</surname><given-names>E.S.</given-names></name><name><surname>Ma</surname><given-names>P.C.</given-names></name><name><surname>Ota</surname><given-names>I.M.</given-names></name><name><surname>Varshavsky</surname><given-names>A.</given-names></name></person-group><article-title>A proteolytic pathway that recognizes ubiquitin as a degradation signal</article-title><source>J. Biol. Chem.</source><volume>270</volume><year>1995</year><fpage>17442</fpage><lpage>17456</lpage><pub-id pub-id-type="pmid">7615550</pub-id></citation></ref><ref id="Kaufman1999"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaufman</surname><given-names>R.J.</given-names></name></person-group><article-title>Stress signaling from the lumen of the endoplasmic reticulumcoordination of gene transcriptional and translational controls</article-title><source>Genes Dev.</source><volume>13</volume><year>1999</year><fpage>1211</fpage><lpage>1233</lpage><pub-id pub-id-type="pmid">10346810</pub-id></citation></ref><ref id="Kawaharaetal1997"><citation citation-type=