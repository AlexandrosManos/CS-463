bia</td><td align="left" valign="top" rowspan="1" colspan="1">496 (37.7)</td><td align="left" valign="top" rowspan="1" colspan="1">&#x02013;</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">United Arab Emirates</td><td align="left" valign="top" rowspan="1" colspan="1">214 (16.3)</td><td align="left" valign="top" rowspan="1" colspan="1">&#x02013;</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Age (years); mean &#x000b1; SD<xref ref-type="table-fn" rid="tfn3-vhrm-7-491"><sup>a</sup></xref></td><td align="left" valign="top" rowspan="1" colspan="1">57.9 &#x000b1; 7.0</td><td align="left" valign="top" rowspan="1" colspan="1">64.4 &#x000b1; 9.5</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">No. of males/females<xref ref-type="table-fn" rid="tfn3-vhrm-7-491"><sup>a</sup></xref></td><td align="left" valign="top" rowspan="1" colspan="1">529/323 (62/38)</td><td align="left" valign="top" rowspan="1" colspan="1">12481/12338 (50/50)</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">BMI (kg/m<sup>2</sup>); mean &#x000b1; SD<xref ref-type="table-fn" rid="tfn3-vhrm-7-491"><sup>a</sup></xref></td><td align="left" valign="top" rowspan="1" colspan="1">29.5 &#x000b1; 4.2</td><td align="left" valign="top" rowspan="1" colspan="1">27.6 &#x000b1; 4.1</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">SBP (mmHg); mean &#x000b1; SD<xref ref-type="table-fn" rid="tfn3-vhrm-7-491"><sup>a</sup></xref></td><td align="left" valign="top" rowspan="1" colspan="1">165.6 &#x000b1; 14.5</td><td align="left" valign="top" rowspan="1" colspan="1">161.8 &#x000b1; 12.9</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">DBP (mmHg); mean &#x000b1; SD<xref ref-type="table-fn" rid="tfn3-vhrm-7-491"><sup>a</sup></xref></td><td align="left" valign="top" rowspan="1" colspan="1">96.6 &#x000b1; 9.0</td><td align="left" valign="top" rowspan="1" colspan="1">92.9 &#x000b1; 8.8</td></tr><tr><td align="left" valign="