center" rowspan="1" colspan="1">8</td><td align="center" rowspan="1" colspan="1">8.9 &#x000b1; 1.4</td><td align="center" rowspan="1" colspan="1">13.8 &#x000b1; 1.9</td></tr><tr><td align="left" rowspan="1" colspan="1">Motor alterations with constant peristalsis</td><td align="center" rowspan="1" colspan="1">4</td><td align="center" rowspan="1" colspan="1">8.3 &#x000b1; 1.5</td><td align="center" rowspan="1" colspan="1">16.5 &#x000b1; 1.3</td></tr><tr><td align="left" rowspan="1" colspan="1">Motor alterations with intermittent peristalsis</td><td align="center" rowspan="1" colspan="1">4</td><td align="center" rowspan="1" colspan="1">17.5 &#x000b1; 8.7<sup>&#x02227;</sup></td><td align="center" rowspan="1" colspan="1">16.8 &#x000b1; 7.5</td></tr><tr><td align="left" rowspan="1" colspan="1">Aperistalsis in non achalasic patients</td><td align="center" rowspan="1" colspan="1">6</td><td align="center" rowspan="1" colspan="1">30.8 &#x000b1; 22.9*</td><td align="center" rowspan="1" colspan="1">35.8 &#x000b1; 12.4<sup>&#x000a7;&#x000a7;</sup></td></tr><tr><td align="left" rowspan="1" colspan="1">Aperistalsis in achalasic patients</td><td align="center" rowspan="1" colspan="1">10</td><td align="center" rowspan="1" colspan="1">47.5 &#x000b1; 17.2**</td><td align="center" rowspan="1" colspan="1">34.3 &#x000b1; 15<sup>&#x000a7;</sup></td></tr></tbody></table><table-wrap-foot><fn><p>						<sup>&#x02227;</sup>						<italic>P</italic> &#x0003c; 0.06 versus controls.</p></fn><fn><p>*<italic>P</italic> &#x0003c; 0.06 versus controls; <italic>P</italic> &#x0003c; 0.06 versus constant peristalsis.</p></fn><fn><p>**<italic>P</italic> &#x0003c; 0.01 versus controls; <italic>P</italic> &#x0003c; 0.005 versus constant peristalsis; <italic>P</italic> &#x0003c; 0.02 versus intermittent peristalsis.</p></fn><fn><p>						<sup>&#x000a7;</sup>						<italic>P</italic> &#x0003c; 0.03 versus controls; <italic>P</italic> &#x0003c; 0.05 versus intermittent peristalsis.</p></fn><fn><p>						<sup>&#x