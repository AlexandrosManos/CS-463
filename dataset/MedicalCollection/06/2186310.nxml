 person-group-type="author"><name><surname>Orley</surname><given-names>J</given-names></name><name><surname>Wing</surname><given-names>K</given-names></name><name><surname>Ahmed</surname><given-names>I</given-names></name></person-group><article-title>Psychiatric disorders in two African villages</article-title><source>Arch of Gen Psychiatry</source><year>1997</year><volume>367</volume><fpage>513</fpage><lpage>520</lpage></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hollifield</surname><given-names>M</given-names></name><name><surname>Katon</surname><given-names>W</given-names></name><name><surname>Spain</surname><given-names>D</given-names></name><name><surname>Pule</surname><given-names>L</given-names></name></person-group><article-title>Anxiety and depression in a village in Lesotho, Africa: a comparison with the United States</article-title><source>Br J Psychiatry</source><year>1990</year><volume>156</volume><fpage>343</fpage><lpage>350</lpage><pub-id pub-id-type="pmid">2346832</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Abas</surname><given-names>MA</given-names></name><name><surname>Broadhead</surname><given-names>JC</given-names></name></person-group><article-title>Depression and anxiety among women in an urban setting in Zimbabwe</article-title><source>Psychol Med</source><year>1997</year><volume>27</volume><fpage>59</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">9122309</pub-id><pub-id pub-id-type="doi">10.1017/S0033291796004163</pub-id></citation></ref><ref id="B12"><citation citation-type="other"><person-group person-group-type="author"><collab>Population Division</collab><collab>Department of Economic and Social Affairs</collab><collab>United Nations Secretariat</collab><collab>U.N</collab></person-group><article-title>The world at six billion (ESA/P/WP.154).</article-title><source>New York: U