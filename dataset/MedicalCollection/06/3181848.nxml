up person-group-type="author"><name><surname>Gorno-Tempini</surname><given-names>ML.</given-names></name><name><surname>Dronkers</surname><given-names>NF.</given-names></name><name><surname>Rankin</surname><given-names>KP.</given-names></name><name><surname>et al.</surname></name></person-group><article-title>Cognition and anatomy in three variants of primary progressive aphasia.</article-title><source><italic>Ann Neurol.</italic></source><year>2004</year><volume>55</volume><fpage>335</fpage><lpage>346</lpage><pub-id pub-id-type="pmid">14991811</pub-id></element-citation></ref><ref id="ref9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hodges</surname><given-names>JR.</given-names></name><name><surname>Patterson</surname><given-names>K.</given-names></name><name><surname>Oxbury</surname><given-names>S.</given-names></name><name><surname>Funnell</surname><given-names>E.</given-names></name></person-group><article-title>Semantic dementia. Progressive fluent aphasia with temporal lobe atrophy.</article-title><source><italic>Brain.</italic></source><year>1992</year><volume>115</volume><fpage>1783</fpage><lpage>1806</lpage><pub-id pub-id-type="pmid">1486461</pub-id></element-citation></ref><ref id="ref10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bozeat</surname><given-names>S.</given-names></name><name><surname>Gregory</surname><given-names>CA.</given-names></name><name><surname>Ralph</surname><given-names>MA.</given-names></name><name><surname>Hodges</surname><given-names>JR.</given-names></name></person-group><article-title>Which neuropsychiatrie and behavioural features distinguish frontal and temporal variants of frontotemporal dementia from Alzheimer's disease?</article-title><source><italic>J Neurol Neurosurg Psychiatry.</italic></source><year>2000</year><volume>69</volume><fpage>178</fpage><lpage>186</lpage><pub-id pu