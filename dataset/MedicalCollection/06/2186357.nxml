e>The association of objectively-determined physical activity behavior between adolescent female friends</article-title><source>Res Q Exerc Sport</source><year>2007</year><volume>78</volume><fpage>9</fpage><lpage>15</lpage><pub-id pub-id-type="pmid">17479569</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McGuire</surname><given-names>MT</given-names></name><name><surname>Hannan</surname><given-names>PJ</given-names></name><name><surname>Neumark-Sztainer</surname><given-names>D</given-names></name><name><surname>Cossrow</surname><given-names>NH</given-names></name><name><surname>Story</surname><given-names>M</given-names></name></person-group><article-title>Parental correlates of physical activity in a racially/ethnically diverse adolescent sample</article-title><source>J Adolesc Health</source><year>2002</year><volume>30</volume><fpage>253</fpage><lpage>261</lpage><pub-id pub-id-type="pmid">11927237</pub-id><pub-id pub-id-type="doi">10.1016/S1054-139X(01)00392-5</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Biddle</surname><given-names>S</given-names></name><name><surname>Goudas</surname><given-names>M</given-names></name></person-group><article-title>Analysis of children's physical activity and its association with adult encouragement and social cognitive variables</article-title><source>J Sch Health</source><year>1996</year><volume>66</volume><fpage>75</fpage><lpage>78</lpage><pub-id pub-id-type="pmid">8930014</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Motl</surname><given-names>RW</given-names></name><name><surname>Dishman</surname><given-names>RK</given-names></name><name><surname>Saunders</surname><given-names>RP</given-names></name><name><surname>Dowda</surname><given-names>M</given-names></name><name><surname>Pate</surname><given-names>RR</given-names></name></person-group><article-title>Perceptions of physical and social environment variables and self-efficacy as correlates of self-reported physical activity among adolescent girls</article-title><source>J Pediatr Psychol</source><year>2007</year><volume>32</volume><fpage>6</fpage><lpage>12</lpage><pub-id pub-id-type="pmid">16707779</pub-id><pub-id pub-id-type="doi">10.1093/jpepsy/jsl001</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Motl</surname><given-names>RW</given-names></name><name><surname>Dishman</surname><given-names>RK</given-names></name><name><surname>Ward</surname><given-names>DS</given-names></name><name><surname>Saunders</surname><given-names>RP</given-names></name><name><surname>Dowda</surname><given-names>M</given-names></name><name><surname>Felton</surname><given-names>G</given-names></name><name><surname>Pate</surname><given-names>RR</given-names></name></person-group><article-title>Perceived physical environment and physical activity across one year among adolescent girls: self-efficacy as a possible mediator?</article-title><source>J Adolesc Health</source><year>2005</year><volume>37</volume><fpage>403</fpage><lpage>408</lpage><pub-id pub-id-type="pmid">16227126</pub-id><pub-id pub-id-type="doi">10.1016/j.jadohealth.2004.10.004</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Strauss</surname><given-names>RS</given-names></name><name><surname>Rodzilsky</surname><given-names>D</given-names></name><name><surname>Burack</surname><given-names>G</given-names></name><name><surname>Colin</surname><given-names>M</given-names></name></person-group><article-title>Psychosocial correlates of physical activity in healthy children</article-title><source>Arch Pediatr Adolesc Med</source><year>2001</year><volume>155</volume><fpage>897</fpage><lpage>902</lpage