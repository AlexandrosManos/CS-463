b-id pub-id-type="pmid">9832565</pub-id></citation></ref><ref id="SanesandLichtman1999"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sanes</surname><given-names>J.R.</given-names></name><name><surname>Lichtman</surname><given-names>J.W.</given-names></name></person-group><article-title>Development of the vertebrate neuromuscular junction</article-title><source>Annu. Rev. Neurosci</source><volume>22</volume><year>1999</year><fpage>389</fpage><lpage>442</lpage><pub-id pub-id-type="pmid">10202544</pub-id></citation></ref><ref id="Sellsetal1999"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sells</surname><given-names>M.A.</given-names></name><name><surname>Boyd</surname><given-names>J.T.</given-names></name><name><surname>Chernoff</surname><given-names>J.</given-names></name></person-group><article-title>p21-Activated kinase 1 (Pak1) regulates cell motility in mammalian fibroblasts</article-title><source>J. Cell Biol.</source><volume>145</volume><year>1999</year><fpage>837</fpage><lpage>849</lpage><pub-id pub-id-type="pmid">10330410</pub-id></citation></ref><ref id="ShadiackandNitkin1991"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shadiack</surname><given-names>A.M.</given-names></name><name><surname>Nitkin</surname><given-names>R.M.</given-names></name></person-group><article-title>Agrin induces &#x003b1;-actinin, filamin, and vinculin to co-localize with AChR clusters on cultured myotubes</article-title><source>J. Neurobiol</source><volume>22</volume><year>1991</year><fpage>617</fpage><lpage>628</lpage><pub-id pub-id-type="pmid">1655973</pub-id></citation></ref><ref id="Spectoretal1989"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Spector</surname><given-names>I.</given-names></name><name><surname>Shochet</surname><given-names>N.R.</given-names></name><name><surname>Blasberger</surname><given-names>D.</given-names></name><name><surname>Kashman</surname><given-names>Y.</given-names></name></person-group><article-title><italic>Cell Motil</italic></article-title><source>Cytoskelet.</source><volume>13</volume><year>1989</year><fpage>127</fpage><lpage>144</lpage></citation></ref><ref id="StyaandAxelrod1983"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stya</surname><given-names>M.</given-names></name><name><surname>Axelrod</surname><given-names>D.</given-names></name></person-group><article-title>Mobility and detergent extractability of acetylcholine receptors on cultured rat myotubesa correlation</article-title><source>J. Cell Biol</source><volume>97</volume><year>1983</year><fpage>48</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">6863395</pub-id></citation></ref><ref id="Tanetal1996"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tan</surname><given-names>Y.</given-names></name><name><surname>Rouse</surname><given-names>J.</given-names></name><name><surname>Zhang</surname><given-names>A.</given-names></name><name><surname>Cariati</surname><given-names>S.</given-names></name><name><surname>Cohen</surname><given-names>P.</given-names></name><name><surname>Comb</surname><given-names>M.J.</given-names></name></person-group><article-title>FGF and stress regulate CREB and ATF-1 via a pathway involving p38 MAP kinase and MAPKAP kinase-2</article-title><source>EMBO (Eur. Mol. Biol. Organ.) J.</source><volume>15</volume><year>1996</year><fpage>4629</fpage><lpage>4642</lpage></citation></ref><ref id="TaponandHall1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tapon</surname><given-names>N.</given-names></name><name><surname>Hall</surname><given-names>A.</given-names></name></person-group><article-title>Rho, Rac and Cdc42 GTPases regulate the organization of the actin cytoskeleton</article-title><source>Curr. Opin. Cell Biol</source><volume>9</volume><year>1997</year><fpage>86</fpage><lpage>92</lpage><pub-id pub-id-type="pmid">9013670</pub-id></citation></ref><ref id="Valenzuelaetal1996"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Valenzuela</surname><given-names>D.M.</given-names></name><name><surname>Stitt</surname><given-names>T.N.</given-names></name><name><surname>DiStefano</surname><given-names>P.S.</given-names></name><name><surname>Rojas</surname><given-names>E.</given-names></name><name><surname>Mattsson</surname><given-names>K.</given-names></name><name><surname>Compton</surname><given-names>D.L.</given-names></name><name><surname>Lunez</surname><given-names>L.</given-names></name><name><surname>Park</surname><given-names>J.S.</given-names></name><name><surname>Stark</surname><given-names>J.L.</given-names></name><name><surname>Gies</surname><given-names>D.R.</given-names></name></person-group><article-title>Receptor tyrosine kinase specific for the skeletal muscle lineageexpression in embryonic muscle, at the neuromuscular junction, and after injury</article-title><source>Neuron.</source><volume>15</volume><year>1996</year><fpage>573</fpage><lpage>584</lpage><pub-id pub-id-type="pmid">7546737</pub-id></citation></ref><ref id="VanLeeuwenetal1999"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Van Leeuwen</surname><given-names>F.N.</given-names></name><name><surname>Van Delft</surname><given-names>S.</given-names></name><name><surname>Kain</surname><given-names>H.E.</given-names></name><name><surname>Van Der Kammen</surname><given-names>R.A.</given-names></name><name><surname>Collard</surname><given-names>J.G.</given-names></name></person-group><article-title>Rac regulates phosphorylation of the myosin-II heavy chain, actinomyosin disassembly and cell spreading</article-title><source>Nature Cell Biol.</source><volume>1</volume><year>1999</year><fpage>242</fpage><lpage>248</lpage><pub-id pub-id-type="pmid">10559923</pub-id></citation></ref><ref id="Yangetal1998"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yang</surname><given-names>N.</given-names></name><name><surname>Higuchi</surname><given-names>O.</given-names></name><name><surname>Ohashi</surname><given-names>K.</given-names></name><name><surname>Nagata</surname><given-names>K.</given-names></name><name><surname>Wada</surname><given-names>A.</given-names></name><name><surname>Kangawa</surname><given-names>K.</given-names></name><name><surname>Nishida</surname><given-names>E.</given-names></name><name><surname>Mizuno</surname><given-names>K.</given-names></name></person-group><article-title>Cofilin phosphorylation by LIM-kinase 1 and its role in Rac-mediated actin reorganization</article-title><source>Nature.</source><volume>393</volume><year>1998</year><fpage>809</fpage><lpage>812</lpage><pub-id pub-id-type="pmid">9655398</pub-id></citation></ref></ref-list><fn-group><fn><p><italic>Abbreviations used in this paper:</italic> AChR, acetylcholine receptor&#x0003b; ECL, enhanced chemiluminescence&#x0003b; GST-PBD, plasmid-encoding GST fused to the Cdc42/Rac (p-21)&#x02013;binding domain&#x0003b; JNK, c-Jun NH<sub>2</sub>-terminal kinase&#x0003b; MuSK, muscle-specific receptor tyrosine kinase&#x0003b; PAK, p21-activated kinase&#x0003b; TMR-Bgt, TMR-&#x003b1;-bungarotoxin.</p></fn></fn-group></back><floats-wrap><fig position="float" id="F1"><label>Figure 1</label><caption><p>Prevention of agrin-induced AChR clustering by inhibition of actin polymerization. (A) AChRs, stained with TMR-Bgt, are uniformly dispersed on untreated control C2C12 myotubes (a). In contrast, myotubes treated with agrin (5 nM, 6 h) show extensive AChR clustering (b&#x0003b; arrows). This effect is prevented by latrunculin B (0.2 &#x003bc;M), which interferes with actin polymerization (c). (B) C2C12 cultures were transfected with T7 epitope&#x02013;tagged vector or RacN17, or Myc-tagged Cdc42N17. After 2 d in differentiation medium, cultures were examined by fluorescence microscopy. Vector-transfected C2C12 muscle cells (a) show AChR clustering (arrows) in response to agrin (16 h&#x0003b; b). Expression of RacN17 (c) does not interfere with myoblast fusion and expression of sarcomeric actin in myotubes (d). Bars, 10 &#x003bc;m.</p></caption><graphic xlink:href="JCB0002133.f1"/></fig><fig id="F2"><label>Figure 2</label><caption><p>Prevention of agrin-induced AChR clustering by dominant interfering mutants of Rac (RacN17) and Cdc42 (Cdc42N17). C2C12 cultures were transfected with T7 epitope&#x02013;tagged RacN17, or Myc-tagged Cdc42N17. After 2 d in differentiation medium, cultures were treated with agrin for 16 h and labeled with TMR-Bgt. (A) In contrast to cells expressing vector (see <xref ref-type="fig" rid="F1">Fig. 1</xref>), myotubes expressing RacN17 (a) do not display clustered AChR after agrin treatment (b). Likewise, muscle cells transfected with Cdc42N17 (c) do not show agrin-induced AChR clustering (d). Also visible in b and d are agrin-induced AChR clusters on nontransfected myotubes adjacent to the transfected myotube. In contrast to RacN17- or Cdc42N17-transfected myotubes, muscle cells expressing RasN17 (e) display AChR aggregates (arrows) upon agrin treatment (f). Bar, 10 &#x003bc;m. (B) Quantitative comparison of AChR clusters on the surface of transfected myotubes expressing RacN17 or Cdc42N17 versus control myotubes (mean &#x000b1; SEM, <italic>n</italic> = 40).</p></caption><graphic xlink:href="JCB0002133.f2a"/><graphic xlink:href="JCB0002133.f2b"/></fig><fig id="F3"><label>Figure 3</label><caption><p>Stimulation of AChR cluster formation by constitutively active mutants of Rac (RacV12) and Cdc42 (Cdc42V12). (A) The effect of Rac and Cdc42 activation on AChR clustering was assessed by transfecting cultures with T7-RacV12 (a and b) or myc-Cdc42V12 (c and d). Cells were surface labeled with TMR-Bgt and immunolabeled with anti-T7 or anti-myc antibody. Myotubes expressing RacV12 (a) showed markedly elevated aggregation of surface AChR into microclusters (b). Myotubes expressing Cdc42V12 (c) displayed a similar increase in AChR microcluster formation (d). Bars, 10 &#x003bc;m. (B) Quantitative comparison of AChR microcluster numbers on the surface of transfected myotubes expressing RacV12 or Cdc42V12 versus control myotubes (mean &#x000b1; SEM, <italic>n</italic> = 40).</p></caption><graphic xlink:href="JCB0002133.f3a"/><graphic xlink:href="JCB0002133.f3b"/></fig><fig position="float" id="F4"><label>Figure 4</label><caption><p>Stimulation of Rac and Cdc42 binding to PAK and c-Jun phosphorylation by agrin treatment of C2C12 myotubes. (A) Stimulation of Rac and Cdc42 binding to PAK. Agrin-induced Rac activation (a) and Cdc42 activation (b) in nontransfected C2C12 myoblasts and myotubes was measured by the increase in the endogenous Rac or Cdc42 bound to PBD, a PAK1 domain that specifically binds the GTP-bound form of Rac and Cdc42 (<xref ref-type="bib" rid="Sanderetal1998">Sander et al. 1998</xref>). Cultures were treated with agrin, and lysates were incubated with GST-PBD and Western blotted with antibody to Rac (a) or Cdc42 (b). Agrin caused increased association of both Rac and Cdc42 with GST-PBD in myotubes but not in myoblasts. (B) Muscle-selective activation of JNK by agrin treatment. (a) Agrin-induced activation of JNK was determined in myotubes, myoblasts, and HEK293 cells. JNK activation by agrin was observed in differentiated C2C12 myotubes but not in undifferentiated myoblasts or in HEK293 cells. Unlike agrin, anisomycin, an activator of JNK by a distinct pathway, caused equivalent JNK activation in myoblasts and myotubes, showing that JNK itself is unaffected by myotube differentiation. (b) Time course of agrin stimulation of c-Jun phosphorylation in myotubes. The transient nature of the response to the continued presence of agrin is evidenced by the results showing that c-Jun phosphorylation reaches a maximum within 30 min and subsequently declines.</p></caption><graphic xlink:href="JCB0002133.f4"/></fig><fig position="float" id="F5"><label>Figure 5</label><caption><p>Dependence of agrin stimulation of JNK activity on Rac (A) and Cdc42 (B). C2C12 cells were cotransfected with FLAG epitope&#x02013;tagged JNK and Rac or Cdc42 mutants. Immunoprecipitated JNK was incubated with &#x003b3;-[<sup>32</sup>P]ATP and GST&#x02013;c-Jun. GST&#x02013;c-Jun phosphorylation was visualized by autoradiography. As quantitated by PhosphorImager, the three-fold increase in phosphorylation induced by agrin was eliminated by dominant negative Rac and Cdc42 mutants. Protein expression, monitored by Western blotting with anti-JNK1, anti-T7, or anti-myc antibodies, was equivalent under these conditions.</p></caption><graphic xlink:href="JCB0002133.f5"/></fig><fig position="float" id="F6"><label>Figure 6</label><caption><p>Model showing interactions of surface AChR with associated proteins and a suggested mechanism for the Rac/Cdc42-mediated clustering of these proteins in response to agrin. This scheme is similar to that proposed by Fuhrer et al., 1999. The novel feature is the role of Rac and Cdc42 in inducing the clustering by producing localized remodeling of actin-based cytoskeleton upon the activation of these monomeric G proteins by agrin signaling. Shown here is one possible mechanism for Rac/Cdc42-mediated cytoskeletal changes that involves the PAK, LIM kinase cofilin downstream effector pathway (<xref ref-type="bib" rid="Arberetal1998">Arber et al. 1998</xref>&#x0003b; <xref ref-type="bib" rid="Yangetal1998">Yang et al. 1998</xref>&#x0003b; <xref ref-type="bib" rid="Sellsetal1999">Sells et al. 1999</xref>).</p></caption><graphic xlink:href="JCB0002133.f6"/></fig></floats-wrap></article>