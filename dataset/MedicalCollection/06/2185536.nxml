 id="Drubinetal1993"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Drubin</surname><given-names>D.G.</given-names></name><name><surname>Jones</surname><given-names>H.D.</given-names></name><name><surname>Wertman</surname><given-names>K.F.</given-names></name></person-group><article-title>Actin structure and functionroles in mitochondrial organization and morphogenesis in budding yeast and identification of the phalloidin-binding site</article-title><source>Mol. Biol. Cell</source><volume>4</volume><year>1993</year><fpage>1277</fpage><lpage>1294</lpage><pub-id pub-id-type="pmid">8167410</pub-id></citation></ref><ref id="Dudenetal1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Duden</surname><given-names>R.</given-names></name><name><surname>Hosobuchi</surname><given-names>M.</given-names></name><name><surname>Hamamoto</surname><given-names>S.</given-names></name><name><surname>Winey</surname><given-names>M.</given-names></name><name><surname>Byers</surname><given-names>B.</given-names></name><name><surname>Schekman</surname><given-names>R.</given-names></name></person-group><article-title>Yeast beta- and beta&#x02032;-coat proteins (COP). Two coatomer subunits essential for endoplasmic reticulum-to-Golgi traffic</article-title><source>J. Biol. Chem.</source><volume>269</volume><year>1994</year><fpage>24486</fpage><lpage>24495</lpage><pub-id pub-id-type="pmid">7929113</pub-id></citation></ref><ref id="Franzusoffetal1991"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Franzusoff</surname><given-names>A.</given-names></name><name><surname>Redding</surname><given-names>K.</given-names></name><name><surname>Crosby</surname><given-names>J.</given-names></name><name><surname>Fuller</surname><given-names>R.S.</given-names></name><name><surname>Schekman</surname><given-names>R.</given-names></name></person-group><article-title>Localization of components involved in protein transport and processing through the yeast Golgi apparatus</article-title><source>J. Cell Biol.</source><volume>112</volume><year>1991</year><fpage>27</fpage><lpage>37</lpage><pub-id pub-id-type="pmid">1986005</pub-id></citation></ref><ref id="Gaynoretal1998a"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gaynor</surname><given-names>E.C.</given-names></name><name><surname>Chen</surname><given-names>C.Y.</given-names></name><name><surname>Emr</surname><given-names>S.D.</given-names></name><name><surname>Graham</surname><given-names>T.R.</given-names></name></person-group><article-title>ARF is required for maintenance of yeast Golgi and endosome structure and function</article-title><source>Mol. Biol. Cell</source><volume>9</volume><year>1998</year><fpage>653</fpage><lpage>670</lpage>a<pub-id pub-id-type="pmid">9487133</pub-id></citation></ref><ref id="Gaynoretal1998b"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gaynor</surname><given-names>E.C.</given-names></name><name><surname>Graham</surname><given-names>T.R.</given-names></name><name><surname>Emr</surname><given-names>S.D.</given-names></name></person-group><article-title>COPI in ER/Golgi and intra-Golgi transportdo yeast COPI mutants point the way?</article-title><source>Biochim. Biophys. Acta</source><volume>1404</volume><year>1998</year><fpage>33</fpage><lpage>51</lpage>b<pub-id pub-id-type="pmid">9714721</pub-id></citation></ref><ref id="GietzandSugino1988"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gietz</surname><given-names>R.D.</given-names></name><name><surname>Sugino</surname><given-names>A.</given-names></name></person-group><article-title>New yeast-<italic>Escherichia coli</italic> shuttle vectors constructed with in vitro mutagenized yeast genes lacking six-base pair restriction sites</article-title><source>Gene</source><volume>74</vo