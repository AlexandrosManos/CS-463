doi">10.1067/mtc.2001.111196</pub-id><pub-id pub-id-type="pmid">11326253</pub-id></mixed-citation></ref><ref id="B9"><mixed-citation publication-type="journal"><name><surname>Mokoena</surname><given-names>T</given-names></name><name><surname>Shama</surname><given-names>DM</given-names></name><name><surname>Ngakane</surname><given-names>H</given-names></name><name><surname>Bryer</surname><given-names>JV</given-names></name><article-title>Oesophageal tuberculosis: a review of eleven cases</article-title><source>Postgrad Med J</source><year>1992</year><volume>68</volume><issue>796</issue><fpage>110</fpage><lpage>115</lpage><pub-id pub-id-type="doi">10.1136/pgmj.68.796.110</pub-id><pub-id pub-id-type="pmid">1570250</pub-id></mixed-citation></ref><ref id="B10"><mixed-citation publication-type="journal"><name><surname>Lockard</surname><given-names>LB</given-names></name><article-title>Oesophageal tuberculosis: a critical review</article-title><source>Laryngoscope</source><year>1913</year><volume>23</volume><fpage>561</fpage><lpage>584</lpage></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><name><surname>Damtew</surname><given-names>B</given-names></name><name><surname>Frengley</surname><given-names>D</given-names></name><name><surname>Wolinsky</surname><given-names>E</given-names></name><name><surname>Spagnuolo</surname><given-names>PJ</given-names></name><article-title>Esophageal tuberculosis: mimicry of gastrointestinal malignancy</article-title><source>Rev Infect Dis</source><year>1987</year><volume>9</volume><issue>1</issue><fpage>140</fpage><lpage>146</lpage><pub-id pub-id-type="doi">10.1093/clinids/9.1.140</pub-id><pub-id pub-id-type="pmid">3823717</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><name><surname>Pimenta</surname><given-names>APA</given-names></name><name><surname>Preto</surname><given-names>JR</given-names></name><name><surname>Gouveia</surname><given-names>AMF</given-names></name><name><surname>Fonseca</surname><given-names>E</given-names></name><name><surname>Pimenta</surname><given-names>MML</given-names></name><article-title>Mediastinal tuberculous lymphadenitis presenting as an esophageal intramural tumor: a very rare but important cause for dysphagia</article-title><source>World J Gastroenterol</source><year>2007</year><volume>13</volume><issue>45</issue><fpage>6104</fpage><lpage>6108</lpage><pub-id pub-id-type="pmid">18023110</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Hadlich</surname><given-names>E</given-names></name><name><surname>Galperim</surname><given-names>B</given-names></name><name><surname>Rizzon</surname><given-names>CF</given-names></name><article-title>Esophageal ulcers caused by reactivation of ganglionary tuberculosis: a case report</article-title><source>Braz J Infect Dis</source><year>2007</year><volume>11</volume><issue>2</issue><fpage>293</fpage><lpage>296</lpage><pub-id pub-id-type="doi">10.1590/S1413-86702007000200026</pub-id><pub-id pub-id-type="pmid">17625781</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Devarbhavi</surname><given-names>HC</given-names></name><name><surname>Alvares</surname><given-names>JF</given-names></name><name><surname>Radhikadevi</surname><given-names>M</given-names></name><article-title>Esophageal tuberculosis associated with esophagotracheal or esophagomediastinal fistula: report of 10 cases</article-title><source>Gastrointest Endosc</source><year>2003</year><volume>57</volume><issue>4</issue><fpage>588</fpage><lpage>592</lpage><pub-id pub-id-type="doi">10.1067/mge.2003.140</pub-id><pub-id pub-id-type="pmid">12665778</pub-id></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="other"><article-title>Management of benign esophageal strictures</article-title><ext-link ext-link-type="uri" xlink:href="http://www.uptodate.com/contents/management-of-benign-esophageal-strictures">http://www.uptodate.com/contents/management-of-benign-esophageal-strictures</ext-link></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="journal"><name><surname>Prakash</surname><given-names>K</given-names></name><name><surname>Kuruvilla</surname><given-names>K</given-names></name><name><surname>Lekha</surname><given-names>V</given-names></name><name><surname>Venugopal</surname><given-names>A</given-names></name><name><surname>Jacob</surname><given-names>G</given-names></name><name><surname>Ramesh</surname><given-names>H</given-names></name><article-title>Primary tuberculous strictures of the oesophagus mimicking carcinoma</article-title><source>Trop Gastroenterol</source><year>2001</year><volume>22</volume><issue>3</issue><fpage>143</fpage><lpage>144</lpage><pub-id pub-id-type="pmid">11681108</pub-id></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="journal"><name><surname>Milnes</surname><given-names>JP</given-names></name><name><surname>Homes</surname><given-names>GKT</given-names></name><article-title>Recurrent oesophageal stricture due to tuberculosis</article-title><source>Br Med J (Clin Res Ed)</source><year>1983</year><volume>286</volume><issue>6382</issue><fpage>1977</fpage></mixed-citation></ref></ref-list></back></article>