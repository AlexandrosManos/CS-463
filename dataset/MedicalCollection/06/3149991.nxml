<volume>28</volume><fpage>215</fpage><lpage>222</lpage><pub-id pub-id-type="pmid">16887864</pub-id></element-citation></ref><ref id="B10"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lim</surname><given-names>SO</given-names></name></person-group><article-title>Epigenetic changes induced by reactive oxygen species in hepatocellular carcinoma: methylation of the E-cadherin promoter</article-title><source>Gastroenterology</source><year>2008</year><volume>135</volume><fpage>2128</fpage><lpage>2140</lpage><pub-id pub-id-type="pmid">18801366</pub-id></element-citation></ref><ref id="B11"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bernstein</surname><given-names>H</given-names></name></person-group><article-title>Bile acids as carcinogens in human gastrointestinal cancers</article-title><source>Mutat Res</source><year>2005</year><volume>589</volume><fpage>47</fpage><lpage>65</lpage><pub-id pub-id-type="pmid">15652226</pub-id></element-citation></ref><ref id="B12"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Payne</surname><given-names>CM</given-names></name></person-group><article-title>hydrophobic bile acids, genomic instability, Darwinian selection, and colon carcinogenesis</article-title><source>Clinical and Experimental Gastroenterology</source><year>2008</year><volume>1</volume><fpage>19</fpage><lpage>47</lpage><pub-id pub-id-type="pmid">21677822</pub-id></element-citation></ref></ref-list></back></article>