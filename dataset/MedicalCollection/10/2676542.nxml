Inst||94|88||bib7|'--><pub-id pub-id-type="pmid">11792746</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Einav</surname><given-names>Y</given-names></name><name><surname>Agami</surname><given-names>R</given-names></name><name><surname>Canaani</surname><given-names>D</given-names></name></person-group><article-title>shRNA-mediated RNA interference as a tool for genetic synthetic lethality screening in mouse embryo fibroblasts</article-title><source>FEBS Lett</source><year>2005</year><volume>579</volume><fpage>199</fpage><lpage>202</lpage><!--PubMed citation query: 'FEBS Lett||579|199||bib8|'--><pub-id pub-id-type="pmid">15620713</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Einav</surname><given-names>Y</given-names></name><name><surname>Shistik</surname><given-names>E</given-names></name><name><surname>Shenfeld</surname><given-names>M</given-names></name><name><surname>Simons</surname><given-names>AH</given-names></name><name><surname>Melton</surname><given-names>DW</given-names></name><name><surname>Canaani</surname><given-names>D</given-names></name></person-group><article-title>Replication and episomal maintenance of Epstein&#x02013;Barr virus-based vectors in mouse embryonal fibroblasts enable synthetic lethality screens</article-title><source>Mol Cancer Ther</source><year>2003</year><volume>2</volume><fpage>1121</fpage><lpage>1128</lpage><!--PubMed citation query: 'Mol Cancer Ther||2|1121||bib9|'--><pub-id pub-id-type="pmid">14617785</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fantin</surname><given-names>VR</given-names></name><name><surname>Berardi</surname><given-names>MJ</given-names></name><name><surname>Scorrano</surname><given-names>L</given-names></name><name><surname>Korsmeyer</surname><given-names>SJ</