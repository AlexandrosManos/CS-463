article-title><source>J Immunother</source><year>2003</year><volume>26</volume><fpage>85</fpage><lpage>93</lpage><!--PubMed citation query: 'J Immunother||26|85||bib9|'--><pub-id pub-id-type="pmid">12514432</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kryczek</surname><given-names>I</given-names></name><name><surname>Wei</surname><given-names>S</given-names></name><name><surname>Zou</surname><given-names>L</given-names></name><name><surname>Altuwaijri</surname><given-names>S</given-names></name><name><surname>Szeliga</surname><given-names>W</given-names></name><name><surname>Kolls</surname><given-names>J</given-names></name><name><surname>Chang</surname><given-names>A</given-names></name><name><surname>Zou</surname><given-names>W</given-names></name></person-group><article-title>Cutting edge: Th17 and regulatory T cell dynamics and the regulation by IL-2 in the tumor microenvironment</article-title><source>J Immunol</source><year>2007</year><volume>178</volume><fpage>6730</fpage><lpage>6733</lpage><!--PubMed citation query: 'J Immunol||178|6730||bib10|'--><pub-id pub-id-type="pmid">17513719</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>La Cava</surname><given-names>A</given-names></name><name><surname>Van Kaer</surname><given-names>L</given-names></name><name><surname>Fu Dong</surname><given-names>S</given-names></name></person-group><article-title>CD4&#x0002b;CD25&#x0002b; Tregs and NKT cells: regulators regulating regulators</article-title><source>Trends Immunol</source><year>2006</year><volume>27</volume><fpage>322</fpage><lpage>327</lpage><!--PubMed citation query: 'Trends Immunol||27|322||bib11|'--><pub-id pub-id-type="pmid">16735139</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Langrish</surname><given-names>