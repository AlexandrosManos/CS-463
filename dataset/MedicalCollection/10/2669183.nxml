ume><fpage>1137</fpage><lpage>1144</lpage><pub-id pub-id-type="pmid">14622093</pub-id></citation></ref><ref id="pone.0005303-Diano1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Diano</surname><given-names>S</given-names></name><name><surname>Farr</surname><given-names>SA</given-names></name><name><surname>Benoit</surname><given-names>SC</given-names></name><name><surname>McNay</surname><given-names>EC</given-names></name><name><surname>da Silva</surname><given-names>I</given-names></name><etal/></person-group><year>2006</year><article-title>Ghrelin controls hippocampal spine synapse density and memory performance.</article-title><source>Nat Neurosci</source><volume>9</volume><fpage>381</fpage><lpage>388</lpage><pub-id pub-id-type="pmid">16491079</pub-id></citation></ref><ref id="pone.0005303-Schneider2"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schneider</surname><given-names>A</given-names></name><name><surname>Kruger</surname><given-names>C</given-names></name><name><surname>Steigleder</surname><given-names>T</given-names></name><name><surname>Weber</surname><given-names>D</given-names></name><name><surname>Pitzer</surname><given-names>C</given-names></name><etal/></person-group><year>2005</year><article-title>The hematopoietic factor G-CSF is a neuronal ligand that counteracts programmed cell death and drives neurogenesis.</article-title><source>J Clin Invest</source><volume>115</volume><fpage>2083</fpage><lpage>2098</lpage><pub-id pub-id-type="pmid">16007267</pub-id></citation></ref><ref id="pone.0005303-Mizuno1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mizuno</surname><given-names>K</given-names></name><name><surname>Giese</surname><given-names>KP</given-names></name></person-group><year>2005</year><article-title>Hippocampus-dependent memory formation: do memory type-specific mechanisms exist?</article-title><source>J Pharmacol Sci</source><volume>98</volume><fpage>191</fpage><lpage>197</lpage><pub-id pub-id-type="pmid">15968141</pub-id></citation></ref><ref id="pone.0005303-Peters1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Peters</surname><given-names>M</given-names></name><name><surname>Mizuno</surname><given-names>K</given-names></name><name><surname>Ris</surname><given-names>L</given-names></name><name><surname>Angelo</surname><given-names>M</given-names></name><name><surname>Godaux</surname><given-names>E</given-names></name><etal/></person-group><year>2003</year><article-title>Loss of Ca2&#x0002b;/calmodulin kinase kinase beta affects the formation of some, but not all, types of hippocampus-dependent long-term memory.</article-title><source>J Neurosci</source><volume>23</volume><fpage>9752</fpage><lpage>9760</lpage><pub-id pub-id-type="pmid">14586002</pub-id></citation></ref><ref id="pone.0005303-Zhu1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zhu</surname><given-names>DY</given-names></name><name><surname>Lau</surname><given-names>L</given-names></name><name><surname>Liu</surname><given-names>SH</given-names></name><name><surname>Wei</surname><given-names>JS</given-names></name><name><surname>Lu</surname><given-names>YM</given-names></name></person-group><year>2004</year><article-title>Activation of cAMP-response-element-binding protein (CREB) after focal cerebral ischemia stimulates neurogenesis in the adult dentate gyrus.</article-title><source>Proc Natl Acad Sci U S A</source><volume>101</volume><fpage>9453</fpage><lpage>9457</lpage><pub-id pub-id-type="pmid">15197280</pub-id></citation></ref><ref id="pone.0005303-Williams1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Williams</surname><given-names>RW</given-names></name><name><surname>Rakic</surname><given-names>P</given-names></name></person-group><year>1988</year><article-title>Three-dimensional counting: an accurate and direct method to estimate numbers of cells in sectioned material.</article-title><source>J Comp Neurol</source><volume>278</volume><fpage>344</fpage><lpage>352</lpage><pub-id pub-id-type="pmid">3216047</pub-id></citation></ref><ref id="pone.0005303-Kempermann1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kempermann</surname><given-names>G</given-names></name></person-group><year>2002</year><article-title>Why new neurons? Possible functions for adult hippocampal neurogenesis.</article-title><source>J Neurosci</source><volume>22</volume><fpage>635</fpage><lpage>638</lpage><pub-id pub-id-type="pmid">11826092</pub-id></citation></ref><ref id="pone.0005303-Maher1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maher</surname><given-names>P</given-names></name><name><surname>Akaishi</surname><given-names>T</given-names></name><name><surname>Abe</surname><given-names>K</given-names></name></person-group><year>2006</year><article-title>Flavonoid fisetin promotes ERK-dependent long-term potentiation and enhances memory.</article-title><source>Proc Natl Acad Sci U S A</source><volume>103</volume><fpage>16568</fpage><lpage>16573</lpage><pub-id pub-id-type="pmid">17050681</pub-id></citation></ref><ref id="pone.0005303-Sweatt1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sweatt</surname><given-names>JD</given-names></name></person-group><year>2004</year><article-title>Hippocampal function in cognition.</article-title><source>Psychopharmacology (Berl)</source><volume>174</volume><fpage>99</fpage><lpage>110</lpage><pub-id pub-id-type="pmid">15205881</pub-id></citation></ref><ref id="pone.0005303-Carlezon1"><label>17</label><citation citation-type="journal">