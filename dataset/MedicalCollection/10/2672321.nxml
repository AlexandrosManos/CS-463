ource>Med. J. Aust</source><year>2006</year><volume>184</volume><fpage>560</fpage><lpage>562</lpage><pub-id pub-id-type="pmid">16768662</pub-id></citation></ref><ref id="b14-ijerph-06-00400"><label>14.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cuthbert</surname><given-names>JA</given-names></name></person-group><article-title>Hepatitis A: old and new</article-title><source>Clin Microb Rev</source><year>2001</year><volume>14</volume><fpage>38</fpage><lpage>58</lpage></citation></ref><ref id="b15-ijerph-06-00400"><label>15.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Graner&#x000f8;d</surname><given-names>J</given-names></name><name><surname>Crowcroft</surname><given-names>N</given-names></name></person-group><article-title>Hepatitis A epidemiology in England and Wales</article-title><source>Eurosurveillance Weekly</source><year>2002</year><volume>6</volume><fpage>50</fpage></citation></ref><ref id="b16-ijerph-06-00400"><label>16.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crowcroft</surname><given-names>NS</given-names></name></person-group><article-title>Hepatitis A virus infections in injecting drug users</article-title><source>Commun. Dis. Public Health</source><year>2003</year><volume>6</volume><fpage>82</fpage><lpage>84</lpage><pub-id pub-id-type="pmid">12889283</pub-id></citation></ref><ref id="b17-ijerph-06-00400"><label>17.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hutin</surname><given-names>YJ</given-names></name><name><surname>Sabin</surname><given-names>KM</given-names></name><name><surname>Hutwagner</surname><given-names>LC</given-names></name></person-group><article-title>Multiple modes of hepatitis A virus transmission among methamphetamine users</article-title><source>Am. J. Epidemiol</source><year>2000</year><volume>152</volume><fpage>186</fpage><lpage>192</lpage><pub-id pub-id-type="pmid">10909956</pub-id></citation></ref><ref id="b18-ijerph-06-00400"><label>18.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Perrett</surname><given-names>K</given-names></name><name><surname>Graner&#x000f8;d</surname><given-names>J</given-names></name><name><surname>Crowcroft</surname><given-names>N</given-names></name><name><surname>Carlisle</surname><given-names>R</given-names></name></person-group><article-title>Changing epidemiology of hepatitis A: should we be doing more to vaccinate injecting drug users?</article-title><source>Commun. Dis. Public Health</source><year>2003</year><volume>6</volume><fpage>97</fpage><lpage>100</lpage><pub-id pub-id-type="pmid">12889286</pub-id></citation></ref><ref id="b19-ijerph-06-00400"><label>19.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van Steenbergen</surname><given-names>JE</given-names></name><name><surname>Tjon</surname><given-names>G</given-names></name><name><surname>van Den Hoek</surname><given-names>A</given-names></name><name><surname>Koek</surname><given-names>A</given-names></name><name><surname>Coutinho</surname><given-names>RA</given-names></name><name><surname>Bruisten</surname><given-names>SM</given-names></name></person-group><article-title>Two years&#x02019; prospective collection of molecular and epidemiological data shows limited spread of hepatitis A virus outside risk groups in Amsterdam, 2000&#x02013;2002</article-title><source>J. Infect. Dis</source><year>2004</year><volume>189</volume><fpage>471</fpage><lpage>482</lpage><pub-id pub-id-type="pmid">14745705</pub-id></citation></ref><ref id="b20-ijerph-06-00400"><label>20.</label><citation citation-type="journal"><person-group person-group-type="author"><collab>WHO</collab></person-group><article-title>Hepatitis A vaccines WHO. position paper</article-title><source>Weekly Epidemiol. Rec. 2000</source