>2005</year><article-title>Microglia response and P2 receptor participation in oxygen/glucose deprivation-induced cortical damage.</article-title><source>Neuroscience</source><volume>136</volume><fpage>615</fpage><lpage>623</lpage><pub-id pub-id-type="pmid">16344139</pub-id></citation></ref><ref id="pone.0005278-Plenz1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Plenz</surname><given-names>D</given-names></name><name><surname>Kitai</surname><given-names>ST</given-names></name></person-group><year>1996</year><article-title>Organotypic cortex-striatum-mesencephalon cultures: the nigrostriatal pathway.</article-title><source>Neurosci Lett</source><volume>209</volume><fpage>177</fpage><lpage>180</lpage><pub-id pub-id-type="pmid">8736639</pub-id></citation></ref><ref id="pone.0005278-Corradin1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Corradin</surname><given-names>SB</given-names></name><name><surname>Mau&#x000eb;l</surname><given-names>J</given-names></name><name><surname>Donini</surname><given-names>SD</given-names></name><name><surname>Quattrocchi</surname><given-names>E</given-names></name><name><surname>Ricciardi-Castagnoli</surname><given-names>P</given-names></name></person-group><year>1993</year><article-title>Inducible nitric oxide synthase activity of cloned murine microglial cells.</article-title><source>Glia</source><volume>7</volume><fpage>255</fpage><lpage>262</lpage><pub-id pub-id-type="pmid">7681038</pub-id></citation></ref><ref id="pone.0005278-PozzoMiller1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pozzo Miller</surname><given-names>LD</given-names></name><name><surname>Mahanty</surname><given-names>NK</given-names></name><name><surname>Connor</surname><given-names>JA</given-names></name><name><surname>Landis</surname><given-names>DM</given-names></name></perso