person-group person-group-type="author"><name><surname>Navab</surname><given-names>F</given-names></name><name><surname>Avunduk</surname><given-names>C</given-names></name><name><surname>Gang</surname><given-names>D</given-names></name><name><surname>Frankel</surname><given-names>K</given-names></name></person-group><article-title>Bulimia nervosa complicated by Barrett's esophagus and esophageal cancer</article-title><source>Gastrointest Endosc</source><year>1996</year><volume>44</volume><fpage>492</fpage><lpage>494</lpage><pub-id pub-id-type="pmid">8905379</pub-id><pub-id pub-id-type="doi">10.1016/S0016-5107(96)70110-4</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Walker</surname><given-names>ES</given-names></name></person-group><article-title>Bulimia and gastric cancer</article-title><source>Ann Intern Med</source><year>1985</year><volume>103</volume><fpage>305</fpage><pub-id pub-id-type="pmid">3860031</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buyse</surname><given-names>S</given-names></name><name><surname>Nahon</surname><given-names>S</given-names></name><name><surname>Tuszynski</surname><given-names>T</given-names></name><name><surname>Delas</surname><given-names>N</given-names></name></person-group><article-title>Bulimia nervosa as a risk factor for squamous cell carcinoma of the esophagus?</article-title><source>Am J Gastroenterol</source><year>2003</year><volume>98</volume><fpage>1442</fpage><lpage>1443</lpage><pub-id pub-id-type="pmid">12818296</pub-id><pub-id pub-id-type="doi">10.1111/j.1572-0241.2003.07511.x</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martin</surname><given-names>IG</given-names></name><name><surname>Young</surname><given-names>S</given-names></name><name><surname>Sue-Ling</surname><given-names>H</given-names></name><name><surname>Johnston</surname><given-names>D</given-names></name></person-group><article-title>Delays in the diagnosis of oesophagogastric cancer: a consecutive case series</article-title><source>Bmj</source><year>1997</year><volume>314</volume><fpage>467</fpage><lpage>470</lpage><pub-id pub-id-type="pmid">9056794</pub-id></citation></ref></ref-list></back></article>