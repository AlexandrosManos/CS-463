><td align="center">Minim</td><td align="center">11.9</td><td align="center">3.2</td><td align="center">10.1</td></tr><tr><td align="left">D<sub>1% </sub>[Gy]</td><td align="center">Minim</td><td align="center">53.1</td><td align="center">51.9</td><td align="center">50.0</td></tr><tr><td colspan="5"><hr></hr></td></tr><tr><td align="center" colspan="5"><bold><italic>Healthy tissue</italic></bold></td></tr><tr><td align="left">Mean [Gy]</td><td align="center">Minim</td><td align="center">9.1</td><td align="center">2.5</td><td align="center">8.7</td></tr><tr><td align="left">V<sub>10 Gy </sub>[cm<sup>3</sup>]</td><td align="center">Minim</td><td align="center">32.2</td><td align="center">7.2</td><td align="center">31.0</td></tr><tr><td align="left">EI [%]</td><td align="center">Minim</td><td align="center">3.0</td><td align="center">3.5</td><td align="center">2.9</td></tr><tr><td align="left">DosInt [10<sup>5 </sup>*Gy*cm<sup>3</sup>]</td><td align="center">Minim</td><td align="center">0.84</td><td align="center">0.23</td><td align="center">0.81</td></tr></tbody></table></table-wrap><table-wrap position="float" id="T3"><label>Table 3</label><caption><p>Results from dose plan analysis for Patient 2</p></caption><table frame="hsides" rules="groups"><thead><tr><td></td><td align="center"><bold>Obj.</bold></td><td align="center"><bold>HT</bold></td><td align="center"><bold>IMP</bold></td><td align="center"><bold>RA</bold></td></tr></thead><tbody><tr><td align="center" colspan="5"><bold><italic>PTVII</italic></bold></td></tr><tr><td align="left">Mean [Gy]</td><td align="center">49.5</td><td align="center">49.5<break/>(100%)</td><td align="center">49.5<break/>(100%)</td><td align="center">49.5<break/>(100%)</td></tr><tr><td align="left">D<sub>1% </sub>[%]</td><td align="center">-</td><td align="center">103.2</td><td align="center">103.8</td><td align="center">103.4</td></tr><tr><td align="left">D<sub>99% </sub>[%]</td><td align="center">-</td><td align="center">93.3</td><td align="center">94.7</td><td align="center">92.7</td></tr><tr><td align="left">V<sub>90% </sub>[%]</td><td align="center">100%</td><td align="center">99.9</td><td align="center">100.0</td><td align="center">99.8</td></tr><tr><td align="left">V<sub>95% </sub>[%]</td><td align="center">100%</td><td align="center">97.5</td><td align="center">98.7</td><td align="center">96.2</td></tr><tr><td align="left">V<sub>107% </sub>[%]</td><td align="center">0%</td><td align="center">0.0</td><td align="center">0.0</td><td align="center">0.0</td></tr><tr><td align="left">V<sub>110% </sub>[%]</td><td align="center">0%</td><td align="center">0.0</td><td align="center">0.0</td><td align="center">0.0</td></tr><tr><td align="left">D<sub>5</sub>&#x02013;D<sub>95 </sub>[%]</td><td align="center">-</td><td align="center">6.5</td><td align="center">5.9</td><td align="center">7.3</td></tr><tr><td align="left">SD [%]</td><td align="center">-</td><td align="center">1.8</td><td align="center">1.8</td><td align="center">2.2</td></tr><tr><td align="left">CI<sub>90</sub></td><td align="center">1.0</td><td align="center">1.1</td><td align="center">1.1</td><td align="center">1.0</td></tr><tr><td colspan="5"><hr></hr></td></tr><tr><td align="center" colspan="5"><bold><italic>PTVI-PTVII</italic></bold></td></tr><tr><td align="left">Mean [%]</td><td align="center">45.0</td><td align="center">47.0<break/>(104.4%)</td><td align="center">47.6<break/>(105.8%)</td><td align="center">46.7<break/>(103.8%)</td></tr><tr><td align="left">D<sub>1% </sub>[%]</td><td align="center">-</td><td align="center">112.9</td><td align="center">113.1</td><td align="center">111.3</td></tr><tr><td align="left">D<sub>99% </sub>[%]</td><td align="center">-</td><td align="center">92.9</td><td align="center">95.3</td><td align="center">91.1</td></tr><tr><td align="left">V<sub>90% </sub>[%]</td><td align="center">100%</td><td align="center">99.7</td><td align="center">99.9</td><td align="center">99.3</td></tr><tr><td align="left">V