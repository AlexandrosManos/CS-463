 forward.</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1"/><th align="left" rowspan="1" colspan="1"><bold>Training sample size (%)</bold></th><th align="left" rowspan="1" colspan="1"><bold>TP</bold></th><th align="left" rowspan="1" colspan="1"><bold>TN</bold></th><th align="left" rowspan="1" colspan="1"><bold>FP</bold></th><th align="left" rowspan="1" colspan="1"><bold>FN</bold></th><th align="left" rowspan="1" colspan="1"><bold>Sensitivity</bold></th><th align="left" rowspan="1" colspan="1"><bold>Specificity</bold></th><th align="left" rowspan="1" colspan="1"><bold>Accuracy</bold></th></tr></thead><tbody><tr><td align="left" rowspan="3" valign="top" colspan="1"><bold>Binary logistic regression</bold></td><td align="left" rowspan="1" colspan="1">0.4</td><td align="left" rowspan="1" colspan="1">82371</td><td align="left" rowspan="1" colspan="1">11148</td><td align="left" rowspan="1" colspan="1">2852</td><td align="left" rowspan="1" colspan="1">5629</td><td align="left" rowspan="1" colspan="1">0.9360</td><td align="left" rowspan="1" colspan="1">0.7963</td><td align="left" rowspan="1" colspan="1">0.9169</td></tr><tr><td align="left" rowspan="1" colspan="1">0.6</td><td align="left" rowspan="1" colspan="1">53525</td><td align="left" rowspan="1" colspan="1">7547</td><td align="left" rowspan="1" colspan="1">1453</td><td align="left" rowspan="1" colspan="1">4475</td><td align="left" rowspan="1" colspan="1">0.9228</td><td align="left" rowspan="1" colspan="1">0.8386</td><td align="left" rowspan="1" colspan="1">0.9115</td></tr><tr><td align="left" rowspan="1" colspan="1">0.8</td><td align="left" rowspan="1" colspan="1">26657</td><td align="left" rowspan="1" colspan="1">4289</td><td align="left" rowspan="1" colspan="1">711</td><td align="left" rowspan="1" colspan="1">2343</td><td align="left" rowspan="1" colspan="1">0.9192</td><td align="left" rowspan="1" colspan="1">0.8578</td><td align="left" rowspan="1" colspan="1">0.9102