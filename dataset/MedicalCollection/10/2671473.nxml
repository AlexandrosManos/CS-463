group><year>2002</year><article-title>Molecular cloning of a vaccine antigen against infection with the larval stage of <italic>Echinococcus multilocularis</italic>.</article-title><source>Infect Immun</source><volume>70</volume><fpage>3969</fpage><lpage>3972</lpage><pub-id pub-id-type="pmid">12065546</pub-id></citation></ref><ref id="pone.0005362-Kyngdon1"><label>5</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kyngdon</surname><given-names>CT</given-names></name><name><surname>Gauci</surname><given-names>CG</given-names></name><name><surname>Gonzalez</surname><given-names>AE</given-names></name><name><surname>Flisser</surname><given-names>A</given-names></name><name><surname>Zoli</surname><given-names>A</given-names></name><etal/></person-group><year>2006</year><article-title>Antibody responses and epitope specificities to the <italic>Taenia solium</italic> cysticercosis vaccines TSOL18 and TSOL45-1A.</article-title><source>Parasite Immunol</source><volume>28</volume><fpage>191</fpage><lpage>199</lpage><pub-id pub-id-type="pmid">16629704</pub-id></citation></ref><ref id="pone.0005362-Chow2"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chow</surname><given-names>C</given-names></name><name><surname>Gauci</surname><given-names>CG</given-names></name><name><surname>Cowman</surname><given-names>AF</given-names></name><name><surname>Lightowlers</surname><given-names>MW</given-names></name></person-group><year>2004</year><article-title><italic>Echinococcus granulosus</italic>: oncosphere-specific transcription of genes encoding a host-protective antigen.</article-title><source>Exp Parasitol</source><volume>106</volume><fpage>183</fpage><lpage>186</lpage><pub-id pub-id-type="pmid">15172227</pub-id></citation></ref><ref id="pone.0005362-Zhang1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zhang</surname><given-names>W</given-names></name><name><surname>Li</surname><given-names>J</given-names></name><name><surname>You</surname><given-names>H</given-names></name><name><surname>Zhang</surname><given-names>Z</given-names></name><name><surname>Turson</surname><given-names>G</given-names></name><etal/></person-group><year>2003</year><article-title><italic>Echinococcus granulosus</italic> from Xinjiang, PR China: cDNAs encoding the EG95 vaccine antigen are expressed in different life cycle stages and are conserved in the oncosphere.</article-title><source>Am J Trop Med Hyg</source><volume>68</volume><fpage>40</fpage><lpage>43</lpage><pub-id pub-id-type="pmid">12556145</pub-id></citation></ref><ref id="pone.0005362-Bonay1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bonay</surname><given-names>P</given-names></name><name><surname>Gonz&#x000e1;lez</surname><given-names>LM</given-names></name><name><surname>Ben&#x000ed;tez</surname><given-names>L</given-names></name><name><surname>Foster</surname><given-names>M</given-names></name><name><surname>Harrison</surname><given-names>LJS</given-names></name><etal/></person-group><year>2002</year><article-title>Genomic and functional characterisation of a secreted antigen of <italic>Taenia saginata</italic> oncospheres.</article-title><source>Mol Biochem Parasitol</source><volume>121</volume><fpage>269</fpage><lpage>273</lpage><pub-id pub-id-type="pmid">12034461</pub-id></citation></ref><ref id="pone.0005362-Waterkeyn1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Waterkeyn</surname><given-names>J</given-names></name><name><surname>Gauci</surname><given-names>C</given-names></name><name><surname>Cowman</surname><given-names>A</given-names></name><name><surname>Lightowlers</surname><given-names>MW</given-names></name></person-group><year>1997</year><article-title>Sequence analysis of a gene family encoding <italic>Taenia ovis</italic> vaccine antigens expressed during embryogenesis of eggs.</article-title><source>Mol Biochem Parasitol</source><volume>86</volume><fpage>75</fpage><lpage>84</lpage><pub-id pub-id-type="pmid">9178269</pub-id></citation></ref><ref id="pone.0005362-Lightowlers1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lightowlers</surname><given-names>MW</given-names></name><name><surname>Gauci</surname><given-names>CG</given-names></name><name><surname>Chow</surname><given-names>C</given-names></name><name><surname>Drew</surname><given-names>DR</given-names></name><name><surname>Gauci</surname><given-names>SM</given-names></name><etal/></person-group><year>2003</year><article-title>Molecular and genetic characterisation of the host-protective oncosphere antigens of taeniid cestode parasites.</article-title><source>Int J Parasitol</source><volume>33</volume><fpage>1207</fpage><lpage>1217</lpage><pub-id pub-id-type="pmid">13678636</pub-id></citation></ref><ref id="pone.0005362-Lightowlers2"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lightowlers</surname><given-names>MW</given-names></name></person-group><year>2006</year><article-title>Vaccines against cysticercosis and hydatidosis: foundations in taeniid cestode immunology.</article-title><source>Parasitol Int</source><volume>55</volume><fpage>S39</fpage><lpage>S43</lpage><pub-id pub-id-type="pmid">16337177</pub-id></citation></ref><ref id="pone.0005362-Woollard1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Woollard</surname><given-names>DJ</given-names></name><name><surname>Gauci</surname><given-names>CG</given-names></name><name><surname>Lightowlers</surname><given-names>MW</given-names></name></person-group><year>2000</year><article-title>Synthetic peptides induce antibody against a host-protective antigen of <italic>Echi