polyps?</article-title><source>Hum Pathol</source><year>2002</year><volume>33</volume><fpage>307</fpage><lpage>315</lpage><pub-id pub-id-type="pmid">11979371</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>MK</given-names></name><name><surname>Higgins</surname><given-names>J</given-names></name></person-group><article-title>Expression of CD34, bcl-2 and kit in inflammatory fibroid polyps of the gastrointestinal tract</article-title><source>Appl Immunohistochem Mol Morphol</source><year>2000</year><volume>8</volume><fpage>147</fpage><lpage>153</lpage><pub-id pub-id-type="pmid">10937062</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Widgren</surname><given-names>S</given-names></name><name><surname>Pizzolato</surname><given-names>GP</given-names></name></person-group><article-title>Inflammatory fibroid polyp of the gastrointestinal tract: possible origin in myofibroblasts? A study of twelve cases</article-title><source>Ann Pathol</source><year>1987</year><volume>7</volume><fpage>184</fpage><lpage>192</lpage><pub-id pub-id-type="pmid">3435611</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Goldman</surname><given-names>Rl</given-names></name><name><surname>Freidman</surname><given-names>NB</given-names></name></person-group><article-title>Neurogenic nature of so-called inflammatory fibroid polyps of the stomach</article-title><source>Cancer</source><year>1967</year><volume>20</volume><fpage>134</fpage><lpage>143</lpage><pub-id pub-id-type="pmid">6016869</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="autho