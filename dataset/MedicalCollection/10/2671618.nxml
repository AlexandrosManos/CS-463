ion-type="book"><person-group person-group-type="author"><name><surname>Fecht-Christoffers</surname><given-names>MM</given-names></name><name><surname>Maier</surname><given-names>P</given-names></name><name><surname>Iwasaki</surname><given-names>K</given-names></name><name><surname>Braun</surname><given-names>H-P</given-names></name><name><surname>Horst</surname><given-names>WJ</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Sattelmacher</surname><given-names>B</given-names></name><name><surname>Horst</surname><given-names>WJ</given-names></name></person-group><article-title>The role of the leaf apoplast in manganese toxicity and tolerance in cowpea (<italic>Vigna unguiculata</italic> L. Walp)</article-title><source>The apoplast of higher plants: compartment of storage, transport, and reactions</source><year>2007</year><publisher-loc>Dordrecht, The Netherlands</publisher-loc><publisher-name>Springer</publisher-name><fpage>307</fpage><lpage>322</lpage></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fiehn</surname><given-names>O</given-names></name><name><surname>Kopka</surname><given-names>J</given-names></name><name><surname>Trethewey</surname><given-names>RN</given-names></name><name><surname>Willmitzer</surname><given-names>L</given-names></name></person-group><article-title>Identification of uncommon plant metabolites based on calculation of elemental compositions using gas chromatography and quadrupole mass spectrometry</article-title><source>Analytical Chemistry</source><year>2000</year><volume>72</volume><fpage>3573</fpage><lpage>3580</lpage><pub-id pub-id-type="pmid">10952545</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>F&#x000fc;hrs</surname><given-names>H</given-names></name><name><surname>Hartwig</surname><given-names>M</given-names></name><name><surname>Molina</surname><given-names>LEB</given-names></name><name><surname>Heintz</surname><given-names>D</given-names></name><name><surname>Van Dorsselaer</surname><given-names>A</given-names></name><name><surname>Braun</surname><given-names>H-P</given-names></name><name><surname>Horst</surname><given-names>WJ</given-names></name></person-group><article-title>Early manganese-toxicity response in <italic>Vigna unguiculata</italic> L.: a proteomic and transcriptomic study</article-title><source>Proteomics</source><year>2008</year><volume>8</volume><fpage>149</fpage><lpage>159</lpage><pub-id pub-id-type="pmid">18095375</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gonz&#x000e1;lez</surname><given-names>A</given-names></name><name><surname>Lynch</surname><given-names>JP</given-names></name></person-group><article-title>Effects of manganese toxicity on leaf CO<sub>2</sub> assimilation of contrating common bean genotypes</article-title><source>Physiologia Plantarum</source><year>1997</year><volume>101</volume><fpage>872</fpage><lpage>880</lpage></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gonz&#x000e1;lez</surname><given-names>A</given-names></name><name><surname>Lynch</surname><given-names>JP</given-names></name></person-group><article-title>Subcellular and tissue Mn compartmentation in bean leaves under Mn toxicity stress</article-title><source>Australian Journal of Plant Physiology</source><year>1999</year><volume>26</volume><fpage>811</fpage><lpage>822</lpage></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gonz&#x000e1;lez</surname><given-names>A</given-names></name><name><surname>Steffen</surname><given-names>KL</given-names></name><name><surname>Lynch</surname><given-names>JP</given-names></name></person-group><article-title>Light and exce