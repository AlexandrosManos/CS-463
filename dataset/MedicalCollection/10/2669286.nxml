-type="pmid">17361175</pub-id></citation></ref><ref id="pone.0005305-Catterall1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Catterall</surname><given-names>WA</given-names></name></person-group><year>2000</year><article-title>Structure and regulation of voltage-gated Ca<sup>2&#x0002b;</sup> channels.</article-title><source>Ann Rev Dev Biol</source><volume>16</volume><fpage>521</fpage><lpage>555</lpage></citation></ref><ref id="pone.0005305-Snutch1"><label>13</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Snutch</surname><given-names>TP</given-names></name><name><surname>Peloquin</surname><given-names>J</given-names></name><name><surname>Mathews</surname><given-names>E</given-names></name><name><surname>McRory</surname><given-names>JE</given-names></name></person-group><year>2004</year><article-title>Molecular properties of voltage-gated calcium channels.</article-title><person-group person-group-type="editor"><name><surname>Zamponi</surname><given-names>G</given-names></name></person-group><source>Voltage-gated calcium channels</source><publisher-name>Kluwer Academic Plenum Publishers</publisher-name><fpage>1</fpage><lpage>34</lpage></citation></ref><ref id="pone.0005305-Hidalgo1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hidalgo</surname><given-names>P</given-names></name><name><surname>Gonzalez-Gutirerez</surname><given-names>G</given-names></name><name><surname>Garcia-Olivares</surname><given-names>J</given-names></name><name><surname>Neely</surname><given-names>A</given-names></name></person-group><year>2006</year><article-title>The &#x003b1;<sub>1</sub>-&#x003b2;-subunit interaction that modulates calcium channel activity is reversible and requires a competent &#x003b1;-interaction domain.</article-title><source>J Biol Chem</source><volume>281</volume><fpage>24104</fpage><lpage>24110</lpage><pub-id pub-id-type="pmid">16793763</pub-id></citation></ref><ref id="pone.0005305-Noble1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Noble</surname><given-names>A</given-names></name><name><surname>Truman</surname><given-names>JP</given-names></name><name><surname>Vyas</surname><given-names>B</given-names></name><name><surname>Vukmanovic-Steejic</surname><given-names>M</given-names></name><name><surname>Hirst</surname><given-names>WJ</given-names></name><etal/></person-group><year>2000</year><article-title>The balance of protein kinase C and calcium signaling directs T cell subset development.</article-title><source>J Immunol</source><volume>164</volume><fpage>1807</fpage><lpage>1813</lpage><pub-id pub-id-type="pmid">10657628</pub-id></citation></ref><ref id="pone.0005305-Malik1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Malik</surname><given-names>ZA</given-names></name><name><surname>Thompson</surname><given-names>CR</given-names></name><name><surname>Hasmi</surname><given-names>S</given-names></name><name><surname>Porter</surname><given-names>B</given-names></name><name><surname>Iyer</surname><given-names>SS</given-names></name><etal/></person-group><year>2003</year><article-title>Mycobacterium tuberculosis blocks Ca<sup>2&#x0002b;</sup> signaling and phagosome maturation inhuman macrophages via specific inhibition of sphingosine kinase.</article-title><source>J Immunol</source><volume>170</volume><fpage>2811</fpage><lpage>2815</lpage><pub-id pub-id-type="pmid">12626530</pub-id></citation></ref><ref id="pone.0005305-Vergne1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vergne</surname><given-names>I</given-names></name><name><surname>Chua</surname><given-names>J</given-names></name><name><surname>Deretic</surname><given-names>V</given-names></name></person-group><year>2003</year><article-title>Tuberculosis toxin blocking phagosome maturation inhibits a novel Ca<sup>2&#x0002b;</sup>/calmodulin-PI3K hVPS34 cascade.</article-title><source>J Exp Med</source><volume>198</volume><fpage>653</fpage><lpage>659</lpage><pub-id pub-id-type="pmid">12925680</pub-id></citation></ref><ref id="pone.0005305-Mu1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mu</surname><given-names>T-W</given-names></name><name><surname>Fowler</surname><given-names>DM</given-names></name><name><surname>Kelly</surname><given-names>JW</given-names></name></person-group><year>2008</year><article-title>Partial restoration of mutant enzyme homeostasis in three distinct lysosomal storage disease cell lines by altering calcium homeostasis.</article-title><source>PLoS Biol</source><volume>6</volume><fpage>e26</fpage><pub-id pub-id-type="pmid">18254660</pub-id></citation></ref><ref id="pone.0005305-Weiland1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weiland</surname><given-names>H</given-names></name><name><surname>Hechtel</surname><given-names>N</given-names></name><name><surname>Faigle</surname><given-names>M</given-names></name><name><surname>Neumeister</surname><given-names>B</given-names></name></person-group><year>2006</year><article-title>Efficient intracellular multiplication of Legionella pneumophila in human monocytes requires functional host cell L-type calcium channels.</article-title><source>FEMS Immunol Med Microbiol</source><volume>47</volume><fpage>296</fpage><lpage>301</lpage><pub-id pub-id-type="pmid">16831218</pub-id></citation></ref><ref id="pone.0005305-Latchumanan1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Latchumanan</surname><given-names>VK</given-names></name><name><surname>Balkhi</surname><given-names>MY</given-names></name><name><surname>Sinha</surname><given-n