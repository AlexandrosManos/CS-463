></element-citation></ref><ref id="CIT0007"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Baumeister</surname><given-names>S</given-names></name><name><surname>Dragu</surname><given-names>A</given-names></name><name><surname>Jester</surname><given-names>A</given-names></name><name><surname>Germann</surname><given-names>G</given-names></name><name><surname>Menke</surname><given-names>H</given-names></name></person-group><article-title>The role of plastic and reconstructive surgery within an interdisciplinary treatment concept for diabetic ulcers of the foot [Article in German]</article-title><source>Dtsch Med Wochensch</source><year>2004</year><volume>129</volume><fpage>676</fpage><lpage>80</lpage></element-citation></ref><ref id="CIT0008"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Roukis</surname><given-names>TS</given-names></name><name><surname>Zgonis</surname><given-names>T</given-names></name></person-group><article-title>Skin grafting techniques for soft-tissue coverage of diabetic foot and ankle wounds</article-title><source>J Wound Care</source><year>2005</year><volume>14</volume><fpage>173</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">15835230</pub-id></element-citation></ref><ref id="CIT0009"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Zgonis</surname><given-names>T</given-names></name><name><surname>Stapleton</surname><given-names>JJ</given-names></name><name><surname>Roukis</surname><given-names>TS</given-names></name></person-group><article-title>Advanced plastic surgery techniques for soft tissue coverage of the diabetic foot</article-title><source>Clin Podiatr Med Surg</source><year>2007</year><volume>24</volume><fpage>547</fpage><lpage>68</lpage><pub-id pub-id-type="pmid">17613391</pub-id></element-citation></ref><ref id="CIT0010"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ramanujam</surname><given-names>CL</given-names></name><name><surname>Stapleton</surname><given-names>JJ</given-names></name><name><surname>Kilpadi</surname><given-names>KL</given-names></name><name><surname>Rodriguez</surname><given-names>RH</given-names></name><name><surname>Jeffries</surname><given-names>LC</given-names></name><name><surname>Zgonis</surname><given-names>T</given-names></name></person-group><article-title>Split-thickness skin grafts for closure of diabetic foot and ankle wounds: a retrospective review of 83 patients</article-title><source>Foot Ankle Spec</source><year>2010</year><volume>3</volume><fpage>231</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">20631059</pub-id></element-citation></ref><ref id="CIT0011"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mahmoud</surname><given-names>SM</given-names></name><name><surname>Mohamed</surname><given-names>AA</given-names></name><name><surname>Mahdi</surname><given-names>SE</given-names></name><name><surname>Ahmed</surname><given-names>ME</given-names></name></person-group><article-title>Split-skin graft in the management of diabetic foot ulcers</article-title><source>J Wound Care</source><year>2008</year><volume>17</volume><fpage>303</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">18705232</pub-id></element-citation></ref><ref id="CIT0012"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Puttirutvong</surname><given-names>P</given-names></name></person-group><article-title>Meshed skin graft versus split thickness skin graft in diabetic ulcer coverage</article-title><source>J Med Assoc Thai</source><year>2004</year><volume>87</volume><fpage>66</fpage><lpage>72</lpage><pub-id pub-id-type="pmid">14971537</pub-id></element-citation></ref><ref id="CIT0013"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Marston</surname><given-names>WA</given-names></name></person-group><article-title>Risk factors associated with healing chronic diabetic foot ulcers: the importance of hyperglycemia</article-title><source>Ostomy Wound Manage</source><year>2006</year><volume>52</volume><fpage>26</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">16567857</pub-id></element-citation></ref><ref id="CIT0014"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rosenberg</surname><given-names>CS</given-names></name></person-group><article-title>Wound healing in the patient with diabetes mellitus</article-title><source>Nurs Clin North Am</source><year>1990</year><volume>25</volume><fpage>247</fpage><lpage>61</lpage><pub-id pub-id-type="pmid">2179891</pub-id></element-citation></ref><ref id="CIT0015"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Fahey</surname><given-names>TJ</given-names><suffix>III</suffix></name><name><surname>Sadaty</surname><given-names>A</given-names></name><name><surname>Jones</surname><given-names>WG</given-names><suffix>II</suffix></name><name><surname>Barber</surname><given-names>A</given-names></name><name><surname>Smoller</surname><given-names>B</given-names></name><name><surname>Shires</surname><given-names>GT</given-names></name></person-group><article-title>Diabetes impairs the late inflammatory response to wound healing</article-title><source>J Surg Res</source><year>1991</year><volume>50</volume><fpage>308</fpage><lpage>13</lpage><pub-id pub-id-type="pmid">2020184</pub-id></element-citation></ref><ref id="CIT0016"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Krishnan</surname><given-names>ST</given-names></name><name><surname>Quattrini</surname><given-names>C</given-names></name><name><surname>Jeziorska</surname><given-names>M</given-names></name><name><surname>Malik</surname><given-names>RA</given-names></name><name><surname>Rayman</surname><given-names>G</given-names></name></person-group><article-title>Neurovascular factors in wound healing in the foot skin of type 2 diabetic subjects</article-title><source>Diabetes Care</source><year>2007</year><volume>30</volume><fpage>3058</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">17898089</pub-id></element-citation></ref></ref-list></back></article>