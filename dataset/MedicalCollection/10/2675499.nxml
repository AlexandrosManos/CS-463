citation-type="journal"><person-group person-group-type="author"><name><surname>Dean</surname><given-names>N</given-names></name><name><surname>Raftery</surname><given-names>AE</given-names></name></person-group><year>2005</year><article-title>Normal uniform mixture differential gene expression detection for cDNA microarrays. BMC</article-title><source>Bioinformatics</source><volume>6</volume><fpage>173</fpage><pub-id pub-id-type="pmid">16011807</pub-id></citation></ref><ref id="b18-cin-02-25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dennis</surname><given-names>G</given-names><suffix>Jr.</suffix></name><etal/></person-group><year>2003</year><article-title>DAVID: Database for Annotation, Visualization, and Integrated Discovery</article-title><source>Genome Biol</source><volume>4</volume><fpage>P3</fpage><pub-id pub-id-type="pmid">12734009</pub-id></citation></ref><ref id="b19-cin-02-25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Doniger</surname><given-names>SW</given-names></name><etal/></person-group><year>2003</year><article-title>MAPPFinder: using Gene Ontology and GenMAPP to create a global gene-expression profile from microarray data</article-title><source>Genome Biol</source><volume>4</volume><fpage>R7</fpage><pub-id pub-id-type="pmid">12540299</pub-id></citation></ref><ref id="b20-cin-02-25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Draghici</surname><given-names>S</given-names></name><etal/></person-group><year>2003</year><article-title>Onto-Tools, the toolkit of the modern biologist: Onto-Express, Onto-Compare, Onto-Design and Onto-Translate</article-title><source>Nucleic Acids Res</source><volume>31</volume><fpage>3775</fpage><lpage>3781</lpage><pub-id pub-id-type="pmid">12824416</pub-id></citation></ref><ref id="b21-cin-02-25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dressman</surname><given-names>MA</given-names></name><etal/></person-group><year>2003</year><article-title>Gene expression profiling detects gene amplification and differentiates tumor types in breast cancer</article-title><source>Cancer Res</source><volume>63</volume><fpage>2194</fpage><lpage>2199</lpage><pub-id pub-id-type="pmid">12727839</pub-id></citation></ref><ref id="b22-cin-02-25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dudoit</surname><given-names>S</given-names></name><name><surname>Shaffer</surname><given-names>J</given-names></name><name><surname>Boldrick</surname><given-names>J</given-names></name></person-group><year>2003</year><article-title>Multiple hypothesis testing in microarray experiments</article-title><source>Stat.Sci</source><volume>18</volume><fpage>71</fpage><lpage>103</lpage></citation></ref><ref id="b23-cin-02-25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eddy</surname><given-names>SR</given-names></name></person-group><year>1996</year><article-title>Hidden Markov models</article-title><source>Curr Opin Struct Biol</source><volume>6</volume><fpage>361</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">8804822</pub-id></citation></ref><ref id="b24-cin-02-25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eppig</surname><given-names>JT</given-names></name><etal/></person-group><year>2005</year><article-title>The Mouse Genome Database (MGD): from genes to mice&#x02014;a community resource for mouse biology</article-title><source>Nucleic Acids Res</source><volume>33</volume><fpage>D471</fpage><lpage>D475</lpage><pub-id pub-id-type="pmid">15608240</pub-id></citation></ref><ref id="b25-cin-02-25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eschrich</surname><given-names>S</given-names></name><etal/></person-group><year>2005</year><article-title>Molecular sta