en-names>AK</given-names></name><name><surname>Wah</surname><given-names>DA</given-names></name></person-group><article-title>Novel site-specific DNA endonucleases</article-title><source>Curr. Opin. Struct. Biol.</source><year>1998</year><volume>8</volume><fpage>19</fpage><lpage>25</lpage><pub-id pub-id-type="pmid">9519292</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Perona</surname><given-names>JJ</given-names></name></person-group><article-title>Type II restriction endonucleases</article-title><source>Methods</source><year>2002</year><volume>28</volume><fpage>353</fpage><lpage>364</lpage><pub-id pub-id-type="pmid">12431439</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Siksnys</surname><given-names>V</given-names></name><name><surname>Grazulis</surname><given-names>S</given-names></name><name><surname>Huber</surname><given-names>R</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Pingoud</surname><given-names>A</given-names></name></person-group><article-title>Structure and function of the tetrameric restriction enzymes</article-title><source>Nucleic Acids and Molecular Biology, Restriction Endonucleases.</source><year>2004</year><volume>14</volume><publisher-loc>Berlin</publisher-loc><publisher-name>Springer</publisher-name><fpage>237</fpage><lpage>259</lpage></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Roberts</surname><given-names>RJ</given-names></name><name><surname>Belfort</surname><given-names>M</given-names></name><name><surname>Bestor</surname><given-names>T</given-names></name><name><surname>Bhagwat</surname><given-names>AS</given-names></name><name><surname>Bickle</surname><given-names>TA</given-names></name><name><surname>Bitinaite</surname><given-names>J</given-names></name><name><surname>Blumenthal</surname><given-names>RM</given-names></name><name><surname>Degtyarev</surname><given-names>SK</given-names></name><name><surname>Dryden</surname><given-names>DTF</given-names></name><name><surname>Dybvig</surname><given-names>K</given-names></name><etal/></person-group><article-title>A nomenclature for restriction enzymes, DNA methyltransferases, homing endonucleases and their genes</article-title><source>Nucleic Acids Res.</source><year>2003</year><volume>31</volume><fpage>1805</fpage><lpage>1812</lpage><pub-id pub-id-type="pmid">12654995</pub-id></element-citation></ref><ref id="B16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Roberts</surname><given-names>RJ</given-names></name><name><surname>Vincze</surname><given-names>T</given-names></name><name><surname>Posfai</surname><given-names>J</given-names></name><name><surname>Macelis</surname><given-names>D</given-names></name></person-group><article-title>REBASE - enzymes and genes for DNA restriction and modification</article-title><source>Nucleic Acids Res.</source><year>2007</year><volume>35</volume><fpage>D269</fpage><lpage>D270</lpage><pub-id pub-id-type="pmid">17202163</pub-id></element-citation></ref><ref id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lesser</surname><given-names>DR</given-names></name><name><surname>Kurpiewski</surname><given-names>MR</given-names></name><name><surname>Jen-Jacobson</surname><given-names>L</given-names></name></person-group><article-title>The energetic basis of specificity in the EcoRI endonuclease-DNA interaction</article-title><source>Science</source><year>1990</year><volume>250</volume><fpage>776</fpage><lpage>786</lpage><pub-id pub-id-type="pmid">2237428</pub-id></element-citation></ref><re