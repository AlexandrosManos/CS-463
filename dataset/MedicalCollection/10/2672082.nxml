>13</volume><fpage>171</fpage><lpage>177</lpage><pub-id pub-id-type="pmid">15228985</pub-id></citation></ref><ref id="B8"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Harris</surname><given-names>E</given-names></name></person-group><article-title>Global Dairy Demand Drives Up Price</article-title><source>NPR</source><year>2007</year><ext-link ext-link-type="uri" xlink:href="http://www.npr.org/templates/story/story.php?storyId=14576499"/></citation></ref><ref id="B9"><citation citation-type="other"><person-group person-group-type="author"><collab>Food and Agricultural Organization of the United Nations</collab></person-group><article-title>Food Outlook. Global Market Analysis</article-title><year>2007</year><ext-link ext-link-type="uri" xlink:href="ftp://ftp.fao.org/docrep/fao/010/ah876e/ah876e00.pdf"/><comment></comment></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Robertson</surname><given-names>D</given-names></name></person-group><article-title>Food Costs</article-title><source>Listener</source><year>2007</year><publisher-name>Auckland: New Zealand Magazines</publisher-name><fpage>6</fpage></citation></ref><ref id="B11"><citation citation-type="other"><person-group person-group-type="author"><name><surname>White</surname><given-names>J</given-names></name></person-group><article-title>The Health Select Committee Inquiry into Obesity and Type Two Diabetes in New Zealand: An initial analysis of submissions</article-title><source>Fight the Obesity Epidemic New Zealand Incorporated Wellington</source><year>2007</year><ext-link ext-link-type="uri" xlink:href="http://www.foe.org.nz/archives/HSCAnalysis.pdf"/><comment></comment></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Patterson</surname><given-names>T</given-names></name></person-group><source>Skyrocketing milk prices hit families