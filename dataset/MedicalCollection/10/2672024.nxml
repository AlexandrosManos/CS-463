ature Rev. Genet</source><year>2004</year><volume>24</volume><fpage>101</fpage><lpage>113</lpage><pub-id pub-id-type="pmid">14735121</pub-id></citation></ref><ref id="b20-ijms-10-01161"><label>20.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bing</surname><given-names>RJ</given-names></name></person-group><article-title>Cardiac Metabolism</article-title><source>Physiol. Rev</source><year>1965</year><volume>45</volume><fpage>171</fpage><lpage>213</lpage><pub-id pub-id-type="pmid">14302909</pub-id></citation></ref><ref id="b21-ijms-10-01161"><label>21.</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Vignais</surname><given-names>P</given-names></name></person-group><source>Science Exp&#x000e9;rimentale Et Connaissance Du Vivant. La M&#x000e9;thode Et Les Concepts</source><publisher-name>EDP Sciences</publisher-name><publisher-loc>Les Ulis, France</publisher-loc><year>2006</year></citation></ref><ref id="b22-ijms-10-01161"><label>22.</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Vignais</surname><given-names>P</given-names></name></person-group><source>La Biologie Des Origines a Nos Jours</source><publisher-name>EDP Sciences</publisher-name><publisher-loc>Les Ulis, France</publisher-loc><year>2001</year></citation></ref><ref id="b23-ijms-10-01161"><label>23.</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bernard</surname><given-names>C</given-names></name></person-group><source>Introduction &#x000c0; L&#x02019;&#x000e9;tude De La M&#x000e9;dicine Exp&#x000e9;rimentale</source><publisher-name>Flammarion</publisher-name><publisher-loc>Paris</publisher-loc><year>1984</year></citation></ref><ref id="b24-ijms-10-01161"><label>24.</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wiener</surname><given-names>N</given-names></name></person-gro