<mixed-citation publication-type="other"><article-title>Mental Illness and Exclusion: Putting Mental Health on the Development Agenda in Uganda</article-title><ext-link ext-link-type="uri" xlink:href="http://www.chronicpoverty.org/pubfiles/CPRC-UG_PolicyBrief2(2007).pdf">http://www.chronicpoverty.org/pubfiles/CPRC-UG_PolicyBrief2(2007).pdf</ext-link></mixed-citation></ref><ref id="B20"><mixed-citation publication-type="other"><article-title>Uganda Demographic and Health Survey 2006</article-title><source>Uganda Bureau of Statistics. Kampala</source><year>2007</year></mixed-citation></ref><ref id="B21"><mixed-citation publication-type="journal"><name><surname>Flisher</surname><given-names>AJ</given-names></name><name><surname>Lund</surname><given-names>C</given-names></name><name><surname>Funk</surname><given-names>M</given-names></name><name><surname>Banda</surname><given-names>M</given-names></name><name><surname>Bhana</surname><given-names>A</given-names></name><name><surname>Doku</surname><given-names>V</given-names></name><article-title>Mental health policy development and implementation in four African countries</article-title><source>Journal of Health Psychology</source><year>2007</year><volume>12</volume><fpage>505</fpage><lpage>516</lpage><pub-id pub-id-type="doi">10.1177/1359105307076237</pub-id><pub-id pub-id-type="pmid">17440000</pub-id></mixed-citation></ref><ref id="B22"><mixed-citation publication-type="book"><name><surname>Ritchie</surname><given-names>J</given-names></name><name><surname>Spencer</surname><given-names>L</given-names></name><person-group person-group-type="editor">Bryman, Alan, Burgess, Robert</person-group><article-title>Qualitative data analysis for applied policy research</article-title><source>Analysing qualitative data</source><year>1994</year><publisher-name>London and New York: Routledge</publisher-name><fpage>172</fpage><lpage>194</lpage></mixed-citation></ref><ref id="B23"><mixed-citation publication-type="journal"><name><surname>Patel</surname><given-names>V</given-names></name><article-title>Mental health in low and middle income countries</article-title><source>British Medical Bulletin</source><year>2007</year><volume>81&#x02013;82</volume><fpage>81</fpage><lpage>96</lpage><pub-id pub-id-type="doi">10.1093/bmb/ldm010</pub-id></mixed-citation></ref><ref id="B24"><mixed-citation publication-type="book"><name><surname>Patel</surname><given-names>V</given-names></name><person-group person-group-type="editor">Leon D, Walt G</person-group><article-title>Poverty, inequality and mental health in developing countries</article-title><source>Poverty, Inequality and Health</source><year>2001</year><publisher-name>Oxford: Oxford University Press</publisher-name><fpage>247</fpage><lpage>262</lpage></mixed-citation></ref><ref id="B25"><mixed-citation publication-type="book"><name><surname>Fauerstein</surname><given-names>MT</given-names></name><source>Poverty and Health. Reaping a Richer Harvest</source><year>1997</year><publisher-name>Malaysia., MacMillan Education Ltd</publisher-name></mixed-citation></ref><ref id="B26"><mixed-citation publication-type="journal"><name><surname>Lauber</surname><given-names>C</given-names></name><name><surname>R&#x000f6;ssler</surname><given-names>W</given-names></name><article-title>Stigma towards People with Mental Illness in Developing Countries in Asia</article-title><source>International Review of Psychiatry</source><year>2007</year><volume>19</volume><fpage>158</fpage><lpage>178</lpage></mixed-citation></ref><ref id="B27"><mixed-citation publication-type="book"><name><surname>Leff</surname><given-names>J</given-names></name><source>Social Inclusion of People with Mental Illness</source><year>2006</year><publisher-name>New York: Cambridge University Press</publisher-name></mixed-citation></ref><ref id="B28"><mixed-citation publication-type="journal"><name><surname>Lehman</surname><given-names>A</given-names></name><name><surname>Rachuba</surname><given-names>L</given-names></name><name><surname>Postrado</surname><given-names>L</given-names></name><article-title>Demographic influences on quality of life among persons with chronic mental illnesses</article-title><source>Evaluation-and-Program-Planning</source><year>1995</year><volume>18</volume><fpage>155</fpage><lpage>164</lpage><pub-id pub-id-type="doi">10.1016/0149-7189(95)00006-W</pub-id></mixed-citation></ref><ref id="B29"><mixed-citation publication-type="journal"><name><surname>Wilton</surname><given-names>RD</given-names></name><article-title>Poverty and Mental Health: A Qualitative Study of Residential Care Facility Tenants</article-title><source>Community Mental Health Journal</source><year>2003</year><volume>39</volume><issue>2</issue><fpage>139</fpage><lpage>156</lpage><pub-id pub-id-type="doi">10.1023/A:1022662704461</pub-id><pub-id pub-id-type="pmid">12723848</pub-id></mixed-citation></ref><ref id="B30"><mixed-citation publication-type="journal"><name><surname>Yanos</surname><given-names>P</given-names></name><name><surname>Rosenfield</surname><given-names>S</given-names></name><name><surname>Horwitz</surname><given-names>A</given-names></name><article-title>Negative and supportive social interactions and quality of life among persons diagnosed with severe mental illness</article-title><source>Community Mental Health Journal</source><year>2001</year><volume>37</volume><fpage>405</fpage><lpage>419</lpage><pub-id pub-id-type="doi">10.1023/A:1017528029127</pub-id><pub-id pub-id-type="pmid">11419518</pub-id></mixed-citation></ref></ref-list></back></article>