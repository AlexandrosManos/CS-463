2358619</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-3156.2002.00929.x</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Onwujekwe</surname><given-names>O</given-names></name><name><surname>Chima</surname><given-names>R</given-names></name><name><surname>Shu</surname><given-names>E</given-names></name><name><surname>Nwagbo</surname><given-names>D</given-names></name><name><surname>Okwonkwo</surname><given-names>P</given-names></name></person-group><article-title>Hypothetical and actual willingness to pay for insecticide-treted nets in five Nigerian communities</article-title><source>Trop Med Int Health</source><year>2001</year><volume>6</volume><fpage>545</fpage><lpage>553</lpage><pub-id pub-id-type="pmid">11469949</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-3156.2001.00745.x</pub-id></citation></ref></ref-list></back></article>