rnal"><person-group person-group-type="author"><name><surname>Zhou</surname><given-names>S</given-names></name><name><surname>Morris</surname><given-names>JJ</given-names></name><name><surname>Barnes</surname><given-names>Y</given-names></name><name><surname>Lan</surname><given-names>L</given-names></name><name><surname>Schuetz</surname><given-names>JD</given-names></name><etal/></person-group><year>2002</year><article-title>Bcrp1 gene expression is required for normal numbers of side population stem cells in mice, and confers relative protection to mitoxantrone in hematopoietic cells in vivo.</article-title><source>Proc Natl Acad Sci U S A</source><volume>99</volume><fpage>12339</fpage><lpage>12344</lpage><pub-id pub-id-type="pmid">12218177</pub-id></citation></ref><ref id="pone.0005172-Dean2"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dean</surname><given-names>M</given-names></name><name><surname>Fojo</surname><given-names>T</given-names></name><name><surname>Bates</surname><given-names>S</given-names></name></person-group><year>2005</year><article-title>Tumour stem cells and drug resistance.</article-title><source>Nat Rev Cancer</source><volume>5</volume><fpage>275</fpage><lpage>284</lpage><pub-id pub-id-type="pmid">15803154</pub-id></citation></ref><ref id="pone.0005172-Sequist1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sequist</surname><given-names>LV</given-names></name></person-group><year>2007</year><article-title>Second-generation epidermal growth factor receptor tyrosine kinase inhibitors in non-small cell lung cancer.</article-title><source>Oncologist</source><volume>12</volume><fpage>325</fpage><lpage>330</lpage><pub-id pub-id-type="pmid">17405897</pub-id></citation></ref><ref id="pone.0005172-Cabebe1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cabebe</surname><given-names>E</given-names></name><name><surname>Wakelee</surname><given-names>H</given-names></name></person-group><year>2007</year><article-title>Role of anti-angiogenesis agents in treating NSCLC: focus on bevacizumab and VEGFR tyrosine kinase inhibitors.</article-title><source>Curr Treat Options Oncol</source><volume>8</volume><fpage>15</fpage><lpage>27</lpage><pub-id pub-id-type="pmid">17634832</pub-id></citation></ref><ref id="pone.0005172-Hegedus1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hegedus</surname><given-names>T</given-names></name><name><surname>Orfi</surname><given-names>L</given-names></name><name><surname>Seprodi</surname><given-names>A</given-names></name><name><surname>Varadi</surname><given-names>A</given-names></name><name><surname>Sarkadi</surname><given-names>B</given-names></name><etal/></person-group><year>2002</year><article-title>Interaction of tyrosine kinase inhibitors with the human multidrug transporter proteins, MDR1 and MRP1.</article-title><source>Biochim Biophys Acta</source><volume>1587</volume><fpage>318</fpage><lpage>325</lpage><pub-id pub-id-type="pmid">12084474</pub-id></citation></ref><ref id="pone.0005172-Kitazaki1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kitazaki</surname><given-names>T</given-names></name><name><surname>Oka</surname><given-names>M</given-names></name><name><surname>Nakamura</surname><given-names>Y</given-names></name><name><surname>Tsurutani</surname><given-names>J</given-names></name><name><surname>Doi</surname><given-names>S</given-names></name><etal/></person-group><year>2005</year><article-title>Gefitinib, an EGFR tyrosine kinase inhibitor, directly inhibits the function of P-glycoprotein in multidrug resistant cancer cells.</article-title><source>Lung Cancer</source><volume>49</volume><fpage>337</fpage><lpage>343</lpage><pub-id pub-id-type="pmid">15955594</pub-id></cita