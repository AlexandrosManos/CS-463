="B12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crescenzo</surname><given-names>R</given-names></name><name><surname>Lionetti</surname><given-names>L</given-names></name><name><surname>Mollica</surname><given-names>MP</given-names></name><name><surname>Ferraro</surname><given-names>M</given-names></name><name><surname>D'Andrea</surname><given-names>E</given-names></name><name><surname>Mainieri</surname><given-names>D</given-names></name><name><surname>Dulloo</surname><given-names>AG</given-names></name><name><surname>Liverini</surname><given-names>G</given-names></name><name><surname>Iossa</surname><given-names>S</given-names></name></person-group>:<article-title>Altered skeletal muscle subsarcolemmal mitochondrial compartment during catch-up fat after caloric restriction</article-title>.<source>Diabetes</source><year>2006</year>;<volume>55</volume>:<fpage>2286</fpage>&#x02013;<lpage>2293</lpage><pub-id pub-id-type="pmid">16873692</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Summermatter</surname><given-names>S</given-names></name><name><surname>Mainieri</surname><given-names>D</given-names></name><name><surname>Russell</surname><given-names>AP</given-names></name><name><surname>Seydoux</surname><given-names>J</given-names></name><name><surname>Montani</surname><given-names>JP</given-names></name><name><surname>Buchala</surname><given-names>A</given-names></name><name><surname>Solinas</surname><given-names>G</given-names></name><name><surname>Dulloo</surname><given-names>AG</given-names></name></person-group>:<article-title>Thrifty metabolism that favors fat storage after caloric restriction: a role for skeletal muscle phosphatidylinositol-3-kinase activity and AMP-activated protein kinase</article-title>.<source>FASEB J</source><year>2008</year>;<volume>22</volume>:<fpage>774</fpage>&#x02013;<lpage>78