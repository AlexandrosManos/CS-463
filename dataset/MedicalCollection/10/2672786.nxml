erson-group person-group-type="author"><name><surname>Hyland</surname><given-names>ME</given-names></name><name><surname>Singh</surname><given-names>SJ</given-names></name><name><surname>Sodergren</surname><given-names>SC</given-names></name><name><surname>Morgan</surname><given-names>MPL</given-names></name></person-group><article-title>Development of a shortened version of the breathing problems questionnaire suitable for use in a pulmonary rehabilitation clinic: a purpose-specific, disease-specific questionnaire</article-title><source>Qual Life Res</source><year>1998</year><volume>7</volume><fpage>227</fpage><lpage>233</lpage><pub-id pub-id-type="pmid">9584553</pub-id></mixed-citation></ref><ref id="b11-copd-4-009"><label>11</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Maille</surname><given-names>AR</given-names></name><name><surname>Koning</surname><given-names>CJM</given-names></name><name><surname>Zwinderman</surname><given-names>AH</given-names></name><name><surname>Willems</surname><given-names>LNA</given-names></name><name><surname>Dijkman</surname><given-names>JH</given-names></name><name><surname>Kaptein</surname><given-names>AA</given-names></name></person-group><article-title>The development of the &#x02018;Quality-of-Life for Respiratory Illness Questionnaire (QOL-RIQ)&#x02019;: a disease-specific quality-of-life questionnaire for patients with mild to moderate chronic non-specific lung disease</article-title><source>Respir Med</source><year>1997</year><volume>91</volume><fpage>297</fpage><lpage>309</lpage><pub-id pub-id-type="pmid">9176649</pub-id></mixed-citation></ref><ref id="b12-copd-4-009"><label>12</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Van Der Molen</surname><given-names>T</given-names></name><name><surname>Willemse</surname><given-names>BW</given-names></name><name><surname>Schokker</surname><given-names>S</given-nam