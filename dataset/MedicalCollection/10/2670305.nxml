/article-title><source>Tunisie M&#x000e9;dicale</source><year>2005</year><volume>83 Suppl 5</volume><fpage>1</fpage><lpage>7</lpage></citation></ref><ref id="B20"><citation citation-type="other"><person-group person-group-type="author"><collab>WHO</collab></person-group><article-title>Closing the gap in a generation</article-title><source>Geneva</source><year>2008</year></citation></ref></ref-list></back></article>