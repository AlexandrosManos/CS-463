ge><lpage>992</lpage><pub-id pub-id-type="pmid">12695526</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>O'Sullivan</surname><given-names>SE</given-names></name><name><surname>Tarling</surname><given-names>EJ</given-names></name><name><surname>Bennett</surname><given-names>AJ</given-names></name><name><surname>Kendall</surname><given-names>DA</given-names></name><name><surname>Randall</surname><given-names>MD</given-names></name></person-group><article-title>Novel time-dependent vascular actions of &#x00394;<sup>9</sup>- tetrahydrocannabinol mediated by peroxisome proliferator-activated receptor gamma</article-title><source><italic>Biochemical and Biophysical Research Communications</italic></source><year>2005</year><volume>337</volume><issue>3</issue><fpage>824</fpage><lpage>831</lpage><pub-id pub-id-type="pmid">16213464</pub-id></citation></ref><ref id="B14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rockwell</surname><given-names>CE</given-names></name><name><surname>Kaminski</surname><given-names>NE</given-names></name></person-group><article-title>A cyclooxygenase metabolite of anandamide causes inhibition of interleukin-2 secretion in murine splenocytes</article-title><source><italic>Journal of Pharmacology and Experimental Therapeutics</italic></source><year>2004</year><volume>311</volume><issue>2</issue><fpage>683</fpage><lpage>690</lpage><pub-id pub-id-type="pmid">15284281</pub-id></citation></ref><ref id="B15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rockwell</surname><given-names>CE</given-names></name><name><surname>Snider</surname><given-names>NT</given-names></name><name><surname>Thompson</surname><given-names>JT</given-names></name><name><surname>Vanden Heuvel</surname><given-names>JP</given-names></name><name><surname>Kaminski