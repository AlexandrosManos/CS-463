><td align="left" rowspan="1" colspan="1">262</td><td align="left" rowspan="1" colspan="1">30 mg (N=130)</td><td align="left" rowspan="1" colspan="1">Placebo (N=132)</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b65-ndt-2-427">Vieta et al 2005</xref></td><td align="left" rowspan="1" colspan="1">12</td><td align="left" rowspan="1" colspan="1">347</td><td align="left" rowspan="1" colspan="1">15&#x02013;30 mg (N=175)</td><td align="left" rowspan="1" colspan="1">Haloperidol 10&#x02013;15mg (N=172)</td><td align="left" rowspan="1" colspan="1">Benztropine or other anticholinergics were not permitted</td></tr><tr><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b5-ndt-2-427">Bristol-Myers Squibb 2003b</xref></td><td align="left" rowspan="1" colspan="1">?</td><td align="left" rowspan="1" colspan="1">?</td><td align="left" rowspan="1" colspan="1">15 mg (N=?), 30 mg (N=?)</td><td align="left" rowspan="1" colspan="1">Placebo (N=?)</td><td align="left" rowspan="1" colspan="1">Response to aripiprazole did not separate from placebo; data not published, nor posted in the Bristol-Myers Squibb Clinical Trials Disclosure Database</td></tr><tr><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b55-ndt-2-427">Sachs et al 2006</xref></td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">272</td><td align="left" rowspan="1" colspan="1">30 mg (N=137)</td><td align="left" rowspan="1" colspan="1">Placebo (N=135)</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b4-ndt-2-427">Bristol-Myers Squibb 2003a</xref> (CN138-010), and <xref ref-type="bibr" rid="b38-ndt-2-427">Keck et al 2006</xref></td><td align="left" rowspan="1" colspan="1">26</td><td align="left" rowspan="1" colspan="1">161</td><td align="left" rowspan="1" colspan="1">15&#x02013;30 mg (N=77)</td><td align="left