/ref><ref id="b8-0090232"><label>8</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Crichton</surname><given-names>EC</given-names></name></person-group><article-title>The significance of the retroverted uterus in obstetrics and gynaecology</article-title><source>S Afr Med J</source><year>1959</year><volume>33</volume><fpage>129</fpage><lpage>131</lpage><pub-id pub-id-type="pmid">13635141</pub-id></mixed-citation></ref><ref id="b9-0090232"><label>9</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nowlin</surname><given-names>WC</given-names></name></person-group><article-title>Incarceration of the pregnant retroverted uterus</article-title><source>Med Times</source><year>1965</year><volume>93</volume><fpage>743</fpage><lpage>745</lpage><pub-id pub-id-type="pmid">14300350</pub-id></mixed-citation></ref><ref id="b10-0090232"><label>10</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gibbons</surname><given-names>JM</given-names><suffix>Jr</suffix></name><name><surname>Paely</surname><given-names>WB</given-names></name></person-group><article-title>The incarcerated gravid uterus</article-title><source>Obstet Gynecol</source><year>1969</year><volume>331</volume><fpage>842</fpage><lpage>845</lpage><pub-id pub-id-type="pmid">5770559</pub-id></mixed-citation></ref><ref id="b11-0090232"><label>11</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hamoda</surname><given-names>H</given-names></name><name><surname>Chamberlain</surname><given-names>PF</given-names></name><name><surname>Moore</surname><given-names>NR</given-names></name><name><surname>MacKenzie</surname><given-names>IZ</given-names></name></person-group><article-title>Conservative treatment of an incarcerated gravid uterus</article-title><source>BJOG</source><year>2002</year><volume>109</vo