f exposure</article-title><source>Ann Intern Med</source><year>2006</year><volume>145</volume><fpage>78</fpage><lpage>79</lpage><pub-id pub-id-type="pmid">16818936</pub-id></mixed-citation></ref></ref-list></back></article>