 align="center" rowspan="1" colspan="1">288.15</td></tr><tr><td align="left" rowspan="1" colspan="1">IM18</td><td align="left" rowspan="1" colspan="1">(CF<sub>3</sub>SO<sub>2</sub>)<sub>2</sub>N</td><td align="center" rowspan="1" colspan="1">&#x02212;4.59</td><td align="center" rowspan="1" colspan="1">&#x02212;4.54</td><td align="center" rowspan="1" colspan="1">0.05</td><td align="center" rowspan="1" colspan="1">293.15</td></tr><tr><td align="left" rowspan="1" colspan="1">IM18</td><td align="left" rowspan="1" colspan="1">(CF<sub>3</sub>SO<sub>2</sub>)<sub>2</sub>N</td><td align="center" rowspan="1" colspan="1">&#x02212;4.1 [<xref ref-type="bibr" rid="b27-ijms-10-01271">27</xref>]</td><td align="center" rowspan="1" colspan="1">&#x02212;4.54</td><td align="center" rowspan="1" colspan="1">&#x02212;0.44</td><td align="center" rowspan="1" colspan="1">293.15</td></tr><tr><td align="left" rowspan="1" colspan="1">IM18</td><td align="left" rowspan="1" colspan="1">(CF<sub>3</sub>SO<sub>2</sub>)<sub>2</sub>N</td><td align="center" rowspan="1" colspan="1">&#x02212;4.49 [<xref ref-type="bibr" rid="b25-ijms-10-01271">25</xref>]</td><td align="center" rowspan="1" colspan="1">&#x02212;4.54</td><td align="center" rowspan="1" colspan="1">&#x02212;0.05</td><td align="center" rowspan="1" colspan="1">293.15</td></tr><tr><td align="left" rowspan="1" colspan="1">IM18</td><td align="left" rowspan="1" colspan="1">(CF<sub>3</sub>SO<sub>2</sub>)<sub>2</sub>N</td><td align="center" rowspan="1" colspan="1">&#x02212;4.14 [<xref ref-type="bibr" rid="b24-ijms-10-01271">24</xref>]</td><td align="center" rowspan="1" colspan="1">&#x02212;4.54</td><td align="center" rowspan="1" colspan="1">&#x02212;0.4</td><td align="center" rowspan="1" colspan="1">296.5</td></tr><tr><td align="left" rowspan="1" colspan="1">IM18</td><td align="left" rowspan="1" colspan="1">(CF<sub>3</sub>SO<sub>2</sub>)<sub>2</sub>N</td><td align="center" rowspan="1" colspan="1">&#x02212;4.1 [<xref ref-type="bibr" rid="b26-ijms-10-012