1">Normal</th><th align="left" rowspan="1" colspan="1">MCI</th><th align="left" rowspan="1" colspan="1">Normal</th><th align="left" rowspan="1" colspan="1">MCI</th><th align="left" rowspan="1" colspan="1">Normal</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">70.71</td><td align="left" rowspan="1" colspan="1">64.03</td><td align="left" rowspan="1" colspan="1">15.00</td><td align="left" rowspan="1" colspan="1">16.12</td><td align="left" rowspan="1" colspan="1">91.14</td><td align="left" rowspan="1" colspan="1">95.21</td><td align="left" rowspan="1" colspan="1">33.14</td><td align="left" rowspan="1" colspan="1">33.50</td></tr><tr><td align="left" rowspan="1" colspan="1">(8.16)</td><td align="left" rowspan="1" colspan="1">(11.44)</td><td align="left" rowspan="1" colspan="1">(3.11)</td><td align="left" rowspan="1" colspan="1">(3.54)</td><td align="left" rowspan="1" colspan="1">(2.48)</td><td align="left" rowspan="1" colspan="1">(2.97)</td><td align="left" rowspan="1" colspan="1">(2.19)</td><td align="left" rowspan="1" colspan="1">(3.05)</td></tr></tbody></table><table-wrap-foot><fn id="tfn1-ndt-2-565"><p><bold>Note:</bold> Mean values are reported with standard deviations.</p></fn><fn id="tfn2-ndt-2-565"><label>a</label><p>n = 7</p></fn><fn id="tfn3-ndt-2-565"><label>b</label><p>n = 34.</p></fn><fn id="tfn4-ndt-2-565"><p><bold>Abbreviations:</bold> ACE, Addenbrooke&#x02019;s Cognitive Examination; MCI, mild cognitive impairment; UPSIT, University of Pennsylvania Smell Identification Test.</p></fn></table-wrap-foot></table-wrap><table-wrap id="t2-ndt-2-565" position="float"><label>Table 2</label><caption><p>Intercorrelations between age, education, and scores on the ACE, UPSIT, and MMSE for all subjects</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1">Variable</th><th align="left" rowspan="1" colspan="1">Age</th><th align="left" rowspan="1" colspan="1">Education</th><th align="left" rowspan="1" col