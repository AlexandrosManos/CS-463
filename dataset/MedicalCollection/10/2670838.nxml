 pub-id-type="doi">10.1016/S0140-6736(97)07322-4</pub-id><pub-id pub-id-type="pmid">9519952</pub-id></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="journal"><name><surname>Snyder</surname><given-names>M</given-names></name><name><surname>Drlica</surname><given-names>K</given-names></name><article-title>DNA gyrase on the bacterial chromosome: DNA cleavage induced by oxolinic acid</article-title><source>J Mol Biol</source><year>1979</year><volume>131</volume><issue>2</issue><fpage>287</fpage><lpage>302</lpage><pub-id pub-id-type="doi">10.1016/0022-2836(79)90077-9</pub-id><pub-id pub-id-type="pmid">226717</pub-id></mixed-citation></ref><ref id="B19"><mixed-citation publication-type="journal"><name><surname>Condemine</surname></name><name><surname>Smith</surname><given-names>CL</given-names></name><article-title>Transcription regulates oxolinic acid-induced DNA gyrase cleavage at specific sites on the <italic>E. coli </italic>chromosome</article-title><source>Nucleic Acids Res</source><year>1990</year><volume>18</volume><issue>24</issue><fpage>7389</fpage><lpage>7396</lpage><pub-id pub-id-type="pmid">2175434</pub-id><pub-id pub-id-type="doi">10.1093/nar/18.24.7389</pub-id></mixed-citation></ref><ref id="B20"><mixed-citation publication-type="journal"><name><surname>Hsu</surname><given-names>Y-H</given-names></name><name><surname>Chung</surname><given-names>M-W</given-names></name><name><surname>Li</surname><given-names>T-K</given-names></name><article-title>Distribution of gyrase and topoisomerase IV on bacterial nucleoid: implications for nucleoid organization</article-title><source>Nucleic Acids Res</source><year>2006</year><volume>34</volume><issue>10</issue><fpage>3128</fpage><lpage>3138</lpage><pub-id pub-id-type="pmid">16757578</pub-id><pub-id pub-id-type="doi">10.1093/nar/gkl392</pub-id></mixed-citation></ref><ref id="B21"><mixed-citation publication-type="journal"><name><surname>Roostalu</surname><given-names>J</given-names></name><name><s