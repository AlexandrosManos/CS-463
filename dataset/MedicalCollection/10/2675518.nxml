/pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>James</surname><given-names>PA</given-names></name><name><surname>Kreiter</surname><given-names>CD</given-names></name><name><surname>Shipengrover</surname><given-names>J</given-names></name><name><surname>Crosson</surname><given-names>J</given-names></name></person-group><article-title>Identifying the attributes of instructional quality in ambulatory teaching sites: a validation study of the MedED IQ</article-title><source>Fam Med</source><year>2002</year><volume>34</volume><fpage>268</fpage><lpage>273</lpage><pub-id pub-id-type="pmid">12017141</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hauer</surname><given-names>KE</given-names></name><name><surname>Teherani</surname><given-names>A</given-names></name><name><surname>Wiese</surname><given-names>J</given-names></name><name><surname>Fenton</surname><given-names>CL</given-names></name></person-group><article-title>A strategy top standardize the learning of core clerkship objectives</article-title><source>Adv Health Sci Educ Theory Pract</source><year>2003</year><volume>8</volume><fpage>213</fpage><lpage>221</lpage><pub-id pub-id-type="pmid">14574046</pub-id><pub-id pub-id-type="doi">10.1023/A:1026091528634</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Markert</surname><given-names>RJ</given-names></name></person-group><article-title>What makes a good teacher? Lessons from teaching medical students</article-title><source>Acad Med</source><year>2001</year><volume>76</volume><fpage>809</fpage><lpage>810</lpage><pub-id pub-id-type="pmid">11500281</pub-id><pub-id pub-id-type="doi">10.1097/00001888-200108000-00011</pub-id></citation></ref><ref id="B9"><citation citation-type="book"><person-group person-group-type="author"><name><surn