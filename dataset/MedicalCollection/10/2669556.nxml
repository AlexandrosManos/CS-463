d="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morrison</surname><given-names>TC</given-names></name><name><surname>Wahlgren</surname><given-names>DR</given-names></name><name><surname>Hovell</surname><given-names>MF</given-names></name><name><surname>Zakarian</surname><given-names>J</given-names></name><name><surname>Burkham-Kreitner</surname><given-names>S</given-names></name><name><surname>Hofstetter</surname><given-names>CR</given-names></name><name><surname>Slymen</surname><given-names>DJ</given-names></name><name><surname>Keating</surname><given-names>K</given-names></name><name><surname>Russos</surname><given-names>S</given-names></name><name><surname>Jones</surname><given-names>JA</given-names></name></person-group><article-title>Tracking and follow-up of 16 915 adolescents: minimising attrition bias</article-title><source>Controlled Clinical Trials</source><year>1997</year><volume>18</volume><fpage>383</fpage><lpage>96</lpage><pub-id pub-id-type="pmid">9315423</pub-id><pub-id pub-id-type="doi">10.1016/S0197-2456(97)00025-1</pub-id></citation></ref><ref id="B21"><citation citation-type="other"><article-title>The National Board of Health and Welfare (Socialstyrelsen)</article-title><ext-link ext-link-type="uri" xlink:href="http://www.sos.se./sos/statistik"/><comment>2002-07-01</comment></citation></ref><ref id="B22"><citation citation-type="other"><article-title>EpC 2002 National Board of Health and Welfare. Centre for Epidemiology</article-title><ext-link ext-link-type="uri" xlink:href="http://www.sos.se"/><comment>2001-11-01</comment></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eriksen</surname><given-names>W</given-names></name><name><surname>Bruusgaard</surname><given-names>D</given-names></name></person-group><article-title>Do parents take practical measures to prevent passive smoking by the children?</article-title><source>Scand