-names>A</given-names></name><name><surname>Nussbaum</surname><given-names>R</given-names></name><etal/></person-group><article-title>Alpha-synuclein locus triplication causes Parkinson&#x02019;s disease</article-title><source>Science</source><year>2003</year><volume>302</volume><fpage>841</fpage><pub-id pub-id-type="pmid">14593171</pub-id></citation></ref><ref id="b7-ijms-10-00724"><label>7.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nishioka</surname><given-names>K</given-names></name><name><surname>Hayashi</surname><given-names>S</given-names></name><name><surname>Farrer</surname><given-names>MJ</given-names></name><name><surname>Singleton</surname><given-names>AB</given-names></name><name><surname>Yoshino</surname><given-names>H</given-names></name><name><surname>Imai</surname><given-names>H</given-names></name><name><surname>Kitami</surname><given-names>T</given-names></name><name><surname>Sato</surname><given-names>K</given-names></name><name><surname>Kuroda</surname><given-names>R</given-names></name><name><surname>Tomiyama</surname><given-names>H</given-names></name><etal/></person-group><article-title>Clinical heterogeneity of alpha-synuclein gene duplication in Parkinson&#x02019;s disease</article-title><source>Ann. Neurol</source><year>2006</year><volume>59</volume><fpage>298</fpage><lpage>309</lpage><pub-id pub-id-type="pmid">16358335</pub-id></citation></ref><ref id="b8-ijms-10-00724"><label>8.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marx</surname><given-names>FP</given-names></name><name><surname>Holzmann</surname><given-names>C</given-names></name><name><surname>Strauss</surname><given-names>KM</given-names></name><name><surname>Eberhardt</surname><given-names>O</given-names></name><name><surname>Gerhardt</surname><given-names>E</given-names></name><name><surname>Cookson</surname><given-names>MR</given-names></name><name><surname>Hernandez</s