e><fpage>686</fpage><lpage>690</lpage><pub-id pub-id-type="pmid">11809975</pub-id><pub-id pub-id-type="doi">10.1126/science.1066642</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leung-Hagesteijn</surname><given-names>C</given-names></name><name><surname>Spence</surname><given-names>AM</given-names></name><name><surname>Stern</surname><given-names>BD</given-names></name><name><surname>Zhou</surname><given-names>Y</given-names></name><name><surname>Su</surname><given-names>MW</given-names></name><name><surname>Hedgecock</surname><given-names>EM</given-names></name><name><surname>Culotti</surname><given-names>JG</given-names></name></person-group><article-title>UNC-5, a transmembrane protein with immunoglobulin and thrombospondin type 1 domains, guides cell and pioneer axon migrations in <italic>C. elegans</italic></article-title><source>Cell</source><year>1992</year><volume>71</volume><fpage>289</fpage><lpage>299</lpage><pub-id pub-id-type="pmid">1384987</pub-id><pub-id pub-id-type="doi">10.1016/0092-8674(92)90357-I</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hutter</surname><given-names>H</given-names></name><name><surname>Vogel</surname><given-names>BE</given-names></name><name><surname>Plenefisch</surname><given-names>JD</given-names></name><name><surname>Norris</surname><given-names>CR</given-names></name><name><surname>Proenca</surname><given-names>RB</given-names></name><name><surname>Spieth</surname><given-names>J</given-names></name><name><surname>Guo</surname><given-names>C</given-names></name><name><surname>Mastwal</surname><given-names>S</given-names></name><name><surname>Zhu</surname><given-names>X</given-names></name><name><surname>Scheel</surname><given-names>J</given-names></name><name><surname>Hedgecock</surname><given-names>EM</given-names></name></person-group><article-title>Conservation and novelty in the evolution of cell adhesion and extracellular matrix genes</article-title><source>Science</source><year>2000</year><volume>287</volume><fpage>989</fpage><lpage>994</lpage><pub-id pub-id-type="pmid">10669422</pub-id><pub-id pub-id-type="doi">10.1126/science.287.5455.989</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Teichmann</surname><given-names>SA</given-names></name><name><surname>Chothia</surname><given-names>C</given-names></name></person-group><article-title>Immunoglobulin superfamily proteins in <italic>Caenorhabditis elegans</italic></article-title><source>J Mol Biol</source><year>2000</year><volume>296</volume><fpage>1367</fpage><lpage>1383</lpage><pub-id pub-id-type="pmid">10698639</pub-id><pub-id pub-id-type="doi">10.1006/jmbi.1999.3497</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chan</surname><given-names>SS</given-names></name><name><surname>Zheng</surname><given-names>H</given-names></name><name><surname>Su</surname><given-names>MW</given-names></name><name><surname>Wilk</surname><given-names>R</given-names></name><name><surname>Killeen</surname><given-names>MT</given-names></name><name><surname>Hedgecock</surname><given-names>EM</given-names></name><name><surname>Culotti</surname><given-names>JG</given-names></name></person-group><article-title>UNC-40, a <italic>C. elegans </italic>homolog of DCC (Deleted in Colorectal Cancer), is required in motile cells responding to UNC-6 netrin cues</article-title><source>Cell</source><year>1996</year><volume>87</volume><fpage>187</fpage><lpage>195</lpage><pub-id pub-id-type="pmid">8861903</pub-id><pub-id pub-id-type="doi">10.1016/S0092-8674(00)81337-9</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zallen</surname><given-names>JA</given-names></name