0.32</italic></td><td align="left">2.04 &#x000b1; 0.46</td><td align="left">LTR</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td></td><td></td><td align="left"><sc>SABRINA3_TM</sc></td><td align="center">1</td><td align="center">-</td><td align="center">1</td><td align="left">-</td><td align="left">&#x0003c; 27 &#x000b1; 4</td><td align="left">-</td><td align="left">&#x0003c; 2.0 &#x000b1; 0.5</td><td align="left">LTR</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td></td><td></td><td align="left"><sc>SABRINA_HV</sc></td><td align="center">1</td><td align="center">-</td><td align="center">1</td><td align="left">-</td><td align="left">&#x0003c; 27 &#x000b1; 4</td><td align="left">-</td><td align="left">&#x0003c; 2.0 &#x000b1; 0.5</td><td align="left">LTR</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td align="left">4</td><td align="left"><italic>Nusif_F2-1</italic></td><td align="left"><sc>NUSIF1_TM</sc></td><td align="center">1</td><td align="center"><italic>1</italic></td><td align="center">1</td><td align="left">-</td><td align="left">&#x0003c; 27 &#x000b1; 4</td><td align="left">-</td><td align="left">&#x0003c; 2.0 &#x000b1; 0.5</td><td align="left">LTR</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td align="left">5</td><td align="left"><italic>RIRE2 (rice)</italic></td><td align="left"><sc>RIRE2</sc></td><td align="center">1</td><td align="center"><italic>0</italic></td><td align="center">0</td><td align="left">-</td><td align="left">-</td><td align="left">-</td><td align="left">-</td><td align="left">LTR</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td align="left">6</td><td align="left"><italic>MITE 1-4</italic></td><td align="left"><sc>THALOS_HV</sc></td><td align="center">1</td><td align="center"><italic>0</italic></td><td align="center">0</td><td align="left">-</td><td align="left">-</td><td align="left">-</td><td align="left">-</td><td align="left">MITE</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td align="left">7</td><td align="left"><italic>MITE 2-5</italic></td><td align="left"><sc>TREP220</sc></td><td align="center">1</td><td align="center"><italic>0</italic></td><td align="center">0</td><td align="left">-</td><td align="left">-</td><td align="left">-</td><td align="left">-</td><td align="left">MITE</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td align="left">8</td><td align="left"><italic>Veju_F2-1</italic></td><td align="left"><sc>VEJU1_TM</sc></td><td align="center">3</td><td align="center"><italic>0</italic></td><td align="center">0</td><td align="left"><italic>10.8 &#x000b1; 5.5</italic></td><td align="left">10.8 &#x000b1; 5.4</td><td align="left"><italic>0.83 &#x000b1; 0.42</italic></td><td align="left">0.83 &#x000b1; 0.59</td><td align="left">LTR</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td align="left">9</td><td align="left"><italic>Claudia_F2-1</italic></td><td align="left"><sc>CLAUDIA1_TM</sc></td><td align="center">3</td><td align="center"><italic>0</italic></td><td align="center">0</td><td align="left">-</td><td align="left">&#x0003e; 41 &#x000b1; 6</td><td align="left">-</td><td align="left">&#x0003e; 3.2 &#x000b1; 0.6</td><td align="left">LTR</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td align="left">10</td><td align="left"><italic>Latidu F2-1</italic></td><td align="left"><sc>LATIDU2_TM</sc></td><td align="center">3</td><td align="center"><italic>1</italic></td><td align="center">1</td><td align="left"><italic>13.3 &#x000b1; 5.3</italic></td><td align="left">13.1 &#x000b1; 5.4</td><td align="left"><italic>1.01 &#x000b1; 0.41</italic></td><td align="left">1.01 &#x000b1; 0.58</td><td align="left">LTR</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td align="left">11</td><td align="left"><italic>Wham F2-1</italic></td><td align="left"><sc>WHAM3_TM</sc></td><td align="center">3</td><td align="center"><italic>1</italic></td><td align="center">1</td><td align="left"><italic>40.6 &#x000b1; 5.6</italic></td><td align="left">41.4 &#x000b1; 5.6</td><td align="left"><italic>3.12 &#x000b1; 0.43</italic></td><td align="left">3.18 &#x000b1; 0.60</td><td align="left">LTR</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td align="left">12</td><td align="left"><italic>Fatima_F2-1</italic></td><td align="left"><sc>FATIMA_TM</sc></td><td align="center">6</td><td align="center"><italic>0</italic></td><td align="center">0</td><td align="left">-</td><td align="left">&#x0003e; 31 &#x000b1; 4</td><td align="left">-</td><td align="left">&#x0003e; 2.4 &#x000b1; 0.4</td><td align="left">LTR</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td align="left">13</td><td align="left"><italic>Sukkula_F2-1</italic></td><td align="left"><sc>SUKKULA3_TM</sc></td><td align="center">1</td><td align="center"><italic>1</italic></td><td align="center">1</td><td align="left"><italic>29.9 &#x000b1; 2.6</italic></td><td align="left">-</td><td align="left"><italic>2.30 &#x000b1; 0.20</italic></td><td align="left">-</td><td align="left">LTR</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td></td><td></td><td align="left"><sc>SUKKULA3_TM</sc></td><td align="center">4</td><td align="center"><italic>1</italic></td><td align="center">1</td><td align="left"><italic>29.9 &#x000b1; 2.6</italic></td><td align="left">30.7 &#x000b1; 3.5</td><td align="left"><italic>2.30 &#x000b1; 0.20</italic></td><td align="left">2.36 &#x000b1; 0.37</td><td align="left">LTR</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td align="left">14</td><td align="left"><italic>Angela_F2-3</italic></td><td align="left"><sc>ANGELA1_TM</sc></td><td align="center">2</td><td align="center"><italic>2</italic></td><td align="center">2</td><td align="left">-</td><td align="left">&#x0003c; 31 &#x000b1; 4</td><td align="left">-</td><td align="left">&#x0003c; 2.4 &#x000b1; 0.4</td><td align="left">LTR</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td align="left">15</td><td align="left"><italic>Angela_F2-1</italic></td><td align="left">