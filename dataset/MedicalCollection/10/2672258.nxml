ats-group><table-wrap id="t1-wjem-9-0160" position="float"><label>Table 1</label><caption><p>Initial Laboratory Evaluation (&#x000bd; hour after ED arrival)</p></caption><table frame="hsides" rules="groups"><tbody><tr><td align="left" rowspan="1" colspan="1">Sodium</td><td align="center" rowspan="1" colspan="1">136 mEq/L</td></tr><tr><td align="left" rowspan="1" colspan="1">Potassium</td><td align="center" rowspan="1" colspan="1">3.1 mEq/L</td></tr><tr><td align="left" rowspan="1" colspan="1">Chloride</td><td align="center" rowspan="1" colspan="1">105 mEq/L</td></tr><tr><td align="left" rowspan="1" colspan="1">Bicarbonate</td><td align="center" rowspan="1" colspan="1">9 mEq/L</td></tr><tr><td align="left" rowspan="1" colspan="1">BUN</td><td align="center" rowspan="1" colspan="1">2 mg/dL</td></tr><tr><td align="left" rowspan="1" colspan="1">Creatinine</td><td align="center" rowspan="1" colspan="1">2.1 mg/dL</td></tr><tr><td align="left" rowspan="1" colspan="1">Glucose</td><td align="center" rowspan="1" colspan="1">707 mg/dL</td></tr><tr><td align="left" rowspan="1" colspan="1">Calcium</td><td align="center" rowspan="1" colspan="1">9.4 mg/dL</td></tr><tr><td align="left" rowspan="1" colspan="1">Total Protein</td><td align="center" rowspan="1" colspan="1">7.6 g/dL</td></tr><tr><td align="left" rowspan="1" colspan="1">AST</td><td align="center" rowspan="1" colspan="1">60 IU/L</td></tr><tr><td align="left" rowspan="1" colspan="1">ALT</td><td align="center" rowspan="1" colspan="1">53 IU/L</td></tr><tr><td align="left" rowspan="1" colspan="1">Bilirubin</td><td align="center" rowspan="1" colspan="1">0.8 mg/dL</td></tr><tr><td align="left" rowspan="1" colspan="1">Acetaminophen</td><td align="center" rowspan="1" colspan="1">&#x0003c;5 &#x003bc;g/mL</td></tr><tr><td align="left" rowspan="1" colspan="1">Salicylate</td><td align="center" rowspan="1" colspan="1">&#x0003c;4 mg/dL</td></tr><tr><td align="left" rowspan="1" colspan="1">Lactate</td><td align="center" rowspan="1" colsp