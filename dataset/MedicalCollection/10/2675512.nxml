#x003bd;</mml:mi><mml:mo>&#x002dc;</mml:mo></mml:mover><mml:mo>*</mml:mo></mml:msup></mml:mtd></mml:mtr></mml:mtable></mml:math></disp-formula>and<disp-formula><mml:math id="M109"><mml:mtable columnalign="left"><mml:mtr><mml:mtd><mml:mn>2</mml:mn><mml:msub><mml:mi>&#x003c3;</mml:mi><mml:mn>0</mml:mn></mml:msub><mml:msub><mml:mover accent="true"><mml:mi>&#x003bd;</mml:mi><mml:mo>&#x002dc;</mml:mo></mml:mover><mml:mrow><mml:mn>2101</mml:mn></mml:mrow></mml:msub><mml:mo>.</mml:mo><mml:msup><mml:mover accent="true"><mml:mi>&#x003bd;</mml:mi><mml:mo>&#x002dc;</mml:mo></mml:mover><mml:mo>*</mml:mo></mml:msup><mml:mo>=</mml:mo><mml:msub><mml:mi>&#x003b2;</mml:mi><mml:mn>1</mml:mn></mml:msub><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mtable><mml:mtr><mml:mtd><mml:mn>1</mml:mn></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mn>1</mml:mn></mml:mtd></mml:mtr></mml:mtable></mml:mrow><mml:mo>)</mml:mo></mml:mrow><mml:mo>.</mml:mo><mml:msup><mml:mover accent="true"><mml:mi>&#x003bd;</mml:mi><mml:mo>&#x002dc;</mml:mo></mml:mover><mml:mo>*</mml:mo></mml:msup></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mo>+</mml:mo><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mtable><mml:mtr><mml:mtd><mml:mn>0</mml:mn></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mrow><mml:mo stretchy="false">(</mml:mo><mml:mn>2</mml:mn><mml:msub><mml:mi>g</mml:mi><mml:mn>3</mml:mn></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mi>g</mml:mi><mml:mn>5</mml:mn></mml:msub><mml:mo stretchy="false">)</mml:mo><mml:msub><mml:mi>i</mml:mi><mml:mrow><mml:mn>2000</mml:mn></mml:mrow></mml:msub><mml:mo stretchy="false">(</mml:mo><mml:mn>2</mml:mn><mml:msub><mml:mi>g</mml:mi><mml:mn>4</mml:mn></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mi>g</mml:mi><mml:mn>5</mml:mn></mml:msub><mml:mo stretchy="false">)</mml:mo><mml:msub><mml:mi>S</mml:mi><mml:mrow><mml:mn>2000</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:mtd></m