chy="false">)</mml:mo><mml:mo>&#x02212;</mml:mo><mml:msub><mml:mi>&#x003b1;</mml:mi><mml:mn>0</mml:mn></mml:msub><mml:msubsup><mml:mi>B</mml:mi><mml:mn>2</mml:mn><mml:mn>2</mml:mn></mml:msubsup><mml:mo stretchy="false">(</mml:mo><mml:mi>t</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mo>&#x02212;</mml:mo><mml:msub><mml:mi>A</mml:mi><mml:mn>2</mml:mn></mml:msub><mml:mo stretchy="false">(</mml:mo><mml:mi>t</mml:mi><mml:mo stretchy="false">)</mml:mo><mml:mo stretchy="false">[</mml:mo><mml:msub><mml:mi>&#x003b1;</mml:mi><mml:mn>1</mml:mn></mml:msub><mml:msubsup><mml:mi>A</mml:mi><mml:mn>2</mml:mn><mml:mn>2</mml:mn></mml:msubsup><mml:mo stretchy="false">(</mml:mo><mml:mi>t</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mo>+</mml:mo><mml:msub><mml:mi>&#x003b1;</mml:mi><mml:mn>2</mml:mn></mml:msub><mml:msubsup><mml:mi>B</mml:mi><mml:mn>2</mml:mn><mml:mn>2</mml:mn></mml:msubsup><mml:mo stretchy="false">(</mml:mo><mml:mi>t</mml:mi><mml:mo stretchy="false">)</mml:mo><mml:mo stretchy="false">]</mml:mo></mml:mtd></mml:mtr></mml:mtable></mml:math></disp-formula><disp-formula id="FD39"><label>(3.24)</label><mml:math id="M70"><mml:mtable columnalign="left"><mml:mtr><mml:mtd><mml:mfrac><mml:mrow><mml:mi>d</mml:mi><mml:msub><mml:mi>B</mml:mi><mml:mn>2</mml:mn></mml:msub><mml:mo stretchy="false">(</mml:mo><mml:mi>t</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mrow><mml:mrow><mml:mi>d</mml:mi><mml:mi>t</mml:mi></mml:mrow></mml:mfrac><mml:mo>&#x0223c;</mml:mo><mml:mi>&#x003c3;</mml:mi><mml:msub><mml:mi>B</mml:mi><mml:mn>2</mml:mn></mml:msub><mml:mo stretchy="false">(</mml:mo><mml:mi>t</mml:mi><mml:mo stretchy="false">)</mml:mo><mml:mo>&#x02212;</mml:mo><mml:mn>4</mml:mn><mml:msub><mml:mi>&#x003b1;</mml:mi><mml:mn>0</mml:mn></mml:msub><mml:msub><mml:mi>A</mml:mi><mml:mn>2</mml:mn></mml:msub><mml:mo stretchy="false">(</mml:mo><mml:mi>t</mml:mi><mml:mo stretchy="false">)</mml:mo><mml:msub><mml:mi>B</mml:mi><mml:mn>2</mml:mn></mml:msub><mml:mo stretchy="false">(</mml:mo><mml:mi>t</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mo>&#x02212;</mml:mo><mml:msub><mml:mi>B</mml:mi><mml:mn>2</mml:mn></mml:msub><mml:mo stretchy="false">(</mml:mo><mml:mi>t</mml:mi><mml:mo stretchy="false">)</mml:mo><mml:mo stretchy="false">[</mml:mo><mml:mn>2</mml:mn><mml:msub><mml:mi>&#x003b1;</mml:mi><mml:mn>2</mml:mn></mml:msub><mml:msubsup><mml:mi>A</mml:mi><mml:mn>2</mml:mn><mml:mn>2</mml:mn></mml:msubsup><mml:mo stretchy="false">(</mml:mo><mml:mi>t</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mo>+</mml:mo><mml:mfrac><mml:mn>1</mml:mn><mml:mn>4</mml:mn></mml:mfrac><mml:mo stretchy="false">(</mml:mo><mml:msub><mml:mi>&#x003b1;</mml:mi><mml:mn>1</mml:mn></mml:msub><mml:mo>+</mml:mo><mml:mn>2</mml:mn><mml:msub><mml:mi>&#x003b1;</mml:mi><mml:mn>2</mml:mn></mml:msub><mml:mo stretchy="false">)</mml:mo><mml:msubsup><mml:mi>B</mml:mi><mml:mn>2</mml:mn><mml:mn>2</mml:mn></mml:msubsup><mml:mo stretchy="false">(</mml:mo><mml:mi>t</mml:mi><mml:mo stretchy="false">)</mml:mo><mml:mo stretchy="false">]</mml:mo></mml:mtd></mml:mtr></mml:mtable></mml:math></disp-formula>as the zero<italic><sup>th</sup></italic> order system of the most dangerous mode (<xref ref-type="bibr" rid="b23-cin-02-329">Stephenson and Wollkind, 1995</xref>).</p><p>In (3.22), we are employing the notation <italic>&#x01e7d;</italic><italic><sub>jlmn</sub></italic> for the coefficient of each term in (3.22) of the form <inline-formula><mml:math id="M71"><mml:mrow><mml:msubsup><mml:mi>A</mml:mi><mml:mn>2</mml:mn><mml:mi>j</mml:mi></mml:msubsup></mml:mrow></mml:math></inline-formula> (<italic>t)</italic> <inline-formula><mml:math id="M72"><mml:mrow><mml:msubsup><mml:mi>B</mml:mi><mml:mn>2</mml:mn><mml:mi>l</mml:mi></mml:msubsup></mml:mrow></mml:math></inline-formula> (<italic>t</italic>) cos (<inline-formula><mml:math id="M73"><mml:mfrac><mml:mrow><mml:mi>m</mml:mi><mml:msub><mml:mi>q</mml:mi><mml:mi>c</mml:mi></mml:msub><mml:mi>x</mml:mi></mml:mrow><mml:mn>2</mml:mn></mml:mfrac></mml:math></inline-formula>) cos (<inline-formula><mml:math id="M74"><mml:mfrac><mml:mrow><mml:mi>n</mml:mi><mml:msqrt><mml:mn>3</mml:mn></mml:msqrt><mml:msub><mml:mi>q</mml:mi><mml:mi>c</mml:mi></mml:msub><mml:mi>y</mml:mi></mml:mrow><mml:mn>2</mml:mn></mml:mfrac></mml:math></inline-formula>). Substituting this solution into (3.5) and proceeding in exactly the same manner as in the rhombic planform analysis, we again obtain a sequence of vector systems, each of which corresponds to one of these terms. In particular, the first order system which corresponds to <italic>j</italic> = <italic>m</italic> = 1<italic>,l</italic> = <italic>n</italic> = 0 is<disp-formula id="FD40"><label>(3.25)</label><mml:math id="M75"><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mtable><mml:mtr><mml:mtd><mml:mi>&#x003c3;</mml:mi></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mi>&#x003c3;</mml:mi></mml:mtd></mml:mtr></mml:mtable></mml:mrow><mml:mo>)</mml:mo></mml:mrow><mml:mo>=</mml:mo><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mtable><mml:mtr><mml:mtd><mml:mrow><mml:msub><mml:mi>f</mml:mi><mml:mn>1</mml:mn></mml:msub></mml:mrow></mml:mtd><mml:mtd><mml:mrow><mml:msub><mml:mi>f</mml:mi><mml:mn>2</mml:mn></mml:msub></mml:mrow></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mrow><mml:msub><mml:mi>g</mml:mi><mml:mn>1</mml:mn></mml:msub></mml:mrow></mml:mtd><mml:mtd><mml:mrow><mml:msub><mml:mi>g</mml:mi><mml:mn>2</mml:mn></mml:msub></mml:mrow></mml:mtd></mml:mtr></mml:mtable></mml:mrow><mml:mo>)</mml:mo></mml:mrow><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mtable><mml:mtr><mml:mtd><mml:mn>1</mml:mn></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mn>1</mml:mn></mml:mtd></mml:mtr></mml:mtable></mml:mrow><mml:mo>)</mml:mo></mml:mrow><mml:mo>+</mml:mo><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mtable><mml:mtr><mml:mtd><mml:mn>0</mml:mn></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mrow><mml:mo>&#x02212;</mml:mo><mml:mi>&#x003bc;</mml:mi><mml:msubsup><mml:mi>q</mml:mi><mml:mi>c</mml:mi><mml:mn>2</mml:mn></mml:msubsup></mml:mrow></mml:mtd></mml:mtr></mml:mtable></mml:mrow><mml:mo>)</mml:mo></mml:mrow></mml:math></disp-formula>Hence, <italic>&#x003c3;</italic> = <italic>g</italic><sub>1</sub> + <italic>g</italic><sub>2</sub> &#x02212; <inline-formula><mml:math id="M76"><mml:mi>&#x003bc;</mml:mi><mml:msubsup><mml:mi>q</mml:mi><mml:mi>c</mml:mi><mml:mn>2</mml:mn></mml:msubsup></mml:math></inline-formula> = <italic>&#x003c3;</italic><sub>0</sub>, and <italic>&#x003bc;</italic> = <inline-formula><mml:math id="M77"><mml:mfrac><mml:mn>1</mml:mn><mml:mrow><mml:msubsup><mml:mi>q</mml:mi><mml:mi>c</mml:mi><mml:mn>2</mml:mn></mml:msubsup></mml:mrow></mml:mfrac></mml:math></inline-formula>(<italic>g</italic><sub>1</sub> <italic>+ g</italic><sub>2</sub> &#x02013; <italic>f</italic><sub>1</sub> &#x02013; <italic>f</italic><sub>2</sub>).</p><p>There are eight second-order systems, two of which contain the Landau constant <italic>&#x003b1;</italic><sub>0</sub>. We can write one of them as<disp-formula id="FD41"><label>(3.26)</label><mml:math id="M78"><mml:msub><mml:mi>M</mml:mi><mml:mn>1</mml:mn></mml:msub><mml:msub><mml:mover accent="true"><mml:mi>v</mml:mi><mml:mo>&#x002dc;</mml:mo></mml:mover><mml:mrow><mml:mn>0220</mml:mn></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:msub><mml:mi>&#x003b1;</mml:mi><mml:mn>0</mml:mn></mml:msub><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mtable><mml:mtr><mml:mtd><mml:mn>1</mml:mn></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mn>1</mml:mn></mml:mtd></mml:mtr></mml:mtable></mml:mrow><mml:mo>)</mml:mo></mml:mrow><mml:mo>+</mml:mo><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mtable><mml:mtr><mml:mtd><mml:mn>0</mml:mn></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mrow><mml:mfrac><mml:mn>1</mml:mn><mml:mn>4</mml:mn></mml:mfrac><mml:mo stretchy="false">(</mml:mo><mml:msub><mml:mi>g</mml:mi><mml:mn>3</mml:mn></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mi>g</mml:mi><mml:mn>4</mml:mn></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mi>g</mml:mi><mml:mn>5</mml:mn></mml:msub><mml:mo stretchy="false">)</mml:mo></mml:mrow></mml:mtd></mml:mtr></mml:mtable></mml:mrow><mml:mo>)</mml:mo></mml:mrow></mml:math></disp-formula>where<disp-formula id="FD42"><label>(3.27)</label><mml:math id="M79"><mml:mtable columnalign="left"><mml:mtr><mml:mtd><mml:msub><mml:mi>M</mml:mi><mml:mn>1</mml:mn></mml:msub><mml:mo>&#x02261;</mml:mo><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mtable><mml:mtr><mml:mtd><mml:mrow><mml:mn>2</mml:mn><mml:msub><mml:mi>&#x003c3;</mml:mi><mml:mn>0</mml:mn></mml:msub><mml:mo>&#x02212;</mml:mo><mml:msub><mml:mi>f</mml:mi><mml:mn>1</mml:mn></mml:msub></mml:mrow></mml:mtd><mml:mtd><mml:mrow><mml:mo>&#x02212;</mml:mo><mml:msub><mml:mi>f</mml:mi><mml:mn>2</mml:mn></mml:msub></mml:mrow></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mrow><mml:mo>&#x02212;</mml:mo><mml:msub><mml:mi>g</mml:mi><mml:mn>1</mml:mn></mml:msub></mml:mrow></mml:mtd><mml:mtd><mml:mrow><mml:mn>2</mml:mn><mml:msub><mml:mi>&#x003c3;</mml:mi><mml:mn>0</mml:mn></mml:msub><mml:mo>&#x02212;</mml:mo><mml:msub><mml:mi>g</mml:mi><mml:mn>2</mml:mn></mml:msub><mml:mo>+</mml:mo><mml:mi>&#x003bc;</mml:mi><mml:msubsup><mml:mi>q</mml:mi><mml:mi>c</mml:mi><mml:mn>2</mml:mn></mml:msubsup></mml:mrow></mml:mtd></mml:mtr></mml:mtable></mml:mrow><mml:mo>)</mml:mo></mml:mrow></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mo>=</mml:mo><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mtable><mml:mtr><mml:mtd><mml:mrow><mml:msub><mml:mi>&#x003c3;</mml:mi><mml:mn>0</mml:mn></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mi>f</mml:mi><mml:mn>2</mml:mn></mml:msub></mml:mrow></mml:mtd><mml:mtd><mml:mrow><mml:mo>&#x02212;</mml:mo><mml:msub><mml:mi>f</mml:mi><mml:mn>2</mml:mn></mml:msub></mml:mrow></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mrow><mml:mo>&#x02212;</mml:mo><mml:msub><mml:mi>g</mml:mi><mml:mn>1</mml:mn></mml:msub></mml:mrow></mml:mtd><mml:mtd><mml:mrow><mml:msub><mml:mi>&#x003c3;</mml:mi><mml:mn>0</mml:mn></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mi>g</mml:mi><mml:mn>1</mml:mn></mml:msub></mml:mrow></mml:mtd></mml:mtr></mml:mtable></mml:mrow><mml:mo>)</mml:mo></mml:mrow></mml:mtd></mml:mtr></mml:mtable></mml:math></disp-formula>Considering the adjoint linear eigenvalue problem of (3.27):<disp-formula id="FD43"><label>(3.28)</label><mml:math id="M80"><mml:msubsup><mml:mi>M</mml:mi><mml:mn>1</mml:mn><mml:mi>T</mml:mi></mml:msubsup><mml:msubsup><mml:mover accent="true"><mml:mi>v</mml:mi><mml:mo>&#x002dc;</mml:mo></mml:mover><mml:mn>1</mml:mn><mml:mo>*</mml:mo></mml:msubsup><mml:mo>=</mml:mo><mml:msubsup><mml:mi>&#x003c3;</mml:mi><mml:mn>1</mml:mn><mml:mo>*</mml:mo></mml:msubsup><mml:msubsup><mml:mover accent="true"><mml:mi>v</mml:mi><mml:mo>&#x002dc;</mml:mo></mml:mover><mml:mn>1</mml:mn><mml:mo>*</mml:mo></mml:msubsup></mml:math></disp-formula>where <inline-formula><mml:math id="M81"><mml:msubsup><mml:mi>&#x003c3;</mml:mi><mml:mn>1</mml:mn><mml:mo>*</mml:mo></mml:msubsup></mml:math></inline-formula> = <italic>&#x003c3;</italic><sub>0</sub> is an eigenvalue of <italic>M</italic><sub>1</sub> and <inline-formula><mml:math id="M82"><mml:msubsup><mml:mi>M</mml:mi><mml:mn>1</mml:mn><mml:mi>T</mml:mi></mml:msubsup></mml:math></inline-formula>, we obtain <inline-formula><mml:math id="M83"><mml:msubsup><mml:mover accent="true"><mml:mi>v</mml:mi><mml:mo>&#x002dc;</mml:mo></mml:mover><mml:mn>1</mml:mn><mml:mo>*</mml:mo></mml:msubsup><mml:mo>=</mml:mo><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mtable><mml:mtr><mml:mtd><mml:mrow><mml:msub><mml:mi>g</mml:mi><mml:mn>1</mml:mn></mml:msub></mml:mrow></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mrow><mml:msub><mml:mi>f</mml:mi><mml:mn>2</mml:mn></mml:msub></mml:mrow></mml:mtd></mml:mtr></mml:mtable></mml:mrow><mml:mo>)</mml:mo></mml:mrow></mml:math></inline-formula>. By taking inner products of (3.26) with <inline-formula><mml:math id="M84"><mml:msubsup><mml:mover accent="true"><mml:mi>v</mml:mi><mml:mo>&#x002dc;</mml:mo></mml:mover><mml:mn>1</mml:mn><mml:mo>*</mml:mo></mml:msubsup></mml:math></inline-formula>, we find, upon making use of the adjoint property, that<disp-formula id="FD44"><label>(3.29)</label><mml:math id="M85"><mml:mtable columnalign="left"><mml:mtr><mml:mtd><mml:msub><mml:mi>&#x003c3;</mml:mi><mml:mn>0</mml:mn></mml:msub><mml:msub><mml:mover accent="true"><mml:mi>v</mml:mi><mml:mo>&#x002dc;</mml:mo></mml:mover><mml:mrow><mml:mn>0220</mml:mn></mml:mrow></mml:msub><mml:mo>&#x022c5;</mml:mo><mml:msubsup><mml:mover accent="true"><mml:mi>v</mml:mi><mml:mo>&#x002dc;</mml:mo></mml:mover><mml:mn>1</mml:mn><mml:mo>*</mml:mo></mml:msubsup><mml:mo>=</mml:mo><mml:msub><mml:mi>&#x003b1;</mml:mi><mml:mn>0</mml:mn></mml:msub><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mtable><mml:mtr><mml:mtd><mml:mn>1</mml:mn></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mn>1</mml:mn></mml:mtd></mml:mtr></mml:mtable></mml:mrow><mml:mo>)</mml:mo></mml:mrow><mml:mo>&#x022c5;</mml:mo><mml:msubsup><mml:mover accent="true"><mml:mi>v</mml:mi><mml:mo>&#x002dc;</mml:mo></mml:mover><mml:mn>1</mml:mn><mml:mo>*</mml:mo></mml:msubsup></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mo>+</mml:mo><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mtable><mml:mtr><mml:mtd><mml:mn>0</mml:mn></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mrow><mml:mfrac><mml:mn>1</mml:mn><mml:mn>4</mml:mn></mml:mfrac><mml:mo stretchy="false">(</mml:mo><mml:msub><mml:mi>g</mml:mi><mml:mn>3</mml:mn></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mi>g</mml:mi><mml:mn>4</mml:mn></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mi>g</mml:mi><mml:mn>5</mml:mn></mml:msub><mml:mo stretchy="false">)</mml:mo></mml:mrow></mml:mtd></mml:mtr></mml:mtable></mml:mrow><mml:mo>)</mml:mo></mml:mrow><mml:mo>&#x022c5;</mml:mo><mml:msubsup><mml:mover accent="true"><mml:mi>v</mml:mi><mml:mo>&#x002dc;</mml:mo></mml:mover><mml:mn>1</mml:mn><mml:mo>*</mml:mo></mml:msubsup></mml:mtd></mml:mtr></mml:mtable></mml:math></disp-formula>Then, taking the limit as <italic>&#x003c3;</italic><sub>0</sub> &#x02192; 0 we obtain<disp-formula id="FD45"><label>(3.30)</label><mml:math id="M86"><mml:msub><mml:mi>&#x003b1;</mml:mi><mml:mn>0</mml:mn></mml:msub><mml:mo>=</mml:mo><mml:mo>&#x02212;</mml:mo><mml:mfrac><mml:mrow><mml:msub><mml:mi>f</mml:mi><mml:mn>2</mml:mn></mml:msub></mml:mrow><mml:mrow><mml:mn>4</mml:mn><mml:mo stretchy="false">(</mml:mo><mml:msub><mml:mi>g</mml:mi><mml:mn>1</mml:mn></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mi>f</mml:mi><mml:mn>2</mml:mn></mml:msub><mml:mo stretchy="false">)</mml:mo></mml:mrow></mml:mfrac><mml:mo stretchy="false">(</mml:mo><mml:msub><mml:mi>g</mml:mi><mml:mn>3</mml:mn></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mi>g</mml:mi><mml:mn>4</mml:mn></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mi>g</mml:mi><mml:mn>5</mml:mn></mml:msub><mml:mo stretchy="false">)</mml:mo></mml:math></disp-formula></p><p>The other six second-order systems can be solved in a straight forward manner, yielding solutions as follows:<disp-formula><mml:math id="M87"><mml:mtable columnalign="left"><mml:mtr><mml:mtd><mml:msub><mml:mi>i</mml:mi><mml:mrow><mml:mn>2000</mml:mn></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:mo>&#x02212;</mml:mo><mml:mfrac><mml:mrow><mml:mfrac><mml:mn>1</mml:mn><mml:mn>2</mml:mn></mml:mfrac><mml:msub><mml:mi>g</mml:mi><mml:mn>3</mml:mn></mml:msub><mml:mo>+</mml:mo><mml:mfrac><mml:mn>1</mml:mn><mml:mn>2</mml:mn></mml:mfrac><mml:msub><mml:mi