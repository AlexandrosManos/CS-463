id="b8-wjem-9-0118"><label>8</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chowdhury</surname><given-names>FU</given-names></name><name><surname>Kotwal</surname><given-names>S</given-names></name><name><surname>Raghunathan</surname><given-names>G</given-names></name><name><surname>Wah</surname><given-names>TM</given-names></name><name><surname>Joyce</surname><given-names>A</given-names></name><name><surname>Irving</surname><given-names>HC</given-names></name></person-group><article-title>Unenhanced multidetector CT (CT KUB) in the initial imaging of suspected acute renal colic: evaluating a new service</article-title><source>Clinical Radiology</source><year>2007</year><volume>62</volume><fpage>970</fpage><lpage>977</lpage><pub-id pub-id-type="pmid">17765462</pub-id></mixed-citation></ref></ref-list></back></article>