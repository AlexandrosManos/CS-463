="char" valign="top" char="." charoff="50">&#x02014;</td><td align="char" valign="top" char="." charoff="50">ND</td><td align="char" valign="top" char="." charoff="50">&#x02014;</td></tr><tr><td align="left" valign="top" charoff="50">Prostate epithelial cells</td><td align="left" valign="top" charoff="50">PrECs (normal)</td><td align="char" valign="top" char="." charoff="50">ND</td><td align="char" valign="top" char="." charoff="50">&#x02014;</td><td align="char" valign="top" char="." charoff="50">ND</td><td align="char" valign="top" char="." charoff="50">&#x02014;</td></tr><tr><td align="left" valign="top" charoff="50">Prostate stromal cells</td><td align="left" valign="top" charoff="50">PrSCs (normal)</td><td align="char" valign="top" char="." charoff="50">ND</td><td align="char" valign="top" char="." charoff="50">&#x02014;</td><td align="char" valign="top" char="." charoff="50">ND</td><td align="char" valign="top" char="." charoff="50">&#x02014;</td></tr><tr><td align="left" valign="top" charoff="50">Peripheral blood mononuclear cells</td><td align="left" valign="top" charoff="50">PBMCs (normal)</td><td align="char" valign="top" char="." charoff="50">ND</td><td align="char" valign="top" char="." charoff="50">&#x02014;</td><td align="char" valign="top" char="." charoff="50">ND</td><td align="char" valign="top" char="." charoff="50">&#x02014;</td></tr><tr><td align="left" valign="top" charoff="50">Media control</td><td align="left" valign="top" charoff="50">Media control</td><td align="char" valign="top" char="." charoff="50">ND</td><td align="char" valign="top" char="." charoff="50">&#x02014;</td><td align="char" valign="top" char="." charoff="50">ND</td><td align="char" valign="top" char="." charoff="50">&#x02014;</td></tr><tr><td align="left" valign="top" charoff="50">Spiked media control</td><td align="left" valign="top" charoff="50">0.1&#x00025; lysed cells</td><td align="char" valign="top" char="." charoff="50">ND</td><td align="char" valign="top" char="." charoff="50">&#x02014;</td><td align="char" valign="top" char="." charoff="50">3.2</td><td align="char" valign="top" char="." charoff="50">0.7</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">1.0&#x00025; lysed cells</td><td align="char" valign="top" char="." charoff="50">77.6</td><td align="char" valign="top" char="." charoff="50">1.1</td><td align="char" valign="top" char="." charoff="50">121.9</td><td align="char" valign="top" char="." charoff="50">2.0</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">10&#x00025; lysed cells</td><td align="char" valign="top" char="." charoff="50">259.7</td><td align="char" valign="top" char="." charoff="50">8.3</td><td align="char" valign="top" char="." charoff="50">596.1</td><td align="char" valign="top" char="." charoff="50">37.0</td></tr></tbody></table><table-wrap-foot><fn id="t1-fn1"><label/><p>ND=none detected.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>