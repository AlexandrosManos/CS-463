></name><name><surname>Kim</surname><given-names>RW</given-names></name><name><surname>Altieri</surname><given-names>DC</given-names></name></person-group><article-title>Cancer gene therapy using a survivin mutant adenovirus</article-title><source>J Clin Invest</source><year>2001</year><volume>108</volume><fpage>981</fpage><lpage>990</lpage><!--PubMed citation query: 'J Clin Invest||108|981||bib29|'--><pub-id pub-id-type="pmid">11581299</pub-id></citation></ref><ref id="bib30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>O'Connor</surname><given-names>DS</given-names></name><name><surname>Grossman</surname><given-names>D</given-names></name><name><surname>Plescia</surname><given-names>J</given-names></name><name><surname>Li</surname><given-names>F</given-names></name><name><surname>Zhang</surname><given-names>H</given-names></name><name><surname>Villa</surname><given-names>A</given-names></name><name><surname>Tognin</surname><given-names>S</given-names></name><name><surname>Marchisio</surname><given-names>PC</given-names></name><name><surname>Altieri</surname><given-names>DC</given-names></name></person-group><article-title>Regulation of apoptosis at cell division by p34cdc2 phosphorylation of survivin</article-title><source>Proc Natl Acad Sci USA</source><year>2000</year><volume>97</volume><fpage>13103</fpage><lpage>13107</lpage><!--PubMed citation query: 'Proc Natl Acad Sci USA||97|13103||bib30|'--></citation></ref><ref id="bib31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>O&#x02032;Connor</surname><given-names>DS</given-names></name><name><surname>Wall</surname><given-names>NR</given-names></name><name><surname>Porter</surname><given-names>AC</given-names></name><name><surname>Altieri</surname><given-names>DC</given-names></name></person-group><article-title>A p34(cdc2) survival checkpoint in cancer</article-title><source>Cancer Cell</source><year>2002</year><volume>2</vol