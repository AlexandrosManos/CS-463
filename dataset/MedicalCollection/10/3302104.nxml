n-names></name><name><surname>Dubois</surname><given-names>RN</given-names></name></person-group><article-title>Up-regulation of cyclooxygenase 2 gene expression in human colorectal adenomas and adenocarcinomas</article-title><source><italic>Gastroenterology</italic></source><year>1994</year><volume>107</volume><issue>4</issue><fpage>1183</fpage><lpage>1188</lpage><pub-id pub-id-type="pmid">7926468</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>A</given-names></name><name><surname>Varney</surname><given-names>ML</given-names></name><name><surname>Singh</surname><given-names>RK</given-names></name></person-group><article-title>Expression of interleukin 8 and its receptors in human colon carcinoma cells with different metastatic potentials</article-title><source><italic>Clinical Cancer Research</italic></source><year>2001</year><volume>7</volume><issue>10</issue><fpage>3298</fpage><lpage>3304</lpage><pub-id pub-id-type="pmid">11595728</pub-id></element-citation></ref><ref id="B16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Williams</surname><given-names>NS</given-names></name><name><surname>Gaynor</surname><given-names>RB</given-names></name><name><surname>Scoggin</surname><given-names>S</given-names></name><etal/></person-group><article-title>Identification and validation of genes involved in the pathogenesis of colorectal cancer using cDNA microarrays and RNA interference</article-title><source><italic>Clinical Cancer Research</italic></source><year>2003</year><volume>9</volume><issue>3</issue><fpage>931</fpage><lpage>946</lpage><pub-id pub-id-type="pmid">12631590</pub-id></element-citation></ref><ref id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Polley</surname><given-nam