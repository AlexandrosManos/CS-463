erson-group person-group-type="author"><name><surname>Park</surname><given-names>HJ</given-names></name><name><surname>Shaukat</surname><given-names>S</given-names></name><name><surname>Liu</surname><given-names>XZ</given-names></name><name><surname>Hahn</surname><given-names>SH</given-names></name><name><surname>Naz</surname><given-names>S</given-names></name><name><surname>Ghosh</surname><given-names>M</given-names></name><etal/></person-group><article-title>Origins and frequencies of SLC26A4 (PDS) mutations in east and south Asians: global implications for the epidemiology of deafness</article-title><source>J Med Genet</source><year>2003</year><month>4</month><volume>40</volume><issue>4</issue><fpage>242</fpage><lpage>248</lpage><pub-id pub-id-type="pmid">12676893</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Yan</surname><given-names>D</given-names></name><name><surname>Park</surname><given-names>HJ</given-names></name><name><surname>Ouyang</surname><given-names>XM</given-names></name><name><surname>Pandya</surname><given-names>A</given-names></name><name><surname>Doi</surname><given-names>K</given-names></name><name><surname>Erdenetungalag</surname><given-names>R</given-names></name><etal/></person-group><article-title>Evidence of a founder effect for the 235delC mutation of GJB2 (connexin 26) in east Asians</article-title><source>Hum Genet</source><year>2003</year><month>12</month><volume>114</volume><issue>1</issue><fpage>44</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">14505035</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bae</surname><given-names>JW</given-names></name><name><surname>Lee</surname><given-names>KY</given-names></name><name><surname>Choi</surname><given-names>SY</given-names></name><name><surname>Lee</surnam