rnal"><person-group person-group-type="author"><name><surname>Landry</surname><given-names>GJ</given-names></name><name><surname>Mistlberger</surname><given-names>RE</given-names></name></person-group><article-title>Food entrainment: methodological issues</article-title><source>J Biol Rhythms</source><year>2007</year><volume>22</volume><fpage>484</fpage><lpage>487</lpage><pub-id pub-id-type="pmid">18057323</pub-id><pub-id pub-id-type="doi">10.1177/0748730407307811</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smirnov</surname><given-names>MS</given-names></name><name><surname>Kiyatkin</surname><given-names>EA</given-names></name></person-group><article-title>Fluctuations in central and peripheral temperatures associated with feeding behavior in rats</article-title><source>Am J Physiol Regul Integr Comp Physiol</source><year>2008</year><volume>295</volume><fpage>R1415</fpage><lpage>1424</lpage><pub-id pub-id-type="pmid">18799633</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Feillet</surname><given-names>CA</given-names></name><name><surname>Ripperger</surname><given-names>JA</given-names></name><name><surname>Magnone</surname><given-names>MC</given-names></name><name><surname>Dulloo</surname><given-names>A</given-names></name><name><surname>Albrecht</surname><given-names>U</given-names></name><name><surname>Challet</surname><given-names>E</given-names></name></person-group><article-title>Lack of food anticipation in Per2 mutant mice</article-title><source>Curr Biol</source><year>2006</year><volume>16</volume><fpage>2016</fpage><lpage>2022</lpage><pub-id pub-id-type="pmid">17055980</pub-id><pub-id pub-id-type="doi">10.1016/j.cub.2006.08.053</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Abe</surname><given-names>H</given-nam