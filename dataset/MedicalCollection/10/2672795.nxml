given-names>A</given-names></name><etal/></person-group><article-title>On the functional consequences of bronchial basement membrane thickening</article-title><source>J Appl Physiol</source><year>2001</year><volume>91</volume><issue>3</issue><fpage>1035</fpage><lpage>1040</lpage><pub-id pub-id-type="pmid">11509495</pub-id></mixed-citation></ref><ref id="b16-copd-4-127"><label>16</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Takizawa</surname><given-names>H</given-names></name><name><surname>Tanaka</surname><given-names>M</given-names></name><name><surname>Takami</surname><given-names>K</given-names></name><etal/></person-group><article-title>Increased expression of transforming growth factor-beta1 in small airway epithelium from tobacco smokers and patients with chronic obstructive pulmonary disease (COPD)</article-title><source>Am J Respir Crit Care Med</source><year>2001</year><volume>163</volume><issue>6</issue><fpage>1476</fpage><lpage>1483</lpage><pub-id pub-id-type="pmid">11371421</pub-id></mixed-citation></ref><ref id="b17-copd-4-127"><label>17</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chetta</surname><given-names>A</given-names></name><name><surname>Zanini</surname><given-names>A</given-names></name><name><surname>Foresi</surname><given-names>A</given-names></name><etal/></person-group><article-title>Vascular endothelial growth factor up-regulation and bronchial wall remodelling in asthma</article-title><source>Clin Exp Allergy</source><year>2005</year><volume>35</volume><issue>11</issue><fpage>1437</fpage><lpage>1442</lpage><pub-id pub-id-type="pmid">16297139</pub-id></mixed-citation></ref><ref id="b18-copd-4-127"><label>18</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ten Hacken</surname><given-names>NH</given-names></name><name><surname>Timens</surname><given-names>W</given-