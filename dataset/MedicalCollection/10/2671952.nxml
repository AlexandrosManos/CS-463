<given-names>DL</given-names></name><name><surname>Doggett</surname><given-names>JW</given-names></name><etal/></person-group><year>2005</year><article-title>Antidepressant medication use and restless legs syndrome in patients presenting with insomnia</article-title><source>Sleep Med</source><volume>6</volume><fpage>443</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">16084763</pub-id></citation></ref><ref id="b15-ndt-2-505"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Collado-Seidel</surname><given-names>V</given-names></name><name><surname>Kazenwadel</surname><given-names>J</given-names></name><name><surname>Wetter</surname><given-names>TC</given-names></name><etal/></person-group><year>1999</year><article-title>A controlled study of additional sr-L-dopa in L-dopa-responsive restless legs syndrome with late-night symptoms</article-title><source>Neurology</source><volume>52</volume><fpage>285</fpage><lpage>90</lpage><pub-id pub-id-type="pmid">9932945</pub-id></citation></ref><ref id="b16-ndt-2-505"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Connor</surname><given-names>JR</given-names></name><name><surname>Boyer</surname><given-names>PJ</given-names></name><name><surname>Menzies</surname><given-names>SL</given-names></name><etal/></person-group><year>2003</year><article-title>Neuropathological examination suggests impaired brain iron acquisition in restless legs syndrome</article-title><source>Neurology</source><volume>61</volume><fpage>304</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">12913188</pub-id></citation></ref><ref id="b17-ndt-2-505"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Corrigan</surname><given-names>MH</given-names></name><name><surname>Denahan</surname><given-names>AQ</given-names></name><name><surname>Wright</surname><given-names>CE</given-names></name><etal/></person-group><year>2000</year><article-title>Comparison of pramipexole, fluoxetine, and placebo in patients with major depression</article-title><source>Depress Anxiety</source><volume>11</volume><fpage>58</fpage><lpage>65</lpage><pub-id pub-id-type="pmid">10812530</pub-id></citation></ref><ref id="b18-ndt-2-505"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Desautels</surname><given-names>A</given-names></name><name><surname>Turecki</surname><given-names>G</given-names></name><name><surname>Montplaisir</surname><given-names>J</given-names></name><etal/></person-group><year>2002</year><article-title>Evidence for a genetic association between monoamine oxidase A and restless legs syndrome</article-title><source>Neurology</source><volume>59</volume><fpage>215</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">12136060</pub-id></citation></ref><ref id="b19-ndt-2-505"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Desautels</surname><given-names>A</given-names></name><name><surname>Turecki</surname><given-names>G</given-names></name><name><surname>Montplaisir</surname><given-names>J</given-names></name><etal/></person-group><year>2001</year><article-title>Dopaminergic neurotransmission and restless legs syndrome: a genetic association analysis</article-title><source>Neurology</source><volume>57</volume><fpage>1304</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">11591853</pub-id></citation></ref><ref id="b20-ndt-2-505"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ford</surname><given-names>DE</given-names></name><name><surname>Kamerow</surname><given-names>DB</given-names></name></person-group><year>1989</year><article-title>Epidemiologic study of sleep disturbances and psychiatric disorders. An opportunity for prevention?</article-title><source>JAMA</source><volume>262</volume><fpage>1479</fpage><lpage>84</lpage><pub-id pub-id-type="pmid">2769898</pub-id></citation></ref><ref id="b