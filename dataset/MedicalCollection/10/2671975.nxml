4/1/3"            >http://www.respiratory-research/content/4/1/3</ext-link>]<pub-id pub-id-type="pmid"            >12657158</pub-id></mixed-citation>      </ref>    </ref-list>  </back>  <floats-group>    <fig id="f1-02-oa-0178" position="float">      <label>Figure 1-</label>      <caption>        <p>Study design</p>      </caption>      <graphic xlink:href="02-oa-0178f1"/>    </fig>    <fig id="f2-02-oa-0178" position="float">      <label>Figure 2-</label>      <caption>        <p>Exhaled nitric oxide parts per billion (ENO ppb) measurements from healthy subjects          (control) and subjects with history of bronchospasm in intraoperative period (Bronchospasm          and Asthma). The boxplot shows the 25<sup>th</sup>, 50<sup>th</sup> and 75<sup>th</sup>          percentiles, with the extreme bars representing the 10<sup>th</sup> and 90<sup>th</sup>          percentiles. ENO (ppb) measure, *p = 0.001 compared with control and **p = 0.005 compared          with control.</p>      </caption>      <graphic xlink:href="02-oa-0178f2"/>    </fig>    <table-wrap id="t1-02-oa-0178" position="float">      <label>Table 1-</label>      <caption>        <p>Subject characteristics</p>      </caption>      <table frame="hsides" rules="groups">        <thead>          <tr>            <th align="left" rowspan="1" colspan="1">Group</th>            <th align="center" rowspan="1" colspan="1">Control (n=10)</th>            <th align="center" rowspan="1" colspan="1">Bronchospasm (n=9)</th>            <th align="center" rowspan="1" colspan="1">Asthma (n=12)</th>          </tr>        </thead>        <tbody>          <tr>            <td align="left" rowspan="1" colspan="1">Age Range, yr, Mean&#x000b1;SD</td>            <td align="center" rowspan="1" colspan="1">(39&#x02013;51) 41.90&#x000b1;3.54</td>            <td align="center" rowspan="1" colspan="1">(17&#x02013;60) 37.22&#x000b1;15.37</td>            <td align="center" rowspan="1" colspan="1">(19&#x02013;53)            30.33&#x000b1