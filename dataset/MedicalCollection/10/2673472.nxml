span="1" colspan="1"><italic>Signs and symptoms</italic></td><td rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Hypotension or  shock</td><td align="center" rowspan="1" colspan="1">24 (68.6%)</td></tr><tr><td align="left" rowspan="1" colspan="1">Abdominal pain</td><td align="center" rowspan="1" colspan="1">23 (65.7%)</td></tr><tr><td align="left" rowspan="1" colspan="1">Abdominal  distention</td><td align="center" rowspan="1" colspan="1">15 (42.8%)</td></tr><tr><td align="center" colspan="2" rowspan="1"><hr/></td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Diagnosis</italic></td><td rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Paracentesis</td><td align="center" rowspan="1" colspan="1">22 (62.8%)</td></tr><tr><td align="left" rowspan="1" colspan="1">Arteriography</td><td align="center" rowspan="1" colspan="1">6 (17.1%)</td></tr><tr><td align="center" colspan="2" rowspan="1"><hr/></td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Source  of bleeding*</italic></td><td rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Umbilical veins</td><td rowspan="1" colspan="1">7 (20%)</td></tr><tr><td align="left" rowspan="1" colspan="1">Retzius veins</td><td align="center" rowspan="1" colspan="1">6 (17.1%)</td></tr><tr><td align="left" rowspan="1" colspan="1">Retroperitoneal  varices</td><td align="center" rowspan="1" colspan="1">5 (14.3%)</td></tr><tr><td align="left" rowspan="1" colspan="1">Other  intraperitoneal sources</td><td align="center" rowspan="1" colspan="1">19 (54.2%)</td></tr><tr><td align="center" colspan="2" rowspan="1"><hr/></td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Treatment</italic><sup><italic>#</it