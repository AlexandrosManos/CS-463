><name><surname>Gruber</surname><given-names>J</given-names></name><name><surname>Zinman</surname><given-names>J</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Gruber J</surname></name></person-group><article-title>Youth smoking in the United States: evidence and implications</article-title><source>Risky Behavior Among Youth</source><year>2001</year><publisher-name>Chicago: University of Chicago Press</publisher-name><fpage>69</fpage><lpage>120</lpage></citation></ref><ref id="B22"><citation citation-type="other"><article-title>State law regarding sale of tobacco products to individuals under age of 18. 106 STAT. 394</article-title><source>Public Law 102&#x02013;321, July 10, Sec 1926 42 USC 300x-26</source><year>1992</year></citation></ref><ref id="B23"><citation citation-type="other"><person-group person-group-type="author"><collab>World Health Organization</collab></person-group><article-title>Framework Convention on Tobacco Control</article-title><ext-link ext-link-type="uri" xlink:href="http://www.who.int/fctc/en/"/></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Johnston</surname><given-names>L</given-names></name><name><surname>O'Malley</surname><given-names>P</given-names></name><name><surname>Bachman</surname><given-names>J</given-names></name><name><surname>Schulenberg</surname><given-names>J</given-names></name></person-group><source>Monitoring the Future: National survey results on drug use, 1975&#x02013;2007</source><year>2008</year><publisher-name>NIH Publication No. 08-6418A: National Institute on Drug Abuse, Bethesda, MD</publisher-name></citation></ref><ref id="B25"><citation citation-type="other"><person-group person-group-type="author"><collab>Health Canada</collab></person-group><article-title>Summary of Results of the 2004&#x02013;05 Youth Smoking Survey</article-title><year>2009</year><ext-link ext-link-type="uri" xlink:href="http://www.hc-sc.gc.ca/hl-vs/tobac-tabac/research-recherche/stat/index-eng.php"/></citation></ref><ref id="B26"><citation citation-type="other"><person-group person-group-type="author"><collab>Department of Health and Human Services</collab></person-group><article-title>45 CFR Part 96 Tobacco regulation for substance abuse prevention and treatment block grants; final rule</article-title><source>Federal Register</source><year>1996</year><fpage>1492</fpage><lpage>1509</lpage></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Radecki</surname><given-names>T</given-names></name><name><surname>Zdunich</surname><given-names>C</given-names></name></person-group><article-title>Tobacco sales to minors in 97 US and Canadian communities</article-title><source>Tobacco Control</source><year>1993</year><volume>2</volume><fpage>300</fpage><lpage>305</lpage><pub-id pub-id-type="doi">10.1136/tc.2.4.300</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>DiFranza</surname><given-names>J</given-names></name></person-group><article-title>Best practices for enforcing state laws prohibiting the sale of tobacco to minors</article-title><source>J Public Health Manag Pract</source><year>2005</year><volume>11</volume><fpage>559</fpage><lpage>565</lpage><pub-id pub-id-type="pmid">16224293</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>DiFranza</surname><given-names>JR</given-names></name><name><surname>Dussault</surname><given-names>GF</given-names></name></person-group><article-title>The federal initiative to halt the sale of tobacco to children &#x02013; the Synar Amendment, 1992&#x02013;2000: lessons learned</article-title><source>Tobacco Control</source><year>2005</year><volume>14</volume><fpage>93</fpage><lpage>98</lpage><pub-id pub-id-type="pmid">15791018</pub-id><pub