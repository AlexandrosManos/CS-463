rname>Conca</surname><given-names>P</given-names></name><etal/></person-group><article-title>Silent non-alcoholic fatty liver disease-a clinical-histological study</article-title><source><italic>Journal of Hepatology</italic></source><year>2004</year><volume>41</volume><issue>5</issue><fpage>751</fpage><lpage>757</lpage><pub-id pub-id-type="pmid">15519647</pub-id></citation></ref><ref id="B19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sutinen</surname><given-names>J</given-names></name><name><surname>H&#x000e4;kkinen</surname><given-names>A-M</given-names></name><name><surname>Westerbacka</surname><given-names>J</given-names></name><etal/></person-group><article-title>Increased fat accumulation in the liver in HIV-infected patients with antiretroviral therapy-associated lipodystrophy</article-title><source><italic>AIDS</italic></source><year>2002</year><volume>16</volume><issue>16</issue><fpage>2183</fpage><lpage>2193</lpage><pub-id pub-id-type="pmid">12409740</pub-id></citation></ref><ref id="B20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moreno-Torres</surname><given-names>A</given-names></name><name><surname>Domingo</surname><given-names>P</given-names></name><name><surname>Pujol</surname><given-names>J</given-names></name><name><surname>Blanco-Vaca</surname><given-names>F</given-names></name><name><surname>Arroyo</surname><given-names>JA</given-names></name><name><surname>Sambeat</surname><given-names>MA</given-names></name></person-group><article-title>Liver triglyceride content in HIV-1-infected patients on combination antiretroviral therapy studied with 1H-MR spectroscopy</article-title><source><italic>Antiviral Therapy</italic></source><year>2007</year><volume>12</volume><issue>2</issue><fpage>195</fpage><lpage>203</lpage><pub-id pub-id-type="pmid">17503662</pub-id></citation></ref><ref id="B21"><label>21</label><citation citation