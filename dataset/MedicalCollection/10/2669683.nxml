What is practical?</article-title><source>Am J Clin Pathol</source><year>1990</year><volume>94</volume><fpage>754</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">2244593</pub-id></citation></ref><ref id="CIT18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cocchi</surname><given-names>V</given-names></name><name><surname>Sintoni</surname><given-names>C</given-names></name><name><surname>Carretti</surname><given-names>D</given-names></name><name><surname>Sama</surname><given-names>D</given-names></name><name><surname>Chiari</surname><given-names>U</given-names></name><name><surname>Segala</surname><given-names>V</given-names></name><etal/></person-group><article-title>External quality assurance in cervical/vaginal cytology: Interlaboratory agreement in the Emilia-Romagna region of Italy</article-title><source>Acta Cytol</source><year>1996</year><volume>40</volume><fpage>480</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">8669183</pub-id></citation></ref><ref id="CIT19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Salvetto</surname><given-names>M</given-names></name><name><surname>Sandiford</surname><given-names>P</given-names></name></person-group><article-title>External quality assurance for cervical cytology in developing countries: Experience in Peru and Nicaragua</article-title><source>Acta Cytol</source><year>2004</year><volume>48</volume><fpage>23</fpage><lpage>31</lpage><pub-id pub-id-type="pmid">14969177</pub-id></citation></ref><ref id="CIT20"><label>20</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cowan</surname><given-names>DF</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Cowan</surname><given-names>DF</given-names></name></person-group><article-title>Security and confidentiality on laboratory computer systems</article-title><source>Informatics for the Clinical Laboratory</source><year>2005</year><publisher-loc>New York</publisher-loc><publisher-name>Springer</publisher-name><fpage>59</fpage><lpage>86</lpage></citation></ref><ref id="CIT21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Solomon</surname><given-names>D</given-names></name><name><surname>Davey</surname><given-names>D</given-names></name><name><surname>Kurman</surname><given-names>R</given-names></name><name><surname>Moriarty</surname><given-names>A</given-names></name><name><surname>O'Connor</surname><given-names>D</given-names></name><name><surname>Prey</surname><given-names>M</given-names></name><etal/></person-group><article-title>The 2001 Bethesda System: Terminology for reporting results of cervical cytology</article-title><source>JAMA</source><year>2002</year><volume>287</volume><fpage>2114</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">11966386</pub-id></citation></ref><ref id="CIT22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Denton</surname><given-names>KJ</given-names></name><name><surname>Herbert</surname><given-names>A</given-names></name><name><surname>Turnbull</surname><given-names>LS</given-names></name><name><surname>Waddell</surname><given-names>C</given-names></name><name><surname>Desai</surname><given-names>MS</given-names></name><name><surname>Rana</surname><given-names>DN</given-names></name><etal/></person-group><article-title>The revised BSCC terminology for abnormal cervical cytology</article-title><source>Cytopathology</source><year>2008</year><volume>19</volume><fpage>137</fpage><lpage>57</lpage><pub-id pub-id-type="pmid">18494998</pub-id></citation></ref><ref id="CIT23"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Herbert</surname><given-names>A</given-names></name><name><surname>Bergeron</surname><given-names>C</given-names