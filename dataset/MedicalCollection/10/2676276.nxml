ge><pub-id pub-id-type="pmid">18591931</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Byrski</surname><given-names>T</given-names></name><name><surname>Gronwald</surname><given-names>J</given-names></name><name><surname>Huzarski</surname><given-names>T</given-names></name><name><surname>Grzybowska</surname><given-names>E</given-names></name><name><surname>Budryk</surname><given-names>M</given-names></name><name><surname>Stawicka</surname><given-names>M</given-names></name><name><surname>Mierzwa</surname><given-names>T</given-names></name><name><surname>Szwiec</surname><given-names>M</given-names></name><name><surname>Wi&#x0015b;niowski</surname><given-names>R</given-names></name><name><surname>Siolek</surname><given-names>M</given-names></name><name><surname>Narod</surname><given-names>SA</given-names></name><name><surname>Lubinski</surname><given-names>J</given-names></name><collab>Polish Hereditary Breast Cancer Consortium</collab></person-group><article-title>Response to neo-adjuvant chemotherapy in women with BRCA1-positive breast cancers</article-title><source>Breast Cancer Res Treat</source><year>2008</year><volume>108</volume><fpage>289</fpage><lpage>296</lpage><pub-id pub-id-type="pmid">17492376</pub-id><pub-id pub-id-type="doi">10.1007/s10549-007-9600-1</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferla</surname><given-names>R</given-names></name><name><surname>Cal&#x000f2;</surname><given-names>V</given-names></name><name><surname>Cascio</surname><given-names>S</given-names></name><name><surname>Rinaldi</surname><given-names>G</given-names></name><name><surname>Badalamenti</surname><given-names>G</given-names></name><name><surname>Carreca</surname><given-names>I</given-names></name><name><surname>Surmacz</surname><given-names>E</given-names></name><name><surname>Colucci</surname><given-names>G</given-names></name><name><surname>Bazan</surname><given-names>V</given-names></name><name><surname>Russo</surname><given-names>A</given-names></name></person-group><article-title>Founder mutations in BRCA1 and BRCA2 genes</article-title><source>Ann Oncol</source><year>2007</year><volume>18</volume><issue>Suppl 6</issue><fpage>vi93</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">17591843</pub-id><pub-id pub-id-type="doi">10.1093/annonc/mdm234</pub-id></citation></ref></ref-list></back></article>