citation citation-type="journal"><person-group person-group-type="author"><name><surname>Horwitz</surname><given-names>J</given-names></name></person-group><article-title>The function of alpha-crystallin in vision</article-title><source>Semin. Cell Dev. Biol</source><year>2000</year><volume>11</volume><fpage>53</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">10736264</pub-id></citation></ref><ref id="b11-ijms-10-01314"><label>11.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>K</given-names></name><name><surname>Spector</surname><given-names>A</given-names></name></person-group><article-title>The chaperone activity of bovine alpha crystallin. Interaction with other lens crystallins in native and denatured states</article-title><source>J. Biol Chem</source><year>1994</year><volume>269</volume><fpage>13601</fpage><lpage>13608</lpage><pub-id pub-id-type="pmid">7909809</pub-id></citation></ref><ref id="b12-ijms-10-01314"><label>12.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Van Montfort</surname><given-names>R</given-names></name><name><surname>Slingsby</surname><given-names>C</given-names></name><name><surname>Vierling</surname><given-names>E</given-names></name></person-group><article-title>Structure and function of the small heat shock protein/alpha-crystallin family of molecular chaperones</article-title><source>Adv. Protein Chem</source><year>2001</year><volume>59</volume><fpage>105</fpage><lpage>156</lpage><pub-id pub-id-type="pmid">11868270</pub-id></citation></ref><ref id="b13-ijms-10-01314"><label>13.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carver</surname><given-names>JA</given-names></name><name><surname>Lindner</surname><given-names>RA</given-names></name><name><surname>Lyon</surname><given-names>C</given-names></name><name><surname>Canet</surname><given-names>D</given-names></name><name><surname>Hernandez</surname><given-names>H</given-names></name><name><surname>Dobson</surname><given-names>CM</given-names></name><name><surname>Redfield</surname><given-names>C</given-names></name></person-group><article-title>The interaction of the molecular chaperone alpha-crystallin with unfolding alpha-lactalbumin: a structural and kinetic spectroscopic study</article-title><source>J. Mol Biol</source><year>2002</year><volume>318</volume><fpage>815</fpage><lpage>827</lpage><pub-id pub-id-type="pmid">12054825</pub-id></citation></ref><ref id="b14-ijms-10-01314"><label>14.</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Markossian</surname><given-names>KA</given-names></name><name><surname>Kurganov</surname><given-names>BI</given-names></name><name><surname>Levitsky</surname><given-names>DI</given-names></name><name><surname>Khanova</surname><given-names>HA</given-names></name><name><surname>Chebotareva</surname><given-names>NA</given-names></name><name><surname>Samoilov</surname><given-names>AM</given-names></name><name><surname>Eronina</surname><given-names>TB</given-names></name><name><surname>Fedurkina</surname><given-names>NV</given-names></name><name><surname>Mitskevich</surname><given-names>LG</given-names></name><name><surname>Merem&#x02019;yanin</surname><given-names>AV</given-names></name><name><surname>Kleymenov</surname><given-names>SY</given-names></name><name><surname>Makeeva</surname><given-names>VF</given-names></name><name><surname>Muronets</surname><given-names>VI</given-names></name><name><surname>Naletova</surname><given-names>IN</given-names></name><name><surname>Shalova</surname><given-names>IN</given-names></name><name><surname>Asryants</surname><given-names>RA</given-names></name><name><surname>Schmalhausen</surname><given-names>EV</given-names></name><name><surname>Saso</surname><given-names>L</given-names></name><name><surname>Panyukov</surname><given-names>YV</given-names><