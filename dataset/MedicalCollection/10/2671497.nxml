d="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cunningham</surname><given-names>AL</given-names></name><name><surname>Lee</surname><given-names>FK</given-names></name><name><surname>Ho</surname><given-names>DW</given-names></name><name><surname>Field</surname><given-names>PR</given-names></name><name><surname>Law</surname><given-names>CL</given-names></name><name><surname>Packham</surname><given-names>DR</given-names></name><name><surname>McCrossin</surname><given-names>ID</given-names></name><name><surname>Sj&#x000f6;gren-Jansson</surname><given-names>E</given-names></name><name><surname>Jeansson</surname><given-names>S</given-names></name><name><surname>Nahmias</surname><given-names>AJ</given-names></name></person-group><article-title>Herpes simplex virus type 2 antibody in patients attending antenatal or STD clinics</article-title><source>Med J Aust</source><year>1993</year><volume>158</volume><fpage>525</fpage><lpage>528</lpage><pub-id pub-id-type="pmid">8387628</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>JS</given-names></name><name><surname>Robinson</surname><given-names>NJ</given-names></name></person-group><article-title>Age-specific prevalence of infection with herpes simplex virus type 2 and 1: a global review</article-title><source>J Infect Dis</source><year>2002</year><volume>186</volume><fpage>S3</fpage><lpage>S8</lpage><pub-id pub-id-type="pmid">12353183</pub-id><pub-id pub-id-type="doi">10.1086/343739</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Suligoi</surname><given-names>B</given-names></name><name><surname>Cusan</surname><given-names>M</given-names></name><name><surname>Santopadre</surname><given-names>P</given-names></name><name><surname>Pal&#x000f9;</surname><given-names>G</given-names></name><name><s