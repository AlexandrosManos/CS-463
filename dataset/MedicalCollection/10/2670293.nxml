id="B10"><mixed-citation publication-type="book"><name><surname>Gigerenzer</surname><given-names>G</given-names></name><source>Calculated risks: how to know when numbers deceive you</source><year>2002</year><publisher-name>New York: Simon and Schuster</publisher-name></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><name><surname>Smith</surname><given-names>RA</given-names></name><name><surname>Duffy</surname><given-names>SW</given-names></name><name><surname>Gabe</surname><given-names>R</given-names></name><name><surname>Tabar</surname><given-names>L</given-names></name><name><surname>Yen</surname><given-names>AM</given-names></name><name><surname>Chen</surname><given-names>TH</given-names></name><article-title>The randomized trials of breast cancer screening: what have we learned?</article-title><source>Radiol Clin North Am</source><year>2004</year><volume>42</volume><issue>5</issue><fpage>793</fpage><lpage>806</lpage><pub-id pub-id-type="doi">10.1016/j.rcl.2004.06.014</pub-id><pub-id pub-id-type="pmid">15337416</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><name><surname>Berry</surname><given-names>D</given-names></name><article-title>Commentary: screening mammography: a decision analysis</article-title><source>Int J Epidemiol</source><year>2004</year><volume>33</volume><issue>1</issue><fpage>68</fpage><comment>discussion 69&#x02013;73</comment><pub-id pub-id-type="doi">10.1093/ije/dyh034</pub-id><pub-id pub-id-type="pmid">15075148</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Black</surname><given-names>WC</given-names></name><name><surname>Welch</surname><given-names>HG</given-names></name><article-title>Screening for disease</article-title><source>AJR Am J Roentgenol</source><year>1997</year><volume>168</volume><issue>1</issue><fpage>3</fpage><lpage>11</lpage><pub-id pub-id-type="pmid">8976910</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Nekhlyudov</surname><given-names>L</given-names></name><name><surname>Li</surname><given-names>R</given-names></name><name><surname>Fletcher</surname><given-names>SW</given-names></name><article-title>Information and involvement preferences of women in their 40s before their first screening mammogram</article-title><source>Arch Intern Med</source><year>2005</year><volume>165</volume><issue>12</issue><fpage>1370</fpage><lpage>1374</lpage><pub-id pub-id-type="doi">10.1001/archinte.165.12.1370</pub-id><pub-id pub-id-type="pmid">15983285</pub-id></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="journal"><name><surname>Nekhlyudov</surname><given-names>L</given-names></name><name><surname>Li</surname><given-names>R</given-names></name><name><surname>Fletcher</surname><given-names>SW</given-names></name><article-title>Informed decision making before initiating screening mammography: does it occur and does it make a difference?</article-title><source>Health Expect</source><year>2008</year><volume>11</volume><issue>4</issue><fpage>366</fpage><lpage>375</lpage><pub-id pub-id-type="doi">10.1111/j.1369-7625.2008.00514.x</pub-id><pub-id pub-id-type="pmid">19076664</pub-id></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="other"><article-title>Breast cancer screening</article-title><ext-link ext-link-type="uri" xlink:href="http://www.cancer.gov/cancertopics/pdq/screening/breast/HealthProfessional/">http://www.cancer.gov/cancertopics/pdq/screening/breast/HealthProfessional/</ext-link></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="journal"><name><surname>Dershaw</surname><given-names>DD</given-names></name><article-title>Film or digital mammographic screening?</article-title><source>N Engl J Med</source><year>2005</year><volume>353</volume><issue>17</issue><fpage>1846</fpage><lpage>1847</lpage><pub-id pub-id-type="doi">10.1056/NEJMe058253</pub-id><pub-id