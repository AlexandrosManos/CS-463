><given-names>MK</given-names></name><name><surname>Younes</surname><given-names>M</given-names></name><name><surname>Sigounas</surname><given-names>DG</given-names></name><etal/></person-group><article-title>Minimally invasive pituitary surgery</article-title><source>Laryngoscope</source><comment>in press</comment></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>JK</given-names></name><name><surname>Das</surname><given-names>K</given-names></name><name><surname>Weiss</surname><given-names>MH</given-names></name><name><surname>Laws</surname><given-names>ER</given-names><suffix>Jr</suffix></name><name><surname>Couldwell</surname><given-names>WT</given-names></name></person-group><article-title>The history and evolution of transsphenoidal surgery</article-title><source>J Neurosurg</source><year>2001</year><month>12</month><volume>95</volume><issue>6</issue><fpage>1083</fpage><lpage>1096</lpage><pub-id pub-id-type="pmid">11765830</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Landolt</surname><given-names>AM</given-names></name></person-group><article-title>History of pituitary surgery from the technical aspect</article-title><source>Neurosurg Clin N Am</source><year>2001</year><month>1</month><volume>12</volume><issue>1</issue><fpage>37</fpage><lpage>44</lpage><pub-id pub-id-type="pmid">11175987</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Doglietto</surname><given-names>F</given-names></name><name><surname>Prevedello</surname><given-names>DM</given-names></name><name><surname>Jane</surname><given-names>JA</given-names><suffix>Jr</suffix></name><name><surname>Han</surname><given-names>J</given-names></n