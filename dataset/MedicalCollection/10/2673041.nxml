iven-names><suffix>Jr</suffix></name><name><surname>Thomas-Keprta</surname><given-names>KL</given-names></name><name><surname>Vali</surname><given-names>H</given-names></name><name><surname>Romanek</surname><given-names>CS</given-names></name><etal/></person-group><year>1996</year><article-title>Search for past life on Mars: Possible relic biogenic activity in                        Martian meteorite ALH84001.</article-title><source>Science</source><volume>273</volume><fpage>924</fpage><lpage>930</lpage><pub-id pub-id-type="pmid">8688069</pub-id></citation></ref><ref id="pone.0005421-Urbano1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Urbano</surname><given-names>P</given-names></name><name><surname>Urbano</surname><given-names>F</given-names></name></person-group><year>2007</year><article-title>Nanobacteria: facts or fancies?</article-title><source>PLoS Pathog</source><volume>3</volume><fpage>e55</fpage><pub-id pub-id-type="pmid">17530922</pub-id></citation></ref><ref id="pone.0005421-Young1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Young</surname><given-names>JD</given-names></name><name><surname>Martel</surname><given-names>J</given-names></name><name><surname>Young</surname><given-names>L</given-names></name><name><surname>Wu</surname><given-names>C-Y</given-names></name><name><surname>Young</surname><given-names>A</given-names></name><etal/></person-group><year>2009</year><article-title>Putative nanobacteria represent physiological remnants and                        culture by-products of normal calcium homeostasis.</article-title><source>PLoS ONE</source><volume>4</volume><fpage>e4417</fpage><pub-id pub-id-type="pmid">19198665</pub-id></citation></ref><ref id="pone.0005421-Cisar1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cisar</surname><given-names>JO</given-names></name><name><surname>Xu</surname><given-names>DQ</given-names></name><name><surname>Thompson</surname><given-names>J</given-names></name><name><surname>Swain</surname><given-names>W</given-names></name><name><surname>Hu</surname><given-names>S</given-names></name><etal/></person-group><year>2000</year><article-title>Alternative interpretation of nanobacteria-induced                        biomineralization.</article-title><source>Proc Natl Acad Sci U S A</source><volume>10</volume><fpage>11511</fpage><lpage>11515</lpage><pub-id pub-id-type="pmid">11027350</pub-id></citation></ref><ref id="pone.0005421-Raoult1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Raoult</surname><given-names>D</given-names></name><name><surname>Drancourt</surname><given-names>M</given-names></name><name><surname>Azza</surname><given-names>S</given-names></name><name><surname>Nappez</surname><given-names>C</given-names></name><name><surname>Guieu</surname><given-names>R</given-names></name><etal/></person-group><year>2008</year><article-title>Nanobacteria are mineralo fetuin complexes.</article-title><source>PLoS Pathog</source><volume>4</volume><fpage>e41</fpage><pub-id pub-id-type="pmid">18282102</pub-id></citation></ref><ref id="pone.0005421-Martel1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martel</surname><given-names>J</given-names></name><name><surname>Young</surname><given-names>JD</given-names></name></person-group><year>2008</year><article-title>Purported nanobacteria in human blood as calcium carbonate                        nanoparticles.</article-title><source>Proc Natl Acad Sci U S A</source><volume>105</volume><fpage>5549</fpage><lpage>5554</lpage><pub-id pub-id-type="pmid">18385376</pub-id></citation></ref><ref id="pone.0005421-Vali1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vali</surname><given-names>H</given-names></name><name><surname>McKee</surname><given-names>MD</given-names></name><name><surname>&#x000c7;ift&#x000e7;ioglu</surname><given-names>N</given-names></name><name><surname>Sears</surname><given-names>SK</given-names></name><name><surname>Plows</surname><given-names>FL</given-names></name><etal/></person-group><year>2001</year><article-title>Nanoforms: a new type of protein-associated mineralization.</article-title><source>Geochim Cosmochim Acta</source><volume>65</volume><fpage>63</fpage><lpage>74</lpage></citation></ref><ref id="pone.0005421-Benzerara1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Benzerara</surname><given-names>K</given-names></name><name><surname>Miller</surname><given-names>VM</given-names></name><name><surname>Barell</surname><given-names>G</given-names></name><name><surname>Kumar</surname><given-names>V</given-names></name><name><surname>Miot</surname><given-names>J</given-names></name><etal/></person-group><year>2006</year><article-title>Search for microbial signatures within human and microbial                        calcifications using soft X-ray spectromicroscopy.</article-title><source>J Invest Med</source><volume>54</volume><fpage>367</fpage><lpage>379</lpage></citation></ref><ref id="pone.0005421-Kirkland1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kirkland</surname><given-names>BL</given-names></name><name><surname>Lynch</surname><given-names>FL</given-names></name><name><surname>Rahnis</surname><given-names>MA</given-names></name><name><surname>Folk</surname><given-names>RL</given-names></name><name><surname>Molineux</surname><given-names>IJ</given-names></name><etal/></person-group><year>1999</year><article-title>Alternative origins for nannobacteria-like objects in calcite.</article-title><source>Geology</source><volume>27</volume><fpage>347</fpage><lpage>350</lpage></citation></ref><ref id="pone.0005421-Benzerara2"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Benzerara</surname><given-names>K</given-names></name><name><surname>Menguy</surname><given-names>N</given-names></name><name><surname>Guyot</surname><given-names>F</given-names></name><name><surname>Dominici</surname><given-names>C</given-names></name><name><surname>Gillet</surname><given-names>P</given-names></name></person-group><year>2003</year><article-title>Nanobacteria-like calcite single crystals at the surface of the                        Tataouine meteorite.</article-title><source>Proc Natl Acad Sci U S A</source><volume>100</volume><fpage>7438</fpage><lpage>7442</lpage><pub-id pub-id-type="pmid">12792020</pub-id></citation></ref><ref id="pone.0005421-GarcaRuiz1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garc&#x000ed;a-Ruiz</surname><given-names>JM</given-names></name><name><surname>Hyde</surname><given-names>ST</given-names></name><name><surname>Carnerup</surname><given-names>AM</given-names></name><name><surname>Christy</surname><given-names>AG</given-names></name><name><surname>Van Kranendonk</surname><given-names>MJ</given-names></name><etal/></person-group><year>2003</year><article-title>Self-assembled silica-carbonate structures and detection of                        ancient microfossils.</article-title><source>Science</source><volume>302</volume><fpage>1194</fpage><lpage>1197</lpage><pub-id pub-id-type="pmid">14615534</pub-id></citation></ref><ref id="pone.0005421-GarcaRuiz2"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garc&#x000ed;a-Ruiz</surname><given-names>JM</given-names></name><name><surname>Melero-Garc&#x000ed;a</surname><given-names>E</given-names></name><name><surname>Hyde</surname><given-names>ST</given-names></name></person-group><year>2009</year><article-title>Morp