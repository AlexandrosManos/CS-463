source><comment><ext-link ext-link-type="uri" xlink:href="http://www.maths.1th.se/help/R/.R/library/affyPLM/doc/AffyExtensions.pdf">http://www.maths.1th.se/help/R/.R/library/affyPLM/doc/AffyExtensions.pdf</ext-link></comment><access-date>accessed on September 22, 2006</access-date></citation></ref><ref id="b7-cin-02-289"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Choi</surname><given-names>JK</given-names></name><name><surname>Yu</surname><given-names>U</given-names></name><name><surname>Kim</surname><given-names>S</given-names></name><name><surname>Yoo</surname><given-names>OJ</given-names></name></person-group><year>2003</year><article-title>Combining multiple microarray studies and modeling inter-study variation</article-title><source>Bioinformatics</source><issue>Suppl 19</issue><fpage>i84</fpage><lpage>i90</lpage><pub-id pub-id-type="pmid">12855442</pub-id></citation></ref><ref id="b8-cin-02-289"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cruz</surname><given-names>JA</given-names></name><name><surname>Wishart</surname><given-names>DS</given-names></name></person-group><year>2006</year><article-title>Applications of Machine Learning in Cancer Prediction and Prognosis</article-title><source>Cancer Informatics</source><volume>2</volume><fpage>59</fpage><lpage>78</lpage></citation></ref><ref id="b9-cin-02-289"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dudoit</surname><given-names>S</given-names></name><name><surname>Fridlyand</surname><given-names>J</given-names></name><name><surname>Speed</surname><given-names>TP</given-names></name></person-group><year>2002</year><article-title>Comparison of discrimination methods for the classification of tumors using gene expression data</article-title><source>Journal of the American Statistical Association</source><volume>97</volume><fpage>77</fpage><lpage>87</lpage></citation></ref><re