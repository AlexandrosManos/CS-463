person-group-type="author"><name><surname>Evans</surname><given-names>JF</given-names></name></person-group><year>2003</year><article-title>Rofecoxib (Vioxx), a specific cyclooxygenase-2 inhibitor, is chemopreventive in a mouse model of colon cancer</article-title><source>Am. J. Clin. Oncol</source><volume>26</volume><fpage>S62</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">12902858</pub-id></citation></ref><ref id="b9-cin-03-125"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Folkman</surname><given-names>J</given-names></name></person-group><year>1971</year><article-title>Tumor angiogenesis: therapeutic implications</article-title><source>N. Engl. J. Med</source><volume>285</volume><fpage>1182</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">4938153</pub-id></citation></ref><ref id="b10-cin-03-125"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gelin</surname><given-names>J</given-names></name><name><surname>Andersson</surname><given-names>C</given-names></name><name><surname>Lundholm</surname><given-names>K</given-names></name></person-group><year>1991</year><article-title>Effects of indomethacin, cytokines, and cyclosporin A on tumor growth and the subsequent development of cancer cachexia</article-title><source>Cancer Res</source><volume>51</volume><fpage>880</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">1988128</pub-id></citation></ref><ref id="b11-cin-03-125"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giovannucci</surname><given-names>E</given-names></name><name><surname>Egan</surname><given-names>KM</given-names></name><name><surname>Hunter</surname><given-names>DJ</given-names></name><etal/></person-group><year>1995</year><article-title>Aspirin and the risk of colorectal cancer in women</article-title><source>N. Engl. J. Med</source><volume>333</volume><fpage>609</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">7637720</pub-id></citation></ref><ref id="b12-cin-03-125"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giovannucci</surname><given-names>E</given-names></name><name><surname>Rimm</surname><given-names>EB</given-names></name><name><surname>Stampfer</surname><given-names>MJ</given-names></name><etal/></person-group><year>1994</year><article-title>Aspirin use and the risk for colorectal cancer and adenoma in male health professionals</article-title><source>Ann. Intern. Med</source><volume>121</volume><fpage>241</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">8037405</pub-id></citation></ref><ref id="b13-cin-03-125"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gupta</surname><given-names>RA</given-names></name><name><surname>Tejada</surname><given-names>LV</given-names></name><name><surname>Tong</surname><given-names>BJ</given-names></name><etal/></person-group><year>2003</year><article-title>Cyclooxygenase-1 is overexpressed and promotes angiogenic growth factor production in ovarian cancer</article-title><source>Cancer Res</source><volume>63</volume><fpage>906</fpage><lpage>11</lpage><pub-id pub-id-type="pmid">12615701</pub-id></citation></ref><ref id="b14-cin-03-125"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harris</surname><given-names>SG</given-names></name><name><surname>Padilla</surname><given-names>J</given-names></name><name><surname>Koumas</surname><given-names>L</given-names></name><etal/></person-group><year>2002</year><article-title>Prostaglandins as modulators of immunity</article-title><source>Trends Immunol</source><volume>23</volume><fpage>144</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">11864843</pub-id></citation></ref><ref id="b15-cin-03-125"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hayashi</surname><given-names>N</given-names></name><name><surname>Yamamoto</surna