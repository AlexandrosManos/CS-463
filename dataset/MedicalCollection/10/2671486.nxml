><name><surname>Wuerz</surname><given-names>R</given-names></name><name><surname>Hirshberg</surname><given-names>A</given-names></name></person-group><article-title>Analysis of factors affecting U.S. emergency physician workforce projections. SAEM Workforce Task Force</article-title><source>Acad Emerg Med</source><year>1997</year><volume>4</volume><fpage>731</fpage><lpage>735</lpage><pub-id pub-id-type="pmid">9223700</pub-id><pub-id pub-id-type="doi">10.1111/j.1553-2712.1997.tb03769.x</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Joyce</surname><given-names>C</given-names></name><name><surname>McNeil</surname><given-names>J</given-names></name><name><surname>Stoelwinder</surname><given-names>J</given-names></name></person-group><article-title>More doctors, but not enough: Australian medical workforce supply 2001&#x02013;2012</article-title><source>Med J Aust</source><year>2006</year><volume>184</volume><fpage>441</fpage><lpage>446</lpage><pub-id pub-id-type="pmid">16646743</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>O'Donnell</surname><given-names>C</given-names></name><name><surname>Jones</surname><given-names>DN</given-names></name><name><surname>Stuckey</surname><given-names>J</given-names></name></person-group><article-title>1996 Australian radiology workforce report</article-title><source>Australas Radiol</source><year>1997</year><volume>41</volume><fpage>398</fpage><lpage>406</lpage><pub-id pub-id-type="pmid">9409039</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jones</surname><given-names>DN</given-names></name><name><surname>O'Donnell</surname><given-names>C</given-names></name><name><surname>Stuckey</surname><given-names>J</given-names></name></person-group><article-title>1998 Australian radiology workforce report</article-title><source>Australas Radiol</source><year>2000</year><volume>44</volume><fpage>41</fpage><lpage>52</lpage><pub-id pub-id-type="pmid">10761259</pub-id><pub-id pub-id-type="doi">10.1046/j.1440-1673.2000.00780.x</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Basu</surname><given-names>K</given-names></name><name><surname>Gupta</surname><given-names>A</given-names></name></person-group><article-title>A physician demand and supply forecast model for Nova Scotia</article-title><source>Cah Sociol Demogr Med</source><year>2005</year><volume>45</volume><fpage>255</fpage><lpage>285</lpage><pub-id pub-id-type="pmid">16285405</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bessi&#x000e8;re</surname><given-names>S</given-names></name></person-group><article-title>The Office for Health Professions (BPS): an interview</article-title><source>Courrier des statistiques</source><year>2007</year><volume>13</volume><fpage>27</fpage><lpage>28</lpage></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Doan</surname><given-names>BDH</given-names></name><name><surname>Levy</surname><given-names>D</given-names></name><name><surname>Pavot</surname><given-names>J</given-names></name></person-group><article-title>Demographic forecasts of medical workforce supply in France (2000&#x02013;2050). What numerus clausus for what future?</article-title><source>Cah Sociol Demogr Med</source><year>2004</year><volume>44</volume><fpage>101</fpage><lpage>148</lpage><pub-id pub-id-type="pmid">15146660</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Levy</surname><given-names>D</given-names></name><name><surname>Doan</surname><given-names>BDH</given-names></name></person-group><article-