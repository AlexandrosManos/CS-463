-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><collab>The Mental Health Foundation</collab></person-group><article-title>Suicide among children and young people</article-title><source>The Mental Health Foundation Updates</source><year>2003</year><volume>4</volume><fpage>1</fpage><lpage>4</lpage></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Leitner</surname><given-names>M</given-names></name><name><surname>Barr</surname><given-names>W</given-names></name><name><surname>Hobby</surname><given-names>L</given-names></name></person-group><source>Effectiveness of Interventions to Prevent Suicide and Suicidal Behaviour: A systematic review</source><year>2008</year><publisher-name>Edinburgh: Scottish Government Social Research</publisher-name></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Platt</surname><given-names>S</given-names></name><name><surname>Boyle</surname><given-names>P</given-names></name><name><surname>Feng</surname><given-names>Z</given-names></name><name><surname>Exeter</surname><given-names>D</given-names></name></person-group><source>The epidemiology of suicide in Scotland 1989&#x02013;2004: an examination of temporal trends and risk factors at national and local levels</source><year>2007</year><publisher-name>Edinburgh: Scottish Executive Social Research</publisher-name></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McClure</surname><given-names>GM</given-names></name></person-group><article-title>Suicide in children and adolescents in England and Wales 1970&#x02013;1998</article-title><source>Br J Psychiatry</source><year>2001</year><volume>178</volume><fpage>469</fpage><lpage>474</lpage><pub-id pub-id-type="pmid">11331565</pub-id><pub-id pub-id-type="doi">10.1192/bjp.178.5.469</