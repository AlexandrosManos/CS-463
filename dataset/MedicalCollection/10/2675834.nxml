wspan="1" colspan="1">4506699</td><td align="right" rowspan="1" colspan="1">4.46</td><td align="right" rowspan="1" colspan="1">0</td></tr><tr><td align="right" rowspan="1" colspan="1">1096940</td><td align="right" rowspan="1" colspan="1">4.46</td><td align="right" rowspan="1" colspan="1">0</td></tr><tr><td align="right" rowspan="1" colspan="1">13904870</td><td align="right" rowspan="1" colspan="1">4.87</td><td align="right" rowspan="1" colspan="1">0</td></tr><tr><td align="right" rowspan="1" colspan="1">15220431</td><td align="right" rowspan="1" colspan="1">4.75</td><td align="right" rowspan="1" colspan="1">0</td></tr><tr><td align="right" rowspan="1" colspan="1">11415026</td><td align="right" rowspan="1" colspan="1">6.34</td><td align="right" rowspan="1" colspan="1">0</td></tr><tr><td align="right" rowspan="1" colspan="1">14591909</td><td align="right" rowspan="1" colspan="1">4.55</td><td align="right" rowspan="1" colspan="1">0</td></tr><tr><td align="right" rowspan="1" colspan="1">266921</td><td align="right" rowspan="1" colspan="1">5.69</td><td align="right" rowspan="1" colspan="1">0</td></tr><tr><td align="right" rowspan="1" colspan="1">1350706</td><td align="right" rowspan="1" colspan="1">5.77</td><td align="right" rowspan="1" colspan="1">0</td></tr><tr><td align="right" rowspan="1" colspan="1">4506713</td><td align="right" rowspan="1" colspan="1">4.20</td><td align="right" rowspan="1" colspan="1">0</td></tr><tr><td align="right" rowspan="1" colspan="1">133825</td><td align="right" rowspan="1" colspan="1">4.92</td><td align="right" rowspan="1" colspan="1">0</td></tr><tr><td align="right" rowspan="1" colspan="1">15718687</td><td align="right" rowspan="1" colspan="1">4.67</td><td align="right" rowspan="1" colspan="1">0</td></tr><tr><td align="right" rowspan="1" colspan="1">16579885</td><td align="right" rowspan="1" colspan="1">4.51</td><td align="right" rowspan="1" colspan="1">0.001</td></tr><tr><td align="right" rowspan="1" colspan="1">2493600</td><td align="right" rowspan="1" colspan="1">&#x02212;4.10</td><td align="right" rowspan="1" colspan="1">0.002</td></tr><tr><td align="right" rowspan="1" colspan="1">116533</td><td align="right" rowspan="1" colspan="1">&#x02212;5.06</td><td align="right" rowspan="1" colspan="1">1</td></tr><tr><td align="right" rowspan="1" colspan="1">1095781</td><td align="right" rowspan="1" colspan="1">&#x02212;5.06</td><td align="right" rowspan="1" colspan="1">0.986</td></tr><tr><td align="right" rowspan="1" colspan="1">1708274</td><td align="right" rowspan="1" colspan="1">5.47</td><td align="right" rowspan="1" colspan="1">0</td></tr><tr><td align="right" rowspan="1" colspan="1">7512733</td><td align="right" rowspan="1" colspan="1">5.47</td><td align="right" rowspan="1" colspan="1">0.01</td></tr><tr><td align="right" rowspan="1" colspan="1">9910418</td><td align="right" rowspan="1" colspan="1">&#x02212;4.45</td><td align="right" rowspan="1" colspan="1">0</td></tr><tr><td align="right" rowspan="1" colspan="1">128117</td><td align="right" rowspan="1" colspan="1">4.71</td><td align="right" rowspan="1" colspan="1">0.998</td></tr><tr><td align="right" rowspan="1" colspan="1">4557575</td><td align="right" rowspan="1" colspan="1">5.18</td><td align="right" rowspan="1" colspan="1">0.97</td></tr><tr><td align="right" rowspan="1" colspan="1">12229574</td><td align="right" rowspan="1" colspan="1">&#x02212;6.61</td><td align="right" rowspan="1" colspan="1">0.998</td></tr><tr><td align="right" rowspan="1" colspan="1">25402878</td><td align="right" rowspan="1" colspan="1">&#x02212;6.61</td><td align="right" rowspan="1" colspan="1">0</td></tr><tr><td align="right" rowspan="1" colspan="1">7108362</td><td align="right" rowspan="1" colspan="1">5.72</td><td align="right" rowspan="1" colspan="1">0</td></tr><tr><td align="right" rowspan="1" colspan="1">4759146</td><td align="right" rowspan="1" colspan="1">&#x02212;4.65</td><td align="right" rowspan="1" colspan="1">0.996</td></tr><tr><td align="right" rowspan="1" colsp