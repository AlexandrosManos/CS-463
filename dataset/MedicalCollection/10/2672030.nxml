<volume>35</volume><fpage>1</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">11536502</pub-id></citation></ref><ref id="b19-ijms-10-01290"><label>19.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weber</surname><given-names>AL</given-names></name></person-group><article-title>Prebiotic amino acid thioester synthesis: Thioldependent amino acid synthesis from formose substrate (formaldehyde and glycolaldehyde) and ammonia. <italic>Origin Life Evol.</italic></article-title><source>Biosphere</source><year>1997</year><volume>28</volume><fpage>259</fpage><lpage>270</lpage></citation></ref><ref id="b20-ijms-10-01290"><label>20.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Toxvaerd</surname><given-names>S</given-names></name></person-group><article-title>Origin of homochirality in biological systems</article-title><source>Intern. J. Astrobiol</source><year>2005</year><volume>4</volume><fpage>43</fpage><lpage>48</lpage></citation></ref><ref id="b21-ijms-10-01290"><label>21.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schlesinger</surname><given-names>G</given-names></name><name><surname>Miller</surname><given-names>SL</given-names></name></person-group><article-title>Prebiotic synthesis in atmospheres containing CH<sub>4</sub>, CO, and CO<sub>2</sub></article-title><source>J. Mol. Evol</source><year>1983</year><volume>19</volume><fpage>383</fpage><lpage>390</lpage><pub-id pub-id-type="pmid">6315963</pub-id></citation></ref><ref id="b22-ijms-10-01290"><label>22.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Butlerow</surname><given-names>A</given-names></name></person-group><article-title>Formation synthetique dune substance sucree</article-title><source>Compt. Rend. Acad. Set</source><year>1861</year><volume>53</volume><fpage>145</fpage><lpage>147</lpage></citation></ref