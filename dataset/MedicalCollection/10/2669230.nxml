o16-2-4"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shapiro</surname><given-names>SL</given-names></name><name><surname>Astin</surname><given-names>JA</given-names></name><name><surname>Bishop</surname><given-names>SR</given-names></name><name><surname>Cordova</surname><given-names>M</given-names></name></person-group><article-title>Mindfulness-based stress reduction for health care professionals: results from a randomized trial</article-title><source>Int J Stress Manage</source><year>2005</year><volume>12</volume><fpage>164</fpage><lpage>76</lpage></citation></ref><ref id="b17-co16-2-4"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rosenzweig</surname><given-names>S</given-names></name><name><surname>Reibel</surname><given-names>DK</given-names></name><name><surname>Greeson</surname><given-names>JM</given-names></name><name><surname>Brainard</surname><given-names>GC</given-names></name></person-group><article-title>Mindfulness-based stress reduction lowers psychological distress in medical students</article-title><source>Teach Learn Med</source><year>2003</year><volume>15</volume><fpage>88</fpage><lpage>92</lpage><pub-id pub-id-type="pmid">12708065</pub-id></citation></ref><ref id="b18-co16-2-4"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Scott</surname><given-names>JG</given-names></name><name><surname>Cohen</surname><given-names>D</given-names></name><name><surname>DiCicco&#x02013;Bloom</surname><given-names>B</given-names></name><name><surname>Miller</surname><given-names>WL</given-names></name><name><surname>Stange</surname><given-names>KC</given-names></name><name><surname>Crabtree</surname><given-names>BF</given-names></name></person-group><article-title>Understanding healing relationships in primary care</article-title><source>Ann Fam Med</source><year>2008</year><volume>6</volume><fpage>315</fpage><lpage>22</lpage><pub-id pub-id-type="pmid">18626031</pub-id></citation></ref></ref-list></back></article>