York</publisher-loc><publisher-name>Bell Tower</publisher-name><year>1999</year></citation></ref><ref id="b8-co16-2-4"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fricchione</surname><given-names>GL</given-names></name></person-group><article-title>Illness and the origin of caring</article-title><source>J Med Humanit</source><year>1993</year><volume>14</volume><fpage>15</fpage><lpage>21</lpage></citation></ref><ref id="b9-co16-2-4"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>KW</given-names></name><name><surname>Ryan</surname><given-names>RM</given-names></name></person-group><article-title>The benefits of being present: mindfulness and its role in psychological well-being</article-title><source>J Pers Soc Psychol</source><year>2003</year><volume>84</volume><fpage>822</fpage><lpage>48</lpage><pub-id pub-id-type="pmid">12703651</pub-id></citation></ref><ref id="b10-co16-2-4"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Epstein</surname><given-names>RM</given-names></name></person-group><article-title>Mindful practice</article-title><source>JAMA</source><year>1999</year><volume>282</volume><fpage>833</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">10478689</pub-id></citation></ref><ref id="b11-co16-2-4"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stewart</surname><given-names>MA</given-names></name></person-group><article-title>Effective physician&#x02013;patient communication and health outcomes: a review</article-title><source>CMAJ</source><year>1995</year><volume>152</volume><fpage>1423</fpage><lpage>33</lpage><pub-id pub-id-type="pmid">7728691</pub-id></citation></ref><ref id="b12-co16-2-4"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><su