-group-type="author"><name><surname>Dewey</surname><given-names>CN</given-names></name><name><surname>Pachter</surname><given-names>L</given-names></name></person-group><year>2006</year><article-title>Evolution at the nucleotide level: the problem of multiple whole-genome alignment</article-title><source>Hum. Mol .Genet</source><volume>15</volume><fpage>51</fpage><lpage>6</lpage></citation></ref><ref id="b12-ebo-03-15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Duret</surname><given-names>L</given-names></name><name><surname>Mouchiroud</surname><given-names>D</given-names></name><name><surname>Gautier</surname><given-names>C</given-names></name></person-group><year>1995</year><article-title>Statistical analysis of vertebrate sequences reveals that long genes are scarce in GC-rich isochors</article-title><source>J. Mol. Evol</source><volume>40</volume><fpage>308</fpage><lpage>317</lpage><pub-id pub-id-type="pmid">7723057</pub-id></citation></ref><ref id="b13-ebo-03-15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Fisher</surname><given-names>RA</given-names></name></person-group><year>1938</year><source>Statistical Methods for Research Workers</source><publisher-loc>Edinburgh</publisher-loc><publisher-name>Oliver and Boyd</publisher-name></citation></ref><ref id="b14-ebo-03-15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Flannick</surname><given-names>J</given-names></name><name><surname>Batzoglou</surname><given-names>S</given-names></name></person-group><year>2005</year><article-title>Using multiple alignments to improve seeded local alignment algorithms</article-title><source>Nucleic Acids Res</source><volume>33</volume><fpage>4563</fpage><lpage>77</lpage><pub-id pub-id-type="pmid">16100379</pub-id></citation></ref><ref id="b15-ebo-03-15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Florea</surname><given-names>L</given-names></name><name><surname>Hartzell</surname><given-names>G</given-names></name><name><surname>Zhang</surname><given-names>Z</given-names></name><etal/></person-group><year>1998</year><article-title>A computer program for aligning a cDNA sequence with a genomic DNA sequence</article-title><source>Genome Res</source><volume>8</volume><fpage>967</fpage><lpage>74</lpage><pub-id pub-id-type="pmid">9750195</pub-id></citation></ref><ref id="b16-ebo-03-15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gates</surname><given-names>MA</given-names></name><name><surname>Kim</surname><given-names>L</given-names></name><name><surname>Egan</surname><given-names>ES</given-names></name><etal/></person-group><year>1999</year><article-title>A genetic linkage map for zebrafish: comparative analysis and localization of genes and expressed sequences</article-title><source>Genome Res</source><volume>9</volume><fpage>334</fpage><lpage>47</lpage><pub-id pub-id-type="pmid">10207156</pub-id></citation></ref><ref id="b17-ebo-03-15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Geisler</surname><given-names>R</given-names></name><name><surname>Rauch</surname><given-names>GJ</given-names></name><name><surname>Baier</surname><given-names>H</given-names></name><etal/></person-group><year>1999</year><article-title>A radiation hybrid map of the zebrafish genome</article-title><source>Nat. Genet</source><volume>23</volume><fpage>86</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">10471505</pub-id></citation></ref><ref id="b18-ebo-03-15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gharbi</surname><given-names>K</given-names></name><name><surname>Gautier</surname><given-names>A</given-names></name><name><surname>Danzmann</surname><given-names>RG</given-names></name><etal/></person-group><year>2006</year><article-title>A linkage map for brown trout (<italic>Salmo trutta</italic>): chromosome homeologies and comparative genome organization with other Salmonid fish</article-title><source>Genetics</source><volume>172</volume><fpage>2405</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">16452148</pub-id></citation></ref><ref id="b19-ebo-03-15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goodman</surname><given-names>LA</given-names></name><name><surname>Kruskal</surname><given-names>WH</given-names></name></person-group><year>1954</year><article-title>Measures of association for cross classifications</article-title><source>J. Am. Stat. Assoc</source><volume>49</volume><fpage>732</fpage><lpage>64</lpage></citation></ref><ref id="b20-ebo-03-15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Housworth</surname><given-names>EA</given-names></name><name><surname>Postlethwait</surname><given-names>J</given-names></name></person-group><year>2002</year><article-title>Measures of synteny conservation between species pairs</article-title><source>Genetics</source><volume>162</volume><fpage>441</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">12242252</pub-id></citation></ref><ref id="b21-ebo-03-15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hsieh</surname><given-names>SJ</given-names></name><name><surname>Lin</surname><given-names>CY</given-names></name><name><surname>Liu</surname><given-names>NH</given-names></name><etal/></person-group><year>2006</year><article-title>GeneAlign: a coding exon prediction tool based on phylogenetical comparisons</article-title><source>Nucleic Acids Res</source><volume>34</volume><fpage>280</fpage><lpage>84</lpage></citation></ref><ref id="b22-ebo-03-15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>W</given-names></name><name><surname>Umbach</surname><given-names>DM</given