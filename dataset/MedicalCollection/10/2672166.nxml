"/><td align="left" rowspan="1" colspan="1"><italic>L. analis</italic></td><td align="left" rowspan="1" colspan="1">mutton snapper<xref ref-type="table-fn" rid="nt103">a</xref></td><td align="left" rowspan="1" colspan="1">94</td><td align="left" rowspan="1" colspan="1">0.1659</td><td align="left" rowspan="1" colspan="1">0.0198</td><td align="left" rowspan="1" colspan="1">&#x02212;0.0002</td><td align="left" rowspan="1" colspan="1">0.0001</td><td align="left" rowspan="1" colspan="1">&#x02212;1.770</td><td align="left" rowspan="1" colspan="1">0.0805</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"><italic>L. griseus</italic></td><td align="left" rowspan="1" colspan="1">gray snapper</td><td align="left" rowspan="1" colspan="1">89</td><td align="left" rowspan="1" colspan="1">0.1551</td><td align="left" rowspan="1" colspan="1">0.0165</td><td align="left" rowspan="1" colspan="1">&#x02212;0.0002</td><td align="left" rowspan="1" colspan="1">0.0001</td><td align="left" rowspan="1" colspan="1">&#x02212;2.568</td><td align="left" rowspan="1" colspan="1">0.0120</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"><italic>Ocyurus chrysurus</italic></td><td align="left" rowspan="1" colspan="1">yellowtail snapper</td><td align="left" rowspan="1" colspan="1">86</td><td align="left" rowspan="1" colspan="1">0.7602</td><td align="left" rowspan="1" colspan="1">0.0272</td><td align="left" rowspan="1" colspan="1">&#x02212;0.0004</td><td align="left" rowspan="1" colspan="1">0.0001</td><td align="left" rowspan="1" colspan="1">&#x02212;2.980</td><td align="left" rowspan="1" colspan="1">0.0038&#x0002a;</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"><italic>L. apodus</italic></td><td align="left" rowspan="1" colspan="1">schoolmaster</td><td align="left" rowspan="1" colspan="1">67</td><td align="left" rowspan="1" colspan="1">0.6091</td><td align="left" rows