<pub-id pub-id-type="pmid">11344287</pub-id></citation></ref><ref id="pone.0005333-Wing1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wing</surname><given-names>SR</given-names></name><name><surname>Wing</surname><given-names>ES</given-names></name></person-group><year>2001</year><article-title>Prehistoric fisheries in the Caribbean.</article-title><source>Coral Reefs</source><volume>20(1)</volume><fpage>1</fpage><lpage>8</lpage></citation></ref><ref id="pone.0005333-Abesamis1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Abesamis</surname><given-names>RA</given-names></name><name><surname>Russ</surname><given-names>GR</given-names></name></person-group><year>2005</year><article-title>Density-dependent spillover from a marine reserve: Long-term evidence.</article-title><source>Ecological Applications</source><volume>15(5)</volume><fpage>1798</fpage><lpage>1812</lpage></citation></ref><ref id="pone.0005333-Hawkins1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hawkins</surname><given-names>JP</given-names></name><name><surname>Roberts</surname><given-names>CM</given-names></name></person-group><year>2004</year><article-title>Effects of artisanal fishing on Caribbean coral reefs.</article-title><source>Conservation Biology</source><volume>18(1)</volume><fpage>215</fpage><lpage>226</lpage></citation></ref><ref id="pone.0005333-Newton1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Newton</surname><given-names>K</given-names></name><name><surname>Cote</surname><given-names>IM</given-names></name><name><surname>Pilling</surname><given-names>GM</given-names></name><name><surname>Jennings</surname><given-names>S</given-names></name><name><surname>Dulvy</surname><given-names>NK</given-names></name></person-group><year>2007</year><