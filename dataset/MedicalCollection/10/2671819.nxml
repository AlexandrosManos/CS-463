son-group person-group-type="author"><name><surname>Genazzani</surname><given-names>AR</given-names></name><name><surname>Bernardi</surname><given-names>F</given-names></name><name><surname>Pluchino</surname><given-names>N</given-names></name><etal/></person-group><year>2006</year><article-title>Effect of tibolone administration on central and peripheral levels of allopregnanolone and &#x003b2;-endorphin in female rats</article-title><source>Menopause</source><volume>13</volume><fpage>57</fpage><lpage>64</lpage><pub-id pub-id-type="pmid">16607099</pub-id></citation></ref><ref id="b24-ndt-2-299"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Genazzani</surname><given-names>AR</given-names></name><name><surname>Palumbo</surname><given-names>MA</given-names></name><name><surname>de Micheroux</surname><given-names>AA</given-names></name><etal/></person-group><year>1995</year><article-title>Evidence for a role for the neurosteroid allopregnanolone in the modifications of reproductive function in female rats</article-title><source>Eur J Endocrinol</source><volume>133</volume><fpage>375</fpage><lpage>80</lpage><pub-id pub-id-type="pmid">7581957</pub-id></citation></ref><ref id="b25-ndt-2-299"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Genazzani</surname><given-names>AR</given-names></name><name><surname>Petraglia</surname><given-names>F</given-names></name><name><surname>Facchinetti</surname><given-names>F</given-names></name><etal/></person-group><year>1984</year><article-title>Increase of proopiomelanocortin-related peptides during subjective menopausal flushes</article-title><source>Am J Obstet Gynecol</source><volume>149</volume><fpage>775</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">6087664</pub-id></citation></ref><ref id="b26-ndt-2-299"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Genazzani</surname><given-names>AR</given-names>