><year>1984</year><volume>34</volume><fpage>483</fpage><lpage>487</lpage></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fielding</surname><given-names>JE</given-names></name></person-group><article-title>Smoking: Health effects and control</article-title><source>New England Journal of Medicine</source><year>1985</year><volume>313</volume><issue>8</issue><fpage>491</fpage><lpage>498</lpage><pub-id pub-id-type="pmid">3894970</pub-id></citation></ref><ref id="B33"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lennox</surname><given-names>AS</given-names></name></person-group><article-title>Determinants of outcome in smoking cessation</article-title><source>British Journal of General Practice</source><year>1992</year><volume>42</volume><fpage>247</fpage><lpage>252</lpage><pub-id pub-id-type="pmid">1419248</pub-id></citation></ref><ref id="B34"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Mackay</surname><given-names>J</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Chapman S</surname></name></person-group><article-title>Combating addiction in developing countries</article-title><source>Smokers: Why Do They Start &#x02013; And Continue?</source><year>1995</year><volume>16</volume><publisher-name>World Health Forum</publisher-name><fpage>1</fpage><lpage>27</lpage></citation></ref><ref id="B35"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pierce</surname><given-names>JP</given-names></name><name><surname>Lee</surname><given-names>L</given-names></name><name><surname>Gilpin</surname><given-names>AE</given-names></name></person-group><article-title>Smoking initiation by adolescent girls, 1944 through 1988. An association with targeted advertising</article-title><source>JAMA</source><year>1994</year><volume>271</volume><fpage>608</fpage><lpage>611</lpage><pub-id pub-id-type="pmid">8301793</pub-id><pub-id pub-id-type="doi">10.1001/jama.271.8.608</pub-id></citation></ref><ref id="B36"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Altman</surname><given-names>DG</given-names></name><name><surname>Grimes</surname><given-names>DA</given-names></name><name><surname>Chalmers</surname><given-names>I</given-names></name><name><surname>Schulz</surname><given-names>KF</given-names></name></person-group><article-title>Sustained effects of an educational program to reduce sales of cigarettes to minors</article-title><source>American Journal of Public Health</source><year>1994</year><volume>18</volume><fpage>39</fpage><lpage>42</lpage></citation></ref><ref id="B37"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rawhone</surname><given-names>RG</given-names></name><name><surname>Keeling</surname><given-names>CA</given-names></name><name><surname>Jenkins</surname><given-names>A</given-names></name><name><surname>Guz</surname><given-names>A</given-names></name></person-group><article-title>Cigarette smoking among secondary children in 1975</article-title><source>Journal of Epidemiology and Community Health</source><year>1978</year><volume>32</volume><fpage>53</fpage><lpage>58</lpage><pub-id pub-id-type="pmid">262590</pub-id><pub-id pub-id-type="doi">10.1136/jech.32.1.53</pub-id></citation></ref></ref-list></back></article>