><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Czerny</surname><given-names>M</given-names></name><name><surname>Baumer</surname><given-names>H</given-names></name><name><surname>Kilo</surname><given-names>J</given-names></name><name><surname>Lassnigg</surname><given-names>A</given-names></name><name><surname>Hamwi</surname><given-names>A</given-names></name><name><surname>Vukovich</surname><given-names>T</given-names></name><name><surname>Wolner</surname><given-names>E</given-names></name><name><surname>Grimm</surname><given-names>M</given-names></name></person-group><article-title>Inflammatory response and myocardial injury following coronary artery bypass grafting with and without cardiopulmonary bypass.</article-title><source>Eur J Cardiothorac Surg</source><year>2000</year><volume>17</volume><fpage>737</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">10856869</pub-id></citation></ref><ref id="r8"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sullivan</surname><given-names>GW</given-names></name><name><surname>Sarembock</surname><given-names>IJ</given-names></name><name><surname>Linden</surname><given-names>J</given-names></name></person-group><article-title>The role of inflammation in vascular diseases.</article-title><source>J Leukoc Biol</source><year>2000</year><volume>67</volume><fpage>591</fpage><lpage>602</lpage><pub-id pub-id-type="pmid">10810997</pub-id></citation></ref><ref id="r9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ambrosio</surname><given-names>G</given-names></name><name><surname>Tritto</surname><given-names>I</given-names></name></person-group><article-title>Reperfusion injury: experimental evidence and clinical implication.</article-title><source>Am Heart J</source><year>1999</year><volume>138</volume><fpage>s69</fpage><lpage>75</lpage><pub-id pub-id-type="pmid">10426862</pub-id></citation></ref><ref id="r10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nathan</surname><given-names>AT</given-names></name><name><surname>Singer</surname><given-names>M</given-names></name></person-group><article-title>The oxygen trail: tissue oxygenation.</article-title><source>Br Med Bull</source><year>1999</year><volume>55</volume><fpage>96</fpage><lpage>108</lpage><pub-id pub-id-type="pmid">10695081</pub-id></citation></ref><ref id="r11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldenberg-Cohen</surname><given-names>N</given-names></name><name><surname>Kramer</surname><given-names>M</given-names></name><name><surname>Bahar</surname><given-names>I</given-names></name><name><surname>Monselise</surname><given-names>Y</given-names></name><name><surname>Weinberger</surname><given-names>D</given-names></name></person-group><article-title>Elevated plasma levels of interleukin 8 in patients with acute anterior ischaemic optic neuropathy.</article-title><source>Br J Ophthalmol</source><year>2004</year><volume>88</volume><fpage>1538</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">15548807</pub-id></citation></ref><ref id="r12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kramer</surname><given-names>M</given-names></name><name><surname>Goldenberg-Cohen</surname><given-names>N</given-names></name><name><surname>Cohen</surname><given-names>Y</given-names></name><name><surname>Axer-Siegel</surname><given-names>R</given-names></name><name><surname>Weinberger</surname><given-names>D</given-names></name><name><surname>Monselise</surname><given-names>Y</given-names></name></person-group><article-title>Inflammatory reaction in acute retinal artery occlusion: cytokine levels in aqueous humor and serum.</article-title><source>Ocul Immunol Inflamm</source><year>2005</year><volume>13