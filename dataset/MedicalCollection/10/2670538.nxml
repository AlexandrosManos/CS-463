n citation-type="journal"><person-group person-group-type="author"><name><surname>Casadevall</surname><given-names>A</given-names></name><name><surname>Feldmesser</surname><given-names>M</given-names></name><name><surname>Pirofski</surname><given-names>LA</given-names></name></person-group><year>2002</year><article-title>Induced humoral immunity and vaccination against major human fungal pathogens.</article-title><source>Curr Opin Microbiol</source><volume>5(4)</volume><fpage>386</fpage><lpage>391</lpage><pub-id pub-id-type="pmid">12160857</pub-id></citation></ref><ref id="pone.0005392-Cassone1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cassone</surname><given-names>A</given-names></name><name><surname>De Bernardis</surname><given-names>F</given-names></name><name><surname>Torosantucci</surname><given-names>A</given-names></name></person-group><year>2005</year><article-title>An outline of the role of anti-<italic>Candida</italic> antibodies within the context of passive immunization and protection from candidiasis.</article-title><source>Curr Mol Med</source><volume>5(4)</volume><fpage>377</fpage><lpage>382</lpage><pub-id pub-id-type="pmid">15977993</pub-id></citation></ref><ref id="pone.0005392-Cutler1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cutler</surname><given-names>JE</given-names></name><name><surname>Deepe</surname><given-names>GS</given-names><suffix>Jr</suffix></name><name><surname>Klein</surname><given-names>BS</given-names></name></person-group><year>2007</year><article-title>Advances in combating fungal diseases: Vaccines on the threshold.</article-title><source>Nat Rev Microbiol</source><volume>5(1)</volume><fpage>13</fpage><lpage>28</lpage><pub-id pub-id-type="pmid">17160002</pub-id></citation></ref><ref id="pone.0005392-Deepe1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Deepe</surname><given-names>GS</given-names><suffix>Jr</suffix></name></person-group><year>2004</year><article-title>Preventative and therapeutic vaccines for fungal infections: From concept to implementation.</article-title><source>Expert Rev Vaccines</source><volume>3(6)</volume><fpage>701</fpage><lpage>709</lpage><pub-id pub-id-type="pmid">15606355</pub-id></citation></ref><ref id="pone.0005392-Matthews1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matthews</surname><given-names>RC</given-names></name><name><surname>Burnie</surname><given-names>JP</given-names></name></person-group><year>2004</year><article-title>Recombinant antibodies: A natural partner in combinatorial antifungal therapy.</article-title><source>Vaccine</source><volume>22(7)</volume><fpage>865</fpage><lpage>871</lpage><pub-id pub-id-type="pmid">15040939</pub-id></citation></ref><ref id="pone.0005392-Cassone2"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cassone</surname><given-names>A</given-names></name></person-group><year>2008</year><article-title>Fungal vaccines: Real progress from real challenges.</article-title><source>Lancet Infect Dis</source><volume>8(2)</volume><fpage>114</fpage><lpage>124</lpage><pub-id pub-id-type="pmid">18222162</pub-id></citation></ref><ref id="pone.0005392-Shoham1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shoham</surname><given-names>S</given-names></name><name><surname>Levitz</surname><given-names>SM</given-names></name></person-group><year>2005</year><article-title>The immune response to fungal infections.</article-title><source>Br J Haematol</source><volume>129(5)</volume><fpage>569</fpage><lpage>582</lpage><pub-id pub-id-type="pmid">15916679</pub-id></citation></ref><ref id="pone.0005392-Magliani1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Magliani</surname><given-names>W</given-names></name><name><surname>Conti</surname><given-names>S</given-names></name><name><surname>Arseni</surname><given-names>S</given-names></name><name><surname>Salati</surname><given-names>A</given-names></name><name><surname>Ravanetti</surname><given-names>L</given-names></name><etal/></person-group><year>2005</year><article-title>Antibody-mediated protective immunity in fungal infections.</article-title><source>New Microbiol</source><volume>28(4)</volume><fpage>299</fpage><lpage>309</lpage><pub-id pub-id-type="pmid">16386014</pub-id></citation></ref><ref id="pone.0005392-Xin1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Xin</surname><given-names>H</given-names></name><name><surname>Dziadek</surname><given-names>S</given-names></name><name><surname>Bundle</surname><given-names>DR</given-names></name><name><surname>Cutler</surname><given-names>JE</given-names></name></person-group><year>2008</year><article-title>Synthetic glycopeptide vaccines combining {beta}-mannan and peptide epitopes induce protection against candidiasis.</article-title><source>Proc Natl Acad Sci U S A</source><volume>105(36)</volume><fpage>13526</fpage><lpage>13531</lpage><comment>10.1073/pnas.0803195105</comment><pub-id pub-id-type="pmid">18725625</pub-id></citation></ref><ref id="pone.0005392-Datta1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Datta</surname><given-names>K</given-names></name><name><surname>Lees</surname><given-names>A</given-names></name><name><surname>Pirofski</surname><given-names>LA</given-names></name></person-group><year>2008</year><article-title>Therapeutic efficacy of a conjugate vaccine containing a peptide mimotope of cryptococcal capsular polysaccharide glucuronoxylomannan.</article-title><source>Clin Vaccine Immunol</source><volume>15(8)</volume><fpage>1176</