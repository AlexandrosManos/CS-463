<lpage>5776</lpage><pub-id pub-id-type="pmid">9826353</pub-id></citation></ref><ref id="pone.0005392-Torosantucci1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Torosantucci</surname><given-names>A</given-names></name><name><surname>Bromuro</surname><given-names>C</given-names></name><name><surname>Chiani</surname><given-names>P</given-names></name><name><surname>De Bernardis</surname><given-names>F</given-names></name><name><surname>Berti</surname><given-names>F</given-names></name><etal/></person-group><year>2005</year><article-title>A novel glyco-conjugate vaccine against fungal pathogens.</article-title><source>J Exp Med</source><volume>202(5)</volume><fpage>597</fpage><lpage>606</lpage><pub-id pub-id-type="pmid">16147975</pub-id></citation></ref><ref id="pone.0005392-Vilanova1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vilanova</surname><given-names>M</given-names></name><name><surname>Teixeira</surname><given-names>L</given-names></name><name><surname>Caramalho</surname><given-names>I</given-names></name><name><surname>Torrado</surname><given-names>E</given-names></name><name><surname>Marques</surname><given-names>A</given-names></name><etal/></person-group><year>2004</year><article-title>Protection against systemic candidiasis in mice immunized with secreted aspartic proteinase 2.</article-title><source>Immunology</source><volume>111(3)</volume><fpage>334</fpage><lpage>342</lpage><pub-id pub-id-type="pmid">15009435</pub-id></citation></ref><ref id="pone.0005392-Rachini1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rachini</surname><given-names>A</given-names></name><name><surname>Pietrella</surname><given-names>D</given-names></name><name><surname>Lupo</surname><given-names>P</given-names></name><name><surname>Torosantucci</surname><given-names>A</given-names></name><name>