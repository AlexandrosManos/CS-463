up-type="author"><name><surname>Larman</surname><given-names>C</given-names></name></person-group><source>Applying UML and Patterns</source><year>2004</year><edition>3</edition><publisher-name>Upper Saddle River: Prentice Hall</publisher-name></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Riehle</surname><given-names>D</given-names></name><name><surname>Tilman</surname><given-names>M</given-names></name><name><surname>Johnson</surname><given-names>R</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Manolescu D, V&#x000f6;lter M</surname></name></person-group><article-title>Dynamic Object Model</article-title><source>Pattern Languages of Program Design 5</source><year>2005</year><publisher-name>Noble J: Addison-Wesley</publisher-name><fpage>3</fpage><lpage>24</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yoder</surname><given-names>JW</given-names></name><name><surname>Balaguer</surname><given-names>F</given-names></name><name><surname>Johnson</surname><given-names>R</given-names></name></person-group><article-title>Architecture and design of adaptive object-models</article-title><source>SIGPLAN Not</source><year>2001</year><volume>36</volume><fpage>50</fpage><lpage>60</lpage></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Johnson</surname><given-names>R</given-names></name><name><surname>Woolf</surname><given-names>B</given-names></name></person-group><article-title>Type object</article-title><source>Pattern languages of program design 3</source><year>1997</year><publisher-name>Addison-Wesley Longman Publishing Co., Inc</publisher-name><fpage>47</fpage><lpage>65</lpage></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Fowler</surname><given-names>M</given-names></name></person-group><source>Analysis patterns: reusable objects models</source><year>1997</year><publisher-name>Boston, MA, USA: Addison-Wesley Longman Publishing Co., Inc</publisher-name></citation></ref><ref id="B23"><citation citation-type="other"><article-title>Dealing with Properties</article-title><ext-link ext-link-type="uri" xlink:href="http://www.martinfowler.com/apsupp/properties.pdf"/></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Meyer</surname><given-names>B</given-names></name></person-group><source>Object-oriented software construction</source><year>1997</year><edition>2</edition><publisher-name>Upper Saddle River: Prentice-Hall, Inc</publisher-name></citation></ref><ref id="B25"><citation citation-type="other"><article-title>Unified Modeling Language: Superstructure, version 2.0</article-title><ext-link ext-link-type="uri" xlink:href="http://www.omg.org/docs/formal/05-07-04.pdf"/></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meyer</surname><given-names>B</given-names></name></person-group><article-title>On To Components</article-title><source>Computer</source><year>1999</year><volume>32</volume><fpage>139</fpage><lpage>140</lpage></citation></ref><ref id="B27"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Yoder</surname><given-names>JW</given-names></name><name><surname>Johnson</surname><given-names>R</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Kluwer BV</surname></name></person-group><article-title>The Adaptive Object-Model Architectural Style</article-title><source>3rd IEEE/IFIP Conference on Software Architecture</source><year>2002</year></citation></ref><ref id="B28"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Ambler</surname><given-names>S</given-nam