:10.1126/science.1112070</ext-link><pub-id pub-id-type="pmid">16272112</pub-id></citation></ref><ref id="bib122"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Suzuki</surname><given-names>S.</given-names></name><name><surname>al-Noori</surname><given-names>S.</given-names></name><name><surname>Butt</surname><given-names>S.A.</given-names></name><name><surname>Pham</surname><given-names>T.A.</given-names></name></person-group><article-title>Regulation of the CREB signaling cascade in the visual cortex by visual experience and neuronal activity</article-title><source>J. Comp. Neurol</source><volume>479</volume><year>2004</year><fpage>70</fpage><lpage>83</lpage><ext-link ext-link-type="uri" xlink:href="http://dx.doi.org/doi:10.1002/cne.20310">doi:10.1002/cne.20310</ext-link><pub-id pub-id-type="pmid">15389611</pub-id></citation></ref><ref id="bib123"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Syken</surname><given-names>J.</given-names></name><name><surname>Grandpre</surname><given-names>T.</given-names></name><name><surname>Kanold</surname><given-names>P.O.</given-names></name><name><surname>Shatz</surname><given-names>C.J.</given-names></name></person-group><article-title>PirB restricts ocular-dominance plasticity in visual cortex</article-title><source>Science</source><volume>313</volume><year>2006</year><fpage>1795</fpage><lpage>1800</lpage><ext-link ext-link-type="uri" xlink:href="http://dx.doi.org/doi:10.1126/science.1128232">doi:10.1126/science.1128232</ext-link><pub-id pub-id-type="pmid">16917027</pub-id></citation></ref><ref id="bib124a"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tagawa</surname><given-names>Y.</given-names></name><name><surname>Kanold</surname><given-names>P.O.</given-names></name><name><surname>Majdan</surname><given-names>M.</given-names></name><name><surname>Shatz</surname><given-names>C.J.</given-names>