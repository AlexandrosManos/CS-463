tion citation-type="other">Collett, D. <source>Modelling survival data in medical research</source> New York: Chapman &#x00026; Hall, <year>1994</year></citation></ref><ref id="ref21"><label>21</label><citation citation-type="journal">Loughlin A, Metsch L, Gardner L, Anderson-Mahoney P, Barrigan M, Strathdee S. Provider barriers to prescribing HAART to medically-eligible HIV-infected drug users. <source>AIDS Care</source><year>2004</year>;<volume>16</volume>:<fpage>485</fpage>-500.<pub-id pub-id-type="pmid">15203416</pub-id></citation></ref><ref id="ref22"><label>22</label><citation citation-type="journal">Wood E, Hogg RS, Harrigan PR, Montaner JS. When to initiate antiretroviral therapy in HIV-1-infected adults: a review for clinicians and patients. <source>Lancet Infect Dis</source><year>2005</year>;<volume>5</volume>:<fpage>407</fpage>-14.<pub-id pub-id-type="pmid">15978527</pub-id></citation></ref><ref id="ref23"><label>23</label><citation citation-type="journal">Wood E, Hogg RS, Yip B, Moore D, Harrigan PR, Montaner JS. Impact of baseline viral load and adherence on survival of HIV-infected adults with baseline CD4 cell counts &#x0003e; or =200 cells/microl. <source>AIDS</source><year>2006</year>;<volume>20</volume>:<fpage>1117</fpage>-23.<pub-id pub-id-type="pmid">16691062</pub-id></citation></ref><ref id="ref24"><label>24</label><citation citation-type="journal">Cu-Uvin S, Caliendo AM, Reinert S, Chang A, Juliano-Remollino C, Flanigan TP, et al. Effect of highly active antiretroviral therapy on cervicovaginal HIV-1 RNA. <source>AIDS</source><year>2000</year>;<volume>14</volume>:<fpage>415</fpage>-21.<pub-id pub-id-type="pmid">10770544</pub-id></citation></ref><ref id="ref25"><label>25</label><citation citation-type="journal">Lampinen TM, Critchlow CW, Kuypers JM, Hurt CS, Nelson PJ, Hawes SE, et al. Association of antiretroviral therapy with detection of HIV-1 RNA and DNA in the anorectal mucosa of homosexual men. <source>AIDS</source><year>2000</year>;<volume>14</volume>:<fpage>F69</fpage>-75.<pub-id pub-id-type="pmid">10780708</pub-id></citation></ref><ref id="ref26"><label>26</label><citation citation-type="journal">Vernazza PL, Gilliam BL, Flepp M, Dyer JR, Frank AC, Fiscus SA, et al. Effect of antiviral treatment on the shedding of HIV-1 in semen. <source>AIDS</source><year>1997</year>;<volume>11</volume>:<fpage>1249</fpage>-54.<pub-id pub-id-type="pmid">9256943</pub-id></citation></ref><ref id="ref27"><label>27</label><citation citation-type="journal">Fang CT, Hsu HM, Twu SJ, Chen MY, Chang YY, Hwang JS, et al. Decreased HIV transmission after a policy of providing free access to highly active antiretroviral therapy in Taiwan. <source>J Infect Dis</source><year>2004</year>;<volume>190</volume>:<fpage>879</fpage>-85.<pub-id pub-id-type="pmid">15295691</pub-id></citation></ref><ref id="ref28"><label>28</label><citation citation-type="journal">Quinn TC, Wawer MJ, Sewankambo N, Serwadda D, Li C, Wabwire-Mangen F, et al. Viral load and heterosexual transmission of human immunodeficiency virus type 1. Rakai Project Study Group. <source>N Engl J Med</source><year>2000</year>;<volume>342</volume>:<fpage>921</fpage>-9.<pub-id pub-id-type="pmid">10738050</pub-id></citation></ref><ref id="ref29"><label>29</label><citation citation-type="journal">Martinez-Picado J, DePasquale MP, Kartsonis N, Hanna GJ, Wong J, Finzi D, et al. Antiretroviral resistance during successful therapy of HIV type 1 infection. <source>Proc Natl Acad Sci U S A</source><year>2000</year>;<volume>97</volume>:<fpage>10948</fpage>-53.<pub-id pub-id-type="pmid">11005867</pub-id></citation></ref><ref id="ref30"><label>30</label><citation citation-type="journal">Gallego O, de Mendoza C, Perez-Elias MJ, Guardiola JM, Pedreira J, Dalmau D, et al. Drug resistance in patients experiencing early virological failure under a triple combination including indinavir. <source>AIDS</source><year>2001</year>;<volume>15</volume>(13):<fpage>1701</fpage>-6.<pub-id pub-id-type