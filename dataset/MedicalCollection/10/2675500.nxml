r><article-title>Mathematical Models of Tumor and Normal Tissue Response</article-title><source>Acta Oncologica</source><volume>38</volume><fpage>883</fpage><lpage>893</lpage><pub-id pub-id-type="pmid">10606418</pub-id></citation></ref><ref id="b13-cin-02-113"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kocher</surname><given-names>M</given-names></name><name><surname>Treuer</surname><given-names>H</given-names></name><name><surname>Voges</surname><given-names>J</given-names></name><etal/></person-group><year>2000</year><article-title>Computer simulation of cytotoxic and vascular effects of radiosurgery in solid and necrotic brain metastases</article-title><source>Radiother. Oncol</source><volume>54</volume><fpage>149</fpage><lpage>156</lpage><pub-id pub-id-type="pmid">10699478</pub-id></citation></ref><ref id="b14-cin-02-113"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Perez</surname><given-names>C</given-names></name><name><surname>Brady</surname><given-names>L</given-names></name></person-group><year>1998</year><source>Principles and Practice of Radiation Oncology</source><publisher-loc>Philadelphia</publisher-loc><publisher-name>Lippincott-Raven</publisher-name></citation></ref><ref id="b15-cin-02-113"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Salmon</surname><given-names>SE</given-names></name><name><surname>Sartorelli</surname><given-names>AC</given-names></name></person-group><year>2001</year><article-title>Cancer Chemotherapy</article-title><person-group person-group-type="editor"><name><surname>Katzung</surname><given-names>BG</given-names></name></person-group><source>Basic &#x00026; Clinical Pharmacology</source>Int. ed.:<publisher-name>Lange Medical Books/McGraw-Hill</publisher-name><fpage>923</fpage><lpage>1044</lpage></citation></ref><ref id="b16-cin-02-113"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stamatakos</surname><given-names>GS</given-names></name><name><surname>Dionysiou</surname><given-names>DD</given-names></name><name><surname>Zacharaki</surname><given-names>EI</given-names></name><etal/></person-group><year>2002</year><article-title>In silico radiation oncology: combining novel simulation algorithms with current visualization techniques</article-title><source>IEEE Proceedings: Special Issue on Bioinformatics: Advances and Challenges</source><volume>90</volume><fpage>1764</fpage><lpage>1777</lpage></citation></ref><ref id="b17-cin-02-113"><citation citation-type="web"><person-group person-group-type="author"><name><surname>Stamatakos</surname><given-names>GS</given-names></name><name><surname>Antipas</surname><given-names>VP</given-names></name><name><surname>Uzunoglu</surname><given-names>NK</given-names></name></person-group><year>2005</year><article-title>&#x0201c;Simulating chemotherapeutic schemes in the individualized treatment context: The paradigm of glioblastoma multiforme treated by temozolomide in vivo.&#x0201d;</article-title><source>Comput Biol Med</source><year>2005</year><month>10</month><day>2</day>[Epub ahead of print, Pubmed Link:<ext-link ext-link-type="uri" xlink:href="http://www.ncbi.nlm.nih.gov/entrez/query.fcgi?cmd=Retrieve&#x00026;db=pubmed&#x00026;dopt=Abstract&#x00026;list_uids=16207487&#x00026;query_hl=14">http://www.ncbi.nlm.nih.gov/entrez/query.fcgi?cmd=Retrieve&#x00026;db=pubmed&#x00026;dopt=Abstract&#x00026;list_uids=16207487&#x00026;query_hl=14</ext-link>]</citation></ref><ref id="b18-cin-02-113"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Steel</surname><given-names>GG</given-names></name></person-group><year>2001</year><article-title>The case against apoptosis</article-title><source>Acta Oncol</source><volume>40</volume><fpage>968</fpage><lpage>975</lpage><pub-id pub-id-type="pmid">11845962</pub-id></citation></ref><ref id="b19-cin-02-113"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Steel</surname><given-names>G</given-names></name></person-group><year>2002</year><source>Basic Clinical Radiobiology</source><publisher-loc>London UK</publisher-loc><publisher-name>Arnold</publisher-name></citation></ref><ref id="b20-cin-02-113"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Turrisi</surname><given-names>AT</given-names></name></person-group><year>1999</year><article-title>Charting the course of accelerated irradiation</article-title><source>Abstr Hematol Oncol</source><volume>2</volume><issue>2</issue><fpage>5</fpage><lpage>7</lpage>&#x000a9; 1999 Cliggott Publishing, Division of SCP Communications.</citation></ref><ref id="b21-cin-02-113"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yew</surname><given-names>DT</given-names></name><name><surname>Wang</surname><given-names>HH</given-names></name><name><surname>Zheng</surname><given-names>DR</given-names></name></person-group><year>1998</year><article-title>Apoptosis in astrocytomas with different grades of malignancy</article-title><source>Acta Neurochir(Wien)</source><volume>140</volume><fpage>341</fpage><lpage>347</lpage><pub-id pub-id-type="pmid">9689325</pub-id></citation></ref></ref-list></back><floats-wrap><fig id="f1-cin-02-113" position="float"><label>Figure 1.</label><caption><p>Cytokinetic model of a tumour cell. G<sub>1</sub>: G<sub>1</sub> (gap1) phase, S: DNA synthesis phase, G<sub>2</sub>: G<sub>2</sub> (gap 2) phase, M (mitosis), G<sub>0</sub>: resting phase, N: necrosis, SA: spontaneous apoptosis, RI-ID: radiation-induced interphase death, RI-MAD: radiation-induced mitotic apoptotic death, RI-MND: radiation-induced mitotic necrotic death.</p></caption><graphic xlink:href="CIN-02-113-g001"/></fig><fig id="f2-cin-02-113" position="float"><label>Figure 2.</label><caption><p>The number of alive tumor cells as a function of time for two hypothetical tumors differing in their p53 status. HART and CHART dose fractionation schedules. The curves corresponding to HART and CHART practically coincide over substantial time intervals for the same p53 gene status.</p></caption><graphic xlink:href="CIN-02-113-g002"/></fig><fig id="f3-cin-02-113" position="float"><label>Figure 3.</label><caption><p>The number of total tumor cells as a function of time for two hypothetical tumors differing in their p53 status. HART and CHART dose fractionation schedules. The curves corresponding to HART and CHART practically coincide for the same p53 gene status.</p></caption><graphic xlink:href="CIN-02-113-g003"/></fig><fig id="f4-cin-02-113" position="float"><label>Figure 4.</label><caption><p>3D reconstruction of the tumor with wt p53, 6 weeks after the beginning of the simulation: (a) HART radiotherapy scheme, (b) CHART radiotherapy scheme. Color code: red: proliferating cell region, green: G<sub>0</sub> cell region, blue: dead cell region.</p></caption><graphic xlink:href="CIN-02-113-g004"/></fig><fig id="f5-cin-02-113" position="float"><label>Figure 5.</label><caption><p>3D reconstruction of the tumor with mt p53, 6 weeks after the beginning of the simulation: (a) HART radiotherapy scheme, (b) CHART radiotherapy scheme. Color code: red: proliferating cell region, green: G<sub>0</sub> cell region, blue: dead cell region.</p></caption><graphic xlink:href="CIN-02-113-g005"/></fig><fig id="f6-cin-02-113" position="float"><label>Figure 6.</label><caption><p>Explorative HART and CHART radiotherapy simulations. Number of living tumor cells as a function of time, various CLF values.</p></caption><graphic xlink:href="CIN-02-113-g006"/></fig><fig id="f7-cin-02-113" position="float"><label>Figure 7.</label><caption><p>Explorative HART and CHART radiotherapy simulations. Number of dead tumor cells as a function of time, various CLF values.</p></caption><graphic xlink:href="CIN-02-113-g007"/></fig><fig id="f8-cin-02-113" position="float"><label>Figure 8.</label><caption><p>Explorative HART and CHART radiotherapy simulations. Total number of tumor cells as a function of time, various CLF values.</p></caption><graphic xlink:href="CIN-02-113-g008"/></fig></floats-wrap></article>