tion-type="journal"><person-group person-group-type="author"><name><surname>Shililu</surname><given-names>J</given-names></name><name><surname>Mbogo</surname><given-names>C</given-names></name><name><surname>Ghebremeskel</surname><given-names>T</given-names></name><name><surname>Githure</surname><given-names>J</given-names></name><name><surname>Novak</surname><given-names>R</given-names></name></person-group><article-title>Mosquito larval habitats in a semiarid ecosystem in Eritrea: impact of larval habitat management on Anopheles arabiensis population</article-title><source>Am J Trop Med Hyg</source><year>2007</year><volume>76</volume><fpage>103</fpage><lpage>110</lpage><pub-id pub-id-type="pmid">17255237</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fillinger</surname><given-names>U</given-names></name><name><surname>Lindsay</surname><given-names>SW</given-names></name></person-group><article-title>Suppression of exposure to malaria vectors by an order of magnitude using microbial larvicides in rural Kenya</article-title><source>Trop Med Int Health</source><year>2006</year><volume>11</volume><fpage>1629</fpage><lpage>1642</lpage><pub-id pub-id-type="pmid">17054742</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-3156.2006.01733.x</pub-id></citation></ref><ref id="B11"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Fillinger</surname><given-names>U</given-names></name><name><surname>Ndenga</surname><given-names>B</given-names></name><name><surname>Githeko</surname><given-names>A</given-names></name><name><surname>Lindsay</surname><given-names>SW</given-names></name></person-group><article-title>Integrated malaria vector control with microbial larvicides and insecticide treated nets in the western Kenyan highlands: a controlled trial</article-title><source>Bull World Health Organ</source><year>2008</year><comment></comment></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fillinger</surname><given-names>U</given-names></name><name><surname>Kannady</surname><given-names>K</given-names></name><name><surname>William</surname><given-names>G</given-names></name><name><surname>Vanek</surname><given-names>MJ</given-names></name><name><surname>Dongus</surname><given-names>S</given-names></name><name><surname>Nyika</surname><given-names>D</given-names></name><name><surname>Geissbuhler</surname><given-names>Y</given-names></name><name><surname>Chaki</surname><given-names>PP</given-names></name><name><surname>Govella</surname><given-names>NJ</given-names></name><name><surname>Mathenge</surname><given-names>EM</given-names></name><name><surname>Singer</surname><given-names>BH</given-names></name><name><surname>Mshinda</surname><given-names>H</given-names></name><name><surname>Lindsay</surname><given-names>SW</given-names></name><name><surname>Tanner</surname><given-names>M</given-names></name><name><surname>Mtasiwa</surname><given-names>D</given-names></name><name><surname>de Castro</surname><given-names>MC</given-names></name><name><surname>Killeen</surname><given-names>GF</given-names></name></person-group><article-title>A tool box for operational mosquito larval control: preliminary results and early lessons from the Urban Malaria Control Programme in Dar es Salaam, Tanzania</article-title><source>Malar J</source><year>2008</year><volume>7</volume><fpage>20</fpage><pub-id pub-id-type="pmid">18218148</pub-id><pub-id pub-id-type="doi">10.1186/1475-2875-7-20</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Geissb&#x000fc;hler</surname><given-names>Y</given-names></name><name><surname>Kannady</surname><given-names>K</given-names></name><name><surname>Chaki</surname><given-names>P</given-names></name><name><surname>Emidi</surname><given-names>B</given-names></name><name>