ion></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McKenzie</surname><given-names>DJ</given-names></name></person-group><article-title>Measuring inequality with asset indicators</article-title><source>Journal of Population Economics</source><year>2005</year><volume>18</volume><fpage>229</fpage><lpage>60</lpage></citation></ref><ref id="B24"><citation citation-type="book"><collab>National Statistical Service of the Republic of Armenia</collab><source>Social snapshot and poverty in Armenia.</source><year>2004</year><publisher-loc>Yerevan</publisher-loc><publisher-name>National Statistical Service of the Republic of Armenia</publisher-name></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nyman</surname><given-names>JA</given-names></name></person-group><article-title>Theory of health insurance</article-title><source>Journal of Health Administration Education</source><year>1998</year><volume>16</volume><fpage>41</fpage><lpage>66</lpage><pub-id pub-id-type="pmid">10185500</pub-id></citation></ref><ref id="B26"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Oxfam</surname><given-names>GB</given-names></name></person-group><source>Evaluation of the Revolving Drug Fund component of the community based Primary Health Care Programme of Oxfam, Armenia.</source><year>2000</year><publisher-loc>Oxford</publisher-loc><publisher-name>Oxfam (GB)</publisher-name></citation></ref><ref id="B27"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Poletti</surname><given-names>T</given-names></name><name><surname>Balabanova</surname><given-names>D</given-names></name></person-group><source>Options for scaling up community-based health insurance in Armenia. A research report.</source><year>2006</year><publisher-loc>Oxford</publisher-loc><publisher-name>Oxfam (GB)</publisher-name></c