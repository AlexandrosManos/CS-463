iven-names></name><name><surname>Pierce</surname><given-names>DA</given-names></name><name><surname>Shimizu</surname><given-names>Y</given-names></name><etal/></person-group><article-title>Effect of recent changes in atomic bomb survivor dosimetry on cancer mortality risk estimates</article-title><source>Radiat Res</source><year>2004</year><volume>162</volume><fpage>377</fpage><lpage>389</lpage><pub-id pub-id-type="pmid">15447045</pub-id></mixed-citation></ref><ref id="b10-wjem-9-0120"><label>10</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Herzog</surname><given-names>P</given-names></name><name><surname>Rieger</surname><given-names>CT</given-names></name></person-group><article-title>Risk of cancer from diagnostic X-rays</article-title><source>Lancet</source><year>2004</year><volume>363</volume><fpage>340</fpage><lpage>341</lpage><pub-id pub-id-type="pmid">15070557</pub-id></mixed-citation></ref><ref id="b11-wjem-9-0120"><label>11</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Haaga</surname><given-names>JR</given-names></name></person-group><article-title>Radiation dose management: Weighing risk versus benefit</article-title><source>AJR</source><year>2001</year><volume>177</volume><fpage>289</fpage><lpage>291</lpage><pub-id pub-id-type="pmid">11461847</pub-id></mixed-citation></ref><ref id="b12-wjem-9-0120"><label>12</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Brenner</surname><given-names>DJ</given-names></name><name><surname>Elliston</surname><given-names>CD</given-names></name><name><surname>Hall</surname><given-names>EJ</given-names></name><name><surname>Berdon</surname><given-names>WE</given-names></name></person-group><article-title>Estimated risks of radiation-induced fatal cancer from pediatric CT</article-title><source>AJR</source><year>2001</year><volume>176</volume><fpage>28