ource>Curr Opin Cardiol</source><year>2004</year><volume>19</volume><fpage>19</fpage><lpage>22</lpage><pub-id pub-id-type="pmid">14688629</pub-id></citation></ref><ref id="EUP054C16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Defaye</surname><given-names>P</given-names></name><name><surname>Dechaux</surname><given-names>D</given-names></name><name><surname>Machecourt</surname><given-names>J</given-names></name></person-group><article-title>Pacemaker and intra cardiac defibrillator lead extraction techniques</article-title><source>Ann Cardiol Angeiol (Paris)</source><year>2005</year><volume>54</volume><fpage>32</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15702909</pub-id></citation></ref><ref id="EUP054C17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mazzetti</surname><given-names>H</given-names></name><name><surname>Cichero</surname><given-names>CF</given-names></name><name><surname>Tentori</surname><given-names>MC</given-names></name><name><surname>Mascheroni</surname><given-names>O</given-names></name></person-group><article-title>Transjugular approach for lead extraction</article-title><source>Europace</source><year>2008</year><volume>10</volume><fpage>156</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">18256121</pub-id></citation></ref></ref-list></back></article>