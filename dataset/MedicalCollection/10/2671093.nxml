1">&#x02212;0.14<xref ref-type="table-fn" rid="TF2-1">*</xref></td><td rowspan="1" colspan="1"/><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.062</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;<italic>R</italic><sup>2</sup></td><td rowspan="1" colspan="1"/><td align="char" char="." rowspan="1" colspan="1">0.10</td><td align="char" char="." rowspan="1" colspan="1">0.114</td><td align="char" char="." rowspan="1" colspan="1">0.433</td><td align="char" char="." rowspan="1" colspan="1">0.371</td><td align="char" char="." rowspan="1" colspan="1">0.533</td></tr><tr><td align="left" rowspan="1" colspan="1">General well-being</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;Block 1</td><td align="left" rowspan="1" colspan="1">Sex</td><td align="char" char="." rowspan="1" colspan="1">0.296<xref ref-type="table-fn" rid="TF2-1">*</xref></td><td align="char" char="." rowspan="1" colspan="1">0.291<xref ref-type="table-fn" rid="TF2-1">*</xref></td><td align="char" char="." rowspan="1" colspan="1">0.159<xref ref-type="table-fn" rid="TF2-1">*</xref></td><td align="char" char="." rowspan="1" colspan="1">0.199<xref ref-type="table-fn" rid="TF2-1">*</xref></td><td align="char" char="." rowspan="1" colspan="1">0.129<xref ref-type="table-fn" rid="TF2-1">*</xref></td></tr><tr><td rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Age</td><td align="char" char="." rowspan="1" colspan="1">0.03</td><td align="char" char="." rowspan="1" colspan="1">0.025</td><td align="char" char="." rowspan="1" colspan="1">0.08</td><td align="char" char="." rowspan="1" colspan="1">0.02</td><td align="char" char="." rowspan="1" colspan="1">0.091<xref ref-type="table-fn" rid="TF2-2">&#x02020;</xref></td></tr><tr><td rowspan="1"