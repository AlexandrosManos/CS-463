</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bridges</surname><given-names>JF</given-names></name><name><surname>Jones</surname><given-names>C</given-names></name></person-group><article-title>Patient-based health technology assessment: A vision of the future</article-title><source>Int J Technol Assess Health Care</source><year>2007</year><volume>23</volume><fpage>30</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">17234014</pub-id><pub-id pub-id-type="doi">10.1017/S0266462307051549</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Abelson</surname><given-names>J</given-names></name><name><surname>Giacomini</surname><given-names>M</given-names></name><name><surname>Lehoux</surname><given-names>P</given-names></name><name><surname>Gauvin</surname><given-names>FP</given-names></name></person-group><article-title>Bringing 'the public' into health technology assessment and coverage policy decisions: from principles to practice</article-title><source>Health Policy</source><year>2007</year><volume>82</volume><fpage>37</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">16996637</pub-id><pub-id pub-id-type="doi">10.1016/j.healthpol.2006.07.009</pub-id></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gauvin</surname><given-names>FP</given-names></name></person-group><source>Public Involvement in Health Technology Assessment Agencies: A Comparative Analysis of Canada, Denmark, and the United Kingdom, PhD</source><year>2008</year><publisher-name>McMaster University, Hamilton (Ontario, Canada)</publisher-name></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cayton</surname><given-names>H</given-names></name></person-group><article-title>Patient and public involvement</article-