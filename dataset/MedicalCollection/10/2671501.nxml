ada</article-title><source>Health Policy</source><year>2004</year><volume>69</volume><fpage>253</fpage><lpage>268</lpage><pub-id pub-id-type="pmid">15212871</pub-id><pub-id pub-id-type="doi">10.1016/j.healthpol.2003.12.012</pub-id></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hailey</surname><given-names>D</given-names></name></person-group><source>Consumer involvement in health technology assessment</source><year>2005</year><publisher-name>Edmonton: Alberta Heritage Foundation for Medical Research. HTA Initiative #21</publisher-name></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liva</surname><given-names>A</given-names></name><name><surname>Coast</surname><given-names>J</given-names></name><name><surname>Donovan</surname><given-names>J</given-names></name><name><surname>Eyles</surname><given-names>J</given-names></name><name><surname>Shepherd</surname><given-names>J</given-names></name><name><surname>Tacchi</surname><given-names>J</given-names></name><name><surname>Abelson</surname><given-names>J</given-names></name><name><surname>Morgan</surname><given-names>K</given-names></name></person-group><article-title>'The public is too subjective': public involvement at different levels of health-care decision making</article-title><source>Soc Sci Med</source><year>2002</year><volume>54</volume><fpage>1825</fpage><lpage>1837</lpage><pub-id pub-id-type="pmid">12113438</pub-id><pub-id pub-id-type="doi">10.1016/S0277-9536(01)00151-4</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gravel</surname><given-names>K</given-names></name><name><surname>L&#x000e9;gar&#x000e9;</surname><given-names>F</given-names></name><name><surname>Graham</surname><given-names>ID</given-names></name></person-group><article-title>Barriers and facilitators to implementing shar