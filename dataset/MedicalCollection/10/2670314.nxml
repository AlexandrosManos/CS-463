-title>Primary monophasic synovial sarcoma presenting as a pulmonary mass: a case report</article-title><source>J Med Case Reports</source><year>2008</year><volume>24</volume><fpage>18</fpage><pub-id pub-id-type="pmid">18218098</pub-id><pub-id pub-id-type="doi">10.1186/1752-1947-2-18</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tacconi</surname><given-names>L</given-names></name><name><surname>Thom</surname><given-names>M</given-names></name><name><surname>Thomas</surname><given-names>DG</given-names></name></person-group><article-title>Primary monophasic synovial sarcoma of the brachial plexus: report of a case and review of the literature</article-title><source>Clin Neurol Neurosurg</source><year>1996</year><volume>98</volume><fpage>249</fpage><lpage>52</lpage><pub-id pub-id-type="pmid">8884099</pub-id><pub-id pub-id-type="doi">10.1016/0303-8467(96)00020-0</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zenmyo</surname><given-names>M</given-names></name><name><surname>Komiya</surname><given-names>S</given-names></name><name><surname>Hamada</surname><given-names>T</given-names></name><name><surname>Hiraoka</surname><given-names>K</given-names></name><name><surname>Nagata</surname><given-names>K</given-names></name><name><surname>Tsuji</surname><given-names>S</given-names></name><name><surname>Hashimoto</surname><given-names>H</given-names></name><name><surname>Inoue</surname><given-names>A</given-names></name></person-group><article-title>Intraneural monophasic synovial sarcoma: a case report</article-title><source>Spine</source><year>2001</year><volume>26</volume><fpage>310</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">11224869</pub-id><pub-id pub-id-type="doi">10.1097/00007632-200102010-00018</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="