unstructured">Cox JP (2001) Long-term data storage in DNA. Trends Biotechnol 19:247&#x02013;250. doi:10.1016/S0167-7799(01)01671-7 <pub-id pub-id-type="pmid">11412947</pub-id></citation></ref><ref id="CR10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hall</surname><given-names>N</given-names></name></person-group><article-title>Advanced sequencing technologies and their wider impact in microbiology</article-title><source>J Exp Biol</source><year>2007</year><volume>210</volume><fpage>1518</fpage><lpage>1525</lpage><pub-id pub-id-type="doi">10.1242/jeb.001370</pub-id></citation><citation citation-type="display-unstructured">Hall N (2007) Advanced sequencing technologies and their wider impact in microbiology. J Exp Biol 210:1518&#x02013;1525. doi:10.1242/jeb.001370 <pub-id pub-id-type="pmid">17449817</pub-id></citation></ref><ref id="CR11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heider</surname><given-names>D</given-names></name><name><surname>Barnekow</surname><given-names>A</given-names></name></person-group><article-title>DNA-based watermarks using the DNA-Crypt algorithm</article-title><source>BMC Bioinformatics</source><year>2007</year><volume>8</volume><fpage>176</fpage><pub-id pub-id-type="doi">10.1186/1471-2105-8-176</pub-id></citation><citation citation-type="display-unstructured">Heider D, Barnekow A (2007a) DNA-based watermarks using the DNA-Crypt algorithm. BMC Bioinformatics 8:176. doi:10.1186/1471-2105-8-176 <pub-id pub-id-type="pmid">17535434</pub-id></citation></ref><ref id="CR12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heider</surname><given-names>D</given-names></name><name><surname>Barnekow</surname><given-names>A</given-names></name></person-group><article-title>DNA watermarks: a proof of concept</article-title><source>BMC Mol Biol</source><year>2007</year><volume>9</volume><fpage>40</fpage><pub-id pub-id