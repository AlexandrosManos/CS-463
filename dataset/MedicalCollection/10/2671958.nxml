ef id="b15-ndt-2-467"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldman</surname><given-names>LS</given-names></name><name><surname>Genel</surname><given-names>M</given-names></name><name><surname>Bezman</surname><given-names>RJ</given-names></name><etal/></person-group><year>1998</year><article-title>Diagnosis and treatment of attention-deficit/hyperactivity disorder in children and adolescents. Council on Scientific Affairs, American Medical Association</article-title><source>JAMA</source><volume>279</volume><fpage>1100</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">9546570</pub-id></citation></ref><ref id="b16-ndt-2-467"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Greenhill</surname><given-names>LL</given-names></name><name><surname>Pliszka</surname><given-names>S</given-names></name><name><surname>Dulcan</surname><given-names>MK</given-names></name><etal/></person-group><year>2002</year><article-title>American Academy of Child and Adolescent Psychiatry. Practice parameter for use of stimulant medications in the treatment of children, adolescents, and adults</article-title><source>J Am Acad Child Adolesc Psychiatry</source><volume>41</volume><issue>Suppl 2</issue><fpage>26</fpage><lpage>49S</lpage></citation></ref><ref id="b17-ndt-2-467"><citation citation-type="confproc"><person-group person-group-type="author"><name><surname>Greenhill</surname><given-names>L</given-names></name><etal/></person-group><year>2005</year><source>Extended-release dexmethylphenidate in child and adolescent with ADHD</source><conf-name>158th Annual Meeting of the American Psychiatric Association</conf-name><conf-date>May 21&#x02013;25, 2005</conf-date><conf-loc>Atlanta, GA, USA</conf-loc></citation></ref><ref id="b18-ndt-2-467"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guevara</surname><given-names>J</given-names></name><name><surname>Lozano</surname><given-names>P</given-names></name><name><surname>Wickizer</surname></name><etal/></person-group><year>2002</year><article-title>Psychotropic medication use in a population of children who have attention-deficit/hyperactivity disorder</article-title><source>Pediatrics</source><volume>109</volume><fpage>733</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">11986429</pub-id></citation></ref><ref id="b19-ndt-2-467"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hubbard</surname><given-names>JW</given-names></name><name><surname>Srinivas</surname><given-names>NR</given-names></name><name><surname>Quinn</surname><given-names>D</given-names></name><etal/></person-group><year>1989</year><article-title>Enantioselective aspects of the disposition of d.l-threo-methylphenidate after the administration of a sustained-release formulation to children with attention deficit-hyperactivity disorder</article-title><source>J Pharma Science</source><volume>78</volume><fpage>944</fpage><lpage>7</lpage></citation></ref><ref id="b20-ndt-2-467"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Keating</surname><given-names>GM</given-names></name><name><surname>Figgitt</surname><given-names>DP</given-names></name></person-group><year>2002</year><article-title>Dexmethylphenidate</article-title><source>Drugs</source><volume>62</volume><fpage>1899</fpage><lpage>904</lpage>discussion 1905&#x02013;8.<pub-id pub-id-type="pmid">12215063</pub-id></citation></ref><ref id="b21-ndt-2-467"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kilbourn</surname><given-names>MR</given-names></name></person-group><year>2004</year><article-title>Long-term reproducibility of in vivo measures of specific binding of radioligands in rat brain</article-title><source>Nucl Med Biol</source><volume>31</volume><fpage>591</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">15219277</pub-id></c