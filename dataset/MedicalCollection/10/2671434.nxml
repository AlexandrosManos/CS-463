pub-id-type="pmid">18583059</pub-id></citation></ref><ref id="R15"><label>15. </label><citation citation-type="journal"><string-name><surname>Dubey</surname> <given-names>JP</given-names></string-name>, <string-name><surname>Zhu</surname> <given-names>XQ</given-names></string-name>, <string-name><surname>Sundar</surname> <given-names>N</given-names></string-name>, <string-name><surname>Zhang</surname> <given-names>H</given-names></string-name>, <string-name><surname>Kwok</surname> <given-names>OC</given-names></string-name>, <string-name><surname>Su</surname> <given-names>C</given-names></string-name> <article-title>Genetic and biologic characterization of <italic>Toxoplasma gondii</italic> isolates of cats from China.</article-title><source>Vet Parasitol</source> <year>2007</year>;<volume>145</volume>:<fpage>352</fpage>&#x02013;<lpage>6</lpage> <pub-id pub-id-type="doi">10.1016/j.vetpar.2006.12.016</pub-id><pub-id pub-id-type="pmid">17267132</pub-id></citation></ref></ref-list></back></article>