ng</td><td align="center" rowspan="1" colspan="1">10</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>&#x02003;</italic>Gastrointestinal</td><td align="center" rowspan="1" colspan="1">10</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>&#x02003;</italic>Head/neck</td><td align="center" rowspan="1" colspan="1">3</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>&#x02003;</italic>Miscellaneous</td><td align="center" rowspan="1" colspan="1">6</td></tr></tbody></table></table-wrap><table-wrap id="tab3" position="float"><label>Table 3</label><caption><p>Dose-limitinggrade III/IV toxicities (<italic>N</italic> = 50).</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1">Toxicities</th><th align="center" rowspan="1" colspan="1">Numberof patients (%)</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">Neutropenia</td><td align="center" rowspan="1" colspan="1">29 (58)</td></tr><tr><td align="left" rowspan="1" colspan="1">Thrombocytopenia</td><td align="center" rowspan="1" colspan="1">8 (16)</td></tr><tr><td align="left" rowspan="1" colspan="1">Diarrhea</td><td align="center" rowspan="1" colspan="1">4 (8)</td></tr><tr><td align="left" rowspan="1" colspan="1">Nausea/emesis</td><td align="center" rowspan="1" colspan="1">4 (8)</td></tr><tr><td align="left" rowspan="1" colspan="1">Asthenia</td><td align="center" rowspan="1" colspan="1">2 (4)</td></tr></tbody></table></table-wrap><table-wrap id="tab4" position="float"><label>Table 4</label><caption><p>Tumor types and best response to treatment. PR: partial response; SD: stabledisease; PD: progressive disease; NA: not assessable.</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2" colspan="1">Tumor types</th><th align="center" colspan="5" rowspan="1">Numberof patients</th></tr><tr><th align="center" rowspan="1" colspan="1">Total</th><th align="center" rowspan="1" colspan="1">PR</th><th align="