>1991</year><volume>36</volume><fpage>581</fpage><lpage>605</lpage><pub-id pub-id-type="pmid">1839804</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Merdes</surname><given-names>A</given-names></name><name><surname>Cleveland</surname><given-names>DW</given-names></name></person-group><article-title>The role of NuMA in the interphase nucleus</article-title><source>J Cell Sci</source><year>1998</year><volume>111</volume><fpage>71</fpage><lpage>79</lpage><pub-id pub-id-type="pmid">9394013</pub-id></citation></ref></ref-list></back></article>