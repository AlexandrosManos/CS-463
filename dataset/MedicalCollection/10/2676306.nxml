ng</article-title><source>Plant Physiol</source><year>2003</year><volume>132</volume><fpage>469</fpage><lpage>484</lpage><pub-id pub-id-type="pmid">12805580</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brendel</surname><given-names>V</given-names></name><name><surname>Xing</surname><given-names>L</given-names></name><name><surname>Zhu</surname><given-names>W</given-names></name></person-group><article-title>Gene structure prediction from consensus spliced alignment of multiple ESTs matching the same genomic locus</article-title><source>Bioinformatics</source><year>2004</year><volume>20</volume><fpage>1157</fpage><lpage>1169</lpage><pub-id pub-id-type="pmid">14764557</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jain</surname><given-names>M</given-names></name><name><surname>Shrager</surname><given-names>J</given-names></name><name><surname>Harris</surname><given-names>EH</given-names></name><name><surname>Halbrook</surname><given-names>R</given-names></name><name><surname>Grossman</surname><given-names>AR</given-names></name><name><surname>Hauser</surname><given-names>C</given-names></name><name><surname>Vallon</surname><given-names>O</given-names></name></person-group><article-title>EST assembly supported by a draft genome sequence: an analysis of the Chlamydomonas reinhardtii transcriptome</article-title><source>Nucleic Acids Res</source><year>2007</year><volume>35</volume><fpage>2074</fpage><lpage>2083</lpage><pub-id pub-id-type="pmid">17355987</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haas</surname><given-names>BJ</given-names></name><name><surname>Delcher</surname><given-names>AL</given-names></name><name><surname>Mount</surname><given-names>SM</given-names></name><name><surname>Wortman</surname><given-names>JR<