citation></ref><ref id="B8"><mixed-citation publication-type="journal"><name><surname>Ma</surname><given-names>H</given-names></name><name><surname>Croudace</surname><given-names>JE</given-names></name><name><surname>Lammas</surname><given-names>DA</given-names></name><name><surname>May</surname><given-names>RC</given-names></name><article-title>Expulsion of live pathogenic yeast by macrophages</article-title><source>Curr Biol</source><year>2006</year><volume>16</volume><issue>21</issue><fpage>2156</fpage><lpage>2160</lpage><pub-id pub-id-type="doi">10.1016/j.cub.2006.09.032</pub-id><pub-id pub-id-type="pmid">17084701</pub-id></mixed-citation></ref><ref id="B9"><mixed-citation publication-type="journal"><name><surname>Alvarez</surname><given-names>M</given-names></name><name><surname>Casadevall</surname><given-names>A</given-names></name><article-title>Cell-to-cell spread and massive vacuole formation after Cryptococcus neoformans infection of murine macrophages</article-title><source>BMC Immunol</source><year>2007</year><volume>8</volume><issue>1</issue><fpage>16</fpage><pub-id pub-id-type="pmid">17705844</pub-id><pub-id pub-id-type="doi">10.1186/1471-2172-8-16</pub-id></mixed-citation></ref><ref id="B10"><mixed-citation publication-type="journal"><name><surname>Ma</surname><given-names>H</given-names></name><name><surname>Croudace</surname><given-names>JE</given-names></name><name><surname>Lammas</surname><given-names>DA</given-names></name><name><surname>May</surname><given-names>RC</given-names></name><article-title>Direct cell-to-cell spread of a pathogenic yeast</article-title><source>BMC Immunol</source><year>2007</year><volume>8</volume><fpage>15</fpage><pub-id pub-id-type="pmid">17705831</pub-id><pub-id pub-id-type="doi">10.1186/1471-2172-8-15</pub-id></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><name><surname>Casadevall</surname><given-names>A</given-names></name><name><surname>Pirofski</surname><given-names>LA</given-nam