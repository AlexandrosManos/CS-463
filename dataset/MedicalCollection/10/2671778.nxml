></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">clomipramine</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">clozapine</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">desipramine</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">duloxetine</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">fluoxetine</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">haloperidol</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">imipramine</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">paroxetine</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">pergolide</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">ropinirole</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">sertraline</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">trazodone</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">verapamil</td></tr></tbody></table></table-wrap><table-wrap id="t2-ndt-2-127" position="float"><label>Table 2</label><caption><p>Double-blind trials of risperidone in bipolar disorder</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" valign="bottom" rowspan="1" colspan="1">Authors</th><th align="left" valign="bottom" rowspan="1" colspan="1">Study phase</th><th align="right" valign="bottom" rowspan="1" colspan="1">Number of subjects</th><th align="left" valign="bottom" rowspan="1" colspan="1">Duration</th><th align="left" valign="bottom" rowspan="1" colspan="1">Efficacy results</th></tr><