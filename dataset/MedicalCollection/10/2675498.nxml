her-name><publisher-loc>London</publisher-loc><fpage>93</fpage><lpage>158</lpage></citation></ref><ref id="b9-cin-02-87"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gleason</surname><given-names>DF</given-names></name><name><surname>Mellinger</surname><given-names>GT</given-names></name></person-group><year>1974</year><article-title>Prediction of prognosis for prostatic adenocarcinoma by combined histological grading and clinical staging</article-title><source>J Urology</source><volume>111</volume><issue>1</issue><fpage>58</fpage><lpage>64</lpage></citation></ref><ref id="b10-cin-02-87"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gleason</surname><given-names>DF</given-names></name></person-group><year>1977</year><article-title>Histologic grading and clinical staging of prostatic carcinoma</article-title><person-group person-group-type="editor"><name><surname>Tannenbaum</surname><given-names>M</given-names></name></person-group><source>UrologicPathology: The Prostate</source><publisher-name>Lea and Febiger</publisher-name><publisher-loc>Philadelphia</publisher-loc><fpage>171</fpage><lpage>197</lpage></citation></ref><ref id="b11-cin-02-87"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ghosh</surname><given-names>D</given-names></name><name><surname>Barette</surname><given-names>TR</given-names></name><name><surname>Rhodes</surname><given-names>D</given-names></name><name><surname>Chinnaiyan</surname><given-names>AM</given-names></name></person-group><year>2003</year><article-title>Statistical issues and methods for meta-analysis of microarray data: a case study in prostate cancer</article-title><source>Funct Integr Genomics</source><volume>3</volume><issue>4</issue><fpage>180</fpage><lpage>188</lpage><pub-id pub-id-type="pmid">12884057</pub-id></citation></ref><ref id="b12-cin-02-87"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Golub</surname><given-names>TR</given-names></name><name><surname>Slonim</surname><given-names>DK</given-names></name><name><surname>Tamayo</surname><given-names>P</given-names></name><name><surname>Huard</surname><given-names>C</given-names></name><name><surname>Gaasenbeek</surname><given-names>M</given-names></name><name><surname>Mesirov</surname><given-names>JP</given-names></name><name><surname>Coller</surname><given-names>H</given-names></name><name><surname>Loh</surname><given-names>ML</given-names></name><name><surname>Downing</surname><given-names>JR</given-names></name><name><surname>Caligiuri</surname><given-names>MA</given-names></name><name><surname>Bloomfield</surname><given-names>CD</given-names></name><name><surname>Lander</surname><given-names>ES</given-names></name></person-group><year>1999</year><article-title>Molecular classification of cancer: class discovery and class prediction by gene expression monitoring</article-title><source>Science</source><month>10</month><day>15</day><volume>286</volume><issue>5439</issue><fpage>531</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">10521349</pub-id></citation></ref><ref id="b13-cin-02-87"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guyon</surname><given-names>I</given-names></name><name><surname>Elisseeff</surname><given-names>A</given-names></name></person-group><year>2003</year><article-title>An introduction to variable and feature selection</article-title><source>Journal of Machine Learning Research</source><volume>3</volume><fpage>1157</fpage><lpage>82</lpage></citation></ref><ref id="b14-cin-02-87"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hauskrecht</surname><given-names>Milos</given-names></name><name><surname>Pelikan</surname><given-names>Richard</given-names></name><name><surname>Malehorn</surname><given-names>David E</given-names></name><name><surname>Bigbee</surname><given-names>William L</given-names></name><name><surname>Lotze</surname><given-names>Michael T</given-names></name><name><surname>Zeh</surname><given-names>Herbert J</given-names><suffix>III</suffix></name><name><surname>Whitcomb</surname><given-names>David C</given-names></name><name><surname>Lyons-Weiler</surname><given-names>James</given-names></name></person-group><year>2005</year><article-title>Feature Selection for Classification of SELDITOF-MS Proteomic Profiles</article-title><source>Appl Bioinformatics</source><volume>4</volume><issue>4</issue><fpage>227</fpage><lpage>46</lpage><pub-id pub-id-type="pmid">16309341</pub-id></citation></ref><ref id="b15-cin-02-87"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Inza</surname><given-names>I</given-names></name><name><surname>Larranaga</surname><given-names>P</given-names></name><name><surname>Blanco</surname><given-names>R</given-names></name><name><surname>Cerrolaza</surname><given-names>AJ</given-names></name></person-group><year>2004</year><article-title>Filter versus wrapper gene selection approaches in DNA microarray domains</article-title><source>Artif Intell Med</source><month>6</month><volume>31</volume><issue>2</issue><fpage>91</fpage><lpage>103</lpage><pub-id pub-id-type="pmid">15219288</pub-id></citation></ref><ref id="b16-cin-02-87"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lapointe</surname><given-names>J</given-names></name><name><surname>Li</surname><given-names>C</given-names></name><name><surname>Higgins</surname><given-names>JP</given-names></name><name><surname>van de Rijn</surname><given-names>M</given-names></name><name><surname>Bair</surname><given-names>E</given-names></name><name><surname>Montgomery</surname><given-names>K</given-names></name><name><surname>Ferrari</surname><given-names>M</given-names></name><name><surname>Egevad</surname><given-names>L</given-names></name><name><surname>Rayfor