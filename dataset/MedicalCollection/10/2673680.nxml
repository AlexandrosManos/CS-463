><name><surname>Harris</surname><given-names>WS</given-names></name><name><surname>Reid</surname><given-names>KJ</given-names></name><name><surname>Sands</surname><given-names>SA</given-names></name><name><surname>Spertus</surname><given-names>JA</given-names></name></person-group><year>2007</year><article-title>EPA and DHA in blood cell membranes from acute coronary syndrome patients and controls.</article-title><source>Atherosclerosis</source></citation></ref><ref id="pone.0005444-Albert1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Albert</surname><given-names>CM</given-names></name><name><surname>Campos</surname><given-names>H</given-names></name><name><surname>Stampfer</surname><given-names>MJ</given-names></name><name><surname>Ridker</surname><given-names>PM</given-names></name><name><surname>Manson</surname><given-names>JE</given-names></name><etal/></person-group><year>2002</year><article-title>Blood levels of long-chain n-3 fatty acids and the risk of sudden death.</article-title><source>N Engl J Med</source><volume>346</volume><fpage>1113</fpage><lpage>1118</lpage><pub-id pub-id-type="pmid">11948270</pub-id></citation></ref><ref id="pone.0005444-Siscovick1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Siscovick</surname><given-names>DS</given-names></name><name><surname>Raghunathan</surname><given-names>TE</given-names></name><name><surname>King</surname><given-names>I</given-names></name><name><surname>Weinmann</surname><given-names>S</given-names></name><name><surname>Wicklund</surname><given-names>KG</given-names></name><etal/></person-group><year>1995</year><article-title>Dietary intake and cell membrane levels of long-chain n-3 polyunsaturated fatty acids and the risk of primary cardiac arrest.</article-title><source>Jama</source><volume>274</volume><fpage>1363</fpage><lpage>1367</lpage><pub-id pub-id-type="pmid">7563561</pub-id