><surname>Benson</surname><given-names>WG</given-names></name><name><surname>Chambers</surname><given-names>JK</given-names></name><name><surname>Eilert</surname><given-names>MM</given-names></name><name><surname>Ellis</surname><given-names>C</given-names></name><name><surname>Elshourbagy</surname><given-names>NA</given-names></name><name><surname>Goetz</surname><given-names>AS</given-names></name><name><surname>Minnick</surname><given-names>DT</given-names></name><name><surname>Murdock</surname><given-names>PR</given-names></name><name><surname>Sauls</surname><given-names>HR</given-names><suffix>Jr</suffix></name><name><surname>Shabon</surname><given-names>U</given-names></name><name><surname>Spinage</surname><given-names>LD</given-names></name><name><surname>Strum</surname><given-names>JC</given-names></name><name><surname>Szekeres</surname><given-names>PG</given-names></name><name><surname>Tan</surname><given-names>KB</given-names></name><name><surname>Way</surname><given-names>JM</given-names></name><name><surname>Ignar</surname><given-names>DM</given-names></name><name><surname>Wilson</surname><given-names>S</given-names></name><name><surname>Muir</surname><given-names>AI</given-names></name></person-group>:<article-title>The orphan G protein-coupled receptor GPR40 is activated by medium and long chain fatty acids</article-title>.<source>J Biol Chem</source><year>2003</year>;<volume>278</volume>:<fpage>11303</fpage>&#x02013;<lpage>11311</lpage><pub-id pub-id-type="pmid">12496284</pub-id></citation></ref><ref id="B10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kotarsky</surname><given-names>K</given-names></name><name><surname>Nilsson</surname><given-names>NE</given-names></name><name><surname>Flodgren</surname><given-names>E</given-names></name><name><surname>Owman</surname><given-names>C</given-names></name><name><surname>Olde</surname><given-names>B</given-names></name></person-group>:<article-ti