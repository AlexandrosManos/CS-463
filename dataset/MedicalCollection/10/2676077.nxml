pe="journal"><person-group person-group-type="author"><name><surname>Chuang</surname><given-names>WC</given-names></name><name><surname>Short</surname><given-names>JH</given-names></name><name><surname>McKinney</surname><given-names>AM</given-names></name><name><surname>Anker</surname><given-names>L</given-names></name><name><surname>Knoll</surname><given-names>B</given-names></name><name><surname>McKinney</surname><given-names>ZJ</given-names></name></person-group><article-title>Reversible left hemispheric ischemia secondary to carotid compression in Eagle syndrome: surgical and CT angiographic correlation</article-title><source>Am J Neuroradiol</source><year>2007</year><volume>28</volume><fpage>143</fpage><lpage>145</lpage><pub-id pub-id-type="pmid">17213444</pub-id></citation></ref><ref id="b14-dent03_p0155"><label>14.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Balbuena</surname><given-names>L</given-names><suffix>Jr</suffix></name><name><surname>Hayes</surname><given-names>D</given-names></name><name><surname>Ramirez</surname><given-names>SG</given-names></name><name><surname>Johnson</surname><given-names>R</given-names></name></person-group><article-title>Eagle&#x02019;s syndrome (elongated styloid process)</article-title><source>South Med J</source><year>1997</year><volume>90</volume><fpage>331</fpage><lpage>334</lpage><pub-id pub-id-type="pmid">9076308</pub-id></citation></ref><ref id="b15-dent03_p0155"><label>15.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fini</surname><given-names>G</given-names></name><name><surname>Gasparini</surname><given-names>G</given-names></name><name><surname>Filippini</surname><given-names>F</given-names></name><name><surname>Becelli</surname><given-names>R</given-names></name><name><surname>Marcotullio</surname><given-names>D</given-names></name></person-group><article-title>The long styloid process syndrome or Eagle&#x02019;s syndrome</article-title><source>J Craniomaxillofac Surg</source><year>2000</year><volume>28</volume><fpage>123</fpage><lpage>127</lpage><pub-id pub-id-type="pmid">10958426</pub-id></citation></ref><ref id="b16-dent03_p0155"><label>16.</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Favus</surname><given-names>MJ</given-names></name><name><surname>Vokes</surname><given-names>TJ</given-names></name></person-group><article-title>Paget disease and other dysplasias of bone</article-title><person-group person-group-type="editor"><name><surname>Jameson</surname><given-names>JL</given-names></name></person-group><source>Harrison&#x02019;s endocrinology</source><publisher-loc>USA</publisher-loc><publisher-name>McGraw-Hill Companies</publisher-name><year>2006</year><fpage>485</fpage><lpage>498</lpage></citation></ref></ref-list></back><floats-wrap><fig id="f1-dent03_p0155" position="float"><label>Figure 1.</label><caption><p>Bileteral styloid process elongation in an end-stage renal disease patient with peritoneal dialysis on a panoramic radiography.</p></caption><graphic xlink:href="p156_fig1"/></fig></floats-wrap></article>