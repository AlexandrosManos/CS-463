l"><person-group person-group-type="author"><name><surname>Teo</surname><given-names>KK</given-names></name><name><surname>Burton</surname><given-names>JR</given-names></name><name><surname>Buller</surname><given-names>C</given-names></name><name><surname>Plante</surname><given-names>S</given-names></name><name><surname>Yokoyama</surname><given-names>S</given-names></name><name><surname>Montague</surname><given-names>TJ</given-names></name></person-group><article-title>Rationale and design features of a clinical trial examining the effects of cholesterol lowering and angiotensin-converting enzyme inhibition on coronary atherosclerosis: Simvastatin/Enalapril Coronary Atherosclerosis Trial (SCAT). SCAT Investigators</article-title><source>Can J Cardiol</source><year>1997</year><volume>13</volume><issue>6</issue><fpage>591</fpage><lpage>599</lpage><pub-id pub-id-type="pmid">9215232</pub-id></citation></ref><ref id="b28-vhrm-5-021"><label>28.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mann</surname><given-names>JF</given-names></name><name><surname>Schmieder</surname><given-names>RE</given-names></name><name><surname>McQueen</surname><given-names>M</given-names></name><etal/></person-group><article-title>Renal outcomes with telmisartan, ramipril, or both, in people at high vascular risk (the ONTARGET study): a multicentre, randomised, double-blind, controlled trial</article-title><source>Lancet</source><year>2008</year><volume>372</volume><issue>9638</issue><fpage>547</fpage><lpage>553</lpage><pub-id pub-id-type="pmid">18707986</pub-id></citation></ref><ref id="b29-vhrm-5-021"><label>29.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yusuf</surname><given-names>S</given-names></name><name><surname>Diener</surname><given-names>HC</given-names></name><name><surname>Sacco</surname><given-names>RL</given-names></name><etal/></person-group><article-title>Telmisartan to pre