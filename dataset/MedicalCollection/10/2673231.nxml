tle>Competency standards for public health practice. A report prepared by the Human Capital Alliance, Canberra</article-title><year>2007</year></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clark</surname><given-names>NM</given-names></name><name><surname>Weist</surname><given-names>E</given-names></name></person-group><article-title>Mastering the new public health</article-title><source>Am J Public Health</source><year>2000</year><volume>90</volume><fpage>1208</fpage><lpage>1211</lpage><pub-id pub-id-type="pmid">10936997</pub-id><pub-id pub-id-type="doi">10.2105/AJPH.90.8.1208</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Riegelman</surname><given-names>R</given-names></name><name><surname>Teitelbaum</surname><given-names>J</given-names></name><name><surname>Persily</surname><given-names>N</given-names></name></person-group><article-title>Public health degrees &#x02013; not just for graduate students</article-title><source>Public Health Rep</source><year>2002</year><volume>117</volume><fpage>485</fpage><lpage>488</lpage><pub-id pub-id-type="pmid">12500967</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mor</surname><given-names>V</given-names></name><name><surname>Rakowski</surname><given-names>W</given-names></name><name><surname>Wetle</surname><given-names>TF</given-names></name></person-group><article-title>Retaining program diversity in undergraduate public health education</article-title><source>J Public Health Manag Practice</source><year>2008</year><volume>14</volume><fpage>3</fpage><lpage>5</lpage></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brouse</surname><given-names>CH</given-names></name></person-group><article-title>Promoting discussions about cultural competence in an undergraduate health course</article-title><source>Health Education Journal</source><year>2007</year><volume>66</volume><fpage>179</fpage><lpage>187</lpage><pub-id pub-id-type="doi">10.1177/0017896907076761</pub-id></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Trevena</surname><given-names>LJ</given-names></name></person-group><article-title>Problem-based learning in public health workforce training: A discussion of educational principles and evidence</article-title><source>Public Health Bulletin</source><year>2007</year><volume>18</volume><fpage>3</fpage><lpage>8</lpage><pub-id pub-id-type="doi">10.1071/NB07007</pub-id></citation></ref><ref id="B32"><citation citation-type="book"><source>Consensus Conference on Undergraduate Public Health Education</source><year>2006</year><publisher-name>Boston, MA. Sponsored by: Council of Colleges of Arts and Science, Association of Schools of Public Health, Association for Prevention Teaching and Research</publisher-name></citation></ref><ref id="B33"><citation citation-type="other"><article-title>Asia Pacific Academic Consortium of Public Health</article-title><ext-link ext-link-type="uri" xlink:href="http://www.apacph.org/site/pages/Curriculum_Development"/></citation></ref><ref id="B34"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gebbie</surname><given-names>K</given-names></name><name><surname>Rosenstock</surname><given-names>L</given-names></name><name><surname>Hernandez</surname><given-names>LM</given-names></name></person-group><source>Who will keep the public healthy? Educating public health professionals for the 21st Century</source><year>2003</year><publisher-name>Washington DC: Institute of Medicine, National Academy Press</publisher-name></citation></ref></ref-list></back></article>