e><surname>Bild</surname><given-names>DE</given-names></name><name><surname>Mittelmark</surname><given-names>MB</given-names></name><name><surname>Polak</surname><given-names>JF</given-names></name><name><surname>Robbins</surname><given-names>JA</given-names></name><name><surname>Gardin</surname><given-names>JM</given-names></name></person-group><article-title>Risk factors for 5-year mortality in older adults: the Cardiovascular Health Study</article-title><source>Jama</source><year>1998</year><volume>279</volume><issue>8</issue><fpage>585</fpage><lpage>92</lpage><pub-id pub-id-type="pmid">9486752</pub-id><pub-id pub-id-type="doi">10.1001/jama.279.8.585</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gillum</surname><given-names>RF</given-names></name></person-group><article-title>Assessment of serum albumin concentration as a risk factor for stroke and coronary disease in African Americans and whites</article-title><source>J Natl Med Assoc</source><year>2000</year><volume>92</volume><issue>1</issue><fpage>3</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">10800280</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gillum</surname><given-names>RF</given-names></name><name><surname>Ingram</surname><given-names>DD</given-names></name><name><surname>Makuc</surname><given-names>DM</given-names></name></person-group><article-title>Relation between serum albumin concentration and stroke incidence and death: the NHANES I Epidemiologic Follow-up Study</article-title><source>Am J Epidemiol</source><year>1994</year><volume>140</volume><issue>10</issue><fpage>876</fpage><lpage>88</lpage><pub-id pub-id-type="pmid">7977275</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldwasser</surname><given-names>P</given-names></name><name><surname>Fel