itle>A computer interview for suicide risk prediction</article-title><source>American Journal of Psychiatry</source><year>1973</year><volume>130</volume><fpage>1327</fpage><lpage>32</lpage><pub-id pub-id-type="pmid">4585280</pub-id></mixed-citation></ref><ref id="B29"><mixed-citation publication-type="journal"><name><surname>Angle</surname><given-names>HV</given-names></name><name><surname>Ellinwood</surname><given-names>E</given-names></name><article-title>A Psychiatric Assessment-Treatment-Outcome Information System: Evaluation with Computer Simulation</article-title><source>Ellinwood Proc Annu Symp Comput Appl Med Care</source><year>1978</year><volume>9</volume><fpage>149</fpage><lpage>59</lpage></mixed-citation></ref><ref id="B30"><mixed-citation publication-type="journal"><name><surname>Carr</surname><given-names>AC</given-names></name><name><surname>Ghosh</surname><given-names>A</given-names></name><article-title>Response of phobic patients to direct computer assessment</article-title><source>The British Journal of Psychiatry</source><year>1983</year><volume>142</volume><fpage>60</fpage><lpage>65</lpage><pub-id pub-id-type="pmid">6831131</pub-id></mixed-citation></ref><ref id="B31"><mixed-citation publication-type="journal"><name><surname>Petrie</surname><given-names>K</given-names></name><name><surname>Abell</surname><given-names>W</given-names></name><article-title>Responses of parasuicides to a computerized interview</article-title><source>computers in Human Behavior</source><year>1994</year><volume>10</volume><fpage>415</fpage><lpage>418</lpage></mixed-citation></ref><ref id="B32"><mixed-citation publication-type="journal"><name><surname>Kobak</surname><given-names>KA</given-names></name><name><surname>Reynolds</surname><given-names>WM</given-names></name><name><surname>Greist</surname><given-names>JH</given-names></name><article-title>Computerized and clinician assessment of depression and anxiety: Respondent evaluation and satisfaction</article-title><so