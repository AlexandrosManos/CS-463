><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Teklehaimanot</surname><given-names>A</given-names></name><name><surname>Sachs</surname><given-names>JD</given-names></name><name><surname>Curtis</surname><given-names>C</given-names></name></person-group><article-title>Malaria control needs mass distribution of insecticidal bednets</article-title><source>Lancet</source><year>2007</year><volume>369</volume><fpage>2143</fpage><lpage>2146</lpage><pub-id pub-id-type="pmid">17597200</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(07)60951-9</pub-id></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><collab>SMARTNET</collab></person-group><year>2005</year><publisher-name>National Malaria Control Programme United Republic of Tanzania</publisher-name></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maxwell</surname><given-names>CA</given-names></name><name><surname>Chambo</surname><given-names>W</given-names></name><name><surname>Mwaimu</surname><given-names>M</given-names></name><name><surname>Magogo</surname><given-names>F</given-names></name><name><surname>Carneiro</surname><given-names>IA</given-names></name><name><surname>Curtis</surname><given-names>CF</given-names></name></person-group><article-title>Variation of malaria transmission and morbidity with altitude in Tanzania and with introduction of alphacypermethrin treated nets</article-title><source>Malar J</source><year>2003</year><volume>2</volume><fpage>28</fpage><pub-id pub-id-type="pmid">14585106</pub-id><pub-id pub-id-type="doi">10.1186/1475-2875-2-28</pub-id></citation></ref><ref id="B16"><citation citation-type="other"><person-group person-group-type="author"><collab>NationalBureauofStatistics</collab></person-group><article-title>National Census, United Republic of Tanzania</article-title><year>2002</year></citation></ref><ref