26</volume><fpage>240</fpage><lpage>243</lpage><pub-id pub-id-type="doi">10.1097/01.paf.0000176280.74666.ab</pub-id><pub-id pub-id-type="pmid">16121079</pub-id></mixed-citation></ref><ref id="CR13"><label>13.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gulliver</surname><given-names>P</given-names></name><name><surname>Begg</surname><given-names>D</given-names></name></person-group><article-title>Usual water-related behaviour and &#x02018;near-drowning&#x02019; incidents in young adults</article-title><source>Aust N Z J Public Health</source><year>2005</year><volume>29</volume><fpage>238</fpage><lpage>243</lpage><pub-id pub-id-type="doi">10.1111/j.1467-842X.2005.tb00761.x</pub-id><pub-id pub-id-type="pmid">15991771</pub-id></mixed-citation></ref><ref id="CR14"><label>14.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kuisma</surname><given-names>M</given-names></name><name><surname>Alasp&#x000e4;&#x000e4;</surname><given-names>A</given-names></name></person-group><article-title>Out-of-hospital cardiac arrests of non-cardiac origin. Epidemiology and outcome</article-title><source>Eur Heart J</source><year>1997</year><volume>18</volume><fpage>1122</fpage><lpage>1128</lpage><pub-id pub-id-type="pmid">9243146</pub-id></mixed-citation></ref><ref id="CR15"><label>15.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Golden</surname><given-names>F</given-names></name></person-group><article-title>Mechanisms of body cooling in submersed victims</article-title><source>Resuscitation</source><year>1997</year><volume>35</volume><issue>2</issue><fpage>107</fpage><lpage>109</lpage><pub-id pub-id-type="doi">10.1016/S0300-9572(97)00065-8</pub-id><pub-id pub-id-type="pmid">9316192</pub-id></mixed-citation></ref><ref id="CR16"><label>16.</label><mixed-citation publication-type="journal"><person-group person-gr