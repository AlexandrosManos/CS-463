ame><surname>Olive</surname><given-names>MF</given-names></name><name><surname>Nannini</surname><given-names>MA</given-names></name><name><surname>Ou</surname><given-names>CJ</given-names></name><etal/></person-group><year>2002</year><article-title>Effects of acute acamprosate and homotaurine on ethanol intake and ethanol-stimulated mesolimbic dopamine release</article-title><source>Eur J Pharmacol</source><volume>437</volume><fpage>55</fpage><lpage>61</lpage><pub-id pub-id-type="pmid">11864639</pub-id></citation></ref><ref id="b33-ndt-2-445"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Paille</surname><given-names>FM</given-names></name><name><surname>Guelfi</surname><given-names>JD</given-names></name><name><surname>Perkins</surname><given-names>AC</given-names></name><etal/></person-group><year>1995</year><article-title>Double-blind randomized multicentre trial of acamprosate in maintaining abstinence from alcohol</article-title><source>Alcohol Alcohol</source><volume>30</volume><fpage>239</fpage><lpage>47</lpage><pub-id pub-id-type="pmid">7662044</pub-id></citation></ref><ref id="b34-ndt-2-445"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Palmer</surname><given-names>AJ</given-names></name><name><surname>Neeser</surname><given-names>K</given-names></name><name><surname>Weiss</surname><given-names>C</given-names></name><etal/></person-group><year>2000</year><article-title>The long-term cost-effectiveness of improving alcohol abstinence with adjunctive acamprosate</article-title><source>Alcohol Alcohol</source><volume>35</volume><fpage>478</fpage><lpage>92</lpage><pub-id pub-id-type="pmid">11022023</pub-id></citation></ref><ref id="b35-ndt-2-445"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pelc</surname><given-names>I</given-names></name><name><surname>Verbanck</surname><given-names>P</given-names></name><name><surname>Le Bon</sur