graphic xlink:href="TOMINFOJ-2-105_F4"/></fig><fig id="F5" position="float"><label>Fig. (5)</label><caption><p>Correlation Coefficient corresponding to the ten healthy control samples.</p></caption><graphic xlink:href="TOMINFOJ-2-105_F5"/></fig><fig id="F6" position="float"><label>Fig. (6)</label><caption><p>Correlation Coefficient corresponding to the ten diabetic samples.</p></caption><graphic xlink:href="TOMINFOJ-2-105_F6"/></fig><fig id="F7" position="float"><label>Fig. (7)</label><caption><p>Correlation Coefficient Grand Average for healthy control samples (mean &#x000b1; SE).</p></caption><graphic xlink:href="TOMINFOJ-2-105_F7"/></fig><fig id="F8" position="float"><label>Fig. (8)</label><caption><p>Correlation Coefficient Grand Average for diabetic samples (mean &#x000b1; SE).</p></caption><graphic xlink:href="TOMINFOJ-2-105_F8"/></fig></floats-wrap></article>