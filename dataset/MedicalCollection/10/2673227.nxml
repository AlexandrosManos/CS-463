022</pub-id></citation></ref><ref id="B12"><citation citation-type="other"><article-title>bioGUID</article-title><ext-link ext-link-type="uri" xlink:href="http://bioguid.info"/></citation></ref><ref id="B13"><citation citation-type="other"><article-title>eXist: Open source native XML databases</article-title><ext-link ext-link-type="uri" xlink:href="http://www.exist-db.org"/></citation></ref><ref id="B14"><citation citation-type="other"><article-title>Species Profile Model (SPM) Wiki Web</article-title><ext-link ext-link-type="uri" xlink:href="http://wiki.tdwg.org/twiki/bin/view/SPM/WebHome"/></citation></ref><ref id="B15"><citation citation-type="other"><article-title>ABBYY</article-title><ext-link ext-link-type="uri" xlink:href="http://www.abbyy.com"/></citation></ref><ref id="B16"><citation citation-type="other"><article-title>DSpace</article-title><ext-link ext-link-type="uri" xlink:href="http://www.dspace.org"/></citation></ref><ref id="B17"><citation citation-type="other"><article-title>PostgreSQL</article-title><ext-link ext-link-type="uri" xlink:href="http://www.postgresql.org"/></citation></ref><ref id="B18"><citation citation-type="other"><article-title>Semantic Interoperability of metadata and information in unlike environments (SIMILE)</article-title><ext-link ext-link-type="uri" xlink:href="http://simile.mit.edu"/></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sautter</surname><given-names>G</given-names></name><name><surname>B&#x000f6;hm</surname><given-names>K</given-names></name><name><surname>Agosti</surname><given-names>D</given-names></name></person-group><article-title>A quantitative comparison of XML schemas for taxonomic publications</article-title><source>Biodiversity Informatics</source><year>2007</year><volume>4</volume><fpage>1</fpage><lpage>13</lpage></citation></ref><ref id="B20"><citation citation-type="other"><article-title>TAPIR</article-title><ext-link ext-link-