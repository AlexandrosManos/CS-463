colspan="1" rowspan="1" align="center">3.54E&#x0002b;10</td></tr><tr><td colspan="1" rowspan="1" align="left">30&#x02013;35</td><td colspan="1" rowspan="1" align="char" char=".">34</td><td colspan="1" rowspan="1" align="char" char=".">0.090</td><td colspan="1" rowspan="1" align="char" char=".">2.92</td><td colspan="1" rowspan="1" align="char" char=".">94.8</td><td colspan="1" rowspan="1" align="center">3.08E&#x0002b;03</td><td colspan="1" rowspan="1" align="center">3.25E&#x0002b;06</td><td colspan="1" rowspan="1" align="center">1.06E&#x0002b;08</td><td colspan="1" rowspan="1" align="center">1.12E&#x0002b;11</td></tr><tr><td colspan="1" rowspan="1" align="left">35&#x02013;40</td><td colspan="1" rowspan="1" align="char" char=".">28</td><td colspan="1" rowspan="1" align="char" char=".">0.074</td><td colspan="1" rowspan="1" align="char" char=".">2.77</td><td colspan="1" rowspan="1" align="char" char=".">103.9</td><td colspan="1" rowspan="1" align="center">3.90E&#x0002b;03</td><td colspan="1" rowspan="1" align="center">5.48E&#x0002b;06</td><td colspan="1" rowspan="1" align="center">2.05E&#x0002b;08</td><td colspan="1" rowspan="1" align="center">2.89E&#x0002b;11</td></tr><tr><td colspan="1" rowspan="1" align="left">40&#x02013;45</td><td colspan="1" rowspan="1" align="char" char=".">22</td><td colspan="1" rowspan="1" align="char" char=".">0.058</td><td colspan="1" rowspan="1" align="char" char=".">2.47</td><td colspan="1" rowspan="1" align="char" char=".">104.8</td><td colspan="1" rowspan="1" align="center">4.46E&#x0002b;03</td><td colspan="1" rowspan="1" align="center">8.05E&#x0002b;06</td><td colspan="1" rowspan="1" align="center">3.42E&#x0002b;08</td><td colspan="1" rowspan="1" align="center">6.18E&#x0002b;11</td></tr><tr><td colspan="1" rowspan="1" align="left">45&#x02013;50</td><td colspan="1" rowspan="1" align="char" char=".">12</td><td colspan="1" rowspan="1" align="char" char=".">0.032</td><td colspan="1" rowspan="1" align="char" char=".">1.50</td><td colspan="1" rowspan="1" align="char" char=".">71.4</td><td colspan="1" rowspan="1" align="center">3.39E&#x0002b;03</td><td colspan="1" rowspan="1" align="center">7.66E&#x0002b;06</td><td colspan="1" rowspan="1" align="center">3.64E&#x0002b;08</td><td colspan="1" rowspan="1" align="center">8.21E&#x0002b;11</td></tr><tr><td colspan="1" rowspan="1" align="left">50&#x02013;55</td><td colspan="1" rowspan="1" align="char" char=".">8</td><td colspan="1" rowspan="1" align="char" char=".">0.021</td><td colspan="1" rowspan="1" align="char" char=".">1.11</td><td colspan="1" rowspan="1" align="char" char=".">58.2</td><td colspan="1" rowspan="1" align="center">3.05E&#x0002b;03</td><td colspan="1" rowspan="1" align="center">8.42E&#x0002b;06</td><td colspan="1" rowspan="1" align="center">4.42E&#x0002b;08</td><td colspan="1" rowspan="1" align="center">1.22E&#x0002b;12</td></tr><tr><td colspan="1" rowspan="1" align="left">55&#x02013;60</td><td colspan="1" rowspan="1" align="char" char=".">5</td><td colspan="1" rowspan="1" align="char" char=".">0.013</td><td colspan="1" rowspan="1" align="char" char=".">0.76</td><td colspan="1" rowspan="1" align="char" char=".">43.6</td><td colspan="1" rowspan="1" align="center">2.51E&#x0002b;03</td><td colspan="1" rowspan="1" align="center">8.29E&#x0002b;06</td><td colspan="1" rowspan="1" align="center">4.77E&#x0002b;08</td><td colspan="1" rowspan="1" align="center">1.58E&#x0002b;12</td></tr><tr><td colspan="1" rowspan="1" align="left">60&#x02013;65</td><td colspan="1" rowspan="1" align="char" char=".">4</td><td colspan="1" rowspan="1" align="char" char=".">0.011</td><td colspan="1" rowspan="1" align="char" char=".">0.66</td><td colspan="1" rowspan="1" align="char" char=".">41.2</td><td colspan="1" rowspan="1" align="center">2.58E&#x0002b;03</td><td colspan="1" rowspan="1" align="center">1.01E&#x0002b;07</td><td colspan="1" rowspan="1" align="center">6.29E&#x0002b;08</td><td colspan="1" rowspan="1" align="center">2.46E&#x0002b;12</td></tr><tr><td colspan="1" rowspan="1" align="left">65&#x02013;70</td><td colspan="1" rowspan="1" align="char" char=".">4</td><td colspan="1" rowspan="1" align="char" char=".">0.011</td><td colspan="1" rowspan="1" align="char" char=".">0.71</td><td colspan="1" rowspan="1" align="char" char=".">48.1</td><td colspan="1" rowspan="1" align="center">3.25E&#x0002b;03</td><td colspan="1" rowspan="1" align="center">1.48E&#x0002b;07</td><td colspan="1" rowspan="1" align="center">9.98E&#x0002b;08</td><td colspan="1" rowspan="1" align="center">4.55E&#x0002b;12</td></tr><tr><td colspan="1" rowspan="1" align="left">70&#x02013;75</td><td colspan="1" rowspan="1" align="char" char=".">1</td><td colspan="1" rowspan="1" align="char" char=".">0.003</td><td colspan="1" rowspan="1" align="char" char=".">0.19</td><td colspan="1" rowspan="1" align="char" char=".">13.9</td><td colspan="1" rowspan="1" align="center">1.01E&#x0002b;03</td><td colspan="1" rowspan="1" align="center">5.29E&#x0002b;06</td><td colspan="1" rowspan="1" align="center">3.83E&#x0002b;08</td><td colspan="1" rowspan="1" align="center">2.01E&#x0002b;12</td></tr><tr><td colspan="1" rowspan="1" align="left">75&#x02013;80</td><td colspan="1" rowspan="1" align="char" char=".">0</td><td colspan="1" rowspan="1" align="char" char=".">0.000</td><td colspan="1" rowspan="1" align="char" char=".">0.00</td><td colspan="1" rowspan="1" align="char" char=".">0.0</td><td colspan="1" rowspan="1" align="center">0.00E&#x0002b;00</td><td colspan="1" rowspan="1" align="center">0.00E&#x0002b;00</td><td colspan="1" rowspan="1" align="center">0.00E&#x0002b;00</td><td colspan="1" rowspan="1" align="center">0.00E&#x0002b;00</td></tr><tr><td colspan="1" rowspan="1" align="left">80&#x02013;85</td><td colspan="1" rowspan="1" align="char" char=".">2</td><td colspan="1" rowspan="1" align="char" char=".">0.005</td><td colspan="1" rowspan="1" align="char" char=".">0.44</td><td colspan="1" rowspan="1" align="char" char=".">35.9</td><td colspan="1" rowspan="1" align="center">2.96E&#x0002b;03</td><td colspan="1" rowspan="1" align="center">2.02E&#x0002b;07</td><td colspan="1" rowspan="1" align="center">1.66E&#x0002b;09</td><td colspan="1" rowspan="1" align="center">1.13E&#x0002b;13</td></tr><tr><td colspan="1" rowspan="1" align="left">85&#x02013;90</td><td colspan="1" rowspan="1" align="char" char=".">1</td><td colspan="1" rowspan="1" align="char" char=".">0.003</td><td colspan="1" rowspan="1" align="char" char=".">0.23</td><td colspan="1" rowspan="1" align="char" char=".">20.2</td><td colspan="1" rowspan="1" align="center">1.77E&#x0002b;03</td><td colspan="1" rowspan="1" align="center">1.35E&#x0002b;07</td><td colspan="1" rowspan="1" align="center">1.18E&#x0002b;09</td><td colspan="1" rowspan="1" align="center">9.07E&#x0002b;12</td></tr><tr><td colspan="1" rowspan="1" align="left">SUMS:</td><td colspan="1" rowspan="1" align="char" char=".">379</td><td colspan="1" rowspan="1" align="char" char=".">1.000</td><td colspan="1" rowspan="1" align="char" char=".">25.61</td><td colspan="1" rowspan="1" align="char" char=".">872.7</td><td colspan="1" rowspan="1" align="center">3.71E&#x0002b;04</td><td colspan="1" rowspan="1" align="center">1.08E&#x0002b;08</td><td colspan="1" rowspan="1" align="center">6.87E&#x0002b;09</td><td colspan="1" rowspan="1" align="center">3.41E&#x0002b;13</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="center">&#x02329;r&#x0232a;</td><td colspan="1" rowspan="1" align="center">&#x02329;r<sup>2</sup>&#x0232a;</td><td colspan="1" rowspan="1" align="center">&#x02329;r<sup>3</sup>&#x0232a;</td><td colspan="1" rowspan="1" align="center">&#x02329;r<sup>5</sup>&#x0232a;</td><td colspan="1" rowspan="1" align="center">&#x02329;r<sup>6</sup>&#x0232a;</td><td colspan="1" rowspan="1" align="center">&#x02329;r<sup>8</sup>&#x0232a;</td></tr></tbody></table></table-wrap><p>The efflux from this two-component liposome population is given by a double-exponential normalized relaxation R(t):<disp-formula id="fda6a"><label>(A6a)</label><tex-math id="M21">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}R(t)=\frac{A_{1}e^{-t/{\tau}_{1}}+A_{2}e^{-t/{\tau}_{2}}}{A_{1}+A_{2}}.\end{equation*}\end{document}</tex-math></disp-formula>The integral of this relaxation represents a new kind of &#x0201c;average time constant,&#x0201d; with the brackets representing averaging over the two liposome classes:<disp-formula id="fda6b"><label>(A6b)</label><tex-math id="M22">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}{\langle}{\tau}{\rangle}={\int _{0}^{{\infty}}}R(t)dt=\frac{A_{1}{\tau}_{1}({\mu}_{1})+A_{2}{\tau}_{2}({\mu}_{2})}{A_{1}+A_{2}}.\end{equation*}\end{document}</tex-math></disp-formula>(We can think of &#x02329;&#x003c4;&#x0232a; as a two-dimensional average. The &#x003c4;<sub>1</sub> and &#x003c4;<sub>2</sub> represent &#x0201c;vertical&#x0201d; averages within each liposome class, while the final &#x02329;&#x003c4;&#x0232a; averages these individual class values &#x0201c;horizontally&#x0201d; over the two classes.) The amplitude A<sub>1</sub> reflects the amount of Cl<sup>&#x02212;</sup> initially trapped in the class-1 transport-active liposomes, which is proportional to the volume entrapped by those liposomes that contain protein. This is the product of the volume of a single class-1 liposome and the number of class-1 liposomes containing protein, N<sub>L1</sub>(1 &#x02212; f<sub>10</sub>). An identical argument applies to the class-2 liposomes. Thus, we arrive at expressions for both the measured time constant &#x02329;&#x003c4;&#x0232a; of the relaxation and the measured volume fraction &#x02329;f<sub>0</sub>&#x0232a; of the protein-free liposomes:<disp-formula id="fda7a"><label>(A7a)</label><tex-math id="M23">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}{\langle}{\tau}{\rangle}=\frac{(1-e^{-{\mu}_{1}}){\tau}_{1}N_{L1}r_{1}^{3}+(1-e^{-{\mu}_{2}}){\tau}_{2}N_{L2}r_{2}^{3}}{(1-e^{-{\mu}_{1}})N_{L1}r_{1}^{3}+(1-e^{-{\mu}_{2}})N_{L2}r_{2}^{3}}\end{equation*}\end{document}</tex-math></disp-formula><disp-formula id="fda7b"><label>(A7b)</label><tex-math id="M24">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}{\langle}f_{0}{\rangle}=\frac{e^{-{\mu}_{1}}N_{L1}r_{1}^{3}+e^{-{\mu}_{2}}N_{L2}r_{2}^{3}}{N_{L1}r_{1}^{3}+N_{L2}r_{2}^{3}}.\end{equation*}\end{document}</tex-math></disp-formula>The &#x0201c;grand canonical&#x0201d; time constant &#x02329;&#x003c4;&#x0232a; is still just the integral of the normalized efflux time course, as before. We call this integral a time constant in anticipation that the time course will look single exponential. This will be true if the two classes of liposomes are of similar radii, but not if they are very different in size. (In this latter case, the relaxation would look biexponential, but the integral would still be rigorously given by <xref ref-type="disp-formula" rid="fda7a">Eq. A7a</xref>; you just would call it an &#x0201c;area&#x0201d; instead of a &#x0201c;time constant.&#x0201d;) We now write Eq. A7 in a more compact form by using the radius probability distribution. Let &#x003c1;<sub>k</sub> be the discrete probability distribution for liposome radius, with k &#x0003d; 1,2:<disp-formula id="fda8"><label>(A8)</label><tex-math id="M25">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{gather*}{\rho}_{1}=N_{L1}/N_{p} \\{\rho}_{2}=N_{L2}/N_{p}.\end{gather*}\end{document}</tex-math></disp-formula>Then Eq. A7 becomes<disp-formula id="fda9a"><label>(A9a)</label><tex-math id="M26">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}{\langle}{\tau}{\rangle}=\frac{{{\sum^{2}_{k=1}}}(1-e^{-{\mu}_{k}}){\tau}_{k}r_{k}^{3}{\rho}_{k}}{{{\sum^{2}_{k=1}}}(1-e^{-{\mu}_{k}})r_{k}^{3}{\rho}_{k}}=\frac{{\langle}(1-e^{-{\mu}(r)}){\tau}({\mu})\hspace{.167em}r^{3}{\rangle}}{{\langle}(1-e^{-{\mu}(r)})r^{3}{\rangle}},\end{equation*}\end{document}</tex-math></disp-formula><disp-formula id="fda9b"><label>(A9b)</label><tex-math id="M27">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}{\langle}f_{0}{\rangle}=\frac{{\langle}r^{3}e^{-{\mu}}{\rangle}}{{\langle}r^{3}{\rangle}}.\end{equation*}\end{document}</tex-math></disp-formula>Eqs. A9a and A9b apply to any number of discrete liposome classes, and identical expressions hold for a continuous radius distribution with probability density &#x003c1;(r). We recall that &#x003bc; and hence &#x02329;&#x003c4;&#x0232a; and &#x02329;f<sub>0</sub>&#x0232a; are functions of both liposome radius and protein and that the brackets represent averages over &#x003c1;(r). In the limit of low protein, our experimental range of interest, (1 &#x02212; e<sup>&#x02212;&#x003bc;</sup>) &#x02248; &#x003bc;, and so<disp-formula id="fda10"><label>(A10)</label><tex-math id="M28">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}{\langle}{\tau}{\rangle}\approx \frac{{\mathrm{&#x0003c;}}{\mu}(r){\tau}{\mathrm{{^\ast}}}(r)(1-\displaystyle\frac{{\mu}(r)}{4})r^{3}{\rangle}}{{\langle}{\mu}(r)r^{3}{\rangle}}.\end{equation*}\end{document}</tex-math></disp-formula></p><p>Remember that &#x003c4;&#x0002a;(r) denotes the unitary time constant for liposomes of a given size. Taking the limit of &#x02329;&#x003c4;&#x0232a; as protein approaches zero and inserting <xref ref-type="disp-formula" rid="fda2">Eq. A2</xref>, we obtain the experimental unitary time constant &#x02329;&#x003c4;&#x0002a;&#x0232a;:<disp-formula id="fda11"><label>(A11)</label><tex-math id="M29">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}{\langle}{\tau}{^\ast}{\rangle}=\frac{{\langle}{\tau}{^\ast}(r)r^{5}{\rangle}}{{\langle}r^{5}{\rangle}}.\end{equation*}\end{document}</tex-math></disp-formula>Finally, we relate &#x02329;&#x003c4;&#x0002a;&#x0232a; to the unitary turnover rate &#x003b3;<sub>0</sub> by remembering that &#x003c4;&#x0002a;(r) is itself a function of r:<disp-formula id="fda12"><label>(A12)</label><tex-math id="M30">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}{\tau}{\mathrm{{^\ast}}}(r)=4{\pi}r^{3}c_{0}/3{\gamma}_{0},\end{equation*}\end{document}</tex-math></disp-formula>which provides the final result:<disp-formula><tex-math id="M31">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}{\gamma}_{0}=\frac{4{\pi}c_{0}}{{\mathrm{3}}{\langle}{\tau}{^\ast}{\rangle}}{\times}\frac{{\langle}r^{8}{\rangle}}{{\langle}r^{5}{\rangle}}.\end{equation*}\end{document}</tex-math></disp-formula>By applying a similar argument to Eqs. A9a and A9b, it is easy to show that the ratio of initial slopes of the f<sub>0</sub> and &#x02329;&#x003c4;&#x0232a;/&#x003c4;<sub>1</sub> plots is:<disp-formula id="fda13"><label>(A13)</label><tex-math id="M32">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}slope\hspace{.167em}ratio=4\frac{{\langle}r^{8}{\rangle}{\langle}r^{5}{\rangle}}{{\langle}r^{10}{\rangle}{\langle}r^{3}{\rangle}},\end{equation*}\end{document}</tex-math></disp-formula>&#x02248;2.0 for the radius-distribution here</p></sec></app></app-group></back></article>