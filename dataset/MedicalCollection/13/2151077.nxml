>1994</year><volume>35</volume><fpage>3931</fpage><lpage>3934</lpage><comment>We thank Professor Jacques Royer of the CNRS in Paris for this information as well as alerting us to reference 18.</comment><pub-id pub-id-type="doi">10.1016/S0040-4039(00)76705-0</pub-id></citation></ref><ref id="B17"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Vo-Thanh</surname><given-names>G</given-names></name><name><surname>Boucard</surname><given-names>V</given-names></name><name><surname>Sauriat-Dorizon</surname><given-names>H</given-names></name><name><surname>Guibe</surname><given-names>F</given-names></name></person-group><source>Synlett</source><year>2001</year><fpage>37</fpage><lpage>40</lpage></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Uno</surname><given-names>H</given-names></name><name><surname>Baldwin</surname><given-names>JE</given-names></name><name><surname>Russell</surname><given-names>AT</given-names></name></person-group><source>J Am Chem Soc</source><year>1994</year><volume>116</volume><fpage>2139</fpage><lpage>2140</lpage><pub-id pub-id-type="doi">10.1021/ja00084a062</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nojima</surname><given-names>H</given-names></name><name><surname>Kimura</surname><given-names>I</given-names></name><name><surname>Chen</surname><given-names>G-J</given-names></name><name><surname>Sugihara</surname><given-names>Y</given-names></name><name><surname>Haruno</surname><given-names>M</given-names></name><name><surname>Kato</surname><given-names>A</given-names></name><name><surname>Asano</surname><given-names>N</given-names></name></person-group><source>J Nat Prod</source><year>1998</year><volume>61</volume><fpage>397</fpage><lpage>400</lpage><pub-id pub-id-type="pmid">9544568</pub-id><pub-id pub-id-type="doi">10.1021/np970277l</pub-id></citation