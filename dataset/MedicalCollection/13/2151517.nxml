itation citation-type="journal">Wu, D.X.Y., C.Y.C. Lee, S.N. Uyekubo, H.K. Choi, S.J. Bastacky, and J.H. Widdicombe. <year>1998</year>. Regulation of the depth of surface liquid in bovine trachea. <source>Am. J. Physiol.</source> <volume>274</volume>:<fpage>L388</fpage>&#x02013;L395.<pub-id pub-id-type="pmid">9530174</pub-id></citation></ref><ref id="bib40"><citation citation-type="journal">Yokoyama, T. <year>2004</year>. Motor or sensor: a new aspect of primary cilia function. <source>Anat. Sci. Int.</source> <volume>79</volume>:<fpage>47</fpage>&#x02013;54.<pub-id pub-id-type="pmid">15218623</pub-id></citation></ref><ref id="bib41"><citation citation-type="journal">Yue, G., B. Malik, G. Yue, and D.C. Eaton. <year>2002</year>. Phosphatidylinositol 4,5-bisphosphate (PIP2) stimulates epithelial sodium channel activity in A6 cells. <source>J. Biol. Chem.</source> <volume>277</volume>:<fpage>11965</fpage>&#x02013;11969.<pub-id pub-id-type="pmid">11812779</pub-id></citation></ref></ref-list></back></article>