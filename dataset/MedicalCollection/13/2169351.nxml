n-group-type="author"><name><surname>Chant</surname><given-names>J.</given-names></name><name><surname>Mischke</surname><given-names>M.</given-names></name><name><surname>Mitchell</surname><given-names>E.</given-names></name><name><surname>Herskowitz</surname><given-names>I.</given-names></name><name><surname>Pringle</surname><given-names>J.R.</given-names></name></person-group><article-title>Role of Bud3p in producing the axial budding pattern of yeast</article-title><source>J. Cell Biol</source><volume>129</volume><year>1995</year><fpage>767</fpage><lpage>778</lpage><pub-id pub-id-type="pmid">7730410</pub-id></citation></ref><ref id="DeMarinietal1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>DeMarini</surname><given-names>D.J.</given-names></name><name><surname>Adams</surname><given-names>A.E.</given-names></name><name><surname>Fares</surname><given-names>H.</given-names></name><name><surname>De Virgilio</surname><given-names>C.</given-names></name><name><surname>Valle</surname><given-names>G.</given-names></name><name><surname>Chuang</surname><given-names>J.S.</given-names></name><name><surname>Pringle</surname><given-names>J.R.</given-names></name></person-group><article-title>A septin-based hierarchy of proteins required for localized deposition of chitin in the <italic>Saccharomyces cerevisiae</italic> cell wall</article-title><source>J. Cell Biol</source><volume>139</volume><year>1997</year><fpage>75</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">9314530</pub-id></citation></ref><ref id="Desterroetal1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Desterro</surname><given-names>J.M.</given-names></name><name><surname>Thomson</surname><given-names>J.</given-names></name><name><surname>Hay</surname><given-names>R.T.</given-names></name></person-group><article-title>Ubch9 conjugates SUMO but not ubiquitin</article-title><source>FEBS Lett</source><volume>417</volum