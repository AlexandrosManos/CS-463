td align="left" rowspan="1" colspan="1">Fetch water: Yes/No</td><td align="left" rowspan="1" colspan="1">98 (83)</td><td align="left" rowspan="1" colspan="1">100 (84)</td><td align="left" rowspan="1" colspan="1">1.18 (0.52&#x02013;2.6)</td><td align="left" rowspan="1" colspan="1">0.68</td></tr><tr><td align="left" rowspan="1" colspan="1">Farm: Yes/No</td><td align="left" rowspan="1" colspan="1">103 (88)</td><td align="left" rowspan="1" colspan="1">99 (84)</td><td align="left" rowspan="1" colspan="1">0.60 (0.22&#x02013;1.7)</td><td align="left" rowspan="1" colspan="1">0.32</td></tr><tr><td align="left" rowspan="1" colspan="1">Do not farm</td><td align="left" rowspan="1" colspan="1">15 (13)</td><td align="left" rowspan="1" colspan="1">19 (16)</td><td align="left" rowspan="1" colspan="1">1 (reference)</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Farm and wear long upper body clothes/shirt</td><td align="left" rowspan="1" colspan="1">62 (53)</td><td align="left" rowspan="1" colspan="1">57 (48)</td><td align="left" rowspan="1" colspan="1">0.56 (0.19&#x02013;1.6)</td><td align="left" rowspan="1" colspan="1">0.28</td></tr><tr><td align="left" rowspan="1" colspan="1">Farm and wear short upper body clothes/shirt</td><td align="left" rowspan="1" colspan="1">41 (35)</td><td align="left" rowspan="1" colspan="1">42 (36)</td><td align="left" rowspan="1" colspan="1">0.64 (0.22&#x02013;1.8)</td><td align="left" rowspan="1" colspan="1">0.40</td></tr><tr><td align="left" rowspan="1" colspan="1">Do not farm</td><td align="left" rowspan="1" colspan="1">15 (13)</td><td align="left" rowspan="1" colspan="1">19 (16)</td><td align="left" rowspan="1" colspan="1">1 (reference)</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Farm and wear long pants/dress</td><td align="left" rowspan="1" colspan="1">82 (69)</td><td align="left" rowspan="1" colspan="1">74 (63)</td><td align="left" rowspan="1" cols