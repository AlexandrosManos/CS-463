="doi">10.1111/j.1742-1241.2005.00596.x</pub-id></citation></ref><ref id="B4"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schooley</surname><given-names>RT</given-names></name></person-group><article-title>HIV and hepatitis C virus coinfection: bad bedfellows</article-title><source>Top HIV Med</source><year>2005</year><volume>13</volume><fpage>112</fpage><lpage>116</lpage><pub-id pub-id-type="pmid">16304454</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Revie</surname><given-names>D</given-names></name><name><surname>Braich</surname><given-names>RS</given-names></name><name><surname>Bayles</surname><given-names>D</given-names></name><name><surname>Chelyapov</surname><given-names>N</given-names></name><name><surname>Khan</surname><given-names>R</given-names></name><name><surname>Geer</surname><given-names>C</given-names></name><name><surname>Reisman</surname><given-names>R</given-names></name><name><surname>Kelley</surname><given-names>AS</given-names></name><name><surname>Prichard</surname><given-names>JG</given-names></name><name><surname>Salahuddin</surname><given-names>SZ</given-names></name></person-group><article-title>Transmission of human hepatitis C virus from patients in secondary cells for long term culture</article-title><source>Virol J</source><year>2005</year><volume>2</volume><fpage>37</fpage><pub-id pub-id-type="pmid">15840164</pub-id><pub-id pub-id-type="doi">10.1186/1743-422X-2-37</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Revie</surname><given-names>D</given-names></name><name><surname>Alberti</surname><given-names>MO</given-names></name><name><surname>Braich</surname><given-names>RS</given-names></name><name><surname>Chelyapov</surname><given-names>N</given-names></name><name><surname>Bayles</surname><given-names>D</given-names></name><nam