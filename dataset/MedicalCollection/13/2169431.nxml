son-group person-group-type="author"><name><surname>Lutkenhaus</surname><given-names>J.</given-names></name><name><surname>Addinall</surname><given-names>S.G.</given-names></name></person-group><article-title>Bacterial cell division and the Z ring</article-title><source>Annu. Rev. Biochem.</source><volume>66</volume><year>1997</year><fpage>93</fpage><lpage>116</lpage><pub-id pub-id-type="pmid">9242903</pub-id></citation></ref><ref id="MaandMargolin1999"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ma</surname><given-names>X.</given-names></name><name><surname>Margolin</surname><given-names>W.</given-names></name></person-group><article-title>Genetic and functional analyses of the conserved C-terminal core domain of <italic>Escherichia coli</italic> FtsZ</article-title><source>J. Bacteriol</source><volume>181</volume><year>1999</year><fpage>7531</fpage><lpage>7544</lpage><pub-id pub-id-type="pmid">10601211</pub-id></citation></ref><ref id="Maetal1996"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ma</surname><given-names>X.</given-names></name><name><surname>Ehrhardt</surname><given-names>D.W.</given-names></name><name><surname>Margolin</surname><given-names>W.</given-names></name></person-group><article-title>Co-localization of cell division proteins FtsZ and FtsA to cytoskeletal structures in living <italic>Escherichia coli</italic></article-title><source>Proc. Natl. Acad. Sci. USA</source><volume>93</volume><year>1996</year><fpage>12998</fpage><lpage>13003</lpage><pub-id pub-id-type="pmid">8917533</pub-id></citation></ref><ref id="MartinandHerrmann1998"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martin</surname><given-names>W.</given-names></name><name><surname>Herrmann</surname><given-names>R.G.</given-names></name></person-group><article-title>Gene transfer from organelles to the nucleushow much, what happens, and why?</article-title><source>Plant Physiol</source><volume>118</volume><year>1998</year><fpage>9</fpage><lpage>17</lpage><pub-id pub-id-type="pmid">9733521</pub-id></citation></ref><ref id="MukherjeeandLutkenhaus1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mukherjee</surname><given-names>A.</given-names></name><name><surname>Lutkenhaus</surname><given-names>J.</given-names></name></person-group><article-title>Guanine nucleotide-dependent assembly of FtsZ into filaments</article-title><source>J. Bacteriol.</source><volume>176</volume><year>1994</year><fpage>2754</fpage><lpage>2758</lpage><pub-id pub-id-type="pmid">8169229</pub-id></citation></ref><ref id="OsteryoungandVierling1995"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Osteryoung</surname><given-names>K.W.</given-names></name><name><surname>Vierling</surname><given-names>E.</given-names></name></person-group><article-title>Conserved cell and organelle division</article-title><source>Nature.</source><volume>376</volume><year>1995</year><fpage>473</fpage><lpage>474</lpage><pub-id pub-id-type="pmid">7637778</pub-id></citation></ref><ref id="OsteryoungandPyke1998"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Osteryoung</surname><given-names>K.W.</given-names></name><name><surname>Pyke</surname><given-names>K.A.</given-names></name></person-group><article-title>Plastid divisionevidence for a prokaryotically derived mechanism</article-title><source>Curr. Opin. Plant Biol.</source><volume>1</volume><year>1998</year><fpage>475</fpage><lpage>479</lpage><pub-id pub-id-type="pmid">10066635</pub-id></citation></ref><ref id="Osteryoungetal1998"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Osteryoung</surname><given-names>K.W.</given-names></name><name><surname>Stokes</surname><given-names>K.D.</given-names></name><name><surname>Rutherford</surname><given-