-id-type="doi">10.1021/jo00834a062</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>tom Dieck</surname><given-names>H</given-names></name><name><surname>Renk</surname><given-names>IW</given-names></name></person-group><source>Chem Ber</source><year>1971</year><volume>104</volume><fpage>92</fpage><lpage>109</lpage><pub-id pub-id-type="doi">10.1002/cber.19711040115</pub-id></citation></ref><ref id="B16"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Glorius</surname><given-names>F</given-names></name></person-group><source>EP 1521745</source><year>2004</year></citation></ref><ref id="B17"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Kison</surname><given-names>C</given-names></name><name><surname>Opatz</surname><given-names>T</given-names></name></person-group><source>Synthesis</source><year>2006</year><fpage>3727</fpage><lpage>3738</lpage></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huisgen</surname><given-names>R</given-names></name></person-group><source>Angew Chem Int Ed Eng</source><year>1980</year><volume>19</volume><fpage>947</fpage><lpage>1034</lpage><pub-id pub-id-type="doi">10.1002/anie.198009473</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reimlinger</surname><given-names>H</given-names></name></person-group><source>Chem Ber</source><year>1970</year><volume>103</volume><fpage>1900</fpage><lpage>1907</lpage><pub-id pub-id-type="doi">10.1002/cber.19701030629</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Taylor</surname><given-names>EC</given-names></name><name><surname>Turchi</surname><given-names>IJ</given-names></name></person-group><source>Chem Rev</source><year>1979</year><volume>79</volume><fpage>181</fpage><lpage>231</lpage><pub-id pub-id-type="doi">10.1021/cr60318a003</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zettlitzer</surname><given-names>H</given-names></name><name><surname>tom Dieck</surname><given-names>H</given-names></name><name><surname>Haupt</surname><given-names>ETK</given-names></name><name><surname>Stamp</surname><given-names>L</given-names></name></person-group><source>Chem Ber</source><year>1986</year><volume>119</volume><fpage>1868</fpage><lpage>1875</lpage><pub-id pub-id-type="doi">10.1002/cber.19861190609</pub-id></citation></ref></ref-list></back></article>