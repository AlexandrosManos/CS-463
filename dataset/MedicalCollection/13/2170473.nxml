n-type="book"><person-group person-group-type="author"><name><surname>Friedman</surname><given-names>H</given-names></name><name><surname>Krishnan</surname><given-names>C</given-names></name></person-group><year>1973</year><article-title>Thermodynamics of ion hydration In: Franks F, editor. Water a Comprehensive Treatise.</article-title><publisher-loc>New York</publisher-loc><publisher-name>Plenum Press</publisher-name></citation></ref><ref id="pone.0001406-Cacace1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cacace</surname><given-names>M</given-names></name><name><surname>Landau</surname><given-names>E</given-names></name><name><surname>Ramsden</surname><given-names>J</given-names></name></person-group><year>1997</year><article-title>The Hofmeister series: salt and solvent effects on interfacial phenomena.</article-title><source>Q Rev. Biophys.</source><volume>30</volume><fpage>241</fpage><lpage>277</lpage><pub-id pub-id-type="pmid">9394422</pub-id></citation></ref><ref id="pone.0001406-Wiggins6"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wiggins</surname><given-names>P</given-names></name><name><surname>van Ryn</surname><given-names>R</given-names></name></person-group><year>1990</year><article-title>Changes in ionic selectivity with changes in density of water in gels and cells.</article-title><source>Biophys J</source><volume>58</volume><fpage>585</fpage><lpage>596</lpage></citation></ref><ref id="pone.0001406-Holt1"><label>27</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Holt</surname><given-names>J</given-names></name><name><surname>Park</surname><given-names>H</given-names></name><name><surname>Wng</surname><given-names>Y</given-names></name><name><surname>Stadermann</surname><given-names>M</given-names></name><name><surname>Artyukhin</surname><given-names>A</given-names></name><etal/></person-group><year>2006</year><article-title>Fast mass transfer through sub-2-nanometer carbon nanotubes.</article-title><source>Science</source><volume>312</volume><fpage>1034</fpage><lpage>1037</lpage><pub-id pub-id-type="pmid">16709781</pub-id></citation></ref><ref id="pone.0001406-Wiggins7"><label>28</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wiggins</surname><given-names>P</given-names></name><name><surname>van Ryn</surname><given-names>R</given-names></name><name><surname>Ormrod</surname><given-names>D</given-names></name></person-group><year>1991</year><article-title>Donnan membrane equilibrium is not directly applicable to distributions of ions and water in gels or cells.</article-title><source>Biophys J</source><volume>60</volume><fpage>8</fpage><lpage>14</lpage></citation></ref><ref id="pone.0001406-Wiggins8"><label>29</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wiggins</surname><given-names>PM</given-names></name></person-group><year>1995</year><article-title>Microosmosis, a chaotic phenomena of water and solutes in gels.</article-title><source>Langmuir</source><volume>11</volume><fpage>1984</fpage><lpage>1986</lpage></citation></ref><ref id="pone.0001406-Wiggins9"><label>30</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wiggins</surname><given-names>PM</given-names></name></person-group><year>1995</year><article-title>High and low density water in gels.</article-title><source>Prog Polymer Sci.</source><volume>20</volume><fpage>1121</fpage></citation></ref><ref id="pone.0001406-Wiggins10"><label>31</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wiggins</surname><given-names>P</given-names></name></person-group><year>2001</year><article-title>High and low density intracellular water.</article-title><source>Cell Mol Biol</source><volume>47</volume><fpage>735</fpage><lpage>744</lpage><pub-id pub-id-type="pmid">11728089</pub-id></citation></ref><ref id="pone.0001406-Wiggins11"><label>32</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wiggins</surname><given-names>P</given-names></name></person-group><year>2001</year><article-title>Hydration in cells and gels.</article-title><person-group person-group-type="editor"><name><surname>Berk</surname><given-names>Z</given-names></name><name><surname>Leslie</surname><given-names>RB</given-names></name><name><surname>Lilford</surname><given-names>PJ</given-names></name><name><surname>Mizrahi</surname><given-names>S</given-names></name></person-group><source>Water Science for Food, Health, Agriculture and Environment</source><publisher-loc>Lancaster</publisher-loc><publisher-name>Technomic Publishing Co. Inc. ISOPOW 8</publisher-name></citation></ref><ref id="pone.0001406-DrostHansen1"><label>33</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Drost-Hansen</surname><given-names>W</given-names></name></person-group><year>2001</year><article-title>Temperature effects on cell-functioning. A critical role for vicinal water.</article-title><source>Cell Mol Biol</source><volume>47</volume><fpage>865</fpage><lpage>884</lpage><pub-id pub-id-type="pmid">11728100</pub-id></citation></ref><ref id="pone.0001406-Wiggins12"><label>34</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wiggins</surname><given-names>P</given-names></name></person-group><year>2002</year><article-title>Water in complex environments such as living cells.</article-title><source>Physica A</source><volume>314</volume><fpage>485</fpage><lpage>491</lpage></citation></ref><ref id="pone.0001406-Wiggins13"><label>35</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wiggins</surname><given-names>P</given-names></name></person-group><year>1995</year><article-title>Micro-osmosis in gels, cells and enzymes.</article-title><source>Cell Biochem. &#x00026; function</source><volume>13</volume><fpage>165</fpage><lpage>172</lpage></citation></ref><ref id="pone.0001406-Wiggins14"><label>36</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wiggins</surname><given-names>P</given-names></name></person-group><year>1996</year><article-title>High and low density water and resting, active and transformed cells.</article-title><source>Cell Biol Internat</source><volume>20</volume><fpage>429</fpage><lpage>435</lpage></citation></ref><ref id="pone.0001406-Wiggins15"><label>37</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wiggins</surname><given-names>P</given-names></name><name><surname>Rowlandson</surname><given-names>J</given-names></name><name><surname>Ferguson</surname><given-names>A</given-names></name></person-group><year>1999</year><article-title>Preservation of murine embryos in a state of dormancy at 4&#x000b0;C.</article-title><source>Am. J. Physiol</source><volume>276</volume><fpage>C291</fpage><lpage>C299</lpage><pub-id pub-id-type="pmid">9950755</pub-id></citation></ref><ref id="pone.0001406-Rees1"><label>38</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Rees</surname><given-names>M</given-names></name></person-group><year>1999</year><article-title>Just six numbers.</article-title><publisher-loc>London</publisher-loc><publisher-name>Science Masters, Weidenfeld and Nicolson</publisher-name></citation></ref></ref-list><fn-group><fn fn-type="conflict"><p><bold>Competing Interests: </bold>The authors have declared that no competing interests exist.</p></fn><fn fn-type="financial-disclosure"><p><bold>Funding: </bold>The author has no support or funding to report. Previously funding was from the Health Research council of New Zealand</p></fn></fn-group></back></article>