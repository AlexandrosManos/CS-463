 person-group-type="author"><name><surname>D'Angelo</surname><given-names>E</given-names></name><name><surname>Pecchiari</surname><given-names>M</given-names></name><name><surname>Gentile</surname><given-names>G</given-names></name></person-group><article-title>Dependence of lung injury on surface tension during low-volume ventilation in normal open-chest rabbits</article-title><source>J Appl Physiol</source><year>2007</year><volume>102</volume><fpage>174</fpage><lpage>182</lpage><pub-id pub-id-type="pmid">16959911</pub-id><pub-id pub-id-type="doi">10.1152/japplphysiol.00405.2006</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>D'Angelo</surname><given-names>E</given-names></name><name><surname>Pecchiari</surname><given-names>M</given-names></name><name><surname>Della Valle</surname><given-names>P</given-names></name><name><surname>Koutsoukou</surname><given-names>A</given-names></name><name><surname>Milic-Emili</surname><given-names>J</given-names></name></person-group><article-title>Effects of mechanical ventilation at low lung volume on respiratory mechanics and nitric oxide exhalation in normal rabbits</article-title><source>J Appl Physiol</source><year>2005</year><volume>99</volume><fpage>433</fpage><lpage>444</lpage><pub-id pub-id-type="pmid">15761084</pub-id><pub-id pub-id-type="doi">10.1152/japplphysiol.01368.2004</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bregeon</surname><given-names>F</given-names></name><name><surname>Roch</surname><given-names>A</given-names></name><name><surname>Delpierre</surname><given-names>S</given-names></name><name><surname>Ghigo</surname><given-names>E</given-names></name><name><surname>Autillo-Touati</surname><given-names>A</given-names></name><name><surname>Kajikawa</surname><given-names>O</given-names></name><name><surname>Martin</surname><given-names>T</given-name