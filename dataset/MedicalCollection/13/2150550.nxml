<name><surname>Powell</surname><given-names>J.A.</given-names></name></person-group><article-title>Triad formationorganization and function of the sarcoplasmic reticulum calcium release channel and triadin in normal and dysgenic muscle in vitro</article-title><source>J. Cell Biol.</source><volume>123</volume><year>1993</year><fpage>1161</fpage><lpage>1174</lpage><pub-id pub-id-type="pmid">8245124</pub-id></citation></ref><ref id="Flucheretal1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Flucher</surname><given-names>B.E.</given-names></name><name><surname>Andrews</surname><given-names>S.B.</given-names></name><name><surname>Daniels</surname><given-names>M.P.</given-names></name></person-group><article-title>Molecular organization of transverse tubule/sarcoplasmic reticulum junctions during development of excitation&#x02013;contraction coupling in skeletal muscle</article-title><source>Mol. Biol. Cell.</source><volume>5</volume><year>1994</year><fpage>1105</fpage><lpage>1118</lpage><pub-id pub-id-type="pmid">7865878</pub-id></citation></ref><ref id="Franzini-ArmstrongandProtasi1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Franzini-Armstrong</surname><given-names>C.</given-names></name><name><surname>Protasi</surname><given-names>F.</given-names></name></person-group><article-title>Ryanodine receptors of striated musclesa complex channel capable of multiple interactions</article-title><source>Physiol. Rev</source><volume>77</volume><year>1997</year><fpage>699</fpage><lpage>729</lpage><pub-id pub-id-type="pmid">9234963</pub-id></citation></ref><ref id="Gianninietal1992"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giannini</surname><given-names>G.</given-names></name><name><surname>Clementi</surname><given-names>E.</given-names></name><name><surname>Ceci</surname><given-names>R.</given-names></name><name><surname>Marziali</surn