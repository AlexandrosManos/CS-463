e><name><surname>Spande</surname><given-names>TF</given-names></name><name><surname>Daly</surname><given-names>JW</given-names></name></person-group><source>Tetrahedron</source><year>1991</year><volume>47</volume><fpage>5401</fpage><lpage>5414</lpage><pub-id pub-id-type="doi">10.1016/S0040-4020(01)80974-1</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stork</surname><given-names>G</given-names></name><name><surname>Zhao</surname><given-names>K</given-names></name></person-group><source>Tetrahedron Lett</source><year>1989</year><volume>30</volume><fpage>2173</fpage><lpage>2174</lpage><pub-id pub-id-type="doi">10.1016/S0040-4039(00)99640-0</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Takahashi</surname><given-names>S</given-names></name><name><surname>Kuroyama</surname><given-names>Y</given-names></name><name><surname>Sonogashira</surname><given-names>K</given-names></name><name><surname>Hagihara</surname><given-names>N</given-names></name></person-group><source>Synthesis</source><year>1980</year><fpage>627</fpage><lpage>630</lpage><pub-id pub-id-type="doi">10.1055/s-1980-29145</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tamao</surname><given-names>K</given-names></name><name><surname>Sumitani</surname><given-names>K</given-names></name><name><surname>Kumada</surname><given-names>M</given-names></name></person-group><source>J Am Chem Soc</source><year>1972</year><volume>94</volume><fpage>4374</fpage><lpage>4376</lpage><pub-id pub-id-type="doi">10.1021/ja00767a075</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Daly</surname><given-names>JW</given-names></name><name><surname>Spande</surname><given-names>TF</given-names></name><name><surname>Garraffo</surname><given-names>HM</given-names></name></person-group><source>J Nat Prod</source><year>2005</year><volume>68</volume><fpage>1556</fpage><lpage>1575</lpage><pub-id pub-id-type="pmid">16252926</pub-id><pub-id pub-id-type="doi">10.1021/np0580560</pub-id></citation></ref><ref id="B15"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Toyooka</surname><given-names>N</given-names></name><name><surname>Tsuneki</surname><given-names>H</given-names></name><name><surname>Kobayashi</surname><given-names>S</given-names></name><name><surname>Dejun</surname><given-names>Z</given-names></name><name><surname>Kawasaki</surname><given-names>M</given-names></name><name><surname>Kimura</surname><given-names>I</given-names></name><name><surname>Sasaoka</surname><given-names>T</given-names></name><name><surname>Nemoto</surname><given-names>H</given-names></name></person-group><source>Current Chemical Biology</source><year>2007</year><volume>1</volume><fpage>97</fpage><lpage>114</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martin-Ruiz</surname><given-names>CM</given-names></name><name><surname>Haroutunian</surname><given-names>VH</given-names></name><name><surname>Long</surname><given-names>P</given-names></name><name><surname>Young</surname><given-names>AH</given-names></name><name><surname>Davis</surname><given-names>KL</given-names></name><name><surname>Perry</surname><given-names>EK</given-names></name><name><surname>Court</surname><given-names>JA</given-names></name></person-group><source>Biol Psychiatry</source><year>2003</year><volume>54</volume><fpage>1222</fpage><lpage>1233</lpage><pub-id pub-id-type="pmid">14643090</pub-id><pub-id pub-id-type="doi">10.1016/S0006-3223(03)00348-2</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leonard</surname><given-names>S</given-names></name><name><surname>Adams</surname><given-names>C</given-names></name><name><surname>Breese</surname><given-names>CR</given-names></name><name><surname>Adler</surname><given-names>LE</given-names></name><name><surname>Bickford</surname><given-names>P</given-names></name><name><surname>Byerley</surname><given-names>W</given-names></name><name><surname>Coon</surname><given-names>H</given-names></name><name><surname>Griffith</surname><given-names>JM</given-names></name><name><surname>Miller</surname><given-names>C</given-names></name><name><surname>Myles-Worsley</surname><given-names>M</given-names></name><name><surname>Nagamoto</surname><given-names>HT</given-names></name><name><surname>Rollins</surname><given-names>Y</given-names></name><name><surname>Stevens</surname><given-names>KE</given-names></name><name><surname>Waldo</surname><given-names>M</given-names></name><name><surname>Freedman</surname><given-names>R</given-names></name></person-group><source>Schizophr Bull</source><year>1996</year><volume>22</volume><fpage>431</fpage><lpage>445</lpage><pub-id pub-id-type="pmid">8873294</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Navarro</surname><given-names>HA</given-names></name><name><surname>Xu</surname><given-names>H</given-names></name><name><surname>Zhong</surname><given-names>D</given-names></name><name><surname>Abraham</surname><given-names>P</given-names></name><name><surname>Carroll</surname><given-names>FI</given-names></name></person-group><source>Synapse</source><year>2002</year><volume>44</volume><fpage>117</fpage><lpage>123</lpage><pub-id pub-id-type="pmid">11954042</pub-id><pub-id pub-id-type="doi">10.1002/syn.10062</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Navarro</surname><given-names>HA</given-names></name><name><surname>Zhong</surname><given-names>D</given-names></name><name><surname>Abraham</surname><given-names>P</given-names></name><name><surname>Xu</surname><given-names>H</given-names></name><name><surname>Carroll</surname><given-names>FI</given-names></name></person-group><source>J Med Chem</source><year>2000</year><volume>43</volume><fpage>142</fpage><lpage>145</lpage><pub-id pub-id-type="pmid">10649969</pub-id><pub-id pub-id-type="doi">10.1021/jm990544f</pub-id></citation></ref></ref-list></back></article>