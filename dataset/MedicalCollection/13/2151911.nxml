id pub-id-type="pmid">672938</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Merkle</surname><given-names>RC</given-names></name></person-group><article-title>The technical feasibility of cryonics</article-title><source>Med Hypotheses</source><year>1992</year><volume>39</volume><fpage>6</fpage><lpage>16</lpage><pub-id pub-id-type="pmid">1435395</pub-id><pub-id pub-id-type="doi">10.1016/0306-9877(92)90133-W</pub-id></citation></ref></ref-list></back></article>