given-names>KG</given-names></name></person-group><article-title>Charting the proteomes of organisms with unsequenced genomes by MALDI-quadrupole time-of-flight mass spectrometry and BLAST homology searching</article-title><source>Anal Chem</source><year>2001</year><volume>73</volume><fpage>1917</fpage><lpage>1926</lpage><pub-id pub-id-type="pmid">11354471</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mann</surname><given-names>M</given-names></name><name><surname>Wilm</surname><given-names>M</given-names></name></person-group><article-title>Error-tolerant identification of peptides in sequence databases by peptide sequence tags</article-title><source>Anal Chem</source><year>1994</year><volume>66</volume><fpage>4390</fpage><lpage>4399</lpage><pub-id pub-id-type="pmid">7847635</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sunyaev</surname><given-names>S</given-names></name><name><surname>Liska</surname><given-names>AJ</given-names></name><name><surname>Golod</surname><given-names>A</given-names></name><name><surname>Shevchenko</surname><given-names>A</given-names></name><name><surname>Shevchenko</surname><given-names>A</given-names></name></person-group><article-title>Multitag: Multiple error-tolerant sequence tag search for the sequence-similarity identification of proteins by mass spectrometry</article-title><source>Anal Chem</source><year>2003</year><volume>75</volume><fpage>1307</fpage><lpage>1315</lpage><pub-id pub-id-type="pmid">12659190</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tabb</surname><given-names>DL</given-names></name><name><surname>Saraf</surname><given-names>S</given-names></name><name><surname>Yates</surname><given-names>JR</given-names><suffix>III</suffix></name></person-group><article-title>Gutentag: High-throughput sequence tagging via an empirically derived fragmentation model</article-title><source>Anal Chem</source><year>2003</year><volume>75</volume><fpage>6415</fpage><lpage>6421</lpage><pub-id pub-id-type="pmid">14640709</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eng</surname><given-names>JK</given-names></name><name><surname>McCormack</surname><given-names>AL</given-names></name><name><surname>Yates</surname><given-names>JR</given-names><suffix>III</suffix></name></person-group><article-title>An approach to correlate tandem mass spectral data of peptides with amino acid sequences in a protein database</article-title><source>J Am Soc Mass Spectrom</source><year>1994</year><volume>5</volume><fpage>976</fpage><lpage>989</lpage></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pevzner</surname><given-names>PA</given-names></name><name><surname>Dancik</surname><given-names>V</given-names></name><name><surname>Tang</surname><given-names>CL</given-names></name></person-group><article-title>Mutation-tolerant protein identification by mass spectrometry</article-title><source>J Comput Biol</source><year>2000</year><volume>7</volume><fpage>777</fpage><lpage>787</lpage><pub-id pub-id-type="pmid">11382361</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Field</surname><given-names>HI</given-names></name><name><surname>Fenyo</surname><given-names>D</given-names></name><name><surname>Beavis</surname><given-names>RC</given-names></name></person-group><article-title>A bioinformatics solution that automates proteome mass spectral analysis, optimises protein identification, and archives data in a relational database</article-title><source>Proteomics</source><year>2002</year><volume>2</volume><fpage>36</fpage><lpage>47</lpage><pub-id pub-i