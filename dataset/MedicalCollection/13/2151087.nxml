</name><name><surname>Burgess</surname><given-names>JG</given-names></name></person-group><year>2002</year><article-title>Design and activity of antimicrobial peptides against sporogonic-stage parasites causing murine malarias</article-title><source>Antimicrob Agents Chemother</source><volume>46</volume><fpage>2104</fpage><lpage>2110</lpage><pub-id pub-id-type="pmid">12069961</pub-id></citation></ref><ref id="ppat-0030192-b011"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nirmala</surname><given-names>X</given-names></name><name><surname>James</surname><given-names>AA</given-names></name></person-group><year>2003</year><article-title>Engineering <italic>Plasmodium</italic>-refractory phenotypes in mosquitoes</article-title><source>Trends Parasitol</source><volume>19</volume><fpage>384</fpage><lpage>387</lpage><pub-id pub-id-type="pmid">12957511</pub-id></citation></ref><ref id="ppat-0030192-b012"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Riehle</surname><given-names>MA</given-names></name><name><surname>Srinivasan</surname><given-names>P</given-names></name><name><surname>Moreira</surname><given-names>CK</given-names></name><name><surname>Jacobs-Lorena</surname><given-names>M</given-names></name></person-group><year>2003</year><article-title>Towards genetic manipulation of wild mosquito populations to combat malaria: advances and challenges</article-title><source>J Exp Biol</source><volume>206</volume><fpage>3809</fpage><lpage>3816</lpage><pub-id pub-id-type="pmid">14506216</pub-id></citation></ref><ref id="ppat-0030192-b013"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ito</surname><given-names>J</given-names></name><name><surname>Ghosh</surname><given-names>A</given-names></name><name><surname>Moreira</surname><given-names>LA</given-names></name><name><surname>Wimmer</surname><given-names>EA</given-names></name><name><surname>Jacobs-Lorena</surname><given-names>M</given-names></name></person-group><year>2002</year><article-title>Transgenic anopheline mosquitoes impaired in transmission of a malaria parasite</article-title><source>Nature</source><volume>417</volume><fpage>452</fpage><lpage>455</lpage><pub-id pub-id-type="pmid">12024215</pub-id></citation></ref><ref id="ppat-0030192-b014"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moreira</surname><given-names>LA</given-names></name><name><surname>Ito</surname><given-names>J</given-names></name><name><surname>Ghosh</surname><given-names>A</given-names></name><name><surname>Devenport</surname><given-names>M</given-names></name><name><surname>Zieler</surname><given-names>H</given-names></name><etal/></person-group><year>2002</year><article-title>Bee venom phospholipase inhibits malaria parasite development in transgenic mosquitoes</article-title><source>J Biol Chem</source><volume>277</volume><fpage>40839</fpage><lpage>40843</lpage><pub-id pub-id-type="pmid">12167627</pub-id></citation></ref><ref id="ppat-0030192-b015"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moreira</surname><given-names>LA</given-names></name><name><surname>Wang</surname><given-names>J</given-names></name><name><surname>Collins</surname><given-names>FH</given-names></name><name><surname>Jacobs-Lorena</surname><given-names>M</given-names></name></person-group><year>2004</year><article-title>Fitness of anopheline mosquitoes expressing transgenes that inhibit <italic>Plasmodium</italic> development</article-title><source>Genetics</source><volume>166</volume><fpage>1337</fpage><lpage>1341</lpage><pub-id pub-id-type="pmid">15082552</pub-id></citation></ref><ref id="ppat-0030192-b016"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ghosh</surname><given-names>A</given-names></name><name><surname>Edwards</surname><given-names>MJ</given-names></name><name><surname>Jacobs-Lorena</surname><given-names>M</given-names></name></person-group><year>2000</year><article-title>The journey of the malaria parasite in the mosquito: hopes for the new century</article-title><source>Parasitol Today</source><volume>16</volume><fpage>196</fpage><lpage>201</lpage><pub-id pub-id-type="pmid">10782078</pub-id></citation></ref><ref id="ppat-0030192-b017"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Billker</surname><given-names>O</given-names></name><name><surname>Lindo</surname><given-names>V</given-names></name><name><surname>Panico</surname><given-names>M</given-names></name><name><surname>Etienne</surname><given-names>AE</given-names></name><name><surname>Paxton</surname><given-names>T</given-names></name><etal/></person-group><year>1998</year><article-title>Identification of xanthurenic acid as the putative inducer of malaria development in the mosquito</article-title><source>Nature</source><volume>392</volume><fpage>289</fpage><lpage>292</lpage><pub-id pub-id-type="pmid">9521324</pub-id></citation></ref><ref id="ppat-0030192-b018"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Billker</surname><given-names>O</given-names></name><name><surname>Dechamps</surname><given-names>S</given-names></name><name><surname>Tewari</surname><given-names>R</given-names></name><name><surname>Wenig</surname><given-names>G</given-names></name><name><surname>Franke-Fayard</surname><given-names>B</given-names></name><etal/></person-group><year>2004</year><article-title>Calcium and a calcium-dependent protein kinase regulate gamete formation and mosquito transmission in a malaria parasite</article-title><source>Cell</source><volume>117</volume><fpage>503</fpage><lpage>514</lpage><pub-id pub-id-type="pmid">15137943</pub-id></citation></ref><ref id="ppat-0030192-b019"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hatake