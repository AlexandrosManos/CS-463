><pub-id pub-id-type="pmid">16906017</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Klepstad</surname><given-names>P</given-names></name><name><surname>Rakvag</surname><given-names>TT</given-names></name><name><surname>Kaasa</surname><given-names>S</given-names></name><name><surname>Holthe</surname><given-names>M</given-names></name><name><surname>Dale</surname><given-names>O</given-names></name><name><surname>Borchgrevink</surname><given-names>PC</given-names></name><name><surname>Baar</surname><given-names>C</given-names></name><name><surname>Vikan</surname><given-names>T</given-names></name><name><surname>Krokan</surname><given-names>HE</given-names></name><name><surname>Skorpen</surname><given-names>F</given-names></name></person-group><article-title>The 118A&#x0003e;G polymorphism in the human mu-opioid receptor gene may increase morphine requirements in patients with pain caused by malignant disease</article-title><source>Acta Anaesthesiol Scand</source><year>2004</year><volume>48</volume><fpage>1232</fpage><lpage>1239</lpage><pub-id pub-id-type="pmid">15504181</pub-id><pub-id pub-id-type="doi">10.1111/j.1399-6576.2004.00517.x</pub-id></citation></ref></ref-list></back></article>