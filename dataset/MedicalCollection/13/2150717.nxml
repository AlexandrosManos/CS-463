r>1997</year><fpage>623</fpage><lpage>627</lpage><pub-id pub-id-type="pmid">9121588</pub-id></citation></ref><ref id="LiandNicklas1995"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>X.</given-names></name><name><surname>Nicklas</surname><given-names>R.B.</given-names></name></person-group><article-title>Mitotic forces control a cell-cycle checkpoint</article-title><source>Nature</source><volume>373</volume><year>1995</year><fpage>630</fpage><lpage>632</lpage><pub-id pub-id-type="pmid">7854422</pub-id></citation></ref><ref id="LiandMurray1991"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>Y.</given-names></name><name><surname>Murray</surname><given-names>A.W.</given-names></name></person-group><article-title>Feedback control of mitosis in budding yeast</article-title><source>Cell</source><volume>66</volume><year>1991</year><fpage>519</fpage><lpage>531</lpage><pub-id pub-id-type="pmid">1651172</pub-id></citation></ref><ref id="LiandBenezra1996"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>Y.</given-names></name><name><surname>Benezra</surname><given-names>R.</given-names></name></person-group><article-title>Identification of a human mitotic checkpoint genehsMAD2</article-title><source>Science</source><volume>274</volume><year>1996</year><fpage>246</fpage><lpage>248</lpage><pub-id pub-id-type="pmid">8824189</pub-id></citation></ref><ref id="Maddoxetal2000"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maddox</surname><given-names>P.S.</given-names></name><name><surname>Bloom</surname><given-names>K.S.</given-names></name><name><surname>Salmon</surname><given-names>E.D.</given-names></name></person-group><article-title>The polarity and dynamics of microtubule assembly in the budding yeast <italic>Saccharomyces cerevisiae</