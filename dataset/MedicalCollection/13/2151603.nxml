pmid">8041729</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal">Corson, D.W., M.C. Cornwall, and D.R. Pepperberg. <year>1994</year>b. Evidence for the prolonged photoactivated lifetime of an analogue visual pigment containing 11-cis 9-desmethylretinal. <source>Vis. Neurosci.</source> <volume>11</volume>:<fpage>91</fpage>&#x02013;98.<pub-id pub-id-type="pmid">8011585</pub-id></citation></ref><ref id="bib18"><citation citation-type="journal">Cowan, C.W., R.N. Fariss, I. Sokal, K. Palczewski, and T.G. Wensel. <year>1998</year>. High expression levels in cones of RGS9, the predominant GTPase accelerating protein of rods. <source>Proc. Natl. Acad. Sci. USA.</source> <volume>95</volume>:<fpage>5351</fpage>&#x02013;5356.<pub-id pub-id-type="pmid">9560279</pub-id></citation></ref><ref id="bib19"><citation citation-type="other">Crouch, R.K., V.J. Kefalov, W. Gaertner, and M.C. Cornwall. <year>2002</year>. Use of retinal analogues for the study of visual pigment function. <italic>In</italic> Methods in Enzymology: G Protein Pathways. Vol. 343. R. Ivengar and J.D.H. Hildebrandt, editors. Academic Press, Inc., San Diego. 29&#x02013;48.</citation></ref><ref id="bib20"><citation citation-type="journal">Das, J., R.K. Crouch, J.X. Ma, D.D. Oprian, and M. Kono. <year>2004</year>. Role of the 9-methyl group of retinal in cone visual pigments. <source>Biochemistry.</source> <volume>43</volume>:<fpage>5532</fpage>&#x02013;5538.<pub-id pub-id-type="pmid">15122919</pub-id></citation></ref><ref id="bib21"><citation citation-type="journal">Donner, K.O., and S. Hemil&#x000e4;. <year>1975</year>. Kinetics of long-lived rhodopsin photoproducts in the frog retina as a function of the amount bleached. <source>Vision Res.</source> <volume>15</volume>:<fpage>985</fpage>&#x02013;995.<pub-id pub-id-type="pmid">1080927</pub-id></citation></ref><ref id="bib22"><citation citation-type="journal">Fain, G.L., H.R. Matthews, M.C. Cornwall, and Y. Koutalos. <year>2001</year>. Adaptation in vertebrate photoreceptors. <source>Physiol. Rev.</source> <volume>81</volume>:<fpage>117</fpage>&#x02013;151.<pub-id pub-id-type="pmid">11152756</pub-id></citation></ref><ref id="bib23"><citation citation-type="journal">Firsov, M.L., A.V. Kolesnikov, E.Y. Golobokova, and V.I. Govardovskii. <year>2005</year>. Two realms of dark adaptation. <source>Vision Res.</source> <volume>45</volume>:<fpage>147</fpage>&#x02013;151.<pub-id pub-id-type="pmid">15581916</pub-id></citation></ref><ref id="bib24"><citation citation-type="journal">Govardovskii, V.I., N. Fyhrquist, T. Reuter, D.G. Kuzmin, and K. Donner. <year>2000</year>. In search of the visual pigment template. <source>Vis. Neurosci.</source> <volume>17</volume>:<fpage>509</fpage>&#x02013;528.<pub-id pub-id-type="pmid">11016572</pub-id></citation></ref><ref id="bib25"><citation citation-type="journal">He, Q., D Alexeev, M.E. Estevez, S.L. McCabe, P.D. Calvert, D.E. Ong, M.C. Cornwall, A.L. Zimmerman, and C.L. Makino. <year>2006</year>. Cyclic Nucleotide-gated Ion Channels in Rod Photoreceptors Are Protected from Retinoid Inhibition. <source>J. Gen. Physiol.</source> <volume>128</volume>:<fpage>473</fpage>&#x02013;485.<pub-id pub-id-type="pmid">17001087</pub-id></citation></ref><ref id="bib26"><citation citation-type="journal">He, W., C.W. Cowan, and T.G. Wensel. <year>1998</year>. RGS9, a GTPase accelerator for phototransduction. <source>Neuron.</source> <volume>20</volume>:<fpage>95</fpage>&#x02013;102.<pub-id pub-id-type="pmid">9459445</pub-id></citation></ref><ref id="bib27"><citation citation-type="journal">Hodgkin, A.L., and B.J. Nunn. <year>1988</year>. Control of light-sensitive current in salamander rods. <source>J. Physiol.</source> <volume>403</volume>:<fpage>439</fpage>&#x02013;471.<pub-id pub-id-type="pmid">2473195</pub-id></citation></ref><ref id="bib28"><citation citation-type="journal">Hofmann, K.P., A. Pulvermuller, J. Buczylko, P. Van Hooser, and K. Palczewski. <year>1992</year>. The role of ar