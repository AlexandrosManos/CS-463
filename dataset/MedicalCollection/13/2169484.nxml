source>Biochem. J.</source><volume>330</volume><year>1998</year><fpage>1383</fpage><lpage>1390</lpage><pub-id pub-id-type="pmid">9494110</pub-id></citation></ref><ref id="Boydeetal1984"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boyde</surname><given-names>A.</given-names></name><name><surname>Ali</surname><given-names>N.N.</given-names></name><name><surname>Jones</surname><given-names>S.J.</given-names></name></person-group><article-title>Resorption of dentine by isolated osteoclasts <italic>in vitro</italic></article-title><source>Brit. Dental J</source><volume>156</volume><year>1984</year><fpage>216</fpage><lpage>220</lpage></citation></ref><ref id="Cesanoetal1998"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cesano</surname><given-names>A.</given-names></name><name><surname>Visonneau</surname><given-names>S.</given-names></name><name><surname>Deaglio</surname><given-names>S.</given-names></name><name><surname>Malavasi</surname><given-names>F.</given-names></name><name><surname>Santoli</surname><given-names>D.</given-names></name></person-group><article-title>Role of CD38 and its ligand in the regulation of MHC-nonrestricted cytotoxic T cells</article-title><source>J. Immunol.</source><volume>160</volume><year>1998</year><fpage>1106</fpage><lpage>1115</lpage><pub-id pub-id-type="pmid">9570523</pub-id></citation></ref><ref id="Chambersetal1984"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chambers</surname><given-names>T.J.</given-names></name><name><surname>Revell</surname><given-names>O.A.</given-names></name><name><surname>Fuller</surname><given-names>K.</given-names></name><name><surname>Athanasou</surname><given-names>N.A.</given-names></name></person-group><article-title>Resorption of bone by isolated rabbit osteoclasts</article-title><source>J. Cell Sci.</source><volume>66</volume><year>1984</year><fpage>383</fpage><lpage>