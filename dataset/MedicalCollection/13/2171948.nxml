wspan="1" align="left" valign="top">ND</td><td colspan="1" rowspan="1" align="left" valign="top">12.98%</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Phyt</td><td colspan="1" rowspan="1" align="char" char="." valign="top">18.60%</td><td colspan="1" rowspan="1" align="char" char="." valign="top">40.87%</td><td colspan="1" rowspan="1" align="center" valign="top">C26&#x000b0;:0oh2</td><td colspan="1" rowspan="1" align="char" char="." valign="top">0.00%</td><td colspan="1" rowspan="1" align="char" char="." valign="top">0.35%</td><td colspan="1" rowspan="1" align="left" valign="top">GM1</td><td colspan="1" rowspan="1" align="left" valign="top">ND</td><td colspan="1" rowspan="1" align="left" valign="top">2.79%</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="char" char="." valign="top"/><td colspan="1" rowspan="1" align="char" char="." valign="top"/><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="char" char="." valign="top"/><td colspan="1" rowspan="1" align="char" char="." valign="top"/><td colspan="1" rowspan="1" align="left" valign="top">GD1a</td><td colspan="1" rowspan="1" align="left" valign="top">0.39%</td><td colspan="1" rowspan="1" align="left" valign="top">ND</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">AAG</td><td colspan="1" rowspan="1" align="char" char="." valign="top"/><td colspan="1" rowspan="1" align="char" char="." valign="top"/><td colspan="1" rowspan="1" align="center" valign="top">FAM/LCB</td><td colspan="1" rowspan="1" align="char" char="." valign="top">9.487</td><td colspan="1" rowspan="1" align="char" char="." valign="top">1.472</td><td colspan="1" rowspan="1" align="left" valign="top">GD1b</td><td colspan="1" rowspan="1" align="left" valign="top">ND</td><td colspan="1" rowspan="1" align="left" valign="top">ND</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">C16:0</td><td colspan="1" rowspan="1" align="char" char="." valign="top">48.99%</td><td colspan="1" rowspan="1" align="char" char="." valign="top">68.22%</td><td colspan="1" rowspan="1" align="center" valign="top">AAG&#x000b0;:LCB</td><td colspan="1" rowspan="1" align="char" char="." valign="top">1.106</td><td colspan="1" rowspan="1" align="char" char="." valign="top">0.079</td><td colspan="1" rowspan="1" align="left" valign="top">GT1b</td><td colspan="1" rowspan="1" align="left" valign="top">ND</td><td colspan="1" rowspan="1" align="left" valign="top">ND</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">C18:1</td><td colspan="1" rowspan="1" align="char" char="." valign="top">29.70%</td><td colspan="1" rowspan="1" align="char" char="." valign="top">4.34%</td><td colspan="1" rowspan="1" align="center" valign="top">Sugar/LCB</td><td colspan="1" rowspan="1" align="char" char="." valign="top">1.499</td><td colspan="1" rowspan="1" align="char" char="." valign="top">1.137</td><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="left" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">C18:0</td><td colspan="1" rowspan="1" align="char" char="." valign="top">21.31%</td><td colspan="1" rowspan="1" align="char" char="." valign="top">31.78%</td><td colspan="1" rowspan="1" align="center" valign="top">Gal+N/LCB</td><td colspan="1" rowspan="1" align="char" char="." valign="top">1.392</td><td colspan="1" rowspan="1" align="char" char="." valign="top">0.796</td><td colspan="1" rowspan="1" align="left" valign="top">SM</td><td colspan="1" rowspan="1" align="left" valign="top">ND</td><td colspan="1" rowspan="1" align="left" valign="top">&#x0003c;5%</td></tr><tr><td colspan="9" rowspan="1" align="left" valign="top"><bold>Treated cells</bold></td><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="