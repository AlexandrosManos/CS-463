-group-type="author"><name><surname>Pictet</surname><given-names>R.L.</given-names></name><name><surname>Clark</surname><given-names>W.R.</given-names></name><name><surname>Williams</surname><given-names>R.H.</given-names></name><name><surname>Rutter</surname><given-names>W.J.</given-names></name></person-group><article-title>An ultrastructural analysis of the developing embryonic pancreas</article-title><source>Dev. Biol.</source><volume>29</volume><year>1972</year><fpage>436</fpage><lpage>467</lpage><pub-id pub-id-type="pmid">4570759</pub-id></citation></ref><ref id="PierschbacherandRuoslahti1987"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pierschbacher</surname><given-names>M.D.</given-names></name><name><surname>Ruoslahti</surname><given-names>E.</given-names></name></person-group><article-title>Influence of stereochemistry of the sequence Arg-Gly-Asp-Xaa on binding specificity in cell adhesion</article-title><source>J. Biol. Chem.</source><volume>262</volume><year>1987</year><fpage>17294</fpage><lpage>17298</lpage><pub-id pub-id-type="pmid">3693352</pub-id></citation></ref><ref id="Ricordietal1988"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ricordi</surname><given-names>C.</given-names></name><name><surname>Lacy</surname><given-names>P.E.</given-names></name><name><surname>Finke</surname><given-names>E.H.</given-names></name><name><surname>Olack</surname><given-names>B.J.</given-names></name><name><surname>Sharp</surname><given-names>D.W.</given-names></name></person-group><article-title>Automated method for isolation of human pancreatic islets</article-title><source>Diabetes.</source><volume>37</volume><year>1988</year><fpage>413</fpage><lpage>420</lpage><pub-id pub-id-type="pmid">3288530</pub-id></citation></ref><ref id="Rouilleretal1991"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rouiller</surname><given-names>G.D.</giv