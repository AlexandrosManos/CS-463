mid">2665080</pub-id></citation></ref><ref id="Otonkoskietal1993"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Otonkoski</surname><given-names>T.</given-names></name><name><surname>Beattie</surname><given-names>G.M.</given-names></name><name><surname>Mally</surname><given-names>M.I.</given-names></name><name><surname>Ricordi</surname><given-names>C.</given-names></name><name><surname>Hayek</surname><given-names>A.</given-names></name></person-group><article-title>Nicotinamide is a potent inducer of endocrine differentiation in cultured human fetal pancreatic cells</article-title><source>J. Clin. Invest.</source><volume>92</volume><year>1993</year><fpage>1459</fpage><lpage>1466</lpage><pub-id pub-id-type="pmid">8104197</pub-id></citation></ref><ref id="Otonkoskietal1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Otonkoski</surname><given-names>T.</given-names></name><name><surname>Beattie</surname><given-names>G.M.</given-names></name><name><surname>Rubin</surname><given-names>J.S.</given-names></name><name><surname>Lopez</surname><given-names>A.D.</given-names></name><name><surname>Baird</surname><given-names>A.</given-names></name><name><surname>Hayek</surname><given-names>A.</given-names></name></person-group><article-title>Hepatocyte growth factor/scatter factor has insulinotropic activity in human fetal pancreatic cells</article-title><source>Diabetes.</source><volume>43</volume><year>1994</year><fpage>947</fpage><lpage>953</lpage><pub-id pub-id-type="pmid">8013761</pub-id></citation></ref><ref id="Otonkoskietal1996"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Otonkoski</surname><given-names>T.</given-names></name><name><surname>Cirulli</surname><given-names>V.</given-names></name><name><surname>Beattie</surname><given-names>G.M.</given-names></name><name><surname>Mally</surname><given-names>M.</given-names></name><name><surn