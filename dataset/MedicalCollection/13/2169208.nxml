/source><year>1995</year><volume>130</volume><fpage>860</fpage><lpage>70</lpage><pub-id pub-id-type="pmid">7572598</pub-id><pub-id pub-id-type="doi">10.1016/0002-8703(95)90089-6</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>CS</given-names></name><name><surname>Bertolet</surname><given-names>BD</given-names></name></person-group><article-title>Peripartum cardiomyopathy: a comprehensive review</article-title><source>Am J Obstet Gynecol</source><year>1998</year><volume>178</volume><fpage>409</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">9500508</pub-id><pub-id pub-id-type="doi">10.1016/S0002-9378(98)80034-3</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meadows</surname><given-names>WR</given-names></name></person-group><article-title>Idiopathic myocardial failure in the last trimester of pregnancy and the puerperium</article-title><source>Circulation</source><year>1957</year><volume>15</volume><fpage>903</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">13437416</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Walsh</surname><given-names>JJ</given-names></name><name><surname>Burch</surname><given-names>GE</given-names></name><name><surname>Black</surname><given-names>WC</given-names></name><name><surname>Ferrans</surname><given-names>VJ</given-names></name><name><surname>Hibbs</surname><given-names>RG</given-names></name></person-group><article-title>Idiopathic myocardiopathy of the puerperium (postpartal heart disease)</article-title><source>Circulation</source><year>1965</year><volume>32</volume><fpage>19</fpage><lpage>31</lpage><pub-id pub-id-type="pmid">14314486</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dema