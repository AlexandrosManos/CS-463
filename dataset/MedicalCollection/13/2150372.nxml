<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Br J Cancer</journal-id><journal-id journal-id-type="pmc">brjcancer</journal-id><journal-title>British Journal of Cancer</journal-title><issn pub-type="ppub">0007-0920</issn><issn pub-type="epub">1532-1827</issn><publisher><publisher-name>Nature Publishing Group</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">9667684</article-id><article-id pub-id-type="pmc">2150372</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research Article</subject></subj-group></article-categories><title-group><article-title>Can manipulation of a pelvic tumour influence the serum level of cancer antigen 125 and cancer-associated serum antigen?</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Kiekegaard</surname><given-names>O.</given-names></name></contrib><contrib contrib-type="author"><name><surname>Mogensen</surname><given-names>O.</given-names></name></contrib><contrib contrib-type="author"><name><surname>Mogensen</surname><given-names>B.</given-names></name></contrib><contrib contrib-type="author"><name><surname>Ahrons</surname><given-names>S.</given-names></name></contrib></contrib-group><aff>Department of Obstetrics and Gynaecology, Odense University Hospital, Odense C, Denmark.</aff><pub-date pub-type="ppub"><month>6</month><year>1998</year></pub-date><volume>77</volume><issue>11</issue><fpage>2012</fpage><lpage>2013</lpage><abstract><p>Cancer antigen 125 (CA 125) and cancer-associated serum antigen (CASA) were measured in 24 women with pelvic masses before and after a gynaecological examination and ultrasonography. CA 125 decreased median 16% after manipulation (P &#x0003c; 0.0001) and CASA decreased median 8% (P = 0.0077). The decline was found in patients with benign tumours as well as in patients with malignant tumours.</p></abstract></article-meta></front><body><supplementary-material content-type="scanned-pages"><graphic xlink:href="brjcancer00087-0304.tif" xlink:title="scanned-page" xlink:role="2012" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="brjcancer00087-0305.tif" xlink:title="scanned-page" xlink:role="2013" mimetype="image" mime-subtype="tiff"/></supplementary-material></body></article>