">7530336</pub-id></citation></ref><ref id="N0x2f46ca0N0x1de3de0"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Calder&#x000f2;</surname><given-names>J.</given-names></name><name><surname>Prevette</surname><given-names>D.</given-names></name><name><surname>Mei</surname><given-names>X.</given-names></name><name><surname>Oakley</surname><given-names>R.A.</given-names></name><name><surname>Li</surname><given-names>L.</given-names></name><name><surname>Milligan</surname><given-names>C.</given-names></name><name><surname>Houenou</surname><given-names>L.</given-names></name><name><surname>Burek</surname><given-names>M.</given-names></name><name><surname>Oppenheim</surname><given-names>R.W.</given-names></name></person-group><article-title>Peripheral target regulation of the development and survival of spinal sensory and motor neurons in the chick embryo</article-title><source>J. Neurosci.</source><volume>18</volume><year>1998</year><fpage>356</fpage><lpage>370</lpage><pub-id pub-id-type="pmid">9412513</pub-id></citation></ref><ref id="CarterandLewin1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carter</surname><given-names>B.D.</given-names></name><name><surname>Lewin</surname><given-names>G.R.</given-names></name></person-group><article-title>Neurotrophins live or let diedoes p75NTR decide?</article-title><source>Neuron.</source><volume>18</volume><year>1997</year><fpage>187</fpage><lpage>190</lpage><pub-id pub-id-type="pmid">9052790</pub-id></citation></ref><ref id="Cheemaetal1999"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cheema</surname><given-names>Z.F.</given-names></name><name><surname>Wade</surname><given-names>S.B.</given-names></name><name><surname>Sata</surname><given-names>M.</given-names></name><name><surname>Walsh</surname><given-names>K.</given-names></name><name><surname>Sohrabji</surname><given-names>F.</given-names>