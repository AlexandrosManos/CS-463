<person-group person-group-type="author"><name><surname>Azouvi</surname><given-names>P</given-names></name></person-group><article-title>Neuroimaging correlates of cognitive and functional outcome after traumatic brain injury</article-title><source>Curr Opin Neurol</source><year>2000</year><volume>13</volume><fpage>665</fpage><lpage>669</lpage><pub-id pub-id-type="pmid">11148667</pub-id><pub-id pub-id-type="doi">10.1097/00019052-200012000-00009</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fontaine</surname><given-names>A</given-names></name><name><surname>Azouvi</surname><given-names>P</given-names></name><name><surname>Remy</surname><given-names>P</given-names></name><name><surname>Bussel</surname><given-names>B</given-names></name><name><surname>Samson</surname><given-names>Y</given-names></name></person-group><article-title>Functional anatomy of neuropsychological deficits after severe traumatic brain injury</article-title><source>Neurology</source><year>1999</year><volume>53</volume><fpage>1963</fpage><lpage>1968</lpage><pub-id pub-id-type="pmid">10599766</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jenkins</surname><given-names>A</given-names></name><name><surname>Teasdale</surname><given-names>G</given-names></name><name><surname>Hadley</surname><given-names>MD</given-names></name><name><surname>Macpherson</surname><given-names>P</given-names></name><name><surname>Rowan</surname><given-names>JO</given-names></name></person-group><article-title>Brain lesions detected by magnetic resonance imaging in mild and severe head injuries</article-title><source>Lancet</source><year>1986</year><volume>2</volume><fpage>445</fpage><lpage>446</lpage><pub-id pub-id-type="pmid">2874424</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(86)92145-8</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carpentier</surname><given-names>A</given-names></name><name><surname>Galanaud</surname><given-names>D</given-names></name><name><surname>Puybasset</surname><given-names>L</given-names></name><name><surname>Muller</surname><given-names>JC</given-names></name><name><surname>Lescot</surname><given-names>T</given-names></name><name><surname>Boch</surname><given-names>AL</given-names></name><name><surname>Riedl</surname><given-names>V</given-names></name><name><surname>Cornu</surname><given-names>P</given-names></name><name><surname>Coriat</surname><given-names>P</given-names></name><name><surname>Dormont</surname><given-names>D</given-names></name><etal></etal></person-group><article-title>Early morphologic and spectroscopic magnetic resonance in severe traumatic brain injuries can detect 'invisible brain stem damage' and predict 'vegetative states'</article-title><source>J Neurotrauma</source><year>2006</year><volume>23</volume><fpage>674</fpage><lpage>685</lpage><pub-id pub-id-type="pmid">16689669</pub-id><pub-id pub-id-type="doi">10.1089/neu.2006.23.674</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Firsching</surname><given-names>R</given-names></name><name><surname>Woischneck</surname><given-names>D</given-names></name><name><surname>Diedrich</surname><given-names>M</given-names></name><name><surname>Klein</surname><given-names>S</given-names></name><name><surname>Ruckert</surname><given-names>A</given-names></name><name><surname>Wittig</surname><given-names>H</given-names></name><name><surname>Dohring</surname><given-names>W</given-names></name></person-group><article-title>Early magnetic resonance imaging of brainstem lesions after severe head injury</article-title><source>J Neurosurg</source><year>1998</year><volume>89</volume><fpage>707</fpage><lpage>712</lpage><pub-id pub-id-type="pmid">9817405</pub-id></citation><