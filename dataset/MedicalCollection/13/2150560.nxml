r-name><publisher-loc>Oxford, United Kingdom</publisher-loc></citation></ref><ref id="Haysetal1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hays</surname><given-names>T.S.</given-names></name><name><surname>Porter</surname><given-names>M.E.</given-names></name><name><surname>McGrail</surname><given-names>M.</given-names></name><name><surname>Grissom</surname><given-names>P.</given-names></name><name><surname>Gosch</surname><given-names>P.</given-names></name><name><surname>Fuller</surname><given-names>M.T.</given-names></name><name><surname>McIntosh</surname><given-names>J.R.</given-names></name></person-group><article-title>A cytoplasmic dynein motor in <italic>Drosophila</italic>identification and localization during embryogenesis</article-title><source>J. Cell Sci.</source><volume>107</volume><year>1994</year><fpage>1557</fpage><lpage>1569</lpage><pub-id pub-id-type="pmid">7962198</pub-id></citation></ref><ref id="Healdetal1996"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heald</surname><given-names>R.</given-names></name><name><surname>Tournebize</surname><given-names>R.</given-names></name><name><surname>Blank</surname><given-names>T.</given-names></name><name><surname>Sandaltzopoulos</surname><given-names>R.</given-names></name><name><surname>Becker</surname><given-names>P.</given-names></name><name><surname>Hyman</surname><given-names>A.</given-names></name><name><surname>Karsenti</surname><given-names>E.</given-names></name></person-group><article-title>Self-organization of microtubules into bipolar spindles around artificial chromosomes in <italic>Xenopus</italic> egg extracts</article-title><source>Nature.</source><volume>382</volume><year>1996</year><fpage>420</fpage><lpage>425</lpage><pub-id pub-id-type="pmid">8684481</pub-id></citation></ref><ref id="Healdetal1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heald