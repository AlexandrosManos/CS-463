lpage><pub-id pub-id-type="pmid">17599450</pub-id><pub-id pub-id-type="doi">10.1016/j.amjcard.2007.02.062</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mitchell</surname><given-names>JH</given-names></name><name><surname>Hadden</surname><given-names>TB</given-names></name><name><surname>Wilson</surname><given-names>JM</given-names></name><name><surname>Achari</surname><given-names>A</given-names></name><name><surname>Muthupillai</surname><given-names>R</given-names></name><name><surname>Flamm</surname><given-names>SD</given-names></name></person-group><article-title>Clinical features and usefulness of cardiac magnetic resonance imaging in assessing myocardial viability and prognosis in Takotsubo cardiomyopathy (transient left ventricular apical ballooning syndrome)</article-title><source>Am J Cardiol</source><year>2007</year><volume>100</volume><fpage>296</fpage><lpage>301</lpage><pub-id pub-id-type="pmid">17631086</pub-id><pub-id pub-id-type="doi">10.1016/j.amjcard.2007.02.091</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Akashi</surname><given-names>YJ</given-names></name><name><surname>Barbaro</surname><given-names>G</given-names></name><name><surname>Sakurai</surname><given-names>T</given-names></name><name><surname>Nakazawa</surname><given-names>K</given-names></name><name><surname>Miyake</surname><given-names>F</given-names></name></person-group><article-title>Cardiac autonomic imbalance in patients with reversible ventricular dysfunction takotsubo cardiomyopathy</article-title><source>Qjm</source><year>2007</year><volume>100</volume><fpage>335</fpage><lpage>343</lpage><pub-id pub-id-type="pmid">17483198</pub-id><pub-id pub-id-type="doi">10.1093/qjmed/hcm028</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wittstein</surn