id="GalanandCollmer1999"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Galan</surname><given-names>J.E.</given-names></name><name><surname>Collmer</surname><given-names>A.</given-names></name></person-group><article-title>Type III secretion machinesbacterial devices for protein delivery into host cells</article-title><source>Science.</source><volume>284</volume><year>1999</year><fpage>1322</fpage><lpage>1328</lpage><pub-id pub-id-type="pmid">10334981</pub-id></citation></ref><ref id="Galyovetal1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Galyov</surname><given-names>E.E.</given-names></name><name><surname>Wood</surname><given-names>M.W.</given-names></name><name><surname>Rosqvist</surname><given-names>R.</given-names></name><name><surname>Mullan</surname><given-names>P.B.</given-names></name><name><surname>Watson</surname><given-names>P.R.</given-names></name><name><surname>Hedges</surname><given-names>S.</given-names></name><name><surname>Wallis</surname><given-names>T.S.</given-names></name></person-group><article-title>A secreted effector protein of <italic>Salmonella dublin</italic> is translocated into eukaryotic cells and mediates inflammation and fluid secretion in infected ileal mucosa</article-title><source>Mol. Microbiol.</source><volume>25</volume><year>1997</year><fpage>903</fpage><lpage>912</lpage><pub-id pub-id-type="pmid">9364916</pub-id></citation></ref><ref id="GinsburgandStein1987"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ginsburg</surname><given-names>H.</given-names></name><name><surname>Stein</surname><given-names>W.D.</given-names></name></person-group><article-title>Biophysical analysis of novel transport pathways induced in red blood cell membranes</article-title><source>J. Membrane Biol.</source><volume>96</volume><year>1987</year><fpage>1</fpage><lpage>10</lpage><pub-id pub-id-type="pmid">3295251</p