</name><name><surname>Hooton</surname><given-names>TM</given-names></name></person-group><article-title>The efficacy of infection surveillance and control programs in preventing nosocomial infections in US hospitals</article-title><source>Am J Epidemiol</source><year>1985</year><volume>121</volume><fpage>182</fpage><lpage>205</lpage><pub-id pub-id-type="pmid">4014115</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Verdier</surname><given-names>R</given-names></name><name><surname>Parer</surname><given-names>S</given-names></name><name><surname>Jean-Pierre</surname><given-names>H</given-names></name><name><surname>Dujols</surname><given-names>P</given-names></name><name><surname>Picot</surname><given-names>MC</given-names></name></person-group><article-title>Impact of an infection control program in an intensive care unit in France</article-title><source>Infect Control Hosp Epidemiol</source><year>2006</year><volume>27</volume><fpage>60</fpage><lpage>66</lpage><pub-id pub-id-type="pmid">16418989</pub-id><pub-id pub-id-type="doi">10.1086/499150</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rosenthal</surname><given-names>VD</given-names></name><name><surname>Guzman</surname><given-names>S</given-names></name><name><surname>Crnich</surname><given-names>C</given-names></name></person-group><article-title>Impact of an infection control program on rates of ventilator-associated pneumonia in intensive care units in 2 Argentinean hospitals</article-title><source>Am J Infect Control</source><year>2006</year><volume>34</volume><fpage>58</fpage><lpage>63</lpage><pub-id pub-id-type="pmid">16490607</pub-id><pub-id pub-id-type="doi">10.1016/j.ajic.2005.11.002</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>P</given-n