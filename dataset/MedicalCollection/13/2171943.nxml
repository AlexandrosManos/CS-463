ref id="bib28"><citation citation-type="journal">Morita, K., M. Furuse, K. Fujimoto, and Sh. Tsukita. <year>1999</year>a. Claudin multigene family encoding four-transmembrane domain protein components of tight junction strands. <source>Proc. Natl. Acad. Sci. USA.</source> <volume>96</volume>:<fpage>511</fpage>&#x02013;516.<pub-id pub-id-type="pmid">9892664</pub-id></citation></ref><ref id="bib29"><citation citation-type="journal">Morita, K., H. Sasaki, K. Fujimoto, M. Furuse, and Sh. Tsukita. <year>1999</year>b. Claudin-11/OSP-based tight junctions of myelin sheaths in brain and Sertoli cells in testis. <source>J. Cell Biol.</source> <volume>145</volume>:<fpage>579</fpage>&#x02013;588.<pub-id pub-id-type="pmid">10225958</pub-id></citation></ref><ref id="bib30"><citation citation-type="journal">Morita, K., H. Sasaki, M. Furuse, and Sh. Tsukita. <year>1999</year>c. Endothelial claudin: claudin-5/TMVCF constitutes tight junction strands in endothelial cells. <source>J. Cell Biol.</source> <volume>147</volume>:<fpage>185</fpage>&#x02013;194.<pub-id pub-id-type="pmid">10508865</pub-id></citation></ref><ref id="bib31"><citation citation-type="journal">Mugnaini, E., and B. Schnapp. <year>1974</year>. Possible role of zonula occludens of the myelin sheath in demyelinating conditions. <source>Nature.</source> <volume>251</volume>:<fpage>725</fpage>&#x02013;727.<pub-id pub-id-type="pmid">4610402</pub-id></citation></ref><ref id="bib32"><citation citation-type="journal">Nelson, W.J. <year>2003</year>. Adaptation of core mechanisms to generate cell polarity. <source>Nature.</source> <volume>422</volume>:<fpage>766</fpage>&#x02013;774.<pub-id pub-id-type="pmid">12700771</pub-id></citation></ref><ref id="bib33"><citation citation-type="journal">Pedraza, L., J.K. Huang, and D.R. Colman. <year>2001</year>. Organizing principles of the axo-glial apparatus. <source>Neuron.</source> <volume>30</volume>:<fpage>335</fpage>&#x02013;344.<pub-id pub-id-type="pmid">11394997</pub-id></citati