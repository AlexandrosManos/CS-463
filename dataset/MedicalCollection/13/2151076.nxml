2-2</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Julia</surname><given-names>M</given-names></name><name><surname>Stacino</surname><given-names>JP</given-names></name></person-group><source>Tetrahedron</source><year>1986</year><volume>42</volume><fpage>2469</fpage><lpage>2474</lpage><pub-id pub-id-type="doi">10.1016/0040-4020(86)80010-2</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Julia</surname><given-names>M</given-names></name><name><surname>Launay</surname><given-names>M</given-names></name><name><surname>Stacino</surname><given-names>JP</given-names></name><name><surname>Verpeaux</surname><given-names>JN</given-names></name></person-group><source>Tetrahdron Lett</source><year>1982</year><volume>23</volume><fpage>2465</fpage><lpage>2468</lpage><pub-id pub-id-type="doi">10.1016/S0040-4039(00)87369-4</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ritter</surname><given-names>FJ</given-names></name><name><surname>Rotgans</surname><given-names>IEM</given-names></name><name><surname>Talman</surname><given-names>E</given-names></name><name><surname>Verwiel</surname><given-names>PEJ</given-names></name><name><surname>Stein</surname><given-names>F</given-names></name></person-group><source>Experientia</source><year>1973</year><volume>29</volume><fpage>530</fpage><lpage>531</lpage><pub-id pub-id-type="doi">10.1007/BF01926645</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Conchon</surname><given-names>E</given-names></name><name><surname>Gelas-Mialhe</surname><given-names>Y</given-names></name><name><surname>Remuson</surname><given-names>R</given-names></name></person-group><source>Tetrahedron: Asymmetry</source><year>2006</year><volume>17</volume>