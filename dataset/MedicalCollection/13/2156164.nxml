evelopment.</source><volume>122</volume><year>1996</year><fpage>429</fpage><lpage>437</lpage>b <pub-id pub-id-type="pmid">8625794</pub-id></citation></ref><ref id="Cusella-DeAngelisetal1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cusella-De Angelis</surname><given-names>M.G.</given-names></name><name><surname>Molinari</surname><given-names>S.</given-names></name><name><surname>Ledonne</surname><given-names>A.</given-names></name><name><surname>Coletta</surname><given-names>M.</given-names></name><name><surname>Vivarelli</surname><given-names>E.</given-names></name><name><surname>Bouche</surname><given-names>M.</given-names></name><name><surname>Molinaro</surname><given-names>M.</given-names></name><name><surname>Ferrari</surname><given-names>S.</given-names></name><name><surname>Cossu</surname><given-names>G.</given-names></name></person-group><article-title>Differential response of embryonic and fetal myoblasts to TGF&#x003b2;a possible regulatory mechanism of skeletal muscle histogenesis</article-title><source>Development.</source><volume>120</volume><year>1994</year><fpage>925</fpage><lpage>933 </lpage><pub-id pub-id-type="pmid">7600968</pub-id></citation></ref><ref id="Denetclawetal1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Denetclaw</surname><given-names>W.F.</given-names></name><name><surname>Christ</surname><given-names>B.</given-names></name><name><surname>Ordhal</surname><given-names>C.P.</given-names></name></person-group><article-title>Location and growth of epaxial myotome precursor cells</article-title><source>Development.</source><volume>124</volume><year>1997</year><fpage>1601</fpage><lpage>1610 </lpage><pub-id pub-id-type="pmid">9108376</pub-id></citation></ref><ref id="Ferrarietal1998"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferrari</surname><given-names>G.</given-names></name><name><surname>Cusell