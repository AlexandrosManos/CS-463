ticle-title>When (not) to stop a clinical trial for benefit</article-title><source>JAMA</source><year>2005</year><volume>294</volume><fpage>2228</fpage><lpage>2230</lpage><pub-id pub-id-type="pmid">16264167</pub-id><pub-id pub-id-type="doi">10.1001/jama.294.17.2228</pub-id></citation></ref></ref-list></back></article>