>M.E.</given-names></name><name><surname>Vassar</surname><given-names>R.</given-names></name><name><surname>Fuchs</surname><given-names>E.</given-names></name></person-group><article-title>A function for keratins and a common thread among different types of epidermolysis bullosa simplex diseases</article-title><source>J. Cell Biol</source><volume>115</volume><year>1991</year><fpage>1661</fpage><lpage>1674</lpage><pub-id pub-id-type="pmid">1721910</pub-id></citation></ref><ref id="R10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Erber</surname><given-names>A.</given-names></name><name><surname>Riemer</surname><given-names>D.</given-names></name><name><surname>Bovenschulte</surname><given-names>M.</given-names></name><name><surname>Weber</surname><given-names>K.</given-names></name></person-group><article-title>Molecular phylogeny of metazoan intermediate filament proteins</article-title><source>J. Mol. Evol.</source><volume>47</volume><year>1998</year><fpage>751</fpage><lpage>762</lpage><pub-id pub-id-type="pmid">9847417</pub-id></citation></ref><ref id="R11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Filion</surname><given-names>M.</given-names></name><name><surname>Sarafian</surname><given-names>V.</given-names></name><name><surname>Lussier</surname><given-names>M.</given-names></name><name><surname>Belanger</surname><given-names>C.</given-names></name><name><surname>LaPointe</surname><given-names>L.</given-names></name><name><surname>Royal</surname><given-names>A.</given-names></name></person-group><article-title>Arrangement of a cluster of three mouse type I keratin genes expressed sequentially during esophageal-type epithelial cell differentiation</article-title><source>Genomics.</source><volume>24</volume><year>1994</year><fpage>303</fpage><lpage>310</lpage><pub-id pub-id-type="pmid">7535287</pub-id></citation></ref><ref id="R12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fuchs</surname><given-names>E.</given-names></name><name><surname>Green</surname><given-names>H.</given-names></name></person-group><article-title>Changes in keratin gene expression during terminal differentiation of the keratinocyte</article-title><source>Cell.</source><volume>19</volume><year>1980</year><fpage>1033</fpage><lpage>1042</lpage><pub-id pub-id-type="pmid">6155214</pub-id></citation></ref><ref id="R13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fuchs</surname><given-names>E.</given-names></name><name><surname>Esteves</surname><given-names>R.A.</given-names></name><name><surname>Coulombe</surname><given-names>P.A.</given-names></name></person-group><article-title>Trans&#x02013;genic mice expressing a mutant keratin 10 gene reveal the likely genetic basis for epidermolytic hyperkeratosis</article-title><source>Proc. Natl. Acad. Sci. USA.</source><volume>89</volume><year>1992</year><fpage>6906</fpage><lpage>6010</lpage><pub-id pub-id-type="pmid">1379726</pub-id></citation></ref><ref id="R14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grinnell</surname><given-names>F.</given-names></name></person-group><article-title>Wound repair, keratinocyte activation and integrin modulation</article-title><source>J. Cell Sci.</source><volume>101</volume><year>1992</year><fpage>1</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">1569118</pub-id></citation></ref><ref id="R15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Holland</surname><given-names>P.W.H.</given-names></name><name><surname>Garcia-Fernandez</surname><given-names>J.</given-names></name></person-group><article-title><italic>Hox</italic> genes and chordate evolution</article-title><source>Dev. Biol.</source><volume>173</volume><year>1996</year><fpage>382</fpage><lpage>395</lpage><pub-id pub-id-type="pmid">8605999</pub-id><