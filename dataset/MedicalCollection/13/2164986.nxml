n-group-type="author"><name><surname>Leonhardt</surname><given-names>H.</given-names></name><name><surname>Page</surname><given-names>A.W.</given-names></name><name><surname>Weier</surname><given-names>H.U.</given-names></name><name><surname>Bestor</surname><given-names>T.H.</given-names></name></person-group><article-title>A targeting sequence directs DNA methyltransferase to sites of DNA replication in mammalian nuclei</article-title><source>Cell</source><volume>71</volume><year>1992</year><fpage>865</fpage><lpage>873</lpage><pub-id pub-id-type="pmid">1423634</pub-id></citation></ref><ref id="Lietal1993"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>E.</given-names></name><name><surname>Beard</surname><given-names>C.</given-names></name><name><surname>Jaenisch</surname><given-names>R.</given-names></name></person-group><article-title>Role for DNA methylation in genomic imprinting</article-title><source>Nature</source><volume>366</volume><year>1993</year><fpage>362</fpage><lpage>365</lpage><pub-id pub-id-type="pmid">8247133</pub-id></citation></ref><ref id="Lietal1992"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>E.</given-names></name><name><surname>Bestor</surname><given-names>T.H.</given-names></name><name><surname>Jaenisch</surname><given-names>R.</given-names></name></person-group><article-title>Targeted mutation of the DNA methyltransferase gene results in embryonic lethality</article-title><source>Cell</source><volume>69</volume><year>1992</year><fpage>915</fpage><lpage>926</lpage><pub-id pub-id-type="pmid">1606615</pub-id></citation></ref><ref id="Lietal1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>X.</given-names></name><name><surname>Shou</surname><given-names>W.</given-names></name><name><surname>Kloc</surname><given-names>M.</given-names></nam