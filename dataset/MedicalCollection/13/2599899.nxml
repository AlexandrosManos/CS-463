pub-id-type="pmid">15996774</pub-id><pub-id pub-id-type="doi">10.1016/j.ijcard.2005.05.060</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cherian</surname><given-names>J</given-names></name><name><surname>Angelis</surname><given-names>D</given-names></name><name><surname>Filiberti</surname><given-names>A</given-names></name><name><surname>Saperia</surname><given-names>G</given-names></name></person-group><article-title>Recurrence of stress-induced (takotsubo) cardiomyopathy</article-title><source>Cardiology</source><year>2007</year><volume>108</volume><fpage>144</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">17063014</pub-id><pub-id pub-id-type="doi">10.1159/000096476</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blessing</surname><given-names>E</given-names></name><name><surname>Steen</surname><given-names>H</given-names></name><name><surname>Rosenberg</surname><given-names>M</given-names></name><name><surname>Katus</surname><given-names>H</given-names></name><name><surname>Frey</surname><given-names>N</given-names></name></person-group><article-title>Recurrence of takotsubo cardiomyopathy with variant forms of left ventricular dysfunction</article-title><source>J Am Soc Echocardiogr</source><year>2007</year><volume>20</volume><fpage>439.e11</fpage><lpage>2</lpage><pub-id pub-id-type="pmid">17400129</pub-id><pub-id pub-id-type="doi">10.1016/j.echo.2006.10.021</pub-id></citation></ref></ref-list></back></article>