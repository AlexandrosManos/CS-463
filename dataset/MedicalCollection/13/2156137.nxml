<person-group person-group-type="author"><name><surname>Burridge</surname><given-names>K.</given-names></name><name><surname>Turner</surname><given-names>C.E.</given-names></name><name><surname>Romer</surname><given-names>L.H.</given-names></name></person-group><article-title>Tyrosine phosphorylation of paxillin and pp125(fak) accompanies cell-adhesion to extracellular matrixa role in cytoskeletal assembly</article-title><source>J. Cell Biol.</source><volume>119</volume><year>1992</year><fpage>893</fpage><lpage>903</lpage><pub-id pub-id-type="pmid">1385444</pub-id></citation></ref><ref id="Cantleyetal1991"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cantley</surname><given-names>L.C.</given-names></name><name><surname>Auger</surname><given-names>K.R.</given-names></name><name><surname>Carpenter</surname><given-names>C.</given-names></name><name><surname>Duckworth</surname><given-names>B.</given-names></name><name><surname>Graziani</surname><given-names>A.</given-names></name><name><surname>Kapeller</surname><given-names>R.</given-names></name><name><surname>Soltoff</surname><given-names>S.</given-names></name></person-group><article-title>Oncogenes and signal transduction</article-title><source>Cell.</source><volume>64</volume><year>1991</year><fpage>281</fpage><lpage>302</lpage><pub-id pub-id-type="pmid">1846320</pub-id></citation></ref><ref id="CarpenterandCantley1996"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carpenter</surname><given-names>C.L.</given-names></name><name><surname>Cantley</surname><given-names>L.C.</given-names></name></person-group><article-title>Phosphoinositide kinases</article-title><source>Curr. Opin. Cell Biol.</source><volume>8</volume><year>1996</year><fpage>153</fpage><lpage>158</lpage><pub-id pub-id-type="pmid">8791418</pub-id></citation></ref><ref id="Chantryetal1997"><citation citation-type="journal"><person-group person-group-type="author"><n