uthor"><name><surname>Ross</surname><given-names>CE</given-names></name><name><surname>Van Willigen</surname><given-names>M</given-names></name></person-group><article-title>Education and the subjective quality of life</article-title><source>J Health Soc Behav</source><year>1997</year><volume>38</volume><fpage>275</fpage><lpage>297</lpage><pub-id pub-id-type="pmid">9343965</pub-id><pub-id pub-id-type="doi">10.2307/2955371</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mirowsky</surname><given-names>J</given-names></name><name><surname>Ross</surname><given-names>CE</given-names></name></person-group><article-title>Eliminating defense and agreement bias from measures of the sense of control: A 2 &#x000d7; 2 index</article-title><source>Soc Psychol Q</source><year>1991</year><volume>54</volume><fpage>127</fpage><lpage>145</lpage><pub-id pub-id-type="doi">10.2307/2786931</pub-id></citation></ref><ref id="B25"><citation citation-type="book"><person-group person-group-type="author"><collab>National Heart, Lung and Blood Institute</collab></person-group><source>Clinical Guidelines on the Identification, Evaluation, and Treatment of Overweight and Obesity in Adults</source><year>1998</year><publisher-name>Bethesda, MD, National Institutes of Health</publisher-name></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Surgenor</surname><given-names>LJ</given-names></name><name><surname>Horn</surname><given-names>J</given-names></name><name><surname>Hudson</surname><given-names>SM</given-names></name></person-group><article-title>Links between psychological sense of control and disturbed eating behavior in women with diabetes mellitus. Implications for predictors of metabolic control</article-title><source>J Psychosom Res</source><year>2002</year><volume>52</volume><fpage>121</fpage><lpage>128</lpage><pub-id pub-id-type="pmid">11