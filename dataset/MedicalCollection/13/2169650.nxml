e><pub-id pub-id-type="pmid">9746942</pub-id></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Habedanck</surname><given-names>R</given-names></name></person-group><article-title>The Polo kinase Plk4 functions in centriole duplication</article-title><source>Nat Cell Biol</source><year>2005</year><volume>7</volume><fpage>1140</fpage><lpage>1146</lpage><pub-id pub-id-type="pmid">16244668</pub-id></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hammarton</surname><given-names>TC</given-names></name></person-group><article-title>The cell cycle of parasitic protozoa: potential for chemotherapeutic exploitation</article-title><source>Prog Cell Cycle Res</source><year>2003a</year><volume>5</volume><fpage>91</fpage><lpage>101</lpage><pub-id pub-id-type="pmid">14593704</pub-id></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hammarton</surname><given-names>TC</given-names></name></person-group><article-title>Stage-specific differences in cell cycle control in <italic>Trypanosoma brucei</italic> revealed by RNA interference of a mitotic cyclin</article-title><source>J Biol Chem</source><year>2003b</year><volume>278</volume><fpage>22877</fpage><lpage>22886</lpage><pub-id pub-id-type="pmid">12682070</pub-id></citation></ref><ref id="b25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hammarton</surname><given-names>TC</given-names></name></person-group><article-title>The <italic>Trypanosoma brucei</italic> cyclin, CYC2, is required for cell cycle progression through G1 phase and maintenance of procyclic form cell morphology</article-title><source>J Biol Chem</source><year>2004</year><volume>279</volume><fpage>24757</fpage><lpage>24764</lpage><pub-id pub-id-type="pmid">15039435</pub-id></citation></ref><ref id="b26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hammarton</surname><given-names>TC</given-names></name></person-group><article-title><italic>Trypanosoma brucei</italic> MOB1 is required for accurate and efficient cytokinesis but not for exit from mitosis</article-title><source>Mol Microbiol</source><year>2005</year><volume>56</volume><fpage>104</fpage><lpage>116</lpage><pub-id pub-id-type="pmid">15773982</pub-id></citation></ref><ref id="b27"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hammarton</surname><given-names>TC</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Barry</surname><given-names>JD</given-names></name></person-group><article-title>Cell structure, cell division and cell cycle</article-title><source>Trypanosomes &#x02013; After the Genome.</source><year>2006</year><publisher-loc>Norfolk</publisher-loc><publisher-name>Horizon Bioscience</publisher-name><fpage>240</fpage><lpage>280</lpage></citation></ref><ref id="b28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>He</surname><given-names>CY</given-names></name></person-group><article-title>Golgi biogenesis in simple eukaryotes</article-title><source>Cell Microbiol</source><year>2007</year><volume>9</volume><fpage>566</fpage><lpage>572</lpage><pub-id pub-id-type="pmid">17223925</pub-id></citation></ref><ref id="b29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>He</surname><given-names>CY</given-names></name></person-group><article-title>Golgi duplication in <italic>Trypanosoma brucei</italic> requires Centrin2</article-title><source>Science</source><year>2005</year><volume>310</volume><fpage>1196</fpage><lpage>1198</lpage><pub-id pub-id-type="pmid">16254149</pub-id></citation></ref><ref id="b30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Helms</surname><