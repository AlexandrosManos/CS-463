-id-type="pmid">8575880</pub-id></citation></ref><ref id="N0x1cb18d0N0x2a0dac0"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van Wijnen</surname><given-names>A.J.</given-names></name><name><surname>Bidwell</surname><given-names>J.P.</given-names></name><name><surname>Fey</surname><given-names>E.G.</given-names></name><name><surname>Penman</surname><given-names>S.</given-names></name><name><surname>Lian</surname><given-names>J.B.</given-names></name><name><surname>Stein</surname><given-names>J.L.</given-names></name><name><surname>Stein</surname><given-names>G.S.</given-names></name></person-group><article-title>Nuclear matrix association of multiple sequence-specific DNA binding activities related to SP-1, ATF, CCAAT, C/EBP, OCT-1, and AP-1</article-title><source>Biochemistry</source><volume>32</volume><year>1993</year><fpage>8397</fpage><lpage>8402</lpage><pub-id pub-id-type="pmid">8357791</pub-id></citation></ref><ref id="Vincentetal1996"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vincent</surname><given-names>M.</given-names></name><name><surname>Lauriault</surname><given-names>P.</given-names></name><name><surname>Dubois</surname><given-names>M.F.</given-names></name><name><surname>Lavoie</surname><given-names>S.</given-names></name><name><surname>Bensaude</surname><given-names>O.</given-names></name><name><surname>Chabot</surname><given-names>B.</given-names></name></person-group><article-title>The nuclear matrix protein p255 is a highly phosphorylated form of RNA polymerase II largest subunit which associates with spliceosomes</article-title><source>Nucleic Acids Res.</source><volume>24</volume><year>1996</year><fpage>4649</fpage><lpage>4652</lpage><pub-id pub-id-type="pmid">8972849</pub-id></citation></ref><ref id="Visaetal1993"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Visa</surname><given-names>N.</given-names></name><n