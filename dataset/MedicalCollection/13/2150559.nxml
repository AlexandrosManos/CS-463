n></ref><ref id="Bouteilleetal1974"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bouteille</surname><given-names>M.</given-names></name><name><surname>Laval</surname><given-names>M.</given-names></name><name><surname>Dupuy-Coin</surname><given-names>A.M.</given-names></name></person-group><article-title>Localization of nuclear functions as revealed by ultrastructural autoradiography and cytochemistry. Vol 1</article-title><person-group person-group-type="editor"><name><surname>Busch</surname><given-names>H.P.</given-names></name></person-group><source>The Cell Nucleus</source><year>1974</year><fpage>3</fpage><lpage>71</lpage><publisher-name>Academic Press</publisher-name><publisher-loc>NY</publisher-loc></citation></ref><ref id="Bregmanetal1995"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bregman</surname><given-names>D.B.</given-names></name><name><surname>Du</surname><given-names>L.</given-names></name><name><surname>van der Zee</surname><given-names>S.</given-names></name><name><surname>Warren</surname><given-names>S.L.</given-names></name></person-group><article-title>Transcription-dependent redistribution of the large subunit of RNA polymerase II to discrete nuclear domains</article-title><source>J. Cell Biol.</source><volume>129</volume><year>1995</year><fpage>287</fpage><lpage>298</lpage><pub-id pub-id-type="pmid">7536746</pub-id></citation></ref><ref id="Bridgeetal1996"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bridge</surname><given-names>E.</given-names></name><name><surname>Riedel</surname><given-names>K.-U.</given-names></name><name><surname>Johansson</surname><given-names>B.-M.</given-names></name><name><surname>Pettersson</surname><given-names>U.</given-names></name></person-group><article-title>Spliced exons of adenovirus late RNAs colocalize with snRNP in a specific nuclear domain</article-title><source>J. Cell Biol.