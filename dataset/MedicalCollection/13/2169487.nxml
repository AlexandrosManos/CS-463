ear>1987</year><fpage>975</fpage><lpage>988</lpage><pub-id pub-id-type="pmid">3548998</pub-id></citation></ref><ref id="Sadleretal1986"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sadler</surname><given-names>T.W.</given-names></name><name><surname>Burridge</surname><given-names>K.</given-names></name><name><surname>Yonker</surname><given-names>J.</given-names></name></person-group><article-title>A potential role for spectrin during neurulation</article-title><source>J Embryol. Exp. Morphol</source><volume>94</volume><year>1986</year><fpage>73</fpage><lpage>82</lpage><pub-id pub-id-type="pmid">3531378</pub-id></citation></ref><ref id="Sikorskietal1991"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sikorski</surname><given-names>A.F.</given-names></name><name><surname>Terlecki</surname><given-names>G.</given-names></name><name><surname>Zagon</surname><given-names>I.S.</given-names></name><name><surname>Goodman</surname><given-names>S.R.</given-names></name></person-group><article-title>Synapsin I&#x02013;mediated interaction of brain spectrin with synaptic vesicles</article-title><source>J. Cell Biol.</source><volume>114</volume><year>1991</year><fpage>313</fpage><lpage>318</lpage><pub-id pub-id-type="pmid">1906474</pub-id></citation></ref><ref id="SpeicherandMarchesi1984"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Speicher</surname><given-names>D.W.</given-names></name><name><surname>Marchesi</surname><given-names>V.T.</given-names></name></person-group><article-title>Erythrocyte spectrin is comprised of many homologous triple helical segments</article-title><source>Nature</source><volume>311</volume><year>1984</year><fpage>177</fpage><lpage>180</lpage><pub-id pub-id-type="pmid">6472478</pub-id></citation></ref><ref id="Spradling1993"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Spradling</