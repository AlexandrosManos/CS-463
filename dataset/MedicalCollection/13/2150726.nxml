<pub-id pub-id-type="pmid">9814702</pub-id></citation></ref><ref id="Oanceaetal1998"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oancea</surname><given-names>E.</given-names></name><name><surname>Teruel</surname><given-names>M.N.</given-names></name><name><surname>Quest</surname><given-names>A.F.</given-names></name><name><surname>Meyer</surname><given-names>T.</given-names></name></person-group><article-title>Green fluorescent protein (GFP)-tagged cysteine-rich domains from protein kinase C as fluorescent indicators for diacylglycerol signaling in living cells</article-title><source>J. Cell Biol</source><volume>140</volume><year>1998</year><fpage>485</fpage><lpage>498</lpage><pub-id pub-id-type="pmid">9456311</pub-id></citation></ref><ref id="Peyronetal2000"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Peyron</surname><given-names>P.</given-names></name><name><surname>Bordier</surname><given-names>C.</given-names></name><name><surname>N'Diaye</surname><given-names>E. N.</given-names></name><name><surname>Maridonneau-Parini</surname><given-names>I.</given-names></name></person-group><article-title>Nonopsonic phagocytosis of <italic>Mycobacterium kansasii</italic> by human neutrophils depends on cholesterol and is mediated by CR3 associated with glycosylphosphatidylinositol-anchored proteins</article-title><source>J. Immunol</source><volume>165</volume><year>2000</year><fpage>5186</fpage><lpage>5191</lpage><pub-id pub-id-type="pmid">11046051</pub-id></citation></ref><ref id="Ramehetal1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rameh</surname><given-names>L.E.</given-names></name><name><surname>Arvidsson</surname><given-names>A.</given-names></name><name><surname>Carraway</surname><given-names>K.L.</given-names><suffix>III</suffix></name><name><surname>Couvillon</surname><given-names>A.D.</given-names></name><name><surname>Rath