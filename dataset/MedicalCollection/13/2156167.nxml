ge>90</lpage><publisher-name>Cold Spring Harbor Laboratory Press</publisher-name><publisher-loc>Plainview, NY </publisher-loc></citation></ref><ref id="Bretscheretal1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bretscher</surname><given-names>A.</given-names></name><name><surname>Drees</surname><given-names>B.</given-names></name><name><surname>Harsay</surname><given-names>E.</given-names></name><name><surname>Schott</surname><given-names>D.</given-names></name><name><surname>Wang</surname><given-names>T.</given-names></name></person-group><article-title>What are the basic functions of microfilaments? Insights from studies in budding yeast</article-title><source>J. Cell Biol.</source><volume>126</volume><year>1994</year><fpage>821</fpage><lpage>825 </lpage><pub-id pub-id-type="pmid">8051208</pub-id></citation></ref><ref id="Brownetal1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>J.L.</given-names></name><name><surname>Jaquenoud</surname><given-names>M.</given-names></name><name><surname>Gulli</surname><given-names>M.P.</given-names></name><name><surname>Chant</surname><given-names>J.</given-names></name><name><surname>Peter</surname><given-names>M.</given-names></name></person-group><article-title>Novel Cdc42-binding proteins Gic1 and Gic2 control cell polarity in yeast</article-title><source>Genes Dev.</source><volume>11</volume><year>1997</year><fpage>2972</fpage><lpage>2982 </lpage><pub-id pub-id-type="pmid">9367980</pub-id></citation></ref><ref id="Carrolletal1998"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carroll</surname><given-names>C.W.</given-names></name><name><surname>Altman</surname><given-names>R.</given-names></name><name><surname>Schieltz</surname><given-names>D.</given-names></name><name><surname>Yates</surname><given-names>J.R.</given-names></name><name><surname>Kellogg</surnam