d><td align="char" char=".">&#x0003c;23</td><td align="char" char=".">&#x0003c;23</td></tr><tr valign="top"><td align="left"/><td align="left">Myosin</td><td align="center">gi &#x02223; 2924770</td><td align="left"/><td align="left">141 (10<sup>&#x02212;32</sup>)</td><td align="char" char=".">&#x0003c;23</td><td align="char" char=".">&#x0003c;23</td></tr><tr valign="top"><td align="left"/><td align="left">Myosin</td><td align="center">gi &#x02223; 2494118</td><td align="left"/><td align="left">130 (10<sup>&#x02212;28</sup>)</td><td align="char" char=".">31</td><td align="char" char=".">28</td></tr><tr valign="top"><td align="left"/><td align="left">Myosin</td><td align="center">emb &#x02223; CAB36794</td><td align="left"/><td align="left">99 (10<sup>&#x02212;19</sup>)</td><td align="char" char=".">26</td><td align="char" char=".">25</td></tr><tr valign="top"><td align="left"><italic>Chlamydomonas reinhardtii</italic></td><td align="left">Myosin</td><td align="center">gi &#x02223; 3342148</td><td align="left"/><td align="left">157 (10<sup>&#x02212;36</sup>)</td><td align="char" char=".">&#x0003c;23</td><td align="char" char=".">26</td></tr><tr valign="top"><td align="left">Slime mold</td><td align="left"/><td align="center"/><td align="left"/><td align="left"/><td align="left"/><td align="left"/></tr><tr valign="bottom"><td align="left"><italic>Dictyostelium discoideum</italic></td><td align="left">Myosin IJ</td><td align="center">sp &#x02223; P54697</td><td align="left"/><td align="left">68 (10<sup>&#x02212;10</sup>)</td><td align="char" char=".">&#x0003c;23</td><td align="char" char=".">&#x0003c;23</td></tr></tbody></table></table-wrap><table-wrap position="float" id="T4"><label>Table 4</label><caption><p>myo2<sup>ts</sup> Alleles</p></caption><table frame="hsides" rules="groups"><thead><tr valign="bottom"><th align="left" colspan="1" rowspan="2">Allele</th><th align="center" colspan="1" rowspan="2">Predicted amino acid changes</th><th align="center" colspan="3" ro