>Cry1Ab</td><td align="left" rowspan="1" colspan="1">Lepidoptera</td><td align="left" rowspan="1" colspan="1">corn pollen</td><td align="left" rowspan="1" colspan="1">not specified</td><td align="left" rowspan="1" colspan="1">larvae</td><td align="left" rowspan="1" colspan="1">1.5 mg GM maize pollen in 50&#x00025; sugar soln.</td><td align="left" rowspan="1" colspan="1">1.5 mg non-GM maize pollen in 50&#x00025; sugar soln.</td><td align="left" rowspan="1" colspan="1">larval mortality</td><td align="left" rowspan="1" colspan="1">5</td><td align="left" rowspan="1" colspan="1">5.50</td><td align="left" rowspan="1" colspan="1">3.74</td><td align="left" rowspan="1" colspan="1">1.969</td><td align="left" rowspan="1" colspan="1">3.446</td></tr><tr><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="pone.0001415-Hanley1">&#x0005b;22&#x0005d;</xref></td><td align="left" rowspan="1" colspan="1">yes</td><td align="left" rowspan="1" colspan="1">Cry1Ab</td><td align="left" rowspan="1" colspan="1">Lepidoptera</td><td align="left" rowspan="1" colspan="1">corn pollen</td><td align="left" rowspan="1" colspan="1">not specified</td><td align="left" rowspan="1" colspan="1">larvae</td><td align="left" rowspan="1" colspan="1">1.5 mg GM maize pollen in 50&#x00025; sugar soln.</td><td align="left" rowspan="1" colspan="1">1.5 mg non-GM maize pollen in 50&#x00025; sugar soln.</td><td align="left" rowspan="1" colspan="1">pupal mortality</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">2.87</td><td align="left" rowspan="1" colspan="1">2.87</td><td align="left" rowspan="1" colspan="1">3.861</td><td align="left" rowspan="1" colspan="1">1.103</td></tr><tr><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="pone.0001415-Hanley1">&#x0005b;22&#x0005d;</xref></td><td align="left" rowspan="1" colspan="1">yes</td><td align="left" rowspan="1" colspan="1">Cry1Ab</td><td align="left" rowspan="1" colspan="1">Lepidoptera</td><td alig