="pmid">2865329</pub-id></citation></ref><ref id="Romantschuketal1988"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Romantschuk</surname><given-names>M.</given-names></name><name><surname>Olkkonen</surname><given-names>V.M.</given-names></name><name><surname>Bamford</surname><given-names>D.H.</given-names></name></person-group><article-title>The nucleocapsid of bacteriophage &#x003c6;6 penetrates the host cytoplasmic membrane</article-title><source>EMBO (Eur. Mol. Biol. Organ.) J.</source><volume>7</volume><year>1988</year><fpage>1821</fpage><lpage>1829</lpage></citation></ref><ref id="Sambrooketal1989"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Sambrook</surname><given-names>J.</given-names></name><name><surname>Fritsch</surname><given-names>E.F.</given-names></name><name><surname>Maniatis</surname><given-names>T.</given-names></name></person-group><source>Molecular CloningA Laboratory Manual</source><year>1989</year><publisher-name>Cold Spring Harbor Laboratory</publisher-name><publisher-loc>Cold Spring Harbor, New York</publisher-loc></citation></ref><ref id="Semanciketal1973"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Semancik</surname><given-names>J.S.</given-names></name><name><surname>Vidaver</surname><given-names>A.K.</given-names></name><name><surname>Van Etten</surname><given-names>J.L.</given-names></name></person-group><article-title>Characterization of segmented double-helical RNA from bacteriophage &#x003c6;6</article-title><source>J. Mol. Biol</source><volume>78</volume><year>1973</year><fpage>617</fpage><lpage>625</lpage><pub-id pub-id-type="pmid">4357756</pub-id></citation></ref><ref id="Skulachev1992"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Skulachev</surname><given-names>V.P.</given-names></name></person-group><article-title>The laws of cell energetics</article-tit