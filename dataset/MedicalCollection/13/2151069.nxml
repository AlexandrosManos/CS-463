n-names>GA</given-names></name></person-group><article-title>The neural substrate of orientation short-term memory and resistance to distractor items</article-title><source>Eur J Neurosci</source><year>2002</year><volume>15</volume><fpage>165</fpage><lpage>175</lpage><pub-id pub-id-type="pmid">11860517</pub-id><pub-id pub-id-type="doi">10.1046/j.0953-816x.2001.01830.x</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Paulesu</surname><given-names>E</given-names></name><name><surname>Frith</surname><given-names>CD</given-names></name><name><surname>Frackowiak</surname><given-names>RSJ</given-names></name></person-group><article-title>The neural correlates of the verbal component of working memory</article-title><source>Nature</source><year>1993</year><volume>362</volume><fpage>342</fpage><lpage>345</lpage><pub-id pub-id-type="pmid">8455719</pub-id><pub-id pub-id-type="doi">10.1038/362342a0</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reinvang</surname><given-names>I</given-names></name><name><surname>Magnussen</surname><given-names>S</given-names></name><name><surname>Greenlee</surname><given-names>MW</given-names></name><name><surname>Larsson</surname><given-names>PG</given-names></name></person-group><article-title>Electrophysiological localization of brain areas involved in perceptual memory</article-title><source>Exp Brain Res</source><year>1998</year><volume>123</volume><fpage>481</fpage><lpage>484</lpage><pub-id pub-id-type="pmid">9870607</pub-id><pub-id pub-id-type="doi">10.1007/s002210050592</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Baumann</surname><given-names>O</given-names></name><name><surname>Frank</surname><given-names>G</given-names></name><name><surname>Rutschmann</surname><given-names>RM</given-names></n