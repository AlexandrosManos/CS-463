><given-names>TF</given-names></name><name><surname>Zelenock</surname><given-names>GB</given-names></name><name><surname>Whitehouse</surname><given-names>WM</given-names><suffix>Jr</suffix></name><name><surname>Lindenauer</surname><given-names>SM</given-names></name><name><surname>Graham</surname><given-names>LM</given-names></name></person-group><article-title>Actuarial analysis of variables associated with rupture of small abdominal aortic aneurysms</article-title><source>Surgery</source><year>1985</year><volume>98</volume><fpage>472</fpage><lpage>483</lpage><pub-id pub-id-type="pmid">3898453</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nicholls</surname><given-names>SC</given-names></name><name><surname>Gardner</surname><given-names>JB</given-names></name><name><surname>Meissner</surname><given-names>MH</given-names></name><name><surname>Johansen</surname><given-names>KH</given-names></name></person-group><article-title>Rupture in small abdominal aortic aneurysms</article-title><source>J Vasc Surg</source><year>1998</year><volume>28</volume><fpage>884</fpage><lpage>888</lpage><pub-id pub-id-type="pmid">9808857</pub-id><pub-id pub-id-type="doi">10.1016/S0741-5214(98)70065-5</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vande Geest</surname><given-names>JP</given-names></name><name><surname>Wang</surname><given-names>DHJ</given-names></name><name><surname>Wisniewski</surname><given-names>SR</given-names></name><name><surname>Makaroun</surname><given-names>MS</given-names></name><name><surname>Vorp</surname><given-names>DA</given-names></name></person-group><article-title>Towards a non-invasive method for determination of patient-specific wall strength distribution in abdominal aortic aneurysms</article-title><source>Ann Biomed Eng</source><year>2006</year><volume>34</volume><fpage>1098</fpage><lpage>1