-type="pmid">15995192</pub-id></citation></ref><ref id="b41"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simm</surname><given-names>R</given-names></name></person-group><article-title>GGDEF and EAL domains inversely regulate cyclic di-GMP levels and transition from sessility to motility</article-title><source>Mol Microbiol</source><year>2004</year><volume>53</volume><fpage>1123</fpage><lpage>1134</lpage><pub-id pub-id-type="pmid">15306016</pub-id></citation></ref><ref id="b42"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simm</surname><given-names>R</given-names></name></person-group><article-title>Phenotypic convergence mediated by GGDEF-domain-containing proteins</article-title><source>J Bacteriol</source><year>2005</year><volume>187</volume><fpage>6816</fpage><lpage>6823</lpage><pub-id pub-id-type="pmid">16166544</pub-id></citation></ref><ref id="b43"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Spiers</surname><given-names>AJ</given-names></name></person-group><article-title>Biofilm formation at the air-liquid interface by the <italic>Pseudomonas fluorescens</italic> SBW25 wrinkly spreader requires an acetylated form of cellulose</article-title><source>Mol Microbiol</source><year>2003</year><volume>50</volume><fpage>15</fpage><lpage>27</lpage><pub-id pub-id-type="pmid">14507360</pub-id></citation></ref><ref id="b44"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tamayo</surname><given-names>R</given-names></name></person-group><article-title>The EAL domain protein VieA is a cyclic diguanylate phosphodiesterase</article-title><source>J Biol Chem</source><year>2005</year><volume>280</volume><fpage>33324</fpage><lpage>33330</lpage><pub-id pub-id-type="pmid">16081414</pub-id></citation></ref><ref id="b45"><citation citation-type="journal"><person-group person-group-type="author"><name><surn