ume><fpage>701</fpage><lpage>715</lpage><pub-id pub-id-type="pmid">11547892</pub-id><pub-id pub-id-type="doi">10.2165/00007256-200131100-00001</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maughan</surname><given-names>RJ</given-names></name></person-group><article-title>Fluid and electrolyte loss and replacement in exercise.</article-title><source>J Sports Sci</source><year>1991</year><volume>9 Spec No</volume><fpage>117</fpage><lpage>142</lpage><pub-id pub-id-type="pmid">1895359</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burke</surname><given-names>LM</given-names></name><name><surname>Hawley</surname><given-names>JA</given-names></name></person-group><article-title>Carbohydrate and exercise.</article-title><source>Curr Opin Clin Nutr Metab Care</source><year>1999</year><volume>2</volume><fpage>515</fpage><lpage>520</lpage><pub-id pub-id-type="pmid">10678682</pub-id><pub-id pub-id-type="doi">10.1097/00075197-199911000-00015</pub-id></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Laursen</surname><given-names>PB</given-names></name><name><surname>Rhodes</surname><given-names>EC</given-names></name></person-group><article-title>Factors affecting performance in an ultraendurance triathlon.</article-title><source>Sports Med</source><year>2001</year><volume>31</volume><fpage>195</fpage><lpage>209</lpage><pub-id pub-id-type="pmid">11286356</pub-id><pub-id pub-id-type="doi">10.2165/00007256-200131030-00004</pub-id></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kimber</surname><given-names>NE</given-names></name><name><surname>Ross</surname><given-names>JJ</given-names></name><name><surname>Mason</surname><given-names>SL</given-names></name><name><surname>Speedy</surname><given-names>DB</given-names></name></person-group><article-title>Energy balance during an ironman triathlon in male and female triathletes.</article-title><source>Int J Sport Nutr Exerc Metab</source><year>2002</year><volume>12</volume><fpage>47</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">11993622</pub-id></citation></ref></ref-list></back></article>