-id pub-id-type="pmid">2693020</pub-id></citation></ref><ref id="Grindstaffetal1998"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grindstaff</surname><given-names>K.K.</given-names></name><name><surname>Bacallao</surname><given-names>R.L.</given-names></name><name><surname>Nelson</surname><given-names>W.J.</given-names></name></person-group><article-title>Apiconuclear organization of microtubules does not specify protein delivery from the trans-Golgi network to different membrane domains in polarized epithelial cells</article-title><source>Mol. Biol. Cell.</source><volume>9</volume><year>1998</year><fpage>685</fpage><lpage>699</lpage><pub-id pub-id-type="pmid">9487135</pub-id></citation></ref><ref id="Kinosianetal1993"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kinosian</surname><given-names>H.J.</given-names></name><name><surname>Selden</surname><given-names>L.A.</given-names></name><name><surname>Estes</surname><given-names>J.E.</given-names></name><name><surname>Gershman</surname><given-names>L.C.</given-names></name></person-group><article-title>Actin filament annealing in the presence of ATP and phalloidin</article-title><source>Biochemistry.</source><volume>32</volume><year>1993</year><fpage>12353</fpage><lpage>12357</lpage><pub-id pub-id-type="pmid">8241122</pub-id></citation></ref><ref id="Laemmli1970"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Laemmli</surname><given-names>U.K.</given-names></name></person-group><article-title>Cleavage of structural proteins during the assembly of bacteriophage T4</article-title><source>Nature.</source><volume>227</volume><year>1970</year><fpage>680</fpage><lpage>685</lpage><pub-id pub-id-type="pmid">5432063</pub-id></citation></ref><ref id="Lafontetal1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lafont</surname><given-names>F.</given-nam