<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Br J Cancer</journal-id><journal-title>British Journal of Cancer</journal-title><issn pub-type="ppub">0007-0920</issn><issn pub-type="epub">1532-1827</issn></journal-meta><article-meta><article-id pub-id-type="pmid">9667666</article-id><article-id pub-id-type="pmc">2150316</article-id><article-id pub-id-type="pmid">9667666</article-id><article-categories><subj-group subj-group-type="heading"><subject>Experimental Oncology</subject></subj-group></article-categories><title-group><article-title>Do mast cells help to induce angiogenesis in B-cell non-Hodgkin's lymphomas?</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Ribatti</surname><given-names>D</given-names></name></contrib><contrib contrib-type="author"><name><surname>Nico</surname><given-names>B</given-names></name></contrib><contrib contrib-type="author"><name><surname>Vacca</surname><given-names>A</given-names></name></contrib><contrib contrib-type="author"><name><surname>Marzullo</surname><given-names>A</given-names></name></contrib><contrib contrib-type="author"><name><surname>Calvi</surname><given-names>N</given-names></name></contrib><contrib contrib-type="author"><name><surname>Roncali</surname><given-names>L</given-names></name></contrib><contrib contrib-type="author"><name><surname>Dammacco</surname><given-names>F</given-names></name></contrib></contrib-group><pub-date pub-type="ppub"><month>06</month><year>1998</year></pub-date><volume>77</volume><issue>11</issue><fpage>1900</fpage><lpage>1906</lpage><abstract><p>Morphological and morphometric data showing a higher number of mast cells (MCs) in the stroma of B-cell non-Hodgkin's lymphomas (B-NHL) than in benign lymphadenopathies are presented in support of the suggestion that angiogenesis during the progression of B-NHL may be partly mediated by angiogenic factors in their secretory granules.</p><sec sec-type="scanned-figures"><title>Images</title><fig id="F1"><label>Figure 1</label><graphic xlink:href="brjcancer00087-0194-a" xlink:role="1902"/></fig><fig id="F2"><label>Figure 3</label><graphic xlink:href="brjcancer00087-0196-a" xlink:role="1904"/></fig></sec></abstract><kwd-group><kwd>angiogenesis</kwd><kwd>mast cell</kwd><kwd>B-cell non-Hodgkin's lymphoma</kwd><kwd>tumour progression</kwd></kwd-group></article-meta></front><body><supplementary-material content-type="scanned-pages"><graphic xlink:href="brjcancer00087-0192.tif" xlink:title="scanned-page" xlink:role="1900" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="brjcancer00087-0193.tif" xlink:title="scanned-page" xlink:role="1901" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="brjcancer00087-0194.tif" xlink:title="scanned-page" xlink:role="1902" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="brjcancer00087-0195.tif" xlink:title="scanned-page" xlink:role="1903" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="brjcancer00087-0196.tif" xlink:title="scanned-page" xlink:role="1904" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="brjcancer00087-0197.tif" xlink:title="scanned-page" xlink:role="1905" mimetype="image" mime-subtype="tiff"/><graphic xlink:href="brjcancer00087-0198.tif" xlink:title="scanned-page" xlink:role="1906" mimetype="image" mime-subtype="tiff"/></supplementary-material></body></article>