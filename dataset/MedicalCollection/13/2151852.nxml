1987</year><volume>40</volume><fpage>373</fpage><lpage>383</lpage><pub-id pub-id-type="pmid">3558716</pub-id><pub-id pub-id-type="doi">10.1016/0021-9681(87)90171-8</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Knaus</surname><given-names>WA</given-names></name><name><surname>Draper</surname><given-names>EA</given-names></name><name><surname>Wagner</surname><given-names>DP</given-names></name><name><surname>Zimmerman</surname><given-names>JE</given-names></name></person-group><article-title>APACHE II: a severity of disease classification system</article-title><source>Crit Care Med</source><year>1985</year><volume>13</volume><fpage>818</fpage><lpage>829</lpage><pub-id pub-id-type="pmid">3928249</pub-id><pub-id pub-id-type="doi">10.1097/00003246-198510000-00009</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>El Solh</surname><given-names>A</given-names></name></person-group><article-title>Clinical approach to the critically ill morbidly obese patient</article-title><source>Am J Respir Crit Care Med</source><year>2004</year><volume>169</volume><fpage>557</fpage><lpage>561</lpage><pub-id pub-id-type="pmid">14982823</pub-id><pub-id pub-id-type="doi">10.1164/rccm.200309-1256CC</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rubinstein</surname><given-names>I</given-names></name><name><surname>Bradley</surname><given-names>T</given-names></name><name><surname>Zamel</surname><given-names>N</given-names></name><name><surname>Hoffstein</surname><given-names>V</given-names></name></person-group><article-title>Glottic and cervical tracheal narrowing in patients with obstructive sleep apnea</article-title><source>J Appl Physiol</source><year>1989</year><volume>67</volume><fpage>2427</fpage><lpage>2431</lpage><pub-id pub-id-type="pmid">2606850</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simmons</surname><given-names>B</given-names></name></person-group><article-title>Tracheotomy in sleep apnea syndrome</article-title><source>Ear Nose Throat J</source><year>1984</year><volume>63</volume><fpage>222</fpage><lpage>226</lpage><pub-id pub-id-type="pmid">6734481</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ghorayeb</surname><given-names>B</given-names></name></person-group><article-title>Tracheotomy in the morbidly obese patient</article-title><source>Arch Otolaryngol Head Neck Surg</source><year>1987</year><volume>113</volume><fpage>556</fpage><lpage>558</lpage><pub-id pub-id-type="pmid">3566935</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Price</surname><given-names>D</given-names></name></person-group><article-title>Techniques of tracheostomy for intensive care unit patients</article-title><source>Anaesthesia</source><year>1983</year><volume>38</volume><fpage>902</fpage><lpage>904</lpage><pub-id pub-id-type="pmid">6625141</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Greisz</surname><given-names>H</given-names></name></person-group><article-title>Techniques of tracheostomy for intensive care patients</article-title><source>Anaesthesia</source><year>1984</year><volume>39</volume><fpage>295</fpage><lpage>296</lpage><pub-id pub-id-type="pmid">6703309</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Orringer</surname><given-names>M</given-names></name></person-group><article-title>Endotracheal intubation and tracheostomy. Indications, techniques, and complications</article-title><source>Surg Clin North Am</source><year>1980</year><volume>60</volume><fpage>1447</fpage><lpage>1464</lpage><pub-id pub-id-type="pmid">7455873</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tommerup</surname><given-names>B</given-names></name><name><surname>Borgeskov</surname><given-names>S</given-names></name></person-group><article-title>Endoscopic evaluation at follow-up after Bjork tracheostoma</article-title><source>Scand J Thorac Cardiovasc Surg</source><year>1983</year><volume>17</volume><fpage>181</fpage><lpage>184</lpage><pub-id pub-id-type="pmid">6612260</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gross</surname><given-names>ND</given-names></name><name><surname>Cohen</surname><given-names>JI</given-names></name><name><surname>Andersen</surname><given-names>PE</given-names></name><name><surname>Wax</surname><given-names>MK</given-names></name></person-group><article-title>'Defatting' tracheotomy in morbidly obese patients</article-title><source>Laryngoscope</source><year>2002</year><volume>112</volume><issue>11</issue><fpage>1940</fpage><lpage>1944</lpage><pub-id pub-id-type="pmid">12439159</pub-id><pub-id pub-id-type="doi">10.1097/00005537-200211000-00006</pub-id></citation></ref></ref-list></back></article>