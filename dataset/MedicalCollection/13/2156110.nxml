on-group-type="author"><name><surname>Shirai</surname><given-names>Y</given-names></name></person-group><article-title>Distinct effect of fatty acids on translocation of r- and e-subspecies of protein kinase C</article-title><source>J. Cell Biol.</source><year>1998</year><volume>143</volume><fpage>511</fpage><lpage>521</lpage><pub-id pub-id-type="pmid">9786959</pub-id></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tanaka</surname><given-names>C</given-names></name></person-group><article-title>The protein kinase C family for neuronal signaling</article-title><source>Annu. Rev. Neurosci.</source><year>1994</year><volume>17</volume><fpage>551</fpage><lpage>567</lpage><pub-id pub-id-type="pmid">8210187</pub-id></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Toker</surname><given-names>A</given-names></name></person-group><article-title>The synthesis and cellular roles of phosphatidylinositol 4,5-bisphosphate</article-title><source>Curr. Opin. Cell Biol.</source><year>1998</year><volume>10</volume><fpage>254</fpage><lpage>261</lpage><pub-id pub-id-type="pmid">9561850</pub-id></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Toker</surname><given-names>A</given-names></name></person-group><article-title>Activation of protein kinase C family members by the novel polyphosphoinositides PtdINs-3,4P<sub>2</sub> and PtdINs-3,4,5P<sub>3</sub></article-title><source>J. Biol. Chem.</source><year>1994</year><volume>269</volume><fpage>32358</fpage><lpage>32367</lpage><pub-id pub-id-type="pmid">7798235</pub-id></citation></ref><ref id="b25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Troll&#x000e9;r</surname><given-names>U</given-names></name></person-group><article-title>A possible role for p190 RhoGAP in PKC&#x0025b;-indu