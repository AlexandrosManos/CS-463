<person-group person-group-type="author"><name><surname>Blume-Jensen</surname><given-names>P.</given-names></name><name><surname>Janknecht</surname><given-names>R.</given-names></name><name><surname>Hunter</surname><given-names>T.</given-names></name></person-group><article-title>The kit receptor promotes cell survival via activation of PI 3-kinase and subsequent Akt-mediated phosphorylation of Bad on Ser136</article-title><source>Curr. Biol.</source><volume>8</volume><year>1998</year><fpage>779</fpage><lpage>782</lpage><pub-id pub-id-type="pmid">9651683</pub-id></citation></ref><ref id="BorradoriandSonnenberg1996"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Borradori</surname><given-names>L.</given-names></name><name><surname>Sonnenberg</surname><given-names>A.</given-names></name></person-group><article-title>Hemidesmosomesroles in adhesion, signaling and human diseases</article-title><source>Curr. Opin. Cell Biol.</source><volume>8</volume><year>1996</year><fpage>647</fpage><lpage>656</lpage><pub-id pub-id-type="pmid">8939649</pub-id></citation></ref><ref id="Boudreauetal1995"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boudreau</surname><given-names>N.</given-names></name><name><surname>Sympson</surname><given-names>C.J.</given-names></name><name><surname>Werb</surname><given-names>Z.</given-names></name><name><surname>Bissell</surname><given-names>M.J.</given-names></name></person-group><article-title>Suppression of ICE and apoptosis in mammary epithelial cells by extracellular matrix</article-title><source>Science.</source><volume>267</volume><year>1995</year><fpage>891</fpage><lpage>893</lpage><pub-id pub-id-type="pmid">7531366</pub-id></citation></ref><ref id="Cardoneetal1998"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cardone</surname><given-names>M.H.</given-names></name><name><surname>Roy</surname><given-names>N.</give