itation></ref><ref id="bib15"><citation citation-type="journal">Hallak, H., L. Muszbek, M. Laposata, E. Belmonte, L.F. Brass, and D.R. Manning. <year>1994</year>. Covalent binding of arachidonate to G protein &#x003b1; subunits of human platelets. <source>J. Biol. Chem.</source> <volume>269</volume>:<fpage>4713</fpage>&#x02013;4716.<pub-id pub-id-type="pmid">8106438</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal">Hamm, H.E. <year>1998</year>. The many faces of G protein signaling. <source>J. Biol. Chem.</source> <volume>273</volume>:<fpage>669</fpage>&#x02013;672.<pub-id pub-id-type="pmid">9422713</pub-id></citation></ref><ref id="bib17"><citation citation-type="other">Hammerschmidt, M., and M.C. Mullins. 2002. Dorsoventral patterning in the zebrafish: Bone morphogenetic proteins and beyond. Pattern Formation in Zebrafish. L. Solnica-Krezel, editor. Springer-Verlag, Berlin Heidelberg. 72&#x02013;95.</citation></ref><ref id="bib18"><citation citation-type="journal">Heisenberg, C.P., M. Tada, G.J. Rauch, L. Saude, M.L. Concha, R. Geisler, D.L. Stemple, J.C. Smith, and S.W. Wilson. <year>2000</year>. <italic>Silberblick/Wnt11</italic> mediates convergent extension movements during zebrafish gastrulation. <source>Nature.</source> <volume>405</volume>:<fpage>76</fpage>&#x02013;81.<pub-id pub-id-type="pmid">10811221</pub-id></citation></ref><ref id="bib19"><citation citation-type="journal">Jessen, J.R., J. Topczewski, S. Bingham, D.S. Sepich, F. Marlow, A. Chandrasekhar, and L. Solnica-Krezel. <year>2002</year>. Zebrafish <italic>trilobite</italic> identifies new roles for Strabismus in gastrulation and neuronal movements. <source>Nat. Cell Biol.</source> <volume>4</volume>:<fpage>610</fpage>&#x02013;615.<pub-id pub-id-type="pmid">12105418</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal">Katanaev, V.L., R. Ponzielli, M. Semeriva, and A. Tomlinson. <year>2005</year>. Trimeric G protein-dependent Frizzled signaling in <italic>Drosophila</italic>. <source>Cell.</source> <volume>120</volume>:<fpage>111</fpage>&#x02013;122.<pub-id pub-id-type="pmid">15652486</pub-id></citation></ref><ref id="bib21"><citation citation-type="journal">Katoh, H., J. Aoki, Y. Yamaguchi, Y. Kitano, A. Ichikawa, and M. Negishi. <year>1998</year>. Constitutively active G&#x003b1;<sub>12</sub>, G&#x003b1;<sub>13</sub> and G&#x003b1;<sub>q</sub> induce Rho-dependent neurite retraction through different signaling pathways. <source>J. Biol. Chem.</source> <volume>273</volume>:<fpage>28700</fpage>&#x02013;28707.<pub-id pub-id-type="pmid">9786865</pub-id></citation></ref><ref id="bib22"><citation citation-type="journal">Keller, R. <year>2002</year>. Shaping the vertebrate body plan by polarized embryonic cell movements. <source>Science.</source> <volume>298</volume>:<fpage>1950</fpage>&#x02013;1954.<pub-id pub-id-type="pmid">12471247</pub-id></citation></ref><ref id="bib23"><citation citation-type="journal">Kimmel, C.B., W.W. Ballard, S.R. Kimmel, B. Ullmann, and T.F. Schilling. <year>1995</year>. Stages of embryonic development of the zebrafish. <source>Dev. Dyn.</source> <volume>203</volume>:<fpage>253</fpage>&#x02013;310.<pub-id pub-id-type="pmid">8589427</pub-id></citation></ref><ref id="bib24"><citation citation-type="journal">Kinoshita, N., H. Iioka, A. Miyakoshi, and N. Ueno. <year>2003</year>. PKC&#x003b4; is essential for Dishevelled function in a noncanonical Wnt pathway that regulates <italic>Xenopus</italic> convergent extension movements. <source>Genes Dev.</source> <volume>17</volume>:<fpage>1663</fpage>&#x02013;1676.<pub-id pub-id-type="pmid">12842914</pub-id></citation></ref><ref id="bib25"><citation citation-type="journal">Kuhl, M., K. Geis, L.C. Sheldahl, T. Pukrop, R.T. Moon, and D. Wedlich. <year>2001</year>. Antagonistic regulation of convergent extension movements in <italic>Xenopus</italic> by Wnt/&#x003b2;-catenin and Wnt/Ca<sup>2+</sup> signaling. <source>Mech. Dev.</source> <volume>106</volume>:<fpage>61</fpage>&#x02013;76.<pub-id pub-id-type="pmid">11472835</pub-id></citation></ref><ref id="bib26"><citation citation-type="journal">Lee, Y.N., C.C. Malbon, and H.Y. Wang. <year>2004</year>. G&#x003b1;<sub>13</sub> signals via p115RhoGEF cascades regulating JNK1 and primitive endoderm formation. <source>J. Biol. Chem.</source> <volume>279</volume>:<fpage>54896</fpage>&#x02013;54904.<pub-id pub-id-type="pmid">15492006</pub-id></citation></ref><ref id="bib27"><citation citation-type="journal">Liu, T., A.J. DeCostanzo, X. Liu, H. Wang, S. Hallagan, R.T. Moon, and C.C. Malbon. <year>2001</year>. G protein signaling from activated rat Frizzled-1 to the &#x003b2;-catenin-Lef-Tcf pathway. <source>Science.</source> <volume>292</volume>:<fpage>1718</fpage>&#x02013;1722.<pub-id pub-id-type="pmid">11387477</pub-id></citation></ref><ref id="bib28"><citation citation-type="journal">Liu, X., T. Liu, D.C. Slusarski, J. Yang-Snyder, C.C. Malbon, R.T. Moon, and H. Wang. <year>1999</year>. Activation of a Frizzled-2/&#x003b2;-adrenergic receptor chimera promotes Wnt signaling and differentiation of mouse F9 teratocarcinoma cells via G&#x003b1;<sub>13</sub> and G&#x003b1;<sub>t</sub>. <source>Proc. Natl. Acad. Sci. USA.</source> <volume>96</volume>:<fpage>14383</fpage>&#x02013;14388.<pub-id pub-id-type="pmid">10588714</pub-id></citation></ref><ref id="bib29"><citation citation-type="journal">Malbon, C.C., H. Wang, and R.T. Moon. <year>2001</year>. Wnt signaling and heterotrimeric G-proteins: strange bedfellows or a classic romance? <source>Biochem. Biophys. Res. Commun.</source> <volume>287</volume>:<fpage>589</fpage>&#x02013;593.<pub-id pub-id-type="pmid">11563835</pub-id></citation></ref><ref id="bib30"><citation citation-type="journal">Marlow, F., J. Topczewski, D. Sepich, and L. Solnica-Krezel. <year>2002</year>. Zebrafish Rho kinase 2 acts downstream of <italic>Wnt11</italic> to mediate cell polarity and effective convergence and extension movements. <source>Curr. Bio