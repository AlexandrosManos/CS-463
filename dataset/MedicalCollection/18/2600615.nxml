="journal"><person-group person-group-type="author"><name><surname>Gall</surname><given-names>JG</given-names></name></person-group><year>2001</year><article-title>A role for Cajal bodies in assembly of the nuclear transcription machinery.</article-title><source>FEBS Lett</source><volume>498</volume><fpage>164</fpage><lpage>167</lpage><pub-id pub-id-type="pmid">11412849</pub-id></citation></ref><ref id="pone.0003989-Gall3"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gall</surname><given-names>JG</given-names></name></person-group><year>2003</year><article-title>The centennial of the Cajal body.</article-title><source>Nat Rev Mol Cell Biol</source><volume>4</volume><fpage>975</fpage><lpage>980</lpage><pub-id pub-id-type="pmid">14685175</pub-id></citation></ref><ref id="pone.0003989-Matera1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matera</surname><given-names>AG</given-names></name><name><surname>Shpargel</surname><given-names>KB</given-names></name></person-group><year>2006</year><article-title>Pumping RNA: nuclear bodybuilding along the RNP pipeline.</article-title><source>Curr Opin Cell Biol</source><volume>18</volume><fpage>317</fpage><lpage>324</lpage><pub-id pub-id-type="pmid">16632338</pub-id></citation></ref><ref id="pone.0003989-Paushkin1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Paushkin</surname><given-names>S</given-names></name><name><surname>Gubitz</surname><given-names>AK</given-names></name><name><surname>Massenet</surname><given-names>S</given-names></name><name><surname>Dreyfuss</surname><given-names>G</given-names></name></person-group><year>2002</year><article-title>The SMN complex, an assemblyosome of ribonucleoproteins.</article-title><source>Curr Opin Cell Biol</source><volume>14</volume><fpage>305</fpage><lpage>312</lpage><pub-id pub-id-type="pmid">12067652</pub-id></citation></ref><ref id="pone.0003989-Gubitz1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gubitz</surname><given-names>AK</given-names></name><name><surname>Feng</surname><given-names>W</given-names></name><name><surname>Dreyfuss</surname><given-names>G</given-names></name></person-group><year>2004</year><article-title>The SMN complex.</article-title><source>Exp Cell Res</source><volume>296</volume><fpage>51</fpage><lpage>56</lpage><pub-id pub-id-type="pmid">15120993</pub-id></citation></ref><ref id="pone.0003989-Will1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Will</surname><given-names>CL</given-names></name><name><surname>L&#x000fc;hrmann</surname><given-names>R</given-names></name></person-group><year>2001</year><article-title>Spliceosomal UsnRNP biogenesis, structure and function.</article-title><source>Curr Opin Cell Biol</source><volume>13</volume><fpage>290</fpage><lpage>310</lpage><pub-id pub-id-type="pmid">11343899</pub-id></citation></ref><ref id="pone.0003989-Jantsch1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jantsch</surname><given-names>MF</given-names></name><name><surname>Gal</surname><given-names>JG</given-names></name></person-group><year>1992</year><article-title>Assembly and localisation of the U1-specific snRNP C protein in the amphibian oocyte.</article-title><source>J Cell Biol</source><volume>119</volume><fpage>1037</fpage><lpage>1046</lpage><pub-id pub-id-type="pmid">1447287</pub-id></citation></ref><ref id="pone.0003989-Kambach1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kambach</surname><given-names>C</given-names></name><name><surname>Mattaj</surname><given-names>IW</given-names></name></person-group><year>1992</year><article-title>Intracellular distribution of the U1A protein depends on active transport and nuclear binding to U1 snRNA.</article-title><source>J Cell Biol</source><volume>118</volume><fpage>11</fpage><lpage>21</lpage><pub-id pub-id-type="pmid">1618898</pub-id></citation></ref><ref id="pone.0003989-Kambach2"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kambach</surname><given-names>C</given-names></name><name><surname>Mattaj</surname><given-names>IW</given-names></name></person-group><year>1994</year><article-title>Nuclear transport of the U2 snRNP-specific U2B&#x02033; protein is mediated by both direct and indirect signalling mechanisms.</article-title><source>J Cell Sci</source><volume>107</volume><fpage>1807</fpage><lpage>1816</lpage><pub-id pub-id-type="pmid">7983149</pub-id></citation></ref><ref id="pone.0003989-Romac1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Romac</surname><given-names>JM</given-names></name><name><surname>Graff</surname><given-names>DH</given-names></name><name><surname>Keene</surname><given-names>JD</given-names></name></person-group><year>1993</year><article-title>The U1 small nuclear ribonucleoprotein (snRNP) 70K protein is transported independently of U1 snRNP particles via a nuclear localization signal in the RNA-binding domain.</article-title><source>Mol Cell Biol</source><volume>14</volume><fpage>4662</fpage><lpage>4670</lpage><pub-id pub-id-type="pmid">7516470</pub-id></citation></ref><ref id="pone.0003989-Hetzer1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hetzer</surname><given-names>M</given-names></name><name><surname>Mattaj</surname><given-names>IW</given-names></name></person-group><year>2000</year><article-title>An ATP-dependent, ran-independent mechanism for nuclear import of the U1A and U2B&#x02033; spliceosomal proteins.</article-title><source>J Cell Biol</source><volume>148</volume><