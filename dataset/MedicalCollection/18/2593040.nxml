rname><given-names>K</given-names></name><name><surname>Yamamoto</surname><given-names>T</given-names></name><name><surname>Osaki</surname><given-names>T</given-names></name></person-group><article-title>Increase of Candida cell virulence by anticancer drugs and irradiation</article-title><source>Oral Microbiol Immunol</source><year>2001</year><volume>16</volume><fpage>243</fpage><lpage>249</lpage><pub-id pub-id-type="pmid">11442850</pub-id></citation></ref><ref id="R7"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jabra-Rizk</surname><given-names>MA</given-names></name><name><surname>Falkler</surname><given-names>WA</given-names></name><name><surname>Meiller</surname><given-names>TF</given-names></name></person-group><article-title>Fungal Biofilms and Drug Resistance</article-title><source>Emerg Infect Diseases</source><year>2004</year><volume>10</volume><fpage>14</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">15078591</pub-id></citation></ref><ref id="R8"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ramage</surname><given-names>G</given-names></name><name><surname>Saville</surname><given-names>SP</given-names></name><name><surname>Wickes</surname><given-names>BL</given-names></name><name><surname>Lopez-Ribot</surname><given-names>JL</given-names></name></person-group><article-title>Inhibition of Candida albicans biofilm formation by farnesol, a quorum-sensing molecule</article-title><source>Appl Environ Microbiol</source><year>2002</year><volume>68</volume><fpage>5459</fpage><lpage>5463</lpage><pub-id pub-id-type="pmid">12406738</pub-id></citation></ref><ref id="R9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>H</given-names></name><name><surname>Fujita</surname><given-names>M</given-names></name><name><surname>Feng</surname><given-names>Q</given-names></name><name><surname>Clardy</surname><given-names>J</given-names></name><name><surname>Fink</surname><given-names>GR</given-names></name></person-group><article-title>Tyrosol is a quorum-sensing molecule in Candida albicans</article-title><source>Proc Natl Acad Sci USA</source><year>2004</year><volume>101</volume><fpage>5048</fpage><lpage>5052</lpage><pub-id pub-id-type="pmid">15051880</pub-id></citation></ref><ref id="R10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kerr</surname><given-names>JR</given-names></name></person-group><article-title>Suppression of fungal growth exhibited by Pseudomonas aeruginosa</article-title><source>J Clin Microbiol</source><year>1994</year><volume>32</volume><fpage>525</fpage><lpage>527</lpage><pub-id pub-id-type="pmid">8150966</pub-id></citation></ref><ref id="R11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rossi</surname><given-names>L</given-names></name><name><surname>Boccardo</surname><given-names>F</given-names></name><name><surname>Corv&#x000f2;</surname><given-names>R</given-names></name></person-group><article-title>Endothelial cells increase theradiosensitivity of oropharyngeal squamous carcinoma cells in collagen gel</article-title><source>Oral Oncol</source><year>2004</year><volume>40</volume><fpage>214</fpage><lpage>222</lpage><pub-id pub-id-type="pmid">14693247</pub-id></citation></ref><ref id="R12"><label>12</label><citation citation-type="book"><collab> NCCLS</collab><article-title>National Committee for Clinical Laboratory Standards. Reference method for broth dilution antifungal susceptibility testing of yeast</article-title><source>2nd Edition: Approved standard M27-A2</source><year>2006</year><publisher-loc>USA</publisher-loc><publisher-name>Wayne PA</publisher-name></citation></ref><ref id="R13"><label>13</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Miller</surname><given-names>JH</given-names></name></person-group><article-title>Experiments in molecular genetics</article-title><source>Cold Spring harbor Labortory</source><year>1972</year><publisher-loc>New York USA </publisher-loc><fpage>31</fpage><lpage>36</lpage></citation></ref><ref id="R14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blankenship</surname><given-names>JR</given-names></name><name><surname>Mitchell</surname><given-names>AP</given-names></name></person-group><article-title>How to build a biofilm a fungal perspective</article-title><source>Curr Opin Microbiol</source><year>2006</year><volume>9</volume><fpage>588</fpage><lpage>94</lpage><pub-id pub-id-type="pmid">17055772</pub-id></citation></ref><ref id="R15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Baillie</surname><given-names>GS</given-names></name><name><surname>Douglas</surname><given-names>LJ</given-names></name></person-group><article-title>Matrix polymers of Candida biofilms and their possible role in biofilm resistance to antifungal agents</article-title><source>J Antimicrob Chemother</source><year>2000</year><volume>46</volume><fpage>397</fpage><lpage>403</lpage><pub-id pub-id-type="pmid">10980166</pub-id></citation></ref><ref id="R16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Alem</surname><given-names>MAS</given-names></name><name><surname>Oteef</surname><given-names>MDY</given-names></name><name><surname>Flowers</surname><given-names>TH</given-names></name><name><surname>Douglas</surname><given-names>LJ</given-names></name></person-group><article-title>Production of Tyrosol by Candida albicans Biofilms and Its Role in Quorum Sensing and Biofilm Development</article-title><source>Eukaryot Cell</source><year>2006</year><volume>5</volume><fpage>1770</fpage><lpage>9</lpage><pub-id pub