><given-names>J</given-names></name><name><surname>Pagliarello</surname><given-names>J</given-names></name></person-group><article-title>Risk factors for clinically important upper gastrointestinal bleeding in patients requiring mechanical ventilation</article-title><source>Crit Care Med</source><year>1999</year><volume>27</volume><fpage>2812</fpage><lpage>2817</lpage><pub-id pub-id-type="pmid">10628631</pub-id><pub-id pub-id-type="doi">10.1097/00003246-199912000-00034</pub-id></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Marshall</surname><given-names>JC</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Rombeau JL, Takala J</surname></name></person-group><article-title>Clinical markers of gastrointestinal dysfunction</article-title><source>Gut Dysfunction in Critical Illness</source><year>1996</year><publisher-name>Berlin: Springer-Verlag</publisher-name><fpage>114</fpage><lpage>128</lpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>An</surname><given-names>G</given-names></name><name><surname>West</surname><given-names>MA</given-names></name></person-group><article-title>Abdominal compartment syndrome: a concise clinical review</article-title><source>Crit Care Med</source><year>2008</year><volume>36</volume><fpage>1304</fpage><lpage>1310</lpage><pub-id pub-id-type="pmid">18379259</pub-id><pub-id pub-id-type="doi">10.1097/CCM.0b013e31816929f4</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reintam</surname><given-names>A</given-names></name><name><surname>Parm</surname><given-names>P</given-names></name><name><surname>Redlich</surname><given-names>U</given-names></name><name><surname>Tooding</surname><given-names>LM</given-names></name><name><surname>Starkopf</surname><given-names>J</given-names></name><name><surname>K&#x000f6;hler</surname><given-names>F</given-names></name><name><surname>Spies</surname><given-names>C</given-names></name><name><surname>Kern</surname><given-names>H</given-names></name></person-group><article-title>Gastrointestinal failure in intensive care: a retrospective clinical study in three different intensive care units in Germany and Estonia</article-title><source>BMC Gastroenterol</source><year>2006</year><volume>6</volume><fpage>19</fpage><pub-id pub-id-type="pmid">16792799</pub-id><pub-id pub-id-type="doi">10.1186/1471-230X-6-19</pub-id></citation></ref></ref-list></back></article>