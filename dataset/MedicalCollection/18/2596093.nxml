7.57.6.452</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>DR</given-names></name></person-group><article-title>A systematic review of tobacco smoking among nursing students</article-title><source>Nurse Education in Practice</source><year>2007</year><volume>7</volume><fpage>293</fpage><lpage>302</lpage><pub-id pub-id-type="pmid">17689456</pub-id><pub-id pub-id-type="doi">10.1016/j.nepr.2006.09.003</pub-id></citation></ref><ref id="B9"><citation citation-type="other"><person-group person-group-type="author"><collab>Anonymous</collab></person-group><article-title>Survey uncovers high levels of smoking among dental school students</article-title><source>Mainichi Daily News, August 20, 2007</source></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Curson</surname><given-names>I</given-names></name><name><surname>Manson</surname><given-names>JD</given-names></name></person-group><article-title>A study of a group of dental students, including their diet and dental health</article-title><source>British Dental Journal</source><year>1965</year><volume>119</volume><fpage>197</fpage><lpage>205</lpage><pub-id pub-id-type="pmid">4378451</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hussey</surname><given-names>DL</given-names></name><name><surname>Burnett</surname><given-names>AC</given-names></name><name><surname>Linden</surname><given-names>GJ</given-names></name></person-group><article-title>Characteristics of dental students in Ontario and Northern Ireland</article-title><source>Journal of the Irish Dental Association</source><year>1990</year><volume>36</volume><fpage>133</fpage><lpage>135</lpage><pub-id pub-id-type="pmid">2098446</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group p