me><surname>Dubois</surname><given-names>EL</given-names></name><name><surname>Tuffanelli</surname><given-names>DL</given-names></name></person-group><article-title>Clinical manifestation of SLE. Computer analysis of 520 cases</article-title><source>J Am Med Assoc</source><year>1964</year><volume>190</volume><fpage>4</fpage><lpage>11</lpage></element-citation></ref><ref id="CIT16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mark</surname><given-names>A</given-names></name><name><surname>Waldman</surname><given-names>J</given-names></name><name><surname>Callen</surname><given-names>P</given-names></name></person-group><article-title>Pyoderma gangrenosum preceding the diagnosis of SLE</article-title><source>Dermatology</source><year>2005</year><volume>210</volume><fpage>64</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15604550</pub-id></element-citation></ref><ref id="CIT17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Provost</surname><given-names>TT</given-names></name><name><surname>Zone</surname><given-names>J</given-names></name></person-group><article-title>Unusual cutaneous manifestation of SLE</article-title><source>Investig Dermatol</source><year>1980</year><volume>75</volume><fpage>495</fpage><lpage>9</lpage></element-citation></ref><ref id="CIT18"><label>18</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Dubois</surname><given-names>EL</given-names></name></person-group><article-title>Clinical picture of systemic lupus erythematosus</article-title><source>Lupus erythematosus</source><year>1974</year><publisher-loc>Los Angeles</publisher-loc><publisher-name>University of Southern California Press</publisher-name><fpage>294</fpage><lpage>5</lpage></element-citation></ref><ref id="CIT19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Vassileva</surname><given-names>S</given-names></name></person-group><article-title>Bullous SLE</article-title><source>Clin Dermatol</source><year>2003</year><volume>22</volume><fpage>129</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">15234014</pub-id></element-citation></ref><ref id="CIT20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Akrekar</surname><given-names>SM</given-names></name><name><surname>Bichile</surname><given-names>LS</given-names></name></person-group><article-title>cutaneous vasculitis in lupus: A turning point in the history of the disease? A case report and review of literature</article-title><source>J India Rheumatol Assoc</source><year>2005</year><volume>13</volume><fpage>29</fpage><lpage>31</lpage></element-citation></ref><ref id="CIT21"><label>21</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Malcangi</surname><given-names>G</given-names></name><name><surname>Brandozzi</surname><given-names>G</given-names></name><name><surname>Giangiacomi</surname><given-names>M</given-names></name><name><surname>Zampetti</surname><given-names>M</given-names></name><name><surname>Danieli</surname><given-names>MG</given-names></name></person-group><article-title>Bullous SLE: Response to methrotreate and relationship with disease activity</article-title><source>Lupus</source><year>2003</year><volume>12</volume><fpage>63</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">12587829</pub-id></element-citation></ref><ref id="CIT22"><label>22</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ng</surname><given-names>YY</given-names></name><name><surname>Chang</surname><given-names>IT</given-names></name><name><surname>Chen</surname><given-names>TW</given-names></name><name><surname>Liou</surname><given-names>HN</given-names></name><name><surname>Yang</surname><given-names>AH</given-names></name><name><surname>Yang</surname><given-names>WC</given-names></name></person-group><article-title>Concomitten lupus nephritis and bullous eruption in SLE</article-title><source>Nephrol Dial Transplant</source><year>1999</year><volume>4</volume><fpage>1739</fpage><lpage>43</lpage><pub-id pub-id-type="pmid">10435885</pub-id></element-citation></ref><ref id="CIT23"><label>23</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Zeevi</surname><given-names>R</given-names></name><name><surname>Vojvodi</surname><given-names>D</given-names></name></person-group><article-title>Skin lesion: An indicator of disease activity in SLE?</article-title><source>Lupus</source><year>2001</year><volume>10</volume><fpage>364</fpage><lpage>657</lpage><pub-id pub-id-type="pmid">11403268</pub-id></element-citation></ref></ref-list></back></article>