rson-group><article-title>Alcohol availability, alcohol consumption and alcohol related damage-The distribution of consumption model</article-title><source>J Stud Alcohol</source><year>1986</year><volume>47</volume><fpage>1</fpage><lpage>10</lpage><pub-id pub-id-type="pmid">3485738</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maynard</surname><given-names>A</given-names></name><name><surname>Godfrey</surname><given-names>C</given-names></name></person-group><article-title>Alcohol policy&#x02013;evaluating the options</article-title><source>Br Med Bull</source><year>1994</year><volume>50</volume><fpage>221</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">8149197</pub-id></citation></ref><ref id="B9"><citation citation-type="other"><article-title>The Licensing Act</article-title><year>2003</year><ext-link ext-link-type="uri" xlink:href="http://www.opsi.gov.uk/ACTS/acts2003/20030017.htm"/></citation></ref><ref id="B10"><citation citation-type="other"><article-title>Hansard, report on questions to The Parliamentary Under-Secretary for Culture</article-title><source>Media and sport (James Purnell)</source><ext-link ext-link-type="uri" xlink:href="http://www.publications.parliament.uk/pa/cm200506/cmhansrd/cm050712/debtext/50712-27.htm#50712-27_spnew1"/><comment>(accessed on 22.02.06)</comment></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goodacre</surname><given-names>S</given-names></name></person-group><article-title>The 2003 Licensing Act: an act of stupidity?</article-title><source>Emerg Med J</source><year>2005</year><volume>22</volume><fpage>682</fpage><pub-id pub-id-type="pmid">16189025</pub-id><pub-id pub-id-type="doi">10.1136/emj.2005.030049</pub-id></citation></ref><ref id="B12"><citation citation-type="other"><ext-link ext-link-type="uri" xlink:href="http://www.beerandpub.com/content.asp?id_Content=2764&