.</article-title><source>Parasitol Today</source> <year>1994</year>;<volume>10</volume>:<fpage>231</fpage>&#x02013;<lpage>3</lpage> <pub-id pub-id-type="doi">10.1016/0169-4758(94)90124-4</pub-id><pub-id pub-id-type="pmid">15275458</pub-id></citation></ref><ref id="R9"><label>9. </label><citation citation-type="journal"><string-name><surname>Lv</surname> <given-names>S</given-names></string-name>, <string-name><surname>Zhou</surname> <given-names>XN</given-names></string-name>, <string-name><surname>Zhang</surname> <given-names>Y</given-names></string-name>, <string-name><surname>Liu</surname> <given-names>HX</given-names></string-name>, <string-name><surname>Zhu</surname> <given-names>D</given-names></string-name>, <string-name><surname>Yin</surname> <given-names>WG</given-names></string-name>, <etal/><article-title>The effect of temperature on the development of <italic>Angiostrongylus cantonensis</italic> (Chen, 1935) in <italic>Pomacea canaliculata</italic> (Lamarck, 1822).</article-title><source>Parasitol Res</source> <year>2006</year>;<volume>99</volume>:<fpage>583</fpage>&#x02013;<lpage>7</lpage> <pub-id pub-id-type="doi">10.1007/s00436-006-0198-8</pub-id><pub-id pub-id-type="pmid">16670882</pub-id></citation></ref><ref id="R10"><label>10. </label><citation citation-type="journal"><string-name><surname>Chen</surname> <given-names>ER</given-names></string-name> <article-title>Current status of food-borne parasitic zoonoses in Taiwan.</article-title><source>Southeast Asian J Trop Med Public Health</source> <year>1991</year>;<volume>22</volume>(<issue>Suppl</issue>):<fpage>62</fpage>&#x02013;<lpage>4</lpage><pub-id pub-id-type="pmid">1822939</pub-id></citation></ref><ref id="R11"><label>11. </label><citation citation-type="journal"><string-name><surname>Lin</surname> <given-names>JX</given-names></string-name>, <string-name><surname>Zhou</surname> <given-names>XN</given-names></string-name>, <string-name><surname>Li</surname> <given-names>LS</given-names></string-name>, <string-name><surname>Zhang</surname> <given-names>Y</given-names></string-name>, <string-name><surname>Cheng</surname> <given-names>YZ</given-names></string-name>, <string-name><surname>Zhang</surname> <given-names>RY</given-names></string-name>, <etal/><article-title><italic>Bellamya aeruginosa</italic> acts as the intermediate host for <italic>Angiostrongylus cantonensis.</italic></article-title><source>Chin J Zoonoses</source> <year>2005</year>;<volume>21</volume>:<fpage>24</fpage>&#x02013;<lpage>6</lpage></citation></ref><ref id="R12"><label>12. </label><citation citation-type="journal"><string-name><surname>Li</surname> <given-names>LS</given-names></string-name>, <string-name><surname>Zhou</surname> <given-names>XN</given-names></string-name>, <string-name><surname>Lin</surname> <given-names>JX</given-names></string-name>, <string-name><surname>Zhang</surname> <given-names>Y</given-names></string-name>, <string-name><surname>Chen</surname> <given-names>YZ</given-names></string-name>, <string-name><surname>Zhang</surname> <given-names>RY</given-names></string-name>, <etal/><article-title>Discovery of six new host species of <italic>Angiostrongylus cantonensis</italic> and investigation of the epidemic foci in Fujian province.</article-title><source>Chin J Zoonoses</source> <year>2006</year>;<volume>22</volume>:<fpage>533</fpage>&#x02013;<lpage>7</lpage></citation></ref><ref id="R13"><label>13. </label><citation citation-type="journal"><string-name><surname>Keiser</surname> <given-names>J</given-names></string-name>, <string-name><surname>Utzinger</surname> <given-names>J</given-names></string-name> <article-title>Emerging foodborne trematodiasis.</article-title><source>Emerg Infect Dis</source> <year>2005</year>;<volume>11</volume>:<fpage>1507</fpage>&#x02013;<lpage>14</lpage><pub-id pub-id-type="pmid">16318688</pub-id></citation></ref></ref-list></back></article>