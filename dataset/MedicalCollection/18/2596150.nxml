ame><surname>Sampsel</surname><given-names>J</given-names></name><name><surname>Siddiqi</surname><given-names>MA</given-names></name><name><surname>Tuttle</surname><given-names>SE</given-names></name><name><surname>Sickle-Santanello</surname><given-names>B</given-names></name><name><surname>Colcher</surname><given-names>D</given-names></name><name><surname>Thurston</surname><given-names>MO</given-names></name><name><surname>Bell</surname><given-names>JG</given-names></name></person-group><article-title>Radioimmunoguided surgery using monoclonal antibody</article-title><source>Am J Surg</source><year>1988</year><volume>156</volume><fpage>386</fpage><lpage>392</lpage><pub-id pub-id-type="pmid">3189709</pub-id><pub-id pub-id-type="doi">10.1016/S0002-9610(88)80193-4</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nieroda</surname><given-names>CA</given-names></name><name><surname>Mojzisik</surname><given-names>C</given-names></name><name><surname>Sardi</surname><given-names>A</given-names></name><name><surname>Ferrara</surname><given-names>P</given-names></name><name><surname>Hinkle</surname><given-names>G</given-names></name><name><surname>Thurston</surname><given-names>MO</given-names></name><name><surname>Martin</surname><given-names>EW</given-names><suffix>Jr</suffix></name></person-group><article-title>The impact of radioimmunoguided surgery (RIGS) on surgical decision-making in colorectal cancer</article-title><source>Dis Colon Rectum</source><year>1989</year><volume>32</volume><fpage>927</fpage><lpage>932</lpage><pub-id pub-id-type="pmid">2806020</pub-id><pub-id pub-id-type="doi">10.1007/BF02552267</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cohen</surname><given-names>AM</given-names></name><name><surname>Martin</surname><given-names>EW</given-names><suffix>Jr</suffix></name><name><surname>Lavery</s