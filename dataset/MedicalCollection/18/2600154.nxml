" align="center" rowspan="1" colspan="1">0</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">0</td><td valign="top" align="center" rowspan="1" colspan="1">5, 43</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">20, 30</td><td valign="top" align="center" rowspan="1" colspan="1">0</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">0</td><td valign="top" align="center" rowspan="1" colspan="1">4, 4</td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1"><italic>Sarcocystis</italic> spp.</td><td valign="top" align="center" rowspan="1" colspan="1">0</td><td valign="top" align="center" rowspan="1" colspan="1">0</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">0</td><td valign="top" align="center" rowspan="1" colspan="1">15, 30 &#x02028;(3&#x02013;53)</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">40, 2 &#x02028;(1&#x02013;2)</td><td valign="top" align="center" rowspan="1" colspan="1">14, 21</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">11, 13&#x02028;(3&#x02013;27)</td><td valign="top" align="center" rowspan="1" colspan="1">13, 3&#x02028;(1&#x02013;255)</td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1"><italic>Toxascaris</italic> spp.&#x02020;</td><td valign="top" align="center" rowspan="1" colspan="1">0</td><td valign="top" align="center" rowspan="1" colspan="1">0</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">0</td><td valign="top" align="center" rowspan="1" colspan="1">5, 221</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="cente