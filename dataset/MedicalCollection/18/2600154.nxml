top" align="center" rowspan="1" colspan="1">35, 40 &#x02028;(9&#x02013; 251)<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">26, 27&#x02028;(17&#x02013;367)<hr/></td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1">No. dogs</td><td valign="top" align="center" rowspan="1" colspan="1">4</td><td valign="top" align="center" rowspan="1" colspan="1">1</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">30</td><td valign="top" align="center" rowspan="1" colspan="1">13</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">3</td><td valign="top" align="center" rowspan="1" colspan="1">7</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">23</td><td valign="top" align="center" rowspan="1" colspan="1">15</td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1"><italic>Giardia</italic> spp.&#x02020;<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">0<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">0<hr/></td><td valign="top" align="left" rowspan="1" colspan="1"><hr/></td><td valign="top" align="center" rowspan="1" colspan="1">0<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">8<hr/></td><td valign="top" align="left" rowspan="1" colspan="1"><hr/></td><td valign="top" align="center" rowspan="1" colspan="1">33<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">0<hr/></td><td valign="top" align="left" rowspan="1" colspan="1"><hr/></td><td valign="top" align="center" rowspan="1" colspan="1">0<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">20<hr/></td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1">No. dogs</td><td valign="top" align="center" rowspan="1" colspan="1">6</td><td valign="top" align="center" rowspan="1" colspan="1">1</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">29</td><td valign="top" align="center" rowspan="1" colspan="1">16</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">3</td><td valign="top" align="center" rowspan="1" colspan="1">5</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">30</td><td valign="top" align="center" rowspan="1" colspan="1">18</td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1"><italic>Toxoplasma gondii</italic> &#x02020;&#x000a7;</td><td valign="top" align="center" rowspan="1" colspan="1">50</td><td valign="top" align="center" rowspan="1" colspan="1">100</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">41</td><td valign="top" align="center" rowspan="1" colspan="1">50</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">100</td><td valign="top" align="center" rowspan="1" colspan="1">80</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">60</td><td valign="top" align="center" rowspan="1" colspan="1">56</td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1"><italic>Neospora caninum</italic>&#x000b6;</td><td valign="top" align="center" rowspan="1" colspan="1">0</td><td valign="top" align="center" rowspan="1" colspan="1">0</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">3</td><td valign="top" align="center" rowspan="1" colspan="1">6</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">0</td><td valign="top" align="center" rowspan="1" colspan="1">0</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">7</td><td valign="top" align="center" rowspan="1" colspan="1">0</td></tr></tbody></table><table-wrap-foot><p>*Range not reported if only 1 dog was positive. Intensity is the number of eggs or oocytes per gram of wet feces.&#x02028;&#x02020;Zoonotic parasites.&#x02028;&#x02021;<italic>Echinococcus multilocularis, E. granulosus</italic>, or <italic>Taenia</italic> spp.&#x02028;&#x000a7;23 dogs had titers of 25, 22 had titers of 50, 1 had a titer of 100, 1 had a titer of 200, and 1 had a titer of 400.&#x02028;&#x000b6;All 4 dogs had titers of 25.</p></table-wrap-foot></table-wrap><table-wrap id="T2" position="float"><label>Table 2</label><caption><title>Percentage of dogs with multiple parasite genera detected by fecal flotation in 2 communities in northern Canada</title></caption><table frame="hsides" rules="groups"><col width="59" span="1"/><col width="30" span="1"/><col width="30" span="1"/><col width="9" span="1"/><col width="31" span="1"/><col width="31" span="1"/><col width="9" span="1"/><col width="31" span="1"/><col width="31" span="1"/><col width="9" span="1"/><col width="31" span="1"/><col width="31" span="1"/><col width="9" span="1"/><col width="31" span="1"/><col width="31" span="1"/><col width="9" span="1"/><col width="32" span="1"/><col width="32" span="1"/><thead><tr><th rowspan="3" valign="bottom" align="left" scope="col" colspan="1">Characteristic</th><th valign="bottom" colspan="5" align="center" scope="colgroup" rowspan="1">Fort Chipewyan<hr/></th><th rowspan="3" valign="bottom" align="left" scope="col" colspan="1"/><th valign="bottom" colspan="5" align="center" scope="colgroup" rowspan="1">Fort Resolution<hr/></th><th rowspan="3" valign="bottom" align="left" scope="col" colspan="1"/><th valign="bottom" colspan="5" align="center" scope="colgroup" rowspan="1">Total<hr/></th></tr><tr><th valign="bottom" colspan="2" align="center" scope="colgroup" rowspan="1">Puppies<hr/></th><th rowspan="2" v