pub-id></mixed-citation></ref><ref id="b19-copd-5-041"><label>19.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>O&#x02019;Donnell</surname><given-names>DE</given-names></name><name><surname>Fluge</surname><given-names>T</given-names></name><name><surname>Gerken</surname><given-names>F</given-names></name><etal/></person-group><article-title>Effects of tiotropium on lung hyperinflation, dyspnoea and exercise tolerance in COPD</article-title><source>Eur Respir J</source><year>2004</year><volume>23</volume><fpage>832</fpage><lpage>840</lpage><pub-id pub-id-type="pmid">15218994</pub-id></mixed-citation></ref><ref id="b20-copd-5-041"><label>20.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Tashkin</surname><given-names>DP</given-names></name><name><surname>Celli</surname><given-names>B</given-names></name><name><surname>Senn</surname><given-names>S</given-names></name><etal/></person-group><article-title>A four-year trial of tiotropium in chronic obstructive pulmonary disease</article-title><source>N Engl J Med</source><year>2008</year><volume>359</volume><fpage>1543</fpage><lpage>1554</lpage><pub-id pub-id-type="pmid">18836213</pub-id></mixed-citation></ref><ref id="b21-copd-5-041"><label>21.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kanner</surname><given-names>RE</given-names></name><name><surname>Anthonisen</surname><given-names>NR</given-names></name><name><surname>Connett</surname><given-names>JE</given-names></name></person-group><article-title>Lower respiratory illnesses promote FEV1 decline in current smokers but not ex-smokers with mild chronic obstructive pulmonary disease</article-title><source>Am J Respir Crit Care Med</source><year>2001</year><volume>164</volume><fpage>358</fpage><lpage>364</lpage><pub-id pub-id-type="pmid">11500333</pub-id></mixed-citation></ref><ref id="b22-