ame><article-title>Somatic symptom reporting in women and men</article-title><source>J Gen Intern Med</source><year>2001</year><volume>16</volume><fpage>266</fpage><lpage>275</lpage><pub-id pub-id-type="doi">10.1046/j.1525-1497.2001.016004266.x</pub-id><pub-id pub-id-type="pmid">11318929</pub-id></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="journal"><name><surname>Wool</surname><given-names>CA</given-names></name><name><surname>Barsky</surname><given-names>AJ</given-names></name><article-title>Do women somatize more than men? Gender differences in somatization</article-title><source>Psychosomatics</source><year>1994</year><volume>35</volume><fpage>445</fpage><lpage>452</lpage><pub-id pub-id-type="pmid">7972659</pub-id></mixed-citation></ref><ref id="B19"><mixed-citation publication-type="journal"><name><surname>Sloan</surname><given-names>DM</given-names></name><name><surname>Kornstein</surname><given-names>SG</given-names></name><article-title>Gender differences in depression and response to antidepressant treatment</article-title><source>Psychiatr Clin North Am</source><year>2003</year><volume>26</volume><fpage>581</fpage><lpage>594</lpage><pub-id pub-id-type="doi">10.1016/S0193-953X(03)00044-3</pub-id><pub-id pub-id-type="pmid">14563099</pub-id></mixed-citation></ref><ref id="B20"><mixed-citation publication-type="journal"><name><surname>Marcus</surname><given-names>SM</given-names></name><name><surname>Kerber</surname><given-names>KB</given-names></name><name><surname>Rush</surname><given-names>AJ</given-names></name><name><surname>Wisniewski</surname><given-names>SR</given-names></name><name><surname>Nierenberg</surname><given-names>A</given-names></name><name><surname>Balasubramani</surname><given-names>GK</given-names></name><name><surname>Ritz</surname><given-names>L</given-names></name><name><surname>Kornstein</surname><given-names>S</given-names></name><name><surname>Young</surname><given-names>EA</given-names></name><name><surname>Trivedi</surname><given-names>MH</given-names></name><article-title>Sex differences in depression symptoms in treatment-seeking adults: confirmatory analyses from the Sequenced Treatment Alternatives to Relieve Depression study</article-title><source>Compr Psychiatry</source><year>2008</year><volume>49</volume><fpage>238</fpage><lpage>246</lpage><pub-id pub-id-type="doi">10.1016/j.comppsych.2007.06.012</pub-id><pub-id pub-id-type="pmid">18396182</pub-id></mixed-citation></ref><ref id="B21"><mixed-citation publication-type="journal"><name><surname>Huffman</surname><given-names>JC</given-names></name><name><surname>Pollack</surname><given-names>MH</given-names></name><article-title>Predicting panic disorder among patients with chest pain: an analysis of the literature</article-title><source>Psychosomatics</source><year>2003</year><volume>44</volume><fpage>222</fpage><lpage>236</lpage><pub-id pub-id-type="doi">10.1176/appi.psy.44.3.222</pub-id><pub-id pub-id-type="pmid">12724504</pub-id></mixed-citation></ref><ref id="B22"><mixed-citation publication-type="journal"><name><surname>DeVon</surname><given-names>HA</given-names></name><name><surname>Zerwic</surname><given-names>JJ</given-names></name><article-title>Symptoms of acute coronary syndromes: are there gender differences? A review of the literature</article-title><source>Heart Lung</source><year>2002</year><volume>31</volume><fpage>235</fpage><lpage>245</lpage><pub-id pub-id-type="doi">10.1067/mhl.2002.126105</pub-id><pub-id pub-id-type="pmid">12122387</pub-id></mixed-citation></ref><ref id="B23"><mixed-citation publication-type="journal"><name><surname>Goldberg</surname><given-names>RJ</given-names></name><name><surname>O'Donnell</surname><given-names>C</given-names></name><name><surname>Yarzebski</surname><given-names>J</given-names></name><name><surname>Bigelow</surname><given-names>C</given-names></name><name><surname>Savageau</surname><given-names>J</given-names></name><name><surname>Gore</surname><given-nam