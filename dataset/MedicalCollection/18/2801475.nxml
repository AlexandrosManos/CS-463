blication-type="journal"><name><surname>Bello</surname><given-names>N</given-names></name><name><surname>Mosca</surname><given-names>L</given-names></name><article-title>Epidemiology of coronary heart disease in women</article-title><source>Prog Cardiovasc Dis</source><year>2004</year><volume>46</volume><fpage>287</fpage><lpage>295</lpage><pub-id pub-id-type="doi">10.1016/j.pcad.2003.08.001</pub-id><pub-id pub-id-type="pmid">14961452</pub-id></mixed-citation></ref><ref id="B8"><mixed-citation publication-type="journal"><name><surname>Kitler</surname><given-names>ME</given-names></name><article-title>Coronary disease: are there gender differences?</article-title><source>Eur Heart J</source><year>1994</year><volume>15</volume><fpage>409</fpage><lpage>417</lpage><pub-id pub-id-type="pmid">8013521</pub-id></mixed-citation></ref><ref id="B9"><mixed-citation publication-type="journal"><name><surname>Holdright</surname><given-names>DR</given-names></name><name><surname>Fox</surname><given-names>KM</given-names></name><article-title>Characterization and identification of women with angina pectoris</article-title><source>Eur Heart J</source><year>1996</year><volume>17</volume><fpage>510</fpage><lpage>517</lpage><pub-id pub-id-type="pmid">8733082</pub-id></mixed-citation></ref><ref id="B10"><mixed-citation publication-type="journal"><name><surname>Arslanian-Engoren</surname><given-names>C</given-names></name><name><surname>Patel</surname><given-names>A</given-names></name><name><surname>Fang</surname><given-names>J</given-names></name><name><surname>Armstrong</surname><given-names>D</given-names></name><name><surname>Kline-Rogers</surname><given-names>E</given-names></name><name><surname>Duvernoy</surname><given-names>CS</given-names></name><name><surname>Eagle</surname><given-names>KA</given-names></name><article-title>Symptoms of men and women presenting with acute coronary syndromes</article-title><source>Am J Cardiol</source><year>2006</year><volume>98</volume><fpage>1177