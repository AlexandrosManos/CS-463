64">61</xref>]</td></tr><tr><td align="center" colspan="8" rowspan="1"><hr/></td></tr><tr><td align="left" rowspan="1" colspan="1">90</td><td align="left" rowspan="1" colspan="1">Rosi versus metformin versus No-treatment</td><td align="center" rowspan="1" colspan="1">48 weeks</td><td align="left" rowspan="1" colspan="1">Rosi: &#x02212;19.3,*<italic>P</italic> &#x0003c; .001; met: &#x02212;11.1,*<italic>P</italic> &#x0003c; .001; No-Tx: +0.7,*NS At 48 weeks: rosi versus No-Tx <italic>P</italic> &#x0003c; .001; met versus No-Tx <italic>P</italic> &#x0003c; .001; met versus rosi <italic>P</italic> &#x0003c; .001</td><td align="left" rowspan="1" colspan="1">Rosi: &#x02212;7.3,*<italic>P</italic> &#x0003c; .001; met: &#x02212;6.2,*<italic>P</italic> &#x0003c; .001; No-Tx: +0.3,*NS At 48 weeks: rosi versus No-Tx <italic>P</italic> &#x0003c; .001; met versus No-Tx <italic>P</italic> &#x0003c; .001; rosi versus met <italic>P</italic> &#x0003c; .001</td><td align="left" rowspan="1" colspan="1">NR</td><td align="left" rowspan="1" colspan="1">Rosi: &#x02212;1.9,*<italic>P</italic> &#x0003c; .001;met: &#x02212;2.2,*<italic>P</italic> &#x0003c; .001; No-Tx: 0.0,*NSAt 48 weeks: Rosi versus No-Tx <italic>P</italic> &#x0003c; .001; met versus No-Tx <italic>P</italic> &#x0003c; .001; rosi versus met <italic>P</italic> = .015</td><td align="center" rowspan="1" colspan="1">Sili&#x0010d; et al. [<xref ref-type="bibr" rid="B66">63</xref>]</td></tr><tr><td align="center" colspan="8" rowspan="1"><hr/></td></tr><tr><td align="left" rowspan="1" colspan="1">39</td><td align="left" rowspan="1" colspan="1">Rosi versus metformin</td><td align="center" rowspan="1" colspan="1">26</td><td align="left" rowspan="1" colspan="1">NR</td><td align="left" rowspan="1" colspan="1">NR</td><td align="left" rowspan="1" colspan="1">Glucose AUC: rosi: &#x02212;1.9,*<italic>P</italic> = .04; met:  &#x02212;1.1,*<italic>P</italic> = .05  &#x00394; rosi versus met NS Insulin AUC: rosi: &#x02212;37,*<italic>P</ital