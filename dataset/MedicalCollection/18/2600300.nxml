.</article-title><source>Vet Rec</source> <year>2005</year>;<volume>156</volume>:<fpage>301</fpage>&#x02013;<lpage>4</lpage><pub-id pub-id-type="pmid">15786918</pub-id></citation></ref><ref id="R6"><label>6. </label><citation citation-type="journal"><string-name><surname>Mellor</surname> <given-names>PS</given-names></string-name>, <string-name><surname>Boorman</surname> <given-names>J</given-names></string-name>, <string-name><surname>Baylis</surname> <given-names>M</given-names></string-name> <article-title><italic>Culicoides</italic> biting midges: their role as arbovirus vectors.</article-title><source>Annu Rev Entomol</source> <year>2000</year>;<volume>45</volume>:<fpage>307</fpage>&#x02013;<lpage>40</lpage> <pub-id pub-id-type="doi">10.1146/annurev.ento.45.1.307</pub-id><pub-id pub-id-type="pmid">10761580</pub-id></citation></ref><ref id="R7"><label>7. </label><citation citation-type="journal"><string-name><surname>Toussaint</surname> <given-names>JF</given-names></string-name>, <string-name><surname>Sailleau</surname> <given-names>C</given-names></string-name>, <string-name><surname>Mast</surname> <given-names>J</given-names></string-name>, <string-name><surname>Houdart</surname> <given-names>P</given-names></string-name>, <string-name><surname>Czaplicki</surname> <given-names>G</given-names></string-name>, <string-name><surname>Demeestere</surname> <given-names>L</given-names></string-name>, <etal/><article-title>Bluetongue in Belgium, 2006.</article-title><source>Emerg Infect Dis</source> <year>2007</year>;<volume>13</volume>:<fpage>614</fpage>&#x02013;<lpage>6</lpage><pub-id pub-id-type="pmid">17553280</pub-id></citation></ref><ref id="R8"><label>8. </label><citation citation-type="journal"><string-name><surname>Trainer</surname> <given-names>DO</given-names></string-name>, <string-name><surname>Jochim</surname> <given-names>MM</given-names></string-name> <article-title>Serologic evidence of bluetongue in wild ruminants of North America.</article-title><so