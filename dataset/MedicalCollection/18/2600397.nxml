ub-id-type="pmid">10459918</pub-id></citation></ref><ref id="R12"><label>12. </label><citation citation-type="journal"><string-name><surname>Ross</surname> <given-names>BC</given-names></string-name>, <string-name><surname>Johnson</surname> <given-names>PD</given-names></string-name>, <string-name><surname>Oppedisano</surname> <given-names>F</given-names></string-name>, <string-name><surname>Marino</surname> <given-names>L</given-names></string-name>, <string-name><surname>Sievers</surname> <given-names>A</given-names></string-name>, <string-name><surname>Stinear</surname> <given-names>T</given-names></string-name>, <etal/><article-title>Detection of <italic>Mycobacterium ulcerans</italic> in environmental samples during an outbreak of ulcerative disease.</article-title><source>Appl Environ Microbiol</source> <year>1997</year>;<volume>63</volume>:<fpage>4135</fpage>&#x02013;<lpage>8</lpage><pub-id pub-id-type="pmid">9327583</pub-id></citation></ref><ref id="R13"><label>13. </label><citation citation-type="journal"><string-name><surname>Stinear</surname> <given-names>T</given-names></string-name>, <string-name><surname>Davies</surname> <given-names>JK</given-names></string-name>, <string-name><surname>Jenkin</surname> <given-names>GA</given-names></string-name>, <string-name><surname>Hayman</surname> <given-names>JA</given-names></string-name>, <string-name><surname>Oppedisano</surname> <given-names>F</given-names></string-name>, <string-name><surname>Johnson</surname> <given-names>PDR</given-names></string-name> <article-title>Identification of <italic>Mycobacterium ulcerans</italic> in the environment from regions in Southeast Australia in which it is endemic with sequence capture-PCR.</article-title><source>Appl Environ Microbiol</source> <year>2000</year>;<volume>66</volume>:<fpage>3206</fpage>&#x02013;<lpage>13</lpage> <pub-id pub-id-type="doi">10.1128/AEM.66.8.3206-3213.2000</pub-id><pub-id pub-id-type="pmid">10919771</pub-id></citation></ref><ref id="R14"><lab