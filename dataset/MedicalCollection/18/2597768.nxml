</article-title><source>Cochrane Database Syst Rev</source><volume>1</volume><fpage>CD00031</fpage></citation></ref><ref id="b24-vhrm-4-0837"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hurt</surname><given-names>RD</given-names></name><name><surname>Sachs</surname><given-names>DPL</given-names></name><name><surname>Glover</surname><given-names>ED</given-names></name><etal/></person-group><year>1997</year><article-title>A comparison of sustained release bupropion and placebo for smoking cessation</article-title><source>N Engl J Med</source><volume>337</volume><fpage>1195</fpage><lpage>202</lpage><pub-id pub-id-type="pmid">9337378</pub-id></citation></ref><ref id="b25-vhrm-4-0837"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hyland</surname><given-names>A</given-names></name><name><surname>Borland</surname><given-names>R</given-names></name><name><surname>Li</surname><given-names>Q</given-names></name><etal/></person-group><year>2006</year><article-title>Individual-level predictors of cessation behaviors among participants in the international tobacco control (ITC) four country survey</article-title><source>Tob Control</source><volume>15</volume><issue>Suppl 3</issue><fpage>83</fpage><lpage>94</lpage><pub-id pub-id-type="pmid">16565454</pub-id></citation></ref><ref id="b26-vhrm-4-0837"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jorenby</surname><given-names>D</given-names></name></person-group><year>2002</year><article-title>Clinical efficacy of bupropion in the management of smoking cessation</article-title><source>Drugs</source><volume>62</volume><issue>Suppl 2</issue><fpage>25</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">12109933</pub-id></citation></ref><ref id="b27-vhrm-4-0837"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jorenby</surname><given-names>DE</given-names></name><n