-names></string-name>, <etal/><article-title>Fatal avian influenza A H5N1 in a dog.</article-title><source>Emerg Infect Dis</source> <year>2006</year>;<volume>12</volume>:<fpage>1744</fpage>&#x02013;<lpage>7</lpage><pub-id pub-id-type="pmid">17283627</pub-id></citation></ref><ref id="R15"><label>15. </label><citation citation-type="journal"><string-name><surname>Chang</surname> <given-names>CP</given-names></string-name>, <string-name><surname>New</surname> <given-names>AE</given-names></string-name>, <string-name><surname>Taylor</surname> <given-names>JF</given-names></string-name>, <string-name><surname>Chang</surname> <given-names>HS</given-names></string-name> <article-title>Influenza virus isolations from dogs during a human epidemic in Taiwan.</article-title><source>Int J Zoon.</source><year>1976</year>;<volume>3</volume>:<fpage>61</fpage>&#x02013;<lpage>4</lpage></citation></ref><ref id="R16"><label>16. </label><citation citation-type="journal"><string-name><surname>Houser</surname> <given-names>RE</given-names></string-name>, <string-name><surname>Heuschele</surname> <given-names>WP</given-names></string-name> <article-title>Evidence of prior infection with influenza A/Texas/77 (H3N2) virus in dogs with clinical parainfluenza.</article-title><source>Can J Comp Med</source> <year>1980</year>;<volume>44</volume>:<fpage>396</fpage>&#x02013;<lpage>402</lpage><pub-id pub-id-type="pmid">6256039</pub-id></citation></ref><ref id="R17"><label>17. </label><citation citation-type="journal"><string-name><surname>Liu</surname> <given-names>H</given-names></string-name>, <string-name><surname>Liu</surname> <given-names>X</given-names></string-name>, <string-name><surname>Cheng</surname> <given-names>J</given-names></string-name>, <string-name><surname>Peng</surname> <given-names>D</given-names></string-name>, <string-name><surname>Jia</surname> <given-names>L</given-names></string-name>, <string-name><surname>Huang</surname> <given-names>Y</given-names></string-name> <art