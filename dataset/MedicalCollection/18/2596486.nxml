an="1" colspan="1">5</td><td align="left" rowspan="1" colspan="1">19.1</td></tr><tr><td align="left" rowspan="1" colspan="1">15</td><td align="left" rowspan="1" colspan="1">6323</td><td align="left" rowspan="1" colspan="1">18</td><td align="left" rowspan="1" colspan="1">1-69</td><td align="left" rowspan="1" colspan="1">3-22 / 2</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">5.9</td></tr><tr><td align="left" rowspan="1" colspan="1">16</td><td align="left" rowspan="1" colspan="1">6343</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">1-69</td><td align="left" rowspan="1" colspan="1">3-22 / 2</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">6.3</td></tr><tr><td align="left" rowspan="1" colspan="1">17</td><td align="left" rowspan="1" colspan="1">6331</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">1-69</td><td align="left" rowspan="1" colspan="1">3-22 / 2</td><td align="left" rowspan="1" colspan="1">5</td><td align="left" rowspan="1" colspan="1">2.8</td></tr><tr><td align="left" rowspan="1" colspan="1">18</td><td align="left" rowspan="1" colspan="1">6262</td><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">1-69</td><td align="left" rowspan="1" colspan="1">4-04 / 2</td><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">9.4</td></tr><tr><td align="left" rowspan="1" colspan="1">19</td><td align="left" rowspan="1" colspan="1">6329</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">1-69</td><td align="left" rowspan="1" colspan="1">6-25 / 1</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">9.4</td></tr><tr><td align="left" rowspan="1" colspan="1">20</td><td align="left" rowspan="1" colspan="1">6143</td><td align="left" rowspan="1" colspan="1">1</td>