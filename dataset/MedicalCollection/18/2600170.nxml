-id-type="pmid">18258072</pub-id></citation></ref><ref id="R11"><label>11. </label><citation citation-type="journal"><string-name><surname>Degani</surname> <given-names>N</given-names></string-name>, <string-name><surname>Navarro</surname> <given-names>C</given-names></string-name>, <string-name><surname>Deeks</surname> <given-names>SL</given-names></string-name>, <string-name><surname>Lovgren</surname> <given-names>M</given-names></string-name>; <collab>Canadian International Circumpolar Surveillance Working Group.</collab><article-title>Invasive bacterial diseases in northern Canada.</article-title><source>Emerg Infect Dis</source> <year>2008</year>;<volume>14</volume>:<fpage>34</fpage>&#x02013;<lpage>40</lpage> <pub-id pub-id-type="doi">10.3201/eid1401.061522</pub-id><pub-id pub-id-type="pmid">18258074</pub-id></citation></ref><ref id="R12"><label>12. </label><citation citation-type="journal"><string-name><surname>Bruce</surname> <given-names>MG</given-names></string-name>, <string-name><surname>Deeks</surname> <given-names>SL</given-names></string-name>, <string-name><surname>Zulz</surname> <given-names>T</given-names></string-name>, <string-name><surname>Bruden</surname> <given-names>D</given-names></string-name>, <string-name><surname>Navarro</surname> <given-names>C</given-names></string-name>, <string-name><surname>Lovgren</surname> <given-names>M</given-names></string-name>, <etal/><article-title>International Circumpolar Surveillance System for invasive pneumococcal disease, 1999&#x02013;2005.</article-title><source>Emerg Infect Dis</source> <year>2008</year>;<volume>14</volume>:<fpage>25</fpage>&#x02013;<lpage>33</lpage> <pub-id pub-id-type="doi">10.3201/eid1401.071315</pub-id><pub-id pub-id-type="pmid">18258073</pub-id></citation></ref></ref-list></back></article>