person-group-type="author"><name><surname>Prass</surname><given-names>M</given-names></name><name><surname>Jacobson</surname><given-names>K</given-names></name><name><surname>Mogilner</surname><given-names>A</given-names></name><name><surname>Radmacher</surname><given-names>M</given-names></name></person-group><article-title>Direct measurement of the lamellipodial protrusive force in a migrating cell</article-title><source>J. Cell Biol</source><year>2006</year><volume>174</volume><fpage>767</fpage><lpage>772</lpage><pub-id pub-id-type="pmid">16966418</pub-id></citation></ref><ref id="R17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Danuser</surname><given-names>G</given-names></name><name><surname>Waterman-Storer</surname><given-names>CM</given-names></name></person-group><article-title>Quantitative Fluorescent Speckle Microscopy of Cytoskeleton Dynamics</article-title><source>Ann. Rev. of Biophys. Biomol. Struct</source><year>2006</year><volume>35</volume><fpage>361</fpage><lpage>387</lpage><pub-id pub-id-type="pmid">16689641</pub-id></citation></ref><ref id="R18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ji</surname><given-names>L</given-names></name><name><surname>Danuser</surname><given-names>G</given-names></name></person-group><article-title>Tracking quasi-stationary flow of weak fluorescent signals by adaptive multi-frame correlation</article-title><source>J. Microscopy</source><year>2005</year><volume>220</volume><fpage>150</fpage><lpage>167</lpage></citation></ref><ref id="R19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gardel</surname><given-names>ML</given-names></name><etal/></person-group><article-title>Elastic Behavior of Cross-Linked and Bundled Actin Networks</article-title><source>Science</source><year>2004</year><volume>304</volume><fpage>1301</fpage><lpage>13