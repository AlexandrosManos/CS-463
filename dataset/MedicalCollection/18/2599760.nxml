d align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">1.123</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">T1</td><td align="center" rowspan="1" colspan="1">0.120</td><td align="center" rowspan="1" colspan="1">1.00, 0.83, 1.20</td><td align="center" rowspan="1" colspan="1">1.153</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">0.5</td></tr><tr><td align="left" rowspan="1" colspan="1">T2</td><td align="center" rowspan="1" colspan="1">0.115</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">0.923, 1.278, 2.077</td><td align="center" rowspan="1" colspan="1">1.3</td></tr><tr><td align="left" rowspan="1" colspan="1">T3</td><td align="center" rowspan="1" colspan="1">0.095</td><td align="center" rowspan="1" colspan="1">1.00, 1.02, 2.52</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">0.723, 1.095, 2.661</td><td align="center" rowspan="1" colspan="1">3.7</td></tr><tr><td align="left" rowspan="1" colspan="1">B0-R<xref ref-type="table-fn" rid="tfn7-ehp-116-1661">c</xref></td><td align="center" rowspan="1" colspan="1">0.083</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">0.822</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">T1-R</td><td align="center" rowspan="1" colspan="1">0.102</td><td align="center" rowspan="1" colspan="1">1.00, 0.75, 0.18</td><td align="center" rowspan="1" colspan="1">0.848</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">2.6</td></tr><tr><td align="left" rowspan="1" colspan="1">T2-R</td><td align="center" rowspan="1" colspan="1">0.085</td><td align="center" rowspan