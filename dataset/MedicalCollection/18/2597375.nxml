lspan="1"/><td align="center" rowspan="1" colspan="1"><italic>Peak</italic></td><td align="center" rowspan="1" colspan="1"><italic>Inflection</italic></td><td align="center" rowspan="1" colspan="1"><italic>Remote</italic></td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" colspan="3" rowspan="1"><hr/></td></tr><tr><td align="left" rowspan="1" colspan="1">Wavelength</td><td align="center" rowspan="1" colspan="1">1.07176</td><td align="center" rowspan="1" colspan="1">0.97949</td><td align="center" rowspan="1" colspan="1">0.97904</td><td align="center" rowspan="1" colspan="1">0.92524</td></tr><tr><td align="left" rowspan="1" colspan="1">Resolution (&#x000c5;)</td><td align="center" rowspan="1" colspan="1">20.0&#x02013;2.1 (2.15&#x02013;2.10)</td><td align="center" rowspan="1" colspan="1">20.00&#x02013;2.90 (2.95&#x02013;2.90)</td><td align="center" rowspan="1" colspan="1">20.00&#x02013;2.90 (2.95&#x02013;2.90)</td><td align="center" rowspan="1" colspan="1">20.00&#x02013;2.90 (2.95&#x02013;2.90)</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>R</italic><sub>sym</sub></td><td align="center" rowspan="1" colspan="1">3.5 (23.6)</td><td align="center" rowspan="1" colspan="1">6.2 (24.6)</td><td align="center" rowspan="1" colspan="1">6.2 (24.8)</td><td align="center" rowspan="1" colspan="1">4.8 (8.8)</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>I / &#x003c3;I</italic></td><td align="center" rowspan="1" colspan="1">19.3 (4.7)</td><td align="center" rowspan="1" colspan="1">27.7 (10.0)</td><td align="center" rowspan="1" colspan="1">27.8 (10.2)</td><td align="center" rowspan="1" colspan="1">18.2 (11.1)</td></tr><tr><td align="left" rowspan="1" colspan="1">Completeness (%)</td><td align="center" rowspan="1" colspan="1">96.2 (82.1)</td><td align="center" rowspan="1" colspan="1">99.6 (99.4)</td><td align="center" rowspan="1" colspan="1">99.5 (99.0)</td><td align="center" rowspan="1" colspan="1">97.4 (99.2)</td></tr><tr><td align="left" rowspan="1" colspan="1">Redundancy</td><td align="center" rowspan="1" colspan="1">3</td><td align="center" rowspan="1" colspan="1">11</td><td align="center" rowspan="1" colspan="1">11</td><td align="center" rowspan="1" colspan="1">3</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>Refinement</bold></td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Resolution (&#x000c5;)</td><td align="center" rowspan="1" colspan="1">20.0&#x02013;2.1 (2.15&#x02013;2.10)</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">No. reflections</td><td align="center" rowspan="1" colspan="1">13,456 (752)</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"><italic>R</italic><sub>work</sub> / <italic>R</italic><sub>free</sub></td><td align="center" rowspan="1" colspan="1">19.3 / 22.2</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">No. atoms</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x000a0;&#x000a0;Protein</td><td align="center" rowspan="1" colspan="1">1175</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x000a0;&#x000a0;Ligand/ion</td><td align="center" rowspan="1" colspan="1">29</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x000a0;&#x000a0;Water</td><td align="center" rowspan="1" colspan="1">56</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"><italic>B</italic>-factors</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x000a0;&#x000a0;Protein</td><td align="center" rowspan="1" colspan="1">46.7</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x000a0;&#x000a0;Ligand/ion</td><td align="center" rowspan="1" colspan="1">67.6</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x000a0;&#x000a0;Water</td><td align="center" rowspan="1" colspan="1">42.8</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">r.m.s. deviations</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Bond lengths (&#x000c5;)</td><td align="center" rowspan="1" colspan="1">0.021</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Bond angles (&#x000b0;)</td><td align="center" rowspan="1" colspan="1">1.714</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/></tr></tbody></table><table-wrap-foot><fn id="TFN2"><label>*</label><p id="P52">Values in parentheses are for highest-resolution shell.</p></fn></table-wrap-foot></table-wrap></floats-group></article>