n-group person-group-type="author"><name><surname>Dong</surname><given-names>M</given-names></name><name><surname>Yeh</surname><given-names>F</given-names></name><name><surname>Tepp</surname><given-names>WH</given-names></name><name><surname>Dean</surname><given-names>C</given-names></name><name><surname>Johnson</surname><given-names>EA</given-names></name><name><surname>Janz</surname><given-names>R</given-names></name><etal/></person-group><year>2006</year><article-title>SV2 is the protein receptor for botulinum neurotoxin A.</article-title><source>Science</source><volume>312</volume><fpage>592</fpage><lpage>596</lpage><pub-id pub-id-type="pmid">16543415</pub-id></citation></ref><ref id="ppat.1000245-Mahrhold1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mahrhold</surname><given-names>S</given-names></name><name><surname>Rummel</surname><given-names>A</given-names></name><name><surname>Bigalke</surname><given-names>H</given-names></name><name><surname>Davletov</surname><given-names>B</given-names></name><name><surname>Binz</surname><given-names>T</given-names></name></person-group><year>2006</year><article-title>The synaptic vesicle protein 2C mediates the uptake of botulinum neurotoxin A into phrenic nerves.</article-title><source>FEBS Lett</source><volume>580</volume><fpage>2011</fpage><lpage>2014</lpage><pub-id pub-id-type="pmid">16545378</pub-id></citation></ref><ref id="ppat.1000245-Dong2"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dong</surname><given-names>M</given-names></name><name><surname>Liu</surname><given-names>H</given-names></name><name><surname>Tepp</surname><given-names>WH</given-names></name><name><surname>Johnson</surname><given-names>EA</given-names></name><name><surname>Janz</surname><given-names>R</given-names></name><name><surname>Chapman</surname><given-names>ER</given-names></name></person-group><year>2008</year><article-title>Glycosylated SV2A and SV2B Mediate the Entry of Botulinum Neurotoxin E into Neurons.</article-title><source>Mol Biol Cell</source></citation></ref><ref id="ppat.1000245-Rummel1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rummel</surname><given-names>A</given-names></name><name><surname>Karnath</surname><given-names>T</given-names></name><name><surname>Henke</surname><given-names>T</given-names></name><name><surname>Bigalke</surname><given-names>H</given-names></name><name><surname>Binz</surname><given-names>T</given-names></name></person-group><year>2004</year><article-title>Synaptotagmins I and II act as nerve cell receptors for botulinum neurotoxin G.</article-title><source>J Biol Chem</source><volume>279</volume><fpage>30865</fpage><lpage>30870</lpage><pub-id pub-id-type="pmid">15123599</pub-id></citation></ref><ref id="ppat.1000245-Nishiki1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nishiki</surname><given-names>T</given-names></name><name><surname>Tokuyama</surname><given-names>Y</given-names></name><name><surname>Kamata</surname><given-names>Y</given-names></name><name><surname>Nemoto</surname><given-names>Y</given-names></name><name><surname>Yoshida</surname><given-names>A</given-names></name><name><surname>Sekiguchi</surname><given-names>M</given-names></name><etal/></person-group><year>1996</year><article-title>Binding of botulinum type B neurotoxin to Chinese hamster ovary cells transfected with rat synaptotagmin II cDNA.</article-title><source>Neurosci Lett</source><volume>208</volume><fpage>105</fpage><lpage>108</lpage><pub-id pub-id-type="pmid">8859901</pub-id></citation></ref><ref id="ppat.1000245-Simpson1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simpson</surname><given-names>LL</given-names></name></person-group><year>1983</year><article-title>Ammo