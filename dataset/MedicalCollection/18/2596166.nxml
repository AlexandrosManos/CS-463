</citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kamposioras</surname><given-names>K</given-names></name><name><surname>Casazza</surname><given-names>G</given-names></name><name><surname>Mauri</surname><given-names>D</given-names></name><name><surname>Velisarios Lakiotis</surname><given-names>V</given-names></name><name><surname>Cortinovis</surname><given-names>I</given-names></name><name><surname>Xilomenos</surname><given-names>A</given-names></name><name><surname>Peponi</surname><given-names>C</given-names></name><name><surname>Golfinopoulos</surname><given-names>V</given-names></name><name><surname>Milousis</surname><given-names>A</given-names></name><name><surname>Kakaridis</surname><given-names>D</given-names></name><name><surname>Zacharias</surname><given-names>G</given-names></name><name><surname>Karathanasi</surname><given-names>I</given-names></name><name><surname>Ferentinos</surname><given-names>G</given-names></name><name><surname>Proiskos</surname><given-names>A</given-names></name></person-group><article-title>Screening chest radiography: results from a Greek cross-sectional survey</article-title><source>BMC Public Health</source><year>2006</year><volume>29</volume><fpage>113</fpage><pub-id pub-id-type="pmid">16646992</pub-id><pub-id pub-id-type="doi">10.1186/1471-2458-6-113</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kamposioras</surname><given-names>K</given-names></name><name><surname>Mauri</surname><given-names>D</given-names></name><name><surname>Golfinopoulos</surname><given-names>V</given-names></name><name><surname>Ferentinos</surname><given-names>G</given-names></name><name><surname>Zacharias</surname><given-names>G</given-names></name><name><surname>Xilomenos</surname><given-names>A</given-names></name><name><surname>Polyzos</surname><given-names>NP</given-names></name><name><surname>Bristia