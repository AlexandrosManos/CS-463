on-group-type="author"><name><surname>Lories</surname><given-names>RJ</given-names></name><name><surname>Derese</surname><given-names>I</given-names></name><name><surname>Luyten</surname><given-names>FP</given-names></name></person-group><article-title>Modulation of bone morphogenetic protein signaling inhibits the onset and progression of ankylosing enthesitis</article-title><source>J Clin Invest</source><year>2005</year><volume>115</volume><fpage>1571</fpage><lpage>1579</lpage><pub-id pub-id-type="pmid">15902307</pub-id><pub-id pub-id-type="doi">10.1172/JCI23738</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hogan</surname><given-names>BL</given-names></name></person-group><article-title>Bone morphogenetic proteins in development</article-title><source>Curr Opin Genet Dev</source><year>1996</year><volume>6</volume><fpage>432</fpage><lpage>438</lpage><pub-id pub-id-type="pmid">8791534</pub-id><pub-id pub-id-type="doi">10.1016/S0959-437X(96)80064-5</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferguson</surname><given-names>CM</given-names></name><name><surname>Miclau</surname><given-names>T</given-names></name><name><surname>Hu</surname><given-names>D</given-names></name><name><surname>Alpern</surname><given-names>E</given-names></name><name><surname>Helms</surname><given-names>JA</given-names></name></person-group><article-title>Common molecular pathways in skeletal morphogenesis and repair</article-title><source>Ann N Y Acad Sci</source><year>1998</year><volume>857</volume><fpage>33</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">9917830</pub-id><pub-id pub-id-type="doi">10.1111/j.1749-6632.1998.tb10105.x</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>Z</given-names></name><name><surname>Luyte