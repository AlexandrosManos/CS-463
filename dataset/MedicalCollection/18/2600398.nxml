, <string-name><surname>Saavedra</surname> <given-names>M</given-names></string-name>, <string-name><surname>Ponce</surname> <given-names>L</given-names></string-name>, <etal/><article-title>Shedding and intracage transmission of Sin Nombre hantavirus in the deer mouse (<italic>Peromyscus maniculatus</italic>) model.</article-title><source>J Virol</source> <year>2002</year>;<volume>76</volume>:<fpage>7587</fpage>&#x02013;<lpage>94</lpage> <pub-id pub-id-type="doi">10.1128/JVI.76.15.7587-7594.2002</pub-id><pub-id pub-id-type="pmid">12097572</pub-id></citation></ref><ref id="R10"><label>10. </label><citation citation-type="journal"><string-name><surname>Klingstr&#x000f6;m</surname> <given-names>J</given-names></string-name>, <string-name><surname>Heyman</surname> <given-names>P</given-names></string-name>, <string-name><surname>Escutenaire</surname> <given-names>S</given-names></string-name>, <string-name><surname>Sj&#x000f6;lander</surname> <given-names>KB</given-names></string-name>, <string-name><surname>de Jaegere</surname> <given-names>F</given-names></string-name>, <string-name><surname>Henttonen</surname> <given-names>H</given-names></string-name>, <etal/><article-title>Rodent host specificity of European hantaviruses: evidence of Puumala virus interspecific spillover.</article-title><source>J Med Virol</source> <year>2002</year>;<volume>68</volume>:<fpage>581</fpage>&#x02013;<lpage>8</lpage> <pub-id pub-id-type="doi">10.1002/jmv.10232</pub-id><pub-id pub-id-type="pmid">12376967</pub-id></citation></ref><ref id="R11"><label>11. </label><citation citation-type="journal"><string-name><surname>Boom</surname> <given-names>R</given-names></string-name>, <string-name><surname>Sol</surname> <given-names>CJ</given-names></string-name>, <string-name><surname>Salimans</surname> <given-names>MM</given-names></string-name>, <string-name><surname>Jansen</surname> <given-names>CL</given-names></string-name>, <string-name><surname>Wertheim-van Dillen</surname> <given-names>PM