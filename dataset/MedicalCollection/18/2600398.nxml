e>8</lpage> <pub-id pub-id-type="doi">10.1128/JVI.01822-07</pub-id><pub-id pub-id-type="pmid">18032485</pub-id></citation></ref><ref id="R19"><label>19. </label><citation citation-type="journal"><string-name><surname>Olsson</surname> <given-names>GE</given-names></string-name>, <string-name><surname>White</surname> <given-names>N</given-names></string-name>, <string-name><surname>Ahlm</surname> <given-names>C</given-names></string-name>, <string-name><surname>Elgh</surname> <given-names>F</given-names></string-name>, <string-name><surname>Verlemyr</surname> <given-names>AC</given-names></string-name>, <string-name><surname>Juto</surname> <given-names>P</given-names></string-name>, <etal/><article-title>Demographic factors associated with hantavirus infection in bank voles (<italic>Clethrionomys glareolus</italic>).</article-title><source>Emerg Infect Dis</source> <year>2002</year>;<volume>8</volume>:<fpage>924</fpage>&#x02013;<lpage>9</lpage><pub-id pub-id-type="pmid">12194768</pub-id></citation></ref><ref id="R20"><label>20. </label><citation citation-type="journal"><string-name><surname>Linard</surname> <given-names>C</given-names></string-name>, <string-name><surname>Tersago</surname> <given-names>K</given-names></string-name>, <string-name><surname>Leirs</surname> <given-names>H</given-names></string-name>, <string-name><surname>Lambin</surname> <given-names>EF</given-names></string-name> <article-title>Environmental conditions and Puumala virus transmission in Belgium.</article-title><source>Int J Health Geogr</source> <year>2007</year>;<volume>6</volume>:<fpage>55</fpage> <pub-id pub-id-type="doi">10.1186/1476-072X-6-55</pub-id><pub-id pub-id-type="pmid">18078526</pub-id></citation></ref><ref id="R21"><label>21. </label><citation citation-type="journal"><string-name><surname>Hardestam</surname> <given-names>J</given-names></string-name>, <string-name><surname>Simon</surname> <given-names>M</given-names></string-name>, <string-name><surname>Hedlund</surname> <given-names>KO</given-names></string-name>, <string-name><surname>Vaheri</surname> <given-names>A</given-names></string-name>, <string-name><surname>Klingstr&#x000f6;m</surname> <given-names>J</given-names></string-name>, <string-name><surname>Lundkvist</surname> <given-names>&#x000c5;</given-names></string-name> <article-title>Ex vivo stability of the rodent-borne Hantaan virus in comparison to that of arthropod-borne members of the Bunyaviridae family.</article-title><source>Appl Environ Microbiol</source> <year>2007</year>;<volume>73</volume>:<fpage>2547</fpage>&#x02013;<lpage>51</lpage> <pub-id pub-id-type="doi">10.1128/AEM.02869-06</pub-id><pub-id pub-id-type="pmid">17337567</pub-id></citation></ref></ref-list></back></article>