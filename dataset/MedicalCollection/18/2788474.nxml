n publication-type="journal"><person-group person-group-type="author"><name><surname>Sturniolo</surname><given-names>GC</given-names></name><name><surname>Montino</surname><given-names>MC</given-names></name><name><surname>Dall'Igna</surname></name><name><surname>D'Inca</surname><given-names>R</given-names></name><name><surname>Messineo</surname><given-names>A</given-names></name><name><surname>Cecchetto</surname><given-names>A</given-names></name><etal/></person-group><article-title>Familial juvenile polyposis coli: Results of endoscopic treatment and surveillance in two sisters</article-title><source>Gastrointest Endosc</source><year>1993</year><volume>39</volume><fpage>561</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">8396056</pub-id></element-citation></ref></ref-list></back></article>