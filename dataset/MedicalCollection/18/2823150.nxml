rectum</article-title><source>J Trauma</source><year>1990</year><volume>30</volume><fpage>1427</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">2231822</pub-id></element-citation></ref><ref id="CIT7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Izzo</surname><given-names>L</given-names></name><name><surname>Almansour</surname><given-names>M</given-names></name><name><surname>Gazzanelli</surname><given-names>S</given-names></name><name><surname>Tarquini</surname><given-names>S</given-names></name><name><surname>Sassayannis</surname><given-names>P</given-names></name><name><surname>Casullo</surname><given-names>A</given-names></name><etal/></person-group><article-title>Spontaneous rupture of duodenum: case report and review</article-title><source>G Chir</source><year>2005</year><volume>26</volume><fpage>221</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">16184708</pub-id></element-citation></ref><ref id="CIT8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Marhin</surname><given-names>WW</given-names></name><name><surname>Amson</surname><given-names>BJ</given-names></name></person-group><article-title>Management of perforated duodenal diverticula</article-title><source>Can J Surg</source><year>2005</year><volume>48</volume><fpage>79</fpage><lpage>80</lpage><pub-id pub-id-type="pmid">15757048</pub-id></element-citation></ref><ref id="CIT9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Degiannis</surname><given-names>E</given-names></name><name><surname>Boffard</surname><given-names>K</given-names></name></person-group><article-title>Duodenal injuries</article-title><source>Br J Surg</source><year>2000</year><volume>87</volume><fpage>1473</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">11091233</pub-id></element-citation></ref><ref id="CIT10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Brooks</surname><given-names>AJ</given-names></name><name><surname>Boffard</surname><given-names>KD</given-names></name></person-group><article-title>Current technology: laparoscopic surgery in Trauma</article-title><source>Trauma</source><year>1999</year><volume>1</volume><fpage>53</fpage><lpage>60</lpage></element-citation></ref><ref id="CIT11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mathis</surname><given-names>KL</given-names></name><name><surname>Farley</surname><given-names>DR</given-names></name></person-group><article-title>Operative management of symptomatic duodenal diverticula</article-title><source>Am J Surg</source><year>2007</year><volume>193</volume><fpage>305</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">17320524</pub-id></element-citation></ref><ref id="CIT12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rathore</surname><given-names>MA</given-names></name><name><surname>Andrabi</surname><given-names>SI</given-names></name><name><surname>Najfi</surname><given-names>SM</given-names></name><name><surname>Chaudhry</surname><given-names>Z</given-names></name><name><surname>Chaudhry</surname><given-names>AM</given-names></name></person-group><article-title>Injuries to the duodenum--prognosis correlates with body Injury Severity Score: a prospective study</article-title><source>Int J Surg</source><year>2007</year><volume>5</volume><fpage>388</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">17613290</pub-id></element-citation></ref><ref id="CIT13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Huerta</surname><given-names>S</given-names></name><name><surname>Bui</surname><given-names>T</given-names></name><name><surname>Porral</surname><given-names>D</given-names></name><name><surname>Lush</surname><given-names>S</given-names></name><name><surname>Cinat</surname><given-names>M</given-names></name></person-group><article-title>Predictors of morbidity and mortality in patients with traumatic duodenal injuries</article-title><source>Am Surg</source><year>2005</year><volume>71</volume><fpage>763</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">16468514</pub-id></element-citation></ref></ref-list></back></article>