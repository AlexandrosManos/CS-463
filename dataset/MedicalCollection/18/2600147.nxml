gn="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1">	Type b</td><td valign="top" align="center" rowspan="1" colspan="1">4</td><td valign="top" align="center" rowspan="1" colspan="1">0&#x02028;(0&#x02013;0)</td><td valign="top" align="center" rowspan="1" colspan="1">0.7</td><td valign="top" align="center" rowspan="1" colspan="1">0.7</td><td valign="top" align="center" rowspan="1" colspan="1">0.8</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">0.8</td><td valign="top" align="center" rowspan="1" colspan="1">0</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1">0.7</td><td valign="top" align="center" rowspan="1" colspan="1">0.7</td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1">	Non-b<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">10<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">22&#x02028;(0&#x02013;71)<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">1.8<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">1.3<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">2.3<hr/></td><td valign="top" align="left" rowspan="1" colspan="1"><hr/></td><td valign="top" align="center" rowspan="1" colspan="1">2.0<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">0<hr/></td><td valign="top" align="left" rowspan="1" colspan="1"><hr/></td><td valign="top