itation citation-type="journal"><person-group person-group-type="author"><name><surname>Carr</surname><given-names>A</given-names></name><name><surname>Samaras</surname><given-names>K</given-names></name><name><surname>Chisholm</surname><given-names>DJ</given-names></name><name><surname>Cooper</surname><given-names>DA</given-names></name></person-group><article-title>Pathogenesis of HIV-1-protease inhibitor-associated peripheral lipodystrophy, hyperlipidaemia, and insulin resistance</article-title><source><italic>The Lancet</italic></source><year>1998</year><volume>351</volume><issue>9119</issue><fpage>1881</fpage><lpage>1883</lpage></citation></ref><ref id="B6"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nolan</surname><given-names>D</given-names></name><name><surname>John</surname><given-names>M</given-names></name><name><surname>Mallal</surname><given-names>S</given-names></name></person-group><article-title>Antiretoviral therapy and the lipodystrophy syndrome, part 2: concepts in aetiopathogenesis</article-title><source><italic>Antiviral Therapy</italic></source><year>2001</year><volume>6</volume><issue>3</issue><fpage>145</fpage><lpage>160</lpage><pub-id pub-id-type="pmid">11808750</pub-id></citation></ref><ref id="B7"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mallon</surname><given-names>PWG</given-names></name><name><surname>Unemori</surname><given-names>P</given-names></name><name><surname>Sedwell</surname><given-names>R</given-names></name><etal/></person-group><article-title>In vivo, nucleoside reverse-transcriptase inhibitors alter expression of both mitochondrial and lipid metabolism genes in the absence of depletion of mitochondrial DNA</article-title><source><italic>Journal of Infectious Diseases</italic></source><year>2005</year><volume>191</volume><issue>10</issue><fpage>1686</fpage><lpage>1696</lpage><pub-id pub-id-type="pmid">15838796</pub-id></citation></ref><ref id="B8"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Miller</surname><given-names>J</given-names></name><name><surname>Carr</surname><given-names>A</given-names></name><name><surname>Emery</surname><given-names>S</given-names></name><etal/></person-group><article-title>HIV lipodystrophy: prevalence, severity and correlates of risk in Australia</article-title><source><italic>HIV Medicine</italic></source><year>2003</year><volume>4</volume><issue>3</issue><fpage>293</fpage><lpage>301</lpage><pub-id pub-id-type="pmid">12859330</pub-id></citation></ref><ref id="B9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kotler</surname><given-names>DP</given-names></name><name><surname>Wang</surname><given-names>J</given-names></name><name><surname>Pierson</surname><given-names>RN</given-names><suffix>Jr.</suffix></name></person-group><article-title>Body composition studies in patients with the acquired immunodeficiency syndrome</article-title><source><italic>American Journal of Clinical Nutrition</italic></source><year>1985</year><volume>42</volume><issue>6</issue><fpage>1255</fpage><lpage>1265</lpage><pub-id pub-id-type="pmid">3865530</pub-id></citation></ref><ref id="B10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ott</surname><given-names>M</given-names></name><name><surname>Lembcke</surname><given-names>B</given-names></name><name><surname>Fischer</surname><given-names>H</given-names></name><etal/></person-group><article-title>Early changes of body composition in human immunodeficiency virus-infected patients: tetrapolar body impedance analysis indicates significant malnutrition</article-title><source><italic>American Journal of Clinical Nutrition</italic></source><year>1993</year><volume>57</volume><issue>1</issue><fpage>15</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">8416658</pub-id></citation></ref><ref id="B11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Visnegarwala</surname><given-names>F</given-names></name><name><surname>Raghavan</surname><given-names>SS</given-names></name><name><surname>Mullin</surname><given-names>CM</given-names></name><etal/></person-group><article-title>Sex differences in the associations of HIV disease characteristics and body composition in antiretroviral-naive persons</article-title><source><italic>American Journal of Clinical Nutrition</italic></source><year>2005</year><volume>82</volume><issue>4</issue><fpage>850</fpage><lpage>856</lpage><pub-id pub-id-type="pmid">16210716</pub-id></citation></ref><ref id="B12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grunfeld</surname><given-names>C</given-names></name><name><surname>Kotler</surname><given-names>DP</given-names></name><name><surname>Hamadeh</surname><given-names>R</given-names></name><name><surname>Tierney</surname><given-names>A</given-names></name><name><surname>Wang</surname><given-names>J</given-names></name><name><surname>Pierson</surname><given-names>RN</given-names><suffix>Jr.</suffix></name></person-group><article-title>Hypertriglyceridemia in acquired immunodeficiency syndrome</article-title><source><italic>The American Journal of Medicine</italic></source><year>1989</year><volume>86</volume><issue>1</issue><fpage>27</fpage><lpage>31</lpage><pub-id pub-id-type="pmid">2910092</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Peck</surname><given-names>MD</given-names></name><name><surname>Mantero-Atienza</surname><given-names>E</given-names></name><name><surname>Miguez-Burbano</surname><given-names>MJ</given-names></name><etal/></person-group><article-title>The esterified plasma fatty acid profile is altered in early HIV-1 infection</article-title><source><italic>Lipids</italic></source><year>1993</year><volume>28</volume><issue>7</issue><fpage>593</fpage><lpage>597</lpage><pub-id pub-id-type="pmid">8355587</pub-id></citation></ref><ref id="B14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van der Valk</surname><given-names>M</given-names></name><name><surname>Reiss</surname><given-names>P</given-names></name><name><surname>van Leth</surname><given-names>FC</given-names></name><etal/></person-group><article-title>Highly active antiretroviral therapy-induced lipodystrophy has minor effects on human immunodeficiency virus-induced changes in lipolysis, but normalizes resting energy expenditure</article-title><source><italic>The Journal of Clinical Endocrinology &#x00026; Metabolism</italic></source><year>2002</year><volume>87</volume><issue>11</issue><fpage>5066</fpage><lpage>5071</lpage><pub-id pub-id-type="pmid">12414873</pub-id></citation></ref><ref id="B15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Balasubramanyam</surname><given-names>A</given-names></name><name><surname>Mersmann</surname><given-names>H</given-names></name><name><surname>Jahoor</surname><given-names>F</given-names></name><etal/></person-group><article-title>Effects of transgenic expression of HIV-1 Vpr on lipid and energy metabolism in mice</article-title><source><italic>American Journal of Physiology</italic></source><year>2007</year><volume>292</volume><issue>1</issue><fpage>E40</fpage><lpage>E48</lpage><pub-id pub-id-type="pmid">16882932</pub-id></citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vidal-Puig</surname><given-names>AJ</given-names></name><name><surname>Considine</surname><given-names>RV</given-names></name><name><surname>Jimenez-Li&#x000f1;an</surname><given-n