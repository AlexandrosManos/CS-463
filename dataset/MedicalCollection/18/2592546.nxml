th.</article-title><source>Mol Cancer Ther</source><volume>6</volume><fpage>1641</fpage><lpage>1649</lpage><pub-id pub-id-type="pmid">17513612</pub-id></citation></ref><ref id="pone.0003909-Lin1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lin</surname><given-names>Y</given-names></name><name><surname>Choksi</surname><given-names>S</given-names></name><name><surname>Shen</surname><given-names>HM</given-names></name><name><surname>Yang</surname><given-names>QF</given-names></name><name><surname>Hur</surname><given-names>GM</given-names></name><etal/></person-group><year>2004</year><article-title>Tumor necrosis factor-induced nonapoptotic cell death requires receptor-interacting protein-mediated cellular reactive oxygen species accumulation.</article-title><source>J Biol Chem</source><volume>279</volume><fpage>10822</fpage><lpage>10828</lpage><pub-id pub-id-type="pmid">14701813</pub-id></citation></ref><ref id="pone.0003909-VandenBerghe1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vanden Berghe</surname><given-names>T</given-names></name><name><surname>van Loo</surname><given-names>G</given-names></name><name><surname>Saelens</surname><given-names>X</given-names></name><name><surname>Van Gurp</surname><given-names>M</given-names></name><name><surname>Brouckaert</surname><given-names>G</given-names></name><etal/></person-group><year>2004</year><article-title>Differential signaling to apoptotic and necrotic cell death by Fas-associated death domain protein FADD.</article-title><source>J Biol Chem</source><volume>279</volume><fpage>7925</fpage><lpage>7933</lpage><pub-id pub-id-type="pmid">14668343</pub-id></citation></ref><ref id="pone.0003909-Lewis1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lewis</surname><given-names>J</given-names></name><name><surname>Devin</surname><given-name