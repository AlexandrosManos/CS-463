0026; Hall; <year>1991</year></citation></ref><ref id="R9"><label>9. </label><citation citation-type="journal"><string-name><surname>Austin</surname> <given-names>DJ</given-names></string-name>, <string-name><surname>Bonten</surname> <given-names>MJ</given-names></string-name>, <string-name><surname>Weinstein</surname> <given-names>RA</given-names></string-name>, <string-name><surname>Slaughter</surname> <given-names>S</given-names></string-name>, <string-name><surname>Anderson</surname> <given-names>RM</given-names></string-name> <article-title>Vancomycin-resistant enterococci in intensive-care hospital settings: transmission dynamics, persistence, and the impact of infection control programs.</article-title><source>Proc Natl Acad Sci U S A</source> <year>1999</year>;<volume>96</volume>:<fpage>6908</fpage>&#x02013;<lpage>13</lpage> <pub-id pub-id-type="doi">10.1073/pnas.96.12.6908</pub-id><pub-id pub-id-type="pmid">10359812</pub-id></citation></ref></ref-list></back></article>