ge><pub-id pub-id-type="pmid">18313129</pub-id></citation></ref><ref id="b14-ehp-116-1725"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lin</surname><given-names>S</given-names></name><name><surname>Fitzgerald</surname><given-names>E</given-names></name><name><surname>Hwang</surname><given-names>SA</given-names></name><name><surname>Munsie</surname><given-names>JP</given-names></name><name><surname>Stark</surname><given-names>A</given-names></name></person-group><year>1999</year><article-title>Asthma hospitalization rates and socioeconomic status in New York State (1987&#x02013;1993)</article-title><source>J Asthma</source><volume>36</volume><fpage>239</fpage><lpage>251</lpage><pub-id pub-id-type="pmid">10350220</pub-id></citation></ref><ref id="b15-ehp-116-1725"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McConnell</surname><given-names>R</given-names></name><name><surname>Berhane</surname><given-names>K</given-names></name><name><surname>Gilliland</surname><given-names>F</given-names></name><name><surname>London</surname><given-names>SJ</given-names></name><name><surname>Islam</surname><given-names>T</given-names></name><name><surname>Gauderman</surname><given-names>WJ</given-names></name><etal/></person-group><year>2002</year><article-title>Asthma in exercising children exposed to ozone: a cohort study</article-title><source>Lancet</source><volume>359</volume><fpage>386</fpage><lpage>391</lpage><pub-id pub-id-type="pmid">11844508</pub-id></citation></ref><ref id="b16-ehp-116-1725"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morgenstern</surname><given-names>V</given-names></name><name><surname>Zutavern</surname><given-names>A</given-names></name><name><surname>Cyrys</surname><given-names>J</given-names></name><name><surname>Brockow</surname><given-names>I</given-names></name><name><surname>Koletzko</surname><given-names>S</given