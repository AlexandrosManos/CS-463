ce><volume>78</volume><fpage>13232</fpage><lpage>13252</lpage><pub-id pub-id-type="pmid">15542675</pub-id></citation></ref><ref id="pone.0003937-Ferrantelli3"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferrantelli</surname><given-names>F</given-names></name><name><surname>Kitabwalla</surname><given-names>M</given-names></name><name><surname>Rasmussen</surname><given-names>RA</given-names></name><name><surname>Cao</surname><given-names>C</given-names></name><name><surname>Chou</surname><given-names>TC</given-names></name><etal/></person-group><year>2004</year><article-title>Potent cross-group neutralization of primary human immunodeficiency virus isolates with monoclonal antibodies&#x02013;implications for acquired immunodeficiency syndrome vaccine.</article-title><source>J Infect Dis</source><volume>189</volume><fpage>71</fpage><lpage>74</lpage><pub-id pub-id-type="pmid">14702155</pub-id></citation></ref><ref id="pone.0003937-Kitabwalla1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kitabwalla</surname><given-names>M</given-names></name><name><surname>Ferrantelli</surname><given-names>F</given-names></name><name><surname>Wang</surname><given-names>T</given-names></name><name><surname>Chalmers</surname><given-names>A</given-names></name><name><surname>Katinger</surname><given-names>H</given-names></name><etal/></person-group><year>2003</year><article-title>Primary African HIV clade A and D isolates: effective cross-clade neutralization with a quadruple combination of human monoclonal antibodies raised against clade B.</article-title><source>AIDS Res Hum Retroviruses</source><volume>19</volume><fpage>125</fpage><lpage>131</lpage><pub-id pub-id-type="pmid">12639248</pub-id></citation></ref><ref id="pone.0003937-Xu1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Xu</surname><given-names