-type="pmid">15911195</pub-id><pub-id pub-id-type="doi">10.1016/j.pec.2004.06.002</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ring</surname><given-names>A</given-names></name><name><surname>Dowrick</surname><given-names>CF</given-names></name><name><surname>Humphris</surname><given-names>GM</given-names></name><name><surname>Davies</surname><given-names>J</given-names></name><name><surname>Salmon</surname><given-names>P</given-names></name></person-group><article-title>The somatising effect of clinical consultation: What patients and doctors say and do not say when patients present medically unexplained physical symptoms</article-title><source>Soc Sci Med</source><year>2005</year><volume>61</volume><fpage>1505</fpage><lpage>1515</lpage><pub-id pub-id-type="pmid">15922499</pub-id><pub-id pub-id-type="doi">10.1016/j.socscimed.2005.03.014</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Salmon</surname><given-names>P</given-names></name><name><surname>Ring</surname><given-names>A</given-names></name><name><surname>Dowrick</surname><given-names>CF</given-names></name><name><surname>Humphris</surname><given-names>GM</given-names></name></person-group><article-title>What do general practice patients want when they present medically unexplained symptoms, and why do their doctors feel pressurized?</article-title><source>J Psychosom Res</source><year>2005</year><volume>59</volume><fpage>255</fpage><lpage>260</lpage><pub-id pub-id-type="pmid">16223629</pub-id><pub-id pub-id-type="doi">10.1016/j.jpsychores.2005.03.004</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Westert</surname><given-names>GP</given-names></name><name><surname>Schellevis</surname><given-names>FG</given-names></name><name><surname>de Bakker</surname><given-names>DH</g