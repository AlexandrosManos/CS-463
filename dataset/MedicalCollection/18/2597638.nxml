iors</article-title><source>Neuropsychopharmacology</source><volume>32</volume><fpage>2173</fpage><lpage>83</lpage><year>2007</year><pub-id pub-id-type="pmid">17299510</pub-id></citation></ref><ref id="R25"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chhatwal</surname><given-names>JP</given-names></name><name><surname>Hammack</surname><given-names>SE</given-names></name><name><surname>Jasnow</surname><given-names>AM</given-names></name><name><surname>Rainnie</surname><given-names>DG</given-names></name><name><surname>Ressler</surname><given-names>KJ</given-names></name></person-group><article-title>Identification of cell-type-specific promoters within the brain using lentiviral vectors</article-title><source>Gene Ther</source><volume>14</volume><fpage>575</fpage><lpage>83</lpage><year>2007</year><pub-id pub-id-type="pmid">17235291</pub-id></citation></ref><ref id="R26"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chhatwal</surname><given-names>JP</given-names></name><name><surname>Stanek-Rattiner</surname><given-names>L</given-names></name><name><surname>Davis</surname><given-names>M</given-names></name><name><surname>Ressler</surname><given-names>KJ</given-names></name></person-group><article-title>Amygdala BDNF signaling is required for consolidation but not encoding of extinction</article-title><source>Nat Neurosci</source><volume>9</volume><fpage>870</fpage><lpage>2</lpage><year>2006</year><pub-id pub-id-type="pmid">16783370</pub-id></citation></ref><ref id="R27"><label>27</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heldt</surname><given-names>SA</given-names></name><name><surname>Stanek</surname><given-names>L</given-names></name><name><surname>Chhatwal</surname><given-names>JP</given-names></name><name><surname>Ressler</surname><given-names>KJ</given-names></name></person-group><articl