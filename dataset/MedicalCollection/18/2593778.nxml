up-type="author"><name><surname>Christmann</surname><given-names>A</given-names></name><name><surname>Moes</surname><given-names>D</given-names></name><name><surname>Himmelbach</surname><given-names>A</given-names></name><name><surname>Yang</surname><given-names>Y</given-names></name><name><surname>Tang</surname><given-names>Y</given-names></name><etal/></person-group><year>2006</year><article-title>Integration of abscisic acid signalling into plant responses.</article-title><source>Plant Biol (Stuttg)</source><volume>8</volume><fpage>314</fpage><lpage>325</lpage><pub-id pub-id-type="pmid">16807823</pub-id></citation></ref><ref id="pone.0003935-DeSmet1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Smet</surname><given-names>I</given-names></name><name><surname>Zhang</surname><given-names>H</given-names></name><name><surname>Inze</surname><given-names>D</given-names></name><name><surname>Beeckman</surname><given-names>T</given-names></name></person-group><year>2006</year><article-title>A novel role for abscisic acid emerges from underground.</article-title><source>Trends Plant Sci</source><volume>11</volume><fpage>434</fpage><lpage>439</lpage><pub-id pub-id-type="pmid">16890475</pub-id></citation></ref><ref id="pone.0003935-Leung1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leung</surname><given-names>J</given-names></name><name><surname>Giraudat</surname><given-names>J</given-names></name></person-group><year>1998</year><article-title>Abscisic Acid Signal Transduction.</article-title><source>Annu Rev Plant Physiol Plant Mol Biol</source><volume>49</volume><fpage>199</fpage><lpage>222</lpage><pub-id pub-id-type="pmid">15012233</pub-id></citation></ref><ref id="pone.0003935-Bruzzone1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bruzzone</surname><given-names>S</given-names></name><name><surname>Moreschi</surname><given-names>I</given-names></name><name><surname>Usai</surname><given-names>C</given-names></name><name><surname>Guida</surname><given-names>L</given-names></name><name><surname>Damonte</surname><given-names>G</given-names></name><etal/></person-group><year>2007</year><article-title>Abscisic acid is an endogenous cytokine in human granulocytes with cyclic ADP-ribose as second messenger.</article-title><source>Proc Natl Acad Sci U S A</source><volume>104</volume><fpage>5759</fpage><lpage>5764</lpage><pub-id pub-id-type="pmid">17389374</pub-id></citation></ref><ref id="pone.0003935-Nagamune1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nagamune</surname><given-names>K</given-names></name><name><surname>Hicks</surname><given-names>LM</given-names></name><name><surname>Fux</surname><given-names>B</given-names></name><name><surname>Brossier</surname><given-names>F</given-names></name><name><surname>Chini</surname><given-names>EN</given-names></name><etal/></person-group><year>2008</year><article-title>Abscisic acid controls calcium-dependent egress and development in Toxoplasma gondii.</article-title><source>Nature</source><volume>451</volume><fpage>207</fpage><lpage>210</lpage><pub-id pub-id-type="pmid">18185591</pub-id></citation></ref><ref id="pone.0003935-Zocchi1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zocchi</surname><given-names>E</given-names></name><name><surname>Carpaneto</surname><given-names>A</given-names></name><name><surname>Cerrano</surname><given-names>C</given-names></name><name><surname>Bavestrello</surname><given-names>G</given-names></name><name><surname>Giovine</surname><given-names>M</given-names></name><etal/></person-group><year>2001</year><article-title>The temperature-signaling cascade in sponges involves a heat-gated cation channel, abscisic acid, and cyclic ADP-ribose.</article-ti