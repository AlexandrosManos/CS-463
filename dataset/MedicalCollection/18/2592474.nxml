ear><volume>151</volume><fpage>1029</fpage><lpage>1035</lpage><pub-id pub-id-type="pmid">10853642</pub-id></citation></ref><ref id="b16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rowe</surname><given-names>AK</given-names></name><name><surname>Onikpo</surname><given-names>F</given-names></name><name><surname>Lama</surname><given-names>M</given-names></name><name><surname>Cokou</surname><given-names>F</given-names></name><name><surname>Deming</surname><given-names>MS</given-names></name></person-group><article-title>Management of childhood illness at health facilities in Benin: problems and their causes</article-title><source>American Journal of Public Health</source><year>2001</year><volume>91</volume><fpage>1625</fpage><lpage>1635</lpage><pub-id pub-id-type="pmid">11574325</pub-id></citation></ref><ref id="b17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rowe</surname><given-names>AK</given-names></name><name><surname>Onikpo</surname><given-names>F</given-names></name><name><surname>Lama</surname><given-names>M</given-names></name><name><surname>Deming</surname><given-names>MS</given-names></name></person-group><article-title>Risk and protective factors for two types of error in the treatment of children with fever at outpatient health facilities in Benin</article-title><source>International Journal of Epidemiology</source><year>2003</year><volume>32</volume><fpage>296</fpage><lpage>303</lpage><pub-id pub-id-type="pmid">12714553</pub-id></citation></ref><ref id="b18"><citation citation-type="book"><collab>World Health Organisation (WHO)</collab><source>Interventions and Strategies to Improve the Use of Antimicrobials in Developing Countries. Drug Management Programme</source><year>2001</year><publisher-loc>Geneva</publisher-loc><publisher-name>WHO</publisher-name><comment>(WHO/CDS/CSR/DRS/2001.9)</comment></citation></ref><ref id="b19"><citation citation-type="book"><collab>World Health Organisation (WHO)</collab><source>Guidelines for the Treatment of Malaria. Global Malaria Programme</source><year>2006</year><publisher-loc>Geneva</publisher-loc><publisher-name>WHO</publisher-name><comment>(WHO/HTM/MAL/2006.1108)</comment></citation></ref><ref id="b20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zurovac</surname><given-names>D</given-names></name><name><surname>Rowe</surname><given-names>AK</given-names></name></person-group><article-title>Quality of treatment for febrile illness among children at outpatient facilities in sub-Saharan Africa</article-title><source>Annals of Tropical Medicine and Parasitology</source><year>2006</year><volume>100</volume><fpage>283</fpage><lpage>296</lpage><pub-id pub-id-type="pmid">16762109</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zurovac</surname><given-names>D</given-names></name><name><surname>Rowe</surname><given-names>A</given-names></name><name><surname>Ochola</surname><given-names>S</given-names></name><name><surname>Midia</surname><given-names>B</given-names></name><name><surname>English</surname><given-names>M</given-names></name><name><surname>Snow</surname><given-names>RW</given-names></name></person-group><article-title>Predictors of the quality of health worker treatment practices for uncomplicated malaria at government health facilities in Kenya</article-title><source>International Journal of Epidemiology</source><year>2004</year><volume>33</volume><fpage>1080</fpage><lpage>1091</lpage><pub-id pub-id-type="pmid">15256523</pub-id></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zurovac</surname><given-names>D</given-names></name><name><surname>Ndhlovu</surname><given-names>M</given-names></name><name><surname>Rowe</surname><given-names>AK</given-names></name><name><surname>Hamer</surname><given-names>DH</given-names></name><name><surname>Thea</surname><given-names>DM</given-names></name><name><surname>Snow</surname><given-names>RW</given-names></name></person-group><article-title>Treatment of paediatric malaria during a period of drug transition to artemether&#x02013;lumefantrine in Zambia: cross sectional study</article-title><source>British Medical Journal</source><year>2005a</year><volume>33</volume><fpage>734</fpage><lpage>737</lpage></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zurovac</surname><given-names>D</given-names></name><name><surname>Ochola</surname><given-names>S</given-names></name><name><surname>Midia</surname><given-names>B</given-names></name><name><surname>Snow</surname><given-names>RW</given-names></name></person-group><article-title>The quality of sulfadoxine&#x02013;pyrimethamine prescriptions, counselling and drug dispensing practices for children in Kenya</article-title><source>Annals of Tropical Medicine and Parasitology</source><year>2005b</year><volume>99</volume><fpage>321</fpage><lpage>324</lpage><pub-id pub-id-type="pmid">15829140</pub-id></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zurovac</surname><given-names>D</given-names></name><name><surname>Ndhlovu</surname><given-names>M</given-names></name><name><surname>Sipilanyambe</surname><given-names>N</given-names></name><etal/></person-group><article-title>Paediatric malaria case-management with artemether&#x02013;lumefantrine in Zambia: a repeat cross-sectional study</article-title><source>Malaria Journal</source><year>2007</year><volume>6</volume><fpage>31</fpage><pub-id pub-id-type="pmid">17367518</pub-id></citation></ref></ref-list></back></article>