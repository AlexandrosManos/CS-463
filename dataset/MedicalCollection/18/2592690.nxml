citation></ref><ref id="R18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hollis</surname><given-names>A.</given-names></name></person-group><source>Bio-generics and Prize Systems</source><year>2006</year><comment>Washington. CPTech. &#x0003c;<uri xlink:type="simple">http://www.cptech.org/blogs/drugdevelopment/2006_07_01_archive.html</uri>&#x0003e; at 28 February 2007</comment></citation></ref><ref id="R19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hollis</surname><given-names>A.</given-names></name></person-group><article-title>The Health Impact Fund: A Useful Supplement to the Patent System?</article-title><source>Public Health Ethics</source><year>2008</year><comment>forthcoming</comment></citation></ref><ref id="R20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hubbard</surname><given-names>T.</given-names></name><name><surname>Love</surname><given-names>J.</given-names></name></person-group><article-title>A New Trade Framework for Global Healthcare R&#x00026;D</article-title><source>PLoS Biology</source><year>2004</year><volume>2</volume><fpage>147</fpage><lpage>156</lpage></citation></ref><ref id="R21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kolitch</surname><given-names>S.</given-names></name></person-group><article-title>The Environmental and Public Health Impacts of U.S. Patent Law: Making the Case for Incorporating a Precautionary Principle</article-title><source>Environmental Law</source><year>2006</year><volume>36</volume><fpage>221</fpage><lpage>256</lpage></citation></ref><ref id="R22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Love</surname><given-names>J.</given-names></name></person-group><source>Modelling Prize Fund Rewards</source><year>2006</year><publisher-loc>Washington</publisher-loc><publisher-name>CPTech</publisher-name><comment>&#x0003c;<uri xlink:type="simple">http://www.cptech.org/blogs/drugdevelopment/2006_07_01_archive.html</uri>&#x0003e; at 28 February 2007</comment></citation></ref><ref id="R23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>MacDonald</surname><given-names>T. H.</given-names></name></person-group><source>Health, Trade and Human Rights</source><year>2006</year><publisher-loc>Oxford</publisher-loc><publisher-name>Radcliffe Publishing</publisher-name></citation></ref><ref id="R24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martin</surname><given-names>G.</given-names></name><name><surname>Sorenson</surname><given-names>C.</given-names></name><name><surname>Faunce</surname><given-names>T.</given-names></name></person-group><article-title>Balancing Intellectual Monopoly Privileges and the Need for Essential Medicines</article-title><source>Globalization and Health</source><year>2007</year><fpage>3</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">17524147</pub-id></citation></ref><ref id="R25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Noehrenberg</surname><given-names>E.</given-names></name></person-group><article-title>Report of the Commission on Intellectual Property Rights, Innovation and Public Health: an industry perspective&#x02019;</article-title><source>Bulletin of the World Health Organization</source><year>2006</year><volume>84</volume><fpage>419</fpage><lpage>425</lpage><pub-id pub-id-type="pmid">16710557</pub-id></citation></ref><ref id="R26"><citation citation-type="journal"><collab>Anonymous</collab><article-title>Discretion and Legitimacy in International Regulation</article-title><source>Harvard Law Review</source><year>1993&#x02013;1994</year><volume>107</volume><fpage>1099</fpage><lpage>1116</lpage></citation></ref><ref id="R27"><citation citation-type="book"><collab>Oxford Economic Research Associates (OXERA)</collab><source>Fundamental Review of the Generic Drugs Market. Phase II</source><year>2001</year><publisher-loc>London</publisher-loc><publisher-name>United Kingdom Department of Health</publisher-name></citation></ref><ref id="R28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parsi</surname><given-names>K.</given-names></name><name><surname>Egan</surname><given-names>E.</given-names></name></person-group><article-title>Patents: The Public Interest versus the Private Privilege</article-title><source>American Journal of Bioethics</source><year>2002</year><volume>2</volume><fpage>45</fpage><lpage>52</lpage><pub-id pub-id-type="pmid">12230857</pub-id></citation></ref><ref id="R29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pogge</surname><given-names>T.</given-names></name></person-group><article-title>Human Rights and Global Health: A Research Program</article-title><source>Metaphilosophy</source><year>2005</year><volume>182</volume><comment>(Issue <bold>36</bold>(1/2), at p. 184</comment></citation></ref><ref id="R30"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Pogge</surname><given-names>T.</given-names></name></person-group><source>A New Approach to Pharmaceutical Innovations</source><year>2006</year><comment>Online Opinion E-Journal &#x0003c;<uri xlink:type="simple">http://www.onlineopinion.com.au/view.asp?article=3559</uri>&#x0003e; at 7 October 2006</comment></citation></ref><ref id="R31"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Pogge</surname><given-names>T.</given-names></name></person-group><source>World Poverty and Human Rights</source><year>2008</year><edition>2nd ed.</edition><publisher-loc>Cambridge, MA</publisher-loc><publisher-name>Polity</publisher-name></citation></ref><ref id="R32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Presma</surname><given-names>F.</given-names></name></person-group><article-title>Treaty proposal addresses problem of global access to essential medicines</article-title><source>Duke Law Magazine</source><year>2005</year><volume>23</volume><fpage>15</fpage><lpage>21</lpage><comment>&#x0003c;<uri xlink:type="simple">http://www.law.duke.edu/news/pdf/lawmagspr05.pdf</uri>&#x0003e; at 11 March 2007</comment></citation></ref><ref id="R33"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ravvin</surname><given-names>M.</given-names></name></person-group><article-title>Incentivising Access and Innovation for Essential Medicines: A Survey of the Problems and Proposed Solutions</article-title><source>Public Health Ethics</source><year>2008</year><comment>forthcoming</comment></citation></ref><ref id="R34"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Sell</surname><given-names>S. K.</given-names></name></person-group><source>Private Power, Public Law: The Globalisation of Intellectual Property Rights</source><year>2003</year><publisher-loc>Cambridge, MA</publisher-loc><publisher-name>Cambridge University Press</publisher-name></citation></ref><ref id="R35"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Sen</surname><given-names>A.</given-names></name></person-group><source>Development as Freedom</source><year>1999</year><publisher-loc>Oxford</publisher-loc><publisher-name>Oxford University Press</publisher-name></citation></ref><ref id="R36"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shaffer</surname><given-names>E.</given-names></name><name><surname>Waitzkin</surname><given-names>H.</given-names></name><name><surname>Brenner</surname><given-names>J.</given-names></name><name><surname>Jasso-Aguilar</surname><given-names>R.</given-names></name></person-group><article-title>Global Trade and Public Health</article-title><source>American Journal of Public Health</source><year>2005</year><volume>95</volume><fpage>23</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">15623854</pub-id></citation></ref><ref id="R37"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shaffer</surname><given-names>E. R.</given-names></name><name><surname>Brenner</surname><given-names>J. E.</given-names></name></person-group><article-title>International Trade Agreements: Hazards to Health?</article-title><source>International Journal of Health Services</source><year>2004</year><volume>34</volume><fpage>467</fpage><lpage>481</lpage><pub-id pub-id-type="pmid">15346681</pub-id></citation></ref><ref id="R38"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stiglitz</surname><given-names>J.</given-names></name></person-group><article-title>Give Prizes Not Patents</article-title><source>New Scientist</source><year>2006a</year><comment>16 September: 21</comment></citation></ref><ref id="R39"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stiglitz</surname><given-names>J.</given-names></name></person-group><article-title>Scrooge and Intellectual Property Rights</article-title><source>British Medical Journal</source><year>2006b</year><volume>333</volume><fpage>1279</fpage><lpage>1280</lpage><pub-id pub-id-type="pmid">17185703</pub-id></citation></ref><ref id="R40"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wallach</surname><given-names>L.</given-names></name><name><surname>Sforza</surname><given-names>M.</given-names></name></person-group><source>The WTO: Five Years of Reasons to Resist Corporate Globalization</source><year>1999</year><publisher-loc>New York</publisher-loc><publisher-name>Seven Stories Press</publisher-name></citation></ref><ref id="R41"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wei</surname><given-names>M.</given-names></name></person-group><article-title>Should Prizes Replace Patents? A Critique of the Medical Innovation Prize Act of 2005</article-title><source>B.U.J. Sci &#x00026; Tech. L</source><year>2007</year><comment>(working paper): 5&#x02013;15. Accessible at: &#x0003c;<uri xlink:type="simple">http://www.cptech.org/ip/health/prizefund/other-articles.html</uri>&#x0003e; Accessed 26 March 2007</comment></citation></ref><ref id="R42"><citation citation-type="book"><collab>World Health Organization, Executive Board</collab><source>Global framework on essential health research and development (Draft Resolution proposed by Brazil and Kenya)</source><year>2006</year><comment>EB117/Conf.Paper No. 3 117th Session, Agenda item 4.10</comment></citation></ref></ref-list></back></article>