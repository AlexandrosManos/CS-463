<source>Am J Med</source> <year>1991</year>;<volume>91</volume>:<fpage> S329</fpage>&#x02013;<lpage> S33</lpage> <pub-id pub-id-type="doi">10.1016/0002-9343(91)90391-A</pub-id><pub-id pub-id-type="pmid">1928189</pub-id></citation></ref><ref id="R9"><label>9. </label><citation citation-type="journal"><string-name><surname>Paul</surname> <given-names>SM</given-names></string-name>, <string-name><surname>Genese</surname> <given-names>C</given-names></string-name>, <string-name><surname>Spitalny</surname> <given-names>K</given-names></string-name> <article-title>Postoperative group A beta-hemolytic <italic>Streptococcus</italic> outbreak with the pathogen traced to a member of a healthcare worker's household.</article-title><source>Infect Control Hosp Epidemiol</source> <year>1990</year>;<volume>11</volume>:<fpage>643</fpage>&#x02013;<lpage>6</lpage><pub-id pub-id-type="pmid">2273228</pub-id></citation></ref><ref id="R10"><label>10. </label><citation citation-type="journal"><string-name><surname>Schaffner</surname> <given-names>W</given-names></string-name>, <string-name><surname>Lefkowitz</surname> <given-names>LB</given-names> <suffix>Jr</suffix></string-name>, <string-name><surname>Goodman</surname> <given-names>JS</given-names></string-name>, <string-name><surname>Koenig</surname> <given-names>MG</given-names></string-name> <article-title>Hospital outbreak of infections with group A streptococci traced to an asymptomatic anal carrier.</article-title><source>N Engl J Med</source> <year>1969</year>;<volume>280</volume>:<fpage>1224</fpage>&#x02013;<lpage>5</lpage><pub-id pub-id-type="pmid">4889553</pub-id></citation></ref></ref-list></back></article>