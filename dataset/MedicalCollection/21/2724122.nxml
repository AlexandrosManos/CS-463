13.2</td><td align="char">&#x02212;53.5</td></tr><tr><td align="left">Fresh kidney</td><td align="char">33.7</td><td align="char">6.5</td><td align="char">5.2</td><td/><td/><td/></tr><tr><td align="left">5&#x000a0;min at 4&#x000a0;&#x000b0;C</td><td align="char">29.2</td><td align="char">7.8</td><td align="char">3.7</td><td align="char">&#x02212;13.2</td><td align="char">19.4</td><td align="char">&#x02212;27.7</td></tr><tr><td align="left">15 min at 4&#x000a0;&#x000b0;C</td><td align="char">29.6</td><td align="char">8.9</td><td align="char">3.3</td><td align="char">&#x02212;12.1</td><td align="char">36.8</td><td align="char">&#x02212;36.1</td></tr></tbody></table></table-wrap><table-wrap id="tbl5" position="float"><label>Table 5</label><caption><p>SAM and SAH levels in mice tissues (male C57BL/6J, aged 3&#x02013;4 months).</p></caption><table frame="hsides" rules="groups"><thead><tr><th/><th align="left"><italic>N</italic></th><th align="left">nmol/g wet weight<hr/></th><th align="left">SD<hr/></th><th align="left">nmol/g wet weight<hr/></th><th align="left">SD<hr/></th></tr><tr><th/><th/><th colspan="2" align="left">SAM</th><th colspan="2" align="left">SAH</th></tr></thead><tbody><tr><td align="left">Liver</td><td align="char">4</td><td align="char">58.3</td><td align="char">3.2</td><td align="char">33.3</td><td align="char">6.1</td></tr><tr><td align="left">Kidney</td><td align="char">4</td><td align="char">33.7</td><td align="char">3.1</td><td align="char">6.9</td><td align="char">0.5</td></tr></tbody></table></table-wrap></floats-group></article>