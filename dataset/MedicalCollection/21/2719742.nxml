-name></citation><citation citation-type="display-unstructured">Last JM (2001) A dictionary of epidemiology, 4th edn. Oxford University Press, New York </citation></ref><ref id="CR16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marmot</surname><given-names>MG</given-names></name><name><surname>Smith</surname><given-names>GD</given-names></name><name><surname>Stansfeld</surname><given-names>S</given-names></name><name><surname>Patel</surname><given-names>C</given-names></name><name><surname>North</surname><given-names>F</given-names></name><name><surname>Head</surname><given-names>J</given-names></name><etal/></person-group><article-title>Health inequalities among British civil servants: the Whitehall II study</article-title><source>Lancet</source><year>1991</year><volume>337</volume><fpage>1387</fpage><lpage>1393</lpage><pub-id pub-id-type="doi">10.1016/0140-6736(91)93068-K</pub-id></citation><citation citation-type="display-unstructured">Marmot MG, Smith GD, Stansfeld S, Patel C, North F, Head J et al (1991) Health inequalities among British civil servants: the Whitehall II study. Lancet 337:1387&#x02013;1393. doi:10.1016/0140-6736(91)93068-K <pub-id pub-id-type="pmid">1674771</pub-id></citation></ref><ref id="CR17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morris</surname><given-names>JK</given-names></name><name><surname>Cook</surname><given-names>DG</given-names></name><name><surname>Shaper</surname><given-names>AG</given-names></name></person-group><article-title>Loss of employment and mortality</article-title><source>BMJ</source><year>1994</year><volume>308</volume><fpage>1135</fpage><lpage>1139</lpage></citation><citation citation-type="display-unstructured">Morris JK, Cook DG, Shaper AG (1994) Loss of employment and mortality. BMJ 308:1135&#x02013;1139 <pub-id pub-id-type="pmid">8173455</pub-id></citation></ref><ref id="CR18"><citation citation-type="journal"><perso