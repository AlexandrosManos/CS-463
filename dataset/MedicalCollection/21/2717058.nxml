roup person-group-type="author"><name><surname>Hegewald</surname><given-names>AA</given-names></name><name><surname>Ringe</surname><given-names>J</given-names></name><name><surname>Sittinger</surname><given-names>M</given-names></name><name><surname>Thome</surname><given-names>C</given-names></name></person-group><article-title>Regenerative treatment strategies in spinal surgery</article-title><source>Front Biosci</source><year>2008</year><volume>13</volume><fpage>1507</fpage><lpage>1525</lpage><pub-id pub-id-type="pmid">17981645</pub-id><pub-id pub-id-type="doi">10.2741/2777</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heuer</surname><given-names>F</given-names></name><name><surname>Ulrich</surname><given-names>S</given-names></name><name><surname>Claes</surname><given-names>L</given-names></name><name><surname>Wilke</surname><given-names>HJ</given-names></name></person-group><article-title>Biomechanical evaluation of conventional anulus fibrosus closure methods required for nucleus replacement. Laboratory investigation</article-title><source>J Neurosurg Spine</source><year>2008</year><volume>9</volume><fpage>307</fpage><lpage>313</lpage><pub-id pub-id-type="pmid">18928230</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kettler</surname><given-names>A</given-names></name><name><surname>Liakos</surname><given-names>L</given-names></name><name><surname>Haegele</surname><given-names>B</given-names></name><name><surname>Wilke</surname><given-names>HJ</given-names></name></person-group><article-title>Are the spines of calf, pig and sheep suitable models for pre-clinical implant tests?</article-title><source>Eur Spine J</source><year>2007</year><volume>16</volume><fpage>2186</fpage><lpage>2192</lpage><pub-id pub-id-type="pmid">17721711</pub-id><pub-id pub-id-type="doi">10.1007/s00586-007-0485-9</pub-id></cita