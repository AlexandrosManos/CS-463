><label>12</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Tiihonen</surname><given-names>J</given-names></name><name><surname>Isohanni</surname><given-names>M</given-names></name><name><surname>R&#x000e4;s&#x000e4;nen</surname><given-names>P</given-names></name><name><surname>Koiranen</surname><given-names>M</given-names></name><name><surname>Moring</surname><given-names>J</given-names></name></person-group><year>1997</year><article-title>Specific major mental disorders and criminality: a 26-year prospective study of the 1966 Northern Finland birth cohort.</article-title><source>Am J Psychiatry</source><volume>154</volume><fpage>840</fpage><lpage>845</lpage><pub-id pub-id-type="pmid">9167513</pub-id></mixed-citation></ref><ref id="pmed.1000120-Mullen1"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mullen</surname><given-names>P</given-names></name><name><surname>Burgess</surname><given-names>P</given-names></name><name><surname>Wallace</surname><given-names>C</given-names></name><name><surname>Palmer</surname><given-names>S</given-names></name><name><surname>Ruschena</surname><given-names>D</given-names></name></person-group><year>2000</year><article-title>Community care and criminal offending in schizophrenia.</article-title><source>Lancet</source><volume>355</volume><fpage>614</fpage><lpage>617</lpage><pub-id pub-id-type="pmid">10696982</pub-id></mixed-citation></ref><ref id="pmed.1000120-Steadman1"><label>14</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Steadman</surname><given-names>H</given-names></name><name><surname>Mulvey</surname><given-names>E</given-names></name><name><surname>Monahan</surname><given-names>J</given-names></name><name><surname>Robbins</surname><given-names>P</given-names></name><name><surname>Appelbaum</surname><given-names>P</given-names></name><etal/><