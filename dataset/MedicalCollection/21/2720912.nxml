e>454</fpage><lpage>463</lpage></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chiang</surname><given-names>C</given-names></name><name><surname>Knight</surname><given-names>SG</given-names></name></person-group><article-title>A new pathway of pentose metabolism</article-title><source>Biochemical and Biophysical Research Communications</source><year>1960</year><volume>3</volume><fpage>554</fpage><lpage>559</lpage><pub-id pub-id-type="pmid">13692998</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chiang</surname><given-names>C</given-names></name><name><surname>Knight</surname><given-names>SG</given-names></name></person-group><article-title>L-arabinose metabolism by cell-free extracts of <italic>Penicillium chrysogenum</italic></article-title><source>Biochimica et Biophysica Acta</source><year>1961</year><volume>46</volume><fpage>271</fpage><lpage>278</lpage><pub-id pub-id-type="pmid">13692999</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Witteveen</surname><given-names>CFB</given-names></name><name><surname>Busink</surname><given-names>R</given-names></name><name><surname>Vondervoort</surname><given-names>P van de</given-names></name><name><surname>Dijkema</surname><given-names>C</given-names></name><name><surname>Swart</surname><given-names>K</given-names></name><name><surname>Visser</surname><given-names>J</given-names></name></person-group><article-title>L-arabinose and D-xylose catabolism in <italic>Aspergillus niger</italic></article-title><source>Journal of General and Applied Microbiology</source><year>1989</year><volume>135</volume><fpage>2163</fpage><lpage>2171</lpage></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Englesberg</surname><given-names>E</g