ours</article-title><source><italic>Journal of Clinical Pathology</italic></source><year>2005</year><volume>58</volume><issue>11</issue><fpage>1152</fpage><lpage>1156</lpage><pub-id pub-id-type="pmid">16254103</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Deyrup</surname><given-names>AT</given-names></name><name><surname>Tretiakova</surname><given-names>M</given-names></name><name><surname>Montag</surname><given-names>AG</given-names></name></person-group><article-title>Estrogen receptor-<italic>&#x003b2;</italic> expression in extraabdominal fibromatoses: an analysis of 40 cases</article-title><source><italic>Cancer</italic></source><year>2006</year><volume>106</volume><issue>1</issue><fpage>208</fpage><lpage>213</lpage><pub-id pub-id-type="pmid">16333857</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nishisho</surname><given-names>I</given-names></name><name><surname>Nakamura</surname><given-names>Y</given-names></name><name><surname>Miyoshi</surname><given-names>Y</given-names></name><etal/></person-group><article-title>Mutations of chromosome 5q21 genes in FAP and colorectal cancer patients</article-title><source><italic>Science</italic></source><year>1991</year><volume>253</volume><issue>5020</issue><fpage>665</fpage><lpage>669</lpage><pub-id pub-id-type="pmid">1651563</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Groden</surname><given-names>J</given-names></name><name><surname>Thliveris</surname><given-names>A</given-names></name><name><surname>Samowitz</surname><given-names>W</given-names></name><etal/></person-group><article-title>Identification and characterization of the familial adenomatous polyposis coli gene</article-title><source><italic>Cell</italic></source><year>1991</year><volume>66</volume><issue>3</issue><fpage>599</fpage><lpage>600</lpage></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Joslyn</surname><given-names>G</given-names></name><name><surname>Carlson</surname><given-names>M</given-names></name><name><surname>Thliveris</surname><given-names>A</given-names></name><etal/></person-group><article-title>Identification of deletion mutations and three new genes at the familial polyposis locus</article-title><source><italic>Cell</italic></source><year>1991</year><volume>66</volume><issue>3</issue><fpage>601</fpage><lpage>613</lpage><pub-id pub-id-type="pmid">1678319</pub-id></element-citation></ref><ref id="B16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kinzler</surname><given-names>KW</given-names></name><name><surname>Nilbert</surname><given-names>MC</given-names></name><name><surname>Su</surname><given-names>LK</given-names></name><etal/></person-group><article-title>Identification of FAP locus genes from chromosome 5q21</article-title><source><italic>Science</italic></source><year>1991</year><volume>253</volume><issue>5020</issue><fpage>661</fpage><lpage>665</lpage><pub-id pub-id-type="pmid">1651562</pub-id></element-citation></ref><ref id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hanson</surname><given-names>CA</given-names></name><name><surname>Miller</surname><given-names>JR</given-names></name></person-group><article-title>Non-traditional roles for the Adenomatous Polyposis Coli (APC) tumor suppressor protein</article-title><source><italic>Gene</italic></source><year>2005</year><volume>361</volume><issue>1-2</issue><fpage>1</fpage><lpage>12</lpage><pub-id pub-id-type="pmid">16185824</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Moon</surname><given-names>RT</given-names></name><name><surname>Kohn</surname><given-names>AD</given-names></name><name><surname>de Ferrari</surname><given-names>GV</given-names></name><name><surname>Kaykas</surname><given-names>A</given-names></name></person-group><article-title>WNT and <italic>&#x003b2;</italic>-catenin signalling: giseases and therapies</article-title><source><italic>Nature Reviews Genetics</italic></source><year>2004</year><volume>5</volume><issue>9</issue><fpage>691</fpage><lpage>701</lpage></element-citation></ref><ref id="B19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bienz</surname><given-names>M</given-names></name></person-group><article-title>The subcellular destinations of APC proteins</article-title><source><italic>Nature Reviews Molecular Cell Biology</italic></source><year>2002</year><volume>3</volume><issue>5</issue><fpage>328</fpage><lpage>338</lpage></element-citation></ref><ref id="B20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lips</surname><given-names>DJ</given-names></name><name><surname>Barker</surname><given-names>N</given-names></name><name><surname>Clevers</surname><given-names>H</given-names></name><name><surname>Hennipman</surname><given-names>A</given-names></name></person-group><article-title>The role of APC and beta-catenin in the aetiology of aggressive fibromatosis (desmoid tumors)</article-title><source><italic>European Journal of Surgical Oncology</italic></source><year>2009</year><volume>35</volume><issue>1</issue><fpage>3</fpage><lpage>10</lpage><pub-id pub-id-type="pmid">18722078</pub-id></element-citation></ref><ref id="B21"><label>21</label><element-citation publication-type="journal"><person-group pe