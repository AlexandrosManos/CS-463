volume>4</volume><fpage>683</fpage><lpage>694</lpage><pub-id pub-id-type="pmid">16940160</pub-id><pub-id pub-id-type="doi">10.1158/1541-7786.MCR-06-0057</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sun</surname><given-names>J</given-names></name><name><surname>Mustafi</surname><given-names>R</given-names></name><name><surname>Cerda</surname><given-names>S</given-names></name><name><surname>Chumsangsri</surname><given-names>A</given-names></name><name><surname>Xia</surname><given-names>YR</given-names></name><name><surname>Li</surname><given-names>YC</given-names></name><name><surname>Bissonnette</surname><given-names>M</given-names></name></person-group><article-title>Lithocholic acid down-regulation of NF-kappaB activity through vitamin D receptor in colonic cancer cells</article-title><source>J Steroid Biochem Mol Biol</source><year>2008</year><volume>111</volume><fpage>37</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">18515093</pub-id><pub-id pub-id-type="doi">10.1016/j.jsbmb.2008.01.003</pub-id></citation></ref></ref-list></back></article>