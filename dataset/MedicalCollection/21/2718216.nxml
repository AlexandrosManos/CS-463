e><source>Journal of the Royal Society Interface</source><year>2008</year><volume>5</volume><fpage>525</fpage><lpage>531</lpage></element-citation></ref><ref id="bib15"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Fleischmann</surname><given-names>F</given-names></name><name><surname>Koehl</surname><given-names>J</given-names></name><name><surname>Portz</surname><given-names>R</given-names></name><name><surname>Beltrame</surname><given-names>AB</given-names></name><name><surname>Osswald</surname><given-names>W</given-names></name></person-group><article-title>Physiological changes of <italic>Fagus sylvatica</italic> seedlings infected with <italic>Phytophthora citricola</italic> and the contribution of its elicitin &#x02018;Citricolin&#x02019; to pathogenesis</article-title><source>Plant Biology</source><year>2005</year><volume>7</volume><fpage>650</fpage><lpage>658</lpage><pub-id pub-id-type="pmid">16388468</pub-id></element-citation></ref><ref id="bib16"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Garrett</surname><given-names>KA</given-names></name><name><surname>Dendy</surname><given-names>SP</given-names></name><name><surname>Frank</surname><given-names>EE</given-names></name><name><surname>Rouse</surname><given-names>MN</given-names></name><name><surname>Travers</surname><given-names>SE</given-names></name></person-group><article-title>Climate change effects on plant disease: genomes to ecosystems</article-title><source>Annual Review of Phytopathology</source><year>2006</year><volume>44</volume><fpage>489</fpage><lpage>509</lpage></element-citation></ref><ref id="bib17"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Glazebrook</surname><given-names>J</given-names></name><name><surname>Ton</surname><given-names>J</given-names></name></person-group><article-title>Biotic interactions: recurring them