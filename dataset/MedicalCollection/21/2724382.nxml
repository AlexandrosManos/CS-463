le-title>Studies on double strain occupancy of nodules and the competitive ability of Rhizobium trifolii on red and white clover grown in soil and agar</article-title><source>Annals of Applied Biology</source><year>1979</year><volume>94</volume><fpage>51</fpage><lpage>59</lpage></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="book"><name><surname>Schwinghamer</surname><given-names>EA</given-names></name><name><surname>Dudman</surname><given-names>WF</given-names></name><person-group person-group-type="editor">Bergersen FJ</person-group><article-title>Methods of identifying strains of diazotrophs</article-title><source>Methods for Evaluating Biological Nitrogen Fixation</source><year>1980</year><publisher-name>New York: John Wiley</publisher-name><fpage>337</fpage><lpage>365</lpage></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="journal"><name><surname>Stein</surname><given-names>M</given-names></name><name><surname>Bromfield</surname><given-names>ESP</given-names></name><name><surname>Dye</surname><given-names>M</given-names></name><article-title>An assessment of a method based on intrinsic antibiotic resistance for identifying Rhizobium strains</article-title><source>Annals of Applied Biology</source><year>1982</year><volume>101</volume><fpage>261</fpage><lpage>267</lpage><pub-id pub-id-type="doi">10.1111/j.1744-7348.1982.tb00821.x</pub-id></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="journal"><name><surname>Dakora</surname><given-names>FD</given-names></name><article-title>Use of intrinsic antibiotic resistance for characterisation and identification of rhizobia from nodules of <italic>Vigna unguiculata </italic>(L) Walp. and <italic>Phaseolus vulgaris </italic>(L)</article-title><source>Acta Microbiologica Polonica</source><year>1985</year><volume>34</volume><fpage>187</fpage><lpage>196</lpage><pub-id pub-id-type="pmid">2412407</pub-id></mixed-citation></ref><ref id="B19"><mixed-citation public