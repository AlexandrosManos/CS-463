ource>Cell</source> <volume>127</volume>: <fpage>1109</fpage>&#x02013;<lpage>1122</lpage><pub-id pub-id-type="pmid">17112576</pub-id></citation></ref><ref id="b10"><citation citation-type="journal"><name><surname>Lal</surname><given-names>A</given-names></name>, <name><surname>Mazan-Mamczarz</surname><given-names>K</given-names></name>, <name><surname>Kawai</surname><given-names>T</given-names></name>, <name><surname>Yang</surname><given-names>X</given-names></name>, <name><surname>Martindale</surname><given-names>JL</given-names></name>, <name><surname>Gorospe</surname><given-names>M</given-names></name> (<year>2004</year>) <article-title>Concurrent versus individual binding of HuR and AUF1 to common labile target mRNAs</article-title>. <source>EMBO J</source> <volume>23</volume>: <fpage>3092</fpage>&#x02013;<lpage>3102</lpage><pub-id pub-id-type="pmid">15257295</pub-id></citation></ref><ref id="b11"><citation citation-type="journal"><name><surname>Lamb</surname><given-names>J</given-names></name>, <name><surname>Crawford</surname><given-names>ED</given-names></name>, <name><surname>Peck</surname><given-names>D</given-names></name>, <name><surname>Modell</surname><given-names>JW</given-names></name>, <name><surname>Blat</surname><given-names>IC</given-names></name>, <name><surname>Wrobel</surname><given-names>MJ</given-names></name>, <name><surname>Lerner</surname><given-names>J</given-names></name>, <name><surname>Brunet</surname><given-names>JP</given-names></name>, <name><surname>Subramanian</surname><given-names>A</given-names></name>, <name><surname>Ross</surname><given-names>KN</given-names></name>, <name><surname>Reich</surname><given-names>M</given-names></name>, <name><surname>Hieronymus</surname><given-names>H</given-names></name>, <name><surname>Wei</surname><given-names>G</given-names></name>, <name><surname>Armstrong</surname><given-names>SA</given-names></name>, <name><surname>Haggarty</surname><given-names>SJ</given-names></name>, <name><surname>Clemons</surname><given-names>PA</given-names></name>, <name><surname>Wei</surname><given-names>R</given-names></name>, <name><surname>Carr</surname><given-names>SA</given-names></name>, <name><surname>Lander</surname><given-names>ES</given-names></name>, <name><surname>Golub</surname><given-names>TR</given-names></name> (<year>2006</year>) <article-title>The Connectivity Map: using gene-expression signatures to connect small molecules, genes, and disease</article-title>. <source>Science</source> <volume>313</volume>: <fpage>1929</fpage>&#x02013;<lpage>1935</lpage><pub-id pub-id-type="pmid">17008526</pub-id></citation></ref><ref id="b12"><citation citation-type="journal"><name><surname>Mattick</surname><given-names>JS</given-names></name>, <name><surname>Makunin</surname><given-names>IV</given-names></name> (<year>2006</year>) <article-title>Non-coding RNA</article-title>. <source>Hum Mol Genet</source> <volume>15</volume>: <fpage>R17</fpage>&#x02013;<lpage>R29</lpage><pub-id pub-id-type="pmid">16651366</pub-id></citation></ref><ref id="b13"><citation citation-type="journal"><name><surname>Moore</surname><given-names>MJ</given-names></name> (<year>2005</year>) <article-title>From birth to death: the complex lives of eukaryotic mRNAs</article-title>. <source>Science</source> <volume>309</volume>: <fpage>1514</fpage>&#x02013;<lpage>1518</lpage><pub-id pub-id-type="pmid">16141059</pub-id></citation></ref><ref id="b14"><citation citation-type="journal"><name><surname>Mukherjee</surname><given-names>N</given-names></name>, <name><surname>Lager</surname><given-names>PJ</given-names></name>, <name><surname>Freidersdorf</surname><given-names>MB</given-names></name>, <name><surname>Thompson</surname><given-names>MA</given-names></name>, <name><surname>Keene</surname><given-names>JD</given-names></name> (<year>2009</year>) <article-title>Coordinated posttranscriptional mRNA population dynamics during T-cell activation</article-title>. <source>Mol Syst Biol</source> <volume>5</volume>: 288 msb200944 </citation></ref><ref id="b15"><citation citation-type="journal"><name><surname>Pullmann</surname><given-names>R</given-names><suffix>Jr</suffix></name>, <name><surname>Kim</surname><given-names>HH</given-names></name>, <name><surname>Abdelmohsen</surname><given-names>K</given-names></name>, <name><surname>Lal</surname><given-names>A</given-names></name>, <name><surname>Martindale</surname><given-names>JL</given-names></name>, <name><surname>Yang</surname><given-names>X</given-names></name>, <name><surname>Gorospe</surname><given-names>M</given-names></name> (<year>2007</year>) <article-title>Analysis of turnover and translation regulatory RNA-binding protein expression through binding to cognate mRNAs</article-title>. <source>Mol Cell Biol</source> <volume>27</volume>: <fpage>6265</fpage>&#x02013;<lpage>6278</lpage><pub-id pub-id-type="pmid">17620417</pub-id></citation></ref></ref-list></back><floats-wrap><fig id="f1"><label>Figure 1</label><caption><p>Schematic depiction of one of the applications of RNP dynamics. Following RIP chip analysis for a specific RBP, the top enriched and depleted mRNAs are compared against the CMAP database (<xref ref-type="bibr" rid="b11">Lamb <italic>et al</italic>, 2006</xref>). The resulting comparison can be used to identify drugs that activate or inhibit that RBP.</p></caption><graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="msb200948-f1"/></fig></floats-wrap></article>