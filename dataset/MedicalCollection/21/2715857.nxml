.0217</td><td align="left" rowspan="1" colspan="1">0.94&#x0002a;&#x0002a;&#x0002a;</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"><italic>Ba</italic>_MG</td><td align="left" rowspan="1" colspan="1">52</td><td align="left" rowspan="1" colspan="1">528</td><td align="left" rowspan="1" colspan="1">18</td><td align="left" rowspan="1" colspan="1">0.0075</td><td align="left" rowspan="1" colspan="1">0.0036</td><td align="left" rowspan="1" colspan="1">&#x02212;1.6411&#x0002a;</td><td align="left" rowspan="1" colspan="1">0.050&#x0002a;</td><td align="left" rowspan="1" colspan="1">0.1178</td><td align="left" rowspan="1" colspan="1">0.0609</td><td align="left" rowspan="1" colspan="1">SAA</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">-</td><td align="left" rowspan="1" colspan="1">0.96&#x0002a;&#x0002a;&#x0002a;</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"><italic>Bp</italic>_Lg</td><td align="left" rowspan="1" colspan="1">33</td><td align="left" rowspan="1" colspan="1">528</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">0.0014</td><td align="left" rowspan="1" colspan="1">0.0006</td><td align="left" rowspan="1" colspan="1">&#x02212;1.3758</td><td align="left" rowspan="1" colspan="1">0.069&#x0002a;</td><td align="left" rowspan="1" colspan="1">0.1190</td><td align="left" rowspan="1" colspan="1">-</td><td align="left" rowspan="1" colspan="1">-</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">-</td><td align="left" rowspan="1" colspan="1">-</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"><italic>Bt</italic>_7S</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">528</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">0.0000</td><t