<person-group person-group-type="editor"><name><surname>Schwartzberg JG, VanGeest JB, Wang CC</surname></name></person-group><article-title>Literacy testing in health care research</article-title><source>Understanding Health Literacy</source><year>2005</year><publisher-name>Chicago, IL: American Medical Association</publisher-name></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ibrahim</surname><given-names>SY</given-names></name><name><surname>Reid</surname><given-names>F</given-names></name><name><surname>Shaw</surname><given-names>A</given-names></name><name><surname>Rowlands</surname><given-names>G</given-names></name><name><surname>Gomez</surname><given-names>GB</given-names></name><name><surname>Chesnokov</surname><given-names>M</given-names></name><name><surname>Ussher</surname><given-names>M</given-names></name></person-group><article-title>Validation of a health literacy screening tool (REALM) in a UK population with coronary heart disease</article-title><source>J Public Health (Oxf)</source><year>2008</year><volume>30</volume><fpage>449</fpage><lpage>455</lpage><pub-id pub-id-type="pmid">18660507</pub-id><pub-id pub-id-type="doi">10.1093/pubmed/fdn059</pub-id></citation></ref><ref id="B9"><citation citation-type="other"><article-title>International Physical Activity Questionnaire</article-title><ext-link ext-link-type="uri" xlink:href="http://www.ipaq.ki.se/"/></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><collab>National Center for Education Statistics</collab></person-group><source>National Assessment of Adult Literacy A First Look at the Literacy of America's Adults in the 21st Century</source><year>2005</year><publisher-name>NCES Publication No. 2006470</publisher-name></citation></ref><ref id="B11"><citation citation-type="other"><person-group person-group-type="author"><collab>Department for Education and Skills (UK)</colla