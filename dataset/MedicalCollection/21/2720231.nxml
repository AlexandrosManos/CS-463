&#x00025;)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Mucinous</td><td align="char" valign="top" char="(" charoff="50">23 (19&#x00025;)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Undifferentiated</td><td align="char" valign="top" char="(" charoff="50">11 (9&#x00025;)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Endometrioid</td><td align="char" valign="top" char="(" charoff="50">8 (7&#x00025;)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Clear cell</td><td align="char" valign="top" char="(" charoff="50">8 (7&#x00025;)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="3" align="left" valign="top" charoff="50"><italic>Residual tumour after the first surgery</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;No</td><td align="char" valign="top" char="(" charoff="50">68 (57&#x00025;)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Yes</td><td align="char" valign="top" char="(" charoff="50">52 (43&#x00025;)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="3" align="left" valign="top" charoff="50"><italic>Relapse</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;No</td><td align="char" valign="top" char="(" charoff="50">33 (28&#x00025;)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Yes</td><td align="char" valign="top" char="(" charoff="50">87 (72&#x00025;)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="3" align="left" valign="top" charoff="50"><italic>Ascites</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;No</td><td align="char" valign="top" char="(" charoff="50">22 (18&#x00025;)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Yes</td><td align="char" valign="top" char="(" charoff="50">98 (82&#x00025;)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr></tbody></table><table-wrap-foot><fn id="t1-fn1"><label/><p>EOC=epithelial ovarian cancer; FIGO=Federation of Gynecology and Obstetrics (<xref ref-type="other" rid="bib11">Creasman, 1989</xref>).</p></fn></table-wrap-foot></table-wrap><table-wrap id="tbl2" position="float"><label>Table 2</label><caption><p content-type="table-title">Inmmunofluoresence staining intensity of uPA, CD44, MDR1 and MRP2 in EOC cell lines</p></caption><table frame="hsides" rules="groups" border="1" width="85%"><colgroup><col align="left"/><col align="char" char="."/><col align="char" char="."/><col align="char" char="."/><col align="center"/></colgroup><thead valign="bottom"><tr><th align="left" valign="top" charoff="50">&#x000a0;</th><th colspan="4" align="center" valign="top" char="." charoff="50"><bold>Ovarian cancer cell line</bold></th></tr><tr><th align="left" valign="top" charoff="50">&#x000a0;</th><th colspan="2" align="center" valign="top" char="." charoff="50"><bold>Primary EOC cell line</bold></th><th colspan="2" align=