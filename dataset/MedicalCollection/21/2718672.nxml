s></name><name><surname>Steel</surname><given-names>MA</given-names></name></person-group><article-title>Split networks and reticulate networks</article-title><source>Reconstructing Evolution: New Mathematical and Computational Advances</source><year>2007</year><publisher-loc>Oxford</publisher-loc><publisher-name>Oxford University Press</publisher-name><fpage>247</fpage><lpage>276</lpage></element-citation></ref><ref id="B13"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jin</surname><given-names>G</given-names></name><etal/></person-group><article-title>Maximum likelihood of phylogenetic networks</article-title><source>Bioinformatics</source><year>2006</year><volume>22</volume><fpage>2604</fpage><lpage>2611</lpage><pub-id pub-id-type="pmid">16928736</pub-id></element-citation></ref><ref id="B14"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jin</surname><given-names>G</given-names></name><etal/></person-group><article-title>Efficient parsimony-based methods for phylogenetic network reconstruction</article-title><source>Bioinformatics</source><year>2007a</year><volume>23</volume><fpage>123</fpage><lpage>128</lpage></element-citation></ref><ref id="B15"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jin</surname><given-names>G</given-names></name><etal/></person-group><article-title>Inferring phylogenetic networks by the maximum parsimony criterion: a case study</article-title><source>Mol. Biol. Evol.</source><year>2007b</year><volume>24</volume><fpage>324</fpage><lpage>337</lpage><pub-id pub-id-type="pmid">17068107</pub-id></element-citation></ref><ref id="B16"><element-citation publication-type="confproc"><person-group person-group-type="author"><name><surname>Linder</surname><given-names>CR</given-names></name><etal/></person-group><article-title>Network (reticulate) evolution: biology, models and algorithms</article-title><source>Tutorial presented at the Ninth Pacific Symposium on Biocomputing</source><year>2003</year><date-in-citation>(last accessed date June 1, 2008)</date-in-citation><comment>Available at <ext-link ext-link-type="uri" xlink:href="http://www.cs.rice.edu/~nakhleh/Papers/psb04.pdf">http://www.cs.rice.edu/~nakhleh/Papers/psb04.pdf</ext-link></comment></element-citation></ref><ref id="B17"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Moret</surname><given-names>BME</given-names></name><etal/></person-group><article-title>Phylogenetic Networks: modeling, reconstructibility, and accuracy</article-title><source>IEEE T. Comput. Biol.</source><year>2004</year><volume>1</volume><fpage>13</fpage><lpage>23</lpage></element-citation></ref><ref id="B18"><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Nakhleh</surname><given-names>L</given-names></name></person-group><article-title>Phylogenetic Networks</article-title><source>PhD Thesis</source><year>2004</year><publisher-loc>Austin</publisher-loc><publisher-name>University of Texas</publisher-name></element-citation></ref><ref id="B19"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Pagel</surname><given-names>M</given-names></name></person-group><article-title>Inferring the historical patterns of biological evolution</article-title><source>Nature</source><year>1999</year><volume>401</volume><fpage>877</fpage><lpage>884</lpage><pub-id pub-id-type="pmid">10553904</pub-id></element-citation></ref><ref id="B20"><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Semple</surname><given-names>C</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Gascuel</surname><given-names>O</given-names></name><name><surname>Steel</surname><given-names>M</given-names></name></person-group><article-title>Hybridization networks</article-title><source>Reconstructing Evolution: New Mathematical and Computational Advances</source><year>2007</year><publisher-loc>Oxford</publisher-loc><publisher-name>Oxford University Press</publisher-name><fpage>277</fpage><lpage>314</lpage></element-citation></ref><ref id="B21"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Stajich</surname><given-names>JE</given-names></name><etal/></person-group><article-title>The BioPerl toolkit: Perl modules for the life sciences</article-title><source>Genome Res.</source><year>2002</year><date-in-citation>(last accessed date June 1, 2008)</date-in-citation><volume>12</volume><fpage>1611</fpage><lpage>1618</lpage><comment><ext-link ext-link-type="uri" xlink:href="http://www.bioperl.org/">http://www.bioperl.org/</ext-link></comment><pub-id pub-id-type="pmid">12368254</pub-id></element-citation></ref><ref id="B22"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Strimmer</surname><given-names>K</given-names></name><name><surname>Moulton</surname><given-names>V</given-names></name></person-group><article-title>Likelihood analysis of phylogenetic networks using directed graphical models</article-title><source>Mol. Biol. Evol.</source><year>2000</year><volume>17</volume><fpage>875</fpage><lpage>881</lpage><pub-id pub-id-type="pmid">10833193</pub-id></element-citation></ref><ref id="B23"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Strimmer</surname><given-names>K</given-names></name><etal/></person-group><article-title>Recombination analysis using directed graphical models</article-title><source>Mol. Biol. Evol.</source><year>2001</year><volume>18</volume><fpage>97</fpage><lpage>99</lpage><pub-id pub-id-type="pmid">11141198</pub-id></element-citation></ref></ref-list></back></article>