-type="bibr" rid="R11">11</xref>, <xref ref-type="bibr" rid="R31">31</xref>] </td></tr><tr><td align="center" rowspan="1" colspan="1">Endothelial cells </td><td align="center" rowspan="1" colspan="1">prevent NF-&#x003ba;B translocation </td><td align="center" rowspan="1" colspan="1">DMF</td><td align="center" rowspan="1" colspan="1">TNF &#x003b1;&#x02193;, ICAM-1&#x02191;, E-selectin&#x02191; VCAM-1&#x02191;</td><td align="center" rowspan="1" colspan="1">[<xref ref-type="bibr" rid="R4">4</xref>, <xref ref-type="bibr" rid="R27">27</xref>]</td></tr><tr><td align="center" rowspan="1" colspan="1">Glia cells</td><td align="center" rowspan="1" colspan="1">TNF-&#x003b1;&#x02193;, IL-1&#x003b2;&#x02193;, IL-6&#x02193;</td><td align="center" rowspan="1" colspan="1">DMF</td><td align="center" rowspan="1" colspan="1">NQO-1&#x02191;,cellular Glutathion&#x02191;, NO&#x02193;</td><td align="center" rowspan="1" colspan="1">[<xref ref-type="bibr" rid="R30">30</xref>]</td></tr></tbody></table></table-wrap><table-wrap id="T2" position="float"><label>Table 2</label><caption><p>Clinical and MRI Data of a Phase II Study with BG-12 in RRMS</p></caption><table frame="border" rules="all" width="100%"><thead><tr><th rowspan="2" colspan="1">End Point MRI</th><th rowspan="2" colspan="1">Placebo</th><th colspan="3" rowspan="1">BG12</th></tr><tr><th rowspan="1" colspan="1">120 mg qd</th><th rowspan="1" colspan="1">120 mg tid</th><th rowspan="1" colspan="1">240 mg tid</th></tr></thead><tbody><tr><td align="center" rowspan="1" colspan="1">Mean number of new Gd+ lesions (Weeks 12-24)</td><td align="center" rowspan="1" colspan="1">4.5</td><td align="center" rowspan="1" colspan="1">3.3</td><td align="center" rowspan="1" colspan="1">3.1</td><td align="center" rowspan="1" colspan="1">1.4<xref ref-type="table-fn" rid="T2FN1">*</xref></td></tr><tr><td align="center" rowspan="1" colspan="1">Mean number of new or enlarging T2-hyperintense lesions, % of patients (Week 24)</td><td align="center" rowspan="1" colspan="1">4.2</td><td align="center" rowspan="1" colspan="1">3.8</td><td align="center" rowspan="1" colspan="1">4.1</td><td align="center" rowspan="1" colspan="1">2.2<xref ref-type="table-fn" rid="T2FN1">*</xref></td></tr><tr><td align="center" rowspan="1" colspan="1">Mean number of new T1-hypointense lesions, % of patients (Week 24)</td><td align="center" rowspan="1" colspan="1">1.7</td><td align="center" rowspan="1" colspan="1">1.3</td><td align="center" rowspan="1" colspan="1">1.5</td><td align="center" rowspan="1" colspan="1">0.8<xref ref-type="table-fn" rid="T2FN1">*</xref></td></tr><tr><td align="center" rowspan="1" colspan="1">Clinical Data (weeks 0-24)</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td align="center" rowspan="1" colspan="1">Annualized relapse rate</td><td align="center" rowspan="1" colspan="1">0.65</td><td align="center" rowspan="1" colspan="1">0.42</td><td align="center" rowspan="1" colspan="1">0.78</td><td align="center" rowspan="1" colspan="1">0.44</td></tr><tr><td align="center" rowspan="1" colspan="1">Relapse free, % of patients</td><td align="center" rowspan="1" colspan="1">69</td><td align="center" rowspan="1" colspan="1">78</td><td align="center" rowspan="1" colspan="1">64</td><td align="center" rowspan="1" colspan="1">71</td></tr></tbody></table><table-wrap-foot><fn id="T2FN1"><label>*</label><p>significant result.</p></fn></table-wrap-foot></table-wrap></floats-group></article>