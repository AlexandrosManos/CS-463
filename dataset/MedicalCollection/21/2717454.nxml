0b1; 0.3</td><td align="center">18.7 &#x000b1; 0.7</td><td align="center">21.7 &#x000b1; 0.8</td><td align="center">2.8 &#x000b1; 0.2</td><td align="center">2.9 &#x000b1; 0.8</td><td align="center">9.8 &#x000b1; 0.6</td><td align="center">9.4 &#x000b1; 0.8</td></tr><tr><td></td><td align="center">PSV</td><td align="center">1.9 &#x000b1; 0.5</td><td align="center">3.2 &#x000b1; 0.7</td><td align="center">6.7 &#x000b1; 0.4</td><td align="center">7 &#x000b1; 0.6</td><td align="center">1.9 &#x000b1; 0.9</td><td align="center">2.5 &#x000b1; 0.3</td><td align="center">4.4 &#x000b1; 4.9</td><td align="center">2.2 &#x000b1; 0.7</td></tr><tr><td colspan="10"><hr></hr></td></tr><tr><td align="center"><bold>CO<sub>2 </sub>max </bold>(%)</td><td align="center">HF-BiPAP</td><td align="center">0.1 &#x000b1; 0</td><td align="center">0.1 &#x000b1; 0</td><td align="center">0.1 &#x000b1; 0</td><td align="center">0.1 &#x000b1; 0</td><td align="center">0.1 &#x000b1; 0</td><td align="center">0.1 &#x000b1; 0</td><td align="center">0.2 &#x000b1; 0</td><td align="center">0.2 &#x000b1; 0</td></tr><tr><td></td><td align="center">BiVent</td><td align="center">4.2 &#x000b1; 0</td><td align="center">4.0 &#x000b1; 0.1</td><td align="center">2.1 &#x000b1; 0</td><td align="center">3.2 &#x000b1; 0</td><td align="center">3.9 &#x000b1; 0.1</td><td align="center">2.6 &#x000b1; 0</td><td align="center">1.9 &#x000b1; 0</td><td align="center">1.4 &#x000b1; 0.2</td></tr><tr><td></td><td align="center">PSV</td><td align="center">0.2 &#x000b1; 0</td><td align="center">1.2 &#x000b1; 0</td><td align="center">1 &#x000b1; 0</td><td align="center">0.8 &#x000b1; 0</td><td align="center">0.9 &#x000b1; 0</td><td align="center">0.7 &#x000b1; 0</td><td align="center">1 &#x000b1; 0.2</td><td align="center">0.5 &#x000b1; 0</td></tr><tr><td colspan="10"><hr></hr></td></tr><tr><td align="left" colspan="10"><bold>Obstructive lung condition</bold></td></tr><tr><td align="right" colspan="2"><bold>Respiratory rate</bold></td