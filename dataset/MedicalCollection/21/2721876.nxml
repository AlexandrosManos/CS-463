e><fpage>196</fpage><lpage>202</lpage><pub-id pub-id-type="pmid">18288318</pub-id></mixed-citation></ref><ref id="b6-ehp-117-1302"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Brook</surname><given-names>RD</given-names></name><name><surname>Franklin</surname><given-names>B</given-names></name><name><surname>Cascio</surname><given-names>W</given-names></name><name><surname>Hong</surname><given-names>Y</given-names></name><name><surname>Howard</surname><given-names>G</given-names></name><name><surname>Lipsett</surname><given-names>M</given-names></name><etal/></person-group><year>2004</year><article-title>Air pollution and cardiovascular disease: a statement for healthcare professionals from the Expert Panel on Population and Prevention Science of the American Heart Association</article-title><source>Circulation</source><volume>109</volume><fpage>2655</fpage><lpage>2671</lpage><pub-id pub-id-type="pmid">15173049</pub-id></mixed-citation></ref><ref id="b7-ehp-117-1302"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Casiglia</surname><given-names>E</given-names></name><name><surname>Tikhonoff</surname><given-names>V</given-names></name></person-group><year>2007</year><article-title>Inflammatory and coagulative markers of atherosclerosis</article-title><source>Eur Heart J</source><volume>28</volume><fpage>271</fpage><lpage>273</lpage><pub-id pub-id-type="pmid">17251260</pub-id></mixed-citation></ref><ref id="b8-ehp-117-1302"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>JC</given-names></name><name><surname>Schwartz</surname><given-names>J</given-names></name></person-group><year>2008</year><article-title>Metabolic syndrome and inflammatory responses to long-term particulate air pollutants</article-title><source>Environ Health Perspect</source><volume>116</volume><fpage>612</fpage><lpage