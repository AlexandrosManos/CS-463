02003;Model 3: drop of &#x0003e; 1 category or remaining zero</td><td align="center" valign="top" rowspan="1" colspan="1">97 (62)</td><td align="center" valign="top" rowspan="1" colspan="1">32 (31)</td><td align="center" valign="top" rowspan="1" colspan="1">3.6 (1.8&#x02013;7.5)</td><td align="center" valign="top" rowspan="1" colspan="1">97 (66)</td><td align="center" valign="top" rowspan="1" colspan="1">44 (42)</td><td align="center" valign="top" rowspan="1" colspan="1">2.5 (0.7&#x02013;9.2)</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;Model 4: drop of &#x0003e; 2 categories or remaining zero</td><td align="center" valign="top" rowspan="1" colspan="1">57 (36)</td><td align="center" valign="top" rowspan="1" colspan="1">16 (15)</td><td align="center" valign="top" rowspan="1" colspan="1">3.1 (1.6&#x02013;5.8)</td><td align="center" valign="top" rowspan="1" colspan="1">65 (44)</td><td align="center" valign="top" rowspan="1" colspan="1">18 (17)</td><td align="center" valign="top" rowspan="1" colspan="1">3.0 (0.7&#x02013;1.2)</td></tr><tr><td colspan="7" align="left" valign="top" rowspan="1"><hr/></td></tr><tr><td colspan="7" align="left" valign="top" rowspan="1">Mice activity<hr/></td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;Model 5: no mouse activity</td><td align="center" valign="top" rowspan="1" colspan="1">141 (90)</td><td align="center" valign="top" rowspan="1" colspan="1">90 (88)</td><td align="center" valign="top" rowspan="1" colspan="1">1.2 (0.4&#x02013;3.5)</td><td align="center" valign="top" rowspan="1" colspan="1">130 (88)</td><td align="center" valign="top" rowspan="1" colspan="1">92 (87)</td><td align="center" valign="top" rowspan="1" colspan="1">1.0 (0.2&#x02013;4.9)</td></tr><tr><td colspan="7" align="left" valign="top" rowspan="1"><hr/></td></tr><tr><td colspan="7" align="left" valign="top" rowspan="1">Sighted mice<hr/></td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x0200