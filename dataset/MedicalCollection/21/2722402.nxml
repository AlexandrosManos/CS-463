right" rowspan="1" colspan="1">32</td><td align="right" rowspan="1" colspan="1">60</td><td align="right" rowspan="1" colspan="1">32</td><td align="right" rowspan="1" colspan="1">58</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">Black</td><td align="right" rowspan="1" colspan="1">34</td><td align="right" rowspan="1" colspan="1">23</td><td align="right" rowspan="1" colspan="1">28</td><td align="right" rowspan="1" colspan="1">21</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">Hispanic</td><td align="right" rowspan="1" colspan="1">26</td><td align="right" rowspan="1" colspan="1">12</td><td align="right" rowspan="1" colspan="1">35</td><td align="right" rowspan="1" colspan="1">17</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">Asian</td><td align="right" rowspan="1" colspan="1">6</td><td align="right" rowspan="1" colspan="1">2</td><td align="right" rowspan="1" colspan="1">3</td><td align="right" rowspan="1" colspan="1">1</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">Other</td><td align="right" rowspan="1" colspan="1">1</td><td align="right" rowspan="1" colspan="1">3</td><td align="right" rowspan="1" colspan="1">1</td><td align="right" rowspan="1" colspan="1">3</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1"><bold>Mean age, y</bold></td><td align="right" rowspan="1" colspan="1">36</td><td align="right" rowspan="1" colspan="1">40</td><td align="right" rowspan="1" colspan="1">36</td><td align="right" rowspan="1" colspan="1">38</td></tr><tr><td align="left" scope="col" colspan="5" rowspan="1"><bold>Region of residence</bold></td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">Northeast</td><td align="right" rowspan="1" colspan="1">20</td><td align="right" rowspan="1" colspan="1">19</td><td align="right" rowspan="1" colspan="1">36</td><td align="right" rowspan="1" colspan="1">29</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">Midwest</td><td align="right" rowspan="1" colspan="1">21</td><td align="right" rowspan="1" colspan="1">24</td><td align="right" rowspan="1" colspan="1">11</td><td align="right" rowspan="1" colspan="1">18</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">South</td><td align="right" rowspan="1" colspan="1">35</td><td align="right" rowspan="1" colspan="1">38</td><td align="right" rowspan="1" colspan="1">28</td><td align="right" rowspan="1" colspan="1">28</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">West</td><td align="right" rowspan="1" colspan="1">24</td><td align="right" rowspan="1" colspan="1">18</td><td align="right" rowspan="1" colspan="1">25</td><td align="right" rowspan="1" colspan="1">25</td></tr><tr><td align="left" scope="col" colspan="5" rowspan="1"><bold>Weight category</bold></td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">Underweight</td><td align="right" rowspan="1" colspan="1">2</td><td align="right" rowspan="1" colspan="1">3</td><td align="right" rowspan="1" colspan="1">3</td><td align="right" rowspan="1" colspan="1">3</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">Normal</td><td align="right" rowspan="1" colspan="1">24</td><td align="right" rowspan="1" colspan="1">31</td><td align="right" rowspan="1" colspan="1">33</td><td align="right" rowspan="1" colspan="1">37</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">Overweight</td><td align="right" rowspan="1" colspan="1">36</td><td align="right" rowspan="1" colspan="1">31</td><td align="right" rowspan="1" colspan="1">29</td><td align="right" rowspan="1" colspan="1">30</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">Obese</td><td align="right" rowspan="1" colspan="1">36</td><td align="right" rowspan="1" colspan="1">34</td><td align="right" rowspan="1" colspan="1">30</td><td align="right" rowspan="1" colspan="1">26</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">Missing data</td><td align="right" rowspan="1" c