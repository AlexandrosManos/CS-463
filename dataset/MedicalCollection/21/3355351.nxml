="1" colspan="1">64</td><td align="center" rowspan="1" colspan="1">57</td><td align="center" rowspan="1" colspan="1">31</td><td align="center" rowspan="1" colspan="1">37</td><td align="center" rowspan="1" colspan="1">43</td></tr><tr><td align="center" rowspan="1" colspan="1"><bold>Gender</bold></td><td align="center" rowspan="1" colspan="1">F</td><td align="center" rowspan="1" colspan="1">M</td><td align="center" rowspan="1" colspan="1">M</td><td align="center" rowspan="1" colspan="1">F</td><td align="center" rowspan="1" colspan="1">M</td></tr><tr><td align="center" rowspan="1" colspan="1"><bold>Comorbidities</bold></td><td align="center" rowspan="1" colspan="1">Type 2 DM</td><td align="center" rowspan="1" colspan="1">Type 2 DM</td><td align="center" rowspan="1" colspan="1">Cocaine abuse</td><td align="center" rowspan="1" colspan="1">Heroin dependence</td><td align="center" rowspan="1" colspan="1">Heroin dependence</td></tr><tr><td align="center" rowspan="1" colspan="1"><bold>Presenting symptoms</bold></td><td align="center" rowspan="1" colspan="1">Confusion, Urinary frequency</td><td align="center" rowspan="1" colspan="1">Fever, chills, pleuritic chest pain</td><td align="center" rowspan="1" colspan="1">Fever, pleuritic chest pain</td><td align="center" rowspan="1" colspan="1">Fever, cough, pleuritic chest pain</td><td align="center" rowspan="1" colspan="1">Fever, leg pain, pleuritic chest pain</td></tr><tr><td align="center" rowspan="1" colspan="1"><bold>Extrapulmonary source</bold></td><td align="center" rowspan="1" colspan="1">Left pyelonephritis</td><td align="center" rowspan="1" colspan="1">Vertebral osteomyelitis,paraspinal abscesses</td><td align="center" rowspan="1" colspan="1">Left thigh pyomyositis</td><td align="center" rowspan="1" colspan="1">Right thigh cellulitis/abscess</td><td align="center" rowspan="1" colspan="1">Left thigh abscess</td></tr><tr><td align="center" rowspan="1" colspan="1"><bold>Pathogen (isolation sites)</bold></td><td align="center