<label>12</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Goetzel</surname><given-names>RZ</given-names></name><name><surname>Ozminkowski</surname><given-names>RJ</given-names></name><name><surname>Bruno</surname><given-names>JA</given-names></name><name><surname>Rutter</surname><given-names>KR</given-names></name><name><surname>Isaac</surname><given-names>F</given-names></name><name><surname>Wang</surname><given-names>S</given-names></name></person-group><volume>44</volume><issue>5</issue><year>2002</year><fpage>417</fpage><lpage>424</lpage><article-title>The long-term impact of Johnson &#x00026; Johnson's Health &#x00026; Wellness Program on employee health risks</article-title><source>J Occup Environ Med</source><pub-id pub-id-type="pmid">12024687</pub-id></mixed-citation></ref><ref id="B13"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ozminkowski</surname><given-names>RJ</given-names></name><name><surname>Ling</surname><given-names>D</given-names></name><name><surname>Goetzel</surname><given-names>RZ</given-names></name><name><surname>Bruno</surname><given-names>JA</given-names></name><name><surname>Rutter</surname><given-names>KR</given-names></name><name><surname>Isaac</surname><given-names>F</given-names></name><etal/></person-group><volume> 44</volume><issue>1</issue><year>2002</year><fpage>21</fpage><lpage>29</lpage><article-title>Long-term impact of Johnson &#x00026; Johnson's Health &#x00026; Wellness Program on health care utilization and expenditures</article-title><source>J Occup Environ Med</source><pub-id pub-id-type="pmid">11802462</pub-id></mixed-citation></ref><ref id="B14"><label>14</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Goetzel</surname><given-names>RZ</given-names></name><name><surname>Jacobson</surname><given-names>BH</given-names></name><name><surnam