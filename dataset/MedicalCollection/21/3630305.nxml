dy</article-title><source>Gastrointest Endosc</source><year>2007</year><volume>66</volume><fpage>310</fpage><lpage>316</lpage><pub-id pub-id-type="pmid">17643705</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>East</surname><given-names>JE</given-names></name><name><surname>Suzuki</surname><given-names>N</given-names></name><name><surname>Bassett</surname><given-names>P</given-names></name><etal/></person-group><article-title>Narrow band imaging with magnification for the characterization of small and diminutive colonic polyps: pit pattern and vascular pattern intensity</article-title><source>Endoscopy</source><year>2008</year><volume>40</volume><fpage>811</fpage><lpage>817</lpage><pub-id pub-id-type="pmid">18828077</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Su</surname><given-names>MY</given-names></name><name><surname>Hsu</surname><given-names>CM</given-names></name><name><surname>Ho</surname><given-names>YP</given-names></name><name><surname>Chen</surname><given-names>PC</given-names></name><name><surname>Lin</surname><given-names>CJ</given-names></name><name><surname>Chiu</surname><given-names>CT</given-names></name></person-group><article-title>Comparative study of conventional colonoscopy, chromoendoscopy, and narrow-band imaging systems in differential diagnosis of neoplastic and nonneoplastic colonic polyps</article-title><source>Am J Gastroenterol</source><year>2006</year><volume>101</volume><fpage>2711</fpage><lpage>2716</lpage><pub-id pub-id-type="pmid">17227517</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chiu</surname><given-names>HM</given-names></name><name><surname>Chang</surname><given-names>CY</g