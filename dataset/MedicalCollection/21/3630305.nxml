ame><surname>Rex</surname><given-names>DK</given-names></name></person-group><article-title>Narrow-band imaging without optical magnification for histologic analysis of colorectal polyps</article-title><source>Gastroenterology</source><year>2009</year><volume>136</volume><fpage>1174</fpage><lpage>1181</lpage><pub-id pub-id-type="pmid">19187781</pub-id></element-citation></ref><ref id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sano</surname><given-names>Y</given-names></name><name><surname>Ikematsu</surname><given-names>H</given-names></name><name><surname>Fu</surname><given-names>KI</given-names></name><etal/></person-group><article-title>Meshed capillary vessels by use of narrow-band imaging for differential diagnosis of small colorectal polyps</article-title><source>Gastrointest Endosc</source><year>2009</year><volume>69</volume><fpage>278</fpage><lpage>283</lpage><pub-id pub-id-type="pmid">18951131</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Katagiri</surname><given-names>A</given-names></name><name><surname>Fu</surname><given-names>KI</given-names></name><name><surname>Sano</surname><given-names>Y</given-names></name><etal/></person-group><article-title>Narrow band imaging with magnifying colonoscopy as diagnostic tool for predicting histology of early colorectal neoplasia</article-title><source>Aliment Pharmacol Ther</source><year>2008</year><volume>27</volume><fpage>1269</fpage><lpage>1274</lpage><pub-id pub-id-type="pmid">18284647</pub-id></element-citation></ref><ref id="B19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Henry</surname><given-names>ZH</given-names></name><name><surname>Yeaton</surname><given-names>P</given-names></name><name><surname>Shami</surname><given-names>VM</given-names></name><etal/></person-group><article-title>Meshed capillary vessels found on narrow-band imaging without optical magnification effectively identifies colorectal neoplasia: a North American validation of the Japanese experience</article-title><source>Gastrointest Endosc</source><year>2010</year><volume>72</volume><fpage>118</fpage><lpage>126</lpage><pub-id pub-id-type="pmid">20381799</pub-id></element-citation></ref><ref id="B20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Tischendorf</surname><given-names>JJ</given-names></name><name><surname>Schirin-Sokhan</surname><given-names>R</given-names></name><name><surname>Streetz</surname><given-names>K</given-names></name><etal/></person-group><article-title>Value of magnifying endoscopy in classifying colorectal polyps based on vascular pattern</article-title><source>Endoscopy</source><year>2010</year><volume>42</volume><fpage>22</fpage><lpage>27</lpage><pub-id pub-id-type="pmid">19899031</pub-id></element-citation></ref><ref id="B21"><label>21</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hewett</surname><given-names>DG</given-names></name><name><surname>Kaltenbach</surname><given-names>T</given-names></name><name><surname>Sano</surname><given-names>Y</given-names></name><etal/></person-group><article-title>Validation of a simple classification system for endoscopic diagnosis of small colorectal polyps using narrow-band imaging</article-title><source>Gastroenterology</source><year>2012</year><volume>143</volume><fpage>599</fpage><lpage>607</lpage><pub-id pub-id-type="pmid">22609383</pub-id></element-citation></ref><ref id="B22"><label>22</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>van den Broek</surname><given-names>FJ</given-names></name><name><surname>Reitsma</surname><given-names>JB</given-names></name><name><surna