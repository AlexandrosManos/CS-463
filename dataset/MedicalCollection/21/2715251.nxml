name><name><surname>Velds</surname><given-names>A</given-names></name><name><surname>Heimerikx</surname><given-names>M</given-names></name><name><surname>Kerkhoven</surname><given-names>RM</given-names></name><name><surname>Madiredjo</surname><given-names>M</given-names></name><name><surname>Nijkamp</surname><given-names>W</given-names></name><name><surname>Weigelt</surname><given-names>B</given-names></name><etal/></person-group><article-title>A large-scale RNAi screen in human cells identifies new components of the p53 pathway</article-title><source>Nature</source><year>2004</year><volume>428</volume><fpage>431</fpage><lpage>437</lpage><pub-id pub-id-type="pmid">15042092</pub-id></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hannon</surname><given-names>GJ</given-names></name><name><surname>Rossi</surname><given-names>JJ</given-names></name></person-group><article-title>Unlocking the potential of the human genome with RNA interference</article-title><source>Nature</source><year>2004</year><volume>431</volume><fpage>371</fpage><lpage>378</lpage><pub-id pub-id-type="pmid">15372045</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Paddison</surname><given-names>PJ</given-names></name><name><surname>Silva</surname><given-names>JM</given-names></name><name><surname>Conklin</surname><given-names>DS</given-names></name><name><surname>Schlabach</surname><given-names>M</given-names></name><name><surname>Li</surname><given-names>M</given-names></name><name><surname>Aruleba</surname><given-names>S</given-names></name><name><surname>Balija</surname><given-names>V</given-names></name><name><surname>O'Shaughnessy</surname><given-names>A</given-names></name><name><surname>Gnoj</surname><given-names>L</given-names></name><name><surname>Scobie</surname><given-name