"/></tr><tr><td align="left">2nd</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">3</td><td char="." align="char">0</td><td char="." align="char">8.75</td><td char="." align="char">46.5</td><td char="." align="char">58.25</td><td align="left">2nd</td><td char="." align="char">3.38</td><td align="left">No response</td></tr><tr><td align="left">&#x00394;cMRIS</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">&#x02212;1.5</td><td char="." align="char">&#x02212;4</td><td char="." align="char">8.75</td><td char="." align="char">&#x02212;3</td><td char="." align="char">0.25</td><td align="left">&#x00394;DAS28</td><td char="." align="char">&#x02212;0.2</td><td align="left"/></tr><tr><td align="left" rowspan="3">&#x000a0;Patient 6</td><td align="left">1st</td><td char="." align="char">3</td><td char="." align="char">0</td><td char="." align="char">3</td><td char="." align="char">13</td><td char="." align="char">5</td><td char="." align="char">42</td><td char="." align="char">66</td><td align="left">1st</td><td char="." align="char">4.21</td><td char="." align="char" rowspan="3">4.21</td><td align="left"/></tr><tr><td align="left">2nd</td><td char="." align="char">1</td><td char="." align="char">0</td><td char="." align="char">3</td><td char="." align="char">11</td><td char="." align="char">0</td><td char="." align="char">45</td><td char="." align="char">60</td><td align="left">2nd</td><td char="." align="char">2.23</td><td align="left">Good</td></tr><tr><td align="left">&#x00394;cMRIS</td><td char="." align="char">&#x02212;2</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">&#x02212;2</td><td char="." align="char">&#x02212;5</td><td char="." align="char">3</td><td char="." align="char">&#x02212;6</td><td align="left">&#x00394;DAS28</td><td char="." align="char">&#x02212;1.98</td><td align="left"/></tr><tr><td align="left" rowspan="3">&#x000a0;