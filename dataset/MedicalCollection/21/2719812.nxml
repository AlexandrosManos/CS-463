></element-citation></ref><ref id="B81"><label>12</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Weiss</surname><given-names>LM</given-names></name><name><surname>Vossbrinck</surname><given-names>CR</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Wittner</surname><given-names>M</given-names></name><name><surname>Weiss</surname><given-names>LM</given-names></name></person-group><article-title>Molecular biology, molecular phylogeny, and molecular diagnostic approaches to the microsporidia</article-title><source><italic>The Microsporidia and Microsporidiosis</italic></source><year>1999</year><publisher-loc>Washington, DC, USA</publisher-loc><publisher-name>American Society for Microbiology</publisher-name><fpage>129</fpage><lpage>171</lpage></element-citation></ref><ref id="B5"><label>13</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Ausubel</surname><given-names>FM</given-names></name><name><surname>Brent</surname><given-names>R</given-names></name><name><surname>Kingston</surname><given-names>RE</given-names></name><etal/></person-group><source><italic>Current Protocols in Molecular Biology</italic></source><year>1997</year><publisher-loc>New York, NY, USA</publisher-loc><publisher-name>John Wiley &#x00026; Sons</publisher-name></element-citation></ref><ref id="B43"><label>14</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Innis</surname><given-names>MA</given-names></name><name><surname>Gelfand</surname><given-names>DH</given-names></name><name><surname>Sninsky</surname><given-names>JJ</given-names></name><name><surname>White</surname><given-names>TJ</given-names></name></person-group><source><italic>PCR Protocols: A Guide to Methods and Applications</italic></source><year>1990</year><publisher-loc>San Diego, Calif, USA</publisher-loc><publisher-name>Academic Press</publisher-name></element-citation></ref><ref id="B14"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chan</surname><given-names>KS</given-names></name><name><surname>Koh</surname><given-names>TH</given-names></name></person-group><article-title>Extraction of microsporidial DNA from modified trichrome-stained clinical slides and subsequent species identification using PCR sequencing</article-title><source><italic>Parasitology</italic></source><year>2008</year><volume>135</volume><issue>6</issue><fpage>701</fpage><lpage>703</lpage><pub-id pub-id-type="pmid">18442428</pub-id></element-citation></ref><ref id="B42"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hylis</surname><given-names>M</given-names></name><name><surname>Weiser</surname><given-names>J</given-names></name><name><surname>Obornik</surname><given-names>M</given-names></name><name><surname>Vavra</surname><given-names>J</given-names></name></person-group><article-title>DNA isolation from museum and type collection slides of microsporidia</article-title><source><italic>Journal of Invertebrate Pathology</italic></source><year>2005</year><volume>88</volume><issue>3</issue><fpage>257</fpage><lpage>260</lpage><pub-id pub-id-type="pmid">15955346</pub-id></element-citation></ref><ref id="B30"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Fedorko</surname><given-names>DP</given-names></name><name><surname>Hijazi</surname><given-names>YM</given-names></name></person-group><article-title>Application of molecular techniques to the diagnosis of microsporidial infection</article-title><source><italic>Emerging Infectious Diseases</italic></source><year>1996</year><volume>2</volume><issue>3</issue><fpage>183</fpage><lpage>191</lpage><pub-id pub-id-type="pmid">8903228</pub-id></element-citation></ref><ref id="B65"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Raynaud</surname><given-names>L</given-names></name><name><surname>Delbac</surname><given-names>F</given-names></name><name><surname>Broussolle</surname><given-names>V</given-names></name><etal/></person-group><article-title>Identification of Encephalitozoon intestinalis in travelers with chronic diarrhea by specific PCR amplification</article-title><source><italic>Journal of Clinical Microbiology</italic></source><year>1998</year><volume>36</volume><issue>1</issue><fpage>37</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">9431916</pub-id></element-citation></ref><ref id="B9"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Boom</surname><given-names>R</given-names></name><name><surname>Sol</surname><given-names>CJA</given-names></name><name><surname>Salimans</surname><given-names>MMM</given-names></name><name><surname>Jansen</surname><given-names>CL</given-names></name><name><surname>Wertheim-van Dillen</surname><given-names>PME</given-names></name><name><surname>van der Noordaa</surname><given-names>J</given-names></name></person-group><article-title>Rapid and simple method for purification of nucleic acids</article-title><source><italic>Journal of Clinical Microbiology</italic></source><year>1990</year><volume>28</volume><issue>3</issue><fpage>495</fpage><lpage>503</lpage><pub-id pub-id-type="pmid">1691208</pub-id></element-citation></ref><ref id="B50"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kock</surname><given-names>NP</given-names></name><name><surname>Petersen</surname><given-names>H</given-names></name><name><surname>Fenner</surname><given-names>T</given-names></name><etal/></person-group><article-title>Species-specific identification of microsporidia in stool and intestinal biops