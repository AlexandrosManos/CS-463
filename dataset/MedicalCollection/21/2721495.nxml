t-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Townsend</surname><given-names>MF</given-names></name><name><surname>Sanders</surname><given-names>WH</given-names></name><name><surname>Northway</surname><given-names>RO</given-names></name><name><surname>Graham</surname><given-names>SD</given-names><suffix>Jr</suffix></name></person-group><article-title>Bone fractures associated with luteinizing hormone-releasing hormone agonists used in the treatment of prostate carcinoma</article-title><source>Cancer</source><year>1997</year><volume>79</volume><fpage>545</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">9028366</pub-id></element-citation></ref><ref id="CIT18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Oefelein</surname><given-names>MG</given-names></name><name><surname>Ricchiuti</surname><given-names>V</given-names></name><name><surname>Conrad</surname><given-names>W</given-names></name><name><surname>Resnick</surname><given-names>MI</given-names></name></person-group><article-title>Skeletal fractures negatively correlate with overall survival in men with prostate cancer</article-title><source>J Urol</source><year>2002</year><volume>168</volume><fpage>1005</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">12187209</pub-id></element-citation></ref><ref id="CIT19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rosenthal</surname><given-names>MA</given-names></name><name><surname>Rosen</surname><given-names>D</given-names></name><name><surname>Raghavan</surname><given-names>D</given-names></name><name><surname>Leicester</surname><given-names>J</given-names></name><name><surname>Duval</surname><given-names>P</given-names></name><name><surname>Besser</surname><given-names>M</given-names></name><etal/></person-group><article-title>Spinal cord compression in prostate cancer. A 10-ye