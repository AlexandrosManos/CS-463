equency in operon/total surveyed loci</td><td></td><td></td><td></td><td align="center">---</td><td align="center">---</td><td align="center">12.5%</td><td align="center">---</td><td align="center">6.3%/18.8%</td><td align="center">1.1%</td><td align="center">---</td><td align="center">12.5%/6.3%</td></tr><tr><td align="left">Frequency of occurrence in each locus (10 gene radius)</td><td></td><td></td><td></td><td align="center">25.0%</td><td></td><td align="center">18.8%</td><td align="center">---</td><td align="center">43.8%</td><td align="center">12.5%</td><td align="center">6.3%</td><td align="center">18.8%</td></tr><tr><td colspan="12"><hr></hr></td></tr><tr><td align="left"><bold>PSMR</bold></td><td align="center"><bold><italic>yvaD**</italic></bold></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td colspan="12"><hr></hr></td></tr><tr><td align="left">Putative operons</td><td></td><td align="center">7</td><td></td><td align="center">arg</td><td align="center">---</td><td align="center">---</td><td align="center">---</td><td align="center">---</td><td align="center">tetR</td><td align="center">---</td><td align="center">acp/fab</td></tr><tr><td align="left">Frequency in operon/total surveyed loci</td><td></td><td></td><td></td><td align="center">14.3%</td><td align="center">---</td><td align="center">---</td><td align="center">---</td><td align="center">---</td><td align="center">14.3%</td><td align="center">---</td><td align="center">28.6%</td></tr><tr><td align="left">Frequency of occurrence in each locus (10 gene radius)</td><td></td><td></td><td></td><td align="center">14.3%</td><td align="center">---</td><td align="center">---</td><td align="center">---</td><td align="center">---</td><td align="center">28.6%</td><td align="center">---</td><td align="center">42.9%</td></tr><tr><td colspan="12"><hr></hr></td></tr><tr><td align="left"><bold>PSMR</bold></td><td align="center"><bold><italic>ydgE/ydgF</ita