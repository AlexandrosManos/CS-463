center">0.45</td><td align="center">2.57</td></tr><tr><td></td><td align="left">Bme-<italic>sugE</italic></td><td align="center">55.38</td><td align="center">79.62</td><td align="center">78.5</td><td align="center">221.5</td><td align="center">0.71</td><td align="center">0.36</td><td align="center">2.12</td><td align="center">0.49</td><td align="center">4.33</td></tr><tr><td></td><td align="left">Bxe-<italic>sugE</italic></td><td align="center">50.25</td><td align="center">72.75</td><td align="center">80</td><td align="center">220</td><td align="center">0.63</td><td align="center">0.33</td><td align="center">1.36</td><td align="center">0.44</td><td align="center">3.13</td></tr><tr><td></td><td align="left">Pae-<italic>sugE1</italic></td><td align="center">49.5</td><td align="center">82.5</td><td align="center">80.83</td><td align="center">219.17</td><td align="center">0.61</td><td align="center">0.38</td><td align="center">1.27</td><td align="center">0.52</td><td align="center">2.43</td></tr><tr><td></td><td align="left">Pae-<italic>sugE2</italic></td><td align="center">47.12</td><td align="center">57.88</td><td align="center">82</td><td align="center">218</td><td align="center">0.57</td><td align="center">0.27</td><td align="center">1.09</td><td align="center">0.33</td><td align="center">3.33</td></tr><tr><td></td><td align="left">Eco-<italic>sugE</italic></td><td align="center">62</td><td align="center">66</td><td align="center">79.83</td><td align="center">220.17</td><td align="center">0.78</td><td align="center">0.3</td><td align="center">NA</td><td align="center">0.38</td><td align="center">NA</td></tr><tr><td></td><td align="left">Gsu-<italic>sugE</italic></td><td align="center">51.88</td><td align="center">67.12</td><td align="center">81.17</td><td align="center">218.83</td><td align="center">0.64</td><td align="center">0.31</td><td align="center">1.43</td><td align="center">0.39</td><td align="center">3.63</td></tr><tr><td></td><td align="left">I-<italic>qacE</italic></td><td align="center">62.38</td><td align="center">109.62</td><td align="center">78.5</td><td align="center">221.5</td><td align="center">0.79</td><td align="center">0.49</td><td align="center">NA</td><td align="center">0.81</td><td align="center">NA</td></tr><tr><td></td><td align="left">PI-<italic>qacE&#x00394;1</italic></td><td align="center">60.12</td><td align="center">116.88</td><td align="center">79</td><td align="center">221</td><td align="center">0.76</td><td align="center">0.53</td><td align="center">NA</td><td align="center">0.92</td><td align="center">NA</td></tr><tr><td></td><td align="left">P-<italic>qacF</italic></td><td align="center">48.88</td><td align="center">115.12</td><td align="center">78.17</td><td align="center">221.83</td><td align="center">0.63</td><td align="center">0.52</td><td align="center">1.35</td><td align="center">0.88</td><td align="center">1.52</td></tr><tr><td></td><td align="left">P-<italic>qacG</italic></td><td align="center">51.75</td><td align="center">116.25</td><td align="center">78</td><td align="center">222</td><td align="center">0.66</td><td align="center">0.52</td><td align="center">1.62</td><td align="center">0.9</td><td align="center">1.80</td></tr><tr><td></td><td align="left">P-<italic>qacH</italic></td><td align="center">70.12</td><td align="center">110.88</td><td align="center">73.83</td><td align="center">226.17</td><td align="center">0.95</td><td align="center">0.49</td><td align="center">NA</td><td align="center">0.8</td><td align="center">NA</td></tr><tr><td></td><td align="left">P-<italic>qacJ</italic></td><td align="center">68.75</td><td align="center">111.25</td><td align="center">75.33</td><td align="center">224.67</td><td align="center">0.91</td><td align="center">0.5</td><td align="center">NA</td><td align="center">0.81</td><td align="center">NA</td></tr><tr><td></td><td align="left">P-Cfr-<italic>sugE</italic></td><td align="center">62.62</td><td align="center">68.38</td><td align="center">