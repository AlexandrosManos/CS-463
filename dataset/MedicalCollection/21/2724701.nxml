pmid">16361524</pub-id></element-citation></ref><ref id="bib13"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Castigioni</surname><given-names>P</given-names></name><name><surname>Korte</surname><given-names>J</given-names></name><name><surname>Bell</surname><given-names>E</given-names></name><name><surname>Hinchey</surname><given-names>B</given-names></name><name><surname>Bensen</surname><given-names>R</given-names></name><name><surname>Loida</surname><given-names>P</given-names></name><name><surname>Ahrens</surname><given-names>J</given-names></name></person-group><article-title>Transgenic plants with increased glycine-betaine</article-title><year>2005</year><comment>US Patent, 20050160500</comment></element-citation></ref><ref id="bib14"><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Ceccarelli</surname><given-names>S</given-names></name><name><surname>Grando</surname><given-names>S</given-names></name><name><surname>Baum</surname><given-names>M</given-names></name><name><surname>Udupa</surname><given-names>SM</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Rao</surname><given-names>S</given-names></name><name><surname>Ryan</surname><given-names>J</given-names></name></person-group><article-title>Breeding for drought resistance in a changing climate</article-title><source>Challenges and strategies of dryland agriculture</source><year>2004</year><comment>CSSA Special Publication no. 32. Madison, WI: Crop Science Society of America and American Society of Agronomy, 167&#x02013;190</comment></element-citation></ref><ref id="bib15"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ceccarelli</surname><given-names>S</given-names></name></person-group><article-title>Specific adaptation and breeding for marginal conditions</article-title><source>Euphytica</source><year>1994