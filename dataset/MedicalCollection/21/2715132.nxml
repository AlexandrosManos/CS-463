tation></ref><ref id="bib11"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Saksouk</surname><given-names>N.</given-names></name><name><surname>Bhatti</surname><given-names>M.M.</given-names></name><name><surname>Kieffer</surname><given-names>S.</given-names></name><name><surname>Smith</surname><given-names>A.T.</given-names></name><name><surname>Musset</surname><given-names>K.</given-names></name><name><surname>Garin</surname><given-names>J.</given-names></name><name><surname>Sullivan</surname><given-names>W.J.</given-names><suffix>Jr.</suffix></name><name><surname>Cesbron-Delauw</surname><given-names>M.F.</given-names></name><name><surname>Hakimi</surname><given-names>M.A.</given-names></name></person-group><year>2005</year><article-title>Histone-modifying complexes regulate gene expression pertinent to the differentiation of the protozoan parasite <italic>Toxoplasma gondii</italic></article-title>.<source>Mol. Cell. Biol.</source><volume>25</volume>:<fpage>10301</fpage>&#x02013;<lpage>10314</lpage><pub-id pub-id-type="pmid">16287846</pub-id></mixed-citation></ref><ref id="bib12"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Boyle</surname><given-names>J.P.</given-names></name><name><surname>Rajasekar</surname><given-names>B.</given-names></name><name><surname>Saeij</surname><given-names>J.P.</given-names></name><name><surname>Ajioka</surname><given-names>J.W.</given-names></name><name><surname>Berriman</surname><given-names>M.</given-names></name><name><surname>Paulsen</surname><given-names>I.</given-names></name><name><surname>Roos</surname><given-names>D.S.</given-names></name><name><surname>Sibley</surname><given-names>L.D.</given-names></name><name><surname>White</surname><given-names>M.W.</given-names></name><name><surname>Boothroyd</surname><given-names>J.C.</given-names></name></person-group><year>2006</year><article-title>Just one cross appears capable