-names></name><name><surname>Tamura</surname><given-names>N</given-names></name><name><surname>Takaya</surname><given-names>M</given-names></name><name><surname>Kaneda</surname><given-names>K</given-names></name><name><surname>Hashimoto</surname><given-names>H</given-names></name><article-title>Churg-Strauss syndrome (CSS) in a patient receiving pranlukast</article-title><source>Clin Rheumatol</source><year>2003</year><volume>1</volume><fpage>5</fpage></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Tomac</surname><given-names>N</given-names></name><name><surname>Yuksek</surname><given-names>M</given-names></name><name><surname>Kunak</surname><given-names>B</given-names></name><name><surname>Ertan</surname><given-names>U</given-names></name><name><surname>Igde</surname><given-names>M</given-names></name><article-title>Churg-Strauss syndrome: a patient report in infancy</article-title><source>Clin Pediatr (Phila)</source><year>2003</year><volume>1</volume><fpage>5</fpage></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Turvey</surname><given-names>SE</given-names></name><name><surname>Vargas</surname><given-names>SO</given-names></name><name><surname>Phipatanakul</surname><given-names>W</given-names></name><article-title>Churg-Strauss syndrome in a 7-year-old receiving montelukast and inhaled corticosteroids</article-title><source>Ann Allergy Asthma Immunol</source><year>2003</year><volume>1</volume><fpage>5</fpage></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="journal"><name><surname>Fujita</surname><given-names>K</given-names></name><name><surname>Yamato</surname><given-names>K</given-names></name><name><surname>Kurihara</surname><given-names>T</given-names></name><etal/><article-title>A case of allergic granulomatosis and angiitis (Churg-Strauss syndrome) in a 15-year-old girl [in Japanese]</article-title><source>Nihon Kokyuki Gakkai Zasshi</source><year>2004</year><volume>1</volume><fpage>5</fpage></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="journal"><name><surname>Kashef</surname><given-names>S</given-names></name><name><surname>Alyasin</surname><given-names>S</given-names></name><name><surname>Kiani</surname><given-names>M</given-names></name><name><surname>Amin</surname><given-names>R</given-names></name><name><surname>Alborzi</surname><given-names>A</given-names></name><article-title>Churg-strauss syndrome in an 8-year-old girl</article-title><source>Iran J Allergy Asthma Immunol</source><year>2004</year><volume>1</volume><fpage>5</fpage></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="journal"><name><surname>Partal</surname><given-names>A</given-names></name><name><surname>Moshfeghi</surname><given-names>DM</given-names></name><name><surname>Alcorn</surname><given-names>D</given-names></name><article-title>Churg-Strauss syndrome in a child: retina and optic nerve findings</article-title><source>Br J Ophthalmol</source><year>2004</year><volume>1</volume><fpage>5</fpage><pub-id pub-id-type="doi">10.1136/bjo.88.1.5</pub-id><pub-id pub-id-type="pmid">14693759</pub-id></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="journal"><name><surname>Olowu</surname><given-names>WA</given-names></name><article-title>Nephropathy, polyneuropathy, and gastroenteritis in a child with Churg-Strauss syndrome</article-title><source>Clin Rheumatol</source><year>2007</year><volume>1</volume><fpage>5</fpage><pub-id pub-id-type="doi">10.1007/s10067-006-0288-0</pub-id><pub-id pub-id-type="pmid">16609822</pub-id></mixed-citation></ref><ref id="B19"><mixed-citation publication-type="journal"><name><surname>Rabusin</surname><given-names>M</given-names></name><name><surname>Lepore</surname><given-names>L</given-names></name><name><surname>Costantinides</surname><given-names>F</given-names></name><name><surname>Bussani</surname><given-names>R</given-names></name><articl