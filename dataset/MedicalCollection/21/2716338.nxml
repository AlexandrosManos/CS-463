itation citation-type="journal"><person-group person-group-type="author"><name><surname>Oliveira de Carvalho</surname><given-names>V</given-names></name><name><surname>Marinoni</surname><given-names>LP</given-names></name><name><surname>Martin</surname><given-names>F</given-names></name><etal></etal></person-group><article-title>Dermatological alterations in children with AIDS and their relation to clinical-immunological categories and viral load</article-title><source>An Bras Dermatol</source><year>2003</year><volume>78</volume><fpage>679</fpage><lpage>692</lpage></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Siriwan</surname><given-names>W</given-names></name><name><surname>Tawatchai</surname><given-names>D</given-names></name><name><surname>Chitsanu</surname><given-names>P</given-names></name><etal></etal></person-group><article-title>Mucocutaneous findings in Paediatric AIDS related to degree of immunosupression</article-title><source>Paediatric Dermatology</source><year>2003</year><volume>20</volume><fpage>289</fpage><pub-id pub-id-type="doi">10.1046/j.1525-1470.2003.20401.x</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Luminus</surname><given-names>LM</given-names></name><name><surname>Mardaresu</surname><given-names>M</given-names></name><name><surname>Petrea</surname><given-names>S</given-names></name><etal></etal></person-group><article-title>Cutaneous disorders in HIV infected children</article-title><source>International conference on AIDS</source><year>1998</year><volume>12</volume><fpage>574</fpage><comment>Absract No 32273</comment></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ziegler</surname><given-names>JL</given-names></name><name><surname>Katongole-Mbidde</surname><given-names>E</given-names></name></person-group><artic