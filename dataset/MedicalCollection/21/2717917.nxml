me><surname>Nishida</surname><given-names>Y</given-names></name><name><surname>Sakurai</surname><given-names>M</given-names></name><name><surname>Miura</surname><given-names>F</given-names></name><name><surname>Inoue</surname><given-names>M</given-names></name><name><surname>Mizutani</surname><given-names>K</given-names></name><name><surname>Takeuchi</surname><given-names>T</given-names></name><name><surname>Itabashi</surname><given-names>K</given-names></name><name><surname>Ozawa</surname><given-names>K</given-names></name><name><surname>Takase</surname><given-names>M</given-names></name></person-group><article-title>Accuracy of creamatocrit technique and its efficacy in preterm infants' management</article-title><source>Journal of the Japan Pediatric Society</source><year>2006</year><volume>110</volume><fpage>1242</fpage><lpage>1246</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>R&#x000fc;egg</surname><given-names>M</given-names></name><name><surname>Blanc</surname><given-names>B</given-names></name></person-group><article-title>The fat globule size distribution in human milk</article-title><source>Biochim Biophys Acta</source><year>1981</year><volume>666</volume><fpage>7</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">7295765</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simonin</surname><given-names>C</given-names></name><name><surname>R&#x000fc;egg</surname><given-names>M</given-names></name><name><surname>Sidiropoulos</surname><given-names>D</given-names></name></person-group><article-title>Comparison of the fat content and fat globule size distribution of breast milk from mothers delivering term and preterm</article-title><source>Am J Clin Nutr</source><year>1984</year><volume>40</volume><fpage>820</fpage><lpage>826</lpage><pub-id pub-id-type="pmid">6486089</pub-id></citation></ref><ref id="B22"