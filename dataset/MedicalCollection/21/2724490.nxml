ources Development Journal</source><year>2000</year><volume>4</volume><fpage>25</fpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sempowski</surname><given-names>IP</given-names></name></person-group><article-title>Effectiveness of financial incentives in exchange for rural and underserviced area return-of-service commitments: systematic review of the literature</article-title><source>Canadian Journal of Rural Medicine</source><year>2004</year><volume>9</volume><fpage>82</fpage><lpage>88</lpage><pub-id pub-id-type="pmid">15603680</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eisenberg</surname><given-names>B</given-names></name><name><surname>Cantwell</surname><given-names>J</given-names></name></person-group><article-title>Policies to influence the spacial distribution of physicians: a conceptual review of selected programs and empirical evidence</article-title><source>Medical Care</source><year>1976</year><volume>14</volume><fpage>455</fpage><lpage>468</lpage><pub-id pub-id-type="pmid">933577</pub-id><pub-id pub-id-type="doi">10.1097/00005650-197606000-00001</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kristiansen</surname><given-names>IS</given-names></name><name><surname>Forde</surname><given-names>OH</given-names></name></person-group><article-title>Medical specialists' choice of location: the role of geographical attachment in Norway</article-title><source>Soc Sci Med</source><year>1992</year><volume>34</volume><fpage>57</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">1738857</pub-id><pub-id pub-id-type="doi">10.1016/0277-9536(92)90067-Z</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dr&#x000e4;ger</surname><given-names>S</given-names><