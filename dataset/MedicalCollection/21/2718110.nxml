"><name><surname>Pelot</surname><given-names>D</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Haurich</surname><given-names>WS</given-names></name><name><surname>Schaffner</surname><given-names>F</given-names></name><name><surname>Berk</surname><given-names>JE</given-names></name></person-group><article-title>Anatomy, anomalies, and physiology of the esophagus</article-title><source>Bockus Gastroenterology</source><year>1995</year><edition>5th ed</edition><publisher-loc>Philadelphia</publisher-loc><publisher-name>Saunders</publisher-name><fpage>397</fpage><lpage>411</lpage></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Evans</surname><given-names>HL</given-names></name></person-group><article-title>Smooth muscle tumors of the gastrointestinal tract. A study of 56 cases followed for a minimum 10 years</article-title><source>Cancer</source><year>1985</year><volume>56</volume><fpage>2242</fpage><lpage>2250</lpage><pub-id pub-id-type="pmid">4052969</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lewis</surname><given-names>B</given-names></name><name><surname>Maxfield</surname><given-names>RG</given-names></name></person-group><article-title>Leiomyoma of the esophagus: Case report and review of the literature</article-title><source>Int Abstr Surg</source><year>1954</year><volume>99</volume><fpage>105</fpage><lpage>128</lpage><pub-id pub-id-type="pmid">13187207</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Godard</surname><given-names>JE</given-names></name><name><surname>McCranie</surname><given-names>D</given-names></name></person-group><article-title>Multiple leiomyomas of the esophagus<