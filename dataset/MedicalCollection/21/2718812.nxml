lspan="1">&#x02212;14.41</td></tr><tr><td align="left" rowspan="1" colspan="1">Malayan</td><td align="left" rowspan="1" colspan="1">28</td><td align="left" rowspan="1" colspan="1">18(64)</td><td align="left" rowspan="1" colspan="1">35</td><td align="left" rowspan="1" colspan="1">0.8995 (0.051)</td><td align="left" rowspan="1" colspan="1">3.896(2.01)</td><td align="left" rowspan="1" colspan="1">20.69(10.04&#x02013; 43.44)</td><td align="left" rowspan="1" colspan="1">&#x02212;2.09</td><td align="left" rowspan="1" colspan="1">&#x02212;9.66</td></tr><tr><td align="left" rowspan="1" colspan="1">Mudiraj</td><td align="left" rowspan="1" colspan="1">79</td><td align="left" rowspan="1" colspan="1">61(77)</td><td align="left" rowspan="1" colspan="1">67</td><td align="left" rowspan="1" colspan="1">0.9880 (0.005)</td><td align="left" rowspan="1" colspan="1">5.492(2.67)</td><td align="left" rowspan="1" colspan="1">120.96(73.75&#x02013;203.17)</td><td align="left" rowspan="1" colspan="1">&#x02212;1.97</td><td align="left" rowspan="1" colspan="1">&#x02212;25.37</td></tr><tr><td align="left" rowspan="1" colspan="1">Munda</td><td align="left" rowspan="1" colspan="1">29</td><td align="left" rowspan="1" colspan="1">15(52)</td><td align="left" rowspan="1" colspan="1">30</td><td align="left" rowspan="1" colspan="1">0.9655 (0.012)</td><td align="left" rowspan="1" colspan="1">6.004 (2.94)</td><td align="left" rowspan="1" colspan="1">11.79(5.80&#x02013;23.89)</td><td align="left" rowspan="1" colspan="1">&#x02212;0.77(&#x02212;0.235)</td><td align="left" rowspan="1" colspan="1">&#x02212;2.57(.146)</td></tr><tr><td align="left" rowspan="1" colspan="1">Mutharsui</td><td align="left" rowspan="1" colspan="1">38</td><td align="left" rowspan="1" colspan="1">32(84)</td><td align="left" rowspan="1" colspan="1">44</td><td align="left" rowspan="1" colspan="1">0.9872 (0.010)</td><td align="left" rowspan="1" colspan="1">4.012(2.05)</td><td align="left" rowspan="1" colspan="1">92.86(43.64&#x02013;210.72