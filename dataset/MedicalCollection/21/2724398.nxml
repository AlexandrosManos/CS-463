up-type="author"><name><surname>Bostrom</surname><given-names>M</given-names></name><name><surname>Dellve</surname><given-names>L</given-names></name><name><surname>Thomee</surname><given-names>S</given-names></name><name><surname>Hagberg</surname><given-names>M</given-names></name></person-group><article-title>Risk factors for generally reduced productivity &#x02013; A prospective cohort study of young adults with neck or upper-extremity musculoskeletal symptoms</article-title><source>Scand J Work Environ Health</source><year>2008</year><volume>34</volume><fpage>120</fpage><lpage>132</lpage><pub-id pub-id-type="pmid">18470438</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mikkelsson</surname><given-names>M</given-names></name></person-group><article-title>One year outcome of preadolescents with fibromyalgia</article-title><source>J Rheum</source><year>1999</year><volume>26</volume><fpage>674</fpage><lpage>682</lpage><pub-id pub-id-type="pmid">10090181</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mikkelsson</surname><given-names>M</given-names></name><name><surname>Salminen</surname><given-names>JJ</given-names></name><name><surname>Kautiainen</surname><given-names>H</given-names></name></person-group><article-title>Non-specific musculoskeletal pain in preadolescents. Prevalence and 1-year persistence</article-title><source>Pain</source><year>1997</year><volume>73</volume><fpage>29</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">9414054</pub-id><pub-id pub-id-type="doi">10.1016/S0304-3959(97)00073-0</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Siivola</surname><given-names>SM</given-names></name><name><surname>Levoska</surname><given-names>S</given-names></name><name><surname>Latvala</surname><given-names>K</given-nam