d="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Giachino</surname><given-names>A</given-names></name></person-group><article-title>Relationship between deep-vein thrombosis in the calf and fatal pulmonary embolism</article-title><source>Can J Surg</source><year>1988</year><volume>31</volume><fpage>129</fpage><lpage>130</lpage><pub-id pub-id-type="pmid">3349377</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Guias</surname><given-names>B</given-names></name><name><surname>Simoni</surname><given-names>G</given-names></name><name><surname>Oger</surname><given-names>E</given-names></name><name><surname>Lemire</surname><given-names>A</given-names></name><name><surname>Leroyer</surname><given-names>C</given-names></name><name><surname>Mottier</surname><given-names>D</given-names></name><etal/></person-group><article-title>Calf muscle venous thrombosis and pulmonary embolism</article-title><source>J Mal Vasc</source><year>1999</year><volume>24</volume><fpage>132</fpage><lpage>134</lpage><pub-id pub-id-type="pmid">10399646</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hollerweger</surname><given-names>A</given-names></name><name><surname>Macheiner</surname><given-names>P</given-names></name><name><surname>Rettenbacher</surname><given-names>T</given-names></name><name><surname>Gritzmann</surname><given-names>N</given-names></name></person-group><article-title>Sonographic diagnosis of thrombosis of the calf muscle veins and the risk of pulmonary embolism</article-title><source>Ultraschall Med</source><year>2000</year><volume>21</volume><fpage>66</fpage><lpage>72</lpage><pub-id pub-id-type="pmid">10838706</pub-id></element-citation></ref><ref id="B9"><label>9</label><element