n="1">yes</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">n.d.</td><td rowspan="1" colspan="1">+</td><td rowspan="1" colspan="1">n.d.</td><td rowspan="1" colspan="1">SR (1)</td><td rowspan="1" colspan="1">CAGTGGTGCTT<xref ref-type="table-fn" rid="tblfn5">e</xref></td><td rowspan="1" colspan="1">GATTAGAGG</td><td rowspan="1" colspan="1">J5</td><td rowspan="1" colspan="1">n.a.</td><td rowspan="1" colspan="1">n.a.</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">&#x02013;</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">n.d.</td><td rowspan="1" colspan="1">+</td><td rowspan="1" colspan="1">n.d.</td><td rowspan="1" colspan="1">LR (1)</td><td rowspan="1" colspan="1">CAGACCTCCCCG<xref ref-type="table-fn" rid="tblfn5">e</xref></td><td rowspan="1" colspan="1">AGAACCCCGCATAAA</td><td rowspan="1" colspan="1">J6</td><td rowspan="1" colspan="1">&#x003bc;</td><td rowspan="1" colspan="1">1/1,526</td><td rowspan="1" colspan="1">0.7</td><td rowspan="1" colspan="1">&#x02013;</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">n.d.</td><td rowspan="1" colspan="1">&#x02212;</td><td rowspan="1" colspan="1">+</td><td rowspan="1" colspan="1">SR(4)/LR (1)</td><td rowspan="1" colspan="1">CCTCCTGCCCTCCTTCC<xref ref-type="table-fn" rid="tblfn5">e</xref></td><td rowspan="1" colspan="1">CCTTGGGGGGCT</td><td rowspan="1" colspan="1">J6</td><td rowspan="1" colspan="1">&#x003bc;</td><td rowspan="1" colspan="1">8/2,793</td><td rowspan="1" colspan="1">2.9</td><td rowspan="1" colspan="1">yes</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">n.d.</td><td rowspan="1" colspan="1">&#x02212;</td><td rowspan="1" colspan="1">+</td><td rowspan="1" colspan="1">SR(1)/LR (1)</td><td rowspan="1" colspan="1">CAGTGGTGCTT<xref ref-type="table-fn" rid="tblfn5">e</xref></td><td rowspan="1" colspan="1">GATTAGAGG</td><td rowspan="1" colspan="1">J5</td><td rowspan="1" colspan="1">&#x003bc;</td><td rowspan="1" colspan="1">2/2,966