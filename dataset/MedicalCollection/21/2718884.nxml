thor"><name><surname>Baker</surname><given-names>MG</given-names></name><name><surname>Fidler</surname><given-names>DP</given-names></name></person-group><article-title>Global Public Health Surveillance under New International Health Regulations</article-title><source>Emerging Infectious Diseases</source><year>2006</year><volume>12</volume><fpage>1058</fpage><lpage>1064</lpage><pub-id pub-id-type="pmid">16836821</pub-id></citation></ref><ref id="B10"><citation citation-type="other"><person-group person-group-type="author"><collab>World Health Organization</collab></person-group><article-title>Fifty-First Regional Committee of South-East Asia Region</article-title><source>International Health Regulations</source><year>1998</year><ext-link ext-link-type="uri" xlink:href="http://www.searo.who.int/en/Section1430/Section1439/Section1638/Section2410_13351.htm"/><comment>SEA/RC51/11 [cited 6/20/08]</comment></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><collab>Revision of the International Health Regulations</collab></person-group><article-title>Progress Report, February 2001</article-title><source>WHO Weekly Epidemiologic Record</source><year>2001</year><volume>8</volume><fpage>57</fpage><lpage>64</lpage></citation></ref><ref id="B12"><citation citation-type="other"><person-group person-group-type="author"><collab>Ministry of Public Health</collab></person-group><article-title>Republic of Lebanon</article-title><ext-link ext-link-type="uri" xlink:href="http://www.public-health.gov.lb"/><comment>[cited June 17, 2008]</comment></citation></ref><ref id="B13"><citation citation-type="other"><person-group person-group-type="author"><collab>The Pan American Health Organization</collab></person-group><article-title>Vth Meeting of the Surveillance Network for Emerging Infectious Diseases in the Amazon Countries</article-title><source>Lima, Peru</source><year>2005</year><ext-link ext-link-type="uri" xlink:href="http://www