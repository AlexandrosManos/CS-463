<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Retrovirology</journal-id><journal-title>Retrovirology</journal-title><issn pub-type="epub">1742-4690</issn><publisher><publisher-name>BioMed Central</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">19457244</article-id><article-id pub-id-type="pmc">2717046</article-id><article-id pub-id-type="publisher-id">1742-4690-6-49</article-id><article-id pub-id-type="doi">10.1186/1742-4690-6-49</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research</subject></subj-group></article-categories><title-group><article-title>Tracing the HIV-1 subtype B mobility in Europe: a phylogeographic approach</article-title></title-group><contrib-group><contrib id="A1" corresp="yes" contrib-type="author"><name><surname>Paraskevis</surname><given-names>Dimitrios</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I2">2</xref><email>dparask@cc.uoa.gr</email></contrib><contrib id="A2" contrib-type="author"><name><surname>Pybus</surname><given-names>Oliver</given-names></name><xref ref-type="aff" rid="I3">3</xref><email>oliver.pybus@zoo.ox.ac.uk</email></contrib><contrib id="A3" contrib-type="author"><name><surname>Magiorkinis</surname><given-names>Gkikas</given-names></name><xref ref-type="aff" rid="I2">2</xref><email>gmagi@med.uoa.gr</email></contrib><contrib id="A4" contrib-type="author"><name><surname>Hatzakis</surname><given-names>Angelos</given-names></name><xref ref-type="aff" rid="I2">2</xref><email>ahatzak@med.uoa.gr</email></contrib><contrib id="A5" contrib-type="author"><name><surname>Wensing</surname><given-names>Annemarie MJ</given-names></name><xref ref-type="aff" rid="I4">4</xref><email>A.M.J.Wensing@umcutrecht.nl</email></contrib><contrib id="A6" contrib-type="author"><name><surname>van de Vijver</surname><given-names>David A</given-names></name><xref ref-type="aff" rid="I5">5</xref><email>d.vandevijver@erasmusmc.nl</email></contrib><contrib id="A7" contrib-type="author"><name><surname>Albert</surname><given-names>Jan</given-names></name><xref ref-type="aff" rid="I6">6</xref><xref ref-type="aff" rid="I7">7</xref><email>jan.albert@smi.ki.se</email></contrib><contrib id="A8" contrib-type="author"><name><surname>Angarano</surname><given-names>Guiseppe</given-names></name><xref ref-type="aff" rid="I8">8</xref><email>g.angarano@unifg.it</email></contrib><contrib id="A9" contrib-type="author"><name><surname>&#x000c5;sj&#x000f6;</surname><given-names>Birgitta</given-names></name><xref ref-type="aff" rid="I9">9</xref><email>Birgitta.Asjo@gades.uib.no</email></contrib><contrib id="A10" contrib-type="author"><name><surname>Balotta</surname><given-names>Claudia</given-names></name><xref ref-type="aff" rid="I10">10</xref><email>claudia.balotta@unimi.it</email></contrib><contrib id="A11" contrib-type="author"><name><surname>Boeri</surname><given-names>Enzo</given-names></name><xref ref-type="aff" rid="I11">11</xref><email>boeri.enzo@hsr.it</email></contrib><contrib id="A12" contrib-type="author"><name><surname>Camacho</surname><given-names>Ricardo</given-names></name><xref ref-type="aff" rid="I12">12</xref><email>ricardojcamacho@sapo.pt</email></contrib><contrib id="A13" contrib-type="author"><name><surname>Chaix</surname><given-names>Marie-Laure</given-names></name><xref ref-type="aff" rid="I13">13</xref><email>marie-laure.chaix@nck.ap-hop-paris.fr</email></contrib><contrib id="A14" contrib-type="author"><name><surname>Coughlan</surname><given-names>Suzie</given-names></name><xref ref-type="aff" rid="I14">14</xref><email>suzie.coughlan@ucd.ie</email></contrib><contrib id="A15" contrib-type="author"><name><surname>Costagliola</surname><given-names>Dominique</given-names></name><xref ref-type="aff" rid="I15">15</xref><email>dominique.costagliola@ccde.chups.jussieu.fr</email></contrib><contrib id="A16" contrib-type="author"><name><surname>De Luca</surname><given-names>Andrea</given-names></name><xref ref-type="aff" rid="I16">16</xref><email>andrea.deluca@rm.unicatt.it</email></contrib><contrib id="A17" contrib-type="author"><name><surname>de Mendoza</surname><given-names>Carmen</given-names></name><xref ref-type="aff" rid="I17">17</xref><email>cmendoza@teleline.es</email></contrib><contrib id="A18" contrib-type="author"><name><surname>Derdelinckx</surname><given-names>Inge</given-names></name><xref ref-type="aff" rid="I18">18</xref><email>inge.derdelinckx@uz.kuleuven.ac.be</email></contrib><contrib id="A19" contrib-type="author"><name><surname>Grossman</surname><given-names>Zehava</given-names></name><xref ref-type="aff" rid="I19">19</xref><email>Zehava.Grossman@sheba.health.gov.il</email></contrib><contrib id="A20" contrib-type="author"><name><surname>Hamouda</surname><given-names>Osama</given-names></name><xref ref-type="aff" rid="I20">20</xref><email>HamoudaO@rki.de</email></contrib><contrib id="A21" contrib-type="author"><name><surname>Hoepelman</surname><given-names>IM</given-names></name><xref ref-type="aff" rid="I21">21</xref><email>I.M.Hoepelman@umcutrecht.nl</email></contrib><contrib id="A22" contrib-type="author"><name><surname>Horban</surname><given-names>Andrzej</given-names></name><xref ref-type="aff" rid="I22">22</xref><email>ahorban@cdit-aids.med.pl</email></contrib><contrib id="A23" contrib-type="author"><name><surname>Korn</surname><given-names>Klaus</given-names></name><xref ref-type="aff" rid="I23">23</xref><email>Klaus.Korn@viro.med.uni-erlangen.de</email></contrib><contrib id="A24" contrib-type="author"><name><surname>K&#x000fc;cherer</surname><given-names>Claudia</given-names></name><xref ref-type="aff" rid="I20">20</xref><email>KuechererC@rki.de</email></contrib><contrib id="A25" contrib-type="author"><name><surna