><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamilton</surname><given-names>HJ</given-names></name><name><surname>Gallagher</surname><given-names>PF</given-names></name><name><surname>O'Mahony</surname><given-names>D</given-names></name></person-group><article-title>Inappropriate prescribing and adverse drug events in older people</article-title><source>BMC Geriatrics</source><year>2009</year><volume>9</volume><fpage>5</fpage><pub-id pub-id-type="pmid">19175914</pub-id><pub-id pub-id-type="doi">10.1186/1471-2318-9-5</pub-id></citation></ref></ref-list></back></article>