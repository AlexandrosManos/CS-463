ditor"><name><surname>Meyers C</surname></name></person-group><article-title>Chapter 7: Human Papillomavirus Infection and Disease in HIV+ Individual</article-title><source>Aids-Associated Viral Oncogenesis</source><year>2007</year><publisher-name>New York: Sprinter Science+Business Media</publisher-name><fpage>185</fpage><lpage>214</lpage></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>King</surname><given-names>MD</given-names></name><name><surname>Reznik</surname><given-names>DA</given-names></name><name><surname>O'Daniels</surname><given-names>CM</given-names></name><name><surname>Larsen</surname><given-names>NM</given-names></name><name><surname>Osterholt</surname><given-names>D</given-names></name><name><surname>Blumberg</surname><given-names>HM</given-names></name></person-group><article-title>Human papillomavirus-associated oral warts among human immunodeficiency virus-seropositive patients in the era of highly active antiretroviral therapy: an emerging infection</article-title><source>Clin Infect Dis</source><year>2002</year><volume>34</volume><fpage>641</fpage><lpage>648</lpage><pub-id pub-id-type="pmid">11803508</pub-id><pub-id pub-id-type="doi">10.1086/338637</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leigh</surname><given-names>J</given-names></name></person-group><article-title>Oral warts rise dramatically with use of new agents in HIV</article-title><source>HIV Clin</source><year>2000</year><volume>12</volume><fpage>7</fpage><pub-id pub-id-type="pmid">11810834</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Greenspan</surname><given-names>D</given-names></name><name><surname>Canchola</surname><given-names>AJ</given-names></name><name><surname>MacPhail</surname><given-names>LA</given-names></name><name><surname>Cheikh</