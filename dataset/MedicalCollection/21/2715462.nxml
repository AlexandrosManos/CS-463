="char">0.4977</td><td char="." align="char">0.5008</td><td char="." align="char">0.0789</td><td char="(" align="char">4.38 (2.17, 2.21)</td><td char="." align="char">0.3075</td></tr><tr><td align="left"/><td char="." align="char">70</td><td char="." align="char">70</td><td char="." align="char">0.4978</td><td char="." align="char">0.4996</td><td char="." align="char">0.0655</td><td char="(" align="char">4.80 (2.36, 2.44)</td><td char="." align="char">0.2558</td></tr><tr><td align="left"/><td char="." align="char">120</td><td char="." align="char">120</td><td char="." align="char">0.4982</td><td char="." align="char">0.4994</td><td char="." align="char">0.0582</td><td char="(" align="char">5.26 (2.83, 2.43)</td><td char="." align="char">0.2275</td></tr><tr><td align="left">0.7</td><td char="." align="char">40</td><td char="." align="char">40</td><td char="." align="char">0.6974</td><td char="." align="char">0.7001</td><td char="." align="char">0.0658</td><td char="(" align="char">4.67 (2.43, 2.24)</td><td char="." align="char">0.2587</td></tr><tr><td align="left"/><td char="." align="char">70</td><td char="." align="char">70</td><td char="." align="char">0.6988</td><td char="." align="char">0.7003</td><td char="." align="char">0.0531</td><td char="(" align="char">4.69 (2.41, 2.28)</td><td char="." align="char">0.2085</td></tr><tr><td align="left"/><td char="." align="char">120</td><td char="." align="char">120</td><td char="." align="char">0.6987</td><td char="." align="char">0.6997</td><td char="." align="char">0.0455</td><td char="(" align="char">5.29 (2.51, 2.78)</td><td char="." align="char">0.1786</td></tr><tr><td align="left">0.9</td><td char="." align="char">40</td><td char="." align="char">40</td><td char="." align="char">0.8979</td><td char="." align="char">0.8991</td><td char="." align="char">0.0391</td><td char="(" align="char">3.78 (2.32, 1.46)</td><td char="." align="char">0.1618</td></tr><tr><td align="left"/><td char="." align="char">70</td><td char="." align="char">70</td><td char="." align="char">0.8994</td><td char="." align="char">0.9001</td><td char="." align="char">0.0309</td><td char="(" align="char">4.28 (2.43, 1.85)</td><td char="." align="char">0.1253</td></tr><tr><td align="left"/><td char="." align="char">120</td><td char="." align="char">120</td><td char="." align="char">0.8997</td><td char="." align="char">0.9001</td><td char="." align="char">0.0259</td><td char="(" align="char">4.62 (2.44, 2.18)</td><td char="." align="char">0.1040</td></tr><tr><td align="left">0.95</td><td char="." align="char">40</td><td char="." align="char">40</td><td char="." align="char">0.9495</td><td char="." align="char">0.9501</td><td char="." align="char">0.0267</td><td char="(" align="char">5.26 (1.74, 3.52)</td><td char="." align="char">0.1188</td></tr><tr><td align="left"/><td char="." align="char">70</td><td char="." align="char">70</td><td char="." align="char">0.9497</td><td char="." align="char">0.9500</td><td char="." align="char">0.0215</td><td char="(" align="char">4.02 (2.21, 1.81)</td><td char="." align="char">0.0914</td></tr><tr><td align="left"/><td char="." align="char">120</td><td char="." align="char">120</td><td char="." align="char">0.9498</td><td char="." align="char">0.9500</td><td char="." align="char">0.0181</td><td char="(" align="char">4.43 (2.34, 2.09)</td><td char="." align="char">0.0749</td></tr><tr><td align="left">0.5</td><td char="." align="char">100</td><td char="." align="char">50</td><td char="." align="char">0.4978</td><td char="." align="char">0.4994</td><td char="." align="char">0.0600</td><td char="(" align="char">5.19 (2.60, 2.59)</td><td char="." align="char">0.2342</td></tr><tr><td align="left">0.5</td><td char="." align="char">100</td><td char="." align="char">80</td><td char="." align="char">0.4982</td><td char="." align="char">0.4997</td><td char="." align="char">0.0610</td><td char="(" align="char">5.09 (2.69, 2.40)</td><td char="." align="char">0.2381</td></tr><tr><td align="left">0.7</td><td char="." align="char">70</td><td char="." align="char">40</td><td char="." align="char">0.6981</td><td char="." align="char">0.6999</td><td char="." align="char">0.0551</td><td char="(" align="char">4.97 (2.37, 2.60)</td><td char="." align="char">0.2160</td></tr><tr><td align="left">0.7</td><td char="." align="char">80</td><td char="." align="char">70</td><td char="." align="char">0.6985</td><td char="." align="char">0.6999</td><td char="." align="char">0.0517</td><td char="(" align="char">4.94 (2.71, 2.23)</td><td char="." align="char">0.2030</td></tr></tbody></table><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="3" colspan="3"/><th align="left" colspan="5">Part II Results for truncated <inline-formula id="IEq209"><!-- Alternate image not processed: 122_2009_1047_Article_IEq209.gif --><tex-math id="M109">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{L}^{\rm mod} $$\end{document}</tex-math></inline-formula></th></tr><tr><th align="left" colspan="3">Median and SE</th><th align="left" colspan="2">95% BC<sub><italic>a</italic></sub> bootstrap ci</th></tr><tr><th align="left">Median</th><th align="left">Median after bias correction</th><th align="left">Bootstrap SE</th><th align="left">Non-coverage % (too low, too high)</th><th align="left">Length</th></tr></thead><tbody><tr><td align="left">0.0</td><td char="." align="char">40</td><td char="." align="char">40</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">0.0390</td><td char="(" align="char">2.40 (2.40)</td><td char="." align="char">0.1524</td></tr><tr><td align="left"/><td char="." align="char">70</td><td char="." align="char">70</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">0.0395</td><td char="(" align="char">2.49 (2.49)</td><td char="." align="char">0.1409</td></tr><tr><td align="left"/><td char="." align="char">120</td><td char="." align="char">120</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">0.0414</td><td char="(" align="char">2.56 (2.56)</td><td char="." align="char">0.1419</td></tr><tr><td align="left">0.1</td><td char="." align="char">40</td><td char="." align="char">40</td><td char="." align="char">0.0982</td><td char="." align="char">0.0992</td><td char="." align="char">0.0652</td><td char="(" align="char">4.52 (2.28,2.24)</td><td char="." align="char">0.2510</td></tr><tr><td align="left"/><td char="." align="char">70</td><td char="." align="char">70</td><td char="." align="char">0.0997</td><td char="." align="char">0.1007</td><td char="." align="char">0.0621</td><td char="(" align="char">5.05 (2.50,2.55)</td><td char="." align="char">0.2311</td></tr><tr><td align="left"/><td char="." align="char">120</td><td char="." align="char">120</td><td char="." align="char">0.1002</td><td char="." align="char">0.1011</td><td char="." align="char">0.0618</td><td char="(" align="char">5.17 (2.93,2.24)</td><td char="." align="char">0.2249</td></tr><tr><td align="left">0.3</td><td char="." align="char">40</td><td char="." align="char">40</td><td char="." align="char">0.2985</td><td char="." align="char">0.3013</td><td char="." align="char">0.0821</td><td char="(" align="char">4.78 (2.34,2.44)</td><td char="." align="char">0.3204</td></tr><tr><td align="left"/><td char="." align="char">70</td><td char="." align="char">70</td><td char="." align="char">0.2999</td><td char="." align="char">0.3017</td><td char="." align="char">0.0716</td><td char="(" align="char">5.11 (2.43,2.68)</td><td char="." align="char">0.2798</td></tr><tr><td align="left"/><td char="." align="char">120</td><td char="." align="char">120</td><td char="." align="char">0.2986</td><td char="." align="char">0.2997</td><td char="." align="char">0.0670</td><td char="(" align="char">5.14 (2.56,2.58)</td><td char="." align="char">0.2618</td></tr></tbody></table><table-wrap-foot><p>Part I shows mean, mean after bias correction, mean of the bootstrap standard error, non-coverage percentage of 95% BC<sub><italic>a</italic></sub> bootstrap confidence intervals (with left and right non-coverage percentages), and mean length of the interval. Part II shows, for <italic>p</italic><sub>gs</sub>&#x000a0;&#x02264;&#x000a0;0.3, the same type of results as part I, but for <inline-formula id="IEq207"><!-- Alternate image not processed: 122_2009_1047_Article_IEq207.gif --><tex-math id="M110">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{L}^{\rm mod} $$\end{document}</tex-math></inline-formula> truncated at zero. Instead of means, medians are given. At <italic>p</italic><sub>gs</sub>&#x000a0;=&#x000a0;0.0, only non-coverage at the right of <italic>p</italic><sub>gs</sub>&#x000a0;=&#x000a0;0.0 is considered</p></table-wrap-foot></table-wrap><list list-type="order"><list-item><p>Almost all of the bias of the original Dice coefficient is removed. <inline-formula id="IEq95"><!-- Alternate image not processed: 122_2009_1047_Article_IEq95.gif --><tex-math id="M111">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{{\bar{L}}}^{\rm mod} $$\end{document}</tex-math></inline-formula> and <inline-formula id="IEq96"><!-- Alternate image not processed: 122_2009_1047_Article_IEq96.gif --><tex-math id="M112">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{L}^{\rm mod} $$\end{document}</tex-math></inline-formula> slightly underestimate <italic>p</italic><sub>gs</sub> now (mean observed biases &#x02212;0.0018 and &#x02212;0.0015, averaged over all settings of <italic>p</italic><sub>gs</sub> and <italic>m</italic>, for <inline-formula id="IEq97"><!-- Alternate image not processed: 122_2009_1047_Article_IEq97.gif --><tex-math id="M113">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{{\bar{L}}}^{\rm mod} $$\end{document}</tex-math></inline-formula> and <inline-formula id="IEq98"><!-- Alternate image not processed: 122_2009_1047_Article_IEq98.gif --><tex-math id="M114">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{L}^{\rm mod} $$\end{document}</tex-math></inline-formula>, respectively), with largest observed bias equal to &#x02212;0.0030 occurring for <inline-formula id="IEq99"><!-- Alternate image not processed: 122_2009_1047_Article_IEq99.gif --><tex-math id="M115">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{{\bar{L}}}^{\rm mod} $$\end{document}</tex-math></inline-formula> in case <italic>p</italic><sub>gs</sub>&#x000a0;=&#x000a0;0 and <italic>m</italic>&#x000a0;=&#x000a0;120. The remaining small negative bias can be removed even further by using a bootstrap bias correction. Mean observed biases are then &#x02212;0.00058 and &#x02212;0.00025.</p></list-item><list-item><p> The 95% (BC<sub><italic>a</italic></sub> bootstrap) confidence intervals for the genetic similarity <italic>p</italic><sub>gs</sub> show reasonably good coverage properties. In 21 and 18 out of the 25 experimental settings the observed non-coverage is between 4.5 and 5.5%, hence deviations less than 0.5% from the nominal value of 5%. For both estimators the largest deviation from 5% is found for <italic>p</italic><sub>gs</sub>&#x000a0;=&#x000a0;0.90 and <italic>m</italic>&#x000a0;=&#x000a0;40, with observed non-coverages of 3.8 and 3.8%, respectively. In these cases the confidence intervals are slightly too wide. For <italic>p</italic><sub>gs</sub>&#x000a0;=&#x000a0;0.95 and <italic>m</italic>&#x000a0;=&#x000a0;40 the overall non-coverage behaves better (5.2 and 5.3%), but we find that in 1.6 and 1.7% of the cases the confidence intervals are too low, and in 3.6 and 3.5% too high, compared to the nominal 2.5 and 2.5%. In this case the intervals are too wide if the estimate is smaller than <italic>p</italic><sub>gs</sub>&#x000a0;=&#x000a0;0.95, and too narrow for estimates larger than 0.95.</p></list-item><list-item><p>The bootstrap standard errors of <inline-formula id="IEq100"><!-- Alternate image not processed: 122_2009_1047_Article_IEq100.gif --><tex-math id="M116">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{{\bar{L}}}^{\rm mod} $$\end{document}</tex-math></inline-formula> and <inline-formula id="IEq101"><!-- Alternate image not processed: 122_2009_1047_Article_IEq101.gif --><tex-math id="M117">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{L}^{\rm mod} $$\end{document}</tex-math></inline-formula> are smaller for larger number of expected fragments, with the exception of <italic>p</italic><sub>gs</sub>&#x000a0;=&#x000a0;0 and <italic>p</italic><sub>gs</sub>&#x000a0;=&#x000a0;0.1. Hence, in the examples for <italic>p</italic><sub>gs</sub>&#x000a0;&#x0003e;&#x000a0;0.1 larger fragment counts result in more precise estimates. The same can be said for the lengths of the 95% confidence intervals. If <italic>p</italic><sub>gs</sub>&#x000a0;=&#x000a0;0.1 the smallest standard error is observed for <italic>m</italic>&#x000a0;=&#x000a0;70</p></list-item><list-item><p>The estimates <inline-formula id="IEq102"><!-- Alternate image not processed: 122_2009_1047_Article_IEq102.gif --><tex-math id="M118">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{{\bar{L}}}^{\rm mod} $$\end{document}</tex-math></inline-formula> and <inline-formula id="IEq103"><!-- Alternate image not processed: 122_2009_1047_Article_IEq103.gif --><tex-math id="M119">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{L}^{\rm mod} $$\end{document}</tex-math></inline-formula> may become negative for small values of <italic>p</italic><sub>gs</sub>. In the table this can be seen for <italic>p</italic><sub>gs</sub>&#x000a0;=&#x000a0;0, resulting in a negative average of <italic>D</italic><sup>mod</sup>, but it also occurs for <italic>p</italic><sub>gs</sub>&#x000a0;=&#x000a0;0.1. For <italic>p</italic><sub>gs</sub>&#x000a0;=&#x000a0;0.3 the lower bound of the 95% confidence interval may become negative. In practice a negative value of <italic>D</italic><sup>mod</sup> would be truncated at 0. Therefore, we added the bottom parts II of Tables&#x000a0;<xref rid="Tab2" ref-type="table">2</xref> and <xref rid="Tab3" ref-type="table">3</xref>, showing results for the truncated versions of <inline-formula id="IEq104"><!-- Alternate image not processed: 122_2009_1047_Article_IEq104.gif --><tex-math id="M120">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{{\bar{L}}}^{\rm mod} $$\end{document}</tex-math></inline-formula> and <inline-formula id="IEq105"><!-- Alternate image not processed: 122_2009_1047_Article_IEq105.gif --><tex-math id="M121">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{L}^{\rm mod} $$\end{document}</tex-math></inline-formula> for <italic>p</italic><sub>gs</sub>&#x000a0;=&#x000a0;0.0, 0.1, and 0.3. Since the truncation causes more distributional asymmetry we give medians instead of averages of <inline-formula id="IEq106"><!-- Alternate image not processed: 122_2009_1047_Article_IEq106.gif --><tex-math id="M122">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{{\bar{L}}}^{\rm mod} $$\end{document}</tex-math></inline-formula> and <inline-formula id="IEq107"><!-- Alternate image not processed: 122_2009_1047_Article_IEq107.gif --><tex-math id="M123">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{L}^{\rm mod} $$\end{document}</tex-math></inline-formula>. For <inline-formula id="IEq108"><!-- Alternate image not processed: 122_2009_1047_Article_IEq108.gif --><tex-math id="M124">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{{\bar{L}}}^{\rm mod} $$\end{document}</tex-math></inline-formula> the bias-correction decreases the bias, but this is not always the case for <inline-formula id="IEq109"><!-- Alternate image not processed: 122_2009_1047_Article_IEq109.gif --><tex-math id="M125">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{L}^{\rm mod} $$\end{document}</tex-math></inline-formula>. For <italic>p</italic><sub>gs</sub>&#x000a0;=&#x000a0;0 we give the non-coverage of the (97.5%) confidence interval only at the right of <italic>p</italic><sub>g</sub>&#x000a0;=&#x000a0;0. For <italic>p</italic><sub>gs</sub>&#x000a0;=&#x000a0;0 we observe the largest standard errors for the cases with largest <italic>m</italic>, suggesting that the optimal number of fragments is smaller than <italic>m</italic>&#x000a0;=&#x000a0;120.</p></list-item><list-item><p>In all cases <inline-formula id="IEq110"><!-- Alternate image not processed: 122_2009_1047_Article_IEq110.gif --><tex-math id="M126">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{{\bar{L}}}^{\rm mod} $$\end{document}</tex-math></inline-formula> has narrower 95% confidence intervals than <inline-formula id="IEq111"><!-- Alternate image not processed: 122_2009_1047_Article_IEq111.gif --><tex-math id="M127">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{L}^{\rm mod} $$\end{document}</tex-math></inline-formula>, although differences are small (average difference in length is only 0.0019). In all cases the bootstrap SE(<inline-formula id="IEq112"><!-- Alternate image not processed: 122_2009_1047_Article_IEq112.gif --><tex-math id="M128">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{{\bar{L}}}^{\rm mod} $$\end{document}</tex-math></inline-formula>)&#x000a0;&#x02264;&#x000a0;SE(<inline-formula id="IEq113"><!-- Alternate image not processed: 122_2009_1047_Article_IEq113.gif --><tex-math id="M129">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{L}^{\rm mod}$$\end{document}</tex-math></inline-formula>), but again differences are small. The coverage of the 95% confidence interval of <inline-formula id="IEq114"><!-- Alternate image not processed: 122_2009_1047_Article_IEq114.gif --><tex-math id="M130">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{{\bar{L}}}^{\rm mod} $$\end{document}</tex-math></inline-formula> is slightly better than that of <inline-formula id="IEq115"><!-- Alternate image not processed: 122_2009_1047_Article_IEq115.gif --><tex-math id="M131">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{L}^{\rm mod} $$\end{document}</tex-math></inline-formula>: average absolute deviation from the nominal 5% is 0.33% for <inline-formula id="IEq116"><!-- Alternate image not processed: 122_2009_1047_Article_IEq116.gif --><tex-math id="M132">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{{\bar{L}}}^{\rm mod} $$\end{document}</tex-math></inline-formula> compared to 0.36% for <inline-formula id="IEq117"><!-- Alternate image not processed: 122_2009_1047_Article_IEq117.gif --><tex-math id="M133">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{L}^{\rm mod} $$\end{document}</tex-math></inline-formula>. Intuitively better behavior of <inline-formula id="IEq118"><!-- Alternate image not processed: 122_2009_1047_Article_IEq118.gif --><tex-math id="M134">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{L}^{\rm mod} $$\end{document}</tex-math></inline-formula> was expected, since <inline-formula id="IEq119"><!-- Alternate image not processed: 122_2009_1047_Article_IEq119.gif --><tex-math id="M135">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{L}^{\rm mod} $$\end{document}</tex-math></inline-formula> exploits band length information, but we conclude, surprisingly, that <inline-formula id="IEq120"><!-- Alternate image not processed: 122_2009_1047_Article_IEq120.gif --><tex-math id="M136">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{{\bar{L}}}^{\rm mod} $$\end{document}</tex-math></inline-formula> has slightly better characteristics than <inline-formula id="IEq121"><!-- Alternate image not processed: 122_2009_1047_Article_IEq121.gif --><tex-math id="M137">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{L}^{\rm mod} $$\end{document}</tex-math></inline-formula></p></list-item></list></p></sec><sec id="Sec18"><title>Results from the simulation study for maximum likelihood estimators <italic>D</italic><sup>mle</sup></title><p>Table&#x000a0;<xref rid="Tab4" ref-type="table">4</xref> shows the results from the simulation study for <inline-formula id="IEq122"><!-- Alternate image not processed: 122_2009_1047_Article_IEq122.gif --><tex-math id="M138">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D^{\rm mle} $$\end{document}</tex-math></inline-formula>. We notice the following.<table-wrap id="Tab4"><label>Table&#x000a0;4</label><caption><p>Results from a simulation study on <inline-formula id="IEq210"><!-- Alternate image not processed: 122_2009_1047_Article_IEq210.gif --><tex-math id="M139">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D^{\rm mle} $$\end{document}</tex-math></inline-formula> for a range of values of genetic similarity <italic>p</italic><sub>gs</sub> and expected numbers of fragments <italic>m</italic><sub>1</sub> and <italic>m</italic><sub>2,</sub> 10,000 replicated pairs of AFLP profiles, 1,000 bootstrap resamples, <italic>fld</italic><italic>F</italic><sub><italic>S</italic></sub> from <italic>A. thaliana</italic> with <italic>N</italic>&#x000a0;=&#x000a0;450</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2" colspan="3">Parameter settings</th><th align="left" colspan="8">Results for <inline-formula id="IEq211"><!-- Alternate image not processed: 122_2009_1047_Article_IEq211.gif --><tex-math id="M140">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D^{\rm mle} $$\end{document}</tex-math></inline-formula></th></tr><tr><th align="left" colspan="2"><inline-formula id="IEq212"><!-- Alternate image not processed: 122_2009_1047_Article_IEq212.gif --><tex-math id="M141">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{2}^{\rm mle} $$\end{document}</tex-math></inline-formula></th><th align="left" colspan="2">Wald ci</th><th align="left" colspan="2">Profile likelihood ci</th><th align="left" colspan="2">Back transformed Wald ci</th></tr><tr><th align="left"><italic>p</italic><sub>gs</sub></th><th align="left"><italic>m</italic><sub>1</sub></th><th align="left"><italic>m</italic><sub>2</sub></th><th align="left">Mean</th><th align="left">SE</th><th align="left">Non-coverage%<break/>(too low, too high)</th><th align="left">Length</th><th align="left">Non-coverage% (too low, too high)</th><th align="left">Length</th><th align="left">Non-coverage % (too low, too high)</th><th align="left">Length</th></tr></thead><tbody><tr><td align="left">0.0</td><td char="." alig