ent-citation></ref><ref id="B5"><label>5</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hiatt</surname><given-names>RA</given-names></name><name><surname>Ordonez</surname><given-names>JD</given-names></name></person-group><article-title>Dipstick urinalysis screening, asymptomatic microhematuria, and subsequent urological cancers in a population-based sample</article-title><source><italic>Cancer Epidemiology Biomarkers and Prevention</italic></source><year>1994</year><volume>3</volume><issue>5</issue><fpage>439</fpage><lpage>443</lpage></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cohen</surname><given-names>RA</given-names></name><name><surname>Brown</surname><given-names>RS</given-names></name></person-group><article-title>Microscopic hematuria</article-title><source><italic>The New England Journal of Medicine</italic></source><year>2003</year><volume>348</volume><issue>23</issue><fpage>2330</fpage><lpage>2338</lpage><pub-id pub-id-type="pmid">12788998</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sokolosky</surname><given-names>MC</given-names></name></person-group><article-title>Hematuria</article-title><source><italic>Emergency Medicine Clinics of North America</italic></source><year>2001</year><volume>19</volume><issue>3</issue><fpage>621</fpage><lpage>632</lpage><pub-id pub-id-type="pmid">11554278</pub-id></element-citation></ref><ref id="B9"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mohr</surname><given-names>DN</given-names></name><name><surname>Offord</surname><given-names>KP</given-names></name><name><surname>Owen</surname><given-names>RA</given-names></name><name><surname>Melton</surname><given-names>LJ</given-names><suffix>III</suffix></name></person-group><article-title>Asymptomatic microhematuria and urologic disease: a population-based study</article-title><source><italic>Journal of the American Medical Association</italic></source><year>1986</year><volume>256</volume><issue>2</issue><fpage>224</fpage><lpage>229</lpage><pub-id pub-id-type="pmid">3723707</pub-id></element-citation></ref><ref id="B10"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Fracchia</surname><given-names>JA</given-names></name><name><surname>Motta</surname><given-names>J</given-names></name><name><surname>Miller</surname><given-names>LS</given-names></name><name><surname>Armenakas</surname><given-names>NA</given-names></name><name><surname>Schumann</surname><given-names>G</given-names></name><name><surname>Greenberg</surname><given-names>RA</given-names></name></person-group><article-title>Evaluation of asymptomatic microhematuria</article-title><source><italic>Urology</italic></source><year>1995</year><volume>46</volume><issue>4</issue><fpage>484</fpage><lpage>489</lpage><pub-id pub-id-type="pmid">7571215</pub-id></element-citation></ref><ref id="B11"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sutton</surname><given-names>JM</given-names></name></person-group><article-title>Evaluation of hematuria in adults</article-title><source><italic>Journal of the American Medical Association</italic></source><year>1990</year><volume>263</volume><issue>18</issue><fpage>2475</fpage><lpage>2480</lpage><pub-id pub-id-type="pmid">2184261</pub-id></element-citation></ref><ref id="B13"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bhash</surname><given-names>R</given-names></name></person-group><article-title>Asymptomatic microscopic hematuria</article-title><source><italic>American Family Physician</italic></source><year>2000</year><volume>61</volume><fpage>p. 2611</fpage></element-citation></ref><ref id="B14"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Malmstr&#x000f6;m</surname><given-names>P-U</given-names></name></person-group><article-title>Time to abandon testing for microscopic haematuria in adults?</article-title><source><italic>British Medical Journal</italic></source><year>2003</year><volume>326</volume><issue>7393</issue><fpage>813</fpage><lpage>815</lpage><pub-id pub-id-type="pmid">12689982</pub-id></element-citation></ref><ref id="B15"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bard</surname><given-names>RH</given-names></name></person-group><article-title>The significance of asymptomatic microhematuria in women and its economic implications: a ten-year study</article-title><source><italic>Archives of Internal Medicine</italic></source><year>1988</year><volume>148</volume><issue>12</issue><fpage>2629</fpage><lpage>2632</lpage><pub-id pub-id-type="pmid">3196125</pub-id></element-citation></ref><ref id="B16"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Murakami</surname><given-names>S</given-names></name><name><surname>Igarashi</surname><given-names>T</given-names></name><name><surname>Hara</surname><given-names>S</given-names></name><name><surname>Shimazaki</surname><given-names>J</given-names></name></person-group><article-title>Strategies for asymptomatic microscopic hematuria: a prospective study of 1,034 patients</article-title><source><italic>Journal of Urology</italic></source><year>1990</year><volume>144</volume><issue>1</issue><fpage>99</fpage><lpage>101</lpage><pub-id pub-id-type="pmid">2193173</pub-id></element-citation></ref><ref id="B17"><label>15</label><element-citation publication-type="journal"><person-g