d-citation></ref><ref id="b18-btt-1-77"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Engstrom</surname><given-names>PF</given-names></name><name><surname>Arnoletti</surname><given-names>JP</given-names></name><name><surname>Benson</surname><given-names>AB</given-names></name><etal/></person-group><article-title>Colon cancer. National Comprehensive Cancer Network</article-title><source>NCCN Clinical Practice Guidelines in Oncology</source><volume>1</volume><year>2007</year></mixed-citation></ref><ref id="b19-btt-1-77"><note><p>ERBITUX<sup>&#x000ae;</sup> (Cetuximab) Package Insert. 2006. ImClone Systems Incorporated, New York, NY 10014 and Bristol-Myers Squibb Company, Princeton, NJ 08543; August 2006.</p></note></ref><ref id="b20-btt-1-77"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Fakih</surname><given-names>MG</given-names></name><name><surname>Wilding</surname><given-names>G</given-names></name><name><surname>Lombardo</surname><given-names>J</given-names></name></person-group><year>2006</year><article-title>Cetuximab-induced hypomagnesemia in patients with colorectal cancer</article-title><source>Clin Colorectal Cancer</source><volume>6</volume><fpage>152</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">16945172</pub-id></mixed-citation></ref><ref id="b21-btt-1-77"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Folprecht</surname><given-names>G</given-names></name><name><surname>Lutz</surname><given-names>MP</given-names></name><name><surname>Sch&#x000f6;ffski</surname><given-names>P</given-names></name><etal/></person-group><year>2006</year><article-title>Cetuximab and irinote-can/5-fluorouracil/folinic acid is a safe combination for the first-line treatment of patients with epidermal growth factor receptor expressing metastatic colorectal cancer</article-title><source>Ann Oncol</source><volume>17</vol