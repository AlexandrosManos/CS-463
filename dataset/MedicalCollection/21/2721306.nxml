-id pub-id-type="pmid">15269313</pub-id></mixed-citation></ref><ref id="b12-btt-1-77"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cunningham</surname><given-names>D</given-names></name><name><surname>Pyrh&#x000f6;nen</surname><given-names>S</given-names></name><name><surname>James</surname><given-names>RD</given-names></name><etal/></person-group><year>1998</year><article-title>Randomised trial of irinotecan plus supportive care versus supportive care alone after fluorouracil failure for patients with metastatic colorectal cancer</article-title><source>Lancet</source><volume>352</volume><fpage>1413</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">9807987</pub-id></mixed-citation></ref><ref id="b13-btt-1-77"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>de Gramont</surname><given-names>A</given-names></name><name><surname>Figer</surname><given-names>A</given-names></name><name><surname>Seymour</surname><given-names>M</given-names></name><etal/></person-group><year>2000</year><article-title>Leucovorin and fluorouracil with or without oxaliplatin as first-line treatment in advanced colorectal cancer</article-title><source>J Clin Oncol</source><volume>18</volume><fpage>2938</fpage><lpage>47</lpage><pub-id pub-id-type="pmid">10944126</pub-id></mixed-citation></ref><ref id="b14-btt-1-77"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>De Roock</surname><given-names>W</given-names></name><name><surname>De Schutter</surname><given-names>J</given-names></name><name><surname>De Hertogh</surname><given-names>G</given-names></name><etal/></person-group><year>2007</year><article-title>KRAS mutations preclude tumor shrinkage of colorectal cancers treated with cetuximab [abstract]</article-title><source>J Clin Oncol</source><volume>25</volume><issue>18S</issue><fpage>4132</fpage><comment>Abstract 4132</comment></mixed-citat