="journal"><name><surname>Crump</surname><given-names>E.M.</given-names></name><name><surname>Perry</surname><given-names>M.B.</given-names></name><name><surname>Clouthier</surname><given-names>S.C.</given-names></name><name><surname>Kay</surname><given-names>W.W.</given-names></name><article-title>Antigenic characterization of the fish pathogen <italic>Flavobacterium psychrophilum</italic></article-title><source>Appl. Environ. Microbiol.</source><year>2001</year><volume>67</volume><fpage>750</fpage><lpage>759</lpage><pub-id pub-id-type="pmid">11157240</pub-id></element-citation></ref><ref id="R14"><label>14</label><element-citation publication-type="journal"><name><surname>Figueiredo</surname><given-names>H.C.P.</given-names></name><name><surname>Klesius</surname><given-names>P.H.</given-names></name><name><surname>Arias</surname><given-names>C.R.</given-names></name><name><surname>Evans</surname><given-names>J.</given-names></name><name><surname>Shoemaker</surname><given-names>C.A.</given-names></name><name><surname>Pereira</surname><given-names>D.J.</given-names></name><name><surname>Peixoto</surname><given-names>M.T.D.</given-names></name><article-title>Isolation and characterization of strains of <italic>Flavobacterium columnare</italic> from Brazil</article-title><source>J. Fish Dis.</source><year>2005</year><volume>28</volume><fpage>199</fpage><lpage>204</lpage><pub-id pub-id-type="pmid">15813861</pub-id></element-citation></ref><ref id="R15"><label>15</label><element-citation publication-type="journal"><name><surname>Flemming</surname><given-names>L.</given-names></name><name><surname>Rawlings</surname><given-names>D.</given-names></name><name><surname>Chenia</surname><given-names>H.</given-names></name><article-title>Phenotypic and molecular characterisation of fish-borne <italic>Flavobacterium johnsoniae</italic>-like isolates from aquaculture systems in South Africa</article-title><source>Res. Microbiol.</source><year>2007</year><volume>158</volume><fpage>18</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">17113757</pub-id></element-citation></ref><ref id="R16"><label>16</label><element-citation publication-type="journal"><name><surname>Gomez-Consarnau</surname><given-names>L.</given-names></name><name><surname>Gonzalez</surname><given-names>J.M.</given-names></name><name><surname>Coll-Llado</surname><given-names>M.</given-names></name><name><surname>Gourdon</surname><given-names>P.</given-names></name><name><surname>Pascher</surname><given-names>T.</given-names></name><name><surname>Neutze</surname><given-names>R.</given-names></name><etal/><article-title>Light stimulates growth of proteorhodopsin-containing marine Flavobacteria</article-title><source>Nature</source><year>2007</year><volume>445</volume><fpage>210</fpage><lpage>213</lpage><pub-id pub-id-type="pmid">17215843</pub-id></element-citation></ref><ref id="R17"><label>17</label><element-citation publication-type="journal"><name><surname>Gupta</surname><given-names>R.S.</given-names></name><name><surname>Lorenzini</surname><given-names>E.</given-names></name><article-title>Phylogeny and molecular signatures (conserved proteins and indels) that are specific for the Bacteroidetes and Chlorobi species</article-title><source>BMC Evol. Biol.</source><year>2007</year><volume>7</volume><fpage>71</fpage><pub-id pub-id-type="pmid">17488508</pub-id></element-citation></ref><ref id="R18"><label>18</label><element-citation publication-type="journal"><name><surname>Izumi</surname><given-names>S.</given-names></name><name><surname>Aranishi</surname><given-names>F.</given-names></name><article-title>Relationship between gyrA mutations and quinolone resistance in <italic>Flavobacterium psychrophilum</italic> isolates</article-title><source>Appl. Environ. Microbiol.</source><year>2004</year><volume>70</volume><fpage>3968</fpage><lpage>3972</lpage><pub-id pub-id-type="pmid">15240271</pub-id></element-citation></ref><ref id="R19"><label>19</label><element-citation publicatio