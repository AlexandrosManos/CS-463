e>157</lpage><pub-id pub-id-type="pmid">8996101</pub-id><pub-id pub-id-type="doi">10.1016/S0378-1119(96)00546-X</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wassenaar</surname><given-names>T</given-names></name><name><surname>Fry</surname><given-names>B</given-names></name><name><surname>van der Zeijst</surname><given-names>BA</given-names></name></person-group><article-title>Genetic manipulation of <italic>Campylobacter</italic>: evaluation of natural transformation and electro-transformation</article-title><source>Gene</source><year>1993</year><volume>132</volume><fpage>131</fpage><lpage>135</lpage><pub-id pub-id-type="pmid">8406035</pub-id><pub-id pub-id-type="doi">10.1016/0378-1119(93)90525-8</pub-id></citation></ref></ref-list></back></article>