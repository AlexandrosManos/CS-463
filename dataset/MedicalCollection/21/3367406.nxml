><year>2004</year><volume>117</volume><fpage>791</fpage><lpage>795</lpage><pub-id pub-id-type="pmid">15541328</pub-id></element-citation></ref><ref id="b10-ijwh-4-213"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Christopher-Stine</surname><given-names>L</given-names></name><name><surname>Siedner</surname><given-names>M</given-names></name><name><surname>Lin</surname><given-names>J</given-names></name><etal/></person-group><article-title>Renal biopsy in lupus patients with low levels of proteinuria</article-title><source>J Rheumatol</source><year>2007</year><volume>34</volume><fpage>332</fpage><lpage>335</lpage><pub-id pub-id-type="pmid">17183619</pub-id></element-citation></ref><ref id="b11-ijwh-4-213"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Donadio</surname><given-names>JV</given-names><suffix>Jr</suffix></name><name><surname>Hart</surname><given-names>GM</given-names></name><name><surname>Bergstralh</surname><given-names>EJ</given-names></name><name><surname>Holley</surname><given-names>KE</given-names></name></person-group><article-title>Prognostic determinants in lupus nephritis: a long-term clinicopathologic study</article-title><source>Lupus</source><year>1995</year><volume>4</volume><fpage>109</fpage><lpage>115</lpage><pub-id pub-id-type="pmid">7795613</pub-id></element-citation></ref><ref id="b12-ijwh-4-213"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bono</surname><given-names>L</given-names></name><name><surname>Cameron</surname><given-names>JS</given-names></name><name><surname>Hicks</surname><given-names>JA</given-names></name></person-group><article-title>The very long-term prognosis and complications of lupus nephritis and its treatment</article-title><source>QJM</source><year>1999</year><volume>92</volume><fpage>211</fpage><lpage>218</lpage><pub-id pub-id-type="pmid">10396609</pub-id></element-citation></ref><ref id="b13-ijwh-4-213"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Neumann</surname><given-names>K</given-names></name><name><surname>Wallace</surname><given-names>DJ</given-names></name><name><surname>Azen</surname><given-names>C</given-names></name><etal/></person-group><article-title>Lupus in the 1980s: III. Influence of clinical variables, biopsy, and treatment on the outcome in 150 patients with lupus nephritis seen at a single center</article-title><source>Semin Arthritis Rheum</source><year>1995</year><volume>25</volume><fpage>47</fpage><lpage>55</lpage><pub-id pub-id-type="pmid">8525390</pub-id></element-citation></ref><ref id="b14-ijwh-4-213"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bakir</surname><given-names>AA</given-names></name><name><surname>Levy</surname><given-names>PS</given-names></name><name><surname>Dunea</surname><given-names>G</given-names></name></person-group><article-title>The prognosis of lupus nephritis in African-Americans: a retrospective analysis</article-title><source>Am J Kidney Dis</source><year>1994</year><volume>24</volume><fpage>159</fpage><lpage>171</lpage><pub-id pub-id-type="pmid">8048420</pub-id></element-citation></ref><ref id="b15-ijwh-4-213"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nossent</surname><given-names>HC</given-names></name><name><surname>Koldingsnes</surname><given-names>W</given-names></name></person-group><article-title>Long-term efficacy of azathioprine treatment for proliferative lupus nephritis</article-title><source>Rheumatology (Oxford)</source><year>2000</year><volume>39</volume><fpage>969</fpage><lpage>974</lpage><pub-id pub-id-type="pmid">10986301</pub-id></element-citation></ref><ref id="b16-ijwh-4-213"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Korbet</surname><given-names>SM</given-names></name><name><surname>Lewis</surname><given-names>EJ</given-names></name><name><surname>Schwartz</surname><given-names>MM</given-names></name><name><surname>Reichlin</surname><given-names>M</given-names></name><name><surname>Evans</surname><given-names>J</given-names></name><name><surname>Rohde</surname><given-names>RD</given-names></name></person-group><article-title>Factors predictive of outcome in severe lupus nephritis. Lupus Nephritis Collaborative Study Group</article-title><source>Am J Kidney Dis</source><year>2000</year><volume>35</volume><fpage>904</fpage><lpage>914</lpage><pub-id pub-id-type="pmid">10793026</pub-id></element-citation></ref><ref id="b17-ijwh-4-213"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mok</surname><given-names>CC</given-names></name></person-group><article-title>Prognostic factors in lupus nephritis</article-title><source>Lupus</source><year>2005</year><volume>14</volume><fpage>39</fpage><lpage>44</lpage><pub-id pub-id-type="pmid">15732286</pub-id></element-citation></ref><ref id="b18-ijwh-4-213"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mok</surname><given-names>CC</given-names></name><name><surname>Ying</surname><given-names>KY</given-names></name><name><surname>Ng</surname><given-names>WL</given-names></name><etal/></person-group><article-title>Long-term outcome of diffuse proliferative lupus glomerulonephritis treated with cyclophosphamide</article-title><source>Am J Med</source><year>2006</year><volume>119</volume><issue>4</issue><fpage>355. e25</fpage><lpage>e33</lpage><pub-id pub-id-type="pmid">16564783</pub-id></element-citation></ref><ref id="b19-ijwh-4-213"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mok</surname><given-names>CC</given-names></name><name><surname>Wong</surname><given-names>RW</given-names></name><name><surname>Lai</surname><given-names>KN</given-names></name></person-group><article-title>Treatment of severe proliferative lupus nephritis: the current state</article-title><source>Ann Rheum Dis</source><year>2003</year><volume>62</volume><fpage>799</fpage><lpage>804</lpage><pub-id pub-id-type="pmid">12922948</pub-id></element-citation></ref><ref id="b20-ijwh-4-213"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mok</surname><given-names>CC</given-names></name><name><surname>Birmingham</surname><given-names>DJ</given-names></name><name><surname>Leung</surname><given-names>HW</given-names></name><name><surname>Hebert</surname><given-names>LA</given-names></name><name><surname>Song</surname><given-names>H</given-names></name><name><surname>Rovin</surname><given-names>BH</given-names></name></person-group><article-title>Vitamin D levels in Chinese patients with systemic lupus erythematosus: relationship with disease activity, vascular risk factors and atherosclerosis</article-title><source>Rheumatology (Oxford)</source><year>2012</year><volume>51</volume><fpage>644</fpage><lpage>652</lpage><pub-id pub-id-type="pmid">21719424</pub-id></element-citation></ref><ref id="b21-ijwh-4-213"><label>21</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Weening</surname><given-names>JJ</given-names></name><name><surname>D&#x02019;Agati</surname><given-names>VD</given-names></name><name><surname>Schwartz</surname><given-names>MM</given-names></name><name><surname>Seshan</surname><given-names>SV</given-names></name><name><surname>Alpers</surname><given-names>CE</given-names></name><name><surname>Appel</surname><given-names>GB</given-names></name><etal/></person-group><article