pmid">1746279</pub-id><pub-id pub-id-type="doi">10.1111/j.1600-0447.1991.tb03151.x</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mino</surname><given-names>Y</given-names></name><name><surname>Aoyama</surname><given-names>H</given-names></name><name><surname>Froom</surname><given-names>J</given-names></name></person-group><article-title>Depressive disorders in Japanese primary care patients</article-title><source>Fam Pract</source><year>1994</year><volume>11</volume><issue>4</issue><fpage>363</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">7895962</pub-id><pub-id pub-id-type="doi">10.1093/fampra/11.4.363</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Waza</surname><given-names>K</given-names></name><name><surname>Graham</surname><given-names>AV</given-names></name><name><surname>Zyzanski</surname><given-names>SJ</given-names></name><name><surname>Inoue</surname><given-names>K</given-names></name></person-group><article-title>Comparison of symptoms in Japanese and American depressed primary care patients</article-title><source>Fam Pract</source><year>1999</year><volume>16</volume><issue>5</issue><fpage>528</fpage><lpage>33</lpage><pub-id pub-id-type="pmid">10533952</pub-id><pub-id pub-id-type="doi">10.1093/fampra/16.5.528</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maeno</surname><given-names>T</given-names></name><name><surname>Kizawa</surname><given-names>Y</given-names></name><name><surname>Ueno</surname><given-names>Y</given-names></name><name><surname>Nakata</surname><given-names>Y</given-names></name><name><surname>Sato</surname><given-names>T</given-names></name></person-group><article-title>Depression among primary care patients with complaints of headache and general fatigue</article-title><source>Prim Care Compaion J Clin Psychiatry</source><year>2002</year><volume>8</volume><issue>2</issue><fpage>69</fpage><lpage>72</lpage><pub-id pub-id-type="doi">10.1185/135525702125000976</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simon</surname><given-names>GE</given-names></name><name><surname>VonKorff</surname><given-names>M</given-names></name><name><surname>Piccinelli</surname><given-names>M</given-names></name><name><surname>Fullerton</surname><given-names>C</given-names></name><name><surname>Ormel</surname><given-names>J</given-names></name></person-group><article-title>An international study of the relation between somatic symptoms and depression</article-title><source>N Engl J Med</source><year>1999</year><volume>341</volume><issue>18</issue><fpage>1329</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">10536124</pub-id><pub-id pub-id-type="doi">10.1056/NEJM199910283411801</pub-id></citation></ref><ref id="B30"><citation citation-type="book"><person-group person-group-type="author"><collab>US Department of Health and Human Services</collab></person-group><source>Mental Health: Culture, race and ethnicity-A supplement to Mental Health: A report to the surgeon general</source><year>2001</year><publisher-name>Rockville, MD: Department of Health and Human Services, U.S. Public Health Service</publisher-name></citation></ref></ref-list></back></article>