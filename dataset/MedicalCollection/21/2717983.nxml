</ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tang</surname><given-names>A</given-names></name><name><surname>Sibley</surname><given-names>KM</given-names></name><name><surname>Bayley</surname><given-names>MT</given-names></name><name><surname>McIlroy</surname><given-names>WE</given-names></name><name><surname>Brooks</surname><given-names>D</given-names></name></person-group><article-title>Do Functional Walk Tests Reflect Cardiorespiratory Fitness in Sub-Acute Stroke?</article-title><source>J Neuroengineering Rehabil</source><year>2006</year><volume>3</volume><fpage>23</fpage><pub-id pub-id-type="doi">10.1186/1743-0003-3-23</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pang</surname><given-names>MY</given-names></name><name><surname>Eng</surname><given-names>JJ</given-names></name><name><surname>Dawson</surname><given-names>AS</given-names></name></person-group><article-title>Relationship between ambulatory capacity and cardiorespiratory fitness in chronic stroke</article-title><source>Chest</source><year>2005</year><volume>127</volume><fpage>495</fpage><lpage>501</lpage><pub-id pub-id-type="pmid">15705987</pub-id><pub-id pub-id-type="doi">10.1378/chest.127.2.495</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Patterson</surname><given-names>SL</given-names></name><name><surname>Forrester</surname><given-names>LW</given-names></name><name><surname>Rodgers</surname><given-names>MM</given-names></name><name><surname>Ryan</surname><given-names>AS</given-names></name><name><surname>Ivey</surname><given-names>FM</given-names></name><name><surname>Sorkin</surname><given-names>JD</given-names></name><name><surname>Macko</surname><given-names>RF</given-names></name></person-group><article-title>Determinants of walking function after stroke: differences by deficit severity</article-title><source>Arch Phys Med Rehabil</source><year>2007</year><volume>88</volume><fpage>115</fpage><lpage>119</lpage><pub-id pub-id-type="pmid">17207686</pub-id><pub-id pub-id-type="doi">10.1016/j.apmr.2006.10.025</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gage</surname><given-names>WH</given-names></name><name><surname>Zabjek</surname><given-names>KF</given-names></name><name><surname>Sibley</surname><given-names>KM</given-names></name><name><surname>Tang</surname><given-names>A</given-names></name><name><surname>Brooks</surname><given-names>D</given-names></name><name><surname>McIlroy</surname><given-names>WE</given-names></name></person-group><article-title>Ambulatory monitoring of activity levels of individuals in the sub-acute stage following stroke: a case series</article-title><source>J Neuroeng Rehabil </source><year>2007</year><volume>4</volume><fpage>41</fpage><pub-id pub-id-type="pmid">17961260</pub-id><pub-id pub-id-type="doi">10.1186/1743-0003-4-41</pub-id></citation></ref></ref-list></back></article>