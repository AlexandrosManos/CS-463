up> (<year>2008</year>). <article-title>Autism: many genes, common pathways?</article-title><source>Cell</source><volume>135</volume>, <fpage>391</fpage>&#x02013;<lpage>395</lpage><pub-id pub-id-type="doi">10.1016/j.cell.2008.10.016</pub-id><pub-id pub-id-type="pmid">18984147</pub-id></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Glessner</surname><given-names>J. T.</given-names></name><name><surname>Wang</surname><given-names>K.</given-names></name><name><surname>Cai</surname><given-names>G.</given-names></name><name><surname>Korvatska</surname><given-names>O.</given-names></name><name><surname>Kim</surname><given-names>C. E.</given-names></name><name><surname>Wood</surname><given-names>S.</given-names></name><name><surname>Zhang</surname><given-names>H.</given-names></name><name><surname>Estes</surname><given-names>A</given-names></name><etal/></person-group> (<year>2009</year>). <article-title>Autism genome-wide copy number variation reveals ubiquitin and neuronal genes</article-title>. <source>Nature</source><volume>459</volume>, <fpage>569</fpage>&#x02013;<lpage>573</lpage><pub-id pub-id-type="doi">10.1038/nature07953</pub-id><pub-id pub-id-type="pmid">19404257</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gliga</surname><given-names>T.</given-names></name><name><surname>Csibra</surname><given-names>G.</given-names></name></person-group> (<year>2007</year>). <article-title>Seeing the face through the eyes: a developmental perspective on face expertise</article-title>. <source>Prog. Brain Res.</source><volume>164</volume>, <fpage>323</fpage>&#x02013;<lpage>339</lpage><pub-id pub-id-type="doi">10.1016/S0079-6123(07)64018-7</pub-id><pub-id pub-id-type="pmid">17920440</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><person-group person-group-