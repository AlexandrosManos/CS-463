ation-type="journal"><person-group person-group-type="author"><name><surname>Barbera</surname><given-names>A</given-names></name><name><surname>Gudayol</surname><given-names>M</given-names></name><name><surname>Eto</surname><given-names>K</given-names></name><name><surname>Corominola</surname><given-names>H</given-names></name><name><surname>Maecheler</surname><given-names>P</given-names></name><etal/></person-group><year>2003</year><article-title>A high carbohydrate diet does not induce hyperglycaemia in a mitochondrial glycerol-3-phosphate dehydrogenase-deficient mouse.</article-title><source>Diabetologia</source><volume>46</volume><fpage>1394</fpage><lpage>1401</lpage><pub-id pub-id-type="pmid">13680126</pub-id></mixed-citation></ref><ref id="pone.0006676-Chagas1"><label>27</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chagas</surname><given-names>LM</given-names></name><name><surname>Lucy</surname><given-names>MC</given-names></name><name><surname>Back</surname><given-names>PJ</given-names></name><name><surname>Blache</surname><given-names>D</given-names></name><name><surname>Lee</surname><given-names>JM</given-names></name><etal/></person-group><year>2009</year><article-title>Insulin resistance in divergent strains of Holstein-Friesian dairy cows offered fresh pasture and increasing amounts of concentrate in early lactation.</article-title><source>J Dairy Sci</source><volume>92</volume><fpage>216</fpage><lpage>222</lpage><pub-id pub-id-type="pmid">19109281</pub-id></mixed-citation></ref></ref-list><fn-group><fn fn-type="conflict"><p><bold>Competing Interests: </bold>The authors have declared that no competing interests exist.</p></fn><fn fn-type="financial-disclosure"><p><bold>Funding: </bold>This work was funded under the Department of Primary Industries Victoria &#x0201c;Our Rural Landscapes&#x0201d; Initiative. USDA, ARS funding was from CRIS 1265-31000-098-00D, Enhancing Genetic Merit of Dairy Cattle through Genome Selection and Analysis. The funders had no role in study design, data collection and analysis, decision to publish, or preparation of the manuscript.</p></fn></fn-group></back></article>