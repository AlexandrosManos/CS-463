>J Occup Med</source><volume>35</volume><issue>9</issue><fpage>950</fpage><lpage>954</lpage><pub-id pub-id-type="pmid">8229349</pub-id></mixed-citation></ref><ref id="b9-ehp-117-1083"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>H&#x000f6;lzer</surname><given-names>J</given-names></name><name><surname>Midasch</surname><given-names>O</given-names></name><name><surname>Rauchfuss</surname><given-names>K</given-names></name><name><surname>Kraft</surname><given-names>M</given-names></name><name><surname>Reupert</surname><given-names>R</given-names></name><name><surname>Angerer</surname><given-names>J</given-names></name><etal/></person-group><year>2008</year><article-title>Biomonitoring of perfluorinated compounds in children and adults exposed to perfluorooctanoate-contaminated drinking water</article-title><source>Environ Health Perspect</source><volume>116</volume><fpage>651</fpage><lpage>657</lpage><pub-id pub-id-type="pmid">18470314</pub-id></mixed-citation></ref><ref id="b10-ehp-117-1083"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kannan</surname><given-names>K</given-names></name><name><surname>Corsolini</surname><given-names>S</given-names></name><name><surname>Falandysz</surname><given-names>J</given-names></name><name><surname>Fillmann</surname><given-names>G</given-names></name><name><surname>Kumar</surname><given-names>KS</given-names></name><name><surname>Loganathan</surname><given-names>BG</given-names></name><etal/></person-group><year>2004</year><article-title>Perfluorooctanesulfonate and related fluorochemicals in human blood from several countries</article-title><source>Environ Sci Technol</source><volume>38</volume><fpage>4489</fpage><lpage>4495</lpage><pub-id pub-id-type="pmid">15461154</pub-id></mixed-citation></ref><ref id="b11-ehp-117-1083"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Leonard</surname><given-names>RC</given-names></name><name><surname>Kreckmann</surname><given-names>KH</given-names></name><name><surname>Sakr</surname><given-names>CJ</given-names></name><name><surname>Symons</surname><given-names>JM</given-names></name></person-group><year>2007</year><article-title>Retrospective cohort mortality study of workers in a polymer production plant including a reference population of regional workers</article-title><source>Ann Epidemiol</source><volume>18</volume><fpage>15</fpage><lpage>20</lpage><pub-id pub-id-type="pmid">17900928</pub-id></mixed-citation></ref><ref id="b12-ehp-117-1083"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Longnecker</surname><given-names>MP</given-names></name><name><surname>Smith</surname><given-names>CS</given-names></name><name><surname>Kissling</surname><given-names>GE</given-names></name><name><surname>Hoppin</surname><given-names>JA</given-names></name><name><surname>Butenhoff</surname><given-names>JL</given-names></name><name><surname>Decker</surname><given-names>E</given-names></name><etal/></person-group><year>2008</year><article-title>An interlaboratory study of perfluorinated alkyl compounds levels in human plasma</article-title><source>Environ Res</source><volume>107</volume><fpage>152</fpage><lpage>159</lpage><pub-id pub-id-type="pmid">18295197</pub-id></mixed-citation></ref><ref id="b13-ehp-117-1083"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Olsen</surname><given-names>GW</given-names></name><name><surname>Mair</surname><given-names>DC</given-names></name><name><surname>Reagen</surname><given-names>WK</given-names></name></person-group><year>2007</year><article-title>Preliminary evidence of a decline in perfluorooctanesulfonate (PFOS) and per-fluorooctanoate (PFOA) concentrations in American Red Cross blood donors</article-title><source>Chemosphere</source><volume>68</volume><fpage>105</fpage><lpage>111</lpage><pub-id pub-id-type="pmid">17267015</pub-id></mixed-citation></ref><ref id="b14-ehp-117-1083"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sakr</surname><given-names>CJ</given-names></name><name><surname>Kreckmann</surname><given-names>KH</given-names></name><name><surname>Green</surname><given-names>JW</given-names></name><name><surname>Gillies</surname><given-names>PJ</given-names></name><name><surname>Reynolds</surname><given-names>JL</given-names></name><name><surname>Leonard</surname><given-names>RC</given-names></name></person-group><year>2007a</year><article-title>Cross-sectional study of lipids and liver enzymes related to a serum biomarker of exposure (ammonium perfluorooctanoate or APFO) as part of a general health survey in a cohort of occupationally exposed workers</article-title><source>J Occup Environ Med</source><volume>49</volume><fpage>1086</fpage><lpage>1096</lpage><pub-id pub-id-type="pmid">18000414</pub-id></mixed-citation></ref><ref id="b15-ehp-117-1083"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sakr</surname><given-names>CJ</given-names></name><name><surname>Leonard</surname><given-names>RC</given-names></name><name><surname>Kreckmann</surname><given-names>KH</given-names></name><name><surname>Slade</surname><given-names>MD</given-names></name><name><surname>Cullen</surname><given-names>MR</given-names></name></person-group><year>2007b</year><article-title>Longitudinal study of serum lipids and liver enzymes in workers with occupational exposure to ammonium per-fluorooctanoate</article-title><source>J Occup Environ Med</source><volume>49</volume><fpage>872</fpage><lpage>879</lpage><pub-id pub-id-type="pmid">17693785</pub-id></mixed-citation></ref><ref id="b16-ehp-117-1083"><mixed-citation publication-type="book"><collab>U.S. EPA</collab><year>2005</year><source>Draft Risk Assessment of the Potential Human Health Effects Associated with Exposure to Perflouroctanoic Acids and Its Salts</source><publisher-name>U.S. Environmental Protection Agency</publisher-name><comment>Available: <ext-link ext-link-type="uri" xlink:href="www.epa.gov/oppt/pfoa/pubs/pfoarisk.htm">www.epa.gov/oppt/pfoa/pubs/pfoarisk.htm</ext-link></comment><date-in-citation>[accessed 2 February 2009]</date-in-citation></mixed-citation></ref><ref id="b17-ehp-117-1083"><mixed-citation publication-type="web"><collab>West Virginia University, Health Sciences Center</collab><source>C8 Health Project Results</source><comment>Available: <ext-link ext-link-type="uri" xlink:href="http://www.hsc.wvu.edu/som/cmed/c8/results/index.asp">http://www.hsc.wvu.edu/som/cmed/c8/results/index.asp</ext-link></comment><date-in-citation>[accessed 3 June 2009]</date-in-citation></mixed-citation></ref></ref-list></back><floats-group><fig id="f1-ehp-117-1083" position="float"><label>Figure 1</label><caption><p>Six contaminated water districts of the C8 Health Project.</p></caption><graphic xlink:href="ehp-117-1083f1"/></fig><fig id="f2-ehp-117-1083" position="float"><label>Figure 2</label><caption><p>Distribution of PFOA (C8; 405 observations &#x0003e; 1,000 ng/mL not shown).</p></caption><graphic xlink:href="ehp-117-1083f2"/></fig><fig id="f3-ehp-117-1083" position="float"><label>Figure 3</label><caption><p>Distribution of residuals from regression model (<xref ref-type="table" rid="t2-ehp-117-1083">Table 2</xref>).</p></caption><graphic xlink:href="ehp-117-1083f3"/></fig><fig id="f4-ehp-117-1083" position="float"><label>Figure 4</label><caption><p>PFOA level (geometric mean) by current and former water district. Current water district refers to living in exposed water district in 2005&#x02013;2006 at time of blood draw. Prior water district refers to having either lived, worked, or gone to school for at least 1 year in one of the six exposed water districts. Model prediction compared with observed median value of 11.50 ng/mL for Prior P