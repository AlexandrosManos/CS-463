" colspan="1">42.0</td><td align="center" valign="middle" rowspan="1" colspan="1">20.2</td><td align="left" valign="middle" rowspan="1" colspan="1"><inline-formula><mml:math display="inline" id="M4" overflow="scroll"><mml:mrow><mml:msubsup><mml:mi>&#x003c7;</mml:mi><mml:mn>1</mml:mn><mml:mn>2</mml:mn></mml:msubsup><mml:mo>=</mml:mo><mml:mn>194.5</mml:mn></mml:mrow></mml:math></inline-formula>, p&#x0003c;0.001</td></tr><tr><td align="left" valign="middle" rowspan="1" colspan="1">Mean neuroticism (NEO, SD)</td><td align="center" valign="middle" rowspan="1" colspan="1">39.3 (8.0)</td><td align="center" valign="middle" rowspan="1" colspan="1">28.2 (5.5)</td><td align="left" valign="middle" rowspan="1" colspan="1"><italic>F</italic><sub>1,2920</sub>=1831, p&#x0003c;0.001</td></tr><tr><td align="left" valign="middle" rowspan="1" colspan="1">MDD, age of onset in years (SD)<break/> Early age of onset (&#x0003c; 30 years), %</td><td align="center" valign="middle" rowspan="1" colspan="1">27.7 (12.4)<break/> 57.3</td><td content-type="background-color:#D6D6D6" align="center" valign="middle" rowspan="1" colspan="1">-</td><td content-type="background-color:#D6D6D6" align="left" valign="middle" rowspan="1" colspan="1"/></tr><tr><td align="left" valign="middle" rowspan="1" colspan="1">Family history of depression, %</td><td align="center" valign="middle" rowspan="1" colspan="1">85.5</td><td content-type="background-color:#D6D6D6" align="center" valign="middle" rowspan="1" colspan="1">-</td><td content-type="background-color:#D6D6D6" align="left" valign="middle" rowspan="1" colspan="1"/></tr><tr><td align="left" valign="middle" rowspan="1" colspan="1">Recurrent MDD</td><td align="center" valign="middle" rowspan="1" colspan="1">50.9</td><td content-type="background-color:#D6D6D6" align="center" valign="middle" rowspan="1" colspan="1">-</td><td content-type="background-color:#D6D6D6" align="left" valign="middle" rowspan="1" colspan="1"/></tr><tr><td align="left" valign="middle" rowsp