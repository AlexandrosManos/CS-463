n-group person-group-type="author"><name><surname>O&#x02019;Dwyer</surname><given-names>PJ</given-names></name><name><surname>Courtney</surname><given-names>CA</given-names></name></person-group><article-title>Factors involved in abdominal wall closure and subsequent incisional hernia</article-title><source>Surgeon</source><year>2003</year><volume>1</volume><issue>1</issue><fpage>17</fpage><lpage>22</lpage></citation><citation citation-type="display-unstructured">O&#x02019;Dwyer PJ, Courtney CA (2003) Factors involved in abdominal wall closure and subsequent incisional hernia. Surgeon 1(1):17&#x02013;22 <pub-id pub-id-type="pmid">15568420</pub-id></citation></ref><ref id="CR14"><label>14.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Perrone</surname><given-names>JM</given-names></name><name><surname>Soper</surname><given-names>NJ</given-names></name><name><surname>Eagon</surname><given-names>JC</given-names></name><name><surname>Klingensmith</surname><given-names>ME</given-names></name><name><surname>Aft</surname><given-names>RL</given-names></name><name><surname>Frisella</surname><given-names>MM</given-names></name><name><surname>Brunt</surname><given-names>LM</given-names></name></person-group><article-title>Perioperative outcomes and complications of laparoscopic ventral hernia repair</article-title><source>Surgery</source><year>2005</year><volume>138</volume><issue>4</issue><fpage>708</fpage><lpage>715</lpage><pub-id pub-id-type="doi">10.1016/j.surg.2005.06.054</pub-id></citation><citation citation-type="display-unstructured">Perrone JM, Soper NJ, Eagon JC, Klingensmith ME, Aft RL, Frisella MM, Brunt LM (2005) Perioperative outcomes and complications of laparoscopic ventral hernia repair. Surgery 138(4):708&#x02013;715 <pub-id pub-id-type="pmid">16269300</pub-id></citation></ref><ref id="CR15"><label>15.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pierce</sur