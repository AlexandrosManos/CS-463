n></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Tanaka</surname><given-names>M</given-names></name></person-group><article-title>Category learning in chimpanzees (2): Acquisition and extension of food and non-food categories</article-title><source>Proceedings of the 69th Annual Convention of the Japanese Psychological Association</source><year>2005</year><publisher-name>Tokyo, Japan: Japanese Psychological Association</publisher-name><fpage>655</fpage></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Matsuzwa</surname><given-names>T</given-names></name><name><surname>Tomonaga</surname><given-names>M</given-names></name><name><surname>Tanaka</surname><given-names>M</given-names></name><collab>Eds</collab></person-group><source>Cognitive development in chimpanzees</source><year>2006</year><publisher-name>Tokyo, Japan: Springer</publisher-name></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sousa</surname><given-names>C</given-names></name><name><surname>Okamoto</surname><given-names>S</given-names></name><name><surname>Matsuzawa</surname><given-names>T</given-names></name></person-group><article-title>Behavioural development in a matching-to-sample task and token use by an infant chimpanzee reared by his mother</article-title><source>Anim Cogn</source><year>2003</year><volume>6</volume><fpage>259</fpage><lpage>267</lpage><pub-id pub-id-type="pmid">13680400</pub-id><pub-id pub-id-type="doi">10.1007/s10071-003-0186-7</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Posner</surname><given-names>MI</given-names></name></person-group><article-title>Orienting of attention</article-title><source>Quart J Exp Pyschol</source><year>1980</year><volume>32</volume><fpage>3</fpage><lpage>25</lpage><pub-id pub-id-type="doi">10.1080/00335558008248231</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parr</surname><given-names>L</given-names></name><name><surname>Hecht</surname><given-names>E</given-names></name><name><surname>Barks</surname><given-names>SK</given-names></name><name><surname>Preuss</surname><given-names>TM</given-names></name><name><surname>Votaw</surname><given-names>JR</given-names></name></person-group><article-title>Face processing in the chimpanzee brain</article-title><source>Curr Biol</source><year>2009</year><volume>19</volume><fpage>50</fpage><lpage>53</lpage><pub-id pub-id-type="pmid">19097899</pub-id><pub-id pub-id-type="doi">10.1016/j.cub.2008.11.048</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ro</surname><given-names>T</given-names></name><name><surname>Friggel</surname><given-names>A</given-names></name><name><surname>Lavie</surname><given-names>N</given-names></name></person-group><article-title>Attentional biases for faces and body parts</article-title><source>Vis Cogn</source><year>2007</year><volume>15</volume><fpage>322</fpage><lpage>348</lpage><pub-id pub-id-type="doi">10.1080/13506280600590434</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kano</surname><given-names>F</given-names></name><name><surname>Tomonaga</surname><given-names>M</given-names></name></person-group><article-title>How chimpanzees look at pictures: A comparative eye-tracking study</article-title><source>Proc Royal Soc B</source><year>2009</year><volume>276</volume><fpage>1949</fpage><lpage>1955</lpage><pub-id pub-id-type="doi">10.1098/rspb.2008.1811</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Klin</surname><given-names>A</given-names></na