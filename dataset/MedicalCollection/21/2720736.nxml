4 &#x000b1; 0.025</td><td align="left" rowspan="1" colspan="1">8.567 &#x000b1; 0.225</td></tr><tr><td align="left" rowspan="1" colspan="1">BAX</td><td align="left" rowspan="1" colspan="1">2.013 &#x000b1; 0.085</td><td align="left" rowspan="1" colspan="1">1.968 &#x000b1; 0.038</td><td align="left" rowspan="1" colspan="1">6.025 &#x000b1; 0.106</td><td align="left" rowspan="1" colspan="1">5.994 &#x000b1; 0.173</td><td align="left" rowspan="1" colspan="1">11.256 &#x000b1; 0.166</td><td align="left" rowspan="1" colspan="1">5.689 &#x000b1; 0.281</td></tr><tr><td align="left" rowspan="1" colspan="1">Caspase-3</td><td align="left" rowspan="1" colspan="1">2.063 &#x000b1; 0.047</td><td align="left" rowspan="1" colspan="1">1.958 &#x000b1; 0.057</td><td align="left" rowspan="1" colspan="1">3.668 &#x000b1; 0.205</td><td align="left" rowspan="1" colspan="1">4.025 &#x000b1; 0.193</td><td align="left" rowspan="1" colspan="1">12.334 &#x000b1; 0.187</td><td align="left" rowspan="1" colspan="1">3.665 &#x000b1; 0.043</td></tr></tbody></table><table-wrap-foot><fn id="tfn1-ijn-4-073"><p><bold>Abbreviations:</bold> BrTet, 5-bromotetrandrine; DNR, daunorubicin; MNP-Fe<sub>3</sub>O<sub>4</sub>, magnetic nanoparticle of Fe<sub>3</sub>O<sub>4</sub>.</p></fn></table-wrap-foot></table-wrap></floats-group></article>