-type="pmid">8204832</pub-id><pub-id pub-id-type="doi">10.1007/BF00014449</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mishra</surname><given-names>A</given-names></name><name><surname>Khare</surname><given-names>S</given-names></name><name><surname>Trivedi</surname><given-names>PK</given-names></name><name><surname>Nath</surname><given-names>P</given-names></name></person-group><article-title>Ethylene induced cotton leaf abscission is associated with higher expression of cellulase (<italic>GhCell</italic>) and increased activities of ethylene biosynthesis enzymes in abscission zone</article-title><source>Plant Physiol Biochem</source><year>2008</year><volume>46</volume><fpage>54</fpage><lpage>63</lpage><pub-id pub-id-type="pmid">17964177</pub-id><pub-id pub-id-type="doi">10.1016/j.plaphy.2007.09.002</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brummell</surname><given-names>DA</given-names></name><name><surname>Hall</surname><given-names>BD</given-names></name><name><surname>Bennett</surname><given-names>AB</given-names></name></person-group><article-title>Antisense suppression of tomato endo-1,4-&#x003b2;-glucanase <italic>Cel2 </italic>mRNA accumulation increases the force required to break fruit abscission zones but does not affect fruit softening</article-title><source>Plant Mol Biol</source><year>1999</year><volume>40</volume><fpage>615</fpage><lpage>622</lpage><pub-id pub-id-type="pmid">10480385</pub-id><pub-id pub-id-type="doi">10.1023/A:1006269031452</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carrillo-Lopez</surname><given-names>A</given-names></name><name><surname>Cruz-Hernandez</surname><given-names>A</given-names></name><name><surname>Carabez-Trejo</surname><given-names>A</given-names></name><name><surnam