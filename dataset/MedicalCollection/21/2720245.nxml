ef><ref id="bib21"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Pott</surname><given-names>P</given-names></name></person-group><article-title>Chirurgical observations relative to the cataract, the polypus of the nose, the cancer of the scrotum, the different kinds of ruptures, and the mortification of the toes and feet</article-title><year>1775</year>(Reprinted in <italic>Natl Cancer Inst Monogr</italic><bold>10</bold>: 7&#x02013;13; 1963)</citation></ref><ref id="bib22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rous</surname><given-names>P</given-names></name></person-group><article-title>Surmise and fact on the nature of cancer</article-title><source>Nature</source><year>1959</year><volume>183</volume><fpage>1357</fpage><lpage>1363</lpage><!--PubMed citation query: 'Nature||183|1357||bib22|'--><pub-id pub-id-type="pmid">13657123</pub-id></citation></ref><ref id="bib23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rubin</surname><given-names>H</given-names></name></person-group><article-title>What keeps cells in tissues behaving normally in the face of myriad mutations</article-title><source>BioEssays</source><year>2006</year><volume>28</volume><fpage>515</fpage><lpage>524</lpage><!--PubMed citation query: 'BioEssays||28|515||bib23|'--><pub-id pub-id-type="pmid">16615084</pub-id></citation></ref><ref id="bib24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rutherford</surname><given-names>SL</given-names></name><name><surname>Lindquist</surname><given-names>S</given-names></name></person-group><article-title>Hsp90 as a capacitator for morphological evolution</article-title><source>Nature</source><year>1998</year><volume>396</volume><fpage>336</fpage><lpage>342</lpage><!--PubMed citation query: 'Nature||396|336||bib24|'--><pub-id pub-id-type="pmid">9845070</pub-id></citation></ref><ref id="bib25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tyzzer</surname><given-names>EE</given-names></name></person-group><article-title>Tumour immunology</article-title><source>J Cancer Res</source><year>1916</year><volume>1</volume><fpage>125</fpage><lpage>155</lpage><!--PubMed citation query: 'J Cancer Res||1|125||bib25|'--></citation></ref><ref id="bib26"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Zaridze</surname><given-names>D</given-names></name><name><surname>Peto</surname><given-names>R</given-names></name></person-group><article-title>Influence of dose and duration of smoking on lung cancer rates</article-title><source>Tobacco: Major international health hazard</source><year>1986</year><publisher-name>IARC Sci. Publs: Lyon</publisher-name><fpage>23</fpage><lpage>33</lpage>edsVol 74</citation></ref></ref-list></back></article>