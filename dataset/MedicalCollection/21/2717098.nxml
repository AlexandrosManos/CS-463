nal"><name><surname>Gaillard</surname><given-names>M</given-names></name><name><surname>Vallaeys</surname><given-names>T</given-names></name><name><surname>Vorh&#x000f6;lter</surname><given-names>FJ</given-names></name><name><surname>Minoia</surname><given-names>M</given-names></name><name><surname>Werlen</surname><given-names>C</given-names></name><name><surname>Sentchilo</surname><given-names>V</given-names></name><name><surname>P&#x000fc;hler</surname><given-names>A</given-names></name><name><surname>Meer</surname><given-names>JR van der</given-names></name><article-title>The <italic>clc </italic>element of <italic>Pseudomonas </italic>sp. strain B13, a genomic island with various catabolic properties</article-title><source>J Bacteriol</source><year>2006</year><volume>188</volume><fpage>1999</fpage><lpage>2013</lpage><pub-id pub-id-type="pmid">16484212</pub-id><pub-id pub-id-type="doi">10.1128/JB.188.5.1999-2013.2006</pub-id></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="journal"><name><surname>Sentchilo</surname><given-names>V</given-names></name><name><surname>Czechowska</surname><given-names>K</given-names></name><name><surname>Pradervand</surname><given-names>N</given-names></name><name><surname>Minoia</surname><given-names>M</given-names></name><name><surname>Miyazaki</surname><given-names>R</given-names></name><name><surname>Meer</surname><given-names>JR van der</given-names></name><article-title>Intracellular excision and reintegration dynamics of the ICE<italic>clc </italic>genomic island of <italic>Pseudomonas knackmussii </italic>sp. strain B. 13</article-title><source>Mol Microbiol</source><year>2009</year><volume>72</volume><fpage>1293</fpage><lpage>1306</lpage><pub-id pub-id-type="doi">10.1111/j.1365-2958.2009.06726.x</pub-id><pub-id pub-id-type="pmid">19432799</pub-id></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="journal"><name><surname>Toussaint</surname><given-names>A</given-names></name><name><surn