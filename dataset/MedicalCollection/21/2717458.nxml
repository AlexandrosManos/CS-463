tion></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ely</surname><given-names>EW</given-names></name><name><surname>Shintani</surname><given-names>A</given-names></name><name><surname>Truman</surname><given-names>B</given-names></name><name><surname>Speroff</surname><given-names>T</given-names></name><name><surname>Gordon</surname><given-names>SM</given-names></name><name><surname>Harrell</surname><given-names>FE</given-names></name><name><surname>Inouye</surname><given-names>SK</given-names></name><name><surname>Bernard</surname><given-names>GR</given-names></name><name><surname>Dittus</surname><given-names>RS</given-names></name></person-group><article-title>Delirium as a predictor of mortality in mechanically ventilated patients in the intensive care unit</article-title><source>JAMA</source><year>2004</year><volume>291</volume><fpage>1753</fpage><lpage>1762</lpage><pub-id pub-id-type="pmid">15082703</pub-id><pub-id pub-id-type="doi">10.1001/jama.291.14.1753</pub-id></citation></ref><ref id="B7"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Spronk</surname><given-names>PE</given-names></name><name><surname>Riekerk</surname><given-names>B</given-names></name><name><surname>Hofhuis</surname><given-names>J</given-names></name><name><surname>Rommes</surname><given-names>JH</given-names></name></person-group><article-title>Occurrence of delirium is severely underestimated in the ICU during daily care</article-title><source>Intensive Care Med</source><year>2009</year><comment></comment></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Page</surname><given-names>VJ</given-names></name><name><surname>Navarange</surname><given-names>S</given-names></name><name><surname>Gama</surname><given-names>S</given-names></name><name><surname>McAuley</surname><given-names>D</given-names></name></person-group><art