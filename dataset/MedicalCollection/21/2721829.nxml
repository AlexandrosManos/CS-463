fpage>587</fpage><lpage>622</lpage></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Waldegger</surname><given-names>M</given-names></name><name><surname>Huber</surname><given-names>B</given-names></name><name><surname>Kathrein</surname><given-names>A</given-names></name><name><surname>Sitte</surname><given-names>I</given-names></name></person-group><article-title>[Correction of the leg axis after epiphyseal fracture and progressive abnormal growth of the proximal tibia]</article-title><source>Unfallchirurg</source><year>2001</year><volume>104</volume><fpage>261</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">11284358</pub-id><pub-id pub-id-type="doi">10.1007/s001130050724</pub-id></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>von Laer</surname><given-names>L</given-names></name></person-group><article-title>Knee Injuries</article-title><source>Pediartic Fractures and Dislocations</source><year>2004</year><edition>1</edition><publisher-name>Thieme</publisher-name><fpage>334</fpage><lpage>7</lpage></citation></ref></ref-list></back></article>