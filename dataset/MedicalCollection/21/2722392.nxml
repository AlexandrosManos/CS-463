</ref><ref id="B9"><label>9</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Koehly</surname><given-names>LM</given-names></name><name><surname>Loscalzo</surname><given-names>AE</given-names></name></person-group><year>2009</year><volume>6</volume><issue>3</issue><article-title>Adolescent obesity and social networks</article-title><source>Prev Chronic Dis</source><fpage>A99</fpage><comment><ext-link ext-link-type="uri" xlink:href="http://www.cdc.gov/pcd/issues/2009/jul/08_0265.htm">http://www.cdc.gov/pcd/issues/2009/jul/08_0265.htm</ext-link></comment><pub-id pub-id-type="pmid">19527601</pub-id></mixed-citation></ref><ref id="B10"><label>10</label><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Schenk</surname><given-names>K</given-names></name><name><surname>Williamson</surname><given-names>J</given-names></name></person-group><year>2005</year><publisher-loc>Washington (DC)</publisher-loc><publisher-name>Population Council</publisher-name><source>Ethical approaches to gathering information from children and adolescents: guidelines and resources</source></mixed-citation></ref><ref id="B11"><label>11</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wickrama</surname><given-names>KAS</given-names></name><name><surname>Conger</surname><given-names>RD</given-names></name><name><surname>Wallace</surname><given-names>LE</given-names></name><name><surname>Elder</surname><given-names>GH</given-names></name></person-group><volume>40</volume><issue>3</issue><year>1999</year><fpage>258</fpage><lpage>272</lpage><article-title>The intergenerational transmission of health-risk behaviors: adolescent lifestyles and gender moderating effects</article-title><source>J Health Soc Behav</source><pub-id pub-id-type="pmid">10513147</pub-id></mixed-citation></ref><ref id="B12"><label>12</label><mixed-citation publication-type="jou