ublication-type="journal"><person-group person-group-type="author"><name><surname>Bartumeus</surname><given-names>F</given-names></name><name><surname>Peters</surname><given-names>F</given-names></name><name><surname>Pueyo</surname><given-names>S</given-names></name><name><surname>Marras&#x000e9;</surname><given-names>C</given-names></name><name><surname>Catalan</surname><given-names>J</given-names></name></person-group><year>2003</year><article-title>Helical L&#x000e9;vy walks: adjusting searching statistics to resource availability in microzooplankton.</article-title><source>Proc Natl Acad Sci USA</source><volume>100</volume><fpage>12771</fpage><lpage>12775</lpage><pub-id pub-id-type="pmid">14566048</pub-id></mixed-citation></ref><ref id="pone.0006587-Austin1"><label>7</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Austin</surname><given-names>D</given-names></name><name><surname>Bowen</surname><given-names>WD</given-names></name><name><surname>McMillan</surname><given-names>JI</given-names></name></person-group><year>2004</year><article-title>Intraspecific variation in movement patterns: modeling individual behaviour in a large marine predator.</article-title><source>Oikos</source><volume>105</volume><fpage>15</fpage><lpage>30</lpage></mixed-citation></ref><ref id="pone.0006587-RamosFernndez1"><label>8</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ramos-Fern&#x000e1;ndez</surname><given-names>G</given-names></name><name><surname>Morales</surname><given-names>JL</given-names></name><name><surname>Miramontes</surname><given-names>O</given-names></name><name><surname>Cocho</surname><given-names>G</given-names></name><name><surname>Larralde</surname><given-names>H</given-names></name><etal/></person-group><year>2004</year><article-title>L&#x000e9;vy walk patterns in the foraging movements of spider monkeys (<italic>Ateles geoffroyi</italic>).</article-title><source>Behav Ecol Sociobiol</source><volume>55</volume><fpage>223</fpage><lpage>230</lpage></mixed-citation></ref><ref id="pone.0006587-deKnegt1"><label>9</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>de Knegt</surname><given-names>HJ</given-names></name><name><surname>Hengeveld</surname><given-names>GM</given-names></name><name><surname>van Langevelde</surname><given-names>F</given-names></name><name><surname>de Boer</surname><given-names>WF</given-names></name><name><surname>Kirkmanb</surname><given-names>KP</given-names></name></person-group><year>2007</year><article-title>Patch density determines movement patterns and foraging efficiency of large herbivores.</article-title><source>Behav Ecol</source><volume>18</volume><fpage>1065</fpage><lpage>1072</lpage></mixed-citation></ref><ref id="pone.0006587-Dai1"><label>10</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dai</surname><given-names>XH</given-names></name><name><surname>Shannon</surname><given-names>G</given-names></name><name><surname>Slotow</surname><given-names>R</given-names></name><name><surname>Page</surname><given-names>B</given-names></name><name><surname>Duffy</surname><given-names>KJ</given-names></name></person-group><year>2007</year><article-title>Short-duration daytime movements of a cow herd of African elephants.</article-title><source>J Mamm</source><volume>88</volume><fpage>151</fpage><lpage>157</lpage></mixed-citation></ref><ref id="pone.0006587-Benhamou1"><label>11</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Benhamou</surname><given-names>S</given-names></name></person-group><year>2007</year><article-title>How many animals really do the L&#x000e9;vy walk?</article-title><source>Ecology</source><volume>88</volume><fpage>1962</fpage><lpage>1969</lpage><pub-id pub-id-type="pmid">17824427</pub-id></mixed-citation></ref><ref id="pone.0006587-Edwards1"><label>12</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Edwards</surname><given-names>AM</given-names></name><name><surname>Phillips</surname><given-names>RA</given-names></name><name><surname>Watkins</surname><given-names>NW</given-names></name><name><surname>Freeman</surname><given-names>MP</given-names></name><name><surname>Murphy</surname><given-names>EJ</given-names></name><etal/></person-group><year>2007</year><article-title>Revisiting L&#x000e9;vy flight search patterns of wandering albatrosses, bumblebess and deer.</article-title><source>Nature</source><volume>449</volume><fpage>1044</fpage><lpage>1048</lpage><pub-id pub-id-type="pmid">17960243</pub-id></mixed-citation></ref><ref id="pone.0006587-Edwards2"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Edwards</surname><given-names>AM</given-names></name></person-group><year>2008</year><article-title>Using likelihood to test for L&#x000e9;vy flight search patterns and for general power-law distributions in nature.</article-title><source>J Anim Ecol</source><volume>77</volume><fpage>1212</fpage><lpage>1222</lpage><pub-id pub-id-type="pmid">18631370</pub-id></mixed-citation></ref><ref id="pone.0006587-Sims1"><label>14</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sims</surname><given-names>DW</given-names></name><name><surname>Righton</surname><given-names>D</given-names></name><name><surname>Pitchford</surname><given-names>JW</given-names></name></person-group><year>2007</year><article-title>Minimizing errors in identifying L&#x000e9;vy flight behaviour of organisms.</article-title><source>J Anim Ecol</source><volume>76</volume><fpage>222</fpage><lpage>229</lpage><pub-id pub-id-type="pmid">17302829</pub-id></mixed-citation></ref><ref id="pone.0006587-Viswanathan2"><label>15</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Viswanathan</surname><given-names>GM</given-names></name><name><surname>Raposo</surname><given-names>EP</given-names></name><name><surname>da Luz</surname><given-names>MGE</given-names></name></person-group><year>2008</year><article-title>L&#x000e9;vy flights and superdiffusion in the context of biological ecounters and random searches.</article-title><source>Life Rev</source><volume>5</volume><fpage>133</fpage><lpage>150</lpage></mixed-citation></ref><ref id="pone.0006587-Newman1"><label>16</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Newman</surname><given-names>MEJ</given-names></name></person-group><year>2005</year><article-title>Power laws, Pareto distributions and Zipf's law.</article-title><source>Contemporary Physics</source><volume>46</volume><fpage>323</fpage><lpage>351</lpage></mixed-citation></ref><ref id="pone.0006587-Petrovskii1"><label>17</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Petrovskii</surname><given-names>S</given-names></name><name><surname>Morozov</surname><given-names>A</given-names></name></person-group><year>2009</year><article-title>Dispersal in a statistically structured population: fat tails revisited.</article-title><source>Am Nat</source><volume>173</volume><fpage>278</fpage><lpage>289</lpage><pub-id pub-id-type="pmid">19123917</pub-id></mixed-citation></ref><ref id="pone.0006587-Morales1"><label>18</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Morales</surname><given-names>JM</given-names></name><name><surname>Haydon</surname><given-names>DT</given-names></name><name><surname>Frair</surname><given-names>J</given-names></name><name><surname>Holsinger</surname><given-names>KE</given-names></name><name><surname>Fryxell</surname><given-names>JM</given-names></name></person-group><year>2004</year><article-title>Extracting more out of relocation data: building movement models as mixtures of random walks.</article-title><source>Ecology</source><volume>85</volume><fpage>2436</fpage><lpage>2445</lpage></mixed-citation></ref><ref id="pone.0006587-Focardi2"><label>19</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Focardi</surname><given-names>S</given-names></name><name><surname>Pecchioli</surname><given-names>E</given-names></name></person-group><year>2005</year><article-title>Social cohesion and foraging decrease with group size in fallow deer (<italic>Dama dama</italic>).</article-title><source>Behav Ecol Sociobiol</source><volume>59</volume><fpage>84</fpage><lpage>91</lpage></mixed-citation></ref><ref id="pone.0006587-Reynolds1"><label>20</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Reynolds</surname><given-names>A</given-names></name></person-group><year>2008</year><article-title>How many animals really do the L&#x000e9;vy walk? Comment.</article-title><source>Ecology</source><volume>89</volume><fpage>2347</fpage><lpage>2351</lpage><pub-id pub-id-type="pmid">18724744</pub-id></mixed-citation></ref><ref id="pone.0006587-Sims2"><label>21</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sims</surname><given-names>DW</given-names></name><name><surname>Southall</surname><given-names>EJ</given-names></name><name><surname>Humphries</surname><given-names>NE</given-names></name><name><surname>Hays</surname><given-names>GC</given-names></name><name><surname>Bradshaw</surname><given-names>CJA</given-names></name></person-group><year>2008</year><article-title>Scaling laws of marine predator search behaviour.</article-title><source>Nature</source><volume>451</volume><fpage>1098</fpage><lpage>1101</lpage><pub-id pub-id-type="pmid">18305542</pub-id></mixed-citation></ref><ref id="pone.0006587-Bartumeus2"><label>22</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bartumeus</surname><given-names>F</given-names></name><name><surname>Levin</surname><given-names>SA</given-names></name></person-group><year>2008</year><article-title>Fractal reorientation clocks: Linking animal behaviour to statistical patterns of search.</article-title><source>Proc Natl Acad Sci USA</source><volume>105</volume><fpage>19072</fpage><lpage>19077</lpage><pub-id pub-id-type="pmid">19060198</pub-id></mixed-citation></ref><ref id="pone.0006587-DiLuzio1"><label>23</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Di Luzio</surname><given-names>P</given-names></name></person-group><year>2005</year><article-title>Uso dello spazio del Daino (<italic>Dama dama</italic> Linneus 1758) in ambiente mediterraneo. Thesis in Biological Science. Universit&#x000e0; degli Studi di Roma &#x0201c;La Sapienza&#x0201d;.</article-title></mixed-citation></ref><ref id="pone.0006587-Gonzalez1"><label>24</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gonzalez</surname><given-names>M</given-names></name><name><surname>Hidalgo</surname><given-names>CA</given-names></name><name><surname>Barab&#x000e1;si</surname><given-names>A-L</given-names></name></person-group><year>2008</year><article-title>Understanding individual human mobility patterns.</article-title><source>Nature</source><volume>453</volume><fpage>779</fpage><lpage>782</lpage><pub-id pub-id-type="pmid">18528393</pub-id></mixed-citation></ref><ref id="pone.0006587-Reynolds2"><label>25</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Reynolds</surname><given-names>AM</given-names></name><name><surname>Rhodes C</surname><given-names>J</given-names></name></person-group><year>2009</year><article-title>The L&#x000e9;vy flight paradigm: random search patterns and mechanisms.</article-title><source>Ecology</source><volume>90</volume><fpage>877</fpage><lpage>887</lpage><pub-id pub-id-type="pmid">19449680</pub-id></mixed-citation></ref><ref id="pone.0006587-Toivonen1"><label>26</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Toivonen</surname><given-names>R</given-names></name><name><surname>Onnela</surname><given-names>J-P</given-names></name><name><surname>Saramaki</surname><given-names>J</given-names></name><name><surname>Hyvonen</surname><given-names>J</given-names></name><name><surname>Kaski</surname><given-names>K</given-names></name></person-group><year>2006</year><article-title>A model for social networks.</article-title><source>Physica A</source><volume>371</volume><fpage>851</fpage><lpage>860</lpage></mixed-citation></ref></ref-list><fn-group><fn fn-type="conflict"><p><bold>Competing Interests: </bold>The authors have declared that no competing interests exist.</p></fn><fn fn-type="financial-disclosure"><p><bold>Funding: </bold>The study was based on internal funding of the INFS as part of institutional research. No funders had any role in study design, data collection and analysis, decision to publish, or preparation of the manuscript.</p></fn></fn-group></back></article>