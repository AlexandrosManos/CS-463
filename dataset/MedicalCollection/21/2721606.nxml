><td align="center" rowspan="1" colspan="1">3</td><td align="center" rowspan="1" colspan="1">821</td></tr><tr><td align="left" rowspan="1" colspan="1">2000</td><td align="center" rowspan="1" colspan="1">608</td><td align="center" rowspan="1" colspan="1">171</td><td align="center" rowspan="1" colspan="1">16</td><td align="center" rowspan="1" colspan="1">11</td><td align="center" rowspan="1" colspan="1">806</td></tr><tr><td align="left" rowspan="1" colspan="1">1999</td><td align="center" rowspan="1" colspan="1">505</td><td align="center" rowspan="1" colspan="1">137</td><td align="center" rowspan="1" colspan="1">22</td><td align="center" rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">665</td></tr><tr><td align="left" rowspan="1" colspan="1">1998</td><td align="center" rowspan="1" colspan="1">504</td><td align="center" rowspan="1" colspan="1">133</td><td align="center" rowspan="1" colspan="1">12</td><td align="center" rowspan="1" colspan="1">8</td><td align="center" rowspan="1" colspan="1">657</td></tr><tr><td align="left" rowspan="1" colspan="1">1997</td><td align="center" rowspan="1" colspan="1">450</td><td align="center" rowspan="1" colspan="1">172</td><td align="center" rowspan="1" colspan="1">19</td><td align="center" rowspan="1" colspan="1">5</td><td align="center" rowspan="1" colspan="1">646</td></tr><tr><td align="left" rowspan="1" colspan="1">1996</td><td align="center" rowspan="1" colspan="1">407</td><td align="center" rowspan="1" colspan="1">162</td><td align="center" rowspan="1" colspan="1">15</td><td align="center" rowspan="1" colspan="1">3</td><td align="center" rowspan="1" colspan="1">587</td></tr><tr><td align="left" rowspan="1" colspan="1">1995</td><td align="center" rowspan="1" colspan="1">434</td><td align="center" rowspan="1" colspan="1">131</td><td align="center" rowspan="1" colspan="1">2</td><td align="center" rowspan="1" colspan="1">0</td><td align="center" rowspan="1" colspan="1">567</td></tr><tr><td align="left" rowspan