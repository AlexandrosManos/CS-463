son-group person-group-type="author"><name><surname>Edwards</surname><given-names>FA</given-names></name><name><surname>Gibb</surname><given-names>AJ</given-names></name><name><surname>Colquhoun</surname><given-names>D</given-names></name></person-group><article-title>ATP receptor-mediated synaptic currents in the central nervous system</article-title><source>Nature</source><year>1992</year><volume>359</volume><fpage>144</fpage><lpage>147</lpage><pub-id pub-id-type="pmid">1381811</pub-id></citation></ref><ref id="R14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sim</surname><given-names>JA</given-names></name><etal/></person-group><article-title>Altered hippocampal synaptic potentiation in P2X4 knock-out mice</article-title><source>J Neurosci</source><year>2006</year><volume>26</volume><fpage>9006</fpage><lpage>9009</lpage><pub-id pub-id-type="pmid">16943557</pub-id></citation></ref><ref id="R15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Finger</surname><given-names>TE</given-names></name><etal/></person-group><article-title>ATP signaling is crucial for communication from taste buds to gustatory nerves</article-title><source>Science</source><year>2005</year><volume>310</volume><fpage>1495</fpage><lpage>1499</lpage><pub-id pub-id-type="pmid">16322458</pub-id></citation></ref><ref id="R16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cook</surname><given-names>SP</given-names></name><name><surname>Vulchanova</surname><given-names>L</given-names></name><name><surname>Hargreaves</surname><given-names>KM</given-names></name><name><surname>Elde</surname><given-names>R</given-names></name><name><surname>McCleskey</surname><given-names>EW</given-names></name></person-group><article-title>Distinct ATP receptors on pain-sensing and stretch-sensing neurons</article-title><source>Nature</source><year>1997</year><volume>387</volume><fpage>505</fpage><lpage>508</lpage><pub-id pub-id-type="pmid">9168113</pub-id></citation></ref><ref id="R17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Souslova</surname><given-names>V</given-names></name><etal/></person-group><article-title>Warm-coding deficits and aberrant inflammatory pain in mice lacking P2X3 receptors</article-title><source>Nature</source><year>2000</year><volume>407</volume><fpage>1015</fpage><lpage>1017</lpage><pub-id pub-id-type="pmid">11069182</pub-id></citation></ref><ref id="R18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cockayne</surname><given-names>DA</given-names></name><etal/></person-group><article-title>Urinary bladder hyporeflexia and reduced pain-related behaviour in P2X3-deficient mice</article-title><source>Nature</source><year>2000</year><volume>407</volume><fpage>1011</fpage><lpage>1015</lpage><pub-id pub-id-type="pmid">11069181</pub-id></citation></ref><ref id="R19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chessell</surname><given-names>IP</given-names></name><etal/></person-group><article-title>Disruption of the P2X7 purinoceptor gene abolishes chronic inflammatory and neuropathic pain</article-title><source>Pain</source><year>2005</year><volume>114</volume><fpage>386</fpage><lpage>396</lpage><pub-id pub-id-type="pmid">15777864</pub-id></citation></ref><ref id="R20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yamamoto</surname><given-names>K</given-names></name><etal/></person-group><article-title>Impaired flow-dependent control of vascular tone and remodeling in P2X4-deficient mice</article-title><source>Nat Med</source><year>2006</year><volume>12</volume><fpage>133</fpage><lpage>137</lpage><pub-id pub-id-type="pmid">16327800</p