 structure</article-title><source>Physiol Rev</source><year>2002</year><volume>82</volume><fpage>735</fpage><lpage>767</lpage><pub-id pub-id-type="pmid">12087134</pub-id></citation></ref><ref id="R32"><label>32</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kawate</surname><given-names>T</given-names></name><name><surname>Gouaux</surname><given-names>E</given-names></name></person-group><article-title>Fluorescence-detection size-exclusion chromatography for precrystallization screening of integral membrane proteins</article-title><source>Structure</source><year>2006</year><volume>14</volume><fpage>673</fpage><lpage>681</lpage><pub-id pub-id-type="pmid">16615909</pub-id></citation></ref><ref id="R33"><label>33</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Diaz-Hernandez</surname><given-names>M</given-names></name><etal/></person-group><article-title>Cloning and characterization of two novel zebrafish P2X receptor subunits</article-title><source>Biochem Biophys Res Commun</source><year>2002</year><volume>295</volume><fpage>849</fpage><lpage>853</lpage><pub-id pub-id-type="pmid">12127972</pub-id></citation></ref><ref id="R34"><label>34</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blake</surname><given-names>CC</given-names></name><name><surname>Geisow</surname><given-names>MJ</given-names></name><name><surname>Oatley</surname><given-names>SJ</given-names></name><name><surname>Rerat</surname><given-names>B</given-names></name><name><surname>Rerat</surname><given-names>C</given-names></name></person-group><article-title>Structure of prealbumin: secondary, tertiary and quaternary interactions determined by Fourier refinement at 1.8 A</article-title><source>J Mol Biol</source><year>1978</year><volume>121</volume><fpage>339</fpage><lpage>356</lpage><pub-id pub-id-type="pmid">671542</pub-id></citation></ref><ref id="R35"><la