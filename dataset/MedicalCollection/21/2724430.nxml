>A systematic review of the use of intranasal steroids in the treatment of chronic rhinosinusitis</article-title><source>Otolaryngol Head Neck Surg</source><year>2008</year><volume>139</volume><fpage>340</fpage><lpage>347</lpage><pub-id pub-id-type="pmid">18722209</pub-id><pub-id pub-id-type="doi">10.1016/j.otohns.2008.05.628</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lim</surname><given-names>M</given-names></name><name><surname>Citardi</surname><given-names>MJ</given-names></name><name><surname>Leong</surname><given-names>JL</given-names></name></person-group><article-title>Topical antimicrobials in the management of chronic rhinosinusitis: a systematic review</article-title><source>Am J Rhinol</source><year>2008</year><volume>22</volume><fpage>381</fpage><lpage>389</lpage><pub-id pub-id-type="pmid">18702902</pub-id><pub-id pub-id-type="doi">10.2500/ajr.2008.22.3189</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guo</surname><given-names>R</given-names></name><name><surname>Canter</surname><given-names>PH</given-names></name><name><surname>Ernst</surname><given-names>E</given-names></name></person-group><article-title>Herbal medicines for the treatment of rhinosinusitis</article-title><source>Otolaryngol Head Neck Surg</source><year>2006</year><volume>135</volume><fpage>496</fpage><lpage>506</lpage><pub-id pub-id-type="pmid">17011407</pub-id><pub-id pub-id-type="doi">10.1016/j.otohns.2006.06.1254</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Witt</surname><given-names>C</given-names></name><name><surname>Keil</surname><given-names>T</given-names></name><name><surname>Selim</surname><given-names>D</given-names></name><name><surname>Roll</surname><given-names>S</given-names></name><name><surname>Vance</surname><given-names