2007</year><volume>4</volume><fpage>107</fpage><lpage>13</lpage></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nishino</surname><given-names>K</given-names></name></person-group><article-title>Ki-energy in health</article-title><source>Proceedings for the 4th International Congress on Traditional Asian Medicine</source><year>1994</year><volume>1</volume><fpage>148</fpage><lpage>70</lpage></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Nishino</surname><given-names>K</given-names></name></person-group><source>The Breath of Life: Using the Power of Ki for Maximum Vitality</source><year>1997</year><publisher-loc>Tokyo. New York, London</publisher-loc><publisher-name>Kodansha International</publisher-name></element-citation></ref><ref id="B16"><label>16</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Nishino</surname><given-names>K</given-names></name></person-group><source>Le Souffle de Vie, Utiliser le Pouroir du Ki</source><year>1998</year><publisher-loc>Paris</publisher-loc><publisher-name>Guy Tredaniel Editeur</publisher-name></element-citation></ref><ref id="B17"><label>17</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Nishino</surname><given-names>K</given-names></name></person-group><source>Il Respiro Della Vita, La massima vitalita dalla forza del Ki, Esercizi di Respirazione facili, effieaci, completamente illustrati</source><year>1999</year><publisher-loc>Rome, Italy</publisher-loc><publisher-name>Edizioni Mediterranee, Via Flaminia</publisher-name></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Nishino</surname><given-names>K</given-names></name></person-group><article-title>Antiaging effects of the Nishino breathing method (Symposium speaker)</article-title><source>Symposium on Anti-aging, 27th Annual Meeting of Japanese Medical Society</source><year>2007</year><month>4</month><day>2</day><publisher-loc>Japan</publisher-loc><publisher-name>Osaka</publisher-name></element-citation></ref><ref id="B19"><label>19</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Nishino</surname><given-names>K</given-names></name></person-group><article-title>The possibility of respiration in the 21st century (Keynote speech)</article-title><source>47th Annual Meeting of the Japanese Respiratory Society</source><year>2007</year><month>5</month><day>10</day><publisher-loc>Tokyo, Japan</publisher-loc></element-citation></ref><ref id="B20"><label>20</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Nishino</surname><given-names>K</given-names></name></person-group><source>Nishino Breathing Method</source><year>1987</year><publisher-loc>Tokyo</publisher-loc><publisher-name>Kodansha</publisher-name><comment>(in Japanese)</comment></element-citation></ref><ref id="B21"><label>21</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Nishino</surname><given-names>K</given-names></name></person-group><source>Nishino Breathing Method: Elevation of Self Energy</source><year>2005</year><publisher-loc>Tokyo</publisher-loc><publisher-name>Gakushu Kenkyu Pub.Co</publisher-name><comment>(in Japanese)</comment></element-citation></ref><ref id="B22"><label>22</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Yumi</surname><given-names>K</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Nishino</surname><given-names>K</given-names></name></person-group><article-title>The Ultimate Example of Nishino Breating</article-title><source>Method: Everyday of Yumi Kaoru with Slim and Bouncing Body</source><year>2005</year><publisher-loc>Tokyo</publisher-loc><publisher-name>TAKE Shobo Pub. Co.</publisher-name><comment>(in Japanese)</comment></element-citation></ref><ref id="B23"><label>23</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kimura</surname><given-names>H</given-names></name><name><surname>Nagao</surname><given-names>F</given-names></name><name><surname>Tanaka</surname><given-names>Y</given-names></name><name><surname>Sakai</surname><given-names>S</given-names></name><name><surname>Ohnishi</surname><given-names>ST</given-names></name><name><surname>Okumura</surname><given-names>K</given-names></name></person-group><article-title>beneficial effects of the Nishino breathing method on the immune activity and stress level</article-title><source>J Altern Complement Med</source><year>2005</year><volume>11</volume><fpage>285</fpage><lpage>91</lpage><comment><ext-link ext-link-type="uri" xlink:href="http://members.aol.com/philabiomed/publication/kimura.pdf">http://members.aol.com/philabiomed/publication/kimura.pdf</ext-link></comment><pub-id pub-id-type="pmid">15865494</pub-id></element-citation></ref><ref id="B24"><label>24</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ohnishi</surname><given-names>ST</given-names></name><name><surname>Ohnishi</surname><given-names>T</given-names></name><name><surname>Nishino</surname><given-names>K</given-names></name><name><surname>Tsurusaki</surname><given-names>Y</given-names></name><name><surname>Yamaguchi</surname><given-names>M</given-names></name></person-group><article-title>Growth inhibition of cultured human carcinoma cells by Ki-energy (Life Energy): Scientific study of Ki-effect on cancer cells</article-title><source>Evid-based Complement Altern Med</source><year>2005</year><vol