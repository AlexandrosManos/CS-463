roup><source>Armut, soziale Ungleichheit und Gesundheit, Expertise des Robert Koch-Instituts zum 2 Armuts- und Reichtumsbericht der Bundesregierung</source><year>2005</year><publisher-name>Berlin, Robert Koch-Institut</publisher-name></citation></ref><ref id="B8"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Dill</surname><given-names>H</given-names></name><name><surname>Frick</surname><given-names>U</given-names></name><name><surname>H&#x000f6;fer</surname><given-names>R</given-names></name><name><surname>Kl&#x000f6;ver</surname><given-names>B</given-names></name><name><surname>Straus</surname><given-names>F</given-names></name></person-group><source>Risikoverhalten junger Migrantinnen und Migranten &#x02013; Expertise f&#x000fc;r das Bundesministerium f&#x000fc;r Gesundheit</source><year>2002</year><publisher-name>Nomos, Baden-Baden</publisher-name></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van Oort</surname><given-names>FVA</given-names></name><name><surname>Ende</surname><given-names>J van der</given-names></name><name><surname>Crijnen</surname><given-names>AAM</given-names></name><name><surname>Verhulst</surname><given-names>FC</given-names></name><name><surname>Mackenbach</surname><given-names>JP</given-names></name><name><surname>Joung</surname><given-names>IMA</given-names></name></person-group><article-title>Determinants of daily smoking in Turkish young adults in the Netherlands</article-title><source>BMC Public Health</source><year>2006</year><volume>6</volume><fpage>294</fpage><pub-id pub-id-type="pmid">17150089</pub-id><pub-id pub-id-type="doi">10.1186/1471-2458-6-294</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bhopal</surname><given-names>R</given-names></name><name><surname>Vettini</surname><given-names>A</given-names></name><name><surname>Hunt</surnam