><source>J Gastroenterol Hepatol</source><year>2010</year><volume>25</volume><fpage>1636</fpage><lpage>1641</lpage><pub-id pub-id-type="pmid">20880172</pub-id></element-citation></ref><ref id="B21"><label>21</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ezoe</surname><given-names>Y</given-names></name><name><surname>Muto</surname><given-names>M</given-names></name><name><surname>Horimatsu</surname><given-names>T</given-names></name><etal/></person-group><article-title>Magnifying narrow-band imaging versus magnifying white-light imaging for the differential diagnosis of gastric small depressive lesions: a prospective study</article-title><source>Gastrointest Endosc</source><year>2010</year><volume>71</volume><fpage>477</fpage><lpage>484</lpage><pub-id pub-id-type="pmid">20189506</pub-id></element-citation></ref><ref id="B22"><label>22</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kato</surname><given-names>M</given-names></name><name><surname>Kaise</surname><given-names>M</given-names></name><name><surname>Yonezawa</surname><given-names>J</given-names></name><etal/></person-group><article-title>Magnifying endoscopy with narrow-band imaging achieves superior accuracy in the differential diagnosis of superficial gastric lesions identified with white-light endoscopy: a prospective study</article-title><source>Gastrointest Endosc</source><year>2010</year><volume>72</volume><fpage>523</fpage><lpage>529</lpage><pub-id pub-id-type="pmid">20598685</pub-id></element-citation></ref><ref id="B23"><label>23</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cho</surname><given-names>JY</given-names></name><name><surname>Hong</surname><given-names>SJ</given-names></name></person-group><article-title>Autofluorescence imaging: as a new method for predicting metachronous gastric cancer</article-title><sou