e><surname>Negro</surname><given-names>A</given-names></name><name><surname>Sarno</surname><given-names>S</given-names></name><name><surname>Ruzzene</surname><given-names>M</given-names></name><name><surname>Bertoli</surname><given-names>A</given-names></name><etal/></person-group><year>2000</year><article-title>Bovine prion protein as a modulator of protein kinase CK2.</article-title><source>Biochem J</source><volume>352</volume><fpage>191</fpage><lpage>196</lpage><pub-id pub-id-type="pmid">11062072</pub-id></mixed-citation></ref><ref id="pone.0006497-Rieger1"><label>15</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rieger</surname><given-names>R</given-names></name><name><surname>Edenhofer</surname><given-names>F</given-names></name><name><surname>Lasmezas</surname><given-names>CI</given-names></name><name><surname>Weiss</surname><given-names>S</given-names></name></person-group><year>1997</year><article-title>The human 37-kDa laminin receptor precursor interacts with the prion protein in eukaryotic cells.</article-title><source>Nat Med</source><volume>3</volume><fpage>1383</fpage><lpage>1388</lpage><pub-id pub-id-type="pmid">9396609</pub-id></mixed-citation></ref><ref id="pone.0006497-Graner1"><label>16</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Graner</surname><given-names>E</given-names></name><name><surname>Mercadante</surname><given-names>AF</given-names></name><name><surname>Zanata</surname><given-names>SM</given-names></name><name><surname>Forlenza</surname><given-names>OV</given-names></name><name><surname>Cabral</surname><given-names>AL</given-names></name><etal/></person-group><year>2000a</year><article-title>Cellular prion protein binds laminin and mediates neuritogenesis.</article-title><source>Brain Res Mol Brain Res</source><volume>76</volume><fpage>85</fpage><lpage>92</lpage><pub-id pub-id-type="pmid">10719218</pub-id></mixed-citation></ref><ref id="pone.0006497-Gauczynski2"><label>17</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gauczynski</surname><given-names>S</given-names></name><name><surname>Peyrin</surname><given-names>JM</given-names></name><name><surname>Haik</surname><given-names>S</given-names></name><name><surname>Leucht</surname><given-names>C</given-names></name><name><surname>Hundt</surname><given-names>C</given-names></name><etal/></person-group><year>2001</year><article-title>The 37-kDa/67-kDa laminin receptor acts as the cell-surface receptor for the cellular prion protein.</article-title><source>Embo J</source><volume>20</volume><fpage>5863</fpage><lpage>5875</lpage><pub-id pub-id-type="pmid">11689427</pub-id></mixed-citation></ref><ref id="pone.0006497-Hundt1"><label>18</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hundt</surname><given-names>C</given-names></name><name><surname>Peyrin</surname><given-names>JM</given-names></name><name><surname>Haik</surname><given-names>S</given-names></name><name><surname>Gauczynski</surname><given-names>S</given-names></name><name><surname>Leucht</surname><given-names>C</given-names></name><etal/></person-group><year>2001</year><article-title>Identification of interaction domains of the prion protein with its 37-kDa/67-kDa laminin receptor.</article-title><source>EMBO J</source><volume>20</volume><fpage>5876</fpage><lpage>5886</lpage><pub-id pub-id-type="pmid">11689428</pub-id></mixed-citation></ref><ref id="pone.0006497-SchmittUlms1"><label>19</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Schmitt-Ulms</surname><given-names>G</given-names></name><name><surname>Legname</surname><given-names>G</given-names></name><name><surname>Baldwin</surname><given-names>MA</given-names></name><name><surname>Ball</surname><given-names>HL</given-names></name><name><surname>