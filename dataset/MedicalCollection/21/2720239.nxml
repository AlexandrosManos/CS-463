e><!--PubMed citation query: 'Int J Cancer||122|1901||bib8|'--><pub-id pub-id-type="pmid">18076064</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Castle</surname><given-names>PE</given-names></name><name><surname>Jeronimo</surname><given-names>J</given-names></name><name><surname>Schiffman</surname><given-names>M</given-names></name><name><surname>Herrero</surname><given-names>R</given-names></name><name><surname>Rodriguez</surname><given-names>AC</given-names></name><name><surname>Bratti</surname><given-names>MC</given-names></name><name><surname>Hildesheim</surname><given-names>A</given-names></name><name><surname>Wacholder</surname><given-names>S</given-names></name><name><surname>Long</surname><given-names>LR</given-names></name><name><surname>Neve</surname><given-names>L</given-names></name><name><surname>Pfeiffer</surname><given-names>R</given-names></name><name><surname>Burk</surname><given-names>RD</given-names></name></person-group><article-title>Age-related changes of the cervix influence human papillomavirus type distribution</article-title><source>Cancer Res</source><year>2006</year><volume>66</volume><fpage>1218</fpage><lpage>1224</lpage><!--PubMed citation query: 'Cancer Res||66|1218||bib9|'--><pub-id pub-id-type="pmid">16424061</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cole</surname><given-names>ST</given-names></name><name><surname>Danos</surname><given-names>O</given-names></name></person-group><article-title>Nucleotide sequence and comparative analysis of the human papillomavirus type 18 genome. Phylogeny of papillomaviruses and repeated structure of the E6 and E7 gene products</article-title><source>J Mol Biol</source><year>1987</year><volume>193</volume><fpage>599</fpage><lpage>608</lpage><!--PubMed citation query: 'J Mol Biol||193|599||bib10|'--><pub-id pub-id-type="pmid">3039