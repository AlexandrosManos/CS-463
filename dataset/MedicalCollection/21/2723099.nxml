<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Trials</journal-id><journal-title>Trials</journal-title><issn pub-type="epub">1745-6215</issn><publisher><publisher-name>BioMed Central</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">19580665</article-id><article-id pub-id-type="pmc">2723099</article-id><article-id pub-id-type="publisher-id">1745-6215-10-49</article-id><article-id pub-id-type="doi">10.1186/1745-6215-10-49</article-id><article-categories><subj-group subj-group-type="heading"><subject>Study Protocol</subject></subj-group></article-categories><title-group><article-title>Stopping randomized trials early for benefit: a protocol of the Study Of Trial Policy Of Interim Truncation-2 (STOPIT-2)</article-title></title-group><contrib-group><contrib id="A1" contrib-type="author"><name><surname>Briel</surname><given-names>Matthias</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I2">2</xref><email>brielm@uhbs.ch</email></contrib><contrib id="A2" contrib-type="author"><name><surname>Lane</surname><given-names>Melanie</given-names></name><xref ref-type="aff" rid="I3">3</xref><email>lane.melanie@mayo.edu</email></contrib><contrib id="A3" corresp="yes" contrib-type="author"><name><surname>Montori</surname><given-names>Victor M</given-names></name><xref ref-type="aff" rid="I3">3</xref><email>montori.victor@mayo.edu</email></contrib><contrib id="A4" contrib-type="author"><name><surname>Bassler</surname><given-names>Dirk</given-names></name><xref ref-type="aff" rid="I4">4</xref><email>dirk.bassler@med.uni-tuebingen.de</email></contrib><contrib id="A5" contrib-type="author"><name><surname>Glasziou</surname><given-names>Paul</given-names></name><xref ref-type="aff" rid="I5">5</xref><email>paul.glasziou@dphpc.ox.ac.uk</email></contrib><contrib id="A6" contrib-type="author"><name><surname>Malaga</surname><given-names>German</given-names></name><xref ref-type="aff" rid="I6">6</xref><email>gmalaga01@gmail.com</email></contrib><contrib id="A7" contrib-type="author"><name><surname>Akl</surname><given-names>Elie A</given-names></name><xref ref-type="aff" rid="I7">7</xref><email>elieakl@buffalo.edu</email></contrib><contrib id="A8" contrib-type="author"><name><surname>Ferreira-Gonzalez</surname><given-names>Ignacio</given-names></name><xref ref-type="aff" rid="I8">8</xref><email>nacho_ferreira@hotmail.com</email></contrib><contrib id="A9" contrib-type="author"><name><surname>Alonso-Coello</surname><given-names>Pablo</given-names></name><xref ref-type="aff" rid="I9">9</xref><email>palonso@santpau.cat</email></contrib><contrib id="A10" contrib-type="author"><name><surname>Urrutia</surname><given-names>Gerard</given-names></name><xref ref-type="aff" rid="I9">9</xref><email>gurrutia@santpau.cat</email></contrib><contrib id="A11" contrib-type="author"><name><surname>Kunz</surname><given-names>Regina</given-names></name><xref ref-type="aff" rid="I2">2</xref><email>rkunz@uhbs.ch</email></contrib><contrib id="A12" contrib-type="author"><name><surname>Culebro</surname><given-names>Carolina Ruiz</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>caro.ruiz09@gmail.com</email></contrib><contrib id="A13" contrib-type="author"><name><surname>da Silva</surname><given-names>Suzana Alves</given-names></name><xref ref-type="aff" rid="I10">10</xref><email>suzana.silva@procardiaco.com.br</email></contrib><contrib id="A14" contrib-type="author"><name><surname>Flynn</surname><given-names>David N</given-names></name><xref ref-type="aff" rid="I3">3</xref><email>dnflynn@gmail.com</email></contrib><contrib id="A15" contrib-type="author"><name><surname>Elamin</surname><given-names>Mohamed B</given-names></name><xref ref-type="aff" rid="I3">3</xref><email>elamin.mohamed@mayo.edu</email></contrib><contrib id="A16" contrib-type="author"><name><surname>Strahm</surname><given-names>Brigitte</given-names></name><xref ref-type="aff" rid="I11">11</xref><email>brigitte.strahm@uniklinik-freiburg.de</email></contrib><contrib id="A17" contrib-type="author"><name><surname>Murad</surname><given-names>M Hassan</given-names></name><xref ref-type="aff" rid="I3">3</xref><email>murad.mohammad@mayo.edu</email></contrib><contrib id="A18" contrib-type="author"><name><surname>Djulbegovic</surname><given-names>Benjamin</given-names></name><xref ref-type="aff" rid="I12">12</xref><email>bdjulbeg@health.usf.edu</email></contrib><contrib id="A19" contrib-type="author"><name><surname>Adhikari</surname><given-names>Neill KJ</given-names></name><xref ref-type="aff" rid="I13">13</xref><email>neill.adhikari@utoronto.ca</email></contrib><contrib id="A20" contrib-type="author"><name><surname>Mills</surname><given-names>Edward J</given-names></name><xref ref-type="aff" rid="I14">14</xref><email>emills@cfenet.ubc.ca</email></contrib><contrib id="A21" contrib-type="author"><name><surname>Gwadry-Sridhar</surname><given-names>Femida</given-names></name><xref ref-type="aff" rid="I15">15</xref><email>femida.gwadrysridhar@lhsc.on.ca</email></contrib><contrib id="A22" contrib-type="author"><name><surname>Kirpalani</surname><given-names>Haresh</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I16">16</xref><email>kirpalanih@email.chop.edu</email></contrib><contrib id="A23" contrib-type="author"><name><surname>Soares</surname><given-names>Heloisa P</given-names></name><xref ref-type="aff" rid="I17">17</xref><email>soareshp@gmail.com</email></contrib><contrib id="A24" contrib-type="author"><name><surname>Elnour</surname><given-names>Nisrin O Abu</given-names></name><xref ref-type="aff" rid="I3">3</xref><email>abuelnour.nisrin@mayo.edu</email></contrib><contrib id="A25" contrib-type="author"><name><surname>You</surname><given-names>John J</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>jyou@mcmaster.ca</email></contrib><contrib id="A26" contrib-type="author"><name><surname>Karanicolas</surname><given-names>Paul J</given-names></name><xref ref-type="aff" rid="I15">15</xref><email>pjkarani@uwo.ca</email></contrib><contrib id="A27" contrib-type="author"><name><surname>Bucher</surname><given-names>Heiner C</given-names></name><xref ref-type="aff" rid="I2">2</xref><email>hbucher@uhbs.ch</email></contrib><contrib id="A28" contrib-type="author"><name><surname>Lampropulos</surname><given-names>Julianna F</given-names></name><xref ref-type="aff" rid="I3">3</xref><email>lampropulos.julianna@mayo.edu</email></contrib><contrib id="A29" contrib-type="author"><name><surname>Nordmann</surname><given-names>Alain J</given-names></name><xref ref-type="aff" rid="I2">2</xref><email>anordmann@uhbs.ch</email></contrib><contrib id="A30" contrib-type="author"><name><surname>Burns</surname><given-names>Karen EA</given-names></name><xref ref-type="aff" rid="I18">18</xref><email>burnsk@smh.toronto.on.ca</email></contrib><contrib id="A31" contrib-type="author"><name><surname>Mulla</surname><given-names>Sohail M</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>mullasm@mcmaster.ca</email></contrib><contrib id="A32" contrib-type="author"><name><surname>Raatz</surname><given-names>Heike</given-names></name><xref ref-type="aff" rid="I2">2</xref><email>hraatz@uhbs.ch</email></contrib><contrib id="A33" contrib-type="author"><name><surname>Sood</surname><given-names>Amit</given-names></name><xref ref-type="aff" rid="I3">3</xref><email>sood.amit@mayo.edu</email></contrib><contrib id="A34" contrib-type="author"><name><surname>Kaur</surname><given-names>Jagdeep</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>kaurj4@mcmaster.ca</email></contrib><contrib id="A35" contrib-type="author"><name><surname>Bankhead</surname><given-names>Clare R</given-names></name><xref ref-type="af