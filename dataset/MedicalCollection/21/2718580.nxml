d-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Redline</surname><given-names>RW</given-names></name><name><surname>Faye-Petersen</surname><given-names>O</given-names></name><name><surname>Heller</surname><given-names>D</given-names></name><name><surname>Qureshi</surname><given-names>F</given-names></name><name><surname>Savell</surname><given-names>V</given-names></name><etal/></person-group><year>2003</year><article-title>Amniotic infection syndrome: nosology and reproducibility of placental reaction patterns.</article-title><source>Pediatr Dev Pathol</source><volume>6</volume><fpage>435</fpage><lpage>448</lpage><pub-id pub-id-type="pmid">14708737</pub-id></mixed-citation></ref><ref id="pone.0006572-Lopez1"><label>17</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lopez</surname><given-names>BA</given-names></name></person-group><year>2003</year><article-title>Mechanisms of labour&#x02013;biochemical aspects.</article-title><source>BJOG</source><volume>110</volume><issue>Suppl 20</issue><fpage>39</fpage><lpage>45</lpage></mixed-citation></ref><ref id="pone.0006572-Winkler1"><label>18</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Winkler</surname><given-names>M</given-names></name></person-group><year>2003</year><article-title>Role of cytokines and other inflammatory mediators.</article-title><source>BJOG</source><volume>110</volume><issue>Suppl 20</issue><fpage>118</fpage><lpage>123</lpage><pub-id pub-id-type="pmid">12763128</pub-id></mixed-citation></ref><ref id="pone.0006572-Maul1"><label>19</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Maul</surname><given-names>H</given-names></name><name><surname>Mackay</surname><given-names>L</given-names></name><name><surname>Garfield</surname><given-names>RE</given-names></name></person-group><year>2006<