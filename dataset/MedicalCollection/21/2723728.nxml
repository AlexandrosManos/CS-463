ame><name><surname>B&#x000fc;hl</surname><given-names>M</given-names></name><name><surname>Malkin</surname><given-names>VG</given-names></name></person-group><article-title>Spin-spin coupling constants with HF and DFT method</article-title><source><italic>Calculations of NMR and EPR Parameters: Theory and Applications</italic></source><year>2004</year><issue>chapter 7</issue><publisher-loc>Weinheim, Germany</publisher-loc><publisher-name>Wiley-VCH</publisher-name></element-citation></ref><ref id="B113"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Meinwald</surname><given-names>J</given-names></name><name><surname>Dauplaise</surname><given-names>D</given-names></name><name><surname>Wudl</surname><given-names>F</given-names></name><name><surname>Hauser</surname><given-names>JJ</given-names></name></person-group><article-title>Peri-bridged naphthalenes from 1,8-dilithionaphthalene</article-title><source><italic>Journal of the American Chemical Society</italic></source><year>1977</year><volume>99</volume><issue>1</issue><fpage>255</fpage><lpage>257</lpage></element-citation></ref><ref id="B114"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Meinwald</surname><given-names>J</given-names></name><name><surname>Dauplaise</surname><given-names>D</given-names></name><name><surname>Clardy</surname><given-names>J</given-names></name></person-group><article-title>Peri-bridged naphthalenes. 2. Unsymmetrical diatomic chalcogen bridges</article-title><source><italic>Journal of the American Chemical Society</italic></source><year>1977</year><volume>99</volume><issue>23</issue><fpage>7743</fpage><lpage>7744</lpage></element-citation></ref><ref id="B115"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dauplaise</surname><given-names>D</given-names></name><name><surname>Meinwald</surname><given-names>J</given-names></name><name><surname>Scott</surname><given-names>JC</given-names></name><name><surname>Temkin</surname><given-names>H</given-names></name><name><surname>Clardy</surname><given-names>J</given-names></name></person-group><article-title>Synthesis and properties of chalcogen-bridged naphthalenes: a new series of electron donors</article-title><source><italic>Annals of the New York Academy of Sciences</italic></source><year>1978</year><volume>313</volume><issue>1</issue><fpage>382</fpage><lpage>394</lpage></element-citation></ref><ref id="B116"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Yui</surname><given-names>K</given-names></name><name><surname>Aso</surname><given-names>Y</given-names></name><name><surname>Otsubo</surname><given-names>T</given-names></name></person-group><article-title>Syntheses and properties of binaphtho[1,8-del-1,3-dithiin-2-ylidene and its selenium analogue</article-title><source><italic>Chemistry Letters</italic></source><year>1986</year><volume>15</volume><issue>4</issue><fpage>551</fpage><lpage>554</lpage></element-citation></ref><ref id="B117"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Aso</surname><given-names>Y</given-names></name><name><surname>Yui</surname><given-names>K</given-names></name><name><surname>Miyoshi</surname><given-names>T</given-names></name><name><surname>Otsubo</surname><given-names>T</given-names></name><name><surname>Ogura</surname><given-names>F</given-names></name><name><surname>Tanaka</surname><given-names>J</given-names></name></person-group><article-title>Dichalcogen-bridged acenaphthenes as new electron donors</article-title><source><italic>Bulletin of the Chemical Society of Japan</italic></source><year>1988</year><volume>61</volume><issue>6</issue><fpage>2013</fpage><lpage>2018</lpage></element-citation></ref><ref id="B23">