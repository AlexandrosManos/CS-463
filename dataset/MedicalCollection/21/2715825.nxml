r"><name><surname>Crick</surname><given-names>F</given-names></name><name><surname>Koch</surname><given-names>C</given-names></name></person-group><article-title>A framework for consciousness</article-title><source><italic>Nature Neuroscience</italic></source><year>2003</year><volume>6</volume><issue>2</issue><fpage>119</fpage><lpage>126</lpage></element-citation></ref><ref id="B57"><label>118</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gutig</surname><given-names>R</given-names></name><name><surname>Sompolinsky</surname><given-names>H</given-names></name></person-group><article-title>The tempotron: a neuron that learns spike timing-based decisions</article-title><source><italic>Nature Neuroscience</italic></source><year>2006</year><volume>9</volume><issue>3</issue><fpage>420</fpage><lpage>428</lpage></element-citation></ref><ref id="B110"><label>119</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nelson</surname><given-names>SB</given-names></name></person-group><article-title>Cortical microcircuits: diverse or canonical?</article-title><source><italic>Neuron</italic></source><year>2002</year><volume>36</volume><issue>1</issue><fpage>19</fpage><lpage>27</lpage><pub-id pub-id-type="pmid">12367502</pub-id></element-citation></ref><ref id="B109"><label>120</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nedergaard</surname><given-names>M</given-names></name><name><surname>Ransom</surname><given-names>B</given-names></name><name><surname>Goldman</surname><given-names>SA</given-names></name></person-group><article-title>New roles for astrocytes: redefining the functional architecture of the brain</article-title><source><italic>Trends in Neurosciences</italic></source><year>2003</year><volume>26</volume><issue>10</issue><fpage>523</fpage><lpage>530</lpage><pub-id pub-id-type="pmid">14522144</pub-id></element-citation></ref><ref id="B44"><label>121</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Fellin</surname><given-names>T</given-names></name><name><surname>Carmignoto</surname><given-names>G</given-names></name></person-group><article-title>Neurone-to-astrocyte signalling in the brain represents a distinct multifunctional unit</article-title><source><italic>Journal of Physiology</italic></source><year>2004</year><volume>559</volume><issue>1</issue><fpage>3</fpage><lpage>15</lpage><pub-id pub-id-type="pmid">15218071</pub-id></element-citation></ref><ref id="B12"><label>122</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bullock</surname><given-names>TH</given-names></name><name><surname>Bennett</surname><given-names>MVL</given-names></name><name><surname>Johnston</surname><given-names>D</given-names></name><name><surname>Josephson</surname><given-names>R</given-names></name><name><surname>Marder</surname><given-names>E</given-names></name><name><surname>Fields</surname><given-names>RD</given-names></name></person-group><article-title>The neuron doctrine, redux</article-title><source><italic>Science</italic></source><year>2005</year><volume>310</volume><issue>5749</issue><fpage>791</fpage><lpage>793</lpage><pub-id pub-id-type="pmid">16272104</pub-id></element-citation></ref><ref id="B154"><label>123</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Volterra</surname><given-names>A</given-names></name><name><surname>Meldolesi</surname><given-names>J</given-names></name></person-group><article-title>Astrocytes, from brain glue to communication elements: the revolution continues</article-title><source><italic>Nature Reviews Neuroscience</italic></source><year>2005</year><volume>6</volume><issue>8</issue><fpage>626</fpage><lpage>640</lpage></element-citation></ref><ref id="B156"><