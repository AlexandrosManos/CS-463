>2003</year><article-title>Evolution of Networks: From Biological Nets to the Internet and WWW.</article-title><publisher-name>Oxford University Press</publisher-name></mixed-citation></ref><ref id="pone.0006633-Zhu1"><label>23</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Zhu</surname><given-names>D</given-names></name><name><surname>Qin</surname><given-names>Z</given-names></name></person-group><year>2005</year><article-title>Structural comparison of metabolic networks in selected single cell organisms.</article-title><source>BMC Bioinformatics</source><volume>6</volume><fpage>8</fpage><pub-id pub-id-type="pmid">15649332</pub-id></mixed-citation></ref><ref id="pone.0006633-Rustici1"><label>24</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rustici</surname><given-names>G</given-names></name><name><surname>Mata</surname><given-names>J</given-names></name><name><surname>Kivinen</surname><given-names>K</given-names></name><name><surname>Lio</surname><given-names>P</given-names></name><name><surname>Penkett</surname><given-names>C</given-names></name><etal/></person-group><year>2004</year><article-title>Periodic gene expression program of the fission yeast cell cycle.</article-title><source>Nature Genetics</source><volume>36</volume><fpage>809</fpage><lpage>817</lpage><pub-id pub-id-type="pmid">15195092</pub-id></mixed-citation></ref><ref id="pone.0006633-Arita1"><label>25</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Arita</surname><given-names>M</given-names></name></person-group><year>2004</year><article-title>The metabolic world of escherichia coli is not small.</article-title><source>Proc Natl Acad Sci USA</source><volume>101</volume><fpage>1543</fpage><lpage>1547</lpage><pub-id pub-id-type="pmid">14757824</pub-id></mixed-citation></ref><ref id="pone.0006633-Rahman1"><label>26</label><mix