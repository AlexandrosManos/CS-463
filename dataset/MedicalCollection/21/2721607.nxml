year><volume>16</volume><fpage>299</fpage><lpage>303</lpage><pub-id pub-id-type="pmid">12839503</pub-id></element-citation></ref><ref id="CIT10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ash</surname><given-names>SR</given-names></name></person-group><article-title>Chronic peritoneal dialysis catheters: Overview of design, placement and removal procedrues</article-title><source>Semin Dial</source><year>2003</year><volume>16</volume><fpage>323</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">12839507</pub-id></element-citation></ref><ref id="CIT11"><label>11</label><element-citation publication-type="journal"><collab>Caring for Australians with Renal Impairment (CARI)</collab><article-title>The CARI guidelines. Evidence for peritonitis treatment and prophylaxis: Technique of insertion of peritoneal dialysis catheter</article-title><source>Nephrology</source><year>2004</year><volume>9</volume><fpage>S65</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">15469561</pub-id></element-citation></ref><ref id="CIT12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Johanson</surname><given-names>DW</given-names></name></person-group><article-title>Management of Tenckhoff exit sites</article-title><source>Nephrology</source><year>2002</year><volume>7</volume><fpage>D62</fpage><lpage>3</lpage></element-citation></ref><ref id="CIT13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Shroff</surname><given-names>RC</given-names></name><name><surname>Shanahan</surname><given-names>CM</given-names></name></person-group><article-title>The vascular biology of calcification</article-title><source>Semin Dial</source><year>2007</year><volume>20</volume><fpage>103</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">17374082</pub-id></element-citation></ref><ref id="CIT14"><labe