004</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hoft</surname><given-names>DF</given-names></name></person-group><article-title>Tuberculosis vaccine development: goals, immunological design, and evaluation</article-title><source>Lancet</source><year>2008</year><volume>372</volume><fpage>164</fpage><lpage>175</lpage><pub-id pub-id-type="pmid">18620952</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(08)61036-3</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Behr</surname><given-names>MA</given-names></name></person-group><article-title>Correlation between BCG genomics and protective efficacy</article-title><source>Scand J Infect Dis</source><year>2001</year><volume>33</volume><fpage>249</fpage><lpage>252</lpage><pub-id pub-id-type="pmid">11345214</pub-id><pub-id pub-id-type="doi">10.1080/003655401300077180</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McMurray</surname><given-names>DN</given-names></name><name><surname>Bartow</surname><given-names>RA</given-names></name></person-group><article-title>Immunosuppression and alteration of resistance to pulmonary tuberculosis in guinea pigs by protein undernutrition</article-title><source>J Nutr</source><year>1992</year><volume>122</volume><fpage>738</fpage><lpage>743</lpage><pub-id pub-id-type="pmid">1347317</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huygen</surname><given-names>K</given-names></name></person-group><article-title>Plasmid DNA vaccination</article-title><source>Microbes Infect</source><year>2005</year><volume>7</volume><fpage>932</fpage><lpage>938</lpage><pub-id pub-id-type="pmid">15878683</pub-id><pub-id pub-id-type="doi">10.1016/j.micinf.2005.03.010</pub-id></citation></r