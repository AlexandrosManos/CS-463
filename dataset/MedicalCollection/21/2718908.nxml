><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Drakeley</surname><given-names>C</given-names></name><name><surname>Sutherland</surname><given-names>C</given-names></name><name><surname>Bousema</surname><given-names>JT</given-names></name><name><surname>Sauerwein</surname><given-names>RW</given-names></name><name><surname>Targett</surname><given-names>GA</given-names></name></person-group><article-title>The epidemiology of <italic>Plasmodium falciparum </italic>gametocytes: Weapons of mass dispersion</article-title><source>Trends Parasitol</source><year>2006</year><volume>22</volume><fpage>424</fpage><lpage>430</lpage><pub-id pub-id-type="pmid">16846756</pub-id><pub-id pub-id-type="doi">10.1016/j.pt.2006.07.001</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Talman</surname><given-names>AM</given-names></name><name><surname>Domarle</surname><given-names>O</given-names></name><name><surname>McKenzie</surname><given-names>FE</given-names></name><name><surname>Ariey</surname><given-names>F</given-names></name><name><surname>Robert</surname><given-names>V</given-names></name></person-group><article-title>Gametocytogenesis: The puberty of <italic>Plasmodium falciparum </italic></article-title><source>Malar J</source><year>2004</year><volume>3</volume><fpage>24</fpage><pub-id pub-id-type="pmid">15253774</pub-id><pub-id pub-id-type="doi">10.1186/1475-2875-3-24</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Abdel-Wahab</surname><given-names>A</given-names></name><name><surname>Abdel-Muhsin</surname><given-names>AM</given-names></name><name><surname>Ali</surname><given-names>E</given-names></name><name><surname>Suleiman</surname><given-names>S</given-names></name><name><surname>Ahmed</surname><given-names>S</given-names></name><name><surname>Walliker</surname><g