olume><fpage>897</fpage><lpage>903</lpage><pub-id pub-id-type="pmid">18552846</pub-id></mixed-citation></ref><ref id="pgen.1000597-Jia1"><label>12</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jia</surname><given-names>L</given-names></name><name><surname>Berman</surname><given-names>BP</given-names></name><name><surname>Jariwala</surname><given-names>U</given-names></name><name><surname>Yan</surname><given-names>X</given-names></name><name><surname>Cogan</surname><given-names>JP</given-names></name><etal/></person-group><year>2008</year><article-title>Genomic androgen receptor-occupied regions with different functions, defined by histone acetylation, coregulators and transcriptional capacity.</article-title><source>PLoS ONE</source><volume>3</volume><fpage>e3645</fpage><comment>doi:<ext-link ext-link-type="uri" xlink:href="http://dx.doi.org/10.1371/journal.pone.0003645">10.1371/journal.pone.0003645</ext-link></comment><pub-id pub-id-type="pmid">18997859</pub-id></mixed-citation></ref><ref id="pgen.1000597-Mendenhall1"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mendenhall</surname><given-names>EM</given-names></name><name><surname>Bernstein</surname><given-names>BE</given-names></name></person-group><year>2008</year><article-title>Chromatin state maps: new technologies, new insights.</article-title><source>Curr Opin Genet Dev</source><volume>18</volume><fpage>109</fpage><lpage>115</lpage><pub-id pub-id-type="pmid">18339538</pub-id></mixed-citation></ref><ref id="pgen.1000597-Pomerantz1"><label>14</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Pomerantz</surname><given-names>MM</given-names></name><name><surname>Beckwith</surname><given-names>CA</given-names></name><name><surname>Regan</surname><given-names>MM</given-names></name><name><surname>Wyman</surname><given-names>SK</gi