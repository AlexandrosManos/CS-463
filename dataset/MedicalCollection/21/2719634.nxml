-names>AX</given-names></name><name><surname>Mejido</surname><given-names>J</given-names></name><name><surname>Bhattacharya</surname><given-names>B</given-names></name><name><surname>Petersen</surname><given-names>D</given-names></name><name><surname>Han</surname><given-names>J</given-names></name><name><surname>Kawasaki</surname><given-names>ES</given-names></name><name><surname>Puri</surname><given-names>RK</given-names></name></person-group><article-title>Analysis of the quality of contact pin fabricated oligonucleotide microarrays</article-title><source>Mol BioTechnol</source><year>2006</year><volume>34</volume><fpage>303</fpage><lpage>316</lpage><pub-id pub-id-type="pmid">17284778</pub-id><pub-id pub-id-type="doi">10.1385/MB:34:3:303</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Han</surname><given-names>J</given-names></name><name><surname>Lee</surname><given-names>H</given-names></name><name><surname>Nguyen</surname><given-names>NY</given-names></name><name><surname>Beaucage</surname><given-names>SL</given-names></name><name><surname>Puri</surname><given-names>RK</given-names></name></person-group><article-title>Novel multiple 5'-amino modified primer for DNA microarrays</article-title><source>Genomics</source><year>2005</year><volume>86</volume><fpage>252</fpage><lpage>258</lpage><pub-id pub-id-type="pmid">15949917</pub-id><pub-id pub-id-type="doi">10.1016/j.ygeno.2005.04.009</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>J&#x000e4;rvinen</surname><given-names>AK</given-names></name><name><surname>Autio</surname><given-names>R</given-names></name><name><surname>Haapa-Paananen</surname><given-names>S</given-names></name><name><surname>Wolf</surname><given-names>M</given-names></name><name><surname>Saarela</surname><given-names>M</given-names></name><name><surname>Gr&#x000e9;nmam</surname><given-name