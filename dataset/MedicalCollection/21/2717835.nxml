</article-title><source>Reviews in Reproduction</source><volume>1</volume><fpage>82</fpage><lpage>88</lpage></mixed-citation></ref><ref id="b17-bmi-2007-241"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>De Miguel</surname><given-names>MP</given-names></name><name><surname>Cheng</surname><given-names>L</given-names></name><name><surname>Holland</surname><given-names>EC</given-names></name><etal/></person-group><year>2002</year><article-title>Dissection of the c-Kit signaling pathway in mouse primordial germ cells by retroviral-mediated gene transfer</article-title><source>PNAS</source><volume>99</volume><fpage>10458</fpage><lpage>10463</lpage><pub-id pub-id-type="pmid">12140361</pub-id></mixed-citation></ref><ref id="b18-bmi-2007-241"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>De Rooij</surname><given-names>DG</given-names></name></person-group><year>2001</year><article-title>Proliferation and differentiation of spermatogonial stem cells</article-title><source>Reproduction</source><volume>121</volume><fpage>347</fpage><lpage>354</lpage><pub-id pub-id-type="pmid">11226060</pub-id></mixed-citation></ref><ref id="b19-bmi-2007-241"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dolci</surname><given-names>S</given-names></name><name><surname>Williams</surname><given-names>DE</given-names></name><name><surname>Ernst</surname><given-names>MK</given-names></name><etal/></person-group><year>1991</year><article-title>Requirement for mast cell growth factor for primordial germ cell survival in culture</article-title><source>Nature</source><volume>352</volume><fpage>809</fpage><lpage>811</lpage><pub-id pub-id-type="pmid">1715518</pub-id></mixed-citation></ref><ref id="b20-bmi-2007-241"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Duval</surname><given-names>D</given