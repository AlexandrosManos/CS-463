 xlink:href="EF632212">EF632212</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AF206597">AF206597</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AF206597">AF206597</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="LVU88611">LVU88611</ext-link></td></tr><tr><td align="left"><italic>Dinarolacerta mosorensis</italic></td><td align="center"><ext-link ext-link-type="gen" xlink:href="EF632270">EF632270</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="EF632227">EF632227</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AF440600">AF440600</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AF440615">AF440615</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AY151902">AY151902</ext-link></td></tr><tr><td align="left"><italic>Eremias arguta</italic></td><td align="center"><ext-link ext-link-type="gen" xlink:href="EF632258">EF632258</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="EF632213">EF632213</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AY035827">AY035827</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AY035837">AY035837</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AF206549">AF206549</ext-link><sup>c</sup></td></tr><tr><td align="left"><italic>Gallotia galloti</italic></td><td align="center"><ext-link ext-link-type="gen" xlink:href="EF632260">EF632260</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="EF632215">EF632215</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AF206587">AF206587</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AF206587">AF206587</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AY151840">AY151840</ext-link></td></tr><tr><td align="left"><italic>Heliobolus spekii</italic></td><td align="center"><ext-link ext-link-type="gen" xlink:href="EF632262">EF632262</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="EF632217">EF632217</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AF206608">AF206608</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AF206608">AF206608</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AF206544">AF206544</ext-link></td></tr><tr><td align="left"><italic>Hellenolacerta graeca</italic></td><td align="center"><ext-link ext-link-type="gen" xlink:href="EF632269">EF632269</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="EF632225">EF632225</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AF440602">AF440602</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AF440617">AF440617</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AF080272">AF080272</ext-link></td></tr><tr><td align="left"><italic>Iberolacerta monticola</italic></td><td align="center"><ext-link ext-link-type="gen" xlink:href="EF632265">EF632265</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="EF632220">EF632220</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AF440589">AF440589</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AF440604">AF440604</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AY151872">AY151872</ext-link></td></tr><tr><td align="left"><italic>Ichnotropis squamulosa</italic></td><td align="center"><ext-link ext-link-type="gen" xlink:href="EF632266">EF632266</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="EF632221">EF632221</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AF080365">AF080365</ext-link></td><td align="center"><ext-link ext-link-type="gen" 