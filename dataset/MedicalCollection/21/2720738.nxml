ub-id pub-id-type="pmid">1380546</pub-id></mixed-citation></ref><ref id="b29-ijn-4-009"><label>29.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Muldoon</surname><given-names>L</given-names></name><name><surname>Sandor</surname><given-names>M</given-names></name><name><surname>Pinkston</surname><given-names>K</given-names></name><etal/></person-group><article-title>Imaging, distribution, and toxicity of superparamagnetic iron oxide magnetic resonance nanoparticles in the rat brain and intracerebral tumor</article-title><source>Neurosurgery</source><year>2005</year><volume>57</volume><fpage>785</fpage><lpage>796</lpage><pub-id pub-id-type="pmid">16239893</pub-id></mixed-citation></ref></ref-list></back><floats-group><fig id="f1-ijn-4-009" position="float"><label>Figure 1</label><caption><p>Experimental setup to study the transport characteristic of the ferrofluid in a controlled environment. The magnet was placed below the sample cell at different distances to vary the magnetic field gradient.</p></caption><graphic xlink:href="ijn-4-009f1"/></fig><fig id="f2-ijn-4-009" position="float"><label>Figure 2</label><caption><p>Variation of normalized scattering intensity (normalized at t = 0s) with time for material 3 (110 nm ferrofluid) at various applied magnetic field gradient.</p></caption><graphic xlink:href="ijn-4-009f2"/></fig><fig id="f3-ijn-4-009" position="float"><label>Figure 3</label><caption><p>Comparison of characteristic time of collisional growth in magnetic field (&#x003c4;<sub>c</sub>) and characteristic time to traverse 1 cm (&#x003c4;<sub>m</sub>) for different ferrofluids at various magnetic field gradients.</p></caption><graphic xlink:href="ijn-4-009f3"/></fig><fig id="f4-ijn-4-009" position="float"><label>Figure 4</label><caption><p><bold>A</bold>) Variation of normalized scattering intensity (normalized at t = 30 s) for material 2 (130 nm ferrofluid) at various applied magnetic field gradient. <bold>B</bold>) Variation of normalized scattering intensity (normalized at t = 30 s) for material 1 (250 nm ferrofluid) at various applied magnetic field gradient.</p></caption><graphic xlink:href="ijn-4-009f4"/></fig><fig id="f5-ijn-4-009" position="float"><label>Figure 5</label><caption><p>Comparison of experimentally measured velocity (<italic>v</italic><sub>e</sub>) with theoretically predicted velocity based on single particle force balance (<italic>v</italic><sub>t,1</sub>) for different ferrofluid at various magnetic field gradients.</p></caption><graphic xlink:href="ijn-4-009f5"/></fig><fig id="f6-ijn-4-009" position="float"><label>Figure 6</label><caption><p>SEM images of different ferrofluids in the absence or presence of an external magnetic field.</p></caption><graphic xlink:href="ijn-4-009f6"/></fig><fig id="f7-ijn-4-009" position="float"><label>Figure 7</label><caption><p>Plot of average normalized pixel values for gels with different size particles as a function of time and external magnetic field gradient.</p></caption><graphic xlink:href="ijn-4-009f7"/></fig><table-wrap id="t1-ijn-4-009" position="float"><label>Table 1</label><caption><p>Size and magnetic properties of nanomaterials used</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1">Material</th><th align="left" rowspan="1" colspan="1">Mean primary particle size (nm)</th><th align="left" rowspan="1" colspan="1">Composition</th><th align="left" rowspan="1" colspan="1">Density (kg m<sup>&#x02212;3</sup>)</th><th align="left" rowspan="1" colspan="1">Moment (emu gm<sup>&#x02212;1</sup> @ 1 kOe)</th><th align="left" rowspan="1" colspan="1">Saturated moment (emu gm<sup>&#x02212;1</sup> @ 10 kOe)</th><th align="left" rowspan="1" colspan="1">&#x003c7;<sub>v</sub> (Volumetric magnetic susceptibility @ 1 kOe)</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">250</td><td align="left" rowspan="1" colspan="1">PEG-coated Fe<sub>3</sub>O<sub>4</sub></td><td align="left" rowspan="1" colspan="1"><xref ref-type="table-fn" rid="tfn1-ijn-4-009">a</xref>2500</td><td align="left" rowspan="1" colspan="1"><xref ref-type="table-fn" rid="tfn1-ijn-4-009">a</xref>43.0</td><td align="left" rowspan="1" colspan="1"><xref ref-type="table-fn" rid="tfn1-ijn-4-009">a</xref>67.0</td><td align="left" rowspan="1" colspan="1">1.351</td></tr><tr><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">130</td><td align="left" rowspan="1" colspan="1">PEG-coated Fe<sub>3</sub>O<sub>4</sub></td><td align="left" rowspan="1" colspan="1"><xref ref-type="table-fn" rid="tfn1-ijn-4-009">a</xref>3000</td><td align="left" rowspan="1" colspan="1"><xref ref-type="table-fn" rid="tfn1-ijn-4-009">a</xref>43.0</td><td align="left" rowspan="1" colspan="1"><xref ref-type="table-fn" rid="tfn1-ijn-4-009">a</xref>67.0</td><td align="left" rowspan="1" colspan="1">1.621</td></tr><tr><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">110</td><td align="left" rowspan="1" colspan="1">CuFe<sub>2</sub>O<sub>4</sub></td><td align="left" rowspan="1" colspan="1"><xref ref-type="table-fn" rid="tfn2-ijn-4-009">b</xref>5400</td><td align="left" rowspan="1" colspan="1"><xref ref-type="table-fn" rid="tfn3-ijn-4-009">c</xref>27.5</td><td align="left" rowspan="1" colspan="1"><xref ref-type="table-fn" rid="tfn3-ijn-4-009">c</xref>38.6</td><td align="left" rowspan="1" colspan="1">1.866</td></tr></tbody></table><table-wrap-foot><fn id="tfn1-ijn-4-009"><label><sup>a</sup></label><p><bold>Notes:</bold> Supplied by MicroMod Partikeltechnologie GmbH (Germany);</p></fn><fn id="tfn2-ijn-4-009"><label><sup>b</sup></label><p>Bulk density;</p></fn><fn id="tfn3-ijn-4-009"><label><sup>c</sup></label><p>Measured using Physical Property Measurement System (PPMS, Model: 6000, Quantum Design).</p></fn></table-wrap-foot></table-wrap><table-wrap id="t2-ijn-4-009" pos