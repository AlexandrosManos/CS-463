e>2387</fpage><lpage>98</lpage><pub-id pub-id-type="pmid">14681504</pub-id></element-citation></ref><ref id="CIT30"><label>30</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Anonymous</surname></name></person-group><article-title>Long term BPH treatment</article-title><source>Bandolier</source><year>2004</year><volume>11</volume><fpage>1</fpage><lpage>4</lpage></element-citation></ref><ref id="CIT31"><label>31</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nuovo</surname><given-names>J</given-names></name><name><surname>Melnikow</surname><given-names>J</given-names></name><name><surname>Chang</surname><given-names>D</given-names></name></person-group><article-title>Reporting number needed to treat and absolute risk reduction in randomized controlled trials</article-title><source>JAMA</source><year>2002</year><volume>287</volume><fpage>2813</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">12038920</pub-id></element-citation></ref><ref id="CIT32"><label>32</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Schilling</surname><given-names>LM</given-names></name><name><surname>Steiner</surname><given-names>JF</given-names></name><name><surname>Lundahl</surname><given-names>K</given-names></name><name><surname>Anderson</surname><given-names>RJ</given-names></name></person-group><article-title>Residents&#x02019; patient-specific clinical questions: Opportunities for evidence-based learning</article-title><source>Acad Med</source><year>2005</year><volume>80</volume><fpage>51</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">15618093</pub-id></element-citation></ref><ref id="CIT33"><label>33</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>A</given-names></name><name><surname>Kraft</surname><given-names>D</given-names></name><name><surname>Schmitz</surname><given-names>SM</given-names></name><name><surname>Sharpless</surname><given-names>V</given-names></name><name><surname>Martin</surname><given-names>C</given-names></name><name><surname>Shah</surname><given-names>R</given-names></name><etal/></person-group><article-title>Association of industry sponsorship to published outcomes in gastrointestinal clinical research</article-title><source>Clin Gastroenterol Hepatol</source><year>2006</year><volume>4</volume><fpage>1445</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">17101295</pub-id></element-citation></ref></ref-list></back></article>