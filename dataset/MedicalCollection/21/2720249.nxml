 citation-type="journal"><person-group person-group-type="author"><name><surname>Oakley</surname><given-names>R</given-names></name><name><surname>Phillips</surname><given-names>E</given-names></name><name><surname>Hooper</surname><given-names>R</given-names></name><name><surname>Wilson</surname><given-names>D</given-names></name><name><surname>Partridge</surname><given-names>M</given-names></name></person-group><article-title>A preclinical model of minimal residual cancer in the muscle highlights challenges associated with adenovirus-mediated p53 gene transfer</article-title><source>Clin Cancer Res</source><year>2002</year><volume>8</volume><fpage>1984</fpage><lpage>1994</lpage><!--PubMed citation query: 'Clin Cancer Res||8|1984||bib11|'--><pub-id pub-id-type="pmid">12060644</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Partridge</surname><given-names>M</given-names></name><name><surname>Gaballah</surname><given-names>K</given-names></name><name><surname>Huang</surname><given-names>X</given-names></name></person-group><article-title>Molecular markers for diagnosis and prognosis</article-title><source>Cancer Metastasis Rev</source><year>2005</year><volume>24</volume><fpage>71</fpage><lpage>85</lpage><!--PubMed citation query: 'Cancer Metastasis Rev||24|71||bib12|'--><pub-id pub-id-type="pmid">15785873</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Partridge</surname><given-names>M</given-names></name><name><surname>Li</surname><given-names>SR</given-names></name><name><surname>Pateromichelakis</surname><given-names>S</given-names></name><name><surname>Francis</surname><given-names>R</given-names></name><name><surname>Phillips</surname><given-names>E</given-names></name><name><surname>Huang</surname><given-names>XH</given-names></name><name><surname>Tesfa-Selase</surname><given-names>F</given-names></