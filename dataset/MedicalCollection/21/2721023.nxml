lign="middle" rowspan="1" colspan="1">3.0-s</th><th align="center" valign="middle" rowspan="1" colspan="1">4.5-s</th></tr><tr><th colspan="9" align="left" valign="middle" rowspan="1"><hr/></th></tr></thead><tbody><tr><td align="left" valign="middle" rowspan="1" colspan="1">% Accuracy<hr/></td><td align="center" valign="middle" rowspan="1" colspan="1">48.4 &#x000b1; 8.0</td><td align="center" valign="middle" rowspan="1" colspan="1">67.1 &#x000b1; 3.9<xref ref-type="table-fn" rid="TFN1">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">67.5 &#x000b1; 5.8<xref ref-type="table-fn" rid="TFN1">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">72.9 &#x000b1; 4.9<xref ref-type="table-fn" rid="TFN1">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">53.6 &#x000b1; 6.3</td><td align="center" valign="middle" rowspan="1" colspan="1">73.4 &#x000b1; 3.1<xref ref-type="table-fn" rid="TFN1">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">80.0 &#x000b1; 3.4<xref ref-type="table-fn" rid="TFN1">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">74.1 &#x000b1; 3.4<xref ref-type="table-fn" rid="TFN1">*</xref></td></tr><tr><td align="left" valign="middle" rowspan="1" colspan="1">% Omissions</td><td align="center" valign="middle" rowspan="1" colspan="1">60.0 &#x000b1; 6.2</td><td align="center" valign="middle" rowspan="1" colspan="1">39.1 &#x000b1; 6.5<xref ref-type="table-fn" rid="TFN1">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">20.3 &#x000b1; 5.3<xref ref-type="table-fn" rid="TFN1">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">13.6 &#x000b1; 4.8<xref ref-type="table-fn" rid="TFN1">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">55.2 &#x000b1; 4.4</td><td align="center" valign="middle" rowspan="1" colspan="1">38.2 &#x000b1; 4.6<xref ref-type="table-fn" rid="TFN1">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">25.2 &#x000b1; 5.8<xref ref-type="table-fn" rid="TFN1">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">23.0 &#x000b1; 6.3<xref ref-type="table-fn" rid="TFN1">*</xref></td></tr></tbody></table><table-wrap-foot><p><underline>Note:</underline> There was an ITI duration-dependent effect on both accuracy and omissions whereby accuracy was impaired at the shortest ITI (0.5-s) and omissions were increased at the shortest ITI compared to the longer ITIs, but Sp-cAMPS did not further affect performance at any ITI.</p><fn id="TFN1"><label>*</label><p id="P44"><italic>P</italic>&#x0003c;0.05, within-subjects comparison.</p></fn></table-wrap-foot></table-wrap><table-wrap id="T4" position="float"><label>Table 4</label><caption><p>Effects of Rp-cAMPS on performance on the variable-short inter-trial interval version of the 5CSRTT</p></caption><table frame="box" rules="cols"><thead><tr><th align="left" valign="middle" rowspan="1" colspan="1"/><th colspan="4" align="center" valign="middle" rowspan="1">Vehicle</th><th colspan="4" align="center" valign="middle" rowspan="1">Rp-cAMPS (2.1 nmol/0.5 &#x003bc;l/side)</th></tr><tr><th colspan="9" align="left" valign="middle" rowspan="1"><hr/></th></tr><tr><th align="left" valign="middle" rowspan="1" colspan="1"/><th align="center" valign="middle" rowspan="1" colspan="1">0.5-s</th><th align="center" valign="middle" rowspan="1" colspan="1">1.5-s</th><th align="center" valign="middle" rowspan="1" colspan="1">3.0-s</th><th align="center" valign="middle" rowspan="1" colspan="1">4.5-s</th><th align="center" valign="middle" rowspan="1" colspan="1">0.5-s</th><th align="center" valign="middle" rowspan="1" colspan="1">1.5-s</th><th align="center" valign="middle" rowspan="1" colspan="1">3.0-s</th><th align="center" valign="middle" rowspan="1" colspan="1">4.5-s</th></tr><tr><th colspan="9" align="left" valign="middle" rowspan="1"><hr/></th></tr></thead><tbody><tr><td align="left" valign="middle" rowspan="1" colspan="1">% Accuracy<hr/></td><td align="center" valign="middle" rowspan="1" colspan="1">52.2 &#x000b1; 6.3</td><td align="center" valign="middle" rowspan="1" colspan="1">58.0 &#x000b1; 5.0</td><td align="center" valign="middle" rowspan="1" colspan="1">69.2 &#x000b1; 3.4<xref ref-type="table-fn" rid="TFN2">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">71.8 &#x000b1; 4.6<xref ref-type="table-fn" rid="TFN2">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">56.9 &#x000b1; 3.9</td><td align="center" valign="middle" rowspan="1" colspan="1">57.2 &#x000b1; 3.6</td><td align="center" valign="middle" rowspan="1" colspan="1">70.9 &#x000b1; 3.4<xref ref-type="table-fn" rid="TFN2">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">71.4 &#x000b1; 3.9<xref ref-type="table-fn" rid="TFN2">*</xref></td></tr><tr><td align="left" valign="middle" rowspan="1" colspan="1">% Omissions</td><td align="center" valign="middle" rowspan="1" colspan="1">60.0 &#x000b1; 5.5</td><td align="center" valign="middle" rowspan="1" colspan="1">43.8 &#x000b1; 7.0<xref ref-type="table-fn" rid="TFN2">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">32.6 &#x000b1; 6.4<xref ref-type="table-fn" rid="TFN2">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">17.9 &#x000b1; 4.6<xref ref-type="table-fn" rid="TFN2">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">66.4 &#x000b1; 6.1</td><td align="center" valign="middle" rowspan="1" colspan="1">45.7 &#x000b1; 6.3<xref ref-type="table-fn" rid="TFN2">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">33.8 &#x000b1; 6.3<xref ref-type="table-fn" rid="TFN2">*</xref></td><td align="center" valign="middle" rowspan="1" colspan="1">27.4 &#x000b1; 6.7<xref ref-type="table-fn" rid="TFN2">*</xref></td></tr></tbody></table><table-wrap-foot><p><underline>Note:</underline> There was an ITI duration-dependent effect on both accuracy and omissions whereby accuracy was impaired at the shortest ITI (0.5-s) and omissions were increased at the shortest ITI compared to the longer ITIs, but Rp-cAMPS did not further affect performance at any ITI.</p><fn id="TFN2"><label>*</label><p id="P45"><italic>P</italic>&#x0003c;0.05, within-subjects comparison.</p></fn></table-wrap-foot></table-wrap><table-wrap id="T5" position="float"><label>Table 5</label><caption><p>Effects of repeated drug infusions on baseline performance in the 5CSRTT</p></caption><table frame="box" rules="all"><thead><tr><th align="left" valign="middle" rowspan="1" colspan="1"/><th align="center" valign="middle" rowspan="1" colspan="1">First</th><th align="center" valign="middle" rowspan="1" colspan="1">Last</th></tr></thead><tbody><tr><td align="left" valign="middle" rowspan="1" colspan="1">% Accuracy</td><td align="center" valign="middle" rowspan="1" colspan="1">70.5 &#x000b1; 1.8</td><td align="center" valign="middle" rowspan="1" colspan="1">73.7 &#x000b1; 1.8</td></tr><tr><td align="left" valign="middle" rowspan="1" colspan="1">% Omissions</td><td align="center" valign="middle" rowspan="1" colspan="1">6.4 &#x000b1; 0.9</td><td align="center" valign="middle" rowspan="1" colspan="1">6.8 &#x000b1; 1.0</td></tr></tbody></table><table-wrap-foot><p><underline>Note:</underline> Baseline performance is defined as the training session on the day prior to drug infusions. Performance did not change from the training session prior to the first drug infusion to the training session prior to the last drug infusion.</p></table-wrap-foot></table-wrap><table-wrap id="T6" position="float"><label>Table 6</label><caption><p>Effects of PKA modulation within the dorsal mPFC on performance in the 5CSRTT</p></caption><table frame="box" rules="all"><thead><tr><th align="right" valign="middle" rowspan="1" colspan="1"/><th align="center" valign="middle" rowspan="1" colspan="1">% Accuracy</th><th align="center" valign="middle" rowspan="1" colspa