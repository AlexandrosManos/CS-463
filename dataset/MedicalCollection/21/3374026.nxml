<!DOCTYPE article PUBLIC "-//NLM//DTD JATS (Z39.96) Journal Archiving and Interchange DTD v1.0 20120330//EN" "JATS-archivearticle1.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:mml="http://www.w3.org/1998/Math/MathML" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">BMJ</journal-id><journal-id journal-id-type="iso-abbrev">BMJ</journal-id><journal-id journal-id-type="publisher-id">bmj</journal-id><journal-title-group><journal-title>BMJ : British Medical Journal</journal-title></journal-title-group><issn pub-type="ppub">0959-8138</issn><issn pub-type="epub">1756-1833</issn><publisher><publisher-name>BMJ Publishing Group Ltd.</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">22692650</article-id><article-id pub-id-type="pmc">3374026</article-id><article-id pub-id-type="publisher-id">gent001068</article-id><article-id pub-id-type="doi">10.1136/bmj.e3485</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research</subject></subj-group><subj-group subj-group-type="hwp-journal-coll"><subject>1778</subject><subject>1779</subject></subj-group><subj-group subj-group-type="hw-coll-titles"><subject>Smoking and Tobacco</subject><subject>UK</subject><subject>US</subject><subject>Drugs: Cardiovascular System</subject><subject>Pain (Neurology)</subject><subject>Hypertension</subject><subject>Ischaemic Heart Disease</subject><subject>Radiology</subject><subject>Clinical Diagnostic Tests</subject><subject>Radiology (Diagnostics)</subject><subject>Health Education</subject><subject>Health Promotion</subject><subject>Smoking</subject></subj-group></article-categories><title-group><article-title>Prediction model to estimate presence of coronary artery disease: retrospective pooled analysis of existing cohorts</article-title></title-group><contrib-group><contrib contrib-type="author" corresp="no"><name><surname>Genders</surname><given-names>Tessa S S</given-names></name><role>clinical epidemiologist</role><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Steyerberg</surname><given-names>Ewout W</given-names></name><role>professor of medical decision making</role><xref ref-type="aff" rid="aff3">3</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Hunink</surname><given-names>M G Myriam</given-names></name><role>professor of radiology and clinical epidemiology (Erasmus) and adjunct professor of health decision sciences (Harvard)</role><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff2">2</xref><xref ref-type="aff" rid="aff27">27</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Nieman</surname><given-names>Koen</given-names></name><role>cardiologist, medical coordinator of ICCU, and assistant professor</role><xref ref-type="aff" rid="aff2">2</xref><xref ref-type="aff" rid="aff4">4</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Galema</surname><given-names>Tjebbe W</given-names></name><role>cardiologist</role><xref ref-type="aff" rid="aff4">4</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Mollet</surname><given-names>Nico R</given-names></name><role>staff radiologist</role><xref ref-type="aff" rid="aff2">2</xref><xref ref-type="aff" rid="aff4">4</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>de Feyter</surname><given-names>Pim J</given-names></name><role>professor of non-invasive cardiac imaging</role><xref ref-type="aff" rid="aff2">2</xref><xref ref-type="aff" rid="aff4">4</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Krestin</surname><given-names>Gabriel P</given-names></name><role>professor and chairman of department of radiology</role><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Alkadhi</surname><given-names>Hatem</given-names></name><role>senior radiologist</role><xref ref-type="aff" rid="aff5">5</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Leschka</surname><given-names>Sebastian</given-names></name><role>associate professor, senior staff radiologist, section head of computed tomography, and section head of emergency radiology</role><xref ref-type="aff" rid="aff5">5</xref><xref ref-type="aff" rid="aff12">12</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Desbiolles</surname><given-names>Lotus</given-names></name><role>staff cardiologist</role><xref ref-type="aff" rid="aff5">5</xref><xref ref-type="aff" rid="aff12">12</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Meijs</surname><given-names>Matthijs F L</given-names></name><role>resident in cardiology</role><xref ref-type="aff" rid="aff6">6</xref><xref ref-type="aff" rid="aff7">7</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Cramer</surname><given-names>Maarten J</given-names></name><role>associate professor of cardiology</role><xref ref-type="aff" rid="aff6">6</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Knuuti</surname><given-names>Juhani</given-names></name><role>professor, consultant, and director of centre</role><xref ref-type="aff" rid="aff8">8</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Kajander</surname><given-names>Sami</given-names></name><role>consultant radiologist</role><xref ref-type="aff" rid="aff8">8</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Bogaert</surname><given-names>Jan</given-names></name><role>adjunct chair of department of radiology</role><xref ref-type="aff" rid="aff9">9</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Goetschalckx</surname><given-names>Kaatje</given-names></name><role>cardiologist</role><xref ref-type="aff" rid="aff9">9</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Cademartiri</surname><given-names>Filippo</given-names></name><role>associate professor and head of cardiovascular imaging unit</role><xref ref-type="aff" rid="aff2">2</xref><xref ref-type="aff" rid="aff10">10</xref><xref ref-type="aff" rid="aff11">11</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Maffei</surname><given-names>Erica</given-names></name><role>staff radiologist</role><xref ref-type="aff" rid="aff10">10</xref><xref ref-type="aff" rid="aff11">11</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Martini</surname><given-names>Chiara</given-names></name><role>staff radiologist</role><xref ref-type="aff" rid="aff10">10</xref><xref ref-type="aff" rid="aff11">11</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Seitun</surname><given-names>Sara</given-names></name><role>radiologist</role><xref ref-type="aff" rid="aff10">10</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Aldrovandi</surname><given-names>Annachiara</given-names></name><role>staff cardiologist</role><xref ref-type="aff" rid="aff10">10</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Wildermuth</surname><given-names>Simon</given-names></name><role>professor of radiology and chairman of institute of radiology</role><xref ref-type="aff" rid="aff12">12</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Stinn</surname><given-names>Bj&#x000f6;rn</given-names></name><role>staff radiologist</role><xref ref-type="aff" rid="aff12">12</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Fornaro</surname><given-names>J&#x000fc;rgen</given-names></name><role>staff radiologist</role><xref ref-type="aff" rid="aff12">12</xref></contrib><contrib contrib-type="author" corresp="no"><name><surname>Feuchtner</surname><given-names>Gudrun</given-name