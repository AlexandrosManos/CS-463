mid">10233405</pub-id></mixed-citation></ref><ref id="b9-btt-2-205"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bessler</surname><given-names>M</given-names></name><name><surname>Hillmen</surname><given-names>P</given-names></name><name><surname>Longo</surname><given-names>L</given-names></name><etal/></person-group><year>1994</year><article-title>Genomic organization of the X-linked gene (PIG-A) that is mutated in paroxysmal nocturnal haemoglobinuria and of a related autosomal pseudogene mapped to 12q21</article-title><source>Hum Mol Genet</source><volume>3</volume><fpage>751</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">8081362</pub-id></mixed-citation></ref><ref id="b10-btt-2-205"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Boccuni</surname><given-names>P</given-names></name><name><surname>Del Vecchio</surname><given-names>L</given-names></name><name><surname>Di Noto</surname><given-names>R</given-names></name><etal/></person-group><year>2000</year><article-title>Glycosyl phosphatidylinositol (GPI)-anchored molecules and the pathogenesis of paroxysmal nocturnal hemoglobinuria</article-title><source>Crit Rev Oncol Hematol</source><volume>33</volume><fpage>25</fpage><lpage>43</lpage><pub-id pub-id-type="pmid">10714960</pub-id></mixed-citation></ref><ref id="b11-btt-2-205"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bourantas</surname><given-names>K</given-names></name></person-group><year>1994</year><article-title>High-dose recombinant erythropoietin and low-dose corticosteroids for treatment of anemia in paroxysmal nocturnal hemoglobinuria</article-title><source>Acta Haematol</source><volume>91</volume><fpage>62</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">8023644</pub-id></mixed-citation></ref><ref id="b12-btt-2-205"><mixed-citation publication-type="journal"><person-group person-group-type="