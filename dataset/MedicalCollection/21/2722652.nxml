J Mol Biol</source><year>1981</year><volume>147</volume><fpage>195</fpage><lpage>197</lpage><pub-id pub-id-type="pmid">7265238</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Newberg</surname><given-names>LA</given-names></name></person-group><article-title>Significance of gapped sequence alignments</article-title><source>J Comput Biol</source><year>2008</year><volume>15</volume><fpage>1187</fpage><lpage>1194</lpage><pub-id pub-id-type="pmid">18973434</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eddy</surname><given-names>SR</given-names></name></person-group><article-title>A probabilistic model of local sequence alignment that simplifies statistical significance estimation</article-title><source>PLoS Comput Biol</source><year>2008</year><volume>4</volume><fpage>e1000069</fpage><pub-id pub-id-type="pmid">18516236</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barash</surname><given-names>Y</given-names></name><name><surname>Elidan</surname><given-names>G</given-names></name><name><surname>Kaplan</surname><given-names>T</given-names></name><name><surname>Friedman</surname><given-names>N</given-names></name></person-group><article-title>CIS: Compound importance sampling method for protein-DNA binding site p-value estimation</article-title><source>Bioinformatics</source><year>2005</year><volume>21</volume><fpage>596</fpage><lpage>600</lpage><pub-id pub-id-type="pmid">15454407</pub-id></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Saul</surname><given-names>LK</given-names></name><name><surname>Jordan</surname><given-names>MI</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Tesauro G, Touretzky DS, Leen TK</surname></n