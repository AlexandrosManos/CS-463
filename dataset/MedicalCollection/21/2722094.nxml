><lpage>20281</lpage><pub-id pub-id-type="pmid">1400344</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Polevoda</surname><given-names>B</given-names></name><name><surname>Norbeck</surname><given-names>J</given-names></name><name><surname>Takakura</surname><given-names>H</given-names></name><name><surname>Blomberg</surname><given-names>A</given-names></name><name><surname>Sherman</surname><given-names>F</given-names></name></person-group><article-title>Identification and specificities of N-terminal acetyltransferases from Saccharomyces cerevisiae</article-title><source>EMBO J</source><year>1999</year><volume>18</volume><fpage>6155</fpage><lpage>6168</lpage><pub-id pub-id-type="pmid">10545125</pub-id><pub-id pub-id-type="doi">10.1093/emboj/18.21.6155</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Polevoda</surname><given-names>B</given-names></name><name><surname>Sherman</surname><given-names>F</given-names></name></person-group><article-title>NatC Nalpha-terminal acetyltransferase of yeast contains three subunits, Mak3p, Mak10p, and Mak31p</article-title><source>J Biol Chem</source><year>2001</year><volume>276</volume><fpage>20154</fpage><lpage>20159</lpage><pub-id pub-id-type="pmid">11274203</pub-id><pub-id pub-id-type="doi">10.1074/jbc.M011440200</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Polevoda</surname><given-names>B</given-names></name><name><surname>Cardillo</surname><given-names>TS</given-names></name><name><surname>Doyle</surname><given-names>TC</given-names></name><name><surname>Bedi</surname><given-names>GS</given-names></name><name><surname>Sherman</surname><given-names>F</given-names></name></person-group><article-title>Nat3p and Mdm20p are required for function of yeast NatB Nalpha-terminal acetyltransferas