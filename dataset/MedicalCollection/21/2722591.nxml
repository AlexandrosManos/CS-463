><fpage>799</fpage><lpage>825</lpage><pub-id pub-id-type="pmid">11018145</pub-id><pub-id pub-id-type="doi">10.1146/annurev.micro.54.1.799</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Young</surname><given-names>R</given-names></name></person-group><article-title>Bacteriophage lysis: mechanism and regulation</article-title><source>Microbiol Rev</source><year>1992</year><volume>56</volume><fpage>430</fpage><lpage>481</lpage><pub-id pub-id-type="pmid">1406491</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fischetti</surname><given-names>VA</given-names></name></person-group><article-title>Bacteriophage lytic enzymes: novel anti-infectives</article-title><source>Trends in Microbiol</source><year>2005</year><volume>13</volume><fpage>491</fpage><lpage>496</lpage><pub-id pub-id-type="doi">10.1016/j.tim.2005.08.007</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kikkawa</surname><given-names>H</given-names></name><name><surname>Ueda</surname><given-names>T</given-names></name><name><surname>Suzuki</surname><given-names>S</given-names></name><name><surname>Yasuda</surname><given-names>J</given-names></name></person-group><article-title>Characterization of the catalytic activity of the &#x003b3;-phage lysin, PlyG, specific for <italic>Bacillus anthracis</italic></article-title><source>FEMS Microbiol Lett</source><year>2008</year><volume>286</volume><fpage>236</fpage><lpage>240</lpage><pub-id pub-id-type="pmid">18662316</pub-id><pub-id pub-id-type="doi">10.1111/j.1574-6968.2008.01280.x</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Loessner</surname><given-names>MJ</given-names></name><name><surname>Kramer</surname><given-names>K</given-names></name><nam