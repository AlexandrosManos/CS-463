wspan="1" colspan="1">19</td><td align="left" rowspan="1" colspan="1">5</td><td align="left" rowspan="1" colspan="1">347</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">IAP100, putative, expressed</td><td align="left" rowspan="1" colspan="1">Os10g35030</td><td align="left" rowspan="1" colspan="1">8</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">178</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>3</bold></td><td align="left" rowspan="1" colspan="1"><bold>Lectin protein kinase, putative, expressed</bold></td><td align="left" rowspan="1" colspan="1">Os07g38810</td><td align="left" rowspan="1" colspan="1">26</td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">1158</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Cysteine protease 1 precursor, putative, expressed</td><td align="left" rowspan="1" colspan="1">Os04g57440</td><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">157</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>4</bold></td><td align="left" rowspan="1" colspan="1"><bold>Protein kinase domain containing protein</bold></td><td align="left" rowspan="1" colspan="1">Os01g14510</td><td align="left" rowspan="1" colspan="1">22</td><td align="left" rowspan="1" colspan="1">5</td><td align="left" rowspan="1" colspan="1">375</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Calcium-dependent protein kinase, isoform 1, putative, expressed</td><td align="left" rowspan="1" colspan="1">Os03g03660</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">182</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">IAP100, putative, expressed</td><td align="left" rowspan="1" colspan="1">Os10g35030</td><td align="left" rowspan="1" colspan="1">8</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">159</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Salt stress-induced protein, putative, expressed</td><td align="left" rowspan="1" colspan="1">Os01g24710</td><td align="left" rowspan="1" colspan="1">18</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">120</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>5</bold></td><td align="left" rowspan="1" colspan="1"><bold>Protein kinase APK1B, chloroplast precursor, putative, expressed</bold></td><td align="left" rowspan="1" colspan="1">Os03g06330</td><td align="left" rowspan="1" colspan="1">70</td><td align="left" rowspan="1" colspan="1">11</td><td align="left" rowspan="1" colspan="1">1560</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">DEAD/DEAH box helicase family protein, expressed</td><td align="left" rowspan="1" colspan="1">Os03g61220</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">151</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>6</bold></td><td align="left" rowspan="1" colspan="1"><bold>Serine/threonine-protein kinase RLCKVII</bold></td><td align="left" rowspan="1" colspan="1">Os07g49470</td><td align="left" rowspan="1" colspan="1">30</td><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">594</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">HEAT repeat family protein, karyopherin-beta 3 variant expressed</td><td align="left" rowspan="1" colspan="1">Os07g38760</td><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspa