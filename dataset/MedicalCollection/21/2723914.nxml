" rowspan="1" colspan="1">7</td><td align="left" rowspan="1" colspan="1">819</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Dynamin-related protein 1C, putative, expressed</td><td align="left" rowspan="1" colspan="1">Os03g50520</td><td align="left" rowspan="1" colspan="1">22</td><td align="left" rowspan="1" colspan="1">7</td><td align="left" rowspan="1" colspan="1">584</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Dynamin-related protein 1C, putative, expressed</td><td align="left" rowspan="1" colspan="1">Os10g41820</td><td align="left" rowspan="1" colspan="1">18</td><td align="left" rowspan="1" colspan="1">8</td><td align="left" rowspan="1" colspan="1">498</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">DEAD/DEAH box helicase family protein, expressed</td><td align="left" rowspan="1" colspan="1">Os01g43120</td><td align="left" rowspan="1" colspan="1">16</td><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">386</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">pentatricopeptide, putative, expressed</td><td align="left" rowspan="1" colspan="1">Os03g63910</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">97</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">linker histone H1 and H5 family protein, expressed</td><td align="left" rowspan="1" colspan="1">Os03g58470</td><td align="left" rowspan="1" colspan="1">15</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">154</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">expressed protein</td><td align="left" rowspan="1" colspan="1">Os02g22070</td><td align="left" rowspan="1" colspan