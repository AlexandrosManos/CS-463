e>162</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">10840454</pub-id></element-citation></ref><ref id="CIT17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nicoletta</surname><given-names>JA</given-names></name><name><surname>Lande</surname><given-names>MB</given-names></name></person-group><article-title>Medical evaluation and treatment of urolithiasis</article-title><source>Pediatr Clin North Am</source><year>2006</year><volume>53</volume><fpage>479</fpage><lpage>91</lpage><pub-id pub-id-type="pmid">16716792</pub-id></element-citation></ref><ref id="CIT18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sarica</surname><given-names>K</given-names></name></person-group><article-title>Pediatric urolithiasis: Etiology, specific pathogenesis and medical treatment</article-title><source>Urol Res</source><year>2006</year><volume>34</volume><fpage>96</fpage><lpage>101</lpage><pub-id pub-id-type="pmid">16432692</pub-id></element-citation></ref><ref id="CIT19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Soble</surname><given-names>JJ</given-names></name><name><surname>Hamilton</surname><given-names>BD</given-names></name><name><surname>Streem</surname><given-names>SB</given-names></name></person-group><article-title>Ammonium acid urate calculi: A reevaluation of risk factors</article-title><source>J Urol</source><year>1999</year><volume>161</volume><fpage>869</fpage><lpage>73</lpage><pub-id pub-id-type="pmid">10022703</pub-id></element-citation></ref><ref id="CIT20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kroovand</surname><given-names>RL</given-names></name></person-group><article-title>Pediatric urolithiasis</article-title><source>Urol Clin North Am</source><year>1997</year><volume>24</volume><fpage>173</fpage><lpage>85</lpage><pub-id pub-id-type="pmid">9048860</pub-id></element-citation></ref><ref id="CIT21"><label>21</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Drach</surname><given-names>WG</given-names></name></person-group><article-title>Metabolic evaluation of pediatric patients with stones</article-title><source>Urol Clin North Am</source><year>1995</year><volume>22</volume><fpage>95</fpage><lpage>100</lpage><pub-id pub-id-type="pmid">7855963</pub-id></element-citation></ref></ref-list></back></article>