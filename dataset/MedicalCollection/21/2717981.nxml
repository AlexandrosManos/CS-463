/given-names></name></person-group><article-title>Comparison of some suboptimal control policies in medical drug therapy</article-title><source>Operations Research</source><year>1993</year><fpage>697</fpage><lpage>709</lpage></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cavazos</surname><given-names>R</given-names></name></person-group><article-title>Necessary and sufficient Conditions for a bounded solution to the optimality equation in average reward Markov decisions Chains</article-title><source>Syst control letters</source><year>1988</year><volume>10</volume><fpage>71</fpage><lpage>78</lpage><pub-id pub-id-type="doi">10.1016/0167-6911(88)90043-6</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Anderson</surname><given-names>MQ</given-names></name></person-group><article-title>Monotone optimal Preventive maintenance policies for stochastically failing equipment</article-title><source>Naval Res Log Quarterly</source><year>1981</year><volume>28</volume><fpage>347</fpage><lpage>358</lpage><pub-id pub-id-type="doi">10.1002/nav.3800280301</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>White</surname><given-names>CC</given-names></name></person-group><article-title>Optimal inspection and repair of a production process subject to deterioration</article-title><source>Journal of operation research society</source><year>1978</year><volume>29</volume><fpage>235</fpage><lpage>243</lpage></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goulionis</surname><given-names>JE</given-names></name><name><surname>Benos</surname><given-names>VK</given-names></name></person-group><article-title>Optimal control limit strategies, using the partially observable Markov decision processes</article-title><source>Advances and Applications in Statistics</source><year>2007</year><volume>7</volume><fpage>357</fpage><lpage>388</lpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goulionis</surname><given-names>JE</given-names></name><name><surname>Stengos</surname><given-names>DimitriosI</given-names></name></person-group><article-title>The partially observable Markov decision processes framework in Medical decision Making</article-title><source>Advances and Applications in Statistics</source><year>2008</year><volume>9</volume><fpage>205</fpage><lpage>232</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Astrom</surname><given-names>KJ</given-names></name></person-group><article-title>Optimal control of Markov decision processes with Incomplete State Information</article-title><source>J math, Anal And Appl</source><year>1965</year><volume>10</volume><fpage>174</fpage><lpage>205</lpage><pub-id pub-id-type="doi">10.1016/0022-247X(65)90154-X</pub-id></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bertsekas</surname><given-names>DP</given-names></name></person-group><source>Dynamic Programming and Stochastic Control</source><year>1976</year><publisher-name>Academic Press, New York</publisher-name></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goulionis</surname><given-names>JE</given-names></name></person-group><article-title>Structural properties for a two-state partially observable Markov decision process with an average cost criterion</article-title><source>Journal of Statistics &#x00026; Management Systems</source><year>2007</year><volume>10</volume><fpage>715</fpage><lpage>733</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Valldeoriol</surname><given-names>F</given-names></name><name><surname>Pilleri</surname><given-names>M</given-names></name><name><surname>Tolosa</surname><given-names>E</given-names></name></person-group><article-title>Bilateral, subthalamic stimulation monotherapy in advanced Parkinson's disease: Long-term follow up</article-title><source>Mov Disord </source><year>2002</year><volume>17</volume><fpage>125</fpage><lpage>132</lpage><pub-id pub-id-type="pmid">11835449</pub-id><pub-id pub-id-type="doi">10.1002/mds.1278</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Doshi</surname><given-names>PK</given-names></name><name><surname>Chhaya</surname><given-names>N</given-names></name><name><surname>Bhatt</surname><given-names>MH</given-names></name></person-group><article-title>Depression leading to attempted suicide after bilateral subthalamic nucleus stimulation for Parkinson's disease</article-title><source>Mov Disord</source><year>2002</year><volume>17</volume><fpage>1084</fpage><lpage>1085</lpage><pub-id pub-id-type="pmid">12360564</pub-id><pub-id pub-id-type="doi">10.1002/mds.10198</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ondo</surname><given-names>W</given-names></name><name><surname>Jancovic</surname><given-names>J</given-names></name><name><surname>Schwartzk</surname><given-names/></name></person-group><article-title>Unilateral thalamic deep brain stimulation for refractory essential tremor</article-title><source>Neurology</source><year>1998</year><volume>51</volume><fpage>1063</fpage><lpage>1069</lpage><pub-id pub-id-type="pmid">9781530</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ostergaard</surname><given-names>K</given-names></name><name><surname>Sunde</surname><given-names>N</given-names></name></person-group><article-title>Effects of bilateral stimulation of the Subthalamic nucleus in patients with severe Parkinson's disease and motor fluctuations</article-title><source>Mov Disord</source><year>2002</year><volume>17</volume><fpage>693</fpage><lpage>700</lpage><pub-id pub-id-type="pmid">12210858</pub-id><pub-id pub-id-type="doi">10.1002/mds.10188</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Falkner</surname><given-names>GH</given-names></name></person-group><article-title>Optimal Spares for Stochastically Failing Equipment</article-title><source>Naval research logistics</source><year>1969</year><volume>16</volume><fpage>287</fpage><lpage>295</lpage></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Papadimitriou</surname><given-names>C</given-names></name><name><surname>Tsitsiklis</surname><given-names>J</given-names></name></person-group><article-title>The Complexity of Markov decision processes</article-title><source>Math Operation Research</source><year>1987</year><volume>12</volume><fpage>441</fpage><lpage>450</lpage><pub-id pub-id-type="doi">10.1287/moor.12.3.441</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schapira</surname><given-names>AHV</given-names></name></person-group><article-title>Progress in Parkinson's disease</article-title><source>Neurology</source><year>2003</year><volume>61</volume><fpage>S1</fpage><lpage>S3</lpage><pub-id pub-id-type="pmid">14663000</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kumar</surname><given-names>R</given-names></name><name><surname>Lozano</surname><given-names>AM</given-names></name></person-group><article-title>Double-blind evaluation of subthalamic nucleus deep brain stimulation in advanced Parkinson's disease</article-title><source>Neurology</source><year>1998</year><volume>51</volume><fpage>850</fpage><lpage>855</lpage><pub-id pub-id-type="pmid">9748038</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Limousin</surname><given-names>P</given-names></name><name><surname>Krack</surname><given-names>P</given-names></name><name><surname>Pollak</surname><given-names>P</given-names></name></person-group><article-title>Electrical stimulation of the subthalamic nucleus in advanced Parkinson's disease</article-title><source>N Engl J Med </source><year>1998</year><volume>339</volume><fpage>1105</fpage><lpage>1111</lpage><pub-id pub-id-type="pmid">9770557</pub-id><pub-id pub-id-type="doi">10.1056/NEJM199810153391603</pub-id></citation></ref></ref-list></back></article>