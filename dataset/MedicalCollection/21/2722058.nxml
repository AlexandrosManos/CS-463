xed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ernst</surname><given-names>E</given-names></name><name><surname>Cassileth</surname><given-names>BR</given-names></name></person-group><article-title>The prevalence of complementary/ alternative medicine in cancer. A systematic review</article-title><source>Cancer</source><year>2000</year><volume>83</volume><fpage>777</fpage><lpage>82</lpage><pub-id pub-id-type="pmid">9708945</pub-id></mixed-citation></ref><ref id="b12-co16-4-67"><label>12</label><mixed-citation publication-type="book"><collab>Wikipedia</collab><source>Harpagophytum [Web article]</source><publisher-loc>San Francisco</publisher-loc><publisher-name>Wikimedia Foundation, Inc.</publisher-name><year>2008</year><comment>[Available at: en.wikipedia.org/wiki/Harpagophytum_procumbens; cited October 1, 2008]</comment></mixed-citation></ref><ref id="b13-co16-4-67"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jang</surname><given-names>MH</given-names></name><name><surname>Lim</surname><given-names>S</given-names></name><name><surname>Han</surname><given-names>SM</given-names></name><etal/></person-group><article-title><italic>Harpagophytum procumbens</italic> suppresses lipopolysaccharide-stimulated expressions of cyclooxygenase-2 and inducible nitric oxide synthase in fibroblast cell line L929</article-title><source>J Pharmacol Sci</source><year>2003</year><volume>93</volume><fpage>367</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">14646256</pub-id></mixed-citation></ref><ref id="b14-co16-4-67"><label>14</label><mixed-citation publication-type="book"><collab>United States, National Library of Medicine (nlm) and the National Institutes of Health, MedlinePlus</collab><source>Drugs and Supplements &#x0003e; Devil&#x02019;s Claw [Web article]</source><publisher-loc>Bethesda, MD</publisher-loc><publisher-name>NLM</publisher-name><year>2008</year>