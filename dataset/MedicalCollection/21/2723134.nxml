>D</td><td align="center">786</td><td align="right">20.1</td><td align="center">15.6</td><td align="right">0.03</td><td align="right">95.2</td></tr><tr><td align="left">ln(Androstenone plasma)</td><td align="center">D</td><td align="center">785</td><td align="right">2.70</td><td align="center">0.87</td><td align="right">-3.5</td><td align="right">4.56</td></tr><tr><td align="left">Testosterone (ppm)</td><td align="center">D</td><td align="center">934</td><td align="right">12.9</td><td align="center">9.85</td><td align="right">0.00</td><td align="right">107</td></tr><tr><td align="left">ln(Testosterone)</td><td align="center">D</td><td align="center">933</td><td align="right">2.17</td><td align="center">1.44</td><td align="right">-9.21</td><td align="right">4.67</td></tr><tr><td align="left">Estrone sulphate (ppm)</td><td align="center">D</td><td align="center">934</td><td align="right">28.8</td><td align="center">20.3</td><td align="right">0.00</td><td align="right">148</td></tr><tr><td align="left">ln(Estrone sulphate)</td><td align="center">D</td><td align="center">933</td><td align="right">3.05</td><td align="center">1.01</td><td align="right">-9.21</td><td align="right">5.00</td></tr><tr><td align="left">17&#x003b2;-estradiol (ppm)</td><td align="center">D</td><td align="center">935</td><td align="right">0.24</td><td align="center">0.14</td><td align="right">0.03</td><td align="right">1.10</td></tr><tr><td align="left">ln(17&#x003b2;-estradiol)</td><td align="center">D</td><td align="center">934</td><td align="right">-1.57</td><td align="center">0.52</td><td align="right">-3.61</td><td align="right">0.10</td></tr></tbody></table><table-wrap-foot><p>Mean, standard deviation (SD), minimum (min) and maximum (max) values are presented for all the phenotypes included in the association study. Number of animals (n) used in the SNP analyses for each trait is indicated. For all phenotypes except bulbo urethralis length, the data were ln-transformed to get a normal distr