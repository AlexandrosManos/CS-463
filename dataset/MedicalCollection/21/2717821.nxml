>2006</year><article-title>The matrix metalloproteinase system in oral squamous cell carcinoma</article-title><source>Br J Oral Maxillofac Surg</source><volume>44</volume><fpage>482</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">16338034</pub-id></mixed-citation></ref><ref id="b7-bmi-2007-377"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>botos</surname><given-names>I</given-names></name><name><surname>Scapozza</surname><given-names>L</given-names></name><name><surname>Zhang</surname><given-names>D</given-names></name><name><surname>Liotta</surname><given-names>LA</given-names></name><name><surname>Meyer</surname><given-names>EF</given-names></name></person-group><year>1996</year><article-title>Batimastat, a potent matrix metalloproteinase inhibitor, exhibits an unexpected mode of binding</article-title><source>Proc Natl Acad Sci U S A</source><volume>93</volume><fpage>2749</fpage><lpage>54</lpage><pub-id pub-id-type="pmid">8610113</pub-id></mixed-citation></ref><ref id="b8-bmi-2007-377"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Brodsky</surname><given-names>JT</given-names></name><name><surname>Cohen</surname><given-names>AM</given-names></name></person-group><year>1991</year><article-title>Peritoneal seeding following potentially curative resection of colonic carcinoma: Implication for adjuvant therapy</article-title><source>Dis Colon Rectum</source><volume>34</volume><fpage>723</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">1855433</pub-id></mixed-citation></ref><ref id="b9-bmi-2007-377"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>PD</given-names></name></person-group><year>1997</year><article-title>Matrix metalloproteinase inhibitors</article-title><source>Angiogenesis</source><volume>1</volume><fpage>154</fpage></mixed-citation></ref><ref id="b10-bmi-2007-377"><note