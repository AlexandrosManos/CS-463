 char="plusmn" rowspan="1" colspan="1">29.40 &#x000b1; 1.26</td><td align="char" char="plusmn" rowspan="1" colspan="1">71.65 &#x000b1; 13.78</td><td align="char" char="plusmn" rowspan="1" colspan="1">24.92 &#x000b1; 4.23</td><td align="char" char="plusmn" rowspan="1" colspan="1">169.40 &#x000b1; 6.27</td><td align="char" char="plusmn" rowspan="1" colspan="1">118.14 &#x000b1; 11.13</td><td align="char" char="." rowspan="1" colspan="1">0.42</td></tr><tr><td rowspan="1" colspan="1">&#x02003;CLHNS, Cebu, Philippines (<italic>n</italic>                                    = 973)</td><td align="char" char="." rowspan="1" colspan="1">0.26</td><td align="char" char="plusmn" rowspan="1" colspan="1">3.03 &#x000b1; 0.42</td><td align="char" char="plusmn" rowspan="1" colspan="1">8.27 &#x000b1; 0.99</td><td align="char" char="plusmn" rowspan="1" colspan="1">10.11 &#x000b1; 1.13</td><td align="char" char="plusmn" rowspan="1" colspan="1">13.20 &#x000b1; 1.75</td><td align="char" char="plusmn" rowspan="1" colspan="1">21.27 &#x000b1; 0.78</td><td align="char" char="plusmn" rowspan="1" colspan="1">56.01 &#x000b1; 9.25</td><td align="char" char="plusmn" rowspan="1" colspan="1">21.03 &#x000b1; 3.04</td><td align="char" char="plusmn" rowspan="1" colspan="1">163.03 &#x000b1; 5.87</td><td align="char" char="plusmn" rowspan="1" colspan="1">111.75 &#x000b1; 10.93</td><td align="char" char="." rowspan="1" colspan="1">0.44</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Bt20 cohort, Soweto-Johannesburg, South Africa                                        (<italic>n</italic> = 168)</td><td align="char" char="." rowspan="1" colspan="1">0.16</td><td align="char" char="plusmn" rowspan="1" colspan="1">3.14 &#x000b1; 0.54</td><td align="char" char="plusmn" rowspan="1" colspan="1">9.68 &#x000b1; 1.42</td><td align="char" char="plusmn" rowspan="1" colspan="1">11.64 &#x000b1; 1.71</td><td align="char" char="plusmn" rowspan="1" colspan="1">16.13 &#x000b1; 1.80</td><td align="char" char="plusmn" rowspa