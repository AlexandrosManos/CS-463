</year><volume>2</volume><fpage>121</fpage><lpage>134</lpage><pub-id pub-id-type="doi">10.1093/biomet/2.2.121</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Julious</surname><given-names>SA</given-names></name><name><surname>Mullee</surname><given-names>MA</given-names></name></person-group><article-title>Confounding and Simpson's paradox</article-title><source>BMJ</source><year>1994</year><volume>309</volume><fpage>1480</fpage><lpage>1481</lpage><pub-id pub-id-type="pmid">7804052</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rowell</surname><given-names>DM</given-names></name></person-group><article-title>Evaluation of a urine chemistry analyser</article-title><source>Prof Nurse</source><year>1998</year><volume>13</volume><fpage>533</fpage><lpage>534</lpage><pub-id pub-id-type="pmid">9653296</pub-id></citation></ref><ref id="B28"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Altman</surname><given-names>DG</given-names></name><name><surname>Machin</surname><given-names>D</given-names></name><name><surname>Bryant</surname><given-names>TN</given-names></name><name><surname>Gardner</surname><given-names>TN</given-names></name></person-group><source>Statistics with confidence</source><year>2000</year><edition>2</edition><publisher-name>London: BMJ Publishing</publisher-name></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nicolle</surname><given-names>LE</given-names></name></person-group><article-title>Urinary infections in the elderly: symptomatic of asymptomatic?</article-title><source>Int J Antimicrob Agents</source><year>1999</year><volume>11</volume><fpage>265</fpage><lpage>268</lpage><pub-id pub-id-type="pmid">10394981</pub-id><pub-id pub-id-type="doi">10.1016/S0924-8579(99)00028-X</pub-id></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stamm</surname><given-names>WE</given-names></name><name><surname>Counts</surname><given-names>GW</given-names></name><name><surname>Running</surname><given-names>KR</given-names></name><name><surname>Fihn</surname><given-names>S</given-names></name><name><surname>Turck</surname><given-names>M</given-names></name><name><surname>Holmes</surname><given-names>KK</given-names></name></person-group><article-title>Diagnosis of coliform infection in acutely dysuric women</article-title><source>N Engl J Med</source><year>1982</year><volume>307</volume><fpage>463</fpage><lpage>468</lpage><pub-id pub-id-type="pmid">7099208</pub-id></citation></ref></ref-list></back></article>