e="pmid">17676063</pub-id></mixed-citation></ref><ref id="pgen.1000614-Radonjic1"><label>10</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Radonjic</surname><given-names>M</given-names></name><name><surname>Andrau</surname><given-names>JC</given-names></name><name><surname>Lijnzaad</surname><given-names>P</given-names></name><name><surname>Kemmeren</surname><given-names>P</given-names></name><name><surname>Kockelkorn</surname><given-names>TT</given-names></name><etal/></person-group><year>2005</year><article-title>Genome-wide analyses reveal RNA polymerase II located upstream of genes poised for rapid response upon S. cerevisiae stationary phase exit.</article-title><source>Mol Cell</source><volume>18</volume><fpage>171</fpage><lpage>183</lpage><pub-id pub-id-type="pmid">15837421</pub-id></mixed-citation></ref><ref id="pgen.1000614-Martens1"><label>11</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Martens</surname><given-names>C</given-names></name><name><surname>Krett</surname><given-names>B</given-names></name><name><surname>Laybourn</surname><given-names>PJ</given-names></name></person-group><year>2001</year><article-title>RNA polymerase II and TBP occupy the repressed CYC1 promoter.</article-title><source>Mol Microbiol</source><volume>40</volume><fpage>1009</fpage><lpage>1019</lpage><pub-id pub-id-type="pmid">11401707</pub-id></mixed-citation></ref><ref id="pgen.1000614-Kwapisz1"><label>12</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kwapisz</surname><given-names>M</given-names></name><name><surname>Wery</surname><given-names>M</given-names></name><name><surname>Despres</surname><given-names>D</given-names></name><name><surname>Ghavi-Helm</surname><given-names>Y</given-names></name><name><surname>Soutourina</surname><given-names>J</given-names></name><etal/></person-group><year>2008</ye