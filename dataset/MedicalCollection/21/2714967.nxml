ven-names></name></person-group><year>2002</year><article-title>Generation of different fates from multipotent muscle stem cells.</article-title><source>Development</source><volume>129</volume><fpage>2987</fpage><lpage>2995</lpage><pub-id pub-id-type="pmid">12050145</pub-id></mixed-citation></ref><ref id="pone.0006498-Takahashi1"><label>9</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Takahashi</surname><given-names>K</given-names></name><name><surname>Igura</surname><given-names>K</given-names></name><name><surname>Zhang</surname><given-names>X</given-names></name><name><surname>Mitsuru</surname><given-names>A</given-names></name><name><surname>Takahashi</surname><given-names>TA</given-names></name></person-group><year>2004</year><article-title>Effects of osteogenic induction on mesenchymal cells from fetal and maternal parts of human placenta.</article-title><source>Cell Transplantation</source><volume>13</volume><fpage>337</fpage><lpage>341</lpage><pub-id pub-id-type="pmid">15468675</pub-id></mixed-citation></ref><ref id="pone.0006498-Sarugaser1"><label>10</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sarugaser</surname><given-names>R</given-names></name><name><surname>Lickorish</surname><given-names>D</given-names></name><name><surname>Baksh</surname><given-names>D</given-names></name><name><surname>Hosseini</surname><given-names>MM</given-names></name><name><surname>Davies</surname><given-names>JE</given-names></name></person-group><year>2005</year><article-title>Human umbilical cord perivascular (HUCPV) cells: a source of mesenchymal progenitors.</article-title><source>Stem Cells</source><volume>23</volume><fpage>220</fpage><lpage>229</lpage><pub-id pub-id-type="pmid">15671145</pub-id></mixed-citation></ref><ref id="pone.0006498-Wang1"><label>11</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>HS</given-names></name><name><surname>Hung</surname><given-names>SC</given-names></name><name><surname>Peng</surname><given-names>ST</given-names></name><name><surname>Huang</surname><given-names>CC</given-names></name><name><surname>Wei</surname><given-names>HM</given-names></name><etal/></person-group><year>2004</year><article-title>Mesenchymal stem cells in the Wharton's jelly of the human umbilical cord.</article-title><source>Stem Cells</source><volume>22</volume><fpage>1330</fpage><lpage>1337</lpage><pub-id pub-id-type="pmid">15579650</pub-id></mixed-citation></ref><ref id="pone.0006498-Kim1"><label>12</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>JW</given-names></name><name><surname>Kim</surname><given-names>SY</given-names></name><name><surname>Park</surname><given-names>SY</given-names></name><name><surname>Kim</surname><given-names>YM</given-names></name><name><surname>Kim</surname><given-names>JM</given-names></name><etal/></person-group><year>2004</year><article-title>Mesenchymal progenitor cells in the human umbilical cord.</article-title><source>Annals of Hematology</source><volume>83</volume><fpage>733</fpage><lpage>738</lpage><pub-id pub-id-type="pmid">15372203</pub-id></mixed-citation></ref><ref id="pone.0006498-Sarugaser2"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sarugaser</surname><given-names>R</given-names></name><name><surname>Ennis</surname><given-names>J</given-names></name><name><surname>Stanford</surname><given-names>WL</given-names></name><name><surname>Davies</surname><given-names>JE</given-names></name></person-group><year>2009</year><article-title>Isolation, propagation, and characterization of human umbilical cord perivascular cells (HUCPVCs).</article-title><source>Methods Mol Biol</source><volume>482</volume><fpage>269</fpage><lpage>279</lpa