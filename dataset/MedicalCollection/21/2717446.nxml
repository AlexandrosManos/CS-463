-id-type="pmid">4814394</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bland</surname><given-names>JM</given-names></name><name><surname>Altman</surname><given-names>DG</given-names></name></person-group><article-title>Statistical methods for assessing agreement between two methods of clinical measurement</article-title><source>Lancet</source><year>1986</year><volume>1</volume><fpage>307</fpage><lpage>310</lpage><pub-id pub-id-type="pmid">2868172</pub-id><pub-id pub-id-type="pmid">2868172</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Minamisawa</surname><given-names>H</given-names></name><name><surname>Smith</surname><given-names>ML</given-names></name><name><surname>Siesjo</surname><given-names>BK</given-names></name></person-group><article-title>The effect of mild hyperthermia and hypothermia on brain damage following 5, 10, 15 minutes of forebrain ischemia</article-title><source>Ann Neurol</source><year>1990</year><volume>28</volume><fpage>26</fpage><lpage>33</lpage><pub-id pub-id-type="pmid">2375631</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kilpatrick</surname><given-names>MM</given-names></name><name><surname>Lowry</surname><given-names>DW</given-names></name><name><surname>Firlik</surname><given-names>AD</given-names></name><name><surname>Yonas</surname><given-names>H</given-names></name><name><surname>Marion</surname><given-names>DW</given-names></name></person-group><article-title>Hyperthermia in the neurosurgical intensive care unit</article-title><source>Neurosurgery</source><year>2000</year><volume>47</volume><fpage>850</fpage><lpage>856</lpage><pub-id pub-id-type="pmid">11014424</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>K