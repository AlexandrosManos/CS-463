ticle-title><source>J Oral Maxillofac Surg</source><year>1996</year><volume>54</volume><fpage>1020</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">8765393</pub-id></mixed-citation></ref><ref id="b10-co16-4-71"><label>10</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>KT</given-names></name></person-group><article-title>Hemangiopericytoma of the prostate</article-title><source>J Surg Oncol</source><year>1987</year><volume>35</volume><fpage>42</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">3573772</pub-id></mixed-citation></ref><ref id="b11-co16-4-71"><label>11</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Baumgartner</surname><given-names>G</given-names></name><name><surname>Gaeta</surname><given-names>J</given-names></name><name><surname>Wajsman</surname><given-names>Z</given-names></name><name><surname>Merrin</surname><given-names>C</given-names></name></person-group><article-title>Hemangiopericytoma of the urinary bladder: a case report and review of the literature</article-title><source>J Surg Oncol</source><year>1976</year><volume>8</volume><fpage>281</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">948196</pub-id></mixed-citation></ref><ref id="b12-co16-4-71"><label>12</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Siemens</surname><given-names>DR</given-names></name><name><surname>Nickel</surname><given-names>JC</given-names></name><name><surname>Young</surname><given-names>ID</given-names></name></person-group><article-title>Haemangiopericytoma of the spermatic cord</article-title><source>Br J Urol</source><year>1998</year><volume>81</volume><fpage>329</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">9488086</pub-id></mixed-citation></ref><ref id="b13-co16-4-71"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-typ