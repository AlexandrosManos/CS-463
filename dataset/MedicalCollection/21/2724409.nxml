Press</publisher-name></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Jaspers</surname><given-names>K</given-names></name></person-group><source>General Psychopathology: Volumes 1 and 2</source><year>1997</year><publisher-name>Baltimore, MD: Johns Hopkins University Press</publisher-name><comment>(1959)</comment></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kendler</surname><given-names>KS</given-names></name><name><surname>Karkowski</surname><given-names>LM</given-names></name><name><surname>Walsh</surname><given-names>D</given-names></name></person-group><article-title>The structure of psychosis</article-title><source>Archives of General Psychiatry</source><year>1998</year><volume>55</volume><fpage>492</fpage><lpage>499</lpage><pub-id pub-id-type="pmid">9633666</pub-id><pub-id pub-id-type="doi">10.1001/archpsyc.55.6.492</pub-id></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Ghaemi</surname><given-names>SN</given-names></name></person-group><source>The Concepts of Psychiatry</source><year>2007</year><publisher-name>Baltimore, MD: Johns Hopkins University Press</publisher-name></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Weber</surname><given-names>M</given-names></name></person-group><source>The methodology of the social sciences</source><year>1949</year><publisher-name>Glencoe, IL: Free Press</publisher-name></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pepper</surname><given-names>G</given-names></name></person-group><article-title>A re-examination of the ideal type concept</article-title><source>American Catholic Sociological Review</source><year>1963</year><volume>24</volume><fpage>185</fpage><lpage>201</lpage><pub-id pub-id-type="doi">10.2307/3708236</pub-id></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Makkreel</surname><given-names>R</given-names></name></person-group><source>Dilthey: Philosopher of the Human Studies</source><year>1992</year><publisher-name>Princeton, NJ: Princeton Univ. Press</publisher-name></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wiggins</surname><given-names>O</given-names></name><name><surname>Schwartz</surname><given-names>M</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Sadler J, Wiggins O, Schwartz M</surname></name></person-group><article-title>The limits of psychiatric knowlege and the problem of classification</article-title><source>Philosophical perspectives on psychiatric diagnostic classification</source><year>1994</year><publisher-name>Baltimore, MD: Johns Hopkins University Press</publisher-name><fpage>89</fpage><lpage>103</lpage></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Stahl</surname><given-names>SM</given-names></name></person-group><source>Essential Psychopharmacology</source><year>2005</year><publisher-name>Cambridge UK: Cambridge University Press</publisher-name></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Healy</surname><given-names>D</given-names></name></person-group><source>The Antidepressant Era</source><year>1998</year><publisher-name>Cambridge, MA: Harvard University Press</publisher-name></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van Praag</surname><given-names>HM</given-names></name></person-group><article-title>Nosologomania: a disorder of psychiatry</article-title><source>World J Biol Psychiatry</source><year>2000</year><volume>1</volume><fpage>151</fpage><lpage>158</lpage><pub-id pub-id-type="pmid">12607225</pub-id><pub-id pub-id-type="doi">10.3109/15622970009150584</pub-id></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Ghaemi</surname><given-names>SN</given-names></name><collab>Ed</collab></person-group><source>Polypharmacy in Psychiatry</source><year>2002</year><publisher-name>New York: Marcel Dekker</publisher-name></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hill</surname><given-names>JC</given-names></name><name><surname>Schoener</surname><given-names>EP</given-names></name></person-group><article-title>Age-dependent decline of attention deficit hyperactivity disorder</article-title><source>Am J Psychiatry</source><year>1996</year><volume>153</volume><fpage>1143</fpage><lpage>1146</lpage><pub-id pub-id-type="pmid">8780416</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wilens</surname><given-names>TE</given-names></name><name><surname>Faraone</surname><given-names>SV</given-names></name><name><surname>Biederman</surname><given-names>J</given-names></name></person-group><article-title>Attention-deficit/hyperactivity disorder in adults</article-title><source>Jama</source><year>2004</year><volume>292</volume><fpage>619</fpage><lpage>623</lpage><pub-id pub-id-type="pmid">15292088</pub-id><pub-id pub-id-type="doi">10.1001/jama.292.5.619</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kessler</surname><given-names>RC</given-names></name><name><surname>Adler</surname><given-names>LA</given-names></name><name><surname>Barkley</surname><given-names>R</given-names></name><name><surname>Biederman</surname><given-names>J</given-names></name><name><surname>Conners</surname><given-names>CK</given-names></name><name><surname>Faraone</surname><given-names>SV</given-names></name><name><surname>Greenhill</surname><given-names>LL</given-names></name><name><surname>Jaeger</surname><given-names>S</given-names></name><name><surname>Secnik</surname><given-names>K</given-names></name><name><surname>Spencer</surname><given-names>T</given-names></name><etal></etal></person-group><article-title>Patterns and predictors of attention-deficit/hyperactivity disorder persistence into adulthood: results from the national comorbidity survey replication</article-title><source>Biol Psychiatry</source><year>2005</year><volume>57</volume><fpage>1442</fpage><lpage>1451</lpage><pub-id pub-id-type="pmid">15950019</pub-id><pub-id pub-id-type="doi">10.1016/j.biopsych.2005.04.001</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Robins</surname><given-names>E</given-names></name><name><surname>Guze</surname><given-names>SB</given-names></name></person-group><article-title>Establishment of diagnostic validity in psychiatric illness: its application to schizophrenia</article-title><source>Am J Psychiatry</source><year>1970</year><volume>126</volume><fpage>983</fpage><lpage>987</lpage><pub-id pub-id-type="pmid">5409569</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moynihan</surname><given-names>R</given-names></name><name><surname>Heath</surname><given-names>I</given-names></name><name><surname>Henry</surname><given-names>D</given-names></name></person-group><article-title>Selling sickness: the pharmaceutical industry and disease mongering</article-title><source>Bmj</source><year>2002</year><volume>324</volume><fpage>886</fpage><lpage>891</lpage><pub-id pub-id-type="pmid">11950740</pub-id><pub-id pub-id-type="doi">10.1136/bmj.324.7342.886</pub-id></citation></ref></ref-list></back></article>