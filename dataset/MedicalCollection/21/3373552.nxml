<pub-id pub-id-type="pmid">21768611</pub-id></element-citation></ref><ref id="pone.0038761-Mann1"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mann</surname><given-names>JJ</given-names></name></person-group><year>2003</year><article-title>Neurobiology of suicidal behaviour.</article-title><source>Nature Reviews Neuroscience</source><volume>4</volume><fpage>819</fpage><lpage>828</lpage></element-citation></ref><ref id="pone.0038761-Mann2"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mann</surname><given-names>JJ</given-names></name><name><surname>Arango</surname><given-names>VA</given-names></name><name><surname>Avenevoli</surname><given-names>S</given-names></name><name><surname>Brent</surname><given-names>DA</given-names></name><name><surname>Champagne</surname><given-names>FA</given-names></name><etal/></person-group><year>2009</year><article-title>Candidate endophenotypes for genetic studies of suicidal behavior.</article-title><source>Biological Psychiatry</source><volume>65</volume><fpage>556</fpage><lpage>563</lpage><pub-id pub-id-type="pmid">19201395</pub-id></element-citation></ref><ref id="pone.0038761-Mann3"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mann</surname><given-names>JJ</given-names></name><name><surname>Currier</surname><given-names>DM</given-names></name></person-group><year>2010</year><article-title>Stress, genetics and epigenetic effects on the neurobiology of suicidal behavior and depression.</article-title><source>European Psychiatry</source><volume>25</volume><fpage>268</fpage><lpage>271</lpage><pub-id pub-id-type="pmid">20451357</pub-id></element-citation></ref><ref id="pone.0038761-Asberg1"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Asberg</surna