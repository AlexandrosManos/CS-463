urce><year>2008</year><fpage>1778</fpage></mixed-citation></ref><ref id="b24-aci-2009-001"><label>24.</label><mixed-citation publication-type="webpage"><person-group person-group-type="author"><name><surname>Michael</surname><given-names>R</given-names></name></person-group><ext-link ext-link-type="uri" xlink:href="http://employees.csbsju.edu/mross/research/research.html">http://employees.csbsju.edu/mross/research/research.html</ext-link> In, <year>2005</year></mixed-citation></ref><ref id="b25-aci-2009-001"><label>25.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Tang</surname><given-names>B</given-names></name><name><surname>Wang</surname><given-names>X</given-names></name><name><surname>Jia</surname><given-names>B</given-names></name><etal/></person-group><source>Anal Lett</source><year>2003</year><volume>36</volume><issue>14</issue><fpage>2985</fpage><lpage>2997</lpage></mixed-citation></ref><ref id="b26-aci-2009-001"><label>26.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Aboul-Enein</surname><given-names>HY</given-names></name><name><surname>El-Awady</surname><given-names>MI</given-names></name><name><surname>Heard</surname><given-names>CM</given-names></name></person-group><source>J Pharm Biomed Anal</source><year>2003</year><volume>32</volume><fpage>1055</fpage><lpage>1059</lpage><pub-id pub-id-type="pmid">12899993</pub-id></mixed-citation></ref><ref id="b27-aci-2009-001"><label>27.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Guo</surname><given-names>Z</given-names></name><name><surname>Wang</surname><given-names>H</given-names></name><name><surname>Zhang</surname><given-names>Y</given-names></name></person-group><source>J Pharm Biomed Anal</source><year>2006</year><volume>41</volume><fpage>310</fpage><lpage>314</lpage><pub-id pub-id-type="pmid">16326062</pub-id></mixed-citation></ref><ref id="b28-aci-2009-001"><label>28.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nishi</surname><given-names>H</given-names></name><name><surname>Kuwahara</surname><given-names>Y</given-names></name></person-group><source>J Biochem Biophys Methods</source><year>2001</year><volume>48</volume><fpage>89</fpage><lpage>102</lpage><pub-id pub-id-type="pmid">11356481</pub-id></mixed-citation></ref><ref id="b29-aci-2009-001"><label>29.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gubitz</surname><given-names>G</given-names></name><name><surname>Schmid</surname><given-names>MG</given-names></name></person-group><source>Biopharm Drug Dispos</source><year>2001</year><volume>22</volume><fpage>291</fpage><lpage>336</lpage><pub-id pub-id-type="pmid">11835252</pub-id></mixed-citation></ref><ref id="b30-aci-2009-001"><label>30.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bhushan</surname><given-names>R</given-names></name><name><surname>Gupta</surname><given-names>D</given-names></name></person-group><source>J Biomed Chromatogr</source><year>2004</year><volume>18</volume><fpage>838</fpage><lpage>840</lpage></mixed-citation></ref><ref id="b31-aci-2009-001"><label>31.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Du</surname><given-names>Y</given-names></name><name><surname>Di</surname><given-names>B</given-names></name><name><surname>Chen</surname><given-names>J</given-names></name><name><surname>Zheng</surname><given-names>Z</given-names></name></person-group><source>Se Pu</source><year>2004</year><volume>22</volume><fpage>382</fpage><lpage>385</lpage><pub-id pub-id-type="pmid">15709415</pub-id></mixed-citation></ref><ref id="b32-aci-2009-001"><label>32.</label><mixed-citation publication-type="confproc"><person-group person-group-type="author"><collab>ICH Q2A</collab></person-group><article-title>validation of analytical methods: definitions and terminology</article-title><person-group person-group-type="editor"><collab>IFPMA</collab></person-group><conf-name>International Conference on Harmonisation</conf-name><conf-loc>Geneva</conf-loc><year>1994</year></mixed-citation></ref><ref id="b33-aci-2009-001"><label>33.</label><mixed-citation publication-type="confproc"><person-group person-group-type="author"><collab>ICH Q2B</collab></person-group><article-title>validation of analytical procedure: methodology</article-title><person-group person-group-type="editor"><collab>IFPMA</collab></person-group><conf-name>International Conferences on Harmonisation</conf-name><conf-loc>Geneva</conf-loc><year>1996</year></mixed-citation></ref></ref-list></back><floats-group><fig id="f1-aci-2009-001" position="float"><label>Figure 1.</label><caption><p>Chemical structure of citalopram enantiomers.</p></caption><graphic xlink:href="aci-2009-001f1"/></fig><fig id="f2-aci-2009-001" position="float"><label>Figure 2.</label><caption><p>Fluorescence spectra of 10 &#x003bc;g mL<sup>&#x02212;1</sup> escitalopram oxalate <bold>a</bold>) in methanolic medium <bold>b</bold>) in 5 mM SDS micellar medium <bold>c</bold>) spiked plasma sample (6.6 &#x003bc;g mL<sup>&#x02212;1</sup>) in 5 mM SDS micellar medium <bold>d</bold>) blank plasma sample.</p></caption><graphic xlink:href="aci-2009-001f2"/></fig><fig id="f3-aci-2009-001" position="float"><label>Figure 3.</label><caption><p>Effect of chiral selectors (1 mM) on enantiomeric resolution of racemic citalopram hydrobromide by silica gel TLC (20 &#x003bc;g/spot).</p></caption><graphic xlink:href="aci-2009-001f3"/></fig><fig id="f4-aci-2009-001" position="float"><label>Figure 4.</label><caption><p>Thin layer chromatogram showing resolution of racemic citalopram hydrobromide, 20 &#x003bc;g/spot using different chiral selectors 1 mM, <bold>a</bold>) brucine sulphate, <bold>b</bold>) chondroitin sulfate <bold>c</bold>) heparin sodium, <bold>d</bold>) HP-&#x003b2;-CD; acetonitrile:water (17:3 v/v); solvent front 8 cm, 25 &#x000b1; 2 <sup>&#x000b0;</sup>C, compared with control without chiral selector.</p></caption><graphic xlink:href="aci-2009-001f4"/></fig><fig id="f5-aci-2009-001" position="float"><label>Figure 5.</label><caption><p>Densitometric scanning profile for TLC-chromatogram of different concentrations of escitalopram oxalate, (0.5&#x02013;40 &#x003bc;g/spot) at 240 nm.</p></caption><graphic xlink:href="aci-2009-001f5"/></fig><table-wrap id="t1-aci-2009-001" position="float"><label>Table 1.</label><caption><p>Validation report on the fluorimetric and TLC-densitometric methods for the determination of escitalopram in drug substance.</p></caption><table frame="hsides" rules="groups"><thead><tr><th valign="top" align="left" rowspan="1" colspan="1"><bold>Parameters</bold></th><th valign="top" align="center" rowspan="1" colspan="1"><bold>Fluorimetric method</bold></th><th valign="top" align="center" rowspan="1" colspan="1"><bold>TLC-method</bold></th></tr></thead><tbody><tr><td valign="top" align="left" rowspan="1" colspan="1">Linearity range</td><td valign="top" align="center" rowspan="1" colspan="1">0.125&#x02013;16.250 &#x003bc;g mL<sup>&#x02212;1</sup></td><td valign="top" align="center" rowspan="1" colspan="1">0.50&#x02013;40.00 &#x003bc;g/spot</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Regression equation</td><td valign="top" align="center" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1"/></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Slope</td><td valign="top" align="center" rowspan="1" colspan="1">55.556</td><td valign="top" align="center" rowspan="1" colspan="1">264.240</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">&#x02003;&#x02003;SE of Slope</td><td valign="top" align="center" rowspan="1" colspan="1">0.513</td><td valign="top" align="center" rowspan="1" colspan="1">2.460</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Intercept</td><td valign="top" align="center" rowspan="1" colspan="1">25.466</td><td valign="top" align="center" rowspan="1" colspan="1">195.730</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">&#x02003;&#x02003;SE of Intercept</td><td valign="top" align="center" rowspan="1" colspan="1">5.377</td><td valign="top" align="center" rowspan="1" colspan="1">50.470</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Correlation Coefficient (r)</td><td valign="top" align="center" rowspan="1" colspan="1">0.9998</td><td valign="top" align="center" rowspan="1" colspan="1">0.9997</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">&#x02003;&#x02003;SE of estimation</td><td valign="top" align="center" rowspan="1" colspan="1">8.438</td><td valign="top" align="center" rowspan="1" colspan="1">102.360</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Accuracy</td><td valign="top" align="center" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1"/></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Mean<sup><xref ref-type="table-fn" rid="tfn1-aci-2009-001">a</xref></sup> &#x000b1; RSD%</td><td valign="top" align="center" rowspan="1" colspan="1">99.71 &#x000b1; 1.05</td><td valign="top" align="center" rowspan="1" colspan="1">100.10 &#x000b1; 1.63</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Precision (Mean &#x000b1; RSD%)</td><td valign="top" align="center" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1"/></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Intra-day<sup><xref ref-type="table-fn" rid="tfn2-aci-2009-001">b</xref></sup></td><td valign="top" align="center" rowspan="1" colspan="1">99.40 &#x000b1; 0.41</td><td valign="top" align="center" rowspan="