ame></person-group><article-title>Modeling cellular machinery through biological network comparison</article-title><source>Nat. Biotechno.</source><year>2006</year><volume>24</volume><fpage>427</fpage><lpage>433</lpage></element-citation></ref><ref id="B27"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sing</surname><given-names>T</given-names></name><etal/></person-group><article-title>ROCR: visualizing classifier performance in R</article-title><source>Bioinformatics</source><year>2005</year><volume>21</volume><fpage>3940</fpage><lpage>3941</lpage><pub-id pub-id-type="pmid">16096348</pub-id></element-citation></ref><ref id="B28"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Smyth</surname><given-names>GK</given-names></name></person-group><article-title>Linear models and empirical Bayes methods for assessing differential expression in microarray experiments</article-title><source>Stat. Appl. Genet. Mol. Biol</source><year>2004</year><volume>3</volume><comment>Article 3</comment></element-citation></ref><ref id="B29"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sohler</surname><given-names>F</given-names></name><etal/></person-group><article-title>New methods for joint analysis of biological networks and expression data</article-title><source>Bioinformatics</source><year>2004</year><volume>20</volume><fpage>1517</fpage><lpage>1521</lpage><pub-id pub-id-type="pmid">15231545</pub-id></element-citation></ref><ref id="B30"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Srinivasan</surname><given-names>BS</given-names></name><etal/></person-group><article-title>Current progress in network research: toward reference networks for key model organisms</article-title><source>Brief Bioinform.</source><year>2007</year><volume>8</volume><fpage>318</fpage><lpage>332</lpage><pub-id pub-id-type="pmid">17728341</pub-id></element-citation></ref><ref id="B31"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Therneau</surname><given-names>T</given-names></name><etal/></person-group><article-title>Martingale-based residuals for survival models</article-title><source>Biometrika</source><year>1990</year><volume>77</volume><fpage>147</fpage></element-citation></ref><ref id="B32"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>von Mering</surname><given-names>C</given-names></name><etal/></person-group><article-title>STRING 7&#x02013;recent developments in the integration and prediction of protein interactions</article-title><source>Nucleic Acids Res</source><year>2007</year><volume>35</volume><issue>Database issue</issue><fpage>D358</fpage><lpage>D362</lpage><pub-id pub-id-type="pmid">17098935</pub-id></element-citation></ref><ref id="B33"><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Wasserman</surname><given-names>LA</given-names></name></person-group><source>All of Statistics: A concise course in statistical inference</source><year>2005</year><edition>2nd edn</edition><publisher-loc>New York, USA</publisher-loc><publisher-name>Springer</publisher-name></element-citation></ref></ref-list></back></article>