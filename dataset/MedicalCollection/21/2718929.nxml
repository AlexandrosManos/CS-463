urnal"><person-group person-group-type="author"><name><surname>Robinson</surname><given-names>EJ</given-names></name><name><surname>Mulliken</surname><given-names>BD</given-names></name><name><surname>Bourne</surname><given-names>RB</given-names></name><name><surname>Rorabeck</surname><given-names>CH</given-names></name><name><surname>Alvarez</surname><given-names>C</given-names></name></person-group><article-title>Catastrophic osteolysis in total knee replacement: a report of 17 cases</article-title><source>Clin Orthop</source><year>1995</year><volume>321</volume><fpage>98</fpage><lpage>105</lpage><pub-id pub-id-type="pmid">7497692</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berry</surname><given-names>DJ</given-names></name><name><surname>Wold</surname><given-names>LE</given-names></name><name><surname>Rand</surname><given-names>JA</given-names></name></person-group><article-title>Extensive osteolysis around an aseptic, stable, uncemented total knee replacement</article-title><source>Clin Orthop Relat Res</source><year>1993</year><volume>293</volume><fpage>204</fpage><lpage>207</lpage><pub-id pub-id-type="pmid">8339482</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kane</surname><given-names>KR</given-names></name><name><surname>Deheer</surname><given-names>DH</given-names></name><name><surname>Beebe</surname><given-names>JD</given-names></name><name><surname>Bereza</surname><given-names>R</given-names></name></person-group><article-title>An osteolytic lesion associated with polyethylene debris adjacent to a stable total knee prosthesis</article-title><source>Orthop Rev</source><year>1994</year><volume>23</volume><fpage>332</fpage><lpage>337</lpage><pub-id pub-id-type="pmid">8008443</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name