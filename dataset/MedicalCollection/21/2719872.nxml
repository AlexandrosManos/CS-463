ume>44</volume><fpage>123</fpage><lpage>133</lpage><pub-id pub-id-type="pmid">18295330</pub-id></mixed-citation></ref><ref id="pone.0006607-Wang1"><label>10</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>J</given-names></name><name><surname>Barr</surname><given-names>MM</given-names></name></person-group><year>2005</year><article-title>RNA Interference in Caenorhabditis elegans.</article-title><source>Methods Enzymol</source><volume>392</volume><fpage>36</fpage><lpage>55</lpage><pub-id pub-id-type="pmid">15644174</pub-id></mixed-citation></ref><ref id="pone.0006607-Kamath1"><label>11</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kamath</surname><given-names>RS</given-names></name><name><surname>Ahringer</surname><given-names>J</given-names></name></person-group><year>2003</year><article-title>Genome-wide RNAi screening in Caenorhabditis elegans.</article-title><source>Methods</source><volume>30</volume><fpage>313</fpage><lpage>321</lpage><pub-id pub-id-type="pmid">12828945</pub-id></mixed-citation></ref><ref id="pone.0006607-Timmons1"><label>12</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Timmons</surname><given-names>L</given-names></name><name><surname>Court</surname><given-names>DL</given-names></name><name><surname>Fire</surname><given-names>A</given-names></name></person-group><year>2001</year><article-title>Ingestion of bacterially expressed dsRNAs can produce specific and potent genetic interference in Caenorhabditis elegans.</article-title><source>Gene</source><volume>263</volume><fpage>103</fpage><lpage>112</lpage><pub-id pub-id-type="pmid">11223248</pub-id></mixed-citation></ref><ref id="pone.0006607-Falk1"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Falk</surname><given-names>MJ</g