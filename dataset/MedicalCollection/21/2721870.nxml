n="left" valign="top" rowspan="1">Prediction of 1,562 RTECS compounds with 90% confidence level<hr/></td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;<italic>R</italic><sup>2</sup></td><td align="center" valign="top" rowspan="1" colspan="1">0.42</td><td align="center" valign="top" rowspan="1" colspan="1">0.62</td><td align="center" valign="top" rowspan="1" colspan="1">0.19</td><td align="center" valign="top" rowspan="1" colspan="1">0.26</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;MAE</td><td align="center" valign="top" rowspan="1" colspan="1">0.60</td><td align="center" valign="top" rowspan="1" colspan="1">0.42</td><td align="center" valign="top" rowspan="1" colspan="1">0.84</td><td align="center" valign="top" rowspan="1" colspan="1">0.66</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;Coverage (%)</td><td align="center" valign="top" rowspan="1" colspan="1">12</td><td align="center" valign="top" rowspan="1" colspan="1">6</td><td align="center" valign="top" rowspan="1" colspan="1">12</td><td align="center" valign="top" rowspan="1" colspan="1">6</td></tr></tbody></table></table-wrap></floats-group></article>