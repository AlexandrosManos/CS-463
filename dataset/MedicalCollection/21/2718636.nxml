-name><fpage>381</fpage><lpage>424</lpage></element-citation></ref><ref id="B25"><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Mayr</surname><given-names>E</given-names></name></person-group><source>Systematics and the Origin of Species</source><year>1942</year><publisher-loc>Irvington/NY, USA</publisher-loc><publisher-name>Columbia University Press</publisher-name></element-citation></ref><ref id="B26"><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Mayr</surname><given-names>E</given-names></name></person-group><source>Principles of Systematic Zoology</source><year>1969</year><publisher-loc>New York</publisher-loc><publisher-name>McGraw&#x02013;Hill</publisher-name></element-citation></ref><ref id="B27"><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Ohta</surname><given-names>T</given-names></name><etal/></person-group><article-title>GENIA Corpus: an annotated research abstract corpus in molecular biology domain.</article-title><source>Proceedings of the Human Language Technology Conference (HLT 2002)</source><year>2002</year><fpage>73</fpage><lpage>77</lpage></element-citation></ref><ref id="B28"><element-citation publication-type="other"><person-group person-group-type="author"><name><surname>Quine</surname><given-names>O</given-names></name></person-group><year>1948</year><comment>On what there is. Review of metaphysics. In From a Logical Point of View, Harper &#x00026; Row, New York</comment></element-citation></ref><ref id="B29"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rector</surname><given-names>A</given-names></name><etal/></person-group><article-title>Granularity, scale and collectivity: when size does and does not matter</article-title><source>J. Biomed. Informatics</source><year>2006</year><volume>39</volume><fpage>333</fpage><lpage>349</lpage></element-citation></ref><ref id="B30"><element-citation publication-type="web"><person-group person-group-type="author"><name><surname>Rector</surname><given-names>A</given-names></name><etal/></person-group><article-title>Simple Bio Upper Ontology</article-title><year>2007</year><date-in-citation>last accessed date January 15, 2008</date-in-citation><comment>[<ext-link ext-link-type="uri" xlink:href="http://www.cs.man.ac.uk/~rector/ontologies/simple-top-bio">http://www.cs.man.ac.uk/~rector/ontologies/simple-top-bio</ext-link>]</comment></element-citation></ref><ref id="B31"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rubin</surname><given-names>D</given-names></name><etal/></person-group><article-title>Biomedical ontologies: a functional perspective</article-title><source>Brief. Bioinform.</source><year>2008</year><volume>9</volume><fpage>75</fpage><lpage>90</lpage></element-citation></ref><ref id="B32"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Schulz</surname><given-names>S</given-names></name><etal/></person-group><article-title>Biomedical ontologies: what part-of is and isn't</article-title><source>J. Biomed. Inform</source><year>2006a</year><volume>39</volume><fpage>350</fpage><lpage>361</lpage><pub-id pub-id-type="pmid">16442850</pub-id></element-citation></ref><ref id="B33"><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Schulz</surname><given-names>S</given-names></name><etal/></person-group><year>2006b</year><publisher-loc>Baltimore, USA</publisher-loc><fpage>103</fpage><lpage>114</lpage><comment><italic>From GENIA to BioTop &#x02013; Towards a Top &#x02013; level Ontology for Biology. The 4th International Conference on Formal Ontology in Information Systems (FOIS 2006)</italic></comment></element-citation></ref><ref id="B34"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Schulz</surname><given-names>S</given-names></name><name><surname>Hahn</surname><given-names>U</given-names></name></person-group><article-title>. Towards the ontological foundations of symbolic biological theories</article-title><source>Artif. Intell. Med</source><year>2007</year><volume>39</volume><fpage>237</fpage><lpage>250</lpage><pub-id pub-id-type="pmid">17321118</pub-id></element-citation></ref><ref id="B35"><element-citation publication-type="other"><person-group person-group-type="author"><name><surname>Schulz</surname><given-names>S</given-names></name><name><surname>Johansson</surname><given-names>I</given-names></name></person-group><article-title>Continua in biological systems</article-title><year>2007</year><comment>The Monist, 90:4 October 2007</comment></element-citation></ref><ref id="B36"><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Simpson</surname><given-names>GG</given-names></name></person-group><article-title>Principles of Animal Taxonomy</article-title><year>1961</year><publisher-loc>Irvington/NY, USA</publisher-loc><publisher-name>Columbia University Press</publisher-name></element-citation></ref><ref id="B37"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>B</given-names></name><etal/></person-group><article-title>Relations in biomedical ontologies.</article-title><source>Genome Biol</source><year>2005</year><volume>6</volume><fpage>R46</fpage></element-citation></ref><ref id="B38"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>B</given-names></name><etal/></person-group><article-title>The OBO foundry: coordinated evolution of ontologies to support biomedical data integration</article-title><source>Nat. Biotechnol</source><year>2007</year><volume>25</volume><fpage>1251</fpage><lpage>1255</lpage><pub-id pub-id-type="pmid">17989687</pub-id></element-citation></ref><ref id="B39"><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Stenzhorn</surname><given-names>H</given-names></name><etal/></person-group><person-group person-group-type="editor"><name><surname>Kuhn</surname><given-names>KA</given-names></name><etal/></person-group><article-title>Towards a top &#x02013; domain ontology for linking biomedical ontologies. In:</article-title><source>MEDINFO 2007 &#x02013; Proceedings of the 12th World Congress on Health (Medical) Informatics &#x02013; Building Sustainable Health Systems</source><year>2007</year><publisher-loc>Amsterdam</publisher-loc><publisher-name>IOS Press</publisher-name><fpage>1225</fpage><lpage>1229</lpage></element-citation></ref><ref id="B40"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wheeler</surname><given-names>DL</given-names></name><etal/></person-group><article-title>Database resources of the national center for biotechnology information</article-title><source>Nucleic Acids Res</source><year>2008</year><volume>36</volume><fpage>D13</fpage><lpage>D21</lpage><pub-id pub-id-type="pmid">18045790</pub-id></element-citation></ref></ref-list></back></article>