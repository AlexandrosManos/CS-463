roup-type="author"><name><surname>Wallis</surname><given-names>DE</given-names></name><name><surname>Workman</surname><given-names>DL</given-names></name><name><surname>Lewis</surname><given-names>BE</given-names></name><etal/></person-group><year>1999</year><article-title>Failure of early heparin cessation as treatment for heparin-induced thrombocytopenia</article-title><source>Am J Med</source><volume>106</volume><fpage>629</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">10378620</pub-id></mixed-citation></ref><ref id="b81-btt-2-481"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Warkentin</surname><given-names>TE</given-names></name></person-group><year>2003</year><article-title>Management of heparin-induced thrombocytopenia:a critical comparison of lepirudin and argatroban</article-title><source>Thromb Res</source><volume>110</volume><fpage>73</fpage><lpage>82</lpage><pub-id pub-id-type="pmid">12893020</pub-id></mixed-citation></ref><ref id="b82-btt-2-481"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Warkentin</surname><given-names>TE</given-names></name></person-group><year>2004</year><article-title>An overview of the heparin-induced thrombocytopenia syndrome</article-title><source>Semin Thromb Hemost</source><volume>30</volume><fpage>273</fpage><lpage>83</lpage><pub-id pub-id-type="pmid">15282649</pub-id></mixed-citation></ref><ref id="b83-btt-2-481"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Warkentin</surname><given-names>TE</given-names></name><name><surname>Heddle</surname><given-names>NM</given-names></name></person-group><year>2003</year><article-title>Laboratory diagnosis of immune heparin-induced thrombocytopenia</article-title><source>Curr Hematol Rep</source><volume>2</volume><fpage>148</fpage><lpage>57</lpage><pub-id pub-id-type="pmid">12901146</pub-id></mixed-citation></ref><ref id="b84-btt-2-481"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Warkentin</surname><given-names>TE</given-names></name><name><surname>Levine</surname><given-names>MN</given-names></name><name><surname>Hirsh</surname><given-names>J</given-names></name><etal/></person-group><year>1995</year><article-title>Heparin-induced thrombocytopenia in patients treated with low-molecular-weight heparin or unfractionated heparin</article-title><source>N Engl J Med</source><volume>332</volume><fpage>1330</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">7715641</pub-id></mixed-citation></ref><ref id="b85-btt-2-481"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Weitz</surname><given-names>JI</given-names></name><name><surname>Hudoba</surname><given-names>M</given-names></name><name><surname>Massel</surname><given-names>D</given-names></name><etal/></person-group><year>1990</year><article-title>Clot-bound thrombin is protected from inhibition by heparin-antithrombin III but is susceptible to inactivation by antithrombin III-independent inhibitors</article-title><source>J Clin Invest</source><volume>86</volume><fpage>385</fpage><lpage>91</lpage><pub-id pub-id-type="pmid">2384594</pub-id></mixed-citation></ref><ref id="b86-btt-2-481"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Yamamoto</surname><given-names>S</given-names></name><name><surname>Koide</surname><given-names>M</given-names></name><name><surname>Matsuo</surname><given-names>M</given-names></name><etal/></person-group><year>1996</year><article-title>Heparin-induced thrombocytopenia in hemodialysis patients</article-title><source>Am J Kidney Dis</source><volume>28</volume><fpage>82</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">8712226</pub-id></mixed-citation></ref></ref-list></back><floats-group><fig id="f1-btt-2-481" position="float"><label>Figure 1</label><caption><p>Effect of lepirudin on thrombin generation. The lag time increases and the area under the thrombin generation curve becomes smaller with increasing dose of lepirudin. The thrombin generation assay was conducted in vitro after spiking platelet-rich plasma from healthy donors with lepirudin. Platelet count was adjusted at 200 &#x000d7; 10<sup>9</sup>/mL.</p></caption><graphic xlink:href="btt-2-481f1"/></fig><table-wrap id="t1-btt-2-481" position="float"><label>Table 1</label><caption><p>Meta-analysis of the risk of heparin-induced thrombocytopenia (HIT) during thrombosis prophylaxis with low-molecular-weight heparin (LMWH) versus unfractionated heparin (UFH) (after <xref ref-type="bibr" rid="b54-btt-2-481">Martel et al 2005</xref>)</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1"/><th align="left" rowspan="1" colspan="1">HIT</th><th align="left" rowspan="1" colspan="1">Thrombocytopenia</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">LMWH</td><td align="left" rowspan="1" colspan="1">1/1255 (0.1%)</td><td align="left" rowspan="1" colspan="1">152/3758 (4.0%)</td></tr><tr><td align="left" rowspan="1" colspan="1">UFH</td><td align="left" rowspan="1" colspan="1">31/1223 (2.5%)</td><td align="left" rowspan="1" colspan="1">238/3529 (6.7%)</td></tr><tr><td align="left" rowspan="1" colspan="1">Odds ratio</td><td align="left" rowspan="1" colspan="1">0.1 (0.03&#x02013;0.33)</td><td align="left" rowspan="1" colspan="1">0.47 (0.22&#x02013;1.02)</td></tr></tbody></table></table-wrap><table-wrap id="t2-btt-2-481" position="float"><label>Table 2</label><caption><p>Dosing recommendation for lepirudin use (intravenous administration) for heparin-induced thrombocytopenia (HIT)</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1">Clinical condition</th><th align="left" rowspan="1" colspan="1">Bolus dose (mg/kg body weight)</th><th align="left" rowspan="1" colspan="1">Maintenance dose</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">HIT with thrombosis</td><td align="left" rowspan="1" colspan="1">0.40</td><td align="left" rowspan="1" colspan="1">0.15 mg/kg/h</td></tr><tr><td align="left" rowspan="1" colspan="1">HIT without thrombosis</td><td align="left" rowspan="1" colspan="1">none</td><td align="left" rowspan="1" colspan="1">0.10 mg/kg/h</td></tr><tr><td align="left" rowspan="1" colspan="1">HIT with thrombosis and concomitant thrombolysis</td><td align="left" rowspan="1" colspan="1">0.20</td><td align="left" rowspan="1" colspan="1">0.10 mg/kg/h</td></tr><tr><td align="left" rowspan="1" colspan="1">thrombosis prophylaxis in patients with history of HIT</td><td align="left" rowspan="1" colspan="1">none</td><td align="left" rowspan="1" colspan="1">0.10 mg/kg/h</td></tr><tr><td align="left" rowspan="1" colspan="1">intermittent hemodialysis</td><td align="left" rowspan="1" colspan="1">0.08&#x02013;0.10 predialysis</td><td align="left" rowspan="1" colspan="1">none</td></tr><tr><td align="left" rowspan="1" colspan="1">Continuous veno-venous hemofiltration</td><td align="left" rowspan="1" colspan="1">none</td><td align="left" rowspan="1" colspan="1">0.005 mg/kg/h</td></tr><tr><td align="left" rowspan="1" colspan="1">cardiac bypass surgery</td><td align="left" rowspan="1" colspan="1">0.25 and 0.20 in the priming fluid of the heart-lung machine</td><td align="left" rowspan="1" colspan="1">adjusted based on ECT</td></tr></tbody></table><table-wrap-foot><fn id="tfn1-btt-2-481"><p>Except in cardiac surgery, treatment is generally monitored using aPTT, with a target aPTT ratio of 1.5&#x02013;2.5. In cardiac surgery, anticoagulant monitoring is carried out using ecarin clotting time (ECT), which should be &#x0003e;2.5 &#x003bc;g/mL before and 3.5&#x02013;4.5 &#x003bc;g/mL during the cardiopulmonary bypass.</p></fn><fn id="tfn2-btt-2-481"><p>Dose regimens are taken from the Heparin-Associated Thrombocytopenia (HAT) trials (<xref ref-type="bibr" rid="b24-btt-2-481">Greinacher et al 1999a</xref>, <xref ref-type="bibr" rid="b27-btt-2-481">b</xref>; <xref ref-type="bibr" rid="b50-btt-2-481">Lubenow et al 2005</xref>).</p></fn></table-wrap-foot></table-wrap><table-wrap id="t3-btt-2-481" position="float"><label>Table 3</label><caption><p>Clinical results of treatment of heparin-induced thrombocytopenia (HIT) with lepirudin (after <xref ref-type="bibr" rid="b50-btt-2-481">Lubenow et al 2005</xref>)</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1">Clinical condition</th><th align="left" rowspan="1" colspan="1">Before treatment</th><th align="left" rowspan="1" colspan="1">During treatment</th><th align="left" rowspan="1" colspan="1">After treatment</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">death</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">4.4%</td><td align="left" rowspan="1" colspan="1">10.2%</td></tr><tr><td align="left" rowspan="1" colspan="1">limb amputation</td><td align="left" rowspan="1" colspan="1">1.0%</td><td align="left" rowspan="1" colspan="1">4.9%</td><td align="left" rowspan="1" colspan="1">0</td></tr><tr><td align="left" rowspan="1" colspan="1">new thromboembolic event</td><td align="left" rowspan="1" colspan="1">8.3%</td><td align="left" rowspan="1" colspan="1">4.4%</td><td align="left" rowspan="1" colspan="1">1.0%</td></tr><tr><td align="left" rowspan="1" colspan="1">combination of events</td><td align="left" rowspan="1" colspan="1">8.8%</td><td align="left" rowspan="1" colspan="1">11.2%</td><td align="left" rowspan="1" colspan="1">9.8%</td></tr><tr><td align="left" rowspan="1" colspan="1">major bleeding</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">19.5%</td><td align="left" rowspan="1" colspan="1">0</td></tr></tbody></table></table-wrap></floats-group></article>