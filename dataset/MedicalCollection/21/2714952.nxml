year><publisher-loc>Paris, France</publisher-loc><publisher-name>Organisation for Economic Cooperation and Development</publisher-name></element-citation></ref><ref id="bib12"><label>12.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Schoen</surname><given-names>C</given-names></name><name><surname>Osborn</surname><given-names>R</given-names></name><name><surname>Doty</surname><given-names>MM</given-names></name><etal/></person-group><article-title>Toward higher-performance health systems: adults&#x02019; health care experiences in seven countries, 2007</article-title><source>Health Aff (Millwood)</source><year>2007</year><volume>26</volume><issue>6</issue><fpage>w717</fpage><lpage>w734</lpage><pub-id pub-id-type="pmid">17978360</pub-id></element-citation></ref><ref id="bib13"><label>13.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hennessy</surname><given-names>CH</given-names></name><name><surname>Moriarty</surname><given-names>DG</given-names></name><name><surname>Zack</surname><given-names>MM</given-names></name><etal/></person-group><article-title>Measuring health-related quality of life for public health surveillance</article-title><source>Public Health Rep</source><year>1994</year><volume>109</volume><issue>5</issue><fpage>665</fpage><lpage>672</lpage><pub-id pub-id-type="pmid">7938388</pub-id></element-citation></ref><ref id="bib14"><label>14.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Andresen</surname><given-names>EM</given-names></name><name><surname>Catlin</surname><given-names>TK</given-names></name><name><surname>Wyrwich</surname><given-names>KW</given-names></name><etal/></person-group><article-title>Retest reliability of surveillance questions on health related quality of life</article-title><source>J Epidemiol Community Health</source><year>2003</year><volume>57</volume><issue>5</issue><fpage>339</fpage><lpage>343</lpage><pub-id pub-id-type="pmid">12700216</pub-id></element-citation></ref><ref id="bib15"><label>15.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Moriarty</surname><given-names>DG</given-names></name><name><surname>Zack</surname><given-names>MM</given-names></name><name><surname>Kobau</surname><given-names>R</given-names></name></person-group><article-title>The Centers for Disease Control and Prevention's healthy days measures&#x02014;population tracking of perceived physical and mental health over time</article-title><source>Health Qual Life Outcomes</source><year>2003</year><volume>1</volume><issue>1</issue><fpage>37</fpage><pub-id pub-id-type="pmid">14498988</pub-id></element-citation></ref><ref id="bib16"><label>16.</label><element-citation publication-type="book"><source>Health Interview Surveys: Towards International Harmonization of Methods and Instruments (WHO Regional Publications, European Series, No. 58)</source><year>1996</year><publisher-loc>Copenhagen, Denmark</publisher-loc><publisher-name>World Health Organization Regional Office for Europe</publisher-name></element-citation></ref><ref id="bib17"><label>17.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Power</surname><given-names>C</given-names></name><name><surname>Matthews</surname><given-names>S</given-names></name><name><surname>Manor</surname><given-names>O</given-names></name></person-group><article-title>Inequalities in self rated health in the 1958 birth cohort: lifetime social circumstances or social mobility?</article-title><source>BMJ</source><year>1996</year><volume>313</volume><issue>7055</issue><fpage>449</fpage><lpage>453</lpage><pub-id pub-id-type="pmid">8776310</pub-id></element-citation></ref><ref id="bib18"><label>18.</label><element-citation publication-type="journal"><person-group person-group-type="auth