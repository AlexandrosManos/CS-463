ame><surname>Litt</surname><given-names>MD</given-names></name><name><surname>West</surname><given-names>AG</given-names></name><name><surname>Gaszner</surname><given-names>M</given-names></name><name><surname>Felsenfeld</surname><given-names>G</given-names></name></person-group><article-title>Position-effect protection and enhancer blocking by the chicken beta-globin insulator are separable activities</article-title><source>Proc. Natl Acad. Sci. USA</source><year>2002</year><volume>99</volume><fpage>6883</fpage><lpage>6888</lpage><pub-id pub-id-type="pmid">12011446</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>West</surname><given-names>AG</given-names></name><name><surname>Huang</surname><given-names>S</given-names></name><name><surname>Gaszner</surname><given-names>M</given-names></name><name><surname>Litt</surname><given-names>MD</given-names></name><name><surname>Felsenfeld</surname><given-names>G</given-names></name></person-group><article-title>Recruitment of histone modifications by USF proteins at a vertebrate barrier element</article-title><source>Mol. Cell</source><year>2004</year><volume>16</volume><fpage>453</fpage><lpage>463</lpage><pub-id pub-id-type="pmid">15525517</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Geyer</surname><given-names>PK</given-names></name><name><surname>Corces</surname><given-names>VG</given-names></name></person-group><article-title>DNA position-specific repression of transcription by a Drosophila zinc finger protein</article-title><source>Genes Dev</source><year>1992</year><volume>6</volume><fpage>1865</fpage><lpage>1873</lpage><pub-id pub-id-type="pmid">1327958</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-gro