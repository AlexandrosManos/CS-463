7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Honore</surname><given-names>P</given-names></name><name><surname>Hantson</surname><given-names>P</given-names></name><name><surname>Fauville</surname><given-names>JP</given-names></name><name><surname>Peeters</surname><given-names>A</given-names></name><name><surname>Mahieu</surname><given-names>P</given-names></name></person-group><article-title>Paraquat poisoning</article-title><source><italic>Acta Clinica Belgica</italic></source><year>1994</year><volume>49</volume><issue>5</issue><fpage>220</fpage><lpage>228</lpage><pub-id pub-id-type="pmid">7992566</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Proudfoot</surname><given-names>AT</given-names></name><name><surname>Prescott</surname><given-names>LF</given-names></name><name><surname>Jarvie</surname><given-names>DR</given-names></name></person-group><article-title>Haemodialysis for paraquat poisoning</article-title><source><italic>Human Toxicology</italic></source><year>1987</year><volume>6</volume><issue>1</issue><fpage>69</fpage><lpage>74</lpage><pub-id pub-id-type="pmid">3817831</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Suntres</surname><given-names>ZE</given-names></name></person-group><article-title>Role of antioxidants in paraquat toxicity</article-title><source><italic>Toxicology</italic></source><year>2002</year><volume>180</volume><issue>1</issue><fpage>65</fpage><lpage>77</lpage><pub-id pub-id-type="pmid">12324200</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>C</given-names></name><name><surname>Browder</surname><given-na