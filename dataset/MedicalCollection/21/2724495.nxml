gree</td><td align="center">concordance</td></tr><tr><td align="left">B</td><td align="left">SR140</td><td align="center">144</td><td align="center">243</td><td align="center">0.6</td><td align="center">1.7</td><td align="center">0.0089</td><td align="center">13</td><td align="center">64</td><td align="center"><bold>0.2</bold></td><td align="center"><bold>5.0</bold></td><td align="center"><italic>&#x0003c;0.0001</italic></td><td align="center">disagree</td><td align="center">concordance</td></tr><tr><td align="left">D</td><td align="left">BRAF</td><td align="center">27</td><td align="center">46</td><td align="center">0.6</td><td align="center">1.7</td><td align="center">0.0089</td><td align="center">22</td><td align="center">47</td><td align="center"><bold>0.5</bold></td><td align="center"><bold>2.1</bold></td><td align="center"><italic>&#x0003c;0.0001</italic></td><td align="center">disagree</td><td align="center">concordance</td></tr><tr><td align="left">C</td><td align="left">ZNF74</td><td align="center">12</td><td align="center">21</td><td align="center">0.6</td><td align="center">1.8</td><td align="center">0.0042</td><td align="center">16</td><td align="center">44</td><td align="center"><bold>0.4</bold></td><td align="center"><bold>2.8</bold></td><td align="center"><italic>0.0002</italic></td><td align="center">disagree</td><td align="center">concordance</td></tr><tr><td align="left">B</td><td align="left">TOMM70A</td><td align="center">212</td><td align="center">383</td><td align="center">0.6</td><td align="center">1.8</td><td align="center"><italic>0.0004</italic></td><td align="center">115</td><td align="center">306</td><td align="center"><bold>0.4</bold></td><td align="center"><bold>2.7</bold></td><td align="center"><italic>&#x0003c;0.0001</italic></td><td align="center">agree</td><td align="center">concordance</td></tr><tr><td align="left">B</td><td align="left">RPL24</td><td align="center">1895</td><td align="center">3503</td><td align="center"><bold>0.5<