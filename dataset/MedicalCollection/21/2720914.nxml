><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coimbra</surname><given-names>LC</given-names></name><name><surname>Silva</surname><given-names>AA</given-names></name><name><surname>Mochel</surname><given-names>EG</given-names></name><name><surname>Alves</surname><given-names>MT</given-names></name><name><surname>Ribeiro</surname><given-names>VS</given-names></name><name><surname>Aragao</surname><given-names>VM</given-names></name><name><surname>Bettiol</surname><given-names>H</given-names></name></person-group><article-title>[Factors associated with inadequacy of prenatal care utilization]</article-title><source>Rev Sa&#x000fa;de P&#x000fa;blica</source><year>2003</year><volume>37</volume><fpage>456</fpage><lpage>462</lpage><pub-id pub-id-type="doi">10.1590/S0034-89102003000400010</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Villar</surname><given-names>J</given-names></name><name><surname>Ba'aqeel</surname><given-names>H</given-names></name><name><surname>Piaggio</surname><given-names>G</given-names></name><name><surname>Lumbiganon</surname><given-names>P</given-names></name><name><surname>Miguel Belizan</surname><given-names>J</given-names></name><name><surname>Farnot</surname><given-names>U</given-names></name><name><surname>Al-Mazrou</surname><given-names>Y</given-names></name><name><surname>Carroli</surname><given-names>G</given-names></name><name><surname>Pinol</surname><given-names>A</given-names></name><name><surname>Donner</surname><given-names>A</given-names></name><etal></etal></person-group><article-title>WHO antenatal care randomised trial for the evaluation of a new model of routine antenatal care</article-title><source>Lancet</source><year>2001</year><volume>357</volume><fpage>1551</fpage><lpage>1564</lpage><pub-id pub-id-type="pmid">11377642</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(00)04722-X</pub-id></citation><