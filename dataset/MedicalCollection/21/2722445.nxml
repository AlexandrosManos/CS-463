e>82</volume><fpage>730</fpage><lpage>737</lpage><pub-id pub-id-type="pmid">16297909</pub-id></citation></ref><ref id="R37"><label>37</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Piatigorsky</surname><given-names>J</given-names></name></person-group><article-title>Lens differentiation in vertebrates. A review of cellular and molecular features</article-title><source>Differentiation</source><year>1981</year><volume>19</volume><fpage>134</fpage><lpage>153</lpage><pub-id pub-id-type="pmid">7030840</pub-id></citation></ref><ref id="R38"><label>38</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bassnett</surname><given-names>S</given-names></name><name><surname>McNulty</surname><given-names>R</given-names></name></person-group><article-title>The effect of elevated intraocular oxygen on organelle degradation in the embryonic chicken lens</article-title><source>J Exp Biol</source><year>2003</year><volume>206</volume><fpage>4353</fpage><lpage>4361</lpage><pub-id pub-id-type="pmid">14581604</pub-id></citation></ref><ref id="R39"><label>39</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Beebe</surname><given-names>DC</given-names></name><name><surname>Silver</surname><given-names>MH</given-names></name><name><surname>Belcher</surname><given-names>KS</given-names></name><etal/></person-group><article-title>Lentropin, a protein that controls lens fiber formation, is related functionally and immunologically to the insulin-like growth factors</article-title><source>Proc Natl Acad Sci U S A</source><year>1987</year><volume>84</volume><fpage>2327</fpage><lpage>2330</lpage><pub-id pub-id-type="pmid">3470795</pub-id></citation></ref><ref id="R40"><label>40</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lovicu</surname><given-names>FJ</given-names></name><name><surname>McAvoy</surname><gi