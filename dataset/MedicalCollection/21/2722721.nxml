><name><surname>Kato</surname><given-names>T</given-names></name><name><surname>Esumi</surname><given-names>M</given-names></name><name><surname>Yamashita</surname><given-names>S</given-names></name><name><surname>Abe</surname><given-names>K</given-names></name><name><surname>Shikata</surname><given-names>T</given-names></name></person-group><year>1992</year><article-title>Interferon-inducible gene expression in chimpanzee liver infected with hepatitis C virus.</article-title><source>Virology</source><volume>190</volume><fpage>856</fpage><lpage>860</lpage><pub-id pub-id-type="pmid">1381540</pub-id></mixed-citation></ref><ref id="pone.0006661-Helbig1"><label>14</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Helbig</surname><given-names>KJ</given-names></name><name><surname>Lau</surname><given-names>DT</given-names></name><name><surname>Semendric</surname><given-names>L</given-names></name><name><surname>Harley</surname><given-names>HA</given-names></name><name><surname>Beard</surname><given-names>MR</given-names></name></person-group><year>2005</year><article-title>Analysis of ISG expression in chronic hepatitis C identifies viperin as a potential antiviral effector.</article-title><source>Hepatology</source><volume>42</volume><fpage>702</fpage><lpage>710</lpage><pub-id pub-id-type="pmid">16108059</pub-id></mixed-citation></ref><ref id="pone.0006661-Bigger2"><label>15</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bigger</surname><given-names>CB</given-names></name><name><surname>Guerra</surname><given-names>B</given-names></name><name><surname>Brasky</surname><given-names>KM</given-names></name><name><surname>Hubbard</surname><given-names>G</given-names></name><name><surname>Beard</surname><given-names>MR</given-names></name><etal/></person-group><year>2004</year><article-title>Intrahepatic gene expression during chronic hepatitis C virus infection in chimpanzees.</article-title><source>J Virol</source><volume>78</volume><fpage>13779</fpage><lpage>13792</lpage><pub-id pub-id-type="pmid">15564486</pub-id></mixed-citation></ref><ref id="pone.0006661-Vona1"><label>16</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Vona</surname><given-names>G</given-names></name><name><surname>Tuveri</surname><given-names>R</given-names></name><name><surname>Delpuech</surname><given-names>O</given-names></name><name><surname>Vallet</surname><given-names>A</given-names></name><name><surname>Canioni</surname><given-names>D</given-names></name><etal/></person-group><year>2004</year><article-title>Intrahepatic hepatitis C virus RNA quantification in microdissected hepatocytes.</article-title><source>J Hepatol</source><volume>40</volume><fpage>682</fpage><lpage>688</lpage><pub-id pub-id-type="pmid">15030986</pub-id></mixed-citation></ref><ref id="pone.0006661-Gosalvez1"><label>17</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gosalvez</surname><given-names>J</given-names></name><name><surname>Rodriguez-Inigo</surname><given-names>E</given-names></name><name><surname>Ramiro-Diaz</surname><given-names>JL</given-names></name><name><surname>Bartolome</surname><given-names>J</given-names></name><name><surname>Tomas</surname><given-names>JF</given-names></name><etal/></person-group><year>1998</year><article-title>Relative quantification and mapping of hepatitis C virus by in situ hybridization and digital image analysis.</article-title><source>Hepatology</source><volume>27</volume><fpage>1428</fpage><lpage>1434</lpage><pub-id pub-id-type="pmid">9581702</pub-id></mixed-citation></ref><ref id="pone.0006661-Pal1"><label>18</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Pal</surname><given-names>S</given-names></name><name><surname>Shuhart</surname><given-names>MC</given-n