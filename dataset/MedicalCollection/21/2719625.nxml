<name><surname>Donaldson</surname><given-names>F</given-names></name><name><surname>Vaughan-Thomas</surname><given-names>A</given-names></name><name><surname>Clegg</surname><given-names>PD</given-names></name><name><surname>Carter</surname><given-names>SD</given-names></name><name><surname>Mobasheri</surname><given-names>A</given-names></name><name><surname>Innes</surname><given-names>JF</given-names></name></person-group><article-title>Increased expression and total activity of collagenase does not correlate with collagen degradation from cytokine-treated equine cartilage explants</article-title><source>Int J Exp Path</source><year>2005</year><volume>86</volume><fpage>A93</fpage><lpage>A93</lpage></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Benton</surname><given-names>HP</given-names></name><name><surname>Vasseur</surname><given-names>PB</given-names></name><name><surname>BroderickVilla</surname><given-names>GA</given-names></name><name><surname>Koolpe</surname><given-names>M</given-names></name></person-group><article-title>Effect of carprofen on sulfated glycosaminoglycan metabolism, protein synthesis, and prostaglandin release by cultured osteoarthritic canine chondrocytes</article-title><source>Am J Vet Res</source><year>1997</year><volume>58</volume><fpage>286</fpage><lpage>292</lpage><pub-id pub-id-type="pmid">9055976</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Palmoski</surname><given-names>M</given-names></name><name><surname>Brandt</surname><given-names>K</given-names></name></person-group><article-title><italic>In vivo </italic>effects of aspirin on canine osteoarthritic cartilage</article-title><source>Arthritis Rheum</source><year>1983</year><volume>26</volume><fpage>994</fpage><lpage>1001</lpage><pub-id pub-id-type="pmid">6882492</pub-id><pub-id pub-id-type="doi">10.1002/art.1780260808</pub-id