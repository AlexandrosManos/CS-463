</citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Connell</surname><given-names>J</given-names></name><name><surname>Zurn</surname><given-names>P</given-names></name><name><surname>Stillwell</surname><given-names>B</given-names></name><name><surname>Awases</surname><given-names>M</given-names></name><name><surname>Braichet</surname><given-names>J-M</given-names></name></person-group><article-title>Sub-Saharan Africa: Beyond the health worker migration crisis?</article-title><source>Soc Sci Med</source><year>2007</year><volume>64</volume><fpage>1876</fpage><lpage>1891</lpage><pub-id pub-id-type="pmid">17316943</pub-id><pub-id pub-id-type="doi">10.1016/j.socscimed.2006.12.013</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eastwood</surname><given-names>J</given-names></name><name><surname>Conroy</surname><given-names>R</given-names></name><name><surname>Naicker</surname><given-names>S</given-names></name><name><surname>West</surname><given-names>P</given-names></name><name><surname>Tutt</surname><given-names>R</given-names></name><name><surname>Plange-Rhule</surname><given-names>J</given-names></name></person-group><article-title>Loss of health professionals from sub-Saharan Africa: the pivotal role of the UK</article-title><source>Lancet</source><year>2005</year><volume>365</volume><fpage>1893</fpage><lpage>1900</lpage><pub-id pub-id-type="pmid">15924988</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(05)66623-8</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pang</surname><given-names>T</given-names></name><name><surname>Lansang</surname><given-names>M</given-names></name><name><surname>Haines</surname><given-names>A</given-names></name></person-group><article-title>Brain drain and health professionals</article-title><source>BMJ</s