en-names>K</given-names></name><etal/></person-group><article-title>Stressful life events and risk of breast cancer in 10,808 women: a cohort study</article-title><source>Am J Epidemiol</source><year>2003</year><volume>157</volume><issue>5</issue><fpage>415</fpage><lpage>23</lpage><pub-id pub-id-type="doi">10.1093/aje/kwg002</pub-id><pub-id pub-id-type="pmid">12615606</pub-id></mixed-citation></ref><ref id="CR7"><label>7.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Feigenbaum</surname><given-names>SL</given-names></name><name><surname>Masi</surname><given-names>AT</given-names></name><name><surname>Kaplan</surname><given-names>SB</given-names></name></person-group><article-title>Prognosis in rheumatoid arthritis. A longitudinal study of newly diagnosed younger adult patients</article-title><source>Am J Med</source><year>1979</year><volume>66</volume><issue>3</issue><fpage>377</fpage><lpage>84</lpage><pub-id pub-id-type="doi">10.1016/0002-9343(79)91055-6</pub-id><pub-id pub-id-type="pmid">433943</pub-id></mixed-citation></ref><ref id="CR8"><label>8.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Waltz</surname><given-names>M</given-names></name><name><surname>Kriegel</surname><given-names>W</given-names></name><name><surname>Pad Bosch</surname><given-names>P</given-names></name></person-group><article-title>The social environment and health in rheumatoid arthritis: marital quality predicts individual variability in pain severity</article-title><source>Arthritis Care Res</source><year>1998</year><volume>11</volume><issue>5</issue><fpage>356</fpage><lpage>74</lpage><pub-id pub-id-type="doi">10.1002/art.1790110507</pub-id><pub-id pub-id-type="pmid">9830880</pub-id></mixed-citation></ref><ref id="CR9"><label>9.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Luborsky</surname><given-names>L</giv