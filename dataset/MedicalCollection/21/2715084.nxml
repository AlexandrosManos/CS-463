<!DOCTYPE article PUBLIC "-//NLM//DTD JATS (Z39.96) Journal Archiving and Interchange DTD v1.0 20120330//EN" "JATS-archivearticle1.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:mml="http://www.w3.org/1998/Math/MathML" article-type="correction"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">J Exp Med</journal-id><journal-id journal-id-type="hwp">jem</journal-id><journal-title-group><journal-title>The Journal of Experimental Medicine</journal-title></journal-title-group><issn pub-type="ppub">0022-1007</issn><issn pub-type="epub">1540-9538</issn><publisher><publisher-name>The Rockefeller University Press</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmc">2715084</article-id><article-id pub-id-type="publisher-id">2008091262209c</article-id><article-id pub-id-type="doi">10.1084/jem.2008091262209c</article-id><article-categories><subj-group subj-group-type="heading"><subject>Correction</subject></subj-group></article-categories><title-group><article-title>Cholera toxin inhibits IL-12 production and CD8&#x003b1;<sup>+</sup> dendritic cell differentiation by cAMP-mediated inhibition of IRF8 function</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>la Sala</surname><given-names>Andrea</given-names></name></contrib><contrib contrib-type="author"><name><surname>He</surname><given-names>Jianping</given-names></name></contrib><contrib contrib-type="author"><name><surname>Laricchia-Robbio</surname><given-names>Leopoldo</given-names></name></contrib><contrib contrib-type="author"><name><surname>Gorini</surname><given-names>Stefania</given-names></name></contrib><contrib contrib-type="author"><name><surname>Iwasaki</surname><given-names>Akiko</given-names></name></contrib><contrib contrib-type="author"><name><surname>Braun</surname><given-names>Michael</given-names></name></contrib><contrib contrib-type="author"><name><surname>Yap</surname><given-names>George S.</given-names></name></contrib><contrib contrib-type="author"><name><surname>Sher</surname><given-names>Alan</given-names></name></contrib><contrib contrib-type="author"><name><surname>Ozato</surname><given-names>Keiko</given-names></name></contrib><contrib contrib-type="author"><name><surname>Kelsall</surname><given-names>Brian</given-names></name></contrib></contrib-group><pub-date pub-type="ppub"><day>6</day><month>7</month><year>2009</year></pub-date><volume>206</volume><issue>7</issue><fpage>1635</fpage><lpage>1635</lpage><permissions><copyright-statement>&#x000a9; 2009 The Rockefeller University Press</copyright-statement><copyright-year>2009</copyright-year></permissions></article-meta></front><body><p>Vol. 206, No. 6, June 8, 2009. Pages <related-article related-article-type="corrected-article" vol="206" page="1227" id="d32e114" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="19487420" ext-link-type="pubmed">1227&#x02013;1235</related-article>.</p><p>The authors regret that an error appeared in the affiliations section of their article. George Yap's address was listed incorrectly. The correct address is as follows: Center for Immunity and Inflammation, University of Medicine and Dentistry of New Jersey Medical School, Newark, NJ 07101. The address has been corrected in the pdf and html versions of the article.</p></body></article>