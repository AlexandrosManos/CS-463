xed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>MM</given-names></name><name><surname>Enns</surname><given-names>R</given-names></name></person-group><article-title>Narrow band imaging for the detection of neoplastic lesions of the colon</article-title><source>Can J Gastroenterol</source><year>2009</year><volume>23</volume><fpage>15</fpage><lpage>18</lpage>Review.<pub-id pub-id-type="pmid">19172202</pub-id></mixed-citation></ref><ref id="bib20"><mixed-citation publication-type="other"><person-group person-group-type="author"><collab>Online Mendelian Inheritance in Man (OMIM)</collab></person-group><x>;</x><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="uri" xlink:href="http://www.ncbi.nlm.nih.gov/omim">http://www.ncbi.nlm.nih.gov/omim</ext-link><x>.</x></mixed-citation></ref><ref id="bib21"><mixed-citation publication-type="other"><person-group person-group-type="author"><collab>National Center for Biotechnology Information (NCBI)</collab></person-group>GeneReviews, Eng C., PTEN Hamartoma Tumor Syndrome (PHTS).<x></x><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="uri" xlink:href="http://www.ncbi.nlm.nih.gov">http://www.ncbi.nlm.nih.gov</ext-link><x>.</x></mixed-citation></ref><ref id="bib22"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nassif</surname><given-names>N</given-names></name><name><surname>Lobo</surname><given-names>GP</given-names></name><name><surname>Wu</surname><given-names>X</given-names></name><etal/></person-group><article-title>PTEN mutations are common in sporadic microsatellite stable colorectal cancer</article-title><source>Oncogene</source><year>2004</year><volume>23</volume><fpage>617</fpage><lpage>628</lpage><pub-id pub-id-type="pmid">14724591</pub-id></mixed-citation></ref></ref-list></back><floats-group><fig id="fig1"><label>Figure 1</label><caption><p>Duodenal view in Cowden syndrome patient using white light.</p></caption><graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="ctg20114f1"/></fig><fig id="fig2"><label>Figure 2</label><caption><p>Duodenal view in Cowden syndrome patient using narrow-band imaging.</p></caption><graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="ctg20114f2"/></fig><table-wrap id="tbl1"><label>Table 1</label><caption><title>Patients' characteristics and features observed in our PTEN mutation&#x02013;positive patients</title></caption><table frame="hsides" rules="groups" border="1"><colgroup><col align="left"/><col align="char" char="("/></colgroup><tbody valign="top"><tr><td align="left" valign="top" charoff="50">All</td><td align="char" valign="top" char="(" charoff="50">10 (100&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50">Age (mean, s.d.)</td><td align="char" valign="top" char="(" charoff="50">40.8&#x000b1;16.0 (years)</td></tr><tr><td colspan="2" align="left" valign="top" charoff="50"><italic>Gender</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Male</td><td align="char" valign="top" char="(" charoff="50">7 (70&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Female</td><td align="char" valign="top" char="(" charoff="50">3 (30&#x00025;)</td></tr><tr><td colspan="2" align="left" valign="top" charoff="50"><italic>Origin</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Jew</td><td align="char" valign="top" char="(" charoff="50">7 (70&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Arab</td><td align="char" valign="top" char="(" charoff="50">3 (30&#x00025;)</td></tr><tr><td colspan="2" align="left" valign="top" charoff="50"><italic>Head</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Macrocephaly</td><td align="char" valign="top" char="(" charoff="50">3 (30&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Lherm