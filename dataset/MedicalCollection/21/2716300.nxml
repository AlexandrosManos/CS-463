ef><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burman</surname><given-names>D</given-names></name></person-group><article-title>Familial patent ductus arteriosus</article-title><source>Br Heart J</source><year>1961</year><volume>23</volume><fpage>603</fpage><lpage>604</lpage><pub-id pub-id-type="pmid">13689120</pub-id><pub-id pub-id-type="doi">10.1136/hrt.23.5.603</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lynch</surname><given-names>HT</given-names></name><name><surname>Grisson</surname><given-names>RL</given-names></name><name><surname>Magnuson</surname><given-names>CR</given-names></name><name><surname>Krush</surname><given-names>A</given-names></name></person-group><article-title>Patent ductus arteriosus: study of two families</article-title><source>JAMA</source><year>1965</year><volume>194</volume><fpage>115</fpage><lpage>118</lpage><pub-id pub-id-type="pmid">4284236</pub-id><pub-id pub-id-type="doi">10.1001/jama.194.2.115</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rogers</surname><given-names>JC</given-names></name><name><surname>Begleiter</surname><given-names>ML</given-names></name><name><surname>Harris</surname><given-names>DJ</given-names></name></person-group><article-title>Patent ductus arteriosus in four generations of a family (letter)</article-title><source>J Med Genet</source><year>1992</year><volume>29</volume><fpage>758</fpage><pub-id pub-id-type="pmid">1433244</pub-id><pub-id pub-id-type="doi">10.1136/jmg.29.10.758</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Woods</surname><given-names>CG</given-names></name><name><surname>Sheffield</surname><given-names>LJ</given-names></name></person-group><article-title>Further family with autosomal 