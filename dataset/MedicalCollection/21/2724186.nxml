n-group person-group-type="author"><name><surname>Bachrach</surname><given-names>LK</given-names></name><name><surname>Marcus</surname><given-names>R</given-names></name><name><surname>Rosenbloom</surname><given-names>AL</given-names></name><etal/></person-group><article-title>Bone mineral, histomorphometry, and body composition in adults with growth hormone receptor deficiency</article-title><source>J Bone Miner Res</source><year>1998</year><volume>13</volume><issue>3</issue><fpage>415</fpage><lpage>421</lpage><pub-id pub-id-type="pmid">9525342</pub-id></mixed-citation></ref><ref id="b13-tcrm-5-553"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Benbassat</surname><given-names>CA</given-names></name><name><surname>Eshed</surname><given-names>V</given-names></name><name><surname>Kamjin</surname><given-names>M</given-names></name><name><surname>Laron</surname><given-names>Z</given-names></name></person-group><article-title>Are adult patients with Laron syndrome osteopenic? A comparison between dual-energy X-ray absorptiometry and volumetric bone densities</article-title><source>J Clin Endocrinol Metab</source><year>2003</year><volume>88</volume><issue>10</issue><fpage>4586</fpage><lpage>4589</lpage><pub-id pub-id-type="pmid">14557426</pub-id></mixed-citation></ref><ref id="b14-tcrm-5-553"><label>14</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Laron</surname><given-names>Z</given-names></name><name><surname>Sarel</surname><given-names>R</given-names></name><name><surname>Pertzelan</surname><given-names>A</given-names></name></person-group><article-title>Puberty in Laron type dwarfism</article-title><source>Eur J Pediatr</source><year>1980</year><volume>134</volume><issue>1</issue><fpage>79</fpage><lpage>83</lpage><pub-id pub-id-type="pmid">7408914</pub-id></mixed-citation></ref><ref id="b15-tcrm-5-553"><label>15</label><mixed-citation publi