uthor"><name><surname>Ohta</surname><given-names>T</given-names></name><name><surname>Waga</surname><given-names>S</given-names></name><name><surname>Saito</surname><given-names>Y</given-names></name><etal/></person-group><article-title>The new grading system for disturbed consciousness and its numerical expression; the 3-3-9 degrees method</article-title>. <conf-name>The Third Meeting of Society on Surgery for Cerebral Stroke (In Japanese), Hakone, Kanagawa, Japan,</conf-name><year>1974</year>;<volume>3</volume>:<fpage>61</fpage>&#x02013;<lpage>8</lpage></mixed-citation></ref><ref id="R7"><label>7</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Teasdale</surname><given-names>G</given-names></name><name><surname>Jennett</surname><given-names>B</given-names></name></person-group><article-title>Assessment of coma and impaired consciousness. A practical scale</article-title>. <source>Lancet</source><year>1974</year>;<volume>2</volume>:<fpage>81</fpage>&#x02013;<lpage>4</lpage><pub-id pub-id-type="pmid">4136544</pub-id></mixed-citation></ref><ref id="R8"><label>8</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Weir</surname><given-names>CJ</given-names></name><name><surname>Bradford</surname><given-names>AP</given-names></name><name><surname>Lees</surname><given-names>KR</given-names></name></person-group><article-title>The prognostic value of the components of the Glasgow Coma Scale following acute stroke</article-title>. <source>QJM</source><year>2003</year>;<volume>96</volume>:<fpage>67</fpage>&#x02013;<lpage>74</lpage><pub-id pub-id-type="pmid">12509651</pub-id></mixed-citation></ref><ref id="R9"><label>9</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Shigematsu</surname><given-names>K</given-names></name><name><surname>Shimamura</surname><given-names>O</given-names></name><name><surname>Nakano</surname><given-names>H</given-names></name><etal/></person-group><article-title>Vomiting should be a prompt predictor of stroke outcome</article-title>. <source>Emerg Med J</source>. doi:<ext-link ext-link-type="uri" xlink:href="http://dx.doi.org/10.1136/emermed-2012-201586">10.1136/emermed-2012-201586</ext-link> (<comment>in press</comment>).</mixed-citation></ref><ref id="R10"><label>10</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Shigematsu</surname><given-names>K</given-names></name><name><surname>Nakano</surname><given-names>H</given-names></name><name><surname>Watanabe</surname><given-names>Y</given-names></name><etal/></person-group><article-title>Characteristics, risk factors and mortality of stroke patients in Kyoto, Japan</article-title>. <source>BMJ Open</source><year>2013</year>;<volume>3</volume>:<fpage>e002181</fpage></mixed-citation></ref><ref id="R11"><label>11</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hatano</surname><given-names>S</given-names></name></person-group><article-title>Experience from a multicentre stroke register: a preliminary report</article-title>. <source>Bull World Health Organ</source><year>1976</year>;<volume>54</volume>:<fpage>541</fpage>&#x02013;<lpage>53</lpage><pub-id pub-id-type="pmid">1088404</pub-id></mixed-citation></ref><ref id="R12"><label>12</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lingsma</surname><given-names>HF</given-names></name><name><surname>Roozenbeek</surname><given-names>B</given-names></name><name><surname>Steyerberg</surname><given-names>EW</given-names></name><etal/></person-group><article-title>Early prognosis in traumatic brain injury: from prophecies to predictions</article-title>. <source>Lancet Neurol</source><year>2010</year>;<volume>9</volume>:<fpage>543</fpage>&#x02013;<lpage>54</lpage><pub-id pub-id-type="pmid">20398861</pub-id></mixed-citation></ref><ref id="R13"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wijdicks</surname><given-names>EF</given-names></name><name><surname>Rabinstein</surname><given-names>AA</given-names></name><name><surname>Bamlet</surname><given-names>WR</given-names></name><etal/></person-group><article-title>FOUR score and Glasgow Coma Scale in predicting outcome of comatose patients: a pooled analysis</article-title>. <source>Neurology</source><year>2011</year>;<volume>77</volume>:<fpage>84</fpage>&#x02013;<lpage>5</lpage><pub-id pub-id-type="pmid">21562252</pub-id></mixed-citation></ref><ref id="R14"><label>14</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chandra</surname><given-names>RV</given-names></name><name><surname>Law</surname><given-names>CP</given-names></name><name><surname>Yan</surname><given-names>B</given-names></name><etal/></person-group><article-title>Glasgow coma scale does not predict outcome post-intra-arterial treatment for basilar artery thrombosis</article-title>. <source>Am J Neuroradiol</source><year>2011</year>;<volume>32</volume>:<fpage>576</fpage>&#x02013;<lpage>80</lpage><pub-id pub-id-type="pmid">21349965</pub-id></mixed-citation></ref><ref id="R15"><label>15</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Aggestrup</surname><given-names>LM</given-names></name><name><surname>Hestbech</surname><given-names>MS</given-names></name><name><surname>Siersma</surname><given-names>V</given-names></name><etal/></person-group><article-title>Psychosocial consequences of allocation to lung cancer screening: a randomised controlled trial</article-title>. <source>BMJ Open</source><year>2012</year>;<volume>2</volume>:<fpage>e000663</fpage></mixed-citation></ref><ref id="R16"><label>16</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Arnould</surname><given-names>C</given-names></name><name><surname>Vandervelde</surname><given-names>L</given-names></name><name><surname>Batcho</surname><given-names>CS</given-names></name><etal/></person-group><article-title>Can manual ability be measured with a generic ABILHAND scale? A cross-sectional study conducted on six diagnostic groups</article-title>. <source>BMJ Open</source><year>2012</year>;<volume>2</volume>:<fpage>e001807</fpage></mixed-citation></ref><ref id="R17"><label>17</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Friberg</surname><given-names>P</given-names></name><name><surname>Hagquist</surname><given-names>C</given-names></name><name><surname>Osika</surname><given-names>W</given-names></name></person-group><article-title>Self-perceived psychosomatic health in Swedish children, adolescents and young adults: an internet-based survey over time</article-title>. <source>BMJ Open</source><year>2012</year>;<volume>2</volume>:<fpage>e000681</fpage></mixed-citation></ref></ref-list></back></article>