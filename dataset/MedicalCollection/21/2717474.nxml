or"><name><surname>Buttenschoen</surname><given-names>K</given-names></name><name><surname>Schneider</surname><given-names>ME</given-names></name><name><surname>Utz</surname><given-names>K</given-names></name><name><surname>Kornmann</surname><given-names>M</given-names></name><name><surname>Beger</surname><given-names>HG</given-names></name><name><surname>Carli</surname><given-names>BD</given-names></name></person-group><article-title>Effect of major abdominal surgery on endotoxin release and expression of Toll-like receptors 2/4</article-title><source>Langenbecks Arch Surg</source><year>2009</year><volume>394</volume><fpage>293</fpage><lpage>302</lpage><pub-id pub-id-type="pmid">18546014</pub-id><pub-id pub-id-type="doi">10.1007/s00423-008-0357-8</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boelke</surname><given-names>E</given-names></name><name><surname>Storck</surname><given-names>M</given-names></name><name><surname>Buttenschoen</surname><given-names>K</given-names></name><name><surname>Berger</surname><given-names>D</given-names></name><name><surname>Hannekum</surname><given-names>A</given-names></name></person-group><article-title>Endotoxemia and mediator release during cardiac surgery</article-title><source>Angiology</source><year>2000</year><volume>51</volume><fpage>743</fpage><lpage>749</lpage><pub-id pub-id-type="pmid">10999615</pub-id><pub-id pub-id-type="doi">10.1177/000331970005100906</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jansen</surname><given-names>PG</given-names></name><name><surname>Te</surname><given-names>VH</given-names></name><name><surname>Oudemans-Van Straaten</surname><given-names>HM</given-names></name><name><surname>Bulder</surname><given-names>ER</given-names></name><name><surname>Van Deventer</surname><given-names>SJ</given-names></name><name><surname>Sturk</surnam