ssue><fpage>25</fpage><lpage>29</lpage><pub-id pub-id-type="pmid">18055574</pub-id></mixed-citation></ref><ref id="b14-opth-3-413"><label>14</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Casson</surname><given-names>RJ</given-names></name><name><surname>Gupta</surname><given-names>A</given-names></name><name><surname>Newland</surname><given-names>HS</given-names></name><etal/></person-group><article-title>Risk factors for primary open-angle glaucoma in a Burmese population: the Meiktila Eye Study</article-title><source>Clin Experiment Ophthalmol</source><year>2007</year><volume>35</volume><issue>8</issue><fpage>739</fpage><lpage>744</lpage><pub-id pub-id-type="pmid">17997778</pub-id></mixed-citation></ref><ref id="b15-opth-3-413"><label>15</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Casson</surname><given-names>RJ</given-names></name><name><surname>Newland</surname><given-names>HS</given-names></name><name><surname>Muecke</surname><given-names>J</given-names></name><etal/></person-group><article-title>Gonioscopy findings and prevalence of occludable angles in a Burmese population: the Meiktila Eye Study</article-title><source>Br J Ophthalmol</source><year>2007</year><volume>91</volume><fpage>856</fpage><lpage>859</lpage><pub-id pub-id-type="pmid">17576708</pub-id></mixed-citation></ref><ref id="b16-opth-3-413"><label>16</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Casson</surname><given-names>RJ</given-names></name><name><surname>Newland</surname><given-names>HS</given-names></name><name><surname>Muecke</surname><given-names>J</given-names></name><etal/></person-group><article-title>Prevalence of glaucoma in rural Myanmar: the Meiktila Eye Study</article-title><source>Br J Ophthalmol</source><year>2007</year><volume>91</volume><fpage>710</fpage><lpage>714</lpage><pub-id pub-id-type="pmi