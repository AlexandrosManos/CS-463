></name><name><surname>Brun-Vezinet</surname><given-names>F</given-names></name><name><surname>Clotet</surname><given-names>B</given-names></name><name><surname>Gunthard</surname><given-names>HF</given-names></name><name><surname>Kuritzkes</surname><given-names>DR</given-names></name><name><surname>Pillay</surname><given-names>D</given-names></name><name><surname>Schapiro</surname><given-names>JM</given-names></name><name><surname>Richman</surname><given-names>DD</given-names></name></person-group><article-title>Update of the drug resistance mutations in HIV-1: 2007</article-title><source>Top HIV Medicine</source><year>2007</year><volume>15</volume><fpage>119</fpage><lpage>125</lpage></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>D'Aquila</surname><given-names>RT</given-names></name><name><surname>Schapiro</surname><given-names>JM</given-names></name><name><surname>Brun-V&#x000e9;zinet</surname><given-names>F</given-names></name><name><surname>Clotet</surname><given-names>B</given-names></name><name><surname>Md</surname><given-names>PD</given-names></name><name><surname>Conway</surname><given-names>B</given-names></name><name><surname>Demeter</surname><given-names>LM</given-names></name><name><surname>Grant</surname><given-names>RM</given-names></name><name><surname>Johnson</surname><given-names>VA</given-names></name><name><surname>Kuritzkes</surname><given-names>DR</given-names></name></person-group><article-title>Drug Resistance Mutations in HIV-1</article-title><source>Top HIV Medicine</source><year>2002</year><volume>10</volume></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnson</surname><given-names>VA</given-names></name><name><surname>Brun-V&#x000e9;zinet</surname><given-names>F</given-names></name><name><surname>Clotet</surname><given-names>B</given-names></name><name><surname>Conway</surname><given-names>B</given-names></name><name><surname>Md</surname><given-names>RTD</given-names></name><name><surname>Demeter</surname><given-names>LM</given-names></name><name><surname>Kuritzkes</surname><given-names>DR</given-names></name><name><surname>Pillay</surname><given-names>D</given-names></name><name><surname>Schapiro</surname><given-names>JM</given-names></name><name><surname>Telenti</surname><given-names>A</given-names></name></person-group><article-title>Update of the Drug Resistance Mutations in HIV-1: 2004</article-title><source>Top HIV Medicine</source><year>2004</year><volume>292</volume><fpage>119</fpage><lpage>24</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnson</surname><given-names>VA</given-names></name><name><surname>Brun-Vezinet</surname><given-names>F</given-names></name><name><surname>Clotet</surname><given-names>B</given-names></name><name><surname>Kuritzkes</surname><given-names>DR</given-names></name><name><surname>Pillay</surname><given-names>D</given-names></name><name><surname>Schapiro</surname><given-names>JM</given-names></name><name><surname>Richman</surname><given-names>DD</given-names></name></person-group><article-title>Update of the drug resistance mutations in HIV-1: Fall 2006</article-title><source>Top HIV Medicine</source><year>2006</year><volume>14</volume><fpage>125</fpage><lpage>130</lpage></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Katz</surname><given-names>MH</given-names></name><name><surname>Schwarcz</surname><given-names>SK</given-names></name><name><surname>Kellogg</surname><given-names>TA</given-names></name><name><surname>Klausner</surname><given-names>JD</given-names></name><name><surname>Dilley</surname><given-names>JW</given-names></name><name><surname>Gibson</surname><given-names>S</given-names></name><name><surname>McFarland</surname><given-names>W</given-names></nam