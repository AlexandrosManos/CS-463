rnal"><person-group person-group-type="author"><name><surname>Torre-Aboki</surname><given-names>J</given-names></name><name><surname>Carbonell-Jorda</surname><given-names>A</given-names></name><name><surname>Martinez-Alberola</surname><given-names>N</given-names></name><etal/></person-group><article-title>Evaluation of educational needs among patients with RA using the Spanish version of the ENAT (SPENAT)</article-title><source>Ann Rheum Dis</source><year>2008</year><volume>67</volume><issue>Suppl II</issue><fpage>667</fpage></citation><citation citation-type="display-unstructured">de la Torre-Aboki J, Carbonell-Jorda A, Martinez-Alberola N et al (2008) Evaluation of educational needs among patients with RA using the Spanish version of the ENAT (SPENAT). Ann Rheum Dis 67(Suppl II):667 </citation></ref><ref id="CR16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bergsten</surname><given-names>U</given-names></name><name><surname>Arvidsson</surname><given-names>B</given-names></name><name><surname>Bergman</surname><given-names>S</given-names></name><etal/></person-group><article-title>Evaluation of educational needs among patients with RA using the Swedish version of ENAT (SwENAT)</article-title><source>Ann Rheum Dis</source><year>2008</year><volume>67</volume><issue>Suppl II</issue><fpage>666</fpage></citation><citation citation-type="display-unstructured">Bergsten U, Arvidsson B, Bergman S et al (2008) Evaluation of educational needs among patients with RA using the Swedish version of ENAT (SwENAT). Ann Rheum Dis 67(Suppl II):666 </citation></ref><ref id="CR17"><label>17.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Neame</surname><given-names>R</given-names></name><name><surname>Hammond</surname><given-names>A</given-names></name><name><surname>Deighton</surname><given-names>C</given-names></name></person-group><article-title>Need for information and for involvement in decision making among patients with rheumatoid arthritis: a questionnaire survey</article-title><source>Arthritis Rheum</source><year>2005</year><volume>53</volume><fpage>249</fpage><lpage>255</lpage><pub-id pub-id-type="doi">10.1002/art.21071</pub-id></citation><citation citation-type="display-unstructured">Neame R, Hammond A, Deighton C (2005) Need for information and for involvement in decision making among patients with rheumatoid arthritis: a questionnaire survey. Arthritis Rheum 53:249&#x02013;255 <pub-id pub-id-type="pmid">15818715</pub-id></citation></ref><ref id="CR18"><label>18.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adab</surname><given-names>P</given-names></name><name><surname>Rankin</surname><given-names>EC</given-names></name><name><surname>Witney</surname><given-names>AG</given-names></name><etal/></person-group><article-title>Use of a corporate needs assessment to define the information requirements of an arthritis resource centre in Birmingham: comparison of patients' and professionals' views</article-title><source>Rheumatology (Oxford)</source><year>2004</year><volume>43</volume><fpage>1513</fpage><lpage>1518</lpage><pub-id pub-id-type="doi">10.1093/rheumatology/keh371</pub-id></citation><citation citation-type="display-unstructured">Adab P, Rankin EC, Witney AG et al (2004) Use of a corporate needs assessment to define the information requirements of an arthritis resource centre in Birmingham: comparison of patients' and professionals' views. Rheumatology (Oxford) 43:1513&#x02013;1518 <pub-id pub-id-type="pmid">15328424</pub-id></citation></ref><ref id="CR19"><label>19.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Neville</surname><given-names>C</given-names></name><name><surname>Fortin</surname><given-names>PR</given-names></name><name><surname>Fitzcharles</surname><given-names>MA</given-names></name><etal/></person-group