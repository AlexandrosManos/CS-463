 pub-id-type="pmid">12941655</pub-id></mixed-citation></ref><ref id="pone.0006670-Fehrenbach1"><label>5</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Fehrenbach</surname><given-names>H</given-names></name></person-group><year>2006</year><article-title>Animal models of pulmonary emphysema: a stereologist's perspective.</article-title><source>Eur Respir Rev</source><volume>15</volume><fpage>136</fpage><lpage>147</lpage></mixed-citation></ref><ref id="pone.0006670-Weibel1"><label>6</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Weibel</surname><given-names>ER</given-names></name></person-group><year>2006</year><article-title>Morphological quantitation of emphysema: A debate.</article-title><source>J Appl Physiol</source><volume>100</volume><fpage>1419</fpage><lpage>1420</lpage><pub-id pub-id-type="pmid">16540717</pub-id></mixed-citation></ref><ref id="pone.0006670-Weibel2"><label>7</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Weibel</surname><given-names>ER</given-names></name><name><surname>Hsia</surname><given-names>CCW</given-names></name><name><surname>Ochs</surname><given-names>M</given-names></name></person-group><year>2007</year><article-title>How much is there really? Why stereology is essential in lung morphometry.</article-title><source>J Appl Physiol</source><volume>102</volume><fpage>459</fpage><lpage>467</lpage><pub-id pub-id-type="pmid">16973815</pub-id></mixed-citation></ref><ref id="pone.0006670-Ito1"><label>8</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ito</surname><given-names>S</given-names></name><name><surname>Ingenito</surname><given-names>EP</given-names></name><name><surname>Arold</surname><given-names>SP</given-names></name><name><surname>Parameswaran</surname><given-names>H</given-names></name><name><surna