></name><name><surname>Luk</surname><given-names>JM</given-names></name></person-group><article-title>Junction interaction in the seminiferous epithelium: Regulatory roles of connexin-based gap junction</article-title><source>Front Biosci</source><year>2007</year><volume>12</volume><fpage>1552</fpage><lpage>1562</lpage><pub-id pub-id-type="pmid">17127402</pub-id></element-citation></ref><ref id="R21"><label>21</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>NPY</given-names></name><name><surname>Cheng</surname><given-names>CY</given-names></name></person-group><article-title>Nitric oxide/nitric oxide synthase, spermatogenesis, and tight junction dynamics</article-title><source>Biol Reprod</source><year>2004</year><volume>70</volume><fpage>267</fpage><lpage>276</lpage><pub-id pub-id-type="pmid">14522829</pub-id></element-citation></ref><ref id="R22"><label>22</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Pointis</surname><given-names>G</given-names></name><name><surname>Segretain</surname><given-names>D</given-names></name></person-group><article-title>Role of connexin-based gap junction channels in testis</article-title><source>Trends Endocrinol Metab</source><year>2005</year><volume>16</volume><fpage>300</fpage><lpage>306</lpage><pub-id pub-id-type="pmid">16054834</pub-id></element-citation></ref><ref id="R23"><label>23</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>NPY</given-names></name><name><surname>Leung</surname><given-names>KW</given-names></name><name><surname>Wo</surname><given-names>JY</given-names></name><etal/></person-group><article-title>Blockage of testicular connexins induced apoptosis in rat seminiferous epithelium</article-title><source>Apoptosis</source><year>2006</year><volume>11</volume><fpage>1215</fpage><lpage>