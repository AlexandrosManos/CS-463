><given-names>HF</given-names></name></person-group><year>1992</year><article-title>Lipoprotein (a) is an independent risk factor for cardiovascular disease in hemodialysis patients</article-title><source>Circulation</source><volume>86</volume><fpage>475</fpage><lpage>82</lpage><pub-id pub-id-type="pmid">1386292</pub-id></mixed-citation></ref><ref id="b7-bmi-2006-185"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Danesh</surname><given-names>J</given-names></name><name><surname>Collins</surname><given-names>R</given-names></name><name><surname>Peto</surname><given-names>R</given-names></name></person-group><year>2000</year><article-title>Lipoprotein(a) and coronary heart disease. Meta-analysis of prospective studies</article-title><source>Circulation</source><volume>102</volume><fpage>1082</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">10973834</pub-id></mixed-citation></ref><ref id="b8-bmi-2006-185"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>De Backer</surname><given-names>G</given-names></name><name><surname>Ambrosioni</surname><given-names>E</given-names></name><name><surname>Borch-Johnsen</surname><given-names>K</given-names></name><etal/></person-group><year>2003</year><article-title>European guidelines on cardiovascular disease and prevention in clinical practice</article-title><source>Atherosclerosis</source><volume>171</volume><fpage>145</fpage><lpage>55</lpage><pub-id pub-id-type="pmid">14686332</pub-id></mixed-citation></ref><ref id="b9-bmi-2006-185"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gotto</surname><given-names>AM</given-names><suffix>Jr</suffix></name><name><surname>Whitney</surname><given-names>E</given-names></name><name><surname>Stein</surname><given-names>EA</given-names></name><etal/></person-group><year>2000</year><article-title>Relation between baseline and on-treatment lipi