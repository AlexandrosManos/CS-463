n="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">&#x02191;Aspartate amino transferase (2%)</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">&#x02191;Alanine amino transferase (2%)</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">&#x02191;Gamma glutamyl transferase (3%)</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Reference</td><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b8-tcrm-5-595">8</xref>,<xref ref-type="bibr" rid="b10-tcrm-5-595">10</xref></td><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b19-tcrm-5-595">19</xref></td><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b20-tcrm-5-595">20</xref></td><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b15-tcrm-5-595">15</xref></td><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b24-tcrm-5-595">24</xref></td></tr></tbody></table><table-wrap-foot><fn id="tfn6-tcrm-5-595"><label><sup>a</sup></label><p>Only dose included in analysis.</p></fn><fn id="tfn7-tcrm-5-595"><p><bold>Abbreviation:</bold> LPV, lopinavir; PI, protease inhibitor.</p></fn></table-wrap-foot></table-wrap><table-wrap id="t6-tcrm-5-595" position="float"><label>Table 6</label><caption><p>Baseline characteristics of the DELPHI pediatric cohort</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" valign="top" rowspan="1" colspan="1">Demographics</th><th align="left" valign="top" rowspan="1" colspan="1">n (%)</th></tr></thead><tbody><tr><td align="left" valign="top" rowspan="1" colspan="1">Male</td><td align="left" valign="top" rowspan="1" colspan="1">57 (71)</td></tr><tr><td colspan="2" align="left" valign="top" rowspan="1">Age</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;6 to &#x0003c;12 years</td><td align="left" valign="top" rowspan="1" colspan="1">24 (30)</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;12 to 17 years</td><td align="left" valign="top" rowspan="1" colspan="1">56 (70)</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Perinatal infection</td><td align="left" valign="top" rowspan="1" colspan="1">62 (78)</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">CDC class C</td><td align="left" valign="top" rowspan="1" colspan="1">40 (50)</td></tr><tr><td colspan="2" align="left" valign="top" rowspan="1"><bold>Disease characteristics</bold></td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;Mean (SD) viral load (log<sub>10</sub> copies/mL)</td><td align="left" valign="top" rowspan="1" colspan="1">4.64 (0.80)</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;Median (range) CD4+ cell count (cells/mm<sup>3</sup>)</td><td align="left" valign="top" rowspan="1" colspan="1">330 (6&#x02013;1505)</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;Median (range) CD4+ cell %</td><td align="left" valign="top" rowspan="1" colspan="1">17 (1&#x02013;47)</td></tr><tr><td colspan="2" align="left" valign="top" rowspan="1"><bold>Previous antiretroviral treatment</bold></td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;Median (range) number of drugs</td><td align="left" valign="top" rowspan="1" colspan="1">9 (3&#x02013;19)</td></tr><tr><td align="