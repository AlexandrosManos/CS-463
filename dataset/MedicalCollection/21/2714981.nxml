e>238</volume><fpage>5</fpage><lpage>20</lpage><pub-id pub-id-type="pmid">7608647</pub-id></mixed-citation></ref><ref id="pone.0006503-Prescott1"><label>7</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Prescott</surname><given-names>SM</given-names></name><name><surname>Zimmerman</surname><given-names>GA</given-names></name><name><surname>McIntyre</surname><given-names>TM</given-names></name></person-group><year>1990</year><article-title>Platelet-activating factor.</article-title><source>J Biol Chem</source><volume>265</volume><fpage>17381</fpage><lpage>17384</lpage><pub-id pub-id-type="pmid">2170377</pub-id></mixed-citation></ref><ref id="pone.0006503-CasalsStenzel1"><label>8</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Casals-Stenzel</surname><given-names>J</given-names></name></person-group><year>1987</year><article-title>Protective effect of WEB 2086, a novel antagonist of platelet activating factor, in endotoxin shock.</article-title><source>Eur J Pharmacol</source><volume>135</volume><fpage>117</fpage><lpage>122</lpage><pub-id pub-id-type="pmid">3582490</pub-id></mixed-citation></ref><ref id="pone.0006503-Giral1"><label>9</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Giral</surname><given-names>M</given-names></name><name><surname>Balsa</surname><given-names>D</given-names></name><name><surname>Ferrando</surname><given-names>R</given-names></name><name><surname>Merlos</surname><given-names>M</given-names></name><name><surname>Garcia-Rafanell</surname><given-names>J</given-names></name><etal/></person-group><year>1996</year><article-title>Effects of UR-12633, a new antagonist of platelet-activating factor, in rodent models of endotoxic shock.</article-title><source>Br J Pharmacol</source><volume>118</volume><fpage>1223</fpage><lpage>1231</lpage><pub-id pub-id-type="pmid">8818347</pub-