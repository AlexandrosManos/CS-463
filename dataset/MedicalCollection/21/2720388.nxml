<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="meeting-report"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Head Neck Oncol</journal-id><journal-title>Head &#x00026; Neck Oncology</journal-title><issn pub-type="epub">1758-3284</issn><publisher><publisher-name>BioMed Central</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">19594907</article-id><article-id pub-id-type="pmc">2720388</article-id><article-id pub-id-type="publisher-id">1758-3284-1-25</article-id><article-id pub-id-type="doi">10.1186/1758-3284-1-25</article-id><article-categories><subj-group subj-group-type="heading"><subject>Meeting Report</subject></subj-group></article-categories><title-group><article-title>Head &#x00026; neck optical diagnostics: vision of the future of surgery</article-title></title-group><contrib-group><contrib id="A1" contrib-type="author"><name><surname>Upile</surname><given-names>Tahwinder</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I2">2</xref><xref ref-type="aff" rid="I3">3</xref><email>mrtupile@yahoo.com</email></contrib><contrib id="A2" contrib-type="author"><name><surname>Jerjes</surname><given-names>Waseem</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I2">2</xref><xref ref-type="aff" rid="I3">3</xref><xref ref-type="aff" rid="I4">4</xref><email>waseem_wk1@yahoo.co.uk</email></contrib><contrib id="A3" contrib-type="author"><name><surname>Sterenborg</surname><given-names>Henricus JCM</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I5">5</xref><email>h.j.c.m.sterenborg@erasmusmc.nl</email></contrib><contrib id="A4" contrib-type="author"><name><surname>El-Naggar</surname><given-names>Adel K</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I6">6</xref><email>anaggar@mdanderson.org</email></contrib><contrib id="A5" contrib-type="author"><name><surname>Sandison</surname><given-names>Ann</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I7">7</xref><email>ann_sandison@hotmail.com</email></contrib><contrib id="A6" contrib-type="author"><name><surname>Witjes</surname><given-names>Max JH</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I8">8</xref><email>m.j.h.witjes@kchir.umcg.nl</email></contrib><contrib id="A7" contrib-type="author"><name><surname>Biel</surname><given-names>Merrill A</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I9">9</xref><email>Bielx001@umn.edu</email></contrib><contrib id="A8" contrib-type="author"><name><surname>Bigio</surname><given-names>Irving</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I10">10</xref><email>bigio@bu.edu</email></contrib><contrib id="A9" contrib-type="author"><name><surname>Wong</surname><given-names>Brian JF</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I11">11</xref><email>bjwong@uci.edu</email></contrib><contrib id="A10" contrib-type="author"><name><surname>Gillenwater</surname><given-names>Ann</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I12">12</xref><email>agillenw@mdanderson.org</email></contrib><contrib id="A11" contrib-type="author"><name><surname>MacRobert</surname><given-names>Alexander J</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I13">13</xref><email>a.macrobert@ucl.ac.uk</email></contrib><contrib id="A12" contrib-type="author"><name><surname>Robinson</surname><given-names>Dominic J</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I14">14</xref><email>d.robinson@erasmusmc.nl</email></contrib><contrib id="A13" contrib-type="author"><name><surname>Betz</surname><given-names>Christian S</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I15">15</xref><email>christian.betz@med.uni-muenchen.de</email></contrib><contrib id="A14" contrib-type="author"><name><surname>Stepp</surname><given-names>Herbert</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I16">16</xref><email>Herbert.Stepp@med.uni-muenchen.de</email></contrib><contrib id="A15" contrib-type="author"><name><surname>Bolotine</surname><given-names>Lina</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I17">17</xref><email>l.bolotine@nancy.fnclcc.fr</email></contrib><contrib id="A16" contrib-type="author"><name><surname>McKenzie</surname><given-names>Gordon</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I2">2</xref><xref ref-type="aff" rid="I18">18</xref><email>gordon.mckenzie@md-ltd.co.uk</email></contrib><contrib id="A17" contrib-type="author"><name><surname>Mosse</surname><given-names>Charles Alexander</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I13">13</xref><email>smosse@medphys.ucl.ac.uk</email></contrib><contrib id="A18" contrib-type="author"><name><surname>Barr</surname><given-names>Hugh</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I19">19</xref><email>hugh.barr@glos.nhs.uk</email></contrib><contrib id="A19" contrib-type="author"><name><surname>Chen</surname><given-names>Zhongping</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I20">20</xref><email>z2chen@uci.edu</email></contrib><contrib id="A20" contrib-type="author"><name><surname>Berg</surname><given-names>Kristian</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I21">21</xref><email>kristian.berg@rr-research.no</email></contrib><contrib id="A21" contrib-type="author"><name><surname>D'Cruz</surname><given-names>Anil K</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I22">22</xref><email>docdcruz@gmail.com</email></contrib><contrib id="A22" contrib-type="author"><name><surname>Stone</surname><given-names>Nicholas</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I19">19</xref><email>n.stone@medical-research-centre.com</email></contrib><contrib id="A23" contrib-type="author"><name><surname>Kendall</surname><given-names>Catherine</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I19">19</xref><email>c.kendall@medical-research-centre.com</email></contrib><contrib id="A24" contrib-type="author"><name><surname>Fisher</surname><given-names>Sheila</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I23">23</xref><email>s.e.fisher@doctors.org.uk</email></contrib><contrib id="A25" contrib-type="author"><name><surname>Leunig</surname><given-names>Andreas</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I15">15</xref><email>andreas.leunig@med.uni-muenchen.de</email></contrib><contrib id="A26" contrib-type="author"><name><surname>Olivo</surname><given-names>Malini</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I24">24</xref><email>dmsmcd@nccs.com.sg</email></contrib><contrib id="A27" contrib-type="author"><name><surname>Richards-Kortum</surname><given-names>Rebecca</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I25">25</xref><email>rkortum@rice.edu</email></contrib><contrib id="A28" contrib-type="author"><name><surname>Soo</surname><given-names>Khee Chee</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I26">26</xref><email>admskc@nccs.com.sg</email></contrib><contrib id="A29" contrib-type="author"><name><surname>Bagnato</surname><given-names>Vanderlei</given-names></name><xref ref-type="aff" rid="I1">1</xref>