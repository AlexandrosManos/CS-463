</lpage><pub-id pub-id-type="pmid">18217762</pub-id></element-citation></ref><ref id="B5"><label>5</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hwang</surname><given-names>GT</given-names></name><name><surname>Romesberg</surname><given-names>FE</given-names></name></person-group><article-title>The unnatural substrate repertoire of A, B, and X family DNA polymerases</article-title><source>J. Am. Chem. Soc.</source><year>2008</year><volume>130</volume><fpage>14872</fpage><lpage>14882</lpage><pub-id pub-id-type="pmid">18847263</pub-id></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Seo</surname><given-names>YJ</given-names></name><name><surname>Hwang</surname><given-names>GT</given-names></name><name><surname>Ordoukhanian</surname><given-names>P</given-names></name><name><surname>Romesberg</surname><given-names>FE</given-names></name></person-group><article-title>Optimization of an unnatural base pair towards natural-like replication</article-title><source>J. Am. Chem. Soc.</source><year>2009</year><volume>131</volume><fpage>3246</fpage><lpage>3252</lpage><pub-id pub-id-type="pmid">19256568</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mitsui</surname><given-names>T</given-names></name><name><surname>Kimoto</surname><given-names>M</given-names></name><name><surname>Harada</surname><given-names>Y</given-names></name><name><surname>Yokoyama</surname><given-names>S</given-names></name><name><surname>Hirao</surname><given-names>I</given-names></name></person-group><article-title>An efficient unnatural base pair for a base-pair-expanded transcription system</article-title><source>J. Am. Chem. Soc.</source><year>2005</year><volume>127</volume><fpage>8652</fpage><lpage>8658</lpage><pub-id pub-i