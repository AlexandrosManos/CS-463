ticle-title>The mortality of doctors in relation to their smoking habits; a preliminary report</article-title><source>British Medical Journal</source><year>1954</year><volume>1</volume><fpage>1451</fpage><lpage>1455</lpage><pub-id pub-id-type="doi">10.1136/bmj.1.4877.1451</pub-id></citation><citation citation-type="display-unstructured">Doll, R., &#x00026; Hill, A. B. (1954). The mortality of doctors in relation to their smoking habits; a preliminary report. British Medical Journal, 1, 1451&#x02013;1455. <pub-id pub-id-type="pmid">13160495</pub-id></citation></ref><ref id="CR9"><label>9.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Doll</surname><given-names>R</given-names></name><name><surname>Gray</surname><given-names>R</given-names></name><name><surname>Hafner</surname><given-names>B</given-names></name><name><surname>Peto</surname><given-names>R</given-names></name></person-group><article-title>Mortality in relation to smoking: 22&#x000a0;years' observations on female British doctors</article-title><source>British Medical Journal</source><year>1980</year><volume>280</volume><fpage>967</fpage><lpage>971</lpage><pub-id pub-id-type="doi">10.1136/bmj.280.6219.967</pub-id></citation><citation citation-type="display-unstructured">Doll, R., Gray, R., Hafner, B., &#x00026; Peto, R. (1980). Mortality in relation to smoking: 22&#x000a0;years' observations on female British doctors. British Medical Journal, 280, 967&#x02013;971. <pub-id pub-id-type="pmid">7417764</pub-id></citation></ref><ref id="CR10"><label>10.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Doll</surname><given-names>R</given-names></name><name><surname>Peto</surname><given-names>R</given-names></name><name><surname>Boreham</surname><given-names>J</given-names></name><name><surname>Sutherland</surname><given-names>I</given-names></name></person-group><article-title>Mortality in relation to smoking: 50&#