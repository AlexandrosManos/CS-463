></name><name><surname>Schultz</surname><given-names>RT</given-names></name><name><surname>Staib</surname><given-names>LH</given-names></name><name><surname>Duncan</surname><given-names>JS</given-names></name></person-group><article-title>Integrated intensity and point-feature nonrigid registration</article-title><conf-name>In: Proceedings of the 7th International Conference on Medical Image Computing and Computer-Assisted Intervention (MICCAI '04)</conf-name><conf-date>September 2004</conf-date><conf-loc>Saint-Malo, France</conf-loc><fpage>763</fpage><lpage>770</lpage></element-citation></ref><ref id="B27"><label>27</label><element-citation publication-type="confproc"><person-group person-group-type="author"><name><surname>Christensen</surname><given-names>GE</given-names></name><name><surname>Geng</surname><given-names>X</given-names></name><name><surname>Kuhl</surname><given-names>JG</given-names></name><etal/></person-group><article-title>Introduction to the nonrigid image registration evaluation project (NIREP)</article-title><conf-name>In: Proceedings of the 3rd International Workshop on Biomedical Image Registration (WBIR '06), vol. 4057</conf-name><conf-date>July 2006</conf-date><conf-loc>Utrecht, The Netherlands</conf-loc><fpage>128</fpage><lpage>135</lpage><comment><italic>Lecture Notes in Computer Science</italic>.</comment></element-citation></ref><ref id="B28"><label>28</label><element-citation publication-type="other"><person-group person-group-type="author"><name><surname>Christensen</surname><given-names>GE</given-names></name></person-group><article-title>NIREP</article-title><comment>2006, <ext-link ext-link-type="uri" xlink:href="http://www.nirep.org/">http://www.nirep.org/</ext-link>.</comment></element-citation></ref><ref id="B29"><label>29</label><element-citation publication-type="other"><person-group person-group-type="author"><name><surname>Shen</surname><given-names>D</given-names></name><name><surname>Davatzikos</surname><given-names>C</given-names></name></person-group><article-title>HAMMER</article-title><comment>2005, <ext-link ext-link-type="uri" xlink:href="http://www.rad.upenn.edu/sbia/rsoftware.html">http://www.rad.upenn.edu/sbia/rsoftware.html</ext-link>.</comment></element-citation></ref><ref id="B30"><label>30</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lo</surname><given-names>CH</given-names></name><name><surname>Don</surname><given-names>HS</given-names></name></person-group><article-title>3-D moment forms: their construction and application to object identification and positioning</article-title><source><italic>IEEE Transactions on Pattern Analysis and Machine Intelligence</italic></source><year>1989</year><volume>11</volume><issue>10</issue><fpage>1053</fpage><lpage>1064</lpage></element-citation></ref><ref id="B31"><label>31</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Goldszal</surname><given-names>AF</given-names></name><name><surname>Davatzikos</surname><given-names>C</given-names></name><name><surname>Pham</surname><given-names>DL</given-names></name><name><surname>Yan</surname><given-names>MXH</given-names></name><name><surname>Bryan</surname><given-names>RN</given-names></name><name><surname>Resnick</surname><given-names>SM</given-names></name></person-group><article-title>An image processing system for qualitative and quantitative volumetric analysis of brain images</article-title><source><italic>Journal of Computer Assisted Tomography</italic></source><year>1998</year><volume>22</volume><issue>5</issue><fpage>827</fpage><lpage>837</lpage><pub-id pub-id-type="pmid">9754125</pub-id></element-citation></ref><ref id="B32"><label>32</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Keys</surname><given-names>R</given-names></name></person-group><article-title>Cubic convolution interpolation for digital image processing</article-title><source><italic>IEEE Transactions on Acoustics, Speech, and Signal Processing</italic></source><year>1981</year><volume>29</volume><issue>6</issue><fpage>1153</fpage><lpage>1160</lpage></element-citation></ref><ref id="B33"><label>33</label><element-citation publication-type="book"><person-group person-group-type="editor"><name><surname>Gonzalez</surname><given-names>RC</given-names></name><name><surname>Woods</surname><given-names>RE</given-names></name></person-group><source><italic>Digital Image Processing</italic></source><year>2002</year><edition>2nd edition</edition><publisher-loc>Upper Saddle River, NJ, USA</publisher-loc><publisher-name>Prentice Hall</publisher-name></element-citation></ref><ref id="B34"><label>34</label><element-citation publication-type="confproc"><person-group person-group-type="author"><name><surname>Pham</surname><given-names>DL</given-names></name></person-group><article-title>Robust fuzzy segmentation of magnetic resonance images</article-title><conf-name>In: Proceedings of the 14th IEEE Symposium on Computer-Based Medical Systems (CBMS '01)</conf-name><conf-date>July 2001</conf-date><conf-loc>Bethesda, Md, USA</conf-loc><fpage>127</fpage><lpage>131</lpage></element-citation></ref><ref id="B35"><label>35</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Han</surname><given-names>X</given-names></name><name><surname>Pham</surname><given-names>DL</given-names></name><name><surname>Tosun</surname><given-names>D</given-names></name><name><surname>Rettmann</surname><given-names>ME</given-names></name><name><surname>Xu</surname><given-names>C</given-names></name><name><surname>Prince</surname><given-names>JL</given-names></name></person-group><article-title>CRUISE: cortical reconstruction using implicit surface evolution</article-title><source><italic>NeuroImage</italic></source><year>2004</year><volume>23</volume><issue>3</issue><fpage>997</fpage><lpage>1012</lpage><pub-id pub-id-type="pmid">15528100</pub-id></element-citation></ref><ref id="B36"><label>36</label><element-citation publication-type="confproc"><person-group person-group-type="author"><name><surname>Ruiz-Alzola</surname><given-names>J</given-names></name><name><surname>Suarez</surname><given-names>E</given-names></name><name><surname>Alberola-Lopez</surname><given-names>C</given-names></name><name><surname>Warfield</surname><given-names>S</given-names></name><name><surname>Westin</surname><given-names>C</given-names></name></person-group><article-title>Geostatistical medical image registration</article-title><conf-name>In: Proceedings of the 6th International Conference on Medical Image Computing and Computer-Assisted Intervention (MICCAI '03)</conf-name><conf-date>November 2003</conf-date><conf-loc>Montreal, Canada</conf-loc><fpage>894</fpage><lpage>901</lpage></element-citation></ref><ref id="B37"><label>37</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Briggs</surname><given-names>WL</given-names></name><name><surname>Henson</surname><given-names>VE</given-names></name><name><surname>McCormick</surname><given-names>SF</given-names></name></person-group><source><italic>A Multigrid Tutorial</italic></source><year>2000</year><edition>2nd edition</edition><publisher-loc>Philadelphia, Pa, USA</publisher-loc><publisher-name>SIAM</publisher-name></element-citation></ref><ref id="B38"><label>38</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Han</surname><given-names>X</given-names></name><name><surname>Xu</surname><given-names>C</given-names></name><name><surname>Prince</surname><given-names>JL</given-names></name></person-group><article-title>Fast numerical scheme for gradient vector flow computation using a multigrid method</article-title><source><italic>IET Image Processing</italic></source><year>2007</year><volume>1</volume><issu