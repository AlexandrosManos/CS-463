sup>90</sup>Y</td><td align="left" valign="top" rowspan="1" colspan="1">Yes</td><td align="left" valign="top" rowspan="1" colspan="1">Yes</td><td align="left" valign="top" rowspan="1" colspan="1">14</td><td align="left" valign="top" rowspan="1" colspan="1">70</td><td align="left" valign="top" rowspan="1" colspan="1">6.4</td></tr></tbody></table></table-wrap><table-wrap id="t2-btt-1-215" position="float"><label>Table 2</label><caption><p>First-line therapy in follicular lymphoma (FL) with sequential chemotherapy followed by radioimmunotherapy (RIT)</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" valign="top" rowspan="1" colspan="1">Author</th><th align="left" valign="top" rowspan="1" colspan="1">Chemotherapy</th><th align="left" valign="top" rowspan="1" colspan="1">RIT</th><th align="left" valign="top" rowspan="1" colspan="1">No. of patients</th><th align="left" valign="top" rowspan="1" colspan="1">CR</th></tr></thead><tbody><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b48-btt-1-215">Leonard et al 2005</xref></td><td align="left" valign="top" rowspan="1" colspan="1">F &#x000d7; 3</td><td align="left" valign="top" rowspan="1" colspan="1">I-131</td><td align="left" valign="top" rowspan="1" colspan="1">35</td><td align="left" valign="top" rowspan="1" colspan="1">86%</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b88-btt-1-215">Zinzani et al 2006</xref></td><td align="left" valign="top" rowspan="1" colspan="1">FM &#x000d7; 6</td><td align="left" valign="top" rowspan="1" colspan="1">Y-90</td><td align="left" valign="top" rowspan="1" colspan="1">19</td><td align="left" valign="top" rowspan="1" colspan="1">73%</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b62-btt-1-215">Press et al 2006</xref></td><td align="left" valign="top" rowspan="1" colspan="1">CHOP &#x000d7; 6</td><td align="left" valign="top" rowspan="1" colspan="1">I-131</td><td align="left" valign="top" rowspan="1" colspan="1">90</td><td align="left" valign="top" rowspan="1" colspan="1">69%</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b67-btt-1-215">Shipley et al 2004</xref></td><td align="left" valign="top" rowspan="1" colspan="1">CHOP-R &#x000d7; 3</td><td align="left" valign="top" rowspan="1" colspan="1">Y-90</td><td align="left" valign="top" rowspan="1" colspan="1">22</td><td align="left" valign="top" rowspan="1" colspan="1">86%</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b50-btt-1-215">Link et al 2004</xref></td><td align="left" valign="top" rowspan="1" colspan="1">CVP &#x000d7; 6</td><td align="left" valign="top" rowspan="1" colspan="1">I-131</td><td align="left" valign="top" rowspan="1" colspan="1">30</td><td align="left" valign="top" rowspan="1" colspan="1">80%</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b34-btt-1-215">Jankowitz et al 2007</xref></td><td align="left" valign="top" rowspan="1" colspan="1">CHOP-R &#x000d7; 3<break/>R &#x000d7; 4</td><td align="left" valign="top" rowspan="1" colspan="1">Y-90</td><td align="left" valign="top" rowspan="1" colspan="1">60</td><td align="left" valign="top" rowspan="1" colspan="1">90%</td></tr></tbody></table></table-wrap></floats-group></article>