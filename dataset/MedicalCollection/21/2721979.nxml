td></tr><tr><td align="left" rowspan="1" colspan="1">GH97</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">47</td><td align="left" rowspan="1" colspan="1">67</td><td align="left" rowspan="1" colspan="1">59</td><td align="left" rowspan="1" colspan="1">20</td></tr><tr><td align="left" rowspan="1" colspan="1">GH105</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">ND</td><td align="left" rowspan="1" colspan="1">ND</td><td align="left" rowspan="1" colspan="1">ND</td><td align="left" rowspan="1" colspan="1">ND</td></tr><tr><td align="left" rowspan="1" colspan="1">GH106</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">11</td><td align="left" rowspan="1" colspan="1">4</td></tr><tr><td align="left" rowspan="1" colspan="1">Total GH</td><td align="left" rowspan="1" colspan="1">70</td><td align="left" rowspan="1" colspan="1">101</td><td align="left" rowspan="1" colspan="1">1108</td><td align="left" rowspan="1" colspan="1">1005</td><td align="left" rowspan="1" colspan="1">1105</td><td align="left" rowspan="1" colspan="1">610</td></tr></tbody></table></alternatives></table-wrap><table-wrap id="pone-0006650-t003" position="float"><object-id pub-id-type="doi">10.1371/journal.pone.0006650.t003</object-id><label>Table 3</label><caption><title>Comparison of copy numbers of carbohydrate active enzyme families in the genomes of <italic>R. flavefaciens</italic> FD-1 (<italic>Rf</italic>) and <italic>Clostridium thermocellum</italic> (<italic>Ct</italic>), and the pyrosequenced rumen metagenome.</title></caption><alternatives><graphic id="pone-0006650-t003-3" xlink:href="pone.0006650.t003"/><table frame="hsides" rules="groups"><col