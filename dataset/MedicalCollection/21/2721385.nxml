" colspan="1">NM003811</td><td align="left" rowspan="1" colspan="1">TNFSF9</td><td align="left" rowspan="1" colspan="1">4-1BB-L</td><td align="left" rowspan="1" colspan="1">Tumor necrosis factor (ligand) superfamily member, 9</td><td align="left" rowspan="1" colspan="1"><xref ref-type="table-fn" rid="tfn2-btt-2-547">+</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">NM001561</td><td align="left" rowspan="1" colspan="1">TNFRSF9</td><td align="left" rowspan="1" colspan="1">4-1BB</td><td align="left" rowspan="1" colspan="1">Tumor necrosis factor receptor superfamily member, 9</td><td align="left" rowspan="1" colspan="1"><xref ref-type="table-fn" rid="tfn4-btt-2-547">+++</xref></td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"><bold>Stress &#x00026; Toxicity Panel for Monitoring the Type of Stress Induced</bold></td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">NM002983</td><td align="left" rowspan="1" colspan="1">CCL3</td><td align="left" rowspan="1" colspan="1">MIP-1a/SCYA3</td><td align="left" rowspan="1" colspan="1">Chemokine (C-C motif) ligane 3 (Macrophage inflammatory protein 1-alpha)</td><td align="left" rowspan="1" colspan="1"><xref ref-type="table-fn" rid="tfn2-btt-2-547">+</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">NM021027</td><td align="left" rowspan="1" colspan="1">UGT1A9</td><td align="left" rowspan="1" colspan="1">UGT1A9</td><td align="left" rowspan="1" colspan="1">UDP glycosyltransferase 1 family, polypeptide A9</td><td align="left" rowspan="1" colspan="1"><xref ref-type="table-fn" rid="tfn3-btt-2-547">++</xref></td></tr></tbody></table><table-wrap-foot><fn id="tfn1-btt-2-547"><p>cDNA microarrays were performed to analyze the gene expression of transduced HUVECs. PI3K/Akt related gene levels were enhanced in Td/hTERTs compared with Td/mocks.</p></fn><fn id="tfn2-btt-2-547"><p>+: 2- to &#x0003c; 4-fold up-regulation in Td/hTERT,</p></fn><fn id="tfn3-btt-2-547"><p>++: 4- to &#x0003c; 10-fold up-regulation in Td/hTERT,</p></fn><fn id="tfn4-btt-2-547"><p>+++: 10- or &#x0003e; 10-fold up-regulation in Td/hTERT compared with Td/mock.</p></fn></table-wrap-foot></table-wrap></floats-group></article>