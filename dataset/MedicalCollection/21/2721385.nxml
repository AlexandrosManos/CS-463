7"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Haendeler</surname><given-names>J</given-names></name><name><surname>Hoffmann</surname><given-names>J</given-names></name><name><surname>Diehl</surname><given-names>JF</given-names></name><etal/></person-group><year>2004</year><article-title>Antioxidants inhibit nuclear export of telomerase reverse transcriptase and delay replicative senescence of endothelial cells</article-title><source>Circ Res</source><volume>94</volume><fpage>703</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">15059938</pub-id></mixed-citation></ref><ref id="b13-btt-2-547"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Harley</surname><given-names>CB</given-names></name><name><surname>Futcher</surname><given-names>AB</given-names></name><name><surname>Greider</surname><given-names>CW</given-names></name></person-group><year>1990</year><article-title>Telomerase shorten during ageing of human fibroblasts</article-title><source>Nature</source><volume>345</volume><fpage>458</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">2342578</pub-id></mixed-citation></ref><ref id="b14-btt-2-547"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hastie</surname><given-names>ND</given-names></name><name><surname>Dempster</surname><given-names>M</given-names></name><name><surname>Dunlop</surname><given-names>MG</given-names></name></person-group><year>1990</year><article-title>Telomere reduction in human colorectal carcinoma and with aging</article-title><source>Nature</source><volume>346</volume><fpage>866</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">2392154</pub-id></mixed-citation></ref><ref id="b15-btt-2-547"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jiang</surname><given-names>XR</given-names></name><name><surname>Jimenez</surname><given-names>G