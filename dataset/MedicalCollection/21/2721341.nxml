-citation></ref><ref id="b18-btt-1-59"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bolton</surname><given-names>WK</given-names></name><name><surname>Spargo</surname><given-names>BA</given-names></name><name><surname>Lewis</surname><given-names>EJ</given-names></name></person-group><year>1974</year><article-title>Chronic autologous immune complex glomerulopathy: effect of cyproheptadine</article-title><source>J Lab Clin Med</source><volume>83</volume><fpage>695</fpage><lpage>704</lpage><pub-id pub-id-type="pmid">4821854</pub-id></mixed-citation></ref><ref id="b19-btt-1-59"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Casali</surname><given-names>P</given-names></name><name><surname>Notkins</surname><given-names>AL</given-names></name></person-group><year>1989</year><article-title>CD5+ B lymphocytes, polyreactive antibodies and the human B-cell repertoire</article-title><source>Immunol Today</source><volume>10</volume><fpage>364</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">2482031</pub-id></mixed-citation></ref><ref id="b20-btt-1-59"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cattran</surname><given-names>DC</given-names></name></person-group><year>1988</year><article-title>Effect of ciclosporin on active Heymann nephritis</article-title><source>Nephron</source><volume>48</volume><fpage>142</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">3344054</pub-id></mixed-citation></ref><ref id="b21-btt-1-59"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>ZJ</given-names></name><name><surname>Wheeler</surname><given-names>J</given-names></name><name><surname>Notkins</surname><given-names>AL</given-names></name></person-group><year>1995</year><article-title>Antigen-binding B cells and polyreactive antibodies</article-title><source>E