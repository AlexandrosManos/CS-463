e>206</volume><issue>4&#x02013;5</issue><fpage>387</fpage><lpage>394</lpage><pub-id pub-id-type="pmid">12971694</pub-id></mixed-citation></ref><ref id="b9-ehp-117-1244"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Daniels</surname><given-names>JL</given-names></name><name><surname>Longnecker</surname><given-names>MP</given-names></name><name><surname>Klebanoff</surname><given-names>MA</given-names></name><name><surname>Gray</surname><given-names>KA</given-names></name><name><surname>Brock</surname><given-names>JW</given-names></name><name><surname>Zhou</surname><given-names>H</given-names></name><etal/></person-group><year>2003</year><article-title>Prenatal exposure to low-level polychlorinated biphenyls in relation to mental and motor development at 8 months</article-title><source>Am J Epidemiol</source><volume>157</volume><issue>6</issue><fpage>485</fpage><lpage>492</lpage><pub-id pub-id-type="pmid">12631537</pub-id></mixed-citation></ref><ref id="b10-ehp-117-1244"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Finklea</surname><given-names>J</given-names></name><name><surname>Priester</surname><given-names>LE</given-names></name><name><surname>Creason</surname><given-names>JP</given-names></name><name><surname>Hauser</surname><given-names>T</given-names></name><name><surname>Hinners</surname><given-names>T</given-names></name><name><surname>Hammer</surname><given-names>DI</given-names></name></person-group><year>1972</year><article-title>Polychlorinated biphenyl residues in human plasma expose a major urban pollution problem</article-title><source>Am J Public Health</source><volume>62</volume><issue>5</issue><fpage>645</fpage><lpage>651</lpage><pub-id pub-id-type="pmid">4623477</pub-id></mixed-citation></ref><ref id="b11-ehp-117-1244"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gallenberg</surname><given-