><given-names>GH</given-names></name></person-group><article-title>A prospective clinical trial of pulse therapy with glucocorticoid and cyclophosphamide in moderate to severe paraquat-poisoned patients</article-title><source>Am J Respir Crit Care Med</source><year>1999</year><volume>159</volume><fpage>357</fpage><lpage>360</lpage><pub-id pub-id-type="pmid">9927343</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Webb</surname><given-names>DB</given-names></name><name><surname>Williams</surname><given-names>MV</given-names></name><name><surname>Davies</surname><given-names>BH</given-names></name><name><surname>James</surname><given-names>KW</given-names></name></person-group><article-title>Resolution after radiotherapy of severe pulmonary damage due to paraquat poisoning</article-title><source>Br Med J (Clin Res Ed)</source><year>1984</year><volume>288</volume><fpage>1259</fpage><lpage>1260</lpage></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>SH</given-names></name><name><surname>Lee</surname><given-names>KS</given-names></name><name><surname>Ahn</surname><given-names>JM</given-names></name><name><surname>Kim</surname><given-names>SH</given-names></name><name><surname>Hong</surname><given-names>SY</given-names></name></person-group><article-title>Paraquat poisoning of the lung: thin-section CT findings</article-title><source>Radiology</source><year>1995</year><volume>195</volume><fpage>271</fpage><lpage>274</lpage><pub-id pub-id-type="pmid">7892484</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hong</surname><given-names>SY</given-names></name><name><surname>Gil</surname><given-names>HW</given-names></