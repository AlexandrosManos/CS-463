-type="journal"><person-group person-group-type="author"><name><surname>Zain</surname><given-names>RB</given-names></name><name><surname>Ikeda</surname><given-names>N</given-names></name><name><surname>Razak</surname><given-names>IA</given-names></name><etal/></person-group><article-title>A national epidemiological survey of oral mucosal lesions in Malaysia</article-title><source>Commun Dent Oral Epidemiol</source><year>1997</year><volume>25</volume><fpage>377</fpage><lpage>83</lpage></element-citation></ref><ref id="R7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kovac-Kovacic</surname><given-names>M</given-names></name><name><surname>Skaleric</surname><given-names>U</given-names></name></person-group><article-title>The prevalence of oral mucosal lesions in a population in Ljubljana, Slovenia</article-title><source>J Oral Pathol Med</source><year>2000</year><volume>29</volume><fpage>331</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">10947249</pub-id></element-citation></ref><ref id="R8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lin</surname><given-names>HC</given-names></name><name><surname>Corbet</surname><given-names>EF</given-names></name><name><surname>Lo</surname><given-names>EC</given-names></name></person-group><article-title>Oral mucosal lesions in adult Chinese</article-title><source>J Dent Res</source><year>2001</year><volume>80</volume><fpage>1486</fpage><lpage>90</lpage><pub-id pub-id-type="pmid">11437225</pub-id></element-citation></ref><ref id="R9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Satorres</surname><given-names>NM</given-names></name><name><surname>Faura</surname><given-names>SM</given-names></name><name><surname>Bresco</surname><given-names>SM</given-names></name><name><surname>Berini</surname><given-names>AL</given-nam