pmid">19422676</pub-id><pub-id pub-id-type="doi">10.1186/1756-9966-28-61</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cain</surname><given-names>DM</given-names></name><name><surname>Wacnik</surname><given-names>PW</given-names></name><name><surname>Eikmeier</surname><given-names>L</given-names></name><name><surname>Beitz</surname><given-names>A</given-names></name><name><surname>Wilcox</surname><given-names>GL</given-names></name><name><surname>Simone</surname><given-names>DA</given-names></name></person-group><article-title>Functional interactions between tumor and peripheral nerve in a model of cancer pain in the mouse</article-title><source>Pain Med</source><year>2001</year><volume>2</volume><issue>1</issue><fpage>15</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">15102313</pub-id><pub-id pub-id-type="doi">10.1046/j.1526-4637.2001.002001015.x</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schrijvers</surname><given-names>D</given-names></name></person-group><article-title>Pain control in cancer: recent findings and trends</article-title><source>Ann Oncol</source><year>2007</year><volume>18</volume><issue>Suppl 9</issue><fpage>ix37</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">17631594</pub-id><pub-id pub-id-type="doi">10.1093/annonc/mdm292</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Khosravi Shahi</surname><given-names>P</given-names></name><name><surname>Del Castillo Rueda</surname><given-names>A</given-names></name><name><surname>Perez Manga</surname><given-names>G</given-names></name></person-group><article-title>[Management of cancer pain.]</article-title><source>An Med Interna</source><year>2007</year><volume>24</volume><issue>11</issue><fpage>553</fpage><lpage>556</lpage></citation></ref><ref id="B8"><cit