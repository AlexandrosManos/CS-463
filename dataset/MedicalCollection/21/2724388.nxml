doi">10.1016/S0166-2236(02)00006-1</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Park</surname><given-names>IB</given-names></name><name><surname>Ahn</surname><given-names>CB</given-names></name><name><surname>Choi</surname><given-names>BT</given-names></name></person-group><article-title>Effects of electroacupuncture with different frequencies on the glycoconjugate alterations in articular cartilage in the ankle joints of complete Freund's adjuvant-injected rats</article-title><source>Am J Chin Med</source><year>2006</year><volume>34</volume><issue>3</issue><fpage>417</fpage><lpage>426</lpage><pub-id pub-id-type="pmid">16710891</pub-id><pub-id pub-id-type="doi">10.1142/S0192415X06003953</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kuai</surname><given-names>L</given-names></name><name><surname>Chen</surname><given-names>H</given-names></name><name><surname>Yang</surname><given-names>HY</given-names></name></person-group><article-title>[Current status and prospect of acupuncture-moxibustion in treatment of cancer pain: a review]</article-title><source>Zhong Xi Yi Jie He Xue Bao</source><year>2008</year><volume>6</volume><issue>2</issue><fpage>197</fpage><lpage>202</lpage><pub-id pub-id-type="pmid">18241659</pub-id><pub-id pub-id-type="doi">10.3736/jcim20080219</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shimoyama</surname><given-names>M</given-names></name><name><surname>Tatsuoka</surname><given-names>H</given-names></name><name><surname>Ohtori</surname><given-names>S</given-names></name><name><surname>Tanaka</surname><given-names>K</given-names></name><name><surname>Shimoyama</surname><given-names>N</given-names></name></person-group><article-title>Change of dorsal horn neurochemistry in a mouse model of neuropathic c