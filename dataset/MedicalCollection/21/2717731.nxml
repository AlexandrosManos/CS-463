/article-title><source>Proc Natl Acad Sci U S A</source><volume>102 </volume><issue>37</issue><fpage>13182</fpage><year>2005</year><pub-id pub-id-type="pmid">16141325</pub-id></citation></ref><ref id="R24"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Difilippantonio</surname><given-names>S</given-names></name><etal/></person-group><article-title>Role of Nbs1 in the activation of the Atm kinase revealed in humanized mouse models</article-title><source>Nat Cell Biol</source><volume>7 </volume><issue>7</issue><fpage>675</fpage><year>2005</year><pub-id pub-id-type="pmid">15965469</pub-id></citation></ref></ref-list></back></article>