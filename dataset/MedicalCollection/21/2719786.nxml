l><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Manthey</surname><given-names>JA</given-names></name><name><surname>Grohmann</surname><given-names>K</given-names></name><name><surname>Montanari</surname><given-names>A</given-names></name><name><surname>Ash</surname><given-names>K</given-names></name><name><surname>Manthey</surname><given-names>CL</given-names></name></person-group><article-title>Polymethoxylated flavones derived from citrus suppress tumor necrosis factor-<italic>&#x003b1;</italic> expression by human monocytes</article-title><source><italic>Journal of Natural Products</italic></source><year>1999</year><volume>62</volume><issue>3</issue><fpage>441</fpage><lpage>444</lpage><pub-id pub-id-type="pmid">10096854</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Murakami</surname><given-names>A</given-names></name><name><surname>Nakamura</surname><given-names>Y</given-names></name><name><surname>Torikai</surname><given-names>K</given-names></name><etal/></person-group><article-title>Inhibitory effect of citrus nobiletin on phorbol ester-induced skin inflammation, oxidative stress, and tumor promotion mice</article-title><source><italic>Cancer Research</italic></source><year>2000</year><volume>60</volume><issue>18</issue><fpage>5059</fpage><lpage>5066</lpage><pub-id pub-id-type="pmid">11016629</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Silalahi</surname><given-names>J</given-names></name></person-group><article-title>Anticancer and health protective properties of citrus fruit components</article-title><source><italic>Asia Pacific Journal of Clinical Nutrition</italic></source><year>2002</year><volume>11</volume><issue>1</issue><fpage>79</fpage><lpage>84</lpage><pub-id pu