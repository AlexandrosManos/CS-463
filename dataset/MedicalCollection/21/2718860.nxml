ame><surname>Demissie</surname><given-names>K</given-names></name><name><surname>Rhoads</surname><given-names>GG</given-names></name><name><surname>Walker</surname><given-names>M</given-names></name></person-group><article-title>Teenage pregnancy and adverse birth outcomes: a large population based retrospective cohort study</article-title><source>Int J Epidemiol</source><year>2007</year><volume>36</volume><fpage>368</fpage><lpage>73</lpage><pub-id pub-id-type="pmid">17213208</pub-id><pub-id pub-id-type="doi">10.1093/ije/dyl284</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barros</surname><given-names>FC</given-names></name><name><surname>Victora</surname><given-names>CG</given-names></name><name><surname>Matijasevich</surname><given-names>A</given-names></name><name><surname>Santos</surname><given-names>IS</given-names></name><name><surname>Horta</surname><given-names>BL</given-names></name><name><surname>Silveira</surname><given-names>MF</given-names></name><name><surname>Barros</surname><given-names>AJ</given-names></name></person-group><article-title>Preterm birth, low birth weight, and intrauterine growth restriction in three birth cohorts in Southern Brazil: 1982, 1993 and 2004</article-title><source>Cad Saude Publica</source><year>2008</year><volume>24</volume><fpage>s390</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">18797714</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Panagopoulos</surname><given-names>P</given-names></name><name><surname>Salakos</surname><given-names>N</given-names></name><name><surname>Bakalianou</surname><given-names>K</given-names></name><name><surname>Davou</surname><given-names>E</given-names></name><name><surname>Iavazzo</surname><given-names>C</given-names></name><name><surname>Paltoglou</surname><given-names>G</given-names></name><name><surname>Liapis</surname><given-names>A</given-names></name></person-group><article-title>Adolescent pregnancy in a Greek public hospital during a six-year period (2000&#x02013;2005)-a retrospective study</article-title><source>J pediatr Adolesc Gynecol</source><year>2008</year><volume>21</volume><fpage>265</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">18794021</pub-id><pub-id pub-id-type="doi">10.1016/j.jpag.2008.05.003</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Conde-Agudelo</surname><given-names>A</given-names></name><name><surname>Rosas-Berm&#x000fa;dez</surname><given-names>A</given-names></name><name><surname>Kafury-Goeta</surname><given-names>AC</given-names></name></person-group><article-title>Birth spacing and risk of adverse perinatal outcomes: a meta-analysis</article-title><source>JAMA</source><year>2006</year><volume>19;295</volume><fpage>1809</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">16622143</pub-id><pub-id pub-id-type="doi">10.1001/jama.295.15.1809</pub-id></citation></ref></ref-list></back></article>