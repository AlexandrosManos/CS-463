-title><source>Science</source><volume>311</volume><fpage>844</fpage><lpage>7</lpage><year>2006</year><pub-id pub-id-type="pmid">16469925</pub-id></element-citation></ref><ref id="R31"><label>31</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Robinson</surname><given-names>PJ</given-names></name><etal/></person-group><article-title>30 nm chromatin fibre decompaction requires both H4-K16 acetylation and linker histone eviction</article-title><source>J Mol Biol</source><volume>381</volume><fpage>816</fpage><lpage>25</lpage><year>2008</year><pub-id pub-id-type="pmid">18653199</pub-id></element-citation></ref><ref id="R32"><label>32</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bell</surname><given-names>O</given-names></name><etal/></person-group><article-title>Localized H3K36 methylation states define histone H4K16 acetylation during transcriptional elongation in <italic>Drosophila</italic></article-title><source>Embo J</source><volume>26</volume><fpage>4974</fpage><lpage>84</lpage><year>2007</year><pub-id pub-id-type="pmid">18007591</pub-id></element-citation></ref><ref id="R33"><label>33</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kind</surname><given-names>J</given-names></name><etal/></person-group><article-title>Genome-wide analysis reveals MOF as a key regulator of dosage compensation and gene expression in <italic>Drosophila</italic></article-title><source>Cell</source><volume>133</volume><fpage>813</fpage><lpage>28</lpage><year>2008</year><pub-id pub-id-type="pmid">18510926</pub-id></element-citation></ref><ref id="R34"><label>34</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Schwaiger</surname><given-names>M</given-names></name><etal/></person-group><article-title>Chromatin state marks cell-type- and gender-specific replication of the <italic>Drosophila</italic> genome</article-title><source>Genes Dev</source><volume>23</volume><fpage>589</fpage><lpage>601</lpage><year>2009</year><pub-id pub-id-type="pmid">19270159</pub-id></element-citation></ref><ref id="R35"><label>35</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Straub</surname><given-names>T</given-names></name><etal/></person-group><article-title>Stable chromosomal association of MSL2 defines a dosage-compensated nuclear compartment</article-title><source>Chromosoma</source><volume>114</volume><fpage>352</fpage><lpage>64</lpage><year>2005</year><pub-id pub-id-type="pmid">16179989</pub-id></element-citation></ref><ref id="R36"><label>36</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hamada</surname><given-names>FN</given-names></name><name><surname>Park</surname><given-names>PJ</given-names></name><name><surname>Gordadze</surname><given-names>PR</given-names></name><name><surname>Kuroda</surname><given-names>MI</given-names></name></person-group><article-title>Global regulation of X chromosomal genes by the MSL complex in <italic>Drosophila melanogaster</italic></article-title><source>Genes Dev</source><volume>19</volume><fpage>2289</fpage><lpage>94</lpage><year>2005</year><pub-id pub-id-type="pmid">16204180</pub-id></element-citation></ref><ref id="R37"><label>37</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>Z</given-names></name><etal/></person-group><article-title>Combinatorial patterns of histone acetylations and methylations in the human genome</article-title><source>Nat Genet</source><volume>40</volume><fpage>897</fpage><lpage>903</lpage><year>2008</year><pub-id pub-id-type="pmid">18552846</pub-id></element-citation></ref><ref id="R38"><label>38</label><element-citation publication-type="journal"><person-grou