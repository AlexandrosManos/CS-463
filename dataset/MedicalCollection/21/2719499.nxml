iven-names>N.</given-names></name><name><surname>Lee</surname><given-names>C.I.</given-names></name><name><surname>Laksanalamai</surname><given-names>P.</given-names></name><name><surname>Robb</surname><given-names>F.T.</given-names></name><name><surname>Baskakov</surname><given-names>I.V.</given-names></name></person-group><source>J. Mol. Biol.</source><year>2008</year><volume>376</volume><fpage>1155</fpage><lpage>1167</lpage><pub-id pub-id-type="pmid">18206163</pub-id></element-citation></ref><ref id="GZP026C16"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sunde</surname><given-names>M.</given-names></name><name><surname>Serpell</surname><given-names>L.C.</given-names></name><name><surname>Bartlam</surname><given-names>M.</given-names></name><name><surname>Fraser</surname><given-names>P.E.</given-names></name><name><surname>Pepys</surname><given-names>M.B.</given-names></name><name><surname>Blake</surname><given-names>C.C.</given-names></name></person-group><source>J. Mol. Biol.</source><year>1997</year><volume>273</volume><fpage>729</fpage><lpage>739</lpage><pub-id pub-id-type="pmid">9356260</pub-id></element-citation></ref><ref id="GZP026C17"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Tanaka</surname><given-names>M.</given-names></name><name><surname>Collins</surname><given-names>S.R.</given-names></name><name><surname>Toyama</surname><given-names>B.H.</given-names></name><name><surname>Weissman</surname><given-names>J.S.</given-names></name></person-group><source>Nature</source><year>2006</year><volume>442</volume><fpage>585</fpage><lpage>589</lpage><pub-id pub-id-type="pmid">16810177</pub-id></element-citation></ref><ref id="GZP026C18"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>van Raaij</surname><given-names>M.E.</given-names></name><name><surname>van Gestel</surname><given-names>J.</given-names></name><name><surname>Segers-Nolten</surname><given-names>I.M.</given-names></name><name><surname>de Leeuw</surname><given-names>S.W.</given-names></name><name><surname>Subramaniam</surname><given-names>V.</given-names></name></person-group><source>Biophys. J.</source><year>2008</year><volume>95</volume><fpage>4871</fpage><lpage>4878</lpage><pub-id pub-id-type="pmid">18676659</pub-id></element-citation></ref><ref id="GZP026C19"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Weibull</surname><given-names>W.</given-names></name></person-group><source>J. Appl. Mech. Trans. ASME</source><year>1951</year><volume>18</volume><fpage>293</fpage><lpage>297</lpage></element-citation></ref><ref id="GZP026C20"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>White</surname><given-names>H.E.</given-names></name><name><surname>Hodgkinson</surname><given-names>J.L.</given-names></name><name><surname>Jahn</surname><given-names>T.R.</given-names></name><name><surname>Cohen-Krausz</surname><given-names>S.</given-names></name><name><surname>Gosal</surname><given-names>W.S.</given-names></name><name><surname>Muller</surname><given-names>S.</given-names></name><name><surname>Orlova</surname><given-names>E.V.</given-names></name><name><surname>Radford</surname><given-names>S.E.</given-names></name><name><surname>Saibil</surname><given-names>H.R.</given-names></name></person-group><source>J. Mol. Biol</source><year>2009</year></element-citation></ref><ref id="GZP026C21"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Xue</surname><given-names>W.-F.</given-names></name><name><surname>Homans</surname><given-names>S.W.</given-names></name><name><surname>Radford</surname><given-names>S.E.</given-names></name></person-group><source>Proc. Natl Acad. Sci. USA</source><year>2008</year><volume>105</volume><fpage>8926</fpage><lpage>8931</lpage><pub-id pub-id-type="pmid">18579777</pub-id></element-citation></ref></ref-list><fn-group><fn><p><bold>Edited by Regina Murphy</bold></p></fn></fn-group></back></article>