on-type="journal"><person-group person-group-type="author"><name><surname>Bri&#x000f3;n</surname><given-names>M</given-names></name><name><surname>Salas</surname><given-names>A</given-names></name><name><surname>Gonz&#x000e1;lez-Neira</surname><given-names>A</given-names></name><name><surname>Lareu</surname><given-names>MV</given-names></name><name><surname>Carracedo</surname><given-names>&#x000c1;</given-names></name></person-group><year>2003</year><article-title>Insights into Iberian population origins through the construction of highly informative Y-chromosome haplotypes using biallelic markers, STRs, and the MSY1 minisatellite.</article-title><source>Am J Phys Anthropol</source><volume>122</volume><fpage>147</fpage><lpage>161</lpage><pub-id pub-id-type="pmid">12949835</pub-id></mixed-citation></ref><ref id="pone.0006583-Arredi1"><label>10</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Arredi</surname><given-names>B</given-names></name><name><surname>Poloni</surname><given-names>ES</given-names></name><name><surname>Paracchini</surname><given-names>S</given-names></name><name><surname>Zerjal</surname><given-names>T</given-names></name><name><surname>Fathallah</surname><given-names>DM</given-names></name><etal/></person-group><year>2004</year><article-title>A predominantly neolithic origin for Y-chromosomal DNA variation in North Africa.</article-title><source>Am J Hum Genet</source><volume>75</volume><fpage>338</fpage><lpage>345</lpage><pub-id pub-id-type="pmid">15202071</pub-id></mixed-citation></ref><ref id="pone.0006583-Cruciani1"><label>11</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cruciani</surname><given-names>F</given-names></name><name><surname>La Fratta</surname><given-names>R</given-names></name><name><surname>Santolamazza</surname><given-names>P</given-names></name><name><surname>Sellitto</surname><given-names>D</given-names></name>