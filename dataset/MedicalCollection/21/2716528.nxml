"><person-group person-group-type="author"><name><surname>Michiels</surname><given-names>S</given-names></name><name><surname>Laplanche</surname><given-names>A</given-names></name><name><surname>Boulet</surname><given-names>T</given-names></name><name><surname>Dessen</surname><given-names>P</given-names></name><name><surname>Guillonneau</surname><given-names>B</given-names></name><etal/></person-group><year>2009</year><article-title>Genetic polymorphisms in 85 DNA repair genes and bladder cancer risk.</article-title><source>Carcinogenesis</source><volume>30</volume><fpage>763</fpage><lpage>768</lpage><pub-id pub-id-type="pmid">19237606</pub-id></mixed-citation></ref><ref id="pone.0006493-Li1"><label>15</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>D</given-names></name><name><surname>Suzuki</surname><given-names>H</given-names></name><name><surname>Liu</surname><given-names>B</given-names></name><name><surname>Morris</surname><given-names>J</given-names></name><name><surname>Liu</surname><given-names>J</given-names></name><etal/></person-group><year>2009</year><article-title>DNA repair gene polymorphisms and risk of pancreatic cancer.</article-title><source>Clin Cancer Res</source><volume>15</volume><fpage>740</fpage><lpage>746</lpage><pub-id pub-id-type="pmid">19147782</pub-id></mixed-citation></ref><ref id="pone.0006493-Li2"><label>16</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>D</given-names></name><name><surname>Li</surname><given-names>Y</given-names></name><name><surname>Jiao</surname><given-names>L</given-names></name><name><surname>Chang</surname><given-names>DZ</given-names></name><name><surname>Beinart</surname><given-names>G</given-names></name><etal/></person-group><year>2007</year><article-title>Effects of base excision repair gene polymorphisms on pancreatic cancer survival.</article-title><source>Int J Cancer</source><volume>120</volume><fpage>1748</fpage><lpage>1754</lpage><pub-id pub-id-type="pmid">17230526</pub-id></mixed-citation></ref><ref id="pone.0006493-Sobol1"><label>17</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sobol</surname><given-names>RW</given-names></name><name><surname>Kartalou</surname><given-names>M</given-names></name><name><surname>Almeida</surname><given-names>KH</given-names></name><name><surname>Joyce</surname><given-names>DF</given-names></name><name><surname>Engelward</surname><given-names>BP</given-names></name><etal/></person-group><year>2003</year><article-title>Base Excision Repair Intermediates Induce p53-independent Cytotoxic and Genotoxic Responses.</article-title><source>Journal of Biological Chemistry</source><volume>278</volume><fpage>39951</fpage><lpage>39959</lpage><pub-id pub-id-type="pmid">12882965</pub-id></mixed-citation></ref><ref id="pone.0006493-Sobol2"><label>18</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sobol</surname><given-names>RW</given-names></name><name><surname>Watson</surname><given-names>DE</given-names></name><name><surname>Nakamura</surname><given-names>J</given-names></name><name><surname>Yakes</surname><given-names>FM</given-names></name><name><surname>Hou</surname><given-names>E</given-names></name><etal/></person-group><year>2002</year><article-title>Mutations associated with base excision repair deficiency and methylation-induced genotoxic stress.</article-title><source>Proceedings of the National Academy of Science</source><volume>99</volume><fpage>6860</fpage><lpage>6865</lpage></mixed-citation></ref><ref id="pone.0006493-Wood1"><label>19</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wood</surname><given-names>RD</given-names></name><name><surname>Mitchell</surname><given-names>M</given-names></na