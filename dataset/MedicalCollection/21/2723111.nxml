en-names>RC</given-names></name></person-group><article-title>Alcohol consumption and metabolic syndrome: does the type of beverage matter?</article-title><source>Obes Res</source><year>2004</year><volume>12</volume><fpage>1375</fpage><lpage>85</lpage><pub-id pub-id-type="pmid">15483202</pub-id><pub-id pub-id-type="doi">10.1038/oby.2004.174</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yoon</surname><given-names>YS</given-names></name><name><surname>Oh</surname><given-names>SW</given-names></name><name><surname>Baik</surname><given-names>HW</given-names></name><name><surname>Park</surname><given-names>HS</given-names></name><name><surname>Kim</surname><given-names>WY</given-names></name></person-group><article-title>Alcohol consumption and the metabolic syndrome in Korean adults: the 1998 Korean National Health and Nutrition Examination Survey</article-title><source>Am J Clin Nutr</source><year>2004</year><volume>80</volume><fpage>217</fpage><lpage>24</lpage><pub-id pub-id-type="pmid">15213051</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Linn</surname><given-names>S</given-names></name><name><surname>Carroll</surname><given-names>M</given-names></name><name><surname>Johnson</surname><given-names>C</given-names></name><name><surname>Fulwood</surname><given-names>R</given-names></name><name><surname>Kalsbeek</surname><given-names>W</given-names></name><name><surname>Briefel</surname><given-names>R</given-names></name></person-group><article-title>High-density lipoprotein cholesterol and alcohol consumption in US white and black adults: data from NHANES II</article-title><source>Am J Public Health</source><year>1993</year><volume>83</volume><fpage>811</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">8498617</pub-id><pub-id pub-id-type="doi">10.2105/AJPH.83.6.811</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matsuzawa</surname><given-names>Y</given-names></name></person-group><article-title>Metabolic syndrome-definition and diagnostic criteria in Japan</article-title><source>J Jpn Soc Int Med</source><year>2005</year><volume>94</volume><fpage>188</fpage><lpage>203</lpage></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moffatt</surname><given-names>RJ</given-names></name><name><surname>Owens</surname><given-names>SG</given-names></name></person-group><article-title>Cessation from cigarette smoking: changes in body weight, body composition, resting metabolism, and energy consumption</article-title><source>Metabolism</source><year>1991</year><volume>40</volume><fpage>465</fpage><lpage>70</lpage><pub-id pub-id-type="pmid">2023532</pub-id><pub-id pub-id-type="doi">10.1016/0026-0495(91)90225-L</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stamford</surname><given-names>BA</given-names></name><name><surname>Matter</surname><given-names>S</given-names></name><name><surname>Fell</surname><given-names>RD</given-names></name><name><surname>Papanek</surname><given-names>P</given-names></name></person-group><article-title>Effects of smoking cessation on weight gain, metabolic rate, caloric consumption, and blood lipids</article-title><source>Am J Clin Nutr</source><year>1986</year><volume>43</volume><fpage>486</fpage><lpage>94</lpage><pub-id pub-id-type="pmid">3962901</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferrara</surname><given-names>CM</given-names></name><name><surname>Kumar</surname><given-names>M</given-names></name><name><surname>Nicklas</surname><given-names>B</given-names></name><name><surname>McCrone</surname><given-names>S</given-names></name><name><surname>Goldberg</surname><given-names>AP</given-names></name></person-group><article-title>Weight gain and adipose tissue metabolism after smoking cessation in women</article-title><source>Int J Obes Relat Metab Disord</source><year>2001</year><volume>25</volume><fpage>1322</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">11571594</pub-id><pub-id pub-id-type="doi">10.1038/sj.ijo.0801716</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Perkins</surname><given-names>KA</given-names></name><name><surname>Epstein</surname><given-names>LH</given-names></name><name><surname>Marks</surname><given-names>BL</given-names></name><name><surname>Stiller</surname><given-names>RL</given-names></name><name><surname>Jacob</surname><given-names>RG</given-names></name></person-group><article-title>The effect of nicotine on energy expenditure during light physical activity</article-title><source>N Engl J Med</source><year>1989</year><volume>320</volume><fpage>898</fpage><lpage>903</lpage><pub-id pub-id-type="pmid">2927460</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Andersson</surname><given-names>K</given-names></name><name><surname>Arner</surname><given-names>P</given-names></name></person-group><article-title>Systemic nicotine stimulates human adipose tissue lipolysis through local cholinergic and catecholaminergic receptors</article-title><source>Int J Obes Relat Metab Disord</source><year>2001</year><volume>25</volume><fpage>1225</fpage><lpage>32</lpage><pub-id pub-id-type="pmid">11477508</pub-id><pub-id pub-id-type="doi">10.1038/sj.ijo.0801654</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Corella</surname><given-names>D</given-names></name><name><surname>Guill&#x000e9;n METS&#x000e1;iz</surname><given-names>C</given-names></name><name><surname>Portol&#x000e9;s</surname><given-names>O</given-names></name><name><surname>Sabater</surname><given-names>A</given-names></name><name><surname>Folch</surname><given-names>J</given-names></name><name><surname>Ordovas</surname><given-names>JM</given-names></name></person-group><article-title>Associations of LPL and APOC3 gene polymorphisms on plasma lipids in a Mediterranean population: interaction with tobacco smoking and the APOE locus</article-title><source>J Lipid Res</source><year>2002</year><volume>43</volume><fpage>416</fpage><lpage>27</lpage><pub-id pub-id-type="pmid">11893778</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Craig</surname><given-names>WY</given-names></name><name><surname>Palomaki</surname><given-names>GE</given-names></name><name><surname>Haddow</surname><given-names>JE</given-names></name></person-group><article-title>Cigarette smoking and serum lipid and lipoprotein concentrations: an analysis of published data</article-title><source>BMJ</source><year>1989</year><volume>298</volume><fpage>784</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">2496857</pub-id><pub-id pub-id-type="doi">10.1136/bmj.298.6676.784</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>DH</given-names></name><name><surname>Ha</surname><given-names>MH</given-names></name><name><surname>Kim</surname><given-names>JR</given-names></name><name><surname>Jacobs</surname><given-names>DR</given-names><suffix>Jr</suffix></name></person-group><article-title>Effects of smoking cessation on changes in blood pressure and incidence of hypertension: a 4-year follow-up study</article-title><source>Hypertension</source><year>2001</year><volume>37</volume><fpage>194</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">11230270</pub-id></citation></ref><ref id="B17"><citation citation-type="journal">