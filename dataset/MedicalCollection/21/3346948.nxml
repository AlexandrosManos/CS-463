-names></name></person-group><article-title>In vivo and in vitro investigations of the effects of the antimalarial drug dihydroartemisinin (DHA) on rat embryos</article-title><source>Reprod Toxicol</source><volume>22</volume><year>2006</year><fpage>797</fpage><lpage>810</lpage><pub-id pub-id-type="pmid">16959470</pub-id></element-citation></ref><ref id="bib9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>White</surname><given-names>TE</given-names></name><name><surname>Clark</surname><given-names>RL</given-names></name></person-group><article-title>Sensitive periods for developmental toxicity of orally administered artesunate in the rat</article-title><source>Birth Defects Res B Dev Reprod Toxicol</source><volume>83</volume><year>2008</year><fpage>407</fpage><lpage>417</lpage><pub-id pub-id-type="pmid">18615704</pub-id></element-citation></ref><ref id="bib10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Luxemburger</surname><given-names>C</given-names></name><name><surname>Ricci</surname><given-names>F</given-names></name><name><surname>Nosten</surname><given-names>F</given-names></name><name><surname>Raimond</surname><given-names>D</given-names></name><name><surname>Bathet</surname><given-names>S</given-names></name><name><surname>White</surname><given-names>NJ</given-names></name></person-group><article-title>The epidemiology of severe malaria in an area of low transmission in Thailand</article-title><source>Trans R Soc Trop Med Hyg</source><volume>91</volume><year>1997</year><fpage>256</fpage><lpage>262</lpage><pub-id pub-id-type="pmid">9231189</pub-id></element-citation></ref><ref id="bib11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nosten</surname><given-names>F</given-names></name><name><surname>McGready</surname><given-names>R</given-names></name><name><surname>Simpson</surname><given-names>JA</given-names></name></person-group><article-title>Effects of <italic>Plasmodium vivax</italic> malaria in pregnancy</article-title><source>Lancet</source><volume>354</volume><year>1999</year><fpage>546</fpage><lpage>549</lpage><pub-id pub-id-type="pmid">10470698</pub-id></element-citation></ref><ref id="bib12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nosten</surname><given-names>F</given-names></name><name><surname>ter Kuile</surname><given-names>F</given-names></name><name><surname>Maelankirri</surname><given-names>L</given-names></name><name><surname>Decludt</surname><given-names>B</given-names></name><name><surname>White</surname><given-names>NJ</given-names></name></person-group><article-title>Malaria during pregnancy in an area of unstable endemicity</article-title><source>Trans R Soc Trop Med Hyg</source><volume>85</volume><year>1991</year><fpage>424</fpage><lpage>429</lpage><pub-id pub-id-type="pmid">1836685</pub-id></element-citation></ref><ref id="bib13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dolan</surname><given-names>G</given-names></name><name><surname>ter Kuile</surname><given-names>F</given-names></name><name><surname>Jacoutot</surname><given-names>V</given-names></name></person-group><article-title>Bed nets for the prevention of malaria and anaemia in pregnancy</article-title><source>Trans R Soc Trop Med Hyg</source><volume>87</volume><year>1993</year><fpage>620</fpage><lpage>626</lpage><pub-id pub-id-type="pmid">8296357</pub-id></element-citation></ref><ref id="bib14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>McGready</surname><given-names>R</given-names></name><name><surname>Simpson</surname><given-names>JA</given-names></name><name><surname>Htway</surname><given-names>M</given-names></name><name><surname>White</surname><given-names>NJ</given-names></name><name><surname>Nosten</surname><given-names>F</given-names></name><name><surname>Lindsay</surname><given-names>SW</given-names></name></person-group><article-title>A double-blind randomized therapeutic trial of insect repellents for the prevention of malaria in pregnancy</article-title><source>Trans R Soc Trop Med Hyg</source><volume>95</volume><year>2001</year><fpage>137</fpage><lpage>138</lpage><pub-id pub-id-type="pmid">11355542</pub-id></element-citation></ref><ref id="bib15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nosten</surname><given-names>F</given-names></name><name><surname>ter Kuile</surname><given-names>F</given-names></name><name><surname>Maelankiri</surname><given-names>L</given-names></name></person-group><article-title>Mefloquine prophylaxis prevents malaria during pregnancy: a double-blind, placebo-controlled study</article-title><source>J Infect Dis</source><volume>169</volume><year>1994</year><fpage>595</fpage><lpage>603</lpage><pub-id pub-id-type="pmid">8158032</pub-id></element-citation></ref><ref id="bib16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>McGready</surname><given-names>R</given-names></name><name><surname>Nosten</surname><given-names>F</given-names></name></person-group><article-title>The Thai&#x02013;Burmese border: drug studies of <italic>Plasmodium falciparum</italic> in pregnancy</article-title><source>Ann Trop Med Parasitol</source><volume>93</volume><issue>suppl 1</issue><year>1999</year><fpage>S19</fpage><lpage>S23</lpage><pub-id pub-id-type="pmid">10715685</pub-id></element-citation></ref><ref id="bib17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nosten</surname><given-names>F</given-names></name><name><surname>van Vugt</surname><given-names>M</given-names></name><name><surname>Price</surname><given-names>R</given-names></name></person-group><article-title>Effects of artesunate-mefloquine combination on incidence of <italic>Plasmodium falciparum</italic> malaria and mefloquine resistance in western Thailand: a prospective study</article-title><source>Lancet</source><volume>356</volume><year>2000</year><fpage>297</fpage><lpage>302</lpage><pub-id pub-id-type="pmid">11071185</pub-id></element-citation></ref><ref id="bib18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Luxemburger</surname><given-names>C</given-names></name><name><surname>Nosten</surname><given-names>F</given-names></name><name><surname>Raimond</surname><given-names>SD</given-names></name><name><surname>Chongsuphajaisiddhi</surname><given-names>T</given-names></name><name><surname>White</surname><given-names>NJ</given-names></name></person-group><article-title>Oral artesunate in the treatment of uncomplicated hyperparasitemic falciparum malaria</article-title><source>Am J Trop Med Hyg</source><volume>53</volume><year>1995</year><fpage>522</fpage><lpage>525</lpage><pub-id pub-id-type="pmid">7485711</pub-id></element-citation></ref><ref id="bib19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>McGready</surname><given-names>R</given-names></name><name><surname>Cho</surname><given-names>T</given-names></name><name><surname>Cho</surname><given-names>JJ</given-names></name></person-group><article-title>Artemisinin derivatives in the treatment of falciparum malaria in pregnancy</article-title><source>Trans R Soc Trop Med Hyg</source><volume>92</volume><year>1998</year><fpage>430</fpage><lpage>433</lpage><pub-id pub-id-type="pmid">9850401</pub-id></element-citation></ref><ref id="bib20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="