e>33</volume><fpage>6486</fpage><lpage>6493</lpage><pub-id pub-id-type="pmid">16284202</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Al-Shahib</surname><given-names>A</given-names></name><name><surname>Breitling</surname><given-names>R</given-names></name><name><surname>Gilbert</surname><given-names>DR</given-names></name></person-group><article-title>Predicting protein function by machine learning on amino acid sequences &#x02013; a critical evaluation</article-title><source>BMC Genomics</source><year>2007</year><volume>8</volume><fpage>78</fpage><pub-id pub-id-type="pmid">17374164</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cai</surname><given-names>CZ</given-names></name><name><surname>Han</surname><given-names>LY</given-names></name><name><surname>Ji</surname><given-names>ZL</given-names></name><name><surname>Chen</surname><given-names>YZ</given-names></name></person-group><article-title>Enzyme family classification by support vector machines</article-title><source>Proteins</source><year>2004</year><volume>55</volume><fpage>66</fpage><lpage>76</lpage><pub-id pub-id-type="pmid">14997540</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garg</surname><given-names>A</given-names></name><name><surname>Gupta</surname><given-names>D</given-names></name></person-group><article-title>VirulentPred: a SVM based prediction method for virulent proteins in bacterial pathogens</article-title><source>BMC Bioinformatics</source><year>2008</year><volume>9</volume><fpage>62</fpage><pub-id pub-id-type="pmid">18226234</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Han</surname><given-names>LY</given-names></name><name><surname>Cai</surname><given-names>CZ</gi