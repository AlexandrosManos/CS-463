ub-id-type="doi">10.1002/1097-0142(196103/04)14:2&#x0003c;238::AID-CNCR2820140204&#x0003e;3.0.CO;2-F</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moertel</surname><given-names>CG</given-names></name></person-group><article-title>Multiple primary malignant neoplasms</article-title><source>Cancer</source><year>1977</year><volume>40</volume><fpage>1786</fpage><lpage>1792</lpage><pub-id pub-id-type="pmid">332330</pub-id><pub-id pub-id-type="doi">10.1002/1097-0142(197710)40:4+&#x0003c;1786::AID-CNCR2820400803&#x0003e;3.0.CO;2-2</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Slaughter</surname><given-names>DP</given-names></name><name><surname>Southwick</surname><given-names>HW</given-names></name><name><surname>Smejkal</surname><given-names>W</given-names></name></person-group><article-title>"Field cancerization" in oral stratified squamous epithelium</article-title><source>Cancer</source><year>1953</year><volume>6</volume><fpage>963</fpage><lpage>968</lpage><pub-id pub-id-type="pmid">13094644</pub-id><pub-id pub-id-type="doi">10.1002/1097-0142(195309)6:5&#x0003c;963::AID-CNCR2820060515&#x0003e;3.0.CO;2-Q</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Amemiya</surname><given-names>K</given-names></name><name><surname>Shibuya</surname><given-names>H</given-names></name><name><surname>Yoshimura</surname><given-names>R</given-names></name><name><surname>Okada</surname><given-names>N</given-names></name></person-group><article-title>The risk of radiation-induced cancer inpatients with squamous cell carcinoma of the head and neck and its results of treatment</article-title><source>Brit J Radiol</source><year>2005</year><volume>78</volume><fpage>1028</fpage><lpage>1033</lpage><pub-id pub-id-type="pmid">16249604</pub-id><pub-id pub-id-type="doi">10.1259/bjr/86352309</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Upton</surname><given-names>AC</given-names></name></person-group><article-title>The dose-response relation in radiation-induced cancer</article-title><source>Cancer Res</source><year>1961</year><volume>21</volume><fpage>717</fpage><lpage>729</lpage><pub-id pub-id-type="pmid">13779235</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Murray</surname><given-names>EM</given-names></name><name><surname>Werner</surname><given-names>D</given-names></name><name><surname>Greeff</surname><given-names>EA</given-names></name><name><surname>Deryck</surname><given-names>AT</given-names></name></person-group><article-title>Postradiation sarcomas:20 cases and a literature review</article-title><source>Int J Radiat Oncol Biol Phys </source><year>1999</year><volume>45</volume><fpage>951</fpage><lpage>961</lpage><pub-id pub-id-type="pmid">10571202</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Miyahara</surname><given-names>H</given-names></name><name><surname>Sato</surname><given-names>T</given-names></name><name><surname>Yoshino</surname><given-names>K</given-names></name></person-group><article-title>Radiation-induced cancer of the head and neck region</article-title><source>Acta Otolaryngol</source><year>1998</year><volume>533</volume><fpage>60</fpage><lpage>64</lpage><pub-id pub-id-type="doi">10.1080/00016489850183773</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Umatani</surname><given-names>K</given-names></name><name><surname>Satoh</surname><given-names>T</given-names></name><name><surname>Yoshino</surname><given-names>K</given-names></name><name><surname>Takagi</surname><give