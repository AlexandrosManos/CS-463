itle><source>J Virol</source><year>2009</year><volume>83</volume><fpage>2011</fpage><lpage>2014</lpage><pub-id pub-id-type="pmid">19052094</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ploss</surname><given-names>A</given-names></name><name><surname>Evans</surname><given-names>MJ</given-names></name><name><surname>Gaysinskaya</surname><given-names>VA</given-names></name><name><surname>Panis</surname><given-names>M</given-names></name><name><surname>You</surname><given-names>H</given-names></name><name><surname>de Jong</surname><given-names>YP</given-names></name><name><surname>Rice</surname><given-names>CM</given-names></name></person-group><article-title>Human occludin is a hepatitis C virus entry factor required for infection of mouse cells</article-title><source>Nature</source><year>2009</year><volume>457</volume><fpage>882</fpage><lpage>886</lpage><pub-id pub-id-type="pmid">19182773</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mee</surname><given-names>CJ</given-names></name><name><surname>Grove</surname><given-names>J</given-names></name><name><surname>Harris</surname><given-names>HJ</given-names></name><name><surname>Hu</surname><given-names>K</given-names></name><name><surname>Balfe</surname><given-names>P</given-names></name><name><surname>McKeating</surname><given-names>JA</given-names></name></person-group><article-title>Effect of cell polarization on hepatitis C virus entry</article-title><source>J Virol</source><year>2008</year><volume>82</volume><fpage>461</fpage><lpage>470</lpage><pub-id pub-id-type="pmid">17959672</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mee</surname><given-names>CJ</given-names></name><name><surname>Harris</surname><given-names>HJ</given-names></name><name><surname>Farquhar</surname><