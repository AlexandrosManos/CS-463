><name><surname>Baj</surname><given-names>Z</given-names></name><etal/></person-group><year>1996</year><article-title>Molecular insights into the anticoagulant-induced spontaneous activation of platelets in whole blood &#x02013; various anticoagulants are not equal</article-title><source>Thromb Res</source><volume>83</volume><fpage>199</fpage><lpage>216</lpage><pub-id pub-id-type="pmid">8840462</pub-id></mixed-citation></ref><ref id="b8-btt-2-563"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gordinier</surname><given-names>ME</given-names></name><name><surname>Zhang</surname><given-names>HZ</given-names></name><name><surname>Patenia</surname><given-names>R</given-names></name><etal/></person-group><year>1999</year><article-title>Quantitative analysis of transforming growth factor beta 1 and 2 in ovarian carcinoma</article-title><source>Clin Cancer Res</source><volume>5</volume><fpage>2498</fpage><lpage>505</lpage><pub-id pub-id-type="pmid">10499625</pub-id></mixed-citation></ref><ref id="b9-btt-2-563"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hazelbag</surname><given-names>S</given-names></name><name><surname>Kenter</surname><given-names>GG</given-names></name><name><surname>Gorter</surname><given-names>A</given-names></name><etal/></person-group><year>2004</year><article-title>Prognostic relevance of TGF-beta1 and PAI-1 in cervical cancer</article-title><source>Int J Cancer</source><volume>112</volume><fpage>1020</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">15386352</pub-id></mixed-citation></ref><ref id="b10-btt-2-563"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kang</surname><given-names>Y</given-names></name><name><surname>He</surname><given-names>W</given-names></name><name><surname>Tulley</surname><given-names>S</given-names></name><etal/></person-group><year>2005</year><article-title>Breast 