</lpage><pub-id pub-id-type="pmid">12767739</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(03)13366-1</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thomson</surname><given-names>M</given-names></name><name><surname>Indeje</surname><given-names>M</given-names></name><name><surname>Connor</surname><given-names>S</given-names></name><name><surname>Dilley</surname><given-names>M</given-names></name><name><surname>Ward</surname><given-names>N</given-names></name></person-group><article-title>Malaria early warning in Kenya and seasonal climate forecasts</article-title><source>Lancet</source><year>2003</year><volume>362</volume><fpage>580</fpage><pub-id pub-id-type="pmid">12932403</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(03)14135-9</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bouma</surname><given-names>MJ</given-names></name><name><surname>Kaay</surname><given-names>HJ van der</given-names></name></person-group><article-title>The El Nino Southern Oscillation and the historic malaria epidemics on the Indian subcontinent and Sri Lanka: an early warning system for future epidemics?</article-title><source>Trop Med Int Health</source><year>1996</year><volume>1</volume><fpage>86</fpage><lpage>96</lpage><pub-id pub-id-type="pmid">8673827</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-3156.1996.d01-7.x</pub-id></citation></ref><ref id="B19"><citation citation-type="other"><article-title>Worldclim</article-title><ext-link ext-link-type="uri" xlink:href="http://www.worldclim.org"/></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hijmans</surname><given-names>RJ</given-names></name><name><surname>Cameron</surname><given-names>SE</given-names></name><name><surname>Parra</surname><given-names>JL</given-names></name><name><surname>