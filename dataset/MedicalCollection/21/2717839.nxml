p53</article-title><source>Cancer Res</source><volume>58</volume><fpage>1090</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">9515785</pub-id></mixed-citation></ref><ref id="b13-bmi-2007-095"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dammann</surname><given-names>R</given-names></name><name><surname>Schagdarsurengin</surname><given-names>U</given-names></name><name><surname>Seidel</surname><given-names>C</given-names></name><etal/></person-group><year>2005</year><article-title>The tumor suppressor RASSF1A in human carcinogenesis: an update</article-title><source>Histol Histopathol</source><volume>20</volume><fpage>645</fpage><lpage>63</lpage><pub-id pub-id-type="pmid">15736067</pub-id></mixed-citation></ref><ref id="b14-bmi-2007-095"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Duggan</surname><given-names>DJ</given-names></name><name><surname>Bittner</surname><given-names>M</given-names></name><name><surname>Chen</surname><given-names>Y</given-names></name><name><surname>Meltzer</surname><given-names>P</given-names></name><name><surname>Trent</surname><given-names>JM</given-names></name></person-group><year>1999</year><article-title>Expression profiling using cDNA microarrays</article-title><source>Nat Genet</source><volume>21</volume><fpage>10</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">9915494</pub-id></mixed-citation></ref><ref id="b15-bmi-2007-095"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dulaimi</surname><given-names>E</given-names></name><name><surname>Uzzo</surname><given-names>RG</given-names></name><name><surname>Greenberg</surname><given-names>RE</given-names></name><name><surname>Al-Saleem</surname><given-names>T</given-names></name><name><surname>Cairns</surname><given-names>P</given-names></name></person-group><year>2004</year><article-title>Detection of bladder cancer in urine b