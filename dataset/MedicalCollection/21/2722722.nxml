1" colspan="1">5.0</td><td align="left" rowspan="1" colspan="1">4.9</td><td align="left" rowspan="1" colspan="1">&#x0003c;</td><td align="left" rowspan="1" colspan="1">6.3</td><td align="left" rowspan="1" colspan="1">&#x0003c;</td></tr><tr><td align="left" rowspan="1" colspan="1">Lung B<xref ref-type="table-fn" rid="nt120">d</xref></td><td align="left" rowspan="1" colspan="1">6.8</td><td align="left" rowspan="1" colspan="1">7.2</td><td align="left" rowspan="1" colspan="1">5.2</td><td align="left" rowspan="1" colspan="1">na</td><td align="left" rowspan="1" colspan="1">6.5</td><td align="left" rowspan="1" colspan="1">na</td><td align="left" rowspan="1" colspan="1">5.9</td><td align="left" rowspan="1" colspan="1">5.0</td><td align="left" rowspan="1" colspan="1">3.0</td><td align="left" rowspan="1" colspan="1">&#x0003c;</td><td align="left" rowspan="1" colspan="1">&#x0003c;</td><td align="left" rowspan="1" colspan="1">&#x0003c;</td></tr><tr><td align="left" rowspan="1" colspan="1">Lung C<xref ref-type="table-fn" rid="nt120">d</xref></td><td align="left" rowspan="1" colspan="1">6.8</td><td align="left" rowspan="1" colspan="1">na</td><td align="left" rowspan="1" colspan="1">5.3</td><td align="left" rowspan="1" colspan="1">&#x0003c;</td><td align="left" rowspan="1" colspan="1">6.3</td><td align="left" rowspan="1" colspan="1">4.2</td><td align="left" rowspan="1" colspan="1">3.0</td><td align="left" rowspan="1" colspan="1">4.7</td><td align="left" rowspan="1" colspan="1">4.5</td><td align="left" rowspan="1" colspan="1">&#x0003c;</td><td align="left" rowspan="1" colspan="1">1.2</td><td align="left" rowspan="1" colspan="1">&#x0003c;</td></tr><tr><td align="left" rowspan="1" colspan="1">Lung D<xref ref-type="table-fn" rid="nt120">d</xref></td><td align="left" rowspan="1" colspan="1">5.9</td><td align="left" rowspan="1" colspan="1">na</td><td align="left" rowspan="1" colspan="1">5.3</td><td align="left" rowspan="1" colspan="1">&#x0003c;</td><td align="left" rowspan="1" colspan="