"CIT8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Fantl</surname><given-names>JA</given-names></name><name><surname>Wyman</surname><given-names>JF</given-names></name><name><surname>McClish</surname><given-names>DK</given-names></name><name><surname>Harkins</surname><given-names>SW</given-names></name><name><surname>Elswick</surname><given-names>RK</given-names></name><name><surname>Taylor</surname><given-names>JR</given-names></name><etal/></person-group><article-title>Efficacy of bladder training in older women with urinary incontinence</article-title><source>JAMA</source><year>1991</year><volume>265</volume><fpage>609</fpage><lpage>13</lpage><pub-id pub-id-type="pmid">1987410</pub-id></element-citation></ref><ref id="CIT9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kegal</surname><given-names>AH</given-names></name></person-group><article-title>Progressive resistance exercise in the functional restoration of the perineal muscles</article-title><source>Am J Obstet Gynecol</source><year>1948</year><volume>56</volume><fpage>238</fpage><lpage>48</lpage><pub-id pub-id-type="pmid">18877152</pub-id></element-citation></ref><ref id="CIT10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kegal</surname><given-names>AH</given-names></name></person-group><article-title>Physiologic therapy for urinary stress incontinence</article-title><source>JAMA</source><year>1951</year><volume>146</volume><fpage>915</fpage><lpage>7</lpage></element-citation></ref><ref id="CIT11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Burgio</surname><given-names>KL</given-names></name><name><surname>Locher</surname><given-names>JL</given-names></name><name><surname>Goode</surname><given-names>PS</given-names></name><name><surname>Hardin</surname><given-names>MJ</given-names></name><name><surname>McDowell</surname><given-names>J</given-names></name><name><surname>Dombrowski</surname><given-names>M</given-names></name><etal/></person-group><article-title>Behavioral vs drug treatment for urge urinary incontinence in older women: A randomized controlled trial</article-title><source>JAMA</source><year>1998</year><volume>280</volume><fpage>1995</fpage><lpage>2000</lpage><pub-id pub-id-type="pmid">9863850</pub-id></element-citation></ref><ref id="CIT12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Burgio</surname><given-names>KL</given-names></name><name><surname>Goode</surname><given-names>PS</given-names></name><name><surname>Locher</surname><given-names>JL</given-names></name><name><surname>Umlauf</surname><given-names>MG</given-names></name><name><surname>Roth</surname><given-names>DL</given-names></name><name><surname>Richter</surname><given-names>HE</given-names></name><etal/></person-group><article-title>Behavioral training with and without biofeedback in the treatment of urge incontinence in older women: A randomized controlled trial</article-title><source>JAMA</source><year>2002</year><volume>288</volume><fpage>2293</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">12425706</pub-id></element-citation></ref><ref id="CIT13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hay-Smith</surname><given-names>EJ</given-names></name><name><surname>Dumoulin</surname><given-names>C</given-names></name></person-group><article-title>Pelvic floor muscle training versus no treatment or inactive control treatments, for urinary incontinence in women</article-title><source>Cochrane Database Syst Rev</source><year>2006</year><volume>1</volume><fpage>CD005654</fpage><pub-id pub-id-type="pmid">16437536</pub-id></element-citation></ref><ref id="CIT14"><l