r><tr><td rowspan="1" colspan="1">Age, years</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;15&#x02013;24</td><td rowspan="1" colspan="1">1,155</td><td rowspan="1" colspan="1">5,773</td><td align="char" char="." rowspan="1" colspan="1">0.20</td></tr><tr><td rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;25&#x02013;29</td><td rowspan="1" colspan="1">2,071</td><td rowspan="1" colspan="1">6,100</td><td align="char" char="." rowspan="1" colspan="1">0.34</td></tr><tr><td rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;30&#x02013;34</td><td rowspan="1" colspan="1">2,381</td><td rowspan="1" colspan="1">5,331</td><td align="char" char="." rowspan="1" colspan="1">0.45</td></tr><tr><td rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;35&#x02013;59</td><td rowspan="1" colspan="1">3,600</td><td rowspan="1" colspan="1">6,158</td><td align="char" char="." rowspan="1" colspan="1">0.58</td></tr></tbody></table></table-wrap><table-wrap id="tbla2" position="anchor"><label>Appendix Table 2.</label><caption><p>Parameter Estimates From a Classical Logistic Regression Model With Lowest AIC Statistic for Injecting Drug Users, England and Wales, 1992&#x02013;2006</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="center" rowspan="1" colspan="1">Parameter</td><td align="center" rowspan="1" colspan="1">Estimate</td><td align="center" rowspan="1" colspan="1">Standard Error</td><td align="center" rowspan="1" colspan="1"><italic>z</italic> Value</td><td align="center" rowspan="1" colspan="1"><italic>P</italic> Value</td></tr></thead><tbody><tr><td rowspan="1" colspan="1">Intercept</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.105</td><td align="char" char="." rowspan="1" colspan="1">0.058</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;1.82</td><td align="char" char="." rowspan="1" colspan=