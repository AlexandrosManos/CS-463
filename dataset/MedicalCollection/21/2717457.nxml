le><source>Shock</source><year>2007</year><volume>28</volume><fpage>265</fpage><lpage>269</lpage><pub-id pub-id-type="pmid">17529910</pub-id><pub-id pub-id-type="doi">10.1097/01.shk.0000235090.30550.fb</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Young</surname><given-names>JD</given-names></name></person-group><article-title>The heart and circulation in severe sepsis</article-title><source>Br J Anaesth</source><year>2004</year><volume>93</volume><fpage>114</fpage><lpage>120</lpage><pub-id pub-id-type="pmid">15121730</pub-id><pub-id pub-id-type="doi">10.1093/bja/aeh171</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cuenca</surname><given-names>J</given-names></name><name><surname>Martin-Sanz</surname><given-names>P</given-names></name><name><surname>varez-Barrientos</surname><given-names>AM</given-names></name><name><surname>Bosca</surname><given-names>L</given-names></name><name><surname>Goren</surname><given-names>N</given-names></name></person-group><article-title>Infiltration of inflammatory cells plays an important role in matrix metalloproteinase expression and activation in the heart during sepsis</article-title><source>Am J Pathol</source><year>2006</year><volume>169</volume><fpage>1567</fpage><lpage>1576</lpage><pub-id pub-id-type="pmid">17071581</pub-id><pub-id pub-id-type="doi">10.2353/ajpath.2006.060109</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fernandes</surname><given-names>CJ</given-names><suffix>Junior</suffix></name><name><surname>Iervolino</surname><given-names>M</given-names></name><name><surname>Neves</surname><given-names>RA</given-names></name><name><surname>Sampaio</surname><given-names>EL</given-names></name><name><surname>Knobel</surname><given-names>E</given-names></name></person-group><article-