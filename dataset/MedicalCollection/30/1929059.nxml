urce><year>2006</year><volume>95</volume><fpage>3553</fpage><lpage>3561</lpage><pub-id pub-id-type="pmid">16709721</pub-id><pub-id pub-id-type="doi">10.1152/jn.01091.2005</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Galan</surname><given-names>A</given-names></name><name><surname>Cervero</surname><given-names>F</given-names></name></person-group><article-title>Painful stimuli induce in vivo phosphorylation and membrane mobilization of mouse spinal cord NKCC1 co-transporter</article-title><source>Neuroscience</source><year>2005</year><volume>133</volume><fpage>245</fpage><lpage>252</lpage><pub-id pub-id-type="pmid">15893647</pub-id><pub-id pub-id-type="doi">10.1016/j.neuroscience.2005.02.025</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rudomin</surname><given-names>P</given-names></name><name><surname>Schmidt</surname><given-names>RF</given-names></name></person-group><article-title>Presynaptic inhibition in the vertebrate spinal cord revisited</article-title><source>Exp Brain Res</source><year>1999</year><volume>129</volume><fpage>1</fpage><lpage>37</lpage><pub-id pub-id-type="pmid">10550500</pub-id><pub-id pub-id-type="doi">10.1007/s002210050933</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garcia-Nicas</surname><given-names>E</given-names></name><name><surname>Laird</surname><given-names>JM</given-names></name><name><surname>Cervero</surname><given-names>F</given-names></name></person-group><article-title>GABAA-Receptor blockade reverses the injury-induced sensitization of nociceptor-specific (NS) neurons in the spinal dorsal horn of the rat</article-title><source>J Neurophysiol</source><year>2006</year><volume>96</volume><fpage>661</fpage><lpage>670</lpage><pub-id pub-id-type="pmid">16707718</pub-id><pub-id pub-id-ty