tion></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Faunce</surname><given-names>T</given-names></name><name><surname>Doran</surname><given-names>E</given-names></name><name><surname>Henry</surname><given-names>D</given-names></name><name><surname>Drahos</surname><given-names>P</given-names></name><name><surname>Pekarsky</surname><given-names>B</given-names></name><name><surname>Neville</surname><given-names>W</given-names></name><name><surname>Searles</surname><given-names>A</given-names></name></person-group><article-title>Assessing the Impact of the Australia-United States Free Trade Agreement on Australian and Global Medicines Policy</article-title><source>Globalization and Health</source><year>2005</year><volume>1</volume></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Metherell</surname><given-names>M</given-names></name></person-group><article-title>Patients to Receive a Sugar-Coated Pill</article-title><source>Sydney Morning Herald</source><year>2006</year><publisher-name>Sydney</publisher-name><fpage>1</fpage></citation></ref><ref id="B17"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Mitchell</surname><given-names>A</given-names></name></person-group><article-title>Chemists Limit PBS Reform</article-title><source>Australian Financial Review</source><year>2006</year><fpage>58</fpage></citation></ref></ref-list></back></article>