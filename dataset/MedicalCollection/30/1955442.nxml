ame><surname>Vocke</surname><given-names>CD</given-names></name><name><surname>Waterston</surname><given-names>RH</given-names></name></person-group><article-title>Molecular profiling of clinical tissue specimens</article-title><source>J Mol Diagn</source><year>2000</year><volume>2</volume><fpage>60</fpage><lpage>66</lpage><pub-id pub-id-type="pmid">11272889</pub-id></citation></ref><ref id="B2"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tureci</surname><given-names>O</given-names></name><name><surname>Ding</surname><given-names>J</given-names></name><name><surname>Hilton</surname><given-names>H</given-names></name><name><surname>Bian</surname><given-names>H</given-names></name><name><surname>Ohkawa</surname><given-names>H</given-names></name><name><surname>Braxenthaler</surname><given-names>M</given-names></name><name><surname>Seitz</surname><given-names>G</given-names></name><name><surname>Raddrizzani</surname><given-names>l</given-names></name><name><surname>Friess</surname><given-names>H</given-names></name><name><surname>Buchler</surname><given-names>M</given-names></name><name><surname>Sahin</surname><given-names>U</given-names></name><name><surname>Hammer</surname><given-names>J</given-names></name></person-group><article-title>Computational dissection of tissue contamination for identification of colon cancer specific expression profiles</article-title><source>FASEB J</source><year>2003</year><volume>17</volume><fpage>376</fpage><lpage>385</lpage><pub-id pub-id-type="pmid">12631577</pub-id><pub-id pub-id-type="doi">10.1096/fj.02-0478com</pub-id></citation></ref><ref id="B3"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Benchekroun</surname><given-names>M</given-names></name><name><surname>DeGraw</surname><given-names>J</given-names></name><name><surname>Gao</surname><given-names>J</given-names></name><name><surname>Sun</surname><given-names>L</given-names></name><name><surname>Von Boguslawsky</surname><given-names>K</given-names></name><name><surname>Leminen</surname><given-names>A</given-names></name><name><surname>Andersson</surname><given-names>LC</given-names></name><name><surname>Heiskala</surname><given-names>M</given-names></name></person-group><article-title>Impact of fixative on recovery of mRNA from paraffin-embedded tissue</article-title><source>Diagn Mol Pathol</source><year>2004</year><volume>13</volume><fpage>116</fpage><lpage>25</lpage><pub-id pub-id-type="pmid">15167013</pub-id><pub-id pub-id-type="doi">10.1097/00019606-200406000-00008</pub-id></citation></ref><ref id="B4"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chung</surname><given-names>JY</given-names></name><name><surname>Braunschweig</surname><given-names>T</given-names></name><name><surname>Hewitt</surname><given-names>SM</given-names></name></person-group><article-title>Optimization of recovery of RNA from formalin fixed, paraffin embedded tissue</article-title><source>Diagn Mol Pathol</source><year>2006</year><volume>15</volume><fpage>229</fpage><lpage>236</lpage><pub-id pub-id-type="pmid">17122651</pub-id><pub-id pub-id-type="doi">10.1097/01.pdm.0000213468.91139.2d</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Abrahamsen</surname><given-names>HN</given-names></name><name><surname>Steiniche</surname><given-names>T</given-names></name><name><surname>Nexo</surname><given-names>E</given-names></name><name><surname>Hamilton-Dutoit</surname><given-names>SJ</given-names></name><name><surname>Sorensen</surname><given-names>BS</given-names></name></person-group><article-title>Towards quantitative mRNA analysis in paraffin-embedded tissues using real-time reverse transcriptase-polymerase chain reaction</article-title><source>J Mol Diagn</source><year>2003</year><volume>5</volume><fpage>34</fpage><lpage>41</lpage><pub-id pub-id-type="pmid">12552078</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Emmert-Buck</surname><given-names>MR</given-names></name><name><surname>Bonner</surname><given-names>RF</given-names></name><name><surname>Smith</surname><given-names>PD</given-names></name><name><surname>Chuaqui</surname><given-names>RF</given-names></name><name><surname>Zhuang</surname><given-names>Z</given-names></name><name><surname>Goldstein</surname><given-names>SR</given-names></name><name><surname>Weiss</surname><given-names>RA</given-names></name><name><surname>Liotta</surname><given-names>LA</given-names></name></person-group><article-title>Laser capture microdissection</article-title><source>Science</source><year>1996</year><volume>274</volume><fpage>998</fpage><lpage>1001</lpage><pub-id pub-id-type="pmid">8875945</pub-id><pub-id pub-id-type="doi">10.1126/science.274.5289.998</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Srinivasan</surname><given-names>M</given-names></name><name><surname>Sedmak</surname><given-names>D</given-names></name><name><surname>Jewell</surname><given-names>S</given-names></name></person-group><article-title>Effects of fixatives and tissue processing on the content and integrity of nucleic acids</article-title><source>Am J Pathol</source><year>2002</year><volume>161</volume><fpage>1961</fpage><lpage>1971</lpage><pub-id pub-id-type="pmid">12466110</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mojica</surname><given-names>WD</given-names></name><name><surname>Arshad</surname><given-names>A</given-names></name><name><surname>Sharma</surname><given-names>S</given-names></name><name><surname>Brooks</surname><given-names>SP</given-names></name></person-group><article-title>Manual exfoliation plus immunomagnetic bead separation as an initial step toward translational research</article-title><source>Arch Pathol Lab Med</source><year>2006</year><volume>130</volume><fpage>74</fpage><lpage>79</lpage><pub-id pub-id-type="pmid">16390242</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vincek</surname><given-names>F</given-names></name><name><surname>Nassiri</surname><given-names>M</given-names></name><name><surname>Knowles</surname><given-names>J</given-names></name><name><surname>Nadji</surname><given-names>M</given-names></name><name><surname>Morales</surname><given-names>AR</given-names></name></person-group><article-title>Preservation of tissue RNA in normal saline</article-title><source>Lab Invest</source><year>2003</year><volume>83</volume><fpage>137</fpage><lpage>138</lpage><pub-id pub-id-type="pmid">12533694</pub-id><pub-id pub-id-type="doi">10.1097/01.LAB.0000090154.55436.D1</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yang</surname><given-names>GC</given-names></name><name><surname>Hoda</surname><given-names>SA</given-names></name></person-group><article-title>Combined use of the "Scratch and Smear" sampling technique and ultrafast Papanicolaou stain for intraoperative cytology</article-title><source>Acta Cytol</source><year>1997</year><volume>41</volume><fpage>1513</fpage><lpage>1518</lpage><pub-id pub-id-type="pmid">9305393</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mojica</surname><given-names>WD</given-names></name><name><surname>Rapkiewicz</surname><given-names>AV</given-names></name><name><surname>Liotta</surname><given-names>LA</given-names></name><name><surname>Espina</surname><given-names>V</given-names></name></person-group><article-title>Manual exfoliation of fresh tissue obviates the need for frozen sections for molecular profiling</arti