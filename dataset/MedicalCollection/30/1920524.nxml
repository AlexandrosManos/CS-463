</pub-id><pub-id pub-id-type="doi">10.1210/jc.82.5.1589</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Winquist</surname><given-names>EW</given-names></name><name><surname>Laskey</surname><given-names>J</given-names></name><name><surname>Crump</surname><given-names>M</given-names></name><name><surname>Khamsi</surname><given-names>F</given-names></name><name><surname>Shepherd</surname><given-names>FA</given-names></name></person-group><article-title>Corticotropin-Releasing Hormone-Producing Medullary Thyroid Carcinoma Causing Cushing's Syndrome: Clinical and Pathological Findings</article-title><source>Endocrine Pathology</source><year>2000</year><volume>11</volume><fpage>277</fpage><lpage>286</lpage><pub-id pub-id-type="doi">10.1385/EP:11:3:277</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barbosa</surname><given-names>SL</given-names></name><name><surname>Rodien</surname><given-names>P</given-names></name><name><surname>Leboulleux</surname><given-names>S</given-names></name><name><surname>Niccoli-Sire</surname><given-names>P</given-names></name><name><surname>Kraimps</surname><given-names>JL</given-names></name><name><surname>Caron</surname><given-names>P</given-names></name><name><surname>Archambeaud-Mouveroux</surname><given-names>F</given-names></name><name><surname>Conte-Devolx</surname><given-names>B</given-names></name><name><surname>Rohmer</surname><given-names>V</given-names></name></person-group><article-title>Ectopic adrenocorticotropic hormone-syndrome in medullary carcinoma of the thyroid: a retrospective analysis and review of the literature</article-title><source>Thyroid</source><year>2005</year><volume>15</volume><fpage>618</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">16029131</pub-id><pub-id pub-id-type="doi">10.1089/thy.2005.15.618</pub-id></citation></ref><ref id="B7"><citation cit