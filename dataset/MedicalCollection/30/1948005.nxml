"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kubota</surname><given-names>K</given-names></name><name><surname>Tada</surname><given-names>M</given-names></name><name><surname>Yamada</surname><given-names>S</given-names></name><name><surname>Hori</surname><given-names>K</given-names></name><name><surname>Saito</surname><given-names>S</given-names></name><name><surname>Iwata</surname><given-names>R</given-names></name><name><surname>Sato</surname><given-names>K</given-names></name><name><surname>Fukuda</surname><given-names>H</given-names></name><name><surname>Ido</surname><given-names>T</given-names></name></person-group><article-title>Comparison of the distribution of fluorine-18 fluoromisonidazole, deoxyglucose and methionine in tumour tissue</article-title><source>Eur J Nucl Med</source><year>1999</year><volume>26</volume><fpage>750</fpage><lpage>757</lpage><pub-id pub-id-type="pmid">10398823</pub-id><pub-id pub-id-type="doi">10.1007/s002590050446</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lehti&#x000f6;</surname><given-names>K</given-names></name><name><surname>Eskola</surname><given-names>O</given-names></name><name><surname>Viljanan</surname><given-names>T</given-names></name><name><surname>Oikonen</surname><given-names>V</given-names></name><name><surname>Gr&#x000f6;nroos</surname><given-names>T</given-names></name><name><surname>Sillanm&#x000e4;ki</surname><given-names>L</given-names></name><name><surname>Grenman</surname><given-names>R</given-names></name><name><surname>Minn</surname><given-names>H</given-names></name></person-group><article-title>Imaging perfusion and hypoxia with PET to predict radiotherapy response in head-and-neck cancer</article-title><source>Int J Radiat Oncol Biol Phys</source><year>2004</year><volume>59</volume><fpage>971</fpage><lpage>982</lpage><pub-id pub-id-type="pmid">15234030</pub-id><pub-id pub-i