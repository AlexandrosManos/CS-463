 approach</source><publisher-loc>Oxford</publisher-loc><publisher-name>Oxford University Press</publisher-name><fpage>7</fpage><lpage>18</lpage></citation></ref><ref id="pbio-0050181-b032"><citation citation-type="journal"><person-group><name><surname>Jeysasingh</surname><given-names>PD</given-names></name></person-group><year>2007</year><article-title>Plasticity in metabolic allometry: Role of dietary stoichiometry</article-title><source>Ecol Lett</source><volume>10</volume><fpage>282</fpage><lpage>289</lpage><pub-id pub-id-type="pmid">17355567</pub-id></citation></ref><ref id="pbio-0050181-b033"><citation citation-type="journal"><person-group><name><surname>Eisen</surname><given-names>JA</given-names></name></person-group><year>2007</year><article-title>Environmental shotgun sequencing: Its potential and challenges for studying the hidden world of microbes</article-title><source>PLoS Biol</source><volume>5</volume><issue>3</issue><elocation-id>e82</elocation-id><comment>doi: <ext-link ext-link-type="doi" xlink:href="10.1371/journal.pbio.0050082">10.1371/journal.pbio.0050082</ext-link></comment><pub-id pub-id-type="pmid">17355177</pub-id></citation></ref><ref id="pbio-0050181-b034"><citation citation-type="journal"><person-group><name><surname>Smith</surname><given-names>VH</given-names></name><name><surname>Jones</surname><given-names>TP</given-names></name><name><surname>Smith</surname><given-names>MS</given-names></name></person-group><year>2005</year><article-title>Host nutrition and infectious disease: an ecological view</article-title><source>Front Ecol Environ</source><volume>2005</volume><fpage>268</fpage><lpage>274</lpage></citation></ref><ref id="pbio-0050181-b035"><citation citation-type="journal"><person-group><name><surname>Klausmeier</surname><given-names>CA</given-names></name><name><surname>Litchman</surname><given-names>E</given-names></name><name><surname>Daufresne</surname><given-names>T</given-names></name><name><surname>Levin</surname><given-na