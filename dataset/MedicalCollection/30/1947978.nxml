><name><surname>Parvizi</surname><given-names>J</given-names></name><name><surname>Eggli</surname><given-names>S</given-names></name><name><surname>Berry</surname><given-names>DJ</given-names></name><name><surname>Muller</surname><given-names>ME</given-names></name><name><surname>Busato</surname><given-names>A</given-names></name></person-group><article-title>Demographic factors affecting long-term outcome of total hip arthroplasty</article-title><source>Clin Orthop Relat Res</source><year>2003</year><fpage>62</fpage><lpage>73</lpage><pub-id pub-id-type="pmid">14646703</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Saleh</surname><given-names>KJ</given-names></name><name><surname>Gafni</surname><given-names>A</given-names></name><name><surname>Saleh</surname><given-names>L</given-names></name><name><surname>Gross</surname><given-names>AE</given-names></name><name><surname>Schatzker</surname><given-names>J</given-names></name><name><surname>Tile</surname><given-names>M</given-names></name></person-group><article-title>Economic evaluations in the hip arthroplasty literature: lessons to be learned</article-title><source>J Arthroplasty</source><year>1999</year><volume>14</volume><fpage>527</fpage><lpage>532</lpage><pub-id pub-id-type="pmid">10475549</pub-id><pub-id pub-id-type="doi">10.1016/S0883-5403(99)90072-4</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bozic</surname><given-names>KJ</given-names></name><name><surname>Saleh</surname><given-names>KJ</given-names></name><name><surname>Rosenberg</surname><given-names>AG</given-names></name><name><surname>Rubash</surname><given-names>HE</given-names></name></person-group><article-title>Economic evaluation in total hip arthroplasty: analysis and review of the literature</article-title><source>J Arthroplasty</source><year>2004</year><volume>19</volume><fpage>180</fpage><lpage>189</lpage><pub-id pub-id-type="pmid">14973861</pub-id><pub-id pub-id-type="doi">10.1016/S0883-5403(03)00456-X</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Briggs</surname><given-names>A</given-names></name><name><surname>Sculpher</surname><given-names>M</given-names></name><name><surname>Britton</surname><given-names>A</given-names></name><name><surname>Murray</surname><given-names>D</given-names></name><name><surname>Fitzpatrick</surname><given-names>R</given-names></name></person-group><article-title>The costs and benefits of primary total hip replacement. How likely are new prostheses to be cost-effective?</article-title><source>Int J Technol Assess Health Care</source><year>1998</year><volume>14</volume><fpage>743</fpage><lpage>761</lpage><pub-id pub-id-type="pmid">9885464</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fitzpatrick</surname><given-names>R</given-names></name><name><surname>Shortall</surname><given-names>E</given-names></name><name><surname>Sculpher</surname><given-names>M</given-names></name><name><surname>Murray</surname><given-names>D</given-names></name><name><surname>Morris</surname><given-names>R</given-names></name><name><surname>Lodge</surname><given-names>M</given-names></name><name><surname>Dawson</surname><given-names>J</given-names></name><name><surname>Carr</surname><given-names>A</given-names></name><name><surname>Britton</surname><given-names>A</given-names></name><name><surname>Briggs</surname><given-names>A</given-names></name></person-group><article-title>Primary total hip replacement surgery: a systematic review of outcomes and modelling of cost-effectiveness associated with different prostheses</article-title><source>Health Technol Assess</source><year>1998</year><volume>2</volume><fpage>1</fpage><lpage>64</lpage><pub-id pub-id-type="pmid">10103353</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Baxter</surname><given-names>K</given-names></name><name><surname>Bevan</surname><given-names>G</given-names></name></person-group><article-title>An economic model to estimate the relative costs over 20 years of different hip prostheses</article-title><source>J Epidemiol Community Health</source><year>1999</year><volume>53</volume><fpage>542</fpage><lpage>547</lpage><pub-id pub-id-type="pmid">10562878</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yates</surname><given-names>P</given-names></name><name><surname>Serjeant</surname><given-names>S</given-names></name><name><surname>Rushforth</surname><given-names>G</given-names></name><name><surname>Middleton</surname><given-names>R</given-names></name></person-group><article-title>The relative cost of cemented and uncemented total hip arthroplasties</article-title><source>J Arthroplasty</source><year>2006</year><volume>21</volume><fpage>102</fpage><lpage>105</lpage><pub-id pub-id-type="pmid">16446193</pub-id><pub-id pub-id-type="doi">10.1016/j.arth.2005.05.006</pub-id></citation></ref></ref-list></back></article>