-title>Area characteristics, individual-level socioeconomic indicators, and smoking in young adults</article-title><source>Am J Epidemiol</source><year>2003</year><volume>157</volume><fpage>315</fpage><lpage>326</lpage><pub-id pub-id-type="pmid">12578802</pub-id><pub-id pub-id-type="doi">10.1093/aje/kwf207</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Duncan</surname><given-names>C</given-names></name><name><surname>Jones</surname><given-names>K</given-names></name><name><surname>Moon</surname><given-names>G</given-names></name></person-group><article-title>Smoking and deprivation: are there neighbourhood effects?</article-title><source>Soc Sci Med</source><year>1999</year><volume>48</volume><fpage>497</fpage><lpage>505</lpage><pub-id pub-id-type="pmid">10075175</pub-id><pub-id pub-id-type="doi">10.1016/S0277-9536(98)00360-8</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ecob</surname><given-names>R</given-names></name><name><surname>Macintyre</surname><given-names>S</given-names></name></person-group><article-title>Small area variations in health related behaviours; do these depend on the behaviour itself, its measurement, or on personal characteristics?</article-title><source>Health Place</source><year>2000</year><volume>6</volume><fpage>261</fpage><lpage>274</lpage><pub-id pub-id-type="pmid">11027952</pub-id><pub-id pub-id-type="doi">10.1016/S1353-8292(00)00008-3</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fauth</surname><given-names>RC</given-names></name><name><surname>Leventhal</surname><given-names>T</given-names></name><name><surname>Brooks-Gunn</surname><given-names>J</given-names></name></person-group><article-title>Short-term effects of moving from public housing in poor to middle-class neighborhoods on low-in