e><surname>Elliott</surname><given-names>P</given-names></name></person-group><article-title>Smoking behaviour can be predicted by neighbourhood deprivation measures</article-title><source>J Epidemiol Community Health</source><year>1995</year><volume>49</volume><fpage>s72</fpage><lpage>s77</lpage><pub-id pub-id-type="pmid">8594138</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pollack</surname><given-names>CE</given-names></name><name><surname>Cubbin</surname><given-names>C</given-names></name><name><surname>Ahn</surname><given-names>D</given-names></name><name><surname>Winkleby</surname><given-names>MA</given-names></name></person-group><article-title>Neighbourhood deprivation and alcohol consumption: does the availability of alcohol play a role?</article-title><source>Int J Epidemiol</source><year>2005</year><volume>34</volume><fpage>772</fpage><lpage>780</lpage><pub-id pub-id-type="pmid">15737966</pub-id><pub-id pub-id-type="doi">10.1093/ije/dyi026</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reijneveld</surname><given-names>SA</given-names></name></person-group><article-title>The impact of individual and area characteristics on urban socioeconomic differences in health and smoking</article-title><source>Int J Epidemiol</source><year>1998</year><volume>27</volume><fpage>33</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">9563691</pub-id><pub-id pub-id-type="doi">10.1093/ije/27.1.33</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reijneveld</surname><given-names>SA</given-names></name></person-group><article-title>Neighbourhood socioeconomic context and self reported health and smoking: a secondary analysis of data on seven cities</article-title><source>J Epidemiol Community Health</source><year>2002</year><volume>56</v