tle><source>Phys Ther</source><year>1992</year><volume>72</volume><fpage>425</fpage><lpage>431</lpage><pub-id pub-id-type="pmid">1589462</pub-id></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kendall</surname><given-names>H</given-names></name><name><surname>Kendall</surname><given-names>F</given-names></name><name><surname>Boynton</surname><given-names>D</given-names></name></person-group><source>Posture and pain</source><year>1952</year><publisher-name>Baltimore: The Williams and Wilkins Company</publisher-name></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kibler</surname><given-names>W</given-names></name></person-group><article-title>Role of the scapula in the overhead throwing motion</article-title><source>Contemporary Orthopaedics</source><year>1991</year><volume>22</volume><fpage>525</fpage><lpage>532</lpage></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kibler</surname><given-names>WB</given-names></name></person-group><article-title>The role of the scapula in athletic shoulder function</article-title><source>Am J Sports Med</source><year>1998</year><volume>26</volume><fpage>325</fpage><lpage>337</lpage><pub-id pub-id-type="pmid">9548131</pub-id></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Sahrmann</surname><given-names>S</given-names></name></person-group><source>Diagnosis and treatment of movement impairment syndromes</source><year>2002</year><publisher-name>London: Mosby</publisher-name></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Turner</surname><given-names>M</given-names></name></person-group><article-title>Posture and pain</article-title><source>Physical Therapy Review</source><year>1957</