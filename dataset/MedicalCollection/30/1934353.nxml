-group><article-title>Thoracic position effect on shoulder range of motion, strength, and three-dimensional scapular kinematics</article-title><source>Arch Phys Med Rehabil</source><year>1999</year><volume>80</volume><fpage>945</fpage><lpage>950</lpage><pub-id pub-id-type="pmid">10453773</pub-id><pub-id pub-id-type="doi">10.1016/S0003-9993(99)90088-6</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ludewig</surname><given-names>PM</given-names></name><name><surname>Cook</surname><given-names>TM</given-names></name></person-group><article-title>Alterations in shoulder kinematics and associated muscle activity in people with symptoms of shoulder impingement</article-title><source>Phys Ther</source><year>2000</year><volume>80</volume><fpage>276</fpage><lpage>291</lpage><pub-id pub-id-type="pmid">10696154</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Raine</surname><given-names>S</given-names></name><name><surname>Twomey</surname><given-names>LT</given-names></name></person-group><article-title>Head and shoulder posture variations in 160 asymptomatic women and men</article-title><source>Arch Phys Med Rehabil</source><year>1997</year><volume>78</volume><fpage>1215</fpage><lpage>1223</lpage><pub-id pub-id-type="pmid">9365352</pub-id><pub-id pub-id-type="doi">10.1016/S0003-9993(97)90335-X</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Raine</surname><given-names>S</given-names></name><name><surname>Twomey</surname><given-names>LT</given-names></name></person-group><article-title>Posture of the head, shoulder and thoracic spine in comfortable erect standing</article-title><source>Australian Journal of Physiotherapy</source><year>1994</year><volume>40</volume><fpage>25</fpage><lpage>32</lpage></citation></ref><ref id="B28"><citation c