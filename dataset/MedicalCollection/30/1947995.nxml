b-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mukherjee</surname><given-names>T</given-names></name><name><surname>Copperman</surname><given-names>AB</given-names></name><name><surname>Lapinski</surname><given-names>R</given-names></name><name><surname>Sandler</surname><given-names>B</given-names></name><name><surname>Bustillo</surname><given-names>M</given-names></name><name><surname>Grunfeld</surname><given-names>L</given-names></name></person-group><article-title>An elevated day three follicle-stimulating hormone:luteinizing hormone ratio (FSH:LH) in the presence of a normal day 3 FSH predicts a poor response to controlled ovarian hyperstimulation</article-title><source>Fertil Steril</source><year>1996</year><volume>65</volume><fpage>588</fpage><lpage>593</lpage><pub-id pub-id-type="pmid">8774292</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barroso</surname><given-names>G</given-names></name><name><surname>Oehninger</surname><given-names>S</given-names></name><name><surname>Monzo</surname><given-names>A</given-names></name><name><surname>Kolm</surname><given-names>P</given-names></name><name><surname>Gibbons</surname><given-names>WE</given-names></name><name><surname>Muasher</surname><given-names>SJ</given-names></name></person-group><article-title>High FSH:LH ratio and low LH levels in basal cycle day 3: impact on follicular development and IVF outcome</article-title><source>J Assist Reprod Genet</source><year>2001</year><volume>18</volume><fpage>499</fpage><lpage>505</lpage><pub-id pub-id-type="pmid">11665665</pub-id><pub-id pub-id-type="doi">10.1023/A:1016601110424</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jurema</surname><given-names>MW</given-names></name><name><surname>Bracero</surname><given-names>NJ</given-na