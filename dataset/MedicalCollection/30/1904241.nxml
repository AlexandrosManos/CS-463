tion citation-type="journal"><person-group person-group-type="author"><name><surname>Buzdin</surname><given-names>A</given-names></name><name><surname>Ustyugova</surname><given-names>S</given-names></name><name><surname>Khodosevich</surname><given-names>K</given-names></name><name><surname>Mamedov</surname><given-names>I</given-names></name><name><surname>Lebedev</surname><given-names>Y</given-names></name><name><surname>Hunsmann</surname><given-names>G</given-names></name><name><surname>Sverdlov</surname><given-names>E</given-names></name></person-group><article-title>Human-specific subfamilies of HERV-K (HML-2) long terminal repeats: three master genes were active simultaneously during branching of hominoid lineages(small star, filled)</article-title><source>Genomics</source><year>2003</year><volume>81</volume><fpage>149</fpage><lpage>156</lpage><pub-id pub-id-type="pmid">12620392</pub-id><pub-id pub-id-type="doi">10.1016/S0888-7543(02)00027-7</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Medstrand</surname><given-names>P</given-names></name><name><surname>Mager</surname><given-names>DL</given-names></name></person-group><article-title>Human-specific integrations of the HERV-K endogenous retrovirus family</article-title><source>J Virol</source><year>1998</year><volume>72</volume><fpage>9782</fpage><lpage>9787</lpage><pub-id pub-id-type="pmid">9811713</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Belshaw</surname><given-names>R</given-names></name><name><surname>Pereira</surname><given-names>V</given-names></name><name><surname>Katzourakis</surname><given-names>A</given-names></name><name><surname>Talbot</surname><given-names>G</given-names></name><name><surname>Paces</surname><given-names>J</given-names></name><name><surname>Burt</surname><given-names>A</given-names></name><name><surname>Tristem</surn