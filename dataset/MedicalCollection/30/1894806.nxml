article-title><source>J Clin Oncol</source><year>2006</year><volume>24</volume><fpage>4833</fpage><lpage>4839</lpage><pub-id pub-id-type="pmid">17050868</pub-id><pub-id pub-id-type="doi">10.1200/JCO.2006.07.5937</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Graham</surname><given-names>MV</given-names></name><name><surname>Purdy</surname><given-names>JA</given-names></name><name><surname>Emami</surname><given-names>B</given-names></name><name><surname>Harms</surname><given-names>W</given-names></name><name><surname>Bosch</surname><given-names>W</given-names></name><name><surname>Lockett</surname><given-names>MA</given-names></name><name><surname>Perez</surname><given-names>CA</given-names></name></person-group><article-title>Clinical dose-volume histogram analysis for pneumonitis after 3D treatment for non-small cell lung cancer (NSCLC)</article-title><source>Int J Radiat Oncol Biol Phys</source><year>1999</year><volume>45</volume><fpage>323</fpage><lpage>329</lpage><pub-id pub-id-type="pmid">10487552</pub-id><pub-id pub-id-type="doi">10.1016/S0360-3016(99)00183-2</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matsuo</surname><given-names>Y</given-names></name><name><surname>Takayama</surname><given-names>K</given-names></name><name><surname>Nagata</surname><given-names>Y</given-names></name><name><surname>Kunieda</surname><given-names>E</given-names></name><name><surname>Tateoka</surname><given-names>K</given-names></name><name><surname>Ishizuka</surname><given-names>N</given-names></name><name><surname>Mizowaki</surname><given-names>T</given-names></name><name><surname>Norihisa</surname><given-names>Y</given-names></name><name><surname>Sakamoto</surname><given-names>M</given-names></name><name><surname>Narita</surname><given-names>Y</given-names></name><name><surname>Ishikura</surname><given-names>S</g