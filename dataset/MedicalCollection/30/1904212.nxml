="journal"><person-group person-group-type="author"><name><surname>Sawers</surname><given-names>RG</given-names></name><name><surname>Boxer</surname><given-names>DH</given-names></name></person-group><article-title>Purification and properties of membrane-bound hydrogenase isoenzyme 1 from anaerobically grown <italic>Escherichia coli </italic>K12</article-title><source>Eur J Biochem</source><year>1986</year><volume>156</volume><fpage>265</fpage><lpage>275</lpage><pub-id pub-id-type="pmid">3516689</pub-id><pub-id pub-id-type="doi">10.1111/j.1432-1033.1986.tb09577.x</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sawers</surname><given-names>RG</given-names></name><name><surname>Ballantine</surname><given-names>SP</given-names></name><name><surname>Boxer</surname><given-names>DH</given-names></name></person-group><article-title>Differential expression of hydrogenase isoenzymes in <italic>Escherichia coli</italic> K-12: evidence for a third isoenzyme</article-title><source>J Bacteriol</source><year>1985</year><volume>164</volume><fpage>1324</fpage><lpage>1331</lpage><pub-id pub-id-type="pmid">3905769</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sauter</surname><given-names>M</given-names></name><name><surname>B&#x000f6;hm</surname><given-names>R</given-names></name><name><surname>B&#x000f6;ck</surname><given-names>A</given-names></name></person-group><article-title>Mutational analysis of the operon (<italic>hyc</italic>) determining hydrogenase 3 formation in <italic>Escherichia coli</italic></article-title><source>Mol Microbiol</source><year>1992</year><volume>6</volume><fpage>1523</fpage><lpage>1532</lpage><pub-id pub-id-type="pmid">1625581</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2958.1992.tb00873.x</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group