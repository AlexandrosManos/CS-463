um</source><year>1976</year><volume>6</volume><fpage>53</fpage><lpage>81</lpage><pub-id pub-id-type="pmid">785605</pub-id><pub-id pub-id-type="doi">10.1016/S0049-0172(76)80005-4</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Neville</surname><given-names>E</given-names></name><name><surname>Carstairs</surname><given-names>LS</given-names></name><name><surname>James</surname><given-names>DG</given-names></name></person-group><article-title>Bone Sarcoidosis</article-title><source>Ann N Y Acad Sci</source><year>1976</year><volume>278</volume><fpage>475</fpage><lpage>487</lpage><pub-id pub-id-type="pmid">1067033</pub-id><pub-id pub-id-type="doi">10.1111/j.1749-6632.1976.tb47060.x</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vinnicombe</surname><given-names>S</given-names></name><name><surname>Heron</surname><given-names>C</given-names></name><name><surname>Wansbrough-Jones</surname><given-names>M</given-names></name></person-group><article-title>Dense bones</article-title><source>Br J Radiol</source><year>1992</year><volume>65</volume><fpage>1049</fpage><lpage>1050</lpage><pub-id pub-id-type="pmid">1450825</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shaikh</surname><given-names>S</given-names></name><name><surname>Soubani</surname><given-names>AO</given-names></name><name><surname>Rumore</surname><given-names>P</given-names></name><name><surname>Cantos</surname><given-names>E</given-names></name><name><surname>Jelveh</surname><given-names>Z</given-names></name></person-group><article-title>Lytic osseous destruction in vertebral sarcoidosis</article-title><source>N Y State J Med</source><year>1992</year><volume>92</volume><fpage>213</fpage><lpage>214</lpage><pub-id pub-id-type="pmid">1614673</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cutler</surname><given-names>SS</given-names></name><name><surname>Sankaranarayan</surname><given-names>G</given-names></name></person-group><article-title>Vertebral sarcoidosis</article-title><source>JAMA</source><year>1978</year><volume>240</volume><fpage>557</fpage><lpage>558</lpage><pub-id pub-id-type="pmid">671669</pub-id><pub-id pub-id-type="doi">10.1001/jama.240.6.557</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rua-Figueroa</surname><given-names/></name><name><surname>Gantes</surname><given-names>MA</given-names></name><name><surname>Erausquin</surname><given-names>C</given-names></name><name><surname>Mhaidli</surname><given-names>H</given-names></name><name><surname>Montesdeoca</surname><given-names>A</given-names></name></person-group><article-title>Vertebral Sarcoidosis: clinical and imaging findings</article-title><source>Semin Arthritis Rheum</source><year>2002</year><volume>31</volume><fpage>346</fpage><lpage>352</lpage><pub-id pub-id-type="pmid">11965598</pub-id><pub-id pub-id-type="doi">10.1053/sarh.2002.31553</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Aberg</surname><given-names>C</given-names></name><name><surname>Ponzo</surname><given-names>F</given-names></name><name><surname>Raphael</surname><given-names>B</given-names></name><name><surname>Amorosi</surname><given-names>E</given-names></name><name><surname>Moran</surname><given-names>V</given-names></name><name><surname>Kramer</surname><given-names>E</given-names></name></person-group><article-title>FDG positron emission tomography of bone involvement in sarcoidosis</article-title><source>AJR Am J Roentgenol</source><year>2004</year><volume>182</volume><fpage>975</fpage><lpage>977</lpage><pub-id pub-id-type="pmid">15039174</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><collab>ATS/ERS/WASOG Committee</collab></person-group><article-title>Statement on Sarcoidosis</article-title><source>Am J Respir Crit Care Med</source><year>1999</year><volume>160</volume><fpage>736</fpage><lpage>755</lpage><pub-id pub-id-type="pmid">10430755</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brincker</surname><given-names>H</given-names></name></person-group><article-title>Interpretation of granulomatous lesions in malignancy</article-title><source>Acta Oncol</source><year>1992</year><volume>31</volume><fpage>85</fpage><lpage>89</lpage><pub-id pub-id-type="pmid">1586508</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brincker</surname><given-names>H</given-names></name><name><surname>Pedersen</surname><given-names>NT</given-names></name></person-group><article-title>Immunohistologic separation of B-cell-positive granulomas from B-cell-negative granulomas in paraffin-embedded tissues with special reference to tumor-related sarcoid reactions</article-title><source>APMIS</source><year>1991</year><volume>99</volume><fpage>282</fpage><lpage>290</lpage><pub-id pub-id-type="pmid">1708267</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Robert</surname><given-names>C</given-names></name><name><surname>Schoenlaub</surname><given-names>P</given-names></name><name><surname>Avril</surname><given-names>MF</given-names></name><name><surname>Lok</surname><given-names>C</given-names></name><name><surname>Grosshans</surname><given-names>E</given-names></name><name><surname>Valeyre</surname><given-names>D</given-names></name><name><surname>Bourgeois</surname><given-names>C</given-names></name><name><surname>Pinquier</surname><given-names>L</given-names></name><name><surname>Dubertret</surname><given-names>L</given-names></name><name><surname>Guillaume</surname><given-names>JC</given-names></name></person-group><article-title>Malignant melanoma and granulomatosis</article-title><source>Br J Dermatol</source><year>1997</year><volume>137</volume><fpage>787</fpage><lpage>792</lpage><pub-id pub-id-type="pmid">9415243</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2133.1997.19542042.x</pub-id></citation></ref></ref-list></back></article>