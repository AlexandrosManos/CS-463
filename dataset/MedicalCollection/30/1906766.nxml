 pub-id-type="pmid">12050092</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marteau</surname><given-names>T</given-names></name><name><surname>Lerman</surname><given-names>C</given-names></name></person-group><article-title>Genetic risk and behavioural change </article-title><source>BMJ</source><year>2001</year><volume>322</volume><fpage>1056</fpage><lpage>1159</lpage><pub-id pub-id-type="pmid">11325776</pub-id><pub-id pub-id-type="doi">10.1136/bmj.322.7293.1056</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meiser</surname><given-names>B</given-names></name><name><surname>Dunn</surname><given-names>S</given-names></name><name><surname>Dixon</surname><given-names>J</given-names></name><name><surname>Powell</surname><given-names>LW</given-names></name></person-group><article-title>Psychological adjustment and knowledge about hereditary hemochromatosis in a clinic-based sample: a prospective study</article-title><source>J Genet Couns</source><year>2005</year><volume>14</volume><fpage>453</fpage><lpage>463</lpage><pub-id pub-id-type="pmid">16388326</pub-id><pub-id pub-id-type="doi">10.1007/s10897-005-6192-y</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>J</given-names></name><name><surname>Michie</surname><given-names>S</given-names></name><name><surname>Stephenson</surname><given-names>M</given-names></name><name><surname>Quarrel</surname><given-names>O</given-names></name></person-group><article-title>Risk perception and decision-making in candidates for genetic testing for Huntington&#x02019;s disease: An interpretative phenomenological analysis</article-title><source>Journal of Health Psychology</source><year>2002</year><volume>7</volume><fpage>131</fpage><lpage>144</lpage><pub-id pub-id-type="do