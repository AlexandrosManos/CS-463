></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hanley</surname><given-names>RJ</given-names></name><name><surname>Alexcih</surname><given-names>LMB</given-names></name><name><surname>Wiener</surname><given-names>JM</given-names></name><name><surname>Kennell</surname><given-names>DL</given-names></name></person-group><article-title>Predicting elderly nursing home admissions: results from the 1982&#x02013;1984 National Long-Term Care Survey</article-title><source>Res Aging</source><year>1990</year><volume>12</volume><fpage>199</fpage><lpage>228</lpage><pub-id pub-id-type="pmid">2359874</pub-id><pub-id pub-id-type="doi">10.1177/0164027590122004</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kasper</surname><given-names>JD</given-names></name><name><surname>Shore</surname><given-names>AD</given-names></name></person-group><article-title>Cognitive impairment and problems behaviors as risk factors and institutionalization</article-title><source>J Appl Gerontol</source><year>1994</year><volume>13</volume><fpage>371</fpage><lpage>385</lpage><pub-id pub-id-type="doi">10.1177/073346489401300403</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pearlman</surname><given-names>DN</given-names></name><name><surname>Crown</surname><given-names>WH</given-names></name></person-group><article-title>Alternative sources of social support and their impacts on institutional risk</article-title><source>Gerontologist</source><year>1992</year><volume>32</volume><fpage>527</fpage><lpage>535</lpage><pub-id pub-id-type="pmid">1427256</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stern</surname><given-names>Y</given-names></name><name><surname>Tang</surname><given-names>MX</given-names></name