"author"><name><surname>Spiegelhalter</surname><given-names>DJ</given-names></name><name><surname>Thomas</surname><given-names>A</given-names></name><name><surname>Best</surname><given-names>NG</given-names></name></person-group><source>WinBUGS Version 12 User Manual</source><year>1999</year><publisher-name>MRC Biostatistics Unit. University of London</publisher-name></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brooks</surname><given-names>SP</given-names></name><name><surname>Gelman</surname><given-names>A</given-names></name></person-group><article-title>General methods for monitoring convergence of iterative simulations</article-title><source>J Comp Graph Statist</source><year>1998</year><volume>7</volume><fpage>434</fpage><lpage>455</lpage><pub-id pub-id-type="doi">10.2307/1390675</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Richardson</surname><given-names>S</given-names></name><name><surname>Thomson</surname><given-names>A</given-names></name><name><surname>Best</surname><given-names>N</given-names></name><name><surname>Elliott</surname><given-names>P</given-names></name></person-group><article-title>Interpreting posterior relative risk estimates in disease-mapping studies</article-title><source>Environ Health Perspect</source><year>2004</year><volume>112</volume><fpage>1016</fpage><lpage>25</lpage><pub-id pub-id-type="pmid">15198922</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>MacLure</surname><given-names>M</given-names></name><name><surname>Schneeweiss</surname><given-names>S</given-names></name></person-group><article-title>Causation of bias: the episcope</article-title><source>Epidemiol</source><year>2001</year><volume>12</volume><fpage>114</fpage><lpage>122</lpage><pub-id pub-id-type="doi">10.1097/00001648-200101000-00019</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Einterz</surname><given-names>EM</given-names></name><name><surname>Bates</surname><given-names>ME</given-names></name></person-group><article-title>Fever in Africa: do patients know when they are hot</article-title><source>Lancet</source><year>1997</year><volume>350</volume><fpage>781</fpage><pub-id pub-id-type="pmid">9298000</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(97)24037-7</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dunyo</surname><given-names>SK</given-names></name><name><surname>Koram</surname><given-names>KA</given-names></name><name><surname>Nkrumah</surname><given-names>FK</given-names></name></person-group><article-title>Fever in Africa and WHO recommendation</article-title><source>Lancet</source><year>1997</year><volume>350</volume><fpage>1549</fpage><lpage>1550</lpage><pub-id pub-id-type="doi">10.1016/S0140-6736(05)63981-5</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Benson</surname><given-names>T</given-names></name><name><surname>Chamberlin</surname><given-names>J</given-names></name><name><surname>Rhinehart</surname><given-names>I</given-names></name></person-group><article-title>An investigation of the spatial determinants of the local prevalence of poverty in rural Malawi</article-title><source>Food Policy</source><year>2005</year><volume>30</volume><fpage>532</fpage><lpage>550</lpage><pub-id pub-id-type="doi">10.1016/j.foodpol.2005.09.004</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vaahtera</surname><given-names>M</given-names></name><name><surname>Kulmala</surname><given-names>T</given-names></name><name><surname>Maleta</surname><given-names>K</given-names></name><name><surname>Cullinan</surname><given-names>T</given-names></name><name><surname>Salin</surname><given-names>M</given-names></name><name><surname>Ashorn</surname><given-names>P</given-names></name></person-group><article-title>Epidemiology and predictors of infant morbidity in rural Malawi</article-title><source>Paediatr Perinat Epidemiol</source><year>2000</year><volume>14</volume><fpage>363</fpage><lpage>371</lpage><pub-id pub-id-type="pmid">11101024</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-3016.2000.00308.x</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mishra</surname><given-names>V</given-names></name></person-group><article-title>Indoor air pollution from biomass combustion and acute respiratory illness in preschool age children in Zimbabwe</article-title><source>Int J Epidemiol</source><year>2003</year><volume>32</volume><fpage>847</fpage><lpage>853</lpage><pub-id pub-id-type="pmid">14559763</pub-id><pub-id pub-id-type="doi">10.1093/ije/dyg240</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lengeler</surname><given-names>C</given-names></name></person-group><article-title>Insecticide-treated bed nets and curtains for preventing malaria</article-title><source>Cochrane Database Syst Rev</source><year>2004</year><volume>2</volume><fpage>CD000363</fpage><pub-id pub-id-type="pmid">15106149</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boerma</surname><given-names>JT</given-names></name><name><surname>Black</surname><given-names>RE</given-names></name><name><surname>Sommerfelt</surname><given-names>AE</given-names></name><name><surname>Rustein</surname><given-names>SO</given-names></name><name><surname>Bicego</surname><given-names>GT</given-names></name></person-group><article-title>Accuracy and completeness of mother's recall of diarrhoea occurence in pre-school children in demographic and health surveys</article-title><source>Int J Epidemiol</source><year>1991</year><volume>20</volume><fpage>1073</fpage><lpage>1080</lpage><pub-id pub-id-type="pmid">1800406</pub-id><pub-id pub-id-type="doi">10.1093/ije/20.4.1073</pub-id></citation></ref><ref id="B28"><citation citation-type="book"><person-group person-group-type="author"><collab>Government of Malawi</collab></person-group><source>Malaria policy</source><year>2002</year><publisher-name>Lilongwe: National Malaria Control Programme. Community Health Sciences Unit. Government of Malawi</publisher-name></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gemperli</surname><given-names>A</given-names></name><name><surname>Vounatsou</surname><given-names>P</given-names></name><name><surname>Kleinschmidt</surname><given-names>I</given-names></name><name><surname>Bagayoko</surname><given-names>M</given-names></name><name><surname>Lengeler</surname><given-names>C</given-names></name><name><surname>Smith</surname><given-names>T</given-names></name></person-group><article-title>Spatial patterns of infant mortality: effects of malaria endemicity</article-title><source>Am J Epidemiol</source><year>2004</year><volume>159</volume><fpage>64</fpage><lpage>72</lpage><pub-id pub-id-type="pmid">14693661</pub-id><pub-id pub-id-type="doi">10.1093/aje/kwh001</pub-id></citation></ref></ref-list></back></article>