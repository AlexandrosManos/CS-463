Report/default.asp"/></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kandala</surname><given-names>N-B</given-names></name><name><surname>Magadi</surname><given-names>MA</given-names></name><name><surname>Madise</surname><given-names>NJ</given-names></name></person-group><article-title>An investigation of district spatial variations of childhood diarrhoea and fever morbidity in Malawi</article-title><source>Soc Sci Med</source><year>2006</year><volume>62</volume><fpage>1138</fpage><lpage>1152</lpage><pub-id pub-id-type="pmid">16139938</pub-id><pub-id pub-id-type="doi">10.1016/j.socscimed.2005.07.028</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kolstad</surname><given-names>PR</given-names></name><name><surname>Burnham</surname><given-names>G</given-names></name><name><surname>Kalter</surname><given-names>HD</given-names></name><name><surname>Kenya-Mugisha</surname><given-names>N</given-names></name><name><surname>Black</surname><given-names>RE</given-names></name></person-group><article-title>The integrated management of childhood illness in western Uganda</article-title><source>Bull World Health Organ</source><year>1997</year><volume>75S1</volume><fpage>77</fpage><lpage>85</lpage><pub-id pub-id-type="pmid">9529720</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Perkins</surname><given-names>BA</given-names></name><name><surname>Zucker</surname><given-names>JR</given-names></name><name><surname>Otieno</surname><given-names>J</given-names></name><name><surname>Jafari</surname><given-names>HS</given-names></name><name><surname>Paxton</surname><given-names>L</given-names></name><name><surname>Redd</surname><given-names>SC</given-names></name><name><surname>Nahlen</surname><given-names>BL</given-names></name><name><surname>Schwartz</sur