p person-group-type="author"><name><surname>Frenkel</surname><given-names>LM</given-names></name><name><surname>Wang</surname><given-names>Y</given-names></name><name><surname>Learn</surname><given-names>GH</given-names></name><name><surname>McKernan</surname><given-names>JL</given-names></name><name><surname>Ellis</surname><given-names>GM</given-names></name><etal/></person-group><year>2003</year><article-title>Multiple viral genetic analyses detect low-level human immunodeficiency virus type 1 replication during effective highly active antiretroviral therapy</article-title><source>J Virol</source><volume>77</volume><fpage>5721</fpage><lpage>5730</lpage><pub-id pub-id-type="pmid">12719565</pub-id></citation></ref><ref id="ppat-0030122-b014"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Furtado</surname><given-names>MR</given-names></name><name><surname>Callaway</surname><given-names>DS</given-names></name><name><surname>Phair</surname><given-names>JP</given-names></name><name><surname>Kunstman</surname><given-names>KJ</given-names></name><name><surname>Stanton</surname><given-names>JL</given-names></name><etal/></person-group><year>1999</year><article-title>Persistence of HIV-1 transcription in peripheral-blood mononuclear cells in patients receiving potent antiretroviral therapy</article-title><source>N Engl J Med</source><volume>340</volume><fpage>1614</fpage><lpage>1622</lpage><pub-id pub-id-type="pmid">10341273</pub-id></citation></ref><ref id="ppat-0030122-b015"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Imamichi</surname><given-names>H</given-names></name><name><surname>Crandall</surname><given-names>KA</given-names></name><name><surname>Natarajan</surname><given-names>V</given-names></name><name><surname>Jiang</surname><given-names>MK</given-names></name><name><surname>Dewar</surname><given-names>RL</given-names></name><etal/></person-group><year>2001</year><article-ti