 person-group-type="author"><name><surname>Gilbertson</surname><given-names>M</given-names></name><name><surname>Brophy</surname><given-names>J</given-names></name></person-group><article-title>Community Health Profile of Windsor, Ontario, Canada: Anatomy of a Great Lakes Area of Concern</article-title><source>Environmental Health Perspectives</source><year>2001</year><volume>109</volume><fpage>827</fpage><lpage>843</lpage><pub-id pub-id-type="pmid">11744501</pub-id><pub-id pub-id-type="doi">10.2307/3454645</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fung</surname><given-names>KY</given-names></name><name><surname>Luginaah</surname><given-names>I</given-names></name><name><surname>Gorey</surname><given-names>KM</given-names></name><name><surname>Webster</surname><given-names>G</given-names></name></person-group><article-title>Air pollution and daily admissions for cardiovascular diseases in Windsor, Ontario</article-title><source>Canadian J of Public Health</source><year>2005</year><volume>96</volume><fpage>29</fpage><lpage>33</lpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Whelpdale</surname><given-names>DM</given-names></name></person-group><article-title>Large-scale atmospheric sulfur studies in Canada</article-title><source>Atmospheric Environment</source><year>1978</year><volume>12</volume><fpage>661</fpage><pub-id pub-id-type="doi">10.1016/0004-6981(78)90246-9</pub-id></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><collab>Ontario Ministry of the Environment</collab></person-group><article-title>Ontario Ministry of the Environment 2000</article-title><source>The Air Quality in Ontario</source><publisher-name>Ontario Ministry of the Environment. Toronto, Canada</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.ene.gov.on.ca/en