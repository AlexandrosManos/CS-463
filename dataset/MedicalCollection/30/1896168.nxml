e>241</lpage><pub-id pub-id-type="pmid">3702652</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Robertson</surname><given-names>DG</given-names></name><name><surname>Fleming</surname><given-names>D</given-names></name></person-group><article-title>Kinetics of standing broad and vertical jumping</article-title><source>Can J Sport Sci</source><year>1987</year><volume>12</volume><fpage>19</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">3594313</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fukashiro</surname><given-names>S</given-names></name><name><surname>Besier</surname><given-names>TF</given-names></name><name><surname>Barrett</surname><given-names>R</given-names></name><name><surname>Cochrane</surname><given-names>J</given-names></name><name><surname>Nagano</surname><given-names>A</given-names></name><name><surname>Lloyd</surname><given-names>DG</given-names></name></person-group><article-title>Direction control in maximal horizontal and vertical jumps</article-title><source>International Journal of Sports and Health Science</source><year>2005</year><volume>3</volume><fpage>272</fpage><lpage>279</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Finni</surname><given-names>T</given-names></name><name><surname>Komi</surname><given-names>PV</given-names></name><name><surname>Lepola</surname><given-names>V</given-names></name></person-group><article-title>In vivo human triceps surae and quadriceps femoris muscle function in a squat jump and counter movement jump</article-title><source>Eur J Appl Physiol</source><year>2000</year><volume>83</volume><fpage>416</fpage><lpage>426</lpage><pub-id pub-id-type="pmid">11138584</pub-id><pub-id pub-id-type="doi">10.1007/s004210000289</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fukashiro</surname><given-names>S</given-names></name><name><surname>Komi</surname><given-names>PV</given-names></name><name><surname>Jarvinen</surname><given-names>M</given-names></name><name><surname>Miyashita</surname><given-names>M</given-names></name></person-group><article-title>In vivo Achilles tendon loading during jumping in humans</article-title><source>Eur J Appl Physiol Occup Physiol</source><year>1995</year><volume>71</volume><fpage>453</fpage><lpage>458</lpage><pub-id pub-id-type="pmid">8565978</pub-id><pub-id pub-id-type="doi">10.1007/BF00635880</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Komi</surname><given-names>PV</given-names></name></person-group><article-title>Relevance of in vivo force measurements to human biomechanics</article-title><source>J Biomech</source><year>1990</year><volume>23</volume><fpage>23</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">2081741</pub-id><pub-id pub-id-type="doi">10.1016/0021-9290(90)90038-5</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van Soest</surname><given-names>AJ</given-names></name><name><surname>Schwab</surname><given-names>AL</given-names></name><name><surname>Bobbert</surname><given-names>MF</given-names></name><name><surname>van Ingen Schenau</surname><given-names>GJ</given-names></name></person-group><article-title>The influence of the biarticularity of the gastrocnemius muscle on vertical-jumping achievement</article-title><source>J Biomech</source><year>1993</year><volume>26</volume><fpage>1</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">8423165</pub-id><pub-id pub-id-type="doi">10.1016/0021-9290(93)90608-H</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pandy</surname><given-