n citation-type="journal"><person-group person-group-type="author"><name><surname>Luo</surname><given-names>WH</given-names></name><name><surname>Yuan Zhang</surname><given-names>Y</given-names></name><name><surname>Li</surname><given-names>H</given-names></name></person-group><year>2003</year><article-title>Chidren&#x02019;s blood lead levels after the phasing out of leaded gasoline in Shantou, China</article-title><source>Arch Environ Health</source><volume>58</volume><fpage>184</fpage><lpage>187</lpage><pub-id pub-id-type="pmid">14535579</pub-id></citation></ref><ref id="b19-ehp0115-001113"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Musson</surname><given-names>SE</given-names></name><name><surname>Vann</surname><given-names>KN</given-names></name><name><surname>Jang</surname><given-names>YC</given-names></name><name><surname>Mutha</surname><given-names>S</given-names></name><name><surname>Jordan</surname><given-names>A</given-names></name><name><surname>Pearson</surname><given-names>B</given-names></name><etal/></person-group><year>2006</year><article-title>RCRA toxicity characterization of discarded electronic devices</article-title><source>Environ Sci Technol</source><volume>40</volume><fpage>2721</fpage><lpage>2726</lpage><pub-id pub-id-type="pmid">16683614</pub-id></citation></ref><ref id="b20-ehp0115-001113"><citation citation-type="book"><collab>National Safety Council</collab><year>1999</year><source>Electronic Product Recovery and Recycling Baseline Report: Recycling of Selected Electronic Products in the United States</source><publisher-loc>Washington, DC</publisher-loc><publisher-name>National Safety Council, Environmental Health Center</publisher-name></citation></ref><ref id="b21-ehp0115-001113"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Needleman</surname><given-names>H</given-names></name></person-group><year>2004</year><article-title>Lead poisoning</artic