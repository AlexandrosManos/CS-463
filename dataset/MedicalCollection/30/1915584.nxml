c. Symp. Proc.</source><year>1989</year><volume>110</volume><fpage>709</fpage></citation><citation citation-type="display-unstructured">H. L. BARTHELL, T. A. ARCHULETA and R. KOSSOWSKY, Mater. Res. Soc. Symp. Proc.110 (1989) 709 </citation></ref><ref id="CR5"><label>5.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>OGUCHI</surname><given-names>H.</given-names></name><name><surname>ISHIKAWA</surname><given-names>K.</given-names></name><name><surname>OJIMA</surname><given-names>S.</given-names></name><name><surname>HIRAYAMA</surname><given-names>Y.</given-names></name><name><surname>SETO</surname><given-names>K.</given-names></name><name><surname>EGUCHI</surname><given-names>G.</given-names></name></person-group><source>Biomaterials</source><year>1992</year><volume>13</volume><fpage>471</fpage><pub-id pub-id-type="doi">10.1016/0142-9612(92)90169-O</pub-id></citation><citation citation-type="display-unstructured">H. OGUCHI, K. ISHIKAWA, S. OJIMA, Y. HIRAYAMA, K. SETO and G. EGUCHI, Biomaterials13 (1992) 471 <pub-id pub-id-type="pmid">1321676</pub-id></citation></ref><ref id="CR6"><label>6.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>DUCHEYENE</surname><given-names>P.</given-names></name><name><surname>RADIN</surname><given-names>S.</given-names></name><name><surname>HEUGHEBAERT</surname><given-names>M.</given-names></name><name><surname>HEUGHEBAERT</surname><given-names>J. C.</given-names></name></person-group><source>Biomaterials</source><year>1990</year><volume>11</volume><fpage>244</fpage><pub-id pub-id-type="doi">10.1016/0142-9612(90)90005-B</pub-id></citation><citation citation-type="display-unstructured">P. DUCHEYENE, S. RADIN, M. HEUGHEBAERT and J. C. HEUGHEBAERT, Biomaterials11 (1990) 244 <pub-id pub-id-type="pmid">2383619</pub-id></citation></ref><ref id="CR7"><label>7.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>RAJIV</surname><given-names>K.</given-names></name><name><surname>SINGH</surname><given-names>F.</given-names></name><name><surname>QIAN</surname><given-names>F.</given-names></name><name><surname>NAGABUSHNAM</surname><given-names>V.</given-names></name><name><surname>DAMMODARAN</surname><given-names>R.</given-names></name><name><surname>MOUDGIL</surname><given-names>B. M.</given-names></name></person-group><source>Biomaterials</source><year>1994</year><volume>7</volume><fpage>522</fpage></citation><citation citation-type="display-unstructured">K. RAJIV, F. SINGH, F. QIAN, V. NAGABUSHNAM, R. DAMMODARAN and B. M. MOUDGIL, Biomaterials7 (1994) 522 </citation></ref><ref id="CR8"><label>8.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>COTELL</surname><given-names>C. M.</given-names></name><name><surname>CHRISEY</surname><given-names>D. B.</given-names></name><name><surname>GRABOWSKI</surname><given-names>K. S.</given-names></name><name><surname>SPRAGUE</surname><given-names>J. A.</given-names></name></person-group><source>Appl. Biomater.</source><year>1992</year><volume>8</volume><fpage> 87</fpage><pub-id pub-id-type="doi">10.1002/jab.770030204</pub-id></citation><citation citation-type="display-unstructured">C. M. COTELL, D. B. CHRISEY, K. S. GRABOWSKI and J. A. SPRAGUE, Appl. Biomater.8 (1992) 87 </citation></ref><ref id="CR9"><label>9.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>YOSHINARI</surname><given-names>T.</given-names></name><name><surname>OHTSUKA</surname><given-names>Y.</given-names></name><name><surname>DERAND</surname><given-names>T.</given-names></name></person-group><source>Biomaterials</source><year>1994</year><volume>7</volume><fpage>528</fpage></citation><citation citation-type="display-unstructured">T. YOSHINARI, Y. OHTSUKA and T. DERAND, Biomaterials7 (1994) 528 </citation></ref><ref id="CR10"><label>10.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>WOLKE</surname><given-names>J. G. C</given-names></name><name><surname>BLIECK-HOGERVORST</surname><given-names>J. M. A.</given-names></name><name><surname>DHERT</surname><given-names>W. J. A.</given-names></name><name><surname>KLLEIN</surname><given-names>C. P. A. T.</given-names></name><name><surname>GROOT</surname><given-names>K.</given-names></name></person-group><source>J. Therm. Spray Techn.</source><year>1992</year><volume>1</volume><fpage>79</fpage></citation><citation citation-type="display-unstructured">J. G. C WOLKE, J. M. A. De BLIECK-HOGERVORST, W. J. A. DHERT, C. P. A. T. KLLEIN and K. DE GROOT, J. Therm. Spray Techn.1(1992) 79 </citation></ref><ref id="CR11"><label>11.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>JANSEN</surname><given-names>J. A.</given-names></name><name><surname>WOLKE</surname><given-names>J. G. C.</given-names></name><name><surname>SWANN</surname><given-names>S.</given-names></name><name><surname>WAERDEN</surname><given-names>J. P. C. M.</given-names></name><name><surname>GROOT</surname><given-names>K.</given-names></name></person-group><source>Clin. Oral Impl. Res.</source><year>1993</year><volume>4</volume><fpage>28</fpage><pub-id pub-id-type="doi">10.1034/j.1600-0501.1993.040104.x</pub-id></citation><citation citation-type="display-unstructured">J. A. JANSEN, J. G. C. WOLKE, S. SWANN, J. P. C. M. VAN DER WAERDEN, K. DE GROOT, Clin. Oral Impl. Res.4 (1993) 28 </citation></ref><ref id="CR12"><label>12.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>KIVRAK</surname><given-names>N.</given-names></name><name><surname>CUNEYT</surname><given-names>A.</given-names></name></person-group><source>J. Am. Ceram. Soc</source><year>1998</year><volume>81</volume><fpage>2245</fpage></citation><citation citation-type="display-unstructured">N. KIVRAK, A. CUNEYT, J. Am. Ceram. Soc. 81 (1