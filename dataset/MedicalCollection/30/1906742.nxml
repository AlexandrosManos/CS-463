tle>Statistical approaches for DNA barcoding</article-title><source>Syst Biol</source><year>2006</year><volume>55</volume><fpage>162</fpage><lpage>169</lpage><pub-id pub-id-type="pmid">16507534</pub-id><pub-id pub-id-type="doi">10.1080/10635150500431239</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hajibabaei</surname><given-names>M</given-names></name><name><surname>Singer</surname><given-names>GAC</given-names></name><name><surname>Hebert</surname><given-names>PDN</given-names></name><name><surname>Hickey</surname><given-names>DA</given-names></name></person-group><article-title>DNA barcoding: how it complements taxonomy, molecular phylogenetics and population genetics</article-title><source>Trends Genet</source><year>2007</year><volume>23</volume><fpage>167</fpage><lpage>172</lpage><pub-id pub-id-type="pmid">17316886</pub-id><pub-id pub-id-type="doi">10.1016/j.tig.2007.02.001</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ronaghi</surname><given-names>M</given-names></name><name><surname>Uhlen</surname><given-names>M</given-names></name><name><surname>Nyren</surname><given-names>P</given-names></name></person-group><article-title>A sequencing method based on real-time pyrophosphate</article-title><source>Science</source><year>1998</year><volume>281</volume><fpage>363</fpage><lpage>365</lpage><pub-id pub-id-type="pmid">9705713</pub-id><pub-id pub-id-type="doi">10.1126/science.281.5375.363</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hajibabaei</surname><given-names>M</given-names></name><name><surname>Singer</surname><given-names>GA</given-names></name><name><surname>Hickey</surname><given-names>DA</given-names></name></person-group><article-title>Benchmarking DNA barcodes: an assessment using available primate sequences</article-title><source>Genome</source><year>2006</year><volume>49</volume><fpage>851</fpage><lpage>854</lpage><pub-id pub-id-type="pmid">16936793</pub-id><pub-id pub-id-type="doi">10.1139/G06-025</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kimura</surname><given-names>M</given-names></name></person-group><article-title>A simple method for estimating evolutionary rates of base substitutions through comparative studies of nucleotide sequences</article-title><source>J Mol Evol</source><year>1980</year><volume>16</volume><fpage>111</fpage><lpage>120</lpage><pub-id pub-id-type="pmid">7463489</pub-id><pub-id pub-id-type="doi">10.1007/BF01731581</pub-id></citation></ref></ref-list></back></article>