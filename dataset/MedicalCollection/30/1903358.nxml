>SS</given-names></name><name><surname>Preker</surname><given-names>A</given-names></name><name><surname>Souteyrand</surname><given-names>Y</given-names></name><name><surname>Tibouti</surname><given-names>A</given-names></name><name><surname>Villeneuve</surname><given-names>P</given-names></name><name><surname>Xu</surname><given-names>K</given-names></name></person-group><article-title>To retain or remove user fees?: reflections on the current debate in low- and middle-income countries</article-title><source>Appl Health Econ Health Policy</source><year>2006</year><volume>5</volume><fpage>137</fpage><lpage>53</lpage><pub-id pub-id-type="pmid">17132029</pub-id><pub-id pub-id-type="doi">10.2165/00148365-200605030-00001</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Andersson</surname><given-names>N</given-names></name><name><surname>Mitchell</surname><given-names>S</given-names></name></person-group><article-title>Epidemiological geomatics in evaluation of mine risk education in Afghanistan: introducing population weighted raster maps</article-title><source>Int J Health Geographics</source><year>2006</year><volume>5</volume><fpage>1</fpage><pub-id pub-id-type="doi">10.1186/1476-072X-5-1</pub-id></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><collab>Central Statistical Office</collab></person-group><source>Republic of Botswana 2001 Population and Housing Census National Statistical Tables Report</source><year>2003</year><publisher-name>Gaborone, Central Statistical Office</publisher-name></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sanders</surname><given-names>GD</given-names></name><name><surname>Bayoumi</surname><given-names>AM</given-names></name><name><surname>Sundaram</surname><given-names>V</given-names></name><etal></etal></person-group><article-title>Cost-effectiveness of screening for HIV in the era of highly active antiretroviral therapy</article-title><source>N Engl J Med</source><year>2005</year><volume>352</volume><fpage>570</fpage><lpage>85</lpage><pub-id pub-id-type="pmid">15703422</pub-id><pub-id pub-id-type="doi">10.1056/NEJMsa042657</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Walensky</surname><given-names>RP</given-names></name><name><surname>Weinstein</surname><given-names>MC</given-names></name><name><surname>Kimmel</surname><given-names>AD</given-names></name><name><surname>Seage</surname><given-names>GR</given-names><suffix>III</suffix></name><name><surname>Losina</surname><given-names>E</given-names></name><name><surname>Sax</surname><given-names>PE</given-names></name><name><surname>Zhang</surname><given-names>H</given-names></name><name><surname>Smith</surname><given-names>HE</given-names></name><name><surname>Freedberg</surname><given-names>KA</given-names></name><name><surname>Paltiel</surname><given-names>AD</given-names></name></person-group><article-title>Routine human immunodeficiency virus testing: an economic evaluation of current guidelines</article-title><source>Am J Med</source><year>2005</year><volume>118</volume><fpage>292</fpage><lpage>300</lpage><pub-id pub-id-type="pmid">15745728</pub-id><pub-id pub-id-type="doi">10.1016/j.amjmed.2004.07.055</pub-id></citation></ref><ref id="B18"><citation citation-type="other"><person-group person-group-type="author"><collab>CDC</collab></person-group><source>Revised guidelines for HIV counseling, testing and referral MMWR Recomm Rep</source><year>2001</year><volume>50</volume><fpage>1</fpage><lpage>57</lpage></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Cock</surname><given-names>KM</given-names></name><name><surname>Mbori-Ngacha</surname><given-names>D</given-names></name><name><surname>Marum</surname><given-names>E</given-names></name></person-group><article-title>Shadow on the continent: public health and HIV/AIDS in Africa in the 21<sup>st </sup>century</article-title><source>Lancet</source><year>2002</year><volume>360</volume><fpage>67</fpage><lpage>72</lpage><pub-id pub-id-type="pmid">12114058</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(02)09337-6</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Cock</surname><given-names>KM</given-names></name><name><surname>Marum</surname><given-names>E</given-names></name><name><surname>Mbori-Ngacha</surname><given-names>D</given-names></name></person-group><article-title>A serostatus-based approach to HIV/AIDS prevention and care in Africa</article-title><source>Lancet</source><year>2003</year><volume>362</volume><fpage>1847</fpage><lpage>49</lpage><pub-id pub-id-type="pmid">14654325</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(03)14906-9</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Csete</surname><given-names>J</given-names></name><name><surname>Schleifer</surname><given-names>R</given-names></name><name><surname>Cohen</surname><given-names>J</given-names></name></person-group><article-title>"Opt-out" testing for HIV in Africa: a caution</article-title><source>Lancet</source><year>2004</year><volume>363</volume><fpage>493</fpage><lpage>94</lpage><pub-id pub-id-type="pmid">14962543</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(04)15509-8</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maman</surname><given-names>S</given-names></name><name><surname>Mbwambo</surname><given-names>J</given-names></name><name><surname>Hogan</surname><given-names>NM</given-names></name><name><surname>Kilonzo</surname><given-names>GP</given-names></name><na