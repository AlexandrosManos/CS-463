<td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+++</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>++++</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>++++</bold></td><td align="center"><bold>++++</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td></tr><tr><td align="left">KSF Clay<sup>a</sup></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+++</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>++++</bold></td><td align="center"><bold>+++</bold></td><td align="center"><bold>++++</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>+++</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+</bold></td></tr><tr><td align="left">Al-PILC Clay<sup>a</sup></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+++</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+++</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>+++</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+</bold></td></tr><tr><td align="left">TiO<sub>2</sub></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+++</bold></td><td align="center"><bold>+++</bold></td><td align="center"><bold>++</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td></tr><tr><td align="left">MgFeSiO<sub>4</sub></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>++</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+++</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td></tr><tr><td align="left">Mg<sub>1.5</sub>Fe<sub>0.5</sub>SiO<sub>4</sub></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>++</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>++++</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td></tr><tr><td align="left">Mg<sub>0.5</sub>Fe<sub>1.5</sub>SiO<sub>4</sub></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+++++</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+++</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td></tr><tr><td align="left">Fe<sub>2</sub>SiO<sub>4</sub></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+++++</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+++++</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td></tr><tr><td align="left">Mg<sub>2</sub>SiO<sub>4</sub></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td></tr><tr><td align="left">Na<sub>3</sub>PO<sub>4</sub></td><td align="center"><bold>+</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>++</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>++++</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+++</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td></tr><tr><td align="left">Na<sub>4</sub>P<sub>2</sub>O<sub>7</sub></td><td align="center"><bold>-</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>+</bold></td><td align="center"><bold>+++</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold>