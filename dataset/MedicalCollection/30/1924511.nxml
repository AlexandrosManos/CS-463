="journal"><person-group person-group-type="author"><name><surname>Wiener</surname><given-names>H</given-names></name></person-group><article-title>Structural determination of Paraffin Boiling Points</article-title><source>J of Am Chem Soc</source><year>1947</year><volume>69</volume><fpage>17</fpage><lpage>20</lpage><pub-id pub-id-type="doi">10.1021/ja01193a005</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Randic</surname><given-names>M</given-names></name></person-group><article-title>On Characterization of Molecular Branching</article-title><source>J Am Chem Soc</source><year>1975</year><volume>97</volume><fpage>6609</fpage><lpage>6615</lpage><pub-id pub-id-type="doi">10.1021/ja00856a001</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pearlman</surname><given-names>RS</given-names></name><name><surname>Smith</surname><given-names>KM</given-names></name></person-group><article-title>Metric validation and the receptor-relevant subspace concept</article-title><source>J Chem Inf Comput Sci</source><year>1999</year><volume>39</volume><fpage>28</fpage><lpage>35</lpage><pub-id pub-id-type="doi">10.1021/ci980137x</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Silverman</surname><given-names>BD</given-names></name><name><surname>Platt</surname><given-names>DE</given-names></name></person-group><article-title>Comparative molecular moment analysis (CoMMA): 3D-QSAR without molecular superposition</article-title><source>J Med Chem</source><year>1996</year><volume>39</volume><fpage>2129</fpage><lpage>2140</lpage><pub-id pub-id-type="pmid">8667357</pub-id><pub-id pub-id-type="doi">10.1021/jm950589q</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bush</surnam