-title>T-cell control of Epstein-Barr virus-infected B cells is lost during <italic>P. falciparum </italic>malaria</article-title><source>Nature</source><year>1984</year><volume>312</volume><fpage>449</fpage><lpage>450</lpage><pub-id pub-id-type="pmid">6095104</pub-id><pub-id pub-id-type="doi">10.1038/312449a0</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cook</surname><given-names>IF</given-names></name></person-group><article-title>Herpes zoster in children following malaria</article-title><source>J Trop Med Hyg</source><year>1985</year><volume>88</volume><fpage>261</fpage><lpage>264</lpage><pub-id pub-id-type="pmid">3910848</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thumwood</surname><given-names>CM</given-names></name><name><surname>Hunt</surname><given-names>NH</given-names></name><name><surname>Clark</surname><given-names>IA</given-names></name><name><surname>Cowden</surname><given-names>WB</given-names></name></person-group><article-title>Breakdown of the blood-brain barrier in murine cerebral malaria</article-title><source>Parasitology</source><year>1988</year><volume>96</volume><fpage>579</fpage><lpage>589</lpage><pub-id pub-id-type="pmid">2457201</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boulos</surname><given-names>M</given-names></name><name><surname>Costa</surname><given-names>JM</given-names></name><name><surname>Tosta</surname><given-names>CE</given-names></name></person-group><article-title>Pulmonary involvement in malaria</article-title><source>Rev Inst Med Trop S&#x000e3;o Paulo</source><year>1993</year><volume>35</volume><fpage>93</fpage><lpage>102</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Charoenpan</surname><g