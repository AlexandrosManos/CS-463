e-title>ADAPT: A Database of Affymetrix Probesets and Transcripts.</article-title><source>Bioinformatics</source><year>2005</year><volume>21</volume><fpage>2552</fpage><lpage>2553</lpage><pub-id pub-id-type="pmid">15746287</pub-id><pub-id pub-id-type="doi">10.1093/bioinformatics/bti359</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Miller</surname><given-names>C</given-names></name><name><surname>Gurd</surname><given-names>J</given-names></name><name><surname>Brass</surname><given-names>A</given-names></name></person-group><article-title>A RAPID algorithm for sequence database comparisons: application to the identification of vector contamination in the EMBL databases.</article-title><source>Bioinformatics</source><year>1999</year><volume>15</volume><fpage>111</fpage><lpage>121</lpage><pub-id pub-id-type="pmid">10089196</pub-id><pub-id pub-id-type="doi">10.1093/bioinformatics/15.2.111</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Birney</surname><given-names>E</given-names></name><name><surname>Andrews</surname><given-names>TD</given-names></name><name><surname>Bevan</surname><given-names>P</given-names></name><name><surname>Caccamo</surname><given-names>M</given-names></name><name><surname>Chen</surname><given-names>Y</given-names></name><name><surname>Clarke</surname><given-names>L</given-names></name><name><surname>Coates</surname><given-names>G</given-names></name><name><surname>Cuff</surname><given-names>J</given-names></name><name><surname>Curwen</surname><given-names>V</given-names></name><name><surname>Cutts</surname><given-names>T</given-names></name><etal></etal></person-group><article-title>An overview of Ensembl.</article-title><source>Genome Res</source><year>2004</year><volume>14</volume><fpage>925</fpage><lpage>928</lpage><pub-id pub-id-type="pmid">15078858</pub-id><pub-id pub-id-type="doi