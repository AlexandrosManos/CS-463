nk ext-link-type="uri" xlink:href="http://www.nvma.nl/nl/publicaties/engelstalige2005/index.php">http://www.nvma.nl/nl/publicaties/engelstalige2005/index.php</ext-link></comment></element-citation></ref><ref id="r45"><label>45</label><element-citation publication-type="confproc"><person-group person-group-type="author"><name><surname>Hanseth</surname><given-names>O</given-names></name><name><surname>Monteiro</surname><given-names>E</given-names></name></person-group><article-title>Changing irreversible networks. [Online]</article-title><year>1998</year><conf-name>In: Proceedings of the 6th European Conference on Information Systems</conf-name><conf-date>1998 June 4&#x02013;8</conf-date><publisher-name>Aix-en-Provence</publisher-name><comment>Available from: URL: <ext-link ext-link-type="uri" xlink:href="http://www.idi.ntnu.no/~ericm/ecis.html">http://www.idi.ntnu.no/~ericm/ecis.html</ext-link></comment></element-citation></ref><ref id="r46"><label>46</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Singewald</surname><given-names>A</given-names></name></person-group><article-title>Introduction to the Personal Information Protection Act. [Online]</article-title><source>Health information developments in the Netherlands</source><year>2002</year><volume>5</volume><fpage>35</fpage><lpage>39</lpage><comment>Available from: URL: <ext-link ext-link-type="uri" xlink:href="http://www.nvma.nl/nl/publicaties/engelstalige2002/9ntmaeng2002-09.pdf">http://www.nvma.nl/nl/publicaties/engelstalige2002/9ntmaeng2002-09.pdf</ext-link></comment></element-citation></ref><ref id="r47"><label>47</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Stoop</surname><given-names>A</given-names></name><name><surname>Bal</surname><given-names>R</given-names></name></person-group><article-title>Evaluatie Tele-Dermatologisch Consult (TDC) Drachten</article-title><trans-title>Evaluation of the expectations of Tele-Dermatological Consults</trans-title><year>2004</year><publisher-loc>Rotterdam</publisher-loc><publisher-name>Institute of Health Policy and Management (iBMG)</publisher-name><comment>[in Dutch]</comment></element-citation></ref></ref-list></back><floats-group><table-wrap id="tb001" position="float"><label>Table 1</label><caption><p>Summary of differences between the centralised and decentralised approaches</p></caption><table frame="hsides" rules="groups"><thead><tr><th valign="top" align="left" rowspan="1" colspan="1"/><th valign="top" align="left" rowspan="1" colspan="1">Centralised approach</th><th valign="top" align="left" rowspan="1" colspan="1">Decentralised approach</th></tr></thead><tbody><tr><td valign="top" align="left" rowspan="1" colspan="1"><bold>Consisted of</bold></td><td valign="top" align="left" rowspan="1" colspan="1">One large project</td><td valign="top" align="left" rowspan="1" colspan="1">Small scattered projects</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><bold>Involvement of parties</bold></td><td valign="top" align="left" rowspan="1" colspan="1">By central assignment</td><td valign="top" align="left" rowspan="1" colspan="1">By negotiation</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><bold>Start</bold></td><td valign="top" align="left" rowspan="1" colspan="1">From a macro level</td><td valign="top" align="left" rowspan="1" colspan="1">From a micro level</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><bold>Strategy</bold></td><td valign="top" align="left" rowspan="1" colspan="1">One comprehensive solution for all problems of the end-users</td><td valign="top" align="left" rowspan="1" colspan="1">Pragmatic approach to solve immediate needs of the end-users</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><bold>Governing</bold></td><td valign="top" align="left" rowspan="1" colspan="1">Power is localised in a central party</td><td valign="top" align="left" rowspan="1" colspan="1">Power-sharing amongst parties through negotiation</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><bold>Implementation</bold></td><td valign="top" align="left" rowspan="1" colspan="1">Top-down</td><td valign="top" align="left" rowspan="1" colspan="1">Bottom-up</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><bold>Change management</bold></td><td valign="top" align="left" rowspan="1" colspan="1">Macro level&#x0003e;Micro level</td><td valign="top" align="left" rowspan="1" colspan="1">Micro level&#x0003e;Macro level</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><bold>Timing</bold></td><td valign="top" align="left" rowspan="1" colspan="1">Big bang</td><td valign="top" align="left" rowspan="1" colspan="1">Small incremental advances</td></tr></tbody></table></table-wrap></floats-group></article>