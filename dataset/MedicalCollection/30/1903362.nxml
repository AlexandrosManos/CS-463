ame><given-names>XJ</given-names></name></person-group><article-title>Selection of adenoid cystic carcinoma cell clone highly metastatic to the lung: an experimental study</article-title><source>International J Oral &#x00026; Maxillofacial Surgery</source><year>1997</year><volume>26</volume><fpage>116</fpage><lpage>119</lpage><pub-id pub-id-type="doi">10.1016/S0901-5027(05)80830-6</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nakayama</surname><given-names>Hideki</given-names></name><name><surname>Ikebe</surname><given-names>Tetsuro</given-names></name><name><surname>Beppu</surname><given-names>Mahiro</given-names></name><name><surname>Shirasuna</surname><given-names>Kanemitsu</given-names></name></person-group><article-title>High expression levels of nuclear factor &#x003ba;B, I&#x003ba;B, kinase &#x003b1; and Akt kinase in squamous cell carcinoma of the oral cavity</article-title><source>Cancer</source><year>2001</year><volume>92</volume><fpage>3037</fpage><lpage>44</lpage><pub-id pub-id-type="pmid">11753981</pub-id><pub-id pub-id-type="doi">10.1002/1097-0142(20011215)92:12&#x0003c;3037::AID-CNCR10171&#x0003e;3.0.CO;2-#</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gua</surname><given-names>HB</given-names></name><name><surname>Lee</surname><given-names>I</given-names></name><name><surname>Kamar</surname><given-names>M</given-names></name><name><surname>Akiyama</surname><given-names>SK</given-names></name><name><surname>Pierce</surname><given-names>M</given-names></name></person-group><article-title>AbberantN-glycosylation of h1 integrin causes reduced a5h1 integrin clustering and stimulates cell migration</article-title><source>Cancer Res</source><year>2002</year><volume>62</volume><fpage>6837</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">12460896</pub-id></citation></ref><ref id="B15"><citation