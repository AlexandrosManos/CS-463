 Nucl Med</source><year>2002</year><volume>46</volume><fpage>16</fpage><lpage>23</lpage></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boerner</surname><given-names>AR</given-names></name><name><surname>Weckesser</surname><given-names>M</given-names></name><name><surname>Herzog</surname><given-names>H</given-names></name><name><surname>Schmitz</surname><given-names>T</given-names></name><name><surname>Audretsch</surname><given-names>W</given-names></name><name><surname>Nitz</surname><given-names>U</given-names></name><name><surname>Bender</surname><given-names>HG</given-names></name><name><surname>Mueller-Gaertner</surname><given-names>HW</given-names></name></person-group><article-title>Optimal scan time for fluorine-18 fluorodeoxyglucose positron emission tomography in breast cancer</article-title><source>Eur J Nucl Med</source><year>1999</year><volume>26</volume><fpage>226</fpage><lpage>230</lpage><pub-id pub-id-type="pmid">10079312</pub-id><pub-id pub-id-type="doi">10.1007/s002590050381</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cobben</surname><given-names>DC</given-names></name><name><surname>Jager</surname><given-names>PL</given-names></name><name><surname>Elsinga</surname><given-names>PH</given-names></name><name><surname>Maas</surname><given-names>B</given-names></name><name><surname>Suurmeijer</surname><given-names>AJ</given-names></name><name><surname>Hoekstra</surname><given-names>HJ</given-names></name></person-group><article-title>3'-18F-fluoro-3'-deoxy-L-thymidine: a new tracer for staging metastatic melanoma?</article-title><source>J Nucl Med</source><year>2003</year><volume>44</volume><fpage>1927</fpage><lpage>1932</lpage><pub-id pub-id-type="pmid">14660718</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>DeGrado</surname><given-names>TR</given-names></name><name><surname>Baldwin</surname><given-names>SW</given-names></name><name><surname>Wang</surname><given-names>S</given-names></name><name><surname>Orr</surname><given-names>MD</given-names></name><name><surname>Liao</surname><given-names>RP</given-names></name><name><surname>Friedman</surname><given-names>HS</given-names></name><name><surname>Reiman</surname><given-names>R</given-names></name><name><surname>Price</surname><given-names>DT</given-names></name><name><surname>Coleman</surname><given-names>RE</given-names></name></person-group><article-title>Synthesis and evaluation of (18)F-labeled choline analogs as oncologic PET tracers</article-title><source>J Nucl Med</source><year>2001</year><volume>42</volume><fpage>1805</fpage><lpage>1814</lpage><pub-id pub-id-type="pmid">11752077</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rufini</surname><given-names>V</given-names></name><name><surname>Calcagni</surname><given-names>ML</given-names></name><name><surname>Baum</surname><given-names>RP</given-names></name></person-group><article-title>Imaging of neuroendocrine tumors</article-title><source>Semin Nucl Med</source><year>2006</year><volume>36</volume><fpage>228</fpage><lpage>247</lpage><pub-id pub-id-type="pmid">16762613</pub-id><pub-id pub-id-type="doi">10.1053/j.semnuclmed.2006.03.007</pub-id></citation></ref></ref-list></back></article>