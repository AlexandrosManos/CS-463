el>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Evans</surname><given-names>RC</given-names></name><name><surname>Fear</surname><given-names>S</given-names></name><name><surname>Ashby</surname><given-names>D</given-names></name><name><surname>Hackett</surname><given-names>A</given-names></name><name><surname>Williams</surname><given-names>E</given-names></name><etal/></person-group><year>2002</year><article-title>Diet and colorectal cancer: an investigation of the lectin/galactose hypothesis.</article-title><source>Gastroenterology</source><volume>122</volume><fpage>1784</fpage><lpage>1792</lpage><pub-id pub-id-type="pmid">12055585</pub-id></citation></ref></ref-list><fn-group><fn fn-type="conflict"><p><bold>Competing Interests: </bold>The authors have declared that no competing interests exist.</p></fn><fn fn-type="financial-disclosure"><p><bold>Funding: </bold>P.L.M. was supported by a grant from NASA; K.M. by summer fellowships (Marine Biological Laboratory).</p></fn></fn-group></back></article>