ok"><person-group person-group-type="author"><collab>The Information Centre</collab></person-group><source>Dental earnings and expenses report, 2004/05</source><year>2006</year><publisher-name> London: Department of Health</publisher-name></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><collab>Minister for Health</collab></person-group><source>More dentists now, more dentists later</source><year>2005</year><publisher-name>London , Department of Health</publisher-name></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><collab>Department of Health</collab></person-group><source>NHS Dentistry: Options for Change</source><year>2002</year><publisher-name> London: Department of Health</publisher-name></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><collab>General Dental Council</collab></person-group><article-title>The registration of Dental care professionals</article-title><source>Council Papers</source><year>2005</year><publisher-name>London , General Dental Council</publisher-name></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Duke</surname><given-names>ES</given-names></name></person-group><article-title>Has dentistry moved into the nanotechnology era?</article-title><source>Compend of Continuing Education in Dentistry</source><year>2003</year><volume>24</volume><fpage>380</fpage><lpage>382</lpage></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><collab>BDA</collab></person-group><person-group person-group-type="editor"><name><surname>BDA NT</surname></name></person-group><source>Thinking ahead: project on the future of Dentistry: Birmingham.					</source><year>2006</year></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name>