id="pone.0000824-Breiman1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Breiman</surname><given-names>L</given-names></name></person-group><year>2001</year><article-title>Random Forests.</article-title><source>Mach Learn</source><volume>45</volume><fpage>5</fpage><lpage>32</lpage></citation></ref><ref id="pone.0000824-Lindsay1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lindsay</surname><given-names>SW</given-names></name><name><surname>Parson</surname><given-names>L</given-names></name><name><surname>Thomas</surname><given-names>CJ</given-names></name></person-group><year>1998</year><article-title>Mapping the ranges and relative abundance of the two principle African malaria vectors, <italic>Anopheles gambiae</italic> sensu stricto and <italic>An. arabiensis</italic>, using climate data.</article-title><source>Proc Biol Sci</source><volume>265</volume><fpage>847</fpage><lpage>854</lpage><pub-id pub-id-type="pmid">9633110</pub-id></citation></ref><ref id="pone.0000824-Kuhn1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kuhn</surname><given-names>KG</given-names></name><name><surname>Campbell-Lendrum</surname><given-names>DH</given-names></name><name><surname>Davies</surname><given-names>CR</given-names></name></person-group><year>2002</year><article-title>A continental risk map for malaria mosquito (Diptera: Culicidae) vectors in Europe.&#x0201d;</article-title><source>J Med Entomol</source><volume>39</volume><fpage>621</fpage><lpage>630</lpage><pub-id pub-id-type="pmid">12144293</pub-id></citation></ref><ref id="pone.0000824-Rogers1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rogers</surname><given-names>DJ</given-names></name><name><surname>Randolph</surname><given-names>SE</given-names></name><name><surname>Snow</su