article pypes or sources?</article-title><source>Inhal Toxicol</source><volume>19</volume><fpage>457</fpage><lpage>481</lpage><pub-id pub-id-type="pmid">17497526</pub-id></citation></ref><ref id="b6-ehp0114-a0439a"><citation citation-type="book"><person-group><name><surname>Hedley</surname><given-names>AJ</given-names></name><name><surname>McGhee</surname><given-names>SM</given-names></name><name><surname>Wong</surname><given-names>CM</given-names></name><name><surname>Barron</surname><given-names>B</given-names></name><name><surname>Chau</surname><given-names>P</given-names></name><name><surname>Chau</surname><given-names>J</given-names></name><etal/></person-group><year>2006</year><source>Air Pollution: Costs and Paths to a Solution. Hong Kong:Civic Exchange</source><publisher-name>Available: </publisher-name><publisher-loc><ext-link ext-link-type="uri" xlink:href="http://www.civic-exchange.org/publications/2006/VisibilityandHealthE.pdf">http://www.civic-exchange.org/publications/2006/VisibilityandHealthE.pdf</ext-link></publisher-loc><access-date>[accessed 1 August 2007]</access-date></citation></ref><ref id="b7-ehp0114-a0439a"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Janssen</surname><given-names>NAH</given-names></name><name><surname>Schwartz</surname><given-names>J</given-names></name><name><surname>Zanobetti</surname><given-names>A</given-names></name><name><surname>Suh</surname><given-names>HH</given-names></name></person-group><year>2002</year><article-title>Air conditioning and source-specific particles as modifiers of the effect of PM<sub>10</sub> on hospital admissions for heart and lung disease</article-title><source>Environ Health Perspect</source><volume>110</volume><fpage>43</fpage><lpage>49</lpage><pub-id pub-id-type="pmid">11781164</pub-id></citation></ref><ref id="b8-ehp0114-a0439a"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maciejczyk</surname><given-n