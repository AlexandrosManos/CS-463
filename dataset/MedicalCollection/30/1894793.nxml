-names>DS</given-names></name><name><surname>Courey</surname><given-names>TJ</given-names></name><name><surname>Chapman</surname><given-names>TR</given-names></name><name><surname>Draucker</surname><given-names>CB</given-names></name><name><surname>Mims</surname><given-names>BL</given-names></name></person-group><article-title>Adaptive sampling: recruting a diverse community sample of survivors of sexual violence</article-title><source>J Community Health Nurs</source><year>2006</year><volume>23</volume><fpage>169</fpage><lpage>182</lpage><pub-id pub-id-type="pmid">16863402</pub-id><pub-id pub-id-type="doi">10.1207/s15327655jchn2303_4</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grais</surname><given-names>RF</given-names></name><name><surname>Coulombier</surname><given-names>D</given-names></name><name><surname>Ampuero</surname><given-names>J</given-names></name><name><surname>Lucas</surname><given-names>MES</given-names></name><name><surname>Barretto</surname><given-names>AT</given-names></name><name><surname>Jacquier</surname><given-names>G</given-names></name><name><surname>Diaz</surname><given-names>F</given-names></name><name><surname>Balandine</surname><given-names>S</given-names></name><name><surname>Mahoudeau</surname><given-names>C</given-names></name><name><surname>Brown</surname><given-names>V</given-names></name></person-group><article-title>Are rapid population estimates accurate? A field trial of two different assessment methods</article-title><source>Disasters</source><year>2006</year><volume>30</volume><fpage>364</fpage><lpage>376</lpage><pub-id pub-id-type="pmid">16911434</pub-id><pub-id pub-id-type="doi">10.1111/j.0361-3666.2005.00326.x</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Catana</surname><given-names>AJ</given-names></name></person-group><article-title>The wandering quarter method of estimating population density</article-title><source>Ecology</source><year>1963</year><volume>44</volume><fpage>349</fpage><lpage>360</lpage><pub-id pub-id-type="doi">10.2307/1932182</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bostoen</surname><given-names>K</given-names></name><name><surname>Chalabi</surname><given-names>Z</given-names></name></person-group><article-title>Optimising household survey sampling without sample frames</article-title><source>International Journal of Epidemiology</source><year>2006</year><volume>35</volume><fpage>751</fpage><lpage>755</lpage><pub-id pub-id-type="pmid">16481364</pub-id><pub-id pub-id-type="doi">10.1093/ije/dyl019</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Besag</surname><given-names>J</given-names></name><name><surname>Gleaves</surname><given-names>JT</given-names></name></person-group><article-title>On the detection of spatial pattern in plant communities</article-title><source>Bulletin of the International Statistical Institute</source><year>1973</year><volume>45</volume><fpage>153</fpage><lpage>158</lpage></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Diggle</surname><given-names>PJ</given-names></name></person-group><article-title>Robust density estimation using distance methods</article-title><source>Biometrika</source><year>1975</year><volume>62</volume><fpage>39</fpage><lpage>48</lpage><pub-id pub-id-type="doi">10.1093/biomet/62.1.39</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Diggle</surname><given-names>PJ</given-names></name></person-group><article-title>The detection of random heterogeneity in plant populations</article-title><source>Biometrics</source><year>1977</year><volume>33</v