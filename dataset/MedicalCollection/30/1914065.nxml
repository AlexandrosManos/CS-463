r"><collab>United Kingdom Department of Health</collab><year>2003</year><article-title>Protecting staff; delivering services: Implementing the European Working Time Directive for doctors in training</article-title><comment>Annex HSC2003/001. Available: <ext-link ext-link-type="uri" xlink:href="http://www.dh.gov.uk/PublicationsAndStatistics/LettersAndCirculars/HealthServiceCirculars/HealthServiceCircularsArticle/fs/en?CONTENT_ID&#x0003d;4003588&#x00026;chk&#x0003d;i2aOMz.">http://www.dh.gov.uk/PublicationsAndStatistics/LettersAndCirculars/HealthServiceCirculars/HealthServiceCircularsArticle/fs/en?CONTENT_ID&#x0003d;4003588&#x00026;chk&#x0003d;i2aOMz</ext-link>. Accessed 14 June 2007</comment></citation></ref><ref id="pmed-0040205-b008"><citation citation-type="journal"><person-group><name><surname>Douglas</surname><given-names>NJ</given-names></name></person-group><year>2005</year><article-title>Sleep, performance and the European Working Time Directive</article-title><source>Clin Med</source><volume>5</volume><fpage>95</fpage><lpage>96</lpage><pub-id pub-id-type="pmid">15846996</pub-id></citation></ref><ref id="pmed-0040205-b009"><citation citation-type="other"><person-group><name><surname>Dingell</surname><given-names>JD</given-names></name></person-group><year>2007</year><article-title>Letter to HHS Acting Director Munier in regard to continued cooperation and assistance into preventable medical errors associated with caregiver work schedules</article-title><comment>US House of Representatives, Committee on Energy and Commerce. Available: <ext-link ext-link-type="uri" xlink:href="http://energycommerce.house.gov/Press_110/110-ltr.032907.HHS.Munier.pdf">http://energycommerce.house.gov/Press_110/110-ltr.032907.HHS.Munier.pdf</ext-link> Accessed 19 June 2007</comment></citation></ref><ref id="pmed-0040205-b010"><citation citation-type="journal"><person-group><name><surname>Leach</surname><given-names>DC</given-names></name></person-group><year>2000</year><article-title>Residents' work hours: The Achilles' heel of the profession?</article-title><source>Acad Med</source><volume>75</volume><fpage>1156</fpage><lpage>1157</lpage><pub-id pub-id-type="pmid">11112710</pub-id></citation></ref><ref id="pmed-0040205-b011"><citation citation-type="journal"><person-group><name><surname>Weinger</surname><given-names>MB</given-names></name><name><surname>Ancoli-Israel</surname><given-names>S</given-names></name></person-group><year>2002</year><article-title>Sleep deprivation and clinical performance</article-title><source>JAMA</source><volume>287</volume><fpage>955</fpage><lpage>957</lpage><pub-id pub-id-type="pmid">11866625</pub-id></citation></ref><ref id="pmed-0040205-b012"><citation citation-type="journal"><person-group><name><surname>Gaba</surname><given-names>DM</given-names></name><name><surname>Howard</surname><given-names>SK</given-names></name></person-group><year>2002</year><article-title>Patient safety: Fatigue among clinicians and the safety of patients</article-title><source>New Engl J Med</source><volume>347</volume><fpage>1249</fpage><lpage>1255</lpage><pub-id pub-id-type="pmid">12393823</pub-id></citation></ref><ref id="pmed-0040205-b013"><citation citation-type="journal"><person-group><name><surname>Arnedt</surname><given-names>JT</given-names></name><name><surname>Owens</surname><given-names>J</given-names></name><name><surname>Crouch</surname><given-names>M</given-names></name><name><surname>Stahl</surname><given-names>J</given-names></name><name><surname>Carskadon</surname><given-names>MA</given-names></name></person-group><year>2005</year><article-title>Neurobehavioral performance of residents after heavy night call vs after alcohol ingestion</article-title><source>JAMA</source><volume>294</volume><fpage>1025</fpage><lpage>1033</lpage><pub-id pub-id-type="pmid">16145022</pub-id></citation></ref><ref id="pmed-0040205-b014"><citation citation-type="journal"><person-group><name><surname>Dawson</surname><given-names>D</given-