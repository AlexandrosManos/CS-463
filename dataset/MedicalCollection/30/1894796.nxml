rname>von D&#x000f6;hren</surname><given-names>H</given-names></name><name><surname>B&#x000f6;rner</surname><given-names>T</given-names></name><name><surname>Neilan</surname><given-names>BA</given-names></name></person-group><article-title>Structural organization of microcystin biosynthesis in <italic>Microcystis aeruginosa </italic>PCC7806: an integrated peptide-polyketide synthetase system</article-title><source>Chem Biol</source><year>2000</year><volume>7</volume><fpage>753</fpage><lpage>764</lpage><pub-id pub-id-type="pmid">11033079</pub-id><pub-id pub-id-type="doi">10.1016/S1074-5521(00)00021-1</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stachelhaus</surname><given-names>T</given-names></name><name><surname>Schneider</surname><given-names>A</given-names></name><name><surname>Marahiel</surname><given-names>MA</given-names></name></person-group><article-title>Rational design of peptide antibiotics by targeted replacement of bacterial and fungal domains</article-title><source>Science</source><year>1995</year><volume>269</volume><fpage>69</fpage><lpage>72</lpage><pub-id pub-id-type="pmid">7604280</pub-id><pub-id pub-id-type="doi">10.1126/science.7604280</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mootz</surname><given-names>HD</given-names></name><name><surname>Schwarzer</surname><given-names>D</given-names></name><name><surname>Marahiel</surname><given-names>MA</given-names></name></person-group><article-title>Construction of hybrid peptide synthetases by module and domain fusions</article-title><source>Proc Natl Acad Sci USA</source><year>2000</year><volume>97</volume><fpage>5848</fpage><lpage>5853</lpage><pub-id pub-id-type="pmid">10811885</pub-id><pub-id pub-id-type="doi">10.1073/pnas.100075897</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type