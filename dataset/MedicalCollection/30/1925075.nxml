<volume>17</volume><fpage>29</fpage><lpage>35</lpage><pub-id pub-id-type="doi">10.1097/00004694-199701000-00009</pub-id></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cummings</surname><given-names>RJ</given-names></name><name><surname>Hay</surname><given-names>RM</given-names></name><name><surname>McCluskey</surname><given-names>WP</given-names></name><name><surname>Mazur</surname><given-names>JM</given-names></name><name><surname>Lovell</surname><given-names>WW</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Simons GW</surname></name></person-group><article-title>Can clubfeet be evaluated accurately and reproducibly?</article-title><source>The Clubfoot</source><year>1994</year><edition>1</edition><publisher-name>New York: Springer-Verlag</publisher-name><fpage>104</fpage><lpage>113</lpage></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Yamamoto</surname><given-names>H</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Simons GW</surname></name></person-group><article-title>The relationship between functional results and radiographs in one-stage posteromedial release</article-title><source>The Clubfoot</source><year>1994</year><edition>1</edition><publisher-name>New York: Springer-Verlag</publisher-name><fpage>147</fpage><lpage>151</lpage></citation></ref></ref-list></back></article>