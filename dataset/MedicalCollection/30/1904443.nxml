tation-type="other"><person-group person-group-type="author"><collab>T.R. Ministry of Health</collab></person-group><article-title>The report for the control program of breast cancer: Follow-up report for breast self-examination 2004</article-title><year>1999</year><ext-link ext-link-type="uri" xlink:href="http://www.saglik.gov.tr/extras/birimler/ksdb/2.doc"/></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>&#x000c7;eber</surname><given-names>E</given-names></name><name><surname>Soyer</surname><given-names>MT</given-names></name><name><surname>Ciceklioglu</surname><given-names>M</given-names></name><name><surname>Cimat</surname><given-names>S</given-names></name></person-group><article-title>Breast cancer risk assessment and risk perception on nurses and midwives in Bornova Health District in Turkey</article-title><source>Cancer Nurs</source><year>2006</year><volume>29</volume><fpage>244</fpage><lpage>249</lpage><pub-id pub-id-type="pmid">16783126</pub-id><pub-id pub-id-type="doi">10.1097/00002820-200605000-00013</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Loescher</surname><given-names>L</given-names></name></person-group><article-title>Nursing roles in cancer prevention position statements</article-title><source>Semin Oncol Nurs</source><year>2004</year><volume>20</volume><fpage>111</fpage><lpage>120</lpage><pub-id pub-id-type="pmid">15253594</pub-id><pub-id pub-id-type="doi">10.1053/j.soncn.2004.02.005</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>RA</given-names></name><name><surname>Cokkinides</surname><given-names>V</given-names></name><name><surname>Eyre</surname><given-names>HJ</given-names></name></person-group><article-title>American Cancer Society Guidelines for the Early Detection of Cancer,