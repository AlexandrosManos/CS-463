le><source>Pharmaceutical Executive</source><year>2006</year></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Class</surname><given-names>S</given-names></name></person-group><article-title>Whither Generics?: Why Major Restructuring Lies Ahead</article-title><source>Journal of Generic Medicines</source><year>2005</year><volume>2</volume><fpage>232</fpage><lpage>239</lpage><pub-id pub-id-type="doi">10.1057/palgrave.jgm.4940074</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Humphreys</surname><given-names>A</given-names></name><name><surname>D'Amore</surname><given-names>N</given-names></name></person-group><article-title>Generic Deluge</article-title><source>Med Ad News</source><year>2005</year><volume>24</volume></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><collab>Anonymous</collab></person-group><article-title>Generics Transform Statin Outlook</article-title><source>Med Ad News</source><year>2006</year><volume>12</volume></citation></ref><ref id="B26"><citation citation-type="other"><person-group person-group-type="author"><collab>Department of Health and Ageing</collab></person-group><article-title>Questions and Answers - Price Change for Atorvastatin ( Lipitor&#x000ae;) in the 1 August Issue of the Schedule of Pharmaceutical Benefits</article-title><ext-link ext-link-type="uri" xlink:href="http://www.health.gov.au/internet/wcms/publishing.nsf/Content/health-pbs-atorvastinqa#"/></citation></ref><ref id="B27"><citation citation-type="other"><person-group person-group-type="author"><name><surname>St.Onge</surname><given-names>J</given-names></name></person-group><article-title>Bristol, Sanofi Ask U.S. Judge to Halt Generic Form of Plavix</article-title><ext-link ext-link-type="uri" xlink:href="http://www.bloomberg.com/apps/news?pid=20601103&#x00026;sid=aW