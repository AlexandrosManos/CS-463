given-names></name></person-group><article-title>A Prescription for Future Success: Companies Should Begin Formulating Life-Cycle Strategies in Phase II of Development to Extend a Product's Revenue</article-title><source>Med Ad News</source><year>2006</year><volume>25</volume></citation></ref><ref id="B34"><citation citation-type="book"><person-group person-group-type="author"><collab>Federal Trade Commission</collab></person-group><article-title>Prepared Statement on Barriers to Generic Entry</article-title><source>United States Senate, Special Committe on Aging</source><year>2006</year><publisher-name>Washington D.C., </publisher-name></citation></ref><ref id="B35"><citation citation-type="other"><person-group person-group-type="author"><collab>Sanofi-Aventis</collab></person-group><article-title>A Brand Dedicated to Generics</article-title><ext-link ext-link-type="uri" xlink:href="http://en.sanofi-aventis.com/group/products/p_group_gen.asp"/></citation></ref><ref id="B36"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Probyn</surname><given-names>A</given-names></name></person-group><article-title>Some Drugs More Equal Than Others: Pseudo-generics and Commercial Practice</article-title><source>Australian Health Review</source><year>2004</year><volume>28</volume><fpage>207</fpage><lpage>217</lpage><pub-id pub-id-type="pmid">15527401</pub-id></citation></ref><ref id="B37"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tempest</surname><given-names>B</given-names></name></person-group><article-title>CEO Perspective: Meeting the Challenge of Growth and Profitability</article-title><source>Journal of Generic Medicines</source><year>2005</year><volume>2</volume><fpage>297</fpage><lpage>307</lpage><pub-id pub-id-type="doi">10.1057/palgrave.jgm.4940082</pub-id></citation></ref><ref id="B38"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>El Feki