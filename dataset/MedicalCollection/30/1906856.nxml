lpage>126</lpage><pub-id pub-id-type="doi">10.1080/13645570600595280</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bryman</surname><given-names>A</given-names></name></person-group><article-title>Barriers to integrating quantitative and qualitative research</article-title><source>Journal of Mixed Methods Research</source><year>2007</year><volume>1</volume><fpage>8</fpage><lpage>22</lpage><pub-id pub-id-type="doi">10.1177/2345678906290531</pub-id></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Tashakkori</surname><given-names>A</given-names></name><name><surname>Teddlie</surname><given-names>C</given-names></name><collab>(Eds)</collab></person-group><source>Handbook of mixed methods in social and behavioural research</source><year>2003</year><publisher-name>London: Sage</publisher-name></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Creswell</surname><given-names>JW</given-names></name></person-group><source>Research design Qualitative, quantitative, and mixed methods approaches</source><year>2003</year><edition>Second</edition><publisher-name>London: Sage Publications;</publisher-name></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pope</surname><given-names>C</given-names></name><name><surname>Mays</surname><given-names>N</given-names></name></person-group><article-title>Reaching the parts other methods cannot reach: an introduction to qualitative methods in health and health services research</article-title><source>British Medical Journal</source><year>1995</year><volume>311</volume><fpage>42</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">7613329</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barbour</surname><given-names>RS</given-names></name></person-group><article-title>The case for combining qualitative and quantitative approaches in health services research</article-title><source>Journal of Health Services Research and Policy</source><year>1999</year><volume>4</volume><fpage>39</fpage><lpage>43</lpage><pub-id pub-id-type="pmid">10345565</pub-id></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><name><surname>O'Cathain</surname><given-names>A</given-names></name><name><surname>Thomas</surname><given-names>K</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Pope C, Mays N</surname></name></person-group><article-title>Combining qualitative and quantitative methods</article-title><source>Qualitative Research in Health Care</source><year>2006</year><edition>Third</edition><publisher-name>Oxford: Blackwell Publishing</publisher-name><fpage>102</fpage><lpage>111</lpage></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Adamson</surname><given-names>J</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Bowling A, Ebrahim S</surname></name></person-group><article-title>Combined qualitative and quantitative designs</article-title><source>Handbook of health research methods Investigation, measurement and analysis</source><year>2005</year><publisher-name>Berkshire: Open University Press</publisher-name><fpage>230</fpage><lpage>245</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McDowell</surname><given-names>I</given-names></name><name><surname>MacLean</surname><given-names>L</given-names></name></person-group><article-title>Blending qualitative and quantitative study methods in health services research</article-title><source>Health Informatics Journal</source><year>1998</year><volume>4</volume><fpage>15</fpage><lpage>22</lpage></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnstone</surname><given-names>PL</given-names></name></person-group><article-title>Mixed methods, mixed methodology health services research in practice</article-title><source>Qualitative Health Research</source><year>2004</year><volume>14</volume><fpage>259</fpage><lpage>271</lpage><pub-id pub-id-type="pmid">14768461</pub-id><pub-id pub-id-type="doi">10.1177/1049732303260610</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bradley</surname><given-names>F</given-names></name><name><surname>Wiles</surname><given-names>R</given-names></name><name><surname>Kinmonth</surname><given-names>A-L</given-names></name><name><surname>Mant</surname><given-names>D</given-names></name><name><surname>Gantley</surname><given-names>M</given-names></name></person-group><article-title>Development and evaluation of complex interventions in health services research: case study of the Southampton heart integrated care project (SHIP)</article-title><source>British Medical Journal</source><year>1999</year><volume>318</volume><fpage>711</fpage><lpage>715</lpage><pub-id pub-id-type="pmid">10074018</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Campbell</surname><given-names>M</given-names></name><name><surname>Fitzpatrick</surname><given-names>R</given-names></name><name><surname>Haines</surname><given-names>A</given-names></name><name><surname>Kinmonth</surname><given-names>AL</given-names></name><name><surname>Sandercock</surname><given-names>P</given-names></name><name><surname>Spiegelhalter</surname><given-names>D</given-names></name><name><surname>Tyrer</surname><given-names>P</given-names></name></person-group><article-title>Framework for design and evaluation 