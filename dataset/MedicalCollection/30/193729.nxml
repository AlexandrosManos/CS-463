group person-group-type="author"><name><surname>Liu</surname><given-names>J</given-names></name></person-group><article-title>Pharmacology of oleanolic acid and ursolic acid</article-title><source>J Ethnopharmacol</source><year>1995</year><volume>49</volume><fpage>57</fpage><lpage>68</lpage><pub-id pub-id-type="pmid">8847885</pub-id><pub-id pub-id-type="doi">10.1016/0378-8741(95)01310-5</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Suh</surname><given-names>N</given-names></name><name><surname>Honda</surname><given-names>T</given-names></name><name><surname>Finlay</surname><given-names>HJ</given-names></name><name><surname>Barchowsky</surname><given-names>A</given-names></name><name><surname>Williams</surname><given-names>C</given-names></name><name><surname>Benoit</surname><given-names>NE</given-names></name><name><surname>Xie</surname><given-names>QW</given-names></name><name><surname>Nathan</surname><given-names>C</given-names></name><name><surname>Gribble</surname><given-names>GW</given-names></name><name><surname>Sporn</surname><given-names>MB</given-names></name></person-group><article-title>Novel triterpenoids suppress inducible nitric oxide synthase (iNOS) and inducible cyclooxygenase (COX-2) in mouse macrophages</article-title><source>Cancer Res</source><year>1998</year><volume>58</volume><fpage>717</fpage><lpage>723</lpage><pub-id pub-id-type="pmid">9485026</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Honda</surname><given-names>T</given-names></name><name><surname>Rounds</surname><given-names>BV</given-names></name><name><surname>Gribble</surname><given-names>GW</given-names></name><name><surname>Suh</surname><given-names>N</given-names></name><name><surname>Wang</surname><given-names>Y</given-names></name><name><surname>Sporn</surname><given-names>MB</given-names></name></person-group><arti