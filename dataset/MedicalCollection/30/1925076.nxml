></person-group><article-title>Screening depressed patients in family practice. A rapid technic</article-title><source>Postgrad Med</source><year>1972</year><volume>52</volume><fpage>81</fpage><lpage>85</lpage><pub-id pub-id-type="pmid">4635613</pub-id></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Armstrong</surname><given-names>T</given-names></name><name><surname>Bauman</surname><given-names>A</given-names></name><name><surname>Davies</surname><given-names>J</given-names></name></person-group><source>Physical activity patterns of Australian adults. Results of the 1999 Physical Activity Survey</source><year>2000</year><publisher-name>Australian Institute of Health and Welfare. Canberra</publisher-name></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barry</surname><given-names>MJ</given-names></name><name><surname>Fowler</surname><given-names>FJ</given-names><suffix>Jr</suffix></name><name><surname>O'Leary</surname><given-names>MP</given-names></name><name><surname>Bruskewitz</surname><given-names>RC</given-names></name><name><surname>Holtgrewe</surname><given-names>HL</given-names></name><name><surname>Mebust</surname><given-names>WK</given-names></name><name><surname>Cockett</surname><given-names>AT</given-names></name></person-group><article-title>The American Urological Association symptom index for benign prostatic hyperplasia. The Measurement Committee of the American Urological Association</article-title><source>J Urol</source><year>1992</year><volume>148</volume><fpage>1549</fpage><lpage>1557</lpage><pub-id pub-id-type="pmid">1279218</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maislin</surname><given-names>G</given-names></name><name><surname>Pack</surname><given-names>AI</given-names></name><name><surname>Kribbs</surname><given-nam