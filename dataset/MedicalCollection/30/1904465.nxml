<pub-id pub-id-type="pmid">17254339</pub-id></citation></ref><ref id="pmed-0040229-b013"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Killeen</surname><given-names>GF</given-names></name><name><surname>Kihonda</surname><given-names>J</given-names></name><name><surname>Lyimo</surname><given-names>E</given-names></name><name><surname>Okech</surname><given-names>FR</given-names></name><name><surname>Kotas</surname><given-names>ME</given-names></name><etal/></person-group><year>2006</year><article-title>Quantifying behavioural interactions between humans and mosquitoes: Evaluating the protective efficacy of insecticidal nets against malaria transmission in rural Tanzania</article-title><source>BMC Infect Dis</source><volume>6</volume><fpage>161</fpage><pub-id pub-id-type="pmid">17096840</pub-id></citation></ref><ref id="pmed-0040229-b014"><citation citation-type="book"><collab>Roll Back Malaria Partnership</collab><year>2005</year><source>Roll Back Malaria Global Strategic Plan 2005&#x02013;2015</source><publisher-name>Geneva: WHO</publisher-name><page-count count="52"/><comment>p. Available at: <ext-link ext-link-type="uri" xlink:href="http://www.rollbackmalaria.org/forumV/docs/gsp_en.pdf">http://www.rollbackmalaria.org/forumV/docs/gsp&#x0005f;en.pdf</ext-link>.</comment><access-date>Accessed 28 May 2007.</access-date></citation></ref><ref id="pmed-0040229-b015"><citation citation-type="journal"><year>2006</year><article-title>The US President's Malaria Initiative</article-title><source>Lancet</source><volume>368</volume><fpage>1</fpage><pub-id pub-id-type="pmid">16815354</pub-id></citation></ref><ref id="pmed-0040229-b016"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Nafo-Traore</surname><given-names>F</given-names></name><name><surname>Judd</surname><given-names>EJ</given-names></name><name><surname>Okwo-Bele</surname><given-names>J-M</given-names></name></person-group><year>2005</year><source>Protecting vulnerable groups in malaria-endemic areas in Africa through accelerated deployment of insecticide-treated nets: A joint WHO-UNICEF statement</source><publisher-loc>Geneva</publisher-loc><publisher-name>WHO/UNICEF</publisher-name><page-count count="2"/><comment>p. Publication number WHO/HTM/RBM/2005.57. Available at: <ext-link ext-link-type="uri" xlink:href="http://www.who.int/malaria/rbm/Attachment/20050318/RBM-UNICEF-english3.pdf">http://www.who.int/malaria/rbm/Attachment/20050318/RBM-UNICEF-english3.pdf</ext-link>.</comment><access-date>Accessed 28 May 2007.</access-date></citation></ref><ref id="pmed-0040229-b017"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>DL</given-names></name><name><surname>Dushoff</surname><given-names>J</given-names></name><name><surname>Snow</surname><given-names>RW</given-names></name><name><surname>Hay</surname><given-names>SI</given-names></name></person-group><year>2005</year><article-title>The entomological inoculation rate and <named-content content-type="genus-species">Plasmodium falciparum</named-content> infection in African children</article-title><source>Nature</source><volume>438</volume><fpage>492</fpage><lpage>495</lpage><pub-id pub-id-type="pmid">16306991</pub-id></citation></ref><ref id="pmed-0040229-b018"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>DL</given-names></name><name><surname>McKenzie</surname><given-names>FE</given-names></name><name><surname>Snow</surname><given-names>RW</given-names></name><name><surname>Hay</surname><given-names>SI</given-names></name></person-group><year>2007</year><article-title>Revisiting the basic reproductive number for malaria and its implications for malaria control</article-title><source>PLoS Biol</source><volume>5</volume><elocation-id>e42.</elocation-id><comment>doi:<ext-link ext-link-type="doi" xlink:href="10.1371