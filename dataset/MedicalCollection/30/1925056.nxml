e><year>2000</year><volume>60</volume><fpage>2520</fpage><lpage>2526</lpage><pub-id pub-id-type="pmid">10811134</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kamphaus</surname><given-names>GD</given-names></name><name><surname>Colorado</surname><given-names>PC</given-names></name><name><surname>Panka</surname><given-names>DJ</given-names></name><name><surname>Hopfer</surname><given-names>H</given-names></name><name><surname>Ramchandran</surname><given-names>R</given-names></name><name><surname>Torre</surname><given-names>A</given-names></name><name><surname>Maeshima</surname><given-names>Y</given-names></name><name><surname>Mier</surname><given-names>JW</given-names></name><name><surname>Sukhatme</surname><given-names>VP</given-names></name><name><surname>Kalluri</surname><given-names>R</given-names></name></person-group><article-title>Canstatin, a novel matrix-derived inhibitor of angiogenesis and tumor growth</article-title><source>J Biol Chem</source><year>2000</year><volume>275</volume><fpage>1209</fpage><lpage>1215</lpage><pub-id pub-id-type="pmid">10625665</pub-id><pub-id pub-id-type="doi">10.1074/jbc.275.2.1209</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maeshima</surname><given-names>Y</given-names></name><name><surname>Manfredi</surname><given-names>M</given-names></name><name><surname>Reimer</surname><given-names>C</given-names></name><name><surname>Holthaus</surname><given-names>KA</given-names></name><name><surname>Hopfer</surname><given-names>H</given-names></name><name><surname>Chandamuri</surname><given-names>BR</given-names></name><name><surname>Kharbanda</surname><given-names>S</given-names></name><name><surname>Kalluri</surname><given-names>R</given-names></name></person-group><article-title>Identification of the anti-angiogenic site within vascular basement membrane-derived tumstatin<