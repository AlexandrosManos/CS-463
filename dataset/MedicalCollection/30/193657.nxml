son-group><article-title>Mosaic bacterial chromosomes: a challenge en route to a tree of genomes.</article-title><source>Bioessays</source><year>1999</year><volume>21</volume><fpage>99</fpage><lpage>104</lpage><pub-id pub-id-type="pmid">10193183</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lan</surname><given-names>R</given-names></name><name><surname>Reeves</surname><given-names>PR</given-names></name></person-group><article-title>Gene transfer is a major factor in bacterial evolution.</article-title><source>Mol Biol Evol</source><year>1996</year><volume>13</volume><fpage>47</fpage><lpage>55</lpage><pub-id pub-id-type="pmid">8583905</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McClelland</surname><given-names>M</given-names></name><name><surname>Sanderson</surname><given-names>KE</given-names></name><name><surname>Spieth</surname><given-names>J</given-names></name><name><surname>Clifton</surname><given-names>SW</given-names></name><name><surname>Latreille</surname><given-names>P</given-names></name><name><surname>Courtney</surname><given-names>L</given-names></name><name><surname>Porwollik</surname><given-names>S</given-names></name><name><surname>Ali</surname><given-names>J</given-names></name><name><surname>Dante</surname><given-names>M</given-names></name><name><surname>Du</surname><given-names>F</given-names></name><etal></etal></person-group><article-title>Complete genome sequence of <italic>Salmonella enterica </italic>serovar <italic>Typhimurium </italic>LT2.</article-title><source>Nature</source><year>2001</year><volume>413</volume><fpage>852</fpage><lpage>856</lpage><pub-id pub-id-type="pmid">11677609</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Perna</surname><given-names>NT</given-names></name><name><surname>Plunkett</surname><given-names>G</given-names><suffix>III</suffix></name><name><surname>Burland</surname><given-names>V</given-names></name><name><surname>Mau</surname><given-names>B</given-names></name><name><surname>Glasner</surname><given-names>JD</given-names></name><name><surname>Rose</surname><given-names>DJ</given-names></name><name><surname>Mayhew</surname><given-names>GF</given-names></name><name><surname>Evans</surname><given-names>PS</given-names></name><name><surname>Gregor</surname><given-names>J</given-names></name><name><surname>Kirkpatrick</surname><given-names>HA</given-names></name><etal></etal></person-group><article-title>Genome sequence of enterohaemorrhagic <italic>Escherichia coli </italic>O157:H7.</article-title><source>Nature</source><year>2001</year><volume>409</volume><fpage>529</fpage><lpage>533</lpage><pub-id pub-id-type="pmid">11206551</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferretti</surname><given-names>JJ</given-names></name><name><surname>McShan</surname><given-names>WM</given-names></name><name><surname>Adjic</surname><given-names>D</given-names></name><name><surname>Savic</surname><given-names>D</given-names></name><name><surname>Savic</surname><given-names>G</given-names></name><name><surname>Lyon</surname><given-names>K</given-names></name><name><surname>Primeaux</surname><given-names>C</given-names></name><name><surname>Sezate</surname><given-names>SS</given-names></name><name><surname>Surorov</surname><given-names>AN</given-names></name><name><surname>Kenton</surname><given-names>S</given-names></name><etal></etal></person-group><article-title>Complete genome sequence of an M1 strain of <italic>Streptococcus pyogenes</italic>.</article-title><source>Proc Natl Acad Sci USA</source><year>2001</year><volume>98</volume><fpage>4658</fpage><lpage>4663</lpage><pub-id pub-id-type="pmid">11296296</pub-id></citation></ref><ref id="B13"><citation ci