MI&#x02020;</td><td align="center" colspan="2">B&#x02020;</td><td align="center" colspan="2">MI100+B&#x02020;</td><td align="center" colspan="2">MI10+B&#x02020;</td><td align="center" colspan="2">MI10 + B&#x02021;</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td></td><td align="center">%</td><td align="center">rank</td><td align="center">%</td><td align="center">rank</td><td align="center">%</td><td align="center">rank</td><td align="center">%</td><td align="center">rank</td><td align="center">%</td><td align="center">rank</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td align="left">Level of functional status at 3 months</td><td align="center">100.0</td><td align="center">1</td><td align="center">100.0</td><td align="center">1</td><td align="center">99.4</td><td align="center">1</td><td align="center">99.5</td><td align="center">1</td><td align="center">88.0</td><td align="center">3</td></tr><tr><td align="left">Change in pain intensity</td><td align="center">100.0</td><td align="center">2</td><td align="center">100.0</td><td align="center">2</td><td align="center">99.3</td><td align="center">2</td><td align="center">98.5</td><td align="center">2</td><td align="center">99.1</td><td align="center">1</td></tr><tr><td align="left">Pain at baseline</td><td align="center">100.0</td><td align="center">3</td><td align="center">90.2</td><td align="center">6</td><td align="center">96.2</td><td align="center">3</td><td align="center">95.7</td><td align="center">3</td><td align="center">97.7</td><td align="center">2</td></tr><tr><td align="left">Physical activity</td><td align="center">95.0</td><td align="center">4</td><td align="center">99.4</td><td align="center">3</td><td align="center">85.7</td><td align="center">4</td><td align="center">91.2</td><td align="center">4</td><td align="center">61.3</td><td align="center">5</td></tr><tr><td align="left">Vibration tools</td><td align="center">90.0</td><td align="center">5</td><td align="center">94.2</td><td alig