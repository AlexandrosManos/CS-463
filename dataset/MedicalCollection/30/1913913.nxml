r"><name><surname>Hammer</surname><given-names>K</given-names></name><name><surname>Mijakovic</surname><given-names>I</given-names></name><name><surname>Jensen</surname><given-names>PR</given-names></name></person-group><article-title>Synthetic promoter libraries - tuning of gene expression</article-title><source>Trends Biotechnol</source><year>2006</year><volume>24</volume><fpage>53</fpage><lpage>55</lpage><pub-id pub-id-type="pmid">16406119</pub-id><pub-id pub-id-type="doi">10.1016/j.tibtech.2005.12.003</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jensen</surname><given-names>PR</given-names></name><name><surname>Hammer</surname><given-names>K</given-names></name></person-group><article-title>Artificial promoters for metabolic optimization.</article-title><source>Biotechnol Bioeng</source><year>1998</year><volume>58</volume><fpage>191</fpage><lpage>195</lpage><pub-id pub-id-type="pmid">10191389</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1097-0290(19980420)58:2/3&#x0003c;191::AID-BIT11&#x0003e;3.0.CO;2-G</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jensen</surname><given-names>PR</given-names></name><name><surname>Hammer</surname><given-names>K</given-names></name></person-group><article-title>The sequence of spacers between the consensus sequences modulates the strength of prokaryotic promoters</article-title><source>Appl Environ Microbiol</source><year>1998</year><volume>64</volume><fpage>82</fpage><lpage>87</lpage><pub-id pub-id-type="pmid">9435063</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mijakovic</surname><given-names>I</given-names></name><name><surname>Petranovic</surname><given-names>D</given-names></name><name><surname>Jensen</surname><given-names>PR</given-names></name></person-group><article-title>Tunable promoters in system biology</article-title><source>Curr Opin Biotechnol</source><year>2005</year><volume>16</volume><fpage>329</fpage><lpage>335</lpage><pub-id pub-id-type="pmid">15961034</pub-id><pub-id pub-id-type="doi">10.1016/j.copbio.2005.04.003</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rud</surname><given-names>I</given-names></name><name><surname>Jensen</surname><given-names>PR</given-names></name><name><surname>Naterstad</surname><given-names>K</given-names></name><name><surname>Axelsson</surname><given-names>L</given-names></name></person-group><article-title>A synthetic promoter library for constitutive gene expression in Lactobacillus plantarum</article-title><source>Microbiology</source><year>2006</year><volume>152</volume><fpage>1011</fpage><lpage>1019</lpage><pub-id pub-id-type="pmid">16549665</pub-id><pub-id pub-id-type="doi">10.1099/mic.0.28599-0</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Solem</surname><given-names>C</given-names></name><name><surname>Jensen</surname><given-names>PR</given-names></name></person-group><article-title>Modulation of gene expression made easy</article-title><source>Appl Environ Microbiol</source><year>2002</year><volume>68</volume><fpage>2397</fpage><lpage>2403</lpage><pub-id pub-id-type="pmid">11976114</pub-id><pub-id pub-id-type="doi">10.1128/AEM.68.5.2397-2403.2002</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Keasling</surname><given-names>JD</given-names></name></person-group><article-title>Gene-expression tools for the metabolic engineering of bacteria</article-title><source>Trends Biotechnol</source><year>1999</year><volume>17</volume><fpage>452</fpage><lpage>459</lpage><pub-id pub-id-type="pmid">10511704</pub-id><pub-id pub-id-type="doi">10.1016/S0167-7799(99)01376-1</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burr</surname><given-names>T</given-names></name><name><surname>Mitchell</surname><given-names>J</given-names></name><name><surname>Kolb</surname><given-names>A</given-names></name><name><surname>Minchin</surname><given-names>S</given-names></name><name><surname>Busby</surname><given-names>S</given-names></name></person-group><article-title>DNA sequence elements located immediately upstream of the -10 hexamer in Escherichia coli promoters: a systematic study</article-title><source>Nucleic Acids Res</source><year>2000</year><volume>28</volume><fpage>1864</fpage><lpage>1870</lpage><pub-id pub-id-type="pmid">10756184</pub-id><pub-id pub-id-type="doi">10.1093/nar/28.9.1864</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldstein</surname><given-names>MA</given-names></name><name><surname>Doi</surname><given-names>RH</given-names></name></person-group><article-title>Prokaryotic promoters in biotechnology</article-title><source>Biotechnol Annu Rev</source><year>1995</year><volume>1</volume><fpage>105</fpage><lpage>128</lpage><pub-id pub-id-type="pmid">9704086</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harley</surname><given-names>CB</given-names></name><name><surname>Reynolds</surname><given-names>RP</given-names></name></person-group><article-title>Analysis of E. coli promoter sequences</article-title><source>Nucleic Acids Res</source><year>1987</year><volume>15</volume><fpage>2343</fpage><lpage>2361</lpage><pub-id pub-id-type="pmid">3550697</pub-id><pub-id pub-id-type="doi">10.1093/nar/15.5.2343</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hawley</surname><given-names>DK</given-name