<source>Mol Microbiol</source><year>2000</year><volume>37</volume><fpage>542</fpage><lpage>548</lpage><pub-id pub-id-type="pmid">10931347</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2958.2000.02037.x</pub-id></citation></ref><ref id="B12"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Clark</surname><given-names>GC</given-names></name><name><surname>Alsmark</surname><given-names>UCM</given-names></name><name><surname>Hofer</surname><given-names>M</given-names></name><name><surname>Saito-Makano</surname><given-names>Y</given-names></name><name><surname>Aloi</surname><given-names>V</given-names></name><name><surname>Marion</surname><given-names>S</given-names></name><name><surname>Weber</surname><given-names>C</given-names></name><name><surname>Mukherjee</surname><given-names>C</given-names></name><name><surname>Bruchhaus</surname><given-names>I</given-names></name><name><surname>Tannich</surname><given-names>E</given-names></name><name><surname>Leippe</surname><given-names>M</given-names></name><name><surname>Sicheritz-Ponten</surname><given-names>T</given-names></name><name><surname>Foster</surname><given-names>PG</given-names></name><name><surname>Samuelson</surname><given-names>J</given-names></name><name><surname>Noel</surname><given-names>CJ</given-names></name><name><surname>Hirt</surname><given-names>RP</given-names></name><name><surname>Embley</surname><given-names>TM</given-names></name><name><surname>Gilchrist</surname><given-names>CA</given-names></name><name><surname>Mann</surname><given-names>BJ</given-names></name><name><surname>Singh</surname><given-names>U</given-names></name><name><surname>Ackers</surname><given-names>JP</given-names></name><name><surname>Bhattacharya</surname><given-names>S</given-names></name><name><surname>Bhattacharya</surname><given-names>A</given-names></name><name><surname>Lohia</surname><given-names>A</given-names></name><name><surname>Guillen</surname><given-names>N</given-names>