="journal"><person-group person-group-type="author"><name><surname>St John</surname><given-names>A</given-names></name><name><surname>Davis</surname><given-names>TM</given-names></name><name><surname>Goodall</surname><given-names>I</given-names></name><name><surname>Townsend</surname><given-names>MA</given-names></name><name><surname>Price</surname><given-names>CP</given-names></name></person-group><article-title>Nurse-based evaluation of point-of-care assays for glycated haemoglobin</article-title><source>Clin Chim Acta</source><year>2006</year><volume>365</volume><fpage>257</fpage><lpage>263</lpage><pub-id pub-id-type="pmid">16202401</pub-id><pub-id pub-id-type="doi">10.1016/j.cca.2005.09.003</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><article-title>American Diabetes Association: Diagnosis and classification of diabetes mellitus</article-title><source>Diabetes Care</source><year>2004</year><volume>27</volume><fpage>S5</fpage><lpage>S10</lpage><pub-id pub-id-type="pmid">14693921</pub-id><pub-id pub-id-type="doi">10.2337/diacare.27.2007.S5</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matthews</surname><given-names>DR</given-names></name><name><surname>Hosker</surname><given-names>JP</given-names></name><name><surname>Rudenski</surname><given-names>AS</given-names></name><name><surname>Naylor</surname><given-names>BA</given-names></name><name><surname>Treacher</surname><given-names>DF</given-names></name><name><surname>Turner</surname><given-names>RC</given-names></name></person-group><article-title>Homeostasis model assessment: insulin resistance and beta-cell function from fasting plasma glucose and insulin concentrations in man</article-title><source>Diabetologia</source><year>1985</year><volume>28</volume><fpage>412</fpage><lpage>419</lpage><pub-id pub-id-type="pmid">3899825</pub-id><pub-id pub-id-type="doi">10.1007/BF00280883</pub-id></citation></ref