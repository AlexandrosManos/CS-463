f><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ehresmann</surname><given-names>KR</given-names></name><name><surname>Crouch</surname><given-names>N</given-names></name><name><surname>Henry</surname><given-names>PM</given-names></name><name><surname>Hunt</surname><given-names>JM</given-names></name><name><surname>Habedank</surname><given-names>TL</given-names></name><name><surname>Bowman</surname><given-names>R</given-names></name><name><surname>Moore</surname><given-names>KA</given-names></name></person-group><article-title>An outbreak of measles among unvaccinated young adults and measles seroprevalence study: implications for measles outbreak control in adult populations</article-title><source>J Infect Dis</source><year>2004</year><volume>189 Suppl 1</volume><fpage>S104</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15106098</pub-id><pub-id pub-id-type="doi">10.1086/377714</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zandotti</surname><given-names>C</given-names></name><name><surname>Jeantet</surname><given-names>D</given-names></name><name><surname>Lambert</surname><given-names>F</given-names></name><name><surname>Waku-Kouomou</surname><given-names>D</given-names></name><name><surname>Wild</surname><given-names>F</given-names></name><name><surname>Freymuth</surname><given-names>F</given-names></name><name><surname>Harle</surname><given-names>JR</given-names></name><name><surname>de Lamballerie</surname><given-names>X</given-names></name><name><surname>Charrel</surname><given-names>RN</given-names></name></person-group><article-title>Re-emergence of measles among young adults in Marseilles, France</article-title><source>Eur J Epidemiol</source><year>2004</year><volume>19</volume><fpage>891</fpage><lpage>893</lpage><pub-id pub-id-type="pmid">15499900</pub-id><pub-id pub-id-type="doi">10.1023/B:EJEP.0000040453.13914.48</pu