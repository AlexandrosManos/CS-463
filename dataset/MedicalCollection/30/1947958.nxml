oup person-group-type="author"><name><surname>Gentile</surname><given-names>KL</given-names></name><name><surname>Burke</surname><given-names>WD</given-names></name><name><surname>Eickbush</surname><given-names>TH</given-names></name></person-group><article-title>Multiple lineages of R1 retrotransposable elements can coexist in the rDNA loci of Drosophila</article-title><source>Mol Biol Evol</source><year>2001</year><volume>18</volume><fpage>235</fpage><lpage>245</lpage><pub-id pub-id-type="pmid">11158382</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lathe</surname><given-names>WC</given-names><suffix>3rd</suffix></name><name><surname>Burke</surname><given-names>WD</given-names></name><name><surname>Eickbush</surname><given-names>DG</given-names></name><name><surname>Eickbush</surname><given-names>TH</given-names></name></person-group><article-title>Evolutionary stability of the R1 retrotransposable element in the genus Drosophila</article-title><source>Mol Biol Evol</source><year>1995</year><volume>12</volume><fpage>1094</fpage><lpage>1105</lpage><pub-id pub-id-type="pmid">8524042</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lathe</surname><given-names>WC</given-names><suffix>3rd</suffix></name><name><surname>Eickbush</surname><given-names>TH</given-names></name></person-group><article-title>A single lineage of r2 retrotransposable elements is an active, evolutionarily stable component of the Drosophila rDNA locus</article-title><source>Mol Biol Evol</source><year>1997</year><volume>14</volume><fpage>1232</fpage><lpage>1241</lpage><pub-id pub-id-type="pmid">9402733</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mouches</surname><given-names>C</given-names></name><name><surname>Bensaadi</surname><given-names>N</given-name