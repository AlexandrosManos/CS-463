pan="1" colspan="1">0.15</td><td align="left" rowspan="1" colspan="1">0.45</td><td align="left" rowspan="1" colspan="1">0.80</td><td align="left" rowspan="1" colspan="1">0.65</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">NC</td><td align="left" rowspan="1" colspan="1">0.68</td><td align="left" rowspan="1" colspan="1">0.95</td><td align="left" rowspan="1" colspan="1">0.88</td><td align="left" rowspan="1" colspan="1">NC</td><td align="left" rowspan="1" colspan="1">0.99</td></tr><tr><td align="left" rowspan="1" colspan="1">hsa-mir-198</td><td align="left" rowspan="1" colspan="1">rs1700</td><td align="left" rowspan="1" colspan="1">C/T</td><td align="left" rowspan="1" colspan="1">0.12</td><td align="left" rowspan="1" colspan="1">0.07</td><td align="left" rowspan="1" colspan="1">0.09</td><td align="left" rowspan="1" colspan="1">0.10</td><td align="left" rowspan="1" colspan="1">0.04</td><td align="left" rowspan="1" colspan="1">0.11</td><td align="left" rowspan="1" colspan="1">0.07</td><td align="left" rowspan="1" colspan="1">0.60</td><td align="left" rowspan="1" colspan="1">0.25</td><td align="left" rowspan="1" colspan="1">0.12</td><td align="left" rowspan="1" colspan="1">0.18</td><td align="left" rowspan="1" colspan="1"><bold>0.04</bold></td><td align="left" rowspan="1" colspan="1">0.13</td><td align="left" rowspan="1" colspan="1">0.35</td><td align="left" rowspan="1" colspan="1"><bold>0.02</bold></td></tr><tr><td align="left" rowspan="1" colspan="1">hsa-mir-206</td><td align="left" rowspan="1" colspan="1">rs17578796</td><td align="left" rowspan="1" colspan="1">C/T</td><td align="left" rowspan="1" colspan="1">0.004</td><td align="left" rowspan="1" colspan="1">0.014</td><td align="left" rowspan="1" colspan="1">0.012</td><td align="left" rowspan="1" colspan="1">0.016</td><td align="left" rowspan="1" colspan="1">0.006</td><td align="left" rowspan="1" colspan="1">0.014</td><td align="left" rowspan="1" colspan="1">1</td><td align="