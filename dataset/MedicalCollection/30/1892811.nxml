 id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Baldi</surname><given-names>PF</given-names></name><name><surname>Brunak</surname><given-names>S</given-names></name></person-group><source>Bioinformatics: The machine learning approach</source><year>1998</year><publisher-name>Cambridge, MA , MIT Press</publisher-name><fpage>91</fpage><lpage>104</lpage></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chalk</surname><given-names>AM</given-names></name><name><surname>Sonnhammer</surname><given-names>EL</given-names></name></person-group><article-title>Computational antisense oligo prediction with a neural network model</article-title><source>Bioinformatics</source><year>2002</year><volume>18</volume><fpage>1567</fpage><lpage>1575</lpage><pub-id pub-id-type="pmid">12490440</pub-id><pub-id pub-id-type="doi">10.1093/bioinformatics/18.12.1567</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shabalina</surname><given-names>SA</given-names></name><name><surname>Spiridonov</surname><given-names>AN</given-names></name><name><surname>Ogurtsov</surname><given-names>AY</given-names></name></person-group><article-title>Computational models with thermodynamic and composition features improve siRNA design</article-title><source>BMC Bioinformatics</source><year>2006</year><volume>7</volume><fpage>65</fpage><pub-id pub-id-type="pmid">16472402</pub-id><pub-id pub-id-type="doi">10.1186/1471-2105-7-65</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lisboa</surname><given-names>PJ</given-names></name><name><surname>Taktak</surname><given-names>AF</given-names></name></person-group><article-title>The use of artificial neural networks in decision support in cancer: a systematic review</article-title><source>Neural N