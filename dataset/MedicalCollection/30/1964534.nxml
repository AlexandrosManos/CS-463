id-type="pmid">12538249</pub-id></citation></ref><ref id="pone.0000881-Ma2"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ma</surname><given-names>HW</given-names></name><name><surname>Zeng</surname><given-names>AP</given-names></name></person-group><year>2003b</year><article-title>The connectivity structure, giant strong component and centrality of metabolic networks.</article-title><source>Bioinformatics</source><volume>19</volume><fpage>1423</fpage><lpage>1430</lpage><pub-id pub-id-type="pmid">12874056</pub-id></citation></ref><ref id="pone.0000881-Wagner1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wagner</surname><given-names>A</given-names></name><name><surname>Fell</surname><given-names>DA</given-names></name></person-group><year>2001</year><article-title>The small world inside large metabolic networks.</article-title><source>Proc R Soc Lond B</source><volume>268</volume><fpage>1803</fpage><lpage>1810</lpage></citation></ref><ref id="pone.0000881-vanHelden1"><label>19</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>van Helden</surname><given-names>J</given-names></name><name><surname>Wernisch</surname><given-names>L</given-names></name><name><surname>Gilbert</surname><given-names>D</given-names></name><name><surname>Wodak</surname><given-names>S</given-names></name></person-group><year>2002</year><article-title>Graph-based analysis of metabolic networks.</article-title><person-group person-group-type="editor"><name><surname>Mewes</surname><given-names>HW</given-names></name><name><surname>Seidel</surname><given-names>H</given-names></name><name><surname>Weiss</surname><given-names>B</given-names></name></person-group><source>Bioinformatics and Genome Analysis, volume 38 of Ernst Schering Research Foundation Workshop</source><publisher-name>Springer Verlag</publisher-name><fpage>245</fpage><l