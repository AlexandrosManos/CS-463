-title>Kernel-based data fusion and its application to protein function prediction in yeast</article-title><source>Pac Symp Biocomput</source><year>2004</year><fpage>300</fpage><lpage>311</lpage><pub-id pub-id-type="pmid">14992512</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Letovsky</surname><given-names>S</given-names></name><name><surname>Kasif</surname><given-names>S</given-names></name></person-group><article-title>Predicting protein function from protein/protein interaction data: a probabilistic approach</article-title><source>Bioinformatics</source><year>2003</year><volume>19</volume><fpage>i197</fpage><lpage>i204</lpage><pub-id pub-id-type="pmid">12855458</pub-id><pub-id pub-id-type="doi">10.1093/bioinformatics/btg1026</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Deng</surname><given-names>M</given-names></name><name><surname>Zhang</surname><given-names>K</given-names></name><name><surname>Mehta</surname><given-names>S</given-names></name><name><surname>Chen</surname><given-names>T</given-names></name><name><surname>Sun</surname><given-names>F</given-names></name></person-group><article-title>Prediction of protein function using protein-protein interaction data</article-title><source>J Comput Biol</source><year>2003</year><volume>10</volume><fpage>947</fpage><lpage>960</lpage><pub-id pub-id-type="pmid">14980019</pub-id><pub-id pub-id-type="doi">10.1089/106652703322756168</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vazquez</surname><given-names>A</given-names></name><name><surname>Flammi</surname><given-names>A</given-names></name><name><surname>Maritan</surname><given-names>A</given-names></name><name><surname>Vespignani</surname><given-names>A</given-names></name></person-group><article-title>Global protein f