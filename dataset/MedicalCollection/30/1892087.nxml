                                              <mml:mo>)</mml:mo>                                                   </mml:mrow>                                                </mml:mrow>                                                <mml:mo>)</mml:mo>                                             </mml:mrow>                                          </mml:mrow>                                       </mml:munder>                                       <mml:mrow>                                          <mml:msub>                                             <mml:mi>r</mml:mi>                                             <mml:mrow>                                                <mml:mi>u</mml:mi>                                                <mml:mo>,</mml:mo>                                                <mml:mi>w</mml:mi>                                             </mml:mrow>                                          </mml:msub>                                          <mml:msub>                                             <mml:mi>r</mml:mi>                                             <mml:mrow>                                                <mml:mi>v</mml:mi>                                                <mml:mo>,</mml:mo>                                                <mml:mi>w</mml:mi>                                             </mml:mrow>                                          </mml:msub>                                       </mml:mrow>                                    </mml:mstyle>                                    <mml:mo>+</mml:mo>                                    <mml:msub>                                       <mml:mi>&#x003bb;</mml:mi>                                       <mml:mrow>                                          <mml:mi>u</mml:mi>                                          <mml:mo>,</mml:mo>                                          <mml:mi>v</mml:mi>                                       </mml:mrow>                                    </mml: