ext-link-type="uri" xlink:href="http://seer.cancer.gov/csr/1973_1999/">http://seer.cancer.gov/csr/1973_1999/</ext-link></comment></citation></ref><ref id="B18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jemal</surname><given-names>A</given-names></name><name><surname>Siegel</surname><given-names>R</given-names></name><name><surname>Ward</surname><given-names>E</given-names></name><name><surname>Murray</surname><given-names>T</given-names></name><name><surname>Xu</surname><given-names>J</given-names></name><name><surname>Smigal</surname><given-names>C</given-names></name><etal/></person-group><volume>56</volume><issue>2</issue><year>2006</year><fpage>106</fpage><lpage>130</lpage><article-title>Cancer statistics, 2006</article-title><source>CA Cancer J Clin</source><pub-id pub-id-type="pmid">16514137</pub-id></citation></ref><ref id="B19"><label>19</label><citation citation-type="book"><source>Cancer facts and figures 2005</source><publisher-loc>Atlanta (GA)</publisher-loc><publisher-name>American Cancer Society</publisher-name><year>2005</year><access-date>cited 2006 Oct 30</access-date><comment>Available from:<ext-link ext-link-type="uri" xlink:href="http://www.cancer.org/docroot/STT/stt_0_2005.asp?sitearea=STT&#x00026;level=1">http://www.cancer.org/docroot/STT/stt_0_2005.asp?sitearea=STT&#x00026;level=1</ext-link></comment></citation></ref><ref id="B20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Potter</surname><given-names>JD</given-names></name></person-group><volume>268</volume><issue>12</issue><year>1992</year><fpage>1573</fpage><lpage>1577</lpage><article-title>Reconciling the epidemiology, physiology, and molecular biology of colon cancer</article-title><source>JAMA</source><pub-id pub-id-type="pmid">1518112</pub-id></citation></ref><ref id="B21"><label>21</label><citation citation-type="journal"><person-group person-group-type="auth