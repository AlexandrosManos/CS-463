><issue>2</issue><year>2006</year><fpage>137</fpage><lpage>146</lpage><article-title>Dietary risk factors for ovarian cancer: the Adventist Health Study (United States)</article-title><source>Cancer Causes Control</source><pub-id pub-id-type="pmid">16425091</pub-id></citation></ref><ref id="B12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Snowdon</surname><given-names>DA</given-names></name><name><surname>Phillips</surname><given-names>RL</given-names></name></person-group><volume>75</volume><issue>5</issue><year>1985</year><fpage>507</fpage><lpage>512</lpage><article-title>Does a vegetarian diet reduce the occurrence of diabetes?</article-title><source>Am J Public Health</source><pub-id pub-id-type="pmid">3985239</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="book"><source>Summary health statistics for U.S. adults: 2004.&#x000a0;(Table 2)</source><publisher-loc>Atlanta (GA)</publisher-loc><publisher-name>U.S. Department of Health and Human Services, Centers for Disease Control and Prevention, National Center for Health Statistics</publisher-name><year>2005</year><access-date>cited 2006 Oct 30</access-date><comment>Available from:<ext-link ext-link-type="uri" xlink:href="http://www.cdc.gov/nchs/data/series/sr_10/sr10_228.pdf">http://www.cdc.gov/nchs/data/series/sr_10/sr10_228.pdf</ext-link></comment></citation></ref><ref id="B14"><label>14</label><citation citation-type="book"><source>High blood pressure facts</source><publisher-name>U.S. Department of Health and Human Services, Centers for Disease Control and Prevention, National Center for Chronic Disease Prevention and Health Promotion</publisher-name><publisher-loc>Atlanta (GA)</publisher-loc><year>2006</year><access-date>cited 2006 Oct 30</access-date><comment>Available from:<ext-link ext-link-type="uri" xlink:href="http://www.cdc.gov/bloodpressure/facts.htm">http://www.cdc.gov/bloodpressure/facts.htm</ext-link></co