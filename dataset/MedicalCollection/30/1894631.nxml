citation-type="journal"><person-group person-group-type="author"><name><surname>Berry</surname><given-names>MJ</given-names></name><name><surname>Warland</surname><given-names>DK</given-names></name><name><surname>Meister</surname><given-names>M</given-names></name></person-group><article-title>The structure and precision of retinal spike trains</article-title><source>Proc Natl Acad Sci USA</source><year>1997</year><volume>94</volume><fpage>5411</fpage><lpage>5416</lpage><pub-id pub-id-type="pmid">9144251</pub-id><pub-id pub-id-type="doi">10.1073/pnas.94.10.5411</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meister</surname><given-names>M</given-names></name><name><surname>Berry</surname><given-names>MJ</given-names></name></person-group><article-title>The neural code of the retina</article-title><source>Neuron</source><year>1999</year><volume>22</volume><fpage>435</fpage><lpage>450</lpage><pub-id pub-id-type="pmid">10197525</pub-id><pub-id pub-id-type="doi">10.1016/S0896-6273(00)80700-X</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>DeVries</surname><given-names>SH</given-names></name></person-group><article-title>Correlated firing in rabbit retinal ganglion cells</article-title><source>J Neurophysiol</source><year>1999</year><volume>81</volume><fpage>908</fpage><lpage>920</lpage><pub-id pub-id-type="pmid">10036288</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Usrey</surname><given-names>WM</given-names></name><name><surname>Reid</surname><given-names>RC</given-names></name></person-group><article-title>Synchronous activity in the visual system</article-title><source>Annu Rev Physiol</source><year>1999</year><volume>61</volume><fpage>435</fpage><lpage>456</lpage><pub-id pub-id-type="pmid">10099696</pub-id><pub-id pub-id-type="doi">10.1146/annurev.physiol.61.1.435</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brivanlou</surname><given-names>IH</given-names></name><name><surname>Warland</surname><given-names>DK</given-names></name><name><surname>Meister</surname><given-names>M</given-names></name></person-group><article-title>Mechanisms of concerted firing among retinal ganglion cells</article-title><source>Neuron</source><year>1998</year><volume>20</volume><fpage>527</fpage><lpage>539</lpage><pub-id pub-id-type="pmid">9539126</pub-id><pub-id pub-id-type="doi">10.1016/S0896-6273(00)80992-7</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meister</surname><given-names>M</given-names></name><name><surname>Lagnado</surname><given-names>L</given-names></name><name><surname>Baylor</surname><given-names>DA</given-names></name></person-group><article-title>Concerted signaling by retinal ganglion cells</article-title><source>Science</source><year>1995</year><volume>270</volume><fpage>1207</fpage><lpage>1210</lpage><pub-id pub-id-type="pmid">7502047</pub-id><pub-id pub-id-type="doi">10.1126/science.270.5239.1207</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Neuenschwander</surname><given-names>S</given-names></name><name><surname>Singer</surname><given-names>W</given-names></name></person-group><article-title>Long-range synchronization of oscillatory light responses in the cat retina and lateral geniculate nucleus</article-title><source>Nature</source><year>1996</year><volume>379</volume><fpage>728</fpage><lpage>732</lpage><pub-id pub-id-type="pmid">8602219</pub-id><pub-id pub-id-type="doi">10.1038/379728a0</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Neuenschwander</su