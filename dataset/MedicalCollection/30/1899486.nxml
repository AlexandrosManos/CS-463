article-title>Field notes Afghanistan insurgency assessment the signs of an escalating crisis</article-title><source>London</source><year>2006</year></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Andoh</surname><given-names>SY</given-names></name><name><surname>Umezaki</surname><given-names>M</given-names></name><name><surname>Nakamura</surname><given-names>K</given-names></name><name><surname>Kizuki</surname><given-names>M</given-names></name><name><surname>Takano</surname><given-names>T</given-names></name></person-group><article-title>Correlation between national income, HIV/AIDS and political status and mortalities in African countries</article-title><source>Journal of Public Health</source><year>2006</year><volume>120</volume><fpage>624</fpage><lpage>633</lpage><pub-id pub-id-type="doi">10.1016/j.puhe.2006.04.008</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Babar</surname><given-names>T</given-names></name><name><surname>Hatcher</surname><given-names>J</given-names></name></person-group><article-title>Health seeking behavior and health service utilization in Pakistan: Challenging the policy makers</article-title><source>Journal of Public Health</source><year>2005</year><volume>27</volume><fpage>49</fpage><lpage>54</lpage><pub-id pub-id-type="pmid">15590705</pub-id><pub-id pub-id-type="doi">10.1093/pubmed/fdh207</pub-id></citation></ref></ref-list></back></article>