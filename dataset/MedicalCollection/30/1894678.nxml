oc>Aalborg</publisher-loc><publisher-name>Forlaget ALUFUFF</publisher-name><comment/><comment>[in Danish]</comment></element-citation></ref><ref id="r11"><label>11</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>M&#x000f8;nsted</surname><given-names>M</given-names></name></person-group><source>Strategic networking in small high tech firms</source><year>2003</year><publisher-loc>Copenhagen</publisher-loc><publisher-name>Samfundslitteratur</publisher-name></element-citation></ref><ref id="r12"><label>12</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Axelsson</surname><given-names>R</given-names></name><name><surname>Axelsson</surname><given-names>SB</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Axelsson</surname><given-names>R</given-names></name><name><surname>Axelsson</surname><given-names>SB</given-names></name></person-group><article-title>Samverkan och folkh&#x000e4;lsa&#x02014;begrepp, teorier och praktisk till&#x000e4;mpning</article-title><trans-title>Collaboration and public health&#x02014;concepts, theories and practical approach</trans-title><source>Folkh&#x000e4;lsa i samverkan mellan professioner och samh&#x000e4;llsektorer</source><trans-source>Public health in inter-professional relations and social sectors</trans-source><year>2007</year><publisher-loc>Pozkal, Poland</publisher-loc><publisher-name>Studentlitteratur</publisher-name><fpage>11</fpage><lpage>31</lpage><comment>[in Danish]</comment></element-citation></ref><ref id="r13"><label>13</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Alter</surname><given-names>C</given-names></name><name><surname>Hage</surname><given-names>J</given-names></name></person-group><source>Organisations working together</source><year>1993</year><publisher-loc>Newbury Park (CA)</publisher-loc><publisher-name>Sage Publications</publisher-name><fpage>23</fpage><lpage>119</lpage></element-citation></ref><ref id="r14"><label>14</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Gustafsson</surname><given-names>J</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Axelsson</surname><given-names>R</given-names></name><name><surname>Axelsson</surname><given-names>SB</given-names></name></person-group><article-title>Ledarskap i interorganisatoriska n&#x000e4;tverk f&#x000f6;r folkh&#x000e4;lsa och v&#x000e4;lf&#x000e4;rd</article-title><trans-title>Managing inter-organisational networks in public health and welfare</trans-title><source>Folkh&#x000e4;lsa i samverkan mellan professioner och samh&#x000e4;llsektorer</source><trans-source>Public health in inter-professional relations and social sectors</trans-source><year>2007</year><publisher-loc>Pozkal Poland</publisher-loc><publisher-name>Studentlitteratur</publisher-name><fpage>61</fpage><lpage>86</lpage><comment>[in Danish]</comment></element-citation></ref><ref id="r15"><label>15</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Thomson</surname><given-names>J</given-names></name></person-group><source>Organizations in actions</source><year>1967</year><publisher-loc>New York</publisher-loc><publisher-name>McGraw-Hill</publisher-name></element-citation></ref><ref id="r16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Axelsson</surname><given-names>R</given-names></name><name><surname>Axelsson</surname><given-names>SB</given-names></name></person-group><article-title>Integration and collaboration in public health&#x02014;a conceptual framework</article-title><source>International Journal of Health Planning and Management</source><year>2006</year><season>Jan-Mar</season><volume>21</volume><issue>1</issue><fpage>75</fpage><lpage>88</lpage><pub-id pub-id-type="pmid">16604850</pub-id></element-citation></ref><ref id="r17"><label>17</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Lawrence</surname><given-names>PA</given-names></name><name><surname>Lorsch</surname><given-names>JW</given-names></name></person-group><source>Organization and environment: managing differentiation and integration</source><year>1967</year><publisher-loc>Boston (MA)</publisher-loc><publisher-name>Harvard University Press</publisher-name></element-citation></ref><ref id="r18"><label>18</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Yin</surname><given-names>RK</given-names></name></person-group><source>Case study Research design and methods</source><year>2003</year><publisher-loc>Thousand Oaks (CA)</publisher-loc><publisher-name>Sage Publications</publisher-name></element-citation></ref><ref id="r19"><label>19</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Maal&#x000f8;e</surname><given-names>E</given-names></name></person-group><source>Case-studier af og om mennesker i organisationer</source><trans-source>Case Studies about Human Beings in Organizations</trans-source><year>1999</year><publisher-loc>Copenhagen</publisher-loc><publisher-name>Akademisk Forlag</publisher-name><comment>[in Danish]</comment></element-citation></ref><ref id="r20"><label>20</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Delamont</surname><given-names>S</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Seale</surname><given-names>C</given-names></name><etal/></person-group><article-title>Ethnography and participant observation</article-title><source>Qualitative research practice</source><year>2007</year><publisher-loc>London</publisher-loc><publisher-name>Sage 