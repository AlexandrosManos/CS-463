 id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Biberstein</surname><given-names>EL</given-names></name><name><surname>Shreeve</surname><given-names>BJ</given-names></name><name><surname>Thompson</surname><given-names>DA</given-names></name></person-group><article-title>Variation in carrier rates of <italic>Pasteurella haemolytica </italic>in sheep flocks I. Normal flocks</article-title><source>J Comp Path</source><year>1970</year><volume>80</volume><fpage>499</fpage><lpage>507</lpage><pub-id pub-id-type="pmid">5531124</pub-id><pub-id pub-id-type="doi">10.1016/0021-9975(70)90046-0</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fraser</surname><given-names>J</given-names></name><name><surname>Gilmour</surname><given-names>NJL</given-names></name><name><surname>Laird</surname><given-names>S</given-names></name><name><surname>Donachie</surname><given-names>W</given-names></name></person-group><article-title>Prevalence of <italic>Pasteurella haemolytica </italic>serotypes isolated from ovine pasteurellosis in Britain</article-title><source>Vet Rec</source><year>1982</year><volume>110</volume><fpage>560</fpage><lpage>561</lpage><pub-id pub-id-type="pmid">7112871</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gilmour</surname><given-names>NJL</given-names></name><name><surname>Thompson</surname><given-names>DA</given-names></name><name><surname>Fraser</surname><given-names>J</given-names></name></person-group><article-title>The recovery of <italic>Pasteurella haemolytica </italic>from the tonsils of adult sheep</article-title><source>Res Vet Sci</source><year>1974</year><volume>17</volume><fpage>413</fpage><lpage>414</lpage><pub-id pub-id-type="pmid">4445591</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shreeve</surname><given-names>BJ</given-names></name><name><surname>Thompson</surname><given-names>DA</given-names></name></person-group><article-title>Studies on the carriage of <italic>Pasteurella haemolytica </italic>in lambs</article-title><source>J Comp Path</source><year>1970</year><volume>80</volume><fpage>107</fpage><lpage>112</lpage><pub-id pub-id-type="pmid">5461441</pub-id><pub-id pub-id-type="doi">10.1016/0021-9975(70)90037-X</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shreeve</surname><given-names>BJ</given-names></name><name><surname>Biberstein</surname><given-names>EL</given-names></name><name><surname>Thompson</surname><given-names>DA</given-names></name></person-group><article-title>Variation in carrier rates of <italic>Pasteurella haemolytica </italic>in sheep. II. Diseased flocks</article-title><source>J Comp Path</source><year>1972</year><volume>82</volume><fpage>111</fpage><lpage>116</lpage><pub-id pub-id-type="pmid">5062917</pub-id><pub-id pub-id-type="doi">10.1016/0021-9975(72)90034-5</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bisgaard</surname><given-names>M</given-names></name></person-group><article-title>Ecology and Significance of <italic>Pasteurellaceae </italic>in Animals</article-title><source>Zentralbl Bakteriol</source><year>1993</year><volume>279</volume><fpage>7</fpage><lpage>26</lpage><pub-id pub-id-type="pmid">8369587</pub-id></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gilmour</surname><given-names>NJL</given-names></name><name><surname>Gilmour</surname><given-names>JS</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Adlam C, Rutter JM</surname></name></person-group><article-title>Pasteurellosis of sheep</article-title><source>Pasteurella and Pasteurellosis</source><year>1989</year><publisher-name>London: Academic Press</publisher-name><fpage>223</fpage><lpage>262</lpage></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bisgaard</surname><given-names>M</given-names></name></person-group><article-title>Characterization of atypical <italic>Actinobacillus lignieresii </italic>isolated from ducks with salpingitis and peritonitis</article-title><source>Nord Vet Med</source><year>1975</year><volume>27</volume><fpage>378</fpage><lpage>383</lpage><pub-id pub-id-type="pmid">1161454</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Christie</surname><given-names>R</given-names></name><name><surname>Atkins</surname><given-names>NE</given-names></name><name><surname>Munch-Petersen</surname><given-names>E</given-names></name></person-group><article-title>A note on a lytic phenomenon shown by group B streptococci</article-title><source>Aust J Exp Biol Med Sci</source><year>1944</year><volume>22</volume><fpage>197</fpage><lpage>200</lpage></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Angen</surname><given-names>&#x000d8;</given-names></name></person-group><article-title>Taxonomy of the ruminant, porcine and leprine [<italic>Pasteurella</italic>] <italic>haemolytica</italic>-complex</article-title><source>PhD-thesis</source><year>1997</year><publisher-name>The Royal Veterinary and Agricultural University, Copenhagen, Department of Veterinary Microbiology</publisher-name></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Christensen</surname><given-names>H</given-names></name><name><surname>Bisgaard</surname><given-names>M</given-names></name><name><surname>Bojesen</surname><given-names>AM</given-names></name><name><