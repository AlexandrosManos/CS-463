ar>2006</year><volume>7</volume><fpage>132</fpage><pub-id pub-id-type="pmid">16737546</pub-id><pub-id pub-id-type="doi">10.1186/1471-2164-7-132</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Missirlis</surname><given-names>PI</given-names></name><name><surname>Mead</surname><given-names>CR</given-names></name><name><surname>Butland</surname><given-names>SL</given-names></name><name><surname>Ouellette</surname><given-names>BF</given-names></name><name><surname>Devon</surname><given-names>RS</given-names></name><name><surname>Leavitt</surname><given-names>BR</given-names></name><name><surname>Holt</surname><given-names>RA</given-names></name></person-group><article-title>Satellog: A database for the identification and prioritization of satellite repeats in disease association studies</article-title><source>BMC Bioinformatics</source><year>2005</year><volume>10</volume><fpage>145</fpage><pub-id pub-id-type="pmid">15949044</pub-id><pub-id pub-id-type="doi">10.1186/1471-2105-6-145</pub-id></citation></ref><ref id="B14"><citation citation-type="other"><article-title>Microsat2006</article-title><ext-link ext-link-type="uri" xlink:href="http://www.microsatellites.org/db_search.php"/></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chang</surname><given-names>Y-H</given-names></name><name><surname>Su</surname><given-names>W-H</given-names></name><name><surname>Lee</surname><given-names>T-C</given-names></name><name><surname>Sun</surname><given-names>H-FS</given-names></name><name><surname>Chen</surname><given-names>C-H</given-names></name><name><surname>Pan</surname><given-names>W-H</given-names></name><name><surname>Tsai</surname><given-names>S-F</given-names></name><name><surname>Jou</surname><given-names>Y-S</given-names></name></person-group><article-title>TPMD: a database and resources of microsatellite marker genotype