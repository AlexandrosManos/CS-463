 id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sreenu</surname><given-names>VB</given-names></name><name><surname>Alevoor</surname><given-names>V</given-names></name><name><surname>Nagaraju</surname><given-names>J</given-names></name><name><surname>Nagarajaram</surname><given-names>HA</given-names></name></person-group><article-title>MICdb: database of prokaryotic microsatellites</article-title><source>Nucleic Acids Res</source><year>2003</year><volume>31</volume><fpage>106</fpage><lpage>108</lpage><pub-id pub-id-type="pmid">12519959</pub-id><pub-id pub-id-type="doi">10.1093/nar/gkg002</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Prasad</surname><given-names>MD</given-names></name><name><surname>Muthulakshmi</surname><given-names>M</given-names></name><name><surname>Arunkumar</surname><given-names>KP</given-names></name><name><surname>Madhu</surname><given-names>M</given-names></name><name><surname>Sreenu</surname><given-names>VB</given-names></name><name><surname>Pavithra</surname><given-names>V</given-names></name><name><surname>Bose</surname><given-names>B</given-names></name><name><surname>Nagarajaram</surname><given-names>HA</given-names></name><name><surname>Mita</surname><given-names>K</given-names></name><name><surname>Shimada</surname><given-names>T</given-names></name><name><surname>Nagaraju</surname><given-names>J</given-names></name></person-group><article-title>SilkSatDb: a microsatellite database of the silkworm, <italic>Bombyx mori</italic></article-title><source>Nucleic Acids Res</source><year>2005</year><volume>33</volume><fpage>D403</fpage><lpage>D406</lpage><pub-id pub-id-type="pmid">15608226</pub-id><pub-id pub-id-type="doi">10.1093/nar/gki099</pub-id></citation></ref><ref id="B11"><citation citation-type="other"><article-title>Mouse Microsatellite Data Base of Japan (MMDBJ)</article-title><ext-link ext-link-type