 id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vaiman</surname><given-names>M</given-names></name><name><surname>Eviatar</surname><given-names>E</given-names></name><name><surname>Segal</surname><given-names>S</given-names></name></person-group><article-title>Evaluation of stages of normal deglutition with the help of rectified surface electromyography records</article-title><source>Dysphagia</source><year>2004</year><volume>19</volume><fpage>125</fpage><lpage>32</lpage><pub-id pub-id-type="pmid">15382801</pub-id><pub-id pub-id-type="doi">10.1007/s00455-003-0504-x</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vaiman</surname><given-names>M</given-names></name><name><surname>Eviatar</surname><given-names>E</given-names></name><name><surname>Gabriel</surname><given-names>Ch</given-names></name><name><surname>Segal</surname><given-names>S</given-names></name></person-group><article-title>Rectified and filtered surface electromyography of continuous drinking in healthy adults</article-title><source>Laryngoscope</source><year>2005</year><volume>115</volume><fpage>68</fpage><lpage>73</lpage><pub-id pub-id-type="pmid">15630369</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vaiman</surname><given-names>M</given-names></name><name><surname>Segal</surname><given-names>S</given-names></name><name><surname>Eviatar</surname><given-names>E</given-names></name></person-group><article-title>Surface electromyographic studies of swallowing in normal children, age 4&#x02013;12</article-title><source>J Pediatr Otorhinolaryngol</source><year>2004</year><volume>68</volume><fpage>65</fpage><lpage>73</lpage><pub-id pub-id-type="doi">10.1016/j.ijporl.2003.09.014</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><n