n-group><source>Evaluation and treatment of swallowing disorders</source><year>1983</year><publisher-name>San Diego, CA: College Hill Press</publisher-name></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Erb</surname><given-names>W</given-names></name></person-group><source>Handbuch der Electrotherapie</source><year>1886</year><publisher-name>2 Aufl., Leipzig: Vogel</publisher-name><fpage>34</fpage><lpage>45</lpage></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Remak</surname><given-names>E</given-names></name></person-group><source>Grundriss der Electrodiagnostik und Electrotherapie</source><year>1909</year><publisher-name>2 Aufl., Wien: Meyer</publisher-name><fpage>26</fpage><lpage>34</lpage></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Goodgold</surname><given-names>J</given-names></name></person-group><source>Anatomical correlates of clinical electromyography</source><year>1975</year><edition>1</edition><publisher-name>Baltimore: The Williams &#x00026; Wilkins Company</publisher-name><fpage>2</fpage><lpage>3</lpage></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stalberg</surname><given-names>E</given-names></name><name><surname>Fuglsang-Frederiksen</surname><given-names>A</given-names></name><name><surname>Bischoff</surname><given-names>C</given-names></name></person-group><article-title>Quantitation and standardization in EMG and neurography</article-title><source>Suppl Clin Neurophysiol</source><year>2000</year><volume>53</volume><fpage>101</fpage><lpage>11</lpage><pub-id pub-id-type="pmid">12740983</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bolton</surname><given-names>CF</given-names></name><