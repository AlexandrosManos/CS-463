person-group person-group-type="author"><name><surname>Pang</surname><given-names>Y-P</given-names></name></person-group><year>2007</year><article-title>In silico drug discovery: solving the &#x0201c;target-rich and lead-poor&#x0201d; imbalance using the genome-to-drug-lead paradigm.</article-title><source>Clin Pharmacol Ther</source><volume>81</volume><fpage>30</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">17185996</pub-id></citation></ref><ref id="pone.0000820-Pang4"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pang</surname><given-names>Y-P</given-names></name><name><surname>Mullins</surname><given-names>T</given-names></name><name><surname>Swartz</surname><given-names>B</given-names></name><name><surname>McAllister</surname><given-names>J</given-names></name><name><surname>Smith</surname><given-names>B</given-names></name><etal/></person-group><year>2007</year><article-title>EUDOC on Blue Gene: accelerating the transfer of drug discoveries from laboratory to patient.</article-title><source>IBM J Res Dev in press</source></citation></ref><ref id="pone.0000820-Jorgensen1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jorgensen</surname><given-names>WL</given-names></name></person-group><year>1991</year><article-title>Rusting of the lock and key model for protein-ligand binding.</article-title><source>Science</source><volume>254</volume><fpage>954</fpage><lpage>955</lpage><pub-id pub-id-type="pmid">1719636</pub-id></citation></ref><ref id="pone.0000820-Vieth1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vieth</surname><given-names>M</given-names></name><name><surname>Hirst</surname><given-names>JD</given-names></name><name><surname>Brooks</surname><given-names>CL</given-names><suffix>III</suffix></name></person-group><year>1998</year><article-title>Do active site conformations of small ligands correspond to low free-energy solution structures?</article-title><source>J Comput-Aided Mol Design</source><volume>12</volume><fpage>563</fpage><lpage>572</lpage></citation></ref><ref id="pone.0000820-Bostrm1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bostr&#x000f6;m</surname><given-names>J</given-names></name><name><surname>Norrby</surname><given-names>P-O</given-names></name><name><surname>Liljefors</surname><given-names>T</given-names></name></person-group><year>1998</year><article-title>Conformational energy penalties of protein-bound ligands.</article-title><source>J Comput-Aided Mol Design</source><volume>12</volume><fpage>383</fpage><lpage>396</lpage></citation></ref><ref id="pone.0000820-Nicklaus1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nicklaus</surname><given-names>MC</given-names></name><name><surname>Wang</surname><given-names>S</given-names></name><name><surname>Driscoll</surname><given-names>JS</given-names></name><name><surname>Milne</surname><given-names>GW</given-names></name></person-group><year>1995</year><article-title>Conformational changes of small molecules binding to proteins.</article-title><source>Bioorg Med Chem</source><volume>3</volume><fpage>411</fpage><lpage>428</lpage><pub-id pub-id-type="pmid">8581425</pub-id></citation></ref><ref id="pone.0000820-Perola1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Perola</surname><given-names>E</given-names></name><name><surname>Charifson</surname><given-names>PS</given-names></name></person-group><year>2004</year><article-title>Conformational analysis of drug-like molecules bound to proteins: an extensive study of ligand reorganization upon binding.</article-title><source>J Med Chem</source><volume>47</volume><fpage>2499</fpage><lpage>2510</lpage><pub-id pub-id-type="pmid">15115393</pub-id></citation></ref><ref id="pone.0000820-Hinsen1"><label>14</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hinsen</surname><given-names>K</given-names></name></person-group><year>2006</year><article-title>Normal mode theory and harmonic potential approximations;</article-title><person-group person-group-type="editor"><name><surname>Cui</surname><given-names>Q</given-names></name><name><surname>Bahar</surname><given-names>I</given-names></name></person-group><publisher-loc>Boca Raton</publisher-loc><publisher-name>Chapman &#x00026; Hall/CRC</publisher-name><fpage>1</fpage><lpage>16</lpage></citation></ref><ref id="pone.0000820-Case1"><label>15</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Case</surname><given-names>D</given-names></name></person-group><year>1999</year><article-title>Rigidity theory and applications;</article-title><person-group person-group-type="editor"><name><surname>Thorpe</surname><given-names>M</given-names></name><name><surname>Duxbury</surname><given-names>P</given-names></name></person-group><publisher-loc> New York</publisher-loc><publisher-name>Kluwer Academic/Plenum Publishers</publisher-name><fpage>329</fpage><lpage>344</lpage></citation></ref><ref id="pone.0000820-Jensen1"><label>16</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Jensen</surname><given-names>F</given-names></name></person-group><year>1998</year><article-title>Introduction to computational chemistry.</article-title><publisher-loc>New York</publisher-loc><publisher-name>John Wiley &#x00026; Sons</publisher-name><fpage>312</fpage><lpage>315</lpage></citation></ref><ref id="pone.0000820-Cramer1"><label>17</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cramer</surname><given-names>CJ</given-names></name></person-group><year>2002</year><article-title>Essentials of computational chemistry.</art