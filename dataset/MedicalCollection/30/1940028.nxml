002</year><volume>55</volume><fpage>127</fpage><lpage>137</lpage><pub-id pub-id-type="pmid">12107590</pub-id><pub-id pub-id-type="doi">10.1007/s00239-001-2307-8</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maidak</surname><given-names>BL</given-names></name><name><surname>Olsen</surname><given-names>GJ</given-names></name><name><surname>Larsen</surname><given-names>N</given-names></name><name><surname>Overbeek</surname><given-names>R</given-names></name><name><surname>McCaughey</surname><given-names>MJ</given-names></name><name><surname>Woese</surname><given-names>CR</given-names></name></person-group><article-title>The RDP (Ribosomal Database Project)</article-title><source>Nucleic Acids Res</source><year>1997</year><volume>25</volume><fpage>109</fpage><lpage>111</lpage><pub-id pub-id-type="pmid">9016515</pub-id><pub-id pub-id-type="doi">10.1093/nar/25.1.109</pub-id></citation></ref></ref-list></back></article>