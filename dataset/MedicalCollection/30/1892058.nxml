<name><surname>Nicolaides</surname><given-names>KH</given-names></name></person-group><article-title>Shirodkar versus McDonald cerclage for the prevention of preterm birth in women with short cervical length</article-title><source>Am J Perinatol</source><year>2007</year><volume>24</volume><fpage>55</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">17195146</pub-id><pub-id pub-id-type="doi">10.1055/s-2006-958165</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Br&#x000f6;lmann</surname><given-names>HAM</given-names></name><name><surname>Oei</surname><given-names>SG</given-names></name></person-group><article-title>The laparoscopic approach of the transabdominal cerclage of the uterine cervix in case of cervical incompetence</article-title><source>Gynaecol Endoscopy</source><year>2000</year><volume>9</volume><fpage>191</fpage><lpage>194</lpage><pub-id pub-id-type="doi">10.1046/j.1365-2508.2000.00286.x</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Debby</surname><given-names>A</given-names></name><name><surname>Sadan</surname><given-names>O</given-names></name><name><surname>Glezerman</surname><given-names>M</given-names></name><name><surname>Golan</surname><given-names>A</given-names></name></person-group><article-title>Favorable outcome following emergency second trimester cerclage</article-title><source>Int J Gynaecol Obstet</source><year>2007</year><volume>96</volume><fpage>16</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">17187796</pub-id><pub-id pub-id-type="doi">10.1016/j.ijgo.2006.09.002</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Daskalakis</surname><given-names>G</given-names></name><name><surname>Papantoniou</surname><given-names>N</given-names></name><name><surname>Mesogitis</surname><given-names>S</given-names></name><name><surname>Antsaklis</surname><given-names>A</given-names></name></person-group><article-title>Management of cervical insufficiency and bulging membranes</article-title><source>Obstet Gynecol</source><year>2006</year><volume>107</volume><fpage>221</fpage><lpage>226</lpage><pub-id pub-id-type="pmid">16449104</pub-id></citation></ref></ref-list><sec sec-type="display-objects"><title>Figures and Tables</title><fig position="float" id="F1"><label>Figure 1</label><caption><p>Three types of cerclage.</p></caption><graphic xlink:href="1471-2393-7-S1-S17-1"/></fig><fig position="float" id="F2"><label>Figure 2</label><caption><p>Funnelling.</p></caption><graphic xlink:href="1471-2393-7-S1-S17-2"/></fig><fig position="float" id="F3"><label>Figure 3</label><caption><p>Three types of suturing.</p></caption><graphic xlink:href="1471-2393-7-S1-S17-3"/></fig></sec></back></article>