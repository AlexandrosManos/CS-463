 citation-type="journal"><person-group person-group-type="author"><name><surname>Jenkins</surname><given-names>C</given-names></name><name><surname>McNary</surname><given-names>S</given-names></name><name><surname>Carlson</surname><given-names>BA</given-names></name><name><surname>King</surname><given-names>MG</given-names></name><name><surname>Hossler</surname><given-names>CL</given-names></name><name><surname>Magwood</surname><given-names>G</given-names></name><etal/></person-group><volume>119</volume><issue>3</issue><year>2004</year><fpage>322</fpage><lpage>330</lpage><article-title>Reducing disparities for African Americans with diabetes: progress made by the REACH 2010 Charleston and Georgetown Diabetes Coalition</article-title><source>Public Health Rep</source><pub-id pub-id-type="pmid">15158111</pub-id></citation></ref><ref id="B11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giachello</surname><given-names>AL</given-names></name><name><surname>Arrom</surname><given-names>JO</given-names></name><name><surname>Davis</surname><given-names>M</given-names></name><name><surname>Sayad</surname><given-names>JV</given-names></name><name><surname>Ramirez</surname><given-names>D</given-names></name><name><surname>Nandi</surname><given-names>C</given-names></name><etal/></person-group><volume>118</volume><issue>4</issue><year>2003</year><fpage>309</fpage><lpage>323</lpage><article-title>Reducing diabetes health disparities through community-based participatory action research: the Chicago Southeast Diabetes Community Action Coalition</article-title><source>Public Health Rep</source><pub-id pub-id-type="pmid">12815078</pub-id></citation></ref><ref id="B12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Horowitz</surname><given-names>CR</given-names></name><name><surname>Arniella</surname><given-names>A</given-names></name><name><surname>James</surnam