><fpage>4343</fpage><lpage>4351</lpage><pub-id pub-id-type="pmid">12902214</pub-id><pub-id pub-id-type="doi">10.1128/AEM.69.8.4343-4351.2003</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smitherman</surname><given-names>RE</given-names></name><name><surname>Genigeorgis</surname><given-names>CA</given-names></name><name><surname>Farver</surname><given-names>JB</given-names></name></person-group><article-title>Preliminary observations on the occurrence of <italic>Campylobacter jejuni </italic>at four California chicken ranches</article-title><source>J Food Prot</source><year>1984</year><volume>47</volume><fpage>293</fpage><lpage>298</lpage></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Genigeorgis</surname><given-names>C</given-names></name><name><surname>Hassuneh</surname><given-names>M</given-names></name><name><surname>Collins</surname><given-names>P</given-names></name></person-group><article-title><italic>Campylobacter jejuni </italic>infection on poultry farms and its effect on poultry meat contamination during slaughtering</article-title><source>J Food Prot</source><year>1986</year><volume>49</volume><fpage>895</fpage><lpage>903</lpage></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jacobs-Reitsma</surname><given-names>WF</given-names></name><name><surname>van de Giessen</surname><given-names>AW</given-names></name><name><surname>Bolder</surname><given-names>NM</given-names></name><name><surname>Mulder</surname><given-names>RW</given-names></name></person-group><article-title>Epidemiology of <italic>Campylobacter </italic>spp. at two Dutch broiler farms</article-title><source>Epidemiol Infect</source><year>1995</year><volume>114</volume><fpage>413</fpage><lpage>421</lpage><pub-id pub-id-type="pmid">7781729</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berndtson</surname><given-names>E</given-names></name><name><surname>Emanuelson</surname><given-names>U</given-names></name><name><surname>Engvall</surname><given-names>A</given-names></name><name><surname>Danielsson-Tham</surname><given-names>ML</given-names></name></person-group><article-title>A 1-year epidemiological study of campylobacters in 18 Swedish chicken farms</article-title><source>Prev Vet Med</source><volume>26</volume><fpage>167</fpage><lpage>185</lpage><pub-id pub-id-type="doi">10.1016/0167-5877(95)01008-4</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gregory</surname><given-names>E</given-names></name><name><surname>Barnhart</surname><given-names>H</given-names></name><name><surname>Dreesen</surname><given-names>DW</given-names></name><name><surname>Stern</surname><given-names>NJ</given-names></name><name><surname>Corn</surname><given-names>JL</given-names></name></person-group><article-title>Epidemiological study of <italic>Campylobacter </italic>spp. in broilers: source, time of colonization, and prevalence</article-title><source>Avian Dis</source><year>1997</year><volume>41</volume><fpage>890</fpage><lpage>898</lpage><pub-id pub-id-type="pmid">9454923</pub-id><pub-id pub-id-type="doi">10.2307/1592343</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Evans</surname><given-names>SJ</given-names></name><name><surname>Sayers</surname><given-names>AR</given-names></name></person-group><article-title>A longitudinal study of <italic>Campylobacter </italic>infection of broiler flocks in Great Britain</article-title><source>Prev Vet Med</source><year>2000</year><volume>46</volume><fpage>209</fpage><lpage>223</lpage><pub-id pub-id-type="pmid">10913805</pub-id><pub-id pub-id-type="doi">10.1016/S0167-5