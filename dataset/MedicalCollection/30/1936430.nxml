ven-names>JG</given-names></name><name><surname>Zhao</surname><given-names>GP</given-names></name></person-group><article-title>Unique physiological and pathogenic features of Leptospira interrogans revealed by whole-genome sequencing</article-title><source>Nature</source><year>2003</year><volume>422</volume><fpage>888</fpage><lpage>893</lpage><pub-id pub-id-type="pmid">12712204</pub-id><pub-id pub-id-type="doi">10.1038/nature01597</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nascimento</surname><given-names>AL</given-names></name><name><surname>Verjovski-Almeida</surname><given-names>S</given-names></name><name><surname>Van Sluys</surname><given-names>MA</given-names></name><name><surname>Monteiro-Vitorello</surname><given-names>CB</given-names></name><name><surname>Camargo</surname><given-names>LE</given-names></name><name><surname>Digiampietri</surname><given-names>LA</given-names></name><name><surname>Harstkeerl</surname><given-names>RA</given-names></name><name><surname>Ho</surname><given-names>PL</given-names></name><name><surname>Marques</surname><given-names>MV</given-names></name><name><surname>Oliveira</surname><given-names>MC</given-names></name><name><surname>Setubal</surname><given-names>JC</given-names></name><name><surname>Haake</surname><given-names>DA</given-names></name><name><surname>Martins</surname><given-names>EA</given-names></name></person-group><article-title>Genome features of Leptospira interrogans serovar Copenhageni</article-title><source>Braz J Med Biol Res</source><year>2004</year><volume>37</volume><fpage>459</fpage><lpage>477</lpage><pub-id pub-id-type="pmid">15064809</pub-id><pub-id pub-id-type="doi">10.1590/S0100-879X2004000400003</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nascimento</surname><given-names>AL</given-names></name><name><surname>Ko</surname><given-name