 colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>Assembly of core oligo-saccharides</bold></td><td align="left" rowspan="1" colspan="1"><italic>ALG7</italic></td><td align="left" rowspan="1" colspan="1">DPAGT1</td><td align="left" rowspan="1" colspan="1">Ij (608093)</td><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"><italic>ALG13</italic></td><td align="left" rowspan="1" colspan="1">GLT28D1</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"><italic>ALG14</italic></td><td align="left" rowspan="1" colspan="1">unnamed</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"><italic>ALG1</italic></td><td align="left" rowspan="1" colspan="1">ALG1</td><td align="left" rowspan="1" colspan="1">Ik (608540)</td><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1">x</td><td align="left"