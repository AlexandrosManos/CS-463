d-type="doi">10.1111/j.1467-8306.1987.tb00149.x</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tan</surname><given-names>Z</given-names></name><name><surname>Lal</surname><given-names>R</given-names></name><name><surname>Liu</surname><given-names>S</given-names></name></person-group><article-title>Using experimental and geospatial data to estimate regional carbon sequestration potential under no-till practice</article-title><source>Soil Science</source><year>2006</year><volume>171</volume><fpage>950</fpage><lpage>959</lpage><pub-id pub-id-type="doi">10.1097/01.ss.0000235845.17826.f0</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huggins</surname><given-names>DR</given-names></name><name><surname>Allmaras</surname><given-names>RR</given-names></name><name><surname>Clapp</surname><given-names>CE</given-names></name><name><surname>Lamb</surname><given-names>JA</given-names></name><name><surname>Randall</surname><given-names>GW</given-names></name></person-group><article-title>Corn-Soybean Sequence and Tillage Effects on Soil Carbon Dynamics and Storage</article-title><source>Soil Sci Soc Am J</source><year>2007</year><volume>71</volume><fpage>145</fpage><lpage>154</lpage><comment>doi:102136/sssaj20050231</comment></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dolan</surname><given-names>MS</given-names></name><name><surname>Clapp</surname><given-names>CE</given-names></name><name><surname>Allmaras</surname><given-names>RR</given-names></name><name><surname>Baker</surname><given-names>JM</given-names></name><name><surname>Molina</surname><given-names>J</given-names></name></person-group><article-title>Soil organic carbon and nitrogen in a Minnesota soil as related to nitrogen, tillage, residue and nitrogen management</article-title><sou