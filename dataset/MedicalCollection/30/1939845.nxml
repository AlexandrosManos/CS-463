ub-id pub-id-type="doi">10.1111/j.1741-2358.2001.00102.x</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wilson</surname><given-names>IB</given-names></name><name><surname>Cleary</surname><given-names>PD</given-names></name></person-group><article-title>Linking clinical variables with health-related quality of life</article-title><source>JAMA</source><year>1995</year><volume>273</volume><fpage>59</fpage><lpage>65</lpage><pub-id pub-id-type="pmid">7996652</pub-id><pub-id pub-id-type="doi">10.1001/jama.273.1.59</pub-id></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lwanga</surname><given-names>SKLS</given-names></name></person-group><source>Sample size determination in health studies. A practical manual</source><year>1990</year><publisher-name>World Health Organization</publisher-name><pub-id pub-id-type="pmid">2152555</pub-id></citation></ref><ref id="B20"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Kida</surname><given-names>IA</given-names></name><name><surname>Astrom</surname><given-names>AN</given-names></name><name><surname>Strand</surname><given-names>GV</given-names></name><name><surname>Masalu</surname><given-names>JR</given-names></name></person-group><article-title>Reported problems and dissatisfaction with chewing ability: a survey of older Tanzanians</article-title><source>Eur J Oral Sci</source><comment></comment></citation></ref><ref id="B21"><citation citation-type="other"><person-group person-group-type="author"><collab>World Health Orgasnization</collab></person-group><article-title>Oral health survey: basic methods. Geneva</article-title><year>1997</year></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Laster</surname><given-names>L</given-names></name><name><surname>Laudenbach</surname