><surname>Wisniewski</surname><given-names>HG</given-names></name><name><surname>Lucia</surname><given-names>MS</given-names></name><name><surname>Arevalo</surname><given-names>N</given-names></name><name><surname>Slaga</surname><given-names>TJ</given-names></name><name><surname>Kraft</surname><given-names>SL</given-names></name><name><surname>Strange</surname><given-names>R</given-names></name><name><surname>Kumar</surname><given-names>AP</given-names></name></person-group><article-title>2-Methoxyestradiol inhibits prostate tumor development in transgenic adenocarcinoma of mouse prostate: role of tumor necrosis factor-alpha-stimulated gene 6</article-title><source>Clin Cancer Res</source><year>2006</year><volume>12</volume><fpage>980</fpage><lpage>988</lpage><pub-id pub-id-type="pmid">16467113</pub-id><pub-id pub-id-type="doi">10.1158/1078-0432.CCR-05-2068</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eng</surname><given-names>MH</given-names></name><name><surname>Charles</surname><given-names>LG</given-names></name><name><surname>Ross</surname><given-names>BD</given-names></name><name><surname>Chrisp</surname><given-names>CE</given-names></name><name><surname>Pienta</surname><given-names>KJ</given-names></name><name><surname>Greenberg</surname><given-names>NM</given-names></name><name><surname>Hsu</surname><given-names>CX</given-names></name><name><surname>Sanda</surname><given-names>MG</given-names></name></person-group><article-title>Early castration reduces prostatic carcinogenesis in transgenic mice</article-title><source>Urology</source><year>1999</year><volume>54</volume><fpage>1112</fpage><lpage>1119</lpage><pub-id pub-id-type="pmid">10604719</pub-id><pub-id pub-id-type="doi">10.1016/S0090-4295(99)00297-6</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>Z</given-names></