name></person-group><article-title>Sexually transmitted infections and risk factors among truck stand workers in Dhaka, Bangladesh</article-title><source>Sex Tranms Dis</source><year>2007</year><volume>34</volume><fpage>99</fpage><lpage>103</lpage><pub-id pub-id-type="doi">10.1097/01.olq.0000225325.23340.a3</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van Valkengoed</surname><given-names>IG</given-names></name><name><surname>Morre</surname><given-names>SA</given-names></name><name><surname>van den Brule</surname><given-names>AJ</given-names></name><name><surname>Meijer</surname><given-names>CJ</given-names></name><name><surname>Deville</surname><given-names>W</given-names></name><name><surname>Bouter</surname><given-names>LM</given-names></name><name><surname>Boeke</surname><given-names>AJ</given-names></name></person-group><article-title>Low diagnostic accuracy of selective screening criteria for asymptomatic <italic>Chlamydia trachomatis </italic>infections in the general population</article-title><source>Sex Transm Infect</source><year>2000</year><volume>76</volume><fpage>375</fpage><lpage>380</lpage><pub-id pub-id-type="pmid">11141855</pub-id><pub-id pub-id-type="doi">10.1136/sti.76.5.375</pub-id></citation></ref></ref-list></back></article>