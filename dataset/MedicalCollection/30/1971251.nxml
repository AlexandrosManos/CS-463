tle>Nasal toxicity, carcinogencity and olfactory uptake of metals</article-title><source>Ann Clin Lab Sci</source><year>2001</year><volume>31</volume><fpage>3</fpage><lpage>24</lpage><pub-id pub-id-type="pmid">11314863</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zwennis</surname><given-names>WC</given-names></name><name><surname>Fransen</surname><given-names>AC</given-names></name></person-group><article-title>Assessment of occupational exposure to cadmium in the Netherlands, 1980&#x02013;1989</article-title><source>Am J Ind Med</source><year>1992</year><volume>21</volume><fpage>793</fpage><lpage>805</lpage><pub-id pub-id-type="pmid">1621689</pub-id><pub-id pub-id-type="doi">10.1002/ajim.4700210603</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roszczenko</surname><given-names>A</given-names></name><name><surname>Galazyn-Sidorczuk</surname><given-names>M</given-names></name><name><surname>Brzoska</surname><given-names>MM</given-names></name><name><surname>Moniuszko-Jakoniuk</surname><given-names>J</given-names></name><name><surname>Zwierz</surname><given-names>K</given-names></name></person-group><article-title>Select parameters of renal function in smokers in correlation with the exposure to cadmium</article-title><source>Przegl Lek</source><year>2004</year><volume>61</volume><fpage>348</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">15521599</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lim</surname><given-names>YC</given-names></name><name><surname>Chia</surname><given-names>KS</given-names></name><name><surname>Ong</surname><given-names>HY</given-names></name><name><surname>Nag</surname><given-names>V</given-names></name><name><surname>Chew</surname><given-names>YL</given-names></name></person-group><article-title>Re