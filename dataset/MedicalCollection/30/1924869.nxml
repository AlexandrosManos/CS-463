030099-b015"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kawai</surname><given-names>S</given-names></name><name><surname>Aikawa</surname><given-names>M</given-names></name><name><surname>Kano</surname><given-names>S</given-names></name><name><surname>Suzuki</surname><given-names>M</given-names></name></person-group><year>1993</year><article-title>A primate model for severe human malaria with cerebral involvement: <named-content content-type="genus-species">Plasmodium coatneyi</named-content>&#x02013;infected <named-content content-type="genus-species">Macaca fuscata</named-content></article-title><source>Am J Trop Med Hyg</source><volume>48</volume><fpage>630</fpage><lpage>636</lpage><pub-id pub-id-type="pmid">8517481</pub-id></citation></ref><ref id="ppat-0030099-b016"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pettersson</surname><given-names>F</given-names></name><name><surname>Vogt</surname><given-names>AM</given-names></name><name><surname>Jonsson</surname><given-names>C</given-names></name><name><surname>Mok</surname><given-names>BW</given-names></name><name><surname>Shamaei-Tousi</surname><given-names>A</given-names></name><etal/></person-group><year>2005</year><article-title>Whole-body imaging of sequestration of <italic>Plasmodium falciparum</italic> in the rat</article-title><source>Infect Immun</source><volume>73</volume><fpage>7736</fpage><lpage>7746</lpage><pub-id pub-id-type="pmid">16239578</pub-id></citation></ref><ref id="ppat-0030099-b017"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pongponratn</surname><given-names>E</given-names></name><name><surname>Riganti</surname><given-names>M</given-names></name><name><surname>Punpoowong</surname><given-names>B</given-names></name><name><surname>Aikawa</surname><given-names>M</given-names></name></person-group><year>1991</year><article-title>Microvascular sequestration o