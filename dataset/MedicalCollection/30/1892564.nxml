n-names>O</given-names></name><name><surname>Shinohara</surname><given-names>M</given-names></name></person-group><article-title>The [C-14]deoxyglucose method for the measurement of local cerebral glucose utilization: Theory, procedure, and normal values in the conscious and anesthetized albino rat</article-title><source>J Neuro Chem</source><year>1977</year><volume>28</volume><fpage>897</fpage><lpage>916</lpage></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Langen</surname><given-names>KJ</given-names></name><name><surname>Braun</surname><given-names>U</given-names></name><name><surname>Rota Kops</surname><given-names>E</given-names></name><etal></etal></person-group><article-title>The influence of plasma glucose levels on fluorine-18-fluorodeoxyglucose uptake in bronchial carcinomas</article-title><source>J Nucl Med</source><year>1993</year><volume>34</volume><fpage>355</fpage><lpage>359</lpage><pub-id pub-id-type="pmid">8441023</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>SC</given-names></name></person-group><article-title>Anatomy of SUV</article-title><source>Nucl Med Biol</source><year>2000</year><volume>27</volume><fpage>643</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">11091106</pub-id><pub-id pub-id-type="doi">10.1016/S0969-8051(00)00155-4</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Young</surname><given-names>H</given-names></name><name><surname>Baum</surname><given-names>R</given-names></name><name><surname>Cremerius</surname><given-names>U</given-names></name><etal></etal></person-group><article-title>Measurement of clinical and subclinical tumour response using [18F]-fluorodeoxyglucose and positron emission tomography: review and 1999 EORTC recommendations&#x02013;European Organization for Research and Treatment of Cancer (EORTC) PET Study Group</article-title><source>Eur J Cancer</source><year>1999</year><volume>35</volume><fpage>1773</fpage><lpage>1782</lpage><pub-id pub-id-type="pmid">10673991</pub-id><pub-id pub-id-type="doi">10.1016/S0959-8049(99)00229-4</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Therasse</surname><given-names>P</given-names></name><name><surname>Arbuck</surname><given-names>SG</given-names></name><name><surname>Eisenhauer</surname><given-names>EA</given-names></name><etal></etal></person-group><article-title>New guidelines to evaluate the response to treatment in solid tumors: European Organization for Research and Treatment of Cancer, National Cancer Institute of the United States, National Cancer Institute of Canada</article-title><source>J Natl Cancer Inst</source><year>2000</year><volume>92</volume><fpage>205</fpage><lpage>216</lpage><pub-id pub-id-type="pmid">10655437</pub-id><pub-id pub-id-type="doi">10.1093/jnci/92.3.205</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Black</surname><given-names>QC</given-names></name><name><surname>Grills</surname><given-names>IS</given-names></name><name><surname>Kestin</surname><given-names>LL</given-names></name><name><surname>Wong</surname><given-names>CY</given-names></name><name><surname>Wong</surname><given-names>JW</given-names></name><name><surname>Martinez</surname><given-names>AA</given-names></name><name><surname>Yan</surname><given-names>D</given-names></name></person-group><article-title>Defining a radiotherapy target with positron emission tomography</article-title><source>Int J Radiat Oncol Biol Phys</source><volume>60</volume><fpage>1272</fpage><lpage>82</lpage><comment>2004 Nov 15;</comment><pub-id pub-id-type="pmid">15519800</pub-id><pub-id pub-id-type="doi">10.1016/j.ijrobp.2004.06.254</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grills</surname><given-names>IS</given-names></name><name><surname>Yan</surname><given-names>D</given-names></name><name><surname>Black</surname><given-names>QC</given-names></name><name><surname>Wong</surname><given-names>CY</given-names></name><name><surname>Martinez</surname><given-names>AA</given-names></name><name><surname>Kestin</surname><given-names>LL</given-names></name></person-group><article-title>Clinical implications of defining the gross tumor volume with combination of CT and 18FDG-positron emission tomography in non-small-cell lung cancer</article-title><source>Int J Radiat Oncol Biol Phys</source><year>2007</year><volume>67</volume><fpage>709</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">17197120</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wong</surname><given-names>CY</given-names></name><name><surname>Salem</surname><given-names>R</given-names></name><name><surname>Raman</surname><given-names>S</given-names></name><name><surname>Gates</surname><given-names>VL</given-names></name><name><surname>Dworkin</surname><given-names>HJ</given-names></name></person-group><article-title>Evaluating 90Y-glass microsphere treatment response of unresectable colorectal liver metastases by [18F]FDG PET: a comparison with CT or MRI</article-title><source>Eur J Nucl Med Mol Imaging</source><year>2002</year><volume>29</volume><fpage>815</fpage><lpage>20</lpage><pub-id pub-id-type="pmid">12029557</pub-id><pub-id pub-id-type="doi">10.1007/s00259-002-0787-4</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hicks</surname><given-names>RJ</given-names></name><name><surname>Mac Manus</surname><given-names>MP</given-names></name><name><surname>Matthews</surname><given-names>JP</given-names></name><etal></etal></person-group><article-title>Early FDG-PET imaging after radical radiotherapy for non-small-cell lung cancer: inflammatory changes in normal tissues correlate with tumor response and do not confound therapeutic response evaluation</article-title><source>Int J Radiat Oncol Biol Phys</source><volume>60</volume><fpage>412</fpage><lpage>8</lpage><comment>2004 Oct 1;</comment><pub-id pub-id-type="pmid">15380574</pub-id><pub-id pub-id-type="doi">10.1016/j.ijrobp.2004.03.036</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hoekstra</surname><given-names>CJ</given-names></name><name><surname>Stroobants</surname><given-names>SG</given-names></name><name><surname>Smit</surname><given-names>EF</given-names></name><etal></etal></person-group><article-title>Prognostic relevance of response evaluation using [18F]-2-fluoro-2-deoxy-D-glucose positron emission tomography in patients with locally advanced non-small-cell lung cancer</article-title><source>J Clin Oncol</source><year>2005</year><volume>23</volume><fpage>8362</fpage><lpage>70</lpage><pub-id pub-id-type="pmid">16293866</pub-id><pub-id pub-id-type="doi">10.1200/JCO.2005.01.1189</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eschmann</surname><given-names>SM</given-names></name><name><surname>Friedel</surname><given-names>G</given-names></name><name><surname>Paulsen</surname><given-names>F</given-names></name><etal></etal></person-group><article-title>Repeat 18F-FDG PET for monitoring neoadjuvant chemotherapy in patients with stage III non-small cell lung cancer</article-title><source>Lung Cancer</source><year>2007</year><volume>55</volume><fpage>165</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">17129635</pub-id><pub-id pub-id-type="doi">10.1016/j.lungcan.2006.09.028</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person