<source>Acta Orthop Scand</source><year>1992</year><volume>63</volume><fpage>424</fpage><lpage>426</lpage><pub-id pub-id-type="pmid">1529694</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lochmiller</surname><given-names>C</given-names></name><name><surname>Johnston</surname><given-names>D</given-names></name><name><surname>Scott</surname><given-names>A</given-names></name><name><surname>Risman</surname><given-names>M</given-names></name><name><surname>Hecht</surname><given-names>JT</given-names></name></person-group><article-title>Genetic epidemiology study of idiopathic talipes equinovarus</article-title><source>Am J Med Genet</source><year>1998</year><volume>79</volume><fpage>90</fpage><lpage>96</lpage><pub-id pub-id-type="pmid">9741465</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1096-8628(19980901)79:2&#x0003c;90::AID-AJMG3&#x0003e;3.0.CO;2-R</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chapman</surname><given-names>C</given-names></name><name><surname>Stott</surname><given-names>NS</given-names></name><name><surname>Port</surname><given-names>RM</given-names></name><name><surname>Nicol</surname><given-names>RO</given-names></name></person-group><article-title>Genetics of club foot in Maori and Pacific people</article-title><source>J Med Genet</source><year>2000</year><volume>37</volume><fpage>680</fpage><lpage>683</lpage><pub-id pub-id-type="pmid">10978359</pub-id><pub-id pub-id-type="doi">10.1136/jmg.37.9.680</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Byron-Scott</surname><given-names>R</given-names></name><name><surname>Sharpe</surname><given-names>P</given-names></name><name><surname>Hasler</surname><given-names>C</given-names></name><name><surname>Cundy</surname><given-names>P</given-names></name><name><surname>Hirte</surname><given-names>C</given-names></name><name><surname>Chan</surname><given-names>A</given-names></name><name><surname>Scott</surname><given-names>H</given-names></name><name><surname>Baghurst</surname><given-names>P</given-names></name><name><surname>Haan</surname><given-names>E</given-names></name></person-group><article-title>A South Australian population-based study of congenital talipes equinovarus</article-title><source>Paediatr Perinat Epidemiol</source><year>2005</year><volume>19</volume><fpage>227</fpage><lpage>237</lpage><pub-id pub-id-type="pmid">15860081</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-3016.2005.00647.x</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moorthi</surname><given-names>RN</given-names></name><name><surname>Hashmi</surname><given-names>SS</given-names></name><name><surname>Langois</surname><given-names>P</given-names></name><name><surname>Canfield</surname><given-names>M</given-names></name><name><surname>Waller</surname><given-names>DK</given-names></name><name><surname>Hecht</surname><given-names>JT</given-names></name></person-group><article-title>Idiopathic talipes equinovarus (ITEV) (clubfeet) in Texas</article-title><source>American Journal of Medical Genetics Part A</source><year>2005</year><volume>132</volume><fpage>376</fpage><lpage>380</lpage><pub-id pub-id-type="pmid">15633175</pub-id><pub-id pub-id-type="doi">10.1002/ajmg.a.30505</pub-id></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><collab>Information and Statistics Division NHS Scotland</collab></person-group><source>Scottish perinatal and infant mortality and morbidity report 2001</source><year>2002</year><publisher-name>Edinburgh: Information &#x00026; Statistics Division NHS Scotland</publisher-name></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><colla