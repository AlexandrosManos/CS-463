><person-group person-group-type="author"><collab>Finance Committee</collab></person-group><source>Item 019 Health and Health Services Research Fund</source><year>2005</year><publisher-name>Hong Kong: Legislative Council (FCR(2004&#x02013;05)42)</publisher-name></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boyack</surname><given-names>KW</given-names></name><name><surname>Borner</surname><given-names>K</given-names></name></person-group><article-title>Indicator-assisted evaluation and funding of research: visualizing the influence of grants on the number and citation counts of research papers</article-title><source>J Am Soc Info Sci Technology</source><year>2003</year><volume>54</volume><fpage>447</fpage><lpage>461</lpage><pub-id pub-id-type="doi">10.1002/asi.10230</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wallins</surname><given-names>JA</given-names></name></person-group><article-title>Bibliometric methods: pitfalls and possibilities</article-title><source>Basic Clin Pharmacol Toxicol</source><year>2005</year><volume>97</volume><fpage>261</fpage><lpage>275</lpage><pub-id pub-id-type="pmid">16236137</pub-id><pub-id pub-id-type="doi">10.1111/j.1742-7843.2005.pto_139.x</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Malfertheiner</surname><given-names>P</given-names></name><name><surname>Megraud</surname><given-names>F</given-names></name><name><surname>O'morain</surname><given-names>C</given-names></name><name><surname>Bazzoli</surname><given-names>F</given-names></name><name><surname>El-Omar</surname><given-names>E</given-names></name><name><surname>Graham</surname><given-names>D</given-names></name><name><surname>Hunt</surname><given-names>R</given-names></name><name><surname>Rokkas</surname><given-names>T</given-names></name