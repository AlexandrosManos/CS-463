</name><name><surname>Pan</surname><given-names>W</given-names></name></person-group><article-title>Modified nonparametric approaches to detecting differentially expressed genes in replicated microarray experiments</article-title><source>Bioinformatics</source><year>2002</year><volume>19</volume><fpage>1046</fpage><lpage>1054</lpage><pub-id pub-id-type="pmid">12801864</pub-id><pub-id pub-id-type="doi">10.1093/bioinformatics/btf879</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pan</surname><given-names>W</given-names></name><name><surname>Lin</surname><given-names>J</given-names></name><name><surname>Le</surname><given-names>C</given-names></name></person-group><article-title>A mixture model approach to detecting differentially expressed genes with microarray data</article-title><source>Funct Integr Genomics</source><year>2003</year><volume>3</volume><fpage>117</fpage><lpage>124</lpage><pub-id pub-id-type="pmid">12844246</pub-id><pub-id pub-id-type="doi">10.1007/s10142-003-0085-7</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Larsson</surname><given-names>O</given-names></name><name><surname>Wahlestedt</surname><given-names>C</given-names></name><name><surname>Timmons</surname><given-names>AJ</given-names></name></person-group><article-title>Considerations when using the significance analysis of microarrays (SAM) algorithm</article-title><source>BMC Bioinformatics</source><year>2005</year><volume>6</volume><fpage>129</fpage><pub-id pub-id-type="pmid">15921534</pub-id><pub-id pub-id-type="doi">10.1186/1471-2105-6-129</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zhang</surname><given-names>S</given-names></name></person-group><article-title>An improved nonparametric approach for detecting differentially expressed genes with 