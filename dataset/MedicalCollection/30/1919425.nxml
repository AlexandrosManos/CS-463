><lpage>527</lpage></citation></ref><ref id="pone.0000636-Sponheimer1"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sponheimer</surname><given-names>M</given-names></name><name><surname>Passey</surname><given-names>BH</given-names></name><name><surname>de Ruiter</surname><given-names>DJ</given-names></name><name><surname>Guatelli-Steinberg</surname><given-names>D</given-names></name><name><surname>Cerling</surname><given-names>TE</given-names></name><etal/></person-group><year>2006</year><article-title>Isotopic evidence for dietary variability in the early hominin <italic>Paranthropus robustus</italic>.</article-title><source>Science</source><volume>314</volume><fpage>980</fpage><lpage>981</lpage><pub-id pub-id-type="pmid">17095699</pub-id></citation></ref><ref id="pone.0000636-Anonymous1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Anonymous</surname></name></person-group><year>2006</year><article-title>Nature</article-title><volume>442</volume><fpage>VII</fpage></citation></ref><ref id="pone.0000636-Sharp1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sharp</surname><given-names>ZD</given-names></name><name><surname>Atudorei</surname><given-names>V</given-names></name><name><surname>Panarello</surname><given-names>HO</given-names></name><name><surname>Fern&#x000e1;ndez</surname><given-names>J</given-names></name><name><surname>Douthitt</surname><given-names>C</given-names></name></person-group><year>2006</year><article-title>Hydrogen isotope systematics of hair: archeological and forensic applications</article-title><source>J Archeolog Sci</source><volume>30</volume><fpage>1709</fpage><lpage>1716</lpage></citation></ref><ref id="pone.0000636-Lincoln1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lincoln</surname><given-name