-type="journal"><person-group person-group-type="author"><name><surname>Alberti</surname><given-names>C</given-names></name><name><surname>Brun-Buisson</surname><given-names>C</given-names></name><name><surname>Goodman</surname><given-names>SV</given-names></name><name><surname>Guidici</surname><given-names>D</given-names></name><name><surname>Granton</surname><given-names>J</given-names></name><name><surname>Moreno</surname><given-names>R</given-names></name><name><surname>Smithies</surname><given-names>M</given-names></name><name><surname>Thomas</surname><given-names>O</given-names></name><name><surname>Artigas</surname><given-names>A</given-names></name><name><surname>Le Gall</surname><given-names>JR</given-names></name></person-group><article-title>Influence of systemic inflammatory response syndrome and sepsis on outcome of critically ill infected patients</article-title><source>Am J Respir Crit Care Med</source><year>2003</year><volume>168</volume><fpage>77</fpage><lpage>84</lpage><pub-id pub-id-type="pmid">12702548</pub-id><pub-id pub-id-type="doi">10.1164/rccm.200208-785OC</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Granja</surname><given-names>C</given-names></name><name><surname>Dias</surname><given-names>C</given-names></name><name><surname>Costa-Pereira</surname><given-names>A</given-names></name><name><surname>Sarmento</surname><given-names>A</given-names></name></person-group><article-title>Quality of life of survivors from severe sepsis and septic shock may be similar to that of others who survive critical illness</article-title><source>Crit Care</source><year>2004</year><volume>8</volume><fpage>R91</fpage><lpage>R98</lpage><pub-id pub-id-type="pmid">15025783</pub-id><pub-id pub-id-type="doi">10.1186/cc2818</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Angus</surname><given-names>DC</gi