</name><name><surname>Sobol</surname><given-names>A</given-names></name></person-group><article-title>Maternal smoking and childhood asthma</article-title><source>Pediatrics</source><year>1990</year><volume>85</volume><fpage>505</fpage><lpage>511</lpage><pub-id pub-id-type="pmid">2314963</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leung</surname><given-names>GM</given-names></name><name><surname>Ho</surname><given-names>LM</given-names></name><name><surname>Lam</surname><given-names>TH</given-names></name></person-group><article-title>Secondhand smoke exposure, smoking hygiene, and hospitalization in the first 18 months of life</article-title><source>Arch Pediatr Adolesc Med</source><year>2004</year><volume>158</volume><fpage>687</fpage><lpage>693</lpage><pub-id pub-id-type="pmid">15237069</pub-id><pub-id pub-id-type="doi">10.1001/archpedi.158.7.687</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schwartz</surname><given-names>J</given-names></name><name><surname>Timonen</surname><given-names>KL</given-names></name><name><surname>Pekkanen</surname><given-names>J</given-names></name></person-group><article-title>Respiratory effects of environmental tobacco smoke in a panel study of asthmatic and symptomatic children</article-title><source>Am J Respir Crit Care Med</source><year>2000</year><volume>161</volume><fpage>802</fpage><lpage>806</lpage><pub-id pub-id-type="pmid">10712325</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>LeSon</surname><given-names>S</given-names></name><name><surname>Gershwin</surname><given-names>ME</given-names></name></person-group><article-title>Risk factors for asthmatic patients requiring intubation: A comprehensive review</article-title><source>Allergol Immunopathol (Madr)</source><year>1995</ye