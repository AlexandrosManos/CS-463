ation></ref><ref id="pmed-0040239-b016"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lugliani</surname><given-names>R</given-names></name><name><surname>Whipp</surname><given-names>BJ</given-names></name><name><surname>Seard</surname><given-names>C</given-names></name><name><surname>Wasserman</surname><given-names>K</given-names></name></person-group><year>1971</year><article-title>Effect of bilateral carotid body resection on ventilatory control at rest and during exercise in man</article-title><source>N Eng J Med</source><volume>285</volume><fpage>1105</fpage><lpage>1111</lpage></citation></ref><ref id="pmed-0040239-b017"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bellville</surname><given-names>JW</given-names></name><name><surname>Whipp</surname><given-names>BJ</given-names></name><name><surname>Kaufman</surname><given-names>RD</given-names></name><name><surname>Swanson</surname><given-names>GD</given-names></name><name><surname>Aqleh</surname><given-names>KA</given-names></name><etal/></person-group><year>1979</year><article-title>Central and peripheral chemoreflex loop gain in normal and carotid body-resected subjects</article-title><source>J Appl Physiol</source><volume>46</volume><fpage>843</fpage><lpage>853</lpage><pub-id pub-id-type="pmid">457565</pub-id></citation></ref><ref id="pmed-0040239-b018"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Honda</surname><given-names>Y</given-names></name><name><surname>Watanabe</surname><given-names>S</given-names></name><name><surname>Hashizume</surname><given-names>I</given-names></name><name><surname>Satomura</surname><given-names>N</given-names></name><name><surname>Hata</surname><given-names>N</given-names></name><etal/></person-group><year>1979</year><article-title>Hypoxic chemosensitivity in asthmatic patients two decades after carotid body resection</article-title><source>J Ap