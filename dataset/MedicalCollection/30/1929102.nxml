ub-id pub-id-type="pmid">11896095</pub-id><pub-id pub-id-type="doi">10.1200/JCO.20.6.1480</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haffty</surname><given-names>BG</given-names></name><name><surname>Harrold</surname><given-names>E</given-names></name><name><surname>Khan</surname><given-names>AJ</given-names></name><name><surname>Pathare</surname><given-names>P</given-names></name><name><surname>Smith</surname><given-names>TE</given-names></name><name><surname>Turner</surname><given-names>BC</given-names></name><name><surname>Glazer</surname><given-names>PM</given-names></name><name><surname>Ward</surname><given-names>B</given-names></name><name><surname>Carter</surname><given-names>D</given-names></name><name><surname>Matloff</surname><given-names>E</given-names></name><etal></etal></person-group><article-title>Outcome of conservatively managed early-onset breast cancer by BRCA1/2 status</article-title><source>Lancet</source><year>2002</year><volume>359</volume><fpage>1471</fpage><lpage>1477</lpage><pub-id pub-id-type="pmid">11988246</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(02)08434-9</pub-id></citation></ref><ref id="B14"><citation citation-type="other"><article-title>Breast Cancer in Europe</article-title><ext-link ext-link-type="uri" xlink:href="http://www.encr.com.fr/breast-fact-sheets.pdf"/></citation></ref><ref id="B15"><citation citation-type="other"><article-title>The Gene-Rad-Risk Project</article-title><ext-link ext-link-type="uri" xlink:href="http://generadrisk.iarc.fr/index.php"/></citation></ref></ref-list></back></article>