ce><year>2005</year><volume>39</volume><fpage>95</fpage><lpage>119</lpage><pub-id pub-id-type="pmid">16285854</pub-id><pub-id pub-id-type="doi">10.1146/annurev.genet.39.073003.112310</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lespinet</surname><given-names>O</given-names></name><name><surname>Wolf</surname><given-names>YI</given-names></name><name><surname>Koonin</surname><given-names>EV</given-names></name><name><surname>Aravind</surname><given-names>L</given-names></name></person-group><article-title>The role of lineage-specific gene family expansion in the evolution of eukaryotes</article-title><source>Genome Res</source><year>2002</year><volume>12</volume><fpage>1048</fpage><lpage>1059</lpage><pub-id pub-id-type="pmid">12097341</pub-id><pub-id pub-id-type="doi">10.1101/gr.174302</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parkinson</surname><given-names>J</given-names></name><name><surname>Mitreva</surname><given-names>M</given-names></name><name><surname>Whitton</surname><given-names>C</given-names></name><name><surname>Thomson</surname><given-names>M</given-names></name><name><surname>Daub</surname><given-names>J</given-names></name><name><surname>Martin</surname><given-names>J</given-names></name><name><surname>Schmid</surname><given-names>R</given-names></name><name><surname>Hall</surname><given-names>N</given-names></name><name><surname>Barrell</surname><given-names>B</given-names></name><name><surname>Waterston</surname><given-names>RH</given-names></name><name><surname>McCarter</surname><given-names>JP</given-names></name><name><surname>Blaxter</surname><given-names>ML</given-names></name></person-group><article-title>A transcriptomic analysis of the phylum Nematoda</article-title><source>NAT GENET</source><year>2004</year><volume>36</volume><fpage>1259</fpage><lpage>1267</lpage><pub-id 