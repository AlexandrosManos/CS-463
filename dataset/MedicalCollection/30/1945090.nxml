virus.</article-title><source>Nature</source><volume>438</volume><fpage>575</fpage><lpage>576</lpage><pub-id pub-id-type="pmid">16319873</pub-id></citation></ref><ref id="pone.0000747-Oliver1"><label>27</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oliver</surname><given-names>JH</given-names></name><name><surname>Lin</surname><given-names>T</given-names></name><name><surname>Gao</surname><given-names>L</given-names></name><name><surname>Clark</surname><given-names>KL</given-names></name><name><surname>Banks</surname><given-names>CW</given-names></name><etal/></person-group><year>2003</year><article-title>An enzootic transmission cycle of Lyme borreliosis spirochetes in the southeastern United States.</article-title><source>Proceedings of the National Academy of Sciences of the United States of America</source><volume>100</volume><fpage>11642</fpage><lpage>11645</lpage><pub-id pub-id-type="pmid">14500917</pub-id></citation></ref></ref-list><fn-group><fn fn-type="conflict"><p><bold>Competing Interests: </bold>The authors have declared that no competing interests exist.</p></fn><fn fn-type="financial-disclosure"><p><bold>Funding: </bold>This work was supported in part by the Italian Minister of Research prot. II04CE49G8 (LB and GDL) and by a US National Institutes of Health RO1 AI1047498 and an International and Comparative Studies grant from Emory University (to LAR).</p></fn></fn-group></back></article>