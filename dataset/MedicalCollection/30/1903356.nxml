ub-id pub-id-type="pmid">14613575</pub-id><pub-id pub-id-type="doi">10.1186/1476-8518-1-3</pub-id></citation></ref><ref id="B10"><citation citation-type="other"><article-title>Childhood Vaccinations:Canada's Largest Ever Survey of Canadian Parents on Their Attitudes Toward Childhood Vaccinations</article-title><source>Ipsos Reid</source><year>2004</year></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gellin</surname><given-names>BG</given-names></name><name><surname>Maibach</surname><given-names>EW</given-names></name><name><surname>Marcuse</surname><given-names>EK</given-names></name></person-group><article-title>Do parents understand immunizations? A national telephone survey</article-title><source>Pediatrics</source><year>2000</year><volume>106</volume><fpage>1097</fpage><lpage>1102</lpage><pub-id pub-id-type="pmid">11061781</pub-id><pub-id pub-id-type="doi">10.1542/peds.106.5.1097</pub-id></citation></ref><ref id="B12"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Neumann</surname><given-names>DA</given-names></name><name><surname>Garel</surname><given-names>M</given-names></name><name><surname>Penner</surname><given-names>D</given-names></name><name><surname>Boles</surname><given-names>A</given-names></name></person-group><article-title>Parental Knowledge and Attitudes about Childhood Immunization:Attitudes About Childhood Immunization &#x02013; 2003 Survey Results Abstract</article-title><source>The 38th National Immunization Conference, Nashville, TN</source><comment>2004 May 11&#x02013;14</comment></citation></ref><ref id="B13"><citation citation-type="other"><article-title>Childhood Vaccinations Are Seen as Important, but Parental Worries Persist</article-title><source>The Wall Street Journal</source><volume>3</volume><comment>2004 September 1</comment></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-t