Praxis, German</source><year>1997</year><volume>68</volume><fpage>7</fpage><lpage>12</lpage></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schmitt</surname><given-names>HJ</given-names></name></person-group><article-title>Factors influencing vaccine uptake in Germany</article-title><source>Vaccine</source><year>2001</year><volume>20</volume><fpage>S2</fpage><lpage>4</lpage><comment>discussion S1</comment><pub-id pub-id-type="pmid">11587799</pub-id><pub-id pub-id-type="doi">10.1016/S0264-410X(01)00304-8</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bonanni</surname><given-names>P</given-names></name><name><surname>Bergamini</surname><given-names>M</given-names></name></person-group><article-title>Factors influencing vaccine uptake in Italy</article-title><source>Vaccine</source><year>2001</year><volume>20</volume><fpage>S8</fpage><lpage>12</lpage><comment>discussion S1</comment><pub-id pub-id-type="pmid">11587801</pub-id><pub-id pub-id-type="doi">10.1016/S0264-410X(01)00284-5</pub-id></citation></ref><ref id="B19"><citation citation-type="other"><article-title>European Vaccine Manufacturers. Survey regarding the Perception of Vaccines and Vaccinations</article-title><source>International Summary Report</source><year>2004</year><ext-link ext-link-type="uri" xlink:href="http://www.evm-vaccines.org/pdfs/survey_perceptions.pdf"/></citation></ref><ref id="B20"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Hessel</surname><given-names>L</given-names></name><name><surname>Abelin</surname><given-names>A</given-names></name><name><surname>Allin</surname><given-names>P</given-names></name><name><surname>Cambillard</surname><given-names>PE</given-names></name><name><surname>Digneffet</surname><given-names>T</given-names></name><name><surname>Dumas</surname><given-names>R</given-name