><fpage>863</fpage><lpage>868</lpage><pub-id pub-id-type="pmid">10473313</pub-id><pub-id pub-id-type="doi">10.1017/S0033291799008697</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mokdad</surname><given-names>AH</given-names></name><name><surname>Bowman</surname><given-names>BA</given-names></name><name><surname>Ford</surname><given-names>ES</given-names></name><name><surname>Vinicor</surname><given-names>F</given-names></name><name><surname>Marks</surname><given-names>JS</given-names></name><name><surname>Koplan</surname><given-names>SJ</given-names></name></person-group><article-title>The continuing epidemics of obesity and diabetes in the United States</article-title><source>JAMA</source><year>2001</year><volume>286</volume><fpage>1195</fpage><lpage>1200</lpage><pub-id pub-id-type="pmid">11559264</pub-id><pub-id pub-id-type="doi">10.1001/jama.286.10.1195</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lim</surname><given-names>W</given-names></name><name><surname>Hong</surname><given-names>S</given-names></name><name><surname>Nelesen</surname><given-names>R</given-names></name><name><surname>Dimsdale</surname><given-names>JE</given-names></name></person-group><article-title>The association of obesity, cytokine levels, and depressive symptoms with diverse measures of fatigue in healthy subjects</article-title><source>Arch Intern Med</source><year>2005</year><volume>165</volume><fpage>910</fpage><lpage>915</lpage><pub-id pub-id-type="pmid">15851643</pub-id><pub-id pub-id-type="doi">10.1001/archinte.165.8.910</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eveng&#x000e5;rd</surname><given-names>Ba</given-names></name><name><surname>Jacks</surname><given-names>A</given-names></name><name><surname>Pedersen</surname><given-names>NL</given-names></name><name><surname>Sullivan</surname><given-names>PF</given-names></name></person-group><article-title>The epidemiology of chronic fatigue in the Swedish twin registry</article-title><source>Psychol Med</source><year>2005</year><volume>35</volume><fpage>1327</fpage><lpage>1336</lpage><pub-id pub-id-type="pmid">16168155</pub-id><pub-id pub-id-type="doi">10.1017/S0033291705005222</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sullivan</surname><given-names>PF</given-names></name><name><surname>Pedersen</surname><given-names>NL</given-names></name><name><surname>Jacks</surname><given-names>A</given-names></name><name><surname>Eveng&#x000e5;</surname><given-names>B</given-names></name></person-group><article-title>Chronic fatigue in a population sample: definitions and heterogeneity</article-title><source>Psychol Med</source><year>2005</year><volume>35</volume><fpage>1337</fpage><lpage>1348</lpage><pub-id pub-id-type="pmid">16168156</pub-id><pub-id pub-id-type="doi">10.1017/S0033291705005210</pub-id></citation></ref></ref-list></back></article>