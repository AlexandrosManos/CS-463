 id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tribe</surname><given-names>RM</given-names></name><name><surname>Moriarty</surname><given-names>P</given-names></name><name><surname>Dalrymple</surname><given-names>A</given-names></name><name><surname>Hassoni</surname><given-names>AA</given-names></name><name><surname>Poston</surname><given-names>L</given-names></name></person-group><article-title>Interleukin-1beta induces calcium transients and enhances basal and store operated calcium entry in human myometrial smooth muscle</article-title><source>Biol Reprod</source><year>2003</year><volume>68</volume><fpage>1842</fpage><lpage>1849</lpage><pub-id pub-id-type="pmid">12606352</pub-id><pub-id pub-id-type="doi">10.1095/biolreprod.102.011403</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oger</surname><given-names>S</given-names></name><name><surname>Mehats</surname><given-names>C</given-names></name><name><surname>Dallot</surname><given-names>E</given-names></name><name><surname>Ferre</surname><given-names>F</given-names></name><name><surname>Leroy</surname><given-names>MJ</given-names></name></person-group><article-title>Interleukin-1beta induces phosphodiesterase 4B2 expression in human myometrial cells through a prostaglandin E2- and cyclic adenosine 3',5'-monophosphate-dependent pathway</article-title><source>J Clin Endocrinol Metab</source><year>2002</year><volume>87</volume><fpage>5524</fpage><lpage>5531</lpage><pub-id pub-id-type="pmid">12466348</pub-id><pub-id pub-id-type="doi">10.1210/jc.2002-020575</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rauk</surname><given-names>PN</given-names></name><name><surname>Chiao</surname><given-names>JP</given-names></name></person-group><article-title>Interleukin-1 stimulates human uterine prostaglandin production