16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lyubsky</surname><given-names>S</given-names></name><name><surname>Jacobson</surname><given-names>MJ</given-names></name></person-group><article-title>Lung cancer: making the diagnosis</article-title><source>Chest</source><year>1991</year><volume>100</volume><fpage>511</fpage><lpage>520</lpage><pub-id pub-id-type="pmid">1864129</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chuang</surname><given-names>MT</given-names></name><name><surname>Marchevsky</surname><given-names>A</given-names></name><name><surname>Teirstein</surname><given-names>A</given-names></name><name><surname>Kirschner</surname><given-names>PA</given-names></name><name><surname>Kleinerman</surname><given-names>J</given-names></name></person-group><article-title>The diagnosis of lung cancer by fiberoptic bronchoscopy I. Problems in the histologic classification of non-small cell carcinomas</article-title><source>Thorax</source><year>1984</year><volume>39</volume><fpage>175</fpage><lpage>178</lpage><pub-id pub-id-type="pmid">6324409</pub-id></citation></ref></ref-list></back></article>