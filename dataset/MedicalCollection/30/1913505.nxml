-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Edlund</surname><given-names>C</given-names></name><name><surname>Dahlgren</surname><given-names>L</given-names></name></person-group><article-title>The physician&#x02019;s role in the vocational rehabilitation process</article-title><source>Disability and Rehabilitation</source><year>2002</year><volume>20:24</volume><fpage>727</fpage><lpage>733</lpage><pub-id pub-id-type="pmid">12396658</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>&#x000d6;stlund</surname><given-names>G</given-names></name><name><surname>Borg</surname><given-names>K</given-names></name><name><surname>Wide</surname><given-names>P</given-names></name><name><surname>Hensing</surname><given-names>G</given-names></name><name><surname>Alexanderson</surname><given-names>K</given-names></name></person-group><article-title>Clients&#x02019; perceptions of contact with professionals within health care and social insurance offices</article-title><source>Scandinavian Journal of Public Health</source><year>2003</year><volume>31</volume><fpage>275</fpage><lpage>282</lpage><pub-id pub-id-type="pmid">15099033</pub-id><pub-id pub-id-type="doi">10.1080/14034940210165037</pub-id></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Silverman</surname><given-names>D</given-names></name></person-group><source>Interpreting Qualitative Data Method for Analysing Talk, Text and Interaction</source><year>2001</year><publisher-name>London  , Sage Publication</publisher-name></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Mischler</surname><given-names>EG</given-names></name></person-group><source>Research interviewing. Context and Narrative</source><year>1986</year><publisher-name>Cambridge , Ma: Harvard University Press</publisher-name></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><collab>F&#x000f6;rs&#x000e4;kringskassan</collab></person-group><source>&#x000c5;rsrapport. [Annual report]</source><year>2004</year><publisher-name>&#x000d6;rebro , F&#x000f6;rs&#x000e4;kringskassan &#x000d6;rebro l&#x000e4;n</publisher-name></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lincoln</surname><given-names>YS</given-names></name><name><surname>Guba</surname><given-names>EG</given-names></name></person-group><source>Naturalistic Inquiry</source><year>1985</year><publisher-name>New York , Sage Publication </publisher-name></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kvale</surname><given-names>S</given-names></name></person-group><source>Interviews: An Introduction to Qualitative Research Interviewing</source><year>1996</year><publisher-name>Thousand Oaks, CA , Sage Publications</publisher-name></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><collab>MFR</collab></person-group><source>Ethical guidelines for medical humane research. </source><year>2003</year><publisher-name>[Riktlinjer f&#x000f6;r etisk v&#x000e4;rdering av medicinsk humanforskning.] Uppsala , Almqvist &#x00026; Wiksell Tryckeri</publisher-name></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lipsky</surname><given-names>M</given-names></name></person-group><source>Street-level Bureaucracy: Dilemmas of Individuals in Public Service</source><year>1980</year><publisher-name>New York , Russell Sage Foundation</publisher-name></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Larsson</surname><given-names>L</given-na