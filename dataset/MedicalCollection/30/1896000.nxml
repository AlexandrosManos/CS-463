>0</td><td align="left">28*</td><td align="left">1</td><td align="left">9</td><td align="left">13</td><td align="left">5</td><td align="left">4</td><td align="left">10</td><td align="left">0</td><td align="left">16</td><td align="left">3</td><td align="left">2</td><td align="left">0</td><td align="left">5</td></tr><tr><td></td><td align="left">5</td><td align="left">110*</td><td align="left">11</td><td align="left">18</td><td align="left">6</td><td align="left">0</td><td align="left">1</td><td align="left">0</td><td align="left">2</td><td align="left">10</td><td align="left">5</td><td align="left">56*</td><td align="left">16</td><td align="left">19</td><td align="left">13</td><td align="left">0</td><td align="left">0</td><td align="left">1</td><td align="left">26*</td><td align="left">0</td><td align="left">7</td></tr><tr><td></td><td align="left">6</td><td align="left">13</td><td align="left">3</td><td align="left">32</td><td align="left">2</td><td align="left">0</td><td align="left">49*</td><td align="left">0</td><td align="left">0</td><td align="left">4</td><td align="left">1</td><td align="left">10</td><td align="left">3</td><td align="left">1</td><td align="left">2</td><td align="left">1</td><td align="left">3</td><td align="left">3</td><td align="left">10</td><td align="left">12</td><td align="left">3</td></tr><tr><td></td><td align="left">7</td><td align="left">3</td><td align="left">1</td><td align="left">36</td><td align="left">2</td><td align="left">0</td><td align="left">55*</td><td align="left">0</td><td align="left">0</td><td align="left">0</td><td align="left">1</td><td align="left">2</td><td align="left">0</td><td align="left">1</td><td align="left">0</td><td align="left">10</td><td align="left">0</td><td align="left">0</td><td align="left">4</td><td align="left">41*</td><td align="left">2</td></tr><tr><td></td><td align="left">8</td><td align="left">21</td><td align="left">6</td><td align="left">8</td><td align="left">7</td><td align="left">15*</td><