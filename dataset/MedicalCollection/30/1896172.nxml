><article-title>Microalbuminuria as a screening tool in cystic fibrosis-related diabetes</article-title><source>Pediatr Pulmonol</source><year>2005</year><volume>39</volume><fpage>103</fpage><lpage>107</lpage><pub-id pub-id-type="pmid">15573388</pub-id><pub-id pub-id-type="doi">10.1002/ppul.20124</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sullivan</surname><given-names>MM</given-names></name><name><surname>Denning</surname><given-names>CR</given-names></name></person-group><article-title>Diabetic microangiopathy in patients with cystic fibrosis</article-title><source>Pediatrics</source><year>1989</year><volume>84</volume><fpage>642</fpage><lpage>647</lpage><pub-id pub-id-type="pmid">2780126</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rosenecker</surname><given-names>J</given-names></name><name><surname>Hofler</surname><given-names>R</given-names></name><name><surname>Steinkamp</surname><given-names>G</given-names></name><name><surname>Eichler</surname><given-names>I</given-names></name><name><surname>Smaczny</surname><given-names>C</given-names></name><name><surname>Ballmann</surname><given-names>M</given-names></name><name><surname>Posselt</surname><given-names>HG</given-names></name><name><surname>Bargon</surname><given-names>J</given-names></name><name><surname>von der Hardt</surname><given-names>H</given-names></name></person-group><article-title>Diabetes mellitus in patients with cystic fibrosis: the impact of diabetes mellitus on pulmonary function and clinical outcome</article-title><source>Eur J Med Res</source><year>2001</year><volume>6</volume><fpage>345</fpage><lpage>350</lpage><pub-id pub-id-type="pmid">11549516</pub-id></citation></ref></ref-list></back></article>