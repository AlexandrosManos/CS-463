ib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gewin</surname><given-names>V</given-names></name></person-group><article-title>Eco-defense against invasions</article-title><source>PLoS Biol</source><volume>3</volume><year>2005</year><fpage>2066</fpage><lpage>2071</lpage></citation></ref><ref id="bib11"><citation citation-type="book"><collab>IATA</collab><article-title>IATA industry facts</article-title><year>2006</year><publisher-name>IATA</publisher-name><publisher-loc>Geneva, Switzerland</publisher-loc></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kolar</surname><given-names>C.S</given-names></name><name><surname>Lodge</surname><given-names>D</given-names></name></person-group><article-title>Progress in invasion biology: predicting invaders</article-title><source>Trends Ecol. Evol</source><volume>16</volume><year>2001</year><fpage>199</fpage><lpage>204</lpage><ext-link ext-link-type="uri" xlink:href="http://dx.doi.org/doi:10.1016/S0169-5347(01)02101-2">doi:10.1016/S0169-5347(01)02101-2</ext-link><pub-id pub-id-type="pmid">11245943</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Levine</surname><given-names>J.M</given-names></name><name><surname>D'Antonio</surname><given-names>C.M</given-names></name></person-group><article-title>Forecasting biological invasions with increasing international trade</article-title><source>Conserv. Biol</source><volume>17</volume><year>2003</year><fpage>322</fpage><lpage>326</lpage><ext-link ext-link-type="uri" xlink:href="http://dx.doi.org/doi:10.1046/j.1523-1739.2003.02038.x">doi:10.1046/j.1523-1739.2003.02038.x</ext-link></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liebhold</surname><given-names>A.M</given-names></name><name><surname>Work</surname><g