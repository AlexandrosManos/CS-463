me><surname>Mistura</surname><given-names>K</given-names></name><article-title>Rabbit syndrome treated with botulin</article-title><source>South Med J</source><year>1990</year><volume>83</volume><fpage>854</fpage><lpage>855</lpage><pub-id pub-id-type="pmid">2371612</pub-id></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="journal"><name><surname>Kamijo</surname><given-names>Y</given-names></name><name><surname>Soma</surname><given-names>K</given-names></name><name><surname>Fukuda</surname><given-names>M</given-names></name><name><surname>Asari</surname><given-names>Y</given-names></name><name><surname>Ohwada</surname><given-names>T</given-names></name><article-title>Rabbit syndrome following phenol ingestion</article-title><source>J Toxicol Clin Toxicol</source><year>1999</year><volume>37</volume><fpage>509</fpage><lpage>511</lpage><pub-id pub-id-type="doi">10.1081/CLT-100102444</pub-id><pub-id pub-id-type="pmid">10465250</pub-id></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="journal"><name><surname>Parvin</surname><given-names>MM</given-names></name><name><surname>Swartz</surname><given-names>CM</given-names></name><article-title>Dystonic rabbit syndrome from citalopram</article-title><source>Clin Neuropharmacol</source><year>2005</year><volume>28</volume><fpage>289</fpage><lpage>291</lpage><pub-id pub-id-type="doi">10.1097/01.wnf.0000191348.10375.41</pub-id><pub-id pub-id-type="pmid">16340386</pub-id></mixed-citation></ref><ref id="B19"><mixed-citation publication-type="journal"><name><surname>Gourzis</surname><given-names>P</given-names></name><name><surname>Argyriou</surname><given-names>AA</given-names></name><name><surname>Bakalidou</surname><given-names>C</given-names></name><name><surname>Beratis</surname><given-names>S</given-names></name><article-title>Induction of the rabbit syndrome following coadministration of paroxetine, perphenazine, and amitriptyline</article-title><source>Clin Neuropharmacol</source><yea