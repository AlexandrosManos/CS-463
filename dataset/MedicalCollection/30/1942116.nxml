480, DQ287489</td><td align="left" rowspan="1" colspan="1">3N1-N (3)</td></tr><tr><td align="left" rowspan="1" colspan="1">Tieyon SA</td><td align="left" rowspan="1" colspan="1">&#x02212;26.208</td><td align="left" rowspan="1" colspan="1">133.855</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">DQ287435, DQ287442, DQ287461, DQ287487</td><td align="left" rowspan="1" colspan="1">3N1-E, 3N1-I, 3N1-N (2)</td></tr><tr><td align="left" rowspan="1" colspan="1">Uluru NT</td><td align="left" rowspan="1" colspan="1">&#x02212;25.417</td><td align="left" rowspan="1" colspan="1">131.967</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">ABTC31233</td><td align="left" rowspan="1" colspan="1">DQ287373</td><td align="left" rowspan="1" colspan="1">3N1-N</td></tr><tr><td align="left" rowspan="1" colspan="1">Umbeara NT</td><td align="left" rowspan="1" colspan="1">&#x02212;25.748</td><td align="left" rowspan="1" colspan="1">133.683</td><td align="left" rowspan="1" colspan="1">5</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">DQ287430, DQ287450, DQ287469, DQ287472, DQ287483</td><td align="left" rowspan="1" colspan="1">3N1-G, 3N1-I (2), 3N1-K, 3N1-N</td></tr><tr><td align="left" rowspan="1" colspan="1">Uranerz Camp WA</td><td align="left" rowspan="1" colspan="1">&#x02212;30.159</td><td align="left" rowspan="1" colspan="1">123.443</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">R146782</td><td align="left" rowspan="1" colspan="1">DQ287522</td><td align="left" rowspan="1" colspan="1">3N1-W</td></tr><tr><td align="left" rowspan="1" colspan="1">Victory Downs SA</td><td align="left" rowspan="1" colspan="1">&#x02212;25.988<