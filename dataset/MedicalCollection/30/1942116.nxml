names></name></person-group><year>2005</year><source>Molecular Ecology</source><volume>14</volume><fpage>753</fpage><lpage>764</lpage><pub-id pub-id-type="pmid">15723667</pub-id></citation></ref><ref id="pone.0000760-Templeton2"><label>20</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Templeton</surname><given-names>AR</given-names></name></person-group><year>2003</year><person-group person-group-type="editor"><name><surname>Wasser</surname><given-names>SP</given-names></name></person-group><source>Evolutionary Theory and Processes: Modern Horizons,</source><publisher-loc>Netherlands)</publisher-loc><publisher-name>(Kluwer Academic Publishers</publisher-name><fpage>1</fpage><lpage>22</lpage></citation></ref><ref id="pone.0000760-Adamowicz1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adamowicz</surname><given-names>SJ</given-names></name><name><surname>Gregory</surname><given-names>TR</given-names></name><name><surname>Marinone</surname><given-names>MC</given-names></name><name><surname>Hebert</surname><given-names>PDN</given-names></name></person-group><year>2002</year><source>Molecular Ecology</source><volume>11</volume><fpage>1209</fpage><lpage>1217</lpage><pub-id pub-id-type="pmid">12074728</pub-id></citation></ref><ref id="pone.0000760-Brisson1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brisson</surname><given-names>JA</given-names></name><name><surname>De Toni</surname><given-names>DC</given-names></name><name><surname>Duncan</surname><given-names>I</given-names></name><name><surname>Templeton</surname><given-names>AR</given-names></name></person-group><year>2005</year><source>Evolution</source><volume>59</volume><fpage>1046</fpage><lpage>1059</lpage><pub-id pub-id-type="pmid">16136804</pub-id></citation></ref><ref id="pone.0000760-Hugall1"><label>23</label><citation citation-type="journa