-group><article-title>Proton NMR analysis of plasma is a weak predictor of coronary artery disease</article-title><source>Nat Med</source><year>2006</year><volume>12</volume><fpage>705</fpage><lpage>710</lpage><pub-id pub-id-type="pmid">16732278</pub-id><pub-id pub-id-type="doi">10.1038/nm1432</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ala-Korpela</surname><given-names>M</given-names></name><name><surname>Sipola</surname><given-names>P</given-names></name><name><surname>Kaski</surname><given-names>K</given-names></name></person-group><article-title>Characterization and molecular detection of atherothrombosis by magnetic resonance &#x02013; potential tools for individual risk assessment and diagnostics</article-title><source>Ann Med</source><year>2006</year><volume>38</volume><fpage>322</fpage><lpage>336</lpage><pub-id pub-id-type="pmid">16938802</pub-id><pub-id pub-id-type="doi">10.1080/07853890600862418</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ala-Korpela</surname><given-names>M</given-names></name><name><surname>Lankinen</surname><given-names>N</given-names></name><name><surname>Salminen</surname><given-names>A</given-names></name><name><surname>Suna</surname><given-names>T</given-names></name><name><surname>Soininen</surname><given-names>P</given-names></name><name><surname>Laatikainen</surname><given-names>R</given-names></name><name><surname>Ingman</surname><given-names>P</given-names></name><name><surname>Jauhiainen</surname><given-names>M</given-names></name><name><surname>Taskinen</surname><given-names>M-R</given-names></name><name><surname>H&#x000e9;berger</surname><given-names>K</given-names></name><name><surname>Kaski</surname><given-names>K</given-names></name></person-group><article-title>The inherent accuracy of <sup>1</sup>H NMR spectroscopy to quantify plasma lipoproteins is subclass dependent</article-title><source>Atherosclerosis</source><year>2006</year><volume>190</volume><fpage>352</fpage><lpage>358</lpage><pub-id pub-id-type="pmid">16730730</pub-id><pub-id pub-id-type="doi">10.1016/j.atherosclerosis.2006.04.020</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>M&#x000e4;kinen</surname><given-names>V-P</given-names></name><name><surname>Soininen</surname><given-names>P</given-names></name><name><surname>Forsblom</surname><given-names>C</given-names></name><name><surname>Parkkonen</surname><given-names>M</given-names></name><name><surname>Ingman</surname><given-names>P</given-names></name><name><surname>Kaski</surname><given-names>K</given-names></name><name><surname>Groop</surname><given-names>P-H</given-names></name><name><surname>Ala-Korpela</surname><given-names>M</given-names></name><collab>(on behalf of the FinnDiane Study Group)</collab></person-group><article-title>Diagnosing diabetic nephropathy by <sup>1</sup>H NMR metabonomics of serum</article-title><source>MAGMA</source><year>2006</year><volume>19</volume><fpage>281</fpage><lpage>296</lpage><pub-id pub-id-type="pmid">17171386</pub-id><pub-id pub-id-type="doi">10.1007/s10334-006-0054-y</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ala-Korpela</surname><given-names>M</given-names></name><name><surname>Hiltunen</surname><given-names>Y</given-names></name><name><surname>Bell</surname><given-names>JD</given-names></name></person-group><article-title>Quantification of biomedical NMR data using artificial neural network analysis: lipoprotein lipid profiles from <sup>1</sup>H NMR data of human plasma</article-title><source>NMR Biomed</source><year>1995</year><volume>8</volume><fpage>235</fpage><lpage>244</lpage><pub-id pub-id-type="pmid">8732179</pub-id><pub-id pub-id-type="doi">10.1002/nbm.1940080603</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ala-Korpela</surname><given-names>M</given-names></name><name><surname>Korhonen</surname><given-names>A</given-names></name><name><surname>Keisala</surname><given-names>J</given-names></name><name><surname>H&#x000f6;rkk&#x000f6;</surname><given-names>S</given-names></name><name><surname>Korpi</surname><given-names>P</given-names></name><name><surname>Ingman</surname><given-names>LP</given-names></name><name><surname>Jokisaari</surname><given-names>J</given-names></name><name><surname>Savolainen</surname><given-names>MJ</given-names></name><name><surname>Kes&#x000e4;niemi</surname><given-names>YA</given-names></name></person-group><article-title><sup>1</sup>H NMR-based absolute quantitation of human lipoproteins and their lipid contents directly from plasma</article-title><source>J Lipid Res</source><year>1994</year><volume>35</volume><fpage>2292</fpage><lpage>2304</lpage><pub-id pub-id-type="pmid">7897326</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Otvos</surname><given-names>JD</given-names></name><name><surname>Jeyarajah</surname><given-names>EJ</given-names></name><name><surname>Hayes</surname><given-names>LW</given-names></name><name><surname>Freedman</surname><given-names>DS</given-names></name><name><surname>Janjan</surname><given-names>NA</given-names></name><name><surname>Anderson</surname><given-names>T</given-names></name></person-group><article-title>Relationships between the proton nuclear magnetic resonance properties of plasma lipoproteins and cancer</article-title><source>Clin Chem</source><year>1991</year><volume>37</volume><fpage>369</fpage><lpage>376</lpage><pub-id pub-id-type="pmid">2004443</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bathen</surname><given-names>TF</given-names>