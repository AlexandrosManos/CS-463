/name><name><surname>Goede</surname><given-names>JS</given-names></name><name><surname>West</surname><given-names>C</given-names></name><etal/></person-group><year>2004</year><article-title>Glucose-6-phosphate dehydrogenase (G6PD) deficiency-type Zurich: a splice site mutation as an uncommon mechanism producing enzyme deficiency.</article-title><source>Blood</source><volume>104</volume><fpage>2608</fpage><pub-id pub-id-type="pmid">15466166</pub-id></citation></ref><ref id="pone.0000625-Vuopio1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vuopio</surname><given-names>P</given-names></name><name><surname>Harkonen</surname><given-names>M</given-names></name><name><surname>Helske</surname><given-names>T</given-names></name><name><surname>Naveri</surname><given-names>H</given-names></name></person-group><year>1975</year><article-title>Red cell glucose-6-phosphate dehydrogenase deficiency in Finland. Characterization of a new variant with severe enzyme deficiency.</article-title><source>Scand J Haematol</source><volume>15</volume><fpage>145</fpage><lpage>52</lpage><pub-id pub-id-type="pmid">1188317</pub-id></citation></ref><ref id="pone.0000625-JablonskaSkwiecinska1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jablonska-Skwiecinska</surname><given-names>E</given-names></name><name><surname>Zimowski</surname><given-names>JG</given-names></name><name><surname>Klopocka</surname><given-names>J</given-names></name><name><surname>Bisko</surname><given-names>M</given-names></name><name><surname>Hoffman-Zacharska</surname><given-names>D</given-names></name><etal/></person-group><year>1997</year><article-title>Erythrocyte glucose-6-phosphate dehydrogenase deficiency in Poland&#x02014;A study on the 563 and 1311 mutations of the G6PD gene.</article-title><source>Eur J Hum Genet</source><volume>5</volume><fpage>22</fpage><lpage>4</lpage><pub-id pub-id-type="pmi