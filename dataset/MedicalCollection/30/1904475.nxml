r><source>Alphaviruses associated primarily with fever and polyarthritis</source><person-group person-group-type="editor"><name><surname>Fields</surname><given-names>BN</given-names></name><name><surname>Knipe</surname><given-names>DM</given-names></name><name><surname>Howley</surname><given-names>PM</given-names></name></person-group><comment>3rd edition.</comment><publisher-loc>New York</publisher-loc><publisher-name>Raven Press</publisher-name><comment>pp.</comment><fpage>843</fpage><lpage>898</lpage></citation></ref><ref id="ppat-0030089-b015"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kielian</surname><given-names>M</given-names></name><name><surname>Rey</surname><given-names>FA</given-names></name></person-group><year>2006</year><article-title>Virus membrane-fusion proteins: More than one way to make a hairpin</article-title><source>Nat Rev Microbiol</source><volume>4</volume><fpage>67</fpage><lpage>76</lpage><pub-id pub-id-type="pmid">16357862</pub-id></citation></ref><ref id="ppat-0030089-b016"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marsh</surname><given-names>M</given-names></name><name><surname>Helenius</surname><given-names>A</given-names></name></person-group><year>2006</year><article-title>Virus entry: Open sesame</article-title><source>Cell</source><volume>124</volume><fpage>729</fpage><lpage>740</lpage><pub-id pub-id-type="pmid">16497584</pub-id></citation></ref><ref id="ppat-0030089-b017"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marsh</surname><given-names>M</given-names></name><name><surname>Kielian</surname><given-names>MC</given-names></name><name><surname>Helenius</surname><given-names>A</given-names></name></person-group><year>1984</year><article-title>Semliki forest virus entry and the endocytic pathway</article-title><source>Biochem Soc Trans</source><volume>12</volume><fpage>981</fpage><lpage>983</