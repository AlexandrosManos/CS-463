-0040223-b016"><citation citation-type="journal"><person-group><name><surname>Varghese</surname><given-names>B</given-names></name><name><surname>Maher</surname><given-names>JE</given-names></name><name><surname>Peterman</surname><given-names>TA</given-names></name><name><surname>Branson</surname><given-names>BM</given-names></name><name><surname>Steketee</surname><given-names>RW</given-names></name></person-group><year>2002</year><article-title>Reducing the risk of sexual HIV transmission: Quantifying the per-act risk for HIV on the basis of choice of partner, sex act, and condom use</article-title><source>Sex Transm Dis</source><volume>29</volume><fpage>38</fpage><lpage>43</lpage><pub-id pub-id-type="pmid">11773877</pub-id></citation></ref><ref id="pmed-0040223-b017"><citation citation-type="journal"><person-group><name><surname>Zuckerman</surname><given-names>RA</given-names></name><name><surname>Whittington</surname><given-names>WL</given-names></name><name><surname>Celum</surname><given-names>CL</given-names></name><name><surname>Collis</surname><given-names>TK</given-names></name><name><surname>Lucchetti</surname><given-names>AJ</given-names></name><etal/></person-group><year>2004</year><article-title>Higher concentration of HIV RNA in rectal mucosa secretions than in blood and seminal plasma, among men who have sex with men, independent of antiretroviral therapy</article-title><source>J Infect Dis</source><volume>190</volume><fpage>156</fpage><lpage>161</lpage><pub-id pub-id-type="pmid">15195255</pub-id></citation></ref><ref id="pmed-0040223-b018"><citation citation-type="journal"><person-group><name><surname>John-Stewart</surname><given-names>GC</given-names></name><name><surname>Nduati</surname><given-names>RW</given-names></name><name><surname>Rousseau</surname><given-names>CM</given-names></name><name><surname>Mbori-Ngacha</surname><given-names>DA</given-names></name><name><surname>Richardson</surname><given-names>BA</given-names></name><etal/></person-group><year>2005</year><article-title>Subtype C is associated with increased vaginal shedding of HIV-1</article-title><source>J Infect Dis</source><volume>192</volume><fpage>492</fpage><lpage>496</lpage><pub-id pub-id-type="pmid">15995964</pub-id></citation></ref><ref id="pmed-0040223-b019"><citation citation-type="journal"><person-group><name><surname>Buchbinder</surname><given-names>SP</given-names></name><name><surname>Vittinghoff</surname><given-names>E</given-names></name><name><surname>Heagerty</surname><given-names>PJ</given-names></name><name><surname>Celum</surname><given-names>CL</given-names></name><name><surname>Seage</surname><given-names>GR</given-names><suffix>III</suffix></name><etal/></person-group><year>2005</year><article-title>Sexual risk, nitrite inhalant use, and lack of circumcision associated with HIV seroconversion in men who have sex with men in the United States</article-title><source>J Acquir Immune Defic Syndr</source><volume>39</volume><fpage>82</fpage><lpage>89</lpage><pub-id pub-id-type="pmid">15851918</pub-id></citation></ref><ref id="pmed-0040223-b020"><citation citation-type="journal"><person-group><name><surname>Kreiss</surname><given-names>JK</given-names></name><name><surname>Hopkins</surname><given-names>SG</given-names></name></person-group><year>1993</year><article-title>The association between circumcision status and human immunodeficiency virus infection among homosexual men</article-title><source>J Infect Dis</source><volume>168</volume><fpage>1404</fpage><lpage>1408</lpage><pub-id pub-id-type="pmid">8245525</pub-id></citation></ref><ref id="pmed-0040223-b021"><citation citation-type="journal"><person-group><name><surname>Grulich</surname><given-names>AE</given-names></name><name><surname>Hendry</surname><given-names>O</given-names></name><name><surname>Clark</surname><given-names>E</given-names></name><name><surname>Kippax</surname><given-names>S</given-names></name><name><surname>Kaldor</surname><given-names>JM</given-name