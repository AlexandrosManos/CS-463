k"><person-group person-group-type="author"><name><surname>Gottret</surname><given-names>P</given-names></name><name><surname>Schieber</surname><given-names>G</given-names></name></person-group><source>Health Financing Revisited: A Practitioner's Guide</source><year>2006</year><publisher-name>Washington, DC: World Bank</publisher-name></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ooms</surname><given-names>G</given-names></name></person-group><article-title>Health Development versus Medical Relief: The Illusion versus the Irrelevance of Sustainability</article-title><source>PLoS Med</source><year>2006</year><volume>3</volume></citation></ref><ref id="B27"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Sachs</surname><given-names>J</given-names></name></person-group><article-title>Beware False Tradeoffs</article-title><source>Foreign Affairs</source><ext-link ext-link-type="uri" xlink:href="http://www.foreignaffairs.org/special/global_health/sachs"/><comment>January 23, 2007</comment></citation></ref><ref id="B28"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Benn</surname><given-names>C</given-names></name><name><surname>Schwartlander</surname><given-names>B</given-names></name></person-group><source>The Resource Needs of the Global Fund 2005&#x02013;2007</source><year>2005</year><publisher-name>Geneva: Global Fund to Fight HIV/AIDS, Tuberculosis and Malaria</publisher-name></citation></ref><ref id="B29"><citation citation-type="book"><source>Global Fund Receives Pledges of US$3.7 Billion for 2006&#x02013;2007</source><publisher-name>Geneva: Global Fund to Fight HIV/AIDS, Tuberculosis and Malaria</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.theglobalfund.org/en/media_center/press/pr_050906.asp"/><comment>September 6, 2003</comment></citation></ref><ref id="B30"><citation citation-type="bo