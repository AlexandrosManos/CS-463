ress?</article-title><source>Disease Control Priorities in Developing Countries</source><year>2006</year><edition>2</edition><publisher-name>Washington, DC: Oxford University Press and World Bank</publisher-name><fpage>181</fpage><lpage>194</lpage></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Birdsall</surname><given-names>N</given-names></name></person-group><source>Stormy Days on an Open Field: Asymmetries in the Global Economy, Research Paper 2006/31</source><year>2006</year><publisher-name>Helsinki: World Institute for Development Economics Research</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.wider.unu.edu/publications/rps/rps2006/rp2006-31.pdf"/></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Birdsall</surname><given-names>N</given-names></name></person-group><source>The World is not Flat: Inequality and Injustice in our Global Economy, WIDER Annual Lecture 2005</source><year>2006</year><publisher-name>Helsinki: World Institute for Development Economics Research</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.wider.unu.edu/publications/annual-lectures/annual-lecture-2005.pdf"/></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Jawara</surname><given-names>F</given-names></name><name><surname>Kwa</surname><given-names>E</given-names></name></person-group><source>Behind the Scenes at the WTO: The Real World of International Trade Negotiations</source><year>2003</year><publisher-name>London: Zed Books</publisher-name></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stiglitz</surname><given-names>J</given-names></name><name><surname>Charlton</surname><given-names>AH</given-names></name></person-group><article-title>Common values for the Development Round</article-title><source>World Trade Review</source><year>2004</year><volume>3</volume><fpage>495</fpage><lpage>506</lpage></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Winters</surname><given-names>LA</given-names></name><name><surname>Yusuf</surname><given-names>S</given-names></name></person-group><source>Dancing with the Giants: China, India, and the global economy</source><year>2007</year><publisher-name>Washington, DC: World Bank</publisher-name></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jha</surname><given-names>P</given-names></name><name><surname>Mills</surname><given-names>A</given-names></name><name><surname>Hanson</surname><given-names>K</given-names></name><name><surname>Kumaranayake</surname><given-names>L</given-names></name><name><surname>Conteh</surname><given-names>L</given-names></name><name><surname>Kurowski</surname><given-names>C</given-names></name><name><surname>Nguyen</surname><given-names>SN</given-names></name><name><surname>Cruz</surname><given-names>VO</given-names></name><name><surname>Ranson</surname><given-names>K</given-names></name><name><surname>Vaz</surname><given-names>LM</given-names></name><name><surname>Yu</surname><given-names>S</given-names></name><name><surname>Morton</surname><given-names>O</given-names></name><name><surname>Sachs</surname><given-names>JD</given-names></name></person-group><article-title>Improving the health of the global poor</article-title><source>Science</source><year>2002</year><volume>295</volume><fpage>2036</fpage><lpage>2039</lpage><pub-id pub-id-type="pmid">11896266</pub-id></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><collab>Commission on Macroeconomics and Health</collab></person-group><source>Macroeconomics and Health: Investing in Health for Economic Development</source><year>2001<