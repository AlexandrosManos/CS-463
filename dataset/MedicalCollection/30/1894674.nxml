online]</source><year>2002</year><month>11</month><day>14</day><volume>2</volume><comment>Available from: URL: <ext-link ext-link-type="uri" xlink:href="http://www.ijic.org/">http://www.ijic.org/</ext-link></comment></element-citation></ref><ref id="r8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Shamian</surname><given-names>J</given-names></name><name><surname>LeClair</surname><given-names>SJ</given-names></name></person-group><article-title>Integrated Delivery Systems Now or&#x02026;.??</article-title><source>Healthcare Papers</source><year>2000</year><season>Spring</season><volume>1</volume><issue>2</issue><fpage>66</fpage><lpage>75</lpage><pub-id pub-id-type="pmid">12811067</pub-id></element-citation></ref><ref id="r9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sexton</surname><given-names>A</given-names></name><name><surname>Chan</surname><given-names>C</given-names></name><name><surname>Elliott</surname><given-names>M</given-names></name><name><surname>Stuart</surname><given-names>J</given-names></name><name><surname>Jayasuriya</surname><given-names>R</given-names></name><name><surname>Crookes</surname><given-names>P</given-names></name></person-group><article-title>Nursing handovers: do we really need them?</article-title><source>Journal of Nursing Management</source><year>2004</year><month>1</month><volume>12</volume><issue>1</issue><fpage>37</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">15101454</pub-id></element-citation></ref><ref id="r10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Reed</surname><given-names>J</given-names></name><name><surname>Stanley</surname><given-names>D</given-names></name></person-group><article-title>Improving communication between hospitals and care homes: the development of a daily living plan for older p