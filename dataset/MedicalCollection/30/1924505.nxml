roup person-group-type="author"><name><surname>Rao</surname><given-names>AR</given-names></name><name><surname>Cecchi</surname><given-names>GA</given-names></name><name><surname>Magnasco</surname><given-names>M</given-names></name></person-group><article-title>High performance computing environment for multidimensional image analysis</article-title><source>BMC Cell Biology</source><year>2007</year><volume>8</volume><fpage>S9</fpage></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Staadt</surname><given-names>OG</given-names></name><name><surname>Natarajan</surname><given-names>V</given-names></name><name><surname>Weber</surname><given-names>GH</given-names></name><name><surname>Wiley</surname><given-names>DF</given-names></name><name><surname>Hamann</surname><given-names>B</given-names></name></person-group><article-title>Interactive processing and visualization of image data for biomedical and life science applications</article-title><source>BMC Cell Biology</source><year>2007</year><volume>8</volume><fpage>S10</fpage></citation></ref></ref-list></back></article>