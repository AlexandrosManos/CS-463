pub-id-type="doi">10.1016/S0022-3999(99)00057-4</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldring</surname><given-names>AB</given-names></name><name><surname>Taylor</surname><given-names>SE</given-names></name><name><surname>Kemeny</surname><given-names>ME</given-names></name><name><surname>Anton</surname><given-names>PA</given-names></name></person-group><article-title>Impact of health beliefs, quality of life and the physician-patient relationship of the treatment intentions of Inflammatory Bowel Disease patients</article-title><source>Health Psychol</source><year>2002</year><volume>21</volume><fpage>319</fpage><lpage>228</lpage><pub-id pub-id-type="doi">10.1037/0278-6133.21.3.219</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adams</surname><given-names>S</given-names></name><name><surname>Pill</surname><given-names>R</given-names></name><name><surname>Jones</surname><given-names>A</given-names></name></person-group><article-title>Medication, chronic illness and identity: the perspective of people with asthma</article-title><source>Soc Sci Med</source><year>1997</year><volume>45</volume><fpage>189</fpage><lpage>201</lpage><pub-id pub-id-type="pmid">9225407</pub-id><pub-id pub-id-type="doi">10.1016/S0277-9536(96)00333-4</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Townsend</surname><given-names>A</given-names></name><name><surname>Hunt</surname><given-names>K</given-names></name><name><surname>Wyke</surname><given-names>S</given-names></name></person-group><article-title>Managing multiple morbidity in mid-life: a qualitative study of attitudes to drug use</article-title><source>BMJ</source><year>2003</year><volume>327</volume><fpage>837</fpage><pub-id pub-id-type="pmid">14551097</pub-id><pub-id pub-id-type="doi">10.1136/bmj.327.7419.837</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Britten</surname><given-names>N</given-names></name></person-group><article-title>Patients' ideas about medicines: a qualitative study in a general practice population</article-title><source>BJGP</source><year>1994</year><volume>44</volume><fpage>465</fpage><lpage>468</lpage></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Levenstein</surname><given-names>S</given-names></name><name><surname>Zhiming</surname><given-names>L</given-names></name><name><surname>Almer</surname><given-names>S</given-names></name><name><surname>Barbosa</surname><given-names>A</given-names></name><name><surname>Marquis</surname><given-names>P</given-names></name><name><surname>Moser</surname><given-names>G</given-names></name><name><surname>Sperber</surname><given-names>A</given-names></name><name><surname>Toner</surname><given-names>B</given-names></name><name><surname>Drossman</surname><given-names>DA</given-names></name></person-group><article-title>Cross-cultural variation in disease related concerns among patients with inflammatory bowel disease</article-title><source>Am J Gastroenterol</source><year>2001</year><volume>96</volume><fpage>1822</fpage><lpage>1830</lpage><pub-id pub-id-type="pmid">11419836</pub-id><pub-id pub-id-type="doi">10.1111/j.1572-0241.2001.03878.x</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Britten</surname><given-names>N</given-names></name><name><surname>Stevenson</surname><given-names>F</given-names></name><name><surname>Gafaranga</surname><given-names>J</given-names></name><name><surname>Barry</surname><given-names>C</given-names></name><name><surname>Bradley</surname><given-names>C</given-names></name></person-group><article-title>The expression of aversion