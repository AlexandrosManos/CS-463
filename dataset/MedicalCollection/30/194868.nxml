>FC</given-names></name><name><surname>Feskens</surname><given-names>EJ</given-names></name><name><surname>Caspersen</surname><given-names>CJ</given-names></name><etal></etal></person-group><article-title>Physical activity and cardiovascular risk factors among elderly men in Finland, Italy and the Netherlands</article-title><source>Am J Epidemiol</source><year>1996</year><volume>143</volume><fpage>553</fpage><lpage>561</lpage><pub-id pub-id-type="pmid">8610672</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Williams</surname><given-names>PT</given-names></name></person-group><article-title>High-density lipoprotein cholesterol and other risk factors for coronary heart disease in female runners</article-title><source>N Engl J Med</source><year>1996</year><volume>334</volume><fpage>1298</fpage><lpage>303</lpage><pub-id pub-id-type="pmid">8609947</pub-id><pub-id pub-id-type="doi">10.1056/NEJM199605163342004</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pols</surname><given-names>MA</given-names></name><name><surname>Peeters</surname><given-names>PH</given-names></name><name><surname>Twisk</surname><given-names>JW</given-names></name><etal></etal></person-group><article-title>Physical activity and cardiovascular risk disease risk profile in women</article-title><source>Am J Epidemiol</source><year>1997</year><volume>146</volume><fpage>322</fpage><lpage>328</lpage><pub-id pub-id-type="pmid">9270411</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stefanick</surname><given-names>ML</given-names></name><name><surname>Mackey</surname><given-names>S</given-names></name><name><surname>Sheehan</surname><given-names>M</given-names></name><name><surname>Ellsworth</surname><given-names>N</given-names></name><name><surname>Haskell</surname><given-names>WL</given-names></name><name><surname>Wood</surname><given-names>PD</given-names></name></person-group><article-title>Effects of diet and exercise in men and postmenopausal women with low levels of HDL cholesterol and high levels of LDL cholesterol</article-title><source>N Engl J Med</source><year>1998</year><volume>339</volume><fpage>12</fpage><lpage>20</lpage><pub-id pub-id-type="pmid">9647874</pub-id><pub-id pub-id-type="doi">10.1056/NEJM199807023390103</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kokkinos</surname><given-names>PF</given-names></name><name><surname>Holland</surname><given-names>JC</given-names></name><name><surname>Narayan</surname><given-names>P</given-names></name><name><surname>Colleran</surname><given-names>JA</given-names></name><name><surname>Dotson</surname><given-names>CO</given-names></name><name><surname>Papademetriou</surname><given-names>V</given-names></name></person-group><article-title>Miles run per week and high-density lipoprotein cholesterol levels in healthy, middle-aged men. A dose-response relationship</article-title><source>Arch Intern Med</source><year>1995</year><volume>155</volume><fpage>415</fpage><lpage>420</lpage><pub-id pub-id-type="pmid">7848025</pub-id><pub-id pub-id-type="doi">10.1001/archinte.155.4.415</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lakka</surname><given-names>TA</given-names></name><name><surname>Salonen</surname><given-names>JT</given-names></name></person-group><article-title>Physical activity and serum lipids: a cross sectional population study in eastern Finish men</article-title><source>Am J Epidemiol</source><year>1992</year><volume>136</volume><fpage>806</fpage><lpage>818</lpage><pub-id pub-id-type="pmid">1442746</pub-id></citation></ref></ref-list></back></article>