e><surname>Tavener</surname><given-names>SJ</given-names></name></person-group><year>2006</year><article-title>Dynamics of prion disease transmission in mule deer</article-title><source>Ecol Appl</source><volume>16</volume><fpage>2208</fpage><lpage>2214</lpage><pub-id pub-id-type="pmid">17205898</pub-id></citation></ref><ref id="ppat-0030093-b011"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sigurdson</surname><given-names>CJ</given-names></name><name><surname>Williams</surname><given-names>ES</given-names></name><name><surname>Miller</surname><given-names>MW</given-names></name><name><surname>Spraker</surname><given-names>TR</given-names></name><name><surname>O'Rourke</surname><given-names>KI</given-names></name><etal/></person-group><year>1999</year><article-title>Oral transmission and early lymphoid tropism of chronic wasting disease PrP-res in mule deer fawns <italic>(Odocoileus hemionus)</italic></article-title><source>J Gen Virol</source><volume>80</volume><fpage>2757</fpage><lpage>2764</lpage><pub-id pub-id-type="pmid">10573172</pub-id></citation></ref><ref id="ppat-0030093-b012"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morley</surname><given-names>RS</given-names></name><name><surname>Chen</surname><given-names>S</given-names></name><name><surname>Rheault</surname><given-names>N</given-names></name></person-group><year>2003</year><article-title>Assessment of the risk factors related to bovine spongiform encephalopathy</article-title><source>Rev Sci Tech</source><volume>22</volume><fpage>157</fpage><lpage>178</lpage><pub-id pub-id-type="pmid">12793778</pub-id></citation></ref><ref id="ppat-0030093-b013"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>P</given-names></name></person-group><year>2001</year><article-title>Bovine spongiform encephalopathy and variant Creutzfeldt-Jakob disease</article-title><source>BMJ</source><volume>322</volume><fpage>841</fpage><lpage>844</lpage><pub-id pub-id-type="pmid">11290640</pub-id></citation></ref><ref id="ppat-0030093-b014"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Prusiner</surname><given-names>SB</given-names></name><name><surname>Gajdusek</surname><given-names>C</given-names></name><name><surname>Alpers</surname><given-names>MP</given-names></name></person-group><year>1982</year><article-title>Kuru with incubation periods exceeding two decades</article-title><source>Ann Neurol</source><volume>12</volume><fpage>1</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">7114816</pub-id></citation></ref><ref id="ppat-0030093-b015"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Collinge</surname><given-names>J</given-names></name><name><surname>Whitfield</surname><given-names>J</given-names></name><name><surname>McKintosh</surname><given-names>E</given-names></name><name><surname>Beck</surname><given-names>J</given-names></name><name><surname>Mead</surname><given-names>S</given-names></name><etal/></person-group><year>2006</year><article-title>Kuru in the 21st century&#x02014;an acquired human prion disease with very long incubation periods</article-title><source>Lancet</source><volume>367</volume><fpage>2068</fpage><lpage>2074</lpage><pub-id pub-id-type="pmid">16798390</pub-id></citation></ref><ref id="ppat-0030093-b016"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>P</given-names></name><name><surname>Bradley</surname><given-names>R</given-names></name></person-group><year>1998</year><article-title>1755 and all that: A historical primer of transmissible spongiform encephalopathy</article-title><source>BMJ</source><volume>317</volume><fpage>1688</fpage><lpage>1692</lpage><pub-id pub-id-type="pmid">9857129</pub-id></citation></ref><ref id="ppat-0030093-b017"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marsh</surname><given-names>RF</given-names></name><name><surname>Bessen</surname><given-names>RA</given-names></name><name><surname>Lehmann</surname><given-names>S</given-names></name><name><surname>Hartsough</surname><given-names>GR</given-names></name></person-group><year>1991</year><article-title>Epidemiological and experimental studies on a new incident of transmissible mink encephalopathy</article-title><source>J Gen Virol</source><volume>72</volume><fpage>589</fpage><lpage>594</lpage><pub-id pub-id-type="pmid">1826023</pub-id></citation></ref><ref id="ppat-0030093-b018"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Glaysher</surname><given-names>BR</given-names></name><name><surname>Mabbott</surname><given-names>NA</given-names></name></person-group><year>2007</year><article-title>Role of the GALT in scrapie agent neuroinvasion from the intestine</article-title><source>J Immunol</source><volume>178</volume><fpage>3757</fpage><lpage>3766</lpage><pub-id pub-id-type="pmid">17339474</pub-id></citation></ref><ref id="ppat-0030093-b019"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mabbott</surname><given-names>NA</given-names></name><name><surname>MacPherson</surname><given-names>GG</given-names></name></person-group><year>2006</year><article-title>Prions and their lethal journey to the brain</article-title><source>Nat Rev Microbiol</source><volume>4</volume><fpage>201</fpage><lpage>211</lpage><pub-id pub-id-type="pmid">16462753</pub-id></citation></ref><ref id="ppat-0030093-b020"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Beekes</surname><given-names>M</given-names></name><name><surname>McBride</surname><given-names>PA</given-names></name></person-group><year>2007</year><article-title>The spread of prions through the body in naturally acquired transm