B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mestdag</surname><given-names>I</given-names></name></person-group><article-title>Disappearance of the traditional meal: temporal, social and spatial destructuration</article-title><source>Appetite</source><year>2005</year><volume>45</volume><fpage>62</fpage><lpage>74</lpage><pub-id pub-id-type="pmid">15896879</pub-id><pub-id pub-id-type="doi">10.1016/j.appet.2005.03.003</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Murphy</surname><given-names>M</given-names></name></person-group><article-title>The evolution of cohabitation in Britain, 1960-95</article-title><source>Population Studies</source><year>2000</year><volume>54</volume><fpage>43</fpage><lpage>56</lpage></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Casper</surname><given-names>LM</given-names></name><name><surname>Bianchi</surname><given-names>SM</given-names></name></person-group><source>Continuity and Change in the American Family</source><year>2002</year><publisher-name>Sage Publication</publisher-name></citation></ref><ref id="B18"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Feichtinger</surname><given-names>G</given-names></name><collab>Ed</collab></person-group><source>Vienna yearbook of population research</source><year>2004</year><ext-link ext-link-type="uri" xlink:href="http://hw.oeaw.ac.at/1728-4414?frames=yes"/></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McArdle</surname><given-names>P</given-names></name><name><surname>Wiegersma</surname><given-names>A</given-names></name><name><surname>Gilvarry</surname><given-names>E</given-names></name><name><surname>Kolte</surname><given-names>B</given-names></name><name><surname>McCarthy</surn