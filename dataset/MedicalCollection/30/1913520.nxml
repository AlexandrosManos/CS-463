me><surname>Winzeler</surname><given-names>EA</given-names></name></person-group><article-title>Treasures and traps in genome-wide data sets: case examples from yeast</article-title><source>Nat Rev Genet</source><year>2002</year><volume>3</volume><fpage>653</fpage><lpage>661</lpage><pub-id pub-id-type="pmid">12209140</pub-id><pub-id pub-id-type="doi">10.1038/nrg886</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tan</surname><given-names>PK</given-names></name><name><surname>Downey</surname><given-names>TJ</given-names></name><name><surname>Spitznagel</surname><given-names>EL</given-names><suffix>Jr</suffix></name><name><surname>Xu</surname><given-names>P</given-names></name><name><surname>Fu</surname><given-names>D</given-names></name><name><surname>Dimitrov</surname><given-names>DS</given-names></name><name><surname>Lempicki</surname><given-names>RA</given-names></name><name><surname>Raaka</surname><given-names>BM</given-names></name><name><surname>Cam</surname><given-names>MC</given-names></name></person-group><article-title>Evaluation of gene expression measurements from commercial microarray platforms</article-title><source>Nucl Acids Res</source><year>2003</year><volume>31</volume><fpage>5676</fpage><lpage>5684</lpage><pub-id pub-id-type="pmid">14500831</pub-id><pub-id pub-id-type="doi">10.1093/nar/gkg763</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Miklos</surname><given-names>GLG</given-names></name><name><surname>Maleszka</surname><given-names>R</given-names></name></person-group><article-title>Microarray reality checks in the context of a complex disease</article-title><source>Nat Biotech</source><year>2004</year><volume>22</volume><fpage>615</fpage><lpage>621</lpage><pub-id pub-id-type="doi">10.1038/nbt965</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marshall</surname><given-names>E</given-names></name></person-group><article-title>Getting the Noise Out of Gene Arrays</article-title><source>Science</source><year>2004</year><volume>306</volume><fpage>630</fpage><lpage>631</lpage><pub-id pub-id-type="pmid">15499004</pub-id><pub-id pub-id-type="doi">10.1126/science.306.5696.630</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Steinmetz</surname><given-names>LM</given-names></name><name><surname>Davis</surname><given-names>RW</given-names></name></person-group><article-title>Maximizing the potential of functional genomics</article-title><source>Nat Rev Genet</source><year>2004</year><volume>5</volume><fpage>190</fpage><lpage>201</lpage><pub-id pub-id-type="pmid">14970821</pub-id><pub-id pub-id-type="doi">10.1038/nrg1293</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Frantz</surname><given-names>S</given-names></name></person-group><article-title>An array of problems</article-title><source>Nat Rev Drug Discov</source><year>2005</year><volume>4</volume><fpage>362</fpage><lpage>363</lpage><pub-id pub-id-type="pmid">15902768</pub-id><pub-id pub-id-type="doi">10.1038/nrd1746</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Michiels</surname><given-names>S</given-names></name><name><surname>Koscielny</surname><given-names>S</given-names></name><name><surname>Hill</surname><given-names>C</given-names></name></person-group><article-title>Prediction of cancer outcome with microarrays: a multiple random validation strategy</article-title><source>The Lancet</source><year>2005</year><volume>365</volume><fpage>488</fpage><lpage>492</lpage><pub-id pub-id-type="doi">10.1016/S0140-6736(05)17866-0</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tibshirani</surname><given-names>R</given-names></name><name><surname>Hong</surname><given-names>WJ</given-names></name><name><surname>Warnke</surname><given-names>R</given-names></name><name><surname>Chu</surname><given-names>G</given-names></name><name><surname>Staudt</surname><given-names>LM</given-names></name><name><surname>Wright</surname><given-names>G</given-names></name><name><surname>Dave</surname><given-names>S</given-names></name></person-group><article-title>Immune Signatures in Follicular Lymphoma</article-title><source>N Engl J Med</source><year>2005</year><volume>352</volume><fpage>1496</fpage><lpage>1497</lpage><pub-id pub-id-type="pmid">15814892</pub-id><pub-id pub-id-type="doi">10.1056/NEJM200504073521422</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ein-Dor</surname><given-names>L</given-names></name><name><surname>Zuk</surname><given-names>O</given-names></name><name><surname>Domany</surname><given-names>E</given-names></name></person-group><article-title>Thousands of samples are needed to generate a robust gene list for predicting outcome in cancer</article-title><source>PNAS</source><year>2006</year><volume>103</volume><fpage>5923</fpage><lpage>5928</lpage><pub-id pub-id-type="pmid">16585533</pub-id><pub-id pub-id-type="doi">10.1073/pnas.0601231103</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Petersen</surname><given-names>D</given-names></name><name><surname>Chandramouli</surname><given-names>GV</given-names></name><name><surname>Geoghegan</surname><given-names>J</given-names></name><name><surname>Hilburn</surname><given-names>J</given-names></name><name><surname>Paarlberg</surname><given-names>J</given-names></name><name><surname>Kim</surname><given-names>CH</given-names></name><name><surname>Munroe</surname><gi