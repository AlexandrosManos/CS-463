 citation-type="journal"><person-group person-group-type="author"><collab>Golden-Biddle K</collab><collab>Reay T</collab><collab>Petz S</collab><collab>Witt C</collab><collab>Casebeer A</collab><collab>Pablo A</collab><collab>Hinings CR</collab></person-group><article-title>Toward a communicative perspective of collaborating in research: the case of the researcher-decision-maker partnership</article-title><source>J Health Serv Res Policy</source><year>2003</year><volume>8</volume><fpage>20</fpage><lpage>25</lpage><pub-id pub-id-type="pmid">14596744</pub-id><pub-id pub-id-type="doi">10.1258/135581903322405135</pub-id></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><collab>Canadian Health Services Research Foundation</collab></person-group><source>Issues in linkage and exchange between researchers and decision makers</source><year>1999</year><publisher-name>Ottawa, Canadian Health Services Research Foundation</publisher-name></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Poulos</surname><given-names>RG</given-names></name><name><surname>Zwi</surname><given-names>AB</given-names></name></person-group><article-title>What exactly is society getting for its research dollars?</article-title><source>MJA</source><year>2006</year><volume>184</volume><fpage>252</fpage><lpage>253</lpage><pub-id pub-id-type="pmid">16515441</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><collab>Hanney SR</collab><collab>Gonzakez-Block MA</collab><collab>Buxton MJ</collab><collab>Kogan M</collab></person-group><article-title>The utilisation of health research in policy-making: concepts, examples and methods of assessment</article-title><source>Health Res Policy Syst</source><year>2003</year><volume>1</volume><fpage>2</fpage><pub-id pub-id-type="pmid">12646071</pub-id><pub-id pub-id-type="doi">10.1186/1478-4505-1-2</pub-id></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Moller</surname><given-names>J</given-names></name></person-group><source>Projected costs of fall related injury to older persons due to demographic change in Australia: report to the Commonwealth Department of Health and Ageing.</source><year>2003</year><publisher-name>Canberra, Commonwealth Department of Health and Ageing</publisher-name></citation></ref></ref-list></back></article>