er"><bold>(12)</bold></td><td align="center">0 (0)</td><td align="center">4 (22)</td><td align="center">1 (5)</td><td align="center">*</td><td align="left">P 10, 18, 31, 42, 44</td></tr><tr><td align="left">&#x02003;Patients</td><td align="center"><bold>2</bold></td><td align="center"><bold>(5)</bold></td><td align="center">0 (0)</td><td align="center">0 (0)</td><td align="center">2 (11)</td><td align="center">*</td><td align="left">P 13, 38</td></tr><tr><td align="left">&#x02003;Clerical</td><td align="center"><bold>1</bold></td><td align="center"><bold>(2)</bold></td><td align="center">0 (0)</td><td align="center">0 (0)</td><td align="center">1 (5)</td><td align="center">*</td><td align="left">P 22</td></tr><tr><td align="left">&#x02003;&#x02003;<italic>Missing</italic></td><td align="center"><italic>14</italic></td><td align="center"><italic>(25)</italic></td><td align="center"><italic>2(29)</italic></td><td align="center"><italic>2(10)</italic></td><td align="center"><italic>10(34)</italic></td><td></td><td></td></tr><tr><td colspan="8"><hr></hr></td></tr><tr><td align="left" colspan="8"><bold>Type of data integrated</bold><sup>&#x02021;</sup></td></tr><tr><td align="left">&#x02003;Diagnosis and Problems</td><td align="center"><bold>40</bold></td><td align="center"><bold>(77)</bold></td><td align="center">6 (86)</td><td align="center">13 (76)</td><td align="center">21 (75)</td><td align="center">*</td><td align="left">P 1, 2, 3, 5, 8, 9, 10, 11, 12, 14, 15, 16, 20, 21, 22, 23, 24, 25, 26, 27, 29, 30, 31, 32, 34, 36, 37, 38, 40, 41, 42, 43, 46, 47, 49, 50, 51, 53, 54, 55</td></tr><tr><td align="left">&#x02003;Images</td><td align="center"><bold>35</bold></td><td align="center"><bold>(67)</bold></td><td align="center">4 (57)</td><td align="center">14 (82)</td><td align="center">17 (61)</td><td align="center">*</td><td align="left">P 3, 6, 8, 9, 10, 11, 12, 13, 14, 15, 16, 20, 21, 22, 25, 26, 27, 28, 30, 31, 32, 33, 36, 37, 39, 42, 43, 44, 46, 47, 48, 49, 51, 54, 5