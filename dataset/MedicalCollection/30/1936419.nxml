2.7)</italic></td><td align="center">74.5</td><td align="center"><italic>(72.4;76.6)</italic></td></tr><tr><td colspan="13"><hr></hr></td></tr><tr><td align="left">C</td><td></td><td align="center">8145</td><td align="center">17.8</td><td align="center">6.4</td><td align="center">30883</td><td align="center">18.3</td><td align="center">10.1</td><td align="center">17.9</td><td align="center">81.7</td><td align="center"><italic>(80.1;83.3)</italic></td><td align="center">76.5</td><td align="center"><italic>(74.4;78.5)</italic></td></tr><tr><td></td><td align="center">6</td><td align="center">4255</td><td align="center">15.0</td><td align="center">7.8</td><td align="center">32536</td><td align="center">19.5</td><td align="center">13.4</td><td align="center">18.4</td><td align="center">83.7</td><td align="center"><italic>(80.9;86.6)</italic></td><td align="center">77.8</td><td align="center"><italic>(74.4;81.2)</italic></td></tr><tr><td></td><td align="center">7</td><td align="center">3890</td><td align="center">20.8</td><td align="center">4.9</td><td align="center">29075</td><td align="center">17.0</td><td align="center">6.6</td><td align="center">17.4</td><td align="center">82.9</td><td align="center"><italic>(80.4;85.3)</italic></td><td align="center">76.8</td><td align="center"><italic>(73.5;80.0)</italic></td></tr><tr><td colspan="13"><hr></hr></td></tr><tr><td align="left">D</td><td></td><td align="center">15440</td><td align="center">12.6</td><td align="center">16.9</td><td align="center">26614</td><td align="center">21.3</td><td align="center">14.0</td><td align="center">15.3</td><td align="center">81.3</td><td align="center"><italic>(80.0;82.5)</italic></td><td align="center">77.4</td><td align="center"><italic>(75.9;79.0)</italic></td></tr><tr><td></td><td align="center">8</td><td align="center">4495</td><td align="center">13.0</td><td align="center">15.7</td><td align="center">27269</td><td align="center">19.6</td><td align="center">12.3</td><td align="center">17.5</td><td align="center">82.2</td><td align="center"><italic>(79.5;84.3)</italic></td><td align="center">77.5</td><td align="center"><italic>(74.5;30.6)</italic></td></tr><tr><td></td><td align="center">10</td><td align="center">6290</td><td align="center">15.3</td><td align="center">13.4</td><td align="center">27295</td><td align="center">20.6</td><td align="center">7.1</td><td align="center">11.6</td><td align="center">81.3</td><td align="center"><italic>(79.0;83.7)</italic></td><td align="center">78.0</td><td align="center"><italic>(75.0;81.0)</italic></td></tr><tr><td></td><td align="center">13</td><td align="center">4655</td><td align="center">8.4</td><td align="center">13.9</td><td align="center">25091</td><td align="center">23.9</td><td align="center">24.9</td><td align="center">18.6</td><td align="center">80.5</td><td align="center"><italic>(78.2;82.7)</italic></td><td align="center">76.7</td><td align="center"><italic>(74.1;79.4)</italic></td></tr><tr><td colspan="13"><hr></hr></td></tr><tr><td align="left">E</td><td></td><td align="center">9210</td><td align="center">12.9</td><td align="center">19.3</td><td align="center">27400</td><td align="center">23.0</td><td align="center">11.6</td><td align="center">16.1</td><td align="center">78.9*</td><td align="center"><italic>(77.5;80.4)</italic></td><td align="center">74.8</td><td align="center"><italic>(73.0;76.6)</italic></td></tr><tr><td></td><td align="center">9</td><td align="center">4905</td><td align="center">12.9</td><td align="center">15.4</td><td align="center">28809</td><td align="center">21.3</td><td align="center">9.7</td><td align="center">16.3</td><td align="center">83.4</td><td align="center"><italic>(79.8;87.0)</italic></td><td align="center">78.0</td><td align="center"><italic>(73.2;82.8)</italic></td></tr><tr><td></td><td align="center">11</td><td align="center">4305</td><td align="center">12.8</td><td align="center">24.0</td><td align="center">25795</td><td align="center">25.1</td><td al