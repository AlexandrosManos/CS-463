><ref id="pone.0000887-Dietz2"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dietz</surname><given-names>R</given-names></name><name><surname>Heide-J&#x000f8;rgensen</surname><given-names>M-P</given-names></name><name><surname>H&#x000e4;rk&#x000f6;nen</surname><given-names>T</given-names></name><name><surname>Teilmann</surname><given-names>J</given-names></name><name><surname>Valentin</surname><given-names>N</given-names></name></person-group><year>1991</year><article-title>Age determination of European harbour seals.</article-title><source>Sarsia</source><volume>76</volume><fpage>17</fpage><lpage>21</lpage></citation></ref><ref id="pone.0000887-Leslie1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leslie</surname><given-names>PH</given-names></name></person-group><year>1948</year><article-title>Some further notes on the use of matrices in population mathematics.</article-title><source>Biometrica</source><volume>35</volume><fpage>213</fpage><lpage>245</lpage></citation></ref><ref id="pone.0000887-Hrknen3"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>H&#x000e4;rk&#x000f6;nen</surname><given-names>T</given-names></name><name><surname>Harding</surname><given-names>KC</given-names></name><name><surname>Lunneryd</surname><given-names>SG</given-names></name></person-group><year>1999</year><article-title>Age and sex specific behaviour in harbour seals leads to biased estimates of vital population parameters</article-title><source>J Appl Ecol</source><volume>36</volume><fpage>824</fpage><lpage>840</lpage></citation></ref><ref id="pone.0000887-Hrknen4"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>H&#x000e4;rk&#x000f6;nen</surname><given-names>T</given-names></name><name><surname>Harding</surname><given-names>KC</given-names></name><