="r19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kodner</surname><given-names>D</given-names></name><name><surname>Kyriacou</surname><given-names>C</given-names></name></person-group><article-title>Fully integrated care for frail elderly: two American models</article-title><source>International Journal of Integrated Care [serial online]</source><year>2000</year><month>11</month><day>1</day><volume>1</volume><comment>Available from: <ext-link ext-link-type="uri" xlink:href="http://www.ijic.org/">http://www.ijic.org/</ext-link></comment></element-citation></ref><ref id="r20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kodner</surname><given-names>D</given-names></name><name><surname>Spreeuwenberg</surname><given-names>C</given-names></name></person-group><article-title>Integrated care: meaning, logic, applications, and implications: a discussion paper</article-title><source>International Journal of Integrated Care [serial online]</source><year>2002</year><month>11</month><day>14</day><volume>2</volume><comment>Available from: <ext-link ext-link-type="uri" xlink:href="http://www.ijic.org/">http://www.ijic.org/</ext-link></comment></element-citation></ref><ref id="r21"><label>21</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Von Koff</surname><given-names>M</given-names></name><name><surname>Gruman</surname><given-names>J</given-names></name><name><surname>Schaefer</surname><given-names>J</given-names></name><name><surname>Curry</surname><given-names>SJ</given-names></name><name><surname>Wagner</surname><given-names>EH</given-names></name></person-group><article-title>Collaborative management of chronic illness</article-title><source>Annals of Internal Medicine</source><year>1997</year><volume>127</volume><issue>12</issue><fpage>1097</fpage><lpage>102</lpage><pub-id pub-id-type="pmid">9412313</pub-id></element-citation></ref><ref id="r22"><label>22</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Suprina</surname><given-names>JS</given-names></name></person-group><article-title>Chronic pain: a case for using an integration model</article-title><source>Journal of Bodywork and Movement Therapies</source><year>2003</year><volume>7</volume><issue>3</issue><fpage>184</fpage><lpage>93</lpage></element-citation></ref><ref id="r23"><label>23</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Collett</surname><given-names>BJ</given-names></name><name><surname>Cordle</surname><given-names>C</given-names></name><name><surname>Stewart</surname><given-names>C</given-names></name></person-group><article-title>Setting up a multidisciplinary clinic</article-title><source>Bailli&#x000e8;res Clinical Obstetrics and Gynaecology</source><year>2000</year><volume>14</volume><issue>3</issue><fpage>541</fpage><lpage>56</lpage></element-citation></ref><ref id="r24"><label>24</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Keel</surname><given-names>P</given-names></name></person-group><article-title>Pain management strategies and team approach</article-title><source>Bailli&#x000e8;res Clinical Rheumatology</source><year>1999</year><volume>13</volume><issue>3</issue><fpage>493</fpage><lpage>506</lpage></element-citation></ref><ref id="r25"><label>25</label><element-citation publication-type="webpage"><person-group person-group-type="author"><name><surname>Campbell</surname><given-names>D</given-names></name><name><surname>Brand</surname><given-names>C</given-names></name><name><surname>Bucknall</surname><given-names>T</given-names></name><name><surname>Copnell</surname><given-names>B</given-names></name></person-group><article-title>Pain: the 5th vital sign review of acute pai