 Dermatology</source><publisher-loc>New York</publisher-loc><publisher-name>Springer Verlag</publisher-name><fpage>1036</fpage><lpage>1037</lpage></citation></ref><ref id="b13-ehp0115-001007"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>J&#x000e4;rvholm</surname><given-names>B</given-names></name><name><surname>Tor&#x000e9;n</surname><given-names>K</given-names></name><name><surname>Brolin</surname><given-names>I</given-names></name><name><surname>Ericsson</surname><given-names>J</given-names></name><name><surname>Morgan</surname><given-names>U</given-names></name><name><surname>Tylen</surname><given-names>U</given-names></name><etal/></person-group><year>1988</year><article-title>Lung function in workers exposed to soft paper dust</article-title><source>Am J Ind Med</source><volume>14</volume><fpage>457</fpage><lpage>464</lpage><pub-id pub-id-type="pmid">3263799</pub-id></citation></ref><ref id="b14-ehp0115-001007"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kanerva</surname><given-names>L</given-names></name><name><surname>Estlander</surname><given-names>T</given-names></name><name><surname>Jolanki</surname><given-names>R</given-names></name><name><surname>Henriks-Eckerman</surname><given-names>M-L</given-names></name></person-group><year>1993</year><article-title>Occupational allergic contact dermatitis caused by diethyl-enetriamine in carbonless copy paper</article-title><source>Contact Dermatitis</source><volume>29</volume><fpage>147</fpage><lpage>151</lpage><pub-id pub-id-type="pmid">8222627</pub-id></citation></ref><ref id="b15-ehp0115-001007"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kraus</surname><given-names>T</given-names></name><name><surname>Pfahlberg</surname><given-names>A</given-names></name><name><surname>Gefeller</surname><given-names>O</given-names></name><name><surname>Raithel</surname><given-names>HJ</given-