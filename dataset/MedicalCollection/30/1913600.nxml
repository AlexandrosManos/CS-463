etal/></person-group><year>2003</year><article-title>Air pollution and heart rate variability among the elderly in Mexico City</article-title><source>Epidemiology</source><volume>14</volume><fpage>521</fpage><lpage>527</lpage><pub-id pub-id-type="pmid">14501266</pub-id></citation></ref><ref id="b10-ehp0115-001002"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kazaks</surname><given-names>A</given-names></name><name><surname>Uriu-Adams</surname><given-names>JY</given-names></name><name><surname>Stern</surname><given-names>JS</given-names></name><name><surname>Albertson</surname><given-names>TE</given-names></name></person-group><year>2005</year><article-title>No significant relationship between exhaled nitric oxide and body mass index in people with asthma</article-title><source>J Allergy Clin Immunol</source><volume>116</volume><fpage>929</fpage><lpage>930</lpage><pub-id pub-id-type="pmid">16210074</pub-id></citation></ref><ref id="b11-ehp0115-001002"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>JY</given-names></name><name><surname>Hauser</surname><given-names>R</given-names></name><name><surname>Wand</surname><given-names>MP</given-names></name><name><surname>Herrick</surname><given-names>RF</given-names></name><name><surname>Amarasiriwardena</surname><given-names>CJ</given-names></name><name><surname>Christiani</surname><given-names>DC</given-names></name></person-group><year>2003</year><article-title>The association of expired nitric oxide with occupational particulate metal exposure</article-title><source>Environ Res</source><volume>93</volume><fpage>158</fpage><lpage>166</lpage><pub-id pub-id-type="pmid">12963400</pub-id></citation></ref><ref id="b12-ehp0115-001002"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>JY</given-names></name><name><surname>Magari</surname><given-names>S