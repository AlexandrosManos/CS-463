-names></name><etal/></person-group><year>1996</year><article-title>Detection of apoptosis in KG-1a leukemic cells treated with investigational drugs.</article-title><source>Arzneimittelforschung</source><volume>46</volume><fpage>196</fpage><lpage>200</lpage><pub-id pub-id-type="pmid">8720313</pub-id></citation></ref><ref id="pone.0000798-Efferth3"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Efferth</surname><given-names>T</given-names></name><name><surname>Dunstan</surname><given-names>H</given-names></name><name><surname>Sauerbreys</surname><given-names>A</given-names></name><name><surname>Miyachi</surname><given-names>H</given-names></name><name><surname>Chitambar</surname><given-names>CR</given-names></name></person-group><year>2001</year><article-title>The antimalarial artesunate is also active against cancer.</article-title><source>Int J Oncol</source><volume>18</volume><fpage>767</fpage><lpage>773</lpage><pub-id pub-id-type="pmid">11251172</pub-id></citation></ref><ref id="pone.0000798-Efferth4"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Efferth</surname><given-names>T</given-names></name><name><surname>Sauerbrey</surname><given-names>A</given-names></name><name><surname>Olbrich</surname><given-names>A</given-names></name><etal/></person-group><year>2003</year><article-title>Molecular modes of action of artesunate in tumor cell lines.</article-title><source>Mol Pharmacol</source><volume>64</volume><fpage>382</fpage><lpage>394</lpage><pub-id pub-id-type="pmid">12869643</pub-id></citation></ref><ref id="pone.0000798-Singh1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Singh</surname><given-names>NP</given-names></name><name><surname>Lai</surname><given-names>H</given-names></name></person-group><year>2001</year><article-title>Selective toxicity of dihydroartemisinin and holotran