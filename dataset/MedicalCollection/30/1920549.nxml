"book"><person-group person-group-type="author"><name><surname>Mogilner</surname><given-names>A</given-names></name><name><surname>Marland</surname><given-names>E</given-names></name><name><surname>Bottino</surname><given-names>D</given-names></name></person-group><year>2001</year><article-title>A minimal model of locomotion applied to the steady &#x02018;gliding&#x02019; movement of fish keratocyte cells.</article-title><person-group person-group-type="editor"><name><surname>Othmer</surname><given-names>H</given-names></name><name><surname>Maini</surname><given-names>P</given-names></name></person-group><source>Pattern formation and morphogenesis: Basic processes</source><publisher-loc>New York</publisher-loc><publisher-name>Springer</publisher-name><fpage>269</fpage><lpage>294</lpage></citation></ref><ref id="pone.0000633-Parsey1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parsey</surname><given-names>MV</given-names></name><name><surname>Lewis</surname><given-names>GK</given-names></name></person-group><year>1993</year><article-title>Actin polymerization and pseudopod reorganization accompany anti-CD3 induced growth arrest in Jurkat T cells.</article-title><source>J Immunol</source><volume>151</volume><fpage>1881</fpage><lpage>1893</lpage><pub-id pub-id-type="pmid">7688389</pub-id></citation></ref><ref id="pone.0000633-Borroto1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Borroto</surname><given-names>A</given-names></name><name><surname>Gil</surname><given-names>D</given-names></name><name><surname>Delgado</surname><given-names>P</given-names></name><name><surname>Vicente-Manzanares</surname><given-names>M</given-names></name><name><surname>Alcover</surname><given-names>A</given-names></name><name><surname>Sanchez-Madrid</surname><given-names>F</given-names></name><name><surname>Alarcon</surname><given-names>B</given-names></name></perso