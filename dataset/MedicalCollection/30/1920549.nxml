><fpage>4306</fpage><lpage>4316</lpage><pub-id pub-id-type="pmid">16963506</pub-id></citation></ref><ref id="pone.0000633-Wlfing1"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>W&#x000fc;lfing</surname><given-names>C</given-names></name><name><surname>Davis</surname><given-names>MM</given-names></name></person-group><year>1998</year><article-title>A receptor/cytoskeletal movement triggered by costimulation during T cell activation.</article-title><source>Science</source><volume>282</volume><fpage>2266</fpage><lpage>2269</lpage><pub-id pub-id-type="pmid">9856952</pub-id></citation></ref><ref id="pone.0000633-Moss1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moss</surname><given-names>WC</given-names></name><name><surname>Irvine</surname><given-names>DJ</given-names></name><name><surname>Davis</surname><given-names>MM</given-names></name><name><surname>Krummel</surname><given-names>MF</given-names></name></person-group><year>2002</year><article-title>Quantifying signaling-induced reorientation of T cell receptors during immunological synapse formation.</article-title><source>Proc Natl Acad Sci U S A</source><volume>99</volume><fpage>15024</fpage><lpage>15029</lpage><pub-id pub-id-type="pmid">12415110</pub-id></citation></ref><ref id="pone.0000633-Burkhardt1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burkhardt</surname><given-names>JK</given-names></name><name><surname>Echeverri</surname><given-names>CJ</given-names></name><name><surname>Nilsson</surname><given-names>T</given-names></name><name><surname>Vallee</surname><given-names>RB</given-names></name></person-group><year>1997</year><article-title>Overexpression of the dynamitin (p50) subunit of the dynactin complex disrupts dynein-dependent maintenance of membrane organelle distribution.</article-title><source>J Cell Biol</source><