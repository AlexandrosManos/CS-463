06</year><volume>6</volume><fpage>109</fpage><pub-id pub-id-type="pmid">16643653</pub-id><pub-id pub-id-type="doi">10.1186/1471-2458-6-109</pub-id></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><collab>Haydom Lutheran Hospital</collab></person-group><source>HIV/AIDS policy outline: Risk, vulnerability and impact. Integrating modern and traditional strategies.</source><year>2003</year><publisher-name>Hanang , Haydom Lutheran Hospital</publisher-name><fpage>6</fpage><lpage>8</lpage></citation></ref><ref id="B12"><citation citation-type="other"><person-group person-group-type="author"><collab>United Republic of Tanzania</collab></person-group><article-title>Census cartographic. National Bureau of Statistics (NBS). Dar es Salaam;  (Accessed March 2003: in press)</article-title><ext-link ext-link-type="uri" xlink:href="http://www.tanzania.go.tz/census/manyara.htm"/></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Tanzania Commission for AIDS (TACAIDS)</surname><given-names>NBS</given-names><suffix>ORC Macro</suffix></name></person-group><source>Tanzania HIV/AIDS Indicator Survey 2003-2004</source><year>2005</year><publisher-name>Calverton, Maryland, USA , TACAIDS, NBS and ORC Macro</publisher-name></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><collab>World Health Organisation</collab></person-group><article-title>HIV Simple/Rapid Assays: Operational Characteristics</article-title><source>Report 14</source><year>2004</year><publisher-name> WHO, UNAIDS and the WHO Collaborating Centre for HIV/AIDS Diagnostic and Laboratory Support , Dept. of Microbiology, Institute of Tropical Medicine, Antwerp, Belgium</publisher-name></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fylkesnes</surname><given-names>K</given-names></name><na