ub-id pub-id-type="doi">10.1097/01.aids.0000222076.91114.95</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cheluget</surname><given-names>B</given-names></name><name><surname>Baltazar</surname><given-names>G</given-names></name><name><surname>Orege</surname><given-names>P</given-names></name><name><surname>Ibrahim</surname><given-names>M</given-names></name><name><surname>Marum</surname><given-names>LH</given-names></name><name><surname>Stover</surname><given-names>J</given-names></name></person-group><article-title>Evidence for population level declines in adult HIV prevalence in Kenya</article-title><source>Sex Transm Infect</source><year>2006</year><volume>82 Suppl 1</volume><fpage>i21</fpage><lpage>i26</lpage><pub-id pub-id-type="pmid">16581755</pub-id><pub-id pub-id-type="doi">10.1136/sti.2005.015990</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sandoy</surname><given-names>IF</given-names></name><name><surname>Kvale</surname><given-names>G</given-names></name><name><surname>Michelo</surname><given-names>C</given-names></name><name><surname>Fylkesnes</surname><given-names>K</given-names></name></person-group><article-title>Antenatal clinic-based HIV prevalence in Zambia: declining trends but sharp local contrasts in young women</article-title><source>Trop Med Int Health</source><year>2006</year><volume>11</volume><fpage>917</fpage><lpage>928</lpage><pub-id pub-id-type="pmid">16772014</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-3156.2006.01629.x</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gregson</surname><given-names>S</given-names></name><name><surname>Garnett</surname><given-names>GP</given-names></name><name><surname>Nyamukapa</surname><given-names>CA</given-names></name><name><surname>Hallett</surname><given-n