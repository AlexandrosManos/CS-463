><surname>Whitford</surname><given-names>GM</given-names></name></person-group><article-title>Acute Fluoride Poisoning from a Public Water System</article-title><source>N Engl J Med</source><year>1994</year><volume>330</volume><fpage>95</fpage><lpage>99</lpage><pub-id pub-id-type="pmid">8259189</pub-id><pub-id pub-id-type="doi">10.1056/NEJM199401133300203</pub-id></citation></ref></ref-list></back></article>