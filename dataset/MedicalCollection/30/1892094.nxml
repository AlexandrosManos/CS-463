iven-names></name></person-group><article-title>Prediction of contact maps with neural networks and correlated mutations</article-title><source>Protein Eng</source><year>2001</year><volume>14</volume><fpage>835</fpage><lpage>843</lpage><pub-id pub-id-type="pmid">11742102</pub-id><pub-id pub-id-type="doi">10.1093/protein/14.11.835</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Olemea</surname><given-names>O</given-names></name><name><surname>Rost</surname><given-names>B</given-names></name><name><surname>Valencia</surname><given-names>A</given-names></name></person-group><article-title>Effective use of sequence correlation and conservation in fold recognition</article-title><source>J Mol Biol</source><year>1999</year><volume>293</volume><fpage>1221</fpage><lpage>1239</lpage><pub-id pub-id-type="pmid">10547297</pub-id><pub-id pub-id-type="doi">10.1006/jmbi.1999.3208</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamilton</surname><given-names>N</given-names></name><name><surname>Burrage</surname><given-names>K</given-names></name><name><surname>Ragan</surname><given-names>M</given-names></name><name><surname>Huber</surname><given-names>T</given-names></name></person-group><article-title>Protein contact prediction using patterns of correlation</article-title><source>Proteins</source><year>2004</year><volume>56</volume><fpage>679</fpage><lpage>684</lpage><pub-id pub-id-type="pmid">15281121</pub-id><pub-id pub-id-type="doi">10.1002/prot.20160</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>MacCallum</surname><given-names>RM</given-names></name></person-group><article-title>Striped sheets and protein contact prediction</article-title><source>Bioinformatics</source><year>2004</year><volume>20</volume><fpage>I224</fpage><lpage>I231</lpa