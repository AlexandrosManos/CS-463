"B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kishida</surname><given-names>K</given-names></name><name><surname>Tanigaki</surname><given-names>S</given-names></name></person-group><article-title>Relationship between physical restraint in nursing homes and their institutional characteristics</article-title><source>Japanese Journal of Public Health</source><year>2005</year><volume>52</volume><fpage>703</fpage><lpage>714</lpage><pub-id pub-id-type="pmid">16218411</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sullivan-Marx</surname><given-names>E</given-names></name></person-group><article-title>Restraint-free care: how does a nurse decide?</article-title><source>J Gerontol Nurs</source><year>1996</year><volume>22</volume><fpage>7</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">8975033</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bourbonniere</surname><given-names>M</given-names></name><name><surname>Strumpf</surname><given-names>NE</given-names></name><name><surname>Evans</surname><given-names>LK</given-names></name><name><surname>Maislin</surname><given-names>G</given-names></name></person-group><article-title>Organizational characteristics and restraint use for hospitalized nursing home residents</article-title><source>J Am Geriatr Soc</source><year>2003</year><volume>51</volume><fpage>1079</fpage><lpage>1084</lpage><pub-id pub-id-type="pmid">12890069</pub-id><pub-id pub-id-type="doi">10.1046/j.1532-5415.2003.51355.x</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dimant</surname><given-names>J</given-names></name></person-group><article-title>Avoiding physical restraints in long-term care facilities</article-title><source>J Am Med Dir Asso</source><year>2003</year><volu