gies</source><year>1995</year><publisher-name>New York: Springer</publisher-name><fpage>193</fpage><lpage>206</lpage></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blakeslee</surname><given-names>JA</given-names></name></person-group><article-title>Speaking out: untie the elderly</article-title><source>Am J Nurs</source><year>1988</year><volume>88</volume><fpage>833</fpage><lpage>834</lpage><pub-id pub-id-type="pmid">3377023</pub-id><pub-id pub-id-type="doi">10.2307/3425798</pub-id></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Levine</surname><given-names>JM</given-names></name><name><surname>Marchello</surname><given-names>V</given-names></name><name><surname>Totolos</surname><given-names>E</given-names></name></person-group><article-title>Progress toward a restraint-free environment in a large academic nursing facility</article-title><source>J Am Geriatr Soc</source><year>1995</year><volume>43</volume><fpage>914</fpage><lpage>918</lpage><pub-id pub-id-type="pmid">7636102</pub-id></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnson</surname><given-names>D</given-names></name></person-group><article-title>Restraint-free care: a look back</article-title><source>Nursing Homes Long Term Care Management</source><year>1995</year><volume>44</volume><fpage>26</fpage><lpage>30</lpage></citation></ref></ref-list></back></article>