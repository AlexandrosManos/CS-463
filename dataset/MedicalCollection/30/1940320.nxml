ub-id-type="pmid">16626449</pub-id></citation></ref><ref id="pone.0000781-Michalak2"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Michalak</surname><given-names>P</given-names></name></person-group><year>2006</year><article-title>RNA world &#x02013; the dark matter of evolutionary genomics.</article-title><source>J Evol Biol</source><volume>19</volume><fpage>1768</fpage><lpage>1774</lpage><pub-id pub-id-type="pmid">17040373</pub-id></citation></ref><ref id="pone.0000781-Moehring1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moehring</surname><given-names>AJ</given-names></name><name><surname>Teeter</surname><given-names>KC</given-names></name><name><surname>Noor</surname><given-names>MAF</given-names></name></person-group><year>2007</year><article-title>Genome-wide patterns of expression in <italic>Drosophila</italic> pure species and hybrid males. II. Examination of multiple-species hybridizations, platforms, and life cycle stages.</article-title><source>Mol Biol Evol</source><volume>24</volume><fpage>137</fpage><lpage>145</lpage><pub-id pub-id-type="pmid">17032727</pub-id></citation></ref><ref id="pone.0000781-OrtzBarrientos1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ort&#x000ed;z-Barrientos</surname><given-names>D</given-names></name><name><surname>Counterman</surname><given-names>BA</given-names></name><name><surname>Noor</surname><given-names>MAF</given-names></name></person-group><year>2007</year><article-title>Gene expression divergence and the origin of hybrid dysfunctions.</article-title><source>Genetica</source><volume>129</volume><fpage>71</fpage><lpage>81</lpage><pub-id pub-id-type="pmid">17043744</pub-id></citation></ref><ref id="pone.0000781-Kobel1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kobel</sur