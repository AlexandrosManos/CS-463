><year>2005</year><volume>187</volume><fpage>274</fpage><lpage>81</lpage><pub-id pub-id-type="pmid">16135866</pub-id><pub-id pub-id-type="doi">10.1192/bjp.187.3.274</pub-id></citation></ref></ref-list></back></article>