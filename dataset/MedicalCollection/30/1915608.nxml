n-group><article-title>Sequence information can be obtained from single DNA molecules</article-title><source>Proc Natl Acad Sci U S A</source><year>2003</year><volume>100</volume><fpage>3960</fpage><lpage>3964</lpage><pub-id pub-id-type="doi">10.1073/pnas.0230489100</pub-id></citation><citation citation-type="display-unstructured">Braslavsky, I, Hebert, B, Kartalov, E, Quake, SR (2003) Sequence information can be obtained from single DNA molecules. Proc Natl Acad Sci USA 100: 3960&#x02013;3964 <pub-id pub-id-type="pmid">12651960</pub-id></citation></ref><ref id="CR6"><label>6.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brehm-Stecher</surname><given-names>BF</given-names></name><name><surname>Johnson</surname><given-names>EA</given-names></name></person-group><article-title>Single-cell microbiology: tools, technologies and applications</article-title><source>Microbiol Mol Biol Rev</source><year>2004</year><volume>68</volume><fpage>538</fpage><lpage>559</lpage><pub-id pub-id-type="doi">10.1128/MMBR.68.3.538-559.2004</pub-id></citation><citation citation-type="display-unstructured">Brehm-Stecher, BF, Johnson, EA (2004) Single-cell microbiology: tools, technologies and applications. Microbiol Mol Biol Rev 68: 538&#x02013;559 <pub-id pub-id-type="pmid">15353569</pub-id></citation></ref><ref id="CR7"><label>7.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brzostowicz</surname><given-names>PC</given-names></name><name><surname>Walters</surname><given-names>DM</given-names></name><name><surname>Thomas</surname><given-names>SM</given-names></name><name><surname>Nagarajan</surname><given-names>V</given-names></name><name><surname>Rouviere</surname><given-names>PE</given-names></name></person-group><article-title>mRNA differential display in a microbial enrichment culture: simultaneous identification of three cyclohexanone monooxygenases from three species</article-title><source>Appl Environ Microbiol</source><year>2003</year><volume>69</volume><fpage>334</fpage><lpage>342</lpage><pub-id pub-id-type="doi">10.1128/AEM.69.1.334-342.2003</pub-id></citation><citation citation-type="display-unstructured">Brzostowicz, PC, Walters, DM, Thomas, SM, Nagarajan, V, Rouviere, PE (2003) mRNA differential display in a microbial enrichment culture: simultaneous identification of three cyclohexanone monooxygenases from three species. Appl Environ Microbiol 69: 334&#x02013;342 <pub-id pub-id-type="pmid">12514013</pub-id></citation></ref><ref id="CR8"><label>8.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burgmann</surname><given-names>H</given-names></name><name><surname>Widmer</surname><given-names>F</given-names></name><name><surname>Sigler</surname><given-names>WV</given-names></name><name><surname>Zeyer</surname><given-names>J</given-names></name></person-group><article-title>mRNA extraction and reverse transcription-PCR protocol for detection of <italic>nifH</italic> gene expression by <italic>Azotobacter vinelandii</italic> in soil</article-title><source>Appl Environ Microbiol</source><year>2003</year><volume>69</volume><fpage>1928</fpage><lpage>1935</lpage><pub-id pub-id-type="doi">10.1128/AEM.69.4.1928-1935.2003</pub-id></citation><citation citation-type="display-unstructured">Burgmann, H, Widmer, F, Sigler, WV, Zeyer, J (2003) mRNA extraction and reverse transcription-PCR protocol for detection of nifH gene expression by Azotobacter vinelandii in soil. Appl Environ Microbiol 69: 1928&#x02013;1935 <pub-id pub-id-type="pmid">12676666</pub-id></citation></ref><ref id="CR9"><label>9.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Courtois</surname><given-names>S</given-names></name><name><surname>Cappellano</surname><given-names>CM</given-names></name><name><surname>Ball</surname><given-names>M</given-names></name><name><surname>Francou</surname>