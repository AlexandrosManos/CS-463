-group person-group-type="author"><name><surname>Bjorkman</surname><given-names>PJ</given-names></name><name><surname>Saper</surname><given-names>MA</given-names></name><name><surname>Samraoui</surname><given-names>B</given-names></name><name><surname>Bennett</surname><given-names>WS</given-names></name><name><surname>Strominger</surname><given-names>JL</given-names></name><etal/></person-group><year>1987</year><article-title>The foreign antigen binding site and T cell recognition regions of class I histocompatibility antigens.</article-title><source>Nature</source><volume>329</volume><fpage>512</fpage><lpage>518</lpage><pub-id pub-id-type="pmid">2443855</pub-id></citation></ref><ref id="pone.0000734-Jacob1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jacob</surname><given-names>S</given-names></name><name><surname>McClintock</surname><given-names>MK</given-names></name><name><surname>Zelano</surname><given-names>B</given-names></name><name><surname>Ober</surname><given-names>C</given-names></name></person-group><year>2002</year><article-title>Paternally inherited HLA alleles are associated with women's choice of male odor.</article-title><source>Nat Gen</source><volume>30</volume><fpage>175</fpage><lpage>179</lpage></citation></ref><ref id="pone.0000734-Carroll1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carroll</surname><given-names>LS</given-names></name><name><surname>Penn</surname><given-names>DJ</given-names></name><name><surname>Potts</surname><given-names>WK</given-names></name></person-group><year>2002</year><article-title>Discrimination of MHC-derived odors by untrained mice is consistent with divergence in peptide-binding region residues.</article-title><source>Proc Natl Acad Sci USA</source><volume>99</volume><fpage>2187</fpage><lpage>2192</lpage><pub-id pub-id-type="pmid">11842193</pub-id></citation></ref><ref id="pone.0000734-