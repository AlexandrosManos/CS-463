></ref><ref id="pone.0000600-Lozzia1"><label>30</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lozzia</surname><given-names>GC</given-names></name><name><surname>Furlanis</surname><given-names>C</given-names></name><name><surname>Manachini</surname><given-names>B</given-names></name><name><surname>Rigamonti</surname><given-names>IE</given-names></name></person-group><year>1998</year><article-title>Effects of Bt corn on <italic>Rhopalosiphum padi</italic> L. (Rhynchota Aphididae) and on its predator <italic>Chrysoperla carnea</italic> Stephen (Neuroptera Chrysopidae).</article-title><source>Bolletino di Zoologia Agraria e di Bachicoltura</source><volume>30</volume><fpage>153</fpage><lpage>164</lpage></citation></ref><ref id="pone.0000600-Awmack2"><label>31</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Awmack</surname><given-names>CS</given-names></name><name><surname>Leather</surname><given-names>SR</given-names></name></person-group><year>2002</year><article-title>Host plant quality and fecundity in herbivorous insects.</article-title><source>Annual Review of Entomology</source><volume>47</volume><fpage>817</fpage><lpage>844</lpage></citation></ref><ref id="pone.0000600-Dreyer1"><label>32</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dreyer</surname><given-names>DL</given-names></name><name><surname>Campbell</surname><given-names>BC</given-names></name></person-group><year>1987</year><article-title>Chemical basis of host-plant resistance to aphids.</article-title><source>Plant Cell Environment</source><volume>10</volume><fpage>353</fpage><lpage>361</lpage></citation></ref><ref id="pone.0000600-Weibull1"><label>33</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weibull</surname><given-names>J</given-names></name></person-group><year>1987</year><article-title>Seasonal ch