="author"><name><surname>Tanaka</surname><given-names>S</given-names></name><name><surname>Ebi</surname><given-names>H</given-names></name><name><surname>Yamashita</surname><given-names>K</given-names></name></person-group><article-title>A new mode beyond the inverted-U region of the dopaminergic modulation of the prefrontal cortex</article-title><source><italic>Neurocomputing</italic></source><year>2006</year><volume>69</volume><issue>10&#x02013;12</issue><fpage>1146</fpage><lpage>1149</lpage></element-citation></ref><ref id="B423"><label>423</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Russell</surname><given-names>VA</given-names></name></person-group><article-title>Hypodopaminergic and hypernoradrenergic activity in prefrontal cortex slices of an animal model for attention-deficit hyperactivity disorder&#x02014;the spontaneously hypertensive rat</article-title><source><italic>Behavioural Brain Research</italic></source><year>2002</year><volume>130</volume><issue>1-2</issue><fpage>191</fpage><lpage>196</lpage><pub-id pub-id-type="pmid">11864734</pub-id></element-citation></ref><ref id="B424"><label>424</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Anderson</surname><given-names>V</given-names></name><name><surname>Jacobs</surname><given-names>R</given-names></name><name><surname>Harvey</surname><given-names>AS</given-names></name></person-group><article-title>Prefrontal lesions and attentional skills in childhood</article-title><source><italic>Journal of the International Neuropsychological Society</italic></source><year>2005</year><volume>11</volume><issue>7</issue><fpage>817</fpage><lpage>831</lpage><pub-id pub-id-type="pmid">16519261</pub-id></element-citation></ref><ref id="B425"><label>425</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Conway</surname><given-names>MA</given-names></name><name><surname>Anderson</surname><given-names>SJ</given-names></name><name><surname>Larsen</surname><given-names>SF</given-names></name><etal/></person-group><article-title>The formation of flashbulb memories</article-title><source><italic>Memory and Cognition</italic></source><year>1994</year><volume>22</volume><issue>3</issue><fpage>326</fpage><lpage>343</lpage></element-citation></ref><ref id="B426"><label>426</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mineka</surname><given-names>S</given-names></name><name><surname>&#x000d6;hman</surname><given-names>A</given-names></name></person-group><article-title>Phobias and preparedness: the selective, automatic, and encapsulated nature of fear</article-title><source><italic>Biological Psychiatry</italic></source><year>2002</year><volume>52</volume><issue>10</issue><fpage>927</fpage><lpage>937</lpage><pub-id pub-id-type="pmid">12437934</pub-id></element-citation></ref><ref id="B427"><label>427</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Flykt</surname><given-names>A</given-names></name></person-group><article-title>Visual search with biological threat stimuli: accuracy, reaction times, and heart rate changes</article-title><source><italic>Emotion</italic></source><year>2005</year><volume>5</volume><issue>3</issue><fpage>349</fpage><lpage>353</lpage><pub-id pub-id-type="pmid">16187870</pub-id></element-citation></ref><ref id="B428"><label>428</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Arnsten</surname><given-names>AFT</given-names></name><name><surname>Goldman-Rakic</surname><given-names>PS</given-names></name></person-group><article-title>Selective prefrontal cortical projections to the region of the locus coeruleus and raphe nuclei in the rhesus monkey</article-title><source><italic>Brain Research</italic></source><yea