(19)</td><td align="center">13% (15)</td><td align="center">5% (19)</td><td align="center">0.97 (0.48&#x02013;1.95)</td><td align="center">0.925</td></tr><tr><td align="left">&#x02003;Pap smear</td><td align="center">25% (16)</td><td align="center">25% (16)</td><td align="center">38% (16)</td><td align="center">47% (15)</td><td align="center">42% (24)</td><td align="center">1.32 (0.87&#x02013;1.99)</td><td align="center">0.191</td></tr><tr><td align="left">&#x02003;Mammogram</td><td align="center">13% (16)</td><td align="center">7% (15)</td><td align="center">19% (16)</td><td align="center">15% (13)</td><td align="center">18% (22)</td><td align="center">1.46 (0.70&#x02013;3.03)</td><td align="center">0.309</td></tr><tr><td align="left"><bold>Vaccination</bold></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left">&#x02003;Pneumococcal vaccine</td><td align="center">65% (46)</td><td align="center">70% (46)</td><td align="center">72% (46)</td><td align="center">80% (44)</td><td align="center">82% (55)</td><td align="center">1.39 (1.03&#x02013;1.86)</td><td align="center"><bold>0.030</bold></td></tr><tr><td align="left">&#x02003;Tetanus/diphtheria</td><td align="center">83% (46)</td><td align="center">78% (46)</td><td align="center">74% (46)</td><td align="center">84% (43)</td><td align="center">88% (52)</td><td align="center">1.23 (0.90&#x02013;1.69)</td><td align="center">0.192</td></tr><tr><td align="left">&#x02003;Influenza vaccine</td><td align="center">77% (22)</td><td align="center">73% (26)</td><td align="center">71% (35)</td><td align="center">80% (25)</td><td align="center">84% (32)</td><td align="center">1.41 (0.94&#x02013;2.13)</td><td align="center">0.098</td></tr><tr><td align="left"><bold>Counselling</bold></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left">&#x02003;Physical activity</td><td align="center">28% (46)</td><td align="center">26% (46)</td><td align="center">56% (