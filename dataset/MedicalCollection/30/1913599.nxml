age>217</lpage><pub-id pub-id-type="pmid">10829870</pub-id></citation></ref><ref id="b14-ehp0115-001107"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dobson</surname><given-names>AW</given-names></name><name><surname>Erikson</surname><given-names>KM</given-names></name><name><surname>Aschner</surname><given-names>M</given-names></name></person-group><year>2004</year><article-title>Manganese neurotoxicity</article-title><source>Ann NY Acad Sci</source><volume>1012</volume><fpage>115</fpage><lpage>128</lpage><pub-id pub-id-type="pmid">15105259</pub-id></citation></ref><ref id="b15-ehp0115-001107"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dorman</surname><given-names>DC</given-names></name><name><surname>McElveen</surname><given-names>AM</given-names></name><name><surname>Marshall</surname><given-names>MW</given-names></name><name><surname>Parkinson</surname><given-names>CU</given-names></name><name><surname>James</surname><given-names>RA</given-names></name><name><surname>Struve</surname><given-names>MF</given-names></name><etal/></person-group><year>2005</year><article-title>Tissue manganese concentrations in lactating rats and their offspring following combined <italic>in utero</italic> and lactation exposure to inhaled manganese sulfate</article-title><source>Toxicol Sci</source><volume>84</volume><issue>1</issue><fpage>12</fpage><lpage>21</lpage><pub-id pub-id-type="pmid">15601677</pub-id></citation></ref><ref id="b16-ehp0115-001107"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dorman</surname><given-names>DC</given-names></name><name><surname>Struve</surname><given-names>MF</given-names></name><name><surname>Vitarella</surname><given-names>D</given-names></name><name><surname>Byerly</surname><given-names>FL</given-names></name><name><surname>Goetz</surname><given-names>J</given-names></name><name><surname>Miller</surname><given