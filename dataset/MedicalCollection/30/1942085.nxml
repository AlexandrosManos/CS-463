56</td><td align="left" rowspan="1" colspan="1">2.7</td><td align="left" rowspan="1" colspan="1">1.14E-04</td><td align="left" rowspan="1" colspan="1">1.7</td><td align="left" rowspan="1" colspan="1">2.10E-03</td><td align="left" rowspan="1" colspan="1">Unknown</td></tr><tr><td align="left" rowspan="1" colspan="1">Tmem51, transmembrane protein 51</td><td align="left" rowspan="1" colspan="1">BC003277</td><td align="left" rowspan="1" colspan="1">2.7</td><td align="left" rowspan="1" colspan="1">5.61E-03</td><td align="left" rowspan="1" colspan="1">2.1</td><td align="left" rowspan="1" colspan="1">3.87E-03</td><td align="left" rowspan="1" colspan="1">Unknown</td></tr><tr><td align="left" rowspan="1" colspan="1">Rab4a, RAB4A, member RAS oncogene family</td><td align="left" rowspan="1" colspan="1">NM_009003</td><td align="left" rowspan="1" colspan="1">2.6</td><td align="left" rowspan="1" colspan="1">1.41E-03</td><td align="left" rowspan="1" colspan="1">3.4</td><td align="left" rowspan="1" colspan="1">1.40E-04</td><td align="left" rowspan="1" colspan="1">Transport/Signal transduction</td></tr><tr><td align="left" rowspan="1" colspan="1">Anxa1, annexin A1</td><td align="left" rowspan="1" colspan="1">NM_010730</td><td align="left" rowspan="1" colspan="1">2.5</td><td align="left" rowspan="1" colspan="1">3.65E-03</td><td align="left" rowspan="1" colspan="1">2.4</td><td align="left" rowspan="1" colspan="1">4.42E-03</td><td align="left" rowspan="1" colspan="1">Cell cycle/Cell proliferation/Signal transduction</td></tr><tr><td align="left" rowspan="1" colspan="1">Pscdbp, pleckstrin homology, Sec7 and coiled-coil domains, binding protein</td><td align="left" rowspan="1" colspan="1">BC007144</td><td align="left" rowspan="1" colspan="1">2.4</td><td align="left" rowspan="1" colspan="1">3.04E-03</td><td align="left" rowspan="1" colspan="1">1.6</td><td align="left" rowspan="1" colspan="1">4.34E-02</td><td align="left" rowspan="1" colspan="1">Cell adhesion</td></tr><tr><td align="left" r