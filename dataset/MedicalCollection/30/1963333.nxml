ub-id-type="pmid">14733478</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ribeiro</surname><given-names>NM</given-names></name><name><surname>Ribeiro</surname><given-names>MA</given-names></name></person-group><article-title>Breastfeeding and early childhood caries: a critical review</article-title><source>J Pediatr (Rio J)</source><year>2004</year><volume>80</volume><fpage>S199</fpage><lpage>210</lpage><pub-id pub-id-type="pmid">15583771</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Quinonez</surname><given-names>RB</given-names></name><name><surname>Keels</surname><given-names>MA</given-names></name><name><surname>Vann</surname><given-names>WF</given-names></name><name><surname>McIver</surname><given-names>FT</given-names></name><name><surname>Heller</surname><given-names>K</given-names></name><name><surname>Whitt</surname><given-names>JK</given-names></name></person-group><article-title>Early childhood caries: analysis of psychosocial and biological factors in a high-risk population</article-title><source>Caries Res</source><year>2001</year><volume>35</volume><fpage>376</fpage><lpage>383</lpage><pub-id pub-id-type="pmid">11641574</pub-id><pub-id pub-id-type="doi">10.1159/000047477</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schroth</surname><given-names>RJ</given-names></name><name><surname>Smith</surname><given-names>PJ</given-names></name><name><surname>Whalen</surname><given-names>JC</given-names></name><name><surname>Lekic</surname><given-names>C</given-names></name><name><surname>Moffatt</surname><given-names>ME</given-names></name></person-group><article-title>Prevalence of caries among preschool-aged children in a northern Manitoba community</article-title><source>J Can Dent Assoc</source><year>2005</year><volume>