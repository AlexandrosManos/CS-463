 align="center">-</td><td align="center">-</td><td align="center">+</td><td align="center">-</td><td align="center">-</td><td align="center">-</td><td align="center">-</td><td align="center">-</td><td align="center">-</td><td align="center">-</td><td align="center">+</td><td align="center">+</td><td align="center">-</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td></tr><tr><td align="center">China</td><td align="center">Zhenshan97</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">-</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">-</td><td align="center">+</td><td align="center">-</td><td align="center">-</td><td align="center">-</td><td align="center">+</td><td align="center">-</td><td align="center">-</td><td align="center">-</td><td align="center">-</td><td align="center">+</td><td align="center">-</td><td align="center">-</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td><td align="center">+</td></tr><tr><td align="center">China</td><td align="center">Yunjing</td><td align="center">-</td><td align="center">-</td><td align="center">+</td><td align="center">-</td><td align="center">-</td><td align="center">+</td><td align="center">-</td><td align="center">-</td><td align="center">-</td><td align="c