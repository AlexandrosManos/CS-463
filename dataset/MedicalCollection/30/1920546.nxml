citation></ref><ref id="b27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hadfield</surname><given-names>MG</given-names></name></person-group><article-title>The decimation of endemic Hawaiian tree snails by alien predators</article-title><source>Am. Zool.</source><year>1993</year><volume>33</volume><fpage>610</fpage><lpage>622</lpage></citation></ref><ref id="b28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Holland</surname><given-names>BH</given-names></name></person-group><article-title>Origin and diversification of the endemic Hawaiian tree snails (Achatinellidae: Achatinellinae) based on molecular evidence</article-title><source>Mol. Phylogenet. Evol.</source><year>2004</year><volume>32</volume><fpage>588</fpage><lpage>600</lpage><pub-id pub-id-type="pmid">15223040</pub-id></citation></ref><ref id="b29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hori</surname><given-names>M</given-names></name></person-group><article-title>Frequency-dependent natural-selection in the handedness of scale-eating cichlid fish</article-title><source>Science</source><year>1993</year><volume>260</volume><fpage>216</fpage><lpage>219</lpage><pub-id pub-id-type="pmid">17807183</pub-id></citation></ref><ref id="b30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hoso</surname><given-names>M</given-names></name></person-group><article-title>Identification of molluscan prey from feces of Iwasaki's slug snake, <italic>Pareas iwasakii</italic></article-title><source>Herpet. Rev.</source><year>2006</year><volume>37</volume><fpage>174</fpage><lpage>176</lpage></citation></ref><ref id="b31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hozumi</surname><given-names>S</given-names></name></person-group><article-title>An unconventional myosin in <italic>Drosophila</italic> reverses the default handedness in visceral organs</article-title><source>Nature</source><year>2006</year><volume>440</volume><fpage>798</fpage><lpage>802</lpage><pub-id pub-id-type="pmid">16598258</pub-id></citation></ref><ref id="b32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Inoda</surname><given-names>T</given-names></name></person-group><article-title>Asymmetric mandibles of water-scavenger larvae improve feeding effectiveness on right-handed snails</article-title><source>Am. Nat.</source><year>2003</year><volume>162</volume><fpage>811</fpage><lpage>814</lpage><pub-id pub-id-type="pmid">14737717</pub-id></citation></ref><ref id="b33"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnson</surname><given-names>MS</given-names></name></person-group><article-title>Polymorphism for direction of coil in <italic>Partula suturalis</italic>: behavioural isolation and positive frequency dependent selection</article-title><source>Heredity</source><year>1982</year><volume>49</volume><fpage>145</fpage><lpage>151</lpage></citation></ref><ref id="b34"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnson</surname><given-names>MS</given-names></name></person-group><article-title>Adaptation and rules of form: chirality and shape in <italic>Partula suturalis</italic></article-title><source>Evolution</source><year>1987</year><volume>41</volume><fpage>672</fpage><lpage>675</lpage></citation></ref><ref id="b35"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnson</surname><given-names>MS</given-names></name></person-group><article-title>Independence of genetic subdivision and variation for coil in <italic>Partula suturalis</italic></article-title><source>Heredity</source><year>1987</year><volume>58</volume><fpage>307</fpage><lpage>313</lpage></citation></ref><ref id="b36"><citation citation-type="journal"><