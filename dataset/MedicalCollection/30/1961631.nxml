-title><source>Crit Care Med</source><volume>24</volume><fpage>S3</fpage><lpage>S11</lpage><pub-id pub-id-type="pmid">8608705</pub-id></citation></ref><ref id="pmed-0040234-b009"><citation citation-type="journal"><person-group><name><surname>Sheridan</surname><given-names>RL</given-names></name></person-group><year>2003</year><article-title>Burn care: Results of technical and organizational progress</article-title><source>JAMA</source><volume>290</volume><fpage>719</fpage><lpage>722</lpage><pub-id pub-id-type="pmid">12915409</pub-id></citation></ref><ref id="pmed-0040234-b010"><citation citation-type="journal"><person-group><name><surname>Atiyeh</surname><given-names>BS</given-names></name><name><surname>Hayek</surname><given-names>SN</given-names></name><name><surname>Gunn</surname><given-names>SW</given-names></name></person-group><year>2005</year><article-title>New technologies for burn wound closure and healing&#x02014;Review of the literature</article-title><source>Burns</source><volume>31</volume><fpage>944</fpage><lpage>956</lpage><pub-id pub-id-type="pmid">16274932</pub-id></citation></ref><ref id="pmed-0040234-b011"><citation citation-type="journal"><person-group><name><surname>Sheridan</surname><given-names>RL</given-names></name><name><surname>Tompkins</surname><given-names>RG</given-names></name></person-group><year>2004</year><article-title>What's new in burns and metabolism</article-title><source>J Am Coll Surg</source><volume>198</volume><fpage>243</fpage><lpage>263</lpage><pub-id pub-id-type="pmid">14759783</pub-id></citation></ref><ref id="pmed-0040234-b012"><citation citation-type="journal"><person-group><name><surname>van Zuijlen</surname><given-names>PP</given-names></name><name><surname>Vloemans</surname><given-names>JF</given-names></name><name><surname>van Trier</surname><given-names>AJ</given-names></name><name><surname>Suijker</surname><given-names>MH</given-names></name><name><surname>van Unen</surname><given-names>E</given-names></name><et