><surname>Agelan</surname><given-names>A</given-names></name><name><surname>Ntaoula</surname><given-names>N</given-names></name><name><surname>Purev</surname><given-names>E</given-names></name><name><surname>Li</surname><given-names>LP</given-names></name><name><surname>Kratsios</surname><given-names>P</given-names></name><name><surname>Mylonas</surname><given-names>E</given-names></name><name><surname>Jung</surname><given-names>WJ</given-names></name><name><surname>Evans</surname><given-names>K</given-names></name><name><surname>Roberts</surname><given-names>S</given-names></name><name><surname>Lu</surname><given-names>Y</given-names></name><name><surname>Layvi</surname><given-names>R</given-names></name><name><surname>Lin</surname><given-names>WL</given-names></name><name><surname>Zhang</surname><given-names>X</given-names></name><name><surname>Gaughan</surname><given-names>J</given-names></name><name><surname>Monos</surname><given-names>DS</given-names></name><name><surname>Oleszak</surname><given-names>EL</given-names></name><name><surname>White</surname><given-names>JV</given-names></name></person-group><article-title>Abdominal aortic aneurysm is a specific antigen-driven T cell disease</article-title><source>Ann N Y Acad Sci</source><year>2006</year><volume>1085</volume><fpage>224</fpage><lpage>235</lpage><pub-id pub-id-type="pmid">17182939</pub-id><pub-id pub-id-type="doi">10.1196/annals.1383.019</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Duftner</surname><given-names>C</given-names></name><name><surname>Seiler</surname><given-names>R</given-names></name><name><surname>Dejaco</surname><given-names>C</given-names></name><name><surname>Fraedrich</surname><given-names>G</given-names></name><name><surname>Schirmer</surname><given-names>M</given-names></name></person-group><article-title>Increasing evidence for immune-mediated processes and new therapeutic approaches in abdominal aortic aneurysms--a review</article-title><source>Ann N Y Acad Sci</source><year>2006</year><volume>1085</volume><fpage>331</fpage><lpage>338</lpage><pub-id pub-id-type="pmid">17182953</pub-id><pub-id pub-id-type="doi">10.1196/annals.1383.036</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kuivaniemi</surname><given-names>H</given-names></name><name><surname>Platsoucas</surname><given-names>CD</given-names></name><name><surname>Tilson</surname><given-names>MD</given-names></name></person-group><article-title>Aortic Aneurysms: an Immune Disease with a Strong Genetic Component</article-title><source>Circulation</source><year>2007</year><volume>(in press)</volume></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schirmer</surname><given-names>M</given-names></name><name><surname>Duftner</surname><given-names>C</given-names></name><name><surname>Seiler</surname><given-names>R</given-names></name><name><surname>Dejaco</surname><given-names>C</given-names></name><name><surname>Fraedrich</surname><given-names>G</given-names></name></person-group><article-title>Abdominal aortic aneurysms: an underestimated type of immune-mediated large vessel arteritis?</article-title><source>Curr Opin Rheumatol</source><year>2006</year><volume>18</volume><fpage>48</fpage><lpage>53</lpage><pub-id pub-id-type="pmid">16344619</pub-id><pub-id pub-id-type="doi">10.1097/01.bor.0000198001.35203.36</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Daugherty</surname><given-names>A</given-names></name><name><surname>Cassis</surname><given-names>LA</given-names></name></person-group><article-title>Mouse models of abdominal aortic aneurysms</article-title><source>Arterioscler Thromb Vasc Biol</source><year>2004</year><volume>24</volume><fpage>429</fpage><lpage>434</lpage><