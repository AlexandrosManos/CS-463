<surname>Berger</surname><given-names>W</given-names></name></person-group><article-title>Visual kinesthesia and locomotion in Parkinson's disease</article-title><source>Mov Disord</source><year>2005</year><volume>20</volume><fpage>141</fpage><lpage>150</lpage><pub-id pub-id-type="pmid">15390031</pub-id><pub-id pub-id-type="doi">10.1002/mds.20281</pub-id></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Barbeau</surname><given-names>H</given-names></name><name><surname>Lamontagne</surname><given-names>A</given-names></name><name><surname>Ladouceur</surname><given-names>M</given-names></name><name><surname>Mercier</surname><given-names>I</given-names></name><name><surname>Fung</surname><given-names>J</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Latash M, Levin MF</surname></name></person-group><article-title>Optimizing locomotor function with body weight support training and functional electrical stimulation</article-title><source>Progress in Motor Control III</source><year>2003</year><publisher-name> Human Kinetics</publisher-name><fpage>237</fpage><lpage>251</lpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>von Schroeder</surname><given-names>HP</given-names></name><name><surname>Coutts</surname><given-names>RD</given-names></name><name><surname>Lyden</surname><given-names>PD</given-names></name><name><surname>Billings</surname><given-names>E</given-names><suffix>Jr.</suffix></name><name><surname>Nickel</surname><given-names>VL</given-names></name></person-group><article-title>Gait parameters following stroke: a practical assessment</article-title><source>J Rehabil Res Dev</source><year>1995</year><volume>32</volume><fpage>25</fpage><lpage>31</lpage><pub-id pub-id-type="pmid">7760264</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-