rson-group-type="author"><name><surname>Glanz</surname><given-names>K</given-names></name><name><surname>Marcus Lewis</surname><given-names>F</given-names></name><name><surname>Rimer</surname><given-names>BK</given-names></name></person-group><source>Theory at a Glance: A guide for health promotion practice</source><year>2005</year><edition>second</edition><publisher-name> National Cancer Institute, National Institute of Health </publisher-name></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Janz</surname><given-names>NK</given-names></name><name><surname>Becker</surname><given-names>MH</given-names></name></person-group><article-title>The Health Belief Model: a decade later</article-title><source>Health Educ Q</source><year>1984</year><volume>11</volume><fpage>1</fpage><lpage>47</lpage><pub-id pub-id-type="pmid">6392204</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Athar</surname><given-names>MN</given-names></name><name><surname>Khalid</surname><given-names>MA</given-names></name><name><surname>Ahmad</surname><given-names>AM</given-names></name><name><surname>Bashir</surname><given-names>N</given-names></name><name><surname>Baqai</surname><given-names>HZ</given-names></name><name><surname>Ahmad</surname><given-names>M</given-names></name><name><surname>Balouch</surname><given-names>AH</given-names></name><name><surname>Bashir</surname><given-names>K</given-names></name></person-group><article-title>Crimean-Congo hemorrhagic fever outbreak in Rawalpindi, Pakistan, February 2002: contact tracing and risk assessment</article-title><source>Am J Trop Med Hyg</source><year>2005</year><volume>72</volume><fpage>471</fpage><lpage>473</lpage><pub-id pub-id-type="pmid">15827289</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rana</surname><gi