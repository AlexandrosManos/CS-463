<lpage>406</lpage><pub-id pub-id-type="pmid">11403560</pub-id></citation></ref><ref id="pcbi-0030154-b012"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smolen</surname><given-names>P</given-names></name><name><surname>Baxter</surname><given-names>DA</given-names></name><name><surname>Byrne</surname><given-names>JH</given-names></name></person-group><year>2001</year><article-title>Modeling circadian oscillations with interlocking positive and negative feedback loops</article-title><source>J Neurosci</source><volume>21</volume><fpage>6644</fpage><lpage>6656</lpage><pub-id pub-id-type="pmid">11517254</pub-id></citation></ref><ref id="pcbi-0030154-b013"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Scheper</surname><given-names>T</given-names></name><name><surname>Klinkenberg</surname><given-names>D</given-names></name><name><surname>Pennartz</surname><given-names>C</given-names></name><name><surname>van Pelt</surname><given-names>J</given-names></name></person-group><year>1999</year><article-title>A mathematical model for the intracellular circadian rhythm generator</article-title><source>J Neurosci</source><volume>19</volume><fpage>40</fpage><lpage>47</lpage><pub-id pub-id-type="pmid">9870936</pub-id></citation></ref><ref id="pcbi-0030154-b014"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smolen</surname><given-names>P</given-names></name><name><surname>Hardin</surname><given-names>PE</given-names></name><name><surname>Lo</surname><given-names>BS</given-names></name><name><surname>Baxter</surname><given-names>DA</given-names></name><name><surname>Byrne</surname><given-names>JH</given-names></name></person-group><year>2004</year><article-title>Simulation of <italic>Drosophila</italic> circadian oscillations, mutations, and light responses by a model with VRI, PDP-1, and CLK</article-title><source>Biophys J</source><volume>86</volume><fpa