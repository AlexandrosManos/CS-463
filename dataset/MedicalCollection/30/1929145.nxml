><given-names>AJ</given-names></name></person-group><article-title>Isolation and characterization of mouse minisatellites.</article-title><source>Genomics</source><year>1998</year><volume>50</volume><fpage>317</fpage><lpage>330</lpage><pub-id pub-id-type="pmid">9676426</pub-id><pub-id pub-id-type="doi">10.1006/geno.1998.5329</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bois</surname><given-names>PR</given-names></name><name><surname>Grant</surname><given-names>GR</given-names></name><name><surname>Jeffreys</surname><given-names>AJ</given-names></name></person-group><article-title>Minisatellites show rare and simple intra-allelic instability in the mouse germ line.</article-title><source>Genomics</source><year>2002</year><volume>80</volume><fpage>2</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">12079275</pub-id><pub-id pub-id-type="doi">10.1006/geno.2002.6791</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jeffreys</surname><given-names>AJ</given-names></name><name><surname>Neumann</surname><given-names>R</given-names></name></person-group><article-title>Somatic mutation processes at a human minisatellite.</article-title><source>Hum Mol Genet</source><year>1997</year><volume>6</volume><fpage>129</fpage><lpage>136</lpage><pub-id pub-id-type="pmid">9002681</pub-id><pub-id pub-id-type="doi">10.1093/hmg/6.1.129</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>B&#x000e9;rard</surname><given-names>S</given-names></name><name><surname>Rivals</surname><given-names>E</given-names></name></person-group><article-title>Comparison of minisatellites.</article-title><source>J Comput Biol</source><year>2003</year><volume>10</volume><fpage>357</fpage><lpage>372</lpage><pub-id pub-id-type="pmid">12935333</pub-id><pub-id pub-id-type="doi">10.108