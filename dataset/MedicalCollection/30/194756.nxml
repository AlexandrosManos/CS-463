tion></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Baily</surname><given-names>CJ</given-names></name><name><surname>Flatt</surname><given-names>PR</given-names></name></person-group><article-title>Antidiabetic drugs, new developments</article-title><source>Ind Biotech</source><year>1986</year><volume>6</volume><fpage>139</fpage><lpage>42</lpage></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lazarow</surname><given-names>A</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Lazarow A</surname></name></person-group><article-title>Alloxan diabetes and mechanism of &#x003b2;-cell damage by chemical agents</article-title><source>Experimental Diabetes</source><year>1964</year><publisher-name>Oxford, Blackwell Scientific Publication</publisher-name><fpage>49</fpage><lpage>69</lpage></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rerup</surname><given-names>CC</given-names></name></person-group><article-title>Drugs producing diabetes through damage of insulin secreting cells</article-title><source>Pharmacol Rev</source><year>1970</year><volume>22</volume><fpage>485</fpage><lpage>520</lpage><pub-id pub-id-type="pmid">4921840</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Colca</surname><given-names>JR</given-names></name><name><surname>Kotagel</surname><given-names>N</given-names></name><name><surname>Brooks</surname><given-names>CL</given-names></name><name><surname>Lacy</surname><given-names>PE</given-names></name><name><surname>Landt</surname><given-names>M</given-names></name><name><surname>McDanield</surname><given-names>ML</given-names></name></person-group><article-title>Alloxan inhibition of Ca <sup>2+ </sup>and calmodulin-dependent protein ki