 Hum Genet</source><volume>79</volume><fpage>469</fpage><lpage>480</lpage><pub-id pub-id-type="pmid">16909385</pub-id></citation></ref><ref id="pone.0000681-Durham1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Durham</surname><given-names>SE</given-names></name><name><surname>Samuels</surname><given-names>DC</given-names></name><name><surname>Chinnery</surname><given-names>PF</given-names></name></person-group><year>2006</year><article-title>Is selection required for the accumulation of somatic mitochondrial DNA mutations in post-mitotic cells?</article-title><source>Neuromuscul Disord</source><volume>16</volume><fpage>381</fpage><lpage>386</lpage><pub-id pub-id-type="pmid">16684599</pub-id></citation></ref><ref id="pone.0000681-Nekhaeva1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nekhaeva</surname><given-names>E</given-names></name><name><surname>Bodyak</surname><given-names>ND</given-names></name><name><surname>Kraytsberg</surname><given-names>Y</given-names></name><name><surname>McGrath</surname><given-names>SB</given-names></name><name><surname>Van Orsouw</surname><given-names>NJ</given-names></name><etal/></person-group><year>2002</year><article-title>Clonally expanded mtDNA point mutations are abundant in individual cells of human tissues.</article-title><source>Proc Natl Acad Sci U S A</source><volume>99</volume><fpage>5521</fpage><lpage>5526</lpage><pub-id pub-id-type="pmid">11943860</pub-id></citation></ref><ref id="pone.0000681-Ogasawara1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ogasawara</surname><given-names>Y</given-names></name><name><surname>Nakayama</surname><given-names>K</given-names></name><name><surname>Tarnowka</surname><given-names>M</given-names></name><name><surname>McCoy</surname><given-names>JP</given-names><suffix>Jr</suffix></name><name><surname>K