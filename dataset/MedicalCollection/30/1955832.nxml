rname><given-names>T</given-names></name><name><surname>Felgar</surname><given-names>RE</given-names></name><name><surname>Wei</surname><given-names>C</given-names></name><name><surname>Brown</surname><given-names>M</given-names></name><etal/></person-group><year>2007</year><article-title>CpG DNA activation and plasma-cell differentiation of CD27- naive human B cells.</article-title><source>Blood</source><volume>109</volume><fpage>1611</fpage><lpage>1619</lpage><pub-id pub-id-type="pmid">17032927</pub-id></citation></ref><ref id="pone.0000863-Mansson1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mansson</surname><given-names>A</given-names></name><name><surname>Adner</surname><given-names>M</given-names></name><name><surname>Hockerfelt</surname><given-names>U</given-names></name><name><surname>Cardell</surname><given-names>LO</given-names></name></person-group><year>2006</year><article-title>A distinct Toll-like receptor repertoire in human tonsillar B cells, directly activated by PamCSK, R-837 and CpG-2006 stimulation.</article-title><source>Immunology</source><volume>118</volume><fpage>539</fpage><lpage>548</lpage><pub-id pub-id-type="pmid">16780564</pub-id></citation></ref><ref id="pone.0000863-Martin1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martin</surname><given-names>F</given-names></name><name><surname>Kearney</surname><given-names>JF</given-names></name></person-group><year>2002</year><article-title>Marginal-zone B cells.</article-title><source>Nat Rev Immunol</source><volume>2</volume><fpage>323</fpage><lpage>335</lpage><pub-id pub-id-type="pmid">12033738</pub-id></citation></ref><ref id="pone.0000863-Oliver1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oliver</surname><given-names>AM</given-names></name><name><surname>Martin</surname><given-names>F</given-names></name><name><surname>Gartland</surname><given-names>GL</given-names></name><name><surname>Carter</surname><given-names>RH</given-names></name><name><surname>Kearney</surname><given-names>JF</given-names></name></person-group><year>1997</year><article-title>Marginal zone B cells exhibit unique activation, proliferative and immunoglobulin secretory responses.</article-title><source>Eur J Immunol</source><volume>27</volume><fpage>2366</fpage><lpage>2374</lpage><pub-id pub-id-type="pmid">9341782</pub-id></citation></ref><ref id="pone.0000863-Kiyono1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kiyono</surname><given-names>H</given-names></name><name><surname>Fukuyama</surname><given-names>S</given-names></name></person-group><year>2004</year><article-title>NALT- versus Peyer's-patch-mediated mucosal immunity.</article-title><source>Nat Rev Immunol</source><volume>4</volume><fpage>699</fpage><lpage>710</lpage><pub-id pub-id-type="pmid">15343369</pub-id></citation></ref><ref id="pone.0000863-Berland1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berland</surname><given-names>R</given-names></name><name><surname>Wortis</surname><given-names>HH</given-names></name></person-group><year>2002</year><article-title>Origins and functions of B-1 cells with notes on the role of CD5.</article-title><source>Annu Rev Immunol</source><volume>20</volume><fpage>253</fpage><lpage>300</lpage><pub-id pub-id-type="pmid">11861604</pub-id></citation></ref><ref id="pone.0000863-Chappell1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chappell</surname><given-names>CP</given-names></name><name><surname>Jacob</surname><given-names>J</given-names></name></person-group><year>2006</year><article-title>Identification of memory B cells using a novel transgenic mouse model.</article-title><source>J Immunol</source><volume>