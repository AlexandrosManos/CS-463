n-group-type="author"><name><surname>Wu</surname><given-names>B</given-names></name><name><surname>Abbott</surname><given-names>T</given-names></name><name><surname>Fishman</surname><given-names>D</given-names></name><name><surname>McMurray</surname><given-names>W</given-names></name><name><surname>Mor</surname><given-names>G</given-names></name><name><surname>Stone</surname><given-names>K</given-names></name><name><surname>Ward</surname><given-names>D</given-names></name><name><surname>Williams</surname><given-names>K</given-names></name><name><surname>Zhao</surname><given-names>H</given-names></name></person-group><article-title>Comparison of statistical methods for classification of ovarian cancer using mass spectrometry data</article-title><source>Bioinformatics</source><year>2003</year><volume>19</volume><fpage>1636</fpage><lpage>1643</lpage><pub-id pub-id-type="pmid">12967959</pub-id><pub-id pub-id-type="doi">10.1093/bioinformatics/btg210</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yu</surname><given-names>JS</given-names></name><name><surname>Ongarello</surname><given-names>S</given-names></name><name><surname>Fiedler</surname><given-names>R</given-names></name><name><surname>Chen</surname><given-names>XW</given-names></name><name><surname>Toffolo</surname><given-names>G</given-names></name><name><surname>Cobelli</surname><given-names>C</given-names></name><name><surname>Trajanoski</surname><given-names>Z</given-names></name></person-group><article-title>Ovarian cancer identification based on dimensionality reduction for high-throughput mass spectrometry data</article-title><source>Bioinformatics</source><year>2005</year><volume>21</volume><fpage>2200</fpage><lpage>2209</lpage><pub-id pub-id-type="pmid">15784749</pub-id><pub-id pub-id-type="doi">10.1093/bioinformatics/bti370</pub-id></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Speed</surname><given-names>T</given-names></name></person-group><source>Statistical Analysis of Gene Expression Microarray Data</source><year>2003</year><publisher-name>Chapman &#x00026; Hall/CRC</publisher-name></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Jones</surname><given-names>GA</given-names></name><name><surname>Jones</surname><given-names>JM</given-names></name></person-group><source>Information and Coding Theory</source><year>2000</year><publisher-name>Springer Verlag</publisher-name></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Breiman</surname><given-names>L</given-names></name></person-group><article-title>Random Forests</article-title><source>Machine Learning</source><year>2001</year><volume>45</volume><fpage>123</fpage><lpage>140</lpage><pub-id pub-id-type="doi">10.1023/A:1010950718922</pub-id></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Dwork</surname><given-names>C</given-names></name><name><surname>Kumar</surname><given-names>R</given-names></name><name><surname>Naor</surname><given-names>M</given-names></name><name><surname>Sivakumar</surname><given-names>D</given-names></name></person-group><article-title>Rank aggregation methods for the Web</article-title><source>Proceedings of the 10th international conference on World Wide Web Hong Kong</source><year>2001</year><publisher-name>Elsevier Science</publisher-name><fpage>613</fpage><lpage>622</lpage></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gambin</surname><given-names>A</given-names></name><name><surname>Dutkowski</surname><given-names>J</given-names></name><name><surname>Karczmarski</surname><given-names>J</given-names></name><name><surname>Kluge</surname><given-names>B</given-names></name><name><surname>Kowalczyk</surname><given-names>K</given-names></name><name><surname>Ostrowski</surname><given-names>J</given-names></name><name><surname>Pozna&#x00144;ski</surname><given-names>J</given-names></name><name><surname>Tiuryn</surname><given-names>J</given-names></name><name><surname>Bakun</surname><given-names>M</given-names></name><name><surname>Dadlez</surname><given-names>M</given-names></name></person-group><article-title>Automated reduction and interpretation of multidimensional mass spectra for analysis of complex peptide mixtures</article-title><source>International Journal of Mass Spectrometry</source><year>2007</year><volume>260</volume><fpage>20</fpage><lpage>30</lpage><pub-id pub-id-type="doi">10.1016/j.ijms.2006.06.011</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>CA</given-names></name><name><surname>Want</surname><given-names>EJ</given-names></name><name><surname>O'Maille</surname><given-names>G</given-names></name><name><surname>Abagyan</surname><given-names>R</given-names></name><name><surname>Siuzdak</surname><given-names>G</given-names></name></person-group><article-title>XCMS: Processing mass spectrometry data for metabolite profiling using nonlinear peak alignment, matching and identification</article-title><source>Analytical Chemistry</source><year>2006</year><volume>78</volume><fpage>779</fpage><lpage>787</lpage><pub-id pub-id-type="pmid">16448051</pub-id><pub-id pub-id-type="doi">10.1021/ac051437y</pub-id></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Luksza</surname><given-names>M</given-names></name><name><surname>Kluge</surname><given-names>B</given-names></name><name><surname>Ostrowski</surname><given-names>J</given-names></name><name><surname>Karczmarski</surname><given-names>J</given-names></name><name><surname>Gambin</surname><given-names>A</given-names></name></person-group><article-title>Effcient Model-Based Clustering for LC-MS Data</article-title><source>Proceedings of the 6th Workshop on Algorithms in Bioinformatics 2006, LNBI</source><year>2006</year><publisher-name>Springer-Verlag</publisher-name><fpage>613</fpage><lpage>622</lpage></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pokarowski</surname><given-names>P</given-names></name></person-group><article-title>Directed forests with applications to algorithms related to Markov chains</article-title><source>Applicationes Mathematicae</source><year>1999</year><volume>26</volume><fpage>395</fpage><lpage>414</lpage></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grassmann</surname><given-names>WK</given-names></name><name><surname>Taksar</surname><given-names>MI</given-names></name><name><surname>Heyman</surname><given-names>DP</given-names></name></person-group><article-title>Regenerative analysis and steady state distributions for Markov chains</article-title><source>Operations Research</source><year>1985</year><volume>33</volume><fpage>1107</fpage><lpage>1116</lpage></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gambin</surname><given-names>A</given-names></name><name><surname>Pokarowski</surname><given-names>P</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Freivalds R</surname></name></person-group><article-title>A combinatorial aggregation algorithm for stationary distribution of a large Markov chain</article-title><source>Proceedings of the 13th International Symposium on Fundamentals of Computation Theory 2001, Riga, Latvia, LNCS 2138</source><year>2001</year><publisher-name>Springer</publisher-name><fpage>384</fpage><lpage>388</lpage></citation></ref><ref id="B20"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Gambin</surname><given-names>A</given-names></name><name><surname>Pokarowski</surname><given-names>P</given-names></name></person-group><article-title>Aggregation Algorithms for Markov Chains with Large State Space</article-title><ext-link ext-link-type="uri" xlink:href="http://bioputer.mimuw.edu.pl/papers/aggr.pdf"/></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Jolliffe</surname><given-names>IT</given-names></name></person-group><source>Principal component analysis</source><year>1986</year><publisher-name>Springer Verlag</publisher-name></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hastie</surname><given-names>T</given-names></name><name><surname>Tibshirani</surname><given-names>R</given-names></name><name><surname>Friedman</surname><given-names>JH</given-names></name></person-group><source>The Elements of Statistical Learning</source><year>2001</year><publisher-name>Springer Verlag</publisher-name></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Venables</surname><given-names>WN</given-names></name><name><surname>Ripley</surname><given-names>BD</given-names></name></person-group><source>Modern Applied Statistics with S</source><year>2002</year><edition>Forth</edition><publisher-name>Springer Verlag</publisher-name></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Vapnik</surname><given-names>V</given-names></name></person-group><source>Statistical Learning Theory</source><year>1998</year><publisher-name>New York: Wiley-Interscience</publisher-name></citation></ref><ref id="B25"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Scholkopf</surname><given-names>B</given-names></name><name><surname>Smola</surname><given-names>AJ</given-names></name></person-group><source>Learning with Kernels</source><year>2002</year><publisher-name>Cambridge, MA: MIT Press</publisher-name></citation></ref></ref-list><sec sec-type="display-objects"><title>Figures and Tables</title><fig position="float" id="F1"><label>Figure 1</label><caption><p><bold>Biomarker comparison</bold>. Best 10 peaks (i.e. peptide signals) from the <italic>Ovarian cancer </italic>dataset selected using PPC (left) and t-statistics (right). Each small panel shows a histogram of peak heights in the training set at one <italic>m</italic>/<italic>z </italic>value for healthy patients (top) and cancer patients (bottom). Vertical line corresponds to the estimated optimal height split point (see [7] for details). The proportions of samples in each class having peaks higher than the split point are indicated (e.g. for top left corner panel these proportions are respectively 0.13 and 0.68). Notice that the two selected sets have only 3 peaks in common.</p></caption><graphic xlink:href="1471-2105-8-S5-S5-1"/></fig><fig position="float" id="F2"><label>Figure 2</label><caption><p><bold>Prostate cancer classification results</bold>. Classification results for four classifiers (random forest (RF), SVM, decision trees (DT) and LDA) on the SELDI-TOF prostate cancer dataset are shown separately in the four panels. Classifier performance using a specified number of best features from individual scoring functions (peak probability contrast (PPC), mutual information (MI), t-statistic (TT) and random forest feature ranking (RF)) are plotted in black. Performance with features selected by MC<sub>4 </sub>rank aggregation of the four functions is shown in blue. Results for regular PCA and our modified "Consensus" version using only the best features from the four scoring functions are plotted in green and red respectively. For all methods the average accuracy (fraction of samples correctly classified) over 20 cross-validation runs is shown. See Section Results for discussion.</p></caption><graphic xlink:href="1471-2105-8-S5-S5-2"/></fig><fig position="float" id="F3"><label>Figure 3</label><caption><p><bold>Ovarian cancer classification results</bold>. Classification results for four classifiers (random forest (RF), SVM, decision trees (DT) and LDA) on the MALDI-TOF ovarian cancer dataset are shown separately in the four panels. Classifier performance using a specified number of best features from individual scoring functions (peak probability contrast (PPC), mutual information (MI), t-statistic (TT) and random forest feature ranking (RF)) are plotted in black. Performance with features selected by MC<sub>1 </sub>rank aggregation of the four functions is shown in blue. Results for regular PCA and our modified "Consensus" version using only the best features from the four scoring functions are plotted in green and red respectively. For all methods the average accuracy (fraction of samples correctly classified) over 20 cross-validation runs is shown. See Section Results for discussion.</p></caption><graphic xlink:href="1471-2105-8-S5-S5-3"/></fig><fig position="float" id="F4"><label>Figure 4</label><caption><p><bold>Method overview</bold>. The control flow through different phases of the proposed method: we start with a preprocessed MS dataset; apply several competing biomarker selection procedures (t-statistic, peak probability contrasts (PPC), mutual information and random forest feature ranking); achieve their consensus by the Markov chain rank aggregation method or PCA and train the classifiers (LDA, random forest, SVM, decision trees) on consensus features. For performance assessment the steps are repeated for each fold of the ten-fold cross-validation scheme.</p></caption><graphic xlink:href="1471-2105-8-S5-S5-4"/></fig><fig position="float" id="F5"><label>Figure 5</label><caption><p><bold>Prostate cancer data ranking comparison</bold>. Rankings obtained from several feature selection methods for the <italic>Prostate cancer </italic>dataset. Each small panel shows the comparison of two rankings. A point with coordinates (<italic>i</italic>, <italic>j</italic>) corresponds to the feature with score <italic>i </italic>in one method and score <italic>j </italic>in the other (for all methods the most important features receive the highest scores). Values of the Spearman correlation coefficient for each pair of scoring functions are given in the panels above the diagonal. The random forest feature ranking (RF) is considerably different than the rest. Peak probability contrast method (PPC), mutual information (MI) and t-statistic (TT) share a common group of the highest scored features, but significant differences can be observed in ranks of less important features, which also provide valuable information for classification.</p></caption><graphic xlink:href="1471-2105-8-S5-S5-5"/></fig><fig position="float" id="F6"><label>Figure 6</label><caption><p><bold>Ovarian cancer data ranking comparison</bold>. Comparison of rankings obtained from several feature selection methods for the <italic>Ovarian cancer </italic>dataset. Each small panel shows the comparison of two rankings. A point with coordinates (<italic>i</italic>, <italic>j</italic>) corresponds to the feature with score <italic>i </italic>in one method and score <italic>j </italic>in the other (for each method the most important features receive the highest scores). Values of the Spearman correlation coefficient for each pair of scoring functions are given in the panels above the diagonal. Notice significant differences between various rankings even within the group of the highest scored features. RF ranking stands out the most as in the case of prostate cancer data.</p></caption><graphic xlink:href="1471-2105-8-S5-S5-6"/></fig><fig position="float" id="F7"><label>Figure 7</label><caption><p><bold>Markov chain hierarchical structure</bold>. The structure of the state space graph for rank aggregation Markov chain MC<sub>1</sub>. The type of edge corresponds to the transition probability. Ellipses surround the top ranked features appearing in each phase (from 1 up to 3 in this example). States joined at an earlier stage have higher stationary probability, and therefore rank higher in the aggregated ranking.</p></caption><graphic xlink:href="1471-2105-8-S5-S5-7"/></fig><table-wrap position="float" id="T1"><label>Table 1</label><caption><p>Markov chain grouping comparison.</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="center">MC</td><td align="center"># stages</td><td align="center">groups sizes</td><td align="center">time (in sec)</td></tr></thead><tbody><tr><td align="center">MC<sub>1</sub></td><td align="center">7</td><td align="center">4, 15, 46, 51, 87, 14, 25</td><td align="center">1.8</td></tr><tr><td align="center">MC<sub>4</sub></td><td align="center">1</td><td align="center">242</td><td align="center">21.7</td></tr></tbody></table><table-wrap-foot><p>Performance of the hierarchical aggregation algorithm on two versions of the transition matrix (MC<sub>1 </sub>and MC<sub>4</sub>) for the <italic>Ovarian cancer </italic>dataset. For both considered Markov chains the number of phases, group sizes, and running times are given. In the case of MC<sub>1 </sub>the algorithm exploits the hierarchical structure of the chain to speed up the stationary distribution calculation.</p></table-wrap-foot></table-wrap></sec></back></article>