profiling</article-title><source>Clin Biochem</source><year>2004</year><volume>37</volume><fpage>636</fpage><lpage>641</lpage><pub-id pub-id-type="pmid">15234244</pub-id><pub-id pub-id-type="doi">10.1016/j.clinbiochem.2004.05.004</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Drake</surname><given-names>RR</given-names></name><name><surname>Cazares</surname><given-names>LH</given-names></name><name><surname>Corica</surname><given-names>A</given-names></name><name><surname>Malik</surname><given-names>G</given-names></name><name><surname>Schwegler</surname><given-names>EE</given-names></name><name><surname>Libby</surname><given-names>AE</given-names></name><name><surname>Wright</surname><given-names>GL</given-names><suffix>Jr.</suffix></name><name><surname>Adam</surname><given-names>BL</given-names></name><name><surname>Semmes</surname><given-names>OJ</given-names></name></person-group><article-title>Quality control, preparation, and protein stability issues for blood serum and plasma used in biomarker discovery and proteomic profiling assays.</article-title><source>Bioprocessing Journal</source><year>2004</year><volume>3</volume><fpage>45</fpage><lpage>50</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jock</surname><given-names>CA</given-names></name><name><surname>Paulauskis</surname><given-names>JD</given-names></name><name><surname>Baker</surname><given-names>D</given-names></name><name><surname>Olle</surname><given-names>E</given-names></name><name><surname>Bleavins</surname><given-names>MR</given-names></name><name><surname>Johnson</surname><given-names>KJ</given-names></name><name><surname>Heard</surname><given-names>PL</given-names></name></person-group><article-title>Influence of matrix application timing on spectral reproducibility and quality in SELDI-TOF-MS</article-title><source>Biotechniques</source><year>2004</year><volume>37</volume><fpage>30</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">15283196</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koopmann</surname><given-names>J</given-names></name><name><surname>Zhang</surname><given-names>Z</given-names></name><name><surname>White</surname><given-names>N</given-names></name><name><surname>Rosenzweig</surname><given-names>J</given-names></name><name><surname>Fedarko</surname><given-names>N</given-names></name><name><surname>Jagannath</surname><given-names>S</given-names></name><name><surname>Canto</surname><given-names>MI</given-names></name><name><surname>Yeo</surname><given-names>CJ</given-names></name><name><surname>Chan</surname><given-names>DW</given-names></name><name><surname>Goggins</surname><given-names>M</given-names></name></person-group><article-title>Serum diagnosis of pancreatic adenocarcinoma using surface-enhanced laser desorption and ionization mass spectrometry</article-title><source>Clin Cancer Res</source><year>2004</year><volume>10</volume><fpage>860</fpage><lpage>868</lpage><pub-id pub-id-type="pmid">14871961</pub-id><pub-id pub-id-type="doi">10.1158/1078-0432.CCR-1167-3</pub-id></citation></ref></ref-list></back></article>