ef id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tachezy</surname><given-names>R</given-names></name><name><surname>Duson</surname><given-names>G</given-names></name><name><surname>Rector</surname><given-names>A</given-names></name><name><surname>Jenson</surname><given-names>AB</given-names></name><name><surname>Sundberg</surname><given-names>JP</given-names></name><name><surname>Van Ranst</surname><given-names>M</given-names></name></person-group><article-title>Cloning and genomic characterization of <italic>Felis domesticus </italic>papillomavirus type 1.</article-title><source>Virology</source><year>2002</year><volume>301</volume><fpage>313</fpage><lpage>321</lpage><pub-id pub-id-type="pmid">12359433</pub-id><pub-id pub-id-type="doi">10.1006/viro.2002.1566</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>de Villiers</surname><given-names>EM</given-names></name><name><surname>Fauquet</surname><given-names>C</given-names></name><name><surname>Broker</surname><given-names>TR</given-names></name><name><surname>Bernard</surname><given-names>HU</given-names></name><name><surname>zur Hausen</surname><given-names>H</given-names></name></person-group><article-title>Classification of papillomaviruses.</article-title><source>Virology</source><year>2004</year><volume>324</volume><fpage>17</fpage><lpage>27</lpage><pub-id pub-id-type="pmid">15183049</pub-id><pub-id pub-id-type="doi">10.1016/j.virol.2004.03.033</pub-id></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Howley</surname><given-names>PM</given-names></name><name><surname>Lowy</surname><given-names>DR</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Knipe DM, Howley PM</surname></name></person-group><article-title>Papillomaviruses and their replication.</article-title><source>Fields Virology</source><year>2001</year><edition>4</edition><publisher-name>Philadelphia, PA: Lippincott Williams &#x00026; Wilkins</publisher-name><fpage>2197</fpage><lpage>2229</lpage></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rector</surname><given-names>A</given-names></name><name><surname>Van Doorslaer</surname><given-names>K</given-names></name><name><surname>Bertelsen</surname><given-names>M</given-names></name><name><surname>Barker</surname><given-names>IK</given-names></name><name><surname>Olberg</surname><given-names>RA</given-names></name><name><surname>Lemey</surname><given-names>P</given-names></name><name><surname>Sundberg</surname><given-names>JP</given-names></name><name><surname>Van Ranst</surname><given-names>M</given-names></name></person-group><article-title>Isolation and cloning of the raccoon (<italic>Procyon lotor</italic>) papillomavirus type 1 by using degenerate papillomavirus-specific primers.</article-title><source>J Gen Virol</source><year>2005</year><volume>86</volume><fpage>2029</fpage><lpage>2033</lpage><pub-id pub-id-type="pmid">15958682</pub-id><pub-id pub-id-type="doi">10.1099/vir.0.80874-0</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnson</surname><given-names>WE</given-names></name><name><surname>Eizirik</surname><given-names>E</given-names></name><name><surname>Pecon-Slattery</surname><given-names>J</given-names></name><name><surname>Murphy</surname><given-names>WJ</given-names></name><name><surname>Antunes</surname><given-names>A</given-names></name><name><surname>Teeling</surname><given-names>E</given-names></name><name><surname>O'Brien</surname><given-names>SJ</given-names></name></person-group><article-title>The late Miocene radiation of modern Felidae: a genetic assessment.</article-title><source>Science</source><year>2006</year><volume>311</volume><fpage>73</fpag