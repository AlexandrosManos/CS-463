1">2004</td><td align="center" rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">0.27</td><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">2005</td><td align="center" rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">0.27</td><td align="center" rowspan="1" colspan="1"/></tr></tbody></table><table-wrap-foot><fn id="tfn2-ehp0115-000947"><label>a</label><p>Expected counts were derived using annual age-specific German national childhood leukemia incidence rates as the referent.</p></fn><fn id="tfn3-ehp0115-000947"><label>b</label><p>Expected counts were derived using annual age-specific childhood leukemia incidence rates for the six counties surrounding the study region as the referent.</p></fn></table-wrap-foot></table-wrap><table-wrap id="t3-ehp0115-000947" position="float"><label>Table 3</label><caption><p>SIRs for childhood leukemia (&#x0003c; 15 years of age) and observed numbers of cases in two categories of calendar time (1990&#x02013;1998 and 1999&#x02013;2005) and three categories of attained age (0&#x02013;4, 5&#x02013;9, and 10&#x02013;14 years).</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1"/><th colspan="4" align="center" rowspan="1">1990&#x02013;1998<hr/></th><th colspan="4" align="center" rowspan="1">1999&#x02013;2005<hr/></th><th colspan="4" align="center" rowspan="1">Total (1990&#x02013;2005)<hr/></th></tr><tr><th align="left" rowspan="1" colspan="1">Age (years)</th><th align="center" rowspan="1" colspan="1">Obs</th><th align="center" rowspan="1" colspan="1">Exp</th><th align="center" rowspan="1" colspan="1">SIR</th><th align="center" rowspan="1" colspan="1">95% CI</th><th align="center" rowspan="1" colspan="1">Obs</th><th align="center" rowspan="1" colspan="1">Exp</th><th align="center" rowspan="1" colspan="1">SIR</th><th align="center" rowspan="1" colspan="1">95% CI</th><th align="center" rowspan="1" colspan