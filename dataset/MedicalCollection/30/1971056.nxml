id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>MB</given-names></name><name><surname>Gay</surname><given-names>TE</given-names></name><name><surname>Baker</surname><given-names>CN</given-names></name><name><surname>Bannerjee</surname><given-names>SN</given-names></name><name><surname>Tenover</surname><given-names>FC</given-names></name></person-group><article-title>Two per cent sodium chloride is required for susceptibility testing of staphylococci with oxacillin when using agar-based dilution methods</article-title><source>J Clin Microbiol</source><year>1993</year><volume>31</volume><fpage>2683</fpage><lpage>2688</lpage><pub-id pub-id-type="pmid">8253966</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tomasz</surname><given-names>A</given-names></name><name><surname>Drugeon</surname><given-names>HB</given-names></name><name><surname>de Lencastre</surname><given-names>HM</given-names></name><name><surname>Jabes</surname><given-names>D</given-names></name><name><surname>McDougal</surname><given-names>L</given-names></name><name><surname>Bille</surname><given-names>J</given-names></name></person-group><article-title>New mechanism for methicillin resistance in Staphylococcus aureus:clinical isolates that lack the PBP 2a gene and contain normal penicillin-binding capacity</article-title><source>Antimicrob Agents Chemother</source><year>1989</year><volume>33</volume><fpage>1869</fpage><lpage>1874</lpage></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ubukata</surname><given-names>K</given-names></name><name><surname>Nakagami</surname><given-names>S</given-names></name><name><surname>Nitta</surname><given-names>A</given-names></name><name><surname>Yamane</surname><given-names>A</given-names></name><name><surname>Kawakami</surname><given-names>S</given-names></name><name><surname>Sugiura</surname><given-names>M</given-names></name><name><surname>Konno</surname><given-names>A</given-names></name></person-group><article-title>Rapid detection of the mecA gene in methicillin-resistant staphylococci by enzymatic detection of polymerase chain reaction products</article-title><source>Clin Microbiol</source><year>1992</year><volume>30</volume><fpage>1728</fpage><lpage>1733</lpage></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rybak</surname><given-names>MJ</given-names></name><name><surname>LaPente</surname><given-names>KL</given-names></name></person-group><article-title>Community-associated methicillin-resistant <italic>Staphylococcus aureus</italic>: a review</article-title><source>Pharmacother</source><year>2005</year><volume>25</volume><fpage>74</fpage><lpage>85</lpage><pub-id pub-id-type="doi">10.1592/phco.25.1.74.55620</pub-id></citation></ref></ref-list></back></article>