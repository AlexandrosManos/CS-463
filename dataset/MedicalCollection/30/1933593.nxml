r"><name><surname>H&#x000fc;bener</surname><given-names>G</given-names></name><name><surname>Lambacher</surname><given-names>A</given-names></name><name><surname>Fromherz</surname><given-names>P</given-names></name></person-group><year>2003</year><article-title>Anellated hemicyanine dyes with large symmetrical solvatochromism of absorption and fluorescence.</article-title><source>J. Phys. Chem. B</source><volume>107, 7896</volume></citation></ref><ref id="pone.0000699-Kuhn1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kuhn</surname><given-names>B</given-names></name><name><surname>Fromherz</surname><given-names>P</given-names></name><name><surname>Denk</surname><given-names>W</given-names></name></person-group><year>2004</year><article-title>High Sensitivity of Stark-Shift Voltage-Sensing Dyes by One-or Two-Photon Excitation Near the Red Spectral Edge.</article-title><source>Biophys. J.</source><volume>87, 631</volume></citation></ref><ref id="pone.0000699-Eveleth1"><label>20</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Eveleth</surname><given-names>JH</given-names></name></person-group><year>1974</year><comment>United States Patent #3851951</comment></citation></ref><ref id="pone.0000699-Helmchen1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Helmchen</surname><given-names>F</given-names></name><name><surname>Denk</surname><given-names>W</given-names></name></person-group><year>2005</year><article-title>Deep tissue two-photon microscopy.</article-title><source>Nature Methods</source><volume>2, 932</volume></citation></ref><ref id="pone.0000699-Paunescu1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Paunescu</surname><given-names>G</given-names></name><name><surname>Hein</surname><given-names>J</given-names></name><name><surname>Sauer