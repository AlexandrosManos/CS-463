up-type="author"><name><surname>Fulford</surname><given-names>KWM(Bill)</given-names></name><name><surname>Morris</surname><given-names>K</given-names></name><name><surname>Sadler</surname><given-names>J</given-names></name><name><surname>Stanghellini</surname><given-names>G</given-names></name></person-group><source>Nature and Narrative</source><year>2003</year><publisher-name>Oxford: Oxford University Press</publisher-name></citation></ref></ref-list></back></article>