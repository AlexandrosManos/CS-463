ournal"><person-group person-group-type="author"><name><surname>Domon</surname><given-names>B</given-names></name><name><surname>Aebersold</surname><given-names>R</given-names></name></person-group><article-title>Mass spectrometry and protein analysis</article-title><source>Science</source><year>2006</year><volume>312</volume><fpage>212</fpage><lpage>217</lpage><pub-id pub-id-type="pmid">16614208</pub-id><pub-id pub-id-type="doi">10.1126/science.1124619</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Aebersold</surname><given-names>R</given-names></name><name><surname>Mann</surname><given-names>M</given-names></name></person-group><article-title>Mass spectrometry-based proteomics</article-title><source>Nature</source><year>2003</year><volume>422</volume><fpage>198</fpage><lpage>207</lpage><pub-id pub-id-type="pmid">12634793</pub-id><pub-id pub-id-type="doi">10.1038/nature01511</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Louris</surname><given-names>JN</given-names></name><name><surname>Brodbelt-Lustig</surname><given-names/></name><name><surname>Cooks</surname><given-names>RG</given-names></name></person-group><article-title>Ion isolation and sequential stages of mass spectrometry in a quadrupole ion trap mass spectrometer</article-title><source>Int J Mass Spectrom Ion Process</source><year>1990</year><volume>96</volume><fpage>117</fpage><lpage>137</lpage><pub-id pub-id-type="doi">10.1016/0168-1176(90)87025-C</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hager</surname><given-names>JW</given-names></name></person-group><article-title>A new linear ion trap mass spectrometer</article-title><source>Rapid Commun Mass Spectrom</source><year>2002</year><volume>16</volume><fpage>512</fpage><lpage>526</lpage><pub-id pub-id-type="doi">10.1002/rcm.607</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Doroshenko</surname><given-names>VM</given-names></name><name><surname>Cotter</surname><given-names>RJ</given-names></name></person-group><article-title>Ideal velocity focusing in a reflectron time-of-flight mass spectrometer</article-title><source>J Am Soc Mass Spectrom</source><year>1999</year><volume>10</volume><fpage>992</fpage><lpage>999</lpage><pub-id pub-id-type="pmid">10497810</pub-id><pub-id pub-id-type="doi">10.1016/S1044-0305(99)00067-7</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>L</given-names></name><name><surname>Garden</surname><given-names>RW</given-names></name><name><surname>Sweedler</surname><given-names>JV</given-names></name></person-group><article-title>Single-cell MALDI: a new tool for direct peptide profiling</article-title><source>Trends Biotechnol</source><year>2000</year><volume>18</volume><fpage>151</fpage><lpage>160</lpage><pub-id pub-id-type="pmid">10740261</pub-id><pub-id pub-id-type="doi">10.1016/S0167-7799(00)01427-X</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vachet</surname><given-names>RW</given-names></name><name><surname>Ray</surname><given-names>KL</given-names></name><name><surname>Glish</surname><given-names>GL</given-names></name></person-group><article-title>Origin of product ions in the MS/MS spectra of peptides in a Quadrupole ion trap</article-title><source>J Am Soc Mass Spectrom</source><year>1998</year><volume>9</volume><fpage>341</fpage><lpage>344</lpage><pub-id pub-id-type="pmid">9879364</pub-id><pub-id pub-id-type="doi">10.1016/S1044-0305(98)00008-7</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>J