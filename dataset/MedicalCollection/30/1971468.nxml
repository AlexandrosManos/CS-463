 id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cole</surname><given-names>RB</given-names></name></person-group><article-title>Some tenants pertaining to electrospray ionization mass spectrometry</article-title><source>J Mass Spectrom</source><year>2000</year><volume>35</volume><fpage>763</fpage><lpage>772</lpage><pub-id pub-id-type="pmid">10934430</pub-id><pub-id pub-id-type="doi">10.1002/1096-9888(200007)35:7&#x0003c;763::AID-JMS16&#x0003e;3.0.CO;2-#</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Karas</surname><given-names>M</given-names></name><name><surname>Hillenkamp</surname><given-names>F</given-names></name></person-group><article-title>Laser desorption ionization of proteins with masses exceeding 10,000 daltons</article-title><source>Anal Chem</source><year>1988</year><volume>60</volume><fpage>2299</fpage><lpage>2301</lpage><pub-id pub-id-type="pmid">3239801</pub-id><pub-id pub-id-type="doi">10.1021/ac00171a028</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hillenkamp</surname><given-names>F</given-names></name><name><surname>Karas</surname><given-names>M</given-names></name><name><surname>Beavis</surname><given-names>RC</given-names></name><name><surname>Chait</surname><given-names>BT</given-names></name></person-group><article-title>Matrix-assisted laser desorption/ionisation mass spectrometry of biopolymers</article-title><source>Anal Chem</source><year>1991</year><volume>63</volume><fpage>1193A</fpage><lpage>1203A</lpage><pub-id pub-id-type="pmid">1897719</pub-id><pub-id pub-id-type="doi">10.1021/ac00024a002</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Karas</surname><given-names>M</given-names></name><name><surname>Gl&#x000fc;ckmann</surname><given-names>M</g