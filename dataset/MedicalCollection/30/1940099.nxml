>58</volume><issue>4</issue><fpage>253</fpage><lpage>260</lpage><pub-id pub-id-type="doi">10.1136/oem.58.4.253</pub-id><pub-id pub-id-type="pmid">11245742</pub-id></citation></ref><ref id="b18-ehp0115-001192"><citation citation-type="journal"><person-group><name><surname>Hart</surname><given-names>JE</given-names></name><name><surname>Laden</surname><given-names>F</given-names></name><name><surname>Schenker</surname><given-names>MB</given-names></name><name><surname>Garshick</surname><given-names>E</given-names></name></person-group><year>2006</year><article-title>Chronic obstructive pulmonary disease mortality in diesel-exposed railroad workers</article-title><source>Environ Health Perspect</source><volume>114</volume><fpage>1013</fpage><lpage>1017</lpage><pub-id pub-id-type="doi">10.1289/ehp.8743</pub-id><pub-id pub-id-type="pmid">16835052</pub-id></citation></ref><ref id="b19-ehp0115-001192"><citation citation-type="journal"><person-group><name><surname>Hesterberg</surname><given-names>TW</given-names></name><name><surname>Bunn</surname><given-names>WB</given-names><suffix>III</suffix></name><name><surname>Chase</surname><given-names>GR</given-names></name><name><surname>Valberg</surname><given-names>PA</given-names></name><name><surname>Slavin</surname><given-names>TJ</given-names></name><name><surname>Lapin</surname><given-names>CA</given-names></name><etal/></person-group><year>2006</year><article-title>A critical assessment of studies on the carcinogenic potential of diesel exhaust</article-title><source>Crit Rev Toxicol</source><volume>36</volume><issue>9</issue><fpage>727</fpage><lpage>776</lpage><pub-id pub-id-type="doi">10.1080/10408440600908821</pub-id><pub-id pub-id-type="pmid">17050083</pub-id></citation></ref><ref id="b20-ehp0115-001192"><citation citation-type="journal"><person-group><name><surname>Hoek</surname><given-names>G</given-names></name><name><surname>Brunekreef</surname><given-names>B</given-names></name><name><surname>Goldbohm</surname><g