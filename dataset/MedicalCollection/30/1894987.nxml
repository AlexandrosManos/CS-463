son-group person-group-type="author"><name><surname>Neuhouser</surname><given-names>ML</given-names></name><name><surname>Patterson</surname><given-names>RE</given-names></name><name><surname>Schwartz</surname><given-names>SM</given-names></name><name><surname>Hedderson</surname><given-names>MM</given-names></name><name><surname>Bowen</surname><given-names>DJ</given-names></name><name><surname>Standish</surname><given-names>LJ</given-names></name></person-group><article-title>Use of alternative medicine by children with cancer in Washington State</article-title><source>Prev Med</source><year>2001</year><volume>33</volume><fpage>347</fpage><lpage>54</lpage><pub-id pub-id-type="pmid">11676573</pub-id><pub-id pub-id-type="doi">10.1006/pmed.2001.0911</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hurvitz</surname><given-names>EA</given-names></name><name><surname>Leonard</surname><given-names>C</given-names></name><name><surname>Ayyangar</surname><given-names>R</given-names></name><name><surname>Nelson</surname><given-names>VS</given-names></name></person-group><article-title>Complementary and alternative medicine use in families of children with cerebral palsy</article-title><source>Dev Med Child Neurol</source><year>2003</year><volume>45</volume><fpage>364</fpage><lpage>70</lpage><pub-id pub-id-type="pmid">12785436</pub-id><pub-id pub-id-type="doi">10.1017/S0012162203000707</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sibinga</surname><given-names>EMS</given-names></name><name><surname>Sindell</surname><given-names>DL</given-names></name><name><surname>Casella</surname><given-names>JF</given-names></name><name><surname>Duggan</surname><given-names>AK</given-names></name><name><surname>Wilson</surname><given-names>MH</given-names></name></person-group><article-title>Pediatric Patients with Sickle Cell Dise