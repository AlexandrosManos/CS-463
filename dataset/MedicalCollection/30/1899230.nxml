 align="left" rowspan="1" colspan="1">25, 40, 116, 117</td></tr><tr><td align="left" rowspan="1" colspan="1">T16</td><td align="left" rowspan="1" colspan="1">&#x02264;1951</td><td align="left" rowspan="1" colspan="1">infant/fecal</td><td align="left" rowspan="1" colspan="1"><bold>19</bold></td><td align="left" rowspan="1" colspan="1">NCTC8729, s161 type 3; isolated from infant in U.K.; from Y. Ike</td><td align="left" rowspan="1" colspan="1">25, 40, 76, 116, 117</td></tr><tr><td align="left" rowspan="1" colspan="1">T17</td><td align="left" rowspan="1" colspan="1">&#x02264;1951</td><td align="left" rowspan="1" colspan="1">infant/fecal</td><td align="left" rowspan="1" colspan="1"><bold>66</bold></td><td align="left" rowspan="1" colspan="1">NCTC8734, B8 type 8; isolated from infant in U.K.; from Y. Ike</td><td align="left" rowspan="1" colspan="1">25, 40, 76, 116, 117</td></tr><tr><td align="left" rowspan="1" colspan="1">T18</td><td align="left" rowspan="1" colspan="1">&#x02264;1951</td><td align="left" rowspan="1" colspan="1">infant/fecal</td><td align="left" rowspan="1" colspan="1"><bold>71</bold></td><td align="left" rowspan="1" colspan="1">NCTC 8730, GB122 type 4; isolated from infant in U.K.; from Y. Ike</td><td align="left" rowspan="1" colspan="1">25, 40, 76, 116, 117</td></tr><tr><td align="left" rowspan="1" colspan="1">T19</td><td align="left" rowspan="1" colspan="1">&#x02264;1951</td><td align="left" rowspan="1" colspan="1">infant/fecal</td><td align="left" rowspan="1" colspan="1"><bold>91</bold></td><td align="left" rowspan="1" colspan="1">NCTC 8744, D36 type 19; isolated from infant in U.K.; from Y. Ike</td><td align="left" rowspan="1" colspan="1">25, 40, 76, 116, 117</td></tr><tr><td align="left" rowspan="1" colspan="1">T20</td><td align="left" rowspan="1" colspan="1">&#x02264;1951</td><td align="left" rowspan="1" colspan="1">infant/fecal</td><td align="left" rowspan="1" colspan="1"><bold>22</bold></td><td align="left" rowspan="1" colspan="1">NCTC 8745, N161