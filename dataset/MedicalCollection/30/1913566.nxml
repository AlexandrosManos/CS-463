oning</article-title><source>Rep Inst Pathol Natl Taiwan Univ</source><volume>20</volume><fpage>7</fpage><lpage>13</lpage></citation></ref><ref id="b14-ehp0115-a00339"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lamm</surname><given-names>SH</given-names></name><name><surname>Engel</surname><given-names>A</given-names></name><name><surname>Penn</surname><given-names>CA</given-names></name><name><surname>Chen</surname><given-names>R</given-names></name><name><surname>Feinleib</surname><given-names>M</given-names></name></person-group><year>2006</year><article-title>Arsenic cancer risk confounder in southwest Taiwan data set</article-title><source>Environ Health Perspect</source><volume>114</volume><fpage>1077</fpage><lpage>1082</lpage><pub-id pub-id-type="doi">10.1289/ehp.8704</pub-id><comment>[Online 13 January 2006]</comment><pub-id pub-id-type="pmid">16835062</pub-id></citation></ref><ref id="b15-ehp0115-a00339"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morales</surname><given-names>KH</given-names></name><name><surname>Ryan</surname><given-names>L</given-names></name><name><surname>Kuo</surname><given-names>T-L</given-names></name><name><surname>Wu</surname><given-names>M-M</given-names></name><name><surname>Chen</surname><given-names>C-J</given-names></name></person-group><year>2000</year><article-title>Risk of internal cancers from arsenic in drinking water</article-title><source>Environ Health Perspect</source><volume>108</volume><fpage>655</fpage><lpage>661</lpage><pub-id pub-id-type="pmid">10903620</pub-id></citation></ref><ref id="b16-ehp0115-a00339"><citation citation-type="book"><collab>National Research Council</collab><year>1999</year><article-title>Addendum to Chapter 10. Table A10-1. Internal cancer data from arsenic-exposure studies conducted in Taiwan region endemic to black-foot disease</article-title><source>Arsenic in Drinking Water</source><publisher-loc>Washington, DC</publisher-loc><publisher-name>National Academy Press</publisher-name><fpage>308</fpage><lpage>309</lpage></citation></ref><ref id="b17-ehp0115-a00339"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>St&#x000f6;hrer</surname><given-names>G</given-names></name></person-group><year>2001</year><article-title>Re: Risk assessment of internal cancers from arsenic in drinking water [Letter]</article-title><source>Environ Health Perspect</source><volume>109</volume><fpage>A571</fpage><pub-id pub-id-type="pmid">11776955</pub-id></citation></ref><ref id="b18-ehp0115-a00339"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tseng</surname><given-names>W-P</given-names></name></person-group><year>1977</year><article-title>Effects and dose&#x02013;response relationships of skin cancer and blackfoot disease with arsenic</article-title><source>Environ Health Perspect</source><volume>19</volume><fpage>109</fpage><lpage>119</lpage><pub-id pub-id-type="pmid">908285</pub-id></citation></ref><ref id="b19-ehp0115-a00339"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tseng</surname><given-names>W-P</given-names></name><name><surname>Chu</surname><given-names>H-M</given-names></name><name><surname>How</surname><given-names>S-W</given-names></name><name><surname>Fong</surname><given-names>J-M</given-names></name><name><surname>Lin</surname><given-names>C-S</given-names></name><name><surname>Yeh</surname><given-names>S</given-names></name></person-group><year>1968</year><article-title>Prevalence of skin cancer in an endemic area of chronic arsenicism in Taiwan</article-title><source>J Natl Cancer Inst</source><volume>40</volume><fpage>453</fpage><lpage>462</lpage><pub-id pub-id-type="pmid">5644201</pub-id></citation></ref><ref id="b20-ehp0115-a00339"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wu</surname><given-names>MM</given-names></name><name><surname>Kuo</surname><given-names>TL</given-names></name><name><surname>Hwang</surname><given-names>YH</given-names></name><name><surname>Chen</surname><given-names>CJ</given-names></name></person-group><year>1989</year><article-title>Dose-response relation between arsenic concentration in well water and mortality from cancer and vascular diseases</article-title><source>Am J Epidemiol</source><volume>130</volume><fpage>1123</fpage><lpage>1132</lpage><pub-id pub-id-type="pmid">2589305</pub-id></citation></ref></ref-list></back></article>