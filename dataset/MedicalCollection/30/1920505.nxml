id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Patric</surname><given-names>DL</given-names></name><name><surname>Gagnon</surname><given-names>DD</given-names></name><name><surname>Zagari</surname><given-names>MJ</given-names></name><name><surname>Mathijs</surname><given-names>R</given-names></name><name><surname>Sweetenham</surname><given-names>J</given-names></name></person-group><article-title>Assessing the clinical significance of health-related quality of life (HrQOL) improvements in anemic cancer patients receiving epoetin alfa</article-title><source>Eur J Cancer</source><year>2003</year><volume>39</volume><fpage>335</fpage><lpage>345</lpage><pub-id pub-id-type="pmid">12565986</pub-id><pub-id pub-id-type="doi">10.1016/S0959-8049(02)00628-7</pub-id></citation></ref></ref-list></back></article>