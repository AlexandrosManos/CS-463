>18;46</volume><fpage>1496</fpage><lpage>502</lpage><pub-id pub-id-type="pmid">16226174</pub-id><pub-id pub-id-type="doi">10.1016/j.jacc.2005.05.083</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Singh</surname><given-names>AK</given-names></name><name><surname>Gervais</surname><given-names>DA</given-names></name><name><surname>Hahn</surname><given-names>PF</given-names></name><name><surname>Sagar</surname><given-names>P</given-names></name><name><surname>Mueller</surname><given-names>PR</given-names></name><name><surname>Novelline</surname><given-names>RA</given-names></name></person-group><article-title>Acute epiploic appendagitis and its mimics</article-title><source>Radiographics</source><year>2005</year><volume>25</volume><fpage>1521</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">16284132</pub-id><pub-id pub-id-type="doi">10.1148/rg.256055030</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Molla</surname><given-names>E</given-names></name><name><surname>Ripolles</surname><given-names>T</given-names></name><name><surname>Martinez</surname><given-names>MJ</given-names></name><name><surname>Rosello</surname><given-names>E</given-names></name></person-group><article-title>Primary epiploic appendagitis: US and CT findings</article-title><source>European Radiology</source><year>1998</year><volume>8</volume><fpage>435</fpage><lpage>38</lpage><pub-id pub-id-type="pmid">9510579</pub-id><pub-id pub-id-type="doi">10.1007/s003300050408</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rao</surname><given-names>PM</given-names></name><name><surname>Wittenberg</surname><given-names>J</given-names></name><name><surname>Lawarason</surname><given-names>JN</given-names></name></person-group><article-title>Primary epiploic appendagitis: evolutionary changes in CT appearance</article-title><source>Radiology</source><year>1997</year><volume>204</volume><fpage>713</fpage><lpage>17</lpage><pub-id pub-id-type="pmid">9280248</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van Breda Vriesman</surname><given-names>AC</given-names></name><name><surname>de Mol van Otterloo</surname><given-names>AJ</given-names></name><name><surname>Puylaert</surname><given-names>JB</given-names></name></person-group><article-title>Epiploic appendagitis and omental infarction</article-title><source>Eur J Surg</source><year>2001</year><volume>167</volume><fpage>723</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">11775722</pub-id><pub-id pub-id-type="doi">10.1080/11024150152707680</pub-id></citation></ref></ref-list></back></article>