person-group-type="author"><name><surname>Hoballah</surname><given-names>ME</given-names></name><name><surname>Turlings</surname><given-names>TCJ</given-names></name></person-group><year>2005</year><article-title>The role of fresh versus old leaf damage in the attraction of parasitic wasps to herbivore-induced maize volatiles.</article-title><source>J Chem Ecol</source><volume>31</volume><fpage>2003</fpage><lpage>2018</lpage><pub-id pub-id-type="pmid">16132209</pub-id></citation></ref><ref id="pone.0000852-Lewis1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lewis</surname><given-names>WJ</given-names></name><name><surname>Martin</surname><given-names>JWR</given-names></name></person-group><year>1990</year><article-title>Semiochemicals for use with parasitoids: status and future.</article-title><source>J Chem Ecol</source><volume>16</volume><fpage>3067</fpage><lpage>3089</lpage></citation></ref><ref id="pone.0000852-Spencer1"><label>17</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Spencer</surname><given-names>KA</given-names></name></person-group><year>1990</year><article-title>Host specialization in the world Agromyzidae (Diptera). Series Entomologica 45.</article-title><publisher-loc>Dordrecht</publisher-loc><publisher-name>Kluwer Academic Publishers</publisher-name><fpage>444</fpage></citation></ref><ref id="pone.0000852-Parrella1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parrella</surname><given-names>MP</given-names></name></person-group><year>1987</year><article-title>Biology of Liriomyza.</article-title><source>Annu Rev Entomol</source><volume>32</volume><fpage>201</fpage><lpage>224</lpage></citation></ref><ref id="pone.0000852-Kang1"><label>19</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kang</surname><given-names>L</given-names></name>