mes></name><name><surname>Lonati</surname><given-names>C</given-names></name><name><surname>Bianchi</surname><given-names>R</given-names></name></person-group><article-title>MAK-5 treatment enhances the nerve growth factor-mediated neurite outgrowth in PC12 cells</article-title><source>J Ethnopharmacol</source><year>2004</year><volume>93</volume><fpage>161</fpage><lpage>166</lpage><pub-id pub-id-type="pmid">15234748</pub-id><pub-id pub-id-type="doi">10.1016/j.jep.2003.12.033</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arnold</surname><given-names>JT</given-names></name><name><surname>Wilkinson</surname><given-names>BP</given-names></name><name><surname>Korytynski</surname><given-names>EA</given-names></name><name><surname>Steel</surname><given-names>VE</given-names></name></person-group><article-title>Chemopreventive activity of Maharishi Amrit Kalash and related agents in rat tracheal epithelial and human tumor cells</article-title><source>Proc Am Assoc Cancer Res</source><year>1991</year><volume>32</volume><fpage>128</fpage><lpage>131</lpage></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rajalakshmi</surname><given-names>S</given-names></name><name><surname>Sharma</surname><given-names>RK</given-names></name></person-group><article-title>Effect of Maharishi Amrit Kalash (MAK-4) on mRNAs coding for hepatic glycosyltransferases in the rat</article-title><source>Proc Am Assoc Cancer Res</source><year>1992</year><volume>33</volume><fpage>13</fpage><lpage>16</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hsiao</surname><given-names>WLW</given-names></name><name><surname>Pei</surname><given-names>H</given-names></name><name><surname>Matzui</surname><given-names>M</given-names></name><name><surname>Weinstein</surname><given-names>IB</g