given-names></name><name><surname>Ison</surname><given-names>AJ</given-names></name><name><surname>Huang</surname><given-names>S</given-names></name><name><surname>McDermott</surname><given-names>PF</given-names></name><name><surname>Zhang</surname><given-names>Q</given-names></name></person-group><year>2006</year><article-title>Effect of conventional and organic production practices on the prevalence and antimicrobial resistance of <italic>Campylobacter</italic> spp. in poultry</article-title><source>Appl Environ Microbiol</source><volume>72</volume><fpage>3600</fpage><lpage>3607</lpage><pub-id pub-id-type="pmid">16672508</pub-id></citation></ref><ref id="b19-ehp0115-001035"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Manfredi</surname><given-names>R</given-names></name><name><surname>Nanetti</surname><given-names>A</given-names></name><name><surname>Ferri</surname><given-names>M</given-names></name><name><surname>Chiodo</surname><given-names>F</given-names></name></person-group><year>1999</year><article-title>Fatal <italic>Campylobacter jejuni</italic> bacteraemia in patients with AIDS</article-title><source>J Med Microbiol</source><volume>48</volume><fpage>601</fpage><lpage>603</lpage><pub-id pub-id-type="pmid">10359311</pub-id></citation></ref><ref id="b20-ehp0115-001035"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McDermott</surname><given-names>PF</given-names></name><name><surname>Walker</surname><given-names>RD</given-names></name></person-group><year>2003</year><article-title>Standardizing antimicrobial susceptibility testing of <italic>Campylobacter</italic> species [Letter]</article-title><source>J Clin Microbiol</source><volume>41</volume><fpage>1810</fpage><pub-id pub-id-type="pmid">12682196</pub-id></citation></ref><ref id="b21-ehp0115-001035"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moore</surname><given-names>JE</given-names></name><name><surname>Barton</surname><given-names>MD</given-names></name><name><surname>Blair</surname><given-names>IS</given-names></name><name><surname>Corcoran</surname><given-names>D</given-names></name><name><surname>Dooley</surname><given-names>JS</given-names></name><name><surname>Fanning</surname><given-names>S</given-names></name><etal/></person-group><year>2006</year><article-title>The epidemiology of antibiotic resistance in <italic>Campylobacter</italic></article-title><source>Microbes Infect</source><volume>8</volume><fpage>1955</fpage><lpage>1966</lpage><pub-id pub-id-type="pmid">16716632</pub-id></citation></ref><ref id="b22-ehp0115-001035"><citation citation-type="book"><collab>National Research Council</collab><year>1999</year><source>The Use of Drugs in Food Animals: Benefits and Risks</source><publisher-loc>Washington, DC</publisher-loc><publisher-name>National Academy Press</publisher-name></citation></ref><ref id="b23-ehp0115-001035"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Newell</surname><given-names>DG</given-names></name><name><surname>Fearnley</surname><given-names>C</given-names></name></person-group><year>2003</year><article-title>Sources of <italic>Campylobacter</italic> colonization in broiler chickens</article-title><source>Appl Environ Microbiol</source><volume>69</volume><fpage>4343</fpage><lpage>4351</lpage><pub-id pub-id-type="pmid">12902214</pub-id></citation></ref><ref id="b24-ehp0115-001035"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Newell</surname><given-names>DG</given-names></name><name><surname>Shreeve</surname><given-names>JE</given-names></name><name><surname>Toszeghy</surname><given-names>M</given-names></name><name><surname>Domingue</surname><given-names>G</given-names></name><name><surname>Bull</surname><given-names>S</given-names></name><name><surname>Humphrey</surname><given-names>T</given-names></name><etal/></person-group><year>2001</year><article-title>Changes in the carriage of <italic>Campylobacter</italic> strains by poultry carcasses during processing in abattoirs</article-title><source>Appl Environ Microbiol</source><volume>67</volume><fpage>2636</fpage><lpage>2640</lpage><pub-id pub-id-type="pmid">11375174</pub-id></citation></ref><ref id="b25-ehp0115-001035"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Petersen</surname><given-names>L</given-names></name><name><surname>Wedderkopp</surname><given-names>A</given-names></name></person-group><year>2001</year><article-title>Evidence that certain clones of <italic>Campylobacter jejuni</italic> persist during successive broiler flock rotations</article-title><source>Appl Environ Microbiol</source><volume>67</volume><fpage>2739</fpage><lpage>2745</lpage><pub-id pub-id-type="pmid">11375189</pub-id></citation></ref><ref id="b26-ehp0115-001035"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Price</surname><given-names>LB</given-names></name><name><surname>Johnson</surname><given-names>E</given-names></name><name><surname>Vailes</surname><given-names>R</given-names></name><name><surname>Silbergeld</surname><given-names>E</given-names></name></person-group><year>2005</year><article-title>Fluoroquinolone-resistant <italic>Campylobacter</italic> isolates from conventional and antibiotic-free chicken products</article-title><source>Environ Health Perspect</source><volume>113</volume><fpage>557</fpage><lpage>560</lpage><pub-id pub-id-type="pmid">15866763</pub-id></citation></ref><ref id="b27-ehp0115-001035"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Saenz</surname><given-names>Y</given-names></name><name><surname>Zarazaga</surname><given-names>M</given-names></name><name><surname>Lantero</surname><given-names>M</given-names></name><name><surname>Gastanares</surname><given-names>MJ</given-names></name><name><surname>Baquero</surname><given-names>F</given-names></name><name><surname>Torres</surname><given-names>C</given-names></name></person-group><year>2000</year><article-title>Antibiotic resistance in <italic>Campylobacter</italic> strains isolated from animals, foods, and humans in Spain in 1997&#x02013;1998</article-title><source>Antimicrob Agents Chemother</source><volume>44</volume><fpage>267</fpage><lpage>271</lpage><pub-id pub-id-type="pmid">10639348</pub-id></citation></ref><ref id="b28-ehp0115-001035"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Snelling</surname><given-names>WJ</given-names></name><name><surname>McKenna</surname><given-names>JP</given-names></name><name><surname>Lecky</surname><given-names>DM</given-names></name><name><surname>Dooley</surname><given-names>JS</given-names></name></person-group><year>2005</year><article-title>Survival of <italic>Campylobacter jejuni</italic> in waterborne protozoa</article-title><source>Appl Environ Microbiol</source><volume>71</volume><fpage>5560</fpage><lpage>5571</lpage><pub-id pub-id-type="pmid">16151149</pub-id></citation></ref><ref id="b29-ehp0115-001035"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tee</surname><given-names>W</given-names></name><name><surname>Mijch</surname><given-names>A</given-names></name></person-group><year>1998</year><article-title><italic>Campylobacter jejuni</italic> bacteremia in human immunodeficiency virus (HIV)-infected and non-HIV-infected patients: comparison of clinical features and review</article-title><source>Clin Infect Dis</source><volume>26</volume><fpage>91</fpage><lpage>96</lpage><pub-id pub-id-type="pmid">9455515</pub-id></citation></ref><ref id="b30-ehp0115-001035"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Trachoo</surname><given-names>N</given-names></name><name><surname>Frank</surname><given-names>JF</given-nam