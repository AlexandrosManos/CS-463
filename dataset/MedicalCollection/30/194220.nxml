e><pub-id pub-id-type="pmid">7239768</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wiklund</surname><given-names>I</given-names></name><name><surname>Romanus</surname><given-names>B</given-names></name><name><surname>Hunt</surname><given-names>SM</given-names></name></person-group><article-title>Self-assessed disability in patients with arthrosis of the hip joint. Reliability of the Swedish version of the Nottingham Health Profile</article-title><source>Int Disabil Stud</source><year>1988</year><volume>10</volume><fpage>159</fpage><lpage>63</lpage><pub-id pub-id-type="pmid">3235386</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bucquet</surname><given-names>D</given-names></name><name><surname>Condon</surname><given-names>S</given-names></name><name><surname>Ritchie</surname><given-names>K</given-names></name></person-group><article-title>The French Version of the Nottingham Health Profile. A Comparison of items Weights with Those of the Source Version</article-title><source>Soc Sci Med</source><year>1990</year><volume>30</volume><fpage>829</fpage><lpage>835</lpage><pub-id pub-id-type="pmid">2315749</pub-id><pub-id pub-id-type="doi">10.1016/0277-9536(90)90207-9</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Prieto</surname><given-names>L</given-names></name><name><surname>Alonso</surname><given-names>J</given-names></name><name><surname>Viladrich</surname><given-names>MC</given-names></name><name><surname>Ant&#x000f3;</surname><given-names>JM</given-names></name></person-group><article-title>Scaling the Spanish version of the Nottingham Health Profile: evidence of limited value of item weights</article-title><source>J Clin Epidemiol</source><year>1996</year><volume>49</volume><fpage>31</fpage><lpage>38</lpage><pub-id pub-id-type="pmid">8598508</pub-id><pub-id pub-id-type="doi">10.1016/0895-4356(95)00064-X</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Prieto</surname><given-names>L</given-names></name><name><surname>Lamarca</surname><given-names>R</given-names></name><name><surname>Santed</surname><given-names>R</given-names></name><name><surname>McFarlane</surname><given-names>D</given-names></name><name><surname>Sanzo</surname><given-names>JM</given-names></name><name><surname>Alonso</surname><given-names>J</given-names></name></person-group><article-title>Reducing the items of the Nottingham Health Profile</article-title><source>Qual Life Res</source><year>1997</year><volume>6</volume><fpage>703</fpage></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Prieto</surname><given-names>L</given-names></name><name><surname>Alonso</surname><given-names>J</given-names></name><name><surname>Lamarca</surname><given-names>R</given-names></name><name><surname>Wright</surname><given-names>BD</given-names></name></person-group><article-title>Rasch measurement for reducing the items of The Nottingham Health Profile</article-title><source>J Outcomes Meas</source><year>1998</year><volume>2</volume><fpage>285</fpage><lpage>301</lpage></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Streiner</surname><given-names>DL</given-names></name><name><surname>Norman</surname><given-names>GR</given-names></name></person-group><source>Health measurement scales A practical guide to their development and use</source><year>1989</year><publisher-name>Oxford: Oxford University Press</publisher-name></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cronbach</surname><given-names>LJ</given-names></name></person-group><article-title