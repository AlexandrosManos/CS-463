ign="left">75.50 (24.54)<sup>a,b</sup></td></tr><tr><td align="left">&#x02003;Impaired Memory</td><td align="left">62.96 (25.22)</td><td align="left">59.63 (23.82)</td><td align="left">65.14 (25.53)</td><td align="left">68.94 (22.65)</td></tr><tr><td align="left">&#x02003;Unrefreshing Sleep</td><td align="left">76.89 (18.89)</td><td align="left">75.19 (25.43)</td><td align="left">89.67 (10.86)</td><td align="left">87.03 (14.46)</td></tr><tr><td align="left">&#x02003;Post-Exertional Malaise</td><td align="left">73.27 (17.84)</td><td align="left">75.19 (19.16)</td><td align="left">74.86 (23.74)</td><td align="left">82.36 (14.10)</td></tr><tr><td align="left">&#x02003;Headaches</td><td align="left">42.91 (33.39)<sup>a</sup></td><td align="left">56.87 (30.50)</td><td align="left">55.00 (31.44)</td><td align="left">74.03 (24.39)<sup>a</sup></td></tr><tr><td align="left" colspan="5">Six Minute Walk Test</td></tr><tr><td align="left">&#x02003;Distance Walked (feet)</td><td align="left">1419.47 (312.17)</td><td align="left">1728.08 (2387.62)</td><td align="left">1304.28 (356.492)</td><td align="left">1221.39 (239.23)</td></tr><tr><td align="left">&#x02003;Average RPE</td><td align="left">9.85 (2.24)<sup>a</sup></td><td align="left">10.56 (2.08)</td><td align="left">11.37 (2.76)</td><td align="left">11.78 (2.42)<sup>a</sup></td></tr><tr><td align="left">Sit and Reach (inches)</td><td align="left">13.48 (3.54)</td><td align="left">13.16 (4.49)</td><td align="left">14.55 (4.24)</td><td align="left">13.40 (3.77)</td></tr><tr><td align="left" colspan="5">Hand Grip (pounds)</td></tr><tr><td align="left">&#x02003;Right</td><td align="left">64.45 (24.67)</td><td align="left">61.57 (21.21)</td><td align="left">64.19 (21.87)</td><td align="left">52.28 (15.34)</td></tr><tr><td align="left">&#x02003;Left</td><td align="left">60.04 (22.71)</td><td align="left">58.63 (17.90)</td><td align="left">58.72 (20.71)</td><td align="left">48.07 (17.21)</td></tr><tr><td align="left">Actigraphy Mea