urname><given-names>ML</given-names></name><name><surname>Gevirtz</surname><given-names>CM</given-names></name><name><surname>Kerstein</surname><given-names>MD</given-names></name></person-group><article-title>Septic pelvic thrombophlebitis: an update</article-title><source>Obstet Gynecol</source><year>1983</year><volume>62</volume><fpage>83</fpage><lpage>89</lpage><pub-id pub-id-type="pmid">6682948</pub-id></citation></ref></ref-list></back></article>