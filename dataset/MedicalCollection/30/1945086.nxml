ign="left" rowspan="1" colspan="1">60.75</td><td align="left" rowspan="1" colspan="1">86.51</td><td align="left" rowspan="1" colspan="1">2.38</td></tr><tr><td align="left" rowspan="1" colspan="1">Vincent</td><td align="left" rowspan="1" colspan="1">M</td><td align="left" rowspan="1" colspan="1">2.75</td><td align="left" rowspan="1" colspan="1">21.25</td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">11.25</td><td align="left" rowspan="1" colspan="1">7.5</td><td align="left" rowspan="1" colspan="1">3.75</td><td align="left" rowspan="1" colspan="1">11.25</td><td align="left" rowspan="1" colspan="1">66.75</td><td align="left" rowspan="1" colspan="1">87.83</td><td align="left" rowspan="1" colspan="1">4.37</td></tr><tr><td align="left" rowspan="1" colspan="1">M21-02</td><td align="left" rowspan="1" colspan="1">M</td><td align="left" rowspan="1" colspan="1">2.5</td><td align="left" rowspan="1" colspan="1">11</td><td align="left" rowspan="1" colspan="1">9.25</td><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">7.25</td><td align="left" rowspan="1" colspan="1">6.5</td><td align="left" rowspan="1" colspan="1">16.00</td><td align="left" rowspan="1" colspan="1">52.50</td><td align="left" rowspan="1" colspan="1">64.60</td><td align="left" rowspan="1" colspan="1">3.20</td></tr><tr><td align="left" rowspan="1" colspan="1">DC</td><td align="left" rowspan="1" colspan="1">F</td><td align="left" rowspan="1" colspan="1">3.25</td><td align="left" rowspan="1" colspan="1">8.25</td><td align="left" rowspan="1" colspan="1">11.5</td><td align="left" rowspan="1" colspan="1">10.25</td><td align="left" rowspan="1" colspan="1">8.75</td><td align="left" rowspan="1" colspan="1">6.75</td><td align="left" rowspan="1" colspan="1">19.5</td><td align="left" rowspan="1" colspan="1">67.50</td><td align="left" rowspan="1" colspan="1">61.84</td><td align="left" rowspan="1" colspan="1">2.95</td></tr><tr><td align="left" rowspan