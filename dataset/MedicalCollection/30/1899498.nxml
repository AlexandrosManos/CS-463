n citation-type="journal"><person-group person-group-type="author"><name><surname>Britton</surname><given-names>WJ</given-names></name><name><surname>Palendira</surname><given-names>U</given-names></name></person-group><article-title>Improving vaccines against tuberculosis</article-title><source>Immunol Cell Biol</source><year>2003</year><volume>81</volume><fpage>34</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">12534944</pub-id><pub-id pub-id-type="doi">10.1046/j.0818-9641.2002.01143.x</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vijayalakshmi</surname><given-names>V</given-names></name><name><surname>Rao</surname><given-names>DV</given-names></name><name><surname>Murthy</surname><given-names>KJR</given-names></name><name><surname>Jain</surname><given-names>SN</given-names></name></person-group><article-title>A study of the tuberculin test and its correlation with the in vitro responses</article-title><source>Lung India</source><year>1989</year><volume>7</volume><fpage>63</fpage><lpage>6</lpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lyon</surname><given-names>AJ</given-names></name></person-group><article-title>Sensitivity of neonates to tuberculin after BCG vaccination</article-title><source>Br Med J (Clin Res)</source><year>1986</year><volume>292</volume><fpage>1526</fpage><lpage>1527</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Karalliedde</surname><given-names>S</given-names></name><name><surname>Katugaha</surname><given-names>LP</given-names></name><name><surname>Uragoda</surname><given-names>CG</given-names></name></person-group><article-title>Tuberculin response of Srilankan children after BCG vaccination at birth</article-title><source>Tubercle</source><year>1987</year><volume>63</volume><fpage>33</fpage><lpa