"><person-group person-group-type="author"><name><surname>Wenger</surname><given-names>E</given-names></name></person-group><source>Communities of Practice</source><year>1999</year><publisher-name>New York, NY: Cambridge University Press</publisher-name></citation></ref><ref id="B45"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Marsick</surname><given-names>VJ</given-names></name><name><surname>Watkins</surname><given-names>KE</given-names></name></person-group><source>Facilitating Learning Organizations</source><year>1999</year><publisher-name>Brookfield, VT: Gower</publisher-name></citation></ref><ref id="B46"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Marsick</surname><given-names>VJ</given-names></name></person-group><source>Learning in the Workplace</source><year>1987</year><publisher-name>New York: Croom Helm</publisher-name></citation></ref></ref-list></back></article>