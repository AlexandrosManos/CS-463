n-group><article-title>Health check for workers in school food supplier: focusing on neck-shoulder-arm pain and low back pain (Abstract in English)</article-title><source>JJOMT</source><year>2001</year><volume>49</volume><fpage>478</fpage><lpage>482</lpage></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oze</surname><given-names>Y</given-names></name></person-group><article-title>Studies on health hazards among cooks providing school lunch service. Report 1. The influence of working conditions in central and school kitchens prevalence of health hazards (Abstract in English)</article-title><source>Sangyo Igaku</source><year>1984</year><volume>26</volume><fpage>414</fpage><lpage>424</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oze</surname><given-names>Y</given-names></name></person-group><article-title>Studies on health hazards among cooks providing school lunch service. Report 2. An analysis of factors associated with the development of health hazards (Abstract in English)</article-title><source>Sangyo Igaku</source><year>1984</year><volume>26</volume><fpage>425</fpage><lpage>437</lpage><pub-id pub-id-type="pmid">6241950</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Elders</surname><given-names>LA</given-names></name><name><surname>Burdorf</surname><given-names>A</given-names></name></person-group><article-title>Prevalence, incidence, and recurrence of low back pain in scaffolders during a 3-year follow-up study</article-title><source>Spine</source><year>2004</year><volume>29</volume><fpage>E101</fpage><lpage>106</lpage><pub-id pub-id-type="doi">10.1097/01.BRS.0000115125.60331.72</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lau</surname><given-names