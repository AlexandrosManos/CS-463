<given-names>MV</given-names></name><name><surname>Phillips-Bute</surname><given-names>B</given-names></name><name><surname>Mathew</surname><given-names>JP</given-names></name><name><surname>Smith</surname><given-names>PK</given-names></name><name><surname>Newman</surname><given-names>MF</given-names></name><name><surname>Schwinn</surname><given-names>DA</given-names></name><name><surname>Stafford-Smith</surname><given-names>M</given-names></name></person-group><article-title>Genetic factors contribute to bleeding after cardiac surgery</article-title><source>J Thromb Haemost</source><year>2005</year><volume>3</volume><fpage>1206</fpage><lpage>1212</lpage><pub-id pub-id-type="pmid">15892865</pub-id><pub-id pub-id-type="doi">10.1111/j.1538-7836.2005.01337.x</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Donahue</surname><given-names>BS</given-names></name><name><surname>Gailani</surname><given-names>D</given-names></name><name><surname>Higgins</surname><given-names>MS</given-names></name><name><surname>Drinkwater</surname><given-names>DC</given-names></name><name><surname>George</surname><given-names>AL</given-names><suffix>Jr.</suffix></name></person-group><article-title>Factor V Leiden protects against blood loss and transfusion after cardiac surgery</article-title><source>Circulation</source><year>2003</year><volume>107</volume><fpage>1003</fpage><lpage>1008</lpage><pub-id pub-id-type="pmid">12600914</pub-id><pub-id pub-id-type="doi">10.1161/01.CIR.0000051864.28048.01</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carroll</surname><given-names>RC</given-names></name><name><surname>Chavez</surname><given-names>JJ</given-names></name><name><surname>Snider</surname><given-names>CC</given-names></name><name><surname>Meyer</surname><given-names>DS</given-names></name><name><surname>Muenchen</surname><given-name