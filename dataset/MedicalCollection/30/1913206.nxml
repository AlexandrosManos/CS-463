person-group-type="author"><name><surname>Picard</surname><given-names>A</given-names></name><name><surname>Harricane</surname><given-names>MC</given-names></name><name><surname>Labbe</surname><given-names>JC</given-names></name><name><surname>Doree</surname><given-names>M</given-names></name></person-group><year>1988</year><article-title>Germinal vesicle components are not required for the cell-cycle oscillator of the early starfish embryo.</article-title><source>Dev Biol</source><volume>128</volume><fpage>121</fpage><lpage>128</lpage><pub-id pub-id-type="pmid">3289983</pub-id></citation></ref><ref id="pone.0000618-Bucciarelli1"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bucciarelli</surname><given-names>E</given-names></name><name><surname>Giansanti</surname><given-names>MG</given-names></name><name><surname>Bonaccorsi</surname><given-names>S</given-names></name><name><surname>Gatti</surname><given-names>M</given-names></name></person-group><year>2003</year><article-title>Spindle assembly and cytokinesis in the absence of chromosomes during Drosophila male meiosis.</article-title><source>J Cell Biol</source><volume>160</volume><fpage>993</fpage><lpage>999</lpage><pub-id pub-id-type="pmid">12654903</pub-id></citation></ref><ref id="pone.0000618-Khodjakov1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Khodjakov</surname><given-names>A</given-names></name><name><surname>Cole</surname><given-names>RW</given-names></name><name><surname>Oakley</surname><given-names>BR</given-names></name><name><surname>Rieder</surname><given-names>CL</given-names></name></person-group><year>2000</year><article-title>Centrosome-independent mitotic spindle formation in vertebrates.</article-title><source>Curr Biol</source><volume>10</volume><fpage>59</fpage><lpage>67</lpage><pub-id pub-id-type="pmid">10662665</pub-id></citation></ref><ref id="pone.0000618-CarazoSalas1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carazo-Salas</surname><given-names>RE</given-names></name><name><surname>Nurse</surname><given-names>P</given-names></name></person-group><year>2006</year><article-title>Self-organization of interphase microtubule arrays in fission yeast.</article-title><source>Nat Cell Biol</source><volume>8</volume><fpage>1102</fpage><lpage>1107</lpage><pub-id pub-id-type="pmid">16998477</pub-id></citation></ref><ref id="pone.0000618-Daga1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Daga</surname><given-names>RR</given-names></name><name><surname>Lee</surname><given-names>KG</given-names></name><name><surname>Bratman</surname><given-names>S</given-names></name><name><surname>Salas-Pino</surname><given-names>S</given-names></name><name><surname>Chang</surname><given-names>F</given-names></name></person-group><year>2006</year><article-title>Self-organization of microtubule bundles in anucleate fission yeast cells.</article-title><source>Nat Cell Biol</source><volume>8</volume><fpage>1108</fpage><lpage>1113</lpage><pub-id pub-id-type="pmid">16998476</pub-id></citation></ref><ref id="pone.0000618-Daga2"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Daga</surname><given-names>RR</given-names></name><name><surname>Chang</surname><given-names>F</given-names></name></person-group><year>2005</year><article-title>Dynamic positioning of the fission yeast cell division plane.</article-title><source>Proc Natl Acad Sci U S A</source><volume>102</volume><fpage>8228</fpage><lpage>8232</lpage><pub-id pub-id-type="pmid">15928091</pub-id></citation></ref><ref id="pone.0000618-Krapp1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Krapp</surname><given-names>A</given-names></name><name><surname>Gulli</surname><gi