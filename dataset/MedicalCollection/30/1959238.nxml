 pub-id-type="pmid">8551567</pub-id></citation></ref><ref id="B4"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brenner</surname><given-names>BG</given-names></name><name><surname>Turner</surname><given-names>D</given-names></name><name><surname>Wainberg</surname><given-names>MA</given-names></name></person-group><article-title>HIV-1 drug resistance: can we overcome</article-title><source>Expert Opin Biol Ther</source><year>2002</year><volume>2</volume><fpage>751</fpage><lpage>761</lpage><pub-id pub-id-type="pmid">12387674</pub-id><pub-id pub-id-type="doi">10.1517/14712598.2.7.751</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Winters</surname><given-names>MA</given-names></name><name><surname>Coolley</surname><given-names>KL</given-names></name><name><surname>Girard</surname><given-names>YA</given-names></name><name><surname>Levee</surname><given-names>DJ</given-names></name><name><surname>Hamdan</surname><given-names>H</given-names></name><name><surname>Shafer</surname><given-names>RW</given-names></name><name><surname>Katzenstein</surname><given-names>DA</given-names></name><name><surname>Merigan</surname><given-names>TC</given-names></name></person-group><article-title>A 6-basepair insert in the reverse transcriptase gene of human immunodeficiency virus type 1 confers resistance to multiple nucleoside inhibitors</article-title><source>J Clin Invest</source><year>1998</year><volume>102</volume><fpage>1769</fpage><lpage>1775</lpage><pub-id pub-id-type="pmid">9819361</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schmit</surname><given-names>J-C</given-names></name><name><surname>Van Laethem</surname><given-names>K</given-names></name><name><surname>Ruiz</surname><given-names>L</given-names></name><name><surname>Hermans</surname><given-names>P</given-names></name