 citation-type="journal"><person-group person-group-type="author"><name><surname>Rosenbaum</surname><given-names>RL</given-names></name><name><surname>Barzel</surname><given-names>US</given-names></name></person-group><article-title>Levothyroxine replacement dose for primary hypothyroidism decreases with age</article-title><source>Ann Int Med</source><year>1982</year><volume>96</volume><fpage>53</fpage><lpage>55</lpage><pub-id pub-id-type="pmid">7053703</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sawin</surname><given-names>CT</given-names></name><name><surname>Geller</surname><given-names>A</given-names></name><name><surname>Hershman</surname><given-names>JM</given-names></name><name><surname>Castelli</surname><given-names>W</given-names></name><name><surname>Bacharach</surname><given-names>P</given-names></name></person-group><article-title>The ageing thyroid: the use of thyroid hormone in older people</article-title><source>JAMA</source><year>1989</year><volume>261</volume><fpage>2653</fpage><lpage>2655</lpage><pub-id pub-id-type="pmid">2709545</pub-id><pub-id pub-id-type="doi">10.1001/jama.261.18.2653</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Santini</surname><given-names>F</given-names></name><name><surname>Pinchera</surname><given-names>A</given-names></name><name><surname>Marsili</surname><given-names>A</given-names></name><name><surname>Ceccarini</surname><given-names>G</given-names></name><name><surname>Castagna</surname><given-names>MG</given-names></name><name><surname>Valeriano</surname><given-names>R</given-names></name><name><surname>Giannetti</surname><given-names>M</given-names></name><name><surname>Taddei</surname><given-names>D</given-names></name><name><surname>Centoni</surname><given-names>R</given-names></name><name><surname>Scartabelli</surname><given-names>G</given-names></n