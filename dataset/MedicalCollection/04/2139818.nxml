lpage>2101</lpage><pub-id pub-id-type="pmid">7528751</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chiquet-Ehrismann</surname><given-names>R</given-names></name><name><surname>Hagios</surname><given-names>C</given-names></name><name><surname>Schenk</surname><given-names>S</given-names></name></person-group><article-title>The complexity of regulating tenascins</article-title><source>Bioessays</source><year>1995</year><volume>17</volume><fpage>873</fpage><lpage>878</lpage><pub-id pub-id-type="pmid">7487968</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chung</surname><given-names>C</given-names></name><name><surname>Murphy-Ullrich</surname><given-names>J</given-names></name><name><surname>Erickson</surname><given-names>H</given-names></name></person-group><article-title>Mitogenesis, cell migration, and loss of focal adhesions induced by tenascin-C interacting with its cell surface receptor annexin II</article-title><source>Mol Biol Cell</source><year>1996</year><volume>7</volume><fpage>883</fpage><lpage>892</lpage><pub-id pub-id-type="pmid">8816995</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chung</surname><given-names>CY</given-names></name><name><surname>Erickson</surname><given-names>HP</given-names></name></person-group><article-title>Cell surface annexin II is a high affinity receptor for the alternatively spliced segment of tenascin-C</article-title><source>J Cell Biol</source><year>1994</year><volume>126</volume><fpage>539</fpage><lpage>548</lpage><pub-id pub-id-type="pmid">7518469</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Davis</surname><given-names>GE</given-names></name></person-group><article-title>Affinity of integrins for da