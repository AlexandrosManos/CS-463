" colspan="1">60&#x02013;64</td><td align="left" rowspan="1" colspan="1">18,574 (22.9)</td><td align="left" rowspan="1" colspan="1">22,537 (22.6)</td><td align="left" rowspan="1" colspan="1">2,029 (12.0)</td><td align="left" rowspan="1" colspan="1">2,457 (11.9)</td><td align="left" rowspan="1" colspan="1">14,024 (8.5)</td><td align="left" rowspan="1" colspan="1">21,305 (8.8)</td></tr><tr><td align="left" rowspan="1" colspan="1">65&#x02013;69</td><td align="left" rowspan="1" colspan="1">20,862 (25.7)</td><td align="left" rowspan="1" colspan="1">24,430 (24.5)</td><td align="left" rowspan="1" colspan="1">2,941 (17.3)</td><td align="left" rowspan="1" colspan="1">3,438 (16.6)</td><td align="left" rowspan="1" colspan="1">18,221 (11.1)</td><td align="left" rowspan="1" colspan="1">27,533 (11.3)</td></tr><tr><td align="left" rowspan="1" colspan="1">70&#x02013;74</td><td align="left" rowspan="1" colspan="1">12,044 (14.9)</td><td align="left" rowspan="1" colspan="1">13,770 (13.8)</td><td align="left" rowspan="1" colspan="1">2,208 (13.0)</td><td align="left" rowspan="1" colspan="1">2,561 (12.4)</td><td align="left" rowspan="1" colspan="1">13,470 (8.2)</td><td align="left" rowspan="1" colspan="1">20,506 (8.5)</td></tr><tr><td align="left" rowspan="1" colspan="1">75&#x02013;79</td><td align="left" rowspan="1" colspan="1">5,813 (7.2)</td><td align="left" rowspan="1" colspan="1">6,563 (6.6)</td><td align="left" rowspan="1" colspan="1">1,375 (8.1)</td><td align="left" rowspan="1" colspan="1">1,575 (7.6)</td><td align="left" rowspan="1" colspan="1">8,830 (5.4)</td><td align="left" rowspan="1" colspan="1">13,465 (5.6)</td></tr><tr><td align="left" rowspan="1" colspan="1">Family history &#x02013; no. (&#x00025;)</td><td align="left" rowspan="1" colspan="1">2,774 (3.4)</td><td align="left" rowspan="1" colspan="1">4,745 (4.8)</td><td align="left" rowspan="1" colspan="1">550 (3.2)</td><td align="left" rowspan="1" colspan="1">939 (4.5)</td><td align="left" rowspan="1" colspan="1">9,908 (6.0)</td><td align="left" rowspan="1" colspan="1">16,898 (7.0)</td></tr><tr><td colspan="7" align="left" rowspan="1">Performance characteristics</td></tr><tr><td align="left" rowspan="1" colspan="1">Intravenous sedation &#x02013; no. (&#x00025;)</td><td align="left" rowspan="1" colspan="1">72,466 (89.4)</td><td align="left" rowspan="1" colspan="1">95,416 (95.6)</td><td align="left" rowspan="1" colspan="1">15,409 (90.8)</td><td align="left" rowspan="1" colspan="1">19,879 (96.2)</td><td align="left" rowspan="1" colspan="1">152,186 (92.4)</td><td align="left" rowspan="1" colspan="1">234,587 (96.7)</td></tr><tr><td align="left" rowspan="1" colspan="1">Cecal intubation &#x02013; no. (&#x00025;)</td><td align="left" rowspan="1" colspan="1">79,803 (98.4)</td><td align="left" rowspan="1" colspan="1">97,978 (98.2)</td><td align="left" rowspan="1" colspan="1">16,567 (97.6)</td><td align="left" rowspan="1" colspan="1">20,138 (97.4)</td><td align="left" rowspan="1" colspan="1">160,600 (97.5)</td><td align="left" rowspan="1" colspan="1">235,565 (97.1)</td></tr><tr><td colspan="7" align="left" rowspan="1">Complications &#x02013; no. (&#x00025;)</td></tr><tr><td align="left" rowspan="1" colspan="1">Bleeding</td><td align="left" rowspan="1" colspan="1">220 (0.27)</td><td align="left" rowspan="1" colspan="1">132 (0.13)</td><td align="left" rowspan="1" colspan="1">81 (0.48)</td><td align="left" rowspan="1" colspan="1">51 (0.25)</td><td align="left" rowspan="1" colspan="1">287 (0.17)</td><td align="left" rowspan="1" colspan="1">239 (0.10)</td></tr><tr><td align="left" rowspan="1" colspan="1">Perforation</td><td align="left" rowspan="1" colspan="1">22 (0.03)</td><td align="left" rowspan="1" colspan="1">24 (0.02)</td><td align="left" rowspan="1" colspan="1">8 (0.05)</td><td align="left" rowspan="1" colspan="1">5 (0.02)</td><td align="left" rowspan="1" colspan="1">23 (0.01)</td><td align="left" rowspan="1" colspan="1">52 (0.02)</td></tr><tr><td align="left" rowspan="1" colspan="1">Cardiorespiratory</td><td align="left" rowspan="1" colspan="1">30 (0.04)</td><td align="left" rowspan="1" colspan="1">36 (0.04)</td><td align="left" rowspan="1" colspan="1">9 (0.05)</td><td align="left" rowspan="1" colspan="1">16 (0.08)</td><td align="left" rowspan="1" colspan="1">45 (0.03)</td><td align="left" rowspan="1" colspan="1">65 (0.03)</td></tr></tbody></table></alternatives></table-wrap><p>Colonoscopy findings are presented in <xref ref-type="table" rid="pone-0020076-t002">Table 2</xref>. 55.2&#x00025; of screening, 54.9&#x00025; of FOBT&#x0002b;, and 59.6&#x00025; of diagnostic colonoscopies were performed in women. Screening colonoscopy revealed advanced adenoma in 5,295 women (5.3&#x00025;) and in 7,923 men (9.8&#x00025;) and cancer in 709 (0.7&#x00025;) women and 1,061 (1.3&#x00025;) men. FOBT&#x0002b; colonoscopies identified advanced adenoma in 1,782 women (8.6&#x00025;) and 2,522 men (14.9&#x00025;) and cancer in 524 women (2.5&#x00025;) and 746 men (4.4&#x00025;). Upon diagnostic colonoscopy 6,977 women (2.9&#x00025;) and 8,821 men (5.4&#x00025;) were found to carry advanced adenoma, 1,802 women (0.7&#x00025;) and 2,340 men (1.4&#x00025;) had cancers. Remarkably, the highest rates of advanced adenoma and cancer were found in FOBT&#x0002b; colonoscopies in both genders, reflecting the preselection of this screening group.</p><table-wrap id="pone-0020076-t002" position="float"><object-id pub-id-type="doi">10.1371/journal.pone.0020076.t002</object-id><label>Table 2</label><caption><title>Findings on 625,918 colonoscopies.</title></caption><alternatives><graphic id="pone-0020076-t002-2" xlink:href="pone.0020076.t002"/><table frame="hsides" rules="groups"><colgroup span="1"><col align="left" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/></colgroup><thead><tr><td align="left" rowspan="1" col