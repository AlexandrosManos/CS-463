mes></name></person-group><article-title>Thyronin treatment in adult and pediatric heart surgery: clinical experience and review of the literature</article-title><source>Eur J Heart Fail</source><year>2002</year><volume>4</volume><fpage>577</fpage><lpage>582</lpage><pub-id pub-id-type="pmid">12413499</pub-id><pub-id pub-id-type="doi">10.1016/S1388-9842(02)00096-X</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Klemperer</surname><given-names>JD</given-names></name></person-group><article-title>Thyroid hormone and cardiac surgery</article-title><source>Thyroid</source><year>2002</year><volume>12</volume><fpage>517</fpage><lpage>521</lpage><pub-id pub-id-type="pmid">12165116</pub-id><pub-id pub-id-type="doi">10.1089/105072502760143917</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rosendale</surname><given-names>JD</given-names></name><name><surname>Kauffman</surname><given-names>HM</given-names></name><name><surname>McBride</surname><given-names>MA</given-names></name><name><surname>Chabalewski</surname><given-names>FL</given-names></name><name><surname>Zaroff</surname><given-names>JG</given-names></name><name><surname>Garrity</surname><given-names>ER</given-names></name><name><surname>Delmonico</surname><given-names>FL</given-names></name><name><surname>Rosengard</surname><given-names>BR</given-names></name></person-group><article-title>Hormonal resuscitation yields more transplanted hearts, with improved early function</article-title><source>Transplantation</source><year>2003</year><volume>75</volume><fpage>1336</fpage><lpage>1341</lpage><pub-id pub-id-type="pmid">12717226</pub-id><pub-id pub-id-type="doi">10.1097/01.TP.0000062839.58826.6D</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oshiro</surname><given-names>Y</given-name