lpage>42</lpage><pub-id pub-id-type="pmid">1730747</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cai</surname><given-names>CX</given-names></name><name><surname>Birk</surname><given-names>DE</given-names></name><name><surname>Linsenmayer</surname><given-names>TF</given-names></name></person-group><article-title>Ferritin is a developmentally regulated nuclear protein of avian corneal epithelial cells</article-title><source>J Biol Chem</source><year>1997</year><volume>272</volume><fpage>12831</fpage><lpage>12839</lpage><pub-id pub-id-type="pmid">9139744</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carey</surname><given-names>DJ</given-names></name><name><surname>Evans</surname><given-names>DM</given-names></name><name><surname>Stahl</surname><given-names>RC</given-names></name><name><surname>Asundi</surname><given-names>VK</given-names></name><name><surname>Conner</surname><given-names>KJ</given-names></name><name><surname>Garbes</surname><given-names>P</given-names></name><name><surname>Cizmeci-Smith</surname><given-names>G</given-names></name></person-group><article-title>Molecular cloning and characterization of <italic>N</italic>-syndecan, a novel transmembrane heparan sulfate proteoglycan</article-title><source>J Cell Biol</source><year>1992</year><volume>117</volume><fpage>191</fpage><lpage>201</lpage><pub-id pub-id-type="pmid">1556152</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carey</surname><given-names>DJ</given-names></name><name><surname>Stahl</surname><given-names>RC</given-names></name><name><surname>Asundi</surname><given-names>VK</given-names></name><name><surname>Tucker</surname><given-names>B</given-names></name></person-group><article-title>Processing and subcellular distribution of the Schwann cell lipid