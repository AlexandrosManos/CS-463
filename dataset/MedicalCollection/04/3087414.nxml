></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Farvardin</surname><given-names>M</given-names></name><name><surname>Afarid</surname><given-names>M</given-names></name><name><surname>Mehryar</surname><given-names>M</given-names></name><name><surname>Hosseini</surname><given-names>H</given-names></name></person-group><article-title>Intravitreal infliximab for the treatment of sight-threatening chronic noninfectious uveitis</article-title><source><italic>Retina</italic></source><year>2010</year><volume>30</volume><fpage>1530</fpage><lpage>1535</lpage><pub-id pub-id-type="pmid">20924267</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jabbarvand</surname><given-names>M</given-names></name><name><surname>Fard</surname><given-names>MA</given-names></name></person-group><article-title>Infliximab in a patient with refractory necrotizing scleritis associated with relapsing polychondritis</article-title><source><italic>Ocular Immunology and Inflammation</italic></source><year>2010</year><volume>18</volume><issue>3</issue><fpage>216</fpage><lpage>217</lpage><pub-id pub-id-type="pmid">20482401</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Doctor</surname><given-names>P</given-names></name><name><surname>Sultan</surname><given-names>A</given-names></name><name><surname>Syed</surname><given-names>S</given-names></name><name><surname>Christen</surname><given-names>W</given-names></name><name><surname>Bhat</surname><given-names>P</given-names></name><name><surname>Foster</surname><given-names>CS</given-names></name></person-group><article-title>Infliximab for the treatment of refractory scleritis</article-title><source><italic>British Journal of Ophthalmology</