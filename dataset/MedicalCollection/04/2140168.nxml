 Biol Chem</source><year>1996</year><volume>271</volume><fpage>21767</fpage><lpage>21774</lpage><pub-id pub-id-type="pmid">8702973</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cockroft</surname><given-names>S</given-names></name><name><surname>Thomas</surname><given-names>GMH</given-names></name><name><surname>Fensome</surname><given-names>A</given-names></name><name><surname>Geny</surname><given-names>B</given-names></name><name><surname>Cunningham</surname><given-names>E</given-names></name><name><surname>Gout</surname><given-names>I</given-names></name><name><surname>Hiles</surname><given-names>I</given-names></name><name><surname>Totty</surname><given-names>NF</given-names></name><name><surname>Truong</surname><given-names>O</given-names></name><name><surname>Hsuan</surname><given-names>JJ</given-names></name></person-group><article-title>Phospholipase D: a downstream effector of ARF in granulocytes</article-title><source>Science</source><year>1994</year><volume>263</volume><fpage>523</fpage><lpage>526</lpage><pub-id pub-id-type="pmid">8290961</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Connolly</surname><given-names>CN</given-names></name><name><surname>Futter</surname><given-names>C</given-names></name><name><surname>Gibson</surname><given-names>A</given-names></name><name><surname>Hopkins</surname><given-names>CR</given-names></name><name><surname>Cutler</surname><given-names>DF</given-names></name></person-group><article-title>Transport into and out of the Golgi complex studied by transfecting cells with cDNAs encoding horseradish peroxidase</article-title><source>J Cell Biol</source><year>1994</year><volume>127</volume><fpage>641</fpage><lpage>652</lpage><pub-id pub-id-type="pmid">7962049</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="a