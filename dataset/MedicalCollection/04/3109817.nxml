ctives</article-title><source>J Clin Endocrinol Metab</source><year>2009</year><volume>94</volume><fpage>1881</fpage><lpage>2</lpage><pub-id pub-id-type="pmid">19401361</pub-id></element-citation></ref><ref id="CIT8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Limaye</surname><given-names>A</given-names></name><name><surname>Ruffolo</surname><given-names>PR</given-names></name></person-group><article-title>Propylthiouracil-induced fatal hepatic necrosis</article-title><source>Am J Gastroenterol</source><year>1987</year><volume>82</volume><fpage>152</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">3812421</pub-id></element-citation></ref><ref id="CIT9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jonas</surname><given-names>MM</given-names></name><name><surname>Eidson</surname><given-names>MS</given-names></name></person-group><article-title>Propylthiouracil hepatotoxicity: Two pediatric cases and review of the literature</article-title><source>J Pediatr Gastroenterol Nutr</source><year>1988</year><volume>7</volume><fpage>776</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">3054039</pub-id></element-citation></ref><ref id="CIT10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mihas</surname><given-names>AA</given-names></name><name><surname>Holley</surname><given-names>P</given-names></name><name><surname>Koff</surname><given-names>RS</given-names></name><name><surname>Hirschowitz</surname><given-names>BI</given-names></name></person-group><article-title>Fulminant hepatitis and lymphocyte sensitization due to propylthiouracil</article-title><source>Gastroenterology</source><year>1976</year><volume>70</volume><fpage>770</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">1261772</pub-id></element-citation></ref><ref id="CIT11"><label>11</label><element-cit