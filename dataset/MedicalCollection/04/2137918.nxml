<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="correction"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">J Exp Med</journal-id><journal-title>The Journal of Experimental Medicine</journal-title><issn pub-type="ppub">0022-1007</issn><issn pub-type="epub">1540-9538</issn><publisher><publisher-name>The Rockefeller University Press</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmc">2137918</article-id><article-id pub-id-type="publisher-id">20061839020807c</article-id><article-id pub-id-type="doi">10.1084/jem.20061839020807c</article-id><article-categories><subj-group subj-group-type="heading"><subject>Correction</subject></subj-group></article-categories><title-group><article-title>Peroxisome proliferator&#x02013;activated receptor (PPAR)&#x003b1; expression in T cells mediates gender differences in development of T cell&#x02013;mediated autoimmunity</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Dunn</surname><given-names>Shannon E.</given-names></name></contrib><contrib contrib-type="author"><name><surname>Ousman</surname><given-names>Shalina S.</given-names></name></contrib><contrib contrib-type="author"><name><surname>Sobel</surname><given-names>Raymond A.</given-names></name></contrib><contrib contrib-type="author"><name><surname>Zuniga</surname><given-names>Luis</given-names></name></contrib><contrib contrib-type="author"><name><surname>Baranzini</surname><given-names>Sergio E.</given-names></name></contrib><contrib contrib-type="author"><name><surname>Youssef</surname><given-names>Sawsan</given-names></name></contrib><contrib contrib-type="author"><name><surname>Crowell</surname><given-names>Andrea</given-names></name></contrib><contrib contrib-type="author"><name><surname>Loh</surname><given-names>John</given-names></name></contrib><contrib contrib-type="author"><name><surname>Oksenberg</surname><given-names>Jorge</given-names></name></contrib><contrib contrib-type="author"><name><surname>Steinman</surname><given-names>Lawrence</given-names></name></contrib></contrib-group><pub-date pub-type="ppub"><day>19</day><month>3</month><year>2007</year></pub-date><volume>204</volume><issue>3</issue><fpage>693</fpage><lpage>693</lpage><permissions><copyright-statement>Copyright &#x000a9; 2007, The Rockefeller University Press</copyright-statement></permissions><self-uri xlink:title="pdf" xlink:href="jem2040693.pdf"/></article-meta></front><body><p>Vol. 204, No. 2, February 19, 2007. Pages <related-article related-article-type="corrected-article" vol="204" page="321" id="N0x1d793e0N0x3c15a50" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="17261635" ext-link-type="pubmed">321&#x02013;330</related-article></p><p>Please note that a typographical error appeared in the online early release version of this article. The current html, pdf, and print versions appear correctly. For reference, the correction appears below.</p><p>In the first sentence of the Table I legend, &#x0201c;SEN&#x0201d; should have read &#x0201c;SEM.&#x0201d; The corrected sentence appears below:</p><p>&#x0201c;Values are means (SEM).&#x0201d;</p></body></article>