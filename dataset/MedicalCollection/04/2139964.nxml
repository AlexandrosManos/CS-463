e>721</lpage><pub-id pub-id-type="pmid">2111733</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>DeBello</surname><given-names>WM</given-names></name><name><surname>O'Connor</surname><given-names>V</given-names></name><name><surname>Dresbach</surname><given-names>T</given-names></name><name><surname>Whiteheart</surname><given-names>SW</given-names></name><name><surname>Wang</surname><given-names>SS-H</given-names></name><name><surname>Schweizer</surname><given-names>FE</given-names></name><name><surname>Betz</surname><given-names>H</given-names></name><name><surname>Rothman</surname><given-names>JE</given-names></name><name><surname>Augustine</surname><given-names>GJ</given-names></name></person-group><article-title>SNAP-mediated protein-protein interactions essential for neurotransmitter release</article-title><source>Nature</source><year>1995</year><volume>373</volume><fpage>626</fpage><lpage>630</lpage><pub-id pub-id-type="pmid">7854421</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Diaz</surname><given-names>R</given-names></name><name><surname>Mayorga</surname><given-names>LS</given-names></name><name><surname>Weidman</surname><given-names>PJ</given-names></name><name><surname>Rothman</surname><given-names>JE</given-names></name><name><surname>Stahl</surname><given-names>PD</given-names></name></person-group><article-title>Vesicle fusion following receptor-mediated endocytosis requires a protein active in Golgi transport</article-title><source>Nature</source><year>1989</year><volume>339</volume><fpage>398</fpage><lpage>400</lpage><pub-id pub-id-type="pmid">2725659</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Glick</surname><given-names>BS</given-names></name><name><surname>Rothman</surname><given-names>JE</given-names></