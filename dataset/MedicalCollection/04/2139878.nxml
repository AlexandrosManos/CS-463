-group person-group-type="author"><name><surname>Fiedler</surname><given-names>K</given-names></name><name><surname>Veit</surname><given-names>M</given-names></name><name><surname>Stammes</surname><given-names>MA</given-names></name><name><surname>Rothman</surname><given-names>JE</given-names></name></person-group><article-title>Bimodal interaction of coatomer with the p24 family of putative cargo receptors</article-title><source>Science  (Wash DC)</source><year>1996</year><volume>273</volume><fpage>1396</fpage><lpage>1399</lpage><pub-id pub-id-type="pmid">8703076</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gaynor</surname><given-names>E</given-names></name><name><surname>Emr</surname><given-names>SD</given-names></name></person-group><article-title>COPI-dependent anterograde transport: cargo-selective ER-to-Golgi protein transport in yeast COPI mutants</article-title><source>J Cell  Biol</source><year>1997</year><volume>136</volume><fpage>789</fpage><lpage>802</lpage><pub-id pub-id-type="pmid">9049245</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Itin</surname><given-names>C</given-names></name><name><surname>Schindler</surname><given-names>R</given-names></name><name><surname>Hauri</surname><given-names>H-P</given-names></name></person-group><article-title>Targeting of protein ERGIC-53 to  the ER/ERGIC/<italic>cis</italic>-Golgi recycling pathway</article-title><source>J Cell Biol</source><year>1995</year><volume>131</volume><fpage>57</fpage><lpage>67</lpage><pub-id pub-id-type="pmid">7559786</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Itin</surname><given-names>C</given-names></name><name><surname>Roche</surname><given-names>A-C</given-names></name><name><surname>Monsigny</surname><given-names>M</given-names></name