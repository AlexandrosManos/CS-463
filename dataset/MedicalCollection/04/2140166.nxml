 activity</article-title><source>Proc Natl Acad Sci USA</source><year>1994</year><volume>91</volume><fpage>28</fpage><lpage>32</lpage><pub-id pub-id-type="pmid">8278379</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chromczynski</surname><given-names>P</given-names></name><name><surname>Sacchi</surname><given-names>N</given-names></name></person-group><article-title>Single-step method of RNA isolation by acid guanidinium thiocyanate-phenol-chloroform extraction</article-title><source>Anal Biochem</source><year>1987</year><volume>162</volume><fpage>156</fpage><lpage>159</lpage><pub-id pub-id-type="pmid">2440339</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cordle</surname><given-names>SR</given-names></name><name><surname>Donald</surname><given-names>R</given-names></name><name><surname>Read</surname><given-names>MA</given-names></name><name><surname>Hawiger</surname><given-names>J</given-names></name></person-group><article-title>Lipopolysaccharide induces phosphorylation of MAD3 and activation of c-rel and related NF-&#x003ba;B proteins in human monocytic THP-1 cells</article-title><source>J Biol Chem</source><year>1993</year><volume>268</volume><fpage>11803</fpage><lpage>11810</lpage><pub-id pub-id-type="pmid">8505309</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Diaz-Meco</surname><given-names>MT</given-names></name><name><surname>Berra</surname><given-names>E</given-names></name><name><surname>Municio</surname><given-names>MM</given-names></name><name><surname>Sanz</surname><given-names>L</given-names></name><name><surname>Lozano</surname><given-names>J</given-names></name><name><surname>Dominguez</surname><given-names>I</given-names></name><name><surname>Diaz-Golpe</surname><given-names>V</given-names></name><name><su