-loc>Aberdeen</publisher-loc><publisher-name>Aberdeen University Press</publisher-name></citation></ref><ref id="R11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Frazer</surname><given-names>WM</given-names></name></person-group><source>Duncan of Liverpool: being an account of the work of Dr W.H. Duncan, Medical Officer of Health of Liverpool, 1847-1863</source><year>1947</year><publisher-loc>London</publisher-loc><publisher-name>Hamish Hamilton</publisher-name></citation></ref><ref id="R12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Brimblecombe</surname><given-names>P</given-names></name></person-group><source>The Big Smoke: A History of Air Pollution in London since Medieval Times</source><year>1987</year><publisher-loc>New York</publisher-loc><publisher-name>Metheun</publisher-name></citation></ref><ref id="R13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Mayhew</surname><given-names>H</given-names></name></person-group><source>London Labor and the London Poor</source><year>1851</year><publisher-loc>London</publisher-loc><publisher-name>Woodfall</publisher-name></citation></ref><ref id="R14"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hutchinson</surname><given-names>T</given-names></name></person-group><source>The Complete Poetical Works of Percy Bysshe Shelley</source><year>1947</year><publisher-loc>Oxford</publisher-loc><publisher-name>Oxford University Press</publisher-name></citation></ref><ref id="R15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wohl</surname><given-names>A</given-names></name></person-group><source>Endangered Lives: Public Health in Victorian Britain</source><year>1983</year><publisher-loc>Cambridge</publisher-loc><publisher-name>Harvard University Press</publisher-name></citation></ref><ref id="R16"><citation citation-type="j