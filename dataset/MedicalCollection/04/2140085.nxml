nal"><person-group person-group-type="author"><name><surname>Schechter</surname><given-names>M</given-names></name><name><surname>Zajdenverg</surname><given-names>R</given-names></name><name><surname>Falco</surname><given-names>G</given-names></name><name><surname>Barnes</surname><given-names>GL</given-names></name><name><surname>Faulhaber</surname><given-names>JC</given-names></name><etal/></person-group><year>2006</year><article-title>Weekly rifapentine/isoniazid or daily rifampin/pyrazinamide for latent tuberculosis in household contacts</article-title><source>Am J Respir Crit Care Med</source><volume>173</volume><fpage>922</fpage><lpage>926</lpage><pub-id pub-id-type="pmid">16474028</pub-id></citation></ref><ref id="pmed-0040344-b021"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nuermberger</surname><given-names>EL</given-names></name><name><surname>Yoshimatsu</surname><given-names>T</given-names></name><name><surname>Tyagi</surname><given-names>S</given-names></name><name><surname>O'Brien</surname></name><name><surname>Vernon</surname><given-names>A</given-names></name><etal/></person-group><year>2004</year><article-title>Moxifloxacin-containing regimen greatly reduces time to culture conversion in murine tuberculosis</article-title><source>Am J Respir Crit Care Med</source><volume>169</volume><fpage>421</fpage><lpage>426</lpage><pub-id pub-id-type="pmid">14578218</pub-id></citation></ref><ref id="pmed-0040344-b022"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nuermberger</surname><given-names>EL</given-names></name><name><surname>Yoshimatsu</surname><given-names>T</given-names></name><name><surname>Tyagi</surname><given-names>S</given-names></name><name><surname>Williams</surname><given-names>K</given-names></name><name><surname>Rosenthal</surname><given-names>I</given-names></name><etal/></person-group><year>2004</year><article-title>Moxifloxacin-containing regimens of reduced duration produce a stable cure in murine tuberculosis</article-title><source>Am J Respir Crit Care Med</source><volume>170</volume><fpage>1131</fpage><lpage>1134</lpage><pub-id pub-id-type="pmid">15306535</pub-id></citation></ref><ref id="pmed-0040344-b023"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Grosset</surname><given-names>J</given-names></name><name><surname>Ji</surname><given-names>B</given-names></name></person-group><year>1998</year><article-title>Experimental chemotherapy of mycobacterial diseases</article-title><person-group person-group-type="editor"><name><surname>Gangadharam</surname><given-names>PRJ</given-names></name><name><surname>Jenkins</surname><given-names>PA</given-names></name></person-group><source>Mycobacteria II chemotherapy</source><publisher-loc>New York</publisher-loc><publisher-name>Chapman &#x00026; Hall</publisher-name><fpage>51</fpage><lpage>97</lpage></citation></ref><ref id="pmed-0040344-b024"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rosenthal</surname><given-names>I</given-names></name><name><surname>Williams</surname><given-names>K</given-names></name><name><surname>Tyagi</surname><given-names>S</given-names></name><name><surname>Vernon</surname><given-names>A</given-names></name><name><surname>Peloquin</surname><given-names>C</given-names></name><etal/></person-group><year>2005</year><article-title>Weekly moxifloxacin and rifapentine is more active than the Denver regimen in murine tuberculosis</article-title><source>Am J Respir Crit Care Med</source><volume>172</volume><fpage>1457</fpage><lpage>1462</lpage><pub-id pub-id-type="pmid">16141439</pub-id></citation></ref><ref id="pmed-0040344-b025"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heifets</surname><given-names>L</given-names></name><name><surname>Lindholm-Levy</surname><given-names>P</given-names></name><name><surname>Flory</s