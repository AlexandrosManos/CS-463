/year><volume>676</volume><fpage>25</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">7796176</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><collab>Dal Canto, M.C., and M.E. Gurney</collab><article-title>A low expressor line of transgenic  mice carrying a mutant human Cu,Zn superoxide dismutase (<italic>SOD1)</italic>gene develops pathological changes that most closely resemble those in human amyotrophic lateral sclerosis</article-title><source>Acta Neuropathol</source><year>1997</year><volume>93</volume><fpage>537</fpage><lpage>550</lpage><pub-id pub-id-type="pmid">9194892</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>de Waegh</surname><given-names>SM</given-names></name><name><surname>Lee</surname><given-names>VM-Y</given-names></name><name><surname>Brady</surname><given-names>ST</given-names></name></person-group><article-title>Local modulation of neurofilament phosphorylation, axonal caliber, and slow axonal transport by myelinating Schwann cells</article-title><source>Cell</source><year>1992</year><volume>68</volume><fpage>451</fpage><lpage>463</lpage><pub-id pub-id-type="pmid">1371237</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eyer</surname><given-names>J</given-names></name><name><surname>Peterson</surname><given-names>A</given-names></name></person-group><article-title>Neurofilament-deficient axons and perikaryal aggregates in viable transgenic mice expressing a neurofilament-&#x003b2;-galactosidase fusion protein</article-title><source>Neuron</source><year>1994</year><volume>12</volume><fpage>389</fpage><lpage>405</lpage><pub-id pub-id-type="pmid">8110465</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Figlewicz</surname><given-names>DA</given-names></name><name><surname>Krizus</surna