<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">J Exp Med</journal-id><journal-title>The Journal of Experimental Medicine</journal-title><issn pub-type="ppub">0022-1007</issn><issn pub-type="epub">1540-9538</issn><publisher><publisher-name>The Rockefeller University Press</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">5033420</article-id><article-id pub-id-type="pmc">2139191</article-id><article-categories><subj-group subj-group-type="heading"><subject>Article</subject></subj-group></article-categories><title-group><article-title>EFFECT OF COLCHICINE AND VINBLASTINE ON THE TOPOGRAPHICAL SEPARATION OF MEMBRANE FUNCTIONS</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Ukena</surname><given-names>Thomas E.</given-names></name></contrib><contrib contrib-type="author"><name><surname>Berlin</surname><given-names>Richard D.</given-names></name></contrib></contrib-group><aff id="N0x1c59f90N0x39ec818">From the Department of Physiology, Harvard Medical School, Boston, Massachusetts 02115</aff><pub-date pub-type="ppub"><day>1</day><month>7</month><year>1972</year></pub-date><volume>136</volume><issue>1</issue><fpage>1</fpage><lpage>7</lpage><history><date date-type="received"><day>26</day><month>3</month><year>1972</year></date></history><permissions><copyright-statement>Copyright &#x000a9; 1972 by The Rockefeller University Press</copyright-statement></permissions><abstract><p> The topographical separation of membrane functions into phagocytic and transport areas, inferred from physiological studies, is not demonstrable in cells treated with colchicine and vinblastine, alkaloids which bind to microtubular proteins. </p></abstract></article-meta></front></article>