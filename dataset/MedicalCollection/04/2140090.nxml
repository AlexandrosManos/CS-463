>e141</fpage><comment>doi:<ext-link ext-link-type="doi" xlink:href="10.1371/journal.pgen.0030141">10.1371/journal.pgen.0030141</ext-link></comment><pub-id pub-id-type="pmid">17722984</pub-id></citation></ref><ref id="pbio-0050333-b022"><citation citation-type="journal"><person-group><name><surname>Dresser</surname><given-names>ME</given-names></name><name><surname>Ewing</surname><given-names>DJ</given-names></name><name><surname>Conrad</surname><given-names>MN</given-names></name><name><surname>Dominguez</surname><given-names>AM</given-names></name><name><surname>Barstead</surname><given-names>R</given-names></name><etal/></person-group><year>1997</year><article-title>DMC1 functions in a Saccharomyces cerevisiae meiotic pathway that is largely independent of the RAD51 pathway</article-title><source>Genetics</source><volume>147</volume><fpage>533</fpage><lpage>544</lpage><pub-id pub-id-type="pmid">9335591</pub-id></citation></ref><ref id="pbio-0050333-b023"><citation citation-type="journal"><person-group><name><surname>Blat</surname><given-names>Y</given-names></name><name><surname>Protacio</surname><given-names>RU</given-names></name><name><surname>Hunter</surname><given-names>N</given-names></name><name><surname>Kleckner</surname><given-names>N</given-names></name></person-group><year>2002</year><article-title>Physical and functional interactions among basic chromosome organizational features govern early steps of meiotic chiasma formation</article-title><source>Cell</source><volume>111</volume><fpage>791</fpage><lpage>802</lpage><pub-id pub-id-type="pmid">12526806</pub-id></citation></ref><ref id="pbio-0050333-b024"><citation citation-type="journal"><person-group><name><surname>Borde</surname><given-names>V</given-names></name><name><surname>Goldman</surname><given-names>AS</given-names></name><name><surname>Lichten</surname><given-names>M</given-names></name></person-group><year>2000</year><article-title>Direct coupling between meiotic DNA replication and recombi