 citation query: 'Int J Cancer||118|405||bib16|'--><pub-id pub-id-type="pmid">16052519</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ordonez</surname><given-names>NG</given-names></name></person-group><article-title>The immunohistochemical diagnosis of mesothelioma: a comparative study of epithelioid mesothelioma and lung adenocarcinoma</article-title><source>Am J Surg Pathol</source><year>2003</year><volume>27</volume><fpage>1031</fpage><lpage>1051</lpage><!--PubMed citation query: 'Am J Surg Pathol||27|1031||bib17|'--><pub-id pub-id-type="pmid">12883236</pub-id></citation></ref><ref id="bib18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Peterson</surname><given-names>JA</given-names></name><name><surname>Couto</surname><given-names>JR</given-names></name><name><surname>Taylor</surname><given-names>MR</given-names></name><name><surname>Ceriani</surname><given-names>RL</given-names></name></person-group><article-title>Selection of tumor-specific epitopes on target antigens for radioimmunotherapy of breast cancer</article-title><source>Cancer Res</source><year>1995</year><volume>55</volume><fpage>5847s</fpage><lpage>5851s</lpage><!--PubMed citation query: 'Cancer Res||55|5847s||bib18|'--><pub-id pub-id-type="pmid">7493358</pub-id></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rakha</surname><given-names>EA</given-names></name><name><surname>Boyce</surname><given-names>RW</given-names></name><name><surname>Abd El-Rehim</surname><given-names>D</given-names></name><name><surname>Kurien</surname><given-names>T</given-names></name><name><surname>Green</surname><given-names>AR</given-names></name><name><surname>Paish</surname><given-names>EC</given-names></name><name><surname>Robertson</surname><given-names>JF</given-names></name><name><surname>Ellis</surname><given-nam