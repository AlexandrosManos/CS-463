 citation-type="confproc"><person-group person-group-type="author"><name><surname>Smaragdis</surname><given-names>P</given-names></name><name><surname>Raj</surname><given-names>B</given-names></name><name><surname>Shashanka</surname><given-names>M</given-names></name></person-group><article-title>A probabilistic latent variable model for acoustic modeling</article-title><conf-name>In: Proceedings of the Advances in Models for Acoustic Processing Workshop (NIPS '06)</conf-name><conf-date>December 2006</conf-date><conf-loc>Whistler, BC, Canada</conf-loc></citation></ref><ref id="B17"><label>17</label><citation citation-type="confproc"><person-group person-group-type="author"><name><surname>Shashanka</surname><given-names>M</given-names></name><name><surname>Raj</surname><given-names>B</given-names></name><name><surname>Smaragdis</surname><given-names>P</given-names></name></person-group><article-title>Sparse overcomplete latent variable decomposition of counts data</article-title><conf-name>In: Proceedings of the 21th Annual Conference on Neural Information Processing Systems (NIPS '07)</conf-name><conf-date>December 2007</conf-date><conf-loc>Vancouver, BC, Canada</conf-loc></citation></ref><ref id="B18"><label>18</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Shashanka</surname><given-names>M</given-names></name></person-group><source><italic>Latent variable framework for modeling and separating single-channel acoustic sources</italic></source><year>2007</year><publisher-loc>Boston, Mass, USA</publisher-loc><publisher-name>Ph.D. dissertation, Boston University</publisher-name></citation></ref><ref id="B19"><label>19</label><citation citation-type="confproc"><person-group person-group-type="author"><name><surname>Gaussier</surname><given-names>E</given-names></name><name><surname>Goutte</surname><given-names>C</given-names></name></person-group><article-title>Relation between plsa and nmf and implications</article-title><