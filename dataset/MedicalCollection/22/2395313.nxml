e>Ethnicity Health</source><year>1999</year><volume>4</volume><supplement>1&#x02013;2</supplement><fpage>83</fpage><lpage>92</lpage><!--PubMed citation query: 'Ethnicity Health||4|83||bib12|'--><pub-id pub-id-type="pmid">10887464</pub-id></citation></ref><ref id="bib13"><citation citation-type="book"><person-group person-group-type="author"><collab>Health Survey for England</collab></person-group><article-title/><source>The Health of Minority Ethnic subgroups 1999 Volume 1: Findings</source><year>2001</year><publisher-name>London: The Stationary Office</publisher-name></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hilakivi-Clarke</surname><given-names>L</given-names></name><name><surname>Forsen</surname><given-names>T</given-names></name><name><surname>Eriksson</surname><given-names>JG</given-names></name><name><surname>Luoto</surname><given-names>R</given-names></name><name><surname>Tuomilehto</surname><given-names>J</given-names></name><name><surname>Osmond</surname><given-names>D</given-names></name><name><surname>Barker</surname><given-names>DJ</given-names></name></person-group><article-title>Tallness and overweight during childhood have opposing effects on breast cancer risk</article-title><source>Br J Cancer</source><year>2001</year><volume>85</volume><fpage>1680</fpage><lpage>1684</lpage><!--PubMed citation query: 'Br J Cancer||85|1680||bib14|'--><pub-id pub-id-type="pmid">11742488</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hoare</surname><given-names>T</given-names></name></person-group><article-title>Breast screening and ethnic minorities</article-title><source>Br J Cancer</source><year>1996</year><volume>74</volume><supplement>Suppl 29</supplement><fpage>S38</fpage><lpage>S41</lpage><!--PubMed citation query: 'Br J Cancer||74|S38||bib15|'--></citation></ref><ref id="bib16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Holland</surname><given-names>B</given-names></name><name><surname>Welch</surname><given-names>AA</given-names></name><name><surname>Unwin</surname><given-names>ID</given-names></name><name><surname>Paul</surname><given-names>AA</given-names></name><name><surname>Southgate</surname><given-names>DAT</given-names></name></person-group><article-title/><source>McCance and Widdowson's the composition of foods</source><year>1995</year><publisher-name>Cambridge: Royal Society of Chemistry</publisher-name>5th ed</citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>Z</given-names></name><name><surname>Willett</surname><given-names>WC</given-names></name><name><surname>Colditz</surname><given-names>GA</given-names></name><name><surname>Hunter</surname><given-names>DJ</given-names></name><name><surname>Manson</surname><given-names>JE</given-names></name><name><surname>Rosner</surname><given-names>B</given-names></name><name><surname>Speizer</surname><given-names>FE</given-names></name><name><surname>Hankinson</surname><given-names>SE</given-names></name></person-group><article-title>Waist circumference, waist&#x02009;:&#x02009;hip ratio, and risk of breast cancer in the Nurses' Health Study</article-title><source>Am J Epidemiol</source><year>1999</year><volume>150</volume><fpage>1316</fpage><lpage>1324</lpage><!--PubMed citation query: 'Am J Epidemiol||150|1316||bib17|'--><pub-id pub-id-type="pmid">10604774</pub-id></citation></ref><ref id="bib18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Judd</surname><given-names>PA</given-names></name><name><surname>Kassam-Khamis</surname><given-names>T</given-names></name><name><surname>Thomas</surname><given-names>JE</given-names></name></person-group><article-title/><source>The Composition and Nutrient Content of Foods Commonly Consumed by South Asians in the UK</source><year>2000</year><publisher-name>London: The Agha Khan Health Board</publisher-name></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jussawalla</surname><given-names>DJ</given-names></name><name><surname>Yeole</surname><given-names>BB</given-names></name><name><surname>Natekar</surname><given-names>MV</given-names></name></person-group><article-title>Cancer in Indian Moslems</article-title><source>Cancer</source><year>1985</year><volume>55</volume><fpage>1149</fpage><lpage>1158</lpage><!--PubMed citation query: 'Cancer||55|1149||bib19|'--><pub-id pub-id-type="pmid">3967197</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nanchahal</surname><given-names>K</given-names></name><name><surname>Mangtani</surname><given-names>P</given-names></name><name><surname>Alston</surname><given-names>M</given-names></name><name><surname>dos Santos Silva</surname><given-names>I</given-names></name></person-group><article-title>Development and validation of a South Asian Names and Group Recognition Algorithm (SANGRA) for use in British health-related datasets</article-title><source>J Publ Health Med</source><year>2001</year><volume>23</volume><fpage>278</fpage><lpage>285</lpage><!--PubMed citation query: 'J Publ Health Med||23|278||bib20|'--></citation></ref><ref id="bib21"><citation citation-type="book"><person-group person-group-type="author"><collab>Nutrition Systems</collab></person-group><article-title/><source>CompEat, version 5</source><year>1995</year><publisher-name>London: Carlson Bengston Consultants Limited</publisher-name></citation></ref><ref id="bib22"><citation citation-type="book"><person-group person-group-type="author"><collab>Office for National Statistics</collab></person-group><article-title/><source>Census 2001 National Report for England and Wales National Statistics</so