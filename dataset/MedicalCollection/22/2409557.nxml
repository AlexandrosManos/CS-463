e><surname>Young</surname><given-names>RC</given-names></name><name><surname>Berard</surname><given-names>CW</given-names></name><name><surname>Moxley</surname><given-names>JH</given-names></name><name><surname>III</surname></name><name><surname>Frei</surname><given-names>E</given-names></name><name><surname>III</surname></name><name><surname>Carbone</surname><given-names>PP</given-names></name><name><surname>Canellos</surname><given-names>GP</given-names></name></person-group><article-title>Curability of advanced Hodgkin's disease with chemotherapy. Long-term follow-up of MOPP-treated patients at the National Cancer Institute</article-title><source>Ann Intern Med</source><year>1980</year><volume>92</volume><fpage>587</fpage><lpage>595</lpage><!--PubMed citation query: 'Ann Intern Med||92|587||bib14|'--><pub-id pub-id-type="pmid">6892984</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dietrich</surname><given-names>PY</given-names></name><name><surname>Henry-Amar</surname><given-names>M</given-names></name><name><surname>Cosset</surname><given-names>JM</given-names></name><name><surname>Bodis</surname><given-names>S</given-names></name><name><surname>Bosq</surname><given-names>J</given-names></name><name><surname>Hayat</surname><given-names>M</given-names></name></person-group><article-title>Second primary cancers in patients continuously disease-free from Hodgkin's disease: a protective role for the spleen</article-title><source>Blood</source><year>1994</year><volume>84</volume><fpage>1209</fpage><lpage>1215</lpage><!--PubMed citation query: 'Blood||84|1209||bib15|'--><pub-id pub-id-type="pmid">8049435</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Diller</surname><given-names>L</given-names></name><name><surname>Medeiros Nancarrow</surname><given-names>C</given-names></name><name><surname>Shaffer</su