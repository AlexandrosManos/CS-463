ce><year>1994</year><volume>1218</volume><fpage>366</fpage><lpage>374</lpage><pub-id pub-id-type="pmid">7519445</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Su</surname><given-names>ZH</given-names></name><name><surname>Sato</surname><given-names>Y</given-names></name><name><surname>Yamashita</surname><given-names>O</given-names></name></person-group><article-title>Purification, cDNA cloning and Northern blot analysis of trehalase of pupae midgut of the silkworm, <italic>Bombyx mori</italic></article-title><source>Biochim Biophys Acta</source><year>1993</year><volume>1173</volume><fpage>217</fpage><lpage>224</lpage><pub-id pub-id-type="pmid">7916633</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Su</surname><given-names>ZH</given-names></name><name><surname>Itani</surname><given-names>Y</given-names></name><name><surname>Yamashita</surname><given-names>O</given-names></name></person-group><article-title>Structure of trehalase gene of the silkworm, <italic>Bombyx mori </italic>and phylogenic relationship of trelalases</article-title><source>Nihon Sanshigaku Zasshi</source><year>1997</year><volume>66</volume><fpage>457</fpage><lpage>465</lpage><ext-link ext-link-type="uri" xlink:href="http://www.fao.org/agris/search/display.do?f=./2001/v2711/JP1998002056.xml;JP1998002056"/></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kramer</surname><given-names>KJ</given-names></name><name><surname>Koga</surname><given-names>D</given-names></name></person-group><article-title>Insect chitin: physical state, synthesis, degradation and metabolic regulation</article-title><source>Insect Biochem</source><year>1986</year><volume>16</volume><fpage>851</fpage><lpage>877</lpage><pub-id pub-id-type="doi">10.1016/0020-1790(86)90059-4</pub-id></citation></re