;</td><td align="char" valign="top" char="." charoff="50">450</td><td align="char" valign="top" char="." charoff="50">188</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">58</td><td align="char" valign="top" char="." charoff="50">219</td><td align="char" valign="top" char="." charoff="50">234</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">113</td><td align="char" valign="top" char="." charoff="50">184</td><td align="char" valign="top" char="." charoff="50">213</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x0003e;1.5&#x02009;cm</td><td align="char" valign="top" char="." charoff="50">810</td><td align="char" valign="top" char="." charoff="50">230</td><td align="char" valign="top" char="." charoff="50">0.007</td><td align="char" valign="top" char="." charoff="50">785</td><td align="char" valign="top" char="." charoff="50">386</td><td align="char" valign="top" char="." charoff="50">0.127</td><td align="char" valign="top" char="." charoff="50">101</td><td align="char" valign="top" char="." charoff="50">446</td><td align="char" valign="top" char="." charoff="50">435</td><td align="char" valign="top" char="." charoff="50">0.6</td><td align="char" valign="top" char="." charoff="50">199</td><td align="char" valign="top" char="." charoff="50">332</td><td align="char" valign="top" char="." charoff="50">466</td><td align="char" valign="top" char="." charoff="50">0.183</td></tr><tr><td align="left" valign="top" charoff="50">Total</td><td align="char" valign="top" char="." charoff="50">1259</td><td align="char" valign="top" char="." charoff="50">318</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">1235</td><td align="char" valign="top" char="." charoff="50">574</td><td align="left" valign="top" charoff="50">&#x00