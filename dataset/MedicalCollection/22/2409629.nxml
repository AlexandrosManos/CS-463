n="top" char="." charoff="50">&#x02014;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" char="." charoff="50">&#x02014;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" char="." charoff="50">&#x02014;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="11" align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="right" valign="top" charoff="50">paternal</td><td align="left" valign="top" charoff="50">non-smoker</td><td align="right" valign="top" char="." charoff="50">1975</td><td align="right" valign="top" char="." charoff="50">2267</td><td align="left" valign="top" char="." charoff="50">1.0</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" char="." charoff="50">1.0</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" char="." charoff="50">1.0</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">smoker</td><td align="right" valign="top" char="." charoff="50">3601</td><td align="right" valign="top" char="." charoff="50">3359</td><td align="left" valign="top" char="." charoff="50">1.23<sup>&#x0002a;&#x0002a;&#x0002a;</sup></td><td align="center" valign="top" char="." charoff="50">(1.13 to 1.33)</td><td align="left" valign="top" char="." charoff="50">1.24<sup>&#x0002a;&#x0002a;&#x0002a;</sup></td><td align="center" valign="top" char="." charoff="50">(1.14 to 1.35)</td><td align="left" valign="top" char="." charoff="50">1.27<sup>&#x0002a;&#x0002a;&#x0002a;</sup></td><td align="center" valign="top" char="." charoff="50">(1.17 to 1.38)</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charo