" valign="top" charoff="50">15.0 (3)</td><td align="center" valign="top" charoff="50">15.0 (3)</td><td align="center" valign="top" charoff="50">13.4 (12)</td><td align="center" valign="top" charoff="50">20.2 (18)</td></tr><tr><td align="char" valign="top" char="." charoff="50">3</td><td align="center" valign="top" charoff="50">29.0 (9)</td><td align="center" valign="top" charoff="50">29.0 (9)</td><td align="center" valign="top" charoff="50">54.5 (6)</td><td align="center" valign="top" charoff="50">54.5 (6)</td><td align="center" valign="top" charoff="50">15.0 (3)</td><td align="center" valign="top" charoff="50">15.0 (3)</td><td align="center" valign="top" charoff="50">19.1 (17)</td><td align="center" valign="top" charoff="50">21.3 (19)</td></tr><tr><td align="char" valign="top" char="." charoff="50">4</td><td align="center" valign="top" charoff="50">29.0 (9)</td><td align="center" valign="top" charoff="50">32.2 (10)</td><td align="center" valign="top" charoff="50">54.5 (6)</td><td align="center" valign="top" charoff="50">54.5 (6)</td><td align="center" valign="top" charoff="50">15.0 (3)</td><td align="center" valign="top" charoff="50">20.0 (4)</td><td align="center" valign="top" charoff="50">16.8 (15)</td><td align="center" valign="top" charoff="50">19.1 (17)</td></tr><tr><td align="char" valign="top" char="." charoff="50">5</td><td align="center" valign="top" charoff="50">41.9 (13)</td><td align="center" valign="top" charoff="50">48.3 (15)</td><td align="center" valign="top" charoff="50">63.6 (7)</td><td align="center" valign="top" charoff="50">63.6 (7)</td><td align="center" valign="top" charoff="50">30.0 (6)</td><td align="center" valign="top" charoff="50">40.0 (8)</td><td align="center" valign="top" charoff="50">10.1 (9)</td><td align="center" valign="top" charoff="50">12.3 (11)</td></tr><tr><td align="char" valign="top" char="." charoff="50">6</td><td align="center" valign="top" charoff="50">45.1 (14)</td><td align="center" valign="top" charoff="50">45.1 (14)</