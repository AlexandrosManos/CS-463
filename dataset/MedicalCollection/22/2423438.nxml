<surname>Leader</surname><given-names>J</given-names></name></person-group><article-title>A comprehensive vertebrate phylogeny using vector representation of protein sequences from whole genomes</article-title><source>Mol Biol Evol</source><year>2002</year><volume>19</volume><fpage>554</fpage><lpage>562</lpage><pub-id pub-id-type="pmid">11919297</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wu</surname><given-names>X</given-names></name><name><surname>Cai</surname><given-names>Z</given-names></name><name><surname>Wan</surname><given-names>X</given-names></name><name><surname>Hoang</surname><given-names>T</given-names></name><name><surname>Goebel</surname><given-names>R</given-names></name><name><surname>Lin</surname><given-names>G</given-names></name></person-group><article-title>Nucleotide composition string selection in HIV-1 subtyping using whole genomes</article-title><source>Bioinformatics</source><year>2007</year><volume>23</volume><fpage>1744</fpage><lpage>1752</lpage><pub-id pub-id-type="pmid">17495995</pub-id><pub-id pub-id-type="doi">10.1093/bioinformatics/btm248</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brendel</surname><given-names>V</given-names></name><name><surname>Beckmann</surname><given-names>JS</given-names></name><name><surname>Trifonov</surname><given-names>EN</given-names></name></person-group><article-title>Linguistics of nucleotide sequences: Morphology and comparison of vocabularies</article-title><source>J Biomol Struct Dyn</source><year>1986</year><volume>4</volume><fpage>11</fpage><lpage>21</lpage><pub-id pub-id-type="pmid">3078230</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gentleman</surname><given-names>JF</given-names></name><name><surname>Mullin</surname><given-names>RC</given-names></name></person-group><article-title>The distribution of the frequency of occurrence of nucleotide subsequence, based on their overlap capability</article-title><source>Biometrics</source><year>1989</year><volume>45</volume><fpage>35</fpage><lpage>52</lpage><pub-id pub-id-type="pmid">2720059</pub-id><pub-id pub-id-type="doi">10.2307/2532033</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wu</surname><given-names>TJ</given-names></name><name><surname>Burke</surname><given-names>JP</given-names></name><name><surname>Davison</surname><given-names>DB</given-names></name></person-group><article-title>A measure of DNA sequence dissimilarity based on Mahalanobis distance between frequencies of words</article-title><source>Biometrics</source><year>1997</year><volume>53</volume><fpage>1431</fpage><lpage>1439</lpage><pub-id pub-id-type="pmid">9423258</pub-id><pub-id pub-id-type="doi">10.2307/2533509</pub-id></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Zhang</surname><given-names>S</given-names></name><name><surname>Fang</surname><given-names>X</given-names></name><name><surname>Davis</surname><given-names>T</given-names></name><name><surname>Ruben</surname><given-names>D</given-names></name><name><surname>Lu</surname><given-names>G</given-names></name></person-group><article-title>Multidimensional scaling and model-based clustering analyses for the clade assignments of the HPAI H5N1 viruses</article-title><source>Options for the Control of Influenza VI</source><year>2007</year><publisher-name>London. Blackwell</publisher-name><comment></comment></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sege</surname><given-names>RD</given-names></name><name><surname>Saxberg</surname><given-names>BEH</given-names></name></person-group><article-title>A statistical test for comparing several nucleotide sequences</article-title><source>Nucleic Acids Research</source><year>1982</year><volume>10</volume><fpage>375</fpage><lpage>389</lpage><pub-id pub-id-type="pmid">7063406</pub-id><pub-id pub-id-type="doi">10.1093/nar/10.1.375</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arritia</surname><given-names>R</given-names></name><name><surname>Gordon</surname><given-names>L</given-names></name><name><surname>Waterman</surname><given-names>WS</given-names></name></person-group><article-title>The Erd&#x000f6;s-R&#x000e9;nyi law in distribution, for coin tossing and sequence matching</article-title><source>Annals of Statistics</source><year>1990</year><volume>18</volume><fpage>539</fpage><lpage>570</lpage><pub-id pub-id-type="doi">10.1214/aos/1176347615</pub-id></citation></ref></ref-list></back></article>