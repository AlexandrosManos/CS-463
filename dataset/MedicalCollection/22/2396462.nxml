roup person-group-type="author"><name><surname>Marti</surname><given-names>M</given-names></name><name><surname>Good</surname><given-names>RT</given-names></name><name><surname>Rug</surname><given-names>M</given-names></name><name><surname>Knuepfer</surname><given-names>E</given-names></name><name><surname>Cowman</surname><given-names>AF</given-names></name></person-group><year>2004</year><article-title>Targeting malaria virulence and remodeling proteins to the host erythrocyte.</article-title><source>Science</source><volume>306</volume><fpage>1930</fpage><lpage>1933</lpage><pub-id pub-id-type="pmid">15591202</pub-id></citation></ref><ref id="pone.0002405-Blisnick1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blisnick</surname><given-names>T</given-names></name><name><surname>Morales Betoulle</surname><given-names>ME</given-names></name><name><surname>Barale</surname><given-names>JC</given-names></name><name><surname>Uzureau</surname><given-names>P</given-names></name><name><surname>Berry</surname><given-names>L</given-names></name><etal/></person-group><year>2000</year><article-title>Pfsbp1, a Maurer's cleft Plasmodium falciparum protein, is associated with the erythrocyte skeleton.</article-title><source>Mol Biochem Parasitol</source><volume>111</volume><fpage>107</fpage><lpage>121</lpage><pub-id pub-id-type="pmid">11087921</pub-id></citation></ref><ref id="pone.0002405-Bhattacharjee1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bhattacharjee</surname><given-names>S</given-names></name><name><surname>van Ooij</surname><given-names>C</given-names></name><name><surname>Balu</surname><given-names>B</given-names></name><name><surname>Adams</surname><given-names>JH</given-names></name><name><surname>Haldar</surname><given-names>K</given-names></name></person-group><year>2008</year><article-title>Maurer's clefts of Plasmodium falciparum are secretory organelles that concentrate virulence protein reporters for delivery to the host erythrocyte.</article-title><source>Blood</source><volume>111</volume><fpage>2418</fpage><lpage>2426</lpage><pub-id pub-id-type="pmid">18057226</pub-id></citation></ref><ref id="pone.0002405-LopezEstrano1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lopez-Estrano</surname><given-names>C</given-names></name><name><surname>Bhattacharjee</surname><given-names>S</given-names></name><name><surname>Harrison</surname><given-names>T</given-names></name><name><surname>Haldar</surname><given-names>K</given-names></name></person-group><year>2003</year><article-title>Cooperative domains define a unique host cell-targeting signal in Plasmodium falciparum-infected erythrocytes.</article-title><source>Proc Natl Acad Sci U S A</source><volume>100</volume><fpage>12402</fpage><lpage>12407</lpage><pub-id pub-id-type="pmid">14514891</pub-id></citation></ref><ref id="pone.0002405-FrankeFayard1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Franke-Fayard</surname><given-names>B</given-names></name><name><surname>Trueman</surname><given-names>H</given-names></name><name><surname>Ramesar</surname><given-names>J</given-names></name><name><surname>Mendoza</surname><given-names>J</given-names></name><name><surname>van der Keur</surname><given-names>M</given-names></name><etal/></person-group><year>2004</year><article-title>A Plasmodium berghei reference line that constitutively expresses GFP at a high level throughout the complete life cycle.</article-title><source>Mol Biochem Parasitol</source><volume>137</volume><fpage>23</fpage><lpage>33</lpage><pub-id pub-id-type="pmid">15279948</pub-id></citation></ref><ref id="pone.0002405-Wiser1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wiser</surname><given-names>MF</given-names><