.</article-title><source>Heart</source><volume>83</volume><fpage>394</fpage><lpage>399</lpage><pub-id pub-id-type="pmid">10722536</pub-id></citation></ref><ref id="pone.0002370-Strandberg1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Strandberg</surname><given-names>AY</given-names></name><name><surname>Strandberg</surname><given-names>TE</given-names></name><name><surname>Salomaa</surname><given-names>VV</given-names></name><name><surname>Pitkala</surname><given-names>K</given-names></name><name><surname>Miettinen</surname><given-names>TA</given-names></name></person-group><year>2004</year><article-title>Alcohol consumption, 29-y total mortality, and quality of life in men in old age.</article-title><source>Am J Clin Nutr</source><volume>80</volume><fpage>1366</fpage><lpage>1371</lpage><pub-id pub-id-type="pmid">15531688</pub-id></citation></ref><ref id="pone.0002370-Deev1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Deev</surname><given-names>A</given-names></name><name><surname>Shestov</surname><given-names>D</given-names></name><name><surname>Abernathy</surname><given-names>J</given-names></name><name><surname>Kapustina</surname><given-names>A</given-names></name><name><surname>Muhina</surname><given-names>N</given-names></name><etal/></person-group><year>1998</year><article-title>Association of alcohol consumption to morality in middle-aged U.S. and Russian men and women.</article-title><source>Ann Epidemiol</source><volume>8</volume><fpage>147</fpage><lpage>153</lpage><pub-id pub-id-type="pmid">9548999</pub-id></citation></ref><ref id="pone.0002370-Fillmore1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fillmore</surname><given-names>KM</given-names></name><name><surname>Golding</surname><given-names>JM</given-names></name><name><surname>Graves</surname><given-names>KL</given-na