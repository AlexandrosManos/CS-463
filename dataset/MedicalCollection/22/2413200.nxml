><name><surname>Horowitz</surname><given-names>M</given-names></name><name><surname>Wilner</surname><given-names>N</given-names></name><name><surname>Alvarez</surname><given-names>W</given-names></name></person-group><article-title>Impact of Event Scale: a measure of subjective stress</article-title><source>Psychosom Med</source><year>1979</year><volume>41</volume><fpage>209</fpage><lpage>18</lpage><pub-id pub-id-type="pmid">472086</pub-id></citation></ref><ref id="b9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marangell</surname><given-names>LB</given-names></name><name><surname>Martinez</surname><given-names>JM</given-names></name><name><surname>Zboyan</surname><given-names>HA</given-names></name><etal/></person-group><article-title>A double-blind, placebo-controlled study of the omega-3 fatty acid docosahexaenoic acid in the treatment of major depression</article-title><source>Am J Psychiatry</source><year>2003</year><volume>160</volume><fpage>996</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">12727707</pub-id></citation></ref><ref id="b10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nemets</surname><given-names>B</given-names></name><name><surname>Stahl</surname><given-names>Z</given-names></name><name><surname>Belmaker</surname><given-names>RH</given-names></name></person-group><article-title>Addition of omega-3 fatty acid to maintenance medication treatment for recurrent unipolar depressive disorder</article-title><source>Am J Psychiatry</source><year>2002</year><volume>159</volume><fpage>477</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">11870016</pub-id></citation></ref><ref id="b11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Plutchik</surname><given-names>R</given-names></name><name><surname>van Praag</surname><given-names>HM</given-names></name></person-group><article-title>A self-report measure of violence risk, II</article-title><source>Compr Psychiatry</source><year>1990</year><volume>31</volume><fpage>450</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">2225805</pub-id></citation></ref><ref id="b12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Solomon</surname><given-names>SD</given-names></name><name><surname>Gerrity</surname><given-names>ET</given-names></name><name><surname>Muff</surname><given-names>AM</given-names></name></person-group><article-title>Efficacy of treatments for posttraumatic stress disorder. An empirical review</article-title><source>JAMA</source><year>1992</year><volume>268</volume><fpage>633</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">1629993</pub-id></citation></ref><ref id="b13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Speilberger</surname><given-names>CD</given-names></name><name><surname>Jacobs</surname></name></person-group><person-group person-group-type="editor"><name><surname>Butcher</surname><given-names>JN</given-names></name><name><surname>Speilberger</surname><given-names>CD</given-names></name><etal/></person-group><article-title>Assessment of anger: The State-Trait Anger Scale</article-title><source>Advances in personality assessment</source><year>1983</year><volume>Volume 2</volume><publisher-loc>Hillside</publisher-loc><publisher-name>Lawrence Erlbaum Assoc</publisher-name><fpage>159</fpage><lpage>87</lpage></citation></ref><ref id="b14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stoll</surname><given-names>AL</given-names></name><name><surname>Severus</surname><given-names>WE</given-names></name><name><surname>Freeman</surname><given-names>MP</given-names></name></person-group><article-title>Omega 3 fatty acids in bipolar disorder: a preliminary double-blind, placebo-controlled trial</article-title><source>Arch Gen Psychiatry</source><year>1999</year><volume>56</volume><fpage>407</fpage><