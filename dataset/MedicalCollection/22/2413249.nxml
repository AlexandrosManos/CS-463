iven-names></name></person-group><source>Queensland Public Hospital Commission of Inquiry, Brisbane</source><year>2006</year></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Joyce</surname><given-names>C</given-names></name><name><surname>McNeil</surname><given-names>J</given-names></name><name><surname>Stoelwinder</surname><given-names>J</given-names></name></person-group><article-title>More Doctors, But Not Enough: Australian Medical Workforce Supply 2001&#x02013;2012</article-title><source>The Medical Journal of Australia</source><year>2006</year><volume>184</volume><fpage>441</fpage><pub-id pub-id-type="pmid">16646743</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schofield</surname><given-names>D</given-names></name><name><surname>Beard</surname><given-names>J</given-names></name></person-group><article-title>Baby Boomer Doctors and Nurses: Demographic Changes and Transitions to Retirement</article-title><source>The Medical Journal of Australia</source><year>2005</year><volume>183</volume><fpage>80</fpage><pub-id pub-id-type="pmid">16022613</pub-id></citation></ref><ref id="B15"><citation citation-type="other"><person-group person-group-type="author"><collab>New South Wales Department of Health</collab></person-group><article-title>Area of Need Information</article-title><ext-link ext-link-type="uri" xlink:href="http://www.health.nsw.gov.au/othp/index.html"/></citation></ref><ref id="B16"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Forster</surname><given-names>P</given-names></name></person-group><source>Queensland Health System Review &#x02013; Final Report Brisbane</source><year>2005</year></citation></ref><ref id="B17"><citation citation-type="other"><person-group person-group-type="author"><collab>Commonwealth Department of Health and Ageing</collab></person-group><source>Annual Report 2003&#x02013;2004 Canberra</source><year>2004</year></citation></ref><ref id="B18"><citation citation-type="other"><person-group person-group-type="author"><collab>Commonwealth Department of Immigration</collab></person-group><article-title>Immigration Advice for Skilled Workers</article-title><ext-link ext-link-type="uri" xlink:href="http://www.immi.gov.au/migration/skilled/advice_doc/gn_modl.htm"/></citation></ref><ref id="B19"><citation citation-type="other"><person-group person-group-type="author"><collab>Commonwealth Department of Immigration</collab></person-group><article-title>Temporary Business Visa Information</article-title><ext-link ext-link-type="uri" xlink:href="http://www.immi.gov.au/migration/temporary_business/sbs/index.htm"/></citation></ref><ref id="B20"><citation citation-type="other"><person-group person-group-type="author"><collab>Commonwealth Department of Immigration</collab></person-group><article-title>Medical Practitioners Visas</article-title><ext-link ext-link-type="uri" xlink:href="http://www.immi.gov.au/migration/mpv/index.htm"/></citation></ref><ref id="B21"><citation citation-type="other"><person-group person-group-type="author"><collab>Commonwealth Department of Immigration</collab></person-group><article-title>Occupational Trainee Visa</article-title><ext-link ext-link-type="uri" xlink:href="http://www.immi.gov.au/allforms/otv/index.htm"/></citation></ref><ref id="B22"><citation citation-type="other"><person-group person-group-type="author"><collab>Commonwealth Department of Immigration</collab></person-group><article-title>Permanent Visa Information</article-title><ext-link ext-link-type="uri" xlink:href="http://www.immi.gov.au/doctors/permanent-visas.htm"/></citation></ref><ref id="B23"><citation citation-type="other"><person-group person-group-type="author"><collab>Commonwealth Department of Health and Ageing</collab></person-group><article-title>Information for Overseas-Trained Doctors</article-title><ext-link ext-link-type="uri" xlink:href="http://www.doctorconnect.gov.au"/></citation></ref><ref id="B24"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Meagher</surname><given-names>R</given-names></name></person-group><article-title>Media Release: Medical Graduates Will Find Clinical Placements in NSW Public Health Hospitals</article-title><ext-link ext-link-type="uri" xlink:href="http://www.health.nsw.gov.au/news/2007/20071215_00.html"/><comment>release 15/12/2007</comment></citation></ref><ref id="B25"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Rowson</surname><given-names>M</given-names></name></person-group><article-title>The Brain Drain &#x02013; can it be stopped?</article-title><source>Health Exchange 10/5/2006</source><ext-link ext-link-type="uri" xlink:href="http://www.medact.org/content/Rowson%20-%20IHE%20brain%20drain.pdf"/></citation></ref><ref id="B26"><citation citation-type="other"><person-group person-group-type="author"><collab>The World Health Organization</collab></person-group><article-title>International Migration, Health and Human Rights</article-title><source>In Human Rights Publication Series Issue No 4 Geneva</source><year>2003</year></citation></ref><ref id="B27"><citation citation-type="other"><person-group person-group-type="author"><collab>Confederation of Postgraduate Medical Education Councils</collab></person-group><source>A National Scope Study: Overseas Trained Doctors Canberra</source><year>2004</year></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>K</given-names></name></person-group><article-title>Globalisation &#x02013; What is it and how does it affect health?</article-title><source>The Medical Journal of Australia</source><year>2004</year><volume>180</volume><fpage>156</fpage><pub-id pub-id-type="pmid">14960132</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zwi</surname><given-names>A</given-names></name><name><surname>Owen</surname><given-names>J</given-names></name><name><surname>Ingram</surname><given-names>A</given-names></name></person-group><article-title>Health and Foreign Policy: Moving forward with greater focus</article-title><source>The Medical Journal of Australia</source><year>2004</year><volume>180</volume><fpage>152</fpage><pub-id pub-id-type="pmid">14960131</pub-id></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Scott</surname><given-names>M</given-names></name><name><surname>Whelan</surname><given-names>A</given-names></name><name><surname>Dewdney</surname><given-names>J</given-names></name><name><surname>Zwi</surname><given-names>A</given-names></name></person-group><article-title>"Brain drain" or ethical recruitment?: Solving health workforce shortages with professionals from developing countries</article-title><source>The Medical Journal of Australia</source><year>2004</year><volume>180</volume><fpage>174</fpage><pub-id pub-id-type="pmid">14960139</pub-id></citation></ref><ref id="B31"><citation citation-type="other"><person-group person-group-type="author"><collab>Department of Health, United Kingdom</collab></person-group><source>Code of Practice for International Recruitment London</source><year>2004</year><ext-link ext-link-type="uri" xlink:href="http://www.dh.gov.uk/PublicationsAndStatistics/Publications/PublicationsPolicyAndGuidance/PublicationsPolicyAndGuidanceArticle/fs/en?CONTENT_ID=4097730&#x00026;chk=DI/b1A"/></citation></ref><ref id="B32"><citation citation-type="other"><person-group person-group-type="author"><collab>The Commonwealth of Governments</collab></person-group><source>Commonwealth Code of Practice for International Recruitment Geneva</source><year>2003</year><ext-link ext-link-type="uri" xlink:href="http://www.thecommonwealth.org/shared_asp_files/uploadedfiles/%7B7BDD970B-53AE-441D-81DB-1B64C37E992A%7D_CommonwealthCodeofPractice.pdf"/></citation></ref></ref-list></back></article>