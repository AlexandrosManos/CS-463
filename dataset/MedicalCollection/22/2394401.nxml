0.60,1.71)</td><td align="center" valign="top" char="&#x0002f;" charoff="50">3&#x0002f;7</td></tr><tr><td align="left" valign="top" charoff="50">Hirohata <italic>et al</italic> (1987)</td><td align="left" valign="top" charoff="50">Hawaii</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" char="(" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Japanese</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">J 183</td><td align="center" valign="top" charoff="50">183</td><td align="left" valign="top" charoff="50">Neighbourhood</td><td align="left" valign="top" charoff="50">Diet history<sup>b</sup></td><td align="left" valign="top" charoff="50">Quartile</td><td align="center" valign="top" char="(" charoff="50">1.5 (0.8,2.9)</td><td align="center" valign="top" char="&#x0002f;" charoff="50">5&#x0002f;7</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Caucasian</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">C 161</td><td align="center" valign="top" charoff="50">161</td><td align="left" valign="top" charoff="50">Neighbourhood</td><td align="left" valign="top" charoff="50">Diet history<sup>b</sup></td><td align="left" valign="top" charoff="50">Quartile</td><td align="center" valign="top" char="(" charoff="50">1.3 (0.6,2.6)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Holmberg <italic>et al</italic> (1994)</td><td align="left" valign="top" charoff="50">Sweden</td><td align="center" valign="top" charoff="50">265</td><td align="center" valign="top" charoff="50">432</td><td align="left" valign="top" charoff="50">Population</td><td align="left" valign="top" charoff="50">Food freq<sup>b</sup><sup>,</sup><sup>c</sup></td><td align="left" valign="top" charoff="50">Quartile</td><td align="center" valign="top" char="(" charoff="50">1.3 (not given)</td><td align="center" valign="top" char="&#x0002f;" charoff="50">6&#x0002f;7</td></tr><tr><td align="left" valign="top" charoff="50">Ingram <italic>et al</italic> (1991)</td><td align="left" valign="top" charoff="50">Australia</td><td align="center" valign="top" charoff="50">99</td><td align="center" valign="top" charoff="50">209</td><td align="left" valign="top" charoff="50">Population</td><td align="left" valign="top" charoff="50">Food freq<sup>b</sup><sup>,</sup><sup>c</sup></td><td align="left" valign="top" charoff="50">Median of fat intake</td><td align="center" valign="top" char="(" charoff="50">1.4 (0.8,2.5)</td><td align="center" valign="top" char="&#x0002f;" charoff="50">5&#x0002f;7</td></tr><tr><td align="left" valign="top" charoff="50">Katsouyanni <italic>et al</italic> (1988)</td><td align="left" valign="top" charoff="50">Greece</td><td align="center" valign="top" charoff="50">120</td><td align="center" valign="top" charoff="50">120</td><td align="left" valign="top" charoff="50">Hospital</td><td align="left" valign="top" charoff="50">Food freq<sup>c</sup></td><td align="left" valign="top" charoff="50">90th <italic>vs</italic> 10th percentiles</td><td align="center" valign="top" char="(" charoff="50">1.36 (0.69,2.67)</td><td align="center" valign="top" char="&#x0002f;" charoff="50">4&#x0002f;7</td></tr><tr><td align="left" valign="top" charoff="50">Katsouyanni <italic>et al</italic> (1994)</td><td align="left" valign="top" charoff="50">Greece</td><td align="center" valign="top" charoff="50">820</td><td align="center" valign="top" charoff="50">1546</td><td align="left" valign="top" charoff="50">Hospital</td><td align="left" valign="t