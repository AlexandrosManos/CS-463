 evidence</source><year>1994</year><publisher-name>DIANE Publishing</publisher-name><fpage>92</fpage><lpage>200</lpage></citation></ref><ref id="B9"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Barro</surname><given-names>S</given-names></name><name><surname>Mar&#x000ed;n</surname><given-names>R</given-names></name></person-group><source>Fuzzy Logic in Medicine</source><year>2002</year><publisher-name>Springer</publisher-name><fpage>36</fpage><lpage>40</lpage></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Corner</surname><given-names>J</given-names></name><name><surname>Bailey</surname><given-names>CD</given-names></name></person-group><source>Cancer Nursing: Care in Context</source><year>2002</year><publisher-name>Blackwell Publishing</publisher-name><fpage>140</fpage><lpage>155</lpage></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kamby</surname><given-names>C</given-names></name></person-group><article-title>The pattern of metastasis in human breast cancer-methodological aspect and influence of prognostic factor</article-title><source>Cancer Treat Rev</source><year>1990</year><volume>17</volume><fpage>37</fpage><lpage>61</lpage><pub-id pub-id-type="pmid">2224869</pub-id><pub-id pub-id-type="doi">10.1016/0305-7372(90)90075-Q</pub-id></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Joseph</surname><given-names>T</given-names></name><name><surname>Dipiro</surname><given-names/></name><name><surname>Terry</surname><given-names>L</given-names></name><name><surname>Hamilton</surname><given-names>SCW</given-names></name><name><surname>Wells</surname><given-names>BG</given-names></name></person-group><source>Pharmacotherapy Handbook</source><year>2005</year><publisher-name>McGraw &#x02013; Hill Professional</publisher-n