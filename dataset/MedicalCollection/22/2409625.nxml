T1</td><td align="center" valign="top" char="." charoff="50">1</td><td align="center" valign="top" char="." charoff="50">1</td><td align="center" valign="top" char="." charoff="50">0</td><td align="center" valign="top" char="." charoff="50">1</td><td align="center" valign="top" char="." charoff="50">0</td><td align="center" valign="top" char="." charoff="50">0</td><td align="center" valign="top" char="." charoff="50">1</td><td align="center" valign="top" char="." charoff="50">0</td><td align="center" valign="top" char="." charoff="50">1</td></tr><tr><td align="center" valign="top" charoff="50">pT2</td><td align="center" valign="top" char="." charoff="50">6</td><td align="center" valign="top" char="." charoff="50">6</td><td align="center" valign="top" char="." charoff="50">0</td><td align="center" valign="top" char="." charoff="50">6</td><td align="center" valign="top" char="." charoff="50">0</td><td align="center" valign="top" char="." charoff="50">4</td><td align="center" valign="top" char="." charoff="50">2</td><td align="center" valign="top" char="." charoff="50">2</td><td align="center" valign="top" char="." charoff="50">4</td></tr><tr><td align="center" valign="top" charoff="50">pT3</td><td align="center" valign="top" char="." charoff="50">47</td><td align="center" valign="top" char="." charoff="50">46</td><td align="center" valign="top" char="." charoff="50">1</td><td align="center" valign="top" char="." charoff="50">45</td><td align="center" valign="top" char="." charoff="50">2</td><td align="center" valign="top" char="." charoff="50">25</td><td align="center" valign="top" char="." charoff="50">22</td><td align="center" valign="top" char="." charoff="50">12</td><td align="center" valign="top" char="." charoff="50">35</td></tr><tr><td align="center" valign="top" charoff="50">pT4</td><td align="center" valign="top" char="." charoff="50">5</td><td align="center" valign="top" char="." charoff="50">5</td><td align="center" valign="top" char="." charoff="50">0</td>