(<year>2001</year>) <source>Mechanics of Motor Proteins and the Cytoskeleton</source>. Sunderland, MA: Sinauer Associates</citation></ref><ref id="b18"><citation citation-type="journal"><name><surname>Hoyt</surname><given-names>MA</given-names></name>, <name><surname>Geiser</surname><given-names>JR</given-names></name> (<year>1996</year>) <article-title>Genetic analysis of the mitotic spindle</article-title>. <source>Annu Rev Genet</source> <volume>30</volume>: <fpage>7</fpage>&#x02013;<lpage>33</lpage><pub-id pub-id-type="pmid">8982447</pub-id></citation></ref><ref id="b19"><citation citation-type="journal"><name><surname>Ideker</surname><given-names>T</given-names></name>, <name><surname>Lauffenburger</surname><given-names>D</given-names></name> (<year>2003</year>) <article-title>Building with a scaffold: emerging strategies for high- to low-level cellular modeling</article-title>. <source>Trends Biotechnol</source> <volume>21</volume>: <fpage>255</fpage>&#x02013;<lpage>262</lpage><pub-id pub-id-type="pmid">12788545</pub-id></citation></ref><ref id="b20"><citation citation-type="journal"><name><surname>Ingold</surname><given-names>AL</given-names></name>, <name><surname>Cohn</surname><given-names>SA</given-names></name>, <name><surname>Scholey</surname><given-names>JM</given-names></name> (<year>1988</year>) <article-title>Inhibition of kinesin-driven microtubule motility by monoclonal antibodies to kinesin heavy chains</article-title>. <source>J Cell Biol</source> <volume>107</volume>: <fpage>2657</fpage>&#x02013;<lpage>2667</lpage><pub-id pub-id-type="pmid">2974459</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><name><surname>Kapitein</surname><given-names>LC</given-names></name>, <name><surname>Peterman</surname><given-names>EJ</given-names></name>, <name><surname>Kwok</surname><given-names>BH</given-names></name>, <name><surname>Kim</surname><given-names>JH</given-names></name>, <name><surname>Kapoor</surname><given-names>TM</given-names></name>, <name><surname>Schmidt</surname><given-names>CF</given-names></name> (<year>2005</year>) <article-title>The bipolar mitotic kinesin Eg5 moves on both microtubules that it crosslinks</article-title>. <source>Nature</source> <volume>435</volume>: <fpage>114</fpage>&#x02013;<lpage>118</lpage><pub-id pub-id-type="pmid">15875026</pub-id></citation></ref><ref id="b22"><citation citation-type="journal"><name><surname>Karsenti</surname><given-names>E</given-names></name>, <name><surname>Vernos</surname><given-names>I</given-names></name> (<year>2001</year>) <article-title>The mitotic spindle: a self-made machine</article-title>. <source>Science</source> <volume>294</volume>: <fpage>543</fpage>&#x02013;<lpage>547</lpage><pub-id pub-id-type="pmid">11641489</pub-id></citation></ref><ref id="b23"><citation citation-type="journal"><name><surname>Kashina</surname><given-names>AS</given-names></name>, <name><surname>Baskin</surname><given-names>RJ</given-names></name>, <name><surname>Cole</surname><given-names>DG</given-names></name>, <name><surname>Wedaman</surname><given-names>KP</given-names></name>, <name><surname>Saxton</surname><given-names>WM</given-names></name>, <name><surname>Scholey</surname><given-names>JM</given-names></name> (<year>1996</year>) <article-title>A bipolar kinesin</article-title>. <source>Nature</source> <volume>378</volume>: <fpage>270</fpage>&#x02013;<lpage>272</lpage><pub-id pub-id-type="pmid">8538794</pub-id></citation></ref><ref id="b24"><citation citation-type="journal"><name><surname>Kline-Smith</surname><given-names>SL</given-names></name>, <name><surname>Walczak</surname><given-names>CE</given-names></name> (<year>2004</year>) <article-title>Mitotic spindle assembly and chromosome segregation: refocusing on microtubule dynamics</article-title>. <source>Mol Cell</source> <volume>15</volume>: <fpage>317</fpage>&#x02013;<lpage>327</lpage><pub-id pub-id-type="pmid">15304213</pub-id></citation></ref><ref id="b25"><citation citation-type="journal"><name><surname>Lawrence</surname><given-names>CJ</given-names></name>, <name><surname>Dawe</surname><given-names>RK</given-names></name>, <name><surname>Christie</surname><given-names>KR</given-names></name>, <name><surname>Cleveland</surname><given-names>DW</given-names></name>, <name><surname>Dawson</surname><given-names>SC</given-names></name>, <name><surname>Endow</surname><given-names>SA</given-names></name>, <name><surname>Goldstein</surname><given-names>LS</given-names></name>, <name><surname>Goodson</surname><given-names>HV</given-names></name>, <name><surname>Hirokawa</surname><given-names>N</given-names></name>, <name><surname>Howard</surname><given-names>J</given-names></name>, <name><surname>Malmberg</surname><given-names>RL</given-names></name>, <name><surname>McIntosh</surname><given-names>JR</given-names></name>, <name><surname>Miki</surname><given-names>H</given-names></name>, <name><surname>Mitchison</surname><given-names>TJ</given-names></name>, <name><surname>Okada</surname><given-names>Y</given-names></name>, <name><surname>Reddy</surname><given-names>AS</given-names></name>, <name><surname>Saxton</surname><given-names>WM</given-names></name>, <name><surname>Schliwa</surname><given-names>M</given-names></name>, <name><surname>Scholey</surname><given-names>JM</given-names></name>, <name><surname>Vale</surname><given-names>RD</given-names></name> (<year>2004</year>) <article-title>A standardized kinesin nomenclature</article-title>. <source>J Cell Biol</source> <volume>167</volume>: <fpage>19</fpage>&#x02013;<lpage>22</lpage><pub-id pub-id-type="pmid">15479732</pub-id></citation></ref><ref id="b26"><citation citation-type="journal"><name><surname>Leslie</surname><given-names>RJ</given-names></name>, <name><surname>Pickett-Heaps</surname><given-names>JD</given-names></name> (<year>1983</year>) <article-title>Ultraviolet microbeam irradiations of mitotic diatoms: investigation of spindle elongation</article-title>. <source>J Cell Biol</source> <volume>96</volume>: <fpage>548</fpage>&#x02013;<lpage>561</lpage><pub-id pub-id-type="pmid">6833370</pub-id></citation></ref><ref id="b27"><citation citation-type="journal"><name><surname>Ma'ayan</surname><given-names>A</given-names></name>, <name><surname>Blitzer</surname><given-names>RD</given-names></name>, <name><surname>Iyengar</surname><given-names>R</given-names></name> (<year>2005</year>) <article-title>Toward predictive models of mammalian cells</article-title>. <source>Annu Rev Biophys Biomol Struct</source> <volume>34</volume>: <fpage>319</fpage>&#x02013;<lpage>349</lpage><pub-id pub-id-type="pmid">15869393</pub-id></citation></ref><ref id="b28"><citation citation-type="journal"><name><surname>McDonald</surname><given-names>HB</given-names></name>, <name><surname>Stewart</surname><given-names>RJ</given-names></name>, <name><surname>Goldstein</surname><given-names>LS</given-names></name> (<year>1990</year>) <article-title>The kinesin-like Ncd protein of <italic>Drosophila</italic> is a minus end-directed microtubule motor</article-title>. <source>Cell</source> <volume>63</volume>: <fpage>1159</fpage>&#x02013;<lpage>1165</lpage><pub-id pub-id-type="pmid">2261638</pub-id></citation></ref><ref id="b29"><citation citation-type="journal"><name><surname>Mitchison</surname><given-names>TJ</given-names></name>, <name><surname>Maddox</surname><given-names>P</given-names></name>, <name><surname>Gaetz</surname><given-names>J</given-names></name>, <name><surname>Groen</surname><given-names>A</given-names></name>, <name><surname>Shirasu</surname><given-names>M</given-names></name>, <name><surname>Desai</surname><given-names>A</given-names></name>, <name><surname>Salmon</surname><given-names>ED</given-names></name>, <name><surname>Kapoor</surname><given-names>TM</given-names></name> (<year>2005</year>) <article-title>Roles of polymerization dynamics, opposed motors, and a tensile element in governing the length of <italic>Xenopus</italic> extract meiotic spindles</article-title>. <source>Mol Biol Cell</source> <volume>16</volume>: <fpage>3064</fpage>&#x02013;<lpage>3076</lpage><pub-id pub-id-type="pmid">15788560</pub-id></citation></ref><ref id="b30"><citation citation-type="journal"><name><surname>Mitchison</surname><given-names>TJ</given-names></name>, <name><surname>Salmon</surname><given-names>ED</given-names></name> (<year>2001</year>) <article-title>Mitosis: a history of division</article-title>. <source>Nat Cell Biol</source> <volume>3</volume>: <fpage>E17</fpage>&#x02013;<lpage>E21</lpage><pub-id pub-id-type="pmid">11146645</pub-id></citation></ref><ref id="b31"><citation citation-type="journal"><name><surname>Mogilner</surname><given-names>A</given-names></name>, <name><surname>Wollman</surname><given-names>R</given-names></name>, <name><surname>Civelekoglu-Scholey</surname><given-names>G</given-names></name>, <name><surname>Scholey</surname><given-names>JM</given-names></name> (<year>2006</year>) <article-title>Modeling mitosis</article-title>. <source>Trends Cell Biol</source> <volume>16</volume>: <fpage>88</fpage>&#x02013;<lpage>96</lpage><pub-id pub-id-type="pmid">16406522</pub-id></citation></ref><ref id="b32"><citation citation-type="journal"><name><surname>N&#x000e9;d&#x000e9;lec</surname><given-names>F</given-names></name> (<year>2002</year>) <article-title>Computer simulations reveal motor properties generating stable antiparallel microtubule interactions</article-title>. <source>J Cell Biol</source> <volume>158</volume>: <fpage>1005</fpage>&#x02013;<lpage>1015</lpage><pub-id pub-id-type="pmid">12235120</pub-id></citation></ref><ref id="b33"><citation citation-type="journal"><name><surname>O'Farrell</surname><given-names>PH</given-names></name> (<year>2001</year>) <article-title>Triggering the all-or-nothing switch into mitosis</article-title>. <source>Trends Cell Biol</source> <volume>11</volume>: <fpage>512</fpage>&#x02013;<lpage>519</lpage><pub-id pub-id-type="pmid">11719058</pub-id></citation></ref><ref id="b34"><citation citation-type="journal"><name><surname>Oladipo</surname><given-names>A</given-names></name>, <name><surname>Cowan</surname><given-names>A</given-names></name>, <name><surname>Rodionov</surname><given-names>V</given-names></name> (<year>2007</year>) <article-title>Microtubule motor Ncd induces sliding of microtubules <italic>in vivo</italic></article-title>. <source>Mol Biol Cell</source> <volume>18</volume>: <fpage>3601</fpage>&#x02013;<lpage>3606</lpage><pub-id pub-id-type="pmid">17596520</pub-id></citation></ref><ref id="b35"><citation citation-type="journal"><name><surname>Ostergren</surname><given-names>G</given-names></name> (<year>1951</year>) <article-title>The mechanism of co-orientation in bivalents and multivalents&#x02014;the theory of orientation by pulling</article-title>. <source>Hereditas</source> <volume>37</volume>: <fpage>85</fpage>&#x02013;<lpage>156</lpage></citation></ref><ref id="b36"><citation citation-type="journal"><name><surname>Parry</surname><given-names>DH</given-names></name>, <name><surname>O'Farrell</surname><given-names>PH</given-names></name> (<year>2001</year>) <article-title>The schedule of destruction of three mitotic cyclins can dictate the timing of events during exit from mitosis</article-title>. <source>Curr Biol</source> <volume>11</volume>: <fpage>671</fpage>&#x02013;<lpage>683</lpage><pub-id pub-id-type="pmid">11369230</pub-id></citation></ref><ref id="b37"><citation citation-type="journal"><name><surname>Peters</surname><given-names>JM</given-names></name> (<year>2002</year>) <article-title>The anaphase-promoting complex: proteolysis in mitosis and beyond</article-title>. <source>Mol Cell</source> <volume>9</volume>: <fpage>931</fpage>&#x02013;<lpage>943</lpage><pub-id pub-id-type="pmid">12049731</pub-id></citation></ref><ref id="b38"><citation citation-type="journal"><name><surname>Pines</surname><given-names>J</given-names></name>, <name><surname>Rieder</surname><given-names>CL</given-names></name> (<