<name><surname>Hansen</surname><given-names>T</given-names></name><name><surname>Petrow</surname><given-names>PK</given-names></name><name><surname>Gaumann</surname><given-names>A</given-names></name><name><surname>Keyszer</surname><given-names>GM</given-names></name><name><surname>Otto</surname><given-names>M</given-names></name><name><surname>Kirkpatrick</surname><given-names>CJ</given-names></name><name><surname>Kriegsmann</surname><given-names>J</given-names></name></person-group><article-title>Expression of cysteine proteinases cathepsins B and K and of cysteine proteinase inhibitor cystatin C in giant cell tumor of tendon sheath</article-title><source>Mod Pathol</source><year>2001</year><volume>14</volume><fpage>318</fpage><lpage>324</lpage><!--PubMed citation query: 'Mod Pathol||14|318||bib15|'--><pub-id pub-id-type="pmid">11301348</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hirai</surname><given-names>K</given-names></name><name><surname>Yokoyama</surname><given-names>M</given-names></name><name><surname>Asano</surname><given-names>G</given-names></name><name><surname>Tanaka</surname><given-names>S</given-names></name></person-group><article-title>Expression of cathepsin B and cystatin C in human colorectal cancer</article-title><source>Hum Pathol</source><year>1999</year><volume>30</volume><fpage>680</fpage><lpage>686</lpage><!--PubMed citation query: 'Hum Pathol||30|680||bib16|'--><pub-id pub-id-type="pmid">10374777</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huh</surname><given-names>CG</given-names></name><name><surname>H&#x000e5;kansson</surname><given-names>K</given-names></name><name><surname>Nathanson</surname><given-names>CM</given-names></name><name><surname>Thorgeirsson</surname><given-names>UP</given-names></name><name><surname>Jonsson</surname><given-names>N</given-names></n