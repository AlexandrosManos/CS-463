roup><article-title>Replication competence and senescence in central and peripheral human corneal endothelium.</article-title><source>Invest Ophthalmol Vis Sci</source><year>2006</year><volume>47</volume><fpage>1387</fpage><lpage>96</lpage><pub-id pub-id-type="pmid">16565372</pub-id></citation></ref></ref-list></back></article>