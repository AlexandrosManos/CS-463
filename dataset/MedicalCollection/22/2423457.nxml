rse</article-title><source>Environment, Science and Policy</source><year>2004</year><volume>7</volume><fpage>385</fpage><lpage>403</lpage><pub-id pub-id-type="doi">10.1016/j.envsci.2004.06.001</pub-id></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Zarefsky</surname><given-names>D</given-names></name></person-group><source>Argumentation: The Study of Effective Reasoning</source><year>2001</year><publisher-name>Chantilly, Virginia: The Teaching Company</publisher-name></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Toulmin</surname><given-names>S</given-names></name></person-group><source>The Uses of Argument</source><year>1958</year><publisher-name>Cambridge: University Press</publisher-name></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Perelman</surname><given-names>C</given-names></name></person-group><source>The Realm of Rhetoric</source><year>1982</year><publisher-name>Notre Dame, Indiana: University of Notre Dame Press</publisher-name></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Provis</surname><given-names>C</given-names></name></person-group><article-title>Negotiation, Persuasion and Argument</article-title><source>Argumentation</source><year>2004</year><volume>18</volume><fpage>95</fpage><lpage>112</lpage><pub-id pub-id-type="doi">10.1023/B:ARGU.0000014868.08915.2a</pub-id></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Beauchamp</surname><given-names>T</given-names></name><name><surname>Walters</surname><given-names>L</given-names></name><collab>(Eds)</collab></person-group><source>Contemporary Issues in Bioethics</source><year>1994</year><publisher-name>Belmont, California: Wadsworth Publishing Company</p