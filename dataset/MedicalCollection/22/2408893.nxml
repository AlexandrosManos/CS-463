-title>All-trans retinoic acid and chemotherapy in the treatment of acute promyelocytic leukemia</article-title><source>Semin Hematol</source><year>2001</year><volume>38</volume><fpage>13</fpage><lpage>25</lpage><!--PubMed citation query: 'Semin Hematol||38|13||bib7|'--></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fijan</surname><given-names>S</given-names></name><name><surname>Honigsmann</surname><given-names>H</given-names></name><name><surname>Ortel</surname><given-names>B</given-names></name></person-group><article-title>Photodynamic therapy of epithelial skin tumours using delta- aminolaevulinic acid and desferrioxamine</article-title><source>Br J Dermatol</source><year>1995</year><volume>133</volume><fpage>282</fpage><lpage>288</lpage><!--PubMed citation query: 'Br J Dermatol||133|282||bib8|'--><pub-id pub-id-type="pmid">7547399</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gandarillas</surname><given-names>A</given-names></name><name><surname>Goldsmith</surname><given-names>LA</given-names></name><name><surname>Gschmeissner</surname><given-names>S</given-names></name><name><surname>Leigh</surname><given-names>IM</given-names></name><name><surname>Watt</surname><given-names>FM</given-names></name></person-group><article-title>Evidence that apoptosis and terminal differentiation of epidermal keratinocytes are distinct processes</article-title><source>Exp Dermatol</source><year>1999</year><volume>8</volume><fpage>71</fpage><lpage>79</lpage><!--PubMed citation query: 'Exp Dermatol||8|71||bib9|'--><pub-id pub-id-type="pmid">10206724</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Glasser</surname><given-names>L</given-names></name><name><surname>Fiederlein</surname><given-names>RL</given-names></name><name><surname>Shamdas</