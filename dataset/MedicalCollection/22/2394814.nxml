n="left" valign="top">15&#x02013;4.0 </td><td rowspan="1" colspan="1" align="left" valign="top">33.7</td><td rowspan="1" colspan="1" align="left" valign="top">88.2</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top"><italic>E. coli</italic> YECD homologues </td><td rowspan="1" colspan="1" align="left" valign="top">15&#x02013;3.5 </td><td rowspan="1" colspan="1" align="left" valign="top">36.8</td><td rowspan="1" colspan="1" align="left" valign="top">94.4</td></tr></tbody></table></table-wrap></table-wrap-group></floats-wrap></article>