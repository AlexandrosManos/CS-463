e>1103</fpage><lpage>1109</lpage><pub-id pub-id-type="pmid">10877888</pub-id></citation></ref><ref id="pone.0002417-Millspaugh4"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Millspaugh</surname><given-names>JJ</given-names></name><name><surname>Raedeke</surname><given-names>KJ</given-names></name><name><surname>Brundige</surname><given-names>GC</given-names></name><name><surname>Gitzen</surname><given-names>RA</given-names></name></person-group><year>2000</year><article-title>Elk and hunter space use sharing in the Southern Black Hills, South Dakota.</article-title><source>Journal of Wildlife Management</source><volume>64</volume><fpage>994</fpage><lpage>1003</lpage></citation></ref><ref id="pone.0002417-Morgantini1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morgantini</surname><given-names>LE</given-names></name><name><surname>Hudson</surname><given-names>RJ</given-names></name></person-group><year>1985</year><article-title>Changes in diets of wapiti during a hunting season.</article-title><source>Journal of Range Management</source><volume>38</volume><fpage>77</fpage><lpage>79</lpage></citation></ref><ref id="pone.0002417-Irwin1"><label>17</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Irwin</surname><given-names>L</given-names></name><name><surname>Peek</surname><given-names>JM</given-names></name></person-group><year>1979</year><article-title>Relationships between road closures and elk behavior in northern Idaho.</article-title><person-group person-group-type="editor"><name><surname>Boyce</surname><given-names>MS</given-names></name><name><surname>Hayden-Wing</surname><given-names>LD</given-names></name></person-group><source>North American elk: ecology, behavior and management</source><publisher-name>University of Wyoming, Laramie, Wyoming, USA</publisher-name><fpage>199</fpage><lpage>204</