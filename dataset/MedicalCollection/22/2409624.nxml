 citation query: 'Am J Physiol||281|H2337||bib4|'--></citation></ref><ref id="bib5"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Breu</surname><given-names>V</given-names></name><name><surname>Maerki</surname><given-names>HP</given-names></name><name><surname>Vieira</surname><given-names>E</given-names></name><name><surname>Wostl</surname><given-names>W</given-names></name></person-group><article-title>Preparation of piperidine derivatives as renin inhibitors</article-title><source>PCT Int Appl</source><year>2000</year>70pp (WO 0064873 A1)</citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>C&#x000e9;l&#x000e9;rier</surname><given-names>J</given-names></name><name><surname>Cruz</surname><given-names>A</given-names></name><name><surname>Lamand&#x000e9;</surname><given-names>N</given-names></name><name><surname>Gasc</surname><given-names>JM</given-names></name><name><surname>Corvol</surname><given-names>P</given-names></name></person-group><article-title>Angiotensinogen and its cleaved derivatives inhibit angiogenesis</article-title><source>Hypertension</source><year>2002</year><volume>39</volume><fpage>224</fpage><lpage>228</lpage><!--PubMed citation query: 'Hypertension||39|224||bib6|'--><pub-id pub-id-type="pmid">11847188</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>C&#x000e9;l&#x000e9;rier</surname><given-names>J</given-names></name><name><surname>Schmid</surname><given-names>G</given-names></name><name><surname>Le Caer</surname><given-names>JP</given-names></name><name><surname>Gimenez-Roqueplo</surname><given-names>AP</given-names></name><name><surname>Bur</surname><given-names>D</given-names></name><name><surname>Friedlein</surname><given-names>A</given-names></name><name><surname>Langen</surname><given-names>H</given-names></name><name><surname>Corvol</surname><given