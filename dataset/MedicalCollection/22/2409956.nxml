e><fpage>77</fpage><lpage>86</lpage><!--PubMed citation query: 'Pharmacol Toxicol||70|77||bib14|'--><pub-id pub-id-type="pmid">1508843</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kassie</surname><given-names>F</given-names></name><name><surname>Darroudi</surname><given-names>F</given-names></name><name><surname>Kundi</surname><given-names>M</given-names></name><name><surname>Schulte-Hermann</surname><given-names>R</given-names></name><name><surname>Knasmuller</surname><given-names>S</given-names></name></person-group><article-title>Khat <italic>(Catha edulis)</italic> consumption causes genotoxic effects in humans</article-title><source>Int J Cancer</source><year>2001</year><volume>92</volume><fpage>329</fpage><lpage>332</lpage><!--PubMed citation query: 'Int J Cancer||92|329||bib15|'--><pub-id pub-id-type="pmid">11291066</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kerr</surname><given-names>JFR</given-names></name><name><surname>Wyllie</surname><given-names>AH</given-names></name><name><surname>Currie</surname><given-names>AR</given-names></name></person-group><article-title>Apoptosis: a basic biological phenomenon with wide-ranging implications in tissue kinetics</article-title><source>Brit J Cancer</source><year>1972</year><volume>26</volume><fpage>239</fpage><lpage>257</lpage><!--PubMed citation query: 'Brit J Cancer||26|239||bib16|'--><pub-id pub-id-type="pmid">4561027</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kite</surname><given-names>GC</given-names></name><name><surname>Ismail</surname><given-names>M</given-names></name><name><surname>Simmonds</surname><given-names>M</given-names></name><name><surname>Houghton</surname><given-names>P</given-names></name></person-group><article-title>Use of doubly pr