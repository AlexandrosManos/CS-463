me><surname>Kum</surname><given-names>CK</given-names></name><name><surname>Goh</surname><given-names>PM</given-names></name></person-group><article-title>Risk factors related to operative mortality and morbidity in patients undergoing emergency gastrectomy</article-title><source>Br J Surg</source><year>2000</year><volume>87</volume><fpage>1702</fpage><lpage>1707</lpage><pub-id pub-id-type="pmid">11122188</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2168.2000.01572.x</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><article-title>2001 SCCM/ESICM/ACCP/ATS/SIS International Sepsis Definitions Conference</article-title><source>Intensive Care Med</source><year>2003</year><volume>29</volume><fpage>530</fpage><lpage>538</lpage><pub-id pub-id-type="pmid">12664219</pub-id></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Fleming</surname><given-names>ID</given-names></name><name><surname>Cooper</surname><given-names>JS</given-names></name><name><surname>Murphy</surname><given-names>GP</given-names></name><name><surname>Sullivan</surname><given-names>BO</given-names></name><name><surname>Sobin</surname><given-names>LH</given-names></name><name><surname>Yarbro</surname><given-names>JW</given-names></name><etal></etal></person-group><source>American Joint Committee on Cancer: AJCC Cancer Staging Manual</source><year>1997</year><edition>5</edition><publisher-name>Philadelphia, PA, USA: Lippincott-Raven</publisher-name></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gertsch</surname><given-names>P</given-names></name><name><surname>Yip</surname><given-names>SK</given-names></name><name><surname>Chow</surname><given-names>LW</given-names></name><name><surname>Launder</surname><given-names>IJ</given-names></name></person-group><article-title>Free perforation of gastric carcinoma</article-title><source>Arch Surg</source><year>1995</year><volume>130</volume><fpage>177</fpage><lpage>81</lpage><pub-id pub-id-type="pmid">7531430</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lehnert</surname><given-names>T</given-names></name><name><surname>Buhl</surname><given-names>K</given-names></name><name><surname>Dueck</surname><given-names>M</given-names></name><name><surname>Hinz</surname><given-names>U</given-names></name><name><surname>Herfarth</surname><given-names>C</given-names></name></person-group><article-title>Two-staged radical gastrectomy for perforated gastric cancer</article-title><source>Eur J Surg Oncol</source><year>2000</year><volume>26</volume><fpage>780</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">11087645</pub-id><pub-id pub-id-type="doi">10.1053/ejso.2000.1003</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adachi</surname><given-names>Y</given-names></name><name><surname>Aramaki</surname><given-names>M</given-names></name><name><surname>Shiraishi</surname><given-names>N</given-names></name><name><surname>Shimado</surname><given-names>K</given-names></name><name><surname>Yasuda</surname><given-names>K</given-names></name><name><surname>Kitano</surname><given-names>S</given-names></name></person-group><article-title>Long-term survival after perforation of advanced gastric cancer: Case report and review of the literature</article-title><source>Gastric Cancer</source><year>1998</year><volume>1</volume><fpage>80</fpage><lpage>83</lpage><pub-id pub-id-type="pmid">11957048</pub-id><pub-id pub-id-type="doi">10.1007/s101200050059</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kitakado</surname><given-names>Y</given-names></name><name><surname>Tanigawa</surname><given-names>N</given-names></name><name><surname>Muraoka</surname><give