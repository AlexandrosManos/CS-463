ign="top" charoff="50">&#x02003;Lung</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">10 (7.0&#x00025;)</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">22 (9.1&#x00025;)</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Bone</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">7 (4.9&#x00025;)</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">10 (4.1&#x00025;)</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Lung and bone</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">1 (0.7&#x00025;)</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">4 (1.6&#x00025;)</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Liver</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">2 (0.14&#x00025;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x02014;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Nodes</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">1<sup>a</sup> (0.7&#x00025;)</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">2<sup>b</sup> (0.8&#x00025;)</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Lung and other</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">1<sup>c</sup> (0.7&#x00025;)</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">1<sup>d</sup> (0.4&#x00025;)</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Bone and other</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x02014;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">2<sup>e</sup><sup>f</sup> (0.8&#x00025;)</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Lung, bone and other</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x02014;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">1<sup>g</sup> (0.4&#x00025;)</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Total</td><td align="left" valign="top" charoff="50">120</td><td align="left" valign="top" charoff="50">22</td><td align="left" valign="top" charoff="50">142</td><td align="left" valign="top" charoff="50">201</td><td align="left" valign="top" charoff="50">42</td><td align="left" valign="top" charoff="50">243</td></tr></tbody></table><table-wrap-foot><fn id="tbfnote1"><label>a</label><p>Para-aortic.</p></fn><fn id="tbfnote2"><label>b</label><p>Lymphatic.</p></fn><fn id="tbfnote3"><label>c</label><p>Mediastinum.</p></fn><fn id="tbfnote4"><label>d</label><p>Femoral nodes.</p></fn><fn id="tbfnote5"><label>e</label><p>Bone marrow, liver and lymph nodes.</p></fn><fn id="tbfnote6"><label>f</label><p>Bone marrow, liver and intracranial nodes.</p></fn><fn id="tbfnote7"><label>g</label><p>Bone marrow and pleura.</p></fn></table-wrap-foot></table-wrap>).</p><p>For ET-1 the median follow-up time is 17.0 years (range&#x0003d;0.3&#x02013;24.0) and for ET-2 11.1 years (range&#x0003d;0.5&#x02013;16.3). In all, 37&#x00025; of alive patients have follow-up data of 2002 or later and a further 43&#x00025; of alive patients have follow-up data of 1999 or later. It is to be expected that patients are seen in clinic less often as the time from diagnosis increases. The number of deaths in the two studies by metastatic status groups are given in <xref rid="tbl2" ref-type="table">Table 2</xref> <table-wrap id="tbl2" position="float"><label>Table 2</label><caption><p content-type="table-title">CM and Cox regression estimates of survival for study and presence of metastases at diagnosis</p></caption><table frame="hsides" rules="groups" border="1" width="85%"><colgroup><col align="left"/><col align="char" char="."/><col align="char" char="."/><col align="char" char="."/><col align="char" char="."/></colgroup><thead valign="bottom"><tr><th align="left" valign="top" charoff="50"><bold>Model</bold></th><th align="char" valign="to