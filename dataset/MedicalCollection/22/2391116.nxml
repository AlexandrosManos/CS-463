thor"><name><surname>Cavallaro</surname><given-names>U</given-names></name><name><surname>Christofori</surname><given-names>G</given-names></name></person-group><article-title>Molecular mechanisms of tumor angiogenesis and tumor progression</article-title><source>J Neurooncol</source><year>2000</year><volume>50</volume><fpage>63</fpage><lpage>70</lpage><!--PubMed citation query: 'J Neurooncol||50|63||bib5|'--><pub-id pub-id-type="pmid">11245282</pub-id></citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chiquet</surname><given-names>M</given-names></name></person-group><article-title>Regulation of extracellular gene expression by mechanical stress</article-title><source>Matrix Biol</source><year>1999</year><volume>18</volume><fpage>417</fpage><lpage>426</lpage><!--PubMed citation query: 'Matrix Biol||18|417||bib6|'--><pub-id pub-id-type="pmid">10601729</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chun</surname><given-names>TH</given-names></name><name><surname>Sabeth</surname><given-names>F</given-names></name><name><surname>Ota</surname><given-names>I</given-names></name><name><surname>Murphy</surname><given-names>H</given-names></name><name><surname>McDonagh</surname><given-names>KT</given-names></name><name><surname>Holmbeck</surname><given-names>K</given-names></name><name><surname>Dirkedal-Hansen</surname><given-names>H</given-names></name><name><surname>Allen</surname><given-names>ED</given-names></name><name><surname>Weiss</surname><given-names>SJ</given-names></name></person-group><article-title>MT1-MMP-dependent neovessel formation within the confines of a three-dimensional extracellular matrix</article-title><source>J Cell Biol</source><year>2004</year><volume>167</volume><fpage>757</fpage><lpage>767</lpage><!--PubMed citation query: 'J Cell Biol||167|757||bib7|'--><pub-id pub-id-type="pmid">15545316</pu