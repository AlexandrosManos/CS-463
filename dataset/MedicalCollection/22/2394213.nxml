: 'Breast Cancer Res Treat||56|1||bib9|'--><pub-id pub-id-type="pmid">10517338</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gupta</surname><given-names>AK</given-names></name><name><surname>Bakanauskas</surname><given-names>VJ</given-names></name><name><surname>Cerniglia</surname><given-names>GJ</given-names></name><name><surname>Cheng</surname><given-names>Y</given-names></name><name><surname>Bernhard</surname><given-names>EJ</given-names></name><name><surname>Muschel</surname><given-names>RJ</given-names></name><name><surname>McKenna</surname><given-names>WG</given-names></name></person-group><article-title>The Ras radiation resistance pathway</article-title><source>Cancer Res</source><year>2001</year><volume>61</volume><fpage>4278</fpage><lpage>4282</lpage><!--PubMed citation query: 'Cancer Res||61|4278||bib10|'--><pub-id pub-id-type="pmid">11358856</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kasid</surname><given-names>A</given-names></name><name><surname>Lippman</surname><given-names>ME</given-names></name><name><surname>Papageorge</surname><given-names>AG</given-names></name><name><surname>Lowy</surname><given-names>DR</given-names></name><name><surname>Gelmann</surname><given-names>EP</given-names></name></person-group><article-title>Transfection of v-rasH DNA into MCF-7 human breast cancer cells bypasses dependence on estrogen for tumorigenicity</article-title><source>Science</source><year>1985</year><volume>228</volume><fpage>725</fpage><lpage>728</lpage><!--PubMed citation query: 'Science||228|725||bib11|'--><pub-id pub-id-type="pmid">4039465</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koo</surname><given-names>HM</given-names></name><name><surname>Gray-Goodrich</surname><given-names>M</given-names></name><name><surname>Kohlhagen</surname><given-names>G</given-names></name><name><surname>McWilliams</surname><given-names>MJ</given-names></name><name><surname>Jeffers</surname><given-names>M</given-names></name><name><surname>Vaigro-Wolff</surname><given-names>A</given-names></name><name><surname>Alvord</surname><given-names>WG</given-names></name><name><surname>Monks</surname><given-names>A</given-names></name><name><surname>Paull</surname><given-names>KD</given-names></name><name><surname>Pommier</surname><given-names>Y</given-names></name><name><surname>Vande Woude</surname><given-names>GF</given-names></name></person-group><article-title>The ras oncogene-mediated sensitization of human cells to topoisomerase II inhibitor-induced apoptosis</article-title><source>J Natl Cancer Inst</source><year>1999</year><volume>91</volume><fpage>236</fpage><lpage>244</lpage><!--PubMed citation query: 'J Natl Cancer Inst||91|236||bib12|'--><pub-id pub-id-type="pmid">10037101</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kroll</surname><given-names>T</given-names></name><name><surname>Odyvanova</surname><given-names>L</given-names></name><name><surname>Clement</surname><given-names>JH</given-names></name><name><surname>Platzer</surname><given-names>C</given-names></name><name><surname>Naumann</surname><given-names>A</given-names></name><name><surname>Marr</surname><given-names>N</given-names></name><name><surname>Hoffken</surname><given-names>K</given-names></name><name><surname>Wolfl</surname><given-names>S</given-names></name></person-group><article-title>Molecular characterization of breast cancer cell lines by expression profiling</article-title><source>J Cancer Res Clin Oncol</source><year>2002</year><volume>128</volume><fpage>125</fpage><lpage>134</lpage><!--PubMed citation query: 'J Cancer Res Clin Oncol||128|125||bib13|'--><pub-id pub-id-type="pmid">11935298</pub-id></citation></ref><ref