-title>Diurnal variations of interleukin-6 plasma levels are confounded by blood drawing procedures</article-title><source>Psychoneuroendocrinology</source><year>2002</year><volume>27</volume><fpage>921</fpage><lpage>31</lpage><pub-id pub-id-type="pmid">12383453</pub-id></citation></ref><ref id="b20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hama</surname><given-names>T</given-names></name><name><surname>Kushima</surname><given-names>Y</given-names></name><name><surname>Miyamoto</surname><given-names>M</given-names></name><etal/></person-group><article-title>Interleukin-6 improves the survival of mesencephalic catecholaminergic and septal cholinergic neurons from postnatal, two-week-old rats in cultures</article-title><source>Neuroscience</source><year>1991</year><volume>40</volume><fpage>445</fpage><lpage>52</lpage><pub-id pub-id-type="pmid">2027469</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamilton</surname><given-names>M</given-names></name></person-group><article-title>A rating scale for depression</article-title><source>J Neurol Neurosurg Psychiatry</source><year>1960</year><volume>62</volume><fpage>56</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">14399272</pub-id></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Handoko</surname><given-names>HY</given-names></name><name><surname>Nancarrow</surname><given-names>DJ</given-names></name><name><surname>Hayward</surname><given-names>NK</given-names></name><etal/></person-group><article-title>Tumor necrosis factor haplotype analysis amongst schizophrenia probands from four distinct populations in the Asia-Pacific region</article-title><source>Am J Med Genet</source><year>2003</year><volume>121B</volume><fpage>1</fpage><lpage>6</lpage></citation></ref><ref id="b23"><citation citation-type="journal"><person-grou