source>British Journal of Psychiatry</source><year>1996</year><volume>168</volume><fpage>641</fpage><pub-id pub-id-type="pmid">8733806</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><collab>Carskey M</collab><collab>Selzer MA</collab><collab>Terkelsen K</collab><collab>Hurt SW</collab></person-group><article-title>The PEH: A questionnaire to assess acknowledgement of psychiatric illness</article-title><source>The Journal of Mental and Nervous Disease</source><year>1992</year><volume>180</volume><fpage>458</fpage><lpage>464</lpage><pub-id pub-id-type="doi">10.1097/00005053-199207000-00009</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><collab>Leese M</collab><collab>Johnson S</collab><collab>Slade M</collab><collab>Parkman S</collab><collab>Kelly F</collab><collab>Phelan M</collab><collab>Thornicroft G</collab></person-group><article-title>User perspective on needs and satisfaction with mental health services. The PRiSM Psychosis Study 9</article-title><source>British Journal of Psychiatry</source><year>1998</year><volume>173</volume><fpage>409</fpage><lpage>415</lpage><pub-id pub-id-type="pmid">9926058</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><collab>Wing JK</collab><collab>Beevor AS</collab><collab>Curtis RH</collab><collab>Park SGB</collab><collab>Hadden S</collab><collab>Burns A</collab></person-group><article-title>Heath of the Nation Outcome Scales (HoNOS)</article-title><source>British Journal of Psychiatry</source><year>1998</year><volume>192</volume><fpage>11</fpage><lpage>18</lpage></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><collab>Hansson L</collab><collab>H&#x000f6;glund E</collab></person-group><article-title>Patient satisfaction with psychiatric services. The development, reliability, and validity of two patient-satisfaction questionnaires for use in inpatient and outpatient settings</article-title><source>Nordic Journal of Psychiatry</source><year>1995</year><volume>49</volume><fpage>257</fpage><lpage>262</lpage><pub-id pub-id-type="doi">10.3109/08039489509011915</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><collab>Salvi G</collab><collab>Leese</collab><collab>Slade M</collab></person-group><article-title>Routine use of mental health outcome assessment: choosing the measure</article-title><source>British Journal of Psychiatry</source><year>2005</year><volume>186</volume><fpage>146</fpage><lpage>152</lpage><pub-id pub-id-type="pmid">15684239</pub-id><pub-id pub-id-type="doi">10.1192/bjp.186.2.146</pub-id></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><collab>Sheehan D</collab><collab>Janavs J</collab><collab>Baker R</collab><collab>Harnett-Sheehan K</collab><collab>Knapp E</collab><collab>Sheehan M</collab></person-group><source>Mini Intarnational Neuropsychiatric Interview</source><year>1994</year><publisher-name>Tampa , University of South Florida</publisher-name></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><collab>Leiknes KA</collab><collab>Leganger S</collab><collab>Malt EA</collab><name><surname>U.</surname><given-names>M</given-names></name></person-group><source>M.I.N.I. PLUS</source><year>1999</year><publisher-name>Oslo , Psykosomatisk avd., Rikshospitalet</publisher-name></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><collab>APA</collab></person-group><source> Diagnostic and statistical manual of mental disorders</source><year>1987</year><publisher-name>Washington DC , American Psychiatric Association</publisher-name></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><collab>Vatnaland F</collab><collab>Vatnaland S</collab><collab>Friss S</collab><collab>Opjordsmoen S</collab></person-group><article-title>Are GAF scores reliable in routine clinical care?</article-title><source>Acta Psychiatrica Scandinavia</source><year>2007</year><volume>115</volume><fpage>326</fpage><lpage>330</lpage><pub-id pub-id-type="doi">10.1111/j.1600-0447.2006.00925.x</pub-id></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><collab>Breiman L</collab><collab>Friedman JH</collab><collab>Olsen RA</collab><collab>Stone CJ</collab></person-group><source>Classification and regression trees</source><year>1988</year><publisher-name>Boca Raton, Florida , Chapman &#x00026; Hall</publisher-name></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><collab>Greenwood N</collab><collab>Key A</collab><collab>Burns T</collab><collab>Bristow M</collab><collab>Sedgewick P</collab></person-group><article-title>Satisfaction with in-patient psychiatric services. Relationship to patient treatment factors</article-title><source>British Journal of Psychiatry</source><year>1999</year><volume>174</volume><fpage>159</fpage><lpage>163</lpage><pub-id pub-id-type="pmid">10211171</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><collab>Hoff RA</collab><collab>Rosenheck RA</collab><collab>Meterko M</collab><collab>Wilson NJ</collab></person-group><article-title>Mental illness as a predictor of satisfaction with inpatient treatment care at Veterans affairs hospitals</article-title><source>Psychiatric Services</source><year>1999</year><volume>50</volume><fpage>680</fpage><lpage>685</lpage><pub-id pub-id-type="pmid">10332906</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><collab>Jenkinson C</collab><collab>Coulter A</collab><collab>Bruster S</collab><collab>RIchards N</collab><name><surname>T</surname><given-names>C</given-names></name></person-group><article-title>Patients&#x000b4; experiences and satisfaction with health care: results of a questionnaire study of specific aspects of care</article-title><source>Quality of Health Care</source><year>2002</year><volume>11</volume><fpage>335</fpage><lpage>339</lpage><pub-id pub-id-type="doi">10.1136/qhc.11.4.335</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><collab>Saltzer M</collab></person-group><article-title>Consumer satisfaction. Letters to the editor</article-title><source>Psychiatric Services</source><year>1998</year><volume>49</volume><fpage>1622</fpage><pub-id pub-id-type="pmid">9856631</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><collab>Kalman TP</collab></person-group><article-title>An overview of patient satisfaction with psychiatric treatment</article-title><source>Hospital and Communty Psychiatry</source><year>1983</year><volume>34</volume><fpage>48</fpage><lpage>54</lpage><pub-id pub-id-type="pmid">6826149</pub-id></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><collab>Hall JA</collab><collab>Dornan MC</collab></person-group><article-title>Meta-analysis of satisfaction wirth medical care: What patients are asked about their care and how often they are asked: A meta-analysis of the litterature</article-title><source>Social Science and Medicine</source><year>1988</year><volume>27</volume><fpage>935</fpage><lpage>939</lpage><pub-id pub-id-type="pmid">3067368</pub-id><pub-id pub-id-type="doi">10.1016/0277-9536(88)90284-5</pub-id></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><collab>Hall JA</collab><collab>Dornan MC</collab></person-group><article-title>Meta-analysis of satisfaction with medical care: Description of research domain and analysis of overall satisfaction levels</article-title><source>Social Science and Medicine</source><year>1988</year><volume>27</volume><fpage>637</fpage><lpage>644</lpage><pub-id pub-id-type="pmid">3067359</pub-id><pub-id pub-id-type="doi">10.1016/0277-9536(88)90012-3</pub-id></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><collab>Svensson B</collab><collab>Hansson L</collab></person-group><article-title>Satisfaction with mental health services. A user participation approach</article-title><source>Nordic Journal of Psychiatry</source><year>2006</year><volume>60</volume><fpage>365</fpage><lpage>371</lpage><pub-id pub-id-type="pmid">17050294</pub-id><pub-id pub-id-type="doi">10.1080/08039480600937090</pub-id></citation></ref><ref id="B33"><citation citation-type="journal"><person-group person-group-type="author"><collab>Shipley K</collab><collab>Hilborn B</collab><collab>Hansell A</collab><collab>Tyrer J</collab><collab>Tyrer P</collab></person-group><article-title>Patient satisfaction: a valid index of quality of care in a psychiatric service</article-title><source>Acta Psychiatrica Scandinavica</source><year>2000</year><volume>101</volume><fpage>330</fpage><lpage>333</lpage><pub-id pub-id-type="pmid">10782555</pub-id></citation></ref><ref id="B34"><citation citation-type="book"><person-group person-group-type="author"><collab>Hinkle DE</collab><collab>Wiersma W</collab><collab>Jurs SG</collab></person-group><source>Applied Statistics in the Behavioural Sciences</source><year>2003</year><publisher-name>New York , Houghton Mifflin Company</publisher-name></citation></ref></ref-list></back></article>