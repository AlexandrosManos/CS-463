lign="left" valign="top" charoff="50">0.7&#x02013;1.6</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50"><italic>Education (years)</italic></td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">0&#x02013;2</td><td align="left" valign="top" charoff="50">60 (36.1)</td><td align="left" valign="top" charoff="50">205 (30.9)</td><td align="left" valign="top" charoff="50">1.0</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">3&#x02013;5</td><td align="left" valign="top" charoff="50">69 (41.6)</td><td align="left" valign="top" charoff="50">224 (33.7)</td><td align="left" valign="top" charoff="50">1.0</td><td align="left" valign="top" charoff="50">0.7&#x02013;1.6</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">6&#x0002b;</td><td align="left" valign="top" charoff="50">37 (22.3)</td><td align="left" valign="top" charoff="50">235 (35.4)</td><td align="left" valign="top" charoff="50">0.5</td><td align="left" valign="top" charoff="50">0.3&#x02013;0.8</td><td align="left" valign="top" charoff="50">0.008</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50