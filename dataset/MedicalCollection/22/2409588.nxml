td><td align="left" valign="top" charoff="50">ILIUM</td><td align="left" valign="top" charoff="50">No</td><td align="left" valign="top" charoff="50">OST (C)</td><td align="left" valign="top" charoff="50">Palliative</td><td align="left" valign="top" charoff="50">No</td><td align="left" valign="top" charoff="50">16&#x02009;Gy (neutron)</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">DOD&#x0002f;4 months</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;5</td><td align="left" valign="top" charoff="50">F</td><td align="center" valign="top" char="." charoff="50">15</td><td align="left" valign="top" charoff="50">ILIUM</td><td align="left" valign="top" charoff="50">Yes</td><td align="left" valign="top" charoff="50">CHON</td><td align="left" valign="top" charoff="50">Yes</td><td align="left" valign="top" charoff="50">No</td><td align="left" valign="top" charoff="50">40&#x02009;Gy (palliative)</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">DOD&#x0002f;11 months</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;6</td><td align="left" valign="top" charoff="50">M</td><td align="center" valign="top" char="." charoff="50">16</td><td align="left" valign="top" charoff="50">ILIUM</td><td align="left" valign="top" charoff="50">No</td><td align="left" valign="top" charoff="50">CHON</td><td align="left" valign="top" charoff="50">Pre- and postoperative</td><td align="left" valign="top" charoff="50">Resection</td><td align="left" valign="top" charoff="50">No</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">NED&#x0002f;6.5 years</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;7</td><td align="left" valign="top" charoff="50">M</td><td align="center" valign="top" char="." charoff="50">15</td><td align="left" valign="top" charoff="50">ISCHIUM</td><td align="left" valign="top" char