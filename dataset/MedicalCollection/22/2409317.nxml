ab></person-group><article-title>Resolution Adopted by the General Assembly: Political Declaration on HIV/AIDS</article-title><year>2006</year><fpage>1</fpage><lpage>8</lpage></citation></ref><ref id="B32"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Shea</surname><given-names>WR</given-names></name><name><surname>Artigas</surname><given-names>M</given-names></name></person-group><source>Galileo in Rome: the Rise and Fall of a Troublesome Genius</source><year>2003</year><publisher-name>New York , Oxford University Press</publisher-name></citation></ref></ref-list></back></article>