le-title><source>Clin Exp Metastasis</source><volume>18</volume><fpage>573</fpage><lpage>580</lpage></citation></ref><ref id="pone.0002528-Nguyen1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nguyen</surname><given-names>TN</given-names></name><name><surname>Zang</surname><given-names>XP</given-names></name><name><surname>Pento</surname><given-names>JT</given-names></name></person-group><year>2002</year><article-title>Keratinocyte growth factor stimulates the migration and proliferation of breast cancer cells in a culture wounding model.</article-title><source>Pharmacol Res</source><volume>46</volume><fpage>179</fpage><lpage>183</lpage></citation></ref><ref id="pone.0002528-Zang2"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zang</surname><given-names>XP</given-names></name><name><surname>Lerner</surname><given-names>MR</given-names></name><name><surname>Dunn</surname><given-names>ST</given-names></name><name><surname>Brackett</surname><given-names>DJ</given-names></name><name><surname>Pento</surname><given-names>JT</given-names></name></person-group><year>2003</year><article-title>Antisense KGFR oligonucleotide inhibition of KGF-induced motility in breast cancer cells.</article-title><source>Anticancer Res</source><volume>23</volume><fpage>4913</fpage><lpage>4919</lpage><pub-id pub-id-type="pmid">14981945</pub-id></citation></ref><ref id="pone.0002528-Shin1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shin</surname><given-names>EY</given-names></name><name><surname>Lee</surname><given-names>BH</given-names></name><name><surname>Yang</surname><given-names>JH</given-names></name><name><surname>Shin</surname><given-names>KS</given-names></name><name><surname>Lee</surname><given-names>GK</given-names></name><etal/></person-group><year>2000</year><article-title>Up-regulation and co-exp