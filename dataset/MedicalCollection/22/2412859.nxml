me></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ortiz</surname><given-names>MC</given-names></name><name><surname>de Lima</surname><given-names>RA</given-names></name></person-group><article-title>Experiences of families with children and adolescents after completing a cancer treatment: support for the nursing care</article-title><source>Revista latino-americana de enfermagem</source><year>2007</year><volume>15</volume><fpage>411</fpage><lpage>417</lpage><pub-id pub-id-type="pmid">17653423</pub-id><pub-id pub-id-type="doi">10.1590/S0104-11692007000300008</pub-id></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cohen</surname><given-names>J</given-names></name></person-group><source>Statistical power analysis for the behavioral sciences</source><year>1988</year><edition>2</edition><publisher-name>Hillsdale: Lawrence Erlbaum</publisher-name></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Houtzager</surname><given-names>BA</given-names></name><name><surname>Grootenhuis</surname><given-names>MA</given-names></name><name><surname>Hoekstra-Weebers</surname><given-names>JE</given-names></name><name><surname>Last</surname><given-names>BF</given-names></name></person-group><article-title>One month after diagnosis: quality of life, coping and previous functioning in siblings of children with cancer</article-title><source>Child: care, health and development</source><year>2005</year><volume>31</volume><fpage>75</fpage><lpage>87</lpage><pub-id pub-id-type="pmid">15658968</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McCaffrey</surname><given-names>CN</given-names></name></person-group><article-title>Major stressors and their effects on the well-being of children with cancer</article-title><source>J Pediatr Nurs</source><year>2006</year><volume>21</volume><fpage>59</fpage><lpage>66</lpage><pub-id pub-id-type="pmid">16428015</pub-id><pub-id pub-id-type="doi">10.1016/j.pedn.2005.07.003</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fleck</surname><given-names>MP</given-names></name><name><surname>Louzada</surname><given-names>S</given-names></name><name><surname>Xavier</surname><given-names>M</given-names></name><name><surname>Chachamovich</surname><given-names>E</given-names></name><name><surname>Vieira</surname><given-names>G</given-names></name><name><surname>Santos</surname><given-names>L</given-names></name><name><surname>Pinzon</surname><given-names>V</given-names></name></person-group><article-title>[Application of the Portuguese version of the instrument for the assessment of quality of life of the World Health Organization (WHOQOL-100)]</article-title><source>Rev Saude Publica</source><year>1999</year><volume>33</volume><fpage>198</fpage><lpage>205</lpage><pub-id pub-id-type="pmid">10413938</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guyatt</surname><given-names>GH</given-names></name><name><surname>Feeny</surname><given-names>DH</given-names></name><name><surname>Patrick</surname><given-names>DL</given-names></name></person-group><article-title>Measuring health-related quality of life</article-title><source>Ann Intern Med</source><year>1993</year><volume>118</volume><fpage>622</fpage><lpage>629</lpage><pub-id pub-id-type="pmid">8452328</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Scarpelli</surname><given-names>AC</given-names></name><name><surname>Paiva</surname><given-names>SM</given-names></name><name><surname>Pordeus</surname><given-names>IA</given-names></name><name><surname>Ramos-Jorge</surname><given-names>ML</given-names></name><name><surname>Varni</surname><given-names>JW</given-names></name><name><surname>Allison</surname><given-names>PJ</given-names></name></person-group><article-title>Measurement properties of the Brazilian version of the Pediatric Quality of Life Inventory (PedsQL) cancer module scale</article-title><source>Health and quality of life outcomes</source><year>2008</year><volume>6</volume><fpage>7</fpage><pub-id pub-id-type="pmid">18211688</pub-id><pub-id pub-id-type="doi">10.1186/1477-7525-6-7</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Allison</surname><given-names>PJ</given-names></name></person-group><article-title>Health-related quality of life comparisons in French and English-speaking populations</article-title><source>Community Dent Health</source><year>2001</year><volume>18</volume><fpage>214</fpage><lpage>218</lpage><pub-id pub-id-type="pmid">11789698</pub-id></citation></ref><ref id="B27"><citation citation-type="other"><article-title>PedsQL&#x02122; Translation methodology</article-title><ext-link ext-link-type="uri" xlink:href="http://www.pedsql.org/index.html"/></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jenkinson</surname><given-names>C</given-names></name></person-group><article-title>Evaluating the efficacy of medical treatment: possibilities and limitations</article-title><source>Social science &#x00026; medicine (1982)</source><year>1995</year><volume>41</volume><fpage>1395</fpage><lpage>1401</lpage><pub-id pub-id-type="pmid">8560307</pub-id></citation></ref><ref id="B29"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Shrout</surname><given-names>PE</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Zahner TTA</surname></name></person-group><article-title>Reliability</ar