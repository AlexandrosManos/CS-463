off="50">0.051</td><td align="char" valign="top" char="." charoff="50">92.3</td><td align="char" valign="top" char="." charoff="50">47.5</td><td align="char" valign="top" char="." charoff="50">0.002</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Sex</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Female</td><td align="char" valign="top" char="." charoff="50">100.0</td><td align="char" valign="top" char="." charoff="50">83.7</td><td align="char" valign="top" char="." charoff="50">0.049</td><td align="char" valign="top" char="." charoff="50">77.7</td><td align="char" valign="top" char="." charoff="50">44.1</td><td align="char" valign="top" char="." charoff="50">0.057</td><td align="char" valign="top" char="." charoff="50">89.5</td><td align="char" valign="top" char="." charoff="50">63.9</td><td align="char" valign="top" char="." charoff