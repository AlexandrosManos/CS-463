="." charoff="50">100.0</td><td align="center" valign="top" charoff="50">&#x0003e;0.999</td><td align="char" valign="top" char="." charoff="50">100.0</td><td align="char" valign="top" char="." charoff="50">50.0</td><td align="char" valign="top" char="." charoff="50">0.400</td><td align="char" valign="top" char="." charoff="50">100.0</td><td align="char" valign="top" char="." charoff="50">50.0</td><td align="char" valign="top" char="." charoff="50">0.400</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;T2</td><td align="char" valign="top" char="." charoff="50">100.0</td><td align="char" valign="top" char="." charoff="50">66.7</td><td align="center" valign="top" charoff="50">0.192</td><td align="char" valign="top" char="." charoff="50">77.2</td><td align="char" valign="top" char="." charoff="50">33.3</td><td align="char" valign="top" char="." charoff="50">0.118</td><td align="char" valign="top" char="." charoff="50">80.0</td><td align="char" valign="top" char="." charoff="50">33.3</td><td align="char" valign="top" char="." charoff="50">0.260</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;T3</td><td align="char" valign="top" char="." charoff="50">100.0</td><td align="char" valign="top" char="." charoff="50">94.4</td><td align="center" valign="top" charoff="50">0.499</td><td align="char" valign="top" char="." charoff="50">75.0</td><td align="char" valign="top" char="." charoff="50">23.3</td><td align="char" valign="top" char="." charoff="50">0.174</td><td align="char" valign="top" char="." charoff="50">95.2</td><td align="char" valign="top" char="." charoff="50">72.4</td><td align="char" valign="top" char="." charoff="50">0.042</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;T4</td><td align="char" valign="top" char="." charoff="50">83.3</td><td align="char" valign="top" char="." charoff="50">29.4</td><td align="center" valign="top" charoff="50">0.041</td><td align="char" valign="top" char="." charoff="50">50.1</td><td 