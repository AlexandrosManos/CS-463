pub-id><pub-id pub-id-type="doi">10.1053/berh.1999.0039</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ernst</surname><given-names>E</given-names></name></person-group><article-title>Usage of complementary therapies in rheumatology: a systematic review</article-title><source>Clin Rheumatol</source><year>1998</year><volume>17</volume><fpage>301</fpage><lpage>305</lpage><pub-id pub-id-type="pmid">9776112</pub-id><pub-id pub-id-type="doi">10.1007/BF01451009</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ponholzer</surname><given-names>A</given-names></name><name><surname>Struhal</surname><given-names>G</given-names></name><name><surname>Madersbacher</surname><given-names>S</given-names></name></person-group><article-title>Frequent use of complementary medicine by prostate cancer patients</article-title><source>Eur Urol</source><year>2003</year><volume>43</volume><fpage>604</fpage><lpage>608</lpage><pub-id pub-id-type="pmid">12767359</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ernst</surname><given-names>E</given-names></name><name><surname>Cassileth</surname><given-names>BR</given-names></name></person-group><article-title>The prevalence of complementary/alternative medicine in cancer: a systematic review</article-title><source>Cancer</source><year>1998</year><volume>83</volume><fpage>777</fpage><lpage>782</lpage><pub-id pub-id-type="pmid">9708945</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1097-0142(19980815)83:4&#x0003c;777::AID-CNCR22&#x0003e;3.0.CO;2-O</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ernst</surname><given-names>E</given-names></name><name><surname>Filshie</surname><given-names>J</given-names></name><name><surname>Hardy</s