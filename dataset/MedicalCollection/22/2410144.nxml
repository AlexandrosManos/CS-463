e></person-group><article-title>Average risks of breast and ovarian cancer associated with mutations in BRCA1 and BRCA2 detected in case series unselected for family history: a combined analysis of 22 studies</article-title><source>Am J Hum Genet</source><year>2003</year><volume>72</volume><fpage>1117</fpage><lpage>1130</lpage><!--PubMed citation query: 'Am J Hum Genet||72|1117||bib1|'--><pub-id pub-id-type="pmid">12677558</pub-id></citation></ref><ref id="bib2"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Breslow</surname><given-names>NE</given-names></name><name><surname>Day</surname><given-names>NE</given-names></name></person-group><article-title>Statistical methods in cancer research. Volume I &#x02013; The analysis of case&#x02013;control studies</article-title><source>IARC Sci Publ</source><year>1980</year><supplement>32</supplement><fpage>5</fpage><lpage>338</lpage></citation></ref><ref id="bib4"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Del Tito</surname><given-names>BJ</given-names><suffix>Jr</suffix></name><name><surname>Poff</surname><given-names>HE</given-names><suffix>III</suffix></name><name><surname>Novotny</surname><given-names>MA</given-names></name><name><surname>Cartledge</surname><given-names>DM</given-names></name><name><surname>Walker</surname><given-names>RI</given-names><suffix>II</suffix></name><name><surname>Earl</surname><given-names>CD</given-names></name></person-group><article-title>Automated fluorescent analysis procedure for enzymatic mutation detection</article-title><source>Clin Chem</source><year>1998</year><volume>44</volume><fpage>731</fpage><lpage>739</lpage><!--PubMed citation query: 'Clin Chem||44|731||bib4|'--><pub-id pub-id-type="pmid">9554483</pub-id></citation></ref><ref id="bib5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ford</surname><given-names>D</given-names></name><name><surname>