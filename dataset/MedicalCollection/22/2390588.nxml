urnal"><person-group person-group-type="author"><name><surname>McDermott</surname><given-names>R</given-names></name><name><surname>Rowley</surname><given-names>KG</given-names></name><name><surname>Lee</surname><given-names>AJ</given-names></name><name><surname>Knight</surname><given-names>S</given-names></name><name><surname>'Dea</surname><given-names>K</given-names></name></person-group><article-title>Increase in prevalence of obesity and diabetes and decrease in plasma cholesterol in a central Australian Aboriginal community</article-title><source>Med J Aust</source><year>2000</year><volume>172</volume><fpage>480</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">10901770</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shilton</surname><given-names>TR</given-names></name><name><surname>Brown</surname><given-names>W</given-names></name></person-group><article-title>Physical Activity among Aboriginal and Torres Strait Islander people and communities</article-title><source>J Sci Med Sport</source><year>2004</year><volume>7</volume><fpage>39</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">15214600</pub-id><pub-id pub-id-type="doi">10.1016/S1440-2440(04)80276-7</pub-id></citation></ref><ref id="B12"><citation citation-type="other"><article-title>Department of Health and Aged Care National Physical Activity Guidelines for Australians</article-title><source>Canberra</source><year>1999</year></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Donovan</surname><given-names>RJ</given-names></name><name><surname>Spark</surname><given-names>R</given-names></name></person-group><article-title>Towards guidelines for survey research in remote Aboriginal communities</article-title><source>Aust N Z J Public Health</source><year>1997</year><volume>21</volume><fpage>89</fpage><lpage>95</lpage><pub-id pub-id-type="pmid">9141736</pub-id><pub-id pub-id-type="doi">10.1111/j.1467-842X.1997.tb01660.x</pub-id></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Marshall</surname><given-names>AL</given-names></name><name><surname>Miller</surname><given-names>R</given-names></name></person-group><article-title>Measuring physical activity among urban Indigenous Australians</article-title><source>Report prepared for Commonwealth of Health and Ageing</source><publisher-name>Canberra, Australia</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.health.gov.au/internet/wcms/publishing.nsf/Content/health-pubhlth-strateg-active-links.htm-copy3/$FILE/indigenous.pdf"/><comment>last accessed April 11, 2008</comment></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bauman</surname><given-names>A</given-names></name><name><surname>Ford</surname><given-names>I</given-names></name><name><surname>Armstrong</surname><given-names>T</given-names></name></person-group><source>Trends in population levels of reported physical activity in Australia, 1997, 1999 and 2000</source><year>2001</year><publisher-name>Canberra: Australian Sports Commission</publisher-name></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bauman</surname><given-names>A</given-names></name><name><surname>Armstrong</surname><given-names>T</given-names></name><name><surname>Davies</surname><given-names>J</given-names></name><name><surname>Owen</surname><given-names>N</given-names></name><name><surname>Brown</surname><given-names>W</given-names></name><name><surname>Bellew</surname><given-names>B</given-names></name><name><surname>Vita</surname><given-names>P</given-names></name></person-group><article-title>Trends in physical activity participation and the impact of integrated campaigns among Australian adults, 1997&#x02013;99</article-title><source>Aust N Z J Public Health</source><year>2003</year><volume>27</volume><fpage>76</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">14705272</pub-id><pub-id pub-id-type="doi">10.1111/j.1467-842X.2003.tb00384.x</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Booth</surname><given-names>M</given-names></name><name><surname>Bauman</surname><given-names>A</given-names></name><name><surname>Owen</surname><given-names>N</given-names></name><name><surname>Gore</surname><given-names>C</given-names></name></person-group><article-title>Physical activity preferences, preferred sources of assistance and perceived barriers to increased physical activity among physically inactive Australians</article-title><source>Prev Med</source><year>1997</year><fpage>131</fpage><lpage>137</lpage><pub-id pub-id-type="pmid">9010908</pub-id><pub-id pub-id-type="doi">10.1006/pmed.1996.9982</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marshall</surname><given-names>AL</given-names></name><name><surname>Eakin</surname><given-names>E</given-names></name><name><surname>Leslie</surname><given-names>E</given-names></name><name><surname>Owen</surname><given-names>N</given-names></name></person-group><article-title>Feasibility of using the Internet for physical activity program delivery</article-title><source>Health Promot J Aust</source><year>2005</year><volume>16</volume><fpage>82</fpage><lpage>84</lpage></citation></ref></ref-list></back></article>