me><given-names>P</given-names></name><etal/></person-group><article-title>In vitro screening of Indian medicinal plants for antiplasmodial activity</article-title><source>J Ethnopharmacol</source><year>2001</year><volume>74</volume><fpage>195</fpage><pub-id pub-id-type="pmid">11167038</pub-id></citation></ref><ref id="B19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Row</surname><given-names>L</given-names></name><name><surname>Sankara</surname><given-names>R</given-names></name><name><surname>Ramaiah</surname><given-names>T</given-names></name></person-group><article-title>Chemical examination of Diospyros species. IV. Triterpenes of the leaves of <italic>D. sylvatica</italic> and <italic>D. melanoxylon</italic></article-title><source>Current Science</source><year>1966</year><volume>35</volume><fpage>485</fpage></citation></ref><ref id="B20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ganapaty</surname><given-names>S</given-names></name><name><surname>Thomas</surname><given-names>PS</given-names></name><name><surname>Fotso</surname><given-names>S</given-names></name><name><surname>Laatsch</surname><given-names>H</given-names></name></person-group><article-title>Antitermitic quinones from <italic>Diospyros sylvatica</italic></article-title><source>Phytochemistry</source><year>2004</year><volume>65</volume><fpage>1265</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">15184011</pub-id></citation></ref><ref id="B21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Steele</surname><given-names>JC</given-names></name><name><surname>Warhurst</surname><given-names>DC</given-names></name><name><surname>Kirby</surname><given-names>GC</given-names></name><name><surname>Simmonds</surname><given-names>MS</given-names></name></person-group><article-title><italic>In vitro</italic> and <italic>in vivo</italic> evaluation of betulinic acid as an antimalarial</article-title><source>Phytother Res</source><year>1999</year><volume>13</volume><fpage>115</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">10190183</pub-id></citation></ref><ref id="B22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bringmann</surname><given-names>G</given-names></name><name><surname>Saeb</surname><given-names>W</given-names></name><name><surname>Assi</surname><given-names>LA</given-names></name><name><surname>Francois</surname><given-names>G</given-names></name><name><surname>Sankara Narayanan</surname><given-names>AS</given-names></name><name><surname>Peters</surname><given-names>K</given-names></name><etal/></person-group><article-title>Betulinic acid: isolation from <italic>Triphyophyllum peltatum</italic> and <italic>Ancistrocladus heyneanus</italic>, antimalarial activity, and crystal structure of the benzyl ester</article-title><source>Planta Med</source><year>1997</year><volume>63</volume><fpage>255</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">9225608</pub-id></citation></ref><ref id="B23"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Alves</surname><given-names>TM</given-names></name><name><surname>Nagem</surname><given-names>TJ</given-names></name><name><surname>de Carvalho</surname><given-names>LH</given-names></name><name><surname>Krettli</surname><given-names>AU</given-names></name><name><surname>Zani</surname><given-names>CL</given-names></name></person-group><article-title>Antiplasmodial triterpene from <italic>Vernonia brasiliana</italic></article-title><source>Planta Med</source><year>1997</year><volume>63</volume><fpage>554</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">9434611</pub-id></citation></ref><ref id="B24"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Amusan</surname><giv