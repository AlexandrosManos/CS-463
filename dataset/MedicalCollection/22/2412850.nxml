 communis </italic>L.</td><td align="left">oldula</td><td align="center">MN 46</td><td align="center">SH</td><td align="left">Leaves</td><td align="left">Hot decoction</td><td align="left">Malaria, fevers, RAB</td><td></td></tr><tr><td align="left">Lamiaceae</td><td align="left"><italic>Ajuga remota</italic>.Benth</td><td align="left">Lmenang'i</td><td align="center">MN 3</td><td align="center">H</td><td align="left">leaves, roots</td><td align="left">Crushing, hot decoction with soup</td><td align="left">RAB, GIT complications, Anaplasmosis, Mastitis</td><td align="center">po</td></tr><tr><td align="left">Loranthaceae</td><td align="left"><italic>Odontella fischeri</italic></td><td align="left">Larrudenyai</td><td align="center">MN 43</td><td align="center">TR</td><td align="left">Stem bark</td><td align="left">Hot decoction</td><td align="left">Retained afterbirth, Wounds</td><td align="center">po</td></tr><tr><td align="left">Meliaceae</td><td align="left"><italic>Azadirachta indica </italic>A. Juss.</td><td align="left">Mwarubaini</td><td align="center">MN 29</td><td align="center">TR</td><td align="left">Leaves, Stem barks</td><td align="left">Stem cutting, pounding, Hot/cold decoction</td><td align="left">Malaria, Fevers, GIT complications</td><td align="center">po</td></tr><tr><td align="left">Mimosaceae</td><td align="left"><italic>Acacia abyssinica </italic>Hochst.</td><td align="left">Lngingiletome</td><td align="center">MN 45</td><td align="center">TR</td><td align="left">Root bark</td><td align="left">Homogenization</td><td align="left">Gastrointestinal distress, Lumbago and arthritis</td><td align="center">po</td></tr><tr><td></td><td align="left"><italic>Acacia drepanolobium</italic></td><td align="left">Rangau</td><td align="center">MN 51</td><td align="center">TR</td><td align="left">Root bark</td><td align="left">Powdering, Cold decoction</td><td align="left">RAB, Babesiosis, GIT complications</td><td></td></tr><tr><td></td><td align="left"><italic>