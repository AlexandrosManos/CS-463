me><fpage>121</fpage><lpage>129</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rohra</surname><given-names>DK</given-names></name><name><surname>Gilani</surname><given-names>AH</given-names></name><name><surname>Memon</surname><given-names>IK</given-names></name><name><surname>Perven</surname><given-names>G</given-names></name><name><surname>Khan</surname><given-names>MT</given-names></name><name><surname>Zafar</surname><given-names>H</given-names></name><name><surname>Kumar</surname><given-names>R</given-names></name></person-group><article-title>Critical evaluation of the claims made by pharmaceutical companies in drug promotional material in Pakistan</article-title><source>J Pharm Pharm Sci</source><year>2006</year><volume>9</volume><fpage>50</fpage><lpage>59</lpage><pub-id pub-id-type="pmid">16849008</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burak</surname><given-names>LJ</given-names></name><name><surname>Damico</surname><given-names>A</given-names></name></person-group><article-title>College students' use of widely advertised medications</article-title><source>J Am Coll Health</source><year>2000</year><volume>49</volume><fpage>118</fpage><lpage>121</lpage><pub-id pub-id-type="pmid">11125639</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldie</surname><given-names>J</given-names></name><name><surname>Schwartz</surname><given-names>L</given-names></name><name><surname>McConnachie</surname><given-names>A</given-names></name><name><surname>Morrison</surname><given-names>J</given-names></name></person-group><article-title>The impact of a modern medical curriculum on students' proposed behaviour on meeting ethical dilemmas</article-title><source>Med Educ</source><year>2004</year><volume>38</volume><fpage>942</fpage><lp