ven-names>MG</given-names></name><name><surname>Vesque</surname><given-names>C</given-names></name><name><surname>Vincent</surname><given-names>A</given-names></name><name><surname>Charnay</surname><given-names>P</given-names></name><article-title>Family of Ebf/Olf-1-related genes potentially involved in neuronal differentiation and regional specification in the central nervous system</article-title><source>Dev Dyn</source><year>1997</year><volume>210</volume><fpage>191</fpage><lpage>205</lpage><pub-id pub-id-type="doi">10.1002/(SICI)1097-0177(199711)210:3&#x0003c;191::AID-AJA1&#x0003e;3.0.CO;2-B</pub-id><pub-id pub-id-type="pmid">9389446</pub-id></mixed-citation></ref><ref id="B7"><mixed-citation publication-type="journal"><name><surname>Wang</surname><given-names>SS</given-names></name><name><surname>Betz</surname><given-names>AG</given-names></name><name><surname>Reed</surname><given-names>RR</given-names></name><article-title>Cloning of a novel Olf-1/EBF-like gene, O/E-4, by degenerate oligo-based direct selection</article-title><source>Mol Cell Neurosci</source><year>2002</year><volume>20</volume><fpage>404</fpage><lpage>14</lpage><pub-id pub-id-type="doi">10.1006/mcne.2002.1138</pub-id><pub-id pub-id-type="pmid">12139918</pub-id></mixed-citation></ref><ref id="B8"><mixed-citation publication-type="journal"><name><surname>SS</surname><given-names>Tsai</given-names></name><name><surname>Wang</surname><given-names>RY</given-names></name><name><surname>Reed</surname><given-names>RR</given-names></name><article-title>The characterization of the Olf-1/EBF-like HLH transcription factor family: implications in olfactory gene regulation and neuronal development</article-title><source>J Neurosci</source><year>1997</year><volume>17</volume><fpage>4149</fpage><lpage>58</lpage><pub-id pub-id-type="pmid">9151732</pub-id></mixed-citation></ref><ref id="B9"><mixed-citation publication-type="journal"><name><surname>Dubois</surname><given-names>L</given-names></name><name><surname>Bally-Cuif</surname><given-names>L</given-names></name><name><surname>Crozatier</surname><given-names>M</given-names></name><name><surname>Moreau</surname><given-names>J</given-names></name><name><surname>Paquereau</surname><given-names>L</given-names></name><name><surname>Vincent</surname><given-names>A</given-names></name><article-title>XCoe2, a transcription factor of the Col/Olf-1/EBF family involved in the specification of primary neurons in Xenopus</article-title><source>Curr Biol</source><year>1998</year><volume>8</volume><fpage>199</fpage><lpage>209</lpage><pub-id pub-id-type="doi">10.1016/S0960-9822(98)70084-3</pub-id><pub-id pub-id-type="pmid">9501982</pub-id></mixed-citation></ref><ref id="B10"><mixed-citation publication-type="journal"><name><surname>Prasad</surname><given-names>BC</given-names></name><name><surname>Ye</surname><given-names>B</given-names></name><name><surname>Zackhary</surname><given-names>R</given-names></name><name><surname>Schrader</surname><given-names>K</given-names></name><name><surname>Seydoux</surname><given-names>G</given-names></name><name><surname>Reed</surname><given-names>RR</given-names></name><article-title>unc-3, a gene required for axonal guidance in Caenorhabditis elegans, encodes a member of the O/E family of transcription factors</article-title><source>Development</source><year>1998</year><volume>125</volume><fpage>1561</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">9502737</pub-id></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><name><surname>Dubois</surname><given-names>L</given-names></name><name><surname>Vincent</surname><given-names>A</given-names></name><article-title>The COE&#x02013;Collier/Olf1/EBF&#x02013;transcription factors: structural conservation and diversity of developmental functions</article-title><source>Mech Dev</source><year>2001</year><volume>108</volume><fpage>3</fpage><lpage>12</lpage><pub-id pub-id-type="doi">10.1016/S0925-4773(01)00486-5</pub-id><pub-id