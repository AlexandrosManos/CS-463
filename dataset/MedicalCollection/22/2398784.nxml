lign="left" rowspan="1" colspan="1"><xref ref-type="table-fn" rid="nt101">&#x0002a;</xref>GS00c</td><td align="left" rowspan="1" colspan="1">Open ocean</td><td align="left" rowspan="1" colspan="1">02/25/03</td><td align="left" rowspan="1" colspan="1">13:00</td><td align="left" rowspan="1" colspan="1">19.8</td><td align="left" rowspan="1" colspan="1">368,835</td><td align="left" rowspan="1" colspan="1">36</td><td align="left" rowspan="1" colspan="1">425</td><td align="left" rowspan="1" colspan="1">2,805</td></tr><tr><td align="left" rowspan="1" colspan="1">GS00d</td><td align="left" rowspan="1" colspan="1">Open ocean</td><td align="left" rowspan="1" colspan="1">02/25/03</td><td align="left" rowspan="1" colspan="1">17:00</td><td align="left" rowspan="1" colspan="1">20.0</td><td align="left" rowspan="1" colspan="1">332,240</td><td align="left" rowspan="1" colspan="1">25</td><td align="left" rowspan="1" colspan="1">168</td><td align="left" rowspan="1" colspan="1">2,544</td></tr><tr><td align="left" rowspan="1" colspan="1"><xref ref-type="table-fn" rid="nt102">&#x0002a;&#x0002a;</xref>GS01a</td><td align="left" rowspan="1" colspan="1">Open ocean</td><td align="left" rowspan="1" colspan="1">05/15/03</td><td align="left" rowspan="1" colspan="1">11:40</td><td align="left" rowspan="1" colspan="1">22.9</td><td align="left" rowspan="1" colspan="1">142,352</td><td align="left" rowspan="1" colspan="1">13</td><td align="left" rowspan="1" colspan="1">33</td><td align="left" rowspan="1" colspan="1">322</td></tr><tr><td align="left" rowspan="1" colspan="1">GS01b</td><td align="left" rowspan="1" colspan="1">Open ocean</td><td align="left" rowspan="1" colspan="1">05/15/03</td><td align="left" rowspan="1" colspan="1">11:40</td><td align="left" rowspan="1" colspan="1">22.9</td><td align="left" rowspan="1" colspan="1">90,905</td><td align="left" rowspan="1" colspan="1">14</td><td align="left" rowspan="1" colspan="1">28</td><td align="left" rowspan="1" colspan="1">331</td></tr><tr><td ali