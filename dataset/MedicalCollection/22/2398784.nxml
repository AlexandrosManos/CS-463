d-type="pmid">8811175</pub-id></citation></ref><ref id="pgen.1000095-Driscoll1"><label>5</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Driscoll</surname><given-names>DM</given-names></name><name><surname>Copeland</surname><given-names>PR</given-names></name></person-group><year>2003</year><article-title>Mechanism and regulation of selenoprotein synthesis.</article-title><source>Annu Rev Nutr</source><volume>23</volume><fpage>17</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">12524431</pub-id></citation></ref><ref id="pgen.1000095-Papp1"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Papp</surname><given-names>LV</given-names></name><name><surname>Lu</surname><given-names>J</given-names></name><name><surname>Holmgren</surname><given-names>A</given-names></name><name><surname>Khanna</surname><given-names>KK</given-names></name></person-group><year>2007</year><article-title>From selenium to selenoproteins: synthesis, identity, and their role in human health.</article-title><source>Antioxid Redox Signal</source><volume>9</volume><fpage>775</fpage><lpage>806</lpage><pub-id pub-id-type="pmid">17508906</pub-id></citation></ref><ref id="pgen.1000095-Low1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Low</surname><given-names>S</given-names></name><name><surname>Berry</surname><given-names>MJ</given-names></name></person-group><year>1996</year><article-title>Knowing when not to stop: selenocysteine incorporation in eukaryotes.</article-title><source>Trends Biochem Sci</source><volume>21</volume><fpage>203</fpage><lpage>208</lpage><pub-id pub-id-type="pmid">8744353</pub-id></citation></ref><ref id="pgen.1000095-Bck1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>B&#x000f6;ck</surname><given-names>A</given-names></name></person-group><year>2000</year><article-title>Biosynthesis of selenoproteins&#x02013;an overview.</article-title><source>Biofactors</source><volume>11</volume><fpage>77</fpage><lpage>78</lpage><pub-id pub-id-type="pmid">10705967</pub-id></citation></ref><ref id="pgen.1000095-Bck2"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>B&#x000f6;ck</surname><given-names>A</given-names></name><name><surname>Forchhammer</surname><given-names>K</given-names></name><name><surname>Heider</surname><given-names>J</given-names></name><name><surname>Leinfelder</surname><given-names>W</given-names></name><name><surname>Sawers</surname><given-names>G</given-names></name><etal/></person-group><year>1991</year><article-title>Selenocysteine: the 21<sup>st</sup> amino acid.</article-title><source>Mol Microbiol</source><volume>5</volume><fpage>515</fpage><lpage>520</lpage><pub-id pub-id-type="pmid">1828528</pub-id></citation></ref><ref id="pgen.1000095-Rother1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rother</surname><given-names>M</given-names></name><name><surname>Resch</surname><given-names>A</given-names></name><name><surname>Wilting</surname><given-names>R</given-names></name><name><surname>B&#x000f6;ck</surname><given-names>A</given-names></name></person-group><year>2001</year><article-title>Selenoprotein synthesis in archaea.</article-title><source>Biofactors</source><volume>14</volume><fpage>75</fpage><lpage>83</lpage><pub-id pub-id-type="pmid">11568443</pub-id></citation></ref><ref id="pgen.1000095-Yuan1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yuan</surname><given-names>J</given-names></name><name><surname>Palioura</surname><given-names>S</given-names></name><name><surname>Salazar</surname><given-names>JC</given-names></name><name><surname>Su</surname><given-names>D</given-names></name><name><surname>O'Donoghue</surname><given-names>P</given-names></name><etal/></person-group><year>2006</year><article-title>RNA-dependent conversion of phosphoserine forms selenocysteine in eukaryotes and archaea.</article-title><source>Proc Natl Acad Sci U S A</source><volume>103</volume><fpage>18923</fpage><lpage>18927</lpage><pub-id pub-id-type="pmid">17142313</pub-id></citation></ref><ref id="pgen.1000095-Xu1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Xu</surname><given-names>XM</given-names></name><name><surname>Carlson</surname><given-names>BA</given-names></name><name><surname>Mix</surname><given-names>H</given-names></name><name><surname>Zhang</surname><given-names>Y</given-names></name><name><surname>Saira</surname><given-names>K</given-names></name><etal/></person-group><year>2007</year><article-title>Biosynthesis of selenocysteine on its tRNA in eukaryotes.</article-title><source>PloS Biol</source><volume>5</volume><fpage>e4</fpage><pub-id pub-id-type="pmid">17194211</pub-id></citation></ref><ref id="pgen.1000095-Bck3"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>B&#x000f6;ck</surname><given-names>A</given-names></name><name><surname>Forchhammer</surname><given-names>K</given-names></name><name><surname>Heider</surname><given-names>J</given-names></name><name><surname>Baron</surname><given-names>C</given-names></name></person-group><year>1991</year><article-title>Selenoprotein synthesis: an expansion of the genetic code.</article-title><source>Trends Biochem Sci</source><volume>16</volume><fpage>463</fpage><lpage>467</lpage><pub-id pub-id-type="pmid">1838215</pub-id></citation></ref><ref id="pgen.1000095-Berry1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berry</surname><given-names>MJ</given-names></name><name><surname>Banu</surname><given-names>L</given-names></name><name><surname>Harney</surname><given-names>JW</given-names></name><name><surname>Larsen</surname><given-names>PR</given-names></name></person-group><year>1993</year><article-title>Functional characterization of the eukaryotic SECIS elements which direct selenocysteine insertion at UGA codons.</article-title><source>EMBO J</source><volume>12</volume><fpage>3315</fpage><lpage>3322</lpage><pub-id pub-id-type="pmid">8344267</pub-id></citation></ref><ref id="pgen.1000095-Thanbichler1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thanbichler</surname><given-names>M</given-names></name><name><surname>B&#x000f6;ck</surname><given-names>A</given-names></name></person-group><year>2002</year><article-title>The function of SECIS RNA in translational control of gene expression in Escherichia coli.</article-title><source>EMBO J</source><volume>21</volume><fpage>6925</fpage><lpage>6934</lpage><pub-id pub-id-type="pmid">12486013</pub-id></citation></ref><ref id="pgen.1000095-Liu1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>Z</given-names></name><name><surname>Reches</surname><given-names>M</given-names></name><name><surname>Groisman</surname><given-names>I</given-names></name><name><surname>Engelberg-Kulka</surname><given-names>H</given-names></name></person-group><year>1998</year><article-title>The nature of the minimal &#x02018;selenocysteine insertion sequence&#x02019; (SECIS) in Escherichia coli.</article-title><source>Nucleic Acids Res</source><volume>26</volume><fpage>896</fpage><lpage>902</lpage><pub-id pub-id-type="pmid">9461445</pub-id></citation></ref><ref id="pgen.1000095-Hatfield2"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hatfield</surname><given-names>DL</given-names></name><name><surname>Gladyshev</surname><given-names>VN</given-names></name></person-group><year>2002</year><article-tit