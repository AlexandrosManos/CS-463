.001)</td><td align="left" rowspan="1" colspan="1">UxxC</td><td align="left" rowspan="1" colspan="1">212</td><td align="left" rowspan="1" colspan="1">33</td><td align="left" rowspan="1" colspan="1">183</td></tr><tr><td align="left" rowspan="1" colspan="1">Prx-like 2<xref ref-type="table-fn" rid="nt103">&#x0002a;</xref></td><td align="left" rowspan="1" colspan="1">pfam04592 (e-value&#x0003e;0.001)</td><td align="left" rowspan="1" colspan="1">UxxC</td><td align="left" rowspan="1" colspan="1">99</td><td align="left" rowspan="1" colspan="1">23</td><td align="left" rowspan="1" colspan="1">100</td></tr><tr><td align="left" rowspan="1" colspan="1">FdhA</td><td align="left" rowspan="1" colspan="1">COG0243</td><td align="left" rowspan="1" colspan="1">-</td><td align="left" rowspan="1" colspan="1">95</td><td align="left" rowspan="1" colspan="1">15</td><td align="left" rowspan="1" colspan="1">2,271</td></tr><tr><td align="left" rowspan="1" colspan="1">Arsenate reductase (ArsC) 1<xref ref-type="table-fn" rid="nt103">&#x0002a;</xref></td><td align="left" rowspan="1" colspan="1">pfam03960</td><td align="left" rowspan="1" colspan="1">UxxS</td><td align="left" rowspan="1" colspan="1">77</td><td align="left" rowspan="1" colspan="1">23</td><td align="left" rowspan="1" colspan="1">784</td></tr><tr><td align="left" rowspan="1" colspan="1">COG0737, UshA-like</td><td align="left" rowspan="1" colspan="1">COG0737</td><td align="left" rowspan="1" colspan="1">CxU</td><td align="left" rowspan="1" colspan="1">76</td><td align="left" rowspan="1" colspan="1">20</td><td align="left" rowspan="1" colspan="1">92</td></tr><tr><td align="left" rowspan="1" colspan="1">AhpD-like 2<xref ref-type="table-fn" rid="nt103">&#x0002a;</xref></td><td align="left" rowspan="1" colspan="1">pfam02627</td><td align="left" rowspan="1" colspan="1">CxxU</td><td align="left" rowspan="1" colspan="1">70</td><td align="left" rowspan="1" colspan="1">25</td><td align="left" rowspan="1" colspan="1">207</td></tr><tr><td align="