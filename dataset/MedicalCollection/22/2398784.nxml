nt103">&#x0002a;</xref></td><td align="left" rowspan="1" colspan="1">COG0386</td><td align="left" rowspan="1" colspan="1">-</td><td align="left" rowspan="1" colspan="1">40</td><td align="left" rowspan="1" colspan="1">18</td><td align="left" rowspan="1" colspan="1">3,287</td></tr><tr><td align="left" rowspan="1" colspan="1">Deiodinase-like</td><td align="left" rowspan="1" colspan="1">pfam00837</td><td align="left" rowspan="1" colspan="1">-</td><td align="left" rowspan="1" colspan="1">22</td><td align="left" rowspan="1" colspan="1">12</td><td align="left" rowspan="1" colspan="1">21</td></tr><tr><td align="left" rowspan="1" colspan="1">Trx-like 2 (Thiol&#x02236;disulfide interchange protein)<xref ref-type="table-fn" rid="nt103">&#x0002a;</xref></td><td align="left" rowspan="1" colspan="1">cd02953</td><td align="left" rowspan="1" colspan="1">UxxC</td><td align="left" rowspan="1" colspan="1">22</td><td align="left" rowspan="1" colspan="1">13</td><td align="left" rowspan="1" colspan="1">2,098</td></tr><tr><td align="left" rowspan="1" colspan="1">MoeB</td><td align="left" rowspan="1" colspan="1">pfam05237</td><td align="left" rowspan="1" colspan="1">-</td><td align="left" rowspan="1" colspan="1">19</td><td align="left" rowspan="1" colspan="1">7</td><td align="left" rowspan="1" colspan="1">2,262</td></tr><tr><td align="left" rowspan="1" colspan="1">DsrE 2<xref ref-type="table-fn" rid="nt103">&#x0002a;</xref></td><td align="left" rowspan="1" colspan="1">pfam02635</td><td align="left" rowspan="1" colspan="1">UxxC</td><td align="left" rowspan="1" colspan="1">19</td><td align="left" rowspan="1" colspan="1">8</td><td align="left" rowspan="1" colspan="1">15</td></tr><tr><td align="left" rowspan="1" colspan="1">DsbA 2<xref ref-type="table-fn" rid="nt103">&#x0002a;</xref></td><td align="left" rowspan="1" colspan="1">pfam01323 (e-value&#x0003e;0.001)</td><td align="left" rowspan="1" colspan="1">UxxC</td><td align="left" rowspan="1" colspan="1">18</td><td align="left" rowspan="1" col