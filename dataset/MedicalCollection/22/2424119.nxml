><etal/></person-group><article-title>Impaired auditory gating and P50 nonsuppression following traumatic brain injury</article-title><source>J Neuropsychiatry Clin Neurosci</source><year>2000</year><volume>12</volume><fpage>77</fpage><lpage>85</lpage><pub-id pub-id-type="pmid">10678517</pub-id></citation></ref><ref id="b7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arciniegas</surname><given-names>DB</given-names></name></person-group><article-title>The cholinergic hypothesis of cognitive impairment caused by traumatic brain injury</article-title><source>Curr Psychiatry Rep</source><year>2003</year><volume>5</volume><fpage>391</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">13678561</pub-id></citation></ref><ref id="b8"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Arciniegas</surname><given-names>DB</given-names></name><name><surname>Anderson</surname><given-names>CA</given-names></name><name><surname>Rojas</surname><given-names>DC</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Silver</surname><given-names>JM</given-names></name><name><surname>McAllister</surname><given-names>TW</given-names></name><name><surname>Yudofsky</surname><given-names>SC</given-names></name></person-group><article-title>Electrophysiological techniques</article-title><source>Textbook of traumatic brain injury</source><year>2004</year><publisher-loc>Washington</publisher-loc><publisher-name>American Psychiatric Publ</publisher-name><fpage>135</fpage><lpage>7</lpage></citation></ref><ref id="b9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arciniegas</surname><given-names>DB</given-names></name><name><surname>Silver</surname><given-names>JM</given-names></name></person-group><article-title>Regarding the search for a unified definition of mild traumatic brain injury</article-title><source>Brain Inj</source><year>2001</year><volume>15</volume><fpage>649</fpage><lpage>52</lpage><pub-id pub-id-type="pmid">11429094</pub-id></citation></ref><ref id="b10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arciniegas</surname><given-names>DB</given-names></name><name><surname>Topkoff</surname><given-names>JL</given-names></name></person-group><article-title>Applications of the P50 evoked response to the evaluation of cognitive impairments after traumatic brain injury</article-title><source>Phys Med Rehabil Clin N Am</source><year>2004</year><volume>15</volume><fpage>177</fpage><lpage>203</lpage><comment>viii</comment><pub-id pub-id-type="pmid">15029905</pub-id></citation></ref><ref id="b11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arciniegas</surname><given-names>DB</given-names></name><name><surname>Topkoff</surname><given-names>JL</given-names></name><name><surname>Filley</surname><given-names>CM</given-names></name><etal/></person-group><article-title>Apolipoprotein-E4 in association with persistent neurophysiologic impairment after mild traumatic brain injury</article-title><source>J Neuropsychiatry Clin Neurosci</source><year>2003</year><volume>15</volume><fpage>276</fpage></citation></ref><ref id="b12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arciniegas</surname><given-names>DB</given-names></name><name><surname>Topkoff</surname><given-names>J</given-names></name><name><surname>Rojas</surname><given-names>DC</given-names></name><etal/></person-group><article-title>Reduced hippocampal volume in association with P50 nonsuppression following traumatic brain injury</article-title><source>J Neuropsychiatry Clin Neurosci</source><year>2001</year><volume>13</volume><fpage>213</fpage><lpage>21</lpage><pub-id pub-id-type="pmid">11449028</pub-id></citation></ref><ref id="b13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arciniegas</surname><given-names>DB</given-names></name><name><surname>Topkoff</surname><given-names>J</given-names></name><name><surname>Silver</surname><given-names>JM</given-names></name></person-group><article-title>Neuropsychiatric aspects of traumatic brain injury</article-title><source>Curr Treat Options Neurol</source><year>2000</year><volume>2</volume><fpage>167</fpage><lpage>86</lpage></citation></ref><ref id="b14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ashman</surname><given-names>TA</given-names></name><name><surname>Schwartz</surname><given-names>ME</given-names></name><name><surname>Cantor</surname><given-names>JB</given-names></name><etal/></person-group><article-title>Screening for substance abuse in individuals with traumatic brain injury</article-title><source>Brain Inj</source><year>2004</year><volume>18</volume><fpage>191</fpage><lpage>202</lpage><pub-id pub-id-type="pmid">14660230</pub-id></citation></ref><ref id="b15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Beetar</surname><given-names>JT</given-names></name><name><surname>Guilmette</surname><given-names>TJ</given-names></name><name><surname>Sparadeo</surname><given-names>FR</given-names></name></person-group><article-title>Sleep and pain complaints in symptomatic traumatic brain injury and neurologic populations</article-title><source>Arch Phys Med Rehabil</source><year>1996</year><volume>77</volume><fpage>1298</fpage><lpage>302</lpage><pub-id pub-id-type="pmid">8976315</pub-id></citation></ref><ref id="b16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bell</surname><given-names>KR</given-names></name><name><surname>Kraus</surname><given-names>EE</given-names></name><name><surname>Zasler</surname><given-names>ND</given-names></name></person-group><article-title>Medical management of posttraumatic headaches: pharmacological and physical treatment</article-title><source>J Head Trauma Rehabil</source><year>1999</year><volume>14</volume><fpage>34</fpage><lpage>48</lpage><pub-id pub-id-type="pmid">9949245</pub-id></citation></ref><ref id="b17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bigler</surname><given-names>ED</given-names></name></person-group><article-title>Quantitative magnetic resonance imaging in traumatic brain injury</article-title><source>J Head Trauma Rehabil</source><year>2001</year><volume>16</volume><fpage>117</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">11275574</pub-id></citation></ref><ref id="b18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bigler</surname><given-names>ED</given-names></name></person-group><article-title>Neurobiology and neuropathology underlie the neuropsychological deficits associated with traumatic brain injury</article-title><source>Arch Clin Neuropsychol</source><year>2003</year><volume>18</volume><fpage>595</fpage><lpage>621</lpage><pub-id pub-id-type="pmid">14591434</pub-id></citation></ref><ref id="b19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bigler</surname><given-names>ED</given-names></name><name><surname>Blatter</surname><given-names>DD</given-names></name><name><surname>Johnson</surname><given-names>SC</given-names></name><etal/></person-group><article-title>Traumatic brain injury, alcohol and quantitative neuroimaging: preliminary findings</article-title><source>Brain Inj</source><year>1996</year><volume>10</volume><fpage>197</fpage><lpage>206</lpage><pub-id pub-id-type="pmid">8777391</pub-id></citation></ref><ref id="b20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bigler</surname><given-names>ED</given-names></name><name><surname>Kurth</surname><given-names>SM</given-names></name><name><surname>Blatter</surname><given-names>D</given-names></name><etal/></pers