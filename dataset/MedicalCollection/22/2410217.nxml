-group person-group-type="author"><name><surname>Buzdar</surname><given-names>AU</given-names></name><name><surname>Legha</surname><given-names>SS</given-names></name><name><surname>Hortobagyi</surname><given-names>GN</given-names></name><name><surname>Yap</surname><given-names>HY</given-names></name><name><surname>Wiseman</surname><given-names>CL</given-names></name><name><surname>Distefano</surname><given-names>A</given-names></name><name><surname>Schell</surname><given-names>FC</given-names></name><name><surname>Barnes</surname><given-names>BC</given-names></name><name><surname>Campos</surname><given-names>LT</given-names></name><name><surname>Blumenschein</surname><given-names>GR</given-names></name></person-group><article-title>Management of breast cancer patients failing adjuvant chemotherapy with adriamycin containing regimens</article-title><source>Cancer</source><year>1981</year><volume>47</volume><fpage>2798</fpage><lpage>2802</lpage><!--PubMed citation query: 'Cancer||47|2798||bib5|'--><pub-id pub-id-type="pmid">7260870</pub-id></citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chauvin</surname><given-names>F</given-names></name><name><surname>Magnet</surname><given-names>M</given-names></name><name><surname>Lasset</surname><given-names>C</given-names></name><name><surname>Catimel</surname><given-names>G</given-names></name><name><surname>Mayer</surname><given-names>M</given-names></name><name><surname>Chevarier</surname><given-names>P</given-names></name><name><surname>Jacquin</surname><given-names>JP</given-names></name><name><surname>Peaud</surname><given-names>P</given-names></name><name><surname>Clavel</surname><given-names>M</given-names></name></person-group><article-title>Prognostic factors in the response of a first line chemotherapy in advanced breast cancer</article-title><source>Bull Cancer</source><year>1990</year><volume>77</volume><fpage>941</fpage><lpage>947</lpage><!--