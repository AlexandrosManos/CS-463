"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Povirk</surname><given-names>LF</given-names></name><name><surname>Zhou</surname><given-names>T</given-names></name><name><surname>Zhou</surname><given-names>R</given-names></name><name><surname>Cowan</surname><given-names>MJ</given-names></name><name><surname>Yannone</surname><given-names>SM</given-names></name></person-group><article-title>Processing of 3&#x02032;-phosphoglycolate-terminated DNA double strand breaks by Artemis nuclease</article-title><source>J. Biol. Chem.</source><year>2007</year><volume>282</volume><fpage>3547</fpage><lpage>3558</lpage><pub-id pub-id-type="pmid">17121861</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Drouet</surname><given-names>J</given-names></name><name><surname>Frit</surname><given-names>P</given-names></name><name><surname>Delteil</surname><given-names>C</given-names></name><name><surname>de Villartay</surname><given-names>JP</given-names></name><name><surname>Salles</surname><given-names>B</given-names></name><name><surname>Calsou</surname><given-names>P</given-names></name></person-group><article-title>Interplay between Ku, artemis and DNA-PKcs at DNA ends</article-title><source>J. Biol. Chem.</source><year>2006</year><volume>281</volume><fpage>27784</fpage><lpage>27793</lpage><pub-id pub-id-type="pmid">16857680</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Goodarzi</surname><given-names>AA</given-names></name><name><surname>Yu</surname><given-names>Y</given-names></name><name><surname>Riballo</surname><given-names>E</given-names></name><name><surname>Douglas</surname><given-names>P</given-names></name><name><surname>Walker</surname><given-names>SA</given-names></name><name><surname>Ye</surname><given-names>R</given-names></name><name><surname>Harer</surname><given-names>C</given-names></name><name><surname>Marchetti</surname><given-names>C</given-names></name><name><surname>Morrice</surname><given-names>N</given-names></name><name><surname>Jeggo</surname><given-names>PA</given-names></name><etal/></person-group><article-title>DNA-PK autophosphorylation facilitates Artemis endonuclease activity</article-title><source>EMBO J.</source><year>2006</year><volume>25</volume><fpage>3880</fpage><lpage>3889</lpage><pub-id pub-id-type="pmid">16874298</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Povirk</surname><given-names>LF</given-names></name><name><surname>Han</surname><given-names>Y.-H</given-names></name><name><surname>Steighner</surname><given-names>RJ</given-names></name></person-group><article-title>Structure of bleomycin-induced DNA double-strand breaks: predominance of blunt ends and single-base 5&#x02032; extensions</article-title><source>Biochemistry</source><year>1989</year><volume>28</volume><fpage>8508</fpage><lpage>8514</lpage></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hsu</surname><given-names>H-L</given-names></name><name><surname>Yannone</surname><given-names>SM</given-names></name><name><surname>Chen</surname><given-names>DJ</given-names></name></person-group><article-title>Defining the interactions between DNA-PK and ligase IV/XRCC4</article-title><source>DNA Repair</source><year>2001</year><volume>1</volume><fpage>225</fpage><lpage>235</lpage><pub-id pub-id-type="pmid">12509254</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Yannone</surname><given-names>SM</given-names></name><