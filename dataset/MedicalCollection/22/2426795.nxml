ion></ref><ref id="b12"><citation citation-type="journal"><collab>Anonymous</collab><article-title>Nystatin-liposomal. AR 121, Nyotran</article-title><source>Drugs R D</source><year>1999</year><volume>1</volume><fpage>181</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">10566021</pub-id></citation></ref><ref id="b13"><citation citation-type="journal"><collab>Anonymous</collab><article-title>Vincristine liposomal--INEX: lipid-encapsulated vincristine, onco TCS, transmembrane carrier system--vincristine, vincacine, vincristine sulfate liposomes for injection, VSLI</article-title><source>Drugs R D</source><year>2004</year><volume>5</volume><fpage>119</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">15293876</pub-id></citation></ref><ref id="b14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arifin</surname><given-names>DR</given-names></name><name><surname>Palmer</surname><given-names>AF</given-names></name></person-group><article-title>Physical properties and stability mechanisms of poly(ethylene glycol) conjugated liposome encapsulated hemoglobin dispersions</article-title><source>Artif Cells Blood Substit Immobil Biotechnol</source><year>2005</year><volume>33</volume><fpage>137</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">15960077</pub-id></citation></ref><ref id="b15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arikan</surname><given-names>S</given-names></name><name><surname>Rex</surname><given-names>JH</given-names></name></person-group><article-title>Nystatin LF (Aronex/Abbott)</article-title><source>Curr Opin Investig Drugs</source><year>2001</year><volume>2</volume><fpage>488</fpage><lpage>495</lpage></citation></ref><ref id="b16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Asahi</surname><given-names>M</given-names></name><name><surname>Rammohan</surname><given-names>R</given-names></name><name><surname>Sumii</surnam