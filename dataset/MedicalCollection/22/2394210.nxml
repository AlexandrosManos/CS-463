"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meyer</surname><given-names>KB</given-names></name><name><surname>Thompson</surname><given-names>M</given-names></name><name><surname>Levy</surname><given-names>M</given-names></name><name><surname>Barron</surname><given-names>L</given-names></name><name><surname>Szoka</surname><given-names>FJ</given-names></name></person-group><article-title>Intra-tracheal gene delivery to the mouse air-way: characterization of plasmid DNA expression and pharmacokinetics</article-title><source>Gene Therapy</source><year>1995</year><volume>2</volume><fpage>450</fpage><lpage>460</lpage><!--PubMed citation query: 'Gene Therapy||2|450||bib12|'--><pub-id pub-id-type="pmid">7584123</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Miyahira</surname><given-names>Y</given-names></name><name><surname>Murata</surname><given-names>K</given-names></name><name><surname>Rodriguez</surname><given-names>D</given-names></name><name><surname>Rodriguez</surname><given-names>JR</given-names></name><name><surname>Esteban</surname><given-names>M</given-names></name><name><surname>Rodrigues</surname><given-names>MM</given-names></name><name><surname>Zavala</surname><given-names>F</given-names></name></person-group><article-title>Quantification of antigen specific CD8&#x0002b; T cells using an ELISPOT assay</article-title><source>J Immunol Methods</source><year>1995</year><volume>181</volume><fpage>45</fpage><lpage>54</lpage><!--PubMed citation query: 'J Immunol Methods||181|45||bib13|'--><pub-id pub-id-type="pmid">7537312</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Owais</surname><given-names>M</given-names></name><name><surname>Masood</surname><given-names>AK</given-names></name><name><surname>Agrewala</surname><given-names>JN</given-names></name><