<citation citation-type="journal"><person-group person-group-type="author"><name><surname>de Sonnaville</surname><given-names>JJJ</given-names></name><name><surname>Snoek</surname><given-names>FJ</given-names></name><name><surname>Colly</surname><given-names>LP</given-names></name><etal/></person-group><article-title>Well-being and symptoms in relation to insulin therapy in type 2 diabetes</article-title><source>Diabetes Care</source><year>1998</year><volume>21</volume><fpage>919</fpage><lpage>24</lpage><pub-id pub-id-type="pmid">9614608</pub-id></citation></ref><ref id="b17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reza</surname><given-names>M</given-names></name><name><surname>Taylor</surname><given-names>CD</given-names></name><name><surname>Towse</surname><given-names>K</given-names></name><etal/></person-group><article-title>Insulin improves well-being for selected elderly type 2 diabetic subjects</article-title><source>Diabetes Res Clin Pract</source><year>2002</year><volume>55</volume><fpage>201</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">11850096</pub-id></citation></ref><ref id="b18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wilson</surname><given-names>M</given-names></name><name><surname>Moore</surname><given-names>MP</given-names></name><name><surname>Lunt</surname><given-names>H</given-names></name></person-group><article-title>Treatment satisfaction after commencement of insulin in type 2 diabetes</article-title><source>Diabetes Res Clin Pract</source><year>2004</year><volume>66</volume><fpage>263</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15536023</pub-id></citation></ref><ref id="b19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bradley</surname><given-names>C</given-names></name><name><surname>Speight</surname><given-names>J</given-names></name></person-group><article-title>Patient perceptions of diabetes and diabetes therapy: assessing quality of life</article-title><source>Diabetes Metab Res Rev</source><year>2002</year><volume>18</volume><issue>Suppl. 3</issue><fpage>S64</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">12324988</pub-id></citation></ref><ref id="b20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hayes</surname><given-names>RP</given-names></name><name><surname>Nakano</surname><given-names>M</given-names></name><name><surname>Muchmore</surname><given-names>D</given-names></name><etal/></person-group><article-title>Effect of standard (self-directed) training versus intensive training for Lilly/Alkermes human insulin inhalation powder delivery system on patient-reported outcomes and patient evaluation of the system</article-title><source>Diabetes Technol Ther</source><year>2007</year><volume>9</volume><fpage>89</fpage><lpage>98</lpage><pub-id pub-id-type="pmid">17316103</pub-id></citation></ref><ref id="b21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rosenstock</surname><given-names>J</given-names></name><name><surname>Cappelleri</surname><given-names>JC</given-names></name><name><surname>Bolinder</surname><given-names>B</given-names></name><etal/></person-group><article-title>Patient satisfaction and glycemic control after 1 year with inhaled insulin (Exubera) in patients with type 1 or type 2 diabetes</article-title><source>Diabetes Care</source><year>2004</year><volume>27</volume><fpage>1318</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">15161782</pub-id></citation></ref><ref id="b22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rubin</surname><given-names>RR</given-names></name></person-group><article-title>Adherence to pharmacologic therapy in patients with type 2 diabetes mellitus</article-title><s