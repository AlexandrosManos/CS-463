page><lpage>257</lpage><pub-id pub-id-type="pmid">3972995</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nicolle</surname><given-names>LE</given-names></name><name><surname>Hoban</surname><given-names>SA</given-names></name><name><surname>Harding</surname><given-names>GK</given-names></name></person-group><article-title>Characterization of coagulase-negative staphylococci from urinary tract specimens</article-title><source>J Clin Microbiol</source><year>1983</year><volume>17</volume><fpage>267</fpage><lpage>271</lpage><pub-id pub-id-type="pmid">6833480</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barnham</surname><given-names>M</given-names></name><name><surname>Horton</surname><given-names>R</given-names></name><name><surname>Smith</surname><given-names>JM</given-names></name><name><surname>Richardson</surname><given-names>J</given-names></name><name><surname>Marples</surname><given-names>RR</given-names></name><name><surname>Reith</surname><given-names>S</given-names></name></person-group><article-title>Methicillin-resistant <italic>Staphylococcus simulans </italic>masquerading as MRSA in a nursing home [letter]</article-title><source>J Hosp Infect</source><year>1996</year><volume>34</volume><fpage>331</fpage><lpage>333</lpage><pub-id pub-id-type="pmid">8971622</pub-id><pub-id pub-id-type="doi">10.1016/S0195-6701(96)90113-9</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sampathkumar</surname><given-names>P</given-names></name><name><surname>Osmon</surname><given-names>DR</given-names></name><name><surname>Cockerill</surname><given-names>FR</given-names><suffix>III</suffix></name></person-group><article-title>Prosthetic joint infection due to <italic>Staphylococcus lugdunensis</italic></article-title><source>Mayo Clin Proc</source><year>2000</year><volume>75</volume><fpage>511</fpage><lpage>512</lpage><pub-id pub-id-type="pmid">10807080</pub-id></citation></ref></ref-list></back></article>