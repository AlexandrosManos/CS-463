p person-group-type="author"><name><surname>Gaffey</surname><given-names>MJ</given-names></name><name><surname>Frierson</surname><given-names>HF</given-names><suffix>Jr</suffix></name><name><surname>Mills</surname><given-names>SE</given-names></name><name><surname>Zarbo</surname><given-names>RJ</given-names></name><name><surname>Boyd</surname><given-names>JC</given-names></name><name><surname>Simpson</surname><given-names>JF</given-names></name><name><surname>Weiss</surname><given-names>LM</given-names></name></person-group><article-title>Medullary carcinoma of the breast. Identification of lymphocyte subpopulations and their significance</article-title><source>Mod Pathol</source><year>1993</year><volume>6</volume><fpage>721</fpage><lpage>728</lpage><!--PubMed citation query: 'Mod Pathol||6|721||bib12|'--><pub-id pub-id-type="pmid">8302815</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Galetsky</surname><given-names>SA</given-names></name><name><surname>Tsvetnov</surname><given-names>VV</given-names></name><name><surname>Land</surname><given-names>CE</given-names></name><name><surname>Afanasieva</surname><given-names>TA</given-names></name><name><surname>Petrovichev</surname><given-names>NN</given-names></name><name><surname>Gurtsevitch</surname><given-names>VE</given-names></name><name><surname>Tokunaga</surname><given-names>M</given-names></name></person-group><article-title>Epstein&#x02013;Barr virus-associated gastric cancer in Russia</article-title><source>Int J Cancer</source><year>1997</year><volume>73</volume><fpage>786</fpage><lpage>789</lpage><!--PubMed citation query: 'Int J Cancer||73|786||bib14|'--><pub-id pub-id-type="pmid">9399652</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gao</surname><given-names>Y</given-names></name><name><surname>Lu</surname><given-names>Y-J</given-names></name><name><surname>Xue</surname><given-names>S-A</given-names></name><name><surname>Chen</surname><given-names>H</given-names></name><name><surname>Wedderburn</surname><given-names>N</given-names></name><name><surname>Griffin</surname><given-names>BE</given-names></name></person-group><article-title>Hypothesis: a novel route for immortalization of epithelial cells by Epstein&#x02013;Barr virus</article-title><source>Oncogene</source><year>2002</year><volume>21</volume><fpage>825</fpage><lpage>835</lpage><!--PubMed citation query: 'Oncogene||21|825||bib13|'--><pub-id pub-id-type="pmid">11850810</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Glaser</surname><given-names>SL</given-names></name><name><surname>Ambinder</surname><given-names>RF</given-names></name><name><surname>DiGiuseppe</surname><given-names>JA</given-names></name><name><surname>Hornross</surname><given-names>PL</given-names></name><name><surname>Hsu</surname><given-names>JL</given-names></name></person-group><article-title>Absence of Epstein&#x02013;Barr virus EBER-1 transcripts in an epidemiologically diverse groups of breast cancers</article-title><source>Int J Cancer</source><year>1998</year><volume>75</volume><fpage>555</fpage><lpage>558</lpage><!--PubMed citation query: 'Int J Cancer||75|555||bib15|'--><pub-id pub-id-type="pmid">9466655</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Griffin</surname><given-names>BE</given-names></name><name><surname>Karran</surname><given-names>L</given-names></name></person-group><article-title>Immortalization of monkey epithelial cells by specific fragments of Epstein&#x02013;Barr virus DNA</article-title><source>Nature</source><year>1984</year><volume>309</volume><fpage>78</fpage><lpage>82</lpage><!--PubMed citation query: 'Nature||309|78||bib16|'--><pub-id pub-id-type="pmid">6325929</pub-id></cita