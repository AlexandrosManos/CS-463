ype="doi">10.1097/00005650-199609000-00005</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sim</surname><given-names>J</given-names></name><name><surname>Adams</surname><given-names>N</given-names></name></person-group><article-title>Therapeutic approaches to fibromyalgia syndrome in the United Kingdom: a survey of occupational therapists and physical therapists</article-title><source>Eur J Pain</source><year>2003</year><volume>7</volume><fpage>173</fpage><lpage>180</lpage><pub-id pub-id-type="pmid">12600799</pub-id><pub-id pub-id-type="doi">10.1016/S1090-3801(02)00095-2</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lind</surname><given-names>BK</given-names></name><name><surname>Lafferty</surname><given-names>WE</given-names></name><name><surname>Tyree</surname><given-names>PT</given-names></name><name><surname>Diehr</surname><given-names>PK</given-names></name><name><surname>Grembowski</surname><given-names>DE</given-names></name></person-group><article-title>Use of complementary and alternative medicine providers by fibromyalgia patients under insurance coverage</article-title><source>Arthritis Rheum</source><year>2007</year><volume>57</volume><fpage>71</fpage><lpage>76</lpage><pub-id pub-id-type="pmid">17266066</pub-id><pub-id pub-id-type="doi">10.1002/art.22471</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buchwald</surname><given-names>D</given-names></name><name><surname>Bombardier</surname><given-names>C</given-names></name></person-group><article-title>Disability and health care utilization in patients with chronic fatigue and chronic fatigue syndrome</article-title><source>Medical Care</source><year>1996</year><volume>34</volume><fpage>924</fpage><lpage>930</lpage><pub-id pub-id-type="pmid">8792781</pub-id><pub-id pub-id-type="doi">10.1097/00005650-199609000-00005</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sharpe</surname><given-names>M</given-names></name><name><surname>Mayou</surname><given-names>R</given-names></name><name><surname>Seagroatt</surname><given-names>V</given-names></name><name><surname>Surawy</surname><given-names>C</given-names></name><name><surname>Warwick</surname><given-names>H</given-names></name><name><surname>Bulstrode</surname><given-names>C</given-names></name><name><surname>Dawber</surname><given-names>R</given-names></name><name><surname>Lane</surname><given-names>D</given-names></name></person-group><article-title>Why do doctors find some patients difficult to help?</article-title><source>Q J Med</source><year>1994</year><volume>87</volume><fpage>187</fpage><lpage>193</lpage><pub-id pub-id-type="pmid">8208907</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hartz</surname><given-names>AJ</given-names></name><name><surname>Noyes</surname><given-names>R</given-names></name><name><surname>Bentler</surname><given-names>SE</given-names></name><name><surname>Damiano</surname><given-names>PC</given-names></name><name><surname>Willard</surname><given-names>JC</given-names></name><name><surname>Momany</surname><given-names>ET</given-names></name></person-group><article-title>Unexplained symptoms in primary care: perspectives of doctors and patients</article-title><source>Gen Hosp Psychiatry</source><year>2000</year><volume>22</volume><fpage>144</fpage><lpage>152</lpage><pub-id pub-id-type="pmid">10880707</pub-id><pub-id pub-id-type="doi">10.1016/S0163-8343(00)00060-8</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reid</surname><given-names>S</given-names></name><name><surname>Whooley</surname><given-names>D</giv