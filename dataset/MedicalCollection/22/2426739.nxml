United States of America</italic></source><year>1990</year><volume>87</volume><issue>13</issue><fpage>5036</fpage><lpage>5040</lpage><pub-id pub-id-type="pmid">2195544</pub-id></citation></ref><ref id="B17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Glenner</surname><given-names>GG</given-names></name><name><surname>Eanes</surname><given-names>ED</given-names></name><name><surname>Wiley</surname><given-names>CA</given-names></name></person-group><article-title>Amyloid fibrils formed from a segment of the pancreatic islet amyloid protein</article-title><source><italic>Biochemical and Biophysical Research Communications</italic></source><year>1988</year><volume>155</volume><issue>2</issue><fpage>608</fpage><lpage>614</lpage><pub-id pub-id-type="pmid">3048259</pub-id></citation></ref><ref id="B18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tenidis</surname><given-names>K</given-names></name><name><surname>Waldner</surname><given-names>M</given-names></name><name><surname>Bernhagen</surname><given-names>J</given-names></name><etal/></person-group><article-title>Identification of a penta- and hexapeptide of islet amyloid polypeptide (IAPP) with amyloidogenic and cytotoxic properties</article-title><source><italic>Journal of Molecular Biology</italic></source><year>2000</year><volume>295</volume><issue>4</issue><fpage>1055</fpage><lpage>1071</lpage><pub-id pub-id-type="pmid">10656810</pub-id></citation></ref><ref id="B19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jaikaran</surname><given-names>ETAS</given-names></name><name><surname>Higham</surname><given-names>CE</given-names></name><name><surname>Serpell</surname><given-names>LC</given-names></name><etal/></person-group><article-title>Identification of a novel human islet amyloid polypeptide <italic>&#x003b2;</italic>-sheet domain and factors influencing fibrillogenesis</article-title><source><italic>Journal of Molecular Biology</italic></source><year>2001</year><volume>308</volume><issue>3</issue><fpage>515</fpage><lpage>525</lpage><pub-id pub-id-type="pmid">11327784</pub-id></citation></ref><ref id="B20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mazor</surname><given-names>Y</given-names></name><name><surname>Gilead</surname><given-names>S</given-names></name><name><surname>Benhar</surname><given-names>I</given-names></name><name><surname>Gazit</surname><given-names>E</given-names></name></person-group><article-title>Identification and characterization of a novel molecular-recognition and self-assembly domain within the islet amyloid polypeptide</article-title><source><italic>Journal of Molecular Biology</italic></source><year>2002</year><volume>322</volume><issue>5</issue><fpage>1013</fpage><lpage>1024</lpage><pub-id pub-id-type="pmid">12367525</pub-id></citation></ref><ref id="B21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nilsson</surname><given-names>MR</given-names></name><name><surname>Raleigh</surname><given-names>DP</given-names></name></person-group><article-title>Analysis of amylin cleavage products provides new insights into the amyloidogenic region of human amylin</article-title><source><italic>Journal of Molecular Biology</italic></source><year>1999</year><volume>294</volume><issue>5</issue><fpage>1375</fpage><lpage>1385</lpage><pub-id pub-id-type="pmid">10600392</pub-id></citation></ref><ref id="B22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Scrocchi</surname><given-names>LA</given-names></name><name><surname>Ha</surname><given-names>K</given-names></name><name><surname>Chen</surname><given-names>Y</given-names></name><name><surname>Wu</surname><given-names>L</given-names></name><name