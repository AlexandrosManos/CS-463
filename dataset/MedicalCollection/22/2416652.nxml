r"><name><surname>Levy</surname><given-names>PS</given-names></name><name><surname>Lemeshow</surname><given-names>S</given-names></name></person-group><source>Sampling of Populations Methods and Applications</source><year>1999</year><publisher-name>John Wiley and Sons</publisher-name></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Weiss</surname><given-names>S</given-names></name><name><surname>Indurkhya</surname><given-names>N</given-names></name><name><surname>Zhang</surname><given-names>T</given-names></name><name><surname>Damerau</surname><given-names>F</given-names></name></person-group><source>Text Mining: Predictive Methods for Analyzing Unstructured Information</source><year>2005</year><publisher-name>Springer-Verlag</publisher-name></citation></ref><ref id="B20"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Zaslavsky</surname><given-names>L</given-names></name><name><surname>Bao</surname><given-names>Y</given-names></name><name><surname>Tatusova</surname><given-names>TA</given-names></name></person-group><article-title>Multiresolution approaches to representation and visualization of large influenza virus sequence datasets</article-title><source>Data Mining in Bioinformatics Workshop (DMB 2007), Proc of the IEEE International Conference on Bioinformatics and Biomedicine/Workshops, November 2&#x02013;4, 2007, IEEE</source><year>2007</year><fpage>109</fpage><lpage>114</lpage></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Plotkin</surname><given-names>JB</given-names></name><name><surname>Dushoff</surname><given-names>J</given-names></name><name><surname>Levin</surname><given-names>SA</given-names></name></person-group><article-title>Hemagglutinin sequence clusters and the antigenic evolution of influenza A virus</article-title><source>PNAS</source><year>2002</year><volume>99</volume><fpage>6263</fpage><lpage>6268</lpage><pub-id pub-id-type="pmid">11972025</pub-id><pub-id pub-id-type="doi">10.1073/pnas.082110799</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wolf</surname><given-names>YI</given-names></name><name><surname>Viboud</surname><given-names>C</given-names></name><name><surname>Holmes</surname><given-names>EC</given-names></name><name><surname>Koonin</surname><given-names>EV</given-names></name><name><surname>Lipman</surname><given-names>DJ</given-names></name></person-group><article-title>Long intervals of stasis punctuated by bursts of positive selection in the seasonal evolution of influenza A virus</article-title><source>Biol Direct</source><year>2006</year><volume>1</volume><fpage>34</fpage><pub-id pub-id-type="pmid">17067369</pub-id><pub-id pub-id-type="doi">10.1186/1745-6150-1-34</pub-id></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Felsenstein</surname><given-names>J</given-names></name></person-group><source>Inferring Phylogenies</source><year>2003</year><publisher-name>Cambridge University Press</publisher-name></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bryant</surname><given-names>D</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Janowitz M, Lapointe FJ, McMorris F, Mirkin B, Roberts F</surname></name></person-group><article-title>A classification of consensus methods for phylogenies</article-title><source>BioConsensus</source><year>2003</year><publisher-name>DIMACS, Americal Mathematical Society</publisher-name><fpage>163</fpage><lpage>184</lpage></citation></ref><ref id="B25"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Amenta</surname><given-names>N</given-names></name><name><surname>Clarke</surname><given-names>F</given-names></name><name><surname>St John</surname><given-names>K</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Benson G, Page R</surname></name></person-group><article-title>A Linear-Time Majority Tree Algorithm</article-title><source>Algorithms in Bioinformatics, Proc of WABI 2003, Volume LNBI 2812 of Lecture Notes in Bioinformatics</source><year>2003</year><publisher-name>Springer-Verlag</publisher-name><fpage>216</fpage><lpage>227</lpage></citation></ref></ref-list></back></article>