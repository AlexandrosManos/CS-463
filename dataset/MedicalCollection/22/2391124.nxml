<volume>177</volume><fpage>175</fpage><lpage>184</lpage><!--PubMed citation query: 'Immunol Rev||177|175||bib13|'--><pub-id pub-id-type="pmid">11138774</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Orsini</surname><given-names>MJ</given-names></name><name><surname>Parent</surname><given-names>JL</given-names></name><name><surname>Mundell</surname><given-names>SJ</given-names></name><name><surname>Benovic</surname><given-names>JL</given-names></name><name><surname>Marchese</surname><given-names>A</given-names></name></person-group><article-title>Trafficking of the HIV coreceptor CXCR4. Role of arrestins and identification of residues in the c-terminal tail that mediate receptor internalization</article-title><source>J Biol Chem</source><year>1999</year><volume>274</volume><fpage>31076</fpage><lpage>31086</lpage><!--PubMed citation query: 'J Biol Chem||274|31076||bib14|'--><pub-id pub-id-type="pmid">10521508</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pouyss&#x000e9;gur</surname><given-names>J</given-names></name><name><surname>Dayan</surname><given-names>F</given-names></name><name><surname>Mazure</surname><given-names>NM</given-names></name></person-group><article-title>Hypoxia signaling in cancer and approached to enforce tumor regression</article-title><source>Nature</source><year>2006</year><volume>441</volume><fpage>437</fpage><lpage>443</lpage><!--PubMed citation query: 'Nature||441|437||bib15|'--><pub-id pub-id-type="pmid">16724055</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rollins</surname><given-names>BJ</given-names></name></person-group><article-title>Chemokines</article-title><source>Blood</source><year>1997</year><volume>90</volume><fpage>909</fpage><lpage>928</lpage><!--PubMed citation query: 'Bloo