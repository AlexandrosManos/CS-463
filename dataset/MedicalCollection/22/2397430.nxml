113"/><pub-id pub-id-type="pmid">10392593</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barsky</surname><given-names>AJ</given-names></name><name><surname>Orav</surname><given-names>EJ</given-names></name><name><surname>Bates</surname><given-names>DW</given-names></name></person-group><article-title>Somatization increases medical utilization costs independent of psychiatric and medical comorbidity</article-title><source>Arch Gen Psychiatry</source><year>2005</year><volume>62</volume><fpage>903</fpage><lpage>910</lpage><pub-id pub-id-type="pmid">16061768</pub-id><pub-id pub-id-type="doi">10.1001/archpsyc.62.8.903</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>GR</given-names></name><name><surname>Monson</surname><given-names>RA</given-names></name><name><surname>Ray</surname><given-names>DC</given-names></name></person-group><article-title>Patients with multiple unexplained symptoms: Their characteristics, functional health, and health care utilization</article-title><source>Arch Intern Med</source><year>1986</year><volume>146</volume><fpage>69</fpage><lpage>72</lpage><pub-id pub-id-type="pmid">3942467</pub-id><pub-id pub-id-type="doi">10.1001/archinte.146.1.69</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Janca</surname><given-names>A</given-names></name><name><surname>Isaac</surname><given-names>M</given-names></name><name><surname>Ventouras</surname><given-names>J</given-names></name></person-group><article-title>Towards better understanding and management of somatoform disorder</article-title><source>Int Rev Psychiatry</source><year>2006</year><volume>18</volume><fpage>5</fpage><lpage>12</lpage><pub-id pub-id-type="pmid">16451875</pub-id><pub-id pub-id-type="doi">10.1080/09540260500466766</pub-id></citation></ref><ref id="B9"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bennett</surname><given-names>MJ</given-names></name></person-group><source>The empathic healer: An endangered species?</source><year>2001</year><publisher-name>San Diego: Academic Press</publisher-name></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hojat</surname><given-names>M</given-names></name></person-group><source>Empathy in patient care</source><year>2007</year><publisher-name>New York: Springer</publisher-name></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Noyes</surname><given-names>R</given-names><suffix>Jr</suffix></name><name><surname>Kathol</surname><given-names>RG</given-names></name><name><surname>Fisher</surname><given-names>MM</given-names></name><name><surname>Phillips</surname><given-names>BM</given-names></name><name><surname>Suelzer</surname><given-names>MT</given-names></name><name><surname>Woodman</surname><given-names>CL</given-names></name></person-group><article-title>One-year follow-up of medical outpatients with hypochondriasis</article-title><source>Psychosomatics</source><year>1994</year><volume>35</volume><fpage>533</fpage><lpage>545</lpage><pub-id pub-id-type="pmid">7809356</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bass</surname><given-names>C</given-names></name><name><surname>Murphy</surname><given-names>M</given-names></name></person-group><article-title>Somatization disorder in a British teaching hospital</article-title><source>Br J Clin Pract</source><year>1991</year><volume>45</volume><fpage>237</fpage><lpage>244</lpage><pub-id pub-id-type="pmid">1810354</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fink</surname><given-names>P</given-names></name></person-group><article-title>The use of hospitalizations by persistent somatizing patients</article-title><source>Psychol Med</source><year>1992</year><volume>22</volume><fpage>173</fpage><lpage>180</lpage><pub-id pub-id-type="pmid">1574553</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bass</surname><given-names>C</given-names></name><name><surname>Murphy</surname><given-names>M</given-names></name></person-group><article-title>Somatoform and personality disorders: syndromal comorbidity and overlapping developmental pathways</article-title><source>J Psychosom Res</source><year>1995</year><volume>39</volume><fpage>403</fpage><lpage>427</lpage><pub-id pub-id-type="pmid">7562672</pub-id><pub-id pub-id-type="doi">10.1016/0022-3999(94)00157-Z</pub-id></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Ainsworth</surname><given-names>MDS</given-names></name><name><surname>Blehar</surname><given-names>MC</given-names></name><name><surname>Waters</surname><given-names>E</given-names></name><name><surname>Wall</surname><given-names>S</given-names></name></person-group><source>Patterns of attachment: a psychological study of the strange situation</source><year>1978</year><publisher-name>Hillsdale NJ: Erlbaum</publisher-name></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ainsworth</surname><given-names>MDS</given-names></name></person-group><article-title>Attachments beyond infancy</article-title><source>Am Psychol</source><year>1989</year><volume>44</volume><fpage>709</fpage><lpage>716</lpage><pub-id pub-id-type="pmid">2729745</pub-id><pub-id pub-id-type="doi">10.1037/0003-066X.44.4.709</pub-id></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Berman</surname><given-names>WH</given-names></name><name><surname>Sperling</surname><given-names>MB</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Sperling MB, Berman WH</surname></name></person-group><article-title>The structure and function of adult attachment</article-title><source>Attachment in adults</source><year>1994</year><publisher-name>New York: The Guilford Press</publisher-name><fpage>3</fpage><lpage>28</lpage></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Page</surname><given-names>TF</given-names></name></person-group><article-title>Attachment and personality disorders: exploring maladaptive developmental history</article-title><source>Ch and Adol Soc Work J</source><year>2001</year><volume>18</volume><fpage>313</fpage><lpage>334</lpage><pub-id pub-id-type="doi">10.1023/A:1012551222723</pub-id></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Sroufe</surname><given-names>LA</given-names></name><name><surname>Fleeson</surname><given-names>J</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Hartup W, Rubin Z</surname></name></person-group><article-title>Attachment and the construction of relationships</article-title><source>Relationships and development</source><year>1986</year><publisher-name>Hillsdale NJ: Lawrence Erlbaum</publisher-name><fpage>51</fpage><lpage>71</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bennett</surname><given-names>S</given-names></name></person-group><article-title>Attachment theory and research applied to the conceptualization and treatment of pathological narcissism</article-title><source>Cl Soc Work J</source><year>2006</year><volume>34</volume><fpage>45</fpage><lpage>60</lpage><pub-id pub-id-type="doi">10.1007/s10615-0