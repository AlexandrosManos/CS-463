e><given-names>L</given-names></name></person-group><article-title>Medical students' perspective on the teaching of medical statistics in the undergraduate medical curriculum</article-title><source>Statistics in Medicine</source><year>2002</year><volume>21</volume><fpage>1003</fpage><lpage>1006</lpage><pub-id pub-id-type="pmid">11921009</pub-id><pub-id pub-id-type="doi">10.1002/sim.1132</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Herman</surname><given-names>A</given-names></name><name><surname>Notzer</surname><given-names>N</given-names></name><name><surname>Libman</surname><given-names>Z</given-names></name><name><surname>Braunstein</surname><given-names>R</given-names></name><name><surname>Steinberg</surname><given-names>D</given-names></name></person-group><article-title>Statistical education for medical students: concepts are what remain when the details are forgotten</article-title><source>Statistics in Medicine</source><year>2007</year><volume>26</volume><fpage>4344</fpage><lpage>4351</lpage><pub-id pub-id-type="pmid">17487940</pub-id><pub-id pub-id-type="doi">10.1002/sim.2906</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Evans</surname><given-names>SJW</given-names></name></person-group><article-title>Statistics for medicla students in the 1990's: how should we approach the future</article-title><source>Statistics in Medicine</source><year>1990</year><volume>9</volume><fpage>1069</fpage><lpage>1075</lpage><pub-id pub-id-type="pmid">2244079</pub-id><pub-id pub-id-type="doi">10.1002/sim.4780090913</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ambrosius</surname><given-names>WT</given-names></name><name><surname>Manatunga</surname><given-names>AK</given-names></name></person-group><article-title>Intensive short courses in biostatistics for fellows and physicians</article-title><source>Statistics in Medicine</source><year>2002</year><volume>21</volume><fpage>2739</fpage><lpage>2756</lpage><pub-id pub-id-type="pmid">12228888</pub-id><pub-id pub-id-type="doi">10.1002/sim.1212</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mintz</surname><given-names>E</given-names></name><name><surname>Ostbye</surname><given-names>T</given-names></name></person-group><article-title>Teaching statistics to health professionals: the legal analogy</article-title><source>Medical Teacher</source><year>1992</year><volume>14</volume><fpage>371</fpage><lpage>374</lpage><pub-id pub-id-type="pmid">1293464</pub-id><pub-id pub-id-type="doi">10.3109/01421599209018857</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boyle</surname><given-names>CR</given-names></name></person-group><article-title>A problem-based learning approach to teaching biostatistics</article-title><source>Journal of Statistics Education</source><year>1999</year><volume>7</volume><ext-link ext-link-type="uri" xlink:href="http://www.amstat.org/publications/jse/secure/v7n1/boyle.cfm"/></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bland</surname><given-names>JM</given-names></name></person-group><article-title>Teaching statistics to medical students using problem-based learning: the Australian experience</article-title><source>BMC Medical Education</source><year>2004</year><volume>4</volume><pub-id pub-id-type="pmid">15588318</pub-id></citation></ref></ref-list></back></article>