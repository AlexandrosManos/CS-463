td align="left">ClpC protease</td><td align="left"><ext-link ext-link-type="gen" xlink:href="4105131">4105131</ext-link></td><td align="left">1.2<sup>e</sup></td><td></td><td></td><td align="left">81</td><td align="left">4</td></tr><tr><td align="right">8</td><td align="left">P&#x00026;AA</td><td align="left">ClpC protease</td><td align="left"><ext-link ext-link-type="gen" xlink:href="18423214">18423214</ext-link></td><td></td><td align="left">1.7</td><td align="left">0.06</td><td align="left">286</td><td align="left">11</td></tr><tr><td align="right">11</td><td align="left">P&#x00026;AA</td><td align="left">HSP 90</td><td align="left"><ext-link ext-link-type="gen" xlink:href="1708314">1708314</ext-link></td><td align="left">1.7</td><td></td><td align="left">0.01</td><td align="left">312</td><td align="left">10</td></tr><tr><td align="right">20</td><td align="left">P&#x00026;AA</td><td align="left">HSP 70-3</td><td align="left"><ext-link ext-link-type="gen" xlink:href="38325815">38325815</ext-link></td><td align="left">1.9</td><td></td><td align="left">0.08</td><td align="left">404</td><td align="left">11</td></tr><tr><td align="right">21</td><td align="left">P&#x00026;AA</td><td align="left">HSP 70</td><td align="left"><ext-link ext-link-type="gen" xlink:href="62733235">62733235</ext-link></td><td align="left">1.7</td><td></td><td align="left">0.11</td><td align="left">612</td><td align="left">13</td></tr><tr><td align="right">23</td><td align="left">P&#x00026;AA</td><td align="left">HSP 70</td><td align="left"><ext-link ext-link-type="gen" xlink:href="22636">22636</ext-link></td><td align="left">2</td><td></td><td align="left">0.04</td><td align="left">100</td><td align="left">3</td></tr><tr><td align="right">29</td><td align="left">P&#x00026;AA</td><td align="left">chaperonin CPN60-1</td><td align="left"><ext-link ext-link-type="gen" xlink:href="108706134">108706134</ext-link></td><td align="left">2.7</td><td></td><td align="left">0.04</td><td align="left">139</t