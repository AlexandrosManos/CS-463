<given-names>M</given-names></name></person-group><article-title>Economic considerations for the diagnosis and therapy of meniscal lesions: can magnetic resonance imaging help reduce the expense?</article-title><source>World J Surg</source><year>1997</year><volume>21</volume><fpage>363</fpage><lpage>368</lpage><pub-id pub-id-type="pmid">9143565</pub-id><pub-id pub-id-type="doi">10.1007/PL00012254</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dixon</surname><given-names>AK</given-names></name></person-group><article-title>Magnetic resonance imaging of meniscal tears of the knee</article-title><source>J Bone Joint Surg Br</source><year>1996</year><volume>78</volume><fpage>174</fpage><lpage>176</lpage><pub-id pub-id-type="pmid">8666618</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tyrrell</surname><given-names>RL</given-names></name><name><surname>Gluckert</surname><given-names>K</given-names></name><name><surname>Pathria</surname><given-names>M</given-names></name><name><surname>Modic</surname><given-names>MT</given-names></name></person-group><article-title>Fast three-dimensional MR imaging of the knee: comparison with arthroscopy</article-title><source>Radiology</source><year>1988</year><volume>166</volume><fpage>865</fpage><lpage>872</lpage><pub-id pub-id-type="pmid">3340786</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Spiers</surname><given-names>AS</given-names></name><name><surname>Meagher</surname><given-names>T</given-names></name><name><surname>Ostlere</surname><given-names>SJ</given-names></name><name><surname>Wilson</surname><given-names>DJ</given-names></name><name><surname>Dodd</surname><given-names>CA</given-names></name></person-group><article-title>Can MRI of the knee affect arthroscopic practice? A prospective study of 58 patients</article-title><source>J Bone Joint Surg Br</source><year>1993</year><volume>75</volume><fpage>49</fpage><lpage>52</lpage><pub-id pub-id-type="pmid">8421033</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Herman</surname><given-names>LJ</given-names></name><name><surname>Beltran</surname><given-names>J</given-names></name></person-group><article-title>Pitfalls in MR imaging of the knee</article-title><source>Radiology</source><year>1988</year><volume>167</volume><fpage>775</fpage><lpage>781</lpage><pub-id pub-id-type="pmid">3363139</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Watanabe</surname><given-names>AT</given-names></name><name><surname>Carter</surname><given-names>BC</given-names></name><name><surname>Teitelbaum</surname><given-names>GP</given-names></name><name><surname>Bradley</surname><given-names>WG</given-names><suffix>Jr.</suffix></name></person-group><article-title>Common pitfalls in magnetic resonance imaging of the knee</article-title><source>J Bone Joint Surg Am</source><year>1989</year><volume>71</volume><fpage>857</fpage><lpage>862</lpage><pub-id pub-id-type="pmid">2745483</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mackenzie</surname><given-names>R</given-names></name><name><surname>Palmer</surname><given-names>CR</given-names></name><name><surname>Lomas</surname><given-names>DJ</given-names></name><name><surname>Dixon</surname><given-names>AK</given-names></name></person-group><article-title>Magnetic resonance imaging of the knee: diagnostic performance studies</article-title><source>Clin Radiol</source><year>1996</year><volume>51</volume><fpage>251</fpage><lpage>257</lpage><pub-id pub-id-type="pmid">8617036</pub-id><pub-id pub-id-type="doi">10.1016/S0009-9260(96)80341-2</p