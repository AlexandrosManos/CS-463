1</year><volume>103</volume><fpage>1813</fpage><lpage>1818</lpage><pub-id pub-id-type="pmid">11282915</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bazzino</surname><given-names>O</given-names></name><name><surname>Ferreiros</surname><given-names>ER</given-names></name><name><surname>Pizarro</surname><given-names>R</given-names></name><name><surname>Corrado</surname><given-names>G</given-names></name></person-group><article-title>C-reactive protein and the stress tests for the risk stratification of patients recovering from unstable angina pectoris</article-title><source>Am J Cardiol</source><year>2001</year><volume>87</volume><fpage>1235</fpage><lpage>1239</lpage><pub-id pub-id-type="pmid">11377346</pub-id><pub-id pub-id-type="doi">10.1016/S0002-9149(01)01511-9</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ridker</surname><given-names>PM</given-names></name><name><surname>Glynn</surname><given-names>RJ</given-names></name><name><surname>Hennekens</surname><given-names>CH</given-names></name></person-group><article-title>C-reactive protein adds to the predictive value of total and HDL cholesterol in determining risk of first myocardial infarction</article-title><source>Circulation</source><year>1998</year><volume>97</volume><fpage>2007</fpage><lpage>2011</lpage><pub-id pub-id-type="pmid">9610529</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ridker</surname><given-names>PM</given-names></name><name><surname>Hennekens</surname><given-names>CH</given-names></name><name><surname>Buring</surname><given-names>JE</given-names></name><name><surname>Rifai</surname><given-names>N</given-names></name></person-group><article-title>C-reactive protein and other markers of inflammation in the prediction of cardiovascular disease in wome