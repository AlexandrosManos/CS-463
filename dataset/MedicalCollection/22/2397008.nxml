ordon Holmes and the neurological heritage</article-title><source>Brain</source><year>2007</year><volume>130</volume><issue>1</issue><fpage>288</fpage><lpage>98</lpage><pub-id pub-id-type="pmid">17178743</pub-id></citation></ref><ref id="b9"><label>9</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Damasio</surname><given-names>A</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Damasio</surname><given-names>A</given-names></name></person-group><article-title>Unpleasantness in Vermont</article-title><source>Descartes' error</source><year>2006</year><publisher-loc>London</publisher-loc><publisher-name>Vintage</publisher-name><fpage>3</fpage><lpage>19</lpage><comment>Chapter 1</comment></citation></ref><ref id="b10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Watson</surname><given-names>JD</given-names></name><name><surname>Crick</surname><given-names>FH</given-names></name></person-group><article-title>Molecular structure of nucleic acids: a structure of deoxyribose nucleic acid</article-title><source>Nature</source><year>1953</year><volume>171</volume><issue>4356</issue><fpage>737</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">13054692</pub-id></citation></ref><ref id="b11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crick</surname><given-names>FH</given-names></name><name><surname>Barnett</surname><given-names>L</given-names></name><name><surname>Brenner</surname><given-names>S</given-names></name><name><surname>Watts-Tobin</surname><given-names>RJ</given-names></name></person-group><article-title>General nature of the genetic code for proteins</article-title><source>Nature</source><year>1961</year><volume>192</volume><fpage>1227</fpage><lpage>32</lpage><pub-id pub-id-type="pmid">13882203</pub-id></citation></ref><ref id="b12"><label>12</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Boahen</surname><given-names>K</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Bloom</surname><given-names>FE</given-names></name></person-group><article-title>Neuromorphic microchips</article-title><source>Best of the brain from Scientific American; mind, matter and tomorrow's brain</source><year>2007</year><publisher-loc>New York</publisher-loc><publisher-name>Dana Press</publisher-name></citation></ref><ref id="b13"><label>13</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Benson</surname><given-names>DF</given-names></name></person-group><source>Aphasia, alexia and agraphia</source><year>1979</year><publisher-loc>New York</publisher-loc><publisher-name>Churchill Livingstone</publisher-name></citation></ref><ref id="b14"><label>14</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Posner</surname><given-names>MI</given-names></name><name><surname>Raichle</surname><given-names>ME</given-names></name></person-group><source>Images of mind</source><year>1994</year><publisher-loc>New York</publisher-loc><publisher-name>Scientific American Library</publisher-name></citation></ref><ref id="b15"><label>15</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Stokes</surname><given-names>P</given-names></name></person-group><source>Philosophy: 100 essential thinkers</source><year>2006</year><publisher-loc>London</publisher-loc><publisher-name>Arcturus Publishing</publisher-name><fpage>182</fpage><lpage>3</lpage></citation></ref><ref id="b16"><label>16</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gray</surname><given-names>PO</given-names></name></person-group><source>Psychology</source><year>2007</year><edition>5th ed</edition><publisher-loc>New York</publisher-loc><publisher-name>Worth</publisher-name><fpage>410</fpage></citation></ref><ref id="b17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zeki</surname><given-names>S</given-names></name></person-group><article-title>The Ferrier lecture 1995 Behind the seen: The functional specialisation of the brain in space and time</article-title><source>Philos Trans R Soc Lond B Biol Sci</source><year>2005</year><volume>360</volume><issue>1458</issue><fpage>1145</fpage><lpage>83</lpage><pub-id pub-id-type="pmid">16147515</pub-id></citation></ref><ref id="b18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bartels</surname><given-names>A</given-names></name><name><surname>Zeki</surname><given-names>S</given-names></name></person-group><article-title>Functional brain mapping during free viewing of natural scenes</article-title><source>Hum Brain Map</source><year>2004</year><volume>21</volume><issue>2</issue><fpage>85</fpage><lpage>95</lpage></citation></ref><ref id="b19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thompson</surname><given-names>P</given-names></name></person-group><article-title>Margaret Thatcher: a new illusion</article-title><source>Perception</source><year>1980</year><volume>9</volume><issue>4</issue><fpage>483</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">6999452</pub-id></citation></ref><ref id="b20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haynes</surname><given-names>J-D</given-names></name><name><surname>Rees</surname><given-names>G</given-names></name></person-group><article-title>Decoding mental states from brain activity in humans</article-title><source>Nat Rev Neurosci</source><year>2006</year><volume>7</volume><issue>7</issue><fpage>523</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">16791142</pub-id></citation></ref><ref id="b21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bartels</surname><given-names>A</given-names></name><name><surname>Zeki</surname><given-names>S</given-names></name></person-group><article-title>The neural correlates of maternal and romantic love</article-title><source>Neuroimage</source><year>2004</year><volume>21</volume><issue>3</issue><fpage>1155</fpage><lpage>66</lpage><pub-id pub-id-type="pmid">15006682</pub-id></citation></ref><ref id="b22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maguire</surname><given-names>EA</given-names></name><name><surname>Spiers</surname><given-names>HJ</given-names></name><name><surname>Good</surname><given-names>CD</given-names></name><name><surname>Hartley</surname><given-names>T</given-names></name><name><surname>Frackowiak</surname><given-names>RS</given-names></name><name><surname>Burgess</surname><given-names>N</given-names></name></person-group><article-title>Navigational expertise and the human hippocampus: a structural brain imaging analysis</article-title><source>Hippocampus</source><year>2003</year><volume>13</volume><issue>2</issue><fpage>250</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">12699332</pub-id></citation></ref><ref id="b23"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mendez</surname><given-names>I</given-names></name><name><surname>Sanchez-Pernaute</surname><given-names>R</given-names></name><name><surname>Cooper</surname><given-names>O</given-names></name><name><surname>Vi&#x00144;uela</surname><given-names>A</given-names></name><name><surname>Ferrari</surname><given-names>D</given-names></name><name><surname>Bj&#x000f6;rklund</surname><given-names>L</given-names></name><etal/></person-group><article-title>Cell type analysis of functional fetal dopamine cell suspension transplants in the striatum and substantia nigra of patients with Parkinson's disease</article-title><source>Brain</source><year>2005</year><volume>128</volume><issue>7</issue><fpage>1498</fpage><lpage>510</lpage><pub-id pub-id-type="pmid">15872020</pub-id></citation></ref><ref id="b24"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ramachandran</surname><given-names>VS</given-names></name></person-group><article-title>Plasticity and functional recovery in neurology</article-title><source>Clin Med</source><year>2005</year><volume>5</volume><issue>4</issue><fpage>368</fpage><lpage>73</lpage><pub-id pub-id-type="pmid">16138492</pub-id></citation></ref><ref id="b25"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cogle</surname><given-names>CR</given-names></name><name><surname>Yachnis</surname><given-names>AT</given-names></name><name><surname>Laywell</surname><given-names>ED</given-names></name><name><surname>Zander</surname><given-names>DS</given-names></name><name><surname>Wingard</surname><given-names>JR</given-names></name><name><surname>Steindler</surname><given-names>DA</given-names></name><etal/></person-group><article-title>Bone marrow transdifferentiation in brain after transplantation: a retrospective study</article-title><source>Lancet</source><year>2004</year><volume>363</volume><issue>9419</issue><fpage>1432</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15121406</pub-id></citation></ref><ref id="b26"><label>26</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kandel</surname><given-names>ER</given-names></name></person-group><source>In search of memory: the emergence of a new science of mind</source><year>2006</year><publisher-loc>New York</publisher-loc><publisher-name>WW Norton &#x00026; Co. Ltd</publisher-name></citation></ref><ref id="b27"><label>27</label><citation citation-type="journal"><person-group person-group-type="a