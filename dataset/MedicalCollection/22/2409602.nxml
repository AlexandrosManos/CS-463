"><italic>Age (years)</italic></td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x0003c;25</td><td align="left" valign="top" charoff="50">1</td><td align="left" valign="top" charoff="50">&#x02014;</td><td align="left" valign="top" charoff="50">1</td><td align="left" valign="top" charoff="50">1</td><td align="left" valign="top" charoff="50">1</td><td align="left" valign="top" charoff="50">1</td><td align="left" valign="top" charoff="50">1</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;25&#x02013;34</td><td align="left" valign="top" charoff="50">0.8 (0.4&#x02013;1.3)</td><td align="left" valign="top" charoff="50">&#x02014;</td><td align="char" valign="top" char="(" charoff="50">1.7 (0.7&#x02013;4.6)</td><td align="char" valign="top" char="(" charoff="50">0.6 (0.3&#x02013;1.01)</td><td align="char" valign="top" char="(" charoff="50">1.0 (0.6&#x02013;1.2)</td><td align="char" valign="top" char="(" charoff="50">0.4 (0.2&#x02013;0.9)</td><td align="char" valign="top" char="(" charoff="50">0.8 (0.5&#x02013;1.3)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;35&#x02013;44</td><td align="left" valign="top" charoff="50">&#x02014;</td><td align="left" valign="top" charoff="50">1</td><td align="char" valign="top" char="(" charoff="50">0.9 (0.3&#x02013;2.7)</td><td align="char" valign="top" char="(" charoff="50">0.6 (0.3&#x02013;1.1)</td><td align="char" valign="top" char="(" charoff="50">0.8 (0.4&#x02013;1.5)</td><td align="char" valign="top" char="(" charoff="50">0.5 (0.2&#x02013;1.2)</td><td align="char" valign="top" char="(" charof