935828</pub-id></mixed-citation></ref><ref id="B10"><mixed-citation publication-type="journal"><name><surname>Schlupp</surname><given-names>I</given-names></name><article-title>The evolutionary ecology of gynogenesis</article-title><source>Annu Rev Ecol Syst</source><year>2005</year><volume>36</volume><fpage>399</fpage><lpage>417</lpage><pub-id pub-id-type="doi">10.1146/annurev.ecolsys.36.102003.152629</pub-id></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><name><surname>Bogart</surname><given-names>JP</given-names></name><name><surname>Bi</surname><given-names>K</given-names></name><name><surname>Fu</surname><given-names>J</given-names></name><name><surname>Noble</surname><given-names>D</given-names></name><name><surname>Niedzwiecki</surname><given-names>J</given-names></name><article-title>Unisexual salamanders (genus <italic>Ambystoma</italic>) present a new reproductive mode for eukaryotes</article-title><source>Genome</source><year>2007</year><volume>50</volume><fpage>119</fpage><lpage>136</lpage><pub-id pub-id-type="doi">10.1139/G06-152</pub-id><pub-id pub-id-type="pmid">17546077</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><name><surname>Hedges</surname><given-names>SB</given-names></name><name><surname>Bogart</surname><given-names>JP</given-names></name><name><surname>Maxson</surname><given-names>LR</given-names></name><article-title>Ancestry of unisexual salamanders</article-title><source>Nature</source><year>1992</year><volume>356</volume><fpage>708</fpage><lpage>710</lpage><pub-id pub-id-type="doi">10.1038/356708a0</pub-id><pub-id pub-id-type="pmid">1570014</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Spolsky</surname><given-names>CM</given-names></name><name><surname>Phillips</surname><given-names>CA</given-names></name><name><surname>Uzzell</surname><given-names>T</given-names></name><article-title>Antiquity of clonal salamander lineages revealed by mitochondrial DNA</article-title><source>Nature</source><year>1992</year><volume>356</volume><fpage>706</fpage><lpage>708</lpage><pub-id pub-id-type="doi">10.1038/356706a0</pub-id><pub-id pub-id-type="pmid">1570013</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Macgregor</surname><given-names>HC</given-names></name><name><surname>Uzzell</surname><given-names>TM</given-names></name><article-title>Gynogenesis in salamanders related to <italic>Ambystoma jeffersonianum</italic></article-title><source>Science</source><year>1964</year><volume>143</volume><fpage>1043</fpage><lpage>1045</lpage><pub-id pub-id-type="doi">10.1126/science.143.3610.1043</pub-id><pub-id pub-id-type="pmid">14112709</pub-id></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="book"><name><surname>Bogart</surname><given-names>JP</given-names></name><person-group person-group-type="editor">Sever DM</person-group><article-title>Genetics and systematics of hybrid species</article-title><source>Reproductive Biology and Phylogeny of Urodela</source><year>2003</year><volume>1</volume><publisher-name>Enfield, New Hampshire: M/s Science</publisher-name><fpage>109</fpage><lpage>134</lpage></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="journal"><name><surname>Spolsky</surname><given-names>CM</given-names></name><name><surname>Phillips</surname><given-names>CA</given-names></name><name><surname>Uzzell</surname><given-names>T</given-names></name><article-title>Gynogenetic reproduction in hybrid mole salamanders (genus <italic>Ambystoma</italic>)</article-title><source>Evolution</source><year>1992</year><volume>46</volume><fpage>1935</fpage><lpage>1944</lpage><pub-id pub-id-type="doi">10.2307/2410041</pub-id></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="journal"><name><surname>Beukeboom</surname><given-names>LW</given-names></name><name><surname>Vrijenhoek</surna