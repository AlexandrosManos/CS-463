rson-group person-group-type="author"><name><surname>Fischer</surname><given-names>HP</given-names></name><name><surname>Lankes</surname><given-names>G</given-names></name></person-group><article-title>Morphologic correlation between liver epithelium and mesenchyme allows insight into histogenesis of focal nodular hyperplasia (FNH) of the liver</article-title><source>Virchows Arch B Cell Pathol Incl Mol Pathol</source><year>1991</year><volume>60</volume><fpage>373</fpage><lpage>380</lpage><pub-id pub-id-type="pmid">1719697</pub-id><pub-id pub-id-type="doi">10.1007/BF02899569</pub-id></citation></ref></ref-list></back></article>