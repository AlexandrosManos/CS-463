 id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gerber</surname><given-names>HP</given-names></name><name><surname>Kowalski</surname><given-names>J</given-names></name><name><surname>Sherman</surname><given-names>D</given-names></name><name><surname>Eberhard</surname><given-names>DA</given-names></name><name><surname>Ferrara</surname><given-names>N</given-names></name></person-group><article-title>Complete inhibition of rhabdomyosarcoma xenograft growth and neovascularization requires blockade of both tumor and host vascular endothelial growth factor</article-title><source>Cancer Res</source><year>2000</year><volume>60</volume><fpage>6253</fpage><lpage>6258</lpage><!--PubMed citation query: 'Cancer Res||60|6253||bib9|'--><pub-id pub-id-type="pmid">11103779</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grunstein</surname><given-names>J</given-names></name><name><surname>Masbad</surname><given-names>JJ</given-names></name><name><surname>Hickey</surname><given-names>R</given-names></name><name><surname>Giordano</surname><given-names>F</given-names></name><name><surname>Johnson</surname><given-names>RS</given-names></name></person-group><article-title>Isoforms of vascular endothelial growth factor act in a coordinate fashion to recruit and expand tumor vasculature</article-title><source>Mol Cell Biol</source><year>2000</year><volume>20</volume><fpage>7282</fpage><lpage>7291</lpage><!--PubMed citation query: 'Mol Cell Biol||20|7282||bib10|'--><pub-id pub-id-type="pmid">10982845</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guo</surname><given-names>P</given-names></name><name><surname>Fang</surname><given-names>Q</given-names></name><name><surname>Tao</surname><given-names>HQ</given-names></name><name><surname>Schafer</surname><given-names>CA</given-na