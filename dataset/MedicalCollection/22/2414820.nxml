icle-title><source>J Nurs Meas</source><year>2002</year><volume>10</volume><fpage>47</fpage><lpage>58</lpage><pub-id pub-id-type="pmid">12048969</pub-id><pub-id pub-id-type="doi">10.1891/jnum.10.1.47.52545</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>H&#x000f6;fer</surname><given-names>S</given-names></name><name><surname>Benzer</surname><given-names>W</given-names></name><name><surname>Alber</surname><given-names>H</given-names></name><name><surname>Ruttmann</surname><given-names>E</given-names></name><name><surname>Kopp</surname><given-names>M</given-names></name><name><surname>Sch&#x000fc;ssler</surname><given-names>G</given-names></name><name><surname>Doering</surname><given-names>S</given-names></name></person-group><article-title>Determinants of health-related quality of life in coronary artery disease patients: a prospective study generating a structural equation model</article-title><source>Psychosomatics</source><year>2005</year><volume>46</volume><fpage>212</fpage><lpage>223</lpage><pub-id pub-id-type="pmid">15883142</pub-id><pub-id pub-id-type="doi">10.1176/appi.psy.46.3.212</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sullivan</surname><given-names>M</given-names></name><name><surname>LaCroix</surname><given-names>A</given-names></name><name><surname>Baum</surname><given-names>C</given-names></name><name><surname>Resnick</surname><given-names>A</given-names></name><name><surname>Pabiniak</surname><given-names>C</given-names></name><name><surname>Grothaus</surname><given-names>L</given-names></name><name><surname>Katon</surname><given-names>W</given-names></name><name><surname>Wagner</surname><given-names>E</given-names></name></person-group><article-title>Coronary disease severity and functional impairment: how strong is the relation?</article-title><source>J Am Geriatr Soc</source><year>1