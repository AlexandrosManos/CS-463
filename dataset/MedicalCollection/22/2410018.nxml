!--PubMed citation query: 'Proc Natl Acad Sci USA||99|3615||bib10|'--></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Workman</surname><given-names>P</given-names></name><name><surname>Twentyman</surname><given-names>P</given-names></name><name><surname>Balkwill</surname><given-names>F</given-names></name><name><surname>Balman</surname><given-names>A</given-names></name><name><surname>Chaplin</surname><given-names>D</given-names></name><name><surname>Double</surname><given-names>J</given-names></name><name><surname>Embleton</surname><given-names>J</given-names></name><name><surname>Newell</surname><given-names>D</given-names></name><name><surname>Raymond</surname><given-names>R</given-names></name><name><surname>Stables</surname><given-names>J</given-names></name><name><surname>Stephens</surname><given-names>T</given-names></name><name><surname>Wallace</surname><given-names>J</given-names></name></person-group><article-title>United Kingdom Co-ordinating Committee on Cancer Research (UKCCCR) Guidelines for the Welfare of Animals in Experimental Neoplasia (Second Edition)</article-title><source>Br J Cancer</source><year>1998</year><volume>77</volume><fpage>1</fpage><lpage>10</lpage><!--PubMed citation query: 'Br J Cancer||77|1||bib11|'--></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zanesi</surname><given-names>N</given-names></name><name><surname>Fidanza</surname><given-names>V</given-names></name><name><surname>Fong</surname><given-names>LY</given-names></name><name><surname>Mancini</surname><given-names>R</given-names></name><name><surname>Druck</surname><given-names>T</given-names></name><name><surname>Valtieri</surname><given-names>M</given-names></name><name><surname>Rudiger</surname><given-names>T</given-names></name><name><surname>McCue</surname><given-names>PA</given-names></name><name><surname>Croce</surname><given-names>CM</given-names></name><name><surname>Huebner</surname><given-names>K</given-names></name></person-group><article-title>The tumor spectrum in FHIT-deficient mice</article-title><source>Proc Natl Acad Sci USA</source><year>2001</year><volume>98</volume><fpage>10250</fpage><lpage>10255</lpage><!--PubMed citation query: 'Proc Natl Acad Sci USA||98|10250||bib12|'--></citation></ref></ref-list></back></article>