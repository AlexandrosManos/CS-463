id-type="doi">10.1111/j.1360-0443.2004.00813.x</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fridell</surname><given-names>M</given-names></name><name><surname>Hesse</surname><given-names>M</given-names></name></person-group><article-title>Clinical Diagnosis and SCID-II Assessment of DSM-III-R Personality Disorders</article-title><source>European Journal of Psychological Assessment</source><year>2006</year><volume>22</volume><fpage>104</fpage><lpage>108</lpage><pub-id pub-id-type="doi">10.1027/1015-5759.22.2.104</pub-id></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><collab>APA</collab></person-group><source>Diagnostic and Statistical Manual of Mental Disorders. Text Revision</source><year>2000</year><edition>4</edition><publisher-name>Washington, D.C., American Psychiatric Association</publisher-name></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Campbell</surname><given-names>DT</given-names></name><name><surname>Fiske</surname><given-names>DW</given-names></name></person-group><article-title>Convergent and discriminant validation by the multitrait-multimethod matrix</article-title><source>Psychol Bull</source><year>1959</year><volume>56</volume><fpage>81</fpage><lpage>105</lpage><pub-id pub-id-type="pmid">13634291</pub-id><pub-id pub-id-type="doi">10.1037/h0046016</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bagozzi</surname><given-names>RP</given-names></name><name><surname>Yi</surname><given-names>Y</given-names></name></person-group><article-title>Multitrait-multimethod matrices in consumer research.</article-title><source>Journal of Consumer Research</source><year>1991</year><volume>17</volume><fpage>426</fpage><lpage>439</lpage><pub-id pub-id-type="doi">10.1086/208568</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goodyear</surname><given-names>MD</given-names></name><name><surname>Krleza-Jeric</surname><given-names>K</given-names></name><name><surname>Lemmens</surname><given-names>T</given-names></name></person-group><article-title>The Declaration of Helsinki</article-title><source>British Medical Journal</source><year>2007</year><volume>335</volume><fpage>624</fpage><lpage>625</lpage><pub-id pub-id-type="pmid">17901471</pub-id><pub-id pub-id-type="doi">10.1136/bmj.39339.610000.BE</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rogers</surname><given-names>R</given-names></name><name><surname>Salekin</surname><given-names>RT</given-names></name><name><surname>Sewell</surname><given-names>KW</given-names></name></person-group><article-title>Validation of the Millon Clinical Multiaxial Inventory for Axis II Disorders: Does It Meet the Daubert Standard?</article-title><source> Law Hum Behav</source><year>1999</year><volume>23</volume><fpage>425</fpage><lpage>440</lpage><pub-id pub-id-type="pmid">10439726</pub-id><pub-id pub-id-type="doi">10.1023/A:1022360031491</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bronisch</surname><given-names>T</given-names></name><name><surname>Mombour</surname><given-names>W</given-names></name></person-group><article-title>The Modern Assessment of Personality Disorders. Part 2: Reliability and Validity of Personality Disorders</article-title><source>Psychopathology</source><year>1998</year><volume>31</volume><fpage>293</fpage><lpage>301</lpage><pub-id pub-id-type="doi">10.1159/000029053</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Klonsky</surname><given-names>ED</given-names></name><name><surname>Oltmanns</surname><given-names>TF</given-names></name><name><surname>Turkheimer</surname><given-names>E</given-names></name></person-group><article-title>Informant-reports of Personality Disorders: Relation to Self-Reports and Future Research Diretions</article-title><source>Clinical psychology: Science and Practice</source><year>2002</year><volume>9</volume><fpage>300</fpage><lpage>311</lpage><pub-id pub-id-type="doi">10.1093/clipsy/9.3.300</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Saulsman</surname><given-names>LM</given-names></name><name><surname>Page</surname><given-names>AC</given-names></name></person-group><article-title>The five-factor model and personality disorder empirical literature: A meta-analytic review</article-title><source>Clin Psychol Rev</source><year>2004</year><volume>23</volume><fpage>1055</fpage><lpage>1085</lpage><pub-id pub-id-type="pmid">14729423</pub-id><pub-id pub-id-type="doi">10.1016/j.cpr.2002.09.001</pub-id></citation></ref></ref-list></back></article>