e><lpage>218</lpage><pub-id pub-id-type="pmid">9931260</pub-id></citation></ref><ref id="pone.0002403-Hansen1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hansen</surname><given-names>TH</given-names></name><name><surname>Lybarger</surname><given-names>L</given-names></name><name><surname>Yu</surname><given-names>L</given-names></name><name><surname>Mitaksov</surname><given-names>V</given-names></name><name><surname>Fremont</surname><given-names>DH</given-names></name></person-group><year>2005</year><article-title>Recognition of open conformers of classical MHC by chaperones and monoclonal antibodies.</article-title><source>Immunol Rev</source><volume>207</volume><fpage>100</fpage><lpage>111</lpage><pub-id pub-id-type="pmid">16181330</pub-id></citation></ref><ref id="pone.0002403-Zarutskie1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zarutskie</surname><given-names>JA</given-names></name><name><surname>Sato</surname><given-names>AK</given-names></name><name><surname>Rushe</surname><given-names>MM</given-names></name><name><surname>Chan</surname><given-names>IC</given-names></name><name><surname>Lomakin</surname><given-names>A</given-names></name><etal/></person-group><year>1999</year><article-title>A conformational change in the human major histocompatibility complex protein HLA-DR1 induced by peptide binding.</article-title><source>Biochemistry</source><volume>38</volume><fpage>5878</fpage><lpage>5887</lpage><pub-id pub-id-type="pmid">10231540</pub-id></citation></ref><ref id="pone.0002403-Sato1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sato</surname><given-names>AK</given-names></name><name><surname>Zarutskie</surname><given-names>JA</given-names></name><name><surname>Rushe</surname><given-names>MM</given-names></name><name><surname>Lomakin</surname><given-names>A</given-names