><tr><td colspan="7" align="left" valign="top" charoff="50"><italic>Years since menopause</italic><sup>a</sup></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Mean&#x000b1;s.d. (range)</td><td colspan="2" align="center" valign="top" charoff="50">13.9&#x000b1;1.7 (10&#x02013;18)</td><td colspan="2" align="center" valign="top" charoff="50">13.6&#x000b1;1.6 (9&#x02013;17)</td><td colspan="2" align="center" valign="top" charoff="50">14.2&#x000b1;1.9 (10&#x02013;18)</td></tr><tr><td colspan="7" align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="7" align="left" valign="top" charoff="50"><italic>Smoking</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Never</td><td align="center" valign="top" char="." charoff="50">30</td><td align="center" valign="top" char="." charoff="50">69.8</td><td align="center" valign="top" char="." charoff="50">71</td><td align="center" valign="top" char="." charoff="50">82.6</td><td align="center" valign="top" char="." charoff="50">70</td><td align="center" valign="top" char="." charoff="50">81.4</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Ever</td><td align="center" valign="top" char="." charoff="50">13</td><td align="center" valign="top" char="." charoff="50">30.2</td><td align="center" valign="top" char="." charoff="50">15</td><td align="center" valign="top" char="." charoff="50">17.4</td><td align="center" valign="top" char="." charoff="50">16</td><td align="center" valign="top" char="." charoff="50">18.6</td></tr><tr><td colspan="7" align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="7" align="left" valign="top" charoff="50"><italic>Tubal ligation</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Never</td><td align="center" valign="top" char="." charoff="50">40</td><td align="center" valign="top" char="." charoff="50">93.0</td><td align="center" valign="top" char="." charoff="50">84</td><td align="center" vali