owspan="1" colspan="1">&#x0002b;</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">&#x0002b;</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">TC7908</td><td align="left" rowspan="1" colspan="1">Myosin, essential light chain</td><td align="left" rowspan="1" colspan="1">&#x0002b;</td><td align="left" rowspan="1" colspan="1">&#x0002b;</td><td align="left" rowspan="1" colspan="1">&#x0002b;</td><td align="left" rowspan="1" colspan="1">&#x0002b;</td></tr><tr><td align="left" rowspan="1" colspan="1">TC7917</td><td align="left" rowspan="1" colspan="1">Pyruvate dehydrogenase</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">&#x0002b;</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">TC7969</td><td align="left" rowspan="1" colspan="1"><italic>alt-3</italic>, abundant larval transcript</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">&#x0002b;</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">TC7999</td><td align="left" rowspan="1" colspan="1">Triosephosphate isomerase</td><td align="left" rowspan="1" colspan="1">&#x0002b;</td><td align="left" rowspan="1" colspan="1">&#x0002b;</td><td align="left" rowspan="1" colspan="1">&#x0002b;</td><td align="left" rowspan="1" colspan="1">&#x0002b;</td></tr><tr><td align="left" rowspan="1" colspan="1">TC8010</td><td align="left" rowspan="1" colspan="1"><italic>cpi-1</italic>, cystatin</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">&#x0002b;</td><td align="left" rowspan="1" colspan="1">&#x0002b;</td><td align="left" rowspan="1" colspan="1">&#x0002b;</td></tr><tr><td align="left" rowspan="1" colspan="1">TC8015</td><td align="left" rowspan="1" colspan="1">Unknown</td><td alig