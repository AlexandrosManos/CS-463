ation-type="book"><person-group person-group-type="author"><collab>Office for National Statistics</collab></person-group><article-title/><source>Ethnicity in the 1991 Census. Vol 2. The Ethnic Minority Populations of Great Britain</source><year>1996</year><publisher-name>London: HMSO</publisher-name></citation></ref><ref id="bib18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Patel</surname><given-names>V</given-names></name></person-group><article-title/><source>Babies Names from the Indian Subcontinent</source><year>1992</year><publisher-name>London: Foulsham</publisher-name></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sainsbury</surname><given-names>R</given-names></name><name><surname>Johnston</surname><given-names>C</given-names></name><name><surname>Haward</surname><given-names>B</given-names></name></person-group><article-title>Effect on survival of delays in referral of patients with breast-cancer symptoms: a retrospective analysis</article-title><source>Lancet</source><year>1999</year><volume>353</volume><fpage>1132</fpage><lpage>1135</lpage><!--PubMed citation query: 'Lancet||353|1132||bib19|'--><pub-id pub-id-type="pmid">10209976</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sainsbury</surname><given-names>R</given-names></name><name><surname>Rider</surname><given-names>L</given-names></name><name><surname>Smith</surname><given-names>A</given-names></name><name><surname>MacAdam</surname><given-names>A</given-names></name></person-group><article-title>Does it matter where you live? Treatment variation for breast cancer in Yorkshire. The Yorkshire Breast Cancer Group</article-title><source>Br J Cancer</source><year>1995</year><volume>71</volume><fpage>1275</fpage><lpage>1278</lpage><!--PubMed citation query: 'Br J Cancer||71|1275||bib20|'--><pub-id pub-id-type="pmid">7779723</pub-id></citation></ref><ref id="bib21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Schimmel</surname><given-names>A</given-names></name></person-group><article-title/><source>Islamic Names</source><year>1989</year><publisher-name>Edinburgh: Edinburgh University Press.</publisher-name></citation></ref><ref id="bib22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Selby</surname><given-names>P</given-names></name></person-group><article-title>Cancer clinical outcomes for minority ethnic groups</article-title><source>Br J Cancer</source><year>1996</year><volume>74</volume><supplement>Suppl 29</supplement><fpage>S54</fpage><lpage>S60</lpage><!--PubMed citation query: 'Br J Cancer||74|S54||bib22|'--></citation></ref><ref id="bib23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>LK</given-names></name><name><surname>Botha</surname><given-names>JL</given-names></name><name><surname>Benghiat</surname><given-names>A</given-names></name><name><surname>Steward</surname><given-names>WP</given-names></name></person-group><article-title>Latest trends in cancer incidence among UK South Asians in Leicester</article-title><source>Br J Cancer</source><year>2003</year><volume>89</volume><fpage>70</fpage><lpage>73</lpage><!--PubMed citation query: 'Br J Cancer||89|70||bib23|'--><pub-id pub-id-type="pmid">12838302</pub-id></citation></ref><ref id="bib24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Swerdlow</surname><given-names>AJ</given-names></name><name><surname>Marmot</surname><given-names>MG</given-names></name><name><surname>Grulich</surname><given-names>AE</given-names></name><name><surname>Head</surname><given-names>J</given-names></name></person-group><article-title>Cancer mortality in Indian and British ethnic immigrants from the Indian subcontinent to England and Wales</article-title><source>Br J Cancer</source><year>1995</year><volume>72</volume><fpage>1312</fpage><lpage>1319</lpage><!--PubMed citation query: 'Br J Cancer||72|1312||bib24|'--><pub-id pub-id-type="pmid">7577489</pub-id></citation></ref><ref id="bib25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tam</surname><given-names>AK</given-names></name><name><surname>Padilla</surname><given-names>G</given-names></name><name><surname>Tejero</surname><given-names>J</given-names></name><name><surname>Kagawa-Singer</surname><given-names>M</given-names></name></person-group><article-title>Understanding the breast cancer experience of Asian American women</article-title><source>Psychooncology</source><year>2003</year><volume>12</volume><fpage>38</fpage><lpage>58</lpage><!--PubMed citation query: 'Psychooncology||12|38||bib25|'--><pub-id pub-id-type="pmid">12548647</pub-id></citation></ref><ref id="bib26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wild</surname><given-names>S</given-names></name><name><surname>McKeigue</surname><given-names>P</given-names></name></person-group><article-title>Cross sectional analysis of mortality by country of birth in England and Wales, 1970&#x02013;92</article-title><source>Br Med J</source><year>1997</year><volume>314</volume><fpage>705</fpage><lpage>710</lpage><!--PubMed citation query: 'Br Med J||314|705||bib26|'--></citation></ref><ref id="bib27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Winter</surname><given-names>H</given-names></name><name><surname>Cheng</surname><given-names>KK</given-names></name><name><surname>Cummins</surname><given-names>C</given-names></name><name><surname>Maric</surname><given-names>R</given-names></name><name><surname>Silcocks</surname><given-names>P</given-names></name><name><surname>Varghese</surname><given-names>C</given-names></name></person-group><article-title>Cancer incidence in the South Asian population of England (1990&#x02013;92)</article-title><source>Br J Cancer</source><year>1999</year><volume>79</volume><fpage>645</fpage><lpage>654</lpage><!--PubMed citation query: 'Br J Cancer||79|645||bib27|'--><pub-id pub-id-type="pmid">10027344</pub-id></citation></ref></ref-list></back></article>