me><surname>Kasra</surname><given-names>M</given-names></name><name><surname>Merryman</surname><given-names>WD</given-names></name><name><surname>Loveless</surname><given-names>KN</given-names></name><name><surname>Goel</surname><given-names>VK</given-names></name><name><surname>Martin</surname><given-names>JD</given-names></name><etal/></person-group><year>2006</year><article-title>Frequency response of pig intervertebral disc cells subjected to dynamic hydrostatic pressure.</article-title><source>J Orthop Res</source><volume>24</volume><fpage>1967</fpage><lpage>1973</lpage><pub-id pub-id-type="pmid">16900539</pub-id></citation></ref><ref id="pone.0002341-Reza1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reza</surname><given-names>AT</given-names></name><name><surname>Nicoll</surname><given-names>SB</given-names></name></person-group><year>2008</year><article-title>Hydrostatic pressure differentially regulates outer and inner annulus fibrosus cell matrix production in 3D scaffolds.</article-title><source>Ann Biomed Eng</source><volume>36</volume><fpage>204</fpage><lpage>213</lpage><pub-id pub-id-type="pmid">18026839</pub-id></citation></ref><ref id="pone.0002341-Wuertz1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wuertz</surname><given-names>K</given-names></name><name><surname>Urban</surname><given-names>JP</given-names></name><name><surname>Klasen</surname><given-names>J</given-names></name><name><surname>Ignatius</surname><given-names>A</given-names></name><name><surname>Wilke</surname><given-names>HJ</given-names></name><etal/></person-group><year>2007</year><article-title>Influence of extracellular osmolarity and mechanical stimulation on gene expression of intervertebral disc cells.</article-title><source>J Orthop Res</source><volume>25</volume><fpage>1513</fpage><lpage>1522</lpage><pub-id pub-id-type="pmid">17568421</pub-id></citation></ref><ref id="pone.0002341-Nowlan1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nowlan</surname><given-names>NC</given-names></name><name><surname>Murphy</surname><given-names>P</given-names></name><name><surname>Prendergast</surname><given-names>PJ</given-names></name></person-group><year>2008</year><article-title>A dynamic pattern of mechanical stimulation promotes ossification in avian embryonic long bones.</article-title><source>J Biomech</source><volume>41</volume><fpage>249</fpage><lpage>258</lpage><pub-id pub-id-type="pmid">18005973</pub-id></citation></ref><ref id="pone.0002341-Stover1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stover</surname><given-names>J</given-names></name><name><surname>Nagatomi</surname><given-names>J</given-names></name></person-group><year>2007</year><article-title>Cyclic pressure stimulates DNA synthesis through the PI3K/Akt signaling pathway in rat bladder smooth muscle cells.</article-title><source>Ann Biomed Eng</source><volume>35</volume><fpage>1585</fpage><lpage>1594</lpage><pub-id pub-id-type="pmid">17522977</pub-id></citation></ref><ref id="pone.0002341-MullerMarschhausen1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Muller-Marschhausen</surname><given-names>K</given-names></name><name><surname>Waschke</surname><given-names>J</given-names></name><name><surname>Drenckhahn</surname><given-names>D</given-names></name></person-group><year>2008</year><article-title>Physiological hydrostatic pressure protects endothelial monolayer integrity.</article-title><source>Am J Physiol Cell Physiol</source><volume>294</volume><fpage>C324</fpage><lpage>332</lpage><pub-id pub-id-type="pmid">17977944</pub-id></citation></ref><ref id="pone.0002341-Benson1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name