mes></name><name><surname>Glowacki</surname><given-names>J</given-names></name></person-group><year>2002</year><article-title>Hydrostatic fluid pressure enhances matrix synthesis and accumulation by bovine chondrocytes in three-dimensional culture.</article-title><source>J Cell Physiol</source><volume>193</volume><fpage>319</fpage><lpage>327</lpage><pub-id pub-id-type="pmid">12384984</pub-id></citation></ref><ref id="pone.0002341-Parkkinen1"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parkkinen</surname><given-names>JJ</given-names></name><name><surname>Ikonen</surname><given-names>J</given-names></name><name><surname>Lammi</surname><given-names>MJ</given-names></name><name><surname>Laakkonen</surname><given-names>J</given-names></name><name><surname>Tammi</surname><given-names>M</given-names></name><etal/></person-group><year>1993</year><article-title>Effects of cyclic hydrostatic pressure on proteoglycan synthesis in cultured chondrocytes and articular cartilage explants.</article-title><source>Arch Biochem Biophys</source><volume>300</volume><fpage>458</fpage><lpage>465</lpage><pub-id pub-id-type="pmid">8424680</pub-id></citation></ref><ref id="pone.0002341-Smith1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>RL</given-names></name><name><surname>Carter</surname><given-names>DR</given-names></name><name><surname>Schurman</surname><given-names>DJ</given-names></name></person-group><year>2004</year><article-title>Pressure and shear differentially alter human articular chondrocyte metabolism: a review.</article-title><source>Clin Orthop Relat Res</source><fpage>S89</fpage><lpage>95</lpage><pub-id pub-id-type="pmid">15480081</pub-id></citation></ref><ref id="pone.0002341-Toyoda1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Toyoda</surname><given-names>T</giv