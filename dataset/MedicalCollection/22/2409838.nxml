pe="journal"><person-group person-group-type="author"><name><surname>Koutsky</surname><given-names>LA</given-names></name><name><surname>Holmes</surname><given-names>KK</given-names></name><name><surname>Critchlow</surname><given-names>CW</given-names></name><name><surname>Stevens</surname><given-names>CE</given-names></name><name><surname>Paavonen</surname><given-names>J</given-names></name><name><surname>Beckmann</surname><given-names>AM</given-names></name><name><surname>DeRouen</surname><given-names>TA</given-names></name><name><surname>Galloway</surname><given-names>DA</given-names></name><name><surname>Vernon</surname><given-names>D</given-names></name><name><surname>Kiviat</surname><given-names>NB</given-names></name></person-group><article-title>A cohort study of the risk of cervical intraepithelial neoplasia grade 2 or 3 in relation to papillomavirus infection</article-title><source>N Engl J Med</source><year>1992</year><volume>327</volume><fpage>1272</fpage><lpage>1278</lpage><!--PubMed citation query: 'N Engl J Med||327|1272||bib11|'--><pub-id pub-id-type="pmid">1328880</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McIndoe</surname><given-names>WA</given-names></name><name><surname>McLean</surname><given-names>MR</given-names></name><name><surname>Jones</surname><given-names>RW</given-names></name><name><surname>Mullins</surname><given-names>PR</given-names></name></person-group><article-title>The invasive potential of carcinoma <italic>in situ</italic> of the cervix</article-title><source>Obstet Gynecol</source><year>1984</year><volume>64</volume><fpage>451</fpage><lpage>458</lpage><!--PubMed citation query: 'Obstet Gynecol||64|451||bib12|'--><pub-id pub-id-type="pmid">6483293</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Melkert</surname><given-names>PW</given-names></name><name><surnam