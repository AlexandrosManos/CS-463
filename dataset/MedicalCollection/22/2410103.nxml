-title>Diagnosis of gastrointestinal stromal tumors: a consensus approach</article-title><source>Hum Pathol</source><year>2002</year><volume>33</volume><fpage>459</fpage><lpage>465</lpage><!--PubMed citation query: 'Hum Pathol||33|459||bib13|'--><pub-id pub-id-type="pmid">12094370</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hassan</surname><given-names>I</given-names></name><name><surname>You</surname><given-names>N</given-names></name><name><surname>Dozois</surname><given-names>EJ</given-names></name><name><surname>Shayyan</surname><given-names>R</given-names></name><name><surname>Smyrk</surname><given-names>TC</given-names></name><name><surname>Okuno</surname><given-names>SH</given-names></name><name><surname>Donohue</surname><given-names>JH</given-names></name></person-group><article-title>Clinical, pathologic, and immunohistochemical characteristics of gastrointestinal stromal tumors of the colon and rectum: implications for surgical management and adjuvant therapies</article-title><source>Dis Colon Rectum</source><year>2006</year><volume>49</volume><fpage>609</fpage><lpage>615</lpage><!--PubMed citation query: 'Dis Colon Rectum||49|609||bib14|'--><pub-id pub-id-type="pmid">16552495</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hirota</surname><given-names>S</given-names></name><name><surname>Isozaki</surname><given-names>K</given-names></name></person-group><article-title>Pathology of gastrointestinal stromal tumors</article-title><source>Pathol Int</source><year>2006</year><volume>56</volume><fpage>1</fpage><lpage>9</lpage><!--PubMed citation query: 'Pathol Int||56|1||bib16|'--><pub-id pub-id-type="pmid">16398673</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hornick</surname><given-names>JL</given-names></na