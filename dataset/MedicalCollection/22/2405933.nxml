/label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Newton</surname><given-names>I</given-names></name></person-group><year>1998</year><source>Population limitation in birds</source><publisher-loc>London</publisher-loc><publisher-name>Academic Press</publisher-name></citation></ref><ref id="pone.0002400-Salo1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Salo</surname><given-names>P</given-names></name><name><surname>Korpim&#x000e4;ki</surname><given-names>E</given-names></name><name><surname>Banks</surname><given-names>PH</given-names></name><name><surname>Nordstr&#x000f6;m</surname><given-names>M</given-names></name><name><surname>Dickman</surname><given-names>CR</given-names></name></person-group><year>2007</year><article-title>Alien predators are more dangerous than native predators to prey populations.</article-title><source>Proc Roy Soc Lond Ser B</source><volume>274</volume><fpage>1237</fpage><lpage>1243</lpage></citation></ref><ref id="pone.0002400-Parr1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parr</surname><given-names>R</given-names></name></person-group><year>1993</year><article-title>Nest Predation and numbers of Golden Plovers <italic>Pluvialis apricaria</italic> and other moorland waders.</article-title><source>Bird Study</source><volume>40</volume><fpage>223</fpage><lpage>231</lpage></citation></ref><ref id="pone.0002400-Parker1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parker</surname><given-names>M</given-names></name></person-group><year>1984</year><article-title>Effect of corvid removal on reproduction of willow ptarmigan and black grouse.</article-title><source>J Wildl Mgmt</source><volume>48</volume><fpage>1197</fpage><lpage>1205</lpage></citation></ref><ref id="pone.0002400-Korpimki3"><label>26</label><citation