citation citation-type="journal"><person-group person-group-type="author"><name><surname>Onland-Moret</surname><given-names>NC</given-names></name><name><surname>Kaaks</surname><given-names>R</given-names></name><name><surname>van Noord</surname><given-names>PA</given-names></name><name><surname>Rinaldi</surname><given-names>S</given-names></name><name><surname>Key</surname><given-names>TJ</given-names></name><name><surname>Grobbee</surname><given-names>DE</given-names></name><name><surname>Peeters</surname><given-names>PH</given-names></name></person-group><article-title>Urinary endogenous sex hormone levels and the risk of postmenopausal breast cancer</article-title><source>Br J Cancer</source><year>2003</year><volume>88</volume><fpage>1394</fpage><lpage>1399</lpage><!--PubMed citation query: 'Br J Cancer||88|1394||bib6|'--><pub-id pub-id-type="pmid">12778067</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pomerantz</surname><given-names>L</given-names></name><name><surname>Mulinos</surname><given-names>MG</given-names></name></person-group><article-title>Pseudo-hypophysectomy produced by inanition</article-title><source>Am J Physiol</source><year>1939</year><volume>126</volume><fpage>601</fpage><!--PubMed citation query: 'Am J Physiol||126|601||bib7|'--></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rinaldi</surname><given-names>S</given-names></name><name><surname>Onland-Moret</surname><given-names>NC</given-names></name><name><surname>Kaaks</surname><given-names>R</given-names></name><name><surname>Biessy</surname><given-names>C</given-names></name><name><surname>Kurzer</surname><given-names>MS</given-names></name><name><surname>Dechaud</surname><given-names>H</given-names></name><name><surname>Peeters</surname><given-names>PH</given-names></name><name><surname>van Noord</surname><given-names>PA</given-name