<name><surname>Vacanti</surname><given-names>J</given-names></name></person-group><article-title>Bone regeneration through cellular engineering</article-title><source>Principles of tissue engineering</source><year>2000</year><edition>2</edition><publisher-loc>San Diego</publisher-loc><publisher-name>Academic Pr</publisher-name><fpage>683</fpage><lpage>96</lpage></citation></ref><ref id="b7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Che</surname><given-names>B</given-names></name><name><surname>Lakshmi</surname><given-names>BB</given-names></name><name><surname>Martin</surname><given-names>CR</given-names></name><etal/></person-group><article-title>Chemical vapour based synthesis of carbon nanotubes and nanofibers using a template method</article-title><source>Chem Mater</source><year>1998</year><volume>10</volume><fpage>260</fpage><lpage>7</lpage></citation></ref><ref id="b8"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Clark</surname><given-names>RAF</given-names></name><name><surname>Singer</surname><given-names>AJ</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Lanza</surname><given-names>RP</given-names></name><name><surname>Langer</surname><given-names>R</given-names></name><name><surname>Vacanti</surname><given-names>J</given-names></name></person-group><article-title>Wound repair: basic biology to tissue engineering</article-title><source>Principles of tissue engineering</source><year>2000</year><edition>2</edition><publisher-loc>San Diego</publisher-loc><publisher-name>Academic Pr</publisher-name><fpage>855</fpage><lpage>78</lpage></citation></ref><ref id="b9"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Colwell</surname><given-names>CW</given-names></name><name><surname>D&#x02019;Lima</surname><given-names>DD</given-names></name><name><surname>Lotz</surname><given-names>M</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Brighton</surname><given-names>CT</given-names></name></person-group><article-title>Articular cartilage repair</article-title><source>Clinical orthopaedics and related research</source><year>2001</year><volume>391S</volume><publisher-loc>Pennsylvania</publisher-loc><publisher-name>Lippincott Williams and Wilkins</publisher-name></citation></ref><ref id="b10"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cooper</surname><given-names>SL</given-names></name><name><surname>Visser</surname><given-names>SA</given-names></name><name><surname>Hergenrother</surname><given-names>RW</given-names></name><etal/></person-group><person-group person-group-type="editor"><name><surname>Ratner</surname><given-names>BD</given-names></name><name><surname>Hoffman</surname><given-names>AS</given-names></name><name><surname>Schoen</surname><given-names>FJ</given-names></name><etal/></person-group><article-title>Polymer</article-title><source>Biomaterial science: an introduction to materials in medicine</source><year>2004</year><edition>2</edition><publisher-loc>San Diego</publisher-loc><publisher-name>Elsevier Academic Pr</publisher-name><fpage>67</fpage><lpage>79</lpage></citation></ref><ref id="b11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cui</surname><given-names>H</given-names></name><name><surname>Zhou</surname><given-names>O</given-names></name><name><surname>Stoner</surname><given-names>BR</given-names></name></person-group><article-title>Deposition of aligned bamboo-like carbon nanotubes via microwave plasma enhanced chemical vapor deposition</article-title><source>J Appl Phys</source><year>2000</year><volume>88</volume><fpage>6072</fpage><lpage>4</lpage></citation></ref><ref id="b12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>DiEdwardo</surname><given-names>CA</given-n