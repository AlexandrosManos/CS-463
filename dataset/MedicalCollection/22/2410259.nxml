olume>160</volume><fpage>3480</fpage><lpage>3486</lpage><pub-id pub-id-type="pmid">9531309</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jaeschke</surname><given-names>H</given-names></name><name><surname>Farhood</surname><given-names>A</given-names></name><name><surname>Smith</surname><given-names>CW</given-names></name></person-group><article-title>Neutrophil-induced liver cell injury in endotoxin shock is a CD11b/CD18-dependent mechanism</article-title><source>Am J Physiol</source><year>1991</year><volume>261</volume><fpage>G1051</fpage><lpage>G1056</lpage><pub-id pub-id-type="pmid">1767846</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jaeschke</surname><given-names>H</given-names></name><name><surname>Ho</surname><given-names>Y-S</given-names></name><name><surname>Fisher</surname><given-names>MA</given-names></name><name><surname>Lawson</surname><given-names>JA</given-names></name><name><surname>Farhood</surname><given-names>A</given-names></name></person-group><article-title>Glutathione peroxidase deficient mice are more susceptible to neutrophil-mediated hepatic parenchymal cell injury during endotoxemia: importance of an intracellular oxidant stress</article-title><source>Hepatology</source><year>1999</year><volume>29</volume><fpage>443</fpage><lpage>450</lpage><pub-id pub-id-type="pmid">9918921</pub-id><pub-id pub-id-type="doi">10.1002/hep.510290222</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bajt</surname><given-names>ML</given-names></name><name><surname>Lawson</surname><given-names>JA</given-names></name><name><surname>Vonderfecht</surname><given-names>SL</given-names></name><name><surname>Gujral</surname><given-names>JS</given-names></name><name><surname>Jaeschke</surname><given-names>H</given-names></name></pe