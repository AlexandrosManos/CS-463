J Exp Med</source><year>2000</year><volume>192</volume><fpage>1015</fpage><lpage>1026</lpage><pub-id pub-id-type="pmid">11015442</pub-id><pub-id pub-id-type="doi">10.1084/jem.192.7.1015</pub-id></citation></ref></ref-list></back></article>