<volume>64</volume><fpage>304</fpage><lpage>309</lpage><pub-id pub-id-type="pmid">481972</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cutts</surname><given-names>F</given-names></name><name><surname>Soares</surname><given-names>A</given-names></name><name><surname>Jecque</surname><given-names>AV</given-names></name><name><surname>Cliff</surname><given-names>J</given-names></name><name><surname>Kortbeek</surname><given-names>S</given-names></name><name><surname>Colombo</surname><given-names>S</given-names></name></person-group><article-title>The use of evaluation to improve the Expanded Programme on Immunization in Mozambique</article-title><source>Bulletin of the World Health Organization</source><year>1990</year><volume>68</volume><fpage>199</fpage><lpage>208</lpage><pub-id pub-id-type="pmid">2364478</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bond</surname><given-names>L</given-names></name><name><surname>Nolan</surname><given-names>T</given-names></name><name><surname>Pattison</surname><given-names>P</given-names></name><name><surname>Carlin</surname><given-names>J</given-names></name></person-group><article-title>Vaccine preventable diseases and immunisations: a qualitative study of mothers' perceptions of severity, susceptibility, benefits and barriers</article-title><source>Australian and New Zealand journal of public health</source><year>1998</year><volume>22</volume><fpage>441</fpage><lpage>446</lpage><pub-id pub-id-type="pmid">9659770</pub-id><pub-id pub-id-type="doi">10.1111/j.1467-842X.1998.tb01411.x</pub-id></citation></ref></ref-list></back></article>