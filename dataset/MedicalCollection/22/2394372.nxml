p-type="author"><name><surname>Holland</surname><given-names>EC</given-names></name></person-group><article-title>Glioblastoma multiforme: the terminator</article-title><source>Proc Natl Acad Sci USA</source><year>2000</year><volume>97</volume><fpage>6242</fpage><lpage>6244</lpage><!--PubMed citation query: 'Proc Natl Acad Sci USA||97|6242||bib9|'--></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Iwadate</surname><given-names>Y</given-names></name><name><surname>Fujimoto</surname><given-names>S</given-names></name><name><surname>Tagawa</surname><given-names>M</given-names></name><name><surname>Namba</surname><given-names>H</given-names></name><name><surname>Sueyoshi</surname><given-names>K</given-names></name><name><surname>Hirose</surname><given-names>M</given-names></name><name><surname>Sakiyama</surname><given-names>S</given-names></name></person-group><article-title>Association of p53 gene mutation with decreased chemosensitivity in human malignant gliomas</article-title><source>Int J Cancer</source><year>1996</year><volume>69</volume><fpage>236</fpage><lpage>240</lpage><!--PubMed citation query: 'Int J Cancer||69|236||bib10|'--><pub-id pub-id-type="pmid">8682593</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Khuri</surname><given-names>FR</given-names></name><name><surname>Nemunaitis</surname><given-names>J</given-names></name><name><surname>Ganly</surname><given-names>I</given-names></name><name><surname>Arseneau</surname><given-names>J</given-names></name><name><surname>Tannock</surname><given-names>IF</given-names></name><name><surname>Romel</surname><given-names>L</given-names></name><name><surname>Gore</surname><given-names>M</given-names></name><name><surname>Ironside</surname><given-names>J</given-names></name><name><surname>MacDougall</surname><given-names>RH</given-names></name><name><surname>Hei