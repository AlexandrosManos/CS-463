<volume>156</volume><fpage>616</fpage><lpage>626</lpage><!--PubMed citation query: 'Am J Epidemiol||156|616||bib16|'--><pub-id pub-id-type="pmid">12244030</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lash</surname><given-names>TL</given-names></name><name><surname>Aschengrau</surname><given-names>A</given-names></name></person-group><article-title>Active and passive cigarette smoking and the occurrence of breast cancer</article-title><source>Am J Epidemiol</source><year>1999</year><volume>149</volume><fpage>5</fpage><lpage>12</lpage><!--PubMed citation query: 'Am J Epidemiol||149|5||bib17|'--><pub-id pub-id-type="pmid">9883788</pub-id></citation></ref><ref id="bib18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lash</surname><given-names>TL</given-names></name><name><surname>Aschengrau</surname><given-names>A</given-names></name></person-group><article-title>A null association between active or passive cigarette smoking and breast cancer risk</article-title><source>Breast Cancer Res Treat</source><year>2002</year><volume>75</volume><fpage>181</fpage><lpage>184</lpage><!--PubMed citation query: 'Breast Cancer Res Treat||75|181||bib18|'--><pub-id pub-id-type="pmid">12243511</pub-id></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lawlor</surname><given-names>DA</given-names></name><name><surname>Bedford</surname><given-names>C</given-names></name><name><surname>Taylor</surname><given-names>M</given-names></name><name><surname>Ebrahim</surname><given-names>S</given-names></name></person-group><article-title>Geographical variation in cardiovascular disease, risk factors, and their control in older women: British Women's Heart and Health Study</article-title><source>J Epidemiol Community Health</source><year>2003a</year><volume>57</volume><fpage>134</fpage><lpage>140</l