-wrap-foot></table-wrap><table-wrap id="pone-0002330-t003" position="float"><object-id pub-id-type="doi">10.1371/journal.pone.0002330.t003</object-id><label>Table 3</label><caption><title>Characteristics of MDSs, IESs, and pointers of the <italic>O. trifallax TEBP</italic>&#x003b1; gene.</title></caption><graphic id="pone-0002330-t003-3" xlink:href="pone.0002330.t003"/><table frame="hsides" rules="groups" alternate-form-of="pone-0002330-t003-3"><colgroup span="1"><col align="left" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/></colgroup><thead><tr><td align="left" rowspan="1" colspan="1"><italic>MDS m</italic></td><td align="left" rowspan="1" colspan="1"><italic>Length&#x0002a; of MDS m</italic></td><td align="left" rowspan="1" colspan="1"><italic>Pointer sequence between MDS m and m&#x0002b;1</italic></td><td align="left" rowspan="1" colspan="1"><italic>IES i</italic></td><td align="left" rowspan="1" colspan="1"><italic>between MDSs</italic></td><td align="left" rowspan="1" colspan="1"><italic>Length&#x0002a; of IES i</italic></td></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">196</td><td align="left" rowspan="1" colspan="1"><bold><named-content content-type="gene">TGCA(C/A)CAAAGAA</named-content></bold></td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">1&#x02013;3</td><td align="left" rowspan="1" colspan="1">42</td></tr><tr><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">293</td><td align="left" rowspan="1" colspan="1"><bold><named-content content-type="gene">TTGTCTTG</named-content></bold></td><td align="left" rowspan="1" colspan="1">7</td><td align="left" rowspan="1" colspan="1">2&#x02013;4</td><td align="left" rowspan="1" colspan="1">38</td></tr><tr><td align="left" rowspan="1" colspan="1">3</td><td align