">12727393</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(03)13132-7</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shen</surname><given-names>Y</given-names></name><name><surname>Yang</surname><given-names>Y</given-names></name><name><surname>Inoue</surname><given-names>LYT</given-names></name><name><surname>Miller</surname><given-names>AB</given-names></name><name><surname>Berry</surname><given-names>DA</given-names></name></person-group><article-title>Role of detection in predicting breast cancer survival: analysis of randomized screening trials</article-title><source>J Natl Cancer Inst</source><year>2005</year><volume>97</volume><fpage>1195</fpage><lpage>1203</lpage><pub-id pub-id-type="pmid">16106024</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Joensuu</surname><given-names>H</given-names></name><name><surname>Lehtmaki</surname><given-names>T</given-names></name><name><surname>Holli</surname><given-names>K</given-names></name><name><surname>Elomaa</surname><given-names>L</given-names></name><name><surname>Turpeenniemi-Hujanen</surname><given-names>T</given-names></name><name><surname>Anttila</surname><given-names>A</given-names></name><name><surname>Lundin</surname><given-names>M</given-names></name><name><surname>Isola</surname><given-names>J</given-names></name><name><surname>Lundin</surname><given-names>J</given-names></name></person-group><article-title>Risk for distant recurrence of breast cancer detected by mammography screening or other methods</article-title><source>JAMA</source><year>2004</year><volume>292</volume><fpage>1064</fpage><lpage>1073</lpage><pub-id pub-id-type="pmid">15339900</pub-id><pub-id pub-id-type="doi">10.1001/jama.292.9.1064</pub-id></citation></ref><ref id="B9"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Herbert</surname><g