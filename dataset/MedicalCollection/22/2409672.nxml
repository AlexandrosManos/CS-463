name><name><surname>Montella</surname><given-names>M</given-names></name><name><surname>Nanni</surname><given-names>O</given-names></name><name><surname>La Vecchia</surname><given-names>C</given-names></name></person-group><article-title>The influence of reproductive and hormonal factors on the risk of colon and rectal cancer in women</article-title><source>Eur J Cancer</source><year>1998</year><volume>34</volume><supplement>7</supplement><fpage>1070</fpage><lpage>1076</lpage><!--PubMed citation query: 'Eur J Cancer||34|1070||bib11|'--><pub-id pub-id-type="pmid">9849456</pub-id></citation></ref></ref-list></back></article>