lign="char" valign="top" char="." charoff="50">121</td><td align="char" valign="top" char="." charoff="50">5.51</td><td align="char" valign="top" char="." charoff="50">16292.5</td><td align="char" valign="top" char="." charoff="50">151</td><td align="char" valign="top" char="." charoff="50">9.27</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Unskilled workers</td><td align="char" valign="top" char="." charoff="50">189255.6</td><td align="char" valign="top" char="." charoff="50">894</td><td align="char" valign="top" char="." charoff="50">4.72</td><td align="char" valign="top" char="." charoff="50">163084.6</td><td align="char" valign="top" char="." charoff="50">1269</td><td align="char" valign="top" char="." charoff="50">7.78</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Outside work, unemployed</td><td align="char" valign="top" char="." charoff="50">76164.9</td><td align="char" valign="top" char="." charoff="50">372</td><td align="char" valign="top" char="." charoff="50">4.88</td><td align="char" valign="top" char="." charoff="50">110456.4</td><td align="char" valign="top" char="." charoff="50">869</td><td align="char" valign="top" char="." charoff="50">7.87</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Missing (a)</td><td align="char" valign="top" char="." charoff="50">53301.5</td><td align="char" valign="top" char="." charoff="50">211</td><td align="char" valign="top" char="." charoff="50">3.96</td><td align="char" valign="top" char="." charoff="50">14330.3</td><td align="char" valign="top" char="." charoff="50">82</td><td align="char" valign="top" char="." charoff="50">5.72</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Missing (b)</td><td align="char" valign="top" char="." charoff="50">127443.5</td><td align="char" valign="top" char="." charoff="50">482</td><td align="char" valign="top" char="." charoff="50">3.78</td><td align="char" valign="top" char="." charoff="50">18170.1</td><td align