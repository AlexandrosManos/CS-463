person-group person-group-type="author"><name><surname>Uhrich</surname><given-names>KE</given-names></name><name><surname>Cannizzaro</surname><given-names>SM</given-names></name><name><surname>Langer</surname><given-names>RS</given-names></name><etal/></person-group><article-title>Polymeric systems for controlled drug release</article-title><source>Chem Rev</source><year>1999</year><volume>99</volume><fpage>3181</fpage><lpage>98</lpage></citation></ref><ref id="b25"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Xu</surname><given-names>Y</given-names></name><name><surname>Du</surname><given-names>Y</given-names></name></person-group><article-title>Effect of molecular structure of chitosan on protein delivery properties of chitosan nanoparticles</article-title><source>Int J Pharm</source><year>2003</year><volume>250</volume><fpage>215</fpage><lpage>26</lpage></citation></ref><ref id="b26"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Zhang</surname><given-names>H</given-names></name><name><surname>Oh</surname><given-names>M</given-names></name><name><surname>Allen</surname><given-names>C</given-names></name><etal/></person-group><article-title>Monodisperse chitosan nanoparticles for mucosal drug delivery</article-title><source>Biomacromolecules</source><year>2004</year><volume>5</volume><fpage>2461</fpage><lpage>8</lpage></citation></ref></ref-list></back></article>