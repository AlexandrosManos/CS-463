/given-names></name><name><surname>Bamberg</surname><given-names>M</given-names></name></person-group><article-title>Can the total dose of radiotherapy for testicular intraepithelial neoplasia be safely reduced below 20 Gy </article-title><source>J Canc Res Clin Oncol</source><year>2000</year><volume>126</volume><fpage>R16</fpage>(abs suppl)<!--PubMed citation query: 'J Canc Res Clin Oncol||126|R16||bib7|'--></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coogan</surname><given-names>C</given-names></name><name><surname>Foster</surname><given-names>R</given-names></name><name><surname>Simmons</surname><given-names>G</given-names></name><name><surname>Tognoni</surname><given-names>P</given-names></name><name><surname>Roth</surname><given-names>B</given-names></name><name><surname>Donohue</surname><given-names>J</given-names></name></person-group><article-title>Bilateral germ cell tumors</article-title><source>Cancer</source><year>1998</year><volume>83</volume><fpage>547</fpage><lpage>552</lpage><!--PubMed citation query: 'Cancer||83|547||bib8|'--><pub-id pub-id-type="pmid">9690548</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Daugaard</surname><given-names>G</given-names></name><name><surname>Giwerman</surname><given-names>A</given-names></name><name><surname>Shakkebaek</surname><given-names>NE</given-names></name></person-group><article-title>Should the other testicle be biopsied</article-title><source>Semin Urol Oncol</source><year>1996</year><volume>14</volume><fpage>8</fpage><lpage>12</lpage><!--PubMed citation query: 'Semin Urol Oncol||14|8||bib9|'--><pub-id pub-id-type="pmid">8833382</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dieckmann</surname><given-names>KP</given-names></name><name><surname>Loy</surname><given-names>P</given-names></name></person-group><article-title>Prevalence of contralateral testicular intraepithelial neoplasia in patients with testicular germ cell neoplasms</article-title><source>J Clin Oncol</source><year>1996</year><volume>14</volume><fpage>3126</fpage><lpage>3132</lpage><!--PubMed citation query: 'J Clin Oncol||14|3126||bib10|'--><pub-id pub-id-type="pmid">8955658</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dieckmann</surname><given-names>KP</given-names></name><name><surname>Souchon</surname><given-names>R</given-names></name><name><surname>Loy</surname><given-names>V</given-names></name></person-group><article-title>False negative biopsies for testicular intraepithelial neoplasia</article-title><source>J Urol</source><year>1999</year><volume>162</volume><fpage>364</fpage><lpage>368</lpage><!--PubMed citation query: 'J Urol||162|364||bib11|'--><pub-id pub-id-type="pmid">10411040</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dieckmann</surname><given-names>KP</given-names></name><name><surname>Lauke</surname><given-names>H</given-names></name><name><surname>Michl</surname><given-names>U</given-names></name><name><surname>Winter</surname><given-names>E</given-names></name><name><surname>loy</surname><given-names>V</given-names></name></person-group><article-title>Testicular germ cell cancer despite previous local radiotherapy in the testis</article-title><source>Eur Urol</source><year>2002</year><volume>41</volume><fpage>643</fpage><lpage>649</lpage><!--PubMed citation query: 'Eur Urol||41|643||bib12|'--><pub-id pub-id-type="pmid">12074782</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dieckmann</surname><given-names>KP</given-names></name><name><surname>Loy</surname><given-names>V</given-names></name><