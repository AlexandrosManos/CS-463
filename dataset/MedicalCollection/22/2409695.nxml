ef><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giuliano</surname><given-names>AE</given-names></name><name><surname>Jones</surname><given-names>RC</given-names></name><name><surname>Brennan</surname><given-names>M</given-names></name><name><surname>Statman</surname><given-names>R</given-names></name></person-group><article-title>Sentinel lymphadenectomy in breast cancer</article-title><source>J Clin Oncol</source><year>1997</year><volume>15</volume><fpage>2345</fpage><lpage>2350</lpage><!--PubMed citation query: 'J Clin Oncol||15|2345||bib6|'--><pub-id pub-id-type="pmid">9196149</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giuliano</surname><given-names>AE</given-names></name><name><surname>Kirgan</surname><given-names>DM</given-names></name><name><surname>Guenther</surname><given-names>JM</given-names></name><name><surname>Morton</surname><given-names>DL</given-names></name></person-group><article-title>Lymphatic mapping and sentinel lymphadenectomy for breast cancer</article-title><source>Ann Surg</source><year>1994</year><volume>220</volume><fpage>391</fpage><lpage>401</lpage><!--PubMed citation query: 'Ann Surg||220|391||bib7|'--><pub-id pub-id-type="pmid">8092905</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harris</surname><given-names>JR</given-names></name><name><surname>Osteen</surname><given-names>RT</given-names></name></person-group><article-title>Patients with early breast cancer benefit from effective axillary treatment</article-title><source>Breast Cancer Res Treat</source><year>1985</year><volume>5</volume><fpage>17</fpage><lpage>21</lpage><!--PubMed citation query: 'Breast Cancer Res Treat||5|17||bib8|'--><pub-id pub-id-type="pmid">3978244</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jakub</surname><given-names>JW</given-names></name><name><surname>Diaz</surname><given-names>NM</given-names></name><name><surname>Ebert</surname><given-names>MD</given-names></name><name><surname>Cantor</surname><given-names>A</given-names></name><name><surname>Reintgen</surname><given-names>DS</given-names></name><name><surname>Dupont</surname><given-names>EL</given-names></name><name><surname>Shons</surname><given-names>AR</given-names></name><name><surname>Cox</surname><given-names>CE</given-names></name></person-group><article-title>Completion axillary lymph node dissection minimizes the likelihood of false negatives for patients with invasive breast carcinoma and cytokeratin positive only sentinel lymph nodes</article-title><source>Am J Surg</source><year>2002</year><volume>184</volume><fpage>302</fpage><lpage>306</lpage><!--PubMed citation query: 'Am J Surg||184|302||bib9|'--><pub-id pub-id-type="pmid">12383888</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kjaergaard</surname><given-names>J</given-names></name><name><surname>Blichert-Toft</surname><given-names>M</given-names></name><name><surname>Andersen</surname><given-names>JA</given-names></name><name><surname>Rank</surname><given-names>F</given-names></name><name><surname>Pedersen</surname><given-names>BV</given-names></name></person-group><article-title>Probability of false negative nodal staging in conjunction with partial axillary dissection in breast cancer</article-title><source>Br J Surg</source><year>1985</year><volume>72</volume><fpage>365</fpage><lpage>367</lpage><!--PubMed citation query: 'Br J Surg||72|365||bib10|'--><pub-id pub-id-type="pmid">3995243</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Krag</surname><given-names>DN</given-names></name><name><surname>Weaver</surname><given-names>DL</given-names></name><name><surname>Alex</surname><given-names>JC</given-names></name><name><surname>Fairbank</surname><given-names>JT</given-names></name></person-group><article-title>Surgical resection and radiolocalization of the sentinel lymph node in breast cancer using a gamma probe</article-title><source>Surg Oncol</source><year>1993</year><volume>2</volume><fpage>335</fpage><lpage>339</lpage><!--PubMed citation query: 'Surg Oncol||2|335||bib11|'--><pub-id pub-id-type="pmid">8130940</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Krag</surname><given-names>DN</given-names></name><name><surname>Weaver</surname><given-names>DL</given-names></name><name><surname>Ashikaga</surname><given-names>T</given-names></name><name><surname>Moffat</surname><given-names>F</given-names></name><name><surname>Klimberg</surname><given-names>VS</given-names></name><name><surname>Shriver</surname><given-names>C</given-names></name><name><surname>Feldman</surname><given-names>S</given-names></name><name><surname>Kusminsky</surname><given-names>R</given-names></name><name><surname>Gadd</surname><given-names>M</given-names></name><name><surname>Kuhn</surname><given-names>J</given-names></name><name><surname>Harlow</surname><given-names>S</given-names></name><name><surname>Beitsch</surname><given-names>P</given-names></name></person-group><article-title>The sentinel node in breast cancer &#x02013; a multicenter validation study</article-title><source>N Engl J Med</source><year>1998</year><volume>339</volume><fpage>941</fpage><lpage>946</lpage><!--PubMed citation query: 'N Engl J Med||339|941||bib12|'--><pub-id pub-id-type="pmid">9753708</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kuehn</surname><given-names>T</given-names></name><name><surname>Klauss</surname><given-names>W</given-names></name><name><surname>