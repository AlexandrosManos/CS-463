name><given-names>S</given-names></name><name><surname>Zhang</surname><given-names>L</given-names></name><name><surname>Vogelstein</surname><given-names>B</given-names></name><name><surname>Kinzler</surname><given-names>KW</given-names></name></person-group><article-title>Secreted and cell surface genes expressed in benign and malignant colorectal tumors</article-title><source>Cancer Res</source><year>2001</year><volume>61</volume><fpage>6996</fpage><lpage>7001</lpage><!--PubMed citation query: 'Cancer Res||61|6996||bib4|'--><pub-id pub-id-type="pmid">11585723</pub-id></citation></ref><ref id="bib5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chi</surname><given-names>K</given-names></name><name><surname>Jones</surname><given-names>DV</given-names></name><name><surname>Frazier</surname><given-names>ML</given-names></name></person-group><article-title>Expression of an elongation factor 1 gamma-related sequence in adenocarcinomas of the colon</article-title><source>Gastroenterology</source><year>1992</year><volume>103</volume><fpage>98</fpage><lpage>102</lpage><!--PubMed citation query: 'Gastroenterology||103|98||bib5|'--><pub-id pub-id-type="pmid">1612363</pub-id></citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ender</surname><given-names>B</given-names></name><name><surname>Lynch</surname><given-names>P</given-names></name><name><surname>Kim</surname><given-names>YH</given-names></name><name><surname>Inamdar</surname><given-names>NY</given-names></name><name><surname>Cleary</surname><given-names>KR</given-names></name><name><surname>Frazier</surname><given-names>ML</given-names></name></person-group><article-title>Overexpression of an elongation factor-1 gamma-hybridizing RNA in colorectal adenomas</article-title><source>Mol Carcinogen</source><year>1993</year><volume>7</volume><fpage>18</fpage><lpage>20</lpage><!--PubMed citation query: 'Mol Carcinogen||7|18||bib6|'--></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grant</surname><given-names>AG</given-names></name><name><surname>Flomen</surname><given-names>RM</given-names></name><name><surname>Tizard</surname><given-names>ML</given-names></name><name><surname>Grant</surname><given-names>DA</given-names></name></person-group><article-title>Differential screening of a human pancreatic adenocarcinoma lambda gt11 expression library has identified increased transcription of elongation factor EF-1 alpha in tumour cells</article-title><source>Int J Cancer</source><year>1992</year><volume>50</volume><fpage>740</fpage><lpage>745</lpage><!--PubMed citation query: 'Int J Cancer||50|740||bib7|'--><pub-id pub-id-type="pmid">1544708</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Inoue</surname><given-names>H</given-names></name><name><surname>Mori</surname><given-names>M</given-names></name><name><surname>Honda</surname><given-names>M</given-names></name><name><surname>Li</surname><given-names>J</given-names></name><name><surname>Shibuta</surname><given-names>K</given-names></name><name><surname>Mimori</surname><given-names>K</given-names></name><name><surname>Ueo</surname><given-names>H</given-names></name><name><surname>Akiyoshi</surname><given-names>T</given-names></name></person-group><article-title>The expression of tumor-rejection antigen &#x02018;MAGE&#x02019; genes in human gastric carcinoma</article-title><source>Gastroenterology</source><year>1995</year><volume>109</volume><fpage>1522</fpage><lpage>1525</lpage><!--PubMed citation query: 'Gastroenterology||109|1522||bib8|'--><pub-id pub-id-type="pmid">7557134</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Joseph</surname><given-names>P</given-names></name><name><surname>Lei</surname><given-names>YX</given-names></name><name><surname>Whong</surname><given-names>WZ</given-names></name><name><surname>Ong</surname><given-names>TM</given-names></name></person-group><article-title>Oncogenic potential of mouse translation elongation factor-1 delta, a novel cadmium-responsive proto-oncogene</article-title><source>J Biol Chem</source><year>2002</year><volume>277</volume><fpage>6131</fpage><lpage>6136</lpage><!--PubMed citation query: 'J Biol Chem||277|6131||bib9|'--><pub-id pub-id-type="pmid">11711542</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jung</surname><given-names>M</given-names></name><name><surname>Kondratyev</surname><given-names>AD</given-names></name><name><surname>Dritschilo</surname><given-names>A</given-names></name></person-group><article-title>Elongation factor 1 delta is enhanced following exposure to ionizing radiation</article-title><source>Cancer Res</source><year>1994</year><volume>54</volume><fpage>2541</fpage><lpage>2543</lpage><!--PubMed citation query: 'Cancer Res||54|2541||bib10|'--><pub-id pub-id-type="pmid">8168075</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaplan</surname><given-names>EL</given-names></name><name><surname>Meier</surname><given-names>P</given-names></name></person-group><article-title>Nonparametric estimation from incomplete observations</article-title><source>J Am Stat Assoc</source><year>1958</year><volume>53</volume><fpage>457</fpage><lpage>481</lpage><!--PubMed citation query: 'J Am Stat Assoc||53|457||bib11|'--></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kolettas</surname><given-names>E</given-names></name><name><surname>Lymboura</surname><given-names>M</given-names></name><name><surname>Khazaie</surname><given-names>K</given-names></name><name><s