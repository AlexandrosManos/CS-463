</name><name><surname>Asatryan</surname><given-names>H</given-names></name><name><surname>Yan</surname><given-names>SF</given-names></name><name><surname>Zhou</surname><given-names>Y</given-names></name><name><surname>Gu</surname><given-names>XJ</given-names></name><name><surname>Saadat</surname><given-names>A</given-names></name><name><surname>Zhou</surname><given-names>V</given-names></name><name><surname>King</surname><given-names>FJ</given-names></name><name><surname>Shaw</surname><given-names>CM</given-names></name><name><surname>Su</surname><given-names>AI</given-names></name><name><surname>Downs</surname><given-names>R</given-names></name><name><surname>Gray</surname><given-names>NS</given-names></name><name><surname>Schultz</surname><given-names>PG</given-names></name><name><surname>Warmuth</surname><given-names>M</given-names></name><name><surname>Caldwell</surname><given-names>JS</given-names></name></person-group><article-title>An efficient rapid system for profiling the cellular activities of molecular libraries</article-title><source>Proc Natl Acad Sci USA</source><year>2006</year><volume>103</volume><fpage>3153</fpage><lpage>3158</lpage><pub-id pub-id-type="pmid">16492761</pub-id><pub-id pub-id-type="doi">10.1073/pnas.0511292103</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>O'Brien</surname><given-names>PJ</given-names></name><name><surname>Irwin</surname><given-names>W</given-names></name><name><surname>Diaz</surname><given-names>D</given-names></name><name><surname>Howard-Cofield</surname><given-names>E</given-names></name><name><surname>Krejsa</surname><given-names>CM</given-names></name><name><surname>Slaughter</surname><given-names>MR</given-names></name><name><surname>Gao</surname><given-names>B</given-names></name><name><surname>Kaludercic</surname><given-names>N</given-names></name><name><surname>Angeline</surname><given-names>A</given-names></name><name><surname