-group-type="author"><name><surname>Tepavac</surname><given-names>D</given-names></name><name><surname>Schwirtlich</surname><given-names>L</given-names></name></person-group><article-title>Detection and prediction of FES-induced fatigue</article-title><source>J Electromyogr Kinesiol</source><year>1997</year><volume>7</volume><fpage>39</fpage><lpage>50</lpage><pub-id pub-id-type="doi">10.1016/S1050-6411(96)00008-9</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thomas</surname><given-names>CK</given-names></name></person-group><article-title>Fatigue in human thenar muscles paralyzed by spinal cord injury</article-title><source>J Electromyogr Kinesiol</source><year>1997</year><volume>7</volume><fpage>15</fpage><lpage>26</lpage><pub-id pub-id-type="doi">10.1016/S1050-6411(96)00020-X</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eser</surname><given-names>PC</given-names></name><name><surname>Donaldson</surname><given-names>NdN</given-names></name><name><surname>Knecht</surname><given-names>H</given-names></name><name><surname>St&#x000fc;ssi</surname><given-names>E</given-names></name></person-group><article-title>Influence of different stimulation frequencies on power output and fatigue during FES-cycling in recently injured SCI people</article-title><source>IEEE Trans Neural Sys Rehabil Eng</source><year>2003</year><volume>11</volume><fpage>236</fpage><lpage>240</lpage><pub-id pub-id-type="doi">10.1109/TNSRE.2003.817677</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shields</surname><given-names>RK</given-names></name><name><surname>Chang</surname><given-names>Y-J</given-names></name></person-group><article-title>The effects of fatigue on the torque-frequency curve of the human paralyzed soleus muscle</article-title><source>J Electromyogr Kinesiol</source><year>1997</year><volume>7</volume><fpage>3</fpage><lpage>13</lpage><pub-id pub-id-type="doi">10.1016/S1050-6411(96)00015-6</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giat</surname><given-names>Y</given-names></name><name><surname>Mizrahi</surname><given-names>J</given-names></name><name><surname>Levy</surname><given-names>M</given-names></name></person-group><article-title>A musculotendon model of the fatigue profiles of paralyzed quadriceps muscle under FES</article-title><source>IEEE Trans Biomed Eng</source><year>1993</year><volume>40</volume><fpage>664</fpage><lpage>674</lpage><pub-id pub-id-type="pmid">8244427</pub-id><pub-id pub-id-type="doi">10.1109/10.237696</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Trumbower</surname><given-names>RD</given-names></name><name><surname>Rajasekaran</surname><given-names>S</given-names></name><name><surname>Faghri</surname><given-names>PD</given-names></name></person-group><article-title>Identifying offline muscle strength profiles sufficient for short-duration FES-LCE exercise: a PAC learning model approach</article-title><source>J Clin Monit Comput</source><year>2006</year><volume>20</volume><fpage>209</fpage><lpage>220</lpage><pub-id pub-id-type="pmid">16775658</pub-id><pub-id pub-id-type="doi">10.1007/s10877-006-9023-2</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gf&#x000f6;hler</surname><given-names>M</given-names></name><name><surname>Lugner</surname><given-names>P</given-names></name></person-group><article-title>Cycling by means of functional electrical stimulation</article-title><source>IEEE Trans Rehabil Eng</source><year>2000</year><volume>8</volume><fpage>233</fpage><lpage>243</lpage><pub-id pub-id-type="pmid">10896196</pub-id><pub-i