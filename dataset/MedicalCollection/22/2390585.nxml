e>J Nerv Ment Dis</source><year>2001</year><volume>189</volume><fpage>812</fpage><lpage>821</lpage><pub-id pub-id-type="pmid">11794574</pub-id><pub-id pub-id-type="doi">10.1097/00005053-200112000-00002</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carvalho</surname><given-names>S</given-names></name><name><surname>White</surname><given-names>H</given-names></name></person-group><article-title>Theory-based evaluation: The case of social funds.</article-title><source>Am J Evaluation</source><year>2004</year><volume>25</volume><fpage>141</fpage><lpage>160</lpage></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Green</surname><given-names>LW</given-names></name></person-group><article-title>From research to "best practices" in other settings and populations</article-title><source>Am J Health Behav</source><year>2001</year><volume>25</volume><fpage>165</fpage><lpage>178</lpage><pub-id pub-id-type="pmid">11322614</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berwick</surname><given-names>DM</given-names></name></person-group><article-title>Disseminating innovations in health care</article-title><source>JAMA</source><year>2003</year><volume>289</volume><fpage>1969</fpage><lpage>1975</lpage><pub-id pub-id-type="pmid">12697800</pub-id><pub-id pub-id-type="doi">10.1001/jama.289.15.1969</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Plsek</surname><given-names>PE</given-names></name><name><surname>Wilson</surname><given-names>T</given-names></name></person-group><article-title>Complexity, leadership, and management in healthcare organisations</article-title><source>BMJ</source><year>2001</year><volume>323</volume><fpage>746</fpage><lpage>749</lpage><pub-id pub-id