top" charoff="50">18</td><td align="char" valign="top" char="." charoff="50">16.7</td><td align="char" valign="top" char="." charoff="50">1.08</td><td align="char" valign="top" char="&#x02013;" charoff="50">0.64&#x02013;1.70</td><td align="center" valign="top" charoff="50">10</td><td align="center" valign="top" charoff="50">7.1</td><td align="center" valign="top" charoff="50">1.40</td><td align="center" valign="top" charoff="50">0.67&#x02013;2.57</td></tr><tr><td align="left" valign="top" charoff="50">33&#x02013;34&#x02009;weeks</td><td align="char" valign="top" char="." charoff="50">72</td><td align="char" valign="top" char="." charoff="50">64.4</td><td align="char" valign="top" char="." charoff="50">1.12</td><td align="char" valign="top" char="&#x02013;" charoff="50">0.88&#x02013;1.41</td><td align="center" valign="top" charoff="50">21</td><td align="char" valign="top" char="." charoff="50">22.7</td><td align="char" valign="top" char="." charoff="50">0.92</td><td align="char" valign="top" char="&#x02013;" charoff="50">0.57&#x02013;1.41</td><td align="center" valign="top" charoff="50">9</td><td align="center" valign="top" charoff="50">9.7</td><td align="center" valign="top" charoff="50">0.93</td><td align="center" valign="top" charoff="50">0.43&#x02013;1.77</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="&#x02013;" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="&#x02013;" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50"><italic>Birth weight</italic><sup>c</sup></td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="&#x02013;" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="&#x02013;" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">0.5&#x02013;1.99&#x02009;kg</td><td align="char" valign="top" char="." charoff="50">45</td><td align="char" valign="top" char="." charoff="50">39.9</td><td align="char" valign="top" char="." charoff="50">1.13</td><td align="char" valign="top" char="&#x02013;" charoff="50">0.82&#x02013;1.51</td><td align="center" valign="top" charoff="50">16</td><td align="char" valign="top" char="." charoff="50">14.0</td><td align="char" valign="top" char="." charoff="50">1.14</td><td align="char" valign="top" char="&#x02013;" charoff="50">0.65&#x02013;1.85</td><td align="center" valign="top" charoff="50">9</td><td align="center" valign="top" charoff="50">5.9</td><td align="center" valign="top" charoff="50">1.53</td><td align="center" valign="top" charoff="50">0.70&#x02013;2.91</td></tr><tr><td align="left" valign="top" charoff="50">2&#x02013;2.99&#x02009;kg</td><td align="char" valign="top" char="." charoff="50">63</td><td align="char" valign="top" char="." charoff="50">