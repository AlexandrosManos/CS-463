e><given-names>N</given-names></name></person-group><year>1999</year><article-title>Cohesins bind to preferential sites along yeast chromosome III, with differential regulation along arms versus the centric region.</article-title><source>Cell</source><volume>98</volume><fpage>249</fpage><lpage>259</lpage><pub-id pub-id-type="pmid">10428036</pub-id></citation></ref><ref id="pone.0002453-Laloraya1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Laloraya</surname><given-names>S</given-names></name><name><surname>Guacci</surname><given-names>V</given-names></name><name><surname>Koshland</surname><given-names>D</given-names></name></person-group><year>2000</year><article-title>Chromosomal addresses of the cohesin component Mcd1p.</article-title><source>J Cell Biol</source><volume>151</volume><fpage>1047</fpage><lpage>1056</lpage><pub-id pub-id-type="pmid">11086006</pub-id></citation></ref><ref id="pone.0002453-Milutinovich1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Milutinovich</surname><given-names>M</given-names></name><name><surname>Unal</surname><given-names>E</given-names></name><name><surname>Ward</surname><given-names>C</given-names></name><name><surname>Skibbens</surname><given-names>RV</given-names></name><name><surname>Koshland</surname><given-names>D</given-names></name></person-group><year>2007</year><article-title>A multi-step pathway for the establishment of sister chromatid cohesion.</article-title><source>PLoS Genet</source><volume>3</volume><fpage>e12</fpage><pub-id pub-id-type="pmid">17238288</pub-id></citation></ref><ref id="pone.0002453-Kimura1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kimura</surname><given-names>K</given-names></name><name><surname>Hirano</surname><given-names>T</given-names></name></person-group><year>1997</year><article-title>ATP-dependent po