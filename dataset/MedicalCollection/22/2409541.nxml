ern Med||96|102||bib9|'--><pub-id pub-id-type="pmid">7053682</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gisvold</surname><given-names>JJ</given-names></name><name><surname>Goellner</surname><given-names>JR</given-names></name><name><surname>Grant</surname><given-names>CS</given-names></name><name><surname>Donohue</surname><given-names>JH</given-names></name><name><surname>Sykes</surname><given-names>MW</given-names></name><name><surname>Karsell</surname><given-names>PR</given-names></name><name><surname>Coffey</surname><given-names>SL</given-names></name><name><surname>Jung</surname><given-names>SH</given-names></name></person-group><article-title>Breast biopsy: a comparative study of stereotaxically guided core and excisional techniques</article-title><source>Am J Roentgenol</source><year>1994</year><volume>162</volume><fpage>815</fpage><lpage>820</lpage><!--PubMed citation query: 'Am J Roentgenol||162|815||bib10|'--><pub-id pub-id-type="pmid">8140997</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hrung</surname><given-names>JM</given-names></name><name><surname>Langlotz</surname><given-names>CP</given-names></name><name><surname>Orel</surname><given-names>SG</given-names></name><name><surname>Fox</surname><given-names>KR</given-names></name><name><surname>Schnall</surname><given-names>MD</given-names></name><name><surname>Schwartz</surname><given-names>JS</given-names></name></person-group><article-title>Cost-effectiveness of MR imaging and core-needle biopsy in the preoperative work-up of suspicious breast lesions</article-title><source>Radiology</source><year>1999</year><volume>213</volume><fpage>39</fpage><lpage>49</lpage><!--PubMed citation query: 'Radiology||213|39||bib11|'--><pub-id pub-id-type="pmid">10540638</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><pers