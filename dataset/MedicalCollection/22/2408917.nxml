<surname>Isaacs</surname><given-names>R</given-names></name><name><surname>Fry</surname><given-names>AJ</given-names></name><name><surname>McDonald</surname><given-names>IC</given-names></name></person-group><article-title>A new method for monitoring deep body temperature from the skin surface</article-title><source>Clin Sci</source><year>1973</year><volume>44</volume><fpage>81</fpage><lpage>86</lpage><!--PubMed citation query: 'Clin Sci||44|81||bib5|'--><pub-id pub-id-type="pmid">4684307</pub-id></citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gautherie</surname><given-names>M</given-names></name><name><surname>Gross</surname><given-names>CM</given-names></name></person-group><article-title>Breast Thermography and cancer risk prediction</article-title><source>Cancer</source><year>1980</year><volume>45</volume><fpage>51</fpage><lpage>56</lpage><!--PubMed citation query: 'Cancer||45|51||bib6|'--><pub-id pub-id-type="pmid">7351006</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gullino</surname><given-names>PM</given-names></name></person-group><article-title>Natural history of breast cancer</article-title><source>Cancer</source><year>1977</year><volume>39</volume><fpage>2697</fpage><lpage>2703</lpage><!--PubMed citation query: 'Cancer||39|2697||bib7|'--><pub-id pub-id-type="pmid">326375</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hanihan</surname><given-names>D</given-names></name><name><surname>Folkman</surname><given-names>J</given-names></name></person-group><article-title>Patterns and emerging mechanisms of the angiogenic switch during tumorigenesis</article-title><source>Cell</source><year>1996</year><volume>86</volume><fpage>801</fpage><lpage>810</lpage><!--PubMed citation query: 'Cell||86|801||bib8|'--></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jensen</surname><given-names>HM</given-names></name><name><surname>Chen</surname><given-names>I</given-names></name><name><surname>DeVault</surname><given-names>MR</given-names></name><name><surname>Lewis</surname><given-names>AE</given-names></name></person-group><article-title>Angiogenesis induced by &#x02018;normal&#x02019; human breast tissue: A probable marker for pre-cancer</article-title><source>Science</source><year>1982</year><volume>218</volume><fpage>293</fpage><lpage>295</lpage><!--PubMed citation query: 'Science||218|293||bib9|'--><pub-id pub-id-type="pmid">6181563</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaufman</surname><given-names>Z</given-names></name><name><surname>Garstin</surname><given-names>WI</given-names></name><name><surname>Hayes</surname><given-names>R</given-names></name><name><surname>Michell</surname><given-names>MJ</given-names></name><name><surname>Baum</surname><given-names>M</given-names></name></person-group><article-title>The mammographic parenchymal patterns of nulliparous women and women with a family history of breast cancer</article-title><source>J Clin Radiol</source><year>1991</year><volume>43</volume><fpage>385</fpage><lpage>388</lpage><!--PubMed citation query: 'J Clin Radiol||43|385||bib10|'--></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lambe</surname><given-names>M</given-names></name><name><surname>Shieh</surname><given-names>CC</given-names></name><name><surname>Chan</surname><given-names>HW</given-names></name><name><surname>Ekbom</surname><given-names>A</given-names></name><name><surname>Trichopoulos</surname><given-names>D</given-names></name><name><surname>Adami</surname><given-names>HO</given-names></name></person-group><article-title>Parity, age at first and last birth, and risk of breast cancer; a population based study in Sweden</article-title><source>Breast Cancer Res Treat</source><year>1996</year><volume>38</volume><fpage>305</fpage><lpage>311</lpage><!--PubMed citation query: 'Breast Cancer Res Treat||38|305||bib11|'--><pub-id pub-id-type="pmid">8739084</pub-id></citation></ref><ref id="bib12"><citation citation-type="book"><person-group person-group-type="author"><collab>National Statistics</collab></person-group><article-title/><source>England and Wales births and deaths in 2000</source><year>2001</year><publisher-name>National Statistics, 1 Devonwood Gate, London SW1V 2QQ: HMSO</publisher-name><fpage>3</fpage></citation></ref><ref id="bib13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Presser</surname><given-names>HB</given-names></name></person-group><article-title>Temporal data relating to the human menstrual cycle</article-title><source>Biorhythms and human reproduction Ch. 10</source><year>1974</year><publisher-name>New York: Wiley</publisher-name><fpage>158</fpage>Ferin M, Halberg F, Richart RM, Vande Wiele RL (eds)p</citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Read</surname><given-names>GF</given-names></name><name><surname>Bradley</surname><given-names>JA</given-names></name><name><surname>Wilson</surname><given-names>DW</given-names></name><name><surname>George</surname><given-names>WD</given-names></name><name><surname>Griffiths</surname><given-names>K</given-names></name></person-group><article-title>Evaluation of luteal phase salivary progesterone levels in women with benign breast disease</article-title><source>Eur J Cancer Clin Oncol</source><year>1985</year><volume>21</volume><fpage>9</fpage><lpage>17</lpage><!--PubMed citation query: 'Eur J Cancer Clin Oncol||21|9||bib14|'--><pub-id pub-id-type="pmid">4038658</pub-id></citation></ref><ref id="bib15"><citation citatio