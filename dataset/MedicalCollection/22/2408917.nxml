on></ref><ref id="bib21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simpson</surname><given-names>HW</given-names></name><name><surname>McArdle</surname><given-names>CS</given-names></name><name><surname>Pauson</surname><given-names>AW</given-names></name><name><surname>Hume</surname><given-names>P</given-names></name><name><surname>Turkes</surname><given-names>A</given-names></name><name><surname>Griffiths</surname><given-names>K</given-names></name></person-group><article-title>A non-invasive test for the pre-cancerous breast</article-title><source>Eur J Cancer 31A</source><year>1995</year><volume>11</volume><fpage>1768</fpage><lpage>1772</lpage><!--PubMed citation query: 'Eur J Cancer 31A||11|1768||bib21|'--></citation></ref><ref id="bib22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simpson</surname><given-names>HW</given-names></name></person-group><article-title>Sir James Young Simpson Memorial Lecture 1995: Breast cancer prevention, a pathologist's approach</article-title><source>J R Coll Surg Edinb</source><year>1996</year><volume>41</volume><fpage>359</fpage><lpage>370</lpage><!--PubMed citation query: 'J R Coll Surg Edinb||41|359||bib22|'--><pub-id pub-id-type="pmid">8997020</pub-id></citation></ref><ref id="bib23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simpson</surname><given-names>HW</given-names></name><name><surname>Cornelissen</surname><given-names>G</given-names></name><name><surname>Katinas</surname><given-names>G</given-names></name><name><surname>Halberg</surname><given-names>F</given-names></name></person-group><article-title>Meta-analysis of sequential luteal-cycle-associated changes in human breast tissue</article-title><source>Breast Cancer Res Treat</source><year>2000</year><volume>63</volume><fpage>171</fpage><lpage>173</lpage><!--PubMed citation query: 'Breast Cancer Res Treat||63|171||bib23|'--><pub-id pub-id-type="pmid">11097093</pub-id></citation></ref><ref id="bib24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>DW</given-names></name><name><surname>Fentiman</surname><given-names>IS</given-names></name></person-group><article-title>Epidemiology and endocrinology of benign breast disease</article-title><source>Breast Cancer Res Treat</source><year>1985</year><volume>6</volume><fpage>5</fpage><lpage>36</lpage><!--PubMed citation query: 'Breast Cancer Res Treat||6|5||bib24|'--><pub-id pub-id-type="pmid">3902125</pub-id></citation></ref><ref id="bib25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wiseman</surname><given-names>RA</given-names></name></person-group><article-title>Breast cancer hypothesis: A single cause for the majority of cases</article-title><source>J Epidemiol Community Health</source><year>2000</year><volume>54</volume><fpage>851</fpage><lpage>858</lpage><!--PubMed citation query: 'J Epidemiol Community Health||54|851||bib25|'--><pub-id pub-id-type="pmid">11027200</pub-id></citation></ref></ref-list></back></article>