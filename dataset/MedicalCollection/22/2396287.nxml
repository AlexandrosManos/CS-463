="pmid">15330700</pub-id></citation></ref><ref id="pone.0002311-VanEe1"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Van Ee</surname><given-names>R</given-names></name><name><surname>van Dam</surname><given-names>LCJ</given-names></name><name><surname>Brouwer</surname><given-names>GJ</given-names></name></person-group><year>2005</year><article-title>Voluntary control and the dynamics of perceptual bistability.</article-title><source>Vision Res</source><volume>45</volume><fpage>41</fpage><lpage>55</lpage><pub-id pub-id-type="pmid">15571737</pub-id></citation></ref><ref id="pone.0002311-Blake2"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blake</surname><given-names>R</given-names></name></person-group><year>1989</year><article-title>A neural theory of binocular rivalry.</article-title><source>Psychol Rev</source><volume>96</volume><fpage>145</fpage><lpage>167</lpage><pub-id pub-id-type="pmid">2648445</pub-id></citation></ref><ref id="pone.0002311-Blake3"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blake</surname><given-names>R</given-names></name><name><surname>O'Shea</surname><given-names>RP</given-names></name><name><surname>Mueller</surname><given-names>TJ</given-names></name></person-group><year>1992</year><article-title>Spatial zones of binocular rivalry in central and peripheral vision.</article-title><source>Vis Neurosci</source><volume>8</volume><fpage>469</fpage><lpage>478</lpage><pub-id pub-id-type="pmid">1586647</pub-id></citation></ref><ref id="pone.0002311-OShea1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>O'Shea</surname><given-names>RP</given-names></name><name><surname>Sims</surname><given-names>AJH</given-names></name><name><surname>Govan</surname><given-names>DG</given-names></name></person-group><year>1997