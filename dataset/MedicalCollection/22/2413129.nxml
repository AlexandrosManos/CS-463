ation citation-type="display-unstructured">Furusawa C, Kaneko K (2008) A generic mechanism for adaptive growth regulation. PLoS Comput Biol 4:e3 <pub-id pub-id-type="pmid">18193939</pub-id></citation></ref><ref id="CR11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Furusawa</surname><given-names>C</given-names></name><etal/></person-group><article-title>Ubiquity of log-normal distributions in intra-cellular reaction dynamics</article-title><source>Biophysics</source><year>2005</year><volume>1</volume><fpage>25</fpage><lpage>31</lpage><pub-id pub-id-type="doi">10.2142/biophysics.1.25</pub-id></citation><citation citation-type="display-unstructured">Furusawa C et al (2005) Ubiquity of log-normal distributions in intra-cellular reaction dynamics. Biophysics 1:25&#x02013;31 </citation></ref><ref id="CR10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ghaemmaghami</surname><given-names>S</given-names></name><etal/></person-group><article-title>Global analysis of protein expression in yeast</article-title><source>Nature</source><year>2003</year><volume>425</volume><fpage>737</fpage><lpage>741</lpage><pub-id pub-id-type="doi">10.1038/nature02046</pub-id></citation><citation citation-type="display-unstructured">Ghaemmaghami S et al (2003) Global analysis of protein expression in yeast. Nature 425:737&#x02013;741 <pub-id pub-id-type="pmid">14562106</pub-id></citation></ref><ref id="CR12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jeong</surname><given-names>H</given-names></name><name><surname>Tombor</surname><given-names>B</given-names></name><name><surname>Albert</surname><given-names>R</given-names></name><name><surname>Oltvai</surname><given-names>ZN</given-names></name><name><surname>Barab&#x000e1;si</surname><given-names>A-L</given-names></name></person-group><article-title>The large-scale organization of metabolic networks</article-title><source>Nature</source><year>2003</year><volume>407</volume><fpage>651</fpage></citation><citation citation-type="display-unstructured">Jeong H, Tombor B, Albert R, Oltvai ZN, Barab&#x000e1;si A-L (2003) The large-scale organization of metabolic networks. Nature 407:651 <pub-id pub-id-type="pmid">11034217</pub-id></citation></ref><ref id="CR2"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kaneko</surname><given-names>K</given-names></name></person-group><source>Life: an introduction to complex systems biology</source><year>2006</year><publisher-loc>Heidelberg</publisher-loc><publisher-name>Springer</publisher-name></citation><citation citation-type="display-unstructured">Kaneko K (2006) Life: an introduction to complex systems biology. Springer, Heidelberg </citation></ref><ref id="CR22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaneko</surname><given-names>K</given-names></name></person-group><article-title>Evolution of robustness to noise and mutation in gene expression dynamics</article-title><source>PLoS One</source><year>2007</year><volume>2</volume><fpage>e434</fpage><pub-id pub-id-type="doi">10.1371/journal.pone.0000434</pub-id></citation><citation citation-type="display-unstructured">Kaneko K (2007) Evolution of robustness to noise and mutation in gene expression dynamics. PLoS One 2:e434 <pub-id pub-id-type="pmid">17502916</pub-id></citation></ref><ref id="CR19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaneko</surname><given-names>K</given-names></name><name><surname>Furusawa</surname><given-names>C</given-names></name></person-group><article-title>An evolutionary relationship between genetic variation and phenotypic fluctuation</article-title><source>J Theo Biol</source><year>2006</year><volume>240</volume><fpage>78</fpage><lpage>86</lpage><pub-id pub-id-type="doi">10.1016/j.jtbi.2005.08.029</pub-id></citation><citation citation-type="display-unstructured">Kaneko K, Furusawa C (2006) An evolutionary relationship between genetic variation and phenotypic fluctuation. J Theor Biol 240:78&#x02013;86 </citation></ref><ref id="CR1"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kaneko</surname><given-names>K</given-names></name><name><surname>Tsuda</surname><given-names>I</given-names></name></person-group><source>Complex systems: chaos and beyond</source><year>2000</year><publisher-loc>Heidelberg</publisher-loc><publisher-name>Springer</publisher-name></citation><citation citation-type="display-unstructured">Kaneko K, Tsuda I (2000) Complex systems: chaos and beyond. Springer, Heidelberg </citation></ref><ref id="CR25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kashiwagi</surname><given-names>A</given-names></name><name><surname>Urabe</surname><given-names>I</given-names></name><name><surname>Kaneko</surname><given-names>K</given-names></name><name><surname>Yomo</surname><given-names>T</given-names></name></person-group><article-title>Adaptive response of a gene network to environmental changes by attractor selection</article-title><source>PLoS One</source><year>2006</year><volume>1</volume><fpage>e49</fpage><pub-id pub-id-type="doi">10.1371/journal.pone.0000049</pub-id></citation><citation citation-type="display-unstructured">Kashiwagi A, Urabe I, Kaneko K, Yomo T (2006) Adaptive response of a gene network to environmental changes by attractor selection. PLoS One 1:e49 <pub-id pub-id-type="pmid">17183678</pub-id></citation></ref><ref id="CR5"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kirschner</surname><given-names>MW</given-names></name><name><surname>Gerhart</surname><given-names>JC</given-names></name></person-group><source>The plausibility of life</source><year>2005</year><publisher-loc>New Haven</publisher-loc><publisher-name>Yale University Press