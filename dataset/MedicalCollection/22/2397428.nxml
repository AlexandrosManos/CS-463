-id-type="pmid">561853</pub-id></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Fritz</surname><given-names>PA</given-names></name><name><surname>Percy</surname><given-names>C</given-names></name><name><surname>Jack</surname><given-names>A</given-names></name><name><surname>Shanmugaratnuers</surname><given-names>K</given-names></name><name><surname>Solin</surname><given-names>L</given-names></name><name><surname>Parkin</surname><given-names>DM</given-names></name></person-group><source>International classification of diseases for oncology</source><year>2000</year><edition>3</edition><publisher-name>Geneva: World Health Organization</publisher-name></citation></ref><ref id="B18"><citation citation-type="book"><source>Reconstruction and estimation of Golestan province population according to 2000 geographic boundaries</source><year>2003</year><publisher-name>Tehran: Statistical Center of Iran</publisher-name></citation></ref><ref id="B19"><citation citation-type="book"><source>Reconstruction and estimation of Mazandaran province population according to 2000 geographic boundaries</source><year>2003</year><publisher-name>Tehran: Statistical Center of Iran</publisher-name></citation></ref><ref id="B20"><citation citation-type="book"><source>Annual Report of Babol Health Research Station: 2003</source><year>2004</year><publisher-name>Tehran: Tehran Medical University</publisher-name></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Esteve</surname><given-names>J</given-names></name><name><surname>Benhamou</surname><given-names>E</given-names></name><name><surname>Raymond</surname><given-names>L</given-names></name></person-group><source>Statistical Methods in Cancer Research Volume IV: Descriptive Epidemiology</source><year>1994</year><volume>Chapter 2</volume><publisher-name>Lyon: IARC Scientific Publication</publisher-name></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Segi</surname><given-names>M</given-names></name></person-group><source>Cancer mortality for selected sites in 24 countries (1950&#x02013;1957)</source><year>1960</year><publisher-name>Sendai, Department of Public Health, Tohoku University of Medicine</publisher-name></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Waterhouse</surname><given-names>J</given-names></name><name><surname>Muir</surname><given-names>C</given-names></name><name><surname>Sharmugaratnam</surname><given-names>K</given-names></name><name><surname>Powell</surname><given-names>J</given-names></name></person-group><source>Cancer incidence in five continents IV</source><year>1982</year><volume>42</volume><publisher-name>Lyon, IARC Scientific Publications</publisher-name></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Ahmad</surname><given-names>O</given-names></name><name><surname>Boschi-Pinto</surname><given-names>C</given-names></name><name><surname>Lopez</surname><given-names>A</given-names></name><name><surname>Murray</surname><given-names>C</given-names></name><name><surname>Lozano</surname><given-names>R</given-names></name><name><surname>Inoue</surname><given-names>M</given-names></name></person-group><source>Age standardization of rates: a new WHO standard</source><year>2000</year><publisher-name>GPE Discussion Paper Series: no31 World Health Organization</publisher-name></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moran</surname><given-names>PAP</given-names></name></person-group><article-title>Notes on continuous stochastic phenomena</article-title><source>Biometrika</source><year>1950</year><volume>37</volume><fpage>17</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">15