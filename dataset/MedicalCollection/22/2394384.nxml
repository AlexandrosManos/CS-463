haroff="50">0.1, 1.7</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;IV</td><td align="center" valign="top" charoff="50">34</td><td align="center" valign="top" charoff="50">128</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">1.1</td><td align="center" valign="top" charoff="50">0.1, 8.1</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50"><italic>Histology</italic></td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Ductal</td><td align="center" valign="top" charoff="50">922</td><td align="center" valign="top" charoff="50">8370</td><td align="center" valign="top" charoff="50">59</td><td align="center" valign="top" charoff="50">1.0</td><td align="center" valign="top" charoff="50">Ref.</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Medullary</td><td align="center" valign="top" charoff="50">44</td><td align="center" valign="top" charoff="50">395</td><td align="center" valign="top" charoff="50">2</td><td align="center" valign="top" charoff="50">0.9</td><td align="center" valign="top" charoff="50">0.2, 3.6</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Lobular</td><td align="center" valign="top" charoff="50">52</td><td align="center" valign="top" charoff="50">492</td><td align="center" valign="top" charoff="50">3</td><td align="center" valign="top" charoff="50">0.7</td><td align="center" valign="top" charoff="50">0.2, 2.3</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Other</td><td align="center" valign="top" charoff="50">265</td><td align="center" valign="top" charoff="50">2248</td><td align="center" valign="top" charoff="50">13</td><td align="center" valign="top" charoff="50">0.9</td><td align="center" valign="top" charoff="50">0.5, 1.6</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50"><italic>Size (cm)</italic></td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x02a7d;2.0</td><td align="center" valign="top" charoff="50">653</td><td align="center" valign="top" charoff="50">6167</td><td align="center" valign="top" charoff="50">39</td><td align="center" valign="top" charoff="50">1.0</td><td align="center" valign="top" charoff="50">Ref.</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x0003e;2.0&#x02013;5.0</td><td align="center" valign="top" charoff="50">498</td><td align="center" valign="top" charoff="50">4271</td><td align="center" valign="top" charoff="50">34</td><td align="center" valign="top" charoff="50">1.2</td><td align="center" valign="top" charoff="50">0.7, 1.9</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x0003e;5.0</td><td align="center" valign="top" charoff="50">102</td><td align="center" valign="top" charoff="50">803</td><td align="center" valign="top" charoff="50">4</td><td align="center" valign="top" charoff="50">0.7</td><td align="center" valign="top" charoff="50">0.3, 2.1</td></tr></tbody></table><table-wrap-foot><fn id="tbfnote2"><label/><p>HRs adjusted for age and year at diagnosis, AJCC stage, chemotherapy, and the study subjects participated in. P-years&#x0003d;patient-years; HR&#x0003d;hazard ratio; AJCC&#x0003d;American Joint Committee on cancer; Ref.&#x0003d;reference.</p></fn></table-wrap-foot></table-wrap>). With respect to the tumour markers expressed by these first tumours, women whose first tumour was c-erbB-2 positive had a 1.7-fold (95&#x00025; CI: 1.0&#x02013;3.0) increased risk of CBC (<xref rid="tbl4" ref-type="table">Table 4</xref><table-wrap id="tbl4" position="float"><label>Table 4</label><caption><p content-type="table-title">Risk of CBC by tumour markers expressed by the first breast cancer</p></caption><table frame="hsides" rules="groups" border="1" width="85%"><colgroup><col align="left"/><col align="center"/><col align="center"/><col align="center"/><col align="center"/><col align="center"/></colgroup><thead valign="bottom"><tr><th align="left" valign="top" charoff="50">&#x000a0;</th><th colspan="2" align="center" valign="top" charoff="50"><bold>Number of</bold><hr/></th><th colspan="3" align="center" valign="top" charoff="50">&#x000a0;</th></tr><tr><th align="left" valign="top" charoff="50">&#x000a0;</th><th align="center" valign="top" charoff="50"><bold>Subjects at risk</bold></th><th align="center" valign="top" charoff="50"><bold>P-years</bold></th><th colspan="3" align="center" valign="top" charoff="50"><bold>Number of CBC cases</bold></th></tr><tr><th align="left" valign="top" charoff="50"><bold>Tumour marker</bold></th><th align="center" valign="top" charoff="50"><bold><italic>n</italic>&#x0003d;907</bold></th><th align="center" valign="top" charoff="50"><bold>at