given-names>C</given-names></name><name><surname>Rose</surname><given-names>G</given-names></name><name><surname>Tayal</surname><given-names>V</given-names></name><name><surname>Sullivan</surname><given-names>D</given-names></name><name><surname>Arrowood</surname><given-names>J</given-names></name><name><surname>Kline</surname><given-names>J</given-names></name></person-group><article-title>Determination of left ventricular function by emergency physician echocardiography of hypotensive patients</article-title><source>Acad Emerg Med</source><year>2002</year><volume>9</volume><issue>3</issue><fpage>186</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">11874773</pub-id></element-citation></ref><ref id="R11"><label>11</label><element-citation publication-type="journal" publisher-type="journal"><person-group person-group-type="author"><name><surname>Randazzo</surname><given-names>M</given-names></name><name><surname>Snoey</surname><given-names>E</given-names></name><name><surname>Levitt</surname><given-names>M</given-names></name><name><surname>Binder</surname><given-names>K</given-names></name></person-group><article-title>Accuracy of emergency physician assessment of left ventricular ejection fraction and central venous pressure using echocardiography</article-title><source>Acad Emerg Med</source><year>2003</year><volume>10</volume><issue>9</issue><fpage>973</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">12957982</pub-id></element-citation></ref><ref id="R12"><label>12</label><element-citation publication-type="journal" publisher-type="journal"><person-group person-group-type="author"><name><surname>Gunst</surname></name><name><surname>Ghaemmaghami</surname></name><name><surname>Sperry</surname></name><etal/></person-group><article-title>Accuracy of cardiac function and volume status estimates using the bedside echocardiographic assessment in trauma/critical care</article-title><source>J Trauma</source><year>2008</year><volume>65</volume><issue>3</issue><fpage>509