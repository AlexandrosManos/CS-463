-formula></td><td align="left"><inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M66" name="1744-8069-4-13-i7" overflow="scroll"><mml:semantics><mml:mrow><mml:mover accent="true"><mml:mi>B</mml:mi><mml:mo>&#x000af;</mml:mo></mml:mover><mml:mover accent="true"><mml:mi>B</mml:mi><mml:mo>&#x000af;</mml:mo></mml:mover></mml:mrow></mml:semantics></mml:math></inline-formula></td><td align="left"><inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M67" name="1744-8069-4-13-i7" overflow="scroll"><mml:semantics><mml:mrow><mml:mover accent="true"><mml:mi>B</mml:mi><mml:mo>&#x000af;</mml:mo></mml:mover><mml:mover accent="true"><mml:mi>B</mml:mi><mml:mo>&#x000af;</mml:mo></mml:mover></mml:mrow></mml:semantics></mml:math></inline-formula></td><td align="left"><italic>BB</italic></td><td align="left"><inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M68" name="1744-8069-4-13-i7" overflow="scroll"><mml:semantics><mml:mrow><mml:mover accent="true"><mml:mi>B</mml:mi><mml:mo>&#x000af;</mml:mo></mml:mover><mml:mover accent="true"><mml:mi>B</mml:mi><mml:mo>&#x000af;</mml:mo></mml:mover></mml:mrow></mml:semantics></mml:math></inline-formula></td></tr><tr><td align="left">00/10</td><td align="left">[01] [00]</td><td align="left"><inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M69" name="1744-8069-4-13-i27" overflow="scroll"><mml:semantics><mml:mrow><mml:mn>2</mml:mn><mml:msub><mml:mi>p</mml:mi><mml:mrow><mml:msub><mml:mtext>M</mml:mtext><mml:mrow><mml:mn>01</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:msub><mml:msub><mml:mi>p</mml:mi><mml:mrow><mml:msub><mml:mtext>M</mml:mtext><mml:mrow><mml:mn>00</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:msub></mml:mrow></mml:semantics></mml:math></inline-formula></td><td align="left"><inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M70" name="1744-8069-4-13-i28" overflow="scroll"><mml:semantics><mml:mrow><mml:mn