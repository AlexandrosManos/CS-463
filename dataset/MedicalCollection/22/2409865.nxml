b-id-type="pmid">2234049</pub-id></citation></ref><ref id="bib18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Iwasaki</surname><given-names>T</given-names></name><name><surname>Nishizawa</surname><given-names>K</given-names></name><name><surname>Murata</surname><given-names>M</given-names></name></person-group><article-title>Leukaemia and lymphoma mortality in the vicinity of nuclear power stations in Japan, 1973&#x02013;1987</article-title><source>J Radiol Prot</source><year>1995</year><volume>15</volume><fpage>271</fpage><lpage>288</lpage><!--PubMed citation query: 'J Radiol Prot||15|271||bib18|'--></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jablon</surname><given-names>S</given-names></name><name><surname>Hrubec</surname><given-names>Z</given-names></name><name><surname>Boice</surname><given-names>JD</given-names><suffix>Jr</suffix></name></person-group><article-title>Cancer in populations living near nuclear facilities. A survey of mortality nationwide and incidence in two states</article-title><source>JAMA</source><year>1991</year><volume>265</volume><fpage>1403</fpage><lpage>1408</lpage><!--PubMed citation query: 'JAMA||265|1403||bib19|'--><pub-id pub-id-type="pmid">1999880</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaatsch</surname><given-names>P</given-names></name><name><surname>Kaletsch</surname><given-names>U</given-names></name><name><surname>Meinert</surname><given-names>R</given-names></name><name><surname>Michaelis</surname><given-names>J</given-names></name></person-group><article-title>An extended study on childhood malignancies in the vicinity of German nuclear power plants</article-title><source>Cancer Causes Control</source><year>1998</year><volume>9</volume><fpage>529</fpage><lpage>533</lpage><!--PubMed citation query: 'Cancer Causes Co