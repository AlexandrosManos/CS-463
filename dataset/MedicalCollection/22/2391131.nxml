query: 'Respir Res||7|132||bib15|'--><pub-id pub-id-type="pmid">17062156</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leffingwell</surname><given-names>CM</given-names></name><name><surname>Low</surname><given-names>RB</given-names></name></person-group><article-title>Cigarette smoke components and alveolar macrophage protein synthesis</article-title><source>Arch Environ Health</source><year>1979</year><volume>34</volume><fpage>97</fpage><lpage>102</lpage><!--PubMed citation query: 'Arch Environ Health||34|97||bib16|'--><pub-id pub-id-type="pmid">434939</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lensch</surname><given-names>MW</given-names></name><name><surname>Rathbun</surname><given-names>RK</given-names></name><name><surname>Olson</surname><given-names>SB</given-names></name><name><surname>Jones</surname><given-names>GR</given-names></name><name><surname>Bagby</surname><given-names>GC</given-names><suffix>Jr</suffix></name></person-group><article-title>Selective pressure as an essential force in molecular evolution of myeloid leukemic clones: a view from the window of Fanconi anemia</article-title><source>Leukemia</source><year>1999</year><volume>13</volume><fpage>1784</fpage><lpage>1789</lpage><!--PubMed citation query: 'Leukemia||13|1784||bib17|'--><pub-id pub-id-type="pmid">10557053</pub-id></citation></ref><ref id="bib18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Levitus</surname><given-names>M</given-names></name><name><surname>Waisfisz</surname><given-names>Q</given-names></name><name><surname>Godthelp</surname><given-names>BC</given-names></name><name><surname>de Vries</surname><given-names>Y</given-names></name><name><surname>Hussain</surname><given-names>S</given-names></name><name><surname>Wiegant</surname><given-names>WW</given-names>