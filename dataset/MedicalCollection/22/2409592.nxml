><article-title>Neuro-endocrine cells &#x02013; a new prognostic parameter in prostate cancer</article-title><source>Br J Urol</source><year>1991</year><volume>68</volume><fpage>258</fpage><lpage>262</lpage><!--PubMed citation query: 'Br J Urol||68|258||bib5|'--><pub-id pub-id-type="pmid">1913066</pub-id></citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Copin</surname><given-names>MC</given-names></name><name><surname>Buisine</surname><given-names>MP</given-names></name><name><surname>Devisme</surname><given-names>L</given-names></name><name><surname>Leroy</surname><given-names>X</given-names></name><name><surname>Escande</surname><given-names>F</given-names></name><name><surname>Gosselin</surname><given-names>B</given-names></name><name><surname>Aubert</surname><given-names>JP</given-names></name><name><surname>Porchet</surname><given-names>N</given-names></name></person-group><article-title>Normal respiratory mucosa, precursor lesions and lung carcinomas: differential expression of human mucin genes</article-title><source>Front Biosci</source><year>2001</year><volume>6</volume><fpage>D1264</fpage><lpage>D1275</lpage><!--PubMed citation query: 'Front Biosci||6|D1264||bib6|'--><pub-id pub-id-type="pmid">11578957</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Culig</surname><given-names>Z</given-names></name><name><surname>Hobisch</surname><given-names>A</given-names></name><name><surname>Cronauer</surname><given-names>MV</given-names></name><name><surname>Radmayr</surname><given-names>C</given-names></name><name><surname>Trapman</surname><given-names>J</given-names></name><name><surname>Hittmair</surname><given-names>A</given-names></name><name><surname>Bartsch</surname><given-names>G</given-names></name><name><surname>Klocker</surname><given-names>H</given-names></name></person-group><article-title>Androgen recep