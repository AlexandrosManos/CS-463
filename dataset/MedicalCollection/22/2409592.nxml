tion query: 'Nat Rev Cancer||1|34||bib12|'--><pub-id pub-id-type="pmid">11900250</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gendler</surname><given-names>SJ</given-names></name><name><surname>Spicer</surname><given-names>AP</given-names></name></person-group><article-title>Epithelial mucin genes</article-title><source>Annu Rev Physiol</source><year>1995</year><volume>57</volume><fpage>607</fpage><lpage>634</lpage><!--PubMed citation query: 'Annu Rev Physiol||57|607||bib13|'--><pub-id pub-id-type="pmid">7778880</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hanski</surname><given-names>C</given-names></name><name><surname>Hofmeier</surname><given-names>M</given-names></name><name><surname>Schmitt-Graff</surname><given-names>A</given-names></name><name><surname>Riede</surname><given-names>E</given-names></name><name><surname>Hanski</surname><given-names>ML</given-names></name><name><surname>Borchard</surname><given-names>F</given-names></name><name><surname>Sieber</surname><given-names>E</given-names></name><name><surname>Niedobitek</surname><given-names>F</given-names></name><name><surname>Foss</surname><given-names>HD</given-names></name><name><surname>Stein</surname><given-names>H</given-names></name><name><surname>Riecken</surname><given-names>EO</given-names></name></person-group><article-title>Overexpression or ectopic expression of MUC2 is the common property of mucinous carcinomas of the colon, pancreas, breast, and ovary</article-title><source>J Pathol</source><year>1997</year><volume>182</volume><fpage>385</fpage><lpage>391</lpage><!--PubMed citation query: 'J Pathol||182|385||bib14|'--><pub-id pub-id-type="pmid">9306958</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ho</surname><given-names>SB</given-names