tation query: 'J Virol||77|11588||bib14|'--><pub-id pub-id-type="pmid">14557644</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haupt</surname><given-names>Y</given-names></name><name><surname>Maya</surname><given-names>R</given-names></name><name><surname>Kazaz</surname><given-names>A</given-names></name><name><surname>Oren</surname><given-names>M</given-names></name></person-group><article-title>mdm2 promotes the rapid degradation of p53</article-title><source>Nature</source><year>1997a</year><volume>387</volume><fpage>296</fpage><lpage>299</lpage><!--PubMed citation query: 'Nature||387|296||bib15|'--><pub-id pub-id-type="pmid">9153395</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haupt</surname><given-names>Y</given-names></name><name><surname>Rowan</surname><given-names>S</given-names></name><name><surname>Shaulian</surname><given-names>E</given-names></name><name><surname>Kazaz</surname><given-names>A</given-names></name><name><surname>Vousden</surname><given-names>K</given-names></name><name><surname>Oren</surname><given-names>M</given-names></name></person-group><article-title>p53 mediated apoptosis in HeLa cells: transcription dependent and independent mechanisms</article-title><source>Leukemia</source><year>1997b</year><volume>13</volume><fpage>337</fpage><lpage>339</lpage><!--PubMed citation query: 'Leukemia||13|337||bib16|'--></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hermeking</surname><given-names>H</given-names></name><name><surname>Eick</surname><given-names>D</given-names></name></person-group><article-title>Mediation of c-Myc-induced apoptosis by p53</article-title><source>Science</source><year>1994</year><volume>265</volume><fpage>2091</fpage><lpage>2093</lpage><!--PubMed citation query: 'Science||265|2091||bib17|'--><pub-id pub-id-type="pmid">8091232</pub-id></citation></ref><ref id="bib18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Higashimoto</surname><given-names>Y</given-names></name><name><surname>Saito</surname><given-names>S</given-names></name><name><surname>Tong</surname><given-names>XH</given-names></name><name><surname>Hong</surname><given-names>A</given-names></name><name><surname>Sakaguchi</surname><given-names>K</given-names></name><name><surname>Appella</surname><given-names>E</given-names></name><name><surname>Anderson</surname><given-names>C</given-names></name></person-group><article-title>Human p53 is phosphorylated on serines 6 and 9 in response to DNA damage-inducing agents</article-title><source>J Biol Chem</source><year>2000</year><volume>275</volume><fpage>23199</fpage><lpage>23203</lpage><!--PubMed citation query: 'J Biol Chem||275|23199||bib18|'--><pub-id pub-id-type="pmid">10930428</pub-id></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hiyama</surname><given-names>H</given-names></name><name><surname>Reeves</surname><given-names>S</given-names></name></person-group><article-title>Role for cyclin D1 in UVC-induced and p53-mediated apoptosis</article-title><source>Cell Death Differ</source><year>1999</year><volume>6</volume><fpage>565</fpage><lpage>569</lpage><!--PubMed citation query: 'Cell Death Differ||6|565||bib19|'--><pub-id pub-id-type="pmid">10381651</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hoffman</surname><given-names>J</given-names></name><name><surname>Schmidt-Peter</surname><given-names>P</given-names></name><name><surname>Hansch</surname><given-names>W</given-names></name><name><surname>Naundorf</surname><given-names>H</given-names></name><name><surname>Bunge</surname><given-names>A</given-names></name><name><surname>B