><issue>9</issue><fpage>S295</fpage><lpage>S300</lpage><pub-id pub-id-type="pmid">17207841</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nagayama</surname><given-names>J</given-names></name><name><surname>Tsuji</surname><given-names>H</given-names></name><name><surname>Iida</surname><given-names>T</given-names></name><etal/></person-group><article-title>Immunologic effects of perinatal exposure to dioxins, PCBs and organochlorine pesticides in Japanese infants</article-title><source><italic>Chemosphere</italic></source><year>2007</year><volume>67</volume><issue>9</issue><fpage>S393</fpage><lpage>S398</lpage><pub-id pub-id-type="pmid">17222440</pub-id></citation></ref><ref id="B14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>European Parliament and Council of the European Union</surname></name></person-group><article-title>Directive 2002/95/EC of 27 January 2003 on the restriction of the use of certain hazardous substances in electrical and electronic equipment</article-title><source><italic>Official Journal of the European Union</italic></source><year>2003</year><volume>46</volume><issue>L037</issue><fpage>19</fpage><lpage>23</lpage></citation></ref><ref id="B15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>European Parliament and Council of the European Union</surname></name></person-group><article-title>Directive 2002/96/EC of 27 January 2003 on waste electrical and electronic equipment (WEEE)</article-title><source><italic>Official Journal of the European Union</italic></source><year>2003</year><volume>46</volume><issue>L037</issue><fpage>24</fpage><lpage>39</lpage></citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bi</surname><given-names>X</given-names></