roup-type="editor"><name><surname>Comper WD</surname></name></person-group><article-title>The lung</article-title><source>Extracellular Matrix, Tissue Function</source><year>1996</year><volume>1</volume><publisher-name>The Netherlands, Harwood Academic Publishers GmbH</publisher-name><fpage>378</fpage><lpage>409</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hinek</surname><given-names>A</given-names></name><name><surname>Pshezhetsky</surname><given-names>AV</given-names></name><name><surname>Itzstein</surname><given-names>MV</given-names></name><name><surname>Starcher</surname><given-names>B</given-names></name></person-group><article-title>Lysosomal sialidase (neuraminidase 1) is targeted to cell surface in the multiprotein complex that facilitates elastic fiber assembly</article-title><source>J Biol Chem</source><year>2006</year><volume>281</volume><fpage>3698</fpage><lpage>3710</lpage><pub-id pub-id-type="pmid">16314420</pub-id><pub-id pub-id-type="doi">10.1074/jbc.M508736200</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hinek</surname><given-names>A</given-names></name><name><surname>Mecham</surname><given-names>RP</given-names></name><name><surname>Keeley</surname><given-names>F</given-names></name><name><surname>Rabinovitch</surname><given-names>M</given-names></name></person-group><article-title>Impaired elastin fiber assembly related to reduced 67-kD elastin-binding protein in fetal lamb ductus arteriosus and in cultured aortic smooth muscle cells treated with chondroitin sulfate</article-title><source>J Clin Invest</source><year>1991</year><volume>88</volume><fpage>2083</fpage><lpage>2094</lpage><pub-id pub-id-type="pmid">1661296</pub-id><pub-id pub-id-type="doi">10.1172/JCI115538</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><n