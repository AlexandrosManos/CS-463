-id-type="pmid">16843726</pub-id><pub-id pub-id-type="doi">10.1016/j.pt.2006.07.003</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Torgerson</surname><given-names>PR</given-names></name><name><surname>Budke</surname><given-names>CM</given-names></name></person-group><article-title>Echinococcosis &#x02013; an international public health challenge</article-title><source>Res Vet Sci</source><year>2003</year><volume>74</volume><fpage>191</fpage><lpage>202</lpage><pub-id pub-id-type="pmid">12726737</pub-id><pub-id pub-id-type="doi">10.1016/S0034-5288(03)00006-7</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garippa</surname><given-names>G</given-names></name></person-group><article-title>Updates on cystic echinococcosis (CE) in Italy</article-title><source>Parassitologia</source><year>2006</year><volume>48</volume><fpage>57</fpage><lpage>59</lpage><pub-id pub-id-type="pmid">16881397</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brglez</surname><given-names>J</given-names></name></person-group><article-title>Echinococcosis in Slovenia</article-title><source>Zdrav Vestn</source><year>1970</year><volume>39</volume><fpage>265</fpage><lpage>267</lpage></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Romig</surname><given-names>T</given-names></name></person-group><article-title>Epidemiology of echinococcosis</article-title><source>Lagenbecks Arch Surg</source><year>2003</year><volume>388</volume><fpage>209</fpage><lpage>217</lpage><pub-id pub-id-type="doi">10.1007/s00423-003-0413-3</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Romig</surname><given-names>T</given-names></name><name><surname>Dinkel</surname><given-names>A</given-names></name><name><surname>Mackenstedt</surname><given-names>U</given-names></name></person-group><article-title>The present situation of echinococcosis in Europe</article-title><source>Parasitol Int</source><year>2006</year><volume>55</volume><fpage>187</fpage><lpage>191</lpage><pub-id pub-id-type="pmid">16793328</pub-id><pub-id pub-id-type="doi">10.1016/j.parint.2005.11.028</pub-id></citation></ref></ref-list></back></article>