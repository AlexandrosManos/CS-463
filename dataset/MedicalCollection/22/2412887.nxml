l"><person-group person-group-type="author"><name><surname>Lu</surname><given-names>CY</given-names></name><name><surname>Ritchie</surname><given-names>J</given-names></name><name><surname>Williams</surname><given-names>K</given-names></name><name><surname>Day</surname><given-names>R</given-names></name></person-group><article-title>The views of stakeholders on controlled access schemes for high-cost antirheumatic biological medicines in Australia</article-title><source>Aus NZ Health Policy</source><year>2007</year><volume>4</volume><fpage>26</fpage><pub-id pub-id-type="doi">10.1186/1743-8462-4-26</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Daniels</surname><given-names>N</given-names></name></person-group><article-title>Toward ethical review of health system transformations</article-title><source>Am J Public Health</source><year>2006</year><volume>96</volume><fpage>447</fpage><lpage>451</lpage><pub-id pub-id-type="pmid">16449582</pub-id><pub-id pub-id-type="doi">10.2105/AJPH.2005.065706</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lu</surname><given-names>CY</given-names></name><name><surname>Williams</surname><given-names>KM</given-names></name><name><surname>Day</surname><given-names>RO</given-names></name></person-group><article-title>Access to tumour necrosis factor inhibitors for rheumatoid arthritis treatment under the Australian Pharmaceutical Benefits Scheme: Are we on target?</article-title><source>Intern Med J</source><year>2006</year><volume>36</volume><fpage>19</fpage><lpage>27</lpage><pub-id pub-id-type="pmid">16409309</pub-id><pub-id pub-id-type="doi">10.1111/j.1445-5994.2005.00992.x</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lu</surname><given-names>CY</given-names></name><name><surname>Williams</sur