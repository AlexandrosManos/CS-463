00638.x</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jordan</surname><given-names>BK</given-names></name><name><surname>Marmar</surname><given-names>CR</given-names></name><name><surname>Fairbank</surname><given-names>JA</given-names></name><name><surname>Schlenger</surname><given-names>WE</given-names></name><name><surname>Kulka</surname><given-names>RA</given-names></name><name><surname>Hough</surname><given-names>RL</given-names></name><name><surname>Weiss</surname><given-names>DS</given-names></name></person-group><article-title>Problems in families of male Vietnam veterans with posttraumatic stress disorder</article-title><source>J Clin Consult Psychol</source><year>1992</year><volume>60</volume><fpage>916</fpage><lpage>926</lpage><pub-id pub-id-type="doi">10.1037/0022-006X.60.6.916</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>MacDonald</surname><given-names>C</given-names></name><name><surname>Chamberlain</surname><given-names>K</given-names></name><name><surname>Long</surname><given-names>N</given-names></name><name><surname>Flett</surname><given-names>R</given-names></name></person-group><article-title>Posttraumatic stress disorder and interpersonal functioning in Vietnam War veterans: a mediational model</article-title><source>J Trauma Stress</source><year>1999</year><volume>12</volume><fpage>701</fpage><lpage>717</lpage><pub-id pub-id-type="pmid">10646188</pub-id><pub-id pub-id-type="doi">10.1023/A:1024729520686</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Glenn</surname><given-names>DM</given-names></name><name><surname>Beckham</surname><given-names>JC</given-names></name><name><surname>Feldman</surname><given-names>ME</given-names></name><name><surname>Kirby</surname><given-names>AC</given-names></name><name><