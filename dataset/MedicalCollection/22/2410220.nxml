/person-group><article-title>Telomerase activity significantly correlates with chromosome alterations, cell differentiation, and proliferation in lung adenocarcinoma</article-title><source>Mod Pathol</source><year>2000</year><volume>13</volume><fpage>723</fpage><lpage>729</lpage><!--PubMed citation query: 'Mod Pathol||13|723||bib12|'--><pub-id pub-id-type="pmid">10912930</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gomez-Roman</surname><given-names>JJ</given-names></name><name><surname>Fontalba Romero</surname><given-names>A</given-names></name><name><surname>Sanchez Castro</surname><given-names>L</given-names></name><name><surname>Hernandez Nieto</surname><given-names>E</given-names></name><name><surname>Fernandez-Luna</surname><given-names>JL</given-names></name><name><surname>Val- Bernal</surname><given-names>JF</given-names></name></person-group><article-title>Telomerase activity in pulmonary neuroendocrine tumours</article-title><source>Am J Surg Pathol</source><year>2000</year><volume>24</volume><fpage>417</fpage><lpage>421</lpage><!--PubMed citation query: 'Am J Surg Pathol||24|417||bib13|'--><pub-id pub-id-type="pmid">10716156</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hara</surname><given-names>H</given-names></name><name><surname>Yamashita</surname></name><name><surname>Shinada</surname><given-names>J</given-names></name><name><surname>Yoshimura</surname><given-names>H</given-names></name><name><surname>Kameya</surname><given-names>T</given-names></name></person-group><article-title>Clinicopathologic significance of telomerase activity and hTERT mRNA expression in non small cell lung cancer</article-title><source>Lung Cancer</source><year>2001</year><volume>34</volume><fpage>219</fpage><lpage>226</lpage><!--PubMed citation query: 'Lung Cancer||34|219||bib14|'--><pub-id pub-id-type="pmi