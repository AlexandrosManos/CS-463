td align="char" char="plusmn" rowspan="1" colspan="1">557.6*&#x000b1;11.6</td><td align="char" char="plusmn" rowspan="1" colspan="1"><bold>532.9</bold>&#x000b1;<bold>24.4</bold></td><td align="char" char="plusmn" rowspan="1" colspan="1"><bold>1098.4*</bold>&#x000b1;<bold>24.6</bold></td></tr><tr><td rowspan="1" colspan="1">Alanine</td><td align="char" char="plusmn" rowspan="1" colspan="1">60.3&#x000b1;1.1</td><td align="char" char="plusmn" rowspan="1" colspan="1">60.2&#x000b1;0.6</td><td align="char" char="plusmn" rowspan="1" colspan="1">70.5&#x000b1;4.2</td><td align="char" char="plusmn" rowspan="1" colspan="1">74.5&#x000b1;2.1</td></tr><tr><td rowspan="1" colspan="1">Aspartic acid</td><td align="char" char="plusmn" rowspan="1" colspan="1">746.9&#x000b1;17.6</td><td align="center" rowspan="1" colspan="1">nd</td><td align="center" rowspan="1" colspan="1">nd</td><td align="center" rowspan="1" colspan="1">nd</td></tr><tr><td rowspan="1" colspan="1">Glutamic acid</td><td align="char" char="plusmn" rowspan="1" colspan="1">271.9&#x000b1;5.1</td><td align="char" char="plusmn" rowspan="1" colspan="1">339.3&#x000b1;38.8</td><td align="char" char="plusmn" rowspan="1" colspan="1"><bold>402.1</bold>&#x000b1;<bold>4.4</bold></td><td align="center" rowspan="1" colspan="1">nd</td></tr><tr><td rowspan="1" colspan="1">Glycine</td><td align="char" char="plusmn" rowspan="1" colspan="1">393.4&#x000b1;4.4</td><td align="char" char="plusmn" rowspan="1" colspan="1">464.8&#x000b1;13.0</td><td align="char" char="plusmn" rowspan="1" colspan="1"><bold>96.9</bold>&#x000b1;<bold>0.1</bold></td><td align="char" char="plusmn" rowspan="1" colspan="1"><bold>89.9</bold>&#x000b1;<bold>0.5</bold></td></tr><tr><td rowspan="1" colspan="1">Proline</td><td align="center" rowspan="1" colspan="1">nd</td><td align="char" char="plusmn" rowspan="1" colspan="1">295.1*&#x000b1;7.8</td><td align="center" rowspan="1" colspan="1">nd</td><td align="char" char="plusmn" rowspan="1" colspan="1"><bold>613.9*</bold>&#x0