rname>Camplejohn</surname><given-names>R</given-names></name><name><surname>Ball</surname><given-names>J</given-names></name><name><surname>Barwell</surname><given-names>J</given-names></name><name><surname>Gilchrist</surname><given-names>R</given-names></name><name><surname>Pangon</surname><given-names>L</given-names></name><name><surname>Berg</surname><given-names>J</given-names></name><name><surname>Hodgson</surname><given-names>S</given-names></name></person-group><article-title>Is chromosome radiosensitivity and apoptotic response to irradiation correlated with cancer susceptibility</article-title><source>Int J Radiat Biol</source><year>2007</year><volume>83</volume><fpage>1</fpage><lpage>12</lpage><!--PubMed citation query: 'Int J Radiat Biol||83|1||bib13|'--><pub-id pub-id-type="pmid">17357435</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Foulkes</surname><given-names>WD</given-names></name><name><surname>Brunet</surname><given-names>JS</given-names></name><name><surname>Kowalski</surname><given-names>LP</given-names></name><name><surname>Narod</surname><given-names>SA</given-names></name><name><surname>Franco</surname><given-names>EL</given-names></name></person-group><article-title>Family history of cancer is a risk factor for squamous cell carcinoma of the head and neck in Brazil: a case&#x02013;control study</article-title><source>Int J Cancer</source><year>1995</year><volume>63</volume><fpage>769</fpage><lpage>773</lpage><!--PubMed citation query: 'Int J Cancer||63|769||bib14|'--><pub-id pub-id-type="pmid">8847131</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Foulkes</surname><given-names>WD</given-names></name><name><surname>Brunet</surname><given-names>JS</given-names></name><name><surname>Sieh</surname><given-names>W</given-names></name><name><surname>Black</surname><given-names>MJ</g