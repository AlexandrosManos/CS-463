e-title>The role of single-and double-strand breaks in cell killing by ionizing radiation</article-title><source>Radiat Res</source><year>1998</year><volume>150</volume><supplement>Suppl</supplement><fpage>S42</fpage><lpage>S51</lpage><!--PubMed citation query: 'Radiat Res||150|S42||bib12|'--><pub-id pub-id-type="pmid">9806608</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Powell</surname><given-names>SN</given-names></name><name><surname>McMillan</surname><given-names>TJ</given-names></name></person-group><article-title>The repair fidelity of restriction enzyme induced double strand breaks in plasmid DNA correlates with radioresistance in human tumour cell lines</article-title><source>Int J Radiat Biol</source><year>1994</year><volume>29</volume><fpage>1035</fpage><lpage>1040</lpage><!--PubMed citation query: 'Int J Radiat Biol||29|1035||bib13|'--></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Prise</surname><given-names>KM</given-names></name><name><surname>Davies</surname><given-names>S</given-names></name><name><surname>Michael</surname><given-names>BD</given-names></name></person-group><article-title>Cell killing and DNA damage in Chinese Hamster V79 cells treated with hydrogen peroxide</article-title><source>Int J Radiat Biol</source><year>1989</year><volume>55</volume><fpage>583</fpage><lpage>592</lpage><!--PubMed citation query: 'Int J Radiat Biol||55|583||bib14|'--><pub-id pub-id-type="pmid">2564868</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Prise</surname><given-names>KM</given-names></name><name><surname>Davies</surname><given-names>S</given-names></name><name><surname>Michael</surname><given-names>BD</given-names></name></person-group><article-title>The relationship between radiation induced DNA-double strand breaks and cell kill in hamster V79 fibroblasts irradiated with 250kVp X-rays, 2.3Mev neutrons or <italic>&#x003b1;</italic> particles</article-title><source>Int J Radiat Biol</source><year>1987</year><volume>52</volume><fpage>893</fpage><lpage>902</lpage><!--PubMed citation query: 'Int J Radiat Biol||52|893||bib20|'--></citation></ref><ref id="bib21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Radford</surname><given-names>IR</given-names></name></person-group><article-title>The level of induced DNA-double strand breakage correlates with cell killing after X-irradiation</article-title><source>Int J Radiat Biol</source><year>1985</year><volume>48</volume><fpage>45</fpage><lpage>54</lpage><!--PubMed citation query: 'Int J Radiat Biol||48|45||bib21|'--></citation></ref><ref id="bib22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Radford</surname><given-names>IR</given-names></name></person-group><article-title>Effect of radiomodifying agents on the ratios of X-ray induced lesions in cellular DNA: use in lethal lesion determination</article-title><source>Int J Radiat Biol</source><year>1986</year><volume>49</volume><fpage>621</fpage><lpage>637</lpage><!--PubMed citation query: 'Int J Radiat Biol||49|621||bib22|'--></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roos</surname><given-names>WP</given-names></name><name><surname>Binder</surname><given-names>A</given-names></name><name><surname>Bohm</surname><given-names>L</given-names></name></person-group><article-title>Determination of initial DNA damage and residual DNA damage remaining after 12&#x02009;h of repair in eleven cell lines at low doses of irradiation</article-title><source>Int J Radiat Biol</source><year>2000</year><volume>76</volume><fpage>1493</fpage><lpage>1500</lpage><!--PubMed citation query: 'Int J Radiat Biol||76|1493||bib15|'--><pub-id pub-id-type="pmid">11098852</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ruiz de Almodovar</surname><given-names>JM</given-names></name><name><surname>Nunez</surname><given-names>MI</given-names></name><name><surname>McMillan</surname><given-names>TJ</given-names></name><name><surname>Olea</surname><given-names>N</given-names></name><name><surname>Mort</surname><given-names>C</given-names></name><name><surname>Villabos</surname><given-names>M</given-names></name><name><surname>Pedraza</surname><given-names>V</given-names></name><name><surname>Steel</surname><given-names>GG</given-names></name></person-group><article-title>Initial radiation induced DNA damage in human tumour cell lines: a correlation with intrinsic cellular radiosensitivity</article-title><source>Br J Cancer</source><year>1994</year><volume>69</volume><fpage>457</fpage><lpage>462</lpage><!--PubMed citation query: 'Br J Cancer||69|457||bib16|'--><pub-id pub-id-type="pmid">8123473</pub-id></citation></ref><ref id="bib23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Serafin</surname><given-names>AM</given-names></name><name><surname>Akudugu</surname><given-names>JM</given-names></name><name><surname>Bohm</surname><given-names>L</given-names></name></person-group><article-title>Studies on the influence of DNA repair on radiosensitivity in prostate cell lines</article-title><source>Urol Res</source><year>2003</year><volume>31</volume><fpage>227</fpage><lpage>231</lpage><!--PubMed citation query: 'Urol Res||31|227||bib23|'--><pub-id pub-id-type="pmid">12669154</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Steel</surname><given-names>GG</given-names></name><name><surname>Peacock</surname><given-names>JH</given-names></name></person-group><article-title>Why are some tumours more radiosensitive than others</article-title><source>Radiother Oncol</source><year>1989</year><volume>15</volume><fpage>63</fpage><lpage>72</lpage><!--PubMed citation query: 'Radiother Oncol||15|63||bib17|'--><pub-id pub-id-type="pmid">2748944</pub-id></citation></ref><ref id="bib18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ward</surname><given-names>JF</given-names></name></person-group><article-title>DNA damage produced by ionising irradiation in mammalian cells: identities, mechanisms of formation and repair ability</article-title><source>Progr Nucl Acids Molec Biol</source><year>1988</year><volume>35</volume><fpage>95</fpage><lpage>125</lpage><!--PubMed citation query: 'Progr Nucl Acids Molec Biol||35|95||bib18|'--></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Whitaker</surname><given-names>SJ</given-names></name><name><surname>Ung</surname><given-names>YC</given-names></name><name><surname>McMillan</surname><given-names>TJ</given-names></name></person-group><article-title>DNA-double strand break induction and rejoining as determinants of human tumour cell radiosensitivity. A pulsed field gel electrophoresis study</article-title><source>Int J Radiat Biol</source><year>1995</year><volume>67</volume><fpage>7</fpage><lpage>18</lpage><!--PubMed citation query: 'Int J Radiat Biol||67|7||bib19|'--><pub-id pub-id-type="pmid">7852819</pub-id></citation></ref></ref-list></back></article>