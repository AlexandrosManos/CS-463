source>World Health Report 2001. Mental health: New Understanding, New Hope</source><year>2001</year><publisher-name>Geneva: World Health Organization</publisher-name></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moncada</surname><given-names>S</given-names></name></person-group><article-title>Working conditions and social inequalities in health</article-title><source>J Epidemiol Community Health</source><year>1999</year><volume>53</volume><fpage>390</fpage><lpage>391</lpage><pub-id pub-id-type="pmid">10492729</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shields</surname><given-names>M</given-names></name></person-group><article-title>Long working hours and health</article-title><source>Health Rep</source><year>1999</year><volume>11</volume><comment>33&#x02013;48(Eng); 37&#x02013;55(Fre)</comment><pub-id pub-id-type="pmid">10618741</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ylipaavalniemi</surname><given-names>J</given-names></name><name><surname>Kivimaki</surname><given-names>M</given-names></name><name><surname>Elovainio</surname><given-names>M</given-names></name><name><surname>Virtanen</surname><given-names>M</given-names></name><name><surname>Keltikangas-Jarvinen</surname><given-names>L</given-names></name><name><surname>Vahtera</surname><given-names>J</given-names></name></person-group><article-title>Psychosocial work characteristics and incidence of newly diagnosed depression: a prospective cohort study of three different models</article-title><source>Social Science &#x00026; Medicine</source><year>2005</year><volume>61</volume><fpage>111</fpage><lpage>122</lpage><pub-id pub-id-type="pmid">15847966</pub-id><pub-id pub-id-type="doi">10.1016/j.socscimed.2004.11.038</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Radi</surname><given-names>S</given-names></name><name><surname>Ostry</surname><given-names>A</given-names></name><name><surname>LaMontagne</surname><given-names>AD</given-names></name></person-group><article-title>Job stress and other working conditions: Relationships with smoking behaviors in a representative sample of working Australians</article-title><source>Am J Ind Med</source><year>2007</year><volume>50</volume><fpage>584</fpage><lpage>596</lpage><pub-id pub-id-type="pmid">17620320</pub-id><pub-id pub-id-type="doi">10.1002/ajim.20492</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pikhart</surname><given-names>H</given-names></name><name><surname>Bobak</surname><given-names>M</given-names></name><name><surname>Pajak</surname><given-names>A</given-names></name><name><surname>Malyutina</surname><given-names>S</given-names></name><name><surname>Kubinova</surname><given-names>R</given-names></name><name><surname>Topor</surname><given-names>R</given-names></name><name><surname>Sebakova</surname><given-names>H</given-names></name><name><surname>Nikitin</surname><given-names>Y</given-names></name><name><surname>Marmot</surname><given-names>M</given-names></name></person-group><article-title>Psychosocial factors at work and depression in three countries of Central and Eastern Europe</article-title><source>Social Science &#x00026; Medicine</source><year>2004</year><volume>58</volume><fpage>1475</fpage><lpage>1482</lpage><pub-id pub-id-type="pmid">14759691</pub-id><pub-id pub-id-type="doi">10.1016/S0277-9536(03)00350-2</pub-id></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><collab>Australian Bureau of Statistics</collab></person-group><source>Mental Health and Wellbeing Profile of Adults: Victoria</source><year>1998</year><publisher-name>Canberra: Australian Bur