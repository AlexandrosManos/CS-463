SA</source><year>1998</year><volume>95</volume><fpage>14863</fpage><lpage>14868</lpage><!--PubMed citation query: 'Proc Natl Acad Sci USA||95|14863||bib12|'--></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Galmarini</surname><given-names>CM</given-names></name><name><surname>Thomas</surname><given-names>X</given-names></name><name><surname>Calvo</surname><given-names>F</given-names></name><name><surname>Rousselot</surname><given-names>P</given-names></name><name><surname>Rabilloud</surname><given-names>M</given-names></name><name><surname>Jeffari</surname><given-names>AE</given-names></name><name><surname>Cros</surname><given-names>E</given-names></name><name><surname>Dumontet</surname><given-names>C</given-names></name></person-group><article-title><italic>In vivo</italic> mechanisms of resistance to cytarabine in acute myeloid leukemia</article-title><source>Br J Haematol</source><year>2002</year><volume>117</volume><fpage>860</fpage><lpage>868</lpage><!--PubMed citation query: 'Br J Haematol||117|860||bib13|'--><pub-id pub-id-type="pmid">12060121</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gasparini</surname><given-names>G</given-names></name><name><surname>Barbareschi</surname><given-names>M</given-names></name><name><surname>Doglioni</surname><given-names>C</given-names></name><name><surname>Palma</surname><given-names>PD</given-names></name><name><surname>Mauri</surname><given-names>FA</given-names></name><name><surname>Boracchi</surname><given-names>P</given-names></name><name><surname>Bevilacqua</surname><given-names>P</given-names></name><name><surname>Caffo</surname><given-names>O</given-names></name><name><surname>Morelli</surname><given-names>L</given-names></name><name><surname>Verderio</surname><given-names>P</given-names></name><name><surname>Pezzella</surname><given-names>F</given-names></n