ltrasound in Medicine and Biology</italic></source><year>1999</year><volume>25</volume><issue>4</issue><fpage>495</fpage><lpage>502</lpage><pub-id pub-id-type="other">2-s2.0-0032962812</pub-id><pub-id pub-id-type="pmid">10386723</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lyon</surname><given-names>CJ</given-names></name><name><surname>Law</surname><given-names>RE</given-names></name><name><surname>Hsueh</surname><given-names>WA</given-names></name></person-group><article-title>Minireview: adiposity, inflammation, and atherogenesis</article-title><source><italic>Endocrinology</italic></source><year>2003</year><volume>144</volume><issue>6</issue><fpage>2195</fpage><lpage>2200</lpage><pub-id pub-id-type="other">2-s2.0-0038577223</pub-id><pub-id pub-id-type="pmid">12746274</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Tabas</surname><given-names>I</given-names></name><name><surname>Tall</surname><given-names>A</given-names></name><name><surname>Accili</surname><given-names>D</given-names></name></person-group><article-title>The impact of macrophage insulin resistance on advanced atherosclerotic plaque progression</article-title><source><italic>Circulation Research</italic></source><year>2010</year><volume>106</volume><issue>1</issue><fpage>58</fpage><lpage>67</lpage><pub-id pub-id-type="other">2-s2.0-74049093243</pub-id><pub-id pub-id-type="pmid">20056946</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lehto</surname><given-names>S</given-names></name><name><surname>Niskanen</surname><given-names>L</given-names></name><name><surname>Suhonen</surname><given-names>M</given-names></name><name><surname>R&#x000f6;nnemaa</surnam