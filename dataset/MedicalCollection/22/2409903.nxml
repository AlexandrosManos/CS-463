><given-names>R</given-names></name><name><surname>Nyberg</surname><given-names>F</given-names></name><name><surname>Pershagen</surname><given-names>G</given-names></name><name><surname>Jarup</surname><given-names>L</given-names></name><name><surname>Scheele</surname><given-names>P</given-names></name></person-group><article-title>Occupational exposure and lung cancer risk: a population-based case-referent study in Sweden</article-title><source>Am J Epidemiol</source><year>2000</year><volume>152</volume><fpage>32</fpage><lpage>40</lpage><!--PubMed citation query: 'Am J Epidemiol||152|32||bib11|'--><pub-id pub-id-type="pmid">10901327</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Janssen-Heijnen</surname><given-names>ML</given-names></name><name><surname>Gatta</surname><given-names>G</given-names></name><name><surname>Forman</surname><given-names>D</given-names></name><name><surname>Capocaccia</surname><given-names>R</given-names></name><name><surname>Coebergh</surname><given-names>JW</given-names></name></person-group><article-title>Variation in survival of patients with lung cancer in Europe, 1985&#x02013;1989</article-title><source>Eur J Cancer</source><year>1998</year><volume>34</volume><fpage>2191</fpage><lpage>2196</lpage><!--PubMed citation query: 'Eur J Cancer||34|2191||bib12|'--></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jemal</surname><given-names>A</given-names></name><name><surname>Travis</surname><given-names>WD</given-names></name><name><surname>Tarone</surname><given-names>RE</given-names></name><name><surname>Travis</surname><given-names>L</given-names></name><name><surname>Devesa</surname><given-names>SS</given-names></name></person-group><article-title>Lung cancer rates convergence in young men and women in the United States: analysis by birth cohort and histologic type</article-title><source>Int J Cancer</source><year>2003</year><volume>105</volume><fpage>101</fpage><lpage>107</lpage><!--PubMed citation query: 'Int J Cancer||105|101||bib13|'--><pub-id pub-id-type="pmid">12672038</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>J&#x000f6;ckel</surname><given-names>KH</given-names></name><name><surname>Ahrens</surname><given-names>W</given-names></name><name><surname>Jahn</surname><given-names>I</given-names></name><name><surname>Pohlabeln</surname><given-names>H</given-names></name><name><surname>Bolm-Audorff</surname><given-names>U</given-names></name></person-group><article-title>Occupational risk factors for lung cancer: a case&#x02013;control study in West Germany</article-title><source>Int J Epidemiol</source><year>1998</year><volume>27</volume><fpage>549</fpage><lpage>560</lpage><!--PubMed citation query: 'Int J Epidemiol||27|549||bib14|'--><pub-id pub-id-type="pmid">9758106</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kreienbrock</surname><given-names>L</given-names></name><name><surname>Kreuzer</surname><given-names>M</given-names></name><name><surname>Gerken</surname><given-names>M</given-names></name><name><surname>Dingerkus</surname><given-names>G</given-names></name><name><surname>Wellmann</surname><given-names>J</given-names></name><name><surname>Keller</surname><given-names>G</given-names></name><name><surname>Wichmann</surname><given-names>HE</given-names></name></person-group><article-title>Case&#x02013;control study on lung cancer and residential radon in western Germany</article-title><source>Am J Epidemiol</source><year>2001</year><volume>153</volume><fpage>42</fpage><lpage>52</lpage><!--PubMed citation query: 'Am J Epidemiol||153|42||bib15|'--><pub-id pub-id-type="pmid">11159146</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-grou