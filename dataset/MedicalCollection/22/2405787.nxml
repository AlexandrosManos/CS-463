le-title>QuantiFERON((R))-TB Gold test in the identification of latent tuberculosis infection in immigrants</article-title><source>J Infect</source><year>2007</year><volume>55</volume><fpage>164</fpage><lpage>168</lpage><pub-id pub-id-type="pmid">17428542</pub-id><pub-id pub-id-type="doi">10.1016/j.jinf.2007.02.004</pub-id></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Health</surname><given-names>RM</given-names></name></person-group><source>Regulations on the Control of Tuberculosis Issued by the Royal Ministry of Health on 21st June 2002</source><series>Regulations</series><year>2002</year><edition>I-1095E</edition><publisher-name>Royal Ministry of Health</publisher-name></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Altman</surname><given-names>DG</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Altman DG, D M, N BT and J GM</surname></name></person-group><source>Statistics with confidence Confidence intervals and statistical guidelines</source><year>2000</year><edition>2nd</edition><publisher-name>BMJ Books</publisher-name><fpage>240</fpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lalvani</surname><given-names>A</given-names></name><name><surname>Nagvenkar</surname><given-names>P</given-names></name><name><surname>Udwadia</surname><given-names>Z</given-names></name><name><surname>Pathan</surname><given-names>AA</given-names></name><name><surname>Wilkinson</surname><given-names>KA</given-names></name><name><surname>Shastri</surname><given-names>JS</given-names></name><name><surname>Ewer</surname><given-names>K</given-names></name><name><surname>Hill</surname><given-names>AV</given-names></name><name><surname>Mehta</surname><given-names>A</given-names></name><name><surname>Rodrigues</surname><given-names