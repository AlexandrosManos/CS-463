son-group-type="author"><name><surname>Aretz</surname><given-names>S.</given-names></name></person-group> (<year>2010</year>). <article-title>The differential diagnosis and surveillance of hereditary gastrointestinal polyposis syndromes</article-title>. <source>Dtsch. Arztebl. Int</source>. <volume>107</volume>, <fpage>163</fpage>&#x02013;<lpage>173</lpage><pub-id pub-id-type="doi">10.3238/arztebl.2010.0163</pub-id><pub-id pub-id-type="pmid">20358032</pub-id></mixed-citation></ref><ref id="B6"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bai</surname><given-names>H.</given-names></name><name><surname>Jones</surname><given-names>S.</given-names></name><name><surname>Guan</surname><given-names>X.</given-names></name><name><surname>Wilson</surname><given-names>T. M.</given-names></name><name><surname>Sampson</surname><given-names>J. R.</given-names></name><name><surname>Cheadle</surname><given-names>J. P.</given-names></name><name><surname>Lu</surname><given-names>A. L.</given-names></name></person-group> (<year>2005</year>). <article-title>Functional characterization of two human MutY homolog (hMYH) missense mutations (R227W and V232F) that lie within the putative hMSH6 binding domain and are associated with hMYH polyposis</article-title>. <source>Nucleic Acids Res</source>. <volume>33</volume>, <fpage>597</fpage>&#x02013;<lpage>604</lpage><pub-id pub-id-type="doi">10.1093/nar/gki209</pub-id><pub-id pub-id-type="pmid">15673720</pub-id></mixed-citation></ref><ref id="B5"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bai</surname><given-names>H.</given-names></name><name><surname>Grist</surname><given-names>S.</given-names></name><name><surname>Gardner</surname><given-names>J.</given-names></name><name><surname>Suthers</surname><given-names>G.</given-names></name><name><surname>Wilson</surname><given-names>T. M.</given-names></name><name><surname>Lu</surname><given-names>A. L.</given-names></name></person-group> (<year>2007</year>). <article-title>Functional characterization of human MutY homolog (hMYH) missense mutation (R231L) that is linked with hMYH-associated polyposis</article-title>. <source>Cancer Lett</source>. <volume>250</volume>, <fpage>74</fpage>&#x02013;<lpage>81</lpage><pub-id pub-id-type="doi">10.1016/j.canlet.2006.09.016</pub-id><pub-id pub-id-type="pmid">17081686</pub-id></mixed-citation></ref><ref id="B7"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Barnetson</surname><given-names>R. A.</given-names></name><name><surname>Devlin</surname><given-names>L.</given-names></name><name><surname>Miller</surname><given-names>J.</given-names></name><name><surname>Farrington</surname><given-names>S. M.</given-names></name><name><surname>Slater</surname><given-names>S.</given-names></name><name><surname>Drake</surname><given-names>A. C.</given-names></name><name><surname>Campbell</surname><given-names>H.</given-names></name><name><surname>Dunlop</surname><given-names>M. G.</given-names></name><name><surname>Porteous</surname><given-names>M. E.</given-names></name></person-group> (<year>2007</year>). <article-title>Germline mutation prevalence in the base excision repair gene, MYH, in patients with endometrial cancer</article-title>. <source>Clin. Genet</source>. <volume>72</volume>, <fpage>551</fpage>&#x02013;<lpage>555</lpage><pub-id pub-id-type="doi">10.1111/j.1399-0004.2007.00900.x</pub-id><pub-id pub-id-type="pmid">17956577</pub-id></mixed-citation></ref><ref id="B8"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Boparai</surname><given-names>K. S.</given-names></name><name><surname>Dekker</surname><given-names>E.</given-names></name><name><surname>Van Eeden</surname><given-names>S.</given-names></name><name><surname>Polak</surname><given-names>M. M.</given-names></name><name><surname>Bartelsman</surname><given-