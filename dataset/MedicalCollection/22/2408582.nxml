e="pmid">7762709</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Luepker</surname><given-names>RV</given-names></name><name><surname>Murray</surname><given-names>DM</given-names></name><name><surname>Jacobs</surname><given-names>DR</given-names><suffix>Jr</suffix></name><name><surname>Mittelmark</surname><given-names>MB</given-names></name><name><surname>Bracht</surname><given-names>N</given-names></name><name><surname>Carlaw</surname><given-names>R</given-names></name><name><surname>Crow</surname><given-names>R</given-names></name><name><surname>Elmer</surname><given-names>P</given-names></name><name><surname>Finnegan</surname><given-names>J</given-names></name><name><surname>Folsom</surname><given-names>AR</given-names></name><name><surname>Grimm</surname><given-names>R</given-names></name><name><surname>Hannan</surname><given-names>PJ</given-names></name><name><surname>Jeffrey</surname><given-names>R</given-names></name><name><surname>Lando</surname><given-names>H</given-names></name><name><surname>McGovern</surname><given-names>P</given-names></name><name><surname>Mullis</surname><given-names>R</given-names></name><name><surname>Perry</surname><given-names>CL</given-names></name><name><surname>Pechacek</surname><given-names>T</given-names></name><name><surname>Pirie</surname><given-names>P</given-names></name><name><surname>Sprafka</surname><given-names>M</given-names></name></person-group><article-title>Community education for cardiovascular disease prevention: risk factor changes in the Minnesota Heart Health Program</article-title><source>American Journal of Public Health</source><year>1994</year><volume>84</volume><fpage>1383</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">8092360</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Farquhar</surname><given-names>JW</given-names></name><name><surname>