ens</article-title><source>Carcinogenesis</source><year>1993</year><volume>14</volume><fpage>483</fpage><lpage>492</lpage><!--PubMed citation query: 'Carcinogenesis||14|483||bib6|'--><pub-id pub-id-type="pmid">8453725</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cavalieri</surname><given-names>E</given-names></name><name><surname>Rogan</surname><given-names>E</given-names></name><name><surname>Sinha</surname><given-names>D</given-names></name></person-group><article-title>Cacinogenicity of aromatic hydrocarbons directly applied to rat mammary gland</article-title><source>J Cancer Res Clin Oncol</source><year>1988</year><volume>114</volume><fpage>3</fpage><lpage>9</lpage><!--PubMed citation query: 'J Cancer Res Clin Oncol||114|3||bib7|'--><pub-id pub-id-type="pmid">3350839</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>C</given-names></name><name><surname>Madeleine</surname><given-names>MM</given-names></name><name><surname>Lubinski</surname><given-names>C</given-names></name><name><surname>Tichman</surname><given-names>EW</given-names></name><name><surname>Daling</surname><given-names>JR</given-names></name></person-group><article-title>glutathione S-transferase M1 genotypes and the risk of anal cancer: a population-based case-control study</article-title><source>Cancer Epidemiol Biomark Prev</source><year>1996</year><volume>5</volume><fpage>985</fpage><lpage>991</lpage><!--PubMed citation query: 'Cancer Epidemiol Biomark Prev||5|985||bib8|'--></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Davies</surname><given-names>SM</given-names></name><name><surname>Buckely</surname><given-names>JD</given-names></name><name><surname>Robinson</surname><given-names>LL</given-names></name><name><surname>Tjoe</surna