47</volume><fpage>117</fpage><lpage>123</lpage><!--PubMed citation query: 'Biol Trace Elem Res||47|117||bib11|'--><pub-id pub-id-type="pmid">7779537</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Faure</surname><given-names>H</given-names></name><name><surname>Coudray</surname><given-names>C</given-names></name><name><surname>Mousseau</surname><given-names>M</given-names></name><name><surname>Ducros</surname><given-names>V</given-names></name><name><surname>Douki</surname><given-names>T</given-names></name><name><surname>Favier</surname><given-names>A</given-names></name></person-group><article-title>5-Hydroxy -methyluracil excretion. Plasma TBARS and plasma antioxidant vitamins in adriamycin-treated patients</article-title><source>Free Radic Biol Med</source><year>1996</year><volume>20</volume><fpage>979</fpage><lpage>983</lpage><!--PubMed citation query: 'Free Radic Biol Med||20|979||bib12|'--><pub-id pub-id-type="pmid">8743984</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ghadirian</surname><given-names>P</given-names></name><name><surname>Lacroix</surname><given-names>A</given-names></name><name><surname>Perret</surname><given-names>C</given-names></name><name><surname>Robodoux</surname><given-names>A</given-names></name><name><surname>Falardeau</surname><given-names>M</given-names></name><name><surname>Maisonneuve</surname><given-names>P</given-names></name></person-group><article-title>Breast cancer risk and nutrient intake among French Canadians in Montreal: a case-control study</article-title><source>Breast</source><year>1998</year><volume>7</volume><fpage>108</fpage><lpage>113</lpage><!--PubMed citation query: 'Breast||7|108||bib13|'--></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gumundsdottir</surname><given-names