><surname>Newman</surname><given-names>M</given-names></name><name><surname>Burridge</surname><given-names>J</given-names></name><name><surname>Izadi</surname><given-names>H</given-names></name><name><surname>Sackley</surname><given-names>CM</given-names></name></person-group><article-title>Treadmill training for individuals with multiple sclerosis: a pilot randomised trial</article-title><source>J Neurol Neurosurg Psychiatry</source><year>2006</year><volume>77</volume><fpage>531</fpage><lpage>533</lpage><pub-id pub-id-type="pmid">16543538</pub-id><pub-id pub-id-type="doi">10.1136/jnnp.2005.064410</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>White</surname><given-names>AT</given-names></name><name><surname>Wilson</surname><given-names>TE</given-names></name><name><surname>Davis</surname><given-names>SL</given-names></name><name><surname>Petajan</surname><given-names>JH</given-names></name></person-group><article-title>Effect of precooling on physical performance in multiple sclerosis</article-title><source>Mult Scler</source><year>2000</year><volume>6</volume><fpage>176</fpage><lpage>180</lpage><pub-id pub-id-type="pmid">10871829</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bergersen</surname><given-names>TK</given-names></name></person-group><article-title>A search for arteriovenous anastomoses in human skin using ultrasound Doppler</article-title><source>Acta Physiol Scand</source><year>1993</year><volume>147</volume><fpage>195</fpage><lpage>201</lpage><pub-id pub-id-type="pmid">8475746</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rowell</surname><given-names>LB</given-names></name></person-group><article-title>Human cardiovascular adjustments to exercise and thermal stress</article-title><source>Physiol Rev</source><year>1974</year><volume>54</volume><fpage>75</fpage><lpage>159</lpage><pub-id pub-id-type="pmid">4587247</pub-id></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Greenfield</surname><given-names>A</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Hamilton W, Dow P</surname></name></person-group><article-title>The circulation through the skin</article-title><source>Handbook of physiology Section 2: Circulation</source><year>1963</year><volume>2</volume><publisher-name>Washington, DC: American Physiological Society</publisher-name><fpage>1325</fpage><lpage>1351</lpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Allsopp</surname><given-names>AJ</given-names></name><name><surname>Poole</surname><given-names>KA</given-names></name></person-group><article-title>The effect of hand immersion on body temperature when wearing impermeable clothing</article-title><source>J R Nav Med Serv</source><year>1991</year><volume>77</volume><fpage>41</fpage><lpage>47</lpage><pub-id pub-id-type="pmid">1941762</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>House</surname><given-names>JR</given-names></name><name><surname>Holmes</surname><given-names>C</given-names></name><name><surname>Allsopp</surname><given-names>AJ</given-names></name></person-group><article-title>Prevention of heat strain by immersing the hands and forearms in water</article-title><source>J R Nav Med Serv</source><year>1997</year><volume>83</volume><fpage>26</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">9282438</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Livingstone</surname><given-names>SD</given-names></name><name><surname>Nolan</surname><given-names>RW</given-names></name><name><surname>Cattroll</surname><given-names>SW</given-names></name></person-group><article-title>Heat loss caused by immersing the hands in water</article-title><source>Aviat Space Environ Med</source><year>1989</year><volume>60</volume><fpage>1166</fpage><lpage>1171</lpage><pub-id pub-id-type="pmid">2604672</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Livingstone</surname><given-names>SD</given-names></name><name><surname>Nolan</surname><given-names>RW</given-names></name><name><surname>Keefe</surname><given-names>AA</given-names></name></person-group><article-title>Heat loss caused by cooling the feet</article-title><source>Aviat Space Environ Med</source><year>1995</year><volume>66</volume><fpage>232</fpage><lpage>237</lpage><pub-id pub-id-type="pmid">7661832</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Selkirk</surname><given-names>GA</given-names></name><name><surname>McLellan</surname><given-names>TM</given-names></name><name><surname>Wong</surname><given-names>J</given-names></name></person-group><article-title>Active versus passive cooling during work in warm environments while wearing firefighting protective clothing</article-title><source>J Occup Environ Hyg</source><year>2004</year><volume>1</volume><fpage>521</fpage><lpage>531</lpage><pub-id pub-id-type="pmid">15238305</pub-id><pub-id pub-id-type="doi">10.1080/15459620490475216</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tipton</surname><given-names>MJ</given-names></name><name><surname>Allsopp</surname><given-names>A</given-names></name><name><surname>Balmi</surname><given-names>PJ</given-names></name><name><surname>House</surname><given-names>JR</given-names></name></person-group><article-title>Hand immersion as a method of cooling and rewarmin