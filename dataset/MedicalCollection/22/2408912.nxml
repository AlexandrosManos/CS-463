ation-type="book"><person-group person-group-type="author"><name><surname>Quinn</surname><given-names>MJ</given-names></name><name><surname>Babb</surname><given-names>PJ</given-names></name><name><surname>Jones</surname><given-names>J</given-names></name><name><surname>Baker</surname><given-names>A</given-names></name><name><surname>Ault</surname><given-names>C</given-names></name></person-group><article-title/><year>1999</year><publisher-name>London: Office for National Statistics</publisher-name>Cancer 1971&#x02013;1997: Registrations of cancer cases and deaths in England and Wales by sex, age, year, health region and type of cancer (CD-ROM).</citation></ref><ref id="bib20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Quinn</surname><given-names>M</given-names></name><name><surname>Babb</surname><given-names>P</given-names></name><name><surname>Brock</surname><given-names>A</given-names></name><name><surname>Kirby</surname><given-names>L</given-names></name><name><surname>Jones</surname><given-names>J</given-names></name></person-group><article-title>Cancer trends in England and Wales. 1950&#x02013;1999</article-title><year>2001</year><publisher-name>London: The Stationery Office</publisher-name>Studies on medical and population subjects No 66.</citation></ref><ref id="bib21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>MA</given-names></name><name><surname>Gurney</surname><given-names>JG</given-names></name><name><surname>Ries</surname><given-names>LA</given-names></name></person-group><article-title>Cancer in adolescents 15&#x02013;19 years old</article-title><source>Cancer incidence and survival among children and adolescents.</source><year>1999</year><publisher-name>Bethesda, MD: NIH Pub No 99-4649</publisher-name>Ries LA, Smith MA, Gurney JG, Linet M, Tamra T, Young JL, Bunin GR (eds)United States SEER Program 1975&#x02013;1997, National Cancer Institute, SEER Program</citation></ref><ref id="bib22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stiller</surname><given-names>CA</given-names></name></person-group><article-title>Thyroid cancer following Chernobyl</article-title><source>Eur J Cancer</source><year>2001</year><volume>37</volume><fpage>945</fpage><lpage>947</lpage><!--PubMed citation query: 'Eur J Cancer||37|945||bib22|'--><pub-id pub-id-type="pmid">11334718</pub-id></citation></ref><ref id="bib23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Stiller</surname><given-names>CA</given-names></name><name><surname>Allen</surname><given-names>M</given-names></name><name><surname>Bayne</surname><given-names>A</given-names></name><name><surname>Brownbill</surname><given-names>P</given-names></name><name><surname>Draper</surname><given-names>G</given-names></name><name><surname>Eatock</surname><given-names>E</given-names></name><name><surname>Loach</surname><given-names>M</given-names></name><name><surname>Vincent</surname><given-names>T</given-names></name></person-group><article-title>United Kingdom National Registry of Childhood Tumours, England and Wales, 1981&#x02013;1990</article-title><source>International Incidence of Childhood Cancer</source><year>1998</year><publisher-name>Lyon: IARC (IARC Scientific Publications no 144)</publisher-name>(eds)Vol II.</citation></ref><ref id="bib24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Walsh</surname><given-names>PM</given-names></name><name><surname>Comber</surname><given-names>H</given-names></name><name><surname>Gavin</surname><given-names>AT</given-names></name></person-group><article-title>All-Ireland Cancer Statistics 1994&#x02013;96. A joint report on incidence and mortality for the island of Ireland</article-title><year>2001</year><publisher-name>National Cancer Registry (Ireland), Cork and Northern Ireland Cancer Registry: Belfast</publisher-name></citation></ref><ref id="bib25"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Weiss</surname><given-names>SW</given-names></name><name><surname>Goldblum</surname><given-names>JR</given-names></name></person-group><article-title/><source>Enzinger and Weiss's soft tissue tumours</source><year>2001</year><publisher-name>Mosby: St Louis</publisher-name>4th edition.</citation></ref><ref id="bib26"><citation citation-type="book"><person-group person-group-type="author"><collab>World Health Organisation</collab></person-group><article-title/><source>International statistical classification of diseases, injuries and causes of death</source><year>1975</year><publisher-name>Geneva: WHO</publisher-name>9th Revn.</citation></ref><ref id="bib27"><citation citation-type="book"><person-group person-group-type="author"><collab>World Health Organisation</collab></person-group><article-title/><source>International classification of diseases for oncology</source><year>1976</year><publisher-name>Geneva: WHO</publisher-name>1st edn.</citation></ref><ref id="bib28"><citation citation-type="book"><person-group person-group-type="author"><collab>World Health Organisation</collab></person-group><article-title/><source>International statistical classification of diseases and related health problems</source><year>1992</year><publisher-name>10th Revn. Geneva: WHO</publisher-name></citation></ref></ref-list></back></article>