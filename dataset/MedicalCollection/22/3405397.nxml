ation publication-type="journal"><person-group person-group-type="author"><collab>NIH</collab></person-group><article-title>National institutes of health state of the science conference statement. Manifestations and management of chronic insomnia in adults</article-title><source>Sleep</source><year>2005</year><volume>28</volume><fpage>1049</fpage><lpage>1057</lpage><pub-id pub-id-type="pmid">16268373</pub-id></mixed-citation></ref><ref id="CR15"><label>15.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lichstein</surname><given-names>KL</given-names></name></person-group><article-title>Secondary insomnia: a myth dismissed</article-title><source>Sleep Med Rev</source><year>2006</year><volume>10</volume><fpage>3</fpage><lpage>5</lpage><pub-id pub-id-type="doi">10.1016/j.smrv.2005.10.001</pub-id><pub-id pub-id-type="pmid">16380276</pub-id></mixed-citation></ref><ref id="CR16"><label>16.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Reynolds</surname><given-names>CF</given-names></name><name><surname>Redline</surname><given-names>S</given-names></name></person-group><article-title>DSM-V sleep&#x02013;wake disorders workgroup and advisors. The DSM-V sleep&#x02013;wake disorders nosology: an update and an invitation to the sleep community</article-title><source>Sleep</source><year>2010</year><volume>33</volume><fpage>10</fpage><lpage>11</lpage><pub-id pub-id-type="pmid">20120613</pub-id></mixed-citation></ref><ref id="CR17"><label>17.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Koffel</surname><given-names>E</given-names></name><name><surname>Watson</surname><given-names>D</given-names></name></person-group><article-title>The two-factor structure of sleep complaints and its relation to depression and anxiety</article-title><source>J Abnorm Psychol</source><year>2009</year><volume>118</volume><fpage>183</fpage><lpage>194</lpage><pub-id pub-id-type="doi">10.1037/a0013945</pub-id><pub-id pub-id-type="pmid">19222324</pub-id></mixed-citation></ref><ref id="CR18"><label>18.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Baglioni</surname><given-names>C</given-names></name><name><surname>Spiegelhalder</surname><given-names>K</given-names></name><name><surname>Lombardo</surname><given-names>C</given-names></name><name><surname>Riemann</surname><given-names>D</given-names></name></person-group><article-title>Sleep and emotions: a focus on insomnia</article-title><source>Sleep Med Rev</source><year>2010</year><volume>14</volume><fpage>227</fpage><lpage>238</lpage><pub-id pub-id-type="doi">10.1016/j.smrv.2009.10.007</pub-id><pub-id pub-id-type="pmid">20137989</pub-id></mixed-citation></ref><ref id="CR19"><label>19.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Baglioni</surname><given-names>C</given-names></name><name><surname>Lombardo</surname><given-names>C</given-names></name><name><surname>Bux</surname><given-names>E</given-names></name><name><surname>Hansen</surname><given-names>S</given-names></name><name><surname>Salveta</surname><given-names>C</given-names></name><name><surname>Biello</surname><given-names>S</given-names></name><etal/></person-group><article-title>Psychophysiological reactivity to sleep-related emotional stimuli in primary insomnia</article-title><source>Behav Res Ther</source><year>2010</year><volume>48</volume><fpage>467</fpage><lpage>475</lpage><pub-id pub-id-type="doi">10.1016/j.brat.2010.01.008</pub-id><pub-id pub-id-type="pmid">20227678</pub-id></mixed-citation></ref><ref id="CR20"><label>20.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Riemann</surname><given-names>D</given-names></name><name><surname>Spiegelhalder</surname><given-names>K</given-names></name