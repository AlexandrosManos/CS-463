e><name><surname>Wang</surname><given-names>C</given-names></name><name><surname>Liu</surname><given-names>LP</given-names></name><name><surname>Prior</surname><given-names>AS</given-names></name><name><surname>Agrawal</surname><given-names>S</given-names></name><name><surname>Muskat</surname><given-names>BL</given-names></name><name><surname>Cuticchia</surname><given-names>AJ</given-names></name></person-group><article-title>TM Finder: a prediction program for transmembrane protein segments using a combination of hydrophobicity and nonpolar phase helicity scales</article-title><source>Protein Sci</source><year>2001</year><volume>10</volume><fpage>212</fpage><lpage>219</lpage><pub-id pub-id-type="pmid">11266608</pub-id></citation></ref><ref id="b15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fluckiger</surname><given-names>U</given-names></name><name><surname>Ulrich</surname><given-names>M</given-names></name><name><surname>Steinhuber</surname><given-names>A</given-names></name><name><surname>D&#x000f6;ring</surname><given-names>G</given-names></name><name><surname>Mack</surname><given-names>D</given-names></name><name><surname>Landmann</surname><given-names>R</given-names></name><etal/></person-group><article-title>Biofilm formation, <italic>icaADBC</italic> transcription, and polysaccharide intercellular adhesin synthesis by staphylococci in a device-related infection model</article-title><source>Infect Immun</source><year>2005</year><volume>73</volume><fpage>1811</fpage><lpage>1819</lpage><pub-id pub-id-type="pmid">15731082</pub-id></citation></ref><ref id="b16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Freiberger</surname><given-names>R</given-names></name><name><surname>Claus</surname><given-names>H</given-names></name><name><surname>G&#x000fc;ngel</surname><given-names>A</given-names></name><name><surname>Oltmann-Norden</surname><given-names>II</given-names></name><name><surname>Vionnet</surname><given-names>J</given-names></name><name><surname>M&#x000fc;hlenhopp</surname><given-names>M</given-names></name><etal/></person-group><article-title>Biochemical characterization of a <italic>Neisseria meningitidis</italic> polysialyltransferase reveals novel functional motifs in bacterial sialyltransferases</article-title><source>Mol Microbiol</source><year>2007</year><volume>65</volume><fpage>1258</fpage><lpage>1275</lpage><pub-id pub-id-type="pmid">17662040</pub-id></citation></ref><ref id="b17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Frosch</surname><given-names>M</given-names></name><name><surname>Muller</surname><given-names>A</given-names></name></person-group><article-title>Phospholipid substitution of capsular polysaccharides and mechanisms of capsule formation in <italic>Neisseria meningitidis</italic></article-title><source>Mol Microbiol</source><year>1993</year><volume>8</volume><fpage>483</fpage><lpage>493</lpage><pub-id pub-id-type="pmid">8326861</pub-id></citation></ref><ref id="b18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hannah</surname><given-names>R</given-names></name><name><surname>Stroke</surname><given-names>I</given-names></name><name><surname>Betz</surname><given-names>N</given-names></name></person-group><article-title>Beta-Glo&#x000ae; assay system: a luminescent &#x003b2;-galactosidase assay for multiple cell types and media</article-title><source>Cell Notes</source><year>2003</year><volume>6</volume><fpage>16</fpage><lpage>18</lpage></citation></ref><ref id="b19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>von Heijne</surname><given-names>G</given-names></name></person-group><article-title>Membrane protein structure prediction: hydrophobicity analysis and the &#x02018;positive inside&#x02019; rule</article-title><source>J Mol Biol</source><year>1992</year><volume>2