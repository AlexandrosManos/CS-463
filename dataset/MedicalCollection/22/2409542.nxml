haroff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="11" align="left" valign="top" charoff="50"><italic>By age (years)</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;17&#x02013;49</td><td align="left" valign="top" charoff="50">Asp&#x0002f;Asp (G&#x0002f;G)</td><td align="center" valign="top" charoff="50">31</td><td align="center" valign="top" charoff="50">28</td><td align="center" valign="top" charoff="50">1.0</td><td align="left" valign="top" charoff="50">Ref.</td><td align="left" valign="top" charoff="50">Lys&#x0002f;Lys (A&#x0002f;A)</td><td align="center" valign="top" charoff="50">34</td><td align="center" valign="top" charoff="50">30</td><td align="center" valign="top" charoff="50">1.0</td><td align="left" valign="top" charoff="50">Ref.</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;17&#x02013;49</td><td align="left" valign="top" charoff="50">Asp&#x0002f;Asn (G&#x0002f;A) Asn&#x0002f;Asn (A&#x0002f;A)</td><td align="center" valign="top" charoff="50">49</td><td align="center" valign="top" charoff="50">74</td><td align="center" valign="top" charoff="50">0.7</td><td align="left" valign="top" charoff="50">(0.4-1.5)</td><td align="left" valign="top" charoff="50">Lys&#x0002f;Gln (A&#x0002f;C) Gln&#x0002f;Gln (C&#x0002f;C)</td><td align="center" valign="top" charoff="50">51</td><td align="center" valign="top" charoff="50">75</td><td align="center" valign="top" charoff="50">0.7</td><td align="left" valign="top" charoff="50">(0.4&#x02013;1.5)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;50&#x02013;77</td><td align="left" valign="top" charoff="50">Asp&#x0002f;Asp (G&#x0002f;G)</td><td align="center" valign="top" charoff="50">21</td><td align="center" valign="top" charoff="50">31</td><td align="center" valign="top" charoff="50">1.0</td><td align="left" valign="top" charoff="50">Ref.</td><td align="left" valign="top" charoff="50">Lys&#x0002f;Lys (A&#x0002f;A)</td><td align="char" valign="top" char="." charoff="50">24</td><td align="char" valign="top" char="." charoff="50">29</td><td align="char" valign="top" char="." charoff="50">1.0</td><td align="left" valign="top" charoff="50">Ref.</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;50&#x02013;77</td><td align="left" valign="top" charoff="50">Asp&#x0002f;Asn (G&#x0002f;A) Asn&#x0002f;Asn (A&#x0002f;A)</td><td align="center" valign="top" charoff="50">63</td><td align="center" valign="top" charoff="50">39</td><td align="center" valign="top" charoff="50">3.4</td><td align="left" valign="top" charoff="50">(1.6&#x02013;7.3)</td><td align="left" valign="top" charoff="50">Lys&#x0002f;Gln (A&#x0002f;C) Gln&#x0002f;Gln (C&#x0002f;C)</td><td align="center" valign="top" charoff="50">67</td><td align="center" valign="top" charoff="50">43</td><td align="center" valign="top" charoff="50">2.3</td><td align="left" valign="top" charoff="50">(1.1&#x02013;4.9)</td></tr><tr><td align="left" valign="top" charoff="50">Test of heterogeneity of ORs<sup>b</sup></td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50"><italic>P</italic>&#x0003d;0.004</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50"><italic>P</italic>&#x0003d;0.03</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" vali