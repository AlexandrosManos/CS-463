bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Houlston</surname><given-names>RS</given-names></name><name><surname>McCarter</surname><given-names>E</given-names></name><name><surname>Parbhoo</surname><given-names>S</given-names></name><name><surname>Scurr</surname><given-names>JH</given-names></name><name><surname>Slack</surname><given-names>J</given-names></name></person-group><article-title>Family history and risk of breast cancer</article-title><source>J Med Genet</source><year>1992</year><volume>29</volume><fpage>154</fpage><lpage>157</lpage><!--PubMed citation query: 'J Med Genet||29|154||bib16|'--><pub-id pub-id-type="pmid">1552556</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jatoi</surname><given-names>I</given-names></name><name><surname>Baum</surname><given-names>M</given-names></name></person-group><article-title>Mammographically detected ductal carcinoma <italic>in situ</italic>: are we overdiagnosing breast cancer</article-title><source>Surgery</source><year>1995</year><volume>118</volume><fpage>118</fpage><lpage>120</lpage><!--PubMed citation query: 'Surgery||118|118||bib17|'--><pub-id pub-id-type="pmid">7604373</pub-id></citation></ref><ref id="bib18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kerlikowske</surname><given-names>K</given-names></name><name><surname>Grady</surname><given-names>D</given-names></name><name><surname>Rubin</surname><given-names>SM</given-names></name><name><surname>Sandrock</surname><given-names>C</given-names></name><name><surname>Ernster</surname><given-names>VL</given-names></name></person-group><article-title>Efficacy of screening mammography. A meta-analysis</article-title><source>JAMA</source><year>1995</year><volume>273</volume><fpage>149</fpage><lpage>154</lpage><!--PubMed citation query: 'JAMA||273|149||bib18|'--><pub-id pub-id-type="pm