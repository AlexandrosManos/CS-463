n="left" rowspan="1" colspan="1">22.5000</td><td align="left" rowspan="1" colspan="1">48.0000</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Cdc37</italic></td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">15.6667</td><td align="left" rowspan="1" colspan="1">15.2727</td><td align="left" rowspan="1" colspan="1">56.7500</td><td align="left" rowspan="1" colspan="1">18.6500</td><td align="left" rowspan="1" colspan="1">59.2000</td><td align="left" rowspan="1" colspan="1">20.2500</td><td align="left" rowspan="1" colspan="1">55.0000</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Dnz1</italic></td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">11.5000</td><td align="left" rowspan="1" colspan="1">12.5455</td><td align="left" rowspan="1" colspan="1">48.0000</td><td align="left" rowspan="1" colspan="1">22.0000</td><td align="left" rowspan="1" colspan="1">49.6000</td><td align="left" rowspan="1" colspan="1">27.7500</td><td align="left" rowspan="1" colspan="1">47.0000</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>egh</italic></td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">6.6667</td><td align="left" rowspan="1" colspan="1">6.5455</td><td align="left" rowspan="1" colspan="1">47.2500</td><td align="left" rowspan="1" colspan="1">9.6000</td><td align="left" rowspan="1" colspan="1">47.6000</td><td align="left" rowspan="1" colspan="1">9.5000</td><td align="left" rowspan="1" colspan="1">49.0000</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Est6</italic></td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">38.3333</td><td align="left" rowspan="1" colspan="1">37.6364</td><td align="left" rowspan="1" colspan="1">77.0577</td><td align="left" rowspan="1" colspan="1">36.8750</td><td align="left" rowspan="1" colspan="1">76.4487</td><td align="left" rowspan="1" colspan