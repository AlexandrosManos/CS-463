50">&#x02212;4</td><td align="center" valign="top" char="." charoff="50">3.2</td><td align="center" valign="top" char="." charoff="50">3</td><td align="center" valign="top" char="." charoff="50">1.3</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" char="." charoff="50">48</td><td align="center" valign="top" char="." charoff="50">&#x02212;4</td><td align="center" valign="top" char="." charoff="50">3.7</td><td align="center" valign="top" char="." charoff="50">1</td><td align="center" valign="top" char="." charoff="50">3.2</td><td align="center" valign="top" char="." charoff="50">3</td><td align="center" valign="top" char="." charoff="50">0.5</td></tr><tr><td align="left" valign="top" charoff="50">Gemcitabine alone</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" char="." charoff="50">0</td><td align="center" valign="top" char="." charoff="50">&#x02212;1</td><td align="center" valign="top" char="." charoff="50">5.7</td><td align="center" valign="top" char="." charoff="50">3</td><td align="center" valign="top" char="." charoff="50">3.1</td><td align="center" valign="top" char="." charoff="50">&#x02212;1</td><td align="center" valign="top" char="." charoff="50">4.6</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" char="." charoff="50">4</td><td align="center" valign="top" char="." charoff="50">18</td><td align="center" valign="top" char="." charoff="50">7.5</td><td align="center" valign="top" char="." charoff="5