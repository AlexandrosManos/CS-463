50">22 (21.0)</td><td align="char" valign="top" char="." charoff="50">42 (20.8)</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">32 (33.0)</td><td align="char" valign="top" char="." charoff="50">64 (33.3)</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;60&#x02013;69</td><td align="char" valign="top" char="." charoff="50">52 (49.5)</td><td align="char" valign="top" char="." charoff="50">104 (51.5)</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">39 (40.2)</td><td align="char" valign="top" char="." charoff="50">77 (40.1)</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;70&#x02013;79</td><td align="char" valign="top" char="." charoff="50">25 (23.8)</td><td align="char" valign="top" char="." charoff="50">44 (21.8)</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">17 (17.5)</td><td align="char" valign="top" char="." charoff="50">33 (17.2)</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Age (years): mean&#x000b1;s.d.</td><td align="char" valign="top" char="." charoff="50">63.6&#x000b1;7.9</td><td align="char" valign="top" char="." charoff="50">63.3&#x000b1;7.8</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">61.6&#x000b1;8.3</td><td align="char" valign="top" char="." charoff="50">61.4&#x000b1;8.3</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50"><italic>H. pylori infection: no.</italic> (&#x00025;)</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Present</td><td align="char" valign="top" char="." charoff="50">91 (86.7)</td><td align="char" valign="top" char="." charoff="50">161 (79.7)</td><td align="char" valign="top" char="." charoff="50">0.16</td><td align="char" valign="top" char="." charoff="50">88 (90.7)</td><td align="char" valign="top" char="." charoff="50">151 (78.6)</td><td align="char" valign="top" char="." charoff="50">0.013</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Absent</td><td align="char" valign="top" char="." charoff="50">14 (13.3)</td><td align="char" valign="top" char="." charoff="50">41 (20.3)</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">9 (9.3)</td><td align="char" valign="top" char="." charoff="50">41 (21.4)</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50"><italic>Family history of stomac