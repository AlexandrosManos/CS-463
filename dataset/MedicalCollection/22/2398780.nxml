&#x02013;56</td><td align="left" rowspan="1" colspan="1">22 (23,7)</td><td align="left" rowspan="1" colspan="1">9 (40,9)</td><td align="left" rowspan="1" colspan="1">0,54 (0,17&#x02013;1,73)</td><td align="left" rowspan="1" colspan="1">0,161</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x0003e;56</td><td align="left" rowspan="1" colspan="1">24 (25,8)</td><td align="left" rowspan="1" colspan="1">7 (29,2)</td><td align="left" rowspan="1" colspan="1">0,32 (0,10&#x02013;1,05)</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td colspan="7" align="left" rowspan="1">BMI (kg/m2)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02264;25</td><td align="left" rowspan="1" colspan="1">43 (51,2)</td><td align="left" rowspan="1" colspan="1">18 (41,9)</td><td align="left" rowspan="1" colspan="1">1,00</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x0003e;25</td><td align="left" rowspan="1" colspan="1">41 (48,8)</td><td align="left" rowspan="1" colspan="1">15 (36,6)</td><td align="left" rowspan="1" colspan="1">0,80 (0,33&#x02013;1,93)</td><td align="left" rowspan="1" colspan="1">0,621</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td colspan="7" align="left" rowspan="1">Creatinin (micromol/L)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02264;83</td><td align="left" rowspan="1" colspan="1">47 (52,8)</td><td align="left" rowspan="1" colspan="1">17 (36,2)</td><td align="left" rowspan="1" colspan="1">1,00</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x0003e;83</td><td align="left" rowspan="1" colspan="1">42 (47,2)</td><td align="left" rowspan="1" colspan="1">16 (38,1)</td><td align="left" rowspan="1" colspan="1">1,08 (0,46&#x02013;2,57)</td><td align="left" rowspan="1" colspan="1">0,851</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td colspan="7" align="left" rowspan="1">Hemoglobin (g/dL)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02264;14,4</td><td align="left" rowspan="1" colspan="1">48 (52,2)</td><td align="left" rowspan="1" colspan="1">27 (56,3)</td><td align="left" rowspan="1" colspan="1">1,00</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x0003e;14,4</td><td align="left" rowspan="1" colspan="1">44 (47,8)</td><td align="left" rowspan="1" colspan="1">9 (20,5)</td><td align="left" rowspan="1" colspan="1">0,20 (0,08&#x02013;0,51)</td><td align="left" rowspan="1" colspan="1">0,001</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td colspan="7" align="left" rowspan="1">AST (IU/L)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x0003c;25 (female) or 30 (male)</td><td align="left" rowspan="1" colspan="1">12 (12,9)</td><td align="left" rowspan="1" colspan="1">6 (50,0)</td><td align="left" rowspan="1" colspan="1">1,00</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x02265;25 or 30</td><td align="left" rowspan="1" colspan="1">81 (87,1)</td><td align="left" rowspan="1" colspan="1">30 (37,0)</td><td align="left" rowspan="1" colspan="1">0,59 (0,17&#x02013;1,99)</td><td align="left" rowspan="1" colspan="1">0,390</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td colspan="7" align="left" rowspan="1">ALT (IU/L)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x0003c;25 (female) or 30 (male)</td><td align="left" rowspan="1" colspan="1">7 (7,5)</td><td align="left" rowspan="1" colspan="1">4 (57,1)</td><td align="left" rowspan="1" colspan="1">1,00</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x02265;25 or 30</td><td align="left" rowspan="1" colspan="1">86 (92,5)</td><td align="left" rowspan="1" colspan="1">32 (37,2)</td><td align="left" rowspan="1" colspan="1">0,44 (0,09&#x02013;2,11)</td><td align="left" rowspan="1" colspan="1">0,298</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td colspan="7" align="left" rowspan="1">GGT (IU/L)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x0003c;&#x0200a;&#x0003d;&#x0200a;72</td><td align="left" rowspan="1" colspan="1">46 (49,5)</td><td align="left" rowspan="1" colspan="1">29 (63,0)</td><td align="left" rowspan="1" colspan="1">1,00</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">1,00</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x0003e;72</td><td align="left" rowspan="1" colspan="1">47 (50,5)</td><td align="left" rowspan="1" colspan="1">7 (14,9)</td><td align="left" rowspan="1" colspan="1">0,10 (0,04&#x02013;0,28)</td><td align="left" rowspan="1" colspan="1">0,0001</td><td align="left" rowspan="1" colspan="1">0,14 (0,04&#x02013;0,56)</td><td align="left" rowspan="1" colspan="1">0,005</td></tr><tr><td colspan="7" align="left" rowspan="1">Alkalin Phosphatase (IU/L)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x0003c;&#x0200a;&#x0003d;&#x0200a;84</td><td align="left" rowspan="1" colspan="1">48 (51,6)</td><td align="left" rowspan="1" colspan="1">21 (43,8)</td><td align="left" rowspan="1" colspan="1">1,00</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x0003e;84</td><td align="left" rowspan="1" colspan="1">45 (48,4)</td><td align="left" rowspan="1" colspan="1">15 (33,3)</td><td align="left" rowspan="1" colspan="1">0,64 (0,28&#x02013;1,49)</td><td align="left" rowspan="1" colspan="1">0,304</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td colspan="7" align="left" rowspan="1">Platelets (x103/mm3)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02265;150</td><td align="left" rowspan="1" colspan="1">54 (60,0)</td><td align="left" rowspan="1" colspan="1">27 (50,0)</td><td align="left" rowspan="1" colspan="1">1,00</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x0003c;150</td><td align="left" rowspan="1" colspan="1">36 (40,0)</td><td align="left" rowspan="1" colspan="1">8 (22,2)</td><td align="left" rowspan="1" colspan="1">0,29 (0,11&#x02013;0,74)</td><td align="left" rowspan="1" colspan="1">0,008</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td colspan="7" align="left" rowspan="1">Total Bilirubin (mg/dL)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02264;10</td><td align="left" rowspan="1" colspan="1">40 (51,3)</td><td align="left" rowspan="1" colspan="1">16 (40,0)</td><td align="left" rowspan="1" colspan="1">1,00</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x0003e;10</td><td align="left" rowspan="1" colspan="1">38 (48,7)</td><td align="left" rowspan="1" colspan="1">14 (36,8)</td><td align="left" rowspan="1" colspan="1">0,88 (0,35&#x02013;2,18)</td><td align="left" rowspan="1" colspan="