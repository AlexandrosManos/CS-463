iven-names>RC</given-names></name></person-group><article-title>Dimensions of the impact of cancer pain in a four country sample: new information from multidimensional scaling</article-title><source>Pain</source><year>1996</year><volume>67</volume><fpage>267</fpage><lpage>273</lpage><!--PubMed citation query: 'Pain||67|267||bib5|'--><pub-id pub-id-type="pmid">8951920</pub-id></citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coluzzi</surname><given-names>PH</given-names></name></person-group><article-title>Cancer pain management: newer perspectives on opioids and episodic pain</article-title><source>Am J Hosp Palliat Care</source><year>1998</year><volume>15</volume><fpage>13</fpage><lpage>22</lpage><!--PubMed citation query: 'Am J Hosp Palliat Care||15|13||bib6|'--><pub-id pub-id-type="pmid">9468974</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Elliott</surname><given-names>TE</given-names></name></person-group><article-title>Pain control at the end of life</article-title><source>Minn Med</source><year>1997</year><volume>80</volume><fpage>27</fpage><lpage>32</lpage><!--PubMed citation query: 'Minn Med||80|27||bib7|'--></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><collab>EuroQol&#x000a9; Group</collab></person-group><article-title>EuroQol<sup>&#x000a9;</sup> &#x02013; a new facility for measurement of health related quality of life</article-title><source>Health Policy</source><year>1990</year><volume>16</volume><fpage>199</fpage><lpage>208</lpage><!--PubMed citation query: 'Health Policy||16|199||bib8|'--><pub-id pub-id-type="pmid">10109801</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Greenwald</surname><given-names>HP</given-names></name><name><surname>Bonica</surname><given-names>JJ</given-names></name><name><surname>Bergner</surname><given-names>M</given-names></name></person-group><article-title>The prevalence of pain in four cancers</article-title><source>Cancer</source><year>1987</year><volume>60</volume><fpage>2563</fpage><lpage>2569</lpage><!--PubMed citation query: 'Cancer||60|2563||bib9|'--><pub-id pub-id-type="pmid">2444328</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harrold</surname><given-names>JK</given-names></name></person-group><article-title>Pain symptoms, and suffering: possibilities and barriers</article-title><source>Hosp J</source><year>1998</year><volume>13</volume><fpage>37</fpage><lpage>40</lpage><!--PubMed citation query: 'Hosp J||13|37||bib10|'--><pub-id pub-id-type="pmid">9644390</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Larue</surname><given-names>F</given-names></name><name><surname>Colleau</surname><given-names>SM</given-names></name><name><surname>Brasseur</surname><given-names>L</given-names></name><name><surname>Cleeland</surname><given-names>CS</given-names></name></person-group><article-title>Multicentre study of cancer pain and its treatment in France</article-title><source>BMJ</source><year>1995</year><volume>310</volume><fpage>1034</fpage><lpage>1037</lpage><!--PubMed citation query: 'BMJ||310|1034||bib11|'--></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liao</surname><given-names>Y</given-names></name><name><surname>McGee</surname><given-names>DL</given-names></name><name><surname>Cao</surname><given-names>G</given-names></name><name><surname>Cooper</surname><given-names>RS</given-names></name></person-group><article-title>Quality of the last year of life of older adults: 1986 <italic>vs</italic> 1993</article-title><source>JAMA</source><year>2