-type="author"><collab>WHO</collab></person-group><source>WHO technical consultation on nutrient requirements for people living with HIV/AIDS</source><year>2003</year><publisher-name>Geneva, Switzerland</publisher-name></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bachou</surname><given-names>H</given-names></name><name><surname>Tyllesk&#x000e4;r</surname><given-names>T</given-names></name><name><surname>Downing</surname><given-names>R</given-names></name><name><surname>Tumwine</surname><given-names>JK</given-names></name></person-group><article-title>Severe malnutrition with and without HIV-1 infection in hospitalised children in Kampala, Uganda: differences in clinical features, haematological findings and CD4<sup>+ </sup>cell counts</article-title><source>Nutr J</source><year>2006</year><volume>5</volume><fpage>27</fpage><comment>Published online 2006 October 16. doi: 10.1186/1475-2891-5-27.</comment><pub-id pub-id-type="pmid">17042940</pub-id><pub-id pub-id-type="doi">10.1186/1475-2891-5-27</pub-id></citation></ref><ref id="B16"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Kerac</surname><given-names>M</given-names></name><name><surname>Bunn</surname><given-names>J</given-names></name></person-group><article-title>Excess Mortality Risk associated with HIV infection in a large Malawian NRU. (abstract/lecture presentation)</article-title><source>2nd Malawi Annual HIV/Nutrition Meeting, Blantyre, Malawi</source><comment>Jan 27th 2007</comment></citation></ref></ref-list></back></article>