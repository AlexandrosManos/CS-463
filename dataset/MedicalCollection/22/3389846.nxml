<person-group person-group-type="author"><name><surname>Armato</surname><given-names>S</given-names><suffix>III</suffix></name><name><surname>McLennan</surname><given-names>G</given-names></name><name><surname>McNitt-Gray</surname><given-names>MF</given-names></name><etal/></person-group><article-title>Lung Image Database Consortium: Developing a Resource for the Medical Imaging Research Community</article-title><source>Radiology</source><comment>200;</comment><volume>232</volume><fpage>739</fpage><lpage>48</lpage><pub-id pub-id-type="pmid">15333795</pub-id></element-citation></ref><ref id="b16-poljradiol-75-1-67"><label>16.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Awai</surname><given-names>K</given-names></name><name><surname>Murao</surname><given-names>K</given-names></name><name><surname>Ozawa</surname><given-names>A</given-names></name><etal/></person-group><article-title>Pulmonary Nodules at Chest CT: Effect of Computer-aided Diagnosis on Radiologists&#x02019; Detection Performance</article-title><source>Radiology</source><year>2004</year><volume>230</volume><fpage>347</fpage><lpage>352</lpage><pub-id pub-id-type="pmid">14752180</pub-id></element-citation></ref><ref id="b17-poljradiol-75-1-67"><label>17.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Yuan</surname><given-names>R</given-names></name><name><surname>Vos</surname><given-names>PM</given-names></name><name><surname>Cooperberg</surname><given-names>PL</given-names></name></person-group><article-title>Computer-Aided Detection in Screening CT for Pulmonary Nodules</article-title><source>Am J Roentgenol</source><year>2006</year><volume>186</volume><fpage>1280</fpage><lpage>87</lpage><pub-id pub-id-type="pmid">16632719</pub-id></element-citation></ref><ref id="b18-poljradiol-75-1-67"><label>18.</label><element-citation publication-type="journal"><person-group person-group-type="