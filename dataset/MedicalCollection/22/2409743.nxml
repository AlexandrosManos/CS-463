ce><year>2003</year><volume>159</volume><fpage>328</fpage><lpage>335</lpage><!--PubMed citation query: 'Radiat Res||159|328||bib9|'--><pub-id pub-id-type="pmid">12600235</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burd</surname><given-names>R</given-names></name><name><surname>Wachsberger</surname><given-names>PR</given-names></name><name><surname>Biaglow</surname><given-names>JE</given-names></name><name><surname>Wahl</surname><given-names>ML</given-names></name><name><surname>Lee</surname><given-names>I</given-names></name><name><surname>Leeper</surname><given-names>DB</given-names></name></person-group><article-title>Absence of Crabtree effect in human melanoma cells adapted to growth at low pH: reversal by respiratory inhibitors</article-title><source>Cancer Res</source><year>2001</year><volume>61</volume><fpage>5630</fpage><lpage>5635</lpage><!--PubMed citation query: 'Cancer Res||61|5630||bib10|'--><pub-id pub-id-type="pmid">11454717</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cairns</surname><given-names>RA</given-names></name><name><surname>Kalliomaki</surname><given-names>T</given-names></name><name><surname>Hill</surname><given-names>RP</given-names></name></person-group><article-title>Acute (cyclic) hypoxia enhances spontaneous metastasis of KHT murine tumors</article-title><source>Cancer Res</source><year>2001</year><volume>61</volume><fpage>8903</fpage><lpage>8908</lpage><!--PubMed citation query: 'Cancer Res||61|8903||bib11|'--><pub-id pub-id-type="pmid">11751415</pub-id></citation></ref><ref id="bib56"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Jaeger</surname><given-names>K</given-names></name><name><surname>Kavanagh</surname><given-names>MC</given-names></name><name><surname>Hill</surname><given-names>RP</given-names></name></person-group><article-title>Relationship of hypoxia to metastatic ability in rodent tumors</article-title><source>Br J Cancer</source><year>2001</year><volume>84</volume><fpage>1280</fpage><lpage>1285</lpage><!--PubMed citation query: 'Br J Cancer||84|1280||bib56|'--><pub-id pub-id-type="pmid">11336482</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fukumura</surname><given-names>D</given-names></name><name><surname>Xu</surname><given-names>L</given-names></name><name><surname>Chen</surname><given-names>Y</given-names></name><name><surname>Gohongi</surname><given-names>T</given-names></name><name><surname>Seed</surname><given-names>B</given-names></name><name><surname>Jain</surname><given-names>RK</given-names></name></person-group><article-title>Hypoxia and acidosis independently up-regulate vascular endothelial growth factor transcription in brain tumors <italic>in vivo</italic></article-title><source>Cancer Res</source><year>2001</year><volume>61</volume><fpage>6020</fpage><lpage>6024</lpage><!--PubMed citation query: 'Cancer Res||61|6020||bib12|'--><pub-id pub-id-type="pmid">11507045</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gillies</surname><given-names>RJ</given-names></name><name><surname>Raghunand</surname><given-names>N</given-names></name><name><surname>Karczmar</surname><given-names>GS</given-names></name><name><surname>Bhujwalla</surname><given-names>ZM</given-names></name></person-group><article-title>MRI of the tumor microenvironment</article-title><source>J Magn Reson Imaging</source><year>2002</year><volume>16</volume><fpage>430</fpage><lpage>450</lpage><!--PubMed citation query: 'J Magn Reson Imaging||16|430||bib13|'--><pub-id pub-id-type="pmid">12353258</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Griffiths</surname><given-names>JR</given-names></name><name><surname>McIntyre</surname><given-names>DJ</given-names></name><name><surname>Howe</surname><given-names>FA</given-names></name><name><surname>Stubbs</surname><given-names>M</given-names></name></person-group><article-title>Why are cancers acidic? A carrier-mediated diffusion model for H&#x0002b; transport in the interstitial fluid</article-title><source>Novart Found Symp</source><year>2001</year><volume>240</volume><fpage>46</fpage><lpage>62</lpage><!--PubMed citation query: 'Novart Found Symp||240|46||bib14|'--></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Helmlinger</surname><given-names>G</given-names></name><name><surname>Sckell</surname><given-names>A</given-names></name><name><surname>Dellian</surname><given-names>M</given-names></name><name><surname>Forbes</surname><given-names>NS</given-names></name><name><surname>Jain</surname><given-names>RK</given-names></name></person-group><article-title>Acid production in glycolysis-impaired tumors provides new insights into tumor metabolism</article-title><source>Clin Cancer Res</source><year>2002</year><volume>8</volume><fpage>1284</fpage><lpage>1291</lpage><!--PubMed citation query: 'Clin Cancer Res||8|1284||bib15|'--><pub-id pub-id-type="pmid">11948144</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Helmlinger</surname><given-names>G</given-names></name><name><surname>Yuan</surname><given-names>F</given-names></name><name><surname>Dellian</surname><given-names>M</given-names></name><name><surname>Jain</surname><given-names>RK</given-names></name></person-group><article-title>Interstitial pH and pO<sub>2</sub> gradients in solid tumors <italic>in vivo</italic>: high-resolution measurements reveal a lack of correlation</article-title><source>Nat Med</source><year>1997</year><volume>3</volume><fpage>