ticle-title><source>J Neurol Sci</source><year>1995</year><volume>131</volume><fpage>156</fpage><lpage>161</lpage><pub-id pub-id-type="pmid">7595641</pub-id><pub-id pub-id-type="doi">10.1016/0022-510X(95)00108-E</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Alton</surname><given-names>F</given-names></name><name><surname>Baldey</surname><given-names>L</given-names></name><name><surname>Caplan</surname><given-names>S</given-names></name><name><surname>Morrissey</surname><given-names>MC</given-names></name></person-group><article-title>A kinematic comparison of overground and treadmill walking</article-title><source> Clin Biomech (Bristol, Avon)</source><year>1998</year><volume>13</volume><fpage>434</fpage><lpage>440</lpage><pub-id pub-id-type="pmid">11415818</pub-id><pub-id pub-id-type="doi">10.1016/S0268-0033(98)00012-6</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Murray</surname><given-names>MP</given-names></name><name><surname>Spurr</surname><given-names>GB</given-names></name><name><surname>Sepic</surname><given-names>SB</given-names></name><name><surname>Gardner</surname><given-names>GM</given-names></name><name><surname>Mollinger</surname><given-names>LA</given-names></name></person-group><article-title>Treadmill vs floor walking; kinematics, electromyogram and heart rate</article-title><source>J App Phys</source><year>1985</year><volume>59</volume><fpage>89</fpage><lpage>91</lpage></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Strathy</surname><given-names>GM</given-names></name><name><surname>Chao</surname><given-names>EY</given-names></name><name><surname>Laughman</surname><given-names>RK</given-names></name></person-group><article-title>Changes in knee function associated with treadmill ambulation</article-title><source>J 