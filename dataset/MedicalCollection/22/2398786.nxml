<label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kamath</surname><given-names>RS</given-names></name><name><surname>Fraser</surname><given-names>AG</given-names></name><name><surname>Dong</surname><given-names>Y</given-names></name><name><surname>Poulin</surname><given-names>G</given-names></name><name><surname>Durbin</surname><given-names>R</given-names></name><etal/></person-group><year>2003</year><article-title>Systemic functional analysis of the <italic>Caenorhabditis elegans</italic> genome using RNAi.</article-title><source>Nature</source><volume>421</volume><fpage>231</fpage><lpage>237</lpage><pub-id pub-id-type="pmid">12529635</pub-id></citation></ref><ref id="pntd.0000246-Simmer1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simmer</surname><given-names>F</given-names></name><name><surname>Moorman</surname><given-names>C</given-names></name><name><surname>van der Linden</surname><given-names>AM</given-names></name><name><surname>Kuijk</surname><given-names>E</given-names></name><name><surname>van den Berghe</surname><given-names>PV</given-names></name><etal/></person-group><year>2003</year><article-title>Genome-wide RNAi of <italic>C. elegans</italic> using the hypersensitive <italic>rrf-3</italic> strain reveals novel gene functions.</article-title><source>PLoS Biol</source><volume>1</volume><fpage>e12</fpage><comment>doi:10.1371/journal.pbio.0000012</comment><pub-id pub-id-type="pmid">14551910</pub-id></citation></ref><ref id="pntd.0000246-Sugimoto1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sugimoto</surname><given-names>A</given-names></name></person-group><year>2004</year><article-title>High-throughput RNAi in <italic>Caenorhabditis elegans</italic>: genome-wide screens and functional genomics.</article-title><source>Differentiation</source><volume>72</volume><fpage>81</