</pub-id></citation></ref><ref id="pntd.0000246-Burglin1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burglin</surname><given-names>TR</given-names></name><name><surname>Lobos</surname><given-names>E</given-names></name><name><surname>Blaxter</surname><given-names>ML</given-names></name></person-group><year>1998</year><article-title><italic>Caenorhabditis elegans</italic> as a model for parasitic nematodes.</article-title><source>Int J Parasitol</source><volume>28</volume><fpage>395</fpage><lpage>411</lpage><pub-id pub-id-type="pmid">9559358</pub-id></citation></ref><ref id="pntd.0000246-Hashmi1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hashmi</surname><given-names>S</given-names></name><name><surname>Tawe</surname><given-names>W</given-names></name><name><surname>Lustigman</surname><given-names>S</given-names></name></person-group><year>2001</year><article-title><italic>Caenorhabditis elegans</italic> and the study of gene function in parasites.</article-title><source>Trends Parasitol</source><volume>17</volume><fpage>387</fpage><lpage>393</lpage><pub-id pub-id-type="pmid">11685900</pub-id></citation></ref><ref id="pntd.0000246-Brooks1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brooks</surname><given-names>DR</given-names></name><name><surname>Isaac</surname><given-names>RE</given-names></name></person-group><year>2002</year><article-title>Functional genomics of parasitic worms: the dawn of a new era.</article-title><source>Parasitol Int</source><volume>51</volume><fpage>319</fpage><lpage>325</lpage><pub-id pub-id-type="pmid">12421629</pub-id></citation></ref><ref id="pntd.0000246-Boyle1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boyle</surname><given-names>JP</given-names></name><name><surname>Yoshino</surname