ptoms</article-title><source>Endoscopy</source><year>2006</year><volume>38</volume><fpage>376</fpage><lpage>381</lpage><pub-id pub-id-type="pmid">16680637</pub-id></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Raju</surname><given-names>GS</given-names></name></person-group><article-title>Value of screening the laryngopharyngeal area during routine upper gastrointestinal endoscopy</article-title><source>Nat Clin Pract Gastroenterol Hepatol</source><year>2005</year><volume>2</volume><fpage>22</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">16265096</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mullhaupt</surname><given-names>B</given-names></name><name><surname>Jenny</surname><given-names>D</given-names></name><name><surname>Albert</surname><given-names>S</given-names></name><name><surname>Schmid</surname><given-names>S</given-names></name><name><surname>Fried</surname><given-names>M</given-names></name></person-group><article-title>Controlled prospective evaluation of the diagnostic yield of a laryngopharyngeal screening examination during upper gastrointestinal endoscopy</article-title><source>Gut</source><year>2004</year><volume>53</volume><fpage>1232</fpage><lpage>1234</lpage><pub-id pub-id-type="pmid">15306576</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Yarze</surname><given-names>JC</given-names></name><name><surname>Chase</surname><given-names>MP</given-names></name><name><surname>Herlihy</surname><given-names>KJ</given-names></name></person-group><article-title>Laryngopharyngeal examination: an important but not-so-new role of upper gastrointestinal endoscopy</article-title><source>Ann Intern Med</source><year>2000</year><volume>133</volume><fpage>314</fpage><lpage>315</lpage><pub-id pub-id-type="pmid">10929187</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kozarek</surname><given-names>RA</given-names></name></person-group><article-title>Evaluation of the larynx, hypopharynx, and nasopharynx at the time of diagnostic upper gastrointestinal endoscopy</article-title><source>Gastrointest Endosc</source><year>1985</year><volume>31</volume><fpage>271</fpage><lpage>273</lpage><pub-id pub-id-type="pmid">4029577</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lehman</surname><given-names>G</given-names></name><name><surname>Compton</surname><given-names>M</given-names></name><name><surname>Meadows</surname><given-names>J</given-names></name><name><surname>Elmore</surname><given-names>M</given-names></name></person-group><article-title>Screening examination of the larynx and pharynx during upper gastrointestinal panendoscopy</article-title><source>Gastrointest Endosc</source><year>1982</year><volume>28</volume><fpage>176</fpage><lpage>178</lpage><pub-id pub-id-type="pmid">7129039</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Choi</surname><given-names>JH</given-names></name><name><surname>Park</surname><given-names>JJ</given-names></name><name><surname>Jee</surname><given-names>JB</given-names></name><etal/></person-group><article-title>Endoscopic treatment of benign hypopharyngeal tumors</article-title><source>Korean J Gastrointest Endosc</source><year>2005</year><volume>31</volume><fpage>306</fpage><lpage>310</lpage></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-grou