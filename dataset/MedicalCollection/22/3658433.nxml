-id pub-id-type="pmid">22500508</pub-id></element-citation></ref><ref id="b11-ccid-6-127"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kang</surname><given-names>P</given-names></name><name><surname>Tian</surname><given-names>C</given-names></name><name><surname>Jia</surname><given-names>C</given-names></name></person-group><article-title>Association of RAGE gene polymorphisms with type 2 diabetes mellitus, diabetic retinopathy and diabetic nephropathy</article-title><source>Gene</source><year>2012</year><volume>500</volume><issue>1</issue><fpage>1</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">22475522</pub-id></element-citation></ref><ref id="b12-ccid-6-127"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Noordzij</surname><given-names>MJ</given-names></name><name><surname>Mulder</surname><given-names>DJ</given-names></name><name><surname>Oomen</surname><given-names>PH</given-names></name><etal/></person-group><article-title>Skin autofluorescence and risk of micro- and macrovascular complications in patients with Type 2 diabetes mellitus-a multi-centre study</article-title><source>Diabet Med</source><year>2012</year><volume>29</volume><issue>12</issue><fpage>1556</fpage><lpage>1561</lpage><pub-id pub-id-type="pmid">22937960</pub-id></element-citation></ref><ref id="b13-ccid-6-127"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Perkins</surname><given-names>BA</given-names></name><name><surname>Rabbani</surname><given-names>N</given-names></name><name><surname>Weston</surname><given-names>A</given-names></name><etal/></person-group><article-title>Serum levels of advanced glycation endproducts and other markers of protein damage in early diabetic nephropathy in type 1 diabetes</article-title><source>PLoS One</source><year>2012</year><volume>7</volume><issue>4</issue><fpage>e35655</fpage><pub-id pub-id-type="pmid">22558190</pub-id></element-citation></ref><ref id="b14-ccid-6-127"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ramasamy</surname><given-names>R</given-names></name><name><surname>Schmidt</surname><given-names>AM</given-names></name></person-group><article-title>Receptor for advanced glycation end products (RAGE) and implications for the pathophysiology of heart failure</article-title><source>Curr Heart Fail Rep</source><year>2012</year><volume>9</volume><issue>2</issue><fpage>107</fpage><lpage>116</lpage><pub-id pub-id-type="pmid">22457230</pub-id></element-citation></ref><ref id="b15-ccid-6-127"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Quatresooz</surname><given-names>P</given-names></name><name><surname>Pi&#x000e9;rard</surname><given-names>GE</given-names></name></person-group><article-title>Immunohistochemical clues at aging of the skin microvascular unit</article-title><source>J Cutan Pathol</source><year>2009</year><volume>36</volume><issue>1</issue><fpage>39</fpage><lpage>43</lpage><pub-id pub-id-type="pmid">18564281</pub-id></element-citation></ref><ref id="b16-ccid-6-127"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rendell</surname><given-names>M</given-names></name><name><surname>Bamisedun</surname><given-names>O</given-names></name></person-group><article-title>Diabetic cutaneous microangiopathy</article-title><source>Am J Med</source><year>1992</year><volume>93</volume><issue>6</issue><fpage>611</fpage><lpage>618</lpage><pub-id pub-id-type="pmid">1466356</pub-id></element-citation></ref><ref id="b17-ccid-6-127"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kolbe</surname><given-names>M</given-names></n