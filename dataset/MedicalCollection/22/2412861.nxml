b-id><pub-id pub-id-type="doi">10.1002/pmic.200300661</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meier</surname><given-names>M</given-names></name><name><surname>Kaiser</surname><given-names>T</given-names></name><name><surname>Herrmann</surname><given-names>A</given-names></name><name><surname>Knueppel</surname><given-names>S</given-names></name><name><surname>Hillmann</surname><given-names>M</given-names></name><name><surname>Koester</surname><given-names>P</given-names></name><name><surname>Danne</surname><given-names>T</given-names></name><name><surname>Haller</surname><given-names>H</given-names></name><name><surname>Fliser</surname><given-names>D</given-names></name><name><surname>Mischak</surname><given-names>H</given-names></name></person-group><article-title>Identification of urinary protein pattern in type 1 diabetic adolescents with early diabetic nephropathy by a novel combined proteome analysis</article-title><source>J Diabetes Complications</source><year>2005</year><volume>19</volume><fpage>223</fpage><lpage>232</lpage><pub-id pub-id-type="pmid">15993357</pub-id><pub-id pub-id-type="doi">10.1016/j.jdiacomp.2004.10.002</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sharma</surname><given-names>K</given-names></name><name><surname>Lee</surname><given-names>S</given-names></name><name><surname>Han</surname><given-names>S</given-names></name><name><surname>Lee</surname><given-names>S</given-names></name><name><surname>Francos</surname><given-names>B</given-names></name><name><surname>McCue</surname><given-names>P</given-names></name><name><surname>Wassell</surname><given-names>R</given-names></name><name><surname>Shaw</surname><given-names>MA</given-names></name><name><surname>RamachandraRao</surname><given-names>SP</given-names></name></person-group><article-title>Two-dimensional fluorescen