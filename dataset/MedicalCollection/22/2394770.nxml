><surname>Zhang</surname><given-names>J</given-names></name></person-group><article-title>Gene losses during human origins.</article-title><source>PLoS Biol</source><year>2006</year><volume>4</volume><fpage>e52</fpage><pub-id pub-id-type="pmid">16464126</pub-id><pub-id pub-id-type="doi">10.1371/journal.pbio.0040052</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Force</surname><given-names>A</given-names></name><name><surname>Lynch</surname><given-names>M</given-names></name><name><surname>Pickett</surname><given-names>FB</given-names></name><name><surname>Amores</surname><given-names>A</given-names></name><name><surname>Yan</surname><given-names>YL</given-names></name><name><surname>Postlethwait</surname><given-names>J</given-names></name></person-group><article-title>Preservation of duplicate genes by complementary, degenerative mutations.</article-title><source>Genetics</source><year>1999</year><volume>151</volume><fpage>1531</fpage><lpage>1545</lpage><pub-id pub-id-type="pmid">10101175</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ohta</surname><given-names>T</given-names></name></person-group><article-title>Simulating evolution by gene duplication.</article-title><source>Genetics</source><year>1987</year><volume>115</volume><fpage>207</fpage><lpage>213</lpage><pub-id pub-id-type="pmid">3557113</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ohta</surname><given-names>T</given-names></name></person-group><article-title>Role of gene duplication in evolution.</article-title><source>Genome</source><year>1989</year><volume>31</volume><fpage>304</fpage><lpage>310</lpage><pub-id pub-id-type="pmid">2687099</pub-id></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surnam