</lpage><pub-id pub-id-type="pmid">16922239</pub-id></citation></ref><ref id="pone.0002307-Royama1"><label>19</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Royama</surname><given-names>T</given-names></name></person-group><year>1992</year><article-title>Analytical Population Dynamics.</article-title><publisher-loc>London</publisher-loc><publisher-name>Chapman &#x00026; Hall</publisher-name></citation></ref><ref id="pone.0002307-Blondel1"><label>20</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Blondel</surname><given-names>J</given-names></name><name><surname>Aronson</surname><given-names>J</given-names></name></person-group><year>1999</year><article-title>Biology and wildlife of the Mediterranean region.</article-title><publisher-loc>Oxford</publisher-loc><publisher-name>Oxford University Press</publisher-name></citation></ref><ref id="pone.0002307-Madroo1"><label>21</label><citation citation-type="book"><person-group person-group-type="editor"><name><surname>Madro&#x000f1;o</surname><given-names>A</given-names></name><name><surname>Gonz&#x000e1;lez</surname><given-names>C</given-names></name><name><surname>Atienza</surname><given-names>JC</given-names></name></person-group><year>2004</year><article-title>Libro Rojo de las Aves de Espa&#x000f1;a.</article-title><publisher-loc>Madrid</publisher-loc><publisher-name>DGB-SEO/Birdlife</publisher-name><fpage>452</fpage></citation></ref><ref id="pone.0002307-Bostford1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bostford</surname><given-names>LW</given-names></name><name><surname>Methot</surname><given-names>RD</given-names><suffix>Jr</suffix></name><name><surname>Johnston</surname><given-names>WE</given-names></name></person-group><year>1983</year><article-title>Effort dynamics of the northern California Dungeness crab (<italic>Cancer magister</italic>) fishery.</ar