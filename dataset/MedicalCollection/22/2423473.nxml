.1370/afm.47</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Black</surname><given-names>N</given-names></name></person-group><article-title>Using clinical databases in practice</article-title><source>BMJ</source><year>2003</year><volume>326</volume><fpage>2</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">12511432</pub-id><pub-id pub-id-type="doi">10.1136/bmj.326.7379.2</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>R</given-names></name></person-group><article-title>The policies of Cases Journal</article-title><source>Cases J</source><year>2008</year><volume>1</volume><fpage>2</fpage><pub-id pub-id-type="doi">10.1186/1757-1626-1-2</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wald</surname><given-names>NJ</given-names></name><name><surname>Morris</surname><given-names>JK</given-names></name></person-group><article-title>Teleoanalysis: combining data from different types of study</article-title><source>BMJ</source><year>2003</year><volume>327</volume><fpage>616</fpage><lpage>618</lpage><pub-id pub-id-type="pmid">12969936</pub-id><pub-id pub-id-type="doi">10.1136/bmj.327.7415.616</pub-id></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Jadad</surname><given-names>AR</given-names></name><name><surname>Enkin</surname><given-names>MW</given-names></name></person-group><source>Randomized controlled trials: questions, answers and musings</source><year>2007</year><publisher-name>Oxford: Blackwell Publishing</publisher-name></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Surowiecki</surname><given-names>J</given-names></name></person-group><source>The wisdom of crowds</source><year>2004</year><publisher-name>London: Little, Brown</publisher-name></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shneiderman</surname><given-names>B</given-names></name></person-group><article-title>Science 2.0</article-title><source>Science</source><year>2008</year><volume>319</volume><fpage>1349</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">18323442</pub-id><pub-id pub-id-type="doi">10.1126/science.1153539</pub-id></citation></ref><ref id="B18"><citation citation-type="other"><article-title>Sermo homepage</article-title><ext-link ext-link-type="uri" xlink:href="http://www.sermo.com/"/></citation></ref></ref-list></back></article>