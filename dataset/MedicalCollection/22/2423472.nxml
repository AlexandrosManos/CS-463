oup-type="author"><name><surname>Aldana</surname><given-names>M</given-names></name><name><surname>Balleza</surname><given-names>E</given-names></name><name><surname>Kauffman</surname><given-names>S</given-names></name><name><surname>Resendis</surname><given-names>O</given-names></name></person-group><year>2007</year><article-title>Robustness and evolvability in gene regulatory networks.</article-title><source>J Theor Biol</source><volume>245</volume><fpage>433</fpage><lpage>448</lpage><pub-id pub-id-type="pmid">17188715</pub-id></citation></ref><ref id="pone.0002456-Serra1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Serra</surname><given-names>R</given-names></name><name><surname>Villani</surname><given-names>M</given-names></name><name><surname>Semeria</surname><given-names>A</given-names></name></person-group><year>2004</year><article-title>Genetic network models and statistical properties of gene expression data in knock-out experiments.</article-title><source>J Theor Biol</source><volume>227</volume><fpage>149</fpage><lpage>157</lpage><pub-id pub-id-type="pmid">14969713</pub-id></citation></ref><ref id="pone.0002456-Serra2"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Serra</surname><given-names>R</given-names></name><name><surname>Villani</surname><given-names>M</given-names></name><name><surname>Graudenzi</surname><given-names>A</given-names></name><name><surname>Kauffman</surname><given-names>S</given-names></name></person-group><year>2007</year><article-title>Why a simple model of genetic regulatory networks describes the distribution of avalanches in gene expression data.</article-title><source>J Theor Biol</source><volume>246</volume><fpage>449</fpage><lpage>460</lpage><pub-id pub-id-type="pmid">17316697</pub-id></citation></ref><ref id="pone.0002456-Shmulevich1"><label>24</label><citation citation-type="journal"><person-group pers