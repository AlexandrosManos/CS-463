ation></ref><ref id="pone.0002456-Sethna1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sethna</surname><given-names>JP</given-names></name><name><surname>Dahmen K</surname><given-names>A</given-names></name><name><surname>Myers</surname><given-names>CR</given-names></name></person-group><year>2001</year><article-title>Crackling noise.</article-title><source>Nature</source><volume>410</volume><fpage>242</fpage><lpage>250</lpage><pub-id pub-id-type="pmid">11258379</pub-id></citation></ref><ref id="pone.0002456-Kioussis1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kioussis</surname><given-names>D</given-names></name></person-group><year>2005</year><article-title>Kissing chromosomes.</article-title><source>Nature</source><volume>435</volume><fpage>579</fpage><lpage>480</lpage><pub-id pub-id-type="pmid">15931207</pub-id></citation></ref><ref id="pone.0002456-Levine1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Levine</surname><given-names>M</given-names></name><name><surname>Tjian</surname><given-names>R</given-names></name></person-group><year>2003</year><article-title>Transcription regulation and animal diversity.</article-title><source>Nature</source><volume>424</volume><fpage>147</fpage><lpage>151</lpage><pub-id pub-id-type="pmid">12853946</pub-id></citation></ref><ref id="pone.0002456-Kitano1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kitano</surname><given-names>H</given-names></name></person-group><year>2004</year><article-title>Biological robustness.</article-title><source>Nat Rev Genet</source><volume>5</volume><fpage>826</fpage><lpage>837</lpage><pub-id pub-id-type="pmid">15520792</pub-id></citation></ref><ref id="pone.0002456-deVisser1"><label>17</label><citation citation-type="journal"><person-group person-gr