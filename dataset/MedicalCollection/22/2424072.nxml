Medica Mexicana</source><year>1970</year><volume>35</volume><fpage>441</fpage><lpage>446</lpage><pub-id pub-id-type="pmid">4397116</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bustamante</surname><given-names>M</given-names></name></person-group><article-title>Epidemiolog&#x000ed;a del Paludismo en el sur del Valle de Mexico. Zona de Xochimilco</article-title><source>Gaceta M&#x000e9;dica de Mexico</source><year>1939</year><volume>69</volume><fpage>1</fpage><lpage>31</lpage></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Malagon</surname><given-names>F</given-names></name><name><surname>Tapia</surname><given-names>JL</given-names></name><name><surname>Vazquez</surname><given-names>J</given-names></name><name><surname>Robert</surname><given-names>L</given-names></name><name><surname>del Toro</surname><given-names>F</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Koning LO</surname></name></person-group><article-title>The oral transmission of malaria</article-title><source>Progress in malaria research</source><year>2007</year><publisher-name>NY: Nova Publishers</publisher-name></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gladwell</surname><given-names>M</given-names></name></person-group><article-title>Fred Soper and the Global Malaria Eradication Programme</article-title><source>J Public Health Policy</source><year>2002</year><volume>23</volume><fpage>479</fpage><lpage>497</lpage><pub-id pub-id-type="pmid">12532686</pub-id><pub-id pub-id-type="doi">10.2307/3343244</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sachs</surname><given-names>J</given-names></name><name><surname>Malaney</surname><given-names>P</given-names></name></person-group><article-title>The economic and social burden of malaria</article-title><source>Nature</source><year>2002</year><volume>415</volume><fpage>680</fpage><lpage>685</lpage><pub-id pub-id-type="pmid">11832956</pub-id><pub-id pub-id-type="doi">10.1038/415680a</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Faust</surname><given-names>EC</given-names></name></person-group><article-title>Un siglo de malaria en los Estados Unidos</article-title><source>Gaceta M&#x000e9;dica de Mexico</source><year>1950</year><volume>80</volume><fpage>318</fpage><lpage>333</lpage></citation></ref></ref-list></back></article>