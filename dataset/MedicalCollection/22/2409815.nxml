>Science</source><year>1999</year><volume>286</volume><fpage>487</fpage><lpage>491</lpage><!--PubMed citation query: 'Science||286|487||bib16|'--><pub-id pub-id-type="pmid">10521338</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gebhardt</surname><given-names>F</given-names></name><name><surname>Zanker</surname><given-names>KS</given-names></name><name><surname>Brandt</surname><given-names>B</given-names></name></person-group><article-title>Modulation of epidermal growth factor receptor gene transcription by a polymorphic dinucleotide repeat in intron 1</article-title><source>J Biol Chem</source><year>1999</year><volume>274</volume><fpage>13176</fpage><lpage>13180</lpage><!--PubMed citation query: 'J Biol Chem||274|13176||bib17|'--><pub-id pub-id-type="pmid">10224073</pub-id></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goto</surname><given-names>S</given-names></name><name><surname>Iida</surname><given-names>T</given-names></name><name><surname>Cho</surname><given-names>S</given-names></name><name><surname>Oka</surname><given-names>M</given-names></name><name><surname>Kohno</surname><given-names>S</given-names></name><name><surname>Kondo</surname><given-names>T</given-names></name></person-group><article-title>Overexpression of glutathione <italic>S</italic>-transferase pi enhances the adduct formation of cisplatin with glutathione in human cancer cells</article-title><source>Free Radic Res</source><year>1999</year><volume>31</volume><fpage>549</fpage><lpage>558</lpage><!--PubMed citation query: 'Free Radic Res||31|549||bib19|'--><pub-id pub-id-type="pmid">10630679</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gou</surname><given-names>Q</given-names></name><name><surname>Liu</surname><given-names>CH</given-names></name><name><surname>Ben-Av</surname><given-names>P</given-names></name><name><surname>Hla</surname><given-names>T</given-names></name></person-group><article-title>Dissociation of basal turnover and cytokine-induced transcript stabilization of the human cyclooxygenase-2 mRNA by mutagenesis of the 3&#x02032;-untranslated region</article-title><source>Biochem Biophys Res Commun</source><year>1998</year><volume>242</volume><fpage>508</fpage><lpage>512</lpage><!--PubMed citation query: 'Biochem Biophys Res Commun||242|508||bib20|'--><pub-id pub-id-type="pmid">9464246</pub-id></citation></ref><ref id="bib21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harries</surname><given-names>LW</given-names></name><name><surname>Stubbins</surname><given-names>MJ</given-names></name><name><surname>Forman</surname><given-names>D</given-names></name><name><surname>Howard</surname><given-names>GC</given-names></name><name><surname>Wolf</surname><given-names>CR</given-names></name></person-group><article-title>Identification of genetic polymorphisms at the glutathione <italic>S</italic>-transferase pi locus and association with susceptibility to bladder, testicular and prostate cancer</article-title><source>Carcinogenesis</source><year>1997</year><volume>18</volume><fpage>641</fpage><lpage>644</lpage><!--PubMed citation query: 'Carcinogenesis||18|641||bib21|'--><pub-id pub-id-type="pmid">9111193</pub-id></citation></ref><ref id="bib22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Horie</surname><given-names>N</given-names></name><name><surname>Aiba</surname><given-names>H</given-names></name><name><surname>Oguro</surname><given-names>K</given-names></name><name><surname>Hojo</surname><given-names>H</given-names></name><name><surname>Takeishi</surname><given-names>K</given-names></name></person-group><article-title>Functional analysis and DNA polymorphism of the tandemly repeated sequences in the 5&#x02032