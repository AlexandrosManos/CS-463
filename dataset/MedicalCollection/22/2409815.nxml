urnal"><person-group person-group-type="author"><name><surname>Bernstein</surname><given-names>L</given-names></name><name><surname>Anderson</surname><given-names>J</given-names></name><name><surname>Pike</surname><given-names>MC</given-names></name></person-group><article-title>Estimation of the proportional hazard in two-treatment-group clinical trials</article-title><source>Biometrics</source><year>1981</year><volume>37</volume><fpage>513</fpage><lpage>519</lpage><!--PubMed citation query: 'Biometrics||37|513||bib7|'--><pub-id pub-id-type="pmid">7317558</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bleiberg</surname><given-names>H</given-names></name></person-group><article-title>Role of chemotherapy for advanced colorectal cancer: new opportunities</article-title><source>Semin Oncol</source><year>1996</year><volume>23</volume><fpage>42</fpage><lpage>50</lpage><!--PubMed citation query: 'Semin Oncol||23|42||bib8|'--></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Butkiewicz</surname><given-names>D</given-names></name><name><surname>Rusin</surname><given-names>M</given-names></name><name><surname>Harris</surname><given-names>CC</given-names></name><name><surname>Chorazy</surname><given-names>M</given-names></name></person-group><article-title>Identification of four single nucleotide polymorphisms in DNA repair genes: XPA and XPB (ERCC3) in Polish population</article-title><source>Hum Mutat</source><year>2000</year><volume>15</volume><fpage>577</fpage><lpage>578</lpage><!--PubMed citation query: 'Hum Mutat||15|577||bib10|'--></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>CH</given-names></name><name><surname>George</surname><given-names>SL</given-names></name></person-group><article-title>The bootstrap and identification of prognostic factors via Cox's proportional hazards regression model</article-title><source>Stat Med</source><year>1985</year><volume>4</volume><fpage>39</fpage><lpage>46</lpage><!--PubMed citation query: 'Stat Med||4|39||bib11|'--><pub-id pub-id-type="pmid">3857702</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>S</given-names></name><name><surname>Tang</surname><given-names>D</given-names></name><name><surname>Xue</surname><given-names>K</given-names></name><name><surname>Xu</surname><given-names>L</given-names></name><name><surname>Ma</surname><given-names>G</given-names></name><name><surname>Hsu</surname><given-names>Y</given-names></name><name><surname>Cho</surname><given-names>SS</given-names></name></person-group><article-title>DNA repair gene XRCC1 and XPD polymorphisms and risk of lung cancer in a Chinese population</article-title><source>Carcinogenesis</source><year>2002</year><volume>23</volume><fpage>1321</fpage><lpage>1325</lpage><!--PubMed citation query: 'Carcinogenesis||23|1321||bib12|'--><pub-id pub-id-type="pmid">12151350</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dybdahl</surname><given-names>M</given-names></name><name><surname>Vogel</surname><given-names>U</given-names></name><name><surname>Frentz</surname><given-names>G</given-names></name><name><surname>Wallin</surname><given-names>H</given-names></name><name><surname>Nexo</surname><given-names>BA</given-names></name></person-group><article-title>Polymorphisms in the DNA repair gene XPD: correlations with risk and age at onset of basal cell carcinoma</article-title><source>Cancer Epidemiol Biomarkers Prev</source><year>1999</year><volume>8</volume><fpage>77</fpage><lpage>81</lpage><!--PubMed citation query: 'Cancer Epidemiol Biomarkers Prev||8|77||bib14|'--><pub-id pub-id-type="pmid">