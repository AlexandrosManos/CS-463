olume>192</volume><fpage>931</fpage><lpage>941</lpage><!--PubMed citation query: 'Path Res Pract||192|931||bib10|'--><pub-id pub-id-type="pmid">8950760</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Contesso</surname><given-names>G</given-names></name><name><surname>Mouriesse</surname><given-names>H</given-names></name><name><surname>Friedman</surname><given-names>S</given-names></name><name><surname>Genin</surname><given-names>J</given-names></name><name><surname>Sarrazin</surname><given-names>D</given-names></name><name><surname>Rouesse</surname><given-names>J</given-names></name></person-group><article-title>The importance of histologic grade in long-term prognosis of breast cancer; a study of 1,010 patients, uniformly treated at the Institut Gustave-Roussy</article-title><source>J Clin Oncol</source><year>1987</year><volume>5</volume><fpage>1378</fpage><lpage>1386</lpage><!--PubMed citation query: 'J Clin Oncol||5|1378||bib11|'--><pub-id pub-id-type="pmid">3625256</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Contesso</surname><given-names>G</given-names></name><name><surname>Jotti</surname><given-names>GS</given-names></name><name><surname>Bonadonna</surname><given-names>G</given-names></name></person-group><article-title>Tumour grade as a prognostic factor in primary breast cancer</article-title><source>Eur J Cancer Clin Oncol</source><year>1989</year><volume>25</volume><fpage>403</fpage><lpage>409</lpage><!--PubMed citation query: 'Eur J Cancer Clin Oncol||25|403||bib12|'--><pub-id pub-id-type="pmid">2649377</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cutler</surname><given-names>SJ</given-names></name><name><surname>Ederer</surname><given-names>F</given-names></name></person-group><article-title>Maximum utilisation of the life table method in analysing survival</article-title><source>J Chron Dis</source><year>1958</year><volume>8</volume><fpage>699</fpage><lpage>712</lpage><!--PubMed citation query: 'J Chron Dis||8|699||bib13|'--></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Davis</surname><given-names>BW</given-names></name><name><surname>Gelber</surname><given-names>RD</given-names></name><name><surname>Goldhirsch</surname><given-names>A</given-names></name><name><surname>Hartmann</surname><given-names>WH</given-names></name><name><surname>Locher</surname><given-names>GW</given-names></name><name><surname>Reed</surname><given-names>R</given-names></name><name><surname>Golough</surname><given-names>R</given-names></name><name><surname>S&#x000e4;ve-S&#x000f6;derbergh</surname><given-names>J</given-names></name><name><surname>Holloway</surname><given-names>L</given-names></name><name><surname>Russell</surname><given-names>I</given-names></name><name><surname>Rudenstam</surname><given-names>CM</given-names></name></person-group><article-title>Prognostic significance of tumour grade in clinical trails of adjuvant therapy for breast cancer with axillary lymph node metastasis</article-title><source>Cancer</source><year>1986</year><volume>58</volume><fpage>2662</fpage><lpage>2670</lpage><!--PubMed citation query: 'Cancer||58|2662||bib14|'--><pub-id pub-id-type="pmid">3536070</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Elston</surname><given-names>CW</given-names></name><name><surname>Gresham</surname><given-names>GA</given-names></name><name><surname>Rao</surname><given-names>GS</given-names></name><name><surname>Zebro</surname><given-names>T</given-names></name><name><surname>Haybittle</surname><given-names>JL</given-names></name><name><surname>Houghton</surname><given-names>J</given-names></name><name><surname>