on citation-type="journal"><person-group person-group-type="author"><name><surname>Singh</surname><given-names>GK</given-names></name><name><surname>Hiatt</surname><given-names>RA</given-names></name></person-group><volume>35</volume><issue>4</issue><year>2006</year><fpage>903</fpage><lpage>919</lpage><article-title>Trends and disparities in socioeconomic and behavioural characteristics, life expectancy, and cause-specific mortality of native-born and foreign-born populations in the United States, 1979&#x02013;2003</article-title><source>Int J Epidemiol</source><pub-id pub-id-type="pmid">16709619</pub-id></citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goel</surname><given-names>MS</given-names></name><name><surname>McCarthy</surname><given-names>EP</given-names></name><name><surname>Phillips</surname><given-names>RS</given-names></name><name><surname>Wee</surname><given-names>CC</given-names></name></person-group><volume>292</volume><issue>23</issue><year>2004</year><fpage>2860</fpage><lpage>2867</lpage><article-title>Obesity among U.S. immigrant subgroups by duration of residence</article-title><source>JAMA</source><pub-id pub-id-type="pmid">15598917</pub-id></citation></ref><ref id="B17"><label>17</label><citation citation-type="book"><year>1997</year><publisher-loc>New York (NY)</publisher-loc><publisher-name>Regional Plan Association of New York, New Jersey, and Connecticut</publisher-name><source>Building transit-friendly communities: a design and development strategy for the tri-state metropolitan region</source></citation></ref><ref id="B18"><label>18</label><citation citation-type="book"><year>2000</year><publisher-loc>New York (NY)</publisher-loc><publisher-name>New York Department of City Planning</publisher-name><source>The newest New Yorkers 2000: immigrant New York in the new millennium</source></citation></ref><ref id="B19"><label>19</label><citation citation-type