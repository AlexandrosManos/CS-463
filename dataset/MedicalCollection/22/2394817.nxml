1" align="left" valign="top">Wilson plot <italic>B</italic> factor (&#x000c5;<sup>2</sup>)</td><td rowspan="1" colspan="1" align="left" valign="top">15.7</td></tr><tr><td rowspan="1" colspan="1" align="left" charoff="50" valign="top">&#x000a0;</td><td rowspan="1" colspan="1" align="left" charoff="50" valign="top">&#x000a0;</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top">Refinement statistics</td><td rowspan="1" colspan="1" align="left" valign="top">&#x000a0;</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top">Resolutions (&#x000c5;)</td><td rowspan="1" colspan="1" align="left" valign="top">20.0&#x02013;1.35</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top">No. of reflections</td><td rowspan="1" colspan="1" align="left" valign="top">76&#x02005;990</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top"><italic>R</italic> factor/<italic>R</italic><sub>free</sub><xref ref-type="table-fn" rid="tfn2">&#x02021;</xref></td><td rowspan="1" colspan="1" align="left" valign="top">0.182/0.211</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top">R.m.s.d. bonds (&#x000c5;)</td><td rowspan="1" colspan="1" align="left" valign="top">0.015</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top">R.m.s.d. angles (&#x000b0;)</td><td rowspan="1" colspan="1" align="left" valign="top">1.545</td></tr></tbody></table><table-wrap-foot><fn id="tfn1"><label>&#x02020;</label><p>                     <inline-formula><inline-graphic xlink:href="s-15-00285-efi1.jpg" mimetype="image" mime-subtype="gif"/></inline-formula>, where &#x02329;<italic>I</italic>(<bold>h</bold>)&#x0232a; is the average intensity of reflection <bold>h</bold> and symmetry-related reflections.</p></fn><fn id="tfn2"><label>&#x02021;</label><p>                     <inline-formula><inline-graphic xlink:href="s-15-00285-efi2.jpg" mimetype="image" mime-subtype="gif"/></inline-formula>, calculated for the reflections of the working and test (5%) se