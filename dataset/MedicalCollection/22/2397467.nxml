mixed-citation publication-type="journal">Evans, R. J., Lewis, C., Virginio, C., Lundstrom, K., Buell, G., Surprenant, A., and North, R. A. (<year>1996</year>) <source>J. Physiol.</source> <volume>497</volume> <fpage>413</fpage>-422<pub-id pub-id-type="pmid">8961184</pub-id></mixed-citation></ref><ref id="ref10"><label>10</label><mixed-citation publication-type="journal">Gever, J. R., Cockayne, D. A., Dillon, M. P., Burnstock, G., and Ford, A. P. (<year>2006</year>) <source>Pflugers. Arch. Eur. J. Physiol.</source> <volume>452</volume> <fpage>513</fpage>-537<pub-id pub-id-type="pmid">16649055</pub-id></mixed-citation></ref><ref id="ref11"><label>11</label><mixed-citation publication-type="journal">Virginio, C., MacKenzie, A., North, R. A., and Surprenant, A. (<year>1999</year>) <source>J. Physiol.</source> <volume>519</volume> <fpage>335</fpage>-346<pub-id pub-id-type="pmid">10457053</pub-id></mixed-citation></ref><ref id="ref12"><label>12</label><mixed-citation publication-type="journal">Egan, T. M., Samways, D. S., and Li, Z. (<year>2006</year>) <source>Pflugers. Arch. Eur. J. Physiol.</source> <volume>452</volume> <fpage>501</fpage>-512<pub-id pub-id-type="pmid">16708237</pub-id></mixed-citation></ref><ref id="ref13"><label>13</label><mixed-citation publication-type="journal">Migita, K., Haines, W. R., Voigt, M. M., and Egan, T. M. (<year>2001</year>) <source>J. Biol. Chem.</source> <volume>276</volume> <fpage>30934</fpage>-30941<pub-id pub-id-type="pmid">11402044</pub-id></mixed-citation></ref><ref id="ref14"><label>14</label><mixed-citation publication-type="journal">Kim, S. Y., Sivaguru, M., and Stacey, G. (<year>2006</year>) <source>Plant Physiol.</source> <volume>142</volume> <fpage>984</fpage>-992<pub-id pub-id-type="pmid">16963521</pub-id></mixed-citation></ref><ref id="ref15"><label>15</label><mixed-citation publication-type="journal">Chaumont, S., Jiang, L. H., Penna, A., North, R. A., and Rassendren, F. (<year>2004</year>) <source>J. Biol. Chem.</source> <volume>279</volume> <fpage>29628</fpage>-296238<pub-id pub-id-type="pmid">15126501</pub-id></mixed-citation></ref><ref id="ref16"><label>16</label><mixed-citation publication-type="journal">Surprenant, A., Rassendren, F., Kawashima, E., North, R. A., and Buell, G. (<year>1996</year>) <source>Science</source> <volume>272</volume> <fpage>735</fpage>-738<pub-id pub-id-type="pmid">8614837</pub-id></mixed-citation></ref><ref id="d31e1515"><label>17</label><mixed-citation publication-type="other">Deleted in proof</mixed-citation></ref><ref id="ref18"><label>18</label><mixed-citation publication-type="journal">Samways, D. S., and Egan, T. M. (<year>2007</year>) <source>J. Gen. Physiol.</source> <volume>129</volume> <fpage>245</fpage>-256<pub-id pub-id-type="pmid">17325195</pub-id></mixed-citation></ref><ref id="ref19"><label>19</label><mixed-citation publication-type="journal">Silberberg, S. D., Chang, T. H., and Swartz, K. J. (<year>2005</year>) <source>J. Gen. Physiol.</source> <volume>125</volume> <fpage>347</fpage>-359<pub-id pub-id-type="pmid">15795310</pub-id></mixed-citation></ref><ref id="ref20"><label>20</label><mixed-citation publication-type="journal">Chen, G. Q., Cui, C., Mayer, M. L., and Gouaux, E. (<year>1999</year>) <source>Nature</source> <volume>402</volume> <fpage>817</fpage>-821<pub-id pub-id-type="pmid">10617203</pub-id></mixed-citation></ref><ref id="ref21"><label>21</label><mixed-citation publication-type="journal">Bocquet, N., Prado de Carvalho, L., Cartaud, J., Neyton, J., Le Poupon, C., Taly, A., Grutter, T., Changeux, J. P., and Corringer, P. J. (<year>2007</year>) <source>Nature</source> <volume>445</volume> <fpage>116</fpage>-119<pub-id pub-id-type="pmid">17167423</pub-id></mixed-citation></ref></ref-list><fn-group><fn id="fn3"><label>2</label><p>The abbreviations used are: HEK293, human embryonic kidney 293; PPADS, pyridoxal-phosphate-6-azophenyl-2&#x02032;,4&#x02032;-disulfonic acid.</p></fn><fn id="fn4"><label>3</label><p>S. J. Fountain, 