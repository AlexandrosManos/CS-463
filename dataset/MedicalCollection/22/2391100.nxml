<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article article-type="correction"><?properties open_access?><!-- Original-type: cg--><front><journal-meta><journal-id journal-id-type="nlm-ta">Br J Cancer</journal-id><journal-title>British Journal of Cancer</journal-title><issn pub-type="ppub">0007-0920</issn><issn pub-type="epub">1532-1827</issn><publisher><publisher-name>Nature Publishing Group</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmc">2391100</article-id><article-id pub-id-type="pii">6604403</article-id><article-id pub-id-type="doi">10.1038/sj.bjc.6604403</article-id><article-categories><subj-group subj-group-type="heading"><subject>Corrigenda</subject></subj-group></article-categories><title-group><article-title>Prevalence of human papillomavirus antibodies in young female subjects in England</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Jit</surname><given-names>M</given-names></name></contrib><contrib contrib-type="author"><name><surname>Vyse</surname><given-names>A</given-names></name></contrib><contrib contrib-type="author"><name><surname>Borrow</surname><given-names>R</given-names></name></contrib><contrib contrib-type="author"><name><surname>Pebody</surname><given-names>R</given-names></name></contrib><contrib contrib-type="author"><name><surname>Soldan</surname><given-names>K</given-names></name></contrib><contrib contrib-type="author"><name><surname>Miller</surname><given-names>E</given-names></name></contrib></contrib-group><pub-date pub-type="epub"><day>05</day><month>05</month><year>2008</year></pub-date><pub-date pub-type="ppub"><day>06</day><month>05</month><year>2008</year></pub-date><volume>98</volume><issue>9</issue><fpage>1595</fpage><lpage>1595</lpage><copyright-statement>Copyright 2008, Cancer Research UK</copyright-statement><copyright-year>2008</copyright-year><permissions><copyright-holder>Cancer Research UK</copyright-holder></permissions></article-meta></front><body><p><bold>Correction to</bold>: <italic>British Journal of Cancer</italic> (2007) <bold>97</bold>, 989&#x02013;991. doi: <related-article related-article-type="corrected-article" id="N0x1c3e650N0x3423f80" ext-link-type="doi" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="10.1038/sj.bjc.6603955">10.1038/sj.bjc.6603955</related-article></p><p>There was an error in the second paragraph, last sentence, of the Materials and Methods section of this paper, published in Volume 97, Number 7 (October 2007).</p><p>The corrected sentence should read:</p><p>Sera were assumed to be seropositive at the cutoffs determined in previous work with this assay (Dias <italic>et al</italic>., 2005): 20, 16, 20 and 24&#x02009;mMUml for HPV 6, 11, 16 and 18, respectively.</p></body></article>