pub-id-type="pmid">11233720</pub-id><pub-id pub-id-type="doi">10.1046/j.1440-0960.2001.00471.x</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Langer</surname><given-names>M</given-names></name><name><surname>Langer</surname><given-names>R</given-names></name><name><surname>Friedrich</surname><given-names>JM</given-names></name></person-group><article-title>Congenital angiodysplasia of types F.P. Weber, Klippel-Trenaunay and Servelle-Martorell</article-title><source>J Mal Vasc</source><year>1982</year><volume>7</volume><fpage>317</fpage><lpage>324</lpage><pub-id pub-id-type="pmid">6298332</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Langer</surname><given-names>M</given-names></name><name><surname>Langer</surname><given-names>R</given-names></name></person-group><article-title>Radiologic aspects of the congenital arteriovenous malformations, Klippel-Trenaunay type, and Servelle-Martorell type</article-title><source>Rofo</source><year>1982</year><volume>136</volume><fpage>577</fpage><lpage>582</lpage><pub-id pub-id-type="pmid">6284617</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Angel</surname><given-names>C</given-names></name><name><surname>Yngve</surname><given-names>D</given-names></name><name><surname>Murillo</surname><given-names>C</given-names></name><name><surname>Hendrick</surname><given-names>E</given-names></name><name><surname>Adegboyega</surname><given-names>P</given-names></name><name><surname>Swischuk</surname><given-names>L</given-names></name></person-group><article-title>Surgical treatment of vascular malformations of the extremities in children and adolescents</article-title><source>Pediatr Surg Int</source><year>2002</year><volume>18</volume><fpage>213</fpage><lpage>217</lpage><pub-id pub-id-type="pmid">11956804</pub-id><pub-id pub-id-type="doi">10.1007/s003830100636</pub-id></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cliff</surname><given-names>SH</given-names></name><name><surname>Mortimer</surname><given-names>OS</given-names></name></person-group><article-title>Disorders of lymphatics</article-title><source>Textbook of Pediatric Dermatology</source><year>2000</year><publisher-name>Oxford: Blackwell Science</publisher-name><fpage>1017</fpage><lpage>1034</lpage></citation></ref></ref-list></back></article>