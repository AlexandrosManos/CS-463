ar="." charoff="50" valign="top">&#x000a0;</td><td rowspan="1" colspan="1" align="char" char="." charoff="50" valign="top">&#x000a0;</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top">&#x02003;&#x02003;Molecule 1</td><td rowspan="1" colspan="1" align="char" char="." charoff="50" valign="top">6.4</td><td rowspan="1" colspan="1" align="char" char="." charoff="50" valign="top">17.3</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top">&#x000a0;</td><td rowspan="1" colspan="1" align="char" char="." charoff="50" valign="top">5.2</td><td rowspan="1" colspan="1" align="char" char="." charoff="50" valign="top">12.3</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top">&#x02003;&#x02003;Molecule 2</td><td rowspan="1" colspan="1" align="char" char="." charoff="50" valign="top">3.6</td><td rowspan="1" colspan="1" align="char" char="." charoff="50" valign="top">5.9</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top">&#x02003;Run 2<xref ref-type="table-fn" rid="tfn1">&#x02020;</xref></td><td rowspan="1" colspan="1" align="char" char="." charoff="50" valign="top">&#x000a0;</td><td rowspan="1" colspan="1" align="char" char="." charoff="50" valign="top">&#x000a0;</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top">&#x02003;&#x02003;Molecule 2</td><td rowspan="1" colspan="1" align="char" char="." charoff="50" valign="top">&#x000a0;</td><td rowspan="1" colspan="1" align="char" char="." charoff="50" valign="top">25.5</td></tr></tbody></table><table-wrap-foot><fn id="tfn1"><label>&#x02020;</label><p>The orientation and position of molecule 1 and the orientation of molecule 2 are fixed.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>