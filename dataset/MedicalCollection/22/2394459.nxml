Physiol</source><year>1999</year><volume>276</volume><fpage>F398</fpage><lpage>408</lpage><!--PubMed citation query: 'Am J Physiol||276|F398||bib6|'--><pub-id pub-id-type="pmid">10070163</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Engelman</surname><given-names>JA</given-names></name><name><surname>Zang</surname><given-names>XL</given-names></name><name><surname>Galbiati</surname><given-names>F</given-names></name><name><surname>Lisanti</surname><given-names>MP</given-names></name></person-group><article-title>Genes encoding human caveolin-1 and 2 are located to the D7S522 locus (7q31.1) a known fragile site that is frequently deleted in human cancers</article-title><source>FEBS Lett</source><year>1999</year><volume>436</volume><fpage>403</fpage><lpage>410</lpage><!--PubMed citation query: 'FEBS Lett||436|403||bib7|'--><pub-id pub-id-type="pmid">9801158</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fine</surname><given-names>SW</given-names></name><name><surname>Lisanti</surname><given-names>MP</given-names></name><name><surname>Galbiati</surname><given-names>F</given-names></name><name><surname>Li</surname><given-names>M</given-names></name></person-group><article-title>Elevated expression of caveolin-1 in adenocarcinoma of the colon</article-title><source>Am J Clin Pathol</source><year>2001</year><volume>115</volume><fpage>719</fpage><lpage>724</lpage><!--PubMed citation query: 'Am J Clin Pathol||115|719||bib8|'--><pub-id pub-id-type="pmid">11345836</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fuhrman</surname><given-names>SA</given-names></name><name><surname>Lasky</surname><given-names>LC</given-names></name><name><surname>Limas</surname><given-names>C</given-names></name></person-group><article-title>Prognostic significance of morphologic parameters in renal cell carcinoma</article-title><source>Am J Surg Pathol</source><year>1982</year><volume>6</volume><fpage>655</fpage><lpage>663</lpage><!--PubMed citation query: 'Am J Surg Pathol||6|655||bib9|'--><pub-id pub-id-type="pmid">7180965</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Glenney</surname><given-names>JR</given-names><suffix>Jr</suffix></name></person-group><article-title>Tyrosine phosphorylation of a 22-kDa protein is correlated with transformation by Rous sarcoma virus</article-title><source>J Biol Chem</source><year>1989</year><volume>264</volume><fpage>20163</fpage><lpage>20166</lpage><!--PubMed citation query: 'J Biol Chem||264|20163||bib10|'--><pub-id pub-id-type="pmid">2479645</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Griffiths</surname><given-names>DFR</given-names></name><name><surname>Verghese</surname><given-names>A</given-names></name><name><surname>Golash</surname><given-names>A</given-names></name><name><surname>Kynaston</surname><given-names>HG</given-names></name><name><surname>Matthews</surname><given-names>PN</given-names></name><name><surname>Hart</surname><given-names>AJ</given-names></name><name><surname>Court</surname><given-names>JB</given-names></name></person-group><article-title>Contribution of grade, vascular invasion and age to outcome in clinically localized renal cell carcinoma</article-title><source>BJU Int</source><year>2002</year><volume>90</volume><fpage>26</fpage><lpage>31</lpage><!--PubMed citation query: 'BJU Int||90|26||bib11|'--><pub-id pub-id-type="pmid">12081764</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ho</surname><given-names>CC</given-names></name><name><surname>Huang</surname><given-names>PH</given-names></name>