on-group><source>Immunobiology: The Immune System in Health and Disease</source><year>1999</year><publisher-name>London: Current Biology Publications, Elsevier Science</publisher-name></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Forgie</surname><given-names>IM</given-names></name><name><surname>KP</surname><given-names>O'Neill</given-names></name><name><surname>Lloyd-Evans</surname><given-names>N</given-names></name><name><surname>Leinonen</surname><given-names>M</given-names></name><name><surname>Campbell</surname><given-names>H</given-names></name><name><surname>Whittle</surname><given-names>HC</given-names></name><name><surname>Greenwood</surname><given-names>BM</given-names></name></person-group><article-title>Etiology of acute lower respiratory tract infections in Gambian children: I. Acute lower respiratory tract infections in infants presenting at the hospital</article-title><source>Pediatr Infect Dis J</source><year>1991</year><volume>10</volume><fpage>33</fpage><lpage>41</lpage><pub-id pub-id-type="pmid">1848364</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rowland</surname><given-names>MGM</given-names></name><name><surname>Goh</surname><given-names>SGJ</given-names></name><name><surname>Williams</surname><given-names>K</given-names></name><name><surname>Campbell</surname><given-names>AD</given-names></name><name><surname>Beards</surname><given-names>GM</given-names></name><name><surname>Sanders</surname><given-names>RC</given-names></name><name><surname>Flewett</surname><given-names>TH</given-names></name></person-group><article-title>Epidemiological aspects of rotavirus infection in young Gambian children</article-title><source>Ann Trop Paediatr</source><year>1985</year><volume>5</volume><fpage>23</fpage><lpage>28</lpage><pub-id pub-id-type="pmid">2409894</pub-id></citation></ref><ref id="B17"><cit