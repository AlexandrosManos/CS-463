><article-title>Biochemical markers and skeletal metastases</article-title><source>Cancer</source><year>2000</year><volume>88</volume><fpage>2919</fpage><lpage>2926</lpage><!--PubMed citation query: 'Cancer||88|2919||bib9|'--><pub-id pub-id-type="pmid">10898335</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eyre</surname><given-names>D</given-names></name></person-group><article-title>New biomarkers of bone resorption</article-title><source>J Clin Endocrinol Metab</source><year>1992</year><volume>74</volume><fpage>470A</fpage><lpage>470C</lpage><!--PubMed citation query: 'J Clin Endocrinol Metab||74|470A||bib10|'--></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fontana</surname><given-names>A</given-names></name><name><surname>Delmas</surname><given-names>PD</given-names></name></person-group><article-title>Markers of bone turnover in bone metastases</article-title><source>Cancer</source><year>2000</year><volume>88</volume><fpage>2952</fpage><lpage>2960</lpage><!--PubMed citation query: 'Cancer||88|2952||bib11|'--><pub-id pub-id-type="pmid">10898339</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hofele</surname><given-names>C</given-names></name><name><surname>Schwager-Schmitt</surname><given-names>M</given-names></name><name><surname>Volkmann</surname><given-names>M</given-names></name></person-group><article-title>Prognostic value of antibodies against p53 in patients with oral squamous cell carcinoma &#x02013; five years survival rate</article-title><source>Laryngorhinootologie</source><year>2002</year><volume>81</volume><fpage>342</fpage><lpage>345</lpage><!--PubMed citation query: 'Laryngorhinootologie||81|342||bib12|'--><pub-id pub-id-type="pmid">12001023</pub-id></citation></ref><ref id="bib13"><citation citation-type="