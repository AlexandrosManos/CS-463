lpage>172</lpage><pub-id pub-id-type="pmid">11958498</pub-id><pub-id pub-id-type="doi">10.1177/02729890222063044</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gajewski</surname><given-names>BJ</given-names></name><name><surname>Petroski</surname><given-names>G</given-names></name><name><surname>Thompson</surname><given-names>S</given-names></name><name><surname>Dunton</surname><given-names>N</given-names></name><name><surname>Wrona</surname><given-names>M</given-names></name><name><surname>Becker</surname><given-names>A</given-names></name><name><surname>Coffland</surname><given-names>V</given-names></name></person-group><article-title>Letter to the editor: the effect of provider-level ascertainment bias on profiling nursing homes by Roy J, Mor V</article-title><source>Statistics in Medicine</source><year>2006</year><volume>25</volume><fpage>1976</fpage><lpage>1977</lpage><pub-id pub-id-type="pmid">16680802</pub-id><pub-id pub-id-type="doi">10.1002/sim.2480</pub-id></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>DeGroot</surname><given-names>MH</given-names></name></person-group><source>Optimal Statistical Decisions</source><year>1970</year><publisher-name>New York, NY: McGraw-Hill</publisher-name></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Berger</surname><given-names>JO</given-names></name></person-group><source>Statistical Decision Theory and Bayesian Analysis</source><year>1980</year><publisher-name>New York, NY: Springer-Verlag</publisher-name></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tu</surname><given-names>JV</given-names></name><name><surname>Naylor</surname><given-names>CD</given-names></name><name><surname>Austin</surname><given-names>P</given-names></nam