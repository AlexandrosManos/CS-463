lign="char" valign="top" char="." charoff="50">48.3</td><td align="char" valign="top" char="." charoff="50">11.9</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;1995</td><td align="char" valign="top" char="." charoff="50">2267</td><td align="char" valign="top" char="." charoff="50">47.2</td><td align="char" valign="top" char="." charoff="50">9.2</td><td align="char" valign="top" char="." charoff="50">444</td><td align="char" valign="top" char="." charoff="50">44.6</td><td align="char" valign="top" char="." charoff="50">4.3</td><td align="char" valign="top" char="." charoff="50">2711</td><td align="char" valign="top" char="." charoff="50">46.7</td><td align="char" valign="top" char="." charoff="50">8.4</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;1996</td><td align="char" valign="top" char="." charoff="50">2375</td><td align="char" valign="top" char="." charoff="50">49.2</td><td align="char" valign="top" char="." charoff="50">14.0</td><td align="char" valign="top" char="." charoff="50">516</td><td align="char" valign="top" char="." charoff="50">51.5</td><td align="char" valign="top" char="." charoff="50">20.4</td><td align="char" valign="top" char="." charoff="50">2891</td><td align="char" valign="top" char="." charoff="50">49.6</td><td align="char" valign="top" char="." charoff="50">15.1</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;1997</td><td align="char" valign="top" char="." charoff="50">2376</td><td align="char" valign="top" char="." charoff="50">49.6</td><td align="char" valign="top" char="." charoff="50">14.8</td><td align="char" valign="top" char="." charoff="50">509</td><td align="char" valign="top" char="." charoff="50">51.1</td><td align="char" valign="top" char="." charoff="50">19.6</td><td align="char" valign="top" char="." charoff="50">2885</td><td align="char" valign="top" char="." charoff="50">49.9</td><td align="char" valign="top" char="." charoff="50">15.6</td></tr><tr><td align="left" valign