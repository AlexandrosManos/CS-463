ed citation query: 'Mol Cell Biol||16|2445||bib8|'--><pub-id pub-id-type="pmid">8628312</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coggi</surname><given-names>G</given-names></name><name><surname>Bosari</surname><given-names>S</given-names></name><name><surname>Roncalli</surname><given-names>M</given-names></name><name><surname>Graziani</surname><given-names>D</given-names></name><name><surname>Bossi</surname><given-names>P</given-names></name><name><surname>Viale</surname><given-names>G</given-names></name><name><surname>Buffa</surname><given-names>R</given-names></name><name><surname>Ferrero</surname><given-names>S</given-names></name><name><surname>Piazza</surname><given-names>M</given-names></name><name><surname>Blandamura</surname><given-names>S</given-names></name><name><surname>Segalin</surname><given-names>A</given-names></name><name><surname>Bonavina</surname><given-names>L</given-names></name><name><surname>Peracchia</surname><given-names>A</given-names></name></person-group><article-title>p53 protein accumulation and p53 gene mutation in esophageal carcinoma</article-title><source>Cancer</source><year>1997</year><volume>79</volume><fpage>425</fpage><lpage>432</lpage><!--PubMed citation query: 'Cancer||79|425||bib9|'--><pub-id pub-id-type="pmid">9028350</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Conio</surname><given-names>M</given-names></name><name><surname>Cameron</surname><given-names>AJ</given-names></name><name><surname>Romero</surname><given-names>Y</given-names></name><name><surname>Branch</surname><given-names>CD</given-names></name><name><surname>Schleck</surname><given-names>CD</given-names></name><name><surname>Burgart</surname><given-names>LJ</given-names></name><name><surname>Zinsmeister</surname><given-names>AR</given-names></name><name><surname>Melton</surname><given-n