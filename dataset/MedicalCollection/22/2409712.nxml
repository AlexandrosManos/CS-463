n-names></name></person-group><article-title>Heterodimerization of endothelin-converting enzyme-1 isoforms regulates the subcellular distribution of this metalloprotease</article-title><source>J Biol Chem</source><year>2003</year><volume>278</volume><fpage>545</fpage><lpage>555</lpage><!--PubMed citation query: 'J Biol Chem||278|545||bib10|'--><pub-id pub-id-type="pmid">12393864</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nelson</surname><given-names>JB</given-names></name><name><surname>Hedican</surname><given-names>SP</given-names></name><name><surname>George</surname><given-names>DJ</given-names></name><name><surname>Reddi</surname><given-names>AH</given-names></name><name><surname>Piantadosi</surname><given-names>S</given-names></name><name><surname>Eisenberger</surname><given-names>MA</given-names></name><name><surname>Simons</surname><given-names>JW</given-names></name></person-group><article-title>Identification of endothelin-1 in the pathophysiology of metastatic adenocarcinoma of the prostate</article-title><source>Nat Med</source><year>1995</year><volume>1</volume><fpage>944</fpage><lpage>949</lpage><!--PubMed citation query: 'Nat Med||1|944||bib11|'--><pub-id pub-id-type="pmid">7585222</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Papandreou</surname><given-names>CN</given-names></name><name><surname>Usmani</surname><given-names>B</given-names></name><name><surname>Geng</surname><given-names>YP</given-names></name><name><surname>Bogenrieder</surname><given-names>T</given-names></name><name><surname>Freeman</surname><given-names>R</given-names></name><name><surname>Wilk</surname><given-names>S</given-names></name><name><surname>Finstad</surname><given-names>CL</given-names></name><name><surname>Reuter</surname><given-names>VE</given-names></name><name><surname>Powell</surname><given-name