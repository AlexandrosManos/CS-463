>6239</lpage><pub-id pub-id-type="pmid">9572837</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Christensen</surname><given-names>L</given-names></name><name><surname>Fitzpatrick</surname><given-names>R</given-names></name><name><surname>Gildea</surname><given-names>B</given-names></name><name><surname>Petersen</surname><given-names>KH</given-names></name><name><surname>Hansen</surname><given-names>HF</given-names></name><name><surname>Koch</surname><given-names>T</given-names></name><name><surname>Egholm</surname><given-names>M</given-names></name><name><surname>Buchardt</surname><given-names>O</given-names></name><name><surname>Nielsen</surname><given-names>PE</given-names></name><name><surname>Coull</surname><given-names>J</given-names></name><etal/></person-group><article-title>Solid-phase synthesis of peptide nucleic acids</article-title><source>J. Pept. Sci.</source><year>1995</year><volume>1</volume><fpage>175</fpage><lpage>183</lpage><pub-id pub-id-type="pmid">9222994</pub-id></element-citation></ref><ref id="B19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Genet</surname><given-names>JP</given-names></name><name><surname>Uziel</surname><given-names>J</given-names></name><name><surname>Port</surname><given-names>M</given-names></name><name><surname>Touzin</surname><given-names>AM</given-names></name><name><surname>Roland</surname><given-names>S</given-names></name><name><surname>Thorimbert</surname><given-names>S</given-names></name><name><surname>Tainer</surname><given-names>S</given-names></name></person-group><article-title>A practical synthesis of &#x003b1;-aminophosphonic acids</article-title><source>Tetrahedron. Lett.</source><year>1992</year><volume>33</volume><fpage>77</fpage><lpage>80</lpage></element-citation></ref><ref id="B20"><label>20</label><element-citati