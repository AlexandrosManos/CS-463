-type="pmid">16306470</pub-id></citation></ref><ref id="b20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dahmen</surname><given-names>N</given-names></name><name><surname>Marx</surname><given-names>J</given-names></name><name><surname>Hopf</surname><given-names>HC</given-names></name><etal/></person-group><article-title>Therapy of early poststroke depression with venlafaxine: safety, tolerability, and efficacy as determined in an open, uncontrolled clinical trial</article-title><source>Stroke</source><year>1999</year><volume>30</volume><fpage>691</fpage><lpage>2</lpage><pub-id pub-id-type="pmid">10066874</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dam</surname><given-names>M</given-names></name><name><surname>Tonin</surname><given-names>P</given-names></name><name><surname>De Boni</surname><given-names>A</given-names></name><etal/></person-group><article-title>Effects of fluoxetine and maprotiline on functional recovery in poststroke hemiplegic patients undergoing rehabilitation therapy</article-title><source>Stroke</source><year>1996</year><volume>27</volume><fpage>1211</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">8685930</pub-id></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Damecour</surname><given-names>CL</given-names></name><name><surname>Caplan</surname><given-names>D</given-names></name></person-group><article-title>The relationship of depression to symptomatology and lesion site in aphasic patients</article-title><source>Cortex</source><year>1991</year><volume>27</volume><fpage>385</fpage><lpage>401</lpage><pub-id pub-id-type="pmid">1743034</pub-id></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>de Abajo</surname><given-names>FJ</given-names></name><name><surname>Jick</surname><