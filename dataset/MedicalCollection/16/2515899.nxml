colspan="1">Eastwood et al 1989</td><td align="left" rowspan="1" colspan="1">87</td><td align="left" rowspan="1" colspan="1">Rehab hosp</td><td align="left" rowspan="1" colspan="1">CND</td><td align="left" rowspan="1" colspan="1">21 d- 6 m</td><td align="left" rowspan="1" colspan="1">HDRS, GDS</td><td align="left" rowspan="1" colspan="1">50</td></tr><tr><td align="left" rowspan="1" colspan="1">Finset et al 1989</td><td align="left" rowspan="1" colspan="1">42</td><td align="left" rowspan="1" colspan="1">Rehab hosp</td><td align="left" rowspan="1" colspan="1">Norway</td><td align="left" rowspan="1" colspan="1">6 m</td><td align="left" rowspan="1" colspan="1">GCRD</td><td align="left" rowspan="1" colspan="1">36</td></tr><tr><td align="left" rowspan="1" colspan="1">Malec et al 1990</td><td align="left" rowspan="1" colspan="1">20</td><td align="left" rowspan="1" colspan="1">Rehab hosp</td><td align="left" rowspan="1" colspan="1">USA</td><td align="left" rowspan="1" colspan="1">1 m</td><td align="left" rowspan="1" colspan="1">HDRS</td><td align="left" rowspan="1" colspan="1">35</td></tr><tr><td align="left" rowspan="1" colspan="1">Morris et al 1990</td><td align="left" rowspan="1" colspan="1">99<break/>56</td><td align="left" rowspan="1" colspan="1">rehab hosp</td><td align="left" rowspan="1" colspan="1">AU</td><td align="left" rowspan="1" colspan="1">2 m<break/>15 m</td><td align="left" rowspan="1" colspan="1">MADRS/CIDI</td><td align="left" rowspan="1" colspan="1">35<break/>12</td></tr><tr><td align="left" rowspan="1" colspan="1">Parikh et al 1990</td><td align="left" rowspan="1" colspan="1">63</td><td align="left" rowspan="1" colspan="1">hospital-based<break/>hospital-based</td><td align="left" rowspan="1" colspan="1">USA</td><td align="left" rowspan="1" colspan="1">&#x0003c;1 m<break/>2 y</td><td align="left" rowspan="1" colspan="1">HDRS, PSE,DSM-III</td><td align="left" rowspan="1" colspan="1">39<break/>39</td></tr><tr><td align="left" rowspan="1" colspan="1"><xref r