></citation></ref><ref id="pmed-0050168-b006"><citation citation-type="journal"><person-group><name><surname>Roberts</surname><given-names>I</given-names></name><name><surname>Yates</surname><given-names>D</given-names></name><name><surname>Sandercock</surname><given-names>P</given-names></name><name><surname>Farrell</surname><given-names>B</given-names></name><name><surname>Wasserberg</surname><given-names>J</given-names></name><etal/></person-group><year>2004</year><article-title>Effect of intravenous corticosteroids on death within 14 days in 10008 adults with clinically significant head injury (MRC CRASH trial): Randomised placebo-controlled trial</article-title><source>Lancet</source><volume>364</volume><fpage>1321</fpage><lpage>1328</lpage><pub-id pub-id-type="pmid">15474134</pub-id></citation></ref><ref id="pmed-0050168-b007"><citation citation-type="journal"><comment>MRC CRASH Trial Collaborators</comment><person-group person-group-type="editor"><name><surname>Perel</surname><given-names>P</given-names></name><name><surname>Arango</surname><given-names>M</given-names></name><name><surname>Clayton</surname><given-names>T</given-names></name><name><surname>Edwards</surname><given-names>P</given-names></name><etal/></person-group><year>2008</year><article-title>Predicting outcome after traumatic brain injury: Practical prognostic models based on large cohort of international patients</article-title><source>BMJ</source><volume>336</volume><fpage>425</fpage><lpage>429</lpage><comment>doi:<ext-link ext-link-type="doi" xlink:href="10.1136/bmj.39461.643438.25">10.1136/bmj.39461.643438.25</ext-link></comment><pub-id pub-id-type="pmid">18270239</pub-id></citation></ref><ref id="pmed-0050168-b008"><citation citation-type="journal"><person-group><name><surname>Steyerberg</surname><given-names>EW</given-names></name><name><surname>Mushkudiani</surname><given-names>N</given-names></name><name><surname>Perel</surname><given-names>P</given-names></name><name><surname>Butche