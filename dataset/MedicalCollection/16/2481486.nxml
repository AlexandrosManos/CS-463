pub-id pub-id-type="doi">10.1038/sj.bjc.6600197</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brantley</surname><given-names>E</given-names></name><name><surname>Trapani</surname><given-names>V</given-names></name><name><surname>Alley</surname><given-names>MC</given-names></name><name><surname>Hose</surname><given-names>CD</given-names></name><name><surname>Bradshaw</surname><given-names>TD</given-names></name><name><surname>Stevens</surname><given-names>MF</given-names></name><name><surname>Sausville</surname><given-names>EA</given-names></name><name><surname>Stinson</surname><given-names>SF</given-names></name></person-group><article-title>Fluorinated 2-(4-amino-3-methylphenyl)benzothiazoles induce CYP1A1 expression, become metabolised, and bind to macromolecules in sensitive human cancer cells</article-title><source>Drug Metab Dispos</source><year>2004</year><volume>32</volume><fpage>1392</fpage><lpage>1401</lpage><pub-id pub-id-type="pmid">15355884</pub-id><pub-id pub-id-type="doi">10.1124/dmd.104.001057</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Patterson</surname><given-names>LH</given-names></name><name><surname>Murray</surname><given-names>GI</given-names></name></person-group><article-title>Tumor cytochrome P450 and drug activation</article-title><source>Curr Pharm Des</source><year>2002</year><volume>8</volume><fpage>1335</fpage><lpage>1347</lpage><pub-id pub-id-type="pmid">12052211</pub-id><pub-id pub-id-type="doi">10.2174/1381612023394502</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shet</surname><given-names>MS</given-names></name><name><surname>McPhaul</surname><given-names>M</given-names></name><name><surname>Fisher</surname><given-names>CW</given-names></name><name><surname>Stallings</surname><given-na