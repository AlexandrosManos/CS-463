-title>EAAC1, a high-affinity glutamate tranporter, is localized to astrocytes and gabaergic neurons besides pyramidal cells in the rat cerebral cortex.</article-title><source>Cereb Cortex</source><volume>8</volume><fpage>108</fpage><lpage>116</lpage><pub-id pub-id-type="pmid">9542890</pub-id></citation></ref><ref id="pone.0002979-He1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>He</surname><given-names>Y</given-names></name><name><surname>Janssen</surname><given-names>WG</given-names></name><name><surname>Rothstein</surname><given-names>JD</given-names></name><name><surname>Morrison</surname><given-names>JH</given-names></name></person-group><year>2000</year><article-title>Differential synaptic localization of the glutamate transporter EAAC1 and glutamate receptor subunit GluR2 in the rat hippocampus.</article-title><source>J Comp Neurol</source><volume>418</volume><fpage>255</fpage><lpage>269</lpage><pub-id pub-id-type="pmid">10701825</pub-id></citation></ref><ref id="pone.0002979-Esclapez2"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Esclapez</surname><given-names>M</given-names></name><name><surname>Tillakaratne</surname><given-names>NJ</given-names></name><name><surname>Kaufman</surname><given-names>DL</given-names></name><name><surname>Tobin</surname><given-names>AJ</given-names></name><name><surname>Houser</surname><given-names>CR</given-names></name></person-group><year>1994</year><article-title>Comparative localization of two forms of glutamic acid decarboxylase and their mRNAs in rat brain supports the concept of functional differences between the forms.</article-title><source>J Neurosci</source><volume>14</volume><fpage>1834</fpage><lpage>1855</lpage><pub-id pub-id-type="pmid">8126575</pub-id></citation></ref><ref id="pone.0002979-Hsu1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hsu</surname><given-names>CC</given-names></name><name><surname>Davis</surname><given-names>KM</given-names></name><name><surname>Jin</surname><given-names>H</given-names></name><name><surname>Foos</surname><given-names>T</given-names></name><name><surname>Floor</surname><given-names>E</given-names></name><etal/></person-group><year>2000</year><article-title>Association of L-glutamic acid decarboxylase to the 70-kDa heat shock protein as a potential anchoring mechanism to synaptic vesicles.</article-title><source>J Biol Chem</source><volume>275</volume><fpage>20822</fpage><lpage>20828</lpage><pub-id pub-id-type="pmid">10781586</pub-id></citation></ref><ref id="pone.0002979-Jin1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jin</surname><given-names>H</given-names></name><name><surname>Wu</surname><given-names>H</given-names></name><name><surname>Osterhaus</surname><given-names>G</given-names></name><name><surname>Wei</surname><given-names>J</given-names></name><name><surname>Davis</surname><given-names>K</given-names></name><etal/></person-group><year>2003</year><article-title>Demonstration of functional coupling between &#x003b3;-aminobutyric acid (GABA) synthesis and vesicular GABA transport into synaptic vesicles.</article-title><source>Proc Natl Acad Sci USA</source><volume>100</volume><fpage>4293</fpage><lpage>4298</lpage><pub-id pub-id-type="pmid">12634427</pub-id></citation></ref><ref id="pone.0002979-Fisher1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fisher</surname><given-names>JL</given-names></name></person-group><year>2004</year><article-title>The alpha 1 and alpha 6 subunit subtypes of the mammalian GABA(A) receptor confer distinct channel gating kinetics.</article-title><source>J Physiol</source><volume>561</volume><fpage>433</fpage><lpage>448</lpage><pub-id pub-id-type="pmid">15579538</pub-id></citation></ref><ref id="pone.0002979-Frerking1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Frerking</surname><given-names>M</given-names></name><name><surname>Borges</surname><given-names>S</given-names></name><name><surname>Wilson</surname><given-names>M</given-names></name></person-group><year>1995</year><article-title>Variation in GABA mini amplitude is the consequence of variation in transmitter concentration.</article-title><source>Neuron</source><volume>15</volume><fpage>885</fpage><lpage>895</lpage><pub-id pub-id-type="pmid">7576637</pub-id></citation></ref><ref id="pone.0002979-Barberis1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barberis</surname><given-names>A</given-names></name><name><surname>Petrini</surname><given-names>EM</given-names></name><name><surname>Cherubini</surname><given-names>E</given-names></name></person-group><year>2004</year><article-title>Presynaptic source of quantal size variability at GABAergic synapses in rat hippocampal neurons in culture.</article-title><source>Eur J Neurosci</source><volume>20</volume><fpage>1803</fpage><lpage>1810</lpage><pub-id pub-id-type="pmid">15380001</pub-id></citation></ref><ref id="pone.0002979-Schousboe1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schousboe</surname><given-names>A</given-names></name><name><surname>Sarup</surname><given-names>A</given-names></name><name><surname>Larsson</surname><given-names>OM</given-names></name><name><surname>White</surname><given-names>HS</given-names></name></person-group><year>2004</year><article-title>GABA transporters as drug targets for modulation of GABAergic activity.</article-title><source>Biochem Pharmacol</source><volume>68</volume><fpage>1557</fpage><lpage>1563</lpage><pub-id pub-id-type="pmid">15451399</pub-id></citation></ref><ref id="pone.0002979-Sepkuty1"><label>22</label><citatio