/year><article-title>Melioidosis</article-title><source>Lancet</source><volume>361</volume><fpage>1715</fpage><lpage>1722</lpage><pub-id pub-id-type="pmid">12767750</pub-id></citation></ref><ref id="pmed-0050175-b012"><citation citation-type="journal"><person-group><name><surname>Currie</surname><given-names>BJ</given-names></name><name><surname>Fisher</surname><given-names>DA</given-names></name><name><surname>Howard</surname><given-names>DM</given-names></name><name><surname>Burrow</surname><given-names>JN</given-names></name><name><surname>Lo</surname><given-names>D</given-names></name><etal/></person-group><year>2000</year><article-title>Endemic melioidosis in tropical northern Australia: A 10-year prospective study and review of the literature</article-title><source>Clin Infect Dis</source><volume>31</volume><fpage>981</fpage><lpage>986</lpage><pub-id pub-id-type="pmid">11049780</pub-id></citation></ref><ref id="pmed-0050175-b013"><citation citation-type="journal"><person-group><name><surname>Cheng</surname><given-names>AC</given-names></name><name><surname>Stephens</surname><given-names>DP</given-names></name><name><surname>Anstey</surname><given-names>NM</given-names></name><name><surname>Currie</surname><given-names>BJ</given-names></name></person-group><year>2004</year><article-title>Adjunctive granulocyte colony-stimulating factor for treatment of septic shock due to melioidosis</article-title><source>Clin Infect Dis</source><volume>38</volume><fpage>32</fpage><lpage>37</lpage><pub-id pub-id-type="pmid">14679445</pub-id></citation></ref><ref id="pmed-0050175-b014"><citation citation-type="journal"><person-group><name><surname>Chan</surname><given-names>KP</given-names></name><name><surname>Low</surname><given-names>JG</given-names></name><name><surname>Raghuram</surname><given-names>J</given-names></name><name><surname>Fook-Chong</surname><given-names>SM</given-names></name><name><surname>Kurup</surname><given-names>A</given-names></name></person-group><ye