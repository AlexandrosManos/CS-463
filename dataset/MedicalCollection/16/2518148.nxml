<name><surname>Schellhase</surname><given-names>DR</given-names></name><name><surname>Darville</surname><given-names>T</given-names></name><name><surname>Gubbins</surname><given-names>PO</given-names></name><name><surname>Jacobs</surname><given-names>RF</given-names></name></person-group><article-title>Blastomycosis in children</article-title><source>Clinical Infectious Diseases</source><year>1996</year><volume>22</volume><fpage>496</fpage><lpage>502</lpage><pub-id pub-id-type="pmid">8852969</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sarosi</surname><given-names>GA</given-names></name><name><surname>Davies</surname><given-names>SF</given-names></name><name><surname>Phillips</surname><given-names>JR</given-names></name></person-group><article-title>Self-limited blastomycosis: a report of 39 Cases</article-title><source>Seminars in Respiratory Infections</source><year>1986</year><volume>1</volume><fpage>40</fpage><lpage>44</lpage><pub-id pub-id-type="pmid">3685662</pub-id></citation></ref><ref id="B8"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Chapmann</surname><given-names>SW</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Mandell GL, Nennet JE, Dolin R</surname></name></person-group><article-title>Blastomycosis dermatidis</article-title><source>Textbook of Principles and practice of infectious diseases</source><year>2000</year><edition>5</edition><publisher-name>New York: Churchill Livingstone</publisher-name><fpage>2733</fpage><lpage>2746</lpage></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rottem</surname><given-names>M</given-names></name><name><surname>Fauci</surname><given-names>AS</given-names></name><name><surname>Hallahan</surname><given-names>CW</given-names></name><name><surname>Kerr</surname><given-names>GS</given