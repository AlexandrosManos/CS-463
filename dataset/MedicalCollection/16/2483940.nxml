ation></ref><ref id="pone.0002876-Motulsky1"><label>14</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Motulsky</surname><given-names>H</given-names></name></person-group><year>1995</year><source>Intuitive Biostatistics</source><publisher-loc>New York</publisher-loc><publisher-name>Oxford University Press</publisher-name><fpage>408</fpage></citation></ref><ref id="pone.0002876-Sheskin1"><label>15</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Sheskin</surname><given-names>DJ</given-names></name></person-group><year>2000</year><source>Handbook of Parametric and Nonparametric Statistical Procedures</source><publisher-loc>New York</publisher-loc><publisher-name>Chapman &#x00026; Hall/CRC Press</publisher-name><fpage>982</fpage></citation></ref><ref id="pone.0002876-Scheaffer1"><label>16</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Scheaffer</surname><given-names>RL</given-names></name></person-group><year>1990</year><source>Introduction to Probability and its Applications.</source><publisher-name>PWS-KENT Publishing Company</publisher-name><fpage>363</fpage></citation></ref><ref id="pone.0002876-Papoulis1"><label>17</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Papoulis</surname><given-names>A</given-names></name></person-group><year>1965</year><source>Probability, Random Variables, and Stochastic Processes</source><publisher-loc>New York</publisher-loc><publisher-name>McGraw-Hill</publisher-name><fpage>583</fpage></citation></ref><ref id="pone.0002876-Fieller1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fieller</surname><given-names>E</given-names></name></person-group><year>1932</year><article-title>The distribution of the index in a normal bivariate population.</article-title><source>Biometrika</source><volume>24(3/4)</volume><fpage>428</fpage><lpage>440</lpage></citation></ref><ref id="pone.0002876-Fieller2"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fieller</surname><given-names>E</given-names></name></person-group><year>1954</year><article-title>Some problems in interval estimation.</article-title><source>J Roy Statist Soc Ser: B</source><volume>16</volume><fpage>175</fpage><lpage>185</lpage></citation></ref><ref id="pone.0002876-vonLuxburg1"><label>20</label><citation citation-type="other"><person-group person-group-type="author"><name><surname>von Luxburg</surname><given-names>U</given-names></name><name><surname>Franz</surname><given-names>VH</given-names></name></person-group><year>2002</year><article-title>Confidence Sets for Ratios: A Purely Geometric Approach To Fieller's Theorem.</article-title><comment>Max Plank Institute for Biological Cybernetics, Technical Report No. TR-133</comment></citation></ref><ref id="pone.0002876-vonLuxburg2"><label>21</label><citation citation-type="other"><person-group person-group-type="author"><name><surname>von Luxburg</surname><given-names>U</given-names></name><name><surname>Franz</surname><given-names>VH</given-names></name></person-group><year>2007</year><article-title>A Geometric Approach to Confidence Sets for Ratios: Fieller's Theorem, Generalizations, and Boostrap.</article-title><comment>ArXiv e-prints, arXiv:0711.0198v1. See: <ext-link ext-link-type="uri" xlink:href="http://arxiv.org/abs/0711.0198">http://arxiv.org/abs/0711.0198</ext-link>.</comment></citation></ref><ref id="pone.0002876-Emery1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Emery</surname><given-names>SL</given-names></name><name><surname>Erdman</surname><given-names>DD</given-names></name><name><surname>Bowen</surname><given-names>MD</given-names></name><name><surname>Newton</surname><given-names>BR</given-names></name><name><surname>Winchell</surname><given-names>JM</given-names></name><etal/></person-group><year>2004</year><article-title>Real-time reverse transcription-polymerase chain reaction assay for SARS-associated coronavirus.</article-title><source>Emerg Infect Dis</source><volume>10</volume><fpage>311</fpage><lpage>316</lpage><pub-id pub-id-type="pmid">15030703</pub-id></citation></ref></ref-list><fn-group><fn fn-type="conflict"><p><bold>Competing Interests: </bold>The authors are employees of Fludigim Corporation and for this research project they used a technology platform which is being commercialized by Fluidigm.</p></fn><fn fn-type="financial-disclosure"><p><bold>Funding: </bold>The authors are employees of Fludigim Corporation and this work was undertaken at Fluidigm.</p></fn></fn-group></back></article>