title><source>Lancet</source><year>1990</year><volume>335</volume><fpage>1070</fpage><lpage>1073</lpage><pub-id pub-id-type="pmid">1970377</pub-id><pub-id pub-id-type="doi">10.1016/0140-6736(90)92640-4</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Austin</surname><given-names>PC</given-names></name><name><surname>Daly</surname><given-names>PA</given-names></name><name><surname>Tu</surname><given-names>JV</given-names></name></person-group><article-title>A multicenter study of the coding accuracy of hospital discharge administrative data for patients admitted to cardiac care units in Ontario</article-title><source>Am Heart J</source><year>2002</year><volume>144</volume><fpage>290</fpage><lpage>296</lpage><pub-id pub-id-type="pmid">12177647</pub-id><pub-id pub-id-type="doi">10.1067/mhj.2002.123839</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Quan</surname><given-names>H</given-names></name><name><surname>Parsons</surname><given-names>GA</given-names></name><name><surname>Ghali</surname><given-names>WA</given-names></name></person-group><article-title>Validity of information on comorbidity derived rom ICD-9-CCM administrative data</article-title><source>Med Care</source><year>2002</year><volume>40</volume><fpage>675</fpage><lpage>685</lpage><pub-id pub-id-type="pmid">12187181</pub-id><pub-id pub-id-type="doi">10.1097/00005650-200208000-00007</pub-id></citation></ref></ref-list></back></article>