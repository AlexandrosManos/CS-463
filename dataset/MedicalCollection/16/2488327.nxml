name><given-names>MR</given-names></name></person-group><article-title>Altered diffusion and perfusion in hydrocephalic rat brain: a magnetic resonance imaging analysis</article-title><source>J Neurosurg</source><year>2000</year><volume>92</volume><fpage>442</fpage><lpage>447</lpage><pub-id pub-id-type="pmid">10701531</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shoesmith</surname><given-names>CL</given-names></name><name><surname>Buist</surname><given-names>R</given-names></name><name><surname>Del Bigio</surname><given-names>MR</given-names></name></person-group><article-title>Magnetic resonance imaging study of extracellular fluid tracer movement in brains of immature rats with hydrocephalus</article-title><source>Neurol Res</source><year>2000</year><volume>22</volume><fpage>111</fpage><lpage>116</lpage><pub-id pub-id-type="pmid">10672588</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sykova</surname><given-names>E</given-names></name><name><surname>Fiala</surname><given-names>J</given-names></name><name><surname>Antonova</surname><given-names>T</given-names></name><name><surname>Vorisek</surname><given-names>I</given-names></name></person-group><article-title>Extracellular space volume changes and diffusion barriers in rats with kaolin-induced and inherited hydrocephalus</article-title><source>Eur J Pediatr Surg</source><year>2001</year><volume>11</volume><fpage>S34</fpage><lpage>S37</lpage><pub-id pub-id-type="pmid">11848042</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jones</surname><given-names>HC</given-names></name><name><surname>Andersohn</surname><given-names>RW</given-names></name></person-group><article-title>Progressive changes in cortical water and electrolyte content at three stages of rat infantile hydroc