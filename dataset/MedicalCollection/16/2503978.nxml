en-names></name></person-group><article-title>Plasmacytoid dendritic cells produce cytokines and mature in response to the TLR7 agonists, imiquimod and resiquimod</article-title><source>Cell Immunol</source><year>2002</year><volume>218</volume><fpage>74</fpage><lpage>86</lpage><pub-id pub-id-type="pmid">12470615</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ito</surname><given-names>T</given-names></name><name><surname>Amakawa</surname><given-names>R</given-names></name><name><surname>Kaisho</surname><given-names>T</given-names></name><name><surname>Hemmi</surname><given-names>H</given-names></name><name><surname>Tajima</surname><given-names>K</given-names></name><name><surname>Uehira</surname><given-names>K</given-names></name><name><surname>Ozaki</surname><given-names>Y</given-names></name><name><surname>Tomizawa</surname><given-names>H</given-names></name><name><surname>Akira</surname><given-names>S</given-names></name><name><surname>Fukuhara</surname><given-names>S</given-names></name></person-group><article-title>Interferon-alpha and interleukin-12 are induced differentially by Toll-like receptor 7 ligands and human blood dendritic cell subsets</article-title><source>J Exp Med</source><year>2002</year><volume>195</volume><fpage>1507</fpage><lpage>1512</lpage><pub-id pub-id-type="pmid">12045249</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Krug</surname><given-names>A</given-names></name><name><surname>Rothenfusser</surname><given-names>S</given-names></name><name><surname>Hornung</surname><given-names>V</given-names></name><name><surname>Jahrsdorfer</surname><given-names>B</given-names></name><name><surname>Blackwell</surname><given-names>S</given-names></name><name><surname>Ballas</surname><given-names>ZK</given-names></name><name><surname>Endres</surname><given-names>S</given-names></name><name><surname>Krieg</surname><given-names>AM</given-names></name><name><surname>Hartmann</surname><given-names>G</given-names></name></person-group><article-title>Identification of CpG oligonucleotide sequences with high induction of IFN-alpha/beta in plasmacytoid dendritic cells</article-title><source>Eur J Immunol</source><year>2001</year><volume>31</volume><fpage>2154</fpage><lpage>2163</lpage><pub-id pub-id-type="pmid">11449369</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tomai</surname><given-names>MA</given-names></name><name><surname>Imbertson</surname><given-names>LM</given-names></name><name><surname>Stanczak</surname><given-names>TL</given-names></name><name><surname>Tygrett</surname><given-names>LT</given-names></name><name><surname>Waldschmidt</surname><given-names>TJ</given-names></name></person-group><article-title>The immune response modifiers imiquimod and R-848 are potent activators of B lymphocytes</article-title><source>Cell Immunol</source><year>2000</year><volume>203</volume><fpage>55</fpage><lpage>65</lpage><pub-id pub-id-type="pmid">10915562</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bishop</surname><given-names>GA</given-names></name><name><surname>Ramirez</surname><given-names>LM</given-names></name><name><surname>Baccam</surname><given-names>M</given-names></name><name><surname>Busch</surname><given-names>LK</given-names></name><name><surname>Pederson</surname><given-names>LK</given-names></name><name><surname>Tomai</surname><given-names>MA</given-names></name></person-group><article-title>The immune response modifier resiquimod mimics CD40-induced B cell activation</article-title><source>Cell Immunol</source><year>2001</year><volume>208</volume><fpage>9</fpage><lpage>17</lpage><pub-id pub-id-type="pmid">11277614</pub-id></citation></ref><ref id="B13"><citation citation-type="jour