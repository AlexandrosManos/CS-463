pan="1" colspan="1">Other non-Hispanic</td><td align="right" rowspan="1" colspan="1">65.0 (58.4-71.0)</td><td align="right" rowspan="1" colspan="1">62.2 (50.0-72.9)</td><td align="right" rowspan="1" colspan="1">0.42 (.68)</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">&#x0003c;High school diploma</td><td align="right" rowspan="1" colspan="1">61.5 (59.7-63.2)</td><td align="right" rowspan="1" colspan="1">58.7 (56.0-61.4)</td><td align="right" rowspan="1" colspan="1">1.69 (.09)</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">High school diploma or some college</td><td align="right" rowspan="1" colspan="1">68.0 (67.2-68.9)</td><td align="right" rowspan="1" colspan="1">65.0 (62.8-67.1)</td><td align="right" rowspan="1" colspan="1">2.61 (.009)</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">&#x02265;College diploma</td><td align="right" rowspan="1" colspan="1">71.0 (69.6-72.4)</td><td align="right" rowspan="1" colspan="1">71.1 (68.4-73.7)</td><td align="right" rowspan="1" colspan="1">&#x02212;0.08 (.94)</td></tr><tr><td align="left" scope="col" colspan="4" rowspan="1"><bold>Ever had a pneumonia vaccination</bold></td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">Overall</td><td align="right" rowspan="1" colspan="1">63.4 (62.7-64.1)</td><td align="right" rowspan="1" colspan="1">56.8 (55.3-58.3)</td><td align="right" rowspan="1" colspan="1">7.66 (&#x0003c;.001)</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">Male</td><td align="right" rowspan="1" colspan="1">61.8 (60.6-63.0)</td><td align="right" rowspan="1" colspan="1">54.3 (51.7-56.8)</td><td align="right" rowspan="1" colspan="1">5.30 (&#x0003c;.001)</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">Female</td><td align="right" rowspan="1" colspan="1">64.5 (63.6-65.4)</td><td align="right" rowspan="1" colspan="1">58.7 (56.9-60.6)</td><td align="right" rowspan="1" colspan="1">5.46 (&#x0003c;.001)</td></tr><tr><td align