="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">No significant deactivation at corrected level.</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"><bold>AD (baseline) &#x02013; activations</bold></td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">No significant activation</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"><bold>AD (baseline) &#x02013; deactivations</bold></td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Parahippocampal gyrus</td><td align="left" rowspan="1" colspan="1">R</td><td align="left" rowspan="1" colspan="1">19, 37</td><td align="left" rowspan="1" colspan="1">30</td><td align="left" rowspan="1" colspan="1">&#x02212;53</td><td align="left" rowspan="1" colspan="1">&#x02212;7</td><td align="left" rowspan="1" colspan="1"><bold>3.99</bold></td></tr><tr><td align="left" rowspan="1" colspan="1">Fusiform gyrus</td><td align="left" rowspan="1" colspan="1">R</td><td align="left" rowspan="1" colspan="1">19</td><td al