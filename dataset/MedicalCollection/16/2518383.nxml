urce>JAMA</source><year>2003</year><volume>290</volume><fpage>86</fpage><lpage>97</lpage><pub-id pub-id-type="pmid">12837716</pub-id></citation></ref><ref id="b15"><citation citation-type="web"><collab>[EMEA] European Medicines Agency</collab><article-title>Press Release. European Medicines Agency concludes new advice to doctors and patients for Champix needed</article-title><year>2007</year><comment>[online]. Accessed 12 March 2008. URL: <ext-link ext-link-type="uri" xlink:href="http://www.emea.europa.eu/pdfs/general/direct/pr/59551607en.pdf"/></comment></citation></ref><ref id="b16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Etter</surname><given-names>J-F</given-names></name></person-group><article-title>Cytisine for smoking cessation: a literature review and meta-analysis</article-title><source>Arch Intern Med</source><year>2006</year><volume>166</volume><fpage>1553</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">16908787</pub-id></citation></ref><ref id="b17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Faessel</surname><given-names>HM</given-names></name><name><surname>Smith</surname><given-names>BJ</given-names></name><name><surname>Gibbs</surname><given-names>MA</given-names></name><etal/></person-group><article-title>Single-dose pharmacokinetics of varenicline, a selective nicotinic receptor partial agonist, in healthy smokers and nonsmokers</article-title><source>J Clin Pharmacol</source><year>2006</year><volume>46</volume><fpage>991</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">16920893</pub-id></citation></ref><ref id="b18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fagerstr&#x000f6;m</surname><given-names>KO</given-names></name><name><surname>Schneider</surname><given-names>NG</given-names></name></person-group><article-title>Measuring nicotine dependence in tobacco smoking: a review of the Fagerstr&#x000f6;m T