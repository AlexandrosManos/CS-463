3</lpage><pub-id pub-id-type="pmid">3383244</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Driever</surname><given-names>W</given-names></name><name><surname>Siegel</surname><given-names>V</given-names></name><name><surname>Nusslein-Volhard</surname><given-names>C</given-names></name></person-group><article-title>Autonomous determination of anterior structures in the early <italic>Drosophila</italic> embryo by the <italic>bicoid</italic> morphogen</article-title><source>Development</source><year>1990</year><volume>109</volume><fpage>811</fpage><lpage>820</lpage><pub-id pub-id-type="pmid">2226200</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tam</surname><given-names>PP</given-names></name><name><surname>Loebel</surname><given-names>DA</given-names></name></person-group><article-title>Gene function in mouse embryogenesis: get set for gastrulation</article-title><source>Nat Rev Genet</source><year>2007</year><volume>8</volume><fpage>368</fpage><lpage>381</lpage><pub-id pub-id-type="pmid">17387317</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heasman</surname><given-names>J</given-names></name></person-group><article-title>Patterning the early <italic>Xenopus</italic> embryo</article-title><source>Development</source><year>2006</year><volume>133</volume><fpage>1205</fpage><lpage>1217</lpage><pub-id pub-id-type="pmid">16527985</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rose</surname><given-names>LS</given-names></name><name><surname>Kemphues</surname><given-names>KJ</given-names></name></person-group><article-title>Early patterning of the <italic>C. elegans</italic> embryo</article-title><source>Annu Rev Genet</source><year>1998</year><volume>32