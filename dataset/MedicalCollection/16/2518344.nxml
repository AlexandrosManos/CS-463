<italic>n</italic></td><td colspan="1" rowspan="1" align="center" valign="top">4,598</td><td colspan="1" rowspan="1" align="center" valign="top">413</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Age (years)</td><td colspan="1" rowspan="1" align="center" valign="top">61.7 &#x000b1; 0.2</td><td colspan="1" rowspan="1" align="center" valign="top">61.5 &#x000b1; 0.5</td><td colspan="1" rowspan="1" align="char" char="." valign="top">0.69</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Sex (&#x00025; male)</td><td colspan="1" rowspan="1" align="center" valign="top">47.3</td><td colspan="1" rowspan="1" align="center" valign="top">49.4</td><td colspan="1" rowspan="1" align="char" char="." valign="top">0.41</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Race/ethnicity (&#x00025;)</td><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="char" char="." valign="top">&#x0003c;0.001</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;White</td><td colspan="1" rowspan="1" align="center" valign="top">44.4</td><td colspan="1" rowspan="1" align="center" valign="top">33.2</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Black</td><td colspan="1" rowspan="1" align="center" valign="top">19.6</td><td colspan="1" rowspan="1" align="center" valign="top">27.6</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Hispanic</td><td colspan="1" rowspan="1" align="center" valign="top">23.7</td><td colspan="1" rowspan="1" align="center" valign="top">27.9</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><