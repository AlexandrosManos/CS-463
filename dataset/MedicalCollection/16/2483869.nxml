</td><td colspan="1" rowspan="1" align="center" valign="top">1.0</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;50-59</td><td colspan="1" rowspan="1" align="center" valign="top">3 128 474</td><td colspan="1" rowspan="1" align="center" valign="top">48</td><td colspan="1" rowspan="1" align="center" valign="top">1.5 (1.2 to 2.0)</td><td colspan="1" rowspan="1" align="center" valign="top">2.9 (2.0 to 4.3)</td><td colspan="1" rowspan="1" align="center" valign="top">2.9 (2.0 to 4.3)</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;60-69</td><td colspan="1" rowspan="1" align="center" valign="top">2 601 248</td><td colspan="1" rowspan="1" align="center" valign="top">96</td><td colspan="1" rowspan="1" align="center" valign="top">3.7 (3.0 to 4.5)</td><td colspan="1" rowspan="1" align="center" valign="top">7.3 (5.3 to 10.2)</td><td colspan="1" rowspan="1" align="center" valign="top">7.2 (5.2 to 10.0)</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;70-74</td><td colspan="1" rowspan="1" align="center" valign="top">993 535</td><td colspan="1" rowspan="1" align="center" valign="top">94</td><td colspan="1" rowspan="1" align="center" valign="top">9.5 (7.7 to 11.6)</td><td colspan="1" rowspan="1" align="center" valign="top">18.6 (13.3 to 25.8)</td><td colspan="1" rowspan="1" align="center" valign="top">18.8 (13.5 to 26.1)</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;75-79</td><td colspan="1" rowspan="1" align="center" valign="top">878 348</td><td colspan="1" rowspan="1" align="center" valign="top">141</td><td colspan="1" rowspan="1" align="center" valign="top">16.1 (13.6 to 18.9)</td><td colspan="1" rowspan="1" align="center" valign="top">31.6 (32.2 to 43.0)</td><td colspan="1" rowspan="1" align="center" valign="top">32.0 (23.5 to 43.5)</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;80-84</td><td colspan="1" rowspan="1" align="center" valign="top">767 411</td><td colspan="1" rowspan="1" align="center" valign="top">174</td><td colspan="1" rowspan="1" align="center" valign="top">22.7 (19.5 to 26.3)</td><td colspan="1" rowspan="1" align="center" valign="top">44.4 (32.9 to 60.0)</td><td colspan="1" rowspan="1" align="center" valign="top">42.4 (31.4 to 57.3)</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;85-89</td><td colspan="1" rowspan="1" align="center" valign="top">355 633</td><td colspan="1" rowspan="1" align="center" valign="top">136</td><td colspan="1" rowspan="1" align="center" valign="top">38.2 (32.3 to 45.2)</td><td colspan="1" rowspan="1" align="center" valign="top">73.6 (53.9 to 100.4)</td><td colspan="1" rowspan="1" align="center" valign="top">73.0 (53.5 to 99.7)</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x0003e;90</td><td colspan="1" rowspan="1" align="center" valign="top">266 833</td><td colspan="1" rowspan="1" align="center" valign="top">123</td><td colspan="1" rowspan="1" align="center" valign="top">46.1 (38.6 to 55.0)</td><td colspan="1" rowspan="1" align="center" valign="top">91.4 (66.8 to 125.1)</td><td colspan="1" rowspan="1" align="center" valign="top">86.4 (63.0 to 118.6)</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Calendar period:</td><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign=