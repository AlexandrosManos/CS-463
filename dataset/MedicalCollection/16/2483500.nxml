"1" align="left" valign="top">0.008</td><td rowspan="1" colspan="1" align="left" valign="top">0.005</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top">&#x02003;Bond angles (&#x000b0;)</td><td rowspan="1" colspan="1" align="left" valign="top">1.4</td><td rowspan="1" colspan="1" align="left" valign="top">1.4</td><td rowspan="1" colspan="1" align="left" valign="top">1.3</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top">Temperature factors</td><td rowspan="1" colspan="1" align="left" valign="top">&#x000a0;</td><td rowspan="1" colspan="1" align="left" valign="top">&#x000a0;</td><td rowspan="1" colspan="1" align="left" valign="top">&#x000a0;</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top">&#x02003;                        <italic>B</italic> factor, RNA (&#x000c5;<sup>2</sup>)</td><td rowspan="1" colspan="1" align="left" valign="top">69.5</td><td rowspan="1" colspan="1" align="left" valign="top">95.6</td><td rowspan="1" colspan="1" align="left" valign="top">78.5</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top">&#x02003;                        <italic>B</italic> factor, water (&#x000c5;<sup>2</sup>)</td><td rowspan="1" colspan="1" align="left" valign="top">74.0</td><td rowspan="1" colspan="1" align="left" valign="top">78.4</td><td rowspan="1" colspan="1" align="left" valign="top">77.0</td></tr></tbody></table><table-wrap-foot><fn id="tfn1"><label>&#x02020;</label><p>From PDB entry <ext-link ext-link-type="uri" xlink:href="http://www.rcsb.org/pdb/explore.do?structureId=2oue">2oue</ext-link>.</p></fn><fn id="tfn2"><label>&#x02021;</label><p>From PDB entry <ext-link ext-link-type="uri" xlink:href="http://www.rcsb.org/pdb/explore.do?structureId=2npz">2npz</ext-link>.</p></fn><fn id="tfn3"><label>&#x000a7;</label><p>From PDB entry <ext-link ext-link-type="uri" xlink:href="http://www.rcsb.org/pdb/explore.do?structureId=2npy">2npy</ext-link>.</p></fn><fn id="tfn4"><label>&#x000b6;</label><p>                     <italic>R</italic>                     <sub>sym</sub> = <inline-formula><inline-graphic xlink:href="d-63-00812-efi1.jpg" mimetype="image" mime-subtype="gif"/></inline-formula>                     <inline-formula><inline-graphic xlink:href="d-63-00812-efi2.jpg" mimetype="image" mime-subtype="gif"/></inline-formula> &#x000d7; 100, where <italic>I</italic>(<italic>h</italic>)<sub><italic>j</italic></sub> is the observed intensity of the <italic>j</italic>th measurement of reflection <italic>h</italic> and &#x02329;<italic>I</italic>(<italic>h</italic>)&#x0232a; is the mean intensity of reflection <italic>h</italic>.</p></fn><fn id="tfn5"><label>&#x02020;&#x02020;</label><p>                     <italic>R</italic> = <inline-formula><inline-graphic xlink:href="d-63-00812-efi3.jpg" mimetype="image" mime-subtype="gif"/></inline-formula>                     <inline-formula><inline-graphic xlink:href="d-63-00812-efi4.jpg" mimetype="image" mime-subtype="gif"/></inline-formula> &#x000d7; 100, where <italic>F</italic>                     <sub>o</sub> and <italic>F</italic>                     <sub>c</sub> are the observed and calculated structure-factor amplitudes and <italic>k</italic> is a scale factor. <italic>R</italic>                     <sub>cryst</sub> is calculated using the residual target in <italic>CNS</italic> with all reflections in the resolution range of refinement. <italic>R</italic>                     <sub>work</sub> is calculated using all reflections except those randomly removed for the test set (5&#x02013;7%); <italic>R</italic>                     <sub>free</sub> is calculated using the test set of reflections.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>