ting</article-title><source>JAMA</source><year>2000</year><volume>283</volume><fpage>2008</fpage><lpage>12</lpage><pub-id pub-id-type="pmid">10789670</pub-id></citation></ref><ref id="FDN023C16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tania</surname><given-names>B</given-names></name><name><surname>S&#x000e1;nchez-Meca</surname><given-names>J</given-names></name><name><surname>Mar&#x00131;n-Mart&#x00131;nez</surname><given-names>F</given-names></name><etal/></person-group><article-title>Assessing Heterogeneity in Meta-Analysis: Q Statistic or I2 Index?</article-title><source>Psychol Methods</source><year>2006</year><volume>11</volume><fpage>193</fpage><lpage>206</lpage><pub-id pub-id-type="pmid">16784338</pub-id></citation></ref><ref id="FDN023C17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Viechtbauer</surname><given-names>W</given-names></name></person-group><article-title>Confidence intervals for the amount of heterogeneity in meta-analysis</article-title><source>Stat Med</source><year>2007</year><volume>26</volume><fpage>37</fpage><lpage>52</lpage><pub-id pub-id-type="pmid">16463355</pub-id></citation></ref><ref id="FDN023C18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Aldstadt</surname><given-names>J</given-names></name></person-group><article-title>An incremental Knox test for the determination of the serial interval between successive cases of an infectious disease</article-title><source>J Stochast Environ Res Risk Assess</source><year>2007</year><volume>21</volume><issue>5</issue><fpage>487</fpage><lpage>500</lpage></citation></ref><ref id="FDN023C19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Banos</surname><given-names>A</given-names></name><name><surname>Lacasa</surname><given-names>J</given-names></n