 align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Do everything, 100&#x00025; performance</td><td colspan="1" rowspan="1" align="center" valign="top">&#x02212;27,429 (&#x02212;63&#x00025;)</td><td colspan="1" rowspan="1" align="center" valign="top">&#x02212;10,212 (&#x02212;31&#x00025;)</td><td colspan="1" rowspan="1" align="center" valign="top">220,710 (5&#x00025;)</td><td colspan="1" rowspan="1" align="center" valign="top">243,926 (5&#x00025;)</td><td colspan="1" rowspan="1" align="char" char="." valign="top">8,530,159,750</td><td colspan="1" rowspan="1" align="center" valign="top">&#x02212;904,118,726 (&#x02212;10&#x00025;)</td><td colspan="1" rowspan="1" align="center" valign="top">7,626,041,025 (80&#x00025;)</td><td colspan="1" rowspan="1" align="char" char="." valign="top">$36,380</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Aspirin to high-risk individuals</td><td colspan="1" rowspan="1" align="center" valign="top">&#x02212;3,409 (&#x02212;8&#x00025;)</td><td colspan="1" rowspan="1" align="center" valign="top">331 (1&#x00025;)</td><td colspan="1" rowspan="1" align="center" valign="top">17,417 (0&#x00025;)</td><td colspan="1" rowspan="1" align="center" valign="top">17,005 (0&#x00025;)</td><td colspan="1" rowspan="1" align="char" char="." valign="top">50,094,774</td><td colspan="1" rowspan="1" align="center" valign="top">604,823 (0&#x00025;)</td><td colspan="1" rowspan="1" align="center" valign="top">50,699,597 (1&#x00025;)</td><td colspan="1" rowspan="1" align="char" char="." valign="top">$2,779</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;BMI &#x0003c;30 kg/m<sup>2</sup></td><td colspan="1" rowspan="