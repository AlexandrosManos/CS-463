son-group><article-title>The mosaic genome of warm-blooded vertebrates</article-title><source>Science</source><year>1985</year><volume>228</volume><fpage>953</fpage><lpage>958</lpage><pub-id pub-id-type="pmid">4001930</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berner</surname><given-names>RA</given-names></name></person-group><article-title>Atmospheric oxygen over Phanerozoic time</article-title><source>Proc Natl Acad Sci USA</source><year>1999</year><volume>96</volume><fpage>10955</fpage><lpage>10957</lpage><pub-id pub-id-type="pmid">10500106</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bragg</surname><given-names>JG</given-names></name><name><surname>Hyder</surname><given-names>CL</given-names></name></person-group><article-title>Nitrogen versus carbon use in prokaryotic genomes and proteomes</article-title><source>Proc Biol Sci</source><year>2004</year><volume>271</volume><issue>Suppl 5</issue><fpage>S374</fpage><lpage>S377</lpage><pub-id pub-id-type="pmid">15504022</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bragg</surname><given-names>JG</given-names></name><name><surname>Thomas</surname><given-names>D</given-names></name><name><surname>Baudouin-Cornu</surname><given-names>P</given-names></name></person-group><article-title>Variation among species in proteomic sulphur content is related to environmental conditions</article-title><source>Proc Biol Sci</source><year>2006</year><volume>273</volume><fpage>1293</fpage><lpage>1300</lpage><pub-id pub-id-type="pmid">16720405</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bragg</surname><given-names>JG</given-names></name><name><surname>Wagner</surname><given-names>A</given-names></n