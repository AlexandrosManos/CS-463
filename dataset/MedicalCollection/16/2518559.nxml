age>859</fpage><lpage>862</lpage><pub-id pub-id-type="pmid">1894681</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gordon</surname><given-names>N</given-names></name></person-group><article-title>The neurological complications of achondroplasia</article-title><source>Brain Dev</source><year>2000</year><volume>22</volume><fpage>3</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">10761826</pub-id><pub-id pub-id-type="doi">10.1016/S0387-7604(99)00075-3</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jeong</surname><given-names>ST</given-names></name><name><surname>Song</surname><given-names>HR</given-names></name><name><surname>Keny</surname><given-names>SM</given-names></name><name><surname>Telang</surname><given-names>SS</given-names></name><name><surname>Suh</surname><given-names>SW</given-names></name><name><surname>Hong</surname><given-names>SJ</given-names></name></person-group><article-title>MRI study of the lumbar spine in achondroplasia</article-title><source>J Bone Joint Surg Br</source><year>2006</year><volume>88</volume><fpage>1192</fpage><lpage>1196</lpage><pub-id pub-id-type="pmid">16943471</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nitzankowska-Blaz</surname><given-names>T</given-names></name><name><surname>Kozlowski</surname><given-names>K</given-names></name></person-group><article-title>Achondroplasia and enchondromatosis in a female child</article-title><source>Skeletal Radiol</source><year>2003</year><volume>32</volume><fpage>432</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">12774176</pub-id><pub-id pub-id-type="doi">10.1007/s00256-003-0644-y</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Numakura</surname><given-names>C</given-names></name><name><surname>Kobayashi</surname><given-names>H</given-names></name><name><surname>Hasegawa</surname><given-names>Y</given-names></name><name><surname>Adachi</surname><given-names>M</given-names></name><name><surname>Hwa Kim</surname><given-names>O</given-names></name><name><surname>Nishimura</surname><given-names>G</given-names></name></person-group><article-title>Achondroplasia and enchondromatosis: report of three boys</article-title><source>Skeletal Radiol</source><year>2007</year><volume>36</volume><fpage>S29</fpage><lpage>S33</lpage><pub-id pub-id-type="pmid">16763840</pub-id><pub-id pub-id-type="doi">10.1007/s00256-006-0161-x</pub-id></citation></ref></ref-list></back></article>