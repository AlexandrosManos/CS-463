>Motor neurons</td><td align="left" rowspan="1" colspan="1">Cell number</td><td align="left" rowspan="1" colspan="1">Abducens Ncl</td><td align="left" rowspan="1" colspan="1">Reduced</td><td align="left" rowspan="1" colspan="1">M, F</td><td align="left" rowspan="1" colspan="1">350</td><td align="left" rowspan="1" colspan="1">12.5</td><td align="left" rowspan="1" colspan="1">10</td><td align="left" rowspan="1" colspan="1">Rodier et al., <xref ref-type="bibr" rid="B183">1996</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Motor neurons</td><td align="left" rowspan="1" colspan="1">Cell number</td><td align="left" rowspan="1" colspan="1">Abducens Ncl</td><td align="left" rowspan="1" colspan="1">No effect</td><td align="left" rowspan="1" colspan="1">M, F</td><td align="left" rowspan="1" colspan="1">350</td><td align="left" rowspan="1" colspan="1">12.5</td><td align="left" rowspan="1" colspan="1">60</td><td align="left" rowspan="1" colspan="1">Rodier et al., <xref ref-type="bibr" rid="B183">1996</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Motor neurons</td><td align="left" rowspan="1" colspan="1">Cell number</td><td align="left" rowspan="1" colspan="1">Oculomotor Ncl</td><td align="left" rowspan="1" colspan="1">No effect</td><td align="left" rowspan="1" colspan="1">M, F</td><td align="left" rowspan="1" colspan="1">350</td><td align="left" rowspan="1" colspan="1">11.5</td><td align="left" rowspan="1" colspan="1">11</td><td align="left" rowspan="1" colspan="1">Rodier et al., <xref ref-type="bibr" rid="B183">1996</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Motor neurons</td><td align="left" rowspan="1" colspan="1">Cell number</td><td align="left" rowspan="1" colspan="1">Oculomotor Ncl</td><td align="left" rowspan="1" colspan="1">No effect</td><td align="left" rowspan="1" colspan="1">M, F</td><td align="left" rowspan="1" colspan="1">350</td><td align="left" rowspan="1" colspan="1">12</td><td align="left" rowspan="1" colspan="1">1