" colspan="1">Tsujino et al., <xref ref-type="bibr" rid="B229">2007</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Serotonin</td><td align="left" rowspan="1" colspan="1">5-HT positive cell count</td><td align="left" rowspan="1" colspan="1">dR, rostral to caudal</td><td align="left" rowspan="1" colspan="1">Enhanced caudally</td><td align="left" rowspan="1" colspan="1">800</td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">50</td><td align="left" rowspan="1" colspan="1">Miyazaki et al., <xref ref-type="bibr" rid="B150">2005</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Serotonin</td><td align="left" rowspan="1" colspan="1">5-HT positive cell count</td><td align="left" rowspan="1" colspan="1">dR, rostral to caudal</td><td align="left" rowspan="1" colspan="1">Enhanced caudally</td><td align="left" rowspan="1" colspan="1">800</td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">91, 119</td><td align="left" rowspan="1" colspan="1">Tsujino et al., <xref ref-type="bibr" rid="B229">2007</xref></td></tr><tr><td colspan="8" rowspan="1"><bold><italic>Excitatory amino acid receptors</italic></bold></td></tr><tr><td align="left" rowspan="1" colspan="1">AMPAR</td><td align="left" rowspan="1" colspan="1">GluR1 expression</td><td align="left" rowspan="1" colspan="1">S1</td><td align="left" rowspan="1" colspan="1">No effect</td><td align="left" rowspan="1" colspan="1">500</td><td align="left" rowspan="1" colspan="1">12.5</td><td align="left" rowspan="1" colspan="1">12&#x02013;16</td><td align="left" rowspan="1" colspan="1">Rinaldi et al., <xref ref-type="bibr" rid="B179">2007b</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">AMPAR</td><td align="left" rowspan="1" colspan="1">GluR2 expression</td><td align="left" rowspan="1" colspan="1">S1</td><td align="left" rowspan="1" colspan="1">No effect</td><td align="left" rowspan="1" colspan="1">500</td><td align="left" row