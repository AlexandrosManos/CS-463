tion-type="journal"><person-group person-group-type="author"><name><surname>Hesse</surname><given-names>H</given-names></name><name><surname>Nikiforova</surname><given-names>V</given-names></name><name><surname>Gaki&#x000e8;re</surname><given-names>B</given-names></name><name><surname>Hoefgen</surname><given-names>R</given-names></name></person-group><article-title>Molecular analysis and control of cysteine biosynthesis: integration of nitrogen and sulfur metabolism</article-title><source>Journal Experimental Botany</source><year>2004a</year><volume>55</volume><fpage>1283</fpage><lpage>1292</lpage></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hirai</surname><given-names>MY</given-names></name><name><surname>Klein</surname><given-names>M</given-names></name><name><surname>Fujikawa</surname><given-names>Y</given-names></name><etal/></person-group><article-title>Elucidation of gene-to-gene and metabolite-to-gene networks in <italic>Arabidopsis</italic> by integration of metabolomics and transcriptomics</article-title><source>Journal Biological Chemistry</source><year>2005</year><volume>280</volume><fpage>25590</fpage><lpage>25595</lpage></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hirai</surname><given-names>MY</given-names></name><name><surname>Sugiyama</surname><given-names>K</given-names></name><name><surname>Sawada</surname><given-names>Y</given-names></name><etal/></person-group><article-title>Omics-based identification of <italic>Arabidopsis</italic> Myb transcription factors regulating aliphatic glucosinolate biosynthesis</article-title><source>Proceedings of the National Academy of Sciences, USA</source><year>2007</year><volume>10</volume><fpage>6478</fpage><lpage>6483</lpage></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hirai</surna