tervention</bold></th><th align="center" scope="col" rowspan="1" colspan="1">KP</th><th align="center" scope="col" rowspan="1" colspan="1">DTM</th><th align="center" scope="col" rowspan="1" colspan="1">MHS</th><th align="center" scope="col" rowspan="1" colspan="1">Mayo</th><th align="center" scope="col" rowspan="1" colspan="1">RHC</th><th align="center" scope="col" rowspan="1" colspan="1">LHS</th><th align="center" scope="col" rowspan="1" colspan="1">HP</th><th align="center" scope="col" rowspan="1" colspan="1">HMC/BCBS</th><th align="center" scope="col" rowspan="1" colspan="1">MVP</th></tr></thead><tbody><tr><td align="left" scope="row" rowspan="1" colspan="1">Disease management program</td><td align="center" rowspan="1" colspan="1">&#x000a0;</td><td align="center" rowspan="1" colspan="1">&#x000a0;</td><td align="center" rowspan="1" colspan="1">&#x000a0;</td><td align="center" rowspan="1" colspan="1">&#x000a0;</td><td align="center" rowspan="1" colspan="1">&#x000a0;</td><td align="center" rowspan="1" colspan="1">&#x000a0;</td><td align="center" rowspan="1" colspan="1">&#x025cf;</td><td align="center" rowspan="1" colspan="1">&#x025cf;</td><td align="center" rowspan="1" colspan="1">&#x025cf;</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">Participation in collaborative</td><td align="center" rowspan="1" colspan="1">&#x000a0;</td><td align="center" rowspan="1" colspan="1">&#x000a0;</td><td align="center" rowspan="1" colspan="1">&#x000a0;</td><td align="center" rowspan="1" colspan="1">&#x025cf;</td><td align="center" rowspan="1" colspan="1">&#x025cf;</td><td align="center" rowspan="1" colspan="1">&#x025cf;</td><td align="center" rowspan="1" colspan="1">&#x000a0;</td><td align="center" rowspan="1" colspan="1">&#x000a0;</td><td align="center" rowspan="1" colspan="1">&#x000a0;</td></tr><tr><td align="left" scope="row" rowspan="1" colspan="1">Specialized lipid clinics</td><td align="center" rowspan="1" colspan="1">&#x000a0;</td><td align="center" rowspan=