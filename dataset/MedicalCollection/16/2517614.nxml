ation citation-type="journal"><person-group person-group-type="author"><name><surname>Zhou</surname><given-names>HM</given-names></name><name><surname>Walthall</surname><given-names>WW</given-names></name></person-group><year>1998</year><article-title>UNC-55, an orphan nuclear hormone receptor, orchestrates synaptic                        specificity among two classes of motor neurons in <italic>Caenorhabditis                            elegans</italic>.</article-title><source>J Neurosci</source><volume>18</volume><fpage>10438</fpage><lpage>10444</lpage><pub-id pub-id-type="pmid">9852581</pub-id></citation></ref><ref id="pcbi.1000120-Angst1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Angst</surname><given-names>BD</given-names></name><name><surname>Marcozzi</surname><given-names>C</given-names></name><name><surname>Magee</surname><given-names>AI</given-names></name></person-group><year>2001</year><article-title>The cadherin superfamily: diversity in form and function.</article-title><source>J Cell Sci</source><volume>114</volume><fpage>629</fpage><lpage>641</lpage><pub-id pub-id-type="pmid">11171368</pub-id></citation></ref><ref id="pcbi.1000120-Broadbent1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Broadbent</surname><given-names>ID</given-names></name><name><surname>Pettitt</surname><given-names>J</given-names></name></person-group><year>2002</year><article-title>The <italic>C. elegans</italic> hmr-1 gene can encode a neuronal                        classic cadherin involved in the regulation of axon fasciculation.</article-title><source>Curr Biol</source><volume>12</volume><fpage>59</fpage><lpage>63</lpage><pub-id pub-id-type="pmid">11790304</pub-id></citation></ref><ref id="pcbi.1000120-Paradis1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Paradis</surname><given-names>S</gi