e>2925</lpage><pub-id pub-id-type="doi">10.1093/bioinformatics/btl497</pub-id></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Stiles</surname><given-names>JR</given-names></name><name><surname>Bartol</surname><given-names>TM</given-names></name></person-group><person-group person-group-type="editor"><name><surname>DeSchutter E</surname></name></person-group><article-title>Monte Carlo methods for simulating realistic synaptic microphysiology using MCell</article-title><source>Computational Neuroscience: Realistic Modeling for Experimentalists</source><year>2001</year><publisher-name>Boca Raton: CRC Press</publisher-name><fpage>87</fpage><lpage>127</lpage></citation></ref></ref-list></back></article>