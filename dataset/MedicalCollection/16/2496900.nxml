e>Drug Intell Clin Pharm</source><year>1988</year><volume>22</volume><fpage>214</fpage><lpage>217</lpage><pub-id pub-id-type="pmid">3366062</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yu</surname><given-names>Q</given-names></name><name><surname>Larson</surname><given-names>DF</given-names></name><name><surname>Watson</surname><given-names>RR</given-names></name></person-group><article-title>Heart disease, methamphetamine and AIDS</article-title><source>Life Sci</source><year>2003</year><volume>73</volume><fpage>129</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">12738029</pub-id><pub-id pub-id-type="doi">10.1016/S0024-3205(03)00260-1</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ruth</surname><given-names>JA</given-names></name><name><surname>Grunewald</surname><given-names>GL</given-names></name><name><surname>Rutledge</surname><given-names>CO</given-names></name></person-group><article-title>Conformationally defined adrenergic agents. III. The importance of compartmentation in the release of norepinephrine from rat atria by endo- and exo-2-methylaminobenzobicyclo-[2.2.2]octene, conformationally defined analogs of methamphetamine</article-title><source>J Pharmacol Exp Ther</source><year>1978</year><volume>204</volume><fpage>615</fpage><lpage>24</lpage><pub-id pub-id-type="pmid">633067</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wagner</surname><given-names>GC</given-names></name><name><surname>Ricaurte</surname><given-names>GA</given-names></name><name><surname>Seiden</surname><given-names>LS</given-names></name><name><surname>Schuster</surname><given-names>CR</given-names></name><name><surname>Miller</surname><given-names>RJ</given-names></name><name><surname>Westley</surname><given-names>J</given-names></name><