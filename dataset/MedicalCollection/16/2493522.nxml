person-group-type="author"><name><surname>Davis</surname><given-names>JS</given-names></name><name><surname>Harrington</surname><given-names>WF</given-names></name></person-group><article-title>Force generation in muscle fibers in rigor: a temperature-jump study</article-title><source>Proc Natl Acad Sci USA</source><year>1987</year><volume>84</volume><fpage>975</fpage><lpage>979</lpage><pub-id pub-id-type="doi">10.1073/pnas.84.4.975</pub-id></citation><citation citation-type="display-unstructured">Davis JS, Harrington WF (1987) Force generation in muscle fibers in rigor: a temperature-jump study. Proc Natl Acad Sci USA 84:975&#x02013;979 <pub-id pub-id-type="pmid">3469654</pub-id></citation></ref><ref id="CR12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Edsall</surname><given-names>JT</given-names></name><name><surname>Gutfreund</surname><given-names>H</given-names></name></person-group><source>Bio-thermodynamics</source><year>1983</year><publisher-loc>Chichester</publisher-loc><publisher-name>Wiley</publisher-name></citation><citation citation-type="display-unstructured">Edsall JT, Gutfreund H (1983) Bio-thermodynamics. Wiley, Chichester </citation></ref><ref id="CR13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Elmubarak</surname><given-names>MH</given-names></name><name><surname>Ranatunga</surname><given-names>KW</given-names></name></person-group><article-title>Temperature sensitivity of tension development in a fast-twitch muscle of the rat</article-title><source>Muscle Nerve</source><year>1984</year><volume>7</volume><fpage>298</fpage><lpage>303</lpage><pub-id pub-id-type="doi">10.1002/mus.880070408</pub-id></citation><citation citation-type="display-unstructured">Elmubarak MH, Ranatunga KW (1984) Temperature sensitivity of tension development in a fast-twitch muscle of the rat. Muscle Nerve 7:298&#x02013;303 <pub-id pub-id-type="pmid">6727914</pub-id></citation></ref><ref id="CR14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fenn</surname><given-names>WO</given-names></name></person-group><article-title>The relationship between the work performed and the energy liberated in muscular contraction</article-title><source>J Physiol</source><year>1924</year><volume>59</volume><fpage>373</fpage><lpage>395</lpage></citation><citation citation-type="display-unstructured">Fenn WO (1924) The relationship between the work performed and the energy liberated in muscular contraction. J Physiol 59:373&#x02013;395 <pub-id pub-id-type="pmid">16993720</pub-id></citation></ref><ref id="CR15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferenczi</surname><given-names>MA</given-names></name><name><surname>Bershitsky</surname><given-names>SY</given-names></name><name><surname>Koubassova</surname><given-names>N</given-names></name><name><surname>Siththanadan</surname><given-names>V</given-names></name><name><surname>Helsby</surname><given-names>WI</given-names></name><name><surname>Pannine</surname><given-names>P</given-names></name><name><surname>Roessle</surname><given-names>M</given-names></name><name><surname>Narayan</surname><given-names>T</given-names></name><name><surname>Tsaturyan</surname><given-names>AK</given-names></name></person-group><article-title>The &#x0201c;Roll and Lock&#x0201d; mechanism of force generation in muscle</article-title><source>Structure</source><year>2005</year><volume>13</volume><fpage>131</fpage><lpage>141</lpage><pub-id pub-id-type="doi">10.1016/j.str.2004.11.007</pub-id></citation><citation citation-type="display-unstructured">Ferenczi MA, Bershitsky SY, Koubassova N, Siththanadan V, Helsby WI, Pannine P, Roessle M, Narayan T, Tsaturyan AK (2005) The &#x0201c;Roll and Lock&#x0201d; mechanism of force generation in muscle. Structure&#x000a0;13:131&#x02013;141 <pub-id pub-id-type="pmid">15642268</pub-id></citation></ref><ref id="CR16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ford</surname><given-names>LE</given-names></name><name><surname>Huxley</surname><given-names>AF</given-names></name><name><surname>Simmons</surname><given-names>RM</given-names></name></person-group><article-title>Tension responses to sudden length change in stimulated frog muscle fibres near slack length</article-title><source>J Physiol</source><year>1977</year><volume>269</volume><fpage>441</fpage><lpage>515</lpage></citation><citation citation-type="display-unstructured">Ford LE, Huxley AF, Simmons RM (1977) Tension responses to sudden length change in stimulated frog muscle fibres near slack length. J Physiol 269:441&#x02013;515 <pub-id pub-id-type="pmid">302333</pub-id></citation></ref><ref id="CR17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ford</surname><given-names>LE</given-names></name><name><surname>Huxley</surname><given-names>AF</given-names></name><name><surname>Simmons</surname><given-names>RM</given-names></name></person-group><article-title>Tension transients during steady shortening of frog muscle fibres</article-title><source>J Physiol</source><year>1985</year><volume>361</volume><fpage>131</fpage><lpage>150</lpage></citation><citation citation-type="display-unstructured">Ford LE, Huxley AF, Simmons RM (1985) Tension transients during steady shortening of frog muscle fibres. J Physiol 361:131&#x02013;150 <pub-id pub-id-type="pmid">3872938</pub-id></citation></ref><ref id="CR18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fortune</surname><given-names>NS</given-names></name><name><surname>Geeves</surname><given-names>MA</given-names></name><name><surname>Ranatunga</surname><given-names>KW</given-names></name></person-group><article-title>Tension responses to rapid pressure release in glycerinated rabbit muscle fibers</article-title><source>Proc Natl Acad Sci USA<