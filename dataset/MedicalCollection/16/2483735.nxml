me><given-names>H</given-names></name><name><surname>Tada</surname><given-names>T</given-names></name><name><surname>Torii</surname><given-names>R</given-names></name><name><surname>Hosoi</surname><given-names>Y</given-names></name><name><surname>Kobayashi</surname><given-names>K</given-names></name><etal/></person-group><year>2001</year><article-title>Establishment of embryonic stem cell lines from cynomolgus monkey blastocysts produced by IVF or ICSI.</article-title><source>Dev Dyn</source><volume>222</volume><fpage>273</fpage><lpage>279</lpage><pub-id pub-id-type="pmid">11668604</pub-id></citation></ref><ref id="pone.0002800-Amit1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Amit</surname><given-names>M</given-names></name><name><surname>Carpenter</surname><given-names>MK</given-names></name><name><surname>Inokuma</surname><given-names>MS</given-names></name><name><surname>Chiu</surname><given-names>CP</given-names></name><name><surname>Harris</surname><given-names>CP</given-names></name><etal/></person-group><year>2000</year><article-title>Clonally derived human embryonic stem cell lines maintain pluripotency and proliferative potential for prolonged periods of culture.</article-title><source>Dev Biol</source><volume>227</volume><fpage>271</fpage><lpage>278</lpage><pub-id pub-id-type="pmid">11071754</pub-id></citation></ref><ref id="pone.0002800-Smith1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>AG</given-names></name></person-group><year>2001</year><article-title>Embryo-derived stem cells: of mice and men.</article-title><source>Annu Rev Cell Dev Biol</source><volume>17</volume><fpage>435</fpage><lpage>462</lpage><pub-id pub-id-type="pmid">11687496</pub-id></citation></ref><ref id="pone.0002800-Humphrey1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surnam