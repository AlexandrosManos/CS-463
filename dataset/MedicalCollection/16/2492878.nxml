><mixed-citation publication-type="journal"><name><surname>Wielgat</surname><given-names>P</given-names></name><name><surname>Walczuk</surname><given-names>U</given-names></name><name><surname>Szajda</surname><given-names>S</given-names></name><name><surname>Bien</surname><given-names>M</given-names></name><name><surname>Zimnoch</surname><given-names>L</given-names></name><name><surname>Mariak</surname><given-names>Z</given-names></name><name><surname>Zwierz</surname><given-names>K</given-names></name><article-title>Activity of lysosomal exoglycosidases in human gliomas</article-title><source>J Neurooncol</source><year>2006</year><volume>80</volume><fpage>243</fpage><lpage>249</lpage><pub-id pub-id-type="doi">10.1007/s11060-006-9188-z</pub-id><pub-id pub-id-type="pmid">16710745</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Zitta</surname><given-names>K</given-names></name><name><surname>Wertheimer</surname><given-names>EV</given-names></name><name><surname>Miranda</surname><given-names>PV</given-names></name><article-title>Sperm N-acetylglucosaminidase is involved in primary binding to the zona pellucida</article-title><source>Mol Hum Reprod</source><year>2006</year><volume>12</volume><fpage>557</fpage><lpage>563</lpage><pub-id pub-id-type="doi">10.1093/molehr/gal059</pub-id><pub-id pub-id-type="pmid">16829627</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Martinez</surname><given-names>SL</given-names></name><name><surname>Menendez Helman</surname><given-names>RJ</given-names></name><name><surname>Zitta</surname><given-names>KS</given-names></name><name><surname>Brandelli</surname><given-names>A</given-names></name><name><surname>Miranda</surname><given-names>PV</given-names></name><article-title>Characterization of human sperm N-acetylglucosaminidase</article-title><source>Int J Androl</source><year>2008</year><volume>31</volume><fpage>315</fpage><lpage>324</lpage><pub-id pub-id-type="doi">10.1111/j.1365-2605.2007.00766.x</pub-id><pub-id pub-id-type="pmid">17573853</pub-id></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="journal"><name><surname>Zen</surname><given-names>KC</given-names></name><name><surname>Choi</surname><given-names>HK</given-names></name><name><surname>Krishnamachary</surname><given-names>N</given-names></name><name><surname>Muthukrishnan</surname><given-names>S</given-names></name><name><surname>Kramer</surname><given-names>KJ</given-names></name><article-title>Cloning, expression, and hormonal regulation of an insect beta-N-acetylglucosaminidase gene</article-title><source>Insect Biochem Mol Biol</source><year>1996</year><volume>26</volume><fpage>435</fpage><lpage>444</lpage><pub-id pub-id-type="doi">10.1016/0965-1748(95)00111-5</pub-id><pub-id pub-id-type="pmid">8763162</pub-id></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="journal"><name><surname>Tomiya</surname><given-names>N</given-names></name><name><surname>Narang</surname><given-names>S</given-names></name><name><surname>Park</surname><given-names>J</given-names></name><name><surname>Abdul-Rahman</surname><given-names>B</given-names></name><name><surname>Choi</surname><given-names>O</given-names></name><name><surname>Singh</surname><given-names>S</given-names></name><name><surname>Hiratake</surname><given-names>J</given-names></name><name><surname>Sakata</surname><given-names>K</given-names></name><name><surname>Betenbaugh</surname><given-names>MJ</given-names></name><name><surname>Palter</surname><given-names>KB</given-names></name><name><surname>Lee</surname><given-names>YC</given-names></name><article-title>Purification, characterization, and cloning of a <italic>Spodoptera frugiperda </italic>Sf9 beta-N-acetylhexosaminidase that hydrolyzes terminal N-acetylglucosamine on the N-glycan core</article-title><source>J Biol Chem</source><year>2006</year><volume>81</volume><fpage>19545</fpage><