link ext-link-type="uri" xlink:href="http://www.bugeyedigital.com/product_index/index001-camera_acc-ad_index.html"/></citation></ref><ref id="B8"><citation citation-type="other"><article-title>PortableApps.com</article-title><ext-link ext-link-type="uri" xlink:href="http://portableapps.com/"/></citation></ref><ref id="B9"><citation citation-type="other"><article-title>PortableApps.com: VLC Media Player Portable 0.8.6d </article-title><ext-link ext-link-type="uri" xlink:href="http://portableapps.com/news/2008-02-01_-_vlc_portable_0.8.6d"/></citation></ref><ref id="B10"><citation citation-type="other"><article-title>VideoLAN: VLC media player</article-title><ext-link ext-link-type="uri" xlink:href="http://www.videolan.org/vlc/"/></citation></ref></ref-list></back></article>