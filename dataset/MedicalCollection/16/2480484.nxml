<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">J Biomol NMR</journal-id><journal-title>Journal of Biomolecular Nmr</journal-title><issn pub-type="ppub">0925-2738</issn><issn pub-type="epub">1573-5001</issn><publisher><publisher-name>Springer Netherlands</publisher-name><publisher-loc>Dordrecht</publisher-loc></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">18523727</article-id><article-id pub-id-type="pmc">2480484</article-id><article-id pub-id-type="publisher-id">9244</article-id><article-id pub-id-type="doi">10.1007/s10858-008-9244-4</article-id><article-categories><subj-group subj-group-type="heading"><subject>Article</subject></subj-group></article-categories><title-group><article-title>Self-consistent residual dipolar coupling based model-free analysis for the robust determination of nanosecond to microsecond protein dynamics</article-title></title-group><contrib-group><contrib contrib-type="author"><name name-style="western"><surname>Lakomek</surname><given-names>Nils-Alexander</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Walter</surname><given-names>Korvin F. A.</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Far&#x000e8;s</surname><given-names>Christophe</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Lange</surname><given-names>Oliver F.</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>de Groot</surname><given-names>Bert L.</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Grubm&#x000fc;ller</surname><given-names>Helmut</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Br&#x000fc;schweiler</surname><given-names>Rafael</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Munk</surname><given-names>Axel</given-names></name><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Becker</surname><given-names>Stefan</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Meiler</surname><given-names>Jens</given-names></name><xref ref-type="aff" rid="Aff5">5</xref></contrib><contrib contrib-type="author" corresp="yes"><name name-style="western"><surname>Griesinger</surname><given-names>Christian</given-names></name><address><phone>+49-551-2012201</phone><fax>+49-551-2012202</fax><email>cigr@nmr.mpibpc.mpg.de</email></address><xref ref-type="aff" rid="Aff1">1</xref></contrib><aff id="Aff1"><label>1</label>Department for NMR-based Structural Biology, Max-Planck Institute for Biophysical Chemistry, Am Fassberg 11, Goettingen, 37077 Germany </aff><aff id="Aff2"><label>2</label>Department for Theoretical and Computational Biophysics, Max-Planck Institute for Biophysical Chemistry, Goettingen, Germany </aff><aff id="Aff3"><label>3</label>NHFML, Florida State University, Tallahassee, FL USA </aff><aff id="Aff4"><label>4</label>Institut for Mathematical Stochastics, University of Goettingen, Goettingen, Germany </aff><aff id="Aff5"><label>5</label>Department of Chemistry, Center of Structural Biology, Vanderbilt University, Nashville, TN USA </aff></contrib-group><pub-date pub-type="epub"><day>4</day><month>6</month><year>2008</year></pub-date><pub-date pub-type="ppub"><month>7</month><year>2008</year></pub-date><volume>41</volume><issue>3</issue><fpage>139</fpage><lpage>155</lpage><history><date date-type="received"><day>3</day><month>3</month><year>2008</year></date><date date-type="rev-recd"><day>21</day><month>4</month><year>2008</year></date><date date-type="accepted"><day>22</day><month>4</month><year>2008</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2008</copyright-statement></permissions><abstract><p>Residual dipolar couplings (RDCs) provide information about the dynamic average orientation of inter-nuclear vectors and amplitudes of motion up to milliseconds. They complement relaxation methods, especially on a time-scale window that we have called supra-<inline-formula id="IEq1"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq1.gif --><tex-math id="M1">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> (<inline-formula id="IEq2"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq2.gif --><tex-math id="M2">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> &#x0003c; supra-<inline-formula id="IEq3"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq3.gif --><tex-math id="M3">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> &#x0003c; 50 &#x003bc;s). Here we present a robust approach called Self-Consistent RDC-based Model-free analysis (SCRM) that delivers RDC-based order parameters&#x02014;independent of the details of the structure used for alignment tensor calculation&#x02014;as well as the dynamic average orientation of the inter-nuclear vectors in the protein structure in a self-consistent manner. For ubiquitin, the SCRM analysis yields an average RDC-derived order parameter of the NH vectors <inline-formula id="IEq4"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq4.gif --><tex-math id="M4">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$  \left\langle {S_{rdc}^2 } \right\rangle = 0.72 \pm 0.02 $$\end{document}</tex-math></inline-formula> compared to <inline-formula id="IEq5"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq5.gif --><tex-math id="M5">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{LS}^2 } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.778 &#x000b1; 0.003 for the Lipari&#x02013;Szabo order parameters, indicating that the inclusion of the supra-<inline-formula id="IEq6"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq6.gif --><tex-math id="M6">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> window increases the averaged amplitude of mobility observed in the sub-<inline-formula id="IEq7"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq7.gif --><tex-math id="M7">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> window by about 34%. For the &#x003b2;-strand spanned by residues Lys48 to Leu50, an alternating pattern of backbone NH RDC order parameter <inline-formula id="IEq8"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq8.gif --><tex-math id="M8">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> = (0.59, 0.72, 0.59) was extracted. The backbone of Lys48, whose side chain is known to be involved in the poly-ubiquitylation process that leads to protein degradation, is very mobile on the supra-<inline-formula id="IEq9"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq9.gif --><tex-math id="M9">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> time scale (<inline-formula id="IEq10"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq10.gif --><tex-math id="M10">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> = 0.59 &#x000b1; 0.03), while it is inconspicuous (<inline-formula id="IEq11"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq11.gif --><tex-math id="M11">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula> = 0.82) on the sub-<inline-formula id="IEq12"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq12.gif --><tex-math id="M12">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> as well as on &#x003bc;s&#x02013;ms relaxation dispersion time scales. The results of this work differ from previous RDC dynamics studies of ubiquitin in the sense that the results are essentially independent of structural noise providing a much more robust assessment of dynamic effects that underlie the RDC data.</p><sec><title>Electronic supplementary material</title><p>The online version of this article (doi:10.1007/s10858-008-9244-4) contains supplementary material, which is available to authorized users.</p></sec></abstract><kwd-group><title>Keywords</title><kwd>Dynamics</kwd><kwd>Proteins</kwd><kwd>RDCs</kwd><kwd>Structural noise</kwd><kwd>Ubiquitin</kwd></kwd-group><custom-meta-wrap><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; Springer Science+Business Media B.V. 2008</meta-value></custom-meta></custom-meta-wrap></article-meta></front><body><sec id="Sec1" sec-type="introduction"><title>Introduction</title><p>Insight in protein dynamics is crucial for understanding protein function (Palmer <xref ref-type="bibr" rid="CR55">2004</xref>). NMR relaxation methods provide ideal tools for studying motions faster than the overall tumbling correlation time of a protein, i.e. sub-<inline-formula id="IEq13"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq13.gif --><tex-math id="M13">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> motion (<inline-formula id="IEq14"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq14.gif --><tex-math id="M14">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> is ca. 4 ns for ubiquitin at room temperature). Such motion has been proposed to contribute mostly to the entropy of proteins (Schneider et al. <xref ref-type="bibr" rid="CR65">1992</xref>; Li et al. <xref ref-type="bibr" rid="CR39">1996</xref>; Prompers and Br&#x000fc;schweiler <xref ref-type="bibr" rid="CR59">2000</xref>; Lee and Wand <xref ref-type="bibr" rid="CR37">2001</xref>). Slow time scale motion (ca. 50 &#x003bc;s up to several ms) can be probed by relaxation dispersion measurements (Akke and Palmer <xref ref-type="bibr" rid="CR1">1996</xref>; Kay <xref ref-type="bibr" rid="CR30">1998</xref>; Kay et al. <xref ref-type="bibr" rid="CR31">1989</xref>; Palmer <xref ref-type="bibr" rid="CR55">2004</xref>). These experiments isolate the contribution of conformation-dependent modulation of isotropic chemical shifts to NMR line widths from alternative spin-spin or spin-lattice relaxation effects. Such relaxation dispersion experiments are sensitive to conformational changes of proteins in catalytic cycles (Eisenmesser et al. <xref ref-type="bibr" rid="CR22">2005</xref>; Henzler-Wildman et al. <xref ref-type="bibr" rid="CR24">2007</xref>; Kern et al. <xref ref-type="bibr" rid="CR32">2005</xref>; Kern and Zuiderweg <xref ref-type="bibr" rid="CR33">2003</xref>; Mulder et al. <xref ref-type="bibr" rid="CR51">2002</xref>; Stevens et al. <xref ref-type="bibr" rid="CR69">2001</xref>; Tollinger et al. <xref ref-type="bibr" rid="CR72">2001</xref>). Slow time scale motions have also been detected in several cross-correlated relaxation experiments (Dittmer and Bodenhausen <xref ref-type="bibr" rid="CR20">2004</xref>; Ferrage et al. <xref ref-type="bibr" rid="CR23">2006</xref>; Pelupessy et al. <xref ref-type="bibr" rid="CR56">2003</xref>).</p><p>Relaxation methods are not suitable for the study of dynamics between the sub-<inline-formula id="IEq15"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq15.gif --><tex-math id="M15">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> and the relaxation dispersion time scale. This time scale window can thus far only be addressed by measurements of residual dipolar couplings (RDCs) as they are time-averaged from femtoseconds up to milliseconds (Blackledge <xref ref-type="bibr" rid="CR5">2005</xref>; Tolman and Ruan <xref ref-type="bibr" rid="CR76">2006</xref>). It has been proposed that this time window could be relevant for protein&#x02013;protein recognition (Bertoncini et al. <xref ref-type="bibr" rid="CR4">2005</xref>; Bouvignies et al. <xref ref-type="bibr" rid="CR8">2005b</xref>). After the renaissance of RDCs in liquid-state protein NMR spectroscopy (Tjandra and Bax <xref ref-type="bibr" rid="CR71">1997</xref>; Tolman et al. <xref ref-type="bibr" rid="CR74">1995</xref>), the potential of RDCs to study protein dynamics has been recognized (Tolman et al. <xref ref-type="bibr" rid="CR75">1997</xref>) and several methods have been developed to extract dynamic information from RDCs: The RDC-based model-free approach relies on the measurement of NH RDCs for five linearly independent alignment tensor orientations in at least five different media (Meiler et al. <xref ref-type="bibr" rid="CR49">2001</xref>; Peti et al. <xref ref-type="bibr" rid="CR58">2002</xref>; Lakomek et al. <xref ref-type="bibr" rid="CR36">2005</xref>, <xref ref-type="bibr" rid="CR35">2006</xref>). Using a high-resolution structure to determine the alignment tensors, structural as well as dynamic information can be deduced. The Direct Interpretation of Dipolar Couplings (DIDC) approach (Tolman <xref ref-type="bibr" rid="CR73">2002</xref>) is conceptually similar but does not require a structural model of the protein. Both the structural and dynamical models as well as the underlying alignment tensors are obtained simultaneously. The DIDC approach minimizes the variation of RDC-based order parameters (see, e.g., Tolman <xref ref-type="bibr" rid="CR73">2002</xref>, Eq.&#x000a0;15)<italic>.</italic> This is also true for a recent extension of this approach (Yao et al. <xref ref-type="bibr" rid="CR80">2008</xref>). In an alternative model-based approach several RDCs for protein G (Ulmer et al. <xref ref-type="bibr" rid="CR78">2003</xref>) were fitted using a three-dimensional Gaussian Axial Fluctuation (3D GAF) model (Bouvignies et al. <xref ref-type="bibr" rid="CR8">2005b</xref>). These studies strongly suggest that RDC-derived order parameters are on average smaller than the relaxation-derived order parameters, indicating the presence of supra-<inline-formula id="IEq16"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq16.gif --><tex-math id="M16">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> motion. In a follow-up study, Blackledge and co-workers were able to determine the average protein backbone conformation and the nature and extent of motional disorder about this average structure ab initio from measured RDCs for protein G, using their dynamic-meccano approach and assuming fixed peptide plane geometry (Bouvignies et al. <xref ref-type="bibr" rid="CR9">2006</xref>, <xref ref-type="bibr" rid="CR10">2007</xref>).</p><p>Recently, high mobility in the sub-microsecond time scale was detected using heteronuclear dipolar couplings for the ubiquitin backbone in the microcrystalline state (Lorieau and McDermott <xref ref-type="bibr" rid="CR41">2006</xref>). Furthermore, several promising approaches have been undertaken to combine or compare RDC information with motional models derived from molecular dynamics simulations (Bouvignies et al. <xref ref-type="bibr" rid="CR10">2007</xref>; Markwick et al. <xref ref-type="bibr" rid="CR47">2007</xref>; Nederveen and Bonvin <xref ref-type="bibr" rid="CR52">2005</xref>; Showalter and Br&#x000fc;schweiler <xref ref-type="bibr" rid="CR66">2007a</xref>, <xref ref-type="bibr" rid="CR67">b</xref>; Showalter et al. <xref ref-type="bibr" rid="CR68">2007</xref>). Loop dynamics comparable to or longer than <inline-formula id="IEq17"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq17.gif --><tex-math id="M17">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> have been observed for the backbone of ubiquitin in an 1.2 &#x003bc;s explicit solvent MD simulation very recently (Maragakis et al. <xref ref-type="bibr" rid="CR46">2008</xref>).</p><p>For the model-free approach (Meiler et al. <xref ref-type="bibr" rid="CR49">2001</xref>; Peti et al. <xref ref-type="bibr" rid="CR58">2002</xref>; Lakomek et al. <xref ref-type="bibr" rid="CR36">2005</xref>, <xref ref-type="bibr" rid="CR35">2006</xref>), it was suggested that structural noise introduced by the usage of a single high-resolution structure may contribute a systematic error (Bouvignies et al. <xref ref-type="bibr" rid="CR7">2005a</xref>; Clore <xref ref-type="bibr" rid="CR15">2004</xref>; Clore and Schwieters <xref ref-type="bibr" rid="CR16">2006</xref>; Zweckstetter and Bax <xref ref-type="bibr" rid="CR83">2002</xref>). Therefore, the major focus of the present work is to introduce a Self-Consistent RDC-based Model-free (SCRM) analysis to alleviate this model bias. This analysis is here applied to the protein ubiquitin.</p></sec><sec id="Sec2" sec-type="materials|methods"><title>Materials and methods</title><sec id="Sec3"><title>Experimental part</title><sec id="Sec4"><title>Alignment media preparation</title><p>All together, 36 NH RDC data sets from the backbone of the wild-type human ubiquitin were available for the new SCRM analysis. Previous measurements (Peti et al. <xref ref-type="bibr" rid="CR58">2002</xref>), data sets D1&#x02013;D5 in (Lakomek et al. 2006) were replaced by measurements with increased concentration of ubiquitin.</p><p><sup>15</sup>N,<sup>13</sup>C-labeled human ubiquitin (wt) was expressed according to (Johnson et al. <xref ref-type="bibr" rid="CR28">1999</xref>). Thirteen new alignment conditions, A1&#x02013;A13, were prepared as described in the following. In every case, 2.5 mg of ubiquitin were dissolved in a 50 mM Na phosphate buffer at pH 6.5. The final ubiquitin concentration varied between 0.75 and 0.9 mM, and 10&#x02013;20% (v/v) D<sub>2</sub>O were added for field locking. The following briefly describes the individual new alignment conditions.<list list-type="bullet"><list-item><p>A1: A 7% positively charged gel sample was prepared according to (Cierpicki and Bushweller <xref ref-type="bibr" rid="CR14">2004</xref>). The positive charge was introduced by addition of (3-acrylamidopropyl)-trimethylammonium chloride (APTMAC, Sigma-Aldrich, Inc.) in a ratio of APTMAC:acrylamide = 1:3.</p></list-item><list-item><p>A2: A 7% positively charged gel was prepared as for A1 but with a ratio APTMAC:acrylamide = 1:1.</p></list-item><list-item><p>A3: A 5% negatively charged gel was prepared according to (Cierpicki and Bushweller <xref ref-type="bibr" rid="CR14">2004</xref>). The negative charge was introduced by addition of acrylic acid (Sigma-Aldrich, Inc.) in a ratio of acrylic acid: acryl amide = 1:1.</p></list-item><list-item><p>A4: The ubiquitin solution was added to dodecyl-penta(ethylene glycol) (C12E5) stock solution (15% w/v) in a ratio of 2:1 and vortexed. The solution became opalescent after addition of 1.5% (v/v) hexanol (Ruckert and Otting <xref ref-type="bibr" rid="CR63">2000</xref>).</p></list-item><list-item><p>A5: Ubiquitin was dissolved in a suspension of 25 mg/ml Pf-1 phage (ASLA Ltd., Riga, Lativa) in 50 mM Na phosphate buffer with 100 mM NaCl (Zweckstetter and Bax <xref ref-type="bibr" rid="CR82">2001</xref>).</p></list-item><list-item><p>A6: Same as A5 but with a Pf-1 phage concentration of 20 mg/ml.</p></list-item><list-item><p>A7: A 1,2-dimyristoyl-sn-glycero-3-phosphatidylcholine (DMPC)/1,2-dihexanoyl-sn-glycero-3-phosphatidylcholine (DHPC) = 3:1 mixture (Avanti Polar Lipids, Alabama) of 15% w/v was dissolved in buffer containing 50 mM NaCl and 50 mM Na phosphate buffer (pH = 6.5) with 0.02% sodium azide, and 10% D<sub>2</sub>O. The final ubiquitin concentration was 0.9 mM (Triba et al. <xref ref-type="bibr" rid="CR77">2005</xref>).</p></list-item><list-item><p>A8: DMPC, DHPC and SDS (sodium dodecyl sulfate, Serva, Heidelberg, Germany) were mixed in a ratio of 30:10:2 and dissolved in a 50 mM Na phosphate buffer with pH = 6.5, containing 15&#x02013;20% D<sub>2</sub>O until a total lipid concentration of 5%(w/v) was reached. The composition was vortexed at 0&#x000b0;C until the solution became clear. Ubiquitin was dispersed in this solution with a final concentration of 0.75 mM.</p></list-item><list-item><p>A9&#x02013;A13: Bicelle media were prepared similarly to A7 and A8. Ingredients and total lipid concentration can be found in Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>. The ubiquitin concentration was 0.75 mM.<table-wrap id="Tab1"><label>Table&#x000a0;1</label><caption><p>Bicelle media preparation (See chapter Materials and methods, alignment media preparation)</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Alignment condition</th><th align="left">Liquid crystalline media</th><th align="left">Mixing ratio</th><th align="left">Total lipid concentration/(w/v), (%)</th></tr></thead><tbody><tr><td align="left">A9</td><td align="left">DLPC:DHPC:SDS</td><td align="left">30:10:2</td><td char="." align="char">10</td></tr><tr><td align="left">A10</td><td align="left">DMPC:DHPC:C14PC</td><td align="left">30:10:1</td><td char="." align="char">5</td></tr><tr><td align="left">A11</td><td align="left">DMPC:DHPC:C14PC</td><td align="left">30:10:2</td><td char="." align="char">10</td></tr><tr><td align="left">A12</td><td align="left">DMPC:CHAPSO:CTAB</td><td align="left">50:10:1</td><td char="." align="char">10</td></tr><tr><td align="left">A13</td><td align="left">DMPC:DHPC:CTAB</td><td align="left">30:10:1</td><td char="." align="char">8</td></tr></tbody></table><table-wrap-foot><p>The following abbreviation are used, additionally to those already explained before: C14PC = tetradecylphosphatidylcholine, CHAPSO = 3-[(3-cholamidopropyl)dimethylammonio]-2-hydroxyl-1-propanesulfonate (Sigma-Aldrich, Inc.), CTAB = N-cetyl-N,N,N-trimethylammonium bromide (Roth, Karlsruhe, Germany)</p></table-wrap-foot></table-wrap></p></list-item></list></p><p>To complement the data sets obtained from these alignment conditions (in order to better span the 5-dimensional RDC space) the following data sets have been used: A14&#x02013;A18: NH data set E1 to E5 measured in a previous analysis (Lakomek et al. <xref ref-type="bibr" rid="CR35">2006</xref>).</p><p>A19&#x02013;A36: NH RDC data sets published by Bax and coworkers (Ottiger et al. <xref ref-type="bibr" rid="CR53">1998</xref>) and Tolman and coworkers (Ruan and Tolman <xref ref-type="bibr" rid="CR62">2005</xref>; Briggman and Tolman <xref ref-type="bibr" rid="CR11">2003</xref>).</p><p>The collection of 36 NH RDC data sets will be referred to as D36M. A table containing all NH RDC data sets used for the analysis is provided in the Supporting Information (Table S5). All relevant alignment conditions used for the different data sets are listed in a second table in the Supporting Information (Table S6).</p></sec><sec id="Sec5"><title>NMR Spectroscopy</title><p>NH RDC data for all new aligned media A1&#x02013;A13 as well as the isotropic reference experiment were measured using 2D-IPAP-<sup>15</sup>N,<sup>1</sup>H-HSQC experiments (Ottiger and Bax <xref ref-type="bibr" rid="CR54">1998</xref>). All data were recorded at a sample temperature of 308 K. Measurements were performed on either a Bruker-Avance 700 MHz (Bruker AG, Karlsruhe, Germany), a Bruker-DRX 600 MHz or a Bruker-Avance 600 MHz spectrometer equipped with a TXI cryogenic probe head or a Bruker 800 MHz spectrometer equipped with a TCI cryogenic probe head. The time domain was either TD1&#x000a0;&#x000d7;&#x000a0;TD2 = 1 k&#x000a0;&#x000d7;&#x000a0;2 k or TD1&#x000a0;&#x000d7;&#x000a0;TD2 = 2 k &#x000d7; 2 k with a spectral width of <inline-formula id="IEq18"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq18.gif --><tex-math id="M18">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \Upomega 1 \times \Upomega 2 $$\end{document}</tex-math></inline-formula> = 25 ppm &#x000d7; 15 ppm (besides <inline-formula id="IEq19"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq19.gif --><tex-math id="M19">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \Upomega 1 \times \Upomega 2 $$\end{document}</tex-math></inline-formula> = 30 ppm &#x000d7; 15 ppm for data set A5 and A6). The number of scans was 32 and higher.</p><p>For processing, data were zero-filled to TD1&#x000a0;&#x000d7;&#x000a0;TD2 = 32&#x000a0;k&#x000a0;&#x000d7;&#x000a0;4 k and processed with the NMRPipe software package (Delaglio et al. <xref ref-type="bibr" rid="CR19">1995</xref>). <italic>(J + D)</italic>- and <italic>J</italic>-coupling constants were extracted using NMRPipe. One-bond <sup>15</sup>N, <sup>1</sup>H RDCs were derived from the difference in coupling between aligned samples and the isotropic sample. The experimental error was conservatively estimated to be less than 0.3 Hz. Alignment tensors were calculated using the software PALES (Zweckstetter and Bax <xref ref-type="bibr" rid="CR81">2000</xref>).</p></sec><sec id="Sec6"><title>SECONDA analysis</title><p>In order to quantify the similarity of structure and dynamics in the different alignment media (homogeneity of RDC data), a SECONDA analysis was applied (Hus and Br&#x000fc;schweiler <xref ref-type="bibr" rid="CR26">2002</xref>; Hus et al. <xref ref-type="bibr" rid="CR27">2003</xref>). The SECONDA method analyzes the covariance matrix constructed of all RDC data obtained under different alignment conditions. It performs a principal component analysis (PCA) of the RDC covariance matrix, which is equivalent to a singular value decomposition (SVD) of the RDC matrix. The singular values are sorted according to decreasing size. Structural and dynamic information is contained in the first five singular values, since dipolar couplings are a second rank symmetric tensor interaction and hence reside in a linear 5-dimensional space. Accordingly, only noise, systematic errors, and structural and dynamic heterogeneity may cause the 6th and higher singular values to differ from zero. The ratio of the 5th and 6th singular values (called SECONDA gap in the following) is a measure of the homogeneity of RDC data and the magnitude of noise. The larger the SECONDA gap, the more self-consistent are the RDC data in the different alignment media.</p><p>For D36M, the SECONDA gap was 5.66 after normalization. Starting from these 36 NH RDC data sets, a subset of 23 NH RDC data sets (D23M) was selected that increased homogeneity of the RDC data with still adequate sampling of alignment tensor orientations in the 5-dimensional tensor-space (as described in the Supporting Information). The data sets contained in the subset D23M are displayed in Table S5 in the Supporting Information. The SECONDA gap of subset D23M was 6.81 after normalization.</p></sec></sec><sec id="Sec7"><title>Self-Consistent RDC-based Model-free (SCRM) approach</title><p>The Self-Consistent RDC-based Model-free (SCRM) method was developed from the theory of the original RDC-based model-free approach. RDCs are measured in at least five linear independent alignment conditions for each single inter-nuclear vector (e.g. the NH). The RDC-based model-free approach extracts dynamically averaged second order spherical harmonics <inline-formula id="IEq20"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq20.gif --><tex-math id="M20">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {Y_{2,M} } \right.(\theta ,\phi \left. ) \right\rangle $$\end{document}</tex-math></inline-formula> from these RDCs,<disp-formula id="Equ1"><label>1.1</label><tex-math id="M21">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {D_{}^{\exp } } \right\rangle = \sqrt {\frac{{4\pi }}{5}} D_{zz} \left\{ {\left\langle {Y_{2,0} (\theta ,\varphi )} \right\rangle } \right. + \sqrt {\frac{3}{8}} R\left. {\left( {\left\langle {Y_{2,2} (\theta ,\varphi )} \right\rangle + \left\langle {Y_{2, - 2} (\theta ,\varphi )} \right\rangle } \right)} \right\}. $$\end{document}</tex-math></disp-formula></p><p>For each NH vector <italic>j,</italic> the five averaged second order spherical harmonics <inline-formula id="IEq21"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq21.gif --><tex-math id="M22">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {Y_{2,M} } \right.(\theta _j^{mol} ,\phi _j^{mol} \left. ) \right\rangle $$\end{document}</tex-math></inline-formula> are derived by solving the F-matrix equation (1.2). This equation describes for each alignment condition the residual dipolar coupling equation (1.1) in the molecular frame. The F-Matrix relates the spherical harmonics in the molecular frame to the measured RDCs by a Wigner rotation from the molecular frame to the alignment frame (Lakomek et al. <xref ref-type="bibr" rid="CR35">2006</xref>; Meiler et al. <xref ref-type="bibr" rid="CR49">2001</xref>):<disp-formula id="Equ2"><label>1.2</label><tex-math id="M23">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \frac{{D_{ij}^{\exp } }}{{D_{i,zz} }} = \sum\limits_{M = - 2}^2 {F_{i,M} } \left\langle {Y_{2,M} } \right.(\theta _j^{mol} ,\phi _j^{mol} \left. ) \right\rangle $$\end{document}</tex-math></disp-formula>with<disp-formula id="Equ3"><label>1.3</label><tex-math id="M24">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \begin{gathered} F_{i,M} = \sqrt {\frac{{4\pi }}{5}} \left( {D_{M0}^2 (\alpha ^i ,\beta ^i ,\gamma ^i ) + \sqrt {\frac{3}{8}} R\left( {D_{M2}^2 (\alpha ^i ,\beta ^i ,\gamma ^i )} \right. + \left. {D_{M - 2}^2 (\alpha ^i ,\beta ^i ,\gamma ^i )} \right)} \right) \hfill \\ = \sqrt {\frac{{4\pi }}{5}} \left( {e^{ - iM\alpha ^i } d_{M0}^2 (\beta ^i ) + \sqrt {\frac{3}{8}} R(e^{ - iM\alpha ^i } d_{M2}^2 (\beta ^i )e^{ - 2i\gamma ^i } + e^{ - iM\alpha ^i } d_{M - 2}^2 (\beta ^i )e^{2i\gamma ^i } )} \right). \hfill \\ \end{gathered} $$\end{document}</tex-math></disp-formula></p><p>From the dynamically averaged spherical harmonics, RDC-based order parameters <inline-formula id="IEq22"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq22.gif --><tex-math id="M25">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> are determined which are sensitive to all motions faster than the millisecond time scale. This is in contrast to Lipari&#x02013;Szabo order parameters <inline-formula id="IEq23"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq23.gif --><tex-math id="M26">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula> (Lipari and Szabo <xref ref-type="bibr" rid="CR40">1982</xref>) obtained from relaxation measurements which are only sensitive up to the overall tumbling correlation time <inline-formula id="IEq24"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq24.gif --><tex-math id="M27">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> (ca. 4 ns for ubiqutin at room temperature):<disp-formula id="Equ4"><label>1.4</label><tex-math id="M28">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \begin{gathered} S_{rdc}^2 = \frac{{4\pi }}{5}\sum\limits_{M = - 2}^2 {\left. {\left\langle {Y_{2,M} \left( {\theta ,\phi } \right)} \right\rangle } \right|_{ps}^{ms} \left. {\left\langle {Y_{2,M}^* \left( {\theta ,\phi } \right)} \right\rangle } \right|_{ps}^{ms} } \hfill \\ S_{LS}^2 = \frac{{4\pi }}{5}\sum\limits_{M = - 2}^2 {\left. {\left\langle {Y_{2,M} \left( {\theta ,\phi } \right)} \right\rangle } \right|_{ps}^{\tau _c } \left. {\left\langle {Y_{2,M}^* \left( {\theta ,\phi } \right)} \right\rangle } \right|_{ps}^{\tau _c } } \hfill \\ \end{gathered} $$\end{document}</tex-math></disp-formula></p><p>In addition to RDC-based order parameters <inline-formula id="IEq25"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq25.gif --><tex-math id="M29">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula>, the dynamic average orientations of inter-nuclear vectors can also be determined. After performing a coordinate transformation that maximizes <inline-formula id="IEq26"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq26.gif --><tex-math id="M30">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {Y_{2,0} \left( {\theta ^\prime ,\phi ^\prime } \right)} \right\rangle $$\end{document}</tex-math></inline-formula>, the NH vector points along the z&#x02032; axis of the new primed reference frame:<disp-formula id="Equ5"><label>1.5</label><tex-math id="M31">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \begin{aligned} \max \left\langle {Y_{2,0} \left( {\theta ^\prime ,\phi ^\prime } \right)} \right\rangle &#x00026; = \sum\limits_{M = - 2}^2 {D_{M,0} \left( {\phi _{av} ,\theta _{av} ,0} \right)} \left\langle {Y_{2,M} \left( {\theta ,\phi } \right)} \right\rangle \\ &#x00026; = \sqrt {\frac{{4\pi }}{5}} \sum\limits_{M = - 2}^2 {Y_{2,M}^* } \left( {\theta _{av} ,\phi _{av} } \right)\left\langle {Y_{2,M} \left( {\theta ,\phi } \right)} \right\rangle . \\ \end{aligned} $$\end{document}</tex-math></disp-formula></p><p>The first and second Euler angle of the respective Wigner rotation <inline-formula id="IEq27"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq27.gif --><tex-math id="M32">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{M,0} \left( {\phi _{av}^{} ,\theta _{av}^{} ,0} \right) $$\end{document}</tex-math></inline-formula> corresponds to the dynamic average orientation of the inter-nuclear NH vector <inline-formula id="IEq28"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq28.gif --><tex-math id="M33">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left( {\phi _{av} ,\theta _{av} } \right) $$\end{document}</tex-math></inline-formula>. Furthermore, the amplitude <italic>&#x003b7;</italic> and direction of anisotropy <inline-formula id="IEq29"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq29.gif --><tex-math id="M34">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \phi _{rdc}^{} $$\end{document}</tex-math></inline-formula> (Lakomek et al. <xref ref-type="bibr" rid="CR35">2006</xref>; Peti et al. <xref ref-type="bibr" rid="CR58">2002</xref>) are determined.</p><p>The goal of the Self-Consistent RDC-based Model-free (SCRM) approach was to remove a possible bias due to the protein structure used for the initial determination of the alignment tensors. To this aim, we proceeded as follows. The first step of the SCRM method was the application of the standard RDC-based model-free analysis as described in (Lakomek et al. <xref ref-type="bibr" rid="CR35">2006</xref>): First, alignment tensors were calculated from the measured RDCs using the PALES (Zweckstetter and Bax <xref ref-type="bibr" rid="CR81">2000</xref>) or DipoCoup software (Meiler et al. <xref ref-type="bibr" rid="CR48">2000</xref>) and from the X-ray structure&#x000a0;1ubi (Ramage et al. <xref ref-type="bibr" rid="CR61">1994</xref>) to which protons were added with MOLMOL (Koradi et al. <xref ref-type="bibr" rid="CR34">1996</xref>). Naturally, the dynamically averaged orientations <inline-formula id="IEq30"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq30.gif --><tex-math id="M35">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left( {\phi _{av} ,\theta _{av} } \right) $$\end{document}</tex-math></inline-formula> calculated from the RDC-based model-free approach will exhibit deviations from the orientations in the X-ray structure. In an iterative fashion, the NH vector orientations used for the tensor calculation were replaced by the resulting <inline-formula id="IEq31"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq31.gif --><tex-math id="M36">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left( {\phi _{av} ,\theta _{av} } \right) $$\end{document}</tex-math></inline-formula> after each model-free analysis cycle (Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>).<fig id="Fig1"><label>Fig.&#x000a0;1</label><caption><p>Sketch of the SCRM cycles: RDC-based model-free results are calculated using NH RDC data as well as inter-nuclear NH vectors for tensor calculation. Starting from a first structural model (e.g. the X-ray structure&#x000a0;1ubi with protons added with standard geometry), the inter-nuclear NH vector orientations are adjusted in each SCRM cycle towards the true dynamic average orientation. Consequently, the fit of the alignment tensor to the RDC data is improved in each step and as result the fit of the model-free results to the RDCs as well</p></caption><graphic position="anchor" xlink:href="10858_2008_9244_Fig1_HTML" id="MO6"/></fig></p><p>An N&#x02013;H bond length of 1.04 &#x000c5; (Ottiger and Bax <xref ref-type="bibr" rid="CR54">1998</xref>) has been used to calculate the new proton coordinates. (Note that the SCRM results are independent of the used bond-length.)</p><p>Each cycle <italic>i</italic> of model-free analysis an alignment tensor recalculation was conducted until convergence of the order parameters <inline-formula id="IEq32"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq32.gif --><tex-math id="M37">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$\left| {S_{rdc,i}^2 - S_{rdc,i - 1}^2 } \right| = \frac{1}{n}\sum\nolimits_{j = 1}^n {\left| {S_{rdc,i}^2 (NH_j ) - S_{rdc,i - 1}^2 (NH_j )} \right|} \le 0.01 \hfill \\ \hfill \\ $$\end{document}</tex-math></inline-formula> was achieved. Note that in every step of the SCRM approach the five time-averaged second order spherical harmonics are calculated in the same way as in the original rdc-based model-free approach for each residue. From those the five rdc-based model-free parameters <inline-formula id="IEq33"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq33.gif --><tex-math id="M38">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 ,\phi _{av} ,\theta _{av} ,\eta ,\phi _{rdc}^\prime $$\end{document}</tex-math></inline-formula> are derived. In the following discussion we will focus on the first three parameters <inline-formula id="IEq34"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq34.gif --><tex-math id="M39">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> and <inline-formula id="IEq35"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq35.gif --><tex-math id="M40">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left( {\phi _{av} ,\theta _{av} } \right) $$\end{document}</tex-math></inline-formula>.</p><p>The SCRM procedure was implemented in a semi-automated manner using a Mathematica 5.2 protocol, PALES, and several Python scripts. To assess the fit of the alignment tensor to the experimental RDC data, static Q-factors <inline-formula id="IEq36"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq36.gif --><tex-math id="M41">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ Q_{static} = \sqrt 2 R_{dip} $$\end{document}</tex-math></inline-formula> as defined in (Bax and Grishaev <xref ref-type="bibr" rid="CR3">2005</xref>) and the Pearson correlation coefficients <italic>&#x003c1;</italic> were extracted from PALES after each cycle. Additional criteria and error measures were implemented for the SCRM analysis as explained below.</p><sec id="Sec8"><title>Back-calculated RDCs and dynamic Q-values assess the fitting quality of SCRM</title><p>RDCs were back-calculated from the time-averaged second order spherical harmonics <inline-formula id="IEq37"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq37.gif --><tex-math id="M42">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {Y_{2,M} } \right.(\theta ,\phi \left. ) \right\rangle $$\end{document}</tex-math></inline-formula> (Eq.&#x000a0;1.1). Consistency of the model-free approach on a per-residue-basis (running index j) was assessed by computing the root mean square deviation (rmsd) between back-calculated RDCs <italic>D</italic><sub><italic>MF</italic></sub> and experimental RDCs <italic>D</italic><sub><italic>exp</italic></sub> (RDC-rmsd):<disp-formula id="Equ6"><label>1.6</label><tex-math id="M43">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ rmsd(rdc,j) = \sqrt {\frac{{\sum\nolimits_{i = 1}^K {(D_{i,j,MF} - D_{i,j,\exp } )^2 } }}{K}} $$\end{document}</tex-math></disp-formula>where <italic>K</italic> is the number of alignment media. We also introduced <italic>dynamic</italic> Q-values <inline-formula id="IEq38"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq38.gif --><tex-math id="M44">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ Q_{dyn} $$\end{document}</tex-math></inline-formula> utilizing the <italic>D</italic><sub><italic>MF</italic></sub> RDCs:<disp-formula id="Equ7"><label>1.7</label><tex-math id="M45">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ Q_{dyn,i} = \sqrt {\frac{{\sum\nolimits_{j = 1}^N {(D_{ij,MF} - D_{ij\exp } )^2 } }}{{\sum\nolimits_{j = 1}^N {D_{ij,\exp }^2 } }}} $$\end{document}</tex-math></disp-formula>where <italic>N</italic> is the number of RDCs available in medium <italic>i</italic>. The <italic>dynamic</italic> Q-value <inline-formula id="IEq39"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq39.gif --><tex-math id="M46">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ Q_{dyn} $$\end{document}</tex-math></inline-formula> measures the quality of fit of the model-free solution for the different alignment media. It is a straightforward extension of the well-known Q-value that measures the quality of fit of experimental RDCs over a single static structure.</p></sec><sec id="Sec9"><title>Error calculation for the SCRM analysis</title><p>To estimate the error of the RDC-based order parameters <inline-formula id="IEq40"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq40.gif --><tex-math id="M47">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (j) $$\end{document}</tex-math></inline-formula> for each residue <italic>j</italic>, the experimental error was modelled by adding Gaussian noise to the measured RDCs. The input RDCs with added noise <inline-formula id="IEq41"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq41.gif --><tex-math id="M48">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{i,j,noise} $$\end{document}</tex-math></inline-formula> were generated by drawing N = 1000 random samples <inline-formula id="IEq42"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq42.gif --><tex-math id="M49">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{i,j,noise} = random [p (D_{i,j} )] $$\end{document}</tex-math></inline-formula> from a Gaussian distribution <inline-formula id="IEq43"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq43.gif --><tex-math id="M50">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ p(D) $$\end{document}</tex-math></inline-formula> with standard deviation <inline-formula id="IEq44"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq44.gif --><tex-math id="M51">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \sigma _j $$\end{document}</tex-math></inline-formula>.</p><p>Two different standard deviations <inline-formula id="IEq45"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq45.gif --><tex-math id="M52">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \sigma _j $$\end{document}</tex-math></inline-formula> were considered to study the propagation of different sources of errors to the SCRM derived order parameters: first, in order to assess the impact of the experimental error from the RDC data alone <inline-formula id="IEq46"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq46.gif --><tex-math id="M53">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \sigma _j^{\exp } $$\end{document}</tex-math></inline-formula>&#x000a0;= 0.3 Hz was used. Second, the residue-specific <inline-formula id="IEq47"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq47.gif --><tex-math id="M54">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \sigma _j^{rmsd} = rmsd(rdc,j) $$\end{document}</tex-math></inline-formula> was used in order to assess the combined effect of experimental error and additional systematic errors introduced by the model-free analysis. Examples for the latter are a possible correlation between alignment tensor fluctuations and internal dynamics, or the single tensor approximation. This analysis was repeated N = 1000 times. The error is evaluated as the standard deviation of the resulting N = 1000 <inline-formula id="IEq48"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq48.gif --><tex-math id="M55">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (j) $$\end{document}</tex-math></inline-formula>:<disp-formula id="Equ8"><label>1.8</label><tex-math id="M56">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \Updelta S_{rdc}^2 (j)\, = \,\sqrt {\frac{1}{N}\sum\limits_{k = 1}^N {\left( {S_{rdc,k}^2 (j) - \left\langle {S_{rdc}^2 (j)} \right\rangle } \right)^2 } } . $$\end{document}</tex-math></disp-formula></p></sec><sec id="Sec10"><title>Selection of the set of RDCs for alignment tensor calculation</title><p>The RDC-based model-free analysis assumes that internal protein dynamics of the backbone NH vectors are not correlated with the alignment tensor modulations. This assumption allows working with a single average alignment tensor for each medium. Simulations indicated that this assumption is correct for secondary structure elements, at least for steric alignment (Louhivuori et al. <xref ref-type="bibr" rid="CR42">2006</xref>; Salvatella et al. <xref ref-type="bibr" rid="CR64">2008</xref>). Correlations between alignment tensor fluctuations and backbone NH vector dynamics have been observed only for more mobile loop regions in ubiquitin (Salvatella et al. <xref ref-type="bibr" rid="CR64">2008</xref>). Consequently, we excluded the most mobile residues from the alignment tensor calculation. However, reducing the number of residues from which the alignment tensor is determined may lead to an inhomogeneous sampling of the three principal axes and may amplify structural noise. Thus, a consensus set of RDCs had to be found, which provides a nearly complete sampling of orientations while still avoiding correlations between tensor modulations and internal protein dynamics.</p><p>To this end, we followed an approach similar to the one introduced by (Bouvignies et al. <xref ref-type="bibr" rid="CR8">2005b</xref>): In a first step, alignment tensors are calculated using the experimental data for all residues 2&#x02013;72. (The highly flexible C-terminus of ubiquitin (residues 73&#x02013;76) was always excluded.) Four iterations of the SCRM protocol were performed. Then, the 20% most mobile residues (<inline-formula id="IEq49"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq49.gif --><tex-math id="M57">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc,unscaled}^2 \le 0.95 $$\end{document}</tex-math></inline-formula>) were excluded from the alignment tensor calculation and the SCRM analysis was re-started using the remaining set of residues for alignment tensor calculation. To ensure an adequate sampling of the three principal axes of the alignment tensor, an eigenvalue analysis of the matrix<disp-formula id="Equ9"><label>1.9</label><tex-math id="M58">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ {\mathbf{C}} = {\mathbf{B}}^T {\mathbf{B}} $$\end{document}</tex-math></disp-formula>where <inline-formula id="IEq50"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq50.gif --><tex-math id="M59">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ {\mathbf{B}} = ({\mathbf{e}}_1 ,{\mathbf{e}}_2 , \ldots {\mathbf{e}}_N) $$\end{document}</tex-math></inline-formula> is the 3&#x000d7; N matrix containing the normalized NH vectors of the average structure, was performed and the diagonalized matrix <italic>D = (d(1),d(2),d(3))</italic> was obtained that contains the three eigenvalues of <bold><italic>C</italic></bold> sorted according to magnitude (see Prompers and Br&#x000fc;schweiler <xref ref-type="bibr" rid="CR60">2002</xref>). It was ensured that the selected base of residues adequately samples the three tensor axes as described in the Supporting Information.</p></sec><sec id="Sec11"><title>Determination of <inline-formula id="IEq51"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq51.gif --><tex-math id="M60">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{overall} $$\end{document}</tex-math></inline-formula></title><p>Since experimental RDCs are scaled by internal motion and the alignment tensor is determined from experimental RDCs fitted to a rigid protein structure, the derived alignment tensor will be dynamically averaged and therefore reduced in size. Isotropic internal dynamics leaves the rhombicity and the orientation of the tensor with respect to the molecular frame unaffected but leads to a reduction of the overall magnitude (Lakomek et al. <xref ref-type="bibr" rid="CR35">2006</xref>; Meiler et al. <xref ref-type="bibr" rid="CR49">2001</xref>). Therefore, the true value of the principal tensor <inline-formula id="IEq52"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq52.gif --><tex-math id="M61">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{i,zz} $$\end{document}</tex-math></inline-formula> is not known and can only be estimated from the experimentally accessible dynamically averaged <inline-formula id="IEq53"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq53.gif --><tex-math id="M62">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tilde D_{i,zz} $$\end{document}</tex-math></inline-formula>. As has been shown previously (Meiler et al. <xref ref-type="bibr" rid="CR49">2001</xref>), <inline-formula id="IEq54"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq54.gif --><tex-math id="M63">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tilde D_{i,zz} $$\end{document}</tex-math></inline-formula> is determined such that the average over the <inline-formula id="IEq55"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq55.gif --><tex-math id="M64">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc,unscaled}^2 $$\end{document}</tex-math></inline-formula> equals 1 (when taking all residues for alignment tensor calculation), because the average dynamics is absorbed in the alignment tensor.</p><p>Therefore, the <inline-formula id="IEq56"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq56.gif --><tex-math id="M65">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc,unscaled}^2 $$\end{document}</tex-math></inline-formula> provide only relative values for the dynamic amplitudes, but have to be scaled against the Lipari&#x02013;Szabo order parameters <inline-formula id="IEq57"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq57.gif --><tex-math id="M66">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula> which contain absolute mobility information given a fixed distance between the amide proton and nitrogen and assuming a constant chemical shift anisotropy. The downscaling of <inline-formula id="IEq58"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq58.gif --><tex-math id="M67">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc,unscaled}^2 $$\end{document}</tex-math></inline-formula> to <inline-formula id="IEq59"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq59.gif --><tex-math id="M68">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> is accompanied by an up-scaling of <inline-formula id="IEq60"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq60.gif --><tex-math id="M69">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tilde D_{i,zz} $$\end{document}</tex-math></inline-formula> to <inline-formula id="IEq61"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq61.gif --><tex-math id="M70">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{i,zz} $$\end{document}</tex-math></inline-formula>. As explained in detail in (Lakomek et al. <xref ref-type="bibr" rid="CR35">2006</xref>), the scaling factor <inline-formula id="IEq62"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq62.gif --><tex-math id="M71">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{overall} $$\end{document}</tex-math></inline-formula> therefore fulfills: <inline-formula id="IEq63"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq63.gif --><tex-math id="M72">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tilde D_{i,zz} = S_{overall} \cdot D_{i,zz} $$\end{document}</tex-math></inline-formula> and <inline-formula id="IEq64"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq64.gif --><tex-math id="M73">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{j,rdc} = S_{overall} \cdot S_{j,rdc,unscaled} $$\end{document}</tex-math></inline-formula>. Using this definition, Eq. (1.2) can be rewritten:<disp-formula id="Equ10"><label>1.10</label><tex-math id="M74">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \frac{{D_{ij}^{\exp } }}{{\tilde D_{i,zz} }} \cdot S_{overall} = \sum\limits_{M = - 2}^2 {F_{i,M} } \left\langle {Y_{2,M} } \right.(\theta _j^{mol} ,\phi _j^{mol} \left. ) \right\rangle $$\end{document}</tex-math></disp-formula></p><p>Subsequently, for clarity we will omit the indices <italic>i</italic> and <italic>j</italic>.</p><p>Solving the F-matrix equation yields <inline-formula id="IEq65"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq65.gif --><tex-math id="M75">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {Y_{2,M} \left( {\theta ,\phi } \right)} \right\rangle _{\left( {scaled} \right)} = S_{overall} \cdot \left\langle {Y_{2,M} \left( {\theta ,\phi } \right)} \right\rangle _{\left( {unscaled} \right)} $$\end{document}</tex-math></inline-formula> and finally <inline-formula id="IEq66"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq66.gif --><tex-math id="M76">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula>. It should be noted that S<sub><italic>overall</italic></sub> is a mathematical parameter without a direct physical meaning. The only values that have physical meaning are the scaled order parameters <inline-formula id="IEq67"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq67.gif --><tex-math id="M77">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula>. Determining the scaling factor <inline-formula id="IEq68"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq68.gif --><tex-math id="M78">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{overall} $$\end{document}</tex-math></inline-formula> is non-trivial. Since RDC-based order parameters are sensitive up to the millisecond time scale while the Lipari&#x02013;Szabo ones only up to the overall tumbling correlation time <inline-formula id="IEq69"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq69.gif --><tex-math id="M79">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula>, the condition <inline-formula id="IEq70"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq70.gif --><tex-math id="M80">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 \le S_{LS}^2 $$\end{document}</tex-math></inline-formula> or <inline-formula id="IEq71"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq71.gif --><tex-math id="M81">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{overall}^2 \cdot S_{rdc,unscaled}^2 \le S_{LS}^2 $$\end{document}</tex-math></inline-formula> must hold within experimental error. This relationship is used to estimate the overall scaling factor <inline-formula id="IEq72"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq72.gif --><tex-math id="M82">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{overall} $$\end{document}</tex-math></inline-formula> by requiring <inline-formula id="IEq73"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq73.gif --><tex-math id="M83">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{overall}^2 \le S_{LS}^2 /S_{rdc,unscaled}^2 $$\end{document}</tex-math></inline-formula> within the experimental error of <inline-formula id="IEq74"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq74.gif --><tex-math id="M84">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> and <inline-formula id="IEq75"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq75.gif --><tex-math id="M85">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula>. It is further assumed that several residues do not show supra-<inline-formula id="IEq76"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq76.gif --><tex-math id="M86">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> motion resulting in identical <inline-formula id="IEq77"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq77.gif --><tex-math id="M87">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> and <inline-formula id="IEq78"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq78.gif --><tex-math id="M88">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula> for those residues. Lipari&#x02013;Szabo order parameters <inline-formula id="IEq79"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq79.gif --><tex-math id="M89">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula> measured at 308 K by Tjandra and co-workers were used (Chang and Tjandra <xref ref-type="bibr" rid="CR13">2005</xref>). Details can be found in the Supporting Information.</p></sec><sec id="Sec12"><title>Application to experimental data</title><p>The SCRM method has been applied to both experimental NH RDC data sets D36M and D23M using the X-ray structure&#x000a0;1 ubi (Ramage et al. <xref ref-type="bibr" rid="CR61">1994</xref>) as starting structure (with protons added in standard positions with MOLMOL (Koradi et al. <xref ref-type="bibr" rid="CR34">1996</xref>) using a bond length of 1.04 &#x000c5;). The influence of structural noise on the SCRM analysis was tested as described in the following paragraph.</p></sec><sec id="Sec13"><title>Structural noise analysis</title><p>The influence of structural noise on the SCRM approach was tested for two different scenarios, A and B:</p><p>In scenario A, synthetic Gaussian noise was added on the NH vector orientation of the X-ray 1ubi structure (with hydrogen atoms added according to standard geometry). Using PALES (Zweckstetter and Bax <xref ref-type="bibr" rid="CR81">2000</xref>), the NH vector is tilted Gaussian distributed with opening angle &#x003b8; and an equally distributed polar angle <inline-formula id="IEq80"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq80.gif --><tex-math id="M90">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \phi $$\end{document}</tex-math></inline-formula> as described in (Zweckstetter and Bax <xref ref-type="bibr" rid="CR83">2002</xref>). For the standard deviation of the Gaussian distribution values of (a) <inline-formula id="IEq81"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq81.gif --><tex-math id="M91">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \sigma $$\end{document}</tex-math></inline-formula> = 10&#x000b0;, (b) <inline-formula id="IEq82"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq82.gif --><tex-math id="M92">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \sigma $$\end{document}</tex-math></inline-formula> = 20&#x000b0; or (c) <inline-formula id="IEq83"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq83.gif --><tex-math id="M93">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \sigma $$\end{document}</tex-math></inline-formula> = 30&#x000b0; were chosen, subsequently referred to as <italic>structural noise</italic> of 10&#x000b0;, 20&#x000b0; or 30&#x000b0; respectively. For each case (a)&#x02013;(c) three different random noise structures were generated. These random noise structures were used as starting structures for the alignment tensor calculation in the SCRM analysis.</p><p>For scenario B we used nine crystal structures of ubiquitin bound to its recognition proteins as input. These structures deviate from the free ubiquitin crystal structure&#x000a0;1ubi by backbone RMSD values between 0.3 and 0.6 &#x000c5;. These structures are 1cmx (Johnston et al. <xref ref-type="bibr" rid="CR29">1999</xref>), 1uzx (Teo et al. <xref ref-type="bibr" rid="CR70">2004</xref>), 1xd3 (Misaghi et al. <xref ref-type="bibr" rid="CR50">2005</xref>), 1yiw (Bang et al. <xref ref-type="bibr" rid="CR2">2005</xref>), 2c7n (Penengo et al. <xref ref-type="bibr" rid="CR57">2006</xref>), 2d3g (two structures, (Hirano et al. <xref ref-type="bibr" rid="CR25">2006</xref>)), 2fif (two structures, (Lee et al. <xref ref-type="bibr" rid="CR38">2006</xref>)).</p><p>For both scenarios, the RDC-based order parameters <inline-formula id="IEq84"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq84.gif --><tex-math id="M94">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> are compared to those derived from the &#x0201c;noise-free&#x0201d; 1ubi X-ray structure to analyze the influence of structural noise.</p></sec><sec id="Sec14"><title>Statistical analysis of <inline-formula id="IEq85"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq85.gif --><tex-math id="M95">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> and <inline-formula id="IEq86"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq86.gif --><tex-math id="M96">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula> distributions</title><p>We describe the spread of the <inline-formula id="IEq87"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq87.gif --><tex-math id="M97">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula>and <inline-formula id="IEq88"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq88.gif --><tex-math id="M98">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula> distributions over all residues of ubiquitin in terms of P-percentiles. The 25th percentile P25 is the value compared to which 25% of the distribution is lower. For the 75th percentile P75, 75% of the distribution have lower values. The interquantile range (IQR) is defined as the difference between P75 and P25. The IQR covers 50% of the distribution and is a direct measure for the spread of a distribution.</p></sec></sec></sec><sec id="Sec15"><title>Results and discussion</title><sec id="Sec16"><title>SCRM on experimental NH RDC data (D23M and D36M)</title><p>The SCRM method was applied to both NH RDC experimental data sets D23M and D36M using the X-ray structure&#x000a0;1ubi as starting input structure for the first cycle of the SCRM method.</p><p>The static X-ray structure&#x000a0;1ubi (with hydrogen atoms added according to standard geometry) yields static Q-values of <inline-formula id="IEq89"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq89.gif --><tex-math id="M99">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {Q_{static} } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.178 for D23M and <inline-formula id="IEq90"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq90.gif --><tex-math id="M100">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {Q_{static} } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.193 for D36M averaged over all alignment conditions. The Pearson correlation coefficients between experimental RDCs and those back-calculated from the static X-ray structure are <inline-formula id="IEq91"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq91.gif --><tex-math id="M101">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle \rho \right\rangle $$\end{document}</tex-math></inline-formula> = 0.977 for D23M and <inline-formula id="IEq92"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq92.gif --><tex-math id="M102">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle \rho \right\rangle $$\end{document}</tex-math></inline-formula> = 0.972 for D36M respectively, on average over all conditions.</p><p>As described in the <italic>Material and methods</italic> section, the SCRM method was designed to iteratively improve the accuracy of the alignment tensor determination and to adjust the average inter-nuclear vector orientations, and as a result, to further reduce the static Q-values <inline-formula id="IEq93"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq93.gif --><tex-math id="M103">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {Q_{static} } \right\rangle $$\end{document}</tex-math></inline-formula> and increase the Pearson correlation coefficient <inline-formula id="IEq94"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq94.gif --><tex-math id="M104">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \rho $$\end{document}</tex-math></inline-formula>. Indeed, after already 4 SCRM-cycles, the static Q-values decreased to less than half of the original value with <inline-formula id="IEq95"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq95.gif --><tex-math id="M105">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {Q_{static} } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.062 for both D23M and D36M (Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>a, b). Simultaneously, the correlation coefficients <inline-formula id="IEq96"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq96.gif --><tex-math id="M106">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \rho $$\end{document}</tex-math></inline-formula> increased to <inline-formula id="IEq97"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq97.gif --><tex-math id="M107">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle \rho \right\rangle $$\end{document}</tex-math></inline-formula> = 0.997 on average (Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>c, d). Convergence was attained in already 4 cycles of SCRM after which the inter-nuclear vector orientations <inline-formula id="IEq98"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq98.gif --><tex-math id="M108">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left( {\phi _{av} ,\theta _{av} } \right) $$\end{document}</tex-math></inline-formula> were found to deviated by less than 0.5 between consecutive SCRM cycles (Figure S2a and S2b in the Supporting Information). Thus the iterative procedure rapidly improves the fit of the static structure to the RDCs as compared to the input X-ray structure.<fig id="Fig2"><label>Fig.&#x000a0;2</label><caption><p>(<bold>a</bold>) and (<bold>b</bold>) show Q-values for back-calculated RDCs using the X-ray structure&#x000a0;1ubi for alignment tensor determination (dashed line) and after 4 SCRM cycles using the fitted dynamic average NH vector orientations (black line) both for (<bold>a</bold>) D23M and (<bold>b</bold>) D36M. The fit of inter-nuclear vector orientations and determined alignment tensor to the experimental data is improved significantly: starting from <inline-formula id="IEq246"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq246.gif --><tex-math id="M109">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle Q \right\rangle $$\end{document}</tex-math></inline-formula> = 0.178 for D23M and <inline-formula id="IEq247"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq247.gif --><tex-math id="M110">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle Q \right\rangle $$\end{document}</tex-math></inline-formula> = 0.193 for D36M on average, the Q-values decrease to <inline-formula id="IEq248"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq248.gif --><tex-math id="M111">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle Q \right\rangle $$\end{document}</tex-math></inline-formula> = 0.062 for both D23M and D36M after 4 SCRM-cycles. (<bold>c</bold>) and (<bold>d</bold>) same as (<bold>a</bold>) and (<bold>b</bold>) but for <inline-formula id="IEq249"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq249.gif --><tex-math id="M112">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle \rho \right\rangle $$\end{document}</tex-math></inline-formula> instead of Q-values. Starting from <inline-formula id="IEq250"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq250.gif --><tex-math id="M113">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle \rho \right\rangle $$\end{document}</tex-math></inline-formula> = 0.977 for D23M and <inline-formula id="IEq251"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq251.gif --><tex-math id="M114">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle \rho \right\rangle $$\end{document}</tex-math></inline-formula> = 0.972 for D36M on average, <inline-formula id="IEq252"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq252.gif --><tex-math id="M115">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle \rho \right\rangle $$\end{document}</tex-math></inline-formula> improves to <inline-formula id="IEq253"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq253.gif --><tex-math id="M116">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle \rho \right\rangle $$\end{document}</tex-math></inline-formula> = 0.997 after 4 SCRM cycles. (<bold>e</bold>) and (<bold>f</bold>): The inter-nuclear angles <inline-formula id="IEq254"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq254.gif --><tex-math id="M117">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \kappa _j $$\end{document}</tex-math></inline-formula> enclosed between the dynamic average NH vector orientations and the NH vectors of the starting X-ray structure&#x000a0;1ubi are shown. The average angular deviation is 6.97&#x000b0; for D23M and 6.87&#x000b0; for D36M. (<bold>g</bold>) and (<bold>h</bold>): Same as for <bold>e</bold> and <bold>f</bold>, but compared to the 1d3z NMR structures. The average deviation to the NMR structure is 4.84&#x000b0; for D23M and 4.52&#x000b0; for D36M. Thus, the agreement between the derived dynamic average NH vector orientations and the NMR structure is significantly better than for the 1ubi structure</p></caption><graphic position="anchor" xlink:href="10858_2008_9244_Fig2_HTML" id="MO12"/></fig></p><p>In Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>(e, f) the inter-nuclear angles <inline-formula id="IEq99"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq99.gif --><tex-math id="M118">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \kappa _j $$\end{document}</tex-math></inline-formula> enclosed between the dynamic average NH vector orientations and the NH vectors of the starting X-ray structure&#x000a0;1ubi are shown. For better comparison, the dynamic average NH vector orientations have been rotated to a best-fit superposition with the NH vectors of the 1ubi structure (with protons added according to standard geometry).</p><p>Most of the dynamic average inter-nuclear vector orientations obtained after 4 SCRM cycles differ from those of the 1ubi X-ray structure by less than 10&#x000b0; for <inline-formula id="IEq100"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq100.gif --><tex-math id="M119">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \kappa _j $$\end{document}</tex-math></inline-formula> (Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>e, f). The average angular deviation is 6.97&#x000b0; for D23M and 6.87&#x000b0; for D36M. Deviations larger than 10&#x000b0; are observed for Lys6, Lys11, Ile13, Ser20, Lys33, Glu34, Arg42, Lys48, Leu50, Asp52, Arg54, Leu67, Val70 and Leu71 for D23M. The largest deviation is 20.3&#x000b0; for Arg54 (compare Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>e, f). Most of these residues are highly mobile with <inline-formula id="IEq101"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq101.gif --><tex-math id="M120">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> &#x0003c; 0.7. Exceptions are Lys6 in the first &#x003b2;-strand, Lys33 and Glu34 in the &#x003b1;-helix, Leu43 in the third &#x003b2;-strand and Leu67 and Val70 in the fifth &#x003b2;-strand. Despite the fact that <inline-formula id="IEq102"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq102.gif --><tex-math id="M121">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> &#x0003e; 0.7 for Lys33 and Glu34, they appear relatively mobile compared to the surrounding residues in the &#x003b1;-helix. Values for all residues have been listed in the Supporting Information in Table S3 for D23M and S4 for D36M. The derived dynamic average NH orientations have been compared to the NMR 1d3z structure (Cornilescu et al.<xref ref-type="bibr" rid="CR17">1998</xref>) (first structure of the ensemble) as well (Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>g, h). The average deviation to the NMR structure is 4.84&#x000b0; for D23M and 4.52&#x000b0; for D36M. Thus, the agreement between the derived dynamic average NH vector orientations and the NMR structure is significantly better than for the 1ubi structure. Interestingly, most of those dynamic average NH vectors that showed the largest deviations to the 1ubi X-ray structure, for example K6, L67 and V70, did not show large deviations compared to the NMR structure. Only Lys11 and Asp52 show large discrepancies both for the X-ray and NMR structure. Both are highly dynamic. In the 1ubi structure Lys6, Lys48 and Arg54 appear to be affected by crystal packing. Indeed, the largest deviation between 1ubi and 1d3z is observed for Arg54 with <inline-formula id="IEq103"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq103.gif --><tex-math id="M122">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \kappa $$\end{document}</tex-math></inline-formula> = 22.4&#x000b0;, also for Lys48 and Lys6 the deviations are high with <inline-formula id="IEq104"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq104.gif --><tex-math id="M123">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \kappa $$\end{document}</tex-math></inline-formula> = 9.3&#x000b0; and 12.3&#x000b0;. A tendency was observed that NH vectors involved in hydrogen bonds became more collinear to the electron donating carbonyl groups upon application of SCRM. Considering only changes greater than three of the NH vector orientation, 15 out 23 backbone amide groups became more parallel to the carbonyl group.</p><p>For comparison, the SCRM analysis was repeated using the 1d3z NMR structure as starting structure. As expected, the results are almost identical and corroborate the robustness of the SCRM approach. The resulting <inline-formula id="IEq105"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq105.gif --><tex-math id="M124">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> and <inline-formula id="IEq106"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq106.gif --><tex-math id="M125">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \kappa _j $$\end{document}</tex-math></inline-formula> are listed in the supporting information as well, in Table S3 for D23M and S4 for D36M, compare also Figure S2c and S2d.</p><p>In parallel with the improvement of the static Q-values <inline-formula id="IEq107"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq107.gif --><tex-math id="M126">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {Q_{static} } \right\rangle $$\end{document}</tex-math></inline-formula> and correlation coefficients <inline-formula id="IEq108"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq108.gif --><tex-math id="M127">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \rho $$\end{document}</tex-math></inline-formula>, the RDC-based order parameters <inline-formula id="IEq109"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq109.gif --><tex-math id="M128">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> also converged after 4 cycles of SCRM (Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>a, b).<fig id="Fig3"><label>Fig.&#x000a0;3</label><caption><p>(<bold>a</bold>) and (<bold>b</bold>): The average difference <inline-formula id="IEq255"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq255.gif --><tex-math id="M129">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \Updelta $$\end{document}</tex-math></inline-formula> of RDC-based <inline-formula id="IEq256"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq256.gif --><tex-math id="M130">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameter between subsequent SCRM cycles for (<bold>a</bold>) D23M and (<bold>b</bold>) D36M is shown: <inline-formula id="IEq257"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq257.gif --><tex-math id="M131">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left| {S_{rdc,i}^2 - S_{rdc,i - 1}^2 } \right| = \frac{1}{n}\sum\nolimits_{j = 1}^n {\left| {S_{rdc,i}^2 (NH_j ) - S_{rdc,i - 1}^2 (NH_j )} \right|} $$\end{document}</tex-math></inline-formula>. RDC-based order parameters <inline-formula id="IEq258"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq258.gif --><tex-math id="M132">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> have converged after 4 cycles of SCRM with less than 0.01 difference <inline-formula id="IEq259"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq259.gif --><tex-math id="M133">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left| {S_{rdc,i}^2 - S_{rdc,i - 1}^2 } \right| $$\end{document}</tex-math></inline-formula> between subsequent SCRM cycles. (<bold>c</bold>) and (<bold>d</bold>): Residue-specific RDC-rmsd values <inline-formula id="IEq260"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq260.gif --><tex-math id="M134">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ rmsd(rdc,j) $$\end{document}</tex-math></inline-formula> are shown for (<bold>c</bold>) D23M and (<bold>d</bold>) D36M after 4 SCRM cycles. For D23M, the average RDC-rmsd is <inline-formula id="IEq261"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq261.gif --><tex-math id="M135">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {rmsd(rdc,j)} \right\rangle $$\end{document}</tex-math></inline-formula> = 0.28 Hz and 0.52 Hz for D36M. (<bold>e</bold>) and (<bold>f</bold>): Dynamic Q-values <inline-formula id="IEq262"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq262.gif --><tex-math id="M136">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ Q_{dyn} $$\end{document}</tex-math></inline-formula> for the different alignment conditions are back-calculated, for D23M the average dynamic Q-value is <inline-formula id="IEq263"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq263.gif --><tex-math id="M137">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {Q_{dyn} } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.027 and for D36M <inline-formula id="IEq264"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq264.gif --><tex-math id="M138">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {Q_{dyn} } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.037</p></caption><graphic position="anchor" xlink:href="10858_2008_9244_Fig3_HTML" id="MO13"/></fig></p><p>A more specific measure of the fit of the SCRM results to the experimental RDCs are residue-specific RDC-rmsd values which can be back-calculated from the model-free derived dynamic averaged second order spherical harmonics (compare Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>c, d). For D23M, the average RDC-rmsd was strongly reduced to <inline-formula id="IEq110"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq110.gif --><tex-math id="M139">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {rmsd(rdc,j)} \right\rangle $$\end{document}</tex-math></inline-formula> = 0.28 Hz after four SCRM-cycles compared to <inline-formula id="IEq111"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq111.gif --><tex-math id="M140">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {rmsd(rdc,j)} \right\rangle $$\end{document}</tex-math></inline-formula> = 0.52 Hz for D36M.</p><p>To estimate the remaining inhomogeneity in the data, we added Gaussian noise to the noise-free back-calculated RDCs until the SECONDA gap reached 6.8, the value found for D23M (see Supporting Information for details). That analysis yields an estimated inhomogeneity for the D23M dataset of 0.22 Hz.</p><p>Since it is not expected that removal of only 13 data sets reduces the RDC-rmsd by almost a factor of 2, this result indicates that the resulting set D23M is more homogeneous, consistent with the SECONDA analysis. As mentioned above, SECONDA homogeneity is neither compatible with significant structural changes induced by the alignment media nor with significant correlation of the vector fluctuations and the alignment tensor. Thus, for D23M the error introduced by ignoring a possible correlation between internal protein dynamics and alignment tensor fluctuation is small. Further, also the use of a single dynamically average alignment tensor does not seem to introduce a considerable error. Significant deviations of <inline-formula id="IEq112"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq112.gif --><tex-math id="M141">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ rmsd(rdc,j) $$\end{document}</tex-math></inline-formula> values from the average can mainly be observed for loop regions indicating a possible correlation between internal dynamics and alignment tensor fluctuations for these regions, in agreement with (Salvatella et al. <xref ref-type="bibr" rid="CR64">2008</xref>). Possible complications as addressed in (Louhivuori et al. <xref ref-type="bibr" rid="CR43">2007</xref>) are thus unlikely for the alignment conditions in the D23M subset.</p><p>For both D23M and D36M the resulting <inline-formula id="IEq113"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq113.gif --><tex-math id="M142">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> RDC-based order parameters are identical within the error, with very few exceptions for Gly35, Lys63 and Leu71 (Fig.&#x000a0;<xref rid="Fig4" ref-type="fig">4</xref>c). The correlation coefficient between the <inline-formula id="IEq114"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq114.gif --><tex-math id="M143">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> derived from both data sets D23M and D36M is <inline-formula id="IEq115"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq115.gif --><tex-math id="M144">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \rho $$\end{document}</tex-math></inline-formula> = 0.945. The inter-nuclear angle <inline-formula id="IEq116"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq116.gif --><tex-math id="M145">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \kappa _j $$\end{document}</tex-math></inline-formula> enclosed between the dynamic average vectors derived from D23M and derived from D36M agree very well with an average <inline-formula id="IEq117"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq117.gif --><tex-math id="M146">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \kappa _{} $$\end{document}</tex-math></inline-formula> value of 1.4&#x000b0; (compare Supporting Information Figure S2e). A higher deviation is observed for Gly35 and Asp52 which also shows a higher discrepancy of the <inline-formula id="IEq118"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq118.gif --><tex-math id="M147">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula>.<fig id="Fig4"><label>Fig.&#x000a0;4</label><caption><p>RDC-based <inline-formula id="IEq265"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq265.gif --><tex-math id="M148">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameters (red and blue) scaled according to the method described in the supplement are compared to the Lipari&#x02013;Szabo <inline-formula id="IEq266"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq266.gif --><tex-math id="M149">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula> (black) for (<bold>a</bold>) D23M and (<bold>b</bold>) D36M. Both error bars for <inline-formula id="IEq267"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq267.gif --><tex-math id="M150">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \sigma _j^{\exp } $$\end{document}</tex-math></inline-formula> = 0.3 Hz and <inline-formula id="IEq268"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq268.gif --><tex-math id="M151">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \sigma _j^{rmsd} = rmsd(rdc,j) $$\end{document}</tex-math></inline-formula> are indicated as horizontal lines. While for some residues <inline-formula id="IEq269"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq269.gif --><tex-math id="M152">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> and <inline-formula id="IEq270"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq270.gif --><tex-math id="M153">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula> have almost equal values, for others, mainly in loop regions but also in secondary structure elements, <inline-formula id="IEq271"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq271.gif --><tex-math id="M154">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> values are significantly lower. The average RDC-based order parameter is <inline-formula id="IEq272"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq272.gif --><tex-math id="M155">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{rdc}^2 } \right\rangle $$\end{document}</tex-math></inline-formula>&#x000a0;= 0.72&#x000a0;<inline-formula id="IEq273"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq273.gif --><tex-math id="M156">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \pm $$\end{document}</tex-math></inline-formula> 0.02 for D23M and<inline-formula id="IEq274"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq274.gif --><tex-math id="M157">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{rdc}^2 } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.72<inline-formula id="IEq275"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq275.gif --><tex-math id="M158">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \pm $$\end{document}</tex-math></inline-formula> 0.02 for D36M compared to <inline-formula id="IEq276"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq276.gif --><tex-math id="M159">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{LS}^2 } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.778 &#x000b1; 0.003 for the Lipari&#x02013;Szabo order parameter. (<bold>c</bold>) RDC-based order parameters <inline-formula id="IEq277"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq277.gif --><tex-math id="M160">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> derived from D23M (red) and D36M (blue) are compared. Both data sets D36M and D23M give <inline-formula id="IEq278"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq278.gif --><tex-math id="M161">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> that are identical within the error, with a very few exceptions for Gly35, Lys63 and Leu71. The correlation coefficient is <inline-formula id="IEq279"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq279.gif --><tex-math id="M162">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \rho $$\end{document}</tex-math></inline-formula> = 0.945. (<bold>d</bold>) and (<bold>e</bold>): comparison of (<bold>d</bold>) <inline-formula id="IEq280"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq280.gif --><tex-math id="M163">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> and (<bold>e</bold>) <inline-formula id="IEq281"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq281.gif --><tex-math id="M164">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameter distributions, The 25th percentile of the <inline-formula id="IEq282"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq282.gif --><tex-math id="M165">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> distribution is P25 = 0.68, the 75th percentile is P75 = 0.80 for D23M, giving and interquantile range (P25 to P75) of IQR = 0.12. (Identical values are obtained for D36M.) In contrast, the distribution of Lipari&#x02013;Szabo order parameters <inline-formula id="IEq283"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq283.gif --><tex-math id="M166">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula> is 2.4 times narrower with P25 = 0.78, P75 = 0.83 and an interquantile range of IQR = 0.05. For the RDC-based order parameter <inline-formula id="IEq284"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq284.gif --><tex-math id="M167">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> the IQR is more than double than that for the Lipari&#x02013;Szabo <inline-formula id="IEq285"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq285.gif --><tex-math id="M168">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula> showing that the RDC-based order parameters detect a much wider range of mobility</p></caption><graphic position="anchor" xlink:href="10858_2008_9244_Fig4_HTML" id="MO14"/></fig></p><p>A second measure of the fit of the SCRM results to the experimental data are the dynamic Q-values <inline-formula id="IEq119"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq119.gif --><tex-math id="M169">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ Q_{dyn} $$\end{document}</tex-math></inline-formula>. Those were obtained from the correlation of the experimental data to the RDCs back-calculated from the model-free derived dynamically averaged second order spherical harmonics <inline-formula id="IEq120"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq120.gif --><tex-math id="M170">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {Y_{2,M} } \right.(\theta _j^{mol} ,\phi _j^{mol} \left. ) \right\rangle $$\end{document}</tex-math></inline-formula> in the different alignment conditions (Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>e, f). For D23M the average dynamic Q-value is <inline-formula id="IEq121"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq121.gif --><tex-math id="M171">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {Q_{dyn} } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.027 and for D36M <inline-formula id="IEq122"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq122.gif --><tex-math id="M172">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {Q_{dyn} } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.037 which indicates that the SCRM results agree very well with the experimental RDC results. Conceptually, the RDC-based model-free method resembles a residue-wise least-square fit to the experimental RDCs. Thus the dynamic Q-values indicate the best-fit solution to a restraint-free minimization of the second order spherical harmonics <inline-formula id="IEq123"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq123.gif --><tex-math id="M173">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {Y_{2,M} } \right.(\theta _j^{mol} ,\phi _j^{mol} \left. ) \right\rangle $$\end{document}</tex-math></inline-formula> to the experimental RDCs. In terms of a possible RDC-based molecular dynamics ensemble refinement, a minimization of the NH vector orientation without additional force-field restraints yields a distribution of NH vector orientations that resembles the SCRM-derived results and order parameters.</p></sec><sec id="Sec17"><title>Determination of <inline-formula id="IEq124"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq124.gif --><tex-math id="M174">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{overall} $$\end{document}</tex-math></inline-formula></title><p>A rigorous statistical analysis yields that <inline-formula id="IEq125"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq125.gif --><tex-math id="M175">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{overall} $$\end{document}</tex-math></inline-formula> is smaller than 0.89 with a confidence level (see Supporting Information) of 95% using only the experimental error <inline-formula id="IEq126"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq126.gif --><tex-math id="M176">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \sigma _j^{\exp } $$\end{document}</tex-math></inline-formula> of 0.3 Hz. The confidence level drops to 67% using the total error <inline-formula id="IEq127"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq127.gif --><tex-math id="M177">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \sigma _j^{rmsd} $$\end{document}</tex-math></inline-formula>. This result is consistent with an independent statistical analysis based on a hypothesis test (see Supporting Information). The <inline-formula id="IEq128"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq128.gif --><tex-math id="M178">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{overall} $$\end{document}</tex-math></inline-formula> found in this work deviates from our previous analysis (<inline-formula id="IEq129"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq129.gif --><tex-math id="M179">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{overall} $$\end{document}</tex-math></inline-formula> =&#x000a0;0.83) (Lakomek et al. <xref ref-type="bibr" rid="CR35">2006</xref>) since now the most mobile NH amide groups have been excluded from the alignment tensor calculation resulting in a smaller downscaling of <inline-formula id="IEq130"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq130.gif --><tex-math id="M180">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ D_{i,zz} $$\end{document}</tex-math></inline-formula> caused by isotropic internal dynamics. Consequently, <inline-formula id="IEq131"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq131.gif --><tex-math id="M181">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{overall} $$\end{document}</tex-math></inline-formula> is expected to be larger than the value of 0.83 obtained in the previous analysis (Lakomek et al. <xref ref-type="bibr" rid="CR35">2006</xref>). Note that the average <inline-formula id="IEq132"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq132.gif --><tex-math id="M182">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{rdc}^2 } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.72 are equal in this and the previous analyses (vide infra).</p></sec><sec id="Sec18"><title>Analysis of <inline-formula id="IEq133"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq133.gif --><tex-math id="M183">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> order parameter distribution shows supra-<inline-formula id="IEq134"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq134.gif --><tex-math id="M184">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> motion</title><p>In Fig.&#x000a0;<xref rid="Fig4" ref-type="fig">4</xref>(a, b) the derived NH RDC-based order parameters <inline-formula id="IEq135"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq135.gif --><tex-math id="M185">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> for D23M and D36M are compared to the Lipari&#x02013;Szabo <inline-formula id="IEq136"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq136.gif --><tex-math id="M186">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameters. The derived <inline-formula id="IEq137"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq137.gif --><tex-math id="M187">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameters are listed in the supporting information. While for some residues <inline-formula id="IEq138"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq138.gif --><tex-math id="M188">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> and <inline-formula id="IEq139"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq139.gif --><tex-math id="M189">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula> are very similar, for others, mainly in loop regions but also in secondary structure elements, significantly lower <inline-formula id="IEq140"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq140.gif --><tex-math id="M190">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> values are observed. The average RDC-based order parameter is <inline-formula id="IEq141"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq141.gif --><tex-math id="M191">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{rdc}^2 } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.72&#x000a0;&#x000b1;&#x000a0;0.02 for D23M and for D36M compared to <inline-formula id="IEq142"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq142.gif --><tex-math id="M192">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{LS}^2 } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.778 &#x000b1; 0.003 for the Lipari&#x02013;Szabo order parameter. The order parameter <inline-formula id="IEq143"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq143.gif --><tex-math id="M193">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{LS}^2 } \right\rangle $$\end{document}</tex-math></inline-formula> is a measure for the remaining rigidity in the sub-<inline-formula id="IEq144"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq144.gif --><tex-math id="M194">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> window. For the mobility in that window, <inline-formula id="IEq145"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq145.gif --><tex-math id="M195">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ 1 - \left\langle {S_{LS}^2 } \right\rangle $$\end{document}</tex-math></inline-formula> is the appropriate measure. Similarly, the supra-<inline-formula id="IEq146"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq146.gif --><tex-math id="M196">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> mobility is measured by<disp-formula id="Equa"><tex-math id="M197">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ 1 - \left\langle {S_{{\hbox{supra}}\hbox{-}\tau _c }^2 } \right\rangle = 1 - \frac{{\left\langle {S_{rdc}^2 } \right\rangle }}{{\left\langle {S_{LS}^2 } \right\rangle }}. $$\end{document}</tex-math></disp-formula></p><p>Accordingly, inclusion of the supra-<inline-formula id="IEq147"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq147.gif --><tex-math id="M198">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> window increases the averaged amplitude of mobility observed in the sub-<inline-formula id="IEq148"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq148.gif --><tex-math id="M199">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> window by:<disp-formula id="Equb"><tex-math id="M200">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \frac{{{\text{supra}}\hbox{-}\tau _c -\text{mobility}}}{{{{\text{sub}}\hbox{-}\tau _c } - \text{mobility}}} =\frac{{1 - \left\langle {S_{{\text{supra}}\hbox{-}\tau _c }^2 }\right\rangle }}{{1 - \left\langle {S_{\text{sub}\hbox{-}\tau _c}^2 } \right\rangle }} = \frac{{1 - \frac{{\left\langle {S_{rdc}^2} \right\rangle }}{{\left\langle {S_{LS}^2 } \right\rangle }}}}{{1- \left\langle {S_{LS}^2 } \right\rangle}} = 34\%.$$\end{document}</tex-math></disp-formula></p><p>For D23M, N = 57<inline-formula id="IEq149"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq149.gif --><tex-math id="M201">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> order parameters were derived and N = 62 for D36M. For the <inline-formula id="IEq150"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq150.gif --><tex-math id="M202">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula> N = 49 <inline-formula id="IEq151"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq151.gif --><tex-math id="M203">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula> were available. The correlation coefficient between <inline-formula id="IEq152"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq152.gif --><tex-math id="M204">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> and <inline-formula id="IEq153"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq153.gif --><tex-math id="M205">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula> is <inline-formula id="IEq154"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq154.gif --><tex-math id="M206">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \rho $$\end{document}</tex-math></inline-formula> = 0.45 for D23M (and <inline-formula id="IEq155"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq155.gif --><tex-math id="M207">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \rho $$\end{document}</tex-math></inline-formula> = 0.41 for D36M).</p><p>For both data sets, <inline-formula id="IEq156"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq156.gif --><tex-math id="M208">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> order parameters show a significantly broader spread than those derived from relaxation, <inline-formula id="IEq157"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq157.gif --><tex-math id="M209">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula>. With an interquantile range of IQR = 0.12 for D23M (and 0.12 for D36M) compared to IQR = 0.05 for the Lipari&#x02013;Szabo <inline-formula id="IEq158"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq158.gif --><tex-math id="M210">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula> order parameters, the distribution of <inline-formula id="IEq159"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq159.gif --><tex-math id="M211">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> order parameters is 2.4 times wider than for <inline-formula id="IEq160"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq160.gif --><tex-math id="M212">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula> (Fig.&#x000a0;<xref rid="Fig4" ref-type="fig">4</xref>d, e). In conclusion the RDC-based order parameters sample additional motion beyond <inline-formula id="IEq161"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq161.gif --><tex-math id="M213">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula>. The fact that all <inline-formula id="IEq162"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq162.gif --><tex-math id="M214">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> must be smaller than the <inline-formula id="IEq163"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq163.gif --><tex-math id="M215">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 $$\end{document}</tex-math></inline-formula>, together with the much wider spread of the <inline-formula id="IEq164"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq164.gif --><tex-math id="M216">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula> distribution, leads on average to lower RDC-based order parameters <inline-formula id="IEq165"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq165.gif --><tex-math id="M217">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 $$\end{document}</tex-math></inline-formula>.</p><p>Supra-<inline-formula id="IEq166"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq166.gif --><tex-math id="M218">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> motion is observed mainly in loop regions like (7&#x02013;11, 20, 36&#x02013;40, 46&#x02013;47, 50&#x02013;56, 60&#x02013;65, 72&#x02013;76), but also for several residues in secondary structure elements (2&#x02013;6, 12&#x02013;17, 22&#x02013;35, 41&#x02013;45, 48&#x02013;49, 57&#x02013;59, 66&#x02013;71). The average RDC-based order parameter is <inline-formula id="IEq167"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq167.gif --><tex-math id="M219">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{rdc,loop}^2 } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.66 &#x000b1; 0.04 from D23M and <inline-formula id="IEq168"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq168.gif --><tex-math id="M220">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{rdc,loop}^2 } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.65 &#x000b1; 0.04 from D36M for loop regions. These values are about 10% smaller than the Lipari&#x02013;Szabo value of <inline-formula id="IEq169"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq169.gif --><tex-math id="M221">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{LS,loop}^2 } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.72 &#x000b1; 0.04 for the loop regions. For secondary structure elements the average RDC-based order-parameter is <inline-formula id="IEq170"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq170.gif --><tex-math id="M222">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{rdc,\sec }^2 } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.77 &#x000b1; 0.01 (both for D23M and D36M) and still about 5% smaller than the <inline-formula id="IEq171"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq171.gif --><tex-math id="M223">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{LS,\sec }^2 } \right\rangle $$\end{document}</tex-math></inline-formula> = 0.81 &#x000b1; 0.01. The presence of supra-<inline-formula id="IEq172"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq172.gif --><tex-math id="M224">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> motion in secondary structure elements is emphasized by comparing the 25th and 75th percentile P25 = 0.72 and P75 = 0.82 of the RDC-based order parameter in secondary structure elements <inline-formula id="IEq173"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq173.gif --><tex-math id="M225">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{rdc,\sec }^2 } \right\rangle $$\end{document}</tex-math></inline-formula> derived from D23M (P25 = 0.75 and P75 = 0.83 in the case of D36M) to P25 = 0.79 and P75 = 0.85 for the Lipari&#x02013;Szabo ones <inline-formula id="IEq174"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq174.gif --><tex-math id="M226">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{LS,\sec }^2 } \right\rangle $$\end{document}</tex-math></inline-formula>. Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref> lists all parameters describing the <inline-formula id="IEq175"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq175.gif --><tex-math id="M227">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{rdc}^2 } \right\rangle $$\end{document}</tex-math></inline-formula> distribution and the <inline-formula id="IEq176"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq176.gif --><tex-math id="M228">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{LS}^2 } \right\rangle $$\end{document}</tex-math></inline-formula> distribution.<table-wrap id="Tab2"><label>Table&#x000a0;2</label><caption><p>Statistics on the RDC-based order parameters <inline-formula id="IEq224"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq224.gif --><tex-math id="M229">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula>: (a) derived from D23M; (b) derived from D36M</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"/><th align="left">All <inline-formula id="IEq225"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq225.gif --><tex-math id="M230">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula></th><th align="left">All <inline-formula id="IEq226"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq226.gif --><tex-math id="M231">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula></th><th align="left">Sec. Struct. <inline-formula id="IEq227"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq227.gif --><tex-math id="M232">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula></th><th align="left">Sec. Struct. <inline-formula id="IEq228"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq228.gif --><tex-math id="M233">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula></th><th align="left">Loops <inline-formula id="IEq229"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq229.gif --><tex-math id="M234">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula></th><th align="left">Loops <inline-formula id="IEq230"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq230.gif --><tex-math id="M235">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula></th></tr></thead><tbody><tr><td align="left" colspan="7">(a) Derived from D23M</td></tr><tr><td align="left"><inline-formula id="IEq231"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq231.gif --><tex-math id="M236">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle \bullet \right\rangle $$\end{document}</tex-math></inline-formula></td><td align="left">0.72 &#x000b1; 0.02</td><td align="left">0.778 &#x000b1; 0.003</td><td align="left">0.77 &#x000b1; 0.01</td><td align="left">0.81 &#x000b1; 0.01</td><td align="left">0.66 &#x000b1; 0.04</td><td align="left">0.72 &#x000b1; 0.04</td></tr><tr><td align="left">P25</td><td align="left">0.68</td><td align="left">0.78</td><td align="left">0.72</td><td align="left">0.79</td><td align="left">0.59</td><td align="left">0.69</td></tr><tr><td align="left">P75</td><td align="left">0.80</td><td align="left">0.83</td><td align="left">0.82</td><td align="left">0.85</td><td align="left">0.77</td><td align="left">0.82</td></tr><tr><td align="left">IQR</td><td align="left">0.12</td><td align="left">0.05</td><td align="left">0.10</td><td align="left">0.05</td><td align="left">0.18</td><td align="left">0.13</td></tr><tr><td align="left">N</td><td align="left">57</td><td align="left">49</td><td align="left">34</td><td align="left">31</td><td align="left">23</td><td align="left">18</td></tr><tr><td align="left" colspan="7">(b) Derived from D36M</td></tr><tr><td align="left"><inline-formula id="IEq232"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq232.gif --><tex-math id="M237">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle \bullet \right\rangle $$\end{document}</tex-math></inline-formula></td><td align="left">0.72 &#x000b1; 0.02</td><td align="left">0.778 &#x000b1; 0.003</td><td align="left">0.77 &#x000b1; 0.01</td><td align="left">0.81 &#x000b1; 0.01</td><td align="left">0.65 &#x000b1; 0.04</td><td align="left">0.72 &#x000b1; 0.04</td></tr><tr><td align="left">P25</td><td align="left">0.68</td><td align="left">0.78</td><td align="left">0.75</td><td align="left">0.79</td><td align="left">0.61</td><td align="left">0.69</td></tr><tr><td align="left">P75</td><td align="left">0.80</td><td align="left">0.83</td><td align="left">0.83</td><td align="left">0.85</td><td align="left">0.78</td><td align="left">0.82</td></tr><tr><td align="left">IQR</td><td align="left">0.12</td><td align="left">0.05</td><td align="left">0.08</td><td align="left">0.05</td><td align="left">0.17</td><td align="left">0.13</td></tr><tr><td align="left">N</td><td align="left">62</td><td align="left">49</td><td align="left">37</td><td align="left">31</td><td align="left">25</td><td align="left">18</td></tr></tbody></table><table-wrap-foot><p>The average values, the 25th and 75th percentile as well as the interquantile range IQR and the number of analysed residues N are shown and compared to the data from relaxation <inline-formula id="IEq233"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq233.gif --><tex-math id="M238">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula>. The 1st and 2nd column show the values for the complete distribution, in the 3rd and 4th columns and the 5th and 6th columns we distinguish between secondary structure elements and loop regions</p><p>The percentile values reveal a much wider distribution of <inline-formula id="IEq235"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq235.gif --><tex-math id="M239">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameter than for the <inline-formula id="IEq236"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq236.gif --><tex-math id="M240">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula>. This effect is most visible for loop regions but also for secondary structure elements</p><p>(b): The same statistics as in (a) but for <inline-formula id="IEq234"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq234.gif --><tex-math id="M241">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> derived from D36M</p></table-wrap-foot></table-wrap></p><p>Interestingly, an alternating pattern of <inline-formula id="IEq177"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq177.gif --><tex-math id="M242">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameters was extracted for residues Lys48 to Leu50 in the 4th &#x003b2;-strand. The backbone of Lys48, whose side chain is known to be involved in the poly-ubiquitination process that leads to protein trafficking and degradation, appears very mobile with an order parameter of <inline-formula id="IEq178"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq178.gif --><tex-math id="M243">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> = 0.59 &#x000b1; 0.03 for D23M (<inline-formula id="IEq179"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq179.gif --><tex-math id="M244">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> = 0.58 &#x000b1; 0.07 for D36M) compared to <inline-formula id="IEq180"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq180.gif --><tex-math id="M245">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula> =&#x000a0;0.82 for the Lipari&#x02013;Szabo value.</p><p>Other alternating patterns of <inline-formula id="IEq181"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq181.gif --><tex-math id="M246">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> in &#x003b2;-sheets like Gln41 to Phe45 that have been described before (Lakomek et al. <xref ref-type="bibr" rid="CR36">2005</xref>) are reproduced in this analysis for D23M, however with reduced amplitude. The same alternating pattern is observed weakly also for Lipari&#x02013;Szabo order parameters <inline-formula id="IEq182"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq182.gif --><tex-math id="M247">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula> (Chang and Tjandra <xref ref-type="bibr" rid="CR13">2005</xref>). These findings are consistent with our earlier analyses (Lakomek et al. <xref ref-type="bibr" rid="CR36">2005</xref>), independent findings for protein G using the 3D-GAF analysis (Bouvignies et al. <xref ref-type="bibr" rid="CR8">2005b</xref>) and even earlier results by Palmer and co-workers for Ribonuclease H (Mandel et al. <xref ref-type="bibr" rid="CR44">1995</xref>; Mandel et al. <xref ref-type="bibr" rid="CR45">1996</xref>) and Fibronectin type III (Carr et al. <xref ref-type="bibr" rid="CR12">1997</xref>) using relaxation methods. A correlation between backbone mobility and side-chain orientation has recently also been extracted from ultra high-resolution X-ray structures (Davis et al. <xref ref-type="bibr" rid="CR18">2006</xref>).</p></sec><sec id="Sec19"><title>Focus on supra-<inline-formula id="IEq183"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq183.gif --><tex-math id="M248">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> motion</title><p>To distinguish supra-<inline-formula id="IEq184"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq184.gif --><tex-math id="M249">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> motion from sub-<inline-formula id="IEq185"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq185.gif --><tex-math id="M250">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> motion, the distribution of <inline-formula id="IEq186"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq186.gif --><tex-math id="M251">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 /S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula> was analyzed along the amino acid sequence of ubiquitin (Table&#x000a0;<xref rid="Tab3" ref-type="table">3</xref>). For residues with solvent-exposed side chains, the backbone amide groups appear more mobile, while residues with side chains pointing to the hydrophobic core of the protein appear more rigid in the protein backbone, in agreement with (Lakomek et al. <xref ref-type="bibr" rid="CR36">2005</xref>). The analysis has been applied in the same way as presented in (Lakomek et al. <xref ref-type="bibr" rid="CR36">2005</xref>). A very simple two-state model has been applied. All residues with a solvent accessibility less than 11.5% were considered as core residues, all others as solvent-exposed. Solvent accessibility has been calculated using MOLMOL (Koradi et al. <xref ref-type="bibr" rid="CR34">1996</xref>). The average <inline-formula id="IEq187"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq187.gif --><tex-math id="M252">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 /S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula> value is 0.90 &#x000b1; 0.02 for solvent-exposed residues and 0.93 &#x000b1; 0.03 for core residues in the case of D23M (and 0.90 &#x000b1; 0.02 and 0.93 &#x000b1; 0.02 for D36M) which reveals a tendency of core residues to be more rigid. The 25th percentile is P25 = 0.81 for the class of solvent-exposed residues and P25 = 0.87 for the core residues for D23M (and P25 = 0.81 and P25 = 0.92 for D36M). This indicates a tendency for residues with solvent exposed side-chains to be more mobile in the protein backbone than those with side chains pointing towards the hydrophobic core (Lakomek et al. <xref ref-type="bibr" rid="CR36">2005</xref>).<table-wrap id="Tab3"><label>Table&#x000a0;3</label><caption><p>Statistics on the RDC-based order parameters <inline-formula id="IEq237"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq237.gif --><tex-math id="M253">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 /S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula>: (a) derived from D23M; (b) derived from D36M which describe the supra-<inline-formula id="IEq238"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq238.gif --><tex-math id="M254">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> contribution to mobility</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"><inline-formula id="IEq239"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq239.gif --><tex-math id="M255">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 /S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula></th><th align="left">Core(i)</th><th align="left">Solvent(i)</th><th align="left">0 hb</th><th align="left">1 hb</th><th align="left">2 hb</th></tr></thead><tbody><tr><td align="left" colspan="6">(a) Derived from D23M</td></tr><tr><td align="left"><inline-formula id="IEq240"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq240.gif --><tex-math id="M256">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{rdc}^2 /S_{LS}^2 (NH)} \right\rangle $$\end{document}</tex-math></inline-formula></td><td align="left">0.93 &#x000b1; 0.03</td><td align="left">0.90 &#x000b1; 0.02</td><td align="left">0.81 &#x000b1; 0.05</td><td align="left">0.92 &#x000b1; 0.02</td><td align="left">0.92 &#x000b1; 0.02</td></tr><tr><td align="left">P25</td><td align="left">0.87</td><td align="left">0.81</td><td align="left">0.78</td><td align="left">0.87</td><td align="left">0.85</td></tr><tr><td align="left">P75</td><td align="left">1.00</td><td align="left">0.97</td><td align="left">0.85</td><td align="left">1.00</td><td align="left">0.98</td></tr><tr><td align="left">IQR</td><td align="left">0.13</td><td align="left">0.16</td><td align="left">0.07</td><td align="left">0.13</td><td align="left">0.13</td></tr><tr><td align="left">N</td><td align="left">10</td><td align="left">28</td><td align="left">5</td><td align="left">22</td><td align="left">11</td></tr><tr><td align="left" colspan="6">(b) Derived from D36M</td></tr><tr><td align="left"><inline-formula id="IEq241"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq241.gif --><tex-math id="M257">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{rdc}^2 /S_{LS}^2 (NH)} \right\rangle $$\end{document}</tex-math></inline-formula></td><td align="left">0.93 &#x000b1; 0.02</td><td align="left">0.90 &#x000b1; 0.02</td><td align="left">0.82 &#x000b1; 0.04</td><td align="left">0.92 &#x000b1; 0.02</td><td align="left">0.93 &#x000b1; 0.02</td></tr><tr><td align="left">P25</td><td align="left">0.92</td><td align="left">0.81</td><td align="left">0.78</td><td align="left">0.92</td><td align="left">0.91</td></tr><tr><td align="left">P75</td><td align="left">1.00</td><td align="left">1.00</td><td align="left">0.87</td><td align="left">1.00</td><td align="left">1.00</td></tr><tr><td align="left">IQR</td><td align="left">0.08</td><td align="left">0.19</td><td align="left">0.09</td><td align="left">0.08</td><td align="left">0.09</td></tr><tr><td align="left">N</td><td align="left">11</td><td align="left">31</td><td align="left">6</td><td align="left">23</td><td align="left">13</td></tr></tbody></table><table-wrap-foot><p>The average values, the 25th and 75th percentile as well as the interquantile range IQR and the number of analyzed residues N are shown. The 1st and 2nd column distinguish between residues with solvent-exposed side chains and those pointing towards the hydrophobic core</p><p>The average <inline-formula id="IEq243"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq243.gif --><tex-math id="M258">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 /S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula> reveals a slight tendency for core residues to be more rigid. 25% of the <inline-formula id="IEq244"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq244.gif --><tex-math id="M259">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 /S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula> distribution are lower than the 25th percentile which is P25 = 0.81 for the class of solvent-exposed residues and P25 = 0.87 for the core residues in the case of D23M. This reveals a tendency for residues with solvent exposed side-chains to be more mobile in the protein backbone (Lakomek et al. <xref ref-type="bibr" rid="CR36">2005</xref>). The dependence of <inline-formula id="IEq245"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq245.gif --><tex-math id="M260">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 /S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula> values on the number of hydrogen bonds the residue is involved in is analyzed columns 3 to 5. Peptide planes that are not involved in a hydrogen bond (hb0) appear more mobile than those that are hydrogen-bonded</p><p>(b): The same statistics as in (a) but for <inline-formula id="IEq242"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq242.gif --><tex-math id="M261">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 /S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula> derived from D36M</p></table-wrap-foot></table-wrap></p><p>The dependence of <inline-formula id="IEq188"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq188.gif --><tex-math id="M262">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 /S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula> values on the number of hydrogen bonds on the corresponding peptide plane (including the amino group NH(i) and the preceding carbonyl group CO(i-1)) is analyzed in the same way as in (Lakomek et al. <xref ref-type="bibr" rid="CR36">2005</xref>). Peptide planes that are not involved in a hydrogen bond appear more mobile than those that are hydrogen-bonded: The average RDC-based order parameter is <inline-formula id="IEq189"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq189.gif --><tex-math id="M263">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 /S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula> = 0.81 &#x000b1; 0.05 for D23M (0.82 &#x000b1; 0.05 for D36M) when the peptide plane is not involved in hydrogen bonds, compared to 0.92 &#x000b1; 0.02 (D23M and D36M) when the peptide plane is involved in at least one hydrogen bond. For details, see Table&#x000a0;<xref rid="Tab3" ref-type="table">3</xref>.</p></sec><sec id="Sec20"><title>Comparison to previous analyses</title><p>The correlation coefficient between the <inline-formula id="IEq190"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq190.gif --><tex-math id="M264">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> derived in this analysis and the previous one (Lakomek et al. <xref ref-type="bibr" rid="CR35">2006</xref>) is <inline-formula id="IEq191"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq191.gif --><tex-math id="M265">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \rho $$\end{document}</tex-math></inline-formula> = 0.80 for D23M and <inline-formula id="IEq192"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq192.gif --><tex-math id="M266">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \rho$$\end{document}</tex-math></inline-formula> = 0.82 for D36M. Both analyses yield an average <inline-formula id="IEq193"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq193.gif --><tex-math id="M267">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \left\langle {S_{rdc}^2 } \right\rangle $$\end{document}</tex-math></inline-formula> of 0.72, which underlines the presence of motion beyond the overall tumbling correlation time <inline-formula id="IEq194"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq194.gif --><tex-math id="M268">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula>. These results also highlight that it is important to remove the possible bias introduced by the structure used for the tensor calculation. In the previous analysis (Lakomek et al. <xref ref-type="bibr" rid="CR35">2006</xref>) some outliers were present, for which <inline-formula id="IEq195"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq195.gif --><tex-math id="M269">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameters were larger than the corresponding Lipari&#x02013;Szabo ones <inline-formula id="IEq196"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq196.gif --><tex-math id="M270">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula>. These were Leu8, Asp32, Gln49 and Ser57. In the SCRM analysis these residues show <inline-formula id="IEq197"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq197.gif --><tex-math id="M271">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> values lower than the corresponding <inline-formula id="IEq198"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq198.gif --><tex-math id="M272">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula> and are less conspicuous. These previous outliers are attributed to the influence of structural noise. As described in the next paragraph, the new SCRM method can efficiently avoid such outliers.</p></sec><sec id="Sec21"><title>SCRM analysis is robust against the influence of structural noise</title><p>For synthetic structural noise added to the starting structure for the SCRM analysis (see M&#x00026;M scenario A), the resulting <inline-formula id="IEq199"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq199.gif --><tex-math id="M273">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameters (using D36M) after 4 SCRM cycles are in excellent agreement with those obtained using the noise-free structure&#x000a0;1ubi), both for 10&#x000b0; and 20&#x000b0; Gaussian noise, as seen in Fig.&#x000a0;<xref rid="Fig5" ref-type="fig">5</xref>(a, b). Even for 30&#x000b0; structural noise the agreement is reasonably good (see Fig.&#x000a0;<xref rid="Fig5" ref-type="fig">5</xref>c).<fig id="Fig5"><label>Fig.&#x000a0;5</label><caption><p>SCRM-derived <inline-formula id="IEq286"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq286.gif --><tex-math id="M274">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> after addition of (<bold>a</bold>) 10&#x000b0; (<bold>b</bold>) 20&#x000b0; and (<bold>c</bold>) 30&#x000b0; synthetic structural noise on the 1ubi X-ray structure used as starting structure for alignment tensor calculation. The agreement between the calculated <inline-formula id="IEq287"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq287.gif --><tex-math id="M275">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> and those derived using the noise-free structure (black) shows that SCRM is robust against the influence of structural noise. (<bold>d</bold>) and (<bold>e</bold>): <inline-formula id="IEq288"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq288.gif --><tex-math id="M276">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameter are derived for d) D23M and e) D36M using the original RDC-based model-free analysis and nine different structures of ubiquitin bound in several complexes as starting structure for the analysis. The different structures have a backbone rmsd between 0.3 and 0.6 &#x000c5; to the free Xray structure&#x000a0;1ubi (Ramage et al. <xref ref-type="bibr" rid="CR61">1994</xref>) (black line) and serve as a test case for severe structural noise. (<bold>f</bold>) and (<bold>g</bold>): <inline-formula id="IEq289"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq289.gif --><tex-math id="M277">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameter are derived for (<bold>f</bold>) D23M and (<bold>g</bold>) D36M using the new SCRM method and the same nine different structures of ubiquitin (free X-ray structure&#x000a0;1ubi black line). While the original model-free approach (Lakomek et al. <xref ref-type="bibr" rid="CR36">2005</xref>) is affected by structural difference of the input structure used for tensor calculation, the new SCRM method alleviates the effect of structural noise</p></caption><graphic position="anchor" xlink:href="10858_2008_9244_Fig5_HTML" id="MO17"/></fig></p><p>The SCRM approach has been tested on nine different input structures that deviate considerably from the free ubiquitin crystal <italic>(see Materials and methods case B)</italic>. While the original model-free approach (Lakomek et al. <xref ref-type="bibr" rid="CR35">2006</xref>) is affected by structural differences of the input structures used for tensor calculation (Fig.&#x000a0;<xref rid="Fig5" ref-type="fig">5</xref>d, e), the new SCRM method alleviates the effect of structural noise (Fig.&#x000a0;<xref rid="Fig5" ref-type="fig">5</xref>f, g). After only 4 SCRM cycles the <inline-formula id="IEq200"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq200.gif --><tex-math id="M278">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameters of the nine different test cases have converged and agree very well with those for the free form 1ubi (Fig.&#x000a0;<xref rid="Fig5" ref-type="fig">5</xref>c, d). The standard deviation of <inline-formula id="IEq201"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq201.gif --><tex-math id="M279">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameters is <inline-formula id="IEq202"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq202.gif --><tex-math id="M280">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \sigma $$\end{document}</tex-math></inline-formula> = 0.033 for the original RDC-based model-free approach applied on D23M (<inline-formula id="IEq203"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq203.gif --><tex-math id="M281">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \sigma $$\end{document}</tex-math></inline-formula> = 0.039 for D36M) and <inline-formula id="IEq204"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq204.gif --><tex-math id="M282">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \sigma $$\end{document}</tex-math></inline-formula> = 0.010 after 4 SCRM cycles applied on D23M (<inline-formula id="IEq205"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq205.gif --><tex-math id="M283">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \sigma $$\end{document}</tex-math></inline-formula> = 0.006 for D36M). This illustrates nicely that the SCRM method is able to accurately determine alignment tensors and inter-nuclear vector orientations almost independently from the quality of the starting structure (within a certain range). This is an important prerequisite for reliable quantification of macromolecular dynamics. We are currently exploring how strongly the initial structure can deviate from the final structure to still obtain a converged, correct structure. Already now, it would be possible to derive an initial structure using the DIDC approach (Tolman <xref ref-type="bibr" rid="CR73">2002</xref>) or a recent extension of this approach (Yao et al. <xref ref-type="bibr" rid="CR80">2008</xref>). In a second step the SCRM approach could then be applied.</p></sec></sec><sec id="Sec22" sec-type="conclusion"><title>Conclusions</title><p>A Self-Consistent RDC-based Model-free (SCRM) approach has been developed based on the RDC-based model-free approach as implemented in (Lakomek et al. <xref ref-type="bibr" rid="CR36">2005</xref>, <xref ref-type="bibr" rid="CR35">2006</xref>). It differs from the previous approach in that it reduces the influence of the details of the structure used for the tensor calculation from the RDCs. Therefore, it makes the model-free analysis robust against the influence of structural noise.</p><p>SCRM was applied on two NH RDC data set collections, D36M and D23M. For both NH RDC data collections, the new SCRM approach gives almost identical <inline-formula id="IEq206"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq206.gif --><tex-math id="M284">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameters (correlation factor of 0.945). According to SECONDA analysis D23M increases homogeneity of the RDC data with still adequate sampling of alignment tensor orientations in the 5-dimensional tensor-space.</p><p>For D23M we conclude that there are neither significant structural changes induced by the alignment media nor significant correlations of the vector fluctuations and the alignment tensors. A possible correlation between alignment tensor fluctuations and internal dynamics, which has been proposed as a possible source of error by (Louhivuori et al. <xref ref-type="bibr" rid="CR42">2006</xref>, <xref ref-type="bibr" rid="CR43">2007</xref>), is therefore likely to be small. This finding is also in agreement with theoretical predictions (Salvatella et al. <xref ref-type="bibr" rid="CR64">2008</xref>).</p><p>We have shown in this work, that the influence of structural noise on the alignment tensor determination and finally the resulting <inline-formula id="IEq207"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq207.gif --><tex-math id="M285">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameter can be alleviated by the SCRM method. We have added synthetic structural noise to the 1ubi X-ray structure and have used different structures of ubiquitin from several complexes used as input for the SCRM analysis. The resulting order parameters were found to agree within 0.01 irrespective of the starting structure.</p><p>Consistent with the previous analysis, the inclusion of the supra-<inline-formula id="IEq208"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq208.gif --><tex-math id="M286">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> window increases the averaged amplitude of mobility observed in the sub-<inline-formula id="IEq209"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq209.gif --><tex-math id="M287">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> window by about 34%. These additional motions on a time scale slower than the correlation time <inline-formula id="IEq210"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq210.gif --><tex-math id="M288">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> occur mainly within loop regions but also within secondary structure elements.</p><p>Alternating mobility patterns on the <inline-formula id="IEq211"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq211.gif --><tex-math id="M289">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameters in &#x003b2;-sheets were extracted, in agreement with the previous analysis. For the 4th &#x003b2;-strand from Lys48 to Leu50 an alternating pattern of <inline-formula id="IEq212"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq212.gif --><tex-math id="M290">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> was extracted with an average amplitude of the <inline-formula id="IEq213"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq213.gif --><tex-math id="M291">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameter oscillations of &#x000b1;0.08.</p><p>A pronounced difference between the sub- and supra-<inline-formula id="IEq214"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq214.gif --><tex-math id="M292">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> amplitude for Lys48 was observed with <inline-formula id="IEq215"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq215.gif --><tex-math id="M293">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula> = 0.82 and <inline-formula id="IEq216"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq216.gif --><tex-math id="M294">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> = 0.59. Thus, there is more supra-<inline-formula id="IEq217"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq217.gif --><tex-math id="M295">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> than sub-<inline-formula id="IEq218"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq218.gif --><tex-math id="M296">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> motion <inline-formula id="IEq219"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq219.gif --><tex-math id="M297">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \frac{{S_{rdc}^2 (NH)}}{{S_{LS}^2 (NH)}} &#x0003c; S_{LS}^2 (NH) $$\end{document}</tex-math></inline-formula>. Lys48 is involved in the poly-ubiquitylation process that leads to protein degradation. This finding motivated the investigation of the role of supra-<inline-formula id="IEq220"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq220.gif --><tex-math id="M298">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> motion for protein&#x02013;protein recognition (Lange and Lakomek et al. <xref ref-type="bibr" rid="CR200">2008</xref>). Since conformational sampling on a time scale in the micro- to millisecond time scale has been found to be rate limiting in many catalyses (Kern and Zuiderweg <xref ref-type="bibr" rid="CR33">2003</xref>; Boehr et al. <xref ref-type="bibr" rid="CR6">2006</xref>; Dyson and Wright <xref ref-type="bibr" rid="CR21">2005</xref>; Eisenmesser et al. <xref ref-type="bibr" rid="CR22">2005</xref>; Kern et al. <xref ref-type="bibr" rid="CR32">2005</xref>) it would be intriguing if conformational sampling on the nano- to microsecond time scale, i.e. 1000 times faster than the time scale where most catalytic events occur, would prove to be essential for protein&#x02013;protein recognition dynamics. Very recently, Karplus and Kern and co-workers have shown that pico- to nano-second timescale atomic fluctuations in hinge regions of adenylate kinase facilitate the large-scale, slower lid motions that produce a catalytically competent state (Henzler-Wildman et al. <xref ref-type="bibr" rid="CR24">2007</xref>).</p><p>To summarize, RDCs can provide additional information about protein dynamics (supra-<inline-formula id="IEq221"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq221.gif --><tex-math id="M299">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ \tau _c $$\end{document}</tex-math></inline-formula> motion), complementary to relaxation methods. Since promising techniques are emerging to reduce the experimental effort of collecting enough linear independent RDC data sets (Ruan and Tolman <xref ref-type="bibr" rid="CR62">2005</xref>; Yao and Bax <xref ref-type="bibr" rid="CR79">2007</xref>), RDCs are expected to become a routine tool to complement the analysis of biomolecular dynamics.</p></sec><sec id="Sec23"><title>Supporting Information</title><p>NH RDCs measured for the different alignment conditions A1&#x02013;A36 and derived <inline-formula id="IEq222"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq222.gif --><tex-math id="M300">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{rdc}^2 (NH) $$\end{document}</tex-math></inline-formula> order parameters are available in the Supporting Information.</p><p>More detailed explanations about the SECONDA selection of data sets, the selection of residues used for alignment tensor calculation as well a detailed description of the determination of <inline-formula id="IEq223"><!-- Alternate image not processed: 10858_2008_9244_Article_IEq223.gif --><tex-math id="M301">\documentclass[12pt]{minimal}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{upgreek}\setlength{\oddsidemargin}{-69pt}\begin{document}$$ S_{overall} $$\end{document}</tex-math></inline-formula> can be found in the Supporting Information.</p></sec><sec sec-type="supplementary-material"><title>Electronic supplementary material</title><supplementary-material id="N0x19d1b00N0x2da50e0" content-type="local-data"><media xlink:href="10858_2008_9244_MOESM1_ESM.pdf" id="MOESM1" mimetype="application" mime-subtype="pdf"><caption><p>MOESM1 (PDF 2008 kb)</p></caption></media></supplementary-material></sec></body><back><ack><title>Acknowledgements</title><p>This work has been supported by the Max-Planck Society, the Fonds der Chemischen Industrie and the German Israel Fondation (GIF). We thank Edward D&#x02019;Auvergne and Markus Zweckstetter for fruitful discussions. Karin Giller provided expert technical help with the preparation of ubiquitin samples. Monika Bayrhuber was very helpful with the discussion on and preparation of charged gels for alignment. O.F.L. thanks the Human Frontier Science Program and the Volkswagen Foundation for support. A. M. thanks DFG-SNF FOR 916, H. G. and A. M. thank the SFB 755 for support. This work was supported by the NSF (0621482) and NIH (GM 066041) to R.B.</p><p><bold>Open Access</bold> This article is distributed under the terms of the Creative Commons Attribution Noncommercial License which permits any noncommercial use, distribution, and reproduction in any medium, provided the original author(s) and source are credited.</p></ack><ref-list id="Bib1"><title>References</title><ref id="CR1"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Akke</surname><given-names>M</given-names></name><name><surname>Palmer</surname><given-names>AG</given-names></name></person-group><article-title>Monitoring macromolecular motions on microsecond to millisecond time scales by R1r&#x02013;R1 constant relaxation time NMR Spectroscopy</article-title><source>J Am Chem Soc</source><year>1996</year><volume>118</volume><fpage>911</fpage><lpage>912</lpage><pub-id pub-id-type="doi">10.1021/ja953503r</pub-id></citation><citation citation-type="display-unstructured">Akke M, Palmer AG (1996) Monitoring macromolecular motions on microsecond to millisecond time scales by R1r&#x02013;R1 constant relaxation time NMR Spectroscopy. J Am Chem Soc 118:911&#x02013;912 </citation></ref><ref id="CR2"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bang</surname><given-names>D</given-names></name><name><surname>Makhatadze</surname><given-names>GI</given-names></name><name><surname>Tereshko</surname><given-names>V</given-names></name><name><surname>Kossiakoff</surname><given-names>AA</given-names></name><name><surname>Kent</surname><given-names>SB</given-names></name></person-group><article-title>Total chemical synthesis and X-ray crystal structure of a protein diastereomer: [D-Gln 35]ubiquitin</article-title><source>Angew Chem Int Ed Engl</source><year>2005</year><volume>44</volume><fpage>3852</fpage><lpage>3856</lpage><pub-id pub-id-type="doi">10.1002/anie.200463040</pub-id></citation><citation citation-type="display-unstructured">Bang D, Makhatadze GI, Tereshko V, Kossiakoff AA, Kent SB (2005) Total chemical synthesis and X-ray crystal structure of a protein diastereomer: [D-Gln 35]ubiquitin. Angew Chem Int Ed Engl 44:3852&#x02013;3856 <pub-id pub-id-type="pmid">15834850</pub-id></citation></ref><ref id="CR3"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bax</surname><given-names>A</given-names></name><name><surname>Grishaev</surname><given-names>A</given-names></name></person-group><article-title>Weak alignment NMR: a hawk-eyed view of biomolecular structure</article-title><source>Curr Opin Struct Biol</source><year>2005</year><volume>15</volume><fpage>563</fpage><lpage>570</lpage><pub-id pub-id-type="doi">10.1016/j.sbi.2005.08.006</pub-id></citation><citation citation-type="display-unstructured">Bax A, Grishaev A (2005) Weak alignment NMR: a hawk-eyed view of biomolecular structure. Curr Opin Struct Biol 15:563&#x02013;570 <pub-id pub-id-type="pmid">16140525</pub-id></citation></ref><ref id="CR4"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bertoncini</surname><given-names>CW</given-names></name><name><surname>Jung</surname><given-names>YS</given-names></name><name><surname>Fernandez</surname><given-names>CO</given-names></name><name><surname>Hoyer</surname><given-names>W</given-names></name><name><surname>Griesinger</surname><given-names>C</given-names></name><name><surname>Jovin</surname><given-names>TM</given-names></name><name><surname>Zweckstetter</surname><given-names>M</given-names></name></person-group><article-title>Release of long-range tertiary interactions potentiates aggregation of natively unstructured alpha-synuclein</article-title><source>Proc Natl Acad Sci USA</source><year>2005</year><volume>102</volume><fpage>1430</fpage><lpage>1435</lpage><pub-id pub-id-type="doi">10.1073/pnas.0407146102</pub-id><!-- WARNING: Occurrence has not been converted --></citation><citation citation-type="display-unstructured">Bertoncini CW, Jung YS, Fernandez CO, Hoyer W, Griesinger C, Jovin TM, Zweckstetter M (2005) Release of long-range tertiary interactions potentiates aggregation of natively unstructured alpha-synuclein. Proc Natl Acad Sci USA 102:1430&#x02013;1435 <pub-id pub-id-type="pmid">15671169</pub-id></citation></ref><ref id="CR5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blackledge</surname><given-names>M</given-names></name></person-group><article-title>Recent progress in the study of biomolecular structure and dynamics in solution from residual dipolar couplings</article-title><source>Prog Nucl Magn Reson Spectrosc</source><year>2005</year><volume>46</volume><fpage>23</fpage><lpage>61</lpage><pub-id pub-id-type="doi">10.1016/j.pnmrs.2004.11.002</pub-id></citation><citation citation-type="display-unstructured">Blackledge M (2005) Recent progress in the study of biomolecular structure and dynamics in solution from residual dipolar couplings. Prog Nucl Magn Reson Spectrosc 46:23&#x02013;61 </citation></ref><ref id="CR6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boehr</surname><given-names>DD</given-names></name><name><surname>McElheny</surname><given-names>D</given-names></name><name><surname>Dyson</surname><given-names>HJ</given-names></name><name><surname>Wright</surname><given-names>PE</given-names></name></person-group><article-title>The dynamic energy landscape of dihydrofolate reductase catalysis</article-title><source>Science</source><year>2006</year><volume>313</volume><fpage>1638</fpage><lpage>1642</lpage><pub-id pub-id-type="doi">10.1126/science.1130258</pub-id><!-- WARNING: Occurrence has not been converted --></citation><citation citation-type="display-unstructured">Boehr DD, McElheny D, Dyson HJ, Wright PE (2006) The dynamic energy landscape of dihydrofolate reductase catalysis. Science 313:1638&#x02013;1642 <pub-id pub-id-type="pmid">16973882</pub-id></citation></ref><ref id="CR7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bouvignies</surname><given-names>G</given-names></name><name><surname>Bernado</surname><given-names>P</given-names></name><name><surname>Blackledge</surname><given-names>M</given-names></name></person-group><article-title>Protein backbone dynamics from N&#x02013;H-N dipolar couplings in partially aligned systems: a comparison of motional models in the presence of structural noise</article-title><source>J Magn Res</source><year>2005</year><volume>173</volume><fpage>328</fpage><lpage>338</lpage><pub-id pub-id-type="doi">10.1016/j.jmr.2005.01.001</pub-id><!-- WARNING: Occurrence has not been converted --></citation><citation citation-type="display-unstructured">Bouvignies G, Bernado P, Blackledge M (2005a) Protein backbone dynamics from N&#x02013;H-N dipolar couplings in partially aligned systems: a comparison of motional models in the presence of structural noise. J Magn Res 173:328&#x02013;338 </citation></ref><ref id="CR8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bouvignies</surname><given-names>G</given-names></name><name><surname>Bernado</surname><given-names>P</given-names></name><name><surname>Meier</surname><given-names>S</given-names></name><name><surname>Cho</surname><given-names>K</given-names></name><name><surname>Grzesiek</surname><given-names>S</given-names></name><name><surname>Br&#x000fc;schweiler</surname><given-names>R</given-names></name><name><surname>Blackledge</surname><given-names>M</given-names></name></person-group><article-title>Identification of slow correlated motions in proteins using residual dipolar and hydrogen-bond scalar couplings</article-title><source>Proc Natl Acad Sci USA</source><year>2005</year><volume>102</volume><fpage>13885</fpage><lpage>13890</lpage><pub-id pub-id-type="doi">10.1073/pnas.0505129102</pub-id><!-- WARNING: Occurrence