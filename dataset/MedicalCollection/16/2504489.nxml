b-id pub-id-type="pmid">8036518</pub-id></citation></ref><ref id="pbio-0060197-b020"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Seitz</surname><given-names>AR</given-names></name><name><surname>Yamagishi</surname><given-names>N</given-names></name><name><surname>Werner</surname><given-names>B</given-names></name><name><surname>Goda</surname><given-names>N</given-names></name><name><surname>Kawato</surname><given-names>M</given-names></name><etal/></person-group><year>2005</year><article-title>Task-specific disruption of perceptual learning</article-title><source>Proc Natl Acad Sci U S A</source><volume>102</volume><fpage>14895</fpage><lpage>14900</lpage><pub-id pub-id-type="pmid">16203984</pub-id></citation></ref><ref id="pbio-0060197-b021"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mednick</surname><given-names>S</given-names></name><name><surname>Nakayama</surname><given-names>K</given-names></name><name><surname>Stickgold</surname><given-names>R</given-names></name></person-group><year>2003</year><article-title>Sleep-dependent learning: a nap is as good as a night</article-title><source>Nat Neurosci</source><volume>6</volume><fpage>697</fpage><lpage>698</lpage><pub-id pub-id-type="pmid">12819785</pub-id></citation></ref><ref id="pbio-0060197-b022"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Censor</surname><given-names>N</given-names></name><name><surname>Karni</surname><given-names>A</given-names></name><name><surname>Sagi</surname><given-names>D</given-names></name></person-group><year>2006</year><article-title>A link between perceptual learning, adaptation and sleep</article-title><source>Vision Res</source><volume>46</volume><fpage>4071</fpage><lpage>4074</lpage><pub-id pub-id-type="pmid">16979688</pub-id></citation></ref><ref id="pbio-0060197-b023"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ahissar</surname><given-names>M</given-names></name><name><surname>Laiwand</surname><given-names>R</given-names></name><name><surname>Kozminsky</surname><given-names>G</given-names></name><name><surname>Hochstein</surname><given-names>S</given-names></name></person-group><year>1998</year><article-title>Learning pop-out detection: building representations for conflicting target-distractor relationships</article-title><source>Vision Res</source><volume>38</volume><fpage>3095</fpage><lpage>3107</lpage><pub-id pub-id-type="pmid">9893818</pub-id></citation></ref><ref id="pbio-0060197-b024"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Large</surname><given-names>EW</given-names></name><name><surname>Jones</surname><given-names>MR</given-names></name></person-group><year>1999</year><article-title>The dynamics of attending: how people track time-varying events</article-title><source>Psychol Rev</source><volume>106</volume><fpage>119</fpage><lpage>159</lpage></citation></ref><ref id="pbio-0060197-b025"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jones</surname><given-names>MR</given-names></name><name><surname>Moynihan</surname><given-names>H</given-names></name><name><surname>MacKenzie</surname><given-names>N</given-names></name><name><surname>Puente</surname><given-names>J</given-names></name></person-group><year>2002</year><article-title>Temporal aspects of stimulus-driven attending in dynamic arrays</article-title><source>Psychol Sci</source><volume>13</volume><fpage>313</fpage><lpage>319</lpage><pub-id pub-id-type="pmid">12137133</pub-id></citation></ref><ref id="pbio-0060197-b026"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McGaugh</surname><given-names>JL</given-names></name></person-group><year>2000</year><article-title>Memory&#x02013;a century of consolidation</article-title><source>Science</source><volume>287</volume><fpage>248</fpage><lpage>251</lpage><pub-id pub-id-type="pmid">10634773</pub-id></citation></ref><ref id="pbio-0060197-b027"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parkosadze</surname><given-names>K</given-names></name><name><surname>Otto</surname><given-names>TU</given-names></name><name><surname>Malania</surname><given-names>M</given-names></name><name><surname>Kezeli</surname><given-names>A</given-names></name><name><surname>Herzog</surname><given-names>MH</given-names></name></person-group><year>2007</year><article-title>Perceptual learning of bisection stimuli under roving: slow and largely specific</article-title><source>J Vis</source><volume>8</volume><fpage>1</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">18318608</pub-id></citation></ref></ref-list><fn-group><fn id="ack1" fn-type="con"><p><bold>Author contributions.</bold> CY, SAK, and DML conceived and designed the experiments. J-YZ, S-GK, and L-QX performed the experiments. CY, J-YZ, S-GK, and L-QX analyzed the data. CY, SAK, and DML wrote the paper.</p></fn><fn id="ack2" fn-type="financial-disclosure"><p><bold>Funding.</bold> This research was supported by the Natural Science Foundation of China grant 30725018 and a Changjiang Scholar Professorship (CY), and by the US National Institute of Health grants RO1&#x02013;04776 (SAK) and RO1&#x02013;01728 (DML)</p></fn><fn id="ack3" fn-type="conflict"><p><bold>Competing interests.</bold> The authors have declared that no competing interests exist.</p></fn></fn-group></back></article>