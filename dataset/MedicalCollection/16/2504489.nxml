b-id pub-id-type="pmid">15669907</pub-id></citation></ref><ref id="pbio-0060197-b013"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Otto</surname><given-names>TU</given-names></name><name><surname>Herzog</surname><given-names>MH</given-names></name><name><surname>Fahle</surname><given-names>M</given-names></name><name><surname>Zhaoping</surname><given-names>L</given-names></name></person-group><year>2006</year><article-title>Perceptual learning with spatial uncertainties</article-title><source>Vision Res</source><volume>46</volume><fpage>3223</fpage><lpage>3233</lpage><pub-id pub-id-type="pmid">16690098</pub-id></citation></ref><ref id="pbio-0060197-b014"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adini</surname><given-names>Y</given-names></name><name><surname>Sagi</surname><given-names>D</given-names></name><name><surname>Tsodyks</surname><given-names>M</given-names></name></person-group><year>2002</year><article-title>Context-enabled learning in the human visual system</article-title><source>Nature</source><volume>415</volume><fpage>790</fpage><lpage>793</lpage><pub-id pub-id-type="pmid">11845209</pub-id></citation></ref><ref id="pbio-0060197-b015"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tsodyks</surname><given-names>M</given-names></name><name><surname>Adini</surname><given-names>Y</given-names></name><name><surname>Sagi</surname><given-names>D</given-names></name></person-group><year>2004</year><article-title>Associative learning in early vision</article-title><source>Neural Netw</source><volume>17</volume><fpage>823</fpage><lpage>832</lpage><pub-id pub-id-type="pmid">15288900</pub-id></citation></ref><ref id="pbio-0060197-b016"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dosher</surname><given-names>BA</given-names></name><name><surname>Lu</surname><given-names>ZL</given-names