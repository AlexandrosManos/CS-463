9</volume><fpage>147</fpage><lpage>148</lpage><pub-id pub-id-type="pmid">9101170</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eckhauser</surname><given-names>M</given-names></name><name><surname>Ferron</surname><given-names>J</given-names></name></person-group><article-title>The use of dual percutaneous endoscopic gastristomy (DPEG) in the management of chronic intermittent gastric volvulus</article-title><source>Gastrointest Endosc</source><year>1985</year><volume>31</volume><fpage>340</fpage><lpage>342</lpage><pub-id pub-id-type="pmid">4043688</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Alawadhi</surname><given-names>A</given-names></name><name><surname>Chou</surname><given-names>S</given-names></name><name><surname>Soucy</surname><given-names>P</given-names></name></person-group><article-title>Gastric volvulus &#x02013; a late complication of gastrostomy</article-title><source>Can J Surg</source><year>1991</year><volume>34</volume><fpage>485</fpage><lpage>486</lpage><pub-id pub-id-type="pmid">1913395</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koger</surname><given-names>K</given-names></name><name><surname>Stone</surname><given-names>J</given-names></name></person-group><article-title>Laparoscopic reduction of acute gastric volvulus</article-title><source>Am Surg</source><year>1993</year><volume>59</volume><fpage>325</fpage><lpage>328</lpage><pub-id pub-id-type="pmid">8489104</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Siu</surname><given-names>WT</given-names></name><name><surname>Leong</surname><given-names>HT</given-names></name><name><surname>Li</surname><given-names>MK</given-names></name></person-group><article-title>Laparoscopic gastropexy for chronic gastric volvulus</article-title><source>Surg Endosc</source><year>1998</year><volume>12</volume><fpage>1356</fpage><lpage>1357</lpage><pub-id pub-id-type="pmid">9788862</pub-id><pub-id pub-id-type="doi">10.1007/s004649900856</pub-id></citation></ref></ref-list></back></article>