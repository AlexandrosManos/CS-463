-type="journal"><person-group person-group-type="author"><name><surname>Yagui</surname><given-names>M</given-names></name><name><surname>Perales</surname><given-names>MT</given-names></name><name><surname>Asencios</surname><given-names>L</given-names></name><name><surname>Vergara</surname><given-names>L</given-names></name><name><surname>Suarez</surname><given-names>C</given-names></name><etal/></person-group><year>2006</year><article-title>Timely diagnosis of MDR-TB under program conditions: is rapid drug susceptibility testing sufficient?</article-title><source>Int J Tuberc Lung Dis</source><volume>10</volume><fpage>838</fpage><lpage>843</lpage><pub-id pub-id-type="pmid">16898366</pub-id></citation></ref><ref id="pone.0002957-Ministerio3"><label>15</label><citation citation-type="book"><collab>Ministerio de Salud PM</collab><year>2006</year><source>Norma Tecnica de Salud para el Control de la Tuberculosis</source><publisher-loc>Lima, Peru</publisher-loc><publisher-name>Miniterio de Salud</publisher-name><fpage>263</fpage></citation></ref><ref id="pone.0002957-Farmer1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Farmer</surname><given-names>P</given-names></name><name><surname>Kim</surname><given-names>JY</given-names></name></person-group><year>1998</year><article-title>Community based approaches to the control of multidrug resistant tuberculosis: introducing &#x0201c;DOTS-plus&#x0201d;.</article-title><source>BMJ</source><volume>317</volume><fpage>671</fpage><lpage>674</lpage><pub-id pub-id-type="pmid">9728004</pub-id></citation></ref><ref id="pone.0002957-Socios1"><label>17</label><citation citation-type="other"><collab>Socios en Salud S</collab><year>2004</year><source>Guia SES para el Tratamiento y Manejo de la Tuberculosis Multidrogo resistente: Partners in Health</source><fpage>173</fpage></citation></ref><ref id="pone.0002957-World2"><label>18</label><citation citation-type="book"><collab>World Health Organization W</collab><year>2007</year><source>Interim recommendations for the surveillance of drug resistance in tuberculosis. (WHO/HTM/TB/2007.385)</source><publisher-name>World Health Organization</publisher-name><fpage>23</fpage></citation></ref><ref id="pone.0002957-Laserson1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Laserson</surname><given-names>KF</given-names></name><name><surname>Thorpe</surname><given-names>LE</given-names></name><name><surname>Leimane</surname><given-names>V</given-names></name><name><surname>Weyer</surname><given-names>K</given-names></name><name><surname>Mitnick</surname><given-names>CD</given-names></name><etal/></person-group><year>2005</year><article-title>Speaking the same language: treatment outcome definitions for multidrug-resistant tuberculosis.</article-title><source>Int J Tuberc Lung Dis</source><volume>9</volume><fpage>640</fpage><lpage>645</lpage><pub-id pub-id-type="pmid">15971391</pub-id></citation></ref><ref id="pone.0002957-World3"><label>20</label><citation citation-type="book"><collab>World Health Organization. Stop TB Dept</collab><year>2006</year><source>Guidelines for the programmatic management of drug-resistant tuberculosis(WHO/INT/TB/2006.361)</source><publisher-loc>Geneva</publisher-loc><publisher-name>World Health Organization</publisher-name><fpage>174</fpage></citation></ref><ref id="pone.0002957-Holtz1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Holtz</surname><given-names>TH</given-names></name><name><surname>Sternberg</surname><given-names>M</given-names></name><name><surname>Kammerer</surname><given-names>S</given-names></name><name><surname>Laserson</surname><given-names>KF</given-names></name><name><surname>Riekstina</surname><given-names>V</given-names></name><etal/></person-group><year>2006</year><article-title>Time to sputum culture conversion in multidrug-resistant tuberculosis: predictors and relationship to treatment outcome.</article-title><source>Ann Intern Med</source><volume>144</volume><fpage>650</fpage><lpage>659</lpage><pub-id pub-id-type="pmid">16670134</pub-id></citation></ref><ref id="pone.0002957-Ahuja1"><label>22</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Ahuja</surname><given-names>SD</given-names></name><name><surname>Munsiff</surname><given-names>SS</given-names></name><name><surname>Nilsen</surname><given-names>D</given-names></name></person-group><year>2007 November 2007</year><article-title>Clinical outcomes of extensively drug-resistant (XDR) tuberculosis patients in New York City.</article-title><source>Disease IUATaL, editor. Abstract Book</source><publisher-loc>Cape Town, South Africa</publisher-loc><publisher-name>The Union</publisher-name><fpage>S1</fpage><lpage>S306</lpage></citation></ref><ref id="pone.0002957-Farmer2"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Farmer</surname><given-names>P</given-names></name><name><surname>Furin</surname><given-names>J</given-names></name><name><surname>Shin</surname><given-names>S</given-names></name></person-group><year>2000</year><article-title>Managing Multidrug-resistant tuberculosis.</article-title><source>Journal of Respiratory diseases</source><volume>21</volume><fpage>4</fpage></citation></ref><ref id="pone.0002957-Caminero1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Caminero</surname><given-names>JA</given-names></name></person-group><year>2005</year><article-title>Management of multidrug-resistant tuberculosis and patients in retreatment.</article-title><source>Eur Respir J</source><volume>25</volume><fpage>928</fpage><lpage>936</lpage><pub-id pub-id-type="pmid">15863653</pub-id></citation></ref><ref id="pone.0002957-World4"><label>25</label><citation citation-type="book"><collab>World Health Organization, Stop TB Partnership</collab><year>2007</year><source>The global MDR-TB &#x00026; XDR-TB response plan 2007&#x02013;2008. (WHO/INT/TB/2007.387)</source><publisher-loc>Geneva</publisher-loc><publisher-name>World Health Organization</publisher-name><fpage>41</fpage></citation></ref></ref-list><fn-group><fn fn-type="conflict"><p><bold>Competing Interests: </bold>The authors have declared that no competing interests exist.</p></fn><fn fn-type="financial-disclosure"><p><bold>Funding: </bold>This analysis was conducted as part of the activities of the MDR-TB Unit of the Ministry of Health of Peru. No specific funds were used for this retrospective study.</p></fn></fn-group></back></article>