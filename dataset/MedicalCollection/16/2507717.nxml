p-type="author"><name><surname>Eccles</surname><given-names>MP</given-names></name><name><surname>Hrisos</surname><given-names>S</given-names></name><name><surname>Francis</surname><given-names>J</given-names></name><name><surname>Kaner</surname><given-names>EF</given-names></name><name><surname>Dickinson</surname><given-names>HO</given-names></name><name><surname>Beyer</surname><given-names>F</given-names></name><name><surname>Johnston</surname><given-names>M</given-names></name></person-group><article-title>Do self-reported intentions predict clinicians' behaviour: a systematic review</article-title><source>Implement Sci</source><year>2006</year><volume>1</volume><fpage>28</fpage><pub-id pub-id-type="pmid">17118180</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sheeran</surname><given-names>P</given-names></name></person-group><article-title>Intention-behavior relations: a conceptual and empirical review</article-title><source>Eur Rev Soc Psychol</source><year>2002</year><volume>12</volume><fpage>1</fpage><lpage>36</lpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Perkins</surname><given-names>MB</given-names></name><name><surname>Jensen</surname><given-names>PS</given-names></name><name><surname>Jaccard</surname><given-names>J</given-names></name><name><surname>Gollwitzer</surname><given-names>P</given-names></name><name><surname>Oettingen</surname><given-names>G</given-names></name><name><surname>Pappadopulos</surname><given-names>E</given-names></name><name><surname>Hoagwood</surname><given-names>KE</given-names></name></person-group><article-title>Applying theory-driven approaches to understanding and modifying clinicians' behavior: what do we know?</article-title><source>Psychiatr Serv</source><year>2007</year><volume>58</volume><fpage>342</fpage><lpage>348</lpage><pub-id pub-id-type="pmid">17325107</pub-id></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Fishbein</surname><given-names>M</given-names></name><name><surname>Ajzen</surname><given-names>I</given-names></name></person-group><source>Belief, attitude, intention and behavior: an introduction to theory of research</source><year>1975</year><publisher-name>Reading, Mass.; Don Mills, On.: Addison-Wesley</publisher-name></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ajzen</surname><given-names>I</given-names></name></person-group><article-title>The theory of planned behavior</article-title><source>Organ Behav Hum Decis Process</source><year>1991</year><volume>50</volume><fpage>179</fpage><lpage>211</lpage></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bandura</surname><given-names>A</given-names></name></person-group><source>Social Foundations of Thought and Action: a Social Cognitive Theory</source><year>1986</year><publisher-name>Englewood Cliffs, N. J.: Prentice-Hall</publisher-name></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Triandis</surname><given-names>HC</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Page MM</surname></name></person-group><article-title>Values, attitudes and interpersonal behavior</article-title><source>Nebraska Symposium on Motivation Beliefs, Attitudes and Values</source><year>1980</year><volume>1</volume><publisher-name>Lincoln, NE: University of Nebraska Press</publisher-name><fpage>195</fpage><lpage>259</lpage></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Fishbein</surname><given-names>M</given-names></name><name><surname>Triandis</surname><given-names>HC</given-names></name><name><surname>Kanfer</surname><given-names>FH</given-names></name><name><surname>Becker</surname><given-names>M</given-names></name><name><surname>Middlestadt</surname><given-names>SE</given-names></name><name><surname>Eichler</surname><given-names>A</given-names></name><name><surname>Baum</surname><given-names>A</given-names></name><name><surname>Revenson</surname><given-names>TA</given-names></name><name><surname>Singer Jerome</surname><given-names>E</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Baum A, Revenson T, Singer J</surname></name></person-group><article-title>Factors influencing behavior and behavior change</article-title><source>Handbook of Health Psychology</source><year>2001</year><publisher-name>Mahwah NJ: Lawrence Erlbaum Associates</publisher-name><fpage>3</fpage><lpage>17</lpage></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rashidian</surname><given-names>A</given-names></name><name><surname>Miles</surname><given-names>J</given-names></name><name><surname>Russell</surname><given-names>D</given-names></name><name><surname>Russell</surname><given-names>I</given-names></name></person-group><article-title>Sample size for regression analyses of theory of planned behaviour studies: case of prescribing in general practice</article-title><source>Br J Health Psychol</source><year>2006</year><volume>11</volume><fpage>581</fpage><lpage>593</lpage><pub-id pub-id-type="pmid">17032485</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cronbach</surname><given-names>LJ</given-names></name></person-group><article-title>Coefficient alpha and the internal structure of tests</article-title><source>Psychometrika</source><year>1951</year><volume>16</volume><fpage>297</fpage><lpage>334</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-grou