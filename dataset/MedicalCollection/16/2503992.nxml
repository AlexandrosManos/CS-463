age>418</fpage><lpage>421</lpage><pub-id pub-id-type="pmid">10664294</pub-id><pub-id pub-id-type="doi">10.1007/s005340050143</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yeh</surname><given-names>H</given-names></name><name><surname>Weiss</surname><given-names>M</given-names></name><name><surname>Gerson</surname><given-names>C</given-names></name></person-group><article-title>Torsion of the gallbladder: the ultrasonographic features</article-title><source>J Clin Ultrasound</source><year>1989</year><volume>17</volume><fpage>123</fpage><lpage>125</lpage><pub-id pub-id-type="pmid">2492561</pub-id><pub-id pub-id-type="doi">10.1002/jcu.1870170211</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Aibe</surname><given-names>H</given-names></name><name><surname>Honda</surname><given-names>H</given-names></name><name><surname>Kuroiwa</surname><given-names>T</given-names></name><name><surname>Yoshimitsu</surname><given-names>K</given-names></name><name><surname>Irie</surname><given-names>H</given-names></name><name><surname>Shinozaki</surname><given-names>K</given-names></name><name><surname>Mizumoto</surname><given-names>K</given-names></name><name><surname>Nishiyama</surname><given-names>K</given-names></name><name><surname>Yamagata</surname><given-names>N</given-names></name><name><surname>Masuda</surname><given-names>K</given-names></name></person-group><article-title>Gallbladder torsion: a case report</article-title><source>Abdom Imaging</source><year>2002</year><volume>27</volume><fpage>51</fpage><lpage>53</lpage><pub-id pub-id-type="pmid">11740608</pub-id><pub-id pub-id-type="doi">10.1007/s00261-001-0050-7</pub-id></citation></ref></ref-list></back></article>