<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">BMC Genomics</journal-id><journal-title>BMC Genomics</journal-title><issn pub-type="epub">1471-2164</issn><publisher><publisher-name>BioMed Central</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">18655731</article-id><article-id pub-id-type="pmc">2515324</article-id><article-id pub-id-type="publisher-id">1471-2164-9-351</article-id><article-id pub-id-type="doi">10.1186/1471-2164-9-351</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research Article</subject></subj-group></article-categories><title-group><article-title>Analysis of expressed sequence tags from <italic>Actinidia</italic>: applications of a cross species EST database for gene discovery in the areas of flavor, health, color and ripening</article-title></title-group><contrib-group><contrib id="A1" contrib-type="author"><name><surname>Crowhurst</surname><given-names>Ross N</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>RCrowhurst@hortresearch.co.nz</email></contrib><contrib id="A2" contrib-type="author"><name><surname>Gleave</surname><given-names>Andrew P</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>agleave@hortresearch.co.nz</email></contrib><contrib id="A3" contrib-type="author"><name><surname>MacRae</surname><given-names>Elspeth A</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>Elspeth.MacRae@scionresearch.com</email></contrib><contrib id="A4" contrib-type="author"><name><surname>Ampomah-Dwamena</surname><given-names>Charles</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>cDwamena@hortresearch.co.nz</email></contrib><contrib id="A5" contrib-type="author"><name><surname>Atkinson</surname><given-names>Ross G</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>ratkinson@hortresearch.co.nz</email></contrib><contrib id="A6" contrib-type="author"><name><surname>Beuning</surname><given-names>Lesley L</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>lbeuning@hortresearch.co.nz</email></contrib><contrib id="A7" contrib-type="author"><name><surname>Bulley</surname><given-names>Sean M</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>sbulley@hortresearch.co.nz</email></contrib><contrib id="A8" contrib-type="author"><name><surname>Chagne</surname><given-names>David</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>dchagne@hortresearch.co.nz</email></contrib><contrib id="A9" contrib-type="author"><name><surname>Marsh</surname><given-names>Ken B</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>kmarsh@hortresearch.co.nz</email></contrib><contrib id="A10" contrib-type="author"><name><surname>Matich</surname><given-names>Adam J</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>amatich@hortresearch.co.nz</email></contrib><contrib id="A11" contrib-type="author"><name><surname>Montefiori</surname><given-names>Mirco</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>MMontefiori@hortresearch.co.nz</email></contrib><contrib id="A12" contrib-type="author"><name><surname>Newcomb</surname><given-names>Richard D</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>rnewcomb@hortresearch.co.nz</email></contrib><contrib id="A13" contrib-type="author"><name><surname>Schaffer</surname><given-names>Robert J</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>rschaffer@hortresearch.co.nz</email></contrib><contrib id="A14" contrib-type="author"><name><surname>Usadel</surname><given-names>Bj&#x000f6;rn</given-names></name><xref ref-type="aff" rid="I2">2</xref><email>usadel@mpimp-golm.mpg.de</email></contrib><contrib id="A15" contrib-type="author"><name><surname>Allan</surname><given-names>Andrew C</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>aallan@hortresearch.co.nz</email></contrib><contrib id="A16" contrib-type="author"><name><surname>Boldingh</surname><given-names>Helen L</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>hboldingh@hortresearch.co.nz</email></contrib><contrib id="A17" contrib-type="author"><name><surname>Bowen</surname><given-names>Judith H</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>jbowen@hortresearch.co.nz</email></contrib><contrib id="A18" contrib-type="author"><name><surname>Davy</surname><given-names>Marcus W</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>mdavy@hortresearch.co.nz</email></contrib><contrib id="A19" contrib-type="author"><name><surname>Eckloff</surname><given-names>Rheinhart</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>mwilliams@hortresearch.co.nz</email></contrib><contrib id="A20" contrib-type="author"><name><surname>Ferguson</surname><given-names>A Ross</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>rferguson@hortresearch.co.nz</email></contrib><contrib id="A21" contrib-type="author"><name><surname>Fraser</surname><given-names>Lena G</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>lfraser@hortresearch.co.nz</email></contrib><contrib id="A22" contrib-type="author"><name><surname>Gera</surname><given-names>Emma</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>egera@hortresearch.co.nz</email></contrib><contrib id="A23" contrib-type="author"><name><surname>Hellens</surname><given-names>Roger P</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>rhellens@hortresearch.co.nz</email></contrib><contrib id="A24" contrib-type="author"><name><surname>Janssen</surname><given-names>Bart J</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>Bjanssen@hortresearch.co.nz</email></contrib><contrib id="A25" contrib-type="aut