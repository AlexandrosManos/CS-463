bs</article-title><source>Cognition</source><year>1987</year><volume>27</volume><fpage>219</fpage><lpage>246</lpage><pub-id pub-id-type="pmid">3691026</pub-id><pub-id pub-id-type="doi">10.1016/S0010-0277(87)80010-0</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McRae</surname><given-names>K</given-names></name><name><surname>Ferretti</surname><given-names>T</given-names></name><name><surname>Amyote</surname><given-names>L</given-names></name></person-group><article-title>Thematic roles as verb-specic concepts</article-title><source>Lang Cog Proc</source><year>1997</year><volume>12-2/3</volume><fpage>137</fpage><lpage>176</lpage><pub-id pub-id-type="doi">10.1080/016909697386835</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Assadollahi</surname><given-names>R</given-names></name><name><surname>Pulverm&#x000fc;ller</surname><given-names>F</given-names></name></person-group><article-title>Neuromagnetic evidence for early access to cognitive representations</article-title><source>Neuroreport</source><year>2001</year><volume>12/2</volume><fpage>207</fpage><lpage>213</lpage><pub-id pub-id-type="pmid">11209922</pub-id><pub-id pub-id-type="doi">10.1097/00001756-200102120-00007</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Assadollahi</surname><given-names>R</given-names></name><name><surname>Pulverm&#x000fc;ller</surname><given-names>F</given-names></name></person-group><article-title>Early influences of word length and frequency: a group study in the MEG</article-title><source>Neuroreport</source><year>2003</year><volume>14/8</volume><fpage>1183</fpage><lpage>1187</lpage><pub-id pub-id-type="pmid">12821805</pub-id><pub-id pub-id-type="doi">10.1097/00001756-200306110-00016</pub-id></citation></ref><ref id="B22"><citation citation-t