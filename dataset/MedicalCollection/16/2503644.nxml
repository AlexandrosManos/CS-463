blisher-name></citation></ref><ref id="b15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clark</surname><given-names>C</given-names></name><name><surname>Bryden</surname><given-names>A</given-names></name><name><surname>Dawe</surname><given-names>R</given-names></name><etal/></person-group><article-title>Topical 5-aminolaevulinic acid photodynamic therapy for cutaneous lesions: outcome and comparison of light sources</article-title><source>Photodermatol Photoimmunol Photomed</source><year>2003</year><volume>19</volume><fpage>134</fpage><lpage>41</lpage><pub-id pub-id-type="pmid">12914598</pub-id></citation></ref><ref id="b16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cockerell</surname><given-names>CJ</given-names></name></person-group><article-title>Histopathology of incipient intraepidermal squamous cell carcinoma (&#x0201c;actinic keratosis&#x0201d;)</article-title><source>J Am Acad Dermatol</source><year>2000</year><volume>42</volume><fpage>S11</fpage><lpage>17</lpage></citation></ref><ref id="b17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Curnow</surname><given-names>A</given-names></name><name><surname>Haller</surname><given-names>JC</given-names></name><name><surname>Bown</surname><given-names>SG</given-names></name></person-group><article-title>Oxygen monitoring during 5-aminolaevulinic acid induced photodynamic therapy in normal rat colon &#x02013; Comparison of continuous and fractionated light regimes</article-title><source>J Photochem Photobiol B-Biology</source><year>2000</year><volume>58</volume><fpage>149</fpage><lpage>55</lpage></citation></ref><ref id="b18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dailey</surname><given-names>HA</given-names></name><name><surname>Smith</surname><given-names>A</given-names></name></person-group><article-title>Differential interact