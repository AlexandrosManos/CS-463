-names>U.S</given-names></name></person-group><article-title>Cell organization in soft media due to active mechanosensing</article-title><source>Proc. Natl Acad. Sci. USA</source><volume>100</volume><year>2003</year><fpage>9274</fpage><lpage>9279</lpage><ext-link ext-link-type="uri" xlink:href="http://dx.doi.org/doi:10.1073/pnas.1233544100">doi:10.1073/pnas.1233544100</ext-link><pub-id pub-id-type="pmid">12883003</pub-id></mixed-citation></ref><ref id="bib5"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cavalcanti-Adam</surname><given-names>E.A</given-names></name><name><surname>Volberg</surname><given-names>T</given-names></name><name><surname>Micoulet</surname><given-names>A</given-names></name><name><surname>Kessler</surname><given-names>H</given-names></name><name><surname>Geiger</surname><given-names>B</given-names></name><name><surname>Spatz</surname><given-names>J.P</given-names></name></person-group><article-title>Cell spreading and focal adhesion dynamics are regulated by spacing of integrin ligands</article-title><source>Biophys. J</source><volume>92</volume><year>2007</year><fpage>2964</fpage><lpage>2974</lpage><ext-link ext-link-type="uri" xlink:href="http://dx.doi.org/doi:10.1529/biophysj.106.089730">doi:10.1529/biophysj.106.089730</ext-link><pub-id pub-id-type="pmid">17277192</pub-id></mixed-citation></ref><ref id="bib6"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>C.S</given-names></name><name><surname>Mrksich</surname><given-names>M</given-names></name><name><surname>Huang</surname><given-names>S</given-names></name><name><surname>Whitesides</surname><given-names>G.M</given-names></name><name><surname>Ingber</surname><given-names>D.E</given-names></name></person-group><article-title>Geometric control of cell life and death</article-title><source>Science</source><volume>276</volume><year>1997</year><fpage>1425</fpage><l