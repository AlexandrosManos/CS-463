ear>2005</year><article-title>Congenital anomaly surveillance in England&#x02014;ascertainment deficiencies in the national system</article-title><source>BMJ</source><volume>330</volume><fpage>27</fpage><lpage>31</lpage><pub-id pub-id-type="pmid">15561730</pub-id></citation></ref><ref id="b6-ehp0116-001111"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carstairs</surname><given-names>V</given-names></name><name><surname>Morris</surname><given-names>R</given-names></name></person-group><year>1989</year><article-title>Deprivation: explaining differences in mortality between Scotland and England and Wales</article-title><source>BMJ</source><volume>299</volume><fpage>886</fpage><lpage>889</lpage><pub-id pub-id-type="pmid">2510878</pub-id></citation></ref><ref id="b7-ehp0116-001111"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Elliott</surname><given-names>P</given-names></name><name><surname>Briggs</surname><given-names>D</given-names></name><name><surname>Morris</surname><given-names>S</given-names></name><name><surname>de Hoogh</surname><given-names>C</given-names></name><name><surname>Hurt</surname><given-names>C</given-names></name><name><surname>Jensen</surname><given-names>TK</given-names></name><etal/></person-group><year>2001</year><article-title>Risk of adverse birth outcomes in populations living near landfill sites</article-title><source>BMJ</source><volume>323</volume><fpage>363</fpage><lpage>368</lpage><pub-id pub-id-type="pmid">11509424</pub-id></citation></ref><ref id="b8-ehp0116-001111"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Ferr&#x000e1;ndiz</surname><given-names>J</given-names></name><name><surname>Abell&#x000e1;n</surname><given-names>JJ</given-names></name><name><surname>L&#x000f3;pez</surname><given-names>A</given-names></name><name><surname>Sanmartin</surname><given-names>P</given-names></name><name><surname>Vanac