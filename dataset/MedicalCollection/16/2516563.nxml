<surname>Best</surname><given-names>N</given-names></name><name><surname>Toledano</surname><given-names>MB</given-names></name><name><surname>Wakefield</surname><given-names>JC</given-names></name><name><surname>Elliott</surname><given-names>P</given-names></name></person-group><year>2002</year><article-title>Geographical epidemiology of prostate cancer in Great Britain</article-title><source>Int J Cancer</source><volume>97</volume><fpage>695</fpage><lpage>699</lpage><pub-id pub-id-type="pmid">11807800</pub-id></citation></ref><ref id="b12-ehp0116-001111"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Knorr-Held</surname><given-names>L</given-names></name></person-group><year>2000</year><article-title>Bayesian modelling of inseparable space&#x02013;time variation in disease risk</article-title><source>Stat Med</source><volume>19</volume><fpage>2555</fpage><lpage>2567</lpage><pub-id pub-id-type="pmid">10960871</pub-id></citation></ref><ref id="b13-ehp0116-001111"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Knorr-Held</surname><given-names>L</given-names></name><name><surname>Besag</surname><given-names>J</given-names></name></person-group><year>1998</year><article-title>Modelling risk from a disease in time and space</article-title><source>Stat Med</source><volume>17</volume><fpage>2045</fpage><lpage>2060</lpage><pub-id pub-id-type="pmid">9789913</pub-id></citation></ref><ref id="b14-ehp0116-001111"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Mardia</surname><given-names>K</given-names></name><name><surname>Kent</surname><given-names>J</given-names></name><name><surname>Bibby</surname><given-names>J</given-names></name></person-group><year>1979</year><source>Multivariate Analysis</source><publisher-loc>London</publisher-loc><publisher-name>Academic Press</publisher-name></citation></ref><ref id="b15-ehp0116-001111"><citation citation-typ