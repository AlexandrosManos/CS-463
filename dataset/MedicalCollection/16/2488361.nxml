ion></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Somel</surname><given-names>M</given-names></name><name><surname>Khaitovich</surname><given-names>P</given-names></name><name><surname>Bahn</surname><given-names>S</given-names></name><name><surname>P&#x000e4;&#x000e4;bo</surname><given-names>S</given-names></name><name><surname>Lachmann</surname><given-names>M</given-names></name></person-group><article-title>Gene expression becomes heterogeneous with age</article-title><source>Current Biol</source><year>2006</year><volume>16</volume><fpage>R360</fpage></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gill</surname><given-names>JL</given-names></name></person-group><article-title>Analyses of data with heterogeneous variance: a review</article-title><source>J Dairy Sci</source><year>1971</year><volume>54</volume><fpage>369</fpage><lpage>373</lpage></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weigel</surname><given-names>KA</given-names></name><name><surname>Gianola</surname><given-names>D</given-names></name></person-group><article-title>Estimation of heterogeneous within-herd variance components using empirical Bayes methods: a simulation study</article-title><source>J Dairy Sci</source><year>1992</year><volume>75</volume><fpage>2824</fpage><lpage>2833</lpage><pub-id pub-id-type="pmid">1430486</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kendziorski</surname><given-names>CM</given-names></name><name><surname>Newton</surname><given-names>MA</given-names></name><name><surname>Lan</surname><given-names>H</given-names></name><name><surname>Gould</surname><given-names>MN</given-names></name></person-group><article-title>On parametric empirical Bayes methods for comparing multiple group