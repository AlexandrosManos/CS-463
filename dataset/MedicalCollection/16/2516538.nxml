roup-type="author"><name><surname>Constantino</surname><given-names>J. N.</given-names></name><name><surname>Todd</surname><given-names>R. D.</given-names></name></person-group><article-title>Intergenerational transmission of subthreshold autistic traits in the general population</article-title><source>Biological Psychiatry</source><year>2005</year><volume>57</volume><fpage>655</fpage><lpage>660</lpage><pub-id pub-id-type="doi">10.1016/j.biopsych.2004.12.014</pub-id></citation><citation citation-type="display-unstructured">Constantino, J. N., &#x00026; Todd, R. D. (2005). Intergenerational transmission of subthreshold autistic traits in the general population. Biological Psychiatry, 57, 655&#x02013;660. <pub-id pub-id-type="pmid">15780853</pub-id></citation></ref><ref id="CR15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Constantino</surname><given-names>J. N.</given-names></name><name><surname>Lajonchere</surname><given-names>C.</given-names></name><name><surname>Lutz</surname><given-names>M.</given-names></name><name><surname>Gray</surname><given-names>T.</given-names></name><name><surname>Abbacchi</surname><given-names>A.</given-names></name><name><surname>McKenna</surname><given-names>K.</given-names></name><etal/></person-group><article-title>Autistic social impairment in the siblings of children with pervasive developmental disorders</article-title><source>American Journal of Psychiatry</source><year>2006</year><volume>163</volume><fpage>294</fpage><lpage>296</lpage><pub-id pub-id-type="doi">10.1176/appi.ajp.163.2.294</pub-id></citation><citation citation-type="display-unstructured">Constantino, J. N., Lajonchere, C., Lutz, M., Gray, T., Abbacchi, A., McKenna, K., et al. (2006). Autistic social impairment in the siblings of children with pervasive developmental disorders. American Journal of Psychiatry, 163, 294&#x02013;296. <pub-id pub-id-type="pmid">16449484</pub-id></citation></ref><ref id="CR16"><citation citat