03;&#x02003;Basal</td><td colspan="1" rowspan="1" align="center" valign="top">13 &#x000b1; 3</td><td colspan="1" rowspan="1" align="center" valign="top">15 &#x000b1; 3</td><td colspan="1" rowspan="1" align="center" valign="top">13 &#x000b1; 3</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;ICV</td><td colspan="1" rowspan="1" align="center" valign="top">17 &#x000b1; 3</td><td colspan="1" rowspan="1" align="center" valign="top">15 &#x000b1; 3</td><td colspan="1" rowspan="1" align="center" valign="top">13 &#x000b1; 2</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Clamp</td><td colspan="1" rowspan="1" align="center" valign="top">13 &#x000b1; 3</td><td colspan="1" rowspan="1" align="center" valign="top">18 &#x000b1; 2</td><td colspan="1" rowspan="1" align="center" valign="top">16 &#x000b1; 2</td></tr></tbody></table><table-wrap-foot><fn><p>Data are means &#x000b1; SE. Neither insulin nor corticosterone levels significantly changed over time in any group during the hyperinsulinemic-euglycemic clamp. ICV, intracerebroventricular.</p></fn></table-wrap-foot></table-wrap><table-wrap position="float" id="t4"><label>TABLE 4</label><caption><p>Effect of ARC, PVN, and i3vt GLP-1 on basal glucose production and uptake</p></caption><table frame="hsides" rules="groups"><thead><tr><th colspan="1" rowspan="1" align="center" valign="bottom"/><th colspan="1" rowspan="1" align="center" valign="bottom">Saline</th><th colspan="1" rowspan="1" align="center" valign="bottom">ARC GLP-1</th><th colspan="1" rowspan="1" align="center" valign="bottom">i3vt GLP-1</th><th colspan="1" rowspan="1" align="center" valign="bottom">GLP-1 plus glibenclamide</th></tr></thead><tbody><tr><td colspan="1" rowspan="1" align="left" valign="top">Glucose production (&#x003bc;mol &#x000b7; kg<sup>&#x02212;1</sup> &#x000b7; min<sup>&#x02212;1</sup>)</td><td colspan="1" rowspan="1" align="center" valign="top"