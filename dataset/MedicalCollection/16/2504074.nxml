etal/></person-group><article-title>The validity and responsiveness of three quality of life measures in the assessment of psoriasis patients: results of a phase II study</article-title><source>Health Qual Life Outcomes</source><year>2006</year><volume>4</volume><fpage>71</fpage><pub-id pub-id-type="pmid">17005043</pub-id></citation></ref><ref id="b30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Winterfield</surname><given-names>LS</given-names></name><name><surname>Menter</surname><given-names>A</given-names></name><name><surname>Gordon</surname><given-names>K</given-names></name><etal/></person-group><article-title>Psoriasis treatment: current and emerging directed therapies</article-title><source>Ann Rheum Dis</source><year>2005</year><volume>64</volume><issue>Suppl 2</issue><fpage>ii87</fpage><lpage>90</lpage><pub-id pub-id-type="pmid">15708946</pub-id></citation></ref></ref-list></back></article>