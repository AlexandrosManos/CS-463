itation-type="book"><person-group person-group-type="author"><name><surname>Lurie</surname><given-names>P</given-names></name><name><surname>Hintzen</surname><given-names>P</given-names></name><name><surname>Lowe</surname><given-names>RA</given-names></name></person-group><year>2004</year><article-title>Socioeconomic obstacles to HIV prevention and treatment in developing countries: the roles of the International Monetary Fund and the World Bank</article-title><person-group person-group-type="editor"><name><surname>Kalipeni</surname><given-names>E</given-names></name></person-group><source>HIV and AIDS in Africa: beyond epidemiology</source><publisher-loc>Oxford</publisher-loc><publisher-name>Blackwell Publishing</publisher-name></citation></ref><ref id="pmed-0050143-b018"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lurie</surname><given-names>M</given-names></name></person-group><year>2005</year><source>HIV/AIDS in South Africa</source><person-group person-group-type="editor"><name><surname>Karim</surname><given-names>SA</given-names></name><name><surname>Karim</surname><given-names>Q</given-names></name></person-group><publisher-loc>Cambridge, New York</publisher-loc><publisher-name>Cambridge University Press</publisher-name></citation></ref><ref id="pmed-0050143-b019"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Farmer</surname><given-names>P</given-names></name></person-group><year>1999</year><source>Infections and inequalities: the modern plagues</source><publisher-loc>Berkeley</publisher-loc><publisher-name>University of California Press</publisher-name></citation></ref><ref id="pmed-0050143-b020"><citation citation-type="book"><collab>World Health Organization (WHO)</collab><year>2007</year><source>Global tuberculosis database</source><publisher-loc>Geneva</publisher-loc><publisher-name>World Health Organization</publisher-name></citation></ref><ref id="pmed-0050143-b021"><ci