ame><name><surname>Iglewski</surname><given-names>BH</given-names></name></person-group><article-title>Regulation of <italic>las</italic> and <italic>rhl</italic> quorum sensing in <italic>Pseudomonas aeruginosa</italic></article-title><source>J Bacteriol</source><year>1997</year><volume>179</volume><fpage>3127</fpage><lpage>3132</lpage><pub-id pub-id-type="pmid">9150205</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Henry</surname><given-names>DA</given-names></name><name><surname>Campbell</surname><given-names>ME</given-names></name><name><surname>LiPuma</surname><given-names>JJ</given-names></name><name><surname>Speert</surname><given-names>DP</given-names></name></person-group><article-title>Identification of <italic>Burkholderia cepacia</italic> isolates from patients with cystic fibrosis and use of a simple new selective medium</article-title><source>J Clin Microbiol</source><year>1997</year><volume>35</volume><fpage>614</fpage><lpage>619</lpage><pub-id pub-id-type="pmid">9041399</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bernier</surname><given-names>SP</given-names></name><name><surname>Nguyen</surname><given-names>DT</given-names></name><name><surname>Sokol</surname><given-names>PA</given-names></name></person-group><article-title>A LysR-type transcriptional regulator in <italic>Burkholderia cenocepacia</italic> influences colony morphology and virulence</article-title><source>Infect Immun</source><year>2008</year><volume>76</volume><fpage>38</fpage><lpage>47</lpage><pub-id pub-id-type="pmid">17967860</pub-id><pub-id pub-id-type="doi">10.1128/IAI.00874-07</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cegelski</surname><given-names>L</given-names></name><name><surname>Marshall</surname><given-names>GR</given-nam