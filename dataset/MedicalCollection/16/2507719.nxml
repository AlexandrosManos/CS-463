Urol</source><year>1980</year><volume>124</volume><fpage>930</fpage><lpage>931</lpage><pub-id pub-id-type="pmid">7192326</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Abbasoglu</surname><given-names>L</given-names></name><name><surname>Salman</surname><given-names>FT</given-names></name><name><surname>Gun</surname><given-names>F</given-names></name><name><surname>Asicioglu</surname><given-names>C</given-names></name></person-group><article-title>Polyorchidism presenting with undescended testis</article-title><source>Eur J Pediatr Surg</source><year>2004</year><volume>14</volume><fpage>355</fpage><lpage>357</lpage><pub-id pub-id-type="pmid">15543488</pub-id><pub-id pub-id-type="doi">10.1055/s-2004-821107</pub-id></citation></ref></ref-list></back></article>