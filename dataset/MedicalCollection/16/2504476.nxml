roup-type="author"><name><surname>Moore</surname><given-names>PS</given-names></name></person-group><article-title>Meningococcal meningitis in sub-Saharan Africa: a model for the epidemic process</article-title><source>Clin Infect Dis</source><year>1992</year><volume>14</volume><fpage>515</fpage><lpage>25</lpage><pub-id pub-id-type="pmid">1554841</pub-id></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><collab>WHO</collab></person-group><source>Guidelines on the Control of Epidemic Meningococcal Disease, WHO/EMC/BAC/983</source><year>1998</year><edition>second</edition></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kalnay</surname><given-names>E</given-names></name><etal></etal></person-group><article-title>The NCEP/NCAR 40-year reanalysis project</article-title><source>Bull Amer Meteorol Soc</source><year>1996</year><volume>77</volume><fpage>437</fpage><lpage>471</lpage><pub-id pub-id-type="doi">10.1175/1520-0477(1996)077&#x0003c;0437:TNYRP&#x0003e;2.0.CO;2</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Camberlin</surname><given-names>P</given-names></name><name><surname>Janicot</surname><given-names>S</given-names></name><name><surname>Poccard</surname><given-names>I</given-names></name></person-group><article-title>Seasonality and atmospheric dynamics of the teleconnections between African rainfall and tropical ocean surface temperature: Atlantic vs. ENSO</article-title><source>Int J Climatol</source><year>2001</year><volume>21</volume><fpage>973</fpage><lpage>1005</lpage><pub-id pub-id-type="doi">10.1002/joc.673</pub-id></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Venables</surname><given-names>WN</given-names></name><name><surname>Ripley</surname><given-names>BD</given-names></name></person-group><source>Modern Applied Statistics with S-PLUS</source><year>2002</year><edition>4</edition><publisher-name>New-York, Springer-Verlag</publisher-name></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mason</surname><given-names>SJ</given-names></name><name><surname>Graham</surname><given-names>NE</given-names></name></person-group><article-title>Conditional Probabilities, Relative Operating Characteristics, and Relative Operating Levels</article-title><source>Weather and Forecasting</source><year>1999</year><volume>14</volume><fpage>713</fpage><lpage>725</lpage><pub-id pub-id-type="doi">10.1175/1520-0434(1999)014&#x0003c;0713:CPROCA&#x0003e;2.0.CO;2</pub-id></citation></ref><ref id="B21"><citation citation-type="other"><person-group person-group-type="author"><collab>WMO</collab></person-group><source>Standardised Verification System for Long-Range Forecasts, New Attachment II-8 to the Manual on the GDPFS (WMO-No 485)</source><year>2006</year><volume>I</volume></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kermack</surname><given-names>WO</given-names></name><name><surname>McKendrick</surname><given-names>AG</given-names></name></person-group><article-title>A contribution to the mathematical theory of epidemics</article-title><source>Proc R Soc Lond A</source><year>1927</year><volume>115</volume><fpage>700</fpage><lpage>721</lpage><pub-id pub-id-type="doi">10.1098/rspa.1927.0118</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Drake</surname><given-names>JM</given-names></name></person-group><article-title>Limits to forecasting precision for outbreaks of directly transmitted diseases</article-title><source>PLoS Med</source><year>2006</year><volume>3</volume><fpage>e3</fpage><pub-id pub-id-type="pmid">16435887</pub-id><pub-id pub-id-type="doi">10.1371/journal.pmed.0030003</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Robbins</surname><given-names>JB</given-names></name></person-group><article-title>Meningococcal meningitis in sub-Saharan Africa: the case for mass and routine vaccination with available polysaccharide vaccines</article-title><source>Bull WHO</source><year>2003</year><pub-id pub-id-type="pmid">14758435</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Robbins</surname><given-names>JB</given-names></name><name><surname>Towne</surname><given-names>DW</given-names></name><name><surname>Gotschlich</surname><given-names>EC</given-names></name><name><surname>Schneerson</surname><given-names>R</given-names></name></person-group><article-title>"Love's labours lost": failure to implement mass vaccination against group A meningococcal meningitis in sub-Saharan Africa</article-title><source>Lancet</source><year>1997</year><volume>350</volume><fpage>880</fpage><lpage>882</lpage><pub-id pub-id-type="pmid">9310615</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(97)03227-3</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chippaux</surname><given-names>JP</given-names></name><name><surname>Debois</surname><given-names>H</given-names></name><name><surname>Saliou</surname><given-names>P</given-names></name></person-group><article-title>A critical review of control strategies against meningococcal meningitis epidemics in sub-Saharan African countries</article-title><source>Infection</source><year>2002</year><volume>30</volume><fpage>216</fpage><lpage>224</lpage><pub-id pub-id-type="pmid">12236565</pub-id><pub-id pub-id-type="doi">10.1007/s15010-002-3012-2</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tikhomirov</surname><given-names>E</given-names></name><name><surname>Santamaria</surname><given-names>M</given-names></name><name><surname>Esteves</surname><given-names>K</given-names></name></person-group><article-title>Meningococcal disease: public health burden and control</article-title><source>Rapp Trimest Stat Sant Mond</source><year>1997</year><volume>50</volume><fpage>170</fpage><lpage>177</lpage></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><collab>WHO</collab></person-group><article-title>Detecting meningococcal meningitis epidemics in highly-endemic African countries</article-title><source>Weekly Epidemiological Record</source><year>2000</year><volume>38</volume></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cuevas</surname><given-names>LE</given-names></name><name><surname>Jeanne</surname><given-names>I</given-names></name><name><surname>Molesworth</surname><given-names>A</given-names></name><name><surname>Bell</surname><given-names>M</given-names></name><name><surname>Savory</surname><given-names>EC</given-names></name><name><surname>Connor</surname><given-names>SJ</given-names></name><name><surname>Thomson</surname><given-names>MC</given-names></name></person-group><article-title>Risk mapping and early warning systems for the control of meningitis in Africa</article-title><source>Vaccine</source><year>2007</year><volume>25</volume><fpage>A12</fpage><lpage>A17</lpage><pub-id pub-id-type="pmid">17517453</pub-id><pub-id pub-id-type="doi">10.1016/j.vaccine.2007.04.034</pub-id></citation></ref></ref-list></back></article>