mml:mo><mml:mn>0.33</mml:mn><mml:mo>&#x022c5;</mml:mo><mml:mtext>y</mml:mtext><mml:mo>&#x02212;</mml:mo><mml:mn>1</mml:mn><mml:mo stretchy="false">)</mml:mo></mml:mrow><mml:mrow><mml:mo stretchy="false">(</mml:mo><mml:mn>2.12</mml:mn><mml:mo>&#x02212;</mml:mo><mml:mn>0.21</mml:mn><mml:mo>&#x022c5;</mml:mo><mml:mi>y</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mrow></mml:mfrac></mml:mrow></mml:semantics></mml:math></inline-formula></td></tr><tr><td align="center"><bold>PHV Storage</bold></td><td align="center"><inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M27" name="1752-0509-2-59-i22" overflow="scroll"><mml:semantics><mml:mrow><mml:msub><mml:mi>Y</mml:mi><mml:mrow><mml:mstyle scriptlevel="+1"><mml:mfrac bevelled="true"><mml:mrow><mml:mi>P</mml:mi><mml:mi>H</mml:mi><mml:mi>V</mml:mi></mml:mrow><mml:mi>S</mml:mi></mml:mfrac></mml:mstyle></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:mfrac><mml:mrow><mml:mo stretchy="false">(</mml:mo><mml:mn>4</mml:mn><mml:mo>&#x022c5;</mml:mo><mml:mi>&#x003b4;</mml:mi><mml:mo>+</mml:mo><mml:mn>0.67</mml:mn><mml:mo>&#x022c5;</mml:mo><mml:mi>y</mml:mi><mml:mo>&#x022c5;</mml:mo><mml:mi>&#x003b4;</mml:mi><mml:mo>+</mml:mo><mml:mn>0.33</mml:mn><mml:mo>&#x022c5;</mml:mo><mml:mtext>y</mml:mtext><mml:mo>&#x02212;</mml:mo><mml:mn>1</mml:mn><mml:mo stretchy="false">)</mml:mo></mml:mrow><mml:mrow><mml:mo stretchy="false">(</mml:mo><mml:mn>4</mml:mn><mml:mo>&#x022c5;</mml:mo><mml:mn>8</mml:mn><mml:mo>&#x022c5;</mml:mo><mml:mi>&#x003b4;</mml:mi><mml:mo>+</mml:mo><mml:mn>0.8</mml:mn><mml:mo stretchy="false">)</mml:mo></mml:mrow></mml:mfrac></mml:mrow></mml:semantics></mml:math></inline-formula></td><td align="center"><inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M28" name="1752-0509-2-59-i23" overflow="scroll"><mml:semantics><mml:mrow><mml:msub><mml:mi>Y</mml:mi><mml:mrow><mml:mstyle scriptlevel="+1"><mml:mfrac bevelled="true"><mml:mrow><mml:mi>P</mml:mi><mml:mi>H</mml:mi><mml:mi>V</mm