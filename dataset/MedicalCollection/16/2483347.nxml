group><year>1997</year><article-title>Small Spheres in Fossil Bones: Blood Corpuscles or Diagenetic Products?</article-title><source>Palaeontology</source><volume>40</volume><fpage>619</fpage><lpage>624</lpage></citation></ref><ref id="pone.0002808-Robinson1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Robinson</surname><given-names>RW</given-names></name><name><surname>Akin</surname><given-names>DE</given-names></name><name><surname>Nordstedt</surname><given-names>RA</given-names></name><name><surname>Thomas</surname><given-names>MV</given-names></name><name><surname>Aldrich</surname><given-names>HC</given-names></name></person-group><year>1984</year><article-title>Light and Electron Microscopic Examinations of Methane Producing Biofilms from Anaerobic Fixed-Bed Reactors.</article-title><source>Applied and Environmental Microbiology</source><volume>48</volume><fpage>127</fpage><lpage>136</lpage><pub-id pub-id-type="pmid">16346579</pub-id></citation></ref><ref id="pone.0002808-Flora1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Flora</surname><given-names>JRV</given-names></name><name><surname>Suidan</surname><given-names>MT</given-names></name><name><surname>Biswas</surname><given-names>P</given-names></name><name><surname>Sayles</surname><given-names>GD</given-names></name></person-group><year>1995</year><article-title>A Modeling Study of Anaerobic Biofilm Systems: 1. Detailed Biofilm Modeling.</article-title><source>Biotechnology and Bioengineering</source><volume>46</volume><fpage>43</fpage><lpage>53</lpage><pub-id pub-id-type="pmid">18623261</pub-id></citation></ref><ref id="pone.0002808-Asara1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Asara</surname><given-names>JM</given-names></name><name><surname>Schweitzer</surname><given-names>MH</given-names></name><name><surname>Fr