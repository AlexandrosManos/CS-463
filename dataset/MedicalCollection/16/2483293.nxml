 id="B4"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Prasad</surname><given-names>MD</given-names></name><name><surname>Muthulakshmi</surname><given-names>M</given-names></name><name><surname>Arunkumar</surname><given-names>KP</given-names></name><name><surname>Madhu</surname><given-names>M</given-names></name><name><surname>Sreenu</surname><given-names>VB</given-names></name><name><surname>Pavithra</surname><given-names>V</given-names></name><name><surname>Bose</surname><given-names>B</given-names></name><name><surname>Nagarajaram</surname><given-names>HA</given-names></name><name><surname>Mita</surname><given-names>K</given-names></name><name><surname>Shimada</surname><given-names>T</given-names></name><name><surname>Nagaraju</surname><given-names>J</given-names></name></person-group><article-title>SilkSatDb: a microsatellite database of the silkworm, <italic>Bombyx mori</italic></article-title><source>Nucleic Acids Res</source><year>2005</year><volume>33</volume><fpage>D403</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">15608226</pub-id><pub-id pub-id-type="doi">10.1093/nar/gki099</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Papanicolaou</surname><given-names>A</given-names></name><name><surname>Gebauer-Jung</surname><given-names>S</given-names></name><name><surname>Blaxter</surname><given-names>ML</given-names></name><name><surname>Owen McMillan</surname><given-names>W</given-names></name><name><surname>Jiggins</surname><given-names>CD</given-names></name></person-group><article-title>ButterflyBase: a platform for lepidopteran genomics</article-title><source>Nucleic Acids Res</source><year>2008</year><volume>36</volume><fpage>D582</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">17933781</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Negre</surname><gi