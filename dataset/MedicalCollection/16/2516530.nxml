/volume><fpage>1961</fpage><lpage>1973</lpage><pub-id pub-id-type="pmid">15342533</pub-id></citation></ref><ref id="pone.0003061-McClintock1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McClintock</surname><given-names>B</given-names></name></person-group><year>1984</year><article-title>The significance of responses of the genome to challenge.</article-title><source>Science</source><volume>226</volume><fpage>792</fpage><lpage>801</lpage><pub-id pub-id-type="pmid">15739260</pub-id></citation></ref><ref id="pone.0003061-Shaked1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shaked</surname><given-names>H</given-names></name><name><surname>Kashkush</surname><given-names>K</given-names></name><name><surname>Ozkan</surname><given-names>H</given-names></name><name><surname>Feldman</surname><given-names>M</given-names></name><name><surname>Levy</surname><given-names>AA</given-names></name></person-group><year>2001</year><article-title>Sequence elimination and cytosine methylation are rapid and reproducible responses of the genome to wide hybridization and allopolyploidy in wheat.</article-title><source>Plant Cell</source><volume>13</volume><fpage>1749</fpage><lpage>1759</lpage><pub-id pub-id-type="pmid">11487690</pub-id></citation></ref><ref id="pone.0003061-Josefsson1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Josefsson</surname><given-names>C</given-names></name><name><surname>Dilkes</surname><given-names>B</given-names></name><name><surname>Comai</surname><given-names>L</given-names></name></person-group><year>2006</year><article-title>Parent-dependent loss of gene silencing during interspecies hybridization.</article-title><source>Curr Biol</source><volume>16</volume><fpage>1322</fpage><lpage>1328</lpage><pub-id pub-id-type="pmid">16824920</pub-id></citation></ref><ref id="pone.0003061-Liu2"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>B</given-names></name><name><surname>Brubaker</surname><given-names>CL</given-names></name><name><surname>Mergeai</surname><given-names>G</given-names></name><name><surname>Cronn</surname><given-names>RC</given-names></name><name><surname>Wendel</surname><given-names>JF</given-names></name></person-group><year>2001</year><article-title>Polyploid formation in cotton is not accompanied by rapid genomic changes.</article-title><source>Genome</source><volume>44</volume><fpage>321</fpage><lpage>330</lpage><pub-id pub-id-type="pmid">11444689</pub-id></citation></ref><ref id="pone.0003061-Storchova1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Storchova</surname><given-names>Z</given-names></name><name><surname>Breneman</surname><given-names>A</given-names></name><name><surname>Cande</surname><given-names>J</given-names></name><name><surname>Dunn</surname><given-names>J</given-names></name><name><surname>Burbank</surname><given-names>K</given-names></name><etal/></person-group><year>2006</year><article-title>Genome-wide genetic analysis of polyploidy in yeast.</article-title><source>Nature</source><volume>443</volume><fpage>541</fpage><lpage>547</lpage><pub-id pub-id-type="pmid">17024086</pub-id></citation></ref><ref id="pone.0003061-Stupar1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stupar</surname><given-names>RM</given-names></name><name><surname>Springer</surname><given-names>NM</given-names></name></person-group><year>2006</year><article-title>Cis-transcriptional variation in maize inbred lines B73 and Mo17 leads to additive expression patterns in the F1 hybrid.</article-title><source>Genetics</source><volume>173</volume><fpage>2199</fpage><lpage>2210</lpage><pub-id pub-id-type="pmid">16702414</pub-id></citation></ref><ref id="pone.0003061-MittelstenScheid1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mittelsten Scheid</surname><given-names>O</given-names></name><name><surname>Jakovleva</surname><given-names>L</given-names></name><name><surname>Afsar</surname><given-names>K</given-names></name><name><surname>Maluszynska</surname><given-names>J</given-names></name><name><surname>Paszkowski</surname><given-names>J</given-names></name></person-group><year>1996</year><article-title>A change of ploidy can modify epigenetic silencing.</article-title><source>Proc Natl Acad Sci U S A</source><volume>93</volume><fpage>7114</fpage><lpage>7119</lpage><pub-id pub-id-type="pmid">8692954</pub-id></citation></ref><ref id="pone.0003061-MittelstenScheid2"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mittelsten Scheid</surname><given-names>O</given-names></name><name><surname>Afsar</surname><given-names>K</given-names></name><name><surname>Paszkowski</surname><given-names>J</given-names></name></person-group><year>2003</year><article-title>Formation of stable epialleles and their paramutation-like interaction in tetraploid Arabidopsis thaliana.</article-title><source>Nat Genet</source><volume>34</volume><fpage>450</fpage><lpage>454</lpage><pub-id pub-id-type="pmid">12847525</pub-id></citation></ref><ref id="pone.0003061-Mette1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mette</surname><given-names>MF</given-names></name><name><surname>Aufsatz</surname><given-names>W</given-names></name><name><surname>van der Winden</surname><given-names>J</given-names></name><name><surname>Matzke</surname><given-names>MA</given-names></name><name><surname>Matzke</surname><given-names>AJ</given-names></name></person-group><year>2000</year><article-title>Transcriptional silencing and promoter methylation triggered by double-stranded RNA.</article-title><source>EMBO J</source><volume>19</volume><fpage>5194</fpage><lpage>5201</lpage><pub-id pub-id-type="pmid">11013221</pub-id></citation></ref><ref id="pone.0003061-Hammond1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hammond</surname><given-names>SM</given-names></name><name><surname>Caudy</surname><given-names>AA</given-names></name><name><surname>Hannon</surname><given-names>GJ</given-names></name></person-group><year>2001</year><article-title>Post-transcriptional gene silencing by double-stranded RNA.</article-title><source>Nat Rev Genet</source><volume>2</volume><fpage>110</fpage><lpage>119</lpage><pub-id pub-id-type="pmid">11253050</pub-id></citation></ref><ref id="pone.0003061-Hamilton1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamilton</surname><given-names>AJ</given-names></name><name><surname>Baulcombe</surname><given-names>DC</given-names></name></person-group><year>1999</year><article-title>A species of small antisense RNA in posttranscriptional gene silencing in plants.</article-title><source>Science</source><volume>286</volume><fpage>950</fpage><lpage>952</lpage><pub-id pub-id-type="pmid">10542148</pub-id></citation></ref><ref id="pone.0003061-Hamilton2"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamilton</surname><given-names>A</given-names></name><name><surname>Voinnet</surname><given-names>O</given-names></name><name><surname>Chappell</surname><given-names>L</given-names></name><name><surname>Baulcombe</surname><given-names>D</given-names></name></person-group><year>2002</year><article-title>Two classes of short interfering RNA in RNA silencing.</article-title><source>EMBO J</source><volume>21</volume><fpage>4671</fpage><lpage>4679</lpage><pub-id pub-id-type="pmid">12198169</pub-id></citation></ref><ref id="pone.0003061-Napo