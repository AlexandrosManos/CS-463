icle-title>Treatment of irritable bowel syndrome: a review of randomised controlled trials</article-title><source>Gut</source><year>2001</year><volume>48</volume><fpage>272</fpage><lpage>282</lpage><pub-id pub-id-type="pmid">11156653</pub-id><pub-id pub-id-type="doi">10.1136/gut.48.2.272</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brandt</surname><given-names>LJ</given-names></name><name><surname>Bjorkman</surname><given-names>D</given-names></name><name><surname>Fennerty</surname><given-names>MB</given-names></name><name><surname>Locke</surname><given-names>GR</given-names></name><name><surname>Olden</surname><given-names>K</given-names></name><name><surname>Peterson</surname><given-names>W</given-names></name><etal></etal></person-group><article-title>Systematic review on the management of irritable bowel syndrome in North America</article-title><source>Am J Gastroenterol</source><year>2002</year><volume>97</volume><fpage>S7</fpage><lpage>26</lpage><pub-id pub-id-type="pmid">12425586</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tack</surname><given-names>J</given-names></name><name><surname>Fried</surname><given-names>M</given-names></name><name><surname>Houghton</surname><given-names>LA</given-names></name><name><surname>Spicak</surname><given-names>J</given-names></name><name><surname>Fisher</surname><given-names>G</given-names></name></person-group><article-title>Systematic review: The efficacy of treatments for irritable bowel syndrome &#x02013; A European perspective</article-title><source>Alimentary Pharmacology and Therapeutics</source><year>2006</year><volume>24</volume><fpage>183</fpage><lpage>205</lpage><pub-id pub-id-type="pmid">16842448</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2036.2006.02938.x</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-grou