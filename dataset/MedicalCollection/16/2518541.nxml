d-type="doi">10.1111/j.1360-0443.1994.tb02784.x</pub-id></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Jankowska</surname><given-names>T</given-names></name><name><surname>Southwell</surname><given-names>M</given-names></name><name><surname>Picorne</surname><given-names>W</given-names></name></person-group><article-title>The implementation of promoting heroin chasing as a harm reduction tool</article-title><source>8th International Conference on the Reduction of Drug Related Harm</source><year>1997</year><publisher-name>Maison de la Mutualite, Paris</publisher-name></citation></ref><ref id="B13"><citation citation-type="other"><person-group person-group-type="author"><collab>Lifeline</collab></person-group><article-title>Smoking Brown </article-title><ext-link ext-link-type="uri" xlink:href="http://www.lifelinepublications.org/catalogue.php?item=D7&#x00026;PHPSESSID=951af6b8473221cdb1db0aef0e1726a5"/></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hunt</surname><given-names>N</given-names></name><name><surname>Stillwell</surname><given-names>G</given-names></name><name><surname>Taylor</surname><given-names>C</given-names></name><name><surname>Griffiths</surname><given-names>P</given-names></name></person-group><article-title> Evaluation of a brief intervention to reduce initiation into injecting</article-title><source>Drugs: Education, Prevention and Policy</source><year>1998</year><volume>5</volume><fpage>185</fpage><lpage>193</lpage></citation></ref><ref id="B15"><citation citation-type="other"><person-group person-group-type="author"><collab>Exchange Supplies</collab></person-group><article-title>Foil</article-title><ext-link ext-link-type="uri" xlink:href="http://www.exchangesupplies.org/foil"/></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Fortson</surname><given-names>R</given-names></name></person-group><source>IWG Paper E. Harm Reduction and the Law of the United Kingdom</source><year>2006</year><publisher-name>York , Joseph Rowntree Foundation</publisher-name></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De la Fuente</surname><given-names>L</given-names></name><name><surname>Bravo</surname><given-names>MJ</given-names></name><name><surname>Barrio</surname><given-names>G</given-names></name><name><surname>Parras</surname><given-names>F</given-names></name><name><surname>Suarez</surname><given-names>M</given-names></name><name><surname>Rodes</surname><given-names>M</given-names></name><name><surname>Noguer</surname><given-names>I</given-names></name></person-group><article-title>Lessons from the History of the Human Immunodeficiency Virus/Acquired Immunodeficiency Syndrome Epidemic among Spanish Drug Injectors</article-title><source>Clinical Infectious Diseases</source><year>2003</year><volume>37</volume><fpage>S410</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">14648456</pub-id><pub-id pub-id-type="doi">10.1086/377562</pub-id></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Grund</surname><given-names>JP</given-names></name><name><surname>Blanken</surname><given-names>P</given-names></name></person-group><source>From 'Chasing the Dragon' to 'Chinezen': the Diffusion of Heroin Smoking in the Netherlands</source><year>1993</year><publisher-name>Rotterdam , Addiction Research Institute (IVO)</publisher-name></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rhodes</surname><given-names>T</given-names></name><name><surname>Briggs</surname><given-names>D</given-names></name><name><surname>Kimber</surname><given-names>J</given-names></name><name><surname>Jones</surname><given-names>S</given-names></name><name><surname>Holloway</surname><given-names>G</given-names></name></person-group><article-title>Crack&#x02013;heroin speedball injection and its implications for vein care: qualitative study</article-title><source>Addiction</source><year>2007</year><volume>102</volume><fpage>1782</fpage><lpage>1790</lpage><pub-id pub-id-type="pmid">17784900</pub-id><pub-id pub-id-type="doi">10.1111/j.1360-0443.2007.01969.x</pub-id></citation></ref></ref-list></back></article>