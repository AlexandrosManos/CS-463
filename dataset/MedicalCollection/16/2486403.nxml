ce><italic>Journal of Chemical Sciences India</italic></source><year>2004</year><volume>116</volume><issue>4</issue><fpage>215</fpage><lpage>219</lpage></citation></ref><ref id="B16"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nejati</surname><given-names>K</given-names></name><name><surname>Rezvani</surname><given-names>Z</given-names></name></person-group><article-title>Syntheses, characterization and mesomorphic properties of new bis(alkoxyphenylazo)-substituted <italic>N</italic>,<italic>N</italic>&#x02032; salicylidene diiminato Ni(II), Cu(II) and VO(IV) complexes</article-title><source><italic>New Journal of Chemistry</italic></source><year>2003</year><volume>27</volume><issue>11</issue><fpage>1665</fpage><lpage>1669</lpage></citation></ref><ref id="B17"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maurya</surname><given-names>MR</given-names></name><name><surname>Khurana</surname><given-names>S</given-names></name><name><surname>Schulzke</surname><given-names>C</given-names></name><name><surname>Rehder</surname><given-names>D</given-names></name></person-group><article-title>Dioxo- and oxovanadium(V) complexes of biomimetic hydrazone <italic>ONO</italic> donor ligands: synthesis, characterisation, and reactivity</article-title><source><italic>European Journal of Inorganic Chemistry</italic></source><year>2001</year><volume>2001</volume><issue>3</issue><fpage>779</fpage><lpage>788</lpage></citation></ref><ref id="B20"><label>24</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wilkinson</surname><given-names>G</given-names></name></person-group><source><italic>Comprehensive Coordination Chemistry Vol 3: Main Group and Early Transition Elements</italic></source><year>1987</year><publisher-loc>Oxford, UK</publisher-loc><publisher-name>Pergamon Press</publisher-name></citation></ref><ref id="B25">