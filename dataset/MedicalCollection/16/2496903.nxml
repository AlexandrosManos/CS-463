ven-names>JL</given-names></name><name><surname>Gallovic</surname><given-names>B</given-names></name></person-group><article-title>Barriers to initiating depression treatment in primary care practice</article-title><source>J Gen Intern Med</source><year>2002</year><volume>17</volume><fpage>103</fpage><lpage>111</lpage><pub-id pub-id-type="pmid">11841525</pub-id><pub-id pub-id-type="doi">10.1046/j.1525-1497.2002.10128.x</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nickleson</surname><given-names>D</given-names></name></person-group><article-title>Telehealth and the evolving health care system: strategic opportunities for professional psychology</article-title><source>Prof Psychol Res Pr</source><year>1998</year><volume>29</volume><fpage>527</fpage><lpage>535</lpage><pub-id pub-id-type="doi">10.1037/0735-7028.29.6.527</pub-id></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Maheu</surname><given-names>M</given-names></name><name><surname>Whitten</surname><given-names>P</given-names></name><name><surname>Allen</surname><given-names>A</given-names></name></person-group><source>E-health, telehealth and telemedicine</source><year>2001</year><publisher-name>San Francisco, CA: Jossey-Bass</publisher-name></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><collab>FCC</collab></person-group><source>Supplemental telephone penetration report</source><year>1993</year><publisher-name>US Federal Communications Commission</publisher-name></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>VandenBos</surname><given-names>GR</given-names></name><name><surname>Williams</surname><given-names>S</given-names></name></person-group><article-title>The internet versus the telephone: what is telehealth anyway?</article-title><source>Prof Psychol Res Pr</source><year>2000</year><volume>31</volume><fpage>490</fpage><lpage>492</lpage><pub-id pub-id-type="doi">10.1037/0735-7028.31.5.490</pub-id></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><collab>Veterans Health Administration (VHA)</collab></person-group><source>Telemental health toolkit</source><year>2003</year><publisher-name>Veterans Health Administration</publisher-name></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>MA</given-names></name><name><surname>Senior</surname><given-names>C</given-names></name></person-group><article-title>The internet and clinical psychology: a general review of the implications</article-title><source>Clin Psychol Rev</source><year>2001</year><volume>21</volume><fpage>129</fpage><lpage>136</lpage><pub-id pub-id-type="pmid">11148893</pub-id><pub-id pub-id-type="doi">10.1016/S0272-7358(99)00043-4</pub-id></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Horvath</surname><given-names>AO</given-names></name><name><surname>Bedi</surname><given-names>RP</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Norcross JC</surname></name></person-group><article-title>The alliance</article-title><source>In Psychotherapy relationships that work: therapist contributions and responsiveness to patients</source><year>2002</year><publisher-name>New York: Oxford University Press</publisher-name></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wootton</surname><given-names>R</given-names></name><name><surname>Yellowlees</surname><given-names>P</given-names></name><name><surname>McLaren</surname><given-names>P</given-names></name></person-group><source>Telepsychiatry and E-Mental Health</source><ye