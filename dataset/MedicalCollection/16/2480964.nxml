e>Immunogenetics</source><year>1994</year><volume>40</volume><fpage>360</fpage><lpage>369</lpage><!--PubMed citation query: 'Immunogenetics||40|360||bib10|'--><pub-id pub-id-type="pmid">7927540</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dicken</surname><given-names>BJ</given-names></name><name><surname>Bigam</surname><given-names>DL</given-names></name><name><surname>Cass</surname><given-names>C</given-names></name><name><surname>Mackey</surname><given-names>JR</given-names></name><name><surname>Joy</surname><given-names>AA</given-names></name><name><surname>Hamilton</surname><given-names>SM</given-names></name></person-group><article-title>Gastric adenocarcinoma: review and considerations for future directions</article-title><source>Ann Surg</source><year>2005</year><volume>241</volume><fpage>27</fpage><lpage>39</lpage><!--PubMed citation query: 'Ann Surg||241|27||bib11|'--><pub-id pub-id-type="pmid">15621988</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dutoit</surname><given-names>V</given-names></name><name><surname>Rubio-Godoy</surname><given-names>V</given-names></name><name><surname>Dietrich</surname><given-names>PY</given-names></name><name><surname>Quiqueres</surname><given-names>AL</given-names></name><name><surname>Schnuriger</surname><given-names>V</given-names></name><name><surname>Rimoldi</surname><given-names>D</given-names></name><name><surname>Li&#x000e9;nard</surname><given-names>D</given-names></name><name><surname>Speiser</surname><given-names>D</given-names></name><name><surname>Guillaume</surname><given-names>P</given-names></name><name><surname>Batard</surname><given-names>P</given-names></name><name><surname>Cerottini</surname><given-names>JC</given-names></name><name><surname>Romero</surname><given-names>P</given-names></name><name><surname>Valmori</surname><given-names>D