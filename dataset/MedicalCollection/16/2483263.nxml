d="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chasnov</surname><given-names>JR</given-names></name><name><surname>So</surname><given-names>WK</given-names></name><name><surname>Chan</surname><given-names>CM</given-names></name><name><surname>Chow</surname><given-names>KL</given-names></name></person-group><article-title>The species, sex, and stage specificity of a <italic>Caenorhabditis </italic>sex pheromone</article-title><source>Proc Natl Acad Sci USA</source><year>2007</year><volume>104</volume><fpage>6730</fpage><lpage>6735</lpage><pub-id pub-id-type="pmid">17416682</pub-id><pub-id pub-id-type="doi">10.1073/pnas.0608050104</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simon</surname><given-names>JM</given-names></name><name><surname>Sternberg</surname><given-names>PW</given-names></name></person-group><article-title>Evidence of a mate-finding cue in the hermaphrodite nematode <italic>Caenorhabditis elegans</italic></article-title><source>Proc Natl Acad Sci USA</source><year>2002</year><volume>99</volume><fpage>1598</fpage><lpage>1603</lpage><pub-id pub-id-type="pmid">11818544</pub-id><pub-id pub-id-type="doi">10.1073/pnas.032225799</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garcia</surname><given-names>LR</given-names></name><name><surname>LeBoeuf</surname><given-names>B</given-names></name><name><surname>Koo</surname><given-names>P</given-names></name></person-group><article-title>Diversity in mating behavior of hermaphroditic and male-female <italic>Caenorhabditis </italic>nematodes</article-title><source>Genetics</source><year>2007</year><volume>175</volume><fpage>1761</fpage><lpage>1771</lpage><pub-id pub-id-type="pmid">17277358</pub-id><pub-id pub-id-type="doi">10.1534/genetics.106.068304</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hodgkin</surname><given-names>J</given-names></name><name><surname>Doniach</surname><given-names>T</given-names></name></person-group><article-title>Natural variation and copulatory plug formation in <italic>Caenorhabditis elegans</italic></article-title><source>Genetics</source><year>1997</year><volume>146</volume><fpage>149</fpage><lpage>164</lpage><pub-id pub-id-type="pmid">9136008</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Manoel</surname><given-names>D</given-names></name><name><surname>Carvalho</surname><given-names>S</given-names></name><name><surname>Phillips</surname><given-names>PC</given-names></name><name><surname>Teotonio</surname><given-names>H</given-names></name></person-group><article-title>Selection against males in <italic>Caenorhabditis elegans </italic>under two mutational treatments</article-title><source>Proc Biol Sci</source><year>2007</year><volume>274</volume><fpage>417</fpage><lpage>424</lpage><pub-id pub-id-type="pmid">17164206</pub-id><pub-id pub-id-type="doi">10.1098/rspb.2006.3739</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Agrawal</surname><given-names>AF</given-names></name><name><surname>Lively</surname><given-names>CM</given-names></name></person-group><article-title>Parasites and the evolution of self-fertilization</article-title><source>Evolution</source><year>2001</year><volume>55</volume><fpage>869</fpage><lpage>879</lpage><pub-id pub-id-type="pmid">11430647</pub-id><pub-id pub-id-type="doi">10.1554/0014-3820(2001)055[0869:PATEOS]2.0.CO;2</pub-id></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Fischer</surname><given-names>RA</given-names></name></person-group><source>The genetical theory of natural selection</source><year>1930</year><publisher-name>Oxford: Clarendon Press</publisher-name></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamilton</surname><given-names>WD</given-names></name><name><surname>Axelrod</surname><given-names>R</given-names></name><name><surname>Tanese</surname><given-names>R</given-names></name></person-group><article-title>Sexual reproduction as an adaptation to resist parasites (a review)</article-title><source>Proc Natl Acad Sci USA</source><year>1990</year><volume>87</volume><fpage>3566</fpage><lpage>3573</lpage><pub-id pub-id-type="pmid">2185476</pub-id><pub-id pub-id-type="doi">10.1073/pnas.87.9.3566</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kondrashov</surname><given-names>AS</given-names></name></person-group><article-title>Deleterious mutations and the evolution of sexual reproduction</article-title><source>Nature</source><year>1988</year><volume>336</volume><fpage>435</fpage><lpage>440</lpage><pub-id pub-id-type="pmid">3057385</pub-id><pub-id pub-id-type="doi">10.1038/336435a0</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Muller</surname><given-names>HJ</given-names></name></person-group><article-title>Some genetic aspects of sex</article-title><source>American Naturalist</source><year>1932</year><volume>66</volume><fpage>118</fpage><lpage>138</lpage><pub-id pub-id-type="doi">10.1086/280418</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Muller</surname><given-names>HJ</given-names></name></person-group><article-title>The relation of recombination to mutational advantage</article-title><source>Mutation Research</source><year>1964</year><volume>1</volume><fpage>2</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">14195748</pu