olspan="1" rowspan="1" align="center" valign="top">114 &#x000b1; 4</td><td colspan="1" rowspan="1" align="center" valign="top">118 &#x000b1; 5</td><td colspan="1" rowspan="1" align="char" char="." valign="top">0.2</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Diastolic blood pressure (mmHg)</td><td colspan="1" rowspan="1" align="center" valign="top">68 &#x000b1; 3</td><td colspan="1" rowspan="1" align="center" valign="top">73 &#x000b1; 3</td><td colspan="1" rowspan="1" align="char" char="." valign="top">0.1</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Heart rate (bpm)</td><td colspan="1" rowspan="1" align="center" valign="top">63 &#x000b1; 1</td><td colspan="1" rowspan="1" align="center" valign="top">60 &#x000b1; 3</td><td colspan="1" rowspan="1" align="char" char="." valign="top">0.3</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">MR spectroscopy</td><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Liver TG content (&#x00025;)</td><td colspan="1" rowspan="1" align="center" valign="top">0.77 &#x000b1; 0.09</td><td colspan="1" rowspan="1" align="center" valign="top">0.84 &#x000b1; 0.11</td><td colspan="1" rowspan="1" align="char" char="." valign="top">0.4</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Myocardial TG content (&#x00025;)</td><td colspan="1" rowspan="1" align="center" valign="top">0.31 &#x000b1; 0.04</td><td colspan="1" rowspan="1" align="center" valign="top">0.34 &#x000b1; 0.06</td><td colspan="1" rowspan="1" align="char" char="." valign="top">0.6</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">MR imaging</td><td colspan="1" rowspa