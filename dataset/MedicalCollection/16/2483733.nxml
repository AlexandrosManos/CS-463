cle-title>Profiling of normal human leg lymph proteins using the 2-D electrophoresis and SELDI-TOF mass spectrophotometry approach.</article-title><source>Lymphology</source><volume>37</volume><fpage>65</fpage><lpage>72</lpage><pub-id pub-id-type="pmid">15328759</pub-id></citation></ref><ref id="pone.0002829-Yuan1"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yuan</surname><given-names>X</given-names></name><name><surname>Russell</surname><given-names>T</given-names></name><name><surname>Wood</surname><given-names>G</given-names></name><name><surname>Desiderio</surname><given-names>DM</given-names></name></person-group><year>2002</year><article-title>Analysis of the human lumbar cerebrospinal fluid proteome.</article-title><source>Electrophoresis</source><volume>23</volume><fpage>1185</fpage><lpage>1196</lpage><pub-id pub-id-type="pmid">11981868</pub-id></citation></ref><ref id="pone.0002829-Ahn1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ahn</surname><given-names>S</given-names></name><name><surname>Simspon</surname><given-names>R</given-names></name></person-group><year>2007</year><article-title>Body fluid proteomics: Prospects for biomarker discovery.</article-title><source>Proteomics Clin Appl</source><volume>1</volume><fpage>1004</fpage><lpage>1015</lpage></citation></ref><ref id="pone.0002829-Reiber1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reiber</surname><given-names>H</given-names></name></person-group><year>2003</year><article-title>Proteins in cerebrospinal fluid and blood: barriers, CSF flow rate and source-related dynamics.</article-title><source>Restor Neurol Neurosci</source><volume>21</volume><fpage>79</fpage><lpage>96</lpage><pub-id pub-id-type="pmid">14530572</pub-id></citation></ref><ref id="pone.0002829-Reiber2"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reiber</surname><given-names>H</given-names></name></person-group><year>2001</year><article-title>Dynamics of brain-derived proteins in cerebrospinal fluid.</article-title><source>Clin Chim Acta</source><volume>310</volume><fpage>173</fpage><lpage>186</lpage><pub-id pub-id-type="pmid">11498083</pub-id></citation></ref><ref id="pone.0002829-Selkoe1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Selkoe</surname><given-names>DJ</given-names></name></person-group><year>1991</year><article-title>The molecular pathology of Alzheimer's disease.</article-title><source>Neuron</source><volume>6</volume><fpage>487</fpage><lpage>498</lpage><pub-id pub-id-type="pmid">1673054</pub-id></citation></ref><ref id="pone.0002829-Biere1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Biere</surname><given-names>AL</given-names></name><name><surname>Ostaszewski</surname><given-names>B</given-names></name><name><surname>Stimson</surname><given-names>ER</given-names></name><name><surname>Hyman</surname><given-names>BT</given-names></name><name><surname>Maggio</surname><given-names>JE</given-names></name><etal/></person-group><year>1996</year><article-title>Amyloid beta-peptide is transported on lipoproteins and albumin in human plasma.</article-title><source>J Biol Chem</source><volume>271</volume><fpage>32916</fpage><lpage>32922</lpage><pub-id pub-id-type="pmid">8955133</pub-id></citation></ref><ref id="pone.0002829-Bohrmann1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bohrmann</surname><given-names>B</given-names></name><name><surname>Tjernberg</surname><given-names>L</given-names></name><name><surname>Kuner</surname><given-names>P</given-names></name><name><surname>Poli</surname><given-names>S</given-names></name><name><surname>Levet-Trafit</surnam