ame><name><surname>Hirsch</surname><given-names>RF</given-names></name></person-group><article-title>Refining hollow obturator base using light-activated resin</article-title><source>J Prosthet Dent</source><year>1997</year><volume>78</volume><fpage>327</fpage><lpage>329</lpage><pub-id pub-id-type="pmid">9297653</pub-id><pub-id pub-id-type="doi">10.1016/S0022-3913(97)70035-0</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mc Andrew</surname><given-names>KS</given-names></name><name><surname>Rothenberger</surname><given-names>S</given-names></name><name><surname>Minsley</surname><given-names>GE</given-names></name></person-group><article-title>An innovative investment method for the fabrication of closed hollow obturator prosthesis</article-title><source>J Prosthet Dent</source><year>1998</year><volume>80</volume><fpage>129</fpage><lpage>132</lpage><pub-id pub-id-type="pmid">9656185</pub-id><pub-id pub-id-type="doi">10.1016/S0022-3913(98)70098-8</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Asher</surname><given-names>ES</given-names></name><name><surname>Psillakis</surname><given-names>J</given-names></name><name><surname>Piro</surname><given-names>JD</given-names></name><name><surname>Wright</surname><given-names>RF</given-names></name></person-group><article-title>Technique for quick conversion of an obturator into a hollow bulb</article-title><source>J Prosthet Dent</source><year>2001</year><volume>85</volume><fpage>419</fpage><lpage>420</lpage><pub-id pub-id-type="pmid">11319544</pub-id><pub-id pub-id-type="doi">10.1067/mpr.2001.114276</pub-id></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Anusavice</surname><given-names>KJ</given-names></name></person-group><source>Philips Science of Dental Materials</source><year>1996</year><edition>10</edition><publisher-name>WB Saunders</publisher-name><fpage>254</fpage><lpage>262</lpage></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Craig</surname><given-names>RG</given-names></name><name><surname>Powers</surname><given-names>JM</given-names></name></person-group><source>Restorative Dental Materials</source><year>2002</year><edition>11</edition><publisher-name>St. Louis; Mosby</publisher-name><fpage>636</fpage><lpage>682</lpage></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Barrie</surname><given-names>JA</given-names></name></person-group><article-title>Water in polymers</article-title><source>Diffusion in Polymers</source><year>1968</year><publisher-name>London:Academic Press</publisher-name><fpage>259</fpage><lpage>31</lpage></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Habib</surname><given-names>BH</given-names></name><name><surname>Driscoll</surname><given-names>CF</given-names></name></person-group><article-title>Fabrication of a closed hollow obturator</article-title><source>J Prosthet Dent</source><year>2004</year><volume>91</volume><fpage>383</fpage><lpage>385</lpage><pub-id pub-id-type="pmid">15116041</pub-id><pub-id pub-id-type="doi">10.1016/j.prosdent.2004.01.020</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>King</surname><given-names>GE</given-names></name><name><surname>Martin</surname><given-names>JW</given-names></name></person-group><article-title>Complete dentures for the obturator patient</article-title><source>Dent Clin North Am</source><year>1996</year><volume>40</volume><fpage>217</fpage><lpage>237</lpage><pub-id pub-id-type="pmid">8635623</pub-id></citation></ref></ref-list></back></article>