></name><name><surname>Diomanda</surname><given-names>M</given-names></name><name><surname>Honde</surname><given-names>M</given-names></name><name><surname>Beaumel</surname><given-names>A</given-names></name><name><surname>Kestens</surname><given-names>L</given-names></name><name><surname>Kadio</surname><given-names>A</given-names></name></person-group><article-title>Contribution of tuberculosis to slim disease in Africa</article-title><source>BMJ</source><year>1994</year><volume>308</volume><fpage>1531</fpage><lpage>1533</lpage><pub-id pub-id-type="pmid">7912597</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eledrisi</surname><given-names>MS</given-names></name><name><surname>Verghese</surname><given-names>AC</given-names></name></person-group><article-title>Adrenal insufficiency in HIV infection: a review and recommendations</article-title><source>Am J Med Sci</source><year>2001</year><volume>321</volume><fpage>137</fpage><lpage>144</lpage><pub-id pub-id-type="pmid">11217816</pub-id><pub-id pub-id-type="doi">10.1097/00000441-200102000-00005</pub-id></citation></ref></ref-list></back></article>