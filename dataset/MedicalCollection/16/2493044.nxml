rson-group-type="author"><name><surname>Parnell</surname><given-names>TJ</given-names></name><name><surname>Kuhn</surname><given-names>EJ</given-names></name><name><surname>Gilmore</surname><given-names>BL</given-names></name><name><surname>Helou</surname><given-names>C</given-names></name><name><surname>Wold</surname><given-names>MS</given-names></name><etal/></person-group><year>2006</year><article-title>Identification of genomic sites that bind the Drosophila suppressor of Hairy-wing insulator protein.</article-title><source>Mol Cell Biol</source><volume>26</volume><fpage>5983</fpage><lpage>5993</lpage><pub-id pub-id-type="pmid">16880510</pub-id></citation></ref><ref id="pgen.1000159-Golovnin1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Golovnin</surname><given-names>A</given-names></name><name><surname>Birukova</surname><given-names>I</given-names></name><name><surname>Romanova</surname><given-names>O</given-names></name><name><surname>Silicheva</surname><given-names>M</given-names></name><name><surname>Parshikov</surname><given-names>A</given-names></name><etal/></person-group><year>2003</year><article-title>An endogenous Su(Hw) insulator separates the yellow gene from the Achaete-scute gene complex in Drosophila.</article-title><source>Development</source><volume>130</volume><fpage>3249</fpage><lpage>3258</lpage><pub-id pub-id-type="pmid">12783795</pub-id></citation></ref><ref id="pgen.1000159-Parnell2"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parnell</surname><given-names>TJ</given-names></name><name><surname>Viering</surname><given-names>MM</given-names></name><name><surname>Skjesol</surname><given-names>A</given-names></name><name><surname>Helou</surname><given-names>C</given-names></name><name><surname>Kuhn</surname><given-names>EJ</given-names></name><etal/></person-group><year>2003</year><article-title>An endogenous suppressor