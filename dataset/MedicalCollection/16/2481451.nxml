-id-type="pmid">18434901</pub-id><pub-id pub-id-type="doi">10.1097/CCM.0b013e31816f49ac</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ball</surname><given-names>J</given-names></name></person-group><article-title>Recently published papers: the Jekyll and Hyde of oxygen, neuromuscular blockade and good vibrations?</article-title><source>Crit Care</source><year>2007</year><volume>11</volume><fpage>108</fpage><pub-id pub-id-type="pmid">17300737</pub-id><pub-id pub-id-type="doi">10.1186/cc5160</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barth</surname><given-names>E</given-names></name><name><surname>Bassi</surname><given-names>G</given-names></name><name><surname>Maybauer</surname><given-names>DM</given-names></name><name><surname>Simon</surname><given-names>F</given-names></name><name><surname>Groger</surname><given-names>M</given-names></name><name><surname>Oter</surname><given-names>S</given-names></name><name><surname>Speit</surname><given-names>G</given-names></name><name><surname>Nguyen</surname><given-names>CD</given-names></name><name><surname>Hasel</surname><given-names>C</given-names></name><name><surname>Moller</surname><given-names>P</given-names></name><name><surname>Wachter</surname><given-names>U</given-names></name><name><surname>Vogt</surname><given-names>JA</given-names></name><name><surname>Matejovic</surname><given-names>M</given-names></name><name><surname>Radermacher</surname><given-names>P</given-names></name><name><surname>Calzia</surname><given-names>E</given-names></name></person-group><article-title>Effects of ventilation with 100% oxygen during early hyperdynamic porcine fecal peritonitis</article-title><source>Crit Care Med</source><year>2008</year><volume>36</volume><fpage>495</fpage><lpage>503</lpage><pub-id pub-id-type="pmid">18091553</pub-id></citation></ref></ref-list></ba