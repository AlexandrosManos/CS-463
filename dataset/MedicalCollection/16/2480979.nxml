age><lpage>251</lpage><!--PubMed citation query: 'Otolaryngol Head Neck Surg||89|244||bib6|'--><pub-id pub-id-type="pmid">6787519</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dominguez</surname><given-names>G</given-names></name><name><surname>Carballido</surname><given-names>J</given-names></name><name><surname>Silva</surname><given-names>J</given-names></name><name><surname>Silva</surname><given-names>JM</given-names></name><name><surname>Garcia</surname><given-names>JM</given-names></name><name><surname>Menendez</surname><given-names>J</given-names></name><name><surname>Provencio</surname><given-names>M</given-names></name><name><surname>Espana</surname><given-names>P</given-names></name><name><surname>Bonilla</surname><given-names>F</given-names></name></person-group><article-title>p14ARF promoter hypermethylation in plasma DNA as an indicator of disease recurrence in bladder cancer patients</article-title><source>Clin Cancer Res</source><year>2002</year><volume>8</volume><fpage>980</fpage><lpage>985</lpage><!--PubMed citation query: 'Clin Cancer Res||8|980||bib7|'--><pub-id pub-id-type="pmid">11948103</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eads</surname><given-names>CA</given-names></name><name><surname>Lord</surname><given-names>RV</given-names></name><name><surname>Wickramasinghe</surname><given-names>K</given-names></name><name><surname>Long</surname><given-names>TI</given-names></name><name><surname>Kurumboor</surname><given-names>SK</given-names></name><name><surname>Bernstein</surname><given-names>L</given-names></name><name><surname>Peters</surname><given-names>JH</given-names></name><name><surname>DeMeester</surname><given-names>SR</given-names></name><name><surname>DeMeester</surname><given-names>TR</given-names></name><name><surname>Skinner</surname><given-names>KA</given-names>