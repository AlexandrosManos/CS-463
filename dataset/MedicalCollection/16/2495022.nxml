e><surname>Crimson</surname><given-names>WEL</given-names></name><name><surname>Kikinis</surname><given-names>R</given-names></name><name><surname>Jolesz</surname><given-names>FA</given-names></name></person-group><article-title>Adaptive segmentation of MRI data</article-title><source><italic>IEEE Transactions on Medical Imaging</italic></source><year>1996</year><volume>15</volume><issue>4</issue><fpage>429</fpage><lpage>442</lpage><pub-id pub-id-type="pmid">18215925</pub-id></citation></ref><ref id="B21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shan</surname><given-names>ZY</given-names></name><name><surname>Yue</surname><given-names>GH</given-names></name><name><surname>Liu</surname><given-names>JZ</given-names></name></person-group><article-title>Automated histogram-based brain segmentation in T1-weighted three-dimensional magnetic resonance head images</article-title><source><italic>NeuroImage</italic></source><year>2002</year><volume>17</volume><issue>3</issue><fpage>1587</fpage><lpage>1598</lpage><pub-id pub-id-type="pmid">12414297</pub-id></citation></ref><ref id="B22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cocosco</surname><given-names>CA</given-names></name><name><surname>Zijdenbos</surname><given-names>AP</given-names></name><name><surname>Evans</surname><given-names>AC</given-names></name></person-group><article-title>A fully automatic and robust brain MRI tissue classification method</article-title><source><italic>Medical Image Analysis</italic></source><year>2003</year><volume>7</volume><issue>4</issue><fpage>513</fpage><lpage>527</lpage><pub-id pub-id-type="pmid">14561555</pub-id></citation></ref><ref id="B23"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grabowski</surname><given-names>TJ</given-names></name><name><surname>Frank</surname><given-names>RJ</given