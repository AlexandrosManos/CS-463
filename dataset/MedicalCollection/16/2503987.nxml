-title><source>Aust J Rural Health</source><year>2002</year><volume>10</volume><fpage>2</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">11952516</pub-id><pub-id pub-id-type="doi">10.1046/j.1440-1584.2002.00435.x</pub-id></citation></ref><ref id="B8"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Pope</surname><given-names>C</given-names></name><name><surname>Mays</surname><given-names>N</given-names></name><name><surname>Popay</surname><given-names>J</given-names></name></person-group><source>Synthesizing Qualitative and Quantitative Health Research: A Guide to Methods</source><year>2007</year><publisher-name>McGraw-Hill, Berks, UK</publisher-name></citation></ref><ref id="B9"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Wakerman</surname><given-names>J</given-names></name><name><surname>Humphreys</surname><given-names>J</given-names></name><name><surname>Wells</surname><given-names>R</given-names></name><name><surname>Kuipers</surname><given-names>P</given-names></name><name><surname>Entwistle</surname><given-names>P</given-names></name><name><surname>Jones</surname><given-names>J</given-names></name></person-group><article-title>A systematic review of primary health care delivery models in rural and remote Australia 1993&#x02013;2006</article-title><ext-link ext-link-type="uri" xlink:href="http://www.anu.edu.au/aphcri/Domain/RuralRemote/index.php"/></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Petticrew</surname><given-names>M</given-names></name></person-group><article-title>Systematic reviews from astronomy to zoology: myths and misconceptions</article-title><source>BMJ</source><year>2001</year><volume>322</volume><fpage>98</fpage><lpage>101</lpage><pub-id pub-id-type="pmid">11154628</pub-id><pub-id pub-id-type="doi">10.1136/bmj.322.7278.98</pub-id></citation></ref><ref id="B11"><citation citation-type="