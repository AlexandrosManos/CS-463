><article-title>Parental and neonatal risk factors for cryptorchidism.</article-title><source>Med Sci Monit</source><volume>11</volume><fpage>CR274</fpage><lpage>CR283</lpage><pub-id pub-id-type="pmid">15917718</pub-id></citation></ref><ref id="pone.0003051-Davies1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Davies</surname><given-names>TW</given-names></name><name><surname>Williams</surname><given-names>DRR</given-names></name><name><surname>Whitaker</surname><given-names>RH</given-names></name></person-group><year>1986</year><article-title>Risk factors for undescended testis.</article-title><source>Int J Epidemiol</source><volume>15</volume><fpage>197</fpage><lpage>201</lpage><pub-id pub-id-type="pmid">2873109</pub-id></citation></ref><ref id="pone.0003051-McBride1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McBride</surname><given-names>ML</given-names></name><name><surname>Van den Steen</surname><given-names>N</given-names></name><name><surname>Lamb</surname><given-names>CW</given-names></name><name><surname>Gallagher</surname><given-names>RP</given-names></name></person-group><year>1991</year><article-title>Maternal and gestational factors in cryptorchidism.</article-title><source>Int J Epidemiol</source><volume>20</volume><fpage>964</fpage><lpage>970</lpage><pub-id pub-id-type="pmid">1686874</pub-id></citation></ref><ref id="pone.0003051-Mller1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>M&#x000f8;ller</surname><given-names>H</given-names></name><name><surname>Skakkeb&#x000e6;k</surname><given-names>NE</given-names></name></person-group><year>1997</year><article-title>Testicular cancer and cryptorchidism in relation to prenatal factors: case-control studies in Denmark.</article-title><source>Cancer Causes Contr</source><volume>8</volume><fpage>904</fpage><lpage>912</lpage></citation></ref><ref id="pone.0003051-Toppari2"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Toppari</surname><given-names>J</given-names></name><name><surname>Kaleva</surname><given-names>M</given-names></name><name><surname>Virtanen</surname><given-names>HE</given-names></name></person-group><year>2001</year><article-title>Trends in the incidence of cryptorchidism and hypospadias, and methodological limitations of registry-based data.</article-title><source>Hum Reprod Update</source><volume>7</volume><fpage>282</fpage><lpage>286</lpage><pub-id pub-id-type="pmid">11392374</pub-id></citation></ref><ref id="pone.0003051-Damgaard1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Damgaard</surname><given-names>IN</given-names></name><name><surname>Jensen</surname><given-names>TK</given-names></name><name><surname>Petersen</surname><given-names>JH</given-names></name><name><surname>Skakkeb&#x000e6;k</surname><given-names>NE</given-names></name><etal/></person-group><collab>The Nordic Cryptorchidism Study Group</collab><year>2007</year><article-title>Cryptorchidism and maternal alcohol consumption during pregnancy.</article-title><source>Environ Health Perspect</source><volume>115</volume><fpage>272</fpage><lpage>277</lpage><pub-id pub-id-type="pmid">17384777</pub-id></citation></ref><ref id="pone.0003051-Albertsen1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Albertsen</surname><given-names>K</given-names></name><name><surname>Andersen</surname><given-names>AM</given-names></name><name><surname>Olsen</surname><given-names>J</given-names></name><name><surname>Gr&#x000f8;nb&#x000e6;k</surname><given-names>M</given-names></name></person-group><year>2004</year><article-title>Alcohol consumption during pregnancy and the risk of preterm delivery.</article-title><source>Am J Epidemiol</source><