" rowspan="1" colspan="1">2827281 to 2827631</td><td align="left" rowspan="1" colspan="1">f</td><td align="left" rowspan="1" colspan="1">0.0</td><td align="left" rowspan="1" colspan="1">0.0</td><td align="left" rowspan="1" colspan="1">0.0</td><td align="left" rowspan="1" colspan="1">0.0</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>prl23</italic></td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">3120779 to 3120982</td><td align="left" rowspan="1" colspan="1">f</td><td align="left" rowspan="1" colspan="1">48.7</td><td align="left" rowspan="1" colspan="1">32.1</td><td align="left" rowspan="1" colspan="1">48.7</td><td align="left" rowspan="1" colspan="1">14.3</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>prl04</italic></td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">3295176 to 3295428</td><td align="left" rowspan="1" colspan="1">r</td><td align="left" rowspan="1" colspan="1">136.5</td><td align="left" rowspan="1" colspan="1">82.4</td><td align="left" rowspan="1" colspan="1">50.3</td><td align="left" rowspan="1" colspan="1">82.4</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>prl36</italic></td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">3313372 to 3313800</td><td align="left" rowspan="1" colspan="1">f</td><td align="left" rowspan="1" colspan="1">154.5</td><td align="left" rowspan="1" colspan="1">64.2</td><td align="left" rowspan="1" colspan="1">68.3</td><td align="left" rowspan="1" colspan="1">64.2</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>prl20</italic></td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">3934357 to 3934809</td><td align="left" rowspan="1" colspan="1">r</td><td align="left" rowspan="1" colspan="1">70.4</td><td align="left" rowspan="1" colspan="1">3.2</td><td align="left" rowspan="1" colspan="1">0.0</td><td align="left" r