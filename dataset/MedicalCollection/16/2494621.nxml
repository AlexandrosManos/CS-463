id="r12"><label>12</label><citation citation-type="journal">Goel MS, McCarthy EP, Phillips RS, Wee CC: Obesity among US immigrant subgroups by duration of residence. <source>JAMA</source> <volume>292</volume>:<fpage>2860</fpage>&#x02013;2867, <year>2004</year><pub-id pub-id-type="pmid">15598917</pub-id></citation></ref><ref id="r13"><label>13</label><citation citation-type="journal">Lauderdale DS, Rathouz PJ: Body mass index in a US national sample of Asian Americans: effects of nativity, years since immigration and socioeconomic status. <source>Int J Obes Relat Metab Disord</source> <volume>24</volume>:<fpage>1188</fpage>&#x02013;1194, <year>2000</year><pub-id pub-id-type="pmid">11033989</pub-id></citation></ref><ref id="r14"><label>14</label><citation citation-type="journal">Bild D, Bluemke D, Burke G, Detrano R, Diez Roux A, Folsom A, Greenland P, Jacobs D, Kronma R, Liu L, Clark Nelson J, O'Leary D, Saad MF, Shea S, Szklo M, Tracy RP: The Multi-Ethnic Study of Atherosclerosis (MESA): objectives and design. <source>Am J Epidemiol</source> <volume>156</volume>:<fpage>871</fpage>&#x02013;881, <year>2002</year><pub-id pub-id-type="pmid">12397006</pub-id></citation></ref><ref id="r15"><label>15</label><citation citation-type="journal">Report of the expert committee on the diagnosis and classification of diabetes mellitus. <source>Diabetes Care</source> <volume>26</volume> (Suppl. 1):<fpage>S5</fpage>&#x02013;S20, <year>2003</year><pub-id pub-id-type="pmid">12502614</pub-id></citation></ref><ref id="r16"><label>16</label><citation citation-type="journal">Fung TT, Hu FB, Yu J, Chu NF, Spiegelman D, Tofler GH, Willett WC, Rimm EB: Leisure-time physical activity, television watching, and plasma biomarkers of obesity and cardiovascular disease risk. <source>Am J Epidemiol</source> <volume>152</volume>:<fpage>1171</fpage>&#x02013;1178, <year>2000</year><pub-id pub-id-type="pmid">11130623</pub-id></citation></ref><ref id="r17"><label>17</label><citation citation-type="journ