<surname>Maeda</surname><given-names>S</given-names></name><name><surname>Omata</surname><given-names>M</given-names></name><name><surname>Suzuki</surname><given-names>T</given-names></name><name><surname>Sasakawa</surname><given-names>C</given-names></name></person-group><article-title><italic>Helicobacter pylori</italic> CagA protein can be tyrosine phosphorylated in gastric epithelial cells</article-title><source>J Exp Med</source><year>2000</year><volume>191</volume><fpage>593</fpage><lpage>602</lpage><pub-id pub-id-type="pmid">10684851</pub-id><pub-id pub-id-type="doi">10.1084/jem.191.4.593</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ridley</surname><given-names>AJ</given-names></name><name><surname>Schwartz</surname><given-names>MA</given-names></name><name><surname>Burridge</surname><given-names>K</given-names></name><name><surname>Firtel</surname><given-names>RA</given-names></name><name><surname>Ginsberg</surname><given-names>MH</given-names></name><name><surname>Borisy</surname><given-names>G</given-names></name><name><surname>Parsons</surname><given-names>JT</given-names></name><name><surname>Horwitz</surname><given-names>AR</given-names></name></person-group><article-title>Cell migration: integrating signals from front to back</article-title><source>Science</source><year>2003</year><volume>302</volume><fpage>1704</fpage><lpage>1709</lpage><pub-id pub-id-type="pmid">14657486</pub-id><pub-id pub-id-type="doi">10.1126/science.1092053</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Broussard</surname><given-names>JA</given-names></name><name><surname>Webb</surname><given-names>DJ</given-names></name><name><surname>Kaverina</surname><given-names>I</given-names></name></person-group><article-title>Asymmetric focal adhesion disassembly in motile cells</article-title><source>Curr Opin Cell Biol</source><year>2008</year><volume>20</volume><fpage>85</fpage><lpage>90</lpage><pub-id pub-id-type="pmid">18083360</pub-id><pub-id pub-id-type="doi">10.1016/j.ceb.2007.10.009</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boyer</surname><given-names>B</given-names></name><name><surname>Valles</surname><given-names>AM</given-names></name><name><surname>Edme</surname><given-names>N</given-names></name></person-group><article-title>Induction and regulation of epithelial-mesenchymal transitions</article-title><source>Biochem Pharmacol</source><year>2000</year><volume>60</volume><fpage>1091</fpage><lpage>1099</lpage><pub-id pub-id-type="pmid">11007946</pub-id><pub-id pub-id-type="doi">10.1016/S0006-2952(00)00427-5</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lo</surname><given-names>SH</given-names></name></person-group><article-title>Focal adhesions: what's new inside</article-title><source>Dev Biol</source><year>2006</year><volume>294</volume><fpage>280</fpage><lpage>291</lpage><pub-id pub-id-type="pmid">16650401</pub-id><pub-id pub-id-type="doi">10.1016/j.ydbio.2006.03.029</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hynes</surname><given-names>RO</given-names></name></person-group><article-title>Integrins: bidirectional, allosteric signaling machines</article-title><source>Cell</source><year>2002</year><volume>110</volume><fpage>673</fpage><lpage>687</lpage><pub-id pub-id-type="pmid">12297042</pub-id><pub-id pub-id-type="doi">10.1016/S0092-8674(02)00971-6</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lock</surname><given-names>JG</given-names></name><name><surname>Wehrle-Haller</surname><given-names>B</given-names></name><name><surname>Stromblad