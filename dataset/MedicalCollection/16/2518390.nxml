"><name><surname>Basun</surname><given-names>H</given-names></name><name><surname>Nilsberth</surname><given-names>C</given-names></name><name><surname>Eckman</surname><given-names>C</given-names></name><etal/></person-group><article-title>Plasma levels of Abeta42 and Abeta40 in Alzheimer patients during treatment with the acetylcholinesterase inhibitor tacrine</article-title><source>Dement Geriatr Cogn Disord</source><year>2002</year><volume>14</volume><fpage>156</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">12218259</pub-id></citation></ref><ref id="b17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Beavo</surname><given-names>JA</given-names></name><name><surname>Conti</surname><given-names>M</given-names></name><name><surname>Heaslip</surname><given-names>RJ</given-names></name></person-group><article-title>Multiple cyclic nucleotide phosphodiesterases</article-title><source>Mol Pharmacol</source><year>1994</year><volume>46</volume><fpage>399</fpage><lpage>405</lpage><pub-id pub-id-type="pmid">7935318</pub-id></citation></ref><ref id="b18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Beavo</surname><given-names>JA</given-names></name><name><surname>Hardman</surname><given-names>JG</given-names></name><name><surname>Sutherland</surname><given-names>EW</given-names></name></person-group><article-title>Hydrolysis of cyclic guanosine and adenosine 3&#x02019;,5&#x02019;-monophosphates by rat and bovine tissues</article-title><source>J Biol Chem</source><year>1970</year><volume>245</volume><fpage>5649</fpage><lpage>55</lpage><pub-id pub-id-type="pmid">4319563</pub-id></citation></ref><ref id="b19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Beavo</surname><given-names>JA</given-names></name></person-group><article-title>Cyclic nucleotide phosphodiesterases: functional implications of multiple isoforms</article-title><source>Physiol