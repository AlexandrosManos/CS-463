pone.0003056-Romero1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Romero</surname><given-names>R</given-names></name><name><surname>Gomez</surname><given-names>R</given-names></name><name><surname>Chaiworapongsa</surname><given-names>T</given-names></name><name><surname>Conoscenti</surname><given-names>G</given-names></name><name><surname>Kim</surname><given-names>JC</given-names></name><etal/></person-group><year>2001</year><article-title>The role of infection in preterm labour and delivery.</article-title><source>Paediatr Perinat Epidemiol</source><volume>15</volume><issue>Suppl 2</issue><fpage>41</fpage><lpage>56</lpage><pub-id pub-id-type="pmid">11520399</pub-id></citation></ref><ref id="pone.0003056-Watts1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Watts</surname><given-names>DH</given-names></name><name><surname>Krohn</surname><given-names>MA</given-names></name><name><surname>Hillier</surname><given-names>SL</given-names></name><name><surname>Eschenbach</surname><given-names>DA</given-names></name></person-group><year>1992</year><article-title>The association of occult amniotic fluid infection with gestational age and neonatal outcome among women in preterm labor.</article-title><source>Obstet Gynecol</source><volume>79</volume><fpage>351</fpage><lpage>357</lpage><pub-id pub-id-type="pmid">1738513</pub-id></citation></ref><ref id="pone.0003056-Yoon1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yoon</surname><given-names>BH</given-names></name><name><surname>Romero</surname><given-names>R</given-names></name><name><surname>Kim</surname><given-names>M</given-names></name><name><surname>Kim</surname><given-names>EC</given-names></name><name><surname>Kim</surname><given-names>T</given-names></name><etal/></person-group><year>2000</year><article-title>Clinical implications of de