/name><name><surname>Santos</surname><given-names>MM</given-names></name><name><surname>Philips</surname><given-names>DP</given-names></name><name><surname>Bernard</surname><given-names>DJ</given-names></name></person-group><article-title>Acute regulation of murine follicle-stimulating hormone &#x003b2; subunit transcription by activin A</article-title><source>J Mol Endocrinol</source><year>2006</year><volume>36</volume><fpage>210</fpage><lpage>220</lpage></citation></ref><ref id="DEN216C15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lamminen</surname><given-names>T</given-names></name><name><surname>Jokinen</surname><given-names>P</given-names></name><name><surname>Jiang</surname><given-names>M</given-names></name><name><surname>Pakarinen</surname><given-names>P</given-names></name><name><surname>Simonsen</surname><given-names>H</given-names></name><name><surname>Huhtaniemi</surname><given-names>I</given-names></name></person-group><article-title>Human FSH{beta} subunit gene is highly conserved</article-title><source>Mol Hum Reprod</source><year>2005</year><volume>11</volume><fpage>601</fpage><lpage>605</lpage><pub-id pub-id-type="pmid">16100240</pub-id></citation></ref><ref id="DEN216C16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marshall</surname><given-names>GR</given-names></name><name><surname>Plant</surname><given-names>TM</given-names></name></person-group><article-title>Puberty occurring either spontaneously or induced precociously in rhesus monkey (<italic>Macaca mulatta</italic>) is associated with a marked proliferation of Sertoli cells</article-title><source>Biol Reprod</source><year>1996</year><volume>54</volume><fpage>1192</fpage><lpage>1199</lpage><pub-id pub-id-type="pmid">8724345</pub-id></citation></ref><ref id="DEN216C17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McGee</surname><given-names>EA</given-names