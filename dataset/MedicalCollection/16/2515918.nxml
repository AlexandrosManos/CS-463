p><article-title>A mutation in a case of early onset narcolepsy and a generalized absence of hypocretin peptides in human narcoleptic brains</article-title><source>Nat Med</source><year>2000</year><volume>6</volume><fpage>991</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">10973318</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pollak</surname><given-names>CP</given-names></name><name><surname>Green</surname><given-names>J</given-names></name></person-group><article-title>Eating and its relationships with subjective alertness and sleep in narcoleptic subjects living without temporal cues</article-title><source>Sleep</source><year>1990</year><volume>13</volume><fpage>467</fpage><lpage>78</lpage><pub-id pub-id-type="pmid">2281246</pub-id></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pijl</surname><given-names>H</given-names></name><name><surname>Meinders</surname><given-names>AE</given-names></name></person-group><article-title>Brain serotonin and food selection; history and current perceptions</article-title><source>J Serotonin Res</source><year>1994</year><volume>1</volume><fpage>21</fpage><lpage>45</lpage></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schenck</surname><given-names>CH</given-names></name><name><surname>Hurwitz</surname><given-names>TD</given-names></name><name><surname>Bundlie</surname><given-names>SR</given-names></name><etal/></person-group><article-title>Sleep-related eating disorders: polysomnographic correlates of a heterogeneous syndrome distinct from daytime eating disorders</article-title><source>Sleep</source><year>1991</year><volume>14</volume><fpage>419</fpage><lpage>31</lpage><pub-id pub-id-type="pmid">1759095</pub-id></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schenck</surname><given-names>CH</given-names></name><name><surname>Hurwitz</surname><given-names>TD</given-names></name><name><surname>O&#x02019;Connor</surname><given-names>KA</given-names></name><etal/></person-group><article-title>Additional categories of sleep-related eating disorders and the current status of treatment</article-title><source>Sleep</source><year>1993</year><volume>16</volume><fpage>457</fpage><lpage>66</lpage><pub-id pub-id-type="pmid">8104356</pub-id></citation></ref><ref id="b25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schuld</surname><given-names>A</given-names></name><name><surname>Blum</surname><given-names>WF</given-names></name><name><surname>Uhr</surname><given-names>M</given-names></name><etal/></person-group><article-title>Reduced leptin levels in human narcolepsy</article-title><source>Neuroendocrinology</source><year>2000</year><volume>72</volume><fpage>195</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">11070422</pub-id></citation></ref><ref id="b26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schuld</surname><given-names>A</given-names></name><name><surname>Hebebrand</surname><given-names>J</given-names></name><name><surname>Geller</surname><given-names>F</given-names></name><etal/></person-group><article-title>Increased body-mass index in patients with narcolepsy</article-title><source>Lancet</source><year>2000</year><volume>355</volume><fpage>1274</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">10770327</pub-id></citation></ref><ref id="b27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Striegel-Moore</surname><given-names>RH</given-names></name><name><surname>Franko</surname><given-names>DL</given-names></name><name><surname>Thompson</surname><given-names>D</given-names></name><etal/></person-group><article-title>Night eating: Prevalence and demographic correlates</article-title><source>Obesity (Silver Spring)</source><year>2006</year><volume>14</volume><fpage>139</fpage><lpage>47</lpage><pub-id pub-id-type="pmid">16493132</pub-id></citation></ref></ref-list></back></article>