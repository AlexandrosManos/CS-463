d">11049958</pub-id></citation></ref><ref id="pone.0002927-Stromgren1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stromgren</surname><given-names>E</given-names></name><name><surname>Dalby</surname><given-names>A</given-names></name><name><surname>Dalby</surname><given-names>MA</given-names></name><name><surname>Ranheim</surname><given-names>B</given-names></name></person-group><year>1970</year><article-title>Cataract, deafness, cerebellar ataxia, psychosis and dementia&#x02013;a new syndrome.</article-title><source>Acta Neurol Scand</source><volume>46</volume><issue>Suppl 43</issue><fpage>261&#x0002b;</fpage><pub-id pub-id-type="pmid">5457846</pub-id></citation></ref><ref id="pone.0002927-Rostagno1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rostagno</surname><given-names>A</given-names></name><name><surname>Tomidokoro</surname><given-names>Y</given-names></name><name><surname>Lashley</surname><given-names>T</given-names></name><name><surname>Ng</surname><given-names>D</given-names></name><name><surname>Plant</surname><given-names>G</given-names></name><etal/></person-group><year>2005</year><article-title>Chromosome 13 dementias.</article-title><source>Cell Mol Life Sci</source><volume>62</volume><fpage>1814</fpage><lpage>1825</lpage><pub-id pub-id-type="pmid">15968464</pub-id></citation></ref><ref id="pone.0002927-Goldstein1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldstein</surname><given-names>LE</given-names></name><name><surname>Muffat</surname><given-names>JA</given-names></name><name><surname>Cherny</surname><given-names>RA</given-names></name><name><surname>Moir</surname><given-names>RD</given-names></name><name><surname>Ericsson</surname><given-names>MH</given-names></name><etal/></person-group><year>2003</year><article-title>Cytosolic beta-amyloid deposition and supranuclear cataracts in lenses from people with Alzheimer's disease.</article-title><source>Lancet</source><volume>361</volume><fpage>1258</fpage><lpage>1265</lpage><pub-id pub-id-type="pmid">12699953</pub-id></citation></ref><ref id="pone.0002927-Harding1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harding</surname><given-names>JJ</given-names></name></person-group><year>1991</year><article-title>Post-translational modification of lens proteins in cataract.</article-title><source>Lens Eye Toxic Res</source><volume>8</volume><fpage>245</fpage><lpage>250</lpage><pub-id pub-id-type="pmid">1911639</pub-id></citation></ref><ref id="pone.0002927-Swamy1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Swamy</surname><given-names>MS</given-names></name><name><surname>Abraham</surname><given-names>EC</given-names></name></person-group><year>1987</year><article-title>Lens protein composition, glycation and high molecular weight aggregation in aging rats.</article-title><source>Invest Ophthalmol Vis Sci</source><volume>28</volume><fpage>1693</fpage><lpage>1701</lpage><pub-id pub-id-type="pmid">3654142</pub-id></citation></ref><ref id="pone.0002927-Bloemendal1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bloemendal</surname><given-names>H</given-names></name><name><surname>de Jong</surname><given-names>W</given-names></name><name><surname>Jaenicke</surname><given-names>R</given-names></name><name><surname>Lubsen</surname><given-names>NH</given-names></name><name><surname>Slingsby</surname><given-names>C</given-names></name><etal/></person-group><year>2004</year><article-title>Ageing and vision: structure, stability and function of lens crystallins.</article-title><source>Prog Biophys Mol Biol</source><volume>86</volume><fpage>407</fpage><lpage>485</lpage><pub-id pub-id-type="pmid">15302206</pub-id></citation></ref><ref id="pone.0002927-Buchner1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buchner</surname><given-names>J</given-names></name></person-group><year>1996</year><article-title>Supervising the fold: functional principles of molecular chaperones.</article-title><source>Faseb J</source><volume>10</volume><fpage>10</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">8566529</pub-id></citation></ref><ref id="pone.0002927-deJong1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>de Jong</surname><given-names>WW</given-names></name><name><surname>Caspers</surname><given-names>GJ</given-names></name><name><surname>Leunissen</surname><given-names>JA</given-names></name></person-group><year>1998</year><article-title>Genealogy of the alpha-crystallin&#x02013;small heat-shock protein superfamily.</article-title><source>Int J Biol Macromol</source><volume>22</volume><fpage>151</fpage><lpage>162</lpage><pub-id pub-id-type="pmid">9650070</pub-id></citation></ref><ref id="pone.0002927-Raman1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Raman</surname><given-names>B</given-names></name><name><surname>Rao</surname><given-names>CM</given-names></name></person-group><year>1997</year><article-title>Chaperone-like activity and temperature-induced structural changes of alpha-crystallin.</article-title><source>J Biol Chem</source><volume>272</volume><fpage>23559</fpage><lpage>23564</lpage><pub-id pub-id-type="pmid">9295293</pub-id></citation></ref><ref id="pone.0002927-Klemenz1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Klemenz</surname><given-names>R</given-names></name><name><surname>Frohli</surname><given-names>E</given-names></name><name><surname>Aoyama</surname><given-names>A</given-names></name><name><surname>Hoffmann</