rson-group><year>2005</year><article-title>Touch Noise Increases Vibrotactile Sensitivity in Old and Young.</article-title><source>Psychological Science</source><volume>16</volume><fpage>313</fpage><lpage>320</lpage><pub-id pub-id-type="pmid">15828979</pub-id></citation></ref><ref id="pone.0002860-Gong1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gong</surname><given-names>Y</given-names></name><name><surname>Matthews</surname><given-names>N</given-names></name><name><surname>Quian</surname><given-names>N</given-names></name></person-group><year>2002</year><article-title>A model for stochastic resonance-type behavior in sensory perception.</article-title><source>Physical Review E</source><volume>65</volume><fpage>031904</fpage></citation></ref><ref id="pone.0002860-Green1"><label>19</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Green</surname><given-names>DM</given-names></name><name><surname>Swets</surname><given-names>JA</given-names></name></person-group><year>1966</year><source>Signal Detection Theory and Psychophysics</source><publisher-loc>New York</publisher-loc><publisher-name>John Wiley &#x00026; Sons</publisher-name><fpage>87</fpage><lpage>99</lpage></citation></ref><ref id="pone.0002860-Yerkes1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yerkes</surname><given-names>RM</given-names></name><name><surname>Dodson</surname><given-names>JD</given-names></name></person-group><year>1908</year><article-title>The relation of strength of stimulus to rapidity of habit-formation.</article-title><source>Journal of Comparative Neurology and Psychology</source><volume>18</volume><fpage>459</fpage><lpage>482</lpage></citation></ref><ref id="pone.0002860-Priplata1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Priplata</surname><given-name