722</pub-id></element-citation></ref><ref id="CIT7"><label>7</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>MA</given-names></name><name><surname>Leman</surname><given-names>RJ</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Chernick</surname><given-names>V</given-names></name><name><surname>Boat</surname><given-names>T</given-names></name></person-group><article-title>Kendig's disorders of the respiratory tract in children</article-title><source>Bronchiectasis</source><year>1998</year><edition>6th ed</edition><publisher-loc>Philadelphia</publisher-loc><publisher-name>W.B. Saunders</publisher-name><fpage>538</fpage><lpage>60</lpage></element-citation></ref><ref id="CIT8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>AM</given-names></name><name><surname>Sonnappa</surname><given-names>S</given-names></name><name><surname>Lex</surname><given-names>C</given-names></name><name><surname>Wong</surname><given-names>E</given-names></name><name><surname>Zacharasiewicz</surname><given-names>A</given-names></name><name><surname>Bush</surname><given-names>A</given-names></name><etal/></person-group><article-title>Non-CF bronchiectasis: Does knowing the aetiology lead to changes in management?</article-title><source>Eur Respir J</source><year>2005</year><volume>26</volume><fpage>8</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">15994383</pub-id></element-citation></ref><ref id="CIT9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Eastham</surname><given-names>KM</given-names></name><name><surname>Fall</surname><given-names>AJ</given-names></name><name><surname>Mitchell</surname><given-names>L</given-names></name><name><surname>Spencer</surname><given-names>DA</given-names></name></perso