e><name><surname>White</surname><given-names>HD</given-names></name></person-group><article-title>Factors affecting outcome after recovery from myocardial infarction</article-title><source>Annu Rev Med</source><year>1994</year><volume>45</volume><fpage>325</fpage><lpage>339</lpage><pub-id pub-id-type="pmid">8198387</pub-id><pub-id pub-id-type="doi">10.1146/annurev.med.45.1.325</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sastre</surname><given-names>A</given-names></name><name><surname>Cook</surname><given-names>MR</given-names></name><name><surname>Graham</surname><given-names>C</given-names></name></person-group><article-title>Nocturnal exposure to intermittent 60 Hz magnetic fields alters human cardiac rhythm</article-title><source>Bioelectromagnetics</source><year>1998</year><volume>19</volume><fpage>98</fpage><lpage>106</lpage><pub-id pub-id-type="pmid">9492166</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1521-186X(1998)19:2&#x0003c;98::AID-BEM7&#x0003e;3.0.CO;2-Z</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Savitz</surname><given-names>DA</given-names></name><name><surname>Liao</surname><given-names>D</given-names></name><name><surname>Sastre</surname><given-names>A</given-names></name><name><surname>Kleckner</surname><given-names>RC</given-names></name><name><surname>Kavet</surname><given-names>R</given-names></name></person-group><article-title>Magnetic field exposure and cardiovascular disease mortality among electric utility workers</article-title><source>Am J Epidemiol</source><year>1999</year><volume>149</volume><fpage>135</fpage><lpage>142</lpage><pub-id pub-id-type="pmid">9921958</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kheifets</surname><given-names>L</given-names></name><name><surname>Ahlbom</surnam