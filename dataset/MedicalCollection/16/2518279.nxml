<lpage>175</lpage><pub-id pub-id-type="pmid">16736366</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dausey</surname><given-names>DJ</given-names></name><name><surname>Buehler</surname><given-names>JW</given-names></name><name><surname>Lurie</surname><given-names>N</given-names></name></person-group><article-title>Designing and conducting tabletop exercises to assess public health preparedness for manmade and naturally occurring biological threats</article-title><source>BMC Public Health</source><year>2007</year><volume>7</volume><fpage>92</fpage><pub-id pub-id-type="pmid">17535426</pub-id><pub-id pub-id-type="doi">10.1186/1471-2458-7-92</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Biddinger</surname><given-names>P</given-names></name><name><surname>Cadigan</surname><given-names>RO</given-names></name><name><surname>Auerbach</surname><given-names>B</given-names></name><name><surname>Burstein</surname><given-names>J</given-names></name><name><surname>Savoia</surname><given-names>E</given-names></name><name><surname>Stoto</surname><given-names>M</given-names></name><name><surname>Koh</surname><given-names>H</given-names></name></person-group><article-title>Using Tabletop Exercises to Identify Systems-Level Changes for Improving Preparedness</article-title><source>Public Health Rep</source><year>2008</year><volume>123</volume><fpage>96</fpage><lpage>101</lpage><pub-id pub-id-type="pmid">18348486</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Viswanath</surname><given-names>K</given-names></name><name><surname>Randolph Steele</surname><given-names>W</given-names></name><name><surname>Finnegan</surname><given-names>JR</given-names></name></person-group><article-title>Social capital and health: civic engagement, community size, and recall of health messages</article-title><source>Am J Public Health</source><year>2006</year><volume>96</volume><fpage>1456</fpage><lpage>61</lpage><pub-id pub-id-type="pmid">16809608</pub-id><pub-id pub-id-type="doi">10.2105/AJPH.2003.029793</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koh</surname><given-names>HK</given-names></name><name><surname>Stoto</surname><given-names>MA</given-names></name><name><surname>Judge</surname><given-names>CM</given-names></name><name><surname>Elqura</surname><given-names>L</given-names></name></person-group><article-title>Emergency preparedness as a catalyst for regionalizing local public health</article-title><source>Annual Review of Public Health</source><year>2008</year><comment></comment><pub-id pub-id-type="pmid">18348711</pub-id></citation></ref></ref-list></back></article>