ion></ref><ref id="r14"><label>14</label><citation citation-type="journal">Schroder M, Kaufman RJ: The mammalian unfolded protein response. <source>Annu Rev Biochem</source> <volume>74</volume>: <fpage>739</fpage>&#x02013;789, <year>2005</year><pub-id pub-id-type="pmid">15952902</pub-id></citation></ref><ref id="r15"><label>15</label><citation citation-type="journal">Wang H, Kouri G, Wollheim CB: ER stress and SREBP-1 activation are implicated in &#x003b2;-cell glucolipotoxicity. <source>J Cell Sci</source> <volume>118</volume>: <fpage>3905</fpage>&#x02013;3915, <year>2005</year><pub-id pub-id-type="pmid">16091421</pub-id></citation></ref><ref id="r16"><label>16</label><citation citation-type="journal">Gregor MF, Hotamisligil GS: Adipocyte stress: the endoplasmic reticulum and metabolic disease. <source>J Lipid Res</source> <volume>48</volume>: <fpage>1905</fpage>&#x02013;1914, <year>2007</year><pub-id pub-id-type="pmid">17699733</pub-id></citation></ref><ref id="r17"><label>17</label><citation citation-type="journal">Wu J, Kaufman RJ: From acute ER stress to physiological roles of the unfolded protein response. <source>Cell Death Differ</source> <volume>13</volume>: <fpage>374</fpage>&#x02013;384, <year>2006</year><pub-id pub-id-type="pmid">16397578</pub-id></citation></ref><ref id="r18"><label>18</label><citation citation-type="journal">Calfon M, Zeng H, Urano F, Till JH, Hubbard SR, Harding HP, Clark SG, Ron D: IRE1 couples endoplasmic reticulum load to secretory capacity by processing the XBP-1 mRNA. <source>Nature</source> <volume>415</volume>: <fpage>92</fpage>&#x02013;96, <year>2002</year><pub-id pub-id-type="pmid">11780124</pub-id></citation></ref><ref id="r19"><label>19</label><citation citation-type="journal">Trombetta ES, Helenius A: Conformational requirements for glycoprotein reglucosylation in the endoplasmic reticulum. <source>J Cell Biol</source> <volume>148</volume>: <fpage>1123</fpage>&#x02013;1129, <year>2000</year><pub-id pub-id-type="pmid">10725325</pub-id></citation></ref><ref id="r20"><label>20</label><citation citation-type="journal">Kyriakis M, Banerjee P, Nikolakaki E, Dai T, Ruble EA, Ahmad MF, Avruch J, Woodgett JR: The stress-activated protein kinase subfamily of c-Jun kinases. <source>Nature</source> <volume>369</volume>: <fpage>156</fpage>&#x02013;160, <year>1994</year><pub-id pub-id-type="pmid">8177321</pub-id></citation></ref><ref id="r21"><label>21</label><citation citation-type="journal">Srivastava RK, Sollott SJ, Khan L, Hansford R, Lakatta EG, Longo DL: Bcl-2 and Bcl-X(L) thapsigargin-induced nitric oxide generation, c-Jun NH<sub>2</sub>-terminal kinase activity, and apoptosis. <source>Mol Cell Biol</source> <volume>19</volume>: <fpage>5659</fpage>&#x02013;5674, <year>1999</year><pub-id pub-id-type="pmid">10409755</pub-id></citation></ref><ref id="r22"><label>22</label><citation citation-type="journal">Urano F, Wang X, Bertolotti A, Zhang Y, Chung P, Harding HP, Ron D: Coupling stress in the ER to activation of JNK protein kinases by transmembrane protein kinase IRE 1. <source>Science</source> <volume>287</volume>: <fpage>664</fpage>&#x02013;666, <year>2000</year><pub-id pub-id-type="pmid">10650002</pub-id></citation></ref><ref id="r23"><label>23</label><citation citation-type="journal">Ahmad M, Attoub S, Singh MN, Martin FL, El-Agnaf OMA: &#x003b3;-Synuclein and the progression of cancer. <source>FASEB J Rev</source> <volume>21</volume>: <fpage>3419</fpage>&#x02013;3430, <year>2007</year></citation></ref><ref id="r24"><label>24</label><citation citation-type="journal">Wu K, Quan Z, Weng Z, Li F, Zhang Y, Yao X, Chen Y, Budman D, Goldberg ID, Shi YE: Expression of neuronal protein synuclein gamma gene as a novel marker for breast cancer prognosis. <source>Breast Cancer Res Treat</source> <volume>101</volume>: <fpage>259</fpage>&#x02013;267, <year>2006</year><pub-id pub-id-type="pmid">16821081</pub-id></citation></ref><ref id="r25"><label>25</label><citation citation-type="journal">Lew EA, Garfinkel L: Variations in mortality by weight among 750,000 men and women. <source>J Chronic Dis</source> <volume>32</volume>: <fpage>563</fpage>&#x02013;576, <year>1979</year><pub-id pub-id-type="pmid">468958</pub-id></citation></ref><ref id="r26"><label>26</label><citation citation-type="journal">Manson JE, Willett WC, Stampfer MJ, Colditz GA, Hunger DJ, Hankinson SE, Hennekens CH, Speizer FE: Body weight and mortality among women. <source>N Engl J Med</source> <volume>333</volume>: <fpage>677</fpage>&#x02013;685, <year>1995</year><pub-id pub-id-type="pmid">7637744</pub-id></citation></ref><ref id="r27"><label>27</label><citation citation-type="journal">Hosogai N, Fukuhara A, Oshima K, Miyata Y, Tanaka S, Segawa K, Furukawa S, Tochino Y, Komuro R, Matsuda M, Shimomura I: Adipose tissue hypoxia in obesity and its impact on adipocytokine dysregulation. <source>Diabetes</source> <volume>56</volume>: <fpage>901</fpage>&#x02013;911, <year>2007</year><pub-id pub-id-type="pmid">17395738</pub-id></citation></ref><ref id="r28"><label>28</label><citation citation-type="journal">Ye J, Gao Z, Yin J, He Q: Hypoxia is a potential risk factor for chronic inflammation and adiponectin reduction in adipose tissue of ob/ob and dietary obese mice. <source>Am J Physiol Endocrinol Metab</source> <volume>293</volume>: <fpage>E1118</fpage>&#x02013;E1128, <year>2007</year><pub-id pub-id-type="pmid">17666485</pub-id></citation></ref><ref id="r29"><label>29</label><citation citation-type="journal">Furukawa S, Fujita T, Shimabukuro M, Iwaki M, Yamada Y, Nakajima Y, Nakayama O, Makishima M, Matsuda M, Shimomura I: Increased oxidative stress in obesity and its impact on metabolic syndrome. <source>J Clin Invest</source> <volume>114</volume>: <fpage>1752</fpage>&#x02013;1761, <year>2004</year><pub-id pub-id-type="pmid">15599400</pub-id></citation></ref><ref id="r30"><label>30</label><citation citation-type="journal">Xue X, Piao J-H, Nakajima A, Sakon-Komazawa S, Kojima Y, Mori K, Yagita H, Okumura K, Harding H, Nakano H: Tumor necrosis factor alpha (TNF-&#x003b1;) induces the unfolded protein response (UPR) in a reactive oxygen species (ROS)-dependent fashion, and the UPR counteracts ROS accumulation by TNF-&#x003b1;. <source>J Biol Chem</source> <volume>280</volume>: <fpage>33917</fpage>&#x02013;33925, <year>2005</year><pub-id pub-id-type="pmid">16107336</pub-id></citation></ref></ref-list></back><floats-wrap><fig position="float" id="f1"><label>FIG. 1.</label><caption><p>Expression levels of the UPR proteins CRT and PDI in adipose tissue of one lean and one obese subject (<italic>upper panels</italic>). Differentially expressed proteins in fat homogenates from one lean and one obese subject. Proteins were separated by isoelectric focusing and molecular weight (2-DG) as described in <sc>research design and methods</sc>. The subproteom from each sample was assessed using Pi ranges of 4&#x02013;7 (<italic>middle panels</italic>) and 6&#x02013;10 (<italic>lower panels</italic>). The proteins were stained with spyro-ruby and images compared by PD Quest software. The numbers correspond to the spot numbers in <xref ref-type="table" rid="t2">Table 2</xref>. The arrows indicate upregulated proteins in the fat of obese subjects.</p></caption><graphic xlink:href="zdb0090854050001"></graphic></fig><fig position="float" id="f2"><label>FIG. 2.</label><caption><p>Protein abundance (by Western blots) of CNX/&#x003b2;-actin, CRT/&#x003b2;-actin, PDI, phospho&#x02013;JNK-1/JNK-1 and phospho&#x02013;JNK-2,3/JNK-2,3 in subcutaneous adipose tissue from four lean (insufficient fat was available for Western analysis from two of six lean subjects) and six obese nondiabetic subjects. Inserts show representative Western blots.</p></caption><graphic xlink:href="zdb0090854050002"></graphic></fig><fig position="float" id="f3"><label>FIG. 3.</label><caption><p>Messenger RNA (mRNA) corrected for 18s ribosomal RNA (18sr RNA) of sXBP-1, tumor necrosis factor-&#x003b1;, interleukin-1&#x003b2;, and interleukin-6 in six lean and six obese nondiabetic subjects.</p></caption><graphic xlink:href="zdb0090854050003"></graphic></fig><table-wrap position="float" id="t1"><label>TABLE 1</label><caption><p>Study subjects</p></caption><table frame="hsides" rules="groups"><thead><tr><th colspan="1" rowspan="1" align="center" valign="bottom"/><th colspan="1" rowspan="1" align="center" valign="bottom">Lean</th><th colspan="1" rowspan="1" align="center" valign="bottom">Obese</th><th colspan="1" rowspan="1" align="center" valign="bottom"><italic>P</italic></th></tr></thead><tbody><tr><td colspan="1" rowspan="1" align="left" valign="top">Sex (male/female)</td><td colspan="1" rowspan="1" align="center" valign="top">4/2</td><td colspan="1" rowspan="1" align="center" valign="top">3/3</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Age (years)</td><td colspan="1" rowspan="1" align="center" valign="top">36 &#x000b1; 4</td><td colspan="1" rowspan="1" align="center" valign="top">44 &#x000b1; 4</td><td colspan="1" rowspan="1" align="center" valign="top">NS</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Weight (kg)</td><td colspan="1" rowspan="1" align="center" valign="top">77.4 &#x000b1; 3.4</td><td colspan="1" rowspan="1" align="center" valign="top">93.4 &#x000b1; 5.6</td><td colspan="1" rowspan="1" align="char" char="." valign="top">0.03</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Height (cm)</td><td colspan="1" rowspan="1" align="center" valign="top">180.0 &#x000b1; 2.7</td><td colspan="1" rowspan="1" align="center" valign="top">167 &#x000b1; 4.5</td><td colspan="1" rowspan="1" align="char" char="." valign="top">0.03</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">BMI (kg/m<sup>2</sup>)</td><td colspan="1" rowspan="1" align="center" valign="top">24.0 &#x000b1; 1.2</td><td colspan="1" rowspan="1" align="center" valign="top">33.5 &#x000b