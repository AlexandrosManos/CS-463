<volume>8</volume><fpage>R7</fpage><pub-id pub-id-type="pmid">16417656</pub-id><pub-id pub-id-type="doi">10.1186/bcr1371</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stingl</surname><given-names>J</given-names></name><name><surname>Eirew</surname><given-names>P</given-names></name><name><surname>Ricketson</surname><given-names>I</given-names></name><name><surname>Shackleton</surname><given-names>M</given-names></name><name><surname>Vaillant</surname><given-names>F</given-names></name><name><surname>Choi</surname><given-names>D</given-names></name><name><surname>Li</surname><given-names>HI</given-names></name><name><surname>Eaves</surname><given-names>CJ</given-names></name></person-group><article-title>Purification and unique properties of mammary epithelial stem cells</article-title><source>Nature</source><year>2006</year><volume>439</volume><fpage>993</fpage><lpage>997</lpage><pub-id pub-id-type="pmid">16395311</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Welm</surname><given-names>BE</given-names></name><name><surname>Tepera</surname><given-names>SB</given-names></name><name><surname>Venezia</surname><given-names>T</given-names></name><name><surname>Graubert</surname><given-names>TA</given-names></name><name><surname>Rosen</surname><given-names>JM</given-names></name><name><surname>Goodell</surname><given-names>MA</given-names></name></person-group><article-title>Sca-1(pos) cells in the mouse mammary gland represent an enriched progenitor cell population</article-title><source>Dev Biol</source><year>2002</year><volume>245</volume><fpage>42</fpage><lpage>56</lpage><pub-id pub-id-type="pmid">11969254</pub-id><pub-id pub-id-type="doi">10.1006/dbio.2002.0625</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sleeman</surname><gi