ce><volume>3</volume><fpage>1088</fpage><lpage>1100</lpage><pub-id pub-id-type="pmid">15470237</pub-id></citation></ref><ref id="pgen.1000148-Sheth1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sheth</surname><given-names>N</given-names></name><name><surname>Roca</surname><given-names>X</given-names></name><name><surname>Hastings</surname><given-names>ML</given-names></name><name><surname>Roeder</surname><given-names>T</given-names></name><name><surname>Krainer</surname><given-names>AR</given-names></name><etal/></person-group><year>2006</year><article-title>Comprehensive splice-site analysis using comparative genomics.</article-title><source>Nucl Acids Res</source><volume>34</volume><fpage>3955</fpage><lpage>3967</lpage><pub-id pub-id-type="pmid">16914448</pub-id></citation></ref><ref id="pgen.1000148-Coolidge1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coolidge</surname><given-names>C</given-names></name><name><surname>Seely</surname><given-names>R</given-names></name><name><surname>Patton</surname><given-names>J</given-names></name></person-group><year>1997</year><article-title>Functional analysis of the polypyrimidine tract in pre-mRNA splicing.</article-title><source>Nucl Acids Res</source><volume>25</volume><fpage>888</fpage><lpage>896</lpage><pub-id pub-id-type="pmid">9016643</pub-id></citation></ref><ref id="pgen.1000148-Drabenstot1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Drabenstot</surname><given-names>SD</given-names></name><name><surname>Kupfer</surname><given-names>DM</given-names></name><name><surname>White</surname><given-names>JD</given-names></name><name><surname>Dyer</surname><given-names>DW</given-names></name><name><surname>Roe</surname><given-names>BA</given-names></name><etal/></person-group><year>2003</year><article-title>FELINES: a utility for extrac