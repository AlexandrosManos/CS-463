></name><name><surname>Weiser</surname><given-names>MD</given-names></name></person-group><year>2006</year><article-title>Empirical evaluation of neutral theory.</article-title><source>Ecology</source><volume>87</volume><fpage>1411</fpage><lpage>1423</lpage><pub-id pub-id-type="pmid">16869415</pub-id></citation></ref><ref id="pone.0002777-Steele1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Steele</surname><given-names>JH</given-names></name></person-group><year>1985</year><article-title>A comparison of terrestrial and marine ecological systems.</article-title><source>Nature</source><volume>313</volume><fpage>355</fpage><lpage>358</lpage></citation></ref><ref id="pone.0002777-Halley1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Halley</surname><given-names>JM</given-names></name></person-group><year>1996</year><article-title>Ecology, evolution and 1/f-noise.</article-title><source>Trends Ecol Evol</source><volume>11</volume><fpage>33</fpage><lpage>37</lpage></citation></ref><ref id="pone.0002777-Vasseur1"><label>14</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Vasseur</surname><given-names>A</given-names></name><name><surname>McCann</surname><given-names>KS</given-names></name></person-group><year>2007</year><source>The impact of environmental variability on ecological systems</source><publisher-name>Springer</publisher-name><fpage>231</fpage></citation></ref><ref id="pone.0002777-BenedettiCecchi1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Benedetti-Cecchi</surname><given-names>L</given-names></name></person-group><year>2007</year><article-title>Neutral theory and 1/f noise make similar predictions of assemblage dynamics.</article-title><source>Trends Ecol Evol</source><volume>22</volume><fpage>231</fpage><pub-id pub-id-type="pmid">17306414</pub-id></citation></ref><ref id="pone.0002777-Etienne1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Etienne</surname><given-names>RS</given-names></name><name><surname>Olff</surname><given-names>H</given-names></name></person-group><year>2005</year><article-title>Bayesian analysis of species abundance data: assessing the relative importance of dispersal and niche-partitioning for the maintenance of biodiversity.</article-title><source>Ecol Lett</source><volume>8</volume><fpage>493</fpage><lpage>504</lpage></citation></ref><ref id="pone.0002777-Etienne2"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Etienne</surname><given-names>R</given-names></name></person-group><year>2007</year><article-title>A neutral sampling formula for multiple samples and an exact test for neutrality.</article-title><source>Ecol Lett</source><volume>10</volume><fpage>608</fpage><lpage>618</lpage><pub-id pub-id-type="pmid">17542939</pub-id></citation></ref><ref id="pone.0002777-Pueyo1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pueyo</surname><given-names>S</given-names></name><name><surname>He</surname><given-names>F</given-names></name><name><surname>Zillo</surname><given-names>T</given-names></name></person-group><year>2007</year><article-title>The maximum entropy formalism and the idiosyncratic theory of biodiversity.</article-title><source>Ecol Lett</source><volume>10</volume><fpage>1017</fpage><lpage>1028</lpage><pub-id pub-id-type="pmid">17692099</pub-id></citation></ref><ref id="pone.0002777-Alonso1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Alonso</surname><given-names>D</given-names></name><name><surname>Ostling</surname><given-names>A</given-names></name><name><surname>Etienne</surname><given-names>R</given-names></name></