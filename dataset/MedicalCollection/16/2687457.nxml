id></mixed-citation></ref><ref id="B10"><mixed-citation publication-type="journal"><name><surname>Conti</surname><given-names>PS</given-names></name><name><surname>Lilien</surname><given-names>DL</given-names></name><name><surname>Hawley</surname><given-names>K</given-names></name><name><surname>Keppler</surname><given-names>J</given-names></name><name><surname>Grafton</surname><given-names>ST</given-names></name><name><surname>Bading</surname><given-names>JR</given-names></name><article-title>PET and [18F]-FDG in oncology: a clinical update</article-title><source>Nucl Med Biol</source><year>1996</year><volume>23</volume><fpage>717</fpage><lpage>735</lpage><pub-id pub-id-type="doi">10.1016/0969-8051(96)00074-1</pub-id><pub-id pub-id-type="pmid">8940714</pub-id></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><name><surname>Gupta</surname><given-names>NC</given-names></name><name><surname>Frank</surname><given-names>AR</given-names></name><name><surname>Dewan</surname><given-names>NA</given-names></name><name><surname>Redepenning</surname><given-names>LS</given-names></name><name><surname>Rothberg</surname><given-names>ML</given-names></name><name><surname>Mailliard</surname><given-names>JA</given-names></name><article-title>Solitary pulmonary nodules: detection of malignancy with PET with 2-[F-18]-fluoro-2-deoxy-D-glucose</article-title><source>Radiology</source><year>1992</year><volume>184</volume><fpage>441</fpage><lpage>444</lpage><pub-id pub-id-type="pmid">1620844</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><name><surname>Gupta</surname><given-names>NC</given-names></name><name><surname>Maloof</surname><given-names>J</given-names></name><name><surname>Gunel</surname><given-names>E</given-names></name><article-title>Probability of malignancy in solitary pulmonary nodules using fluorine-18-FDG and PET</article-title><source>J Nucl Med</source><year>1996</year><volume>37</volume><fpage>943</