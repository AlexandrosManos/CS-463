 left superior vena cava</article-title><source>Int J Cardiol</source><year>2007</year><volume>2;116</volume><fpage>e15</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">17098307</pub-id></citation></ref><ref id="EUN173C7"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ramcharitar</surname><given-names>S</given-names></name><name><surname>Patterson</surname><given-names>MS</given-names></name><name><surname>van Guens</surname><given-names>RJ</given-names></name><name><surname>Serruys</surname><given-names>PW</given-names></name></person-group><article-title>Magnetic navigation system used successfully to cross a crushed stent in a bifurcation that failed with conventional wires</article-title><source>Catheter Cardiovasc Interv</source><year>2007</year><volume>69</volume><fpage>852</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">17191212</pub-id></citation></ref><ref id="EUN173C8"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mansour</surname><given-names>M</given-names></name><name><surname>Reddy</surname><given-names>VY</given-names></name><name><surname>Singh</surname><given-names>J</given-names></name><name><surname>Mela</surname><given-names>T</given-names></name><name><surname>Rasche</surname><given-names>V</given-names></name><name><surname>Ruskin</surname><given-names>J</given-names></name></person-group><article-title>Three-dimensional reconstruction of the coronary sinus using rotational angiography</article-title><source>J Cardiovasc Electrophysiol</source><year>2005</year><volume>16</volume><fpage>675</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">15946372</pub-id></citation></ref><ref id="EUN173C9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thornton</surname><given-names>AS</given-names></name><name><surname>Janse</surname><given-names>P</given-names></name><name><surnam