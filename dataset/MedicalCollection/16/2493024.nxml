<hr/></td><td valign="bottom" align="center" rowspan="1" colspan="1">2.5<hr/></td></tr><tr><td valign="bottom" align="left" scope="row" rowspan="1" colspan="1">MmugDNA.37083.1.S1_at<hr/></td><td valign="bottom" align="left" rowspan="1" colspan="1"><ext-link ext-link-type="uri" xlink:href="http://www.ncbi.nlm.nih.gov/entrez/viewer.fcgi?db=nuccore&#x00026;id=21955171">NM_145753</ext-link><hr/></td><td valign="bottom" align="center" rowspan="1" colspan="1">PHLDB2<hr/></td><td valign="bottom" align="left" rowspan="1" colspan="1">pleckstrin homology-like domain, family B, member 2<hr/></td><td valign="bottom" align="center" rowspan="1" colspan="1">2.5<hr/></td></tr><tr><td valign="bottom" align="left" scope="row" rowspan="1" colspan="1">MmugDNA.6639.1.S1_at<hr/></td><td valign="bottom" align="center" rowspan="1" colspan="1">&#x000a0;<hr/></td><td valign="bottom" align="center" rowspan="1" colspan="1">&#x000a0;<hr/></td><td valign="bottom" align="left" rowspan="1" colspan="1">Transcribed locus<hr/></td><td valign="bottom" align="center" rowspan="1" colspan="1">2.4<hr/></td></tr><tr><td valign="bottom" align="left" scope="row" rowspan="1" colspan="1">MmugDNA.22537.1.S1_s_at<hr/></td><td valign="bottom" align="left" rowspan="1" colspan="1"><ext-link ext-link-type="uri" xlink:href="http://www.ncbi.nlm.nih.gov/entrez/viewer.fcgi?db=nuccore&#x00026;id=167614503">NM_002291</ext-link><hr/></td><td valign="bottom" align="center" rowspan="1" colspan="1">LAMB1<hr/></td><td valign="bottom" align="left" rowspan="1" colspan="1">laminin, beta 1<hr/></td><td valign="bottom" align="center" rowspan="1" colspan="1">2.2<hr/></td></tr><tr><td valign="bottom" align="left" scope="row" rowspan="1" colspan="1">MmuSTS.3615.1.S1_at<hr/></td><td valign="bottom" align="left" rowspan="1" colspan="1"><ext-link ext-link-type="uri" xlink:href="http://www.ncbi.nlm.nih.gov/entrez/viewer.fcgi?db=nuccore&#x00026;id=68508956">NM_001266</ext-link><hr/></td><td valign="bottom" align="center" rowspan="1" colspa