me><name><surname>Oberlander</surname><given-names>T</given-names></name><name><surname>Holsti</surname><given-names>L</given-names></name><name><surname>Whitfield</surname><given-names>MF</given-names></name></person-group><year>1998</year><article-title>Bedside application of the Neonatal Facial Coding System in pain assessment of premature neonates</article-title><source>Pain</source><volume>76</volume><fpage>277</fpage><lpage>286</lpage><pub-id pub-id-type="pmid">9718246</pub-id></citation></ref><ref id="pmed-0050129-b017"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnston</surname><given-names>CC</given-names></name><name><surname>Stevens</surname><given-names>BJ</given-names></name><name><surname>Yang</surname><given-names>F</given-names></name><name><surname>Horton</surname><given-names>L</given-names></name></person-group><year>1995</year><article-title>Differential response to pain by very premature neonates</article-title><source>Pain</source><volume>61</volume><fpage>471</fpage><lpage>479</lpage><pub-id pub-id-type="pmid">7478691</pub-id></citation></ref><ref id="pmed-0050129-b018"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bauer</surname><given-names>K</given-names></name><name><surname>Ketteler</surname><given-names>J</given-names></name><name><surname>Hellwig</surname><given-names>M</given-names></name><name><surname>Laurenz</surname><given-names>M</given-names></name><name><surname>Versmold</surname><given-names>H</given-names></name></person-group><year>2004</year><article-title>Oral glucose before venepuncture relieves neonates of pain, but stress is still evidenced by increase in oxygen consumption, energy expenditure, and heart rate</article-title><source>Pediatr Res</source><volume>55</volume><fpage>695</fpage><lpage>700</lpage><pub-id pub-id-type="pmid">14711888</pub-id></citation></ref><ref id="pmed-0050129-b019"><citation citation-type="journal"><per