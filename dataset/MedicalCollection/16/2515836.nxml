n-names></name><name><surname>Bettschart</surname><given-names>R</given-names></name><name><surname>Zemp</surname><given-names>E</given-names></name><name><surname>Frey</surname><given-names>M</given-names></name><name><surname>Keller</surname><given-names>R</given-names></name><name><surname>Tschopp</surname><given-names>JM</given-names></name><name><surname>Leuenberger</surname><given-names>P</given-names></name><name><surname>Ackermann-Liebrich</surname><given-names>U</given-names></name></person-group><article-title>Accelerated decline in lung function in smoking women with airway obstruction: SAPALDIA 2 cohort study</article-title><source>Respir Res</source><year>2005</year><volume>6</volume><fpage>45</fpage><pub-id pub-id-type="pmid">15918902</pub-id><pub-id pub-id-type="doi">10.1186/1465-9921-6-45</pub-id></citation></ref><ref id="B15"><citation citation-type="other"><article-title>The Burden of Lung Disease 2006 - 2nd edition.  A Statistics Report from the British Thoracic Society</article-title><ext-link ext-link-type="uri" xlink:href="http://www.erpho.org.uk/Download/Public/15381/1/BurdenLungDisease2006.pdf"/></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Faulconer</surname><given-names>ER</given-names></name><name><surname>de Lusignan</surname><given-names>S</given-names></name></person-group><article-title>An eight-step method for assessing diagnostic data quality in practice: chronic obstructive pulmonary disease as an exemplar</article-title><source>Inform Prim Care</source><year>2004</year><volume>12</volume><fpage>243</fpage><lpage>254</lpage><pub-id pub-id-type="pmid">15808026</pub-id></citation></ref></ref-list></back></article>