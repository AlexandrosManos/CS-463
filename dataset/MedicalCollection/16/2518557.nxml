,833</td><td align="center">0,04</td><td align="center">1,753</td><td align="center">0,07</td></tr><tr><td align="left"><italic>FOXM1</italic></td><td align="left">Hs00153543_m1</td><td align="center">15</td><td align="center">20</td><td align="center">28,38</td><td align="center">2,00</td><td align="center">24,67</td><td align="center">1,88</td><td align="center">3,71</td><td align="center">0,971</td><td align="center">1,896</td><td align="center">0,05</td><td align="center">1,718</td><td align="center">0,05</td></tr><tr><td align="left"><italic>GJB2</italic></td><td align="left">Hs00269615_s1</td><td align="center">21</td><td align="center">22</td><td align="center">26,13</td><td align="center">2,39</td><td align="center">22,27</td><td align="center">2,36</td><td align="center">3,86</td><td align="center">0,984</td><td align="center">1,864</td><td align="center">0,05</td><td align="center">1,888</td><td align="center">0,06</td></tr><tr><td align="left"><italic>GUSB</italic></td><td align="left">Hs99999908_m1</td><td align="center">22</td><td align="center">22</td><td align="center">25,18</td><td align="center">2,08</td><td align="center">20,79</td><td align="center">2,14</td><td align="center">4,40</td><td align="center">-</td><td align="center">1,914</td><td align="center">0,04</td><td align="center">1,942</td><td align="center">0,07</td></tr><tr><td align="left"><italic>IGF2</italic></td><td align="left">Hs00171254_m1</td><td align="center">18</td><td align="center">21</td><td align="center">25,15</td><td align="center">3,98</td><td align="center">23,08</td><td align="center">3,90</td><td align="center">2,07</td><td align="center">0,993</td><td align="center">1,835</td><td align="center">0,06</td><td align="center">1,743</td><td align="center">0,07</td></tr><tr><td align="left"><italic>IQGAP3</italic></td><td align="left">Hs00603642_m1</td><td align="center">14</td><td align="center">20</td><td align="center">28,29</td><td align="center">1,52</td><td align="cent