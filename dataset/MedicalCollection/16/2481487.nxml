doi">10.1038/nature01514</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Disis</surname><given-names>ML</given-names></name><name><surname>Calenoff</surname><given-names>E</given-names></name><name><surname>McLaughlin</surname><given-names>G</given-names></name><name><surname>Murphy</surname><given-names>AE</given-names></name><name><surname>Chen</surname><given-names>W</given-names></name><name><surname>Groner</surname><given-names>B</given-names></name><name><surname>Jeschke</surname><given-names>M</given-names></name><name><surname>Lydon</surname><given-names>N</given-names></name><name><surname>McGlynn</surname><given-names>E</given-names></name><name><surname>Livingston</surname><given-names>RB</given-names></name><name><surname>Moe</surname><given-names>R</given-names></name><name><surname>Cheever</surname><given-names>MA</given-names></name></person-group><article-title>Existent T-cell and antibody immunity to HER-2/neu protein in patients with breast cancer</article-title><source>Cancer Res</source><year>1994</year><volume>54</volume><fpage>16</fpage><lpage>20</lpage><pub-id pub-id-type="pmid">7505195</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brass</surname><given-names>N</given-names></name><name><surname>R&#x000e1;cz</surname><given-names>A</given-names></name><name><surname>Bauer</surname><given-names>C</given-names></name><name><surname>Heckel</surname><given-names>D</given-names></name><name><surname>Sybrecht</surname><given-names>G</given-names></name><name><surname>Meese</surname><given-names>E</given-names></name></person-group><article-title>Role of amplified genes in the production of autoantibodies</article-title><source>Blood</source><year>1999</year><volume>93</volume><fpage>2158</fpage><lpage>2166</lpage><pub-id pub-id-type="pmid">10090922</pub-id></citation></ref><ref id="B9"><cit