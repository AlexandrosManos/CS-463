article-title>The Rieske protein: A case study on the pitfalls of multiple sequence alignments and phylogenetic reconstruction</article-title><source>Mol Biol Evol</source><year>2006</year><volume>23</volume><fpage>1180</fpage><lpage>1191</lpage><pub-id pub-id-type="doi">10.1093/molbev/msk010</pub-id><pub-id pub-id-type="pmid">16569761</pub-id></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><name><surname>Ahmann</surname><given-names>D</given-names></name><name><surname>Roberts</surname><given-names>AL</given-names></name><name><surname>Krumholz</surname><given-names>LR</given-names></name><name><surname>Morel</surname><given-names>FM</given-names></name><article-title>Microbe grows by reducing arsenic</article-title><source>Nature</source><year>1994</year><volume>371</volume><fpage>750</fpage><pub-id pub-id-type="doi">10.1038/371750a0</pub-id><pub-id pub-id-type="pmid">7935832</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><name><surname>Laverman</surname><given-names>AM</given-names></name><name><surname>Blum</surname><given-names>JS</given-names></name><name><surname>Schaefer</surname><given-names>JK</given-names></name><name><surname>Phillips</surname><given-names>E</given-names></name><name><surname>Lovley</surname><given-names>DR</given-names></name><name><surname>Oremland</surname><given-names>RS</given-names></name><article-title>Growth of strain SES-3 with arsenate and other diverse electron acceptors</article-title><source>Appl Environ Microbiol</source><year>1995</year><volume>61</volume><fpage>3556</fpage><lpage>3561</lpage><pub-id pub-id-type="pmid">16535143</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Saltikov</surname><given-names>CW</given-names></name><name><surname>Newman</surname><given-names>DK</given-names></name><article-title>Genetic identification of a respiratory arsenate reductase</article-title><source>Proc Nat