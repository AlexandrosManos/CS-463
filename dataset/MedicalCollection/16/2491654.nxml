article-title><source>South Med J</source><year>1991</year><volume>84</volume><fpage>929</fpage><lpage>930</lpage><pub-id pub-id-type="pmid">2068645</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fraser-Bell</surname><given-names>S</given-names></name><name><surname>Capon</surname><given-names>M</given-names></name></person-group><article-title>Talc retinopathy</article-title><source>Clin Experiment Ophthalmol</source><year>2002</year><volume>30</volume><fpage>432</fpage><lpage>433</lpage><pub-id pub-id-type="pmid">12427236</pub-id><pub-id pub-id-type="doi">10.1046/j.1442-9071.2002.00575.x</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shustin</surname><given-names>L</given-names></name><name><surname>Haviv</surname><given-names>YS</given-names></name><name><surname>Weinberger</surname><given-names>M</given-names></name><name><surname>Safadi</surname><given-names>R</given-names></name></person-group><article-title>Talc granuloma of the uterus</article-title><source>Eur J Med Res</source><year>1995</year><volume>16</volume><fpage>49</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">9392693</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Molos</surname><given-names>MA</given-names></name><name><surname>Litton</surname><given-names>N</given-names></name><name><surname>Schubert</surname><given-names>TT</given-names></name></person-group><article-title>Talc liver</article-title><source>J Clin Gastroenterol</source><year>1987</year><volume>9</volume><fpage>198</fpage><lpage>203</lpage><pub-id pub-id-type="pmid">3571894</pub-id><pub-id pub-id-type="doi">10.1097/00004836-198704000-00018</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Genereux</surname><given-names>GP</given-names></name><name><surname>Emson</surname><given-names>HE</given-names></name></person-group><article-title>Talc granulomatosis and angiothrombotic pulmonary hypertension in drug addicts</article-title><source>J Can Assoc Radiol</source><year>1974</year><volume>25</volume><fpage>87</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">4854601</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ward</surname><given-names>S</given-names></name><name><surname>Heyneman</surname><given-names>LE</given-names></name><name><surname>Reittner</surname><given-names>P</given-names></name><etal></etal></person-group><article-title>Talcosis associated with IV abuse of oral medications: CT findings</article-title><source> AJR Am J Roentgenol</source><year>2000</year><volume>174</volume><fpage>789</fpage><lpage>793</lpage><comment>&#x0003c;Author: Please provide names of all authors rather than using 'et al.' in [11]&#x0003e;</comment><pub-id pub-id-type="pmid">10701626</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nan</surname><given-names>DN</given-names></name><name><surname>Fernandez-Ayala</surname><given-names>M</given-names></name><name><surname>Iglesias</surname><given-names>L</given-names></name></person-group><article-title>Talc granulomatosis: a differential diagnosis of interstitial lung disease in HIV patients</article-title><source>Chest</source><year>2000</year><volume>118</volume><fpage>258</fpage><lpage>260</lpage><pub-id pub-id-type="pmid">10893392</pub-id><pub-id pub-id-type="doi">10.1378/chest.118.1.258</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>RH</given-names></name><name><surname>Graf</surname><given-names>MS</given-names></name><name><surname>Silverman</surname><given-names>JF</given-names></name></person-group><article-title>Successful management of drug-induced talc granulomatosis with corticosteroids</article-title><source>Chest</source><year>1978</year><volume>73</volume><fpage>552</fpage><lpage>554</lpage><pub-id pub-id-type="pmid">630980</pub-id><pub-id pub-id-type="doi">10.1378/chest.73.4.552</pub-id></citation></ref></ref-list></back></article>