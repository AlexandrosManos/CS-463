>32</volume><fpage>1005</fpage><lpage>1011</lpage><pub-id pub-id-type="pmid">11283404</pub-id></citation></ref><ref id="pone.0002934-Barbash1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barbash</surname><given-names>IM</given-names></name><name><surname>Chouraqui</surname><given-names>P</given-names></name><name><surname>Baron</surname><given-names>J</given-names></name><name><surname>Feinberg</surname><given-names>MS</given-names></name><name><surname>Etzion</surname><given-names>S</given-names></name><etal/></person-group><year>2003</year><article-title>Systemic delivery of bone marrow-derived mesenchymal stem cells to the infarcted myocardium: feasibility, cell migration, and body distribution.</article-title><source>Circulation</source><volume>108</volume><fpage>863</fpage><lpage>868</lpage><pub-id pub-id-type="pmid">12900340</pub-id></citation></ref><ref id="pone.0002934-Ortiz1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ortiz</surname><given-names>LA</given-names></name><name><surname>Gambelli</surname><given-names>F</given-names></name><name><surname>McBride</surname><given-names>C</given-names></name><name><surname>Gaupp</surname><given-names>D</given-names></name><name><surname>Baddoo</surname><given-names>M</given-names></name><etal/></person-group><year>2003</year><article-title>Mesenchymal stem cell engraftment in lung is enhanced in response to bleomycin exposure and ameliorates its fibrotic effects.</article-title><source>Proc Natl Acad Sci U S A</source><volume>100</volume><fpage>8407</fpage><lpage>8411</lpage><pub-id pub-id-type="pmid">12815096</pub-id></citation></ref><ref id="pone.0002934-Campbell1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Campbell</surname><given-names>JJ</given-names></name><name><surname>Butcher</surname><given-names>EC</given-names></nam