bel><citation citation-type="journal">Suzuki, K., Shijuuku, T., Fukamachi, T., Zaunders, J., Guillemin, G., Cooper, D., and Kelleher, A. (<year>2005</year>) <source>J. RNAi Gene Silencing</source> <volume>1</volume> <fpage>66</fpage>-78</citation></ref><ref id="ref13"><label>13</label><citation citation-type="journal">Janowski, B. A., Kaihatsu, K., Huffman, K. E., Schwartz, J. C., Ram, R., Hardy, D., Mendelson, C. R., and Corey, D. R. (<year>2005</year>) <source>Nat. Chem. Biol.</source> <volume>1</volume> <fpage>210</fpage>-215<pub-id pub-id-type="pmid">16408037</pub-id></citation></ref><ref id="N0x1d22cb0N0x36aad58"><label>14</label><citation citation-type="journal">Ting, A. H., Schuebel, K. E., Herman, J. G., and Baylin, S. B. (<year>2005</year>) <source>Nat. Genet.</source> <volume>37</volume> <fpage>906</fpage>-910<pub-id pub-id-type="pmid">16025112</pub-id></citation></ref><ref id="N0x1d22cb0N0x36aed40"><label>15</label><citation citation-type="journal">Zhang, M. X., Ou, H., Shen, Y. H., Wang, J., Wang, J., Coselli, J., and Wang, X. L. (<year>2005</year>) <source>Proc. Natl. Acad. Sci. U. S. A.</source> <volume>102</volume> <fpage>16967</fpage>-16972<pub-id pub-id-type="pmid">16284254</pub-id></citation></ref><ref id="ref16"><label>16</label><citation citation-type="journal">Janowski, B. A., Huffman, K. E., Schwartz, J. C., Ram, R., Hardy, D., Shames, D. S., Minna, J. D., and Corey, D. R. (<year>2005</year>) <source>Nat. Chem. Biol.</source> <volume>1</volume> <fpage>216</fpage>-222<pub-id pub-id-type="pmid">16408038</pub-id></citation></ref><ref id="ref17"><label>17</label><citation citation-type="journal">Weinberg, M. S., Villeneuve, L. M., Ehsani, A., Amarzguioui, M., Aagaard, L., Chen, Z. X., Riggs, A. D., Rossi, J. J., and Morris, K. V. (<year>2006</year>) <source>RNA (N. Y.)</source> <volume>12</volume> <fpage>256</fpage>-262</citation></ref><ref id="ref18"><label>18</label><citation citation-type="journal">Janowski, B. A., Huffman, K. E., Schwartz, J. C., Ram, R., Nordsell, R., Shames, D. S., Minna, J. D., and Corey, D. R. (<year>2006</year>) <source>Nat. Struct. Mol. Biol.</source> <volume>13</volume> <fpage>787</fpage>-792<pub-id pub-id-type="pmid">16936728</pub-id></citation></ref><ref id="ref19"><label>19</label><citation citation-type="journal">Kim, D. H., Villeneuve, L. M., Morris, K. V., and Rossi, J. J. (<year>2006</year>) <source>Nat. Struct. Mol. Biol.</source> <volume>13</volume> <fpage>793</fpage>-797<pub-id pub-id-type="pmid">16936726</pub-id></citation></ref><ref id="N0x1d22cb0N0x36af8c8"><label>20</label><citation citation-type="journal">Pulukuri, S. M., and Rao, J. S. (<year>2007</year>) <source>Cancer Res.</source> <volume>67</volume> <fpage>6637</fpage>-6646<pub-id pub-id-type="pmid">17638874</pub-id></citation></ref><ref id="ref21"><label>21</label><citation citation-type="journal">Wang, X., Feng, Y., Pan, L., Wang, Y., Xu, X., Lu, J., and Huang, B. (<year>2007</year>) <source>Mol. Cell. Biochem.</source> <volume>301</volume> <fpage>259</fpage>-266<pub-id pub-id-type="pmid">17333389</pub-id></citation></ref><ref id="ref22"><label>22</label><citation citation-type="journal">Weinberg, M. S., Barichievy, S., Schaffer, L., Han, J., and Morris, K. V. (<year>2007</year>) <source>Nucleic Acids Res.</source> <volume>35</volume> <fpage>1</fpage>-10<pub-id pub-id-type="pmid">16920744</pub-id></citation></ref><ref id="ref23"><label>23</label><citation citation-type="journal">Kim, J. W., Zhang, Y. H., Zern, M. A., Rossi, J. J., and Wu, J. (<year>2007</year>) <source>Biochem. Biophys. Res. Commun.</source> <volume>359</volume> <fpage>292</fpage>-297<pub-id pub-id-type="pmid">17533113</pub-id></citation></ref><ref id="ref24"><label>24</label><citation citation-type="journal">Noma, K., Sugiyama, T., Cam, H., Verdel, A., Zofall, M., Jia, S., Moazed, D., and Grewal, S. I. (<year>2004</year>) <source>Nat. Genet.</source> <volume>36</volume> <fpage>1174</fpage>-1180<pub-id pub-id-type="pmid">15475954</pub-id></cit