gn="left" rowspan="1" colspan="1">K330010C07</td><td align="left" rowspan="1" colspan="1">1.20E-3</td><td align="left" rowspan="1" colspan="1">1.44</td></tr><tr><td align="left" rowspan="1" colspan="1">3110035E14Rik</td><td align="left" rowspan="1" colspan="1">K230010N04</td><td align="left" rowspan="1" colspan="1">2.01E-2</td><td align="left" rowspan="1" colspan="1">&#x02212;1.82</td><td align="left" rowspan="1" colspan="1">Vamp1</td><td align="left" rowspan="1" colspan="1">K230001K20</td><td align="left" rowspan="1" colspan="1">2.35E-3</td><td align="left" rowspan="1" colspan="1">1.43</td></tr><tr><td align="left" rowspan="1" colspan="1">H2-DMa</td><td align="left" rowspan="1" colspan="1">K230007M04</td><td align="left" rowspan="1" colspan="1">3.35E-4</td><td align="left" rowspan="1" colspan="1">&#x02212;1.78</td><td align="left" rowspan="1" colspan="1">9530058B02Rik</td><td align="left" rowspan="1" colspan="1">K230010H11</td><td align="left" rowspan="1" colspan="1">6.03E-3</td><td align="left" rowspan="1" colspan="1">1.40</td></tr><tr><td align="left" rowspan="1" colspan="1">Hn1</td><td align="left" rowspan="1" colspan="1">K230005H22</td><td align="left" rowspan="1" colspan="1">1.68E-4</td><td align="left" rowspan="1" colspan="1">&#x02212;1.62</td><td align="left" rowspan="1" colspan="1">Cox6c</td><td align="left" rowspan="1" colspan="1">K230006O16</td><td align="left" rowspan="1" colspan="1">8.83E-3</td><td align="left" rowspan="1" colspan="1">1.37</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">K230011F01</td><td align="left" rowspan="1" colspan="1">1.23E-2</td><td align="left" rowspan="1" colspan="1">&#x02212;1.61</td><td align="left" rowspan="1" colspan="1">1810012P15Rik</td><td align="left" rowspan="1" colspan="1">K230027M24</td><td align="left" rowspan="1" colspan="1">1.26E-2</td><td align="left" rowspan="1" colspan="1">1.37</td></tr><tr><td align="left" rowspan="1" colspan="1">Ngef</td><td align="left" rowspan="1" colspan="1">K330017A06</td><td align="left" rowspan="1" colspan="1">3.67E-3</td><td align="left" rowspan="1" colspan="1">&#x02212;1.51</td><td align="left" rowspan="1" colspan="1">Stac2</td><td align="left" rowspan="1" colspan="1">K230027M01</td><td align="left" rowspan="1" colspan="1">1.92E-3</td><td align="left" rowspan="1" colspan="1">1.34</td></tr><tr><td align="left" rowspan="1" colspan="1">Gap43</td><td align="left" rowspan="1" colspan="1">K230009L16</td><td align="left" rowspan="1" colspan="1">3.03E-2</td><td align="left" rowspan="1" colspan="1">&#x02212;1.44</td><td align="left" rowspan="1" colspan="1">AI836003</td><td align="left" rowspan="1" colspan="1">K230306I16</td><td align="left" rowspan="1" colspan="1">2.78E-6</td><td align="left" rowspan="1" colspan="1">1.33</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">K230302E22</td><td align="left" rowspan="1" colspan="1">2.48E-4</td><td align="left" rowspan="1" colspan="1">&#x02212;1.42</td><td align="left" rowspan="1" colspan="1">Ccne1</td><td align="left" rowspan="1" colspan="1">K230044G09</td><td align="left" rowspan="1" colspan="1">1.36E-3</td><td align="left" rowspan="1" colspan="1">1.31</td></tr><tr><td align="left" rowspan="1" colspan="1">Fbxl2</td><td align="left" rowspan="1" colspan="1">K230024L20</td><td align="left" rowspan="1" colspan="1">5.40E-3</td><td align="left" rowspan="1" colspan="1">&#x02212;1.42</td><td align="left" rowspan="1" colspan="1">Pdlim3</td><td align="left" rowspan="1" colspan="1">K230306A09</td><td align="left" rowspan="1" colspan="1">6.48E-3</td><td align="left" rowspan="1" colspan="1">1.31</td></tr><tr><td align="left" rowspan="1" colspan="1">Pcsk2</td><td align="left" rowspan="1" colspan="1">K230002M17</td><td align="left" rowspan="1" colspan="1">1.59E-3</td><td align="left" rowspan="1" colspan="1">&#x02212;1.37</td><td align="left" rowspan="1" colspan="1">Atp1b1</td><td align="left" rowspan="1" colspan="1">K230006G24</td><td align="left" rowspan="1" colspan="1">1.56E-2</td><td align="left" rowspan="1" colspan="1">1.29</td></tr><tr><td align="left" rowspan="1" colspan="1">Ctsb</td><td align="left" rowspan="1" colspan="1">K230008F16</td><td align="left" rowspan="1" colspan="1">1.35E-2</td><td align="left" rowspan="1" colspan="1">&#x02212;1.37</td><td align="left" rowspan="1" colspan="1">2610205H19Rik</td><td align="left" rowspan="1" colspan="1">K230306A08</td><td align="left" rowspan="1" colspan="1">7.83E-6</td><td align="left" rowspan="1" colspan="1">1.26</td></tr></tbody></table></table-wrap><table-wrap id="pone-0003012-t004" position="float"><object-id pub-id-type="doi">10.1371/journal.pone.0003012.t004</object-id><label>Table 4</label><caption><title>Differential expression of the Atp5, Cox6 or Nduf family genes.</title></caption><graphic id="pone-0003012-t004-4" xlink:href="pone.0003012.t004"/><table frame="hsides" rules="groups" alternate-form-of="pone-0003012-t004-4"><colgroup span="1"><col align="left" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/></colgroup><thead><tr><td align="left" rowspan="1" colspan="1">CLONE_ID</td><td align="left" rowspan="1" colspan="1">SYMBOL</td><td align="left" rowspan="1" colspan="1">p</td><td align="left" rowspan="1" colspan="1">M</td></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">K230031N16</td><td align="left" rowspan="1" colspan="1">Ndufa11</td><td align="left" rowspan="1" colspan="1">7.69E-3</td><td align="left" rowspan="1" colspan="1">1.61</td></tr><tr><td align="left" rowspan="1" colspan="1">K230002F10</td><td align="left" rowspan="1" colspan="1">Cox6c</td><td align="left" rowspan="1" colspan="1">4.77E-3</td><td align="left" rowspan="1" colspan="1">1.46</td></tr><tr><td align="left" rowspan="1" colspan="1">K330002E13</td><td align="left" rowspan="1" colspan="1">Atp5g3</td><td align="left" rowspan="1" colspan="1">3.25E-4</td><td align="left" rowspan="1" colspan="1">1.44<