 id="CR5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bullerjahn</surname><given-names>A</given-names></name><name><surname>Pfl&#x000fc;ger</surname><given-names>H-J</given-names></name></person-group><article-title>The distribution of putative nitric oxide releasing neurones in the locust abdominal nervous system: a comparison of NADPHd histochemistry and NOS-immunocytochemistry</article-title><source>Zoology</source><year>2003</year><volume>106</volume><fpage>3</fpage><lpage>17</lpage><pub-id pub-id-type="doi">10.1078/0944-2006-00084</pub-id></citation><citation citation-type="display-unstructured">Bullerjahn A, Pfl&#x000fc;ger H-J (2003) The distribution of putative nitric oxide releasing neurones in the locust abdominal nervous system: a comparison of NADPHd histochemistry and NOS-immunocytochemistry. Zoology 106:3&#x02013;17 <pub-id pub-id-type="pmid">16351887</pub-id></citation></ref><ref id="CR6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bullerjahn</surname><given-names>A</given-names></name><name><surname>Mentel</surname><given-names>T</given-names></name><name><surname>Pfl&#x000fc;ger</surname><given-names>H-J</given-names></name><name><surname>Stevenson</surname><given-names>PA</given-names></name></person-group><article-title>Nitric oxide: a co-modulator of efferent peptidergic neurosecretory cells including a unique octopaminergic neurone innervating locust heart</article-title><source>Cell Tissue Res</source><year>2006</year><volume>325</volume><fpage>345</fpage><lpage>360</lpage><pub-id pub-id-type="doi">10.1007/s00441-006-0188-2</pub-id></citation><citation citation-type="display-unstructured">Bullerjahn A, Mentel T, Pfl&#x000fc;ger H-J, Stevenson PA (2006) Nitric oxide: a co-modulator of efferent peptidergic neurosecretory cells including a unique octopaminergic neurone innervating locust heart. Cell Tissue Res 325:345&#x02013;360 <pub-id pub-id-type="pmid">