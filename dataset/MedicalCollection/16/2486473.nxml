" colspan="1">AT1G19640</td><td align="char" char="." rowspan="1" colspan="1">0.10&#x000b1;0.26</td><td align="char" char="." rowspan="1" colspan="1">0.81&#x000b1;0.26</td><td align="char" char="." rowspan="1" colspan="1"><bold>1.59&#x000b1;0.26</bold></td><td align="char" char="." rowspan="1" colspan="1">0.47&#x000b1;0.26</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.09&#x000b1;0.26</td></tr><tr><td rowspan="1" colspan="1">C20003C11</td><td rowspan="1" colspan="1">[<italic>Medicago truncatula</italic>] (ABO83264)</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td align="char" char="." rowspan="1" colspan="1">0.18&#x000b1;0.20</td><td align="char" char="." rowspan="1" colspan="1">0.83&#x000b1;0.20</td><td align="char" char="." rowspan="1" colspan="1"><bold>1.44&#x000b1;0.20</bold></td><td align="char" char="." rowspan="1" colspan="1">0.56&#x000b1;0.20</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.02&#x000b1;0.20</td></tr><tr><td rowspan="1" colspan="1">C07002D05</td><td rowspan="1" colspan="1">TSB1 (tryptophan synthase &#x003b2;-subunit) [<italic>Arabidopsis thaliana</italic>] (NP_200292)</td><td rowspan="1" colspan="1">0.0</td><td rowspan="1" colspan="1">AT5G54810</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.01&#x000b1;0.22</td><td align="char" char="." rowspan="1" colspan="1">0.51&#x000b1;0.22</td><td align="char" char="." rowspan="1" colspan="1">0.23&#x000b1;0.22</td><td align="char" char="." rowspan="1" colspan="1">0.04&#x000b1;0.22</td><td align="char" char="." rowspan="1" colspan="1"><bold>&#x02212;1.07&#x000b1;0.22</bold></td></tr><tr><td rowspan="1" colspan="1">C02012B01</td><td rowspan="1" colspan="1">Hypothetical protein (auxin-independent growth promoter) [<italic>Vitis vinifera</italic>] (CAN73548)</td><td rowspan="1" colspan="1">3e-149</td><td rowspan="1" colspan="1">AT5G15740</td><td align="char" char="." rowspan="1" colspan="1">0.22&#x000b1;0.20</td><td align="char" char="." rowspan="1" colspan="1">0.35&#x000b1;0.20</td><td align="char" char="." rowspan="1" colspan="1">0.23&#x000b1;0.20</td><td align="char" char="." rowspan="1" colspan="1"><bold>1.34&#x000b1;0.20</bold></td><td align="char" char="." rowspan="1" colspan="1"><bold>1.96&#x000b1;0.20</bold></td></tr><tr><td rowspan="1" colspan="1">C02013E07</td><td rowspan="1" colspan="1">Putative auxin-repressed/dormancy-associated protein [<italic>Citrus</italic> cv. Shiranuhi] (ABL67651)</td><td rowspan="1" colspan="1">6e-51</td><td rowspan="1" colspan="1">AT1G28330</td><td align="char" char="." rowspan="1" colspan="1">0.06&#x000b1;0.33</td><td align="char" char="." rowspan="1" colspan="1">0.45&#x000b1;0.33</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.69&#x000b1;0.33</td><td align="char" char="." rowspan="1" colspan="1"><bold>&#x02212;1.38&#x000b1;0.33</bold></td><td align="char" char="." rowspan="1" colspan="1"><bold>&#x02212;2.77&#x000b1;0.33</bold></td></tr><tr><td rowspan="1" colspan="1">C03003A11</td><td rowspan="1" colspan="1">Auxin response factor-like protein [<italic>Mangifera indica</italic>] (AAP06759)</td><td rowspan="1" colspan="1">0.0</td><td rowspan="1" colspan="1">AT5G62000</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.21&#x000b1;0.19</td><td align="char" char="." rowspan="1" colspan="1">0.03&#x000b1;0.19</td><td align="char" char="." rowspan="1" colspan="1">0.31&#x000b1;0.19</td><td align="char" char="." rowspan="1" colspan="1"><bold>&#x02212;1.03&#x000b1;0.19</bold></td><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.40&#x000b1;0.19</td></tr><tr><td rowspan="1" colspan="1">C04015B03</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.28&#x000b1;0.17</td><td align="char" char="." rowspan="1" colspan="1">0.18&#x000b1;0.17</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.03&#x000b1;0.17</td><td align="char" char="." rowspan="1" colspan="1">0.04&#x000b1;0.17</td><td align="char" char="." rowspan="1" colspan="1"><bold>&#x02212;1.03&#x000b1;0.17</bold></td></tr><tr><td rowspan="1" colspan="1">C08003D01</td><td rowspan="1" colspan="1">Gibberellin 2-oxidase 1 [<italic>Lactuca sativa</italic>] (BAB12442)</td><td rowspan="1" colspan="1">1e-47</td><td rowspan="1" colspan="1">AT1G30040</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.01&#x000b1;0.16</td><td align="char" char="." rowspan="1" colspan="1">0.28&#x000b1;0.16</td><td align="char" char="." rowspan="1" colspan="1">0.22&#x000b1;0.16</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.05&#x000b1;0.16</td><td align="char" char="." rowspan="1" colspan="1"><bold>&#x02212;1.21&#x000b1;0.16</bold></td></tr><tr><td rowspan="1" colspan="1">C08005F06</td><td rowspan="1" colspan="1">Gibberellin regulated protein [<italic>Medicago truncatula</italic>] (ABN08074)</td><td rowspan="1" colspan="1">2e-24</td><td rowspan="1" colspan="1">AT3G02885</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.07&#x000b1;0.23</td><td align="char" char="." rowspan="1" colspan="1">0.60&#x000b1;0.23</td><td align="char" char="." rowspan="1" colspan="1">0.46&#x000b1;0.23</td><td align="char" char="." rowspan="1" colspan="1"><bold>2.83&#x000b1;0.23</bold></td><td align="char" char="." rowspan="1" colspan="1"><bold>3.62&#x000b1;0.23</bold></td></tr><tr><td rowspan="1" colspan="1">C07001A05</td><td rowspan="1" colspan="1"><italic>S</italic>-adenosyl-<sc>L</sc>-methionine synthetase [<italic>Petunia&#x000d7;hybrida</italic>] (AF170798)</td><td rowspan="1" colspan="1">0.0</td><td rowspan="1" colspan="1">AT1G02500</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.15&#x000b1;0.17</td><td align="char" char="." rowspan="1" colspan="1">0.11&#x000b1;0.19</td><td align="char" char="." rowspan="1" colspan="1">0.08&#x000b1;0.17</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.09&#x000b1;0.17</td><td align="char" char="." rowspan="1" colspan="1"><bold>&#x02212;1.11&#x000b1;0.17</bold></td></tr><tr><td rowspan="1" colspan="1">C08014A07</td><td rowspan="1" colspan="1">ACC synthase [<italic>Citrus sinensis</italic>] (CAB60831)</td><td rowspan="1" colspan="1">0.0</td><td rowspan="1" colspan="1">AT3G61510</td><td align="char" char="." rowspan="1" colspan="1">0.17&#x000b1;0.15</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.08&#x000b1;0.15</td><td align="char" char="." rowspan="1" colspan="1">0.28&#x000b1;0.15</td><td align="char" char="." rowspan="1" colspan="1"><bold>&#x02212;1.06&#x000b1;0.15</bold></td><td align="char" char="." rowspan="1" colspan="1">0.19&#x000b1;0.15</td></tr><tr><td rowspan="1" colspan="1">C04002H01</td><td rowspan="1" colspan="1">Ethylene response factor [<italic>Manihot esculenta</italic>] (AAX84670)</td><td rowspan="1" colspan="1">4e-122</td><td rowspan="1" colspan="1">AT3G14230</td><td align="char" char="." rowspan="1" colspan="1">0.22&#x000b1;0.16</td><td align="char" char="." rowspan="1" colspan="1">0.72&#x000b1;0.16</td><td align="char" char="." rowspan="1" colspan="1">0.50&#x000b1;0.16</td><td align="char" char="." rowspan="1" colspan="1">0.49&#x000b1;0.16</td><td align="char" char="." rowspan="1" colspan="1"><bold>1.10&#x000b1;0.16</bold></td></tr><tr><td colspan="9" rowspan="1"><bold>Transport</bold></td></tr><tr><td rowspan="1" colspan="1">C01005E02</td><td rowspan="1" colspan="1">TGF-beta receptor, type I/II extracellular region [<italic>Medicago truncatula</italic>] (ABD32293)</td><td rowspan="1" colspan="1">2e-79</td><td rowspan="1" colspan="1">AT1G52190</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.20&#x000b1;0.18</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;0.06&#x000b1;0.16</td><td align="char" char="." rowspan="1" colspan="1">0.10&#x000b1;0.16</td><td align="char" char="." rowspan="1" colspan="1"><bold>1.09&#x000b1;0.16</bold></td><td align="char" char="." rowspan="1" cols