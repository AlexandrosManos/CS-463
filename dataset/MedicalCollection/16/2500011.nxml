rnal"><person-group person-group-type="author"><name><surname>Tsoukas</surname><given-names>H</given-names></name><name><surname>Vladimirou</surname><given-names>E</given-names></name></person-group><article-title>What is organizational knowledge?</article-title><source>J Manage Stud</source><year>2001</year><volume>38</volume><fpage>973</fpage><lpage>993</lpage><pub-id pub-id-type="doi">10.1111/1467-6486.00268</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hadar</surname><given-names>L</given-names></name><name><surname>Fischer</surname><given-names>I</given-names></name></person-group><article-title>Giving advice under uncertainty: What you do, what you should do, and what others think you do</article-title><source>J Econ Psychol</source><comment></comment><pub-id pub-id-type="doi">10.1016/j.joep.2007.12.007</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Malterud</surname><given-names>K</given-names></name></person-group><article-title>Qualitative research: standards, challenges, and guidelines</article-title><source>Lancet</source><year>2001</year><volume>358</volume><fpage>483</fpage><lpage>488</lpage><pub-id pub-id-type="pmid">11513933</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(01)05627-6</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnson</surname><given-names>RB</given-names></name><name><surname>Onwuegbuzie</surname><given-names>AJ</given-names></name><name><surname>Turner</surname><given-names>LA</given-names></name></person-group><article-title>Toward a definition of mixed methods research</article-title><source>J Mixed Methods Res</source><year>2007</year><volume>1</volume><fpage>112</fpage><lpage>133</lpage><pub-id pub-id-type="doi">10.1177/1558689806298224</pub-id></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Tashakkori</surname><given-names>A</given-names></name><name><surname>Teddlie</surname><given-names>C</given-names></name></person-group><source>Mixed Methodology: Combining Qualitative and Quantitative Approaches</source><year>1998</year><publisher-name>London: Sage Publications</publisher-name></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Caracelli</surname><given-names>VJ</given-names></name><name><surname>Greene</surname><given-names>JC</given-names></name></person-group><article-title>Crafting mixed-method evaluation designs</article-title><source>New Directions for Evaluation</source><year>1997</year><volume>74</volume><fpage>19</fpage><lpage>32</lpage></citation></ref><ref id="B26"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Denzin</surname><given-names>NK</given-names></name></person-group><source>The Research Act: A Theoretical Introduction to Sociological Methods</source><year>1978</year><publisher-name>New York: Prentice Hall</publisher-name></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vaarst</surname><given-names>M</given-names></name><name><surname>Bennedsgaard</surname><given-names>TW</given-names></name><name><surname>Klaas</surname><given-names>I</given-names></name><name><surname>Nissen</surname><given-names>TB</given-names></name><name><surname>Thamsborg</surname><given-names>SM</given-names></name><name><surname>&#x000d8;</surname><given-names>S</given-names></name></person-group><article-title>Development and daily management of an explicit strategy of non-use of antimicrobial drugs in twelve Danish organic dairy herds</article-title><source>J Dairy Sci</source><year>2006</year><volume>89</volume><fpage>1842</fpage><lpage>1853</lpage><pub-id pub-id-type="pmid">16606756</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Greene</surname><given-names>JC</given-names></name><name><surname>Benjamin</surname><given-names>L</given-names></name><name><surname>Goodyear</surname><given-names>L</given-names></name></person-group><article-title>The merits of mixing methods in evaluation</article-title><source>Evaluation</source><year>2001</year><volume>7</volume><fpage>25</fpage><lpage>44</lpage><pub-id pub-id-type="doi">10.1177/13563890122209504</pub-id></citation></ref><ref id="B29"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Calhoun</surname><given-names>MA</given-names></name><name><surname>Starbuck</surname><given-names>WH</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Easterby M, Lyles MA</surname></name></person-group><article-title>Barriers to creating knowledge</article-title><source>Handbook of Organizational Learning and Knowledge Management</source><year>2003</year><publisher-name>Blackwell Publishing</publisher-name><fpage>473</fpage><lpage>492</lpage></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maybery</surname><given-names>D</given-names></name><name><surname>Crase</surname><given-names>L</given-names></name><name><surname>Gullifer</surname><given-names>C</given-names></name></person-group><article-title>Categorising farming values as economic, conservation and lifestyle</article-title><source>J Econ Psychol</source><year>2005</year><volume>26</volume><fpage>59</fpage><lpage>72</lpage><pub-id pub-id-type="doi">10.1016/j.joep.2003.10.001</pub-id></citation></ref><ref id="B31"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wallace</surname><given-names>W</given-names></name></person-group><source>The Logic of Science in Sociology</source><year>1971</year><publisher-name>Chicago: Aldine De Gruyter</publisher-name></citation></ref></ref-list></back></article>