><given-names>JQ</given-names></name></person-group><article-title>A comparison of international references for the assessement of chil and adolescent owerweight and obesity in different populations</article-title><source>Eur J Clin Nutr</source><year>2002</year><volume>56</volume><fpage>973</fpage><lpage>982</lpage><pub-id pub-id-type="pmid">12373618</pub-id><pub-id pub-id-type="doi">10.1038/sj.ejcn.1601415</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Aranceta-Bartrina</surname><given-names>J</given-names></name><name><surname>Serra-Maj&#x000e9;n</surname><given-names>Ll</given-names></name><name><surname>Foz-Sala</surname><given-names>M</given-names></name><name><surname>Moreno-Esteban</surname><given-names>B</given-names></name><collab>y grupo colaborativo SEEDO</collab></person-group><article-title>Prevalencia de obesidad en Espa&#x000f1;a</article-title><source>Med Clin (Bar)</source><year>2005</year><volume>125</volume><fpage>460</fpage><lpage>466</lpage><pub-id pub-id-type="doi">10.1157/13079612</pub-id></citation></ref></ref-list></back></article>