n-names>N</given-names></name><name><surname>Goldberg</surname><given-names>A</given-names></name></person-group><article-title>Proteasomes and their associated ATPases: a destructive combination</article-title><source>J Struct Biol</source><volume>156</volume><fpage>72</fpage><lpage>83</lpage><year>2006</year><pub-id pub-id-type="pmid">16919475</pub-id></element-citation></ref><ref id="R15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Glickman</surname><given-names>MH</given-names></name><etal/></person-group><article-title>A subcomplex of the proteasome regulatory particle required for ubiquitin-conjugate degradation and related to the COP9/Signalosome and eIF3</article-title><source>Cell</source><volume>94</volume><fpage>615</fpage><lpage>623</lpage><year>1998</year><pub-id pub-id-type="pmid">9741626</pub-id></element-citation></ref><ref id="R16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>C-W</given-names></name></person-group><article-title>ATP binding and ATP hydrolysis play distinct roles in the function of 26S proteasome</article-title><source>Mol Cell</source><volume>24</volume><fpage>39</fpage><lpage>50</lpage><year>2006</year><pub-id pub-id-type="pmid">17018291</pub-id></element-citation></ref><ref id="R17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>K&#x000f6;hler</surname><given-names>A</given-names></name><etal/></person-group><article-title>The axial channel of the proteasome core particle is gated by the Rpt2 ATPase and controls both substrate entry and product release</article-title><source>Mol Cell</source><volume>7</volume><fpage>1143</fpage><lpage>1152</lpage><year>2001</year><pub-id pub-id-type="pmid">11430818</pub-id></element-citation></ref><ref id="R18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>DM</given-names></name><etal/></person-group><article-title>Docking of the proteasomal ATPases&#x02019; carboxyl termini in the 20S proteasome&#x02019;s &#x003b1; ring opens the gate for substrate entry</article-title><source>Mol Cell</source><volume>27</volume><fpage>731</fpage><lpage>744</lpage><year>2007</year><pub-id pub-id-type="pmid">17803938</pub-id></element-citation></ref><ref id="R19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kajava</surname><given-names>AV</given-names></name><name><surname>Gorbea</surname><given-names>C</given-names></name><name><surname>Ortega</surname><given-names>J</given-names></name><name><surname>Rechsteiner</surname><given-names>M</given-names></name><name><surname>Steven</surname><given-names>AC</given-names></name></person-group><article-title>New HEAT-like repeat motifs in proteins regulating proteasome structure and function</article-title><source>J Struct Biol</source><volume>146</volume><fpage>425</fpage><lpage>430</lpage><year>2004</year><pub-id pub-id-type="pmid">15099583</pub-id></element-citation></ref><ref id="R20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kajava</surname><given-names>AV</given-names></name></person-group><article-title>What curves &#x003b1;-solenoids? Evidence for an &#x003b1;-helical toroid structure of Rpn1 and Rpn2 proteins of the 26S proteasome</article-title><source>J Biol Chem</source><volume>277</volume><fpage>49791</fpage><lpage>49798</lpage><year>2002</year><pub-id pub-id-type="pmid">12270919</pub-id></element-citation></ref><ref id="R21"><label>21</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ortega</surname><given-names>J</given-names></name><etal/></person-group><article-title>The axial channel of the 20 S proteasome opens upon binding of the PA200 activator</article-title><source>J Mol Biol</source><volume>346</volume><fpage>1221</fpage><lpage>1227</lpage><year>2005</year><pub-id pub-id-type="pmid">15713476</pub-id></element-citation></ref><ref id="R22"><label>22</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>X</given-names></name><name><surname>Barton</surname><given-names>LF</given-names></name><name><surname>Chi</surname><given-names>Y</given-names></name><name><surname>Clurman</surname><given-names>BE</given-names></name><name><surname>Roberts</surname><given-names>JM</given-names></name></person-group><article-title>Ubiquitin-independent degradation of cell-cycle inhibitors by the REG&#x003b3; proteasome</article-title><source>Mol Cell</source><volume>26</volume><fpage>843</fpage><lpage>852</lpage><year>2007</year><pub-id pub-id-type="pmid">17588519</pub-id></element-citation></ref><ref id="R23"><label>23</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dorn</surname><given-names>IT</given-names></name><name><surname>Eschrich</surname><given-names>R</given-names></name><name><surname>Seemuller</surname><given-names>E</given-names></name><name><surname>Guckenberger</surname><given-names>R</given-names></name><name><surname>Tampe</surname><given-names>R</given-names></name></person-group><article-title>High-resolution AFM-imaging and mechanistic analysis of the 20S proteasome</article-title><source>J Mol Biol</source><volume>288</volume><fpage>1027</fpage><lpage>1036</lpage><year>1999</year><pub-id pub-id-type="pmid">10329196</pub-id></element-citation></ref><ref id="R24"><label>24</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Thess</surname><given-names>A</given-names></name><etal/></person-group><article-title>Specific orientation and two-dimensional crystallization of the proteasome at metal-chelating lipid interfaces</article-title><source>J Biol Chem</source><volume>277</volume><fpage>36321</fpage><lpage>36328</lpage><year>2002</year><pub-id pub-id-type="pmid">12114506</pub-id></element-citation></ref><ref id="R25"><label>25</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Glickman</surname><given-names>MH</given-names></name><name><surname>Rubin</surname><given-names>DM</given-names></name><name><surname>Fried</surname><given-names>VA</given-names></name><name><surname>Finley</surname><given-names>D</given-names></name></person-group><article-title>The regulatory particle of the <italic>S. cerevisiae</italic> proteasome</article-title><source>Mol Cell Biol</source><volume>18</volume><fpage>3149</fpage><lpage>3162</lpage><year>1998</year><pub-id pub-id-type="pmid">9584156</pub-id></element-citation></ref><ref id="R26"><label>26</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rubin</surname><given-names>DM</given-names></name><name><surname>Glickman</surname><given-names>MH</given-names></name><name><surname>Larsen</surname><given-names>CN</given-names></name><name><surname>Dhruvakumar</surname><given-names>S</given-names></name><name><surname>Finley</surname><given-names>D</given-names></name></person-group><article-title>Active site mutants in the six regulatory particle ATPases reveal multiple roles for ATP in the proteasome</article-title><source>EMBO J</source><volume>17</volume><fpage>4909</fpage><lpage>4919</lpage><year>1998</year><pub-id pub-id-type="pmid">9724628</pub-id></element-citation></ref><ref id="R27"><label>27</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Marques</surname><given-names>AJ</given-names></name><name><surname>Glanemann</surname><given-names>C</given-names></name><name><surname>Ramos</surname><given-names>PC</given-names></name><name><surname>Dohmen</surname><given-names>RJ</given-names></name></person-group><article-title>The C-terminal extension of the &#x003b2;7 subunit and activator complexes stabilize nascent 20S proteasomes and promote their maturation</article-title><source>J Biol Chem</source><volume>282</volume><fpage>34869</fpage><lpage>34876</lpage><year>2007</year><pub-id pub-id-type="pmid">17911101</pub-id></element-citation></ref><ref id="R28"><label>28</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Isono</surname><given-names>E</given-names></name><etal/></person-group><article-title>The assembly pathway of the 19S regulatory particle of the yeast 26S proteasome</article-title><source>Mol Biol Cell</source><volume>18</volume><fpage>569</fpage><lpage>580</lpage><year>2007</year><pub-id pub-id-type="pmid">17135287</pub-id></element-citation></ref><ref id="R29"><label>29</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nickell</surname><given-names>S</given-names></name><etal/></person-group><article-title>Structural analysis of the 26S proteasome by cryoelectron tomography</article-title><source>Biochem Biophys Res Commun</source><volume>353</volume><fpage>115</fpage><lpage>120</lpage><year>2007</year><pub-id pub-id-type="pmid">17173858</pub-id></element-citation></ref><ref id="R30"><label>30</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kurucz</surname><given-names>E</given-names></name><etal/></person-group><article-title>Assembly of the <italic>Drosophila</italic> 26 S proteasome is accompanied by extensive subunit rearrangements</article-title><source>Biochem J</source><volume>365</volume><fpage>527</fpage><lpage>536</lpage><year>2002</year><pub-id pub-id-type="pmid">11945175</pub-id></element-citation></ref><ref id="R31"><label>31</label><element-cit