group person-group-type="author"><name><surname>Moorthy</surname><given-names>VS</given-names></name><name><surname>Pinder</surname><given-names>M</given-names></name><name><surname>Reece</surname><given-names>WH</given-names></name><name><surname>Watkins</surname><given-names>K</given-names></name><name><surname>Atabani</surname><given-names>S</given-names></name><name><surname>Hannan</surname><given-names>C</given-names></name><name><surname>Bojang</surname><given-names>K</given-names></name><name><surname>McAdam</surname><given-names>KP</given-names></name><name><surname>Schneider</surname><given-names>J</given-names></name><name><surname>Gilbert</surname><given-names>S</given-names></name><name><surname>Hill</surname><given-names>AV</given-names></name></person-group><article-title>Safety and immunogenicity of DNA/modified vaccinia virus ankara malaria vaccination in African adults</article-title><source>J Infect Dis</source><year>2003</year><volume>188</volume><fpage>1239</fpage><lpage>1244</lpage><pub-id pub-id-type="pmid">14551895</pub-id><pub-id pub-id-type="doi">10.1086/378515</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lu</surname><given-names>Y</given-names></name><name><surname>Kawakami</surname><given-names>S</given-names></name><name><surname>Yamashita</surname><given-names>F</given-names></name><name><surname>Hashida</surname><given-names>M</given-names></name></person-group><article-title>Development of an antigen-presenting cell-targeted DNA vaccine against melanoma by mannosylated liposomes</article-title><source>Biomaterials</source><year>2007</year><volume>28</volume><fpage>3255</fpage><lpage>3262</lpage><pub-id pub-id-type="pmid">17449093</pub-id><pub-id pub-id-type="doi">10.1016/j.biomaterials.2007.03.028</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ulmer</surname><given-names>J