><source>Arch Dis Child</source><year>1997</year><volume>77</volume><fpage>347</fpage><lpage>350</lpage><pub-id pub-id-type="pmid">9389243</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Talley</surname><given-names>NJ</given-names></name><name><surname>Fullerton</surname><given-names>S</given-names></name><name><surname>Junghard</surname><given-names>O</given-names></name><name><surname>Wiklund</surname><given-names>I</given-names></name></person-group><article-title>Quality of life in patients with endoscopy-negative heartburn: reliability and sensitivity of disease-specific instruments</article-title><source>Am J Gastroenterol</source><year>2001</year><volume>96</volume><fpage>1998</fpage><lpage>2004</lpage><pub-id pub-id-type="pmid">11467624</pub-id><pub-id pub-id-type="doi">10.1111/j.1572-0241.2001.03932.x</pub-id></citation></ref></ref-list></back></article>