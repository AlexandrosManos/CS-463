ven-names></name></person-group><article-title>The case for stopping cervical screening at age 50</article-title><source>Br J Obstet Gynaecol</source><year>1997</year><volume>104</volume><fpage>586</fpage><lpage>589</lpage><!--PubMed citation query: 'Br J Obstet Gynaecol||104|586||bib6|'--><pub-id pub-id-type="pmid">9166202</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fahey</surname><given-names>MT</given-names></name><name><surname>Irwig</surname><given-names>L</given-names></name><name><surname>Macaskill</surname><given-names>P</given-names></name></person-group><article-title>Meta-analysis of Pap test accuracy</article-title><source>Am J Epidemiol</source><year>1995</year><volume>141</volume><fpage>680</fpage><lpage>689</lpage><!--PubMed citation query: 'Am J Epidemiol||141|680||bib7|'--><pub-id pub-id-type="pmid">7702044</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gram</surname><given-names>IT</given-names></name><name><surname>Macaluso</surname><given-names>M</given-names></name><name><surname>Stalsberg</surname><given-names>H</given-names></name></person-group><article-title>Incidence of cervical intraepithelial neoplasia grade III, and cancer of the cervix uteri following a negative Pap-smear in an opportunistic screening</article-title><source>Acta Obstet Gynecol Scand</source><year>1998</year><volume>77</volume><fpage>228</fpage><lpage>232</lpage><!--PubMed citation query: 'Acta Obstet Gynecol Scand||77|228||bib8|'--><pub-id pub-id-type="pmid">9512333</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gustafsson</surname><given-names>L</given-names></name><name><surname>Sparen</surname><given-names>P</given-names></name><name><surname>Gustafsson</surname><given-names>M</given-names></name><name><surname>Pettersson</surname><given-names>B</given-names></name><name><surname>Wilander</surname><given-names>E</given-names></name><name><surname>Bergstrom</surname><given-names>R</given-names></name><name><surname>Adami</surname><given-names>HO</given-names></name></person-group><article-title>Low efficiency of cytologic screening for cancer <italic>in situ</italic> of the cervix in older women</article-title><source>Int J Cancer</source><year>1995</year><volume>63</volume><fpage>804</fpage><lpage>809</lpage><!--PubMed citation query: 'Int J Cancer||63|804||bib9|'--><pub-id pub-id-type="pmid">8847138</pub-id></citation></ref><ref id="bib10"><citation citation-type="book"><person-group person-group-type="author"><collab>International Agency for Research on Cancer</collab></person-group><article-title/><source>IARC Handbooks of Cancer Prevention. Cervix Cancer Screening</source><year>2005</year><publisher-name>Lyon: IARC Press</publisher-name>Volume 10</citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><collab>International Agency for Research on Cancer</collab></person-group><article-title>IARC Working Group on evaluation of cervical cancer screening programmes. Screening for squamous cervical cancer: duration of low risk after negative results of cervical cytology and its implication for screening policies</article-title><source>BMJ</source><year>1986</year><volume>293</volume><fpage>659</fpage><lpage>664</lpage><!--PubMed citation query: 'BMJ||293|659||bib11|'--></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Montanari</surname><given-names>G</given-names></name><name><surname>Confortini</surname><given-names>M</given-names></name><name><surname>Bellomi</surname><given-names>A</given-names></name><name><surname>Cocchi</surname><given-names>V</given-names></name><name><surname>Dalla Palma</surname><given-names>P</given-names></name><name><surname>D'Amb