/fpage><lpage>174</lpage><pub-id pub-id-type="pmid">7917691</pub-id></element-citation></ref><ref id="R14"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Leclercq</surname><given-names>C</given-names></name><name><surname>Kass</surname><given-names>DA</given-names></name></person-group><article-title>Retiming the failing heart: principles and current clinical status of cardiac resynchronization</article-title><source>J Am coll Cardiol</source><year>2002</year><volume>390</volume><fpage>194</fpage><lpage>201</lpage><pub-id pub-id-type="pmid">11788207</pub-id></element-citation></ref><ref id="R15"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dias</surname><given-names>RA</given-names></name><name><surname>Obasohan</surname><given-names>A</given-names></name><name><surname>Oakley</surname><given-names>CM</given-names></name></person-group><article-title>Prediction of outcome in dilated cardiomyopathy</article-title><source>Br Heart J</source><year>1987</year><volume>58</volume><fpage>393</fpage><lpage>399</lpage><pub-id pub-id-type="pmid">3676026</pub-id></element-citation></ref></ref-list></back><floats-group><fig id="F1a" position="float"><label>Figure 1a</label><caption><p>Baseline ECG with wide QRS (RBBB)</p></caption><graphic xlink:href="ipej080211-01a"/></fig><fig id="F1b" position="float"><label>Figure 1b</label><caption><p>Post implant ECG</p></caption><graphic xlink:href="ipej080211-01b"/></fig><fig id="F2a" position="float"><label>Figure 2a</label><caption><p>ECG showing widening of paced QRS due to hyperkalemia</p></caption><graphic xlink:href="ipej080211-02a"/></fig><fig id="F2b" position="float"><label>Figure 2b</label><caption><p>ECG with device in switched off mode</p></caption><graphic xlink:href="ipej080211-02b"/></fig><fig id="F3a" position="float"><label>Figure 3a</label><caption><p>Baseline ECG with wide QRS (lBBB) </p></caption><graphic xlink:href="ipej080211-03a"/></fig><fig id="F3b" position="float"><label>Figure 3b</label><caption><p>Post implant ECG</p></caption><graphic xlink:href="ipej080211-03b"/></fig><fig id="F4a" position="float"><label>Figure 4a</label><caption><p>ECG showing widening of paced QRS due to progressive disease</p></caption><graphic xlink:href="ipej080211-04a"/></fig><fig id="F4b" position="float"><label>Figure 4b</label><caption><p>ECG with device in switched off mode</p></caption><graphic xlink:href="ipej080211-04b"/></fig></floats-group></article>