><person-group person-group-type="author"><name><surname>Dimopoulou</surname><given-names>I</given-names></name><name><surname>Orfanos</surname><given-names>S</given-names></name><name><surname>Kotanidou</surname><given-names>A</given-names></name><name><surname>Livaditi</surname><given-names>O</given-names></name><name><surname>Giamarellos-Bourboulis</surname><given-names>E</given-names></name><name><surname>Athanasiou</surname><given-names>C</given-names></name><name><surname>Korovesi</surname><given-names>I</given-names></name><name><surname>Sotiropoulou</surname><given-names>C</given-names></name><name><surname>Kopterides</surname><given-names>P</given-names></name><name><surname>Ilias</surname><given-names>I</given-names></name><name><surname>Kanellakopoulou</surname><given-names>K</given-names></name><name><surname>Armaganidis</surname><given-names>A</given-names></name></person-group><article-title>Plasma pro- and anti-inflammatory cytokine levels and outcome prediction in unselected critically ill patients</article-title><source>Cytokine</source><year>2008</year><volume>41</volume><fpage>263</fpage><lpage>267</lpage><pub-id pub-id-type="pmid">18191577</pub-id><pub-id pub-id-type="doi">10.1016/j.cyto.2007.11.019</pub-id></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Holmes</surname><given-names>T</given-names></name></person-group><source>A System of Surgery, Theoretical and Practical</source><year>1860</year><publisher-name>London: JW Parker</publisher-name></citation></ref></ref-list></back></article>