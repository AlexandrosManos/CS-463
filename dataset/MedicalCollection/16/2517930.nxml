rson-group><article-title>Experimental study design and grant writing in eight steps and 28 questions</article-title><source>Med Educ</source><year>2003</year><volume>37</volume><fpage>376</fpage><lpage>385</lpage><pub-id pub-id-type="doi">10.1046/j.1365-2923.2003.01468.x</pub-id></citation><citation citation-type="display-unstructured">Bordage G, Dawson B. Experimental study design and grant writing in eight steps and 28 questions. Med Educ. 2003;37:376&#x02013;85. <pub-id pub-id-type="pmid">12654123</pub-id></citation></ref><ref id="CR19"><label>19.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Albert</surname><given-names>M</given-names></name><name><surname>Hodges</surname><given-names>B</given-names></name><name><surname>Regehr</surname><given-names>G</given-names></name></person-group><article-title>Research in medical education: Balancing service and science</article-title><source>Adv Health Sci Educ Theory Pract</source><year>2007</year><volume>12</volume><fpage>103</fpage><lpage>115</lpage><pub-id pub-id-type="doi">10.1007/s10459-006-9026-2</pub-id></citation><citation citation-type="display-unstructured">Albert M, Hodges B, Regehr G. Research in medical education: Balancing service and science. Adv Health Sci Educ Theory Pract. 2007;12:103&#x02013;15. <pub-id pub-id-type="pmid">17033879</pub-id></citation></ref><ref id="CR20"><label>20.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crandall</surname><given-names>SJ</given-names></name><name><surname>Caelleigh</surname><given-names>AS</given-names></name><name><surname>Steinecke</surname><given-names>A</given-names></name></person-group><article-title>Reference to the literature and documentation</article-title><source>Acad Med</source><year>2001</year><volume>76</volume><fpage>925</fpage><lpage>927</lpage></citation><citation citation-type="display-unstructured">Crandall SJ, Caelleigh AS, Steinecke A. Refe