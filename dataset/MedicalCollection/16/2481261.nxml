pl 5</volume><fpage>793</fpage><lpage>802</lpage><pub-id pub-id-type="pmid">10970168</pub-id><pub-id pub-id-type="doi">10.2307/3434342</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bernert</surname><given-names>JT</given-names></name><name><surname>Harmon</surname><given-names>TL</given-names></name><name><surname>Sosnoff</surname><given-names>CS</given-names></name><name><surname>McGuffey</surname><given-names>JE</given-names></name></person-group><article-title>Use of continine immunoassay test strips for preclassifying urine samples from smokers and nonsmokers prior to analysis by LC-MS-MS</article-title><source>J Anal Toxicol</source><year>2005</year><volume>29</volume><fpage>814</fpage><lpage>818</lpage><pub-id pub-id-type="pmid">16374940</pub-id></citation></ref></ref-list></back></article>