><fpage>550</fpage><lpage>555</lpage><pub-id pub-id-type="pmid">16642019</pub-id></element-citation></ref><ref id="B25"><label>25</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sigurdsson</surname><given-names>S</given-names></name><name><surname>Nordmark</surname><given-names>G</given-names></name><name><surname>Goring</surname><given-names>HH</given-names></name><name><surname>Lindroos</surname><given-names>K</given-names></name><name><surname>Wiman</surname><given-names>AC</given-names></name><name><surname>Sturfelt</surname><given-names>G</given-names></name><name><surname>Jonsen</surname><given-names>A</given-names></name><name><surname>Rantapaa-Dahlqvist</surname><given-names>S</given-names></name><name><surname>Moller</surname><given-names>B</given-names></name><etal/></person-group><article-title>Polymorphisms in the tyrosine kinase 2 and interferon regulatory factor 5 genes are associated with systemic lupus erythematosus</article-title><source>Am. J. Hum. Genet.</source><year>2005</year><volume>76</volume><fpage>528</fpage><lpage>537</lpage><pub-id pub-id-type="pmid">15657875</pub-id></element-citation></ref></ref-list></back></article>