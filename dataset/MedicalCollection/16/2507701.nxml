cle-title>Increasing trends of acute myocardial infarction in Spain: the MONICA-Catalonia Study</article-title><source>Eur Heart J</source><year>2005</year><volume>26</volume><fpage>505</fpage><lpage>15</lpage><pub-id pub-id-type="pmid">15618037</pub-id><pub-id pub-id-type="doi">10.1093/eurheartj/ehi068</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kuulasmaa</surname><given-names>K</given-names></name><name><surname>Tunstall-Pedoe</surname><given-names>H</given-names></name><name><surname>Dobson</surname><given-names>A</given-names></name><name><surname>Fortmann</surname><given-names>S</given-names></name><name><surname>Sans</surname><given-names>S</given-names></name><name><surname>Tolonen</surname><given-names>H</given-names></name><name><surname>Evans</surname><given-names>A</given-names></name><name><surname>Ferrario</surname><given-names>M</given-names></name><name><surname>Tuomilehto</surname><given-names>J</given-names></name></person-group><article-title>Estimation of contribution of changes in classic risk factors to trends in coronary-event rates across the WHO MONICA Project populations</article-title><source>Lancet</source><volume>355</volume><fpage>675</fpage><lpage>87</lpage><comment>2000 Feb 26;</comment><pub-id pub-id-type="pmid">10703799</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(99)11180-2</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rodu</surname><given-names>B</given-names></name><name><surname>Stegmayr</surname><given-names>B</given-names></name><name><surname>Nasic</surname><given-names>S</given-names></name><name><surname>Asplund</surname><given-names>K</given-names></name></person-group><article-title>Impact of smokeless tobacco use on smoking in northern Sweden</article-title><source>J Intern Med</source><year>2002</year><volume>252</volume><fpage>398</fpage><lpage>40