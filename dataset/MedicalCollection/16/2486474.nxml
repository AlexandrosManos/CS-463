id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Britto</surname><given-names>DT</given-names></name><name><surname>Szczerba</surname><given-names>MW</given-names></name><name><surname>Kronzucker</surname><given-names>HJ</given-names></name></person-group><article-title>A new, non-perturbing, sampling procedure in tracer exchange measurements</article-title><source>Journal of Experimental Botany</source><year>2006</year><volume>57</volume><fpage>1309</fpage><lpage>1314</lpage><pub-id pub-id-type="pmid">16551689</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cakmak</surname><given-names>I</given-names></name></person-group><article-title>The role of potassium in alleviating detrimental effects of abiotic stresses in plants</article-title><source>Journal of Plant Nutrition and Soil Science</source><year>2005</year><volume>168</volume><fpage>521</fpage><lpage>530</lpage></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carden</surname><given-names>DE</given-names></name><name><surname>Walker</surname><given-names>DJ</given-names></name><name><surname>Flowers</surname><given-names>TJ</given-names></name><name><surname>Miller</surname><given-names>AJ</given-names></name></person-group><article-title>Single-cell measurements of the contributions of cytosolic Na<sup>+</sup> and K<sup>+</sup> to salt tolerance</article-title><source>Plant Physiology</source><year>2003</year><volume>131</volume><fpage>676</fpage><lpage>683</lpage><pub-id pub-id-type="pmid">12586891</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cheeseman</surname><given-names>JM</given-names></name></person-group><article-title>Pump-leak sodium fluxes in low salt corn roots</article-title><source>Journal of Membrane Biolog