urname><given-names>IW</given-names></name><etal></etal></person-group><article-title>Subclavian arterial injury associated with blunt trauma</article-title><source>Vasc Surg</source><year>2001</year><volume>35</volume><fpage>43</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">11668368</pub-id></citation></ref></ref-list></back></article>