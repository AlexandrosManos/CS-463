</year><volume>48</volume><fpage>316</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">10697095</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Redmond</surname><given-names>AD</given-names></name></person-group><article-title>A complication of fracture of the clavicle</article-title><source>Injury</source><year>1982</year><volume>13</volume><fpage>352</fpage><pub-id pub-id-type="pmid">7061146</pub-id><pub-id pub-id-type="doi">10.1016/0020-1383(82)90338-2</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dash</surname><given-names>UN</given-names></name><name><surname>Handler</surname><given-names>D</given-names></name></person-group><article-title>A Case of Compression of Subclavian Vessels by a Fractured Clavicle Treated by Excision of the First Rib</article-title><source>JBJS(A)</source><year>1960</year><volume>42</volume><fpage>798</fpage><lpage>801</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jupiter</surname><given-names>JB</given-names></name><name><surname>Leibman</surname><given-names>MI</given-names></name></person-group><article-title>Supraclavicular nerve entrapment due to clavicular fracture callus</article-title><source>Journal of Shoulder and Elbow Surgery</source><year>2007</year><volume>16</volume><fpage>13</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">17363291</pub-id><pub-id pub-id-type="doi">10.1016/j.jse.2006.09.015</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Throckmorton</surname><given-names>T</given-names></name><name><surname>Kuhn</surname><given-names>JE</given-names></name></person-group><article-title>Fractures of the medial end of the clavicle</article-title><source>Journal of Shoulder and Elbow Surgery</source