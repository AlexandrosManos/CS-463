></person-group><article-title>Surgical treatment of early breast cancer: what would surgeons choose for themselves?</article-title><source>Eff Clin Pract</source><year>1999</year><volume>2</volume><fpage>149</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">10539538</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Katz</surname><given-names>SJ</given-names></name><name><surname>Lantz</surname><given-names>PM</given-names></name><name><surname>Janz</surname><given-names>NK</given-names></name><name><surname>Fagerlin</surname><given-names>A</given-names></name><name><surname>Schwartz</surname><given-names>K</given-names></name><name><surname>Liu</surname><given-names>L</given-names></name><name><surname>Deapen</surname><given-names>D</given-names></name><name><surname>Salem</surname><given-names>B</given-names></name><name><surname>Lakhani</surname><given-names>I</given-names></name><name><surname>Morrow</surname><given-names>M</given-names></name></person-group><article-title>Patient Involvement in Surgery Treatment Decisions for Breast Cancer</article-title><source>J Clin Oncol</source><year>2005</year><volume>23</volume><fpage>5526</fpage><lpage>33</lpage><pub-id pub-id-type="pmid">16110013</pub-id><pub-id pub-id-type="doi">10.1200/JCO.2005.06.217</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Caldon</surname><given-names>LJ</given-names></name><name><surname>Walters</surname><given-names>SJ</given-names></name><name><surname>Reed</surname><given-names>JA</given-names></name><name><surname>Murphy</surname><given-names>A</given-names></name><name><surname>Worley</surname><given-names>A</given-names></name><name><surname>Reed</surname><given-names>MW</given-names></name></person-group><article-title>Case-mix fails to explain variation in mastectomy rates: management of screen-detected breast cancer in a UK region 1997&#x02013;2003</article-title><source>Br J Cancer</source><year>2005</year><volume>92</volume><fpage>55</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">15611797</pub-id><pub-id pub-id-type="doi">10.1038/sj.bjc.6602264</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reaby</surname><given-names>LL</given-names></name></person-group><article-title>Reasons why women who have mastectomy decide to have or not to have breast reconstruction</article-title><source>Plast Reconstr Surg</source><year>1998</year><volume>101</volume><fpage>1810</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">9623821</pub-id><pub-id pub-id-type="doi">10.1097/00006534-199806000-00006</pub-id></citation></ref></ref-list></back></article>