r>2007</year><article-title>Bacterial taxa abundance pattern in an industrial wastewater treatment system determined by the full rRNA cycle approach.</article-title><source>Environ Microbiol</source><volume>9</volume><fpage>1789</fpage><lpage>1789</lpage></citation></ref><ref id="pone.0002910-Frey1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Frey</surname><given-names>JC</given-names></name><name><surname>Angert</surname><given-names>ER</given-names></name><name><surname>Pell</surname><given-names>AN</given-names></name></person-group><year>2006</year><article-title>Assessment of biases associated with profiling simple, model communities using terminal-restriction fragment length polymorphism-based analyses.</article-title><source>J Microbiol Methods</source><volume>67</volume><fpage>9</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">16563536</pub-id></citation></ref><ref id="pone.0002910-Preston1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Preston</surname><given-names>FW</given-names></name></person-group><year>1948</year><article-title>The commonness and rarity of species.</article-title><source>Ecology</source><volume>29</volume><fpage>254</fpage><lpage>283</lpage></citation></ref><ref id="pone.0002910-Dewdney1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dewdney</surname><given-names>AK</given-names></name></person-group><year>2000</year><article-title>A dynamical model of communities and a new species-abundance distribution.</article-title><source>Biol Bull</source><volume>198</volume><fpage>152</fpage><lpage>165</lpage><pub-id pub-id-type="pmid">10707821</pub-id></citation></ref><ref id="pone.0002910-Osborn1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Osborn</surname><given-names>AM</given-names></name><name><surname>Moore</surname><given-names>ERB</given-names></name><name><surname>Timmis</surname><given-names>KN</given-names></name></person-group><year>2000</year><article-title>An evaluation of terminal-restriction fragment length polymorphism (T-RFLP) analysis for the study of microbial community structure and dynamics.</article-title><source>Environ Microbiol</source><volume>2</volume><fpage>39</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">11243261</pub-id></citation></ref><ref id="pone.0002910-Bunge1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bunge</surname><given-names>J</given-names></name><name><surname>Epstein</surname><given-names>S</given-names></name><name><surname>Peterson</surname><given-names>D</given-names></name></person-group><year>2006</year><article-title>Comment on &#x0201c;computational improvements reveal great bacterial diversity and high metal toxicity in soil&#x0201d;.</article-title><source>Science</source><volume>313</volume><fpage>918</fpage><pub-id pub-id-type="pmid">16917045</pub-id></citation></ref><ref id="pone.0002910-Gans2"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gans</surname><given-names>J</given-names></name><name><surname>Wolinsky</surname><given-names>M</given-names></name><name><surname>Dunbar</surname><given-names>J</given-names></name></person-group><year>2006b</year><article-title>Response to comment by Bunge et al. on &#x0201c;computational improvements reveal great bacterial diversity and high metal toxicity in soil&#x0201d;.</article-title><source>Science</source><volume>313</volume><fpage>918</fpage></citation></ref><ref id="pone.0002910-Volkov1"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Volkov</surname><given-names>I</given-names></name><name><surname>Banavar</surname><given-names>J</given-names></name><name><surname>Mari