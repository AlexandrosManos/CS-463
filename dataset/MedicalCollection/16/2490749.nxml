an="1">2</td><td align="center" rowspan="1" colspan="1">&#x02013;</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">&#x02013;</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">chr18:20691186&#x02013;20697540</td><td align="center" rowspan="1" colspan="1">4.86 &#x000d7; 10<sup>&#x02212;13</sup></td><td align="center" rowspan="1" colspan="1">3</td><td align="center" rowspan="1" colspan="1">&#x02013;</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">&#x02013;</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">chr14:19402695&#x02013;19502641</td><td align="center" rowspan="1" colspan="1">3.88 &#x000d7; 10<sup>&#x02212;8</sup></td><td align="center" rowspan="1" colspan="1">4</td><td align="center" rowspan="1" colspan="1">&#x02013;</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">2636</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">Decrease</td><td rowspan="1" colspan="1">chr14:21715523&#x02013;22040167</td><td align="center" rowspan="1" colspan="1">1.00 &#x000d7; 10<sup>&#x02212;16</sup></td><td align="center" rowspan="1" colspan="1">1</td><td rowspan="1" colspan="1">chr14:21531617&#x02013;22057862</td><td align="center" rowspan="1" colspan="1">1.00 &#x000d7; 10<sup>&#x02212;16</sup></td><td align="center" rowspan="1" colspan="1">1 of 82</td><td align="center" rowspan="1" colspan="1">2644/5</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">chr10:54588936&#x02013;54590136</td><td align="center" rowspan="1" colspan="1">1.00 &#x000d7; 10<sup>&#x02212;16</sup></td><td align="center" rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">&#x02013;</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td align="center" row