">10.1083/jcb.93.3.576</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stephan</surname><given-names>A</given-names></name><name><surname>Vaughan</surname><given-names>S</given-names></name><name><surname>Shaw</surname><given-names>MK</given-names></name><name><surname>Gull</surname><given-names>K</given-names></name><name><surname>McKean</surname><given-names>PG</given-names></name></person-group><article-title>An essential quality control mechanism at the eukaryotic basal body prior to intraflagellar transport</article-title><source>Traffic</source><year>2007</year><volume>8</volume><fpage>1323</fpage><lpage>1330</lpage><pub-id pub-id-type="pmid">17645436</pub-id><pub-id pub-id-type="doi">10.1111/j.1600-0854.2007.00611.x</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ogbadoyi</surname><given-names>EO</given-names></name><name><surname>Robinson</surname><given-names>DR</given-names></name><name><surname>Gull</surname><given-names>K</given-names></name></person-group><article-title>A high-order trans-membrane structural linkage is responsible for mitochondrial genome positioning and segregation by flagellar basal bodies in trypanosomes</article-title><source>Mol Biol Cell</source><year>2003</year><volume>14</volume><fpage>1769</fpage><lpage>1779</lpage><pub-id pub-id-type="pmid">12802053</pub-id><pub-id pub-id-type="doi">10.1091/mbc.E02-08-0525</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Absalon</surname><given-names>S</given-names></name><name><surname>Kohl</surname><given-names>L</given-names></name><name><surname>Branche</surname><given-names>C</given-names></name><name><surname>Blisnick</surname><given-names>T</given-names></name><name><surname>Toutirais</surname><given-names>G</given-names></name><name><surname>Rusconi</surname><given-names>F</given-names></name><name><surname>Cosson</surname><given-names>J</given-names></name><name><surname>Bonhivers</surname><given-names>M</given-names></name><name><surname>Robinson</surname><given-names>D</given-names></name><name><surname>Bastin</surname><given-names>P</given-names></name></person-group><article-title>Basal body positioning is controlled by flagellum formation in Trypanosoma brucei</article-title><source>PLoS ONE</source><year>2007</year><volume>2</volume><fpage>e437</fpage><pub-id pub-id-type="pmid">17487282</pub-id><pub-id pub-id-type="doi">10.1371/journal.pone.0000437</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gluenz</surname><given-names>E</given-names></name><name><surname>Shaw</surname><given-names>MK</given-names></name><name><surname>Gull</surname><given-names>K</given-names></name></person-group><article-title>Structural asymmetry and discrete nucleic acid subdomains in the Trypanosoma brucei kinetoplast</article-title><source>Mol Microbiol</source><year>2007</year><volume>64</volume><fpage>1529</fpage><lpage>1539</lpage><pub-id pub-id-type="pmid">17511811</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2958.2007.05749.x</pub-id></citation></ref></ref-list></back></article>