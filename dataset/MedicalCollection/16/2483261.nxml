on-group-type="author"><name><surname>Utoft</surname><given-names>K</given-names></name><name><surname>Jahre</surname><given-names>J</given-names></name><name><surname>Meyer</surname><given-names>HJ</given-names></name><name><surname>Dichlmayr</surname><given-names>R</given-names></name></person-group><article-title>Chirurgische Therapie des primeren malignen melanomen des oesophagus</article-title><source>Chirurgica</source><year>1996</year><volume>67</volume><fpage>86</fpage><lpage>89</lpage></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ho</surname><given-names>KY</given-names></name><name><surname>Cheng</surname><given-names>J</given-names></name><name><surname>Wee</surname><given-names>A</given-names></name><name><surname>Soo</surname><given-names>KC</given-names></name></person-group><article-title>Primary malignant melanoma of the esophagus with multiple esophageal lesions</article-title><source>Nat Clin Pract Gastroenterol Hepatol</source><year>2007</year><volume>4</volume><fpage>171</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">17339854</pub-id><pub-id pub-id-type="doi">10.1038/ncpgasthep0761</pub-id></citation></ref></ref-list></back></article>