-type="pmid">17335853</pub-id></citation></ref><ref id="CR13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>B&#x000fc;scher</surname><given-names>R</given-names></name><name><surname>Grasemann</surname><given-names>H</given-names></name></person-group><article-title>Disease modifying genes in cystic fibrosis: therapeutic option or one-way road?</article-title><source>Naunyn-Schmiedeberg's Arch Pharmacol</source><year>2006</year><volume>374</volume><fpage>65</fpage><lpage>77</lpage><pub-id pub-id-type="doi">10.1007/s00210-006-0101-2</pub-id></citation><citation citation-type="display-unstructured">B&#x000fc;scher R, Grasemann H (2006) Disease modifying genes in cystic fibrosis: therapeutic option or one-way road? Naunyn-Schmiedeberg's Arch Pharmacol 374:65&#x02013;77 <pub-id pub-id-type="pmid">17033796</pub-id></citation></ref><ref id="CR14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Callaerts-Vegh</surname><given-names>Z</given-names></name><name><surname>Evans</surname><given-names>KLJ</given-names></name><name><surname>Dudekula</surname><given-names>N</given-names></name><name><surname>Cuba</surname><given-names>D</given-names></name><name><surname>Knoll</surname><given-names>BJ</given-names></name><name><surname>Callaerts</surname><given-names>PFK</given-names></name><name><surname>Giles</surname><given-names>H</given-names></name><name><surname>Shardonofsky</surname><given-names>FR</given-names></name><name><surname>Bond</surname><given-names>RA</given-names></name></person-group><article-title>Effects of acute and chronic administration of &#x003b2;-adrenoceptor ligands on airway function in a murine model of asthma</article-title><source>Proc Natl Acad Sci USA</source><year>2004</year><volume>101</volume><fpage>4948</fpage><lpage>4953</lpage><pub-id pub-id-type="doi">10.1073/pnas.0400452101</pub-id></citation><citation citation-type="display-unstructured">Callaerts-Vegh 