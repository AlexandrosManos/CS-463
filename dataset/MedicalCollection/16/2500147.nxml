on associated with vinorelbine tartrate (Navelbine)</article-title><source>Oncol Nurs Forum</source><year>1995</year><volume>22</volume><fpage>707</fpage><lpage>710</lpage><pub-id pub-id-type="pmid">7675673</pub-id></citation></ref><ref id="B9"><label>9</label><citation citation-type="journal"><person-group><name><surname>Nakayama</surname><given-names>S</given-names></name><name><surname>Matsubara</surname><given-names>N</given-names></name><name><surname>Sakai</surname><given-names>T</given-names></name></person-group><etal/><article-title>The incidence of phlebitis in patients administered vinorelbine by intravenous bolus injection--a retrospective study</article-title><source>Gan To Kagaku Ryoho</source><year>2002</year><volume>29</volume><fpage>633</fpage><lpage>635</lpage><pub-id pub-id-type="pmid">11977554</pub-id></citation></ref><ref id="B10"><label>10</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Spratto</surname><given-names>GR</given-names></name><name><surname>Woods</surname><given-names>AL</given-names></name></person-group><article-title>Vinorelbine tartrate</article-title><person-group person-group-type="editor"><name><surname>Spratto</surname><given-names>GR</given-names></name><name><surname>Woods</surname><given-names>AL</given-names></name></person-group><source>2008 EDITION PDR Nurse's Drug Handbook</source><publisher-loc>New York</publisher-loc><publisher-name>Thomson Delmar Learning</publisher-name><year>2007</year><fpage>1667</fpage><lpage>1670</lpage></citation></ref><ref id="B11"><label>11</label><citation citation-type="journal"><person-group><name><surname>Tononi</surname><given-names>A</given-names></name><name><surname>Panzini</surname><given-names>I</given-names></name><name><surname>Oliverio</surname><given-names>G</given-names></name></person-group><etal/><article-title>Vinorelbine chemotherapy in non small cell lung cancer: experience in elderly patients</article-title><source>J Chemot