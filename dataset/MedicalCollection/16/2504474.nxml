me><name><surname>Fu</surname><given-names>XY</given-names></name></person-group><article-title>Dysfunction of Stat4 leads to accelerated incidence of chemical-induced thymic lymphomas in mice</article-title><source>Exp Mol Pathol</source><year>2001</year><volume>70</volume><fpage>231</fpage><lpage>238</lpage><pub-id pub-id-type="pmid">11418001</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kalinski</surname><given-names>P</given-names></name><name><surname>Giermasz</surname><given-names>A</given-names></name><name><surname>Nakamura</surname><given-names>Y</given-names></name><name><surname>Basse</surname><given-names>P</given-names></name><name><surname>Storkus</surname><given-names>WJ</given-names></name><name><surname>Kirkwood</surname><given-names>JM</given-names></name><name><surname>Mailliard</surname><given-names>RB</given-names></name></person-group><article-title>Helper role of NK cells during the induction of anticancer responses by dendritic cells</article-title><source>Mol Immunol</source><year>2005</year><volume>42</volume><fpage>535</fpage><lpage>539</lpage><pub-id pub-id-type="pmid">15607810</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kobayashi</surname><given-names>N</given-names></name></person-group><article-title>Malignant neoplasms in registered cases of primary immunodeficiency syndrome</article-title><source>Jpn J Clin Oncol</source><year>1985</year><volume>15</volume><fpage>307</fpage><lpage>312</lpage><pub-id pub-id-type="pmid">4009992</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nakamura</surname><given-names>E</given-names></name><name><surname>Megumi</surname><given-names>Y</given-names></name><name><surname>Kobayashi</surname><given-names>T</given-names></name><name><surname>Kamoto</surname><