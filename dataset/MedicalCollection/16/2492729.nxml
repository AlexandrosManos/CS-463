d rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">&#x02193;</td><td rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">x</td></tr><tr><td rowspan="1" colspan="1">IL-20</td><td rowspan="1" colspan="1">Exogenous</td><td rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">&#x02191;</td><td rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">x</td></tr><tr><td rowspan="5" colspan="1">TNF</td><td rowspan="1" colspan="1">TNFR&#x02212;/&#x02212;</td><td rowspan="1" colspan="1">&#x02194;</td><td rowspan="1" colspan="1">&#x02191;p55<sup>&#x02212;/&#x02212;</sup>&#x02194;p75<sup>&#x02212;/&#x02212;</sup></td><td rowspan="1" colspan="1">&#x02194;</td><td rowspan="1" colspan="1">&#x02194;&#x02193; (stage-dependent)</td><td rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">x</td></tr><tr><td rowspan="1" colspan="1">TNF&#x003b1;&#x02212;/&#x02212;</td><td rowspan="1" colspan="1">&#x02191;</td><td rowspan="1" colspan="1">&#x02194; &#x02193;</td><td rowspan="1" colspan="1">&#x02194;</td><td rowspan="1" colspan="1">&#x02193;</td><td rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">x</td></tr><tr><td rowspan="1" colspan="1">tmTNF</td><td rowspan="1" colspan="1">&#x02194;</td><td rowspan="1" colspan="1">&#x02193;</td><td rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">x</td></tr><tr><td rowspan="1" colspan="1">Anti-TNF</td><td rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">&#x02194;</td><td rowspan="1" colspan="1">&#x02193;</td><td rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">x</td></tr><tr><td rowspan="1" colspan="1">TNFbp</td><td rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">x</td><td rowspan="1" colspan="1">&#x02194;</td><td rowspan="1" colspan="1">&#x02193;