><article-title>Diversity of oligonucleotide functions</article-title><source>Annu. Rev. Biochem.</source><year>1995</year><volume>64</volume><fpage>763</fpage><lpage>797</lpage><pub-id pub-id-type="pmid">7574500</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Santoro</surname><given-names>SW</given-names></name><name><surname>Joyce</surname><given-names>GF</given-names></name></person-group><article-title>A general purpose RNA-cleaving DNA enzyme</article-title><source>Proc. Natl Acad. Sci. USA</source><year>1997</year><volume>94</volume><fpage>4262</fpage><lpage>4266</lpage><pub-id pub-id-type="pmid">9113977</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Breaker</surname><given-names>RR</given-names></name></person-group><article-title>In vitro selection of catalytic polynucleotides</article-title><source>Chem. Rev.</source><year>1997</year><volume>97</volume><fpage>371</fpage><lpage>390</lpage><pub-id pub-id-type="pmid">11848875</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Osborne</surname><given-names>SE</given-names></name><name><surname>Ellington</surname><given-names>AD</given-names></name></person-group><article-title>Nucleic acid selection and the challenge of combinatorial chemistry</article-title><source>Chem. Rev.</source><year>1997</year><volume>97</volume><fpage>349</fpage><lpage>370</lpage><pub-id pub-id-type="pmid">11848874</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>Y</given-names></name><name><surname>Breaker</surname><given-names>RR</given-names></name></perso