tr><tr><td colspan="1" rowspan="1" align="left">&#x02003;&#x02003;&#x02003;&#x02003;225394_s_at</td><td colspan="1" rowspan="1" align="center">MADP-1<xref ref-type="table-fn" rid="tblfn1">a</xref></td><td colspan="1" rowspan="1" align="center">2.62E-06</td><td colspan="1" rowspan="1" align="char" char=".">0.6</td><td colspan="1" rowspan="1" align="center">MADP-1 protein</td></tr><tr><td colspan="1" rowspan="1" align="left">Phosphorylation</td><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="left" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left">&#x02003;&#x02003;&#x02003;&#x02003;211992_at</td><td colspan="1" rowspan="1" align="center">WNK1</td><td colspan="1" rowspan="1" align="center">5.27E-04</td><td colspan="1" rowspan="1" align="char" char=".">2.1</td><td colspan="1" rowspan="1" align="center">WNK lysine&#x02013;deficient protein kinase 1</td></tr><tr><td colspan="1" rowspan="1" align="left">&#x02003;&#x02003;&#x02003;&#x02003;226979_at</td><td colspan="1" rowspan="1" align="center">MAP3K2</td><td colspan="1" rowspan="1" align="center">0.00567</td><td colspan="1" rowspan="1" align="char" char=".">0.7</td><td colspan="1" rowspan="1" align="center">mitogen-activated protein kinase kinase kinase 2</td></tr><tr><td colspan="1" rowspan="1" align="left">&#x02003;&#x02003;&#x02003;&#x02003;227073_at</td><td colspan="1" rowspan="1" align="center">MAP3K2</td><td colspan="1" rowspan="1" align="center">0.00836</td><td colspan="1" rowspan="1" align="char" char=".">0.8</td><td colspan="1" rowspan="1" align="center">mitogen-activated protein kinase kinase kinase 2</td></tr><tr><td colspan="1" rowspan="1" align="left">Protein biosynthesis</td><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="left" valign="top"/><td cols