ournal"><person-group person-group-type="author"><name><surname>Schatzkin</surname><given-names>A</given-names></name><name><surname>Subar</surname><given-names>AF</given-names></name><name><surname>Thompson</surname><given-names>FE</given-names></name><name><surname>Harlan</surname><given-names>LC</given-names></name><name><surname>Tangrea</surname><given-names>J</given-names></name><etal/></person-group><year>2001</year><article-title>Design and serendipity in establishing a large cohort with wide dietary intake distributions : the National Institutes of Health-American Association of Retired Persons Diet and Health Study</article-title><source>Am J Epidemiol</source><volume>154</volume><fpage>1119</fpage><lpage>1125</lpage><pub-id pub-id-type="pmid">11744517</pub-id></citation></ref><ref id="pmed-0040325-b013"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Subar</surname><given-names>AF</given-names></name><name><surname>Midthune</surname><given-names>D</given-names></name><name><surname>Kulldorff</surname><given-names>M</given-names></name><name><surname>Brown</surname><given-names>CC</given-names></name><name><surname>Thompson</surname><given-names>FE</given-names></name><etal/></person-group><year>2000</year><article-title>Evaluation of alternative approaches to assign nutrient values to food groups in food frequency questionnaires</article-title><source>Am J Epidemiol</source><volume>152</volume><fpage>279</fpage><lpage>286</lpage><pub-id pub-id-type="pmid">10933275</pub-id></citation></ref><ref id="pmed-0040325-b014"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Subar</surname><given-names>AF</given-names></name><name><surname>Thompson</surname><given-names>FE</given-names></name><name><surname>Kipnis</surname><given-names>V</given-names></name><name><surname>Midthune</surname><given-names>D</given-names></name><name><surname>Hurwitz</surname><given-names>P</given-names></