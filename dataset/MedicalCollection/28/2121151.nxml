etes Care</source><year>2001</year><volume>24</volume><fpage>561</fpage><lpage>87</lpage><pub-id pub-id-type="pmid">11289485</pub-id></citation></ref><ref id="b16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>S</given-names></name><etal/></person-group><article-title>Association of health literacy with self-management behavior in patients with diabetes</article-title><source>Diabetes Care</source><year>2004</year><volume>27</volume><fpage>2980</fpage><lpage>2</lpage><pub-id pub-id-type="pmid">15562219</pub-id></citation></ref><ref id="b17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heisler</surname><given-names>M</given-names></name></person-group><article-title>The relationship between knowledge of recent HbA1c values and diabetes care understanding and self-management</article-title><source>Diabetes Care</source><year>2005</year><volume>28</volume><fpage>816</fpage><lpage>22</lpage><pub-id pub-id-type="pmid">15793179</pub-id></citation></ref><ref id="b18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lockington</surname><given-names>T</given-names></name><etal/></person-group><article-title>Knowledge profile and control in diabetic patients</article-title><source>Diabet Med</source><year>1988</year><volume>5</volume><fpage>381</fpage><lpage>86</lpage><pub-id pub-id-type="pmid">2968890</pub-id></citation></ref><ref id="b19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Estabrooks</surname><given-names>PA</given-names></name><etal/></person-group><article-title>The frequency and behavioral outcomes of goal choices in the self-management of diabetes</article-title><source>Diabetes Educ</source><year>2005</year><volume>31</volume><fpage>391</fpage><lpage>400</lpage><pub-id pub-id-type="pmid">1591963