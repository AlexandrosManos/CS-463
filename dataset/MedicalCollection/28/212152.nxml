><surname>Patel</surname><given-names>NP</given-names></name><name><surname>Ward</surname><given-names>JN</given-names></name></person-group><article-title>Cancer of the prostate metastatic to prepuce and glans</article-title><source>Urology</source><year>1978</year><volume>11</volume><fpage>269</fpage><lpage>270</lpage><pub-id pub-id-type="pmid">636132</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamm</surname><given-names>FC</given-names></name><name><surname>Weinberg</surname><given-names>SR</given-names></name></person-group><article-title>Secondary malignant infiltration of the penis: report of four cases, two with surgical treatment for palliation</article-title><source>J Urol</source><year>1955</year><volume>73</volume><fpage>349</fpage><lpage>354</lpage><pub-id pub-id-type="pmid">13234126</pub-id></citation></ref></ref-list></back></article>