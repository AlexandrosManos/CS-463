</lpage><pub-id pub-id-type="pmid">8300899</pub-id><pub-id pub-id-type="doi">10.1002/cne.903380103</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Salecker</surname><given-names>I</given-names></name><name><surname>Distler</surname><given-names>P</given-names></name></person-group><article-title>Serotonin-immunoreactive neurons in the antennal lobes of the American cockroach <italic>Periplaneta americana</italic>: light- and electron-microscopic observations</article-title><source>Histochemistry</source><year>1990</year><volume>94</volume><fpage>463</fpage><lpage>473</lpage><pub-id pub-id-type="pmid">2283309</pub-id><pub-id pub-id-type="doi">10.1007/BF00272608</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wegerhoff</surname><given-names>R</given-names></name></person-group><article-title>GABA and serotonin immunoreactivity during postembryonic brain development in the beetle <italic>Tenebrio molitor</italic></article-title><source>Microsc Res Tech</source><year>1999</year><volume>45</volume><fpage>154</fpage><lpage>164</lpage><pub-id pub-id-type="pmid">10344767</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1097-0029(19990501)45:3&#x0003c;154::AID-JEMT3&#x0003e;3.0.CO;2-5</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hill</surname><given-names>ES</given-names></name><name><surname>Iwano</surname><given-names>M</given-names></name><name><surname>Gatellier</surname><given-names>L</given-names></name><name><surname>Kanzaki</surname><given-names>R</given-names></name></person-group><article-title>Morphology and physiology of the serotonin-immunoreactive putative antennal lobe feedback neuron in the male silkmoth <italic>Bombyx mori</italic></article-title><source>Chem Senses</source><year>2002</year><volume>27</volume><fpage>4