n-names>C</given-names></name></person-group><article-title>Callosal size in children with learning disabilities</article-title><source>Behavioural Brain Research</source><year>1994</year><volume>64</volume><fpage>213</fpage><lpage>218</lpage><pub-id pub-id-type="pmid">7530964</pub-id></citation></ref><ref id="b30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ors</surname><given-names>M</given-names></name></person-group><article-title>Auditory event-related potentials in children with specific language impairment</article-title><source>European Journal of Paediatric Neurology</source><year>2002</year><volume>6</volume><fpage>47</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">11993955</pub-id></citation></ref><ref id="b31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Plante</surname><given-names>E</given-names></name></person-group><article-title>Gyral morphology in posterior sylvian regions in families affected by language disorder</article-title><source>Neuropsychology Review</source><year>1997</year><volume>6</volume><fpage>81</fpage><lpage>94</lpage><pub-id pub-id-type="pmid">8976499</pub-id></citation></ref><ref id="b32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ponton</surname><given-names>CW</given-names></name></person-group><article-title>Maturation of human central auditory system activity: evidence from multi-channel evoked potentials</article-title><source>Clinical Neurophysiology</source><year>2000</year><volume>111</volume><fpage>220</fpage><lpage>236</lpage><pub-id pub-id-type="pmid">10680557</pub-id></citation></ref><ref id="b33"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shafer</surname><given-names>VL</given-names></name></person-group><article-title>Deviant neurophysiological asymmetry in children with language impairment</article-title><source>Neuroreport</sourc