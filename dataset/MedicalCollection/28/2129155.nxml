%</td><td align="left">183%</td><td align="left">382%</td><td align="left">183%</td></tr><tr><td align="left">VITAMIN B-3</td><td align="left">155%</td><td align="left">87%</td><td align="left">64%</td><td align="left">294%</td><td align="left">123%</td><td align="left">117%</td><td align="left">267%</td><td align="left">256%</td><td align="left">270%</td><td align="left">214%</td></tr><tr><td align="left">VITAMIN B-6</td><td align="left">90%</td><td align="left">144%</td><td align="left">55%</td><td align="left">137%</td><td align="left">77%</td><td align="left">81%</td><td align="left">231%</td><td align="left">143%</td><td align="left">180%</td><td align="left">213%</td></tr><tr><td align="left">VITAMIN B-12</td><td align="left">99%</td><td align="left">156%</td><td align="left">123%</td><td align="left">193%</td><td align="left">357%</td><td align="left">119%</td><td align="left">140%</td><td align="left">78%</td><td align="left">99%</td><td align="left">328%</td></tr><tr><td align="left">FOLATE</td><td align="left">55%</td><td align="left">235%</td><td align="left">76%</td><td align="left">255%</td><td align="left">233%</td><td align="left">73%</td><td align="left">130%</td><td align="left">249%</td><td align="left">174%</td><td align="left">311%</td></tr><tr><td align="left">IODINE</td><td align="left">0%</td><td align="left">58%</td><td align="left">0%</td><td align="left">0%</td><td align="left">36%</td><td align="left">0%</td><td align="left">25%</td><td align="left">31%</td><td align="left">0%</td><td align="left">58%</td></tr><tr><td align="left">POTASSIUM</td><td align="left">124%</td><td align="left">212%</td><td align="left">67%</td><td align="left">253%</td><td align="left">144%</td><td align="left">94%</td><td align="left">206%</td><td align="left">217%</td><td align="left">201%</td><td align="left">238%</td></tr><tr><td align="left">CALCIUM</td><td align="left">53%</td><td align="left">90%</td><td align="left">77%</td><td align="left">179%</td><td align="left">111%</td><td align="left">65%</td><td align="left">84%</td><td align="left">118%</td><td align="left">182%</td><td align="left">99%</td></tr><tr><td align="left">MAGNESIUM</td><td align="left">51%</td><td align="left">124%</td><td align="left">44%</td><td align="left">175%</td><td align="left">73%</td><td align="left">82%</td><td align="left">140%</td><td align="left">207%</td><td align="left">119%</td><td align="left">156%</td></tr><tr><td align="left">PHOSPHORUS</td><td align="left">105%</td><td align="left">169%</td><td align="left">138%</td><td align="left">175%</td><td align="left">248%</td><td align="left">89%</td><td align="left">113%</td><td align="left">411%</td><td align="left">218%</td><td align="left">249%</td></tr><tr><td align="left">ZINC</td><td align="left">35%</td><td align="left">55%</td><td align="left">48%</td><td align="left">124%</td><td align="left">97%</td><td align="left">35%</td><td align="left">78%</td><td align="left">144%</td><td align="left">67%</td><td align="left">164%</td></tr><tr><td align="left">SELENIUM</td><td align="left">30%</td><td align="left">44%</td><td align="left">24%</td><td align="left">159%</td><td align="left">97%</td><td align="left">3%</td><td align="left">120%</td><td align="left">256%</td><td align="left">117%</td><td align="left">174%</td></tr><tr><td align="left">INDIVIDUAL MICRONUTRIENT DEFICIENCIES</td><td align="left">14</td><td align="left">7</td><td align="left">15</td><td align="left">3</td><td align="left">9</td><td align="left">13</td><td align="left">5</td><td align="left">4</td><td align="left">7</td><td align="left">3</td></tr></tbody></table></table-wrap><table-wrap position="float" id="T4"><label>Table 4</label><caption><p>Group II (5 MEN, 5 WOMEN)</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="left">MICRONUTRIENT</td><td align="left" colspan="5">MEN % Reference Daily Intake (RDI)</td><td align="left" colspan="5">WOMEN % Reference Daily Intake (RDI)</td></tr></thead><tbody><tr><td align="left">MALE (M) WOMEN (W)</td><td align="left">M6 (S)</td><td align="left">M7 (A)</td><td align="left">M8 (A)</td><td align="left">M9 (A)</td><td align="left">M10 (A)</td><td align="left">W6 (A)</td><td align="left">W7 (S)</td><td align="left">W8 (S)</td><td align="left">W9 (S)</td><td align="left">W10 (S)</td></tr><tr><td colspan="11"><hr></hr></td></tr><tr><td align="left">TOTAL CALORIES INTAKE REPORTED</td><td align="left">42%</td><td align="left">161%</td><td align="left">56%</td><td align="left">93%</td><td align="left">134%</td><td align="left">125%</td><td align="left">118%</td><td align="left">76%</td><td align="left">104%</td><td align="left">64%</td></tr><tr><td align="left">VITAMIN A</td><td align="left">248%</td><td align="left">445%</td><td align="left">105%</td><td align="left">129%</td><td align="left">117%</td><td align="left">533%</td><td align="left">318%</td><td align="left">326%</td><td align="left">216%</td><td align="left">130%</td></tr><tr><td align="left">VITAMIN D</td><td align="left">75%</td><td align="left">30%</td><td align="left">66%</td><td align="left">13%</td><td align="left">125%</td><td align="left">86%</td><td align="left">43%</td><td align="left">60%</td><td align="left">6%</td><td align="left">16%</td></tr><tr><td align="left">VITAMIN E</td><td align="left">1%</td><td align="left">76%</td><td align="left">0.2%</td><td align="left">123%</td><td align="left">93%</td><td align="left">19%</td><td align="left">195%</td><td align="left">9%</td><td align="left">173%</td><td align="left">39%</td></tr><tr><td align="left">VITAMIN K</td><td align="left">205%</td><td align="left">122%</td><td align="left">104%</td><td align="left">95%</td><td align="left">73%</td><td align="left">341%</td><td align="left">110%</td><td align="left">197%</td><td align="left">189%</td><td align="left">28%</td></tr><tr><td align="left">VITAMIN B-1</td><td align="left">101%</td><td align="left">290%</td><td align="left">95%</td><td align