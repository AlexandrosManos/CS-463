given-names>V</given-names></name><etal/></person-group><article-title>Mortality in patient hospitalized for asthma exacerbations in the United States</article-title><source>Am J Respir Crit Care Med</source><year>2006</year><volume>174</volume><fpage>633</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">16778163</pub-id></citation></ref><ref id="b13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ten Brinke</surname><given-names>A</given-names></name><etal/></person-group><article-title>Risk factors of frequent exacerbations in difficult-to-treat asthma</article-title><source>Eur Respir J</source><year>2005</year><volume>26</volume><fpage>812</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">16264041</pub-id></citation></ref><ref id="b14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tan</surname><given-names>WC</given-names></name></person-group><article-title>Epidemiology of respiratory viruses in patients hospitalized with near-fatal asthma, acute exacerbations of asthma, or chronic obstructive pulmonary disease</article-title><source>Am J Med</source><year>2003</year><volume>115</volume><fpage>272</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">12967691</pub-id></citation></ref></ref-list></back></article>