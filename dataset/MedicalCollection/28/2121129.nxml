etes.</article-title><source>Ann Periodontol</source><volume>3</volume><issue>1</issue><fpage>13</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">9722686</pub-id></citation></ref><ref id="pone.0001320-Golub2"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Golub</surname><given-names>LM</given-names></name><name><surname>Payne</surname><given-names>JB</given-names></name><name><surname>Reinhardt</surname><given-names>RA</given-names></name><name><surname>Nieman</surname><given-names>G</given-names></name></person-group><year>2006</year><article-title>Can systemic diseases co-induce (not just exacerbate) periodontitis? A hypothetical &#x0201c;two-hit&#x0201d; model.</article-title><source>J Dent Res</source><volume>85</volume><issue>2</issue><fpage>102</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">16434727</pub-id></citation></ref><ref id="pone.0001320-SafkanSeppala1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Safkan-Seppala</surname><given-names>B</given-names></name><name><surname>Ainamo</surname><given-names>J</given-names></name></person-group><year>1992</year><article-title>Periodontal conditions in insulin-dependent diabetes mellitus.</article-title><source>J Clin Periodontol</source><volume>19</volume><issue>1</issue><fpage>24</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">1732306</pub-id></citation></ref><ref id="pone.0001320-Pucher1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pucher</surname><given-names>JJ</given-names></name><name><surname>Otomo-Corgel</surname><given-names>J</given-names></name></person-group><year>2002</year><article-title>Periodontal disease and systemic health&#x02013;diabetes.</article-title><source>J Calif Dent Assoc</source><volume>30</volume><issue>4</issue><fpage>312</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">12005376</pub-id></cita