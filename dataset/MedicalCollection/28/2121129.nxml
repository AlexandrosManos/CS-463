mes>RE</given-names></name></person-group><year>1970</year><article-title>Diabetes and periodontal patient.</article-title><source>J Periodontol</source><volume>41</volume><issue>12</issue><fpage>713</fpage><lpage>18</lpage><pub-id pub-id-type="pmid">5275716</pub-id></citation></ref><ref id="pone.0001320-Alpagot1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Alpagot</surname><given-names>T</given-names></name><name><surname>Silverman</surname><given-names>S</given-names></name><name><surname>Lundergan</surname><given-names>W</given-names></name><name><surname>Bell</surname><given-names>C</given-names></name><name><surname>Chambers</surname><given-names>DW</given-names></name></person-group><year>2001</year><article-title>Crevicular fluid elastase levels in relation to periodontitis and metabolic control of diabetes.</article-title><source>J Periodontal Res</source><volume>36</volume><issue>3</issue><fpage>169</fpage><lpage>74</lpage><pub-id pub-id-type="pmid">11453115</pub-id></citation></ref><ref id="pone.0001320-Liu1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>R</given-names></name><name><surname>Bal</surname><given-names>HS</given-names></name><name><surname>Desta</surname><given-names>T</given-names></name><name><surname>Krothapalli</surname><given-names>N</given-names></name><name><surname>Alyassi</surname><given-names>M</given-names></name><etal/></person-group><year>2006</year><article-title>Diabetes enhances periodontal bone loss through enhanced resorption and diminished bone formation.</article-title><source>J Dent Res</source><volume>85</volume><issue>6</issue><fpage>510</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">16723646</pub-id></citation></ref><ref id="pone.0001320-Barnett1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barnett</surname><given-names>ML</given-names></name><name><surname>Baker</surname><given-names>RL</given-names></name><name><surname>Yancey</surname><given-names>JM</given-names></name><name><surname>MacMillan</surname><given-names>DR</given-names></name><name><surname>Kotoyan</surname><given-names>M</given-names></name></person-group><year>1984</year><article-title>Absence of periodontitis in a population of insulin-dependent diabetes mellitus (IDDM) patients.</article-title><source>J Periodontol</source><volume>55</volume><issue>7</issue><fpage>402</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">6589390</pub-id></citation></ref><ref id="pone.0001320-Benveniste1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Benveniste</surname><given-names>R</given-names></name><name><surname>Bixler</surname><given-names>D</given-names></name><name><surname>Conneally</surname><given-names>PM</given-names></name></person-group><year>1967</year><article-title>Periodontal disease in diabetics.</article-title><source>J Periodontol</source><volume>38</volume><issue>4</issue><fpage>271</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">5338928</pub-id></citation></ref><ref id="pone.0001320-Lalla1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lalla</surname><given-names>E</given-names></name><name><surname>Lamster</surname><given-names>IB</given-names></name><name><surname>Feit</surname><given-names>M</given-names></name><name><surname>Huang</surname><given-names>L</given-names></name><name><surname>Schmidt</surname><given-names>AM</given-names></name></person-group><year>1998</year><article-title>A murine model of accelerated periodontal disease in diabetes.</article-title><source>J Periodontal Res</source><volume>33</volume><issue>7</issue><fpage>387</fpage><lpage>99</lpage><pub-id pub-id-type="pmid">9842504</pub-id></citation></ref><ref id="pone.0001320-Lalla2"><label>17</label