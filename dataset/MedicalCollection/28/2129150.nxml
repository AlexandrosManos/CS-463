="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tarnopolsky</surname><given-names>MA</given-names></name><name><surname>MacDougall</surname><given-names>JD</given-names></name><name><surname>Atkinson</surname><given-names>SA</given-names></name></person-group><article-title>Influence of protein intake and training status on nitrogen balance and lean body mass</article-title><source>J Appl Physiol</source><year>1988</year><volume>64</volume><fpage>187</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">3356636</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hegsted</surname><given-names>DM</given-names></name></person-group><article-title>Assessment of nitrogen requirements</article-title><source>Am J Clin Nutr</source><year>1978</year><volume>31</volume><fpage>1669</fpage><lpage>77</lpage><pub-id pub-id-type="pmid">685881</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Waterlow</surname><given-names>JC</given-names></name></person-group><article-title>The mysteries of nitrogen balance</article-title><source>Nutr Res</source><year>1999</year><volume>12</volume><fpage>25</fpage><lpage>54</lpage><pub-id pub-id-type="doi">10.1079/095442299108728857</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wolfe</surname><given-names>RR</given-names></name></person-group><article-title>Protein supplements and exercise</article-title><source>Am J Clin Nutr</source><year>2000</year><volume>72</volume><fpage>551S</fpage><lpage>7S</lpage><pub-id pub-id-type="pmid">10919959</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tome</surname><given-names>D</given-names></name><name><surname>Bos</surname><given-names>C</given-names></name></person-group><article-title>Dietary protein and nitrogen utilization</article-title><source>J Nutr</source><year>2000</year><volume>130</volume><fpage>1868S</fpage><lpage>73S</lpage><pub-id pub-id-type="pmid">10867065</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wolfe</surname><given-names>RR</given-names></name><name><surname>Wolfe</surname><given-names>MH</given-names></name><name><surname>Nadel</surname><given-names>ER</given-names></name><name><surname>Shaw</surname><given-names>JH</given-names></name></person-group><article-title>Isotopic determination of amino acid-urea interactions in exercise in humans</article-title><source>J Appl Physiol</source><year>1984</year><volume>56</volume><fpage>221</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">6420382</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carraro</surname><given-names>F</given-names></name><name><surname>Hartl</surname><given-names>WH</given-names></name><name><surname>Stuart</surname><given-names>CA</given-names></name><name><surname>Layman</surname><given-names>DK</given-names></name><etal></etal></person-group><article-title>Whole body and plasma protein synthesis in exercise and recovery in human subjects</article-title><source>Am J Physiol</source><year>1990</year><volume>258</volume><fpage>E821</fpage><lpage>31</lpage><pub-id pub-id-type="pmid">2333990</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carraro</surname><given-names>F</given-names></name><name><surname>Kimbrough</surname><given-names>TD</given-names></name><name><surname>Wolfe</surname><given-names>RR</given-names></name></person-group><article-title>Urea kinetics in humans at two levels of exercise intensity</article-title><source>J Appl Physiol</source><year>1993</year><volume>75</volume><fpage>1180</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">8226527</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lemon</surname><given-names>PW</given-names></name></person-group><article-title>Beyond the zone: protein needs of active individuals</article-title><source>J Am Coll Nutr</source><year>2000</year><volume>19</volume><fpage>513S</fpage><lpage>521S</lpage><pub-id pub-id-type="pmid">11023001</pub-id></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lemon</surname><given-names>PW</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Antonio J, Stout J</surname></name></person-group><article-title>Protein requirements of strength athletes</article-title><source>Sports Supplements</source><publisher-name>Philadelphia, PA: Lippincott, Williams, &#x00026; Wilkins Publishing Co</publisher-name></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boirie</surname><given-names>Y</given-names></name><name><surname>Dangin</surname><given-names>M</given-names></name><name><surname>Gachon</surname><given-names>P</given-names></name><name><surname>Vasson</surname><given-names>MP</given-names></name><etal></etal></person-group><article-title>Slow and fast dietary proteins differently modulate postprandial protein accretion</article-title><source>Proc Natl Acad Sci USA</source><year>1997</year><volume>94</volume><fpage>14930</fpage><lpage>14935</lpage><pub-id pub-id-type="pmid">9405716</pub-id><pub-id pub-id-type="doi">10.1073/pnas.94.26.14930</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dangin</surname><given-names>M</given-names></name><name><surname>Boirie</surname><given-names>Y</given-names></name><name><surname>Garcia