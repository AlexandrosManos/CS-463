le>Influence of protein intake and training status on nitrogen balance and lean body mass</article-title><source>J Appl Physiol</source><year>1988</year><volume>64</volume><fpage>187</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">3356636</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tarnopolsky</surname><given-names>MA</given-names></name><name><surname>Atkinson</surname><given-names>SA</given-names></name><name><surname>MacDougall</surname><given-names>JD</given-names></name><name><surname>Chesley</surname><given-names>A</given-names></name><name><surname>Phillips</surname><given-names>S</given-names></name><name><surname>Schwarcz</surname><given-names>HP</given-names></name></person-group><article-title>Evaluation of protein requirements for trained strength athletes</article-title><source>J Appl Physiol</source><year>1992</year><volume>73</volume><fpage>1986</fpage><lpage>95</lpage><pub-id pub-id-type="pmid">1474076</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tarnopolsky</surname><given-names>MA</given-names></name></person-group><article-title>Protein and physical performance</article-title><source>Curr Opin Clin Nutr Metab Care</source><year>1999</year><volume>2</volume><issue>6</issue><fpage>533</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">10678685</pub-id><pub-id pub-id-type="doi">10.1097/00075197-199911000-00018</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kreider</surname><given-names>RB</given-names></name></person-group><article-title>Effects of protein and amino acid supplementation on athletic performance</article-title><source>Sportscience</source><year>1999</year><volume>3</volume><issue>1</issue><ext-link ext-link-type="uri" xlink:href="http://www.sportsci.org/jour/9901/rbk.html"/></citation></