al"><person-group person-group-type="author"><name><surname>Boirie</surname><given-names>Y</given-names></name><name><surname>Gachon</surname><given-names>P</given-names></name><name><surname>Cordat</surname><given-names>N</given-names></name><name><surname>Ritz</surname><given-names>P</given-names></name><name><surname>Beaufrere</surname><given-names>B</given-names></name></person-group><article-title>Differential insulin sensitivities of glucose, amino acid, and albumin metabolism in elderly men and women</article-title><source>J Clin Endocrinol Metab</source><year>2001</year><volume>86</volume><fpage>638</fpage><lpage>44</lpage><pub-id pub-id-type="pmid">11158022</pub-id><pub-id pub-id-type="doi">10.1210/jc.86.2.638</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boirie</surname><given-names>Y</given-names></name><name><surname>Gachon</surname><given-names>P</given-names></name><name><surname>Corny</surname><given-names>S</given-names></name><name><surname>Fauquant</surname><given-names>J</given-names></name><name><surname>Maubois</surname><given-names>JL</given-names></name><name><surname>Beaufrere</surname><given-names>B</given-names></name></person-group><article-title>Acute postprandial changes in leucine metabolism as assessed with an intrinsically labeled milk protein</article-title><source>Am J Physiol</source><year>1996</year><volume>271</volume><fpage>E1083</fpage><lpage>91</lpage><pub-id pub-id-type="pmid">8997229</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Venkatraman</surname><given-names>JT</given-names></name><name><surname>Leddy</surname><given-names>J</given-names></name><name><surname>Pendergast</surname><given-names>D</given-names></name></person-group><article-title>Dietary fats and immune status in athletes: clinical implications</article-title><source>Med Sci Sports Exerc</source