e>Nat Genet</source><year>1999</year><volume>21</volume><fpage>70</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">9916792</pub-id><pub-id pub-id-type="doi">10.1038/5007</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Srinivas</surname><given-names>S</given-names></name><name><surname>Watanabe</surname><given-names>T</given-names></name><name><surname>Lin</surname><given-names>CS</given-names></name><name><surname>William</surname><given-names>CM</given-names></name><name><surname>Tanabe</surname><given-names>Y</given-names></name><name><surname>Jessell</surname><given-names>TM</given-names></name><name><surname>Costantini</surname><given-names>F</given-names></name></person-group><article-title>Cre reporter strains produced by targeted insertion of EYFP and ECFP into the ROSA26 locus</article-title><source>BMC Dev Biol</source><year>2001</year><volume>1</volume><fpage>4</fpage><pub-id pub-id-type="pmid">11299042</pub-id><pub-id pub-id-type="doi">10.1186/1471-213X-1-4</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hartley</surname><given-names>JL</given-names></name><name><surname>Temple</surname><given-names>GF</given-names></name><name><surname>Brasch</surname><given-names>MA</given-names></name></person-group><article-title>DNA cloning using <italic>in vitro </italic>site-specific recombination</article-title><source>Genome Res</source><year>2000</year><volume>10</volume><fpage>1788</fpage><lpage>1795</lpage><pub-id pub-id-type="pmid">11076863</pub-id><pub-id pub-id-type="doi">10.1101/gr.143000</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kielman</surname><given-names>MF</given-names></name><name><surname>Rindapaa</surname><given-names>M</given-names></name><name><surname>Gaspar</surname><given-names>C</given-names></name><name><surname>van Poppel</surname><given-names>N</given-names></name><name><surname>Breukel</surname><given-names>C</given-names></name><name><surname>van Leeuwen</surname><given-names>S</given-names></name><name><surname>Taketo</surname><given-names>MM</given-names></name><name><surname>Roberts</surname><given-names>S</given-names></name><name><surname>Smits</surname><given-names>R</given-names></name><name><surname>Fodde</surname><given-names>R</given-names></name></person-group><article-title>Apc modulates embryonic stem-cell differentiation by controlling the dosage of beta-catenin signaling</article-title><source>Nat Genet</source><year>2002</year><volume>32</volume><fpage>594</fpage><lpage>605</lpage><pub-id pub-id-type="pmid">12426568</pub-id><pub-id pub-id-type="doi">10.1038/ng1045</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Veeman</surname><given-names>MT</given-names></name><name><surname>Slusarski</surname><given-names>DC</given-names></name><name><surname>Kaykas</surname><given-names>A</given-names></name><name><surname>Louie</surname><given-names>SH</given-names></name><name><surname>Moon</surname><given-names>RT</given-names></name></person-group><article-title>Zebrafish prickle, a modulator of noncanonical Wnt/Fz signaling, regulates gastrulation movements</article-title><source>Curr Biol</source><year>2003</year><volume>13</volume><fpage>680</fpage><lpage>685</lpage><pub-id pub-id-type="pmid">12699626</pub-id><pub-id pub-id-type="doi">10.1016/S0960-9822(03)00240-9</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zeng</surname><given-names>Y</given-names></name><name><surname>Wagner</surname><given-names>EJ</given-names></name><name><surname>Cullen</surname><given-names>BR</given-names></name></person-group><article-title>Both natural and designed micro RNAs can inhibit the expression of cognate mRNAs when expressed in human cells</article-title><source>Mol Cell</source><year>2002</year><volume>9</volume><fpage>1327</fpage><lpage>1333</lpage><pub-id pub-id-type="pmid">12086629</pub-id><pub-id pub-id-type="doi">10.1016/S1097-2765(02)00541-5</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chung</surname><given-names>KH</given-names></name><name><surname>Hart</surname><given-names>CC</given-names></name><name><surname>Al-Bassam</surname><given-names>S</given-names></name><name><surname>Avery</surname><given-names>A</given-names></name><name><surname>Taylor</surname><given-names>J</given-names></name><name><surname>Patel</surname><given-names>PD</given-names></name><name><surname>Vojtek</surname><given-names>AB</given-names></name><name><surname>Turner</surname><given-names>DL</given-names></name></person-group><article-title>Polycistronic RNA polymerase II expression vectors for RNA interference based on BIC/miR-155</article-title><source>Nucleic Acids Res</source><year>2006</year><volume>34</volume><fpage>e53</fpage><pub-id pub-id-type="pmid">16614444</pub-id><pub-id pub-id-type="doi">10.1093/nar/gkl143</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cullen</surname><given-names>BR</given-names></name></person-group><article-title>RNAi the natural way</article-title><source>Nat Genet</source><year>2005</year><volume>37</volume><fpage>1163</fpage><lpage>1165</lpage><pub-id pub-id-type="pmid">16254559</pub-id><pub-id pub-id-type="doi">10.1038/ng1105-1163</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Niwa</surname><given-names>H</given-names></name><name><surname>Miyazaki</surname><given-names>J</given-names></name><name><surname>Smith</surname><given-names>AG</given-names></name></person-group><article-title>Qua