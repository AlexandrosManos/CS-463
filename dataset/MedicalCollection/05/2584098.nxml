itation citation-type="journal"><person-group person-group-type="author"><name><surname>Lewy</surname><given-names>AJ</given-names></name><name><surname>Cutler</surname><given-names>NL</given-names></name><name><surname>Sack</surname><given-names>RL</given-names></name></person-group><article-title>The endogenous melatonin profile as a marker for circadian phase position</article-title><source>J Biol Rhythms</source><year>1999</year><volume>14</volume><fpage>227</fpage><lpage>236</lpage><pub-id pub-id-type="pmid">10452335</pub-id><pub-id pub-id-type="doi">10.1177/074873099129000641</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Memezawa</surname><given-names>H</given-names></name><name><surname>Smith</surname><given-names>ML</given-names></name><name><surname>Siesjo</surname><given-names>BK</given-names></name></person-group><article-title>Penumbral tissues salvaged by reperfusion following middle cerebral artery occlusion in rats</article-title><source>Stroke</source><year>1992</year><volume>23</volume><fpage>552</fpage><lpage>559</lpage><pub-id pub-id-type="pmid">1561688</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Longa</surname><given-names>EZ</given-names></name><name><surname>Weinstein</surname><given-names>PR</given-names></name><name><surname>Carlson</surname><given-names>S</given-names></name><name><surname>Cummins</surname><given-names>R</given-names></name></person-group><article-title>Reversible middle cerebral artery occlusion without craniectomy in rats</article-title><source>Stroke</source><year>1989</year><volume>20</volume><fpage>84</fpage><lpage>91</lpage><pub-id pub-id-type="pmid">2643202</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>T</given-names></name><name><surname>Borjigi