l"><person-group person-group-type="author"><name><surname>Pallier</surname><given-names>PN</given-names></name><name><surname>Maywood</surname><given-names>ES</given-names></name><name><surname>Zheng</surname><given-names>Z</given-names></name><name><surname>Chesham</surname><given-names>JE</given-names></name><name><surname>Inyushkin</surname><given-names>AN</given-names></name><name><surname>Dyball</surname><given-names>R</given-names></name><name><surname>Hastings</surname><given-names>MH</given-names></name><name><surname>Morton</surname><given-names>AJ</given-names></name></person-group><article-title>Pharmacological imposition of sleep slows cognitive decline and reverses dysregulation of circadian gene expression in a transgenic mouse model of Huntington's disease</article-title><source>J Neurosci</source><year>2007</year><volume>27</volume><fpage>7869</fpage><lpage>7878</lpage><pub-id pub-id-type="pmid">17634381</pub-id><pub-id pub-id-type="doi">10.1523/JNEUROSCI.0649-07.2007</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tate</surname><given-names>B</given-names></name><name><surname>Aboody-Guterman</surname><given-names>KS</given-names></name><name><surname>Morris</surname><given-names>AM</given-names></name><name><surname>Walcott</surname><given-names>EC</given-names></name><name><surname>Majocha</surname><given-names>RE</given-names></name><name><surname>Marotta</surname><given-names>CA</given-names></name></person-group><article-title>Disruption of circadian regulation by brain grafts that overexpress Alzheimer beta/A4 amyloid</article-title><source>Proc Natl Acad Sci USA</source><year>1992</year><volume>89</volume><fpage>7090</fpage><lpage>7094</lpage><pub-id pub-id-type="pmid">1496005</pub-id><pub-id pub-id-type="doi">10.1073/pnas.89.15.7090</pub-id></citation></ref></ref-list></back></article>