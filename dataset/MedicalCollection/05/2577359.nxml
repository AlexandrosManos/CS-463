 pub-id-type="pmid">15335222</pub-id></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Yu</surname><given-names>C</given-names></name><name><surname>Davey</surname><given-names>MH</given-names></name><name><surname>Svec</surname><given-names>F</given-names></name><name><surname>Frechet</surname><given-names>JM</given-names></name></person-group><article-title>Monolithic porous polymer for on-chip solid-phase extraction andpreconcentration prepared by photoinitiated in situ polymerization within amicrofluidic device</article-title><source>Anal. Chem.</source><year>2001</year><volume>73</volume><fpage>5088</fpage><lpage>5096</lpage><pub-id pub-id-type="pmid">11721904</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Shediac</surname><given-names>R</given-names></name><name><surname>Ngola</surname><given-names>SM</given-names></name><name><surname>Throckmorton</surname><given-names>DJ</given-names></name><name><surname>Anex</surname><given-names>DS</given-names></name><name><surname>Shepodd</surname><given-names>TJ</given-names></name><name><surname>Singh</surname><given-names>AK</given-names></name></person-group><article-title>Reversed-phase electrochromatography of amino acids and peptidesusing porous polymer monoliths</article-title><source>J. Chromatogr. A</source><year>2001</year><volume>925</volume><fpage>251</fpage><lpage>263</lpage><pub-id pub-id-type="pmid">11519810</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Throckmorton</surname><given-names>DJ</given-names></name><name><surname>Shepodd</surname><given-names>TJ</given-names></name><name><surname>Singh</surname><given-names>AK</given-names></name></person-group><article-title>E