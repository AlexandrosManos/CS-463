"B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Asvold</surname><given-names>BO</given-names></name><name><surname>Bjoro</surname><given-names>T</given-names></name><name><surname>Nilsen</surname><given-names>TI</given-names></name><name><surname>Gunnell</surname><given-names>D</given-names></name><name><surname>Vatten</surname><given-names>LJ</given-names></name></person-group><article-title>Thyrotropin levels and risk of fatal coronary heart disease: the HUNT study</article-title><source>Arch Intern Med</source><year>2008</year><volume>168</volume><fpage>855</fpage><lpage>860</lpage><pub-id pub-id-type="pmid">18443261</pub-id><pub-id pub-id-type="doi">10.1001/archinte.168.8.855</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Takashima</surname><given-names>N</given-names></name><name><surname>Niwa</surname><given-names>Y</given-names></name><name><surname>Mannami</surname><given-names>T</given-names></name><name><surname>Tomoike</surname><given-names>H</given-names></name><name><surname>Iwai</surname><given-names>N</given-names></name></person-group><article-title>Characterization of subclinical thyroid dysfunction from cardiovascular and metabolic viewpoints: the Suita study</article-title><source>Circ J</source><year>2007</year><volume>71</volume><fpage>191</fpage><lpage>195</lpage><pub-id pub-id-type="pmid">17251665</pub-id><pub-id pub-id-type="doi">10.1253/circj.71.191</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bergus</surname><given-names>GR</given-names></name><name><surname>Mold</surname><given-names>JW</given-names></name><name><surname>Barton</surname><given-names>ED</given-names></name><name><surname>Randall</surname><given-names>CS</given-names></name></person-group><article-title>The lack of association between hypertension and hypothyroidis