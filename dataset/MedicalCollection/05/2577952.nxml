article-title><source>Osteoporos Int</source><year>2000</year><volume>11</volume><issue>9</issue><fpage>745</fpage><lpage>55</lpage><pub-id pub-id-type="pmid">11148802</pub-id></citation></ref><ref id="R11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wuster</surname><given-names>C</given-names></name><name><surname>Albanese</surname><given-names>C</given-names></name><name><surname>De Aloysio</surname><given-names>D</given-names></name></person-group><article-title>Phalangeal osteosonogrammetry study: age-related changes diagnostic sensitivity and discrimination power The Phalangeal Osteosonogrammetry Study Group</article-title><source>J Bone Miner Res</source><year>2000</year><volume>15</volume><issue>8</issue><fpage>1603</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">10934660</pub-id></citation></ref></ref-list></back><floats-wrap><fig id="F1" position="float"><label>Fig. (1)</label><caption><p>Ad-SOS mean values related to capillaroscopy pattern (p&#x0003c;0.001).</p></caption><graphic xlink:href="TORJ-2-13_F1"/></fig><fig id="F2" position="float"><label>Fig. (2)</label><caption><p>UBPI mean values related to capillaroscopy pattern (p&#x0003c;0.001).</p></caption><graphic xlink:href="TORJ-2-13_F2"/></fig><fig id="F3" position="float"><label>Fig. (3)</label><caption><p>Z score mean values related to capillaroscopy pattern (p&#x0003c;0.001).</p></caption><graphic xlink:href="TORJ-2-13_F3"/></fig></floats-wrap></article>