person-group-type="author"><name><surname>Ogata</surname><given-names>H</given-names></name><name><surname>Matsumoto</surname><given-names>T</given-names></name><name><surname>Tsukahara</surname><given-names>H</given-names></name></person-group><article-title>Electrical skin resistance changes in meridians during ophthalmic surgery with local anesthesia</article-title><source>Am J Chin Med</source><year>1983</year><volume>11</volume><fpage>130</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">6660201</pub-id></citation></ref><ref id="B20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Usichenko</surname><given-names>TI</given-names></name><name><surname>Lysenyuk</surname><given-names>VP</given-names></name><name><surname>Groth</surname><given-names>MH</given-names></name><name><surname>Pavlovic</surname><given-names>D</given-names></name></person-group><article-title>Detection of ear acupuncture points by measuring the electrical skin resistance in patients before, during and after orthopedic surgery performed under general anesthesia</article-title><source>Acupunct Electrother Res</source><year>2003</year><volume>28</volume><fpage>167</fpage><lpage>73</lpage><pub-id pub-id-type="pmid">14998054</pub-id></citation></ref><ref id="B21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kawakita</surname><given-names>K</given-names></name><name><surname>Kawamura</surname><given-names>H</given-names></name><name><surname>Keino</surname><given-names>H</given-names></name></person-group><article-title>Development of low impediance points in the auricular skin of experimental peritonitis rats</article-title><source>Am J Chin Med</source><year>1991</year><volume>19</volume><fpage>199</fpage><lpage>205</lpage><pub-id pub-id-type="pmid">1767791</pub-id></citation></ref><ref id="B22"><label>22</label><citation citation-type="journal"><person-group person-group-typ