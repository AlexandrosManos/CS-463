page>84</lpage><comment>discussion 84-5</comment><pub-id pub-id-type="pmid">8938760</pub-id></citation></ref><ref id="R10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Doherty</surname><given-names>MJ</given-names></name><name><surname>Jayadev</surname><given-names>S</given-names></name><name><surname>Watson</surname><given-names>NF</given-names></name><name><surname>Konchada</surname><given-names>RS</given-names></name><name><surname>Hallam</surname><given-names>DK</given-names></name></person-group><article-title>Clinical implications of splenium magnetic resonance imaging signal changes</article-title><source>Arch Neurol</source><year>2005</year><volume>62</volume><issue>3</issue><fpage>433</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15767508</pub-id></citation></ref><ref id="R11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Castillo</surname><given-names>M</given-names></name><name><surname>Mukherji</surname><given-names>SK</given-names></name></person-group><article-title>Early abnormalities related to postinfarction Wallerian degeneration: evaluation with MR diffusion-weighted imaging</article-title><source>J Comput Assist Tomogr</source><year>1999</year><volume>23</volume><issue>6</issue><fpage>1004</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">10589585</pub-id></citation></ref><ref id="R12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Uchino</surname><given-names>A</given-names></name><name><surname>Sawada</surname><given-names>A</given-names></name><name><surname>Takase</surname><given-names>Y</given-names></name><name><surname>Egashira</surname><given-names>R</given-names></name><name><surname>Kudo</surname><given-names>S</given-names></name></person-group><article-title>Transient detection of early wallerian degeneration on diffusion-weighted MRI after an acute c