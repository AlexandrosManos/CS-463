urname>Fernandez</surname><given-names>V</given-names></name><name><surname>Scholander</surname><given-names>C</given-names></name><name><surname>Carlson</surname><given-names>J</given-names></name></person-group><article-title>Rosetting</article-title><source>Parasitol Today</source><year>1994</year><volume>10</volume><fpage>73</fpage><lpage>79</lpage><pub-id pub-id-type="pmid">15275506</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Foty</surname><given-names>RA</given-names></name><name><surname>Steinberg</surname><given-names>MS</given-names></name></person-group><article-title>The differential adhesion hypothesis: a direct evaluation</article-title><source>Dev Biol</source><year>2005</year><volume>278</volume><fpage>255</fpage><lpage>263</lpage><pub-id pub-id-type="pmid">15649477</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Padday</surname><given-names>JF</given-names></name><name><surname>Pitt</surname><given-names>AR</given-names></name></person-group><article-title>Surface and interfacial tension from profile of a sessile drop</article-title><source>Proc R Soc Lond A Math</source><year>1972</year><volume>329</volume><fpage>421</fpage><lpage>431</lpage></citation></ref></ref-list></back></article>