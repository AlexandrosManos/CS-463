rname>Blendon</surname><given-names>RJ</given-names></name></person-group><article-title>Health insurance markets and income inequality: findings from an international health policy survey</article-title><source>Health Policy</source><year>2000</year><volume>51</volume><fpage>67</fpage><lpage>85</lpage><pub-id pub-id-type="pmid">10699676</pub-id><pub-id pub-id-type="doi">10.1016/S0168-8510(99)00084-6</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schoen</surname><given-names>C</given-names></name><name><surname>Doty</surname><given-names>MM</given-names></name></person-group><article-title>Inequities in access to medical care in five countries: findings from the 2001 Commonwealth Fund International Health Policy Survey</article-title><source>Health Policy</source><year>2004</year><volume>67</volume><fpage>309</fpage><lpage>322</lpage><pub-id pub-id-type="pmid">15036818</pub-id><pub-id pub-id-type="doi">10.1016/j.healthpol.2003.09.006</pub-id></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cumming</surname><given-names>J</given-names></name><name><surname>Stillman</surname><given-names>S</given-names></name><name><surname>Poland</surname><given-names>M</given-names></name><name><surname>Hannis</surname><given-names>G</given-names></name></person-group><source>Who uses primary health care services and who has unmet needs? An analysis of the 2002/03 New Zealand Health Survey</source><publisher-name>Wellington: Health Services Research Centre; Forthcoming</publisher-name></citation></ref><ref id="B13"><citation citation-type="other"><person-group person-group-type="author"><name><surname>King</surname><given-names>A</given-names></name></person-group><source>Media Release: Agreement reached on Primary Health Organisation detail</source><comment>14 May 2003.</comment></citation></ref><ref id="B14"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Hodgson</surname><given-names>P</given-names></name></person-group><source>Media Release: More support for free doc's visits for under-6s</source><comment>27 August 2007.</comment></citation></ref><ref id="B15"><citation citation-type="other"><article-title>Primary Health Care</article-title><ext-link ext-link-type="uri" xlink:href="http://www.moh.govt.nz/primaryhealthcare"/></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><collab>Ministry of Health</collab></person-group><source>Health Expenditure Trends in New Zealand 1990&#x02013;2002</source><year>2004</year><publisher-name>Wellington: Ministry of Health</publisher-name></citation></ref><ref id="B17"><citation citation-type="other"><article-title>Primary Health Care &#x02013; Funding</article-title><ext-link ext-link-type="uri" xlink:href="http://www.moh.govt.nz/moh.nsf/indexmh/phcs-funding"/></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cumming</surname><given-names>J</given-names></name><name><surname>Gribben</surname><given-names>B</given-names></name></person-group><source>Evaluation of the Primary Health Care Strategy: Practice Data Analysis 2001&#x02013;2005</source><year>2007</year><publisher-name>Wellington: Health Services Research Centre</publisher-name></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Raymont</surname><given-names>A</given-names></name><name><surname>Cumming</surname><given-names>J</given-names></name></person-group><source>General Medical Practices: Status and Activities</source><publisher-name>Wellington: Health Services Research Centre; Forthcoming</publisher-name></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><collab>Management Research Centre</collab></person-group><source>New Zealand Business Benchmarking Survey Financial Statistics 2002</source><year>2003</year><publisher-name>Hamilton: Management Research Centre, Waikato Management School, University of Waikato</publisher-name></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><collab>Management Research Centre</collab></person-group><source>New Zealand Business Benchmarking Survey Financial Statistics 2005</source><year>2006</year><publisher-name>Hamilton: Management Research Centre, Waikato Management School, University of Waikato</publisher-name></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><collab>Ministry of Health</collab></person-group><source>A Portrait of Health: Key Results of the 2002/03 New Zealand Health Survey</source><year>2004</year><publisher-name>Wellington: Ministry of Health</publisher-name></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><collab>Ministry of Health</collab></person-group><source>A Portrait of Health Key Results of the 2006/07 New Zealand Health Survey</source><year>2008</year><publisher-name>Wellington: Ministry of Health</publisher-name></citation></ref></ref-list></back></article>