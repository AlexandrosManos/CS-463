ixed-citation publication-type="journal"><name><surname>Mosser</surname><given-names>D.M.</given-names></name><year>1999</year><article-title>Receptors on phagocytic cells involved in microbial recognition</article-title><source><italic>Immunol Ser</italic></source><volume>60</volume><fpage>99</fpage><lpage>114</lpage><pub-id pub-id-type="pmid">7504531</pub-id></mixed-citation></ref><ref id="ref7"><label>7</label><mixed-citation publication-type="journal"><name><surname>Wu</surname><given-names>Y.</given-names></name><name><surname>Tibrewal</surname><given-names>N.</given-names></name><comment> and </comment><name><surname>Birge</surname><given-names>R.B.</given-names></name><year>2006</year><article-title>Phosphatidylserine recognition by phagocytes: a view to a kill</article-title><source><italic>Trends Cell Biol</italic></source><volume>16</volume><fpage>189</fpage><lpage>197</lpage><pub-id pub-id-type="pmid">16529932</pub-id></mixed-citation></ref><ref id="ref8"><label>8</label><mixed-citation publication-type="journal"><name><surname>Hemmi</surname><given-names>H.</given-names></name><etal/><year>2000</year><article-title>A Toll-like receptor recognizes bacterial DNA</article-title><source><italic>Nature</italic></source><volume>408</volume><fpage>740</fpage><lpage>745</lpage><pub-id pub-id-type="pmid">11130078</pub-id></mixed-citation></ref><ref id="ref9"><label>9</label><mixed-citation publication-type="journal"><name><surname>Krieg</surname><given-names>A.M.</given-names></name><year>2002</year><article-title>CpG motifs in bacterial DNA and their immune effects</article-title><source><italic>Annu Rev Immunol</italic></source><volume>20</volume><fpage>709</fpage><lpage>760</lpage><pub-id pub-id-type="pmid">11861616</pub-id></mixed-citation></ref><ref id="ref10"><label>10</label><mixed-citation publication-type="journal"><name><surname>Brightbill</surname><given-names>H.D.</given-names></name><etal/><year>1999</year><article-title>Host defense mechanisms triggered by microbial lipoproteins through            toll-like receptors</article-title><source><italic>Science</italic></source><volume>285</volume><fpage>732</fpage><lpage>736</lpage><pub-id pub-id-type="pmid">10426995</pub-id></mixed-citation></ref><ref id="ref11"><label>11</label><mixed-citation publication-type="journal"><name><surname>Poltorak</surname><given-names>A.</given-names></name><etal/><year>1998</year><article-title>Defective LPS signaling in C3H/HeJ and C57BL/10ScCr mice: mutations in Tlr4            gene</article-title><source><italic>Science</italic></source><volume>282</volume><fpage>2085</fpage><lpage>2088</lpage><pub-id pub-id-type="pmid">9851930</pub-id></mixed-citation></ref><ref id="ref12"><label>12</label><mixed-citation publication-type="journal"><name><surname>Akira</surname><given-names>S.</given-names></name><comment> and </comment><name><surname>Takeda</surname><given-names>K.</given-names></name><year>2004</year><article-title>Toll-like receptor signalling</article-title><source><italic>Nat Rev Immunol</italic></source><volume>4</volume><fpage>499</fpage><lpage>511</lpage><pub-id pub-id-type="pmid">15229469</pub-id></mixed-citation></ref><ref id="ref13"><label>13</label><mixed-citation publication-type="journal"><name><surname>Baggiolini</surname><given-names>M.</given-names></name><comment> and </comment><name><surname>Loetscher</surname><given-names>P.</given-names></name><year>2000</year><article-title>Chemokines in inflammation and immunity</article-title><source><italic>Immunol Today</italic></source><volume>21</volume><fpage>418</fpage><lpage>420</lpage><pub-id pub-id-type="pmid">10953090</pub-id></mixed-citation></ref><ref id="ref14"><label>14</label><mixed-citation publication-type="journal"><name><surname>Balkwill</surname><given-names>F.</given-names></name><year>1988</year><article-title>Cytokines-soluble factors in immune responses</article-title><source><italic>Curr Opin Immunol</italic></source><volume>1</volume><fpage>241<