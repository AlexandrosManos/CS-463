gn="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x0003c;0.001<sup>&#x0002a;</sup></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;N(&#x02212;)</td><td align="center" valign="top" charoff="50">153</td><td align="center" valign="top" charoff="50">67</td><td align="center" valign="top" charoff="50">86</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;N(&#x0002b;)</td><td align="center" valign="top" charoff="50">103</td><td align="center" valign="top" charoff="50">5</td><td align="center" valign="top" charoff="50">98</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50"><italic>TNM stage</italic></td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x0003c;0.001<sup>&#x0002a;</sup></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;I, II</td><td align="center" valign="top" charoff="50">72</td><td align="center" valign="top" charoff="50">72</td><td align="center" valign="top" charoff="50">0</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;III, IV</td><td align="center" valign="top" charoff="50">184</td><td align="center" valign="top" charoff="50">0</td><td align="center" valign="top" charoff="50">184</td><td align="center" valign="top" charoff="50">&#x000a0;</t