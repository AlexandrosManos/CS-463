/year><article-title>Apoptosis induction by antisense oligonucleotides against miR-17-5p and miR-20a in lung cancers overexpressing miR-17-92.</article-title><source>Oncogene</source><volume>26</volume><fpage>6099</fpage><lpage>6105</lpage><pub-id pub-id-type="pmid">17384677</pub-id></citation></ref><ref id="pone.0003694-Carleton1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carleton</surname><given-names>M</given-names></name><name><surname>Cleary</surname><given-names>MA</given-names></name><name><surname>Linsley</surname><given-names>PS</given-names></name></person-group><year>2007</year><article-title>MicroRNAs and cell cycle regulation.</article-title><source>Cell Cycle</source><volume>6</volume><fpage>2127</fpage><lpage>2132</lpage><pub-id pub-id-type="pmid">17786041</pub-id></citation></ref><ref id="pone.0003694-Poy1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Poy</surname><given-names>MN</given-names></name><name><surname>Eliasson</surname><given-names>L</given-names></name><name><surname>Krutzfeldt</surname><given-names>J</given-names></name><name><surname>Kuwajima</surname><given-names>S</given-names></name><name><surname>Ma</surname><given-names>X</given-names></name><etal/></person-group><year>2004</year><article-title>A pancreatic islet-specific microRNA regulates insulin secretion.</article-title><source>Nature</source><volume>432</volume><fpage>226</fpage><lpage>230</lpage><pub-id pub-id-type="pmid">15538371</pub-id></citation></ref><ref id="pone.0003694-Gauthier1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gauthier</surname><given-names>BR</given-names></name><name><surname>Wollheim</surname><given-names>CB</given-names></name></person-group><year>2006</year><article-title>MicroRNAs: &#x02018;ribo-regulators&#x02019; of glucose homeostasis.</article-title><source>N