><given-names>SG</given-names></name><name><surname>Perry</surname><given-names>IJ</given-names></name><name><surname>Shaper</surname><given-names>AG</given-names></name></person-group><article-title>Hematocrit and risk of NIDDM</article-title><source>Diabetes</source><year>1996</year><volume>45</volume><issue>5</issue><fpage>576</fpage><lpage>579</lpage><pub-id pub-id-type="pmid">8621006</pub-id></citation></ref><ref id="bib18"><label>18.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tulloch-Reid</surname><given-names>MK</given-names></name><name><surname>Hanson</surname><given-names>RL</given-names></name><name><surname>Saremi</surname><given-names>A</given-names></name><etal/></person-group><article-title>Hematocrit and the incidence of type 2 diabetes in the Pima Indians</article-title><source>Diabetes Care</source><year>2004</year><volume>27</volume><issue>9</issue><fpage>2245</fpage><lpage>2246</lpage><pub-id pub-id-type="pmid">15333493</pub-id></citation></ref><ref id="bib19"><label>19.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Medalie</surname><given-names>JH</given-names></name><name><surname>Papier</surname><given-names>CM</given-names></name><name><surname>Goldbourt</surname><given-names>U</given-names></name><etal/></person-group><article-title>Major factors in the development of diabetes mellitus in 10,000 men</article-title><source>Arch Intern Med</source><year>1975</year><volume>135</volume><issue>6</issue><fpage>811</fpage><lpage>817</lpage><pub-id pub-id-type="pmid">1130926</pub-id></citation></ref><ref id="bib20"><label>20.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wilson</surname><given-names>PW</given-names></name><name><surname>McGee</surname><given-names>DL</given-names></name><name><surname>Kannel</surname><given-names>WB</given-names></name></person-group><article-title>Obesity, very 