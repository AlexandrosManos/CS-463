group person-group-type="author"><name><surname>Purcell</surname><given-names>AH</given-names></name><name><surname>Hopkins</surname><given-names>DL</given-names></name></person-group><article-title>Fastidious xylem-limited bacterial plant pathogens</article-title><source>Ann Rev of Phytopath</source><year>1996</year><volume>34</volume><fpage>131</fpage><lpage>151</lpage><pub-id pub-id-type="doi">10.1146/annurev.phyto.34.1.131</pub-id></citation></ref></ref-list></back></article>