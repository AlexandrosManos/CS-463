lume><fpage>64</fpage><comment>2006 Sep 2</comment><pub-id pub-id-type="pmid">16995935</pub-id><pub-id pub-id-type="doi">10.1186/1477-7525-4-64</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>CS</given-names></name><name><surname>Morris</surname><given-names>M</given-names></name><name><surname>Hill</surname><given-names>W</given-names></name><name><surname>Francovich</surname><given-names>C</given-names></name><name><surname>McMullin</surname><given-names>J</given-names></name><name><surname>Chavez</surname><given-names>L</given-names></name><name><surname>Rhoads</surname><given-names>C</given-names></name></person-group><article-title>Cultural consensus analysis as a tool for clinic improvements</article-title><source>Journal of General Internal Medicine</source><year>2004</year><volume>19</volume><fpage>514</fpage><lpage>18</lpage><pub-id pub-id-type="pmid">15109315</pub-id><pub-id pub-id-type="doi">10.1111/j.1525-1497.2004.30061.x</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Murray</surname><given-names>CD</given-names></name><name><surname>Rhodes</surname><given-names>K</given-names></name></person-group><article-title>'Nobody likes damaged goods': the Experience of adult visible acne</article-title><source>British Journal of Health Psychology</source><year>2005</year><volume>10</volume><fpage>183</fpage><lpage>202</lpage><pub-id pub-id-type="pmid">15969849</pub-id><pub-id pub-id-type="doi">10.1348/135910705X26128</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Atkinson</surname><given-names>MJ</given-names></name><name><surname>Sinha</surname><given-names>A</given-names></name><name><surname>Hass</surname><given-names>SL</given-names></name><etal></etal></person-group><article-title>Validation of a general measure of treatment satisfaction, the Treatment Satisfaction Questionnaire for Medication (TSQM), using a national panel study of chronic disease</article-title><source>Health and Quality of Life Outcomes</source><year>2004</year><volume>26</volume><fpage>12</fpage><pub-id pub-id-type="pmid">14987333</pub-id><pub-id pub-id-type="doi">10.1186/1477-7525-2-12</pub-id></citation></ref></ref-list></back></article>