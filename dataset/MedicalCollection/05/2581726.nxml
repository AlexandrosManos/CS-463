age><pub-id pub-id-type="pmid">6534449</pub-id></citation></ref><ref id="B8"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tan</surname><given-names>BJ</given-names></name><name><surname>Ost</surname><given-names>MC</given-names></name><name><surname>Lee</surname><given-names>BR</given-names></name></person-group><article-title>Laparoscopic nephroureterectomy with bladder-cuff resection: techniques and outcomes</article-title><source><italic>Journal of Endourology</italic></source><year>2005</year><volume>19</volume><issue>6</issue><fpage>664</fpage><lpage>676</lpage><pub-id pub-id-type="pmid">16053355</pub-id></citation></ref><ref id="B9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McDonald</surname><given-names>HP</given-names></name><name><surname>Upchurch</surname><given-names>WE</given-names></name><name><surname>Surdevant</surname><given-names>CE</given-names></name></person-group><article-title>Nephroureterectomy: a new technique</article-title><source><italic>The Journal of Urology</italic></source><year>1952</year><volume>67</volume><fpage>p. 804</fpage></citation></ref><ref id="B10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Strong</surname><given-names>DW</given-names></name><name><surname>Pearse</surname><given-names>HD</given-names></name></person-group><article-title>Recurrent urothelial tumors following surgery for transitional cell carcinoma of the upper urinary tract</article-title><source><italic>Cancer</italic></source><year>1976</year><volume>38</volume><issue>5</issue><fpage>2178</fpage><lpage>2183</lpage></citation></ref><ref id="B11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kakizoe</surname><given-names>T</given-names></name><name><surname>Fujita</surname><given-names>J</given-names></name><name><surname>Murase</surname><given-names>T</given-names></name><name><surname>Matsumoto</surname><given-names>K</given-names></name><name><surname>Kishi</surname><given-names>K</given-names></name></person-group><article-title>Transitional cell carcinoma of the bladder in patients with renal pelvic and ureteral cancer</article-title><source><italic>The Journal of Urology</italic></source><year>1980</year><volume>124</volume><issue>1</issue><fpage>17</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">7411712</pub-id></citation></ref><ref id="B12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Murphy</surname><given-names>DM</given-names></name><name><surname>Zincke</surname><given-names>H</given-names></name><name><surname>Furlow</surname><given-names>WL</given-names></name></person-group><article-title>Management of high grade transitional cell cancer of the upper urinary tract</article-title><source><italic>The Journal of Urology</italic></source><year>1981</year><volume>125</volume><issue>1</issue><fpage>25</fpage><lpage>29</lpage><pub-id pub-id-type="pmid">7463577</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Palou</surname><given-names>J</given-names></name><name><surname>Caparr&#x000f3;s</surname><given-names>J</given-names></name><name><surname>Orsola</surname><given-names>A</given-names></name><name><surname>Xavier</surname><given-names>B</given-names></name><name><surname>Vicente</surname><given-names>J</given-names></name></person-group><article-title>Transurethral resection of the intramural ureter as the first step of nephroureterectomy</article-title><source><italic>The Journal of Urology</italic></source><year>1995</year><volume>154</volume><issue>1</issue><fpage>43</fpage><lpage>44</lpage><pub-id pub-id-type="pmid">7776453</pub-id></citation></ref><ref id="B14"><label>14</label><citation citation-t