age>1019</fpage><lpage>1024</lpage><pub-id pub-id-type="pmid">17941779</pub-id></citation></ref><ref id="B17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Micali</surname><given-names>S</given-names></name><name><surname>Celia</surname><given-names>A</given-names></name><name><surname>Bove</surname><given-names>P</given-names></name><etal/></person-group><article-title>Tumor seeding in urological laparoscopy: an international survey</article-title><source><italic>The Journal of Urology</italic></source><year>2004</year><volume>171</volume><issue>6, part 1</issue><fpage>2151</fpage><lpage>2154</lpage><pub-id pub-id-type="pmid">15126775</pub-id></citation></ref><ref id="B18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Laguna</surname><given-names>MP</given-names></name><name><surname>de la Rosette</surname><given-names>JJMCH</given-names></name></person-group><article-title>The endoscopic approach to the distal ureter in nephroureterectomy for upper urinary tract tumor</article-title><source><italic>The Journal of Urology</italic></source><year>2001</year><volume>166</volume><issue>6</issue><fpage>2017</fpage><lpage>2022</lpage><pub-id pub-id-type="pmid">11696698</pub-id></citation></ref><ref id="B19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hetherington</surname><given-names>JW</given-names></name><name><surname>Ewing</surname><given-names>R</given-names></name><name><surname>Philip</surname><given-names>NH</given-names></name></person-group><article-title>Modified nephroureterectomy: a risk of tumor implantation</article-title><source><italic>British Journal of Urology</italic></source><year>1986</year><volume>58</volume><issue>4</issue><fpage>368</fpage><lpage>370</lpage><pub-id pub-id-type="pmid">3756402</pub-id></citation></ref><ref id="B20"><label>20</label><citation citatio