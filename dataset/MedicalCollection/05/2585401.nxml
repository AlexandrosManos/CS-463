har="." valign="top">70</td><td colspan="1" rowspan="1" align="center" valign="top">&#x02014;</td><td colspan="1" rowspan="1" align="char" char="." valign="top">30</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;PAC Left</td><td colspan="1" rowspan="1" align="char" char="." valign="top">&#x02212;44</td><td colspan="1" rowspan="1" align="char" char="." valign="top">&#x02212;26</td><td colspan="1" rowspan="1" align="char" char="." valign="top">14</td><td colspan="1" rowspan="1" align="char" char="." valign="top">3.39</td><td colspan="1" rowspan="1" align="char" char="." valign="top">90</td><td colspan="1" rowspan="1" align="char" char="." valign="top">10</td><td colspan="1" rowspan="1" align="center" valign="top">&#x02014;</td></tr><tr><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="char" char="." valign="top">&#x02212;50</td><td colspan="1" rowspan="1" align="char" char="." valign="top">&#x02212;22</td><td colspan="1" rowspan="1" align="char" char="." valign="top">10</td><td colspan="1" rowspan="1" align="char" char="." valign="top">3.15</td><td colspan="1" rowspan="1" align="char" char="." valign="top">80</td><td colspan="1" rowspan="1" align="char" char="." valign="top">10</td><td colspan="1" rowspan="1" align="char" char="." valign="top">20</td></tr></tbody></table><table-wrap-foot><fn><p>Center refers to 0-&#x003bc;s ITD; x, y, z are MNI coordinates of the local maxima (in millimeters); Z is the standard score; TE1.0, TE1.1, and TE1.2 refer to the probability maps for primary auditory cortex as defined by <xref ref-type="bibr" rid="r22">Morosan et al. (2001)</xref>. The values represent the percentage probability that the maximum voxel of the cluster is located in the region.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>