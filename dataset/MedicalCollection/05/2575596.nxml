on-group><article-title>Effect of hyperglycemia and hyperinsulinemia on the response of IL-6, TNF-alpha, and FFAs to low-dose endotoxemia in humans</article-title><source>Am J Physiol Endocrinol Metab</source><year>2004</year><volume>286</volume><fpage>E766</fpage><lpage>E772</lpage><pub-id pub-id-type="pmid">14722028</pub-id><pub-id pub-id-type="doi">10.1152/ajpendo.00468.2003</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marfella</surname><given-names>R</given-names></name><name><surname>Esposito</surname><given-names>K</given-names></name><name><surname>Giunta</surname><given-names>R</given-names></name><name><surname>Coppola</surname><given-names>G</given-names></name><name><surname>De Angelis</surname><given-names>L</given-names></name><name><surname>Farzati</surname><given-names>B</given-names></name><name><surname>Paolisso</surname><given-names>G</given-names></name><name><surname>Giugliano</surname><given-names>D</given-names></name></person-group><article-title>Circulating adhesion molecules in humans: role of hyperglycemia and hyperinsulinemia</article-title><source>Circulation</source><year>2000</year><volume>101</volume><fpage>2247</fpage><lpage>2251</lpage><pub-id pub-id-type="pmid">10811590</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hansen</surname><given-names>TK</given-names></name><name><surname>Thiel</surname><given-names>S</given-names></name><name><surname>Wouters</surname><given-names>PJ</given-names></name><name><surname>Christiansen</surname><given-names>JS</given-names></name><name><surname>Berghe</surname><given-names>G Van den</given-names></name></person-group><article-title>Intensive insulin therapy exerts antiinflammatory effects in critically ill patients and counteracts the adverse effect of low mannose-binding lectin levels</article-title><source>J Clin Endocrinol Metab</source><year>2003</year><volume>88</volume><fpage>1082</fpage><lpage>1088</lpage><pub-id pub-id-type="pmid">12629088</pub-id><pub-id pub-id-type="doi">10.1210/jc.2002-021478</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weekers</surname><given-names>F</given-names></name><name><surname>Giulietti</surname><given-names>AP</given-names></name><name><surname>Michalaki</surname><given-names>M</given-names></name><name><surname>Coopmans</surname><given-names>W</given-names></name><name><surname>Van Herck</surname><given-names>E</given-names></name><name><surname>Mathieu</surname><given-names>C</given-names></name><name><surname>Berghe</surname><given-names>G Van den</given-names></name></person-group><article-title>Metabolic, endocrine, and immune effects of stress hyperglycemia in a rabbit model of prolonged critical illness</article-title><source>Endocrinology</source><year>2003</year><volume>144</volume><fpage>5329</fpage><lpage>5338</lpage><pub-id pub-id-type="pmid">12960028</pub-id><pub-id pub-id-type="doi">10.1210/en.2003-0697</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brix-Christensen</surname><given-names>V</given-names></name><name><surname>Gjedsted</surname><given-names>J</given-names></name><name><surname>Andersen</surname><given-names>SK</given-names></name><name><surname>Vestergaard</surname><given-names>C</given-names></name><name><surname>Nielsen</surname><given-names>J</given-names></name><name><surname>Rix</surname><given-names>T</given-names></name><name><surname>Nyboe</surname><given-names>R</given-names></name><name><surname>Andersen</surname><given-names>NT</given-names></name><name><surname>Larsson</surname><given-names>A</given-names></name><name><surname>Schmitz</surname><given-names>O</given-names></name><name><surname>T&#x000f8;nnesen</surname><given-names>E</given-names></name>