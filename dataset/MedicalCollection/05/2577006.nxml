e><name><surname>Honeycutt</surname><given-names>RJ</given-names></name></person-group><year>1993</year><article-title>High output genetic mapping of polyploids using PCR-generated markers</article-title><source>Theor Appl Genet</source><volume>86</volume><fpage>105</fpage><lpage>112</lpage></citation></ref><ref id="pone.0003701-Tada1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tada</surname><given-names>M</given-names></name><name><surname>Omata</surname><given-names>M</given-names></name><name><surname>Kawai</surname><given-names>S</given-names></name><name><surname>Saisho</surname><given-names>H</given-names></name><name><surname>Ohto</surname><given-names>M</given-names></name><etal/></person-group><year>1993</year><article-title>Detection of ras gene mutations in pancreatic juice and peripheral blood of patients with pancreatic adenocarcinoma.</article-title><source>Cancer Res</source><volume>53</volume><fpage>2472</fpage><lpage>2474</lpage><pub-id pub-id-type="pmid">8495407</pub-id></citation></ref><ref id="pone.0003701-LiquiChip1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>LiquiChip</surname></name></person-group><year>2003</year><article-title>LiquiChip Applications Handbook for protein-based suspension arrays.</article-title><source>QIAGEN</source><fpage>21</fpage></citation></ref><ref id="pone.0003701-Haugland1"><label>24</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Haugland</surname><given-names>RP</given-names></name></person-group><year>2005</year><article-title>Labeling Oligonucleotides and Nucleic Acids.</article-title><person-group person-group-type="editor"><name><surname>Spence</surname><given-names>MTZ</given-names></name></person-group><source>The Handbook A Guide to Fluorescent Probes and Labeling Technologies</source><publisher-loc>U.S.A.</publisher-loc><publisher-name>Invitrogen Corp</publisher-name><fpage>339</fpage></citation></ref><ref id="pone.0003701-Zsolnai1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zsolnai</surname><given-names>A</given-names></name><name><surname>Anton</surname><given-names>I</given-names></name><name><surname>Kuhn</surname><given-names>C</given-names></name><name><surname>Fesus</surname><given-names>L</given-names></name></person-group><year>2003</year><article-title>Detection of single-nucleotide polymorphisms coding for three ovine prion protein variants by primer extension assay and capillary electrophoresis.</article-title><source>Electrophoresis</source><volume>24</volume><fpage>634</fpage><lpage>638</lpage><pub-id pub-id-type="pmid">12601731</pub-id></citation></ref></ref-list><fn-group><fn fn-type="conflict"><p><bold>Competing Interests: </bold>China and US patent pending.</p></fn><fn fn-type="financial-disclosure"><p><bold>Funding: </bold>This study was supported by the National Natural Science Foundation of China (30771090) to Wei Liu.</p></fn></fn-group></back></article>