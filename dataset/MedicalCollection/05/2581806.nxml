n-group><year>2004</year><article-title>Antibacterial resistance worldwide: Causes, challenges and responses.</article-title><source>Nat Med</source><volume>10</volume><issue>(12)</issue><supplement>SUPPL.</supplement><fpage>S122</fpage><lpage>S129</lpage><pub-id pub-id-type="pmid">15577930</pub-id></citation></ref><ref id="pone.0003749-Mead1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mead</surname><given-names>PS</given-names></name><etal/></person-group><year>1999</year><article-title>Food-related illness and death in the United States.</article-title><source>Emerg Infect Dis</source><volume>5</volume><issue>(5)</issue><fpage>607</fpage><lpage>625</lpage><pub-id pub-id-type="pmid">10511517</pub-id></citation></ref><ref id="pone.0003749-Mlbak1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>M&#x000f8;lbak</surname><given-names>K</given-names></name><etal/></person-group><year>1999</year><article-title>An outbreak of multidrug-resistant, quinolone-resistant Salmonella enterica serotype Typhimurium DT104.</article-title><source>New Engl J Med</source><volume>341</volume><issue>(19)</issue><fpage>1420</fpage><lpage>1425</lpage><pub-id pub-id-type="pmid">10547404</pub-id></citation></ref><ref id="pone.0003749-Baggesen1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Baggesen</surname><given-names>DL</given-names></name></person-group><year>2000</year><article-title>Characterization of <italic>Salmonella enterica</italic> serovar Typhimurium DT104 isolated from Denmark and comparison with isolates from Europe and the United States.</article-title><source>J Clin Microbiol</source><volume>38</volume><issue>(4)</issue><fpage>1581</fpage><lpage>1586</lpage><pub-id pub-id-type="pmid">10747147</pub-id></citation></ref><ref id="pone.0003749-Poppe1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Poppe</surname><given-names>C</given-names></name></person-group><year>2002</year><article-title>Diversity in antimicrobial resistance and other characteristics among <italic>Salmonella typhimurium</italic> DT104 isolates.</article-title><source>Microb Drug Resist</source><volume>8</volume><issue>(2)</issue><fpage>107</fpage><lpage>122</lpage><pub-id pub-id-type="pmid">12118515</pub-id></citation></ref><ref id="pone.0003749-Gebreyes1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gebreyes</surname><given-names>WA</given-names></name></person-group><year>2004</year><article-title>Trends in antimicrobial resistance, phage types and integrons among <italic>Salmonella</italic> serotypes from pigs, 1997&#x02013;2000.</article-title><source>J Antimicrob Chemother</source><volume>53</volume><issue>(6)</issue><fpage>997</fpage><lpage>1003</lpage><pub-id pub-id-type="pmid">15150175</pub-id></citation></ref><ref id="pone.0003749-Zhao1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zhao</surname><given-names>S</given-names></name><etal/></person-group><year>2006</year><article-title>Characterization of antimicrobial-resistant <italic>Salmonella</italic> isolated from imported foods.</article-title><source>J Food Protection</source><volume>69</volume><issue>(3)</issue><fpage>500</fpage><lpage>507</lpage></citation></ref><ref id="pone.0003749-Perron1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Perron</surname><given-names>GG</given-names></name></person-group><year>2007</year><article-title>Genotypic diversity and antimicrobial resistance in asymptomatic <italic>Salmonella enterica</italic> serotype Typhimurium DT104.</article-title><source>Infec Genet Evol</source><volume>7</volume><issue>(2)</issue><fpage>223</fpage><lpage>228</lpage><pub-id pub-id-type="pmid">17049315</pub-id></citation></ref><ref id="pone.0003749-Adaska1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adaska</surname><given-names>JM</given-names></name></person-group><year>2008</year><article-title>Comparison of <italic>Salmonella enterica</italic> subspecies <italic>enterica</italic> serovar Typhimurium isolates from dairy cattle and humans using in vitro assays of virulence.</article-title><source>Vet Microbiol</source><volume>128</volume><issue>(1&#x02013;2)</issue><fpage>90</fpage><lpage>95</lpage><pub-id pub-id-type="pmid">17964087</pub-id></citation></ref><ref id="pone.0003749-Bahnson1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bahnson</surname><given-names>PB</given-names></name></person-group><year>2005</year><article-title>Associations between on-farm and slaughter plant detection of <italic>Salmonella</italic> in market-weight pigs.</article-title><source>J Food Protection</source><volume>68</volume><issue>(2)</issue><fpage>246</fpage><lpage>250</lpage></citation></ref><ref id="pone.0003749-Belil1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bel&#x00153;il</surname><given-names>PA</given-names></name><etal/></person-group><year>2004</year><article-title>Risk factors for <italic>Salmonella enterica</italic> subsp. <italic>enterica</italic> shedding by market-age pigs in French farrow-to-finish herds.</article-title><source>Prev Vet Med</source><volume>63</volume><issue>(1&#x02013;2)</issue><fpage>103</fpage><lpage>120</lpage><pub-id pub-id-type="pmid">15099720</pub-id></citation></ref><ref id="pone.0003749-Threlfall1"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Threlfall</surname><given-names>EJ</given-names></name></person-group><year>2000</year><article-title>Epidemic <italic>Salmonella typhimurium</italic> DT 104-A truly international multiresistant clone.</article-title><source>J Antimicrob Chemother</source><volume>46</volume><issue>(1)</issue><fpage>7</fpage><lpage>10</lpage><pub-id pub-id-type="pmid">10882682</pub-id></citation></ref><ref id="pone.0003749-Hauser1"><label>27</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hauser</surname><given-names>AR</given-names></name></person-group><year>2007</year><source>Antibiotics basics for clinicians: Choosing the right antibacterial agent</source><publisher-loc>Baltimore, MD, USA</publisher-loc><publisher-name>Lippincott Williams &#x00026; Wilkins</publisher-name><fpage>318</fpage></citation></ref><ref id="pone.0003749-Witte1"><label>28</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Witte</surname><given-names>W</given-names></name></person-group><year>2000</year><article-title>Selective pressure by antibiotic use in livestock.</article-title><source>Int J Antimicrob Agents</source><volume>16</volume><issue>SUPPL. 1</issue><issue>21</issue><fpage>S19</fpage><lpage>S24</lpage><pub-id pub-id-type="pmid">11137404</pub-id></citation></ref><ref id="pone.0003749-Smith1"><label>29</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>JM</given-names></name></person-group><year>1993</year><article-title>How clonal are bacteria?</article-title><source>Proc Natl Acad Sci USA</source><volume>90</volume><issue>(10)</issue><fpage>4384</fpage><lpage>4388</lpage><pub-id pub-id-type="pmid">8506277</pub-id></citation></ref><ref id="pone.0003749-Ribot1"><label>30</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ribot</surname><given-names>EM</given-names></name></person-group><year>2002</year><article-title><italic>Salmonella enterica</italic> serotype Typhimurium DT104 isolated from huma