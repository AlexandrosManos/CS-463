on citation-type="journal"><person-group person-group-type="author"><name><surname>Bouvier</surname><given-names>AM</given-names></name><name><surname>Launoy</surname><given-names>G</given-names></name><name><surname>Lepage</surname><given-names>C</given-names></name><name><surname>Faivre</surname><given-names>J</given-names></name></person-group><article-title>Trends in the management and survival of digestive tract cancers among patients aged over 80 years</article-title><source>Aliment Pharmacol Ther</source><year>2005</year><volume>22</volume><fpage>233</fpage><lpage>241</lpage><!--PubMed citation query: 'Aliment Pharmacol Ther||22|233||bib7|'--><pub-id pub-id-type="pmid">16091061</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burtin</surname><given-names>P</given-names></name><name><surname>Bouch&#x000e9;</surname><given-names>O</given-names></name><name><surname>Giovannini</surname><given-names>M</given-names></name><name><surname>Pelletier</surname><given-names>M</given-names></name><name><surname>Conroy</surname><given-names>T</given-names></name><name><surname>Ruget</surname><given-names>O</given-names></name><name><surname>Ars&#x000e8;ne</surname><given-names>D</given-names></name><name><surname>Milan</surname><given-names>C</given-names></name><name><surname>Bedenne</surname><given-names>L</given-names></name></person-group><article-title>Endoscopic ultrasonography is an independent predictive factor of prognosis in locally advanced esophageal cancer. Results from the randomized FFCD 9102 study from the F&#x000e9;d&#x000e9;ration Francophone de Canc&#x000e9;rologie Digestive</article-title><source>Gastroenterol Clin Biol</source><year>2008</year><volume>32</volume><fpage>213</fpage><lpage>220</lpage><!--PubMed citation query: 'Gastroenterol Clin Biol||32|213||bib8|'--><pub-id pub-id-type="pmid">18372134</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coia</surname><given-names>LR</given-names></name><name><surname>Minsky</surname><given-names>BD</given-names></name><name><surname>Berkey</surname><given-names>BA</given-names></name><name><surname>John</surname><given-names>MJ</given-names></name><name><surname>Haller</surname><given-names>D</given-names></name><name><surname>Landry</surname><given-names>J</given-names></name><name><surname>Pisansky</surname><given-names>TM</given-names></name><name><surname>Willett</surname><given-names>CG</given-names></name><name><surname>Hoffman</surname><given-names>JP</given-names></name><name><surname>Owen</surname><given-names>JB</given-names></name><name><surname>Hanks</surname><given-names>GE</given-names></name></person-group><article-title>Outcome of patients receiving radiation for cancer of the esophagus: results of the 1992&#x02013;1994 patterns of care study</article-title><source>J Clin Oncol</source><year>2000</year><volume>18</volume><fpage>455</fpage><lpage>462</lpage><!--PubMed citation query: 'J Clin Oncol||18|455||bib9|'--><pub-id pub-id-type="pmid">10653860</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cranea</surname><given-names>LM</given-names></name><name><surname>Schaapveldb</surname><given-names>M</given-names></name><name><surname>Visserc</surname><given-names>O</given-names></name><name><surname>Louwmand</surname><given-names>MW</given-names></name><name><surname>Plukkera</surname><given-names>JT</given-names></name><name><surname>van Dama</surname><given-names>JM</given-names></name></person-group><article-title>Oesophageal cancer in the Netherlands: increasing incidence and mortality but improving survival</article-title><source>Eur J cancer</source><year>2007</year><volume>43</volume><fpage>1445</fpage><lpage>1451</lpage><!--PubMed citation query: 'Eur J cancer||43|1445||bib10|'--><pub-id pub-id-type="pmid">17512189</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Di Fiore</surname><given-names>F</given-names></name><name><surname>Lecleire</surname><given-names>S</given-names></name><name><surname>Galais</surname><given-names>MP</given-names></name><name><surname>Rigal</surname><given-names>O</given-names></name><name><surname>Vi&#x000e9;</surname><given-names>B</given-names></name><name><surname>David</surname><given-names>I</given-names></name><name><surname>Hamidou</surname><given-names>H</given-names></name><name><surname>Paillot</surname><given-names>B</given-names></name><name><surname>Jacob</surname><given-names>JH</given-names></name><name><surname>Michel</surname><given-names>P</given-names></name></person-group><article-title>Impact of radiation schedule and chemotherapy duration in definitive chemoradiotherapy regimen for esophageal cancer</article-title><source>Gastroenterol Clin Biol</source><year>2006b</year><volume>30</volume><fpage>845</fpage><lpage>851</lpage><!--PubMed citation query: 'Gastroenterol Clin Biol||30|845||bib11|'--><pub-id pub-id-type="pmid">16885868</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Di Fiore</surname><given-names>F</given-names></name><name><surname>Lecleire</surname><given-names>S</given-names></name><name><surname>Rigal</surname><given-names>O</given-names></name><name><surname>Galais</surname><given-names>MP</given-names></name><name><surname>Ben Soussan</surname><given-names>E</given-names></name><name><surname>David</surname><given-names>I</given-names></name><name><surname>Paillot</surname><given-names>B</given-names></name><name><surname>Jacob</surname><given-names>JH</given-names></name><name><surname>Michel</surname><given-names>P</given-names></name></person-group><article-title>Predictive factors of survival in patients treated with definitive chem