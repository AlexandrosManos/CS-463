><given-names>NT</given-names></name><name><surname>Schneider</surname><given-names>JS</given-names></name><name><surname>Bach</surname><given-names>J</given-names></name><name><surname>Pilat</surname><given-names>J</given-names></name><name><surname>Beckett</surname><given-names>LA</given-names></name><name><surname>Arnold</surname><given-names>SE</given-names></name><name><surname>Evans</surname><given-names>DA</given-names></name><etal></etal></person-group><article-title>Depressive symptoms, cognitive decline, and risk of AD in older persons</article-title><source>Neurology</source><year>2002</year><volume>59</volume><fpage>364</fpage><lpage>370</lpage><pub-id pub-id-type="pmid">12177369</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cankurtaran</surname><given-names>M</given-names></name><name><surname>Yavuz</surname><given-names>BB</given-names></name><name><surname>Cankurtaran</surname><given-names>ES</given-names></name><name><surname>Halil</surname><given-names>M</given-names></name><name><surname>Ulger</surname><given-names>Z</given-names></name><name><surname>Ariogul</surname><given-names>S</given-names></name></person-group><article-title>Risk factors and type of dementia: Vascular or Alzheimer?</article-title><source>Archives of gerontology and geriatrics</source><year>2008</year><volume>47</volume><fpage>25</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">17692938</pub-id><pub-id pub-id-type="doi">10.1016/j.archger.2007.06.005</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bermejo</surname><given-names>F</given-names></name><name><surname>Alom</surname><given-names>J</given-names></name><name><surname>Pena-Casanova</surname><given-names>J</given-names></name><name><surname>del Ser</surname><given-names>T</given-names></name><name><surname>Acarin</surname><given-names>N</given-names></name><n