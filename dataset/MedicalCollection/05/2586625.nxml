on citation-type="journal"><person-group person-group-type="author"><name><surname>Moreiras-Varela</surname><given-names>O</given-names></name></person-group><article-title>The Mediterranean diet in Spain</article-title><source>Eur J Clin Nutr</source><year>1989</year><volume>43</volume><fpage>83</fpage><lpage>87</lpage><pub-id pub-id-type="pmid">2598900</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Perez-Jimenez</surname><given-names>F</given-names></name><name><surname>Alvarez de Cienfuegos</surname><given-names>G</given-names></name><name><surname>Badimon</surname><given-names>L</given-names></name><name><surname>Barja</surname><given-names>G</given-names></name><name><surname>Battino</surname><given-names>M</given-names></name><name><surname>Blanco</surname><given-names>A</given-names></name><name><surname>Bonanome</surname><given-names>A</given-names></name><name><surname>Colomer</surname><given-names>R</given-names></name><name><surname>Corella-Piquer</surname><given-names>D</given-names></name><name><surname>Covas</surname><given-names>I</given-names></name><name><surname>Chamorro-Quiros</surname><given-names>J</given-names></name><name><surname>Escrich</surname><given-names>E</given-names></name><name><surname>Gaforio</surname><given-names>JJ</given-names></name><name><surname>Garcia Luna</surname><given-names>PP</given-names></name><name><surname>Hidalgo</surname><given-names>L</given-names></name><name><surname>Kafatos</surname><given-names>A</given-names></name><name><surname>Kris-Etherton</surname><given-names>PM</given-names></name><name><surname>Lairon</surname><given-names>D</given-names></name><name><surname>Lamuela-Raventos</surname><given-names>R</given-names></name><name><surname>Lopez-Miranda</surname><given-names>J</given-names></name><name><surname>Lopez-Segura</surname><given-names>F</given-names></name><name><surname>Martinez-Gonzalez</surname><given-names>MA</