e><pub-id pub-id-type="pmid">17543694</pub-id><pub-id pub-id-type="doi">10.1016/j.jvs.2006.08.088</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Keeling</surname><given-names>AN</given-names></name><name><surname>Naughton</surname><given-names>PA</given-names></name><name><surname>Leahy</surname><given-names>AL</given-names></name><name><surname>Lee</surname><given-names>MJ</given-names></name></person-group><article-title>Traumatic inferior gluteal artery pseudoaneurysm and arteriovenous fistula managed with emergency transcatheter embolization</article-title><source>Cardiovasc Intervent Radiol</source><year>2008</year><volume>31</volume><fpage>S135</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">17710471</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mavili</surname><given-names>E</given-names></name><name><surname>Donmez</surname><given-names>H</given-names></name><name><surname>Ozcan</surname><given-names>N</given-names></name><etal></etal></person-group><article-title>Endovascular treatment of lower limb penetrating arterial traumas</article-title><source>Cardiovasc Intervent Radiol</source><year>2007</year><volume>30</volume><fpage>1124</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">17682819</pub-id><pub-id pub-id-type="doi">10.1007/s00270-007-9142-2</pub-id></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cormack</surname><given-names>CG</given-names></name><name><surname>Labmerty</surname><given-names>SG</given-names></name></person-group><source>The arterial anatomy of skin flaps</source><year>1994</year><edition>2</edition><publisher-name>Churchill Livingstone, Edinburgh</publisher-name><fpage>218</fpage><lpage>25</lpage></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Song</surname><given-names>WC</given-names></name><name><surname>Bae</surname><given-names>SM</given-names></name><name><surname>Han</surname><given-names>SH</given-names></name><etal></etal></person-group><article-title>Anatomical and radiological study of the superior and inferior gluteal arteries in the gluteus maximus muscle for musculocutaneous flap in Koreans</article-title><source>J Plast Reconstr Aesthet Surg</source><year>2006</year><volume>59</volume><fpage>935</fpage><lpage>41</lpage><pub-id pub-id-type="pmid">16920585</pub-id><pub-id pub-id-type="doi">10.1016/j.bjps.2005.11.028</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ahmadzadeh</surname><given-names>R</given-names></name><name><surname>Bergeron</surname><given-names>L</given-names></name><name><surname>Tang</surname><given-names>M</given-names></name><etal></etal></person-group><article-title>The superior and inferior gluteal artery perforator flaps</article-title><source>Plast Reconstr Surg</source><year>2007</year><volume>120</volume><fpage>1551</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">18040187</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kuzuya</surname><given-names>A</given-names></name><name><surname>Fujimoto</surname><given-names>K</given-names></name><name><surname>Iyomasa</surname><given-names>S</given-names></name><etal></etal></person-group><article-title>Transluminal coil embolization of an inferior gluteal artery aneurysm by ultrasound-guided direct puncture of the target vessel</article-title><source>Eur J Vasc Endovasc Surg</source><year>2005</year><volume>30</volume><fpage>130</fpage><lpage>2</lpage><pub-id pub-id-type="pmid">15890542</pub-id><pub-id pub-id-type="doi">10.1016/j.ejvs.2005.03.006</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-