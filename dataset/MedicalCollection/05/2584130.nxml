rowspan="1" align="center" valign="top"><italic>4</italic></td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;Thiazolidinediones</td><td colspan="1" rowspan="1" align="center" valign="top"><italic>1</italic></td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;Insulin</td><td colspan="1" rowspan="1" align="center" valign="top"><italic>2</italic></td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Dyslipidemia (<italic>n</italic> &#x0005b;&#x00025;&#x0005d;)</td><td colspan="1" rowspan="1" align="center" valign="top">7 (19)</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;Statins</td><td colspan="1" rowspan="1" align="center" valign="top"><italic>5</italic></td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;Fibrates</td><td colspan="1" rowspan="1" align="center" valign="top"><italic>2</italic></td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Obstructive sleep apnea (<italic>n</italic> &#x0005b;&#x00025;&#x0005d;)</td><td colspan="1" rowspan="1" align="center" valign="top">25 (69)</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;Continuous positive airway pressure</td><td colspan="1" rowspan="1" align="center" valign="top">25</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Asthma (<italic>n</italic> &#x0005b;&#x00025;&#x0005d;)</td><td colspan="1" rowspan="1" align="center" valign="top">5 (14)</td></tr></tbody></table><table-wrap-foot><fn><p>Data are means &#x000b1; SD or <italic>n</italic> (&#x00025;) of patients. Apnea-hypopnea index &#x0003e;10 indicates obstructive sleep apnea syndrome. Blood pressure was measured at rest with an automatic device. Apnea-hypopnea index was measured by ambulatory polysomnography.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>