<given-names>RH</given-names></name></person-group><year>2007</year><article-title>Regulation of vascular morphogenesis by Notch signaling.</article-title><source>Genes Dev</source><volume>21</volume><fpage>2511</fpage><lpage>24</lpage><pub-id pub-id-type="pmid">17938237</pub-id></citation></ref><ref id="pone.0003752-Nakajima1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nakajima</surname><given-names>M</given-names></name><name><surname>Yuasa</surname><given-names>S</given-names></name><name><surname>Ueno</surname><given-names>M</given-names></name><name><surname>Takakura</surname><given-names>N</given-names></name><name><surname>Koseki</surname><given-names>H</given-names></name><etal/></person-group><year>2003</year><article-title>Abnormal blood vessel development in mice lacking presenilin-1.</article-title><source>Mech Dev</source><volume>120</volume><fpage>657</fpage><lpage>67</lpage><pub-id pub-id-type="pmid">12834865</pub-id></citation></ref><ref id="pone.0003752-Limbourg1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Limbourg</surname><given-names>FP</given-names></name><name><surname>Takeshita</surname><given-names>K</given-names></name><name><surname>Radtke</surname><given-names>F</given-names></name><name><surname>Bronson</surname><given-names>RT</given-names></name><name><surname>Chin</surname><given-names>MT</given-names></name><etal/></person-group><year>2005</year><article-title>Essential role of endothelial Notch1 in angiogenesis.</article-title><source>Circulation</source><volume>111</volume><fpage>1826</fpage><lpage>32</lpage><pub-id pub-id-type="pmid">15809373</pub-id></citation></ref><ref id="pone.0003752-Krebs1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Krebs</surname><given-names>LT</given-names></name><name><surname>Shutter</surname><given-names>JR</given-