iven-names>O</given-names></name><etal></etal></person-group><article-title>A unified classification system for eukaryotic transposable elements</article-title><source>Nature Rev Genet</source><year>2007</year><volume>8</volume><fpage>973</fpage><lpage>982</lpage><pub-id pub-id-type="pmid">17984973</pub-id><pub-id pub-id-type="doi">10.1038/nrg2165</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Finnegan</surname><given-names>DJ</given-names></name></person-group><article-title>Eukaryotic transposable elements and genome evolution</article-title><source>Trends in Genetics</source><year>1989</year><volume>5</volume><fpage>103</fpage><lpage>107</lpage><pub-id pub-id-type="pmid">2543105</pub-id><pub-id pub-id-type="doi">10.1016/0168-9525(89)90039-5</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Voytas</surname><given-names>DF</given-names></name><name><surname>Cummings</surname><given-names>MP</given-names></name><name><surname>Konieczny</surname><given-names>A</given-names></name><name><surname>Ausubel</surname><given-names>FM</given-names></name><name><surname>Rodermel</surname><given-names>SR</given-names></name></person-group><article-title><italic>Copia</italic>-like retrotransposons are ubiquitous among plants</article-title><source>Proceedings of the National Academy of Sciences</source><year>1992</year><volume>89</volume><fpage>7124</fpage><lpage>7128</lpage><pub-id pub-id-type="doi">10.1073/pnas.89.15.7124</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Flavell</surname><given-names>AJ</given-names></name><name><surname>Dunbar</surname><given-names>E</given-names></name><name><surname>Anderson</surname><given-names>R</given-names></name><name><surname>Pearce</surname><given-names>SR</given-names></name><name><surname>Hartley</surname><given-names>R</given-names></name><name><surname>Kumar</surname><given-names>A</given-names></name></person-group><article-title>Ty1-<italic>copia </italic>group retrotransposons are ubiquitous and heterogeneous in higher plants</article-title><source>Nucl Acids Res</source><year>1992</year><volume>20</volume><fpage>3639</fpage><lpage>3644</lpage><pub-id pub-id-type="pmid">1379359</pub-id><pub-id pub-id-type="doi">10.1093/nar/20.14.3639</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Suoniemi</surname><given-names>A</given-names></name><name><surname>Tanskanen</surname><given-names>J</given-names></name><name><surname>Schulman</surname><given-names>A</given-names></name></person-group><article-title><italic>Gypsy</italic>-like retrotransposons are widespread in the plant kingdom</article-title><source>Plant J</source><year>1998</year><volume>13</volume><fpage>699</fpage><lpage>705</lpage><pub-id pub-id-type="pmid">9681012</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-313X.1998.00071.x</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gabriel</surname><given-names>A</given-names></name><name><surname>Willems</surname><given-names>M</given-names></name><name><surname>Mules</surname><given-names>EH</given-names></name><name><surname>Boeke</surname><given-names>JD</given-names></name></person-group><article-title>Replication infidelity during a single cycle of Ty1 retrotransposition</article-title><source>Proc Natl Acad Sci USA</source><year>1996</year><volume>93</volume><fpage>7767</fpage><lpage>7771</lpage><pub-id pub-id-type="pmid">8755550</pub-id><pub-id pub-id-type="doi">10.1073/pnas.93.15.7767</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Casacuberta</surname><given-names>JM</given-names></name><name><surname>