"B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mack</surname><given-names>MC</given-names></name><name><surname>Schuur</surname><given-names>EAG</given-names></name><name><surname>Bret-Harte</surname><given-names>MS</given-names></name><name><surname>Shaver</surname><given-names>GR</given-names></name><name><surname>Chapin</surname><given-names>FS</given-names></name></person-group><article-title>Ecosystem carbon storage in arctic tundra reduced by long-term nutrient fertilization</article-title><source>Nature</source><year>2004</year><volume>431</volume><fpage>440</fpage><lpage>443</lpage><pub-id pub-id-type="pmid">15386009</pub-id><pub-id pub-id-type="doi">10.1038/nature02887</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reich</surname><given-names>PB</given-names></name><name><surname>Knops</surname><given-names>J</given-names></name><name><surname>Tilman</surname><given-names>D</given-names></name><name><surname>Craine</surname><given-names>J</given-names></name><name><surname>Ellsworth</surname><given-names>D</given-names></name><name><surname>Tjoelker</surname><given-names>M</given-names></name><name><surname>Lee</surname><given-names>T</given-names></name><name><surname>Wedin</surname><given-names>D</given-names></name><name><surname>Naeem</surname><given-names>S</given-names></name><name><surname>Bahauddin</surname><given-names>D</given-names></name><etal></etal></person-group><article-title>Plant diversity enhances ecosystem responses to elevated CO2 and nitrogen deposition (vol 410, pg 809, 2001)</article-title><source>Nature</source><year>2001</year><volume>411</volume><fpage>824</fpage><pub-id pub-id-type="pmid">11460110</pub-id><pub-id pub-id-type="doi">10.1038/35081122</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chapin</surname><given-names>FS</given-names></name><name><surname>Shaver</surname><given-names>GR</given-names></name><name><surname>Giblin</surname><given-names>AE</given-names></name><name><surname>Nadelhoffer</surname><given-names>KJ</given-names></name><name><surname>Laundre</surname><given-names>JA</given-names></name></person-group><article-title>Responses of Arctic Tundra to Experimental and Observed Changes in Climate</article-title><source>Ecology</source><year>1995</year><volume>76</volume><fpage>694</fpage><lpage>711</lpage><pub-id pub-id-type="doi">10.2307/1939337</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shaver</surname><given-names>GR</given-names></name><name><surname>Jonasson</surname><given-names>S</given-names></name></person-group><article-title>Responses of Arctic ecosystems to climate change: results of long-term field experiments in Sweden and Alaska</article-title><source>Polar Research</source><year>1999</year><volume>18</volume><fpage>245</fpage><lpage>252</lpage><pub-id pub-id-type="doi">10.1111/j.1751-8369.1999.tb00300.x</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shaver</surname><given-names>GR</given-names></name><name><surname>Johnson</surname><given-names>LC</given-names></name><name><surname>Cades</surname><given-names>DH</given-names></name><name><surname>Murray</surname><given-names>G</given-names></name><name><surname>Laundre</surname><given-names>JA</given-names></name><name><surname>Rastetter</surname><given-names>EB</given-names></name><name><surname>Nadelhoffer</surname><given-names>KJ</given-names></name><name><surname>Giblin</surname><given-names>AE</given-names></name></person-group><article-title>Biomass and CO2 flux in wet sedge tundras: Responses to nutrients, temperature, and light</article-title><source>Ecological Monographs</source><year>1998</year><volume>68</volume><fpage>75</fpage><lpage>97</lpage></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sturm</surname><given-names>M</given-names></name><name><surname>Racine</surname><given-names>C</given-names></name><name><surname>Tape</surname><given-names>K</given-names></name></person-group><article-title>Climate change &#x02013; Increasing shrub abundance in the Arctic</article-title><source>Nature</source><year>2001</year><volume>411</volume><fpage>546</fpage><lpage>547</lpage><pub-id pub-id-type="pmid">11385559</pub-id><pub-id pub-id-type="doi">10.1038/35079180</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arft</surname><given-names>AM</given-names></name><name><surname>Walker</surname><given-names>MD</given-names></name><name><surname>Gurevitch</surname><given-names>J</given-names></name><name><surname>Alatalo</surname><given-names>JM</given-names></name><name><surname>Bret-Harte</surname><given-names>MS</given-names></name><name><surname>Dale</surname><given-names>M</given-names></name><name><surname>Diemer</surname><given-names>M</given-names></name><name><surname>Gugerli</surname><given-names>F</given-names></name><name><surname>Henry</surname><given-names>GHR</given-names></name><name><surname>Jones</surname><given-names>MH</given-names></name><etal></etal></person-group><article-title>Responses of tundra plants to experimental warming: Meta-analysis of the international tundra experiment</article-title><source>Ecological Monographs</source><year>1999</year><volume>69</volume><fpage>491</fpage><lpage>511</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McInnes</surname><given-names>PF</given-names></name><name><surname>Naiman</surname><given-names>RJ</given-names></name><name><surname>Pastor</surname><given-names>J</given-names></name><name><surname>Cohe