p person-group-type="author"><name><surname>Gr&#x000f6;schel-Stewart</surname><given-names>U</given-names></name><name><surname>Bardini</surname><given-names>M</given-names></name><name><surname>Robson</surname><given-names>T</given-names></name><etal/></person-group><article-title>Localisation of P2X<sub>5</sub> and P2X<sub>7</sub> receptors by immunohistochemistry in rat stratified squamous epithelia</article-title><source>Cell Tissue Res</source><year>1999</year><volume>296</volume><fpage>599</fpage><lpage>605</lpage><pub-id pub-id-type="doi">10.1007/s004410051321</pub-id></citation><citation citation-type="display-unstructured">Gr&#x000f6;schel-Stewart U, Bardini M, Robson T et al (1999) Localisation of P2X5 and P2X7 receptors by immunohistochemistry in rat stratified squamous epithelia. Cell Tissue Res 296:599&#x02013;605 <pub-id pub-id-type="pmid">10370147</pub-id></citation></ref><ref id="CR11"><label>11.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dixon</surname><given-names>CJ</given-names></name><name><surname>Bowler</surname><given-names>WB</given-names></name><name><surname>Littlewood-Evans</surname><given-names>A</given-names></name><etal/></person-group><article-title>Regulation of epidermal homeostasis through P2Y<sub>2</sub> receptors</article-title><source>Br J Pharmacol</source><year>1999</year><volume>127</volume><fpage>1680</fpage><lpage>1686</lpage><pub-id pub-id-type="doi">10.1038/sj.bjp.0702653</pub-id></citation><citation citation-type="display-unstructured">Dixon CJ, Bowler WB, Littlewood-Evans A et al (1999) Regulation of epidermal homeostasis through P2Y2 receptors. Br J Pharmacol 127:1680&#x02013;1686 <pub-id pub-id-type="pmid">10455326</pub-id></citation></ref><ref id="CR12"><label>12.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Greig</surname><given-names>AVH</given-names></name><name><surname>Linge</surname><given-names>C</given-na