n-names></name><name><surname>Park</surname><given-names>SH</given-names></name></person-group><article-title>A prospective study of the anatomic variations of the median nerve in the carpal tunnel in Asians</article-title><source>Ann Plast Surg</source><year>2000</year><volume>44</volume><issue>3</issue><fpage>282</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">10735220</pub-id></citation></ref><ref id="B9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Falconer</surname><given-names>D</given-names></name><name><surname>Spinner</surname><given-names>M</given-names></name></person-group><article-title>Anatomic variations in the motor and sensory supply of the thumb</article-title><source>Clin Orthop Relat Res</source><year>1985</year><volume>195</volume><fpage>83</fpage><lpage>96</lpage><pub-id pub-id-type="pmid">3978968</pub-id></citation></ref><ref id="B10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Homma</surname><given-names>T</given-names></name><name><surname>Sakai</surname><given-names>T</given-names></name></person-group><article-title>Thenar and hypothenar muscles and their innervation by the ulnar and median nerves in the human hand</article-title><source>Acta Anat (Basel)</source><year>1992</year><volume>145</volume><issue>1</issue><fpage>44</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">1414212</pub-id></citation></ref><ref id="B11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hurwitz</surname><given-names>PJ</given-names></name></person-group><article-title>Variations in the course of the thenar motor branch of the median nerve</article-title><source>J Hand Surg [Br]</source><year>1996</year><volume>21</volume><issue>3</issue><fpage>344</fpage><lpage>6</lpage></citation></ref><ref id="B12"><label>12</label><citation citation-type="journal"><person-group person-group-