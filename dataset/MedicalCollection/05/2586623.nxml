id-type="pmid">16185178</pub-id><pub-id pub-id-type="doi">10.1592/phco.2005.25.10.1341</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fihn</surname><given-names>SD</given-names></name><name><surname>Callahan</surname><given-names>CM</given-names></name><name><surname>Martin</surname><given-names>DC</given-names></name><name><surname>McDonell</surname><given-names>MB</given-names></name><name><surname>Henikoff</surname><given-names>JG</given-names></name><name><surname>White</surname><given-names>RH</given-names></name></person-group><article-title>The risk for and severity of bleeding complications in elderly patients treated with warfarin. The National Consortium of Anticoagulation Clinics</article-title><source>Ann Intern Med</source><year>1996</year><volume>124</volume><fpage>970</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">8624064</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garcia</surname><given-names>D</given-names></name><name><surname>Regan</surname><given-names>S</given-names></name><name><surname>Crowther</surname><given-names>M</given-names></name><name><surname>Hughes</surname><given-names>RA</given-names></name><name><surname>Hylek</surname><given-names>EM</given-names></name></person-group><article-title>Warfarin maintenance dosing patterns in clinical practice: implications for safer anticoagulation in the elderly population</article-title><source>Chest</source><year>2005</year><volume>127</volume><fpage>2049</fpage><lpage>56</lpage><pub-id pub-id-type="pmid">15947319</pub-id><pub-id pub-id-type="doi">10.1378/chest.127.6.2049</pub-id></citation></ref></ref-list></back></article>