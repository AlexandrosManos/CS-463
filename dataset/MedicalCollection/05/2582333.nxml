tle> <source>J Infect Dis</source> <year>1973</year>;<volume>127</volume>:<fpage>648</fpage>&#x02013;<lpage>62</lpage><pub-id pub-id-type="pmid">4574998</pub-id></mixed-citation></ref><ref id="b20"><label>20</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cote</surname><given-names>PJ</given-names></name><name><surname>Korba</surname><given-names>BE</given-names></name><name><surname>Miller</surname><given-names>RH</given-names></name><etal/></person-group> <article-title>Effects of age and viral determinants on chronicity as an outcome of experimental woodchuck hepatitis virus infection.</article-title> <source>Hepatology</source> <year>2000</year>;<volume>31</volume>:<fpage>190</fpage>&#x02013;<lpage>200</lpage><pub-id pub-id-type="pmid">10613745</pub-id></mixed-citation></ref><ref id="b21"><label>21</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Fong</surname><given-names>TL</given-names></name><name><surname>Di Bisceglie</surname><given-names>AM</given-names></name><name><surname>Biswas</surname><given-names>R</given-names></name><etal/></person-group> <article-title>High levels of viral replication during acute hepatitis B infection predict progression to chronicity.</article-title> <source>J Med Virol</source> <year>1994</year>;<volume>43</volume>:<fpage>155</fpage>&#x02013;<lpage>8</lpage><pub-id pub-id-type="pmid">8083663</pub-id></mixed-citation></ref><ref id="b22"><label>22</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lok</surname><given-names>AS</given-names></name><name><surname>McMahon</surname><given-names>BJ</given-names></name></person-group> <article-title>Chronic hepatitis B.</article-title> <source>Hepatology</source> <year>2007</year>;<volume>45</volume>: <fpage>507</fpage>&#x02013;<lpage>39</lpage><pub-id pub-id-type="pmid">17256718</pub-id></mixed-citation></ref><ref id