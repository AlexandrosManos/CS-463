nu Symp Proc</source><year>2007</year><fpage>553</fpage><lpage>557</lpage><pub-id pub-id-type="pmid">18693897</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Funk</surname><given-names>ME</given-names></name><name><surname>Reid</surname><given-names>CA</given-names></name></person-group><article-title>Indexing consistency in MEDLINE</article-title><source>Bull Med Libr Assoc</source><year>1983</year><volume>71</volume><fpage>176</fpage><lpage>183</lpage><pub-id pub-id-type="pmid">6344946</pub-id></citation></ref></ref-list></back></article>