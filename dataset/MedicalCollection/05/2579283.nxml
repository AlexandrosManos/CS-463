group-type="author"><name><surname>Rao</surname><given-names>DB</given-names></name><name><surname>Hegde</surname><given-names>AM</given-names></name><name><surname>Munshi</surname><given-names>AK</given-names></name></person-group><article-title>Caries prevalence amongst handicapped children of South Canara district, Karnataka</article-title><source>Indian Soc Pedod Prev Dent</source><year>2001</year><volume>19</volume><fpage>67</fpage><lpage>73</lpage><pub-id pub-id-type="pmid">11692825</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roman</surname><given-names>A</given-names></name><name><surname>Tigan</surname><given-names>S</given-names></name><name><surname>Pastrav</surname><given-names>O</given-names></name></person-group><article-title>Caries among a group of Romanian intellectually impaired children</article-title><source>JDOH</source><year>2004</year><volume>5</volume><fpage>80</fpage><lpage>82</lpage></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Ahlborg</surname><given-names>B</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Nunn JH</surname></name></person-group><article-title>Practical prevention</article-title><source>Disability and Oral Care</source><year>2000</year><publisher-name>FDI World Dental Press</publisher-name><fpage>29</fpage><lpage>39</lpage></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adenubi</surname><given-names>JO</given-names></name><name><surname>Saleem</surname><given-names>FH</given-names></name><name><surname>Martirez</surname><given-names>JN</given-names></name></person-group><article-title>Dental health care at The Disabled Children's Rehabilitation Center in Riyadh</article-title><source>The Saudi Dent J</source><year>1997</year><volume>9</volume><fpage>9</fpage><lpage>13</lpage></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tsami</surname><given-names>A</given-names></name><name><surname>Pepelassi</surname><given-names>E</given-names></name><name><surname>Gizani</surname><given-names>S</given-names></name><name><surname>Komboli</surname><given-names>M</given-names></name><name><surname>Papagianoulis</surname><given-names>L</given-names></name><name><surname>Mantzavinos</surname><given-names>Z</given-names></name></person-group><article-title>Oral hygiene and periodontal treatment needs in young people with special needs attending a special school in Greece</article-title><source>J Disabil Oral Health</source><year>2004</year><volume>5</volume><fpage>57</fpage><lpage>64</lpage></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tesini</surname><given-names>DA</given-names></name><name><surname>Fenton</surname><given-names>SJ</given-names></name></person-group><article-title>Oral health needs of persons with physical or mental disabilities. Practical considerations in special patient care</article-title><source>Dent Clin North Am</source><year>1994</year><volume>38</volume><fpage>483</fpage><lpage>498</lpage><pub-id pub-id-type="pmid">7926199</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nicopoulos</surname><given-names>M</given-names></name><name><surname>Brennan</surname><given-names>MT</given-names></name><name><surname>Kent</surname><given-names>ML</given-names></name><name><surname>Brickhouse</surname><given-names>TH</given-names></name><name><surname>Rogers</surname><given-names>MK</given-names></name><name><surname>Fox</surname><given-names>PC</given-names></name><name><surname>Lockart</surname><given-names>PB</given-names></name></person-group><article-title>Oral health needs and barriers to dental care in hospitalized children</article-title><source>Spec Care Dentist</source><year>2007</year><volume>27</volume><fpage>206</fpage><lpage>211</lpage><pub-id pub-id-type="pmid">17990481</pub-id><pub-id pub-id-type="doi">10.1111/j.1754-4505.2007.tb00348.x</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nagahama</surname><given-names>SI</given-names></name><name><surname>McNabb</surname><given-names>K</given-names></name><name><surname>Vanderlinde</surname><given-names>M</given-names></name><name><surname>Cobb</surname><given-names>K</given-names></name><name><surname>Moore</surname><given-names>CS</given-names></name><name><surname>Milgrom</surname><given-names>P</given-names></name><name><surname>Coldwell</surname><given-names>SE</given-names></name></person-group><article-title>Improving utilization of preventive dental services by Medicaid-enrolled children: focus on the parents</article-title><source>J Dent Child</source><year>2002</year><volume>69</volume><fpage>325</fpage><lpage>331</lpage><pub-id pub-id-type="pmid">12613321</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roman</surname><given-names>KM</given-names></name></person-group><article-title>Strategic planning: the at-risk pediatric patient</article-title><source>Pediatr Dent Today</source><year>2007</year><volume>43</volume><fpage>48</fpage><lpage>49</lpage></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Edelstein</surname><given-names>BL</given-names></name></person-group><article-title>Dental care considerations for young children</article-title><source>Spec Care Dentist</source><year>2002</year><volume>22</volume><fpage>11s</fpage><lpage>25s</lpage><pub-id pub-id-type="pmid">12375744</pub-id></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kanellis</surname><given-names>MJ</given-names></name></person-group><article-title>The impact of poor oral health on children's ability to function</article-title><source>J Southeastern Soc Ped Dent</source><year>2000</year><volume>6</volume><fpage>12</fpage><lpage>13</lpage></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schechter</surname><given-names>N</given-names></name></person-group><article-title>The impact of acute and chronic dental pain on child development</article-title><source>J Southeastern Soc Ped Dent</source><year>2000</year><volume>6</volume><fpage>16</fpage><lpage>17</lpage></citation></ref><ref id="B33"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oredugba</surname><given-names>FA</given-names></name></person-group><article-title>Oral health condition and treatment needs of a group of Nigerian individuals with Down syndrome</article-title><source>Down Synd Res Pract</source><year>2007</year><volume>12</volume><fpage>72</fpage><lpage>77</lpage><pub-id pub-id-type="pmid">17692192</pub-id><pub-id pub-id-type="doi">10.3104/reports.2022</pub-id></citation></ref><ref id="B34"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kleint</surname><given-names>G</given-names></name><name><surname>Kanitz</surname><given-names>G</given-names></name><name><surname>Harzer</surname><given-names>W</given-names></name></person-group><article-title>Orthodontic treatment in handicapped children: report of four cases</article-title><source>J Dent Child</source><year>2002</year><volume>69</volume><fpage>31</fpage><lpage>38</lpage><pub-id pub-id-type="pmid">12119810</pub-id></citation></ref><ref id="B35"><citation citation-type="journal"><person-group person-group-type="author"><collab>American Association of Orthodontists</collab></person-group><article-title>Orthodontic care of children with special needs</article-title><source>Orthodontic Dialogue</source><year>2001</year><volume>13</volume><fpage>1</fpage><lpage>5</lpage></citation></ref><ref id="B36"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hobson</surname><given-names>RS</given-names></name><name><surname>Nunn</surname><given-names>JH</given-names></name><name><surname>Cozma</surname><given-names>I</given-names></name></person-group><article-title>Orthodontic management of orofacial problems in young people with impairments: a review of the literature and case reports</article-title><source>Int J Paed Dent</source><year>2005</year><volume>15</volume><fpage>355</fpage><lpage>363</lpage><pub-id pub-id-type="doi">10.1111/j.1365-263X.2005.00642.x</pub-id></citation></ref><ref id="B37"><citation citation-type="other"><person-group person-group-type="author"><collab>Center for Medicare and Medicaid Services</collab></person-group><article-title>Medicaid and EPSDT</article-title><ext-link ext-link-type="uri" xlink:href="http://www.cms.hhs.gov/Medicaid/epsdt/default.asp"/><comment>August 27, 2004</comment></citation></ref><ref id="B38"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Elliot</surname><given-names>I</given-names></name><name><surname>Nunn</surname><given-names>JH</given-names></name><name><surname>Sadlier</surname><given-names>D</given-names></name></person-group><source>Oral health and disability: the way forward</source><year>2005</year><publisher-name>National Disability Authority, Ireland</publisher-name><fpage>14</fpage><pub-id pub-id-type="pmid">15389814</pub-id></citation></ref><ref id="B39"><citation citation-type="other"><person-group person-group-type="author"><collab>Association of State and Territorial Dental Directors</collab></person-group><article-title>Health Systems Research, Inc. and the National Maternal and Child Oral Health Resource Center, Georgetown University, Washington DC</article-title><source>Strategies for improving the oral health system of care for children and adolescents with special health care needs</source><year>2005</year></citation></ref></ref-list></back></article>