olume><fpage>183</fpage><lpage>206</lpage></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Elstner</surname><given-names>EF</given-names></name><name><surname>Oswald</surname><given-names>W</given-names></name></person-group><article-title>Air pollution: involvement of oxygen radicals (a mini review)</article-title><source>Free Radical Research Communications</source><year>1991</year><volume>12&#x02013;13</volume><fpage>795</fpage><lpage>807</lpage></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Floryszak-Wieczorek</surname><given-names>J</given-names></name><name><surname>Milczarek</surname><given-names>G</given-names></name><name><surname>Arasimowicz</surname><given-names>M</given-names></name><name><surname>Ciszewski</surname><given-names>A</given-names></name></person-group><article-title>Do nitric oxide donors mimic endogenous NO-related response in plants?</article-title><source>Planta</source><year>2006</year><volume>224</volume><fpage>1363</fpage><lpage>1372</lpage><pub-id pub-id-type="pmid">16773376</pub-id></citation></ref><ref id="bib18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Graziano</surname><given-names>M</given-names></name><name><surname>Beligni</surname><given-names>MV</given-names></name><name><surname>Lamattina</surname><given-names>L</given-names></name></person-group><article-title>Nitric oxide improves internal iron availability in plants</article-title><source>Plant Physiology</source><year>2002</year><volume>130</volume><fpage>1852</fpage><lpage>1859</lpage><pub-id pub-id-type="pmid">12481068</pub-id></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Graziano</surname><given-names>M</given-names></name><name><surname>Lamattina</surname><given-names>L</given-names></name></person-group><article-title>Nitric oxide accumulation is required for molecular and physiological responses to iron deficiency in tomato roots</article-title><source>The Plant Journal</source><year>2007</year><volume>52</volume><fpage>949</fpage><lpage>960</lpage><pub-id pub-id-type="pmid">17892445</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huie</surname><given-names>RE</given-names></name><name><surname>Padmaja</surname><given-names>S</given-names></name></person-group><article-title>The reaction of NO with superoxide</article-title><source>Free Radical Research Communications</source><year>1993</year><volume>18</volume><fpage>195</fpage><lpage>199</lpage><pub-id pub-id-type="pmid">8396550</pub-id></citation></ref><ref id="bib21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ischiropoulos</surname><given-names>H</given-names></name></person-group><article-title>Biological selectivity and functional aspects of protein tyrosine nitration</article-title><source>Biochemical and Biophysical Research Communications</source><year>2003</year><volume>305</volume><fpage>776</fpage><lpage>783</lpage><pub-id pub-id-type="pmid">12763060</pub-id></citation></ref><ref id="bib22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jurkiewicz</surname><given-names>BA</given-names></name><name><surname>Buettner</surname><given-names>GR</given-names></name></person-group><article-title>Ultraviolet light-induced free radical formation in skin: an electron paramagnetic resonance study</article-title><source>Photochemistry and Photobiology</source><year>1994</year><volume>59</volume><fpage>1</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">8127935</pub-id></citation></ref><ref id="bib23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kakhlon</surname><given-names>O</given-names><