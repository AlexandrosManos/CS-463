al"><person-group person-group-type="author"><name><surname>Treiber</surname><given-names>DK</given-names></name><name><surname>Williamson</surname><given-names>JR</given-names></name></person-group><article-title>Beyond kinetic traps in RNA folding</article-title><source>Curr. Opin. Struct. Biol.</source><year>2001</year><volume>11</volume><fpage>309</fpage><lpage>314</lpage><pub-id pub-id-type="pmid">11406379</pub-id></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Woodson</surname><given-names>SA</given-names></name></person-group><article-title>Metal ions and RNA folding: a highly charged topic with a dynamic future</article-title><source>Curr. Opin. Chem. Biol.</source><year>2005</year><volume>9</volume><fpage>104</fpage><lpage>109</lpage><pub-id pub-id-type="pmid">15811793</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Hougland</surname><given-names>JL</given-names></name><name><surname>Piccirilli</surname><given-names>JA</given-names></name><name><surname>Forconi</surname><given-names>M</given-names></name><name><surname>Lee</surname><given-names>J</given-names></name><name><surname>Herschlag</surname><given-names>D</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Gesteland</surname><given-names>RF</given-names></name><name><surname>Cech</surname><given-names>TR</given-names></name><name><surname>Atkins</surname><given-names>JF</given-names></name></person-group><source>The RNA World.</source><year>2006</year><edition>3rd</edition><publisher-loc>New York</publisher-loc><publisher-name>Cold Spring Harbor Laboratory Press</publisher-name></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Been</surname><