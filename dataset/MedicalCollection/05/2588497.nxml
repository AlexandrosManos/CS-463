e><source>J. Mol. Biol.</source><year>2004</year><volume>339</volume><fpage>41</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">15123419</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Emerick</surname><given-names>VL</given-names></name><name><surname>Pan</surname><given-names>J</given-names></name><name><surname>Woodson</surname><given-names>SA</given-names></name></person-group><article-title>Analysis of rate-determining conformational changes during self-splicing of the <italic>Tetrahymena</italic> intron</article-title><source>Biochemistry</source><year>1996</year><volume>35</volume><fpage>13469</fpage><lpage>13477</lpage><pub-id pub-id-type="pmid">8873616</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Karbstein</surname><given-names>K</given-names></name><name><surname>Herschlag</surname><given-names>D</given-names></name></person-group><article-title>Extraordinarily slow binding of guanosine to the <italic>Tetrahymena</italic> group I ribozyme: implications for RNA preorganization and function</article-title><source>Proc. Natl Acad. Sci. USA</source><year>2003</year><volume>100</volume><fpage>2300</fpage><lpage>2305</lpage><pub-id pub-id-type="pmid">12591943</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Adams</surname><given-names>PL</given-names></name><name><surname>Stahley</surname><given-names>MR</given-names></name><name><surname>Gill</surname><given-names>ML</given-names></name><name><surname>Kosek</surname><given-names>AB</given-names></name><name><surname>Wang</surname><given-names>J</given-names></name><name><surname>Strobel</surname><given-names>SA</given-names></name></person-group><article-title>Cr