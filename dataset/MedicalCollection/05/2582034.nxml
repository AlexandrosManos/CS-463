t></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clarke</surname><given-names>A</given-names></name></person-group><article-title>Length of in-hospital stay and its relationship to quality of care 18</article-title><source>Qual Saf Health Care</source><year>2002</year><volume>11</volume><fpage>209</fpage><lpage>210</lpage><pub-id pub-id-type="pmid">12486979</pub-id><pub-id pub-id-type="doi">10.1136/qhc.11.3.209</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harrison</surname><given-names>ML</given-names></name><name><surname>Graff</surname><given-names>LA</given-names></name><name><surname>Roos</surname><given-names>NP</given-names></name><name><surname>Brownell</surname><given-names>MD</given-names></name></person-group><article-title>Discharging patients earlier from Winnipeg hospitals: does it adversely affect quality of care?</article-title><source>CMAJ</source><year>1995</year><volume>153</volume><fpage>745</fpage><lpage>751</lpage><pub-id pub-id-type="pmid">7664228</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thomas</surname><given-names>JW</given-names></name><name><surname>Guire</surname><given-names>KE</given-names></name><name><surname>Horvat</surname><given-names>GG</given-names></name></person-group><article-title>Is patient length of stay related to quality of care?</article-title><source>Hosp Health Serv Adm</source><year>1997</year><volume>42</volume><fpage>489</fpage><lpage>507</lpage><pub-id pub-id-type="pmid">10174462</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Westert</surname><given-names>GP</given-names></name><name><surname>Lagoe</surname><given-names>RJ</given-names></name></person-group><article-title>The evaluation of hospital stays for total hip replacement</article-title><source>Qual Manag Health Care</source><year>1995</year><volume>3</volume><fpage>62</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">10143557</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kossovsky</surname><given-names>MP</given-names></name><name><surname>Sarasin</surname><given-names>FP</given-names></name><name><surname>Chopard</surname><given-names>P</given-names></name><name><surname>Louis-Simonet</surname><given-names>M</given-names></name><name><surname>Sigaud</surname><given-names>P</given-names></name><name><surname>Pernege</surname><given-names>TV</given-names></name><name><surname>Gaspoz</surname><given-names>JM</given-names></name></person-group><article-title>Relationship between hospital length of stay and quality of care in patients with congestive heart failure 17</article-title><source>Qual Saf Health Care</source><year>2002</year><volume>11</volume><fpage>219</fpage><lpage>223</lpage><pub-id pub-id-type="pmid">12486984</pub-id><pub-id pub-id-type="doi">10.1136/qhc.11.3.219</pub-id></citation></ref></ref-list></back></article>