ame></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Garriguet</surname><given-names>D</given-names></name></person-group><source>Nutrition: Findings from the Canadian community health survey Overview of Canadians' eating habits Catalogue no 82-620-MIE-No 2</source><year>2006</year><publisher-name>Ottawa, ON: Statistics Canada</publisher-name></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ghadirian</surname><given-names>P</given-names></name><name><surname>Shatenstein</surname><given-names>B</given-names></name><name><surname>Lambert</surname><given-names>J</given-names></name><name><surname>Thouez</surname><given-names>JP</given-names></name><name><surname>PetitClerc</surname><given-names>C</given-names></name><name><surname>Parent</surname><given-names>ME</given-names></name><name><surname>Mailhot</surname><given-names>M</given-names></name><name><surname>Goulet</surname><given-names>MC</given-names></name></person-group><article-title>Food habits of French Canadians in Montreal, Quebec</article-title><source>J Am Coll Nutr</source><year>1995</year><volume>14</volume><fpage>37</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">7706608</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Beaudry</surname><given-names>M</given-names></name><name><surname>Galibois</surname><given-names>I</given-names></name><name><surname>Chaumette</surname><given-names>P</given-names></name></person-group><article-title>Dietary patterns of adults in Quebec and their nutritional adequacy</article-title><source>Can J Public Health</source><year>1998</year><volume>89</volume><fpage>347</fpage><lpage>351</lpage><pub-id pub-id-type="pmid">9813927</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Duhaime</surname><given-names>G</given-names></name><name><surname>Chabot</surname><given-names>M</given-names></name><name><surname>Frechette</surname><given-names>P</given-names></name><name><surname>Robichaud</surname><given-names>V</given-names></name><name><surname>Proulx</surname><given-names>S</given-names></name></person-group><article-title>The impact of dietary changes among the Inuit of Nunavik (Canada): A socioeconomic assessment of possible public health recommendations dealing with food contamination</article-title><source>Risk Anal</source><year>2004</year><volume>24</volume><fpage>1007</fpage><lpage>1018</lpage><pub-id pub-id-type="pmid">15357824</pub-id><pub-id pub-id-type="doi">10.1111/j.0272-4332.2004.00503.x</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Satia</surname><given-names>JA</given-names></name><name><surname>Patterson</surname><given-names>RE</given-names></name><name><surname>Kristal</surname><given-names>AR</given-names></name><name><surname>Hislop</surname><given-names>TG</given-names></name><name><surname>Pineda</surname><given-names>M</given-names></name></person-group><article-title>A household food inventory for North American Chinese</article-title><source>Public Health Nutr</source><year>2001</year><volume>4</volume><fpage>241</fpage><lpage>247</lpage><pub-id pub-id-type="pmid">11299097</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roebothan</surname><given-names>BV</given-names></name><name><surname>Friel</surname><given-names>JK</given-names></name><name><surname>Healey</surname><given-names>L</given-names></name></person-group><article-title>Diet and drug consumption in a group of elderly residing in rural Newfoundland</article-title><source>Can J Public Health</source><year>1994</year><volume>85</volume><fpage>313</fpage><lpage>316</lpage><pub-id pub-id-type="