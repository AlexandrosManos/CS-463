</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Majowicz</surname><given-names>SE</given-names></name><name><surname>Dor&#x000e9;</surname><given-names>K</given-names></name><name><surname>Flint</surname><given-names>JA</given-names></name><name><surname>Edge</surname><given-names>VL</given-names></name><name><surname>Read</surname><given-names>S</given-names></name><name><surname>Buffet</surname><given-names>MC</given-names></name><name><surname>McEwen</surname><given-names>S</given-names></name><name><surname>McNab</surname><given-names>WB</given-names></name><name><surname>Stacey</surname><given-names>D</given-names></name><name><surname>Sockett</surname><given-names>P</given-names></name><name><surname>Wilson</surname><given-names>JB</given-names></name></person-group><article-title>Magnitude and distribution of acute, self-reported gastrointestinal illness in a Canadian community</article-title><source>Epidemiol Infect</source><year>2004</year><volume>132</volume><fpage>607</fpage><lpage>617</lpage><pub-id pub-id-type="pmid">15310162</pub-id><pub-id pub-id-type="doi">10.1017/S0950268804002353</pub-id></citation></ref><ref id="B22"><citation citation-type="other"><person-group person-group-type="author"><collab>Statistics Canada</collab></person-group><article-title>2001 Community profiles. 2001 Census</article-title><ext-link ext-link-type="uri" xlink:href="http://www12.statcan.ca/english/census01/home/Index.cfm"/></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><collab>National Studies on Acute Gastrointestinal Illness (NSAGI)</collab></person-group><source>Ontario population study</source><year>2001</year><publisher-name>Ontario, Canada: Public Health Agency of Canada</publisher-name></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><collab>Center for Disease Control and Pr