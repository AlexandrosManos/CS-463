id="pone.0003751-Ballam1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ballam</surname><given-names>LD</given-names></name><etal/></person-group><year>2000</year><article-title>Western blotting is useful in the salivary diagnosis of <italic>Helicobacter pylori</italic> infection.</article-title><source>J Clin Pathol</source><volume>53</volume><fpage>314</fpage><lpage>317</lpage><pub-id pub-id-type="pmid">10823129</pub-id></citation></ref><ref id="pone.0003751-Kato2"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kato</surname><given-names>S</given-names></name><etal/></person-group><year>2001</year><article-title>Urine-based enzyme-linked immunosorbent assay for the detection of <italic>Helicobacter pylori</italic> infection in children.</article-title><source>Pediatrics</source><volume>107</volume><fpage>E87</fpage><pub-id pub-id-type="pmid">11389285</pub-id></citation></ref><ref id="pone.0003751-Koletzko1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koletzko</surname><given-names>S</given-names></name><etal/></person-group><year>2003</year><article-title>Evaluation of a novel monoclonal enzyme immunoassay for detection of <italic>Helicobacter pylori</italic> antigen in stool from children.</article-title><source>Gut</source><volume>52</volume><fpage>804</fpage><lpage>806</lpage><pub-id pub-id-type="pmid">12740334</pub-id></citation></ref><ref id="pone.0003751-Konstantopoulos1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Konstantopoulos</surname><given-names>N</given-names></name><etal/></person-group><year>2001</year><article-title>Evaluation of the Helicobacter pylori stool antigen test (HpSA) for detection of <italic>Helicobacter pylori</italic> infection in children.</article-title><source>Am J Gastroenterol</source><