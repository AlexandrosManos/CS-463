></person-group><person-group person-group-type="editor"><name><surname>Hagen-Ansert SL</surname></name></person-group><article-title>The Urinary System</article-title><source>Textbook of Diagnostic Ultrasonography</source><year>2001</year><edition>5</edition><publisher-name>St. Louis: Mosby</publisher-name><fpage>269</fpage></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Trapani</surname><given-names>AR</given-names></name><name><surname>Tamburri</surname><given-names>L</given-names></name><name><surname>Di Giandomenico</surname><given-names>V</given-names></name><name><surname>De Pascale</surname><given-names>A</given-names></name><name><surname>Bonomo</surname><given-names>L</given-names></name></person-group><article-title>Hydronephrosis and peripelvic cysts. A new echographic sign for the differential diagnosis</article-title><source>Radiol Med (Torino)</source><year>1992</year><volume>83</volume><fpage>777</fpage><lpage>782</lpage><pub-id pub-id-type="pmid">1502358</pub-id></citation></ref></ref-list></back></article>