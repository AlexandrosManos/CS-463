>RS</given-names></name></person-group><article-title>Issues in surgical randomized trials</article-title><source>World J Surg</source><year>1999</year><volume>23</volume><fpage>1210</fpage><lpage>1214</lpage><pub-id pub-id-type="doi">10.1007/s002689900649</pub-id><pub-id pub-id-type="pmid">10552108</pub-id></mixed-citation></ref><ref id="CR15"><label>15.</label><mixed-citation publication-type="other">Nault ML, Achiche S, Aubin CE, Labelle H (2004) Fuzzy logic to assist the planning in adolescent idiopathic scoliosis instrumentation surgery. Presented at the Annual Meeting of the North American Fuzzy Information Processing Society. IEEE, New York, pp 34&#x02013;37 <ext-link ext-link-type="uri" xlink:href="http://ieeexplore.ieee.org/iel5/9281/29474/01336244.pdf?arnumber=1336244">http://ieeexplore.ieee.org/iel5/9281/29474/01336244.pdf?arnumber=1336244</ext-link></mixed-citation></ref><ref id="CR16"><label>16.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Pryor</surname><given-names>DB</given-names></name><name><surname>Callif</surname><given-names>RM</given-names></name><name><surname>Harrel</surname><given-names>FE</given-names></name><name><surname>Hlatky</surname><given-names>MA</given-names></name><name><surname>Lee</surname><given-names>KL</given-names></name><name><surname>Mark</surname><given-names>DB</given-names></name><name><surname>Rosati</surname><given-names>RA</given-names></name></person-group><article-title>Clinical databases. Accomplishments and unrealized potential</article-title><source>Med Care</source><year>1985</year><volume>23</volume><issue>5</issue><fpage>623</fpage><lpage>647</lpage><pub-id pub-id-type="doi">10.1097/00005650-198505000-00020</pub-id><pub-id pub-id-type="pmid">3892181</pub-id></mixed-citation></ref><ref id="CR17"><label>17.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Reitsma</surname><given-names>A</given-names></name><name><surname>Moreno</surname><given-names>J</given-names></name></person-group><article-title>Ethical regulations for innovative surgery: the last frontier?</article-title><source>J Am Coll Surg</source><year>2002</year><volume>194</volume><fpage>792</fpage><lpage>801</lpage><pub-id pub-id-type="doi">10.1016/S1072-7515(02)01153-5</pub-id><pub-id pub-id-type="pmid">12081071</pub-id></mixed-citation></ref><ref id="CR18"><label>18.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Richards</surname><given-names>BS</given-names></name><name><surname>Herring</surname><given-names>JA</given-names></name><name><surname>Johnston</surname><given-names>CE</given-names></name><name><surname>Birch</surname><given-names>JG</given-names></name><name><surname>Roach</surname><given-names>JW</given-names></name></person-group><article-title>Treatment of adolescent idiopathic scoliosis using Texas Scottish Rite Hospital Instrumentation</article-title><source>Spine</source><year>1994</year><volume>19</volume><fpage>1598</fpage><lpage>1605</lpage><pub-id pub-id-type="doi">10.1097/00007632-199407001-00008</pub-id><pub-id pub-id-type="pmid">7939996</pub-id></mixed-citation></ref><ref id="CR19"><label>19.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sanders</surname><given-names>JO</given-names></name><name><surname>Herring</surname><given-names>JA</given-names></name><name><surname>Browne</surname><given-names>RH</given-names></name></person-group><article-title>Posterior arthodesis and instrumentation in immature (Risser Grade 0) spine in idiopathic scoliosis</article-title><source>J Bone Joint Surg Am</source><year>1995</year><volume>77</volume><fpage>39</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">7822354</pub-id></mixed-citation></ref><ref id="CR20"><label>20.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Schuflebarger</surname><given-names>HL</given-names></name><name><surname>Grimm</surname><given-names>JO</given-names></name><name><surname>Bui</surname><given-names>V</given-names></name><name><surname>Thomson</surname><given-names>JD</given-names></name></person-group><article-title>Anterior and posterior spine fusion, staged versus same day surgery</article-title><source>Spine</source><year>1991</year><volume>16</volume><fpage>930</fpage><lpage>933</lpage><pub-id pub-id-type="doi">10.1097/00007632-199108000-00011</pub-id><pub-id pub-id-type="pmid">1948379</pub-id></mixed-citation></ref><ref id="CR21"><label>21.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Solomon</surname><given-names>MJ</given-names></name><name><surname>McLeod</surname><given-names>RS</given-names></name></person-group><article-title>Surgery and randomized trials: past, present, and future</article-title><source>Med J</source><year>1998</year><volume>169</volume><fpage>380</fpage><lpage>383</lpage></mixed-citation></ref><ref id="CR22"><label>22.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Stefan</surname><given-names>S</given-names></name><name><surname>Seiler</surname><given-names>CM</given-names></name></person-group><article-title>Role of systematic reviews and meta-analysis in evidence based medicine</article-title><source>World J Surg</source><year>2005</year><volume>29</volume><fpage>582</fpage><lpage>587</lpage><pub-id pub-id-type="doi">10.1007/s00268-005-7917-7</pub-id><pub-id pub-id-type="pmid">15827839</pub-id></mixed-citation></ref><ref id="CR23"><label>23.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wente</surname><given-names>MN</given-names></name><name><surname>Seiler</surname><given-names>CM</given-names></name><name><surname>Uhl</surname><given-names>W</given-names></name><name><surname>Buchler</surname><given-names>MW</given-names></name></person-group><article-title>Perspectives of evidence-based surgery</article-title><source>Dig Surg</source><year>2003</year><volume>20</volume><fpage>263</fpage><lpage>269</lpage><pub-id pub-id-type="doi">10.1159/000071183</pub-id><pub-id pub-id-type="pmid">12748428</pub-id></mixed-citation></ref><ref id="CR24"><label>24.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wright</surname><given-names>CD</given-names></name><name><surname>Edwards</surname><given-names>FD</given-names></name></person-group><article-title>The Society of thoracic surgeons general thoracic surgery database</article-title><source>Ann Thorac Surg</source><year>2007</year><volume>83</volume><issue>3</issue><fpage>893</fpage><lpage>894</lpage><pub-id pub-id-type="doi">10.1016/j.athoracsur.2006.09.078</pub-id><pub-id pub-id-type="pmid">17307428</pub-id></mixed-citation></ref><ref id="CR25"><label>25.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Zoccali</surname><given-names>C</given-names></name></person-group><article-title>Clinical databases in nephrology and clinical practice goals and challenges</article-title><source>J Nephrol</source><year>2006</year><volume>19</volume><fpage>551</fpage><lpage>555</lpage><pub-id pub-id-type="pmid">17136681</pub-id></mixed-citation></ref></ref-list></back></article>