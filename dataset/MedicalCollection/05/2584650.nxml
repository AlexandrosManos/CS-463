</lpage><pub-id pub-id-type="pmid">8667113</pub-id><pub-id pub-id-type="doi">10.1097/00005131-199604000-00009</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldhahn</surname><given-names>J</given-names></name><name><surname>Suhm</surname><given-names>N</given-names></name><name><surname>Goldhahn</surname><given-names>S</given-names></name><name><surname>Blauth</surname><given-names>M</given-names></name><name><surname>Hanson</surname><given-names>B</given-names></name></person-group><article-title>Influence of osteoporosis on fracture fixation &#x02013; a systematic literature review</article-title><source>Osteoporos Int</source><year>2008</year><volume>19</volume><fpage>761</fpage><lpage>72</lpage><pub-id pub-id-type="pmid">18066697</pub-id><pub-id pub-id-type="doi">10.1007/s00198-007-0515-9</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yoshimine</surname><given-names>F</given-names></name><name><surname>Latta</surname><given-names>LL</given-names></name><name><surname>Milne</surname><given-names>EL</given-names></name></person-group><article-title>Sliding characteristics of compression hip screws in the intertrochanteric fracture: a clinical study</article-title><source>J Orthop Trauma</source><year>1993</year><volume>7</volume><fpage>348</fpage><lpage>353</lpage><pub-id pub-id-type="pmid">8377045</pub-id><pub-id pub-id-type="doi">10.1097/00005131-199308000-00011</pub-id></citation></ref></ref-list></back></article>