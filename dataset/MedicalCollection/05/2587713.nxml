d><td align="left" rowspan="1" colspan="1">&#x02212;</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1"><bold>&#x0002b;&#x0002b;&#x0002b;</bold></td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1"><bold>&#x0002b;&#x0002b;&#x0002b;&#x0002b;</bold></td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;&#x0002b;</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>Ileal MLN</bold></td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">2(a-b)</td><td align="left" rowspan="1" colspan="1">&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1"><bold>&#x0002b;&#x0002b;</bold></td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1"><bold>&#x0002b;&#x0002b;&#x0002b;&#x0002b;</bold></td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;&#x0002b;</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>M&#x000e9;diastinal LN</bold></td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">&#x02212;</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">3(a-b-c)</td><td align="left" rowspan="1" colspan="1">&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0002b;&#x0002b;&#x0002b;</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1"><bold>&#x0002b;&#x0002b;&#x0002b;&#x0002b;</bold></td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">&#x0002b;&#x0