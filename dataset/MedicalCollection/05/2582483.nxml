ce>Proc Natl Acad Sci USA</source><volume>94</volume><fpage>13293</fpage><lpage>13298</lpage><pub-id pub-id-type="pmid">9371839</pub-id></citation></ref><ref id="pone.0003775-Crick1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crick</surname><given-names>FHC</given-names></name></person-group><year>1989</year><article-title>Neuronal Edelmanism.</article-title><source>Trends Neurosci</source><volume>12</volume><fpage>240</fpage><lpage>248</lpage><pub-id pub-id-type="pmid">2475933</pub-id></citation></ref><ref id="pone.0003775-Crick2"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crick</surname><given-names>FHC</given-names></name></person-group><year>1990</year><article-title>Reply.</article-title><source>Trends Neurosci</source><volume>13</volume><fpage>13</fpage><lpage>14</lpage></citation></ref><ref id="pone.0003775-Dawkins1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dawkins</surname><given-names>R</given-names></name></person-group><year>1971</year><article-title>Selective neurone death as a possible memory mechanism.</article-title><source>Nature</source><volume>229</volume><fpage>118</fpage><lpage>119</lpage><pub-id pub-id-type="pmid">4923095</pub-id></citation></ref><ref id="pone.0003775-Seung1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Seung</surname><given-names>SH</given-names></name></person-group><year>2003</year><article-title>Learning in Spiking Neural Networks by Reinforcement of Stochastic Synaptic Transmission.</article-title><source>Neuron</source><volume>40</volume><fpage>1063</fpage><lpage>1973</lpage><pub-id pub-id-type="pmid">14687542</pub-id></citation></ref><ref id="pone.0003775-Michod1"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Michod</surname><given-names>RE</given-names></name></person-group><year>1988</year><article-title>Darwinian Selection in the Brain.</article-title><source>Evolution</source><volume>43</volume><fpage>694</fpage><lpage>696</lpage></citation></ref><ref id="pone.0003775-Beyer1"><label>27</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Beyer</surname><given-names>H-G</given-names></name></person-group><year>2001</year><source>The Theory of Evolution Strategies</source><publisher-name>Springer</publisher-name></citation></ref><ref id="pone.0003775-Pigliucci1"><label>28</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pigliucci</surname><given-names>M</given-names></name></person-group><year>2008</year><article-title>Is evolvability evolvable?</article-title><source>Nature Reviews Genetics</source><volume>9</volume><fpage>75</fpage><lpage>82</lpage></citation></ref><ref id="pone.0003775-Toussaint1"><label>29</label><citation citation-type="other"><person-group person-group-type="author"><name><surname>Toussaint</surname><given-names>M</given-names></name></person-group><year>2003</year><article-title>The evolution of genetic representations and modular adaptation.</article-title><comment>ND 04, 44780 Bochum&#x02014;Germany</comment></citation></ref><ref id="pone.0003775-Lynch1"><label>30</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lynch</surname><given-names>M</given-names></name></person-group><year>2007</year><article-title>The frailty of adaptive hypotheses for the origins of organismal complexity.</article-title><source>Proc Natl Acad Sci USA</source><volume>104</volume><fpage>8597</fpage><lpage>8604</lpage><pub-id pub-id-type="pmid">17494740</pub-id></citation></ref><ref id="pone.0003775-Calvin2"><label>31</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Calvin</surname><given-na