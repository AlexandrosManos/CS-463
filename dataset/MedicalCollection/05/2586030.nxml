b-id-type="pmid">7605973</pub-id><pub-id pub-id-type="doi">10.1093/occmed/45.3.125</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hensing</surname><given-names>G</given-names></name><name><surname>Alexanderson</surname><given-names>K</given-names></name><name><surname>Timpka</surname><given-names>T</given-names></name></person-group><article-title>Dilemmas in the daily work of social insurance officers</article-title><source>Scand J Social Welfare</source><year>1997</year><volume>6</volume><fpage>301</fpage><lpage>9</lpage><pub-id pub-id-type="doi">10.1111/j.1468-2397.1997.tb00201.x</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Englund</surname><given-names>L</given-names></name><name><surname>Tibblin</surname><given-names>G</given-names></name><name><surname>Svardsudd</surname><given-names>K</given-names></name></person-group><article-title>Effects on physicians' sick-listing practice of an administrative reform narrowing sick-listing benefits</article-title><source>Scand J Prim Health Care</source><year>2000</year><volume>18</volume><fpage>215</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">11205089</pub-id><pub-id pub-id-type="doi">10.1080/028134300448779</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johansen</surname><given-names>K</given-names></name><name><surname>Andersen</surname><given-names>JS</given-names></name><name><surname>Mikkelsen</surname><given-names>S</given-names></name><name><surname>Pass</surname><given-names>O</given-names></name><name><surname>Raffnsoe</surname><given-names>S</given-names></name><name><surname>Lynge</surname><given-names>E</given-names></name></person-group><article-title>Controlling sickness absence A study of changes in the Danish sickness absence legislation since 1973</articl