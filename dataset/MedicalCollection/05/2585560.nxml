<fpage>430</fpage><lpage>437</lpage><pub-id pub-id-type="pmid">9308559</pub-id><pub-id pub-id-type="doi">10.1016/S0190-9622(97)70145-2</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tosca</surname><given-names>A</given-names></name><name><surname>Varelzidis</surname><given-names>A</given-names></name><name><surname>Bassioukas</surname><given-names>K</given-names></name><name><surname>Hatzis</surname><given-names>J</given-names></name><name><surname>Nicolis</surname><given-names>G</given-names></name><name><surname>Stratigos</surname><given-names>J</given-names></name></person-group><article-title>Some further features for differential diagnosis between squamous cell carcinomas and basal cell epitheliomas</article-title><source>Dermatologica</source><year>1985</year><volume>171</volume><fpage>21</fpage><lpage>26</lpage><pub-id pub-id-type="pmid">2411609</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>de Faria</surname><given-names>JL</given-names></name><name><surname>Navarrete</surname><given-names>MA</given-names></name></person-group><article-title>The histopathology of the skin basal cell carcinoma with areas of intermediate differentiation: A metatypical carcinoma?</article-title><source>Pathol Res Pract</source><year>1991</year><volume>187</volume><fpage>978</fpage><lpage>988</lpage><pub-id pub-id-type="pmid">1792194</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sari</surname><given-names>A</given-names></name><name><surname>Basterzi</surname><given-names>Y</given-names></name><name><surname>Yavuzer</surname><given-names>R</given-names></name><name><surname>Latifoglu</surname><given-names>O</given-names></name></person-group><article-title>Linear Nevus Sebaceus Complicated with Metatypical Carcinoma</article-title><sour