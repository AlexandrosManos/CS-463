<year>1998</year><volume>49</volume><fpage>281</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">9617489</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oesterling</surname><given-names>JE</given-names></name><name><surname>Fishman</surname><given-names>EK</given-names></name><name><surname>Goldman</surname><given-names>SM</given-names></name><name><surname>Marshall</surname><given-names>FF</given-names></name></person-group><article-title>The management of renal angiomyolipoma</article-title><source>J Urol</source><year>1986</year><volume>135</volume><fpage>1121</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">3520013</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stillwell</surname><given-names>TJ</given-names></name><name><surname>Gomez</surname><given-names>MR</given-names></name><name><surname>Kelalis</surname><given-names>PP</given-names></name></person-group><article-title>Renal lesions in tuberous sclerosis</article-title><source>J Urol</source><year>1987</year><volume>138</volume><fpage>477</fpage><lpage>81</lpage><pub-id pub-id-type="pmid">3625844</pub-id></citation></ref></ref-list></back></article>