page>1683</fpage>&#x02013;<lpage>1692</lpage>. Washington DC: ASM Press</citation></ref><ref id="b27"><citation citation-type="journal"><name><surname>Nishio</surname><given-names>K</given-names></name>, <name><surname>Iwamoto-Kihara</surname><given-names>A</given-names></name>, <name><surname>Yamamoto</surname><given-names>A</given-names></name>, <name><surname>Wada</surname><given-names>Y</given-names></name>, <name><surname>Futai</surname><given-names>M</given-names></name> (<year>2002</year>) <article-title>Subunit rotation of ATP synthase embedded in membranes: a or beta subunit rotation relative to the c subunit ring</article-title>. <source>Proc Natl Acad Sci USA</source> <volume>99</volume>: <fpage>13448</fpage>&#x02013;<lpage>13452</lpage><pub-id pub-id-type="pmid">12357031</pub-id></citation></ref><ref id="b28"><citation citation-type="journal"><name><surname>Nirenberg</surname><given-names>M</given-names></name> (<year>2004</year>) <article-title>Historical review: deciphering the genetic code&#x02014;a personal account</article-title>. <source>Trends Biochem Sci</source> <volume>29</volume>: <fpage>46</fpage>&#x02013;<lpage>54</lpage><pub-id pub-id-type="pmid">14729332</pub-id></citation></ref><ref id="b29"><citation citation-type="journal"><name><surname>Nirenberg</surname><given-names>MW</given-names></name>, <name><surname>Matthaei</surname><given-names>JH</given-names></name> (<year>1961</year>) <article-title>The dependence of cell-free protein synthesis in <italic>E. coli</italic> upon naturally occurring or synthetic polyribonucleotides</article-title>. <source>Proc Natl Acad Sci USA</source> <volume>47</volume>: <fpage>1588</fpage>&#x02013;<lpage>1602</lpage><pub-id pub-id-type="pmid">14479932</pub-id></citation></ref><ref id="b30"><citation citation-type="journal"><name><surname>Noireaux</surname><given-names>V</given-names></name>, <name><surname>Bar-Ziv</surname><given-names>R</given-names></name>, <name><surname>Libchaber</surname><given-name