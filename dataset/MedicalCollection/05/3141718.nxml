d></mixed-citation></ref><ref id="B9"><mixed-citation publication-type="journal"><name><surname>Dimitriadis</surname><given-names>G</given-names></name><name><surname>Mitrou</surname><given-names>P</given-names></name><name><surname>Lambadiari</surname><given-names>V</given-names></name><name><surname>Boutati</surname><given-names>E</given-names></name><name><surname>Maratou</surname><given-names>E</given-names></name><name><surname>Panagiotakos</surname><given-names>DB</given-names></name><name><surname>Koukkou</surname><given-names>E</given-names></name><name><surname>Tzanela</surname><given-names>M</given-names></name><name><surname>Thalassinos</surname><given-names>N</given-names></name><name><surname>Raptis</surname><given-names>SA</given-names></name><article-title>Insulin action in adipose tissue and muscle in hypothyroidism</article-title><source>J Clin Endocrinol Metab</source><year>2006</year><volume>91</volume><fpage>4930</fpage><lpage>4937</lpage><pub-id pub-id-type="doi">10.1210/jc.2006-0478</pub-id><pub-id pub-id-type="pmid">17003097</pub-id></mixed-citation></ref><ref id="B10"><mixed-citation publication-type="journal"><name><surname>Crunkhorn</surname><given-names>S</given-names></name><name><surname>Patti</surname><given-names>ME</given-names></name><article-title>Links between thyroid hormone action, oxidative metabolism and diabetes risk</article-title><source>Thyroid</source><year>2008</year><volume>18</volume><fpage>227</fpage><lpage>237</lpage><pub-id pub-id-type="doi">10.1089/thy.2007.0249</pub-id><pub-id pub-id-type="pmid">18279023</pub-id></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><name><surname>Mohn</surname><given-names>A</given-names></name><name><surname>Di Michele</surname><given-names>S</given-names></name><name><surname>Di Luzio</surname><given-names>R</given-names></name><name><surname>Tumini</surname><given-names>S</given-names></name><name><surname>Chiarelli</surname><given-names>F</given-names></name><article-title>The effect of subclinical hypothyroidism on metabolic control in children and adolescents with type 1 diabetes mellitus</article-title><source>Diabet Med</source><year>2002</year><volume>19</volume><fpage>70</fpage><lpage>73</lpage><pub-id pub-id-type="doi">10.1046/j.1464-5491.2002.00635.x</pub-id><pub-id pub-id-type="pmid">11869306</pub-id></mixed-citation></ref></ref-list></back></article>