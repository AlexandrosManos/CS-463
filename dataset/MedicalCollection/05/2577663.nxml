">10.1124/dmd.106.011759</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ciana</surname><given-names>P</given-names></name><name><surname>Raviscioni</surname><given-names>M</given-names></name><name><surname>Mussi</surname><given-names>P</given-names></name><name><surname>Vegeto</surname><given-names>E</given-names></name><name><surname>Que</surname><given-names>I</given-names></name><name><surname>Parker</surname><given-names>MG</given-names></name><name><surname>Lowik</surname><given-names>C</given-names></name><name><surname>Maggi</surname><given-names>A</given-names></name></person-group><article-title>In vivo imaging of transcriptionally active estrogen receptors</article-title><source>Nat Med</source><year>2003</year><volume>9</volume><fpage>82</fpage><lpage>86</lpage><pub-id pub-id-type="pmid">12483206</pub-id><pub-id pub-id-type="doi">10.1038/nm809</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boverhof</surname><given-names>DR</given-names></name><name><surname>Fertuck</surname><given-names>KC</given-names></name><name><surname>Burgoon</surname><given-names>LD</given-names></name><name><surname>Eckel</surname><given-names>JE</given-names></name><name><surname>Gennings</surname><given-names>C</given-names></name><name><surname>Zacharewski</surname><given-names>TR</given-names></name></person-group><article-title>Temporal- and dose-dependent hepatic gene expression changes in immature ovariectomized mice following exposure to ethynyl estradiol</article-title><source>Carcinogenesis</source><year>2004</year><volume>25</volume><fpage>1277</fpage><lpage>1291</lpage><pub-id pub-id-type="pmid">14976129</pub-id><pub-id pub-id-type="doi">10.1093/carcin/bgh114</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kiyosawa</surname><giv