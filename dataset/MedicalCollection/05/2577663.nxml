-type="pmid">17630905</pub-id><pub-id pub-id-type="doi">10.1134/S000629790706003X</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Suino</surname><given-names>K</given-names></name><name><surname>Peng</surname><given-names>L</given-names></name><name><surname>Reynolds</surname><given-names>R</given-names></name><name><surname>Li</surname><given-names>Y</given-names></name><name><surname>Cha</surname><given-names>JY</given-names></name><name><surname>Repa</surname><given-names>JJ</given-names></name><name><surname>Kliewer</surname><given-names>SA</given-names></name><name><surname>Xu</surname><given-names>HE</given-names></name></person-group><article-title>The nuclear xenobiotic receptor CAR: structural determinants of constitutive activation and heterodimerization</article-title><source>Mol Cell</source><year>2004</year><volume>16</volume><fpage>893</fpage><lpage>905</lpage><pub-id pub-id-type="pmid">15610733</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pustylnyak</surname><given-names>VO</given-names></name><name><surname>Lebedev</surname><given-names>AN</given-names></name><name><surname>Gulyaeva</surname><given-names>LF</given-names></name><name><surname>Lyakhovich</surname><given-names>VV</given-names></name><name><surname>Slynko</surname><given-names>NM</given-names></name></person-group><article-title>Comparative study of CYP2B induction in the liver of rats and mice by different compounds</article-title><source>Life Sci</source><year>2007</year><volume>80</volume><fpage>324</fpage><lpage>328</lpage><pub-id pub-id-type="pmid">17045615</pub-id><pub-id pub-id-type="doi">10.1016/j.lfs.2006.09.015</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Williams</surname><given-names>CE</given-names></name><name><surname>Crawford</