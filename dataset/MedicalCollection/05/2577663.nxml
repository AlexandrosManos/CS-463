"><bold><underline>5.12</underline></bold></td><td align="center"><bold><underline>6.80</underline></bold></td><td align="center"><bold><underline>3.32</underline></bold></td></tr><tr><td align="center"><italic>Tnfrsf19</italic></td><td align="center">29820</td><td align="center"><bold><underline>1.22</underline></bold></td><td align="center">1.75</td><td align="center">5.86</td><td align="center">4.29</td><td align="center">1.67</td><td align="center"><bold><underline>1.66</underline></bold></td><td align="center"><bold><underline>2.21</underline></bold></td></tr><tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left" colspan="9">Metabolism</td></tr><tr><td align="center"><italic>ApoA4</italic></td><td align="center">11808</td><td align="center"><bold><underline>1.15</underline></bold></td><td align="center"><bold><underline>1.05</underline></bold></td><td align="center">4.31</td><td align="center">5.03</td><td align="center">5.74</td><td align="center">3.54</td><td align="center"><bold><underline>3.34</underline></bold></td></tr><tr><td align="center"><italic>Ces2</italic></td><td align="center">234671</td><td align="center"><bold><underline>1.16</underline></bold></td><td align="center">1.46</td><td align="center">1.68</td><td align="center"><bold><underline>2.22</underline></bold></td><td align="center">2.11</td><td align="center"><bold><underline>3.36</underline></bold></td><td align="center">3.05</td></tr><tr><td align="center"><italic>Cyp17a1</italic></td><td align="center">13074</td><td align="center"><bold><underline>1.43</underline></bold></td><td align="center"><bold><underline>1.27</underline></bold></td><td align="center">3.97</td><td align="center"><bold><underline>6.24</underline></bold></td><td align="center">5.52</td><td align="center"><bold><underline>3.68</underline></bold></td><td align="center"><bold><underline>1.88</underline></bold></td></tr><tr><td align="center"><italic>Cyp51</italic></t