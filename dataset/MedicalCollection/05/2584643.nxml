="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Charavaryamath</surname><given-names>C</given-names></name><name><surname>Juneau</surname><given-names>V</given-names></name><name><surname>Suri</surname><given-names>SS</given-names></name><name><surname>Janardhan</surname><given-names>KS</given-names></name><name><surname>Townsend</surname><given-names>H</given-names></name><name><surname>Singh</surname><given-names>B</given-names></name></person-group><article-title>Role of toll-like receptor 4 in lung inflammation following exposure to Swine barn air</article-title><source>Exp Lung Res</source><year>2008</year><volume>34</volume><fpage>19</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">18205075</pub-id><pub-id pub-id-type="doi">10.1080/01902140701807779</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gamage</surname><given-names>LN</given-names></name><name><surname>Charavaryamath</surname><given-names>C</given-names></name><name><surname>Swift</surname><given-names>TL</given-names></name><name><surname>Singh</surname><given-names>B</given-names></name></person-group><article-title>Lung inflammation following a single exposure to swine barn air</article-title><source>J Occup Med Toxicol</source><year>2007</year><volume>2</volume><fpage>18</fpage><pub-id pub-id-type="pmid">18088427</pub-id><pub-id pub-id-type="doi">10.1186/1745-6673-2-18</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Charavaryamath</surname><given-names>C</given-names></name><name><surname>Janardhan</surname><given-names>KS</given-names></name><name><surname>Caldwell</surname><given-names>S</given-names></name><name><surname>Singh</surname><given-names>B</given-names></name></person-group><article-title>Pulmonary intravascular monocytes/macrophages in a rat model of sepsis</article-title>