10759453</pub-id><pub-id pub-id-type="doi">10.1034/j.1399-3003.2000.15.22.x</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Larsson</surname><given-names>K</given-names></name><name><surname>Eklund</surname><given-names>AG</given-names></name><name><surname>Hansson</surname><given-names>LO</given-names></name><name><surname>Isaksson</surname><given-names>BM</given-names></name><name><surname>Malmberg</surname><given-names>PO</given-names></name></person-group><article-title>Swine dust causes intense airways inflammation in healthy subjects</article-title><source>Am J Respir Crit Care Med</source><year>1994</year><volume>150</volume><fpage>973</fpage><lpage>977</lpage><pub-id pub-id-type="pmid">7921472</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Malmberg</surname><given-names>P</given-names></name><name><surname>Larsson</surname><given-names>K</given-names></name></person-group><article-title>Acute exposure to swine dust causes bronchial hyperresponsiveness in healthy subjects</article-title><source>Eur Respir J</source><year>1993</year><volume>6</volume><fpage>400</fpage><lpage>404</lpage><pub-id pub-id-type="pmid">8472831</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Larsson</surname><given-names>BM</given-names></name><name><surname>Palmberg</surname><given-names>L</given-names></name><name><surname>Malmberg</surname><given-names>PO</given-names></name><name><surname>Larsson</surname><given-names>K</given-names></name></person-group><article-title>Effects of exposure to swine dust on levels of IL-8 in airway lavage fluid</article-title><source>Thorax</source><year>1997</year><volume>52</volume><fpage>638</fpage><lpage>642</lpage><pub-id pub-id-type="pmid">9246137</pub-id></citation></ref><ref id="B12"><citation citation-