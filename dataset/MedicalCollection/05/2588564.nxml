ation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lindeque</surname><given-names>BG</given-names></name></person-group><article-title>Management of cervical premalignant lesions</article-title><source>Best Practice and Research Clinical Obstetrics and Gynaecology</source><year>2005</year><volume>19</volume><fpage>545</fpage><lpage>561</lpage><pub-id pub-id-type="pmid">16150393</pub-id><pub-id pub-id-type="doi">10.1016/j.bpobgyn.2005.02.008</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Soutter</surname><given-names>WP</given-names></name><name><surname>Fletcher</surname><given-names>A</given-names></name></person-group><article-title>Invasive cancer of the cervix in women with mild dyskaryosis followed up cytologically</article-title><source>British Medical Journal</source><year>1994</year><volume>308</volume><fpage>1421</fpage><lpage>1423</lpage><pub-id pub-id-type="pmid">8019256</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Flannelly</surname><given-names>G</given-names></name><name><surname>Anderson</surname><given-names>D</given-names></name><name><surname>Kitchener</surname><given-names>HC</given-names></name><name><surname>Mann</surname><given-names>EMF</given-names></name><name><surname>Campbell</surname><given-names>M</given-names></name><name><surname>Fisher</surname><given-names>P</given-names></name><name><surname>Walker</surname><given-names>F</given-names></name><name><surname>Templeton</surname><given-names>AA</given-names></name></person-group><article-title>Management of women with mild and moderate cervical dyskaryosis</article-title><source>British Medical Journal</source><year>1994</year><volume>308</volume><fpage>1399</fpage><lpage>1403</lpage><pub-id pub-id-type="pmid">8019248</pub-id></citation></ref><ref id="B22"><ci