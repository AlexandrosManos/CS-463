s></name></person-group><article-title>Practice and experience: deciphering data anomalies in BioSense</article-title><source>Morb Mortal Wkly Rep</source><year>2005</year><volume>54</volume><fpage>133</fpage><lpage>9</lpage></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Soetebier</surname><given-names>K</given-names></name><name><surname>Murray</surname><given-names>E</given-names></name><name><surname>Cowell</surname><given-names>A</given-names></name></person-group><article-title>Spatio-temporal visualizations as interface: Constructing geographic animations of disease surveillance data in a syndromic surveillance system</article-title><source>Adv Dis Surv</source><year>2007</year><volume>2</volume><fpage>68</fpage></citation></ref><ref id="B9"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>H</given-names></name><name><surname>Zeng</surname><given-names>D</given-names></name><name><surname>Tseng</surname><given-names>C</given-names></name><name><surname>Larson</surname><given-names>C</given-names></name></person-group><article-title>The BioPortal Project: a National Center of Excellence for Infectious Disease Informatics</article-title><year>2006</year></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Buetow</surname><given-names>T</given-names></name><name><surname>Chaboya</surname><given-names>L</given-names></name><name><surname>O'Toole</surname><given-names>C</given-names></name><name><surname>Cushna</surname><given-names>T</given-names></name><name><surname>Daspit</surname><given-names>D</given-names></name><name><surname>Petersen</surname><given-names>T</given-names></name><name><surname>Atabakhsh</surname><given-names>H</given-names></name><name><surname>Chen</surname><given-names>H</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Chen H</surname></name></person-group><article-title>A spatio-temporal visualizer for law enforcement</article-title><source>Lecture Notes in Computer Science</source><year>2003</year><publisher-name>New York, Springer-Verlag Berlin Heidelberg</publisher-name></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buehler</surname><given-names>JW</given-names></name><name><surname>Hopkins</surname><given-names>RS</given-names></name><name><surname>Overhage</surname><given-names>JM</given-names></name><name><surname>Sosin</surname><given-names>DM</given-names></name><name><surname>Tong</surname><given-names>V</given-names></name></person-group><article-title>Framework for evaluating public health surveillance systems for early detection of outbreaks. Recommendations from the CDC Working Group</article-title><source>Morb Mort Wkly Rep</source><year>2004</year><volume>54</volume><fpage>1</fpage><lpage>11</lpage></citation></ref></ref-list></back></article>