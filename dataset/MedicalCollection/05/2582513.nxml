eft" rowspan="1" colspan="1">Numerous nodules in surgical bed (largest, 3.0 &#x000d7; 2.0 cm)</td><td align="center" rowspan="1" colspan="1">14.0 &#x000d7; 21.0</td><td align="center" rowspan="1" colspan="1">40/20 (twice daily)</td><td align="center" rowspan="1" colspan="1">Yes</td></tr></tbody></table></table-wrap><table-wrap id="tIII-co15-5-229" position="float"><label>TABLE III</label><caption><p>Patient outcomes</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1">Case</th><th align="center" rowspan="1" colspan="1">Local outcome</th><th align="center" rowspan="1" colspan="1">Metachronous lesions?</th><th align="center" rowspan="1" colspan="1">Current status</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">Local control at 2 months</td><td align="center" rowspan="1" colspan="1">Y</td><td align="center" rowspan="1" colspan="1">Alive</td></tr><tr><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">Local recurrence at 11 months</td><td align="center" rowspan="1" colspan="1">Y</td><td align="center" rowspan="1" colspan="1">Alive</td></tr><tr><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">Local recurrence at 5 months</td><td align="center" rowspan="1" colspan="1">Y</td><td align="center" rowspan="1" colspan="1">Deceased (from <sc>scc</sc>)</td></tr><tr><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">Local control at 2 months</td><td align="center" rowspan="1" colspan="1">Y</td><td align="center" rowspan="1" colspan="1">Alive</td></tr></tbody></table></table-wrap><table-wrap id="tIV-co15-5-229" position="float"><label>TABLE IV</label><caption><p>History and treatment of chronic lymphocytic leukemia (<sc>cll</sc>)</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1">Case</th><th align="center"