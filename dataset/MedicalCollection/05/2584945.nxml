ncer</article-title><source>Cell</source><year>2008</year><volume>134</volume><fpage>215</fpage><lpage>230</lpage><!--PubMed citation query: 'Cell||134|215||bib15|'--><pub-id pub-id-type="pmid">18662538</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Medeiros</surname><given-names>R</given-names></name><name><surname>Morais</surname><given-names>A</given-names></name><name><surname>Vasconcelos</surname><given-names>A</given-names></name><name><surname>Costa</surname><given-names>S</given-names></name><name><surname>Pinto</surname><given-names>D</given-names></name><name><surname>Oliveira</surname><given-names>J</given-names></name><name><surname>Carvalho</surname><given-names>R</given-names></name><name><surname>Lopes</surname><given-names>C</given-names></name></person-group><article-title>Linkage between polymorphisms in the prostate specific antigen ARE1 gene region, prostate cancer risk, and circulating tumor cells</article-title><source>Prostate</source><year>2002</year><volume>53</volume><fpage>88</fpage><lpage>94</lpage><!--PubMed citation query: 'Prostate||53|88||bib16|'--><pub-id pub-id-type="pmid">12210484</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rao</surname><given-names>A</given-names></name><name><surname>Chang</surname><given-names>BL</given-names></name><name><surname>Hawkins</surname><given-names>G</given-names></name><name><surname>Hu</surname><given-names>JJ</given-names></name><name><surname>Rosser</surname><given-names>CJ</given-names></name><name><surname>Hall</surname><given-names>MC</given-names></name><name><surname>Meyers</surname><given-names>DA</given-names></name><name><surname>Xu</surname><given-names>J</given-names></name><name><surname>Cramer</surname><given-names>SD</given-names></name></person-group><article-title>Analysis of G/A polymorphism in the androgen respo