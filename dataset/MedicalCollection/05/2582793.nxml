<ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Funk</surname><given-names>M</given-names></name><name><surname>Reid</surname><given-names>C</given-names></name></person-group><article-title>Indexing consistency in MEDLINE</article-title><source>Bull Med Libr Assoc</source><year>1983</year><volume>71</volume><fpage>176</fpage><lpage>83</lpage><pub-id pub-id-type="pmid">6344946</pub-id></citation></ref><ref id="B20"><citation citation-type="other"><person-group person-group-type="author"><name><surname>de Bruijn</surname><given-names>L</given-names></name><name><surname>Hasman</surname><given-names>A</given-names></name><name><surname>Arends</surname><given-names>J</given-names></name></person-group><article-title>Automatic SNOMED classification &#x02013; a corpus based method</article-title><source>Yearbook of Medical Informatics</source><year>1999</year></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Despont-Gros</surname><given-names>C</given-names></name><name><surname>Mueller</surname><given-names>H</given-names></name><name><surname>Lovis</surname><given-names>C</given-names></name></person-group><article-title>Evaluating user interactions with clinical information systems: a model based on human-computer interaction models</article-title><source>J Biomed Inform</source><year>2005</year><volume>38</volume><fpage>244</fpage><lpage>255</lpage><pub-id pub-id-type="pmid">15896698</pub-id><pub-id pub-id-type="doi">10.1016/j.jbi.2004.12.004</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bowman</surname><given-names>S</given-names></name></person-group><article-title>Coordinating SNOMED-CT and ICD-10</article-title><source>J AHIMA</source><year>2005</year><fpage>60</fpage><lpage>1</lpage><pub-id pub-id-type="pmid">16097126</pub-id></citation></ref><ref id="B23"