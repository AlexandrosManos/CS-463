<source>J Comput Aided Mol Des</source><year>2003</year><volume>17</volume><fpage>119</fpage><pub-id pub-id-type="pmid">13677480</pub-id></citation></ref><ref id="R20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oellien</surname><given-names>F</given-names></name><etal/></person-group><source>J Chem Inf Model</source><year>2006</year><volume>46</volume><fpage>2342</fpage><pub-id pub-id-type="pmid">17125178</pub-id></citation></ref><ref id="R21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Keller</surname><given-names>TH</given-names></name><etal/></person-group><source>Curr Opin Chem Biol</source><year>2006</year><volume>10</volume><fpage>357</fpage><pub-id pub-id-type="pmid">16814592</pub-id></citation></ref><ref id="R22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Krier</surname><given-names>M</given-names></name><etal/></person-group><source>J Chem Inf Model</source><year>2006</year><volume>46</volume><fpage>512</fpage><pub-id pub-id-type="pmid">16562979</pub-id></citation></ref></ref-list></back><floats-wrap><fig id="F1" position="float"><label>Figure 1</label><caption><p>Virtual high throughput screening workflow.</p></caption><graphic xlink:href="97320630003014F1"/></fig><fig id="F2" position="float"><label>Figure 2</label><caption><p>Drug-like compounds [<xref ref-type="bibr" rid="R21">21</xref>].</p></caption><graphic xlink:href="97320630003014F2"/></fig></floats-wrap></article>