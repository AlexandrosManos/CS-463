name><surname>Johnston</surname><given-names>RA</given-names></name></person-group><article-title>Transoral evacuation of a clivus extradural haematoma with good recovery: A case report</article-title><source>Br J Neurosurg</source><year>1997</year><volume>11</volume><fpage>245</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">9231015</pub-id></element-citation></ref><ref id="ref11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Menezes</surname><given-names>AH</given-names></name></person-group><article-title>Craniovertebral junction database analysis: incidence, classification, presentation, and treatment algorithms</article-title><source>Childs Nerv Syst</source><year>2008</year><volume>24</volume><fpage>1101</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">18392838</pub-id></element-citation></ref><ref id="ref12"><label>12</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Menezes</surname><given-names>AH</given-names></name></person-group><person-group person-group-type="editor"><name><surname>HR</surname><given-names>W</given-names></name></person-group><article-title>Developmental abnormalities of the craniovertebral junction</article-title><source>Youman's neurological surgery</source><year>2003</year><edition>5 ed</edition><publisher-loc>Philadelphia</publisher-loc><publisher-name>WB Saunders</publisher-name><fpage>3331</fpage><lpage>46</lpage></element-citation></ref><ref id="ref13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mizushima</surname><given-names>H</given-names></name><name><surname>Kobayashi</surname><given-names>N</given-names></name><name><surname>Sawabe</surname><given-names>Y</given-names></name><name><surname>Hanakawa</surname><given-names>K</given-names></name><name><surname>Jinbo</surname><given-names>H</given-names></name><name><surname>Iida</surname><given-names>M</given-names></name><etal/></person-group><article-title>Epidural hematoma of the clivus. Case report</article-title><source>J Neurosurg</source><year>1998</year><volume>88</volume><fpage>590</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">9488318</pub-id></element-citation></ref><ref id="ref14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Papadopoulos</surname><given-names>SM</given-names></name><name><surname>Dickman</surname><given-names>CA</given-names></name><name><surname>Sonntag</surname><given-names>VK</given-names></name><name><surname>Rekate</surname><given-names>HL</given-names></name><name><surname>Spetzler</surname><given-names>RF</given-names></name></person-group><article-title>Traumatic atlantooccipital dislocation with survival</article-title><source>Neurosurgery</source><year>1991</year><volume>28</volume><fpage>574</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">2034353</pub-id></element-citation></ref><ref id="ref15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ratilal</surname><given-names>B</given-names></name><name><surname>Castanho</surname><given-names>P</given-names></name><name><surname>Vara Luiz</surname><given-names>C</given-names></name><name><surname>Antunes</surname><given-names>JO</given-names></name></person-group><article-title>Traumatic clivus epidural hematoma: case report and review of the literature</article-title><source>Surg Neurol</source><year>2006</year><volume>66</volume><fpage>200</fpage><lpage>2</lpage><comment>discussion 202</comment><pub-id pub-id-type="pmid">16876630</pub-id></element-citation></ref><ref id="ref16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Robertson</surname><given-names>JH</given-names></name><name><surname>Clark</surname><given-names>WC</given-names></name><name><surname>Acker</surname><given-names>JD</given-names></name></person-group><article-title>Bilateral occipital epidural hematomas</article-title><source>Surg Neurol</source><year>1982</year><volume>17</volume><fpage>468</fpage><lpage>72</lpage><pub-id pub-id-type="pmid">7112380</pub-id></element-citation></ref><ref id="ref17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Schievink</surname><given-names>WI</given-names></name><name><surname>Thompson</surname><given-names>RC</given-names></name><name><surname>Loh</surname><given-names>CT</given-names></name><name><surname>Maya</surname><given-names>MM</given-names></name></person-group><article-title>Spontaneous retroclival hematoma presenting as a thunderclap headache. Case report</article-title><source>J Neurosurg</source><year>2001</year><volume>95</volume><fpage>522</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">11565879</pub-id></element-citation></ref><ref id="ref18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Tubbs</surname><given-names>RS</given-names></name><name><surname>Griessenauer</surname><given-names>CJ</given-names></name><name><surname>Hankinson</surname><given-names>T</given-names></name><name><surname>Rozzelle</surname><given-names>C</given-names></name><name><surname>Wellons</surname><given-names>JC</given-names><suffix>3rd</suffix></name><name><surname>Blount</surname><given-names>JP</given-names></name><etal/></person-group><article-title>Retroclival epidural hematomas: A clinical series</article-title><source>Neurosurgery</source><year>2010</year><volume>67</volume><fpage>404</fpage><lpage>6</lpage><comment>discussion 406-407</comment><pub-id pub-id-type="pmid">20644426</pub-id></element-citation></ref><ref id="ref19"><label>19</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Williams</surname><given-names>PL</given-names></name><name><surname>Dyson</surname><given-names>M</given-names></name></person-group><article-title>Osteology, Intracartilaginous ossification</article-title><source>Gray's Anatomy</source><year>1992</year><edition>37th ed</edition><publisher-loc>New York</publisher-loc><publisher-name>Churchill Livingstone</publisher-name><fpage>304</fpage><lpage>8</lpage></element-citation></ref></ref-list></back></article>