id></citation></ref><ref id="bib11"><label>11</label><citation citation-type="journal">Monney, L., et al. <year>2002</year>. Th1-specific cell surface protein Tim-3 regulates macrophage activation and severity of an autoimmune disease. <source>Nature.</source> <volume>415</volume>:<fpage>536</fpage>&#x02013;541.<pub-id pub-id-type="pmid">11823861</pub-id></citation></ref><ref id="bib12"><label>12</label><citation citation-type="journal">Zhu, C., A.C. Anderson, A. Schubart, H. Xiong, J. Imitola, S.J. Khoury, X.X. Zheng, T.B. Storm, and V.K. Kuchroo. <year>2005</year>. The Tim-3 ligand galectin-9 negatively regulates T helper type 1 immunity. <source>Nat. Immunol.</source> <volume>6</volume>:<fpage>1245</fpage>&#x02013;1252.<pub-id pub-id-type="pmid">16286920</pub-id></citation></ref><ref id="bib13"><label>13</label><citation citation-type="journal">Sabatos, C.A., S. Chakravarti, E. Cha, A. Schubart, A. Sanchez -Fueyo, X.X. Zheng, G.J. Freeman, and V.K. Kuchroo. <year>2003</year>. Interaction of Tim-3 and Tim-3 ligand regulates T helper type 1 responses and induction of peripheral tolerance. <source>Nat. Immunol.</source> <volume>4</volume>:<fpage>1102</fpage>&#x02013;1110.<pub-id pub-id-type="pmid">14556006</pub-id></citation></ref><ref id="bib14"><label>14</label><citation citation-type="journal">Sanchez-Fueyo, A., et al. <year>2003</year>. TIM-3 inhibits T helper type 1-mediated auto- and alloimmune responses and promotes immunological tolerance. <source>Nat. Immunol.</source> <volume>4</volume>:<fpage>1093</fpage>&#x02013;1101.<pub-id pub-id-type="pmid">14556005</pub-id></citation></ref><ref id="bib15"><label>15</label><citation citation-type="journal">Koguchi, K., D.E. Anderson, L. Yang, K.C. O'Connor, V.K. Kuchroo, and D.A. Hafler. <year>2006</year>. Dysregulated T cell expression of TIM3 in multiple sclerosis. <source>J. Exp. Med.</source> <volume>203</volume>:<fpage>1413</fpage>&#x02013;1418.<pub-id pub-id-type="pmid">16754722</pub-id></citation></ref><ref id="bib16"><label>16</label><citation citation-type="journal">Yang, L., D.E. Anderson, J. Kuchroo, and D.A. Hafler. <year>2008</year>. Lack of TIM-3 immunoregulation in multiple sclerosis. <source>J. Immunol.</source> <volume>180</volume>:<fpage>4409</fpage>&#x02013;4414.<pub-id pub-id-type="pmid">18354161</pub-id></citation></ref><ref id="bib17"><label>17</label><citation citation-type="journal">Kaplan, G., A. Totsuka, P. Thompson, T. Akatsuka, Y. Moritsugu, S.M. Feinstone. <year>1996</year>. Identification of a surface glycoprotein on African green monkey kidney cells as a receptor for hepatitis A virus. <source>EMBO J.</source> <volume>15</volume>:<fpage>4282</fpage>&#x02013;4296.<pub-id pub-id-type="pmid">8861957</pub-id></citation></ref><ref id="bib18"><label>18</label><citation citation-type="journal">McIntire, J.J., D.T. Umetsu, and R.H. DeKruyff. <year>2004</year>. TIM-1, a novel allergy and asthma susceptibility gene. <source>Springer Semin. Immunopathol.</source> <volume>25</volume>:<fpage>335</fpage>&#x02013;348.<pub-id pub-id-type="pmid">15007635</pub-id></citation></ref><ref id="bib19"><label>19</label><citation citation-type="journal">Barber, D.L., E.J. Wherry, D. Masopust, B. Zhu, J.P. Allison, A.H. Sharpe, G.J. Freeman, and R. Ahmed. <year>2006</year>. Restoring function in exhausted CD8 T cells during chronic viral infection. <source>Nature.</source> <volume>439</volume>:<fpage>682</fpage>&#x02013;687.<pub-id pub-id-type="pmid">16382236</pub-id></citation></ref><ref id="bib20"><label>20</label><citation citation-type="journal">Petrovas, C., et al. <year>2007</year>. SIV-specific CD8&#x0002b; T cells express high levels of PD1 and cytokines but have impaired proliferative capacity in acute and chronic SIVmac251 infection. <source>Blood.</source> <volume>110</volume>:<fpage>928</fpage>&#x02013;936.<pub-id pub-id-type="pmid">17440051</pub-id></citation></ref><ref id="bib21"><label>21</label><citation citation-type="journal">Zhang, J.Y., et al. <year>2007</year>. PD-1 up-regulation is correlated with HIV-specific memory CD8&#x0002b; T-cell exhaustion in typical progressors but not in long-term nonprogressors. <source>Blood.</source> <volume>109</volume>:<fpage>4671</fpage>&#x02013;4678.<pub-id pub-id-type="pmid">17272504</pub-id></citation></ref></ref-list></back></article>