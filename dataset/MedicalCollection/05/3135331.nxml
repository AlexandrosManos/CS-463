 id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Velasco-Villa</surname><given-names>A</given-names></name><name><surname>Reeder</surname><given-names>SA</given-names></name><name><surname>Orciari</surname><given-names>LA</given-names></name><etal/></person-group><article-title>Enzootic rabies elimination from dogs and reemergence in wild terrestrial carnivores, United States</article-title><source><italic>Emerging Infectious Diseases</italic></source><year>2008</year><volume>14</volume><issue>12</issue><fpage>1849</fpage><lpage>1854</lpage><pub-id pub-id-type="pmid">19046506</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Knobel</surname><given-names>DL</given-names></name><name><surname>Cleaveland</surname><given-names>S</given-names></name><name><surname>Coleman</surname><given-names>PG</given-names></name><etal/></person-group><article-title>Re-evaluating the burden of rabies in Africa and Asia</article-title><source><italic>Bulletin of the World Health Organization</italic></source><year>2005</year><volume>83</volume><issue>5</issue><fpage>360</fpage><lpage>368</lpage><pub-id pub-id-type="pmid">15976877</pub-id></element-citation></ref><ref id="B19"><label>19</label><element-citation publication-type="other"><collab>BaliDiscoveryTours</collab><comment>October 2010, <ext-link ext-link-type="uri" xlink:href="http://www.balidiscovery.com/">http://www.balidiscovery.com/</ext-link></comment></element-citation></ref><ref id="B20"><label>20</label><element-citation publication-type="other"><collab>CDC</collab><article-title>Rabies in Bali, Indonesia</article-title><comment>October 2010, <ext-link ext-link-type="uri" xlink:href="http://wwwnc.cdc.gov/travel/content/outbreak-notice/rabies-bali-indonesia2008.aspx">http://wwwnc.cdc.gov/travel/content/outbreak-notice/rabies-bali-in