erson-group-type="author"><name><surname>Rihet</surname><given-names>P</given-names></name><name><surname>Traore</surname><given-names>Y</given-names></name><name><surname>Abel</surname><given-names>L</given-names></name><name><surname>Aucan</surname><given-names>C</given-names></name><name><surname>Traore-Leroux</surname><given-names>T</given-names></name><etal/></person-group><year>1998</year><article-title>Malaria in humans: <italic>Plasmodium falciparum</italic> blood infection levels are linked to chromosome 5q31-q33.</article-title><source>Am J Hum Genet</source><volume>63</volume><fpage>498</fpage><lpage>505</lpage><pub-id pub-id-type="pmid">9683598</pub-id></citation></ref><ref id="pone.0003887-Timmann1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Timmann</surname><given-names>C</given-names></name><name><surname>Evans</surname><given-names>JA</given-names></name><name><surname>K&#x000f6;nig</surname><given-names>IR</given-names></name><name><surname>Kleensang</surname><given-names>A</given-names></name><name><surname>R&#x000fc;schendorf</surname><given-names>F</given-names></name><etal/></person-group><year>2007</year><article-title>Genome-wide linkage analysis of malaria infection intensity and mild disease.</article-title><source>PLoS Genet</source><volume>3</volume><fpage>e48</fpage><pub-id pub-id-type="pmid">17381244</pub-id></citation></ref><ref id="pone.0003887-Casanova1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Casanova</surname><given-names>JL</given-names></name><name><surname>Abel</surname><given-names>L</given-names></name></person-group><year>2007</year><article-title>Human genetics of infectious diseases: a unified theory.</article-title><source>EMBO J</source><volume>26</volume><fpage>915</fpage><lpage>22</lpage><pub-id pub-id-type="pmid">17255931</pub-id></citation></ref><ref id="pone.0003887-Jepson1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jepson</surname><given-names>AP</given-names></name><name><surname>Banya</surname><given-names>WA</given-names></name><name><surname>Sisay-Joof</surname><given-names>F</given-names></name><name><surname>Hassan-King</surname><given-names>M</given-names></name><name><surname>Bennett</surname><given-names>S</given-names></name><etal/></person-group><year>1995</year><article-title>Genetic regulation of fever in <italic>Plasmodium falciparum</italic> malaria in Gambian twin children.</article-title><source>J Infect Dis</source><volume>172</volume><fpage>316</fpage><lpage>319</lpage><pub-id pub-id-type="pmid">7797941</pub-id></citation></ref><ref id="pone.0003887-Mackinnon1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mackinnon</surname><given-names>MJ</given-names></name><name><surname>Gunawardena</surname><given-names>DM</given-names></name><name><surname>Rajakaruna</surname><given-names>J</given-names></name><name><surname>Weerasingha</surname><given-names>S</given-names></name><name><surname>Mendis</surname><given-names>KN</given-names></name><etal/></person-group><year>2000</year><article-title>Quantifying genetic and nongenetic contributions to malarial infection in a Sri Lankan population.</article-title><source>Proc Natl Acad Sci U S A</source><volume>97</volume><fpage>12661</fpage><lpage>12666</lpage><pub-id pub-id-type="pmid">11035799</pub-id></citation></ref><ref id="pone.0003887-Mackinnon2"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mackinnon</surname><given-names>MJ</given-names></name><name><surname>Mwangi</surname><given-names>TW</given-names></name><name><surname>Snow</surname><given-names>RW</given-names></name><name><surname>Marsh</surname><given-names>K</given-names></name><name><surname>Williams</surname><given-names>TN</given-names></name></person-group><year>2005</year><article-title>Heritability of malaria in Africa.</article-title><source>PLoS Med</source><volume>2</volume><fpage>e340</fpage><pub-id pub-id-type="pmid">16259530</pub-id></citation></ref><ref id="pone.0003887-Phimpraphi1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Phimpraphi</surname><given-names>W</given-names></name><name><surname>Paul</surname><given-names>RE</given-names></name><name><surname>Yimsamran</surname><given-names>S</given-names></name><name><surname>Puangsa-Art</surname><given-names>S</given-names></name><name><surname>Thanyavanich</surname><given-names>N</given-names></name><etal/></person-group><year>2008</year><article-title>Longitudinal study of <italic>Plasmodium falciparum</italic> and <italic>Plasmodium vivax</italic> in a Karen population in Thailand.</article-title><source>Malar J</source><volume>7</volume><fpage>99</fpage><pub-id pub-id-type="pmid">18518964</pub-id></citation></ref><ref id="pone.0003887-Almasy1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Almasy</surname><given-names>L</given-names></name><name><surname>Blangero</surname><given-names>J</given-names></name></person-group><year>1998</year><article-title>Multipoint quantitative-trait linkage analysis in general pedigrees.</article-title><source>Am J Hum Genet</source><volume>62</volume><fpage>1198</fpage><lpage>1211</lpage><pub-id pub-id-type="pmid">9545414</pub-id></citation></ref><ref id="pone.0003887-Gilmour1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gilmour</surname><given-names>AR</given-names></name><name><surname>Gogel</surname><given-names>BJ</given-names></name><name><surname>Cullis</surname><given-names>BR</given-names></name><name><surname>Thompson</surname><given-names>R</given-names></name></person-group><year>2006</year><comment>ASReml Us