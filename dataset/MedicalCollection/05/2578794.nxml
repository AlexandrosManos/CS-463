"><person-group person-group-type="author"><name><surname>Strathdee</surname><given-names>SA</given-names></name><name><surname>Lozada</surname><given-names>R</given-names></name><name><surname>Semple</surname><given-names>SJ</given-names></name><name><surname>Orozovich</surname><given-names>P</given-names></name><name><surname>Pu</surname><given-names>M</given-names></name><name><surname>Staines-Orozco</surname><given-names>H</given-names></name><etal/></person-group><volume>35</volume><issue>3</issue><year>2008</year><fpage>263</fpage><lpage>268</lpage><article-title>Characteristics of female sex workers with US clients in two Mexico-US border cities</article-title><source>Sex Transm Dis</source><pub-id pub-id-type="pmid">18032996</pub-id></citation></ref><ref id="B15"><label>15</label><citation citation-type="book"><year>2003</year><publisher-loc>El Paso (TX)</publisher-loc><publisher-name>United States-Mexico Border Health Commission</publisher-name><source>Healthy border 2010: an agenda for improving health on the United States-Mexico Border</source></citation></ref><ref id="B16"><label>16</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Warner</surname><given-names>DC</given-names></name><name><surname>Jahnke</surname><given-names>LR</given-names></name></person-group><source>US/Mexico health issues: the Texas Rio Grande Valley</source><publisher-loc>San Antonio (TX)</publisher-loc><publisher-name>Regional Center for Health Workforce Studies, Center for Health Economics and Policy, The University of Texas Health Science Center at San Antonio</publisher-name><year>2003</year><access-date>Accessed January 12, 2008</access-date><comment><ext-link ext-link-type="uri" xlink:href="http://www.uthscsa.edu/RCHWS/Reports/NAFTA2.pdf16">http://www.uthscsa.edu/RCHWS/Reports/NAFTA2.pdf16</ext-link></comment></citation></ref><ref id="B17"><label>17</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Shuler</surname><given-names>J</given-names></name></person-group><source>United States-Mexico border philanthropy partnership and the digital divide</source><publisher-loc>New York (NY)</publisher-loc><publisher-name>Synergos</publisher-name><access-date>Accessed February 10, 2008</access-date><comment><ext-link ext-link-type="uri" xlink:href="http://www.synergos.org/05/digitaldivide.htm">http://www.synergos.org/05/digitaldivide.htm</ext-link></comment></citation></ref><ref id="B18"><label>18</label><citation citation-type="book"><source>Housing in the colonias</source><publisher-loc>Washington (DC)</publisher-loc><publisher-name>Housing Assistance Council</publisher-name><year>2005</year><access-date>Accessed November 30, 2007</access-date><comment><ext-link ext-link-type="uri" xlink:href="http://www.ruralhome.org/manager/uploads/colonias_infosheet.pdf">http://www.ruralhome.org/manager/uploads/colonias_infosheet.pdf</ext-link></comment></citation></ref><ref id="B19"><label>19</label><citation citation-type="book"><source>The County Information Project, Texas Association of Counties. Cameron County profile</source><publisher-loc>Austin (TX)</publisher-loc><publisher-name>Texas Association of Counties</publisher-name><access-date>Accessed February 4, 2008</access-date><comment><ext-link ext-link-type="uri" xlink:href="http://www.txcip.org/tac/census/profile.php?FIPS=48061">http://www.txcip.org/tac/census/profile.php?FIPS=48061</ext-link></comment></citation></ref><ref id="B20"><label>20</label><citation citation-type="book"><source>II conteo de poblaci&#x000f3;n y vivienda 2005: resultados definitivos, tabulados b&#x000e1;sicos. Tabla poblaci&#x000f3;n 2: poblaci&#x000f3;n total por municipio, edad desplegada y grupos quinquenales de edad seg&#x000fa;n sexo</source><publisher-loc>Aguascalientes (MX)</publisher-loc><publisher-name>Instituto Nacional de Estad&#x000ed;stica Geograf&#x000ed;a e Inform&#x000e1;tica</publisher-name><access-date>Accessed Februar