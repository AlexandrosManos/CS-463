"B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferrandez</surname><given-names>A</given-names></name><name><surname>Hawkins</surname><given-names>AC</given-names></name><name><surname>Summerfield</surname><given-names>DT</given-names></name><name><surname>Harwood</surname><given-names>CS</given-names></name></person-group><article-title>Cluster II che genes from <italic>Pseudomonas aeruginosa </italic>are required for an optimal chemotactic response</article-title><source>J Bacteriol</source><year>2002</year><volume>184</volume><fpage>4374</fpage><lpage>4383</lpage><pub-id pub-id-type="pmid">12142407</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Masduki</surname><given-names>A</given-names></name><name><surname>Nakamura</surname><given-names>J</given-names></name><name><surname>Ohga</surname><given-names>T</given-names></name><name><surname>Umezaki</surname><given-names>R</given-names></name><name><surname>Kato</surname><given-names>J</given-names></name><name><surname>Ohtake</surname><given-names>H</given-names></name></person-group><article-title>Isolation and characterization of chemotaxis mutants and genes of <italic>Pseudomonas aeruginosa</italic></article-title><source>J Bacteriol</source><year>1995</year><volume>177</volume><fpage>948</fpage><lpage>952</lpage><pub-id pub-id-type="pmid">7860605</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hickman</surname><given-names>JW</given-names></name><name><surname>Tifrea</surname><given-names>DF</given-names></name><name><surname>Harwood</surname><given-names>CS</given-names></name></person-group><article-title>A chemosensory system that regulates biofilm formation through modulation of cyclic diguanylate levels</article-title><source>Proc Natl Acad Sci USA</source><year>2005</year><volume>102</volume><fpag