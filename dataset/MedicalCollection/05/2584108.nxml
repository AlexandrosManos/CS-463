group person-group-type="author"><name><surname>Koshikawa</surname><given-names>N</given-names></name><name><surname>Moriyama</surname><given-names>K</given-names></name><name><surname>Takamura</surname><given-names>H</given-names></name><name><surname>Mizushima</surname><given-names>H</given-names></name><name><surname>Nagashima</surname><given-names>Y</given-names></name><name><surname>Yanoma</surname><given-names>S</given-names></name><name><surname>Miyazaki</surname><given-names>K</given-names></name></person-group><article-title>Overexpression of laminin 2 chain monomer in invading gastric carcinoma cells</article-title><source>Cancer Res</source><year>1999</year><volume>59</volume><fpage>5596</fpage><lpage>5601</lpage><pub-id pub-id-type="pmid">10554040</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Seftor</surname><given-names>RE</given-names></name><name><surname>Seftor</surname><given-names>EA</given-names></name><name><surname>Koshikawa</surname><given-names>N</given-names></name><name><surname>Meltzer</surname><given-names>PS</given-names></name><name><surname>Gardner</surname><given-names>LM</given-names></name><name><surname>Bilban</surname><given-names>M</given-names></name><name><surname>Stetler-Stevenson</surname><given-names>WG</given-names></name><name><surname>Quaranta</surname><given-names>V</given-names></name><name><surname>Hendrix</surname><given-names>MJ</given-names></name></person-group><article-title>Cooperative interactions of laminin 5 &#x000e3;2 chain, matrix metalloproteinase-2, and membrane type-1-matrix/metalloproteinase are required for mimicry of embryonic vasculogenesis by aggressive melanoma</article-title><source>Cancer Res</source><year>2001</year><volume>61</volume><fpage>6322</fpage><lpage>6327</lpage><pub-id pub-id-type="pmid">11522618</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="auth