source><year>2004</year><volume>164</volume><fpage>321</fpage><lpage>326</lpage><pub-id pub-id-type="pmid">14769629</pub-id><pub-id pub-id-type="doi">10.1001/archinte.164.3.321</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Edvardsson</surname><given-names>D</given-names></name><name><surname>Winblad</surname><given-names>B</given-names></name><name><surname>Sandman</surname><given-names>PO</given-names></name></person-group><article-title>Person-centred care of people with severe Alzheimer's disease: current status and ways forward</article-title><source>Lancet Neurol</source><year>2008</year><volume>7</volume><fpage>362</fpage><lpage>367</lpage><pub-id pub-id-type="pmid">18339351</pub-id><pub-id pub-id-type="doi">10.1016/S1474-4422(08)70063-2</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fabris</surname><given-names>F</given-names></name><name><surname>Molaschi</surname><given-names>M</given-names></name><name><surname>Aimonino</surname><given-names>N</given-names></name><name><surname>Ponzetto</surname><given-names>M</given-names></name><name><surname>Maero</surname><given-names>B</given-names></name><name><surname>Tibaldi</surname><given-names>V</given-names></name><name><surname>Nicola</surname><given-names>E</given-names></name><name><surname>Varetto</surname><given-names>O</given-names></name><name><surname>Barresi</surname><given-names>O</given-names></name><name><surname>Cavallero</surname><given-names>ML</given-names></name><name><surname>Boschis</surname><given-names>D</given-names></name><name><surname>Plastino</surname><given-names>V</given-names></name><name><surname>Vitale</surname><given-names>R</given-names></name></person-group><article-title>Home care for demented subjects: new models of care and home-care allowance</article-title><source>Arch Gerontol Geriatr Suppl</source><year>2004</y