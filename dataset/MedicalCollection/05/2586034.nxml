rname>Forrest</surname><given-names>MS</given-names></name><name><surname>Dimas</surname><given-names>A</given-names></name><name><surname>Bird</surname><given-names>CP</given-names></name><etal/></person-group><year>2007</year><article-title>Population genomics of human gene expression.</article-title><source>Nat Genet</source><volume>39</volume><fpage>1217</fpage><lpage>1224</lpage><pub-id pub-id-type="pmid">17873874</pub-id></citation></ref><ref id="pgen.1000294-Zhang1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zhang</surname><given-names>W</given-names></name><name><surname>Duan</surname><given-names>S</given-names></name><name><surname>Kistner</surname><given-names>EO</given-names></name><name><surname>Bleibel</surname><given-names>WK</given-names></name><name><surname>Huang</surname><given-names>RS</given-names></name><etal/></person-group><year>2008</year><article-title>Evaluation of genetic variation contributing to differences in gene expression between populations.</article-title><source>Am J Hum Genet</source><volume>82</volume><fpage>631</fpage><lpage>640</lpage><pub-id pub-id-type="pmid">18313023</pub-id></citation></ref><ref id="pgen.1000294-Akey1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Akey</surname><given-names>JM</given-names></name><name><surname>Biswas</surname><given-names>S</given-names></name><name><surname>Leek</surname><given-names>JT</given-names></name><name><surname>Storey</surname><given-names>JD</given-names></name></person-group><year>2007</year><article-title>On the design and analysis of gene expression studies in human populations.</article-title><source>Nat Genet</source><volume>39</volume><fpage>807</fpage><lpage>808</lpage><pub-id pub-id-type="pmid">17597765</pub-id></citation></ref><ref id="pgen.1000294-Spielman2"><label>12</label><citation citation-type="journal"><person-group person-group-type="au