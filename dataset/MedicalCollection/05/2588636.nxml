"><name><surname>Kazanjian</surname><given-names>A</given-names></name><name><surname>Pagliccia</surname><given-names>N</given-names></name></person-group><article-title>Key factors in physicians' choice of practice location: findings from a survey of practitioners and their spouses</article-title><source>Health Place</source><year>1996</year><volume>2</volume><fpage>27</fpage><lpage>34</lpage><pub-id pub-id-type="doi">10.1016/1353-8292(95)00039-9</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pong</surname><given-names>RW</given-names></name><name><surname>Chan</surname><given-names>B</given-names></name><name><surname>Crichton</surname><given-names>T</given-names></name><name><surname>Goertzen</surname><given-names>J</given-names></name><name><surname>McCready</surname><given-names>W</given-names></name><name><surname>Rourke</surname><given-names>J</given-names></name></person-group><article-title>Big cities and bright lights: rural/northern-trained physicians in urban practice</article-title><source>Can J Rural Med</source><year>2007</year><volume>12</volume><fpage>153</fpage><lpage>160</lpage><pub-id pub-id-type="pmid">17662175</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heng</surname><given-names>D</given-names></name><name><surname>Pong</surname><given-names>RW</given-names></name><name><surname>Chan</surname><given-names>BTB</given-names></name><name><surname>Degani</surname><given-names>N</given-names></name><name><surname>Crichton</surname><given-names>T</given-names></name><name><surname>Geoertzen</surname><given-names>J</given-names></name><name><surname>McCready</surname><given-names>W</given-names></name><name><surname>Rourke</surname><given-names>J</given-names></name></person-group><article-title>Graduates of northern Ontario family medicine residency programs practise where they train</ar