al"><person-group person-group-type="author"><name><surname>Kume</surname><given-names>T</given-names></name><name><surname>Kawamoto</surname><given-names>T</given-names></name><name><surname>Okura</surname><given-names>H</given-names></name><name><surname>Toyota</surname><given-names>E</given-names></name><name><surname>Neishi</surname><given-names>Y</given-names></name><name><surname>Watanabe</surname><given-names>N</given-names></name><name><surname>Hayashida</surname><given-names>A</given-names></name><name><surname>Okahashi</surname><given-names>N</given-names></name><name><surname>Yoshimura</surname><given-names>Y</given-names></name><name><surname>Saito</surname><given-names>K</given-names></name><name><surname>Nezuo</surname><given-names>S</given-names></name><name><surname>Yamada</surname><given-names>R</given-names></name><name><surname>Yoshida</surname><given-names>K</given-names></name></person-group><article-title>Local release of catecholamines from the hearts of patients with tako-tsubo-like left ventricular dysfunction</article-title><source>Circ J</source><year>2008</year><volume>72</volume><fpage>106</fpage><lpage>108</lpage><pub-id pub-id-type="pmid">18159109</pub-id><pub-id pub-id-type="doi">10.1253/circj.72.106</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wittstein</surname><given-names>IS</given-names></name><name><surname>Thiemann</surname><given-names>DR</given-names></name><name><surname>Lima</surname><given-names>JA</given-names></name><name><surname>Baughman</surname><given-names>KL</given-names></name><name><surname>Schulman</surname><given-names>SP</given-names></name><name><surname>Gerstenblith</surname><given-names>G</given-names></name><name><surname>Wu</surname><given-names>KC</given-names></name><name><surname>Rade</surname><given-names>JJ</given-names></name><name><surname>Bivalacqua</surname><given-names>TJ</given-names></name><name><surname>Champi