e>Pediatr</source><year>1997</year><volume>99</volume><fpage>289</fpage><lpage>299</lpage><pub-id pub-id-type="doi">10.1542/peds.99.2.289</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Klugman</surname><given-names>KP</given-names></name><name><surname>Madhi</surname><given-names>SA</given-names></name><name><surname>Huebner</surname><given-names>RE</given-names></name><name><surname>Kohberger</surname><given-names>R</given-names></name><name><surname>Mbelle</surname><given-names>N</given-names></name><name><surname>Pierce</surname><given-names>N</given-names></name><collab>Vaccine Trialists Group</collab></person-group><article-title>A trial of a 9-valent pneumococcal conjugate vaccine in children with and those without HIV infection</article-title><source>N Engl J Med</source><year>2003</year><volume>349</volume><fpage>1341</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">14523142</pub-id><pub-id pub-id-type="doi">10.1056/NEJMoa035060</pub-id></citation></ref></ref-list></back></article>