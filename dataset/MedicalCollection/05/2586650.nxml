ef id="pone.0003886-Vamosi1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vamosi</surname><given-names>J</given-names></name><name><surname>Knight</surname><given-names>T</given-names></name><name><surname>Steets</surname><given-names>J</given-names></name><name><surname>Mazer</surname><given-names>S</given-names></name><name><surname>Burd</surname><given-names>M</given-names></name><etal/></person-group><year>2006</year><article-title>Pollination decays in biodiversity hotspots.</article-title><source>Proc Nat Acad Sci USA</source><volume>103</volume><fpage>956</fpage><lpage>961</lpage><pub-id pub-id-type="pmid">16418284</pub-id></citation></ref><ref id="pone.0003886-Vamosi2"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vamosi</surname><given-names>JC</given-names></name><name><surname>Wilson</surname><given-names>JRU</given-names></name></person-group><year>2008</year><article-title>Nonrandom extinction leads to elevated loss of angiosperm evolutionary history.</article-title><source>Ecol Lett</source><volume>11</volume><fpage>1047</fpage><lpage>1053</lpage><pub-id pub-id-type="pmid">18616544</pub-id></citation></ref><ref id="pone.0003886-Pitman1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pitman</surname><given-names>NCA</given-names></name><name><surname>Jorgensen</surname><given-names>PM</given-names></name></person-group><year>2002</year><article-title>Estimating the size of the world's threatened flora.</article-title><source>Science</source><volume>298</volume><fpage>989</fpage><pub-id pub-id-type="pmid">12411696</pub-id></citation></ref><ref id="pone.0003886-Payne1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Payne</surname><given-names>JL</given-names></name><name><surname>Finnegan</surname><given-names>S</giv