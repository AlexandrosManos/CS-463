ft" rowspan="1" colspan="1">Ae</td><td align="left" rowspan="1" colspan="1">He</td><td align="left" rowspan="1" colspan="1">Ho</td></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">Dog</td><td align="left" rowspan="1" colspan="1">13</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">0.71</td><td align="left" rowspan="1" colspan="1">0.68<xref ref-type="table-fn" rid="nt102">a</xref></td><td align="left" rowspan="1" colspan="1">5</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">0.55</td><td align="left" rowspan="1" colspan="1">0.56</td><td align="left" rowspan="1" colspan="1">8</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">0.50</td><td align="left" rowspan="1" colspan="1">0.19<xref ref-type="table-fn" rid="nt102">a</xref></td><td align="left" rowspan="1" colspan="1">9.86</td><td align="left" rowspan="1" colspan="1">5.29</td><td align="left" rowspan="1" colspan="1">0.62</td><td align="left" rowspan="1" colspan="1">0.43<xref ref-type="table-fn" rid="nt102">a</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Human</td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">0.67</td><td align="left" rowspan="1" colspan="1">0.57<xref ref-type="table-fn" rid="nt102">a</xref></td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">0.55</td><td align="left" rowspan="1" colspan="1">0.53<xref ref-type="table-fn" rid="nt102">a</xref></td><td align="left" rowspan="1" colspan="1">7</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">0.52</td><td align="left" rowspan="1" colspan="1">0.19<xref ref-type="table-fn" rid="nt102">a</xref></td><td align="left" rowspan="1" colspan="1">8.00</td><td align="left" rowspan="1" colspan="1">4.00