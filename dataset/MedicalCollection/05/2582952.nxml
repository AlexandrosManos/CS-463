gn="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">0.48</td><td align="left" rowspan="1" colspan="1">0.28<xref ref-type="table-fn" rid="nt102">a</xref></td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">0.47</td><td align="left" rowspan="1" colspan="1">0<xref ref-type="table-fn" rid="nt102">a</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Rat</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">0.62</td><td align="left" rowspan="1" colspan="1">0.33<xref ref-type="table-fn" rid="nt102">a</xref></td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">0.75</td><td align="left" rowspan="1" colspan="1">0.83</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">0.32</td><td align="left" rowspan="1" colspan="1">0.06<xref ref-type="table-fn" rid="nt102">a</xref></td><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">0.79</td><td align="left" rowspan="1" colspan="1">0.09<xref ref-type="table-fn" rid="nt102">a</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Mean</td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">1.75</td><td align="left" rowspan="1" colspan="1">0.65</td><td align="left" rowspan="1" colspan="1">0.32<xref ref-type="table-fn" rid="nt102">a</xref></td><td align="left" rowspan="1" colspan="1">9.25</td><td align="left" rowspan="1" colspan="1">0.5</td><td align="left" rowspan="1" colspan="1">0.70</td><td align="left" rowspan="1" colspan="1">0.84</td><td align="left" rowspan="1" colspan="1">4</td><td align=