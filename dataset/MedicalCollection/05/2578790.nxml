17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barr</surname><given-names>SI</given-names></name></person-group><volume>94</volume><issue>3</issue><year>1994</year><fpage>260</fpage><lpage>266</lpage><page-range>260-6, 269</page-range><article-title>Associations of social and demographic variables with calcium intakes of high school students</article-title><source>J Am Diet Assoc</source><pub-id pub-id-type="pmid">8120289</pub-id></citation></ref><ref id="B18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Varela</surname><given-names>RE</given-names></name><name><surname>Vernberg</surname><given-names>EM</given-names></name><name><surname>Sanchez-Sosa</surname><given-names>JJ</given-names></name><name><surname>Riveros</surname><given-names>A</given-names></name><name><surname>Mitchell</surname><given-names>M</given-names></name><name><surname>Mashunkashey</surname><given-names>J</given-names></name></person-group><volume>18</volume><issue>4</issue><year>2004</year><fpage>651</fpage><lpage>657</lpage><article-title>Parenting style of Mexican, Mexican American, and Caucasian&#x02013;non-Hispanic families: social context and cultural influences</article-title><source>J Fam Psychol</source><pub-id pub-id-type="pmid">15598170</pub-id></citation></ref><ref id="B19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shakib</surname><given-names>S</given-names></name><name><surname>Mouttapa</surname><given-names>M</given-names></name><name><surname>Johnson</surname><given-names>CA</given-names></name><name><surname>Ritt-Olson</surname><given-names>A</given-names></name><name><surname>Trinidad</surname><given-names>DR</given-names></name><name><surname>Gallaher</surname><given-names>PE</given-names></name><etal/></person-group><volume>33</volume><issue>2</issue><year>2003</year><fpage>88</fpage><lpage>97</lpage><article-title>Ethnic variation in parenting characteristics and adolescent smoking</article-title><source>J Adolesc Health</source><pub-id pub-id-type="pmid">12890600</pub-id></citation></ref><ref id="B20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Julian</surname><given-names>TW</given-names></name><name><surname>McKenry</surname><given-names>PC</given-names></name><name><surname>McKelvey</surname><given-names>MW</given-names></name></person-group><year>1994</year><volume>43</volume><fpage>30</fpage><lpage>37</lpage><article-title>Cultural variations in parenting: perceptions of Caucasian, African-American, Hispanic, and Asian-American parents</article-title><source>Fam Relations</source></citation></ref><ref id="B21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cullen</surname><given-names>KW</given-names></name><name><surname>Baranowski</surname><given-names>T</given-names></name><name><surname>Owens</surname><given-names>E</given-names></name><name><surname>de</surname><given-names>MC</given-names></name><name><surname>Rittenberry</surname><given-names>L</given-names></name><name><surname>Olvera</surname><given-names>N</given-names></name><etal/></person-group><volume>17</volume><issue>1</issue><year>2002</year><fpage>7</fpage><lpage>18</lpage><article-title>Ethnic differences in social correlates of diet</article-title><source>Health Educ Res</source><pub-id pub-id-type="pmid">11888045</pub-id></citation></ref><ref id="B22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Novotny</surname><given-names>R</given-names></name><name><surname>Han</surname><given-names>J-S</given-names></name><name><surname>Biernacke</surname><given-names>I</given-names></name></person-group><year>1999</year><volume>31</volume><fpage>99</fpage><lpage>104</lpage><article-title>Motivators 