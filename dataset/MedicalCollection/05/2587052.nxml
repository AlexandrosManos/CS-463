<given-names>WC</given-names></name><name><surname>Weber</surname><given-names>T</given-names></name><name><surname>Chapman</surname><given-names>ER</given-names></name></person-group><article-title>Reconstitution of Ca2+-regulated membrane fusion by synaptotagmin and SNAREs</article-title><source>Science</source><volume>304</volume><fpage>435</fpage><lpage>438</lpage><year>2004</year><pub-id pub-id-type="pmid">15044754</pub-id></element-citation></ref><ref id="R33"><label>33</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Pobbati</surname><given-names>AV</given-names></name><name><surname>Stein</surname><given-names>A</given-names></name><name><surname>Fasshauer</surname><given-names>D</given-names></name></person-group><article-title>N- to C-terminal SNARE complex assembly promotes rapid membrane fusion</article-title><source>Science</source><volume>313</volume><fpage>673</fpage><lpage>676</lpage><year>2006</year><pub-id pub-id-type="pmid">16888141</pub-id></element-citation></ref><ref id="R34"><label>34</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Parlati</surname><given-names>F</given-names></name><etal/></person-group><article-title>Rapid and efficient fusion of phospholipid vesicles by the alpha-helical core of a SNARE complex in the absence of an N-terminal regulatory domain</article-title><source>Proc Natl Acad Sci U S A</source><volume>96</volume><fpage>12565</fpage><lpage>12570</lpage><year>1999</year><pub-id pub-id-type="pmid">10535962</pub-id></element-citation></ref><ref id="R35"><label>35</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Stein</surname><given-names>A</given-names></name><name><surname>Radhakrishnan</surname><given-names>A</given-names></name><name><surname>Riedel</surname><given-names>D</given-names></name><name><surname>Fasshauer</surname><given-names>D</gi