-type="journal"><person-group person-group-type="author"><name><surname>Beckett</surname><given-names>JR</given-names></name><name><surname>Kotre</surname><given-names>CJ</given-names></name><name><surname>Michaelson</surname><given-names>JS</given-names></name></person-group><article-title>Analysis of benefit:risk ratio and mortality reduction for the UK Breast Screening Programme</article-title><source>British Journal of Radiology</source><year>2003</year><volume>76</volume><fpage>309</fpage><lpage>320</lpage><pub-id pub-id-type="pmid">12763946</pub-id><pub-id pub-id-type="doi">10.1259/bjr/64009424</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Day</surname><given-names>N</given-names></name><name><surname>Warren</surname><given-names>R</given-names></name></person-group><article-title>Mammographic screening and mammographic patterns</article-title><source>Breast Cancer Res</source><year>2000</year><volume>2</volume><fpage>247</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">11250716</pub-id><pub-id pub-id-type="doi">10.1186/bcr64</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blanks</surname><given-names>RG</given-names></name><name><surname>Moss</surname><given-names>SM</given-names></name><name><surname>McGahan</surname><given-names>CE</given-names></name><name><surname>Quinn</surname><given-names>MJ</given-names></name><name><surname>Babb</surname><given-names>PJ</given-names></name></person-group><article-title>Effect of NHS breast screening programme on mortality from breast cancer in England and Wales, 1990&#x02013;8: comparison of observed with predicted mortality</article-title><source>BMJ</source><year>2000</year><volume>321</volume><fpage>665</fpage><lpage>669</lpage><pub-id pub-id-type="pmid">10987769</pub-id><pub-id pub-id-type="doi">10.1136/bmj.321.7262.665</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hackshaw</surname><given-names>A</given-names></name></person-group><article-title>EUSOMA review of mammography screening</article-title><source>Annals of Oncology</source><year>2003</year><volume>14</volume><fpage>1193</fpage><lpage>1195</lpage><pub-id pub-id-type="pmid">12881375</pub-id><pub-id pub-id-type="doi">10.1093/annonc/mdg321</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferlay</surname><given-names>J</given-names></name><name><surname>Autier</surname><given-names>P</given-names></name><name><surname>Boniol</surname><given-names>M</given-names></name><name><surname>Heanue</surname><given-names>M</given-names></name><name><surname>Colombet</surname><given-names>M</given-names></name><name><surname>Boyle</surname><given-names>P</given-names></name></person-group><article-title>Estimates of the cancer incidence and mortality in Europe in 2006</article-title><source>Annals of Oncology</source><year>2007</year><volume>18</volume><fpage>581</fpage><lpage>592</lpage><pub-id pub-id-type="pmid">17287242</pub-id><pub-id pub-id-type="doi">10.1093/annonc/mdl498</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Levi</surname><given-names>F</given-names></name><name><surname>Bosetti</surname><given-names>C</given-names></name><name><surname>Lueechini</surname><given-names>F</given-names></name><name><surname>Negri</surname><given-names>E</given-names></name><name><surname>La Vecchia</surname><given-names>C</given-names></name></person-group><article-title>Monitoring the decrease in breast cancer mortality in Europe</article-title><source>Eur J Cancer Prev</source><year>2005</year><volume>14</volume><fpage>497</fpage><lpage>502</lpage><pub-id pub-id-type="pmid">16284493</pub-id><pub-id pub-id-type="doi">10.1097/00008