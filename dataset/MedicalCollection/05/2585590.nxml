e>Saving Lives, Buying Time: Economics of Malaria Drugs in an Age of Resistance</source><year>2004</year><publisher-name>Washington, D.C.: The National Academies Press</publisher-name></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bloland</surname><given-names>PB</given-names></name><name><surname>Ettling</surname><given-names>M</given-names></name><name><surname>Meek</surname><given-names>S</given-names></name></person-group><article-title>Combination therapy for malaria in Africa: hype or hope?</article-title><source>Bull World Health Organ</source><year>2000</year><volume>78</volume><fpage>1378</fpage><lpage>1388</lpage><pub-id pub-id-type="pmid">11196485</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>White</surname><given-names>NJ</given-names></name><name><surname>Pongtavornpinyo</surname><given-names>W</given-names></name></person-group><article-title>The <italic>de novo </italic>selection of drug-resistant malaria parasites</article-title><source>Proc R Soc Lond B Biol Sci</source><year>2003</year><volume>270</volume><fpage>545</fpage><lpage>554</lpage><pub-id pub-id-type="doi">10.1098/rspb.2002.2241</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hastings</surname><given-names>IM</given-names></name></person-group><article-title>A model for the origins and spread of drug-resistant malaria</article-title><source>Parasitology</source><year>1997</year><volume>115</volume><fpage>133</fpage><lpage>141</lpage><pub-id pub-id-type="pmid">10190169</pub-id><pub-id pub-id-type="doi">10.1017/S0031182097001261</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dietz</surname><given-names>K</given-names></name><name><surname>Molineaux</surname><given-names>L</given-names></name><name><surname>Thomas</surname><given-names>A</given-names></name></person-group><article-title>A malaria model tested in the African savannah</article-title><source>Bull World Health Organ</source><year>1974</year><volume>50</volume><fpage>347</fpage><lpage>357</lpage><pub-id pub-id-type="pmid">4613512</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jeffery</surname><given-names>GM</given-names></name><name><surname>Eyles</surname><given-names>DE</given-names></name></person-group><article-title>Infectivity to mosquitoes of <italic>Plasmodium falciparum </italic>as related to gametocyte density and duration of infection</article-title><source>Am J Trop Med Hyg</source><year>1955</year><volume>4</volume><fpage>781</fpage><lpage>789</lpage><pub-id pub-id-type="pmid">13259002</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>White</surname><given-names>NJ</given-names></name></person-group><article-title>Assessment of the pharmacodynamic properties of antimalarial drugs <italic>in vivo</italic></article-title><source>Antimicrob Agents Chemother</source><year>1997</year><volume>41</volume><fpage>1413</fpage><lpage>1422</lpage><pub-id pub-id-type="pmid">9210658</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Baird</surname><given-names>JK</given-names></name></person-group><article-title>Age-dependent characteristics of protection v. susceptibility to <italic>Plasmodium falciparum</italic></article-title><source>Ann Trop Med Parasitol</source><year>1998</year><volume>92</volume><fpage>367</fpage><lpage>390</lpage><pub-id pub-id-type="pmid">9683890</pub-id><pub-id pub-id-type="doi">10.1080/00034989859366</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Beier</surname><given-names>JC</given-names></name><name><surname>Oster</surname><given-names>CN</given-names></name><name><surname>Onyango</surname><given-names>FK</given-names></name><name><surname>Bales</surname><given-names>JD</given-names></name><name><surname>Sherwood</surname><given-names>JA</given-names></name><name><surname>Perkins</surname><given-names>PV</given-names></name><name><surname>Chumo</surname><given-names>DK</given-names></name><name><surname>Koech</surname><given-names>DV</given-names></name><name><surname>Whitmire</surname><given-names>RE</given-names></name><name><surname>Roberts</surname><given-names>CR</given-names></name></person-group><article-title><italic>Plasmodium falciparum </italic>incidence relative to entomologic inoculation rates at a site proposed for testing malaria vaccines in western Kenya</article-title><source>Am J Trop Med Hyg</source><year>1994</year><volume>50</volume><fpage>529</fpage><lpage>536</lpage><pub-id pub-id-type="pmid">7911282</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Beadle</surname><given-names>C</given-names></name><name><surname>McElroy</surname><given-names>PD</given-names></name><name><surname>Oster</surname><given-names>CN</given-names></name><name><surname>Beier</surname><given-names>JC</given-names></name><name><surname>Oloo</surname><given-names>AJ</given-names></name><name><surname>Onyango</surname><given-names>FK</given-names></name><name><surname>Chumo</surname><given-names>DK</given-names></name><name><surname>Bales</surname><given-names>JD</given-names></name><name><surname>Sherwood</surname><given-names>JA</given-names></name><name><surname>Hoffman</surname><given-names>SL</given-names></name></person-group><article-title>Impact of transmission intensity and age on <italic>Plasmodium falciparum </italic>density and associated fever: implications for malaria vaccine trial design</article-title><sou