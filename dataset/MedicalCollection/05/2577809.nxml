me><surname>Arnold</surname><given-names>DL</given-names></name></person-group><article-title>Local magnetization transfer ratio signal inhomogeneity is related to subsequent change in MTR in lesions and normal-appearing white-matter of multiple sclerosis patients</article-title><source>Neuroimage</source><year>2005</year><volume>25</volume><fpage>1272</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">15850745</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clarke</surname><given-names>CJ</given-names></name><name><surname>Snook</surname><given-names>CF</given-names></name><name><surname>Tani</surname><given-names>M</given-names></name><name><surname>Matmati</surname><given-names>N</given-names></name><name><surname>Marchesini</surname><given-names>N</given-names></name><name><surname>Hannun</surname><given-names>YA</given-names></name></person-group><article-title>The extended family of neutral sphingomyelinases</article-title><source>Biochemistry</source><year>2006</year><volume>45</volume><fpage>11247</fpage><lpage>56</lpage><pub-id pub-id-type="pmid">16981685</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cudrici</surname><given-names>C</given-names></name><name><surname>Ito</surname><given-names>T</given-names></name><name><surname>Zafranskaia</surname><given-names>E</given-names></name><name><surname>Niculescu</surname><given-names>F</given-names></name><name><surname>Mullen</surname><given-names>KM</given-names></name><name><surname>Vlaicu</surname><given-names>S</given-names></name><etal/></person-group><article-title>Dendritic cells are abundant in non-lesional gray matter in multiple sclerosis</article-title><source>Exp Mol Pathol</source><year>2007</year><volume>83</volume><fpage>198</fpage><lpage>206</lpage><pub-id pub-id-type="pmid">17662270</pub-id></citation></ref><ref id="B13"><citation cit