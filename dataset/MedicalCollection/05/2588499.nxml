td></tr><tr><td rowspan="1" colspan="1">BV5.1&#x02013;BJ1.4</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">LERG</td><td rowspan="1" colspan="1">SNERLFFGHGTKLSVL</td></tr><tr><td rowspan="1" colspan="1">BV5.1&#x02013;BJ2.1</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">PGLG</td><td rowspan="1" colspan="1">YAEQFFGPGTRLTVL</td></tr><tr><td rowspan="1" colspan="1">BV5.1&#x02013;BJ2.4</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">LALGG</td><td rowspan="1" colspan="1">SQNTLYFGAGTRLSVL</td></tr><tr><td rowspan="1" colspan="1">BV5.1&#x02013;BJ2.7</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">LAGGG</td><td rowspan="1" colspan="1">YEQQFGPGTRLTVL</td></tr><tr><td rowspan="1" colspan="1">BV6&#x02013;BJ1.1</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">FGQGA</td><td rowspan="1" colspan="1">EVFFGKGTRLTVV</td></tr><tr><td rowspan="1" colspan="1">BV6&#x02013;BJ1.2</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">IRD</td><td rowspan="1" colspan="1">SDYTFGSGTRLLVI</td></tr><tr><td rowspan="1" colspan="1">BV6&#x02013;BJ2.1</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">IRD</td><td rowspan="1" colspan="1">NYAEQFFGPGTRLTVL</td></tr><tr><td rowspan="1" colspan="1">BV7&#x02013;BJ1.1</td><td rowspan="1" colspan="1">CASP</td><td rowspan="1" colspan="1">QVA</td><td rowspan="1" colspan="1">NTEVFFGKGTRLTVV</td></tr><tr><td rowspan="1" colspan="1">BV7&#x02013;BJ2.5</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">PGQG</td><td rowspan="1" colspan="1">DTQYFGPGTRLLVL</td></tr><tr><td rowspan="1" colspan="1">BV8.1&#x02013;BJ2.1</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">DQGD</td><td rowspan="1" colspan="1">YAEQFFGPGTRLTVL</td></tr><tr><td rowspan="1" colspan="1">BV8.1&#x02013;BJ2.5</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">GTG</td><td rowspan="1" colspan="1">QDTQYFGPGTRLLVL</td></tr><tr><td rowspan="1" colspan="1">BV8.2&#x02013;BJ1.5</td><td rowspan="1" colspan="1">CASG</td><td rowspan="1" colspan="1">VQGG</td><td rowspan="1" colspan="1">NQAPLFGEGTRLSVL</td></tr><tr><td rowspan="1" colspan="1">BV8.2&#x02013;BJ2.3</td><td rowspan="1" colspan="1">CASG</td><td rowspan="1" colspan="1">DLGG</td><td rowspan="1" colspan="1">SAETLYFGSGTRLTVL</td></tr><tr><td rowspan="1" colspan="1">BV8.3&#x02013;BJ1.1</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">DGTV</td><td rowspan="1" colspan="1">EVFFGKGTRLTVV</td></tr><tr><td rowspan="1" colspan="1">BV8.3&#x02013;BJ1.2</td><td rowspan="1" colspan="1">CASR</td><td rowspan="1" colspan="1">GPA</td><td rowspan="1" colspan="1">NSDYTFGSGTRLLVI</td></tr><tr><td rowspan="1" colspan="1">BV8.3&#x02013;BJ2.2</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">E</td><td rowspan="1" colspan="1">NTGQLYFGEGSKLTVL</td></tr><tr><td rowspan="1" colspan="1">BV8.3&#x02013;BJ2.4</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">DWGF</td><td rowspan="1" colspan="1">QNTLYFGAGTRLSVL</td></tr><tr><td rowspan="1" colspan="1">BV9&#x02013;BJ2.5</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">RDTGAR</td><td rowspan="1" colspan="1">DTQYFGPGTRLLVL</td></tr><tr><td rowspan="1" colspan="1">BV10&#x02013;BJ1.3</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">GRS</td><td rowspan="1" colspan="1">SGNTLYFGEGSRLIVV</td></tr><tr><td rowspan="1" colspan="1">BV10&#x02013;BJ2.2</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">LDWR</td><td rowspan="1" colspan="1">NTGQLYFGEGSKLTVL</td></tr><tr><td rowspan="1" colspan="1">BV11&#x02013;BJ1.1</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">LGNA</td><td rowspan="1" colspan="1">NTEVFFGKGTRLTVV</td></tr><tr><td rowspan="1" colspan="1">BV11&#x02013;BJ1.3</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">LGT</td><td rowspan="1" colspan="1">SGNTLYFGEGSRLIVV</td></tr><tr><td rowspan="1" colspan="1">BV11&#x02013;BJ2.3</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">PGTG</td><td rowspan="1" colspan="1">AETLYFGSGTRLTVL</td></tr><tr><td rowspan="1" colspan="1">BV11&#x02013;BJ2.4</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">LEPD</td><td rowspan="1" colspan="1">SQNTLYFGAGTRLSVL</td></tr><tr><td rowspan="1" colspan="1">BV12&#x02013;BJ1.2</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">S</td><td rowspan="1" colspan="1">NSDYTFGSGTRLLVI</td></tr><tr><td rowspan="1" colspan="1">BV12&#x02013;BJ1.3</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">DRA</td><td rowspan="1" colspan="1">GNTLYFGEGSRLIVV</td></tr><tr><td rowspan="1" colspan="1">BV12&#x02013;BJ1.5</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">WTG</td><td rowspan="1" colspan="1">NQAPLFGEGTRLSVL</td></tr><tr><td rowspan="1" colspan="1">BV12&#x02013;BJ2.4</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">LD</td><td rowspan="1" colspan="1">SQNTLYFGAGTRLSVL</td></tr><tr><td rowspan="1" colspan="1">BV12&#x02013;BJ2.5</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">LYE</td><td rowspan="1" colspan="1">DTQYFGPGTRLLVL</td></tr><tr><td rowspan="1" colspan="1">BV13&#x02013;BJ1.1</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">PRDR</td><td rowspan="1" colspan="1">NTEVFFGKGTRLTVV</td></tr><tr><td rowspan="1" colspan="1">BV13&#x02013;BJ1.4</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">LQGD</td><td rowspan="1" colspan="1">NERLFFGHGTKLSVL</td></tr><tr><td rowspan="1" colspan="1">BV13&#x02013;BJ2.5</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">LWGD</td><td rowspan="1" colspan="1">QDTQYFGPGTRLLVL</td></tr><tr><td rowspan="1" colspan="1">BV14&#x02013;BJ1.1</td><td rowspan="1" colspan="1">CAWS</td><td rowspan="1" colspan="1">PPGT</td><td rowspan="1" colspan="1">NTEVFFGKGTRLTVV</td></tr><tr><td rowspan="1" colspan="1">BV14&#x02013;BJ1.2</td><td rowspan="1" colspan="1">CAWS</td><td rowspan="1" colspan="1">LPGQGD</td><td rowspan="1" colspan="1">SDYTFGSGTRLLVI</td></tr><tr><td rowspan="1" colspan="1">BV15&#x02013;BJ2.1</td><td rowspan="1" colspan="1">CGAR</td><td rowspan="1" colspan="1">DRQ</td><td rowspan="1" colspan="1">NYAEQFFGPGTRLTVL</td></tr><tr><td rowspan="1" colspan="1">BV15&#x02013;BJ2.4</td><td rowspan="1" colspan="1">CGAR</td><td rowspan="1" colspan="1">GR</td><td rowspan="1" colspan="1">QNTLYFGAGTRLSVL</td></tr><tr><td rowspan="1" colspan="1">BV16&#x02013;BJ1.1</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">QANK</td><td rowspan="1" colspan="1">EVFFGKGTRLTVV</td></tr><tr><td rowspan="1" colspan="1">BV18&#x02013;BJ1.6</td><td rowspan="1" colspan="1">CSS</td><td rowspan="1" colspan="1">NNRG</td><td rowspan="1" colspan="1">YNSPLYFAAGTRLTVT</td></tr><tr><td rowspan="1" colspan="1">BV18&#x02013;BJ2.3</td><td rowspan="1" colspan="1">CS</td><td rowspan="1" colspan="1">PRDWGA</td><td rowspan="1" colspan="1">SAETLYFGSGTRLTVL</td></tr><tr><td rowspan="1" colspan="1">BV20&#x02013;BJ1.2</td><td rowspan="1" colspan="1">CSSS</td><td rowspan="1" colspan="1">WDRA</td><td rowspan="1" colspan="1">SDYTFGSGTRLLVI</td></tr></tbody></table></table-wrap><table-wrap id="T3" position="float"><label>Table 3.</label><caption><p>Amino acid sequences of &#x003b2; CDR3s that are overrepresented in HY-incompatible skin grafts at the time of rejection by a single recipient (HY1)</p></caption><table frame="hsides" rules="groups"><thead align="left"><tr><th rowspan="1" colspan="1">BV&#x02013;BJ pair</th><th colspan="3" rowspan="1">BV&#x02013;CDR3&#x02013;BJ sequence</th></tr></thead><tbody align="left"><tr><td rowspan="1" colspan="1">BV1&#x02013;BJ1.5</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">QEGGI</td><td rowspan="1" colspan="1">QAPLFGEGTRLSVL</td></tr><tr><td rowspan="1" colspan="1">BV1&#x02013;BJ2.4</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">QGGIN</td><td rowspan="1" colspan="1">QNTLYFGAGTRLSV</td></tr><tr><td rowspan="1" colspan="1">BV2&#x02013;BJ1.3</td><td rowspan="1" colspan="1">CSA</td><td rowspan="1" colspan="1">TEV</td><td rowspan="1" colspan="1">SGNTLYFGEGSRLIVV</td></tr><tr><td rowspan="1" colspan="1">BV2&#x02013;BJ1.4</td><td rowspan="1" colspan="1">CS</td><td rowspan="1" colspan="1">GNGQG</td><td rowspan="1" colspan="1">SNERLFFGHGTKLSVL</td></tr><tr><td rowspan="1" colspan="1">BV2&#x02013;BJ1.5</td><td rowspan="1" colspan="1">CSA</td><td rowspan="1" colspan="1">QG</td><td rowspan="1" colspan="1">NNQAPLFGEGTRLSVL</td></tr><tr><td rowspan="1" colspan="1">BV2&#x02013;BJ2.4</td><td rowspan="1" colspan="1">CRA</td><td rowspan="1" colspan="1">GRRG</td><td rowspan="1" colspan="1">SQNTLYFGAGTRLSVL</td></tr><tr><td rowspan="1" colspan="1">BV3&#x02013;BJ1.1</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">LSQ</td><td rowspan="1" colspan="1">NTEVFFGKGTRLTVV</td></tr><tr><td rowspan="1" colspan="1">BV3&#x02013;BJ2.2</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">RTD</td><td rowspan="1" colspan="1">TGQLYFGEGSKLTVL</td></tr><tr><td rowspan="1" colspan="1">BV3&#x02013;BJ2.7</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">LNRG</td><td rowspan="1" colspan="1">EQYFGPGTRLTVL</td></tr><tr><td rowspan="1" colspan="1">BV5.1&#x02013;BJ2.1</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">LNWGD</td><td rowspan="1" colspan="1">AEQFFGPGTRLTVL</td></tr><tr><td rowspan="1" colspan="1">BV5.1&#x02013;BJ2.2</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">LSGY</td><td rowspan="1" colspan="1">TGQLYFGEGSKLTVL</td></tr><tr><td rowspan="1" colspan="1">BV5.1&#x02013;BJ2.5</td><td rowspan="1" colspan="1">CASW</td><td rowspan="1" colspan="1">G</td><td rowspan="1" colspan="1">NQDTQYFGPGTRLLVL</td></tr><tr><td rowspan="1" colspan="1">BV5.2&#x02013;BJ1.5</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">PDS</td><td rowspan="1" colspan="1">NNQAPLFGEGTRLSVL</td></tr><tr><td rowspan="1" colspan="1">BV5.2&#x02013;BJ2.3</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">LGGA</td><td rowspan="1" colspan="1">SAETLYFGSGTRLTVL</td></tr><tr><td rowspan="1" colspan="1">BV5.2&#x02013;BJ2.5</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">RTV</td><td rowspan="1" colspan="1">NQDTQYFGPGTRLLVL</td></tr><tr><td rowspan="1" colspan="1">BV6&#x02013;BJ1.2</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">MGQEA</td><td rowspan="1" colspan="1">SDYTFGSGTRLLVI</td></tr><tr><td rowspan="1" colspan="1">BV6&#x02013;BJ2.1</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">RGS</td><td rowspan="1" colspan="1">YAEQFFGPGTRLTVL</td></tr><tr><td rowspan="1" colspan="1">BV6&#x02013;BJ2.2</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">LPGG</td><td rowspan="1" colspan="1">TGQLYFGEGSKLTVL</td></tr><tr><td rowspan="1" colspan="1">BV7&#x02013;BJ1.1</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">FSRS</td><td rowspan="1" colspan="1">NTEVFFGKGTRLTVV</td></tr><tr><td rowspan="1" colspan="1">BV7&#x02013;BJ2.7</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">WGWR</td><td rowspan="1" colspan="1">YEQYFGPGTRLTVL</td></tr><tr><td rowspan="1" colspan="1">BV8.1&#x02013;BJ2.2</td><td rowspan="1" colspan="1">CASS</td><td rowspan="1" colspan="1">DRSD</td><td rowspan="1" colspan="1">TGQLYFGEGSKLTVL</td></tr><tr><td rowspan="1" colspan="1">BV8.2&#x02013;BJ1.4</td><td rowspan="1" colspan="1">CASA</td><td rowspan="1" colspan="1">RDT</td><td rowspan="1" colspan="1">NERLFFGHGTKLSVL</td></tr><tr><td rowspan="1" colspan="1">BV8.2&#x02013;BJ2.3</td><td rowspan="1" colspan="1">CASG</td><td rowspan="1" colspan="1">GTT</td><td rowspan="1" colspan="1">SAETLYFGSGTRLTVL</td></tr><tr><td rowspan="1" colspan="1">BV8.3&#x02013;BJ1.2</td><td rowspan="1" col