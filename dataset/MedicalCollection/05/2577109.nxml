ge>899</lpage><pub-id pub-id-type="pmid">12071816</pub-id><pub-id pub-id-type="doi">10.1001/archderm.138.7.893</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guilianio</surname><given-names>A</given-names></name><name><surname>Lewis</surname><given-names/><suffix>Jr</suffix></name><name><surname>Hadley</surname><given-names>L</given-names></name><name><surname>Blaisdell</surname><given-names>FW</given-names></name></person-group><article-title>Bacteriology of necrotizing fasciitis</article-title><source>Am Surg</source><year>1977</year><volume>134</volume><fpage>52</fpage><lpage>57</lpage><pub-id pub-id-type="doi">10.1016/0002-9610(77)90283-5</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chelsom</surname><given-names>J</given-names></name><name><surname>Halstensen</surname><given-names>A</given-names></name><name><surname>Haga</surname><given-names>T</given-names></name><name><surname>Hoiby</surname><given-names>EA</given-names></name></person-group><article-title>Necrotizing fasciitis due to group A streptococci in western Norway. Incidence and clinical features</article-title><source>Lancet</source><year>1994</year><volume>344</volume><fpage>1111</fpage><lpage>15</lpage><pub-id pub-id-type="pmid">7934492</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(94)90629-7</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clark</surname><given-names>P</given-names></name><name><surname>Davidson</surname><given-names>D</given-names></name><name><surname>Letts</surname><given-names>M</given-names></name><name><surname>Lawton</surname><given-names>L</given-names></name><name><surname>Jawadi</surname><given-names>A</given-names></name></person-group><article-title>Necrotizing fasciitis secondary to chickenpox infection in children</article-title><source>Can J Surg</source><year>2003</year><volume>46</volume><fpage>9</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">12585787</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bisno</surname><given-names>AL</given-names></name><name><surname>Stevens</surname><given-names>DL</given-names></name></person-group><article-title>Streptococcal infections of skin and soft tissues</article-title><source>N Engl J Med</source><year>1996</year><volume>334</volume><fpage>240</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">8532002</pub-id><pub-id pub-id-type="doi">10.1056/NEJM199601253340407</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><collab>The Working Group on Severe Streptococcal Infections</collab></person-group><article-title>Defining the group A streptococcal toxic shock syndrome</article-title><source>J Am Med Assoc</source><year>1993</year><volume>269</volume><fpage>390</fpage><lpage>391</lpage><pub-id pub-id-type="doi">10.1001/jama.269.3.390</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Murphy</surname><given-names>JJ</given-names></name><name><surname>Granger</surname><given-names>R</given-names></name><name><surname>Blair</surname><given-names>GK</given-names></name><name><surname>Miller</surname><given-names>GG</given-names></name><name><surname>Fraser</surname><given-names>GC</given-names></name><name><surname>Magee</surname><given-names>JF</given-names></name></person-group><article-title>Necrotizing fasciitis in childhood</article-title><source>J Pediatr Surg</source><year>1995</year><volume>30</volume><fpage>1131</fpage><lpage>1134</lpage><pub-id pub-id-type="pmid">7472965</pub-id><pub-id pub-id-type="doi">10.1016/0022-3468(95)90004-7</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Levine</surname><given-names>EG</given-names></name><name><surname>Manders</surname><given-names>SM</given-names></name></person-group><article-title>Life-threatening necrotizing fasciitis</article-title><source>Clin Dermatol</source><year>2005</year><volume>23</volume><fpage>144</fpage><lpage>147</lpage><pub-id pub-id-type="pmid">15802207</pub-id><pub-id pub-id-type="doi">10.1016/j.clindermatol.2004.06.014</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rahmouni</surname><given-names>A</given-names></name><name><surname>Chosidow</surname><given-names>O</given-names></name><name><surname>Mathieu</surname><given-names>D</given-names></name><name><surname>Gueorguiev</surname><given-names>AE</given-names></name><name><surname>Jazaerli</surname><given-names>N</given-names></name><name><surname>Radier</surname><given-names>C</given-names></name><name><surname>Faivre</surname><given-names>JM</given-names></name><name><surname>Roujeau</surname><given-names>JC</given-names></name><name><surname>Vasile</surname><given-names>N</given-names></name></person-group><article-title>MR imaging in acute infectious cellulitis</article-title><source>Radiology</source><year>1994</year><volume>192</volume><fpage>493</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">8029421</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Seal</surname><given-names>DV</given-names></name></person-group><article-title>Necrotizing fasciitis</article-title><source>Curr Opin Infect Dis</source><year>2001</year><volume>14</volume><fpage>127</fpage><lpage>32</lpage><pub-id pub-id-type="pmid">11979121</pub-id><pub-id pub-id-type="doi">10.1097/00001432-200104000-00003</pub-id></citation></ref></ref-list></back></article>