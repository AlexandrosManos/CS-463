ce>Journal of Adolescent Health</source><year>2007</year><volume>40</volume><fpage>466</fpage><lpage>469</lpage><pub-id pub-id-type="pmid">17448408</pub-id><pub-id pub-id-type="doi">10.1016/j.jadohealth.2007.01.005</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dinh</surname><given-names>TA</given-names></name><name><surname>Rosenthal</surname><given-names>SL</given-names></name><name><surname>Doan</surname><given-names>ED</given-names></name><name><surname>Trang</surname><given-names>T</given-names></name><name><surname>Pham</surname><given-names>VH</given-names></name><name><surname>Tran</surname><given-names>BD</given-names></name><name><surname>Tran</surname><given-names>VD</given-names></name><name><surname>Bao Phan</surname><given-names>GA</given-names></name><name><surname>Chu</surname><given-names>HKH</given-names></name><name><surname>Breitkopf</surname><given-names>CR</given-names></name></person-group><article-title>Attitudes of Mothers in Da Nang, Vietnam toward a Human Papillomavirus Vaccine</article-title><source>Journal of Adolescent Health</source><year>2007</year><volume>10</volume><fpage>1016</fpage></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Olshen</surname><given-names>E</given-names></name><name><surname>Woods</surname><given-names>ER</given-names></name><name><surname>Austin</surname><given-names>SB</given-names></name><name><surname>Luskin</surname><given-names>M</given-names></name><name><surname>Bauchner</surname><given-names>H</given-names></name></person-group><article-title>Parental acceptance of the human papillomavirus vaccine</article-title><source>Journal of Adolescent Health</source><year>2005</year><volume>36</volume><fpage>124</fpage><pub-id pub-id-type="doi">10.1016/j.jadohealth.2004.11.062</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-grou