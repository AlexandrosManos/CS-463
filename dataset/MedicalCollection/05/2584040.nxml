><fpage>S5</fpage><lpage>12</lpage><pub-id pub-id-type="pmid">15563741</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gimbel</surname><given-names>J</given-names></name><name><surname>Linn</surname><given-names>R</given-names></name><name><surname>Hale</surname><given-names>M</given-names></name><name><surname>Nicholson</surname><given-names>B</given-names></name></person-group><article-title>Lidocaine patch treatment in patients with low back pain: results of an open-label, nonrandomized pilot study</article-title><source>Am J Ther</source><year>2005</year><volume>12</volume><fpage>311</fpage><lpage>319</lpage><pub-id pub-id-type="pmid">16041194</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Galer</surname><given-names>BS</given-names></name><name><surname>Sheldon</surname><given-names>E</given-names></name><name><surname>Patel</surname><given-names>N</given-names></name><name><surname>Codding</surname><given-names>C</given-names></name><name><surname>Burch</surname><given-names>F</given-names></name><name><surname>Gammaitoni</surname><given-names>AR</given-names></name></person-group><article-title>Topical lidocaine patch 5% may target a novel underlying pain mechanism in osteoarthritis</article-title><source>Curr Med Res Opin</source><year>2004</year><volume>20</volume><fpage>1455</fpage><lpage>1458</lpage><pub-id pub-id-type="pmid">15383194</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gammaitoni</surname><given-names>AR</given-names></name><name><surname>Galer</surname><given-names>BS</given-names></name><name><surname>Onawola</surname><given-names>R</given-names></name><name><surname>Jensen</surname><given-names>MP</given-names></name><name><surname>Argoff</surname><given-names>CE</given-names></name></person-group><article-title>Lidocaine patch 5% and its positive impact on pain qualities in osteoarthritis: results of a pilot 2-week, open-label study using the Neuropathic Pain Scale</article-title><source>Curr Med Res Opin</source><year>2004</year><volume>20</volume><fpage>S13</fpage><lpage>S19</lpage><pub-id pub-id-type="pmid">15563742</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Davies</surname><given-names>PS</given-names></name><name><surname>Galer</surname><given-names>BS</given-names></name></person-group><article-title>Review of lidocaine patch 5% studies in the treatment of postherpetic neuralgia</article-title><source>Drugs</source><year>2004</year><volume>64</volume><fpage>937</fpage><lpage>947</lpage><pub-id pub-id-type="pmid">15101784</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Geha</surname><given-names>PY</given-names></name><name><surname>Baliki</surname><given-names>MN</given-names></name><name><surname>Chialvo</surname><given-names>DR</given-names></name><name><surname>Harden</surname><given-names>RN</given-names></name><name><surname>Paice</surname><given-names>JA</given-names></name><name><surname>Apkarian</surname><given-names>AV</given-names></name></person-group><article-title>Brain activity for spontaneous pain of postherpetic neuralgia and its modulation by lidocaine patch therapy</article-title><source>Pain</source><year>2007</year><volume>128</volume><fpage>88</fpage><lpage>100</lpage><pub-id pub-id-type="pmid">17067740</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Geha</surname><given-names>PY</given-names></name><name><surname>Baliki</surname><given-names>MN</given-names></name><name><surname>Wang</surname><given-names>X</given-names></name><name><surname>Harden</surname><given-names>RN</given-names></n