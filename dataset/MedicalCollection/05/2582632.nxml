lpage><pub-id pub-id-type="pmid">18089548</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Takeda</surname><given-names>J</given-names></name><name><surname>Suzuki</surname><given-names>Y</given-names></name><name><surname>Nakao</surname><given-names>M</given-names></name><name><surname>Barrero</surname><given-names>RA</given-names></name><name><surname>Koyanagi</surname><given-names>KO</given-names></name><name><surname>Jin</surname><given-names>L</given-names></name><name><surname>Motono</surname><given-names>C</given-names></name><name><surname>Hata</surname><given-names>H</given-names></name><name><surname>Isogai</surname><given-names>T</given-names></name><name><surname>Nagai</surname><given-names>K</given-names></name><etal/></person-group><article-title>Large-scale identification and characterization of alternative splicing variants of human gene transcripts using 56,419 completely sequenced and manually annotated full-length cDNAs</article-title><source>Nucleic Acids Res.</source><year>2006</year><volume>34</volume><fpage>3917</fpage><lpage>3928</lpage><pub-id pub-id-type="pmid">16914452</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kimura</surname><given-names>K</given-names></name><name><surname>Wakamatsu</surname><given-names>A</given-names></name><name><surname>Suzuki</surname><given-names>Y</given-names></name><name><surname>Ota</surname><given-names>T</given-names></name><name><surname>Nishikawa</surname><given-names>T</given-names></name><name><surname>Yamashita</surname><given-names>R</given-names></name><name><surname>Yamamoto</surname><given-names>J</given-names></name><name><surname>Sekine</surname><given-names>M</given-names></name><name><surname>Tsuritani</surname><given-names>K</given-names></name><name><surname>Wakag