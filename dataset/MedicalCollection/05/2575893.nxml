id></citation></ref><ref id="DSN017C6"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giraud</surname><given-names>E.</given-names></name><name><surname>Moulin</surname><given-names>L.</given-names></name><name><surname>Vallenet</surname><given-names>D.</given-names></name><name><surname>Barbe</surname><given-names>V.,</given-names></name><etal/></person-group><article-title>Legumes symbioses: absence of Nod genes in photosynthetic bradyrhizobia</article-title><source>Science</source><year>2007</year><volume>316</volume><fpage>1307</fpage><lpage>1312</lpage><pub-id pub-id-type="pmid">17540897</pub-id></citation></ref><ref id="DSN017C7"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berg&#x000e8;s</surname><given-names>H.</given-names></name><name><surname>Lauber</surname><given-names>E.</given-names></name><name><surname>Liebe</surname><given-names>C.,</given-names></name><etal/></person-group><article-title>Development of <italic>Sinorhizobium meliloti</italic> pilot macroarrays for transcriptome analysis</article-title><source>Appl. Environ. Microbiol.</source><year>2003</year><volume>69</volume><fpage>1214</fpage><lpage>1219</lpage><pub-id pub-id-type="pmid">12571049</pub-id></citation></ref><ref id="DSN017C8"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Djordjevic</surname><given-names>M. A.</given-names></name><name><surname>Chen</surname><given-names>H. C.</given-names></name><name><surname>Natera</surname><given-names>S.,</given-names></name><etal/></person-group><article-title>A global analysis of protein expression profiles in <italic>Sinorhizobium meliloti</italic>: discovery of new genes for nodule occupancy and stress adaptation</article-title><source>Mol. Plant Microbe. Interact.</source><year>2003</year><volume>16</volume><fpage>508</fpage><lpage>524</lpage><pub-id pub-id-type="pmid">12795377</pub-id></citation></ref><ref id="DSN017C9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barnett</surname><given-names>M. J.</given-names></name><name><surname>Toman</surname><given-names>C. J.</given-names></name><name><surname>Fisher</surname><given-names>R. F.</given-names></name><name><surname>Long</surname><given-names>S. R</given-names></name></person-group><article-title>A dual-genome Symbiosis Chip for coordinate study of signal exchange and development in a prokaryote&#x02013;host interaction</article-title><source>Proc. Natl. Acad. Sci. USA</source><year>2004</year><volume>101</volume><fpage>16636</fpage><lpage>16641</lpage><pub-id pub-id-type="pmid">15542588</pub-id></citation></ref><ref id="DSN017C10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hoa</surname><given-names>L. T. P.</given-names></name><name><surname>Nomura</surname><given-names>M.</given-names></name><name><surname>Tajima</surname><given-names>S</given-names></name></person-group><article-title>Characterization of bacteroid proteins in soybean nodules formed with <italic>Bradyrhizobium japonicum</italic> USDA110</article-title><source>Microbiol. Environ.</source><year>2004</year><volume>19</volume><fpage>71</fpage><lpage>75</lpage></citation></ref><ref id="DSN017C11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Uchiumi</surname><given-names>T.</given-names></name><name><surname>Ohwada</surname><given-names>T.</given-names></name><name><surname>Itakura</surname><given-names>M.,</given-names></name><etal/></person-group><article-title>Expression islands clustered on symbiosis island of <italic>Mesorhizobium loti</italic> genome</article-title><source>J. Bacteriol.</source><year>2004</year><volume>45</volume><fpage>2439</fpage><lpage>2448</lpage><pub-id pub-id-type="pmid">15060047</pub-id></citation></ref><ref id="DSN017C12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sarma</surname><given-names>A. D.</given-names></name><name><surname>Emerich</surname><given-names>D. W</given-names></name></person-group><article-title>Global protein expression pattern of <italic>Bradyrhizobium japonicum</italic> bacteroids: a prelude to functional proteomics</article-title><source>Proteomics</source><year>2005</year><volume>5</volume><fpage>4170</fpage><lpage>4184</lpage><pub-id pub-id-type="pmid">16254929</pub-id></citation></ref><ref id="DSN017C13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shimoda</surname><given-names>Y.</given-names></name><name><surname>Shinpo</surname><given-names>S.</given-names></name><name><surname>Kohara</surname><given-names>M.</given-names></name><name><surname>Nakamura</surname><given-names>Y.</given-names></name><name><surname>Tabata</surname><given-names>S.</given-names></name><name><surname>Sato</surname><given-names>S</given-names></name></person-group><article-title>A large scale analysis of protein&#x02013;protein interactions in the nitrogen-fixing bacterium <italic>Mesorhizobium loti</italic></article-title><source>DNA Res.</source><year>2008</year><volume>15</volume><fpage>13</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">18192278</pub-id></citation></ref><ref id="DSN017C14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hutchison</surname><given-names>C. A.</given-names></name><name><surname>Peterson</surname><given-names>S. N.</given-names></name><name><surname>Gill</surname><given-names>S. R.,</given-names></name><etal/></person-group><article-title>Global transposon mutagenesis and a minimal mycoplasma genome</article-title><source>Science</source><year>1999</year><volume>286</volume><fpage>2165</fpage><lpage>2169</lpage><pub-id pub-id-type