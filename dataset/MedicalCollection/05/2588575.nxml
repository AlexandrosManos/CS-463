><surname>May</surname><given-names>A</given-names></name><name><surname>Limmroth</surname><given-names>V</given-names></name><name><surname>J&#x000fc;ptner</surname><given-names>M</given-names></name><name><surname>Kaube</surname><given-names>H</given-names></name><name><surname>Schayck</surname><given-names>RV</given-names></name><name><surname>Coenen</surname><given-names>HH</given-names></name><name><surname>Diener</surname><given-names>HC</given-names></name></person-group><article-title>Brain stem activation in spontaneous human migraine attacks</article-title><source>Nature Med</source><year>1995</year><volume>1</volume><fpage>658</fpage><lpage>660</lpage><pub-id pub-id-type="pmid">7585147</pub-id><pub-id pub-id-type="doi">10.1038/nm0795-658</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Veloso</surname><given-names>F</given-names></name><name><surname>Kumar</surname><given-names>K</given-names></name><name><surname>Toth</surname><given-names>C</given-names></name></person-group><article-title>Headache secondary to deep brain stimulation</article-title><source>Headache</source><year>1998</year><volume>38</volume><fpage>507</fpage><lpage>515</lpage><pub-id pub-id-type="pmid">15613166</pub-id><pub-id pub-id-type="doi">10.1046/j.1526-4610.1998.3807507.x</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Welch</surname><given-names>KM</given-names></name><name><surname>Nagesh</surname><given-names>V</given-names></name><name><surname>Aurora</surname><given-names>SK</given-names></name><name><surname>Gelman</surname><given-names>N</given-names></name></person-group><article-title>Periaqueductal gray matter dysfunction in migraine: cause or the burden of illness?</article-title><source>Headache</source><year>2001</year><volume>41</volume><fpage>629</fpage><lpage>637</lpage><pub-id pub-id-type="pmid">11554950