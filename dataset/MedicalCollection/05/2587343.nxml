="3" align="left" rowspan="1"># deleterious for Sen accuracy within &#x000b1;</th><th align="left" rowspan="1" colspan="1"/><th align="left" rowspan="1" colspan="1"/><th align="left" rowspan="1" colspan="1">N</th><th colspan="3" align="left" rowspan="1"># neutrals for Spec accuracy within &#x000b1;</th></tr><tr><th colspan="18" align="left" rowspan="1"><hr/></th></tr><tr><th align="left" rowspan="1" colspan="1"/><th align="left" rowspan="1" colspan="1">NTP</th><th align="left" rowspan="1" colspan="1">NFN</th><th align="left" rowspan="1" colspan="1">NTN</th><th align="left" rowspan="1" colspan="1">NFP</th><th align="left" rowspan="1" colspan="1">Coverage [%]</th><th align="left" rowspan="1" colspan="1">Sen [%]</th><th align="left" rowspan="1" colspan="1">Sen 95% CI*</th><th align="left" rowspan="1" colspan="1">(deleterious)</th><th align="left" rowspan="1" colspan="1">5%</th><th align="left" rowspan="1" colspan="1">10%</th><th align="left" rowspan="1" colspan="1">20%</th><th align="left" rowspan="1" colspan="1">Spec [%]</th><th align="left" rowspan="1" colspan="1">Spec 95% CI*</th><th align="left" rowspan="1" colspan="1">(neu tral)</th><th align="left" rowspan="1" colspan="1">5%</th><th align="left" rowspan="1" colspan="1">10%</th><th align="left" rowspan="1" colspan="1">20%</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">PLR</td><td align="left" rowspan="1" colspan="1">5</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">13</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">77</td><td align="left" rowspan="1" colspan="1">100</td><td align="left" rowspan="1" colspan="1">(0.4782,1.000)</td><td align="left" rowspan="1" colspan="1">5</td><td align="left" rowspan="1" colspan="1">72</td><td align="left" rowspan="1" colspan="1">36</td><td align="left" rowspan="1" colspan="1">17</td><td align="left" rowspan="1" colspan="1">87</td><td align="left" rowspan="1" colspan="1">(0