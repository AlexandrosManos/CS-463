age>15624</lpage><pub-id pub-id-type="pmid">16595686</pub-id></citation></ref><ref id="bib19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kohalmi</surname><given-names>SE</given-names></name><name><surname>Reader</surname><given-names>LJV</given-names></name><name><surname>Samach</surname><given-names>A</given-names></name><name><surname>Nowak</surname><given-names>J</given-names></name><name><surname>Haughn</surname><given-names>GW</given-names></name><name><surname>Crosby</surname><given-names>WL</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Gelvin</surname><given-names>SB</given-names></name><name><surname>Schilperoort</surname><given-names>RA</given-names></name></person-group><article-title>Identification and characterization of protein interactions using the yeast 2-hybrid system</article-title><source>Plant molecular biology manual</source><year>1998</year><publisher-loc>Dordrecht</publisher-loc><publisher-name>Kluwer Academic Publishers, M1/1&#x02013;30</publisher-name><fpage>1</fpage><lpage>30</lpage></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koyama</surname><given-names>T</given-names></name><name><surname>Okada</surname><given-names>T</given-names></name><name><surname>Kitajima</surname><given-names>S</given-names></name><name><surname>Ohme-Takagi</surname><given-names>M</given-names></name><name><surname>Shinshi</surname><given-names>H</given-names></name><name><surname>Sato</surname><given-names>F</given-names></name></person-group><article-title>Isolation of tobacco ubiquitin-conjugating enzyme cDNA in a yeast two-hybrid system with tobacco ERF3 as bait and its characterization of specific interaction</article-title><source>Journal of Experimental Botany</source><year>2003</year><volume>54</volume><fpage>1175</fpage><lpage>1181</lpage><pub-id pub-id-type="pmid">12654868</pub-id></citatio