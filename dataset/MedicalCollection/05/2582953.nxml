robe visibility.</article-title><source>Journal of Fluorescence</source><volume>13</volume><fpage>513</fpage><lpage>517</lpage></citation></ref><ref id="pone.0003780-Kaestner1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaestner</surname><given-names>L</given-names></name><name><surname>Tabellion</surname><given-names>W</given-names></name><name><surname>Weiss</surname><given-names>E</given-names></name><name><surname>Bernhardt</surname><given-names>I</given-names></name><name><surname>Lipp</surname><given-names>P</given-names></name></person-group><year>2006</year><article-title>Calcium imaging of individual erythrocytes: problems and approaches.</article-title><source>Cell Calcium</source><volume>39</volume><fpage>13</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">16242187</pub-id></citation></ref><ref id="pone.0003780-Lew3"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lew</surname><given-names>VL</given-names></name><name><surname>Etzion</surname><given-names>Z</given-names></name><name><surname>Bookchin</surname><given-names>RM</given-names></name><name><surname>Dacosta</surname><given-names>R</given-names></name><name><surname>Vaananen</surname><given-names>H</given-names></name><etal/></person-group><year>1993</year><article-title>The Distribution of Intracellular Calcium Chelator (Fura-2) in a Population of Intact Human Red-Cells.</article-title><source>Biochimica Et Biophysica Acta</source><volume>1148</volume><fpage>152</fpage><lpage>156</lpage><pub-id pub-id-type="pmid">8499463</pub-id></citation></ref><ref id="pone.0003780-Clayton1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clayton</surname><given-names>AH</given-names></name><name><surname>Hanley</surname><given-names>QS</given-names></name><name><surname>Verveer</surname><given-names>PJ</given-names></name></pers