lic>Molecular and Cellular Biology</italic></source><year>2008</year><volume>28</volume><issue>14</issue><fpage>4598</fpage><lpage>4608</lpage><pub-id pub-id-type="pmid">18474620</pub-id></element-citation></ref><ref id="B253"><label>253</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mart&#x000ed;nez-Iglesias</surname><given-names>O</given-names></name><name><surname>Garc&#x000ed;a-Silva</surname><given-names>S</given-names></name><name><surname>Regadera</surname><given-names>J</given-names></name><name><surname>Aranda</surname><given-names>A</given-names></name></person-group><article-title>Hypothyroidism enhances tumor invasiveness and metastasis development</article-title><source><italic>PLoS ONE</italic></source><year>2009</year><volume>4</volume><issue>7</issue><comment>Article ID e6428.</comment></element-citation></ref><ref id="B254"><label>254</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Zhu</surname><given-names>XG</given-names></name><name><surname>Zhao</surname><given-names>L</given-names></name><name><surname>Willingham</surname><given-names>MC</given-names></name><name><surname>Cheng</surname><given-names>SY</given-names></name></person-group><article-title>Thyroid hormone receptors are tumor suppressors in a mouse model of metastatic follicular thyroid carcinoma</article-title><source><italic>Oncogene</italic></source><year>2010</year><volume>29</volume><issue>13</issue><fpage>1909</fpage><lpage>1919</lpage><pub-id pub-id-type="pmid">20062085</pub-id></element-citation></ref><ref id="B255"><label>255</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>H&#x000f6;rkk&#x000f6;</surname><given-names>TT</given-names></name><name><surname>Tuppurainen</surname><given-names>K</given-names></name><name><surname>George</surname><given-names>SM</given-names></name><name><surname>Jernval