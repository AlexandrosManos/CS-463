n-names></name><name><surname>Andrade</surname><given-names>AL</given-names></name></person-group><article-title>Household survey of dengue infection in central Brazil: spatial point pattern analysis and risk factors assessment</article-title><source>Am J Trop Med Hyg</source><year>2004</year><volume>71</volume><fpage>646</fpage><lpage>651</lpage><pub-id pub-id-type="pmid">15569799</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guzman</surname><given-names>MG</given-names></name><name><surname>Kouri</surname><given-names>G</given-names></name><name><surname>Valdes</surname><given-names>L</given-names></name><name><surname>Bravo</surname><given-names>J</given-names></name><name><surname>Alvarez</surname><given-names>M</given-names></name><name><surname>Vazques</surname><given-names>S</given-names></name><name><surname>Delgado</surname><given-names>I</given-names></name><name><surname>Halstead</surname><given-names>SB</given-names></name></person-group><article-title>Epidemiologic studies on Dengue in Santiago de Cuba, 1997</article-title><source>Am J Epidemiol</source><year>2000</year><volume>152</volume><fpage>793</fpage><lpage>799</lpage><pub-id pub-id-type="pmid">11085389</pub-id><pub-id pub-id-type="doi">10.1093/aje/152.9.793</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rosa-Freitas</surname><given-names>MG</given-names></name><name><surname>Tsouris</surname><given-names>P</given-names></name><name><surname>Sibajev</surname><given-names>A</given-names></name><name><surname>Weimann</surname><given-names>ETS</given-names></name><name><surname>Marques</surname><given-names>AU</given-names></name><name><surname>Ferreira</surname><given-names>RL</given-names></name><name><surname>Luitgards-Moura</surname><given-names>JF</given-names></name></person-group><article-title>Exploratory temporal and spatial distribution analysis of dengue notifications in Boa Vista, Roraima, Brazilian Amazon, 1999&#x02013;2001</article-title><source>Dengue Bulletin</source><year>2003</year><volume>27</volume><fpage>63</fpage><lpage>79</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>de Mattos Almeida</surname><given-names>MC</given-names></name><name><surname>Caiaffa</surname><given-names>WT</given-names></name><name><surname>Assuncao</surname><given-names>RM</given-names></name><name><surname>Proietti</surname><given-names>FA</given-names></name></person-group><article-title>Spatial vulnerability to dengue in a Brazilian urban area during a 7-year surveillance</article-title><source>J Urban Health</source><year>2007</year><volume>84</volume><fpage>334</fpage><lpage>345</lpage><pub-id pub-id-type="pmid">17243024</pub-id><pub-id pub-id-type="doi">10.1007/s11524-006-9154-2</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gatrell</surname><given-names>AC</given-names></name><name><surname>Bailey</surname><given-names>TC</given-names></name><name><surname>Diggle</surname><given-names>PJ</given-names></name><name><surname>Rowlingson</surname><given-names>BS</given-names></name></person-group><article-title>Spatial point pattern analysis and its application in geographical epidemiology</article-title><source>Trans Inst Br Geogr</source><year>1996</year><volume>21</volume><fpage>256</fpage><lpage>274</lpage><pub-id pub-id-type="doi">10.2307/622936</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barrera</surname><given-names>R</given-names></name><name><surname>Delgado</surname><given-names>N</given-names></name><name><surname>Jimenez</surname><given-names>M</given-names></name><name><surname>Villalobos</surname><given-names>I</given-names></name><name><surname