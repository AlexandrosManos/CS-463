age>60</lpage><pub-id pub-id-type="pmid">18163491</pub-id><pub-id pub-id-type="doi">10.1002/art.23148</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wagner</surname><given-names>UG</given-names></name><name><surname>Kurtin</surname><given-names>PJ</given-names></name><name><surname>Wahner</surname><given-names>A</given-names></name><name><surname>Brackertz</surname><given-names>M</given-names></name><name><surname>Berry</surname><given-names>DJ</given-names></name><name><surname>Goronzy</surname><given-names>JJ</given-names></name><name><surname>Weyand</surname><given-names>CM</given-names></name></person-group><article-title>The role of CD8<sup>+</sup>CD40L<sup>+ </sup>T cells in the formation of germinal centers in rheumatoid synovitis</article-title><source>J Immunol</source><year>1998</year><volume>161</volume><fpage>6390</fpage><lpage>6397</lpage><pub-id pub-id-type="pmid">9834130</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kang</surname><given-names>YM</given-names></name><name><surname>Zhang</surname><given-names>X</given-names></name><name><surname>Wagner</surname><given-names>UG</given-names></name><name><surname>Yang</surname><given-names>H</given-names></name><name><surname>Beckenbaugh</surname><given-names>RD</given-names></name><name><surname>Kurtin</surname><given-names>PJ</given-names></name><name><surname>Goronzy</surname><given-names>JJ</given-names></name><name><surname>Weyand</surname><given-names>CM</given-names></name></person-group><article-title>CD8 T cells are required for the formation of ectopic germinal centers in rheumatoid synovitis</article-title><source>J Exp Med</source><year>2002</year><volume>195</volume><fpage>1325</fpage><lpage>1336</lpage><pub-id pub-id-type="pmid">12021312</pub-id><pub-id pub-id-type="doi">10.1084/jem.20011565</pub-id></citation></ref><ref id="B11">