cle-title>Resilin in the cuticle of click beetles</article-title><source>J Georgia Entomol Soc</source><year>1969</year><volume>4</volume><fpage>31</fpage><lpage>32</lpage></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Andersen</surname><given-names>SO</given-names></name></person-group><article-title>Characterization of a new type of cross-linkage in resilin, a rubber-like protein</article-title><source>Biochim Biophys Acta</source><year>1963</year><volume>69</volume><fpage>249</fpage><lpage>262</lpage><pub-id pub-id-type="pmid">14012804</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Andersen</surname><given-names>SO</given-names></name></person-group><article-title>The cross links in resilin identified as dityrosine and trityrosine</article-title><source>Biochim Biophys Acta</source><year>1964</year><volume>93</volume><fpage>213</fpage><lpage>215</lpage><pub-id pub-id-type="pmid">14249161</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Malencik</surname><given-names>DA</given-names></name><name><surname>Sprouse</surname><given-names>JF</given-names></name><name><surname>Swanson</surname><given-names>CA</given-names></name><name><surname>Anderson</surname><given-names>SR</given-names></name></person-group><article-title>Dityrosine: preparation, isolation, and analysis</article-title><source>Anal Biochem</source><year>1996</year><volume>242</volume><fpage>202</fpage><lpage>213</lpage><pub-id pub-id-type="pmid">8937563</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Andersen</surname><given-names>SO</given-names></name><name><surname>Weis-Fogh</surname><given-names>T</given-names></name></person-group><article-title>Resilin. A rubberlike protein in arthro