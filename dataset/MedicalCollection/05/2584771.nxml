tation></ref><ref id="r11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Halbert</surname><given-names>SP</given-names></name><name><surname>Manski</surname><given-names>W</given-names></name></person-group><article-title>Organ Specificity with special reference to the lens.</article-title><source>Prog Allergy</source><year>1963</year><volume>7</volume><fpage>107</fpage><lpage>86</lpage><pub-id pub-id-type="pmid">13952055</pub-id></citation></ref><ref id="r12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bhat</surname><given-names>SP</given-names></name><name><surname>Horwitz</surname><given-names>J</given-names></name><name><surname>Srinivasan</surname><given-names>A</given-names></name><name><surname>Ding</surname><given-names>L</given-names></name></person-group><article-title>Alpha B-crystallin exists as an independent protein in the heart and in the lens.</article-title><source>Eur J Biochem</source><year>1991</year><volume>202</volume><fpage>775</fpage><lpage>81</lpage><pub-id pub-id-type="pmid">1765091</pub-id></citation></ref><ref id="r13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Iwaki</surname><given-names>T</given-names></name><name><surname>Iwaki</surname><given-names>A</given-names></name><name><surname>Goldman</surname><given-names>JE</given-names></name></person-group><article-title>&#x003b1;B Crystallin in oxidative muscle fibers and its accumulation in ragged-red fibers: A comparative immunohistochemical and histochemical study in human skeletal muscle.</article-title><source>Acta Neuropathol</source><year>1993</year><volume>85</volume><fpage>475</fpage><lpage>80</lpage><pub-id pub-id-type="pmid">8388147</pub-id></citation></ref><ref id="r14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Iwaki</surname><g