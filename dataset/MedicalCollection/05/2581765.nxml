="1" colspan="1">1.21&#x000a0;&#x000b1;&#x000a0;0.12<sup>b</sup></td><td align="center" rowspan="1" colspan="1">1.05&#x000a0;&#x000b1;&#x000a0;0.10<sup>c</sup></td></tr><tr><td align="left" rowspan="1" colspan="1">LDL-C (mmol/L)</td><td align="center" rowspan="1" colspan="1">1.90&#x000a0;&#x000b1;&#x000a0;0.57<sup>a</sup></td><td align="center" rowspan="1" colspan="1">3.09&#x000a0;&#x000b1;&#x000a0;0.89<sup>b</sup></td><td align="center" rowspan="1" colspan="1">2.82&#x000a0;&#x000b1;&#x000a0;0.94<sup>b</sup></td></tr><tr><td align="left" rowspan="1" colspan="1">TAC (U/ml)</td><td align="center" rowspan="1" colspan="1">11.54&#x000a0;&#x000b1;&#x000a0;1.56<sup>a</sup></td><td align="center" rowspan="1" colspan="1">12.63&#x000a0;&#x000b1;&#x000a0;1.29<sup>a</sup></td><td align="center" rowspan="1" colspan="1">12.29&#x000a0;&#x000b1;&#x000a0;1.67<sup>a</sup></td></tr><tr><td align="left" rowspan="1" colspan="1">SOD (U/ml)</td><td align="center" rowspan="1" colspan="1">110.18&#x000a0;&#x000b1;&#x000a0;18.82<sup>a</sup></td><td align="center" rowspan="1" colspan="1">92.05&#x000a0;&#x000b1;&#x000a0;20.35<sup>b</sup></td><td align="center" rowspan="1" colspan="1">90.15&#x000a0;&#x000b1;&#x000a0;22.35<sup>b</sup></td></tr><tr><td align="left" rowspan="1" colspan="1">GSH-PX (U/ml)</td><td align="center" rowspan="1" colspan="1">220.92&#x000a0;&#x000b1;&#x000a0;37.80<sup>a</sup></td><td align="center" rowspan="1" colspan="1">185&#x000a0;&#x000b1;&#x000a0;30.7<sup>b</sup></td><td align="center" rowspan="1" colspan="1">172.54&#x000a0;&#x000b1;&#x000a0;32.23<sup>c</sup></td></tr><tr><td align="left" rowspan="1" colspan="1">MDA (nmol/ml)</td><td align="center" rowspan="1" colspan="1">10.53&#x000a0;&#x000b1;&#x000a0;2.50<sup>a</sup></td><td align="center" rowspan="1" colspan="1">13.89&#x000a0;&#x000b1;&#x000a0;3.80<sup>a</sup></td><td align="center" rowspan="1" colspan="1">26.12&#x000a0;&#x000b1;&#x000a0;5.93<sup>b</sup></td></tr></tbody></table><table-wrap-foot><p>Values are expressed as mean&#x000a0;&#x000b1;&#x000a0;SD for 15 subjects. Values in the same line with different superscripts are significantly different at <italic>p</italic>&#x0003c;0.05 level, as assessed by a one-way analysis of variance. BMI indicates body mass index; LDL, low-density lipoprotein; HDL, high-density lipoprotein.</p></table-wrap-foot></table-wrap></floats-wrap></article>