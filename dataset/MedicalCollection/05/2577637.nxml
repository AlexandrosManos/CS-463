><given-names>ER</given-names></name><name><surname>Gruenert</surname><given-names>DC</given-names></name><name><surname>Thompson</surname><given-names>PJ</given-names></name><name><surname>Stewart</surname><given-names>GA</given-names></name><name><surname>Taylor</surname><given-names>GW</given-names></name><name><surname>Garrod</surname><given-names>DR</given-names></name><name><surname>Cannell</surname><given-names>MB</given-names></name><name><surname>Robinson</surname><given-names>C</given-names></name><article-title>Der p 1 facilitates transepithelial allergen delivery by disruption of tight junctions</article-title><source>J Clin Invest</source><year>1999</year><volume>104</volume><fpage>123</fpage><lpage>133</lpage><pub-id pub-id-type="doi">10.1172/JCI5844</pub-id><pub-id pub-id-type="pmid">10393706</pub-id></mixed-citation></ref><ref id="B10"><mixed-citation publication-type="journal"><name><surname>Cates</surname><given-names>EC</given-names></name><name><surname>Fattouh</surname><given-names>R</given-names></name><name><surname>Johnson</surname><given-names>JR</given-names></name><name><surname>Llop-Guevara</surname><given-names>A</given-names></name><name><surname>Jordana</surname><given-names>M</given-names></name><article-title>Modeling responses to respiratory house dust mite exposure</article-title><source>Contrib Microbiol</source><year>2007</year><volume>14</volume><fpage>42</fpage><lpage>67</lpage><pub-id pub-id-type="pmid">17684332</pub-id></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><name><surname>Ishii</surname><given-names>A</given-names></name><name><surname>Takaoka</surname><given-names>M</given-names></name><name><surname>Matsui</surname><given-names>Y</given-names></name><article-title>Production of guinea pig reaginic antibody against the house dust mite extract, Dermatophagoides pteronyssinus, without adjuvant</article-title><source>Jpn J Exp Med</source><year>1977</year><volume>47</volume><fpage>377</f