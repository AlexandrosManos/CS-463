me><surname>Carter</surname><given-names>GL</given-names></name><name><surname>Levey</surname><given-names>CM</given-names></name></person-group><article-title>Health care. A model for the management of self-poisoning</article-title><source>Med J Aust</source><year>1997</year><volume>167</volume><fpage>142</fpage><lpage>146</lpage><pub-id pub-id-type="pmid">9269269</pub-id></citation></ref></ref-list></back></article>