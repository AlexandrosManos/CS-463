olspan="1">42</td><td align="char" char="." rowspan="1" colspan="1">23</td><td align="char" char="." rowspan="1" colspan="1">762</td><td align="char" char="." rowspan="1" colspan="1">490</td><td align="char" char="." rowspan="1" colspan="1">1.55</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;(<xref ref-type="bibr" rid="bib39">Kruggel 2006</xref>)</td><td rowspan="1" colspan="1">F</td><td align="char" char="." rowspan="1" colspan="1">145</td><td align="char" char="." rowspan="1" colspan="1">24</td><td align="char" char="." rowspan="1" colspan="1">670</td><td align="char" char="." rowspan="1" colspan="1">640</td><td align="char" char="." rowspan="1" colspan="1">1.05</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;5.8%</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;9.0%</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">M</td><td align="char" char="." rowspan="1" colspan="1">145</td><td align="char" char="." rowspan="1" colspan="1">24</td><td align="char" char="." rowspan="1" colspan="1">710</td><td align="char" char="." rowspan="1" colspan="1">700</td><td align="char" char="." rowspan="1" colspan="1">1.01</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;(<xref ref-type="bibr" rid="bib47">Luders et al. 2002</xref>)</td><td rowspan="1" colspan="1">F</td><td align="char" char="." rowspan="1" colspan="1">50</td><td align="char" char="." rowspan="1" colspan="1">24</td><td align="char" char="." rowspan="1" colspan="1">740</td><td align="char" char="." rowspan="1" colspan="1">360</td><td align="char" char="." rowspan="1" colspan="1">2.06</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;10.3%</td><td align="char" char="." rowspan="1" colspan="1">&#x02212;15.4%</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">M</td><td ali