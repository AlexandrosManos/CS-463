son-group-type="author"><collab>Second Administrative Level Boundaries (SALB)</collab></person-group><ext-link ext-link-type="uri" xlink:href="http://www.who.int/whosis/database/gis/salb/salb_PO.htm"/></citation></ref><ref id="B23"><citation citation-type="other"><person-group person-group-type="author"><collab>Global Administrative Unit Layers (GAUL)</collab></person-group><ext-link ext-link-type="uri" xlink:href="http://www.fao.org/geonetwork/srv/cn/metadata.show?id=12691"/></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guerra</surname><given-names>C</given-names></name><name><surname>Gikandi</surname><given-names>P</given-names></name><name><surname>Tatem</surname><given-names>A</given-names></name><name><surname>Noor</surname><given-names>A</given-names></name><name><surname>Smith</surname><given-names>D</given-names></name><name><surname>Hay</surname><given-names>S</given-names></name><name><surname>Snow</surname><given-names>R</given-names></name></person-group><article-title>The limits and intensity of Plasmodium falciparum transmission: Implications for malaria control and elimination worldwide</article-title><source>PLoS Med</source><year>2008</year><volume>5</volume><fpage>e38</fpage><pub-id pub-id-type="pmid">18303939</pub-id><pub-id pub-id-type="doi">10.1371/journal.pmed.0050038</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Balk</surname><given-names>DL</given-names></name><name><surname>Deichmann</surname><given-names>U</given-names></name><name><surname>Yetman</surname><given-names>G</given-names></name><name><surname>Pozzi</surname><given-names>F</given-names></name><name><surname>Hay</surname><given-names>SI</given-names></name><name><surname>Nelson</surname><given-names>A</given-names></name></person-group><article-title>Determining global population distribution: methods, applications and data<