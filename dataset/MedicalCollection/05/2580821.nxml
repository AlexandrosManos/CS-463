group person-group-type="author"><name><surname>Huang</surname><given-names>S</given-names></name></person-group><year>2007</year><article-title>Bifurcation dynamics in lineage-commitment in bipotent progenitor cells.</article-title><source>Dev Biol</source><volume>305</volume><fpage>695</fpage><lpage>713</lpage><pub-id pub-id-type="pmid">17412320</pub-id></citation></ref><ref id="pcbi.1000235-Acar1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Acar</surname><given-names>M</given-names></name></person-group><year>2005</year><article-title>Enhancement of cellular memory by reducing stochastic transitions.</article-title><source>Nature</source><volume>435</volume><fpage>228</fpage><lpage>232</lpage><pub-id pub-id-type="pmid">15889097</pub-id></citation></ref><ref id="pcbi.1000235-McClean1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McClean</surname><given-names>MN</given-names></name></person-group><year>2006</year><article-title>Cross-talk and decision making in MAP kinase pathways.</article-title><source>Nat Genet</source><volume>39</volume><fpage>409</fpage><lpage>413</lpage><pub-id pub-id-type="pmid">17259986</pub-id></citation></ref><ref id="pcbi.1000235-Paliwal1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Paliwal</surname><given-names>S</given-names></name><etal/></person-group><year>2007</year><article-title>MAPK-mediated bimodal gene expression and adaptive gradient sensing in yeast.</article-title><source>Nature</source><volume>446</volume><fpage>46</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">17310144</pub-id></citation></ref><ref id="pcbi.1000235-Bhalla1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bhalla</surname><given-names>US</given-names></name></person-group><year>2002</year><article-title>MAP kinase phosphatase as a locus of flexibility in a mitogen-activated protein kinase signaling network.</article-title><source>Science</source><volume>297</volume><fpage>1018</fpage><lpage>1023</lpage><pub-id pub-id-type="pmid">12169734</pub-id></citation></ref><ref id="pcbi.1000235-Blais1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blais</surname><given-names>A</given-names></name><etal/></person-group><year>2005</year><article-title>An initial blueprint for myogenic differentiation.</article-title><source>Genes Dev</source><volume>19</volume><fpage>553</fpage><lpage>569</lpage><pub-id pub-id-type="pmid">15706034</pub-id></citation></ref><ref id="pcbi.1000235-Odom1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Odom</surname><given-names>DT</given-names></name><etal/></person-group><year>2006</year><article-title>Core transcriptional regulatory circuitry in human hepatocytes.</article-title><source>Mol Syst Biol</source><volume>2</volume><fpage>2006.0017</fpage><pub-id pub-id-type="pmid">16738562</pub-id></citation></ref><ref id="pcbi.1000235-Rothenberg1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rothenberg</surname><given-names>EV</given-names></name></person-group><year>2007</year><article-title>Cell lineage regulators in B and T cell development.</article-title><source>Nat Immunol</source><volume>8</volume><fpage>441</fpage><lpage>444</lpage><pub-id pub-id-type="pmid">17440447</pub-id></citation></ref><ref id="pcbi.1000235-Alon1"><label>20</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Alon</surname><given-names>U</given-names></name></person-group><year>2007</year><source>Introduction to Systems Biology</source><publisher-loc>London</publisher-loc><publisher-name>Chapman and Hall/CRC</publisher-name></citation></ref><ref id="pcbi.1000235-Cinquin1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cinquin</surname><given-names>O</given-names></name></person-group><year>2005</year><article-title>High-dimensional switches and the modelling of cellular differentiation.</article-title><source>J Theor Biol</source><volume>233</volume><fpage>391</fpage><lpage>411</lpage><pub-id pub-id-type="pmid">15652148</pub-id></citation></ref><ref id="pcbi.1000235-Roeder1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roeder</surname><given-names>I</given-names></name></person-group><year>2006</year><article-title>Towards an understanding of lineage specification in hematopoietic stem cells: a mathematical model for the interaction of transcription factors GATA-1 and PU.1.</article-title><source>J Theor Biol</source><volume>241</volume><fpage>852</fpage><lpage>865</lpage><pub-id pub-id-type="pmid">16510158</pub-id></citation></ref><ref id="pcbi.1000235-Reinhardt1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reinhardt</surname><given-names>RL</given-names></name></person-group><year>2006</year><article-title>T helper cell effector fates&#x02013;who, how and where?</article-title><source>Curr Opin Immunol</source><volume>18</volume><fpage>271</fpage><lpage>277</lpage><pub-id pub-id-type="pmid">16617008</pub-id></citation></ref><ref id="pcbi.1000235-Santos1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Santos</surname><given-names>SD</given-names></name></person-group><year>2007</year><article-title>Growth factor-induced MAPK network topology shapes Erk response determining PC-12 cell fate.</article-title><source>Nat Cell Biol</source><volume>9</volume><fpage>324</fpage><lpage>330</lpage><pub-id pub-id-type="pmid">17310240</pub-id></citation></ref><ref id="pcbi.1000235-Simpson1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simpson</surname><given-names>P</given-names></name></person-group><year>1997</year><article-title>Notch signalling in development: on equivalence groups and asymmetric developmental potential.</article-title><source>Curr Opin Genet Dev</source><volume>7</volume><fpage>537</fpage><lpage>542</lpage><pub-id pub-id-type="pmid">9309187</pub-id></citation></ref><ref id="pcbi.1000235-MikeladzeDvali1"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mikeladze-Dvali</surname><given-names>T</given-names></name><etal/></person-group><year>2005</year><article-title>The growth regulators warts/lats and melted interact in a bistable loop to specify opposite fates in Drosophila R8 photoreceptors.</article-title><source>Cell</source><volume>122</volume><fpage>775</fpage><lpage>787</lpage><pub-id pub-id-type="pmid">16143107</pub-id></citation></ref><ref id="pcbi.1000235-Machens1"><label>27</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Machens</surname><given-names>CK</given-names></name></person-group><year>2005</year><article-title>Flexible control of mutual inhibition: a neural model of two-interval discrimination.</article-title><source>Science</source><volume>307</volume><fpage>1121</fpage><lpage>1124</lpage><pub-id pub-id-type="pmid">15718474</pub-id></citation></ref><ref id="pcbi.1000235-Wong1"><label>28</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wong</surname><given-names>KF</given-names></name></person-group><year>2006</year><article-title>A recurrent network mechanism of time integration in perceptual decisions.</article-title><source>J Neurosci</source><volume>26</volume><fpage>1314</fpage><lpage>1328</lpage><pub-id pub-id-type="pmid">16436619</pub-id></citation></ref><ref id="pcbi.1000235-Chickarmane1"><l