left">DMBT1</td><td align="center">[<xref ref-type="bibr" rid="B33">33</xref>]</td><td align="left">chr10:124,329,825&#x02013;124,371,833</td></tr><tr><td align="left">19q13.2</td><td align="right">48.0</td><td align="right">15.7</td><td align="right">3</td><td align="left">&#x0003e;95%</td><td align="center">+</td><td></td><td align="left">FCGBP</td><td></td><td align="left">chr19:45,056,041&#x02013;45,104,055</td></tr><tr><td align="left">Yq11.223</td><td align="right">17.5</td><td align="right">2.4</td><td align="right">7</td><td></td><td align="center">+</td><td align="left">Intra (7)</td><td align="left">Daz1</td><td align="center">[<xref ref-type="bibr" rid="B19">19</xref>]</td><td align="left">chrY:23,706,609&#x02013;23,724,156</td></tr><tr><td align="left">Yq11.223</td><td align="right">29.5</td><td align="right">2.4</td><td align="right">12</td><td></td><td align="center">+</td><td align="left">Intra (7)</td><td align="left">Daz2</td><td></td><td align="left">chrY:23,783,768&#x02013;23,813,249</td></tr><tr><td align="left">Yq11.223</td><td align="right">16.7</td><td align="right">2.4</td><td align="right">7</td><td></td><td align="center">+</td><td align="left">Intra (7)</td><td align="left">Daz2</td><td></td><td align="left">chrY:23,820,447&#x02013;23,837,326</td></tr><tr><td align="left">Yq11.23</td><td align="right">22.3</td><td align="right">2.4</td><td align="right">9</td><td></td><td align="center">+</td><td align="left">Intra (7)</td><td align="left">Daz3</td><td></td><td align="left">chrY:25,337,948&#x02013;25,360,227</td></tr><tr><td align="left">Yq11.23</td><td align="right">22.3</td><td align="right">2.4</td><td align="right">9</td><td></td><td align="center">+</td><td align="left">Intra (7)</td><td align="left">Daz4</td><td></td><td align="left">chrY:25,409,003&#x02013;25,431,283</td></tr><tr><td align="left">Yq11.23</td><td align="right">14.8</td><td align="right">2.4</td><td align="right">6</td><td></td><td align="center">+</td><td align="left">Intra (7)</td><td align="left">Daz4</td><td></td><td align="left">chrY:25,438,190&#x02013;25,453,002</td></tr><tr><td align="left">Yq11.23</td><td align="right">26.2</td><td align="right">10.8</td><td align="right">2.4</td><td></td><td align="center">+</td><td align="left">Intra (7)</td><td align="left">Daz1</td><td></td><td align="left">chrY:23,726,459&#x02013;23,752,640</td></tr><tr><td align="left" colspan="10"><bold><italic>C) Tandem arrays that contain gene, EST or exon</italic></bold></td></tr><tr><td align="left">1p36.66</td><td align="right">14.4</td><td align="right">3.4</td><td align="right">4</td><td align="left">&#x0003e;98%</td><td align="center">+</td><td align="left">SD</td><td align="left">AK125248</td><td></td><td align="left">chr1:655,059&#x02013;669,457</td></tr><tr><td align="left">2p13.2</td><td align="right">28.4</td><td align="right">4.9</td><td align="right">5.7</td><td align="left">&#x0003e;95%</td><td align="center">+</td><td></td><td align="left">FLJ43987</td><td></td><td align="left">chr2:73,862,733&#x02013;73,891,172</td></tr><tr><td align="left">4q28.3</td><td align="right">41.3</td><td align="right">2.5</td><td align="right">17</td><td align="left">&#x0003e;95%</td><td align="center">+</td><td align="left">SD, inter (8)</td><td align="left">SST</td><td align="center">[<xref ref-type="bibr" rid="B35">35</xref>]</td><td align="left">chr4:132,864,491&#x02013;132,905,799</td></tr><tr><td align="left">5q13.2</td><td align="right">36.9</td><td align="right">21.3</td><td align="right">2</td><td align="left">&#x0003e;99%</td><td align="center">+</td><td align="left">SD</td><td align="left">GUSBP</td><td></td><td align="left">chr5:69,823,338&#x02013;69,860,219</td></tr><tr><td align="left">16p11.2</td><td align="right">6.4</td><td align="right">1.9</td><td align="right">3.4</td><td align="left">&#x0003e;88%</td><td align="center">+</td><td align="left">SD, inter (5)</td><td align="left">BC012355</td><td></td><td align="left">chr16:33,450,421&