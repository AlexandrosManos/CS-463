-names>N</given-names></name><name><surname>Kim</surname><given-names>BH</given-names></name></person-group><article-title>Peptide conjugates of oligonucleotides: synthesis and applications</article-title><source>Chem. Rev.</source><year>2006</year><volume>106</volume><fpage>3712</fpage><lpage>3761</lpage><pub-id pub-id-type="pmid">16967918</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Turner</surname><given-names>JJ</given-names></name><name><surname>Arzumanov</surname><given-names>A</given-names></name><name><surname>Ivanova</surname><given-names>G</given-names></name><name><surname>Fabani</surname><given-names>M</given-names></name><name><surname>Gait</surname><given-names>MJ</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Langel</surname><given-names>U</given-names></name></person-group><source>Cell-Penetrating Peptides</source><year>2006</year><edition>2nd</edition><publisher-loc>Boca Raton</publisher-loc><publisher-name>CRC Press</publisher-name><fpage>313</fpage><lpage>328</lpage></element-citation></ref><ref id="B19"><label>19</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Fabani</surname><given-names>MM</given-names></name><name><surname>Ivanova</surname><given-names>GD</given-names></name><name><surname>Gait</surname><given-names>MJ</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Kurreck</surname><given-names>J</given-names></name></person-group><source>Therapeutic Oligonucleotides.</source><year>2008</year><publisher-loc>Cambridge, UK</publisher-loc><publisher-name>Royal Society of Chemistry</publisher-name><fpage>80</fpage><lpage>102</lpage></element-citation></ref><ref id="B20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Flet