article-title>The structure of human thrombospondin, an adhesive glycoprotein with multiple calcium-binding sites and homologies with several different proteins</article-title><source><italic>Journal of Cell Biology</italic></source><year>1986</year><volume>103</volume><issue>5</issue><fpage>1635</fpage><lpage>1648</lpage><pub-id pub-id-type="pmid">2430973</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jim&#x000e9;nez</surname><given-names>B</given-names></name><name><surname>Volpert</surname><given-names>O</given-names></name><name><surname>Crawford</surname><given-names>SE</given-names></name><name><surname>Febbraio</surname><given-names>M</given-names></name><name><surname>Silverstein</surname><given-names>RL</given-names></name><name><surname>Bouck</surname><given-names>N</given-names></name></person-group><article-title>Signals leading to apoptosis-dependent inhibition of neovascularization by thrombospondin-1</article-title><source><italic>Nature Medicine</italic></source><year>2000</year><volume>6</volume><issue>1</issue><fpage>41</fpage><lpage>48</lpage></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Silverstein</surname><given-names>RL</given-names></name><name><surname>Baird</surname><given-names>M</given-names></name><name><surname>Lo</surname><given-names>SK</given-names></name><name><surname>Yesner</surname><given-names>LM</given-names></name></person-group><article-title>Sense and antisense cDNA transfection of CD36 (glycoprotein IV) in melanoma cells. Role of CD36 as a thrombospondin receptor</article-title><source><italic>Journal of Biological Chemistry</italic></source><year>1992</year><volume>267</volume><issue>23</issue><fpage>16607</fpage><lpage>16612</lpage><pub-id pub-id-type="pmid">1379600</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gruarin</surname><given-names>P</given-names></name><name><surname>Thorne</surname><given-names>R</given-names></name><name><surname>Dorahy</surname><given-names>DJ</given-names></name><name><surname>Burns</surname><given-names>GF</given-names></name><name><surname>Sitia</surname><given-names>R</given-names></name><name><surname>Alessio</surname><given-names>M</given-names></name></person-group><article-title>CD36 is a ditopic glycoprotein with the N-terminal domain implicated in intracellular transport</article-title><source><italic>Biochemical and Biophysical Research Communications</italic></source><year>2000</year><volume>275</volume><issue>2</issue><fpage>446</fpage><lpage>454</lpage><pub-id pub-id-type="pmid">10964685</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Daviet</surname><given-names>L</given-names></name><name><surname>Malvoisin</surname><given-names>E</given-names></name><name><surname>Wild</surname><given-names>TF</given-names></name><name><surname>McGregor</surname><given-names>JL</given-names></name></person-group><article-title>Thrombospondin induces dimerization of membrane-bound, but not soluble CD36</article-title><source><italic>Thrombosis and Haemostasis</italic></source><year>1997</year><volume>78</volume><issue>2</issue><fpage>897</fpage><lpage>901</lpage><pub-id pub-id-type="pmid">9268192</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Martin</surname><given-names>CA</given-names></name><name><surname>Longman</surname><given-names>E</given-names></name><name><surname>Wooding</surname><given-names>C</given-names></name><etal/></person-group><article-title>Cd36, a class B scaveng