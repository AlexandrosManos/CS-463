tion-type="other"><person-group person-group-type="author"><name><surname>Dowe</surname><given-names>P</given-names></name></person-group><article-title>Counterfactual Theories of Causation [Stanford Encyclopedia of Philosophy]</article-title><source>Updated 2001 Jan 12; cited 2008 Feb 29</source><ext-link ext-link-type="uri" xlink:href="http://plato.stanford.edu/entries/causation-counterfactual/"/></citation></ref><ref id="B26"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Mackie</surname><given-names>J</given-names></name></person-group><source>The cement of the universe</source><year>1974</year><publisher-name>Oxford: Clarendon Press</publisher-name></citation></ref><ref id="B27"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Hoefer</surname><given-names>C</given-names></name></person-group><article-title>Causal Determinism [Stanford Encyclopedia of Philosophy]</article-title><source>Updated 2008, Jan 23; cited 2008 Feb 28</source><ext-link ext-link-type="uri" xlink:href="http://plato.stanford.edu/entries/determinism-causal/"/></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Phillips</surname><given-names>CV</given-names></name><name><surname>Goodman</surname><given-names>KJ</given-names></name></person-group><article-title>The missed lessons of Sir Austin Bradford Hill</article-title><source>Epidemiol Perspect Innov</source><year>2004</year><volume>1</volume><fpage>3</fpage><pub-id pub-id-type="pmid">15507128</pub-id><pub-id pub-id-type="doi">10.1186/1742-5573-1-3</pub-id></citation></ref><ref id="B29"><citation citation-type="other"><person-group person-group-type="author"><collab>European Council</collab></person-group><source>European Council Directive 93/42/EEC of 14 June 1993 concerning medical devices, Council Directive 93/42/EEC edn</source><year>1993</year></citation></ref><ref id="B30"><citation citati