tation citation-type="journal"><person-group person-group-type="author"><name><surname>de Bosset</surname><given-names>V</given-names></name><name><surname>Atashili</surname><given-names>J</given-names></name><name><surname>Miller</surname><given-names>W</given-names></name><name><surname>Pignone</surname><given-names>M</given-names></name></person-group><article-title>Health insurance-related disparities in colorectal cancer screening in virginia</article-title><source>Cancer Epidemiol Biomarkers Prev</source><year>2008</year><volume>17</volume><fpage>834</fpage><lpage>837</lpage><pub-id pub-id-type="pmid">18398024</pub-id><pub-id pub-id-type="doi">10.1158/1055-9965.EPI-07-2760</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lian</surname><given-names>M</given-names></name><name><surname>Jeffe</surname><given-names>DB</given-names></name><name><surname>Schootman</surname><given-names>M</given-names></name></person-group><article-title>Racial and Geographic Differences in Mammography Screening in St. Louis City: A Multilevel Study</article-title><source>J Urban Health</source><year>2008</year><volume>85</volume><fpage>677</fpage><lpage>692</lpage><pub-id pub-id-type="pmid">18622709</pub-id><pub-id pub-id-type="doi">10.1007/s11524-008-9301-z</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schootman</surname><given-names>M</given-names></name><name><surname>Jeffe</surname><given-names>DB</given-names></name><name><surname>Baker</surname><given-names>EA</given-names></name><name><surname>Walker</surname><given-names>MS</given-names></name></person-group><article-title>Effect of area poverty rate on cancer screening across US communities</article-title><source>J Epidemiol Community Health</source><year>2006</year><volume>60</volume><fpage>202</fpage><lpage>207</lpage><pub-id pub-id-type="pmid">16476748</pub-id>