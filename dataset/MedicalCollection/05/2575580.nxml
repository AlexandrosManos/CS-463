b-id-type="pmid">18460665</pub-id><pub-id pub-id-type="doi">10.1001/jama.299.17.2048</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Peter</surname><given-names>JV</given-names></name><name><surname>John</surname><given-names>P</given-names></name><name><surname>Graham</surname><given-names>PL</given-names></name><name><surname>Moran</surname><given-names>JL</given-names></name><name><surname>George</surname><given-names>IA</given-names></name><name><surname>Bersten</surname><given-names>A</given-names></name></person-group><article-title>Corticosteroids in the prevention and treatment of acute respiratory distress syndrome (ARDS) in adults: meta-analysis</article-title><source>BMJ</source><year>2008</year><volume>336</volume><fpage>1006</fpage><lpage>1009</lpage><pub-id pub-id-type="pmid">18434379</pub-id><pub-id pub-id-type="doi">10.1136/bmj.39537.939039.BE</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adhikari</surname><given-names>NKJ</given-names></name><name><surname>Scales</surname><given-names>DC</given-names></name></person-group><article-title>Corticosteroids for acute respiratory distress syndrome</article-title><source>BMJ</source><year>2008</year><volume>336</volume><fpage>969</fpage><lpage>970</lpage><pub-id pub-id-type="pmid">18434378</pub-id><pub-id pub-id-type="doi">10.1136/bmj.39553.408924.80</pub-id></citation></ref></ref-list></back></article>