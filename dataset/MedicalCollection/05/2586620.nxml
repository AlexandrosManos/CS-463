 id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Merle d'Aubign&#x000e9;</surname><given-names>R</given-names></name><name><surname>Postel</surname><given-names>M</given-names></name></person-group><article-title>Functional results of hip arthroplasty with acrylic prosthesis</article-title><source>J Bone Joint Surg Am</source><year>1954</year><volume>36A</volume><fpage>451</fpage><lpage>475</lpage></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kuokkanen</surname><given-names>HOM</given-names></name><name><surname>Suominen</surname><given-names>PK</given-names></name><name><surname>Korkala</surname><given-names>OL</given-names></name></person-group><article-title>The outcome of femoral neck fractures</article-title><source>Int Orthop</source><year>1990</year><volume>14</volume><fpage>377</fpage><lpage>380</lpage><pub-id pub-id-type="pmid">2076922</pub-id><pub-id pub-id-type="doi">10.1007/BF00182648</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>LaBelle</surname><given-names>LW</given-names></name><name><surname>Colwill</surname><given-names>IE</given-names></name><name><surname>Swanson</surname><given-names>AB</given-names></name></person-group><article-title>Bateman bipolar hip arthroplasty for femoral neck fractures. A five- to ten-year follow-up study</article-title><source>Clin Orthop</source><year>1990</year><volume>251</volume><fpage>20</fpage><lpage>25</lpage><pub-id pub-id-type="pmid">2295175</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Phillips</surname><given-names>TW</given-names></name></person-group><article-title>Thompson hemiarthroplasty and acetabular erosion</article-title><source>J Bone Joint Surg [Am]</source><year>1989</year><volume>71</volume><fpage>913</fpage><lp