</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sneath</surname><given-names>RJ</given-names></name><name><surname>Mangham</surname><given-names>DC</given-names></name></person-group><article-title>The normal structure and function of CD44 and its role in neoplasia</article-title><source>Mol Pathol</source><year>1998</year><volume>51</volume><fpage>191</fpage><lpage>200</lpage><pub-id pub-id-type="pmid">9893744</pub-id><pub-id pub-id-type="pmid">9893744</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gunthert</surname><given-names>U</given-names></name><name><surname>Hofmann</surname><given-names>M</given-names></name><name><surname>Rudy</surname><given-names>W</given-names></name><name><surname>Reber</surname><given-names>S</given-names></name><name><surname>Zoller</surname><given-names>M</given-names></name><name><surname>Haussmann</surname><given-names>I</given-names></name><name><surname>Matzku</surname><given-names>S</given-names></name><name><surname>Wenzel</surname><given-names>A</given-names></name><name><surname>Ponta</surname><given-names>H</given-names></name><name><surname>Herrlich</surname><given-names>P</given-names></name></person-group><article-title>A new variant of glycoprotein CD44 confers metastatic potential to rat carcinoma cells</article-title><source>Cell</source><year>1991</year><volume>65</volume><fpage>13</fpage><lpage>24</lpage><pub-id pub-id-type="pmid">1707342</pub-id><pub-id pub-id-type="pmid">1707342</pub-id><pub-id pub-id-type="doi">10.1016/0092-8674(91)90403-L</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yamaguchi</surname><given-names>F</given-names></name><name><surname>Saya</surname><given-names>H</given-names></name><name><surname>Bruner</surname><given-names>JM</given-names></name><nam