d char="." align="char"/><td char="." align="char">54</td><td char="." align="char">16.2</td><td char="." align="char"/></tr><tr><td>After December 19, 2001</td><td char="." align="char">416</td><td char="." align="char">6.2</td><td char="." align="char">300</td><td char="." align="char">72.1</td><td char="." align="char"/><td char="." align="char">8</td><td char="." align="char">1.9</td><td char="." align="char"/><td char="." align="char">48</td><td char="." align="char">11.9</td><td char="." align="char"/><td char="." align="char">96</td><td char="." align="char">23.8</td><td char="." align="char"/></tr><tr><td colspan="15"><bold>Building occupants, passersby, and people in transit south of Chambers Street on 9/11</bold></td></tr><tr><td>Total<sup>e</sup></td><td char="." align="char">41,666</td><td char="." align="char">60.9</td><td char="." align="char">28,847</td><td char="." align="char">69.2</td><td char="." align="char"/><td char="." align="char">1,247</td><td char="." align="char">3.0</td><td char="." align="char"/><td char="." align="char">3,998</td><td char="." align="char">9.9</td><td char="." align="char"/><td char="." align="char">7,752</td><td char="." align="char">19.4</td><td char="." align="char"/></tr><tr><td colspan="15">Location on 9/11</td></tr><tr><td>Occupant of damaged or destroyed building</td><td char="." align="char">10,276</td><td char="." align="char">25.0</td><td char="." align="char">6,256</td><td char="." align="char">60.9</td><td char="." align="char">0.0001</td><td char="." align="char">255</td><td char="." align="char">2.5</td><td char="." align="char">0.0001</td><td char="." align="char">1,072</td><td char="." align="char">10.7</td><td char="." align="char">0.0001</td><td char="." align="char">2,134</td><td char="." align="char">21.4</td><td>0.0001</td></tr><tr><td>Occupant of undamaged building</td><td char="." align="char">18,993</td><td char="." align="char">46.1</td><td char="." align="char">13,517</td><td char="." align="cha