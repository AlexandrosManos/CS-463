nt-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Munkeby</surname><given-names>B</given-names></name><name><surname>Borke</surname><given-names>W</given-names></name><name><surname>Bjornland</surname><given-names>K</given-names></name><name><surname>Sikkeland</surname><given-names>LI</given-names></name><name><surname>Borge</surname><given-names>G</given-names></name><name><surname>Halvorsen</surname><given-names>B</given-names></name><etal/></person-group><article-title>Resuscitation with 100% O2 increases cerebral injury in hypoxemic piglets</article-title><source>Pediatr Res</source><year>2004</year><volume>56</volume><fpage>783</fpage><lpage>90</lpage><pub-id pub-id-type="pmid">15347772</pub-id></element-citation></ref><ref id="b16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Taylor</surname><given-names>DL</given-names></name><name><surname>Mehmet</surname><given-names>H</given-names></name><name><surname>Cady</surname><given-names>EB</given-names></name><name><surname>Edwards</surname><given-names>AD</given-names></name></person-group><article-title>Improved neuroprotection with hypothermia delayed by 6 hours following cerebral hypoxia-ischemia in the 14-day-old rat</article-title><source>Pediatr Res</source><year>2002</year><volume>51</volume><fpage>13</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">11756634</pub-id></element-citation></ref><ref id="b17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lorek</surname><given-names>A</given-names></name><name><surname>Takei</surname><given-names>Y</given-names></name><name><surname>Cady</surname><given-names>EB</given-names></name><name><surname>Wyatt</surname><given-names>JS</given-names></name><name><surname>Penrice</surname><given-names>J</given-names></name><name><surname>Edwards</surname><given-names>AD</given-names></