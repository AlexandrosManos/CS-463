e><year>2008</year><publisher-name>PNLP, Cotonou, BENIN</publisher-name><fpage>49</fpage></mixed-citation></ref><ref id="B21"><mixed-citation publication-type="journal"><name><surname>Akog&#x000e9;to</surname><given-names>M</given-names></name><name><surname>Modiano</surname><given-names>D</given-names></name><name><surname>Bosman</surname><given-names>A</given-names></name><article-title>Malaria transmission in the lagoon area of Cotonou, B&#x000e9;nin</article-title><source>Parassitologia</source><year>1992</year><volume>34</volume><fpage>147</fpage><lpage>154</lpage><pub-id pub-id-type="pmid">1339969</pub-id></mixed-citation></ref><ref id="B22"><mixed-citation publication-type="journal"><name><surname>Djogbenou</surname><given-names>L</given-names></name><name><surname>Pasteur</surname><given-names>N</given-names></name><name><surname>Bio-Bangana</surname><given-names>S</given-names></name><name><surname>Baldet</surname><given-names>T</given-names></name><name><surname>Irish</surname><given-names>SR</given-names></name><name><surname>Akogb&#x000e9;to</surname><given-names>M</given-names></name><etal/><article-title>Malaria vectors in the Republic of Benin: distribution of species and molecular forms of the Anopheles gambiae complex</article-title><source>Acta Trop</source><year>2010</year><volume>114</volume><issue>2</issue><fpage>116</fpage><lpage>22</lpage><pub-id pub-id-type="doi">10.1016/j.actatropica.2010.02.001</pub-id><pub-id pub-id-type="pmid">20138819</pub-id></mixed-citation></ref><ref id="B23"><mixed-citation publication-type="book"><collab>World Health Organization (WHO)</collab><source>Global strategy plan 2005-2015</source><year>2005</year><publisher-name>World Health Organization, Geneva</publisher-name><fpage>44</fpage></mixed-citation></ref><ref id="B24"><mixed-citation publication-type="book"><collab>Programme National de Lutte contre le Paludisme</collab><source>Plan strat&#x000e9;gique de lutte contre le paludisme au B&#x000e9;nin 2006-2010</source><year>2007</year><publisher-name>PNLP, Cotonou B&#x000c9;NIN</publisher-name><fpage>96</fpage><pub-id pub-id-type="pmid">16614329</pub-id></mixed-citation></ref><ref id="B25"><mixed-citation publication-type="journal"><name><surname>Ceesay</surname><given-names>SJ</given-names></name><name><surname>Casals-Pascual</surname><given-names>C</given-names></name><name><surname>Erskine</surname><given-names>J</given-names></name><name><surname>Anya</surname><given-names>SE</given-names></name><name><surname>Duah</surname><given-names>NO</given-names></name><name><surname>Fulford</surname><given-names>AJ</given-names></name><etal/><article-title>Changes in malaria indices between 1999 and 2007 in The Gambia: a retrospective analysis</article-title><source>Lancet</source><year>2008</year><volume>372</volume><issue>9649</issue><fpage>1545</fpage><lpage>1554</lpage><pub-id pub-id-type="doi">10.1016/S0140-6736(08)61654-2</pub-id><pub-id pub-id-type="pmid">18984187</pub-id></mixed-citation></ref><ref id="B26"><mixed-citation publication-type="journal"><name><surname>Guyatt</surname><given-names>HL</given-names></name><name><surname>Noor</surname><given-names>AM</given-names></name><name><surname>Ochola</surname><given-names>SA</given-names></name><name><surname>Snow</surname><given-names>RW</given-names></name><article-title>Use of intermittent presumptive treatment and insecticide treated bed nets by pregnant women if four Kenyan districts</article-title><source>Trop Med Int Health</source><year>2004</year><volume>9</volume><issue>2</issue><fpage>255</fpage><lpage>261</lpage><pub-id pub-id-type="doi">10.1046/j.1365-3156.2003.01193.x</pub-id><pub-id pub-id-type="pmid">15040563</pub-id></mixed-citation></ref><ref id="B27"><mixed-citation publication-type="journal"><name><surname>Gikandi</surname><given-names>PW</given-names></name><name><surname>Noor</surname><given-names>AM</given-names></name><name><surname>Gitonga</surname><given-names>CW</given-names></name><name><surname>Ajanga</surname><given-names>AA</given-names></name><name><surname>Snow</surname><given-names>RW</given-names></name><article-title>Access and barriers to measures targeted to prevent malaria in pregnancy in rural Kenya</article-title><source>Trop Med Int Health</source><year>2008</year><volume>13</volume><issue>2</issue><fpage>208</fpage><lpage>217</lpage><pub-id pub-id-type="doi">10.1111/j.1365-3156.2007.01992.x</pub-id><pub-id pub-id-type="pmid">18304267</pub-id></mixed-citation></ref><ref id="B28"><mixed-citation publication-type="journal"><name><surname>Holtz</surname><given-names>TH</given-names></name><name><surname>Kachur</surname><given-names>SP</given-names></name><name><surname>Roberts</surname><given-names>JM</given-names></name><name><surname>Marum</surname><given-names>LH</given-names></name><name><surname>Mkandala</surname><given-names>C</given-names></name><name><surname>Chizani</surname><given-names>N</given-names></name><etal/><article-title>Use of antenatal care services and intermittent preventive treatment for malaria among pregnant women in Blantyre District, Malawi</article-title><source>Trop Med Int Health</source><year>2004</year><volume>9</volume><issue>1</issue><fpage>77</fpage><lpage>82</lpage><pub-id pub-id-type="doi">10.1046/j.1365-3156.2003.01170.x</pub-id><pub-id pub-id-type="pmid">14728610</pub-id></mixed-citation></ref></ref-list></back></article>