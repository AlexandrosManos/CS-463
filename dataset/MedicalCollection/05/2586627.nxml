volume>49</volume><fpage>715</fpage><lpage>37</lpage><pub-id pub-id-type="pmid">1380140</pub-id><pub-id pub-id-type="doi">10.1016/0306-4522(92)90239-X</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McAlexander</surname><given-names>MA</given-names></name><name><surname>Myers</surname><given-names>AC</given-names></name><name><surname>Undem</surname><given-names>BJ</given-names></name></person-group><article-title>Adaptation of guinea-pig vagal airway afferent neurones to mechanical stimulation</article-title><source>J Physiol</source><year>1999</year><volume>521</volume><fpage>239</fpage><lpage>47</lpage><pub-id pub-id-type="pmid">10562348</pub-id><pub-id pub-id-type="doi">10.1111/j.1469-7793.1999.00239.x</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Van Genechten</surname><given-names>J</given-names></name><name><surname>Brouns</surname><given-names>I</given-names></name><name><surname>Burnstock</surname><given-names>G</given-names></name><name><surname>Timmermans</surname><given-names>JP</given-names></name><name><surname>Adriaensen</surname><given-names>D</given-names></name></person-group><article-title>Quantification of neuroepithelial bodies and their innervation in fawn-hooded and Wistar rat lungs</article-title><source>Am J Respir Cell Mol Biol</source><year>2004</year><volume>30</volume><fpage>20</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">12816734</pub-id><pub-id pub-id-type="doi">10.1165/rcmb.2003-0097OC</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Van Lommel</surname><given-names>A</given-names></name><name><surname>Lauweryns</surname><given-names>JM</given-names></name></person-group><article-title>Postnatal development of the pulmonary neuroepithelial bodies in various animal species</article-title><s