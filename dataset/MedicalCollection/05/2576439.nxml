><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weissblueth</surname><given-names>E</given-names></name><name><surname>Schwartz</surname><given-names>M</given-names></name><name><surname>Hocherman</surname><given-names>S</given-names></name></person-group><year>2008</year><article-title>Adaptation to cyclic stance perturbations in Parkinson's disease depends on postural demands.</article-title><source>Parkinsonism Rel Disord In Press</source></citation></ref><ref id="pone.0003663-Morris1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morris</surname><given-names>M</given-names></name><name><surname>Iansek</surname><given-names>R</given-names></name><name><surname>Smithson</surname><given-names>F</given-names></name><name><surname>Huxham</surname><given-names>F</given-names></name></person-group><year>2000</year><article-title>Postural instability in Parkinson's disease: a comparison with and without a concurrent task.</article-title><source>Gait Posture</source><volume>12</volume><fpage>205</fpage><lpage>16</lpage><pub-id pub-id-type="pmid">11154931</pub-id></citation></ref><ref id="pone.0003663-Hocherman3"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hocherman</surname><given-names>S</given-names></name><name><surname>Alexandrovsky</surname><given-names>L</given-names></name><name><surname>Badarny</surname><given-names>S</given-names></name><name><surname>Honigman</surname><given-names>S</given-names></name></person-group><year>1998a</year><article-title>L-DOPA improves visuo-motor coordination in stable Parkinson's disease patients.</article-title><source>Parkinsonism Rel Disord</source><volume>4(3)</volume><fpage>129</fpage><lpage>136</lpage></citation></ref><ref id="pone.0003663-Hocherman4"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hoc