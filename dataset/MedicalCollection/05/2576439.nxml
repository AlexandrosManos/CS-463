year><article-title>Distorted visual feedback effects on drawing in Parkinson's disease.</article-title><source>Acta Psychol</source><volume>95(3)</volume><fpage>255</fpage><lpage>266</lpage></citation></ref><ref id="pone.0003663-Rogers1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rogers</surname><given-names>RD</given-names></name><name><surname>Sahakian</surname><given-names>BJ</given-names></name><name><surname>Hodges</surname><given-names>JR</given-names></name><name><surname>Polkey</surname><given-names>CE</given-names></name><name><surname>Kennard</surname><given-names>C</given-names></name><etal/></person-group><year>1998</year><article-title>Dissociating executive mechanisms of task control following frontal lobe damage and Parkinson's disease.</article-title><source>Brain</source><volume>121</volume><fpage>815</fpage><lpage>842</lpage><pub-id pub-id-type="pmid">9619187</pub-id></citation></ref><ref id="pone.0003663-Fahn1"><label>13</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Fahn</surname><given-names>S</given-names></name><name><surname>Elton</surname><given-names>RL</given-names></name></person-group><year>1987</year><article-title>The unified Parkinson's disease rating scale.</article-title><person-group person-group-type="editor"><name><surname>Fahn</surname><given-names>S</given-names></name><name><surname>Marsden</surname><given-names>SD</given-names></name><name><surname>Calne</surname><given-names>DB</given-names></name></person-group><source>Recent developments in Parkinson's disease, vol 2</source><publisher-loc>Florham Park, NJ</publisher-loc><publisher-name>Macmillan Healthcare Information</publisher-name><fpage>153</fpage><lpage>163</lpage></citation></ref><ref id="pone.0003663-Bloem1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bloem</surname><given-names>BR</given-name