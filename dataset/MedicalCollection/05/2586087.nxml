olume>37</volume><fpage>226</fpage><lpage>238</lpage><pub-id pub-id-type="pmid">10931320</pub-id></citation></ref><ref id="pone.0003880-Walter1"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Walter</surname><given-names>P</given-names></name><name><surname>Lingappa</surname><given-names>VR</given-names></name></person-group><year>1986</year><article-title>Mechanism of protein translocation across the endoplasmic reticulum membrane.</article-title><source>Annu Rev Cell Biol</source><volume>2</volume><fpage>499</fpage><lpage>516</lpage><pub-id pub-id-type="pmid">3030381</pub-id></citation></ref><ref id="pone.0003880-Wickner1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wickner</surname><given-names>W</given-names></name><name><surname>Driessen</surname><given-names>AJ</given-names></name><name><surname>Hartl</surname><given-names>FU</given-names></name></person-group><year>1991</year><article-title>The enzymology of protein translocation across the Escherichia coli plasma membrane.</article-title><source>Annu Rev Biochem</source><volume>60</volume><fpage>101</fpage><lpage>124</lpage><pub-id pub-id-type="pmid">1831965</pub-id></citation></ref><ref id="pone.0003880-Hartmann1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hartmann</surname><given-names>E</given-names></name><name><surname>Sommer</surname><given-names>T</given-names></name><name><surname>Prehn</surname><given-names>S</given-names></name><name><surname>Gorlich</surname><given-names>D</given-names></name><name><surname>Jentsch</surname><given-names>S</given-names></name><etal/></person-group><year>1994</year><article-title>Evolutionary conservation of components of the protein translocation complex.</article-title><source>Nature</source><volume>367</volume><fpage>654</fpage><lpage>657</lpage><pub-id pub-id-type="pmid">8107851</p