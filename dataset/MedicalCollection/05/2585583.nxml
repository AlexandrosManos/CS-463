></name><article-title>Automated phylogenetic detection of recombination using a genetic algorithm</article-title><source>Molecular biology and evolution</source><year>2006</year><volume>23</volume><issue>10</issue><fpage>1891</fpage><lpage>1901</lpage><pub-id pub-id-type="doi">10.1093/molbev/msl051</pub-id><pub-id pub-id-type="pmid">16818476</pub-id></mixed-citation></ref><ref id="B28"><mixed-citation publication-type="journal"><name><surname>Tamura</surname><given-names>K</given-names></name><name><surname>Dudley</surname><given-names>J</given-names></name><name><surname>Nei</surname><given-names>M</given-names></name><name><surname>Kumar</surname><given-names>S</given-names></name><article-title>MEGA4: Molecular Evolutionary Genetics Analysis (MEGA) software version 4.0</article-title><source>Molecular biology and evolution</source><year>2007</year><volume>24</volume><issue>8</issue><fpage>1596</fpage><lpage>1599</lpage><pub-id pub-id-type="doi">10.1093/molbev/msm092</pub-id><pub-id pub-id-type="pmid">17488738</pub-id></mixed-citation></ref><ref id="B29"><mixed-citation publication-type="journal"><name><surname>Nei</surname><given-names>M</given-names></name><name><surname>Gojobori</surname><given-names>T</given-names></name><article-title>Simple methods for estimating the numbers of synonymous and nonsynonymous nucleotide substitutions</article-title><source> Mol Biol Evol</source><year>1986</year><volume>3</volume><issue>5</issue><fpage>418</fpage><lpage>426</lpage><pub-id pub-id-type="pmid">3444411</pub-id></mixed-citation></ref></ref-list></back></article>