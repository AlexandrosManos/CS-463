e><lpage>199</lpage><pub-id pub-id-type="pmid">6650564</pub-id><pub-id pub-id-type="doi">10.1002/ajmg.1320160209</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cohen</surname><given-names>MM</given-names><suffix>Jr</suffix></name></person-group><article-title>The demise of the Marshall syndrome. (Letter)</article-title><source>J Pediat</source><year>1974</year><volume>85</volume><fpage>878</fpage><pub-id pub-id-type="pmid">4420090</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ayme</surname><given-names>S</given-names></name><name><surname>Preus</surname><given-names>M</given-names></name></person-group><article-title>The Marshall and Stickler syndromes: objective rejection of lumping</article-title><source>J Med Genet</source><year>1984</year><volume>21</volume><fpage>34</fpage><lpage>38</lpage><pub-id pub-id-type="pmid">6694183</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Baraitser</surname><given-names>M</given-names></name></person-group><article-title>Marshall-Stickler syndrome</article-title><source>J Med Genet</source><year>1982</year><volume>19</volume><fpage>139</fpage><lpage>140</lpage><pub-id pub-id-type="pmid">7077624</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shprintzen</surname><given-names>RJ</given-names></name></person-group><article-title>Pierre Robin, micrognathia, and airway obstruction: the dependency of treatment on accurate diagnosis</article-title><source>Int Anesthesiol Clin</source><year>1988</year><volume>26</volume><fpage>64</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">3360502</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Elzen