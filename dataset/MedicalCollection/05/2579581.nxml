mid">11762491</pub-id></citation></ref><ref id="pone.0003732-Hanlon1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hanlon</surname><given-names>RT</given-names></name></person-group><year>1988</year><article-title>Behavioral and body patterning characters useful in taxonomy and field identification of Cephalopods.</article-title><source>Malacologia</source><volume>29</volume><fpage>247</fpage><lpage>266</lpage></citation></ref><ref id="pone.0003732-Roper1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roper</surname><given-names>CFE</given-names></name><name><surname>Hochberg</surname><given-names>FG</given-names></name></person-group><year>1988</year><article-title>Behavior and systematics of cephalopods from Lizard Island Australia based on color and body patterns.</article-title><source>Malacologia</source><volume>29</volume><fpage>153</fpage><lpage>194</lpage></citation></ref><ref id="pone.0003732-Huffard2"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huffard</surname><given-names>CL</given-names></name></person-group><year>2006</year><article-title>Locomotion by <italic>Abdopus aculeatus</italic> (Cephalopoda: Octopodidae): walking the line between primary and secondary defenses.</article-title><source>The Journal of Experimental Biology</source><volume>209</volume><fpage>3697</fpage><lpage>3707</lpage><pub-id pub-id-type="pmid">16985187</pub-id></citation></ref><ref id="pone.0003732-Hochberg1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hochberg</surname><given-names>FG</given-names></name><name><surname>Norman</surname><given-names>MD</given-names></name><name><surname>Finn</surname><given-names>J</given-names></name></person-group><year>2006</year><article-title><italic>Wunderpus photogenicus</italic> n. gen. and sp., a new Octopus from the shallow waters of the Indo-Malayan Archipelago (Cephalopoda: Octopodidae).</article-title><source>Molluscan Research</source><volume>26</volume><fpage>128</fpage><lpage>140</lpage></citation></ref><ref id="pone.0003732-Hanlon2"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hanlon</surname><given-names>RT</given-names></name><name><surname>Wolterding</surname><given-names>MR</given-names></name></person-group><year>1989</year><article-title>Behavior, body patterning, growth and life history of <italic>Octopus briareus</italic> cultured in the laboratory.</article-title><source>American Malacological Bulletin</source><volume>7</volume><fpage>21</fpage><lpage>46</lpage></citation></ref><ref id="pone.0003732-Tibbetts2"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tibbetts</surname><given-names>EA</given-names></name><name><surname>Dale</surname><given-names>J</given-names></name></person-group><year>2007</year><article-title>Individual recognition: it is good to be different.</article-title><source>Trends in Ecology &#x00026; Evolution</source><volume>22</volume><fpage>529</fpage><lpage>537</lpage><pub-id pub-id-type="pmid">17904686</pub-id></citation></ref><ref id="pone.0003732-Boal1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boal</surname><given-names>JG</given-names></name></person-group><year>2006</year><article-title>Social recognition: a top down view of cephalopod behavior.</article-title><source>Vie et Milieu</source><volume>56</volume><fpage>69</fpage><lpage>79</lpage></citation></ref><ref id="pone.0003732-Hochner1"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hochner</surname><given-names>B</given-names></name><name><surname>Shomrat</surname><given-names>T</given-names></name><name><surname>Fiorito</surname><given-names>G</given-names></name></person-group><year>2006</year><article-title>The octopus: a model for a comparative analysis of the evolution and memory mechanisms.</article-title><source>Biological Bulletin (Woods Hole)</source><volume>210</volume><fpage>308</fpage><lpage>317</lpage></citation></ref></ref-list><fn-group><fn fn-type="conflict"><p><bold>Competing Interests: </bold>The authors have declared that no competing interests exist.</p></fn><fn fn-type="financial-disclosure"><p><bold>Funding: </bold>Data collection was funded personally by the authors. No photographer was commissioned to take photographs for this paper; all photographs were pre-existing. The lead author was supported while writing this paper by the Monterey Bay Aquarium Research Institute, which had no role in study design, data collection and analysis, decision to publish, or preparation of the manuscript.</p></fn></fn-group></back></article>