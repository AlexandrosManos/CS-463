ge>3634</lpage><pub-id pub-id-type="pmid">15297508</pub-id><pub-id pub-id-type="doi">10.1128/JCM.42.8.3626-3634.2004</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Freitas</surname><given-names>DB</given-names></name><name><surname>Lima-Bittencourt</surname><given-names>CI</given-names></name><name><surname>Reis</surname><given-names>MP</given-names></name><name><surname>Costa</surname><given-names>PS</given-names></name><name><surname>Assis</surname><given-names>PS</given-names></name><name><surname>Chartone-Souza</surname><given-names>E</given-names></name><name><surname>Nascimento</surname><given-names>AMA</given-names></name></person-group><article-title>Molecular characterization of early colonizer bacteria from wastes in a steel plant</article-title><source>Lett Appl Microbiol</source><year>2008</year><volume>47</volume><fpage>241</fpage><lpage>249</lpage><pub-id pub-id-type="doi">10.1111/j.1472-765X.2008.02415.x</pub-id></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Smibert</surname><given-names>RM</given-names></name><name><surname>Krieg</surname><given-names>NR</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Gerhardt P, Murray RGE, Woods WA, Krieg NR</surname></name></person-group><article-title>Phenotypic characterization</article-title><source>Methods for General and Molecular Bacteriology</source><year>1994</year><publisher-name>American Society for Microbiology, Washington, DC</publisher-name><fpage>607</fpage><lpage>654</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dramsi</surname><given-names>S</given-names></name><name><surname>Biswas</surname><given-names>I</given-names></name><name><surname>Maguim</surname><given-names>E</given-names></name></person-group><article-title>Entry