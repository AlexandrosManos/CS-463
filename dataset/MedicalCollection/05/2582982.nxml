rson-group person-group-type="author"><name><surname>Green</surname><given-names>DE</given-names></name><name><surname>Converse</surname><given-names>KA</given-names></name><name><surname>Schrader</surname><given-names>AK</given-names></name></person-group><article-title>Epizootiology of sixty-four amphibian morbidity and mortality events in the USA, 1996&#x02013;2001</article-title><source>Ann N Y Acad Sci</source><year>2002</year><volume>969</volume><fpage>323</fpage><lpage>339</lpage><pub-id pub-id-type="pmid">12381613</pub-id></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Greer</surname><given-names>AL</given-names></name><name><surname>Berrill</surname><given-names>M</given-names></name><name><surname>Wilson</surname><given-names>PJ</given-names></name></person-group><article-title>Five amphibian mortality events associated with ranavirus infection in south central Ontario, Canada</article-title><source>Dis Aquat Org</source><year>2005</year><volume>67</volume><fpage>9</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">16385802</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hancock</surname><given-names>REW</given-names></name></person-group><article-title>Cationic peptides: effectors in innate immunity and novel antimicrobials</article-title><source>Lancet Infect Dis</source><year>2001</year><volume>1</volume><fpage>156</fpage><lpage>164</lpage><pub-id pub-id-type="pmid">11871492</pub-id></citation></ref><ref id="bib21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hedrick</surname><given-names>PW</given-names></name></person-group><article-title>Pathogen resistance and genetic variation at MHC loci</article-title><source>Evolution</source><year>2002</year><volume>56</volume><fpage>1902</fpage><lpage>1908</lpage><pub-id pub-id-type="pmid">12449477</pub-id></ci