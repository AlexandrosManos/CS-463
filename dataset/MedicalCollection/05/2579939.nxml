)<hr/></td><td valign="top" align="center" rowspan="1" colspan="1"><italic>TNC</italic><hr/></td><td valign="top" align="left" rowspan="1" colspan="1"><ext-link ext-link-type="uri" xlink:href="http://www.ncbi.nlm.nih.gov/entrez/viewer.fcgi?db=nuccore&#x00026;id=153946394">NM_002160</ext-link><hr/></td><td valign="top" align="center" rowspan="1" colspan="1">6.55<hr/></td></tr><tr><td colspan="4" valign="top" align="left" scope="col" rowspan="1"><bold>Developmental process</bold><hr/></td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1">keratin 13<hr/></td><td valign="top" align="center" rowspan="1" colspan="1"><italic>KRT13</italic><hr/></td><td valign="top" align="left" rowspan="1" colspan="1"><ext-link ext-link-type="uri" xlink:href="http://www.ncbi.nlm.nih.gov/entrez/viewer.fcgi?db=nuccore&#x00026;id=131412227">NM_002274</ext-link><hr/></td><td valign="top" align="center" rowspan="1" colspan="1">11.04<hr/></td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1">tumor necrosis factor receptor superfamily, member 19<hr/></td><td valign="top" align="center" rowspan="1" colspan="1"><italic>TNFRSF19</italic><hr/></td><td valign="top" align="left" rowspan="1" colspan="1"><ext-link ext-link-type="uri" xlink:href="http://www.ncbi.nlm.nih.gov/entrez/viewer.fcgi?db=nucest&#x00026;id=11444811">BF432648</ext-link><hr/></td><td valign="top" align="center" rowspan="1" colspan="1">7.72<hr/></td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1">secretogranin II (chromogranin C)<hr/></td><td valign="top" align="center" rowspan="1" colspan="1"><italic>SCG2</italic><hr/></td><td valign="top" align="left" rowspan="1" colspan="1"><ext-link ext-link-type="uri" xlink:href="http://www.ncbi.nlm.nih.gov/entrez/viewer.fcgi?db=nuccore&#x00026;id=68160946">NM_003469</ext-link><hr/></td><td valign="top" align="center" rowspan="1" colspan="1">6.02<hr/></td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" col