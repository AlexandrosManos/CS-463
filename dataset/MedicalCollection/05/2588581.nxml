olume>26</volume><fpage>444</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">11224894</pub-id><pub-id pub-id-type="doi">10.1097/00007632-200102150-00023</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>ST</given-names></name><name><surname>Lui</surname><given-names>TN</given-names></name><name><surname>Jeng</surname><given-names>CM</given-names></name></person-group><article-title>Spinal cord herniation after stabbing injury: case report</article-title><source>British Journal Of Neurosurgery</source><year>1997</year><volume>11</volume><fpage>84</fpage><lpage>86</lpage><pub-id pub-id-type="pmid">9156027</pub-id><pub-id pub-id-type="doi">10.1080/02688699746780</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rogers</surname><given-names>FB</given-names></name><name><surname>Osler</surname><given-names>TM</given-names></name><name><surname>Shackford</surname><given-names>SR</given-names></name><name><surname>Wald</surname><given-names>SL</given-names></name></person-group><article-title>Isolated stab wound to the artery of Adamkiewicz: case report and review of the literature</article-title><source>Journal of Trauma-Injury Infection &#x00026; Critical Care</source><year>1997</year><volume>43</volume><fpage>549</fpage><lpage>51</lpage><pub-id pub-id-type="doi">10.1097/00005373-199709000-00031</pub-id></citation></ref></ref-list></back></article>