n="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">FIL</td><td align="left" rowspan="1" colspan="1">0.0140&#x0002b;/&#x02212;0.0007</td><td align="left" rowspan="1" colspan="1">0.0204&#x0002b;/&#x02212;0.0004</td><td align="left" rowspan="1" colspan="1">0.0182&#x0002b;/&#x02212;0.0015</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">VIET</td><td align="left" rowspan="1" colspan="1">0.0065&#x0002b;/&#x02212;0.0009</td><td align="left" rowspan="1" colspan="1">0.0146&#x0002b;/&#x02212;0.0014</td><td align="left" rowspan="1" colspan="1">0.0106&#x0002b;/&#x02212;0.0002</td><td align="left" rowspan="1" colspan="1">0.0112&#x0002b;/&#x02212;0.0007</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspa