icle-title><source>Gynecol Oncol</source><year>2004</year><volume>92</volume><fpage>873</fpage><lpage>880</lpage><!--PubMed citation query: 'Gynecol Oncol||92|873||bib8|'--><pub-id pub-id-type="pmid">14984955</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jacobs</surname><given-names>MV</given-names></name><name><surname>Walboomers</surname><given-names>JM</given-names></name><name><surname>Snijders</surname><given-names>PJ</given-names></name><name><surname>Voorhorst</surname><given-names>FJ</given-names></name><name><surname>Verheijen</surname><given-names>RH</given-names></name><name><surname>Fransen-Daalmeijer</surname><given-names>N</given-names></name><name><surname>Meijer</surname><given-names>CJ</given-names></name></person-group><article-title>Distribution of 37 mucosotropic HPV types in women with cytologically normal cervical smears: the age-related patterns for high-risk and low-risk types</article-title><source>Int J Cancer</source><year>2000</year><volume>87</volume><fpage>221</fpage><lpage>227</lpage><!--PubMed citation query: 'Int J Cancer||87|221||bib9|'--><pub-id pub-id-type="pmid">10861478</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Josefsson</surname><given-names>A</given-names></name><name><surname>Livak</surname><given-names>K</given-names></name><name><surname>Gyllensten</surname><given-names>U</given-names></name></person-group><article-title>Detection and quantitation of human papillomavirus by using the fluorescent 5&#x02032; exonuclease assay</article-title><source>J Clin Microbiol</source><year>1999</year><volume>37</volume><fpage>490</fpage><lpage>496</lpage><!--PubMed citation query: 'J Clin Microbiol||37|490||bib10|'--><pub-id pub-id-type="pmid">9986801</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><