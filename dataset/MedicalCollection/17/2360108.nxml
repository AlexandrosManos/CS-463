ib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eisen</surname><given-names>MB</given-names></name><name><surname>Spellman</surname><given-names>PT</given-names></name><name><surname>Brown</surname><given-names>PO</given-names></name><name><surname>Bolstein</surname><given-names>D</given-names></name></person-group><article-title>Cluster analysis and dsiplay of genome-wide expression patterns</article-title><source>Proc Natl Acad Sci USA</source><year>1998</year><volume>95</volume><fpage>14863</fpage><lpage>14868</lpage><!--PubMed citation query: 'Proc Natl Acad Sci USA||95|14863||bib13|'--></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fingleton</surname><given-names>B</given-names></name><name><surname>Vargo-Gogola</surname><given-names>T</given-names></name><name><surname>Crawford</surname><given-names>HC</given-names></name><name><surname>Matrisian</surname><given-names>LM</given-names></name></person-group><article-title>Matrilysin [MMP-7] expression selects for cells with reduced sensitivity to apoptosis</article-title><source>Neoplasia</source><year>2001</year><volume>3</volume><fpage>459</fpage><lpage>468</lpage><!--PubMed citation query: 'Neoplasia||3|459||bib14|'--><pub-id pub-id-type="pmid">11774028</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Freije</surname><given-names>JM</given-names></name><name><surname>Diez-Itza</surname><given-names>I</given-names></name><name><surname>Balbin</surname><given-names>M</given-names></name><name><surname>Sanchez</surname><given-names>LM</given-names></name><name><surname>Blasco</surname><given-names>R</given-names></name><name><surname>Tolivia</surname><given-names>J</given-names></name><name><surname>Lopez-Otin</surname><given-names>C</given-names></name></person-group><article-title>Molecular cloning and expre