14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Franco</surname><given-names>EL</given-names></name><name><surname>Rohan</surname><given-names>TE</given-names></name><name><surname>Villa</surname><given-names>LL</given-names></name></person-group><article-title>Epidemiologic evidence and human papillomavirus infection as a necessary cause of cervical cancer</article-title><source>J Natl Cancer Inst</source><year>1999a</year><volume>91</volume><fpage>506</fpage><lpage>511</lpage><!--PubMed citation query: 'J Natl Cancer Inst||91|506||bib14|'--><pub-id pub-id-type="pmid">10088620</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Franco</surname><given-names>EL</given-names></name><name><surname>Villa</surname><given-names>L</given-names></name><name><surname>Sobrinho</surname><given-names>J</given-names></name><name><surname>Prado</surname><given-names>JM</given-names></name><name><surname>Rousseau</surname><given-names>MC</given-names></name><name><surname>Desy</surname><given-names>M</given-names></name><name><surname>Rohan</surname><given-names>TE</given-names></name></person-group><article-title>Epidemiology of acquisition and clearance of cervical human papillomavirus infection in women from a high-risk area for cervical cancer</article-title><source>J Infect Dis</source><year>1999b</year><volume>180</volume><fpage>1415</fpage><lpage>1423</lpage><!--PubMed citation query: 'J Infect Dis||180|1415||bib15|'--><pub-id pub-id-type="pmid">10515798</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldie</surname><given-names>SJ</given-names></name><name><surname>Kohli</surname><given-names>M</given-names></name><name><surname>Grima</surname><given-names>D</given-names></name><name><surname>Weinstein</surname><given-names>M</given-names></name><name><surname>Wright<