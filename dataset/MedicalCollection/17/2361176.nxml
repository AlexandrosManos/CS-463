me><surname>Schwartz</surname><given-names>GG</given-names></name></person-group><article-title>Geographic patterns of prostate cancer mortality. Evidence for a protective effect of ultraviolet radiation</article-title><source>Cancer</source><year>1992</year><volume>70</volume><fpage>2861</fpage><lpage>2869</lpage><!--PubMed citation query: 'Cancer||70|2861||bib16|'--><pub-id pub-id-type="pmid">1451068</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hayes</surname><given-names>RB</given-names></name><name><surname>Bogdanovicz</surname><given-names>JF</given-names></name><name><surname>Schroeder</surname><given-names>FH</given-names></name><name><surname>De Bruijn</surname><given-names>A</given-names></name><name><surname>Raatgever</surname><given-names>JW</given-names></name><name><surname>Van der Maas</surname><given-names>PJ</given-names></name><name><surname>Oishi</surname><given-names>K</given-names></name><name><surname>Yoshida</surname><given-names>O</given-names></name></person-group><article-title>Serum retinol and prostate cancer</article-title><source>Cancer</source><year>1988</year><volume>62</volume><fpage>2021</fpage><lpage>2026</lpage><!--PubMed citation query: 'Cancer||62|2021||bib17|'--><pub-id pub-id-type="pmid">3167814</pub-id></citation></ref><ref id="bib18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hsieh</surname><given-names>TC</given-names></name><name><surname>Xu</surname><given-names>W</given-names></name><name><surname>Chiao</surname><given-names>JW</given-names></name></person-group><article-title>Growth regulation and cellular changes during differentiation of human prostatic cancer LNCaP cells as induced by T lymphocyte-conditioned medium</article-title><source>Expt Cell Res</source><year>1995</year><volume>218</volume><fpage>137</fpage><lpage>143</lpage><!--PubMed citation query: 'Expt Cell Res||218|137||bib1