plement>Suppl 4</supplement><fpage>145</fpage><lpage>149</lpage><!--PubMed citation query: 'Ann Oncol||10|145||bib14|'--><pub-id pub-id-type="pmid">10436809</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lay</surname><given-names>MJ</given-names></name><name><surname>Wittwer</surname><given-names>CT</given-names></name></person-group><article-title>Real-time fluorescence genotyping of factor V Leiden during rapid-cycle PCR</article-title><source>Clin Chem</source><year>1997</year><volume>43</volume><supplement>12</supplement><fpage>2262</fpage><lpage>2267</lpage><!--PubMed citation query: 'Clin Chem||43|2262||bib15|'--><pub-id pub-id-type="pmid">9439442</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>D</given-names></name><name><surname>Xie</surname><given-names>K</given-names></name><name><surname>Wolff</surname><given-names>R</given-names></name><name><surname>Abbruzzese</surname><given-names>JL</given-names></name></person-group><article-title>Pancreatic cancer</article-title><source>Lancet</source><year>2004</year><volume>363</volume><supplement>9414</supplement><fpage>1049</fpage><lpage>1057</lpage><!--PubMed citation query: 'Lancet||363|1049||bib16|'--><pub-id pub-id-type="pmid">15051286</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lyon</surname><given-names>E</given-names></name></person-group><article-title>Mutation detection using fluorescent hybridization probes and melting curve analysis</article-title><source>Expert Rev Mol Diagn</source><year>2001</year><volume>1</volume><supplement>1</supplement><fpage>92</fpage><lpage>101</lpage><!--PubMed citation query: 'Expert Rev Mol Diagn||1|92||bib17|'--><pub-id pub-id-type="pmid">11901805</pub-id></citation></ref><ref id="bib18"><citation