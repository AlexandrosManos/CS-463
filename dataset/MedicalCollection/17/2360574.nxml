"50">0.9</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">69 cases</td><td align="center" valign="top" charoff="50">22 cases</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Mixed</td><td align="center" valign="top" charoff="50">12</td><td align="center" valign="top" charoff="50">82</td><td align="center" valign="top" charoff="50">428&#x0002a;12&#x00025;</td><td align="center" valign="top" charoff="50">51&#x0002a;82&#x00025;</td><td align="center" valign="top" charoff="50">1.8</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">51 cases</td><td align="center" valign="top" charoff="50">42 cases</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Other</td><td align="center" valign="top" charoff="50">14</td><td align="center" valign="top" charoff="50">No data:<break/>Assume&#x0003d;0</td><td align="center" valign="top" charoff="50">428&#x0002a;14&#x00025;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x02014;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">60 cases</td><td align="center" valign="top" charoff="50">0 cases</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Total</td><td align="center" valign="top" charoff="50">100</td><td align="center" valign="top" charoff="50">&#x02014;</td><td align="center" valign="top" charoff="50">428 cases</td><td align="center" valign="top" charoff="50">114 cases</td><td align="center" valign="top" charoff="50">4.9</td></tr></tbody></table></table-wrap></floats-wrap></article>