td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">5&#x02032;-GGATGGAACTTTCAGATATCAACAAGCTTCTTGATATCTGAAAGTTCC-3&#x02032;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">PKC <italic>&#x003b6;</italic></td><td align="left" valign="top" charoff="50">5&#x02032;-TACACTCCTGCTTCCAGAGAAGCTTGTCTGGAAGCAGGAGTGTA-3&#x02032;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">5&#x02032;-GGATTACACTCCTGCTTCCAGACAAGCTTCTCTGGAAGCAGGAGTGTA-3&#x02032;</td></tr></tbody></table></table-wrap></floats-wrap></article>