<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:mml="http://www.w3.org/1998/Math/MathML" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Diagn Ther Endosc</journal-id><journal-title>Diagnostic and Therapeutic Endoscopy</journal-title><issn pub-type="ppub">1070-3608</issn><issn pub-type="epub">1029-0516</issn><publisher><publisher-name>Hindawi Publishing Corporation</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">18493427</article-id><article-id pub-id-type="pmc">2362558</article-id>        <article-id pub-id-type="pii">S1070360896000367</article-id>        <article-id pub-id-type="doi">10.1155/DTE.3.121</article-id>    <article-categories><subj-group subj-group-type="heading"><subject>Research Article</subject></subj-group></article-categories><title-group><article-title>Laparoscopic Assisted Vaginal Hysterectomy, Setting Up a Service at a Peripheral Teaching Hospital</article-title></title-group><contrib-group>        <contrib contrib-type="author" corresp="yes"><name><surname>Tsaltas</surname><given-names>Jim</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff2">2</xref></contrib>        <contrib contrib-type="author"><name><surname>Kovacs</surname><given-names>Gab</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib>        <contrib contrib-type="author"><name><surname>Dennis</surname><given-names>Jenny</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib>        <contrib contrib-type="author"><name><surname>Pratt</surname><given-names>Amanda</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib>    </contrib-group>        <aff id="aff1"><label>1</label>            <addr-line>Department of Obstetrics and Gynaecology</addr-line>            <addr-line>Monash University</addr-line>            <addr-line>Monash Medical Centre and Box Hill Hospital</addr-line>            <addr-line>Melbourne</addr-line>            <country>Australia</country>        </aff>        <aff id="aff2"><label>2</label>            <addr-line>Department of O &#x00026; G.</addr-line>            <addr-line>Monash Medical Centre</addr-line>            <addr-line>246 Clayton Road</addr-line>            <addr-line>Clayton</addr-line>            <addr-line>3168</addr-line>            <country>Australia</country>        </aff>    <pub-date pub-type="ppub"><year>1996</year></pub-date><volume>3</volume><issue>2</issue><fpage>121</fpage><lpage>124</lpage><history><date date-type="received"><day>9</day><month>8</month><year>1995</year></date><date date-type="rev-recd"><day>8</day><month>5</month><year>1996</year></date><date date-type="accepted"><day>24</day><month>6</month><year>1996</year></date></history><permissions><copyright-statement>Copyright &#x000a9; 1996 Hindawi Publishing Corporation.</copyright-statement><copyright-year>1996</copyright-year><copyright-holder>Hindawi Publishing Corporation</copyright-holder><license license-type="open-access" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://creativecommons.org/licenses/by/"><p>This is an open access article distributed under the Creative Commons Attribution License, which permits unrestricted use, distribution, and reproduction in any medium, provided the original work is properly cited.</p></license></permissions><abstract>        <p>The establishment of a laparoscopically assisted hysterectomy program at Box HillHospital is described. The first eight cases have been reviewed and recommendations aremade to other gynaecology units who wish to establish a minimally invasive gynaecologicalsurgery unit.</p>    </abstract></article-meta></front></article>