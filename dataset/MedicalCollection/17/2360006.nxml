</volume><fpage>3225</fpage><lpage>3229</lpage><!--PubMed citation query: 'Cancer Res||61|3225||bib10|'--><pub-id pub-id-type="pmid">11309270</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Feinberg</surname><given-names>AP</given-names></name><name><surname>Gehrke</surname><given-names>CW</given-names></name><name><surname>Kuo</surname><given-names>KC</given-names></name><name><surname>Ehrlich</surname><given-names>M</given-names></name></person-group><article-title>Reduced genomic 5-methylcitosine content in human neoplasia</article-title><source>Cancer Res</source><year>1988</year><volume>48</volume><fpage>1159</fpage><lpage>1161</lpage><!--PubMed citation query: 'Cancer Res||48|1159||bib11|'--><pub-id pub-id-type="pmid">3342396</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fleisher</surname><given-names>AS</given-names></name><name><surname>Esteller</surname><given-names>M</given-names></name><name><surname>Wang</surname><given-names>S</given-names></name><name><surname>Tamura</surname><given-names>G</given-names></name><name><surname>Suzuki</surname><given-names>H</given-names></name><name><surname>Yin</surname><given-names>J</given-names></name><name><surname>Zou</surname><given-names>TT</given-names></name><name><surname>Abraham</surname><given-names>JM</given-names></name><name><surname>Kong</surname><given-names>D</given-names></name><name><surname>Smolinski</surname><given-names>KN</given-names></name><name><surname>Shi</surname><given-names>YQ</given-names></name><name><surname>Ryu</surname><given-names>MG</given-names></name><name><surname>Powell</surname><given-names>SM</given-names></name><name><surname>James</surname><given-names>SP</given-names></name><name><surname>Wilson</surname><given-names>KT</given-names></name><name><surname>Herman</surname><given-names>JG</given-names></name><n