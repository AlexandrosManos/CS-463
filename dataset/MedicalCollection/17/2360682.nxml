nd cyclin A</article-title><source>Virology</source><year>1992</year><volume>186</volume><fpage>15</fpage><lpage>24</lpage><!--PubMed citation query: 'Virology||186|15||bib16|'--><pub-id pub-id-type="pmid">1530776</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Howe</surname><given-names>JA</given-names></name><name><surname>Mymryk</surname><given-names>JS</given-names></name><name><surname>Egan</surname><given-names>C</given-names></name><name><surname>Branton</surname><given-names>PE</given-names></name><name><surname>Bayley</surname><given-names>ST</given-names></name></person-group><article-title>Retinoblastoma growth suppressor and a 300-kDa protein appear to regulate cellular DNA synthesis</article-title><source>Proc Natl Acad Sci USA</source><year>1990</year><volume>87</volume><fpage>5883</fpage><lpage>5887</lpage><!--PubMed citation query: 'Proc Natl Acad Sci USA||87|5883||bib17|'--></citation></ref><ref id="bib18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Iyer</surname><given-names>NG</given-names></name><name><surname>Ozdag</surname><given-names>H</given-names></name><name><surname>Caldas</surname><given-names>C</given-names></name></person-group><article-title>p300&#x0002f;CBP and cancer</article-title><source>Oncogene</source><year>2004</year><volume>23</volume><fpage>4225</fpage><lpage>4231</lpage><!--PubMed citation query: 'Oncogene||23|4225||bib18|'--><pub-id pub-id-type="pmid">15156177</pub-id></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Madison</surname><given-names>DL</given-names></name><name><surname>Yaciuk</surname><given-names>P</given-names></name><name><surname>Kwok</surname><given-names>RP</given-names></name><name><surname>Lundblad</surname><given-names>JR</given-names></name></person-group><article-title>Acetylation of the adenovirus-