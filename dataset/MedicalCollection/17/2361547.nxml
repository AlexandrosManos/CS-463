thor"><name><surname>Laake</surname><given-names>K</given-names></name><name><surname>Jansen</surname><given-names>L</given-names></name><name><surname>Hahnemann</surname><given-names>JM</given-names></name><name><surname>Brondum-Nielsen</surname><given-names>K</given-names></name><name><surname>Lonnqvist</surname><given-names>T</given-names></name><name><surname>Kaariainen</surname><given-names>H</given-names></name><name><surname>Ladhesmaki</surname><given-names>A</given-names></name><name><surname>Yuen</surname><given-names>J</given-names></name><name><surname>Tretli</surname><given-names>S</given-names></name><name><surname>Heiberg</surname><given-names>A</given-names></name><name><surname>Olsen</surname><given-names>jh</given-names></name><name><surname>Tucker</surname><given-names>M</given-names></name><name><surname>Kleinermann</surname><given-names>R</given-names></name><name><surname>Borresen-Dale</surname><given-names>AL</given-names></name></person-group><article-title>Characterization of ATM mutations in 41 Nordic families with ataxia telangiectasia</article-title><source>Hum Mutat</source><year>2000</year><volume>16</volume><fpage>232</fpage><lpage>246</lpage><!--PubMed citation query: 'Hum Mutat||16|232||bib12|'--><pub-id pub-id-type="pmid">10980530</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Olsen</surname><given-names>JH</given-names></name><name><surname>Garwicz</surname><given-names>S</given-names></name><name><surname>Hertz</surname><given-names>H</given-names></name><name><surname>Jonmundsson</surname><given-names>G</given-names></name><name><surname>Landmark</surname><given-names>F</given-names></name><name><surname>Lanning</surname><given-names>M</given-names></name><name><surname>Lie</surname><given-names>SO</given-names></name><name><surname>Moe</surname><given-names>PJ</given-names></name><name><surname>Moller</surname><given-names>T</given-names></name><name><surname>Sankila</surname><given-names>R</given-names></name><name><surname>Tulinius</surname><given-names>H</given-names></name></person-group><article-title>Second malignant neoplasms after cancer in childhood or adolescence</article-title><source>Br Med J</source><year>1993</year><volume>307</volume><fpage>1030</fpage><lpage>1036</lpage><!--PubMed citation query: 'Br Med J||307|1030||bib13|'--></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Olsen</surname><given-names>JH</given-names></name><name><surname>Hahnemann</surname><given-names>JM</given-names></name><name><surname>Borresen-Dale</surname><given-names>A-L</given-names></name><name><surname>Brondum-Nielsen</surname><given-names>K</given-names></name><name><surname>Hammarstrom</surname><given-names>L</given-names></name><name><surname>Kaariainen</surname><given-names>H</given-names></name><name><surname>Lonnqvist</surname><given-names>T</given-names></name><name><surname>Sankila</surname><given-names>R</given-names></name><name><surname>Seersholm</surname><given-names>N</given-names></name><name><surname>Tretli</surname><given-names>S</given-names></name><name><surname>Yuen</surname><given-names>J</given-names></name><name><surname>Boice</surname><given-names>JD</given-names><suffix>Jr</suffix></name><name><surname>Tucker</surname><given-names>M</given-names></name></person-group><article-title>Cancer in patients with ataxia-telangiectasia and in their relatives in the Nordic countries</article-title><source>J Natl Cancer Inst</source><year>2001</year><volume>93</volume><fpage>121</fpage><lpage>127</lpage><!--PubMed citation query: 'J Natl Cancer Inst||93|121||bib14|'--><pub-id pub-id-type="pmid">11208881</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Robsahm</surname><given-names>TE</given-names></name><name><surname>Tretli</surname><given-names>