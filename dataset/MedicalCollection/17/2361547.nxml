person-group-type="author"><name><surname>Cha</surname><given-names>D</given-names></name><name><surname>Khosrotehrani</surname><given-names>K</given-names></name><name><surname>Kim</surname><given-names>Y</given-names></name><name><surname>Stroh</surname><given-names>H</given-names></name><name><surname>Bianchi</surname><given-names>DW</given-names></name><name><surname>Johnson</surname><given-names>KL</given-names></name></person-group><article-title>Cervical cancer and michrochimerism</article-title><source>Obstet Gynecol</source><year>2003</year><volume>102</volume><fpage>774</fpage><lpage>781</lpage><!--PubMed citation query: 'Obstet Gynecol||102|774||bib5|'--><pub-id pub-id-type="pmid">14551008</pub-id></citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Easton</surname><given-names>DF.</given-names></name></person-group><article-title>Cancer risks in A-T heterozygotes</article-title><source>Int J Radiat Biol</source><year>1994</year><volume>66</volume><supplement>Suppl 6</supplement><fpage>S177</fpage><lpage>S182</lpage><!--PubMed citation query: 'Int J Radiat Biol||66|S177||bib6|'--><pub-id pub-id-type="pmid">7836845</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ewertz</surname><given-names>M</given-names></name><name><surname>Duffy</surname><given-names>SW</given-names></name><name><surname>Adami</surname><given-names>HO</given-names></name><name><surname>Kvale</surname><given-names>G</given-names></name><name><surname>Lund</surname><given-names>E</given-names></name><name><surname>Meirik</surname><given-names>O</given-names></name></person-group><article-title>Age at first birth, parity and risk of breast cancer: a meta-analysis of 8 studies from the Nordic countries</article-title><source>Int J Cancer</source><year>1990</year><volume>46</volume><fpage>597</fpage><lpage>603</lpage><!--PubMed citation query