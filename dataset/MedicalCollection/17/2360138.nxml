n citation-type="book"><person-group person-group-type="author"><collab>National Audit Office (NAO)</collab></person-group><article-title/><source>Tackling Cancer in England: Saving More Lives</source><year>2004</year><publisher-name>London</publisher-name></citation></ref><ref id="bib24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Newcomb</surname><given-names>P</given-names></name><name><surname>Carbone</surname><given-names>P</given-names></name></person-group><article-title>Cancer treatment and age: patient perspectives</article-title><source>J Natl Cancer Inst</source><year>1993</year><volume>85</volume><fpage>1580</fpage><lpage>1584</lpage><!--PubMed citation query: 'J Natl Cancer Inst||85|1580||bib24|'--><pub-id pub-id-type="pmid">8411231</pub-id></citation></ref><ref id="bib25"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Norman</surname><given-names>GR</given-names></name><name><surname>Streiner</surname><given-names>DL</given-names></name></person-group><article-title/><source>Biostatistics: The Bare Essentials</source><year>2000</year><publisher-name>BC Decker: Hamilton, Ontario</publisher-name>(2nd edn)</citation></ref><ref id="bib26"><citation citation-type="book"><person-group person-group-type="author"><collab>North West Breast Group (NWBG)</collab></person-group><article-title/><source>Breast Cancer Management Guidelines</source><year>1999</year><publisher-name>North West Breast Group</publisher-name></citation></ref><ref id="bib27"><citation citation-type="book"><person-group person-group-type="author"><collab>Office of National Statistics (ONS)</collab></person-group><article-title/><source>Cancer statistics registrations: registrations of cancer diagnosed in England in 1999, Series MB1, No. 30</source><year>2002</year><publisher-name>London: Office of National Statistics</publisher-name></citation></ref><ref id="bib28"><citation citation-type="other"><person-gr