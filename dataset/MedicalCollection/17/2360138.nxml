erson-group person-group-type="author"><name><surname>Gardner</surname><given-names>SB</given-names></name><name><surname>Winter</surname><given-names>PD</given-names></name><name><surname>Gardner</surname><given-names>MJ</given-names></name></person-group><article-title>Confidence Interval Analysis (CIA version 1.2)</article-title><source>Gardner SB &#x00026; BMJ</source><year>1992</year></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gennari</surname><given-names>R</given-names></name><name><surname>Curigliano</surname><given-names>G</given-names></name><name><surname>Rotmensz</surname><given-names>N</given-names></name><name><surname>Robertson</surname><given-names>C</given-names></name><name><surname>Colleoni</surname><given-names>M</given-names></name><name><surname>Zurrida</surname><given-names>S</given-names></name></person-group><article-title>Breast carcinoma in elderly women: features of disease presentation, choice of local and systemic treatments compared with younger postmenopausal patients</article-title><source>Cancer</source><year>2004</year><volume>101</volume><fpage>1302</fpage><lpage>1310</lpage><!--PubMed citation query: 'Cancer||101|1302||bib13|'--><pub-id pub-id-type="pmid">15316944</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giordano</surname><given-names>SH</given-names></name><name><surname>Hortobagyi</surname><given-names>GN</given-names></name><name><surname>Kau</surname><given-names>S-WC</given-names></name><name><surname>Theriault</surname><given-names>RL</given-names></name><name><surname>Bondy</surname><given-names>ML</given-names></name></person-group><article-title>Breast cancer treatment guidelines in older women</article-title><source>J Clin Oncol</source><year>2005</year><volume>23</volume><fpage>783</fpage><lpage>791</lpage><!--PubMed citation query: 'J Clin Oncol||23|78