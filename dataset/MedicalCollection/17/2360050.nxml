urnal"><person-group person-group-type="author"><name><surname>Chan</surname><given-names>KC</given-names></name><name><surname>Knox</surname><given-names>WF</given-names></name><name><surname>Gee</surname><given-names>JM</given-names></name><name><surname>Morris</surname><given-names>J</given-names></name><name><surname>Nicholson</surname><given-names>RI</given-names></name><name><surname>Potten</surname><given-names>CS</given-names></name><name><surname>Bundred</surname><given-names>NJ</given-names></name></person-group><article-title>Effect of epidermal growth factor receptor tyrosine kinase inhibition on epithelial proliferation in normal and premalignant breast</article-title><source>Cancer Res</source><year>2002</year><volume>62</volume><fpage>122</fpage><lpage>128</lpage><!--PubMed citation query: 'Cancer Res||62|122||bib7|'--><pub-id pub-id-type="pmid">11782368</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cheng</surname><given-names>HF</given-names></name><name><surname>Wang</surname><given-names>CJ</given-names></name><name><surname>Moeckel</surname><given-names>GW</given-names></name><name><surname>Zhang</surname><given-names>MZ</given-names></name><name><surname>McKanna</surname><given-names>JA</given-names></name><name><surname>Harris</surname><given-names>RC</given-names></name></person-group><article-title>Cyclooxygenase-2 inhibitor blocks expression of mediators of renal injury in a model of diabetes and hypertension</article-title><source>Kidney Int</source><year>2002</year><volume>62</volume><fpage>929</fpage><lpage>939</lpage><!--PubMed citation query: 'Kidney Int||62|929||bib8|'--><pub-id pub-id-type="pmid">12164875</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Connolly</surname><given-names>EM</given-names></name><name><surname>Harmey</surname><given-names>JH</given-names></name><