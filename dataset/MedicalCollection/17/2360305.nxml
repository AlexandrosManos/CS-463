</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oosterlinck</surname><given-names>W</given-names></name><name><surname>Solsona</surname><given-names>E</given-names></name><name><surname>Akaza</surname><given-names>H</given-names></name><name><surname>Busch</surname><given-names>C</given-names></name><name><surname>Goebell</surname><given-names>PJ</given-names></name><name><surname>Malmstrom</surname><given-names>PU</given-names></name><name><surname>Ozen</surname><given-names>H</given-names></name><name><surname>Sved</surname><given-names>P</given-names></name></person-group><article-title>Low-grade Ta (noninvasive) urothelial carcinoma of the bladder</article-title><source>Urology</source><year>2005</year><volume>66</volume><fpage>75</fpage><lpage>89</lpage><!--PubMed citation query: 'Urology||66|75||bib15|'--><pub-id pub-id-type="pmid">16399417</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Paiss</surname><given-names>T</given-names></name><name><surname>Wohr</surname><given-names>G</given-names></name><name><surname>Hautmann</surname><given-names>RE</given-names></name><name><surname>Mattfeldt</surname><given-names>T</given-names></name><name><surname>Muller</surname><given-names>M</given-names></name><name><surname>Haeussler</surname><given-names>J</given-names></name><name><surname>Vogel</surname><given-names>W</given-names></name></person-group><article-title>Some tumors of the bladder are polyclonal in origin</article-title><source>J Urol</source><year>2002</year><volume>167</volume><fpage>718</fpage><lpage>723</lpage><!--PubMed citation query: 'J Urol||167|718||bib16|'--><pub-id pub-id-type="pmid">11792960</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Primdahl</surname><given-names>H</given-names></name><name>