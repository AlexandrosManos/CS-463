urce>Biochem Biophys Res Commun</source><year>2002</year><volume>293</volume><fpage>670</fpage><lpage>674</lpage><!--PubMed citation query: 'Biochem Biophys Res Commun||293|670||bib17|'--><pub-id pub-id-type="pmid">12054520</pub-id></citation></ref><ref id="bib18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Legg</surname><given-names>J</given-names></name><name><surname>Jensen</surname><given-names>UB</given-names></name><name><surname>Broad</surname><given-names>S</given-names></name><name><surname>Leigh</surname><given-names>I</given-names></name><name><surname>Watt</surname><given-names>FM</given-names></name></person-group><article-title>Role of melanoma chondroitin sulphate proteoglycan in patterning stem cells in human interfollicular epidermis</article-title><source>Development</source><year>2003</year><volume>130</volume><fpage>6049</fpage><lpage>6063</lpage><!--PubMed citation query: 'Development||130|6049||bib18|'--><pub-id pub-id-type="pmid">14573520</pub-id></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>Y</given-names></name><name><surname>Lyle</surname><given-names>S</given-names></name><name><surname>Yang</surname><given-names>Z</given-names></name><name><surname>Cotsarelis</surname><given-names>G</given-names></name></person-group><article-title>Keratin 15 promoter targets putative epithelial stem cells in the hair follicle bulge</article-title><source>J Invest Dermatol</source><year>2003</year><volume>121</volume><fpage>963</fpage><lpage>968</lpage><!--PubMed citation query: 'J Invest Dermatol||121|963||bib19|'--><pub-id pub-id-type="pmid">14708593</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morris</surname><given-names>RJ</given-names></name><name><surname>Liu</surname><given-names>Y</given-names></name><name><surname>