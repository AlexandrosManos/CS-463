<year>1993</year><volume>53</volume><fpage>651</fpage><lpage>656</lpage><!--PubMed citation query: 'Int J Cancer||53|651||bib39|'--><pub-id pub-id-type="pmid">8436439</pub-id></citation></ref><ref id="bib40"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>R&#x000f6;sel</surname><given-names>M</given-names></name><name><surname>Claas</surname><given-names>C</given-names></name><name><surname>Seiter</surname><given-names>S</given-names></name><name><surname>Herlevsen</surname><given-names>M</given-names></name><name><surname>Z&#x000f6;ller</surname><given-names>M</given-names></name></person-group><article-title>Cloning and functional characterization of a new phosphatidyl-inositol anchored molecule of a metastasizing rat pancreatic tumor</article-title><source>Oncogene</source><year>1998</year><volume>17</volume><fpage>1989</fpage><lpage>2002</lpage><!--PubMed citation query: 'Oncogene||17|1989||bib40|'--><pub-id pub-id-type="pmid">9788443</pub-id></citation></ref><ref id="bib41"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schoeppner</surname><given-names>HL</given-names></name><name><surname>Raz</surname><given-names>A</given-names></name><name><surname>Ho</surname><given-names>SB</given-names></name><name><surname>Bresalier</surname><given-names>RS</given-names></name></person-group><article-title>Expression of an endogenous galactose-binding lectin correlates with neoplastic progression in the colon</article-title><source>Cancer</source><year>1995</year><volume>75</volume><fpage>2818</fpage><lpage>2826</lpage><!--PubMed citation query: 'Cancer||75|2818||bib41|'--><pub-id pub-id-type="pmid">7773932</pub-id></citation></ref><ref id="bib42"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Seiter</surname><given-names>S</given-names></name><name><surname>Stassar</surname><given-names>M</given-names></name><name><surname>Rappl</surname><given-names>G</given-names></name><name><surname>Reinhold</surname><given-names>U</given-names></name><name><surname>Tilgen</surname><given-names>W</given-names></name><name><surname>Zoller</surname><given-names>M</given-names></name></person-group><article-title>Upregulation of C4.4A expression during progression of melanoma</article-title><source>J Invest Dermatol</source><year>2001</year><volume>116</volume><fpage>344</fpage><lpage>347</lpage><!--PubMed citation query: 'J Invest Dermatol||116|344||bib42|'--><pub-id pub-id-type="pmid">11180013</pub-id></citation></ref><ref id="bib43"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sela</surname><given-names>BA</given-names></name><name><surname>Steplewski</surname><given-names>Z</given-names></name><name><surname>Koprowski</surname><given-names>H</given-names></name></person-group><article-title>Colon carcinoma-associated glycoproteins recognized by monoclonal antibodies CO-029 and GA22-2</article-title><source>Hybridoma</source><year>1989</year><volume>8</volume><fpage>481</fpage><lpage>491</lpage><!--PubMed citation query: 'Hybridoma||8|481||bib43|'--><pub-id pub-id-type="pmid">2777278</pub-id></citation></ref><ref id="bib44"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sidenius</surname><given-names>N</given-names></name><name><surname>Andolfo</surname><given-names>A</given-names></name><name><surname>Fesce</surname><given-names>R</given-names></name><name><surname>Blasi</surname><given-names>F</given-names></name></person-group><article-title>Urokinase regulates vitronectin binding by controlling urokinase receptor oligomerization</article-title><source>J Biol Chem</source><year>2002</year><volume>277</volume><fpage>27982</fpage><lpage>27990</lpage><!--PubMed citation query: 'J Biol Chem||277|27982||bib44|'--><pub-id pub-id-type="pmid">12034711</pub-id></citation></ref><ref id="bib45"><citation citation-type="journal"><person-gro