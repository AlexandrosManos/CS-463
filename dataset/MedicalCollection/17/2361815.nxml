<td align="char" valign="top" char="(" charoff="50">69.5 (39&#x02013;81)</td><td align="char" valign="top" char="." charoff="50">4</td><td align="char" valign="top" char="." charoff="50">6</td></tr></tbody></table><table-wrap-foot><fn id="tbfnote6"><label>a</label><p>According to microsatellite analysis.</p></fn></table-wrap-foot></table-wrap><table-wrap id="tbl3" position="float"><label>Table 3</label><caption><p content-type="table-title">Genes used for the classification of microsatellite status</p></caption><table frame="hsides" rules="groups" border="1" width="85%"><colgroup><col align="left"/><col align="left"/><col align="left"/><col align="char" char="&#x000b1;"/><col align="char" char="&#x000b1;"/></colgroup><thead valign="bottom"><tr><th align="left" valign="top" charoff="50">&#x000a0;</th><th align="left" valign="top" charoff="50">&#x000a0;</th><th align="left" valign="top" charoff="50">&#x000a0;</th><th colspan="2" align="center" valign="top" char="&#x000b1;" charoff="50"><bold>Array signal<sup>a</sup></bold><hr/></th></tr><tr><th align="left" valign="top" charoff="50"><bold>Genechip probe ID</bold></th><th align="left" valign="top" charoff="50"><bold>Gene name</bold></th><th align="left" valign="top" charoff="50"><bold>Gene symbol</bold></th><th align="char" valign="top" char="&#x000b1;" charoff="50"><bold>Microsatellite stable tumours</bold></th><th align="char" valign="top" char="&#x000b1;" charoff="50"><bold>Microsatellite unstable tumours</bold></th></tr></thead><tbody valign="top"><tr><td align="left" valign="top" charoff="50">202072</td><td align="left" valign="top" charoff="50">Heterogeneous nuclear ribonucleoprotein L</td><td align="left" valign="top" charoff="50">HNRPL</td><td align="char" valign="top" char="&#x000b1;" charoff="50">208&#x000b1;73</td><td align="char" valign="top" char="&#x000b1;" charoff="50">776&#x000b1;340</td></tr><tr><td align="left" valign="top" charoff="50">203444</td><td align="left" valign="top" charoff="50">Metastasis-