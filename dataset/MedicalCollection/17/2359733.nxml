on citation-type="other"><person-group person-group-type="author"><collab>EQUATOR Network</collab></person-group><article-title>Enhancing the QUAlity and Transparency Of health Research</article-title><ext-link ext-link-type="uri" xlink:href="http://www.equator-network.org"/><comment>Accessed 20 February 2008</comment></citation></ref></ref-list></back></article>