><article-title>The genetics of hereditary melanoma and nevi. 1998 update</article-title><source>Cancer</source><year>1999</year><volume>86</volume><fpage>2464</fpage><lpage>2477</lpage><!--PubMed citation query: 'Cancer||86|2464||bib11|'--><pub-id pub-id-type="pmid">10630172</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harland</surname><given-names>M</given-names></name><name><surname>Meloni</surname><given-names>R</given-names></name><name><surname>Gruis</surname><given-names>N</given-names></name><name><surname>Pinney</surname><given-names>E</given-names></name><name><surname>Brookes</surname><given-names>S</given-names></name><name><surname>Spurr</surname><given-names>NK</given-names></name><name><surname>Frischauf</surname><given-names>AM</given-names></name><name><surname>Bataille</surname><given-names>V</given-names></name><name><surname>Peters</surname><given-names>G</given-names></name><name><surname>Cuzick</surname><given-names>J</given-names></name><name><surname>Selby</surname><given-names>P</given-names></name><name><surname>Bishop</surname><given-names>DT</given-names></name><name><surname>Bishop</surname><given-names>JN</given-names></name></person-group><article-title>Germline mutations of the CDK2 gene in UK melanoma families</article-title><source>Hum Mol Genet</source><year>1997</year><volume>6</volume><fpage>2061</fpage><lpage>2067</lpage><!--PubMed citation query: 'Hum Mol Genet||6|2061||bib12|'--><pub-id pub-id-type="pmid">9328469</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hemminki</surname><given-names>K</given-names></name><name><surname>Zhang</surname><given-names>H</given-names></name><name><surname>Czene</surname><given-names>K</given-names></name></person-group><article-title>Familial and attributable risks in cutaneous melanoma: effects of proband and age</article-ti