me><fpage>89</fpage><lpage>95</lpage><!--PubMed citation query: 'J Photochem Photobiol B||42|89||bib9|'--><pub-id pub-id-type="pmid">9540214</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Khanum</surname><given-names>F</given-names></name><name><surname>Jain</surname><given-names>V</given-names></name></person-group><article-title>Cellular accumulation and biological activity of hematoporphyrin derivative(L) in comparison with photofrin II</article-title><source>Indian J Exp Biol</source><year>1997</year><volume>35</volume><fpage>348</fpage><lpage>355</lpage><!--PubMed citation query: 'Indian J Exp Biol||35|348||bib10|'--><pub-id pub-id-type="pmid">9315233</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>MacDonald</surname><given-names>IJ</given-names></name><name><surname>Dougherty</surname><given-names>TJJ</given-names></name></person-group><article-title>Basic principals of photodynamic therapy</article-title><source>Porphyrins Phthalocyanines</source><year>2001</year><volume>5</volume><fpage>105</fpage><lpage>129</lpage><!--PubMed citation query: 'Porphyrins Phthalocyanines||5|105||bib11|'--></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mitchell</surname><given-names>JB</given-names></name><name><surname>McPherson</surname><given-names>S</given-names></name><name><surname>DeGraff</surname><given-names>W</given-names></name><name><surname>Gamson</surname><given-names>J</given-names></name><name><surname>Zabell</surname><given-names>A</given-names></name><name><surname>Russo</surname><given-names>A</given-names></name></person-group><article-title>Oxygen dependence of hematoporphyrin derivative-induced photoinactivation of Chinese hamster cells</article-title><source>Cancer Res</source><year>1985</year><volume>45</volume><fpa