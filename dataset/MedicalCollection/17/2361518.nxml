d align="center" valign="top" char="&#x02013;" charoff="50">2517&#x02013;2496</td><td align="center" valign="top" charoff="50">ccgctgaatagaacaggctaag</td></tr><tr><td align="left" valign="top" charoff="50">MT1-MMP (X83535)</td><td align="center" valign="top" char="&#x02013;" charoff="50">1249&#x02013;1270</td><td align="center" valign="top" charoff="50">gcaaattcgtcttcttcaaagg</td><td align="center" valign="top" char="&#x02013;" charoff="50">1476&#x02013;1455</td><td align="center" valign="top" charoff="50">tgttcttggggtactcgctatc</td></tr><tr><td align="left" valign="top" charoff="50">TACE (NM&#x0005f;003183)</td><td align="center" valign="top" char="&#x02013;" charoff="50">1612&#x02013;1633</td><td align="center" valign="top" charoff="50">tggatgaaggagaagagtgtga</td><td align="center" valign="top" char="&#x02013;" charoff="50">1874&#x02013;1852</td><td align="center" valign="top" charoff="50">aagatccaagcaaacagtgtcat</td></tr><tr><td align="left" valign="top" charoff="50"><italic>&#x003b2;</italic>-Actin (NM&#x0005f;001101)</td><td align="center" valign="top" char="&#x02013;" charoff="50">414&#x02013;433</td><td align="center" valign="top" charoff="50">ccaaccgcgagaagatgacc</td><td align="center" valign="top" char="&#x02013;" charoff="50">649&#x02013;629</td><td align="center" valign="top" charoff="50">gatcttcatgaggtagtcagt</td></tr></tbody></table></table-wrap></floats-wrap></article>