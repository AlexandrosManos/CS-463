" valign="top" charoff="50">0</td><td align="center" valign="top" charoff="50">0</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Depression</td><td align="center" valign="top" charoff="50">2</td><td align="center" valign="top" charoff="50">0</td><td align="center" valign="top" charoff="50">0</td><td align="center" valign="top" charoff="50">0</td></tr></tbody></table></table-wrap><table-wrap id="tbl3" position="float"><label>Table 3</label><caption><p content-type="table-title">Univariate analysis for efficiency of IFN-<italic>&#x003b1;</italic>&#x0002f;5-FU combination therapy based on serum AFP, serum PIVKA-II, Child&#x02013;Pugh score, CLIP score, and IFNAR2 expression</p></caption><table frame="hsides" rules="groups" border="1" width="85%"><colgroup><col align="left"/><col align="center"/><col align="center"/><col align="center"/></colgroup><thead valign="bottom"><tr><th align="left" valign="top" charoff="50">&#x000a0;</th><th align="center" valign="top" charoff="50"><bold>CR&#x0002f;PR (<italic>n</italic>&#x0003d;24)</bold></th><th align="center" valign="top" charoff="50"><bold>NC&#x0002f;PD (<italic>n</italic>&#x0003d;31)</bold></th><th align="center" valign="top" charoff="50"><bold><italic>P</italic>-value</bold></th></tr></thead><tbody valign="top"><tr><td colspan="4" align="left" valign="top" charoff="50"><italic>Age</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x0003c;60</td><td align="center" valign="top" charoff="50">12</td><td align="center" valign="top" charoff="50">15</td><td align="center" valign="top" charoff="50">&#x0003e;0.9999</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x02a7e;60</td><td align="center" valign="top" charoff="50">12</td><td align="center" valign="top" charoff="50">16</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="4" align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="4" align="left" valign="top" charoff=