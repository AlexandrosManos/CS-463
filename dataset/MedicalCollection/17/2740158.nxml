element-citation></ref><ref id="bib-010"><element-citation publication-type="book"><person-group><name><surname>DeBord</surname><given-names>J</given-names></name></person-group><chapter-title>Vascular complications of hernia surgery</chapter-title><source>Prostheses and Abdominal Wall Hernias</source><person-group person-group-type="editor"><name><surname>Bendavid</surname><given-names>R</given-names></name></person-group><publisher-loc>Texas</publisher-loc><publisher-name>Austin, RG Landes Company</publisher-name><year>1994</year><fpage>357</fpage><lpage>366</lpage></element-citation></ref></ref-list><glossary><title>List of abbreviations</title><def-list id="dl1"><def-item><term>CFA</term><def><p>Common femoral artery</p></def></def-item><def-item><term>FAA</term><def><p>Femoral arterial aneurysms</p></def></def-item><def-item><term>US</term><def><p>Ultrasound</p></def></def-item><def-item><term>VVM</term><def><p>Venovenous malformation</p></def></def-item></def-list></glossary></back></article>