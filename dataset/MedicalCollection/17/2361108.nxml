icle-title>Subclavian venous thrombosis due to indwelling catheters: a prospective study on 52 patients</article-title><source>JPEN J Parenter Enteral Nutr</source><year>1983</year><volume>7</volume><fpage>560</fpage><lpage>562</lpage><!--PubMed citation query: 'JPEN J Parenter Enteral Nutr||7|560||bib9|'--><pub-id pub-id-type="pmid">6418913</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Broviac</surname><given-names>JW</given-names></name><name><surname>Cole</surname><given-names>JJ</given-names></name><name><surname>Scribner</surname><given-names>BH</given-names></name></person-group><article-title>A silicone rubber atrial catheter for prolonged parenteral alimentation</article-title><source>Surg Gynecol Obstet</source><year>1973</year><volume>136</volume><fpage>602</fpage><lpage>606</lpage><!--PubMed citation query: 'Surg Gynecol Obstet||136|602||bib10|'--><pub-id pub-id-type="pmid">4632149</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carr</surname><given-names>KM</given-names></name><name><surname>Rabinowitz</surname><given-names>I</given-names></name></person-group><article-title>Physician compliance with warfarin prophylaxis for central venous catheters in patients with solid tumors</article-title><source>J Clin Oncol</source><year>2000</year><volume>18</volume><fpage>3665</fpage><lpage>3667</lpage><!--PubMed citation query: 'J Clin Oncol||18|3665||bib11|'--><pub-id pub-id-type="pmid">11054439</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cortelezzi</surname><given-names>A</given-names></name><name><surname>Moia</surname><given-names>M</given-names></name><name><surname>Falanga</surname><given-names>A</given-names></name><name><surname>Pogliani</surname><given-names>EM</given-names></name><name><surname>Agnell