="50">Physical activity &#x02a7e;1000 kcal&#x0002f;week (&#x00025;)<sup>b</sup></td><td align="center" valign="top" charoff="50">67.3</td><td align="center" valign="top" charoff="50">70.2</td><td align="center" valign="top" charoff="50">69.3</td><td align="center" valign="top" charoff="50">66.2</td></tr><tr><td align="left" valign="top" charoff="50">Alcohol intake (&#x00025;)</td><td align="center" valign="top" charoff="50">71.4</td><td align="center" valign="top" charoff="50">73.0</td><td align="center" valign="top" charoff="50">73.7</td><td align="center" valign="top" charoff="50">70.4</td></tr><tr><td align="left" valign="top" charoff="50">Red meat intake &#x02a7e;3 servings&#x0002f;week (&#x00025;)</td><td align="center" valign="top" charoff="50">21.2</td><td align="center" valign="top" charoff="50">25.3</td><td align="center" valign="top" charoff="50">33.4</td><td align="center" valign="top" charoff="50">38.7</td></tr><tr><td align="left" valign="top" charoff="50">Vegetable intake &#x02a7e;3 servings&#x0002f;day (&#x00025;)</td><td align="center" valign="top" charoff="50">14.2</td><td align="center" valign="top" charoff="50">12.6</td><td align="center" valign="top" charoff="50">13.7</td><td align="center" valign="top" charoff="50">18.6</td></tr><tr><td align="left" valign="top" charoff="50">Paternal history of prostate cancer (&#x00025;)</td><td align="center" valign="top" charoff="50">3.2</td><td align="center" valign="top" charoff="50">3.5</td><td align="center" valign="top" charoff="50">4.8</td><td align="center" valign="top" charoff="50">4.2</td></tr></tbody></table><table-wrap-foot><fn id="tbfnote1"><label>a</label><p>Body mass index &#x02a7e;25&#x02009;kg&#x02009;m<sup>&#x02212;2</sup>.</p></fn><fn id="tbfnote2"><label>b</label><p>Sufficient to meet recommended level of physical activity.</p></fn></table-wrap-foot></table-wrap><table-wrap id="tbl2" position="float"><label>Table 2</label><caption><p content-type="table-title">RR of total prostate cancer according to dairy product and calcium intake, Harvard Alumni Health Study</p></caption><table frame="hsides" rules="groups" border="1" width="85%"><colgroup><col align="left"/><col align="center"/><col align="center"/></colgroup><thead valign="bottom"><tr><th align="left" valign="top" charoff="50">&#x000a0;</th><th align="center" valign="top" charoff="50"><bold>Age-adjusted RR (95&#x00025; confidence interval)</bold></th><th align="center" valign="top" charoff="50"><bold>Multivariate RR<sup>a</sup> (95&#x00025; confidence interval)</bold></th></tr></thead><tbody valign="top"><tr><td colspan="3" align="center" valign="top" charoff="50"><italic>Dairy product intake (servings&#x0002f;day)</italic><sup>b</sup></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;0&#x02013;&#x0003c;1.25 (189 cases)</td><td align="center" valign="top" charoff="50">1.00 (referent)</td><td align="center" valign="top" charoff="50">1.00 (referent)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;1.25&#x02013;&#x0003c;2.00 (183 cases)</td><td align="center" valign="top" charoff="50">0.91 (0.74&#x02013;1.12)</td><td align="center" valign="top" charoff="50">0.91 (0.71&#x02013;1.15)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;2.00&#x02013;&#x0003c;3.25 (220 cases)</td><td align="center" valign="top" charoff="50">1.14 (0.90&#x02013;1.39)</td><td align="center" valign="top" charoff="50">1.11 (0.87&#x02013;1.42)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x02a7e;3.25 (223 cases)</td><td align="center" valign="top" charoff="50">1.07 (0.88&#x02013;1.31)</td><td align="center" valign="top" charoff="50">1.11 (0.85&#x02013;1.46)</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50"><italic>P</italic> trend&#x0003d;0.16</td><td align="center" valign="top" charoff="50"><italic>P</italic> trend&#x0003d;0.23</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><