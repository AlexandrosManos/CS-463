rson-group-type="author"><name><surname>Henderson</surname><given-names>SR</given-names></name><name><surname>Guiliano</surname><given-names>D</given-names></name><name><surname>Presneau</surname><given-names>N</given-names></name><name><surname>McLean</surname><given-names>S</given-names></name><name><surname>Frow</surname><given-names>R</given-names></name><name><surname>Vujovic</surname><given-names>S</given-names></name><name><surname>Anderson</surname><given-names>J</given-names></name><name><surname>Sebire</surname><given-names>N</given-names></name><name><surname>Whelan</surname><given-names>J</given-names></name><name><surname>Athanasou</surname><given-names>N</given-names></name><name><surname>Flanagan</surname><given-names>AM</given-names></name><name><surname>Boshoff</surname><given-names>C</given-names></name></person-group><article-title>A molecular map of mesenchymal tumors</article-title><source>Genome Biol</source><year>2005</year><volume>6</volume><fpage>R76</fpage><!--PubMed citation query: 'Genome Biol||6|R76||bib11|'--><pub-id pub-id-type="pmid">16168083</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>J&#x000f6;nsson</surname><given-names>G</given-names></name><name><surname>Staaf</surname><given-names>J</given-names></name><name><surname>Olsson</surname><given-names>E</given-names></name><name><surname>Heidenblad</surname><given-names>M</given-names></name><name><surname>Vallon-Christersson</surname><given-names>J</given-names></name><name><surname>Osoegawa</surname><given-names>K</given-names></name><name><surname>de Jong</surname><given-names>P</given-names></name><name><surname>Oredsson</surname><given-names>S</given-names></name><name><surname>Ringner</surname><given-names>M</given-names></name><name><surname>H&#x000f6;glund</surname><given-names>M</given-names></name><name><surname>Borg</surname><given-names>&#x000c5;</given-names></name></person-group><artic