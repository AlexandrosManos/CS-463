off="50">&#x000a0;</td><td align="left" valign="top" charoff="50">Female (<italic>n</italic>=14)</td><td align="center" valign="top" charoff="50">8 (57)</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">6 (43)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Tumour invasion</td><td align="left" valign="top" charoff="50">T1, 2 (<italic>n</italic>=20)</td><td align="center" valign="top" charoff="50">9 (45)</td><td align="center" valign="top" charoff="50">0.92</td><td align="center" valign="top" charoff="50">9 (45)</td><td align="center" valign="top" charoff="50">0.77</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">T3, 4 (<italic>n</italic>=15)</td><td align="center" valign="top" charoff="50">7 (47)</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">6 (40)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Nodal metastasis</td><td align="left" valign="top" charoff="50">N0 (<italic>n</italic>=14)</td><td align="center" valign="top" charoff="50">7 (50)</td><td align="center" valign="top" charoff="50">0.68</td><td align="center" valign="top" charoff="50">7 (50)</td><td align="center" valign="top" charoff="50">0.49</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">N1, 2 (<italic>n</italic>=21)</td><td align="center" valign="top" charoff="50">9 (43)</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">8 (38)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Metastasis</td><td align="left" valign="top" charoff="50">M0 (<italic>n</italic>=26)</td><td align="center" valign="top" charoff="50">12 (46)</td><td align="center" valign="top" charoff="50">0.93</td><td align="center" valign="top" charoff="50">11 (42)</td><td align="center" valign="top" charoff="50">0.91</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">M1 (<italic>n</italic>=9)</td><td align="center" valign="top" charoff="50">4 (44)</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">4 (44)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">TNM stage</td><td align="left" valign="top" charoff="50">1, 2 (<italic>n</italic>=18)</td><td align="center" valign="top" charoff="50">8 (44)</td><td align="center" valign="top" charoff="50">0.88</td><td align="center" valign="top" charoff="50">8 (44)</td><td align="center" valign="top" charoff="50">0.85</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">3, 4 (<italic>n</italic>=17)</td><td align="center" valign="top" charoff="50">8 (47)</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">7 (41)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Histology</td><td align="left" valign="top" charoff="50">Intestinal (<italic>n</italic>=17)</td><td align="center" valign="top" charoff="50">8 (47)</td><td align="center" valign="top" charoff="50">0.88</td><td align="center" valign="top" charoff="50">6 (35)</td><td align="center" valign="top" charoff="50">0.38</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">Diffuse (<italic>n</italic>=18)</td><td align="center" valign="top" charoff="50">8 (44)</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">9 (50)</td><td align="center" valign="top" charo