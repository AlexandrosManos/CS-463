ion</article-title><source>Immunol Cell Biol</source><year>2005b</year><volume>83</volume><fpage>451</fpage><lpage>461</lpage><!--PubMed citation query: 'Immunol Cell Biol||83|451||bib28|'--><pub-id pub-id-type="pmid">16174093</pub-id></citation></ref><ref id="bib29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pinzon-Charry</surname><given-names>A</given-names></name><name><surname>Maxwell</surname><given-names>T</given-names></name><name><surname>McGuckin</surname><given-names>MA</given-names></name><name><surname>Schmidt</surname><given-names>C</given-names></name><name><surname>Furnival</surname><given-names>C</given-names></name><name><surname>Lopez</surname><given-names>JA</given-names></name></person-group><article-title>Spontaneous apoptosis of blood dendritic cells in patients with breast cancer</article-title><source>Breast Cancer Res</source><year>2005c</year><volume>8</volume><fpage>R5</fpage><!--PubMed citation query: 'Breast Cancer Res||8|R5||bib29|'--><pub-id pub-id-type="pmid">16417648</pub-id></citation></ref><ref id="bib30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pinzon-Charry</surname><given-names>A</given-names></name><name><surname>Maxwell</surname><given-names>T</given-names></name><name><surname>Prato</surname><given-names>S</given-names></name><name><surname>Furnival</surname><given-names>C</given-names></name><name><surname>Schmidt</surname><given-names>C</given-names></name><name><surname>Lopez</surname><given-names>JA</given-names></name></person-group><article-title>HLA-DR&#x0002b; immature cells exhibit reduced antigen-presenting cell function but respond to CD40 stimulation</article-title><source>Neoplasia</source><year>2005d</year><volume>7</volume><fpage>1123</fpage><lpage>1132</lpage><!--PubMed citation query: 'Neoplasia||7|1123||bib30|'--><pub-id pub-id-type="pmid">16354595</pub-id></citation></ref><ref id="bib31"><citation citation-type="