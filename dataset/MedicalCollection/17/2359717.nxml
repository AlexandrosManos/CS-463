 rid="bib15">Hirsch <italic>et al</italic> (2005)</xref><sup>a</sup></td><td align="center" valign="top" charoff="50">81</td><td align="center" valign="top" charoff="50">&#x02a7e;100</td><td align="center" valign="top" charoff="50">32</td><td align="center" valign="top" charoff="50">&#x02014;<sup>b</sup></td><td align="center" valign="top" charoff="50">&#x02014;<sup>b</sup></td></tr><tr><td align="left" valign="top" charoff="50"><xref ref-type="other" rid="bib14">Hirsch <italic>et al</italic> (2006)</xref><sup>a</sup></td><td align="center" valign="top" charoff="50">370</td><td align="center" valign="top" charoff="50">&#x02014;<sup>b</sup></td><td align="center" valign="top" charoff="50">31</td><td align="center" valign="top" charoff="50">17</td><td align="center" valign="top" charoff="50">14</td></tr><tr><td align="left" valign="top" charoff="50"><xref ref-type="other" rid="bib18">Jeon <italic>et al</italic> (2006)</xref><sup>a</sup></td><td align="center" valign="top" charoff="50">262</td><td align="center" valign="top" charoff="50">&#x02014;<sup>b</sup></td><td align="center" valign="top" charoff="50">30.2</td><td align="center" valign="top" charoff="50">19.1</td><td align="center" valign="top" charoff="50">11.1</td></tr><tr><td align="left" valign="top" charoff="50"><xref ref-type="other" rid="bib16">Ichihara <italic>et al</italic> (2007)</xref><sup>a</sup></td><td align="center" valign="top" charoff="50">75</td><td align="center" valign="top" charoff="50">&#x02a7e;100</td><td align="center" valign="top" charoff="50">41.3</td><td align="center" valign="top" charoff="50">25.3</td><td align="center" valign="top" charoff="50">16</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="6" align="left" valign="top" charoff="50"><italic>Present study</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Histology</td><td align="center" valign="top" charoff="50">33</td><td align="center" valign="top" charoff="50">43&#x02013;100 (mean: 88.6&#x000b1;17.6)</td><td align="center" valign="top" charoff="50">24.2</td><td align="center" valign="top" charoff="50">15.1</td><td align="center" valign="top" charoff="50">9.1</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Cytology</td><td align="center" valign="top" charoff="50">67</td><td align="center" valign="top" charoff="50">12&#x02013;100 (mean: 66.1&#x000b1;31.6)</td><td align="center" valign="top" charoff="50">67.1</td><td align="center" valign="top" charoff="50">52.2</td><td align="center" valign="top" charoff="50">14.9</td></tr></tbody></table><table-wrap-foot><fn id="t6-fn1"><label/><p>EGFR=<italic>epidermal growth factor receptor gene</italic>; FISH=fluorescence <italic>in situ</italic> hybridisation; NSCLC=non-small-cell lung carcinoma.</p></fn><fn id="t6-fn2"><label/><p>Criteria for a positive FISH result: presence of high polysomy (&#x02a7e;4 <italic>EGFR gene</italic> copies per nucleus in &#x02a7e;40&#x00025; of the analysed cancer cells) or of amplification (presence of tight <italic>EGFR gene</italic> clusters and a ratio of <italic>EGFR gene</italic> to chromosome of &#x02a7e;2, or &#x02a7e;15 <italic>EGFR gene</italic> copies per nucleus in &#x02a7e;10&#x00025; of the analysed cancer cells).</p></fn><fn id="t6-fna"><label>a</label><p>All cited FISH analyses were performed on histological specimens.</p></fn><fn id="t6-fnb"><label>b</label><p>No information.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>