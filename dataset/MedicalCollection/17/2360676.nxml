e>Melanocytes to Melanoma: The Progression to Malignancy</source><year>2006</year><publisher-name>New Jersey: Humana Press</publisher-name>Hearing VJ, Leong SPL (eds)</citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bennett</surname><given-names>DC</given-names></name><name><surname>Bridges</surname><given-names>K</given-names></name><name><surname>McKay</surname><given-names>IA</given-names></name></person-group><article-title>Clonal separation of mature melanocytes from premelanocytes in a diploid human cell strain: spontaneous and induced pigmentation of premelanocytes</article-title><source>J Cell Sci</source><year>1985</year><volume>77</volume><fpage>167</fpage><lpage>183</lpage><!--PubMed citation query: 'J Cell Sci||77|167||bib6|'--><pub-id pub-id-type="pmid">4086513</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bennett</surname><given-names>DC</given-names></name><name><surname>Medrano</surname><given-names>EE</given-names></name></person-group><article-title>Molecular regulation of melanocyte senescence</article-title><source>Pigment Cell Res</source><year>2002</year><volume>15</volume><fpage>242</fpage><lpage>250</lpage><!--PubMed citation query: 'Pigment Cell Res||15|242||bib7|'--><pub-id pub-id-type="pmid">12100489</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bodnar</surname><given-names>AG</given-names></name><name><surname>Quellette</surname><given-names>M</given-names></name><name><surname>Frolkis</surname><given-names>M</given-names></name><name><surname>Holt</surname><given-names>SE</given-names></name><name><surname>Chiu</surname><given-names>CP</given-names></name><name><surname>Morin</surname><given-names>GB</given-names></name><name><surname>Harley</surname><given-names>CB</given-names></name><name><surname>S