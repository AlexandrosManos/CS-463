d></mixed-citation></ref><ref id="R6"><label>6. </label><mixed-citation publication-type="journal"><string-name><surname>Arnold</surname> <given-names>JC</given-names></string-name>, <string-name><surname>Singh</surname> <given-names>KK</given-names></string-name>, <string-name><surname>Spector</surname> <given-names>SA</given-names></string-name>, <string-name><surname>Sawyer</surname> <given-names>MH</given-names></string-name> <article-title>MedlineHuman bocavirus: prevalence and clinical spectrum at a children's hospital.</article-title><source>Clin Infect Dis</source> <year>2006</year>;<volume>43</volume>:<fpage>283</fpage>&#x02013;<lpage>8</lpage> <pub-id pub-id-type="doi">10.1086/505399</pub-id><pub-id pub-id-type="pmid">16804840</pub-id></mixed-citation></ref><ref id="R7"><label>7. </label><mixed-citation publication-type="journal"><string-name><surname>Weissbrich</surname> <given-names>B</given-names></string-name>, <string-name><surname>Neske</surname> <given-names>F</given-names></string-name>, <string-name><surname>Schubert</surname> <given-names>J</given-names></string-name>, <string-name><surname>Tollmann</surname> <given-names>F</given-names></string-name>, <string-name><surname>Blath</surname> <given-names>K</given-names></string-name>, <string-name><surname>Blessing</surname> <given-names>K</given-names></string-name>, <etal/><article-title>MedlineFrequent detection of bocavirus DNA in German children with respiratory tract infections.</article-title><source>BMC Infect Dis</source> <year>2006</year>;<volume>6</volume>:<fpage>109</fpage> <pub-id pub-id-type="doi">10.1186/1471-2334-6-109</pub-id><pub-id pub-id-type="pmid">16834781</pub-id></mixed-citation></ref><ref id="R8"><label>8. </label><mixed-citation publication-type="journal"><string-name><surname>Chung</surname> <given-names>JY</given-names></string-name>, <string-name><surname>Han</surname> <given-names>TH</given-names></string-name>, <string-name><surname>Kim</surname> <given-names>CK</given-names></string-name>, <string-name><surname>Kim</surname> <given-names>SW</given-names></string-name> <article-title>MedlineBocavirus infection in hospitalized children, South Korea.</article-title><source>Emerg Infect Dis</source> <year>2006</year>;<volume>12</volume>:<fpage>1254</fpage>&#x02013;<lpage>6</lpage><pub-id pub-id-type="pmid">16965708</pub-id></mixed-citation></ref><ref id="R9"><label>9. </label><mixed-citation publication-type="journal"><string-name><surname>Choi</surname> <given-names>EH</given-names></string-name>, <string-name><surname>Lee</surname> <given-names>HJ</given-names></string-name>, <string-name><surname>Kim</surname> <given-names>SJ</given-names></string-name>, <string-name><surname>Eun</surname> <given-names>BW</given-names></string-name>, <string-name><surname>Kim</surname> <given-names>NH</given-names></string-name>, <string-name><surname>Lee</surname> <given-names>JA</given-names></string-name>, <etal/><article-title>MedlineThe association of newly identified respiratory viruses with lower respiratory tract infections in Korean children, 2000&#x02013;2005.</article-title><source>Clin Infect Dis</source> <year>2006</year>;<volume>43</volume>:<fpage>585</fpage>&#x02013;<lpage>92</lpage> <pub-id pub-id-type="doi">10.1086/506350</pub-id><pub-id pub-id-type="pmid">16886150</pub-id></mixed-citation></ref></ref-list></back></article>