surname>Chen</surname><given-names>WY</given-names></name><name><surname>Hunter</surname><given-names>DJ</given-names></name><name><surname>Willett</surname><given-names>WC</given-names></name></person-group><article-title>Physical activity and risk of breast cancer in premenopausal women</article-title><source>Br J Cancer</source><year>2003</year><volume>89</volume><supplement>5</supplement><fpage>847</fpage><lpage>851</lpage><!--PubMed citation query: 'Br J Cancer||89|847||bib5|'--><pub-id pub-id-type="pmid">12942116</pub-id></citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Stavola</surname><given-names>BL</given-names></name><name><surname>dos Santos Silva</surname><given-names>I</given-names></name><name><surname>McCormack</surname><given-names>V</given-names></name><name><surname>Hardy</surname><given-names>RJ</given-names></name><name><surname>Kuh</surname><given-names>DJ</given-names></name><name><surname>Wadsworth</surname><given-names>ME</given-names></name></person-group><article-title>Childhood growth and breast cancer</article-title><source>Am J Epidemiol</source><year>2004</year><volume>159</volume><fpage>671</fpage><lpage>682</lpage><!--PubMed citation query: 'Am J Epidemiol||159|671||bib6|'--><pub-id pub-id-type="pmid">15033645</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dorn</surname><given-names>J</given-names></name><name><surname>Vena</surname><given-names>J</given-names></name><name><surname>Brasure</surname><given-names>J</given-names></name><name><surname>Freudenheim</surname><given-names>J</given-names></name><name><surname>Graham</surname><given-names>S</given-names></name></person-group><article-title>Lifetime physical activity and breast cancer risk in pre- and postmenopausal women</article-title><source>Med Sci Sports Exerc</source><year>2003</year><volume>35</volume><fpage>278</fp