op" charoff="50">NE</td><td align="center" valign="top" charoff="50">2</td><td align="center" valign="top" charoff="50">3</td></tr><tr><td align="left" valign="top" charoff="50">FEC</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">1</td></tr><tr><td align="left" valign="top" charoff="50">NM</td><td align="center" valign="top" charoff="50">0</td><td align="center" valign="top" charoff="50">1</td></tr><tr><td align="left" valign="top" charoff="50">CMF&#x02013;AC</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">0</td></tr></tbody></table><table-wrap-foot><fn id="tbfnote1"><label/><p>ECisF: Epirubicin 60&#x02009;mg&#x02009;m<sup>&#x02212;2</sup>, day 1 of 3 week cycle; Cisplatin 60&#x02009;mg&#x02009;m<sup>&#x02212;2</sup>, day 1 of 3 week cycle; 5 Fluorouracil 200&#x02009;mg&#x02009;m<sup>&#x02212;2</sup>, 24&#x02009;h continuous infusion for 21 weeks.</p></fn><fn id="tbfnote2"><label/><p>AC: Doxorubicin 60&#x02009;mg&#x02009;m<sup>&#x02212;2</sup>, day 1 of 3 week cycle; Cyclophosphamide 600&#x02009;mg&#x02009;m<sup>&#x02212;2</sup>, day 1 of 3 week cycle.</p></fn><fn id="tbfnote3"><label/><p>NE: Navelbine 25&#x02009;mg&#x02009;m<sup>&#x02212;2</sup>, day 1&#x0002b;8 of 3 week cycle (maximum dose 60&#x02009;mg); Epirubicin 60&#x02009;mg&#x02009;m<sup>&#x02212;2</sup>, day 1 of 3 week cycle.</p></fn><fn id="tbfnote4"><label/><p>FEC: 5 Fluorouracil 600&#x02009;mg&#x02009;m<sup>&#x02212;2</sup>, day 1 of 3 week cycle; Epirubicin 60&#x02009;mg&#x02009;m<sup>&#x02212;2</sup>, day 1 of 3 week cycle; Cyclophosphamide 600&#x02009;mg&#x02009;m<sup>&#x02212;2</sup>, day 1 of 3 week cycle.</p></fn><fn id="tbfnote5"><label/><p>NM: Navelbine 25&#x02009;mg&#x02009;m<sup>&#x02212;2</sup>, day 1&#x0002b;8 of 3 week cycle; Mitoxantrone 12&#x02009;mg&#x02009;m<sup>&#x02212;2</sup>, day 1 of 3 week cycle.</p></fn><fn id="tbfnote6"><label/><p>CMF: Cyclophosphamide 100&#x02009;mg&#x02009;m<sup>&#x02212;2</sup>, once daily orally days 1&#x02013;14; Methotrexate 40&#x02009;mg&#x02009;m<sup>&#x02212;2</sup>, day 1&#x0002b;8 of 4 week cycle; 5 Fluorouracil 600&#x02009;mg&#x02009;m<sup>&#x02212;2</sup>, day 1&#x0002b;8 of 4 week cycle.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>