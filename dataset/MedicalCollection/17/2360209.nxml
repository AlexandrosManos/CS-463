n-group person-group-type="author"><name><surname>Fabian</surname><given-names>CJ</given-names></name><name><surname>Kimler</surname><given-names>BF</given-names></name><name><surname>Brady</surname><given-names>DA</given-names></name><name><surname>Mayo</surname><given-names>MS</given-names></name><name><surname>Chang</surname><given-names>CHJ</given-names></name><name><surname>Ferraro</surname><given-names>JA</given-names></name><name><surname>Zalles</surname><given-names>CM</given-names></name><name><surname>Stanton</surname><given-names>AL</given-names></name><name><surname>Masood</surname><given-names>S</given-names></name><name><surname>Grizzle</surname><given-names>WE</given-names></name><name><surname>Boyd</surname><given-names>NF</given-names></name><name><surname>Arneson</surname><given-names>DW</given-names></name><name><surname>Johnson</surname><given-names>KA</given-names></name></person-group><article-title>A phase II breast cancer chemoprevention trial of oral difluoromethylornithine: breast tissue imaging and serum and urine biomarkers</article-title><source>Clin Cancer Res</source><year>2002</year><volume>8</volume><fpage>3105</fpage><lpage>3117</lpage><!--PubMed citation query: 'Clin Cancer Res||8|3105||bib8|'--><pub-id pub-id-type="pmid">12374678</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gatalica</surname><given-names>Z</given-names></name><name><surname>Lele</surname><given-names>SM</given-names></name><name><surname>Rampy</surname><given-names>BA</given-names></name><name><surname>Norris</surname><given-names>BA</given-names></name></person-group><article-title>The expression of Fhit protein is related inversely to disease progression in patients with breast carcinoma</article-title><source>Cancer</source><year>2000</year><volume>88</volume><fpage>1378</fpage><lpage>1383</lpage><!--PubMed citation query: 'Cancer||88|1378||bib9|'--><pub-id pub-id-type="pmid">10717620</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ginestier</surname><given-names>C</given-names></name><name><surname>Bardou</surname><given-names>V-J</given-names></name><name><surname>Popovici</surname><given-names>C</given-names></name><name><surname>Charafe-Jauffret</surname><given-names>E</given-names></name><name><surname>Bertucci</surname><given-names>F</given-names></name><name><surname>Geneix</surname><given-names>J</given-names></name><name><surname>Adelaide</surname><given-names>J</given-names></name><name><surname>Chaffanet</surname><given-names>M</given-names></name><name><surname>Hassoun</surname><given-names>J</given-names></name><name><surname>Viens</surname><given-names>P</given-names></name><name><surname>Jacquemier</surname><given-names>J</given-names></name><name><surname>Birnbaum</surname><given-names>D</given-names></name></person-group><article-title>Loss of fhit protein expression is a marker of adverse evolution in good prognosis localized breast cancer</article-title><source>Int J Cancer</source><year>2003</year><volume>107</volume><fpage>854</fpage><lpage>862</lpage><!--PubMed citation query: 'Int J Cancer||107|854||bib10|'--><pub-id pub-id-type="pmid">14566838</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Golebiowski</surname><given-names>F</given-names></name><name><surname>Szulc</surname><given-names>A</given-names></name><name><surname>Szutowicz</surname><given-names>A</given-names></name><name><surname>Pawelczyk</surname><given-names>T</given-names></name></person-group><article-title>Ubc9-induced inhibition of diadenosine triphosphate hydrolase activity of the putative tumor suppressor protein Fhit</article-title><source>Arch Biochem Biophy</source><year>2004</year><volume>428</volume><fpage>160</fpage><lpage>164</lpage><!--PubMed citation query: 'Arch Biochem B