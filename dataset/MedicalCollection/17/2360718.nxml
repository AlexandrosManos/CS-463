Int</source><year>2005</year><volume>95</volume><fpage>956</fpage><lpage>960</lpage><!--PubMed citation query: 'BJU Int||95|956||bib8|'--><pub-id pub-id-type="pmid">15839912</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parker</surname><given-names>C</given-names></name></person-group><article-title>Active surveillance of early prostate cancer: rationale, initial results and future developments</article-title><source>Prostate Cancer Prostatic Dis</source><year>2004</year><volume>7</volume><fpage>184</fpage><lpage>187</lpage><!--PubMed citation query: 'Prostate Cancer Prostatic Dis||7|184||bib9|'--><pub-id pub-id-type="pmid">15224088</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parker</surname><given-names>C</given-names></name><name><surname>Muston</surname><given-names>D</given-names></name><name><surname>Melia</surname><given-names>J</given-names></name><name><surname>Moss</surname><given-names>S</given-names></name><name><surname>Dearnaley</surname><given-names>D</given-names></name></person-group><article-title>A model of the natural history of screen-detected prostate cancer, and the effect of radical treatment on overall survival</article-title><source>Br J Cancer</source><year>2006</year><volume>94</volume><fpage>1361</fpage><lpage>1368</lpage><!--PubMed citation query: 'Br J Cancer||94|1361||bib10|'--><pub-id pub-id-type="pmid">16641912</pub-id></citation></ref><ref id="bib11"><citation citation-type="other"><person-group person-group-type="author"><collab>Press Association</collab></person-group><article-title>Study warns of prostate cancer therapy risks</article-title><source>Guardian Unlimited</source><year>2006</year>(accessed 25th May 2006)</citation></ref></ref-list></back></article>