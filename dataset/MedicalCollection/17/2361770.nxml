d><td align="center" valign="top" charoff="50">0.16</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Multiple</td><td align="center" valign="top" charoff="50">22 (12.0)</td><td align="center" valign="top" charoff="50">37 (20.2)</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">22 (12.0)</td><td align="center" valign="top" charoff="50">37 (20.2)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="7" align="left" valign="top" charoff="50"><italic>Stage (TNM staging system)</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;pTa</td><td align="center" valign="top" charoff="50">9 (4.9)</td><td align="center" valign="top" charoff="50">45 (24.6)</td><td align="center" valign="top" charoff="50">0.01</td><td align="center" valign="top" charoff="50">13 (7.1)</td><td align="center" valign="top" charoff="50">41 (22.4)</td><td align="center" valign="top" charoff="50">0.001</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;pT1</td><td align="center" valign="top" charoff="50">9 (4.9)</td><td align="center" valign="top" charoff="50">30 (16.4)</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">17 (9.3)</td><td align="center" valign="top" charoff="50">22 (12.0)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;pT2a</td><td align="center" valign="top" charoff="50">16 (8.7)</td><td align="center" valign