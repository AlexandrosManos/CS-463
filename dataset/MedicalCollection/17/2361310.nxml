e>Cell</source><year>1995</year><volume>80</volume><fpage>813</fpage><lpage>823</lpage><!--PubMed citation query: 'Cell||80|813||bib6|'--><pub-id pub-id-type="pmid">7889575</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>DeFazio</surname><given-names>LG</given-names></name><name><surname>Stansel</surname><given-names>RM</given-names></name><name><surname>Griffith</surname><given-names>JD</given-names></name><name><surname>Chu</surname><given-names>G</given-names></name></person-group><article-title>Synapsis of DNA ends by DNA-dependent protein kinase</article-title><source>EMBO J</source><year>2002</year><volume>21</volume><fpage>3192</fpage><lpage>3200</lpage><!--PubMed citation query: 'EMBO J||21|3192||bib7|'--><pub-id pub-id-type="pmid">12065431</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ding</surname><given-names>Q</given-names></name><name><surname>Bramble</surname><given-names>L</given-names></name><name><surname>Yuzbasiyan-Gurkan</surname><given-names>V</given-names></name><name><surname>Bell</surname><given-names>T</given-names></name><name><surname>Meek</surname><given-names>K</given-names></name></person-group><article-title>DNA-PKcs mutations in dogs and horses: allele frequency and association with neoplasia</article-title><source>Gene</source><year>2002</year><volume>283</volume><fpage>263</fpage><lpage>269</lpage><!--PubMed citation query: 'Gene||283|263||bib8|'--><pub-id pub-id-type="pmid">11867233</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dynan</surname><given-names>WS</given-names></name><name><surname>Yoo</surname><given-names>S</given-names></name></person-group><article-title>Interaction of Ku protein and DNA-dependent protein kinase catalytic subunit with nucleic acids</article-title><source>N