 J Cancer</source><year>1996</year><volume>74</volume><fpage>30</fpage><lpage>36</lpage><!--PubMed citation query: 'Br J Cancer||74|30||bib25|'--><pub-id pub-id-type="pmid">8679454</pub-id></citation></ref><ref id="bib26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kishimoto</surname><given-names>T</given-names></name><name><surname>Akira</surname><given-names>S</given-names></name><name><surname>Narazaki</surname><given-names>M</given-names></name><name><surname>Taga</surname><given-names>T</given-names></name></person-group><article-title>Interleukin-6 family of cytokines and gp130</article-title><source>Blood</source><year>1995</year><volume>86</volume><fpage>1243</fpage><lpage>1254</lpage><!--PubMed citation query: 'Blood||86|1243||bib26|'--><pub-id pub-id-type="pmid">7632928</pub-id></citation></ref><ref id="bib27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Klausen</surname><given-names>P</given-names></name><name><surname>Pedersen</surname><given-names>L</given-names></name><name><surname>Jurlander</surname><given-names>J</given-names></name><name><surname>Baumann</surname><given-names>H</given-names></name></person-group><article-title>Oncostatin M and interleukin 6 inhibit cell cycle progression by prevention of p27kip1 degradation in HepG2 cells</article-title><source>Oncogene</source><year>2000</year><volume>19</volume><fpage>3675</fpage><lpage>3683</lpage><!--PubMed citation query: 'Oncogene||19|3675||bib27|'--><pub-id pub-id-type="pmid">10951574</pub-id></citation></ref><ref id="bib28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Korbelik</surname><given-names>M</given-names></name></person-group><article-title>Induction of tumor immunity by photodynamic therapy</article-title><source>J Clin Laser Med Surg</source><year>1996</year><volume>14</volume><fpage>329</fpage><lpage>334</lpage><!--PubMed citation query: 'J Clin