="author"><name><surname>Ware</surname><given-names>JE</given-names></name><name><surname>Snow</surname><given-names>KK</given-names></name><name><surname>Kosinski</surname><given-names>AS</given-names></name><name><surname>Gandek</surname><given-names>B</given-names></name></person-group><article-title/><source>SF-36: Health Survey Manual and Interpretation Guide</source><year>1993</year><publisher-name>Boston, MA: Nimrod Press</publisher-name></citation></ref><ref id="bib27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wood</surname><given-names>K</given-names></name></person-group><article-title>Intercostobrachial nerve entrapment syndrome</article-title><source>South Med J</source><year>1978</year><volume>71</volume><fpage>662</fpage><lpage>663</lpage><!--PubMed citation query: 'South Med J||71|662||bib27|'--><pub-id pub-id-type="pmid">663696</pub-id></citation></ref></ref-list></back><floats-wrap><fig id="fig1"><label>Figure 1</label><caption><p>Flowchart of surveys and follow-up rates.</p></caption><graphic xmlns:xlink="http://www.w3.org/1999/xlink" mime-subtype="gif" xlink:href="92-6602304f1"/></fig><table-wrap id="tbl1" position="float"><label>Table 1</label><caption><p content-type="table-title">Characteristics of women who were surveyed in 2002, 7&#x02013;12 years after breast surgery (mean 9 years)</p></caption><table frame="hsides" rules="groups" border="1" width="85%"><colgroup><col align="left"/><col align="char" char="."/><col align="char" char="("/><col align="char" char="."/><col align="char" char="("/><col align="char" char="."/></colgroup><thead valign="bottom"><tr><th align="left" valign="top" charoff="50">&#x000a0;</th><th colspan="2" align="center" valign="top" char="." charoff="50"><bold>Persistent PMPS since 1996</bold><hr/></th><th colspan="2" align="center" valign="top" char="." charoff="50"><bold>PMPS resolved between 1996 and 2002</bold><hr/></th><th align="char" valign="top" char="." charoff="50">&#x000a0;</th></tr><tr><th align="left" valign="top" charoff="50">&#x000a0;</th><th align="char" valign="top" char="." charoff="50"><bold>No. of patients</bold></th><th align="char" valign="top" char="(" charoff="50"><bold>Mean (s.d.)</bold></th><th align="char" valign="top" char="." charoff="50"><bold>No. of patients</bold></th><th align="char" valign="top" char="(" charoff="50"><bold>Mean (s.d.)</bold></th><th align="char" valign="top" char="." charoff="50"><bold><italic>P</italic>-value</bold></th></tr></thead><tbody valign="top"><tr><td align="left" valign="top" charoff="50">Age (years)</td><td align="char" valign="top" char="." charoff="50">59</td><td align="char" valign="top" char="(" charoff="50">49.5 (9.8)</td><td align="char" valign="top" char="." charoff="50">54</td><td align="char" valign="top" char="(" charoff="50">56.2 (10.9)</td><td align="char" valign="top" char="." charoff="50">0.001</td></tr><tr><td align="left" valign="top" charoff="50">Weight (kg)</td><td align="char" valign="top" char="." charoff="50">46</td><td align="char" valign="top" char="(" charoff="50">70.5 (12.4)</td><td align="char" valign="top" char="." charoff="50">42</td><td align="char" valign="top" char="(" charoff="50">63.9 (9.1)</td><td align="char" valign="top" char="." charoff="50">0.004</td></tr><tr><td align="left" valign="top" charoff="50">Height (m)</td><td align="char" valign="top" char="." charoff="50">56</td><td align="char" valign="top" char="(" charoff="50">1.63 (0.1)</td><td align="char" valign="top" char="." charoff="50">50</td><td align="char" valign="top" char="(" charoff="50">1.61 (0.1)</td><td align="char" valign="top" char="." charoff="50">0.17</td></tr><tr><td align="left" valign="top" charoff="50">Body Mass Index</td><td align="char" valign="top" char="." charoff="50">44</td><td align="char" valign="top" char="(" charoff="50">26.7 (4.7)</td><td align="char" valign="top" char="." charoff="50">38</td><td align="char" valign="top" char="(" charoff="50">24.9 (4.5)</td><td align="char" valign="top" char="." charoff="50">0.09</td></tr><tr><td align="left" valign="top" charoff="50">Time since breast surgery (years)</td><td align="char" valign="top" char="." charoff="50">59</td><td align="char" valign="top" char="(" charoff="50">8.9 (1.9)</td><td align="char" valign="top" char="." charoff="50">54</td><td align="char" valign="top" char="(" charoff="50">9.1 (1.8)</td><td align="char" valign="top" char="." charoff="50">0.66</td></tr></tbody></table></table-wrap><table-wrap id="tbl2" position="float"><label>Table 2</label><caption><p content-type="table-title">Mean (s.d.) McGill Pain Questionnaire (MPQ) scores for women with persistent PMPS</p></caption><table frame="hsides" rules="groups" border="1" width="85%"><colgroup><col align="left"/><col align="char" char="("/><col align="char" char="("/><col align="char" char="("/><col align="char" char="."/></colgroup><thead valign="bottom"><tr><th align="left" valign="top" charoff="50">&#x000a0;</th><th align="char" valign="top" char="(" charoff="50"><bold>Survey-1 1996</bold></th><th align="char" valign="top" char="(" charoff="50"><bold>Survey-2 2002</bold></th><th align="char" valign="top" char="(" charoff="50">&#x000a0;</th><th align="char" valign="top" char="." charoff="50">&#x000a0;</th></tr><tr><th align="left" valign="top" charoff="50"><bold>MPQ domain</bold></th><th align="char" valign="top" char="(" charoff="50"><bold><italic>N</italic>=47; mean (s.d.)</bold></th><th align="char" valign="top" char="(" charoff="50"><bold><italic>N</italic>=47; mean (s.d.)</bold></th><th align="char" valign="top" char="(" charoff="50"><bold>Mean paired difference<sup>a</sup> (95&#x00025; CI)</bold></th><th align="char" valign="top" char="." charoff="50"><bold><italic>P</italic>-value</bold></th></tr></thead><tbody valign="top"><tr><td align="left" valign="top" charoff="50">Pain Rating Index (PRI)</td><td align="char" valign="top" char="(" charoff="50">18.34 (11.8)</td><td align="char" valign="to