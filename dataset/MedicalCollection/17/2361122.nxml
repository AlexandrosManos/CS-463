up (UKCFSG)</article-title><source>J Med Genet</source><year>2000</year><volume>37</volume><fpage>203</fpage><lpage>209</lpage><!--PubMed citation query: 'J Med Genet||37|203||bib9|'--><pub-id pub-id-type="pmid">10699057</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eisinger</surname><given-names>F</given-names></name><name><surname>Bressac</surname><given-names>B</given-names></name><name><surname>Castaigne</surname><given-names>D</given-names></name><name><surname>Cottu</surname><given-names>PH</given-names></name><name><surname>Lansac</surname><given-names>J</given-names></name><name><surname>Lefranc</surname><given-names>JP</given-names></name><name><surname>Lesur</surname><given-names>A</given-names></name><name><surname>Nogues</surname><given-names>C</given-names></name><name><surname>Pierret</surname><given-names>J</given-names></name><name><surname>Puy-Pernias</surname><given-names>S</given-names></name><name><surname>Sobol</surname><given-names>H</given-names></name><name><surname>Tardivon</surname><given-names>A</given-names></name><name><surname>Tristant</surname><given-names>H</given-names></name><name><surname>Villet</surname><given-names>R</given-names></name></person-group><article-title>Identification and management of hereditary predisposition to cancer of the breast and the ovary (update 2004)</article-title><source>Bull Cancer</source><year>2004</year><volume>91</volume><fpage>219</fpage><lpage>237</lpage><!--PubMed citation query: 'Bull Cancer||91|219||bib10|'--><pub-id pub-id-type="pmid">15171047</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goffin</surname><given-names>JR</given-names></name><name><surname>Chappuis</surname><given-names>PO</given-names></name><name><surname>Begin</surname><given-names>LR</given-names></name><name><surname>Wong</surname><given-names>N</given-nam