lth Organ Tech Rep Ser||302|5||bib11|'--></citation></ref></ref-list></back><floats-wrap><table-wrap id="tbl1" position="float"><label>Table 1</label><caption><p content-type="table-title">Baseline characteristics of cases and controls with medical record data</p></caption><table frame="hsides" rules="groups" border="1" width="85%"><colgroup><col align="left"/><col align="center"/><col align="center"/><col align="center"/></colgroup><thead valign="bottom"><tr><th align="left" valign="top" charoff="50">&#x000a0;</th><th align="center" valign="top" charoff="50"><bold>Cases (<italic>n</italic>&#x0003d;178) (&#x00025;)</bold></th><th align="center" valign="top" charoff="50"><bold>Controls (<italic>n</italic>&#x0003d;180) (&#x00025;)</bold></th><th align="center" valign="top" charoff="50"><bold><italic>P</italic>-value</bold></th></tr></thead><tbody valign="top"><tr><td colspan="4" align="left" valign="top" charoff="50"><italic>Maternal education</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x02a7d;High school</td><td align="center" valign="top" charoff="50">36.5</td><td align="center" valign="top" charoff="50">27.8</td><td align="center" valign="top" charoff="50">0.08</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x0003e;High school</td><td align="center" valign="top" charoff="50">32.0</td><td align="center" valign="top" charoff="50">36.7</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x02a7e;College graduate</td><td align="center" valign="top" charoff="50">31.5</td><td align="center" valign="top" charoff="50">35.6</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="4" alig