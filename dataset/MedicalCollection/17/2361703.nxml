2.24&#x000b1;0.58</td><td align="center" valign="top" charoff="50">5.59&#x000b1;1.91<sup>c</sup></td><td align="center" valign="top" charoff="50">8.45&#x000b1;2.54<sup>a,b</sup></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;<italic>C</italic><sub>ss</sub> (ng&#x02009;ml<sup>&#x02212;1</sup>)</td><td align="center" valign="top" charoff="50">1.63&#x000b1;0.53</td><td align="center" valign="top" charoff="50">4.42&#x000b1;1.98<sup>c</sup></td><td align="center" valign="top" charoff="50">7.20&#x000b1;1.59<sup>a,b</sup></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;<italic>T</italic><sub>max</sub> (day)</td><td align="center" valign="top" charoff="50">49</td><td align="center" valign="top" charoff="50">42</td><td align="center" valign="top" charoff="50">42</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">BI</td><td align="center" valign="top" charoff="50">5130.1&#x000b1;745</td><td align="center" valign="top" charoff="50">7030.7&#x000b1;537<sup>c</sup></td><td align="center" valign="top" charoff="50">10744.9&#x000b1;892<sup>a,b</sup></td></tr><tr><td align="left" valign="top" charoff="50">REC</td><td align="center" valign="top" charoff="50">0.0068&#x000b1;0.0048</td><td align="center" valign="top" charoff="50">0.0098&#x000b1;0.0035</td><td align="center" valign="top" charoff="50">0.0087&#x000b1;0.0025</td></tr><tr><td align="left" valign="top" charoff="50">MR</td><td align="center" valign="top" charoff="50">0.0184&#x000b1;0.0104</td><td align="center" valign="top" charoff="50">0.0292&#x000b1;0.0183</td><td align="center" valign="top" charoff="50">0.0274&#x000b1;0.0116</td></tr><tr><td align="left" valign="top" charoff="50">GR</td><td align="center" valign="top" charoff="50">1.698&#x000b1;0