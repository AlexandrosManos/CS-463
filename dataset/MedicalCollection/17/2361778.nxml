td></tr><tr><td align="left" valign="top" charoff="50">2</td><td align="center" valign="top" charoff="50">20 (29&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50">3</td><td align="center" valign="top" charoff="50">7 (10&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50">&#x0003e;3</td><td align="center" valign="top" charoff="50">13 (19&#x00025;)</td></tr></tbody></table><table-wrap-foot><fn id="tbfnote4"><label/><p>PEI=Percutaneous ethanol injections.</p></fn></table-wrap-foot></table-wrap><table-wrap id="tbl4" position="float"><label>Table 4</label><caption><p content-type="table-title">Number of PEI, which was used to treat patients with TACE followed by PEI</p></caption><table frame="hsides" rules="groups" border="1" width="85%"><colgroup><col align="left"/><col align="center"/></colgroup><thead valign="bottom"><tr><th align="left" valign="top" charoff="50"><bold>Number of PEIs</bold></th><th align="center" valign="top" charoff="50"><bold>Number of patients</bold></th></tr></thead><tbody valign="top"><tr><td align="left" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">17 (33&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50">2</td><td align="center" valign="top" charoff="50">15 (29&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50">3</td><td align="center" valign="top" charoff="50">11 (21&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50"><bold>&#x0003e;</bold>3</td><td align="center" valign="top" charoff="50">9 (17&#x00025;)</td></tr></tbody></table><table-wrap-foot><fn id="tbfnote5"><label/><p>PEI=Percutaneous ethanol injections.</p></fn></table-wrap-foot></table-wrap><table-wrap id="tbl5" position="float"><label>Table 5</label><caption><p content-type="table-title">Independent variables predictive of 5-year survival by multivariate analysis</p></caption><table frame="hsides" rules="groups" border="1" width="85%"><colgroup><col align="left"/><col align="cent