<label>a</label><p>Quantitative variables.</p></fn></table-wrap-foot></table-wrap><table-wrap id="tbl4" position="float"><label>Table 4</label><caption><p content-type="table-title">Side effects</p></caption><table frame="hsides" rules="groups" border="1" width="85%"><colgroup><col align="left"/><col align="center"/></colgroup><thead valign="bottom"><tr><th align="left" valign="top" charoff="50"><bold>Side effects</bold></th><th align="center" valign="top" charoff="50"><bold><italic>n</italic></bold></th></tr></thead><tbody valign="top"><tr><td align="left" valign="top" charoff="50">Post embolisation syndrome</td><td align="center" valign="top" charoff="50">79</td></tr><tr><td align="left" valign="top" charoff="50">Vagal reaction</td><td align="center" valign="top" charoff="50">8</td></tr><tr><td align="left" valign="top" charoff="50">Carcinoid crisis</td><td align="center" valign="top" charoff="50">5</td></tr><tr><td align="left" valign="top" charoff="50">Pulmonary embolism</td><td align="center" valign="top" charoff="50">3</td></tr><tr><td align="left" valign="top" charoff="50">Acute liver failure</td><td align="center" valign="top" charoff="50">3</td></tr><tr><td align="left" valign="top" charoff="50">Tumour lysis syndrome and acute renal failure</td><td align="center" valign="top" charoff="50">1</td></tr><tr><td align="left" valign="top" charoff="50">Stroke</td><td align="center" valign="top" charoff="50">1</td></tr><tr><td align="left" valign="top" charoff="50">Liver abscess</td><td align="center" valign="top" charoff="50">1</td></tr><tr><td align="left" valign="top" charoff="50">Coronary spastic angina</td><td align="center" valign="top" charoff="50">1</td></tr><tr><td align="left" valign="top" charoff="50">Grade III neutropaenia</td><td align="center" valign="top" charoff="50">1</td></tr><tr><td align="left" valign="top" charoff="50">Ascites</td><td align="center" valign="top" charoff="50">1</td></tr></tbody></table></table-wrap></floats-wrap></article>