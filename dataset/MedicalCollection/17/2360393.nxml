>Ann Rheum Dis</source><year>2004a</year><volume>63</volume><fpage>1372</fpage><lpage>1378</lpage><!--PubMed citation query: 'Ann Rheum Dis||63|1372||bib9|'--><pub-id pub-id-type="pmid">15020312</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fraenkel</surname><given-names>L</given-names></name><name><surname>Gulanski</surname><given-names>B</given-names></name><name><surname>Wittink</surname><given-names>D</given-names></name></person-group><article-title>Patient treatment preferences for osteoporosis</article-title><source>Arthritis Rheum</source><year>2006</year><volume>55</volume><fpage>729</fpage><lpage>735</lpage><!--PubMed citation query: 'Arthritis Rheum||55|729||bib10|'--><pub-id pub-id-type="pmid">17013870</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fraenkel</surname><given-names>L</given-names></name><name><surname>Wittink</surname><given-names>DR</given-names></name><name><surname>Concato</surname><given-names>J</given-names></name><name><surname>Fried</surname><given-names>T</given-names></name></person-group><article-title>Informed choice and the widespread use of antiinflammatory drugs</article-title><source>Arthritis Rheum</source><year>2004b</year><volume>51</volume><fpage>210</fpage><lpage>214</lpage><!--PubMed citation query: 'Arthritis Rheum||51|210||bib11|'--><pub-id pub-id-type="pmid">15077261</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gan</surname><given-names>TJ</given-names></name><name><surname>Lubarsky</surname><given-names>DA</given-names></name><name><surname>Flood</surname><given-names>EM</given-names></name><name><surname>Thanh</surname><given-names>T</given-names></name><name><surname>Mauskopf</surname><given-names>J</given-names></name><name><surname>Mayne</surname><given-names>T<