agent</article-title><source>J Clin Oncol</source><year>2006</year><volume>24</volume><supplement>suppl</supplement><fpage>607s</fpage>(abstract 13074)<!--PubMed citation query: 'J Clin Oncol||24|607s||bib12|'--></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Denekamp</surname><given-names>J</given-names></name></person-group><article-title>Endothelial cell proliferation as a novel approach to targeting tumour therapy</article-title><source>Br J Cancer</source><year>1982</year><volume>45</volume><fpage>136</fpage><lpage>139</lpage><!--PubMed citation query: 'Br J Cancer||45|136||bib13|'--><pub-id pub-id-type="pmid">7059456</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dowlati</surname><given-names>A</given-names></name><name><surname>Robertson</surname><given-names>K</given-names></name><name><surname>Cooney</surname><given-names>M</given-names></name><name><surname>Petros</surname><given-names>WP</given-names></name><name><surname>Stratford</surname><given-names>M</given-names></name><name><surname>Jesberger</surname><given-names>J</given-names></name><name><surname>Rafie</surname><given-names>N</given-names></name><name><surname>Overmoyer</surname><given-names>B</given-names></name><name><surname>Makkar</surname><given-names>V</given-names></name><name><surname>Stambler</surname><given-names>B</given-names></name><name><surname>Taylor</surname><given-names>A</given-names></name><name><surname>Waas</surname><given-names>J</given-names></name><name><surname>Lewin</surname><given-names>JS</given-names></name><name><surname>McCrae</surname><given-names>KR</given-names></name><name><surname>Remick</surname><given-names>SC</given-names></name></person-group><article-title>A phase I pharmacokinetic and translational study of the novel vascular targeting agent combretastatin A-4 phosphate on a single-dose intraveno