on-type="journal"><person-group person-group-type="author"><name><surname>Clayton</surname><given-names>F</given-names></name></person-group><article-title>Pathologic correlates of survival in 378 lymph node-negative infiltrating ductal breast carcinomas. Mitotic count is the best single predictor</article-title><source>Cancer</source><year>1991</year><volume>68</volume><fpage>1309</fpage><!--PubMed citation query: 'Cancer||68|1309||bib6|'--><pub-id pub-id-type="pmid">1651805</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clemente</surname><given-names>C</given-names></name><name><surname>Boracchi</surname><given-names>P</given-names></name><name><surname>Andreola</surname><given-names>S</given-names></name><name><surname>Del Vecchio</surname><given-names>M</given-names></name><name><surname>Veronesi</surname><given-names>P</given-names></name><name><surname>Rilke</surname><given-names>F</given-names></name></person-group><article-title>Peritumoral lymphatic invasion in patients with node-negative mammary duct carcinoma</article-title><source>Cancer</source><year>1992</year><volume>69</volume><fpage>1396</fpage><!--PubMed citation query: 'Cancer||69|1396||bib7|'--><pub-id pub-id-type="pmid">1311623</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Colpaert</surname><given-names>C</given-names></name><name><surname>Vermeulen</surname><given-names>P</given-names></name><name><surname>Van Beest</surname><given-names>P</given-names></name><name><surname>Goovaerts</surname><given-names>G</given-names></name><name><surname>Weyler</surname><given-names>J</given-names></name><name><surname>Van Dam</surname><given-names>P</given-names></name><name><surname>Dirix</surname><given-names>L</given-names></name><name><surname>Van Marck</surname><given-names>E</given-names></name></person-group><article-title>Intratumoral hypoxia resulting in the presence of a fibrotic focus is an independent predictor of early distant relapse in lymph node-negative breast cancer patients</article-title><source>Histopathology</source><year>2001</year><volume>39</volume><fpage>416</fpage><!--PubMed citation query: 'Histopathology||39|416||bib8|'--><pub-id pub-id-type="pmid">11683944</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Colpaert</surname><given-names>C</given-names></name><name><surname>Vermeulen</surname><given-names>P</given-names></name><name><surname>Van Beest</surname><given-names>P</given-names></name><name><surname>Soubry</surname><given-names>A</given-names></name><name><surname>Goovaerts</surname><given-names>G</given-names></name><name><surname>Dirix</surname><given-names>L</given-names></name><name><surname>Harris</surname><given-names>A</given-names></name><name><surname>Van Marck</surname><given-names>EA</given-names></name></person-group><article-title>Cutaneous breast cancer deposits show distinct growth patterns with different degrees of angiogenesis, hypoxia and fibrin deposition</article-title><source>Histopathology</source><year>2003b</year><volume>42</volume><fpage>530</fpage><!--PubMed citation query: 'Histopathology||42|530||bib9|'--><pub-id pub-id-type="pmid">12786888</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Colpaert</surname><given-names>C</given-names></name><name><surname>Vermeulen</surname><given-names>P</given-names></name><name><surname>Fox</surname><given-names>S</given-names></name><name><surname>Harris</surname><given-names>A</given-names></name><name><surname>Dirix</surname><given-names>LY</given-names></name><name><surname>Van Marck</surname><given-names>EA</given-names></name></person-group><article-title>The presence of a fibrotic focus in invasive breast carcinoma correlates with the expression of carbonic anhydrase IX and is a marker of hypoxia and poor prognosis</article-title><source>Breast Cancer Res Treat</source><year>2003a</year><volume>81</volume><fpage>137</fpage><!--PubMed citation query: 'Breast Cancer Res Treat||81|137||bib10|'--><pub-id pub-id-type="pmid">14572156</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dawson</surname><given-names>P</given-names></name><name><surname>Ferguson</surname><given-names>D</given-names></name><name><surname>Karrison</surname><given-names>T</given-names></name></person-group><article-title>The pathological findings of breast cancer in patients surviving 25 years after radical mastectomy</article-title><source>Cancer</source><year>1982</year><volume>50</volume><fpage>2131</fpage><!--PubMed citation query: 'Cancer||50|2131||bib11|'--><pub-id pub-id-type="pmid">6290024</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dawson</surname><given-names>P</given-names></name><name><surname>Karrison</surname><given-names>T</given-names></name><name><surname>Ferguson</surname><given-names>D</given-names></name></person-group><article-title>Histologic features associated with long-term survival in breast cancer</article-title><source>Hum Pathol</source><year>1986</year><volume>17</volume><fpage>1015</fpage><!--PubMed citation query: 'Hum Pathol||17|1015||bib12|'--><pub-id pub-id-type="pmid">3019865</pub-id></citation></ref><ref id="bib13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Elston</surname><given-names>CW</given-names></name></person-group><article-title>Grading of invasive carcinoma of the breast</article-title><source>Diagnostic Histopathology of the Breast</source><year>1987</year><publisher-name>New York: Churchill Livingstone</publisher-name><fpage>302</fpage>Page DL, Anderson TJ (eds), p</citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Evangelou</surname><given-names>E</given-names></name><name><surname>Kyzas</surname><given-names>PA</given-names></name><name><surname>Trikalinos</surname><given-names>T</given-names></name></person-group><article-title>Comparison of the diagnostic accuracy of lymphatic endothelium markers: Bayesian approach</article-title><source>Mod Pathol</source><year>2005</year><volume>18</volume><fpage>1490</fpage><!--PubMed citation query: 'Mod Pathol||18|1490||bib14|'--><pub-id pub-id-type="pmid">15990898</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fisher</surname><given-names>E</given-names></name><name><surname>Anderson</surname><given-names>S</given-names></name><name><surname>Redmond</surname><given-names>C</given-names></name><name><surname>Fisher</surname><given-names>B</given-names></name></person-group><article-title>Pathologic findings from the National Surgical Adjuvant Breast Project protocol B-06. 10-year pathologic and clinical prognostic discriminants</article-title><source>Cancer</source><year>1993a</year><volume>71</volume><fpage>2507</fpage><!--PubMed citation query: 'Cancer||71|2507||bib15|'--><pub-id pub-id-type="pmid">8453574</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fisher</surname><given-names>E</given-names></name><name><surname>Costantino</surname><given-names>J</given-names></name><name><surname>Fisher</surname><given-names>B</given-names></name><name><surname>Redmond</surname><given-names>C</given-names></name></person-group><article-title>Pathologic findings from the National Surgical Adjuvant Breast Project (Protocol 4). Discriminants for 15-year survival. National Surgical Adjuvant Breast and Bowel Project Investigators</article-title><source>Cancer</source><ye