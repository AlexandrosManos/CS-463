 id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giannakopoulos</surname><given-names>NV</given-names></name><name><surname>Luo</surname><given-names>JK</given-names></name><name><surname>Papov</surname><given-names>V</given-names></name><name><surname>Zou</surname><given-names>W</given-names></name><name><surname>Lenschow</surname><given-names>DJ</given-names></name><name><surname>Jacobs</surname><given-names>BS</given-names></name><name><surname>Borden</surname><given-names>EC</given-names></name><name><surname>Li</surname><given-names>J</given-names></name><name><surname>Virgin</surname><given-names>HW</given-names></name><name><surname>Zhang</surname><given-names>DE</given-names></name></person-group><article-title>Proteomic identification of proteins conjugated to ISG15 in mouse and human cells</article-title><source>Biochem Biophys Res Commun</source><year>2005</year><volume>336</volume><fpage>496</fpage><lpage>506</lpage><!--PubMed citation query: 'Biochem Biophys Res Commun||336|496||bib14|'--><pub-id pub-id-type="pmid">16139798</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guo</surname><given-names>Z</given-names></name><name><surname>Linn</surname><given-names>JF</given-names></name><name><surname>Wu</surname><given-names>G</given-names></name><name><surname>Anzick</surname><given-names>SL</given-names></name><name><surname>Eisenberger</surname><given-names>CF</given-names></name><name><surname>Halachmi</surname><given-names>S</given-names></name><name><surname>Cohen</surname><given-names>Y</given-names></name><name><surname>Fomenkov</surname><given-names>A</given-names></name><name><surname>Hoque</surname><given-names>MO</given-names></name><name><surname>Okami</surname><given-names>K</given-names></name><name><surname>Steiner</surname><given-names>G</given-names></name><name><surname>Engles</surname><given-names>JM</gi