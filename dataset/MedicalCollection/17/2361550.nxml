align="center" valign="top" charoff="50"><bold><italic>n</italic></bold></th><th align="center" valign="top" charoff="50"><bold>Normal</bold></th><th align="center" valign="top" charoff="50"><bold>Low</bold></th><th align="char" valign="top" char="." charoff="50">&#x000a0;</th></tr></thead><tbody valign="top"><tr><td align="left" valign="top" charoff="50">Worried about fathering child</td><td align="center" valign="top" charoff="50">622</td><td align="center" valign="top" charoff="50">22&#x0002f;502 (4&#x00025;)</td><td align="center" valign="top" charoff="50">11&#x0002f;95 (12&#x00025;)</td><td align="char" valign="top" char="." charoff="50"><italic>P</italic>&#x0003d;0.01</td></tr><tr><td align="left" valign="top" charoff="50">Less interested in sex</td><td align="center" valign="top" charoff="50">600</td><td align="center" valign="top" charoff="50">45&#x0002f;486 (9&#x00025;)</td><td align="center" valign="top" charoff="50">22&#x0002f;92 (24&#x00025;)</td><td align="char" valign="top" char="." charoff="50"><italic>P</italic>&#x0003c;0.001</td></tr><tr><td align="left" valign="top" charoff="50">Less sexually active</td><td align="center" valign="top" charoff="50">599</td><td align="center" valign="top" charoff="50">97&#x0002f;484 (20&#x00025;)</td><td align="center" valign="top" charoff="50">33&#x0002f;93 (35&#x00025;)</td><td align="char" valign="top" char="." charoff="50"><italic>P</italic>&#x0003d;0.001</td></tr><tr><td align="left" valign="top" charoff="50">Sex less enjoyable</td><td align="center" valign="top" charoff="50">550</td><td align="center" valign="top" charoff="50">25&#x0002f;449 (6&#x00025;)</td><td align="center" valign="top" charoff="50">14&#x0002f;81 (17&#x00025;)</td><td align="char" valign="top" char="." charoff="50"><italic>P</italic>&#x0003c;0.001</td></tr><tr><td align="left" valign="top" charoff="50">Difficulty getting erection</td><td align="center" valign="top" charoff="50">553</td><td align="center" valign="top" charoff="50">28&#x0002f;