pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>D</given-names></name><name><surname>Murphy</surname><given-names>B</given-names></name><name><surname>Sung</surname><given-names>R</given-names></name><name><surname>Bromberg</surname><given-names>JS</given-names></name></person-group><article-title>Adaptive and innate immune responses to gene transfer vectors: role of cytokines and chemokines in vector function</article-title><source>Gene Ther</source><year>2003</year><volume>10</volume><fpage>991</fpage><lpage>998</lpage><!--PubMed citation query: 'Gene Ther||10|991||bib13|'--><pub-id pub-id-type="pmid">12756420</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chung</surname><given-names>I</given-names></name><name><surname>Schwartz</surname><given-names>PE</given-names></name><name><surname>Crystal</surname><given-names>RG</given-names></name><name><surname>Pizzorno</surname><given-names>G</given-names></name><name><surname>Leavitt</surname><given-names>J</given-names></name><name><surname>Deisseroth</surname><given-names>AB</given-names></name></person-group><article-title>Use of <sc>L</sc>-plastin promoter to develop an adenoviral system that confers transgene expression in ovarian cancer cells but not in normal mesothelial cells</article-title><source>Cancer Gene Ther</source><year>1999</year><volume>6</volume><fpage>99</fpage><lpage>106</lpage><!--PubMed citation query: 'Cancer Gene Ther||6|99||bib14|'--><pub-id pub-id-type="pmid">10195877</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cichon</surname><given-names>G</given-names></name><name><surname>Boeckh-Herwig</surname><given-names>S</given-names></name><name><surname>Kuemin</surname><given-names>D</given-names></name><name><surname>Hoff