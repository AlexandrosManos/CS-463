up-type="author"><name><surname>Lanvers</surname><given-names>C</given-names></name><name><surname>Reinhardt</surname><given-names>D</given-names></name><name><surname>Dubbers</surname><given-names>A</given-names></name><name><surname>Wagner-Bohn</surname><given-names>A</given-names></name><name><surname>Creutzig</surname><given-names>U</given-names></name><name><surname>Ritter</surname><given-names>J</given-names></name><name><surname>Boos</surname><given-names>J</given-names></name></person-group><article-title>Pharmacology of all-<italic>trans</italic>-retinoic acid in children with acute promyelocytic leukemia</article-title><source>Med Pediatr Oncol</source><year>2003</year><volume>40</volume><fpage>293</fpage><lpage>301</lpage><!--PubMed citation query: 'Med Pediatr Oncol||40|293||bib11|'--><pub-id pub-id-type="pmid">12652617</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matthay</surname><given-names>KK</given-names></name><name><surname>Reynolds</surname><given-names>CP</given-names></name></person-group><article-title>Is there a role for retinoids to treat minimal residual disease in neuroblastoma</article-title><source>Brit J Cancer</source><year>2000</year><volume>83</volume><fpage>1121</fpage><lpage>1123</lpage><!--PubMed citation query: 'Brit J Cancer||83|1121||bib12|'--><pub-id pub-id-type="pmid">11027422</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matthay</surname><given-names>KK</given-names></name><name><surname>Villablanca</surname><given-names>JG</given-names></name><name><surname>Seeger</surname><given-names>RC</given-names></name><name><surname>Stram</surname><given-names>DO</given-names></name><name><surname>Harris</surname><given-names>RE</given-names></name><name><surname>Ramsay</surname><given-names>NK</given-names></name><name><surname>Swift</surname><given-names>P</given-