>C1405</fpage><lpage>C1410</lpage><!--PubMed citation query: 'Am J Physiol||276|C1405||bib8|'--><pub-id pub-id-type="pmid">10362604</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buccoliero</surname><given-names>AM</given-names></name><name><surname>Caldarella</surname><given-names>A</given-names></name><name><surname>Ammannati</surname><given-names>F</given-names></name><name><surname>Mennonna</surname><given-names>P</given-names></name><name><surname>Taddei</surname><given-names>A</given-names></name><name><surname>Taddei</surname><given-names>GL</given-names></name></person-group><article-title>Extraventricular neurocytoma: morphological and immunohistochemical considerations on differential diagnosis</article-title><source>Pathol Res Pract</source><year>2002</year><volume>198</volume><fpage>627</fpage><lpage>633</lpage><!--PubMed citation query: 'Pathol Res Pract||198|627||bib9|'--><pub-id pub-id-type="pmid">12440786</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cherubini</surname><given-names>A</given-names></name><name><surname>Hofmann</surname><given-names>G</given-names></name><name><surname>Pillozzi</surname><given-names>S</given-names></name><name><surname>Guasti</surname><given-names>L</given-names></name><name><surname>Crociani</surname><given-names>O</given-names></name><name><surname>Cilia</surname><given-names>E</given-names></name><name><surname>Di Stefano</surname><given-names>P</given-names></name><name><surname>Degani</surname><given-names>S</given-names></name><name><surname>Balzi</surname><given-names>M</given-names></name><name><surname>Olivotto</surname><given-names>M</given-names></name><name><surname>Wanke</surname><given-names>E</given-names></name><name><surname>Becchetti</surname><given-names>A</given-names></name><name><surname>Defilippi</surname><given-names>P</given-name