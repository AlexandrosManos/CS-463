on citation-type="book"><person-group person-group-type="author"><name><surname>Sobin</surname><given-names>LH</given-names></name><name><surname>Wittekind</surname><given-names>CH</given-names></name></person-group><article-title/><source>TNM Classification of Malignant Tumours</source><year>2003</year><publisher-name>New York: John Wiley</publisher-name>6th edn</citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Todorov</surname><given-names>P</given-names></name><name><surname>Cariuk</surname><given-names>P</given-names></name><name><surname>McDevitt</surname><given-names>T</given-names></name><name><surname>Coles</surname><given-names>B</given-names></name><name><surname>Fearon</surname><given-names>K</given-names></name><name><surname>Tisdale</surname><given-names>M</given-names></name></person-group><article-title>Characterisation of a cachectic factor</article-title><source>Nature</source><year>1996</year><volume>379</volume><fpage>739</fpage><lpage>742</lpage><!--PubMed citation query: 'Nature||379|739||bib15|'--><pub-id pub-id-type="pmid">8602222</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Todorov</surname><given-names>PT</given-names></name><name><surname>Deacon</surname><given-names>M</given-names></name><name><surname>Tisdale</surname><given-names>MJ</given-names></name></person-group><article-title>Structural analysis of a tumour-produced sulfated glycoprotein capable of initiating muscle protein degradation</article-title><source>J Biol Chem</source><year>1997</year><volume>272</volume><supplement>19</supplement><fpage>12279</fpage><lpage>12288</lpage><!--PubMed citation query: 'J Biol Chem||272|12279||bib16|'--><pub-id pub-id-type="pmid">9139670</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Todorov</surname><given