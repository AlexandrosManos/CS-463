pub-id-type="pmid">16024112</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fang</surname><given-names>X</given-names></name><name><surname>Stachowiak</surname><given-names>EK</given-names></name><name><surname>Dunham-Ems</surname><given-names>SM</given-names></name><name><surname>Klejbor</surname><given-names>I</given-names></name><name><surname>Stachowiak</surname><given-names>MK</given-names></name></person-group><article-title>Control of CREB-binding protein signaling by nuclear fibroblast growth factor receptor-1: a novel mechanism of gene regulation</article-title><source>J Biol Chem</source><year>2005</year><volume>280</volume><fpage>28451</fpage><lpage>28462</lpage><!--PubMed citation query: 'J Biol Chem||280|28451||bib8|'--><pub-id pub-id-type="pmid">15929978</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giri</surname><given-names>DK</given-names></name><name><surname>Ali-Seyed</surname><given-names>M</given-names></name><name><surname>Li</surname><given-names>L-Y</given-names></name><name><surname>Lee</surname><given-names>D-F</given-names></name><name><surname>Ling</surname><given-names>P</given-names></name><name><surname>Bartholomeusz</surname><given-names>G</given-names></name><name><surname>Wang</surname><given-names>S-C</given-names></name><name><surname>Hung</surname><given-names>M-C</given-names></name></person-group><article-title>Endosomal Transport of ErbB-2: mechanism for nuclear entry of the cell surface receptor</article-title><source>Mol Cell Biol</source><year>2005</year><volume>25</volume><fpage>11005</fpage><lpage>11018</lpage><!--PubMed citation query: 'Mol Cell Biol||25|11005||bib9|'--><pub-id pub-id-type="pmid">16314522</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gupta</surname><given-na