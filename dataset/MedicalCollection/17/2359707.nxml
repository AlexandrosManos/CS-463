e><surname>de Koning</surname><given-names>HJ</given-names></name><collab>National Evaluation Team for Breast Cancer Screening (NETB)</collab></person-group><article-title>Decreased rates of advanced breast cancer due to mammography screening in the Netherlands</article-title><source>Br J Cancer</source><year>2004</year><volume>91</volume><fpage>861</fpage><lpage>867</lpage><!--PubMed citation query: 'Br J Cancer||91|861||bib9|'--><pub-id pub-id-type="pmid">15292936</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gill</surname><given-names>PG</given-names></name><name><surname>Farshid</surname><given-names>G</given-names></name><name><surname>Luke</surname><given-names>CG</given-names></name><name><surname>Roder</surname><given-names>DM</given-names></name></person-group><article-title>Detection by screening mammography is a powerful independent predictor of survival in women diagnosed with breast cancer</article-title><source>Breast</source><year>2004</year><volume>13</volume><fpage>15</fpage><lpage>22</lpage><!--PubMed citation query: 'Breast||13|15||bib10|'--><pub-id pub-id-type="pmid">14759711</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grann</surname><given-names>V</given-names></name><name><surname>Troxel</surname><given-names>AB</given-names></name><name><surname>Zojwalla</surname><given-names>N</given-names></name><name><surname>Hershman</surname><given-names>D</given-names></name><name><surname>Glied</surname><given-names>SA</given-names></name><name><surname>Jacobson</surname><given-names>JS</given-names></name></person-group><article-title>Regional and racial disparities in breast cancer-specific mortality</article-title><source>Soc Sci Med</source><year>2006</year><volume>62</volume><fpage>337</fpage><lpage>347</lpage><!--PubMed citation query: 'Soc Sci Med||62|337||bib11|'--><pub-id pub-id-type="pmid">16051406</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Joensuu</surname><given-names>H</given-names></name><name><surname>Lehtim&#x000e4;ki</surname><given-names>T</given-names></name><name><surname>Holli</surname><given-names>K</given-names></name><name><surname>Elomaa</surname><given-names>L</given-names></name><name><surname>Turpeenniemi-Hujanen</surname><given-names>T</given-names></name><name><surname>Kataja</surname><given-names>V</given-names></name><name><surname>Anttila</surname><given-names>A</given-names></name><name><surname>Lundin</surname><given-names>M</given-names></name><name><surname>Isola</surname><given-names>J</given-names></name><name><surname>Lundin</surname><given-names>J</given-names></name></person-group><article-title>Risk for distant recurrence of breast cancer detected by mammography screening or other methods</article-title><source>JAMA</source><year>2004</year><volume>292</volume><fpage>1064</fpage><lpage>1073</lpage><!--PubMed citation query: 'JAMA||292|1064||bib12|'--><pub-id pub-id-type="pmid">15339900</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaffashian</surname><given-names>F</given-names></name><name><surname>Godward</surname><given-names>S</given-names></name><name><surname>Davies</surname><given-names>T</given-names></name><name><surname>Solomon</surname><given-names>L</given-names></name><name><surname>McCann</surname><given-names>J</given-names></name><name><surname>Duffy</surname><given-names>SW</given-names></name></person-group><article-title>Socioeconomic effects on breast cancer survival: proportion attributable to stage and morphology</article-title><source>Br J Cancer</source><year>2003</year><volume>89</volume><fpage>1693</fpage><lpage>1696</lpage><!--PubMed citation query: 'Br J Cancer||89|1693||bib13|'--><pub-id pub-id-type="pmid