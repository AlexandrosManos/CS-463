e><name><surname>Connor</surname><given-names>RE</given-names></name><name><surname>David</surname><given-names>R</given-names></name><name><surname>Davies</surname><given-names>J</given-names></name><name><surname>Davis</surname><given-names>C</given-names></name><name><surname>Davis</surname><given-names>J</given-names></name><name><surname>Delgado</surname><given-names>O</given-names></name><name><surname>Deshazo</surname><given-names>D</given-names></name><name><surname>Dhami</surname><given-names>P</given-names></name><name><surname>Ding</surname><given-names>Y</given-names></name><name><surname>Dinh</surname><given-names>DL</given-names></name><name><surname>Weinstock</surname><given-names>G</given-names></name><name><surname>Sulston</surname><given-names>JE</given-names></name><name><surname>Durbin</surname><given-names>R</given-names></name><name><surname>Hubbard</surname><given-names>T</given-names></name><name><surname>Gibbs</surname><given-names>RA</given-names></name><name><surname>Beck</surname><given-names>S</given-names></name><name><surname>Rogers</surname><given-names>J</given-names></name><name><surname>Bentley</surname><given-names>DR</given-names></name></person-group><article-title>The DNA sequence of the human X chromosome</article-title><source>Nature</source><year>2005</year><volume>434</volume><fpage>325</fpage><lpage>337</lpage><!--PubMed citation query: 'Nature||434|325||bib28|'--><pub-id pub-id-type="pmid">15772651</pub-id></citation></ref><ref id="bib29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ruschenburg</surname><given-names>I</given-names></name><name><surname>Kubitz</surname><given-names>A</given-names></name><name><surname>Schlott</surname><given-names>T</given-names></name><name><surname>Korabiowska</surname><given-names>M</given-names></name><name><surname>Droese</surname><given-names>M</given-names></name></person-group><article-title>MAGE-1, GAGE-1/-2 gene expression in FNAB of c