"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Highnam</surname><given-names>R</given-names></name><name><surname>Brady</surname><given-names>M</given-names></name></person-group><article-title/><source>Mammographic Image Analysis</source><year>1999</year><publisher-name>Kluwer Academic Publishers: Dordrecht</publisher-name></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Highnam</surname><given-names>R</given-names></name><name><surname>Pan</surname><given-names>X</given-names></name><name><surname>Warren</surname><given-names>R</given-names></name><name><surname>Jeffreys</surname><given-names>M</given-names></name><name><surname>Davey Smith</surname><given-names>G</given-names></name><name><surname>Brady</surname><given-names>M</given-names></name></person-group><article-title>Breast composition measurements using retrospective standard mammogram form (SMF)</article-title><source>Phys Med Biol</source><year>2006</year><volume>51</volume><fpage>2695</fpage><lpage>2713</lpage><!--PubMed citation query: 'Phys Med Biol||51|2695||bib15|'--><pub-id pub-id-type="pmid">16723760</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jakes</surname><given-names>R</given-names></name><name><surname>Duffy</surname><given-names>S</given-names></name><name><surname>Ng</surname><given-names>F</given-names></name><name><surname>Gao</surname><given-names>F</given-names></name><name><surname>Ng</surname><given-names>E</given-names></name></person-group><article-title>Mammographic parenchymal patterns and risk of breast cancer at and after a prevalence screen in Singaporean women</article-title><source>Int J Epidemiol</source><year>2000</year><volume>29</volume><fpage>11</fpage><lpage>19</lpage><!--PubMed citation query: 'Int J Epidemiol||29|11||bib16|'--><pub-id pub-id-type="pmid">10750598</pu