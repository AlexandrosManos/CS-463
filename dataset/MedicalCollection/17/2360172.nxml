ven-names></name><name><surname>Loddo</surname><given-names>M</given-names></name><name><surname>Munson</surname><given-names>P</given-names></name><name><surname>Williams</surname><given-names>GH</given-names></name><name><surname>Stoeber</surname><given-names>K</given-names></name></person-group><article-title>DNA replication licensing in peripheral B-cell lymphoma</article-title><source>J Pathol</source><year>2005</year><volume>205</volume><fpage>318</fpage><lpage>328</lpage><!--PubMed citation query: 'J Pathol||205|318||bib29|'--><pub-id pub-id-type="pmid">15682442</pub-id></citation></ref><ref id="bib30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Padmanabhan</surname><given-names>V</given-names></name><name><surname>Callas</surname><given-names>P</given-names></name><name><surname>Philips</surname><given-names>G</given-names></name><name><surname>Trainer</surname><given-names>TD</given-names></name><name><surname>Beatty</surname><given-names>BG</given-names></name></person-group><article-title>DNA replication regulation protein Mcm7 as a marker of proliferation in prostate cancer</article-title><source>J Clin Pathol</source><year>2004</year><volume>57</volume><fpage>1057</fpage><lpage>1062</lpage><!--PubMed citation query: 'J Clin Pathol||57|1057||bib30|'--><pub-id pub-id-type="pmid">15452160</pub-id></citation></ref><ref id="bib31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pearson</surname><given-names>G</given-names></name><name><surname>English</surname><given-names>JM</given-names></name><name><surname>White</surname><given-names>MA</given-names></name><name><surname>Cobb</surname><given-names>MH</given-names></name></person-group><article-title>ERK5 and ERK2 cooperate to regulate NF-kappaB and cell transformation</article-title><source>J Biol Chem</source><year>2001</year><volume>276</volume><fpage>7927</fpage><lpage>7931</lpage><!--PubMed citation query: 'J Biol Chem||276|7927||bib31|'--><pub-id pub-id-type="pmid">11118448</pub-id></citation></ref><ref id="bib32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ren</surname><given-names>B</given-names></name><name><surname>Yu</surname><given-names>G</given-names></name><name><surname>Tseng</surname><given-names>GC</given-names></name><name><surname>Cieply</surname><given-names>K</given-names></name><name><surname>Gavel</surname><given-names>T</given-names></name><name><surname>Nelson</surname><given-names>J</given-names></name><name><surname>Michalopoulos</surname><given-names>G</given-names></name><name><surname>Yu</surname><given-names>YP</given-names></name><name><surname>Luo</surname><given-names>JH</given-names></name></person-group><article-title>MCM7 amplification and overexpression are associated with prostate cancer progression</article-title><source>Oncogene</source><year>2006</year><volume>25</volume><fpage>1090</fpage><lpage>1098</lpage><!--PubMed citation query: 'Oncogene||25|1090||bib32|'--><pub-id pub-id-type="pmid">16247466</pub-id></citation></ref><ref id="bib33"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shetty</surname><given-names>A</given-names></name><name><surname>Loddo</surname><given-names>M</given-names></name><name><surname>Fanshawe</surname><given-names>T</given-names></name><name><surname>Prevost</surname><given-names>AT</given-names></name><name><surname>Sainsbury</surname><given-names>R</given-names></name><name><surname>Williams</surname><given-names>GH</given-names></name><name><surname>Stoeber</surname><given-names>K</given-names></name></person-group><article-title>DNA replication licensing and cell cycle kinetics of normal and neoplastic breast</article-title><source>Br J Cancer</source><year>2005</year><volume>93</volume><fpage>1295</fpage><lpage>1300</lpage><!--PubMed citation query: 'Br J Cancer||93|1295||bib33|'--><pub-id pub-id-type="pmid">162786