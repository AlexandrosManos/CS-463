 query: 'Clin Cancer Res||10|5367||bib22|'--><pub-id pub-id-type="pmid">15328174</pub-id></citation></ref><ref id="bib23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oh</surname><given-names>AS</given-names></name><name><surname>Lorant</surname><given-names>LA</given-names></name><name><surname>Holloway</surname><given-names>JN</given-names></name><name><surname>Miller</surname><given-names>DL</given-names></name><name><surname>Kern</surname><given-names>FG</given-names></name><name><surname>El-Ashry</surname><given-names>D</given-names></name></person-group><article-title>Hyperactivation of MAPK induces loss of ERa expression in breast cancer cells</article-title><source>Mol Endocrinol</source><year>2001</year><volume>15</volume><fpage>1344</fpage><lpage>1359</lpage><!--PubMed citation query: 'Mol Endocrinol||15|1344||bib23|'--><pub-id pub-id-type="pmid">11463858</pub-id></citation></ref><ref id="bib24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pratt</surname><given-names>MA</given-names></name><name><surname>Bishop</surname><given-names>TE</given-names></name><name><surname>White</surname><given-names>D</given-names></name><name><surname>Yasvinski</surname><given-names>G</given-names></name><name><surname>Menard</surname><given-names>M</given-names></name><name><surname>Niu</surname><given-names>MY</given-names></name><name><surname>Clarke</surname><given-names>R</given-names></name></person-group><article-title>Estrogen withdrawal-induced NF-kappaB activity and Bcl-3 expression in breast cancer cells: roles in growth and hormone independence</article-title><source>Mol Cell Biol</source><year>2003</year><volume>23</volume><fpage>6887</fpage><lpage>6900</lpage><!--PubMed citation query: 'Mol Cell Biol||23|6887||bib24|'--><pub-id pub-id-type="pmid">12972607</pub-id></citation></ref><ref id="bib25"><citation citation-type="journal"><person-group person-group-type="author"><n