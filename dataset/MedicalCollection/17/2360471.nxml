></name><name><surname>Romanowski</surname><given-names>B</given-names></name><name><surname>Roteli-Martins</surname><given-names>CM</given-names></name><name><surname>Jenkins</surname><given-names>D</given-names></name><name><surname>Schuind</surname><given-names>A</given-names></name><name><surname>Costa Clemens</surname><given-names>SA</given-names></name><name><surname>Dubin</surname><given-names>G</given-names></name></person-group><article-title>Sustained efficacy up to 4.5 years of a bivalent L1 virus-like particle vaccine against human papillomavirus types 16 and 18: follow-up from a randomised control trial</article-title><source>Lancet</source><year>2006</year><volume>367</volume><fpage>1247</fpage><lpage>1255</lpage><!--PubMed citation query: 'Lancet||367|1247||bib22|'--><pub-id pub-id-type="pmid">16631880</pub-id></citation></ref><ref id="bib23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ho</surname><given-names>GY</given-names></name><name><surname>Kadish</surname><given-names>AS</given-names></name><name><surname>Burk</surname><given-names>RD</given-names></name><name><surname>Basu</surname><given-names>J</given-names></name><name><surname>Palan</surname><given-names>PR</given-names></name><name><surname>Mikhail</surname><given-names>M</given-names></name><name><surname>Romney</surname><given-names>SL</given-names></name></person-group><article-title>HPV 16 and cigarette smoking as risk factors for high-grade cervical intra-epithelial neoplasia</article-title><source>Int J Cancer</source><year>1998</year><volume>78</volume><fpage>281</fpage><lpage>285</lpage><!--PubMed citation query: 'Int J Cancer||78|281||bib23|'--><pub-id pub-id-type="pmid">9766558</pub-id></citation></ref><ref id="bib24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hughes</surname><given-names>JP</given-names></name><name><surname>Garnett</surname><given-names>GP</given-names></name><name><s