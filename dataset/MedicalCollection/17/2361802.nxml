source>Nature</source><year>1997</year><volume>387</volume><fpage>733</fpage><lpage>736</lpage><!--PubMed citation query: 'Nature||387|733||bib10|'--><pub-id pub-id-type="pmid">9192902</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kang</surname><given-names>YK</given-names></name><name><surname>Guermah</surname><given-names>M</given-names></name><name><surname>Yuan</surname><given-names>CX</given-names></name><name><surname>Roeder</surname><given-names>RG</given-names></name></person-group><article-title>The TRAP/Mediator coactivator complex interacts directly with estrogen receptors alpha and beta through the TRAP220 subunit and directly enhances estrogen receptor function <italic>in vitro</italic></article-title><source>Proc Natl Acad Sci USA</source><year>2002</year><volume>99</volume><fpage>2642</fpage><lpage>2647</lpage><!--PubMed citation query: 'Proc Natl Acad Sci USA||99|2642||bib11|'--></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Keriel</surname><given-names>A</given-names></name><name><surname>Stary</surname><given-names>A</given-names></name><name><surname>Sarasin</surname><given-names>A</given-names></name><name><surname>Rochette-Egly</surname><given-names>C</given-names></name><name><surname>Egly</surname><given-names>JM</given-names></name></person-group><article-title>XPD mutations prevent TFIIH-dependent transactivation by nuclear receptors and phosphorylation of RARalpha</article-title><source>Cell</source><year>2002</year><volume>1</volume><fpage>125</fpage><lpage>135</lpage><!--PubMed citation query: 'Cell||1|125||bib12|'--></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kobayashi</surname><given-names>Y</given-names></name><name><surname>Kitamoto</surname><given-names>T</given-names></name><name><surname>Masuhiro