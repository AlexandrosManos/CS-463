e><name><surname>Fischel</surname><given-names>JL</given-names></name><name><surname>Formento</surname><given-names>P</given-names></name><name><surname>Hofman</surname><given-names>P</given-names></name><name><surname>Milano</surname><given-names>G</given-names></name></person-group><article-title>Enhanced tumour antiangiogenic effects when combining gefitinib with the antivascular agent ZD6126</article-title><source>Br J Cancer</source><year>2006</year><volume>95</volume><fpage>722</fpage><lpage>728</lpage><!--PubMed citation query: 'Br J Cancer||95|722||bib5|'--><pub-id pub-id-type="pmid">16940984</pub-id></citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chaplin</surname><given-names>DJ</given-names></name><name><surname>Horsman</surname><given-names>MR</given-names></name><name><surname>Siemann</surname><given-names>DW</given-names></name></person-group><article-title>Current development status of small-molecule vascular disrupting agents</article-title><source>Curr Opin Investig Drugs</source><year>2006</year><volume>7</volume><fpage>522</fpage><lpage>528</lpage><!--PubMed citation query: 'Curr Opin Investig Drugs||7|522||bib6|'--></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Davis</surname><given-names>PD</given-names></name><name><surname>Dougherty</surname><given-names>GJ</given-names></name><name><surname>Blakey</surname><given-names>DC</given-names></name><name><surname>Galbraith</surname><given-names>SM</given-names></name><name><surname>Tozer</surname><given-names>GM</given-names></name><name><surname>Holder</surname><given-names>AL</given-names></name><name><surname>Naylor</surname><given-names>MA</given-names></name><name><surname>Nolan</surname><given-names>J</given-names></name><name><surname>Stratford</surname><given-names>MR</given-names></name><name><surname>Chaplin</surname><given-names>DJ</given-name