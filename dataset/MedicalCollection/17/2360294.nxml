n-group><article-title>The cost utility of bisphosphonate treatment in established osteoporosis</article-title><source>Q J Med</source><year>2002</year><volume>95</volume><fpage>305</fpage><lpage>311</lpage><!--PubMed citation query: 'Q J Med||95|305||bib15|'--></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kamby</surname><given-names>C</given-names></name><name><surname>Sengel&#x000f8;v</surname><given-names>L</given-names></name></person-group><article-title>Pattern of dissemination and survival following isolated locoregional recurrence of breast cancer</article-title><source>Breast Cancer Res Treat</source><year>1997</year><volume>45</volume><fpage>181</fpage><lpage>192</lpage><!--PubMed citation query: 'Breast Cancer Res Treat||45|181||bib16|'--><pub-id pub-id-type="pmid">9342443</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Karnon</surname><given-names>J</given-names></name><name><surname>Brown</surname><given-names>J</given-names></name></person-group><article-title>Tamoxifen plus chemotherapy versus tamoxifen alone as adjuvant therapies for node-positive postmenopausal women with early breast cancer: a stochastic economic evaluation</article-title><source>PharmacoEconomics</source><year>2002</year><volume>20</volume><fpage>119</fpage><lpage>137</lpage><!--PubMed citation query: 'PharmacoEconomics||20|119||bib17|'--><pub-id pub-id-type="pmid">11888364</pub-id></citation></ref><ref id="bib18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lamerato</surname><given-names>L</given-names></name><name><surname>Havstad</surname><given-names>S</given-names></name><name><surname>Gandhi</surname><given-names>SK</given-names></name><name><surname>Jones</surname><given-names>DA</given-names></name></person-group><article-title/><source>The Economic Burden of Breast Cancer R