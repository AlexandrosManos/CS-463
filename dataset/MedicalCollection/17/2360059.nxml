/caption><table frame="hsides" rules="groups" border="1" width="85%"><colgroup><col align="left"/><col align="center"/><col align="center"/><col align="center"/></colgroup><thead valign="bottom"><tr><th align="left" valign="top" charoff="50">&#x000a0;</th><th align="center" valign="top" charoff="50"><bold>Unadjusted HR (95&#x00025; CI)</bold></th><th align="center" valign="top" charoff="50"><bold>Age-adjusted HR (95&#x00025; CI)</bold></th><th align="center" valign="top" charoff="50"><bold>Age-and stage adjusted HR (95&#x00025; CI)</bold></th></tr></thead><tbody valign="top"><tr><td align="left" valign="top" charoff="50">All patients</td><td align="center" valign="top" charoff="50">1.14 (1.11&#x02013;1.16)</td><td align="center" valign="top" charoff="50">1.11 (1.08&#x02013;1.13)</td><td align="center" valign="top" charoff="50">1.08 (1.05&#x02013;1.11)</td></tr><tr><td align="left" valign="top" charoff="50">Breast-conserving surgery group</td><td align="center" valign="top" charoff="50">1.13 (1.07&#x02013;1.19)</td><td align="center" valign="top" charoff="50">1.14 (1.08&#x02013;1.20)</td><td align="center" valign="top" charoff="50">1.13 (1.07&#x02013;1.19)</td></tr><tr><td align="left" valign="top" charoff="50">Mastectomy group</td><td align="center" valign="top" charoff="50">1.05 (1.01&#x02013;1.09)</td><td align="center" valign="top" charoff="50">1.04 (1.00&#x02013;1.08)</td><td align="center" valign="top" charoff="50">1.04 (1.00&#x02013;1.08)</td></tr><tr><td align="left" valign="top" charoff="50">No surgery group</td><td align="center" valign="top" charoff="50">1.04 (1.00&#x02013;1.08)</td><td align="center" valign="top" charoff="50">1.04 (1.00&#x02013;1.08)</td><td align="center" valign="top" charoff="50">1.03 (0.98&#x02013;1.08)</td></tr></tbody></table><table-wrap-foot><fn id="t3-fn1"><label/><p>CI&#x0003d;confidence interval; HR&#x0003d;hazard ratio.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>