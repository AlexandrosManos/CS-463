="50">All cancers (ICD-9: 140&#x02013;208, ICD-10: C0&#x02013;C97)</td><td align="char" valign="top" char="." charoff="50">2357</td><td align="char" valign="top" char="." charoff="50">6.38</td><td align="char" valign="top" char="." charoff="50">5.74&#x02013;7.15</td></tr><tr><td align="left" valign="top" charoff="50">Endometrial cancer (ICD-9: 182, ICD-10: C54)</td><td align="char" valign="top" char="." charoff="50">1529</td><td align="char" valign="top" char="." charoff="50">277</td><td align="char" valign="top" char="." charoff="50">150&#x02013;1682</td></tr><tr><td align="left" valign="top" charoff="50">Breast cancer (ICD-9: 174, ICD-10: C50)</td><td align="char" valign="top" char="." charoff="50">114</td><td align="char" valign="top" char="." charoff="50">2.05</td><td align="char" valign="top" char="." charoff="50">1.51&#x02013;2.90</td></tr><tr><td align="left" valign="top" charoff="50">Ovarian cancer (ICD-9: 183, ICD-10: C56)</td><td align="char" valign="top" char="." charoff="50">87</td><td align="char" valign="top" char="." charoff="50">4.26</td><td align="char" valign="top" char="." charoff="50">2.77&#x02013;7.74</td></tr><tr><td align="left" valign="top" charoff="50">All circulatory disease (ICD-9: 390&#x02013;459, ICD-10: I00&#x02013;I99)</td><td align="char" valign="top" char="." charoff="50">795</td><td align="char" valign="top" char="." charoff="50">1.10</td><td align="char" valign="top" char="." charoff="50">1.00&#x02013;1.22</td></tr><tr><td align="left" valign="top" charoff="50">Ischaemic heart disease (ICD-9: 410&#x02013;414, ICD-10: I20&#x02013;I25)</td><td align="char" valign="top" char="." charoff="50">394</td><td align="char" valign="top" char="." charoff="50">1.10</td><td align="char" valign="top" char="." charoff="50">0.96&#x02013;1.27</td></tr><tr><td align="left" valign="top" charoff="50">Cerebrovascular disease (ICD-9: 430&#x02013;438, ICD-10: I60&#x02013;I69, G45)</td><td align="char" valign="top" char="." charoff="50">238</td><td align="