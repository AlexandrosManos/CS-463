><article-title>CD4(&#x0002b;)CD25(&#x0002b;) regulatory lymphocytes require interleukin 10 to interrupt colon carcinogenesis in mice</article-title><source>Cancer Res</source><year>2003</year><volume>63</volume><fpage>6042</fpage><lpage>6050</lpage><!--PubMed citation query: 'Cancer Res||63|6042||bib6|'--><pub-id pub-id-type="pmid">14522933</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fodde</surname><given-names>R</given-names></name><name><surname>Smits</surname><given-names>R</given-names></name><name><surname>Clevers</surname><given-names>H</given-names></name></person-group><article-title>APC, signal transduction and genetic instability in colorectal cancer</article-title><source>Nat Rev Cancer</source><year>2001</year><volume>1</volume><fpage>55</fpage><lpage>67</lpage><!--PubMed citation query: 'Nat Rev Cancer||1|55||bib7|'--><pub-id pub-id-type="pmid">11900252</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Funk</surname><given-names>JO</given-names></name></person-group><article-title>Cancer cell cycle control</article-title><source>Anticancer Res</source><year>1999</year><volume>19</volume><fpage>4772</fpage><lpage>4780</lpage><!--PubMed citation query: 'Anticancer Res||19|4772||bib8|'--><pub-id pub-id-type="pmid">10697591</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Galizia</surname><given-names>G</given-names></name><name><surname>Lieto</surname><given-names>E</given-names></name><name><surname>De Vita</surname><given-names>F</given-names></name><name><surname>Romano</surname><given-names>C</given-names></name><name><surname>Orditura</surname><given-names>M</given-names></name><name><surname>Castellano</surname><given-names>P</given-names></name><name><surname>Imperatore</surname><given-names>V</given-names></name><name><surname>Infusino</surname><given-names>S</given-names></name><name><surname>Catalano</surname><given-names>G</given-names></name><name><surname>Pignatelli</surname><given-names>C</given-names></name></person-group><article-title>Circulating levels of interleukin-10 and interleukin-6 in gastric and colon cancer patients before and after surgery: relationship with radicality and outcome</article-title><source>J Interferon Cytokine Res</source><year>2002</year><volume>22</volume><fpage>473</fpage><lpage>482</lpage><!--PubMed citation query: 'J Interferon Cytokine Res||22|473||bib9|'--><pub-id pub-id-type="pmid">12034030</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garrido</surname><given-names>F</given-names></name><name><surname>Algarra</surname><given-names>I</given-names></name></person-group><article-title>MHC antigens and tumor escape from immune surveillance</article-title><source>Adv Cancer Res</source><year>2001</year><volume>83</volume><fpage>117</fpage><lpage>158</lpage><!--PubMed citation query: 'Adv Cancer Res||83|117||bib10|'--><pub-id pub-id-type="pmid">11665717</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heriot</surname><given-names>AG</given-names></name><name><surname>Marriott</surname><given-names>JB</given-names></name><name><surname>Cookson</surname><given-names>S</given-names></name><name><surname>Kumar</surname><given-names>D</given-names></name><name><surname>Dalgleish</surname><given-names>AG</given-names></name></person-group><article-title>Reduction in cytokine production in colorectal cancer patients: association with stage and reversal by resection</article-title><source>Br J Cancer</source><year>2000</year><volume>82</volume><fpage>1009</fpage><lpage>1012</lpage><!--PubMed citation query: 'Br J Cancer||82|1009||bib11|'--><pub-id pub-id-type="pmid">10737381</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Higaki</surname><given-names>S</given-names></name><name><surname>Akazawa</surname><given-names>A</given-names></name><name><surname>Nakamura</surname><given-names>H</given-names></name><name><surname>Yanai</surname><given-names>H</given-names></name><name><surname>Yoshida</surname><given-names>T</given-names></name><name><surname>Okita</surname><given-names>K</given-names></name></person-group><article-title>Metaplastic polyp of the colon develops in response to inflammation</article-title><source>J Gastroenterol Hepatol</source><year>1999</year><volume>14</volume><fpage>709</fpage><lpage>714</lpage><!--PubMed citation query: 'J Gastroenterol Hepatol||14|709||bib12|'--><pub-id pub-id-type="pmid">10440217</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Itzkowitz</surname><given-names>SH</given-names></name><name><surname>Yio</surname><given-names>X</given-names></name></person-group><article-title>Inflammation and cancer IV. Colorectal cancer in inflammatory bowel disease: the role of inflammation</article-title><source>Am J Physiol Gastrointest Liver Physiol</source><year>2004</year><volume>287</volume><fpage>G7</fpage><lpage>17</lpage><!--PubMed citation query: 'Am J Physiol Gastrointest Liver Physiol||287|G7||bib13|'--><pub-id pub-id-type="pmid">15194558</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jacobson-Brown</surname><given-names>P</given-names></name><name><surname>Neuman</surname><given-names>MG</given-names></name></person-group><article-title>Colorectal polyposis and immune-based therapies</article-title><source>Can J Gastroenterol</source><year>2004</year><volume>18</volume><fpage>239</fpage><lpage>249</lpage><!--PubMed citation query: 'Can J Gastroenterol||