nter" valign="top" charoff="50">0.76</td><td align="center" valign="top" charoff="50">2285</td><td align="center" valign="top" charoff="50">0.99 (0.90&#x02013;1.08)</td><td align="center" valign="top" charoff="50">0.77</td></tr><tr><td align="left" valign="top" charoff="50">rs608995 A/T</td><td align="center" valign="top" charoff="50">252</td><td align="center" valign="top" charoff="50">1.00 (0.81&#x02013;1.23)</td><td align="center" valign="top" charoff="50">0.98</td><td align="center" valign="top" charoff="50">528</td><td align="center" valign="top" charoff="50">1.14 (0.99&#x02013;1.31)</td><td align="center" valign="top" charoff="50">0.076</td><td align="center" valign="top" charoff="50">262</td><td align="center" valign="top" charoff="50">1.09 (0.89&#x02013;1.34)</td><td align="center" valign="top" charoff="50">0.41</td><td align="center" valign="top" charoff="50">1966</td><td align="center" valign="top" charoff="50">1.03 (0.94-1.12)</td><td align="center" valign="top" charoff="50">0.53</td></tr></tbody></table><table-wrap-foot><fn id="t2b-fn1"><label/><p>CI=confidence interval; OR=odds ratio; OCAC=Ovarian Cancer Association Consortium; PGR=progesterone receptor gene; SNP=single nucleotide polymorphism; N=number of cases.</p></fn><fn id="t2b-fn2"><label>a</label><p>All analyses stratified on study, race and age.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>