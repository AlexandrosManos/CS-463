 J Clin</source><year>2006</year><volume>56</volume><fpage>106</fpage><lpage>130</lpage><!--PubMed citation query: 'CA Cancer J Clin||56|106||bib10|'--><pub-id pub-id-type="pmid">16514137</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jimeno</surname><given-names>A</given-names></name><name><surname>Kulesza</surname><given-names>P</given-names></name><name><surname>Kincaid</surname><given-names>E</given-names></name><name><surname>Bouaroud</surname><given-names>N</given-names></name><name><surname>Chan</surname><given-names>A</given-names></name><name><surname>Forastiere</surname><given-names>A</given-names></name><name><surname>Brahmer</surname><given-names>J</given-names></name><name><surname>Clark</surname><given-names>DP</given-names></name><name><surname>Hidalgo</surname><given-names>M</given-names></name></person-group><article-title>C-fos assessment as a marker of anti-epidermal growth factor receptor effect</article-title><source>Cancer Res</source><year>2006</year><volume>66</volume><fpage>2385</fpage><lpage>2390</lpage><!--PubMed citation query: 'Cancer Res||66|2385||bib11|'--><pub-id pub-id-type="pmid">16489045</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jimeno</surname><given-names>A</given-names></name><name><surname>Rubio-Viqueira</surname><given-names>B</given-names></name><name><surname>Amador</surname><given-names>ML</given-names></name><name><surname>Oppenheimer</surname><given-names>D</given-names></name><name><surname>Bouraoud</surname><given-names>N</given-names></name><name><surname>Kulesza</surname><given-names>P</given-names></name><name><surname>Sebastiani</surname><given-names>V</given-names></name><name><surname>Maitra</surname><given-names>A</given-names></name><name><surname>Hidalgo</surname><given-names>M</given-names></name></person-group><article-title>Epidermal growth factor receptor dynamics influences response to epidermal growth factor receptor targeted agents</article-title><source>Cancer Res</source><year>2005</year><volume>65</volume><fpage>3003</fpage><lpage>3010</lpage><!--PubMed citation query: 'Cancer Res||65|3003||bib12|'--><pub-id pub-id-type="pmid">15833824</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kirby</surname><given-names>AM</given-names></name><name><surname>A'Hern</surname><given-names>RP</given-names></name><name><surname>D'Ambrosio</surname><given-names>C</given-names></name><name><surname>Tanay</surname><given-names>M</given-names></name><name><surname>Syrigos</surname><given-names>KN</given-names></name><name><surname>Rogers</surname><given-names>SJ</given-names></name><name><surname>Box</surname><given-names>C</given-names></name><name><surname>Eccles</surname><given-names>SA</given-names></name><name><surname>Nutting</surname><given-names>CM</given-names></name><name><surname>Harrington</surname><given-names>KJ</given-names></name></person-group><article-title>Gefitinib (ZD1839, Iressa) as palliative treatment in recurrent or metastatic head and neck cancer</article-title><source>Br J Cancer</source><year>2006</year><volume>94</volume><fpage>631</fpage><lpage>636</lpage><!--PubMed citation query: 'Br J Cancer||94|631||bib13|'--><pub-id pub-id-type="pmid">16495923</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matar</surname><given-names>P</given-names></name><name><surname>Rojo</surname><given-names>F</given-names></name><name><surname>Cassia</surname><given-names>R</given-names></name><name><surname>Moreno-Bueno</surname><given-names>G</given-names></name><name><surname>Di Cosimo</surname><given-names>S</given-names></name><name><surname>Tabernero</surname><given-names>J</given-names></name><name><surname>Guzman</surname><given-nam