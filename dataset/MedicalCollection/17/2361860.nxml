0002b;</td><td align="left" valign="top" charoff="50">GCT 2470-9</td><td align="center" valign="top" charoff="50">&#x02212;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">GCT 1098</td><td align="center" valign="top" charoff="50">&#x0002b;</td><td align="left" valign="top" charoff="50">GCT 1165</td><td align="center" valign="top" charoff="50">&#x02212;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">GCT 1100</td><td align="center" valign="top" charoff="50">&#x0002b;</td><td align="left" valign="top" charoff="50">GCT 1166</td><td align="center" valign="top" charoff="50">&#x02212;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">GCT 1138</td><td align="center" valign="top" charoff="50">&#x02212;</td><td align="left" valign="top" charoff="50">GCT 1168</td><td align="center" valign="top" charoff="50">&#x02212;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">GCT 1214</td><td align="center" valign="top" charoff="50">&#x02212;</td><td align="left" valign="top" charoff="50">GCT 1194</td><td align="center" valign="top" charoff="50">&#x02212;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr></tbody></table><table-wrap-foot><fn id="tbfnote2"><label/><p>Two control cells (ovarian cancer cells (Hey, LSAB) and a normal germ cell, GC control) were included to compare the level of EGFR expression in GCT. &#x02018;&#x02212;' represents no detectable EGFR expression, while the level of protein expression was determined by comparing with two control cells, GC control at the lowest level (&#x0002b;) and LSAB at the highest level (&#x0002b;&#x0002b;&#x0002b;&#x0002b;).</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>