|bib21|'--></citation></ref><ref id="bib22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kinlen</surname><given-names>L</given-names></name><name><surname>Doll</surname><given-names>R</given-names></name></person-group><article-title>Population mixing and childhood leukaemia: Fallon and other US clusters</article-title><source>Br J Cancer</source><year>2004</year><volume>91</volume><fpage>1</fpage><lpage>3</lpage><!--PubMed citation query: 'Br J Cancer||91|1||bib22|'--><pub-id pub-id-type="pmid">15226760</pub-id></citation></ref><ref id="bib23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kinlen</surname><given-names>LJ</given-names></name><name><surname>Hudson</surname><given-names>C</given-names></name></person-group><article-title>Childhood leukaemia and poliomyelitis in relation to military encampments in England and Wales in the period of national military service, 1950&#x02013;63</article-title><source>BMJ</source><year>1991</year><volume>303</volume><fpage>1357</fpage><lpage>1362</lpage><!--PubMed citation query: 'BMJ||303|1357||bib23|'--></citation></ref><ref id="bib24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kinlen</surname><given-names>LJ</given-names></name><name><surname>John</surname><given-names>SM</given-names></name></person-group><article-title>Wartime evacuation and mortality from childhood leukaemia in England and Wales in 1945-9</article-title><source>BMJ</source><year>1994</year><volume>309</volume><fpage>1197</fpage><lpage>1202</lpage><!--PubMed citation query: 'BMJ||309|1197||bib24|'--></citation></ref><ref id="bib25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kinlen</surname><given-names>LJ</given-names></name><name><surname>O'Brien</surname><given-names>F</given-names></name><name><surname>Clarke</surname><given-names>K</given-names></name><name><surname>Bal