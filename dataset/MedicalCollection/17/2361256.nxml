<fpage>116</fpage><lpage>121</lpage><!--PubMed citation query: 'Virchows Arch||437|116||bib15|'--><pub-id pub-id-type="pmid">10993270</pub-id></citation></ref><ref id="bib16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hermanek</surname><given-names>P</given-names></name><name><surname>Hutter</surname><given-names>RV</given-names></name><name><surname>Sobin</surname><given-names>LH</given-names></name><name><surname>Wagner</surname><given-names>G</given-names></name><name><surname>Wittekind</surname><given-names>CH</given-names></name></person-group><article-title/><source>UICC: TNM Atlas. Guide illustr&#x000e9; de la Classification TNM&#x0002f;pTNM des Tumeurs Malignes</source><year>1998</year><publisher-name>Heidelberg: Springer</publisher-name></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hermanek</surname><given-names>P</given-names></name><name><surname>Hutter</surname><given-names>RV</given-names></name><name><surname>Sobin</surname><given-names>LH</given-names></name><name><surname>Wittekind</surname><given-names>C</given-names></name></person-group><article-title>Classification of isolated tumor cells and micrometastasis</article-title><source>Cancer</source><year>1999</year><volume>86</volume><fpage>2668</fpage><lpage>2672</lpage><!--PubMed citation query: 'Cancer||86|2668||bib17|'--><pub-id pub-id-type="pmid">10594862</pub-id></citation></ref><ref id="bib18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Inokuchi</surname><given-names>M</given-names></name><name><surname>Ninomiya</surname><given-names>I</given-names></name><name><surname>Tsugawa</surname><given-names>K</given-names></name><name><surname>Terada</surname><given-names>I</given-names></name><name><surname>Miwa</surname><given-names>K</given-names></name></person-group><article-title>Quantitative evaluation of metastases in axillary l