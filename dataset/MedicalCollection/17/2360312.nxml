son-group person-group-type="author"><name><surname>Goldin</surname><given-names>BR</given-names></name><name><surname>Adlercreutz</surname><given-names>H</given-names></name><name><surname>Gorbach</surname><given-names>SL</given-names></name><name><surname>Warram</surname><given-names>JH</given-names></name><name><surname>Dwyer</surname><given-names>JT</given-names></name><name><surname>Swenson</surname><given-names>L</given-names></name><name><surname>Woods</surname><given-names>MN</given-names></name></person-group><article-title>Estrogen excretion patterns and plasma levels in vegetarian and omnivorous women</article-title><source>N Engl J Med</source><year>1982</year><volume>307</volume><fpage>1542</fpage><lpage>1547</lpage><!--PubMed citation query: 'N Engl J Med||307|1542||bib13|'--><pub-id pub-id-type="pmid">7144835</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldin</surname><given-names>BR</given-names></name><name><surname>Adlercreutz</surname><given-names>H</given-names></name><name><surname>Gorbach</surname><given-names>SL</given-names></name><name><surname>Woods</surname><given-names>MN</given-names></name><name><surname>Dwyer</surname><given-names>JT</given-names></name><name><surname>Conlon</surname><given-names>T</given-names></name><name><surname>Bohn</surname><given-names>E</given-names></name><name><surname>Gershoff</surname><given-names>SN</given-names></name></person-group><article-title>The relationship between estrogen levels and diets of Caucasian American and Oriental immigrant women</article-title><source>Am J Clin Nutr</source><year>1986</year><volume>44</volume><fpage>945</fpage><lpage>953</lpage><!--PubMed citation query: 'Am J Clin Nutr||44|945||bib14|'--><pub-id pub-id-type="pmid">3024478</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guengerich</surname><given-names>