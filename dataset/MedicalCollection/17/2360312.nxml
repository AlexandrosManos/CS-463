005b;see comments&#x0005d;</article-title><source>Am J Epidemiol</source><year>2000</year><volume>151</volume><fpage>346</fpage><lpage>357</lpage><!--PubMed citation query: 'Am J Epidemiol||151|346||bib17|'--><pub-id pub-id-type="pmid">10695593</pub-id></citation></ref><ref id="bib18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>S</given-names></name><name><surname>Kolonel</surname><given-names>L</given-names></name><name><surname>Wilkens</surname><given-names>L</given-names></name><name><surname>Wan</surname><given-names>P</given-names></name><name><surname>Henderson</surname><given-names>B</given-names></name><name><surname>Pike</surname><given-names>M</given-names></name></person-group><article-title>Postmenopausal hormone therapy and breast cancer risk: the Multiethnic Cohort</article-title><source>Int J Cancer</source><year>2006</year><volume>118</volume><fpage>1285</fpage><lpage>1291</lpage><!--PubMed citation query: 'Int J Cancer||118|1285||bib18|'--><pub-id pub-id-type="pmid">16170777</pub-id></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lown</surname><given-names>KS</given-names></name><name><surname>Bailey</surname><given-names>DG</given-names></name><name><surname>Fontana</surname><given-names>RJ</given-names></name><name><surname>Janardan</surname><given-names>SK</given-names></name><name><surname>Adair</surname><given-names>CH</given-names></name><name><surname>Fortlage</surname><given-names>LA</given-names></name><name><surname>Brown</surname><given-names>MB</given-names></name><name><surname>Guo</surname><given-names>W</given-names></name><name><surname>Watkins</surname><given-names>PB</given-names></name></person-group><article-title>Grapefruit juice increases felodipine oral availability in humans by decreasing intestinal CYP3A protein expression</article-title><source>J Clin Invest</source><year>1997</y