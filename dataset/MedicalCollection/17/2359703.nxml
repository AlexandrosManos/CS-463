><!--PubMed citation query: 'Prostate||67|1308||bib7|'--><pub-id pub-id-type="pmid">17626247</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Todorov</surname><given-names>PT</given-names></name><name><surname>McDevitt</surname><given-names>TM</given-names></name><name><surname>Cariuk</surname><given-names>P</given-names></name><name><surname>Coles</surname><given-names>B</given-names></name><name><surname>Deacon</surname><given-names>M</given-names></name><name><surname>Tisdale</surname><given-names>MJ</given-names></name></person-group><article-title>Induction of muscle protein degradation and weight loss by a tumor product</article-title><source>Cancer Res</source><year>1996</year><volume>56</volume><fpage>1256</fpage><lpage>1261</lpage><!--PubMed citation query: 'Cancer Res||56|1256||bib8|'--><pub-id pub-id-type="pmid">8640810</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Watchorn</surname><given-names>TM</given-names></name><name><surname>Waddell</surname><given-names>ID</given-names></name><name><surname>Dowidar</surname><given-names>N</given-names></name><name><surname>Ross</surname><given-names>JA</given-names></name></person-group><article-title>Proteolysis inducing factor regulates hepatic gene expression via the transcription factors NFkB and STAT3</article-title><source>FASEB J</source><year>2001</year><volume>15</volume><fpage>562</fpage><lpage>564</lpage><!--PubMed citation query: 'FASEB J||15|562||bib9|'--><pub-id pub-id-type="pmid">11259367</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wieland</surname><given-names>BM</given-names></name><name><surname>Stewart</surname><given-names>GD</given-names></name><name><surname>Skipworth</surname><given-names>RJE</given-names></name><name><surname>Sangster</surnam