02212;1</sup>)</td><td align="left" valign="top" charoff="50">106&#x02009;000&#x02009;IU&#x02009;l<sup>&#x02212;1</sup> (range 170&#x02013;1&#x02009;800&#x02009;000&#x02009;<italic>&#x003bc;</italic>mol&#x02009;l<sup>&#x02212;1</sup>)</td></tr><tr><td align="left" valign="top" charoff="50">Median duration of treatment</td><td align="left" valign="top" charoff="50">18 weeks (range 10&#x02013;33)</td><td align="left" valign="top" charoff="50">18 weeks (range12&#x02013;33)</td><td align="left" valign="top" charoff="50">16 weeks (range 10&#x02013;29)</td></tr><tr><td align="left" valign="top" charoff="50">Proportion of high-risk patients (score&#x0003e;8)</td><td align="left" valign="top" charoff="50">48 (63&#x00025;)</td><td align="left" valign="top" charoff="50">33 (62&#x00025;)</td><td align="left" valign="top" charoff="50">15 (65&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50">Number of relapses</td><td align="left" valign="top" charoff="50">2</td><td align="left" valign="top" charoff="50">1</td><td align="left" valign="top" charoff="50">1</td></tr></tbody></table></table-wrap><table-wrap id="tbl2" position="float"><label>Table 2</label><caption><p content-type="table-title">Influence of CXR verses CT, size of lesion, number of lesions and type of malignant GTN on risk of having a persistent pulmonary lesion after chemotherapy</p></caption><table frame="hsides" rules="groups" border="1" width="85%"><colgroup><col align="left"/><col align="left"/><col align="left"/></colgroup><thead valign="bottom"><tr><th align="left" valign="top" charoff="50"><bold>Radiological investigation at completion of chemotherapy</bold></th><th align="left" valign="top" charoff="50"><bold>No radiological abnormality after chemotherapy</bold></th><th align="left" valign="top" charoff="50"><bold>Radiological abnormality after chemotherapy</bold></th></tr></thead><tbody valign="top"><tr><td align="left" valign="top" charoff="50">CXR</td><td align="left" valign="top" charoff="