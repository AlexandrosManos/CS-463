itation citation-type="journal"><person-group person-group-type="author"><name><surname>M&#x000f8;ller</surname><given-names>B</given-names></name><name><surname>Fekjaer</surname><given-names>H</given-names></name><name><surname>Hakulinen</surname><given-names>T</given-names></name><name><surname>Sigvaldason</surname><given-names>H</given-names></name><name><surname>Storm</surname><given-names>HH</given-names></name><name><surname>Talback</surname><given-names>M</given-names></name><name><surname>Haldorsen</surname><given-names>T</given-names></name></person-group><article-title>Prediction of cancer incidence in the Nordic countries: empirical comparison of different approaches</article-title><source>Stat Med</source><year>2003</year><volume>22</volume><supplement>17</supplement><fpage>2751</fpage><lpage>2766</lpage><!--PubMed citation query: 'Stat Med||22|2751||bib21|'--><pub-id pub-id-type="pmid">12939784</pub-id></citation></ref><ref id="bib22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Murray</surname><given-names>CJ</given-names></name><name><surname>Lopez</surname><given-names>AD</given-names></name></person-group><article-title/><source>The Global Burden of Disease</source><year>1996</year><publisher-name>Geneva: World Health Organization</publisher-name></citation></ref><ref id="bib23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Negri</surname><given-names>E</given-names></name><name><surname>La Vecchia</surname><given-names>C</given-names></name><name><surname>Levi</surname><given-names>F</given-names></name><name><surname>Randriamiharisoa</surname><given-names>A</given-names></name><name><surname>Decarli</surname><given-names>A</given-names></name><name><surname>Boyle</surname><given-names>P</given-names></name></person-group><article-title>The application of age, period and cohort models to predict Swiss cancer mortality</article-title><source>J Cancer Res Clin Oncol</source><year>1990</year><volume>116</volume><supplement>2</supplement><fpage>207</fpage><lpage>214</lpage><!--PubMed citation query: 'J Cancer Res Clin Oncol||116|207||bib23|'--><pub-id pub-id-type="pmid">2324165</pub-id></citation></ref><ref id="bib24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Osmond</surname><given-names>C</given-names></name></person-group><article-title>Using age, period and cohort models to estimate future mortality rates</article-title><source>Int J Epidemiol</source><year>1985</year><volume>14</volume><fpage>124</fpage><lpage>129</lpage><!--PubMed citation query: 'Int J Epidemiol||14|124||bib24|'--><pub-id pub-id-type="pmid">3988427</pub-id></citation></ref><ref id="bib25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Peto</surname><given-names>J</given-names></name><name><surname>Gilham</surname><given-names>C</given-names></name><name><surname>Fletcher</surname><given-names>O</given-names></name><name><surname>Matthews</surname><given-names>FE</given-names></name></person-group><article-title>The cervical cancer epidemic that screening has prevented in the UK</article-title><source>Lancet</source><year>2004</year><volume>364</volume><fpage>249</fpage><lpage>256</lpage><!--PubMed citation query: 'Lancet||364|249||bib25|'--><pub-id pub-id-type="pmid">15262102</pub-id></citation></ref><ref id="bib26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Quinn</surname><given-names>M</given-names></name><name><surname>Babb</surname><given-names>P</given-names></name><name><surname>Jones</surname><given-names>J</given-names></name><name><surname>Allen</surname><given-names>E</given-names></name><collab>on behalf of the United Kingdom Association of Cancer Registries</collab></person-group><article-title>Effect of screening on incidence of the mortality from cancer of the cervix in England: evaluation based on routinely collected statistics</article-title><source>BMJ</source><year>1999</year><volume>318</volume><fpage>904</fpage><lpage>908</lpage><!--PubMed citation query: 'BMJ||318|904||bib26|'--></citation></ref><ref id="bib27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Quinn</surname><given-names>M</given-names></name><name><surname>d'Onofrio</surname><given-names>A</given-names></name><name><surname>M&#x000f8;ller</surname><given-names>B</given-names></name><name><surname>Black</surname><given-names>R</given-names></name><name><surname>Martinez-Garcia</surname><given-names>C</given-names></name><name><surname>M&#x000f8;ller</surname><given-names>H</given-names></name><name><surname>Rahu</surname><given-names>M</given-names></name><name><surname>Robertson</surname><given-names>C</given-names></name><name><surname>Schouten</surname><given-names>LJ</given-names></name><name><surname>La Vecchia</surname><given-names>C</given-names></name><name><surname>Boyle</surname><given-names>P</given-names></name></person-group><article-title>Cancer mortality trends in the EU and acceding countries up to 2015</article-title><source>Ann Oncol</source><year>2003</year><volume>14</volume><supplement>7</supplement><fpage>1148</fpage><lpage>1152</lpage><!--PubMed citation query: 'Ann Oncol||14|1148||bib27|'--><pub-id pub-id-type="pmid">12853360</pub-id></citation></ref><ref id="bib28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rohan</surname><given-names>TE</given-names></name><name><surname>Burk</surname><given-names>RD</given-names></name><name><surname>Franco</surname><given-names>EL</given-names></name></person-group><article-title>Toward a reduction of the global burden of cervical cancer</article-title><source>Am J Obstet Gynecol</source><year>2003</year><volume>189</volume><supplement>4 Suppl</supplement><fpage>S37</fpage><lpage>S39</lpage><!--PubMed citation query: 'Am J Obstet Gynecol||189|S37||bib28|'--><pub-id pub-id-type="pmid">14586318</pub-id></citation></ref><ref id="bib29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Taylor</surname><given-names>RJ</given-names></name><name><surname>Morrell</surname><given-names>SL</given-names></name><name><surname>Mamoon</surname><given-names>HA</given-names></name><name><surname>Wain</surname><given-names>GV</given-names></name></person-group><article-title>Effects of screening on cervical cancer incidence and mortality in New South Wales implied by influences of period of diagnosis and birth cohort</article-title><source>J Epidemiol Commun Health</source><year>2001</year><volume>55</volume><supplement>11</supplement><fpage>782</fpage><lpage>788</lpage><!--PubMed citation query: 'J Epidemiol Commun Health||55|782||bib29|'--></citation></ref><ref id="bib30"><citation citation-type="other"><person-group person-group-type="author"><collab>University of Hong Kong</collab></person-group><article-title/><source>Population Health Survey Report</source><year>2005</year>Commissioned by Department of Health, Government of the Hong Kong Special Administrative Region, People's Republic of China</citation></ref></ref-list></back><floats-wrap><fig id="fig1"><label>Figure 1</label><caption><p>Observed compared to maximum likelihood (solid lines) and Bayesian posterior estimates (shaded lines) of fitted rates (1972&#x02013;76 through 1997&#x02013;2001) and empirical projections (2002&#x02013;06 through 2012&#x02013;16) of incidence by alternate 5-year age groups.</p></caption><graphic xmlns:xlink="http://www.w3.org/1999/xlink" mime-subtype="jpeg" xlink:href="93-6602805f1"/></fig><fig id="fig2"><label>Figure 2</label><caption><p>Observed and predicted cervical cancer incident cases and deaths from 1972 to 2016 with continuation of the <italic>status quo</italic> of opportunistic screening.</p></caption><graphic xmlns:xlink="http://www.w3.org/1999/xlink" mime-subtype="jpeg" xlink:href="