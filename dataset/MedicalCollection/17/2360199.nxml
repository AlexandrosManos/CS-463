td align="center" valign="top" charoff="50">780 (20&#x00025;)</td><td align="center" valign="top" charoff="50">689 (18&#x00025;)</td><td align="center" valign="top" charoff="50">1535 (31&#x00025;)</td><td align="center" valign="top" charoff="50">736 (35&#x00025;)</td><td align="center" valign="top" charoff="50">799 (28&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="7" align="left" valign="top" charoff="50"><italic>Grade</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Well differentiated</td><td align="center" valign="top" charoff="50">893 (11&#x00025;)</td><td align="center" valign="top" charoff="50">435 (11&#x00025;)</td><td align="center" valign="top" charoff="50">458 (12&#x00025;)</td><td align="center" valign="top" charoff="50">634 (13&#x00025;)</td><td align="center" valign="top" charoff="50">261 (13&#x00025;)</td><td align="center" valign="top" charoff="50">373 (13&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Moderately differentiated</td><td align="center" valign="top" charoff="50">4172 (53&#x00025;)</td><td align="center" valign="top" charoff="50">2019 (51&#x00025;)</td><td align="center" valign="top" charoff="50">2153 (55&#x00025;)</td><td align="center" valign="top" charoff="50">2891 (59&#x00025;)</td><td align="center" valign="top" charoff="50">1196 (58&#x00025;)</td><td align="center" valign="top" charoff="50">1695 (60&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Poorly differentiated</td><td align="center" valign="top" charoff="50">940 (12&#x00025;)</td><td align="cen