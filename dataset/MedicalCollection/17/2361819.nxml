ign="top" charoff="50">GGAATAGACGGAGCTGGAGTTG</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Probe</td><td align="left" valign="top" charoff="50">ACCAGCACCCGCCTGGGAACTTACT</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="2" align="left" valign="top" charoff="50"><italic>Maspin</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Forward primer</td><td align="left" valign="top" charoff="50">CAGATGGCCACTTTGAGAACATT</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Reverse primer</td><td align="left" valign="top" charoff="50">GGCAGCATTAACCACAAGGATT</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Probe</td><td align="left" valign="top" charoff="50">GGCAGCATTAACCACAAGGATT</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="2" align="left" valign="top" charoff="50"><italic>UPA</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Forward primer</td><td align="left" valign="top" charoff="50">TGGAACTCTGCCACTGTCCTT</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Reverse primer</td><td align="left" valign="top" charoff="50">GGCCCACCTGCACATAGC</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Probe</td><td align="left" valign="top" charoff="50">ATAATTACTGCAGGAACCCAGACAACCGGA</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="2" align="left" valign="top" charoff="50"><italic>UPAR</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Forward primer</td><td align="left" valign="top" charoff="50">GCCCAATCCTGGAGCTTGA</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Reverse primer</td><td align="left" valign="top" charoff="50">TTCCCCTTGC