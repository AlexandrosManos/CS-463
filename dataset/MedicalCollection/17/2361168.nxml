gn="top" charoff="50">12<sup>b</sup></td><td align="center" valign="top" charoff="50">389</td><td align="center" valign="top" charoff="50">N/A</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">IC consent returned with eligible FDR(s)</td><td align="center" valign="top" charoff="50">41</td><td align="center" valign="top" charoff="50">4</td><td align="center" valign="top" charoff="50">192</td><td align="center" valign="top" charoff="50">20</td><td align="center" valign="top" charoff="50">257</td></tr><tr><td align="left" valign="top" charoff="50">FDR consented to provide blood sample or previous test result, restricted to aged 45&#x02013;69 years at the time of test</td><td align="center" valign="top" charoff="50">36</td><td align="center" valign="top" charoff="50">3</td><td align="center" valign="top" charoff="50">167</td><td align="center" valign="top" charoff="50">14</td><td align="center" valign="top" charoff="50">220</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50"><italic>PSA measurement</italic></td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Study screen<sup>c</sup></td><td align="center" valign="top" charoff="50">24</td><td align="center" valign="top" charoff="50">2</td><td align="center" valign="top" charoff="50">134</td><td al