given-names>GP</given-names></name></person-group><article-title>Does p53 immunostaining improve diagnostic accuracy in urine cytology</article-title><source>Diagn Cytopathol</source><year>1997</year><volume>17</volume><fpage>436</fpage><lpage>439</lpage><!--PubMed citation query: 'Diagn Cytopathol||17|436||bib15|'--><pub-id pub-id-type="pmid">9407204</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Saad</surname><given-names>A</given-names></name><name><surname>Hanbury</surname><given-names>DC</given-names></name><name><surname>McNicholas</surname><given-names>TA</given-names></name><name><surname>Boustead</surname><given-names>GB</given-names></name><name><surname>Woodman</surname><given-names>AC</given-names></name></person-group><article-title>The early detection and diagnosis of bladder cancer: a critical review of the options</article-title><source>Eur Urol</source><year>2001</year><volume>39</volume><fpage>619</fpage><lpage>633</lpage><!--PubMed citation query: 'Eur Urol||39|619||bib16|'--><pub-id pub-id-type="pmid">11464050</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sachs</surname><given-names>MD</given-names></name><name><surname>Schlechte</surname><given-names>H</given-names></name><name><surname>Lenk</surname><given-names>VS</given-names></name><name><surname>Brenner</surname><given-names>S</given-names></name><name><surname>Shnorr</surname><given-names>D</given-names></name><name><surname>Fleige</surname><given-names>B</given-names></name><name><surname>Ditscherlein</surname><given-names>G</given-names></name><name><surname>Loening</surname><given-names>SA</given-names></name></person-group><article-title>Genetic analysis of Tp53 from urine sediment as a tool for diagnosing recurrence and residual of bladder carcinoma</article-title><source>Eur Urol</source><year>2000</year><volume>38</v