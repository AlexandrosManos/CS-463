lin Oncol</source><year>1998</year><volume>16</volume><fpage>301</fpage><lpage>308</lpage><!--PubMed citation query: 'J Clin Oncol||16|301||bib14|'--><pub-id pub-id-type="pmid">9440757</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Murad</surname><given-names>AM</given-names></name><name><surname>de Andrade</surname><given-names>CA</given-names></name><name><surname>Delfino</surname><given-names>C</given-names></name><name><surname>Arikian</surname><given-names>S</given-names></name><name><surname>Doyle</surname><given-names>JJ</given-names></name><name><surname>Dezii</surname><given-names>CM</given-names></name><name><surname>Sadana</surname><given-names>A</given-names></name><name><surname>Sinha</surname><given-names>N</given-names></name></person-group><article-title>Pharmacoeconomic evaluation of tegafur-uracil (UFT) <italic>vs</italic> fluorouracil for the management of colorectal cancer in Brazil and Argentina</article-title><source>Clin Drug Invest</source><year>1997a</year><volume>13</volume><fpage>90</fpage><lpage>98</lpage><!--PubMed citation query: 'Clin Drug Invest||13|90||bib15|'--></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Murad</surname><given-names>A</given-names></name><name><surname>de Andrade</surname><given-names>CA</given-names></name><name><surname>Delfino</surname><given-names>C</given-names></name><name><surname>Arikian</surname><given-names>S</given-names></name><name><surname>Doyle</surname><given-names>J</given-names></name><name><surname>Sinha</surname><given-names>N</given-names></name></person-group><article-title>A pharmacoeconomic comparison of UFT and 5-FU chemotherapy for colorectal cancer in South America</article-title><source>Oncology (Huntingt)</source><year>1997b</year><volume>11</volume><fpage>128</fpage><lpage>135</lpage><!--PubMed citation query: 'Oncology (Huntingt)||11|128||bib16|'--></citation></ref><ref id="bib17"><citation citation-type="book"><person-group person-group-type="author"><collab>National Institute for Clinical Excellence</collab></person-group><article-title/><source>Technology Appraisal Guidance 61: Guidance on the Use of Capecitabine and Tegafur with Uracil for Metastatic Colorectal Cancer</source><year>2003</year><publisher-name>London: National Institute for Clinical Excellence</publisher-name></citation></ref><ref id="bib18"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Netten</surname><given-names>A</given-names></name><name><surname>Rees</surname><given-names>T</given-names></name><name><surname>Harrison</surname><given-names>G</given-names></name></person-group><article-title>Unit costs of health and social care 2001</article-title><year>2001</year></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ollendorf</surname><given-names>D</given-names></name></person-group><article-title>Impact of uracil&#x0002f;tegafur plus oral calcium folinate on resource utilization</article-title><source>Oncology (Huntingt)</source><year>1999</year><volume>13</volume><fpage>42</fpage><lpage>43</lpage><!--PubMed citation query: 'Oncology (Huntingt)||13|42||bib19|'--></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pazdur</surname><given-names>R</given-names></name><name><surname>Douillard</surname><given-names>JY</given-names></name><name><surname>Skillings</surname><given-names>JR</given-names></name><name><surname>Eisenberg</surname><given-names>PD</given-names></name><name><surname>Davidson</surname><given-names>N</given-names></name><name><surname>Harper</surname><given-names>P</given-names></name><name><surname>Vincent</surname><given-names>MD</given-names></name><name><surname>Lembersky</surname><given-names>BC</given-names></na