cer Res Treat||90|127||bib5|'--><pub-id pub-id-type="pmid">15803359</pub-id></citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chatterjee</surname><given-names>N</given-names></name></person-group><article-title>A two-stage regression model for epidemiological studies with multivariate disease classification data</article-title><source>JASA</source><year>2004</year><volume>99</volume><fpage>127</fpage><lpage>138</lpage><!--PubMed citation query: 'JASA||99|127||bib6|'--></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>CL</given-names></name><name><surname>Weiss</surname><given-names>NS</given-names></name><name><surname>Newcomb</surname><given-names>P</given-names></name><name><surname>Barlow</surname><given-names>W</given-names></name><name><surname>White</surname><given-names>E</given-names></name></person-group><article-title>Hormone replacement therapy in relation to breast cancer</article-title><source>JAMA</source><year>2002</year><volume>287</volume><fpage>734</fpage><lpage>741</lpage><!--PubMed citation query: 'JAMA||287|734||bib7|'--><pub-id pub-id-type="pmid">11851540</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><collab>Collaborative Group on Hormonal Factors in Breast Cancer</collab></person-group><article-title>Breast cancer and hormone replacement therapy: collaborative reanalysis of data from 51 epidemiological studies of 52&#x02009;705 women with breast cancer and 108&#x02009;411 women without breast cancer</article-title><source>Lancet</source><year>1997</year><volume>350</volume><fpage>1047</fpage><lpage>1059</lpage><!--PubMed citation query: 'Lancet||350|1047||bib8|'--><pub-id pub-id-type="pmid">10213546</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cui</surname><given-names>Y</given-names></name><name><surname>Whiteman</surname><given-names>MK</given-names></name><name><surname>Flaws</surname><given-names>JA</given-names></name><name><surname>Langenberg</surname><given-names>P</given-names></name><name><surname>Tkaczuk</surname><given-names>KH</given-names></name><name><surname>Bush</surname><given-names>TL</given-names></name></person-group><article-title>Body mass and stage of breast cancer at diagnosis</article-title><source>Int J Cancer</source><year>2002</year><volume>98</volume><fpage>279</fpage><lpage>283</lpage><!--PubMed citation query: 'Int J Cancer||98|279||bib9|'--><pub-id pub-id-type="pmid">11857420</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Daling</surname><given-names>JR</given-names></name><name><surname>Malone</surname><given-names>KE</given-names></name><name><surname>Doody</surname><given-names>DR</given-names></name><name><surname>Voigt</surname><given-names>LF</given-names></name><name><surname>Bernstein</surname><given-names>L</given-names></name><name><surname>Coates</surname><given-names>RJ</given-names></name><name><surname>Marchbanks</surname><given-names>PA</given-names></name><name><surname>Norman</surname><given-names>SA</given-names></name><name><surname>Weiss</surname><given-names>LK</given-names></name><name><surname>Ursin</surname><given-names>G</given-names></name><name><surname>Berlin</surname><given-names>JA</given-names></name><name><surname>Burkman</surname><given-names>RT</given-names></name><name><surname>Deapen</surname><given-names>D</given-names></name><name><surname>Folger</surname><given-names>SG</given-names></name><name><surname>McDonald</surname><given-names>JA</given-names></name><name><surname>Simon</surname><given-names>MS</given-names></name><name><surname>Strom</surname><given-names>BL</given-names></name><name><surname>Wingo</surname><given-names>PA</