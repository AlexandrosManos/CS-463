-type="uri" xlink:href="http://mech.ctb.pku.edu.cn/protisa/"/></citation></ref><ref id="B24"><citation citation-type="other"><article-title>SupTISA</article-title><ext-link ext-link-type="uri" xlink:href="http://mech.ctb.pku.edu.cn/protisa/SupTISA/"/></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cang</surname><given-names>XH</given-names></name><name><surname>Wang</surname><given-names>J</given-names></name></person-group><article-title>A unique ATG triplet downstream of gene start in archaea: implications for translation initiation and evolution</article-title><source>Gene</source><year>2004</year><volume>327</volume><fpage>75</fpage><lpage>79</lpage><pub-id pub-id-type="pmid">14960362</pub-id><pub-id pub-id-type="doi">10.1016/j.gene.2003.11.001</pub-id></citation></ref></ref-list></back></article>