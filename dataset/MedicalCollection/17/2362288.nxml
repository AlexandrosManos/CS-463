<!DOCTYPE article PUBLIC "-//NLM//DTD JATS (Z39.96) Journal Archiving and Interchange DTD v1.0 20120330//EN" "JATS-archivearticle1.dtd"><article article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Br J Cancer</journal-id><journal-id journal-id-type="iso-abbrev">Br. J. Cancer</journal-id><journal-title-group><journal-title>British Journal of Cancer</journal-title></journal-title-group><issn pub-type="ppub">0007-0920</issn><issn pub-type="epub">1532-1827</issn><publisher><publisher-name>Nature Publishing Group</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">10360669</article-id><article-id pub-id-type="pmc">2362288</article-id><article-id pub-id-type="pii">6690435</article-id><article-id pub-id-type="doi">10.1038/sj.bjc.6690435</article-id><article-categories><subj-group subj-group-type="heading"><subject>Regular Article</subject></subj-group></article-categories><title-group><article-title>European multicenter study on LOH of APOC3 at 11q23 in 766 breast cancer patients: relation to clinical variables</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Launonen</surname><given-names>V</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Laake</surname><given-names>K</given-names></name><xref ref-type="aff" rid="aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Huusko</surname><given-names>P</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Niederacher</surname><given-names>D</given-names></name><xref ref-type="aff" rid="aff5">5</xref></contrib><contrib contrib-type="author"><name><surname>Beckmann</surname><given-names>M W</given-names></name><xref ref-type="aff" rid="aff5">5</xref></contrib><contrib contrib-type="author"><name><surname>Barkardottir</surname><given-names>R B</given