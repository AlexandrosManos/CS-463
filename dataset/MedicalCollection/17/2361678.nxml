valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="4" align="left" valign="top" charoff="50"><italic>Treatment</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Radical radiotherapy</td><td align="center" valign="top" charoff="50">6 (5)</td><td align="center" valign="top" charoff="50">3 (2)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Chemotherapy</td><td align="center" valign="top" charoff="50">8 (7)</td><td align="center" valign="top" charoff="50">29 (23)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Palliative radiotherapy</td><td align="center" valign="top" charoff="50">35 (30)</td><td align="center" valign="top" charoff="50">38 (30)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Palliative care only</td><td align="center" valign="top" charoff="50">68 (58)</td><td align="center" valign="top" charoff="50">56 (44)</td><td align="center" valign="top" charoff="50">0.003</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Median survival (months)</td><td align="center" valign="top" charoff="50">3.2 (2.4&#x02013;4.1)</td><td align="center" valign="top" charoff="50">6.6 (3.7&#x02013;9.5)</td><td align="center" valign="top" charoff="50">&#x0003c;0.001</td></tr></tbody></table><table-wrap-foot><fn id="tbfnote1"><label/><p>NSCLC&#x0003d;non-small-cell lung cancer.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>