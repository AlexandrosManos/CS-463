</person-group><article-title>Compartmentalization of hnRNP-K during cell cycle progression and its interaction with calponin in the cytoplasm</article-title><source>J Cell Biochem</source><year>2005</year><volume>95</volume><fpage>1042</fpage><lpage>1056</lpage><!--PubMed citation query: 'J Cell Biochem||95|1042||bib14|'--><pub-id pub-id-type="pmid">15962305</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lawrie</surname><given-names>LC</given-names></name><name><surname>Dundas</surname><given-names>SR</given-names></name><name><surname>Curran</surname><given-names>S</given-names></name><name><surname>Murray</surname><given-names>GI</given-names></name></person-group><article-title>Liver fatty acid binding protein expression in colorectal neoplasia</article-title><source>Br J Cancer</source><year>2004</year><volume>90</volume><fpage>1955</fpage><lpage>1960</lpage><!--PubMed citation query: 'Br J Cancer||90|1955||bib15|'--><pub-id pub-id-type="pmid">15138477</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mandal</surname><given-names>M</given-names></name><name><surname>Vadlamudi</surname><given-names>R</given-names></name><name><surname>Nugyen</surname><given-names>D</given-names></name><name><surname>Wang</surname><given-names>R</given-names></name><name><surname>Costa</surname><given-names>L</given-names></name><name><surname>Bagheri-Yarmand</surname><given-names>R</given-names></name></person-group><article-title>Growth factors regulate heterogeneous ribonucleoprotein K expression and function</article-title><source>J Biol Chem</source><year>2001</year><volume>276</volume><fpage>9699</fpage><lpage>9704</lpage><!--PubMed citation query: 'J Biol Chem||276|9699||bib16|'--><pub-id pub-id-type="pmid">11121407</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-