>236</volume><supplement>5</supplement><fpage>583</fpage><lpage>592</lpage><!--PubMed citation query: 'Ann Surg||236|583||bib21|'--><pub-id pub-id-type="pmid">12409664</pub-id></citation></ref><ref id="bib22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shankar</surname><given-names>PJ</given-names></name><name><surname>Achuthan</surname><given-names>R</given-names></name><name><surname>Haray</surname><given-names>PN</given-names></name></person-group><article-title>Colorectal subspecialization in a DGH. The way forward</article-title><source>Colorectal Dis</source><year>2001</year><volume>3</volume><fpage>396</fpage><lpage>401</lpage><!--PubMed citation query: 'Colorectal Dis||3|396||bib22|'--><pub-id pub-id-type="pmid">12790937</pub-id></citation></ref><ref id="bib23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Singh</surname><given-names>KK</given-names></name><name><surname>Barry</surname><given-names>MK</given-names></name><name><surname>Ralston</surname><given-names>P</given-names></name><name><surname>Henderson</surname><given-names>MA</given-names></name><name><surname>McCormick</surname><given-names>JS</given-names></name><name><surname>Walls</surname><given-names>AD</given-names></name><name><surname>Auld</surname><given-names>CA</given-names></name></person-group><article-title>Audit of colorectal cancer surgery by non-specialist surgeons</article-title><source>Br J Surg</source><year>1997</year><volume>84</volume><fpage>343</fpage><lpage>347</lpage><!--PubMed citation query: 'Br J Surg||84|343||bib23|'--><pub-id pub-id-type="pmid">9117304</pub-id></citation></ref><ref id="bib24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>JA</given-names></name><name><surname>King</surname><given-names>PM</given-names></name><name><surname>Lane</surname><given-names>RH</given-names></name><name><surname>Thomp