tive)</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">LM8</td><td align="center" valign="top" charoff="50">0.97&#x000b1;0.17 (Additive)</td><td align="center" valign="top" charoff="50">0.93&#x000b1;0.31 (Additive)</td></tr><tr><td align="left" valign="top" charoff="50">IM</td><td align="left" valign="top" charoff="50">MOS</td><td align="center" valign="top" charoff="50">0.14&#x000b1;0.11 (Synergism)</td><td align="center" valign="top" charoff="50">0.72&#x000b1;0.65 (Additive)</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">LM8</td><td align="center" valign="top" charoff="50">1.06&#x000b1;0.19 (Additive)</td><td align="center" valign="top" charoff="50">1.24&#x000b1;0.39 (Additive)</td></tr><tr><td align="left" valign="top" charoff="50">PAC</td><td align="left" valign="top" charoff="50">MOS</td><td align="center" valign="top" charoff="50">0.07&#x000b1;0.05 (Synergism)</td><td align="center" valign="top" charoff="50">0.21&#x000b1;0.27 (Synergism)</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">LM8</td><td align="center" valign="top" charoff="50">0.03&#x000b1;0.07 (Synergism)</td><td align="center" valign="top" charoff="50">0.52&#x000b1;0.21 (Synergism)</td></tr><tr><td align="left" valign="top" charoff="50">GEM</td><td align="left" valign="top" charoff="50">MOS</td><td align="center" valign="top" charoff="50">0.18&#x000b1;0.10 (Synergism)</td><td align="center" valign="top" charoff="50">0.26&#x000b1;0.31 (Synergism)</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">LM8</td><td align="center" valign="top" charoff="50">0.67&#x000b1;0.12 (Synergism)</td><td align="center" valign="top" charoff="50">0.53&#x000b1;0.22 (Synergism)</td></tr></tbody></table></table-wrap><table-wrap id="tbl3" position="float"><label>Table 3</