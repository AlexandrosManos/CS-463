align="center" valign="top" charoff="50">NM013979</td><td align="left" valign="top" charoff="50">BCL2/adenovirus E1B 19&#x02009;kDa interacting protein 3</td><td align="center" valign="top" charoff="50">&#x02022;</td><td align="center" valign="top" charoff="50">&#x02022;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">U13737</td><td align="left" valign="top" charoff="50">Caspase 3</td><td align="center" valign="top" charoff="50">&#x02022;</td><td align="center" valign="top" charoff="50">&#x02022;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Others</td><td align="center" valign="top" charoff="50">J04088</td><td align="left" valign="top" charoff="50">Topoisomerase (DNA) II, alpha</td><td align="center" valign="top" charoff="50">&#x02022;</td><td align="center" valign="top" charoff="50">&#x02022;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">M15796</td><td align="left" valign="top" charoff="50">PCNA</td><td align="center" valign="top" charoff="50">&#x02022;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr></tbody></table><table-wrap-foot><fn id="tbfnote1"><label/><p>&#x02022; indicates that the gene expression level was reduced more than five-fold after DES treatment.</p></fn></table-wrap-foot></table-wrap><table-wrap id="tbl2" position="float"><label>Table 2</label><caption><p content-type="table-title">Gene list: elevated after DES treatment</p></caption><table frame="hsides" rules="groups" border="1" width="85%"><colgroup><col align="left"/><col align="left"/><col align="center"/><col align="left"/></colgroup