</name><name><surname>Provost</surname><given-names>AT</given-names></name><name><surname>Sutton</surname><given-names>S</given-names></name></person-group><article-title>Psychological impact of genetic counseling for familial cancer: a systematic review and met-analysis</article-title><source>J Natl Cancer Inst</source><year>2004</year><volume>96</volume><supplement>2</supplement><fpage>122</fpage><lpage>133</lpage><!--PubMed citation query: 'J Natl Cancer Inst||96|122||bib6|'--><pub-id pub-id-type="pmid">14734702</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bratt</surname><given-names>O</given-names></name><name><surname>Kristoffersson</surname><given-names>U</given-names></name><name><surname>Lundgren</surname><given-names>R</given-names></name><name><surname>Olsson</surname><given-names>H</given-names></name></person-group><article-title>Familial and hereditary prostate cancer in Southern Sweden. A population-based case&#x02013;control study</article-title><source>Eur J Cancer</source><year>1999</year><volume>35</volume><fpage>272</fpage><lpage>277</lpage><!--PubMed citation query: 'Eur J Cancer||35|272||bib7|'--><pub-id pub-id-type="pmid">10448270</pub-id></citation></ref><ref id="bib8"><citation citation-type="other"><person-group person-group-type="author"><collab>Cancer Council Victoria</collab></person-group><article-title/><source>Victorian Family Cancer Genetics Service</source><year>2004</year></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carter</surname><given-names>BS</given-names></name><name><surname>Bova</surname><given-names>GS</given-names></name><name><surname>Beatty</surname><given-names>TH</given-names></name><name><surname>Steinberg</surname><given-names>GD</given-names></name><name><surname>Childs</surname><given-names>B</given-names></name><name><surname>Isaacs</surname><given-names>