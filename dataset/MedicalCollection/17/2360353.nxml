itle><source>J Clin Invest</source><year>2002a</year><volume>109</volume><fpage>987</fpage><lpage>991</lpage><!--PubMed citation query: 'J Clin Invest||109|987||bib9|'--><pub-id pub-id-type="pmid">11956233</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Conacci-Sorrell</surname><given-names>ME</given-names></name><name><surname>Ben-Yedida</surname><given-names>T</given-names></name><name><surname>Shtutman</surname><given-names>M</given-names></name><name><surname>Feinstein</surname><given-names>E</given-names></name><name><surname>Einat</surname><given-names>P</given-names></name><name><surname>Ben-Ze'ev</surname><given-names>A</given-names></name></person-group><article-title>NrCAM is a target gene of the <italic>&#x003b2;</italic>-catenin/Lef-1 pathway in melanoma and colon cancer and its expression enhances motility and confers tumorigenesis</article-title><source>Genes Dev</source><year>2002b</year><volume>16</volume><fpage>2058</fpage><lpage>2072</lpage><!--PubMed citation query: 'Genes Dev||16|2058||bib10|'--><pub-id pub-id-type="pmid">12183361</pub-id></citation></ref><ref id="bib11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>DeLellis</surname><given-names>RA</given-names></name><name><surname>Williams</surname><given-names>ED</given-names></name></person-group><article-title>Thyroid and parathyroid tumors</article-title><source>Pathology and Genetics of Tumours of Endocrine Organs. World Health Organization Classification of Tumours</source><year>2004</year><publisher-name>Lyon: IARC Press</publisher-name><fpage>51</fpage><lpage>56</lpage>In: DeLellis LA, Lloyd RV, Heitz PU, Eng C (eds)</citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dhodapkar</surname><given-names>KM</given-names></name><name><surname>Friedlander</surname><given-names>D</given-names></name><na