tation citation-type="journal"><person-group person-group-type="author"><name><surname>Fasal</surname><given-names>E</given-names></name><name><surname>Jackson</surname><given-names>EW</given-names></name><name><surname>Klauber</surname><given-names>MR</given-names></name></person-group><article-title>Birth characteristics and leukemia in childhood</article-title><source>J Natl Cancer Inst</source><year>1971</year><volume>47</volume><fpage>501</fpage><lpage>509</lpage><!--PubMed citation query: 'J Natl Cancer Inst||47|501||bib12|'--><pub-id pub-id-type="pmid">5157573</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gilman</surname><given-names>EA</given-names></name><name><surname>Knox</surname><given-names>EG</given-names></name></person-group><article-title>Geographical distribution of birth places of children with cancer in the UK</article-title><source>Br J Cancer</source><year>1998</year><volume>77</volume><fpage>842</fpage><lpage>849</lpage><!--PubMed citation query: 'Br J Cancer||77|842||bib13|'--><pub-id pub-id-type="pmid">9514068</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Greenberg</surname><given-names>RS</given-names></name><name><surname>Shuster</surname><given-names>JL</given-names><suffix>Jr</suffix></name></person-group><article-title>Epidemiology of cancer in children</article-title><source>Epidemiol Rev</source><year>1985</year><volume>7</volume><fpage>22</fpage><lpage>48</lpage><!--PubMed citation query: 'Epidemiol Rev||7|22||bib14|'--><pub-id pub-id-type="pmid">3902495</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hjalmars</surname><given-names>U</given-names></name><name><surname>Gustafsson</surname><given-names>G</given-names></name></person-group><article-title>Higher risk for acute childhood l