</citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fagin</surname><given-names>JA</given-names></name><name><surname>Matsuo</surname><given-names>K</given-names></name><name><surname>Karmakar</surname><given-names>A</given-names></name><name><surname>Chen</surname><given-names>DL</given-names></name><name><surname>Tang</surname><given-names>SH</given-names></name><name><surname>Koeffler</surname><given-names>HP</given-names></name></person-group><article-title>High prevalence of mutations of the p53 gene in poorly differentiated human thyroid carcinomas</article-title><source>J Clin Invest</source><year>1993</year><volume>91</volume><fpage>179</fpage><lpage>184</lpage><!--PubMed citation query: 'J Clin Invest||91|179||bib12|'--><pub-id pub-id-type="pmid">8423216</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fan</surname><given-names>J</given-names></name><name><surname>Yang</surname><given-names>X</given-names></name><name><surname>Wang</surname><given-names>W</given-names></name><name><surname>Wood</surname><given-names>WH</given-names><suffix>III</suffix></name><name><surname>Becker</surname><given-names>KG</given-names></name><name><surname>Gorospe</surname><given-names>M</given-names></name></person-group><article-title>Global analysis of stress-regulated mRNA turnover by using cDNA arrays</article-title><source>Proc Natl Acad Sci USA</source><year>2002</year><volume>99</volume><fpage>10611</fpage><lpage>10616</lpage>Epub July 29<!--PubMed citation query: 'Proc Natl Acad Sci USA||99|10611||bib13|'--></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferenc</surname><given-names>T</given-names></name><name><surname>Lewinski</surname><given-names>A</given-names></name><name><surname>Lange</surname><given-names>D</given-names></name><name><