n-type="journal"><person-group person-group-type="author"><name><surname>Johnson</surname><given-names>MR</given-names></name><name><surname>Riddle</surname><given-names>AF</given-names></name><name><surname>Irvine</surname><given-names>R</given-names></name><name><surname>Sharma</surname><given-names>V</given-names></name><name><surname>Collins</surname><given-names>WP</given-names></name><name><surname>Nicolaides</surname><given-names>KH</given-names></name><name><surname>Grudzinskas</surname><given-names>JG</given-names></name></person-group><article-title>Corpus luteum failure in ectopic pregnancy</article-title><source>Hum Reprod</source><year>1993</year><volume>8</volume><fpage>1491</fpage><lpage>1495</lpage><pub-id pub-id-type="pmid">7504682</pub-id></element-citation></ref><ref id="B21"><label>21</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lower</surname><given-names>AM</given-names></name><name><surname>Yovich</surname><given-names>JL</given-names></name><name><surname>Hancock</surname><given-names>C</given-names></name><name><surname>Grudzinskas</surname><given-names>JG</given-names></name></person-group><article-title>Is luteal function maintained by factors other than chorionic gonadotropin in early pregnancy?</article-title><source>Hum Reprod</source><year>1993</year><volume>8</volume><fpage>645</fpage><lpage>648</lpage><pub-id pub-id-type="pmid">8501201</pub-id></element-citation></ref><ref id="B22"><label>22</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kratzer</surname><given-names>PG</given-names></name><name><surname>Taylor</surname><given-names>RN</given-names></name></person-group><article-title>Corpus luteum function in early pregnancies is primarily determined by the rate of change of human chorionic gonadotropin levels</article-title><source>Am J Obstet Gynecol</source><year>1990</year><volume>163</volume><fpage>1497</f