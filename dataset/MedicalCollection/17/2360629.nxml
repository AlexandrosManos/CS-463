<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article article-type="other"><?properties open_access?><!-- Original-type: ep--><front><journal-meta><journal-id journal-id-type="nlm-ta">Br J Cancer</journal-id><journal-title>British Journal of Cancer</journal-title><issn pub-type="ppub">0007-0920</issn><issn pub-type="epub">1532-1827</issn></journal-meta><article-meta><article-id pub-id-type="pmid">16832408</article-id><article-id pub-id-type="pmc">2360629</article-id><article-id pub-id-type="pii">6603266</article-id><article-id pub-id-type="doi">10.1038/sj.bjc.6603266</article-id><article-categories><subj-group subj-group-type="heading"><subject>Epidemiology</subject></subj-group></article-categories><title-group><article-title>Plasma and dietary carotenoid, retinol and tocopherol levels and the risk of gastric adenocarcinomas in the European prospective investigation into cancer and nutrition</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Jenab</surname><given-names>M</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="corresp" rid="caf1">*</xref></contrib><contrib contrib-type="author"><name><surname>Riboli</surname><given-names>E</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Ferrari</surname><given-names>P</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Friesen</surname><given-names>M</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Sabate</surname><given-names>J</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Norat</surname><given-names>T</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Slimani</surname><given-names>N</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Tj&#x000f8;nneland</surname><given-names>A</given-names></name><xref ref-type="aff" rid="aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Olsen</surname><given-names>A</given-names></name><xref ref-type="aff" rid="aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Overvad</surname><given-names>K</given-names></name><xref ref-type="aff" rid="aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Boutron-Ruault</surname><given-names>M-C</given-names></name><xref ref-type="aff" rid="aff5">5</xref></contrib><contrib contrib-type="author"><name><surname>Clavel-Chapelon</surname><given-names>F</given-names></name><xref ref-type="aff" rid="aff5">5</xref></contrib><contrib contrib-type="author"><name><surname>Boeing</surname><given-names>H</given-names></name><xref ref-type="aff" rid="aff6">6</xref></contrib><contrib contrib-type="author"><name><surname>Schulz</surname><given-names>M</given-names></name><xref ref-type="aff" rid="aff6">6</xref></contrib><contrib contrib-type="author"><name><surname>Linseisen</surname><given-names>J</given-names></name><xref ref-type="aff" rid="aff7">7</xref></contrib><contrib contrib-type="author"><name><surname>Nagel</surname><given-names>G</given-names></name><xref ref-type="aff" rid="aff7">7</xref></contrib><contrib contrib-type="author"><name><surname>Trichopoulou</surname><given-names>A</given-names></name><xref ref-type="aff" rid="aff8">8</xref></contrib><contrib contrib-type="author"><name><surname>Naska</surname><given-names>A</given-names></name><xref ref-type="aff" rid="aff8">8</xref></contrib><contrib contrib-type="author"><name><surname>Oikonomou</surname><given-names>E</given-names></name><xref ref-type="aff" rid="aff8">8</xref></contrib><contrib contrib-type="author"><name><surname>Berrino</surname><given-names>F</given-names></name><xref ref-type="aff" rid="aff9">9</xref></contrib><contrib contrib-type="author"><name><surname>Panico</surname><given-names>S</given-names></name><xref ref-type="aff" rid="aff10">10</xref></contrib><contrib contrib-type="author"><name><surname>Palli</surname><given-names>D</given-names></name><xref ref-type="aff" rid="aff11">11</xref></contrib><contrib contrib-type="author"><name><surname>Sacerdote</surname><given-names>C</given-names></name><xref ref-type="aff" rid="aff12">12</xref></contrib><contrib contrib-type="author"><name><surname>Tumino</surname><given-names>R</given-names></name><xref ref-type="aff" rid="aff13">13</xref></contrib><contrib contrib-type="author"><name><surname>Peeters</surname><given-names>P H</given-names></name><xref ref-type="aff" rid="aff14">14</xref></contrib><contrib contrib-type="author"><name><surname>Numans</surname><given-names>M E</given-names></name><xref ref-type="aff" rid="aff14">14</xref></contrib><contrib contrib-type="author"><name><surname>Bueno-de-Mesquita</surname><given-names>H B</given-names></name><xref ref-type="aff" rid="aff15">15</xref></contrib><contrib contrib-type="author"><name><surname>B&#x000fc;chner</surname><given-names>F L</given-names></name><xref ref-type="aff" rid="aff15">15</xref></contrib><contrib contrib-type="author"><name><surname>Lund</surname><given-names>E</given-names></name><xref ref-type="aff" rid="aff16">16</xref></contrib><contrib contrib-type="author"><name><surname>Pera</surname><given-names>G</given-names></name><xref ref-type="aff" rid="aff17">17</xref></contrib><contrib contrib-type="author"><name><surname>Chirlaque</surname><given-names>M D</given-names></name><xref ref-type="aff" rid="aff18">18</xref></contrib><contrib contrib-type="author"><name><surname>S&#x000e1;nchez</surname><given-names>M-J</given-names></name><xref ref-type="aff" rid="aff19">19</xref></contrib><contrib contrib-type="author"><name><surname>Arriola</surname><given-names>L</gi