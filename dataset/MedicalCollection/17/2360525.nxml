f="50">0.554</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="4" align="left" valign="top" charoff="50"><italic>Best response to HDT</italic>&#x0002b;<italic>PBSCT</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Complete response (CR)</td><td align="center" valign="top" charoff="50">9 (34.6&#x00025;)</td><td align="center" valign="top" charoff="50">12 (26.7&#x00025;)</td><td align="center" valign="top" charoff="50">0.429</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Partial response (PR)</td><td align="center" valign="top" charoff="50">17 (65.4&#x00025;)</td><td align="center" valign="top" charoff="50">33 (73.3&#x00025;)</td><td align="center" valign="top" charoff="50">0.480</td></tr><tr><td align="left" valign="top" charoff="50">Prior local radiation</td><td align="center" valign="top" charoff="50">6 (23.1&#x00025;)</td><td align="center" valign="top" charoff="50">19 (42.2&#x00025;)</td><td align="center" valign="top" charoff="50">0.104</td></tr><tr><td align="left" valign="top" charoff="50">Surgery prior to initial treatment</td><td align="center" valign="top" charoff="50">15 (57.7&#x00025;)</td><td align="center" valign="top" charoff="50">19 (42.2&#x00025;)</td><td align="center" valign="top" charoff="50">0.209</td></tr><tr><td align="left" valign="top" charoff="50">Osteolyses in long bones</td><td align="center" valign="top" charoff="50">6 (23.1&#x00025;)</td><td align="center" valign="top" charoff="50">19 (42.2&#x00025;)</td><td align="center" valign="top" charoff="50">0.104</td></tr><tr><td align="left" valign="top" charoff="50">Postoperative complications</td><td align="center" valign="top" charoff="50">2 (7.7&#x00025;)</td><td align="center" valign="top" charoff="50">5 (11.1&#x00025;)</td><td align