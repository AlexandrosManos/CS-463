<person-group person-group-type="author"><name><surname>Iversen</surname><given-names>T</given-names></name><name><surname>Tretli</surname><given-names>S</given-names></name><name><surname>Kringlen</surname><given-names>E</given-names></name></person-group><article-title>An epidemiological study of cancer in adult twins born in Norway 1905&#x02013;1945</article-title><source>Br J Cancer</source><year>2001</year><volume>84</volume><fpage>1463</fpage><lpage>1465</lpage><!--PubMed citation query: 'Br J Cancer||84|1463||bib9|'--><pub-id pub-id-type="pmid">11384094</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Michos</surname><given-names>A</given-names></name><name><surname>Xue</surname><given-names>F</given-names></name><name><surname>Michels</surname><given-names>KB</given-names></name></person-group><article-title>Birth weight and the risk of testicular cancer: a meta-analysis</article-title><source>Int J Cancer</source><year>2007</year><volume>121</volume><fpage>1123</fpage><lpage>1131</lpage><!--PubMed citation query: 'Int J Cancer||121|1123||bib10|'--><pub-id pub-id-type="pmid">17471572</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Milne</surname><given-names>E</given-names></name><name><surname>Laurvick</surname><given-names>CL</given-names></name><name><surname>Blair</surname><given-names>E</given-names></name><name><surname>Bower</surname><given-names>C</given-names></name><name><surname>de Klerk</surname><given-names>N</given-names></name></person-group><article-title>Fetal growth and acute childhood leukemia: looking beyond birth weight</article-title><source>Am J Epidemiol</source><year>2007</year><volume>166</volume><fpage>151</fpage><lpage>159</lpage><!--PubMed citation query: 'Am J Epidemiol||166|151||bib11|'--><pub-id pub-id-type="pmid">17443021</pub-id></citation></ref><ref id="bib12"><