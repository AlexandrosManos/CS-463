>3439</lpage><!--PubMed citation query: 'J Clin Oncol||21|3431||bib7|'--><pub-id pub-id-type="pmid">12885835</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dores</surname><given-names>GM</given-names></name><name><surname>Metayer</surname><given-names>C</given-names></name><name><surname>Curtis</surname><given-names>RE</given-names></name><name><surname>Lynch</surname><given-names>CF</given-names></name><name><surname>Clarke</surname><given-names>EA</given-names></name><name><surname>Glimelius</surname><given-names>B</given-names></name><name><surname>Storm</surname><given-names>H</given-names></name><name><surname>Pukkala</surname><given-names>E</given-names></name><name><surname>van Leeuwen</surname><given-names>FE</given-names></name><name><surname>Holowaty</surname><given-names>EJ</given-names></name><name><surname>Andersson</surname><given-names>M</given-names></name><name><surname>Wiklund</surname><given-names>T</given-names></name><name><surname>Joensuu</surname><given-names>T</given-names></name><name><surname>van't Veer</surname><given-names>MB</given-names></name><name><surname>Stovall</surname><given-names>M</given-names></name><name><surname>Gospodarowicz</surname><given-names>M</given-names></name><name><surname>Travis</surname><given-names>LB</given-names></name></person-group><article-title>Second malignant neoplasms among long-term survivors of Hodgkin's disease: a population-based evaluation over 25 years</article-title><source>J Clin Oncol</source><year>2002</year><volume>15</volume><fpage>3484</fpage><lpage>3494</lpage><!--PubMed citation query: 'J Clin Oncol||15|3484||bib8|'--></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Foss Abrahamsen</surname><given-names>J</given-names></name><name><surname>Anderson</surname><given-names>A</given-names></name><name><surname>Hannisdal</surname><given-na