ign="center" valign="top" charoff="50"><bold>Gender<sup>a</sup></bold></th></tr></thead><tbody valign="top"><tr><td align="left" valign="top" charoff="50">Haematological</td><td align="left" valign="top" charoff="50">Acute lymphoblastic leukaemia</td><td align="center" valign="top" charoff="50">2</td><td align="center" valign="top" charoff="50">F</td></tr><tr><td align="left" valign="top" charoff="50">diseases</td><td align="left" valign="top" charoff="50">Acute lymphoblastic leukaemia</td><td align="center" valign="top" charoff="50">17</td><td align="center" valign="top" charoff="50">M</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">Acute lymphoblastic leukaemia</td><td align="center" valign="top" charoff="50">18</td><td align="center" valign="top" charoff="50">M</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">Acute myeloblastic leukaemia</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">M</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">Hodgkin's disease</td><td align="center" valign="top" charoff="50">14</td><td align="center" valign="top" charoff="50">F</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">Non-Hodgkin's lymphoma (clinical diagnosis)</td><td align="center" valign="top" charoff="50">14</td><td align="center" valign="top" charoff="50">M</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">Non-Hodgkin's lymphoma</td><td align="center" valign="top" charoff="50">5</td><td align="center" valign="top" charoff="50">M</td></tr><tr><td align="left" valign="top" charoff="50">CNS tumours</td><td align="left" valign="top" charoff="50">Brain, undefined malignant tumour (clinical diagnosis)</td><td align=