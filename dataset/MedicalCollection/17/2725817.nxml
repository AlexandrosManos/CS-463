08</pub-id><pub-id pub-id-type="pmid">16257260</pub-id></mixed-citation></ref><ref id="R7"><label>7. </label><mixed-citation publication-type="journal"><string-name><surname>Ma</surname> <given-names>X</given-names></string-name>, <string-name><surname>Endo</surname> <given-names>R</given-names></string-name>, <string-name><surname>Ishiguro</surname> <given-names>N</given-names></string-name>, <string-name><surname>Ebihara</surname> <given-names>T</given-names></string-name>, <string-name><surname>Ishiko</surname> <given-names>H</given-names></string-name>, <string-name><surname>Ariga</surname> <given-names>T</given-names></string-name>, <etal/><article-title>Detection of human bocavirus in Japanese children with lower respiratory tract infections.</article-title><source>J Clin Microbiol</source> <year>2006</year>;<volume>44</volume>:<fpage>1132</fpage>&#x02013;<lpage>4</lpage> <pub-id pub-id-type="doi">10.1128/JCM.44.3.1132-1134.2006</pub-id><pub-id pub-id-type="pmid">16517912</pub-id></mixed-citation></ref><ref id="R8"><label>8. </label><mixed-citation publication-type="journal"><string-name><surname>Bastien</surname> <given-names>N</given-names></string-name>, <string-name><surname>Brandt</surname> <given-names>K</given-names></string-name>, <string-name><surname>Dust</surname> <given-names>K</given-names></string-name>, <string-name><surname>Ward</surname> <given-names>D</given-names></string-name>, <string-name><surname>Li</surname> <given-names>Y</given-names></string-name> <article-title>Human bocavirus infection, Canada.</article-title><source>Emerg Infect Dis</source> <year>2006</year>;<volume>12</volume>:<fpage>848</fpage>&#x02013;<lpage>50</lpage><pub-id pub-id-type="pmid">16704852</pub-id></mixed-citation></ref><ref id="R9"><label>9. </label><mixed-citation publication-type="journal"><collab>FouLongne V</collab> <article-title>Rodiere M, Segondy M. Human bocavirus in children.</article-title><source>Emerg Infect Dis</source> <year>2006</year>;<volume>12<