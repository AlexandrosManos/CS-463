itle>Bisphosphonates for breast cancer</article-title><source>Cochrane Database of Systematic Reviews</source><year>2005</year><year>2006</year><volume>4</volume>[Systematic Review] Cochrane Breast Cancer Group</citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Powles</surname><given-names>T</given-names></name><name><surname>Paterson</surname><given-names>A</given-names></name><name><surname>McCloskey</surname><given-names>E</given-names></name><name><surname>Schein</surname><given-names>P</given-names></name><name><surname>Scheffler</surname><given-names>B</given-names></name><name><surname>Tidy</surname><given-names>A</given-names></name><name><surname>Ashley</surname><given-names>S</given-names></name><name><surname>Smith</surname><given-names>I</given-names></name><name><surname>Ottestad</surname><given-names>L</given-names></name><name><surname>Kanis</surname><given-names>J</given-names></name></person-group><article-title>Reduction in bone relapse and improved survival with oral clodronate for adjuvant treatment of operable breast cancer [ISRCTN83688026]</article-title><source>Breast Cancer Res</source><year>2006</year><volume>8</volume><fpage>R13</fpage><!--PubMed citation query: 'Breast Cancer Res||8|R13||bib19|'--><pub-id pub-id-type="pmid">16542503</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Powles</surname><given-names>T</given-names></name><name><surname>Paterson</surname><given-names>S</given-names></name><name><surname>Kanis</surname><given-names>JA</given-names></name><name><surname>McCloskey</surname><given-names>E</given-names></name><name><surname>Ashley</surname><given-names>S</given-names></name><name><surname>Tidy</surname><given-names>A</given-names></name><name><surname>Rosenqvist</surname><given-names>K</given-names></name><name><surname>Smith</surname><given-names>I</given-names></name