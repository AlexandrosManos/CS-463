</supplement><fpage>79</fpage><lpage>83</lpage><!--PubMed citation query: 'Br J Psychiatry||156|79||bib19|'--><pub-id pub-id-type="pmid">2297623</pub-id></citation></ref><ref id="bib20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Richardson</surname><given-names>A</given-names></name><name><surname>Sitzia</surname><given-names>J</given-names></name><name><surname>Brown</surname><given-names>V</given-names></name><name><surname>Medina</surname><given-names>J</given-names></name></person-group><article-title/><source>Patients' Needs Assessment Tools in Cancer Care: Principles and Practice</source><year>2005</year><publisher-name>London: King's College London</publisher-name></citation></ref><ref id="bib21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roth</surname><given-names>AJ</given-names></name><name><surname>Kornblith</surname><given-names>AB</given-names></name><name><surname>Batel-Copel</surname><given-names>L</given-names></name><name><surname>Peabody</surname><given-names>E</given-names></name><name><surname>Scher</surname><given-names>HI</given-names></name><name><surname>Holland</surname><given-names>JC</given-names></name></person-group><article-title>Rapid screening for psychologic distress in men with prostate cancer</article-title><source>Cancer</source><year>1998</year><volume>82</volume><fpage>1904</fpage><lpage>1908</lpage><!--PubMed citation query: 'Cancer||82|1904||bib21|'--><pub-id pub-id-type="pmid">9587123</pub-id></citation></ref><ref id="bib22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schag</surname><given-names>CAC</given-names></name><name><surname>Heinrich</surname><given-names>RL</given-names></name></person-group><article-title>CAncer rehabilitation evaluation system &#x02013; short form (CARES-SF)</article-title><source>Cancer</source><year>1991</year><volume>68</volume><fpage>1406</fpage><lpage>1413</