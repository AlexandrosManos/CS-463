nt>(5)</supplement><fpage>310</fpage><lpage>314</lpage><!--PubMed citation query: 'Mol Pathol||55|310||bib11|'--><pub-id pub-id-type="pmid">12354935</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Edler</surname><given-names>D</given-names></name><name><surname>Hallstrom</surname><given-names>M</given-names></name><name><surname>Johnston</surname><given-names>PG</given-names></name><name><surname>Magnusson</surname><given-names>I</given-names></name><name><surname>Ragnhammar</surname><given-names>P</given-names></name><name><surname>Blomgren</surname><given-names>H</given-names></name></person-group><article-title>Thymidylate synthase expression: an independent prognostic factor for local recurrence, distant metastasis, disease-free and overall survival in rectal cancer</article-title><source>Clin Cancer Res</source><year>2000</year><volume>6</volume><supplement>(4)</supplement><fpage>1378</fpage><lpage>1384</lpage><!--PubMed citation query: 'Clin Cancer Res||6|1378||bib12|'--><pub-id pub-id-type="pmid">10778966</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Edler</surname><given-names>D</given-names></name><name><surname>Hallstrom</surname><given-names>M</given-names></name><name><surname>Ragnhammar</surname><given-names>P</given-names></name><name><surname>Blomgren</surname><given-names>H</given-names></name></person-group><article-title>Thymidylate synthase expression in rectal cancer and proliferation, assessed by cyclin A and Ki-67 expression</article-title><source>Anticancer Res</source><year>2002</year><volume>22</volume><supplement>(5)</supplement><fpage>3113</fpage><lpage>3116</lpage><!--PubMed citation query: 'Anticancer Res||22|3113||bib13|'--><pub-id pub-id-type="pmid">12530053</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ehrnrooth</surname><given-names>E</given-names></name><name><surname>Von Der Maase</surname><given-names>H</given-names></name><name><surname>Sorensen</surname><given-names>BS</given-names></name><name><surname>Hjelm Poulsen</surname><given-names>J</given-names></name></person-group><article-title>The ability of hypoxia to modify the gene expression of thymidylate synthase in tumour cells <italic>in vivo</italic></article-title><source>Int J Radiat Biol</source><year>1999</year><volume>75</volume><supplement>(7)</supplement><fpage>885</fpage><lpage>891</lpage><!--PubMed citation query: 'Int J Radiat Biol||75|885||bib14|'--><pub-id pub-id-type="pmid">10489900</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eickelberg</surname><given-names>O</given-names></name><name><surname>Seebach</surname><given-names>F</given-names></name><name><surname>Riordan</surname><given-names>M</given-names></name><name><surname>Thulin</surname><given-names>G</given-names></name><name><surname>Mann</surname><given-names>A</given-names></name><name><surname>Reidy</surname><given-names>KH</given-names></name><name><surname>Van Why</surname><given-names>SK</given-names></name><name><surname>Kashgarian</surname><given-names>M</given-names></name><name><surname>Siegel</surname><given-names>N</given-names></name></person-group><article-title>Functional activation of heat shock factor and hypoxia-inducible factor in the kidney</article-title><source>J Am Soc Nephrol</source><year>2002</year><volume>13</volume><supplement>(8)</supplement><fpage>2094</fpage><lpage>2101</lpage><!--PubMed citation query: 'J Am Soc Nephrol||13|2094||bib15|'--><pub-id pub-id-type="pmid">12138141</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giaccia</surname><given-names>A</given-names></name><name><surname>Siim</surname><given-names>BG</