gn="left"/><col align="center"/></colgroup><thead valign="bottom"><tr><th align="left" valign="top" charoff="50">&#x000a0;</th><th align="center" valign="top" charoff="50"><bold><italic>n</italic> (&#x00025;)</bold></th></tr></thead><tbody valign="top"><tr><td align="left" valign="top" charoff="50">Age &#x0003c;70/&#x02a7e;70 years</td><td align="center" valign="top" charoff="50">38 (74.5)/13(25.5)</td></tr><tr><td align="left" valign="top" charoff="50">Gender women/men</td><td align="center" valign="top" charoff="50">16 (31.4)/35 (68.6)</td></tr><tr><td align="left" valign="top" charoff="50">Performance status 0&#x02013;1/&#x02a7e;2 (ECOG)</td><td align="center" valign="top" charoff="50">37 (72.5)/14 (27.5)</td></tr><tr><td align="left" valign="top" charoff="50">&#x0003e;5&#x00025; weight loss</td><td align="center" valign="top" charoff="50">11 (21.6)</td></tr><tr><td colspan="2" align="left" valign="top" charoff="50"><italic>Histology</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Squamous cell carcinoma</td><td align="center" valign="top" charoff="50">15 (29.4)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Adenocarcinoma</td><td align="center" valign="top" charoff="50">24 (47.1)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Large-cell carcinoma</td><td align="center" valign="top" charoff="50">12 (23.5)</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Stage<sup>a</sup> IIIB/V</td><td align="center" valign="top" charoff="50">13 (25.5)/38 (74.5)</td></tr><tr><td colspan="2" align="left" valign="top" charoff="50"><italic>Chemotherapy regimens before gefitinib</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;2</td><td align="center" valign="top" charoff="50">30 (58.8)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;3</td><td align="c