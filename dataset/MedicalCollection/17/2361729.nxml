ven-names>M</given-names></name><name><surname>Chin</surname><given-names>DM</given-names></name><name><surname>Lyass</surname><given-names>L</given-names></name><name><surname>Zelnick</surname><given-names>CR</given-names></name><name><surname>Kazarov</surname><given-names>A</given-names></name><name><surname>Toyofuku</surname><given-names>W</given-names></name><name><surname>Gray-Bablin</surname><given-names>J</given-names></name><name><surname>Beerli</surname><given-names>RR</given-names></name><name><surname>Hynes</surname><given-names>NE</given-names></name><name><surname>Nikiforov</surname><given-names>M</given-names></name><name><surname>Haffner</surname><given-names>R</given-names></name><name><surname>Gudkov</surname><given-names>A</given-names></name><name><surname>Keyomarsi</surname><given-names>K</given-names></name></person-group><article-title>Neu differentiation factor (Heregulin) activates a p53-dependent pathway in cancer cells</article-title><source>Oncogene</source><year>1996</year><volume>12</volume><fpage>2535</fpage><lpage>2547</lpage><!--PubMed citation query: 'Oncogene||12|2535||bib4|'--><pub-id pub-id-type="pmid">8700512</pub-id></citation></ref><ref id="bib5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bonaccorsi</surname><given-names>L</given-names></name><name><surname>Carloni</surname><given-names>V</given-names></name><name><surname>Muratori</surname><given-names>M</given-names></name><name><surname>Formigli</surname><given-names>L</given-names></name><name><surname>Zecchi</surname><given-names>S</given-names></name><name><surname>Forti</surname><given-names>G</given-names></name><name><surname>Baldi</surname><given-names>E</given-names></name></person-group><article-title>EGF receptor (EGFR) signaling promoting invasion is disrupted in androgen-sensitive prostate cancer cells by an interaction between EGFR and androgen receptor (AR)</article-title><source>Int J Cancer</source><year>2004</ye