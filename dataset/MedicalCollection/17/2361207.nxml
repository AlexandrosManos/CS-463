</source><year>1999</year><volume>90</volume><fpage>75</fpage><lpage>80</lpage><!--PubMed citation query: 'Jpn J Cancer Res||90|75||bib9|'--><pub-id pub-id-type="pmid">10076568</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kubota</surname><given-names>T</given-names></name><name><surname>Koshizuka</surname><given-names>K</given-names></name><name><surname>Williamson</surname><given-names>EA</given-names></name><name><surname>Asou</surname><given-names>H</given-names></name><name><surname>Said</surname><given-names>JW</given-names></name><name><surname>Holden</surname><given-names>S</given-names></name><name><surname>Miyoshi</surname><given-names>I</given-names></name><name><surname>Koeffler</surname><given-names>HP</given-names></name></person-group><article-title>Ligand for peroxisome proliferator-activated receptor gamma (troglitazone) has potent antitumor effect against human prostate cancer both <italic>in vitro</italic> and <italic>in vivo</italic></article-title><source>Cancer Res</source><year>1998</year><volume>58</volume><fpage>3344</fpage><lpage>3352</lpage><!--PubMed citation query: 'Cancer Res||58|3344||bib10|'--><pub-id pub-id-type="pmid">9699665</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kumar</surname><given-names>R</given-names></name><name><surname>Fidler</surname><given-names>IJ</given-names></name></person-group><article-title>Angiogenic molecules and cancer metastasis</article-title><source><italic>In vivo</italic></source><year>1998</year><volume>12</volume><fpage>27</fpage><lpage>34</lpage><!--PubMed citation query: 'In vivo||12|27||bib11|'--><pub-id pub-id-type="pmid">9575423</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McCarty</surname><given-names>MF</given-names></name><name><surname>Ba