<name><surname>Spiegelman</surname><given-names>BM</given-names></name></person-group><article-title>Terminal differentiation of human breast cancer through PPAR gamma</article-title><source>Mol Cell</source><year>1998</year><volume>1</volume><fpage>465</fpage><lpage>470</lpage><!--PubMed citation query: 'Mol Cell||1|465||bib14|'--><pub-id pub-id-type="pmid">9660931</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ohta</surname><given-names>K</given-names></name><name><surname>Endo</surname><given-names>T</given-names></name><name><surname>Haraguchi</surname><given-names>K</given-names></name><name><surname>Hershman</surname><given-names>JM</given-names></name><name><surname>Onaya</surname><given-names>T</given-names></name></person-group><article-title>Ligands for peroxisome proliferator-activated receptor gamma inhibit growth and induce apoptosis of human papillary thyroid carcinoma cells</article-title><source>J Clin Endocrinol Metab</source><year>2001</year><volume>86</volume><fpage>2170</fpage><lpage>2177</lpage><!--PubMed citation query: 'J Clin Endocrinol Metab||86|2170||bib15|'--><pub-id pub-id-type="pmid">11344222</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Panigrahy</surname><given-names>D</given-names></name><name><surname>Huang</surname><given-names>S</given-names></name><name><surname>Kieran</surname><given-names>MW</given-names></name><name><surname>Kaipainen</surname><given-names>A</given-names></name></person-group><article-title>PPARgamma as a Therapeutic Target for Tumor Angiogenesis and Metastasis</article-title><source>Cancer Biol Ther</source><year>2005</year><volume>4</volume><fpage>687</fpage><lpage>693</lpage><!--PubMed citation query: 'Cancer Biol Ther||4|687||bib16|'--><pub-id pub-id-type="pmid">16082179</pub-id></citation></ref><ref id="bib17"><citation citation-type="journ