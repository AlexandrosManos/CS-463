ion-type="journal"><person-group person-group-type="author"><name><surname>Lotz</surname><given-names>BP</given-names></name><name><surname>Engel</surname><given-names>AG</given-names></name><name><surname>Nishino</surname><given-names>H</given-names></name><name><surname>Stevens</surname><given-names>JC</given-names></name><name><surname>Litchy</surname><given-names>WJ</given-names></name></person-group><article-title>Inclusion body myositis observations in 40 patients</article-title><source>Brain</source><year>1989</year><volume>112</volume><issue>Pt 3</issue><fpage>727</fpage><lpage>747</lpage><pub-id pub-id-type="doi">10.1093/brain/112.3.727</pub-id></citation><citation citation-type="display-unstructured">Lotz BP, Engel AG, Nishino H, Stevens JC, Litchy WJ (1989) Inclusion body myositis observations in 40 patients. Brain 112(Pt 3):727&#x02013;747 <pub-id pub-id-type="pmid">2543478</pub-id></citation></ref><ref id="CR12"><label>12.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oh</surname><given-names>TH</given-names></name><name><surname>Brumfield</surname><given-names>KA</given-names></name><name><surname>Hoskin</surname><given-names>TL</given-names></name><name><surname>Kasperbauer</surname><given-names>JL</given-names></name><name><surname>Basford</surname><given-names>JR</given-names></name></person-group><article-title>Dysphagia in inclusion body myositis: clinical features, management, and clinical outcome</article-title><source>Am J Phys Med Rehabil</source><year>2008</year><volume>87</volume><fpage>883</fpage><lpage>889</lpage><pub-id pub-id-type="doi">10.1097/PHM.0b013e31818a50e2</pub-id></citation><citation citation-type="display-unstructured">Oh TH, Brumfield KA, Hoskin TL, Kasperbauer JL, Basford JR (2008) Dysphagia in inclusion body myositis: clinical features, management, and clinical outcome. Am J Phys Med Rehabil 87:883&#x02013;889 <pub-id pub-id-type="pmid">18936555</pub-id></citation></ref><re