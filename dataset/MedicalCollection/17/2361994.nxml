me><surname>Sumitomo</surname><given-names>M</given-names></name><name><surname>Asano</surname><given-names>T</given-names></name><name><surname>Hayakawa</surname><given-names>M</given-names></name></person-group><article-title>Selective Akt inactivation and tumor necrosis actor-related apoptosis-inducing ligand sensitization of renal cancer cells by low concentrations of paclitaxel</article-title><source>Cancer Res</source><year>2003</year><volume>63</volume><fpage>1365</fpage><lpage>1370</lpage><!--PubMed citation query: 'Cancer Res||63|1365||bib3|'--><pub-id pub-id-type="pmid">12649200</pub-id></citation></ref><ref id="bib4"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berger</surname><given-names>M</given-names></name><name><surname>Shankar</surname><given-names>V</given-names></name><name><surname>Vafai</surname><given-names>A</given-names></name></person-group><article-title>Therapeutic applications of monoclonal antibodies</article-title><source>Am J Med Sci</source><year>2002</year><volume>324</volume><fpage>14</fpage><lpage>30</lpage><!--PubMed citation query: 'Am J Med Sci||324|14||bib4|'--><pub-id pub-id-type="pmid">12120821</pub-id></citation></ref><ref id="bib5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bouralexis</surname><given-names>S</given-names></name><name><surname>Evdokiou</surname><given-names>A</given-names></name><name><surname>Hay</surname><given-names>S</given-names></name><name><surname>Atkins</surname><given-names>G</given-names></name><name><surname>Findlay</surname><given-names>D</given-names></name></person-group><article-title>Enhanced apoptosis of soft tissue sarcoma cells with chemotherapy: a potential new approach using TRAIL</article-title><source>J Orthop Surg</source><year>2001</year><volume>9</volume><fpage>19</fpage><lpage>22</lpage><!--PubMed citation query: 'J Orthop Surg||9|19||bib5|'--></citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bouralexis</surname><given-names>S</given-names></name><name><surname>Findlay</surname><given-names>D</given-names></name><name><surname>Atkins</surname><given-names>G</given-names></name><name><surname>Laabrinidis</surname><given-names>A</given-names></name><name><surname>Hay</surname><given-names>S</given-names></name><name><surname>Evdokiou</surname><given-names>A</given-names></name></person-group><article-title>Progressive resistance of BTK-143 osteosarcoma cells to Apo2L/TRAIL-induced apoptosis is mediated by acquisition of DcR2/TRAIL-R4 expression: resensitisation with chemotherapy</article-title><source>Br J Cancer</source><year>2003</year><volume>89</volume><fpage>206</fpage><lpage>214</lpage><!--PubMed citation query: 'Br J Cancer||89|206||bib6|'--><pub-id pub-id-type="pmid">12838325</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buchsbaum</surname><given-names>D</given-names></name><name><surname>Zhou</surname><given-names>T</given-names></name><name><surname>Grizzle</surname><given-names>W</given-names></name><name><surname>Oliver</surname><given-names>P</given-names></name><name><surname>Hammond</surname><given-names>C</given-names></name><name><surname>Zhang</surname><given-names>S</given-names></name><name><surname>Carpenter</surname><given-names>M</given-names></name><name><surname>LoBuglio</surname><given-names>A</given-names></name></person-group><article-title>Antitumor efficacy of TRA-8 anti-DR5 monoclonal antibody alone or in combination with chemotherapy and/or radiation therapy in a human breast cancer model</article-title><source>Clin Cancer Res</source><year>2003</year><volume>9</volume><fpage>3731</fpage><lpage>3741</lpage><!--PubMed citation query: 'Clin Cancer Res||9|3731||bib7|'--><pub-id pub-id-type="pmid">14506165</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burns</surname><given-names>T</given-names></name><name><surname>El-Deiry</surname><given-names>W</given-names></name></person-group><article-title>Identification of inhibitors of TRAIL-induced death (ITIDs) in the TRAIL-sensitive colon carcinoma cell line SW480 using a genetic approach</article-title><source>J Biol Chem</source><year>2001</year><volume>276</volume><fpage>37879</fpage><lpage>37886</lpage><!--PubMed citation query: 'J Biol Chem||276|37879||bib8|'--><pub-id pub-id-type="pmid">11486001</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chawla-Sarkar</surname><given-names>M</given-names></name><name><surname>Leaman</surname><given-names>D</given-names></name><name><surname>Jacobs</surname><given-names>B</given-names></name><name><surname>Borden</surname><given-names>E</given-names></name></person-group><article-title>IFN-beta pretreatment sensitizes human melenoma cells to TRAIL/Apo2 ligand-induced apoptosis</article-title><source>J Immunol</source><year>2002</year><volume>169</volume><fpage>847</fpage><lpage>855</lpage><!--PubMed citation query: 'J Immunol||169|847||bib9|'--><pub-id pub-id-type="pmid">12097388</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chuntharapai</surname><given-names>A</given-names></name><name><surname>Dodge</surname><given-names>K</given-names></name><name><surname>Grimmer</surname><given-names>K</given-names></name><name><surname>Schroeder</surname><given-names>K</given-names></name><name><surname>Masters</surname><given-names>SA</given-names></name><name><surname>Koeppen</surname><given-names>H</given-names></name><name><surname>Ashkenazi</surname><given-names>A</given-names></name><name><surname>Kim</surname><given-names>KJ</given-names></name></person-group><article-title>Isotype-dependent inhibition of tumor growth <italic>in vivo</italic> by monoclonal antibodies to death receptor 4</article-title><source>J Immunol</source><year>2001</year><volume>166</volume><fpage>4891</fpage><lpage>4898</lpage><!--PubMed citation query: 'J Immunol||166|4891||bib10|'--><pub-id pub-id-type="pmid">11290766</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Evdokiou</surname><given-names>A</given-names></name><name><surname>Bouralexis</surname><given-names>S</given-names></name><name><surname>Atkins</surname><given-names>G</given-names></name></person-group><article-title>Chemotherapeutic agents sensitize osteogenic sarcoma cells, but not normal human bone cells, to apo2L/Trail-induced apoptosis</article-title><source>Int J Cancer</source><year>2002</year><volume>99</volume><fpage>491</fpage><lpage>504</lpage><!--PubMed citation query: 'Int J Cancer||99|491||bib11|'--><pub-id pub-id-type="pmid">11992538</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gliniak</surname><given-names>B</given-names></name><name><surname>Le</surname><given-names>T</given-names></name></person-group><article-title>Tumor necrosis factor-related apoptosis-inducing ligand's antitumor activity <italic>in vivo</italic> is enhanced by the chemotherapeutic agent CPT-11</article-title><source>Cancer Res</source><year>1999</year><volume>59</volume><fpage>6153</fpage><lpage>6158</lpage><!--PubMed citation query: 'Cancer Res||59|6153||bib12|'--><pub-id pub-id-type="pmid">10626806</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Griffith</surname><given-names>T</given-names></name><name><surname>Rauch</surname><given-names>C</given-names></name><name><surname>Smolak</surname><given-names>P</given-names></name><name><surname>Waugh</surname><given-names>J</given-names></na