H</given-names></name></person-group><article-title>A comparative study of three fecal occult blood tests in upper gastrointestinal bleeding</article-title><source>Kaohsiung J Med Sci</source><year>2006</year><volume>22</volume><fpage>223</fpage><lpage>228</lpage><!--PubMed citation query: 'Kaohsiung J Med Sci||22|223||bib4|'--><pub-id pub-id-type="pmid">16793557</pub-id></citation></ref><ref id="bib5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Faivre</surname><given-names>J</given-names></name><name><surname>Dancourt</surname><given-names>V</given-names></name><name><surname>Lejeune</surname><given-names>C</given-names></name><name><surname>Tazi</surname><given-names>MA</given-names></name><name><surname>Lamour</surname><given-names>J</given-names></name><name><surname>Gerard</surname><given-names>D</given-names></name><name><surname>Dassonville</surname><given-names>F</given-names></name><name><surname>Bonithon-Kopp</surname><given-names>C</given-names></name></person-group><article-title>Reduction in colorectal cancer mortality by fecal occult blood screening in a French controlled study</article-title><source>Gastroenterology</source><year>2004</year><volume>126</volume><fpage>1674</fpage><lpage>1680</lpage><!--PubMed citation query: 'Gastroenterology||126|1674||bib5|'--><pub-id pub-id-type="pmid">15188160</pub-id></citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fenocchi</surname><given-names>E</given-names></name><name><surname>Martinez</surname><given-names>L</given-names></name><name><surname>Tolve</surname><given-names>J</given-names></name><name><surname>Montano</surname><given-names>D</given-names></name><name><surname>Rondan</surname><given-names>M</given-names></name><name><surname>Parra-Blanco</surname><given-names>A</given-names></name><name><surname>Eishi</surname><given-names>Y</given-names></name></person-group><article-title>Screening for colorectal cancer in Uruguay with an immunochemical faecal occult blood test</article-title><source>Eur J Cancer Prev</source><year>2006</year><volume>15</volume><fpage>384</fpage><lpage>390</lpage><!--PubMed citation query: 'Eur J Cancer Prev||15|384||bib6|'--><pub-id pub-id-type="pmid">16912566</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferlay</surname><given-names>J</given-names></name><name><surname>Autier</surname><given-names>P</given-names></name><name><surname>Boniol</surname><given-names>M</given-names></name><name><surname>Heanue</surname><given-names>M</given-names></name><name><surname>Colombet</surname><given-names>M</given-names></name><name><surname>Boyle</surname><given-names>P</given-names></name></person-group><article-title>Estimates of the cancer incidence and mortality in Europe in 2006</article-title><source>Ann Oncol</source><year>2007</year><volume>18</volume><fpage>581</fpage><lpage>592</lpage><!--PubMed citation query: 'Ann Oncol||18|581||bib7|'--><pub-id pub-id-type="pmid">17287242</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grazzini</surname><given-names>G</given-names></name><name><surname>Castiglione</surname><given-names>G</given-names></name><name><surname>Ciabattoni</surname><given-names>C</given-names></name><name><surname>Franceschini</surname><given-names>F</given-names></name><name><surname>Giorgi</surname><given-names>D</given-names></name><name><surname>Gozzi</surname><given-names>S</given-names></name><name><surname>Mantellini</surname><given-names>P</given-names></name><name><surname>Lopane</surname><given-names>P</given-names></name><name><surname>Perco</surname><given-names>M</given-names></name><name><surname>Rubeca</surname><given-names>T</given-names></name><name><surname>Salvadori</surname><given-names>P</given-names></name><name><surname>Vi