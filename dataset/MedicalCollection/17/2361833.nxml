6</td><td align="char" valign="top" char="." charoff="50">333.6</td><td align="char" valign="top" char="&#x02013;" charoff="50">5.7&#x02013;2000</td><td align="char" valign="top" char="." charoff="50">7</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;T4</td><td align="char" valign="top" char="." charoff="50">6</td><td align="left" valign="top" charoff="50">5/6</td><td align="char" valign="top" char="." charoff="50">79.0</td><td align="char" valign="top" char="&#x02013;" charoff="50">3.6&#x02013;136</td><td align="char" valign="top" char="." charoff="50">3</td></tr><tr><td colspan="6" align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50"><italic>Gleason score</italic></td><td align="char" valign="top" char="." charoff="50">(<italic>n</italic>=57)</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="&#x02013;" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;2&#x02013;6</td><td align="char" valign="top" char="." charoff="50">9</td><td align="left" valign="top" charoff="50">1/9</td><td align="char" valign="top" char="." charoff="50">67.2</td><td align="char" valign="top" char="&#x02013;" charoff="50">2.7&#x02013;154</td><td align="char" valign="top" char="." charoff="50">3</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;7</td><td align="char" valign="top" char="." charoff="50">7</td><td align="left" valign="top" charoff="50">1/6</td><td align="char" valign="top" char="." charoff="50">16.7</td><td align="char" valign="top" char="&#x02013;" charoff="50">3.6&#x02013;26.9</td><td align="char" valign="top" char="." charoff="50">4</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;8&#x02013;10</td><td align="char" valign="top" char="." charoff="50">41</td><td align="left" valign="top" charoff="50">19/35</td><td align="char" valign="top" char="." charoff="50">286.9</td><td align="char" valign="top" char="&#x02013;" charoff="50">3.6&#x02013;2000</td><td align="char" valign="top" char="." charoff="50">14</td></tr></tbody></table><table-wrap-foot><fn id="tbfnote1"><label>a</label><p>T stage at diagnosis was not available for 19 of the prostate carcinoma cases.</p></fn><fn id="tbfnote2"><label>b</label><p>Not all cases had a bone scan prior to or shortly after the time of surgery.</p></fn><fn id="tbfnote3"><label>c</label><p>PSA data were unavailable for 36 cases at the time of diagnosis. PSA value is in nanograms per millilitre (ng&#x02009;ml<sup>&#x02212;1</sup>).</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>