rib contrib-type="author"><name><surname>Nagai</surname><given-names>Yugo</given-names></name><xref ref-type="aff" rid="aff3">3</xref></contrib>                    <contrib contrib-type="author"><name><surname>Isono</surname><given-names>Kaichi</given-names></name><xref ref-type="aff" rid="aff4">4</xref></contrib>                    <contrib contrib-type="author"><name><surname>Kozu</surname><given-names>Teruo</given-names></name><xref ref-type="aff" rid="aff5">5</xref></contrib>                    <contrib contrib-type="author"><name><surname>Fukutomi</surname><given-names>Hisayuki</given-names></name><xref ref-type="aff" rid="aff6">6</xref></contrib>                    <contrib contrib-type="author"><name><surname>Nakahara</surname><given-names>Akira</given-names></name><xref ref-type="aff" rid="aff6">6</xref></contrib>                    <contrib contrib-type="author"><name><surname>Kashimura</surname><given-names>Hiromasa</given-names></name><xref ref-type="aff" rid="aff6">6</xref></contrib>                    <contrib contrib-type="author"><name><surname>Hirashima</surname><given-names>Toshio</given-names></name><xref ref-type="aff" rid="aff7">7</xref></contrib>                    <contrib contrib-type="author"><name><surname>Murata</surname><given-names>Yoko</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib>                    <contrib contrib-type="author"><name><surname>Ide</surname><given-names>Hiroko</given-names></name><xref ref-type="aff" rid="aff8">8</xref></contrib>                    <contrib contrib-type="author"><name><surname>Kato</surname><given-names>Harubumi</given-names></name><xref ref-type="aff" rid="aff9">9</xref></contrib>                            </contrib-group>                     <aff id="aff1"><label>1</label>                <addr-line>Department of Gastrointestinal Endoscopy</addr-line>                <addr-line>Tokyo Women's Medical College</addr-line>                <addr-line>8-1 Kawada-cho</addr-line>        