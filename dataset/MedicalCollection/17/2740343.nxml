</year><volume>34</volume><fpage>215</fpage><pub-id pub-id-type="pmid">7236984</pub-id></element-citation></ref><ref id="CIT16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mooney</surname><given-names>JF</given-names><suffix>3rd</suffix></name><name><surname>DeFranzo</surname><given-names>A</given-names></name><name><surname>Marks</surname><given-names>MW</given-names></name></person-group><article-title>Use of cross-extremity flaps stabilized with external fixation in severe pediatric foot and ankle trauma: an alternative to free tissue transfer</article-title><source>J Pediatr Orthop</source><year>1998</year><volume>18</volume><fpage>26</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">9449097</pub-id></element-citation></ref><ref id="CIT17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wells</surname><given-names>MD</given-names></name><name><surname>Bowen</surname><given-names>CV</given-names></name><name><surname>Manktelow</surname><given-names>RT</given-names></name><name><surname>Graham</surname><given-names>J</given-names></name><name><surname>Boyd</surname><given-names>JB</given-names></name></person-group><article-title>Lower extremity free flaps: A review</article-title><source>Can J Surg</source><year>1996</year><volume>39</volume><fpage>233</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">8640624</pub-id></element-citation></ref><ref id="CIT18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Serafin</surname><given-names>D</given-names></name><name><surname>Georgiade</surname><given-names>N</given-names></name><name><surname>Smith</surname><given-names>DH</given-names></name></person-group><article-title>Comparison of free flaps with pedicled flaps for coverage of defects of the leg or foot</article-title><source>Plast Reconstr Surg</source><year>1977</year><volume>59</volume><fpage>492</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">322166</pub-id></element-citation></ref><ref id="CIT19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Morris</surname><given-names>AM</given-names></name><name><surname>Buchan</surname><given-names>AC</given-names></name></person-group><article-title>The place of the cross-leg flap in reconstructive surgery of the lower leg and foot: A review of 165 cases</article-title><source>Br J Plast Surg</source><year>1978</year><volume>31</volume><fpage>138</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">346125</pub-id></element-citation></ref><ref id="CIT20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hallock</surname><given-names>GG</given-names></name></person-group><article-title>Impact of the successful flap but failed reconstruction on the true rate of success in free-tissue transfers</article-title><source>J Reconstr Microsurg</source><year>2000</year><volume>16</volume><fpage>589</fpage><lpage>92</lpage><pub-id pub-id-type="pmid">11127279</pub-id></element-citation></ref><ref id="CIT21"><label>21</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hodgkinson</surname><given-names>DJ</given-names></name><name><surname>Irons</surname><given-names>GB</given-names></name></person-group><article-title>Newer applications of the cross-leg flap</article-title><source>Ann Plast Surg</source><year>1980</year><volume>4</volume><fpage>381</fpage><lpage>90</lpage><pub-id pub-id-type="pmid">6108089</pub-id></element-citation></ref><ref id="CIT22"><label>22</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Landra</surname><given-names>AP</given-names></name></person-group><article-title>Salvage of a seriously injured lower limb with a musculo-cutaneous cross-leg flap</article-title><source>Br J Plast Surg</source><year>1982</year><volume>35</volume><fpage>40</fpage><lpage>2</lpage><pub-id pub-id-type="pmid">7066586</pub-id></element-citation></ref><ref id="CIT23"><label>23</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hudson</surname><given-names>DA</given-names></name><name><surname>Millar</surname><given-names>K</given-names></name></person-group><article-title>The cross-leg flap: still a useful flap in children</article-title><source>Br J Plast Surg</source><year>1992</year><volume>45</volume><fpage>146</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">1348654</pub-id></element-citation></ref><ref id="CIT24"><label>24</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Long</surname><given-names>CD</given-names></name><name><surname>Granick</surname><given-names>MS</given-names></name><name><surname>Solomon</surname><given-names>MP</given-names></name></person-group><article-title>The cross-leg flap revisited</article-title><source>Ann Plast Surg</source><year>1993</year><volume>30</volume><fpage>560</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">8368788</pub-id></element-citation></ref></ref-list></back></article>