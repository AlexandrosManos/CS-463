group person-group-type="author"><name><surname>Edwards</surname><given-names>SM</given-names></name><name><surname>Kote-Jarai</surname><given-names>Z</given-names></name><name><surname>Meitz</surname><given-names>J</given-names></name><name><surname>Hamoudi</surname><given-names>R</given-names></name><name><surname>Hope</surname><given-names>Q</given-names></name><name><surname>Osin</surname><given-names>P</given-names></name><name><surname>Jackson</surname><given-names>R</given-names></name><name><surname>Southgate</surname><given-names>C</given-names></name><name><surname>Singh</surname><given-names>R</given-names></name><name><surname>Falconer</surname><given-names>A</given-names></name><name><surname>Dearnaley</surname><given-names>DP</given-names></name><name><surname>Ardern-Jones</surname><given-names>A</given-names></name><name><surname>Murkin</surname><given-names>A</given-names></name><name><surname>Dowe</surname><given-names>A</given-names></name><name><surname>Kelly</surname><given-names>J</given-names></name><name><surname>Williams</surname><given-names>S</given-names></name><name><surname>Oram</surname><given-names>R</given-names></name><name><surname>Stevens</surname><given-names>M</given-names></name><name><surname>Teare</surname><given-names>DM</given-names></name><name><surname>Ponder</surname><given-names>BA</given-names></name><name><surname>Gayther</surname><given-names>SA</given-names></name><name><surname>Easton</surname><given-names>DF</given-names></name><name><surname>Eeles</surname><given-names>RA</given-names></name><collab>Cancer Research UK/British Prostate Group UK Familial Prostate Cancer Study Collaborators; British Association of Urological Surgeons Section of Oncology</collab></person-group><article-title>Two percent of men with early-onset prostate cancer harbor germline mutations in the <italic>BRCA2</italic> gene</article-title><source>Am J Hum Genet</source><year>2003</year><volume>72</volume><supplement>1</supplement><fpage>1</fpage><lpage>12</lpage><!--PubMed citation query: 'Am J Hum Genet||72|1||bib11|'--><pub-id pub-id-type="pmid">12474142</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Epstein</surname><given-names>JI</given-names></name><name><surname>Allsbrook</surname><given-names>WC</given-names><suffix>Jr</suffix></name><name><surname>Amin</surname><given-names>MB</given-names></name><name><surname>Egevad</surname><given-names>LL</given-names></name><collab>ISUP Grading Committee</collab></person-group><article-title>The 2005 international society of urological pathology (ISUP) consensus conference on Gleason grading of prostatic carcinoma</article-title><source>Am J Surg Pathol</source><year>2005</year><volume>29</volume><fpage>1228</fpage><lpage>1242</lpage><!--PubMed citation query: 'Am J Surg Pathol||29|1228||bib12|'--><pub-id pub-id-type="pmid">16096414</pub-id></citation></ref><ref id="bib13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Foster</surname><given-names>CS</given-names></name></person-group><article-title/><source>Prostatic Cancer &#x02013; A Consensus</source><year>1991</year><publisher-name>London: Edward Arnold</publisher-name><fpage>67</fpage><lpage>91</lpage>Pathological grading systems for prostate cancer. InWaxman J, Williams G (eds) pp</citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giusti</surname><given-names>RM</given-names></name><name><surname>Rutter</surname><given-names>JL</given-names></name><name><surname>Duray</surname><given-names>PH</given-names></name><name><surname>Freedman</surname><given-names>LS</given-names></name><name><surname>Konichezky</surname><given-names>M</given-names></name><name><surname>Fisher-Fischbein</surname><given-names>J</given-names></name><name><surname>Greene</surname><given-names>MH</given-names></name><name><surname>M