-id></citation></ref><ref id="bib4"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Andela</surname><given-names>VB</given-names></name><name><surname>Gordon</surname><given-names>AH</given-names></name><name><surname>Zotalis</surname><given-names>G</given-names></name><name><surname>Rosier</surname><given-names>RN</given-names></name><name><surname>Goater</surname><given-names>JJ</given-names></name><name><surname>Lewis</surname><given-names>GD</given-names></name><name><surname>Schwarz</surname><given-names>EM</given-names></name><name><surname>Puzas</surname><given-names>JE</given-names></name><name><surname>O'Keefe</surname><given-names>RJ</given-names></name></person-group><article-title>NFkappaB: a pivotal transcription factor in prostate cancer metastasis to bone</article-title><source>Clin Orthop</source><year>2003</year><volume>415</volume><supplement>Suppl</supplement><fpage>S75</fpage><lpage>S85</lpage><!--PubMed citation query: 'Clin Orthop||415|S75||bib4|'--></citation></ref><ref id="bib5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ashida</surname><given-names>S</given-names></name><name><surname>Nakagawa</surname><given-names>H</given-names></name><name><surname>Katagiri</surname><given-names>T</given-names></name><name><surname>Furihata</surname><given-names>M</given-names></name><name><surname>Iiizumi</surname><given-names>M</given-names></name><name><surname>Anazawa</surname><given-names>Y</given-names></name><name><surname>Tsunoda</surname><given-names>T</given-names></name><name><surname>Takata</surname><given-names>R</given-names></name><name><surname>Kasahara</surname><given-names>K</given-names></name><name><surname>Miki</surname><given-names>T</given-names></name><name><surname>Fujioka</surname><given-names>T</given-names></name><name><surname>Shuin</surname><given-names>T</given-names></name><name><surname>Nakamura</surname><given-names>Y</given-names></n