"journal"><person-group person-group-type="author"><name><surname>Nishimura</surname><given-names>N</given-names></name><name><surname>Reeve</surname><given-names>VE</given-names></name><name><surname>Nishimura</surname><given-names>H</given-names></name><name><surname>Satoh</surname><given-names>M</given-names></name><name><surname>Tohyama</surname><given-names>C</given-names></name></person-group><article-title>Cutaneous metallothionein induction by ultraviolet B irradiation in interleukin-6 null mice</article-title><source>J Invest Dermatol</source><year>2000</year><volume>114</volume><fpage>343</fpage><lpage>348</lpage><!--PubMed citation query: 'J Invest Dermatol||114|343||bib19|'--><pub-id pub-id-type="pmid">10651996</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nordberg</surname><given-names>M</given-names></name><name><surname>Nordberg</surname><given-names>GF</given-names></name></person-group><article-title>Toxicological aspects of metallothionein</article-title><source>Cell Mol Biol</source><year>2000</year><volume>46</volume><fpage>451</fpage><lpage>463</lpage><!--PubMed citation query: 'Cell Mol Biol||46|451||bib20|'--></citation></ref><ref id="bib21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>&#x000d6;fner</surname><given-names>D</given-names></name><name><surname>Maier</surname><given-names>H</given-names></name><name><surname>Riedmann</surname><given-names>B</given-names></name><name><surname>Bammer</surname><given-names>T</given-names></name><name><surname>Rumer</surname><given-names>A</given-names></name><name><surname>Winde</surname><given-names>G</given-names></name><name><surname>Bocker</surname><given-names>W</given-names></name><name><surname>Jasani</surname><given-names>B</given-names></name><name><surname>Schmid</surname><given-names>KW</given-names></name></person-group><article-title>Immunohistochemical metall