<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article article-type="research-article"><?properties open_access?><!-- Original-type: ra--><front><journal-meta><journal-id journal-id-type="nlm-ta">Br J Cancer</journal-id><journal-title>British Journal of Cancer</journal-title><issn pub-type="ppub">0007-0920</issn><issn pub-type="epub">1532-1827</issn><publisher><publisher-name>Nature Publishing Group</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">10574259</article-id><article-id pub-id-type="pmc">2362899</article-id><article-id pub-id-type="pii">6690751</article-id><article-id pub-id-type="doi">10.1038/sj.bjc.6690751</article-id><article-categories><subj-group subj-group-type="heading"><subject>Regular Article</subject></subj-group></article-categories><title-group><article-title>Serum p53 autoantibodies in patients with minimal lesions of ductal carcinoma in situ of the breast</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Regele</surname><given-names>S</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Kohlberger</surname><given-names>P</given-names></name><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Vogl</surname><given-names>F D</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>B&#x000f6;hm</surname><given-names>W</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Kreienberg</surname><given-names>R</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Runnebaum</surname><given-names>I B</given-names></name><xref ref-type="aff" rid="aff2">2</xref></contrib></contrib-group><aff id="aff1"><label>1</label>Department of Obstetrics and Gynaecology, University of Ulm, Prittwitzstr. 43, Ulm, 89075, Germany</aff><aff id="aff2"><label>2</label>Department of Obstetrics and Gynaecology, University of Freiburg, Hugstetterstr. 55, Freiburg, 79106, Germany</aff><pub-date pub-type="ppub"><month>10</month><year>1999</year></pub-date><volume>81</volume><issue>4</issue><fpage>702</fpage><lpage>704</lpage><history><date date-type="received"><day>02</day><month>10</month><year>1998</year></date><date date-type="rev-recd"><day>14</day><month>04</month><year>1999</year></date><date date-type="accepted"><day>22</day><month>04</month><year>1999</year></date></history><copyright-statement>Copyright 1999, Cancer Research Campaign</copyright-statement><copyright-year>1999</copyright-year><permissions><copyright-holder>Cancer Research Campaign</copyright-holder></permissions><abstract><p>Five of 43 patients (11.6&#x00025;) with ductal carcinoma in situ of the breast presented with p53 autoantibodies at diagnosis. Three seropositive patients demonstrated tumour sizes of &#x02264; 5 mm. There was no association of p53 autoantibody status with age, clinical presentation, histological subtype, tumour size, grading, p53 immunohistochemistry or hormone receptor status. &#x000a9; 1999 Cancer Research Campaign</p></abstract><kwd-group><kwd>breast cancer</kwd><kwd>ductal carcinoma in situ</kwd><kwd>p53</kwd><kwd>autoantibodies</kwd></kwd-group></article-meta></front></article>