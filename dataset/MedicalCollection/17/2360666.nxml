>R</given-names></name><name><surname>Kehr</surname><given-names>G</given-names></name><name><surname>Boehm</surname><given-names>E</given-names></name><name><surname>Armbruster</surname><given-names>FP</given-names></name><name><surname>Bastert</surname><given-names>G</given-names></name></person-group><article-title>Serum bone sialoprotein in patients with primary breast cancer is a prognostic marker for subsequent bone metastasis</article-title><source>Clin Cancer Res</source><year>1999</year><volume>5</volume><fpage>3914</fpage><lpage>3919</lpage><!--PubMed citation query: 'Clin Cancer Res||5|3914||bib10|'--><pub-id pub-id-type="pmid">10632320</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Duffy</surname><given-names>MJ</given-names></name><name><surname>Blaser</surname><given-names>J</given-names></name><name><surname>Duggan</surname><given-names>C</given-names></name><name><surname>McDermott</surname><given-names>E</given-names></name><name><surname>O'Higgins</surname><given-names>N</given-names></name><name><surname>Fennelly</surname><given-names>JJ</given-names></name><name><surname>Tschesche</surname><given-names>H</given-names></name></person-group><article-title>Assay of matrix metalloproteases types 8 and 9 by ELISA in human breast cancer</article-title><source>Br J Cancer</source><year>1995</year><volume>71</volume><fpage>1025</fpage><lpage>1028</lpage><!--PubMed citation query: 'Br J Cancer||71|1025||bib11|'--><pub-id pub-id-type="pmid">7734294</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Duffy</surname><given-names>MJ</given-names></name><name><surname>Maguire</surname><given-names>TM</given-names></name><name><surname>Hill</surname><given-names>A</given-names></name><name><surname>McDermott</surname><given-names>E</given-names></name><name><surname>O'Higgins</surname><given-names>N</