 charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;II: granular, gastritis</td><td align="center" valign="top" charoff="50">1 (6.7)</td><td align="center" valign="top" charoff="50">18 (21.4)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;III: depressed, erosion</td><td align="center" valign="top" charoff="50">6 (40.0)</td><td align="center" valign="top" charoff="50">44 (52.4)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;IV: excavated, ulceration</td><td align="center" valign="top" charoff="50">4 (26.7)</td><td align="center" valign="top" charoff="50">11 (13.1)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;V: mixed</td><td align="center" valign="top" charoff="50">1 (6.7)</td><td align="center" valign="top" charoff="50">5 (6.0)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50"><italic>Endoscopic location</italic> (&#x00025;)</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">0.001</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Proximal<sup>a</sup></td><td align="center" valign="top" charoff="50">10 (80.0)</td><td align="center" valign="top" charoff="50">19 (22.6)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Distal<sup>b</sup></td><td align="center" valign="top" charoff="50">5 (20.0)</td><td