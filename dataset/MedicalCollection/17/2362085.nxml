ge><lpage>253</lpage><!--PubMed citation query: 'J Clin Oncol||20|247||bib8|'--><pub-id pub-id-type="pmid">11773176</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Deppermann</surname><given-names>KM</given-names></name></person-group><article-title>Influence of age and comorbidities on the chemotherapeutic management of lung cancer</article-title><source>Lung Cancer</source><year>2001</year><volume>33</volume><fpage>S115</fpage><lpage>S120</lpage><!--PubMed citation query: 'Lung Cancer||33|S115||bib9|'--><pub-id pub-id-type="pmid">11576716</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Earle</surname><given-names>CC</given-names></name><name><surname>Neumann</surname><given-names>PJ</given-names></name><name><surname>Gelber</surname><given-names>RD</given-names></name><name><surname>Weinstein</surname><given-names>MC</given-names></name><name><surname>Weeks</surname><given-names>JC</given-names></name></person-group><article-title>Impact of referral patterns on the use of chemotherapy for lung cancer</article-title><source>J Clin Oncol</source><year>2002</year><volume>20</volume><fpage>1786</fpage><lpage>1792</lpage><!--PubMed citation query: 'J Clin Oncol||20|1786||bib10|'--><pub-id pub-id-type="pmid">11919235</pub-id></citation></ref><ref id="bib11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Emami</surname><given-names>B</given-names></name><name><surname>Perez</surname><given-names>C</given-names></name></person-group><article-title>Lung</article-title><source>Princile and Practice of Radiation Oncology</source><year>1992</year><publisher-name>Philidelphia: JB Lippincott</publisher-name><fpage>806</fpage><lpage>836</lpage>2nd edn, Perez CA, Brady LW (eds) pp</citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="