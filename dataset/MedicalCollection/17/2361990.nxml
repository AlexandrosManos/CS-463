citation-type="journal"><person-group person-group-type="author"><name><surname>Howe</surname><given-names>G</given-names></name><name><surname>Rohan</surname><given-names>T</given-names></name><name><surname>Decarli</surname><given-names>A</given-names></name></person-group><article-title>The association between alcohol and breast cancer risk: evidence from the combined analysis of six dietary case&#x02013;control studies</article-title><source>Int J Cancer</source><year>1991</year><volume>47</volume><fpage>707</fpage><lpage>710</lpage><!--PubMed citation query: 'Int J Cancer||47|707||bib10|'--><pub-id pub-id-type="pmid">2004852</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jacques</surname><given-names>PF</given-names></name><name><surname>Sulsky</surname><given-names>SI</given-names></name><name><surname>Sadowski</surname><given-names>JA</given-names></name></person-group><article-title>Comparison of micronutrient intake measured by dietary questionnaire and biochemical indicators of micronutrient status</article-title><source>Am J Clin Nutr</source><year>1993</year><volume>57</volume><fpage>182</fpage><lpage>189</lpage><!--PubMed citation query: 'Am J Clin Nutr||57|182||bib11|'--><pub-id pub-id-type="pmid">8424386</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>YI</given-names></name></person-group><article-title>Folate and carcinogenesis: evidence, mechanisms and implications</article-title><source>J Nutr Biochem</source><year>1999</year><volume>10</volume><fpage>66</fpage><lpage>88</lpage><!--PubMed citation query: 'J Nutr Biochem||10|66||bib12|'--><pub-id pub-id-type="pmid">15539274</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kropp</surname><given-names>S</given-names></name><name><s