xt-link><comment>[In KDD'02]</comment></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="book"><name><surname>Celko</surname><given-names>J</given-names></name><source>Joe Celko's SQL for Smarties: Trees and Hierarchies</source><year>2004</year><publisher-name>San Francisco, CA, USA: Morgan Kaufmann Publishers Inc</publisher-name></mixed-citation></ref><ref id="B19"><mixed-citation publication-type="journal"><name><surname>Tropashko</surname><given-names>V</given-names></name><article-title>Nested intervals tree encoding in SQL</article-title><source>SIGMOD Record</source><year>2005</year><volume>34</volume><fpage>47</fpage><lpage>52</lpage></mixed-citation></ref><ref id="B20"><mixed-citation publication-type="book"><name><surname>Cormen</surname><given-names>TH</given-names></name><name><surname>Leiserson</surname><given-names>CE</given-names></name><name><surname>Rivest</surname><given-names>RL</given-names></name><name><surname>Stein</surname><given-names>C</given-names></name><source>Introduction to algorithms</source><year>2001</year><publisher-name>Cambridge, MA: MIT Press</publisher-name></mixed-citation></ref><ref id="B21"><mixed-citation publication-type="other"><name><surname>Bender</surname><given-names>MA</given-names></name><name><surname>Farach-Colton</surname><given-names>M</given-names></name><article-title>The LCA problem revisited</article-title><source>LATIN</source><year>2000</year><fpage>88</fpage><lpage>94</lpage></mixed-citation></ref><ref id="B22"><mixed-citation publication-type="journal"><name><surname>Zobel</surname><given-names>J</given-names></name><name><surname>Moffat</surname><given-names>A</given-names></name><article-title>Inverted files for text search engines</article-title><source>ACM Comput Surv</source><year>2006</year><volume>38</volume><issue>2</issue><ext-link ext-link-type="uri" xlink:href="http://portal.acm.org/citation.cfm?id=1132956.1132959">http://portal.acm.org/citation.cfm?id=1132956.1132959</ext-l