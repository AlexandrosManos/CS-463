le>Optimization and validation of a multiplexed luminex assay to quantify antibodies to neutralizing epitopes on human papillomaviruses 6, 11, 16, and 18</article-title><source>Clin Diagn Lab Immunol</source><year>2005</year><volume>12</volume><fpage>959</fpage><lpage>969</lpage><!--PubMed citation query: 'Clin Diagn Lab Immunol||12|959||bib3|'--><pub-id pub-id-type="pmid">16085914</pub-id></citation></ref><ref id="bib4"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dillner</surname><given-names>J</given-names></name></person-group><article-title>The serological response to papillomaviruses</article-title><source>Semin Cancer Biol</source><year>1999</year><volume>9</volume><fpage>423</fpage><lpage>430</lpage><!--PubMed citation query: 'Semin Cancer Biol||9|423||bib4|'--><pub-id pub-id-type="pmid">10712889</pub-id></citation></ref><ref id="bib5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferguson</surname><given-names>M</given-names></name><name><surname>Heath</surname><given-names>A</given-names></name><name><surname>Johnes</surname><given-names>S</given-names></name><name><surname>Pagliusi</surname><given-names>S</given-names></name><name><surname>Dillner</surname><given-names>J</given-names></name></person-group><article-title>Results of the first WHO international collaborative study on the standardization of the detection of antibodies to human papillomaviruses</article-title><source>Int J Cancer</source><year>2006</year><volume>118</volume><supplement>6</supplement><fpage>1508</fpage><lpage>1514</lpage><!--PubMed citation query: 'Int J Cancer||118|1508||bib5|'--><pub-id pub-id-type="pmid">16184553</pub-id></citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harper</surname><given-names>DM</given-names></name><name><surname>Franco</surname><given-names>EL</given-names></name><name><surname>Wheeler</surnam