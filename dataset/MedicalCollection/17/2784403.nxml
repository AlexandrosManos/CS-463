ub-id><pub-id pub-id-type="pmid">18043057</pub-id></mixed-citation></ref><ref id="B5"><mixed-citation publication-type="journal"><name><surname>Sear</surname><given-names>JW</given-names></name><article-title>Kidney dysfunction in the postoperative period</article-title><source>Br J Anaesth</source><year>2005</year><volume>95</volume><fpage>20</fpage><lpage>32</lpage><pub-id pub-id-type="doi">10.1093/bja/aei018</pub-id><pub-id pub-id-type="pmid">15531622</pub-id></mixed-citation></ref><ref id="B6"><mixed-citation publication-type="journal"><name><surname>Burns</surname><given-names>KE</given-names></name><name><surname>Chu</surname><given-names>MW</given-names></name><name><surname>Novick</surname><given-names>RJ</given-names></name><name><surname>Fox</surname><given-names>SA</given-names></name><name><surname>Gallo</surname><given-names>K</given-names></name><name><surname>Martin</surname><given-names>CM</given-names></name><name><surname>Stitt</surname><given-names>LW</given-names></name><name><surname>Heidenheim</surname><given-names>AP</given-names></name><name><surname>Myers</surname><given-names>ML</given-names></name><name><surname>Moist</surname><given-names>L</given-names></name><article-title>Perioperative N-acetylcysteine to prevent renal dysfunction in high-risk patients undergoing cabg surgery: a randomized controlled trial</article-title><source>JAMA</source><year>2005</year><volume>294</volume><fpage>342</fpage><lpage>350</lpage><pub-id pub-id-type="doi">10.1001/jama.294.3.342</pub-id><pub-id pub-id-type="pmid">16030279</pub-id></mixed-citation></ref><ref id="B7"><mixed-citation publication-type="journal"><name><surname>McNelis</surname><given-names>J</given-names></name><name><surname>Soffer</surname><given-names>S</given-names></name><name><surname>Marini</surname><given-names>CP</given-names></name><name><surname>Jurkiewicz</surname><given-names>A</given-names></name><name><surname>Ritter</surname><given-names>G</given-names></name><name><surname>S