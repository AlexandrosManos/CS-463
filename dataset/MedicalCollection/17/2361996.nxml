group person-group-type="author"><name><surname>Cooper</surname><given-names>JS</given-names></name><name><surname>Pajak</surname><given-names>TF</given-names></name><name><surname>Forastiere</surname><given-names>A</given-names></name><name><surname>Jacobs</surname><given-names>J</given-names></name><name><surname>Fu</surname><given-names>KK</given-names></name><name><surname>Ang</surname><given-names>KK</given-names></name><name><surname>Laramore</surname><given-names>GE</given-names></name><name><surname>Al-Sarraf</surname><given-names>M</given-names></name></person-group><article-title>Precisely defining high-risk operable head and neck tumors based on RTOG &#x00023;85-03 and &#x00023;88-24: targets for postoperative radiochemotherapy</article-title><source>Head Neck</source><year>1998</year><volume>20</volume><supplement>7</supplement><fpage>588</fpage><lpage>594</lpage><!--PubMed citation query: 'Head Neck||20|588||bib13|'--><pub-id pub-id-type="pmid">9744457</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cooper</surname><given-names>JS</given-names></name><name><surname>Pajak</surname><given-names>TF</given-names></name><name><surname>Forastiere</surname><given-names>AA</given-names></name><name><surname>Jacobs</surname><given-names>J</given-names></name><name><surname>Campbell</surname><given-names>BH</given-names></name><name><surname>Saxman</surname><given-names>SB</given-names></name><name><surname>Kish</surname><given-names>JA</given-names></name><name><surname>Kim</surname><given-names>HE</given-names></name><name><surname>Cmelak</surname><given-names>AJ</given-names></name><name><surname>Rotman</surname><given-names>M</given-names></name><name><surname>Machtay</surname><given-names>M</given-names></name><name><surname>Ensley</surname><given-names>JF</given-names></name><name><surname>Chao</surname><given-names>KS</given-names></name><name><surname>Schultz</surname><give