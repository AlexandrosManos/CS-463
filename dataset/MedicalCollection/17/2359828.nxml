-names></name></person-group><source>Cell Mol Life Sci</source><year>2001</year><volume>58</volume><fpage>737</fpage><lpage>747</lpage></citation><citation citation-type="display-unstructured">Anzenbacher P, Anzenbacherov&#x000e1; E (2001) Cell Mol Life Sci 58:737&#x02013;747 <pub-id pub-id-type="pmid">11437235</pub-id></citation></ref><ref id="CR9"><label>9.</label><citation citation-type="other">Hyndman D, Bauman DR, Heredia VV, Penning TM (2002) Chem Biol Interact 143&#x02013;144:621&#x02013;631</citation></ref><ref id="CR10"><label>10.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nordling</surname><given-names>E</given-names></name><name><surname>J&#x000f6;rnvall</surname><given-names>H</given-names></name><name><surname>Persson</surname><given-names>B</given-names></name></person-group><source>Eur J Biochem</source><year>2002</year><volume>269</volume><fpage>4267</fpage><lpage>4276</lpage></citation><citation citation-type="display-unstructured">Nordling E, J&#x000f6;rnvall H, Persson B (2002) Eur J Biochem 269:4267&#x02013;4276 <pub-id pub-id-type="pmid">12199705</pub-id></citation></ref><ref id="CR11"><label>11.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kallberg</surname><given-names>Y</given-names></name><name><surname>Oppermann</surname><given-names>U</given-names></name><name><surname>J&#x000f6;rnvall</surname><given-names>H</given-names></name><name><surname>Persson</surname><given-names>B</given-names></name></person-group><source>Eur J Biochem</source><year>2002</year><volume>269</volume><fpage>4409</fpage><lpage>4417</lpage></citation><citation citation-type="display-unstructured">Kallberg Y, Oppermann U, J&#x000f6;rnvall H, Persson B (2002) Eur J Biochem 269:4409&#x02013;4417 <pub-id pub-id-type="pmid">12230552</pub-id></citation></ref><ref id="CR12"><label>12.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roberts</surname><given-names>MS</given-names></name><name><surname>Magnusson</surname><given-names>BM</given-names></name><name><surname>Burczynski</surname><given-names>FJ</given-names></name><name><surname>Weiss</surname><given-names>M</given-names></name></person-group><source>Clin Pharmacokinet</source><year>2002</year><volume>41</volume><fpage>751</fpage><lpage>790</lpage></citation><citation citation-type="display-unstructured">Roberts MS, Magnusson BM, Burczynski FJ, Weiss M (2002) Clin Pharmacokinet 41:751&#x02013;790 <pub-id pub-id-type="pmid">12162761</pub-id></citation></ref><ref id="CR13"><label>13.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nobilis</surname><given-names>M</given-names></name><name><surname>Kvasni&#x0010d;kov&#x000e1;</surname><given-names>E</given-names></name><name><surname>&#x00160;roler</surname><given-names>A</given-names></name><name><surname>Hais</surname><given-names>IM</given-names></name></person-group><source>Drug Metab Drug Interact</source><year>1991</year><volume>9</volume><fpage>225</fpage><lpage>240</lpage></citation><citation citation-type="display-unstructured">Nobilis M, Kvasni&#x0010d;kov&#x000e1; E, &#x00160;roler A, Hais IM (1991) Drug Metab Drug Interact 9:225&#x02013;240 </citation></ref><ref id="CR14"><label>14.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nobilis</surname><given-names>M</given-names></name><name><surname>Hol&#x0010d;apek</surname><given-names>M</given-names></name><name><surname>Kol&#x000e1;&#x00159;ov&#x000e1;</surname><given-names>L</given-names></name><name><surname>Kopeck&#x000fd;</surname><given-names>J</given-names></name><name><surname>Kune&#x00161;</surname><given-names>M</given-names></name><name><surname>Svoboda</surname><given-names>Z</given-names></name><name><surname>Kv&#x0011b;tina</surname><given-names>J</given-names></name></person-group><source>J Chromatogr A</so