 mice</article-title><source>Clin Cancer Res</source><year>2001</year><volume>7</volume><fpage>830</fpage><lpage>837s</lpage><!--PubMed citation query: 'Clin Cancer Res||7|830||bib12|'--></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dyall</surname><given-names>R</given-names></name><name><surname>Bowne</surname><given-names>WB</given-names></name><name><surname>Weber</surname><given-names>LW</given-names></name><name><surname>LeMaoult</surname><given-names>J</given-names></name><name><surname>Szabo</surname><given-names>P</given-names></name><name><surname>Moroi</surname><given-names>Y</given-names></name><name><surname>Piskun</surname><given-names>G</given-names></name><name><surname>Lewis</surname><given-names>JJ</given-names></name><name><surname>Houghton</surname><given-names>AN</given-names></name><name><surname>Nikolic-Zugic</surname><given-names>J</given-names></name></person-group><article-title>Heteroclitic immunization induces tumor immunity</article-title><source>J Exp Med</source><year>1998</year><volume>188</volume><fpage>1553</fpage><lpage>1561</lpage><!--PubMed citation query: 'J Exp Med||188|1553||bib13|'--><pub-id pub-id-type="pmid">9802967</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gehl</surname><given-names>J</given-names></name></person-group><article-title>Electroporation: theory and methods, perspectives for drug delivery, gene therapy and research</article-title><source>Acta Physiol Scand</source><year>2003</year><volume>177</volume><fpage>437</fpage><lpage>447</lpage><!--PubMed citation query: 'Acta Physiol Scand||177|437||bib14|'--><pub-id pub-id-type="pmid">12648161</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gilboa</surname><given-names>E</given-names></name></person-group><article-title>The 