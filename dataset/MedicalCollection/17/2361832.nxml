given-names></name></person-group><article-title>Groin recurrence after micrometastases in a sentinel lymph node in a patient with vulval cancer</article-title><source>Gynecol Oncol</source><year>2002</year><volume>86</volume><fpage>99</fpage><lpage>101</lpage><!--PubMed citation query: 'Gynecol Oncol||86|99||bib6|'--><pub-id pub-id-type="pmid">12079308</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Umekita</surname><given-names>Y</given-names></name><name><surname>Ohi</surname><given-names>Y</given-names></name><name><surname>Sagara</surname><given-names>Y</given-names></name><name><surname>Yoshida</surname><given-names>H</given-names></name></person-group><article-title>Clinical significance of occult micrometastases in &#x02018;node negative' breast cancer patients</article-title><source>Jpn J Cancer Res</source><year>2002</year><volume>93</volume><supplement>6</supplement><fpage>695</fpage><lpage>698</lpage><!--PubMed citation query: 'Jpn J Cancer Res||93|695||bib7|'--><pub-id pub-id-type="pmid">12079518</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Van Trappen</surname><given-names>PO</given-names></name><name><surname>Gyselman</surname><given-names>VG</given-names></name><name><surname>Lowe</surname><given-names>DG</given-names></name><name><surname>Ryan</surname><given-names>A</given-names></name><name><surname>Oram</surname><given-names>DH</given-names></name><name><surname>Bosze</surname><given-names>P</given-names></name><name><surname>Weekes</surname><given-names>AR</given-names></name><name><surname>Shepherd</surname><given-names>JH</given-names></name><name><surname>Dorudi</surname><given-names>S</given-names></name><name><surname>Bustin</surname><given-names>SA</given-names></name><name><surname>Jacobs</surname><given-names>IJ</given-names></name></person-group><article-title>Molecular quantification and mapping of lymph-node micrometastases in cervical cancer</article-title><source>Lancet</source><year>2001</year><volume>357</volume><supplement>9249</supplement><fpage>15</fpage><lpage>20</lpage><!--PubMed citation query: 'Lancet||357|15||bib8|'--><pub-id pub-id-type="pmid">11197354</pub-id></citation></ref></ref-list></back><floats-wrap><fig id="fig1"><label>Figure 1</label><caption><p>Micrometastases &#x02013; cells in clusters.</p></caption><graphic xmlns:xlink="http://www.w3.org/1999/xlink" mime-subtype="jpeg" xlink:href="92-6602343f1"/></fig><fig id="fig2"><label>Figure 2</label><caption><p>Relationship with time to recurrence and nodal status of micrometastases (adjusted for age).</p></caption><graphic xmlns:xlink="http://www.w3.org/1999/xlink" mime-subtype="jpeg" xlink:href="92-6602343f2"/></fig><table-wrap id="tbl1" position="float"><label>Table 1</label><caption><p content-type="table-title">Patient's characteristics with respect to nodal micrometastatic status</p></caption><table frame="hsides" rules="groups" border="1" width="85%"><colgroup><col align="left"/><col align="left"/><col align="char" char="."/><col align="char" char="."/><col align="char" char="."/></colgroup><thead valign="bottom"><tr><th align="left" valign="top" charoff="50">&#x000a0;</th><th align="left" valign="top" charoff="50">&#x000a0;</th><th align="char" valign="top" char="." charoff="50"><bold>No micrometastases, 18 patients</bold></th><th align="char" valign="top" char="." charoff="50"><bold>Micrometastases, 13 patients</bold></th><th align="char" valign="top" char="." charoff="50"><bold>Total, 31 patients</bold></th></tr></thead><tbody valign="top"><tr><td align="left" valign="top" charoff="50">Tumour diameter (cm)</td><td align="left" valign="top" charoff="50">0&#x02013;2</td><td align="char" valign="top" char="." charoff="50">10</td><td align="char" valign="top" char="." charoff="50">6</td><td align="char" valign="top" char="." charoff="50">16</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">2.1&#x02013;4</td><td align="char" valign="top" char="." charoff="50">4</td><td align="char" valign="top" char="." charoff="50">3</td><td align="char" valign="top" char="." charoff="50">7</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x0003e;4.1</td><td align="char" valign="top" char="." charoff="50">3</td><td align="char" valign="top" char="." charoff="50">4</td><td align="char" valign="top" char="." charoff="50">7</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">Not recorded</td><td align="char" valign="top" char="." charoff="50">1</td><td align="char" valign="top" char="." charoff="50">0</td><td align="char" valign="top" char="." charoff="50">1</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Depth of invasion (mm)</td><td align="left" valign="top" charoff="50">&#x0003c;1</td><td align="char" valign="top" char="." charoff="50">4</td><td align="char" valign="top" char="." charoff="50">0</td><td align="char" valign="top" char="." charoff="50">4</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">1&#x02013;10</td><td align="char" valign="top" char="." charoff="50">12</td><td align="char" valign="top" char="." charoff="50">10</td><td align="char" valign="top" char="." charoff="50">22</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x0003e;10</td><td align="char" valign="top" char="." charoff="50">1</td><td align="char" valign="top" char="." charoff="50">3</td><td align="char" valign="top" char="." charoff="50">4</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">Not recorded</td><td align="char" valign="top" char="." charoff="50">1</td><td align="char" valign="top" char="." charoff="50">0</td><td align="char" valign="top" char="." charoff="50">1</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Associated benign vulval conditions</td><td align="left" valign="top" charoff="50">No lichen sclerosis or VIN</td><td align="char" valign="top" char="." charoff="50">5</td><td align="char" valign="top" char="." charoff="50">1</td><td align="char" valign="top" char="." charoff="50">6</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">Lichen sclerosis</td><td align="char" valign="top" char="." charoff="50">4</td><td align="char" valign="top" char="." charoff="50">11</td><td align="char" valign="top" char="." charoff="50">15</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">VIN</td><td align="char" valign="top" char="." charoff="50">8</td><td align="char" valign="top" char="." charoff="50">1</td><td align="char" valign="top" char="." charoff="50">9</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">Both lichen sclerosis and VIN</td><td align="char" valign="top" char="." charoff="50">1</td><td align="char" valign="top" char="." charoff="50">0</td><td align="char" valign="top" char="." charoff="50">1</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Recurrence</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">1</td><td align="char" valign="top" char="." charoff="50">8</td><td align="char" valign="top" char="." charoff="50">9</td></tr></tbody></table></table-wrap></floats-wrap></article>