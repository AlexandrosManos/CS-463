></name></person-group><article-title>Stump appendicitis: case report and review</article-title><source>Surg Laprosc Endosc Percutan Tech</source><year>2004</year><volume>14</volume><fpage>167</fpage><lpage>171</lpage><pub-id pub-id-type="pmid">15471026</pub-id><pub-id pub-id-type="doi">10.1097/01.sle.0000129392.75673.97</pub-id></element-citation></ref><ref id="bib-007"><element-citation publication-type="journal"><person-group><name><surname>Al-Dabbagh</surname><given-names>AK</given-names></name><name><surname>Thomas</surname><given-names>NB</given-names></name><name><surname>Habouibi</surname><given-names>N</given-names></name></person-group><article-title>Stunp appendicitis: a diagnostic dilemma</article-title><source>Tech Coloproctology</source><year>2009</year><volume>13</volume><fpage>73</fpage><lpage>74</lpage><pub-id pub-id-type="doi">10.1007/s10151-008-0419-5</pub-id></element-citation></ref><ref id="bib-008"><element-citation publication-type="journal"><person-group><name><surname>Truty</surname><given-names>MJ</given-names></name><name><surname>Stulak</surname><given-names>JM</given-names></name><name><surname>Utter</surname><given-names>PA</given-names></name><name><surname>Solberg</surname><given-names>JJ</given-names></name><name><surname>Degnim</surname><given-names>AC</given-names></name></person-group><article-title>Appendicitis after appendectomy</article-title><source>Arch Surg</source><year>2008</year><volume>143</volume><fpage>413</fpage><lpage>415</lpage><pub-id pub-id-type="pmid">18427031</pub-id><pub-id pub-id-type="doi">10.1001/archsurg.143.4.413</pub-id></element-citation></ref><ref id="bib-009"><element-citation publication-type="journal"><person-group><name><surname>Puylaert</surname><given-names>JB</given-names></name></person-group><article-title>Acute appendicitis: US evaluation using graded compression</article-title><source>Radiology</source><year>1986</year><volume>158</volume><fpage>355</fpage><lpage>360</lpage><pub-id pub-id-typ