ven-names></name></person-group><article-title>Salivary glands in ixodid ticks: control and mechanism of secretion</article-title><source>J Insect Physiol</source><year>2000</year><volume>46</volume><fpage>1069</fpage><lpage>1078</lpage><pub-id pub-id-type="pmid">10817833</pub-id><pub-id pub-id-type="doi">10.1016/S0022-1910(99)00210-3</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hoffmann</surname><given-names>A</given-names></name><name><surname>Walsmann</surname><given-names>P</given-names></name><name><surname>Riesener</surname><given-names>G</given-names></name><name><surname>Paintz</surname><given-names>M</given-names></name><name><surname>Markwardt</surname><given-names>F</given-names></name></person-group><article-title>Isolation and characterization of a thrombin inhibitor from the tick <italic>Ixodes ricinus</italic></article-title><source>Pharmazie</source><year>1991</year><volume>46</volume><fpage>209</fpage><lpage>212</lpage><pub-id pub-id-type="pmid">1881945</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nuttall</surname><given-names>PA</given-names></name></person-group><article-title>Pathogen-tick-host interactions: <italic>Borrelia burgdorferi </italic>and TBE virus</article-title><source>Zentralbl Bakteriol</source><year>1999</year><volume>289</volume><fpage>492</fpage><lpage>505</lpage><pub-id pub-id-type="pmid">10652716</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kahl</surname><given-names>O</given-names></name><name><surname>Janetzki-Mittmann</surname><given-names>C</given-names></name><name><surname>Gray</surname><given-names>JS</given-names></name><name><surname>Jonas</surname><given-names>R</given-names></name><name><surname>Stein</surname><given-names>J</given-names></name></person-group><article-