-title><source>J Immunol</source><year>1985</year><volume>135</volume><fpage>1900</fpage><lpage>1905</lpage><!--PubMed citation query: 'J Immunol||135|1900||bib5|'--><pub-id pub-id-type="pmid">3874908</pub-id></citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bessler</surname><given-names>WG</given-names></name><name><surname>Jung</surname><given-names>G</given-names></name></person-group><article-title>Synthetic lipopeptides as novel adjuvants</article-title><source>Res Immunol</source><year>1992</year><volume>143</volume><fpage>548</fpage><lpage>553</lpage><!--PubMed citation query: 'Res Immunol||143|548||bib6|'--><pub-id pub-id-type="pmid">1439136</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boeckler</surname><given-names>C</given-names></name><name><surname>Dautel</surname><given-names>D</given-names></name><name><surname>Schelte</surname><given-names>P</given-names></name><name><surname>Frisch</surname><given-names>B</given-names></name><name><surname>Wachsmann</surname><given-names>D</given-names></name><name><surname>Klein</surname><given-names>JP</given-names></name><name><surname>Schuber</surname><given-names>F</given-names></name></person-group><article-title>Design of highly immunogenic liposomal constructs combining structurally independent B cell and T helper cell peptide epitopes</article-title><source>Eur J Immunol</source><year>1999</year><volume>29</volume><fpage>2297</fpage><lpage>2308</lpage><!--PubMed citation query: 'Eur J Immunol||29|2297||bib7|'--><pub-id pub-id-type="pmid">10427993</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boeckler</surname><given-names>C</given-names></name><name><surname>Frisch</surname><given-names>B</given-names></name><name><surname>Schuber</surname><given-names>F</given-names></na