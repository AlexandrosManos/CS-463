off="50">12/3</td><td align="center" valign="top" charoff="50">0.712</td></tr><tr><td align="left" valign="top" charoff="50">pTNM stage (I/II/III/IV)</td><td align="center" valign="top" charoff="50">31/29/41/4</td><td align="center" valign="top" charoff="50">1/6/8/0</td><td align="center" valign="top" charoff="50">0.223</td></tr><tr><td align="left" valign="top" charoff="50">Resection margin R0/R1</td><td align="center" valign="top" charoff="50">88/15</td><td align="center" valign="top" charoff="50">11/4</td><td align="center" valign="top" charoff="50">0.235</td></tr><tr><td align="left" valign="top" charoff="50">Lymph node status (&#x02212;/&#x0002b;)</td><td align="center" valign="top" charoff="50">39/64</td><td align="center" valign="top" charoff="50">5/10</td><td align="center" valign="top" charoff="50">0.736</td></tr><tr><td align="left" valign="top" charoff="50">Positive to total lymph node ratio (0/&#x02a7d;0.2/&#x0003e;0.2)</td><td align="center" valign="top" charoff="50">39/35/29</td><td align="center" valign="top" charoff="50">5/6/4</td><td align="center" valign="top" charoff="50">0.891</td></tr><tr><td align="left" valign="top" charoff="50">Haemoglobin (&#x02a7e;12/&#x0003c;12&#x02009;g&#x02009;l<sup>&#x02212;1</sup>)</td><td align="center" valign="top" charoff="50">86/17</td><td align="center" valign="top" charoff="50">9/6</td><td align="center" valign="top" charoff="50">0.033</td></tr><tr><td align="left" valign="top" charoff="50">White cell count (&#x0003c;8.5/8.5&#x02013;11.0/&#x0003e;11.0 ( &#x000d7; 10<sup>9</sup>&#x02009;l<sup>&#x02212;1</sup>))</td><td align="center" valign="top" charoff="50">71/25/7</td><td align="center" valign="top" charoff="50">8/5/2</td><td align="center" valign="top" charoff="50">0.204</td></tr><tr><td align="left" valign="top" charoff="50">Lymphocyte percentage (20&#x02013;40/12&#x02013;19.9/0&#x02013;11.9&#x00025;)</td><td align="center" valign="top" charoff="50">90/11/2</td><td align="center" valign="top" charoff="50">7/6/2</td><td align="center" valign="top" charoff="50">&#x0003c;0.001</td></tr><tr><td align="left" valign="top" charoff="50">Platelets (&#x0003c;400/&#x02a7e;400 ( &#x000d7; 10<sup>9</sup>&#x02009;l<sup>&#x02212;1</sup>))</td><td align="center" valign="top" charoff="50">96/6</td><td align="center" valign="top" charoff="50">14/1</td><td align="center" valign="top" charoff="50">0.905</td></tr><tr><td align="left" valign="top" charoff="50">Albumin (&#x02a7e;35/&#x0003c;35&#x02009;g&#x02009;l<sup>&#x02212;1</sup>)</td><td align="center" valign="top" charoff="50">102/2</td><td align="center" valign="top" charoff="50">15/0</td><td align="center" valign="top" charoff="50">0.590</td></tr><tr><td align="left" valign="top" charoff="50">Survival (months)<sup>a</sup></td><td align="center" valign="top" charoff="50">79.2 (53.8&#x02013;104.6)</td><td align="center" valign="top" charoff="50">19.4 (15.3&#x02013;23.4)</td><td align="center" valign="top" charoff="50">&#x0003c;0.001</td></tr></tbody></table><table-wrap-foot><fn id="tbfnote2"><label/><p>CI=confidence interval.</p></fn><fn id="tbfnote3"><label>a</label><p>Median (95&#x00025; CI).</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>