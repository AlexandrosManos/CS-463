"author"><name><surname>Kamiyama</surname><given-names>M</given-names></name><name><surname>Ichikawa</surname><given-names>Y</given-names></name><name><surname>Ishikawa</surname><given-names>T</given-names></name><name><surname>Chishima</surname><given-names>T</given-names></name><name><surname>Hasegawa</surname><given-names>S</given-names></name><name><surname>Hamaguchi</surname><given-names>Y</given-names></name><name><surname>Nagashima</surname><given-names>Y</given-names></name><name><surname>Miyagi</surname><given-names>Y</given-names></name><name><surname>Mitsuhashi</surname><given-names>M</given-names></name><name><surname>Hyndman</surname><given-names>D</given-names></name><name><surname>Hoffman</surname><given-names>RM</given-names></name><name><surname>Ohki</surname><given-names>S</given-names></name><name><surname>Shimada</surname><given-names>H</given-names></name></person-group><article-title>VEGF receptor antisense therapy inhibits angiogenesis and peritoneal dissemination of human gastric cancer in nude mice</article-title><source>Cancer Gene Ther</source><year>2002</year><volume>9</volume><fpage>197</fpage><lpage>201</lpage><!--PubMed citation query: 'Cancer Gene Ther||9|197||bib18|'--><pub-id pub-id-type="pmid">11857038</pub-id></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Korbelik</surname><given-names>M</given-names></name></person-group><article-title>Induction of tumor immunity by photodynamic therapy</article-title><source>J Clin Laser Med Surg</source><year>1996</year><volume>14</volume><fpage>329</fpage><lpage>334</lpage><!--PubMed citation query: 'J Clin Laser Med Surg||14|329||bib19|'--><pub-id pub-id-type="pmid">9612200</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Korbelik</surname><given-names>M</given-names></name><name><surname>Cecic</surname><given-names>I</given-names></name></person-group><article-title>Contribution of myeloid and lymphoid host cells to the curative outcome of mouse sarcoma treatment by photodynamic therapy</article-title><source>Cancer Lett</source><year>1999</year><volume>137</volume><fpage>91</fpage><lpage>98</lpage><!--PubMed citation query: 'Cancer Lett||137|91||bib20|'--><pub-id pub-id-type="pmid">10376798</pub-id></citation></ref><ref id="bib21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Korbelik</surname><given-names>M</given-names></name><name><surname>Dougherty</surname><given-names>GJ</given-names></name></person-group><article-title>Photodynamic therapy-mediated immune response against subcutaneous mouse tumors</article-title><source>Cancer Res</source><year>1999</year><volume>59</volume><fpage>1941</fpage><lpage>1946</lpage><!--PubMed citation query: 'Cancer Res||59|1941||bib21|'--><pub-id pub-id-type="pmid">10213504</pub-id></citation></ref><ref id="bib22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Korbelik</surname><given-names>M</given-names></name><name><surname>Sun</surname><given-names>J</given-names></name><name><surname>Posakony</surname><given-names>JJ</given-names></name></person-group><article-title>Interaction between photodynamic therapy and BCG immunotherapy responsible for the reduced recurrence of treated mouse tumors</article-title><source>Photochem Photobiol</source><year>2001</year><volume>73</volume><fpage>403</fpage><lpage>409</lpage><!--PubMed citation query: 'Photochem Photobiol||73|403||bib22|'--><pub-id pub-id-type="pmid">11332036</pub-id></citation></ref><ref id="bib23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nelson</surname><given-names>DJ</given-names></name><name><surname>Mukherjee</surname><given-names>S</given-names></name><name><surname>Bundell</surname><given-names>C</given-names></name><name><surname>Fisher</surname><given-names>S