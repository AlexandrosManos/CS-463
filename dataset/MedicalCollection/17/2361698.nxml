><person-group person-group-type="author"><name><surname>Kuhnen</surname><given-names>C</given-names></name><name><surname>Muehlberger</surname><given-names>T</given-names></name><name><surname>Honsel</surname><given-names>M</given-names></name><name><surname>Tolnay</surname><given-names>E</given-names></name><name><surname>Steinau</surname><given-names>HU</given-names></name><name><surname>Muller</surname><given-names>KM</given-names></name></person-group><article-title>Impact of c-Met expression on angiogenesis in soft tissue sarcomas: correlation to microvessel-density</article-title><source>J Cancer Res Clin Oncol</source><year>2003</year><volume>129</volume><fpage>415</fpage><lpage>422</lpage><!--PubMed citation query: 'J Cancer Res Clin Oncol||129|415||bib26|'--><pub-id pub-id-type="pmid">14605882</pub-id></citation></ref><ref id="bib27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>CH</given-names></name><name><surname>Bang</surname><given-names>SH</given-names></name><name><surname>Lee</surname><given-names>SK</given-names></name><name><surname>Song</surname><given-names>KY</given-names></name><name><surname>Lee</surname><given-names>IC</given-names></name></person-group><article-title>Gene expression profiling reveals sequential changes in gastric tubular adenoma and carcinoma <italic>in situ</italic></article-title><source>World J Gastroenterol</source><year>2005a</year><volume>11</volume><fpage>1937</fpage><lpage>1945</lpage><!--PubMed citation query: 'World J Gastroenterol||11|1937||bib27|'--><pub-id pub-id-type="pmid">15800983</pub-id></citation></ref><ref id="bib28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>J</given-names></name><name><surname>Hever</surname><given-names>A</given-names></name><name><surname>Willhite</surname><given-names>D</given-names></name><name><surname>Zlotnik</surname><given-names>A</give