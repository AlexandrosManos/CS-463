le-title>Preclinical experimental therapeutic approaches in soft tissue sarcoma</article-title><source>Semin Surg Oncol</source><year>1999</year><volume>17</volume><fpage>78</fpage><lpage>82</lpage><!--PubMed citation query: 'Semin Surg Oncol||17|78||bib9|'--><pub-id pub-id-type="pmid">10402641</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jones</surname><given-names>HJ</given-names></name><name><surname>Vernon</surname><given-names>DI</given-names></name><name><surname>Brown</surname><given-names>SB</given-names></name></person-group><article-title>Photodynamic therapy effect of m-THPC (Foscan) <italic>in vivo</italic>: correlation with pharmacokinetics</article-title><source>Br J Cancer</source><year>2003</year><volume>89</volume><fpage>398</fpage><lpage>404</lpage><!--PubMed citation query: 'Br J Cancer||89|398||bib10|'--><pub-id pub-id-type="pmid">12865935</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kloeckner</surname><given-names>J</given-names></name><name><surname>Prasmickaite</surname><given-names>L</given-names></name><name><surname>Hogset</surname><given-names>A</given-names></name><name><surname>Berg</surname><given-names>K</given-names></name><name><surname>Wagner</surname><given-names>E</given-names></name></person-group><article-title>Photochemically enhanced gene delivery of EGF receptor-targeted DNA polyplexes</article-title><source>J Drug Target</source><year>2004</year><volume>12</volume><fpage>205</fpage><lpage>213</lpage><!--PubMed citation query: 'J Drug Target||12|205||bib11|'--><pub-id pub-id-type="pmid">15506169</pub-id></citation></ref><ref id="bib12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lieberman</surname><given-names>MW</given-names></name><name><surname>Lebovitz</surname><given-names>RM</given-names></name></person-group><article-title>Neoplasia</article-title><source>Anderson's Pathology</source><year>1990</year><publisher-name>Mosby-Year Book, Inc.: St Louis, Missouri</publisher-name><fpage>513</fpage><lpage>547</lpage>Damjanov I, Linder I (eds) pp</citation></ref><ref id="bib13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Moan</surname><given-names>J</given-names></name><name><surname>Berg</surname><given-names>K</given-names></name><name><surname>Iani</surname><given-names>V</given-names></name></person-group><article-title>Action spectra of dyes relevant for photodynamic therapy</article-title><source>Photodynamic tumor therapy</source><year>1998</year><publisher-name>London: Harwood</publisher-name><fpage>169</fpage><lpage>181</lpage>Moser JG (ed) pp</citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Peng</surname><given-names>Q</given-names></name><name><surname>Moan</surname><given-names>J</given-names></name></person-group><article-title>Correlation of distribution of sulphonated aluminium phthalocyanines with their photodynamic effect in tumour and skin of mice bearing CaD2 mammary carcinoma</article-title><source>Br J Cancer</source><year>1995</year><volume>72</volume><fpage>565</fpage><lpage>574</lpage><!--PubMed citation query: 'Br J Cancer||72|565||bib14|'--><pub-id pub-id-type="pmid">7669563</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Peng</surname><given-names>Q</given-names></name><name><surname>Moan</surname><given-names>J</given-names></name><name><surname>Farrants</surname><given-names>G</given-names></name><name><surname>Danielsen</surname><given-names>HE</given-names></name><name><surname>Rimington</surname><given-names>C</given-names></name></person-group><article-title>Localization of potent photosensitizers in human tumor LOX by means of laser scanning microscopy</article-title><source>Cancer Lett</source><year>1991a</year><volume>58</volume><fpage>17</fpage><lpage>27</lpage><!--PubMed citation query: 'Cancer Lett||58|17||bib15|'--><pub-id pub-id-type="pmid">1828711</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Peng</surname><given-names>Q</given-names></name><name><surname>Moan</surname><given-names>J</given-names></name><name><surname>Kongshaug</surname><given-names>M</given-names></name><name><surname>Evensen</surname><given-names>JF</given-names></name><name><surname>Anholt</surname><given-names>H</given-names></name><name><surname>Rimington</surname><given-names>C</given-names></name></person-group><article-title>Sensitizer for photodynamic therapy of cancer: a comparison of the tissue distribution of Photofrin II and aluminum phthalocyanine tetrasulfonate in nude mice bearing a human malignant tumor</article-title><source>Int J Cancer</source><year>1991b</year><volume>48</volume><fpage>258</fpage><lpage>264</lpage><!--PubMed citation query: 'Int J Cancer||48|258||bib16|'--><pub-id pub-id-type="pmid">1826901</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Prasmickaite</surname><given-names>L</given-names></name><name><surname>Hogset</surname><given-names>A</given-names></name><name><surname>Berg</surname><given-names>K</given-names></name></person-group><article-title>Photochemical transfection. Light-induced, site-directed gene delivery</article-title><source>Methods Mol Med</source><year>2002</year><volume>69</volume><fpage>123</fpage><lpage>135</lpage><!--PubMed citation query: 'Methods Mol Med||69|123||bib17|'--><pub-id pub-id-type="pmid">11987772</pub-id></citation></ref><ref id="bib18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Selbo</surname><given-names>PK</given-names></name><name><surname>Hogset</surname><given-names>A</given-names></name><name><surname>Prasmickaite</surname><given-names>L</given-names></name><name><surname>Berg</surname><given-names>K</given-names></name></person-group><article-title>Photochemical internalisation: a novel drug delivery system</article-title><source>Tumour Biol</source><year>2002</year><volume>23</volume><fpage>103</fpage><lpage>112</lpage><!--PubMed citation query: 'Tumour Biol||23|103||bib18|'--><pub-id pub-id-type="pmid">12065848</pub-id></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Selbo</surname><given-names>PK</given-names></name><name><surname>Sivam</surname><given-names>G</given-names></name><name><surname>Fodstad</surname><given-names>O</given-names></name><name><surname>Sandvig</surname><given-names>K</given-names></name><name><surname>Berg</surname><given-names>K</given-names></name></person-group><article-title>Photochemical internalisation increases the cytotoxic effect of the immunotoxin MOC31-gelonin</article-title><source>Int J Cancer</source><year>2000</year><volume>87</volume><fpage>853</fpage><lpage>859</lpage><!--PubMed citation query: 'Int J Cancer||87|853||bib19|'--><pub-id pub-id-type="pmid">10956397</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Selbo</surname><given-names>PK</given-names></name><name><surname>Sivam</surname><given-names>G</given-names></name><name><surname>Fodstad</surname><given-names>O</given-names></name><name><surname>Sandvig</surname><given-names>K</given-names></name><name><surname>Berg</surname><given-names>K</given-names></name></person-group><article-title><italic>In vivo</italic> documentation of photochemical internalization, a novel approach to site specific cancer therapy</article-title><source>Int J Cancer</source><year>2001</year><volume>92</volume><fpage>761</fpage><lpage>766</lpage><!--PubMed citation query: 'Int J Cancer||92|761||bib20|'--><pub-id pub-id-type="pmid">11340584</pub-id></citation></ref></ref-list></back><floats-wrap><fig id="fig1"><label>Figure 1</label><caption><p>Time-dependent concentration of AlPcS<sub>2a</sub> in serum and tumour after i.p. injection of 10&#x02009;mg&#x02009;kg<sup>&#x02212;1</sup>. Regression lines are used to describe the decay of AlPcS<sub>2a</sub> levels from 48&#x02009;h after administration. Plots are the mean values of 3&#x02013;5 animals for each time point. Bars, s.d.</p></caption><graphic xmlns:xlink="http://www.w3.org/1999/xlink" mime-subtype="gif" xlink:href="92-6602600f1"/></fig><fig id="fig2"><label>Figure 2</label><caption><p>Distribution of AlPcS<sub>2a</sub> in tumours after i.p. injection of 10&#x02009;mg&#x02009;kg<sup>&#x02212;1</sup> AlPcS<sub>2a</sub>. Upper photos (fluorescence and H&#x00026;E staining): 6&#x02009;h after injection, AlPcS<sub>2a</sub> is mainly in the tumour vasculature. Lower photos (fluorescence and H&#x00026;E staining): 48&#x02009;h after injection, AlPcS<sub>2a</sub> is mainly intracellular.</p></caption><graphic xmlns:xlink="http://www.w3.org/1999/xlink" mime-subtype="jpeg" xlink:href="92-6602600f2"/></fig><fig id="fig3"><label>Figure 3</label><caption><p>Macroscopic fluorescence 48&#x02009;h after i.p. injection of 10&#x02009;mg&#x02009;kg<sup>&#x02212;1</sup> AlPcS<sub>2a</sub>. High fluorescence intensity is red and low intensity is blue. High intensity was detected in the tumour region and in the liver.</p></caption><graphic xmlns:xlink="http://www.w3.org/1999/xlink" mime-subtype="jpeg" xlink:href="92-6602600f3"/></fig><fig id="fig4"><label>Figure 4</label><caption><p>(<bold>A</bold>) Western blot showing level of gelonin in tumour at times from 10&#x02009;min to 48&#x02009;h after direct i.t. injection of 50&#x02009;<italic>&#x003bc;</italic>g. The blot shows also an MW standard of 30&#x02009;kDa as well as pure native gelonin as control (ctrl) and tumour extract from untreated tissue (no Gel). (<bold>B</bold>) The PVDF membrane was stained with Ponceu S solution to verify even loading.</p></caption><graphic xmlns:xlink="http://www.w3.org/1999/xlink" mime-subtype="jpeg" xlink:href="92-6602600f4"/></fig><fig id="fig5"><label>Figure 5</label><caption><p>Tumour growth after treatment (Kaplan&#x02013;Meier plot). The five groups treated were: group 1: PCI, group 2: PDT, group 3: no treatment, group 4: AlPcS<sub>2a</sub>&#x0002b;gelonin (no light), group 5: gelonin&#x0002b;light (no AlPcS<sub>2a</sub>). Animals were killed when the tumour volume reached 1000&#x02009;mm<sup>3</sup>.</p></caption><graphic xmlns:xlink="http://www.w3.org/1999/xlink" mime-subtype="gif" xlink:href="92-6602600f5"/></fig><fig id="fig6"><label>Figure 6</label><caption><p>Photomicrographs of tumours 4 days after treatment. Areas of complete necrosis were clearly demarcated from adjacent viable tissue (arrows). (<bold>A</bold>) Tumour treated with PCI. (<bold>B</bold>) tumour treated with PDT.</p></caption><graphic xmlns:xlink="http://www.w3.org/1999/xlink" mime-subtype="jpeg" xlink:href="92-6602600f6"/></fig></floats-wrap></article>