 investigation.</article-title><source>N Engl J Med</source>. <year>1991</year>;<volume>324</volume>:<fpage>205</fpage>&#x02013;<lpage>11</lpage> <pub-id pub-id-type="doi">10.1056/NEJM199101243240401</pub-id><pub-id pub-id-type="pmid">1985241</pub-id></mixed-citation></ref><ref id="R6"><label>6. </label><mixed-citation publication-type="journal"><string-name><surname>de Mattos</surname> <given-names>CA</given-names></string-name>, <string-name><surname>Favi</surname> <given-names>M</given-names></string-name>, <string-name><surname>Yung</surname> <given-names>V</given-names></string-name>, <string-name><surname>Pavletic</surname> <given-names>C</given-names></string-name>, <string-name><surname>de Mattos</surname> <given-names>CC</given-names></string-name> <article-title>Bat rabies in urban centers in Chile.</article-title><source>J Wildl Dis</source>. <year>2000</year>;<volume>36</volume>:<fpage>231</fpage>&#x02013;<lpage>40</lpage><pub-id pub-id-type="pmid">10813604</pub-id></mixed-citation></ref><ref id="R7"><label>7. </label><mixed-citation publication-type="journal"><string-name><surname>Tordo</surname> <given-names>N</given-names></string-name>, <string-name><surname>Poch</surname> <given-names>O</given-names></string-name>, <string-name><surname>Ermine</surname> <given-names>A</given-names></string-name>, <string-name><surname>Keith</surname> <given-names>G</given-names></string-name> <article-title>Primary structure of leader RNA and nucleoprotein genes of the rabies genome: segmented homology with VSV.</article-title><source>Nucleic Acids Res</source>. <year>1986</year>;<volume>14</volume>:<fpage>2671</fpage>&#x02013;<lpage>3</lpage> <pub-id pub-id-type="doi">10.1093/nar/14.6.2671</pub-id><pub-id pub-id-type="pmid">3008096</pub-id></mixed-citation></ref><ref id="R8"><label>8. </label><mixed-citation publication-type="journal"><string-name><surname>Kissi</surname> <given-names>B</given-names></string-name>, <string-name><surname>Tordo</surname> <given-names