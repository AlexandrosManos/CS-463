an="1" colspan="1">39</td><td align="left" valign="top" rowspan="1" colspan="1">BFC, 320/9 B, 400 F, 9 PLB</td><td align="left" valign="top" rowspan="1" colspan="1">Turbuhaler</td><td align="left" valign="top" rowspan="1" colspan="1">Time to first AECOPD<break/>Change in FEV<sub>1</sub></td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Tashkin et al<xref ref-type="bibr" rid="b34-copd-5-357">34</xref></td><td align="left" valign="top" rowspan="1" colspan="1">1,704</td><td align="left" valign="top" rowspan="1" colspan="1">6</td><td align="left" valign="top" rowspan="1" colspan="1">63</td><td align="left" valign="top" rowspan="1" colspan="1">1 L (40%)</td><td align="left" valign="top" rowspan="1" colspan="1">40</td><td align="left" valign="top" rowspan="1" colspan="1">BFC, 320/9 BFC, 160/9 B, 320 + F, 9 B, 320 F, 9 PLB</td><td align="left" valign="top" rowspan="1" colspan="1">pMDI</td><td align="left" valign="top" rowspan="1" colspan="1">Predose FEV<sub>1</sub><break/>1 h postdose FEV<sub>1</sub></td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Rennard et al<xref ref-type="bibr" rid="b33-copd-5-357">33</xref></td><td align="left" valign="top" rowspan="1" colspan="1">1,964</td><td align="left" valign="top" rowspan="1" colspan="1">12</td><td align="left" valign="top" rowspan="1" colspan="1">63</td><td align="left" valign="top" rowspan="1" colspan="1">1 L (39%)</td><td align="left" valign="top" rowspan="1" colspan="1">40</td><td align="left" valign="top" rowspan="1" colspan="1">BFC, 320/9 BFC, 160/9 F, 9 PLB</td><td align="left" valign="top" rowspan="1" colspan="1">pMDI</td><td align="left" valign="top" rowspan="1" colspan="1">Predose FEV<sub>1</sub><break/>1 h postdose FEV<sub>1</sub></td></tr></tbody></table><table-wrap-foot><fn id="tfn2-copd-5-357"><p><bold>Abbreviations:</bold> pMDI, pressurized metered dose inhaler; BFC, combination of budesonide and formoterol; B, budesonide; F, formoterol; PLB, placebo; FEV<sub>1</sub>, forced exp