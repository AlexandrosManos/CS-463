ame><surname>Carrillo</surname><given-names>EH</given-names></name><name><surname>Spain</surname><given-names>DA</given-names></name><name><surname>Miller</surname><given-names>FB</given-names></name><etal/></person-group><article-title>Evolution in the management of hepatic trauma: a 25-year perspective</article-title><source>Ann Surg</source><year>2000</year><volume>232</volume><fpage>324</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">10973382</pub-id></element-citation></ref><ref id="CIT7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Polychronidis</surname><given-names>A</given-names></name><name><surname>Bounovas</surname><given-names>A</given-names></name><name><surname>Didilis</surname><given-names>B</given-names></name><name><surname>Perente</surname><given-names>S</given-names></name><name><surname>Simopoulos</surname><given-names>C</given-names></name></person-group><article-title>Intraperitoneal air in the diagnosis of blunt diaphragmatic rupture</article-title><source>J Cardiovasc Surg (Torino)</source><year>2001</year><volume>42</volume><fpage>845</fpage><lpage>7</lpage></element-citation></ref><ref id="CIT8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ferrera</surname><given-names>PC</given-names></name><name><surname>Chan</surname><given-names>L</given-names></name></person-group><article-title>Tension pneumoperitoneum caused by blunt trauma</article-title><source>Am J Emerg Med</source><year>1999</year><volume>17</volume><fpage>351</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">10452431</pub-id></element-citation></ref><ref id="CIT9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Shiomi</surname><given-names>H</given-names></name><name><surname>Hase</surname><given-names>T</given-names></name><name><surname>Matsuno</surname><given-na