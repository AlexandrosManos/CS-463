names></name><name><surname>Le Gall</surname><given-names>D</given-names></name><name><surname>Emile</surname><given-names>J</given-names></name><article-title>Cognitive functions in chronic locked-in syndrome: a report of two cases</article-title><source>Cortex</source><year>1998</year><volume>34</volume><fpage>629</fpage><lpage>634</lpage><pub-id pub-id-type="pmid">9800096</pub-id></element-citation></ref><ref id="R26"><label>26.</label><element-citation publication-type="journal"><name><surname>Bauer</surname><given-names>G</given-names></name><name><surname>Gerstenbrand</surname><given-names>F</given-names></name><name><surname>Rumpi</surname><given-names>E</given-names></name><article-title>Varieties of Locked-in Syndrome</article-title><source>J neurol</source><year>1979</year><volume>221</volume><fpage>77</fpage><lpage>91</lpage><pub-id pub-id-type="pmid">92545</pub-id></element-citation></ref><ref id="R27"><label>27.</label><element-citation publication-type="journal"><name><surname>Virgile</surname><given-names>RS</given-names></name><article-title>Locked-in Syndrome</article-title><source>Clin Neurol Neurosary</source><year>1984</year><volume>86</volume><fpage>275</fpage><lpage>279</lpage></element-citation></ref><ref id="R28"><label>28.</label><element-citation publication-type="journal"><name><surname>Wu</surname><given-names>Y</given-names></name><name><surname>Voda</surname><given-names>JA</given-names></name><article-title>User &#x02013;friendly Communication board for non-verbal, severely physically, disabled individuals</article-title><source>Arch Phys Med Rehabil</source><year>1985</year><volume>66</volume><fpage>82</fpage><lpage>8</lpage></element-citation></ref><ref id="R29"><label>29.</label><element-citation publication-type="journal"><name><surname>Goodin</surname><given-names>DS</given-names></name><etal/><article-title>Disease modifying therapies in multiple sclerosis: clinical guidelines</article-title><source>Neurology</source><year>2002</year><volume>58</volume><fpage>169</fpage><pub-id pub-id-type="pmid">11805241</pub-id></element-citation></ref><ref id="R30"><label>30.</label><element-citation publication-type="journal"><name><surname>Rolak</surname><given-names>LA</given-names></name><article-title>New Prophylactic treatment for multiple sclerosis</article-title><source>Drugs Today</source><year>1997</year><volume>33</volume><fpage>175</fpage><lpage>182</lpage></element-citation></ref><ref id="R31"><label>31.</label><element-citation publication-type="book"><name><surname>Rolak</surname><given-names>LA</given-names></name><article-title>Fatigue and Multiple sclerosis</article-title><name><surname>Dawson</surname><given-names>DM</given-names></name><name><surname>Stabin</surname><given-names>TD</given-names></name><source>Chronic fatigue syndrome</source><publisher-name>Little Brown</publisher-name><publisher-loc>Boston</publisher-loc><year>1993</year><fpage>153</fpage><lpage>61</lpage></element-citation></ref><ref id="R32"><label>32.</label><element-citation publication-type="journal"><name><surname>Fishburn</surname><given-names>KN</given-names></name><name><surname>Marino</surname><given-names>RJ</given-names></name><name><surname>Dtunno</surname><given-names>JF</given-names></name><article-title>Atelectasis and pneumonia in acute spinal cord injury</article-title><source>Arch Phys Med Rehabil</source><year>1990</year><volume>71</volume><fpage>197</fpage><lpage>200</lpage><pub-id pub-id-type="pmid">2317137</pub-id></element-citation></ref><ref id="R33"><label>33.</label><element-citation publication-type="book"><name><surname>Goldman</surname><given-names>L</given-names></name><name><surname>Ausiello</surname><given-names>P</given-names></name><source>Cecil Medicine</source><edition>23rd ed</edition><publisher-name>Elseviers-Saunders</publisher-name><publisher-loc>USA</publisher-loc><year>2008</year><fpage>2694</fpage><lpage>95</lpage></element-citation></ref></ref-list></back></article>