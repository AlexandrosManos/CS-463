.</label><element-citation publication-type="journal"><name><surname>Palterson</surname><given-names>JR</given-names></name><name><surname>Grabois</surname><given-names>M</given-names></name><article-title>Locked-in Syndrome: a review of 139 cases</article-title><source>Stroke</source><year>1986</year><volume>17</volume><fpage>758</fpage><lpage>764</lpage><pub-id pub-id-type="pmid">3738962</pub-id></element-citation></ref><ref id="R06"><label>6.</label><element-citation publication-type="book"><name><surname>Simon</surname><given-names>RP</given-names></name><name><surname>Aminoff</surname><given-names>MJ</given-names></name><name><surname>Greenberg</surname><given-names>DA</given-names></name><source>Clinical Neurology</source><edition>4th edn</edition><publisher-name>Lange Medical Books</publisher-name><publisher-loc>New York</publisher-loc><year>1997</year><fpage>325</fpage></element-citation></ref><ref id="R07"><label>7.</label><element-citation publication-type="book"><name><surname>Adam</surname><given-names>RD</given-names></name><name><surname>Victor</surname><given-names>M</given-names></name><source>Principles of Neurology</source><edition>4th ed</edition><publisher-name>McGraw-Hill Information Services</publisher-name><publisher-loc>New York</publisher-loc><year>1989</year><fpage>416</fpage><fpage>637</fpage><fpage>861</fpage></element-citation></ref><ref id="R08"><label>8.</label><element-citation publication-type="book"><name><surname>Mumenthaler</surname><given-names>M</given-names></name><source>Neurology</source><publisher-name>3rd Thieme</publisher-name><publisher-loc>Stuttgart</publisher-loc><year>1990</year><fpage>89</fpage><lpage>90</lpage></element-citation></ref><ref id="R09"><label>9.</label><element-citation publication-type="book"><name><surname>Mumemthaler</surname><given-names>M</given-names></name><source>Neurologic differential Diagnosis</source><publisher-name>Thieme Stuttgart</publisher-name><publisher-loc>New York</publisher-loc><year>1985</year><fpage>48</fpage></element-citation></ref><ref id="R10"><label>10.</label><element-citation publication-type="book"><name><surname>Bowsher</surname><given-names>D</given-names></name><source>Neurological emergencies in medical practice: a handbook for the non &#x02013; specialists</source><publisher-name>Crom Helm</publisher-name><publisher-loc>London</publisher-loc><year>1988</year><fpage>1</fpage><lpage>14</lpage></element-citation></ref><ref id="R11"><label>11.</label><element-citation publication-type="book"><name><surname>Duus</surname><given-names>P</given-names></name><source>Tropical Diagnosis in Neurology</source><publisher-name>Thieme Stuttgart</publisher-name><publisher-loc>New York</publisher-loc><year>1989</year></element-citation></ref><ref id="R12"><label>12.</label><element-citation publication-type="book"><name><surname>Pattern</surname><given-names>J</given-names></name><source>Neurologic differential Diagnosis</source><publisher-name>Harold Starke Ltd</publisher-name><publisher-loc>London</publisher-loc><year>1980</year><fpage>115</fpage></element-citation></ref><ref id="R13"><label>13.</label><element-citation publication-type="book"><name><surname>Spillane</surname><given-names>JD</given-names></name><name><surname>Spillane</surname><given-names>JA</given-names></name><source>An Atlas of Clinical Neurology</source><edition>3rd edn</edition><publisher-name>Oxford University Press</publisher-name><publisher-loc>London</publisher-loc><year>1982</year><fpage>398</fpage></element-citation></ref><ref id="R14"><label>14.</label><element-citation publication-type="book"><name><surname>Aminoff</surname><given-names>MJ</given-names></name><article-title>Locked-in Syndrome (de &#x02013; efferented state)</article-title><name><surname>Tierney</surname><given-names>LM</given-names></name><name><surname>Mcphee</surname><given-names>SJ</given-names></name><name><surname>Papadakis</surname><given-names>MA</given-names></name><source>Current Medical 