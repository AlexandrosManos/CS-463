"><name><surname>Wang</surname><given-names>YL</given-names></name><name><surname>Yang</surname><given-names>TS</given-names></name><name><surname>Chang</surname><given-names>SP</given-names></name><name><surname>Ng</surname><given-names>HT</given-names></name></person-group><article-title>Heterotopic pregnancy after GIFT managed with expectancy: A case report</article-title><source>Chin Med J (Taipei)</source><year>1996</year><volume>58</volume><fpage>218</fpage><lpage>22</lpage></element-citation></ref><ref id="CIT14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sentilhes</surname><given-names>L</given-names></name><name><surname>Bouet</surname><given-names>PE</given-names></name><name><surname>Gromez</surname><given-names>A</given-names></name><name><surname>Poilblanc</surname><given-names>M</given-names></name><name><surname>Lefebvre-Lacoeuille</surname><given-names>C</given-names></name><name><surname>Descamps</surname><given-names>P</given-names></name></person-group><article-title>Successful expectant management for a cornual heterotopic pregnancy</article-title><source>Fertil Steril</source><year>2009</year><volume>91</volume><fpage>934.e11</fpage><lpage>3</lpage></element-citation></ref><ref id="CIT15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Verma</surname><given-names>U</given-names></name><name><surname>Goharkhay</surname><given-names>N</given-names></name></person-group><article-title>Conservative management of cervical ectopic pregnancy</article-title><source>Fertil Steril</source><year>2009</year><volume>91</volume><fpage>671</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">18339381</pub-id></element-citation></ref><ref id="CIT16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kirk</surname><given-names>E</given-names></name><name><s