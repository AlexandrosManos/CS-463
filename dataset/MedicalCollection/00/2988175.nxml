ar><volume>374</volume><fpage>668</fpage><lpage>70</lpage><pub-id pub-id-type="pmid">19716946</pub-id></element-citation></ref><ref id="CIT17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lung Health Study Research</surname><given-names>Group</given-names></name></person-group><article-title>Effect of inhaled triamcinolone on the decline in pulmonary function in chronic obstructive pulmonary disease</article-title><source>N Engl J Med</source><year>2000</year><volume>343</volume><fpage>1902</fpage><lpage>29</lpage><pub-id pub-id-type="pmid">11136260</pub-id></element-citation></ref><ref id="CIT18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Novak</surname><given-names>B</given-names></name></person-group><article-title>The role of corticosteroids in acute exacerbations of chronic obstructive pulmonary disease</article-title><source>Crit Care Nurse</source><year>2002</year><volume>22</volume><fpage>80</fpage><lpage>1</lpage><pub-id pub-id-type="pmid">12382621</pub-id></element-citation></ref><ref id="CIT19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Yang</surname><given-names>IA</given-names></name><name><surname>Fong</surname><given-names>K</given-names></name><name><surname>Sim</surname><given-names>EH</given-names></name><name><surname>Black</surname><given-names>PN</given-names></name><name><surname>Lasserson</surname><given-names>TJ</given-names></name></person-group><article-title>Inhaled corticosteroids for stable chronic obstructive pulmonary disease</article-title><source>Cochrane Database System Rev</source><year>2007</year><volume>2</volume><fpage>CD002991</fpage><pub-id pub-id-type="pmid">17443520</pub-id></element-citation></ref><ref id="CIT20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gartlehner</surname><given-names>G</given-names></name><name><surname>Hansen</surname><given-names>RA</given-names></name><name><surname>Carson</surname><given-names>SS</given-names></name><name><surname>Lohr</surname><given-names>KN</given-names></name></person-group><article-title>Efficacy and safety of inhaled corticosteroids in patients with COPD: A systematic review and meta-analysis of health outcomes</article-title><source><italic>Ann Fam Med</italic></source><year>2006</year><volume>4</volume><fpage>253</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">16735528</pub-id></element-citation></ref><ref id="CIT21"><label>21</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mitchell</surname><given-names>CE</given-names></name><name><surname>Alpers</surname><given-names>JH</given-names></name><name><surname>Morton</surname><given-names>SM</given-names></name><name><surname>Baggoley</surname><given-names>CJ</given-names></name><name><surname>Croker</surname><given-names>WD</given-names></name><name><surname>Walsh</surname><given-names>AJ</given-names></name><etal/></person-group><article-title>Comparison of nebulized budesonide with oral prednisolone in the treatment of severe acute asthma</article-title><source>Eur Respir J</source><year>1995</year><volume>8</volume><fpage>S490</fpage></element-citation></ref><ref id="CIT22"><label>22</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Matthews</surname><given-names>EE</given-names></name><name><surname>Curtis</surname><given-names>PD</given-names></name><name><surname>McLain</surname><given-names>BI</given-names></name><name><surname>Morris</surname><given-names>LS</given-names></name><name><surname>Turbitt</surname><given-names>ML</given-names></name></person-group><article-title>Nebulized budesonide versus oral steroid in severe exacerbations of childhood asthma</article-ti