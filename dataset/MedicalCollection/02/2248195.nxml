group-type="author"><name><surname>Jones</surname><given-names>JE</given-names></name><name><surname>Antoniadis</surname><given-names>E</given-names></name><name><surname>Shettleworth</surname><given-names>SJ</given-names></name><name><surname>Kamil</surname><given-names>AC</given-names></name></person-group><article-title>A comparative study of geometric rule learning by nutcrackers: (Nucifraga columbiana), pigeons (Columba livia), and jackdaws (Corvus monedula)</article-title><source>Journal of Comparative Psychology</source><year>2002</year><volume>116</volume><fpage>350</fpage><lpage>356</lpage><pub-id pub-id-type="pmid">12539930</pub-id><pub-id pub-id-type="doi">10.1037/0735-7036.116.4.350</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kutsukake</surname><given-names>N</given-names></name><name><surname>Nunn</surname><given-names>CL</given-names></name></person-group><article-title>Comparative tests of reproductive skew in male primates: the roles of demographic factors and incomplete control</article-title><source>Behavioral Ecology and Sociobiology</source><year>2006</year><volume>60</volume><fpage>695</fpage><lpage>706</lpage><pub-id pub-id-type="doi">10.1007/s00265-006-0213-1</pub-id></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Trivers</surname><given-names>RL</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Campbell B</surname></name></person-group><article-title>Parental investment and sexual selection</article-title><source>Sexual Selection and the Descent of Man</source><year>1972</year><publisher-name>Chicago , Aldine Press</publisher-name><fpage>136&#x02013;179</fpage></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Manning</surname><given-names>JT</given-names></name></person-group><article-title>Males and the Advantage of Sex</article-title><source>Journal of Theoretical Biology</source><year>1984</year><volume>108</volume><fpage>215</fpage><lpage>220</lpage><pub-id pub-id-type="pmid">6748688</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Atmar</surname><given-names>W</given-names></name></person-group><article-title>On the Role of Males</article-title><source>Animal Behaviour</source><year>1991</year><volume>41</volume><fpage>195</fpage><lpage>205</lpage><pub-id pub-id-type="doi">10.1016/S0003-3472(05)80471-3</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Siller</surname><given-names>S</given-names></name></person-group><article-title>Sexual selection and the maintenance of sex</article-title><source>Nature</source><year>2001</year><volume>411</volume><fpage>689</fpage><lpage>692</lpage><pub-id pub-id-type="pmid">11395770</pub-id><pub-id pub-id-type="doi">10.1038/35079578</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Agrawal</surname><given-names>AF</given-names></name></person-group><article-title>Sexual selection and the maintenance of sexual reproduction</article-title><source>Nature</source><year>2001</year><volume>411</volume><fpage>692</fpage><lpage>695</lpage><pub-id pub-id-type="pmid">11395771</pub-id><pub-id pub-id-type="doi">10.1038/35079590</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lorch</surname><given-names>PD</given-names></name><name><surname>Proulx</surname><given-names>S</given-names></name><name><surname>Rowe</surname><given-names>L</given-names></name><name><surname>Day</surname><given-names>T</given-names></name></person-group><article-title>Condition-dependent sexual selection can accelerate adapt