><lpage>118</lpage><pub-id pub-id-type="pmid">9770268</pub-id></citation></ref><ref id="pone.0001731-Davis2"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Davis</surname><given-names>T</given-names></name><name><surname>Kirk</surname><given-names>D</given-names></name><name><surname>Rinaldi</surname><given-names>A</given-names></name><name><surname>Burdon</surname><given-names>RH</given-names></name><name><surname>Adams</surname><given-names>RL</given-names></name></person-group><year>1985</year><article-title>Delayed methylation and the matrix bound DNA methylase.</article-title><source>Biochem Biophys Res Commun</source><volume>126</volume><fpage>678</fpage><lpage>684</lpage><pub-id pub-id-type="pmid">2579643</pub-id></citation></ref><ref id="pone.0001731-Jelinic1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jelinic</surname><given-names>P</given-names></name><name><surname>Shaw</surname><given-names>P</given-names></name></person-group><year>2006</year><article-title>Loss of imprinting and cancer.</article-title><source>J Pathol</source></citation></ref><ref id="pone.0001731-Davis3"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Davis</surname><given-names>CD</given-names></name><name><surname>Uthus</surname><given-names>EO</given-names></name></person-group><year>2004</year><article-title>DNA methylation, cancer susceptibility, and nutrient interactions.</article-title><source>Exp Biol Med (Maywood)</source><volume>229</volume><fpage>988</fpage><lpage>995</lpage><pub-id pub-id-type="pmid">15522834</pub-id></citation></ref><ref id="pone.0001731-Waterland1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Waterland</surname><given-names>RA</given-names></name><name><surname>Michels</surname><given-names>KB</given-names></name></person-group><year>2007</year><article-title>Epigenetic Epidemiology of the Developmental Origins Hypothesis.</article-title><source>Annu Rev Nutr</source></citation></ref><ref id="pone.0001731-Nair1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nair</surname><given-names>V</given-names></name></person-group><year>2005</year><article-title>Evolution of Marek's disease &#x02013; a paradigm for incessant race between the pathogen and the host.</article-title><source>Vet J</source><volume>170</volume><fpage>175</fpage><lpage>183</lpage><pub-id pub-id-type="pmid">16129338</pub-id></citation></ref><ref id="pone.0001731-Fadly1"><label>14</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Fadly</surname><given-names>AM</given-names></name><name><surname>Payne</surname><given-names>LN</given-names></name></person-group><year>2003</year><article-title>Leukosis/sarcoma group.</article-title><person-group person-group-type="editor"><name><surname>Saif</surname><given-names>YM</given-names></name><name><surname>Barnes</surname><given-names>HJHJ</given-names></name><name><surname>Glisson</surname><given-names>JR</given-names></name><name><surname>Fadly</surname><given-names>AM</given-names></name><name><surname>Mcdougald</surname><given-names>LR</given-names></name></person-group><source>Disease of Poultry 11th end: 465&#x02013;516</source><publisher-loc>Ames, Iowa, USA</publisher-loc><publisher-name>Iowa State Press, Blackwell Publishing Company</publisher-name></citation></ref><ref id="pone.0001731-Crittenden1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crittenden</surname><given-names>LB</given-names></name><name><surname>Fadly</surname><given-names>AM</given-names></name></person-group><year>1985</year><article-title>Responses of chickens lacking or expressing endogenous avian leukosis virus genes to infecti