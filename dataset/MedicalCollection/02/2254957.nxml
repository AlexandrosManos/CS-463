n-names></name><name><surname>Hendrikse</surname><given-names>F</given-names></name><name><surname>de Vente</surname><given-names>J</given-names></name></person-group><article-title>Selective blockade of phosphodiesterases type 2, 5 and 9 results in cGMP accumulation in retinal pigment epithelium cells.</article-title><source>Br J Ophthalmol</source><year>2006</year><volume>91</volume><fpage>379</fpage><lpage>84</lpage><pub-id pub-id-type="pmid">16943225</pub-id></citation></ref><ref id="r26"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Baylor</surname><given-names>DA</given-names></name></person-group><article-title>Photoreceptor signals and vision.</article-title><source>Invest Ophthalmol Vis Sci</source><year>1987</year><volume>28</volume><fpage>34</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">3026986</pub-id></citation></ref><ref id="r27"><label>27</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marmor</surname><given-names>MF</given-names></name><name><surname>Negi</surname><given-names>A</given-names></name></person-group><article-title>Pharmacologic modification of subretinal fluid absorption in the rabbit eye.</article-title><source>Arch Ophthalmol</source><year>1986</year><volume>104</volume><fpage>1674</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">3778286</pub-id></citation></ref></ref-list></back></article>