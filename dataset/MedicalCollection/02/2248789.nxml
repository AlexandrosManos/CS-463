 small areas</article-title><source>Am J Public Health</source><pub-id pub-id-type="pmid">7977923</pub-id></citation></ref><ref id="B11"><label>11</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Rossi</surname><given-names>P</given-names></name><name><surname>Freeman</surname><given-names>H</given-names></name></person-group><publisher-loc>Newbury Park (CA)</publisher-loc><publisher-name>Sage Publications</publisher-name><year>1993</year><source>Evaluation: a systemic approach</source></citation></ref><ref id="B12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Porter</surname><given-names>EJ</given-names></name></person-group><volume>21</volume><issue>6</issue><year>1999</year><fpage>796</fpage><lpage>804</lpage><article-title>Defining the eligible, accessible population for a phenomenological study</article-title><source>West J Nurs Res</source><pub-id pub-id-type="pmid">11512215</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bartholomew</surname><given-names>LK</given-names></name><name><surname>Parcel</surname><given-names>G</given-names></name><name><surname>Kok</surname><given-names>G</given-names></name><name><surname>Gottlieb</surname><given-names>N</given-names></name></person-group><publisher-loc>Mountain View (CA)</publisher-loc><publisher-name>Mayfield Publishing Company</publisher-name><year>2001</year><source>Intervention mapping: designing theory- and evidence-based health promotion programs</source></citation></ref><ref id="B14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bitler</surname><given-names>M</given-names></name><name><surname>Currie</surname><given-names>J</given-names></name><name><surname>Scholz</surname><given-names>J</given-names></name></person-group><volume>38</volume><issu