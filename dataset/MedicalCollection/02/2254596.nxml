ign="center">1.05</td><td align="center">0.92&#x02013;1.20</td></tr><tr><td></td><td align="left">3-day average</td><td></td><td align="center">0.99</td><td align="center">0.88&#x02013;1.13</td><td align="center">0.92</td><td align="center">0.76&#x02013;1.10</td><td align="center">1.12</td><td align="center">0.93&#x02013;1.34</td></tr><tr><td></td><td align="left">5-day average</td><td></td><td align="center">1.00</td><td align="center">0.87&#x02013;1.15</td><td align="center">0.90</td><td align="center">0.73&#x02013;1.11</td><td align="center">1.14</td><td align="center">0.94&#x02013;1.39</td></tr><tr><td align="left">PM<sub>2.5</sub><sup>&#x02021;</sup></td><td align="left">Same day</td><td align="center">6.3</td><td align="center">1.04</td><td align="center">0.97&#x02013;1.12</td><td align="center">1.04</td><td align="center">0.92&#x02013;1.18</td><td align="center">1.06</td><td align="center">0.96&#x02013;1.16</td></tr><tr><td></td><td align="left">1-day lag</td><td></td><td align="center">1.00</td><td align="center">0.92&#x02013;1.08</td><td align="center">0.99</td><td align="center">0.88&#x02013;1.11</td><td align="center">1.01</td><td align="center">0.91&#x02013;1.11</td></tr><tr><td></td><td align="left">3-day average</td><td></td><td align="center">1.06</td><td align="center">0.97&#x02013;1.17</td><td align="center">1.08</td><td align="center">0.93&#x02013;1.26</td><td align="center">1.06</td><td align="center">0.94&#x02013;1.20</td></tr><tr><td></td><td align="left">5-day average</td><td></td><td align="center">1.10</td><td align="center">0.98&#x02013;1.23</td><td align="center">1.12</td><td align="center">0.94&#x02013;1.34</td><td align="center">1.10</td><td align="center">0.95&#x02013;1.27</td></tr><tr><td align="left">PM<sub>10</sub><sup>&#x02021;</sup></td><td align="left">Same day</td><td align="center">16.0</td><td align="center">1.06</td><td align="center">0.97&#x02013;1.15</td><td align="center">1.04</td><td align="center">0.92&#x02013;1.17</td><td