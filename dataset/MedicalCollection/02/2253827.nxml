<publisher-loc>Geneva</publisher-loc><publisher-name>World Health Organization</publisher-name></citation></ref><ref id="pone.0001721-Netto1"><label>14</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Netto</surname><given-names>E</given-names></name><etal/></person-group><year>1998</year><article-title>Global Tuberculosis Control (WHO/TB/98.237).</article-title><publisher-loc>Geneva</publisher-loc><publisher-name>World Health Organization</publisher-name></citation></ref><ref id="pone.0001721-Netto2"><label>15</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Netto</surname><given-names>E</given-names></name><name><surname>Dye</surname><given-names>C</given-names></name><name><surname>Raviglione</surname><given-names>M</given-names></name></person-group><year>1999</year><article-title>Global Tuberculosis Control (WHO/TB/99.259).</article-title><publisher-loc>Geneva</publisher-loc><publisher-name>World Health Organization</publisher-name></citation></ref><ref id="pone.0001721-Raviglione4"><label>16</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Raviglione</surname><given-names>MC</given-names></name><name><surname>Spinaci</surname><given-names>S</given-names></name></person-group><year>1997</year><article-title>Global Tuberculosis Control. (WHO/TB/97.225)</article-title><publisher-loc>Geneva</publisher-loc><publisher-name>World Health Organization</publisher-name></citation></ref><ref id="pone.0001721-World2"><label>17</label><citation citation-type="book"><collab>World Health Organization</collab><year>2002</year><article-title>Global Tuberculosis Control - Surveillance, Planning, Financing.</article-title><publisher-loc>Geneva</publisher-loc><publisher-name>World Health Organization</publisher-name></citation></ref><ref id="pone.0001721-World3"><label>18</label><citation citation-type="book"><collab>World Health Organization</coll