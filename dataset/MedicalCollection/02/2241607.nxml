ven-names>NC</given-names></name><name><surname>Campbell</surname><given-names>RE</given-names></name><name><surname>Steinbach</surname><given-names>PA</given-names></name><name><surname>Giepmans</surname><given-names>BNG</given-names></name><name><surname>Palmer</surname><given-names>AE</given-names></name><name><surname>Tsien</surname><given-names>RY</given-names></name></person-group><article-title>Improved monomeric red, orange and yellow fluorescent proteins derived from Discosoma sp. Red fluorescent protein</article-title><source>Nature Biotech</source><year>2004</year><volume>22</volume><fpage>1567</fpage><lpage>1572</lpage><pub-id pub-id-type="doi">10.1038/nbt1037</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shaner</surname><given-names>NC</given-names></name><name><surname>Steinbach</surname><given-names>PA</given-names></name><name><surname>Tsien</surname><given-names>RY</given-names></name></person-group><article-title>A guide to choosing fluorescent proteins</article-title><source>Nature Methods</source><year>2005</year><volume>2</volume><fpage>905</fpage><lpage>909</lpage><pub-id pub-id-type="pmid">16299475</pub-id><pub-id pub-id-type="doi">10.1038/nmeth819</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rizzo</surname><given-names>MA</given-names></name><name><surname>Springer</surname><given-names>GH</given-names></name><name><surname>Granada</surname><given-names>B</given-names></name><name><surname>Piston</surname><given-names>DW</given-names></name></person-group><article-title>An improved cyan fluorescent protein variant useful for FRET</article-title><source>Nature Biotech</source><year>2004</year><volume>4</volume><fpage>445</fpage><lpage>449</lpage><pub-id pub-id-type="doi">10.1038/nbt945</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-g