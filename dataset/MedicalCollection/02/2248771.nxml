/year><fpage>959</fpage><lpage>967</lpage><article-title>The effects of depressed affect on functional disability among rural older adults</article-title><source>Qual Life Res</source><pub-id pub-id-type="pmid">15233509</pub-id></citation></ref><ref id="B23"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Glassman</surname><given-names>AH</given-names></name><name><surname>Bigger</surname><given-names>JT</given-names></name><name><surname>Gaffney</surname><given-names>M</given-names></name><name><surname>Shapiro</surname><given-names>PA</given-names></name><name><surname>Swenson</surname><given-names>JR</given-names></name></person-group><volume>63</volume><issue>3</issue><year>2006</year><fpage>283</fpage><lpage>288</lpage><article-title>Onset of major depression associated with acute coronary syndromes: relationship of onset, major depressive disorder history, and episode severity to sertraline benefit</article-title><source>Arch Gen Psychiatry</source><pub-id pub-id-type="pmid">16520433</pub-id></citation></ref><ref id="B24"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Preville</surname><given-names>M</given-names></name><name><surname>Cote</surname><given-names>G</given-names></name><name><surname>Boyer</surname><given-names>R</given-names></name><name><surname>H&#x000e9;bert</surname><given-names>R</given-names></name></person-group><volume>8</volume><issue>5</issue><year>2004</year><fpage>400</fpage><lpage>409</lpage><article-title>Detection of depression and anxiety disorders by home care nurses</article-title><source>Aging Ment Health</source><pub-id pub-id-type="pmid">15511738</pub-id></citation></ref><ref id="B25"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Un&#x000fc;tzer</surname><given-names>J</given-names></name><name><surname>Katon</surname><given-names>W</given-names></