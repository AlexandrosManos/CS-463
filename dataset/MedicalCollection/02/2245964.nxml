pmid">9212846</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1096-911X(199709)29:3&#x0003c;208::AID-MPO8&#x0003e;3.0.CO;2-H</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mejia-Arangure</surname><given-names>JM</given-names></name><name><surname>Fajardo-Gutierrez</surname><given-names>A</given-names></name><name><surname>Bernaldez-Rios</surname><given-names>R</given-names></name><name><surname>Farfan-Canto</surname><given-names>J</given-names></name><name><surname>Ortiz-Fernandez</surname><given-names>A</given-names></name><name><surname>Martinez-Garc&#x000ed;a</surname><given-names>MC</given-names></name></person-group><article-title>Incidence trends of acute leukemia among the children of Mexico City: 1982&#x02013;1991</article-title><source>Arch Med Res</source><year>1996</year><volume>27</volume><fpage>223</fpage><lpage>227</lpage><pub-id pub-id-type="pmid">8696068</pub-id></citation></ref><ref id="B9"><citation citation-type="other"><person-group person-group-type="author"><collab>National Cancer Institute. Division of Cancer Epidemiology and Genetics</collab></person-group><article-title>Questionnaire Modules. The QMOD Web page</article-title><ext-link ext-link-type="uri" xlink:href="http://dceg.cancer.gov/QMOD"/></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Little</surname><given-names>J</given-names></name></person-group><article-title>Maternal reproductive history, and maternal illness and related drug use</article-title><source>Epidemiology of childhood cancer</source><year>1999</year><publisher-name>Lyon: International Agency for Research on Cancer</publisher-name><fpage>279</fpage><lpage>303</lpage></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Little</surname><given-names>J</given-names></name></person-group><article-title>Medical history of index child</article-title><source>Epidemiology of childhood cancer</source><year>1999</year><publisher-name>Lyon: International Agency for Research on Cancer</publisher-name><fpage>304</fpage><lpage>341</lpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Paltiel</surname><given-names>O</given-names></name><name><surname>Harlap</surname><given-names>S</given-names></name><name><surname>Deutsch</surname><given-names>L</given-names></name><name><surname>Knaanie</surname><given-names>A</given-names></name><name><surname>Massalha</surname><given-names>S</given-names></name><name><surname>Tiram</surname><given-names>E</given-names></name><name><surname>Barchana</surname><given-names>M</given-names></name><name><surname>Friedlander</surname><given-names>Y</given-names></name></person-group><article-title>Birth weight and other risk factors for acute leukemia in the Jerusal&#x000e9;m Perinatal study cohort</article-title><source>Cancer Epidemiol Biomarkers Prev</source><year>2004</year><volume>13</volume><fpage>1057</fpage><lpage>1064</lpage><pub-id pub-id-type="pmid">15184264</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bronfman</surname><given-names>M</given-names></name><name><surname>Guiscafre</surname><given-names>H</given-names></name><name><surname>Castro</surname><given-names>V</given-names></name><name><surname>Castro</surname><given-names>R</given-names></name><name><surname>Gutierrez</surname><given-names>G</given-names></name></person-group><article-title>II. La medici&#x000f3;n de la desigualdad: una estrategia metodol&#x000f3;gica, an&#x000e1;lisis de las caracter&#x000ed;sticas socioecon&#x000f3;micas de la muestra</article-title><source>Arch Invest Med (Mex)</source><year>1988</year><volume>19</volume><fpage>351</fpage><lpage>353</lpage><pub-id pub-id-type="pmid">3245751</pub-id></citation>