rce><year>1999</year><volume>15</volume><fpage>113</fpage><lpage>116</lpage><!--PubMed citation query: 'Int J Oncol||15|113||bib11|'--><pub-id pub-id-type="pmid">10375602</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hepworth</surname><given-names>SJ</given-names></name><name><surname>Schoemaker</surname><given-names>MJ</given-names></name><name><surname>Muir</surname><given-names>KR</given-names></name><name><surname>Swerdlow</surname><given-names>AJ</given-names></name><name><surname>van Tongeren</surname><given-names>MJ</given-names></name><name><surname>McKinney</surname><given-names>PA</given-names></name></person-group><article-title>Mobile phone use and risk of glioma in adults: case&#x02013;control study</article-title><source>BMJ</source><year>2006</year><volume>332</volume><fpage>883</fpage><lpage>887</lpage><!--PubMed citation query: 'BMJ||332|883||bib12|'--></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hours</surname><given-names>M</given-names></name><name><surname>Bernard</surname><given-names>M</given-names></name><name><surname>Montestrucq</surname><given-names>L</given-names></name><name><surname>Arslan</surname><given-names>M</given-names></name><name><surname>Bergeret</surname><given-names>A</given-names></name><name><surname>Deltour</surname><given-names>I</given-names></name><name><surname>Cardis</surname><given-names>E</given-names></name></person-group><article-title>[Cell phones and risk of brain and acoustic nerve tumours: the French INTERPHONE case&#x02013;control study]</article-title><source>Rev Epidemiol Sante Publique</source><year>2007</year><volume>55</volume><fpage>321</fpage><lpage>332</lpage><!--PubMed citation query: 'Rev Epidemiol Sante Publique||55|321||bib13|'--><pub-id pub-id-type="pmid">17851009</pub-id></citation></ref><ref id="bib14"><citation citation-type="journa