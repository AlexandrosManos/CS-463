e><given-names>B</given-names></name><name><surname>van</surname><given-names>Andel</given-names><suffix>G</suffix></name><name><surname>Bensing</surname><given-names>J</given-names></name></person-group><volume>63</volume><issue>3</issue><year>2006</year><fpage>308</fpage><lpage>313</lpage><article-title>Treatment decision making in prostate cancer: patients' participation in complex decisions</article-title><source>Patient Educ Couns</source><pub-id pub-id-type="pmid">16965887</pub-id></citation></ref><ref id="B21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Denberg</surname><given-names>TD</given-names></name><name><surname>Melhado</surname><given-names>TV</given-names></name><name><surname>Steiner</surname><given-names>JF</given-names></name></person-group><volume>107</volume><issue>3</issue><year>2006</year><fpage>620</fpage><lpage>630</lpage><article-title>Patient treatment preferences in localized prostate carcinoma: the influence of emotion, misconception, and anecdote</article-title><source>Cancer</source><pub-id pub-id-type="pmid">16802287</pub-id></citation></ref><ref id="B22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berry</surname><given-names>DL</given-names></name><name><surname>Ellis</surname><given-names>WJ</given-names></name><name><surname>Russell</surname><given-names>KJ</given-names></name><name><surname>Blasko</surname><given-names>JC</given-names></name><name><surname>Bush</surname><given-names>N</given-names></name><name><surname>Blumenstein</surname><given-names>B</given-names></name><etal/></person-group><volume>5</volume><issue>3</issue><year>2006</year><fpage>219</fpage><lpage>226</lpage><article-title>Factors that predict treatment choice and satisfaction with the decision in men with localized prostate cancer</article-title><source>Clin Genitourin Cancer</source><pub-id pub-id-type="pmid">17239276</pub-id></citation></ref><ref id="B23"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bennett</surname><given-names>CL</given-names></name><name><surname>Ferreira</surname><given-names>MR</given-names></name><name><surname>Davis</surname><given-names>TC</given-names></name><name><surname>Kaplan</surname><given-names>J</given-names></name><name><surname>Weinberger</surname><given-names>M</given-names></name><name><surname>Kuzel</surname><given-names>T</given-names></name><etal/></person-group><volume>16</volume><issue>9</issue><year>1998</year><fpage>3101</fpage><lpage>3104</lpage><article-title>Relation between literacy, race, and stage of presentation among low-income patients with prostate cancer</article-title><source>J Clin Oncol</source><pub-id pub-id-type="pmid">9738581</pub-id></citation></ref><ref id="B24"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>SP</given-names></name><name><surname>Knight</surname><given-names>SJ</given-names></name><name><surname>Tomori</surname><given-names>C</given-names></name><name><surname>Colella</surname><given-names>KM</given-names></name><name><surname>Schoor</surname><given-names>RA</given-names></name><name><surname>Shih</surname><given-names>L</given-names></name><etal/></person-group><volume>19</volume><issue>7</issue><year>2001</year><fpage>684</fpage><lpage>691</lpage><article-title>Health literacy and shared decision making for prostate cancer patients with low socioeconomic status</article-title><source>Cancer Invest</source><pub-id pub-id-type="pmid">11577809</pub-id></citation></ref><ref id="B25"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wolf</surname><given-names>MS</given-names></name><name><surname>Knight</surname><given-names>SJ</given-names></name><name><surname>Lyons</surname><given-names>EA</given-names></name><n