mid">15456669</pub-id></citation></ref><ref id="B15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaphingst</surname><given-names>KA</given-names></name><name><surname>Zanfini</surname><given-names>CJ</given-names></name><name><surname>Emmons</surname><given-names>KM</given-names></name></person-group><volume>17</volume><issue>2</issue><year>2006</year><fpage>147</fpage><lpage>151</lpage><article-title>Accessibility of Web sites containing colorectal cancer information to adults with limited literacy (United States)</article-title><source>Cancer Causes Control</source><pub-id pub-id-type="pmid">16425092</pub-id></citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ziebland</surname><given-names>S</given-names></name></person-group><volume>59</volume><issue>9</issue><year>2004</year><fpage>1783</fpage><lpage>1793</lpage><article-title>The importance of being expert: the quest for cancer information on the Internet</article-title><source>Soc Sci Med</source><pub-id pub-id-type="pmid">15312914</pub-id></citation></ref><ref id="B17"><label>17</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Spooner</surname><given-names>T</given-names></name><name><surname>Rainie</surname><given-names>L</given-names></name><name><surname>Fox</surname><given-names>S</given-names></name><name><surname>Horrigan</surname><given-names>J</given-names></name><name><surname>Lenhart</surname><given-names>A</given-names></name></person-group><year>2007</year><source>African-Americans and the Internet.</source><publisher-loc>Washington (DC)</publisher-loc><publisher-name>Pew Internet &#x00026; American Life Project</publisher-name><access-date>Accessed May 5, 2007</access-date><comment><ext-link ext-link-type="uri" xlink:href="http://www.pewinternet.org/pdfs/PIP_African_Americans_Report.pdf.">http://www.pewint