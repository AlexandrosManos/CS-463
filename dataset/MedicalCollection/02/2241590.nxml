="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cox</surname><given-names>DF</given-names></name><name><surname>Miller</surname><given-names>HD</given-names></name></person-group><source>The theory of stochastic process</source><year>1965</year><publisher-name>London, Methuen</publisher-name></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brookmeyer</surname><given-names>R</given-names></name><name><surname>Quinn</surname><given-names>TC</given-names></name></person-group><article-title>Estimation of current human immunodeficiency virus incidence rates from a cross-sectional survey using early diagnostic tests</article-title><source>Am J Epidemiol</source><year>1995</year><volume>141</volume><fpage>166</fpage><lpage>172</lpage><pub-id pub-id-type="pmid">7817972</pub-id></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Tanner</surname><given-names>MA</given-names></name></person-group><source>Tools for statistical inference&#x02013;Methods for the exploration of posterior distribution and likelihood functions</source><year>1996</year><publisher-name>U.S.A, Springer</publisher-name></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Longford</surname><given-names>NT</given-names></name><name><surname>Ely</surname><given-names>M</given-names></name><name><surname>Hardy</surname><given-names>R</given-names></name><name><surname>Wadsworth</surname><given-names>MEJ</given-names></name></person-group><article-title>Handling missing data in diaries of alcohol consumption</article-title><source>J R Statist Soc A</source><year>2000</year><volume>163</volume><fpage>381</fpage><lpage>402</lpage><pub-id pub-id-type="doi">10.1111/1467-985X.00174</pub-id></citation></ref><ref id="B17"><citation citation-type="book"><person-group 