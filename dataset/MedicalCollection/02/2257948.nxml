itation citation-type="journal"><person-group person-group-type="author"><name><surname>Baltussen</surname><given-names>R</given-names></name><name><surname>Floyd</surname><given-names>K</given-names></name><name><surname>Dye</surname><given-names>C</given-names></name></person-group><article-title>Cost effectiveness analysis of strategies for tuberculosis control in developing countries</article-title><source>BMJ</source><year>2005</year><volume>331</volume><fpage>1364</fpage><pub-id pub-id-type="pmid">16282379</pub-id><pub-id pub-id-type="doi">10.1136/bmj.38645.660093.68</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Enwuru</surname><given-names>CA</given-names></name><name><surname>Idigbe</surname><given-names>EO</given-names></name><name><surname>Ezeobi</surname><given-names>NV</given-names></name><name><surname>Otegbeye</surname><given-names>AF</given-names></name></person-group><article-title>Care-seeking behavioural patterns, awareness and diagnostic processes in patients with smear- and culture-positive pulmonary tuberculosis in Lagos, Nigeria</article-title><source>Trans R Soc Trop Med Hyg</source><year>2002</year><volume>96</volume><fpage>614</fpage><lpage>616</lpage><pub-id pub-id-type="pmid">12625134</pub-id><pub-id pub-id-type="doi">10.1016/S0035-9203(02)90328-7</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rajeswari</surname><given-names>R</given-names></name><name><surname>Chandrasekaran</surname><given-names>V</given-names></name><name><surname>Suhadev</surname><given-names>M</given-names></name><name><surname>Sivasubramaniam</surname><given-names>S</given-names></name><name><surname>Sudha</surname><given-names>G</given-names></name><name><surname>Renu</surname><given-names>G</given-names></name></person-group><article-title>Factors associated with patient and health system delays in the diagnosis of tuberculosis in South India</article-title><source>Int J Tuberc Lung Dis</source><year>2002</year><volume>6</volume><fpage>789</fpage><lpage>795</lpage><pub-id pub-id-type="pmid">12234134</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lambert</surname><given-names>ML</given-names></name><name><surname>Van der Stuyft</surname><given-names>P</given-names></name></person-group><article-title>Delays to tuberculosis treatment: shall we continue to blame the victim?</article-title><source>Trop Med Int Health</source><year>2005</year><volume>10</volume><fpage>945</fpage><lpage>946</lpage><pub-id pub-id-type="pmid">16185227</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-3156.2005.01485.x</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>ten Asbroek</surname><given-names>AH</given-names></name><name><surname>Delnoij</surname><given-names>DM</given-names></name><name><surname>Niessen</surname><given-names>LW</given-names></name><name><surname>Scherpbier</surname><given-names>RW</given-names></name><name><surname>Shrestha</surname><given-names>N</given-names></name><name><surname>Bam</surname><given-names>DS</given-names></name><name><surname>Gunneberg</surname><given-names>C</given-names></name><name><surname>van der Hor</surname><given-names>CW</given-names></name><name><surname>Klazinga</surname><given-names>NS</given-names></name></person-group><article-title>Implementing global knowledge in local practice: a WHO lung health initiative in Nepal</article-title><source>Health Policy Plan</source><year>2005</year><volume>20</volume><fpage>290</fpage><lpage>301</lpage><pub-id pub-id-type="pmid">16000368</pub-id><pub-id pub-id-type="doi">10.1093/heapol/czi034</pub-id></citation></ref><ref id="B10"><citation citation-type="other"><person-group person-group-type="author"><collab>World Health Organization</collab></person-group><article-title>Practical Approach to Lung Health</article-title><year>2007</year><ext-link ext-link-type="uri" xlink:href="http://www.who.int/tb/health_systems/pal/en/"/></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Scherpbier</surname><given-names>RW</given-names></name><name><surname>Hanson</surname><given-names>C</given-names></name><name><surname>Raviglione</surname><given-names>M</given-names></name></person-group><source>Adult Lung Health Initiative: Basis for the development of algorithms for assessment, classification and treatment of respiratory illness in school-age children, youths and adults in developing countries. WHO/TB/98.257</source><year>1998</year><publisher-name>Geneva, World Health Organization</publisher-name></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zola</surname><given-names>IK</given-names></name></person-group><article-title>Pathways to the doctor-from person to patient</article-title><source>Soc Sci Med</source><year>1973</year><volume>7</volume><fpage>677</fpage><lpage>689</lpage><pub-id pub-id-type="pmid">4749058</pub-id><pub-id pub-id-type="doi">10.1016/0037-7856(73)90002-4</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nyamongo</surname><given-names>IK</given-names></name></person-group><article-title>Health care switching behaviour of malaria patients in a Kenyan rural community</article-title><source>Soc Sci Med</source><year>2002</year><volume>54</volume><fpage>377</fpage><lpage>386</lpage><pub-id pub-id-type="pmid">11824914</pub-id><pub-id pub-id-type="doi">10.1016/S0277-9536(01)00036-3</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sudha</surname><given-names>G</given-names></name><name><surname>Nirupa</s