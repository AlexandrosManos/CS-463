-id pub-id-type="doi">10.1016/S0090-4295(01)01245-6</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pilepich</surname><given-names>MV</given-names></name><name><surname>Winter</surname><given-names>K</given-names></name><name><surname>Lawton</surname><given-names>CA</given-names></name></person-group><article-title>Androgen suppression adjuvant to definitive radiotherapy in prostate carcinoma &#x02013; long-term results of phase III RTOG 85-31</article-title><source>Int J Radiat Oncol Biol Phys</source><year>2005</year><volume>61</volume><fpage>1285</fpage><lpage>90</lpage><pub-id pub-id-type="pmid">15817329</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rees</surname><given-names>J</given-names></name><name><surname>Patel</surname><given-names>B</given-names></name><name><surname>MacDonagh</surname><given-names>R</given-names></name><name><surname>Persad</surname><given-names>R</given-names></name></person-group><article-title>Cryosurgery for prostate cancer</article-title><source>BJU Int</source><year>2004</year><volume>93</volume><fpage>710</fpage><lpage>714</lpage><pub-id pub-id-type="pmid">15049977</pub-id><pub-id pub-id-type="doi">10.1111/j.1464-410X.2003.04746.x</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Prepelica</surname><given-names>KL</given-names></name><name><surname>Okeke</surname><given-names>Z</given-names></name><name><surname>Murphy</surname><given-names>A</given-names></name><name><surname>Katz</surname><given-names>A</given-names></name></person-group><article-title>Cryoablation of the prostate: High risk patient outcomes</article-title><source>Cancer</source><year>2005</year><volume>103</volume><fpage>1625</fpage><lpage>1630</lpage><pub-id pub-id-type="pmid">15747374</pub-id><pub-id pub-id-type="doi">10