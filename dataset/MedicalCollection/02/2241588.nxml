-names>SM</given-names></name></person-group><article-title>The psychological reaction of women to a colposcopy clinic</article-title><source>Br J Obstet Gynaecol</source><year>1994</year><volume>101</volume><fpage>751</fpage><lpage>752</lpage><pub-id pub-id-type="pmid">7677811</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rogstad</surname><given-names>KE</given-names></name></person-group><article-title>The psychological impact of abnormal cytology and colposcopy</article-title><source>BJOG</source><year>2002</year><volume>109</volume><fpage>364</fpage><lpage>368</lpage><pub-id pub-id-type="pmid">12013155</pub-id><pub-id pub-id-type="doi">10.1111/j.1471-0528.2002.99023.x</pub-id></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Silverman</surname><given-names>D</given-names></name></person-group><source>Doing Qualitative Research: A Practical Handbook</source><year>2000</year><publisher-name>Sage Publications Ltd</publisher-name></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bowling</surname><given-names>A</given-names></name></person-group><source>Research methods in health</source><year>2002</year><edition>2nd</edition><publisher-name>Open University Press</publisher-name></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>DePaulo</surname><given-names>P</given-names></name></person-group><article-title>Sample size for qualitative research</article-title><source>Quirks Marketing Research Review</source><year>2000</year><volume>Article ID: 20001202</volume><ext-link ext-link-type="uri" xlink:href="http://www.quirks.com/articles"/></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Morse</surname><given-names>J</gi