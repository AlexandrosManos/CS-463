</citation></ref><ref id="B8"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Prescott</surname><given-names>O</given-names></name></person-group><source>Princes of the renaissance</source><year>1969</year><publisher-name>New York , Random House</publisher-name></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Orloff</surname><given-names>HA</given-names></name><name><surname>Rapp</surname><given-names>CM</given-names></name></person-group><article-title>The effects of load carriage on spinal curvature and posture</article-title><source>Spine</source><year>2004</year><volume>29</volume><fpage>1325</fpage><lpage>1329</lpage><pub-id pub-id-type="pmid">15187633</pub-id><pub-id pub-id-type="doi">10.1097/01.BRS.0000127185.74191.B1</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Korovessis</surname><given-names>P</given-names></name><name><surname>Koureas</surname><given-names>G</given-names></name><name><surname>Papazisis</surname><given-names>Z</given-names></name></person-group><article-title>Correlation between backpack weight and way of carrying, sagittal and frontal spinal curvatures, athletic activity, and dorsal and low back pain in schoolchildren and adolescents</article-title><source>J Spinal Disord Tech</source><year>2004</year><volume>17</volume><fpage>33</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">14734974</pub-id><pub-id pub-id-type="doi">10.1097/00024720-200402000-00008</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Korovessis</surname><given-names>P</given-names></name><name><surname>Koureas</surname><given-names>G</given-names></name><name><surname>Zacharatos</surname><given-names>S</given-names></name><name><surname>Papazisis</surname><given-names>Z</given-names></name></person-group><article-title>Backpacks, back pain, sagittal spinal curves and trunk alignment in adolescents: a logistic and multinomial logistic analysis</article-title><source>Spine</source><year>2005</year><volume>30</volume><fpage>247</fpage><lpage>255</lpage><pub-id pub-id-type="pmid">15644765</pub-id><pub-id pub-id-type="doi">10.1097/01.brs.0000150505.59690.1b</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Palanichamy</surname><given-names>MS</given-names></name><name><surname>Patil</surname><given-names>MK</given-names></name><name><surname>Ghista</surname><given-names>DN</given-names></name></person-group><article-title>Minimization of the vertical vibrations sustained by a tractor operator, by provision of a standard-type tractor seat suspension</article-title><source>Ann Biomed Eng</source><year>1978</year><volume>6</volume><fpage>138</fpage><lpage>153</lpage><pub-id pub-id-type="pmid">717865</pub-id><pub-id pub-id-type="doi">10.1007/BF02584540</pub-id></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lightbown</surname><given-names>R</given-names></name></person-group><source>Piero della Francesca</source><year>1992</year><publisher-name>New York , Abbeville Press</publisher-name></citation></ref></ref-list></back></article>