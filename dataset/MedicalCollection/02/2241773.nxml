 gynecology &#x00026; obstetrics</source><year>1992</year><volume>174</volume><fpage>399</fpage><lpage>402</lpage><pub-id pub-id-type="pmid">1570618</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wantz</surname><given-names>GE</given-names></name></person-group><article-title>Testicular atrophy as a sequela of inguinal hernioplasty</article-title><source>International surgery</source><year>1986</year><volume>71</volume><fpage>159</fpage><lpage>163</lpage><pub-id pub-id-type="pmid">3771117</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heifetz</surname><given-names>CJ</given-names></name></person-group><article-title>Resection of the spermatic cord in selected inguinal hernias. Twenty years of experience</article-title><source>Arch Surg</source><year>1971</year><volume>102</volume><fpage>36</fpage><lpage>39</lpage><pub-id pub-id-type="pmid">4923036</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Korman</surname><given-names>JE</given-names></name><name><surname>Hiatt</surname><given-names>JR</given-names></name><name><surname>Feldmar</surname><given-names>D</given-names></name><name><surname>Phillips</surname><given-names>EH</given-names></name></person-group><article-title>Mesh configurations in laparoscopic extraperitoneal herniorrhaphy. A comparison of techniques</article-title><source>Surgical endoscopy</source><year>1997</year><volume>11</volume><fpage>1102</fpage><lpage>1105</lpage><pub-id pub-id-type="pmid">9348384</pub-id><pub-id pub-id-type="doi">10.1007/s004649900540</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Felix</surname><given-names>EL</given-names></name><name><surname>Michas</surname><given-names>C</given-names></name></person-group><article-title>Double-buttress laparoscopic herniorrhaphy</article-title><source>Journal of laparoendoscopic surgery</source><year>1993</year><volume>3</volume><fpage>1</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">8453121</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>LM</given-names></name><name><surname>Wright</surname><given-names>JE</given-names></name><name><surname>McLoughlin</surname><given-names>MG</given-names></name></person-group><article-title>Testicular torsion in the adult</article-title><source>The Journal of urology</source><year>1983</year><volume>130</volume><fpage>93</fpage><lpage>94</lpage><pub-id pub-id-type="pmid">6864923</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Witherington</surname><given-names>R</given-names></name><name><surname>Jarrell</surname><given-names>TS</given-names></name></person-group><article-title>Torsion of the spermatic cord in adults</article-title><source>The Journal of urology</source><year>1990</year><volume>143</volume><fpage>62</fpage><lpage>63</lpage><pub-id pub-id-type="pmid">2294265</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arda</surname><given-names>IS</given-names></name><name><surname>Ozyaylali</surname><given-names>I</given-names></name></person-group><article-title>Testicular tissue bleeding as an indicator of gonadal salvageability in testicular torsion surgery</article-title><source>BJU international</source><year>2001</year><volume>87</volume><fpage>89</fpage><lpage>92</lpage><pub-id pub-id-type="pmid">11121999</pub-id><pub-id pub-id-type="doi">10.1046/j.1464-410x.2001.00021.x</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Holloway</surname><given-names>BJ</given-names></name><name><surname>Belcher</surname><given-names>HE</given-names></name><name><surname>Letourneau</surname><given-names>JG</given-names></name><name><surname>Kunberger</surname><given-names>LE</given-names></name></person-group><article-title>Scrotal sonography: a valuable tool in the evaluation of complications following inguinal hernia repair</article-title><source>J Clin Ultrasound</source><year>1998</year><volume>26</volume><fpage>341</fpage><lpage>344</lpage><pub-id pub-id-type="pmid">9719982</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1097-0096(199809)26:7&#x0003c;341::AID-JCU2&#x0003e;3.0.CO;2-9</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Akin</surname><given-names>EA</given-names></name><name><surname>Khati</surname><given-names>NJ</given-names></name><name><surname>Hill</surname><given-names>MC</given-names></name></person-group><article-title>Ultrasound of the scrotum</article-title><source>Ultrasound quarterly</source><year>2004</year><volume>20</volume><fpage>181</fpage><lpage>200</lpage><pub-id pub-id-type="pmid">15602220</pub-id><pub-id pub-id-type="doi">10.1097/00013644-200412000-00004</pub-id></citation></ref></ref-list></back></article>