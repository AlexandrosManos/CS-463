erson-group-type="author"><name><surname>Daberkow</surname><given-names>SG</given-names></name></person-group><article-title>Location and cost of ambulances serving a rural area</article-title><source>Health Serv Res</source><year>1977</year><volume>12</volume><fpage>299</fpage><lpage>311</lpage><pub-id pub-id-type="pmid">914530</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lerner</surname><given-names>EB</given-names></name><name><surname>Billittier</surname><given-names>AJ</given-names></name><name><surname>Sikora</surname><given-names>J</given-names></name><name><surname>Moscati</surname><given-names>RM</given-names></name></person-group><article-title>Use of a geographic information system to determine appropriate means of trauma patient transport</article-title><source>Acad Emerg Med</source><year>1999</year><volume>6</volume><fpage>1127</fpage><lpage>1133</lpage><pub-id pub-id-type="pmid">10569385</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Peleg</surname><given-names>K</given-names></name><name><surname>Pliskin</surname><given-names>JS</given-names></name></person-group><article-title>A geographic information system simulation model of EMS: reducing ambulance response time</article-title><source>Am J Emerg Med</source><year>2004</year><volume>22</volume><fpage>164</fpage><lpage>170</lpage><pub-id pub-id-type="pmid">15138950</pub-id><pub-id pub-id-type="doi">10.1016/j.ajem.2004.02.003</pub-id></citation></ref></ref-list></back></article>