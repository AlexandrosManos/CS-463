me></person-group><article-title>Controversies in "clearing" trauma to the cervical spine</article-title><source>Semin Ultrasound CT MR</source><year>2007</year><volume>28</volume><fpage>94</fpage><lpage>100</lpage><pub-id pub-id-type="pmid">17432763</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Fisher</surname><given-names>A</given-names></name><name><surname>Young</surname><given-names>WF</given-names></name></person-group><article-title>Is the lateral cervical spine x-ray obsolete during the initial evaluation of patients with acute trauma?</article-title><source>Surg Neurol</source><year>2008</year><volume>70</volume><fpage>53</fpage><lpage>57</lpage><pub-id pub-id-type="pmid">18207543</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Duane</surname><given-names>TM</given-names></name><name><surname>Dechert</surname><given-names>T</given-names></name><name><surname>Wolfe</surname><given-names>LG</given-names></name><name><surname>Aboutanos</surname><given-names>MB</given-names></name><name><surname>Malhotra</surname><given-names>AK</given-names></name><name><surname>Ivatury</surname><given-names>RR</given-names></name></person-group><article-title>Clinical examination and its reliability in identifying cervical spine fractures</article-title><source>J Trauma</source><year>2007</year><volume>62</volume><fpage>1405</fpage><lpage>1408</lpage><pub-id pub-id-type="pmid">17563656</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Shaukat</surname><given-names>A</given-names></name><name><surname>Ahmad</surname><given-names>G</given-names></name><name><surname>Anjum</surname><given-names>MN</given-names></name></person-group><artic