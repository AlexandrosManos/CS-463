e-title><source>Trends Neurosci</source><volume>27</volume><fpage>203</fpage><lpage>209</lpage><pub-id pub-id-type="pmid">15046879</pub-id></citation></ref><ref id="pbio-0060034-b015"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burgoyne</surname><given-names>RD</given-names></name></person-group><year>2007</year><article-title>Neuronal calcium sensor proteins: generating diversity in neuronal Ca<sup>2&#x0002b;</sup> signalling</article-title><source>Nat Rev Neurosci</source><volume>8</volume><fpage>182</fpage><lpage>193</lpage><pub-id pub-id-type="pmid">17311005</pub-id></citation></ref><ref id="pbio-0060034-b016"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Seidenbecher</surname><given-names>CI</given-names></name><name><surname>Langn&#x000e4;se</surname><given-names>K</given-names></name><name><surname>Sanmarti-Vila</surname><given-names>L</given-names></name><name><surname>B&#x000f6;ckers</surname><given-names>TM</given-names></name><name><surname>Smalla</surname><given-names>KH</given-names></name><etal/></person-group><year>1998</year><article-title>Caldendrin, a novel neuronal calcium-binding protein confined to the somato-dendritic compartment</article-title><source>J Biol Chem</source><volume>273</volume><fpage>21324</fpage><lpage>21331</lpage><pub-id pub-id-type="pmid">9694893</pub-id></citation></ref><ref id="pbio-0060034-b017"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haeseleer</surname><given-names>F</given-names></name><name><surname>Sokal</surname><given-names>I</given-names></name><name><surname>Verlinde</surname><given-names>LMJ</given-names></name><name><surname>Erdjumen-Bromage</surname><given-names>H</given-names></name><name><surname>Tempst</surname><given-names>P</given-names></name><etal/></person-group><year>2000</year><article-title>Five members of a novel Ca<sup>2&#x0002b;</sup>-binding protein (CaBP) sub