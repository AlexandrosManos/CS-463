<given-names>S</given-names></name></person-group><article-title>Evaluating placental inter-ordinal phylogenies with novel sequences including RAG1, gamma-fibrinogen, ND6, and mt-tRNA, plus MCMC-driven nucleotide, amino acid, and codon models</article-title><source>Molecular Phylogenetics and Evolution</source><year>2003</year><volume>28</volume><fpage>197</fpage><lpage>224</lpage><pub-id pub-id-type="pmid">12878459</pub-id><pub-id pub-id-type="doi">10.1016/S1055-7903(03)00115-5</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Springer</surname><given-names>MS</given-names></name><name><surname>Cleven</surname><given-names>GC</given-names></name><name><surname>Madsen</surname><given-names>O</given-names></name><name><surname>de Jong</surname><given-names>WW</given-names></name><name><surname>Waddell</surname><given-names>VG</given-names></name><name><surname>Amrine</surname><given-names>HM</given-names></name><name><surname>Stanhope</surname><given-names>MJ</given-names></name></person-group><article-title>Endemic African mammals shake the phylogenetic tree</article-title><source>Nature</source><year>1997</year><volume>388</volume><fpage>61</fpage><lpage>64</lpage><pub-id pub-id-type="pmid">9214502</pub-id><pub-id pub-id-type="doi">10.1038/40386</pub-id></citation></ref><ref id="B9"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Montgelard</surname><given-names>C</given-names></name><name><surname>Douzery</surname><given-names>EJP</given-names></name><name><surname>Michaux</surname><given-names>J</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Jamieson BGM</surname></name></person-group><article-title>Classification and molecular phylogeny</article-title><source>Reproductive biology and phylogeny of Cetacea (whales, dolphins and porpoises)</source><year>2007</year><volume>7</volume><publisher-name>Enfield (New Hampshire, USA) , Science Publishers</publisher-name><fpage>95</fpage><lpage>125</lpage></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Douady</surname><given-names>CJ</given-names></name><name><surname>Chatelier</surname><given-names>PI</given-names></name><name><surname>Madsen</surname><given-names>O</given-names></name><name><surname>de Jong</surname><given-names>WW</given-names></name><name><surname>Catzeflis</surname><given-names>F</given-names></name><name><surname>Springer</surname><given-names>MS</given-names></name><name><surname>Stanhope</surname><given-names>MJ</given-names></name></person-group><article-title>Molecular phylogenetic evidence confirming the Eulipotyphla concept and in support of hedgehogs as the sister group to shrews</article-title><source>Molecular Phylogenetics and Evolution</source><year>2002</year><volume>25</volume><fpage>200</fpage><lpage>209</lpage><pub-id pub-id-type="pmid">12383761</pub-id><pub-id pub-id-type="doi">10.1016/S1055-7903(02)00232-4</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Townsend</surname><given-names>JP</given-names></name></person-group><article-title>Profiling phylogenetic informativeness</article-title><source>Systematic Biology</source><year>2007</year><volume>56</volume><fpage>222</fpage><lpage>231</lpage><pub-id pub-id-type="pmid">17464879</pub-id><pub-id pub-id-type="doi">10.1080/10635150701311362</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldman</surname><given-names>N</given-names></name></person-group><article-title>Phylogenetic information and experimental design in molecular systematics</article-title><source>Proc Biol Sci</source><year>1998</year><volume>265</volume><fpage>1779</fpage><lpage>1786</lpage><pub-id pub-id-type="pmid">9787470</pub-id><pub-id p