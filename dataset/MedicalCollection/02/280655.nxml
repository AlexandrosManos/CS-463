can Journal of Pathology</source><year>1991</year><volume>138</volume><fpage>807</fpage><lpage>813</lpage><pub-id pub-id-type="pmid">1707233</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Voskuil</surname><given-names>DW</given-names></name><name><surname>Kampman</surname><given-names>E</given-names></name><name><surname>van Kraats</surname><given-names>AA</given-names></name><name><surname>Balder</surname><given-names>HF</given-names></name><name><surname>van Muijen</surname><given-names>GN</given-names></name><name><surname>Goldbohm</surname><given-names>RA</given-names></name><name><surname>van't Veer</surname><given-names>P</given-names></name></person-group><article-title>p53 over-expression and p53 mutations in colon carcinomas: relation to dietary risk factors</article-title><source>Int J Cancer</source><year>1999</year><volume>81</volume><fpage>675</fpage><lpage>681</lpage><pub-id pub-id-type="pmid">10328215</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1097-0215(19990531)81:5&#x0003c;675::AID-IJC1&#x0003e;3.0.CO;2-6</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tsuda</surname><given-names>H</given-names></name><name><surname>Hirohashi</surname><given-names>S</given-names></name></person-group><article-title>Association among p53 gene mutation, nuclear accumulation of the p53 protein and aggressive phenotypes in breast cancer.</article-title><source>International Journal of Cancer</source><year>1994</year><volume>57</volume><fpage>498</fpage><lpage>503</lpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Iggo</surname><given-names>R</given-names></name><name><surname>Gatter</surname><given-names>K</given-names></name><name><surname>Barter</surname><given-names>J</given-names></name><name><surname>Lane</surname><given-nam