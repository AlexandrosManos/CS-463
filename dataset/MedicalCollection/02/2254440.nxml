id pub-id-type="pmid">15231375</pub-id><pub-id pub-id-type="doi">10.1016/j.ehj.2004.05.006</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Augustin</surname><given-names>T</given-names></name></person-group><article-title>An exact corrected log-likelihood function for Cox's proportional hazards model under measurement error and some extensions</article-title><source>Scandinavian Journal of Statistics</source><year>2004</year><volume>31</volume><fpage>43</fpage><lpage>50</lpage><pub-id pub-id-type="doi">10.1111/j.1467-9469.2004.00371.x</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Verweij</surname><given-names>PJM</given-names></name><name><surname>van Houwelingen</surname><given-names>HC</given-names></name></person-group><article-title>Penalized likelihood in Cox regression</article-title><source>Stat Med</source><year>1994</year><volume>13</volume><fpage>2427</fpage><lpage>2436</lpage><pub-id pub-id-type="pmid">7701144</pub-id><pub-id pub-id-type="doi">10.1002/sim.4780132307</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jannot</surname><given-names>AS</given-names></name><name><surname>Essioux</surname><given-names>L</given-names></name><name><surname>Clerget-Darpoux</surname><given-names>F</given-names></name></person-group><article-title>Association in multifactorial traits: how to deal with rare observations?</article-title><source>Hum Hered</source><year>2004</year><volume>58</volume><fpage>73</fpage><lpage>81</lpage><pub-id pub-id-type="pmid">15711087</pub-id><pub-id pub-id-type="doi">10.1159/000083028</pub-id></citation></ref></ref-list></back></article>