ation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>C</given-names></name></person-group><article-title>Identification of mutations that alter the gating of the <italic>Escherichia coli</italic> mechanosensitive channel protein, MscK</article-title><source>Mol Microbiol</source><year>2007</year><volume>64</volume><fpage>560</fpage><lpage>574</lpage><pub-id pub-id-type="pmid">17493135</pub-id></citation></ref></ref-list></back></article>