13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>You</surname><given-names>HJ</given-names></name><name><surname>Woo</surname><given-names>C-H</given-names></name><name><surname>Choi</surname><given-names>E-Y</given-names></name><name><surname>Cho</surname><given-names>S-H</given-names></name><name><surname>Yoo</surname><given-names>YJ</given-names></name><name><surname>Kim</surname><given-names>J-H</given-names></name></person-group><article-title>Roles of Rac and p38 kinase in the activation of cytosolic phospholipase A2 in response to PMA</article-title><source>Biochem. J.</source><year>2005</year><volume>388</volume><fpage>527</fpage><lpage>535</lpage><pub-id pub-id-type="pmid">15689183</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lin</surname><given-names>L-L</given-names></name><name><surname>Wartmann</surname><given-names>M</given-names></name><name><surname>Lin</surname><given-names>AY</given-names></name><name><surname>Knopf</surname><given-names>JL</given-names></name><name><surname>Seth</surname><given-names>A</given-names></name><name><surname>Davis</surname><given-names>RJ</given-names></name></person-group><article-title>cPLA2 is phosphorylated and activated by MAP kinase</article-title><source>Cell</source><year>1993</year><volume>72</volume><fpage>269</fpage><lpage>278</lpage><pub-id pub-id-type="pmid">8381049</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hefner</surname><given-names>Y</given-names></name><name><surname>Borsch-Haubold</surname><given-names>AG</given-names></name><name><surname>Murakami</surname><given-names>M</given-names></name><name><surname>Wilde</surname><given-names>JI</given-names></name><name><surname>Pasquet</surname><g