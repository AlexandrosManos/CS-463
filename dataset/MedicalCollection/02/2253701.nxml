ring</article-title><source>Int J Gynaecol Obstet</source><year>1987</year><volume>25</volume><fpage>159</fpage><lpage>67</lpage></citation></ref><ref id="b9"><label>9</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cunningham</surname><given-names>G</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Seils</surname><given-names>A</given-names></name></person-group><article-title>Induction and augmentation of labour</article-title><source>Williams Obstetrics</source><year>2001</year><edition>21</edition><publisher-loc>USA</publisher-loc><publisher-name>McGraw-Hill Companies</publisher-name><fpage>469</fpage><lpage>79</lpage></citation></ref><ref id="b10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Miksovsky</surname><given-names>P</given-names></name></person-group><article-title>Obstetric vacuum extraction: state of the art in the new millennium</article-title><source>Obstet Gynecol Surv</source><year>2001</year><volume>56</volume><fpage>736</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">11711908</pub-id></citation></ref><ref id="b11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sadan</surname><given-names>O</given-names></name><etal/></person-group><article-title>What to do after a failed attempt of vacuum delivery?</article-title><source>Eur J Obstet Gynecol Reprod Biol</source><year>2003</year><volume>107</volume><fpage>151</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">12648860</pub-id></citation></ref><ref id="b12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martel</surname><given-names>MJ</given-names></name></person-group><article-title>Guidelines for vaginal birth after previous caesarean birth</article-title><source>J Obstet Gynaecol Can</source><year>2005</year><volume>27</volume>