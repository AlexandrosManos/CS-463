align="center" valign="top" charoff="50">0.69</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="12" align="left" valign="top" charoff="50"><italic>Use of PMH</italic><sup>e</sup></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Ever</td><td align="center" valign="top" charoff="50">446</td><td align="center" valign="top" charoff="50">117</td><td align="center" valign="top" charoff="50">1.00</td><td align="center" valign="top" charoff="50">133</td><td align="center" valign="top" charoff="50">0.90 (0.68&#x02013;1.19)</td><td align="center" valign="top" charoff="50">119</td><td align="center" valign="top" charoff="50">0.83 (0.59&#x02013;1.17)</td><td align="center" valign="top" charoff="50">77</td><td align="center" valign="top" charoff="50">0.64 (0.42&#x02013;0.99)</td><td align="center" valign="top" charoff="50">0.042</td><td align="center" valign="top" charoff="50">0.010</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Never</td><td align="center" valign="top" charoff="50">528</td><td align="center" valign="top" charoff="50">139</td><td align="center" valign="top" charoff="50">1.00</td><td align="center" valign="top" charoff="50">109</td><td align="center" valign="top" charoff="50">0.80 (0.61&#x02013