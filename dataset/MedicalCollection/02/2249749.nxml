name><surname>Drossman</surname><given-names>DA</given-names></name></person-group><article-title>Presidential address: Gastrointestinal illness and the biopsychosocial model</article-title><source>Psychosom Med</source><year>1998</year><volume>60</volume><fpage>258</fpage><lpage>67</lpage><pub-id pub-id-type="pmid">9625212</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Naliboff</surname><given-names>BD</given-names></name><name><surname>Munakata</surname><given-names>J</given-names></name><name><surname>Chang</surname><given-names>L</given-names></name><name><surname>Mayer</surname><given-names>EA</given-names></name></person-group><article-title>Toward a biobehavioral model of visceral hypersensitivity in irritable bowel syndrome</article-title><source>J Psychosom Res</source><year>1998</year><volume>45</volume><fpage>485</fpage><lpage>92</lpage><pub-id pub-id-type="pmid">9859851</pub-id></citation></ref><ref id="B14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mayer</surname><given-names>EA</given-names></name></person-group><article-title>Emerging disease model for functional gastrointestinal disorders</article-title><source>Am J Med</source><year>1999</year><volume>107</volume><fpage>S12</fpage><lpage>S19</lpage></citation></ref><ref id="B15"><label>15</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Damasio</surname><given-names>AR</given-names></name></person-group><source>Descartes' Error.</source><year>1994</year><publisher-loc>New York</publisher-loc><publisher-name>G.P. Putnam's Sons</publisher-name></citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Naliboff</surname><given-names>BD</given-names></name><name><surname>Munakata</surname><given-names>J</given-names></name><name><surname>Fullerton</surname><given-names>S</given-names></name><name><surname>Gracely</surname><given-names>RH</given-names></name><name><surname>Kodner</surname><given-names>A</given-names></name><name><surname>Harraf</surname><given-names>F</given-names></name><etal/></person-group><article-title>Evidence for two distinct perceptual alterations in irritable bowel syndrome</article-title><source>Gut</source><year>1997</year><volume>41</volume><fpage>505</fpage><lpage>12</lpage><pub-id pub-id-type="pmid">9391250</pub-id></citation></ref><ref id="B17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tillisch</surname><given-names>K</given-names></name><name><surname>Mayer</surname><given-names>EA</given-names></name><name><surname>Labus</surname><given-names>JS</given-names></name><name><surname>Stains</surname><given-names>J</given-names></name><name><surname>Chang</surname><given-names>L</given-names></name><name><surname>Naliboff</surname><given-names>BD</given-names></name></person-group><article-title>Sex-specific alterations in autonomic function among patients with irritable bowel syndrome</article-title><source>Gut</source><year>2005</year><volume>54</volume><fpage>1396</fpage><lpage>401</lpage><pub-id pub-id-type="pmid">15923667</pub-id></citation></ref><ref id="B18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Labus</surname><given-names>J</given-names></name><name><surname>Bolus</surname><given-names>R</given-names></name><name><surname>Chang</surname><given-names>L</given-names></name><name><surname>Wiklund</surname><given-names>I</given-names></name><name><surname>Naesdal</surname><given-names>J</given-names></name><name><surname>Mayer</surname><given-names>E</given-names></name><etal/></person-group><article-title>The visceral sensitivity index: Development and validation of a gastrointestinal symptom-specific anxiety scale</a