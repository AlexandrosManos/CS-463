e="journal"><person-group person-group-type="author"><name><surname>Cai</surname><given-names>G</given-names></name><name><surname>Zhu</surname><given-names>W</given-names></name><name><surname>Ma</surname><given-names>D</given-names></name></person-group><source>Tetrahedron</source><year>2006</year><volume>62</volume><fpage>5697</fpage><lpage>5708</lpage><comment>For another approach to the synthesis of quinolizidines and related systems via enaminones, and references cited therein.</comment><pub-id pub-id-type="doi">10.1016/j.tet.2006.03.068</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Davies</surname><given-names>SG</given-names></name><name><surname>Ichihara</surname><given-names>O</given-names></name></person-group><source>Tetrahedron: Asymmetry</source><year>1991</year><volume>2</volume><fpage>183</fpage><lpage>186</lpage><pub-id pub-id-type="doi">10.1016/S0957-4166(00)82354-X</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Costello</surname><given-names>JF</given-names></name><name><surname>Davies</surname><given-names>SG</given-names></name><name><surname>Ichihara</surname><given-names>O</given-names></name></person-group><source>Tetrahedron: Asymmetry</source><year>1994</year><volume>5</volume><fpage>1999</fpage><lpage>2008</lpage><pub-id pub-id-type="doi">10.1016/S0957-4166(00)86275-8</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roth</surname><given-names>M</given-names></name><name><surname>Dubs</surname><given-names>P</given-names></name><name><surname>G&#x000f6;tschi</surname><given-names>E</given-names></name><name><surname>Eschenmoser</surname><given-names>A</given-names></name></person-group><source>Helv Chim Acta</source><year>1971</year><volume>54</volume><fpage>710</fpage><lpage>734</lpage><pub-id pub-id-type="doi">10.1002/hlca.19710540229</pub-id></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Shiosaki</surname><given-names>K</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Trost BM</surname></name></person-group><article-title>The Eschenmoser coupling reaction</article-title><source>Comprehensive Organic Synthesis</source><year>1991</year><volume>2</volume><publisher-name>Oxford: Pergamon Press</publisher-name><fpage>865</fpage><lpage>892</lpage></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Holmes</surname><given-names>AB</given-names></name><name><surname>Smith</surname><given-names>AL</given-names></name><name><surname>Williams</surname><given-names>SF</given-names></name><name><surname>Hughes</surname><given-names>LR</given-names></name><name><surname>Lidert</surname><given-names>Z</given-names></name><name><surname>Swithenbank</surname><given-names>C</given-names></name></person-group><source>J Org Chem</source><year>1991</year><volume>56</volume><fpage>1393</fpage><lpage>1405</lpage><pub-id pub-id-type="doi">10.1021/jo00004a012</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Covert</surname><given-names>LW</given-names></name><name><surname>Adkins</surname><given-names>H</given-names></name></person-group><source>J Am Chem Soc</source><year>1932</year><volume>54</volume><fpage>4116</fpage><lpage>4117</lpage><pub-id pub-id-type="doi">10.1021/ja01349a510</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bohlmann</surname><given-names>F</given-names></name></person-group><source>Chem Ber</source><year>1985</year><volume>91</volume><fpage>2157</fpage><lpage>2167</lpage><pub-id pub-id-type="doi">10.1002/cber.19580911023</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bagnall</surname><given-names>WH</given-names></name><name><surname>Goodings</surname><given-names>EP</given-names></name><name><surname>Wilson</surname><given-names>CL</given-names></name></person-group><source>J Am Chem Soc</source><year>1951</year><volume>73</volume><fpage>4794</fpage><lpage>4798</lpage><pub-id pub-id-type="doi">10.1021/ja01154a094</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Collman</surname><given-names>JP</given-names></name><name><surname>Groh</surname><given-names>SE</given-names></name></person-group><source>J Am Chem Soc</source><year>1982</year><volume>104</volume><fpage>1391</fpage><lpage>1403</lpage><pub-id pub-id-type="doi">10.1021/ja00369a041</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garegg</surname><given-names>PJ</given-names></name><name><surname>Samuelsson</surname><given-names>B</given-names></name></person-group><source>J Chem Soc, Perkin Trans 1</source><year>1980</year><fpage>2866</fpage><lpage>2869</lpage><pub-id pub-id-type="doi">10.1039/p19800002866</pub-id></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wenkert</surname><given-names>E</given-names></name><name><surname>Chauncy</surname><given-names>B</given-names></name><name><surname>Dave</surname><given-names>KG</given-names></name><name><surname>Jeffcoat</surname><given-names>AR</given-names></name><name><surname>Schell</surname><given-names>FM</given-names></name><name><surname>Schenk</surname><given-names>HP</given-names></name></person-group><source>J Am Chem Soc</source><year>1973</year><volume>95</volume><fpage>8427</fpage><lpage>8436</lpage><pub-id pub-id-type="doi">10.1021/ja00806a038</pub-id></citation></ref><ref id="B31"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Tourw&#x000e9;</surname><given-names>D</given-names></name><name><surname>van Binst</surname><given-names>G</given-names></name></person-group><source>Heterocycles</source><year>1978</year><volume>9</volume><fpage>507</fpage><lpage>533</lpage></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Davies</surname><given-names>SG</given-names></name><name><surname>Smith</surname><given-names>AD</given-names></name><name><surname>Price</surname><given-names>PD</given-names></name></person-group><source>Tetrahedron: Asymmetry</source><year>2006</year><volume>16</volume><fpage>2833</fpage><lpage>2891</lpage><pub-id pub-id-type="doi">10.1016/j.tetasy.2005.08.006</pub-id></citation></ref></ref-list></back></article>