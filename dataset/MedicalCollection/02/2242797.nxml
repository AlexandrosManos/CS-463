 id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berridge</surname><given-names>MJ</given-names></name><name><surname>Bootman</surname><given-names>MD</given-names></name><name><surname>Roderick</surname><given-names>HL</given-names></name></person-group><article-title>Calcium signalling: dynamics, homeostasis and remodelling</article-title><source>Nat Rev Mol Cell Biol</source><year>2003</year><volume>4</volume><fpage>517</fpage><lpage>529</lpage><pub-id pub-id-type="pmid">12838335</pub-id><pub-id pub-id-type="doi">10.1038/nrm1155</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berridge</surname><given-names>MJ</given-names></name></person-group><article-title>Calcium signal transduction and cellular control mechanisms</article-title><source>Biochim Biophys Acta</source><year>2004</year><volume>1742</volume><fpage>3</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15590051</pub-id><pub-id pub-id-type="doi">10.1016/j.bbamcr.2004.08.012</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berridge</surname><given-names>MJ</given-names></name></person-group><article-title>The versatility and complexity of calcium signalling</article-title><source>Novartis Found Symp</source><year>2001</year><volume>239</volume><fpage>52</fpage><lpage>64; discussion 64-7, 150-9</lpage><pub-id pub-id-type="pmid">11529316</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chin</surname><given-names>D</given-names></name><name><surname>Means</surname><given-names>AR</given-names></name></person-group><article-title>Calmodulin: a prototypical calcium sensor</article-title><source>Trends Cell Biol</source><year>2000</year><volume>10</volume><fpage>322</fpage><lpage>328</lpage><pub-id pub-id-type="pmid">10884684</