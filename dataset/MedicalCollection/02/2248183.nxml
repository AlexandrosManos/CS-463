me><surname>Santos</surname><given-names>H</given-names></name></person-group><article-title>Protein stabilisation by compatible solutes: effect of mannosylglycerate on unfolding thermodynamics and activity of ribonuclease A</article-title><source>Chembiochem</source><year>2003</year><volume>4</volume><fpage>734</fpage><lpage>741</lpage><pub-id pub-id-type="pmid">12898624</pub-id><pub-id pub-id-type="doi">10.1002/cbic.200300574</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Faria</surname><given-names>TQ</given-names></name><name><surname>Lima</surname><given-names>JC</given-names></name><name><surname>Bastos</surname><given-names>M</given-names></name><name><surname>Ma&#x000e7;anita</surname><given-names>AL</given-names></name><name><surname>Santos</surname><given-names>H</given-names></name></person-group><article-title>Protein stabilization by osmolytes from hyperthermophiles: effect of mannosylglycerate on the thermal unfolding of recombinant nuclease a from Staphylococcus aureus studied by picosecond time-resolved fluorescence and calorimetry</article-title><source>J Biol Chem</source><year>2004</year><volume>279</volume><fpage>48680</fpage><lpage>48691</lpage><pub-id pub-id-type="pmid">15347691</pub-id><pub-id pub-id-type="doi">10.1074/jbc.M408806200</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lamosa</surname><given-names>P</given-names></name><name><surname>Burke</surname><given-names>A</given-names></name><name><surname>Peist</surname><given-names>R</given-names></name><name><surname>Huber</surname><given-names>R</given-names></name><name><surname>Liu</surname><given-names>MY</given-names></name><name><surname>Silva</surname><given-names>G</given-names></name><name><surname>Rodrigues-Pousada</surname><given-names>C</given-names></name><name><surname>LeGall</surname><given-names>J</given-names><