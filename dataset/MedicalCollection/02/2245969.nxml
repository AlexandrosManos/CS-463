lpage>96</lpage><pub-id pub-id-type="pmid">17079137</pub-id><pub-id pub-id-type="doi">10.1016/j.jsbmb.2006.07.010</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ulloa-Aguirre</surname><given-names>A</given-names></name><name><surname>August</surname><given-names>AM</given-names></name><name><surname>Golos</surname><given-names>TG</given-names></name><name><surname>Kao</surname><given-names>LC</given-names></name><name><surname>Sakuragi</surname><given-names>N</given-names></name><name><surname>Kliman</surname><given-names>HJ</given-names></name><name><surname>Strauss</surname><given-names>JF</given-names><suffix>3rd</suffix></name></person-group><article-title>8-Bromo-adenosine 3',5'-monophosphate regulates expression of chorionic gonadotropin and fibronectin in human cytotrophoblasts</article-title><source>J Clin Endocrinol Metab</source><year>1987</year><volume>64</volume><fpage>1002</fpage><lpage>1009</lpage><pub-id pub-id-type="pmid">2435752</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jameson</surname><given-names>JL</given-names></name><name><surname>Lindell</surname><given-names>CM</given-names></name></person-group><article-title>Isolation and characterization of the human chorionic gonadotropin beta subunit (CG beta) gene cluster: regulation of transcriptionally active CG beta gene by cyclic AMP</article-title><source>Mol Cell Biol</source><year>1988</year><volume>8</volume><fpage>5100</fpage><lpage>5107</lpage><pub-id pub-id-type="pmid">2468994</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Santillan</surname><given-names>GE</given-names></name><name><surname>Boland</surname><given-names>RL</given-names></name></person-group><article-title>Studies suggesting the participation of protein kinase A in 1, 25(OH)2-vit