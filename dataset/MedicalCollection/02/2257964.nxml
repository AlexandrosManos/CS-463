><surname>Beasley-Topliffe</surname><given-names>LK</given-names></name><name><surname>Tesini</surname><given-names>BL</given-names></name><name><surname>Lazzaroni</surname><given-names>JC</given-names></name><name><surname>Fenton</surname><given-names>MJ</given-names></name><name><surname>Hellman</surname><given-names>J</given-names></name></person-group><article-title>Bacterial peptidoglycan-associated lipoprotein: a naturally occurring toll-like receptor 2 agonist that is shed into serum and has synergy with lipopolysaccharide</article-title><source>J Infect Dis</source><year>2005</year><volume>191</volume><fpage>939</fpage><lpage>948</lpage><pub-id pub-id-type="pmid">15717270</pub-id><pub-id pub-id-type="doi">10.1086/427815</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zhu</surname><given-names>X</given-names></name><name><surname>Bagchi</surname><given-names>A</given-names></name><name><surname>Zhao</surname><given-names>H</given-names></name><name><surname>Kirschning</surname><given-names>CJ</given-names></name><name><surname>Hajjar</surname><given-names>RJ</given-names></name><name><surname>Chao</surname><given-names>W</given-names></name><name><surname>Hellman</surname><given-names>J</given-names></name><name><surname>Schmidt</surname><given-names>U</given-names></name></person-group><article-title>Toll-like receptor 2 activation by bacterial peptidoglycan-associated lipoprotein activates cardiomyocyte inflammation and contractile dysfunction</article-title><source>Crit Care Med</source><year>2007</year><volume>35</volume><fpage>886</fpage><lpage>892</lpage><pub-id pub-id-type="pmid">17255871</pub-id><pub-id pub-id-type="doi">10.1097/01.CCM.0000256723.37586.A2</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burnens</surname><given-names>A</given-names></name><name><surname>Stucki</surname><given-na