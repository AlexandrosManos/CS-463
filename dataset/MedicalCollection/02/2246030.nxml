="1" colspan="1">Atopic dermatitis</td><td align="center" rowspan="1" colspan="1">1(1)</td><td align="center" rowspan="1" colspan="1">0</td><td align="center" rowspan="1" colspan="1">1 (2.1)</td><td align="center" rowspan="1" colspan="1">1 (2.3)</td></tr></tbody></table><table-wrap-foot><fn id="TF1"><p>*<inline-formula><mml:math id="M13"><mml:mrow><mml:mi>P</mml:mi><mml:mo>&#x0003c;</mml:mo><mml:mn>.05</mml:mn></mml:mrow></mml:math></inline-formula>.</p></fn></table-wrap-foot></table-wrap><table-wrap id="tab2" position="float"><label>Table 2</label><caption><p>Signs and symptoms associated with angioedema.</p></caption><table frame="hsides" rules="groups"><thead><tr><th rowspan="2" colspan="1"> Symptoms,number (%) </th><th align="center" rowspan="1" colspan="1">Angioedema total (<inline-formula><mml:math id="M14"><mml:mrow><mml:mi>n</mml:mi><mml:mo>=</mml:mo><mml:mn>105</mml:mn></mml:mrow></mml:math></inline-formula>)</th><th align="center" rowspan="1" colspan="1">Angioedema without urticaria   (<inline-formula><mml:math id="M15"><mml:mrow><mml:mi>n</mml:mi><mml:mo>=</mml:mo><mml:mn>55</mml:mn></mml:mrow></mml:math></inline-formula>)</th><th align="center" rowspan="1" colspan="1">Angioedema with urticaria (<inline-formula><mml:math id="M16"><mml:mrow><mml:mi>n</mml:mi><mml:mo>=</mml:mo><mml:mn>50</mml:mn></mml:mrow></mml:math></inline-formula>)</th><th align="center" rowspan="1" colspan="1">Angioedema with systemic symptoms (<inline-formula><mml:math id="M17"><mml:mrow><mml:mi>n</mml:mi><mml:mo>=</mml:mo><mml:mn>45</mml:mn></mml:mrow></mml:math></inline-formula>)</th></tr></thead><tbody><tr><td rowspan="1" colspan="1"><italic>Urticaria</italic></td><td align="center" rowspan="1" colspan="1">50(47.6)</td><td align="center" rowspan="1" colspan="1">0</td><td align="center" rowspan="1" colspan="1">50 (100)</td><td align="center" rowspan="1" colspan="1">17 (37.8)</td></tr><tr><td rowspan="1" colspan="1"><italic>Itchy skin</italic></td><td align="center" rowspan="1" colsp