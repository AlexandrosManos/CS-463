rticle-title>Energy-Intake, Physical-Activity and Body-Weight - a Simulation-Model</article-title><source>British Journal of Nutrition</source><year>1995</year><volume>73</volume><fpage>337</fpage><lpage>347</lpage><pub-id pub-id-type="pmid">7766558</pub-id><pub-id pub-id-type="doi">10.1079/BJN19950037</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schwartz</surname><given-names>KV</given-names></name></person-group><article-title>&#x0201c;Spot&#x0201d; Reduction of Fat</article-title><source>Annals of Internal Medicine</source><year>1971</year><volume>75</volume><fpage>316</fpage><pub-id pub-id-type="pmid">5558659</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Okura</surname><given-names>T</given-names></name><name><surname>Nakata</surname><given-names>Y</given-names></name><name><surname>Lee</surname><given-names>DJ</given-names></name><name><surname>Ohkawara</surname><given-names>K</given-names></name><name><surname>Tanaka</surname><given-names>K</given-names></name></person-group><article-title>Effects of aerobic exercise and obesity phenotype on abdominal fat reduction in response to weight loss</article-title><source>International Journal of Obesity</source><year>2005</year><volume>29</volume><fpage>1259</fpage><lpage>1266</lpage><pub-id pub-id-type="pmid">15925951</pub-id><pub-id pub-id-type="doi">10.1038/sj.ijo.0803013</pub-id></citation></ref></ref-list></back></article>