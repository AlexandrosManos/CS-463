l Soc Washington</source><year>1977</year><volume>89</volume><fpage>667</fpage><lpage>688</lpage></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>de Muizon</surname><given-names>C</given-names></name></person-group><article-title>Phocid phylogeny and dispersal</article-title><source>Ann S Afr Mus</source><year>1982</year><volume>89</volume><fpage>175</fpage><lpage>213</lpage></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wyss</surname><given-names>AR</given-names></name></person-group><article-title>Evidence from flipper structure for a single origin of pinnipeds</article-title><source>Nature</source><year>1988</year><volume>334</volume><fpage>427</fpage><lpage>428</lpage><pub-id pub-id-type="doi">10.1038/334427a0</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bininda-Emonds</surname><given-names>ORP</given-names></name><name><surname>Gittleman</surname><given-names>JL</given-names></name><name><surname>Purvis</surname><given-names>A</given-names></name></person-group><article-title>Building large trees by combining phylogenetic information: a complete phylogeny of the extant Carnivora (Mammalia)</article-title><source>Biol Rev</source><year>1999</year><volume>74</volume><fpage>143</fpage><lpage>175</lpage><pub-id pub-id-type="pmid">10396181</pub-id><pub-id pub-id-type="doi">10.1017/S0006323199005307</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fyler</surname><given-names>CA</given-names></name><name><surname>Reeder</surname><given-names>TW</given-names></name><name><surname>Berta</surname><given-names>A</given-names></name><name><surname>Antonelis</surname><given-names>G</given-names></name><name><surname>Aguilar</surname><given-names>A</given-names></name><n