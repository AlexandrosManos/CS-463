 alveolar recruitment</article-title><source>Anesthesiology</source><year>2003</year><volume>99</volume><fpage>2</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">12826832</pub-id><pub-id pub-id-type="doi">10.1097/00000542-200307000-00003</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berggren</surname><given-names>P</given-names></name><name><surname>Lachmann</surname><given-names>B</given-names></name><name><surname>Curstedt</surname><given-names>T</given-names></name><name><surname>Grossmann</surname><given-names>G</given-names></name><name><surname>Robertson</surname><given-names>B</given-names></name></person-group><article-title>Gas exchange and lung morphology after surfactant replacement in experimental adult respiratory distress syndrome induced by repeated lung lavage</article-title><source>Acta Anaesthesiol Scand</source><year>1986</year><volume>30</volume><fpage>321</fpage><lpage>328</lpage><pub-id pub-id-type="pmid">3090844</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hafner</surname><given-names>D</given-names></name><name><surname>Germann</surname><given-names>PG</given-names></name><name><surname>Hauschke</surname><given-names>D</given-names></name></person-group><article-title>Effects of rSP-C surfactant on oxygenation and histology in a rat-lung-lavage model of acute lung injury</article-title><source>Am J Respir Crit Care Med</source><year>1998</year><volume>158</volume><fpage>270</fpage><lpage>278</lpage><pub-id pub-id-type="pmid">9655740</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Steinberg</surname><given-names>J</given-names></name><name><surname>Schiller</surname><given-names>HJ</given-names></name><name><surname>Halter</surname><given-names>JM</given-names></name><name><surname>Gatto</surname><g