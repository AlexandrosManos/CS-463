 citation-type="other"><source>Disease Prevention and Health Promotion Services Act, 42 USC &#x000a7;3030</source></citation></ref><ref id="B21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jemal</surname><given-names>A</given-names></name><name><surname>Murray</surname><given-names>T</given-names></name><name><surname>Ward</surname><given-names>E</given-names></name><name><surname>Samuels</surname><given-names>A</given-names></name><name><surname>Tiwari</surname><given-names>RC</given-names></name><name><surname>Ghafoor</surname><given-names>A</given-names></name><etal/></person-group><volume>55</volume><issue>1</issue><year>2005</year><fpage>10</fpage><lpage>30</lpage><article-title>Cancer statistics, 2005</article-title><source>CA Cancer J Clin</source><comment>[Published erratum in: CA Cancer J Clin 2005;55(4):259]</comment><pub-id pub-id-type="pmid">15661684</pub-id></citation></ref><ref id="B22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cai</surname><given-names>L</given-names></name><name><surname>Uchiyama</surname><given-names>H</given-names></name><name><surname>Yanagisawa</surname><given-names>S</given-names></name><name><surname>Kamae</surname><given-names>I</given-names></name></person-group><volume>52</volume><issue>3-4</issue><year>2006</year><fpage>97</fpage><lpage>109</lpage><article-title>Cost-effectiveness analysis of influenza and pneumococcal vaccinations among elderly people in Japan</article-title><source>Kobe J Med Sci</source><pub-id pub-id-type="pmid">16855372</pub-id></citation></ref><ref id="B23"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weaver</surname><given-names>M</given-names></name><name><surname>Krieger</surname><given-names>J</given-names></name><name><surname>Castorina</surname><given-names>J</given-names></name><name><surname>Walls</surname>