 id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bair</surname><given-names>E</given-names></name><name><surname>Hastie</surname><given-names>T</given-names></name><name><surname>Paul</surname><given-names>D</given-names></name><name><surname>Tibshirani</surname><given-names>R</given-names></name></person-group><article-title>Prediction by supervised principal components</article-title><source>JASA</source><year>2006</year><volume>101</volume><fpage>119</fpage><lpage>137</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>de Brevern</surname><given-names>AG</given-names></name><name><surname>Hazout</surname><given-names>S</given-names></name><name><surname>Malpertuy</surname><given-names>A</given-names></name></person-group><article-title>Influence of microarrays experiments missing values on the stability of gene groups by hierarchical clustering</article-title><source>BMC Bioinformatics</source><year>2004</year><volume>5</volume><fpage>114</fpage><pub-id pub-id-type="pmid">15324460</pub-id><pub-id pub-id-type="doi">10.1186/1471-2105-5-114</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Scheel</surname><given-names>I</given-names></name><name><surname>Aldrin</surname><given-names>M</given-names></name><name><surname>Glad</surname><given-names>IK</given-names></name><name><surname>Sorum</surname><given-names>R</given-names></name><name><surname>Lyng</surname><given-names>H</given-names></name><name><surname>Frigessi</surname><given-names>A</given-names></name></person-group><article-title>The influence of missing value imputation on detection of differentially expressed genes from microarray data</article-title><source>Bioinformatics</source><year>2005</year><volume>21</volume><fpage>4272</fpage><lpage>4279</lpage><pub-id pub-id-type="pmid">16216830</pub-id><pub