b-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cunningham</surname><given-names>SJ</given-names></name><name><surname>Sculpher</surname><given-names>M</given-names></name><name><surname>Sassi</surname><given-names>F</given-names></name><name><surname>Manca</surname><given-names>A</given-names></name></person-group><article-title>A cost-utility analysis of patients undergoing orthognathic treatment for the management of dentofacial disharmony</article-title><source>Br J Oral Maxillofac Surg</source><year>2003</year><volume>41</volume><fpage>32</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">12576038</pub-id><pub-id pub-id-type="doi">10.1016/S0266-4356(02)00285-1</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mileman</surname><given-names>PA</given-names></name><name><surname>van den Hout</surname><given-names>WB</given-names></name></person-group><article-title>Preferences for oral health states: effect on prescribing periapical radiographs</article-title><source>Dentomaxillofac Radiol</source><year>2003</year><volume>32</volume><fpage>401</fpage><lpage>407</lpage><pub-id pub-id-type="pmid">15070844</pub-id><pub-id pub-id-type="doi">10.1259/dmfr/15454473</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jacobson</surname><given-names>JJ</given-names></name><name><surname>Maxson</surname><given-names>BB</given-names></name><name><surname>Mays</surname><given-names>K</given-names></name><name><surname>Kowalski</surname><given-names>CJ</given-names></name></person-group><article-title>A utility analysis of dental implants</article-title><source>Int J Oral Maxillofac Implants</source><year>1992</year><volume>7</volume><fpage>381</fpage><lpage>388</lpage><pub-id pub-id-type="pmid">1289265</pub-id></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bowling</surname><given-names>A</given-names></name></person-group><source>Research Methods in Health &#x02013; Investigating health and health services</source><year>2002</year><edition>2</edition><publisher-name>Maidenhead UK: Open University Press</publisher-name></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matthews</surname><given-names>DC</given-names></name><name><surname>Birch</surname><given-names>S</given-names></name><name><surname>Gafni</surname><given-names>A</given-names></name><name><surname>DiCenso</surname><given-names>A</given-names></name></person-group><article-title>Willingness to pay for periodontal therapy: development and testing of an instrument</article-title><source>J Public Health Dent</source><year>1999</year><volume>59</volume><fpage>44</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">11396044</pub-id><pub-id pub-id-type="doi">10.1111/j.1752-7325.1999.tb03234.x</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matthews</surname><given-names>D</given-names></name><name><surname>Rocchi</surname><given-names>A</given-names></name><name><surname>Gafni</surname><given-names>A</given-names></name></person-group><article-title>Putting your money where your mouth is: willingness to pay for dental gel</article-title><source>Pharmacoeconomics</source><year>2002</year><volume>20</volume><fpage>245</fpage><lpage>255</lpage><pub-id pub-id-type="pmid">11950381</pub-id><pub-id pub-id-type="doi">10.2165/00019053-200220040-00003</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matthews</surname><given-names>D</given-names></name><name><surname>Rocchi</surname><given-names>A</given-names></name><name><surname>Wang</surname><given-names>EC</given-names></name><name><surname>Gafni</surname><given-names>A</given-names></name></person-group><article-title>Use of an interactive tool to assess patients' willingness-to-pay</article-title><source>J Biomed Inform</source><year>2001</year><volume>34</volume><fpage>311</fpage><lpage>320</lpage><pub-id pub-id-type="pmid">12123150</pub-id><pub-id pub-id-type="doi">10.1006/jbin.2002.1032</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tamaki</surname><given-names>Y</given-names></name><name><surname>Nomura</surname><given-names>Y</given-names></name><name><surname>Teraoka</surname><given-names>K</given-names></name><name><surname>Nishikahara</surname><given-names>F</given-names></name><name><surname>Motegi</surname><given-names>M</given-names></name><name><surname>Tsurumoto</surname><given-names>A</given-names></name><etal></etal></person-group><article-title>Characteristics and willingness of patients to pay for regular dental check-ups in Japan</article-title><source>J Oral Sci</source><year>2004</year><volume>46</volume><fpage>127</fpage><lpage>133</lpage><pub-id pub-id-type="pmid">15287547</pub-id><pub-id pub-id-type="doi">10.2334/josnusd.46.127</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dixon</surname><given-names>S</given-names></name><name><surname>Shackley</surname><given-names>P</given-names></name></person-group><article-title>Estimating the benefits of community water fluoridation using the willingness-to-pay technique: results of a pilot study</article-title><source>Community Dent Oral Epidemiol</source><year>1999</year><volume>27</volume><fpage>124</fpage><lpage>129</lpage><pub-id pub-id-type="pmid">10226722</pub-id><pub-id pub-id-type="doi">10.1111/j.1600-0528.1999.tb02001.x</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><na