pub-id-type="pmid">17237055</pub-id></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chakrabarti</surname><given-names>S</given-names></name><name><surname>Manohari</surname><given-names>G</given-names></name><name><surname>Pugalenthi</surname><given-names>G</given-names></name><name><surname>Sowdhamini</surname><given-names>R</given-names></name></person-group><article-title>SSToSS&#x02014;sequence-structural templates of single-member superfamilies</article-title><source>In Silico Biol.</source><year>2006</year><volume>6</volume><fpage>311</fpage><lpage>319</lpage><pub-id pub-id-type="pmid">16922694</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chakrabarti</surname><given-names>S</given-names></name><name><surname>Anand</surname><given-names>AP</given-names></name><name><surname>Bhardwaj</surname><given-names>N</given-names></name><name><surname>Pugalenthi</surname><given-names>G</given-names></name><name><surname>Sowdhamini</surname><given-names>R</given-names></name></person-group><article-title>SCANMOT: searching for similar sequences using a simultaneous scan of multiple sequence motifs</article-title><source>Nucleic Acids Res.</source><year>2005</year><volume>33</volume><fpage>W274</fpage><lpage>W276</lpage><pub-id pub-id-type="pmid">15980468</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chakrabarti</surname><given-names>S</given-names></name><name><surname>Bhardwaj</surname><given-names>N</given-names></name><name><surname>Anand</surname><given-names>PA</given-names></name><name><surname>Sowdhamini</surname><given-names>R</given-names></name></person-group><article-title>Improvement of alignment accuracy utilizing sequential