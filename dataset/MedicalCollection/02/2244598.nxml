<fpage>258</fpage><lpage>264</lpage><pub-id pub-id-type="pmid">2629725</pub-id><pub-id pub-id-type="doi">10.1002/ajmg.1320340228</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Belloni</surname><given-names>E</given-names></name><name><surname>Muenke</surname><given-names>M</given-names></name><name><surname>Roessler</surname><given-names>E</given-names></name><name><surname>Traverso</surname><given-names>G</given-names></name><name><surname>Siegel-Bartelt</surname><given-names>J</given-names></name><name><surname>Frumkin</surname><given-names>A</given-names></name><name><surname>Mitchell</surname><given-names>HF</given-names></name><name><surname>Donis-Keller</surname><given-names>H</given-names></name><name><surname>Helms</surname><given-names>C</given-names></name><name><surname>Hing</surname><given-names>AV</given-names></name><etal></etal></person-group><article-title>Identification of Sonic hedgehog as a candidate gene responsible for holoprosencephaly</article-title><source>Nat Genet</source><year>1996</year><volume>14</volume><fpage>353</fpage><lpage>356</lpage><pub-id pub-id-type="pmid">8896571</pub-id><pub-id pub-id-type="doi">10.1038/ng1196-353</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ahlgren</surname><given-names>SC</given-names></name><name><surname>Bronner-Fraser</surname><given-names>M</given-names></name></person-group><article-title>Inhibition of sonic hedgehog signaling in vivo results in craniofacial neural crest cell death</article-title><source>Curr Biol</source><year>1999</year><volume>9</volume><fpage>1304</fpage><lpage>1314</lpage><pub-id pub-id-type="pmid">10574760</pub-id><pub-id pub-id-type="doi">10.1016/S0960-9822(00)80052-4</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pasquier</surname><giv