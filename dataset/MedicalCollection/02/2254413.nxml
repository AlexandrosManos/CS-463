 pub-id-type="doi">10.1249/01.MSS.0000089339.07610.5F</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Motobe</surname><given-names>M</given-names></name><name><surname>Murase</surname><given-names>N</given-names></name><name><surname>Osada</surname><given-names>T</given-names></name><name><surname>Homma</surname><given-names>T</given-names></name><name><surname>Ueda</surname><given-names>C</given-names></name><name><surname>Nagasawa</surname><given-names>T</given-names></name><name><surname>Kitahara</surname><given-names>A</given-names></name><name><surname>Ichimura</surname><given-names>S</given-names></name><name><surname>Kurosawa</surname><given-names>Y</given-names></name><name><surname>Katsumura</surname><given-names>T</given-names></name><etal></etal></person-group><article-title>Noninvasive monitoring of deterioration in skeletal muscle function with forearm cast immobilization and the prevention of deterioration</article-title><source>Dyn Med</source><year>2004</year><volume>3</volume><fpage>2</fpage><pub-id pub-id-type="pmid">14764213</pub-id><pub-id pub-id-type="doi">10.1186/1476-5918-3-2</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jansson</surname><given-names>E</given-names></name><name><surname>Sylven</surname><given-names>C</given-names></name><name><surname>Nordevang</surname><given-names>E</given-names></name></person-group><article-title>Myoglobin in the quadriceps femoris muscle of competitive cyclists and untrained men</article-title><source>Acta Physiol Scand</source><year>1982</year><volume>114</volume><fpage>627</fpage><lpage>629</lpage><pub-id pub-id-type="pmid">7136792</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chance</surname><given-names>B</given-names></name><name><surname>Dait</surname><give