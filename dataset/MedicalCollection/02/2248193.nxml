<tr><td align="left">CYS169, GLN182</td><td align="left">2</td><td align="left">Unweighted</td><td align="left">0.45</td><td align="left">4.39</td><td align="left">0.0018**</td><td align="left">yes</td><td align="left">6.4</td><td align="left">0.002**</td></tr><tr><td align="left">ILE96, TYR134</td><td align="left">2</td><td align="left">Unweighted</td><td align="left">0.49</td><td align="left">5.96</td><td align="left">0.002**</td><td align="left">yes</td><td align="left">18.27</td><td align="left">0.1768</td></tr><tr><td align="left">ILE81, PHE113</td><td align="left">2</td><td align="left">Unweighted</td><td align="left">0.45</td><td align="left">4.33</td><td align="left">0.0021**</td><td align="left">yes</td><td align="left">16.36</td><td align="left">0.1259</td></tr><tr><td align="left">ASP227, ALA232, GLU235</td><td align="left">3</td><td align="left">Unweighted</td><td align="left">0.48</td><td align="left">1.41</td><td align="left">0.0022**</td><td align="left">yes</td><td align="left">23.49</td><td align="left">0.0949.</td></tr><tr><td align="left">ASP219, VAL223</td><td align="left">2</td><td align="left">Unweighted</td><td align="left">0.46</td><td align="left">3.66</td><td align="left">0.0024**</td><td align="left">yes</td><td align="left">9.4</td><td align="left">0.009**</td></tr><tr><td align="left">HIS63, ARG127, GLN130, ALA209</td><td align="left">4</td><td align="left">Volume</td><td align="left">0.33</td><td align="left">205.12</td><td align="left">0.0032**</td><td align="left">yes</td><td align="left">32.09</td><td align="left">0.2527</td></tr><tr><td align="left">HIS63, GLN130</td><td align="left">2</td><td align="left">Charge</td><td align="left">0.47</td><td align="left">5.36</td><td align="left">0.0035**</td><td align="left">yes</td><td align="left">28.75</td><td align="left">0.5994</td></tr><tr><td align="left">THR222, SER231, ILE238, VAL239</td><td align="left">4</td><td align="left">Charge</td><td align="left">0.71</td><td align="left">0.99