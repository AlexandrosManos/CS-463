 organisms</article-title><source>J Circadian Rhythms</source><year>2005</year><volume>3</volume><fpage>7</fpage><pub-id pub-id-type="pmid">15869714</pub-id><pub-id pub-id-type="doi">10.1186/1740-3391-3-7</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Czeisler</surname><given-names>CA</given-names></name><name><surname>Kronauer</surname><given-names>RE</given-names></name><name><surname>Allan</surname><given-names>JS</given-names></name><name><surname>Duffy</surname><given-names>JF</given-names></name><name><surname>Jewett</surname><given-names>ME</given-names></name><name><surname>Brown</surname><given-names>EN</given-names></name><name><surname>Ronda</surname><given-names>JM</given-names></name></person-group><article-title>Bright light induction of strong (type 0) resetting of the human circadian pacemaker</article-title><source>Science</source><year>1989</year><volume>244</volume><fpage>1328</fpage><lpage>1333</lpage><pub-id pub-id-type="pmid">2734611</pub-id><pub-id pub-id-type="doi">10.1126/science.2734611</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Czeisler</surname><given-names>CA</given-names></name><name><surname>Allan</surname><given-names>JS</given-names></name><name><surname>Strogatz</surname><given-names>SH</given-names></name><name><surname>Ronda</surname><given-names>JM</given-names></name><name><surname>S&#x000e1;nchez</surname><given-names>R</given-names></name><name><surname>R&#x000ed;os</surname><given-names>CD</given-names></name><name><surname>Freitag</surname><given-names>WO</given-names></name><name><surname>Richardson</surname><given-names>GS</given-names></name><name><surname>Kronauer</surname><given-names>RE</given-names></name></person-group><article-title>Bright light resets the human circadian pacemaker independent of the timing of the sleep-wake cycle</article-title><sour