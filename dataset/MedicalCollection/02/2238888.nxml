7"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Burge</surname><given-names>C</given-names></name><name><surname>Karlin</surname><given-names>S</given-names></name></person-group><article-title>Prediction of complete gene structures in human genomic DNA</article-title><source>J. Mol. Biol</source><year>1997</year><volume>268</volume><fpage>78</fpage><lpage>94</lpage><pub-id pub-id-type="pmid">9149143</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sasaki</surname><given-names>T</given-names></name><name><surname>Shimizu</surname><given-names>A</given-names></name><name><surname>Ishikawa</surname><given-names>SK</given-names></name><name><surname>Imai</surname><given-names>S</given-names></name><name><surname>Asakawa</surname><given-names>S</given-names></name><name><surname>Murayama</surname><given-names>Y</given-names></name><name><surname>Khorasani</surname><given-names>MZ</given-names></name><name><surname>Mitani</surname><given-names>H</given-names></name><name><surname>Furutani-Seiki</surname><given-names>M</given-names></name><etal/></person-group><article-title>The DNA sequence of medaka chromosome LG22</article-title><source>Genomics</source><year>2007</year><volume>89</volume><fpage>124</fpage><lpage>133</lpage><pub-id pub-id-type="pmid">17067776</pub-id></element-citation></ref></ref-list></back></article>