ames>KC</given-names></name><name><surname>Dickson</surname><given-names>G</given-names></name><name><surname>Morris</surname><given-names>GE</given-names></name></person-group><article-title>Localization of the DMDL gene-encoded dystrophin-related protein using a panel of nineteen monoclonal antibodies: presence at neuromuscular junctions, in the sarcolemma of dystrophic skeletal muscle, in vascular and other smooth muscles, and in proliferating brain cell lines</article-title><source>J. Cell Biol</source><year>1991</year><volume>115</volume><fpage>1695</fpage><lpage>1700</lpage><pub-id pub-id-type="pmid">1757469</pub-id></element-citation></ref><ref id="B5"><label>5</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ohlendieck</surname><given-names>K</given-names></name><name><surname>Ervasti</surname><given-names>JM</given-names></name><name><surname>Matsumura</surname><given-names>K</given-names></name><name><surname>Kahl</surname><given-names>SD</given-names></name><name><surname>Leveille</surname><given-names>CJ</given-names></name><name><surname>Campbell</surname><given-names>KP</given-names></name></person-group><article-title>Dystrophin-related protein is localized to neuromuscular junctions of adult skeletal muscle</article-title><source>Neuron</source><year>1991</year><volume>7</volume><fpage>499</fpage><lpage>508</lpage><pub-id pub-id-type="pmid">1654951</pub-id></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Phillips</surname><given-names>WD</given-names></name><name><surname>Noakes</surname><given-names>PG</given-names></name><name><surname>Roberds</surname><given-names>SL</given-names></name><name><surname>Campbell</surname><given-names>KP</given-names></name><name><surname>Merlie</surname><given-names>JP</given-names></name></person-group><article-title>Clustering and immobilization of acetylcholine receptors by the 43-kD protein: a possible role for dystrophin-related protein</article-title><source>J. Cell Biol</source><year>1993</year><volume>123</volume><fpage>729</fpage><lpage>740</lpage><pub-id pub-id-type="pmid">8227135</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Miura</surname><given-names>P</given-names></name><name><surname>Jasmin</surname><given-names>BJ</given-names></name></person-group><article-title>Utrophin upregulation for treating Duchenne or Becker muscular dystrophy: how close are we?</article-title><source>Trends Mol. Med</source><year>2006</year><volume>12</volume><fpage>122</fpage><lpage>129</lpage><pub-id pub-id-type="pmid">16443393</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gramolini</surname><given-names>AO</given-names></name><name><surname>Dennis</surname><given-names>CL</given-names></name><name><surname>Tinsley</surname><given-names>JM</given-names></name><name><surname>Robertson</surname><given-names>GS</given-names></name><name><surname>Cartaud</surname><given-names>J</given-names></name><name><surname>Davies</surname><given-names>KE</given-names></name><name><surname>Jasmin</surname><given-names>BJ</given-names></name></person-group><article-title>Local transcriptional control of utrophin expression at the neuromuscular synapse</article-title><source>J. Biol. Chem</source><year>1997</year><volume>272</volume><fpage>8117</fpage><lpage>8120</lpage><pub-id pub-id-type="pmid">9079621</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Perkins</surname><given-names>KJ</given-names></name><name><surname>Burton</surname><given-names>EA</given-names></name><name><surname>Davies</surname><given-names>KE</given-names></name></person-group><article-title>The role of basal and myogenic factors in the transcriptional activation of utrophin promoter A: implications for therapeutic up-regulation in Duchenne muscular dystrophy</article-title><source>Nucleic Acids Res</source><year>2001</year><volume>29</volume><fpage>4843</fpage><lpage>4850</lpage><pub-id pub-id-type="pmid">11726694</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Stocksley</surname><given-names>MA</given-names></name><name><surname>Chakkalakal</surname><given-names>JV</given-names></name><name><surname>Bradford</surname><given-names>A</given-names></name><name><surname>Miura</surname><given-names>P</given-names></name><name><surname>De Repentigny</surname><given-names>Y</given-names></name><name><surname>Kothary</surname><given-names>R</given-names></name><name><surname>Jasmin</surname><given-names>BJ</given-names></name></person-group><article-title>A 1.3 kb promoter fragment confers spatial and temporal expression of utrophin A mRNA in mouse skeletal muscle fibers</article-title><source>Neuromuscul. Disord</source><year>2005</year><volume>15</volume><fpage>437</fpage><lpage>449</lpage><pub-id pub-id-type="pmid">15907291</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Weir</surname><given-names>AP</given-names></name><name><surname>Burton</surname><given-names>EA</given-names></name><name><surname>Harrod</surname><given-names>G</given-names></name><name><surname>Davies</surname><given-names>KE</given-names></name></person-group><article-title>A- and B-utrophin have different expression patterns and are differentially up-regulated in mdx muscle</article-title><source>J. Biol. Chem</source><year>2002</year><volume>277</volume><fpage>45285</fpage><lpage>4529