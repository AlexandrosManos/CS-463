="other"><person-group person-group-type="author"><name><surname>Murray</surname><given-names>CJ</given-names></name><name><surname>Kulkarni</surname><given-names>SC</given-names></name><name><surname>Michaud</surname><given-names>C</given-names></name><name><surname>Tomijima</surname><given-names>N</given-names></name><name><surname>Bulzacchelli</surname><given-names>MT</given-names></name><name><surname>Iandiorio</surname><given-names>TJ</given-names></name><name><surname>Ezzati</surname><given-names>M</given-names></name></person-group><year>2006</year><article-title>Eight Americas: investigating mortality disparities across races, counties, and race-counties in the United States</article-title><source>PLoS Med</source><volume>3</volume><issue>9</issue><elocation-id>e260</elocation-id></citation></ref><ref id="pmed-0050046-b019"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hetzel</surname><given-names>AM</given-names></name></person-group><year>1997</year><source>History and organization of the vital statistics system</source><publisher-loc>Bethesda, MD</publisher-loc><publisher-name>National Center for Health Statistics</publisher-name></citation></ref><ref id="pmed-0050046-b020"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Krieger</surname><given-names>N</given-names></name><name><surname>Williams</surname><given-names>D</given-names></name><name><surname>Moss</surname><given-names>N</given-names></name></person-group><year>1997</year><article-title>Measuring social class in US public health research: concepts, methodologies and guidelines</article-title><source>Annu Rev Public Health</source><volume>18</volume><fpage>341</fpage><lpage>378</lpage><pub-id pub-id-type="pmid">9143723</pub-id></citation></ref><ref id="pmed-0050046-b021"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Singh</surname><given-names>GK</given-names></name></pe