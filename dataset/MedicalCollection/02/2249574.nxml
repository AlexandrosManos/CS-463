27.1987.tb10522.x</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Righard</surname><given-names>L</given-names></name><name><surname>Alade</surname><given-names>MO</given-names></name></person-group><article-title>Effect of delivery room routines on success of first breast-feed</article-title><source>Lancet</source><year>1990</year><volume>336</volume><fpage>1105</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">1977988</pub-id><pub-id pub-id-type="doi">10.1016/0140-6736(90)92579-7</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rowe-Murray</surname><given-names>HJ</given-names></name><name><surname>Fisher</surname><given-names>JRW</given-names></name></person-group><article-title>Baby friendly hospital practices: cesarean section is a persistent barrier to early initiation of breastfeeding</article-title><source>Birth</source><year>2002</year><volume>29</volume><fpage>124</fpage><lpage>131</lpage><pub-id pub-id-type="pmid">12000413</pub-id><pub-id pub-id-type="doi">10.1046/j.1523-536X.2002.00172.x</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dyson</surname><given-names>L</given-names></name><name><surname>McCormick</surname><given-names>F</given-names></name><name><surname>Renfrew</surname><given-names>M</given-names></name></person-group><article-title>Interventions for promoting the initiation of breastfeeding (Cochrane Review)</article-title><source>Cochrane Database Syst Rev</source><year>2005</year><volume>18</volume><fpage>CD001688</fpage><pub-id pub-id-type="pmid">15846621</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Taylor</surname><given-names>PM</given-names></name><name><surname>Maloni</surname><given-names>JA</given-names></name><