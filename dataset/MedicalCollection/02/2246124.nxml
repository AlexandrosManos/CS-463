er-name>San Antonio, TX: Psychological Corporation</publisher-name></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Meulen van der</surname><given-names>BF</given-names></name><name><surname>Ruiter</surname><given-names>SAJ</given-names></name><name><surname>Lutje Spelberg</surname><given-names>HC</given-names></name><name><surname>Smyrkovsky</surname><given-names>M</given-names></name></person-group><source>BSID II-NL</source><year>2005</year><publisher-name>Lisse The Netherlands: Swets &#x00026; Zeitlinger</publisher-name></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Henderson</surname><given-names>SE</given-names></name><name><surname>Sugden</surname><given-names>DA</given-names></name></person-group><source>(Dutch edition by Smits- Engelsman BCM) Movement Assessment Battery for Children</source><year>1998</year><publisher-name>Lisse, The Netherlands: Swets &#x00026; Zeitlinger</publisher-name></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Custers</surname><given-names>JW</given-names></name><name><surname>Wassenberg-Severijnen</surname><given-names>JE</given-names></name><name><surname>Van der Net</surname><given-names>J</given-names></name><name><surname>Vermeer</surname><given-names>A</given-names></name><name><surname>Hart</surname><given-names>HT</given-names></name><name><surname>Helders</surname><given-names>PJM</given-names></name></person-group><article-title>Dutch Adaptation and content validityof the 'Pediatric Evaluation Of Disability Inventory (PEDI)</article-title><source>Disabil Rehabil</source><year>2002</year><volume>24</volume><fpage>250</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">12004970</pub-id><pub-id pub-id-type="doi">10.1080/09638280110076036</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-