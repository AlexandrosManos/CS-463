span="1" colspan="1">0.631</td><td align="left" rowspan="1" colspan="1">1966&#x02013;2000</td></tr><tr><td align="left" rowspan="1" colspan="1">33</td><td align="left" rowspan="1" colspan="1">35</td><td align="left" rowspan="1" colspan="1">CAN FIELD NAT</td><td align="left" rowspan="1" colspan="1">0.69</td><td align="left" rowspan="1" colspan="1">0.40</td><td align="left" rowspan="1" colspan="1">5.8</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">0.073</td><td align="left" rowspan="1" colspan="1">1983&#x02013;1993</td></tr><tr><td align="left" rowspan="1" colspan="1">34</td><td align="left" rowspan="1" colspan="1">16</td><td align="left" rowspan="1" colspan="1">LANDSCAPE URBAN PLAN</td><td align="left" rowspan="1" colspan="1">0.67</td><td align="left" rowspan="1" colspan="1">0.41</td><td align="left" rowspan="1" colspan="1">5.3</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">2.029</td><td align="left" rowspan="1" colspan="1">1985&#x02013;2004</td></tr><tr><td align="left" rowspan="1" colspan="1">35</td><td align="left" rowspan="1" colspan="1">27</td><td align="left" rowspan="1" colspan="1">J SOIL WATER CONSERV</td><td align="left" rowspan="1" colspan="1">0.65</td><td align="left" rowspan="1" colspan="1">0.49</td><td align="left" rowspan="1" colspan="1">7.0</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">0.949</td><td align="left" rowspan="1" colspan="1">1966&#x02013;2002</td></tr><tr><td align="left" rowspan="1" colspan="1">36</td><td align="left" rowspan="1" colspan="1">36</td><td align="left" rowspan="1" colspan="1">NAT HIST</td><td align="left" rowspan="1" colspan="1">-0.32</td><td align="left" rowspan="1" colspan="1">0.44</td><td align="left" rowspan="1" colspan="1">0.3</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">0.059</td><td align="left" rowspan="1" colspan="1">1989&#x02013;2005</td></tr></tbody></table><table-wrap-foot><fn id="nt101"><p>We consider the 36 journals that are primarily classified in the field of ecology according to the ISI. We rank journals according to: (i) the maximization of the multi-class AUC statistic for the steady-state distributions <inline-formula><inline-graphic xlink:href="pone.0001683.e035.jpg" mimetype="image"/></inline-formula> and (ii) the JIF; <italic>&#x00071;&#x00305;</italic> and <italic>&#x003c3;</italic> are the model parameters obtained using <inline-formula><inline-graphic xlink:href="pone.0001683.e036.jpg" mimetype="image"/></inline-formula>; <italic>&#x0006e;&#x00305;</italic> and <italic>Q</italic>2 are the mean and median number of citations in the steady state. We also show the steady-state period.</p></fn></table-wrap-foot></table-wrap><table-wrap id="pone-0001683-t002" position="float"><object-id pub-id-type="doi">10.1371/journal.pone.0001683.t002</object-id><label>Table 2</label><caption><title>Rankings for the field of experimental psychology.</title></caption><graphic id="pone-0001683-t002-2" xlink:href="pone.0001683.t002"/><table frame="hsides" rules="groups" alternate-form-of="pone-0001683-t002-2"><colgroup span="1"><col width="99*" align="left" span="1"/><col width="99*" align="center" span="1"/><col width="99*" align="center" span="1"/><col width="99*" align="center" span="1"/><col width="306*" align="center" span="1"/><col width="48*" align="center" span="1"/><col width="48*" align="center" span="1"/><col width="48*" align="center" span="1"/><col width="48*" align="center" span="1"/></colgroup><thead><tr><td colspan="2" align="left" rowspan="1">Rank</td><td align="left" rowspan="1" colspan="1"/><td colspan="2" align="left" rowspan="1"><inline-formula><inline-graphic xlink:href="pone.0001683.e037.jpg" mimetype="image"/></inline-formula></td><td colspan="2" align="left" rowspan="1">n</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Steady state</td></tr><