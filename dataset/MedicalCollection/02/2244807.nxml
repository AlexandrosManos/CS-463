"1" colspan="1">21</td><td align="left" rowspan="1" colspan="1">J WILDLIFE MANAGE</td><td align="left" rowspan="1" colspan="1">1.19</td><td align="left" rowspan="1" colspan="1">0.34</td><td align="left" rowspan="1" colspan="1">18.3</td><td align="left" rowspan="1" colspan="1">13</td><td align="left" rowspan="1" colspan="1">1.538</td><td align="left" rowspan="1" colspan="1">1984&#x02013;1995</td></tr><tr><td align="left" rowspan="1" colspan="1">21</td><td align="left" rowspan="1" colspan="1">18</td><td align="left" rowspan="1" colspan="1">J CHEM ECOL</td><td align="left" rowspan="1" colspan="1">1.11</td><td align="left" rowspan="1" colspan="1">0.31</td><td align="left" rowspan="1" colspan="1">14.4</td><td align="left" rowspan="1" colspan="1">10</td><td align="left" rowspan="1" colspan="1">1.896</td><td align="left" rowspan="1" colspan="1">1995&#x02013;1998</td></tr><tr><td align="left" rowspan="1" colspan="1">22</td><td align="left" rowspan="1" colspan="1">32</td><td align="left" rowspan="1" colspan="1">AM MIDL NAT</td><td align="left" rowspan="1" colspan="1">1.07</td><td align="left" rowspan="1" colspan="1">0.36</td><td align="left" rowspan="1" colspan="1">14.5</td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">0.667</td><td align="left" rowspan="1" colspan="1">1964&#x02013;1995</td></tr><tr><td align="left" rowspan="1" colspan="1">23</td><td align="left" rowspan="1" colspan="1">26</td><td align="left" rowspan="1" colspan="1">WILDLIFE RES</td><td align="left" rowspan="1" colspan="1">1.05</td><td align="left" rowspan="1" colspan="1">0.32</td><td align="left" rowspan="1" colspan="1">11.6</td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">1.032</td><td align="left" rowspan="1" colspan="1">1990&#x02013;1997</td></tr><tr><td align="left" rowspan="1" colspan="1">24</td><td align="left" rowspan="1" colspan="1">24</td><td align="left" rowspan="1" colspan="1">PEDOBIOLOGIA</td><td align="left" rowspan="1" colspan="1">0.99</td><td align="left" rowspan="1" colspan="1">0.41</td><td align="left" rowspan="1" colspan="1">12.8</td><td align="left" rowspan="1" colspan="1">8</td><td align="left" rowspan="1" colspan="1">1.347</td><td align="left" rowspan="1" colspan="1">1965&#x02013;1997</td></tr><tr><td align="left" rowspan="1" colspan="1">25</td><td align="left" rowspan="1" colspan="1">20</td><td align="left" rowspan="1" colspan="1">AGR ECOSYST ENVIRON</td><td align="left" rowspan="1" colspan="1">0.97</td><td align="left" rowspan="1" colspan="1">0.44</td><td align="left" rowspan="1" colspan="1">11.4</td><td align="left" rowspan="1" colspan="1">7</td><td align="left" rowspan="1" colspan="1">1.832</td><td align="left" rowspan="1" colspan="1">1982&#x02013;2001</td></tr><tr><td align="left" rowspan="1" colspan="1">26</td><td align="left" rowspan="1" colspan="1">19</td><td align="left" rowspan="1" colspan="1">ECOL MODEL</td><td align="left" rowspan="1" colspan="1">0.91</td><td align="left" rowspan="1" colspan="1">0.40</td><td align="left" rowspan="1" colspan="1">11.3</td><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">1.888</td><td align="left" rowspan="1" colspan="1">1977&#x02013;1998</td></tr><tr><td align="left" rowspan="1" colspan="1">27</td><td align="left" rowspan="1" colspan="1">30</td><td align="left" rowspan="1" colspan="1">J RANGE MANAGE</td><td align="left" rowspan="1" colspan="1">0.90</td><td align="left" rowspan="1" colspan="1">0.37</td><td align="left" rowspan="1" colspan="1">9.9</td><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">0.859</td><td align="left" rowspan="1" colspan="1">1966&#x02013;1995</td></tr><tr><td align="left" rowspan="1" colspan="1">28</td><td align="left" rowspan="1" colspan="1">29</td><td align="left" rowspan="1" colspan="1">BIOCHEM SYST ECOL</td><td align="left" rowspan="1" colspan="1">0.89</td><td align="left" rowspan="1" colspan="1">0.36</td><td align="