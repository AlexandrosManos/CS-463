roup person-group-type="author"><name><surname>Kirschner</surname><given-names>KN</given-names></name><name><surname>Woods</surname><given-names>RJ</given-names></name></person-group><article-title>Solvent interactions determine carbohydrate conformation</article-title><source>Proc. Natl Acad. Sci. USA</source><year>2001</year><volume>98</volume><fpage>10541</fpage><lpage>10545</lpage><pub-id pub-id-type="pmid">11526221</pub-id></element-citation></ref><ref id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Basma</surname><given-names>M</given-names></name><name><surname>Sundara</surname><given-names>S</given-names></name><name><surname>Calgan</surname><given-names>D</given-names></name><name><surname>Vernali</surname><given-names>T</given-names></name><name><surname>Woods</surname><given-names>RJ</given-names></name></person-group><article-title>Solvated ensemble averaging in the calculation of partial atomic charges</article-title><source>J. Comput. Chem.</source><year>2001</year><volume>22</volume><fpage>1125</fpage><lpage>1137</lpage><pub-id pub-id-type="pmid">17882310</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kirschner</surname><given-names>KN</given-names></name><name><surname>Woods</surname><given-names>RJ</given-names></name></person-group><article-title>Quantum mechanical study of the nonbonded forces in water-methanol complexes</article-title><source>J. Phys. Chem. A</source><year>2001</year><volume>105</volume><fpage>4150</fpage><lpage>4155</lpage><pub-id pub-id-type="pmid">16518456</pub-id></element-citation></ref><ref id="B19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Oostenbrink</surname><given-names>C</given-names></name><name><surname>Villa</surname><given-names>A</given-names></n