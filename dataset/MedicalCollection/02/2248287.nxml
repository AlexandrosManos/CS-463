er-name>Oxford University Press</publisher-name><fpage>115</fpage><lpage>116</lpage></citation></ref><ref id="R24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kyle</surname><given-names>T</given-names></name></person-group><article-title>The concept of caring: a review of the literature</article-title><source>J Adv Nurs</source><year>1995</year><volume>21</volume><issue>3</issue><fpage>506</fpage><lpage>514</lpage><pub-id pub-id-type="pmid">7745205</pub-id></citation></ref><ref id="R25"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Watson</surname><given-names>J</given-names></name></person-group><source>Nursing: A Philosophy and Science of Caring</source><year>1979</year><publisher-loc>Boston</publisher-loc><publisher-name>Little Brown</publisher-name></citation></ref><ref id="R26"><citation citation-type="book"><person-group person-group-type="author"><name><surname>McFarlane</surname><given-names>JK</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Fairburn</surname><given-names>G</given-names></name><name><surname>Fairburn</surname><given-names>S</given-names></name></person-group><article-title>Nursing: a paradigm of caring</article-title><source>Ethical Issues in Caring</source><year>1988</year><publisher-loc>Aldershot</publisher-loc><publisher-name>Avebury</publisher-name><fpage>10</fpage><lpage>20</lpage></citation></ref><ref id="R27"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Leininger</surname><given-names>MM</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Leininger</surname><given-names>MM</given-names></name></person-group><article-title>The phenomenon of caring: importance, research questions and theoretical considerations</article-title><source>Caring, an Essential Human Need</source><year>1981</year><publisher-loc>Detroit</publisher-loc><pu