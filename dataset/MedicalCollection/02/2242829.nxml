n screen</article-title>					<source>Genome Res</source>					<volume>15</volume>					<fpage>321</fpage>					<lpage>329</lpage>				<pub-id pub-id-type="pmid">15687295</pub-id></element-citation></ref><ref id="ppat-0040043-b007"><element-citation publication-type="journal">					<person-group person-group-type="author"><name><surname>He</surname><given-names>J</given-names></name><name><surname>Baldini</surname><given-names>RL</given-names></name><name><surname>Deziel</surname><given-names>E</given-names></name><name><surname>Saucier</surname><given-names>M</given-names></name><name><surname>Zhang</surname><given-names>Q</given-names></name><etal/></person-group>					<year>2004</year>					<article-title>The broad host range pathogen <named-content content-type="genus-species">Pseudomonas aeruginosa</named-content> strain PA14 carries two pathogenicity islands harboring plant and animal virulence genes</article-title>					<source>Proc Natl Acad Sci U S A</source>					<volume>101</volume>					<fpage>2530</fpage>					<lpage>2535</lpage>				<pub-id pub-id-type="pmid">14983043</pub-id></element-citation></ref><ref id="ppat-0040043-b008"><element-citation publication-type="journal">					<person-group person-group-type="author"><name><surname>Lewenza</surname><given-names>S</given-names></name><name><surname>Falsafi</surname><given-names>RK</given-names></name><name><surname>Winsor</surname><given-names>G</given-names></name><name><surname>Gooderham</surname><given-names>WJ</given-names></name><name><surname>McPhee</surname><given-names>JB</given-names></name><etal/></person-group>					<year>2005</year>					<article-title>Construction of a mini-Tn5-luxCDABE mutant library in <named-content content-type="genus-species">Pseudomonas aeruginosa</named-content> PAO1: A tool for identifying differentially regulated genes</article-title>					<source>Genome Res</source>					<volume>15</volume>					<fpage>583</fpage>					<lpage>589</lpage>				<pub-id pub-id-type="pmid">15805499</pub-id></element-citation></ref><ref id="ppat-0040043-b009"><element-citation publication-type="journal">					<person-group person-group-type="author"><name><surname>Madhusudhan</surname><given-names>KT</given-names></name><name><surname>McLaughlin</surname><given-names>R</given-names></name><name><surname>Komori</surname><given-names>N</given-names></name><name><surname>Matsumoto</surname><given-names>H</given-names></name></person-group>					<year>2003</year>					<article-title>Identification of a major protein upon phosphate starvation of <named-content content-type="genus-species">Pseudomonas aeruginosa</named-content> PAO1</article-title>					<source>J Basic Microbiol</source>					<volume>43</volume>					<fpage>36</fpage>					<lpage>46</lpage>				<pub-id pub-id-type="pmid">12596240</pub-id></element-citation></ref><ref id="ppat-0040043-b010"><element-citation publication-type="journal">					<person-group person-group-type="author"><name><surname>Nikata</surname><given-names>T</given-names></name><name><surname>Sakai</surname><given-names>Y</given-names></name><name><surname>Shibat</surname><given-names>K</given-names></name><name><surname>Kato</surname><given-names>J</given-names></name><name><surname>Kuroda</surname><given-names>A</given-names></name><etal/></person-group>					<year>1996</year>					<article-title>Molecular analysis of the phosphate-specific transport (pst) operon of <named-content content-type="genus-species">Pseudomonas aeruginosa</named-content></article-title>					<source>Mol Gen Genet</source>					<volume>250</volume>					<fpage>692</fpage>					<lpage>698</lpage>				<pub-id pub-id-type="pmid">8628229</pub-id></element-citation></ref><ref id="ppat-0040043-b011"><element-citation publication-type="journal">					<person-group person-group-type="author"><name><surname>Poole</surname><given-names>K</given-names></name><name><surname>Hancock</surname><given-names>RE</given-names></name></person-group>					<year>1986</year>					<article-title>Phosphat