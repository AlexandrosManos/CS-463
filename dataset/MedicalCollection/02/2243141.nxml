thor"><name><surname>Hendrix</surname><given-names>MJ</given-names></name><name><surname>Seftor</surname><given-names>EA</given-names></name><name><surname>Seftor</surname><given-names>RE</given-names></name><name><surname>Trevor</surname><given-names>KT</given-names></name></person-group><article-title>Experimental co-expression of vimentin and keratin intermediate filaments in human breast cancer cells results in phenotypic interconversion and increased invasive behavior</article-title><source>Am J Pathol</source><year>1997</year><volume>150</volume><fpage>483</fpage><lpage>495</lpage><!--PubMed citation query: 'Am J Pathol||150|483||bib10|'--><pub-id pub-id-type="pmid">9033265</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ho</surname><given-names>DH</given-names></name><name><surname>Pazdur</surname><given-names>R</given-names></name><name><surname>Covington</surname><given-names>W</given-names></name><name><surname>Brown</surname><given-names>N</given-names></name><name><surname>Huo</surname><given-names>YY</given-names></name><name><surname>Lassere</surname><given-names>Y</given-names></name><name><surname>Kuritani</surname><given-names>J</given-names></name></person-group><article-title>Comparison of 5-fluorouracil pharmacokinetics in patients receiving continuous 5 -fluorouracil infusion and oral uracil plus N1-(2&#x02032;-tetrahydrofuryl)-5-fluorouracil</article-title><source>Clin Cancer Res</source><year>1998</year><volume>4</volume><fpage>2085</fpage><lpage>2088</lpage><!--PubMed citation query: 'Clin Cancer Res||4|2085||bib11|'--><pub-id pub-id-type="pmid">9748123</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ikenaka</surname><given-names>K</given-names></name><name><surname>Shirasaka</surname><given-names>T</given-names></name><name><surname>Kitano</surname><given-names>S</given-names></