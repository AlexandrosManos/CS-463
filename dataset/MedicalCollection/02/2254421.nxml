><name><surname>Povoa</surname><given-names>G</given-names></name><name><surname>Werner</surname><given-names>S</given-names></name><name><surname>Hall</surname><given-names>K</given-names></name></person-group><article-title>Insulin regulates the 35 kDa IGF binding protein in patients with diabetes mellitus</article-title><source>Journal of Endocrinological Investigation</source><year>1988</year><volume>11</volume><fpage>599</fpage><lpage>602</lpage><pub-id pub-id-type="pmid">2468706</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Holly</surname><given-names>J</given-names></name><name><surname>Biddlecombe</surname><given-names>R</given-names></name><name><surname>Dunger</surname><given-names>D</given-names></name><name><surname>Edge</surname><given-names>J</given-names></name><name><surname>Amiel</surname><given-names>S</given-names></name><name><surname>Howell</surname><given-names>R</given-names></name><name><surname>Chard</surname><given-names>T</given-names></name><name><surname>Rees</surname><given-names>L</given-names></name><name><surname>Wass</surname><given-names>J</given-names></name></person-group><article-title>Circadian variation of GH-independent IGF-binding protein in diabetes mellitus and its relationship to insulin. A new role for insulin?</article-title><source>Clinical Endocrinology</source><year>1988</year><volume>29</volume><fpage>667</fpage><lpage>675</lpage><pub-id pub-id-type="pmid">2476266</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Suikkari</surname><given-names>A-M</given-names></name><name><surname>Koivisto</surname><given-names>V</given-names></name><name><surname>Rutanen</surname><given-names>E-M</given-names></name><name><surname>Yki-Jarvinen</surname><given-names>H</given-names></name><name><surname>Karonen</surname><given-names>S-L</given-names></name><name><surname>Se