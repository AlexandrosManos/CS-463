ame><surname>Yoder</surname><given-names>OC</given-names></name><name><surname>Turgeon</surname><given-names>BG</given-names></name></person-group><article-title>Phylogenomic analysis of type I polyketide synthase genes in pathogenic and saprobic ascomycetes</article-title><source>Proc. Natl Acad. Sci. USA</source><year>2003</year><volume>100</volume><fpage>15670</fpage><lpage>15675</lpage><pub-id pub-id-type="pmid">14676319</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kamper</surname><given-names>J</given-names></name><name><surname>Kahmann</surname><given-names>R</given-names></name><name><surname>Bolker</surname><given-names>M</given-names></name><name><surname>Ma</surname><given-names>LJ</given-names></name><name><surname>Brefort</surname><given-names>T</given-names></name><name><surname>Saville</surname><given-names>BJ</given-names></name><name><surname>Banuett</surname><given-names>F</given-names></name><name><surname>Kronstad</surname><given-names>JW</given-names></name><name><surname>Gold</surname><given-names>SE</given-names></name><etal/></person-group><article-title>Insights from the genome of the biotrophic fungal plant pathogen <italic>Ustilago maydis</italic></article-title><source>Nature</source><year>2006</year><volume>444</volume><fpage>97</fpage><lpage>101</lpage><pub-id pub-id-type="pmid">17080091</pub-id></element-citation></ref><ref id="B16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jeon</surname><given-names>J</given-names></name><name><surname>Park</surname><given-names>SY</given-names></name><name><surname>Chi</surname><given-names>MH</given-names></name><name><surname>Choi</surname><given-names>J</given-names></name><name><surname>Park</surname><given-names>J</given-names></name><name><surname>Rho</surname><given-names>HS</given-names></name><name><