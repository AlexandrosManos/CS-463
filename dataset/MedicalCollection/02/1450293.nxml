er">71.8%</td><td></td><td align="center">73.6%</td><td></td><td align="center">NS (0.2)</td></tr><tr><td align="left">Pre treatment passive regurgitation</td><td></td><td align="center">77.7%</td><td></td><td align="center">63.6%</td><td></td><td align="center">NS (0.2)</td></tr><tr><td align="left">Pre treatment chest pain</td><td align="center">Daily</td><td align="center">12.6%</td><td align="center">70.9%</td><td align="center">8.2%</td><td align="center">54.5%</td><td align="center">0.03</td></tr><tr><td></td><td align="center">Weekly</td><td align="center">44.7%</td><td></td><td align="center">38.2%</td><td></td><td></td></tr><tr><td></td><td align="center">Monthly</td><td align="center">13.6%</td><td></td><td align="center">8.1%</td><td></td><td></td></tr><tr><td></td><td align="center">Never</td><td align="center">29.1%</td><td></td><td align="center">45.5%</td><td></td><td></td></tr><tr><td align="left">Nocturnal cough</td><td></td><td align="center">51.5%</td><td></td><td align="center">40%</td><td></td><td align="center">NS (0.09)</td></tr></tbody></table><table-wrap-foot><p>NS: Not Significant</p></table-wrap-foot></table-wrap><table-wrap position="float" id="T4"><label>Table 4</label><caption><p>Comparing the presenting symptoms between men and women after treatment</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="left" colspan="2">Variable</td><td align="center" colspan="2">Women (n= 103, 48.4%)</td><td align="center" colspan="2">Men (n = 110, 51.6%)</td><td align="center">P Value</td></tr></thead><tbody><tr><td align="left">Mean post treatment total score (SD)</td><td></td><td align="center">2.4 (2.2)</td><td></td><td align="center">2.7 (2.7)</td><td></td><td align="center">NS (0.3)</td></tr><tr><td align="left">Post solid dysphagia</td><td></td><td align="center">68.9%</td><td></td><td align="center">76.4%</td><td></td><td align="center">NS (0.1)</td></tr><tr><td align="left">Post liquid dysphagia</td><td></td><td align="center">25.2%</td><td></td><td align="center">33.6%</td><td></td><td align="center">NS (0.09)</td></tr><tr><td align="left">Post active regurgitation</td><td></td><td align="center">12.6%</td><td></td><td align="center">15.5%</td><td></td><td align="center">NS (0.5)</td></tr><tr><td align="left">Post passive regurgitation</td><td></td><td align="center">7.8%</td><td></td><td align="center">8.2%</td><td></td><td align="center">NS (0.9)</td></tr><tr><td align="left">Post chest pain</td><td align="center">Daily</td><td align="center">1%</td><td align="center">32%</td><td align="center">0%</td><td align="center">20.9%</td><td align="center">0.04</td></tr><tr><td></td><td align="center">Weekly</td><td align="center">11.7%</td><td></td><td align="center">5.4%</td><td></td><td></td></tr><tr><td></td><td align="center">Monthly</td><td align="center">19.3%</td><td></td><td align="center">15.5%</td><td></td><td></td></tr><tr><td></td><td align="center">Never</td><td align="center">68%</td><td></td><td align="center">79.1%</td><td></td><td></td></tr></tbody></table><table-wrap-foot><p>NS: Not Significant</p></table-wrap-foot></table-wrap></sec></back></article>