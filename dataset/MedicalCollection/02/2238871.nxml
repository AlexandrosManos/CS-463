citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hain</surname><given-names>T</given-names></name><name><surname>Chatterjee</surname><given-names>SS</given-names></name><name><surname>Ghai</surname><given-names>R</given-names></name><name><surname>Kuenne</surname><given-names>CT</given-names></name><name><surname>Billion</surname><given-names>A</given-names></name><name><surname>Steinweg</surname><given-names>C</given-names></name><name><surname>Domann</surname><given-names>E</given-names></name><name><surname>Karst</surname><given-names>U</given-names></name><name><surname>Jansch</surname><given-names>L</given-names></name><etal/></person-group><article-title>Pathogenomics of Listeria spp</article-title><source>Int. J. Med. Microbiol.</source><year>2007</year><volume>297</volume><fpage>541</fpage><lpage>557</lpage><pub-id pub-id-type="pmid">17482873</pub-id></element-citation></ref></ref-list></back></article>