 pub-id-type="doi">10.1111/j.1749-6632.1989.tb53234.x</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Young</surname><given-names>SN</given-names></name></person-group><article-title>Folate and depression&#x02013;a neglected problem</article-title><source>J Psychiatry Neurosci</source><year>2007</year><volume>32</volume><fpage>80</fpage><lpage>82</lpage><pub-id pub-id-type="pmid">17353937</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hibbeln</surname><given-names>JR</given-names></name></person-group><article-title>Fish consumption and major depression</article-title><source>The Lancet</source><year>1998</year><volume>351</volume><fpage>1213</fpage><pub-id pub-id-type="doi">10.1016/S0140-6736(05)79168-6</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rudin</surname><given-names>DO</given-names></name></person-group><article-title>The major psychoses and neuroses as omega-3 essential fatty acid deficiency syndrome: substrate pellagra</article-title><source>Biol Psychiatry</source><year>1981</year><volume>16</volume><fpage>837</fpage><lpage>850</lpage><pub-id pub-id-type="pmid">7028146</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rudin</surname><given-names>DO</given-names></name></person-group><article-title>The dominant diseases of modernized societies as omega-3 essential fatty acid deficiency syndrome: substrate beriberi</article-title><source>Med Hypotheses</source><year>1982</year><volume>8</volume><fpage>17</fpage><lpage>47</lpage><pub-id pub-id-type="pmid">7062860</pub-id><pub-id pub-id-type="doi">10.1016/0306-9877(82)90088-3</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bell</surname><given-names>IR</given-names></name><name><surname>Edman</surname><given-names>JS</given-names></name><name><surname>Morrow</surname><given-names>FD</given-names></name><name><surname>Marby</surname><given-names>DW</given-names></name><name><surname>Mirages</surname><given-names>S</given-names></name><name><surname>Perrone</surname><given-names>G</given-names></name><name><surname>Kayne</surname><given-names>HL</given-names></name><name><surname>Cole</surname><given-names>JO</given-names></name></person-group><article-title>B complex vitamin patterns in geriatric and young adult inpatients with major depression</article-title><source>J Am Geriatr Soc</source><year>1991</year><volume>39</volume><fpage>252</fpage><lpage>257</lpage><pub-id pub-id-type="pmid">2005338</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eby</surname><given-names>GA</given-names></name><name><surname>Eby</surname><given-names>KL</given-names></name></person-group><article-title>Rapid recovery from major depression using magnesium treatment</article-title><source>Med Hypotheses</source><year>2006</year><volume>67</volume><fpage>362</fpage><lpage>370</lpage><pub-id pub-id-type="pmid">16542786</pub-id><pub-id pub-id-type="doi">10.1016/j.mehy.2006.01.047</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buist</surname><given-names>R</given-names></name></person-group><article-title>The therapeutic predictability of tryptophan and tyrosine in the treatment of depression</article-title><source>Int J Clin Nutr Rev</source><year>1983</year><volume>3</volume><fpage>1</fpage><lpage>3</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chouinard</surname><given-names>G</given-names></name><name><surname>Young</surname><given-names>SN</given-nam