</lpage><article-title>Relationship of changes in physical activity and mortality among older women</article-title><source>JAMA</source><pub-id pub-id-type="pmid">12746361</pub-id></citation></ref><ref id="B28"><label>28</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pate</surname><given-names>RR</given-names></name><name><surname>Pratt</surname><given-names>M</given-names></name><name><surname>Blair</surname><given-names>SN</given-names></name><name><surname>Haskell</surname><given-names>WL</given-names></name><name><surname>Macera</surname><given-names>CA</given-names></name><name><surname>Bouchard</surname><given-names>C</given-names></name><etal/></person-group><volume>273</volume><issue>5</issue><year>1995</year><fpage>402</fpage><lpage>407</lpage><article-title>Physical activity and public health. A recommendation from the Centers for Disease Control and Prevention and the American College of Sports Medicine</article-title><source>JAMA</source><pub-id pub-id-type="pmid">7823386</pub-id></citation></ref><ref id="B29"><label>29</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Klesges</surname><given-names>LM</given-names></name><name><surname>Estabrooks</surname><given-names>PA</given-names></name><name><surname>Dzewaltowski</surname><given-names>DA</given-names></name><name><surname>Bull</surname><given-names>SS</given-names></name><name><surname>Glasgow</surname><given-names>RE</given-names></name></person-group><year>2005</year><volume>29</volume><issue>Suppl</issue><fpage>66</fpage><lpage>75</lpage><article-title>Beginning with the application in mind: designing and planning health behavior change interventions to enhance dissemination</article-title><source>Ann Behav Med</source><pub-id pub-id-type="pmid">15921491</pub-id></citation></ref><ref id="B30"><label>30</label><citation citation-type="book"><person-group person-group-type="editor"><name><surname>Gold</