author"><name><surname>Kapperud</surname><given-names>G</given-names></name><name><surname>Stenwig</surname><given-names>H</given-names></name><name><surname>Lassen</surname><given-names>J</given-names></name></person-group><article-title>Epidemiology of Salmonella typhimurium O-12 infection in Norway. Evidence of transmission from an avian wildlife reservoir.</article-title><source>American Journal of Epidemiology</source><year>1998</year><volume>147</volume><fpage>774</fpage><lpage>782</lpage><pub-id pub-id-type="pmid">9554419</pub-id></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cooke</surname><given-names>FJ</given-names></name><name><surname>Wain</surname><given-names>J</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Mastroeni P, Maskell D</surname></name></person-group><article-title>Antibiotic resistance in Salmonella infections.</article-title><source>Salmonella Infections: Clinical, Immunological and Molecular Aspects</source><year>2006</year><publisher-name>Cambridge , Cambridge University Press</publisher-name><fpage>25</fpage><lpage>56</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Poppe</surname><given-names>C</given-names></name><name><surname>Ziebell</surname><given-names>K</given-names></name><name><surname>Martin</surname><given-names>L</given-names></name><name><surname>Allen</surname><given-names>K</given-names></name></person-group><article-title>Diversity in antimicrobial resistance and other characteristics among Salmonella Typhimurium DT104 isolates.</article-title><source>Microbial Drug Resistance</source><year>2002</year><volume>8</volume><fpage>107</fpage><lpage>122</lpage><pub-id pub-id-type="pmid">12118515</pub-id><pub-id pub-id-type="doi">10.1089/107662902760190653</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Threlfall</surname><given-names>EJ</given-names></name><name><surname>Teale</surname><given-names>CJ</given-names></name><name><surname>Ward</surname><given-names>LR</given-names></name><name><surname>Davies</surname><given-names>RH</given-names></name><name><surname>Skinner</surname><given-names>JA</given-names></name><name><surname>Graham</surname><given-names>A</given-names></name><name><surname>Cassar</surname><given-names>C</given-names></name><name><surname>Speed</surname><given-names>K</given-names></name></person-group><article-title>A comparison of antimicrobial susceptibilities in non-typhoidal salmonellas from humans and food animals in England and Wales.</article-title><source>Microbial Drug Resistance</source><year>2003</year><volume>9</volume><fpage>183</fpage><lpage>189</lpage><pub-id pub-id-type="pmid">12820804</pub-id><pub-id pub-id-type="doi">10.1089/107662903765826787</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Refsum</surname><given-names>R</given-names></name><name><surname>Heir</surname><given-names>E</given-names></name><name><surname>Kapperud</surname><given-names>G</given-names></name><name><surname>Vardund</surname><given-names>T</given-names></name><name><surname>Holstad</surname><given-names>G</given-names></name></person-group><article-title>Molecular epidemiology of Salmonella enterica serovar Typhimurium isolates detected by pulsed-field gel electrophoresis: comparison of isolates from avian wildlife, domestic animals, and the environment in Norway.</article-title><source>Applied and Environmental Microbiology</source><year>2002</year><volume>68</volume><fpage>5600</fpage><lpage>5606</lpage><pub-id pub-id-type="pmid">12406755</pub-id></citation></ref><ref id="B16"><citation citation-type="other"><person-group person-group-type="author"><collab>DEFRA</collab><collab>OIE</collab></person-group><article-titl