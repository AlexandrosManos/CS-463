ensive Care Med</source><year>2003</year><volume>29</volume><fpage>1489</fpage><lpage>1497</lpage><pub-id pub-id-type="pmid">12879243</pub-id><pub-id pub-id-type="doi">10.1007/s00134-003-1853-5</pub-id></citation></ref></ref-list></back></article>