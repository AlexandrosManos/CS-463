02</year><publisher-name>Wiley-VCH, Weinheim</publisher-name><fpage>259</fpage><lpage>285</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nelson</surname><given-names>LA</given-names></name><name><surname>Fogalia</surname><given-names>TA</given-names></name><name><surname>Marmer</surname><given-names>WN</given-names></name></person-group><article-title>Lipase catalyzed production of biodiesel</article-title><source>J Am Oil Chem Soc</source><year>1996</year><volume>73</volume><fpage>1191</fpage><lpage>1195</lpage><pub-id pub-id-type="doi">10.1007/BF02523383</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shah</surname><given-names>S</given-names></name><name><surname>Sharma</surname><given-names>S</given-names></name><name><surname>Gupta</surname><given-names>MN</given-names></name></person-group><article-title>Biodiesel Preparation by Lipase-Catalyzed Transesterification of Jatropha Oil</article-title><source>Energy Fuels</source><year>2004</year><volume>18</volume><fpage>154</fpage><lpage>159</lpage><pub-id pub-id-type="doi">10.1021/ef030075z</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Foidl</surname><given-names>N</given-names></name><name><surname>Foidl</surname><given-names>G</given-names></name><name><surname>Sanchez</surname><given-names>M</given-names></name><name><surname>Mittelbach</surname><given-names>M</given-names></name><name><surname>Hackel</surname><given-names>S</given-names></name></person-group><article-title><italic>Jatropha curcas </italic>L. as a source for the production of biofuel in Nicaragua</article-title><source>Bioresouce Technol</source><year>1996</year><volume>58</volume><fpage>77</fpage><lpage>82</lpage><pub-id pub-id-type="doi">10.1016/S0960-8524(96)00111-3</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ishimori</surname><given-names>Y</given-names></name><name><surname>Karube</surname><given-names>I</given-names></name><name><surname>Suzuki</surname><given-names>S</given-names></name></person-group><article-title>Acceleration of immobilized &#x003b1;-chymotrypsin activity with ultrasonic irradiation</article-title><source>J Mol Catal</source><year>1981</year><volume>12</volume><fpage>253</fpage><lpage>259</lpage><pub-id pub-id-type="doi">10.1016/0304-5102(81)80012-0</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sakakibara</surname><given-names>M</given-names></name><name><surname>Wang</surname><given-names>D</given-names></name><name><surname>Takahashi</surname><given-names>R</given-names></name><name><surname>Takahashi</surname><given-names>K</given-names></name><name><surname>Mori</surname><given-names>S</given-names></name></person-group><article-title>Influence of ultrasound irradiation on hydrolysis of sucrose catalyzed by invertase</article-title><source>Enzyme Microb Technol</source><year>1996</year><volume>18</volume><fpage>444</fpage><lpage>448</lpage><pub-id pub-id-type="doi">10.1016/0141-0229(95)00128-X</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Partridge</surname><given-names>J</given-names></name><name><surname>Halling</surname><given-names>PJ</given-names></name><name><surname>Moore</surname><given-names>BD</given-names></name></person-group><article-title>Practical route to high activity enzyme preparations for synthesis in organic media</article-title><source>Chem Commun</source><year>1998</year><fpage>841</fpage><lpage>842</lpage><pub-id pub-id-type="doi">10.1039/a800408k</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roy</surname><given-names>I</given-names></name><name><surname>Gupta</surname><given-names>MN</given-names></name></person-group><article-title>Preparation of highly active &#x003b1;-chymotrypsin for catalysis in organic media</article-title><source>Bioorg Med Chem Lett</source><year>2004</year><volume>14</volume><fpage>2191</fpage><lpage>2193</lpage><pub-id pub-id-type="pmid">15081006</pub-id><pub-id pub-id-type="doi">10.1016/j.bmcl.2004.02.026</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mittelbach</surname><given-names>M</given-names></name></person-group><article-title>Lipase catalysed alcoholysis of sunflower oil</article-title><source>J Am Oil Chem Soc</source><year>1990</year><volume>67</volume><fpage>68</fpage><lpage>170</lpage><pub-id pub-id-type="doi">10.1007/BF02539619</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaieda</surname><given-names>M</given-names></name><name><surname>Samukawa</surname><given-names>T</given-names></name><name><surname>Kondo</surname><given-names>A</given-names></name><name><surname>Fukuda</surname><given-names>H</given-names></name></person-group><article-title>Effect of methanol and water on production of biodiesel fuel from plant oil catalyzed by various lipases in a solvent-free system</article-title><source>J Biosci Bioeng</source><year>2001</year><volume>91</volume><fpage>12</fpage><lpage>15</lpage><pub-id pub-id-type="pmid">16232938</pub-id><pub-id pub-id-type="doi">10.1263/jbb.91.12</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>B&#x000e9;lafi-Bak&#x000f3;</surname><given-names>K</given-names></name><name><surname>Kov&#x000e1;cs</surname><given-names>F</given-names></name><name><surname>Gubicza</surname><given-names>L</given-names></name><name><surname>Hancs&#x000f3;k</surname><given-names>J</given-names></name></person-group><article-title>Enzymatic biodiesel production from sunflower oil by <italic>Candida antarctica </italic>lipase in a solvent-free system</article-title><source>Biocatal Biotransform</source><year>2002</year><volume>20</volume><fpage>437</fpage><lpage>439</lpage><pub-id pub-id-type="doi">10.1080/1024242021000040855</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dossat</surname><given-names>V</given-names></name><name><surname>Combes</surname><given-names>D</given-names></name><name><surname>Marty</surname><given-names>A</given-names></name></person-group><article-title>Lipase-catalyzed transesterification of high oleic sunflower oil</article-title><source>Enzyme Microb Technol</source><year>2002</year><volume>30</volume><fpage>90</fpage><lpage>94</lpage><pub-id pub-id-type="doi">10.1016/S0141-0229(01)00453-7</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kelly</surname><given-names>SM</given-names></name><name><surname>Jess</surname><given-names>TJ</given-names></name><name><surname>Price</surname><given-names>NC</given-names></name></person-group><article-title>How to study proteins by circular dichroism</article-title><source>Biochim Biophys Acta</source><year>2005</year><volume>1751</volume><fpage>119</fpage><lpage>139</lpage><pub-id pub-id-type="pmid">16027053</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jain</surname><given-names>P</given-names></name><name><surname>Jain</surname><given-names>S</given-names></name><name><surname>Gupta</surname><given-names>MN</given-names></name></person-group><article-title>A microwave assisted microassay for lipase</article-title><source>Anal Bioanal Chem</source><year>2005</year><volume>381</volume><fpage>1480</fpage><lpage>1482</lpage><pub-id pub-id-type="pmid">15798906</pub-id><pub-id pub-id-type="doi">10.1007/s00216-005-3105-8</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shah</surname><given-names>S</given-names></name><name><surname>Gupta</surname><given-names>MN</given-names></name></person-group><article-title>Kinetic resolution of (&#x000b1;)-1-phenylethanol in [Bmim][PF<sub>6</sub>] using high activity preparations of lipases</article-title><source>Bioorg Med Chem Lett</source><year>2007</year><volume>17</volume><fpage>921</fpage><lpage>924</lpage><pub-id pub-id-type="pmid">17157018</pub-id><pub-id pub-id-type="doi">10.1016/j.bmcl.2006.11.057</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>KK</given-names></name><name><surname>Hwang</surname><given-names>KY</given-names></name><name><surname>Jeon</surname><given-names>HS</given-names></name><name><surname>Kim</surname><given-names>S</given-names></name><name><surname>Sweet</surname><given-names>RM</given-names></name><name><surname>Yang</surname><given-names>CH</given-names></name><name><surname>Suh</surname><given-names>SW</given-names></name></person-group><article-title>Crystallization and preliminary X-ray crystallographic analysis of lipase from <italic>Pseudomonas cepacia</italic></article-title><source>J Mol Biol</source><year>1992</year><volume>227</volume><fpage>1258</fpage><lpage>1262</lpage><pub-id pub-id-type="pmid">1279182</pub-id><pub-id pub-id-type="doi">10.1016/0022-2836(92)90537-T</pub-id></citation></ref><ref id="B28"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hames</surname><given-names>BD</given-names></name><name><surname>Rickwood</surname><given-names>D</given-names></name></person-group><source>Gel electrophoresis of proteins: a practical approach</source><year>1976</year><publisher-name>IRL Press: Oxford</publisher-name></citation></ref></ref-list></back></article>