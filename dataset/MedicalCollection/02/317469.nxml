foramen magnum to the vertex</article-title><source>Surg Neurol</source><year>1987</year><volume>28</volume><fpage>123</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">3603352</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arienta</surname><given-names>C</given-names></name><name><surname>Baiguini</surname><given-names>M</given-names></name><name><surname>Granata</surname><given-names>G</given-names></name><name><surname>Villani</surname><given-names>R</given-names></name></person-group><article-title>Acute bilateral epidural hematomas. Report of two cases and review of the literature</article-title><source>J Neurosurg Sci</source><year>1986</year><volume>30</volume><fpage>139</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">3783268</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koga</surname><given-names>H</given-names></name><name><surname>Mori</surname><given-names>K</given-names></name><name><surname>Kurihara</surname><given-names>M</given-names></name><name><surname>Sakai</surname><given-names>S</given-names></name></person-group><article-title>Traumatic bilateral epidural hematomas presenting at different times in a patient with large ventricles</article-title><source>Surg Neurol</source><year>1985</year><volume>24</volume><fpage>272</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">4023907</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reale</surname><given-names>F</given-names></name><name><surname>Biancotti</surname><given-names>R</given-names></name></person-group><article-title>Acute bilateral epidural hematoma</article-title><source>Surg Neurol</source><year>1985</year><volume>24</volume><fpage>260</fpage><lpage>2</lpage><pub-id pub-id-type="pmid">4023905</pub-id></citation></ref><ref id="B19"><citation citati