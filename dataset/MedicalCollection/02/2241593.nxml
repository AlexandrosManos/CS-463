></name><name><surname>Saboe</surname><given-names>L</given-names></name><name><surname>Miller</surname><given-names>J</given-names></name></person-group><article-title>Etiology and clinical course of missed spine fractures</article-title><source>J Trauma</source><year>1987</year><volume>27</volume><fpage>980</fpage><lpage>986</lpage><pub-id pub-id-type="pmid">3656481</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gerrelts</surname><given-names>B</given-names></name><name><surname>Peterson</surname><given-names>E</given-names></name><name><surname>Mabry</surname><given-names>J</given-names></name><name><surname>Peterson</surname><given-names>S</given-names></name></person-group><article-title>Delayed diagnosis of cervical spine injuries</article-title><source>J Trauma</source><year>1991</year><volume>31</volume><fpage>1622</fpage><lpage>1626</lpage><pub-id pub-id-type="pmid">1749033</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Benzel</surname><given-names>E</given-names></name><name><surname>Hart</surname><given-names>B</given-names></name><name><surname>Ball</surname><given-names>P</given-names></name><name><surname>Baldwin</surname><given-names>N</given-names></name><name><surname>Orrison</surname><given-names>W</given-names></name><name><surname>Espinosa</surname><given-names>M</given-names></name></person-group><article-title>Magnetic resonance imaging for the evaluation of patients with occult cervical spine injury</article-title><source>Journal of Neurosurgery</source><year>1996</year><volume>85</volume><fpage>824</fpage><lpage>829</lpage><pub-id pub-id-type="pmid">8893720</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>D'Alise</surname><given-names>M</given-names></name><name><surname>Benzel</surname><given-names>E</g