 id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Iacovelli</surname><given-names>P</given-names></name><name><surname>Sinagra</surname><given-names>JL</given-names></name><name><surname>Vidolin</surname><given-names>AP</given-names></name><name><surname>Marenda</surname><given-names>S</given-names></name><name><surname>Capitanio</surname><given-names>B</given-names></name><name><surname>Leone</surname><given-names>G</given-names></name><name><surname>Picardo</surname><given-names>M</given-names></name></person-group><article-title>Relevance of thyroiditis and of other autoimmune diseases in children with vitiligo</article-title><source>Dermatology</source><year>2005</year><volume>210</volume><fpage>26</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">15604541</pub-id><pub-id pub-id-type="doi">10.1159/000081479</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morgan</surname><given-names>M</given-names></name><name><surname>Castells</surname><given-names>A</given-names></name><name><surname>Ramirez</surname><given-names>A</given-names></name></person-group><article-title>Autoantibodies in vitiligo: clinical significance</article-title><source>Med Cutan Ibero Lat Am</source><year>1986</year><volume>14</volume><fpage>139</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">3528710</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dave</surname><given-names>S</given-names></name><name><surname>D'Souza</surname><given-names>M</given-names></name><name><surname>Thappa</surname><given-names>DM</given-names></name><name><surname>Reddy</surname><given-names>KS</given-names></name><name><surname>Bobby</surname><given-names>Z</given-names></name></person-group><article-title>High frequency of thyroid dysfunction in Indian patients with vitiligo</article-title><source>Indi