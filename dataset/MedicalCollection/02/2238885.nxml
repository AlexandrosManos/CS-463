"pmid">7483486</pub-id></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><collab>CDC</collab><article-title>Transmission of hepatitis B and C viruses in outpatient settings &#x02013; New York, Oklahoma, and Nebraska, 2000-2002</article-title><source>MMWR Morb. Mortal. Wkly Rep.</source><year>2003</year><volume>52</volume><fpage>901</fpage><lpage>906</lpage><pub-id pub-id-type="pmid">14508437</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Simmonds</surname><given-names>P</given-names></name></person-group><article-title>Viral heterogeneity of the hepatitis C virus</article-title><source>J. Hepatol.</source><year>1999</year><volume>31</volume><issue>Suppl. 1</issue><fpage>54</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">10622561</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Farci</surname><given-names>P</given-names></name><name><surname>Purcell</surname><given-names>RH</given-names></name></person-group><article-title>Clinical significance of hepatitis C virus genotypes and quasispecies</article-title><source>Semin. Liver Dis.</source><year>2000</year><volume>20</volume><fpage>103</fpage><lpage>126</lpage><pub-id pub-id-type="pmid">10895435</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gaschen</surname><given-names>B</given-names></name><name><surname>Taylor</surname><given-names>J</given-names></name><name><surname>Yusim</surname><given-names>K</given-names></name><name><surname>Foley</surname><given-names>B</given-names></name><name><surname>Gao</surname><given-names>F</given-names></name><name><surname>Lang</surname><given-names>D</given-names></name><name><surname>No