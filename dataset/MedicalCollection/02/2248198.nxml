name><surname>O'Connor</surname><given-names>SL</given-names></name><name><surname>O'Connor</surname><given-names>DH</given-names></name></person-group><article-title>Simian immunodeficiency virus SIVmac239 infection of major histocompatibility complex-identical cynomolgus macaques from Mauritius</article-title><source>J Virol</source><year>2007</year><volume>81</volume><fpage>349</fpage><lpage>361</lpage><pub-id pub-id-type="pmid">17035320</pub-id><pub-id pub-id-type="doi">10.1128/JVI.01841-06</pub-id></citation></ref><ref id="B4"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rood</surname><given-names>PP</given-names></name><name><surname>Bottino</surname><given-names>R</given-names></name><name><surname>Balamurugan</surname><given-names>AN</given-names></name><name><surname>Smetanka</surname><given-names>C</given-names></name><name><surname>Ayares</surname><given-names>D</given-names></name><name><surname>Groth</surname><given-names>CG</given-names></name><name><surname>Murase</surname><given-names>N</given-names></name><name><surname>Cooper</surname><given-names>DK</given-names></name><name><surname>Trucco</surname><given-names>M</given-names></name></person-group><article-title>Reduction of early graft loss after intraportal porcine islet transplantation in monkeys</article-title><source>Transplantation</source><year>2007</year><volume>83</volume><fpage>202</fpage><lpage>210</lpage><pub-id pub-id-type="pmid">17264817</pub-id><pub-id pub-id-type="doi">10.1097/01.tp.0000250680.36942.c6</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kean</surname><given-names>LS</given-names></name><name><surname>Gangappa</surname><given-names>S</given-names></name><name><surname>Pearson</surname><given-names>TC</given-names></name><name><surname>Larsen</surname><given-names>CP</given-names></name></person-group><article-title>Transplant tolerance in non-hum