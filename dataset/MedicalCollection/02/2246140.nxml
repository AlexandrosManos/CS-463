="B37"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Scarcanski</surname><given-names>J</given-names></name><name><surname>Gaviao</surname><given-names>W</given-names></name><name><surname>Cunha</surname><given-names>S</given-names></name><name><surname>Joao</surname><given-names>F</given-names></name></person-group><article-title>Diagnostic Hysteroscopy Video Summarization and Browsing</article-title><source>27th Annual International conference of the IEEE engineering in Medicine and Biology Society</source><publisher-name>Shanghai, China</publisher-name><fpage>5680</fpage><lpage>5683</lpage><comment>1&#x02013;4 September 2005</comment></citation></ref></ref-list></back></article>