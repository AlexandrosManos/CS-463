><fpage>722</fpage><lpage>730</lpage><pub-id pub-id-type="pmid">11055787</pub-id><pub-id pub-id-type="doi">10.1109/42.875195</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jung</surname><given-names>YH</given-names></name><name><surname>Kim</surname><given-names>JS</given-names></name><name><surname>Hur</surname><given-names>BS</given-names></name><name><surname>Kang</surname><given-names>MG</given-names></name></person-group><article-title>Design of Real-Time Image Enhancement Preprocessor for Cmos Image Sensor</article-title><source>IEEE Transactions on Consumer Electronics</source><year>2005</year><volume>46</volume></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grossberg</surname><given-names>MD</given-names></name><name><surname>Nayar</surname><given-names>SK</given-names></name></person-group><article-title>Modeling the space of camera response functions</article-title><source>IEEE Trans Pattern Anal Mach Intell</source><year>2004</year><volume>26</volume><fpage>1272</fpage><lpage>1282</lpage><pub-id pub-id-type="pmid">15641715</pub-id><pub-id pub-id-type="doi">10.1109/TPAMI.2004.88</pub-id></citation></ref><ref id="B29"><citation citation-type="other"><article-title>The MathWorks company for software</article-title><ext-link ext-link-type="uri" xlink:href="http://www.mathworks.com"/></citation></ref><ref id="B30"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Vaidyanathan</surname><given-names>PP</given-names></name></person-group><article-title>Multirate Systems and filter banks</article-title><source>New Jersey: PTR Prentice Hall</source><year>1993</year></citation></ref><ref id="B31"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Petrou</surname><given-names>M</given-names></name><name><surname>Sevilla</surname><given-name