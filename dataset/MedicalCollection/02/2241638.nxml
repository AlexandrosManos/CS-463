b-id pub-id-type="pmid">16709450</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jolad</surname><given-names>SD</given-names></name><name><surname>Lantz</surname><given-names>RC</given-names></name><name><surname>Chen</surname><given-names>GJ</given-names></name><name><surname>Bates</surname><given-names>RB</given-names></name><name><surname>Timmermann</surname><given-names>BN</given-names></name></person-group><article-title>Commercially processed dry ginger (Zingiber officinale): composition and effects on LPS-induced PGE2 production</article-title><source>Phytochemistry</source><year>2005</year><volume>66</volume><fpage>1614</fpage><lpage>1635</lpage><pub-id pub-id-type="pmid">15996695</pub-id><pub-id pub-id-type="doi">10.1016/j.phytochem.2005.05.007</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jolad</surname><given-names>SD</given-names></name><name><surname>Lantz</surname><given-names>RC</given-names></name><name><surname>Solyom</surname><given-names>AM</given-names></name><name><surname>Chen</surname><given-names>GJ</given-names></name><name><surname>Bates</surname><given-names>RB</given-names></name><name><surname>Timmermann</surname><given-names>BN</given-names></name></person-group><article-title>Fresh organically grown ginger (Zingiber officinale): composition and effects on LPS-induced PGE2 production</article-title><source>Phytochemistry</source><year>2004</year><volume>65</volume><fpage>1937</fpage><lpage>1954</lpage><pub-id pub-id-type="pmid">15280001</pub-id><pub-id pub-id-type="doi">10.1016/j.phytochem.2004.06.008</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shukla</surname><given-names>Y</given-names></name><name><surname>Singh</surname><given-names>M</given-names></name></person-group><article-title>Canc