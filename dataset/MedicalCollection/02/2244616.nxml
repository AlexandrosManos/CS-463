/jama.285.24.3093</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wong</surname><given-names>HH</given-names></name><name><surname>Smith</surname><given-names>RG</given-names></name></person-group><article-title>Patterns of complementary and alternative medical therapy use in children diagnosed with autism spectrum disorders</article-title><source>J Autism Dev Disord</source><year>2006</year><volume>36</volume><fpage>901</fpage><lpage>909</lpage><pub-id pub-id-type="pmid">16897395</pub-id><pub-id pub-id-type="doi">10.1007/s10803-006-0131-0</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rossignol</surname><given-names>DA</given-names></name><name><surname>Rossignol</surname><given-names>LW</given-names></name></person-group><article-title>Hyperbaric oxygen therapy may improve symptoms in autistic children</article-title><source>Med Hypotheses</source><year>2006</year><volume>67</volume><fpage>216</fpage><lpage>228</lpage><pub-id pub-id-type="pmid">16554123</pub-id><pub-id pub-id-type="doi">10.1016/j.mehy.2006.02.009</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rossignol</surname><given-names>DA</given-names></name></person-group><article-title>Hyperbaric oxygen therapy might improve certain pathophysiological findings in autism</article-title><source>Med Hypotheses</source><year>2007</year><volume>68</volume><fpage>1208</fpage><lpage>1227</lpage><pub-id pub-id-type="pmid">17141962</pub-id><pub-id pub-id-type="doi">10.1016/j.mehy.2006.09.064</pub-id></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Feldmeier</surname><given-names>JJ</given-names></name><collab>Chairman and Editor</collab></person-group><source>Hyperbaric oxygen 2003: indications and results: t