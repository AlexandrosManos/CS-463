<lpage>1720</lpage><pub-id pub-id-type="pmid">16297770</pub-id><pub-id pub-id-type="doi">10.1016/j.healun.2005.03.019</pub-id></citation></ref><ref id="B3"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hornick</surname><given-names>P</given-names></name><name><surname>Rose</surname><given-names>M</given-names></name></person-group><article-title>Chronic rejection in the heart</article-title><source>Methods Mol Biol</source><year>2006</year><volume>333</volume><fpage>131</fpage><lpage>144</lpage><pub-id pub-id-type="pmid">16790849</pub-id></citation></ref><ref id="B4"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kirlin</surname><given-names>JK</given-names></name></person-group><source>Heart Transplantation</source><year>2002</year><publisher-name>Churcill Livingstone edition</publisher-name></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Peteiro</surname><given-names>J</given-names></name><name><surname>Redondo</surname><given-names>F</given-names></name><name><surname>Calvi&#x000f1;o</surname><given-names>R</given-names></name></person-group><article-title>Differences in heart transplant physiology according to surgical technique</article-title><source>J Thorac Cardiovasc Surg</source><year>1996</year><volume>112</volume><fpage>584</fpage><lpage>589</lpage><pub-id pub-id-type="pmid">8800143</pub-id><pub-id pub-id-type="doi">10.1016/S0022-5223(96)70039-9</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>El Gamel</surname><given-names>A</given-names></name><name><surname>Yonan</surname><given-names>NA</given-names></name><name><surname>Grant</surname><given-names>S</given-names></name></person-group><article-title>Orthotopic cardiac transplantation: a comparison of standard and bicaval Wythenshawe techniques</article-title><source>J Th