n-group-type="author"><name><surname>Xavier</surname><given-names>KB</given-names></name><name><surname>Bassler</surname><given-names>BL</given-names></name></person-group><article-title>LuxS quorum sensing: more than just a numbers game</article-title><source>Curr Opin Microbiol</source><year>2003</year><volume>6</volume><fpage>191</fpage><lpage>197</lpage><pub-id pub-id-type="pmid">12732311</pub-id><pub-id pub-id-type="doi">10.1016/S1369-5274(03)00028-6</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stroeher</surname><given-names>UH</given-names></name><name><surname>Paton</surname><given-names>AW</given-names></name><name><surname>Ogunniyi</surname><given-names>AD</given-names></name><name><surname>Paton</surname><given-names>JC</given-names></name></person-group><article-title>Mutation of luxS of Streptococcus pneumoniae affects virulence in a mouse model</article-title><source>Infect Immun</source><year>2003</year><volume>71</volume><fpage>3206</fpage><lpage>3212</lpage><pub-id pub-id-type="pmid">12761100</pub-id><pub-id pub-id-type="doi">10.1128/IAI.71.6.3206-3212.2003</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Anand</surname><given-names>SK</given-names></name><name><surname>Griffiths</surname><given-names>MW</given-names></name></person-group><article-title>Quorum sensing and expression of virulence in Escherichia coli O157:H7</article-title><source>Int J Food Microbiol</source><year>2003</year><volume>85</volume><fpage>1</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">12810266</pub-id><pub-id pub-id-type="doi">10.1016/S0168-1605(02)00482-8</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lyon</surname><given-names>WR</given-names></name><name><surname>Madden</surname><given-names>JC</given-names></name><name><surna