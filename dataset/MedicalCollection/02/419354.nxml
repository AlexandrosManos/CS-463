lign="left">1162 (30%)</td><td align="left">0.63</td><td align="left">0.0001</td></tr><tr><td align="left"><bold>Pre-operative colonoscopy</bold></td><td></td><td></td><td></td></tr><tr><td align="left">&#x02003;Yes</td><td align="left">1646 (42%)</td><td align="left">0.69</td><td></td></tr><tr><td align="left">&#x02003;No</td><td align="left">2272 (58%)</td><td align="left">0.54</td><td align="left">&#x0003c;0.0001</td></tr><tr><td align="left"><bold>Procedure type</bold></td><td></td><td></td><td></td></tr><tr><td align="left">&#x02003;Resection</td><td align="left">3363 (86%)</td><td align="left">0.62</td><td></td></tr><tr><td align="left">&#x02003;Abdominoperineal resection</td><td align="left">555 (14%)</td><td align="left">0.47</td><td align="left">&#x0003c;0.0001</td></tr><tr><td align="left"><bold>Site of surgery</bold></td><td></td><td></td><td></td></tr><tr><td align="left">&#x02003;Calgary</td><td align="left">1270 (32%)</td><td align="left">0.58</td><td></td></tr><tr><td align="left">&#x02003;Edmonton</td><td align="left">1733 (44%)</td><td align="left">0.63</td><td></td></tr><tr><td align="left">&#x02003;Other Major City</td><td align="left">607 (15%)</td><td align="left">0.60</td><td></td></tr><tr><td align="left">&#x02003;Other</td><td align="left">308 (8%)</td><td align="left">0.55</td><td align="left">&#x0003c;0.0001</td></tr><tr><td align="left"><bold>Adjuvant therapy</bold></td><td></td><td></td><td></td></tr><tr><td align="left">&#x02003;Yes</td><td align="left">1049 (27%)</td><td align="left">0.72</td><td></td></tr><tr><td align="left">&#x02003;No</td><td align="left">2869 (93%)</td><td align="left">0.57</td><td align="left">&#x0003c;0.0001</td></tr><tr><td align="left"><bold>Cancer clinic visits</bold></td><td></td><td></td><td></td></tr><tr><td align="left">&#x02003;None</td><td align="left">1691 (43%)</td><td align="left">0.52</td><td></td></tr><tr><td align="left">&#x02003;1 &#x02013; 4</td><td align="left">1434 (37%)</td><td align="left">0.