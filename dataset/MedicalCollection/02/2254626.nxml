lic>Geobacter sulfurreducens </italic>fuel cells</article-title><source>Appl Environ Microbiol</source><year>2006</year><volume>72</volume><fpage>7345</fpage><lpage>7348</lpage><pub-id pub-id-type="pmid">16936064</pub-id><pub-id pub-id-type="doi">10.1128/AEM.01444-06</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burrell</surname><given-names>PC</given-names></name><name><surname>O'Sullivan</surname><given-names>C</given-names></name><name><surname>Song</surname><given-names>H</given-names></name><name><surname>Clarke</surname><given-names>WP</given-names></name><name><surname>Blackall</surname><given-names>LL</given-names></name></person-group><article-title>Identification, detection, and spatial resolution of <italic>Clostridium </italic>populations responsible for cellulose degradation in a methanogenic landfill leachate bioreactor</article-title><source>Appl Environ Microbiol</source><year>2004</year><volume>70</volume><fpage>2414</fpage><lpage>2419</lpage><pub-id pub-id-type="pmid">15066839</pub-id><pub-id pub-id-type="doi">10.1128/AEM.70.4.2414-2419.2004</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Song</surname><given-names>H</given-names></name><name><surname>Clarke</surname><given-names>WP</given-names></name><name><surname>Blackall</surname><given-names>LL</given-names></name></person-group><article-title>Concurrent microscopic observations and activity measurements of cellulose hydrolyzing and methanogenic populations during the batch anaerobic digestion of crystalline cellulose</article-title><source>Biotechnol Bioeng</source><year>2005</year><volume>91</volume><fpage>369</fpage><lpage>378</lpage><pub-id pub-id-type="pmid">15991234</pub-id><pub-id pub-id-type="doi">10.1002/bit.20517</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="auth