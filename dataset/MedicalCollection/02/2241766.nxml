-group-type="author"><name><surname>Simon</surname><given-names>BJ</given-names></name><name><surname>Legere</surname><given-names>P</given-names></name><name><surname>Emhoff</surname><given-names>T</given-names></name><name><surname>Fiallo</surname><given-names>VM</given-names></name><name><surname>Garb</surname><given-names>J</given-names></name></person-group><article-title>Vehicular trauma triage by mechanism: avoidance of the unproductive evaluation</article-title><source>J Trauma</source><year>1994</year><volume>37</volume><fpage>645</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">7932897</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Qazi</surname><given-names>K</given-names></name><name><surname>Wright</surname><given-names>MS</given-names></name><name><surname>Kippes</surname><given-names>C</given-names></name></person-group><article-title>Stable pediatric blunt trauma patients: is trauma team activation always necessary?</article-title><source>J Trauma</source><year>1998</year><volume>45</volume><fpage>562</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">9751551</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Walker</surname><given-names>PJ</given-names></name><name><surname>Cass</surname><given-names>DT</given-names></name></person-group><article-title>Paediatric trauma: urban epidemiology and an analysis of methods for assessing the severity of trauma in 598 injured children</article-title><source>Aust N Z J Surg</source><year>1987</year><volume>57</volume><fpage>715</fpage><lpage>22</lpage><pub-id pub-id-type="pmid">3426444</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Engum</surname><given-names>SA</given-names></name><name><surname>Mitchell</surname><given-names>MK</given-names></name><name><surname>Scherer