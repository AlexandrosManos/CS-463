tation publication-type="journal"><person-group person-group-type="author"><name><surname>Hofacker</surname><given-names>IL</given-names></name></person-group><article-title>Vienna RNA secondary structure server</article-title><source>Nucleic Acids Res.</source><year>2003</year><volume>31</volume><fpage>3429</fpage><lpage>3431</lpage><pub-id pub-id-type="pmid">12824340</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Brock</surname><given-names>JE</given-names></name><name><surname>Paz</surname><given-names>RL</given-names></name><name><surname>Cottle</surname><given-names>P</given-names></name><name><surname>Janssen</surname><given-names>GR</given-names></name></person-group><article-title>Naturally occurring adenines within mRNA coding sequences affect ribosome binding and expression in <italic>Escherichia coli</italic></article-title><source>J. Bacteriol.</source><year>2007</year><volume>189</volume><fpage>501</fpage><lpage>510</lpage><pub-id pub-id-type="pmid">17085569</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kaberdin</surname><given-names>VR</given-names></name><name><surname>Bl&#x000e4;si</surname><given-names>U</given-names></name></person-group><article-title>Translation initiation and the fate of bacterial mRNAs</article-title><source>FEMS Microbiol. Rev.</source><year>2006</year><volume>30</volume><fpage>967</fpage><lpage>979</lpage><pub-id pub-id-type="pmid">16989654</pub-id></element-citation></ref><ref id="B16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Storz</surname><given-names>G</given-names></name><name><surname>Opdyke</surname><given-names>JA</given-names></name><name><surname>Zhang</surname><given-names>A</given-names></name></person-gro