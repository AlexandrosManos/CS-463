p-type="author"><name><surname>Girault</surname><given-names>L</given-names></name></person-group><source>Kallawaya: Curanderos itinerantes de los Andes</source><year>1987</year><publisher-name>UNICEF-OPS-OMS, La Paz</publisher-name></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bastien</surname><given-names>J</given-names></name></person-group><source>Drum and Stethoscope: Integrating Ethnomedicine and Biomedicine in Bolivia</source><year>1992</year><publisher-name>University of Utah Press, Salt Lake City</publisher-name></citation></ref><ref id="B25"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bastien</surname><given-names>J</given-names></name></person-group><source>Healers of the Andes: Kallawaya Herbalists and Their Medicinal Plants</source><year>1987</year><publisher-name>University of Utah Press, Salt Lake City</publisher-name></citation></ref><ref id="B26"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Roersch</surname><given-names>C</given-names></name></person-group><source>Plantas Medicinales en el Sur Andino del Per&#x000fa;</source><year>1994</year><publisher-name>Koeltz Scientific Books, K&#x000f6;nigstein</publisher-name></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Prance</surname><given-names>GT</given-names></name></person-group><article-title>Ethnobotanical notes from Amazonian Brazil</article-title><source>Economic Botany</source><year>1972</year><volume>26</volume><fpage>221</fpage><lpage>233</lpage></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rutter</surname><given-names>RA</given-names></name></person-group><article-title>Cat&#x000e1;logo de plantas &#x000fa;tiles de la Amazon&#x000ed;a Peruana</article-title><source>Comunidades y Culturas Peruanas</source><year>1990</year><volume>22</volume><fpage>1</fpage><lpage>349</lpage></citation></ref><ref id="B29"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Duke</surname><given-names>J</given-names></name><name><surname>V&#x000e1;zquez</surname><given-names>J</given-names></name></person-group><source>Amazonian Ethnobotanical Dictionary</source><year>1994</year><publisher-name>CRC Press, Boca Raton</publisher-name></citation></ref><ref id="B30"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Polia</surname><given-names>M</given-names></name></person-group><source>Las Lagunas de los Encantos &#x02013; Medicina Tradicional Andina en el Peru septentrional</source><year>1988</year><publisher-name>Lima, CePeSer</publisher-name></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Feo</surname><given-names>V</given-names></name></person-group><article-title>Medicinal and magical plants on northern Peruvian Andes</article-title><source>Fitoterapia</source><year>1992</year><volume>63</volume><fpage>417</fpage><lpage>440</lpage></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Feo</surname><given-names>V</given-names></name></person-group><article-title>Ethnomedicinal field study in northern Peruvian Andes with particular reference to divination practices</article-title><source>Journal of Ethnopharmacology</source><year>2003</year><volume>85</volume><fpage>243</fpage><lpage>256</lpage><pub-id pub-id-type="pmid">12639748</pub-id><pub-id pub-id-type="doi">10.1016/S0378-8741(03)00017-5</pub-id></citation></ref><ref id="B33"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hammond</surname><given-names>GB</given-names></name><name><surname>Fern&#x000e1;ndez</surname><given-names>ID</given-names></name><name><surnam