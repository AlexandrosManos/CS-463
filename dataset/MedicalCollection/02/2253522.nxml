-group><article-title>Ottawa charter for health promotion</article-title><source>Can J Public Health</source><year>1986</year><volume>77</volume><fpage>425</fpage><lpage>430</lpage><pub-id pub-id-type="pmid">3580992</pub-id></citation></ref></ref-list></back></article>