up><article-title>Salvage radiotherapy for recurrent prostate cancer: the earlier the better</article-title><source>JAMA</source><year>2004</year><volume>291</volume><fpage>1380</fpage><lpage>1382</lpage><pub-id pub-id-type="pmid">15026405</pub-id><pub-id pub-id-type="doi">10.1001/jama.291.11.1380</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schmid</surname><given-names>HP</given-names></name><name><surname>McNeal</surname><given-names>JE</given-names></name><name><surname>Stamey</surname><given-names>TA</given-names></name></person-group><article-title>Observations on the doubling time of prostate cancer. The use of serial prostate-specific antigen in patients with untreated disease as a measure of increasing cancer volume</article-title><source>Cancer</source><year>1993</year><volume>71</volume><fpage>2031</fpage><lpage>2040</lpage><pub-id pub-id-type="pmid">7680277</pub-id><pub-id pub-id-type="doi">10.1002/1097-0142(19930315)71:6&#x0003c;2031::AID-CNCR2820710618&#x0003e;3.0.CO;2-Q</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cox</surname><given-names>JD</given-names></name><name><surname>Stetz</surname><given-names>J</given-names></name><name><surname>Pajak</surname><given-names>TF</given-names></name></person-group><article-title>Toxicity criteria of the Radiation Therapy Oncology Group (RTOG) and the European Organization for Research and Treatment of Cancer (EORTC)</article-title><source>Int J Radiat Oncol Biol Phys</source><year>1995</year><volume>31</volume><fpage>1341</fpage><lpage>1346</lpage><pub-id pub-id-type="pmid">7713792</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wei</surname><given-names>JT</given-names></name><name><surname>Dunn</surname><given-names>RL</given-names></name><name><surname>Litwin</surna