/pub-id><pub-id pub-id-type="doi">10.2165/00007256-200434080-00002</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chan</surname><given-names>TC</given-names></name><name><surname>Evans</surname><given-names>SD</given-names></name><name><surname>Clark</surname><given-names>RF</given-names></name></person-group><article-title>Drug-induced hyperthermia</article-title><source>Crit Care Clin</source><year>1997</year><volume>13</volume><fpage>785</fpage><lpage>808</lpage><pub-id pub-id-type="pmid">9330841</pub-id><pub-id pub-id-type="doi">10.1016/S0749-0704(05)70369-9</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sprague</surname><given-names>JE</given-names></name><name><surname>Moze</surname><given-names>P</given-names></name><name><surname>Caden</surname><given-names>D</given-names></name><name><surname>Rusyniak</surname><given-names>DE</given-names></name><name><surname>Holmes</surname><given-names>C</given-names></name><name><surname>Goldstein</surname><given-names>DS</given-names></name><name><surname>Mills</surname><given-names>EM</given-names></name></person-group><article-title>Carvedilol reverses hyperthermia and attenuates rhabdomyolysis induced by 3,4-methylenedioxymethamphetamine (MDMA, Ecstasy) in an animal model</article-title><source>Crit Care Med</source><year>2005</year><volume>33</volume><fpage>1311</fpage><lpage>1316</lpage><pub-id pub-id-type="pmid">15942349</pub-id><pub-id pub-id-type="doi">10.1097/01.CCM.0000165969.29002.70</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bernheim</surname><given-names>HA</given-names></name><name><surname>Block</surname><given-names>LH</given-names></name><name><surname>Atkins</surname><given-names>E</given-names></name></person-group><article-title>Fever: pathogenesis, path