<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">J Exp Med</journal-id><journal-title>The Journal of Experimental Medicine</journal-title><issn pub-type="ppub">0022-1007</issn><issn pub-type="epub">1540-9538</issn><publisher><publisher-name>The Rockefeller University Press</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">19870723</article-id><article-id pub-id-type="pmc">2133565</article-id><article-categories><subj-group subj-group-type="heading"><subject>Article</subject></subj-group></article-categories><title-group><article-title>CANINE DISTEMPER IN THE RHESUS MONKEY (MACACA MULATTA)</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Dalldorf</surname><given-names>Gilbert</given-names></name></contrib><contrib contrib-type="author"><name><surname>Douglass</surname><given-names>Margaret</given-names></name></contrib><contrib contrib-type="author"><name><surname>Robinson</surname><given-names>H. E.</given-names></name></contrib></contrib-group><aff id="N0x1cb7da0N0x32b09a0">From the Laboratories of Grasslands Hospital, Valhalla, New York</aff><pub-date pub-type="ppub"><day>31</day><month>1</month><year>1938</year></pub-date><volume>67</volume><issue>2</issue><fpage>323</fpage><lpage>332</lpage><history><date date-type="received"><day>9</day><month>11</month><year>1937</year></date></history><permissions><copyright-statement>Copyright &#x000a9; Copyright, 1938, by The Rockefeller Institute for Medical Research New York</copyright-statement></permissions><abstract><p> Canine distemper has been transmitted to <italic>rhesus</italic> monkeys by a variety of methods. The disease is strikingly similar if not identical in its features with distemper in dogs. </p></abstract></article-meta></front></article>