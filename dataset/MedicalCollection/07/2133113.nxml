diversity</article-title><source>Cell</source><year>1991</year><volume>67</volume><fpage>1033</fpage><lpage>1036</lpage><pub-id pub-id-type="pmid">1760836</pub-id></citation></ref><ref id="B7"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Edinger</surname><given-names>AL</given-names></name><name><surname>Mankowski</surname><given-names>JL</given-names></name><name><surname>Doranz</surname><given-names>BJ</given-names></name><name><surname>Margulies</surname><given-names>BJ</given-names></name><name><surname>Lee</surname><given-names>B</given-names></name><name><surname>Rucker</surname><given-names>J</given-names></name><name><surname>Sharron</surname><given-names>M</given-names></name><name><surname>Hoffman</surname><given-names>T</given-names></name><name><surname>Berson</surname><given-names>JF</given-names></name><name><surname>Zink</surname><given-names>MC</given-names></name><etal/></person-group><article-title>CD4-dependent, CCR5-dependent infection of brain capillary endothelial cells by a neurovirulent simian immunodeficiency virus strain</article-title><source>Proc  Natl Acad Sci USA</source><year>1997</year><volume>94</volume><fpage>14742</fpage><lpage>14747</lpage><pub-id pub-id-type="pmid">9405683</pub-id></citation></ref><ref id="B8"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Feil</surname><given-names>C</given-names></name><name><surname>Augustin</surname><given-names>HG</given-names></name></person-group><article-title>Endothelial cells differentially express functional CXC-chemokine receptor-4 (CXC-4/Fusin) under the control of autocrine activity and exogenous cytokines</article-title><source>Biochem Biophys Res  Commun</source><year>1998</year><volume>247</volume><fpage>38</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">9636650</pub-id></citation></ref><ref id="B9"><label>9</label><citation citation-type="journal"><person-gr