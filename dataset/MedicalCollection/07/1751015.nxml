-group><article-title>The comet-tail artifact: an ultrasound sign ruling out pneumothorax</article-title><source>Intensive Care Med</source><year>1999</year><volume>25</volume><fpage>383</fpage><lpage>388</lpage><pub-id pub-id-type="pmid">10342512</pub-id><pub-id pub-id-type="doi">10.1007/s001340050862</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blackbourne</surname><given-names>LH</given-names></name><name><surname>Soffer</surname><given-names>D</given-names></name><name><surname>McKenney</surname><given-names>M</given-names></name><name><surname>Amortegui</surname><given-names>J</given-names></name><name><surname>Schulman</surname><given-names>CI</given-names></name><name><surname>Crookes</surname><given-names>B</given-names></name><name><surname>Habib</surname><given-names>F</given-names></name><name><surname>Benjamin</surname><given-names>R</given-names></name><name><surname>Lopez</surname><given-names>PP</given-names></name><name><surname>Namias</surname><given-names>N</given-names></name><etal></etal></person-group><article-title>Secondary ultrasound examination increases the sensitivity of the FAST exam in blunt trauma</article-title><source>J Trauma</source><year>2004</year><volume>57</volume><fpage>934</fpage><lpage>938</lpage><pub-id pub-id-type="pmid">15580013</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Knudtson</surname><given-names>JL</given-names></name><name><surname>Dort</surname><given-names>JM</given-names></name><name><surname>Helmer</surname><given-names>SD</given-names></name><name><surname>Smith</surname><given-names>RS</given-names></name></person-group><article-title>Surgeon-performed ultrasound for pneumothorax in the trauma suite</article-title><source>J Trauma</source><year>2004</year><volume>56</volume><fpage>527</fpage><lpage>530</lpage><pub-id pub-id-type="pmid">1512812