r Clin North Am</source><year>2006</year><volume>29</volume><fpage>1115</fpage><lpage>30</lpage><comment>abstract xi</comment><pub-id pub-id-type="pmid">17118285</pub-id></element-citation></ref><ref id="ref13"><label>13</label><element-citation publication-type="journal"><article-title>NIH Consensus Conference. Drugs and Insomnia. The use of medications to promote sleep</article-title><source>JAMA</source><year>1984</year><volume>251</volume><fpage>2410</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">6142971</pub-id></element-citation></ref><ref id="ref14"><label>14</label><element-citation publication-type="book"><article-title>American Psychiatric Association. Diagnostic and statistical manual of mental disorders</article-title><source>text revision</source><year>2004</year><edition>4th edition</edition><publisher-loc>Washington DC</publisher-loc><publisher-name>American Psychiatric Press</publisher-name></element-citation></ref><ref id="ref15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Thase</surname><given-names>ME</given-names></name></person-group><article-title>Antidepressant treatment of the depressed patient with insomnia</article-title><source>J Clin Psychiatry</source><year>1999</year><volume>60</volume><issue>Suppl 17</issue><fpage>28</fpage><lpage>31</lpage><pub-id pub-id-type="pmid">10446739</pub-id></element-citation></ref><ref id="ref16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hirschfeld</surname><given-names>RM</given-names></name><name><surname>Mallinckrodt</surname><given-names>C</given-names></name><name><surname>Lee</surname><given-names>TC</given-names></name><name><surname>Detke</surname><given-names>MJ</given-names></name></person-group><article-title>Time course of depression-symptom improvement during treatment with duloxetine</article-title><source>Depress Anxiety</source><year>2005</ye