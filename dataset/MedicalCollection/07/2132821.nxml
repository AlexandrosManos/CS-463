><fpage>1789</fpage><lpage>1801</lpage><pub-id pub-id-type="pmid">8345183</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chang</surname><given-names>AC</given-names></name><name><surname>Salomon</surname><given-names>DR</given-names></name><name><surname>Wadsworth</surname><given-names>S</given-names></name><name><surname>Hong</surname><given-names>MJP</given-names></name><name><surname>Mojcik</surname><given-names>CF</given-names></name><name><surname>Otto</surname><given-names>S</given-names></name><name><surname>Shevach</surname><given-names>EM</given-names></name><name><surname>Coligan</surname><given-names>JE</given-names></name></person-group><article-title>&#x003b1;3&#x003b2;1 and &#x003b1;6&#x003b2;1 integrins mediate laminin/merosin binding and function as costimulatory molecules for human thymocyte proliferation</article-title><source>J Immunol</source><year>1995</year><volume>154</volume><fpage>500</fpage><lpage>510</lpage><pub-id pub-id-type="pmid">7814863</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chichester</surname><given-names>CO</given-names></name><name><surname>Fernandez</surname><given-names>M</given-names></name><name><surname>Minguell</surname><given-names>JJ</given-names></name></person-group><article-title>Extracellular matrix gene expression by human bone marrow fibroblasts</article-title><source>Cell Adhes Commun</source><year>1993</year><volume>1</volume><fpage>93</fpage><lpage>99</lpage><pub-id pub-id-type="pmid">8081879</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clark</surname><given-names>EA</given-names></name><name><surname>Brugge</surname><given-names>JS</given-names></name></person-group><article-title>Integrins and signal transduction pathways: the road taken</article-title><source>