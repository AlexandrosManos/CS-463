e-title>Prospective randomized trial of high-dose interleukin-2 alone or in conjunction with lymphokine-activated killer cells for the treatment of patients with advanced cancer</article-title><source>J Natl Cancer Inst</source><year>1993</year><volume>85</volume><fpage>622</fpage><lpage>32</lpage><comment>[Erratum in: J Natl Cancer Inst 1993;85:1091]</comment><pub-id pub-id-type="pmid">8468720</pub-id></citation></ref><ref id="b11-co14_6p238"><label>11</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hodge</surname><given-names>JW</given-names></name><name><surname>Schlom</surname><given-names>J</given-names></name><name><surname>Abrams</surname><given-names>SI</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Kufe</surname><given-names>DW</given-names></name><name><surname>Bast</surname><given-names>RC</given-names><suffix>Jr</suffix></name><name><surname>Hait</surname><given-names>WN</given-names></name><etal/></person-group><article-title>Vaccines and immuno-stimulants</article-title><source>Holland&#x02013;Frei Cancer Medicine 7</source><edition>7</edition><publisher-loc>Hamilton, ON</publisher-loc><publisher-name>BD Decker</publisher-name><year>2006</year><fpage>786</fpage><lpage>801</lpage></citation></ref><ref id="b12-co14_6p238"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Slovin</surname><given-names>SF</given-names></name><name><surname>Wilton</surname><given-names>AS</given-names></name><name><surname>Heller</surname><given-names>G</given-names></name><name><surname>Scher</surname><given-names>HI</given-names></name></person-group><article-title>Time to detectable metastatic disease in patients with rising prostate-specific antigen values following surgery or radiation therapy</article-title><source>Clin Cancer Res</source><year>2005</year><volume>11</volume><fpage>8669</fpage><lpage>73</lpage><pub-id pub-id-