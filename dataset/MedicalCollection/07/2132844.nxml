ion></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Franke</surname><given-names>WW</given-names></name></person-group><article-title>Matthias Jacob Schleiden and the definition of the cell nucleus</article-title><source>Eur J Cell Biol</source><year>1988</year><volume>47</volume><fpage>145</fpage><lpage>156</lpage><pub-id pub-id-type="pmid">3072200</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gallagher</surname><given-names>IM</given-names></name><name><surname>Alfa</surname><given-names>CE</given-names></name><name><surname>Hyams</surname><given-names>JS</given-names></name></person-group><article-title>p63<sup>cdc13</sup>, a B-type cyclin, is associated with both the nucleolar and chromatin domains of the fission yeast nucleus</article-title><source>Mol Biol Cell</source><year>1993</year><volume>4</volume><fpage>1087</fpage><lpage>1096</lpage><pub-id pub-id-type="pmid">8305731</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goeckeler</surname><given-names>J</given-names></name><name><surname>Brodsky</surname><given-names>JL</given-names></name><name><surname>Walsh</surname><given-names>C</given-names></name></person-group><article-title>Cloning, sequencing and expression of the MTOC associated nucleolar protein BN46/51 reveals similarity to FK506 binding proteins</article-title><source>Mol Biol Cell</source><year>1997</year><volume>8</volume><fpage>217a</fpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Han</surname><given-names>T-M</given-names></name><name><surname>Runnegar</surname><given-names>B</given-names></name></person-group><article-title>Megascopic eukaryotic algae from the 2.1-billion-year-old Negaunee iron-formation, Michigan</article-title><source>Sci