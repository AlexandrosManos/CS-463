n citation-type="journal"><person-group person-group-type="author"><name><surname>Inoue</surname><given-names>S</given-names></name><name><surname>Salmon</surname><given-names>ED</given-names></name></person-group><article-title>Force generation by microtubule assembly/ disassembly in mitosis and related movements</article-title><source>Mol Biol Cell</source><year>1995</year><volume>6</volume><fpage>1619</fpage><lpage>1640</lpage><pub-id pub-id-type="pmid">8590794</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liao</surname><given-names>H</given-names></name><name><surname>Li</surname><given-names>G</given-names></name><name><surname>Yen</surname><given-names>TJ</given-names></name></person-group><article-title>Mitotic regulation of microtubule crosslinking activity of CENP-E kinetochore protein</article-title><source>Science</source><year>1994</year><volume>265</volume><fpage>394</fpage><lpage>398</lpage><pub-id pub-id-type="pmid">8023161</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lombillo</surname><given-names>VA</given-names></name><name><surname>Nislow</surname><given-names>C</given-names></name><name><surname>Yen</surname><given-names>TJ</given-names></name><name><surname>Gelfand</surname><given-names>VI</given-names></name><name><surname>McIntosh</surname><given-names>JR</given-names></name></person-group><article-title>Antibodies to the kinesin motor domain and CENP-E inhibit microtubule depolymerization-dependent motion of chromosomes in vitro</article-title><source>J Cell Biol</source><year>1995</year><volume>128</volume><fpage>107</fpage><lpage>115</lpage><pub-id pub-id-type="pmid">7822408</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McEwen</surname><given-names>BF</given-names></name><name><surname>Heagle</surname><given-names>AB</given-names></name><name><surname>Cassels</surname><given-names>GO</given-names></name><name><surname>Buttle</surname><given-names>KF</given-names></name><name><surname>Rieder</surname><given-names>CL</given-names></name></person-group><article-title>Kinetochore fiber maturation in PtK<sub>1</sub>cells and its implications for the mechanism of chromosome congression and anaphase onset</article-title><source>J Cell Biol</source><year>1997</year><volume>137</volume><fpage>1567</fpage><lpage>1580</lpage><pub-id pub-id-type="pmid">9199171</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McIntosh</surname><given-names>JR</given-names></name></person-group><article-title>Structural and mechanical control of mitotic progression</article-title><source>Cold Spring Harbor Symp Quant Biol</source><year>1991</year><volume>56</volume><fpage>613</fpage><lpage>619</lpage><pub-id pub-id-type="pmid">1819511</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mitchison</surname><given-names>TJ</given-names></name><name><surname>Evans</surname><given-names>L</given-names></name><name><surname>Schultze</surname><given-names>E</given-names></name><name><surname>Kirschner</surname><given-names>MW</given-names></name></person-group><article-title>Sites of microtubule assembly and disassembly in the mitotic spindle</article-title><source>Cell</source><year>1986</year><volume>45</volume><fpage>515</fpage><lpage>527</lpage><pub-id pub-id-type="pmid">3708686</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nicklas</surname><given-names>RB</given-names></name></person-group><article-title>The forces that move chromosomes in mitosis</article-title><source>Annu Rev  Biophys Chem</source><year>1988</year><volume>17</volume><fpage>431</fpage><lpage>449</lpage><pub-id pub-id-type="pmid">3293594</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nicklas</surname><given-names>RB</given-names></name></person-group><article-title>How cells get the right chromosomes</article-title><source>Science</source><year>1997</year><volume>275</volume><fpage>632</fpage><lpage>637</lpage><pub-id pub-id-type="pmid">9005842</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nicklas</surname><given-names>RB</given-names></name><name><surname>Kubai</surname><given-names>DF</given-names></name></person-group><article-title>Microtubules, chromosome movement, and reorientation after chromosomes are detached from the spindle by micromanipulation</article-title><source>Chromosoma (Berl)</source><year>1985</year><volume>92</volume><fpage>313</fpage><lpage>324</lpage><pub-id pub-id-type="pmid">4042772</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nicklas</surname><given-names>RB</given-names></name><name><surname>Ward</surname><given-names>SC</given-names></name></person-group><article-title>Elements of error correction in mitosis: microtubule capture, release, and tension</article-title><source>J Cell Biol</source><year>1994</year><volume>126</volume><fpage>1241</fpage><lpage>1253</lpage><pub-id pub-id-type="pmid">8063861</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pfarr</surname><given-names>CM</given-names></name><name><surname>Coue</surname><given-names>M</given-names></name><name><surname>Grissom</surname><given-names>PM</given-names></name><name><surname>Hays</surname><given-names>TS</given-names></name><name><surname>Porter</surname><given-names>ME</given-names></name><name><surname>McIntosh</surname><give