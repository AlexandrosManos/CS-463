e><pub-id pub-id-type="pmid">8858167</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Erdmann</surname><given-names>R</given-names></name><name><surname>Kunau</surname><given-names>W-H</given-names></name></person-group><article-title>Purification and immunolocalization of  the peroxisomal 3-oxoacyl-CoA thiolase from <italic>Saccharomyces cerevisiae.  </italic></article-title><source>Yeast</source><year>1994</year><volume>10</volume><fpage>1173</fpage><lpage>1182</lpage><pub-id pub-id-type="pmid">7754706</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Erdmann</surname><given-names>R</given-names></name><name><surname>Veenhuis</surname><given-names>M</given-names></name><name><surname>Mertens</surname><given-names>D</given-names></name><name><surname>Kunau</surname><given-names>W-H</given-names></name></person-group><article-title>Isolation of  peroxisome-deficient mutants of <italic>Saccharomyces cerevisiae. </italic></article-title><source>Proc Natl Acad  Sci USA</source><year>1989</year><volume>86</volume><fpage>5419</fpage><lpage>5423</lpage><pub-id pub-id-type="pmid">2568633</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Erdmann</surname><given-names>R</given-names></name><name><surname>Veenhuis</surname><given-names>M</given-names></name><name><surname>Kunau</surname><given-names>W-H</given-names></name></person-group><article-title>Peroxisomes: organelles at the cross-road</article-title><source>Trends Cell Biol</source><year>1997</year><volume>7</volume><fpage>400</fpage><lpage>407</lpage><pub-id pub-id-type="pmid">17708989</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fields</surname><given-names>S</given-names></name><name><surname>Song<