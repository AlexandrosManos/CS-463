-id></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><name><surname>Gray</surname><given-names>J</given-names></name><name><surname>Garstin</surname><given-names>I</given-names></name><article-title>Intestinal obstruction following blunt abdominal trauma</article-title><source>Ulster Med J</source><year>2002</year><volume>71</volume><issue>2</issue><fpage>139</fpage><lpage>141</lpage><pub-id pub-id-type="pmid">12513012</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><name><surname>Marks</surname><given-names>CG</given-names></name><name><surname>Nolan</surname><given-names>DJ</given-names></name><name><surname>Piris</surname><given-names>J</given-names></name><name><surname>Webster</surname><given-names>CU</given-names></name><article-title>Small bowel strictures after blunt abdominal trauma</article-title><source>Br J Surg</source><year>1979</year><volume>66</volume><fpage>663</fpage><lpage>664</lpage><pub-id pub-id-type="doi">10.1002/bjs.1800660922</pub-id><pub-id pub-id-type="pmid">497658</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Foster</surname><given-names>ME</given-names></name><name><surname>Clarke</surname><given-names>S</given-names></name><name><surname>Griffiths</surname><given-names>D</given-names></name><article-title>Post-traumatic small bowel stenosis</article-title><source>J R Coll Surg Edinb</source><year>1984</year><volume>29</volume><fpage>256</fpage><lpage>257</lpage><pub-id pub-id-type="pmid">6481680</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Tsushima</surname><given-names>Y</given-names></name><name><surname>Yamada</surname><given-names>S</given-names></name><name><surname>Aoki</surname><given-names>J</given-names></name><name><surname>Endo</surname><given-names>K</given-names></name><article-title>Ischaemic ileal stenosis following blunt abdominal trauma and demonstrated by CT</article-title><source>Br J Radiol</source><year>2001</year><volume>74</volume><issue>879</issue><fpage>277</fpage><lpage>27</lpage><pub-id pub-id-type="pmid">11338108</pub-id></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="journal"><name><surname>Kearney</surname><given-names>PA</given-names><suffix>Jr</suffix></name><name><surname>Vahey</surname><given-names>T</given-names></name><name><surname>Burney</surname><given-names>RE</given-names></name><name><surname>Glazer</surname><given-names>G</given-names></name><article-title>Computed tomography and diagnostic peritoneal lavage in blunt abdominal trauma. Their combined role</article-title><source>Arch Surg</source><year>1989</year><volume>124</volume><fpage>344</fpage><lpage>347</lpage><pub-id pub-id-type="pmid">2919967</pub-id></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="journal"><name><surname>Liu</surname><given-names>M</given-names></name><name><surname>Lee</surname><given-names>CH</given-names></name><name><surname>P'Eng</surname><given-names>FK</given-names></name><article-title>Prospective comparison of diagnostic peritoneal lavage, computed tomographic scanning, and ultrasonography for the diagnosis of blunt abdominal trauma</article-title><source>J Trauma</source><year>1993</year><volume>35</volume><fpage>267</fpage><lpage>270</lpage><pub-id pub-id-type="doi">10.1097/00005373-199308000-00016</pub-id><pub-id pub-id-type="pmid">8355307</pub-id></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="journal"><name><surname>Banz</surname><given-names>VM</given-names></name><name><surname>Butt</surname><given-names>MU</given-names></name><name><surname>Zimmermann</surname><given-names>H</given-names></name><name><surname>Jeger</surname><given-names>V</given-names></name><name><surname>Exadaktylos</surname><given-names>AK</given-names></name><article-title>Free abdominal fluid without obvious solid organ injury upon CT imaging: an actual problem or simply over-diagnosing?</article-title><source>J Trauma Manag Outcomes</source><year>2009</year><volume>3</volume><fpage>10</fpage><pub-id pub-id-type="doi">10.1186/1752-2897-3-10</pub-id><pub-id pub-id-type="pmid">20003480</pub-id></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="journal"><name><surname>Rodriguez</surname><given-names>C</given-names></name><name><surname>Barone</surname><given-names>JE</given-names></name><name><surname>Wilbanks</surname><given-names>TO</given-names></name><name><surname>Rha</surname><given-names>CK</given-names></name><name><surname>Miller</surname><given-names>K</given-names></name><article-title>Isolated free fluid on computed tomographic scan in blunt abdominal trauma: a systematic review of incidence and management</article-title><source>J Trauma</source><year>2002</year><volume>53</volume><fpage>79</fpage><lpage>85</lpage><pub-id pub-id-type="doi">10.1097/00005373-200207000-00016</pub-id><pub-id pub-id-type="pmid">12131394</pub-id></mixed-citation></ref><ref id="B19"><mixed-citation publication-type="journal"><name><surname>Brasel</surname><given-names>KJ</given-names></name><name><surname>Olson</surname><given-names>CJ</given-names></name><name><surname>Stafford</surname><given-names>RE</given-names></name><name><surname>Johnson</surname><given-names>TJ</given-names></name><article-title>Incidence and significance of free fluid on abdominal computed tomographic scan in blunt trauma</article-title><source>J Trauma</source><year>1998</year><volume>44</volume><fpage>889</fpage><lpage>892</lpage><pub-id pub-id-type="doi">10.1097/00005373-199805000-00024</pub-id><pub-id pub-id-type="pmid">9603094</pub-id></mixed-citation></ref><ref id="B20"><mixed-citation publication-type="journal"><name><surname>Lane</surname><given-names>TM</given-names></name><article-title>Small bowel obstruction after blunt trauma</article-title><source>J R Soc Med</source><year>2000</year><volume>93</volume><issue>9</issue><fpage>498</fpage><pub-id pub-id-type="pmid">11089491</pub-id></mixed-citation></ref></ref-list></back></article>