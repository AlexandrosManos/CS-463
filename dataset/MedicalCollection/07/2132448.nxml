</sup></td><td align="center" valign="top" charoff="50"><bold>2.6&#x000b1;0.9 &#x000d7; 10<sup>2</sup></bold></td><td align="left" valign="top" charoff="50">A87</td><td align="left" valign="top" charoff="50">con0</td><td align="left" valign="top" charoff="50">TTGACA</td><td align="left" valign="top" charoff="50">ara1</td><td align="left" valign="top" charoff="50">GATACT</td><td align="left" valign="top" charoff="50"><bold>lac4</bold></td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">58&#x000b1;17</td><td align="left" valign="top" charoff="50">3.6&#x000b1;0.3 &#x000d7; 10<sup>4</sup></td><td align="center" valign="top" charoff="50"><bold>6.2&#x000b1;1.9 &#x000d7; 10<sup>2</sup></bold></td><td align="left" valign="top" charoff="50">A52</td><td align="left" valign="top" charoff="50"><bold>lac1</bold></td><td align="left" valign="top" charoff="50">TTGACA</td><td align="left" valign="top" charoff="50">ara1</td><td align="left" valign="top" charoff="50">GATACT</td><td align="left" valign="top" charoff="50"><bold>con1</bold></td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">LuxR</td><td align="center" valign="top" charoff="50">130&#x000b1;50</td><td align="left" valign="top" charoff="50">1.4&#x000b1;0.1 &#x000d7; 10<sup>5</sup></td><td align="center" valign="top" charoff="50"><bold>1.1&#x000b1;0.5 &#x000d7; 10<sup>3</sup></bold></td><td align="left" valign="top" charoff="50">D49</td><td align="left" valign="top" charoff="50"><bold>lux1</bold></td><td align="left" valign="top" charoff="50">TTTACT</td><td align="left" valign="top" charoff="50">con2</td><td align="left" valign="top" charoff="50">GATAAT</td><td align="left" valign="top" charoff="50">lux2</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">420&#x000b1;310</td><td align="left" valign="top" charoff="50">9.7&#x000b1;2.3 &#x000d7; 10<sup>4</sup></td><td align="center" valign="top" charoff="50"><bold>230&#x000b1;180</bold></td><td align="left" valign="top" charoff="50">D80</td><td align="left" valign="top" charoff="50"><bold>lux3</bold></td><td align="left" valign="top" charoff="50">TTTACA</td><td align="left" valign="top" charoff="50">lux2</td><td align="left" valign="top" charoff="50">TATAAT</td><td align="left" valign="top" charoff="50">con3</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">AraC</td><td align="center" valign="top" charoff="50">310&#x000b1;60</td><td align="left" valign="top" charoff="50">7.3&#x000b1;0.9 &#x000d7; 10<sup>4</sup></td><td align="center" valign="top" charoff="50"><bold>230&#x000b1;50</bold></td><td align="left" valign="top" charoff="50">A79</td><td align="left" valign="top" charoff="50"><bold>ara2</bold></td><td align="left" valign="top" charoff="50">TAGACA</td><td align="left" valign="top" charoff="50">ara1</td><td align="left" valign="top" charoff="50">GATACT</td><td align="left" valign="top" charoff="50">lux2</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">250&#x000b1;30</td><td align="left" valign="top" charoff="50">2.8&#x000b1;0.6 &#x000d7; 10<sup>4</sup></td><td align="center" valign="top" charoff="50"><bold>110&#x000b1;30</bold></td><td align="left" valign="top" charoff="50">A1</td><td align="left" valign="top" charoff="50"><bold>ara2</bold></td><td align="left" valign="top" charoff="50">TAGACT</td><td align="left" valign="top" charoff="50">con2</td><td align="left" valign="top" charoff="50">GATAAT</td><td align="left" valign="top" charoff="50">con1</td></tr></tbody></table><table-wrap-foot><fn id="t1-fn1"><p><sup>a</sup>The genotype refers to the three units that make up each promoter and the &#x02212;10 and &#x02212;35 polymerase boxes. Here, con, tet, lac, ara, and lux refer to no operator, and TetR, LacI, AraC, and LuxR operators. In each case, the number refers to the operator variant. Full sequences for each unit are available in <xref ref-type="supplementary-material" rid="S1">Supplementary Table S1</xref>. Functional operators are highlighted in bold.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>