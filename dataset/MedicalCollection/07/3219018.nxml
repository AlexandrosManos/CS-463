-id-type="pmid">17331245</pub-id></mixed-citation></ref><ref id="B7"><mixed-citation publication-type="journal"><name><surname>Oz&#x000e7;akar</surname><given-names>ZB</given-names></name><name><surname>Yal&#x000e7;inkaya</surname><given-names>F</given-names></name><name><surname>Altas</surname><given-names>B</given-names></name><name><surname>Erg&#x000fc;n</surname><given-names>H</given-names></name><name><surname>Kendirli</surname><given-names>T</given-names></name><name><surname>Ate&#x0015f;</surname><given-names>C</given-names></name><name><surname>Elhan</surname><given-names>AH</given-names></name><name><surname>Ekim</surname><given-names>M</given-names></name><article-title>Application of the new classification criteria of the Acute Kidney Injury Network: a pilot study in a pediatric population</article-title><source>Pediatr Nephrol</source><year>2009</year><volume>24</volume><fpage>1379</fpage><lpage>1384</lpage><pub-id pub-id-type="doi">10.1007/s00467-009-1158-1</pub-id><pub-id pub-id-type="pmid">19308461</pub-id></mixed-citation></ref><ref id="B8"><mixed-citation publication-type="journal"><name><surname>Schneider</surname><given-names>J</given-names></name><name><surname>Khemani</surname><given-names>R</given-names></name><name><surname>Grushkin</surname><given-names>C</given-names></name><name><surname>Bart</surname><given-names>R</given-names></name><article-title>Serum creatinine as stratified in the RIFLE score for acute kidney injury is associated with mortality and length of stay for children in the pediatric intensive care unit</article-title><source>Crit Care Med</source><year>2010</year><volume>38</volume><fpage>933</fpage><lpage>939</lpage><pub-id pub-id-type="doi">10.1097/CCM.0b013e3181cd12e1</pub-id><pub-id pub-id-type="pmid">20124891</pub-id></mixed-citation></ref><ref id="B9"><mixed-citation publication-type="journal"><name><surname>Plotz</surname><given-names>FB</given-names></name><name><surname>Bouma</surname><given-names>AB</given-names><