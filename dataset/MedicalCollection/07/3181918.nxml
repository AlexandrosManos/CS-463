cognitive decline.</article-title><source><italic>Am J Psychiatry.</italic></source><year>2003</year><volume>160</volume><fpage>379</fpage><lpage>382</lpage><pub-id pub-id-type="pmid">12562591</pub-id></element-citation></ref><ref id="ref7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Pantel</surname><given-names>J.</given-names></name><name><surname>O'Leary</surname><given-names>DS.</given-names></name><name><surname>Cretsinger</surname><given-names>K.</given-names></name><name><surname>et al.</surname></name></person-group><article-title>A new method for the in vivo volumetric measurement of the human hippocampus with high neuroanatomical accuracy.</article-title><source><italic>Hippocampus.</italic></source><year>2000</year><volume>10</volume><fpage>752</fpage><lpage>758</lpage><pub-id pub-id-type="pmid">11153720</pub-id></element-citation></ref><ref id="ref8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ewers</surname><given-names>M.</given-names></name><name><surname>Teipel</surname><given-names>SJ.</given-names></name><name><surname>Dietrich</surname><given-names>O.</given-names></name><name><surname>et al.</surname></name></person-group><article-title>Multicenter assessment of reliability of cranial MRI.</article-title><source><italic>Neurobiol Aging.</italic></source><year>2006</year><volume>27</volume><fpage>1051</fpage><lpage>1059</lpage><pub-id pub-id-type="pmid">16169126</pub-id></element-citation></ref><ref id="ref9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jack</surname><given-names>CR.</given-names></name><name><surname>Petersen</surname><given-names>RC.</given-names></name><name><surname>Xu</surname><given-names>Y.</given-names></name><name><surname>et al.</surname></name></person-group><article-title>Rate of medial temporal lobe atro