group><article-title>Transcriptiondependent redistribution of the large subunit of RNA polymerase II to discrete nuclear domains</article-title><source>J Cell Biol</source><year>1995</year><volume>129</volume><fpage>287</fpage><lpage>298</lpage><pub-id pub-id-type="pmid">7536746</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buratowski</surname><given-names>S</given-names></name><name><surname>Sharp</surname><given-names>PA</given-names></name></person-group><article-title>Transcription initiation complexes and upstream activation with RNA polymerase II lacking the C-terminal domain of the largest subunit</article-title><source>Mol Cell Biol</source><year>1990</year><volume>10</volume><fpage>5562</fpage><lpage>5564</lpage><pub-id pub-id-type="pmid">2398901</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cadena</surname><given-names>DL</given-names></name><name><surname>Dahmus</surname><given-names>ME</given-names></name></person-group><article-title>Messenger RNA synthesis in mammalian cells is catalyzed by the phosphorylated form of RNA polymerase II</article-title><source>J  Biol Chem</source><year>1987</year><volume>262</volume><fpage>12468</fpage><lpage>12474</lpage><pub-id pub-id-type="pmid">3624268</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chesnut</surname><given-names>JD</given-names></name><name><surname>Stephens</surname><given-names>JH</given-names></name><name><surname>Dahmus</surname><given-names>ME</given-names></name></person-group><article-title>Messenger RNA synthesis in mammalian cells is catalyzed by the phosphorylated form of RNA polymerase II</article-title><source>J Biol Chem</source><year>1992</year><volume>267</volume><fpage>10500</fpage><lpage>10506</lpage><pub-id pub-id-type="pmid">1316903</pub-i