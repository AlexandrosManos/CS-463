;</sup>hematopoietic progenitor cells</article-title><source>J Immunol</source><year>1994</year><volume>153</volume><fpage>4673</fpage><lpage>4683</lpage><pub-id pub-id-type="pmid">7525710</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lu</surname><given-names>TT</given-names></name><name><surname>Yang</surname><given-names>LG</given-names></name><name><surname>Madri</surname><given-names>JA</given-names></name></person-group><article-title>Integrin engagement mediates tyrosine dephosphorylation on platelet-endothelial cell adhesion molecule-1</article-title><source>Proc Natl Acad Sci USA</source><year>1996</year><volume>93</volume><fpage>11808</fpage><lpage>11813</lpage><pub-id pub-id-type="pmid">8876219</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lu</surname><given-names>TT</given-names></name><name><surname>Barreuther</surname><given-names>M</given-names></name><name><surname>Davis</surname><given-names>S</given-names></name><name><surname>Madri</surname><given-names>JA</given-names></name></person-group><article-title>Platelet-endothelial cell adhesion molecule-1 (PECAM-1/CD31) is phosphorylatable by C-SRC, binds SRC-SH2 domain and exhibits itam-like properties</article-title><source>J Biol Chem</source><year>1997</year><volume>272</volume><fpage>14442</fpage><lpage>14446</lpage><pub-id pub-id-type="pmid">9162084</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matsumura</surname><given-names>T</given-names></name><name><surname>Wolff</surname><given-names>K</given-names></name><name><surname>Petzelbauer</surname><given-names>P</given-names></name></person-group><article-title>Endothelial cell tube formation depends on cadherin 5 and CD31 interactions with filamentous actin</article-title><source>J  Immunol</source><yea