erson-group-type="author"><name><surname>Danner</surname><given-names>RL</given-names></name><name><surname>Elin</surname><given-names>RJ</given-names></name><name><surname>Hosseini</surname><given-names>JM</given-names></name><name><surname>Wesley</surname><given-names>RA</given-names></name><name><surname>Reilly</surname><given-names>JM</given-names></name><name><surname>Parillo</surname><given-names>JE</given-names></name></person-group><article-title>Endotoxemia in human septic shock</article-title><source>Chest</source><year>1991</year><volume>99</volume><fpage>169</fpage><lpage>175</lpage><pub-id pub-id-type="pmid">1984950</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marshall</surname><given-names>JC</given-names></name><name><surname>Foster</surname><given-names>D</given-names></name><name><surname>Vincent</surname><given-names>JL</given-names></name><name><surname>Cook</surname><given-names>DJ</given-names></name><name><surname>Cohen</surname><given-names>J</given-names></name><name><surname>Dellinger</surname><given-names>RP</given-names></name><name><surname>Opal</surname><given-names>S</given-names></name><name><surname>Abraham</surname><given-names>E</given-names></name><name><surname>Brett</surname><given-names>SJ</given-names></name><name><surname>Smith</surname><given-names>T</given-names></name><etal></etal></person-group><article-title>Diagnostic and prognostic implications of endotoxemia in critical illness: results of the MEDIC study</article-title><source>J Infect Dis</source><year>2004</year><volume>190</volume><fpage>527</fpage><lpage>534</lpage><pub-id pub-id-type="pmid">15243928</pub-id><pub-id pub-id-type="doi">10.1086/422254</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martin</surname><given-names>TR</given-names></name><name><surname>Rubenfeld</surname><given-names>GD</given