n-names></name><name><surname>Vitiello</surname><given-names>G</given-names></name></person-group><article-title>Water as a free electric dipole laser</article-title><source>Phys Rev Lett</source><year>1988</year><volume>61</volume><fpage>1085</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">10039515</pub-id></citation></ref><ref id="b9-co14_6p221"><label>9</label><citation citation-type="confproc"><collab>Medicines and Healthcare Products Regulatory Agency (<sc>mhra</sc>)</collab><source>Investigations into Adverse Incidents During Clinical Trials of TGN1412</source><conf-name>Clinical trial final report</conf-name><publisher-loc>London, U.K.</publisher-loc><publisher-name>MHRA</publisher-name><conf-date>May 25, 2006</conf-date></citation></ref><ref id="b10-co14_6p221"><label>10</label><citation citation-type="confproc"><collab>Great Britain, House of Commons, Committee of Public Accounts</collab><source>A Safer Place for Patients: Learning to Improve Patient Safety</source><conf-name>Fifty-first report of session 2005&#x02013;06</conf-name><publisher-loc>London, U.K.</publisher-loc><publisher-name>The Stationery Office</publisher-name><conf-date>July 6, 2006</conf-date></citation></ref><ref id="b11-co14_6p221"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shang</surname><given-names>A</given-names></name><name><surname>Huwiler&#x02013;M&#x000fc;ntener</surname><given-names>K</given-names></name><name><surname>Nartey</surname><given-names>L</given-names></name><etal/></person-group><article-title>Are the clinical effects of homeopathy placebo effects? Comparative study of placebo-controlled trials of homeopathy and allopathy</article-title><source>Lancet</source><year>2005</year><volume>366</volume><fpage>726</fpage><lpage>32</lpage><pub-id pub-id-type="pmid">16125589</pub-id></citation></ref><ref id="b12-co14_6p221"><label>12</label><citation citation-type="journal"><person-group person-group-type="auth