 citation-type="journal"><person-group person-group-type="author"><name><surname>Herzinger</surname><given-names>T</given-names></name><name><surname>Funk</surname><given-names>JO</given-names></name><name><surname>Hillmer</surname><given-names>K</given-names></name><name><surname>Eick</surname><given-names>D</given-names></name><name><surname>Wolf</surname><given-names>DA</given-names></name><name><surname>Kind</surname><given-names>P</given-names></name></person-group><article-title>Ultraviolet B irradiation-induced G2 cell cycle arrest in human keratinocytes by inhibitory phosphorylation of the cdc2 cell cycle kinase</article-title><source>Oncogene</source><year>1995</year><volume>11</volume><fpage>2151</fpage><lpage>2156</lpage><pub-id pub-id-type="pmid">7478536</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hofmann</surname><given-names>J</given-names></name><name><surname>O'Connor</surname><given-names>PM</given-names></name><name><surname>Jackman</surname><given-names>J</given-names></name><name><surname>Schubert</surname><given-names>C</given-names></name><name><surname>Ueberall</surname><given-names>F</given-names></name><name><surname>Kohn</surname><given-names>WK</given-names></name><name><surname>Grunicke</surname><given-names>H</given-names></name></person-group><article-title>The protein kinase C inhibitor ilmofosine (BM41 440) arrests cells in G2 phase and suppresses CDC2 kinase activation through a mechanism different from that of DNA damaging agents</article-title><source>Biochem Biophys Res Comm</source><year>1994</year><volume>199</volume><fpage>937</fpage><lpage>942</lpage><pub-id pub-id-type="pmid">8135843</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Holloway</surname><given-names>SL</given-names></name><name><surname>Glotzer</surname><given-names>M</given-names></name><name><surnam