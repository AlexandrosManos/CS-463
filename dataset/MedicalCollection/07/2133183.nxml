son-group person-group-type="author"><name><surname>Brown</surname><given-names>MC</given-names></name><name><surname>Perrotta</surname><given-names>JA</given-names></name><name><surname>Turner</surname><given-names>CE</given-names></name></person-group><article-title>Identification of LIM3 as the principal determinant of paxillin focal adhesion localization and characterization of a novel motif on paxillin directing vinculin and FAK binding</article-title><source>J  Cell Biol</source><year>1996</year><volume>135</volume><fpage>1109</fpage><lpage>1124</lpage><pub-id pub-id-type="pmid">8922390</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>MC</given-names></name><name><surname>Perrotta</surname><given-names>JA</given-names></name><name><surname>Turner</surname><given-names>CE</given-names></name></person-group><article-title>Serine and threonine phosphorylation of the paxillin LIM domains regulates paxillin focal adhesion localization and cell adhesion to fibronectin</article-title><source>Mol Biol Cell</source><year>1998a</year><volume>9</volume><fpage>1803</fpage><lpage>1816</lpage><pub-id pub-id-type="pmid">9658172</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>MC</given-names></name><name><surname>Curtis</surname><given-names>MS</given-names></name><name><surname>Turner</surname><given-names>CE</given-names></name></person-group><article-title>Paxillin LD motifs may define a new family of protein recognition domains</article-title><source>Nature Struct Biol</source><year>1998b</year><volume>5</volume><fpage>677</fpage><lpage>678</lpage><pub-id pub-id-type="pmid">9699628</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>MT</given-names></name><name><surname>Andrad</surname><given-names>J</given-names></name><name><surname>Radhakrishna</surname><given-names>H</given-names></name><name><surname>Donaldson</surname><given-names>JG</given-names></name><name><surname>Cooper</surname><given-names>JA</given-names></name><name><surname>Randazzo</surname><given-names>PA</given-names></name></person-group><article-title>ASAP1, a phospholipid-dependent Arf GTPase-activating protein that associates with and is phosphorylated by Src</article-title><source>Mol Cell  Biol</source><year>1998c</year><volume>18</volume><fpage>7038</fpage><lpage>7051</lpage><pub-id pub-id-type="pmid">9819391</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burridge</surname><given-names>K</given-names></name><name><surname>Chrzanowska-Wodnicka</surname><given-names>M</given-names></name></person-group><article-title>Focal adhesions, contractility and signaling</article-title><source>Ann Rev Cell Biol</source><year>1996</year><volume>12</volume><fpage>463</fpage><lpage>518</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burridge</surname><given-names>K</given-names></name><name><surname>Turner</surname><given-names>CE</given-names></name><name><surname>Romer</surname><given-names>LH</given-names></name></person-group><article-title>Tyrosine phosphorylation of  paxillin and pp125<sup>FAK</sup>accompanies cell adhesion to extracellular matrix: a role in cytoskeletal assembly</article-title><source>J Cell Biol</source><year>1992</year><volume>119</volume><fpage>893</fpage><lpage>903</lpage><pub-id pub-id-type="pmid">1385444</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cary</surname><given-names>LA</given-names></name><name><surname>Chang</surname><given-names>JF</given-names></name><name><surname>Guan</su