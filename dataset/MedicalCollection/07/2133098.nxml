e><lpage>9</lpage><pub-id pub-id-type="pmid">11156525</pub-id></citation></ref><ref id="b23-co14_6p246"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hanahan</surname><given-names>D</given-names></name><name><surname>Folkman</surname><given-names>J</given-names></name></person-group><article-title>Patterns and emerging mechanisms of the angiogenic switch during tumorigenesis</article-title><source>Cell</source><year>1996</year><volume>86</volume><fpage>353</fpage><lpage>64</lpage><pub-id pub-id-type="pmid">8756718</pub-id></citation></ref><ref id="b24-co14_6p246"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vincent</surname><given-names>L</given-names></name><name><surname>Chen</surname><given-names>W</given-names></name><name><surname>Hong</surname><given-names>L</given-names></name><etal/></person-group><article-title>Inhibition of endothelial cell migration by cerivastatin, an hmg-coa reductase inhibitor: contribution to its anti-angiogenic effect</article-title><source>FEBS Lett</source><year>2001</year><volume>495</volume><fpage>159</fpage><lpage>66</lpage><pub-id pub-id-type="pmid">11334884</pub-id></citation></ref><ref id="b25-co14_6p246"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Feleszko</surname><given-names>W</given-names></name><name><surname>Balkowiec</surname><given-names>EZ</given-names></name><name><surname>Sieberth</surname><given-names>E</given-names></name><etal/></person-group><article-title>Lovastatin and tumor necrosis factor-&#x003b1; exhibit potentiated antitumor effects against Ha-<italic>ras-</italic>transformed murine tumor via inhibition of tumor-induced angiogenesis</article-title><source>Int J Cancer</source><year>1999</year><volume>81</volume><fpage>560</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">10225445</pub-id></citation></ref></ref-list></back></article>