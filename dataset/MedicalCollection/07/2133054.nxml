me><surname>Briggs</surname><given-names>MS</given-names></name><name><surname>Gierasch</surname><given-names>LM</given-names></name><name><surname>Zlotnick</surname><given-names>A</given-names></name><name><surname>Lear</surname><given-names>JD</given-names></name><name><surname>DeGrado</surname><given-names>WF</given-names></name></person-group><article-title>In vivo function and membrane binding properties are correlated for <italic>Escherichia coli</italic>lamB signal peptides</article-title><source>Science</source><year>1985</year><volume>228</volume><fpage>1096</fpage><lpage>1099</lpage><pub-id pub-id-type="pmid">3158076</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Connolly</surname><given-names>T</given-names></name><name><surname>Collins</surname><given-names>P</given-names></name><name><surname>Gilmore</surname><given-names>R</given-names></name></person-group><article-title>Access of proteinase K to partially translocated nascent polypeptides in intact and detergent-solubilized membranes</article-title><source>J Cell Biol</source><year>1989</year><volume>108</volume><fpage>299</fpage><lpage>307</lpage><pub-id pub-id-type="pmid">2537313</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crowley</surname><given-names>KS</given-names></name><name><surname>Liao</surname><given-names>S</given-names></name><name><surname>Worrell</surname><given-names>VE</given-names></name><name><surname>Reinhart</surname><given-names>GD</given-names></name><name><surname>Johnson</surname><given-names>AE</given-names></name></person-group><article-title>Secretory proteins move through the endoplasmic reticulum membrane via an aqueous, gated pore</article-title><source>Cell</source><year>1994</year><volume>78</volume><fpage>461</fpage><lpage>471</lpage><pub-id pub-id-type="pmid">8062388</pub-id></citation></ref><ref id="B8