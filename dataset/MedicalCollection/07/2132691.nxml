tation citation-type="journal"><person-group person-group-type="author"><name><surname>Bucci</surname><given-names>C</given-names></name><name><surname>Parton</surname><given-names>RG</given-names></name><name><surname>Mather</surname><given-names>IH</given-names></name><name><surname>Stunnenberg</surname><given-names>H</given-names></name><name><surname>Simons</surname><given-names>K</given-names></name><name><surname>Hoflack</surname><given-names>B</given-names></name><name><surname>Zerial</surname><given-names>M</given-names></name></person-group><article-title>The small GTPase rab5 functions as a regulatory factor in the early endocytic pathway</article-title><source>Cell</source><year>1992</year><volume>70</volume><fpage>715</fpage><lpage>728</lpage><pub-id pub-id-type="pmid">1516130</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bucci</surname><given-names>C</given-names></name><name><surname>Wandinger-Ness</surname><given-names>A</given-names></name><name><surname>L&#x000fc;tcke</surname><given-names>A</given-names></name><name><surname>Chiariello</surname><given-names>M</given-names></name><name><surname>Bruni</surname><given-names>CB</given-names></name><name><surname>Zerial</surname><given-names>M</given-names></name></person-group><article-title>Rab5a is a common component of the basolateral and apical endocytic machinery in polarized epithelial cells</article-title><source>Proc Natl Acad Sci USA</source><year>1994</year><volume>91</volume><fpage>5061</fpage><lpage>5065</lpage><pub-id pub-id-type="pmid">8197185</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chavrier</surname><given-names>P</given-names></name><name><surname>Parton</surname><given-names>RG</given-names></name><name><surname>Hauri</surname><given-names>HP</given-names></name><name><surname>Simons</surname><given-names>K</given-name