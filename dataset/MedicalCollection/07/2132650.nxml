 microglial cells express a plasma membrane pore gated by extracellular ATP</article-title><source>J Immunol</source><year>1996</year><volume>156</volume><fpage>1531</fpage><lpage>1539</lpage><pub-id pub-id-type="pmid">8568257</pub-id></citation></ref><ref id="B18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferrari</surname><given-names>D</given-names></name><name><surname>Chiozzi</surname><given-names>P</given-names></name><name><surname>Falzoni</surname><given-names>S</given-names></name><name><surname>Dal</surname><given-names>M</given-names></name><name><surname>Susino</surname></name><name><surname>Collo</surname><given-names>G</given-names></name><name><surname>Buell</surname><given-names>G</given-names></name><name><surname>Di Virgilio</surname><given-names>F</given-names></name></person-group><article-title>ATP-mediated cytotoxicity in microglial cells</article-title><source>J Neuropharmacol</source><year>1997</year><volume>36</volume><fpage>1295</fpage><lpage>1301</lpage></citation></ref><ref id="B19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferrari</surname><given-names>D</given-names></name><name><surname>Chiozzi</surname><given-names>P</given-names></name><name><surname>Falzoni</surname><given-names>S</given-names></name><name><surname>Hanau</surname><given-names>S</given-names></name><name><surname>Di Virgilio</surname><given-names>F</given-names></name></person-group><article-title>Purinergic modulation of interleukin-1&#x003b2; release from microglial cells stimulated with bacterial endotoxin</article-title><source>J Exp Med</source><year>1997</year><volume>185</volume><fpage>579</fpage><lpage>582</lpage><pub-id pub-id-type="pmid">9053458</pub-id></citation></ref><ref id="B20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fredholm</surname><given-names>BB</given-n