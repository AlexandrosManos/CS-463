ion citation-type="journal"><person-group person-group-type="author"><name><surname>L&#x000f6;e</surname><given-names>H</given-names></name></person-group><year>1971</year><article-title>Human research model for the production and prevention of gingivitis.</article-title><source>J Dent Res</source><volume>50</volume><issue>Suppl 2</issue><fpage>256</fpage><lpage>264</lpage><pub-id pub-id-type="pmid">4927518</pub-id></citation></ref><ref id="pone.0001351-Rosin1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rosin</surname><given-names>M</given-names></name><name><surname>Hanschke</surname><given-names>M</given-names></name><name><surname>Splieth</surname><given-names>C</given-names></name><name><surname>Kramer</surname><given-names>A</given-names></name></person-group><year>1999</year><article-title>Activities of lysozyme and salivary peroxidase in unstimulated whole saliva in relation to plaque and gingivitis scores in healthy young males.</article-title><source>Clin Oral Investig</source><volume>3</volume><fpage>133</fpage><lpage>137</lpage></citation></ref><ref id="pone.0001351-Rigas2"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rigas</surname><given-names>B</given-names></name><name><surname>Levine</surname><given-names>L</given-names></name></person-group><year>1983</year><article-title>Human salivary eicosanoids: circadian variation.</article-title><source>Biochem Biophys Res Commun</source><volume>115</volume><fpage>201</fpage><lpage>205</lpage><pub-id pub-id-type="pmid">6351860</pub-id></citation></ref><ref id="pone.0001351-Rigas3"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rigas</surname><given-names>B</given-names></name><name><surname>Levine</surname><given-names>L</given-names></name></person-group><year>1983</year><article-title>Concentrations of arachidonic-acid metabo