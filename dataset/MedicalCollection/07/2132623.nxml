="author"><name><surname>J&#x000f8;rgensen</surname><given-names>P</given-names></name></person-group><article-title>Structure, function, and regulation of Na,K-ATPase in the kidney</article-title><source>Kidney Int</source><year>1986</year><volume>29</volume><fpage>10</fpage><lpage>20</lpage><pub-id pub-id-type="pmid">2421041</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kent</surname><given-names>RB</given-names></name><name><surname>Fallows</surname><given-names>DA</given-names></name><name><surname>Geissler</surname><given-names>E</given-names></name><name><surname>Glaser</surname><given-names>T</given-names></name><name><surname>Emanuel</surname><given-names>JR</given-names></name><name><surname>Lalley</surname><given-names>PA</given-names></name><name><surname>Levenson</surname><given-names>R</given-names></name><name><surname>Housman</surname><given-names>DE</given-names></name></person-group><article-title>Genes encoding &#x003b1; and &#x003b2; subunits of Na,K-ATPase are located on three different chromosomes in the mouse</article-title><source>Proc Natl Acad Sci USA</source><year>1987</year><volume>84</volume><fpage>5369</fpage><lpage>5373</lpage><pub-id pub-id-type="pmid">2885848</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Khidhir</surname><given-names>MA</given-names></name><name><surname>Stachecki</surname><given-names>JJ</given-names></name><name><surname>Krawetz</surname><given-names>SA</given-names></name><name><surname>Armant</surname><given-names>DR</given-names></name></person-group><article-title>Rapid inhibition of mRNA synthesis during preimplantation embryo development: vital permeabilization by lysolecithin potentiates the action of &#x003b1;-amanitin</article-title><source>Exp Cell Res</source><year>1995</year><volume>219</volume><fpage>619</fpage><lpage>625</lpage><pub-id pub