-title>Identification of the homophilic binding site of the receptor protein tyrosine phosphatase PTP&#x003bc;</article-title><source>J Biol Chem</source><year>1994</year><volume>269</volume><fpage>28472</fpage><lpage>28477</lpage><pub-id pub-id-type="pmid">7961788</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brady-Kalnay</surname><given-names>SM</given-names></name><name><surname>Tonks</surname><given-names>NK</given-names></name></person-group><article-title>Protein tyrosine phosphatases as adhesion receptors</article-title><source>Curr Opin Cell Biol</source><year>1995</year><volume>7</volume><fpage>650</fpage><lpage>657</lpage><pub-id pub-id-type="pmid">8573339</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brady-Kalnay</surname><given-names>SM</given-names></name><name><surname>Rimm</surname><given-names>DL</given-names></name><name><surname>Tonks</surname><given-names>NK</given-names></name></person-group><article-title>The receptor protein tyrosine phosphatase PTP&#x003bc; associates with cadherins and catenins in vivo</article-title><source>J  Cell Biol</source><year>1995</year><volume>130</volume><fpage>977</fpage><lpage>986</lpage><pub-id pub-id-type="pmid">7642713</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brieher</surname><given-names>WM</given-names></name><name><surname>Yap</surname><given-names>AS</given-names></name><name><surname>Gumbiner</surname><given-names>BM</given-names></name></person-group><article-title>Lateral dimerization is required for the homophilic binding activity of C-cadherin</article-title><source>J Cell Biol</source><year>1996</year><volume>135</volume><fpage>487</fpage><lpage>496</lpage><pub-id pub-id-type="pmid">8896604</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>H</given-names></name><name><surname>Paradies</surname><given-names>N</given-names></name><name><surname>Fedor-Chaiken</surname><given-names>M</given-names></name><name><surname>Brackenbury</surname><given-names>R</given-names></name></person-group><article-title>E-cadherin mediates adhesion and suppresses cell motility via distinct mechanisms</article-title><source>J Cell Sci</source><year>1997</year><volume>110</volume><fpage>345</fpage><lpage>356</lpage><pub-id pub-id-type="pmid">9057087</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cheng</surname><given-names>J</given-names></name><name><surname>Wu</surname><given-names>K</given-names></name><name><surname>Armanini</surname><given-names>M</given-names></name><name><surname>O'Rourke</surname><given-names>N</given-names></name><name><surname>Dowbenko</surname><given-names>D</given-names></name><name><surname>Lasky</surname><given-names>LA</given-names></name></person-group><article-title>A novel protein-tyrosine phosphatase related to the homotypically adhering &#x003ba; and &#x003bc; receptors</article-title><source>J Biol Chem</source><year>1997</year><volume>272</volume><fpage>7264</fpage><lpage>7277</lpage><pub-id pub-id-type="pmid">9054423</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Flint</surname><given-names>A</given-names></name><name><surname>Gebbink</surname><given-names>M</given-names></name><name><surname>Franza</surname><given-names>B</given-names></name><name><surname>Hill</surname><given-names>D</given-names></name><name><surname>Tonks</surname><given-names>NK</given-names></name></person-group><article-title>Multi-site phosphorylation of the protein tyrosine phosphatase, PTP1B: identification of cell cycle regulated and phorbol ester stimulat