d">14702449</pub-id></citation></ref><ref id="b18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Studdert</surname><given-names>DM</given-names></name><name><surname>Thomas</surname><given-names>EJ</given-names></name><name><surname>Burstin</surname><given-names>HR</given-names></name><etal/></person-group><article-title>Negligent care and malpractice claiming behavior in Utah and Colorado</article-title><source>Med Care</source><year>2000</year><volume>38</volume><issue>3</issue><fpage>250</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">10718350</pub-id></citation></ref><ref id="b19"><citation citation-type="book"><person-group person-group-type="editor"><name><surname>Vincent</surname><given-names>C</given-names></name></person-group><source>Patient Safety</source><year>2006</year><publisher-loc>London</publisher-loc><publisher-name>Elsevier</publisher-name><fpage>70</fpage><lpage>74</lpage><comment>Chapter 4</comment></citation></ref><ref id="b20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vincent</surname><given-names>C</given-names></name><name><surname>Young</surname><given-names>M</given-names></name><name><surname>Phillips</surname><given-names>A</given-names></name></person-group><article-title>Why do people sue doctors?</article-title><source>Lancet</source><year>1994</year><volume>343</volume><fpage>1609</fpage><lpage>13</lpage><pub-id pub-id-type="pmid">7911925</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weinger</surname><given-names>MB</given-names></name><name><surname>Slagle</surname><given-names>J</given-names></name><name><surname>Jain</surname><given-names>S</given-names></name><etal/></person-group><article-title>Retrospective data collection and analytical techniques for patient safety studies</article-title><source>J Biomed Informatics</source><year>2003</year><volume>3