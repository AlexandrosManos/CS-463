:10.1128/IAI.74.5.2996-3001.2006</ext-link><pub-id pub-id-type="pmid">16622238</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Daubersies</surname><given-names>P</given-names></name><name><surname>Sallenave-Sales</surname><given-names>S</given-names></name><name><surname>Magne</surname><given-names>S</given-names></name><name><surname>Trape</surname><given-names>J.-F</given-names></name><name><surname>Contamin</surname><given-names>H</given-names></name><name><surname>Fandeur</surname><given-names>T</given-names></name><name><surname>Rogier</surname><given-names>C</given-names></name><name><surname>Mercereau-Puijalon</surname><given-names>O</given-names></name><name><surname>Druilhe</surname><given-names>P</given-names></name></person-group><article-title>Rapid turnover of <italic>Plasmodium falciparum</italic> populations in asymptomatic individuals living in a high transmission area</article-title><source>Am. J. Trop. Med. Hyg</source><volume>54</volume><year>1996</year><fpage>18</fpage><lpage>26</lpage><pub-id pub-id-type="pmid">8651363</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>de Roode</surname><given-names>J.C</given-names></name><name><surname>Read</surname><given-names>A.F</given-names></name><name><surname>Chan</surname><given-names>H.K</given-names></name><name><surname>Mackinnon</surname><given-names>M.J</given-names></name></person-group><article-title>Rodent malaria parasites suffer from the presence of con-specific clones in three-clone <italic>Plasmodium chabaudi</italic> infections</article-title><source>Parasitology</source><volume>127</volume><year>2003</year><fpage>411</fpage><lpage>418</lpage><ext-link ext-link-type="uri" xlink:href="http://dx.doi.org/doi:10.1017/S0031182003004001">doi:10.1017/S0031182003004001</ext-link><pub-id pub-id-type="pmid">14653530</pub-id></citation></r