"doi">10.1097/01.psy.0000138281.73634.67</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Herr&#x000e1;n</surname><given-names>A</given-names></name><name><surname>Sierra-Biddle</surname><given-names>D</given-names></name><name><surname>Garcia-Unzueta</surname><given-names>MT</given-names></name><name><surname>Puente</surname><given-names>J</given-names></name><name><surname>Vazquez-Barquero</surname><given-names>JL</given-names></name><name><surname>Antonio Amado</surname><given-names>J</given-names></name></person-group><article-title>The acute phase response in panic disorder</article-title><source>Int J Neuropsychopharmacol</source><year>2005</year><volume>8</volume><fpage>529</fpage><lpage>535</lpage><pub-id pub-id-type="pmid">15927091</pub-id><pub-id pub-id-type="doi">10.1017/S1461145705005432</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carney</surname><given-names>RM</given-names></name><name><surname>Freedland</surname><given-names>KE</given-names></name><name><surname>Miller</surname><given-names>GE</given-names></name><name><surname>Jaffe</surname><given-names>AS</given-names></name></person-group><article-title>Depression as a risk factor for cardiac mortality and morbidity: a review of potential mechanisms</article-title><source>J Psychosom Res</source><year>2002</year><volume>54</volume><fpage>897</fpage><lpage>902</lpage><pub-id pub-id-type="pmid">12377300</pub-id><pub-id pub-id-type="doi">10.1016/S0022-3999(02)00311-2</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fleet</surname><given-names>R</given-names></name><name><surname>Lavoie</surname><given-names>K</given-names></name><name><surname>Beitman</surname><given-names>BD</given-names></name></person-group><article-title>Is panic disorder associated with coro