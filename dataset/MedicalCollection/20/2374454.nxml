rd)</source><year>2007</year><volume>46</volume><fpage>1652</fpage><lpage>1656</lpage><pub-id pub-id-type="pmid">17855425</pub-id><pub-id pub-id-type="doi">10.1093/rheumatology/kem220</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Venn</surname><given-names>G</given-names></name><name><surname>Mason</surname><given-names>RM</given-names></name></person-group><article-title>Absence of keratan sulphate from skeletal tissues of mouse and rat</article-title><source>Biochem J</source><year>1985</year><volume>228</volume><fpage>443</fpage><lpage>450</lpage><pub-id pub-id-type="pmid">3160342</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ciombor</surname><given-names>DM</given-names></name><name><surname>Lester</surname><given-names>G</given-names></name><name><surname>Aaron</surname><given-names>RK</given-names></name><name><surname>Neame</surname><given-names>P</given-names></name><name><surname>Caterson</surname><given-names>B</given-names></name></person-group><article-title>Low frequency EMF regulates chondrocyte differentiation and expression of matrix proteins</article-title><source>J Orthop Res</source><year>2002</year><volume>20</volume><fpage>40</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">11853089</pub-id><pub-id pub-id-type="doi">10.1016/S0736-0266(01)00071-7</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Divine</surname><given-names>JG</given-names></name><name><surname>Zazulak</surname><given-names>BT</given-names></name><name><surname>Hewett</surname><given-names>TE</given-names></name></person-group><article-title>Viscosupplementation for knee osteoarthritis: a systematic review</article-title><source>Clin Orthop Relat Res</source><year>2007</year><volume>455</volume><fpage>113</fpage><lpage>122</lpage><pub-id pub-id-type="pmid">17159579</pub-id><pub-id pub-id-type="doi">10.1097/BLO.0b013e31802f5421</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldberg</surname><given-names>VM</given-names></name><name><surname>Buckwalter</surname><given-names>JA</given-names></name></person-group><article-title>Hyaluronans in the treatment of osteoarthritis of the knee: evidence for disease-modifying activity</article-title><source>Osteoarthritis Cartilage</source><year>2005</year><volume>13</volume><fpage>216</fpage><lpage>224</lpage><pub-id pub-id-type="pmid">15727888</pub-id><pub-id pub-id-type="doi">10.1016/j.joca.2004.11.010</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moreland</surname><given-names>LW</given-names></name></person-group><article-title>Intra-articular hyaluronan (hyaluronic acid) and hylans for the treatment of osteoarthritis: mechanisms of action</article-title><source>Arthritis Res Ther</source><year>2003</year><volume>5</volume><fpage>54</fpage><lpage>67</lpage><pub-id pub-id-type="pmid">12718745</pub-id><pub-id pub-id-type="doi">10.1186/ar623</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burghardt</surname><given-names>PR</given-names></name><name><surname>Fulk</surname><given-names>LJ</given-names></name><name><surname>Hand</surname><given-names>GA</given-names></name><name><surname>Wilson</surname><given-names>MA</given-names></name></person-group><article-title>The effects of chronic treadmill and wheel running on behavior in rats</article-title><source>Brain Res</source><year>2004</year><volume>1019</volume><fpage>84</fpage><lpage>96</lpage><pub-id pub-id-type="pmid">15306242</pub-id><pub-id pub-id-type="doi">10.1016/j.brainres.2004.05.086</pub-id></citation></ref><ref id="B19"><citation citation-type="journal">