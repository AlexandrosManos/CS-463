<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article article-type="letter"><?properties open_access?><!-- Original-type: sc--><front><journal-meta><journal-id journal-id-type="nlm-ta">Br J Cancer</journal-id><journal-title>British Journal of Cancer</journal-title><issn pub-type="ppub">0007-0920</issn><issn pub-type="epub">1532-1827</issn><publisher><publisher-name>Nature Publishing Group</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">10883673</article-id><article-id pub-id-type="pmc">2374535</article-id><article-id pub-id-type="pii">6691153</article-id><article-id pub-id-type="doi">10.1054/bjoc.2000.1153</article-id><article-categories><subj-group subj-group-type="heading"><subject>Short communication</subject></subj-group></article-categories><title-group><article-title>Anal carcinoma in inflammatory bowel disease</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Frisch</surname><given-names>M</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Johansen</surname><given-names>C</given-names></name><xref ref-type="aff" rid="aff2">2</xref></contrib></contrib-group><aff id="aff1"><label>1</label>Department of Epidemiology Research, Danish Epidemiology Science Centre, Statens Serum Institut, 5 Artillerivej, Copenhagen, DK-2300, Denmark</aff><aff id="aff2"><label>2</label>Danish Cancer Society, Institute of Cancer Epidemiology, 49 Strandboulevarden, Copenhagen, DK-2100, Denmark</aff><pub-date pub-type="epub"><day>02</day><month>06</month><year>2000</year></pub-date><pub-date pub-type="ppub"><month>07</month><year>2000</year></pub-date><volume>83</volume><issue>1</issue><fpage>89</fpage><lpage>90</lpage><history><date date-type="received"><day>04</day><month>01</month><year>2000</year></date><date date-type="rev-recd"><day>07</day><month>02</month><year>2000</year></date><date date-type="accepted"><day>07</day><month>02</month><year>2000</year></date></history><copyright-statement>Copyright 2000, Cancer Research Campaign</copyright-statement><copyright-year>2000</copyright-year><permissions><copyright-holder>Cancer Research Campaign</copyright-holder></permissions><abstract><p>We followed 9602 patients with Crohn's disease or ulcerative colitis for anal squamous cell carcinoma for up to 18 years. No significant increase was observed: two cases occurred <italic>vs</italic> 1.3 expected during 99 229 person-years of observation, (standardized incidence ratio = 1.6; 95 confidence interval: 0.2&#x02013;5.7). Anal squamous cell carcinoma is rare even in inflammatory bowel disease. &#x000a9; 2000 Cancer Research Campaign</p></abstract><kwd-group><kwd>anus neoplasms</kwd><kwd>ulcerative colitis</kwd><kwd>Crohn's disease</kwd><kwd>inflammatory bowel disease</kwd><kwd>cohort studies</kwd></kwd-group></article-meta></front></article>