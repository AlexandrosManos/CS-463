-title>Studies on the causes of deaths from esophageal carcinoma</article-title><source>Cancer</source><year>1982</year><volume>49</volume><fpage>2173</fpage><lpage>2179</lpage><!--PubMed citation query: 'Cancer||49|2173||bib11|'--><pub-id pub-id-type="pmid">7074533</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Isono</surname><given-names>K</given-names></name><name><surname>Ochiai</surname><given-names>T</given-names></name><name><surname>Okuyama</surname><given-names>K</given-names></name><name><surname>Onoda</surname><given-names>S</given-names></name></person-group><article-title>The treatment of lymph Node metastasis esophageal cancer by extensive lymphadenectomy</article-title><source>Jpn J Surg</source><year>1990</year><volume>20</volume><fpage>151</fpage><lpage>157</lpage><!--PubMed citation query: 'Jpn J Surg||20|151||bib12|'--><pub-id pub-id-type="pmid">2342235</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ide</surname><given-names>H</given-names></name></person-group><article-title>Neoadjuvant chemotherapy with cisplatinum/5-fluorouracil/low-dose leucovorin for advanced squamous cell carcinoma of the esophagus</article-title><source>Semin Surg Oncol</source><year>1997</year><volume>13</volume><fpage>263</fpage><lpage>269</lpage><!--PubMed citation query: 'Semin Surg Oncol||13|263||bib13|'--><pub-id pub-id-type="pmid">9229414</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Inoue</surname><given-names>K</given-names></name><name><surname>Ozeki</surname><given-names>Y</given-names></name><name><surname>Suganuma</surname><given-names>T</given-names></name><name><surname>Sugiura</surname><given-names>Y</given-names></name><name><surname>Tanaka</surname><given-names>S</given-names></name></person-group><article-t