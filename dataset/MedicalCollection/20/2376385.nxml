 'Hum Biol||49|541||bib12|'--><pub-id pub-id-type="pmid">590953</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garfinkel</surname><given-names>L</given-names></name></person-group><article-title>Overweight and cancer</article-title><source>Ann Intern Med</source><year>1985</year><volume>103</volume><supplement>6</supplement><fpage>1034</fpage><lpage>1036</lpage><!--PubMed citation query: 'Ann Intern Med||103|1034||bib13|'--><pub-id pub-id-type="pmid">4062120</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giovannucci</surname><given-names>E</given-names></name></person-group><article-title>Insulin and colon cancer</article-title><source>Cancer Causes Control</source><year>1995</year><volume>6</volume><fpage>164</fpage><lpage>179</lpage><!--PubMed citation query: 'Cancer Causes Control||6|164||bib14|'--><pub-id pub-id-type="pmid">7749056</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giovannucci</surname><given-names>E</given-names></name><name><surname>Ascherio</surname><given-names>A</given-names></name><name><surname>Rimm</surname><given-names>EB</given-names></name><name><surname>Colditz</surname><given-names>GA</given-names></name><name><surname>Stampfer</surname><given-names>MJ</given-names></name><name><surname>Willet</surname><given-names>WC</given-names></name></person-group><article-title>Physical activity, obesity, and risk for colon cancer and adenoma in men</article-title><source>Ann Intern Med</source><year>1995</year><volume>122</volume><fpage>327</fpage><lpage>334</lpage><!--PubMed citation query: 'Ann Intern Med||122|327||bib15|'--><pub-id pub-id-type="pmid">7847643</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giovannuc