"journal"><person-group person-group-type="author"><name><surname>Heckmann</surname><given-names>JG</given-names></name><name><surname>Heron</surname><given-names>P</given-names></name><name><surname>Kasper</surname><given-names>B</given-names></name><name><surname>D&#x000f6;rfler</surname><given-names>A</given-names></name><name><surname>Maih&#x000f6;fner</surname><given-names>C</given-names></name></person-group><article-title>Beauty parlor stroke syndrome</article-title><source><italic>Cerebrovascular Diseases</italic></source><year>2006</year><volume>21</volume><issue>1-2</issue><fpage>140</fpage><lpage>141</lpage><pub-id pub-id-type="pmid">16374003</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Weintraub</surname><given-names>MI</given-names></name><name><surname>Khoury</surname><given-names>A</given-names></name></person-group><article-title>Critical neck position as an independent risk factor for posterior circulation stroke: a magnetic resonance angiographic analysis</article-title><source><italic>Journal of Neuroimaging</italic></source><year>1995</year><volume>5</volume><issue>1</issue><fpage>16</fpage><lpage>22</lpage><pub-id pub-id-type="pmid">7849367</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Beaudry</surname><given-names>M</given-names></name><name><surname>Spence</surname><given-names>JD</given-names></name></person-group><article-title>Motor vehicle accidents: the most common cause of traumatic vertebrobasilar ischemia</article-title><source><italic>Canadian Journal of Neurological Sciences</italic></source><year>2003</year><volume>30</volume><issue>4</issue><fpage>320</fpage><lpage>325</lpage><pub-id pub-id-type="pmid">14672263</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Inamasu</surname><given-names>J</given-names></name><name><surname>Guiot</surname><given-names>BH</given-names></name></person-group><article-title>Vertebral artery injury after blunt cervical trauma: an update</article-title><source><italic>Surgical Neurology</italic></source><year>2006</year><volume>65</volume><issue>3</issue><fpage>238</fpage><lpage>246</lpage><pub-id pub-id-type="pmid">16488240</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Baker</surname><given-names>WE</given-names></name><name><surname>Wassermann</surname><given-names>J</given-names></name></person-group><article-title>Unsuspected vascular trauma: blunt arterial injuries</article-title><source><italic>Emergency Medicine Clinics of North America</italic></source><year>2004</year><volume>22</volume><issue>4</issue><fpage>1081</fpage><lpage>1098</lpage><pub-id pub-id-type="pmid">15474783</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="other"><person-group person-group-type="author"><name><surname>Kaye</surname><given-names>V</given-names></name><name><surname>Brandstater</surname><given-names>ME</given-names></name></person-group><article-title>Vertebrobasilar stroke</article-title><comment><ext-link ext-link-type="uri" xlink:href="http://emedicine.medscape.com/article/323409-overview">http://emedicine.medscape.com/article/323409-overview</ext-link></comment></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Devuyst</surname><given-names>G</given-names></name><name><surname>Bogousslavsky</surname><given-names>J</given-names></name><name><surname>Meuli</surname><given-names>R</given-names></name><name><surname>Moncayo</surname><given-names>J</given-names></name><name><surname>De Freitas</surname><given-names>G</given-names></name><name><surname>Van Meile</surname><given-names>G</given-names></name></person-group><article-title>Stroke or transient ischemic attacks with basilar artery stenosis or occlusion: clinical patterns and outcome</article-title><source><italic>Archives of Neurology</italic></source><year>2002</year><volume>59</volume><issue>4</issue><fpage>567</fpage><lpage>573</lpage><pub-id pub-id-type="pmid">11939891</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Vyshka</surname><given-names>G</given-names></name><name><surname>Shaqiri</surname><given-names>E</given-names></name><name><surname>Ymaj</surname><given-names>B</given-names></name></person-group><article-title>Sudden death due to medulloblastoma</article-title><comment><italic>BMJ Case Reports</italic>. In press</comment></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Black</surname><given-names>M</given-names></name><name><surname>Graham</surname><given-names>DI</given-names></name></person-group><article-title>Sudden unexplained death in adults caused by intracranial pathology</article-title><source><italic>Journal of Clinical Pathology</italic></source><year>2002</year><volume>55</volume><issue>1</issue><fpage>44</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">11825924</pub-id></element-citation></ref><ref id="B16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Davis</surname><given-names>SM</given-names></name><name><surname>Donnan</surname><given-names>GA</given-names></name></person-group><article-title>Basilar artery thrombosis: recanalization is the key</article-title><source><italic>Stroke</italic></source><year>2006</year><volume>37</volume><issue>9</issue><fpage>p. 2440</fpage></element-citation></ref><ref id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lindsberg</surname><given-names>PJ</given-names></name><name><surname>Mattle</surname><given-names>HP</given-names></name></person-group><article-title>Therapy of basilar artery occlusion: a systematic analysis comparing intra-arterial and intravenous thrombolysis</article-title><source><italic>Stroke</italic></source><year>2006</year><volume>37</volume><issue>3</issue><fpage>922</fpage><lpage>928</lpage><pub-id pub-id-type="pmid">16439705</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Schonewille</surname><given-names>WJ</given-names></name><name><surname>Algra</surname><given-names>A</given-names></name><name><surname>Serena</surname><given-names>J</given-names></name><name><surname>Molina</surname><given-names>CA</given-names></name><name><surname>Kappelle</surname><given-names>LJ</given-names></name></person-group><article-title>Outcome in patients with basilar artery occlusion treated conventionally</article-title><source><italic>Journal of Neurology, Neurosurgery and Psychiatry</italic></source><year>2005</year><volume>76</volume><issue>9</issue><fpage>1238</fpage><lpage>1241</lpage></element-citation></ref></ref-list></back><floats-group><fig id="fig1" position="float"><label>Figure 1</label><caption><p>Macroscopy of the brain; the occluded thrombotic basilar artery is seen.</p></caption><graphic xlink:href="CRM2010-401978.001"/></fig><fig id="fig2" position="float"><label>Figure 2</label><caption><p>The occlusion of the basilar artery involved mainly the median portion. Note the atheromatous basilar artery, with an extensive and fresh thrombus.</p></caption><graphic xlink:href="CRM2010-401978.002"/></fig><fig id="fig3" position="float"><label>Figure 3</label><caption><p>Severed endothelium in the territory of a pontine artery (center of the figure) with fragments of a fresh thrombus (right in the figure).</p></caption><graphic xlink:href="CRM2010-401978.003"/></fig><fig id="fig4" position="float"><label>Figure 4</label><caption><p>Intraluminal thrombus.</p></caption><graphic xlink:href="CRM2010-401978.004"/></fig><fig id="fig5" position="float"><label>Figure 5</label><caption><p>A thrombosed arteriole in the sagittal section. The fresh thrombus expanded longitudinally. There is evidence of adjacent cellular edema.</p></caption><graphic xlink:href="CRM2010-401978.005"/></fig></floats-group></article>