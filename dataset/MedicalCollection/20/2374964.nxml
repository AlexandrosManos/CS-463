b-id pub-id-type="pmid">16127175</pub-id><pub-id pub-id-type="doi">10.1074/mcp.M500279-MCP200</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kampf</surname><given-names>C</given-names></name><name><surname>Andersson</surname><given-names>AC</given-names></name><name><surname>Wester</surname><given-names>K</given-names></name><name><surname>Bjorling</surname><given-names>E</given-names></name><name><surname>Uhlen</surname><given-names>M</given-names></name><name><surname>Ponten</surname><given-names>F</given-names></name></person-group><article-title>Antibody-based tissue profiling as a tool for clinical proteomics</article-title><source>Clinical Proteomics</source><year>2004</year><volume>1</volume><fpage>285</fpage><lpage>299</lpage><pub-id pub-id-type="doi">10.1385/CP:1:3-4:285</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Andersson</surname><given-names>AC</given-names></name><name><surname>Stromberg</surname><given-names>S</given-names></name><name><surname>Backvall</surname><given-names>H</given-names></name><name><surname>Kampf</surname><given-names>C</given-names></name><name><surname>Uhlen</surname><given-names>M</given-names></name><name><surname>Wester</surname><given-names>K</given-names></name><name><surname>Ponten</surname><given-names>F</given-names></name></person-group><article-title>Analysis of protein expression in cell microarrays: a tool for antibody-based proteomics</article-title><source>J Histochem Cytochem</source><year>2006</year><volume>54</volume><fpage>1413</fpage><lpage>1423</lpage><pub-id pub-id-type="pmid">16957166</pub-id><pub-id pub-id-type="doi">10.1369/jhc.6A7001.2006</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bossuyt</surname><given-names>PM</given-names></name><name><surname>Reitsma<