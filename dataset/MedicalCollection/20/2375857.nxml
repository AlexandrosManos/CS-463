le-title><source>Can J Public Health</source><year>1997</year><volume>88</volume><fpage>154</fpage><lpage>158</lpage><pub-id pub-id-type="pmid">9260354</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hanssen</surname><given-names>B</given-names></name><name><surname>Grimsgaard</surname><given-names>S</given-names></name><name><surname>Launso</surname><given-names>L</given-names></name><name><surname>Fonnebo</surname><given-names>V</given-names></name><name><surname>Falkenberg</surname><given-names>T</given-names></name><name><surname>Rasmussen</surname><given-names>NK</given-names></name></person-group><article-title>Use of complementary and alternative medicine in the Scandinavian countries</article-title><source>Scand J Prim Health Care</source><year>2005</year><volume>23</volume><fpage>57</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">16025876</pub-id><pub-id pub-id-type="doi">10.1080/02813430510018419</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thomas</surname><given-names>K</given-names></name><name><surname>Coleman</surname><given-names>P</given-names></name></person-group><article-title>Use of complementary or alternative medicine in a general population in Great Britain. Results from the National Omnibus survey</article-title><source>J Public Health (Oxf)</source><year>2004</year><volume>26</volume><fpage>152</fpage><lpage>157</lpage><pub-id pub-id-type="pmid">15284318</pub-id><pub-id pub-id-type="doi">10.1093/pubmed/fdh139</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wolf</surname><given-names>U</given-names></name><name><surname>Maxion-Bergemann</surname><given-names>S</given-names></name><name><surname>Bornhoft</surname><given-names>G</given-names></name><name><surname>Matthiessen</surname><given-names>PF</g