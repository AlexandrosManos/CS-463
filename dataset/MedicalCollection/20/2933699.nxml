><name><surname>Abu-Zidan</surname><given-names>FM</given-names></name><article-title>The international conference on problem based learning in higher education</article-title><source>Med Educ</source><year>1997</year><volume>31</volume><fpage>390</fpage><lpage>3</lpage><pub-id pub-id-type="doi">10.1046/j.1365-2923.1997.00686.x</pub-id><pub-id pub-id-type="pmid">9488864</pub-id></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><name><surname>Abu-Zidan</surname><given-names>FM</given-names></name><name><surname>Windsor</surname><given-names>JA</given-names></name><article-title>Students' evaluation of surgical seminars in a teaching hospital</article-title><source>Med Educ</source><year>2001</year><volume>35</volume><fpage>673</fpage><lpage>80</lpage><pub-id pub-id-type="doi">10.1046/j.1365-2923.2001.00953.x</pub-id><pub-id pub-id-type="pmid">11437970</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><name><surname>Abu-Zidan</surname><given-names>FM</given-names></name><name><surname>Premadasa</surname><given-names>IG</given-names></name><article-title>Instructional skills of surgical tutors</article-title><source>Singapore Med J</source><year>2002</year><volume>43</volume><fpage>610</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">12693763</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="book"><name><surname>Chapman</surname><given-names>DM</given-names></name><name><surname>Char</surname><given-names>DM</given-names></name><name><surname>Aubin</surname><given-names>CD</given-names></name><person-group person-group-type="editor">Marx JA, Hockberger RS, Walls RM</person-group><article-title>Clinical decision making</article-title><source>Rosen&#x02019;s Emergency Medicine concepts and clinical practice</source><year>2006</year><edition>6</edition><publisher-name>Mosby Elsevier, PA</publisher-name><fpage>125</fpage><lpage>133</lpage><comment>Rosen's Emergency Medicine co