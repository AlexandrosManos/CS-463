given-names></name></person-group><article-title>Effects of growth hormone overexpression and growth hormone resistance on neuroendocrine and reproductive functions in transgenic and knock-out mice</article-title><source>Proc Soc Exp Biol Med</source><year>1999</year><volume>222</volume><fpage>113</fpage><lpage>123</lpage><!--PubMed citation query: 'Proc Soc Exp Biol Med||222|113||bib4|'--><pub-id pub-id-type="pmid">10564535</pub-id></citation></ref><ref id="bib5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boyd</surname><given-names>NF</given-names></name><name><surname>Lockwood</surname><given-names>GA</given-names></name><name><surname>Byng</surname><given-names>J</given-names></name><name><surname>Tritchler</surname><given-names>DL</given-names></name><name><surname>Yaffe</surname><given-names>M</given-names></name></person-group><article-title>Mammographic densities and breast cancer risk</article-title><source>Cancer Epidemiol Biomarkers Prev</source><year>1998</year><volume>7</volume><fpage>1133</fpage><lpage>1144</lpage><!--PubMed citation query: 'Cancer Epidemiol Biomarkers Prev||7|1133||bib5|'--><pub-id pub-id-type="pmid">9865433</pub-id></citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brisson</surname><given-names>J</given-names></name><name><surname>Brisson</surname><given-names>B</given-names></name><name><surname>Cot&#x000e9;</surname><given-names>G</given-names></name><name><surname>Maunsell</surname><given-names>E</given-names></name><name><surname>B&#x000e9;rub&#x000e9;</surname><given-names>S</given-names></name><name><surname>Robert</surname><given-names>J</given-names></name></person-group><article-title>Tamoxifen and mammographic breast densities</article-title><source>Cancer Epidemiol Biomarkers Prev</source><year>2000</year><volume>9</volume><fpage>911</fpage><lpage>915</lpage><!--PubMed citation query: 'Cancer Epidemiol Bioma