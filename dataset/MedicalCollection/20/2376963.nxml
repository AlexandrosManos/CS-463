al"><person-group person-group-type="author"><name><surname>Z&#x000e1;vada</surname><given-names>J</given-names></name><name><surname>Z&#x000e1;vadov&#x000e1;</surname><given-names>Z</given-names></name><name><surname>Pastorek</surname><given-names>J</given-names></name><name><surname>Biesov&#x000e1;</surname><given-names>Z</given-names></name><name><surname>Je&#x0017e;ek</surname><given-names>J</given-names></name><name><surname>Velek</surname><given-names>J</given-names></name></person-group><article-title>Human tumour-associated cell adhesion protein MN&#x0002f;CA IX: Identification of M75 epitope and of the region mediating cell adhesion</article-title><source>Br J Cancer</source><year>2000</year><volume>82</volume><fpage>1808</fpage><lpage>1813</lpage><!--PubMed citation query: 'Br J Cancer||82|1808||bib14|'--><pub-id pub-id-type="pmid">10839295</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Z&#x000e1;vada</surname><given-names>J</given-names></name><name><surname>Z&#x000e1;vadov&#x000e1;</surname><given-names>Z</given-names></name><name><surname>Pastorekov&#x000e1;</surname><given-names>S</given-names></name><name><surname>&#x0010c;iampor</surname><given-names>F</given-names></name><name><surname>Pastorek</surname><given-names>J</given-names></name><name><surname>Zeln&#x000ed;k</surname><given-names>V</given-names></name></person-group><article-title>Expression of MaTu-MN protein in human tumor cultures and in clinical specimens</article-title><source>Int J Cancer</source><year>1993</year><volume>54</volume><fpage>268</fpage><lpage>274</lpage><!--PubMed citation query: 'Int J Cancer||54|268||bib15|'--><pub-id pub-id-type="pmid">8486430</pub-id></citation></ref></ref-list></back></article>