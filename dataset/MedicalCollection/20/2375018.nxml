-title><source>Nat Genet</source><year>2006</year><volume>38</volume><fpage>158</fpage><lpage>167</lpage><pub-id pub-id-type="pmid">16388311</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>WH</given-names></name><name><surname>Saunders</surname><given-names>MA</given-names></name></person-group><article-title>News and views: the chimpanzee and us.</article-title><source>Nature</source><year>2005</year><volume>437</volume><fpage>50</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">16136126</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><collab>ENCODE Project Consortium</collab></person-group><article-title>The ENCODE (ENCyclopedia Of DNA Elements) Project.</article-title><source>Science</source><year>2004</year><volume>306</volume><fpage>636</fpage><lpage>640</lpage><pub-id pub-id-type="pmid">15499007</pub-id></citation></ref><ref id="B12"><citation citation-type="other"><article-title>ENCODE project target selection process and target regions</article-title><ext-link ext-link-type="uri" xlink:href="http://genome.gov/10506161"/></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eddy</surname><given-names>SR</given-names></name></person-group><article-title>Non-coding RNA genes and the modern RNA world.</article-title><source>Nat Rev Genet</source><year>2001</year><volume>2</volume><fpage>919</fpage><lpage>929</lpage><pub-id pub-id-type="pmid">11733745</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giresi</surname><given-names>PG</given-names></name><name><surname>Gupta</surname><given-names>M</given-names></name><name><surname>Lieb</surname><given-names>JD</given-names></name></person-group><article-title>Regulation of nucleosome stability as a me