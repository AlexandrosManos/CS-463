><td align="left">89.4</td><td align="left">4.5</td><td align="left">1.4</td></tr><tr><td align="left">11: ENm011 1GF2H19</td><td align="left">11</td><td align="left">62</td><td align="left">228</td><td align="left">606,048</td><td align="left">10.2</td><td align="left">37.6</td><td align="left">2.1</td><td align="left">102.3</td><td align="left">13.4</td><td align="left">2.7</td></tr><tr><td align="left">12: ENm012 FOXP2</td><td align="left">7</td><td align="left">128</td><td align="left">370</td><td align="left">1,000,000</td><td align="left">12.8</td><td align="left">37.0</td><td align="left">0.3</td><td align="left">73.2</td><td align="left">5.9</td><td align="left">2.0</td></tr><tr><td align="left">13: ENm013</td><td align="left">7</td><td align="left">139</td><td align="left">483</td><td align="left">1,114,424</td><td align="left">12.5</td><td align="left">43.3</td><td align="left">1.0</td><td align="left">105.7</td><td align="left">7.7</td><td align="left">2.4</td></tr><tr><td align="left">14: ENm014</td><td align="left">7</td><td align="left">128</td><td align="left">322</td><td align="left">1,163,197</td><td align="left">11.0</td><td align="left">27.7</td><td align="left">0.8</td><td align="left">83.4</td><td align="left">7.6</td><td align="left">3.0</td></tr><tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left"><bold>Manual</bold></td><td></td><td align="left"><bold>2,186</bold></td><td align="left"><bold>6,504</bold></td><td align="left"><bold>14,997,995</bold></td><td align="left"><bold>14.6</bold></td><td align="left"><bold>43.4</bold></td><td align="left"><bold>2.7</bold></td><td align="left"><bold>95.9</bold></td><td align="left"><bold>6.5</bold></td><td align="left"><bold>2.2</bold></td></tr><tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left">15: ENr111</td><td align="left">13</td><td align="left">96<