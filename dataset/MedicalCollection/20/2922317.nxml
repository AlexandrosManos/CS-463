person-group><article-title>Serum aldosterone and the incidence of hypertension in nonhypertensive persons</article-title><source>N Engl J Med</source><year>2004</year><volume>351</volume><fpage>33</fpage><lpage>41</lpage><pub-id pub-id-type="pmid">15229305</pub-id></mixed-citation></ref><ref id="b13-vhrm-6-561"><label>13.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Clement</surname><given-names>DL</given-names></name><name><surname>De Buyzere</surname><given-names>ML</given-names></name><name><surname>De Bacquer</surname><given-names>Da</given-names></name><etal/></person-group><article-title>Prognostic value of ambulatory blood-pressure recordings in patients with treated hypertension</article-title><source>N Engl J Med</source><year>2003</year><volume>348</volume><fpage>2407</fpage><lpage>2415</lpage><pub-id pub-id-type="pmid">12802026</pub-id></mixed-citation></ref><ref id="b14-vhrm-6-561"><label>14.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ohkubo</surname><given-names>T</given-names></name><name><surname>Hozawa</surname><given-names>A</given-names></name><name><surname>Yamaguchi</surname><given-names>J</given-names></name><etal/></person-group><article-title>Prognostic significance of the nocturnal decline in blood pressure in individuals with and without high 24-h blood pressure: The Ohasama study</article-title><source>J Hypertension</source><year>2002</year><volume>20</volume><fpage>2183</fpage><lpage>2189</lpage></mixed-citation></ref><ref id="b15-vhrm-6-561"><label>15.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><collab>SHEP Cooperative Research Group</collab></person-group><article-title>Prevention of stroke by antihypertensive drug treatment in older persons with isolated systolic hypertension. Final results of the Systolic Hypertension in the Elderly Program (SHEP)</article-title><source>JAMA</source><year>1991</year><volume>265</volume><fpage>3255</fpage><lpage>3264</lpage><pub-id pub-id-type="pmid">2046107</pub-id></mixed-citation></ref><ref id="b16-vhrm-6-561"><label>16.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><collab>Medical Research Council Working Party</collab></person-group><article-title>MRC trial of treatment of hypertension in older adults: rincipal results</article-title><source>BMJ</source><year>1992</year><volume>304</volume><fpage>405</fpage><lpage>412</lpage><pub-id pub-id-type="pmid">1445513</pub-id></mixed-citation></ref><ref id="b17-vhrm-6-561"><label>17.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Staessen</surname><given-names>JA</given-names></name><name><surname>Fagard</surname><given-names>R</given-names></name><name><surname>Lutgarde</surname><given-names>T</given-names></name><etal/><collab>for the Systolic Hypertension in Europe (Syst-Eur) Trial Investigators</collab></person-group><article-title>Randomised double-blind comparison of placebo and active treatment for older patients with isolated systolic hypertension</article-title><source>Lancet</source><year>1997</year><volume>350</volume><fpage>757</fpage><lpage>764</lpage><pub-id pub-id-type="pmid">9297994</pub-id></mixed-citation></ref><ref id="b18-vhrm-6-561"><label>18.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Beckett</surname><given-names>NS</given-names></name><name><surname>Peters</surname><given-names>R</given-names></name><name><surname>Fletcher</surname><given-names>A</given-names></name><etal/></person-group><article-title>Treatment of hypertension in patients 80 years of age or older</article-title><source>N Engl J Med</source><year>2008</year><volume>358</volume><fpage>1887</fpage><lpage>1898</lpage><pub-id pub-id-type="pmid">18378519</pub-id></mixed-citation></ref><ref id="b19-