charoff="50">III</td><td align="center" valign="top" charoff="50">HLA-A2</td><td align="center" valign="top" char="." charoff="50">2.5</td><td align="left" valign="top" charoff="50">Solid tumour</td></tr><tr><td align="left" valign="top" charoff="50">9</td><td align="center" valign="top" charoff="50">69</td><td align="center" valign="top" charoff="50">F</td><td align="left" valign="top" charoff="50">Ovarian</td><td align="center" valign="top" charoff="50">IV</td><td align="center" valign="top" charoff="50">HLA-A2</td><td align="center" valign="top" char="." charoff="50">2</td><td align="left" valign="top" charoff="50">Solid tumour</td></tr><tr><td align="left" valign="top" charoff="50">10</td><td align="center" valign="top" charoff="50">72</td><td align="center" valign="top" charoff="50">M</td><td align="left" valign="top" charoff="50">Lung</td><td align="center" valign="top" charoff="50">IV</td><td align="center" valign="top" charoff="50">HLA-A2</td><td align="center" valign="top" char="." charoff="50">1</td><td align="left" valign="top" charoff="50">Effusion</td></tr><tr><td align="left" valign="top" charoff="50">11</td><td align="center" valign="top" charoff="50">64</td><td align="center" valign="top" charoff="50">M</td><td align="left" valign="top" charoff="50">Colorectal</td><td align="center" valign="top" charoff="50">III</td><td align="center" valign="top" charoff="50">HLA-A2</td><td align="center" valign="top" char="." charoff="50">2</td><td align="left" valign="top" charoff="50">Effusion</td></tr><tr><td align="left" valign="top" charoff="50">12</td><td align="center" valign="top" charoff="50">55</td><td align="center" valign="top" charoff="50">F</td><td align="left" valign="top" charoff="50">Breast</td><td align="center" valign="top" charoff="50">II</td><td align="center" valign="top" charoff="50">HLA-A2</td><td align="center" valign="top" char="." charoff="50">2</td><td align="left" valign="top" charoff="50">Solid tumour</td></tr><tr><td align="left" vali