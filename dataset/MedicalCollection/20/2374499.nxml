citation></ref><ref id="B15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldman</surname><given-names>M</given-names></name><name><surname>Dacre</surname><given-names>JC</given-names></name></person-group><article-title>Lewisite: its chemistry, toxicology and biological effects</article-title><source>Rev Environ Contam Toxicol</source><year>1989</year><volume>110</volume><fpage>75</fpage><lpage>115</lpage><pub-id pub-id-type="pmid">2692088</pub-id></citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Peters</surname><given-names>RA</given-names></name></person-group><article-title>Development and theoretical significance of British anti-lewisite (BAL)</article-title><source>Br Med Bull</source><year>1947</year><volume>5</volume><fpage>313</fpage><lpage>19</lpage></citation></ref><ref id="B17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Aposhian</surname><given-names>HV</given-names></name></person-group><article-title>Biological chelation: 2, 3-dimercaptopropanesulfonic acid and meso-dimercaptosuccinic acid</article-title><source>Adv Enzyme Regul</source><year>1982</year><volume>20</volume><fpage>301</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">6287818</pub-id></citation></ref><ref id="B18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Aposhian</surname><given-names>HV</given-names></name><name><surname>Mershon</surname><given-names>MM</given-names></name><name><surname>Brinkley</surname><given-names>FB</given-names></name><name><surname>Hsu</surname><given-names>CA</given-names></name><name><surname>Hackley</surname><given-names>BE</given-names></name></person-group><article-title>Anti-lewisite activity and stability of meso-dimercaptosuccinic acid and 2,3-dimercapto-1-propanesulfonic acid</article-title><source>Life Sci</source><year>1982</year><volume>31</volume><fpage>2149</fpage><lpage>56</lpage><pub-id pub-id-type="pmid">6294430</pub-id></citation></ref><ref id="B19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Aposhian</surname><given-names>HV</given-names></name><name><surname>Carter</surname><given-names>DE</given-names></name><name><surname>Hoover</surname><given-names>TD</given-names></name><name><surname>Hsu</surname><given-names>C-A</given-names></name><name><surname>Maiorino</surname><given-names>RM</given-names></name><name><surname>Stine</surname><given-names>E DMSA</given-names></name><name><surname>DMPS</surname></name><name><surname>DMPA</surname></name></person-group><article-title>as arsenic antidotes</article-title><source>Fundam Appl Toxicol</source><year>1984</year><volume>4</volume><fpage>S58</fpage><lpage>S70</lpage><pub-id pub-id-type="pmid">6327446</pub-id></citation></ref><ref id="B20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Inns</surname><given-names>RH</given-names></name><name><surname>Rice</surname><given-names>P</given-names></name></person-group><article-title>Efficacy of dimercapto chelating agents for the treatment of poisoning by percutaneously applied dichloro (2-chlorovinyl) arsine in rabbits</article-title><source>Human Exp Toxicol</source><year>1993</year><volume>12</volume><fpage>241</fpage><lpage>6</lpage></citation></ref><ref id="B21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Inns</surname><given-names>RH</given-names></name><name><surname>Rice</surname><given-names>P</given-names></name><name><surname>Bright</surname><given-names>JE</given-names></name><name><surname>Marrs</surname><given-names>TC</given-names></name></person-group><article-title>Evaluation of the efficacy of dimercapto chelating agents for the treatment of systemic organic arsenic poisoning in rabbits</article-title><source>Human Exp Toxicol</source><year>1990</year><volume>9</volume><fpage>215</fpage><lpage>20</lpage></citation></ref><ref id="B22"><label>22</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Doull</surname><given-names>J</given-names></name></person-group><article-title>The effect of physical environmental factors on drug response. In</article-title><source>Essays in Toxicology</source><year>1972</year><publisher-loc>Washington</publisher-loc><publisher-name>Academic Press</publisher-name><fpage>37</fpage><lpage>63</lpage></citation></ref><ref id="B23"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fuhrman</surname><given-names>GJ</given-names></name><name><surname>Fuhrman</surname><given-names>FA</given-names></name></person-group><article-title>Effect of temperature on the action of drugs</article-title><source>Ann Rev Pharmacol</source><year>1961</year><volume>1</volume><fpage>65</fpage><lpage>78</lpage></citation></ref><ref id="B24"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cremer</surname><given-names>JE</given-names></name><name><surname>Bligh</surname><given-names>J</given-names></name></person-group><article-title>Body temperature and responses to drugs</article-title><source>Br Med Bull</source><year>1969</year><volume>25</volume><fpage>299</fpage><lpage>306</lpage><pub-id pub-id-type="pmid">4898287</pub-id></citation></ref><ref id="B25"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weihe</surname><given-names>WH</given-names></name></person-group><article-title>The effect of temperature on the action of drugs</article-title><source>Ann Rev Pharmacol</source><year>1973</year><volume>13</volume><fpage>409</fpage><lpage>25</lpage><pub-id pub-id-type="pmid">4576895</pub-id></citation></ref><ref id="B26"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lundgren-Eriksson</surname><given-names>L</given-names></name><name><surname>Carlsson</surname><given-names>A</given-names></name><name><surname>Ottosson-Lonn</surname><given-names>S</given-names></name><name><surname>Ryd</surname><given-names>W</given-names></name><name><surname>Hultborn</surname><given-names>R</given-names></name></person-group><article-title>Chlorpromazine-induced hypothermia: effect of tumour progression and survival in mice</article-title><source>Anticancer Res</source><year>1996</year><volume>16</volume><fpage>333</fpage><lpage>36</lpage><pub-id pub-id-type="pmid">8615632</pub-id></citation></ref><ref id="B27"><label>27</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lundgren-Eriksson</surname><given-names>L</given-names></name><name><surname>Palm</surname><given-names>A</given-names></name><name><surname>Ryd</surname><given-names>W</given-names></name><name><surname>Warnhammar</surname><given-names>E</given-names></name><name><surname>Hultborn</surname><given-names>R</given-names></name></person-group><article-title>Radio and chemotherapy in mice during hypothermia</article-title><source>Anticancer Res</source><year>2001</year><volume>21</volume><fpage>3269</fpage><lpage>74</lpage><pub-id pub-id-type="pmid">11848482</pub-id></citation></ref><ref id="B28"><label>28</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Engelhardt</surname><given-names>R</given-names></name></person-group><article-title>Hypothermia and drugs. In:</article-title><source>Recent Results in Cancer Research</source><year>1987</year><volume>Vol 104</volume><publisher-loc>New York</publisher-loc><publisher-name>Springer-Verlag Berlin Heidelberg</publisher-name></citation></ref><ref id="B29"><label>29</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Averill</surname><given-names>DA</given-names></name><name><surname>Larrivee</surname><given-names>B. Hyperthermia</given-names></name></person-group><article-title>cyclosporine A and melphalan cytotoxicity and transport in multidrug resistant cells</article-title><source>Int J Hyperthermia</source><year>1998</year><volume>14</volume><fpage>583</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">9886664</pub-id></citation></ref><ref id="B30"><label>30</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Takemoto</surname><given-names>M</given-names></name><name><surname>Kuroda</surname><given-names>M</given-names></name><name><surname>Urano</surname><given-names>M</given-names></name><etal/></person-group><article-title>The effect of various chemotherapeutic agents given with mild hyperthermia on different types of tumours</article-title><source>Int J Hyperthermia</source><year>2003</year><volume>19</volume><fpage>193</fpage><lpage>203</lpage><pub-id pub-id-type="pmid">12623641</pub-id></citation></ref><ref id="B31"><label>31</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Urano</surname><given-names>M</given-names></name><name><surname>Ling</surname><given-names>CC</given-names></name></person-group><article-title>Thermal enhancement of melphalan and oxaliplatin cytotoxicity in vitro</article-title><source>Int J Hypothermia</source><year>2002</year><volume>18</volume><fpage>307</fpage><lpage>15</lpage></citation></ref><ref id="B32"><label>32</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mi</surname><given-names>L</given-names></name><name><surname>Gong</surname><given-names>W</given-names></name><name><surname>Nelson</surname><given-names>P</given-names></name><name><surname>Martin</surname><given-names>L</given-names></name><name><surname>Sawyer</surname><given-name