erson-group><article-title>NMR microscopy &#x02013; fundamentals, limits and possible applications</article-title><source>Angew Chem Int Ed Engl</source><year>1990</year><volume>29</volume><fpage>1</fpage><lpage>12</lpage></citation></ref><ref id="b18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Louie</surname><given-names>A</given-names></name></person-group><article-title>Magnetic resonance imaging contrast agents in the study of development</article-title><source>Curr Topics</source><year>2005</year><volume>70</volume><fpage>35</fpage><lpage>56</lpage></citation></ref><ref id="b19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nelson</surname><given-names>KL</given-names></name><name><surname>Runge</surname><given-names>VM</given-names></name></person-group><article-title>Basic principles of MR contrast</article-title><source>Top Magn Reson Imaging</source><year>1995</year><volume>7</volume><fpage>124</fpage><lpage>136</lpage><pub-id pub-id-type="pmid">7654392</pub-id></citation></ref><ref id="b20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>New</surname><given-names>DAT</given-names></name></person-group><source>The Culture of Vertebrate Embryos</source><year>1966</year><publisher-loc>London</publisher-loc><publisher-name>Logos Press</publisher-name><fpage>1</fpage><lpage>245</lpage></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Niswander</surname><given-names>L</given-names></name></person-group><article-title>Pattern formation: old models out on a limb</article-title><source>Nat Rev Genet</source><year>2003</year><volume>4</volume><fpage>133</fpage><lpage>143</lpage><pub-id pub-id-type="pmid">12560810</pub-id></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Robson</surname><given-names>LG</given-names></name><name><surname>Kara</surname><given-names>T</given-names></name><name><surname>Crawley</surname><given-names>A</given-names></name><name><surname>Tickle</surname><given-names>C</given-names></name></person-group><article-title>Tissue and cellular patterning of the musculature in chick wings</article-title><source>Development</source><year>1994</year><volume>120</volume><fpage>1265</fpage><lpage>1276</lpage><pub-id pub-id-type="pmid">8026335</pub-id></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ruffins</surname><given-names>SW</given-names></name><name><surname>Martin</surname><given-names>M</given-names></name><name><surname>Keough</surname><given-names>L</given-names></name><etal/></person-group><article-title>Digital three-dimensional atlas of quail development using high-resolution MRI</article-title><source>Scientific World Journal</source><year>2007</year><volume>2</volume><fpage>47</fpage><lpage>59</lpage></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schneider</surname><given-names>JE</given-names></name><name><surname>Bamforth</surname><given-names>SD</given-names></name><name><surname>Farthing</surname><given-names>CR</given-names></name><name><surname>Clarke</surname><given-names>K</given-names></name><name><surname>Neubauer</surname><given-names>S</given-names></name><name><surname>Bhattacharya</surname><given-names>S</given-names></name></person-group><article-title>High-resolution imaging of normal anatomy, and neural and adrenal malformations in mouse embryos using magnetic resonance microscopy</article-title><source>J Anat</source><year>2003</year><volume>202</volume><fpage>239</fpage><lpage>247</lpage><pub-id pub-id-type="pmid">12647873</pub-id></citation></ref><ref id="b25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>BR</given-names></name></person-group><article-title>Magnetic resonance imaging analysis of embryos</article-title><source>Methods Mol Biol</source><year>2000</year><volume>135</volume><fpage>211</fpage><lpage>216</lpage><pub-id pub-id-type="pmid">10791318</pub-id></citation></ref><ref id="b26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>BR</given-names></name><name><surname>Johnson</surname><given-names>GA</given-names></name><name><surname>Groman</surname><given-names>EV</given-names></name><name><surname>Linney</surname><given-names>E</given-names></name></person-group><article-title>Magnetic resonance microscopy of mouse embryos</article-title><source>Dev Biol</source><year>1994</year><volume>91</volume><fpage>3530</fpage><lpage>3533</lpage></citation></ref><ref id="b27"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Thompson</surname><given-names>TJU</given-names></name><name><surname>Chudek</surname><given-names>JA</given-names></name></person-group><article-title>A novel approach to the visualisation of heat-induced structural change in bone</article-title><source>Science and Justice</source><volume>47</volume><fpage>99</fpage><lpage>104</lpage></citation></ref><ref id="b28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tickle</surname><given-names>C</given-names></name></person-group><article-title>The contribution of chicken embryology to the understanding of vertebrate limb development</article-title><source>Mech Dev</source><year>2004</year><volume>121</volume><fpage>1019</fpage><lpage>1029</lpage><pub-id pub-id-type="pmid">15296968</pub-id></citation></ref><ref id="b29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tickle</surname><given-names>C</given-names></name><name><surname>Lee</surname><given-names>J</given-names></name><name><surname>Eichele</surname><given-names>G</given-names></name></person-group><article-title>A quantitative analysis of the effect of all-trans-retinoic acid on the pattern of chick development</article-title><source>Dev Biol</source><year>1985</year><volume>109</volume><fpage>82</fpage><lpage>95</lpage><pub-id pub-id-type="pmid">3987968</pub-id></citation></ref></ref-list><sec sec-type="supplementary-material"><title>Supplementary material</title><p>The following supplementary material is available for this article:</p><supplementary-material content-type="local-data" id="SD1"><label>Video Clip S1</label><caption><p>&#x000b5;MRI spin echo images of chick embryos. (a) Longitudinal slices from a 3D dataset with T<sub>R</sub>/T<sub>E</sub> = 200/6.3 ms. (b) 3D surface rendering from that dataset showing anatomy manually extracted using <sc>AMIRA</sc>. Matrix size is 128 &#x000d7; 128 &#x000d7; 128. Field of view and voxel dimensions, 10 &#x000d7; 10 &#x000d7; 10 mm; 80 &#x000d7; 80 &#x000d7; 80 &#x000b5;m.</p></caption><media xlink:href="joa211-0798-SD1.avi" xlink:type="simple" id="N0x20bfca0N0x3810920" position="anchor" mimetype="video" mime-subtype="x-msvideo"/><media xlink:href="joa211-0798-SD1a.avi" xlink:type="simple" id="N0x20bfca0N0x3810980" position="anchor" mimetype="video" mime-subtype="x-msvideo"/></supplementary-material><supplementary-material content-type="local-data" id="SD2"><label>Video Clip S2</label><caption><p>3D &#x000b5;MRI spin echo images of chick embryos. (a&#x02013;b) Full datasets showing slices through a Day 6 embryo (Gd contrast agent applied <italic>in vivo</italic>, fixed after 1 h and embedded in agar containing contrast agent), T<sub>R</sub>/T<sub>E</sub> = 300/10 ms, Matrix size: 512 &#x000d7; 512 &#x000d7; 512. Field of view and voxel dimensions, 10.0 &#x000d7; 10.0 &#x000d7;10.0 mm; 20 &#x000d7; 20 &#x000d7; 20 &#x000b5;m.</p></caption><media xlink:href="joa211-0798-SD2.avi" xlink:type="simple" id="N0x20bfca0N0x3810a40" position="anchor" mimetype="video" mime-subtype="x-msvideo"/><media xlink:href="joa211-0798-SD2a.avi" xlink:type="simple" id="N0x20bfca0N0x3e13550" position="anchor" mimetype="video" mime-subtype="x-msvideo"/></supplementary-material><supplementary-material content-type="local-data" id="SD3"><label>Video Clip S3</label><caption><p>3D &#x000b5;MRI spin echo image of a live Day 7 quail embryo in its egg, after injection with contrast agent in the brain showing regions of interest surface rendered using <sc>AMIRA</sc> software. Matrix size is 128 &#x000d7; 128 &#x000d7; 128. Field of view and voxel dimensions, 30.0 &#x000d7; 30.0 &#x000d7; 30.0 mm; 240 &#x000d7; 240 &#x000d7; 240 &#x000b5;m.</p></caption><media xlink:href="joa211-0798-SD3.avi" xlink:type="simple" id="N0x20bfca0N0x3e13610" position="anchor" mimetype="video" mime-subtype="x-msvideo"/></supplementary-material><supplementary-material content-type="local-data" id="SD4"><label>Video Clip S4</label><caption><p>(a and b) 3D <sc>AMIRA</sc> reconstructions of &#x000b5;MRI spin echo images of excised Day 10 and Day 14 chick embryo wings.</p></caption><media xlink:href="joa211-0798-SD4.avi" xlink:type="simple" id="N0x20bfca0N0x3e136d0" position="anchor" mimetype="video" mime-subtype="x-msvideo"/><media xlink:href="joa211-0798-SD4a.avi" xlink:type="simple" id="N0x20bfca0N0x3e13730" position="anchor" mimetype="video" mime-subtype="x-msvideo"/></supplementary-material><supplementary-material content-type="local-data" id="SD5"><label>Video Clip S5</label><caption><p>&#x000b5;MRI gradient-echo images of chick embryo leg showing 3D surface rendering of bones and individual muscles using <sc>AMIRA</sc> software. T<sub>R</sub>/T<sub>E</sub> = 1000/40 ms. Matrix size is 128 &#x000d7; 128 &#x000d7; 128. Field of view and voxel dimensions, 25.0 &#x000d7; 25.0 &#x000d7; 25.0 mm; 200 &#x000d7; 200 &#x000d7; 200 &#x000b5;m.</p></caption><media xlink:href="joa211-0798-SD5.avi" xlink:type="simple" id="N0x20bfca0N0x3e137f0" position="anchor" mimetype="video" mime-subtype="x-msvideo"/></supplementary-material><supplementary-material content-type="local-data" id="SD6"><label>Video Clip S6</label><caption><p>&#x000b5;MRI images of a Day 13, 43234 experimentally manipulated chick wing. (a) Data from spin echo acquisition, T<sub>R</sub>/T<sub>E</sub> = 300/40 ms and (b) animation of surface rendering of data. Matrix size is 256 &#x000d7; 256 &#x000d7; 256. Field of view and voxel dimensions, 12.0 &#x000d7; 12.0 &#x000d7; 12.0 mm; 50 &#x000d7; 50 &#x000d7; 50 &#x000b5;m.</p></caption><media xlink:href="joa211-0798-SD6.avi" xlink:type="simple" id="N0x20bfca0N0x3e138b0" position="anchor" mimetype="video" mime-subtype="x-msvideo"/><media xlink:href="joa211-0798-SD6a.avi" xlink:type="simple" id="N0x20bfca0N0x3e13910" position="anchor" mimetype="video" mime-subtype="x-msvideo"/></supplementary-material><p>This material is available as part of the online article from:</p><p><ext-link ext-link-type="doi" xlink:href="10.1111/j.1469-7580.2007.00825.x">10.1111/j.1469-7580.2007.00825.x</ext-link> (This link will take you to the article abstract).</p><p>Please note: Blackwell Publishing are not responsible for the content or functionality of any supplementary materials supplied by the authors. Any queries (other than missing material) should be directed to the corresponding author for the article.</p></sec></back></article>