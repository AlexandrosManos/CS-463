me><surname>Ehrlich</surname><given-names>M</given-names></name></person-group><article-title>Testing the position-effect variegation hypothesis for facioscapulohumeral muscular dystrophy by analysis of histone modification and gene expression in subtelomeric 4q</article-title><source>Hum. Mol. Genet</source><year>2003</year><volume>12</volume><fpage>2909</fpage><lpage>2921</lpage><pub-id pub-id-type="pmid">14506132</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Deak</surname><given-names>KL</given-names></name><name><surname>Lemmers</surname><given-names>RJ</given-names></name><name><surname>Stajich</surname><given-names>JM</given-names></name><name><surname>Klooster</surname><given-names>R</given-names></name><name><surname>Tawil</surname><given-names>R</given-names></name><name><surname>Frants</surname><given-names>RR</given-names></name><name><surname>Speer</surname><given-names>MC</given-names></name><name><surname>van der Maarel</surname><given-names>SM</given-names></name><name><surname>Gilbert</surname><given-names>JR</given-names></name></person-group><article-title>Genotype-phenotype study in an FSHD family with a proximal deletion encompassing p13E-11 and D4Z4</article-title><source>Neurology</source><year>2007</year><volume>68</volume><fpage>578</fpage><lpage>582</lpage><pub-id pub-id-type="pmid">17229919</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Ehrlich</surname><given-names>M</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Cooper</surname><given-names>DN</given-names></name><name><surname>Upadhyaya</surname><given-names>M</given-names></name></person-group><source>FSHD Facioscapulohumeral Muscular Dystrophy: Molecular Cell Biology &#x00026; Clinical Medicine</source><year>2004</