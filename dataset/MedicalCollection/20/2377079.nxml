><!--PubMed citation query: 'J Immunol Methods||224|61||bib10|'--><pub-id pub-id-type="pmid">10357207</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Durie</surname><given-names>BG</given-names></name><name><surname>Salmon</surname><given-names>SE</given-names></name></person-group><article-title>A clinical staging system for multiple myeloma. Correlation of measured myeloma cell mass with presenting clinical features, response to treatment, and survival</article-title><source>Cancer</source><year>1975</year><volume>36</volume><fpage>842</fpage><lpage>854</lpage><!--PubMed citation query: 'Cancer||36|842||bib11|'--><pub-id pub-id-type="pmid">1182674</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferrero</surname><given-names>E</given-names></name><name><surname>Fabbri</surname><given-names>M</given-names></name><name><surname>Poggi</surname><given-names>A</given-names></name><name><surname>Galati</surname><given-names>G</given-names></name><name><surname>Bernasconi</surname><given-names>S</given-names></name><name><surname>Zocchi</surname><given-names>MR</given-names></name></person-group><article-title>Tumor-driven matrix invasion by infiltrating lymphocytes: involvement of the alpha integrin I domain</article-title><source>Eur J Immunol</source><year>1998</year><volume>28</volume><fpage>2530</fpage><lpage>2536</lpage><!--PubMed citation query: 'Eur J Immunol||28|2530||bib12|'--><pub-id pub-id-type="pmid">9710230</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fioretti</surname><given-names>F</given-names></name><name><surname>Fradelizi</surname><given-names>D</given-names></name><name><surname>Stoppacciaro</surname><given-names>A</given-names></name><name><surname>Ramponi</surname><given-names>S</given-names></name><na