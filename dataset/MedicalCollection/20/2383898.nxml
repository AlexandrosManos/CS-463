2</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garrott</surname><given-names>HM</given-names></name><name><surname>Walland</surname><given-names>MJ</given-names></name></person-group><article-title>Glaucoma from topical corticosteroids to the eyelids</article-title><source>Clin Experiment Ophthalmol</source><year>2004</year><volume>32</volume><fpage>224</fpage><lpage>226</lpage><pub-id pub-id-type="pmid">15068445</pub-id><pub-id pub-id-type="doi">10.1111/j.1442-9071.2004.00787.x</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hayashi</surname><given-names>H</given-names></name><name><surname>Igarashi</surname><given-names>C</given-names></name><name><surname>Hayashi</surname><given-names>K</given-names></name></person-group><article-title>Frequency of ciliary body or retinal breaks and retinal detachment in eyes with atopic cataract</article-title><source>Br J Ophthalmol</source><year>2002</year><volume>86</volume><fpage>898</fpage><lpage>901</lpage><pub-id pub-id-type="pmid">12140212</pub-id><pub-id pub-id-type="doi">10.1136/bjo.86.8.898</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lim</surname><given-names>WK</given-names></name><name><surname>Chee</surname><given-names>SP</given-names></name></person-group><article-title>Retinal detachment in atopic dermatitis can masquerade as acute panuveitis with rapidly progressive cataract</article-title><source>Retina</source><year>2004</year><volume>24</volume><fpage>953</fpage><lpage>956</lpage><pub-id pub-id-type="pmid">15579995</pub-id><pub-id pub-id-type="doi">10.1097/00006982-200412000-00017</pub-id></citation></ref></ref-list></back></article>