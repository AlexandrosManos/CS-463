cle-title>Analysis of complex human genetic traits: an ordered-notation method and new tests for mode of inheritance</article-title><source>Am J Hum Genet</source><year>1995</year><volume>57</volume><fpage>474</fpage><lpage>486</lpage><pub-id pub-id-type="pmid">7668274</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thomson</surname><given-names>G</given-names></name></person-group><article-title>Mapping disease genes: family based association studies</article-title><source>Am J Hum Genet</source><year>1995</year><volume>57</volume><fpage>487</fpage><lpage>498</lpage><pub-id pub-id-type="pmid">7668275</pub-id></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kalbfleisch</surname><given-names>JG</given-names></name></person-group><article-title>Probability and statistical inference</article-title><source>Probability</source><year>1997</year><volume>1</volume><publisher-name>New York: Springer Verlag</publisher-name><fpage>255</fpage></citation></ref></ref-list></back></article>