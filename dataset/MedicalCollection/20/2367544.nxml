studies</article-title><source>Genet Epidemiol</source><year>2003</year><volume>25</volume><fpage>149</fpage><lpage>157</lpage><pub-id pub-id-type="pmid">12916023</pub-id><pub-id pub-id-type="doi">10.1002/gepi.10260</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>H</given-names></name><name><surname>Thomas</surname><given-names>DC</given-names></name><name><surname>Peer</surname><given-names>I</given-names></name><name><surname>Stram</surname><given-names>DO</given-names></name></person-group><article-title>Optimal two-stage genotyping designs for genome-wide association scan</article-title><source>Genet Epidemiol</source><year>2006</year><volume>30</volume><fpage>356</fpage><lpage>368</lpage><pub-id pub-id-type="pmid">16607626</pub-id><pub-id pub-id-type="doi">10.1002/gepi.20150</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martin</surname><given-names>ER</given-names></name><name><surname>Monks</surname><given-names>SA</given-names></name><name><surname>Warren</surname><given-names>LL</given-names></name><name><surname>Kaplan</surname><given-names>NL</given-names></name></person-group><article-title>A test for linkage and association in general pedigress: the pedigree disequilibrium test</article-title><source>Am J Hum Genet</source><year>2000</year><volume>67</volume><fpage>146</fpage><lpage>154</lpage><pub-id pub-id-type="pmid">10825280</pub-id><pub-id pub-id-type="doi">10.1086/302957</pub-id></citation></ref><ref id="B8"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Fisher</surname><given-names>RA</given-names></name></person-group><source>Statistical Methods for Research Workers</source><year>1932</year><edition>4</edition><publisher-name>London: Oliver and Boyd</publisher-name></citation></ref></ref-list></back></article>