>50</volume><fpage>162</fpage><lpage>166</lpage><pub-id pub-id-type="pmid">11393486</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Seeff</surname><given-names>LC</given-names></name><name><surname>Nadel</surname><given-names>MR</given-names></name><name><surname>Klabunde</surname><given-names>CN</given-names></name><name><surname>Thompson</surname><given-names>T</given-names></name><name><surname>Shapiro</surname><given-names>JA</given-names></name><name><surname>Vernon</surname><given-names>SW</given-names></name><name><surname>Coates</surname><given-names>RJ</given-names></name></person-group><article-title>Patterns and predictors of colorectal cancer test use in the adult U.S. population</article-title><source>Cancer</source><year>2004</year><volume>100</volume><fpage>2093</fpage><lpage>2103</lpage><pub-id pub-id-type="pmid">15139050</pub-id><pub-id pub-id-type="doi">10.1002/cncr.20276</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Walsh</surname><given-names>JM</given-names></name><name><surname>Kaplan</surname><given-names>CP</given-names></name><name><surname>Nguyen</surname><given-names>B</given-names></name><name><surname>Gildengorin</surname><given-names>G</given-names></name><name><surname>McPhee</surname><given-names>SJ</given-names></name><name><surname>Perez-Stable</surname><given-names>EJ</given-names></name></person-group><article-title>Barriers to colorectal cancer screening in Latino and Vietnamese Americans. Compared with non-Latino white Americans</article-title><source>J Gen Intern Med</source><year>2004</year><volume>19</volume><fpage>156</fpage><lpage>166</lpage><pub-id pub-id-type="pmid">15009795</pub-id><pub-id pub-id-type="doi">10.1111/j.1525-1497.2004.30263.x</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><su