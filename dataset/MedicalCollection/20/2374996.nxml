<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Genome Biol</journal-id><journal-title>Genome Biology</journal-title><issn pub-type="ppub">1465-6906</issn><issn pub-type="epub">1465-6914</issn><publisher><publisher-name>BioMed Central</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">17697342</article-id><article-id pub-id-type="pmc">2374996</article-id><article-id pub-id-type="publisher-id">gb-2007-8-8-r165</article-id><article-id pub-id-type="doi">10.1186/gb-2007-8-8-r165</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research</subject></subj-group></article-categories><title-group><article-title>A physical map of the bovine genome</article-title></title-group><contrib-group><contrib id="A1" corresp="yes" contrib-type="author"><name><surname>Snelling</surname><given-names>Warren M</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>warren.snelling@ars.usda.gov</email></contrib><contrib id="A2" contrib-type="author"><name><surname>Chiu</surname><given-names>Readman</given-names></name><xref ref-type="aff" rid="I2">2</xref><email>rchiu@bcgsc.ca</email></contrib><contrib id="A3" contrib-type="author"><name><surname>Schein</surname><given-names>Jacqueline E</given-names></name><xref ref-type="aff" rid="I2">2</xref><email>jschein@bcgsc.ca</email></contrib><contrib id="A4" contrib-type="author"><name><surname>Hobbs</surname><given-names>Matthew</given-names></name><xref ref-type="aff" rid="I3">3</xref><email>matthewh@vetsci.usyd.edu.au</email></contrib><contrib id="A5" contrib-type="author"><name><surname>Abbey</surname><given-names>Colette A</given-names></name><xref ref-type="aff" rid="I4">4</xref><email>c-abbey@neo.tamu.edu</email></contrib><contrib id="A6" contrib-type="author"><name><surname>Adelson</surname><given-names>David L</given-names></name><xref ref-type="aff" rid="I4">4</xref><email>david.adelson@tamu.edu</email></contrib><contrib id="A7" contrib-type="author"><name><surname>Aerts</surname><given-names>Jan</given-names></name><xref ref-type="aff" rid="I5">5</xref><email>jan.aerts@bbsrc.ac.uk</email></contrib><contrib id="A8" contrib-type="author"><name><surname>Bennett</surname><given-names>Gary L</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>gary.bennett@ars.usda.gov</email></contrib><contrib id="A9" contrib-type="author"><name><surname>Bosdet</surname><given-names>Ian E</given-names></name><xref ref-type="aff" rid="I2">2</xref><email>ibosdet@bcgsc.ca</email></contrib><contrib id="A10" contrib-type="author"><name><surname>Boussaha</surname><given-names>Mekki</given-names></name><xref ref-type="aff" rid="I6">6</xref><email>mboussah@jouy.inra.fr</email></contrib><contrib id="A11" contrib-type="author"><name><surname>Brauning</surname><given-names>Rudiger</given-names></name><xref ref-type="aff" rid="I7">7</xref><email>rudiger.brauning@agresearch.co.nz</email></contrib><contrib id="A12" contrib-type="author"><name><surname>Caetano</surname><given-names>Alexandre R</given-names></name><xref ref-type="aff" rid="I8">8</xref><email>acaetano@cenargen.embrapa.br</email></contrib><contrib id="A13" contrib-type="author"><name><surname>Costa</surname><given-names>Marcos M</given-names></name><xref ref-type="aff" rid="I8">8</xref><email>mcosta@cenargen.embrapa.br</email></contrib><contrib id="A14" contrib-type="author"><name><surname>Crawford</surname><given-names>Allan M</given-names></name><xref ref-type="aff" rid="I7">7</xref><email>allan.crawford@agresearch.co.nz</email></contrib><contrib id="A15" contrib-type="author"><name><surname>Dalrymple</surname><given-names>Brian P</given-names></name><xref ref-type="aff" rid="I9">9</xref><email>brian.dalrymple@csiro.au</email></contrib><contrib id="A16" contrib-type="author"><name><surname>Eggen</surname><given-names>Andr&#x000e9;</given-names></name><xref ref-type="aff" rid="I6">6</xref><email>andre.eggen@jouy.inra.fr</email></contrib><contrib id="A17" contrib-type="author"><name><surname>Everts-van der Wind</surname><given-names>Annelie</given-names></name><xref ref-type="aff" rid="I10">10</xref><email>vdwind@uiuc.edu</email></contrib><contrib id="A18" contrib-type="author"><name><surname>Floriot</surname><given-names>Sandrine</given-names></name><xref ref-type="aff" rid="I6">6</xref><email>Sandrine.Fenech@jouy.inra.fr</email></contrib><contrib id="A19" contrib-type="author"><name><surname>Gautier</surname><given-names>Mathieu</given-names></name><xref ref-type="aff" rid="I6">6</xref><email>mathieu.gautier@jouy.inra.fr</email></contrib><contrib id="A20" contrib-type="author"><name><surname>Gill</surname><given-names>Clare A</given-names></name><xref ref-type="aff" rid="I4">4</xref><email>clare-gill@ansc.tamu.edu</email></contrib><contrib id="A21" contrib-type="author"><name><surname>Green</surname><given-names>Ronnie D</given-names></name><xref ref-type="aff" rid="I11">11</xref><email>ronnie.green@ars.usda.gov</email></contrib><contrib id="A22" contrib-type="author"><name><surname>Holt</surname><given-names>Robert</given-names></name><xref ref-type="aff" rid="I2">2</xref><email>rholt@bcgsc.ca</email></contrib><contrib id="A23" contrib-type="author"><name><surname>Jann</surname><given-names>Oliver</given-names></name><xref ref-type="aff" rid="I5">5</xref><email>oliver.jann@bbsrc.ac.uk</email></contrib><contrib id="A24" contrib-type="author"><name><surname>Jones</surname><given-names>Steven JM</given-names></name><xref ref-type="aff" rid="I2">2</xref><email>sjones@bcgsc.ca</email></contrib><contrib id="A25" contrib-type="author"><name><surname>Kappes</surname><given-names>Steven M</given-names></name><xref ref-type="aff" rid="I11">11</xref><email>Steven.Kappes@ars.usda.gov</email></contrib><contrib id="A26" contrib-type="author"><name><surname>Keele</surname><given-names>John W</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>john.keele@ars.usda.gov</email></contrib><contrib id="A27" contrib-type="author"><name><surname>de Jong</surname><given-names>Pieter J</given-names></name><xref ref-type="aff" rid="I12">12</xref><email>pdejong@chori.org</email></contrib><contrib id="A28" contrib-type="author"><name><surname>Larkin</surname><given-names>Denis M</given-names></name><xref ref-type="aff" rid="I10">10</xref><email>dlarkin@uiuc.edu</email></contrib><contrib id="A29" contrib-type="author"><name><surname>Lewin</surname><given-names>Harris A</given-names></name><xref ref-type="aff" rid="I10">10</xref><xref ref-type="aff" rid="I13">13</xref><email>h-lewin@uiuc.edu</email></contrib><contrib id="A30" contrib-type="author"><name><surname>McEwan</surname><given-names>John C</given-names></name><xref ref-type="aff" rid="I7">7</xref><email>john.mcewan@agresearch.co.nz</email></contrib><contrib id="A31" contrib-type="author"><name><surname>McKay</surname><given-names>Stephanie</given-names></name><xref ref-type="aff" rid="I14">14</xref><email>Stephanie.McKay@afhe.ualberta.ca</email></contrib><contrib id="A32" contrib-type="author"><name><surname>Marra</surname><given-names>Marco A</given-names></name><xref ref-type="aff" rid="I2">2</xref><email>mmarra@bcgsc.ca</email></contrib><contrib id="A33" contrib-type="author"><name><surname>Mathewson</surname><given-names>Carrie A</given-names></name><xref ref-type="aff" rid="I2">2</xref><email>cmathew@bcgsc.ca</email></contrib><contrib id="A34" contrib-type="author"><name><surname>Matukumalli</surname><given-names>Lakshmi K</given-names></name><xref ref-type="aff" rid="I15">15</xref><email>lmatukum@anri.barc.usda.gov</email></contrib><contrib id="A35" contrib-type="author"><name><surname>Moore</surname><given-names>Stephen S</given-names></name><xref ref-type="aff" rid="I14">14</xref><email>stephen.moore@afhe.ualberta.ca</emai