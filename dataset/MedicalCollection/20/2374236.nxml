e><surname>Taylor</surname><given-names>GM</given-names></name><name><surname>McNally</surname><given-names>RJ</given-names></name></person-group><article-title>Space-time clustering patterns in childhood leukaemia support a role for infection</article-title><source>Br J Cancer</source><year>2000</year><volume>82</volume><fpage>1571</fpage><lpage>1576</lpage><!--PubMed citation query: 'Br J Cancer||82|1571||bib9|'--><pub-id pub-id-type="pmid">10789727</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clavel</surname><given-names>J</given-names></name><name><surname>Goubin</surname><given-names>A</given-names></name><name><surname>Auclerc</surname><given-names>MF</given-names></name><name><surname>Auvrignon</surname><given-names>A</given-names></name><name><surname>Waterkeyn</surname><given-names>C</given-names></name><name><surname>Patte</surname><given-names>C</given-names></name><name><surname>Baruchel</surname><given-names>A</given-names></name><name><surname>Leverger</surname><given-names>G</given-names></name><name><surname>Nelken</surname><given-names>B</given-names></name><name><surname>Philippe</surname><given-names>N</given-names></name><name><surname>Sommelet</surname><given-names>D</given-names></name><name><surname>Vilmer</surname><given-names>E</given-names></name><name><surname>Bellec</surname><given-names>S</given-names></name><name><surname>Perrillat-Menegaux</surname><given-names>F</given-names></name><name><surname>Hemon</surname><given-names>D</given-names></name></person-group><article-title>Incidence of childhood leukaemia and non-Hodgkin's lymphoma in France: National Registry of Childhood Leukaemia and Lymphoma, 1990&#x02013;1999</article-title><source>Eur J Cancer Prev</source><year>2004</year><volume>13</volume><fpage>97</fpage><lpage>103</lpage><!--PubMed citation query: 'Eur J Cancer Prev||13|97||bib10|'--><pub-id pub-id-type="pmid">15100575</pub-id></citation