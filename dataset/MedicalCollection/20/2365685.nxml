570</lpage><pub-id pub-id-type="pmid">7828077</pub-id></citation></ref><ref id="b16-md503071"><label>16</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Jukes</surname><given-names>TH</given-names></name><name><surname>Cantor</surname><given-names>CR</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Munro</surname><given-names>HH</given-names></name></person-group><source>Mammalian protein metabolism</source><publisher-name>Academic Press</publisher-name><publisher-loc>New York NY</publisher-loc><year>1969</year><fpage>21</fpage><lpage>132</lpage></citation></ref><ref id="b17-md503071"><label>17</label><citation citation-type="book"><collab>National Committee for Clinical Laboratory Standards</collab><source>Methods for dilution antimicrobial susceptibility tests for bacteria that grow aerobically: approved standard M7-A</source><publisher-name>National Committee for Clinical Laboratory Standards</publisher-name><publisher-loc>Villanova PA</publisher-loc><year>1991</year></citation></ref><ref id="b18-md503071"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Singh</surname><given-names>MP</given-names></name><name><surname>Petersen</surname><given-names>PJ</given-names></name><name><surname>Weiss</surname><given-names>WJ</given-names></name><name><surname>Kong</surname><given-names>F</given-names></name><name><surname>Greenstein</surname><given-names>M</given-names></name></person-group><article-title>Saccharomicins, novel heptadecaglycoside antibiotics produced by <italic>S. espanaensis</italic>: Antibacterial and mechanistic activities</article-title><source>Antimicrob Agents Chemother</source><year>2000</year><volume>44</volume><fpage>2154</fpage><lpage>2159</lpage><pub-id pub-id-type="pmid">10898690</pub-id></citation></ref><ref id="b19-md503071"><label>19</label><citation citation-type="journal"><person-group person-gro