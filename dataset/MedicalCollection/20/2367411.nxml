tation publication-type="journal"><person-group person-group-type="author"><name><surname>Saraph</surname><given-names>V</given-names></name><name><surname>Lerch</surname><given-names>C</given-names></name><name><surname>Walochnik</surname><given-names>N</given-names></name><etal/></person-group><article-title>Comparison of conventional versus minimally invasive extraperitoneal approach for anterior lumbar interbody fusion</article-title><source>Eur Spine J</source><year>2004</year><volume>13</volume><fpage>425</fpage><lpage>431</lpage><pub-id pub-id-type="doi">10.1007/s00586-004-0722-4</pub-id><pub-id pub-id-type="pmid">15138863</pub-id></mixed-citation></ref><ref id="CR27"><label>27.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Stauffer</surname><given-names>RN</given-names></name><name><surname>Coventry</surname><given-names>MB</given-names></name></person-group><article-title>Posteriolateral lumbar spine fusion</article-title><source>J Bone Joint Surg Am</source><year>1972</year><volume>54</volume><fpage>1195</fpage><lpage>1204</lpage><pub-id pub-id-type="pmid">4265646</pub-id></mixed-citation></ref></ref-list></back></article>