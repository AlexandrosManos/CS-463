son-group><article-title>Is laparoscopic anterior lumbar interbody fusion a useful minimally invasive procedure?</article-title><source>Neurosugery</source><year>2002</year><volume>51</volume><fpage>155</fpage><lpage>158</lpage></mixed-citation></ref><ref id="CR20"><label>20.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mayer</surname><given-names>HM</given-names></name></person-group><article-title>A new microsurgical technique for minimally invasive anterior lumbar interbody fusion</article-title><source>Spine</source><year>1997</year><volume>22</volume><fpage>691</fpage><lpage>699</lpage><pub-id pub-id-type="doi">10.1097/00007632-199703150-00023</pub-id><pub-id pub-id-type="pmid">9089943</pub-id></mixed-citation></ref><ref id="CR21"><label>21.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nakagawa</surname><given-names>H</given-names></name><name><surname>Kamimura</surname><given-names>M</given-names></name><name><surname>Uchiyama</surname><given-names>S</given-names></name><etal/></person-group><article-title>Microendoscopic discectomy (MED) for lumbar disc prolapse</article-title><source>J Clin Neurosci</source><year>2003</year><volume>10</volume><fpage>231</fpage><lpage>235</lpage><pub-id pub-id-type="doi">10.1016/S0967-5868(02)00337-5</pub-id><pub-id pub-id-type="pmid">12637057</pub-id></mixed-citation></ref><ref id="CR22"><label>22.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Penta</surname><given-names>M</given-names></name><name><surname>Fraser</surname><given-names>RD</given-names></name></person-group><article-title>Anterior lumbar interbody fusion&#x02014;a minimum 10-year follow-up</article-title><source>Spine</source><year>1997</year><volume>22</volume><fpage>2429</fpage><lpage>2434</lpage><pub-id pub-id-type="doi">10.1097/00007632-199710150-00021</pub-id><pub-id pub-id-t