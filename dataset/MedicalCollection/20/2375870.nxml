oup person-group-type="author"><name><surname>Wyman</surname><given-names>CE</given-names></name><name><surname>Dale</surname><given-names>BE</given-names></name><name><surname>Elander</surname><given-names>RT</given-names></name><name><surname>Holtzapple</surname><given-names>M</given-names></name><name><surname>Ladisch</surname><given-names>MR</given-names></name><name><surname>Lee</surname><given-names>YY</given-names></name></person-group><article-title>Coordinated development of leading biomass pretreatment technologies</article-title><source>Bioresour Technol</source><year>2005</year><volume>96</volume><fpage>1959</fpage><lpage>1966</lpage><pub-id pub-id-type="pmid">16112483</pub-id><pub-id pub-id-type="doi">10.1016/j.biortech.2005.01.010</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ramos</surname><given-names>LP</given-names></name></person-group><article-title>The chemistry involved in the steam treatment of lignocellulosic materials</article-title><source>Quim Nova</source><year>2003</year><volume>26</volume><fpage>863</fpage><lpage>871</lpage></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chang</surname><given-names>VS</given-names></name><name><surname>Holtzapple</surname><given-names>MT</given-names></name></person-group><article-title>Fundamental factors affecting biomass enzymatic reactivity</article-title><source>Appl Biochem Biotechnol</source><year>2000</year><volume>84</volume><fpage>5</fpage><lpage>37</lpage><pub-id pub-id-type="pmid">10849776</pub-id><pub-id pub-id-type="doi">10.1385/ABAB:84-86:1-9:5</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ballesteros</surname><given-names>I</given-names></name><name><surname>Negro</surname><given-names>MJ</given-names></name><name><surname>Oliva</surname><given-names>JM</g