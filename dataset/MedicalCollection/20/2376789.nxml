><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50"><italic><bold>P&#x0003d;0.0004</bold></italic></td><td align="center" valign="top" charoff="50"><italic><bold>P&#x0003d;0.0002</bold></italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="4" align="left" valign="top" charoff="50">Histological malignancy grade<hr/></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;I (ductal)</td><td align="center" valign="top" charoff="50">36</td><td align="center" valign="top" charoff="50">88 (5)</td><td align="center" valign="top" charoff="50">92 (5)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;II (ductal)</td><td align="center" valign="top" charoff="50">87</td><td align="center" valign="top" charoff="50">66 (5)</td><td align="center" valign="top" charoff="50">69 (5)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;III (ductal)</td><td align="center" valign="top" charoff="50">74</td><td align="center" valign="top" charoff="50">55 (6)</td><td align="center" valign="top" charoff="50">49 (6)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Other (nonductal)</td><td align="center" valign="top" charoff="50">31</td><td align="center" valign="top" charoff="50">76 (8)</td><td align="center" valign="top" charoff="50">74 (8)</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50"><italic><bold>P&#x0003d;0.0061</bold></italic></td><td align="center" valign="top" charoff="50"><italic><bold>P&#x0003d;0.0007</bold></italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x0