me><surname>Bardet</surname><given-names>E</given-names></name><name><surname>Sire</surname><given-names>C</given-names></name><name><surname>Germain</surname><given-names>T</given-names></name><name><surname>Bergerot</surname><given-names>P</given-names></name><name><surname>Rhein</surname><given-names>B</given-names></name><name><surname>Tortochaux</surname><given-names>J</given-names></name><name><surname>Oudinot</surname><given-names>P</given-names></name><name><surname>Bertrand</surname><given-names>P</given-names></name></person-group><article-title>Randomized trial of radiation therapy versus concomitant chemotherapy and radiation therapy for advanced-stage oropharynx carcinoma</article-title><source>J Natl Cancer Inst</source><year>1999</year><volume>91</volume><fpage>2081</fpage><lpage>2086</lpage><!--PubMed citation query: 'J Natl Cancer Inst||91|2081||bib8|'--><pub-id pub-id-type="pmid">10601378</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Classen</surname><given-names>J</given-names></name><name><surname>Paulsen</surname><given-names>F</given-names></name><name><surname>Budach</surname><given-names>W</given-names></name><name><surname>Bamberg</surname><given-names>M</given-names></name></person-group><article-title>Untersuchungen zur Chemosensitivit&#x000e4;t humaner Plattenepithelkarzinome im Nacktmausmodell</article-title><source>Strahlenther Onkol</source><year>1998</year><volume>174</volume><supplement>Suppl 1</supplement><fpage>109</fpage><!--PubMed citation query: 'Strahlenther Onkol||174|109||bib9|'--><pub-id pub-id-type="pmid">9487376</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Denekamp</surname><given-names>J</given-names></name><name><surname>Dasu</surname><given-names>A</given-names></name></person-group><article-title>Inducible repair and the two forms of tumour hypoxia tim