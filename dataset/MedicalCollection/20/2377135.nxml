"author"><name><surname>Bruning</surname><given-names>PF</given-names></name><name><surname>van Doorn</surname><given-names>J</given-names></name><name><surname>Bonfrer</surname><given-names>JM</given-names></name><name><surname>van Noord</surname><given-names>PAH</given-names></name><name><surname>Korse</surname><given-names>CM</given-names></name><name><surname>Linders</surname><given-names>TC</given-names></name><name><surname>Hart</surname><given-names>AA</given-names></name></person-group><article-title>Insulin-like growth factor binding protein 3 is decreased in early stage operable pre-menopausal breast cancer</article-title><source>Int J Cancer</source><year>1995</year><volume>62</volume><fpage>266</fpage><lpage>270</lpage><!--PubMed citation query: 'Int J Cancer||62|266||bib8|'--><pub-id pub-id-type="pmid">7543079</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Deusberg</surname><given-names>P</given-names></name><name><surname>Rausch</surname><given-names>C</given-names></name><name><surname>Rasnick</surname><given-names>D</given-names></name><name><surname>Helmann</surname><given-names>R</given-names></name></person-group><article-title>Genetic instability of cancer cells is proportional to their degree of aneuploidy</article-title><source>Proc Natl Acad Sci USA</source><year>1998</year><volume>95</volume><fpage>13692</fpage><lpage>13697</lpage><!--PubMed citation query: 'Proc Natl Acad Sci USA||95|13692||bib9|'--></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eleff</surname><given-names>S</given-names></name><name><surname>Kennaway</surname><given-names>NG</given-names></name><name><surname>Buist</surname><given-names>NRM</given-names></name><name><surname>Darley-Usmar</surname><given-names>VM</given-names></name><name><surname>Capaldi</surname><given-names>RA</given-names></name><name><surname>Bank