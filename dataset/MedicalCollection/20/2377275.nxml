<fpage>785</fpage><lpage>92</lpage><pub-id pub-id-type="pmid">11533657</pub-id><pub-id pub-id-type="doi">10.1038/ncb0901-785</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Di Carlo</surname><given-names>E</given-names></name><name><surname>Diodoro</surname><given-names>MG</given-names></name><name><surname>Boggio</surname><given-names>K</given-names></name><name><surname>Modesti</surname><given-names>A</given-names></name><name><surname>Modesti</surname><given-names>M</given-names></name><name><surname>Nanni</surname><given-names>P</given-names></name><name><surname>Forni</surname><given-names>G</given-names></name><name><surname>Musiani</surname><given-names>P</given-names></name></person-group><article-title>Analysis of mammary carcinoma onset and progression in HER-2/neu oncogene transgenic mice reveals a lobular origin</article-title><source>Lab Invest</source><year>1999</year><volume>79</volume><fpage>1261</fpage><lpage>69</lpage><pub-id pub-id-type="pmid">10532589</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Werb</surname><given-names>Z</given-names></name><name><surname>Ashkenas</surname><given-names>J</given-names></name><name><surname>MacAuley</surname><given-names>A</given-names></name><name><surname>Wiesen</surname><given-names>JF</given-names></name></person-group><article-title>Extracellular matrix remodeling as a regulator of stromal-epithelial interactions during mammary gland development, involution and carcinogenesis</article-title><source>Braz J Med Biol Res</source><year>1996</year><volume>29</volume><fpage>1087</fpage><lpage>97</lpage><pub-id pub-id-type="pmid">9181050</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Singer</surname><given-names>CF</given-names></name><name><surname>Kronsteiner</surname><