618</pub-id><pub-id pub-id-type="doi">10.1258/jrsm.95.11.545</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mann</surname><given-names>R</given-names></name><name><surname>Williams</surname><given-names>J</given-names></name></person-group><article-title>Standards in Medical Record Keeping</article-title><source>Clin Med</source><year>2003</year><volume>3</volume><fpage>329</fpage><lpage>232</lpage><pub-id pub-id-type="pmid">12938746</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huston</surname><given-names>J</given-names></name></person-group><article-title>The need for mandatory clinical recording standards</article-title><source>Clin Med</source><year>2004</year><volume>4</volume><fpage>255</fpage><lpage>257</lpage><pub-id pub-id-type="pmid">15244361</pub-id></citation></ref></ref-list></back></article>