d><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td></td><td align="left">Placebo</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left">Weinblatt et al. (25) Etanercept</td><td align="left">25 mg twice</td><td align="right">59</td><td align="right">2</td><td></td><td></td><td align="right">30</td><td align="right">0</td><td></td><td align="right">23</td><td align="right">0</td><td align="right">0</td></tr><tr><td></td><td align="left">weekly</td><td align="right">30</td><td align="right">1</td><td align="right">NA</td><td align="right">NA</td><td align="right">19</td><td align="right">0</td><td></td><td align="right">2</td><td align="right">0</td><td align="right">0</td></tr><tr><td></td><td align="left">+MTX MTX</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left">Bathon et al. (26) Etanercept</td><td align="left">25 mg twice</td><td align="right">207</td><td align="right">11</td><td></td><td></td><td></td><td></td><td></td><td align="right">_</td><td align="right">3</td><td align="right">1</td></tr><tr><td></td><td align="left">weekly</td><td align="right">208</td><td align="right">12</td><td></td><td></td><td></td><td></td><td></td><td align="right">_</td><td align="right">2</td><td align="right">1</td></tr><tr><td></td><td align="left">10 mg twice</td><td align="right">415</td><td align="right">23</td><td></td><td></td><td></td><td></td><td></td><td align="right">140</td><td align="right">5</td><td align="right">2</td></tr><tr><td></td><td align="left">weekly</td><td align="right">217</td><td align="right">24</td><td align="right">NA</td><td align="right">NA</td><td align="right">NA</td><td align="right">NA</td><td></td><td align="right">16</td><td align="right">2</td><td align="right">0</td></tr><tr><td></td><td align="left">Total</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td