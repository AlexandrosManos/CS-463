0.6</td><td align="left">0</td><td align="left">0</td><td align="left">4.5 &#x000b1; 2.1</td><td align="left">5.1 &#x000b1; 0.6</td><td align="left">2.7 &#x000b1; 0.6</td><td align="left">0</td></tr><tr><td align="left"><bold>Insular cortex</bold></td><td align="left">control</td><td align="left">189.0 &#x000b1; 11.8</td><td align="left">209.2 &#x000b1; 16.8</td><td align="left">94.5 &#x000b1; 0.6</td><td align="left">96.6 &#x000b1; 0.6</td><td align="left">0</td><td align="left">0</td><td align="left">4.8 &#x000b1; 0.3</td><td align="left">2.9 &#x000b1; 0.3</td><td align="left">0.7 &#x000b1; 0.3</td><td align="left">0.5 &#x000b1; 0.5</td></tr><tr><td></td><td align="left">injury</td><td align="left">176.7 &#x000b1; 22.6</td><td align="left">174.3 &#x000b1; 18.2</td><td align="left">98.0 &#x000b1; 0.3</td><td align="left">96.3 &#x000b1; 0.6</td><td align="left">0</td><td align="left">0</td><td align="left">1.5 &#x000b1; 0.3</td><td align="left">2.7 &#x000b1; 0.3</td><td align="left">0.5 &#x000b1; 0.3</td><td align="left">1.0 &#x000b1; 0.6</td></tr><tr><td align="left"><bold>Amygdala</bold></td><td align="left">control</td><td align="left">194.0 &#x000b1; 21.7</td><td align="left">176.7 &#x000b1; 26.3</td><td align="left">94.2 &#x000b1; 1.2</td><td align="left">98.0 &#x000b1; 1.3</td><td align="left">1.1 &#x000b1; 0.6</td><td align="left">0</td><td align="left">2.6 &#x000b1; 0.2</td><td align="left">2.0 &#x000b1; 1.3</td><td align="left">2.1 &#x000b1; 0.6</td><td align="left">0</td></tr><tr><td></td><td align="left">injury</td><td align="left">184.3 &#x000b1; 12.5</td><td align="left">183.3 &#x000b1; 14.2</td><td align="left">93.9 &#x000b1; 1.8</td><td align="left">96.3 &#x000b1; 2.0</td><td align="left">0</td><td align="left">0</td><td align="left">3.3 &#x000b1; 0.9</td><td align="left">3.7 &#x000b1; 2.0</td><td align="left">2.7 &#x000b1; 0.9</td><td align="left">0</td></tr><tr><td align="left"><bold>Hippocampus</bold></td><td align="left">control</td><td align="lef