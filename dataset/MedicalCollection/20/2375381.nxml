></name><name><surname>Wilson</surname><given-names>KR</given-names></name><name><surname>Williams</surname><given-names>CM</given-names></name></person-group><article-title>Addressing women's breast cancer risk and perceptions of control in medical settings</article-title><source>J Clin Psychol in Medical Settings</source><year>1996</year><volume>3</volume><fpage>185</fpage><lpage>199</lpage><!--PubMed citation query: 'J Clin Psychol in Medical Settings||3|185||bib30|'--></citation></ref><ref id="bib31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wagener</surname><given-names>DK</given-names></name><name><surname>Schatzkin</surname><given-names>A</given-names></name></person-group><article-title>Temporal trends in the socioeconomic gradient for breast cancer mortality among US women</article-title><source>Am J Public Health</source><year>1994</year><volume>84</volume><fpage>1003</fpage><lpage>1006</lpage><!--PubMed citation query: 'Am J Public Health||84|1003||bib31|'--><pub-id pub-id-type="pmid">8203664</pub-id></citation></ref><ref id="bib32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Welch</surname><given-names>HG</given-names></name><name><surname>Schwartz</surname><given-names>LM</given-names></name><name><surname>Woloshin</surname><given-names>S</given-names></name></person-group><article-title>Are increasing 5-year survival rates evidence of success against cancer?</article-title><source>JAMA</source><year>2000</year><volume>283</volume><fpage>2975</fpage><lpage>2978</lpage><!--PubMed citation query: 'JAMA||283|2975||bib32|'--><pub-id pub-id-type="pmid">10865276</pub-id></citation></ref></ref-list></back></article>