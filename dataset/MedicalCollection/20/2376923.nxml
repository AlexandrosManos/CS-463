d align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x00023;5</td><td align="char" valign="top" char="." charoff="50">83</td><td align="left" valign="top" charoff="50">pT1b, pN0, pMx</td><td align="left" valign="top" charoff="50">G2&#x02013;G3</td><td align="left" valign="top" charoff="50">7</td><td align="left" valign="top" charoff="50">Microdissection</td><td align="left" valign="top" charoff="50">Neg.</td><td align="left" valign="top" charoff="50">Neg.</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x00023;6</td><td align="char" valign="top" char="." charoff="50">73</td><td align="left" valign="top" charoff="50">pT3a, pN0, pMx</td><td align="left" valign="top" charoff="50">G2&#x02013;G3</td><td align="left" valign="top" charoff="50">8</td><td align="left" valign="top" charoff="50">Microdissection</td><td align="left" valign="top" charoff="50">Neg.</td><td align="left" valign="top" charoff="50">Neg.</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x00023;7</td><td align="char" valign="top" char="." charoff="50">65</td><td align="left" valign="top" charoff="50">pT2b, pN0, pMx</td><td align="left" valign="top" charoff="50">G1&#x02013;G2</td><td align="left" valign="top" charoff="50">5</td><td align="left" valign="top" charoff="50">Microdissection</td><td align="left" valign="top" charoff="50">Neg.</td><td align="left" valign="top" charoff="50">Neg.</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x00023;8</td><td align="char" valign="top" char="." charoff="50">70</td><td align="left" valign="top" charoff="50">pT3a, pN0, pMx</td><td align="left" valign="top" charoff="50">G2</td><td align="left" valign="top" charoff="50">6</td><td align="left" valign="top" charoff="50">Microdissection</td><td align="left" valign="top"