given-names>K</given-names></name><name><surname>Kurisu</surname><given-names>K</given-names></name><name><surname>Tahara</surname><given-names>H</given-names></name><name><surname>Tahara</surname><given-names>E</given-names></name><name><surname>Ide</surname><given-names>T</given-names></name><name><surname>Tahara</surname><given-names>E</given-names></name></person-group><article-title>Telomerase activity in primary and secondary glioblastomas multiforme as a novel molecular tumor marker</article-title><source>J Neurosurg</source><year>2000</year><volume>93</volume><fpage>618</fpage><lpage>625</lpage><!--PubMed citation query: 'J Neurosurg||93|618||bib8|'--><pub-id pub-id-type="pmid">11014540</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harley</surname><given-names>CB</given-names></name><name><surname>Futcher</surname><given-names>AB</given-names></name><name><surname>Greider</surname><given-names>CW</given-names></name></person-group><article-title>Telomeres shorten during ageing of human fibroblasts</article-title><source>Nature</source><year>1990</year><volume>345</volume><fpage>458</fpage><lpage>460</lpage><!--PubMed citation query: 'Nature||345|458||bib9|'--><pub-id pub-id-type="pmid">2342578</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hiraga</surname><given-names>S</given-names></name><name><surname>Ohnishi</surname><given-names>T</given-names></name><name><surname>Izumoto</surname><given-names>S</given-names></name><name><surname>Miyahara</surname><given-names>E</given-names></name><name><surname>Kanemura</surname><given-names>Y</given-names></name><name><surname>Matsumura</surname><given-names>H</given-names></name><name><surname>Arita</surname><given-names>N</given-names></name></person-group><article-title>Telomerase activity and alterations in telomere length in human brain tumors</article-title><source>Cancer Res</source><year>1998</year><volume>58</volume><fpage>2117</fpage><lpage>2125</lpage><!--PubMed citation query: 'Cancer Res||58|2117||bib10|'--><pub-id pub-id-type="pmid">9605755</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hiyama</surname><given-names>E</given-names></name><name><surname>Hiyama</surname><given-names>K</given-names></name><name><surname>Yokoyama</surname><given-names>T</given-names></name><name><surname>Shay</surname><given-names>JW</given-names></name></person-group><article-title>Immunohistochemical detection of telomerase (<italic>hTERT</italic>) protein in human cancer tissues and a subset of cells in normal tissues</article-title><source>Neoplasia</source><year>2001</year><volume>3</volume><fpage>17</fpage><lpage>26</lpage><!--PubMed citation query: 'Neoplasia||3|17||bib11|'--><pub-id pub-id-type="pmid">11326312</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>F</given-names></name><name><surname>Kanno</surname><given-names>H</given-names></name><name><surname>Yamamoto</surname><given-names>I</given-names></name><name><surname>Lin</surname><given-names>Y</given-names></name><name><surname>Kubota</surname><given-names>Y</given-names></name></person-group><article-title>Correlation of clinical features and telomerase activity in human gliomas</article-title><source>J Neuro-oncol</source><year>1999</year><volume>43</volume><fpage>137</fpage><lpage>142</lpage><!--PubMed citation query: 'J Neuro-oncol||43|137||bib12|'--></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaplan</surname><given-names>E</given-names></name><name><surname>Meier</surname><given-names>P</given-names></name></person-group><article-title>Nonparametric estimation from incomplete observations</article-title><source>J Am Stat Assoc</source><year>1958</year><volume>53</volume><fpage>457</fpage><lpage>481</lpage><!--PubMed citation query: 'J Am Stat Assoc||53|457||bib13|'--></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kleinschmidt-Demasters</surname><given-names>BK</given-names></name><name><surname>Evans</surname><given-names>LC</given-names></name><name><surname>Bobak</surname><given-names>JB</given-names></name><name><surname>Lopez-Uribe</surname><given-names>D</given-names></name><name><surname>Hopper</surname><given-names>D</given-names></name><name><surname>Shroyer</surname><given-names>AL</given-names></name><name><surname>Shroyer</surname><given-names>KR</given-names></name></person-group><article-title>Quantitative telomerase expression in glioblastomas shows regional variation and down-regulation with therapy but no correlation with patient outcome</article-title><source>Hum Pathol</source><year>2000</year><volume>31</volume><fpage>905</fpage><lpage>913</lpage><!--PubMed citation query: 'Hum Pathol||31|905||bib14|'--><pub-id pub-id-type="pmid">10987250</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Komata</surname><given-names>T</given-names></name><name><surname>Kanzawa</surname><given-names>T</given-names></name><name><surname>Kondo</surname><given-names>Y</given-names></name><name><surname>Kondo</surname><given-names>S</given-names></name></person-group><article-title>Telomerase as a therapeutic target for malignant gliomas</article-title><source>Oncogene</source><year>2002</year><volume>21</volume><fpage>656</fpage><lpage>663</lpage><!--PubMed citation query: 'Oncogene||21|656||bib15|'--><pub-id pub-id-type="pmid">11850793</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Langford</surname><given