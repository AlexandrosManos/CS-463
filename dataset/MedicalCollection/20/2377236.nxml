left"><bold>7</bold></td><td align="left"><bold>3</bold></td><td align="left"><bold>0</bold></td><td align="left"><bold>1</bold></td><td align="left"><bold>1</bold></td><td align="left"><bold>5</bold></td><td align="left"><bold>8</bold></td><td align="left"><bold>8</bold></td><td align="left"><bold>8</bold></td><td></td></tr><tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td align="left"><bold>8</bold></td><td align="left"><bold>1</bold></td><td align="left"><bold>3</bold></td><td align="left"><bold>7</bold></td><td align="left"><bold>8</bold></td><td align="left"><bold>2</bold></td><td align="left"><bold>6</bold></td><td align="left"><bold>3</bold></td><td align="left"><bold>4</bold></td><td align="left"><bold>9</bold></td><td align="left"><bold>2</bold></td><td align="left"><bold>4</bold></td><td align="left"><bold>7</bold></td><td align="left"><bold>Variants<sup>1</sup></bold></td></tr><tr><td></td><td align="left"><bold>rCRS</bold></td><td align="left"><bold>A</bold></td><td align="left"><bold>G</bold></td><td align="left"><bold>G</bold></td><td align="left"><bold>G</bold></td><td align="left"><bold>T</bold></td><td align="left"><bold>A</bold></td><td align="left"><bold>T</bold></td><td align="left"><bold>T</bold></td><td align="left"><bold>T</bold></td><td align="left"><bold>T</bold></td><td align="left"><bold>T</bold></td><td align="left"><bold>C</bold></td><td align="left"><bold>G</bold></td><td align="left"><bold>G</bold></td><td align="left"><bold>T</bold></td><td align="left"><bold>G</bold></td><td align="left"><bold>A</bold></td><td align="left"><bold>G</bold></td><td align="left"><bold>T</bold></td><td align="left"><bold>T</bold></td><td align="left"><bold>T</bold></td><td></td></tr></thead><tbody><tr><td align="left">#1</td><td align="left">I-111</td><td align="left">-</td><td align="left">-</td><td align="left">-</td><td align="left">-</td><td align="left">-</td><td align="left">-</td><td align="left">-</t