er" rowspan="1" colspan="1">319 (46)</td><td align="center" rowspan="1" colspan="1">358 (49)</td><td align="center" rowspan="1" colspan="1">361 (49)</td></tr><tr><td align="left" rowspan="1" colspan="1">Years of education</td><td align="center" rowspan="1" colspan="1">832 (11.7 &#x000b1; 3.8)</td><td align="center" rowspan="1" colspan="1">685 (11.4 &#x000b1; 4.2)</td><td align="center" rowspan="1" colspan="1">721 (11.2 &#x000b1; 3.7)</td><td align="center" rowspan="1" colspan="1">724 (10.1 &#x000b1; 4.7)</td></tr><tr><td colspan="4" align="left" rowspan="1">Annual family income &#x0003e; $50,000</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;No</td><td align="center" rowspan="1" colspan="1">561 (75)</td><td align="center" rowspan="1" colspan="1">503 (80)</td><td align="center" rowspan="1" colspan="1">554 (85)</td><td align="center" rowspan="1" colspan="1">557 (88)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Yes</td><td align="center" rowspan="1" colspan="1">187 (25)</td><td align="center" rowspan="1" colspan="1">129 (20)</td><td align="center" rowspan="1" colspan="1">101 (15)</td><td align="center" rowspan="1" colspan="1">77 (12)</td></tr><tr><td align="left" rowspan="1" colspan="1">Poverty&#x02013;income ratio</td><td align="center" rowspan="1" colspan="1">748 (2.87 &#x000b1; 1.76)</td><td align="center" rowspan="1" colspan="1">632 (2.82 &#x000b1; 1.76)</td><td align="center" rowspan="1" colspan="1">655 (2.35 &#x000b1; 1.52)</td><td align="center" rowspan="1" colspan="1">634 (2.42 &#x000b1; 1.55)</td></tr><tr><td colspan="4" align="left" rowspan="1">Urbanization</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Urban</td><td align="center" rowspan="1" colspan="1">444 (53)</td><td align="center" rowspan="1" colspan="1">486 (71)</td><td align="center" rowspan="1" colspan="1">560 (77)</td><td align="center" rowspan="1" colspan="1">564 (77)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Rural</td><td align