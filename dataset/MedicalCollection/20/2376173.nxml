-type="pmid">11773702</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ito</surname><given-names>T</given-names></name><name><surname>Shiraki</surname><given-names>K</given-names></name><name><surname>Sugimoto</surname><given-names>K</given-names></name><name><surname>Yamanaka</surname><given-names>T</given-names></name><name><surname>Fujikawa</surname><given-names>K</given-names></name><name><surname>Ito</surname><given-names>M</given-names></name><name><surname>Takase</surname><given-names>K</given-names></name><name><surname>Moriyama</surname><given-names>M</given-names></name><name><surname>Kawano</surname><given-names>H</given-names></name><name><surname>Hayashida</surname><given-names>M</given-names></name><name><surname>Nakano</surname><given-names>T</given-names></name><name><surname>Suzuki</surname><given-names>A</given-names></name></person-group><article-title>Survivin promotes cell proliferation in human hepatocellular carcinoma</article-title><source>Hepatology</source><year>2000</year><volume>31</volume><fpage>1080</fpage><lpage>1085</lpage><!--PubMed citation query: 'Hepatology||31|1080||bib9|'--><pub-id pub-id-type="pmid">10796883</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kato</surname><given-names>J</given-names></name><name><surname>Kuwabara</surname><given-names>Y</given-names></name><name><surname>Mitani</surname><given-names>M</given-names></name><name><surname>Shinoda</surname><given-names>N</given-names></name><name><surname>Sato</surname><given-names>A</given-names></name><name><surname>Toyama</surname><given-names>T</given-names></name><name><surname>Mitsui</surname><given-names>A</given-names></name><name><surname>Nishiwaki</surname><given-names>T</given-names></name><name><surname>Moriyama</surname><given-names>S</given-names></name><name><surname>Kudo</surname><given-name