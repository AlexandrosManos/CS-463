>NP_060480</td></tr><tr><td align="left">8971</td><td align="center">-</td><td align="left"><italic>fh</italic></td><td align="left">frataxin like</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td align="left">NP_000135.2</td></tr><tr><td align="left">9035</td><td align="center">-</td><td align="left"><italic>Tapdelta</italic></td><td></td><td align="left">Signal sequence binding</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td align="left">NP_006271.1</td></tr><tr><td align="left">9227</td><td align="center"><italic>iv</italic></td><td align="left"><italic>tectonic</italic></td><td align="left">Tectonic</td><td></td><td></td><td></td><td align="center">&#x003bd;</td><td align="center">&#x003bd;</td><td></td><td></td><td align="center">&#x003bd;</td><td align="center">&#x003bd;</td><td></td><td></td><td></td><td align="center">&#x003bd;</td><td align="center">&#x003bd;</td><td align="center">&#x003bd;</td><td align="left">NP_085055</td></tr><tr><td align="left">9298</td><td align="center">-</td><td align="left"><italic>CG9298</italic></td><td></td><td align="left">Synbindin</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td align="left">NP_057230.1</td></tr><tr><td align="left">9363</td><td align="center">-</td><td align="left"><italic>CG9363</italic></td><td></td><td align="left">Glutathione transferase zeta</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td align="left">NP_665877.1</td></tr><tr><td align="left">9467</td><td align="center">-</td><td align="left"><italic>CG9467</italic></td><td></td><td align="left">V-gated K channel complex</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td