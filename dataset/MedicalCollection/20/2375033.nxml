left">6121</td><td align="center">Neg</td><td align="left"><italic>Tip60</italic></td><td></td><td align="left">Histone acetyltransferase</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td align="center">&#x003bd;</td><td></td><td align="left">NP_874369.1</td></tr><tr><td align="left">6129</td><td align="center">6/<italic>iv</italic></td><td align="left"><italic>CG6129</italic></td><td align="left">rootletin</td><td></td><td></td><td></td><td></td><td></td><td align="center">&#x003bd;</td><td></td><td></td><td></td><td></td><td align="center">&#x003bd;</td><td></td><td align="center">&#x003bd;</td><td></td><td align="center">&#x003bd;</td><td align="left">NP_055490</td></tr><tr><td align="left">6405</td><td align="center">-</td><td align="left"><italic>CG6405</italic></td><td align="left">-</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td align="left">XP_936274.2</td></tr><tr><td align="left">6665</td><td align="center">-</td><td align="left"><italic>CG6665</italic></td><td align="left">-</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td align="left">NP_056264.1</td></tr><tr><td align="left">6696</td><td align="center">-</td><td align="left"><italic>CG6696</italic></td><td></td><td align="left">Meprin A/proteolysis</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td align="center">&#x003bd;</td><td align="left">NP_005916</td></tr><tr><td align="left">7104</td><td align="center">-</td><td align="left"><italic>Spz3</italic></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td align="left">-</td></tr><tr><td align="left">7669</td><td align="center">-</t