">0.876</td><td align="center">0.859</td><td align="center">0.856</td><td align="center">0.875</td><td align="center">0.976</td><td align="center">0.978</td><td align="center">0.976</td><td align="center">0.976</td></tr><tr><td align="center">12<sup><italic>T</italic></sup></td><td align="center">0.717</td><td align="center">0.708</td><td align="center">0.715</td><td align="center">0.716</td><td align="center">0.990</td><td align="center">0.990</td><td align="center">0.990</td><td align="center">0.989</td></tr><tr><td align="center">12<sup><italic>E</italic></sup></td><td align="center">0.822</td><td align="center">0.819</td><td align="center">0.822</td><td align="center">0.831</td><td align="center">0.967</td><td align="center">0.970</td><td align="center">0.968</td><td align="center">0.967</td></tr><tr><td align="center">13<sup><italic>T</italic></sup></td><td align="center">0.628</td><td align="center">0.619</td><td align="center">0.624</td><td align="center">0.627</td><td align="center">0.978</td><td align="center">0.979</td><td align="center">0.979</td><td align="center">0.977</td></tr><tr><td align="center">13<sup><italic>E</italic></sup></td><td align="center">0.779</td><td align="center">0.756</td><td align="center">0.761</td><td align="center">0.790</td><td align="center">0.954</td><td align="center">0.954</td><td align="center">0.953</td><td align="center">0.953</td></tr><tr><td align="center">14<sup><italic>T</italic></sup></td><td align="center">0.555</td><td align="center">0.542</td><td align="center">0.549</td><td align="center">0.554</td><td align="center">0.967</td><td align="center">0.969</td><td align="center">0.969</td><td align="center">0.965</td></tr><tr><td align="center">14<sup><italic>E</italic></sup></td><td align="center">0.735</td><td align="center">0.706</td><td align="center">0.731</td><td align="center">0.763</td><td align="center">0.943</td><td align="center">0.942</td><td align="center">0.943</td><td align="center">0.943</td></tr><tr><td align="center">15<sup><italic>T</italic></sup></td><td align="center">0.483</td><td align="center">0.472</td><td align="center">0.480</td><td align="center">0.481</td><td align="center">0.952</td><td align="center">0.955</td><td align="center">0.954</td><td align="center">0.949</td></tr><tr><td align="center">15<sup><italic>E</italic></sup></td><td align="center">0.706</td><td align="center">0.676</td><td align="center">0.686</td><td align="center">0.733</td><td align="center">0.927</td><td align="center">0.927</td><td align="center">0.926</td><td align="center">0.930</td></tr><tr><td align="center">16<sup><italic>T</italic></sup></td><td align="center">0.412</td><td align="center">0.400</td><td align="center">0.407</td><td align="center">0.410</td><td align="center">0.931</td><td align="center">0.935</td><td align="center">0.935</td><td align="center">0.927</td></tr><tr><td align="center">16<sup><italic>E</italic></sup></td><td align="center">0.667</td><td align="center">0.610</td><td align="center">0.627</td><td align="center">0.679</td><td align="center">0.912</td><td align="center">0.909</td><td align="center">0.910</td><td align="center">0.910</td></tr><tr><td colspan="9"><hr></hr></td></tr><tr><td align="center"><bold>W</bold></td><td align="center"><bold>M</bold><sub>                              <italic>co</italic>                           </sub></td><td align="center"><bold>M</bold><sub>                              <italic>do</italic>                           </sub></td><td align="center"><bold>M</bold><sub>                              <italic>mo</italic>                           </sub></td><td align="center"><bold>M</bold><sub>                              <italic>zo</italic>                           </sub></td><td align="center"><bold>Z</bold><sub>                              <italic>co</italic>                           </sub></td><td align="center"><bold>Z</bold><sub>                              <italic>do</italic>                           