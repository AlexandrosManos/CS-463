ancer Res Clin Oncol||123|469||bib15|'--><pub-id pub-id-type="pmid">9341895</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kennedy</surname><given-names>SD</given-names></name><name><surname>Szczepaniak</surname><given-names>LS</given-names></name><name><surname>Gibson</surname><given-names>SL</given-names></name><name><surname>Hilf</surname><given-names>R</given-names></name><name><surname>Foster</surname><given-names>TH</given-names></name><name><surname>Bryant</surname><given-names>RG</given-names></name></person-group><article-title>Quantitative MRI of Gd-DTPA uptake in tumours: response to photodynamic therapy</article-title><source>Magn Reson Med</source><year>1994</year><volume>31</volume><fpage>292</fpage><lpage>301</lpage><!--PubMed citation query: 'Magn Reson Med||31|292||bib16|'--><pub-id pub-id-type="pmid">8057800</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kimura</surname><given-names>M</given-names></name><name><surname>Amemiya</surname><given-names>K</given-names></name><name><surname>Yamada</surname><given-names>T</given-names></name><name><surname>Suzuki</surname><given-names>J</given-names></name></person-group><article-title>Quantitative method for measuring adjuvant-induced granuloma angiogenesis in insulin-treated diabetic mice</article-title><source>J Pharmacobio-Dyn</source><year>1986</year><volume>9</volume><fpage>442</fpage><lpage>446</lpage><!--PubMed citation query: 'J Pharmacobio-Dyn||9|442||bib17|'--><pub-id pub-id-type="pmid">2428967</pub-id></citation></ref><ref id="bib18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kondo</surname><given-names>S</given-names></name><name><surname>Asano</surname><given-names>M</given-names></name><name><surname>Matsuo</surname><given-names>K</given-names></name><name><surname>Ohmori</surnam