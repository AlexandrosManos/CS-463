icle-title>Restriction endonucleases in the analysis and restructuring of DNA molecules</article-title><source>Annu. Rev. Biochem</source><year>1975</year><volume>44</volume><fpage>273</fpage><lpage>293</lpage><pub-id pub-id-type="pmid">166604</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pop</surname><given-names>M</given-names></name></person-group><article-title>Shotgun sequence assembly</article-title><source>Adv. Comp. Vol. 60</source><year>2004</year><volume>60</volume><fpage>193</fpage><lpage>248</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pop</surname><given-names>M</given-names></name><etal/></person-group><article-title>Hierarchical scaffolding with bambus</article-title><source>Genome Res</source><year>2004</year><volume>14</volume><fpage>149</fpage><lpage>159</lpage><pub-id pub-id-type="pmid">14707177</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reslewic</surname><given-names>S</given-names></name><etal/></person-group><article-title>Whole-genome shotgun optical mapping of rhodospirillum rubrum</article-title><source>Appl. Environ. Microbiol</source><year>2005</year><volume>71</volume><fpage>5511</fpage><lpage>5522</lpage><pub-id pub-id-type="pmid">16151144</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Samad</surname><given-names>A</given-names></name><etal/></person-group><article-title>Optical mapping: a novel, single-molecule approach to genomic analysis</article-title><source>Genome Res</source><year>1995</year><volume>5</volume><fpage>1</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">8717049</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>S