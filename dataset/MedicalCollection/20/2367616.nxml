-title>The optimal measure of linkage disequilibrium reduces error in association mapping of affection status</article-title><source>Hum Mol Genet</source><year>2005</year><volume>14</volume><fpage>145</fpage><lpage>153</lpage><pub-id pub-id-type="pmid">15548543</pub-id><pub-id pub-id-type="doi">10.1093/hmg/ddi019</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morton</surname><given-names>NE</given-names></name><name><surname>Zhang</surname><given-names>W</given-names></name><name><surname>Taillon-Miller</surname><given-names>P</given-names></name><name><surname>Ennis</surname><given-names>S</given-names></name><name><surname>Kwok</surname><given-names>PY</given-names></name><name><surname>Collins</surname><given-names>A</given-names></name></person-group><article-title>The optimal measure of allelic association</article-title><source>Proc Natl Acad Sci USA</source><year>2001</year><volume>98</volume><fpage>5217</fpage><lpage>5221</lpage><pub-id pub-id-type="pmid">11309498</pub-id><pub-id pub-id-type="doi">10.1073/pnas.091062198</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lau</surname><given-names>W</given-names></name><name><surname>Kuo</surname><given-names>TY</given-names></name><name><surname>Tapper</surname><given-names>W</given-names></name><name><surname>Cox</surname><given-names>S</given-names></name><name><surname>Collins</surname><given-names>A</given-names></name></person-group><article-title>Exploiting large scale computing to construct high resolution linkage disequilibrium maps of the human genome</article-title><source>Bioinformatics</source><year>2007</year><volume>23</volume><fpage>517</fpage><lpage>519</lpage><pub-id pub-id-type="pmid">17142813</pub-id><pub-id pub-id-type="doi">10.1093/bioinformatics/btl615</pub-id></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>King</surname><given-names>RA</given-names></name><name><surname>Rotter</surname><given-names>JI</given-names></name><name><surname>Motulsky</surname><given-names>AG</given-names></name></person-group><source>The Genetic Basis of Common Disease</source><year>1992</year><publisher-name>New York: Oxford University Press</publisher-name><fpage>598</fpage><lpage>599</lpage></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Choi</surname><given-names>SJ</given-names></name><name><surname>Rho</surname><given-names>YH</given-names></name><name><surname>Ji</surname><given-names>JD</given-names></name><name><surname>Song</surname><given-names>GG</given-names></name><name><surname>Lie</surname><given-names>YH</given-names></name></person-group><article-title>Genome scan meta-analysis of rheumatoid arthritis</article-title><source>Rheumatology</source><year>2006</year><volume>45</volume><fpage>166</fpage><lpage>170</lpage><pub-id pub-id-type="pmid">16278286</pub-id><pub-id pub-id-type="doi">10.1093/rheumatology/kei128</pub-id></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Blanco</surname><given-names>E</given-names></name><name><surname>Parra</surname><given-names>G</given-names></name><name><surname>Guig&#x000f3;</surname><given-names>R</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Baxevanis AD, Davison DB</surname></name></person-group><article-title>Using geneid to identify genes</article-title><source>Current Protocols in Bioinformatics</source><year>2002</year><publisher-name>New York: John Wiley &#x00026; Sons Inc</publisher-name><fpage>1</fpage><lpage>26</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burge</surname><given-names>C</given-names></name><name><surname>Karlin</surname><given-names>S</given-names></name></person-group><article-title>Prediction of complete gene structures in human genomic DNA</article-title><source>J Mol Biol</source><year>1997</year><volume>268</volume><fpage>78</fpage><lpage>94</lpage><pub-id pub-id-type="pmid">9149143</pub-id><pub-id pub-id-type="doi">10.1006/jmbi.1997.0951</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zintzaras</surname><given-names>E</given-names></name><name><surname>Kitsios</surname><given-names>G</given-names></name></person-group><article-title>Identification of chromosomal regions linked to premature myocardial infarction: a meta-analysis of whole-genome searches</article-title><source>J Hum Genet</source><year>2006</year><volume>51</volume><fpage>1015</fpage><lpage>1021</lpage><pub-id pub-id-type="pmid">17024316</pub-id><pub-id pub-id-type="doi">10.1007/s10038-006-0053-x</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lewis</surname><given-names>CM</given-names></name><name><surname>Levinson</surname><given-names>DF</given-names></name></person-group><article-title>Testing for genetic heterogeneity in the genome search meta-analysis method</article-title><source>Genet Epidemiol</source><year>2006</year><volume>30</volume><fpage>348</fpage><lpage>355</lpage><pub-id pub-id-type="pmid">16586403</pub-id><pub-id pub-id-type="doi">10.1002/gepi.20149</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Segurado</surname><given-names>R</given-names></name><name><surname>Hamshere</surname><given-names>ML</given-names></name><name><surname>Glaser</surname><given-names>B</given-names></name><name><surname>Nikolov</surname><given-names>I</given-names></name><name><surname>Moskvina</surname><given-names>V</given-names></name><name><surname>Holmans</surname><given-names>P</given-names></name></person-group><article-title>Combining linkage datasets for meta-analysis and mega-analysis: the GAW15 rheumatoid arthritis data set</article-title><source>BMC Genet</source><year>2007</year><volume>xx</volume><fpage>xxx</fpage></citation></ref></ref-list></back></article>