><lpage>894</lpage><pub-id pub-id-type="pmid">11527798</pub-id><pub-id pub-id-type="doi">10.1128/CDLI.8.5.891-894.2001</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cui</surname><given-names>L</given-names></name><name><surname>Escalante</surname><given-names>AE</given-names></name><name><surname>Imwong</surname><given-names>M</given-names></name><name><surname>Snounou</surname><given-names>G</given-names></name></person-group><article-title>The genetic diversity of <italic>Plasmodium vivax </italic>populations</article-title><source>Trends Parasitol</source><year>2003</year><volume>19</volume><fpage>220</fpage><lpage>226</lpage><pub-id pub-id-type="pmid">12763428</pub-id><pub-id pub-id-type="doi">10.1016/S1471-4922(03)00085-0</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mangoni</surname><given-names>ED</given-names></name><name><surname>Severini</surname><given-names>C</given-names></name><name><surname>Menegon</surname><given-names>M</given-names></name><name><surname>Romi</surname><given-names>R</given-names></name><name><surname>Ruggiero</surname><given-names>G</given-names></name><name><surname>Majori</surname><given-names>G</given-names></name></person-group><article-title>Case report: an unusual late relapse of <italic>Plasmodium vivax </italic>malaria</article-title><source>Am J Trop Med Hyg</source><year>2003</year><volume>68</volume><fpage>159</fpage><lpage>160</lpage><pub-id pub-id-type="pmid">12641405</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cogswell</surname><given-names>FB</given-names></name></person-group><article-title>The hypnozoite and relapse in primate malaria</article-title><source>Clin Microbiol Rev</source><year>1992</year><volume>5</volume><fpage>26</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">1735093</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Paul</surname><given-names>REL</given-names></name><name><surname>Diallo</surname><given-names>M</given-names></name><name><surname>Brey</surname><given-names>PT</given-names></name></person-group><article-title>Mosquitoes and transmission of malaria parasites &#x02013; not just vectors</article-title><source>Malar J</source><year>2004</year><volume>3</volume><fpage>39</fpage><pub-id pub-id-type="pmid">15533243</pub-id><pub-id pub-id-type="doi">10.1186/1475-2875-3-39</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huld&#x000e9;n</surname><given-names>Le</given-names></name><name><surname>Huld&#x000e9;n</surname><given-names>La</given-names></name><name><surname>Heli&#x000f6;vaara</surname><given-names>K</given-names></name></person-group><article-title>Endemic malaria: an 'indoor' disease in northern Europe. Historical data analysed</article-title><source>Malar J</source><year>2005</year><volume>4</volume><fpage>19</fpage><pub-id pub-id-type="pmid">15847704</pub-id><pub-id pub-id-type="doi">10.1186/1475-2875-4-19</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moberg</surname><given-names>A</given-names></name><name><surname>Bergstr&#x000f6;m</surname><given-names>H</given-names></name></person-group><article-title>Homogenization of Swedish Temperature Data. Part III: The Long Temperature Records from Uppsala and Stockholm</article-title><source>Int J Clim</source><year>1997</year><volume>17</volume><fpage>667</fpage><lpage>700</lpage><pub-id pub-id-type="doi">10.1002/(SICI)1097-0088(19970615)17:7&#x0003c;667::AID-JOC115&#x0003e;3.0.CO;2-J</pub-id></citation></ref><ref id="B15"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Natvig</surname><given-names>LR</given-names></name></person-group><article-title>Contributions to the knowledge of the Danish and Fennoscandian mosquitoes Culicini</article-title><source>Norsk Entomol Tidskr</source><year>1948</year><fpage>1</fpage><lpage>567</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Utrio</surname><given-names>P</given-names></name></person-group><article-title>Distribution of mosquitoes (Diptera, Culicidae) attracted by man in Finland in early July</article-title><source>Notulae Entomol</source><year>1978</year><volume>58</volume><fpage>107</fpage><lpage>114</lpage></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Champagne</surname><given-names>DE</given-names></name></person-group><article-title>Antihemostatic molecules from saliva of blood-feeding arthropods</article-title><source>Pathophysiol Haemost Thromb</source><year>2005</year><volume>34</volume><fpage>221</fpage><lpage>227</lpage><pub-id pub-id-type="pmid">16707932</pub-id><pub-id pub-id-type="doi">10.1159/000092428</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Takken</surname><given-names>W</given-names></name><name><surname>Geene</surname><given-names>R</given-names></name><name><surname>Adam</surname><given-names>W</given-names></name><name><surname>Jetten</surname><given-names>TH</given-names></name><name><surname>Velden</surname><given-names>JA van der</given-names></name></person-group><article-title>Distribution and dynamics of larval populations of <italic>Anopheles messeae </italic>and <italic>A. atroparvus </italic>in the delta of the rivers Rhine and Meuse, the Netherlands</article-title><source>Ambio</source><year>2001</year><volume>31</volume><fpage>212</fpage><lpage>218</lpage><pub-id pub-id-type="pmid">12164130</pub-id><pub-id pub-id-type="doi">10.1639/0044-7447(2002)031[0212:DADOLP]2.0.CO;2</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jaenson</surname><given-names>TGT</given-names></name><name><surname>Ameneshewa</surname><given-names>B</given-names></name></person-group><article-title>Prehibernation diet and reproductive condition of female Anopheles messeae in Sweden</article-title><source>Med Vet Entomol</source><year>1991</year><volume>5</volume><fpage>243</fpage><lpage>252</lpage><pub-id pub-id-type="pmid">1768915</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2915.1991.tb00547.x</pub-id></citation></ref><ref id="B20"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Sokolova</surname><given-names>MI</given-names></name><name><surname>Snow</surname><given-names>KR</given-names></name></person-group><article-title>Malaria vectors in European Russia</article-title><source>European Mosquito Bulletin 2002 (12 May)</source><ext-link ext-link-type="uri" xlink:href="http://www.uel.ac.uk/mosquito/emb.htm"/></citation></ref><ref id="B21"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Hackett</surname><given-names>L</given-names></name></person-group><article-title>Maculipennis races: Their morphological and biological characters</article-title><source>League of Nations, Health Organisation, Malaria Commission Geneva, March 28th, 1933, CH/Malaria/203</source><ext-link ext-link-type="uri" xlink:href="http://www.who.int/library/collections/historical/en/index4.html"/></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nikolaeva</surname><given-names>N</given-names></name></person-group><article-title>Resurgence of malaria in the former Soviet Union (FSU)</article-title><source>Soc Vector Ecol Newsl</source><year>1996</year><volume>27</volume><fpage>10</fpage><lpage>11</lpage></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Copeland</surname><given-names>RS</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Saini RK</surname></name></person-group><article-title>Mosquitoes: Parasite-Vector Interactions, Host-Vector Interactions and Population Management</article-title><source>Proceedings of the 3rd International Conference on Tropical Entomology 30th October &#x02013; 4th November 1994</source><year>1994</year><publisher-name>Nairobi, Kenya</publisher-name><fpage>105</fpage><lpage>126</lpage></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Paul</surname><given-names>REL</given-names></name><name><surname>Ariey</surname><given-names>F</given-names></name><name><surname>Robert</surname><given-names>V</given-names></name></person-group><article-title>The evolutionary ecology of <italic>Plasmodium</italic></article-title><source>Ecol Lett</source><year>2003</year><volume>6</volume><fpage>866</fpage><lpage>880</lpage><pub-id pub-id-type="doi">10.1046/j.1461-0248.2003.00509.x</pub-id></citation></ref><ref id="B25"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Warrell</surname><given-names>DA</given-names></name><name><surname>Cox</surname><given-names>TM</given-names></name><name><surname>Firth</surname><given-names>JD</given-names></name><name><surname>Benz</surname><given-names>EJ</given-names></name><collab>eds</collab></person-group><source>Oxford Textbook of Medicine</source><year>2003</year><edition>4</edition><publisher-name>Oxford Univ Press, Oxford</publisher-name></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nakazawa</surname><given-names>S</given-names></name><name><surname>Kanbara</surname><given-names>H</given-names></name><name><surname>Aikawa</surname><given-names>M</given-names></name></person-group><article-title>Recrudescence of <italic>Plasmodium falciparum </italic>in culture: unaffectedness and frequency of dormant parasites</article-title><source>Tokai J Exp Clin Med</source><year>1998</year><volume>23</volume><fpage>99</fpage><lpage>100</lpage></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pettersson</surname><given-names>F</given-names></name><name><surname>Vogt</surname><given-names>AM</given-names></name><name><surname>Jonsson</surname><given-names>C</given-names></name><name><surname>Mok</surname><given-names>BW</given-names></name><name><surname>Shamei Tousi</surname><given-names>A</given-names></name><name><surname>Bergstr&#x000f6;m</surname><given-names>S</given-names></name><name><surname>Chen</surname><given-names>Q</given-names></name><name><surname>Wahlgren</surname><given-names>M</given-names></name></person-group><article-title>Whole-body imaging of sequestration of <italic>Plasmodium falciparum </italic>in the rat</article-title><source>Infect Immun</source><year>2005</year><volume>73</volume><fpage>7736</fpage><lpage>7746</lpage><pub-id pub-id-type="pmid">16239578</pub-id><pub-id pub-id-type="doi">10.1128/IAI.73.11.7736-7746.2005</pub-id></citation></ref></ref-list></back></article>