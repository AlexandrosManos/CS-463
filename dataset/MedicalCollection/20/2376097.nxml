/publisher-loc><publisher-name>John Wiley &#x00026; Sons</publisher-name></citation></ref><ref id="B6"><label>8</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Knuth</surname><given-names>DE</given-names></name></person-group><source><italic>The Art of Computer Programming: Seminumerical Algorithms</italic></source><year>1997</year><volume>2</volume><edition>3rd edition</edition><publisher-loc>Reading, Mass, USA</publisher-loc><publisher-name>Addison-Wesley</publisher-name></citation></ref><ref id="B12"><label>9</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Papoulis</surname><given-names>A</given-names></name></person-group><source><italic>Probability and Statistics</italic></source><year>1996</year><publisher-loc>Englewood Cliffs, NJ, USA</publisher-loc><publisher-name>Prentice-Hall</publisher-name></citation></ref><ref id="B3"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fiori</surname><given-names>S</given-names></name></person-group><article-title>Neural systems with numerically-matched input-output statistic: variate generation</article-title><source><italic>Neural Processing Letters</italic></source><year>2006</year><volume>23</volume><issue>2</issue><fpage>143</fpage><lpage>170</lpage></citation></ref><ref id="B4"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fiori</surname><given-names>S</given-names></name></person-group><article-title>Neural systems with numerically matched input-output statistic: isotonic bivariate statistical modeling</article-title><source><italic>Computational Intelligence and Neuroscience</italic></source><year>2007</year><volume>2007</volume><fpage>23 pages</fpage><comment>Article ID 71859.</comment></citation></ref><ref id="B5"><label>12</label><citation citation-type="confproc"><person-group person-group-type="author"><name><surname>Ghosh</surname><given-names>S</given-names></name><name><surname>Henderson</surname><given-names>SG</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Y&#x000fc;cesan</surname><given-names>E</given-names></name><name><surname>Chen</surname><given-names>C-H</given-names></name><name><surname>Snowdon</surname><given-names>JL</given-names></name><name><surname>Charnes</surname><given-names>JM</given-names></name></person-group><article-title>Properties of the NORTA method in higher dimensions</article-title><conf-name>In: Proceedings of the Winter Simulation Conference (WSC '02), vol. 1</conf-name><conf-date>December 2002</conf-date><conf-loc>San Diego, Calif, USA</conf-loc><fpage>263</fpage><lpage>269</lpage></citation></ref><ref id="B14"><label>13</label><citation citation-type="other"><person-group person-group-type="author"><name><surname>Tsai</surname><given-names>AC</given-names></name></person-group><year>2006</year><month>1</month><comment>Personal communication</comment></citation></ref><ref id="B7"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kokkinakis</surname><given-names>K</given-names></name><name><surname>Nandi</surname><given-names>AK</given-names></name></person-group><article-title>Exponent parameter estimation for generalized Gaussian probability density functions with application to speech modeling</article-title><source><italic>Signal Processing</italic></source><year>2005</year><volume>85</volume><issue>9</issue><fpage>1852</fpage><lpage>1858</lpage></citation></ref></ref-list></back><floats-wrap><fig id="fig1" position="float"><label>Figure 1</label><caption><p>Neural system, neural dual system, input/output sample spaces andtheir statistical distributions.</p></caption><graphic xlink:href="CIN2008-426080.001"/></fig><fig id="fig2" position="float"><label>Figure 2</label><caption><p>Behavior of the &#x0201c;cumsum&#x0201d; operator for look-up tables.</p></caption><graphic xlink:href="CIN2008-426080.002"/></fig><fig id="fig3" position="float"><label>Figure 3</label><caption><p>Result of dual neural system adaptation with Gaussian input andbi-Gaussian output.</p></caption><graphic xlink:href="CIN2008-426080.003"/></fig><fig id="fig4" position="float"><label>Figure 4</label><caption><p>Result of dual neural 							system adaptation with Gaussian input and 							generalized Gaussian output.</p></caption><graphic xlink:href="CIN2008-426080.004"/></fig><fig id="fig5" position="float"><label>Figure 5</label><caption><p>Result of dual neural 							system adaptation with Gaussian input and 							Gamma output.</p></caption><graphic xlink:href="CIN2008-426080.005"/></fig><table-wrap id="tab1" position="float"><label>Table 1</label><caption><p>Average results about the experiment on bi-Gaussian 		random number generation; averages computed over 100 		independent trials when the algorithm(<xref ref-type="disp-formula" rid="Eq7">7</xref>) was iterated 10 times (first batch of results).</p></caption><table frame="hsides" rules="groups"><thead><tr><th rowspan="1" colspan="1">POINTS <italic>N</italic></th><th align="center" rowspan="1" colspan="1">200</th><th align="center" rowspan="1" colspan="1">400</th><th align="center" rowspan="1" colspan="1">600</th><th align="center" rowspan="1" colspan="1">800</th><th align="center" rowspan="1" colspan="1">1000</th></tr></thead><tbody><tr><td rowspan="1" colspan="1">AVG. LEARN. TIME</td><td align="center" rowspan="1" colspan="1">0.0092</td><td align="center" rowspan="1" colspan="1">0.0090</td><td align="center" rowspan="1" colspan="1">0.0109</td><td align="center" rowspan="1" colspan="1">0.0117</td><td align="center" rowspan="1" colspan="1">0.0133</td></tr><tr><td rowspan="1" colspan="1">AVG. GEN. TIME</td><td align="center" rowspan="1" colspan="1">0.0517</td><td align="center" rowspan="1" colspan="1">0.0514</td><td align="center" rowspan="1" colspan="1">0.0509</td><td align="center" rowspan="1" colspan="1">0.0508</td><td align="center" rowspan="1" colspan="1">0.0509</td></tr><tr><td rowspan="1" colspan="1">AVG. DSC</td><td align="center" rowspan="1" colspan="1">0.0026</td><td align="center" rowspan="1" colspan="1">0.0018</td><td align="center" rowspan="1" colspan="1">0.0011</td><td align="center" rowspan="1" colspan="1">0.0009</td><td align="center" rowspan="1" colspan="1">0.0008</td></tr></tbody></table></table-wrap><table-wrap id="tab2" position="float"><label>Table 2</label><caption><p>Average results about the experiment on bi-Gaussian 		random number generation; averages computed over 100 		independent trials when the 		algorithm (<xref ref-type="disp-formula" rid="Eq7">7</xref>) 		was iterated 10 times (second  batch of results).</p></caption><table frame="hsides" rules="groups"><thead><tr><th rowspan="1" colspan="1">POINTS <italic>N</italic></th><th align="center" rowspan="1" colspan="1">1200</th><th align="center" rowspan="1" colspan="1">1400</th><th align="center" rowspan="1" colspan="1">1600</th><th align="center" rowspan="1" colspan="1">1800</th><th align="center" rowspan="1" colspan="1">2000</th></tr></thead><tbody><tr><td rowspan="1" colspan="1">AVG. LEARN. TIME</td><td align="center" rowspan="1" colspan="1">0.0145</td><td align="center" rowspan="1" colspan="1">0.0155</td><td align="center" rowspan="1" colspan="1">0.0176</td><td align="center" rowspan="1" colspan="1">0.0197</td><td align="center" rowspan="1" colspan="1">0.0209</td></tr><tr><td rowspan="1" colspan="1">AVG. GEN. TIME</td><td align="center" rowspan="1" colspan="1">0.0527</td><td align="center" rowspan="1" colspan="1">0.0528</td><td align="center" rowspan="1" colspan="1">0.0527</td><td align="center" rowspan="1" colspan="1">0.0511</td><td align="center" rowspan="1" colspan="1">0.0523</td></tr><tr><td rowspan="1" colspan="1">AVG. DSC</td><td align="center" rowspan="1" colspan="1">0.0007</td><td align="center" rowspan="1" colspan="1">0.0006</td><td align="center" rowspan="1" colspan="1">0.0005</td><td align="center" rowspan="1" colspan="1">0.0006</td><td align="center" rowspan="1" colspan="1">0.0005</td></tr></tbody></table></table-wrap><table-wrap id="tab3" position="float"><label>Table 3</label><caption><p>Average results about the experiment on generalized 		Gaussian random number generation; averages computed 		over 100 independent trials when the algorithm 		(<xref ref-type="disp-formula" rid="Eq7">7</xref>) was 		iterated 10 times.</p></caption><table frame="hsides" rules="groups"><thead><tr><th rowspan="1" colspan="1">POINTS <italic>N</italic></th><th align="center" rowspan="1" colspan="1">200</th><th align="center" rowspan="1" colspan="1">400</th><th align="center" rowspan="1" colspan="1">600</th><th align="center" rowspan="1" colspan="1">800</th><th align="center" rowspan="1" colspan="1">1000</th></tr></thead><tbody><tr><td rowspan="1" colspan="1">AVG. LEARN. TIME</td><td align="center" rowspan="1" colspan="1">0.0129</td><td align="center" rowspan="1" colspan="1">0.0159</td><td align="center" rowspan="1" colspan="1">0.0229</td><td align="center" rowspan="1" colspan="1">0.0281</td><td align="center" rowspan="1" colspan="1">0.0320</td></tr><tr><td rowspan="1" colspan="1">AVG. GEN. TIME</td><td align="center" rowspan="1" colspan="1">0.0511</td><td align="center" rowspan="1" colspan="1">0.0517</td><td align="center" rowspan="1" colspan="1">0.0500</td><td align="center" rowspan="1" colspan="1">0.0502</td><td align="center" rowspan="1" colspan="1">0.0513</td></tr><tr><td rowspan="1" colspan="1">AVG. DSC</td><td align="center" rowspan="1" colspan="1">0.0038</td><td align="center" rowspan="1" colspan="1">0.0018</td><td align="center" rowspan="1" colspan="1">0.0011</td><td align="center" rowspan="1" colspan="1">0.0007</td><td align="center" rowspan="1" colspan="1">0.0005</td></tr></tbody></table></table-wrap><table-wrap id="tab4" position="float"><label>Table 4</label><caption><p>Average results about the experiment on Gamma random 		number generation; averages computed over 100 independent 		trials when the algorithm 		(<xref ref-type="disp-formula" rid="Eq7">7</xref>) 		was iterated 20 times.</p></caption><table frame="hsides" rules="groups"><thead><tr><th rowspan="1" colspan="1">POINTS N</th><th align="center" rowspan="1" colspan="1">1000</th><th align="center" rowspan="1" colspan="1">1200</th><th align="center" rowspan="1" colspan="1">1400</th><th align="center" rowspan="1" colspan="1">1600</th><th align="center" rowspan="1" colspan="1">1800</th></tr></thead><tbody><tr><td rowspan="1" colspan="1">AVG. LEARN. TIME</td><td align="center" rowspan="1" colspan="1">0.0165</td><td align="center" rowspan="1" colspan="1">0.0176</td><td align="center" rowspan="1" colspan="1">0.0220</td><td align="center" rowspan="1" colspan="1">0.0242</td><td align="center" rowspan="1" colspan="1">0.0261</td></tr><tr><td rowspan="1" colspan="1">AVG. GEN. TIME</td><td align="center" rowspan="1" colspan="1">0.0516</td><td align="center" rowspan="1" colspan="1">0.0516</td><td align="center" rowspan="1" colspan="1">0.0504</td><td align="center" rowspan="1" colspan="1">0.0514</td><td align="center" rowspan="1" colspan="1">0.0513</td></tr><tr><td rowspan="1" colspan="1">AVG. DSC</td><td align="center" rowspan="1" colspan="1">0.0137</td><td align="center" rowspan="1" colspan="1">0.0118</td><td align="center" rowspan="1" colspan="1">0.0118</td><td align="center" rowspan="1" colspan="1">0.0109</td><td align="center" rowspan="1" colspan="1">0.0101</td></tr></tbody></table></table-wrap></floats-wrap></article>