<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article article-type="research-article"><?properties open_access?><!-- Original-type: ra--><front><journal-meta><journal-id journal-id-type="nlm-ta">Br J Cancer</journal-id><journal-title>British Journal of Cancer</journal-title><issn pub-type="ppub">0007-0920</issn><issn pub-type="epub">1532-1827</issn><publisher><publisher-name>Nature Publishing Group</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">10970699</article-id><article-id pub-id-type="pmc">2374691</article-id><article-id pub-id-type="pii">6691360</article-id><article-id pub-id-type="doi">10.1054/bjoc.2000.1360</article-id><article-categories><subj-group subj-group-type="heading"><subject>Regular Article</subject></subj-group></article-categories><title-group><article-title>Alcohol and breast cancer risk: the alcoholism paradox</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Kuper</surname><given-names>H</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Ye</surname><given-names>W</given-names></name><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Weiderpass</surname><given-names>E</given-names></name><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Ekbom</surname><given-names>A</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Trichopoulos</surname><given-names>D</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Nyr&#x000e9;n</surname><given-names>O</given-names></name><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Adami</surname><given-names>H-O</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff2">2</xref></contrib></contrib-group><aff id="aff1"><label>1</label>Department of Epidemiology and Harvard Center for Cancer Prevention, Harvard University, Boston, MA 02115, USA</aff><aff id="aff2"><label>2</label>Department of Medical Epidemiology, Karolinska Institutet, PO Box 281, Stockholm, 171 77, Sweden</aff><pub-date pub-type="epub"><day>04</day><month>09</month><year>2000</year></pub-date><pub-date pub-type="ppub"><month>10</month><year>2000</year></pub-date><volume>83</volume><issue>7</issue><fpage>949</fpage><lpage>951</lpage><history><date date-type="received"><day>08</day><month>05</month><year>2000</year></date><date date-type="rev-recd"><day>26</day><month>05</month><year>2000</year></date><date date-type="accepted"><day>31</day><month>05</month><year>2000</year></date></history><copyright-statement>Copyright 2000, Cancer Research Campaign</copyright-statement><copyright-year>2000</copyright-year><permissions><copyright-holder>Cancer Research Campaign</copyright-holder></permissions><abstract><p>A population-based cohort study of 36 856 women diagnosed with alcoholism in Sweden between 1965 and 1995 found that alcoholic women had only a small 15&#x00025; increase in breast-cancer incidence compared to the general female population. It is therefore apparent, contrary to expectation, that alcoholism does not increase breast-cancer risk in proportion to presumed ethanol intake. &#x000a9; 2000 Cancer Research Campaign</p></abstract><kwd-group><kwd>alcoholism</kwd><kwd>alcohol</kwd><kwd>breast cancer</kwd></kwd-group></article-meta></front></article>