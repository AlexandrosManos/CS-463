er" valign="top" charoff="50">3C</td><td align="center" valign="top" charoff="50">3</td><td align="left" valign="top" charoff="50">NI</td><td align="left" valign="top" charoff="50">ND</td><td align="center" valign="top" charoff="50">5</td><td align="center" valign="top" charoff="50">25199</td><td align="left" valign="top" charoff="50">IVS5&#x0002b;15</td><td align="left" valign="top" charoff="50"><underline>A</underline>&#x02192;<underline>G</underline></td><td align="left" valign="top" charoff="50">Intronic</td></tr><tr><td align="left" valign="top" charoff="50">70&#x0002f;94</td><td align="left" valign="top" charoff="50">SER</td><td align="center" valign="top" charoff="50">3C</td><td align="center" valign="top" charoff="50">2</td><td align="left" valign="top" charoff="50">NL</td><td align="left" valign="top" charoff="50">ND</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td></tr></tbody></table><table-wrap-foot><fn id="tbfnote1"><label>a</label><p>Bases counted from ATG start codon; NS&#x0003d;not specified; NL&#x0003d;no loss; LOH&#x0003d;loss of heterozygosity; NI&#x0003d;not informative; CR&#x0003d;can't read; ND&#x0003d;not done.</p></fn></table-wrap-foot></table-wrap>). There were 31 serous tumours, seven endometrioid tumours and two clear cell tumours. All patients were staged at laparotomy, in accordance with the recommendations of the International Federation of Gynaecology and Obstetrics (FIGO). Primary breast tumours were obtained from 25 patients with malignant tumours undergoing surgery (<xref rid="tbl3" ref-type="table">Table 3</xref><table-wrap id="tbl3" position="float"><label>Table 3</label><caption><p content-type="table-title">LOH status, mutation results and clinicopathological features of primary breast tum