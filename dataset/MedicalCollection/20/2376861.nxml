d-type="pmid">9875044</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Copeland</surname><given-names>DR</given-names></name><name><surname>Moore</surname><given-names>BD</given-names></name></person-group><article-title>A review of neuropsychological outcome among children treated at the university of Texas MD Anderson Cancer Center</article-title><source>Cancer Bull</source><year>1993</year><volume>44</volume><fpage>509</fpage><lpage>517</lpage><!--PubMed citation query: 'Cancer Bull||44|509||bib8|'--></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Agostini</surname><given-names>M</given-names></name><name><surname>Dellatollas</surname><given-names>G</given-names></name></person-group><article-title>Une &#x000e9;preuve simple pour &#x000e9;valuer la pr&#x000e9;f&#x000e9;rence manuelle chez l'enfant &#x000e0; partir de trois ans</article-title><source>Enfance</source><year>1988</year><volume>41</volume><fpage>139</fpage><lpage>147</lpage><!--PubMed citation query: 'Enfance||41|139||bib9|'--></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Agostini</surname><given-names>M</given-names></name><name><surname>Kremin</surname><given-names>H</given-names></name><name><surname>Curt</surname><given-names>F</given-names></name><name><surname>Dellatollas</surname><given-names>G</given-names></name></person-group><article-title>Immediate memory in children aged 3 to 8 digits, familiar words, unfamiliar words, pictures and corsi</article-title><source>ANNAE</source><year>1999</year><volume>36</volume><fpage>4</fpage><lpage>10</lpage><!--PubMed citation query: 'ANNAE||36|4||bib10|'--></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dodge</surname><given-names>HW</given-names></name><name><surname>Lowe</surname><given-names>JG</given-names></name><name><surname>Craig</surname><given-names>WM</given-names></name><etal/></person-group><article-title>Gliomas of the optic nerves</article-title><source>Arch Neurol Psychiatry</source><year>1958</year><volume>79</volume><fpage>607</fpage><lpage>621</lpage><!--PubMed citation query: 'Arch Neurol Psychiatry||79|607||bib11|'--><pub-id pub-id-type="pmid">13532071</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Duffner</surname><given-names>PK</given-names></name><name><surname>Cohen</surname><given-names>ME</given-names></name><name><surname>Parker</surname><given-names>MS</given-names></name></person-group><article-title>Prospective intellectual testing in children with brain tumors</article-title><source>Ann Neurol</source><year>1988</year><volume>23</volume><fpage>575</fpage><lpage>579</lpage><!--PubMed citation query: 'Ann Neurol||23|575||bib12|'--><pub-id pub-id-type="pmid">3408238</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dutton</surname><given-names>JJ</given-names></name></person-group><article-title>Gliomas of the anterior visual pathway</article-title><source>Surv Ophthalmol</source><year>1994</year><volume>38</volume><fpage>427</fpage><lpage>442</lpage><!--PubMed citation query: 'Surv Ophthalmol||38|427||bib13|'--><pub-id pub-id-type="pmid">8009427</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eliason</surname><given-names>MJ</given-names></name></person-group><article-title>Neurofibromatosis: implications for learning and behavior</article-title><source>J Dev Behav Pediatr</source><year>1986</year><volume>7</volume><fpage>175</fpage><lpage>179</lpage><!--PubMed citation query: 'J Dev Behav Pediatr||7|175||bib14|'--><pub-id pub-id-type="pmid">3088045</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fouladi</surname><given-names>M</given-names></name><name><surname>Wallace</surname><given-names>D</given-names></name><name><surname>Langston</surname><given-names>JW</given-names></name><name><surname>Mulhern</surname><given-names>R</given-names></name><name><surname>Rose</surname><given-names>SR</given-names></name><name><surname>Gajjar</surname><given-names>A</given-names></name><name><surname>Sanford</surname><given-names>RA</given-names></name><name><surname>Merchant</surname><given-names>TE</given-names></name><name><surname>Jenkins</surname><given-names>JJ</given-names></name><name><surname>Kun</surname><given-names>LE</given-names></name><name><surname>Heideman</surname><given-names>RL</given-names></name></person-group><article-title>Survival and functional outcome of children with hypothalamic&#x0002f;chiasmatic tumors</article-title><source>Cancer</source><year>2003</year><volume>97</volume><fpage>1084</fpage><lpage>1092</lpage><!--PubMed citation query: 'Cancer||97|1084||bib15|'--><pub-id pub-id-type="pmid">12569610</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garcia-Perez</surname><given-names>A</given-names></name><name><surname>Sierrasumaga</surname><given-names>L</given-names></name><name><surname>Narbona-Garcia</surname><given-names>J</given-names></name><name><surname>Calvo-Manuel</surname></name><name><surname>Aguirre-Ventallo</surname><given-names>M</given-names></name></person-group><article-title>Neuropsychological evaluation of children with intracranial tumors: impact of treatment modalities</article-title><source>Med Pediatr Oncol</source><year>1994</year><volume>23</volume><fpage>116</fpage><lpage>123</lpage><!--PubMed citation query: 'Med Pediatr Oncol||23|116||bib16|'--><pub-id pub-id-type="pmid">8202033</pu