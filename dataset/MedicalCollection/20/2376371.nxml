valign="top" charoff="50">0.95</td><td align="center" valign="top" charoff="50">(0.68&#x02013;1.32)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x02003;1&#x02013;6 months</td><td align="center" valign="top" charoff="50">105</td><td align="center" valign="top" charoff="50">114</td><td align="center" valign="top" charoff="50">0.94</td><td align="center" valign="top" charoff="50">(0.66&#x02013;1.35)</td><td align="center" valign="top" charoff="50">0.90</td><td align="center" valign="top" charoff="50">(0.62&#x02013;1.31)</td><td align="center" valign="top" charoff="50">0.97</td><td align="center" valign="top" charoff="50">(0.76&#x02013;1.25)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x02003;&#x02a7e;7 months</td><td align="center" valign="top" charoff="50">30</td><td align="center" valign="top" charoff="50">26</td><td align="center" valign="top" charoff="50">1.16</td><td align="center" valign="top" charoff="50">(0.65&#x02013;2.07)</td><td align="center" valign="top" charoff="50">1.16</td><td align="center" valign="top" charoff="50">(0.64&#x02013;2.11)</td><td align="center" valign="top" charoff="50">1.17</td><td align="center" valign="top" charoff="50">(0.77&#x02013;1.77)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x02003;Unknown duration</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">&#x02014;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Not known</td><td align="center" valign="top" charoff="50">2</td><td align="center" valign="top" charoff="50">5</td><td align="center" valign="top" charoff