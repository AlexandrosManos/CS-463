urnal"><person-group><name><surname>Newcomb</surname><given-names>PA</given-names></name><name><surname>Norfleet</surname><given-names>RG</given-names></name><name><surname>Storer</surname><given-names>BE</given-names></name><name><surname>Surawicz</surname><given-names>TS</given-names></name><name><surname>Marcus</surname><given-names>PM</given-names></name></person-group><article-title>Screening sigmoidoscopy and colorectal cancer mortality</article-title><source>J Natl Cancer Inst 1992</source><volume>84</volume><fpage>1572</fpage><lpage>5</lpage><pub-id pub-id-type="doi">10.1093/jnci/84.20.1572</pub-id></element-citation></ref><ref id="bib-010"><label>10</label><element-citation publication-type="journal"><person-group><name><surname>Soetikno</surname><given-names>RM</given-names></name><name><surname>Kaltenbach</surname><given-names>T</given-names></name><name><surname>Rouse</surname><given-names>RV</given-names></name><name><surname>Park</surname><given-names>W</given-names></name><name><surname>Maheshwari</surname><given-names>A</given-names></name><name><surname>Sato</surname><given-names>T</given-names></name><name><surname>Matsui</surname><given-names>S</given-names></name><name><surname>Friedland</surname><given-names>S</given-names></name></person-group><article-title>Prevalence of nonpolypoid (flat and depressed) colorectal neoplasms in asymptomatic and symptomatic adults</article-title><source>JAMA</source><year>2008</year><volume>299</volume><fpage>1027</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">18319413</pub-id><pub-id pub-id-type="doi">10.1001/jama.299.9.1027</pub-id></element-citation><note><p><ext-link ext-link-type="uri" xlink:href="http://f1000medicine.com/article/id/1103613">F1000 Factor 8.0 <italic>Exceptional</italic></ext-link></p><p>Evaluated by Richard Sampliner 2 Apr 2008, John Inadomi with Ma Somsouk 7 Apr2008</p></note></ref><ref id="bib-011"><label>11</label><element-citation publication-type="journal"><person-group><name><surn