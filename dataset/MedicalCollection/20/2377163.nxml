<article-title>Internal <italic>versus</italic> external locus of control of reinforcement</article-title><source>Am Psychol</source><year>1990</year><volume>45</volume><fpage>489</fpage><lpage>493</lpage><!--PubMed citation query: 'Am Psychol||45|489||bib24|'--></citation></ref><ref id="bib25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Salehi</surname><given-names>I</given-names></name></person-group><article-title>La th&#x000e9;orie de l'apprentissage social de la personnalit&#x000e9; de J.B. ROTTER: le concept de lieu de contr&#x000f4;le du renforcement</article-title><source>J Th&#x000e9;r Comportementale</source><year>1981</year><volume>2</volume><fpage>103</fpage><lpage>117</lpage><!--PubMed citation query: 'J Th&#x000e9;r Comportementale||2|103||bib25|'--></citation></ref><ref id="bib26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Silberfarb</surname><given-names>PM</given-names></name><name><surname>Levine</surname><given-names>PM</given-names></name></person-group><article-title>Psycho-social aspects of neoplastic disease. III Group support for the oncology nurse</article-title><source>Gen Hosp Psychiatry</source><year>1980</year><volume>3</volume><fpage>192</fpage><lpage>197</lpage><!--PubMed citation query: 'Gen Hosp Psychiatry||3|192||bib26|'--></citation></ref><ref id="bib27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vagg</surname><given-names>PR</given-names></name><name><surname>Spielberger</surname><given-names>CD</given-names></name></person-group><article-title>The Job Stress Survey: assessing perceived severity and frequency of occurrence of generic sources of stress in the workplace</article-title><source>J Occup Health Psychol</source><year>1999</year><volume>4</volume><fpage>288</fpage><lpage>292</lpage><!--PubMed citation query: 'J Occup Health Psychol||4|288||bib27|'--><pub-id pub-id-type="pmid">10431288</pub-id></citation></ref><ref id="bib28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vitaliano</surname><given-names>PP</given-names></name><name><surname>Russo</surname><given-names>J</given-names></name><name><surname>Carr</surname><given-names>JE</given-names></name><name><surname>Maiuro</surname><given-names>RD</given-names></name><name><surname>Becker</surname><given-names>J</given-names></name></person-group><article-title>The ways of coping checklist: revision and psychometric properties</article-title><source>Multivar Behav Res</source><year>1985</year><volume>20</volume><fpage>3</fpage><lpage>26</lpage><!--PubMed citation query: 'Multivar Behav Res||20|3||bib28|'--></citation></ref><ref id="bib29"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wallston</surname><given-names>KA</given-names></name><name><surname>Wallston</surname><given-names>BS</given-names></name></person-group><article-title>Who is responsible for your health? The construct of health locus of control</article-title><source>Social Psychology and Health and Illness</source><year>1982</year><publisher-name>Hillsdale, NJ; Erlbaum</publisher-name><fpage>65</fpage><lpage>95</lpage>Sanders G, Suls J (eds)</citation></ref><ref id="bib30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zigmond</surname><given-names>AS</given-names></name><name><surname>Snaith</surname><given-names>RP</given-names></name></person-group><article-title>The hospital anxiety and depression scale</article-title><source>Acta Psychiatr Scand</source><year>1983</year><volume>67</volume><fpage>361</fpage><lpage>370</lpage><!--PubMed citation query: 'Acta Psychiatr Scand||67|361||bib30|'--><pub-id pub-id-type="pmid">6880820</pub-id></citation></ref></ref-list></back></article>