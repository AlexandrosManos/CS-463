ign="center" valign="top" charoff="50">68</td><td align="center" valign="top" charoff="50">22</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x0003e;15&#x00025;</td><td align="center" valign="top" charoff="50">57</td><td align="center" valign="top" charoff="50">33</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" char="." charoff="50">2.88</td><td align="center" valign="top" char="&#x02013;" charoff="50">1.3&#x02013;6.4</td><td align="center" valign="top" char="." charoff="50">0.004</td></tr><tr><td align="left" valign="top" charoff="50">P53</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;0</td><td align="center" valign="top" charoff="50">89</td><td align="center" valign="top" charoff="50">36</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x02a7e;1&#x00025;</td><td align="center" valign="top" charoff="50">34</td><td align="center" valign="top" charoff="50">17</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" char="." charoff="50">1.47</td><td align="center" valign="top" char="&#x02013;" charoff="50">0.62&#x02013;3.51</td><td align="center" valign="top" char="." charoff="50">0.339</td></tr></tbody></table><table-wrap-foot><fn id="tbfnote5"><label>a</label><p>&#x00023;:number of patients with tumour regression &#x02a7e;50&#x00025;, including complete tumour regression after six cycles of primary chemotherapy.</p></fn><fn id="tbfnote6"><label>b</label><p>OR&#x0003d;odd ratios.</p></fn><fn id="tbfnote7"><label>c</label><p>95CI&#x0003d;95&#x00025; confidence interval.</p></fn><fn id="tbfnote8"><label>d</label><p>Her2-neu positive cases were those with 10&#x00025; or more positive tumour cells with a moderate or strong intensity of staining, Her2-neu negative cases were all the other cases.</p></fn></table-wrap-foot></table-wrap>). The median Ki-S7 value was higher in the good response group (tumour regression &#x02a7e;50&#x00025; and complete tumour regression) compared to the poor response group (tumour regression &#x0003c;50&#x00025;, tumour stabilisation and progression), 20 and 15&#x00025;, respectively. To evaluate the predictive impact of Ki-S7 in this series, a first stepwise logistic regression model was performed with all the factors that had been previously analysed in the series, that is, clinical tumour size, SBR grade, IHC-ER, IHC-PR, Ki-67, p53 and Her-2&#x0002f;<italic>neu</italic> (<xref rid="tbl3" ref-type="table">Table 3</xref> <table-wrap id="tbl3" position="float"><label>Table 3</label><caption><p content-type="table-title">Factors associated with tumour regression &#x02a7e;50&#x00025;, including complete tumour regression after six cycles of primary chemotherapy among 125 patients: multivariate analyses (model 1: factors identified in MacGrogan 1996a; model 2: with new factor, Ki-S7)</p></caption><table frame="hsides" rules="groups" border="1" width="85%"><colgroup><col align="left"/><col align="char" char="."/><col align="char" char="."/><col align="char" char="."/><col align="char" char="&#x02013;"/><col align="char" char="."/><col align="char" char="."/><c