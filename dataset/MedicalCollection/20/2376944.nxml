></name><name><surname>Lazarov</surname><given-names>M</given-names></name><name><surname>Zhang</surname><given-names>JY</given-names></name><name><surname>Cai</surname><given-names>T</given-names></name><name><surname>Green</surname><given-names>CL</given-names></name><name><surname>Russell</surname><given-names>AJ</given-names></name><name><surname>Marinkovich</surname><given-names>MP</given-names></name><name><surname>Tao</surname><given-names>S</given-names></name><name><surname>Lin</surname><given-names>Q</given-names></name><name><surname>Kubo</surname><given-names>Y</given-names></name><name><surname>Khavari</surname><given-names>PA</given-names></name></person-group><article-title>NF-<italic>&#x003ba;</italic>B blockade and oncogenic Ras trigger invasive human epidermal neoplasia</article-title><source>Nature</source><year>2003</year><volume>421</volume><fpage>639</fpage><lpage>643</lpage><!--PubMed citation query: 'Nature||421|639||bib9|'--><pub-id pub-id-type="pmid">12571598</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Du</surname><given-names>J</given-names></name><name><surname>Mitch</surname><given-names>WE</given-names></name><name><surname>Wang</surname><given-names>X</given-names></name><name><surname>Price</surname><given-names>SR</given-names></name></person-group><article-title>Glucocorticoids induce proteasome C3 subunit expression in L6 muscle cells by opposing the suppression of its transcription by NF-<italic>&#x003ba;</italic>B</article-title><source>J Biol Chem</source><year>2000</year><volume>275</volume><fpage>19661</fpage><lpage>19666</lpage><!--PubMed citation query: 'J Biol Chem||275|19661||bib10|'--><pub-id pub-id-type="pmid">10867022</pub-id></citation></ref><ref id="bib39"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fenteany</surname><given-names>G</given-names></name><name><surname>Schreiber</surname><g