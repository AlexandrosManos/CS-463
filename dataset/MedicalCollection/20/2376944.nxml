rson-group person-group-type="author"><name><surname>Li</surname><given-names>Y-P</given-names></name><name><surname>Schwartz</surname><given-names>RJ</given-names></name><name><surname>Waddell</surname><given-names>ID</given-names></name><name><surname>Holloway</surname><given-names>BR</given-names></name><name><surname>Reid</surname><given-names>MB</given-names></name></person-group><article-title>Skeletal muscle myocytes undergo protein loss and reactive oxygen-mediated NF-<italic>&#x003ba;</italic>B activation in response to tumour necrosis factor <italic>&#x003b1;</italic></article-title><source>FASEB J</source><year>1998</year><volume>12</volume><fpage>871</fpage><lpage>880</lpage><!--PubMed citation query: 'FASEB J||12|871||bib16|'--><pub-id pub-id-type="pmid">9657527</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>Y-P</given-names></name><name><surname>Reid</surname><given-names>MB</given-names></name></person-group><article-title>NF-<italic>&#x003ba;</italic>B mediates the protein loss induced by TNF<italic>&#x003b1;</italic> in differentiated skeletal muscle myotubes</article-title><source>Am J Physiol</source><year>2000</year><volume>279</volume><fpage>R1165</fpage><lpage>R1170</lpage><!--PubMed citation query: 'Am J Physiol||279|R1165||bib17|'--></citation></ref><ref id="bib18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lorite</surname><given-names>MJ</given-names></name><name><surname>Cariuk</surname><given-names>P</given-names></name><name><surname>Tisdale</surname><given-names>MJ</given-names></name></person-group><article-title>Induction of muscle protein degradation by a tumour factor</article-title><source>Br J Cancer</source><year>1997</year><volume>76</volume><fpage>1035</fpage><lpage>1040</lpage><!--PubMed citation query: 'Br J Cancer||76|1035||bib18|'--><pub-id pub-id-type="pmid">9376263</pub