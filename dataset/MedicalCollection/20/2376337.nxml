>64</volume><fpage>119</fpage><lpage>128</lpage><!--PubMed citation query: 'Biochem Soc Symp||64|119||bib8|'--><pub-id pub-id-type="pmid">10207625</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dougherty</surname><given-names>TJ</given-names></name><name><surname>Gomer</surname><given-names>CJ</given-names></name><name><surname>Henderson</surname><given-names>BW</given-names></name><name><surname>Jori</surname><given-names>G</given-names></name><name><surname>Kessel</surname><given-names>D</given-names></name><name><surname>Korbelik</surname><given-names>M</given-names></name><name><surname>Moan</surname><given-names>J</given-names></name><name><surname>Peng</surname><given-names>Q</given-names></name></person-group><article-title>Photodynamic therapy</article-title><source>J Natl Cancer Inst</source><year>1998</year><volume>90</volume><fpage>889</fpage><lpage>905</lpage><!--PubMed citation query: 'J Natl Cancer Inst||90|889||bib9|'--><pub-id pub-id-type="pmid">9637138</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferrario</surname><given-names>A</given-names></name><name><surname>von Thiel</surname><given-names>KF</given-names></name><name><surname>Rucker</surname><given-names>N</given-names></name><name><surname>Schwarz</surname><given-names>MA</given-names></name><name><surname>Gill</surname><given-names>PS</given-names></name><name><surname>Gomer</surname><given-names>CJ</given-names></name></person-group><article-title>Antiangiogenic treatment enhances photodynamic therapy responsiveness in a mouse mammary carcinoma</article-title><source>Cancer Res</source><year>2000</year><volume>60</volume><fpage>4066</fpage><lpage>4069</lpage><!--PubMed citation query: 'Cancer Res||60|4066||bib10|'--><pub-id pub-id-type="pmid">10945611</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fingar</surname><given-names>VH</given-names></name><name><surname>Wieman</surname><given-names>TJ</given-names></name><name><surname>Doak</surname><given-names>KW</given-names></name></person-group><article-title>Role of thromboxane and prostacyclin release on photodynamic therapy-induced tumor destruction</article-title><source>Cancer Res</source><year>1990</year><volume>50</volume><fpage>2599</fpage><lpage>2603</lpage><!--PubMed citation query: 'Cancer Res||50|2599||bib11|'--><pub-id pub-id-type="pmid">2139357</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fingar</surname><given-names>VH</given-names></name><name><surname>Wieman</surname><given-names>TJ</given-names></name><name><surname>Wiehle</surname><given-names>SA</given-names></name><name><surname>Cerrito</surname><given-names>PB</given-names></name></person-group><article-title>The role of microvascular damage in photodynamic therapy: the effect of treatment on vessel constriction, permeability, and leukocyte adhesion</article-title><source>Cancer Res</source><year>1992</year><volume>52</volume><fpage>4914</fpage><lpage>4921</lpage><!--PubMed citation query: 'Cancer Res||52|4914||bib12|'--><pub-id pub-id-type="pmid">1387584</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Foster</surname><given-names>TH</given-names></name><name><surname>Murant</surname><given-names>RS</given-names></name><name><surname>Bryant</surname><given-names>RG</given-names></name><name><surname>Knox</surname><given-names>RS</given-names></name><name><surname>Gibson</surname><given-names>SL</given-names></name><name><surname>Hilf</surname><given-names>R</given-names></name></person-group><article-title>Oxygen consumption and diffusion effects in photodynamic therapy</article-title><source>Radiat Res</source><year>1991</year><volume>126</volume><fpage>296</fpage><lpage>303</lpage><!--PubMed citation query: 'Radiat Res||126|296||bib13|'--><pub-id pub-id-type="pmid">2034787</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gollnick</surname><given-names>SO</given-names></name><name><surname>Liu</surname><given-names>X</given-names></name><name><surname>Owczarczak</surname><given-names>B</given-names></name><name><surname>Musser</surname><given-names>DA</given-names></name><name><surname>Henderson</surname><given-names>BW</given-names></name></person-group><article-title>Altered expression of interleukin 6 and interleukin 10 as a result of photodynamic therapy <italic>in vivo</italic></article-title><source>Cancer Res</source><year>1997</year><volume>57</volume><fpage>3904</fpage><lpage>3909</lpage><!--PubMed citation query: 'Cancer Res||57|3904||bib14|'--><pub-id pub-id-type="pmid">9307269</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Granger</surname><given-names>DN</given-names></name><name><surname>McCord</surname><given-names>JM</given-names></name><name><surname>Parks</surname><given-names>DA</given-names></name><name><surname>Hollwarth</surname><given-names>ME</given-names></name></person-group><article-title>Xanthine oxidase inhibitors attenuate ischemia-induced vascular permeability changes in the cat intestine</article-title><source>Gastroenterology</source><year>1986</year><volume>90</volume><fpage>80</fpage><lpage>84</lpage><!--PubMed citation query: 'Gastroenterology||90|80||bib15|'--><pub-id pub-id-type="pmid">3753555</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hajdur</surname><given-names>C</given-names></name><name><surname>Wagni&#x000e8;res</surname><given-names>G</given-names></name><name><surname>Ihringer</surna