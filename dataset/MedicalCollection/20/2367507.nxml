                                                                     <mml:mi>X</mml:mi>                                                                           <mml:mi>i</mml:mi>                                                                        </mml:msub>                                                                        <mml:mo>,</mml:mo>                                                                        <mml:msub>                                                                           <mml:mi>X</mml:mi>                                                                           <mml:mi>j</mml:mi>                                                                        </mml:msub>                                                                        <mml:mo>;</mml:mo>                                                                        <mml:mi>k</mml:mi>                                                                        <mml:mo stretchy="false">)</mml:mo>                                                                     </mml:mrow>                                                                     <mml:mo>)</mml:mo>                                                                  </mml:mrow>                                                               </mml:mrow>                                                               <mml:mn>2</mml:mn>                                                            </mml:msup>                                                         </mml:mrow>                                                      </mml:mstyle>                                                   </mml:mrow>                                                </mml:mstyle>                                             </mml:mrow>                                             <mml:mo>)</mml:mo>                                          </mml:mrow>                                       </mml:mrow>                                    </mml:mrow>                                 </mml:mrow>                              </mml:mtd>                           </mml:mtr>                           <mml:mtr>                              <mml:mtd>                                 <mml:mrow>                                    <mml:mrow>                                       <mml:mrow>                                          <mml:mo>+</mml:mo>                                          <mml:mn>4</mml:mn>                                          <mml:mo stretchy="false">(</mml:mo>                                          <mml:mi>N</mml:mi>                                          <mml:mo>&#x02212;</mml:mo>                                          <mml:mn>1</mml:mn>                                          <mml:mo stretchy="false">)</mml:mo>                                          <mml:mo>&#x022c5;</mml:mo>                                          <mml:mfrac>                                             <mml:mn>1</mml:mn>                                             <mml:mi>N</mml:mi>                                          </mml:mfrac>                                          <mml:mstyle displaystyle="true">                                             <mml:munderover>                                                <mml:mo>&#x02211;</mml:mo>                                                <mml:mrow>                                                   <mml:mi>i</mml:mi>                                                   <mml:mo>=</mml:mo>                                                   <mml:mn>1</mml:mn>                                                </mml:mrow>                                                <mml:mi>N</mml:mi>                                             </mml:munderover>                                             <mml:mrow>                                                <mml:msup>                                                   <mml:mrow>                                                      <mml:mrow>                                                         <mml:mo>(</mml:mo>                                                         <mml:mrow>                                                            <mml:mfrac>                                                               <mml:mn>1</mml:mn>                                                               <mml:mrow>                                                                  <mml:mi>N</mml:mi>                                                                  <mml:mo>&#x02212;</mml:mo>                                                                  <mml:mn>1</mml:mn>                                                               </mml:mrow>                                                            </mml:mfrac>                                                            <mml:mstyle displaystyle="true">                                                               <mml:munderover>                                                                  <mml:mo>&#x02211;</mml:mo>                                                                  <mml:mrow>                                                                     <mml:mtable>                                                                        <mml:mtr>                                                                           <mml:mtd>                                                                              <mml:mrow>                                                                                 <mml:mi>j</mml:mi>                                                                                 <mml:mo>=</mml:mo>                                                                                 <mml:mn>1</mml:mn>                                                                              </mml:mrow>                                                                           </mml:mtd>                                                                        </mml:mtr>                                                                        <mml:mtr>                                                                           <mml:mtd>                                                                              <mml:mrow>                                                                                 <mml:mi>j</mml:mi>                                                                                 <mml:mo>&#x02260;</mml:mo>                                                                                 <mml:mi>i</mml:mi>                                                                              </mml:mrow>                                                                           </mml:mtd>                                                                        </mml:mtr>                                                                     </mml:mtable>                                                                  </mml:mrow>                                                                  <mml:mi>N</mml:mi>                                                               </mml:munderover>                                                               <mml:mrow>                                                                  <mml:mi>h</mml:mi>                                                                  <mml:mo stretchy="false">(</mml:mo>                                                                  <mml:msub>                                                                     <mml:mi>X</mml:mi>                                                                     <mml:mi>i</mml:mi>                                                                  </mml:msub>                                                                  <mml:mo>,</mml:mo>                                                                  <mml:msub>                                                                     <mml:mi>X</mml:mi>                                                                     <mml:mi>j</mml:mi>                                                                  </mml:msub>                                                                  <mml:mo>;</mml:mo>                                                                  <mml:mi>k</mml:mi>                                                               </mml:mrow>                                                            </mml:mstyle>                                                            <mml:mo stretchy="false">)</mml:mo>                                                         </mml:mrow>                                                         <mml:mo>)</mml:mo>                                                      </mml:mrow>                                                   </mml:mrow>                                                   <mml:mn>2</mml:mn>                                                </mml:msup>                                                <mml:mo>&#x02212;</mml:mo>                                                <mml:mi>N</mml:mi>                                                <mml:mo stretchy="false">(</mml:mo>                                                <mml:mi>N</mml:mi>                                                <mml:mo>&#x02212;</mml:mo>                                                <mml:mn>1</mml:mn>                                                <mml:mo stretchy="false">)</mml:mo>                                                <mml:mo>&#x022c5;</mml:mo>                                                <mml:mi>U</mml:mi>                                                <mml:msup>                                                   <mml:mrow>                                                      <mml:mo stretchy="false">(</mml:mo>                                                      <mml:mi>k</mml:mi>                                                      <mml:mo stretchy="false">)</mml:mo>                                                   </mml:mrow>                                                   <mml:mn>2</mml:mn>                                                </mml:msup>                                             </mml:mrow>                                          </mml:mstyle>                                       </mml:mrow>                                       <mml:mo>}</mml:mo>                                    </mml:mrow>                                    <mml:mo>,</mml:mo>                                 </mml:mrow>                              </mml:mtd>                           </mml:mtr>                        </mml:mtable>                     </mml:mrow>                                       </mml:semantics>               </mml:math></disp-formula></p><p>is an unbiased estimate of the variance of a U-statistic. We will derive that <italic>S</italic><sub><italic>h</italic></sub>(<italic>k</italic>)<sup>2 </sup>is an unbiased estimate of var(<italic>h</italic>(<italic>X</italic><sub><italic>i</italic></sub>, <italic>X</italic><sub><italic>j</italic></sub>; <italic>k</italic>)) = <italic>&#x003c3;</italic><sub><italic>k</italic></sub><sup>2</sup>, because from this finding, it simply follows that <italic>S</italic>(<italic>k</italic>)<sup>2 </sup>is an unbiased estimator of var(U), as</p><p><disp-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M11" name="1753-6561-1-S1-S129-i11" overflow="scroll">                  <mml:semantics>                     <mml:mrow>                        <mml:mtable columnalign="left">                           <mml:mtr columnalign="left">                              <mml:mtd columnalign="left">                                 <mml:mrow>                                    <mml:mi>E</mml:mi>                                    <mml:mo stretchy="false">(</mml:mo>                                    <mml:mi>S</mml:mi>                                    <mml:msup>                                       <mml:mrow>                                          <mml:mo stretchy="false">(</mml:mo>                                          <mml:mi>k</mml:mi>                                          <mml:mo stretchy="false">)</mml:mo>                                       </mml:mrow>                                       <mml:mn>2</mml:mn>                                    </mml:msup>                                    <mml:mo stretchy="false">)</mml:mo>                                 </mml:mrow>                              </mml:mtd>                              <mml:mtd columnalign="left">                                 <mml:mrow>                                    <mml:mo>=</mml:mo>                                    <mml:mi>E</mml:mi>                                    <mml:mo stretchy="false">(</mml:mo>                                    <mml:msub>                                       <mml:mi>S</mml:mi>                                       <mml:mi>h</mml:mi>                                    </mml:msub>                                    <mml:msup>                                       <mml:mrow>                                          <mml:mo stretchy="false">(</mml:mo>                                          <mml:mi>k</mml:mi>                                          <mml:mo stretchy="false">)</mml:mo>                                       </mml:mrow>                                       <mml:mn>2</mml:mn>                                    </mml:msup>                                    <mml:mo stretchy="false">)</mml:mo>                                    <mml:mo>&#x02212;</mml:mo>                                    <mml:mstyle scriptlevel="+1">                                       <mml:mfrac>                                          <mml:mn>2</mml:mn>                                          <mml:mrow>                                             <mml:mi>N</mml:mi>                                             <mml:mo stretchy="false">(</mml:mo>                                             <mml:mi>N</mml:mi>                                             <mml:mo>&#x02212;</mml:mo>                                             <mml:mn>1</mml:mn>                                             <mml:mo stretchy="false">)</mml:mo>                                          </mml:mrow>                                       </mml:mfrac>                                    </mml:mstyle>                                    <mml:mo>&#x022c5;</mml:mo>                                    <mml:mstyle displaystyle="true">                                       <mml:munderover>                                          <mml:mo>&#x02211;</mml:mo>                                          <mml:mrow>                                             <mml:mi>i</mml:mi>                                             <mml:mo>=</mml:mo>                                             <mml:mn>1</mml:mn>                                          </mml:mrow>                                          <mml:mrow>                                             <mml:mi>N</mml:mi>                                             <mml:mo>&#x02212;</mml:mo>                                             <mml:mn>1</mml:mn>                                          </mml:mrow>                                       </mml:munderover>                                       <mml:mrow>                                          <mml:mstyle displaystyle="true">                                             <mml:munderover>                                                <mml:mo>&#x02211;</mml:mo>                                                <mml:mrow>                                                   <mml:mi>j</mml:mi>                                                   <mml:mo>=</mml:mo>                                                   <mml:mi>i</mml:mi>                                                   <mml:mo>+</mml:mo>                                                   <mml:mn>1</mml:mn>                                                </mml:mrow>                                                <mml:mi>N</mml:mi>                                             </mml:munderover>                                             <mml:mrow>                                                <mml:mi>E</mml:mi>                                                <mml:msup>                                                   <mml:mrow>                                                      <mml:mrow>                                                         <mml:mo>(</mml:mo>                                                         <mml:mrow>                                                            <mml:mi>h</mml:mi>                                                            <mml:mo stretchy="false">(</mml:mo>                                                            <mml:msub>                                                               <mml:mi>X</mml:mi>                                                               <mml:mi>i</mml:mi>                                                            </mml:msub>                                                            <mml:mo>,</mml:mo>                                                            <mml:msub>                                                               <mml:mi>X</mml:mi>                                                               <mml:mi>j</mml:mi>                                                            </mml:msub>                                                            <mml:mo>;</mml:mo>                                                            <mml:mi>k</mml:mi>                                                            <mml:mo stretchy="false">)</mml:mo>                                                         </mml:mrow>                                                         <mml:mo>)</mml:mo>                                                      </mml:mrow>                                                   </mml:mrow>                                                