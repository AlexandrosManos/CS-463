pub-id-type="pmid">6702217</pub-id></citation></ref><ref id="bib27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Withers</surname><given-names>HR</given-names></name></person-group><article-title>Biologic basis for altered fractionation schemes</article-title><source>Cancer</source><year>1985</year><volume>55</volume><fpage>2086</fpage><lpage>2095</lpage><!--PubMed citation query: 'Cancer||55|2086||bib27|'--><pub-id pub-id-type="pmid">3919923</pub-id></citation></ref><ref id="bib28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wong</surname><given-names>CS</given-names></name><name><surname>Van Dyk</surname><given-names>J</given-names></name><name><surname>Simpson</surname><given-names>J</given-names></name></person-group><article-title>Myelopathy following hyperfractionated accelerated radiotherapy for anaplastic thyroid carcinoma</article-title><source>Radiother Oncol</source><year>1991</year><volume>20</volume><fpage>3</fpage><lpage>9</lpage><!--PubMed citation query: 'Radiother Oncol||20|3||bib28|'--><pub-id pub-id-type="pmid">1902319</pub-id></citation></ref></ref-list></back></article>