<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article article-type="research-article"><?properties open_access?><!-- Original-type: ra--><front><journal-meta><journal-id journal-id-type="nlm-ta">Br J Cancer</journal-id><journal-title>British Journal of Cancer</journal-title><issn pub-type="ppub">0007-0920</issn><issn pub-type="epub">1532-1827</issn><publisher><publisher-name>Nature Publishing Group</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">10917539</article-id><article-id pub-id-type="pmc">2374567</article-id><article-id pub-id-type="pii">6691197</article-id><article-id pub-id-type="doi">10.1054/bjoc.2000.1197</article-id><article-categories><subj-group subj-group-type="heading"><subject>Regular Article</subject></subj-group></article-categories><title-group><article-title>Progress in establishing non-surgical oncology within English cancer units</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Haward</surname><given-names>R A</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Amir</surname><given-names>Z</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib></contrib-group><aff id="aff1"><label>1</label>Northern and Yorkshire Cancer Registry and Informaton Service (NYCRIS), Arthington House, Cookridge Hospital, Leeds, LS16 6QB, UK</aff><pub-date pub-type="epub"><day>03</day><month>07</month><year>2000</year></pub-date><pub-date pub-type="ppub"><month>07</month><year>2000</year></pub-date><volume>83</volume><issue>3</issue><fpage>284</fpage><lpage>286</lpage><history><date date-type="received"><day>18</day><month>08</month><year>1999</year></date><date date-type="rev-recd"><day>11</day><month>08</month><year>2000</year></date><date date-type="accepted"><day>24</day><month>02</month><year>2000</year></date></history><copyright-statement>Copyright 2000, Cancer Research Campaign</copyright-statement><copyright-year>2000</copyright-year><permissions><copyright-holder>Cancer Research Campaign</copyright-holder></permissions><abstract><p>In 1995 the Department of Health recommended a minimum standard of five non-surgical oncology sessions per week at Cancer Units. Postal surveys of cancer units in England were conducted in 1996 and 1999 to establish the level of provision. Substantial progress has been made from 20&#x02013;60&#x00025; of responding units meeting the minimum standard. &#x000a9; 2000 Cancer Research Campaign</p></abstract></article-meta></front></article>