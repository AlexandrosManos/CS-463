<name><surname>Knowles</surname><given-names>JH</given-names></name></person-group><article-title>An Analysis of Pressure-Volume Characteristics of the Lungs</article-title><source>J Appl Physiol</source><year>1964</year><volume>19</volume><fpage>97</fpage><lpage>104</lpage><pub-id pub-id-type="pmid">14104296</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martin</surname><given-names>GEM</given-names></name><name><surname>Ask</surname><given-names>K</given-names></name><name><surname>Gilpin</surname><given-names>SE</given-names></name><name><surname>Kolb</surname><given-names>M</given-names></name><name><surname>Gauldie</surname><given-names>J</given-names></name></person-group><article-title>The transforming growth factor-beta (TGF-[beta]) family and pulmonary fibrosis</article-title><source>Drug Discovery Today: Disease Mechanisms</source><year>2006</year><volume>3</volume><fpage>99</fpage><lpage>103</lpage><pub-id pub-id-type="doi">10.1016/j.ddmec.2006.03.006</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zhou</surname><given-names>X-M</given-names></name><name><surname>Zhang</surname><given-names>G-C</given-names></name><name><surname>Li</surname><given-names>J-X</given-names></name><name><surname>Hou</surname><given-names>J</given-names></name></person-group><article-title>Inhibitory effects of Hu-qi-yin on the bleomycin-induced pulmonary fibrosis in rats</article-title><source>Journal of Ethnopharmacology</source><year>2007</year><volume>111</volume><fpage>255</fpage><lpage>264</lpage><pub-id pub-id-type="pmid">17188826</pub-id><pub-id pub-id-type="doi">10.1016/j.jep.2006.11.029</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zhang</surname><given-names>H-Q</given-names></name><name><surname>Yau</surname><given-names>Y-