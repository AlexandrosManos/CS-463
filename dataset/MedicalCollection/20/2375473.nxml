-title><source>Structure</source><year>2005</year><volume>13</volume><fpage>131</fpage><lpage>141</lpage><pub-id pub-id-type="pmid">15642268</pub-id></citation></ref><ref id="b20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ford</surname><given-names>LE</given-names></name><name><surname>Huxley</surname><given-names>AF</given-names></name><name><surname>Simmons</surname><given-names>RM</given-names></name></person-group><article-title>Tension transients during steady shortening of frog muscle fibres</article-title><source>J Physiol</source><year>1985</year><volume>361</volume><fpage>131</fpage><lpage>150</lpage><pub-id pub-id-type="pmid">3872938</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fortune</surname><given-names>NS</given-names></name><name><surname>Geeves</surname><given-names>MA</given-names></name><name><surname>Ranatunga</surname><given-names>KW</given-names></name></person-group><article-title>Pressure sensitivity of active tension in glycerinated rabbit psoas muscle fibres: effects of ADP and phosphate</article-title><source>J Mus Res Cell Motil</source><year>1989</year><volume>10</volume><fpage>113</fpage><lpage>123</lpage></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fortune</surname><given-names>NS</given-names></name><name><surname>Geeves</surname><given-names>MA</given-names></name><name><surname>Ranatunga</surname><given-names>KW</given-names></name></person-group><article-title>Tension responses to rapid pressure release in glycerinated rabbit muscle fibers</article-title><source>Proc Nat Acad Sci U S A</source><year>1991</year><volume>88</volume><fpage>7323</fpage><lpage>7327</lpage></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Getz</surname><given-names>EB</given-names></name><name><surname>Cooke</surname><given-names>R</given-names></name><name><surname>Lehman</surname><given-names>SL</given-names></name></person-group><article-title>Phase transition in force during ramp stretches of skeletal muscle</article-title><source>Biophys J</source><year>1998</year><volume>75</volume><fpage>2971</fpage><lpage>2983</lpage><pub-id pub-id-type="pmid">9826617</pub-id></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldman</surname><given-names>YE</given-names></name><name><surname>Huxley</surname><given-names>AF</given-names></name></person-group><article-title>Actin compliance: are you pulling my chain?</article-title><source>Biophys J</source><year>1994</year><volume>67</volume><fpage>2131</fpage><lpage>2136</lpage><pub-id pub-id-type="pmid">7696455</pub-id></citation></ref><ref id="b25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldman</surname><given-names>YE</given-names></name><name><surname>McCray</surname><given-names>JA</given-names></name><name><surname>Ranatunga</surname><given-names>KW</given-names></name></person-group><article-title>Transient tension changes initiated by laser temperature jumps in rabbit psoas muscle fibres</article-title><source>J Physiol</source><year>1987</year><volume>392</volume><fpage>71</fpage><lpage>95</lpage><pub-id pub-id-type="pmid">3446791</pub-id></citation></ref><ref id="b26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gutfreund</surname><given-names>H</given-names></name><name><surname>Ranatunga</surname><given-names>KW</given-names></name></person-group><article-title>Simulation of molecular steps in muscle force generation</article-title><source>Proc Roy Soc Lond B</source><year>1999</year><volume>266</volume><fpage>1471</fpage><lpage>1475</lpage></citation></ref><ref id="b27"><citation citation-type="journal"><person-group person-