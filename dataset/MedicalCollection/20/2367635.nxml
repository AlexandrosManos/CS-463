 person-group-type="author"><name><surname>Chabrier</surname><given-names>N</given-names></name><name><surname>Fages</surname><given-names>F</given-names></name><name><surname>Soliman</surname><given-names>S</given-names></name></person-group><article-title>The Biochemical abstract machine BIOCHAM</article-title><source>Proceedings of Computational Methods in Systems Biology (CMSB'04), Lecture Notes in Computer Science 3082</source><year>2005</year><publisher-name>Paris, France: Springer</publisher-name><fpage>172</fpage><lpage>191</lpage></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Eker</surname><given-names>S</given-names></name><name><surname>Knapp</surname><given-names>M</given-names></name><name><surname>Lincoln</surname><given-names>P</given-names></name><name><surname>Laderoute</surname><given-names>K</given-names></name><name><surname>Talcott</surname><given-names>C</given-names></name></person-group><article-title>Pathway Logic: Executable Models of Biological Network</article-title><source>Proceedings of the Fourth International Workshop on Rewriting Logic and Its Applications (WRLA '02), Electronic Notes in Theoretical Computer Science 71</source><year>2002</year><publisher-name>Elsevier</publisher-name><fpage>144</fpage><lpage>161</lpage></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Talcott</surname><given-names>C</given-names></name><name><surname>Eker</surname><given-names>S</given-names></name><name><surname>Knapp</surname><given-names>M</given-names></name><name><surname>Lincoln</surname><given-names>P</given-names></name><name><surname>Laderoute</surname><given-names>K</given-names></name></person-group><article-title>Pathway Logic Modeling of Protein Functional Domains in Signal Transduction</article-title><source>Proceedings of Pacific Symposium on Biocomputing</source><year>2004</year><volume>9</volume><fpage>568</fpage><lpage>580</lpage></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tamaddoni-Nezhad</surname><given-names>A</given-names></name><name><surname>Chaleil</surname><given-names>R</given-names></name><name><surname>Kakas</surname><given-names>A</given-names></name><name><surname>Muggleton</surname><given-names>S</given-names></name></person-group><article-title>Application of abductive ILP to learning metabolic network inhibition from temporal data</article-title><source>Machine Learning</source><year>2006</year><volume>64</volume><fpage>209</fpage><lpage>230</lpage><pub-id pub-id-type="doi">10.1007/s10994-006-8988-x</pub-id></citation></ref><ref id="B26"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Papatheodorou</surname><given-names>I</given-names></name><name><surname>Kakas</surname><given-names>AC</given-names></name><name><surname>Sergot</surname><given-names>M</given-names></name></person-group><article-title>Inference of Gene Relations from Microarray Data by Abduction</article-title><source>Proceedings of Logic Programming and Nonmonotonic Reasoning (LPNMR'05), Lecture Notes in Computer Science 3662</source><year>2005</year><publisher-name>Diamante, Italy</publisher-name><fpage>389</fpage><lpage>393</lpage></citation></ref><ref id="B27"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Grell</surname><given-names>S</given-names></name><name><surname>Schaub</surname><given-names>T</given-names></name><name><surname>Selbig</surname><given-names>J</given-names></name></person-group><article-title>Modelling Biological Networks by Action Languages Via Answer Set Programming</article-title><source>Proceedings of International Conference on Logic Programming (ICLP'06) Lecture Notes in Computer Science 4079</source><year>2006</year><publisher-name>Seattle, WA, USA: Springer</publisher-name><fpage>285</f