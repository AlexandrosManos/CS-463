<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article article-type="letter"><?properties open_access?><!-- Original-type: sc--><front><journal-meta><journal-id journal-id-type="nlm-ta">Br J Cancer</journal-id><journal-title>British Journal of Cancer</journal-title><issn pub-type="ppub">0007-0920</issn><issn pub-type="epub">1532-1827</issn><publisher><publisher-name>Nature Publishing Group</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">10917556</article-id><article-id pub-id-type="pmc">2374569</article-id><article-id pub-id-type="pii">6691110</article-id><article-id pub-id-type="doi">10.1054/bjoc.2000.1110</article-id><article-categories><subj-group subj-group-type="heading"><subject>Short Communication</subject></subj-group></article-categories><title-group><article-title>Socioeconomic status and risk of adenocarcinoma of the oesophagus and cancer of the gastric cardia in Scotland</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Brewster</surname><given-names>D H</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Fraser</surname><given-names>L A</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>McKinney</surname><given-names>P A</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Black</surname><given-names>R J</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib></contrib-group><aff id="aff1"><label>1</label>Scottish Cancer Intelligence Unit, Information &#x00026; Statistics Division, Trinity Park House, South Trinity Road, Edinburgh, EH5 3SQ, UK</aff><pub-date pub-type="epub"><day>03</day><month>07</month><year>2000</year></pub-date><pub-date pub-type="ppub"><month>07</month><year>2000</year></pub-date><volume>83</volume><issue>3</issue><fpage>387</fpage><lpage>390</lpage><history><date date-type="received"><day>04</day><month>01</month><year>2000</year></date><date date-type="rev-recd"><day>31</day><month>01</month><year>2000</year></date><date date-type="accepted"><day>31</day><month>01</month><year>2000</year></date></history><copyright-statement>Copyright 2000, Cancer Research Campaign</copyright-statement><copyright-year>2000</copyright-year><permissions><copyright-holder>Cancer Research Campaign</copyright-holder></permissions><abstract><p>The incidence of oesophageal adenocarcinoma and gastric cardia cancer increased strikingly in Scotland between 1977 and 1996. In contrast to other cancers of the oesophagus and stomach, which showed a clear relationship with socioeconomic status, no trend was evident for oesophageal adenocarcinoma or gastric cardia cancer during 1987&#x02013;1996. &#x000a9; 2000 Cancer Research Campaign</p></abstract><kwd-group><kwd>epidemiology</kwd><kwd>incidence</kwd><kwd>gastric carcinoma</kwd><kwd>oesophageal carcinoma</kwd><kwd>Scotland</kwd><kwd>socioeconomic status</kwd></kwd-group></article-meta></front></article>