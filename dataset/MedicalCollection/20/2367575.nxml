 pub-id-type="doi">10.1186/1471-2105-7-137</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cheung</surname><given-names>VG</given-names></name><name><surname>Conlin</surname><given-names>LK</given-names></name><name><surname>Weber</surname><given-names>TM</given-names></name><name><surname>Arcaro</surname><given-names>M</given-names></name><name><surname>Jen</surname><given-names>K</given-names></name><name><surname>Morley</surname><given-names>M</given-names></name><name><surname>Spielman</surname><given-names>RS</given-names></name></person-group><article-title>Natural variation in human gene expression assessed in lymphoblastoid cells</article-title><source>Nat Genet</source><year>2003</year><volume>33</volume><fpage>422</fpage><lpage>425</lpage><pub-id pub-id-type="pmid">12567189</pub-id><pub-id pub-id-type="doi">10.1038/ng1094</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cheung</surname><given-names>VG</given-names></name><name><surname>Spielman</surname><given-names>RS</given-names></name><name><surname>Ewens</surname><given-names>KG</given-names></name><name><surname>Weber</surname><given-names>TM</given-names></name><name><surname>Morley</surname><given-names>M</given-names></name><name><surname>Burdick</surname><given-names>JT</given-names></name></person-group><article-title>Mapping determinants of human gene expression by regional and genome-wide association</article-title><source>Nature</source><year>2005</year><volume>437</volume><fpage>1365</fpage><lpage>1369</lpage><pub-id pub-id-type="pmid">16251966</pub-id><pub-id pub-id-type="doi">10.1038/nature04244</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morley</surname><given-names>M</given-names></name><name><surname>Molony</surname><given-names>CM</given-names></n