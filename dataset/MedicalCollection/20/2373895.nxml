</source><year>2005</year><volume>8</volume><fpage>31</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">15669143</pub-id><pub-id pub-id-type="doi">10.1016/j.devcel.2004.10.018</pub-id></citation></ref></ref-list></back></article>