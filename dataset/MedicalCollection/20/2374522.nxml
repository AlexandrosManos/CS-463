<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article article-type="research-article"><?properties open_access?><!-- Original-type: ra--><front><journal-meta><journal-id journal-id-type="nlm-ta">Br J Cancer</journal-id><journal-title>British Journal of Cancer</journal-title><issn pub-type="ppub">0007-0920</issn><issn pub-type="epub">1532-1827</issn><publisher><publisher-name>Nature Publishing Group</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">10817498</article-id><article-id pub-id-type="pmc">2374522</article-id><article-id pub-id-type="pii">6691221</article-id><article-id pub-id-type="doi">10.1054/bjoc.2000.1221</article-id><article-categories><subj-group subj-group-type="heading"><subject>Regular Article</subject></subj-group></article-categories><title-group><article-title>Polymorphisms in GSTM1, GSTT1 and CYP1A1 and risk of pancreatic adenocarcinoma</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Liu</surname><given-names>G</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Ghadirian</surname><given-names>P</given-names></name><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Vesprini</surname><given-names>D</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Hamel</surname><given-names>N</given-names></name><xref ref-type="aff" rid="aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Paradis</surname><given-names>A-J</given-names></name><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Lal</surname><given-names>G</given-names></name><xref ref-type="aff" rid="aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Gallinger</surname><given-names>S</given-names></name><xref ref-type="aff" rid="aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Narod</surname><given-names>S A</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Foulkes</surname><given-names>W D</given-names></name><xref ref-type="aff" rid="aff3">3</xref></contrib></contrib-group><aff id="aff1"><label>1</label>Centre for Research in Women's Health, Women's College Hospital, University of Toronto, Toronto, M5G 1N8, Canada</aff><aff id="aff2"><label>2</label>Centre de Recherche, Pavillon Hotel Dieu, CHUM, Montreal, Quebec, H2W 1T8, Canada</aff><aff id="aff3"><label>3</label>Department of Medicine, Montreal General Hospital Research Institute, McGill University, Montreal, Quebec, H3G 1A4, Canada</aff><aff id="aff4"><label>4</label>Samuel Lunenfeld Research Institute, Mount Sinai Hospital, University of Toronto, 600 University Avenue, Toronto, M5G 1X5, Canada</aff><pub-date pub-type="epub"><day>27</day><month>04</month><year>2000</year></pub-date><pub-date pub-type="ppub"><month>05</month><year>2000</year></pub-date><volume>82</volume><issue>10</issue><fpage>1646</fpage><lpage>1649</lpage><history><date date-type="received"><day>22</day><month>07</month><year>1999</year></date><date date-type="rev-recd"><day>22</day><month>11</month><year>1999</year></date><date date-type="accepted"><day>24</day><month>01</month><year>2000</year></date></history><copyright-statement>Copyright 2000, Cancer Research Campaign</copyright-statement><copyright-year>2000</copyright-year><permissions><copyright-holder>Cancer Research Campaign</copyright-holder></permissions><abstract><p>A prospective study of 149 unselected incident cases of pancreatic adenocarcinoma and 146 ethnically-matched controls found no associations between <italic>GSTM1</italic> (adjusted odds ratio (AOR) 1.14), <italic>GSTT1</italic> (AOR: 1.19) and <italic>CYP1A1</italic> (AOR: 1.08) polymorphisms and pancreatic cancer susceptibility. Smoking and drinking status did not affect results. These polymorphisms do not appear to be important gene modifiers in pancreatic cancer. &#x000a9; 2000 Cancer Research Campaign</p></abstract><kwd-group><kwd>pancreatic cancer</kwd><kwd>genetic susceptibility</kwd><kwd>cytochrome P450</kwd><kwd>glutathione S-transferase</kwd></kwd-group></article-meta></front></article>