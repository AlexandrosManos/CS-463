></name></person-group><article-title>Mechanisms of alternative pre-messenger RNA splicing</article-title><source>Annu. Rev. Biochem</source><year>2003</year><volume>72</volume><fpage>291</fpage><lpage>336</lpage><pub-id pub-id-type="pmid">12626338</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lewis</surname><given-names>JD</given-names></name><name><surname>Izaurralde</surname><given-names>E</given-names></name><name><surname>Jarmolowski</surname><given-names>A</given-names></name><name><surname>McGuigan</surname><given-names>C</given-names></name><name><surname>Mattaj</surname><given-names>IW</given-names></name></person-group><article-title>A nuclear cap-binding complex facilitates association of U1 snRNP with the cap-proximal 5&#x02032; splice site</article-title><source>Genes Dev</source><year>1996</year><volume>10</volume><fpage>1683</fpage><lpage>1698</lpage><pub-id pub-id-type="pmid">8682298</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Forch</surname><given-names>P</given-names></name><name><surname>Puig</surname><given-names>O</given-names></name><name><surname>Kedersha</surname><given-names>N</given-names></name><name><surname>Martinez</surname><given-names>C</given-names></name><name><surname>Granneman</surname><given-names>S</given-names></name><name><surname>Seraphin</surname><given-names>B</given-names></name><name><surname>Anderson</surname><given-names>P</given-names></name><name><surname>Valcarcel</surname><given-names>J</given-names></name></person-group><article-title>The apoptosis-promoting factor TIA-1 is a regulator of alternative pre-mRNA splicing</article-title><source>Mol. Cell</source><year>2000</year><volume>6</volume><fpage>1089</fpage><lpage>1098</lpage><pub-id pub-id-type="pmid">11106748</pub-id></elem