d-type="pmid">10993414</pub-id><pub-id pub-id-type="doi">10.1097/00005768-200009001-00003</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Puyau</surname><given-names>MR</given-names></name><name><surname>Adolph</surname><given-names>AL</given-names></name><name><surname>Vohra</surname><given-names>FA</given-names></name><name><surname>Butte</surname><given-names>NF</given-names></name></person-group><article-title>Validation and calibration of physical activity monitors in children</article-title><source>Obes Res</source><year>2002</year><volume>10</volume><fpage>150</fpage><lpage>157</lpage><pub-id pub-id-type="pmid">11886937</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Trost</surname><given-names>SG</given-names></name><name><surname>Pate</surname><given-names>RR</given-names></name><name><surname>Sallis</surname><given-names>JF</given-names></name><name><surname>Freedson</surname><given-names>PS</given-names></name><name><surname>Taylor</surname><given-names>WC</given-names></name><name><surname>Dowda</surname><given-names>M</given-names></name><etal></etal></person-group><article-title>Age and gender differences in objectively measured physical activity in youth</article-title><source>Med Sci Sports Exerc</source><year>2002</year><volume>34</volume><fpage>350</fpage><lpage>355</lpage><pub-id pub-id-type="pmid">11828247</pub-id><pub-id pub-id-type="doi">10.1097/00005768-200205001-01563</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Treuth</surname><given-names>MS</given-names></name><name><surname>Schmitz</surname><given-names>K</given-names></name><name><surname>Catellier</surname><given-names>DJ</given-names></name><name><surname>McMurray</surname><given-names>RG</given-names></name><name><surname>Murray</surname><give