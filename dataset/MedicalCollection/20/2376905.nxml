align="top" charoff="50">8</td><td align="center" valign="top" charoff="50">35</td><td align="center" valign="top" charoff="50">34</td><td align="center" valign="top" charoff="50">59</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Grade IV</td><td align="center" valign="top" charoff="50">25</td><td align="center" valign="top" charoff="50">13</td><td align="center" valign="top" charoff="50">12</td><td align="center" valign="top" charoff="50">13</td><td align="center" valign="top" charoff="50">12</td><td align="center" valign="top" charoff="50">40</td><td align="center" valign="top" charoff="50">44</td><td align="center" valign="top" charoff="50">50</td></tr><tr><td align="left" valign="top" charoff="50"><italic>Depth</italic></td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Intramuscular</td><td align="center" valign="top" charoff="50">15</td><td align="center" valign="top" charoff="50">10</td><td align="center" valign="top" charoff="50">5</td><td align="center" valign="top" charoff="50">9</td><td align="center" valign="top" charoff="50">6</td><td align="center" valign="top" charoff="50">32</td><td align="center" valign="top" charoff="50">32</td><td align="center" valign="top" charoff="50">43</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Subcutaneous</td><td align="center" valign="top" charoff="50">9</td><td align="center" valign="top" charoff="50">2</td><td align="center" valign="top" charoff="50">7</td><td align="center" valign="top" charoff="50">0</t