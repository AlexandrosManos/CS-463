eft">70&#x02013;74</td><td align="left">14.9%</td><td align="left">23.8%</td><td></td><td></td></tr><tr><td></td><td></td><td></td><td align="left">75&#x02013;79</td><td align="left">21.7%</td><td align="left">29.2%</td><td></td><td></td></tr><tr><td></td><td></td><td></td><td align="left">80&#x02013;84</td><td align="left">27.5%</td><td align="left">35.2%</td><td></td><td></td></tr><tr><td></td><td></td><td></td><td align="left">85&#x02013;89</td><td align="left">32.8%</td><td align="left">41.9%</td><td></td><td></td></tr><tr><td></td><td></td><td></td><td align="left">90&#x02013;94</td><td align="left">40.5%</td><td align="left">47.3%</td><td></td><td></td></tr><tr><td></td><td></td><td></td><td align="left">95+</td><td align="left">37.8%</td><td align="left">50.7%</td><td></td><td></td></tr><tr><td><hr></hr></td><td><hr></hr></td><td><hr></hr></td><td colspan="3"><hr></hr></td><td colspan="2"><hr></hr></td></tr><tr><td align="left">Hemmelgarn et al. [24] 2006</td><td align="left">Canada</td><td align="left">Participants from community-dwelling elderly in Calgary Health region, cohort study, N = 10184, response NR, aged &#x02265; 66 yrs., 42.6% males.</td><td align="left">Overall: 35.4%<break/>Men: 32%, Women: 38.2%</td><td></td><td></td><td align="left">NR</td><td></td></tr><tr><td><hr></hr></td><td><hr></hr></td><td><hr></hr></td><td colspan="3"><hr></hr></td><td colspan="2"><hr></hr></td></tr><tr><td align="left">Kramer et al. [25] 2005</td><td align="left">USA</td><td align="left">Participants of the Dallas Heart Study, cross-sectional survey, N = 2660, response NR, aged 30&#x02013;65 yrs.(mean age: 43.9 yrs.), 49.5% males.</td><td align="left">Overall: 1.5%</td><td></td><td></td><td align="left">NR</td><td></td></tr><tr><td><hr></hr></td><td><hr></hr></td><td><hr></hr></td><td colspan="3"><hr></hr></td><td colspan="2"><hr></hr></td></tr><tr><td align="left">Manjunath et al. [26] 2003</td><td align="left">USA</td><td align="left">Participants of the Cardiovasc