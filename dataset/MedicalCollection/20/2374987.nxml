="pmid">14660792</pub-id><pub-id pub-id-type="doi">10.1073/pnas.2536672100</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ochman</surname><given-names>H</given-names></name><name><surname>Liu</surname><given-names>R</given-names></name><name><surname>Rocha</surname><given-names>EP</given-names></name></person-group><article-title>Erosion of interaction networks in reduced and degraded genomes.</article-title><source>J Exp Zoolog B Mol Dev Evol</source><year>2007</year><volume>308</volume><fpage>97</fpage><lpage>103</lpage><pub-id pub-id-type="pmid">17219366</pub-id><pub-id pub-id-type="doi">10.1002/jez.b.21147</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arifuzzaman</surname><given-names>M</given-names></name><name><surname>Maeda</surname><given-names>M</given-names></name><name><surname>Itoh</surname><given-names>A</given-names></name><name><surname>Nishikata</surname><given-names>K</given-names></name><name><surname>Takita</surname><given-names>C</given-names></name><name><surname>Saito</surname><given-names>R</given-names></name><name><surname>Ara</surname><given-names>T</given-names></name><name><surname>Nakahigashi</surname><given-names>K</given-names></name><name><surname>Huang</surname><given-names>HC</given-names></name><name><surname>Hirai</surname><given-names>A</given-names></name><etal></etal></person-group><article-title>Large-scale identification of protein-protein interaction of <italic>Escherichia coli </italic>K-12.</article-title><source>Genome Res</source><year>2006</year><volume>16</volume><fpage>686</fpage><lpage>691</lpage><pub-id pub-id-type="pmid">16606699</pub-id><pub-id pub-id-type="doi">10.1101/gr.4527806</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Butland</surname><given-names>G</given-names></name><name><surname>Peregr&#x000ed;n-Alvarez</surname><given-names>JM</given-names></name><name><surname>Li</surname><given-names>J</given-names></name><name><surname>Yang</surname><given-names>W</given-names></name><name><surname>Yang</surname><given-names>X</given-names></name><name><surname>Canadien</surname><given-names>V</given-names></name><name><surname>Starostine</surname><given-names>A</given-names></name><name><surname>Richards</surname><given-names>D</given-names></name><name><surname>Beattie</surname><given-names>B</given-names></name><name><surname>Krogan</surname><given-names>N</given-names></name><etal></etal></person-group><article-title>Interaction network containing conserved and essential protein complexes in <italic>Escherichia coli</italic>.</article-title><source>Nature</source><year>2005</year><volume>433</volume><fpage>531</fpage><lpage>537</lpage><pub-id pub-id-type="pmid">15690043</pub-id><pub-id pub-id-type="doi">10.1038/nature03239</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ragan</surname><given-names>MA</given-names></name></person-group><article-title>On surrogate methods for detecting lateral gene transfer.</article-title><source>FEMS Microbiol Lett</source><year>2001</year><volume>201</volume><fpage>187</fpage><lpage>191</lpage><pub-id pub-id-type="pmid">11470360</pub-id><pub-id pub-id-type="doi">10.1111/j.1574-6968.2001.tb10755.x</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ragan</surname><given-names>MA</given-names></name><name><surname>Harlow</surname><given-names>TJ</given-names></name><name><surname>Beiko</surname><given-names>RG</given-names></name></person-group><article-title>Do different surrogate methods detect lateral genetic transfer events of different relative ages?</article-title><source>Trends Microbiol</source><year>2006</year><volume>14</volume><fpage>4</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">16356716</pub-id><pub-id pub-id-type="doi">10.1016/j.tim.2005.11.004</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Beiko</surname><given-names>RG</given-names></name><name><surname>Harlow</surname><given-names>TJ</given-names></name><name><surname>Ragan</surname><given-names>MA</given-names></name></person-group><article-title>Highways of gene sharing in prokaryotes.</article-title><source>Proc Natl Acad Sci USA</source><year>2005</year><volume>102</volume><fpage>14332</fpage><lpage>14337</lpage><pub-id pub-id-type="pmid">16176988</pub-id><pub-id pub-id-type="doi">10.1073/pnas.0504068102</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lawrence</surname><given-names>JG</given-names></name><name><surname>Ochman</surname><given-names>H</given-names></name></person-group><article-title>Amelioration of bacterial genomes: rates of change and exchange.</article-title><source>J Mol Evol</source><year>1997</year><volume>44</volume><fpage>383</fpage><lpage>397</lpage><pub-id pub-id-type="pmid">9089078</pub-id><pub-id pub-id-type="doi">10.1007/PL00006158</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clarke</surname><given-names>GD</given-names></name><name><surname>Beiko</surname><given-names>RG</given-names></name><name><surname>Ragan</surname><given-names>MA</given-names></name><name><surname>Charlebois</surname><given-names>RL</given-names></name></person-group><article-title>Inferring genome trees by using a filter to eliminate phylogenetically discordant sequences and a distance matrix based on mean normalized BLASTP scores.</article-title><source>J Bacteriol</source><year>2002</year><volume>184</volume><fpage>2072</fpage><lpage>2080</lpage><pub-id pub-id-type="pmid">11914337</pub-id><pub-id pub-id-type="doi">10.1128/JB.184.8.2072-2080.2002</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gophna</surname><given-names>U</given-names></name><name><surname>Doolittle</surname><given-names>WF</given-names></name><name><surname>Charlebois</surname><given-names>RL</given-names></name></person-group><article-title>Weighted genome trees: refinements and applications.</article-title><source>J Bacteriol</source><year>2005</year><volume>187</volume><fpage>1305</fpage><lpage>1316</lpage><pub-id pub-id-type="pmid">15687194</pub-id><pub-id pub-id-type="doi">10.1128/JB.187.4.1305-1316.2005</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lawrence</surname><given-names>JG</given-names></name><name><surname>Roth</surname><given-names>JR</given-names></name></person-group><article-title>Selfish operons: horizontal transfer may drive the evolution of gene clusters.</article-title><source>Genetics</source><year>1996</year><volume>143</volume><fpage>1843</fpage><lpage>1860</lpage><pub-id pub-id-type="pmid">8844169</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gophna</surname><given-names>U</given-names></name><name><surname>Ron</surname><given-names>EZ</given-names></name><name><surname>Graur</surname><given-names>D</given-names></name></person-group><article-title>Bacterial type III secretion systems are ancient and evolved by multiple horizontal-transfer events.</article-title><source>Gene</source><year>2003</year><volume>312</volume><fpage>151</fpage><lpage>163</lpage><pub-id pub-id-type="pmid">12909351</pub-id><pub-id pub-id-type="doi">10.1016/S0378-1119(03)00612-7</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nakamura</surname><given-names>Y</given-names></name><name><surname>Itoh</surname><given-names>T</given-names></name><name><surname>Matsuda</surname><given-names>H</given-names></name><name><surname>Gojobori</surname><given-names>T</given-names></name></person-group><article-title>Biased biological functions of horizontally transferred genes in prokaryotic genomes.</article-title><source>Nat Genet</source><year>2004</year><volume>36</volume><fpage>760</fpage><lpage>766</lpage><pub-id pub-id-type="pmid">15208628</pub-id><pub-id pub-id-type="doi">10.1038/ng1381</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Daubin</surname><given-names>V</given-names></name><name><surname>Ochman</surname><given-names>H</given-names></name></person-group><article-title>Bacterial genomes as new gene homes: the genealogy of ORFans in <italic>E. coli</italic>.</article-title><source>Genome Res</source><year>2004</year><volume>14</volume><fpage>1036</fpage><lpage>1042</lpage><pub-id pub-id-type="pmid">15173110</pub-id><pub-id pub-id-type="doi">10.1101/gr.2231904</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Itaya</surname><given-names>M</given-names></name><name><surname>Tsuge</surname><given-names>K</given-names></name><name><surname>Koizumi</surname><given-names>M</given-names></name><name><surname>Fujita</surname><given-names>K</given-names></name></person-group><article-title>Combining two genomes in one cell: stable cloning of the Synechocystis PCC6803 genome in the <italic>Bacillus subtilis </italic>168 genome.</article-title><source>Proc Natl Acad Sci USA</source><year>2005</year><volume>102</volume><fpage>15971</fpage><lpage>15976</lpage><pub-id pub-id-type="pmid">16236728</pub-id><pub-id pub-id-type="doi">10.1073/pnas.0503868102</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gogarten</surname><given-names>JP</given-names></name><name><surname>Doolittle</surname><given-names>WF</given-names></name><name><surname>Lawrence</surname><given-names>JG</given-names></name></person-group><article-title>Prokaryotic evolution in light of gene transfer.</article-title><source>Mol Biol Evol</source><year>2002</year><volume>19</volume><fpage>2226</fpage><lpage>2238</lpage><pub-id pub-id-type="pmid">12446813</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lerat</surname><given-names>E</given-names></name><name><surname>Daubin</surname><given-names>V</given-names></name><name><surname>Moran</surname><given-names>NA</given-names></name></person-group><article-title>From gene trees to organismal phylogeny in prokaryotes: the case of the gamma-Proteobacteria.</article-title><source>PLoS Biol</source><year>2003</year><volume>1</volume><fpage>E19</fpage><pub-id pub-id-type="pmid">12975657</pub-id><pub-id pub-id-type="doi">10.1371/journal.pbio.0000019</pub-id></citation></ref><ref id="B24"><citation citation-type="other"><article-title>EMU</article-title><ext-link ext-link-type="uri" xlink:href="http://emu.imb.uq.edu.au"/></citation></ref><ref id="B25"><citation citation-type="other"><article-title>PEC</article-title><ext-link ext-link-type="uri" xlink:href="http://shigen.lab.nig.ac.jp/ecoli/pec/index.jsp"/></citation></ref></ref-list></back></article>