pe="journal"><person-group person-group-type="author"><name><surname>Kleinsorge</surname><given-names>T.</given-names></name><name><surname>Heuer</surname><given-names>H</given-names></name><name><surname>Schmidtke</surname><given-names>V.</given-names></name></person-group><article-title>Assembling a task space: global determination of local shift costs</article-title><source>Psychological Research</source><year>2004</year><volume>68</volume><fpage>31</fpage><lpage>40</lpage><pub-id pub-id-type="doi">10.1007/s00426-003-0134-9</pub-id></citation><citation citation-type="display-unstructured">Kleinsorge, T., Heuer, H., &#x00026; Schmidtke, V. (2004). Assembling a task space: global determination of local shift costs. Psychological Research, 68, 31&#x02013;40. <pub-id pub-id-type="pmid">12774231</pub-id></citation></ref><ref id="CR8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koch</surname><given-names>I.</given-names></name><name><surname>Prinz</surname><given-names>W.</given-names></name><name><surname>Allport</surname><given-names>A.</given-names></name></person-group><article-title>Involuntary retrieval in alphabet-arithmetic tasks: Task-mixing and task-switching costs</article-title><source>Psychological Research</source><year>2005</year><volume>69</volume><fpage>252</fpage><lpage>261</lpage><pub-id pub-id-type="doi">10.1007/s00426-004-0180-y</pub-id></citation><citation citation-type="display-unstructured">Koch I., Prinz, W., &#x00026; Allport, A. (2005). Involuntary retrieval in alphabet-arithmetic tasks: Task-mixing and task-switching costs. Psychological Research, 69, 252&#x02013;261. <pub-id pub-id-type="pmid">15750868</pub-id></citation></ref><ref id="CR9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koch</surname><given-names>I.</given-names></name><name><surname>Ruge</surname><given-names>H.</given-names></name><name><surname>Brass</surname><given-names>M.</given-n