><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schuller</surname><given-names>D</given-names></name><name><surname>Schuster</surname><given-names>DP</given-names></name></person-group><article-title>Fluid-management strategies in acute lung injury</article-title><source>N Engl J Med</source><year>2006</year><volume>355</volume><fpage>1175</fpage><pub-id pub-id-type="pmid">16971727</pub-id><pub-id pub-id-type="doi">10.1056/NEJMc061857</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tornero-Campello</surname><given-names>G</given-names></name></person-group><article-title>Catheters and the treatment of acute lung injury</article-title><source>N Engl J Med</source><year>2006</year><volume>355</volume><fpage>957</fpage><lpage>958</lpage><pub-id pub-id-type="pmid">16948187</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rivers</surname><given-names>E</given-names></name><name><surname>Nguyen</surname><given-names>B</given-names></name><name><surname>Havstad</surname><given-names>S</given-names></name><name><surname>Ressler</surname><given-names>J</given-names></name><name><surname>Muzzin</surname><given-names>A</given-names></name><name><surname>Knoblich</surname><given-names>B</given-names></name><name><surname>Peterson</surname><given-names>E</given-names></name><name><surname>Tomlanovich</surname><given-names>M</given-names></name></person-group><article-title>Early goal-directed therapy in the treatment of severe sepsis and septic shock</article-title><source>N Engl J Med</source><year>2001</year><volume>345</volume><fpage>1368</fpage><lpage>1377</lpage><pub-id pub-id-type="pmid">11794169</pub-id><pub-id pub-id-type="doi">10.1056/NEJMoa010307</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wiener</surname><given-names>RS</given-names></name><name><surname>Welch</surname><given-names>HG</given-names></name></person-group><article-title>Trends in the use of the pulmonary artery catheter in the United States, 1993&#x02013;2004</article-title><source>JAMA</source><year>2007</year><volume>298</volume><fpage>423</fpage><lpage>429</lpage><pub-id pub-id-type="pmid">17652296</pub-id><pub-id pub-id-type="doi">10.1001/jama.298.4.423</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rubenfeld</surname><given-names>GD</given-names></name><name><surname>McNamara-Aslin</surname><given-names>E</given-names></name><name><surname>Rubinson</surname><given-names>L</given-names></name></person-group><article-title>The pulmonary artery catheter, 1967&#x02013;2007: rest in peace?</article-title><source>JAMA</source><year>2007</year><volume>298</volume><fpage>458</fpage><lpage>461</lpage><pub-id pub-id-type="pmid">17652302</pub-id><pub-id pub-id-type="doi">10.1001/jama.298.4.458</pub-id></citation></ref></ref-list></back></article>