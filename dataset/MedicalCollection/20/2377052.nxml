n="center" valign="top" charoff="50">&#x000a0;</td><td align="right" valign="top" charoff="50">&#x000a0;</td><td align="right" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50"><bold><italic>0.34</italic></bold></td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="right" valign="top" charoff="50">&#x000a0;</td><td align="right" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50"><bold>0.02</bold></td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="right" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50"><bold>0.03</bold></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x02a7d;60</td><td align="center" valign="top" charoff="50">575 (60)</td><td align="right" valign="top" charoff="50">58</td><td align="right" valign="top" charoff="50">(10)</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">134</td><td align="right" valign="top" charoff="50">4</td><td align="right" valign="top" charoff="50">(3)</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">238 (72)</td><td align="center" valign="top" charoff="50">73</td><td align="right" valign="top" charoff="50">(31)</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;&#x0003e;60</td><td align="center" valign="top" charoff="50">375 (40)</td><td align="right" valign="top" charoff="50">34</td><td align="right" valign="top" charoff="50">(9)</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">175</td><td align="right" valign="top" charoff="50">16</td><td align="right" valign="top" charoff="50">(9)</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top