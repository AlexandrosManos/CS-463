ok"><person-group person-group-type="author"><name><surname>Clayman</surname><given-names>GL</given-names></name><name><surname>Lippman</surname><given-names>SM</given-names></name><name><surname>Laramore</surname><given-names>GE</given-names></name><name><surname>Hong</surname><given-names>WK</given-names></name></person-group><article-title>Head and neck cancer</article-title><source>Cancer Medicine</source><year>1996</year><publisher-name>Philadelphia: Williams and Wilkins</publisher-name><fpage>1645</fpage><lpage>1709</lpage>Holland JF, Frei E, Bast RC, Kufe DW, Morton DL, Weichselbaum R (eds) pp</citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Colomer</surname><given-names>R</given-names></name><name><surname>Shamon</surname><given-names>LA</given-names></name><name><surname>Tsai</surname><given-names>MS</given-names></name><name><surname>Lupu</surname><given-names>R</given-names></name></person-group><article-title>Herceptin: from the bench to the clinic</article-title><source>Cancer Invest</source><year>2001</year><volume>19</volume><fpage>49</fpage><lpage>56</lpage><!--PubMed citation query: 'Cancer Invest||19|49||bib6|'--><pub-id pub-id-type="pmid">11291556</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Contreras</surname><given-names>DN</given-names></name><name><surname>Cobos</surname><given-names>E</given-names></name><name><surname>Lox</surname><given-names>CD</given-names></name></person-group><article-title>Evaluation of the circulating fraction of the HER-2&#x0002f;neu oncogene in patients with cervical cancer</article-title><source>Eur J Gynaecol Oncol</source><year>2002</year><volume>23</volume><fpage>491</fpage><lpage>495</lpage><!--PubMed citation query: 'Eur J Gynaecol Oncol||23|491||bib7|'--><pub-id pub-id-type="pmid">12556089</pub-id></citation></ref><ref id="bib8"><citation citation-type="b