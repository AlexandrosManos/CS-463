source>Health Policy</source><year>2007</year><volume>80</volume><fpage>402</fpage><lpage>412</lpage><pub-id pub-id-type="pmid">16730848</pub-id><pub-id pub-id-type="doi">10.1016/j.healthpol.2006.04.002</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Andersson</surname><given-names>K</given-names></name><name><surname>Bergstr&#x000f6;m</surname><given-names>G</given-names></name><name><surname>Petzold</surname><given-names>MG</given-names></name><name><surname>Carlsten</surname><given-names>A</given-names></name></person-group><article-title>Impact of a generic substitution reform on patients' and society's expenditure for pharmaceuticals</article-title><source>Health Policy</source><year>2007</year><volume>81</volume><fpage>376</fpage><lpage>384</lpage><pub-id pub-id-type="pmid">16945449</pub-id><pub-id pub-id-type="doi">10.1016/j.healthpol.2006.07.005</pub-id></citation></ref><ref id="B21"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Tan</surname><given-names>LT</given-names></name><name><surname>Hong</surname><given-names>YC</given-names></name><name><surname>Hsieh</surname><given-names>CR</given-names></name></person-group><article-title>An exploration of pharmaceutical profit for health care providers</article-title><source>Proceedings of the 2005 IEAS Working Paper: May 2005; Taipei</source><year>2005</year></citation></ref></ref-list></back></article>