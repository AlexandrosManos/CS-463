                                    <mml:mo>&#x02212;</mml:mo>                                          <mml:msub>                                             <mml:mi mathvariant="script">G</mml:mi>                                             <mml:mi>d</mml:mi>                                          </mml:msub>                                          <mml:msub>                                             <mml:mi>D</mml:mi>                                             <mml:mi>m</mml:mi>                                          </mml:msub>                                          <mml:mo>&#x02261;</mml:mo>                                          <mml:msub>                                             <mml:mi mathvariant="script">V</mml:mi>                                             <mml:mrow>                                                <mml:mi>d</mml:mi>                                                <mml:mi>m</mml:mi>                                             </mml:mrow>                                          </mml:msub>                                          <mml:mo>+</mml:mo>                                          <mml:msub>                                             <mml:mtext mathvariant="script">P</mml:mtext>                                             <mml:mrow>                                                <mml:mi>d</mml:mi>                                                <mml:mi>m</mml:mi>                                             </mml:mrow>                                          </mml:msub>                                       </mml:mrow>                                    </mml:mtd>                                 </mml:mtr>                              </mml:mtable>                           </mml:mrow>                                                   </mml:semantics>                     </mml:math></disp-formula></p><p><disp-formula id="bmcM14"><label>(14)</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M22" name=