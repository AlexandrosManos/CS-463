           <mml:mn>5</mml:mn>                                                   </mml:msup>                                                </mml:mrow>                                             </mml:mfrac>                                          </mml:mrow>                                          <mml:mo>)</mml:mo>                                       </mml:mrow>                                       <mml:mo>&#x02261;</mml:mo>                                       <mml:msub>                                          <mml:mi mathvariant="script">V</mml:mi>                                          <mml:mi>p</mml:mi>                                       </mml:msub>                                    </mml:mrow>                                 </mml:mtd>                              </mml:mtr>                           </mml:mtable>                        </mml:mrow>                                             </mml:semantics>                  </mml:math></disp-formula></p><p><disp-formula id="bmcM3"><label>(3)</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M7" name="1752-0509-2-28-i5" overflow="scroll">                     <mml:semantics>                        <mml:mrow>                           <mml:mtable>                              <mml:mtr>                                 <mml:mtd>                                    <mml:mrow>                                       <mml:mo>&#x02212;</mml:mo>                                       <mml:mtext>RNA</mml:mtext>                                    </mml:mrow>                                 </mml:mtd>                                 <mml:mtd>                                    <mml:mrow>                                       <mml:mfrac>                                          <mml:mrow>                                             <mml:mi>d</mml:mi>                                             <mml:mi>M</mml:mi>                                          </mml:mrow>                                