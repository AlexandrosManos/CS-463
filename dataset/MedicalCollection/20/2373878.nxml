         <mml:msup>                                             <mml:mi>P</mml:mi>                                             <mml:mn>5</mml:mn>                                          </mml:msup>                                       </mml:mrow>                                    </mml:mfrac>                                 </mml:mrow>                              </mml:mtd>                           </mml:mtr>                           <mml:mtr>                              <mml:mtd>                                 <mml:mrow>                                    <mml:mo>&#x02212;</mml:mo>                                    <mml:mfrac>                                       <mml:mrow>                                          <mml:msub>                                             <mml:mi>b</mml:mi>                                             <mml:mn>2</mml:mn>                                          </mml:msub>                                          <mml:msub>                                             <mml:mi>R</mml:mi>                                             <mml:mi>m</mml:mi>                                          </mml:msub>                                          <mml:mi>P</mml:mi>                                       </mml:mrow>                                       <mml:mrow>                                          <mml:mi>P</mml:mi>                                          <mml:mo>+</mml:mo>                                          <mml:msub>                                             <mml:mi>k</mml:mi>                                             <mml:mrow>                                                <mml:mi>r</mml:mi>                                                <mml:mi>i</mml:mi>                                             </mml:mrow>                                          </mml:msub>                                       </mml:mrow>                                    </mml:mfrac>                                    <mml:mo>&#x02212;</mml:mo>                                    <mml:msub>                                       <mml:mi mathvariant="script">G</mml:mi>                                       <mml:mrow>                                          <mml:mi>p</mml:mi>                                          <mml:mo>,</mml:mo>                                          <mml:mi>m</mml:mi>                                       </mml:mrow>                                    </mml:msub>                                    <mml:mi>P</mml:mi>                                    <mml:mo>&#x02212;</mml:mo>                                    <mml:mfrac>                                       <mml:mrow>                                          <mml:msub>                                             <mml:mi>b</mml:mi>                                             <mml:mn>2</mml:mn>                                          </mml:msub>                                          <mml:msub>                                             <mml:mi>R</mml:mi>                                             <mml:mrow>                                                <mml:mi>s</mml:mi>                                                <mml:mi>m</mml:mi>                                             </mml:mrow>                                          </mml:msub>                                          <mml:mi>P</mml:mi>                                       </mml:mrow>                                       <mml:mrow>                                          <mml:mi>P</mml:mi>                                          <mml:mo>+</mml:mo>                                          <mml:msub>                                             <mml:mi>k</mml:mi>                                             <mml:mrow>                                                <mml:mi>r</mml:mi>                                                <mml:mi>i</mml:mi>                                             </mml:mrow>                                          </mml:msub> 