lic>Drosophila</italic>.</article-title><source>Curr Biol</source><volume>16</volume><fpage>1835</fpage><lpage>1843</lpage><pub-id pub-id-type="pmid">16979562</pub-id></citation></ref><ref id="pone.0002110-Prokop1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Prokop</surname><given-names>A</given-names></name><name><surname>Meinertzhagen</surname><given-names>IA</given-names></name></person-group><year>2006</year><article-title>Development and structure of synaptic contacts in Drosophila.</article-title><source>Semin Cell Dev Biol</source><volume>17</volume><fpage>20</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">16384719</pub-id></citation></ref><ref id="pone.0002110-Jrvilehto1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>J&#x000e4;rvilehto</surname><given-names>M</given-names></name><name><surname>Zettler</surname><given-names>F</given-names></name></person-group><year>1973</year><article-title>Electrophysiological-histological studies on some functional properties of visual cells and second order neurons of an insect retina.</article-title><source>Z Zellforsch Mikrosk Anat</source><volume>136</volume><fpage>291</fpage><lpage>306</lpage><pub-id pub-id-type="pmid">4685231</pub-id></citation></ref><ref id="pone.0002110-Shaw1"><label>23</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Shaw</surname><given-names>SR</given-names></name></person-group><year>1981</year><article-title>Anatomy and physiology of identified non-spiking cells in the phtoreceptor-lamina complex of the compound eye of insects, especially Diptera.</article-title><person-group person-group-type="editor"><name><surname>Roberts</surname><given-names>A</given-names></name><name><surname>Bush</surname><given-names>BMH</given-names></name></person-group><source>Neurones without Impulses</source><publisher-loc>Cambridge</publisher-