<pub-id pub-id-type="pmid">15788746</pub-id><pub-id pub-id-type="doi">10.1093/nar/gki316</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rogozin</surname><given-names>I</given-names></name><name><surname>Sverdlov</surname><given-names>A</given-names></name><name><surname>Babenko</surname><given-names>V</given-names></name><name><surname>Koonin</surname><given-names>E</given-names></name></person-group><article-title>Analysis of evolution of exon-intron structure of eukaryotic genes.</article-title><source>Brief Bioinform</source><year>2005</year><volume>6</volume><fpage>118</fpage><lpage>134</lpage><pub-id pub-id-type="pmid">15975222</pub-id><pub-id pub-id-type="doi">10.1093/bib/6.2.118</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yoshihama</surname><given-names>M</given-names></name><name><surname>Nakao</surname><given-names>A</given-names></name><name><surname>Nguyen</surname><given-names>HD</given-names></name><name><surname>Kenmochi</surname><given-names>N</given-names></name></person-group><article-title>Analysis of ribosomal protein gene structures: implications for intron evolution.</article-title><source>PLoS Genet</source><year>2006</year><volume>2</volume><fpage>e25</fpage><pub-id pub-id-type="pmid">16518464</pub-id><pub-id pub-id-type="doi">10.1371/journal.pgen.0020025</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nguyen</surname><given-names>H</given-names></name><name><surname>Yoshihama</surname><given-names>M</given-names></name><name><surname>Kenmochi</surname><given-names>N</given-names></name></person-group><article-title>New maximum likelihood estimators for eukaryotic intron evolution.</article-title><source>PLoS Comput Biol</source><year>2005</year><volume>1</volume><fpage>e79</fpage><pub-id pub-id-type