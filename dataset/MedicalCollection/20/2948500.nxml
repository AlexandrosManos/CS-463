rname><given-names>CR</given-names></name><name><surname>Gunshin</surname><given-names>H</given-names></name><name><surname>Rogers</surname><given-names>JT</given-names></name><name><surname>Huang</surname><given-names>X</given-names></name></person-group><year>2008</year><article-title>A review of independent component analysis application to microarray gene expression data.</article-title><source>Biotechniques</source><volume>45</volume><fpage>501</fpage><lpage>520</lpage><pub-id pub-id-type="pmid">19007336</pub-id></mixed-citation></ref><ref id="pone.0013091-Lutter1"><label>10</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lutter</surname><given-names>D</given-names></name><name><surname>Langmann</surname><given-names>T</given-names></name><name><surname>Ugocsai</surname><given-names>P</given-names></name><name><surname>Moehle</surname><given-names>C</given-names></name><name><surname>Seibold</surname><given-names>E</given-names></name><etal/></person-group><year>2009</year><article-title>Analyzing time-dependent microarray data using independent component analysis derived expression modes from human macrophages infected with F. tularensis holartica.</article-title><source>J Biomed Inform</source><volume>42</volume><fpage>605</fpage><lpage>611</lpage><pub-id pub-id-type="pmid">19535009</pub-id></mixed-citation></ref><ref id="pone.0013091-Ostrowski2"><label>11</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ostrowski</surname><given-names>J</given-names></name><name><surname>Mikula</surname><given-names>M</given-names></name><name><surname>Karczmarski</surname><given-names>J</given-names></name><name><surname>Rubel</surname><given-names>T</given-names></name><name><surname>Wyrwicz</surname><given-names>LS</given-names></name><etal/></person-group><year>2007</year><article-title>Molecular defense mechanisms of Barrett's metaplasia estimated by an integrative genomics.</article-title><source>J Mol Med</source><volume>85</volume><fpage>733</fpage><lpage>743</lpage><pub-id pub-id-type="pmid">17415542</pub-id></mixed-citation></ref><ref id="pone.0013091-Ostrowski3"><label>12</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ostrowski</surname><given-names>J</given-names></name><name><surname>Rubel</surname><given-names>T</given-names></name><name><surname>Wyrwicz</surname><given-names>LS</given-names></name><name><surname>Mikula</surname><given-names>M</given-names></name><name><surname>Bielasik</surname><given-names>A</given-names></name><etal/></person-group><year>2006</year><article-title>Three clinical variants of gastroesophageal reflux disease form two distinct gene expression signatures.</article-title><source>J Mol Med</source><volume>84</volume><fpage>872</fpage><lpage>882</lpage><pub-id pub-id-type="pmid">16924468</pub-id></mixed-citation></ref><ref id="pone.0013091-Peano1"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Peano</surname><given-names>C</given-names></name><name><surname>Severgnini</surname><given-names>M</given-names></name><name><surname>Cifola</surname><given-names>I</given-names></name><name><surname>De Bellis</surname><given-names>G</given-names></name><name><surname>Battaglia</surname><given-names>C</given-names></name></person-group><year>2006</year><article-title>Transcriptome amplification methods in gene expression profiling.</article-title><source>Expert Rev Mol Diagn</source><volume>6</volume><fpage>465</fpage><lpage>480</lpage><pub-id pub-id-type="pmid">16706747</pub-id></mixed-citation></ref><ref id="pone.0013091-SabatesBellver1"><label>14</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sabates-Bellver</surname><given-names>J</given-names></name><name><surname>Van der Flier</surname><given-names>LG<