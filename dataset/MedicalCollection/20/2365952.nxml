8</lpage><pub-id pub-id-type="pmid">16985007</pub-id></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Oppenheim</surname><given-names>AV</given-names></name><name><surname>Schafer</surname><given-names>RW</given-names></name></person-group><source>Discrete-time signal processing</source><year>1999</year><edition>2</edition><publisher-name>New Jersey: Prentice-Hall</publisher-name></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Shanmugan</surname><given-names>KS</given-names></name><name><surname>Breipohl</surname><given-names>AM</given-names></name></person-group><source>Random signals: detection, estimation and data analysis</source><year>1988</year><edition>1</edition><publisher-name>New York:John Wiley &#x00026; Sons</publisher-name></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gerr</surname><given-names>NL</given-names></name><name><surname>Allen</surname><given-names>JC</given-names></name></person-group><article-title>The Generalized Spectrum and Spectral Coherence of a Harmonizable Time Series</article-title><source>Digital Signal Processing</source><year>1994</year><volume>4</volume><fpage>222</fpage><lpage>238</lpage><pub-id pub-id-type="doi">10.1006/dspr.1994.1022</pub-id></citation></ref><ref id="B15"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Black</surname><given-names>TR</given-names></name><name><surname>Donohue</surname><given-names>KD</given-names></name></person-group><article-title>Pitch determination of music signals using the generalized spectrum</article-title><source>Proceedings of the IEEE Southeastcon: 7&#x02013;9 April 2000; Nashville</source><year>2000</year><fpage>104</fpage><lpage>10</lpage></citation></ref><ref id="B16"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>L</given-names></name><name><surname>Donohue</surname><given-names>KD</given-names></name></person-group><article-title>Frequency correlation analysis for periodic echoes</article-title><source>Proceedings of the IEEE Southeastcon: 7&#x02013;9 April 2000; Nashville</source><year>2000</year><fpage>131</fpage><lpage>138</lpage></citation></ref><ref id="B17"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Medonza</surname><given-names>DC</given-names></name></person-group><article-title>Automatic Detection of Sleep and Wake Sates in Mice using Piezoelectric Sensors</article-title><source>MS thesis University of Kentucky</source><year>2005</year></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Franken</surname><given-names>P</given-names></name><name><surname>Malafosse</surname><given-names>A</given-names></name><name><surname>Tafti</surname><given-names>M</given-names></name></person-group><article-title>Genetic determinants of sleep regulation in inbred mice</article-title><source>Sleep</source><year>1999</year><volume>22</volume><fpage>155</fpage><lpage>169</lpage><pub-id pub-id-type="pmid">10201060</pub-id></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Orem</surname><given-names>J</given-names></name><name><surname>Kubin</surname><given-names>L</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Kryger MH, Roth, Dement WC</surname></name></person-group><article-title>Respiratory Physiology: Central Neural Control</article-title><source>Principles and Practice of Sleep Medicine</source><year>2000</year><publisher-name>Philadelphia: Saunders</publisher-name><fpage>212</fpage></citation></ref></ref-list></back></article>