"char" valign="top" char="&#x02013;" charoff="50">0.5&#x02013;2.2</td><td align="char" valign="top" char="." charoff="50">8</td><td align="char" valign="top" char="." charoff="50">0.8</td><td align="char" valign="top" char="&#x02013;" charoff="50">0.3&#x02013;1.5</td><td align="char" valign="top" char="." charoff="50">16</td><td align="char" valign="top" char="." charoff="50">0.9</td><td align="char" valign="top" char="&#x02013;" charoff="50">0.5&#x02013;1.5</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Total</td><td align="char" valign="top" char="." charoff="50">14</td><td align="char" valign="top" char="." charoff="50">0.9</td><td align="char" valign="top" char="&#x02013;" charoff="50">0.5&#x02013;1.6</td><td align="char" valign="top" char="." charoff="50">42</td><td align="char" valign="top" char="." charoff="50">1.2</td><td align="char" valign="top" char="&#x02013;" charoff="50">0.9&#x02013;1.6</td><td align="char" valign="top" char="." charoff="50">12</td><td align="char" valign="top" char="." charoff="50">0.8</td><td align="char" valign="top" char="&#x02013;" charoff="50">0.4&#x02013;1.4</td><td align="char" valign="top" char="." charoff="50">68</td><td align="char" valign="top" char="." charoff="50">1.1</td><td align="char" valign="top" char="&#x02013;" charoff="50">0.8&#x02013;1.3</td></tr><tr><td align="left" valign="top" charoff="50">Oesophagus</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="&#x02013;" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="&#x02013;" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="&#x02013;" charoff=