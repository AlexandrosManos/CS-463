ume><fpage>111</fpage><lpage>115</lpage><!--PubMed citation query: 'Urol Res||20|111||bib21|'--><pub-id pub-id-type="pmid">1553788</pub-id></citation></ref><ref id="bib22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Storm</surname><given-names>HH</given-names></name><name><surname>Michelsen</surname><given-names>EV</given-names></name><name><surname>Clemmensen</surname><given-names>IH</given-names></name><name><surname>Pihl</surname><given-names>J</given-names></name></person-group><article-title>The Danish Cancer Registry &#x02013; history, content, quality and use</article-title><source>Dan Med Bull</source><year>1997</year><volume>44</volume><fpage>535</fpage><lpage>539</lpage><!--PubMed citation query: 'Dan Med Bull||44|535||bib22|'--><pub-id pub-id-type="pmid">9408738</pub-id></citation></ref><ref id="bib23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>St&#x000fc;rmer</surname><given-names>T</given-names></name><name><surname>Glynn</surname><given-names>RJ</given-names></name><name><surname>Lee</surname><given-names>IM</given-names></name><name><surname>Manson</surname><given-names>JE</given-names></name><name><surname>Buring</surname><given-names>JE</given-names></name><name><surname>Hennekens</surname><given-names>CH</given-names></name></person-group><article-title>Aspirin use and colorectal cancer: post-trial follow-up data from the Physicians' Health Study</article-title><source>Ann Intern Med</source><year>1998</year><volume>128</volume><fpage>713</fpage><lpage>720</lpage><!--PubMed citation query: 'Ann Intern Med||128|713||bib23|'--><pub-id pub-id-type="pmid">9556464</pub-id></citation></ref><ref id="bib25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thun</surname><given-names>MJ</given-names></name><name><surname>Henley</surname><given-names>SJ</given-names></name><name><surname>Patrono</surname><given-names>C</given-n