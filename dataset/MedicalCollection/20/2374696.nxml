en-names>RD</given-names></name></person-group><article-title>Secretory pathway of trypanosomatid parasites.</article-title><source>Microbiol Mol Biol Rev</source><year>2002</year><volume>66</volume><fpage>122</fpage><lpage>154</lpage><pub-id pub-id-type="pmid">11875130</pub-id><pub-id pub-id-type="doi">10.1128/MMBR.66.1.122-154.2002</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vergnes</surname><given-names>B</given-names></name><name><surname>Sereno</surname><given-names>D</given-names></name><name><surname>Madjidian-Sereno</surname><given-names>N</given-names></name><name><surname>Lemesre</surname><given-names>JL</given-names></name><name><surname>Ouaissi</surname><given-names>A</given-names></name></person-group><article-title>Cytoplasmic SIR2 homologue overexpression promotes survival of Leishmania parasites by preventing programmed cell death.</article-title><source>Gene</source><year>2002</year><volume>296</volume><fpage>139</fpage><lpage>150</lpage><pub-id pub-id-type="pmid">12383511</pub-id><pub-id pub-id-type="doi">10.1016/S0378-1119(02)00842-9</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Descoteaux</surname><given-names>A</given-names></name><name><surname>Avila</surname><given-names>HA</given-names></name><name><surname>Zhang</surname><given-names>K</given-names></name><name><surname>Turco</surname><given-names>SJ</given-names></name><name><surname>Beverley</surname><given-names>SM</given-names></name></person-group><article-title>Leishmania LPG3 encodes a GRP94 homolog required for phosphoglycan synthesis implicated in parasite virulence but not viability.</article-title><source>EMBO J</source><year>2002</year><volume>21</volume><fpage>4458</fpage><lpage>4469</lpage><pub-id pub-id-type="pmid">12198148</pub-id><pub-id pub-id-type="doi">10.1093/emboj/cdf447</pub-id></citation></ref><ref id="