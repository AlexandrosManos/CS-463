ournal"><person-group person-group-type="author"><name><surname>Burke</surname><given-names>MD</given-names></name><name><surname>Thompson</surname><given-names>S</given-names></name><name><surname>Weaver</surname><given-names>RJ</given-names></name><name><surname>Wolf</surname><given-names>CR</given-names></name><name><surname>Mayer</surname><given-names>RT</given-names></name></person-group><article-title>Cytochrome P450 specificities of alkoxyresorufin <italic>O</italic>-dealkylation in human and rat liver</article-title><source>Biochem</source><source>Pharmacol</source><year>1994</year><volume>48</volume><fpage>923</fpage><lpage>936</lpage><!--PubMed citation query: 'Biochem||48|923||bib6|'--></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chua</surname><given-names>M-S</given-names></name><name><surname>Shi</surname><given-names>D-F</given-names></name><name><surname>Wrigley</surname><given-names>S</given-names></name><name><surname>Bradshaw</surname><given-names>TD</given-names></name><name><surname>Hutchinson</surname><given-names>I</given-names></name><name><surname>Shaw</surname><given-names>PN</given-names></name><name><surname>Barrett</surname><given-names>DA</given-names></name><name><surname>Stanley</surname><given-names>LA</given-names></name><name><surname>Stevens</surname><given-names>MFG</given-names></name></person-group><article-title>Antitumour benzothiazoles. 7. Synthesis of 2-(4-acylaminophenyl)benzothiazoles and investigations into the role of acetylation in the antitumour activities of the parent amines</article-title><source>J Med Chem</source><year>1999</year><volume>42</volume><fpage>381</fpage><lpage>392</lpage><!--PubMed citation query: 'J Med Chem||42|381||bib7|'--><pub-id pub-id-type="pmid">9986708</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chua</surname><given-names>M-S</given-names></name><name><surname>Kashiyama</surname><given-names>E</given-names></name><name><surname>Bradshaw</surname><given-names>TD</given-names></name><name><surname>Stinson</surname><given-names>SF</given-names></name><name><surname>Brantley</surname><given-names>E</given-names></name><name><surname>Sausville</surname><given-names>EA</given-names></name><name><surname>Stevens</surname><given-names>MFG</given-names></name></person-group><article-title>Role of CYP1A1 in modulation of antitumour properties of the novel agent 2-(4-amino-3-methylphenyl)benzothiazole (DF 203, NSC 674495) in human breast cancer cells</article-title><source>Cancer Res</source><year>2000</year><volume>60</volume><fpage>5196</fpage><lpage>5203</lpage><!--PubMed citation query: 'Cancer Res||60|5196||bib8|'--><pub-id pub-id-type="pmid">11016648</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hose</surname><given-names>C</given-names></name><name><surname>Riviera</surname><given-names>M</given-names></name><name><surname>Sausville</surname><given-names>E</given-names></name><name><surname>Monks</surname><given-names>A</given-names></name></person-group><article-title>Induction of cytochrome P450 CYP1A1 and cytochrome P450 CYP1B1 by 2-(4-amino-3-methylphenyl)benzothiazole (BZ) in 60 human tumour cell lines: correlation with BZ toxicity</article-title><source>Proc Am Assoc Cancer Res</source><year>2001</year><volume>42</volume><supplement>2749</supplement><fpage>511</fpage><!--PubMed citation query: 'Proc Am Assoc Cancer Res||42|511||bib9|'--></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hutchinson</surname><given-names>I</given-names></name><name><surname>Chua</surname><given-names>M-S</given-names></name><name><surname>Browne</surname><given-names>HL</given-names></name><name><surname>Trapani</surname><given-names>V</given-names></name><name><surname>Fichtner</surname><given-names>I</given-names></name><name><surname>Bradshaw</surname><given-names>TD</given-names></name><name><surname>Westwell</surname><given-names>AD</given-names></name><name><surname>Stevens</surname><given-names>MFG</given-names></name></person-group><article-title>Antitumour benzothiazoles. 14. The synthesis and unique antitumour properties of fluorinated 2-(4-aminophenyl)benzothiazoles</article-title><source>J Med Chem</source><year>2001</year><volume>44</volume><fpage>1446</fpage><lpage>1455</lpage><!--PubMed citation query: 'J Med Chem||44|1446||bib10|'--><pub-id pub-id-type="pmid">11311068</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hutchinson</surname><given-names>I</given-names></name><name><surname>Jennings</surname><given-names>SA</given-names></name><name><surname>Vishnuvajjala</surname><given-names>BR</given-names></name><name><surname>Westwell</surname><given-names>AD</given-names></name><name><surname>Stevens</surname><given-names>MFG</given-names></name></person-group><article-title>Antitumour benzothiazoles. 16. Synthesis and pharmaceutical properties of antitumour 2-(4-aminophenyl)benzothiazole amino acid prodrugs</article-title><source>J Med Chem</source><year>2002</year><volume>45</volume><fpage>744</fpage><lpage>747</lpage><!--PubMed citation query: 'J Med Chem||45|744||bib11|'--><pub-id pub-id-type="pmid">11806726</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kashiyama</surname><given-names>E</given-names></name><name><surname>Hutchinson</surname><given-names>I</given-names></name><name><surname>Chua</surname><given-names>M-S</given-names></name><name><surname>Stinson</surname><given-names>SF</given-names></name><name><surname>Phillips</surname><given-names>LR</given-names></name><name><surname>Kaur</surname><given-names>G</given-names></na