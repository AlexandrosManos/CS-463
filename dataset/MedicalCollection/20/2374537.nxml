<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article article-type="research-article"><?properties open_access?><!-- Original-type: ra--><front><journal-meta><journal-id journal-id-type="nlm-ta">Br J Cancer</journal-id><journal-title>British Journal of Cancer</journal-title><issn pub-type="ppub">0007-0920</issn><issn pub-type="epub">1532-1827</issn><publisher><publisher-name>Nature Publishing Group</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">10883675</article-id><article-id pub-id-type="pmc">2374537</article-id><article-id pub-id-type="pii">6691152</article-id><article-id pub-id-type="doi">10.1054/bjoc.2000.1152</article-id><article-categories><subj-group subj-group-type="heading"><subject>Regular Article</subject></subj-group></article-categories><title-group><article-title>Hormones and diet: low insulin-like growth factor-I but normal bioavailable androgens in vegan men</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Allen</surname><given-names>N E</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Appleby</surname><given-names>P N</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Davey</surname><given-names>G K</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Key</surname><given-names>T J</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib></contrib-group><aff id="aff1"><label>1</label>Cancer Epidemiology Unit, Imperial Cancer Research Fund, Gibson Building, Radcliffe Infirmary, Woodstock Road, Oxford, OX2 6HE, UK</aff><pub-date pub-type="epub"><day>02</day><month>06</month><year>2000</year></pub-date><pub-date pub-type="ppub"><month>07</month><year>2000</year></pub-date><volume>83</volume><issue>1</issue><fpage>95</fpage><lpage>97</lpage><history><date date-type="received"><day>30</day><month>11</month><year>1999</year></date><date date-type="rev-recd"><day>07</day><month>02</month><year>2000</year></date><date date-type="accepted"><day>08</day><month>02</month><year>2000</year></date></history><copyright-statement>Copyright 2000, Cancer Research Campaign</copyright-statement><copyright-year>2000</copyright-year><permissions><copyright-holder>Cancer Research Campaign</copyright-holder></permissions><abstract><p>Mean serum insulin-like growth factor-I was 9&#x00025; lower in 233 vegan men than in 226 meat-eaters and 237 vegetarians (<italic>P</italic> = 0.002). Vegans had higher testosterone levels than vegetarians and meat-eaters, but this was offset by higher sex hormone binding globulin, and there were no differences between diet groups in free testosterone, androstanediol glucuronide or luteinizing hormone. &#x000a9; 2000 Cancer Research Campaign</p></abstract><kwd-group><kwd>diet</kwd><kwd>insulin-like growth factor-I</kwd><kwd>sex hormones</kwd><kwd>vegan</kwd><kwd>meat-eaters</kwd></kwd-group></article-meta></front></article>