"50">82</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">416</td><td align="center" valign="top" charoff="50">1</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;45&#x02013;54</td><td align="center" valign="top" charoff="50">397</td><td align="center" valign="top" charoff="50">6</td><td align="center" valign="top" charoff="50">425</td><td align="center" valign="top" charoff="50">7</td><td align="center" valign="top" charoff="50">448</td><td align="center" valign="top" charoff="50">7</td><td align="center" valign="top" charoff="50">420</td><td align="center" valign="top" charoff="50">6</td><td align="center" valign="top" charoff="50">440</td><td align="center" valign="top" charoff="50">6</td><td align="center" valign="top" charoff="50">2130</td><td align="center" valign="top" charoff="50">6</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;55&#x02013;64</td><td align="center" valign="top" charoff="50">1047</td><td align="center" valign="top" charoff="50">17</td><td align="center" valign="top" charoff="50">1057</td><td align="center" valign="top" charoff="50">17</td><td align="center" valign="top" charoff="50">1101</td><td align="center" valign="top" charoff="50">17</td><td align="center" valign="top" charoff="50">1154</td><td align="center" valign="top" charoff="50">17</td><td align="center" valign="top" charoff="50">1152</td><td align="center" valign="top" charoff="50">17</td><td align="center" valign="top" charoff="50">5511</td><td align="center" valign="top" charoff="50">17</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;65&#x02013;74</td><td align="center" valign="top" charoff="50">2275</td><td align="center" valign="top" charoff="50">36</td><td align="center" valign="top" charoff="50">2327</td><td align="center" valign="top" charoff="50">37</td><td align="center" valign="top" charoff="50">2380</td><td align="center" valign="top" charoff="50">37</td><td align="center