<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article article-type="letter"><?properties open_access?><!-- Original-type: sc--><front><journal-meta><journal-id journal-id-type="nlm-ta">Br J Cancer</journal-id><journal-title>British Journal of Cancer</journal-title><issn pub-type="ppub">0007-0920</issn><issn pub-type="epub">1532-1827</issn><publisher><publisher-name>Nature Publishing Group</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">10737379</article-id><article-id pub-id-type="pmc">2374420</article-id><article-id pub-id-type="pii">6691032</article-id><article-id pub-id-type="doi">10.1054/bjoc.1999.1032</article-id><article-categories><subj-group subj-group-type="heading"><subject>Short Communication</subject></subj-group></article-categories><title-group><article-title>Tumour necrosis factor alpha increases melphalan concentration in tumour tissue after isolated limb perfusion</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>de Wilt</surname><given-names>J H W</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>ten Hagen</surname><given-names>T L M</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>de Boeck</surname><given-names>G</given-names></name><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>van Tiel</surname><given-names>S T</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>de Bruijn</surname><given-names>E A</given-names></name><xref ref-type="aff" rid="aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Eggermont</surname><given-names>A M M</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib></contrib-group><aff id="aff1"><label>1</label>Department of Surgical Oncology, University Hospital Rotterdam Dijkzigt/Daniel den Hoed Cancer Centre, Groene Hilledijk 301, Rotterdam, EA, 3075, The Netherlands</aff><aff id="aff2"><label>2</label>Laboratory for Organic Chemistry, University of Antwerp, Antwerp, Belgium</aff><aff id="aff3"><label>3</label>Laboratory for Experimental Oncology, University of Leuven, Leuven, Belgium</aff><pub-date pub-type="epub"><day>01</day><month>02</month><year>2000</year></pub-date><pub-date pub-type="ppub"><month>03</month><year>2000</year></pub-date><volume>82</volume><issue>5</issue><fpage>1000</fpage><lpage>1003</lpage><history><date date-type="received"><day>23</day><month>02</month><year>1999</year></date><date date-type="rev-recd"><day>16</day><month>06</month><year>1999</year></date><date date-type="accepted"><day>21</day><month>06</month><year>1999</year></date></history><copyright-statement>Copyright 2000, Cancer Research Campaign</copyright-statement><copyright-year>2000</copyright-year><permissions><copyright-holder>Cancer Research Campaign</copyright-holder></permissions><abstract><p>Several possible mechanisms for the synergistic anti-tumour effects between tumour necrosis factor alpha (TNF-&#x003b1;) and melphalan after isolated limb perfusion (ILP) have been presented. We found a significant sixfold increase in melphalan tumour tissue concentration after ILP when TNF-&#x003b1; was added to the perfusate, which provides a straightforward explanation for the observed synergism between melphalan and TNF-&#x003b1; in ILP. &#x000a9; 2000 Cancer Research Campaign</p></abstract><kwd-group><kwd>TNF</kwd><kwd>melphalan</kwd><kwd>tissue concentration</kwd><kwd>isolated limb perfusion</kwd><kwd>rats</kwd></kwd-group></article-meta></front></article>