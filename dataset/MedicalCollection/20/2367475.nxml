e><source>Genet Epidemiol</source><year>1999</year><volume>17</volume><fpage>S733</fpage><lpage>S734</lpage></citation></ref><ref id="B8"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gelman</surname><given-names>A</given-names></name><name><surname>Carlin</surname><given-names>JB</given-names></name><name><surname>Stern</surname><given-names>HS</given-names></name><name><surname>Rubin</surname><given-names>DB</given-names></name><collab>(Eds)</collab></person-group><source>Bayesian Data Analysis</source><year>2004</year><edition>2</edition><publisher-name>New York: Chapman &#x00026; Hall/CRC</publisher-name></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lander</surname><given-names>ES</given-names></name><name><surname>Green</surname><given-names>P</given-names></name></person-group><article-title>Construction of multilocus genetic linkage maps in humans</article-title><source>Proc Natl Acad Sci USA</source><year>1987</year><volume>84</volume><fpage>2363</fpage><lpage>2367</lpage><pub-id pub-id-type="pmid">3470801</pub-id><pub-id pub-id-type="doi">10.1073/pnas.84.8.2363</pub-id></citation></ref></ref-list></back></article>