></name><name><surname>Lorigan</surname><given-names>P</given-names></name><name><surname>MacNeil</surname><given-names>S</given-names></name><name><surname>Haycock</surname><given-names>J</given-names></name></person-group><article-title>Melanoma cell attachment, invasion and integrin expression is upregulated by tumour necrosis factor-<italic>&#x003b1;</italic> and suppressed by <italic>&#x003b1;</italic>-melanocyte stimulating hormone</article-title><source>J Invest Dermatol</source><year>2002</year><volume>119</volume><fpage>1165</fpage><lpage>1171</lpage><!--PubMed citation query: 'J Invest Dermatol||119|1165||bib29|'--><pub-id pub-id-type="pmid">12445207</pub-id></citation></ref></ref-list></back></article>