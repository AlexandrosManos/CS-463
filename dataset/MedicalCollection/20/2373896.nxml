iol</source><year>2003</year><volume>2</volume><fpage>27</fpage><pub-id pub-id-type="pmid">14527345</pub-id><pub-id pub-id-type="doi">10.1186/1475-4924-2-27</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dietrich</surname><given-names>J</given-names></name><name><surname>Han</surname><given-names>R</given-names></name><name><surname>Yang</surname><given-names>Y</given-names></name><name><surname>Mayer-Pr&#x000f6;schel</surname><given-names>M</given-names></name><name><surname>Noble</surname><given-names>M</given-names></name></person-group><article-title>CNS progenitor cells and oligodendrocytes are targets of chemotherapeutic agents <italic>in vitro </italic>and <italic>in vivo</italic></article-title><source>J Biol</source><year>2006</year><volume>5</volume><fpage>22</fpage><pub-id pub-id-type="pmid">17125495</pub-id><pub-id pub-id-type="doi">10.1186/jbiol50</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><collab>The <italic>PLoS </italic>Medicine Editors</collab></person-group><article-title>The Impact Factor Game. It is time to find a better way to assess the scientific literature</article-title><source>PLoS Med</source><year>2006</year><volume>3</volume><fpage>e291</fpage><pub-id pub-id-type="pmid">16749869</pub-id><pub-id pub-id-type="doi">10.1371/journal.pmed.0030291</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cockerill</surname><given-names>MJ</given-names></name></person-group><article-title>Delayed impact: ISI's citation tracking choices are keeping scientists in the dark</article-title><source>BMC Bioinformatics</source><year>2004</year><volume>5</volume><fpage>93</fpage><pub-id pub-id-type="pmid">15248902</pub-id><pub-id pub-id-type="doi">10.1186/1471-2105-5-93</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eysenbach</surname><given-names>G</given-names></name></person-group><article-title>Citation advantage of open access articles</article-title><source>PLoS Biol</source><year>2006</year><volume>4</volume><fpage>e157</fpage><pub-id pub-id-type="pmid">16683865</pub-id><pub-id pub-id-type="doi">10.1371/journal.pbio.0040157</pub-id></citation></ref><ref id="B14"><citation citation-type="other"><article-title>The <italic>BMC </italic>series journals</article-title><ext-link ext-link-type="uri" xlink:href="http://www.biomedcentral.com/info/authors/bmcseries"/></citation></ref></ref-list></back></article>