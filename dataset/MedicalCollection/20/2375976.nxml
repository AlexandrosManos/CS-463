ven-names>RD</given-names></name><name><surname>Horvai</surname><given-names>G</given-names></name></person-group><article-title>Properties of PVC based membranes used in ion-selective electrodes</article-title><source><italic>Electrochimica Acta</italic></source><year>1990</year><volume>35</volume><issue>1</issue><fpage>1</fpage><lpage>7</lpage></citation></ref><ref id="B15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Abdel-Ghani</surname><given-names>NT</given-names></name><name><surname>Shoukry</surname><given-names>AF</given-names></name><name><surname>El-Nashar</surname><given-names>RM</given-names></name></person-group><article-title>Flow injection potentiometric determination of pipazethate hydrochloride</article-title><source><italic>The Analyst</italic></source><year>2001</year><volume>126</volume><issue>1</issue><fpage>79</fpage><lpage>85</lpage><pub-id pub-id-type="pmid">11205518</pub-id></citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shoukry</surname><given-names>AF</given-names></name><name><surname>Badawy</surname><given-names>SS</given-names></name><name><surname>Issa</surname><given-names>YM</given-names></name></person-group><article-title>Performance characteristics and regeneration of a tetraphenylboron(III) selective electrod</article-title><source><italic>Analytical Chemistry</italic></source><year>1987</year><volume>59</volume><issue>8</issue><fpage>1078</fpage><lpage>1081</lpage></citation></ref><ref id="B17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oesch</surname><given-names>U</given-names></name><name><surname>Ammann</surname><given-names>D</given-names></name><name><surname>Simon</surname><given-names>W</given-names></name></person-group><article-title>Ion-selective membrane electrodes for clinical use</article-title><source