e><!--PubMed citation query: 'Proteomics||2|212||bib4|'--><pub-id pub-id-type="pmid">11840567</pub-id></citation></ref><ref id="bib5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hondermarck</surname><given-names>H</given-names></name><name><surname>Vercoutter-Edouart</surname><given-names>AS</given-names></name><name><surname>Revillion</surname><given-names>F</given-names></name><name><surname>Lemoine</surname><given-names>J</given-names></name><name><surname>el-Yazidi-Belkoura</surname><given-names>I</given-names></name><name><surname>Nurcombe</surname><given-names>V</given-names></name><name><surname>Peyrat</surname><given-names>JP</given-names></name></person-group><article-title>Proteomics of breast cancer for marker discovery and signal pathway profiling</article-title><source>Proteomics</source><year>2001</year><volume>1</volume><fpage>1216</fpage><lpage>1232</lpage><!--PubMed citation query: 'Proteomics||1|1216||bib5|'--><pub-id pub-id-type="pmid">11721634</pub-id></citation></ref><ref id="bib6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kennedy</surname><given-names>S</given-names></name></person-group><article-title>Proteomic profiling from human samples: the body fluid alternative</article-title><source>Toxicol Lett</source><year>2001</year><volume>120</volume><fpage>379</fpage><lpage>384</lpage><!--PubMed citation query: 'Toxicol Lett||120|379||bib6|'--><pub-id pub-id-type="pmid">11323197</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Le Naour</surname><given-names>F</given-names></name><name><surname>Misek</surname><given-names>DE</given-names></name><name><surname>Krause</surname><given-names>MC</given-names></name><name><surname>Deneux</surname><given-names>L</given-names></name><name><surname>Giordano</surname><given-names>TJ</given-names></name><name><surname>Scholl</surname><g