r-name>London, Chapman &#x00026; Hall</publisher-name><fpage>284</fpage><lpage>309</lpage></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maxted</surname><given-names>N</given-names></name><name><surname>Ford-Lloyd</surname><given-names>BV</given-names></name><name><surname>Jury</surname><given-names>SL</given-names></name><name><surname>Kell</surname><given-names>SP</given-names></name><name><surname>Scholten</surname><given-names>MA</given-names></name></person-group><article-title>Towards a definition of a crop wild relative</article-title><source>Biodiversity and Conservation</source><year>2006</year><volume>15</volume><fpage>2673</fpage><lpage>2685</lpage><pub-id pub-id-type="doi">10.1007/s10531-005-5409-6</pub-id></citation></ref><ref id="B32"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Raunkiaer</surname><given-names>C</given-names></name></person-group><source>Life forms of plants and statistical plant geography</source><year>1934</year><publisher-name>Oxford University Press, Oxford</publisher-name></citation></ref><ref id="B33"><citation citation-type="book"><person-group person-group-type="author"><collab>FAO</collab></person-group><source>FAO/Unesco Soil Map of the World, Revised legend, with corrections and updates World Soil Resources Report 60, Rome, FAO 1988 Reprinted with updates as Technical Paper 20</source><year>1997</year><publisher-name>Wageningen, Netherlands, ISRIC</publisher-name></citation></ref><ref id="B34"><citation citation-type="other"><article-title>European Nature Information System (EUNIS): Habitat types</article-title><ext-link ext-link-type="uri" xlink:href="http://eunis.eea.europa.eu/habitats-code-browser.jsp"/></citation></ref><ref id="B35"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harlan</surname><given-names>JR</given-names></name><name><surname>de Wet</surname><giv