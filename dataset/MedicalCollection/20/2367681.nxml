source><volume>28</volume><fpage>124</fpage><lpage>132</lpage><pub-id pub-id-type="pmid">12019589</pub-id></citation></ref><ref id="b7-ehp0116-000599"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Axmon</surname><given-names>A</given-names></name><name><surname>Rylander</surname><given-names>L</given-names></name><name><surname>Stromberg</surname><given-names>U</given-names></name><name><surname>Jonsson</surname><given-names>B</given-names></name><name><surname>Nilsson-Ehle</surname><given-names>P</given-names></name><name><surname>Hagmar</surname><given-names>L</given-names></name></person-group><year>2004</year><article-title>Polychlorinated biphenyls in serum and time to pregnancy</article-title><source>Environ Res</source><volume>96</volume><fpage>186</fpage><lpage>195</lpage><pub-id pub-id-type="pmid">15325879</pub-id></citation></ref><ref id="b8-ehp0116-000599"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Axmon</surname><given-names>A</given-names></name><name><surname>Thulstrup</surname><given-names>AM</given-names></name><name><surname>Rignell-Hydbom</surname><given-names>A</given-names></name><name><surname>Pedersen</surname><given-names>HS</given-names></name><name><surname>Zvyezday</surname><given-names>V</given-names></name><name><surname>Ludwicki</surname><given-names>JK</given-names></name><etal/></person-group><year>2006b</year><article-title>Time to pregnancy as a function of male and female serum concentrations of 2,2&#x02019;4,4&#x02019;5,5&#x02019;-hexachlorobiphenyl (CB-153) and 1,1-dichloro-2,2-bis (<italic>p</italic>-chlorophenyl)-ethylene (<italic>p,p&#x02032;</italic>-DDE)</article-title><source>Hum Reprod</source><volume>21</volume><fpage>657</fpage><lpage>665</lpage><pub-id pub-id-type="pmid">16361295</pub-id></citation></ref><ref id="b9-ehp0116-000599"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Baird</surn