eurobiol</source><year>1994</year><volume>4</volume><fpage>633</fpage><lpage>639</lpage><pub-id pub-id-type="pmid">7849518</pub-id><pub-id pub-id-type="doi">10.1016/0959-4388(94)90003-5</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fischer von Mollard</surname><given-names>G</given-names></name><name><surname>Stahl</surname><given-names>B</given-names></name><name><surname>Li</surname><given-names>C</given-names></name><name><surname>Sudhof</surname><given-names>TC</given-names></name><name><surname>Jahn</surname><given-names>R</given-names></name></person-group><article-title>Rab proteins in regulated exocytosis.</article-title><source>Trends Biochem Sci</source><year>1994</year><volume>19</volume><fpage>164</fpage><lpage>168</lpage><pub-id pub-id-type="pmid">8016866</pub-id><pub-id pub-id-type="doi">10.1016/0968-0004(94)90278-X</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Izumi</surname><given-names>T</given-names></name><name><surname>Gomi</surname><given-names>H</given-names></name><name><surname>Kasai</surname><given-names>K</given-names></name><name><surname>Mizutani</surname><given-names>S</given-names></name><name><surname>Torii</surname><given-names>S</given-names></name></person-group><article-title>The roles of Rab27 and its effectors in the regulated secretory pathways.</article-title><source>Cell Struct Funct</source><year>2003</year><volume>28</volume><fpage>465</fpage><lpage>474</lpage><pub-id pub-id-type="pmid">14745138</pub-id><pub-id pub-id-type="doi">10.1247/csf.28.465</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wu</surname><given-names>YW</given-names></name><name><surname>Tan</surname><given-names>KT</given-names></name><name><surname>Waldmann</surname><given-names>H</given-names></name><name><surname>Goody</surname><given-names>RS</given-names></name><name><surname>Alexandrov</surname><given-names>K</given-names></name></person-group><article-title>Interaction analysis of prenylated Rab GTPase with Rab escort protein and GDP dissociation inhibitor explains the need for both regulators.</article-title><source>Proc Natl Acad Sci USA</source><year>2007</year><volume>104</volume><fpage>12294</fpage><lpage>12299</lpage><pub-id pub-id-type="pmid">17640890</pub-id><pub-id pub-id-type="doi">10.1073/pnas.0701817104</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stenmark</surname><given-names>H</given-names></name><name><surname>Olkkonen</surname><given-names>VM</given-names></name></person-group><article-title>The Rab GTPase family.</article-title><source>Genome Biol</source><year>2001</year><volume>2</volume><comment>REVIEWS3007</comment><pub-id pub-id-type="pmid">11387043</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Takamori</surname><given-names>S</given-names></name><name><surname>Holt</surname><given-names>M</given-names></name><name><surname>Stenius</surname><given-names>K</given-names></name><name><surname>Lemke</surname><given-names>EA</given-names></name><name><surname>Gr&#x000f8;nborg</surname><given-names>M</given-names></name><name><surname>Riedel</surname><given-names>D</given-names></name><name><surname>Urlaub</surname><given-names>H</given-names></name><name><surname>Schenck</surname><given-names>S</given-names></name><name><surname>Br&#x000fc;gger</surname><given-names>B</given-names></name><name><surname>Ringler</surname><given-names>P</given-names></name><name><surname>M&#x000fc;ller</surname><given-names>SA</given-names></name><name><surname>Rammner</surname><given-names>B</given-names></name><name><surname>Gr&#x000e4;ter</surname><given-names>F</given-names></name><name><surname>Hub</