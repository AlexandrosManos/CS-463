ames></name><name><surname>Ensminger</surname><given-names>AW</given-names></name><name><surname>Littleton</surname><given-names>JT</given-names></name></person-group><article-title>Neurobiology and the <italic>Drosophila </italic>genome.</article-title><source>Funct Integr Genomics</source><year>2001</year><volume>1</volume><fpage>235</fpage><lpage>240</lpage><pub-id pub-id-type="pmid">11793242</pub-id><pub-id pub-id-type="doi">10.1007/s101420000029</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Richmond</surname><given-names>JE</given-names></name><name><surname>Broadie</surname><given-names>KS</given-names></name></person-group><article-title>The synaptic vesicle cycle: exocytosis and endocytosis in <italic>Drosophila </italic>and <italic>C. elegans</italic>.</article-title><source>Curr Opin Neurobiol</source><year>2002</year><volume>12</volume><fpage>499</fpage><lpage>507</lpage><pub-id pub-id-type="pmid">12367628</pub-id><pub-id pub-id-type="doi">10.1016/S0959-4388(02)00360-4</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zhang</surname><given-names>B</given-names></name></person-group><article-title>Genetic and molecular analysis of synaptic vesicle recycling in <italic>Drosophila</italic>.</article-title><source>J Neurocytol</source><year>2003</year><volume>32</volume><fpage>567</fpage><lpage>589</lpage><pub-id pub-id-type="pmid">15034254</pub-id><pub-id pub-id-type="doi">10.1023/B:NEUR.0000020611.44254.86</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Linial</surname><given-names>M</given-names></name><name><surname>Parnas</surname><given-names>D</given-names></name></person-group><article-title>Deciphering neuronal secretion: tools of the trade.</article-title><source>Biochim Biophys Acta</source><year>1996</year><volu