n="left">85</td><td align="left">82</td><td align="left">78</td><td align="left">80</td><td align="left">78</td></tr><tr><td colspan="10"><hr></hr></td></tr><tr><td align="left">SPS:Family</td><td align="left">RNAlara</td><td align="left">Locarna</td><td align="left">FoldalignM(1)</td><td align="left">FoldalignM(2)</td><td align="left">MARNA</td><td align="left">PMmulti</td><td align="left">Stemloc</td><td></td><td></td></tr><tr><td colspan="10"><hr></hr></td></tr><tr><td align="left">IRE</td><td align="left">85</td><td align="left">88 (100/100)</td><td align="left">87 (99/101)</td><td align="left">85 (97/100)</td><td align="left">92</td><td align="left">90 (101/101)</td><td align="left">87 (101/101)</td><td></td><td></td></tr><tr><td align="left">s2m</td><td align="left">96</td><td align="left">99 (43/50)</td><td align="left">95 (50/50)</td><td align="left">95 (47/50)</td><td align="left">94</td><td align="left">98 (44/50)</td><td align="left">93 (50/50)</td><td></td><td></td></tr><tr><td align="left">UnaL2</td><td align="left">93</td><td align="left">93 (78/89)</td><td align="left">89 (75/89)</td><td align="left">86 (87/89)</td><td align="left">88</td><td align="left">87 (75/89)</td><td align="left">75 (89/89)</td><td></td><td></td></tr><tr><td align="left">Hammerhead_3</td><td align="left">88</td><td align="left">80 (100/100)</td><td align="left">79 (99/100)</td><td align="left">77 (97/100)</td><td align="left">89</td><td align="left">87 (77/100)</td><td align="left">94 (100/100)</td><td></td><td></td></tr><tr><td align="left">SECIS</td><td align="left">48</td><td align="left">47 (62/63)</td><td align="left">46 (63/63)</td><td align="left">44 (63/63)</td><td align="left">49</td><td align="left">39 (63/63)</td><td align="left">60 (60/63)</td><td></td><td></td></tr><tr><td align="left">sno_14q_I_II</td><td align="left">78</td><td align="left">76 (98/98)</td><td align="left">73 (98/98)</td><td align="left">61 (97/98)</td><td align="left">67</td><td align="left">73 (