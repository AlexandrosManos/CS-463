age>527</lpage><pub-id pub-id-type="pmid">11544157</pub-id></citation></ref><ref id="b12-ehp0116-000583"><citation citation-type="book"><collab>Environmental Health Perspectives</collab><year>1974</year><volume>7</volume><source>Low Level Lead Toxicity and the Environmental Impact of Cadmium</source><publisher-loc>Research Triangle Park, NC</publisher-loc><publisher-name>National Institute of Environmental Health Sciences</publisher-name></citation></ref><ref id="b13-ehp0116-000583"><note><p>Federal Grants and Cooperative Agreement Act of 1977. 1977. Public Law 95-224.</p></note></ref><ref id="b14-ehp0116-000583"><note><p>Government Performance and Results Act of 1993. 1993. Public Law 103-62.</p></note></ref><ref id="b15-ehp0116-000583"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hanney</surname><given-names>SR</given-names></name><name><surname>Gonzalez-Block</surname><given-names>MA</given-names></name><name><surname>Buxton</surname><given-names>MJ</given-names></name><name><surname>Kogan</surname><given-names>M</given-names></name></person-group><year>2003</year><article-title>The utilisation of health research in policy-making: concepts, examples and methods of assessment</article-title><source>Health Res Policy Syst</source><volume>1</volume><fpage>2</fpage><pub-id pub-id-type="pmid">12646071</pub-id></citation></ref><ref id="b16-ehp0116-000583"><citation citation-type="web"><collab>Johns Hopkins University</collab><year>2000</year><article-title>Particulate Air Pollution Needs to Be Controlled to Protect Public Health. [Press release]</article-title><comment>Available: <ext-link ext-link-type="uri" xlink:href="http://www.jhsph.edu/publichealthnews/press_releases/PR_2000/air_pollution_cities.html">http://www.jhsph.edu/publichealthnews/press_releases/PR_2000/air_pollution_cities.html</ext-link></comment><access-date>[accessed 17 May 2007]</access-date></citation></ref><ref id="b17-ehp0116-000583"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McConnell</surname><given-names>R</given-names></name><name><surname>Berhane</surname><given-names>K</given-names></name><name><surname>Gilliland</surname><given-names>F</given-names></name><name><surname>London</surname><given-names>S</given-names></name><name><surname>Vora</surname><given-names>H</given-names></name><name><surname>Avol</surname><given-names>E</given-names></name><etal/></person-group><year>1999</year><article-title>Air pollution and bronchitic symptoms in Southern California children with asthma</article-title><source>Environ Health Perspect</source><volume>107</volume><fpage>757</fpage><lpage>760</lpage><pub-id pub-id-type="pmid">10464077</pub-id></citation></ref><ref id="b18-ehp0116-000583"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McLaughlin</surname><given-names>J</given-names></name><name><surname>Jordan</surname><given-names>B</given-names></name></person-group><year>1999</year><article-title>Logic models: a tool for telling your program&#x02019;s performance story</article-title><source>Eval Program Plann</source><volume>22</volume><fpage>65</fpage><lpage>72</lpage></citation></ref><ref id="b19-ehp0116-000583"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meyer</surname><given-names>P</given-names></name><name><surname>Pivetz</surname><given-names>T</given-names></name><name><surname>Dignam</surname><given-names>T</given-names></name><name><surname>Homa</surname><given-names>D</given-names></name><name><surname>Schoonover</surname><given-names>J</given-names></name><name><surname>Brody</surname><given-names>D</given-names></name></person-group><year>2003</year><article-title>Surveillance for elevated blood lead levels among children&#x02013;&#x02013;United States, 1997&#x02013;2001</article-title><source>MMWR Surveill Summ</source><volume>52</volume><fpage>1</fpage><lpage>21</lpage><pub-id pub-id-type="pmid">14532866</pub-id></citation></ref><ref id="b20-ehp0116-000583"><citation citation-type="book"><person-group person-group-type="editor"><name><surname>Morgenstern</surname><given-names>RD</given-names></name><name><surname>Pizer</surname><given-names>WA</given-names></name></person-group><year>2007</year><source>Reality Check: The Nature and Performance of Voluntary Environmental Programs in the United States, Europe, and Japan</source><publisher-loc>Washington, DC</publisher-loc><publisher-name>RFF Press</publisher-name></citation></ref><ref id="b21-ehp0116-000583"><citation citation-type="book"><collab>National Research Council</collab><year>2004</year><article-title>Research Priorities for Airborne Particulate Matter. IV: Continuing Research Progress</article-title><source>Committee on Research Priorities for Airborne Particulate Matter, Board on Environmental Studies and Toxicology, Division on Earth and Life Studies, National Research Council of the National Academies</source><publisher-loc>Washington, DC</publisher-loc><publisher-name>National Academies Press</publisher-name></citation></ref><ref id="b22-ehp0116-000583"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Needleman</surname><given-names>HL</given-names></name></person-group><year>2000</year><article-title>The removal of lead from gasoline: historical and personal reflections</article-title><source>Environ Res</source><volume>84</volume><fpage>20</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">10991779</pub-id></citation></ref><ref id="b23-ehp0116-000583"><citation citation-type="web"><collab>NIEHS (National Institute of Environmental Health Sciences)</collab><year>2003</year><source>Low Levels of Lead and IQ Deficits</source><comment>Available: <ext-link ext-link-type="uri" xlink:href="http://www.niehs.nih.gov/dert/profiles/hilites/2003/lead-IQ.htm">http://www.niehs.nih.gov/dert/profiles/hilites/2003/lead-IQ.htm</ext-link></comment><access-date>[accessed 4 April 2007]</access-date></citation></ref><ref id="b24-ehp0116-000583"><citation citation-type="web"><collab>NIEHS (National Institute of Environmental Health Sciences)</collab><year>2006a</year><article-title>Elderly Have Higher Risk for Cardiovascular, Respiratory Disease from Fine Particle Pollution. PR 06-063/8/06</article-title><comment>Available: <ext-link ext-link-type="uri" xlink:href="http://www.niehs.nih.gov/oc/news/particle.htm">http://www.niehs.nih.gov/oc/news/particle.htm</ext-link></comment><access-date>[accessed 17 May 2007]</access-date></citation></ref><ref id="b25-ehp0116-000583"><citation citation-type="web"><collab>NIEHS (National Institute of Environmental Health Sciences)</collab><year>2006b</year><article-title>New Frontiers in Environmental Health Sciences and Human Health. NIEHS 2006&#x02013;2011 Strategic Plan</article-title><comment>Available: <ext-link ext-link-type="uri" xlink:href="http://www.niehs.nih.gov/external/plan2006/StrategicPlan2006final.pdf">http://www.niehs.nih.gov/external/plan2006/StrategicPlan2006final.pdf</ext-link></comment><access-date>[accessed 1 March 2007]</access-date></citation></ref><ref id="b26-ehp0116-000583"><citation citation-type="web"><collab>Office of Management and Budget</collab><year>2006</year><article-title>Program Assessment Rating Tool Guidance No. 2006-02. 10 March 2006</article-title><comment>Available: <ext-link ext-link-type="uri" xlink:href="http://www.whitehouse.gov/omb/part/2006_part_guidance.pdf">http://www.whitehouse.gov/omb/part/2006_part_guidance.pdf</ext-link></comment><access-date>[accessed 12 December 2007]</access-date></citation></ref><ref id="b27-ehp0116-000583"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pope</surname><given-names>CA</given-names><suffix>III</suffix></name><name><surname>Burnett</surname><given-names>R</given-names></name><name><surname>Thurston</surname><given-names>G</given-names></name><