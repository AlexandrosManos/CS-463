1065177</td></tr><tr><td align="left"><italic>CH242-277I8.4</italic></td><td align="left">Putative novel transcript</td><td align="left">1034571</td><td align="left">1035756</td></tr><tr><td align="left"><bold>                              <italic>ATP9A</italic>                           </bold></td><td align="left">Atpase, class II, type 9A</td><td align="left">1111110</td><td align="left">1247324</td></tr><tr><td align="left"><bold>                              <italic>SALL4</italic>                           </bold></td><td align="left">Sal-like 4 (<italic>Drosophila</italic>)</td><td align="left">1257555</td><td align="left">1278123</td></tr><tr><td align="left"><italic>CH242-209L2.2</italic></td><td align="left">Putative novel transcript</td><td align="left">1323104</td><td align="left">1324011</td></tr><tr><td align="left"><italic>CH242-209L2.1</italic></td><td align="left">Pseudogene similar to part of human protein regulator of cytokinesis 1 (<italic>PRC1</italic>)</td><td align="left">1323229</td><td align="left">1323658</td></tr><tr><td align="left"><italic>CH242-511J12.1</italic></td><td align="left">Ribosomal protein L27a (<italic>RPL27A</italic>) pseuodgene</td><td align="left">1496762</td><td align="left">1497205</td></tr><tr><td align="left"><bold>                              <italic>ZFP64</italic>                           </bold></td><td align="left">Zinc finger protein 64 homolog (mouse)</td><td align="left">1577847</td><td align="left">1666097</td></tr><tr><td align="left"><italic>CH242-300K12.1</italic></td><td align="left">Novel transcript</td><td align="left">1689884</td><td align="left">1709546</td></tr><tr><td align="left"><bold>                              <italic>TSHZ2</italic>                           </bold></td><td align="left">Teashirt family zinc finger 2</td><td align="left">2317086</td><td align="left">2773025</td></tr><tr><td align="left"><bold>                              <italic>ZNF217</italic>                           </bold