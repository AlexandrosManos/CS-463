"B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Butler</surname><given-names>AA</given-names></name></person-group><article-title>The melanocortin system and energy balance.</article-title><source>Peptides</source><year>2006</year><volume>27</volume><fpage>281</fpage><lpage>290</lpage><pub-id pub-id-type="pmid">16434123</pub-id><pub-id pub-id-type="doi">10.1016/j.peptides.2005.02.029</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kallioniemi</surname><given-names>A</given-names></name><name><surname>Kallioniemi</surname><given-names>O-P</given-names></name><name><surname>Piper</surname><given-names>J</given-names></name><name><surname>Tanner</surname><given-names>M</given-names></name><name><surname>Stokke</surname><given-names>T</given-names></name><name><surname>Chen</surname><given-names>L</given-names></name><name><surname>Smith</surname><given-names>HS</given-names></name><name><surname>Pinkel</surname><given-names>D</given-names></name><name><surname>Gray</surname><given-names>JW</given-names></name><name><surname>Waldmann</surname><given-names/></name></person-group><article-title>Detection and mapping of amplified DNA sequences in breast cancer by comparative genomic hybridisation.</article-title><source>Proc Natl Acad Sci USA</source><year>1994</year><volume>91</volume><fpage>2156</fpage><lpage>2160</lpage><pub-id pub-id-type="pmid">8134364</pub-id><pub-id pub-id-type="doi">10.1073/pnas.91.6.2156</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yang</surname><given-names>SH</given-names></name><name><surname>Seo</surname><given-names>MY</given-names></name><name><surname>Jeong</surname><given-names>HJ</given-names></name><name><surname>Jeung</surname><given-names>H-C</given-names></name><name><surname>Shin</surname><given-names>J</given-names></name><