ign="top" charoff="50">3</td><td align="center" valign="top" charoff="50">10</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">3</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">1</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50"><bold>LN</bold></td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;No</td><td align="center" valign="top" charoff="50">5</td><td align="center" valign="top" charoff="50">4</td><td align="center" valign="top" charoff="50">3</td><td align="center" valign="top" charoff="50">3</td><td align="center" valign="top" charoff="50">3</td><td align="center" valign="top" charoff="50">5</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">4</td><td align="center" valign="top" charoff="50">2</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Yes</td><td align="center" valign="top" charoff="50">2</td><td align="center" valign="top" charoff="50">20</td><td align="center" valign="top" charoff="50">3</td><td align="center" valign="top" charoff="50">3</td><td align="center" valign="top" charoff="50">22</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">20</td><td align="center" valign="top" charoff="50">6</td><td align="center" valign="top" charoff="50">3</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50"><bold>(<italic>P</italic>&#x0003d;0.018)</bold></td><td align="center" valign="top" charoff="50"><bold>(<italic>P</italic>&#x0003d;0.001)</bold></td><td align="center" valign="top" charoff="50"><bold>(<italic>P</italic>&#x0003d;0.012)</bold></td><td>&#x000a0;</td><td>&#x000a0;</td><td>&#x000a0;</td><td>&#x000a0;</td><td>&#x000a0;</td><td>&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50"><bold>Grade</bold></td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Well&#x0002f;mod</td><td align="center" valign="top" charoff="50">2</td><td align="center" valign="top" charoff="50">9</td><td align="center" valign="top" charoff="50">2</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">13</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">12</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">2</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Poor</td><td align="center" valign="top" charoff="50">5</td><td align="center" valign="top" charoff="50">15</td><td align="center" valign="top" charoff="50">4</td><td align="center" valign="top" charoff="50">5</td><td align="center" valign="top" charoff="50">12</td><td align="center" valign="top" charoff="50">5</td><td align="center" valign="top" charoff="50">9</td><td align="center" valign="top" charoff="50">9</td><td align="center" valign="top" charoff="50">4</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50"><bold>Stage</bold></td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;A</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">0</td><td align="center" valign="top" charoff="50">0</td><td align="center" valign="top" charoff="50">0</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">0</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">0</td><td align="center" valign="top" charoff="50">3</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;B1-B2</td><td align="center" valign="top" charoff="50">2</td><td align="center" valign="top" charoff="50">8</td><td align="center" valign="top" charoff="50">2</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">6</td><td align="center" valign="top" charoff="50">4</td><td align="center" valign="top" charoff="50">4</td><td align="center" valign="top" charoff="50">4</td><td align="center" valign="top" charoff="50">2</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;C1-C2</td><td align="center" valign="top" charoff="50">4</td><td align="center" valign="top" charoff="50">16</td><td align="center" valign="top" charoff="50">4</td><td align="center" valign="top" charoff="50">5</td><td align="center" valign="top" charoff="50">18</td><td align="center" valign="top" charoff="50">2</td><td align="center" valign="top" charoff="50">16</td><td align="center" valign