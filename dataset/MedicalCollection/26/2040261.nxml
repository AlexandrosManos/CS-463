e><pub-id pub-id-type="pmid">16151148</pub-id></citation></ref><ref id="b47"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weishaar</surname><given-names>JL</given-names></name></person-group><article-title>Evaluation of specific ultraviolet absorbance as an indicator of the chemical composition and reactivity of dissolved organic carbon</article-title><source>Environ Sci Technol</source><year>2003</year><volume>37</volume><fpage>4702</fpage><lpage>4708</lpage><pub-id pub-id-type="pmid">14594381</pub-id></citation></ref></ref-list></back></article>