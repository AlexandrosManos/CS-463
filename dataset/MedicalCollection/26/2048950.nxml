age>255</lpage><pub-id pub-id-type="pmid">9625210</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stansfeld</surname><given-names>SA</given-names></name><name><surname>Head</surname><given-names>J</given-names></name><name><surname>Marmot</surname><given-names>M</given-names></name></person-group><article-title>Explaining social class differences in depression and well being</article-title><source>Soc Psychiatry Psychiatr Epidemiol</source><year>1998</year><volume>33</volume><fpage>1</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">9448438</pub-id><pub-id pub-id-type="doi">10.1007/s001270050014</pub-id></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Berkman</surname><given-names>LF</given-names></name><name><surname>Melchior</surname><given-names>M</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Siegrist J, Marmot M</surname></name></person-group><article-title>The shape of things to come. How social policy impacts social integration and family structure to produce population health</article-title><source>Social Inequalities in Health</source><year>2006</year><publisher-name>Oxford: University Press</publisher-name><fpage>55</fpage><lpage>72</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Turner</surname><given-names>JR</given-names></name><name><surname>Marino</surname><given-names>F</given-names></name></person-group><article-title>Social support and social structure: a descriptive epidemiology</article-title><source>J Health Soc Behav</source><year>1994</year><volume>35</volume><fpage>193</fpage><lpage>212</lpage><pub-id pub-id-type="pmid">7983334</pub-id><pub-id pub-id-type="doi">10.2307/2137276</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-grou