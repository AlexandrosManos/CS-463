citation-type="journal"><person-group person-group-type="author"><name><surname>Ohmiya</surname><given-names>M</given-names></name><name><surname>Fukumitsu</surname><given-names>H</given-names></name><name><surname>Nitta</surname><given-names>A</given-names></name><name><surname>Nomoto</surname><given-names>H</given-names></name><name><surname>Furukawa</surname><given-names>Y</given-names></name><name><surname>Furukawa</surname><given-names>S</given-names></name></person-group><article-title>Administration of FGF-2 to embryonic mouse brain induces hydrocephalic brain morphology and aberrant differentiation of neurons in the postnatal cerebral cortex</article-title><source>J Neurosci Res</source><year>2001</year><volume>65</volume><fpage>228</fpage><lpage>235</lpage><pub-id pub-id-type="pmid">11494357</pub-id><pub-id pub-id-type="doi">10.1002/jnr.1146</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johanson</surname><given-names>CE</given-names></name><name><surname>Szmydynger Chodobska</surname><given-names>J</given-names></name><name><surname>Chodobski</surname><given-names>A</given-names></name><name><surname>Baird</surname><given-names>A</given-names></name><name><surname>McMillan</surname><given-names>P</given-names></name><name><surname>Stopa</surname><given-names>EG</given-names></name></person-group><article-title>Altered formation and bulk absorption of cerebrospinal fluid in FGF-2-induced hydrocephalus.</article-title><source>Am J Physiol</source><year>1999</year><volume>277</volume><fpage>R263</fpage><lpage>R271</lpage><pub-id pub-id-type="pmid">10409281</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nakazato</surname><given-names>F</given-names></name><name><surname>Tada</surname><given-names>T</given-names></name><name><surname>Sekiguchi</surname><given-names>Y</given-names></name><name><surname>Murakami</surname><given-names>K</given-names></name><name><surname>Yanagisawa</surname><given-names>S</given-names></name><name><surname>Tanaka</surname><given-names>Y</given-names></name><name><surname>Hongo</surname><given-names>K</given-names></name></person-group><article-title>Disturbed spatial learning of rats after intraventricular administration of transforming growth factor-beta 1</article-title><source>Neurol Med Chir (Tokyo)</source><year>2002</year><volume>42</volume><fpage>151</fpage><lpage>156</lpage><pub-id pub-id-type="pmid">12013666</pub-id><pub-id pub-id-type="doi">10.2176/nmc.42.151</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tada</surname><given-names>T</given-names></name><name><surname>Kanaji</surname><given-names>M</given-names></name><name><surname>Kobayashi</surname><given-names>S</given-names></name></person-group><article-title>Induction of communicating hydrocephalus in mice by intrathecal injection of human recombinant transforming growth factor-beta 1.</article-title><source>J Neuroimmunol</source><year>1994</year><volume>50</volume><fpage>153</fpage><lpage>158</lpage><pub-id pub-id-type="pmid">8120136</pub-id><pub-id pub-id-type="doi">10.1016/0165-5728(94)90041-8</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Emonard</surname><given-names>H</given-names></name><name><surname>Grimaud</surname><given-names>JA</given-names></name><name><surname>Nusgens</surname><given-names>B</given-names></name><name><surname>Lapiere</surname><given-names>CM</given-names></name><name><surname>Foidart</surname><given-names>JM</given-names></name></person-group><article-title>Reconstituted basement-membrane matrix modulates fibroblast activities in vitro</article-title><source>J Cell Physiol</source><year>1987</year><volume>133</volume><fpage>95</fpage><lpage>102</lpage><pub-id pub-id-type