icle-title><source>EMBO J</source><volume>17</volume><fpage>3326</fpage><lpage>3341</lpage><pub-id pub-id-type="pmid">9628870</pub-id></citation></ref><ref id="ppat-0030162-b010"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zheng</surname><given-names>Y</given-names></name><name><surname>Cerione</surname><given-names>R</given-names></name><name><surname>Bender</surname><given-names>A</given-names></name></person-group><year>1994</year><article-title>Control of the yeast bud-site assembly GTPase Cdc42. Catalysis of guanine nucleotide exchange by Cdc24 and stimulation of GTPase activity by Bem3</article-title><source>J Biol Chem</source><volume>269</volume><fpage>2369</fpage><lpage>2372</lpage><pub-id pub-id-type="pmid">8300560</pub-id></citation></ref><ref id="ppat-0030162-b011"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leberer</surname><given-names>E</given-names></name><name><surname>Wu</surname><given-names>C</given-names></name><name><surname>Leeuw</surname><given-names>T</given-names></name><name><surname>Fourest-Lieuvin</surname><given-names>A</given-names></name><name><surname>Segall</surname><given-names>JE</given-names></name><etal/></person-group><year>1997</year><article-title>Functional characterization of the Cdc42p binding domain of yeast Ste20p protein kinase</article-title><source>EMBO J</source><volume>16</volume><fpage>83</fpage><lpage>97</lpage><pub-id pub-id-type="pmid">9009270</pub-id></citation></ref><ref id="ppat-0030162-b012"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnson</surname><given-names>DI</given-names></name></person-group><year>1999</year><article-title>Cdc42: an essential Rho-type GTPase controlling eukaryotic cell polarity</article-title><source>Microbiol Mol Biol Rev</source><volume>63</volume><fpage>54</fpage><lpage>105</lpage><pub-id pub-id-type="pmid">10066831</pub-id></citation></ref><ref id="ppat-0030162-b013"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wu</surname><given-names>C</given-names></name><name><surname>Whiteway</surname><given-names>M</given-names></name><name><surname>Thomas</surname><given-names>DY</given-names></name><name><surname>Leberer</surname><given-names>E</given-names></name></person-group><year>1995</year><article-title>Molecular characterization of Ste20p, a potential mitogen-activated protein or extracellular signal-regulated kinase kinase (MEK) kinase kinase from <named-content content-type="genus-species">Saccharomyces cerevisiae</named-content></article-title><source>J Biol Chem</source><volume>270</volume><fpage>15984</fpage><lpage>15992</lpage><pub-id pub-id-type="pmid">7608157</pub-id></citation></ref><ref id="ppat-0030162-b014"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cook</surname><given-names>JG</given-names></name><name><surname>Bardwell</surname><given-names>L</given-names></name><name><surname>Thorner</surname><given-names>J</given-names></name></person-group><year>1997</year><article-title>Inhibitory and activating functions for MAPK Kss1 in the <named-content content-type="genus-species">S. cerevisiae</named-content> filamentous-growth signalling pathway</article-title><source>Nature</source><volume>390</volume><fpage>85</fpage><lpage>88</lpage><pub-id pub-id-type="pmid">9363895</pub-id></citation></ref><ref id="ppat-0030162-b015"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Drogen</surname><given-names>F</given-names></name><name><surname>O'Rourke</surname><given-names>SM</given-names></name><name><surname>Stucke</surname><given-names>VM</given-names></name><name><surname>Jaquenoud</surname><given-names>M</given-names></name><name><surname>Neiman</surname><given-names>AM</given-names></name><etal/></person-group><year>2000</year><article-title>Phosphorylation of the MEKK Ste11p by the PAK-like kinase Ste20p is required for MAP kinase signaling in vivo</article-title><source>Curr Biol</source><volume>10</volume><fpage>630</fpage><lpage>639</lpage><pub-id pub-id-type="pmid">10837245</pub-id></citation></ref><ref id="ppat-0030162-b016"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harris</surname><given-names>SD</given-names></name></person-group><year>1999</year><article-title>Morphogenesis is coordinated with nuclear division in germinating <named-content content-type="genus-species">Aspergillus nidulans</named-content> conidiospores</article-title><source>Microbiology</source><volume>145</volume><fpage>2747</fpage><lpage>2756</lpage><pub-id pub-id-type="pmid">10537196</pub-id></citation></ref><ref id="ppat-0030162-b017"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Momany</surname><given-names>M</given-names></name><name><surname>Westfall</surname><given-names>PJ</given-names></name><name><surname>Abramowsky</surname><given-names>G</given-names></name></person-group><year>1999</year><article-title><named-content content-type="genus-species">Aspergillus nidulans</named-content> swo mutants show defects in polarity establishment, polarity maintenance and hyphal morphogenesis</article-title><source>Genetics</source><volume>151</volume><fpage>557</fpage><lpage>567</lpage><pub-id pub-id-type="pmid">9927451</pub-id></citation></ref><ref id="ppat-0030162-b018"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Osherov</surname><given-names>N</given-names></name><name><surname>May</surname><given-names>G</given-names></name></person-group><year>2000</year><article-title>Conidial germination in <named-content content-type="genus-species">Aspergillus nidulans</named-content> requires RAS signaling and protein synthesis</article-title><source>Genetics</source><volume>155</volume><fpage>647</fpage><lpage>656</lpage><