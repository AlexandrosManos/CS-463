rson-group-type="author"><name><surname>Strauss</surname><given-names>BS</given-names></name></person-group><article-title>The &#x02018;A rule&#x02019; of mutagen specificity: a consequence of DNA polymerase bypass of non-instructional lesions?</article-title><source>Bioessays</source><year>1991</year><volume>13</volume><fpage>79</fpage><lpage>84</lpage><pub-id pub-id-type="pmid">2029269</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Shibutani</surname><given-names>S</given-names></name><name><surname>Takeshita</surname><given-names>M</given-names></name><name><surname>Grollman</surname><given-names>AP</given-names></name></person-group><article-title>Translesional synthesis on DNA templates containing a single abasic site. A mechanistic study of the &#x02018;A rule&#x02019;</article-title><source>J. Biol. Chem.</source><year>1997</year><volume>272</volume><fpage>13916</fpage><lpage>13922</lpage><pub-id pub-id-type="pmid">9153253</pub-id></element-citation></ref><ref id="B19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Berthet</surname><given-names>N</given-names></name><name><surname>Roupioz</surname><given-names>Y</given-names></name><name><surname>Constant</surname><given-names>JF</given-names></name><name><surname>Kotera</surname><given-names>M</given-names></name><name><surname>Lhomme</surname><given-names>J</given-names></name></person-group><article-title>Translesional synthesis on DNA templates containing the 2&#x02032;-deoxyribonolactone lesion</article-title><source>Nucleic Acids Res.</source><year>2001</year><volume>29</volume><fpage>2725</fpage><lpage>2732</lpage><pub-id pub-id-type="pmid">11433017</pub-id></element-citation></ref><ref id="B20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hanse