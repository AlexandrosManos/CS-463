itation></ref><ref id="b8-ehp0115-a00482"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ofori-Adjai</surname><given-names>D</given-names></name><name><surname>Antes</surname><given-names>G</given-names></name><name><surname>Tharyan</surname><given-names>P</given-names></name><name><surname>Slade</surname><given-names>E</given-names></name><name><surname>Tamber</surname><given-names>PS</given-names></name></person-group><year>2006</year><article-title>Have online international medical journals made local journals obsolete?</article-title><source>PLoS Med</source><volume>3</volume><issue>8</issue><fpage>e359</fpage><pub-id pub-id-type="doi">10.1371/journal.pmed.0030359</pub-id><comment>Online 29 August 2006</comment><pub-id pub-id-type="pmid">16942397</pub-id></citation></ref><ref id="b9-ehp0115-a00482"><citation citation-type="web"><collab>PLoS (Public Library of Science)</collab><year>2007</year><article-title>PLoS Journals Homepage</article-title><comment>Available: <ext-link ext-link-type="uri" xlink:href="http://www.plos.org/journals/index.html">http://www.plos.org/journals/index.html</ext-link></comment><access-date>accessed 15 August 2007</access-date></citation></ref><ref id="b10-ehp0115-a00482"><citation citation-type="web"><collab>PubMed</collab><year>2007</year><article-title>PubMed Overview</article-title><comment>Available: <ext-link ext-link-type="uri" xlink:href="http://www.ncbi.nlm.nih.gov/entrez/query/static/overview.html">http://www.ncbi.nlm.nih.gov/entrez/query/static/overview.html</ext-link></comment><access-date>accessed 15 August 2007</access-date></citation></ref><ref id="b11-ehp0115-a00482"><citation citation-type="web"><collab>PubMed Central</collab><year>2007</year><article-title>PubMed Central Homepage</article-title><comment>Available: <ext-link ext-link-type="uri" xlink:href="http://www.pubmedcentral.nih.gov/">http://www.pubmedcentral.nih.gov/</ext-link></comment><access-date>accessed 15 August 2007</access-date></citation></ref><ref id="b12-ehp0115-a00482"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Richards</surname><given-names>T</given-names></name></person-group><year>2004</year><article-title>Poor countries lack relevant health information, says Cochrane editor</article-title><source>BMJ</source><volume>328</volume><issue>7435</issue><fpage>310</fpage><pub-id pub-id-type="doi">10.1136/bmj.328.7435.310-b</pub-id></citation></ref><ref id="b13-ehp0115-a00482"><citation citation-type="web"><collab>SCIELO</collab><year>2007</year><article-title>Scientific Electronic Library Online</article-title><comment>Available: <ext-link ext-link-type="uri" xlink:href="http://www.scielo.org/index.php?lang=en">http://www.scielo.org/index.php?lang=en</ext-link></comment><access-date>accessed 15 August 2007</access-date></citation></ref><ref id="b14-ehp0115-a00482"><citation citation-type="web"><person-group person-group-type="author"><name><surname>Sidibe</surname><given-names>S</given-names></name></person-group><year>2007</year><article-title>A dynamic and fruitful partnership</article-title><source>Mali Med </source><volume>22</volume><fpage>1</fpage><comment>Available: <ext-link ext-link-type="uri" xlink:href="http://www.ehponline.org/malimed/2007/p_ed1.pdf">http://www.ehponline.org/malimed/2007/p_ed1.pdf</ext-link></comment><access-date>accessed 15 August 2007</access-date></citation></ref><ref id="b15-ehp0115-a00482"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tillett</surname><given-names>T</given-names></name></person-group><year>2005</year><article-title>Global collaboration gives greater voice to African journals</article-title><source>Environ Heath Perspect</source><volume>113</volume><fpage>A452</fpage><lpage>A454</lpage></citation></ref></ref-list></back><floats-wrap><fig id="f1-ehp0115-a00482" position="float"><caption><p>Thomas J. Goehl</p></caption><graphic xlink:h