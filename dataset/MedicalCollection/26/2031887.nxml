2</volume><fpage>1805</fpage><lpage>1819</lpage><pub-id pub-id-type="pmid">16199826</pub-id><pub-id pub-id-type="doi">10.1176/appi.ajp.162.10.1805</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rihmer</surname><given-names>Z</given-names></name><name><surname>Belso</surname><given-names>N</given-names></name><name><surname>Kiss</surname><given-names>K</given-names></name></person-group><article-title>Strategies for suicide prevention</article-title><source>Curr Opin Psychiat</source><year>2002</year><volume>15</volume><fpage>83</fpage><lpage>87</lpage><pub-id pub-id-type="doi">10.1097/00001504-200201000-00014</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Henriksson</surname><given-names>MM</given-names></name><name><surname>Aro</surname><given-names>HM</given-names></name><name><surname>Marttunen</surname><given-names>MJ</given-names></name><name><surname>Heikkinen</surname><given-names>ME</given-names></name><name><surname>Isometsa</surname><given-names>ET</given-names></name><name><surname>Kuoppasalmi</surname><given-names>KI</given-names></name><name><surname>Lonnqvist</surname><given-names>JK</given-names></name></person-group><article-title>Mental disorders and comorbidity in suicide</article-title><source>Am J Psychiatry</source><year>1993</year><volume>150</volume><fpage>935</fpage><lpage>940</lpage><pub-id pub-id-type="pmid">8494072</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rihmer</surname><given-names>Z</given-names></name></person-group><article-title>Suicide risk in mood disorders</article-title><source>Curr Opin Psychiatry</source><year>2007</year><volume>20</volume><fpage>17</fpage><lpage>22</lpage><pub-id pub-id-type="pmid">17143077</pub-id><pub-id pub-id-type="doi">10.1097/YCO.0b013e3280106868</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barraclough</surname><given-names>B</given-names></name><name><surname>Bunch</surname><given-names>J</given-names></name><name><surname>Nelson</surname><given-names>B</given-names></name><name><surname>Sainsbury</surname><given-names>P</given-names></name></person-group><article-title>A hundred cases of suicide: clinical aspects</article-title><source>Br J Psychiatry</source><year>1974</year><volume>125</volume><fpage>355</fpage><lpage>373</lpage><pub-id pub-id-type="pmid">4425774</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Monkman</surname><given-names>M</given-names></name></person-group><article-title>Epidemiology of Suicide</article-title><source>Epidemiology Reviws</source><year>1987</year><volume>9</volume><fpage>51</fpage><lpage>62</lpage></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Badawi</surname><given-names>MA</given-names></name><name><surname>Eaton</surname><given-names>WW</given-names></name><name><surname>Myllyluoma</surname><given-names>J</given-names></name><name><surname>Weimer</surname><given-names>LG</given-names></name><name><surname>Gallo</surname><given-names>J</given-names></name></person-group><article-title>Psychopathology and attrition in the Baltimore ECA 15-year follow-up 1981-1996</article-title><source>Soc Psychiatry Psychiatr Epidemiol</source><year>1999</year><volume>34</volume><fpage>91</fpage><lpage>98</lpage><pub-id pub-id-type="pmid">10189815</pub-id><pub-id pub-id-type="doi">10.1007/s001270050117</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Isometsa</surname><given-names>ET</given-names></name><name><surname>Aro</surname><given-names>HM</given-names></name><name><surname>Henr