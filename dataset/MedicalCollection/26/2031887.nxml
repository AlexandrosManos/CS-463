ractice</source><year>2005</year><publisher-name>Washington, DC , American Psychiatric Press Publishing Inc.</publisher-name></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Uncapher</surname><given-names>H</given-names></name><name><surname>Gallagher-Thompson</surname><given-names>D</given-names></name><name><surname>Osgood</surname><given-names>NJ</given-names></name><name><surname>Bongar</surname><given-names>B</given-names></name></person-group><article-title>Hopelessness and suicidal ideation in older adults</article-title><source>Gerontologist</source><year>1998</year><volume>38</volume><fpage>62</fpage><lpage>70</lpage><pub-id pub-id-type="pmid">9499654</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Williams</surname><given-names>JM</given-names></name><name><surname>Crane</surname><given-names>C</given-names></name><name><surname>Barnhofer</surname><given-names>T</given-names></name><name><surname>Van der Does</surname><given-names>AJ</given-names></name><name><surname>Segal</surname><given-names>ZV</given-names></name></person-group><article-title>Recurrence of suicidal ideation across depressive episodes</article-title><source>J Affect Disord</source><year>2006</year><volume>91</volume><fpage>189</fpage><lpage>194</lpage><pub-id pub-id-type="pmid">16488023</pub-id><pub-id pub-id-type="doi">10.1016/j.jad.2006.01.002</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Valtonen</surname><given-names>H</given-names></name><name><surname>Suominen</surname><given-names>K</given-names></name><name><surname>Mantere</surname><given-names>O</given-names></name><name><surname>Leppamaki</surname><given-names>S</given-names></name><name><surname>Arvilommi</surname><given-names>P</given-names></name><name><surname>Isometsa</surname><given-name