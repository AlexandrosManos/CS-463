<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:mml="http://www.w3.org/1998/Math/MathML" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Australas. Chiropr. Osteopathy</journal-id><journal-title>Australasian Chiropractic &#x00026; Osteopathy</journal-title><issn pub-type="ppub">1328-0384</issn></journal-meta><article-meta><article-id pub-id-type="pmid">17987141</article-id><article-id pub-id-type="pmc">2050617</article-id><article-categories><subj-group subj-group-type="heading"><subject>Article</subject></subj-group></article-categories><title-group><article-title>CLASSIC MIGRAINE OR NOT CLASSIC MIGRAINE</article-title><subtitle>That is the Question</subtitle></title-group><contrib-group><contrib contrib-type="author"><name><surname>Tuchin</surname><given-names>Peter J.</given-names></name><degrees>B.Sc., Grad.Dip.(Chiro.), Dip.(O.H.S.).</degrees></contrib><contrib contrib-type="author"><name><surname>Bonello</surname><given-names>Rod</given-names></name><degrees>B.Sc., D.C., D.O., M.H.A.</degrees></contrib></contrib-group><pub-date pub-type="ppub"><month>11</month><year>1996</year></pub-date><volume>5</volume><issue>3</issue><fpage>66</fpage><lpage>74</lpage><copyright-statement>Chiropractic &#x00026; Osteopathic College of Australasia</copyright-statement><copyright-year>1996</copyright-year><abstract><p><italic>Objective:</italic> To identify the main characteristics of classic migraine, with specific regard to diagnostic criteria for manual therapy practitioners, including chiropractors and osteopaths.</p><p><italic>Method:</italic> Ten case studies on migraine were reviewed for the symptoms and clinical features.</p><p><italic>Results:</italic> The majority of cases reviewed as classic migraines were in reality not correct diagnoses in accordance with standard classification systems. Some cases had classic signs which may have been missinterpreted, whilst other cases had possible inconsistent symptoms making diagnosis difficult.</p><p><italic>Discussion:</italic> The various classification systems are presented with guidelines for diagnosis to assist practitioners making the accurate diagnosis.	  </p></abstract><kwd-group><kwd>Migraine</kwd><kwd>diagnosis</kwd><kwd>manual therapy.</kwd></kwd-group></article-meta></front></article>