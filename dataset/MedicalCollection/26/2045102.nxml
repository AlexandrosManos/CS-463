id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sanchez</surname><given-names>NP</given-names></name><name><surname>Van Hale</surname><given-names>HM</given-names></name><name><surname>Su</surname><given-names>WPD</given-names></name></person-group><article-title>Clinical and histopathologic spectrum of necrotizing vasculitis. Reports of finding in 101 cases</article-title><source>Arch Dermatol</source><year>1985</year><volume>121</volume><fpage>220</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">2858179</pub-id><pub-id pub-id-type="doi">10.1001/archderm.121.2.220</pub-id></citation></ref></ref-list></back></article>