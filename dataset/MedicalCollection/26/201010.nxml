ames></name></person-group><article-title>When to start and stop anticonvulsant therapy in children</article-title><source>Arch Neurol</source><year>1999</year><volume>56</volume><fpage>1073</fpage><lpage>1077</lpage><pub-id pub-id-type="pmid">10488807</pub-id><pub-id pub-id-type="doi">10.1001/archneur.56.9.1073</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schachter</surname><given-names>SC</given-names></name></person-group><article-title>Epilepsy: Quality of life and cost of care</article-title><source>Epilepsy behaviour</source><year>2000</year><volume>1</volume><fpage>120</fpage><lpage>127</lpage><pub-id pub-id-type="doi">10.1006/ebeh.2000.0049</pub-id></citation></ref><ref id="B13"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Livingston</surname><given-names>S</given-names></name></person-group><article-title>Comprehensive management of epilepsy in infancy, childhood and adolescence</article-title><source>Springfield Illinois, CC Thomas</source><year>1972</year></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Austin</surname><given-names>JK</given-names></name><name><surname>Smith</surname><given-names>MS</given-names></name><name><surname>Risinger</surname><given-names>MW</given-names></name><name><surname>McNelis</surname><given-names>A</given-names></name></person-group><article-title>Childhood epilepsy and asthma: Comparison of quality of life</article-title><source>Epilepsia</source><year>1994</year><volume>35</volume><fpage>608</fpage><lpage>615</lpage><pub-id pub-id-type="pmid">8026407</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mitchell</surname><given-names>WG</given-names></name><name><surname>Chavez</surname><given-names>JM</given-names></name><name><surname>Lee</surname>