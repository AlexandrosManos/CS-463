p><article-title>Effect of intermittent eccentric contractions on symptoms of muscle microinjury</article-title><source>Med Sci Sports Exer</source><year>1995</year><volume>27</volume><fpage>1378</fpage><lpage>1384</lpage><pub-id pub-id-type="pmid">8531608</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Ruiter</surname><given-names>CJ</given-names></name><name><surname>Jones</surname><given-names>DA</given-names></name><name><surname>Sargeant</surname><given-names>AJ</given-names></name><name><surname>De Haan</surname><given-names>A</given-names></name></person-group><article-title>The measurement of force/velocity relationships of fresh and fatigued human adductor pollicis muscle</article-title><source>European J App Physiol Occup Physiol</source><year>1999</year><volume>80</volume><fpage>386</fpage><lpage>93</lpage><pub-id pub-id-type="doi">10.1007/s004210050608</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lieber</surname><given-names>RL</given-names></name><name><surname>Friden</surname><given-names>J</given-names></name></person-group><article-title>Muscle damage is not a function of muscle force but active muscle strain</article-title><source>J Appl Physiol</source><year>1993</year><volume>74</volume><fpage>520</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">8458765</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sun</surname><given-names>JS</given-names></name><name><surname>Tsuang</surname><given-names>YH</given-names></name><name><surname>Liu</surname><given-names>TK</given-names></name><name><surname>Hang</surname><given-names>YS</given-names></name><name><surname>Cheng</surname><given-names>CK</given-names></name></person-group><article-title>Failure Sites and Peak Tensile Forces of the Composite Triceps Surae Muscle by Passive Extension in Rabbit</article-title><source>Clin Biomech</source><year>1994</year><volume>9</volume><fpage>310</fpage><lpage>4</lpage><pub-id pub-id-type="doi">10.1016/0268-0033(94)90044-2</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hang</surname><given-names>YS</given-names></name><name><surname>Tsuang</surname><given-names>YH</given-names></name><name><surname>Sun</surname><given-names>JS</given-names></name><name><surname>Cheng</surname><given-names>CK</given-names></name><name><surname>Liu</surname><given-names>TK</given-names></name></person-group><article-title>Failure of Stimulated Skeletal Muscle Mainly Contributed by Passive Force: An In-Vivo Rabbit's Model</article-title><source>Clin Biomech</source><year>1996</year><volume>11</volume><fpage>343</fpage><lpage>7</lpage><pub-id pub-id-type="doi">10.1016/0268-0033(96)00004-6</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Woittiez</surname><given-names>RD</given-names></name><name><surname>Huijing</surname><given-names>PA</given-names></name><name><surname>Boom</surname><given-names>HB</given-names></name><name><surname>Rozendal</surname><given-names>RH</given-names></name></person-group><article-title>A three-dimensional muscle model: a quantified relation between form and function of skeletal muscles</article-title><source>J Morphol</source><year>1984</year><volume>182</volume><fpage>95</fpage><lpage>113</lpage><pub-id pub-id-type="pmid">6492171</pub-id><pub-id pub-id-type="doi">10.1002/jmor.1051820107</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaufman</surname><given-names>KR</given-names></name><name><surname>An</surname><given-names>KN</given-names></name><name><surname>Chao</surname><given-names>EYS</given-names></name></person-group><art