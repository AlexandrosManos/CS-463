le-title>Additivity of protein and non-protein inhibitors of lung surfactant activity.</article-title><source>Am J Respir Crit Care Med</source><volume>158</volume><fpage>28</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">9655703</pub-id></citation></ref><ref id="pone.0001039-Holm2"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Holm</surname><given-names>BA</given-names></name><name><surname>Wang</surname><given-names>Z</given-names></name><name><surname>Notter</surname><given-names>RH</given-names></name></person-group><year>1999</year><article-title>Multiple mechanisms of lung surfactant inhibition.</article-title><source>Pediatr Res</source><volume>46</volume><fpage>85</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">10400140</pub-id></citation></ref><ref id="pone.0001039-Lewis1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lewis</surname><given-names>JF</given-names></name><name><surname>Brackenbury</surname><given-names>A</given-names></name></person-group><year>2003</year><article-title>Role of exogenous surfactant in acute lung injury.</article-title><source>Crit Care Med</source><volume>31</volume><issue>suppl</issue><fpage>S324</fpage><lpage>S328</lpage><pub-id pub-id-type="pmid">12682460</pub-id></citation></ref><ref id="pone.0001039-Notter2"><label>14</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Notter</surname><given-names>RH</given-names></name><name><surname>Finkelstein</surname><given-names>JN</given-names></name><name><surname>Holm</surname><given-names>BA</given-names></name><name><surname>editors</surname></name></person-group><year>2005</year><article-title>Lung injury: Mechanisms, pathophysiology and therapy.</article-title><publisher-loc>Boca Raton</publisher-loc><publisher-name>Taylor Francis Group, Inc</publisher-name><fpage>847</fpage></citation></ref><ref id="pone.0001039-Griese1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Griese</surname><given-names>M</given-names></name></person-group><year>1999</year><article-title>Pulmonary surfactant in health and human lung diseases: State of the art.</article-title><source>Eur Respir J</source><volume>13</volume><fpage>1455</fpage><lpage>1476</lpage><pub-id pub-id-type="pmid">10445627</pub-id></citation></ref><ref id="pone.0001039-Bernard1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bernard</surname><given-names>GR</given-names></name><name><surname>Artigas</surname><given-names>A</given-names></name><name><surname>Brigham</surname><given-names>KL</given-names></name><name><surname>Carlet</surname><given-names>J</given-names></name><name><surname>Falke</surname><given-names>K</given-names></name><etal/></person-group><year>1994</year><article-title>The American-European Consensus Conference on ARDS: Definitions, mechanisms, relevant outcomes, and clinical trial coordination.</article-title><source>Am J Respir Crit Care Med</source><volume>149</volume><fpage>818</fpage><lpage>824</lpage><pub-id pub-id-type="pmid">7509706</pub-id></citation></ref><ref id="pone.0001039-Artigas1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Artigas</surname><given-names>A</given-names></name><name><surname>Bernard</surname><given-names>GR</given-names></name><name><surname>Carlet</surname><given-names>J</given-names></name><name><surname>Dreyfuss</surname><given-names>D</given-names></name><name><surname>Gattinoni</surname><given-names>L</given-names></name><etal/></person-group><year>1998</year><article-title>The American-European consensus conference on ARDS, Part 2: Ventilatory, pharmacologic, supportive therapy, study design strategies and issues related to recovery and remodeling.</article-title><source>Intensive Care Med</source><volume>24</volume><fpage>378</fpage><lpage>398</lpage><pub-id pub-id-type="pmid">9609420</pub-id></citation></ref><ref id="pone.0001039-Goss1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goss</surname><given-names>CH</given-names></name><name><surname>Brower</surname><given-names>RG</given-names></name><name><surname>Hudson</surname><given-names>LD</given-names></name><name><surname>Rubenfeld</surname><given-names>GD</given-names></name></person-group><collab>ARDS Network</collab><year>2003</year><article-title>Incidence of acute lung injury in the United States.</article-title><source>Crit Care Med</source><volume>31</volume><fpage>1607</fpage><lpage>1611</lpage><pub-id pub-id-type="pmid">12794394</pub-id></citation></ref><ref id="pone.0001039-Rubenfeld1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rubenfeld</surname><given-names>GD</given-names></name></person-group><year>2003</year><article-title>Epidemiology of acute lung injury.</article-title><source>Crit Care Med</source><volume>31</volume><issue>suppl</issue><fpage>S276</fpage><lpage>S284</lpage><pub-id pub-id-type="pmid">12682453</pub-id></citation></ref><ref id="pone.0001039-Chess1"><label>20</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Chess</surname><given-names>P</given-names></name><name><surname>Finkelstein</surname><given-names>JN</given-names></name><name><surname>Holm</surname><given-names>BA</given-names></name><name><surname>Notter</surname><given-names>RH</given-names></name></person-group><year>2005</year><article-title>Surfactant replacement therapy in lung injury.</article-title><person-group person-group-type="editor"><name><surname>Notter</surname><given-names>RH</given-names></name><name><surname>Finkelstein</surname><given-names>JN</given-names></name><name><surname>Holm</surname><given-names>BA</given-names></name></person-group><source>Lung injury: Mechanisms, pathophysiology, and therapy</source><publisher-loc>Boca Raton</publisher-loc><publisher-name>Taylor Francis Group, Inc</publisher-name><fpage>617</fpage><lpage>663</lpage></citation></ref><ref id="pone.0001039-Wang2"><label>21</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>Z</given-names></name><name><surname>Holm</surname><given-names>BA</given-names></name><name><surname>Matalon</surname><given-names>S</given-names></name><name><surname>Notter</surname><given-names>RH</given-names></name></person-group><year>2005</year><article-title>Surfactant activity and dysfunction in lung injury.</article-title><person-group person-group-type="editor"><name><surname>Notter</surname><given-names>RH</given-names></name><name><surname>Finkelstein</surname><given-names>JN</given-names></name><name><surname>Holm</surname><given-names>BA</given-names></name></person-group><source>Lung injury: Mechanisms, pathophysiology, and therapy</source><publisher-loc>Boca Raton</publisher-loc><publisher-name>Taylor Francis Group, Inc</publisher-name><fpage>297</fpage><lpage>352</lpage></citation></ref><ref id="pone.0001039-Turcotte1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Turcotte</surname><given-names>JG</given-names></name><name><surname>Lin</surname><given-names>WH</given-names></name><name><surname>Pivarnik</surname><given-names>PE</given-names></name><name><surname>Sacco</surname><given-names>AM</given-names></name><name><surname>Bermel</surname><given-names>MS</given-names></name><etal/></person-group><year>1991</year><article-title>Chemical synthesis and surface activity of lung surfactant phospholipid analogs. II. Racemic N-substituted diether phosphonolipids.</article-title><source>Biochim Biophys Acta</source><volume>1084</volume><fpage>1</fpage><lpage>12</lpage><pub-id pub-id-type=