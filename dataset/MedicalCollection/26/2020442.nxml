e><source>N Engl J Med</source><volume>351</volume><fpage>2805</fpage><lpage>2816</lpage><pub-id pub-id-type="pmid">15625332</pub-id></citation></ref><ref id="pone.0001060-Bellmann1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bellmann</surname><given-names>C</given-names></name><name><surname>Feely</surname><given-names>M</given-names></name><name><surname>Crossland</surname><given-names>MD</given-names></name><name><surname>Kabanarou</surname><given-names>SA</given-names></name><name><surname>Rubin</surname><given-names>GS</given-names></name></person-group><year>2004</year><article-title>Fixation stability using central and pericentral fixation targets in patients with age-related macular degeneration.</article-title><source>Ophthalmology</source><volume>111</volume><fpage>2265</fpage><lpage>2270</lpage><pub-id pub-id-type="pmid">15582084</pub-id></citation></ref><ref id="pone.0001060-Culham1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Culham</surname><given-names>LE</given-names></name><name><surname>Fitzke</surname><given-names>FW</given-names></name><name><surname>Timberlake</surname><given-names>GT</given-names></name><name><surname>Marshall</surname><given-names>J</given-names></name></person-group><year>1993</year><article-title>Assessment of fixation stability in normal subjects and patients using a scanning laser ophthalmoscope.</article-title><source>Clin Vision Sci</source><volume>8</volume><fpage>551</fpage><lpage>561</lpage></citation></ref><ref id="pone.0001060-Crossland1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crossland</surname><given-names>MD</given-names></name><name><surname>Culham</surname><given-names>LE</given-names></name><name><surname>Kabanarou</surname><given-names>SA</given-names></name><name><surname>Rubin</surname><given-names>GS</given-names></name></person-group><year>2005</year><article-title>Preferred retinal locus development in patients with macular disease.</article-title><source>Ophthalmology</source><volume>112</volume><fpage>1579</fpage><lpage>1585</lpage><pub-id pub-id-type="pmid">16087239</pub-id></citation></ref><ref id="pone.0001060-Timberlake1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Timberlake</surname><given-names>GT</given-names></name><name><surname>Mainster</surname><given-names>MA</given-names></name><name><surname>Peli</surname><given-names>E</given-names></name><name><surname>Augliere</surname><given-names>RA</given-names></name><name><surname>Essock</surname><given-names>EA</given-names></name><etal/></person-group><year>1986</year><article-title>Reading with a macular scotoma. I. Retinal location of scotoma and fixation area.</article-title><source>Invest Ophthalmol Vis Sci</source><volume>27</volume><fpage>1137</fpage><lpage>1147</lpage><pub-id pub-id-type="pmid">3721792</pub-id></citation></ref><ref id="pone.0001060-Whittaker1"><label>18</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Whittaker</surname><given-names>SG</given-names></name><name><surname>Cummings</surname><given-names>RW</given-names></name></person-group><year>1986</year><article-title>Redevelopment of fixation and scanning eye movements following the loss of foveal function.</article-title><person-group person-group-type="editor"><name><surname>Hilfer</surname><given-names>SR</given-names></name><name><surname>Sheffield</surname><given-names>JB</given-names></name></person-group><source>Development of order in the visual system</source><publisher-loc>New York</publisher-loc><publisher-name>Springer-Verlang</publisher-name></citation></ref><ref id="pone.0001060-Aulhorn1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Aulhorn</surname><given-n