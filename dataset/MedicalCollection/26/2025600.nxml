n-group><article-title>Isolated congenital urethrocutaneous fistula</article-title><source>Int J Urol</source><year>2005</year><volume>12</volume><fpage>417</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">15948735</pub-id><pub-id pub-id-type="doi">10.1111/j.1442-2042.2005.01050.x</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kanuck</surname><given-names>DM</given-names></name><name><surname>Zgonis</surname><given-names>T</given-names></name><name><surname>Jolly</surname><given-names>GP</given-names></name></person-group><article-title>Necrotizing fasciitis in a patient with type 2 diabetes mellitus</article-title><source>J Am Podiatr Med Assoc</source><year>2006</year><volume>96</volume><fpage>67</fpage><lpage>72</lpage><pub-id pub-id-type="pmid">16415286</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grandhi</surname><given-names>TM</given-names></name><name><surname>Shelley</surname><given-names>O</given-names></name><name><surname>Ray</surname><given-names>AK</given-names></name><name><surname>McGregor</surname><given-names>JR</given-names></name></person-group><article-title>Dorsal urethral fistula: case report and review of literature</article-title><source>Urology</source><year>2004</year><volume>63</volume><fpage>175</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">14751383</pub-id><pub-id pub-id-type="doi">10.1016/j.urology.2003.09.031</pub-id></citation></ref></ref-list></back></article>