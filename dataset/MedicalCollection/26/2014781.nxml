volume><fpage>199</fpage><lpage>205</lpage><pub-id pub-id-type="pmid">15932626</pub-id><pub-id pub-id-type="doi">10.1111/j.1744-313X.2005.00508.x</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Biggin</surname><given-names>A</given-names></name><name><surname>Henke</surname><given-names>R</given-names></name><name><surname>Bennetts</surname><given-names>B</given-names></name><name><surname>Thorburn</surname><given-names>DR</given-names></name><name><surname>Christodoulou</surname><given-names>J</given-names></name></person-group><article-title>Mutation screening of the mitochondrial genome using denaturing high-performance liquid chromatography</article-title><source>Mol Genet Metab</source><year>2005</year><volume>84</volume><fpage>61</fpage><lpage>74</lpage><pub-id pub-id-type="pmid">15639196</pub-id><pub-id pub-id-type="doi">10.1016/j.ymgme.2004.09.011</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meierhofer</surname><given-names>D</given-names></name><name><surname>Mayr</surname><given-names>JA</given-names></name><name><surname>Ebner</surname><given-names>S</given-names></name><name><surname>Sperl</surname><given-names>W</given-names></name><name><surname>Kofler</surname><given-names>B</given-names></name></person-group><article-title>Rapid screening of the entire mitochondrial DNA for low-level heteroplasmic mutations</article-title><source>Mitochondrion</source><year>2005</year><volume>5</volume><fpage>282</fpage><lpage>296</lpage><pub-id pub-id-type="pmid">16050991</pub-id><pub-id pub-id-type="doi">10.1016/j.mito.2005.06.001</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parr</surname><given-names>RL</given-names></name><name><surname>Maki</surname><given-names>J</given-names></name><name><surname>Reguly</surname><gi