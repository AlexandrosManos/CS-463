nal"><person-group person-group-type="author"><name><surname>DeLuca</surname><given-names>DS</given-names></name><name><surname>Khattab</surname><given-names>B</given-names></name><name><surname>Blasczyk</surname><given-names>R</given-names></name></person-group><article-title>A modular concept of HLA for comprehensive peptide binding prediction</article-title><source>Immunogenetics</source><year>2007</year><volume>59</volume><fpage>25</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">17119951</pub-id><pub-id pub-id-type="doi">10.1007/s00251-006-0176-4</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tong</surname><given-names>JC</given-names></name><name><surname>Tan</surname><given-names>TW</given-names></name><name><surname>Ranganathan</surname><given-names>S</given-names></name></person-group><article-title>Modeling the structure of bound peptide ligands to major histocompatibility complex</article-title><source>Protein Sci</source><year>2004</year><volume>13</volume><fpage>2523</fpage><lpage>2532</lpage><pub-id pub-id-type="pmid">15322290</pub-id><pub-id pub-id-type="doi">10.1110/ps.04631204</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tong</surname><given-names>JC</given-names></name><name><surname>Bramson</surname><given-names>J</given-names></name><name><surname>Kanduc</surname><given-names>D</given-names></name><name><surname>Chow</surname><given-names>S</given-names></name><name><surname>Sinha</surname><given-names>AA</given-names></name><name><surname>Ranganathan</surname><given-names>S</given-names></name></person-group><article-title>Modeling the bound conformation of pemphigus vulgaris-associated peptides to MHC class II DR and DQ alleles</article-title><source>Immunome Res</source><year>2006</year><volume>2</volume><fpage>1</fpage><pub-id pub-id-type="pmid">16426456</pub-id><pub-id pub-id-