d="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wolsko</surname><given-names>PM</given-names></name><name><surname>Eisenberg</surname><given-names>DM</given-names></name><name><surname>Davis</surname><given-names>RB</given-names></name><name><surname>Ettner</surname><given-names>SL</given-names></name><name><surname>Phillips</surname><given-names>RS</given-names></name></person-group><article-title>Insurance coverage, medical conditions, and visits to alternative medicine providers: results of a national survey</article-title><source>Arch Intern Med</source><year>2002</year><volume>162</volume><fpage>281</fpage><lpage>287</lpage><pub-id pub-id-type="pmid">11822920</pub-id><pub-id pub-id-type="doi">10.1001/archinte.162.3.281</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vincent</surname><given-names>C</given-names></name><name><surname>Furnham</surname><given-names>A</given-names></name><name><surname>Willsmore</surname><given-names>M</given-names></name></person-group><article-title>The perceived efficacy of complementary and orthodox medicine in complementary and general practice patients</article-title><source>Health Educ Res</source><year>1995</year><volume>10</volume><fpage>395</fpage><lpage>405</lpage><pub-id pub-id-type="pmid">10159673</pub-id><pub-id pub-id-type="doi">10.1093/her/10.4.395-a</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McGregor</surname><given-names>KJ</given-names></name><name><surname>Peay</surname><given-names>ER</given-names></name></person-group><article-title>The choice of alternative therapy for health care: testing some propositions</article-title><source>Soc Sci Med</source><year>1996</year><volume>43</volume><fpage>1317</fpage><lpage>1327</lpage><pub-id pub-id-type="pmid">8913002</pub-id><pub-id pub-id-type="doi">10.1016/0277-9536(95)00405-X</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Swartzman</surname><given-names>LC</given-names></name><name><surname>Harshman</surname><given-names>RA</given-names></name><name><surname>Burkell</surname><given-names>J</given-names></name><name><surname>Lundy</surname><given-names>ME</given-names></name></person-group><article-title>What accounts for the appeal of complementary/alternative medicine, and what makes complementary/alternative medicine "alternative"?</article-title><source>Med Decis Making</source><year>2002</year><volume>22</volume><fpage>431</fpage><lpage>450</lpage><pub-id pub-id-type="pmid">12365485</pub-id><pub-id pub-id-type="doi">10.1177/027298902320556127</pub-id></citation></ref><ref id="B10"><citation citation-type="other"><article-title>1<sup>st </sup>NCCAM Strategic Plan, page 26</article-title><ext-link ext-link-type="uri" xlink:href="http://nccam.nih.gov/about/plans/fiveyear/index.htm"/></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adams</surname><given-names>PF</given-names></name><name><surname>Schoenborn</surname><given-names>CA</given-names></name></person-group><article-title>Vital Health Stat 10</article-title><source>Health behaviors of adults: United States, 2002&#x02013;04</source><year>2006</year><volume>230</volume><fpage>1</fpage><lpage>140</lpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schoenborn</surname><given-names>CA</given-names></name><name><surname>Adams</surname><given-names>PF</given-names></name><name><surname>Barnes</surname><given-names>PM</given-names></name><name><surname>Vickerie</surname><given-names>JL</given-names></name><name><surname>Schiller</surname><given-names>JS</given-names></name></person-group><article-title>Vital Health Stat 10</article-title><sour