the floor of the mouth</article-title><source>J Oral Maxillofac Surg</source><year>1998</year><volume>56</volume><fpage>70</fpage><lpage>74</lpage><pub-id pub-id-type="pmid">9437985</pub-id><pub-id pub-id-type="doi">10.1016/S0278-2391(98)90919-3</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koca</surname><given-names>H</given-names></name><name><surname>Seckin</surname><given-names>T</given-names></name><name><surname>Sipahi</surname><given-names>A</given-names></name><name><surname>Kazanc</surname><given-names>A</given-names></name></person-group><article-title>Epidermoid cyst in the floor of the mouth: Report of a case</article-title><source>Quintessence Int</source><year>2007</year><volume>38</volume><fpage>473</fpage><lpage>477</lpage><pub-id pub-id-type="pmid">17625630</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Ponte</surname><given-names>FS</given-names></name><name><surname>Brunelli</surname><given-names>A</given-names></name><name><surname>Marchetti</surname><given-names>E</given-names></name><name><surname>Bottini</surname><given-names>DJ</given-names></name></person-group><article-title>Sublingual epidermoid cyst</article-title><source>J Craniofac Surg</source><year>2002</year><volume>13</volume><fpage>308</fpage><lpage>310</lpage><pub-id pub-id-type="pmid">12000893</pub-id><pub-id pub-id-type="doi">10.1097/00001665-200203000-00024</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Al-Khayat</surname><given-names>M</given-names></name><name><surname>Kenyon</surname><given-names>GS</given-names></name></person-group><article-title>Midline sublingual dermoid cyst</article-title><source>J Laryngol Otol</source><year>1990</year><volume>104</volume><fpage>578</fpage><lpage>580</lpage><pub-id pub-id-type="pmid">2384716</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yilmaz</surname><given-names>I</given-names></name><name><surname>Yilmazer</surname><given-names>C</given-names></name><name><surname>Yavuz</surname><given-names>H</given-names></name><name><surname>Bal</surname><given-names>N</given-names></name><name><surname>Ozluoglu</surname><given-names>LN</given-names></name></person-group><article-title>Giant sublingual epidermoid cyst: a report of two cases</article-title><source>J Laryngol Otol</source><year>2006</year><volume>120</volume><fpage>E19</fpage><pub-id pub-id-type="pmid">16917995</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lowry</surname><given-names>RE</given-names></name><name><surname>Tempero</surname><given-names>RM</given-names></name><name><surname>Davis</surname><given-names>LF</given-names></name></person-group><article-title>Epidermoid cyst of the floor of the mouth</article-title><source>J Oral Surg</source><year>1979</year><volume>37</volume><fpage>271</fpage><pub-id pub-id-type="pmid">285233</pub-id></citation></ref></ref-list></back></article>