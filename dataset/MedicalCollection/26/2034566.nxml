ame><name><surname>Apfelbaum</surname><given-names>M</given-names></name><name><surname>Crepaldi</surname><given-names>G</given-names></name><name><surname>Gries</surname><given-names>A</given-names></name><name><surname>Lefebvre</surname><given-names>P</given-names></name><name><surname>Turner</surname><given-names>P</given-names></name></person-group><article-title>International trial of long-term dexfenfluramine in obesity</article-title><source>Lancet</source><year>1989</year><volume>2</volume><fpage>1142</fpage><lpage>1145</lpage><pub-id pub-id-type="pmid">2572857</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(89)91499-2</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>BK</given-names></name><name><surname>York</surname><given-names>DA</given-names></name><name><surname>Bray</surname><given-names>GA</given-names></name></person-group><article-title>Chronic d-fenfluramine treatment reduces fat intake independent of macronutrient preference</article-title><source>Pharmacol Biochem Behav</source><year>1998</year><volume>60</volume><fpage>105</fpage><lpage>114</lpage><pub-id pub-id-type="pmid">9610931</pub-id><pub-id pub-id-type="doi">10.1016/S0091-3057(97)00549-2</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blundell</surname><given-names>JE</given-names></name><name><surname>Halford</surname><given-names>JCG</given-names></name></person-group><article-title>Serotonin and appetite regulation. Implications for the pharmacological treatment of obesity</article-title><source>CNS Drugs</source><year>1998</year><volume>9</volume><fpage>473</fpage><lpage>495</lpage><pub-id pub-id-type="doi">10.2165/00023210-199809060-00005</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maffei</surname><given-names>M</given-names></name><name><surname>Halaas</surname><given-names>J</given-names></name><name><surname>Ravussin</surname><given-names>E</given-names></name><name><surname>Pratley</surname><given-names>RE</given-names></name><name><surname>Lee</surname><given-names>GH</given-names></name><name><surname>Zhang</surname><given-names>Y</given-names></name><name><surname>Pei</surname><given-names>H</given-names></name><name><surname>Kim</surname><given-names>S</given-names></name><name><surname>Lallone</surname><given-names>R</given-names></name><name><surname>Ranganathan</surname><given-names>S</given-names></name><name><surname>Kern</surname><given-names>PA</given-names></name><name><surname>Friedman</surname><given-names>JM</given-names></name></person-group><article-title>Leptin levels in human and rodent: measurement of plasma leptin and obRNA in obese and weight reduced subjects</article-title><source>Nature Med</source><year>1995</year><volume>1</volume><fpage>1155</fpage><lpage>1161</lpage><pub-id pub-id-type="pmid">7584987</pub-id><pub-id pub-id-type="doi">10.1038/nm1195-1155</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schafe</surname><given-names>GE</given-names></name><name><surname>Thiele</surname><given-names>TE</given-names></name><name><surname>Bernstein</surname><given-names>HL</given-names></name></person-group><article-title>Conditioning method dramatically alters role of amygdala in taste aversion learning</article-title><source>Learn Mem</source><year>1998</year><volume>5</volume><fpage>481</fpage><lpage>492</lpage><pub-id pub-id-type="pmid">10489263</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Greenway</surname><given-names>FL</given-names></name><name><surname>Liu</surname><given-names>Z</given-names></name><name><surname>Martin</surname><given-names>CK</given-names></name><name><surname>Kai-yuan</surname><given-names>W</given-names></name><name><surname>Nofziger</surname><given-names>J</given-names></name><name><surname>Rood</surname><given-names>JC</given-names></name><name><surname>Yu</surname><given-names>Y</given-names></name><name><surname>Amen</surname><given-names>RJ</given-names></name></person-group><article-title>Safety and efficacy of NT, an herbal supplement, in treating human obesity</article-title><source>Int J Obes (Lond)</source><year>2006</year><volume>30</volume><fpage>1737</fpage><lpage>1741</lpage><pub-id pub-id-type="pmid">16652135</pub-id><pub-id pub-id-type="doi">10.1038/sj.ijo.0803343</pub-id></citation></ref></ref-list></back></article>