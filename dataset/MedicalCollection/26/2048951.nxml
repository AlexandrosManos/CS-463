year><volume>24</volume><fpage>275</fpage><lpage>79</lpage><pub-id pub-id-type="pmid">11213878</pub-id><pub-id pub-id-type="doi">10.2337/diacare.24.2.275</pub-id></citation></ref></ref-list></back></article>