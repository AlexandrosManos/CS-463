roup><year>1993</year><article-title>Exceptional fossil record: distribution of soft-tissue preservation through the Phanerozoic.</article-title><source>Geology</source><volume>21</volume><fpage>527</fpage><lpage>530</lpage></citation></ref><ref id="pone.0001121-Gaines1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gaines</surname><given-names>RR</given-names></name><name><surname>Kennedy</surname><given-names>MJ</given-names></name><name><surname>Droser</surname><given-names>ML</given-names></name></person-group><year>2005</year><article-title>A new hypothesis for organic preservation of Burgess Shale taxa in the middle Cambrian Wheeler Formation, House Range, Utah.</article-title><source>Palaeogeog, Palaeoclimat, Palaeoecol</source><volume>220</volume><fpage>193</fpage><lpage>205</lpage></citation></ref><ref id="pone.0001121-Allison2"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Allison</surname><given-names>PA</given-names></name><name><surname>Brett</surname><given-names>CE</given-names></name></person-group><year>1995</year><article-title><italic>In situ</italic> benthos and paleo-oxygenation in the Middle Cambrian Burgess Shale, British Columbia, Canada.</article-title><source>Geology</source><volume>23</volume><fpage>1079</fpage><lpage>1082</lpage></citation></ref><ref id="pone.0001121-Briggs1"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Briggs</surname><given-names>DEG</given-names></name><name><surname>Robison</surname><given-names>RA</given-names></name></person-group><year>1984</year><article-title>Exceptionally preserved nontrilobite arthropods and Anomalocaris from the Middle Cambrian of Utah.</article-title><source>Univ Kansas Paleontol Contribs, Paper</source><volume>111</volume><fpage>1</fpage><lpage>24</lpage></citation></ref><ref id="pone.0001121-2"><label>27</labe