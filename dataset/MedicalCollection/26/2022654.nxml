><td align="center" rowspan="1" colspan="1">2,120 (28)</td><td align="center" rowspan="1" colspan="1">336 (30)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;30&#x02013;34.9</td><td align="center" rowspan="1" colspan="1">856 (11)</td><td align="center" rowspan="1" colspan="1">125 (11)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02265; 35</td><td align="center" rowspan="1" colspan="1">313 (4)</td><td align="center" rowspan="1" colspan="1">38 (3)</td></tr><tr><td colspan="3" align="left" rowspan="1">No. of full-term live births</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;1</td><td align="center" rowspan="1" colspan="1">2,813 (37)</td><td align="center" rowspan="1" colspan="1">524 (46)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;2</td><td align="center" rowspan="1" colspan="1">2,306 (31)</td><td align="center" rowspan="1" colspan="1">433 (38)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02265; 3</td><td align="center" rowspan="1" colspan="1">2,348 (31)</td><td align="center" rowspan="1" colspan="1">176 (16)</td></tr><tr><td colspan="3" align="left" rowspan="1">Mother&#x02019;s ethnicity</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Czech/other</td><td align="center" rowspan="1" colspan="1">6,640 (89)</td><td align="center" rowspan="1" colspan="1">1,041 (92)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Roma</td><td align="center" rowspan="1" colspan="1">856 (11)</td><td align="center" rowspan="1" colspan="1">92 (8)</td></tr><tr><td colspan="3" align="left" rowspan="1">Mother&#x02019;s education</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Did not complete primary school</td><td align="center" rowspan="1" colspan="1">120 (2)</td><td align="center" rowspan="1" colspan="1">11 (1)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Primary school</td><td align="center" rowspan="1" colspan="1">1,587 (21)</td><td alig