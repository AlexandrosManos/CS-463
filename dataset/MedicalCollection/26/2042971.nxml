up person-group-type="author"><name><surname>Patrizi</surname><given-names>R</given-names><suffix>Pasceri,V., Sciahbasi,A., Summaria,F., Rosano,G., Lioy,E.</suffix></name></person-group><article-title>Evidence of cocaine-related coronary atherscolerosis in young patients with myocardial infarction</article-title><source>Journal of the American College of Cardiology</source><year>2006</year><volume>47</volume><fpage>2120</fpage><lpage>2122</lpage><pub-id pub-id-type="pmid">16697335</pub-id><pub-id pub-id-type="doi">10.1016/j.jacc.2005.12.060</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tanenbaum</surname><given-names>J</given-names><suffix>Miller,F.</suffix></name></person-group><article-title>Electrocardiographic evidence of myocardial injury in psychiatrically hospitalized cocaine abusers</article-title><source>Gen Hosp Psychiatry</source><year>1992</year><volume>14</volume><fpage>201</fpage><lpage>203</lpage><pub-id pub-id-type="pmid">1601297</pub-id><pub-id pub-id-type="doi">10.1016/0163-8343(92)90084-N</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dressler</surname><given-names>F</given-names><suffix>A., Malekzadeh,A., Roberts, W,C.,</suffix></name></person-group><article-title>Quantitative analysis of amounts of coronary arterial narrowing in cocaine addicts</article-title><source>Am J Cardiol</source><year>1990</year><volume>65</volume><fpage>303</fpage><lpage>308</lpage><pub-id pub-id-type="pmid">2301258</pub-id><pub-id pub-id-type="doi">10.1016/0002-9149(90)90292-9</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Amin</surname><given-names>M</given-names><suffix>Gabelman,G., Karpel,J., Buttrick,P.</suffix></name></person-group><article-title>Acute myocardial infarction and chest pain syndromes after cocaine use</art