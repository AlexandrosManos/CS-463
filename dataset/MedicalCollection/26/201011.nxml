ame>Andresen</surname><given-names>EM</given-names></name><name><surname>Fitch</surname><given-names>CA</given-names></name><name><surname>McLendon</surname><given-names>PM</given-names></name><name><surname>Meyers</surname><given-names>AR</given-names></name></person-group><article-title>Reliability and validity of disability questions for US Census 2000</article-title><source>Am J Public Health</source><year>2000</year><volume>90</volume><fpage>1297</fpage><lpage>1299</lpage><pub-id pub-id-type="pmid">10937013</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nelson</surname><given-names>DE</given-names></name><name><surname>Holtzman</surname><given-names>D</given-names></name><name><surname>Bolen</surname><given-names>J</given-names></name><name><surname>Stanwyck</surname><given-names>CA</given-names></name><name><surname>Mack</surname><given-names>KA</given-names></name></person-group><article-title>Reliability and validity of measures from the Behavioral Risk Factor Surveillance System (BRFSS)</article-title><source>Soz Praventivmed</source><year>2001</year><volume>46</volume><fpage>S3</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">11851091</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coker</surname><given-names>AL</given-names></name><name><surname>McKeown</surname><given-names>RE</given-names></name><name><surname>Sanderson</surname><given-names>M</given-names></name><name><surname>Davis</surname><given-names>KE</given-names></name><name><surname>Valois</surname><given-names>RF</given-names></name><name><surname>Huebner</surname><given-names>ES</given-names></name></person-group><article-title>Severe dating violence and quality of life among South Carolina high school students</article-title><source>Am J Prev Med</source><year>2000</year><volume>19</volume><fpage>220</fpage><lpage>227</lpage><pu