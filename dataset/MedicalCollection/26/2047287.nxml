 colspan="1"/></tr><tr><td rowspan="1" colspan="1">Cigarettes</td><td rowspan="1" colspan="1">464</td><td rowspan="1" colspan="1">98.5</td><td rowspan="1" colspan="1">135</td><td rowspan="1" colspan="1">99.3</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">599</td><td rowspan="1" colspan="1">98.7</td></tr><tr><td rowspan="1" colspan="1">Cigars</td><td rowspan="1" colspan="1">4</td><td rowspan="1" colspan="1">1</td><td rowspan="1" colspan="1">0</td><td rowspan="1" colspan="1">0</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">4</td><td rowspan="1" colspan="1">1</td></tr><tr><td rowspan="1" colspan="1">Pipe</td><td rowspan="1" colspan="1">1</td><td rowspan="1" colspan="1">0</td><td rowspan="1" colspan="1">0</td><td rowspan="1" colspan="1">0</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">1</td><td rowspan="1" colspan="1">0</td></tr><tr><td rowspan="1" colspan="1">Chewing tobacco or snuff</td><td rowspan="1" colspan="1">2</td><td rowspan="1" colspan="1">0</td><td rowspan="1" colspan="1">1</td><td rowspan="1" colspan="1">1</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">3</td><td rowspan="1" colspan="1">1</td></tr><tr><td rowspan="1" colspan="1"><bold>Cigarette use: daily or less than daily</bold></td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">.18</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">Daily</td><td rowspan="1" colspan="1">373</td><td rowspan="1" colspan="1">80.0</td><td rowspan="1" colspan="1">115</td><td rowspan="1" colspan="1">85.2</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">488</td><td rowspan="1" colspan="1">81.2</td></tr><tr><td rowspan="1" colspan="1"><bold>Smoking intensity at registration</bold></td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan=