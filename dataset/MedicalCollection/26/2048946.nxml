ation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simons</surname><given-names>WW</given-names></name><name><surname>Mandl</surname><given-names>KD</given-names></name><name><surname>Kohane</surname><given-names>IS</given-names></name></person-group><article-title>The PING personally controlled electronic medical record system: technical architecture</article-title><source>J Am Med Inform Assoc</source><year>2005</year><volume>12</volume><fpage>47</fpage><lpage>54</lpage><pub-id pub-id-type="pmid">15492031</pub-id><pub-id pub-id-type="doi">10.1197/jamia.M1592</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wright</surname><given-names>A</given-names></name><name><surname>Sittig</surname><given-names>DF</given-names></name></person-group><article-title>Encryption Characteristics of Two USB-based Personal Health Record Devices</article-title><source>J Am Med Inform Assoc</source><year>2007</year><volume>14</volume><fpage>397</fpage><lpage>399</lpage><pub-id pub-id-type="pmid">17460132</pub-id><pub-id pub-id-type="doi">10.1197/jamia.M2352</pub-id></citation></ref><ref id="B8"><citation citation-type="other"><article-title>NLM's Next Generation Internet (NGI) Awards</article-title><ext-link ext-link-type="uri" xlink:href="http://www.nlm.nih.gov/research/ngiinit.html"/></citation></ref><ref id="B9"><citation citation-type="other"><article-title>Healthcare Information Technology Standards Panel</article-title><ext-link ext-link-type="uri" xlink:href="http://www.ansi.org/standards_activities/standards_boards_panels/hisb/hitsp.aspx?menui d=3"/></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sax</surname><given-names>U</given-names></name><name><surname>Kohane</surname><given-names>I</given-names></name><name><surname>Mandl</surname><given-names>KD</given-names></name></person-group><article-title>Wireless technology infrastructures for authentication of patients: PKI that rings</article-title><source>J Am Med Inform Assoc</source><year>2005</year><volume>12</volume><fpage>263</fpage><lpage>268</lpage><pub-id pub-id-type="pmid">15684133</pub-id><pub-id pub-id-type="doi">10.1197/jamia.M1681</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weingart</surname><given-names>SN</given-names></name><name><surname>Rind</surname><given-names>D</given-names></name><name><surname>Tofias</surname><given-names>Z</given-names></name><name><surname>Sands</surname><given-names>DZ</given-names></name></person-group><article-title>Who uses the patient internet portal? The PatientSite experience</article-title><source>J Am Med Inform Assoc</source><year>2006</year><volume>13</volume><fpage>91</fpage><lpage>95</lpage><pub-id pub-id-type="pmid">16221943</pub-id><pub-id pub-id-type="doi">10.1197/jamia.M1833</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Riva</surname><given-names>A</given-names></name><name><surname>Mandl</surname><given-names>KD</given-names></name><name><surname>Oh</surname><given-names>DH</given-names></name><name><surname>Nigrin</surname><given-names>DJ</given-names></name><name><surname>Butte</surname><given-names>A</given-names></name><name><surname>Szolovits</surname><given-names>P</given-names></name><name><surname>Kohane</surname><given-names>IS</given-names></name></person-group><article-title>The personal internetworked notary and guardian</article-title><source>Int J Med Inform</source><year>2001</year><volume>62</volume><fpage>27</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">11340004</pub-id><pub-id pub-id-type="doi">10.1016/S1386-5056(00)00136-2</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Halamka</surname><given-names>J</given-names></name><name><surname>Aranow</surname><given-names>M</given-names></name><name><surname>Ascenzo</surname><given-names>C</given-names></name><name><surname>Bates</surname><given-names>D</given-names></name><name><surname>Debor</surname><given-names>G</given-names></name><name><surname>Glaser</surname><given-names>J</given-names></name><name><surname>Goroll</surname><given-names>A</given-names></name><name><surname>Stowe</surname><given-names>J</given-names></name><name><surname>Tripathi</surname><given-names>M</given-names></name><name><surname>Vineyard</surname><given-names>G</given-names></name></person-group><article-title>Health care IT collaboration in Massachusetts: the experience of creating regional connectivity</article-title><source>J Am Med Inform Assoc</source><year>2005</year><volume>12</volume><fpage>596</fpage><lpage>601</lpage><pub-id pub-id-type="pmid">16049225</pub-id><pub-id pub-id-type="doi">10.1197/jamia.M1866</pub-id></citation></ref><ref id="B14"><citation citation-type="other"><article-title>Summary of the NHIN Prototype Architecture Contracts: A Report for the Office of the National Coordinator for Health IT</article-title><ext-link ext-link-type="uri" xlink:href="http://www.hhs.gov/healthit/healthnetwork/resources/summary_report_on_nhin_Prototype_architectures.pdf"/></citation></ref><ref id="B15"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Bourgeois</surname><given-names>F</given-names></name><name><surname>Taylor</surname><given-names>P</given-names></name><name><surname>Mandl</surname><given-names>K</given-names></name></person-group><article-title>A proposed legal framework for addressing privacy for patient controlled health records in pediatrics</article-title><source>AMIA Annu Symp Proc</source><year>2007</year><fpage>861</fpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moen</surname><given-names>A</given-names></name><name><surname>Brennan</surname><given-names>PF</given-names></name></person-group><article-title>Health@Home: the work of health information management in the household (HIMH): implications for consumer health informatics (CHI) innovations</article-title><source>J Am Med Inform Assoc</source><year>2005</year><volume>12</volume><fpage>648</fpage><lpage>656</lpage><pub-id pub-id-type="pmid">16049230</pub-id><pub-id pub-id-type="doi">10.1197/jamia.M1758</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kawamoto</surname><given-names>K</given-names></name><name><surname>Lobach</surname><given-names>DF</given-names></name></person-group><article-title>Proposal for fulfilling strategic objectives of the U.S. Roadmap for national action on clinical decision support through a service-oriented architecture leveraging HL7 services</article-title><source>J Am Med Inform Assoc</source><year>2007</year><volume>14</volume><fpage>146</fpage><lpage>155</lpage><pub-id pub-id-type="pmid">17213489</pub-id><pub-id pub-id-type="doi">10.1197/jamia.M2298</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nadkarni</surname><given-names>PM</given-names></name><name><surname>Miller</surname><given-names>RA</given-names></name></person-group><article-title>Service-oriented architecture in medical software: promises and perils</article-title><source>J Am Med Inform Assoc</source><year>2007</year><volume>14</volume><fpage>244</fpage><lpage>246</lpage><pub-id pub-id-type="pmid">17213485</pub-id><pub-id pub-id-type="doi">10.1197/jamia.M2349</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cassa</surname><given-names>CA</given-names></name><name><surname>Grannis</surname><given-names>SJ</given