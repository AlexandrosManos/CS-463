<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:mml="http://www.w3.org/1998/Math/MathML" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="pmc">comsigrev</journal-id><journal-id journal-id-type="nlm-ta">COMSIG Rev</journal-id><journal-title>COMSIG review</journal-title><publisher><publisher-name>Chiropractors &#x00026; Osteopaths Musculo-Skeletal Interest Group</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmc">2050375</article-id><article-categories><subj-group subj-group-type="heading"><subject>Article</subject></subj-group></article-categories><title-group><article-title>VIBRATORY SENSATION TESTING</article-title><subtitle>Practice Tip</subtitle></title-group><contrib-group><contrib contrib-type="author"><name><surname>Reggars</surname><given-names>John W.</given-names></name><degrees>D.C., M.Chiro.Sc.</degrees></contrib></contrib-group><pub-date pub-type="ppub"><day>1</day><month>3</month><year>1995</year></pub-date><volume>4</volume><issue>1</issue><fpage>14</fpage><lpage>15</lpage><copyright-statement>Chiropractic &#x00026; Osteopathic College of Australasia</copyright-statement><copyright-year>1995</copyright-year><abstract><p>A valuable an often overlooked or under utilised clinical test is that of tuning fork testing for vibratory sensation. This simple and inexpensive test can be a most valuable tool in the detection of certain diseases of the nervous system as well as an aid in the differentiation between functional and organic symptoms.	  </p></abstract><kwd-group><kwd>Vibratory sensation</kwd><kwd>neurological examination</kwd><kwd>tuning fork</kwd><kwd>chiropractic</kwd></kwd-group></article-meta></front></article>