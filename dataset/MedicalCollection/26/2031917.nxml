n="1" colspan="1">0.30</td><td align="left" rowspan="1" colspan="1">Annual</td><td align="left" rowspan="1" colspan="1">0.7</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Pourouma bicolor</italic></td><td align="left" rowspan="1" colspan="1">294.4</td><td align="left" rowspan="1" colspan="1">17.9</td><td align="left" rowspan="1" colspan="1">3184</td><td align="left" rowspan="1" colspan="1">0.10</td><td align="left" rowspan="1" colspan="1">271.1</td><td align="left" rowspan="1" colspan="1">12.5</td><td align="left" rowspan="1" colspan="1">1.9</td><td align="left" rowspan="1" colspan="1"><bold>1896</bold></td><td align="left" rowspan="1" colspan="1">0.57</td><td align="left" rowspan="1" colspan="1">Annual</td><td align="left" rowspan="1" colspan="1">0.79</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Pourouma tomentosa</italic></td><td align="left" rowspan="1" colspan="1">6770.9</td><td align="left" rowspan="1" colspan="1">12.6</td><td align="left" rowspan="1" colspan="1">162815</td><td align="left" rowspan="1" colspan="1">0.00</td><td align="left" rowspan="1" colspan="1">11863.1</td><td align="left" rowspan="1" colspan="1">11.8</td><td align="left" rowspan="1" colspan="1">14.0</td><td align="left" rowspan="1" colspan="1"><bold>26898</bold></td><td align="left" rowspan="1" colspan="1">0.89</td><td align="left" rowspan="1" colspan="1">Annual</td><td align="left" rowspan="1" colspan="1">0.79</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Protium cf. sagotianum</italic></td><td align="left" rowspan="1" colspan="1">283.6</td><td align="left" rowspan="1" colspan="1">10.1</td><td align="left" rowspan="1" colspan="1">6301</td><td align="left" rowspan="1" colspan="1">0.00</td><td align="left" rowspan="1" colspan="1">327.7</td><td align="left" rowspan="1" colspan="1">11.9</td><td align="left" rowspan="1" colspan="1">7.8</td><td align="left" rowspan="1" colspan="1"><bold>3483</bold></td><td align="left" rowspan="1" colspan="1">0.71</td><td align="left" rowspan="1" colspan="1">Annual</td><td align="left" rowspan="1" colspan="1">1.41</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Pseudopiptadenia suaveolens</italic></td><td align="left" rowspan="1" colspan="1">11569.2</td><td align="left" rowspan="1" colspan="1">4.4</td><td align="left" rowspan="1" colspan="1">99659</td><td align="left" rowspan="1" colspan="1">0.21</td><td align="left" rowspan="1" colspan="1">7631.8</td><td align="left" rowspan="1" colspan="1">12.0</td><td align="left" rowspan="1" colspan="1">12.4</td><td align="left" rowspan="1" colspan="1"><bold>89241</bold></td><td align="left" rowspan="1" colspan="1">0.65</td><td align="left" rowspan="1" colspan="1">Annual</td><td align="left" rowspan="1" colspan="1">1.47</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Quararibea duckei</italic></td><td align="left" rowspan="1" colspan="1">254.3</td><td align="left" rowspan="1" colspan="1">22.4</td><td align="left" rowspan="1" colspan="1">4244</td><td align="left" rowspan="1" colspan="1">0.09</td><td align="left" rowspan="1" colspan="1">340.4</td><td align="left" rowspan="1" colspan="1">11.6</td><td align="left" rowspan="1" colspan="1">3.1</td><td align="left" rowspan="1" colspan="1"><bold>918</bold></td><td align="left" rowspan="1" colspan="1">0.89</td><td align="left" rowspan="1" colspan="1">Annual</td><td align="left" rowspan="1" colspan="1">0.44</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Qualea rosea</italic></td><td align="left" rowspan="1" colspan="1">3959.5</td><td align="left" rowspan="1" colspan="1">0.8</td><td align="left" rowspan="1" colspan="1"><bold>232</bold></td><td align="left" rowspan="1" colspan="1">0.91</td><td align="left" rowspan="1" colspan="1">-</td><td align="left" rowspan="1" colspan="1">-</td><td align="left" rowspan="1" colspan="1">-</td><td align="left" rowspan="1" colspan="1">-</td><td align="left" rowspan="1" colspan="1">-</td><td align="left" rowspan="1" colspan="1