id pub-id-type="pmid">16037527</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Van Kouwen</surname><given-names>MC</given-names></name><name><surname>Nagengast</surname><given-names>FM</given-names></name><name><surname>Jansen</surname><given-names>JB</given-names></name><name><surname>Oyen</surname><given-names>WJ</given-names></name><name><surname>Drenth</surname><given-names>JP</given-names></name></person-group><article-title>2-(18F)-fluoro-2-deoxy-D-glucose Positron emission tomography detects clinical relevant adenomas of the colon: A prospective study</article-title><source>J Clin Oncol</source><year>2005</year><volume>23</volume><fpage>3713</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15923568</pub-id><pub-id pub-id-type="doi">10.1200/JCO.2005.02.401</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tatlidil</surname><given-names>R</given-names></name><name><surname>Jadvar</surname><given-names>H</given-names></name><name><surname>Bading</surname><given-names>JR</given-names></name><name><surname>Conti</surname><given-names>PS</given-names></name></person-group><article-title>Incidental colonic fluorodeoxyglucose Uptake: correlation with Colonoscopic and histopathologic findings</article-title><source>Radiology</source><year>2002</year><volume>224</volume><fpage>783</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">12202714</pub-id><pub-id pub-id-type="doi">10.1148/radiol.2243011214</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Drenth</surname><given-names>JP</given-names></name><name><surname>Nagengast</surname><given-names>FM</given-names></name><name><surname>Oyen</surname><given-names>WJ</given-names></name></person-group><article-title>Evaluation of (pre-) malignant colonic Abnormalities: endoscopic validation of FDG-PET findings</article-title><source>Eur J Nucl Med</source><year>2001</year><volume>28</volume><fpage>1766</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">11734913</pub-id><pub-id pub-id-type="doi">10.1007/s002590100645</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arslan</surname><given-names>N</given-names></name><name><surname>Dehdashti</surname><given-names>F</given-names></name><name><surname>Siegel</surname><given-names>BA</given-names></name></person-group><article-title>FDG uptake in colonic villous adenomas</article-title><source>Ann Nucl Med</source><year>2005</year><volume>19</volume><fpage>331</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">16097645</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rubio</surname><given-names>CA</given-names></name><name><surname>Jaramillo</surname><given-names>E</given-names></name><name><surname>Sethyle</surname><given-names>J</given-names></name></person-group><article-title>Adenomas and carcinomas may be histologically Detected in apparently normal colonic mucosa. A study of carcinogen treated rats</article-title><source>In Vivo</source><year>2001</year><volume>15</volume><fpage>299</fpage><lpage>301</lpage><pub-id pub-id-type="pmid">11695221</pub-id></citation></ref></ref-list></back></article>