/ref><ref id="b29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mayer</surname><given-names>AF</given-names></name></person-group><article-title>An expression system matures: a highly efficient and cost-effective process for phytase production by recombinant strains of <italic>Hansenula polymorpha</italic></article-title><source>Biotechnol Bioeng</source><year>1999</year><volume>63</volume><fpage>373</fpage><lpage>381</lpage><pub-id pub-id-type="pmid">10099617</pub-id></citation></ref><ref id="b30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parlati</surname><given-names>F</given-names></name></person-group><article-title><italic>Saccharomyces cerevisiae</italic> CNE1 encodes an endoplasmic reticulum (ER) membrane protein with sequence similarity to calnexin and calreticulin and functions as a constituent of the ER quality control apparatus</article-title><source>J Biol Chem</source><year>1995</year><volume>270</volume><fpage>244</fpage><lpage>253</lpage><pub-id pub-id-type="pmid">7814381</pub-id></citation></ref><ref id="b31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ramezani-Rad</surname><given-names>M</given-names></name></person-group><article-title>The <italic>Hansenula polymorpha</italic> (strain CBS4732) genome sequencing and analysis</article-title><source>FEMS Yeast Res</source><year>2003</year><volume>4</volume><fpage>207</fpage><lpage>215</lpage><pub-id pub-id-type="pmid">14613885</pub-id></citation></ref><ref id="b32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Robinson</surname><given-names>AS</given-names></name></person-group><article-title>Protein disulfide overexpression enhances secretion of foreign proteins in <italic>Saccharomyces cerevisiae</italic></article-title><source>Bio/Technology</source><year>1994</year><volume>12</volume><fpage>381</fpage><lpage>384</lpag