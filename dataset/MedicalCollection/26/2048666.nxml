oup person-group-type="author"><name><surname>De Milito</surname><given-names>A</given-names></name><name><surname>Nilsson</surname><given-names>A</given-names></name><name><surname>Titanji</surname><given-names>K</given-names></name><name><surname>Thorstensson</surname><given-names>R</given-names></name><name><surname>Reizenstein</surname><given-names>E</given-names></name><etal/></person-group><year>2004</year><article-title>Mechanisms of Hypergammaglobulinemia and Impaired Antigen-Specific Humoral Immunity in Hiv-1 Infection.</article-title><source>Blood</source><volume>103</volume><fpage>2180</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">14604962</pub-id></citation></ref><ref id="pone.0001162-Hunziker1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hunziker</surname><given-names>L</given-names></name><name><surname>Recher</surname><given-names>M</given-names></name><name><surname>Macpherson</surname><given-names>AJ</given-names></name><name><surname>Ciurea</surname><given-names>A</given-names></name><name><surname>Freigang</surname><given-names>S</given-names></name><etal/></person-group><year>2003</year><article-title>Hypergammaglobulinemia and Autoantibody Induction Mechanisms in Viral Infections.</article-title><source>Nat Immunol</source><volume>4</volume><fpage>343</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">12627229</pub-id></citation></ref><ref id="pone.0001162-Recher1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Recher</surname><given-names>M</given-names></name><name><surname>Lang</surname><given-names>KS</given-names></name><name><surname>Hunziker</surname><given-names>L</given-names></name><name><surname>Freigang</surname><given-names>S</given-names></name><name><surname>Eschli</surname><given-names>B</given-names></name><etal/></person-group><year>2004</year><article-title>Deliberate Removal of T Cell Help Improves Vir