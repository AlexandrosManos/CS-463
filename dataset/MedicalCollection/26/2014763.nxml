ge><lpage>41</lpage><pub-id pub-id-type="pmid">8443113</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Groessl</surname><given-names>SA</given-names></name><name><surname>Sires</surname><given-names>BS</given-names></name><name><surname>Lemke</surname><given-names>BN</given-names></name></person-group><article-title>An anatomical basis for primary acquired nasolacrimal duct obstruction</article-title><source>Arch Ophthalmol</source><year>1997</year><volume>115</volume><fpage>71</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">9006428</pub-id></citation></ref><ref id="B10"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Camara</surname><given-names>JG</given-names></name><name><surname>Bengzon</surname><given-names>AU</given-names></name></person-group><article-title>Nasolacrimal duct obstruction</article-title><ext-link ext-link-type="uri" xlink:href="http://www.emedicine.com/oph/topic465.htm"/><comment>accessed 27 January 2005</comment></citation></ref></ref-list></back></article>