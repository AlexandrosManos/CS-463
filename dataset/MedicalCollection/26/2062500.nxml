>169</volume><fpage>3438</fpage><lpage>3446</lpage><pub-id pub-id-type="pmid">12218167</pub-id></citation></ref><ref id="pone.0001152-OConnor1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>O'Connor</surname><given-names>DH</given-names></name><name><surname>Mothe</surname><given-names>BR</given-names></name><name><surname>Weinfurter</surname><given-names>JT</given-names></name><name><surname>Fuenger</surname><given-names>S</given-names></name><name><surname>Rehrauer</surname><given-names>WM</given-names></name><etal/></person-group><year>2003</year><article-title>Major histocompatibility complex class I alleles associated with slow simian immunodeficiency virus disease progression bind epitopes recognized by dominant acute-phase cytotoxic-T-lymphocyte responses.</article-title><source>J Virol</source><volume>77</volume><fpage>9029</fpage><lpage>9040</lpage><pub-id pub-id-type="pmid">12885919</pub-id></citation></ref><ref id="pone.0001152-Yant1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yant</surname><given-names>LJ</given-names></name><name><surname>Friedrich</surname><given-names>TC</given-names></name><name><surname>Johnson</surname><given-names>RC</given-names></name><name><surname>May</surname><given-names>GE</given-names></name><name><surname>Maness</surname><given-names>NJ</given-names></name><etal/></person-group><year>2006</year><article-title>The high-frequency major histocompatibility complex class I allele Mamu-B&#x0002a;17 is associated with control of simian immunodeficiency virus SIVmac239 replication.</article-title><source>J Virol</source><volume>80</volume><fpage>5074</fpage><lpage>5077</lpage><pub-id pub-id-type="pmid">16641299</pub-id></citation></ref><ref id="pone.0001152-Phillips1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Phillips</surname><given-names>RE</given-names></name><name><surname>Rowland-Jones</surname><given-names>S</given-names></name><name><surname>Nixon</surname><given-names>DF</given-names></name><name><surname>Gotch</surname><given-names>FM</given-names></name><name><surname>Edwards</surname><given-names>JP</given-names></name><etal/></person-group><year>1991</year><article-title>Human immunodeficiency virus genetic variation that can escape cytotoxic T cell recognition.</article-title><source>Nature</source><volume>354</volume><fpage>453</fpage><lpage>459</lpage><pub-id pub-id-type="pmid">1721107</pub-id></citation></ref><ref id="pone.0001152-Koenig1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koenig</surname><given-names>S</given-names></name><name><surname>Conley</surname><given-names>AJ</given-names></name><name><surname>Brewah</surname><given-names>YA</given-names></name><name><surname>Jones</surname><given-names>GM</given-names></name><name><surname>Leath</surname><given-names>S</given-names></name><etal/></person-group><year>1995</year><article-title>Transfer of HIV-1-specific cytotoxic T lymphocytes to an AIDS patient leads to selection for mutant HIV variants and subsequent disease progression.</article-title><source>Nat Med</source><volume>1</volume><fpage>330</fpage><lpage>336</lpage><pub-id pub-id-type="pmid">7585062</pub-id></citation></ref><ref id="pone.0001152-Borrow2"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Borrow</surname><given-names>P</given-names></name><name><surname>Lewicki</surname><given-names>H</given-names></name><name><surname>Wei</surname><given-names>X</given-names></name><name><surname>Horwitz</surname><given-names>MS</given-names></name><name><surname>Peffer</surname><given-names>N</given-names></name><etal/></person-group><year>1997</year><article-title>Antiviral pressure exerted by HIV-1-specific cytotoxic T lymphocytes (CTLs) during primar