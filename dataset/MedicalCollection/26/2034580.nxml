n-names>RA</given-names></name><name><surname>Hillman</surname><given-names>R</given-names></name><name><surname>Walsh</surname><given-names>TR</given-names></name><name><surname>Bennett</surname><given-names>PM</given-names></name><name><surname>MacGowan</surname><given-names>AP</given-names></name></person-group><article-title>A modified population analysis profile method to detect <italic>Staphylococcus aureus </italic>with decreased susceptibilities to vancomycin in a UK hospital</article-title><source>J Antimicrob Chemother</source><year>2001</year><volume>47</volume><fpage>399</fpage><lpage>404</lpage><pub-id pub-id-type="pmid">11266410</pub-id><pub-id pub-id-type="doi">10.1093/jac/47.4.399</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>El Sohl</surname><given-names>N</given-names></name><name><surname>Davi</surname><given-names>M</given-names></name><name><surname>Morvan</surname><given-names>A</given-names></name><name><surname>Damon</surname><given-names>HA</given-names></name><name><surname>Marty</surname><given-names>N</given-names></name><name><surname>GISA</surname><given-names>Group</given-names></name><name><surname>RAISIN</surname><given-names>subgroup</given-names></name></person-group><article-title>Characteristics of French methicillin-resistant <italic>Staphylococcus aureus </italic>isolates with decreased susceptibility or resistance to glycopeptides</article-title><source>J Antimicrob Chemother</source><year>2003</year><volume>52</volume><fpage>691</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">12951351</pub-id><pub-id pub-id-type="doi">10.1093/jac/dkg400</pub-id></citation></ref><ref id="B24"><citation citation-type="other"><article-title>SPSS</article-title><ext-link ext-link-type="uri" xlink:href="http://spss.com"/></citation></ref></ref-list></back></article>