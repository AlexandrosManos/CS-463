article-title>Dissecting Protein&#x02013;Protein Recognition Sites</article-title><source>Proteins</source><year>2002</year><volume>47</volume><fpage>334</fpage><lpage>343</lpage><pub-id pub-id-type="pmid">11948787</pub-id><pub-id pub-id-type="doi">10.1002/prot.10085</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Keskin</surname><given-names>O</given-names></name><name><surname>Ma</surname><given-names>B</given-names></name><name><surname>Nussinov</surname><given-names>R</given-names></name></person-group><article-title>Hot Regions in Protein&#x02013;Protein Interactions: The Organization and Contribution of Structurally Conserved Hot Spot Residues</article-title><source>J Mol Biol</source><year>2005</year><volume>345</volume><fpage>1281</fpage><lpage>294</lpage><pub-id pub-id-type="pmid">15644221</pub-id><pub-id pub-id-type="doi">10.1016/j.jmb.2004.10.077</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>WK</given-names></name><name><surname>Henschel</surname><given-names>A</given-names></name><name><surname>Winter</surname><given-names>C</given-names></name><name><surname>Schroeder</surname><given-names>M</given-names></name></person-group><article-title>The many faces of protein:Protein interactions: A compendium of interface geometry</article-title><source>PLoS Comput Biol</source><year>2006</year><volume>2</volume><fpage>el24</fpage><pub-id pub-id-type="doi">10.1371/journal.pcbi.0020124</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sippl</surname><given-names>M</given-names></name></person-group><article-title>Knowledge-based potentials for proteins</article-title><source>Curr Opin Struct Biol</source><year>1995</year><volume>5</volume><fpage>229</fpage><lpage>235</lpage><pub-id pub-id-type="pmid