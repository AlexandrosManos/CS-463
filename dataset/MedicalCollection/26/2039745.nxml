d-type="pmid">1353814</pub-id><pub-id pub-id-type="doi">10.1016/0140-6736(92)91414-4</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Korenromp</surname><given-names>EL</given-names></name><name><surname>Williams</surname><given-names>BG</given-names></name><name><surname>Gouws</surname><given-names>E</given-names></name><name><surname>Dye</surname><given-names>C</given-names></name><name><surname>Snow</surname><given-names>RW</given-names></name></person-group><article-title>Measurement of trends in childhood malaria mortality in Africa: an assessment of progress toward targets based on verbal autopsy</article-title><source>Lancet Infec Dis</source><year>2003</year><volume>3</volume><fpage>349</fpage><lpage>358</lpage><pub-id pub-id-type="pmid">12781507</pub-id><pub-id pub-id-type="doi">10.1016/S1473-3099(03)00657-1</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rowe</surname><given-names>AK</given-names></name></person-group><article-title>Should verbal autopsy results for malaria be adjusted to improve validity?</article-title><source>Int J Epidemiol</source><year>2005</year><volume>34</volume><fpage>712</fpage><lpage>713</lpage><pub-id pub-id-type="pmid">15833786</pub-id><pub-id pub-id-type="doi">10.1093/ije/dyi087</pub-id></citation></ref><ref id="B15"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Remme</surname><given-names>JHF</given-names></name><name><surname>Binka</surname><given-names>F</given-names></name><name><surname>Nabarro</surname><given-names>D</given-names></name></person-group><article-title>Toward a framework and indicators for monitoring Roll Back Malaria</article-title><source>Am J Trop Med Hyg</source><year>2001</year><fpage>76</fpage><lpage>84</lpage><pub-id pub-id-type="pmid">11425180</pub-id></citation></ref><ref id="B16"><citation citati