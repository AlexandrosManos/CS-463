><article-title>PAN pesticides database&#x02014;California pesticide use</article-title><comment>Available: <ext-link ext-link-type="uri" xlink:href="http://www.pesticideinfo.org/Search_Use.jsp">http://www.pesticideinfo.org/Search_Use.jsp</ext-link></comment><access-date>accessed 1 May 2006</access-date></citation></ref><ref id="b50-ehp0115-001482"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Polleux</surname><given-names>F</given-names></name><name><surname>Lauder</surname><given-names>J</given-names></name></person-group><year>2004</year><article-title>Toward a developmental neurobiology of autism</article-title><source>Ment Retard Dev Disabil Res Rev</source><volume>10</volume><fpage>303</fpage><lpage>317</lpage><pub-id pub-id-type="pmid">15666334</pub-id></citation></ref><ref id="b51-ehp0115-001482"><citation citation-type="book"><collab>R Development Core Team</collab><year>2006</year><source>R: A Language and Environment for Statistical Computing</source><publisher-loc>Vienna, Austria</publisher-loc><publisher-name>R Foundation for Statistical Computing</publisher-name></citation></ref><ref id="b52-ehp0115-001482"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reynolds</surname><given-names>P</given-names></name><name><surname>Von Behren</surname><given-names>J</given-names></name><name><surname>Gunier</surname><given-names>R</given-names></name><name><surname>Goldberg</surname><given-names>D</given-names></name><name><surname>Hertz</surname><given-names>A</given-names></name><name><surname>Harnly</surname><given-names>M</given-names></name></person-group><year>2002</year><article-title>Childhood cancer and agricultural pesticide use: an ecological study in California</article-title><source>Environ Health Perspect</source><volume>110</volume><fpage>319</fpage><lpage>324</lpage><pub-id pub-id-type="pmid">11882484</pub-id></citation></ref><ref id="b53-ehp0115-001482"><citatio