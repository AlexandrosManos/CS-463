><year>1988</year><volume>119</volume><fpage>87</fpage><lpage>91</lpage><pub-id pub-id-type="pmid">3408668</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2133.1988.tb07107.x</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rispo</surname><given-names>A</given-names></name><name><surname>Lembo</surname><given-names>G</given-names></name><name><surname>Insabato</surname><given-names>L</given-names></name><name><surname>Cozzolino</surname><given-names>A</given-names></name><name><surname>Pesce</surname><given-names>G</given-names></name><name><surname>Castiglione</surname><given-names>F</given-names></name></person-group><article-title>Successful treatment of therapy-resistant metastatic Crohn's disease with infliximab</article-title><source>Br J Dermatol</source><year>2004</year><volume>150</volume><fpage>1045</fpage><lpage>1046</lpage><pub-id pub-id-type="pmid">15149534</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2133.2004.05958.x</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nousari</surname><given-names>HC</given-names></name><name><surname>Sragovich</surname><given-names>A</given-names></name><name><surname>Kimyai-Asadi</surname><given-names>A</given-names></name><name><surname>Orlinsky</surname><given-names>D</given-names></name><name><surname>Anhalt</surname><given-names>GJ</given-names></name></person-group><article-title>Mycophenolate mofetil in autoimmune and inflammatory skin disorders</article-title><source>J Am Acad Dermatol</source><year>1999</year><volume>40</volume><fpage>265</fpage><lpage>268</lpage><pub-id pub-id-type="pmid">10025760</pub-id><pub-id pub-id-type="doi">10.1016/S0190-9622(99)70203-3</pub-id></citation></ref></ref-list></back></article>