tation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><collab>Health and Development Networks</collab></person-group><source>Living on the outside</source><year>2006</year><publisher-name>Chiang Mai: Health and Development Networks</publisher-name></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><collab>World Health Organisation</collab></person-group><source>The global plan to stop TB 2006&#x02013;2015</source><year>2006</year><publisher-name>Geneva: World Health Organisation</publisher-name></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><collab>Joint United Nations Programme on HIV/AIDS (UNAIDS)</collab></person-group><source>Intensifying HIV prevention: a UNAIDS policy position paper</source><year>2005</year><publisher-name>Geneva: UNAIDS</publisher-name></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heijnders</surname><given-names>ML</given-names></name></person-group><article-title>The dynamics of stigma in leprosy</article-title><source>International Journal Of Leprosy And Other Mycobacterial Diseases</source><year>2004</year><volume>72</volume><fpage>437</fpage><lpage>447</lpage><pub-id pub-id-type="pmid">15755198</pub-id><pub-id pub-id-type="doi">10.1489/1544-581X(2004)72&#x0003c;437:TDOSIL&#x0003e;2.0.CO;2</pub-id></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><collab>Health and Development Networks</collab></person-group><source>Advocacy for action on stigma and HIV/AIDS in Africa</source><year>2001</year><publisher-name>Chiang Mai, Health and Development Networks</publisher-name></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><collab>Health and Development Networks</collab></person-group><source>HIV-related stigma and discrimination in the workplace and institutions, The correspondence dialogues</source><year>2006</year><publisher-name>Chiang Mai: Health and Development Networks</publisher-name></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chapple</surname><given-names>A</given-names></name><name><surname>Ziebland</surname><given-names>S</given-names></name><name><surname>McPherson</surname><given-names>A</given-names></name></person-group><article-title>Stigma, shame, and blame experienced by patients with lung cancer: qualitative study</article-title><source>BMJ</source><year>2004</year><volume>328</volume><fpage>1470</fpage><lpage>1473</lpage><pub-id pub-id-type="pmid">15194599</pub-id><pub-id pub-id-type="doi">10.1136/bmj.38111.639734.7C</pub-id></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><collab>WHO</collab></person-group><source>Mental health : new understanding, new hope</source><year>2001</year><publisher-name>Geneva: World Health Organisation</publisher-name></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crandall</surname><given-names>C</given-names></name><name><surname>Glor</surname><given-names>J</given-names></name></person-group><article-title>AIDS-related stigmatization: instrumental and symbolic attitudes</article-title><source>Journal of Applied Social Psychology</source><year>1997</year><volume>27</volume><fpage>95</fpage><lpage>123</lpage><pub-id pub-id-type="doi">10.1111/j.1559-1816.1997.tb00625.x</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Macq</surname><given-names>J</given-names></name><name><surname>Solis</surname><given-names>A</given-names></name><name><surname>Martinez</surname><given-names>G</given-names></name><name><surname>Maertiny</surname><given-names>P</given-na