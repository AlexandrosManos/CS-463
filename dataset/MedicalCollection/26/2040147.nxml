ef><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Livingston</surname><given-names>EH</given-names></name><name><surname>Rege</surname><given-names>RV</given-names></name></person-group><article-title>A nationwide study of conversion from laparoscopic to open cholecystectomy</article-title><source>American Journal of Surgergy</source><year>2004</year><volume>188</volume><fpage>205</fpage><lpage>211</lpage><pub-id pub-id-type="doi">10.1016/j.amjsurg.2004.06.013</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nilsson</surname><given-names>E</given-names></name><name><surname>Fored</surname><given-names>M</given-names></name><name><surname>Granath</surname><given-names>F</given-names></name><name><surname>Blomquist</surname><given-names>P</given-names></name></person-group><article-title>Cholecystectomy in Sweden 1987-1999. A nationwide study of mortality and preoperative admissions</article-title><source>Scandinavican Journal of Gastroenterology</source><year>2005</year><volume>40</volume><fpage>1478</fpage><lpage>1485</lpage><pub-id pub-id-type="doi">10.1080/00365520510023972</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leeder</surname><given-names>PC</given-names></name><name><surname>Mattews</surname><given-names>T</given-names></name><name><surname>Krzeminska</surname><given-names>K</given-names></name><name><surname>Dehn</surname><given-names>TCB</given-names></name></person-group><article-title>Routine day-case laparoscopic cholecystectomy</article-title><source>British Journal of Surgery</source><year>2004</year><volume>91</volume><fpage>312</fpage><lpage>316</lpage><pub-id pub-id-type="pmid">14991631</pub-id><pub-id pub-id-type="doi">10.1002/bjs.4409</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person