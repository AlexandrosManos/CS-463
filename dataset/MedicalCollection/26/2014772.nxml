 pub-id-type="pmid">9475347</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Logsdon</surname><given-names>BA</given-names></name><name><surname>Lee</surname><given-names>KR</given-names></name><name><surname>Luedtkeg</surname><given-names>G</given-names></name><name><surname>Barrett</surname><given-names>FF</given-names></name></person-group><article-title>Evaluation of vancomycin use in a pediatric teaching hospital based on CDC criteria</article-title><source>Infect Control Hosp Epidemiol</source><year>1997</year><volume>18</volume><fpage>780</fpage><lpage>782</lpage><pub-id pub-id-type="pmid">9397378</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamilton</surname><given-names>CD</given-names></name><name><surname>Drew</surname><given-names>R</given-names></name><name><surname>Janning</surname><given-names>SW</given-names></name><name><surname>Latour</surname><given-names>JK</given-names></name><name><surname>Hayward</surname><given-names>S</given-names></name></person-group><article-title>Excessive use of vancomycin: A successful intervention strategy at an academic medical center</article-title><source>Infect Control Hosp Epidemiol</source><year>2000</year><volume>21</volume><fpage>42</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">10656355</pub-id><pub-id pub-id-type="doi">10.1086/501703</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wright</surname><given-names>SW</given-names></name><name><surname>Wrenn</surname><given-names>KD</given-names></name></person-group><article-title>Appropriateness of vancomycin use in the emergency department</article-title><source>Ann Emerg Med</source><year>1998</year><volume>32</volume><fpage>531</fpage><lpage>536</lpage><pub-id pub-id-type="pmid">9795314</pub-id><pub-id pub-id-type="doi">10.1016/S0196-0644(98)70030-7</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Green</surname><given-names>K</given-names></name><name><surname>Schulman</surname><given-names>G</given-names></name><name><surname>Haas</surname><given-names>DW</given-names></name><name><surname>Schaffner</surname><given-names>W</given-names></name><name><surname>D'Agata</surname><given-names>EM</given-names></name></person-group><article-title>Vancomycin prescribing practices in hospitalized chronic hemodialysis patients</article-title><source>Am J Kidney Dis</source><year>2000</year><volume>35</volume><fpage>64</fpage><lpage>68</lpage><pub-id pub-id-type="pmid">10620546</pub-id></citation></ref></ref-list></back></article>