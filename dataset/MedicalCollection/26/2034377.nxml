><lpage>325</lpage></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Price</surname><given-names>LL</given-names></name><name><surname>Bj&#x000f6;rnsen Gurung</surname><given-names>A</given-names></name></person-group><article-title>Describing and measuring ethno-entomological knowledge of rice pests: tradition and change among Asian rice farmers</article-title><source>Environment, Development and Sustainability</source><year>2006</year><volume>8</volume><fpage>507</fpage><lpage>517</lpage><pub-id pub-id-type="doi">10.1007/s10668-006-9052-5</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shively</surname><given-names>GE</given-names></name></person-group><article-title>Poverty, consumption risk, and soil conservation</article-title><source>Journal of Development Economics</source><year>2001</year><volume>65</volume><fpage>267</fpage><lpage>292</lpage><pub-id pub-id-type="doi">10.1016/S0304-3878(01)00137-7</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coxhead</surname><given-names>I</given-names></name></person-group><article-title>Consequences of food security strategy for economic welfare, income distribution and land degradation: the Philippine case</article-title><source>World Development</source><year>2000</year><volume>28</volume><fpage>111</fpage><lpage>128</lpage><pub-id pub-id-type="doi">10.1016/S0305-750X(99)00117-5</pub-id></citation></ref></ref-list></back></article>