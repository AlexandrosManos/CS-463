>84</lpage><pub-id pub-id-type="pmid">15157733</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kahvejian</surname><given-names>A</given-names></name><name><surname>Svitkin</surname><given-names>YV</given-names></name><name><surname>Sukarieh</surname><given-names>R</given-names></name><name><surname>M&#x02019;Boutchou</surname><given-names>MN</given-names></name><name><surname>Sonenberg</surname><given-names>N</given-names></name></person-group><article-title>Mammalian poly(A)-binding protein is a eukaryotic translation initiation factor, which acts via multiple mechanisms</article-title><source>Genes Dev.</source><year>2005</year><volume>19</volume><fpage>104</fpage><lpage>113</lpage><pub-id pub-id-type="pmid">15630022</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gorlach</surname><given-names>M</given-names></name><name><surname>Burd</surname><given-names>CG</given-names></name><name><surname>Dreyfuss</surname><given-names>G</given-names></name></person-group><article-title>The mRNA poly(A)-binding protein: localization, abundance, and RNA-binding specificity</article-title><source>Exp. Cell. Res.</source><year>1994</year><volume>211</volume><fpage>400</fpage><lpage>407</lpage><pub-id pub-id-type="pmid">7908267</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mullin</surname><given-names>C</given-names></name><name><surname>Duning</surname><given-names>K</given-names></name><name><surname>Barnekow</surname><given-names>A</given-names></name><name><surname>Richter</surname><given-names>D</given-names></name><name><surname>Kremerskothen</surname><given-names>J</given-names></name><name><surname>Mohr</surname><given-names>E</g