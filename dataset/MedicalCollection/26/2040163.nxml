ight"><inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M25" name="1471-2105-8-304-i6" overflow="scroll"><mml:semantics definitionURL="" encoding=""><mml:mrow><mml:msub><mml:mrow><mml:mover accent="true"><mml:mrow><mml:mi>t</mml:mi><mml:mi>p</mml:mi></mml:mrow><mml:mo stretchy="true">&#x000af;</mml:mo></mml:mover></mml:mrow><mml:mi>J</mml:mi></mml:msub></mml:mrow><mml:annotation encoding="MathType-MTEF"> MathType@MTEF@5@5@+=feaafiart1ev1aaatCvAUfKttLearuWrP9MDH5MBPbIqV92AaeXatLxBI9gBaebbnrfifHhDYfgasaacH8akY=wiFfYdH8Gipec8Eeeu0xXdbba9frFj0=OqFfea0dXdd9vqai=hGuQ8kuc9pgc9s8qqaq=dirpe0xb9q8qiLsFr0=vr0=vr0dc8meaabaqaciaacaGaaeqabaqabeGadaaakeaadaqdaaqaaiabdsha0jabdchaWbaadaWgaaWcbaGaemOsaOeabeaaaaa@30E0@</mml:annotation></mml:semantics></mml:math></inline-formula></td><td align="right"><italic>J</italic><sub>0</sub></td><td align="right"><inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M26" name="1471-2105-8-304-i7" overflow="scroll"><mml:semantics definitionURL="" encoding=""><mml:mrow><mml:mi>t</mml:mi><mml:msub><mml:mi>p</mml:mi><mml:mrow><mml:msub><mml:mi>J</mml:mi><mml:mn>0</mml:mn></mml:msub></mml:mrow></mml:msub></mml:mrow><mml:annotation encoding="MathType-MTEF"> MathType@MTEF@5@5@+=feaafiart1ev1aaatCvAUfKttLearuWrP9MDH5MBPbIqV92AaeXatLxBI9gBaebbnrfifHhDYfgasaacH8akY=wiFfYdH8Gipec8Eeeu0xXdbba9frFj0=OqFfea0dXdd9vqai=hGuQ8kuc9pgc9s8qqaq=dirpe0xb9q8qiLsFr0=vr0=vr0dc8meaabaqaciaacaGaaeqabaqabeGadaaakeaacqWG0baDcqWGWbaCdaWgaaWcbaGaemOsaO0aaSbaaWqaaiabicdaWaqabaaaleqaaaaa@31F5@</mml:annotation></mml:semantics></mml:math></inline-formula></td><td align="center"><italic>N</italic><sub><italic>t</italic></sub></td></tr></thead><tbody><tr><td align="left">zhang-server [45]</td><td align="right">-</td><td align="right">71</td><td align="right">19.5</td><td align="right">68</td><td align="right">85</td><td align="left">ORFeus-2 [17]</td><td align="right">61</td><td align="right">62</td><td align="right">45.6</td><td ali