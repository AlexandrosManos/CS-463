<article-title>Signalling and survival pathways in multiple myeloma</article-title><source>European Journal of Cancer</source><year>2006</year><volume>42</volume><fpage>1574</fpage><lpage>1580</lpage><pub-id pub-id-type="pmid">16797970</pub-id></citation></ref><ref id="b13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boot</surname><given-names>RG</given-names></name></person-group><article-title>Marked elevation of the chemokine CCL18/PARC in Gaucher disease: a novel surrogate marker for assessing therapeutic intervention</article-title><source>Blood</source><year>2004</year><volume>103</volume><fpage>33</fpage><lpage>39</lpage><pub-id pub-id-type="pmid">12969956</pub-id></citation></ref><ref id="b14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brady</surname><given-names>K</given-names></name></person-group><article-title>Multiple myeloma arising from monoclonal gammopathy of undetermined significance in a patient with Gaucher's disease</article-title><source>Archives of Pathology &#x00026; Laboratory Medicine</source><year>1997</year><volume>121</volume><fpage>1108</fpage><lpage>1111</lpage><pub-id pub-id-type="pmid">9341594</pub-id></citation></ref><ref id="b15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brautbar</surname><given-names>A</given-names></name></person-group><article-title>Effect of enzyme replacement therapy on gammopathies in Gaucher disease</article-title><source>Blood Cells, Molecules &#x00026; Diseases</source><year>2004</year><volume>32</volume><fpage>214</fpage><lpage>217</lpage></citation></ref><ref id="b16"><citation citation-type="journal"><collab>British Committee for Standards in Haematology, Blood Transfusion Task Force (Chairman P. Kelsey)</collab><article-title>Guidelines for the use of platelet transfusions</article-title><source>British Journal of Haematology</source><year>2003</year><volume>122</volume><fpage>10</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">12823341</pub-id></citation></ref><ref id="b17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burstein</surname><given-names>Y</given-names></name></person-group><article-title>Abnormalities of cellular immunity and natural killer cells in Gaucher's disease</article-title><source>Journal of Clinical &#x00026; Laboratory Immunology</source><year>1987</year><volume>23</volume><fpage>149</fpage><lpage>151</lpage><pub-id pub-id-type="pmid">2959782</pub-id></citation></ref><ref id="b18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Charrow</surname><given-names>J</given-names></name></person-group><article-title>The Gaucher registry: demographics and disease characteristics of 1698 patients with Gaucher disease</article-title><source>Archives of Internal Medicine</source><year>2000</year><volume>160</volume><fpage>2835</fpage><lpage>2843</lpage><pub-id pub-id-type="pmid">11025794</pub-id></citation></ref><ref id="b19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Corbett</surname><given-names>GM</given-names></name></person-group><article-title>Adult Gaucher disease in association with acute leukaemia</article-title><source>Postgraduate Medical Journal</source><year>1987</year><volume>63</volume><fpage>899</fpage><lpage>900</lpage><pub-id pub-id-type="pmid">3482129</pub-id></citation></ref><ref id="b20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Costello</surname><given-names>R</given-names></name></person-group><article-title>Gaucher disease and multiple myeloma</article-title><source>Leukemia &#x00026; Lymphoma</source><year>2006</year><volume>47</volume><fpage>1365</fpage><lpage>1368</lpage><pub-id pub-id-type="pmid">16923570</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cox</surname><given-names>TM</given-names></name></person-group><article-title>Gaucher's disease: clinical features and natural history</article-title><source>Bailli&#x000e8;re's Clinical Haematology</source><year>1997</year><volume>10</volume><fpage>657</fpage><lpage>689</lpage></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cox</surname><given-names>TM</given-names></name></person-group><article-title>Advisory Council to the European Working Group on Gaucher Disease. The role of the iminosugar N-butyldeoxynojirimycin (miglustat) in the management of type I (non-neuronopathic) Gaucher disease: a position statement</article-title><source>Journal of Inherited Metabolic Disease</source><year>2003</year><volume>26</volume><fpage>513</fpage><lpage>526</lpage><pub-id pub-id-type="pmid">14605497</pub-id></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>vom Dahl</surname><given-names>S</given-names></name></person-group><article-title>Life expectancy in type 1 (non-neuronopathic) Gaucher disease</article-title><source>European Journal of Human Genetics</source><year>2006a</year><volume>14</volume><issue>Suppl. 1</issue><fpage>382</fpage><comment>(abstract P1289)</comment></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>vom Dahl</surname><given-names>S</given-names></name></person-group><article-title>Evidence-based recommendations for monitoring bone disease and the response to enzyme replacement therapy in Gaucher patients</article-title><source>Current Medical Research and Opinion</source><year>2006b</year><volume>22</volume><fpage>1045</fpage><lpage>1064</lpage><pub-id pub-id-type="pmid">16846538</pub-id></citation></ref><ref id="b25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Deghady</surname><given-names>A</given-names></name></person-group><article-title>Coagulation abnormalities in type 1 Gaucher disease in children</article-title><source>Pediatric Hematology and Oncology</source><year>2006</year><volume>23</volume><fpage>411</fpage><lpage>417</lpage><pub-id pub-id-type="pmid">16728361</pub-id></citation></ref><ref id="b26"><citation citation-type="other"><collab>European Agency for the Evaluation of Medicinal Products (EMEA)</collab><source>Zavesca prescribing data</source><comment><ext-link ext-link-type="uri" xlink:href="http://www.emea.eu.int/humandocs/Humans/EPAR/zavesca/zavesca.htm">http://www.emea.eu.int/humandocs/Humans/EPAR/zavesca/zavesca.htm</ext-link> (accessed 9 July 2007)</comment></citation></ref><ref id="b27"><citation citation-type="other"><collab>European Agency for the Evaluation of Medicinal Products (EMEA)</collab><source>Cerezyme prescribing data</source><comment><ext-link ext-link-type="uri" xlink:href="http://www.emea.eu.int/humandocs/Humans/EPAR/cerezyme/cerezyme.htm">http://www.emea.eu.int/humandocs/Humans/EPAR/cerezyme/cerezyme.htm</ext-link></comment></citation></ref><ref id="b28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fleming</surname><given-names>RE</given-names></name></person-group><article-title>Hepcidin: a putative iron-regulatory hormone relevant to hereditary hemochromatosis and the anemia of chronic disease</article-title><source>Proceedings of the National Academy of Sciences of the United States of America</source><year>2001</year><volume>98</volume><fpage>8160</fpage><lpage>8162</lpage><pub-id pub-id-type="pmid">11459944</pub-id></citation></ref><ref id="b29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>de Fost</surname><given-names>M</given-names></name></person-group><article-title>Increased incidence of cancer in adult Gaucher disease in Western Europe</article-title><source>Blood Cells, Molecules &#x0002