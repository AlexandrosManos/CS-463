" colspan="1">0.06</td><td align="center" rowspan="1" colspan="1">0.642</td></tr><tr><td align="left" rowspan="1" colspan="1">B cell (PDB)</td><td align="center" rowspan="1" colspan="1">2.17 &#x000b1; 0.55</td><td align="right" rowspan="1" colspan="1">58</td><td align="center" rowspan="1" colspan="1">2003</td><td align="center" rowspan="1" colspan="1">96</td><td align="right" rowspan="1" colspan="1">&#x02013;0.08</td><td align="center" rowspan="1" colspan="1">0.544</td></tr><tr><td align="left" rowspan="1" colspan="1">B cell (PDB)<xref ref-type="table-fn" rid="tfn4-ehp0115-001421">a</xref>,<xref ref-type="table-fn" rid="tfn6-ehp0115-001421">c</xref></td><td align="center" rowspan="1" colspan="1">0.66 &#x000b1; 0.13</td><td align="right" rowspan="1" colspan="1">9</td><td align="center" rowspan="1" colspan="1">2003</td><td align="center" rowspan="1" colspan="1">120</td><td align="right" rowspan="1" colspan="1">&#x02013;0.80</td><td align="center" rowspan="1" colspan="1">0.001</td></tr><tr><td align="left" rowspan="1" colspan="1">Lysozyme activity</td><td align="center" rowspan="1" colspan="1">11.02 &#x000b1; 0.82</td><td align="right" rowspan="1" colspan="1">58</td><td align="center" rowspan="1" colspan="1">2003</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="right" rowspan="1" colspan="1">0.12</td><td align="center" rowspan="1" colspan="1">0.388</td></tr><tr><td align="left" rowspan="1" colspan="1">Corticosterone</td><td align="center" rowspan="1" colspan="1">2.61 &#x000b1; 0.39</td><td align="right" rowspan="1" colspan="1">37</td><td align="center" rowspan="1" colspan="1">2003</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="right" rowspan="1" colspan="1">0.20</td><td align="center" rowspan="1" colspan="1">0.242</td></tr></tbody></table><table-wrap-foot><fn id="tfn3-ehp0115-001421"><p>Mean values represent SI for lymphocyte proliferation, lysozyme activity (&#x003bc;g/&#x003bc;L HEL), and corticosterone (ng/mL). No health parameters varied with either straight carapace length or sex, so all size classes and sexes were pooled for statistical analyses. Mean &#x000b1; SE (range) of blood Hg concentration for samples collected in 2001 (<italic>n</italic> = 13) and 2003 (<italic>n</italic> = 58) were 0.037 &#x000b1; 0.013 &#x003bc;g/g (0.012&#x02013;0.188 &#x003bc;g/g) and 0.029 &#x000b1; 0.002 &#x003bc;g/g (0.006&#x02013;0.077 &#x003bc;g/g), respectively.</p></fn><fn id="tfn4-ehp0115-001421"><label>a</label><p>Parameters were statistically significant.</p></fn><fn id="tfn5-ehp0115-001421"><label>b</label><p>Pearson correlation coefficient is reported for lysozyme activity versus log-transformed Hg concentration, which showed a positive correlation.</p></fn><fn id="tfn6-ehp0115-001421"><label>c</label><p>These data are from the control group from the <italic>in vitro</italic> exposure; <italic>r</italic><sup>2</sup> and <italic>p</italic>-values are reported for a linear regression, which showed a negative relationship (<xref ref-type="fig" rid="f3-ehp0115-001421">Figure 3</xref>).</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>