d pub-id-type="doi">10.1111/j.0906-6705.2006.00425.x</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reali</surname><given-names>UM</given-names></name><name><surname>Ciarugi</surname><given-names>C</given-names></name><name><surname>De Siena</surname><given-names>GM</given-names></name><name><surname>Giannitti</surname><given-names>V</given-names></name></person-group><article-title>Sonographic evaluation of dermis and subcutaneous tissue during and after skin expansion</article-title><source>Plast Reconstr Surg</source><year>1994</year><volume>93</volume><fpage>1050</fpage><lpage>1055</lpage><pub-id pub-id-type="pmid">8134462</pub-id><pub-id pub-id-type="doi">10.1097/00006534-199404001-00022</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pasyk</surname><given-names>KA</given-names></name><name><surname>Argenta</surname><given-names>LC</given-names></name><name><surname>Hassett</surname><given-names>C</given-names></name></person-group><article-title>Quantitative analysis of the thickness of human skin and subcutaneous tissue following controlled expansion with a silicone implant</article-title><source>Plast Reconstr Surg</source><year>1988</year><volume>81</volume><fpage>516</fpage><lpage>523</lpage><pub-id pub-id-type="pmid">3347661</pub-id><pub-id pub-id-type="doi">10.1097/00006534-198804000-00006</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gallagher</surname><given-names>D</given-names></name><name><surname>Kuznia</surname><given-names>P</given-names></name><name><surname>Heshka</surname><given-names>S</given-names></name><name><surname>Albu</surname><given-names>J</given-names></name><name><surname>Heymsfield</surname><given-names>SB</given-names></name><name><surname>Goodpaster</surname><given-names>B</given-names><