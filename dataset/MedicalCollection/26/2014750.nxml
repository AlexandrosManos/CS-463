></comment><pub-id pub-id-type="pmid">17467273</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wayne</surname><given-names>JS</given-names></name><name><surname>Lawhorn</surname><given-names>KW</given-names></name><name><surname>Davis</surname><given-names>KE</given-names></name><name><surname>Prakash</surname><given-names>K</given-names></name><name><surname>Adelaar</surname><given-names>RS</given-names></name></person-group><article-title>The effect of tibiotalar fixation on foot biomechanics</article-title><source>Foot Ankle Int</source><year>1997</year><volume>18</volume><fpage>792</fpage><lpage>797</lpage><pub-id pub-id-type="pmid">9429881</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martinelli</surname><given-names>L</given-names></name><name><surname>Hurschler</surname><given-names>C</given-names></name><name><surname>Rosenbaum</surname><given-names>D</given-names></name></person-group><article-title>Comparison of capacitive versus resistive joint contact stress sensors</article-title><source>Clin Orthop Relat Res</source><year>2006</year><volume>447</volume><fpage>214</fpage><lpage>220</lpage><pub-id pub-id-type="pmid">16672899</pub-id><pub-id pub-id-type="doi">10.1097/01.blo.0000218730.59838.6a</pub-id></citation></ref></ref-list></back></article>