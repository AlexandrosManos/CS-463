1">Model 7</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;<italic>p,p</italic>&#x02032;<italic>-</italic>DDT tertile 1</td><td align="center" rowspan="1" colspan="1">1.0</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">&#x02014;</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;<italic>p,p</italic>&#x02032;<italic>-</italic>DDT tertile 2</td><td align="center" rowspan="1" colspan="1">3.1</td><td align="center" rowspan="1" colspan="1">1.2&#x02013;8.2</td><td align="center" rowspan="1" colspan="1">0.02</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;<italic>p,p</italic>&#x02032;<italic>-</italic>DDT tertile 3</td><td align="center" rowspan="1" colspan="1">7.3</td><td align="center" rowspan="1" colspan="1">2.1&#x02013;26.0</td><td align="center" rowspan="1" colspan="1">0.00</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;<italic>o,p</italic>&#x02032;<italic>-</italic>DDT (tertile 3 vs. tertile 1)</td><td align="center" rowspan="1" colspan="1">0.2</td><td align="center" rowspan="1" colspan="1">0.1&#x02013;0.6</td><td align="center" rowspan="1" colspan="1">0.00</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Year of blood draw</td><td align="center" rowspan="1" colspan="1">1.0</td><td align="center" rowspan="1" colspan="1">0.9&#x02013;1.2</td><td align="center" rowspan="1" colspan="1">0.61</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;African American<xref ref-type="table-fn" rid="tfn20-ehp0115-001406">b</xref></td><td align="center" rowspan="1" colspan="1">0.9</td><td align="center" rowspan="1" colspan="1">0.4&#x02013;2.0</td><td align="center" rowspan="1" colspan="1">0.75</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Asian<xref ref-type="table-fn" rid="tfn20-ehp0115-001406">b</xref></td><td align="center" rowspan="1" colspan="1">0.1</td><td align="center" rowspan="1" colspan="1">0.0&#x02013;1.3</td><td align="center" rowspan="1" colspan="1">0.08</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Mixed race<xref ref-type="table-fn" rid="tfn20-ehp0115-001406">b</xref></td><td align="center" rowspan="1" colspan="1">1.7</td><td align="center" rowspan="1" colspan="1">0.6&#x02013;5.3</td><td align="center" rowspan="1" colspan="1">0.35</td></tr><tr><td colspan="4" align="left" rowspan="1">Model 8</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;<italic>p,p</italic>&#x02032;<italic>-</italic>DDT tertile 1</td><td align="center" rowspan="1" colspan="1">1.0</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">&#x02014;</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;<italic>p,p</italic>&#x02032;<italic>-</italic>DDT tertile 2</td><td align="center" rowspan="1" colspan="1">3.0</td><td align="center" rowspan="1" colspan="1">1.2&#x02013;7.7</td><td align="center" rowspan="1" colspan="1">0.02</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;<italic>p,p</italic>&#x02032;<italic>-</italic>DDT tertile 3</td><td align="center" rowspan="1" colspan="1">6.4</td><td align="center" rowspan="1" colspan="1">1.9&#x02013;21.5</td><td align="center" rowspan="1" colspan="1">0.00</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;<italic>o,p</italic>&#x02032;<italic>-</italic>DDT (tertile 3 vs. tertile 1)</td><td align="center" rowspan="1" colspan="1">0.3</td><td align="center" rowspan="1" colspan="1">0.1&#x02013;0.7</td><td align="center" rowspan="1" colspan="1">0.00</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Year of blood draw</td><td align="center" rowspan="1" colspan="1">1.0</td><td align="center" rowspan="1" colspan="1">0.8&#x02013;1.2</td><td align="center" rowspan="1" colspan="1">0.96</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Breast-feeding in observed pregnancy (yes vs. no)</td><td align="center" rowspan="1" colspan="1">1.4</td><td align="center" rowspan="1" colspan="1">0.8&#x02013;2.8</td><td align="center" rowspan="1" colspan="1">0.27</td></tr></tbody></table><table-wrap-foot><fn id="tfn18-ehp0115-001406"><p>CI, confidence interval. ORs were estimated by conditional logistic regression. Each model is based on 192 subjects representing 96 case&#x02013;control pairs matched on year of birth. <italic>p,p</italic>&#x02032;<italic>-</italic>DDT was represented as two indicator variables, tertile 2 and tertile 3 where tertile 1 was the reference category (tertile 1, &#x0003c; 8.09 &#x003bc;g/L; tertile 2, 8.09&#x02013;13.90 &#x003bc;g/L; tertile 3, &#x0003e; 13.90 &#x003bc;g/L). <italic>o,p</italic>&#x02032;<italic>-</italic>DDT was represented as a three-category ordinal variable based on tertiles in the control population (tertile 1, &#x02264; 0.42 &#x003bc;g/L; tertile 2, 0.43&#x02013;0.72 &#x003bc;g/L; tertile 3, &#x0003e; 0.72 &#x003bc;g/L) and coded at the median value within each tertile (0.22 &#x003bc;g/L, 0.57 &#x003bc;g/L, and 0.98 &#x003bc;g/L for tertiles 1, 2, and 3, respectively). ORs for <italic>o,p</italic>&#x02032;-DDT are given for difference between the median in the third tertile and the median in the first tertile (0.76 &#x003bc;g/L). Model 1 is also shown in <xref ref-type="table" rid="t4-ehp0115-001406">Table 4</xref> (right-hand column; age quartiles 1&#x02013;3, &#x0003c; 14 years) and is provided here to allow comparison with estimates after adjustment for other breast cancer risk factors.</p></fn><fn id="tfn19-ehp0115-001406"><label>a</label><p>Reference category is 33rd&#x02013;66th percentiles of BMI (kg/m<sup>2</sup>). Percentiles are based on distribution of body mass in controls. The 33rd and 66th percentiles were defined as &#x02264; 21.23 kg/m<sup>2</sup> and &#x0003e; 23.71 kg/m<sup>2</sup>, respectively.</p></fn><fn id="tfn20-ehp0115-001406"><label>b</label><p>Reference category is Caucasian.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>