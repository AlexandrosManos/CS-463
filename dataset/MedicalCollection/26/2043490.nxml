124.t003"/><table frame="hsides" rules="groups" alternate-form-of="pone-0001124-t003-3"><colgroup span="1"><col align="left" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/></colgroup><thead><tr><td align="left" rowspan="1" colspan="1">Hotspot Name&#x0002a;</td><td align="left" rowspan="1" colspan="1">GBIF records (rank)</td><td align="left" rowspan="1" colspan="1">GBIF Species</td><td align="left" rowspan="1" colspan="1">&#x00025; Total</td><td align="left" rowspan="1" colspan="1">&#x00025; Total</td></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">Mediterranean Basin</td><td align="left" rowspan="1" colspan="1">18,156</td><td align="left" rowspan="1" colspan="1">515</td><td align="left" rowspan="1" colspan="1">3.4&#x00025;</td><td align="left" rowspan="1" colspan="1">9.5&#x00025;</td></tr><tr><td align="left" rowspan="1" colspan="1">Mesoamerica</td><td align="left" rowspan="1" colspan="1">9,714</td><td align="left" rowspan="1" colspan="1">595</td><td align="left" rowspan="1" colspan="1">1.8&#x00025;</td><td align="left" rowspan="1" colspan="1">11.0&#x00025;</td></tr><tr><td align="left" rowspan="1" colspan="1">Southwest Australia</td><td align="left" rowspan="1" colspan="1">7,499</td><td align="left" rowspan="1" colspan="1">598</td><td align="left" rowspan="1" colspan="1">1.4&#x00025;</td><td align="left" rowspan="1" colspan="1">11.0&#x00025;</td></tr><tr><td align="left" rowspan="1" colspan="1">Tropical Andes</td><td align="left" rowspan="1" colspan="1">2,918</td><td align="left" rowspan="1" colspan="1">472</td><td align="left" rowspan="1" colspan="1">0.5&#x00025;</td><td align="left" rowspan="1" colspan="1">8.7&#x00025;</td></tr><tr><td align="left" rowspan="1" colspan="1">Madrean Pine-Oak Woodlands</td><td align="left" rowspan="1" colspan="1">1,413</td><td align="left" rowspan="1" colspan="1">246</td><td align="left" rowspan="1" colspan="1">0.3&#x00025;</td><td ali