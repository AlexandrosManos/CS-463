mes>KC</given-names></name><name><surname>De Costa</surname><given-names>BR</given-names></name><name><surname>Razdan</surname><given-names>RK</given-names></name><name><surname>Melvin</surname><given-names>LS</given-names></name><name><surname>Johnson</surname><given-names>MR</given-names></name><name><surname>Martin</surname><given-names>BR</given-names></name></person-group><article-title>Cannabinoid structure-activity relationships: correlation of receptor binding and in vivo activities</article-title><source>J Pharmacol Exp Ther</source><year>1993</year><volume>265</volume><fpage>218</fpage><lpage>226</lpage><pub-id pub-id-type="pmid">8474008</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fox</surname><given-names>A</given-names></name><name><surname>Kesingland</surname><given-names>A</given-names></name><name><surname>Gentry</surname><given-names>C</given-names></name><name><surname>McNair</surname><given-names>K</given-names></name><name><surname>Patel</surname><given-names>S</given-names></name><name><surname>Urban</surname><given-names>L</given-names></name><name><surname>James</surname><given-names>I</given-names></name></person-group><article-title>The role of central and peripheral Cannabinoid(1) receptors in the antihyperalgesic activity of cannabinoids in a model of neuropathic pain</article-title><source>Pain</source><year>2001</year><volume>92</volume><fpage>91</fpage><lpage>100</lpage><pub-id pub-id-type="pmid">11323130</pub-id><pub-id pub-id-type="doi">10.1016/S0304-3959(00)00474-7</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Malan</surname><given-names>TP</given-names></name><name><surname>Ibrahim</surname><given-names>MM</given-names></name><name><surname>Deng</surname><given-names>HF</given-names></name><name><surname>Liu</surname><given-names>Q</given-names></name><name><surname>Mata</surname><given-names>HP</given-names></name><name><surname>Vanderah</surname><given-names>T</given-names></name><name><surname>Porreca</surname><given-names>F</given-names></name><name><surname>Makriyannis</surname><given-names>A</given-names></name></person-group><article-title>CB2 cannabinoid receptor-mediated peripheral antinociception</article-title><source>Pain</source><year>2001</year><volume>93</volume><fpage>239</fpage><lpage>245</lpage><pub-id pub-id-type="pmid">11514083</pub-id><pub-id pub-id-type="doi">10.1016/S0304-3959(01)00321-9</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Scott</surname><given-names>DA</given-names></name><name><surname>Wright</surname><given-names>CE</given-names></name><name><surname>Angus</surname><given-names>JA</given-names></name></person-group><article-title>Evidence that CB-1 and CB-2 cannabinoid receptors mediate antinociception in neuropathic pain in the rat</article-title><source>Pain</source><year>2004</year><volume>109</volume><fpage>124</fpage><lpage>131</lpage><pub-id pub-id-type="pmid">15082134</pub-id><pub-id pub-id-type="doi">10.1016/j.pain.2004.01.020</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burstein</surname><given-names>SH</given-names></name></person-group><article-title>The cannabinoid acids: Nonpsychoactive derivatives with therapeutic potential</article-title><source>Pharmacol Ther</source><year>1999</year><volume>82</volume><fpage>87</fpage><lpage>96</lpage><pub-id pub-id-type="pmid">10341359</pub-id><pub-id pub-id-type="doi">10.1016/S0163-7258(98)00069-2</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>SM</given-names></name><name><surname>Bisogno</surname><given-names>T</given-names></name><name><surname>Petros</surname><given-names>TJ</given-names></name><name><surname>Chang</surname><given-names>SY</given-names></name><name><surname>Zavitsanos</surname><given-names>PA</given-names></name><name><surname>Zipkin</surname><given-names>RE</given-names></name><name><surname>Sivakumar</surname><given-names>R</given-names></name><name><surname>Coop</surname><given-names>A</given-names></name><name><surname>Maeda</surname><given-names>DY</given-names></name><name><surname>De Petrocellis</surname><given-names>L</given-names></name><name><surname>Burstein</surname><given-names>S</given-names></name><name><surname>Di Marzo</surname><given-names>V</given-names></name><name><surname>Walker</surname><given-names>JM</given-names></name></person-group><article-title>Identification of a new class of molecules, the arachidonyl amino acids, and characterization of one member that inhibits pain</article-title><source>J Biol Chem</source><year>2001</year><volume>276</volume><fpage>42639</fpage><lpage>42644</lpage><pub-id pub-id-type="pmid">11518719</pub-id><pub-id pub-id-type="doi">10.1074/jbc.M107351200</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sheskin</surname><given-names>T</given-names></name><name><surname>Hanus</surname><given-names>L</given-names></name><name><surname>Slager</surname><given-names>J</given-names></name><name><surname>Vogel</surname><given-names>Z</given-names></name><name><surname>Mechoulam</surname><given-names>R</given-names></name></person-group><article-title>Structural requirements for binding of anandamide-type compounds to the brain cannabinoid receptor</article-title><source>J Med Chem</source><year>1997</year><volume>40</volume><fpage>659</fpage><lpage>667</lpage><pub-id pub-id-type="pmid">9057852</pub-id><pub-id pub-id-type="doi">10.1021/jm960752x</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burstein</surname>