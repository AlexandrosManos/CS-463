-id-type="doi">10.1136/jech.2005.044628</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sigfrid</surname><given-names>LA</given-names></name><name><surname>Turner</surname><given-names>C</given-names></name><name><surname>Crook</surname><given-names>D</given-names></name><name><surname>Ray</surname><given-names>S</given-names></name></person-group><article-title>Using the UK primary care quality and outcomes framework to audit health care equity: preliminary data on diabetes management</article-title><source>J Public Health</source><year>2006</year><volume>28</volume><fpage>221</fpage><lpage>225</lpage><pub-id pub-id-type="doi">10.1093/pubmed/fdl028</pub-id></citation></ref><ref id="B9"><citation citation-type="other"><person-group person-group-type="author"><collab>Scottish Clinical Information Management in Primary Care group</collab></person-group><source>Making IT work for you</source><ext-link ext-link-type="uri" xlink:href="http://www.scimp.scot.nhs.uk/gpg/doc_page65.shtml"/><comment>(accessed 10 May 2007)</comment></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Helms</surname><given-names>PJ</given-names></name><name><surname>Ekins-Daukes</surname><given-names>S</given-names></name><name><surname>Taylor</surname><given-names>MW</given-names></name><name><surname>Simpson</surname><given-names>CR</given-names></name><name><surname>McLay</surname><given-names>JS</given-names></name></person-group><article-title>Utility of routinely acquired primary care data for paediatric disease epidemiology and pharmacoepidemiology</article-title><source>Br J Clin Pharmacol</source><year>2005</year><volume>59</volume><fpage>331</fpage><lpage>41</lpage></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Carstairs</surname><given-names>V</given-names></name><name><surname>Morris</surname><given-names>R</given-names></name></person-group><source>Deprivation and Health in Scotland</source><year>1991</year><publisher-name>Aberdeen, UK: Aberdeen University Press</publisher-name></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bromley</surname><given-names>C</given-names></name><name><surname>Sproston</surname><given-names>K</given-names></name><name><surname>Shelton</surname><given-names>N</given-names></name></person-group><source>The Scottish Health Survey 2003</source><year>2005</year><publisher-name>Edinburgh, UK: HMSO</publisher-name></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mackay</surname><given-names>D</given-names></name><name><surname>Sutton</surname><given-names>M</given-names></name><name><surname>Watt</surname><given-names>G</given-names></name></person-group><article-title>Deprivation and volunteering by general practices: cross sectional analysis of a national primary care system</article-title><source>BMJ</source><year>2005</year><volume>331</volume><fpage>1449</fpage><lpage>145</lpage><pub-id pub-id-type="pmid">16356981</pub-id><pub-id pub-id-type="doi">10.1136/bmj.331.7530.1449</pub-id></citation></ref></ref-list></back></article>