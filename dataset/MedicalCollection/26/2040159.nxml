</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Resnick</surname><given-names>D</given-names></name><name><surname>Greenway</surname><given-names>G</given-names></name><name><surname>Vint</surname><given-names>VC</given-names></name><name><surname>Robinson</surname><given-names>CA</given-names></name><name><surname>Piper</surname><given-names>S</given-names></name></person-group><article-title>Selective involvement of the first carpo-metacarpal joint in scleroderma</article-title><source>Am J Roeentgenol</source><year>1978</year><volume>131</volume><fpage>283</fpage><lpage>86</lpage></citation></ref></ref-list></back></article>