age>705</lpage><pub-id pub-id-type="pmid">16752262</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grossman</surname><given-names>NB</given-names></name></person-group><article-title>Blunt trauma in pregnancy</article-title><source>Am Fam Physician</source><volume>70</volume><fpage>1303</fpage><lpage>1310</lpage><comment>2004 Oct 1;</comment><pub-id pub-id-type="pmid">15508541</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berenson</surname><given-names>AB</given-names></name><name><surname>Wiemann</surname><given-names>CM</given-names></name><name><surname>Wilkinson</surname><given-names>GS</given-names></name><name><surname>Jones</surname><given-names>WA</given-names></name><name><surname>Anderson</surname><given-names>GD</given-names></name></person-group><article-title>Perinatal morbidity associated with violence experienced by pregnant women</article-title><source>Am J Obstet Gynecol</source><year>1994</year><volume>170</volume><fpage>1760</fpage><lpage>6</lpage><comment>discussion 1766&#x02013;9.</comment><pub-id pub-id-type="pmid">8203437</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yost</surname><given-names>NP</given-names></name><name><surname>Bloom</surname><given-names>SL</given-names></name><name><surname>McIntire</surname><given-names>DD</given-names></name><name><surname>Leveno</surname><given-names>KJ</given-names></name></person-group><article-title>A prospective observational study of domestic violence during pregnancy</article-title><source>Obstet Gynecol</source><year>2005</year><volume>106</volume><fpage>61</fpage><lpage>65</lpage><pub-id pub-id-type="pmid">15994618</pub-id></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vatten</su