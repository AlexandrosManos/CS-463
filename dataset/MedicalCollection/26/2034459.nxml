 rowspan="1" colspan="1">13%</td><td rowspan="1" colspan="1">0.51 (0.37&#x02013;0.68)</td><td rowspan="1" colspan="1">53%</td><td rowspan="1" colspan="1">12%</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">Illumina 100K</td><td rowspan="1" colspan="1">0.29 (0.15&#x02013;0.49)</td><td rowspan="1" colspan="1">24%</td><td rowspan="1" colspan="1">7%</td><td rowspan="1" colspan="1">0.37 (0.22&#x02013;0.56)</td><td rowspan="1" colspan="1">32%</td><td rowspan="1" colspan="1">7%</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">Illumina 300K</td><td rowspan="1" colspan="1">0.52 (0.37&#x02013;0.68)</td><td rowspan="1" colspan="1">53%</td><td rowspan="1" colspan="1">12%</td><td rowspan="1" colspan="1">0.51 (0.36&#x02013;0.67)</td><td rowspan="1" colspan="1">52%</td><td rowspan="1" colspan="1">11%</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">Illumina 550K</td><td rowspan="1" colspan="1">0.59 (0.45&#x02013;0.74)</td><td rowspan="1" colspan="1">67%</td><td rowspan="1" colspan="1">16%</td><td rowspan="1" colspan="1">0.58 (0.44&#x02013;0.73)</td><td rowspan="1" colspan="1">65%</td><td rowspan="1" colspan="1">15%</td></tr><tr><td rowspan="1" colspan="1">JPT + CHB</td><td rowspan="1" colspan="1">HapMap (total)</td><td rowspan="1" colspan="1">0.68 (0.52&#x02013;0.82)</td><td rowspan="1" colspan="1">77%</td><td rowspan="1" colspan="1">28%</td><td rowspan="1" colspan="1">0.67 (0.51&#x02013;0.81)</td><td rowspan="1" colspan="1">76%</td><td rowspan="1" colspan="1">26%</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">Affymetrix 100K</td><td rowspan="1" colspan="1">0.22 (0.08&#x02013;0.42)</td><td rowspan="1" colspan="1">19%</td><td rowspan="1" colspan="1">6%</td><td rowspan="1" colspan="1">0.19 (0.06&#x02013;0.39)</td><td rowspan="1" colspan="1">17%</td><td rowspan="1" colspan="1">5%</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">Affymetrix 500K</td><td rowspan="1" colspan="1">0.