<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:mml="http://www.w3.org/1998/Math/MathML" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Australas. Chiropr. Osteopathy</journal-id><journal-title>Australasian Chiropractic &#x00026; Osteopathy</journal-title><issn pub-type="ppub">1328-0384</issn></journal-meta><article-meta><article-id pub-id-type="pmid">17987206</article-id><article-id pub-id-type="pmc">2051308</article-id><article-categories><subj-group subj-group-type="heading"><subject>Article</subject></subj-group></article-categories><title-group><article-title>Risk Management for Chiropractors and Osteopaths. Informed consent</article-title><subtitle>A Common Law Requirement</subtitle></title-group><contrib-group><contrib contrib-type="author"><name><surname>Walker</surname><given-names>Bruce F.</given-names></name><degrees>DC, MPH, DrPH.</degrees></contrib><contrib contrib-type="author"><name><surname>Cameron</surname><given-names>Melainie</given-names></name><degrees>B.App.Sc.(Osteo.), M.H.Sc.</degrees></contrib><contrib contrib-type="author"><name><surname>French</surname><given-names>Simon</given-names></name><degrees>B.App.Sc.(Chiro.), M.P.H.</degrees></contrib><contrib contrib-type="author"><name><surname>Pollard</surname><given-names>Henry P.</given-names></name><degrees>Ph.D., B.Sc., Grad.Dip.(Chiro.), Grad.Dip.App.Sc., M.Sport.Sc.</degrees></contrib><contrib contrib-type="author"><name><surname>Vitiello</surname><given-names>Andrew L.</given-names></name><degrees>B.Sc., M.Chiro.</degrees></contrib><contrib contrib-type="author"><name><surname>Reggars</surname><given-names>John W.</given-names></name><degrees>D.C., M.Chiro.Sc.</degrees></contrib><contrib contrib-type="author"><name><surname>Werth</surname><given-names>Peter D.</given-names></name><degrees>B.App.Sc.(Chiro.).</degrees></contrib></contrib-group><pub-date pub-type="ppub"><month>7</month><year>2004</year></pub-date><volume>12</volume><issue>1</issue><fpage>19</fpage><lpage>23</lpage><copyright-statement>Chiropractic &#x00026; Osteopathic College of Australasia</copyright-statement><copyright-year>2004</copyright-year><abstract><p>Obtaining the informed consent of a patient before undertaking chiropractic or osteopathic treatment is a common law requirement in Australia. This paper outlines the essential elements of informed consent and provides some practice tips on streamlining the process.	  </p></abstract><kwd-group><kwd>Chiropractic</kwd><kwd>osteopathy</kwd><kwd>informed consent</kwd><kwd>risk management</kwd></kwd-group></article-meta></front></article>