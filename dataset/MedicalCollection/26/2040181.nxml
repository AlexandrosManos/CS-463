urnal"><person-group person-group-type="author"><name><surname>Bucan</surname><given-names>M</given-names></name></person-group><article-title>The mouse: genetics meets behaviour</article-title><source>Nat Rev Genet</source><year>2002</year><volume>3</volume><fpage>114</fpage><lpage>123</lpage><pub-id pub-id-type="pmid">11836505</pub-id></citation></ref><ref id="b12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Byrom</surname><given-names>AE</given-names></name></person-group><article-title>Natal dispersal of juvenile arctic ground squirrels in the boreal forest</article-title><source>Can J Zool</source><year>1999</year><volume>77</volume><fpage>1048</fpage><lpage>1059</lpage></citation></ref><ref id="b13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Calcagnetti</surname><given-names>DJ</given-names></name></person-group><article-title>Place conditioning reveals the rewarding aspect of social interaction in juvenile rats</article-title><source>Physiol Behav</source><year>1992</year><volume>51</volume><fpage>667</fpage><lpage>672</lpage><pub-id pub-id-type="pmid">1594664</pub-id></citation></ref><ref id="b14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Camacho</surname><given-names>F</given-names></name></person-group><article-title>Sexual experience and conditioned place preference in male rats</article-title><source>Pharmacol Biochem Behav</source><year>2004</year><volume>78</volume><fpage>419</fpage><lpage>425</lpage><pub-id pub-id-type="pmid">15251250</pub-id></citation></ref><ref id="b15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cohen</surname><given-names>RM</given-names></name></person-group><article-title>Quantitative trait loci affecting the behavior of A/J and CBA/J intercross mice in the elevated plus maze</article-title><source>Mamm Genome</source><year>2001</year><volume>1