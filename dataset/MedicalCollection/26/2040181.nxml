ype="book"><person-group person-group-type="author"><name><surname>Dickinson</surname><given-names>A</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Pashler</surname><given-names>H</given-names></name></person-group><article-title>The role of learning in the operation of motivational systems</article-title><source>Stevens&#x02019; Handbook of Experimental Psychology</source><year>2002</year><volume>3</volume><edition>3</edition><publisher-loc>New York</publisher-loc><publisher-name>John Wiley &#x00026; Sons</publisher-name><fpage>497</fpage><lpage>533</lpage></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Douglas</surname><given-names>LA</given-names></name></person-group><article-title>Novel-object place conditioning in adolescent and adult male and female rats: effects of social isolation</article-title><source>Physiol Behav</source><year>2003</year><volume>80</volume><fpage>317</fpage><lpage>325</lpage><pub-id pub-id-type="pmid">14637231</pub-id></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Douglas</surname><given-names>LA</given-names></name></person-group><article-title>Rewarding properties of social interactions in adolescent and adult male and female rats: impact of social versus isolate housing of subjects and partners</article-title><source>Dev Psychobiol</source><year>2004</year><volume>45</volume><fpage>153</fpage><lpage>162</lpage><pub-id pub-id-type="pmid">15505797</pub-id></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Drewett</surname><given-names>RF</given-names></name></person-group><article-title>Sexual behaviour and sexual motivation in the female rat</article-title><source>Nature</source><year>1973</year><volume>242</volume><fpage>476</fpage><lpage>477</lpage><pub-id pub-id-type="pmid">4735606</pub-id></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Drickamer</surname><given-names>LC</given-names></name></person-group><article-title>Double captures of house mice (Mus musculus) with information on genetic relatedness</article-title><source>Am Midl Nat</source><year>2003</year><volume>150</volume><fpage>308</fpage><lpage>320</lpage></citation></ref><ref id="b25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dugatkin</surname><given-names>LA</given-names></name></person-group><article-title>Animal cooperation among unrelated individuals</article-title><source>Naturwissenschaften</source><year>2002</year><volume>89</volume><fpage>533</fpage><lpage>541</lpage><pub-id pub-id-type="pmid">12536274</pub-id></citation></ref><ref id="b26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ebensberger</surname><given-names>LA</given-names></name></person-group><article-title>A review of the evolutionary causes of group-living</article-title><source>Acta Theriol</source><year>2001</year><volume>46</volume><fpage>115</fpage><lpage>144</lpage></citation></ref><ref id="b27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Edwards</surname><given-names>DA</given-names></name></person-group><article-title>Olfactory bulb removal: effects on sexual behavior and partner-preference in male rats</article-title><source>Physiol Behav</source><year>1990</year><volume>48</volume><fpage>447</fpage><lpage>450</lpage><pub-id pub-id-type="pmid">2267253</pub-id></citation></ref><ref id="b28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fish</surname><given-names>EW</given-names></name></person-group><article-title>Escalated aggression as a reward: corticosterone and GABA(A) receptor positive modulators in mice</article-title><source>Psychopharmacology (Berl)</source><year>2005</year><volume>182</volume><fpage>116</fpage><lpage>127</lpage><pub-id pub-id-type="pmid">16133129</pub-id></citation></ref><ref id="b29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fitchett</surname><given-names>AE</given-names></name></person-group><article-title>There&#x02019;s no place like home: cage odours and place preference in subordinate CD-1 male mice</article-title><source>Physiol Behav</source><year>2006</year><volume>87</volume><fpage>955</fpage><lpage>962</lpage><pub-id pub-id-type="pmid">16580031</pub-id></citation></ref><ref id="b30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gerlach</surname><given-names>G</given-names></name></person-group><article-title>Impact of social ties on dispersal, reproduction and dominance in feral house mice</article-title><source>Ethology</source><year>1998</year><volume>104</volume><fpage>487</fpage><lpage>499</lpage></citation></ref><ref id="b31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Glickman</surname><given-names>SE</given-names></name></person-group><article-title>A biological theory of reinforcement</article-title><source>Psychol Rev</source><year>1967</year><volume>74</volume><fpage>81</fpage><lpage>109</lpage><pub-id pub-id-type="pmid">5342347</pub-id></citation></ref><ref id="b32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamilton</surname><given-names>WD</given-names></name></person-group><article-title>Geometry for the selfish herd</article-title><source>J Theor Biol</source><year>1971</year><volume>31</volume><fpage>295</fpage><lpage>311</lpage><pub-id pub-id-type="pmid">5104951</pub-id></citation></ref><ref id="b33"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ikemoto</surname><given-names>S</given-names></name></person-group><article-title