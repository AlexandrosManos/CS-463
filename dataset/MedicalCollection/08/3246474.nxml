id="pone.0029646-Artlett1"><label>7</label><element-citation publication-type="journal">             <person-group person-group-type="author"><name><surname>Artlett</surname><given-names>CM</given-names></name><name><surname>Smith</surname><given-names>JB</given-names></name><name><surname>Jimenez</surname><given-names>SA</given-names></name></person-group>             <year>1998</year>             <article-title>Identification of fetal DNA and cells in skin lesions from women with systemic sclerosis.</article-title>             <source>N Engl J Med</source>             <volume>338</volume>             <fpage>1186</fpage>             <lpage>1191</lpage>          <pub-id pub-id-type="pmid">9554859</pub-id></element-citation></ref><ref id="pone.0029646-Scaletti1"><label>8</label><element-citation publication-type="journal">             <person-group person-group-type="author"><name><surname>Scaletti</surname><given-names>C</given-names></name><name><surname>Vultaggio</surname><given-names>A</given-names></name><name><surname>Bonifacio</surname><given-names>S</given-names></name><name><surname>Emmi</surname><given-names>L</given-names></name><name><surname>Torricelli</surname><given-names>F</given-names></name><etal/></person-group>             <year>2002</year>             <article-title>Th2-oriented profile of male offspring T cells present in women with systemic sclerosis and reactive with maternal major histocompatibility complex antigens.</article-title>             <source>Arthritis Rheum</source>             <volume>46</volume>             <fpage>445</fpage>             <lpage>450</lpage>          <pub-id pub-id-type="pmid">11840447</pub-id></element-citation></ref><ref id="pone.0029646-Renne1"><label>9</label><element-citation publication-type="journal">             <person-group person-group-type="author"><name><surname>Renne</surname><given-names>C</given-names></name><name><surname>Ramos Lopez</surname><given-names>E</given-names></name><name><surname>Steimle-Grauer</surname><given-names>SA</given-names></name><name><surname>Ziolkowski</surname><given-names>P</given-names></name><name><surname>Pani</surname><given-names>MA</given-names></name><etal/></person-group>             <year>2004</year>             <article-title>Thyroid fetal male microchimerisms in mothers with thyroid disorders: presence of Y-chromosomal immunofluorescence in thyroid-infiltrating lymphocytes is more prevalent in Hashimoto's thyroiditis and Graves' disease than in follicular adenomas.</article-title>             <source>J Clin Endocrinol Metab</source>             <volume>89</volume>             <fpage>5810</fpage>             <lpage>5814</lpage>          <pub-id pub-id-type="pmid">15531546</pub-id></element-citation></ref><ref id="pone.0029646-Klintschar1"><label>10</label><element-citation publication-type="journal">             <person-group person-group-type="author"><name><surname>Klintschar</surname><given-names>M</given-names></name><name><surname>Schwaiger</surname><given-names>P</given-names></name><name><surname>Mannweiler</surname><given-names>S</given-names></name><name><surname>Regauer</surname><given-names>S</given-names></name><name><surname>Kleiber</surname><given-names>M</given-names></name></person-group>             <year>2001</year>             <article-title>Evidence of fetal microchimerism in Hashimoto's thyroiditis.</article-title>             <source>J Clin Endocrinol Metab</source>             <volume>86</volume>             <fpage>2494</fpage>             <lpage>2498</lpage>          <pub-id pub-id-type="pmid">11397845</pub-id></element-citation></ref><ref id="pone.0029646-Srivatsa1"><label>11</label><element-citation publication-type="journal">             <person-group person-group-type="author"><name><surname>Srivatsa</surname><given-names>B</given-names></name><name><surname>Srivatsa</surname><given-names>S</given-names></name><name><surname>Johnson</surname><given-names>KL</given-names></name><name><surname>Samu