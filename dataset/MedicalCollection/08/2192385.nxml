id="Feldherretal1984"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Feldherr</surname><given-names>C.M.</given-names></name><name><surname>Kallenbach</surname><given-names>E.</given-names></name><name><surname>Schultz</surname><given-names>N.</given-names></name></person-group><article-title>Movement of a karyophilic protein through the nuclear pores of oocytes</article-title><source>J. Cell Biol.</source><volume>99</volume><year>1984</year><fpage>2216</fpage><lpage>2222</lpage><pub-id pub-id-type="pmid">6501421</pub-id></citation></ref><ref id="Floeretal1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Floer</surname><given-names>M.</given-names></name><name><surname>Blobel</surname><given-names>G.</given-names></name><name><surname>Rexach</surname><given-names>M.</given-names></name></person-group><article-title>Disassembly of RanGTP-karyopherin beta complex, an intermediate in nuclear protein import</article-title><source>J. Biol. Chem.</source><volume>272</volume><year>1997</year><fpage>19538</fpage><lpage>19546</lpage><pub-id pub-id-type="pmid">9235958</pub-id></citation></ref><ref id="FloerandBlobel1999"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Floer</surname><given-names>M.</given-names></name><name><surname>Blobel</surname><given-names>G.</given-names></name></person-group><article-title>Putative reaction intermediates in Crm1-mediated nuclear protein export</article-title><source>J. Biol. Chem</source><volume>274</volume><year>1999</year><fpage>16279</fpage><lpage>16286</lpage><pub-id pub-id-type="pmid">10347184</pub-id></citation></ref><ref id="Galyetal2000"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Galy</surname><given-names>V.</given-names></name><name><surname>Olivo-Marin</surname><given-names>J.C.</given-names></name><name><surname>Scherthan</surname><given-names>H.</g