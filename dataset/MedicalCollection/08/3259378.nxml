<year>1998</year><volume>136</volume><issue>5</issue><fpage>824</fpage><lpage>830</lpage><pub-id pub-id-type="doi">10.1016/S0002-8703(98)70127-9</pub-id><pub-id pub-id-type="pmid">9812077</pub-id></mixed-citation></ref><ref id="CR15"><label>15.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dutka</surname><given-names>DP</given-names></name><etal/></person-group><article-title>Marked variation in the cardiomyopathy associated with Friedreich&#x02019;s ataxia</article-title><source>Heart</source><year>1999</year><volume>81</volume><issue>2</issue><fpage>141</fpage><lpage>147</lpage><pub-id pub-id-type="pmid">9922348</pub-id></mixed-citation></ref><ref id="CR16"><label>16.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Durr</surname><given-names>A</given-names></name><etal/></person-group><article-title>Clinical and genetic abnormalities in patients with Friedreich&#x02019;s ataxia</article-title><source>N Engl J Med</source><year>1996</year><volume>335</volume><issue>16</issue><fpage>1169</fpage><lpage>1175</lpage><pub-id pub-id-type="doi">10.1056/NEJM199610173351601</pub-id><pub-id pub-id-type="pmid">8815938</pub-id></mixed-citation></ref><ref id="CR17"><label>17.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Harding</surname><given-names>AE</given-names></name></person-group><article-title>Friedreich&#x02019;s ataxia: a clinical and genetic study of 90 families with an analysis of early diagnostic criteria and intrafamilial clustering of clinical features</article-title><source>Brain</source><year>1981</year><volume>104</volume><issue>3</issue><fpage>589</fpage><lpage>620</lpage><pub-id pub-id-type="doi">10.1093/brain/104.3.589</pub-id><pub-id pub-id-type="pmid">7272714</pub-id></mixed-citation></ref><ref id="CR18"><label>18.</label><mixed-citation publication-type="journal"><person-group p