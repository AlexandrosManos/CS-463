rson-group person-group-type="author"><name><surname>Sha</surname><given-names>WC</given-names></name><name><surname>Nelson</surname><given-names>CA</given-names></name><name><surname>Newberry</surname><given-names>RD</given-names></name><name><surname>Kranz</surname><given-names>DM</given-names></name><name><surname>Russell</surname><given-names>JH</given-names></name><name><surname>Loh</surname><given-names>DY</given-names></name></person-group><article-title>Positive and negative selection of an antigen receptor on T cells in transgenic mice</article-title><source>Nature</source><year>1988</year><volume>336</volume><fpage>73</fpage><lpage>76</lpage><pub-id pub-id-type="pmid">3263574</pub-id></citation></ref><ref id="B10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Utsunomiya</surname><given-names>Y</given-names></name><name><surname>Bill</surname><given-names>J</given-names></name><name><surname>Palmer</surname><given-names>E</given-names></name><name><surname>Gollob</surname><given-names>K</given-names></name><name><surname>Takagaki</surname><given-names>Y</given-names></name><name><surname>Kanagawa</surname><given-names>O</given-names></name></person-group><article-title>Analysis of a monoclonal rat antibody directed to the &#x003b1;-chain variable region (V&#x003b1;3) of the mouse T cell antigen receptor</article-title><source>J Immunol</source><year>1989</year><volume>143</volume><fpage>2602</fpage><lpage>2608</lpage><pub-id pub-id-type="pmid">2477449</pub-id></citation></ref><ref id="B11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jameson</surname><given-names>SC</given-names></name><name><surname>Kaye</surname><given-names>J</given-names></name><name><surname>Gascoigne</surname><given-names>NRJ</given-names></name></person-group><article-title>A T cell  receptor V&#x003b1; region selectively expressed in CD4<sup>&#x0002b;</sup>cells