 citation-type="journal"><person-group person-group-type="author"><name><surname>Fukagawa</surname><given-names>T.</given-names></name><name><surname>Brown</surname><given-names>W.R.</given-names></name></person-group><article-title>Efficient conditional mutation of the vertebrate CENP-C gene</article-title><source>Hum. Mol. Genet</source><volume>6</volume><year>1997</year><fpage>2301</fpage><lpage>2308</lpage><pub-id pub-id-type="pmid">9361037</pub-id></citation></ref><ref id="Fukagawaetal1999"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fukagawa</surname><given-names>T.</given-names></name><name><surname>Pendon</surname><given-names>C.</given-names></name><name><surname>Morris</surname><given-names>J.</given-names></name><name><surname>Brown</surname><given-names>W.</given-names></name></person-group><article-title>CENP-C is necessary but not sufficient to induce formation of a functional centromere</article-title><source>EMBO J</source><volume>18</volume><year>1999</year><fpage>4196</fpage><lpage>4209</lpage><pub-id pub-id-type="pmid">10428958</pub-id></citation></ref><ref id="HeandBrinkley1996"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>He</surname><given-names>D.</given-names></name><name><surname>Brinkley</surname><given-names>B.R.</given-names></name></person-group><article-title>Structure and dynamic organization of centromeres/prekinetochores in the nucleus of mammalian cells</article-title><source>J. Cell Sci</source><volume>109</volume><year>1996</year><fpage>2693</fpage><lpage>2704</lpage><pub-id pub-id-type="pmid">8937987</pub-id></citation></ref><ref id="Heneen1975"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heneen</surname><given-names>W.K.</given-names></name></person-group><article-title>Ultrastructure of the prophase kinetochore in cultured cells of rat-kangaroo (<italic>Potorous tridactylis</italic>)</article-