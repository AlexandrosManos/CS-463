ase</td><td align="left" rowspan="1" colspan="1">3.21</td><td align="left" rowspan="1" colspan="1">0.000231</td><td align="left" rowspan="1" colspan="1">2.95</td><td align="left" rowspan="1" colspan="1">0.005812</td></tr><tr><td align="left" rowspan="1" colspan="1">DR1306</td><td align="left" rowspan="1" colspan="1">Predicted protein</td><td align="left" rowspan="1" colspan="1">2.27</td><td align="left" rowspan="1" colspan="1">0.007313</td><td align="left" rowspan="1" colspan="1">2.75</td><td align="left" rowspan="1" colspan="1">0.045296</td></tr><tr><td align="left" rowspan="1" colspan="1">DR1314</td><td align="left" rowspan="1" colspan="1">Uncharacterized proteins, ysnf-like repeats</td><td align="left" rowspan="1" colspan="1">2.68</td><td align="left" rowspan="1" colspan="1">0.000105</td><td align="left" rowspan="1" colspan="1">2.20</td><td align="left" rowspan="1" colspan="1">0.06613</td></tr><tr><td align="left" rowspan="1" colspan="1">DR1331</td><td align="left" rowspan="1" colspan="1">Predicted protein</td><td align="left" rowspan="1" colspan="1">2.31</td><td align="left" rowspan="1" colspan="1">0.002401</td><td align="left" rowspan="1" colspan="1">2.69</td><td align="left" rowspan="1" colspan="1">0.03801</td></tr><tr><td align="left" rowspan="1" colspan="1">DR1385</td><td align="left" rowspan="1" colspan="1">Predicted protein</td><td align="left" rowspan="1" colspan="1">5.33</td><td align="left" rowspan="1" colspan="1">0.00164</td><td align="left" rowspan="1" colspan="1">2.50</td><td align="left" rowspan="1" colspan="1">0.029004</td></tr><tr><td align="left" rowspan="1" colspan="1">DR1697</td><td align="left" rowspan="1" colspan="1">Predicted protein</td><td align="left" rowspan="1" colspan="1">2.81</td><td align="left" rowspan="1" colspan="1">0.006795</td><td align="left" rowspan="1" colspan="1">4.11</td><td align="left" rowspan="1" colspan="1">0.006687</td></tr><tr><td align="left" rowspan="1" colspan="1">DR1708</td><td align="left" rowspan="1" colspan="1"