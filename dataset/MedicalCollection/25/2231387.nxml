ge><pub-id pub-id-type="pmid">17084067</pub-id><pub-id pub-id-type="doi">10.1016/j.ijantimicag.2006.08.021</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Andre-Fontaine</surname><given-names>G</given-names></name></person-group><article-title>Canine leptospirosis &#x02013; do we have a problem?</article-title><source>Vet Microbiol</source><year>2006</year><volume>117</volume><fpage>19</fpage><lpage>24</lpage><pub-id pub-id-type="pmid">16684591</pub-id><pub-id pub-id-type="doi">10.1016/j.vetmic.2006.04.005</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McBride</surname><given-names>AJ</given-names></name><name><surname>Athanazio</surname><given-names>DA</given-names></name><name><surname>Reis</surname><given-names>MG</given-names></name><name><surname>Ko</surname><given-names>AI</given-names></name></person-group><article-title>Leptospirosis</article-title><source>Curr Opin Infect Dis</source><year>2005</year><volume>18</volume><fpage>376</fpage><lpage>386</lpage><pub-id pub-id-type="pmid">16148523</pub-id><pub-id pub-id-type="doi">10.1097/01.qco.0000178824.05715.2c</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koizumi</surname><given-names>N</given-names></name><name><surname>Watanabe</surname><given-names>H</given-names></name></person-group><article-title>Leptospirosis vaccines: past, present, and future</article-title><source>J Postgrad Med</source><year>2005</year><volume>51</volume><fpage>210</fpage><lpage>214</lpage><pub-id pub-id-type="pmid">16333195</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zuerner</surname><given-names>R</given-names></name><name><surname>Haake</surname><given-names>D</given-names></name><name><surname>Adler</surnam