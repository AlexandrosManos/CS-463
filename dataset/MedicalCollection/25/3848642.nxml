an="1">0.725</td><td align="left" valign="top" rowspan="1" colspan="1">60.7</td><td align="left" valign="top" rowspan="1" colspan="1">93.6</td><td align="left" valign="top" rowspan="1" colspan="1"/></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Joinpoint regression (total sample)</td><td align="left" valign="top" rowspan="1" colspan="1">6.4%</td><td align="left" valign="top" rowspan="1" colspan="1">&#x02013;</td><td align="left" valign="top" rowspan="1" colspan="1">85.1</td><td align="left" valign="top" rowspan="1" colspan="1">82.1</td><td align="left" valign="top" rowspan="1" colspan="1">NR</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Joinpoint regression (exclusion of subjects receiving antihyperglycemic medication)</td><td align="left" valign="top" rowspan="1" colspan="1">6.7%</td><td align="left" valign="top" rowspan="1" colspan="1">&#x02013;</td><td align="left" valign="top" rowspan="1" colspan="1">60.7</td><td align="left" valign="top" rowspan="1" colspan="1">91.6</td><td align="left" valign="top" rowspan="1" colspan="1"/></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Tsugawa et al<xref ref-type="bibr" rid="b36-dmso-6-477">36</xref></td><td align="left" valign="top" rowspan="1" colspan="1">Cross-sectional; 2,804 White and 1,008 Black Americans; analysis of whole study group and of subjects not treated for diabetes only; age &#x02265;40 years</td><td align="left" valign="top" rowspan="1" colspan="1">One or more microaneurysms or more severe forms of retinopathy; Airlie House classification</td><td align="left" valign="top" rowspan="1" colspan="1">Visual inspection of cubic-spline models</td><td colspan="5" align="left" valign="top" rowspan="1">Cutoff &#x0201c;near 5.5%&#x0201d; in Blacks, &#x0201c;at higher HbA<sub>1c</sub> levels&#x0201d; in Whites</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Tsugawa et al<xref ref-type="bibr" rid="b26-dmso-6-477">26</xref></td><td align="left" valign=