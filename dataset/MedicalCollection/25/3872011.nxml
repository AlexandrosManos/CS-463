1">&#x02003;Male</td><td align="left" valign="top" rowspan="1" colspan="1">201 (56.3)</td><td align="left" valign="top" rowspan="1" colspan="1">55 (55.0)</td><td align="left" valign="top" rowspan="1" colspan="1">35 (50.7)</td><td align="left" valign="top" rowspan="1" colspan="1">0.413</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;Age (years), median (IQR)</td><td align="left" valign="top" rowspan="1" colspan="1">17.0 (7.0&#x02013;42.0)</td><td align="left" valign="top" rowspan="1" colspan="1">31.5 (12.5&#x02013;50.0)</td><td align="left" valign="top" rowspan="1" colspan="1">46.0 (34.0&#x02013;64.0)</td><td align="left" valign="top" rowspan="1" colspan="1">&#x0003c;0.001</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;Underlying diseases</td><td align="left" valign="top" rowspan="1" colspan="1">30 (8.4)</td><td align="left" valign="top" rowspan="1" colspan="1">14 (14.0)</td><td align="left" valign="top" rowspan="1" colspan="1">8 (11.6)</td><td align="left" valign="top" rowspan="1" colspan="1">0.186</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;Durations of fever (days), median (IQR)</td><td align="left" valign="top" rowspan="1" colspan="1">6 (4&#x02013;7)</td><td align="left" valign="top" rowspan="1" colspan="1">7 (4&#x02013;7)</td><td align="left" valign="top" rowspan="1" colspan="1">7 (4&#x02013;7)</td><td align="left" valign="top" rowspan="1" colspan="1">0.961</td></tr><tr><td colspan="5" align="left" valign="top" rowspan="1">Signs and symptoms</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;Myalgia</td><td align="left" valign="top" rowspan="1" colspan="1">69 (19.3)</td><td align="left" valign="top" rowspan="1" colspan="1">23 (23.0)</td><td align="left" valign="top" rowspan="1" colspan="1">13 (18.8)</td><td align="left" valign="top" rowspan="1" colspan="1">0.820</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">&#x02003;Headache</td>