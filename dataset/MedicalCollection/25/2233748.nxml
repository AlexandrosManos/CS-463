n</article-title><source>J. Ultrastruct. Res.</source><volume>93</volume><year>1985</year><fpage>1</fpage><lpage>16</lpage><pub-id pub-id-type="pmid">3835280</pub-id></citation></ref><ref id="HamiltonandIanuzzo1991"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamilton</surname><given-names>N.</given-names></name><name><surname>Ianuzzo</surname><given-names>C.D.</given-names></name></person-group><article-title>Contractile and calcium regulating capacities of myocardia of different sized mammals scale with resting heart rate</article-title><source>Mol. Cell. Biochem.</source><volume>106</volume><year>1991</year><fpage>133</fpage><lpage>141</lpage><pub-id pub-id-type="pmid">1656210</pub-id></citation></ref><ref id="Hoetal1989"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ho</surname><given-names>S.N.</given-names></name><name><surname>Hunt</surname><given-names>H.D.</given-names></name><name><surname>Horton</surname><given-names>R.M.</given-names></name><name><surname>Pullen</surname><given-names>J.K.</given-names></name><name><surname>Pease</surname><given-names>L.R.</given-names></name></person-group><article-title>Site-directed mutagenesis by overlap extension using the polymerase chain reaction</article-title><source>Gene.</source><volume>77</volume><year>1989</year><fpage>51</fpage><lpage>59</lpage><pub-id pub-id-type="pmid">2744487</pub-id></citation></ref><ref id="Keenetal1999"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Keen</surname><given-names>J.E.</given-names></name><name><surname>Khawaled</surname><given-names>R.</given-names></name><name><surname>Farrens</surname><given-names>D.L.</given-names></name><name><surname>Neelands</surname><given-names>T.</given-names></name><name><surname>Rivard</surname><given-names>A.</given-names></name><name><surname>Bond</surname><given-names>C.T.</given-names></name><name><surname>Jano