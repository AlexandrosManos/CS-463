></name><name><surname>Crosby</surname><given-names>RD</given-names></name></person-group><article-title>Somatic symptoms in anxious-depressed school refusers</article-title><source>J Am Acad Child Adolesc Psychiatry</source><year>1997</year><volume>36</volume><fpage>661</fpage><lpage>668</lpage><pub-id pub-id-type="pmid">9136501</pub-id></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kearney</surname><given-names>CA</given-names></name><name><surname>Roblek</surname><given-names>TL</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Briesmeister JM, Schaefer CD</surname></name></person-group><article-title>Parent training in the treatment of school refusal behavior</article-title><source>Handbook of Parent Training: Parents as Co-Therapists for Children's Behavior Problems</source><year>1997</year><edition>2</edition><publisher-name>New York: Wiley</publisher-name></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kessler</surname><given-names>RC</given-names></name><name><surname>Foster</surname><given-names>CL</given-names></name><name><surname>Saunders</surname><given-names>WB</given-names></name><name><surname>Stang</surname><given-names>PE</given-names></name></person-group><article-title>Social consequences of psychiatric disorders, I: Educational attainment</article-title><source>Am J Psychiatry</source><year>1995</year><volume>152</volume><fpage>1026</fpage><lpage>1032</lpage><pub-id pub-id-type="pmid">7793438</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pine</surname><given-names>DS</given-names></name><name><surname>Wasserman</surname><given-names>GA</given-names></name><name><surname>Workman</surname><given-names>SB</given-names></name></person-group><article-title>Memory and anxiety in prepubertal boys at risk for delinquency</article-title><source>J Am Acad Child Adolesc Psychiatry</source><year>1999</year><volume>38</volume><fpage>1024</fpage><lpage>1031</lpage><pub-id pub-id-type="pmid">10434495</pub-id><pub-id pub-id-type="doi">10.1097/00004583-199908000-00019</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bulbena</surname><given-names>A</given-names></name><name><surname>Berrios</surname><given-names>GE</given-names></name></person-group><article-title>Cognitive function in affective disorder: a prospective study</article-title><source>Psychopathology</source><year>1993</year><volume>26</volume><fpage>6</fpage><lpage>12</lpage><pub-id pub-id-type="pmid">8511231</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Daleiden</surname><given-names>EL</given-names></name></person-group><article-title>Childhood anxiety and memory</article-title><source>J Exper Child Psychol</source><year>1998</year><volume>68</volume><fpage>216</fpage><lpage>235</lpage><pub-id pub-id-type="pmid">9514771</pub-id><pub-id pub-id-type="doi">10.1006/jecp.1997.2429</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wittchen</surname><given-names>HU</given-names></name><name><surname>Stein</surname><given-names>MB</given-names></name><name><surname>Kessler</surname><given-names>RC</given-names></name></person-group><article-title>Social fears and social phobia in a community sample of adolescents and young adults : prevalence, risk factors and comorbidity</article-title><source>Psychol Med</source><year>1999</year><volume>29</volume><fpage>309</fpage><lpage>323</lpage><pub-id pub-id-type="pmid">10218923</pub-id><pub-id pub-id-type="doi">10.1017/S0033291798008174</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group p