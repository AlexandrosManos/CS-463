 monkey</article-title><source>J. Comp. Neurol.</source><year>1993</year><volume>335</volume><fpage>200</fpage><lpage>213</lpage><pub-id pub-id-type="pmid">8227514</pub-id></citation></ref><ref id="b14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eckhorn</surname><given-names>R</given-names></name></person-group><article-title>A new method for the insertion of multiple microprobes into neural and muscular tissue, including fiber electrodes, fine wires, needles and microsensors</article-title><source>J. Neurosci. Meth.</source><year>1993</year><volume>49</volume><fpage>175</fpage><lpage>179</lpage></citation></ref><ref id="b15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Edin</surname><given-names>B</given-names></name></person-group><article-title>Skin strain patterns provide kinaesthetic information to the human central nervous system</article-title><source>J. Physiol. (Lond.)</source><year>1995</year><volume>487</volume><fpage>243</fpage><lpage>251</lpage><pub-id pub-id-type="pmid">7473253</pub-id></citation></ref><ref id="b16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ernst</surname><given-names>U</given-names></name></person-group><article-title>Synchronization induced by temporal delays in pulse-coupled oscillators</article-title><source>Phys. Rev. Lett.</source><year>1995</year><volume>74</volume><fpage>1570</fpage><lpage>1573</lpage><pub-id pub-id-type="pmid">10059062</pub-id></citation></ref><ref id="b17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Evans</surname><given-names>CM</given-names></name></person-group><article-title>Task-dependent intermanual coupling of 8-Hz discontinuities during slow finger movements</article-title><source>Eur. J. Neurosci.</source><year>2003</year><volume>18</volume><fpage>453</fpage><lpage>456</lpage><pub-id pub-id-type="pmid">12887428</pub-i