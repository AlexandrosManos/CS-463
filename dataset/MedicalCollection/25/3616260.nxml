source>J. Nucl. Med.</source><volume>51</volume>, <fpage>158</fpage>&#x02013;<lpage>163</lpage><pub-id pub-id-type="doi">10.2967/jnumed.109.066399</pub-id><pub-id pub-id-type="pmid">20008997</pub-id></mixed-citation></ref><ref id="B5"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Czernin</surname><given-names>J.</given-names></name><name><surname>Phelps</surname><given-names>M. E.</given-names></name></person-group> (<year>2002</year>). <article-title>Positron emission tomography scanning: current and future applications</article-title>. <source>Annu. Rev. Med.</source><volume>53</volume>, <fpage>89</fpage>&#x02013;<lpage>112</lpage><pub-id pub-id-type="doi">10.1146/annurev.med.53.082901.104028</pub-id><pub-id pub-id-type="pmid">11818465</pub-id></mixed-citation></ref><ref id="B6"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Grupta</surname><given-names>N. C.</given-names></name><name><surname>Peter</surname><given-names>N.</given-names></name><name><surname>Blomfield</surname><given-names>S. M.</given-names></name></person-group> (<year>1999</year>). <article-title>FDG-PET in staging work-up of patients with suspected intracranial metastatic tumors</article-title>. <source>Ann. Surg.</source><volume>230</volume>, <fpage>202</fpage>&#x02013;<lpage>206</lpage><pub-id pub-id-type="doi">10.1097/00000658-199908000-00010</pub-id><pub-id pub-id-type="pmid">10450734</pub-id></mixed-citation></ref><ref id="B7"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hillner</surname><given-names>B. E.</given-names></name><name><surname>Siegel</surname><given-names>B. A.</given-names></name><name><surname>Shields</surname><given-names>A. F.</given-names></name><name><surname>Duan</surname><given-names>F.</given-names></name><name><surname>Gareen</surname><given-names>I. F.</given-names></name><name><surname>Hanna</surname><given-names>L.</given-names></name><etal/></person-group> (<year>2011</year>). <article-title>Impact of dedicated brain PET on intended patient management in participants of the national oncologic PET registry</article-title>. <source>Mol. Imaging Biol.</source><volume>13</volume>, <fpage>161</fpage>&#x02013;<lpage>165</lpage><pub-id pub-id-type="doi">10.1007/s11307-010-0427-5</pub-id><pub-id pub-id-type="pmid">21080232</pub-id></mixed-citation></ref><ref id="B8"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Huston</surname><given-names>F.</given-names></name><name><surname>Abdelmalik</surname><given-names>A. G.</given-names></name><name><surname>Jackson</surname><given-names>R.</given-names></name><name><surname>Osman</surname><given-names>M. M.</given-names></name></person-group> (<year>2010</year>). <article-title>Whole-body 18F-FDG PET/CT: the need for a standardized field of view &#x02013; a referring-physician aid</article-title>. <source>J. Nucl. Med. Technol.</source><volume>38</volume>, <fpage>123</fpage>&#x02013;<lpage>127</lpage><pub-id pub-id-type="doi">10.2967/jnmt.109.073353</pub-id><pub-id pub-id-type="pmid">20724533</pub-id></mixed-citation></ref><ref id="B9"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Larcos</surname><given-names>G.</given-names></name><name><surname>Maisey</surname><given-names>M. N.</given-names></name></person-group> (<year>1996</year>). <article-title>FDG-PET screening for cerebral metastasis in patients with suspected malignancy</article-title>. <source>Nucl. Med. Commun.</source><volume>17</volume>, <fpage>197</fpage>&#x02013;<lpage>198</lpage><pub-id pub-id-type="doi">10.1097/00006231-199603000-00004</pub-id><pub-id pub-id-type="pmid">8692485</pub-id></mixed-citation></ref><ref id="B10"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ludwig</surname><given-names>V.</given-names></name><name><surname>Komori</surname><given-names>T.</given-names></name><name><surname>Kolb</surname><given-names>D.</given-names></name><name><surname>Martin</surname><given-names>W. H.</given-names></name><name><surname>Sandler</surname><given-names>M. P.</given-names></name><name><surname>Delbeke</surname><given-names>D.</given-names></name><etal/></person-group> (<year>2002</year>). <article-title>Cerebral lesions incidentally detected on 2-deoxy-2-[18F] fluoro-<sc>d</sc>-glucose positron emission tomography images of patients evaluated for body malignancies</article-title>. <source>Mol. Imaging Biol.</source><volume>4</volume>, <fpage>359</fpage>&#x02013;<lpage>362</lpage><pub-id pub-id-type="doi">10.1016/S1536-1632(02)00024-0</pub-id><pub-id pub-id-type="pmid">14537111</pub-id></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nguyen</surname><given-names>N. C.</given-names></name><name><surname>Chaar</surname><given-names>B. T.</given-names></name><name><surname>Osman</surname><given-names>M. M.</given-names></name></person-group> (<year>2007</year>). <article-title>Prevalence and patterns of soft tissue metastasis: detection with true whole-body F-18 FDG PET/CT</article-title>. <source>BMC Med. Imaging</source><volume>2</volume>:<fpage>8</fpage><pub-id pub-id-type="doi">10.1186/1471-2342-7-8</pub-id><pub-id pub-id-type="pmid">18076764</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Niederkohr</surname><given-names>R. D.</given-names></name><name><surname>Rosenberg</surname><given-names>J.</given-names></name><name><surname>Shabo</surname><given-names>G.</given-names></name><name><surname>Quon</surname><given-names>A.</given-names></name></person-group> (<year>2007</year>). <article-title>Clinical value of including the head and lower extremities in 18F-FDG PET/CT imaging for patients with malignant melanoma</article-title>. <source>Nucl. Med. Commun.</source><volume>28</volume>, <fpage>688</fpage>&#x02013;<lpage>695</lpage><pub-id pub-id-type="doi">10.1097/MNM.0b013e32827420cc</pub-id><pub-id pub-id-type="pmid">17667747</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="webpage"><collab>National Comprehensive Cancer Network</collab> (<year>2011</year>). <source>Non-Small Cell Lung Cancer, Version 3.2011. Clinical Practice Guidelines in Oncology</source>. Available at: <uri xlink:type="simple" xlink:href="http://www.nccn.org">www.nccn.org</uri> [accessed December 5, 2011].</mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Osman</surname><given-names>M. M.</given-names></name><name><surname>Chaar</surname><given-names>B. T.</given-names></name><name><surname>Muzaffar</surname><given-names>R.</given-names></name><name><surname>Oliver</surname><given-names>D.</given-names></name><name><surname>Reimers</surname><given-names>H. J.</given-names></name><name><surname>Walz</surname><given-names>B.</given-names></name><etal/></person-group> (<year>2010</year>). <article-title>18F-FDG PET/CT of patients with cancer: comparison of whole-body and limited whole-body technique</article-title>. <source>Am. J. Roentgenol.</source><volume>195</volume>, <fpage>1397</fpage>&#x02013;<lpage>1403</lpage><pub-id pub-id-type="doi">10.2214/AJR.09.3731</pub-id><pub-id pub-id-type="pmid">21098201</pub-id></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rohren</surname><given-names>E. M.</given-names></name><name><surname>Provenzale</surname><given-names>J. M.</given-names></name><name><surname>Barboriak</surname><given-names>D. P.</given-names></name><name><surname>Coleman</surname><given-names>R. E.</given-names></name></person-group> (<year>2003</year>). <article-title>Screening for cerebral metastases with FDG PET in patients undergoing whole-body staging of non-central nervous system malignancy</article-title>. <source>Radiology</source><volume>226</volume>, <fpage>181</fpage>&#x02013;<lpage>187</lpage><pub-id pub-id-type="doi">10.1148/radiol.2261010920</pub-id><pub-id pub-id-type="pmid">12511688</pub-id></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Townsend</surname><given-names>D. W.</given-names></name><name><surname>Carney</surname><given-names>P. J.</given-names></name><name><surname>Yap</surname><given-names>J. T.</given-names></name><name><surname>Hall</surname><given-names>N. C.</given-names></name></person-group> (<year>2004</year>). <article-title>PET/CT today and tomorrow</article-title>. <source>J. Nucl. Med.</source><volume>45</volume>(<issue>Suppl. 1</issue>), <fpage>4S</fpage>&#x02013;<lpage>14S</lpage><pub-id pub-id-type="pmid">14736831</pub-id></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Vecht</surname><given-names>C. J.</given-names></name></person-group> (<year>1998</year>). <article-title>Clinical management of brain metastasis</article-title>. <source>J. Neurol.</source><volume>245</volume>, <fpage>127</fpage>&#x02013;<lpage>131</lpage><pub-id pub-id-type="doi">10.1007/s004150050191</pub-id><pub-id pub-id-type="pmid">9553840</pub-id></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Von Schulthess</surname><given-names>G. K.</given-names></name><name><surname>Steinert</surname><given-names>H. C.</given-names></name><name><surname>Hany</surname><given-names>T. F.</given-names></name></person-group> (<year>2006</year>). <article-title>Integrated PET/CT: current applications and future directions</article-title>. <source>Radiology</source><volume>238</volume>, <fpage>405</fpage>&#x02013;<lpage>422</lpage><pub-id pub-id-type="doi">10.1148/radiol.2382041977</pub-id><pub-id pub-id-type="pmid">16436809</pub-id></mixed-citation></ref></ref-list></back></article>