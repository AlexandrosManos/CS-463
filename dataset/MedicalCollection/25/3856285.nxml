 Proc</source><year>1993</year><volume>68</volume><fpage>642</fpage><lpage>651</lpage><pub-id pub-id-type="pmid">8350637</pub-id></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hagan</surname><given-names>PG</given-names></name><name><surname>Nienaber</surname><given-names>CA</given-names></name><name><surname>Isselbacher</surname><given-names>EM</given-names></name><name><surname>Bruckman</surname><given-names>D</given-names></name><name><surname>Karavite</surname><given-names>DJ</given-names></name><name><surname>Russman</surname><given-names>PL</given-names></name><etal/></person-group><article-title>The International Registry of Acute Aortic Dissection (IRAD): new insights into an old disease</article-title><source>JAMA</source><year>2000</year><volume>283</volume><fpage>897</fpage><lpage>903</lpage><pub-id pub-id-type="pmid">10685714</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Erbel</surname><given-names>R</given-names></name><name><surname>Alfonso</surname><given-names>F</given-names></name><name><surname>Boileau</surname><given-names>C</given-names></name><name><surname>Dirsch</surname><given-names>O</given-names></name><name><surname>Eber</surname><given-names>B</given-names></name><name><surname>Haverich</surname><given-names>A</given-names></name><etal/></person-group><article-title>Diagnosis and management of aortic dissection</article-title><source>Eur Heart J</source><year>2001</year><volume>22</volume><fpage>1642</fpage><lpage>1681</lpage><pub-id pub-id-type="pmid">11511117</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Harris</surname><given-names>KM</given-names></name><name><surname>Strauss</surname><given-names>C