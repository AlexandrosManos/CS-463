ven-names></name><name><surname>Wu</surname><given-names>B</given-names></name><name><surname>Mayton</surname><given-names>L</given-names></name><name><surname>Evans</surname><given-names>CH</given-names></name><name><surname>Robbins</surname><given-names>PD</given-names></name><name><surname>Wooley</surname><given-names>PH</given-names></name></person-group><article-title>IL-1Ra and vIL-10 gene transfer using retroviral vectors ameliorates particle-associated inflammation in the murine air pouch model</article-title><source><italic>Inflammation Research</italic></source><year>2002</year><volume>51</volume><issue>7</issue><fpage>342</fpage><lpage>350</lpage><pub-id pub-id-type="pmid">12146725</pub-id></citation></ref><ref id="B2"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ben-Josef</surname><given-names>E</given-names></name><name><surname>Yang</surname><given-names>S-Y</given-names></name><name><surname>Ji</surname><given-names>TH</given-names></name><etal/></person-group><article-title>Hormone-refractory prostate cancer cells express functional follicle-stimulating hormone receptor (FSHR)</article-title><source><italic>The Journal of Urology</italic></source><year>1999</year><volume>161</volume><issue>3</issue><fpage>970</fpage><lpage>976</lpage><pub-id pub-id-type="pmid">10022736</pub-id></citation></ref><ref id="B25"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yang</surname><given-names>S-Y</given-names></name><name><surname>Wu</surname><given-names>B</given-names></name><name><surname>Mayton</surname><given-names>L</given-names></name><etal/></person-group><article-title>Protective effects of IL-1Ra or vIL-10 gene transfer on a murine model of wear debris-induced osteolysis</article-title><source><italic>Gene Therapy</italic></source><year>2004</year><volume>11</volume><issue>5</issue><fpage>483</fpage><lpage>491</lpage><pub-id pub-id-type="pmid">14724688</pub-id></citation></ref><ref id="B16"><label>11</label><citation citation-type="other"><person-group person-group-type="author"><name><surname>PE Applied Biosystems</surname></name></person-group><article-title>TaqMan cytokine gene expression plate I&#x02014;protocol</article-title><year>1998</year><comment>The PerkinElmer, Foster City, Calif, USA.</comment></citation></ref><ref id="B21"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weidner</surname><given-names>N</given-names></name><name><surname>Carroll</surname><given-names>PR</given-names></name><name><surname>Flax</surname><given-names>J</given-names></name><name><surname>Blumenfeld</surname><given-names>W</given-names></name><name><surname>Folkman</surname><given-names>J</given-names></name></person-group><article-title>Tumor angiogenesis correlates with metastasis in invasive prostate carcinoma</article-title><source><italic>American Journal of Pathology</italic></source><year>1993</year><volume>143</volume><issue>2</issue><fpage>401</fpage><lpage>409</lpage><pub-id pub-id-type="pmid">7688183</pub-id></citation></ref><ref id="B22"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weidner</surname><given-names>N</given-names></name><name><surname>Semple</surname><given-names>JP</given-names></name><name><surname>Welch</surname><given-names>WR</given-names></name><name><surname>Folkman</surname><given-names>J</given-names></name></person-group><article-title>Tumor angiogenesis and metastasis&#x02014;correlation in invasive breast carcinoma</article-title><source><italic>The New England Journal of Medicine</italic></source><year>1991</year><volume>324</volume><issue>1</issue><fpage>1</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">1701519</pub-id></citation></ref><ref id="B8"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hanahan</surname><given-names>D</given-names></name><name><surname>Folkman</surname><given-names>J</given-names></name></person-group><article-title>Patterns and emerging mechanisms of the angiogenic switch during tumorigenesis</article-title><source><italic>Cell</italic></source><year>1996</year><volume>86</volume><issue>3</issue><fpage>353</fpage><lpage>364</lpage><pub-id pub-id-type="pmid">8756718</pub-id></citation></ref><ref id="B19"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Suzuki</surname><given-names>K</given-names></name><name><surname>Hayashi</surname><given-names>N</given-names></name><name><surname>Miyamoto</surname><given-names>Y</given-names></name><etal/></person-group><article-title>Expression of vascular permeability factor/vascular endothelial growth factor in human hepatocellular carcinoma</article-title><source><italic>Cancer Research</italic></source><year>1996</year><volume>56</volume><issue>13</issue><fpage>3004</fpage><lpage>3009</lpage><pub-id pub-id-type="pmid">8674055</pub-id></citation></ref><ref id="B9"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Holzer</surname><given-names>G</given-names></name><name><surname>Obermair</surname><given-names>A</given-names></name><name><surname>Koschat</surname><given-names>M</given-names></name><name><surname>Preyer</surname><given-names>O</given-names></name><name><surname>Kotz</surname><given-names>R</given-names></name><name><surname>Trieb</surname><given-names>K</given-names></name></person-group><article-title>Concentration of vascular endothelial growth factor (VEGF) in the serum of patients with malignant bone tumors</article-title><source><italic>Medical and Pediatric Oncology</italic></source><year>2001</year><volume>36</volume><issue>6</issue><fpage>601</fpage><lpage>604</lpage><pub-id pub-id-type="pmid">11344490</pub-id></citation></ref><ref id="B10"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaya</surname><given-names>M</given-names></name><name><surname>Wada</surname><given-names>T</given-names></name><name><surname>Akatsuka</surname><given-names>T</given-names></name><etal/></person-group><article-title>Vascular endothelial growth factor expression in untreated osteosarcoma is predictive of pulmonary metastasis and poor prognosis</article-title><source><italic>Clinical Cancer Research</italic></source><year>2000</year><volume>6</volume><issue>2</issue><fpage>572</fpage><lpage>577</lpage><pub-id pub-id-type="pmid">10690541</pub-id></citation></ref><ref id="B1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barrios</surname><given-names>C</given-names></name><name><surname>Castresana</surname><given-names>JS</given-names></name><name><surname>Ruiz</surname><given-names>J</given-names></name><name><surname>Kreicbergs</surname><given-names>A</given-names></name></person-group><article-title>Amplification of <italic>c</italic>-<italic>myc</italic> oncogene and absence of <italic>c</italic>-<italic>Ha</italic>-<italic>ras</italic> point mutation in human bone sarcoma</article-title><source><italic>Journal of Orthopaedic Research</italic></source><year>1993</year><volume>11</volume><issue>4</issue><fpage>556</fpage><lpage>563</lpage><pub-id pub-id-type="pmid">8101872</pub-id></citation></ref><ref id="B7"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gamberi</surname><given-names>G</given-names></name><name><surname>Benassi</surname><given-names>MS</given-names></name><name><surname>Bohling</surname><given-names>T</given-names></name><etal/></person-group><article-title><italic>C</italic>-<italic>myc</italic> and <italic>c</italic>-<italic>fos</italic> in human osteosarcoma: prognostic value of mRNA and protein expression</article-title><sourc