<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">J Gen Physiol</journal-id><journal-title>The Journal of General Physiology</journal-title><issn pub-type="ppub">0022-1295</issn><issn pub-type="epub">1540-7748</issn><publisher><publisher-name>The Rockefeller University Press</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">4391049</article-id><article-id pub-id-type="pmc">2225954</article-id><article-categories><subj-group subj-group-type="heading"><subject>Article</subject></subj-group></article-categories><title-group><article-title>Regulation of Liver Tyrosine Aminotransferase by Endogenous Factors in the Mouse</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Finch</surname><given-names>Caleb E.</given-names></name></contrib><contrib contrib-type="author"><name><surname>Huberman</surname><given-names>Harris S.</given-names></name></contrib><contrib contrib-type="author"><name><surname>Mirsky</surname><given-names>Alfred E.</given-names></name></contrib></contrib-group><aff id="N0x1c29d60N0x3516a00">From The Rockefeller University, New York 10021</aff><pub-date pub-type="ppub"><day>1</day><month>12</month><year>1969</year></pub-date><volume>54</volume><issue>6</issue><fpage>675</fpage><lpage>689</lpage><history><date date-type="received"><day>9</day><month>6</month><year>1969</year></date></history><permissions><copyright-statement>Copyright &#x000a9; 1969 by The Rockefeller University Press</copyright-statement></permissions><abstract><p> The levels of mouse liver tyrosine aminotransferase (TAT) are shown to increase rapidly and transiently during and after various challenges (e.g., exposure to cold or shaking) to the homeostatic machinery of the fasted mouse. The increase of TAT is dependent on gene activity. Recent feeding and adrenalectomy are shown to inhibit the induction of TAT during the challenge of cold. </p></abstract></article-meta></front></article>