ub-id-type="pmid">6310023</pub-id></citation></ref><ref id="Jentschetal1990"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jentsch</surname><given-names>T.J.</given-names></name><name><surname>Steinmeyer</surname><given-names>K.</given-names></name><name><surname>Schwarz</surname><given-names>G.</given-names></name></person-group><article-title>Primary structure of <italic>Torpedo marmorata</italic> chloride channel isolated by expression cloning in <italic>Xenopus</italic> oocytes</article-title><source>Nature.</source><volume>348</volume><year>1990</year><fpage>510</fpage><lpage>514</lpage><pub-id pub-id-type="pmid">2174129</pub-id></citation></ref><ref id="Kochetal1992"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koch</surname><given-names>M.C.</given-names></name><name><surname>Steinmeyer</surname><given-names>K.</given-names></name><name><surname>Lorenz</surname><given-names>C.</given-names></name><name><surname>Ricker</surname><given-names>K.</given-names></name><name><surname>Wolf</surname><given-names>F.</given-names></name><name><surname>Otto</surname><given-names>M.</given-names></name><name><surname>Zoll</surname><given-names>B.</given-names></name><name><surname>Lehmann-Horn</surname><given-names>F.</given-names></name><name><surname>Grzeschik</surname><given-names>K.-H.</given-names></name><name><surname>Jentsch</surname><given-names>T.J.</given-names></name></person-group><article-title>The skeletal muscle chloride channel in dominant and recessive human myotonia</article-title><source>Science.</source><volume>257</volume><year>1992</year><fpage>797</fpage><lpage>800</lpage><pub-id pub-id-type="pmid">1379744</pub-id></citation></ref><ref id="Ludewigetal1997a"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ludewig</surname><given-names>U.</given-names></name><name><surname>Jentsch</surname><given-names>T.J.</given-names></