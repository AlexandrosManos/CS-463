icle-title>Medical informatics in the intensive care unit: overview of technology assessment</article-title><source>J Crit Care</source><year>2003</year><volume>18</volume><fpage>41</fpage><lpage>47</lpage><pub-id pub-id-type="pmid">12640613</pub-id><pub-id pub-id-type="doi">10.1053/jcrc.2003.YJCRC9</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clemmer</surname><given-names>TP</given-names></name></person-group><article-title>Computers in the ICU: where we started and where we are now</article-title><source>J Crit Care</source><year>2004</year><volume>19</volume><fpage>201</fpage><lpage>207</lpage><pub-id pub-id-type="pmid">15648035</pub-id><pub-id pub-id-type="doi">10.1016/j.jcrc.2004.08.005</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garland</surname><given-names>A</given-names></name></person-group><article-title>Improving the ICU: part 2</article-title><source>Chest</source><year>2005</year><volume>127</volume><fpage>2165</fpage><lpage>79</lpage><pub-id pub-id-type="pmid">15947334</pub-id><pub-id pub-id-type="doi">10.1378/chest.127.6.2165</pub-id></citation></ref></ref-list></back></article>