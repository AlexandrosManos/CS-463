1994</year><volume>368</volume><fpage>545</fpage><lpage>548</lpage><pub-id pub-id-type="pmid">7511217</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Colamartino</surname><given-names>G</given-names></name><name><surname>Menini</surname><given-names>A</given-names></name><name><surname>Torre</surname><given-names>V</given-names></name></person-group><article-title>Blockage and permeation of divalent cations through the cyclic GMP&#x02013;activated channel from tiger salamander retinal rods</article-title><source>J Physiol</source><year>1991</year><volume>440</volume><fpage>189</fpage><lpage>206</lpage><pub-id pub-id-type="pmid">1725182</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dzeja</surname><given-names>C</given-names></name><name><surname>Hagen</surname><given-names>V</given-names></name><name><surname>Kaupp</surname><given-names>UB</given-names></name><name><surname>Frings</surname><given-names>S</given-names></name></person-group><article-title>Ca<sup>2&#x0002b;</sup>permeation in cyclic nucleotide&#x02013;gated channels</article-title><source>EMBO (Eur Mol Biol  Organ) J</source><year>1999</year><volume>18</volume><fpage>131</fpage><lpage>144</lpage><pub-id pub-id-type="pmid">9878057</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Frings</surname><given-names>S</given-names></name><name><surname>Seifert</surname><given-names>R</given-names></name><name><surname>Godde</surname><given-names>M</given-names></name><name><surname>Kaupp</surname><given-names>UB</given-names></name></person-group><article-title>Profoundly different calcium permeation and blockage determine the specific function of distinct cyclic nucleotide&#x02013;gated channels</article-title><source>Neuron</source><year>1995</year><volume>15</volume><fpage>