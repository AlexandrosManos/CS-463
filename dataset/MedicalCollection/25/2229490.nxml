al"><person-group person-group-type="author"><name><surname>Jurevicius</surname><given-names>J.</given-names></name><name><surname>Fischmeister</surname><given-names>R.</given-names></name></person-group><article-title>cAMP compartmentation is responsible for local activation of cardiac Ca<sup>2+</sup> channels by &#x003b2;-adrenergic agonists</article-title><source>Proc. Natl. Acad. Sci. USA</source><volume>93</volume><year>1996</year><fpage>295</fpage><lpage>299</lpage><pub-id pub-id-type="pmid">8552625</pub-id></citation></ref><ref id="Kaupp1995"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaupp</surname><given-names>U.B.</given-names></name></person-group><article-title>Family of cyclic nucleotide gated ion channels</article-title><source>Curr. Opin. Neurobiol.</source><volume>5</volume><year>1995</year><fpage>434</fpage><lpage>442</lpage><pub-id pub-id-type="pmid">7488843</pub-id></citation></ref><ref id="Koutalosetal1995"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koutalos</surname><given-names>Y.</given-names></name><name><surname>Nakatani</surname><given-names>K.</given-names></name><name><surname>Yau</surname><given-names>K.W.</given-names></name></person-group><article-title>Cyclic GMP diffusion coefficient in rod photoreceptor outer segments</article-title><source>Biophys. J.</source><volume>68</volume><year>1995</year><fpage>373</fpage><lpage>382</lpage><pub-id pub-id-type="pmid">7536055</pub-id></citation></ref><ref id="Kawasakietal1998"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kawasaki</surname><given-names>H.</given-names></name><name><surname>Springett</surname><given-names>G.M.</given-names></name><name><surname>Mochizuki</surname><given-names>N.</given-names></name><name><surname>Toki</surname><given-names>S.</given-names></name><name><surname>Nakaya</surname><given-names>M.</given-names></name><name><surname