ft">63 &#x000b1; 1 (3)</td><td align="left">58 &#x000b1; 3 (3)</td><td align="left">10 &#x000b1; 1 (3)</td></tr><tr valign="bottom"><td align="left"/><td align="center">&#x003b3;<sub>X</sub>/&#x003b3;<sub>K</sub><sup>+</sup></td><td align="char" char=".">1</td><td align="char" char=".">0.9</td><td align="char" char=".">0.2</td></tr><tr valign="bottom"><td align="left">V121N</td><td align="center">&#x003b3;<sub>X</sub></td><td align="left">12 &#x000b1; 1 (3)</td><td align="left">71 &#x000b1; 2 (3)</td><td align="left">20 &#x000b1; 1 (3)</td></tr><tr valign="bottom"><td align="center"/><td align="center">&#x003b3;<sub>X</sub>/&#x003b3;<sub>K</sub><sup>+</sup></td><td align="char" char=".">1</td><td align="char" char=".">5.9</td><td align="char" char=".">1.7</td></tr></tbody></table><table-wrap-foot><fn><p>Data are means &#x000b1; SEM. Number of measurements are in parenthesis.</p></fn></table-wrap-foot></table-wrap><table-wrap position="float" id="T3"><label>Table 3</label><caption><p>Comparison of Selectivities between K<sup>+</sup> Channels</p></caption><table frame="hsides" rules="groups"><thead><tr valign="bottom" align="center"><th/><th/><th colspan="3" rowspan="1">PX/PK</th><th colspan="3" rowspan="1">GX/GK</th><th/><th/></tr><tr valign="bottom" align="center"><th/><th/><th>NH<sub>4</sub><sup>+</sup></th><th>Rb<sup>+</sup></th><th>T1<sup>+</sup></th><th>NH<sub>4</sub><sup>+</sup></th><th>Rb<sup>+</sup></th><th>T1<sup>+</sup></th><th>Measurement</th><th/></tr></thead><tbody><tr valign="bottom"><td align="left" colspan="2" rowspan="1">Weak inward rectifier</td><td align="center"/><td align="center"/><td align="center"/><td align="center"/><td align="center"/><td align="center"/><td align="center"/><td align="center"/></tr><tr valign="bottom"><td align="left"/><td align="left">ROMK2</td><td align="char" char=".">0.09</td><td align="char" char=".">0.42</td><td align="char" char=".">2.58</td><td align="char" char=".">1.62</td><td align="char" char=".">0.38</td><td al