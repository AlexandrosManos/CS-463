up person-group-type="author"><name><surname>Gilles</surname><given-names>HM</given-names></name><name><surname>Warrel</surname><given-names>DA</given-names></name></person-group><source>Bruce-Chwatt's Essential Malariology</source><year>1993</year><publisher-name>London , Arnold Publishing</publisher-name></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Githeko</surname><given-names>AK</given-names></name><name><surname>Lindsay</surname><given-names>SW</given-names></name><name><surname>Confalonieri</surname><given-names>UE</given-names></name><name><surname>Patz</surname><given-names>JA</given-names></name></person-group><article-title>Climate change and vector-borne diseases: a regional analysis</article-title><source>Bulletin of the World Health Organization</source><year>2000</year><volume>78</volume><fpage>1136</fpage><lpage>1147</lpage><pub-id pub-id-type="pmid">11019462</pub-id></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Molineaux</surname><given-names>L</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Wernsdorfer WH, McGregor I</surname></name></person-group><article-title>The epidemiology of human malaria as an explanation of its distribution, including some implications for its control</article-title><source>Malaria: principles and practice of malariology</source><year>1988</year><publisher-name>Edinburgh , Churchill Livingstone</publisher-name><fpage>913</fpage><lpage>998</lpage></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lindblade</surname><given-names>KA</given-names></name><name><surname>Walker</surname><given-names>ED</given-names></name><name><surname>Onapa</surname><given-names>AW</given-names></name><name><surname>Katungu</surname><given-names>J</given-names></name><name><surname>Wilson<