<ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Luomala</surname><given-names>M</given-names></name><name><surname>Elovaara</surname><given-names>I</given-names></name><name><surname>Ukkonen</surname><given-names>M</given-names></name><name><surname>Koivula</surname><given-names>T</given-names></name><name><surname>Lehtimaki</surname><given-names>T</given-names></name></person-group><article-title>Plasminogen activator inhibitor 1 gene and risk of MS in women</article-title><source>Neurology</source><year>2000</year><volume>54</volume><fpage>1862</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">10802801</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mattila</surname><given-names>KM</given-names></name><name><surname>Luomala</surname><given-names>M</given-names></name><name><surname>Lehtimaki</surname><given-names>T</given-names></name><name><surname>Laippala</surname><given-names>P</given-names></name><name><surname>Koivula</surname><given-names>T</given-names></name><name><surname>Elovaara</surname><given-names>I</given-names></name></person-group><article-title>Interaction between ESR1 and HLA-DR2 may contribute to the development of MS in women</article-title><source>Neurology</source><year>2001</year><volume>56</volume><fpage>1246</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">11342704</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tourtellotte</surname><given-names>WW</given-names></name><name><surname>Baumhefner</surname><given-names>RW</given-names></name><name><surname>Syndulko</surname><given-names>K</given-names></name><name><surname>Shapshak</surname><given-names>P</given-names></name><name><surname>Osborne</surname><given-names>M</given-names></name><name><surname>Rubinshtein</surname><given-names>G</given-names></name><name><surname>N