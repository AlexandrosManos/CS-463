="bib18"><citation citation-type="journal">Cooper, E.C., E. Harrington, Y.N. Jan, and L.Y. Jan. <year>2001</year>. M channel KCNQ2 subunits are localized to key sites for control of neuronal network oscillations and synchronization in mouse brain. <source>J. Neurosci.</source> <volume>21</volume>:<fpage>9529</fpage>&#x02013;9540.<pub-id pub-id-type="pmid">11739564</pub-id></citation></ref><ref id="bib19"><citation citation-type="journal">Coulter, K.L., F. Perier, C.M. Radeke, and C.A. Vandenberg. <year>1995</year>. Identification and molecular localization of a pH-sensing domain for the inward rectifier potassium channel HIR. <source>Neuron.</source> <volume>15</volume>:<fpage>1157</fpage>&#x02013;1168.<pub-id pub-id-type="pmid">7576658</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal">Dahlquist, F.W. <year>1978</year>. The meaning of Scatchard and Hill plots. <source>Methods Enzymol.</source> <volume>48</volume>:<fpage>270</fpage>&#x02013;299.<pub-id pub-id-type="pmid">345049</pub-id></citation></ref><ref id="bib21"><citation citation-type="journal">de Curtis, M., A. Manfridi, and G. Biella. <year>1998</year>. Activity-dependent pH shifts and periodic recurrence of spontaneous interictal spikes in a model of focal epileptogenesis. <source>J. Neurosci.</source> <volume>18</volume>:<fpage>7543</fpage>&#x02013;7551.<pub-id pub-id-type="pmid">9736672</pub-id></citation></ref><ref id="bib22"><citation citation-type="journal">DeVries, S.H. <year>2001</year>. Exocytosed protons feedback to suppress the Ca<sup>2+</sup> current in mammalian cone photoreceptors. <source>Neuron.</source> <volume>32</volume>:<fpage>1107</fpage>&#x02013;1117.<pub-id pub-id-type="pmid">11754841</pub-id></citation></ref><ref id="bib23"><citation citation-type="journal">Doyle, D.A., J. Morais Cabral, R.A. Pfuetzner, A. Kuo, J.M. Gulbis, S.L. Cohen, B.T. Chait, and R. MacKinnon. <year>1998</year>. The structure of the potassium channel: molecular basis of K<sup>+</sup> conduction and selectivity. <source>Science.</source> <volume>280</volume>:<fpage>69</fpage>&#x02013;77.<pub-id pub-id-type="pmid">9525859</pub-id></citation></ref><ref id="bib24"><citation citation-type="journal">Giffard, R.G., J.H. Weiss, and D.W. Choi. <year>1992</year>. Extracellular alkalinity exacerbates injury of cultured cortical neurons. <source>Stroke.</source> <volume>23</volume>:<fpage>1817</fpage>&#x02013;1821.<pub-id pub-id-type="pmid">1360176</pub-id></citation></ref><ref id="bib25"><citation citation-type="journal">Hadley, J.K., G.M. Passmore, L. Tatulian, M. Al-Qatari, F. Ye, A.D. Wickenden, and D.A. Brown. <year>2003</year>. Stoichiometry of expressed KCNQ2/KCNQ3 channels and subunit composition of native ganglionic M-currents deduced from block by tetraethylammonium (TEA). <source>J. Neurosci.</source> <volume>23</volume>:<fpage>5012</fpage>&#x02013;5019.<pub-id pub-id-type="pmid">12832524</pub-id></citation></ref><ref id="bib26"><citation citation-type="journal">Horn, R., and K. Lange. <year>1983</year>. Estimating kinetic constants from single channel data. <source>Biophys. J.</source> <volume>43</volume>:<fpage>207</fpage>&#x02013;223.<pub-id pub-id-type="pmid">6311301</pub-id></citation></ref><ref id="bib27"><citation citation-type="journal">Hu, H., K. Vervaeke, and J.F. Storm. <year>2002</year>. Two forms of electrical resonance at theta frequencies, generated by M-current, h-current and persistent Na<sup>+</sup> current in rat hippocampal pyramidal cells. <source>J. Physiol.</source> <volume>545</volume>:<fpage>783</fpage>&#x02013;805.<pub-id pub-id-type="pmid">12482886</pub-id></citation></ref><ref id="bib28"><citation citation-type="journal">Jentsch, T.J. <year>2000</year>. Neuronal KCNQ potassium channels: physiology and role in disease. <source>Nat. Rev. Neurosci.</source> <volume>1</volume>:<fpage>21</fpage>&#x02013;30.<pub-id pub-id-type="pmid">11252765</pub-id></citation></ref><ref id="bib29"><citation citation-type="journal">Kehl, S., C. Eduljee, D.C.H. Kwan, S. Zhang, and D. Fedida. <year>2002</year>. Molecular determinants of the inhibition of human Kv1.5 potassium currents by external protons and Zn<sup>2+</sup><sub>.</sub> <source>J. Physiol.</source> <volume>541</volume>:<fpage>9</fpage>&#x02013;24.<pub-id pub-id-type="pmid">12015417</pub-id></citation></ref><ref id="bib30"><citation citation-type="journal">Koshland, D.E., Jr. <year>1996</year>. The structural basis of negative cooperativity: receptors and enzymes. <source>Curr. Opin. Struct. Biol.</source> <volume>6</volume>:<fpage>757</fpage>&#x02013;761.<pub-id pub-id-type="pmid">8994875</pub-id></citation></ref><ref id="bib31"><citation citation-type="journal">Krishtal, O.A., Y.V. Osipchuk, T.N. Shelest, and S.V. Smirnoff. <year>1987</year>. Rapid extracellular pH transients related to synaptic transmission in rat hippocampal slices. <source>Brain Res.</source> <volume>436</volume>:<fpage>352</fpage>&#x02013;356.<pub-id pub-id-type="pmid">2829992</pub-id></citation></ref><ref id="bib32"><citation citation-type="journal">Liu, Y., M.E. Jurman, and G. Yellen. <year>1996</year>. Dynamic rearrangement of the outer mouth of a K<sup>+</sup> channel during gating. <source>Neuron.</source> <volume>16</volume>:<fpage>859</fpage>&#x02013;867.<pub-id pub-id-type="pmid">8608004</pub-id></citation></ref><ref id="bib33"><citation citation-type="journal">Loots, E., and E.Y. Isacoff. <year>1998</year>. Protein rearrangements underlying slow inactivation of the <italic>Shaker</italic> K<sup>+</sup> channel. <source>J. Gen. Physiol.</source> <volume>112</volume>:<fpage>377</fpage>&#x02013;389.<pub-id pub-id-type="pmid">9758858</pub-id></citation></ref><ref id="bib34"><citation citation-type="journal">Lu, T., A.Y. Ting, J. Mainland, L.Y. Jan, P.G. Schultz, and J. Yang. <year>2001</year>. Probing ion permeation and gating in a K<sup>+</sup> channel with backbone mutations in the selectivity filter. <source>Nat. Neurosci.</source> <volume>4</volume>:<fpage>239<