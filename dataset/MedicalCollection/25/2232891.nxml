itation citation-type="journal"><person-group person-group-type="author"><name><surname>He</surname><given-names>Z.</given-names></name><name><surname>Tong</surname><given-names>Q.</given-names></name><name><surname>Quednau</surname><given-names>B.D.</given-names></name><name><surname>Philipson</surname><given-names>K.D.</given-names></name><name><surname>Hilgemann</surname><given-names>D.W.</given-names></name></person-group><article-title>Cloning, expression, and characterization of the squid Na<sup>+</sup>&#x02013;Ca<sup>2+</sup> exchanger (NCX-SQ1)</article-title><source>J. Gen. Physiol.</source><volume>111</volume><year>1998</year><fpage>857</fpage><lpage>873</lpage><pub-id pub-id-type="pmid">9607941</pub-id></citation></ref><ref id="HryshkoandPhilipson1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hryshko</surname><given-names>L.V.</given-names></name><name><surname>Philipson</surname><given-names>K.D.</given-names></name></person-group><article-title>Sodium-calcium exchangerecent advances</article-title><source>Basic Res. Cardiol.</source><volume>92</volume><year>1997</year><fpage>45</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">9202843</pub-id></citation></ref><ref id="Juhaszovaetal1996"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Juhaszova</surname><given-names>M.</given-names></name><name><surname>Shimizu</surname><given-names>H.</given-names></name><name><surname>Borin</surname><given-names>M.</given-names></name><name><surname>Yip</surname><given-names>R.K.</given-names></name><name><surname>Santiago</surname><given-names>E.M.</given-names></name><name><surname>Lindenmayer</surname><given-names>G.E.</given-names></name><name><surname>Blaustein</surname><given-names>M.P.</given-names></name></person-group><article-title>Localization of the Na<sup>+</sup>&#x02013;Ca<sup>2+</sup> exchanger in vascular smooth muscle, and in neurons and astrocytes</article-titl