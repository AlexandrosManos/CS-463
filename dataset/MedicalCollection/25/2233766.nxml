n="1">HPV16</th><th align="center" rowspan="1" colspan="1">HPV 18</th><th align="center" rowspan="1" colspan="1">HPV 16 and 18</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">Simple hyperplasia</td><td align="center" rowspan="1" colspan="1">2/8 (25%)</td><td align="center" rowspan="1" colspan="1">1/8(12.5%)</td><td align="center" rowspan="1" colspan="1">&#x02014;</td></tr><tr><td align="left" rowspan="1" colspan="1">Complex hyperplasia</td><td align="center" rowspan="1" colspan="1">1/8 (12.5%)</td><td align="center" rowspan="1" colspan="1">0/8</td><td align="center" rowspan="1" colspan="1">&#x02014;</td></tr><tr><td align="left" rowspan="1" colspan="1">Atypical hyperplasia</td><td align="center" rowspan="1" colspan="1">1/8 (12.5%)</td><td align="center" rowspan="1" colspan="1">0/8</td><td align="center" rowspan="1" colspan="1">&#x02014;</td></tr><tr><td align="left" rowspan="1" colspan="1">Adenocarcinoma</td><td align="center" rowspan="1" colspan="1">3/25(12%)</td><td align="center" rowspan="1" colspan="1">2/25 (8%)</td><td align="center" rowspan="1" colspan="1">3/25 (12%)</td></tr><tr><td rowspan="1" colspan="1"><italic>Totaladenocarcinomas</italic></td><td align="center" rowspan="1" colspan="1"><italic>6/25 (24%)</italic></td><td align="center" rowspan="1" colspan="1"><italic>5/25(20%)</italic></td><td align="center" rowspan="1" colspan="1">&#x02014;</td></tr></tbody></table></table-wrap></floats-wrap></article>