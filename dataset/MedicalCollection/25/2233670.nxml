e><given-names>Y</given-names></name><name><surname>Maguire</surname><given-names>T</given-names></name><name><surname>Hileman</surname><given-names>RE</given-names></name><name><surname>Fromm</surname><given-names>JR</given-names></name><name><surname>Esko</surname><given-names>JD</given-names></name><etal/></person-group>					<year>1997</year>					<article-title>Dengue virus infectivity depends on envelope protein binding to target cell heparan sulfate</article-title>					<source>Nat Med</source>					<volume>3</volume>					<fpage>866</fpage>					<lpage>871</lpage>				<pub-id pub-id-type="pmid">9256277</pub-id></element-citation></ref><ref id="ppat-0040017-b006"><element-citation publication-type="journal">					<person-group person-group-type="author"><name><surname>Porterfield</surname><given-names>JS</given-names></name></person-group>					<year>1986</year>					<article-title>Antibody-dependent enhancement of viral infectivity</article-title>					<source>Adv Virus Res</source>					<volume>31</volume>					<fpage>335</fpage>					<lpage>355</lpage>				<pub-id pub-id-type="pmid">2428214</pub-id></element-citation></ref><ref id="ppat-0040017-b007"><element-citation publication-type="journal">					<person-group person-group-type="author"><name><surname>Martinez-Pomares</surname><given-names>L</given-names></name><name><surname>Wienke</surname><given-names>D</given-names></name><name><surname>Stillion</surname><given-names>R</given-names></name><name><surname>McKenzie</surname><given-names>EJ</given-names></name><name><surname>Arnold</surname><given-names>JN</given-names></name><etal/></person-group>					<year>2006</year>					<article-title>Carbohydrate-independent recognition of collagens by the macrophage mannose receptor</article-title>					<source>Eur J Immunol</source>					<volume>36</volume>					<fpage>1074</fpage>					<lpage>1082</lpage>				<pub-id pub-id-type="pmid">16619293</pub-id></element-citation></ref><ref id="ppat-0040017-b008"><element-citation publication-type="journal">					<person-group person-group-type="author"><name><surname>Taylor</surname><given-names>PR</given-names></name><name><surname>Gordon</surname><given-names>S</given-names></name><name><surname>Martinez-Pomares</surname><given-names>L</given-names></name></person-group>					<year>2005</year>					<article-title>The mannose receptor: linking homeostasis and immunity through sugar recognition</article-title>					<source>Trends Immunol</source>					<volume>26</volume>					<fpage>104</fpage>					<lpage>110</lpage>				<pub-id pub-id-type="pmid">15668126</pub-id></element-citation></ref><ref id="ppat-0040017-b009"><element-citation publication-type="journal">					<person-group person-group-type="author"><name><surname>Lozach</surname><given-names>PY</given-names></name><name><surname>Burleigh</surname><given-names>L</given-names></name><name><surname>Staropoli</surname><given-names>I</given-names></name><name><surname>Navarro-Sanchez</surname><given-names>E</given-names></name><name><surname>Harriague</surname><given-names>J</given-names></name><etal/></person-group>					<year>2005</year>					<article-title>Dendritic cell-specific intercellular adhesion molecule 3-grabbing non-integrin (DC-SIGN)-mediated enhancement of dengue virus infection is independent of DC-SIGN internalization signals</article-title>					<source>J Biol Chem</source>					<volume>280</volume>					<fpage>23698</fpage>					<lpage>23708</lpage>				<pub-id pub-id-type="pmid">15855154</pub-id></element-citation></ref><ref id="ppat-0040017-b010"><element-citation publication-type="journal">					<person-group person-group-type="author"><name><surname>Miguez-Burbano</surname><given-names>MJ</given-names></name><name><surname>Jaramillo</surname><given-names>CA</given-names></name><name><surname>Palmer</surname><given-names>CJ</given-names></name><name><surname>Shor-Posner</surname><given-names>G</given-names></name><name><surname>Velasquez</surname><given-names>LS</given-names></name><etal/></person-group>					<year>1999</year>					<article-title>Total immunoglobulin E levels and dengue infection on San Andres Island, Colombia</article-title>					<source>Clin Diagn Lab Immunol</source>					<volume>6</volume>					<fpage>624</fpage>					<lpage>626</lpage>				<pub-id pub-id-type="pmid">10391876</pub-id></element-citation></ref><ref id="ppat-0040017-b011"><element-citation publication-type="journal">					<person-group person-group-type="author"><name><surname>Mabalirajan</surname><given-names>U</given-names></name><name><surname>Kadhiravan</surname><given-names>T</given-names></name><name><surname>Sharma</surname><given-names>SK</given-names></name><name><surname>Banga</surname><given-names>A</given-names></name><name><surname>Ghosh</surname><given-names>B</given-names></name></person-group>					<year>2005</year>					<article-title>Th(2) immune response in patients with dengue during defervescence: preliminary evidence</article-title>					<source>Am J Trop Med Hyg</source>					<volume>72</volume>					<fpage>783</fpage>					<lpage>785</lpage>				<pub-id pub-id-type="pmid">15964963</pub-id></element-citation></ref><ref id="ppat-0040017-b012"><element-citation publication-type="journal">					<person-group person-group-type="author"><name><surname>Simmons</surname><given-names>CP</given-names></name><name><surname>Popper</surname><given-names>S</given-names></name><name><surname>Dolocek</surname><given-names>C</given-names></name><name><surname>Chau</surname><given-names>TN</given-names></name><name><surname>Griffiths</surname><given-names>M</given-names></name><etal/></person-group>					<year>2007</year>					<article-title>Patterns of host genome-wide gene transcript abundance in the peripheral blood of patients with acute dengue hemorrhagic Fever</article-title>					<source>J Infect Dis</source>					<volume>195</volume>					<fpage>1097</fpage>					<lpage>1107</lpage>				<pub-id pub-id-type="pmid">17357045</pub-id></element-citation></ref><ref id="ppat-0040017-