</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Leigh</surname><given-names>AD</given-names></name></person-group><article-title>Infections of the nervous system occurring during an epidemic of influenza B</article-title><source> Br Med J</source><year>1946</year><volume>2</volume><fpage>936</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">20277507</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sulkava</surname><given-names>R</given-names></name><name><surname>Rissanen</surname><given-names>A</given-names></name><name><surname>Pyh&#x000e4;l&#x000e4;</surname><given-names>R</given-names></name></person-group><article-title>Post-influenza encephalitis during the influenza A outbreak in 1979/1980</article-title><source> J Neurol Neurosurg Psychiatr</source><year>1981</year><volume>44</volume><fpage>161</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">7217974</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Samuel</surname><given-names>N</given-names></name><name><surname>Attias</surname><given-names>OTatourS</given-names></name><etal/></person-group><article-title>Novel influenza A (H1N1) and acute encephalitis in a child</article-title><source> Isr Med Assoc J</source><year>2010</year><volume>12</volume><fpage>446</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">20862831</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Apok</surname><given-names>V</given-names></name><name><surname>Alamri</surname><given-names>A</given-names></name><name><surname>Qureshi</surname><given-names>A</given-names></name><name><surname>Donaldson-Hugh</surname><given-names>B</given-names></name></person-group><article-title>POI02 Fulminant cerebellitis related to H1N1: a first case report</article-title><source> J Neurol Neurosurg Psychiatr</source><year>2010</year><volume>81</volume><fpage>e53</fpage></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dashti-Khavidaki</surname><given-names>S</given-names></name><name><surname>Khalili</surname><given-names>H</given-names></name><name><surname>Ghalmalipour</surname><given-names>F</given-names></name><etal/></person-group><article-title>Approach to pandemic 2009 influenza: first report from a main referral hospital for pandemic H1N1 influenza care in</article-title><source> J Infect Dev Ctries</source><year>2010</year><volume>4</volume><fpage>629</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">21045355</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sriram</surname><given-names>P</given-names></name><name><surname>Kumar</surname><given-names>M</given-names></name><name><surname>Renitha</surname><given-names>R</given-names></name><etal/></person-group><article-title>Clinical profile of swine flu in children at puducherry</article-title><source> Indian J Pediatr</source><year>2010</year><volume>77</volume><fpage>1093</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">20886318</pub-id></element-citation></ref></ref-list></back></article>