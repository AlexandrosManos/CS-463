><year>1993</year><fpage>3870</fpage><lpage>3874</lpage><pub-id pub-id-type="pmid">8483905</pub-id></citation></ref><ref id="MiuraandKimura1989"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Miura</surname><given-names>Y.</given-names></name><name><surname>Kimura</surname><given-names>J.</given-names></name></person-group><article-title>Sodium&#x02013;calcium exchange current. Dependence on internal Ca and Na and competitive binding of external Na and Ca</article-title><source>J. Gen. Physiol.</source><volume>93</volume><year>1989</year><fpage>1129</fpage><lpage>1145</lpage><pub-id pub-id-type="pmid">2549177</pub-id></citation></ref><ref id="Nicolletal1990"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nicoll</surname><given-names>D.A.</given-names></name><name><surname>Longoni</surname><given-names>S.</given-names></name><name><surname>Philipson</surname><given-names>K.D.</given-names></name></person-group><article-title>Molecular cloning and functional expression of the cardiac sarcolemmal Na<sup>+</sup>&#x02013;Ca<sup>2+</sup> exchanger</article-title><source>Science.</source><volume>250</volume><year>1990</year><fpage>562</fpage><lpage>565</lpage><pub-id pub-id-type="pmid">1700476</pub-id></citation></ref><ref id="Nodaetal1988"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Noda</surname><given-names>M.</given-names></name><name><surname>Shepherd</surname><given-names>R.N.</given-names></name><name><surname>Gadsby</surname><given-names>D.C.</given-names></name></person-group><article-title>Activation by [Ca]<sub>i</sub> and block by 3&#x02032;4&#x02032;-dichlorobenzamil of outward Na/Ca exchange current in guinea-pig ventricular myocytes</article-title><source>Biophys. J.</source><volume>53</volume><year>1988</year><fpage>342a</fpage>(Abstr.)</citation></ref><ref id="Omelchenkoetal1998"><citation citation-type="journal"><person-group