f><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Orme</surname><given-names>B</given-names></name></person-group><source>Getting started with Conjoint Analysis: Strategies for Product Design and Pricing Research</source><year>2006</year><publisher-name>Madison Wis: Research Publishers LLC</publisher-name></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haughney</surname><given-names>J</given-names></name><name><surname>Barnes</surname><given-names>G</given-names></name><name><surname>Partridge</surname><given-names>MR</given-names></name><name><surname>Cleland</surname><given-names>J</given-names></name></person-group><article-title>The Living &#x00026; Breathing Study: a study of patients' views of asthma and its treatment</article-title><source>Primary Care Respiratory Journal</source><year>2004</year><volume>13</volume><fpage>28</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">16701634</pub-id><pub-id pub-id-type="doi">10.1016/j.pcrj.2003.11.007</pub-id></citation></ref><ref id="B17"><citation citation-type="other"><person-group person-group-type="author"><collab>Sawtooth Software</collab></person-group><article-title>An Overview and Comparison of Design Strategies for Choice-Based Conjoint Analysis 2000</article-title><ext-link ext-link-type="uri" xlink:href="http://www.sawtoothsoftware.com/download/techpap/desgncbc.pdf"/><comment>(Date last accessed September 2006)</comment></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hawkins</surname><given-names>G</given-names></name><name><surname>McMahon</surname><given-names>AD</given-names></name><name><surname>Twaddle</surname><given-names>S</given-names></name><name><surname>Wood</surname><given-names>SF</given-names></name><name><surname>Ford</surname><given-names>I</given-names></name><name><surname>Thomson</surname><given-names>NC</given-names></name></person-group><article-title>Stepping down inhaled corticosteroids in asthma: randomised controlled trial</article-title><source>BMJ</source><year>2003</year><volume>326</volume><fpage>1115</fpage><pub-id pub-id-type="pmid">12763981</pub-id><pub-id pub-id-type="doi">10.1136/bmj.326.7399.1115</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><article-title>Greater Expectations? Findings from the National Asthma Campaign's representative study of the Needs Of People With Asthma (NOPWA) in the UK</article-title><source>Asthma J</source><year>2003</year><volume>5</volume></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gallefoss</surname><given-names>F</given-names></name><name><surname>Bakke</surname><given-names>PS</given-names></name></person-group><article-title>How does patient education and self-management among asthmatics and patients with chronic obstructive pulmonary disease affect medication?</article-title><source>Am J Respir Crit Care Med</source><year>1999</year><volume>160</volume><fpage>2000</fpage><lpage>2005</lpage><pub-id pub-id-type="pmid">10588620</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gallefoss</surname><given-names>F</given-names></name><name><surname>Bakke</surname><given-names>PS</given-names></name></person-group><article-title>Cost-effectiveness of self management in asthmatics: a one year follow up randomized, controlled trial</article-title><source>Eur Respir J</source><year>2001</year><volume>17</volume><fpage>206</fpage><lpage>213</lpage><pub-id pub-id-type="pmid">11334121</pub-id><pub-id pub-id-type="doi">10.1183/09031936.01.17202060</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haughney</surname><given-names>J</given-names></name><name><surname>Partridge</surname><given-names>MR</given-names></name><name><surname>Vogelmeier</surname><given-names>C</given-names></name><name><surname>Larsson</surname><given-names>T</given-names></name><name><surname>Kessler</surname><given-names>R</given-names></name><name><surname>Stahl</surname><given-names>E</given-names></name><name><surname>Brice</surname><given-names>R</given-names></name><name><surname>Lofdahl</surname><given-names>CG</given-names></name></person-group><article-title>Exacerbations of COPD: quantifying the patient's perspective using discrete choice modelling</article-title><source>Eur Respir J</source><year>2005</year><volume>26</volume><fpage>623</fpage><lpage>629</lpage><pub-id pub-id-type="pmid">16204592</pub-id><pub-id pub-id-type="doi">10.1183/09031936.05.00142704</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Caress</surname><given-names>AL</given-names></name><name><surname>Beaver</surname><given-names>K</given-names></name><name><surname>Luker</surname><given-names>K</given-names></name><name><surname>Campbell</surname><given-names>M</given-names></name><name><surname>Woodcock</surname><given-names>A</given-names></name></person-group><article-title>Involvement in treatment decisions: what do adults with asthma want and what do they get? Results of a cross-sectional survey</article-title><source>Thorax</source><year>2005</year><volume>60</volume><fpage>199</fpage><lpage>205</lpage><pub-id pub-id-type="pmid">15741435</pub-id><pub-id pub-id-type="doi">10.1136/thx.2004.029041</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ryan</surname><given-names>M</given-names></name><name><surname>Gerard</surname><given-names>K</given-names></name></person-group><article-title>Using discrete choice experiments to value health care programmes: current practice and future research reflections</article-title><source>Appl Health Econ Health Policy</source><year>2003</year><volume>2</volume><fpage>55</fpage><lpage>64</lpage><pub-id pub-id-type="pmid">14619274</pub-id></citation></ref></ref-list></back></article>