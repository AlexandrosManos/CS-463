ents</article-title><source><italic>Journal of Neural Engineering</italic></source><year>2006</year><volume>3</volume><issue>4</issue><fpage>338</fpage><lpage>346</lpage><pub-id pub-id-type="pmid">17124338</pub-id></citation></ref><ref id="B11"><label>28</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Erfanian</surname><given-names>A</given-names></name><name><surname>Mahmoudi</surname><given-names>B</given-names></name></person-group><article-title>Real-time ocular artifact suppression using recurrent neural network for electro-encephalogram based brain-computer interface</article-title><source><italic>Medical and Biological Engineering and Computing</italic></source><year>2005</year><volume>43</volume><issue>2</issue><fpage>296</fpage><lpage>305</lpage><pub-id pub-id-type="pmid">15865142</pub-id></citation></ref><ref id="B31"><label>29</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Puthusserypady</surname><given-names>S</given-names></name><name><surname>Ratnarajah</surname><given-names>T</given-names></name></person-group><article-title>Robust adaptive techniques for minimization of EOG artefacts from EEG signals</article-title><source><italic>Signal Processing</italic></source><year>2006</year><volume>86</volume><issue>9</issue><fpage>2351</fpage><lpage>2363</lpage></citation></ref><ref id="B1"><label>30</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Agarwal</surname><given-names>R</given-names></name><name><surname>Takeuchi</surname><given-names>T</given-names></name><name><surname>Laroche</surname><given-names>S</given-names></name><name><surname>Gotman</surname><given-names>J</given-names></name></person-group><article-title>Detection of rapid-eye movements in sleep studies</article-title><source><italic>IEEE Transactions on Biomedical Engineering</italic></source><year>2005</year><volume>52</volume><issue>8</iss