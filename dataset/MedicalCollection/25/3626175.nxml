d="B8"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Riemann</surname><given-names>JF</given-names></name><name><surname>Hartmann</surname><given-names>D</given-names></name><name><surname>Schilling</surname><given-names>D</given-names></name><name><surname>Damian</surname><given-names>U</given-names></name><name><surname>Eickhoff</surname><given-names>A</given-names></name><name><surname>Weickert</surname><given-names>U</given-names></name></person-group><article-title>Frequency of small bowel polyps in patients with duodenal adenoma but without familial adenomatous polyposis</article-title><source><italic>Zeitschrift fur Gastroenterologie</italic></source><year>2006</year><volume>44</volume><issue>3</issue><fpage>235</fpage><lpage>238</lpage><pub-id pub-id-type="other">2-s2.0-33645362464</pub-id><pub-id pub-id-type="pmid">16514568</pub-id></element-citation></ref><ref id="B9"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dariusz</surname><given-names>A</given-names></name><name><surname>Jochen</surname><given-names>R</given-names></name></person-group><article-title>Increased prevalance of colorectal adenoma in patients with sporadic duodenal adenoma</article-title><source><italic>European Journal of Gastroenterology and Hepatology</italic></source><year>2009</year><volume>21</volume><issue>7</issue><fpage>816</fpage><lpage>818</lpage><pub-id pub-id-type="other">2-s2.0-67651015737</pub-id><pub-id pub-id-type="pmid">19369885</pub-id></element-citation></ref><ref id="B10"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lagarde</surname><given-names>S</given-names></name><name><surname>Dauphin</surname><given-names>M</given-names></name><name><surname>Delmas</surname><given-names>C</given-names></name><etal/></person-group><article-title>Increased risk of colonic neoplasia in patients with sporadic duodenal adenoma</article-title><source><italic>Gastroenterologie Clinique et Biologique</italic></source><year>2009</year><volume>33</volume><issue>5</issue><fpage>441</fpage><lpage>445</lpage><pub-id pub-id-type="other">2-s2.0-67349159400</pub-id><pub-id pub-id-type="pmid">19278801</pub-id></element-citation></ref><ref id="B11"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Apel</surname><given-names>D</given-names></name><name><surname>Jakobs</surname><given-names>R</given-names></name><name><surname>Weickert</surname><given-names>U</given-names></name><name><surname>Ferdinand Riemann</surname><given-names>J</given-names></name></person-group><article-title>High frequency of colorectal adenoma in patients with duodenal adenoma but without familial adenomatous polyposis</article-title><source><italic>Gastrointestinal Endoscopy</italic></source><year>2004</year><volume>60</volume><issue>3</issue><fpage>397</fpage><lpage>399</lpage><pub-id pub-id-type="other">2-s2.0-4444321854</pub-id><pub-id pub-id-type="pmid">15332030</pub-id></element-citation></ref><ref id="B12"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Murray</surname><given-names>MA</given-names></name><name><surname>Zimmerman</surname><given-names>MJ</given-names></name><name><surname>Ee</surname><given-names>HC</given-names></name></person-group><article-title>Sporadic duodenal adenoma is associated with colorectal neoplasia</article-title><source><italic>Gut</italic></source><year>2004</year><volume>53</volume><issue>2</issue><fpage>261</fpage><lpage>265</lpage><pub-id pub-id-type="other">2-s2.0-1642451911</pub-id><pub-id pub-id-type="pmid">14724161</pub-id></element-citation></ref><ref id="B13"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lienert</surname><given-names>A</given-names></name><name><surname>Bagshaw</surname><given-names>PF</given-names></name></person-group><article-title>Treatment of duodenal adenomas with endoscopic argon plasma coagulation</article-title><source><italic>ANZ Journal of Surgery</italic></source><year>2007</year><volume>77</volume><issue>5</issue><fpage>371</fpage><lpage>373</lpage><pub-id pub-id-type="other">2-s2.0-34248184586</pub-id><pub-id pub-id-type="pmid">17497979</pub-id></element-citation></ref></ref-list></back><floats-group><fig id="fig1" orientation="portrait" position="float"><label>Figure 1</label><caption><p> (a) Multiple (several dozen) irregular flat polyps in area of the descending duodenum, in locations other than the ampulla of Vater. (b) Multiple irregular flat polyps from 5&#x02009;mm to approximately 15&#x02009;mm in size, rather atypical in appearance with a central depression.</p></caption><graphic xlink:href="CRIM.GM2013-181704.001"/></fig><fig id="fig2" orientation="portrait" position="float"><label>Figure 2</label><caption><p> (a) Histological examination of lesions showed structures of the tubular or tubulovillous adenoma with mildly to moderately dysplastic epithelium and numerous Paneth cells. (b) Flat character of adenoma with central depression.</p></caption><graphic xlink:href="CRIM.GM2013-181704.002"/></fig></floats-group></article>