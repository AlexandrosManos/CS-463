on-group person-group-type="author"><name><surname>Bootman</surname><given-names>M.D.</given-names></name><name><surname>Berridge</surname><given-names>M.J.</given-names></name></person-group><article-title>The elemental principles of calcium signaling</article-title><source>Cell.</source><volume>83</volume><year>1995</year><fpage>675</fpage><lpage>678</lpage><pub-id pub-id-type="pmid">8521483</pub-id></citation></ref><ref id="Bushetal1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bush</surname><given-names>K.T.</given-names></name><name><surname>Stuart</surname><given-names>R.O.</given-names></name><name><surname>Li</surname><given-names>S.-H.</given-names></name><name><surname>Moura</surname><given-names>L.A.</given-names></name><name><surname>Sharp</surname><given-names>A.H.</given-names></name><name><surname>Ross</surname><given-names>C.A.</given-names></name><name><surname>Nigam</surname><given-names>S.K.</given-names></name></person-group><article-title>Epithelial inositol 1,4,5-trisphosphate receptors. Multiplicity of localization, solubility, and isoforms</article-title><source>J. Biol. Chem.</source><volume>269</volume><year>1994</year><fpage>23694</fpage><lpage>23699</lpage><pub-id pub-id-type="pmid">8089140</pub-id></citation></ref><ref id="Cardyetal1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cardy</surname><given-names>T.J.A.</given-names></name><name><surname>Traynor</surname><given-names>D.</given-names></name><name><surname>Taylor</surname><given-names>C.W.</given-names></name></person-group><article-title>Differential regulation of types-1 and -3 inositol trisphosphate receptors by cytosolic Ca<sup>2+</sup></article-title><source>Biochem. J.</source><volume>328</volume><year>1997</year><fpage>785</fpage><lpage>793</lpage><pub-id pub-id-type="pmid">9396721</pub-id></citation></ref><ref id="CarterandOgden1997"><citation citation-type="journal"><person-g