></ref><ref id="b17"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kaneko</surname><given-names>K</given-names></name><name><surname>Yoshimura</surname><given-names>K</given-names></name><name><surname>Ohashi</surname><given-names>A</given-names></name><name><surname>Kimata</surname><given-names>T</given-names></name><name><surname>Shimo</surname><given-names>T</given-names></name><name><surname>Tsuji</surname><given-names>S</given-names></name></person-group><article-title>Prediction of the risk of coronary arterial lesions in Kawasaki disease by brain natriuretic peptide</article-title><source>Pediatr Cardiol</source><year>2011</year><volume>32</volume><fpage>1106</fpage><lpage>1109</lpage><pub-id pub-id-type="pmid">21487793</pub-id></element-citation></ref><ref id="b18"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kentsis</surname><given-names>A</given-names></name></person-group><article-title>Challenges and opportunities for discovery of disease biomarkers using urine proteomics</article-title><source>Pediatr Int</source><year>2011</year><volume>53</volume><fpage>1</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">20840485</pub-id></element-citation></ref><ref id="b19"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kentsis</surname><given-names>A</given-names></name><name><surname>Lin</surname><given-names>YY</given-names></name><name><surname>Kurek</surname><given-names>K</given-names></name><name><surname>Colicchio</surname><given-names>M</given-names></name><name><surname>Wang</surname><given-names>YY</given-names></name><name><surname>Monigatti</surname><given-names>F</given-names></name><name><surname>Campagne</surname><given-names>F</given-names></name><name><surname>Lee</surname><given-names>RS</given-names></name><name><surname>Horwitz</surname><given-names>BH</given-names></name><name><surn