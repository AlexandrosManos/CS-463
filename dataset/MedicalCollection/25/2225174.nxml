gn="left" valign="top">&#x02003;No. of protein atoms</td><td rowspan="1" colspan="1" align="left" valign="top">5583</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top">&#x02003;No. of solvent atoms</td><td rowspan="1" colspan="1" align="left" valign="top">121</td></tr><tr><td rowspan="1" colspan="1" align="left" valign="top">PDB code</td><td rowspan="1" colspan="1" align="left" valign="top"><ext-link ext-link-type="uri" xlink:href="http://www.rcsb.org/pdb/explore.do?structureId=2ix2">2ix2</ext-link></td></tr></tbody></table><table-wrap-foot><fn id="tfn1"><label>&#x02020;</label><p>                     <italic>R</italic>                     <sub>merge</sub> = <inline-formula><inline-graphic xlink:href="f-62-00944-efi1.jpg" mimetype="image" mime-subtype="gif"/></inline-formula>                     <inline-formula><inline-graphic xlink:href="f-62-00944-efi2.jpg" mimetype="image" mime-subtype="gif"/></inline-formula>, where <italic>I</italic>(<italic>h</italic>) is the measured diffraction intensity and the summation includes all observations.</p></fn><fn id="tfn2"><label>&#x02021;</label><p>                     <italic>R</italic> factor = <inline-formula><inline-graphic xlink:href="f-62-00944-efi3.jpg" mimetype="image" mime-subtype="gif"/></inline-formula>                     <inline-formula><inline-graphic xlink:href="f-62-00944-efi4.jpg" mimetype="image" mime-subtype="gif"/></inline-formula>.</p></fn><fn id="tfn3"><label>&#x000a7;</label><p>                     <italic>R</italic>                     <sub>free</sub> is calculated the same way as <italic>R</italic> factor for data omitted from refinement (5% of reflections for all data sets).</p></fn></table-wrap-foot></table-wrap><table-wrap id="table2" position="float"><label>Table 2</label><caption><title>The sequence identity/similarity (%) between PCNA molecules</title></caption><table frame="hsides" rules="groups"><thead valign="bottom"><tr><th rowspan="1" colspan="1" align="left" valign="bottom">&