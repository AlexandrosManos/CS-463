</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dieperink</surname><given-names>W</given-names></name><name><surname>Goorhuis</surname><given-names>JF</given-names></name><name><surname>de Weerd</surname><given-names>W</given-names></name><name><surname>Hazenberg</surname><given-names>A</given-names></name><name><surname>Zijlstra</surname><given-names>JG</given-names></name><name><surname>Nijsten</surname><given-names>MWN</given-names></name></person-group><article-title>Walking with continuous positive airway pressure</article-title><source>Eur Respir J</source><year>2006</year><volume>27</volume><fpage>853</fpage><lpage>855</lpage><pub-id pub-id-type="pmid">16585093</pub-id><pub-id pub-id-type="doi">10.1183/09031936.06.00031305</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Templier</surname><given-names>F</given-names></name><name><surname>Dolveck</surname><given-names>F</given-names></name><name><surname>Baer</surname><given-names>M</given-names></name><name><surname>Chauvin</surname><given-names>M</given-names></name><name><surname>Fletcher</surname><given-names>D</given-names></name></person-group><article-title>Laboratory testing measurement of FIO2 delivered by Boussignac CPAP system with an input of 100% oxygen</article-title><source>Ann Fr Anesth Reanim</source><year>2003</year><volume>22</volume><fpage>103</fpage><lpage>107</lpage><pub-id pub-id-type="pmid">12706763</pub-id><pub-id pub-id-type="doi">10.1016/S0750-7658(02)00859-6</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cigada</surname><given-names>M</given-names></name><name><surname>Elia</surname><given-names>G</given-names></name><name><surname>Umbrello</surname><given-names>M</given-names></name><name><surname>Giacomini</surname><given-names>M</given-name