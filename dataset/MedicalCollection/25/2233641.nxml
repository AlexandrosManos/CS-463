"pmid">7750335</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Winck</surname><given-names>JC</given-names></name><name><surname>Azevedo</surname><given-names>LF</given-names></name><name><surname>Costa-Pereira</surname><given-names>A</given-names></name><name><surname>Antonelli</surname><given-names>M</given-names></name><name><surname>Wyatt</surname><given-names>JC</given-names></name></person-group><article-title>Efficacy and safety of non-invasive ventilation in the treatment of acute cardiogenic pulmonary edema &#x02013; a systematic review and meta-analysis</article-title><source>Crit Care</source><year>2006</year><volume>10</volume><fpage>R69</fpage><pub-id pub-id-type="pmid">16646987</pub-id><pub-id pub-id-type="doi">10.1186/cc4905</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ho</surname><given-names>KM</given-names></name><name><surname>Wong</surname><given-names>K</given-names></name></person-group><article-title>A comparison of continuous and bi-level positive airway pressure non-invasive ventilation in patients with acute cardiogenic pulmonary oedema: a meta-analysis</article-title><source>Crit Care</source><year>2006</year><volume>10</volume><fpage>R49</fpage><pub-id pub-id-type="pmid">16569254</pub-id><pub-id pub-id-type="doi">10.1186/cc4861</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leman</surname><given-names>P</given-names></name><name><surname>Greene</surname><given-names>S</given-names></name><name><surname>Whelan</surname><given-names>K</given-names></name><name><surname>Legassick</surname><given-names>T</given-names></name></person-group><article-title>Simple lightweight disposable continuous positive airways pressure mask to effectively treat acute pulmonary oedema: Randomized controlled trial</articl