e>390</lpage><pub-id pub-id-type="pmid">3961486</pub-id></citation></ref><ref id="Brugnaraetal1985"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brugnara</surname><given-names>C.</given-names></name><name><surname>Kopin</surname><given-names>A.S.</given-names></name><name><surname>Bunn</surname><given-names>H.F.</given-names></name><name><surname>Tosteson</surname><given-names>D.C.</given-names></name></person-group><article-title>Regulation of cation content and cell volume in hemoglobin erythrocytes from patients with homozygous hemoglobin C disease</article-title><source>J. Clin. Invest.</source><volume>75</volume><year>1985</year><fpage>1608</fpage><lpage>1617</lpage><pub-id pub-id-type="pmid">3998150</pub-id></citation></ref><ref id="BrugnaraandTosteson1987"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brugnara</surname><given-names>C.</given-names></name><name><surname>Tosteson</surname><given-names>D.C.</given-names></name></person-group><article-title>Cell volume, K transport, and cell density in human erythrocytes</article-title><source>Am. J. Physiol.</source><volume>252</volume><year>1987</year><fpage>C269</fpage><lpage>C276</lpage><pub-id pub-id-type="pmid">3826356</pub-id></citation></ref><ref id="Brugnaraetal1989"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brugnara</surname><given-names>C.</given-names></name><name><surname>Van Ha</surname><given-names>T.</given-names></name><name><surname>Tosteson</surname><given-names>D.C.</given-names></name></person-group><article-title>Acid pH induces formation of dense cells in sickle erythrocytes</article-title><source>Blood.</source><volume>74</volume><year>1989</year><fpage>487</fpage><lpage>495</lpage><pub-id pub-id-type="pmid">2752126</pub-id></citation></ref><ref id="Cala1983"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cala</surname><given-names>P.M.</given-names></name></person-group><article-title>Volume regulation by red blood cellsmechanisms of ion transport between cells and mechanisms</article-title><source>Mol. Physiol.</source><volume>4</volume><year>1983</year><fpage>33</fpage><lpage>52</lpage></citation></ref><ref id="Canessaetal1987"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Canessa</surname><given-names>M.</given-names></name><name><surname>Fabry</surname><given-names>M.E.</given-names></name><name><surname>Blumenfield</surname><given-names>N.</given-names></name><name><surname>Nagel</surname><given-names>R.L.</given-names></name></person-group><article-title>Volume stimulated, Cl<sup>&#x02212;</sup>dependent K<sup>+</sup> efflux highly expressed in young human red cells containing normal hemoglobin or HbS</article-title><source>J. Membr. Biol.</source><volume>97</volume><year>1987</year><fpage>97</fpage><lpage>105</lpage><pub-id pub-id-type="pmid">3446820</pub-id></citation></ref><ref id="Canessaetal1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Canessa</surname><given-names>M.</given-names></name><name><surname>Romero</surname><given-names>J.R.</given-names></name><name><surname>Lawrence</surname><given-names>C.</given-names></name><name><surname>Nagel</surname><given-names>R.L.</given-names></name><name><surname>Fabry</surname><given-names>M.E.</given-names></name></person-group><article-title>Rate of activation and deactivation of K:Cl cotransport by changes in cell volume in hemoglobin SS, CC, and AA red cells</article-title><source>J. Membr. Biol.</source><volume>142</volume><year>1994</year><fpage>349</fpage><lpage>362</lpage><pub-id pub-id-type="pmid">7707362</pub-id></citation></ref><ref id="CossinsandGibson1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cossins</surname><given-names>A.R.</given-names></name><name><surname>Gibson</surname><given-names>J.S.</given-names></name></person-group><article-title>Volume-sensitive transport systems and volume homeostasis in vertebrate red blood cells</article-title><source>J. Exp. Biol.</source><volume>200</volume><year>1997</year><fpage>343</fpage><lpage>352</lpage><pub-id pub-id-type="pmid">9050243</pub-id></citation></ref><ref id="deFranceschietal1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>de Franceschi</surname><given-names>L.</given-names></name><name><surname>Fumagalli</surname><given-names>L.</given-names></name><name><surname>Olivieri</surname><given-names>O.</given-names></name><name><surname>Corrocher</surname><given-names>R.</given-names></name><name><surname>Lowell</surname><given-names>C.A.</given-names></name><name><surname>Berton</surname><given-names>G.</given-names></name></person-group><article-title>Deficiency of Src family kinases Fgr and Hck results in activation of erythrocyte K/Cl cotransport</article-title><source>J. Clin. Invest.</source><volume>99</volume><year>1997</year><fpage>220</fpage><lpage>227</lpage><pub-id pub-id-type="pmid">9005990</pub-id></citation></ref><ref id="DelpireandLauf1991a"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Delpire</surname><given-names>E.</given-names></name><name><surname>Lauf</surname><given-names>P.K.</given-names></name></person-group><article-title>Magnesium and ATP dependence of K-Cl Co-transport in low K<sup>+</sup> sheep red blood cells</article-title><source>J. Physiol.</source><volume>441</volume><year>1991</year><fpage>219</fpage><lpage>231</lpage>a<pub-id pub-id-type="pmid">1816372</pub-id></citation></ref><ref id="DelpireandLauf1991b"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Delpire</surname><given-names>E.</given-names></name><name><surname>Lauf</surname><given-names>P.K.</given-names></name></person-group><article-title>Kinetic