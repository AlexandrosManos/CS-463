ume>21</volume><fpage>165</fpage><lpage>168</lpage><pub-id pub-id-type="doi">10.1016/0379-0738(95)01875-1</pub-id><pub-id pub-id-type="pmid">8635759</pub-id></mixed-citation></ref><ref id="B23"><mixed-citation publication-type="journal"><name><surname>Levine</surname><given-names>B</given-names></name><name><surname>Wu</surname><given-names>SC</given-names></name><name><surname>Smialek</surname><given-names>JE</given-names></name><article-title>Zolpidem distribution in postmortem cases</article-title><source>J Forensic Sci</source><year>1999</year><volume>21</volume><fpage>369</fpage><lpage>371</lpage><pub-id pub-id-type="pmid">10097364</pub-id></mixed-citation></ref><ref id="B24"><mixed-citation publication-type="journal"><name><surname>Gock</surname><given-names>SB</given-names></name><name><surname>Wong</surname><given-names>SH</given-names></name><name><surname>Nuwayhid</surname><given-names>N</given-names></name><name><surname>Venuti</surname><given-names>SE</given-names></name><name><surname>Kelley</surname><given-names>PD</given-names></name><name><surname>Teggatz</surname><given-names>JR</given-names></name><name><surname>Jentzen</surname><given-names>JM</given-names></name><article-title>Acute zolpidem overdose&#x02014;report of two cases</article-title><source>J Anal Toxicol</source><year>1999</year><volume>21</volume><fpage>559</fpage><lpage>562</lpage><pub-id pub-id-type="doi">10.1093/jat/23.6.559</pub-id><pub-id pub-id-type="pmid">10517569</pub-id></mixed-citation></ref></ref-list></back></article>