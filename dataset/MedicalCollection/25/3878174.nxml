e>Prim Care Companion J Clin Psychiatry</source><year>2010</year><volume>21</volume><issue>6</issue><fpage>e1</fpage><lpage>e8</lpage></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="journal"><name><surname>Brodeur</surname><given-names>MR</given-names></name><name><surname>Stirling</surname><given-names>AL</given-names></name><article-title>Delirium associated with zolpidem</article-title><source>Ann Pharmacother</source><year>2001</year><volume>21</volume><fpage>1562</fpage><lpage>1564</lpage><pub-id pub-id-type="pmid">11793620</pub-id></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="journal"><name><surname>Hill</surname><given-names>KP</given-names></name><name><surname>Oberstar</surname><given-names>JV</given-names></name><name><surname>Dunn</surname><given-names>ER</given-names></name><article-title>Zolpidem-induced delirium with mania in an elderly woman</article-title><source>Psychosomatics</source><year>2004</year><volume>21</volume><fpage>88</fpage><lpage>89</lpage><pub-id pub-id-type="doi">10.1176/appi.psy.45.1.88</pub-id><pub-id pub-id-type="pmid">14709766</pub-id></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="journal"><name><surname>Elko</surname><given-names>CJ</given-names></name><name><surname>Burgess</surname><given-names>JL</given-names></name><name><surname>Robertson</surname><given-names>WO</given-names></name><article-title>Zolpidem-associated hallucinations and serotonin reuptake inhibition: a possible interaction</article-title><source>J Toxicol Clin Toxicol</source><year>1998</year><volume>21</volume><fpage>195</fpage><lpage>203</lpage><pub-id pub-id-type="doi">10.3109/15563659809028939</pub-id><pub-id pub-id-type="pmid">9656974</pub-id></mixed-citation></ref><ref id="B19"><mixed-citation publication-type="journal"><name><surname>Paradis</surname><given-names>CM</given-names></name><name><surname>Siegel</surname><given-names>LA</given-names></name><name><surname>Kleinman</surn