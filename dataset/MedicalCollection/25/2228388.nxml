on-group person-group-type="author"><name><surname>Riddle</surname><given-names>MC</given-names></name></person-group><article-title>The treat-to-target trial: randomized addition of glargine or human NPH insulin to oral therapy of type 2 diabetic patients</article-title><source>Diabetes Care</source><year>2003</year><volume>26</volume><fpage>3080</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">14578243</pub-id></citation></ref><ref id="b15"><label>15</label><citation citation-type="book"><collab>IDF Clinical Guidelines Task Force</collab><source>Global Guideline for Type 2 Diabetes</source><year>2005</year><publisher-loc>Brussels</publisher-loc><publisher-name>International Diabetes Federation</publisher-name></citation></ref><ref id="b16"><label>16</label><citation citation-type="journal"><collab>American Diabetes Association</collab><article-title>Standards of medical care in diabetes</article-title><source>Diabetes Care</source><year>2006</year><volume>29</volume><issue>Suppl. 1</issue><fpage>S4</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">16373931</pub-id></citation></ref><ref id="b17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eliaschewitz</surname><given-names>FG</given-names></name><etal/></person-group><article-title>Therapy in type 2 diabetes: insulin glargine vs. NPH insulin both in combination with glimepiride</article-title><source>Arch Med Res</source><year>2006</year><volume>37</volume><fpage>495</fpage><lpage>501</lpage><pub-id pub-id-type="pmid">16715577</pub-id></citation></ref><ref id="b18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Raccah</surname><given-names>D</given-names></name></person-group><article-title>When basal insulin therapy in type 2 diabetes mellitus is not enough &#x02013; what next?</article-title><source>Diabetes Metab Res Rev</source><year>2007</year><volume>23</volume><fpage>257</fpage><lpage>64</lpage><pub-id pub-id-type="pmid">17315242</pub-id></citation></ref></ref-list></back></article>