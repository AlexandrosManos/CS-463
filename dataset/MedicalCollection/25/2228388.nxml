-group-type="author"><name><surname>Schreiber</surname><given-names>SA</given-names></name></person-group><article-title>Insulin glargine benefits patients with type 2 diabetes inadequately controlled on oral antidiabetic treatment: an observational study of everyday practice in 12,216 patients</article-title><source>Diabetes Obes Metab</source><year>2007</year><volume>9</volume><fpage>31</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">17199716</pub-id></citation></ref><ref id="b7"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hauner</surname><given-names>H</given-names></name></person-group><article-title>Outpatient care of patients with diabetes mellitus in 2001. Analysis of a health insurance sample of the AOK in Hesse/KV in Hesse</article-title><source>Dtsch Med Wochenschr</source><year>2003</year><volume>128</volume><fpage>2638</fpage><lpage>43</lpage><pub-id pub-id-type="pmid">14673739</pub-id></citation></ref><ref id="b8"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Larger</surname><given-names>E</given-names></name></person-group><article-title>Weight gain and insulin treatment</article-title><source>Diabetes Metab</source><year>2005</year><volume>31</volume><issue>4 part 2</issue><fpage>4S51</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">16389899</pub-id></citation></ref><ref id="b9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Raskin</surname><given-names>P</given-names></name><etal/></person-group><article-title>Initiating insulin therapy in type 2 diabetes: a comparison of biphasic and basal insulin analogs</article-title><source>Diabetes Care</source><year>2005</year><volume>28</volume><fpage>260</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">15677776</pub-id></citation></ref><ref id="b10"><label>10</label><citation citation-type="journal"><person-group person-group-