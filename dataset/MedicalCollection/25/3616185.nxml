ven-names>MA</given-names></name><etal/></person-group><article-title>Pulmonary embolism as a cause of death in patients with heart disease: an autopsy study</article-title><source>Chest</source><year>2006</year><volume>129</volume><fpage>1282</fpage><pub-id pub-id-type="pmid">16685020</pub-id></element-citation></ref><ref id="b19-amjcaserep-13-137"><label>19.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Stein</surname><given-names>PD</given-names></name><name><surname>Beemath</surname><given-names>A</given-names></name><name><surname>Matta</surname><given-names>F</given-names></name><etal/></person-group><article-title>Clinical characteristics of patients with acute pulmonary embolism: data from PIOPED II</article-title><source>Am J Med</source><year>2007</year><volume>120</volume><fpage>871</fpage><pub-id pub-id-type="pmid">17904458</pub-id></element-citation></ref><ref id="b20-amjcaserep-13-137"><label>20.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Henderson</surname><given-names>AF</given-names></name><name><surname>Moran</surname><given-names>F</given-names></name><name><surname>Banham</surname><given-names>SW</given-names></name></person-group><article-title>Pulmonary thromboembolism presenting as abdominal pain</article-title><source>BMJ</source><year>1984</year><volume>289</volume><fpage>902</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">6434135</pub-id></element-citation></ref></ref-list></back></article>