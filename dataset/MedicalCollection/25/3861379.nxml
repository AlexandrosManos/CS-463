pub-id-type="pmid">19736481</pub-id></element-citation></ref><ref id="B5"><label>5</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lam</surname><given-names>KY</given-names></name><name><surname>Ng</surname><given-names>WF</given-names></name><name><surname>Chan</surname><given-names>AC</given-names></name></person-group><article-title>Miliary tuberculosis with splenic rupture: a fatal case with hemophagocytic syndrome and possible association with long standing sarcoidosis</article-title><source>Pathology</source><year>1994</year><volume>26</volume><fpage>493</fpage><lpage>496</lpage><pub-id pub-id-type="pmid">7892057</pub-id></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ram</surname><given-names>R</given-names></name><name><surname>Swarnalatha</surname><given-names>G</given-names></name><name><surname>Prasad</surname><given-names>N</given-names></name><name><surname>Murty</surname><given-names>KV</given-names></name></person-group><article-title>Pathological rupture of spleen in a haemodialysis patient due to tuberculosis</article-title><source>Nephrol Dial Transplant</source><year>2006</year><volume>21</volume><fpage>2994</fpage><lpage>2995</lpage><pub-id pub-id-type="pmid">16861727</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Weber</surname><given-names>E</given-names></name><name><surname>Gunthard</surname><given-names>HF</given-names></name><name><surname>Schertler</surname><given-names>T</given-names></name><name><surname>Seebach</surname><given-names>JD</given-names></name></person-group><article-title>Spontaneous splenic rupture as manifestation of the immune reconstitution inflammatory syndrome in an HIV type 1 infected patient with tuberculosis</article-title><source>Infect