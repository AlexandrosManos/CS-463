ef><ref id="bib22"><citation citation-type="journal">Franke, C., H. Hatt, H. Parnas, and J. Dudel. <year>1992</year>. Recovery from the rapid desensitization of nicotinic acetylcholine receptor channels on mouse muscle. <source>Neurosci. Lett.</source> <volume>140</volume>:<fpage>169</fpage>&#x02013;172.<pub-id pub-id-type="pmid">1380143</pub-id></citation></ref><ref id="bib23"><citation citation-type="journal">Hershkowitz, N., and M.A. Rogawski. <year>1991</year>. Tetrahydroaminoacridine block of N-methyl-D-aspartate-activated cation channels in cultured hippocampal neurons. <source>Mol. Pharmacol.</source> <volume>39</volume>:<fpage>592</fpage>&#x02013;598.<pub-id pub-id-type="pmid">1709720</pub-id></citation></ref><ref id="bib24"><citation citation-type="journal">Hunter, A.J., T.K. Murray, J.A. Jones, A.J. Cross, and A.R. Green. <year>1989</year>. The cholinergic pharmacology of tetrahydroaminoacridine in vivo and in vitro. <source>Br. J. Pharmacol.</source> <volume>98</volume>:<fpage>79</fpage>&#x02013;86.<pub-id pub-id-type="pmid">2804555</pub-id></citation></ref><ref id="bib25"><citation citation-type="journal">Jahn, K., B. Mohammadi, K. Krampf, A. Abicht, H. Lochmuller, and J. Bufler. <year>2001</year>. Deactivation and desensitization of mouse embryonic- and adult-type nicotinic receptor channel currents. <source>Neurosci. Lett.</source> <volume>307</volume>:<fpage>89</fpage>&#x02013;92.<pub-id pub-id-type="pmid">11427307</pub-id></citation></ref><ref id="bib26"><citation citation-type="journal">Katz, B., and S. Thesleff. <year>1957</year>. A study of the desensitization produced by acetylcholine at the motor end-plate. <source>J. Physiol.</source> <volume>138</volume>:<fpage>63</fpage>&#x02013;80.<pub-id pub-id-type="pmid">13463799</pub-id></citation></ref><ref id="bib27"><citation citation-type="journal">Kiefer-Day, J.S., H.E. Campbell, J. Towles, and E.E. el Fakahany. <year>1991</year>. Muscarinic subtype selectivity of tetrahydroaminoacridine: possible r