thor"><name><surname>Freeman</surname><given-names>CB</given-names></name></person-group><article-title>Classification of cell lines derived from undifferentiated lymphomas according to their expression of complement and Epstein&#x02013;Barr virus receptors: implications for the relationship between African and American Burkitt&#x02019;s lymphoma</article-title><source>Clinical Immunology and Immunopathology</source><year>1982</year><volume>25</volume><fpage>103</fpage><lpage>113</lpage><pub-id pub-id-type="pmid">7151335</pub-id></citation></ref><ref id="b19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fremeaux-Bacchi</surname><given-names>V</given-names></name></person-group><article-title>Soluble CD21 (sCD21) forms biologically active complexes with CD23: sCD21 is present in normal plasma as a complex with trimeric CD23 and inhibits soluble CD23-induced IgE synthesis by B cells</article-title><source>International Immunology</source><year>1998</year><volume>10</volume><fpage>1459</fpage><lpage>1466</lpage><pub-id pub-id-type="pmid">9796912</pub-id></citation></ref><ref id="b20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ghetie</surname><given-names>MA</given-names></name></person-group><article-title>Anti-CD19 inhibits the growth of human B-cell tumor lines <italic>in vitro</italic> and of Daudi cells in SCID mice by inducing cell cycle arrest</article-title><source>Blood</source><year>1994</year><volume>83</volume><fpage>1329</fpage><lpage>1336</lpage><pub-id pub-id-type="pmid">7509655</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ghetie</surname><given-names>MA</given-names></name></person-group><article-title>Homodimerization of tumor-reactive monoclonal antibodies markedly increases their ability to induce growth arrest or apoptosis of tumor cells</article-title><source>Proceedings of the National Academy of Sciences of the United States of America</source><year>1997</year><volume>94</volume><fpage>7509</fpage><lpage>7514</lpage><pub-id pub-id-type="pmid">9207122</pub-id></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gloghini</surname><given-names>A</given-names></name></person-group><article-title>The nonlymphoid microenvironment of reactive follicles and lymphomas of follicular origin as defined by immunohistology on paraffin-embedded tissues</article-title><source>Human Pathology</source><year>1993</year><volume>24</volume><fpage>67</fpage><lpage>76</lpage><pub-id pub-id-type="pmid">8418015</pub-id></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goulet</surname><given-names>AC</given-names></name></person-group><article-title>Conjugation of blocked ricin to an anti-CD19 monoclonal antibody increases antibody-induced cell calcium mobilization and CD19 internalization</article-title><source>Blood</source><year>1997</year><volume>90</volume><fpage>2364</fpage><lpage>2375</lpage><pub-id pub-id-type="pmid">9310487</pub-id></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamann</surname><given-names>PR</given-names></name></person-group><article-title>Gemtuzumab ozogamicin, a potent and selective anti-CD33 antibody-calicheamicin conjugate for treatment of acute myeloid leukemia</article-title><source>Bioconjugate Chemistry</source><year>2002</year><volume>13</volume><fpage>47</fpage><lpage>58</lpage><pub-id pub-id-type="pmid">11792178</pub-id></citation></ref><ref id="b25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>James</surname><given-names>JS</given-names></name></person-group><article-title>FDA approves new kind of lymphoma treatment. Food and Drug Administration</article-title><source>