p><article-title>Sodium and potassium currents in squid axons perfused with fluoride solutions</article-title><source>J. Gen. Physiol.</source><volume>211</volume><year>1970</year><fpage>623</fpage><lpage>652</lpage></citation></ref><ref id="Doyleetal1998"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Doyle</surname><given-names>D.A.</given-names></name><name><surname>Cabral</surname><given-names>J.M.</given-names></name><name><surname>Pfuetzner</surname><given-names>A.</given-names></name><name><surname>Kuo</surname><given-names>J.M.</given-names></name><name><surname>Gulbis</surname><given-names>J.M.</given-names></name><name><surname>Cohen</surname><given-names>S.L.</given-names></name><name><surname>Chait</surname><given-names>B.T.</given-names></name><name><surname>MacKinnon</surname><given-names>R.</given-names></name></person-group><article-title>The structure of the potassium channelmolecular basis of K<sup>+</sup> conduction and selectivity</article-title><source>Science.</source><volume>280</volume><year>1998</year><fpage>69</fpage><lpage>76</lpage><pub-id pub-id-type="pmid">9525859</pub-id></citation></ref><ref id="FrenchandWells1977"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>French</surname><given-names>R.J.</given-names></name><name><surname>Wells</surname><given-names>J.B.</given-names></name></person-group><article-title>Sodium ions as blocking agents and charge carriers in the potassium channel of the squid giant axon</article-title><source>J. Gen. Physiol.</source><volume>70</volume><year>1977</year><fpage>707</fpage><lpage>724</lpage><pub-id pub-id-type="pmid">591920</pub-id></citation></ref><ref id="N0x1c17150N0x2925010"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>G&#x000f3;mez-Lagunas</surname><given-names>F.</given-names></name></person-group><article-title>Shaker B K<sup>+</sup> conductance in Na<sup>+</sup> solutions lacking K<sup>+</sup> ionsa remarkably stable non-conducting state produced by membrane depolarizations</article-title><source>J. Physiol.</source><volume>499</volume><year>1997</year><fpage>3</fpage><lpage>15</lpage><pub-id pub-id-type="pmid">9061636</pub-id></citation></ref><ref id="N0x1c17150N0x2925070"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>G&#x000f3;mez-Lagunas</surname><given-names>F.</given-names></name></person-group><article-title>Barium inhibition of the collapse of the Shaker K<sup>+</sup> conductance in zero K<sup>+</sup></article-title><source>Biophys. J.</source><volume>77</volume><year>1999</year><fpage>2988</fpage><lpage>2998</lpage><pub-id pub-id-type="pmid">10585921</pub-id></citation></ref><ref id="N0x1c17150N0x29250d0"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>G&#x000f3;mez-Lagunas</surname><given-names>F.</given-names></name></person-group><article-title>External K<sup>+</sup> and Na<sup>+</sup> competition for a site of the pore of Shaker K channels</article-title><source>Biophys. J.</source><volume>78</volume><year>2000</year><fpage>95A</fpage>(<italic>Abstr</italic></citation></ref><ref id="IkedaandKorn1995"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ikeda</surname><given-names>S.R.</given-names></name><name><surname>Korn</surname><given-names>S.J.</given-names></name></person-group><article-title>Influence of permeating ions on potassium channel block by tetraethylammonium</article-title><source>J. Physiol.</source><volume>486</volume><year>1995</year><fpage>267</fpage><lpage>272</lpage><pub-id pub-id-type="pmid">7473194</pub-id></citation></ref><ref id="Immkeetal1998"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Immke</surname><given-names>D.</given-names></name><name><surname>Laszlo</surname><given-names>K.</given-names></name><name><surname>