name><name><surname>Guy</surname><given-names>H.R.</given-names></name></person-group><article-title>Structural models of the transmembrane region of voltage-gated and other K<sup>+</sup> channels in open, closed and inactivated conformations</article-title><source>J. Struct. Biol.</source><volume>121</volume><year>1998</year><fpage>263</fpage><lpage>284</lpage><pub-id pub-id-type="pmid">9615442</pub-id></citation></ref><ref id="DurellandGuy1996"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Durell</surname><given-names>S.R.</given-names></name><name><surname>Guy</surname><given-names>H.R.</given-names></name></person-group><article-title>Structural model of the outer vestibule and selectivity filter of the <italic>Shaker</italic> voltage-gated K<sup>+</sup> channel</article-title><source>Neuropharmacology.</source><volume>35</volume><year>1996</year><fpage>761</fpage><lpage>773</lpage><pub-id pub-id-type="pmid">8938709</pub-id></citation></ref><ref id="Eismannetal1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eismann</surname><given-names>E.</given-names></name><name><surname>Muller</surname><given-names>F.</given-names></name><name><surname>Heinemann</surname><given-names>S.H.</given-names></name><name><surname>Kaupp</surname><given-names>U.B.</given-names></name></person-group><article-title>A single negative charge within the pore region of a cGMP-gated channel controls rectification, Ca<sup>2+</sup> blockage, and ionic selectivity</article-title><source>Proc. Natl. Acad. Sci. USA.</source><volume>91</volume><year>1994</year><fpage>1109</fpage><lpage>1113</lpage><pub-id pub-id-type="pmid">7508120</pub-id></citation></ref><ref id="Fodoretal1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fodor</surname><given-names>A.A.</given-names></name><name><surname>Black</surname><given-names>K.D.</given-names></name><name><surname>Zagotta</surname><given-names>W.</given-names></name></person-group><article-title>Tetracaine reports a conformational change in the pore of cyclic nucleotide&#x02013;gated channels</article-title><source>J. Gen. Physiol</source><volume>110</volume><year>1997</year><fpage>591</fpage><lpage>600</lpage><pub-id pub-id-type="pmid">9348330</pub-id></citation></ref><ref id="Frechetal1989"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Frech</surname><given-names>G.C.</given-names></name><name><surname>VanDongen</surname><given-names>A.M.J.</given-names></name><name><surname>Schuster</surname><given-names>G.</given-names></name><name><surname>Brown</surname><given-names>A.M.</given-names></name><name><surname>Joho</surname><given-names>R.H.</given-names></name></person-group><article-title>A novel potassium channel with delayed rectifier properties isolated from rat brain by expression cloning</article-title><source>Nature.</source><volume>340</volume><year>1989</year><fpage>642</fpage><lpage>645</lpage><pub-id pub-id-type="pmid">2770868</pub-id></citation></ref><ref id="GordonandZagotta1995"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gordon</surname><given-names>S.E.</given-names></name><name><surname>Zagotta</surname><given-names>W.N.</given-names></name></person-group><article-title>A histidine residue associated with the gate of the cyclic nucleotide&#x02013;activated channels in rod photoreceptors</article-title><source>Neuron.</source><volume>14</volume><year>1995</year><fpage>177</fpage><lpage>183</lpage><pub-id pub-id-type="pmid">7530019</pub-id></citation></ref><ref id="Gouldingetal1992"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goulding</surname><given-names>E.H.</given-names></name><name><surname>Ngai</surname><given-names>J.</given-names></name><name><surname>Kramer</surname><given-names>R.H.</given-names></name><name><surname>Co