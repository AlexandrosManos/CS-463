593</fpage><lpage>601</lpage><pub-id pub-id-type="pmid">11755501</pub-id></element-citation></ref><ref id="B23"><label>23</label><element-citation publication-type="journal"><name><surname>Schroy</surname><given-names>P</given-names></name><name><surname>Lal</surname><given-names>S</given-names></name><name><surname>Glick</surname><given-names>J</given-names></name><name><surname>Robinson</surname><given-names>P</given-names></name><name><surname>Zamor</surname><given-names>P</given-names></name><name><surname>Heerem</surname><given-names>T</given-names></name><article-title>Patient preferences for colorectal cancer screening: how does stool DNA testing fare?</article-title><source>Am J Managed Care</source><year>2007</year><volume>13</volume><fpage>393</fpage><lpage>400</lpage></element-citation></ref><ref id="B24"><label>24</label><element-citation publication-type="journal"><name><surname>Hawley</surname><given-names>S</given-names></name><name><surname>Volk</surname><given-names>R</given-names></name><name><surname>Krishnamurthy</surname><given-names>P</given-names></name><name><surname>Jibaja-Weiss</surname><given-names>M</given-names></name><name><surname>Vernon</surname><given-names>S</given-names></name><name><surname>Kneuper</surname><given-names>S</given-names></name><article-title>Preferences for colorectal cancer screening among racially/ethnically diverse primary care patients</article-title><source>Med Care</source><year>2008</year><volume>46</volume><fpage>S10</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">18725820</pub-id></element-citation></ref><ref id="B25"><label>25</label><element-citation publication-type="journal"><name><surname>Marshall</surname><given-names>D</given-names></name><name><surname>Johnson</surname><given-names>F</given-names></name><name><surname>Phillips</surname><given-names>K</given-names></name><name><surname>Marshall</surname><given-names>J</given-names></name><name><surname>Thabane</surname><given-names>L</given-names><