"><person-group person-group-type="author"><name><surname>Creighton</surname><given-names>T.E.</given-names></name></person-group><source>ProteinsStructures and Molecular Properties</source><year>1993</year><publisher-name>Freeman, </publisher-name><publisher-loc>New York</publisher-loc>pp. 507 p</citation></ref><ref id="DSouzaandLipkowitz1998"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>D'Souza</surname><given-names>V.T.</given-names></name><name><surname>Lipkowitz</surname><given-names>K.B.</given-names></name></person-group><article-title>Cyclodextrins</article-title><source>Chem. Rev.</source><volume>98</volume><year>1998</year><fpage>1741</fpage><lpage>2076</lpage><pub-id pub-id-type="pmid">11848946</pub-id></citation></ref><ref id="Erogluetal2000"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eroglu</surname><given-names>A.</given-names></name><name><surname>Russo</surname><given-names>M.J.</given-names></name><name><surname>Bieganski</surname><given-names>R.</given-names></name><name><surname>Fowler</surname><given-names>A.</given-names></name><name><surname>Cheley</surname><given-names>S.</given-names></name><name><surname>Bayley</surname><given-names>H.</given-names></name><name><surname>Toner</surname><given-names>M.</given-names></name></person-group><article-title>Intracellular trehalose improves the survival of cryopreserved mammalian cells</article-title><source>Nat. Biotechnol.</source><volume>18</volume><year>2000</year><fpage>163</fpage><lpage>167</lpage><pub-id pub-id-type="pmid">10657121</pub-id></citation></ref><ref id="N0x320cb90N0x3665ee0"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>F&#x000fc;ssle</surname><given-names>R.</given-names></name><name><surname>Bhakdi</surname><given-names>S.</given-names></name><name><surname>Sziegoleit</surname><given-names>A.</given-names></name><name><surname>Tranum-Jensen</surn