="center" rowspan="1" colspan="1">Monobutyl phthalate</td><td align="center" rowspan="1" colspan="1">MBP</td></tr><tr><td colspan="3" rowspan="1"><hr/></td></tr><tr><td rowspan="1" colspan="1"><inline-graphic xlink:href="PPAR2008-359267.002d.jpg"/></td><td align="center" rowspan="1" colspan="1">Monopentyl phthalate</td><td align="center" rowspan="1" colspan="1">MPP</td></tr><tr><td colspan="3" rowspan="1"><hr/></td></tr><tr><td rowspan="1" colspan="1"><inline-graphic xlink:href="PPAR2008-359267.002e.jpg"/></td><td align="center" rowspan="1" colspan="1">Monohexyl phthalate</td><td align="center" rowspan="1" colspan="1">MHP</td></tr><tr><td colspan="3" rowspan="1"><hr/></td></tr><tr><td rowspan="1" colspan="1"><inline-graphic xlink:href="PPAR2008-359267.002f.jpg"/></td><td align="center" rowspan="1" colspan="1">Monopropyl phthalate</td><td align="center" rowspan="1" colspan="1">MPrP</td></tr><tr><td colspan="3" rowspan="1"><hr/></td></tr><tr><td rowspan="1" colspan="1"><inline-graphic xlink:href="PPAR2008-359267.002g.jpg"/></td><td align="center" rowspan="1" colspan="1">Mono-(2-ethylhexyl) phthalate</td><td align="center" rowspan="1" colspan="1">MEPH</td></tr></tbody></table></table-wrap></floats-wrap></article>