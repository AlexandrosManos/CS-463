name><surname>Dhallan</surname><given-names>R.S.</given-names></name><name><surname>Yau</surname><given-names>K.W.</given-names></name><name><surname>Schrader</surname><given-names>K.A.</given-names></name><name><surname>Reed</surname><given-names>R.R.</given-names></name></person-group><article-title>Primary structure and functional expression of a cyclic nucleotide-activated channel from olfactory neurons</article-title><source>Nature.</source><volume>347</volume><year>1990</year><fpage>184</fpage><lpage>187</lpage><pub-id pub-id-type="pmid">1697649</pub-id></citation></ref><ref id="Fesenkoetal1985"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fesenko</surname><given-names>E.E.</given-names></name><name><surname>Kolesnikov</surname><given-names>S.S.</given-names></name><name><surname>Lyubarsky</surname><given-names>A.L.</given-names></name></person-group><article-title>Induction by cyclic GMP of cationic conductance in plasma membrane of retinal rod outer segment</article-title><source>Nature.</source><volume>313</volume><year>1985</year><fpage>310</fpage><lpage>313</lpage><pub-id pub-id-type="pmid">2578616</pub-id></citation></ref><ref id="Finnetal1995"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Finn</surname><given-names>J.T.</given-names></name><name><surname>Li</surname><given-names>J.</given-names></name><name><surname>Yau</surname><given-names>K.-W.</given-names></name></person-group><article-title>C-Terminus involvement in the gating of cyclic nucleotide-activated channels in rod photoreceptors</article-title><source>Biophys. J.</source><volume>68</volume><year>1995</year><fpage>A253</fpage>(Abstr.)</citation></ref><ref id="Fodoretal1997a"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fodor</surname><given-names>A.A.</given-names></name><name><surname>Black</surname><given-names>K.D.</given-names></name><name><surname>Zagot