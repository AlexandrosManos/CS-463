></name><name><surname>Altenhofen</surname><given-names>W</given-names></name><name><surname>Muller</surname><given-names>F</given-names></name><name><surname>Dose</surname><given-names>A</given-names></name><name><surname>Illing</surname><given-names>M</given-names></name><name><surname>Molday</surname><given-names>RS</given-names></name><name><surname>Kaupp</surname><given-names>UB</given-names></name></person-group><article-title>Rod and cone photoreceptor cells express distinct genes for cGMP-gated channels</article-title><source>Neuron</source><year>1993</year><volume>10</volume><fpage>865</fpage><lpage>877</lpage><pub-id pub-id-type="pmid">7684234</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>TY</given-names></name><name><surname>Yau</surname><given-names>KW</given-names></name></person-group><article-title>Direct modulation by Ca(2&#x0002b;)- calmodulin of cyclic nucleotide-activated channel of rat olfactory receptor neurons</article-title><source>Nature (Lond)</source><year>1994</year><volume>368</volume><fpage>545</fpage><lpage>548</lpage><pub-id pub-id-type="pmid">7511217</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cobbs</surname><given-names>WH</given-names></name><name><surname>Barkdoll</surname><given-names>AE</given-names><suffix>III</suffix></name><name><surname>Pugh</surname><given-names>EN</given-names><suffix>Jr</suffix></name></person-group><article-title>Cyclic GMP increases photocurrent and light sensitivity of retinal cones</article-title><source>Nature (Lond)</source><year>1985</year><volume>317</volume><fpage>64</fpage><lpage>66</lpage><pub-id pub-id-type="pmid">2993915</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ertel</surname><given-names>EA</given-names></name></perso