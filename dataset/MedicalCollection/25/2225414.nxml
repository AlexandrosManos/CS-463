tion citation-type="book"><person-group person-group-type="author"><name><surname>Andersson</surname><given-names>M</given-names></name><name><surname>Jonsson</surname><given-names>G</given-names></name><name><surname>K&#x000e4;lvesten</surname><given-names>AL</given-names></name></person-group><source>Hur g&#x000e5;r det f&#x000f6;r 50-talets Stockholmspojkar? En uppf&#x000f6;ljning av 222 vanliga skolpojkar och 100 Sk&#x000e5;pojkar. [A follow-up of Stockholm boys of the 1950s]</source><year>1976</year><publisher-name>Stockholm , Monografier utgivna av Stockholms Kommunf&#x000f6;rvaltning, no 38 (summary in English)</publisher-name></citation></ref><ref id="B14"><citation citation-type="other"><person-group person-group-type="author"><collab>World Health Organisation (WHO)</collab></person-group><article-title>WHO International Classification of Diseases (ICD)</article-title><ext-link ext-link-type="uri" xlink:href="http://www.who.int/classifications/icd/en/"/></citation></ref><ref id="B15"><citation citation-type="other"><person-group person-group-type="author"><collab>Brottsf&#x000f6;rebyggande r&#x000e5;det (BR&#x000c5;)</collab></person-group><article-title>Crime statistics 2005</article-title><ext-link ext-link-type="uri" xlink:href="http://www.bra.se/extra/pod/?action=pod_show&#x00026;id=13&#x00026;module_instance=11"/></citation></ref><ref id="B16"><citation citation-type="other"><person-group person-group-type="author"><collab>Brottsf&#x000f6;rebyggande r&#x000e5;det (BR&#x000c5;)</collab></person-group><article-title>Persons found guilty of offences</article-title><ext-link ext-link-type="uri" xlink:href="http://www.bra.se/extra/pod/?action=pod_show&#x00026;id=17&#x00026;module_instance=11"/></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Nycander</surname><given-names>G</given-names></name></person-group><article-title>Personlighetsutveckling p&#x000e5; avv&#x000e4;gar [Personality development gone astray]</article-title><source>Ericastiftelsens l&#x000e4;kepedagogiska institut</source><year>1950</year><publisher-name>Stockholm </publisher-name></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Jonsson</surname><given-names>G</given-names></name><name><surname>K&#x000e4;lvesten</surname><given-names>AL</given-names></name></person-group><source>222 Stockholmspojkar. En socialpsykiatrisk unders&#x000f6;kning av pojkar i skol&#x000e5;ldern [222 Stockholm boys]</source><year>1969</year><publisher-name>Stockholm , Almqvist &#x00026; Wiksell</publisher-name></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Otterstr&#x000f6;m</surname><given-names>E</given-names></name></person-group><article-title>Delinquency and children from bad homes - a study of their social prognosis from a social point of view</article-title><source>Acta Paediatr Scand</source><year>1946</year><volume>XXXIII</volume></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nylander</surname><given-names>I</given-names></name><name><surname>Rydelius</surname><given-names>PA</given-names></name></person-group><article-title>A comparison between children of alcoholic fathers from excellent versus poor social conditions</article-title><source>Acta P&#x000e6;diatirica Scandinavia</source><year>1982</year><volume>Sep;71</volume><fpage>809</fpage><lpage>813</lpage></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kjelsberg</surname><given-names>E</given-names></name></person-group><article-title>Conduct disordered adolescents hospitalised 1963-1990. Secular trends in criminal activity</article-title><source>European Child &#x00026; Adolescent Psychiatry</source><year>2005</year><volume>14</volume><fpage>191</fpage><lpage>199</lpage><pub-id pub-id-type="pmid">15981130</pub-id><pub-id pub-id-type="doi">10.1007/s00787-005-0444-0</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kjelsberg</surname><given-names>E</given-names></name><name><surname>Dahl</surname><given-names>AA</given-names></name></person-group><article-title>High delinqency, disability and mortality--a register study of former adolecent psychiatric in-patients.</article-title><source>Acta Psychiatrica Scandinavia</source><year>1998</year><volume>98</volume><fpage>34</fpage><lpage>40</lpage></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kjelsberg</surname><given-names>E</given-names></name><name><surname>Dahl</surname><given-names>AA</given-names></name></person-group><article-title>A long-term follow-up study of adolescent psychiatric in-patients. Part  II. Predictors of delinquency.</article-title><source>Acta Psychiatrica Scandinavia</source><year>1999</year><volume>99</volume><fpage>237</fpage><lpage>242</lpage></citation></ref><ref id="B24"><citation citation-type="other"><person-group person-group-type="author"><collab>Brottsf&#x000f6;rebyggande r&#x000e5;det (BR&#x000c5;)</collab></person-group><article-title>Criminality over time</article-title><ext-link ext-link-type="uri" xlink:href="http://www.bra.se/extra/pod/?action=pod_show&#x00026;id=33&#x00026;module_instance=11"/></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adler</surname><given-names>H</given-names></name><name><surname>Frisk</surname><given-names>M</given-names></name><name><surname>Lidberg</surname><given-names>L</given-names></name></person-group><article-title>Severe delinquency in young people: Background factors and characterizing features.</article-title><source>Nordic Journal of Psychiatry</source><year>1995</year><volume>49</volume><fpage>263</fpage><lpage>274</lpage></citation></ref><ref id="B26"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hirschi</surname><given-names>T</given-names></name></person-group><source>Causes of delinquency</source><year>1974</year><publisher-name>Berkley , University of California Press</publisher-name></citation></ref><ref id="B27"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Martens</surname><given-names>PL</given-names></name></person-group><source>Familj, uppv&#x000e4;xt och brott [Family, environment and delinquency]</source><year>1992</year><publisher-name>Stockholm , Allm&#x000e4;nna F&#x000f6;rlaget/Kommentus</publisher-name></citation></ref><ref id="B28"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Loeber</surname><given-names>R</given-names></name><name><surname>Stouthamer-Loeber</surname><given-names>M</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Tonroy M, Morris N</surname></name></person-group><article-title>Family factors as correlates and prediktors of juvenile conduct problems and delinquency</article-title><source>Crime and Justice</source><year>1986</year><volume>7</volume><publisher-name>Chicago , Universtiy Chicago Press</publisher-name></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rutter</surname><given-names>M</given-names></name><name><surname>Maughan</surname><given-names>B</given-names></name><name><surname>Meyer</surname><given-names>J</given-names></name><name><surname>Pickles</surname><given-names>A</given-names></name><name><surname>Silberg</surname><given-names>J</given-names></name><name><surname>Simonoff</surname><given-names>E</given-names></name><name><surname>Taylor</surname><given-names>E</given-names></name></person-group><article-title>Heterogeneity of Antisocial Behavior: Causes, Continuities, and Consequences</article-title><source>Nebraska symposium on motivation</source><year>1997</year><volume>44</volume><fpage>45</fpage><lpage>118</lpage><pub-id pub-id-type="pmid">9385594</pub-id></citation></ref></ref-list></back></article>