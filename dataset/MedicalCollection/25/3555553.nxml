n="top" rowspan="1" colspan="1">Norman et al<xref ref-type="bibr" rid="b38-jpr-6-039">38</xref></td><td align="left" valign="top" rowspan="1" colspan="1">California, USA</td><td align="left" valign="top" rowspan="1" colspan="1">115 (63% male)</td><td align="left" valign="top" rowspan="1" colspan="1">36</td><td align="left" valign="top" rowspan="1" colspan="1">NR</td><td align="left" valign="top" rowspan="1" colspan="1">NR</td><td align="left" valign="top" rowspan="1" colspan="1">66% MVA; 5% burns; 6% falls; 4% occupational injuries; 3% recreational injuries (eg, jet skiing); 10% stab wounds; 10% gunshot wounds; 3% assault</td><td align="left" valign="top" rowspan="1" colspan="1">NR</td><td align="left" valign="top" rowspan="1" colspan="1">18</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Sanders et al<xref ref-type="bibr" rid="b40-jpr-6-039">40</xref></td><td align="left" valign="top" rowspan="1" colspan="1">London, Canada</td><td align="left" valign="top" rowspan="1" colspan="1">40 (85% male)</td><td align="left" valign="top" rowspan="1" colspan="1">29 (range 17&#x02013;65)</td><td align="left" valign="top" rowspan="1" colspan="1">NR</td><td align="left" valign="top" rowspan="1" colspan="1">NR</td><td align="left" valign="top" rowspan="1" colspan="1">72.5% MVA; 10% recreational/sports injuries; 17.5% falls</td><td align="left" valign="top" rowspan="1" colspan="1">Isolated diaphyseal fractures of the femur</td><td align="left" valign="top" rowspan="1" colspan="1">18</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Williamson et al<xref ref-type="bibr" rid="b43-jpr-6-039">43</xref></td><td align="left" valign="top" rowspan="1" colspan="1">Australia</td><td align="left" valign="top" rowspan="1" colspan="1">1290 (61% male)</td><td align="left" valign="top" rowspan="1" colspan="1">Range 14&#x02013;95</td><td align="left" valign="top" rowspan="1" colspan="1">7 (range 3&#x02013;13)</td><td align="left" valign="top" rowspan="1" colspan