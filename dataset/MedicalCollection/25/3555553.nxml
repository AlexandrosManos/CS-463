eft" valign="top" rowspan="1" colspan="1">Melbourne, Australia</td><td align="left" valign="top" rowspan="1" colspan="1">290 (75.9% male)</td><td align="left" valign="top" rowspan="1" colspan="1">NR</td><td align="left" valign="top" rowspan="1" colspan="1">10.8 (10.0)</td><td align="left" valign="top" rowspan="1" colspan="1">12.3 (SD = 8.5)</td><td align="left" valign="top" rowspan="1" colspan="1">57.6% MVA; 12.4% falls; 6.2% assaults</td><td align="left" valign="top" rowspan="1" colspan="1">Injuries occurred predominantly in the extremities and chest</td><td align="left" valign="top" rowspan="1" colspan="1">21</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Jenewein et al<xref ref-type="bibr" rid="b33-jpr-6-039">33</xref></td><td align="left" valign="top" rowspan="1" colspan="1">Zurich, Switzerland</td><td align="left" valign="top" rowspan="1" colspan="1">90</td><td align="left" valign="top" rowspan="1" colspan="1">41.9 (SD = 13.2)</td><td align="left" valign="top" rowspan="1" colspan="1">NR</td><td align="left" valign="top" rowspan="1" colspan="1">NR</td><td align="left" valign="top" rowspan="1" colspan="1">58.9% MVA; 21.1% sports and leisure-time accidents; 14.4% during employment; 5.6% household accidents</td><td align="left" valign="top" rowspan="1" colspan="1">NR</td><td align="left" valign="top" rowspan="1" colspan="1">23</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Mayou and Bryant<xref ref-type="bibr" rid="b35-jpr-6-039">35</xref></td><td align="left" valign="top" rowspan="1" colspan="1">Oxford, UK</td><td align="left" valign="top" rowspan="1" colspan="1">507 (55% male)</td><td align="left" valign="top" rowspan="1" colspan="1">Range 17&#x02013;69; 596 were under the age of 30; 552 were over the age of 30</td><td align="left" valign="top" rowspan="1" colspan="1">Not admitted or no injury = 905; admitted 1&#x02013;2 nights = 137; admitted 3+ nights = 106</td><td align="left" valign="top" rowspan="1" colspan="1">Range 0