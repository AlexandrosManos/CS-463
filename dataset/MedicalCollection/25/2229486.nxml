mes></name><name><surname>Brennan</surname><given-names>C.</given-names></name><name><surname>Nolte</surname><given-names>M.</given-names></name><name><surname>Kantrowitz</surname><given-names>E.R.</given-names></name></person-group><article-title>Kinetic and X-ray structural studies of three mutant <italic>E. coli</italic> alkaline phosphatasesinsights into the catalytic mechanism without the nucleophile Ser102</article-title><source>J. Mol. Biol.</source><volume>227</volume><year>1998</year><fpage>647</fpage><lpage>662</lpage><pub-id pub-id-type="pmid">9533886</pub-id></citation></ref><ref id="Stefanietal1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stefani</surname><given-names>E.</given-names></name><name><surname>Toro</surname><given-names>L.</given-names></name><name><surname>Perozo</surname><given-names>E.</given-names></name><name><surname>Bezanilla</surname><given-names>F.</given-names></name></person-group><article-title>Gating of Shaker K<sup>+</sup> channelsI. Ionic and gating currents</article-title><source>Biophys. J.</source><volume>66</volume><year>1994</year><fpage>996</fpage><lpage>1010</lpage><pub-id pub-id-type="pmid">8038403</pub-id></citation></ref><ref id="TangandPapazian1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tang</surname><given-names>C.-Y.</given-names></name><name><surname>Papazian</surname><given-names>D.M.</given-names></name></person-group><article-title>Transfer of voltage independence from a rat olfactory channel to the <italic>Drosophila</italic> ether-&#x000e0;-go-go K<sup>+</sup> channel</article-title><source>J. Gen. Physiol.</source><volume>109</volume><year>1997</year><fpage>301</fpage><lpage>311</lpage><pub-id pub-id-type="pmid">9089438</pub-id></citation></ref><ref id="Tangetal2000"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tang</surname><given-names>C.-Y.</given-names></name