/mml:mfrac>                                       <mml:mi>log</mml:mi>                                       <mml:mo>&#x02061;</mml:mo>                                       <mml:mo stretchy="false">(</mml:mo>                                       <mml:mn>2</mml:mn>                                       <mml:mi>&#x003c0;</mml:mi>                                       <mml:msubsup>                                          <mml:mi>&#x003c3;</mml:mi>                                          <mml:mrow>                                             <mml:mi>k</mml:mi>                                             <mml:mo>,</mml:mo>                                             <mml:mi>l</mml:mi>                                          </mml:mrow>                                          <mml:mn>2</mml:mn>                                       </mml:msubsup>                                       <mml:mo stretchy="false">)</mml:mo>                                       <mml:mo>&#x02212;</mml:mo>                                       <mml:msub>                                          <mml:mi>N</mml:mi>                                          <mml:mi>r</mml:mi>                                       </mml:msub>                                       <mml:mi>log</mml:mi>                                       <mml:mo>&#x02061;</mml:mo>                                       <mml:mi>P</mml:mi>                                       <mml:mo stretchy="false">(</mml:mo>                                       <mml:msub>                                          <mml:mover accent="true">                                             <mml:mi>r</mml:mi>                                             <mml:mo>&#x002dc;</mml:mo>                                          </mml:mover>                                          <mml:mi>i</mml:mi>                                       </mml:msub>                                       <mml:mo>=</mml:mo>                                       <mml:mi>k</mml:mi> 