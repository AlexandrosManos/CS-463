article-title>Activation of <italic>Shaker</italic> potassium channels III. An activation gating model for wild-type and V2 mutant channels</article-title><source>J. Gen. Physiol.</source><volume>111</volume><year>1998</year><fpage>313</fpage><lpage>342</lpage><pub-id pub-id-type="pmid">9450946</pub-id></citation></ref><ref id="SheetsandHanck1995"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sheets</surname><given-names>M.F.</given-names></name><name><surname>Hanck</surname><given-names>D.A.</given-names></name></person-group><article-title>Voltage-dependent open-state inactivation of cardiac sodium channelsgating current studies with Anthopleurin-A toxin</article-title><source>J. Gen. Physiol.</source><volume>106</volume><year>1995</year><fpage>617</fpage><lpage>640</lpage><pub-id pub-id-type="pmid">8576700</pub-id></citation></ref><ref id="Sheetsetal2000"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sheets</surname><given-names>M.F.</given-names></name><name><surname>Kyle</surname><given-names>J.W.</given-names></name><name><surname>Hanck</surname><given-names>D.A.</given-names></name></person-group><article-title>The role of the putative inactivation lid in sodium channel gating current immobilization</article-title><source>J. Gen. Physiol.</source><volume>115</volume><year>2000</year><fpage>609</fpage><lpage>619</lpage><pub-id pub-id-type="pmid">10779318</pub-id></citation></ref><ref id="Sheetsetal1999"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sheets</surname><given-names>M.F.</given-names></name><name><surname>Kyle</surname><given-names>J.W.</given-names></name><name><surname>Kallen</surname><given-names>R.G.</given-names></name><name><surname>Hanck</surname><given-names>D.A.</given-names></name></person-group><article-title>The Na channel voltage sensor associated with inactivation is localized to the external charged residues of domain IV, S4</article-title><source>Biophys. J.</source><volume>77</volume><year>1999</year><fpage>747</fpage><lpage>757</lpage><pub-id pub-id-type="pmid">10423423</pub-id></citation></ref><ref id="Sigworth1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sigworth</surname><given-names>F.J.</given-names></name></person-group><article-title>Voltage gating of ion channels</article-title><source>Q. Rev. Biophys.</source><volume>27</volume><year>1994</year><fpage>1</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">7520590</pub-id></citation></ref><ref id="Slatinetal1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Slatin</surname><given-names>S.L.</given-names></name><name><surname>Qiu</surname><given-names>X.-Q.</given-names></name><name><surname>Jakes</surname><given-names>K.S.</given-names></name><name><surname>Finkelstein</surname><given-names>A.</given-names></name></person-group><article-title>Identification of a translocated protein segment in a voltage-dependent channel</article-title><source>Nature.</source><volume>371</volume><year>1994</year><fpage>158</fpage><lpage>161</lpage><pub-id pub-id-type="pmid">7521016</pub-id></citation></ref><ref id="Smith-Maxwelletal1998b"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith-Maxwell</surname><given-names>C.J.</given-names></name><name><surname>Ledwell</surname><given-names>J.L.</given-names></name><name><surname>Aldrich</surname><given-names>R.W.</given-names></name></person-group><article-title>Role of the S4 in cooperativity of voltage-dependent potassium channel activation</article-title><source>J. Gen. Physiol.</source><volume>111</volume><year>1998</year><fpage>399</fpage><lpage>420</lpage>b<pub-id pub-id-type="pmid">9482708</pub-id></citation></ref><ref id="Smith-Maxwelletal1998a"><citation citation-type="journal"><person-group person-group-type="author"><name><surna