3</year><volume>136</volume><issue>6</issue><fpage>1778</fpage><lpage>1782</lpage><pub-id pub-id-type="pmid">23739915</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ascherio</surname><given-names>A</given-names></name><name><surname>Munger</surname><given-names>KL</given-names></name></person-group><article-title>Environmental risk factors for multiple sclerosis. Part I: the role of infection</article-title><source><italic>Annals of Neurology</italic></source><year>2007</year><volume>61</volume><issue>4</issue><fpage>288</fpage><lpage>299</lpage><pub-id pub-id-type="other">2-s2.0-34247590137</pub-id><pub-id pub-id-type="pmid">17444504</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ascherio</surname><given-names>A</given-names></name><name><surname>Munger</surname><given-names>KL</given-names></name></person-group><article-title>Environmental risk factors for multiple sclerosis. Part II: noninfectious factors</article-title><source><italic>Annals of Neurology</italic></source><year>2007</year><volume>61</volume><issue>6</issue><fpage>504</fpage><lpage>513</lpage><pub-id pub-id-type="other">2-s2.0-34447508481</pub-id><pub-id pub-id-type="pmid">17492755</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nylander</surname><given-names>A</given-names></name><name><surname>Hafler</surname><given-names>DA</given-names></name></person-group><article-title>Multiple sclerosis</article-title><source><italic>Journal of Clinical Investigation</italic></source><year>2012</year><volume>122</volume><issue>4</issue><fpage>1180</fpage><lpage>1188</lpage><pub-id pub-id-type="other">2-s2.0-84859724482</pub-id><pub-id pub-id-type="pmid">224666