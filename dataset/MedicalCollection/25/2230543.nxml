roup><article-title>Glutamic acid 113 serves as the retinylidene Schiff base counterion in bovine rhodopsin</article-title><source>Proc. Natl. Acad. Sci. USA.</source><volume>86</volume><year>1989</year><fpage>8309</fpage><lpage>8313</lpage><pub-id pub-id-type="pmid">2573063</pub-id></citation></ref><ref id="Schneideretal1939"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schneider</surname><given-names>E.E.</given-names></name><name><surname>Goodeve</surname><given-names>C.F.</given-names></name><name><surname>Lythgoe</surname><given-names>R.J.</given-names></name></person-group><article-title>The spectral variation of the photosensitivity of visual purple</article-title><source>Proc. R. Soc. Lond. A.</source><volume>170</volume><year>1939</year><fpage>102</fpage><lpage>112</lpage></citation></ref><ref id="Schoenleinetal1991"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schoenlein</surname><given-names>R.W.</given-names></name><name><surname>Peteanu</surname><given-names>L.A.</given-names></name><name><surname>Mathies</surname><given-names>R.A.</given-names></name><name><surname>Shank</surname><given-names>C.V.</given-names></name></person-group><article-title>The first step in visionfemtosecond isomerization of rhodopsin</article-title><source>Science.</source><volume>254</volume><year>1991</year><fpage>412</fpage><lpage>415</lpage><pub-id pub-id-type="pmid">1925597</pub-id></citation></ref><ref id="SengbuschandStieve1971"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sengbusch</surname><given-names>G.V.</given-names></name><name><surname>Stieve</surname><given-names>H.</given-names></name></person-group><article-title>Flash photolysis of rhodopsin. I. Measurements on bovine rod outer segments</article-title><source>Z. Naturforschung.</source><volume>26B</volume><year>1971</year><fpage>488</fpage><lpage>489</lpage></citation></ref><ref id="Sheetsetal1996"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sheets</surname><given-names>M.F.</given-names></name><name><surname>Kyle</surname><given-names>J.W.</given-names></name><name><surname>Krueger</surname><given-names>S.</given-names></name><name><surname>Hanck</surname><given-names>D.A.</given-names></name></person-group><article-title>Optimization of a mammalian expression system for the measurement of sodium channel gating currents</article-title><source>Am. J. Physiol.</source><volume>271</volume><year>1996</year><fpage>C1001</fpage><lpage>C1006</lpage><pub-id pub-id-type="pmid">8843731</pub-id></citation></ref><ref id="Shiehetal1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shieh</surname><given-names>T.</given-names></name><name><surname>Han</surname><given-names>M.</given-names></name><name><surname>Sakmar</surname><given-names>T.P.</given-names></name><name><surname>Smith</surname><given-names>S.O.</given-names></name></person-group><article-title>The steric trigger in rhodopsin activation</article-title><source>J. Mol. Biol.</source><volume>269</volume><year>1997</year><fpage>373</fpage><lpage>384</lpage><pub-id pub-id-type="pmid">9199406</pub-id></citation></ref><ref id="ShuklaandSullivan1998"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shukla</surname><given-names>P.</given-names></name><name><surname>Sullivan</surname><given-names>J.M.</given-names></name></person-group><article-title>Rhodopsin early receptor currents from fused giant cells expressing opsin</article-title><source>Invest. Ophthal. Vis. Sci.</source><volume>39</volume><year>1998</year><fpage>974a</fpage>(Abstr.)</citation></ref><ref id="SpalinkandStieve1980"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Spalink</surname><given-names>J.D.</given-names></name><name><surname>Stieve</surname><give