n-type="journal"><person-group person-group-type="author"><name><surname>Blostein</surname><given-names>R.</given-names></name><name><surname>Wilczynska</surname><given-names>A.</given-names></name><name><surname>Karlish</surname><given-names>S.J.D.</given-names></name><name><surname>Arg&#x000fc;ello</surname><given-names>J.M.</given-names></name><name><surname>Lingrel</surname><given-names>J.B</given-names></name></person-group><article-title>Evidence that Ser775 in the alpha subunit of the Na,K -ATPase is a residue in the cation binding pocket</article-title><source>J. Biol. Chem.</source><volume>272</volume><year>1997</year><fpage>24987</fpage><lpage>24993</lpage><pub-id pub-id-type="pmid">9312104</pub-id></citation></ref><ref id="N0x2efa740N0x3b25f80"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>B&#x000fc;hler</surname><given-names>R.</given-names></name><name><surname>St&#x000fc;rmer</surname><given-names>W.</given-names></name><name><surname>Apell</surname><given-names>H.-J.</given-names></name><name><surname>L&#x000e4;uger</surname><given-names>P.</given-names></name></person-group><article-title>Charge translocation by the Na,K -pumpI. K inetics of local field changes studied by time-resolved fluorescence measurements</article-title><source>J. Membr. Biol.</source><volume>121</volume><year>1991</year><fpage>141</fpage><lpage>161</lpage><pub-id pub-id-type="pmid">1652643</pub-id></citation></ref><ref id="DeWeer1992"><citation citation-type="book"><person-group person-group-type="author"><name><surname>De Weer</surname><given-names>P.</given-names></name></person-group><article-title>Cellular sodium&#x02013;potassium transport</article-title><person-group person-group-type="editor"><name><surname>Seldin</surname><given-names>D.W.</given-names></name><name><surname>Giebisch</surname><given-names>G.</given-names></name></person-group><source>The K idneyPhysiology and Pathophysiology</source><year>1992</year><fpage>93<