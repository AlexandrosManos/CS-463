tion publication-type="journal"><person-group person-group-type="author"><name><surname>Qaseem</surname><given-names>A</given-names></name><name><surname>Wilt</surname><given-names>TJ</given-names></name><name><surname>Weinberger</surname><given-names>SE</given-names></name><etal/></person-group><article-title>Diagnosis and management of stable chronic obstructive pulmonary disease: a clinical practice guideline update from the American College of Physicians, American College of Chest Physicians, American Thoracic Society, and European Respiratory Society</article-title><source>Ann Intern Med</source><year>2011</year><volume>155</volume><issue>3</issue><fpage>179</fpage><lpage>91</lpage><pub-id pub-id-type="pmid">21810710</pub-id></element-citation></ref><ref id="b17-dic.212243"><label>17.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jones</surname><given-names>PW</given-names></name><name><surname>Mahler</surname><given-names>DA</given-names></name><name><surname>Gale</surname><given-names>R</given-names></name><name><surname>Owen</surname><given-names>R</given-names></name><name><surname>Kramer</surname><given-names>B</given-names></name></person-group><article-title>Profiling the effects of indacaterol on dyspnoea and health status in patients with COPD</article-title><source>Respir Med</source><year>2011</year><volume>105</volume><fpage>892</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">21397482</pub-id></element-citation></ref><ref id="b18-dic.212243"><label>18.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Celli</surname><given-names>BR</given-names></name><name><surname>MacNee</surname><given-names>W</given-names></name></person-group><article-title>Standards for the diagnosis and treatment of patients with COPD: a summary of the ATS/ERS position paper</article-title><source>Eur Respir J</source><year>2004</year><volume>23</volume><f