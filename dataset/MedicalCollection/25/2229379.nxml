/volume><fpage>64</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">7708483</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>LK</given-names></name><name><surname>Boron</surname><given-names>WF</given-names></name></person-group><article-title>Acid extrusion in S3 segment  of rabbit proximal tubule I. Effect of bilateral CO<sub>2</sub>/HCO<sub>3</sub><sup>&#x02212;</sup></article-title><source>Am  J Physiol</source><year>1995a</year><volume>268</volume><fpage>F179</fpage><lpage>F192</lpage><pub-id pub-id-type="pmid">7864155</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>LK</given-names></name><name><surname>Boron</surname><given-names>WF</given-names></name></person-group><article-title>Acid extrusion in S3 segment  of rabbit proximal tubule. II. Effect of basolateral CO<sub>2</sub>/HCO<sub>3</sub><sup>&#x02212;</sup></article-title><source>Am J Physiol</source><year>1995b</year><volume>268</volume><fpage>F193</fpage><lpage>F203</lpage><pub-id pub-id-type="pmid">7864156</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chesler</surname><given-names>M</given-names></name></person-group><article-title>The regulation and modulation of pH in the nervous system</article-title><source>Prog Neurobiol (Oxf)</source><year>1990</year><volume>34</volume><fpage>401</fpage><lpage>427</lpage><pub-id pub-id-type="pmid">2192394</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chesler</surname><given-names>M</given-names></name><name><surname>Kaila</surname><given-names>K</given-names></name></person-group><article-title>Modulation of pH by neuronal activity</article-title><source>TINS (Trends Neurosci)</source><y