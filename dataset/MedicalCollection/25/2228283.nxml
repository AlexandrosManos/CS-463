<ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rampp</surname><given-names>M</given-names><suffix>Soddemann T, Lederer H.</suffix></name></person-group><article-title>The MIGenAS integrated bioinformatics toolkit for web-based sequence analysis</article-title><source>Nucleic Acids Research</source><year>2006</year><volume>1</volume><fpage>5</fpage><lpage>9</lpage></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shah</surname><given-names>SP</given-names></name><name><surname>He</surname><given-names>DY</given-names></name><name><surname>Sawkins</surname><given-names>JN</given-names></name><name><surname>Druce</surname><given-names>JC</given-names></name><name><surname>Quon</surname><given-names>G</given-names></name><name><surname>Lett</surname><given-names>D</given-names></name><name><surname>Zheng</surname><given-names>GX</given-names></name><name><surname>Xu</surname><given-names>T</given-names></name><name><surname>Ouellette</surname><given-names>BF</given-names></name></person-group><article-title>Pegasys: software for executing and integrating analyses of biological sequences</article-title><source>BMC Bioinformatics</source><year>2004</year><volume>5</volume><fpage>40</fpage><pub-id pub-id-type="pmid">15096276</pub-id><pub-id pub-id-type="doi">10.1186/1471-2105-5-40</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stevens</surname><given-names>RD</given-names></name><name><surname>Robinson</surname><given-names>AJ</given-names></name><name><surname>Goble</surname><given-names>CA</given-names></name></person-group><article-title>myGrid: personalised bioinformatics on the information grid</article-title><source>Bioinformatics (Oxford, England)</source><year>2003</year><volume>19 Suppl 1</volume><fpage>i302</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">12855473</pub-id><pub-id pub-id-type="doi">10.1093/bioinformatics/btg1041</pub-id></citation></ref><ref id="B24"><citation citation-type="other"><person-group person-group-type="author"><collab>SciTegic</collab></person-group><article-title>SciTegic - PP Overview</article-title><ext-link ext-link-type="uri" xlink:href="http://www.scitegic.com/products/overview/"/></citation></ref><ref id="B25"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Angiuol</surname><given-names>SV</given-names></name></person-group><article-title>Workflow / Ergatis: A Data Management System for Automated Genome Annotation and Comparative Analysis (poster)</article-title><source>Genome Informatics 2005 (Cold Spring Harbor Laboratory, New York)</source><year>2006</year><fpage>Poster</fpage></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hoon</surname><given-names>S</given-names></name><name><surname>Ratnapu</surname><given-names>KK</given-names></name><name><surname>Chia</surname><given-names>JM</given-names></name><name><surname>Kumarasamy</surname><given-names>B</given-names></name><name><surname>Juguang</surname><given-names>X</given-names></name><name><surname>Clamp</surname><given-names>M</given-names></name><name><surname>Stabenau</surname><given-names>A</given-names></name><name><surname>Potter</surname><given-names>S</given-names></name><name><surname>Clarke</surname><given-names>L</given-names></name><name><surname>Stupka</surname><given-names>E</given-names></name></person-group><article-title>Biopipe: a flexible framework for protocol-based bioinformatics analysis</article-title><source>Genome Res</source><year>2003</year><volume>13</volume><fpage>1904</fpage><lpage>1915</lpage><pub-id pub-id-type="pmid">12869579</pub-id></citation></ref><ref id="B27"><citation citation-type="other"><article-title>SCIRun - SCI Software - Scientific Computing and Imaging Institute</article-title><ext-link ext-link-type="uri" xlink:href="http://software.sci.utah.edu/scirun.html"/></citation></ref><ref id="B28"><citation citation-type="other"><article-title>Data mining, Clementine, Predictive Modeling, Predictive Analytics, Predictive Analysis</article-title><ext-link ext-link-type="uri" xlink:href="http://www.spss.com/clementine"/></citation></ref></ref-list></back></article>