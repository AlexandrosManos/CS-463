lay1987"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Findlay</surname><given-names>I.</given-names></name></person-group><article-title>The effects of magnesium upon adenosine trisphosphate-sensitive potassium channels in rat insulin-secreting cell line</article-title><source>J. Physiol.</source><volume>391</volume><year>1987</year><fpage>611</fpage><lpage>629</lpage><pub-id pub-id-type="pmid">2451014</pub-id></citation></ref><ref id="Furukawaetal1996"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Furukawa</surname><given-names>T.</given-names></name><name><surname>Yamane</surname><given-names>T.-I.</given-names></name><name><surname>Terai</surname><given-names>T.</given-names></name><name><surname>Katayama</surname><given-names>Y.</given-names></name><name><surname>Hiraoka</surname><given-names>M.</given-names></name></person-group><article-title>Functional linkage of the cardiac ATP-sensitive K<sup>+</sup> channel to the actin cytoskeleton</article-title><source>Pfl&#x000fc;gers Arch</source><volume>431</volume><year>1996</year><fpage>504</fpage><lpage>512</lpage></citation></ref><ref id="Gillisetal1989"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gillis</surname><given-names>K.D.</given-names></name><name><surname>Gee</surname><given-names>W.M.</given-names></name><name><surname>Hammoud</surname><given-names>A.</given-names></name><name><surname>McDaniel</surname><given-names>M.L.</given-names></name><name><surname>Falke</surname><given-names>L.C.</given-names></name><name><surname>Misler</surname><given-names>S.</given-names></name></person-group><article-title>Effects of sulfonamides on a metabolite-regulated ATP<sub>i</sub>-sensitive K<sup>+</sup> channel in rat pancreatic B-cells</article-title><source>Am. J. Physiol. Cell Physiol.</source><volume>257</volume><year>1989</year><fpage>C1119</fpage><lpage>C1127</lpage></citation