citation publication-type="journal"><name><surname>Morris</surname><given-names>CG</given-names></name><name><surname>Safranek</surname><given-names>S</given-names></name><article-title>Is sputum evaluation useful for patients with community-acquired pneumonia?</article-title><source>Fam Pract</source><year>2005</year><volume>54</volume><fpage>279</fpage><lpage>280</lpage></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><name><surname>Bartlett</surname><given-names>JG</given-names></name><article-title>Diagnostic test for etiologic agents of community-acquired pneumonia</article-title><source>Infect Dis Clin North Am</source><year>2004</year><volume>18</volume><fpage>809</fpage><lpage>827</lpage><pub-id pub-id-type="doi">10.1016/j.idc.2004.08.002</pub-id><pub-id pub-id-type="pmid">15555826</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="other"><collab>National statistics instutude. Health statistics</collab><comment><ext-link ext-link-type="uri" xlink:href="http://www.turkstat.gov.tr/VeriBilgi.do?tb_id=6&#x00026;ust_id=1">http://www.turkstat.gov.tr/VeriBilgi.do?tb_id = 6&#x00026;ust_id = 1</ext-link> (last accessed 01.03.2009)</comment></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Bircan</surname><given-names>A</given-names></name><name><surname>Kaya</surname><given-names>O</given-names></name><name><surname>Gok&#x00131;rmak</surname><given-names>M</given-names></name><name><surname>Ozturk</surname><given-names>O</given-names></name><name><surname>Sahin</surname><given-names>U</given-names></name><name><surname>Akkaya</surname><given-names>A</given-names></name><article-title>C-reactive protein, leukocyte count and ESR in the assessment of severity of community-acquired pneumonia</article-title><source>Tubercl Toraks</source><year>2006</year><volume>54</volume><fpage>22</fpage><lpage>29</lpage></mixed-citation></ref><ref id="B14"><mixed-citation publication