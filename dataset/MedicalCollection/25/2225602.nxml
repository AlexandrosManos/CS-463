><tr><td align="left">Three ligands</td><td/><td>&#x02014;</td><td/><td align="left">38</td><td/><td align="left">&#x000a0;78</td><td/><td align="left">&#x000a0;112</td><td/><td align="left">&#x000a0;702</td><td/><td align="left">&#x000a0;106</td><td/><td align="left">&#x000a0;&#x000a0;&#x000a0;7</td><td/><td align="left">&#x000a0;759</td><td/><td align="left">&#x000a0;&#x000a0;95</td><td/><td align="left">&#x000a0;&#x000a0;&#x000a0;9</td><td/><td>&#x02014;</td><td/><td align="left">&#x000a0;&#x000a0;41</td><td/><td align="left">&#x000a0;&#x000a0;4</td><td/><td>&#x02014;</td><td/><td align="left">&#x000a0;&#x000a0;33</td><td/><td align="left">&#x000a0;34</td><td/><td>&#x02014;</td></tr><tr><td align="left"/><td/><td>&#x02014;</td><td/><td align="left">&#x000a0;3</td><td/><td align="left">&#x000a0;52</td><td/><td align="left">&#x000a0;&#x000a0;98</td><td/><td align="left">&#x000a0;920</td><td/><td align="left">&#x000a0;263</td><td/><td align="left">&#x000a0;&#x000a0;91</td><td/><td align="left">1415</td><td/><td align="left">&#x000a0;502</td><td/><td align="left">&#x000a0;690</td><td/><td>&#x02014;</td><td/><td align="left">&#x000a0;145</td><td/><td align="left">586</td><td/><td>&#x02014;</td><td/><td align="left">&#x000a0;&#x000a0;63</td><td/><td align="left">&#x000a0;12</td><td/><td>&#x02014;</td></tr><tr><td align="left"><italic>K</italic><sub>eq</sub></td><td/><td>&#x02014;</td><td/><td align="left">13</td><td/><td align="left">&#x000a0;&#x000a0;1.5</td><td/><td align="left">&#x000a0;&#x000a0;&#x000a0;1.1</td><td/><td align="left">&#x000a0;&#x000a0;&#x000a0;0.8</td><td/><td align="left">&#x000a0;&#x000a0;&#x000a0;0.4</td><td/><td align="left">&#x000a0;&#x000a0;&#x000a0;0.08</td><td/><td align="left">&#x000a0;&#x000a0;&#x000a0;0.5</td><td/><td align="left">&#x000a0;&#x000a0;&#x000a0;0.2</td><td/><td align="left">&#x000a0;&#x000a0;&#x000a0;0.01</td><td/><td>&#x02014;</td><td/><td align="left">&#x000a0;&#x000a0;&#x000a0;0.3</td><td/><td align="left">&#x000a0;&#x000a