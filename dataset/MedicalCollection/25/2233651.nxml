>2</sub></td><td align="left"><inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M74" name="1471-2105-8-413-i14" overflow="scroll"><mml:semantics definitionURL="" encoding=""><mml:mi mathvariant="double-struck">S</mml:mi><mml:annotation encoding="MathType-MTEF"> MathType@MTEF@5@5@+=feaafiart1ev1aaatCvAUfKttLearuWrP9MDH5MBPbIqV92AaeXatLxBI9gBaebbnrfifHhDYfgasaacH8akY=wiFfYdH8Gipec8Eeeu0xXdbba9frFj0=OqFfea0dXdd9vqai=hGuQ8kuc9pgc9s8qqaq=dirpe0xb9q8qiLsFr0=vr0=vr0dc8meaabaqaciaacaGaaeqabaqabeGadaaakeaatuuDJXwAK1uy0HMmaeHbfv3ySLgzG0uy0HgiuD3BaGabaiab=jj8tbaa@38A8@</mml:annotation></mml:semantics></mml:math></inline-formula> = {<italic>S</italic><sub><italic>A</italic></sub>, <italic>S</italic><sub><italic>B</italic>2</sub>, <italic>S</italic><sub><italic>E</italic>2</sub>}</td></tr><tr><td></td><td align="left"><inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M75" name="1471-2105-8-413-i14" overflow="scroll"><mml:semantics definitionURL="" encoding=""><mml:mi mathvariant="double-struck">S</mml:mi><mml:annotation encoding="MathType-MTEF"> MathType@MTEF@5@5@+=feaafiart1ev1aaatCvAUfKttLearuWrP9MDH5MBPbIqV92AaeXatLxBI9gBaebbnrfifHhDYfgasaacH8akY=wiFfYdH8Gipec8Eeeu0xXdbba9frFj0=OqFfea0dXdd9vqai=hGuQ8kuc9pgc9s8qqaq=dirpe0xb9q8qiLsFr0=vr0=vr0dc8meaabaqaciaacaGaaeqabaqabeGadaaakeaatuuDJXwAK1uy0HMmaeHbfv3ySLgzG0uy0HgiuD3BaGabaiab=jj8tbaa@38A8@</mml:annotation></mml:semantics></mml:math></inline-formula> = {<italic>S</italic><sub><italic>A</italic></sub>, <italic>S</italic><sub><italic>B</italic>2</sub>, <italic>S</italic><sub><italic>C</italic>2</sub>, <italic>S</italic><sub><italic>F</italic>1</sub>, <italic>S</italic><sub><italic>G</italic>1</sub>}</td></tr><tr><td align="center"><italic>S</italic><sub><italic>C</italic>1</sub></td><td align="left"><inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M76" name="1471-2105-8-413-i14" overflow="scroll"><mml:semantics definitionURL="" encoding=""><mml:mi 