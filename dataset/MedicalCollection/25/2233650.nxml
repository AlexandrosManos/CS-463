                                       <mml:mo stretchy="false">)</mml:mo>                                          <mml:mo>+</mml:mo>                                          <mml:mfrac>                                             <mml:mn>1</mml:mn>                                             <mml:mn>2</mml:mn>                                          </mml:mfrac>                                          <mml:mi>f</mml:mi>                                          <mml:mi>r</mml:mi>                                          <mml:mo stretchy="false">(</mml:mo>                                          <mml:mi>a</mml:mi>                                          <mml:mo>|</mml:mo>                                          <mml:mi>m</mml:mi>                                          <mml:mo>,</mml:mo>                                          <mml:mi>&#x003c9;</mml:mi>                                          <mml:mo stretchy="false">)</mml:mo>                                       </mml:mrow>                                    </mml:mtd>                                 </mml:mtr>                                 <mml:mtr columnalign="left">                                    <mml:mtd columnalign="left">                                       <mml:mrow>                                          <mml:mo>=</mml:mo>                                          <mml:mfrac>                                             <mml:mn>1</mml:mn>                                             <mml:mn>2</mml:mn>                                          </mml:mfrac>                                          <mml:mstyle displaystyle="true">                                             <mml:munder>                                                <mml:mo>&#x02211;</mml:mo>                                                <mml:mrow>                                                   <mml:mi>b</mml:mi>                                                   <mml:mo>&#x02208;</mml:mo>                                    