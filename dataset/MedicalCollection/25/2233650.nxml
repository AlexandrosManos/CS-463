                         <mml:mi>f</mml:mi>                                       <mml:mi>r</mml:mi>                                       <mml:mo stretchy="false">(</mml:mo>                                       <mml:mo>{</mml:mo>                                       <mml:mi>a</mml:mi>                                       <mml:mo>,</mml:mo>                                       <mml:mi>b</mml:mi>                                       <mml:mo>}</mml:mo>                                       <mml:mo>|</mml:mo>                                       <mml:mo>{</mml:mo>                                       <mml:mi>c</mml:mi>                                       <mml:mo>,</mml:mo>                                       <mml:mo>&#x02205;</mml:mo>                                       <mml:mo>}</mml:mo>                                       <mml:mo stretchy="false">)</mml:mo>                                       <mml:mo>=</mml:mo>                                       <mml:mfrac>                                          <mml:mrow>                                             <mml:mo stretchy="false">(</mml:mo>                                             <mml:mn>1</mml:mn>                                             <mml:mo stretchy="false">(</mml:mo>                                             <mml:mi>c</mml:mi>                                             <mml:mo>=</mml:mo>                                             <mml:mi>a</mml:mi>                                             <mml:mo stretchy="false">)</mml:mo>                                             <mml:mo>+</mml:mo>                                             <mml:mn>1</mml:mn>                                             <mml:mo stretchy="false">(</mml:mo>                                             <mml:mi>c</mml:mi>                                             <mml:mo>=</mml:mo>                                             <mml:mi>b</mml:mi>                                             <mml:mo stretchy="false">)</mml:mo>                                             <mml:mo stretchy="false">)</mml:mo>                                             <mml:mi>f</mml:mi>                                             <mml:mi>r</mml:mi>                                             <mml:mo stretchy="false">(</mml:mo>                                             <mml:mo>{</mml:mo>                                             <mml:mi>a</mml:mi>                                             <mml:mo>,</mml:mo>                                             <mml:mi>b</mml:mi>                                             <mml:mo>}</mml:mo>                                             <mml:mo stretchy="false">)</mml:mo>                                          </mml:mrow>                                          <mml:mrow>                                             <mml:mn>2</mml:mn>                                             <mml:mi>f</mml:mi>                                             <mml:mi>r</mml:mi>                                             <mml:mo stretchy="false">(</mml:mo>                                             <mml:mo>{</mml:mo>                                             <mml:mi>c</mml:mi>                                             <mml:mo>,</mml:mo>                                             <mml:mo>&#x02205;</mml:mo>                                             <mml:mo>}</mml:mo>                                             <mml:mo stretchy="false">)</mml:mo>                                          </mml:mrow>                                       </mml:mfrac>                                    </mml:mrow>                                 </mml:mtd>                              </mml:mtr>                              <mml:mtr>                                 <mml:mtd>                                    <mml:mrow>                                       <mml:mi>f</mml:mi>                                       <mml:mi>r</mml:mi>                                       <mml:mo stretchy="false">(</mml:mo>                                       <mml:mo>{</mml:mo>                                       <mml:mi>a</mml:mi>                                       <mml:mo>,</mml:mo>                                       <mml:mi>b</mml:mi>                                       <mml:mo>}</mml:mo>                                       <mml:mo>|</mml:mo>                                       <mml:mo>{</mml:mo>                                       <mml:mi>c</mml:mi>                                       <mml:mo>,</mml:mo>                                       <mml:mi>d</mml:mi>                                       <mml:mo>}</mml:mo>                                       <mml:mo stretchy="false">)</mml:mo>                                       <mml:mo>=</mml:mo>                                       <mml:mn>1</mml:mn>                                       <mml:mo stretchy="false">(</mml:mo>                                       <mml:mi>a</mml:mi>                                       <mml:mo>=</mml:mo>                                       <mml:mi>c</mml:mi>                                       <mml:mo stretchy="false">)</mml:mo>                                       <mml:mn>1</mml:mn>                                       <mml:mo stretchy="false">(</mml:mo>                                       <mml:mi>b</mml:mi>                                       <mml:mo>=</mml:mo>                                       <mml:mi>d</mml:mi>                                       <mml:mo stretchy="false">)</mml:mo>                                       <mml:mo>+1</mml:mo>                                       <mml:mo stretchy="false">(</mml:mo>                                       <mml:mi>a</mml:mi>                                       <mml:mo>&#x02260;</mml:mo>                                       <mml:mi>b</mml:mi>                                       <mml:mo stretchy="false">)</mml:mo>                                       <mml:mn>1</mml:mn>                                       <mml:mo stretchy="false">(</mml:mo>                                       <mml:mi>a</mml:mi>                                       <mml:mo>=</mml:mo>                                       <mml:mi>d</mml:mi>                                       <mml:mo stretchy="false">)</mml:mo>                                       <mml:mn>1</mml:mn>                                       <mml:mo stretchy="false">(</mml:mo>                                       <mml:mi>b</mml:mi>                                       <mml:mo>=</mml:mo>                                       <mml:mi>c</mml:mi>                                       <mml:mo stretchy="false">)</mml:mo>                                       <mml:mo>.</mml:mo>                                    </mml:mrow>                                 </mml:mtd>                              </mml:mtr>                           </mml:mtable>                        </mml:mrow>                                             </mml:semantics>                  </mml:math></disp-formula></p><p>After choosing parents <italic>f </italic>and <italic>m</italic>, child <italic>k </italic>transmits his/her alleles to them. For that, let us consider the assignment of phase. Let <italic>g</italic><sub><italic>f</italic></sub>(<italic>l</italic>) = {<italic>a</italic>, <italic>b</italic>} and <italic>g</italic><sub><italic>m</italic></sub>(<italic>l</italic>) = {<italic>c</italic>, <italic>d</italic>} be the current values of the genotypes of the chosen parents with <italic>a</italic>, <italic>b</italic>, <italic>c</italic>, <italic>d </italic>&#x02208; <italic>E</italic><sub><italic>l </italic></sub>&#x0222a; {&#x02205;}, and let {<italic>x</italic>, <italic>y</italic>} be the genotype of the child. When <italic>a</italic>, <italic>b</italic>, <italic>c</italic>, <italic>d </italic>&#x02208; <italic>E</italic><sub><italic>l </italic></sub>are already determined, we have</p><p><disp-formula id="bmcM10"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M134" name="1471-2105-8-411-i65" overflow="scroll">                     <mml:semantics>                        <mml:mrow>                           <mml:mtable columnalign="left">                              <mml:mtr columnalign="left">                                 <mml:mtd columnalign="left">                                    <mml:mrow>                                       <mml:mi>P</mml:mi>                                       <mml:mo stretchy="false">(</mml:mo>                                       <mml:mi>x</mml:mi>                                       <mml:mtext>&#x000a0;paternal</mml:mtext>                                       <mml:mo>,</mml:mo>                                       <mml:mi>y</mml:mi>                                       <mml:mtext>&#x000a0;maternal</mml:mtext>                                       <mml:mo>|</mml:mo>                                       <mml:msub>                                          <mml:mi>g</mml:mi>                                          <mml:mi>k</mml:mi>                                       </mml:msub>                                       <mml:mo stretchy="false">(</mml:mo>                                       <mml:mi>l</mml:mi>                                       <mml:mo stretchy="false">)</mml:mo>                                       <mml:mo>=</mml:mo>                                       <mml:mo>{</mml:mo>                                       <mml:mi>x</mml:mi>                                       <mml:mo>,</mml:mo>                                       <mml:mi>y</mml:mi>                                       <mml:mo>}</mml:mo>                                       <mml:mo>,</mml:mo>                                       <mml:msub>                                          <mml:mi>g</mml:mi>                                          <mml:mi>f</mml:mi>                                       </mml:msub>                                       <mml:mo stretchy="false">(</mml:mo>                                       <mml:mi>l</mml:mi>                                       <mml:mo stretchy="false">)</mml:mo>                                       <mml:mo>=</mml:mo>                                       <mml:mo>{</mml:mo>                                       <mml:mi>a</mml:mi>                                       <mml:mo>,</mml:mo>                                       <mml:mi>b</mml:mi>                                       <mml:mo>}</mml:mo>                                       <mml:mo>,</mml:mo>                                       <mml:msub>                                          <mml:mi>g</mml:mi>                                          <mml:mi>m</mml:mi>                                       </mml:msub>                                       <mml:mo stretchy="false">(</mml:mo>                                       <mml:mi>l</mml:mi>                                       <mml:mo stretchy="false">)</mml:mo>                                       <mml:mo>=</mml:mo>                                       <mml:mo>{</mml:mo>                                       <mml:mi>c</mml:mi>                                       <mml:mo>,</mml:mo>                                       <mml:mi>d</mml:mi>                                       <mml:mo>}</mml:mo>                                       <mml:mo stretchy="false">)</mml:mo>                                    </mml:mrow>                                 </mml:mtd>                              </mml:mtr>                              <mml:mtr columnalign="left">                                 <mml:mtd columnalign="left">                                    <mml:mrow>                                       <mml:mo>=</mml:mo>                                       <mml:mfrac>                                          <mml:mrow>                                             <mml:mi>P</mml:mi>                                             <mml:mo stretchy="false">(</mml:mo>                                        