      <mml:msub>                                                      <mml:mi>g</mml:mi>                                                      <mml:mi>k</mml:mi>                                                   </mml:msub>                                                   <mml:mo stretchy="false">(</mml:mo>                                                   <mml:mi>l</mml:mi>                                                   <mml:mo stretchy="false">)</mml:mo>                                                   <mml:mo>=</mml:mo>                                                   <mml:mo>{</mml:mo>                                                   <mml:mi>x</mml:mi>                                                   <mml:mo>,</mml:mo>                                                   <mml:mi>y</mml:mi>                                                   <mml:mo>}</mml:mo>                                                   <mml:mo>|</mml:mo>                                                   <mml:msub>                                                      <mml:mi>g</mml:mi>                                                      <mml:mi>f</mml:mi>                                                   </mml:msub>                                                   <mml:mo stretchy="false">(</mml:mo>                                                   <mml:mi>l</mml:mi>                                                   <mml:mo stretchy="false">)</mml:mo>                                                   <mml:mo>=</mml:mo>                                                   <mml:mo>{</mml:mo>                                                   <mml:msup>                                                      <mml:mi>a</mml:mi>                                                      <mml:mo>&#x02032;</mml:mo>                                                   </mml:msup>                                                   <mml:mo>,</mml:mo>                                                   <mml:msup>                                                      <mml:mi>b</mml:mi>                                                      <mml:mo>&#x02032;</mml:mo>                                                   </mml:msup>                                                   <mml:mo>}</mml:mo>                                                   <mml:mo>,</mml:mo>                                                   <mml:msub>                                                      <mml:mi>g</mml:mi>                                                      <mml:mi>m</mml:mi>                                                   </mml:msub>                                                   <mml:mo stretchy="false">(</mml:mo>                                                   <mml:mi>l</mml:mi>                                                   <mml:mo stretchy="false">)</mml:mo>                                                   <mml:mo>=</mml:mo>                                                   <mml:mo>{</mml:mo>                                                   <mml:msup>                                                      <mml:mi>c</mml:mi>                                                      <mml:mo>&#x02032;</mml:mo>                                                   </mml:msup>                                                   <mml:mo>,</mml:mo>                                                   <mml:msup>                                                      <mml:mi>d</mml:mi>                                                      <mml:mo>&#x02032;</mml:mo>                                                   </mml:msup>                                                   <mml:mo>}</mml:mo>                                                   <mml:mo stretchy="false">)</mml:mo>                                                   <mml:mo>&#x000d7;</mml:mo>                                                </mml:mrow>                                             </mml:mrow>                                          </mml:mrow>                                       </mml:mstyle>                                    </mml:mrow>                                 </mml:mtd>                              </mml:mtr>                              <mml:mtr columnalign="left">                                 <mml:mtd columnalign="left">                                    <mml:mrow/>                                 </mml:mtd>                                 <mml:mtd columnalign="left">                                    <mml:mrow>                                       <mml:mrow>                                          <mml:mrow>                                             <mml:mi>f</mml:mi>                                             <mml:mi>r</mml:mi>                                             <mml:mo stretchy="false">(</mml:mo>                                             <mml:mo>{</mml:mo>                                             <mml:msup>                                                <mml:mi>a</mml:mi>                                                <mml:mo>&#x02032;</mml:mo>                                             </mml:msup>                                             <mml:mo>,</mml:mo>                                             <mml:msup>                                                <mml:mi>b</mml:mi>                                                <mml:mo>&#x02032;</mml:mo>                                             </mml:msup>                                             <mml:mo>}</mml:mo>                                             <mml:mo>|</mml:mo>                                             <mml:mo>{</mml:mo>                                             <mml:mi>a</mml:mi>                                             <mml:mo>,</mml:mo>                                             <mml:mi>b</mml:mi>                                             <mml:mo>}</mml:mo>                                             <mml:mo stretchy="false">)</mml:mo>                                             <mml:mtext>&#x000a0;</mml:mtext>                                             <mml:mi>f</mml:mi>                                             <mml:mi>r</mml:mi>                                             <mml:mo stretchy="false">(</mml:mo>                                             <mml:mo>{</mml:mo>                                             <mml:msup>                                                <mml:mi>c</mml:mi>                                                <mml:mo>&#x02032;</mml:mo>                                             </mml:msup>                                             <mml:mo>,</mml:mo>                                             <mml:msup>                                                <mml:mi>d</mml:mi>                                                <mml:mo>&#x02032;</mml:mo>                                             </mml:msup>                                             <mml:mo>}</mml:mo>                                             <mml:mo>|</mml:mo>                                             <mml:mo>{</mml:mo>                                             <mml:mi>c</mml:mi>                                             <mml:mo>,</mml:mo>                                             <mml:mi>d</mml:mi>                                             <mml:mo>}</mml:mo>                                             <mml:mo stretchy="false">)</mml:mo>                                          </mml:mrow>                                          <mml:mo>}</mml:mo>                                       </mml:mrow>                                       <mml:mo>,</mml:mo>                                       <mml:mtext>&#x000a0;</mml:mtext>                                       <mml:mi>x</mml:mi>                                       <mml:mo>,</mml:mo>                                       <mml:mi>y</mml:mi>                                       <mml:mo>&#x02208;</mml:mo>                                       <mml:msub>                                          <mml:mi>E</mml:mi>                                          <mml:mi>l</mml:mi>                                       </mml:msub>                                       <mml:mo>,</mml:mo>                                       <mml:mtext>&#x000a0;</mml:mtext>                                       <mml:mi>a</mml:mi>                                       <mml:mo>,</mml:mo>                                       <mml:mi>b</mml:mi>                                       <mml:mo>,</mml:mo>                                       <mml:mi>c</mml:mi>                                       <mml:mo>,</mml:mo>                                       <mml:mi>d</mml:mi>                                       <mml:mo>&#x02208;</mml:mo>                                       <mml:msub>                                          <mml:mi>E</mml:mi>                                          <mml:mi>l</mml:mi>                                       </mml:msub>                                       <mml:mo>&#x0222a;</mml:mo>                                       <mml:mo>{</mml:mo>                                       <mml:mo>&#x02205;</mml:mo>                                       <mml:mo>}</mml:mo>                                       <mml:mo>,</mml:mo>                                    </mml:mrow>                                 </mml:mtd>                              </mml:mtr>                           </mml:mtable>                        </mml:mrow>                                             </mml:semantics>                  </mml:math></disp-formula></p><p>where for <italic>a</italic>, <italic>b</italic>, <italic>c</italic>, <italic>d </italic>&#x02208; <italic>E</italic><sub><italic>l</italic></sub>, we define the conditional population genotype frequencies as</p><p><disp-formula id="bmcM9"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M133" name="1471-2105-8-411-i64" overflow="scroll">                     <mml:semantics>                        <mml:mrow>   