e-title><source>Hum. Brain Mapp</source><year>2000</year><volume>17</volume><fpage>143</fpage><lpage>155</lpage><pub-id pub-id-type="pmid">12391568</pub-id></element-citation></ref><ref id="b18"><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Talairach</surname><given-names>J</given-names></name><name><surname>Tournoux</surname><given-names>P</given-names></name></person-group><source>Co-planar stereotactic atlas of the human brain</source><year>1988</year><publisher-loc>Stuttgart, Germany</publisher-loc><publisher-name>Thieme Verlag</publisher-name></element-citation></ref></ref-list></back></article>