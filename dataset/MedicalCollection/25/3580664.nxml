e><given-names>L</given-names></name><name><surname>Barie</surname><given-names>P</given-names></name><article-title>Accuracy of short-duration creatinine clearance determinations in predicting 24-hour creatinine clearance in critically ill and injured patients</article-title><source>J Trauma</source><year>2002</year><volume>53</volume><fpage>267</fpage><lpage>271</lpage><pub-id pub-id-type="doi">10.1097/00005373-200208000-00013</pub-id><pub-id pub-id-type="pmid">12169932</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Herrera-Gutierrez</surname><given-names>ME</given-names></name><name><surname>Seller-Perez</surname><given-names>G</given-names></name><name><surname>Banderas-Bravo</surname><given-names>E</given-names></name><name><surname>Munoz-Bono</surname><given-names>J</given-names></name><name><surname>Lebron-Gallardo</surname><given-names>M</given-names></name><name><surname>Fernandez-Ortega</surname><given-names>JF</given-names></name><article-title>Replacement of 24-h creatinine clearance by 2-h creatinine clearance in intensive care unit patients: a single-center study</article-title><source>Intens Care Med</source><year>2007</year><volume>33</volume><fpage>1900</fpage><lpage>1906</lpage><pub-id pub-id-type="doi">10.1007/s00134-007-0745-5</pub-id></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="journal"><name><surname>Endre</surname><given-names>ZH</given-names></name><name><surname>Walker</surname><given-names>RJ</given-names></name><name><surname>Pickering</surname><given-names>JW</given-names></name><name><surname>Shaw</surname><given-names>GM</given-names></name><name><surname>Frampton</surname><given-names>CM</given-names></name><name><surname>Henderson</surname><given-names>SJ</given-names></name><name><surname>Hutchison</surname><given-names>R</given-names></name><name><surname>Mehrtens</surname><given-names>JE</given-names></name><name><surname>Robinson</surname><given-name