Natl Acad Sci USA</source><year>1998</year><volume>95</volume><fpage>10716</fpage><lpage>10721</lpage><pub-id pub-id-type="pmid">9724770</pub-id></citation></ref><ref id="b17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haapa-Paananen</surname><given-names>S</given-names></name></person-group><article-title>DNA transposition of bacteriophage Mu. A quantitative analysis of target site selection in vitro</article-title><source>J Biol Chem</source><year>2002</year><volume>277</volume><fpage>2843</fpage><lpage>2851</lpage><pub-id pub-id-type="pmid">11700310</pub-id></citation></ref><ref id="b18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Haniford</surname><given-names>DB</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Craig</surname><given-names>NL</given-names></name></person-group><article-title>Transposon Tn10</article-title><source>Mobile DNA II.</source><year>2002</year><publisher-loc>Washington, DC</publisher-loc><publisher-name>American Society for Microbiology Press</publisher-name><fpage>457</fpage><lpage>483</lpage></citation></ref><ref id="b19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kang</surname><given-names>Y</given-names></name></person-group><article-title>Systematic mutagenesis of the <italic>Escherichia coli</italic> genome</article-title><source>J Bacteriol</source><year>2004</year><volume>186</volume><fpage>4921</fpage><lpage>4930</lpage><pub-id pub-id-type="pmid">15262929</pub-id></citation></ref><ref id="b20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>DR</given-names></name></person-group><article-title>Mutations of acidic residues in RAG1 define the active site of the V(D)J recombinase</article-title><source>Genes Dev</source><year>1999</year><volume>13</volume><fpage>3070</fpage><lpage>3080</lpage><pub-id pub-id-type="pmid">10601033</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kleckner</surname><given-names>N</given-names></name></person-group><article-title>DNA sequence analysis of Tn10 insertions: origin and role of 9 bp flanking repetitions during Tn10 translocation</article-title><source>Cell</source><year>1979</year><volume>16</volume><fpage>711</fpage><lpage>720</lpage><pub-id pub-id-type="pmid">378398</pub-id></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kulkosky</surname><given-names>J</given-names></name></person-group><article-title>Residues critical for retroviral integrative recombination in a region that is highly conserved among retroviral/retrotransposon integrases and bacterial insertion sequence transposases</article-title><source>Mol Cell Biol</source><year>1992</year><volume>12</volume><fpage>2331</fpage><lpage>2338</lpage><pub-id pub-id-type="pmid">1314954</pub-id></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Loot</surname><given-names>C</given-names></name></person-group><article-title>A target specificity switch in IS911 transposition: the role of the OrfA protein</article-title><source>EMBO J</source><year>2002</year><volume>21</volume><fpage>4172</fpage><lpage>4182</lpage><pub-id pub-id-type="pmid">12145217</pub-id></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Loot</surname><given-names>C</given-names></name></person-group><article-title>Host processing of branched DNA intermediates is involved in targeted transposition of IS911</article-title><source>Mol Microbiol</source><year>2004</year><volume>51</volume><fpage>385</fpage><lpage>393</lpage><pub-id pub-id-type="pmid">14756780</pub-id></citation></ref><ref id="b25"><citation ci