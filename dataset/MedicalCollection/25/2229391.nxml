group><article-title>Effect of osmolarity on cation fluxes in medullary thick accending limb cells</article-title><source>Am J Physiol</source><year>1986</year><volume>250</volume><fpage>F176</fpage><lpage>F180</lpage><pub-id pub-id-type="pmid">3942223</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Foskett</surname><given-names>JK</given-names></name></person-group><article-title>[Ca<sup>2&#x0002b;</sup>]<sub>i</sub> modulation of Cl<sup>&#x02212;</sup>content controls cell volume in single salivary acinar cells during fluid secretion</article-title><source>Am J  Physiol</source><year>1990</year><volume>259</volume><fpage>C998</fpage><lpage>C1004</lpage><pub-id pub-id-type="pmid">2260645</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garcia-Perez</surname><given-names>A</given-names></name><name><surname>Burg</surname><given-names>MB</given-names></name></person-group><article-title>Renal medullary organic osmolytes</article-title><source>Physiol Rev</source><year>1991</year><volume>71</volume><fpage>1081</fpage><lpage>1115</lpage><pub-id pub-id-type="pmid">1924548</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Geck</surname><given-names>P</given-names></name><name><surname>Pietrzyk</surname><given-names>B</given-names></name><name><surname>Burckhardt</surname><given-names>B</given-names></name><name><surname>Pfeiffer</surname><given-names>B</given-names></name><name><surname>Heinz</surname><given-names>E</given-names></name></person-group><article-title>Electrically silent cotransport of Na<sup>&#x0002b;</sup>, K<sup>&#x0002b;</sup>, and Cl<sup>&#x02212;</sup>in Ehrlich cells</article-title><source>Biochim Biophys Acta</source><year>1980</year><volume>600</volume><fpage>432</fpage><lpage>447</lpage><pub-id pub-id-type="pmid">7407122</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grinstein</surname><given-names>S</given-names></name><name><surname>Clarke</surname><given-names>CA</given-names></name><name><surname>Rothstein</surname><given-names>A</given-names></name></person-group><article-title>Activation of  Na<sup>&#x0002b;</sup>/H<sup>&#x0002b;</sup>exchange in lymphocytes by osmotically induced volume changes and by cytoplasmic acidification</article-title><source>J Gen Physiol</source><year>1983</year><volume>82</volume><fpage>619</fpage><lpage>638</lpage><pub-id pub-id-type="pmid">6644271</pub-id></citation></ref><ref id="B19"><citation citation-type="other">Hallows, K.R., and P.A. Knauf. 1994. Principles of cell volume regulation. <italic>In</italic> Cellular and Molecular Physiology of Cell Volume Regulation. K. Strange, editor. CRC Press, Inc., Boca Raton, FL. 3&#x02013;29.</citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Higashijima</surname><given-names>T</given-names></name><name><surname>Ferguson</surname><given-names>KM</given-names></name><name><surname>Sternweis</surname><given-names>PC</given-names></name></person-group><article-title>Regulation of hormone-sensitive GTP-dependent regulatory proteins by chloride</article-title><source>J Biol Chem</source><year>1987</year><volume>262</volume><fpage>3597</fpage><lpage>3602</lpage><pub-id pub-id-type="pmid">3102490</pub-id></citation></ref><ref id="B21"><citation citation-type="other">Hinke, J.A.M. 1967. Cation-selective microelectrodes for intracellular use. <italic>In</italic> Glass Electrodes for Hydrogen and Other Cations.  Principle and Practice. G. Eisenman, editor. Marcel Dekker Inc.,  New York. 464&#x02013;477.</citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hoffman</surname><given-names>EK</g