d pub-id-type="pmid">6139844</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Townsend</surname><given-names>C</given-names></name><name><surname>Hartmann</surname><given-names>H</given-names></name><name><surname>Horn</surname><given-names>R</given-names></name></person-group><article-title>Anomalous effect  of permeant ion concentration on peak open probability of cardiac Na<sup>&#x0002b;</sup>channels</article-title><source>J Gen Physiol</source><year>1997</year><volume>110</volume><fpage>11</fpage><lpage>21</lpage><pub-id pub-id-type="pmid">9234167</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Townsend</surname><given-names>C</given-names></name><name><surname>Horn</surname><given-names>R</given-names></name></person-group><article-title>Effect of alkali metal cations on  slow inactivation of cardiac Na<sup>&#x0002b;</sup>channels</article-title><source>J Gen Physiol</source><year>1997</year><volume>110</volume><fpage>23</fpage><lpage>33</lpage><pub-id pub-id-type="pmid">9234168</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yeh</surname><given-names>JZ</given-names></name><name><surname>Armstrong</surname><given-names>CM</given-names></name></person-group><article-title>Immobilisation of gating charge by a substance that simulates inactivation</article-title><source>Nature (Lond)</source><year>1978</year><volume>273</volume><fpage>387</fpage><lpage>389</lpage><pub-id pub-id-type="pmid">661950</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zagotta</surname><given-names>WN</given-names></name><name><surname>Hoshi</surname><given-names>T</given-names></name><name><surname>Aldrich</surname><given-names>RW</given-names></name></person-group><article-title><italic>Shaker</italic>potassium channel gating. III: Evaluation of kinetic models for activation</article-title><source>J  Gen Physiol</source><year>1994</year><volume>103</volume><fpage>321</fpage><lpage>362</lpage><pub-id pub-id-type="pmid">8189208</pub-id></citation></ref></ref-list></back></article>