up-type="author"><name><surname>Yatani</surname><given-names>A.</given-names></name><name><surname>Bahinski</surname><given-names>A.</given-names></name><name><surname>Mikala</surname><given-names>G.</given-names></name><name><surname>Yamamoto</surname><given-names>S.</given-names></name><name><surname>Schwartz</surname><given-names>A.</given-names></name></person-group><article-title>Single amino acid substitutions within the ion permeation pathway alter single-channel conductance of the human L-type cardiac Ca<sup>2+</sup> channel</article-title><source>Circ. Res.</source><volume>75</volume><year>1994</year><fpage>315</fpage><lpage>323</lpage><pub-id pub-id-type="pmid">8033343</pub-id></citation></ref><ref id="Yellen1984"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yellen</surname><given-names>G.</given-names></name></person-group><article-title>Ionic permeation and blockade in Ca<sup>2+</sup>-activated K<sup>+</sup> channels of bovine chromaffin cells</article-title><source>J. Gen. Physiol.</source><volume>84</volume><year>1984</year><fpage>157</fpage><lpage>186</lpage><pub-id pub-id-type="pmid">6092514</pub-id></citation></ref><ref id="YueandMarban1990"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yue</surname><given-names>D.T.</given-names></name><name><surname>Marban</surname><given-names>E.</given-names></name></person-group><article-title>Permeation in the dihydropyridine-sensitive calcium channelmulti-ion occupancy but no anomalous mole-fraction effect between Ba<sup>2</sup>+ and Ca<sup>2</sup>+</article-title><source>J. Gen. Physiol.</source><volume>95</volume><year>1990</year><fpage>911</fpage><lpage>939</lpage><pub-id pub-id-type="pmid">2163433</pub-id></citation></ref></ref-list><fn-group><fn><p><italic>Abbreviation used in this paper:</italic> WT, wild type.</p></fn></fn-group></back><floats-wrap><table-wrap position="float" id="T1"><label>Table 1</label><caption