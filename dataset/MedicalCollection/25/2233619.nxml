-id><pub-id pub-id-type="doi">10.1016/S0277-9536(03)00007-8</pub-id></citation></ref><ref id="B13"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Lewis</surname><given-names>M</given-names></name></person-group><article-title>Governance and corruption in public health care systems</article-title><source>Center for Global Development</source><year>2006</year><ext-link ext-link-type="uri" xlink:href="http://www.cgdev.org/content/publications/detail/5967"/><comment>[Working paper No. 78].</comment></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sturges</surname><given-names>P</given-names></name></person-group><article-title>Corrruption, Transparency and a Role for ICT?</article-title><source>International Journal of Information Ethics</source><year>2004</year><volume>2</volume><fpage>1</fpage><lpage>9</lpage></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Falkingham</surname><given-names>J</given-names></name></person-group><article-title>Poverty, out-of-pocket payments and access to health care: evidence from Tajikistan</article-title><source>Social Science and Medicine</source><year>2004</year><volume>58</volume><fpage>247</fpage><lpage>258</lpage><pub-id pub-id-type="pmid">14604611</pub-id><pub-id pub-id-type="doi">10.1016/S0277-9536(03)00008-X</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Szende</surname><given-names>A</given-names></name><name><surname>Culyer</surname><given-names>AJ</given-names></name></person-group><article-title>The inequity of informal payments for health care: the case of Hungary</article-title><source>Health Policy</source><year>2006</year><volume>75</volume><fpage>262</fpage><lpage>271</lpage><pub-id pub-id-type="pmid">15913832</pub-id><pub-id pub-id-type="doi">10.1016/j.healthpol.2005.04.001</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gaal</surname><given-names>P</given-names></name><name><surname>McKee</surname><given-names>M</given-names></name></person-group><article-title>Fee-for-service or donation? Hungarian perspectives on informal payment for health care</article-title><source>Social Science and Medicine</source><year>2005</year><volume>60</volume><fpage>1445</fpage><lpage>1457</lpage><pub-id pub-id-type="pmid">15652678</pub-id><pub-id pub-id-type="doi">10.1016/j.socscimed.2004.08.009</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gaal</surname><given-names>P</given-names></name><name><surname>Belli</surname><given-names>PC</given-names></name><name><surname>McKee</surname><given-names>M</given-names></name><name><surname>Szocska</surname><given-names>M</given-names></name></person-group><article-title>Informal Payments for Health Care: Definitions, Distinctions, and Dilemmas</article-title><source>Journal of Health Politics Policy and Law</source><year>2006</year><volume>31</volume><fpage>251</fpage><lpage>293</lpage><pub-id pub-id-type="doi">10.1215/03616878-31-2-251</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ensor</surname><given-names>T</given-names></name><name><surname>Savelyeva</surname><given-names>L</given-names></name></person-group><article-title>Informal payments for health care in the former Soviet Union: some evidence from Kazakstan</article-title><source>Health Policy and Planning</source><year>1998</year><volume>13</volume><fpage>41</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">10178184</pub-id><pub-id pub-id-type="doi">10.1093/heapol/13.1.41</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Miller</surname><given-names>WL</given-names></name><name><surname>Groenland</surname><given-names>AB</given-names></name><name><surname>Koshenhkina</surname><given-names>TY</given-names></name></person-group><article-title>'If you pay, we'll operate immediately'</article-title><source>Journal of Medical Ethics</source><year>2000</year><volume>26</volume><fpage>305</fpage><lpage>311</lpage><pub-id pub-id-type="pmid">11055030</pub-id><pub-id pub-id-type="doi">10.1136/jme.26.5.305</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Delcheva</surname><given-names>E</given-names></name><name><surname>Balabanova</surname><given-names>D</given-names></name><name><surname>McKee</surname><given-names>M</given-names></name></person-group><article-title>Under-the-counter payments for health care: evidence from Bulgaria</article-title><source>Health Policy</source><year>1997</year><volume>42</volume><fpage>89</fpage><lpage>100</lpage><pub-id pub-id-type="pmid">10175625</pub-id><pub-id pub-id-type="doi">10.1016/S0168-8510(97)00061-4</pub-id></citation></ref><ref id="B22"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Ofori-Atta</surname><given-names>AL</given-names></name><name><surname>Gadzekpo</surname><given-names>A</given-names></name></person-group><article-title>The cost of corruption in health institutions</article-title><source>9th International Anti-corruption Conference</source><ext-link ext-link-type="uri" xlink:href="http://www.transparency.org/iacc/9th_iacc/papers/day4/ws7/"/><comment><ext-link ext-link-type="uri" xlink:href="http://d4ws7_gadzekpolamesdorf.html"/> (accessed 14<sup>th </sup>October 2003)</comment></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lewis</surname><given-names>M</given-names></name></person-group><article-title>Who is paying for health care in Eastern Europe and Central Asia?</article-title><source>World Bank Europe and Central Asia Region</source><year>2000</year><publisher-name>Washington D.C. USA</publisher-name></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Balabanova</surname><given-names>D</given-names></name><name><surname>McKee</surname><given-names>M</given-names></name></person-group><article-title>Understanding informal payments for health care: the example of Bulgaria</article-title><source>Health Policy</source><year>2002</year><volume>62</volume><fpage>243</fpage><lpage>273</lpage><pub-id pub-id-type="pmid">12385850</pub-id><pub-id pub-id-type="doi">10.1016/S0168-8510(02)00035-0</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Killingsworth</surname><given-names>RJ</given-names></name><name><surname>Hossain</surname><given-names>N</given-names></name><name><surname>Hedrick-Wong</surname><given-names>Y</given-names></name><name><surname>Thomas</surname><given-names>S</given-names></name><name><surname>Rahman</surname><given-names>A</given-names></name><name><surname>Begum</surname><given-names>T</given-names></name></person-group><article-title>Unofficial fees in Bangladesh: price, equity and institutional issues</article-title><source>Health Policy and Planning</source><year>1999</year><volume>14</volume><fpage>152</fpage><lpage>163</lpage><pub-id pub-id-type="pmid">10538718</pub-id><pub-id pub-id-type="doi">10.1093/heapol/14.2.152</pub-id></citation></ref><ref id="B26"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Thompson</surname><given-names>R</given-names></name><name><surname>Xavier</surname><given-names>A</given-names></name></person-group><source>Unofficial payments for acute state hospital care in Kazakhstan. A model of physician behaviour with price discrimination and vertical service dif