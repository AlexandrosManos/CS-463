<lpage>733</lpage><pub-id pub-id-type="pmid">7501021</pub-id></citation></ref><ref id="Palmer1982"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Palmer</surname><given-names>L.G.</given-names></name></person-group><article-title>Na<sup>+</sup> transport and flux ratio through apical Na<sup>+</sup> channels in toad bladder</article-title><source><italic>Nature</italic>.</source><volume>297</volume><year>1982</year><fpage>688</fpage><lpage>690</lpage></citation></ref><ref id="Palmer1990"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Palmer</surname><given-names>L.G.</given-names></name></person-group><article-title>Epithelial Na channelsthe nature of the conducting pore</article-title><source>Renal Physiol. Biochem.</source><volume>13</volume><year>1990</year><fpage>51</fpage><lpage>58</lpage><pub-id pub-id-type="pmid">1689861</pub-id></citation></ref><ref id="PalmerandAndersen1989"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Palmer</surname><given-names>L.G.</given-names></name><name><surname>Andersen</surname><given-names>O.S.</given-names></name></person-group><article-title>Interactions of amiloride and small monovalent cations with the epithelial sodium channel. Inferences about the nature of the channel pore</article-title><source>Biophys. J.</source><volume>55</volume><year>1989</year><fpage>779</fpage><lpage>787</lpage><pub-id pub-id-type="pmid">2541821</pub-id></citation></ref><ref id="Renardetal1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Renard</surname><given-names>S.</given-names></name><name><surname>Lingueglia</surname><given-names>E.</given-names></name><name><surname>Voilley</surname><given-names>N.</given-names></name><name><surname>Lazdunski</surname><given-names>M.</given-names></name><name><surname>Barbry</surname><given-names>P.</given-names></name></person-group><