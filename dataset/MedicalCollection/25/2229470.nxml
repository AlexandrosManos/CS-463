icle-title><source>Science.</source><volume>270</volume><year>1995</year><fpage>1502</fpage><lpage>1506</lpage><pub-id pub-id-type="pmid">7491499</pub-id></citation></ref><ref id="EckertandTillotson1981"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eckert</surname><given-names>R.</given-names></name><name><surname>Tillotson</surname><given-names>D.</given-names></name></person-group><article-title>Calcium-mediated inactivation of the calcium conductance in caesium-loaded giant neurones of <italic>Aplysia californica</italic></article-title><source>J. Physiol.</source><volume>314</volume><year>1981</year><fpage>265</fpage><lpage>280</lpage><pub-id pub-id-type="pmid">6273532</pub-id></citation></ref><ref id="EckertandChad1984"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eckert</surname><given-names>R.</given-names></name><name><surname>Chad</surname><given-names>J.E.</given-names></name></person-group><article-title>Inactivation of Ca Channels</article-title><source>Prog. Biophys. Mol. Biol.</source><volume>44</volume><year>1984</year><fpage>215</fpage><lpage>267</lpage><pub-id pub-id-type="pmid">6095365</pub-id></citation></ref><ref id="FleigandPenner1995"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fleig</surname><given-names>A.</given-names></name><name><surname>Penner</surname><given-names>R.</given-names></name></person-group><article-title>Excessive repolarization-dependent calcium currents induced by strong depolarizations in rat skeletal myoballs</article-title><source>J. Physiol.</source><volume>489</volume><year>1995</year><fpage>41</fpage><lpage>53</lpage><pub-id pub-id-type="pmid">8583414</pub-id></citation></ref><ref id="FrielandTsien1992"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Friel</surname><given-names>D.D.</given-names></name><name><surname>Tsien</surname><given-name