 id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Olshaker</surname><given-names>JS</given-names></name><name><surname>Deckleman</surname><given-names>C</given-names></name></person-group><article-title>Delayed presentation of splenic rupture after colonoscopy</article-title><source><italic>Journal of Emergency Medicine</italic></source><year>1999</year><volume>17</volume><issue>3</issue><fpage>455</fpage><lpage>457</lpage><pub-id pub-id-type="other">2-s2.0-0032912330</pub-id><pub-id pub-id-type="pmid">10338238</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Pfefferkorn</surname><given-names>U</given-names></name><name><surname>Hamel</surname><given-names>CT</given-names></name><name><surname>Viehl</surname><given-names>CT</given-names></name><name><surname>Marti</surname><given-names>WR</given-names></name><name><surname>Oertli</surname><given-names>D</given-names></name></person-group><article-title>Haemorrhagic shock caused by splenic rupture following routine colonoscopy</article-title><source><italic>International Journal of Colorectal Disease</italic></source><year>2007</year><volume>22</volume><issue>5</issue><fpage>559</fpage><lpage>560</lpage><pub-id pub-id-type="other">2-s2.0-33947624112</pub-id><pub-id pub-id-type="pmid">15830203</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Al Alawi</surname><given-names>I</given-names></name><name><surname>Gourlay</surname><given-names>R</given-names></name></person-group><article-title>Rare complication of colonoscopy</article-title><source><italic>ANZ Journal of Surgery</italic></source><year>2004</year><volume>74</volume><issue>7</issue><fpage>605</fpage><lpage>606</lpage><pub-id pub-id-type="other">2-s2.0-3442885977</pub-id><pub-id pub-id-type="pmid">15230804</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ellis</surname><given-names>WR</given-names></name><name><surname>Harrison</surname><given-names>JM</given-names></name><name><surname>Williams</surname><given-names>RS</given-names></name></person-group><article-title>Rupture of spleen at colonoscopy</article-title><source><italic>British Medical Journal</italic></source><year>1979</year><volume>1</volume><issue>6159</issue><fpage>307</fpage><lpage>308</lpage><pub-id pub-id-type="other">2-s2.0-0018404924</pub-id><pub-id pub-id-type="pmid">421092</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Famularo</surname><given-names>G</given-names></name><name><surname>Minisola</surname><given-names>G</given-names></name><name><surname>De Simone</surname><given-names>C</given-names></name></person-group><article-title>Rupture of the spleen after colonoscopy: a life-threatening complication</article-title><source><italic>The American Journal of Emergency Medicine</italic></source><year>2008</year><volume>26</volume><issue>7</issue><fpage>834.e3</fpage><lpage>834.e4</lpage><pub-id pub-id-type="other">2-s2.0-50549094135</pub-id><pub-id pub-id-type="pmid">18774051</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kiosoglous</surname><given-names>AJ</given-names></name><name><surname>Varghese</surname><given-names>R</given-names></name><name><surname>Memon</surname><given-names>MA</given-names></name></person-group><article-title>Splenic rupture after colonoscopy: a case report</article-title><source><italic>Surgical Laparoscopy, Endoscopy and Percutaneous Techniques</italic></source><year>2009</year><volume>19</volume><issue>3</issue><fpage>e104</fpage><lpage>e105</lpage><pub-id pub-id-type="other">2-s2.0-68549115375</pub-id></element-citation></ref><ref id="B13"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Skipworth</surname><given-names>JR</given-names></name><name><surname>Raptis</surname><given-names>DA</given-names></name><name><surname>Rawal</surname><given-names>JS</given-names></name><etal/></person-group><article-title>Splenic injury following colonoscopy&#x02014;An underdiagnosed, but soon to increase, phenomenon?</article-title><source><italic>Annals of the Royal College of Surgeons of England</italic></source><year>2009</year><volume>91</volume><issue>4</issue><fpage>W6</fpage><lpage>W11</lpage><pub-id pub-id-type="other">2-s2.0-68349087096</pub-id><pub-id pub-id-type="pmid">19416579</pub-id></element-citation></ref><ref id="B14"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Duarte</surname><given-names>CG</given-names></name></person-group><article-title>Splenic rupture after colonoscopy</article-title><source><italic>The American Journal of Emergency Medicine</italic></source><year>2008</year><volume>26</volume><issue>1</issue><fpage>117.e1</fpage><lpage>117.e3</lpage><pub-id pub-id-type="other">2-s2.0-36849043108</pub-id><pub-id pub-id-type="pmid">18082812</pub-id></element-citation></ref><ref id="B15"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Randriamarolahy</surname><given-names>A</given-names></name><name><surname>Cucchi</surname><given-names>JM</given-names></name><name><surname>Brunner</surname><given-names>P</given-names></name><name><surname>Garnier</surname><given-names>G</given-names></name><name><surname>Demarquay</surname><given-names>JF</given-names></name><name><surname>Bruneton</surname><given-names>JN</given-names></name></person-group><article-title>Two rare cases of spontaneous splenic rupture</article-title><source><italic>Clinical Imaging</italic></source><year>2010</year><volume>34</volume><issue>4</issue><fpage>306</fpage><lpage>308</lpage><pub-id pub-id-type="other">2-s2.0-77954109903</pub-id><pub-id pub-id-type="pmid">20630345</pub-id></element-citation></ref><ref id="B12"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Parker</surname><given-names>WT</given-names></name><name><surname>Edwards</surname><given-names>MA</given-names></name><name><surname>Bittner</surname><given-names>JG</given-names><suffix>IV</suffix></name><name><surname>Mellinger</surname><given-names>JD</given-names></name></person-group><article-title>Splenic hemorrhage: an unexpected complication after colonoscopy</article-title><source><italic>The American Surgeon</italic></source><year>2008</year><volume>74</volume><issue>5</issue><fpage>450</fpage><lpage>452</lpage><pub-id pub-id-type="other">2-s2.0-44649122178</pub-id><pub-id pub-id-type="pmid">18481509</pub-id></element-citation></ref></ref-list></back></article>