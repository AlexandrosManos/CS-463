oup><year>1991</year><article-title>A hard pill to swallow. Advertising prescription drugs directly to the consumer</article-title><source>Nurs Econ</source><volume>9</volume><fpage>343</fpage><lpage>347</lpage><pub-id pub-id-type="pmid">1922442</pub-id></citation></ref><ref id="pmed-0050005-b022"><citation citation-type="journal"><person-group><name><surname>Gruber</surname><given-names>W</given-names></name><name><surname>Llewelyn</surname><given-names>J</given-names></name><name><surname>Arras</surname><given-names>C</given-names></name><name><surname>Lion</surname><given-names>S</given-names></name></person-group><year>1995</year><article-title>The role of the pharmaceutical industry in promoting patient education</article-title><source>Patient Educ Couns</source><volume>26</volume><fpage>245</fpage><lpage>249</lpage><pub-id pub-id-type="pmid">7494731</pub-id></citation></ref><ref id="pmed-0050005-b023"><citation citation-type="journal"><person-group><name><surname>Viale</surname><given-names>PH</given-names></name></person-group><year>2002</year><article-title>Direct-to-consumer advertising of prescription medications: implications for patients with cancer</article-title><source>Oncol Nurs Forum</source><volume>29</volume><fpage>505</fpage><lpage>513</lpage><pub-id pub-id-type="pmid">11979283</pub-id></citation></ref><ref id="pmed-0050005-b024"><citation citation-type="journal"><person-group><name><surname>Viale</surname><given-names>PH</given-names></name><name><surname>Yamamoto</surname><given-names>DS</given-names></name></person-group><year>2004</year><article-title>The attitudes and beliefs of oncology nurse practitioners regarding direct-to-consumer advertising of prescription medications</article-title><source>Oncol Nurs Forum</source><volume>31</volume><fpage>777</fpage><lpage>783</lpage><pub-id pub-id-type="pmid">15252431</pub-id></citation></ref><ref id="pmed-0050005-b025"><citation citation-type="journal"><person-group><name><surname>Bowron</surname><given-names>A</given-names></name></person-group><year>2006</year><article-title>Bridging the information gap in primary care</article-title><source>Community Pract</source><volume>79</volume><fpage>242</fpage><pub-id pub-id-type="pmid">16922030</pub-id></citation></ref><ref id="pmed-0050005-b026"><citation citation-type="journal"><person-group><name><surname>Davies</surname><given-names>J</given-names></name><name><surname>Hemingway</surname><given-names>S</given-names></name></person-group><year>2006</year><article-title>Pharmaceutical influences: nurse prescribers: eyes wide open</article-title><source>Nurse Prescr</source><volume>1</volume><fpage>e42</fpage></citation></ref><ref id="pmed-0050005-b027"><citation citation-type="journal"><person-group><name><surname>DeSilets</surname><given-names>LD</given-names></name></person-group><year>2006</year><article-title>Commercial support for professional development</article-title><source>J Contin Educ Nurs</source><volume>37</volume><fpage>52</fpage><lpage>53</lpage><pub-id pub-id-type="pmid">16944553</pub-id></citation></ref><ref id="pmed-0050005-b028"><citation citation-type="journal"><person-group><name><surname>Edmunds</surname><given-names>M</given-names></name></person-group><year>2004</year><article-title>Confusing ethical guidelines dampen pharmaceutical support</article-title><source>Nurse Pract</source><volume>29</volume><fpage>16</fpage><pub-id pub-id-type="pmid">15553914</pub-id></citation></ref><ref id="pmed-0050005-b029"><citation citation-type="journal"><person-group><name><surname>Flewell</surname><given-names>MN</given-names></name></person-group><year>2006</year><article-title>Pharmaceutical sales reps: Value beyond samples</article-title><source>Adv Nurse Pract</source><volume>14</volume><fpage>18</fpage><pub-id pub-id-type="pmid">16977890</pub-id></citation></ref><ref id="pmed-0050005-b030"><citation citation-type="journal"><person-group><name><surname>Hall</surname><given-names>J</given-names></n