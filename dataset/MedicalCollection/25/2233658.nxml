ef id="Phillipsetal1999"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Phillips</surname><given-names>W.T.</given-names></name><name><surname>Klipper</surname><given-names>R.W.</given-names></name><name><surname>Awasthi</surname><given-names>V.D.</given-names></name><name><surname>Rudolph</surname><given-names>A.S.</given-names></name><name><surname>Cliff</surname><given-names>R.</given-names></name><name><surname>Kwasiborski</surname><given-names>V.</given-names></name><name><surname>Goins</surname><given-names>B.A.</given-names></name></person-group><article-title>Polyethylene glycol-modified liposome-encapsulated hemoglobina long circulating red cell substitute</article-title><source>J. Pharmacol. Exp. Ther.</source><volume>288</volume><year>1999</year><fpage>665</fpage><lpage>670</lpage><pub-id pub-id-type="pmid">9918573</pub-id></citation></ref><ref id="PilewskiandFrizzell1999"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pilewski</surname><given-names>J.M.</given-names></name><name><surname>Frizzell</surname><given-names>R.A.</given-names></name></person-group><article-title>Role of CFTR in airway disease</article-title><source>Physiol. Rev.</source><volume>79</volume><year>1999</year><fpage>S215</fpage><lpage>S255</lpage><pub-id pub-id-type="pmid">9922383</pub-id></citation></ref><ref id="Quinton1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Quinton</surname><given-names>P.M.</given-names></name></person-group><article-title>Viscosity vs. composition in airway pathology</article-title><source>Am. J. Respir. Crit. Care Med.</source><volume>149</volume><year>1994</year><fpage>6</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">8111599</pub-id></citation></ref><ref id="Sekseketal1995"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Seksek</surname><given-names>O.</given-names></name><n