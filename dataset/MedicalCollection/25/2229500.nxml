year>1960</year><fpage>1137</fpage><lpage>1148</lpage><pub-id pub-id-type="pmid">13813357</pub-id></citation></ref><ref id="CurranandMacIntosh1962"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Curran</surname><given-names>P.</given-names></name><name><surname>MacIntosh</surname><given-names>J.R.</given-names></name></person-group><article-title>A model system for biological water transport</article-title><source>Nature.</source><volume>193</volume><year>1962</year><fpage>347</fpage><lpage>348</lpage><pub-id pub-id-type="pmid">13882705</pub-id></citation></ref><ref id="CurranandSolomon1957"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Curran</surname><given-names>P.F.</given-names></name><name><surname>Solomon</surname><given-names>A.K.</given-names></name></person-group><article-title>Ion and water fluxes in the ileum of rats</article-title><source>J. Gen. Physiol.</source><volume>41</volume><year>1957</year><fpage>143</fpage><lpage>168</lpage><pub-id pub-id-type="pmid">13463275</pub-id></citation></ref><ref id="Dantzler1992"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Dantzler</surname><given-names>W.H.</given-names></name></person-group><article-title>Comparative aspects of renal function</article-title><person-group person-group-type="editor"><name><surname>Seedling</surname><given-names>D.E.W.</given-names></name><name><surname>Giebisch</surname><given-names>G.</given-names></name></person-group><source>The KidneyPhysiology and Pathophysiology</source><edition>2nd edition</edition><year>1992</year><fpage>885</fpage><lpage>942</lpage><publisher-name>Raven Press</publisher-name><publisher-loc>New York</publisher-loc></citation></ref><ref id="DeetjenandKramer1961"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Deetjen</surname><given-names>P.</given-names></name><name><surname>Kramer</surname><given-names>K.</given-names></name></person-group><article-title>Die Abh&#x000e4;ngigkeit des O<sub>2</sub>-Verbrauchs der Niere von der Na-R&#x000fc;ckresorption</article-title><source>Pfl&#x000fc;gers Arch.</source><volume>273</volume><year>1961</year><fpage>636</fpage><lpage>642</lpage></citation></ref><ref id="Diamond1964a"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Diamond</surname><given-names>J.M.</given-names></name></person-group><article-title>Transport of salt and water in rabbit and guinea pig gall bladder</article-title><source>J. Gen. Physiol.</source><volume>48</volume><year>1964</year><fpage>1</fpage><lpage>14</lpage>a<pub-id pub-id-type="pmid">14212148</pub-id></citation></ref><ref id="Diamond1964b"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Diamond</surname><given-names>J.M.</given-names></name></person-group><article-title>The mechanism of isotonic water transport</article-title><source>J. Gen. Physiol.</source><volume>48</volume><year>1964</year><fpage>15</fpage><lpage>42</lpage>b<pub-id pub-id-type="pmid">14212146</pub-id></citation></ref><ref id="DiamondandBossert1967"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Diamond</surname><given-names>J.M.</given-names></name><name><surname>Bossert</surname><given-names>W.H.</given-names></name></person-group><article-title>Standing-gradient osmotic flow. A mechanism for coupling of water and solute transport in epithelia</article-title><source>J. Gen. Physiol.</source><volume>50</volume><year>1967</year><fpage>2061</fpage><lpage>2083</lpage><pub-id pub-id-type="pmid">6066064</pub-id></citation></ref><ref id="FranzandVanBruggen1967"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Franz</surname><given-names>T.J.</given-names></name><name><surname>Van Bruggen</surname><given-names>J.T.</given-names></name></person-group><art