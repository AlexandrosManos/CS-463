d="Boucher1994b"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boucher</surname><given-names>R.C.</given-names></name></person-group><article-title>Human airway ion transport. Part Two</article-title><source>Am. J. Respir. Crit. Care. Med.</source><volume>150</volume><year>1994</year><fpage>581</fpage><lpage>593</lpage>b<pub-id pub-id-type="pmid">8049852</pub-id></citation></ref><ref id="Boucher1999"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boucher</surname><given-names>R.C.</given-names></name></person-group><article-title>Molecular insights into the physiology of the thin film of airway surface liquid</article-title><source>J. Physiol.</source><volume>London) 516</volume><year>1999</year><fpage>631</fpage><lpage>638</lpage><pub-id pub-id-type="pmid">10200413</pub-id></citation></ref><ref id="Boulpaepetal1993"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Boulpaep</surname><given-names>E.L.</given-names></name><name><surname>Maunsbach</surname><given-names>A.B.</given-names></name><name><surname>Tripathi</surname><given-names>S.</given-names></name><name><surname>Weber</surname><given-names>M.R.</given-names></name></person-group><article-title>Mechanism of isosmotic water transport in leaky epitheliaconsensus and inconsistencies</article-title><person-group person-group-type="editor"><name><surname>Ussing</surname><given-names>H.H.</given-names></name><name><surname>Fischbarg</surname><given-names>J.</given-names></name><name><surname>Sten-Knudsen</surname><given-names>O.</given-names></name><name><surname>Larsen</surname><given-names>E.H.</given-names></name><name><surname>Willumsen</surname><given-names>N.J.</given-names></name></person-group><source>Isotonic Transport in Leaky Epithelia. Proc. Alfred Benzon Symp</source><year>1993</year><fpage>53</fpage><lpage>67</lpage><publisher-name>Munksgaard</publisher-name><publisher-loc>Co