name><surname>Sweeney</surname><given-names>N</given-names></name><name><surname>Gallagher</surname><given-names>WM</given-names></name><name><surname>M&#x000fc;ller-Bunz</surname><given-names>H</given-names></name><name><surname>Pampill&#x000f3;n</surname><given-names>C</given-names></name><name><surname>Strohfeldt</surname><given-names>K</given-names></name><name><surname>Tacke</surname><given-names>M</given-names></name></person-group><article-title>Heteroaryl substituted titanocenes as potential anti-cancer drugs</article-title><source><italic>Journal of Inorganic Biochemistry</italic></source><year>2006</year><volume>100</volume><issue>9</issue><fpage>1479</fpage><lpage>1486</lpage><pub-id pub-id-type="pmid">16764931</pub-id></citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Strohfeldt</surname><given-names>K</given-names></name><name><surname>M&#x000fc;ller-Bunz</surname><given-names>H</given-names></name><name><surname>Pampill&#x000f3;n</surname><given-names>C</given-names></name><name><surname>Sweeney</surname><given-names>N</given-names></name><name><surname>Tacke</surname><given-names>M</given-names></name></person-group><article-title>Glycol methyl ether and glycol amine substituted titanocenes as antitumor agents</article-title><source><italic>European Journal of Inorganic Chemistry</italic></source><year>2006</year><volume>2006</volume><issue>22</issue><fpage>4621</fpage><lpage>4628</lpage></citation></ref><ref id="B17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sweeney</surname><given-names>N</given-names></name><name><surname>Claffey</surname><given-names>J</given-names></name><name><surname>M&#x000fc;ller-Bunz</surname><given-names>H</given-names></name><name><surname>Pampill&#x000f3;n</surname><given-names>C</given-names></name><name><surname>Strohfeldt</surname><given-names>K</given-names></name><nam