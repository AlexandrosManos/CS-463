ame><given-names>A.</given-names></name><name><surname>Kuroki</surname><given-names>S.</given-names></name><name><surname>Nishimura</surname><given-names>S.</given-names></name><name><surname>Kameyama</surname><given-names>M.</given-names></name></person-group><article-title>Run-down of L-type Ca<sup>2+</sup> channels occurs on the &#x003b1;<sub>1</sub> subunit</article-title><source>Biochem. Biophys. Res. Commun.</source><volume>247</volume><year>1998</year><fpage>844</fpage><lpage>850</lpage><pub-id pub-id-type="pmid">9647781</pub-id></citation></ref><ref id="Heinemannetal1992"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heinemann</surname><given-names>S.H.</given-names></name><name><surname>Terlau</surname><given-names>H.</given-names></name><name><surname>St&#x000fc;hmer</surname><given-names>W.</given-names></name><name><surname>Imoto</surname><given-names>K.</given-names></name><name><surname>Numa</surname><given-names>S.</given-names></name></person-group><article-title>Calcium channel characteristics conferred on the sodium channel by single mutations</article-title><source>Nature.</source><volume>356</volume><year>1992</year><fpage>441</fpage><lpage>443</lpage><pub-id pub-id-type="pmid">1313551</pub-id></citation></ref><ref id="HessandTsien1984"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hess</surname><given-names>P.</given-names></name><name><surname>Tsien</surname><given-names>R.W.</given-names></name></person-group><article-title>Mechanism of ion permeation through calcium channels</article-title><source>Nature.</source><volume>309</volume><year>1984</year><fpage>453</fpage><lpage>456</lpage><pub-id pub-id-type="pmid">6328315</pub-id></citation></ref><ref id="Hessetal1986"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hess</surname><given-names>P.</given-names></name><name><surname>Lansman</surname><given-names>J.B.</gi