/volume><issue>4</issue><fpage>288</fpage><lpage>91</lpage><pub-id pub-id-type="pmid">11813489</pub-id></element-citation></ref><ref id="A7672R18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Abdali</surname><given-names>H</given-names></name><name><surname>Memarzade</surname><given-names>M</given-names></name></person-group><article-title>Evaluation of Injury Severity in Traumatized Patients at Al Zahra Medical, Academic Center.</article-title><source>Mil Med J.</source><year>2003</year><volume>4</volume><issue>4</issue><fpage>247</fpage><lpage>50</lpage></element-citation></ref></ref-list></back></article>