d="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Feeny</surname><given-names>D</given-names></name><name><surname>Furlong</surname><given-names>W</given-names></name><name><surname>Boyle</surname><given-names>M</given-names></name><name><surname>Torrance</surname><given-names>GW</given-names></name></person-group><article-title>Multi-attribute health status classification systems. Health Utilities Index</article-title><source>Pharmacoeconomics</source><year>1995</year><volume>7</volume><fpage>490</fpage><lpage>502</lpage><pub-id pub-id-type="pmid">10155335</pub-id><pub-id pub-id-type="doi">10.2165/00019053-199507060-00004</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Van Beeck</surname><given-names>EF</given-names></name><name><surname>Larsen</surname><given-names>CF</given-names></name><name><surname>Lyons</surname><given-names>RA</given-names></name><name><surname>Meerding</surname><given-names>WJ</given-names></name><name><surname>Mulder</surname><given-names>S</given-names></name><name><surname>Essink-Bot</surname><given-names>ML</given-names></name></person-group><article-title>Guidelines for the Conduction of Follow-up Studies Measuring Injury-Related Disability</article-title><source>J Trauma</source><year>2007</year><volume>62</volume><fpage>534</fpage><lpage>550</lpage><pub-id pub-id-type="pmid">17297349</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Levin</surname><given-names>HS</given-names></name><name><surname>Grossman</surname><given-names>RG</given-names></name><name><surname>Rose</surname><given-names>JE</given-names></name><name><surname>Teasdale</surname><given-names>G</given-names></name></person-group><article-title>Long-term neuropsychological outcome of closed head injury</article-title><source>J Neurosurg</source><year>1979</year><v