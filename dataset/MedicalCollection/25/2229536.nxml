<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="correction"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">J Gen Physiol</journal-id><journal-title>The Journal of General Physiology</journal-title><issn pub-type="ppub">0022-1295</issn><issn pub-type="epub">1540-7748</issn><publisher><publisher-name>The Rockefeller University Press</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmc">2229536</article-id><article-id pub-id-type="publisher-id">12041</article-id><article-id pub-id-type="doi">10.1085/jgp.20020919120267</article-id><article-categories><subj-group subj-group-type="heading"><subject>Correction</subject></subj-group></article-categories><title-group><article-title>Correction</article-title></title-group><pub-date pub-type="ppub"><month>10</month><year>2002</year></pub-date><volume>120</volume><issue>4</issue><fpage>599</fpage><lpage>599</lpage><permissions><copyright-statement>Copyright &#x000a9; 2002, The Rockefeller University Press</copyright-statement></permissions></article-meta></front><body><p><related-article related-article-type="corrected-article" vol="120" page="267" id="N0x1c52c80N0x42ba670" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="12198087" ext-link-type="pubmed">Horrigan, F.T., and R.W. Aldrich</related-article></p><p><italic>The Journal of General Physiology.</italic> Volume 120, No. 3, September 2002. 267&#x02013;305.</p><p>Due to editorial errors several equations in the paper appeared incorrectly. The corrected equations appear below.</p><p>Page 270, right column</p><p> <inline-formula><tex-math id="M1">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}{\mathrm{L}}={\mathrm{L}}_{0}{\mathrm{exp}} \left \left(\frac{{\mathrm{z}}_{{\mathrm{L}}}{\mathrm{V}}}{{\mathrm{kT}}}\right) \right ;\;{\mathrm{J}}={\mathrm{J}}_{0}{\mathrm{exp}} \left \left(-\frac{{\mathrm{z}}_{{\mathrm{J}}}V}{{\mathrm{kT}}}\right) \right ;\;{\mathrm{K}}=\frac{ \left \left[{\mathrm{Ca}}^{2+}\right] \right }{{\mathrm{K}}_{{\mathrm{D}}}}.\end{equation*}\end{document}</tex-math></inline-formula> </p><p>Page 274, left column, line 1</p><p> <inline-formula><tex-math id="M2">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*} \left \left\{1\;+\;{\mathrm{exp}}[-{\mathrm{z}}({\mathrm{V}}\;-\;{\mathrm{V}}_{{\mathrm{h}}})/{\mathrm{kT}}]\right\} \right ^{-1}\end{equation*}\end{document}</tex-math></inline-formula> </p><p>Page 277, Figure 7 legend, line 36</p><p> <inline-formula><tex-math id="M3">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}{\tau}_{{\mathrm{gfast}}}= \left \left[{\alpha}_{0}e^{{{\mathrm{z}}_{{\alpha}}{\mathrm{V}}}/{{\mathrm{kT}}}}+{\beta}_{0}{\mathrm{e}}^{{{\mathrm{z}}_{{\beta}}{\mathrm{V}}}/{{\mathrm{kT}}}}\right] \right ^{-1}.\end{equation*}\end{document}</tex-math></inline-formula></p><p>Page 277, Figure 7 legend, line 46</p><p> <inline-formula><tex-math id="M4">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}{\mathrm{C}}_{g}\;=\;{\mathrm{A*z}}((1\;+\;{\mathrm{e}}^{-{\mathrm{z}}({\mathrm{V}}\;-\;{\mathrm{Vh}})/{\mathrm{kT}}})^{2}({\mathrm{kTe}}^{{\mathrm{z}}({\mathrm{V}}\;-\;{\mathrm{Vh}})/{\mathrm{kT}}}))^{-1}\end{equation*}\end{document}</tex-math></inline-formula></p><p>Page 279, left column, lines 3 and 4</p><p><inline-formula><tex-math id="M5">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}{\alpha}\;=\;{\alpha}_{0}{\mathrm{exp}}({\mathrm{z}}_{{\alpha}}{\mathrm{V}}/{\mathrm{kT}})\end{equation*}\end{document}</tex-math></inline-formula> and  <inline-formula><tex-math id="M6">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}{\beta}\;=\;{\beta}_{0}{\mathrm{exp}}({\mathrm{z}}_{{\beta}}{\mathrm{V/kT}})\end{equation*}\end{document}</tex-math></inline-formula></p><p>Page 284, left column, line 12</p><p><inline-formula><tex-math id="M7">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}{\mathrm{J}}\;=\;1\;({\mathrm{V}}_{{\mathrm{h}}}({\mathrm{J}})\;=\;-({\mathrm{kT/z}}_{{\mathrm{J}}})\;{\mathrm{ln}}({\mathrm{J}}_{0}))\end{equation*}\end{document}</tex-math></inline-formula></p><p>Page 284, right column, line 1</p><p><inline-formula><tex-math id="M8">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}{\mathrm{P}}_{{\mathrm{0}}}={\mathrm{L}}={\mathrm{L}}_{{\mathrm{0}}}{\mathrm{exp}} \left \left({\mathrm{z}}_{{\mathrm{L}}}{{\mathrm{V}}}/{{\mathrm{kT}}}\right) \right \end{equation*}\end{document}</tex-math></inline-formula></p><p>Page 288, right column, line 1</p><p><inline-formula><tex-math id="M9">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}B \left \left[{\mathrm{V}}\right] \right = \left \left[1+e^{{-{\mathrm{z}} \left \left({\mathrm{V}}-{\mathrm{V}}_{{\mathrm{H}}}\right) \right }/{{\mathrm{kT}}}}\right] \right ^{-1}\end{equation*}\end{document}</tex-math></inline-formula></p><p>Page 288, right column, lines 7 and 8</p><p><inline-formula><tex-math id="M10">\documentclass[10pt]{article}\usepackage{amsmath}\usepackage{wasysym} \usepackage{amsfonts} \usepackage{amssymb} \usepackage{amsbsy}\usepackage{mathrsfs}\usepackage{pmc}\usepackage[Euler]{upgreek}\pagestyle{empty}\oddsidemargin -1.0in\begin{document}\begin{equation*}{\mathrm{V}}_{{\mathrm{h}}}\;=\;-({\mathrm{kT/z}}_{{\mathrm{J}}}){\mathrm{ln}}({\mathrm{DJ}}_{0})\;{\mathrm{in\;0\;Ca}}^{2+}{\mathrm{or\;V}}_{{\mathrm{h}}}\;=\;-({\mathrm{kT/z}}_{{\mathrm{J}}}){\mathrm{ln}}({\mathrm{DEJ}}_{0})\end{equation*}\end{document}</tex-math></inline-formula></p></body></article>