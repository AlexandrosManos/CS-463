<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">J Gen Physiol</journal-id><journal-title>The Journal of General Physiology</journal-title><issn pub-type="ppub">0022-1295</issn><issn pub-type="epub">1540-7748</issn><publisher><publisher-name>The Rockefeller University Press</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">5042025</article-id><article-id pub-id-type="pmc">2226055</article-id><article-categories><subj-group subj-group-type="heading"><subject>Article</subject></subj-group></article-categories><title-group><article-title>Light Adaptation of Discrete Waves in the <italic>Limulus</italic> Photoreceptor</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Srebro</surname><given-names>Richard</given-names></name></contrib><contrib contrib-type="author"><name><surname>Behbehani</surname><given-names>Mahmood</given-names></name></contrib></contrib-group><aff id="N0x3365a80N0x3d611e0">From the Department of Physiology, the Department of Biophysics, and the Neurosensory Laboratory, State University of New York at Buffalo, Buffalo, New York 14214</aff><pub-date pub-type="ppub"><day>1</day><month>7</month><year>1972</year></pub-date><volume>60</volume><issue>1</issue><fpage>86</fpage><lpage>101</lpage><history><date date-type="received"><day>5</day><month>1</month><year>1972</year></date></history><permissions><copyright-statement>Copyright &#x000a9; 1972 by The Rockefeller University Press</copyright-statement></permissions><abstract><p> Light adaptation affects discrete waves in two ways. It reduces their average size and decreases the probability that a photon incident at the cornea causes a discrete wave. There is no effect of light adaptation on the latency of discrete waves, or on their time-course. </p></abstract></article-meta></front></article>