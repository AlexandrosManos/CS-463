</name><name><surname>Hescheler</surname><given-names>J.</given-names></name><name><surname>Quayle</surname><given-names>J.M.</given-names></name><name><surname>Patlak</surname><given-names>J.B.</given-names></name><name><surname>Nelson</surname><given-names>M.T.</given-names></name></person-group><article-title>Single Ca<sup>2+</sup> channel currents of arterial smooth muscle at physiological Ca<sup>2+</sup> concentrations</article-title><source>Am. J. Physiol.</source><volume>263</volume><year>1992</year><fpage>C948</fpage><lpage>C952</lpage><pub-id pub-id-type="pmid">1332495</pub-id></citation></ref><ref id="Grabneretal1996"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grabner</surname><given-names>M.</given-names></name><name><surname>Wang</surname><given-names>Z.</given-names></name><name><surname>Hering</surname><given-names>S.</given-names></name><name><surname>Striessnig</surname><given-names>J.</given-names></name><name><surname>Glossmann</surname><given-names>H.</given-names></name></person-group><article-title>Transfer of 1,4-dihydropyridine sensitivity from L-type to class A (BI) Ca<sup>2+</sup> channels</article-title><source>Neuron.</source><volume>16</volume><year>1996</year><fpage>207</fpage><lpage>218</lpage><pub-id pub-id-type="pmid">8562085</pub-id></citation></ref><ref id="Grabneretal1998"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grabner</surname><given-names>M.</given-names></name><name><surname>Dirksen</surname><given-names>R.T.</given-names></name><name><surname>Beam</surname><given-names>K.G.</given-names></name></person-group><article-title>Tagging with green fluorescent protein reveals a distinct subcellular distribution of L-type and non-L-type Ca<sup>2+</sup> channels expressed in dysgenic myotubes</article-title><source>Proc. Natl. Acad. Sci. USA.</source><volume>95</volume><year>1998</year><fpage>1903</fpage><lpage>1908</lpage><pub-id pub-id-ty