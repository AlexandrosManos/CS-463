roup><article-title>Medical outpatients: changes that can benefit patients</article-title><source>Clin Med</source><year>2004</year><volume>4</volume><fpage>45</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">14998266</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bergenmar</surname><given-names>M</given-names></name><name><surname>Nylen</surname><given-names>U</given-names></name><name><surname>Lidbrink</surname><given-names>E</given-names></name><name><surname>Bergh</surname><given-names>J</given-names></name><name><surname>Brandberg</surname><given-names>Y</given-names></name></person-group><article-title>Improvements in patient satisfaction at an outpatient clinic for patients with breast cancer</article-title><source>Acta Oncol</source><year>2006</year><volume>45</volume><fpage>550</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">16864168</pub-id><pub-id pub-id-type="doi">10.1080/02841860500511239</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pothier</surname><given-names>DD</given-names></name><name><surname>Frosh</surname><given-names>A</given-names></name></person-group><article-title>Do information sheets improve patient satisfaction in the out-patient department?</article-title><source>Ann R Coll Surg Engl</source><year>2006</year><volume>88</volume><fpage>557</fpage><lpage>61</lpage><pub-id pub-id-type="pmid">17059717</pub-id><pub-id pub-id-type="doi">10.1308/003588406X117061</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chandra</surname><given-names>A</given-names></name><name><surname>Finlay</surname><given-names>JB</given-names></name><name><surname>Paul</surname><given-names>DP</given-names><suffix>3rd</suffix></name></person-group><article-title>Overall outpatient satisfaction and its components: perceived changes at the Huntington VA Medical Center over five years</article-title><source>Hosp Top</source><year>2006</year><volume>84</volume><fpage>33</fpage><lpage>6</lpage><pub-id pub-id-type="doi">10.3200/HTPS.84.4.33-36</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rao</surname><given-names>KD</given-names></name><name><surname>Peters</surname><given-names>DH</given-names></name><name><surname>Bandeen-Roche</surname><given-names>K</given-names></name></person-group><article-title>Towards patient-centered health services in India &#x02013; a scale to measure patient perceptions of quality</article-title><source>Int J Qual Health Care</source><year>2006</year><volume>18</volume><fpage>414</fpage><lpage>21</lpage><pub-id pub-id-type="pmid">17012306</pub-id><pub-id pub-id-type="doi">10.1093/intqhc/mzl049</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Aletras</surname><given-names>VH</given-names></name><name><surname>Papadopoulos</surname><given-names>EA</given-names></name><name><surname>Niakas</surname><given-names>DA</given-names></name></person-group><article-title>Development and preliminary validation of a Greek-language outpatient satisfaction questionnaire with principal components and multi-trait analyses</article-title><source>BMC Health Serv Res</source><year>2006</year><volume>6</volume><fpage>66</fpage><pub-id pub-id-type="pmid">16756658</pub-id><pub-id pub-id-type="doi">10.1186/1472-6963-6-66</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Labarere</surname><given-names>J</given-names></name><name><surname>Francois</surname><given-names>P</given-names></name><name><surname>Bertrand</surname><given-names>D</given-names></name><name><surname>Peyrin</surname><given-names>JC</given-names></name><name><surname>Robert</