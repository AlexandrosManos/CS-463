itation citation-type="journal"><person-group person-group-type="author"><name><surname>Williams</surname><given-names>S</given-names></name><name><surname>Mustoe</surname><given-names>T</given-names></name><name><surname>Mulcahy</surname><given-names>T</given-names></name><name><surname>Griffiths</surname><given-names>M</given-names></name><name><surname>Simpson</surname><given-names>D</given-names></name><name><surname>Antoniou</surname><given-names>M</given-names></name><name><surname>Irvine</surname><given-names>A</given-names></name><name><surname>Mountain</surname><given-names>A</given-names></name><name><surname>Crombie</surname><given-names>R</given-names></name></person-group><article-title>CpG-island fragments from the HNRPA2B1/CBX3 genomic locus reduce silencing and enhance transgene expression from the hCMV promoter/enhancer in mammalian cells</article-title><source>BMC Biotechnol</source><year>2005</year><volume>5</volume><fpage>17</fpage><pub-id pub-id-type="pmid">15935093</pub-id><pub-id pub-id-type="doi">10.1186/1472-6750-5-17</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Michalon</surname><given-names>A</given-names></name><name><surname>Koshibu</surname><given-names>K</given-names></name><name><surname>Baumgartel</surname><given-names>K</given-names></name><name><surname>Spirig</surname><given-names>DH</given-names></name><name><surname>Mansuy</surname><given-names>IM</given-names></name></person-group><article-title>Inducible and neuron-specific gene expression in the adult mouse brain with the rtTA2S-M2 system</article-title><source>Genesis</source><year>2005</year><volume>43</volume><fpage>205</fpage><lpage>212</lpage><pub-id pub-id-type="pmid">16342161</pub-id><pub-id pub-id-type="doi">10.1002/gene.20175</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kerrison</surname><given-names>J