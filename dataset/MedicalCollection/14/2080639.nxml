on-group person-group-type="author"><name><surname>van Haperen</surname><given-names>R</given-names></name><name><surname>van Tol</surname><given-names>A</given-names></name><name><surname>van Gent</surname><given-names>T</given-names></name><name><surname>Scheek</surname><given-names>L</given-names></name><name><surname>Visser</surname><given-names>P</given-names></name><name><surname>van der Kamp</surname><given-names>A</given-names></name><name><surname>Grosveld</surname><given-names>F</given-names></name><name><surname>de Crom</surname><given-names>R</given-names></name></person-group><article-title>Increased risk of atherosclerosis by elevated plasma levels of phospholipid transfer protein</article-title><source>J Biol Chem</source><year>2002</year><volume>277</volume><fpage>48938</fpage><lpage>48943</lpage><pub-id pub-id-type="pmid">12372822</pub-id><pub-id pub-id-type="doi">10.1074/jbc.M209128200</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maeda</surname><given-names>M</given-names></name><name><surname>Ohashi</surname><given-names>K</given-names></name><name><surname>Ohashi-Kobayashi</surname><given-names>A</given-names></name></person-group><article-title>Further extension of mammalian GATA-6</article-title><source>Dev Growth Differ</source><year>2005</year><volume>47</volume><fpage>591</fpage><lpage>600</lpage><pub-id pub-id-type="pmid">16316404</pub-id><pub-id pub-id-type="doi">10.1111/j.1440-169X.2005.00837.x</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koutsourakis</surname><given-names>M</given-names></name><name><surname>Keijzer</surname><given-names>R</given-names></name><name><surname>Visser</surname><given-names>P</given-names></name><name><surname>Post</surname><given-names>M</given-names></name><name><surname>Tibboel</surname><given-names>D</given-names></name><name><surname>Grosv