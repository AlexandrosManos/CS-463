 person-group-type="author"><name><surname>Gill</surname><given-names>D</given-names></name><name><surname>Marks</surname><given-names>PL</given-names></name></person-group><year>1991</year><article-title>Tree and shrub seedling colonization of old fiels in central New York.</article-title><source>Ecol Monogr</source><volume>61</volume><fpage>183</fpage><lpage>205</lpage></citation></ref><ref id="pone.0001248-Luo1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Luo</surname><given-names>YQ</given-names></name><name><surname>Wan</surname><given-names>SQ</given-names></name><name><surname>Hui</surname><given-names>DF</given-names></name><name><surname>Wallace</surname><given-names>LL</given-names></name></person-group><year>2001</year><article-title>Acclimatization of soil respiration to warming in a tall grass prairie.</article-title><source>Nature</source><volume>413</volume><fpage>622</fpage><lpage>625</lpage><pub-id pub-id-type="pmid">11675783</pub-id></citation></ref><ref id="pone.0001248-Wardle3"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wardle</surname><given-names>DA</given-names></name><name><surname>Bardgett</surname><given-names>RD</given-names></name><name><surname>Klironomos</surname><given-names>JN</given-names></name><name><surname>Set&#x000e4;l&#x000e4;</surname><given-names>H</given-names></name><name><surname>van der Putten</surname><given-names>WH</given-names></name><etal/></person-group><year>2004</year><article-title>Ecological linkages between aboveground and belowground biota.</article-title><source>Science</source><volume>304</volume><fpage>1629</fpage><lpage>1633</lpage><pub-id pub-id-type="pmid">15192218</pub-id></citation></ref><ref id="pone.0001248-Pennisi1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pennisi</surname><given-names>E</given-names></name></person-group><year>2004</year><article-title>The secret life of fungi.</article-title><source>Science</source><volume>304</volume><fpage>1620</fpage><lpage>1622</lpage><pub-id pub-id-type="pmid">15192215</pub-id></citation></ref><ref id="pone.0001248-Lavelle1"><label>14</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lavelle</surname><given-names>P</given-names></name><name><surname>Spain</surname><given-names>A</given-names></name></person-group><year>2001</year><article-title>Soil ecology.</article-title><publisher-loc>Dordrecht</publisher-loc><publisher-name>Kluwer Academic Publishers</publisher-name><fpage>654</fpage></citation></ref><ref id="pone.0001248-Bardgett1"><label>15</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bardgett</surname><given-names>R</given-names></name></person-group><year>2005</year><article-title>The biology of soil, a community and ecosystem approach.</article-title><publisher-loc>Oxford</publisher-loc><publisher-name>Oxford University Press</publisher-name><fpage>242</fpage></citation></ref><ref id="pone.0001248-Crawley1"><label>16</label><citation citation-type="book"><person-group person-group-type="editor"><name><surname>Crawley</surname><given-names>MJ</given-names></name></person-group><year>1996</year><article-title>Plant ecology.</article-title><publisher-loc>Oxford, UK</publisher-loc><publisher-name>Blackwell Science</publisher-name><fpage>717</fpage></citation></ref><ref id="pone.0001248-Gurevitch1"><label>17</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gurevitch</surname><given-names>J</given-names></name><name><surname>Scheiner</surname><given-names>SM</given-names></name><name><surname>Fox</surname><given-names>GA</given-names></name></person-group><year>2006</year><article-title>The ecology of plants.</article-title><publisher-loc>Sunderland</publisher-loc><publisher-name>Sinauer Asso