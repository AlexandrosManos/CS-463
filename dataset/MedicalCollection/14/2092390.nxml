<person-group person-group-type="author"><name><surname>Corrigan</surname><given-names>DP</given-names></name><name><surname>Kuszczak</surname><given-names>D</given-names></name><name><surname>Rusinol</surname><given-names>AE</given-names></name><name><surname>Thewke</surname><given-names>DP</given-names></name><name><surname>Hrycyna</surname><given-names>CA</given-names></name><etal/></person-group><year>2005</year><article-title>Prelamin A endoproteolytic processing in vitro by recombinant Zmspte24.</article-title><source>Biochemical Journal</source><fpage>129</fpage><lpage>138</lpage><pub-id pub-id-type="pmid">15479156</pub-id></citation></ref><ref id="pone.0001269-Rankin1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rankin</surname><given-names>J</given-names></name><name><surname>Ellard</surname><given-names>S</given-names></name></person-group><year>2006</year><article-title>The laminopathies: a clinical review.</article-title><source>Clinical Genetics</source><volume>70</volume><fpage>261</fpage><lpage>274</lpage><pub-id pub-id-type="pmid">16965317</pub-id></citation></ref><ref id="pone.0001269-Worman1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Worman</surname><given-names>HJ</given-names></name><name><surname>Bonne</surname><given-names>G</given-names></name></person-group><year>2007</year><article-title>&#x0201c;laminopathies&#x0201d;: a wide spectrum of human diseases.</article-title><source>Experimental Cell Research</source><volume>313</volume><fpage>2121</fpage><lpage>2133</lpage><pub-id pub-id-type="pmid">17467691</pub-id></citation></ref><ref id="pone.0001269-Capell1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Capell</surname><given-names>BC</given-names></name><name><surname>Collins</surname><given-names>FS</given-names></name></person-group><year>2006</year><article-title>Human laminopathies: nuclei gone genetically awry.</article-title><source>Nature Review Genetics</source><volume>7</volume><fpage>940</fpage><lpage>952</lpage></citation></ref><ref id="pone.0001269-Yu1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yu</surname><given-names>CE</given-names></name><name><surname>Oshima</surname><given-names>J</given-names></name><name><surname>Fu</surname><given-names>YH</given-names></name><name><surname>Wijsman</surname><given-names>EM</given-names></name><name><surname>Hisama</surname><given-names>F</given-names></name><etal/></person-group><year>1996</year><article-title>Positional cloning of the Werner's syndrome gene.</article-title><source>Science</source><volume>272</volume><fpage>258</fpage><lpage>262</lpage><pub-id pub-id-type="pmid">8602509</pub-id></citation></ref><ref id="pone.0001269-Csoka1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Csoka</surname><given-names>AB</given-names></name><name><surname>Cao</surname><given-names>H</given-names></name><name><surname>Sammak</surname><given-names>JP</given-names></name><name><surname>Constantinescu</surname><given-names>D</given-names></name><name><surname>Schatten</surname><given-names>GP</given-names></name><etal/></person-group><year>2004</year><article-title>Novel lamin A/C gene (LMNA) mutations in atypical progeroid syndromes.</article-title><source>Journal of Medical Genetic</source><volume>41</volume><fpage>304</fpage><lpage>308</lpage></citation></ref><ref id="pone.0001269-Plasilova1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Plasilova</surname><given-names>M</given-names></name><name><surname>Chattopadhyay</surname><given-names>C</given-names></name><name><surname>Pal</surname><given-names>P</given-names></name><name><surname>Schaub</surname><given-names>NA</given-names></name><name><surname>Buechner</surname><given-names>SA</given-names></name><etal/></person-group><year>2004</year><article-title>Homozygous missense mutation in the lamin A/C gene causes autosomal recessive Hutchinson-Gilford progeria syndrome.</article-title><source>Journal of Medical Genetic</source><volume>41</volume><fpage>609</fpage><lpage>614</lpage></citation></ref><ref id="pone.0001269-Cao1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cao</surname><given-names>H</given-names></name><name><surname>Hegele</surname><given-names>RA</given-names></name></person-group><year>2003</year><article-title>LMNA is mutated in Hutchinson-Gilford progeria (MIM 176670) but not in Wiedemann-Rautenstrauch progeroid syndrome (MIM 264090).</article-title><source>Journal of Human Genetics</source><volume>48</volume><fpage>271</fpage><lpage>274</lpage><pub-id pub-id-type="pmid">12768443</pub-id></citation></ref><ref id="pone.0001269-Brown1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>WT</given-names></name><name><surname>Kieras</surname><given-names>FJ</given-names></name><name><surname>Houck</surname><given-names>GE</given-names></name><name><surname>Dutkowski</surname><given-names>R</given-names></name><name><surname>Jenkins</surname><given-names>EC</given-names></name></person-group><year>1985</year><article-title>A comparison of adult and childhood progerias: Werner syndrome and Hutchinson Gilford syndrome.</article-title><source>Advance Experimental Medical Biology</source><volume>190</volume><fpage>229</fpage><lpage>244</lpage></citation></ref><ref id="pone.0001269-Fernandez1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fernandez</surname><given-names>FP</given-names></name><name><surname>Mc Laren</surname><given-names>AT</given-names></name><name><surname>Slowi