n="1" colspan="1"/><td align="center" rowspan="1" colspan="1">24 (1.7)</td></tr><tr><td align="left" rowspan="1" colspan="1">Gestational age (days)</td><td align="right" rowspan="1" colspan="1">1,399</td><td align="center" rowspan="1" colspan="1">280.4 &#x000b1; 11.0</td></tr><tr><td align="left" rowspan="1" colspan="1">Preterm birth (&#x0003c; 259 days)</td><td align="right" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">53 (3.8)</td></tr><tr><td align="left" rowspan="1" colspan="1">Post-term (&#x02265; 294 days)</td><td align="right" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">139 (9.9)</td></tr></tbody></table><table-wrap-foot><fn id="tfn2-ehp0115-001677"><p>Values are mean &#x000b1; SD or no. (%).</p></fn><fn id="tfn3-ehp0115-001677"><label>a</label><p>A total of 1,399 first maternal blood samples were analyzed because one blood sample was missing.</p></fn></table-wrap-foot></table-wrap><table-wrap id="t3-ehp0115-001677" position="float"><label>Table 3</label><caption><p>Adjusted regression coefficients [&#x003b2; (95% CI)] between PFOS and PFOA (ng/mL) in first maternal blood during pregnancy and birth weight (g).</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1">Strata</th><th align="center" rowspan="1" colspan="1">PFOS</th><th align="center" rowspan="1" colspan="1">PFOA</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">All<xref ref-type="table-fn" rid="tfn4-ehp0115-001677">a</xref></td><td align="center" rowspan="1" colspan="1">&#x02212;0.46 (&#x02212;2.34 to 1.41)</td><td align="center" rowspan="1" colspan="1">&#x02212;10.63 (&#x02212;20.79 to &#x02212;0.47)</td></tr><tr><td colspan="3" align="left" rowspan="1">Term of birth<xref ref-type="table-fn" rid="tfn4-ehp0115-001677">a</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Preterm</td><td align="center" rowspan="1" colspan="1">&#x02212;2.27 (&#x02212;20.94 to 16.40)</td><