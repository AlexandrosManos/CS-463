/heapol/13.2.152</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Achrya</surname><given-names>LB</given-names></name><name><surname>Cleland</surname><given-names>J</given-names></name></person-group><article-title>Maternal health services in rural Nepal: does access or quality matter more?</article-title><source>Health Pol Plan</source><year>2000</year><volume>15</volume><fpage>223</fpage><lpage>229</lpage><pub-id pub-id-type="doi">10.1093/heapol/15.2.223</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eijk van</surname><given-names>MA</given-names></name><name><surname>Bles</surname><given-names>MH</given-names></name><name><surname>Odhiambo</surname><given-names>F</given-names></name><name><surname>Ayisi</surname><given-names>GJ</given-names></name><name><surname>Blokland</surname><given-names>EI</given-names></name><name><surname>Rosen</surname><given-names>HD</given-names></name><name><surname>Adazu</surname><given-names>K</given-names></name><name><surname>Slutsker</surname><given-names>L</given-names></name><name><surname>Lindblade</surname><given-names>AK</given-names></name></person-group><article-title>Use of antenatal and delivery care among women in rural western Kenya: a community based survey</article-title><source>Reprod Health</source><year>2006</year><volume>3</volume><fpage>2</fpage><pub-id pub-id-type="pmid">16597344</pub-id><pub-id pub-id-type="doi">10.1186/1742-4755-3-2</pub-id></citation></ref><ref id="B26"><citation citation-type="other"><person-group person-group-type="author"><collab>World Health Organization (WHO)</collab></person-group><article-title>Country Health Profile Nepal</article-title><source>WHO, Regional Office for South-East Asia</source><year>2004</year></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simkhada</surname><given-names>B</given-names></name><name><surname>van Teijlingen</surname><given-names>E</given-names></name><name><surname>Porter</surname><given-names>M</given-names></name><name><surname>Simkhada</surname><given-names>P</given-names></name></person-group><article-title>Major problems and key issues in maternal health in Nepal (Review article)</article-title><source>Kathmandu Uni Med J</source><year>2006</year><volume>4</volume><fpage>258</fpage><lpage>263</lpage></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sharma</surname><given-names>B</given-names></name></person-group><article-title>Utilisation of Antenatal Care Services in Nepal</article-title><source>Nepal Pop J</source><year>2004</year><volume>11</volume><fpage>79</fpage><lpage>97</lpage></citation></ref></ref-list></back></article>