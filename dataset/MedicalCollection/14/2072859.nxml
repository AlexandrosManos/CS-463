uene</article-title><source>Int Arch Occup Environ Health</source><volume>62</volume><issue>1</issue><fpage>65</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">2295524</pub-id></citation></ref><ref id="b20-ehp0115-001609"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barrow</surname><given-names>CS</given-names></name><name><surname>Alarie</surname><given-names>Y</given-names></name><name><surname>Stock</surname><given-names>MF</given-names></name></person-group><year>1978</year><article-title>Sensory irritation and incapacitation evoked by thermal decomposition products of polymers and comparisons with known sensory irritants</article-title><source>Arch Environ Health</source><volume>33</volume><issue>2</issue><fpage>79</fpage><lpage>88</lpage><pub-id pub-id-type="pmid">206213</pub-id></citation></ref><ref id="b21-ehp0115-001609"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barrow</surname><given-names>CS</given-names></name><name><surname>Alarie</surname><given-names>Y</given-names></name><name><surname>Warrick</surname><given-names>JC</given-names></name><name><surname>Stock</surname><given-names>MF</given-names></name></person-group><year>1977</year><article-title>Comparison of the sensory irritation response in mice to chlorine and hydrogen chloride</article-title><source>Arch Environ Health</source><volume>32</volume><fpage>68</fpage><lpage>76</lpage><pub-id pub-id-type="pmid">849012</pub-id></citation></ref><ref id="b22-ehp0115-001609"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Barrow</surname><given-names>CS</given-names></name><name><surname>Buckley</surname><given-names>LA</given-names></name><name><surname>James</surname><given-names>RA</given-names></name><name><surname>Steinhagen</surname><given-names>WH</given-names></name><name><surname>Chang</surname><given-names>JCF</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Barrow</surname><given-names>CS</given-names></name></person-group><year>1986</year><article-title>Sensory irritation: studies on correlation to pathology, structure-activity, tolerance development, and prediction of species differences to nasal injury</article-title><source>Toxicology of Nasal Passages</source><publisher-loc>Washington, DC</publisher-loc><publisher-name>Hemisphere</publisher-name><fpage>101</fpage><lpage>122</lpage></citation></ref><ref id="b23-ehp0115-001609"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Baur</surname><given-names>X</given-names></name></person-group><year>1985</year><source>Isocyanate Hypersensitivity: Final Report to the International Isocyanate Insititute Project E-AB-19, File 10349</source><publisher-loc>Munich, West Germany</publisher-loc><publisher-name>University of Munich</publisher-name></citation></ref><ref id="b24-ehp0115-001609"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Beil</surname><given-names>M</given-names></name><name><surname>Ulmer</surname><given-names>WT</given-names></name></person-group><year>1976</year><article-title>Effect of NO<sub>2</sub> in workroom concentrations on respiratory mechanics and bronchial susceptibility to acetylcholine in normal persons [in German]</article-title><source>Int Arch Occup Environ Health</source><volume>38</volume><issue>1</issue><fpage>31</fpage><lpage>44</lpage><pub-id pub-id-type="pmid">977150</pub-id></citation></ref><ref id="b25-ehp0115-001609"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bender</surname><given-names>JR</given-names></name><name><surname>Mullin</surname><given-names>LS</given-names></name><name><surname>Graepel</surname><given-names>GJ</given-names></name><name><surname>Wilson</surname><given-names>WE</given-names></name></person-group><year>1983</year><article-title>Eye irritation r