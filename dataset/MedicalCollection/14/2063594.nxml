itation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Larocca</surname><given-names>D</given-names></name></person-group><article-title>Gene transfer to mammalian cells using genetically targeted filamentous bacteriophage</article-title><source>FASEB J</source><year>1999</year><volume>13</volume><fpage>727</fpage><lpage>734</lpage><pub-id pub-id-type="pmid">10094933</pub-id></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leenen</surname><given-names>PJ</given-names></name></person-group><article-title>Heterogeneity of mouse spleen dendritic cells: in vivo phagocytic activity, expression of macrophage markers, and subpopulation turnover</article-title><source>J Immunol</source><year>1998</year><volume>160</volume><fpage>2166</fpage><lpage>2173</lpage><pub-id pub-id-type="pmid">9498754</pub-id></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maguire</surname><given-names>CA</given-names></name></person-group><article-title>Recombinant adenovirus type 5 vectors that target DC-SIGN, ChemR23 and alpha(v)beta3 integrin efficiently transduce human dendritic cells and enhance presentation of vectored antigens</article-title><source>Vaccine</source><year>2006</year><volume>24</volume><fpage>671</fpage><lpage>682</lpage><pub-id pub-id-type="pmid">16154247</pub-id></citation></ref><ref id="b25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>March</surname><given-names>JB</given-names></name></person-group><article-title>Genetic immunisation against hepatitis B using whole bacteriophage lambda particles</article-title><source>Vaccine</source><year>2004</year><volume>22</volume><fpage>1666</fpage><lpage>1671</lpage><pub-id pub-id-type="pmid">15068849</pub-id></citation></ref><ref id="b26"><citation citation-type="journal"><person-g