<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">J Cell Biol</journal-id><journal-id journal-id-type="publisher-id">JCB</journal-id><journal-title>The Journal of Cell Biology</journal-title><issn pub-type="ppub">0021-9525</issn><issn pub-type="epub">1540-8140</issn><publisher><publisher-name>The Rockefeller University Press</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">17030979</article-id><article-id pub-id-type="pmc">2064487</article-id><article-id pub-id-type="publisher-id">200609136</article-id><article-id pub-id-type="doi">10.1083/jcb.200609136</article-id><article-categories><subj-group subj-group-type="heading"><subject>News</subject><subj-group><subject>Special Report</subject></subj-group></subj-group></article-categories><title-group><article-title>Full of sound and fury, but signifying something: XVI International AIDS Conference, Toronto, Canada, August 13-18, 2006</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Wells</surname><given-names>William A.</given-names></name></contrib></contrib-group><pub-date pub-type="ppub"><day>9</day><month>10</month><year>2006</year></pub-date><volume>175</volume><issue>1</issue><fpage>6</fpage><lpage>15</lpage><copyright-statement>Copyright &#x000a9; 2006, The Rockefeller University Press</copyright-statement><copyright-year>2006</copyright-year><self-uri xlink:title="pdf" xlink:href="jcb1750006.pdf"/><abstract><p>The biennial AIDS conference is often exhausting and irritating, but it offers a unique view of how science and society interact. It still deserves the support of basic scientists.</p></abstract></article-meta></front></article>