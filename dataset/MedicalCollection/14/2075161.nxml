name><surname>Silberberg</surname><given-names>G</given-names></name><name><surname>Wu</surname><given-names>C</given-names></name><name><surname>Markram</surname><given-names>H</given-names></name></person-group><year>2004</year><article-title>Synaptic dynamics control the timing of neuronal excitation in the activated neocortical microcircuit.</article-title><source>J Physiol</source><volume>556</volume><fpage>19</fpage><lpage>27</lpage><pub-id pub-id-type="pmid">14978208</pub-id></citation></ref><ref id="pone.0001209-Reig1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reig</surname><given-names>R</given-names></name><name><surname>Sanchez-Vives</surname><given-names>MV</given-names></name></person-group><year>2007</year><article-title>Synaptic transmission and plasticity in an active cortical network.</article-title><source>PLoS ONE</source><volume>2</volume><fpage>e670</fpage><pub-id pub-id-type="pmid">17668052</pub-id></citation></ref><ref id="pone.0001209-Andrew1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Andrew</surname><given-names>RD</given-names></name><name><surname>Adams</surname><given-names>JR</given-names></name><name><surname>Polischuk</surname><given-names>TM</given-names></name></person-group><year>1996</year><article-title>Imaging NMDA- and kainate-induced intrinsic optical signals from the hippocampal slice.</article-title><source>J Neurophysiol</source><volume>76</volume><fpage>2707</fpage><lpage>2717</lpage><pub-id pub-id-type="pmid">8899640</pub-id></citation></ref><ref id="pone.0001209-Arvanov1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arvanov</surname><given-names>VL</given-names></name><name><surname>Wang</surname><given-names>RY</given-names></name></person-group><year>1997</year><article-title>NMDA-induced response in pyramidal neurons of the rat me