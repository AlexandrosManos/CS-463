tion></ref><ref id="pone.0001209-Robinson1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Robinson</surname><given-names>HP</given-names></name></person-group><year>1994</year><article-title>Conductance injection.</article-title><source>Trends Neurosci</source><volume>17</volume><fpage>147</fpage><lpage>148</lpage><pub-id pub-id-type="pmid">7517591</pub-id></citation></ref><ref id="pone.0001209-Harsch1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harsch</surname><given-names>A</given-names></name><name><surname>Robinson</surname><given-names>HP</given-names></name></person-group><year>2000</year><article-title>Postsynaptic variability of firing in rat cortical neurons: the roles of input synchronization and synaptic NMDA receptor conductance.</article-title><source>J Neurosci</source><volume>20</volume><fpage>6181</fpage><lpage>6192</lpage><pub-id pub-id-type="pmid">10934268</pub-id></citation></ref><ref id="pone.0001209-Robinson2"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Robinson</surname><given-names>HP</given-names></name><name><surname>Kawai</surname><given-names>N</given-names></name></person-group><year>1993</year><article-title>Injection of digitally synthesized synaptic conductance transients to measure the integrative properties of neurons.</article-title><source>J Neurosci Methods</source><volume>49</volume><fpage>157</fpage><lpage>165</lpage><pub-id pub-id-type="pmid">7903728</pub-id></citation></ref><ref id="pone.0001209-London1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>London</surname><given-names>M</given-names></name><name><surname>Schreibman</surname><given-names>A</given-names></name><name><surname>H&#x000e4;usser</surname><given-names>M</given-names></name><name><surname>Larkum</surname><given-nam