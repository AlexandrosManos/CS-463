CT</article-title><source>Radiology</source><year>2000</year><volume>214</volume><fpage>231</fpage><lpage>236</lpage><pub-id pub-id-type="pmid">10644130</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Okahara</surname><given-names>M</given-names></name><name><surname>Kiyosue</surname><given-names>H</given-names></name><name><surname>Hori</surname><given-names>Y</given-names></name><name><surname>Matsumoto</surname><given-names>A</given-names></name><name><surname>Mori</surname><given-names>H</given-names></name><name><surname>Yokoyama</surname><given-names>S</given-names></name></person-group><article-title>Parotid tumors: MR imaging with pathological correlation</article-title><source>Eur Radiol</source><year>2003</year><volume>13</volume><fpage>L25</fpage><lpage>L33</lpage><pub-id pub-id-type="pmid">15018162</pub-id><pub-id pub-id-type="doi">10.1007/s00330-003-1999-0</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ikeda</surname><given-names>K</given-names></name><name><surname>Yoshida</surname><given-names>F</given-names></name><name><surname>Suzuki</surname><given-names>H</given-names></name><name><surname>Oshima</surname><given-names>T</given-names></name><name><surname>Hirano</surname><given-names>K</given-names></name><name><surname>Takasaka</surname><given-names>T</given-names></name></person-group><article-title>A case report of salivary duct carcinoma</article-title><source>Tohoku J Exp Med</source><year>1997</year><volume>183</volume><fpage>233</fpage><lpage>238</lpage><pub-id pub-id-type="pmid">9550131</pub-id><pub-id pub-id-type="doi">10.1620/tjem.183.233</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Donath</surname><given-names>K</given-names></name><name><surname>Seifert</surname><given-names>G</given-names></name><name><surname>Schmitz</surname><given-names>R</given-names></name></person-group><article-title>[Diagnosis and ultrastructure of the tubular carcinoma of salivary gland ducts. Epithelial-myoepithelial carcinoma of the intercalated ducts]</article-title><source>Virchows Arch A Pathol Pathol Anat</source><year>1972</year><volume>356</volume><fpage>16</fpage><lpage>31</lpage><comment>[Article in German]</comment><pub-id pub-id-type="pmid">4340536</pub-id><pub-id pub-id-type="doi">10.1007/BF00543554</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Witterick</surname><given-names>IJ</given-names></name><name><surname>Noyek</surname><given-names>AM</given-names></name><name><surname>Chapnik</surname><given-names>JS</given-names></name><name><surname>Heathcote</surname><given-names>JG</given-names></name><name><surname>Bedard</surname><given-names>YC</given-names></name></person-group><article-title>Observation on the natural history of a parotid epithelial-myoepithelial carcinoma of intercalated ducts</article-title><source>J Otolaryngol</source><year>1993</year><volume>22</volume><fpage>176</fpage><lpage>179</lpage><pub-id pub-id-type="pmid">8396653</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Silvers</surname><given-names>AR</given-names></name><name><surname>Som</surname><given-names>PM</given-names></name><name><surname>Brandwein</surname><given-names>MR</given-names></name></person-group><article-title>Epithelial-myoepithelial carcinoma of the parotid gland</article-title><source>Am J Neuroradiol</source><year>1996</year><volume>17</volume><fpage>560</fpage><lpage>562</lpage><pub-id pub-id-type="pmid">8881253</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ta&#x0015f;</surname><given-names>A</given-names></name><name><surname>Ya&#x0011f;iz</surname><given-names>R</given-names></name><name><surname>Altaner</surname><given-names>S</given-names></name><name><surname>Koten</surname><given-names>M</given-names></name><name><surname>Karasalihoglu</surname><given-names>AR</given-names></name></person-group><article-title>A case of epithelial-myoepithelial carcinoma of the parotid gland</article-title><source>Kulak Burun Bogaz Ihtis Derg</source><year>2003</year><volume>10</volume><fpage>171</fpage><lpage>174</lpage><pub-id pub-id-type="pmid">12941990</pub-id></citation></ref></ref-list></back></article>