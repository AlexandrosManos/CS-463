ychosom Res</source><year>1992</year><volume>36</volume><fpage>417</fpage><lpage>424</lpage><pub-id pub-id-type="pmid">1619582</pub-id><pub-id pub-id-type="doi">10.1016/0022-3999(92)90002-J</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wise</surname><given-names>TN</given-names></name><name><surname>Mann</surname><given-names>LS</given-names></name></person-group><article-title>The relationship between somatosensory amplification, alexithymia, and neuroticism</article-title><source>J Psychosom Res</source><year>1994</year><volume>38</volume><fpage>515</fpage><lpage>521</lpage><pub-id pub-id-type="pmid">7990059</pub-id><pub-id pub-id-type="doi">10.1016/0022-3999(94)90048-5</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Taylor</surname><given-names>GJ</given-names></name></person-group><article-title>Recent developments in alexithymia theory and research</article-title><source>Can J Psychiatry</source><year>2000</year><volume>45</volume><fpage>134</fpage><lpage>142</lpage><pub-id pub-id-type="pmid">10742872</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kosturek</surname><given-names>A</given-names></name><name><surname>Gregory</surname><given-names>RJ</given-names></name><name><surname>Sousou</surname><given-names>AJ</given-names></name><name><surname>Trief</surname><given-names>P</given-names></name></person-group><article-title>Alexithymia and somatic amplification in chronic pain</article-title><source>Psychosomatics</source><year>1998</year><volume>39</volume><fpage>399</fpage><lpage>404</lpage><pub-id pub-id-type="pmid">9775696</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jones</surname><given-names>MP</given-names></name><name><surname>