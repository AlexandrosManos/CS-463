-names>G</given-names></name><name><surname>G&#x000fc;ne&#x0015f;</surname><given-names>Z</given-names></name><name><surname>Ozdemir</surname><given-names>H</given-names></name></person-group><article-title>'Primary malignant lymphoma of the bladder. A case report and review of the literature'</article-title><source>International Urology and Nephrology</source><year>1997</year><volume>29</volume><fpage>319</fpage><lpage>322</lpage><pub-id pub-id-type="pmid">9285304</pub-id><pub-id pub-id-type="doi">10.1007/BF02550929</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bhansali</surname><given-names>SK</given-names></name><name><surname>Cameron</surname><given-names>KM</given-names></name></person-group><article-title>' Primary Malignant Lymphoma of the Bladder'</article-title><source>British Journal of Urology</source><year>1960</year><volume>32</volume><fpage>440</fpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sharma</surname><given-names>A</given-names></name><name><surname>Singh</surname><given-names>AB</given-names></name></person-group><article-title>'Primary Lymphoma Of Urinary Bladder: Report Of An Unusual Case And Literature Review</article-title><source>'The Internet Journal of Urology'</source><year>2002</year><volume>1</volume></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guthman</surname><given-names>DA</given-names></name><name><surname>Malek</surname><given-names>RS</given-names></name><name><surname>Chapman</surname><given-names>WR</given-names></name><name><surname>Farrow</surname><given-names>GM</given-names></name></person-group><article-title>'Primary Malignant Lymphoma of the Bladder'</article-title><source>The Journal of Urology</source><year>1990</year><volume>144</volume><fpage>1367</fpage><lpage>1369</lpage><pub-id pub-id-type="pmid">2231929</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pontius</surname><given-names>EE</given-names></name><name><surname>Nourse</surname><given-names>MH</given-names></name><name><surname>Paz</surname><given-names>L</given-names></name><name><surname>McCallum</surname><given-names>DC</given-names></name></person-group><article-title>'Primary Malignant Lymphomas of the Bladder'</article-title><source>The Journal of Urology</source><year>1963</year><volume>90</volume><fpage>58</fpage><lpage>61</lpage><pub-id pub-id-type="pmid">14047853</pub-id></citation></ref></ref-list></back></article>