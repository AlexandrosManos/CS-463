other"><person-group person-group-type="author"><name><surname>Shi-an</surname><given-names>Y</given-names></name></person-group><article-title>The Status of Micronutrients and the Efficiency of Intervention in China</article-title><source>Paper presented at a workshop on "Successful Micronutrient Programs" at the International Union of Nutritional Sciences, Vienna, Case study</source><year>2001</year><ext-link ext-link-type="uri" xlink:href="http://www.inffoundation.org"/></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jonas</surname><given-names>D</given-names></name><name><surname>K&#x000e4;ferstein</surname><given-names>F</given-names></name></person-group><article-title>Genetic Modification and Food Safety</article-title><source>Biotechnol Dev Monit</source><year>2003</year><volume>25</volume><fpage>11</fpage><lpage>14</lpage></citation></ref><ref id="B18"><citation citation-type="other"><person-group person-group-type="author"><collab>United States Department of Commerce &#x02013; International Trade Administration</collab></person-group><article-title>Protecting your Intellectual Property Rights in China</article-title><year>2003</year><ext-link ext-link-type="uri" xlink:href="http://www.mac.doc.gov/China/Docs/BusinessGuides/IntellectualPropertyRights.htm"/></citation></ref><ref id="B19"><citation citation-type="other"><person-group person-group-type="author"><collab>International Center for Tropical Agriculture (CIAT) and International Food Policy Research Institute (IFPRI)</collab></person-group><article-title>Biofortified Crops for Improved Human Nutrition, International Food Policy Research Institute (IFPRI)</article-title><source>Washington, DC</source><year>2002</year></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lyons</surname><given-names>GH</given-names></name><name><surname>Stangoulis</surname><given-names>JC</given-names></name><name><surname>Graham</surname><given-names>RD</given-names></name></person-group><article-title>Exploiting micronutrient interaction to optimize biofortification programs: the case for inclusion of selenium and iodine in the HarvestPlus program</article-title><source>Nutr Rev</source><year>2004</year><volume>62</volume><fpage>247</fpage><lpage>252</lpage><pub-id pub-id-type="pmid">15291398</pub-id><pub-id pub-id-type="doi">10.1301/nr2004.jun247-252</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Timmer</surname><given-names>CP</given-names></name></person-group><article-title>Biotechnology and food systems in developing countries</article-title><source>J Nutr</source><year>2003</year><volume>133</volume><fpage>3319</fpage><lpage>22</lpage><pub-id pub-id-type="pmid">14608038</pub-id></citation></ref></ref-list></back></article>