"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vos</surname><given-names>CMP</given-names></name><name><surname>Geurts</surname><given-names>JJG</given-names></name><name><surname>Montagne</surname><given-names>L</given-names></name><name><surname>van Haastert</surname><given-names>ES</given-names></name><name><surname>B&#x000f6;</surname><given-names>L</given-names></name><etal/></person-group><year>2005</year><article-title>Blood-brain barrier alterations in both focal and diffuse abnormalities on postmortem MRI in multiple sclerosis.</article-title><source>Neurobiol Dis</source><volume>20</volume><fpage>953</fpage><lpage>960</lpage><pub-id pub-id-type="pmid">16039866</pub-id></citation></ref><ref id="pone.0001205-Noble1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Noble</surname><given-names>LJ</given-names></name><name><surname>Wrathall</surname><given-names>JR</given-names></name></person-group><year>1989</year><article-title>Distribution and time course of protein extravasation in the rat spinal cord after contusive injury.</article-title><source>Brain Res</source><volume>482</volume><fpage>57</fpage><lpage>66</lpage><pub-id pub-id-type="pmid">2706482</pub-id></citation></ref><ref id="pone.0001205-Olsson1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Olsson</surname><given-names>Y</given-names></name><name><surname>Sharma</surname><given-names>HS</given-names></name><name><surname>Pettersson</surname><given-names>A</given-names></name><name><surname>Cervos-Navarro</surname><given-names>J</given-names></name></person-group><year>1992</year><article-title>Release of endogenous neurochemicals may increase vascular permeability, induce edema and influence cell changes in trauma to the spinal cord.</article-title><source>Prog Brain Res</source><volume>91</volume><fpage>197</fpage><lpage>203</lpage><pub-id pub-id-type="pmid">1384082</pub-id></citation></ref><ref id="pone.0001205-Gordh1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gordh</surname><given-names>T</given-names></name><name><surname>Chu</surname><given-names>H</given-names></name><name><surname>Sharma</surname><given-names>HS</given-names></name></person-group><year>2006</year><article-title>Spinal nerve lesion alters blood-spinal cord barrier function and activated astrocytes in the rat.</article-title><source>Pain</source><volume>124</volume><fpage>211</fpage><lpage>221</lpage><pub-id pub-id-type="pmid">16806707</pub-id></citation></ref><ref id="pone.0001205-Miller1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Miller</surname><given-names>RG</given-names></name><name><surname>Anderson</surname><given-names>FJ</given-names></name><name><surname>Bradley</surname><given-names>WG</given-names></name><name><surname>Brooks</surname><given-names>BR</given-names></name><name><surname>Mitsumoto</surname><given-names>H</given-names></name><etal/></person-group><year>2000</year><article-title>The ALS patient care database: goals, design, and early results. ALS C.A.R.E. Study Group.</article-title><source>Neurology</source><volume>54</volume><fpage>53</fpage><lpage>57</lpage><pub-id pub-id-type="pmid">10636125</pub-id></citation></ref><ref id="pone.0001205-Rowland1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rowland</surname><given-names>LP</given-names></name><name><surname>Shneider</surname><given-names>NA</given-names></name></person-group><year>2001</year><article-title>Amyotrophic lateral sclerosis.</article-title><source>New Engl J Med</source><volume>344</volume><fpage>1688</fpage><lpage>1700</lpage><pub-id pub-id-type="pmid">11386269</pub-id></citation></ref><ref id="pone.0001205-Cleveland1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cleveland</surname><given-names>DW</given-names></name><name><surname>Rothstein</surname><given-names>JD</given-names></name></person-group><year>2001</year><article-title>From Charcot to Lou Gehrig: deciphering selective motor neuron death in ALS.</article-title><source>Nat Rev Neurosci</source><volume>2</volume><fpage>806</fpage><lpage>819</lpage><pub-id pub-id-type="pmid">11715057</pub-id></citation></ref><ref id="pone.0001205-Bruijn1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bruijn</surname><given-names>L</given-names></name><name><surname>Miller</surname><given-names>TM</given-names></name><name><surname>Cleveland</surname><given-names>DW</given-names></name></person-group><year>2004</year><article-title>Unraveling the mechanisms involved in motor neuron degeneration in ALS.</article-title><source>Annu Rev Neurosci</source><volume>27</volume><fpage>723</fpage><lpage>749</lpage><pub-id pub-id-type="pmid">15217349</pub-id></citation></ref><ref id="pone.0001205-Strong1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Strong</surname><given-names>MJ</given-names></name><name><surname>Kesavapany</surname><given-names>S</given-names></name><name><surname>Pant</surname><given-names>HC</given-names></name></person-group><year>2005</year><article-title>The pathobiology of amyotrophic lateral sclerosis: a proteinopathy?</article-title><source>J Neuropathol Exp Neurol</source><volume>64</volume><fpage>649</fpage><lpage>664</lpage><pub-id pub-id-type="pmid">16106213</pub-id></citation></ref><ref id="pone.0001205-Alexianu1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Alexianu</surname><given-names>ME</given-names></name></person-group><year>1995</year><article-title>The role of immune processes in amyotrophic lateral sclerosis pathogenesis.</article-title><source>Rom J Neurol Psychiatry</source><volume>33</volume><fpage>215</fpage><lpage>227</lpage><pub-id pub-id-type="pmid">8729177</pub-id></citation></ref><ref id="pone.0001205-Alexianu2"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Alexianu</surname><given-names>ME</given-names></name><name><surname>Kozovska</surname><given-names>M</given-names></name><name><surname>Appel</surname><given-names>SH</given-names></name></person-group><year>2001</year><article-title>Immune reactivity in a mouse model of familial ALS correlates with disease progression.</article-title><source>Neurology</source><volume>57</volume><fpage>1282</fpage><lpage>1289</lpage><pub-id pub-id-type="pmid">11591849</pub-id></citation></ref><ref id="pone.0001205-Appel1"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Appel</surname><given-names>SH</given-names></name><name><surname>Smith</surname><given-names>RG</given-names></name><name><surname>Engelhardt</surname><given-names>JI</given-names></name><name><surname>Stefani</surname><given-names>E</given-names></name></person-group><year>1994</year><article-title>Evidence for autoimmunity in amyotrophic lateral sclerosis.</article-title><source>J Neurol Sci</source><volume>124</volume><issue>Suppl</issue><fpage>14</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">7807136</pub-id></citation></ref><ref id="pone.0001205-Kawamata1"><label>27</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kawamata</surname><given-names>T</given-names></name><name><surname>Akiyama</surname><given-names>H</given-names></name><name><surname>Yamada</surname><given-names>T</given-names></name><name><surname>McGeer</surname><given-names>PL</given-names></name></person-group><year>1992</year><article-title>Immunologic reactions in amyotrophic la