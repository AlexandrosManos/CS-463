n<break/>(putative Rab interactor)</td><td colspan="1" rowspan="1" align="center" valign="top">new</td><td colspan="1" rowspan="1" align="center" valign="top">new</td><td colspan="1" rowspan="1" align="char" char="." valign="top">62</td><td colspan="1" rowspan="1" align="char" char="." valign="top">1</td><td colspan="1" rowspan="1" align="char" char="." valign="top">2.28</td><td colspan="1" rowspan="1" align="char" char="." valign="top">0.50</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">45</td><td colspan="1" rowspan="1" align="left" valign="top">gi&#x0007c;4433649</td><td colspan="1" rowspan="1" align="left" valign="top">Syntaxin 8</td><td colspan="1" rowspan="1" align="center" valign="top">&#x02713;</td><td colspan="1" rowspan="1" align="center" valign="top">new</td><td colspan="1" rowspan="1" align="char" char="." valign="top">122</td><td colspan="1" rowspan="1" align="char" char="." valign="top">2</td><td colspan="1" rowspan="1" align="char" char="." valign="top">2.21</td><td colspan="1" rowspan="1" align="char" char="." valign="top">0.52</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top"><italic>46</italic></td><td colspan="1" rowspan="1" align="left" valign="top">gi&#x0007c;13543973</td><td colspan="1" rowspan="1" align="left" valign="top"><italic>IMP (inosine monophosphate dehydrogenase) 2</italic></td><td colspan="1" rowspan="1" align="center" valign="top"><italic>metabolism</italic></td><td colspan="1" rowspan="1" align="center" valign="top">&#x02014;</td><td colspan="1" rowspan="1" align="char" char="." valign="top"><italic>510</italic></td><td colspan="1" rowspan="1" align="char" char="." valign="top"><italic>15</italic></td><td colspan="1" rowspan="1" align="char" char="." valign="top"><italic>2.17</italic></td><td colspan="1" rowspan="1" align="char" char="." valign="top"><italic>0.55</italic></td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">47</td><td colspan="1" rowspan="1" align="left" valign="to