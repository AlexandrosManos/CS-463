son-group person-group-type="author"><name><surname>Hays</surname><given-names>RD</given-names></name><name><surname>Prince-Embury</surname><given-names>S</given-names></name><name><surname>Chen</surname><given-names>H</given-names></name></person-group><source>R-36 HIS: RAND-36 Health Status Inventory</source><year>1998</year><publisher-name>San Antonio, TX: The Psychological Corporation</publisher-name></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McHorney</surname><given-names>CA</given-names></name><name><surname>Kosinski</surname><given-names>M</given-names></name><name><surname>Ware</surname><given-names>JE</given-names></name></person-group><article-title>Comparisons of the costs and quality of norms for the SF-36 health survey collected by mail versus telephone interview: results from a national survey</article-title><source>Med Care</source><year>1994</year><volume>32</volume><fpage>551</fpage><lpage>567</lpage><pub-id pub-id-type="pmid">8189774</pub-id><pub-id pub-id-type="doi">10.1097/00005650-199406000-00002</pub-id></citation></ref><ref id="B19"><citation citation-type="other"><article-title>General Social Survey Codebook</article-title><ext-link ext-link-type="uri" xlink:href="http://webapp.icpsr.umich.edu/GSS/"/></citation></ref></ref-list></back></article>