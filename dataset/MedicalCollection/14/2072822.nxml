n-names></name></person-group><year>1998</year><article-title>Importance of genetic factors in adolescent asthma: a population-based twin-family study</article-title><source>Am J Respir Crit Care Med</source><volume>157</volume><fpage>1073</fpage><lpage>1078</lpage><pub-id pub-id-type="pmid">9563721</pub-id></citation></ref><ref id="b19-ehp0115-001665"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lioy</surname><given-names>PJ</given-names></name><name><surname>Waldman</surname><given-names>JM</given-names></name><name><surname>Buckley</surname><given-names>TJ</given-names></name><name><surname>Butler</surname><given-names>J</given-names></name><name><surname>Pietarinen</surname><given-names>C</given-names></name></person-group><year>1990</year><article-title>The personal, indoor and outdoor concentrations of PM-10 measured in an industrial community during the winter</article-title><source>Atmos Environ</source><volume>24B</volume><fpage>57</fpage><lpage>66</lpage></citation></ref><ref id="b20-ehp0115-001665"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>LJ</given-names></name><name><surname>Slaughter</surname><given-names>JC</given-names></name><name><surname>Larson</surname><given-names>TV</given-names></name></person-group><year>2002</year><article-title>Comparison of light scattering devices and impactors for particulate measurements in indoor, outdoor, and personal environments</article-title><source>Environ Sci Technol</source><volume>36</volume><fpage>2977</fpage><lpage>2986</lpage><pub-id pub-id-type="pmid">12144275</pub-id></citation></ref><ref id="b21-ehp0115-001665"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Long</surname><given-names>CM</given-names></name><name><surname>Suh</surname><given-names>HH</given-names></name><name><surname>Kobzik</surname><given-names>L</given-names></name><name><surn