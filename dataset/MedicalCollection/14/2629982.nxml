="1" colspan="1">23/4</td></tr><tr><td align="left" rowspan="1" colspan="1">BMI kg, m<sup>2</sup></td><td align="left" rowspan="1" colspan="1">24 &#x000b1; 0.9</td><td align="left" rowspan="1" colspan="1">24 &#x000b1; 0.9</td></tr><tr><td align="left" rowspan="1" colspan="1">FEV<sub>1</sub>% predicted</td><td align="left" rowspan="1" colspan="1">33.8% &#x000b1; 7.69%</td><td align="left" rowspan="1" colspan="1">33.6% &#x000b1; 8.04%</td></tr><tr><td align="left" rowspan="1" colspan="1">FVC% predicted</td><td align="left" rowspan="1" colspan="1">73.6% &#x000b1; 14.3%</td><td align="left" rowspan="1" colspan="1">72.7% &#x000b1; 17.7%</td></tr><tr><td align="left" rowspan="1" colspan="1">FEV<sub>1</sub>/FVC% predicted</td><td align="left" rowspan="1" colspan="1">45.92% &#x000b1; 7.1%</td><td align="left" rowspan="1" colspan="1">46.21% &#x000b1; 6.7%</td></tr><tr><td align="left" rowspan="1" colspan="1">TLC% predicted</td><td align="left" rowspan="1" colspan="1">115.8% +/&#x02212; 4.6%</td><td align="left" rowspan="1" colspan="1">116% +/&#x02212; 3%</td></tr><tr><td align="left" rowspan="1" colspan="1">IF% predicted</td><td align="left" rowspan="1" colspan="1">32.1% &#x000b1; 4.3%</td><td align="left" rowspan="1" colspan="1">32.02% +/&#x02212; 5.1%</td></tr><tr><td align="left" rowspan="1" colspan="1">PI max% predicted</td><td align="left" rowspan="1" colspan="1">59.2% +/&#x02212;17.3%</td><td align="left" rowspan="1" colspan="1">59% &#x000b1; 19.1%</td></tr></tbody></table><table-wrap-foot><fn id="tfn1-copd-3-423"><label>*</label><p><bold>Notes:</bold> There was a period of four weeks of run-in between the study entry and the beginning of IMT.</p></fn><fn id="tfn2-copd-3-423"><p><bold>Abbreviations:</bold> BMI, body mass index; IMT, inspiratory muscle training; COPD, chronic obstructive pulmonary disease; FEV<sub>1</sub>, forced expiratory volume in the first second; FEV<sub>1</sub>/FVC, Tiffeneau index; FVC, forced vital capacity; PI max, maximal inspiratory pressure;