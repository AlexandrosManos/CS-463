/volume><fpage>237</fpage><lpage>246</lpage><pub-id pub-id-type="pmid">11784059</pub-id><pub-id pub-id-type="doi">10.1006/dbio.2001.0439</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>A</given-names></name><name><surname>Yates</surname><given-names>PA</given-names></name><name><surname>Burrola</surname><given-names>P</given-names></name><name><surname>Ortuno</surname><given-names>D</given-names></name><name><surname>Vaidya</surname><given-names>A</given-names></name><name><surname>Jessell</surname><given-names>TM</given-names></name><name><surname>Pfaff</surname><given-names>SL</given-names></name><name><surname>O'Leary</surname><given-names>DD</given-names></name><name><surname>Lemke</surname><given-names>G</given-names></name></person-group><article-title>Topographic mapping from the retina to the midbrain is controlled by relative but not absolute levels of EphA receptor signaling</article-title><source>Cell</source><year>2000</year><volume>102</volume><fpage>77</fpage><lpage>88</lpage><pub-id pub-id-type="pmid">10929715</pub-id><pub-id pub-id-type="doi">10.1016/S0092-8674(00)00012-X</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnson</surname><given-names>JK</given-names></name><name><surname>Casagrande</surname><given-names>VA</given-names></name></person-group><article-title>Prenatal development of axon outgrowth and connectivity in the ferret visual system</article-title><source>Vis Neurosci</source><year>1993</year><volume>10</volume><fpage>117</fpage><lpage>130</lpage><pub-id pub-id-type="pmid">8424921</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Livesey</surname><given-names>FJ</given-names></name><name><surname>Cepko</surname><given-names>CL</given-names></name></person-group><article-title>Vertebrate neural cell-fate determination: lessons from the retina</article-title><source>Nat Rev Neurosci</source><year>2001</year><volume>2</volume><fpage>109</fpage><lpage>118</lpage><pub-id pub-id-type="pmid">11252990</pub-id><pub-id pub-id-type="doi">10.1038/35053522</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Herrera</surname><given-names>E</given-names></name><name><surname>Brown</surname><given-names>LY</given-names></name><name><surname>Aruga</surname><given-names>J</given-names></name><name><surname>Rachel</surname><given-names>RA</given-names></name><name><surname>Dolen</surname><given-names>G</given-names></name><name><surname>Mikoshiba</surname><given-names>K</given-names></name><name><surname>Brown</surname><given-names>S</given-names></name><name><surname>Mason</surname><given-names>CA</given-names></name></person-group><article-title>Zic2 patterns binocular vision by specifying the uncrossed retinal projection</article-title><source>Cell</source><year>2003</year><volume>114</volume><fpage>545</fpage><lpage>557</lpage><pub-id pub-id-type="pmid">13678579</pub-id><pub-id pub-id-type="doi">10.1016/S0092-8674(03)00684-6</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Herrera</surname><given-names>E</given-names></name><name><surname>Marcus</surname><given-names>R</given-names></name><name><surname>Li</surname><given-names>S</given-names></name><name><surname>Williams</surname><given-names>SE</given-names></name><name><surname>Erskine</surname><given-names>L</given-names></name><name><surname>Lai</surname><given-names>E</given-names></name><name><surname>Mason</surname><given-names>C</given-names></name></person-group><article-title>Foxd1 is required for proper formation of the optic chiasm</article-title><source>Development</source><year>2004</year><volume>131</volume><fpage>5727</fp