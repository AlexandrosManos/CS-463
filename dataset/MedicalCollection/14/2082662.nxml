d align="left" rowspan="1" colspan="1"><bold>15</bold></td><td align="left" rowspan="1" colspan="1"><bold>5.8</bold></td><td align="left" rowspan="1" colspan="1">0.3</td><td align="left" rowspan="1" colspan="1">0.5</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">AG2E12D1</td><td align="left" rowspan="1" colspan="1">3.7</td><td align="left" rowspan="1" colspan="1">4.2</td><td align="left" rowspan="1" colspan="1"><bold>6.8</bold></td><td align="left" rowspan="1" colspan="1">0.1</td><td align="left" rowspan="1" colspan="1">3.4</td><td align="left" rowspan="1" colspan="1">0.6</td><td align="left" rowspan="1" colspan="1">0</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">AG2H135</td><td align="left" rowspan="1" colspan="1">0.1</td><td align="left" rowspan="1" colspan="1"><bold>12</bold></td><td align="left" rowspan="1" colspan="1">3.5</td><td align="left" rowspan="1" colspan="1">2.3</td><td align="left" rowspan="1" colspan="1"><bold>6.3</bold></td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">0.3</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">AG2H770</td><td align="left" rowspan="1" colspan="1">3.3</td><td align="left" rowspan="1" colspan="1">2.1</td><td align="left" rowspan="1" colspan="1"><bold>9.7</bold></td><td align="left" rowspan="1" colspan="1">0.2</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1"><bold>12</bold></td><td align="left" rowspan="1" colspan="1">0.7</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">AG2H147</td><td align="left" rowspan="1" colspan="1">2.4</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">1.4</td><td align="left" rowspan="1" colspan="1"><bold>5.6</bold></td><td align="left" rowspan="1" colspan="1">0.6</td><td align="left" rowspan="1" colspan="1">0.8</td><td align="left" rowspan="1" colspan="1">3.3</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">AG2H125</td><td align="left" rowspan="1" colspan="1">2.4</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">2.5</td><td align="left" rowspan="1" colspan="1">0.9</td><td align="left" rowspan="1" colspan="1">0.4</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">4.1</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">AG2H786</td><td align="left" rowspan="1" colspan="1">1.1</td><td align="left" rowspan="1" colspan="1">2.2</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">0.3</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1"><bold>5.7</bold></td><td align="left" rowspan="1" colspan="1">4.2</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>2L</italic></td><td align="left" rowspan="1" colspan="1">AG2H796</td><td align="left" rowspan="1" colspan="1">2.8</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">0.4</td><td align="left" rowspan="1" colspan="1"><bold>7.9</bold></td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">2.2</td><td align="left" rowspan="1" colspan="1">2.3</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">AG2H802</td><td align="left" rowspan="1" colspan="1">1.3</td><td align="left" rowspan="1" colspan="1">0.9</td><td align="left" rowspan="1" colspan="1">0.2</td><td align="left" rowspan="1" colspan="1"><bold>6</bold></td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">2.9</td><td align="left" rowspan="1" colspan="1">1.8</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1