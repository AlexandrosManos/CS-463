tal/></person-group><year>2005</year><article-title>An acylation cycle regulates localization and activity of palmitoylated Ras isoforms.</article-title><source>Science</source><volume>307</volume><fpage>1746</fpage><lpage>1752</lpage><pub-id pub-id-type="pmid">15705808</pub-id></citation></ref><ref id="pone.0001204-Rotblat1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rotblat</surname><given-names>B</given-names></name><name><surname>Yizhar</surname><given-names>O</given-names></name><name><surname>Haklai</surname><given-names>R</given-names></name><name><surname>Ashery</surname><given-names>U</given-names></name><name><surname>Kloog</surname><given-names>Y</given-names></name></person-group><year>2006</year><article-title>Ras and its signals diffuse through the cell on randomly moving nanoparticles.</article-title><source>Cancer Res</source><volume>66</volume><fpage>1974</fpage><lpage>1981</lpage><pub-id pub-id-type="pmid">16488996</pub-id></citation></ref><ref id="pone.0001204-Sprent1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sprent</surname><given-names>J</given-names></name></person-group><year>2005</year><article-title>Swapping molecules during cell-cell interactions.</article-title><source>Sci STKE</source><volume>2005</volume><fpage>pe8</fpage><pub-id pub-id-type="pmid">15741541</pub-id></citation></ref><ref id="pone.0001204-Davis1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Davis</surname><given-names>DM</given-names></name></person-group><year>2007</year><article-title>Intercellular transfer of cell-surface proteins is common and can affect many stages of an immune response.</article-title><source>Nat Rev Immunol</source><volume>7</volume><fpage>238</fpage><lpage>243</lpage><pub-id pub-id-type="pmid">17290299</pub-id></citation></ref><ref id="pone.0001204-Joly1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Joly</surname><given-names>E</given-names></name><name><surname>Hudrisier</surname><given-names>D</given-names></name></person-group><year>2003</year><article-title>What is trogocytosis and what is its purpose?</article-title><source>Nat Immunol</source><volume>4</volume><fpage>815</fpage><pub-id pub-id-type="pmid">12942076</pub-id></citation></ref><ref id="pone.0001204-McCann1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McCann</surname><given-names>FE</given-names></name><name><surname>Eissmann</surname><given-names>P</given-names></name><name><surname>Onfelt</surname><given-names>B</given-names></name><name><surname>Leung</surname><given-names>R</given-names></name><name><surname>Davis</surname><given-names>DM</given-names></name></person-group><year>2007</year><article-title>The activating NKG2D ligand MHC class I-related chain A transfers from target cells to NK cells in a manner that allows functional consequences.</article-title><source>J Immunol</source><volume>178</volume><fpage>3418</fpage><lpage>3426</lpage><pub-id pub-id-type="pmid">17339436</pub-id></citation></ref><ref id="pone.0001204-Hudrisier1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hudrisier</surname><given-names>D</given-names></name><name><surname>Aucher</surname><given-names>A</given-names></name><name><surname>Puaux</surname><given-names>AL</given-names></name><name><surname>Bordier</surname><given-names>C</given-names></name><name><surname>Joly</surname><given-names>E</given-names></name></person-group><year>2007</year><article-title>Capture of Target Cell Membrane Components via Trogocytosis Is Triggered by a Selected Set of Surface Molecules on T or B Cells.</article-title><source>J Immunol</source><volume>178</volume><fpage>3637</fpage><lpage>3647</lpage><pub-id pub-id-type="pmid">17339461</pub-id></citation></ref><ref id="pone.0001204-Macia1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Macia</surname><given-names>E</given-names></name><name><surname>Ehrlich</surname><given-names>M</given-names></name><name><surname>Massol</surname><given-names>R</given-names></name><name><surname>Boucrot</surname><given-names>E</given-names></name><name><surname>Brunner</surname><given-names>C</given-names></name><etal/></person-group><year>2006</year><article-title>Dynasore, a cell-permeable inhibitor of dynamin.</article-title><source>Dev Cell</source><volume>10</volume><fpage>839</fpage><lpage>850</lpage><pub-id pub-id-type="pmid">16740485</pub-id></citation></ref><ref id="pone.0001204-Hwang1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hwang</surname><given-names>I</given-names></name><name><surname>Shen</surname><given-names>X</given-names></name><name><surname>Sprent</surname><given-names>J</given-names></name></person-group><year>2003</year><article-title>Direct stimulation of naive T cells by membrane vesicles from antigen-presenting cells: distinct roles for CD54 and B7 molecules.</article-title><source>Proc Natl Acad Sci U S A</source><volume>100</volume><fpage>6670</fpage><lpage>6675</lpage><pub-id pub-id-type="pmid">12743365</pub-id></citation></ref><ref id="pone.0001204-Raposo1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Raposo</surname><given-names>G</given-names></name><name><surname>Nijman</surname><given-names>HW</given-names></name><name><surname>Stoorvogel</surname><given-names>W</given-names></name><name><surname>Liejendekker</surname><given-names>R</given-names></name><name><surname>Harding</surname><given-names>CV</given-names></name><etal/></person-group><year>1996</year><article-title>B lymphocytes secrete antigen-presenting ves