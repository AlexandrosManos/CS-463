isher-name><fpage>479</fpage></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Darren</surname><given-names>G</given-names></name><name><surname>Mallery</surname><given-names>P</given-names></name></person-group><source>Spss/Pct step by step: A simple guide and reference</source><year>1995</year><volume>Chapter 24</volume><publisher-name>Wadsworth publishing company USA</publisher-name></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wingo</surname><given-names>PA</given-names></name><name><surname>Higgins</surname><given-names>JE</given-names></name><name><surname>Rubin</surname><given-names>GL</given-names></name><name><surname>Zahniser</surname><given-names>SC</given-names></name></person-group><source>An epidemiologic approach to reproductive health</source><year>1991</year><publisher-name>Center for disease control (CDC), family health intention(FHI), Atlanta, Georgia USA</publisher-name></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tielemans</surname><given-names>E</given-names></name><name><surname>Heederik</surname><given-names>D</given-names></name><name><surname>Burdorf</surname><given-names>A</given-names></name><name><surname>Vermeulen</surname><given-names>R</given-names></name><name><surname>Veulemans</surname><given-names>H</given-names></name><name><surname>Kromhout</surname><given-names>H</given-names></name><name><surname>Hartog</surname><given-names>K</given-names></name></person-group><article-title>Assessment of occupational exposures in a general population: comparison of different methods</article-title><source>Occup Environ Med</source><year>1999</year><volume>56</volume><fpage>145</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">10448321</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-g