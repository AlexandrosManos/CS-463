><volume>37</volume><fpage>2</fpage><lpage>12</lpage><pub-id pub-id-type="pmid">15902842</pub-id><pub-id pub-id-type="doi">10.1080/07853890410018925</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rodr&#x000ed;guez-Pascual</surname><given-names>F</given-names></name><name><surname>Redondo-Horcajo</surname><given-names>M</given-names></name><name><surname>Lamas</surname><given-names>S</given-names></name></person-group><article-title>Functional cooperation between Smad proteins and activator protein-1 regulates transforming growth factor-&#x003b2;-mediated induction of endothelin-1 expression</article-title><source>Circ Res</source><year>2003</year><volume>92</volume><fpage>1288</fpage><lpage>1295</lpage><pub-id pub-id-type="pmid">12764024</pub-id><pub-id pub-id-type="doi">10.1161/01.RES.0000078491.79697.7F</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shi-Wen</surname><given-names>X</given-names></name><name><surname>Rodriguez-Pascual</surname><given-names>F</given-names></name><name><surname>Lamas</surname><given-names>S</given-names></name><name><surname>Holmes</surname><given-names>A</given-names></name><name><surname>Howat</surname><given-names>S</given-names></name><name><surname>Pearson</surname><given-names>JD</given-names></name><name><surname>Dashwood</surname><given-names>MR</given-names></name><name><surname>du Bois</surname><given-names>RM</given-names></name><name><surname>Denton</surname><given-names>CP</given-names></name><name><surname>Black</surname><given-names>CM</given-names></name><etal></etal></person-group><article-title>Constitutive ALK5-independent c-Jun N-terminal kinase activation contributes to endothelin-1 overexpression in pulmonary fibrosis: evidence of an autocrine endothelin loop operating through the endothelin A and B receptors</article-title><source>Mol Cell Biol</source>