surname>van den Hout</surname><given-names>HA</given-names></name><name><surname>Scherpbier</surname><given-names>AJ</given-names></name><name><surname>van der Vleuten</surname><given-names>CP</given-names></name></person-group><article-title>Predicting communication skills with a paper-and-pencil test</article-title><source>Med Educ</source><year>2002</year><volume>36</volume><fpage>148</fpage><lpage>153</lpage><pub-id pub-id-type="pmid">11869442</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2923.2002.01066.x</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Janssen</surname><given-names>JJ</given-names></name><name><surname>Tan</surname><given-names>LH</given-names></name><name><surname>van der Vleuten</surname><given-names>CP</given-names></name><name><surname>van Luijk</surname><given-names>SD</given-names></name><name><surname>Rethans</surname><given-names>JJ</given-names></name><name><surname>Grol</surname><given-names>RP</given-names></name></person-group><article-title>Assessment of competence in technical clinical skills of general practitioners</article-title><source>Med Educ</source><year>1995</year><volume>29</volume><fpage>247</fpage><lpage>253</lpage><pub-id pub-id-type="pmid">7623721</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Remmen</surname><given-names>R</given-names></name><name><surname>Scherpbier</surname><given-names>A</given-names></name><name><surname>Denekens</surname><given-names>J</given-names></name><name><surname>Derese</surname><given-names>A</given-names></name><name><surname>Hermann</surname><given-names>I</given-names></name><name><surname>Hoogenboom</surname><given-names>R</given-names></name><name><surname>van der Vleuten</surname><given-names>C</given-names></name><name><surname>van Royen</surname><given-names>P</given-names></name><name><surname>Bossaert</surname><giv