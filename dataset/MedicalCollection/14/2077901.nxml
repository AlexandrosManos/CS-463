</name><name><surname>Bradac</surname><given-names>JA</given-names></name><name><surname>Carr</surname><given-names>JK</given-names></name><name><surname>Foley</surname><given-names>B</given-names></name><etal/></person-group><year>2000</year><article-title>HIV-1 nomenclature proposal &#x0005b;letter&#x0005d;</article-title><source>Science</source><volume>288</volume><fpage>55</fpage><lpage>56</lpage><pub-id pub-id-type="pmid">10766634</pub-id></citation></ref><ref id="ppat-0030177-b011"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>DM</given-names></name><name><surname>Richman</surname><given-names>DD</given-names></name><name><surname>Little</surname><given-names>SJ</given-names></name></person-group><year>2005</year><article-title>HIV superinfection</article-title><source>J Infect Dis</source><volume>192</volume><fpage>438</fpage><lpage>444</lpage><pub-id pub-id-type="pmid">15995957</pub-id></citation></ref><ref id="ppat-0030177-b012"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Altfeld</surname><given-names>M</given-names></name><name><surname>Allen</surname><given-names>TM</given-names></name><name><surname>Yu</surname><given-names>XG</given-names></name><name><surname>Johnston</surname><given-names>MN</given-names></name><name><surname>Agrawal</surname><given-names>D</given-names></name><etal/></person-group><year>2002</year><article-title>HIV-1 superinfection despite broad CD8&#x0002b; T-cell responses containing replication of the primary virus</article-title><source>Nature</source><volume>420</volume><fpage>434</fpage><lpage>439</lpage><pub-id pub-id-type="pmid">12459786</pub-id></citation></ref><ref id="ppat-0030177-b013"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gottlieb</surname><given-names>GS</given-names></name><name><surname>Nickle</surname><given-names>DC</given-names></name><name><surname>Jensen</surname><given-names>MA</given-names></name><name><surname>Wong</surname><given-names>KG</given-names></name><name><surname>Grobler</surname><given-names>J</given-names></name><etal/></person-group><year>2004</year><article-title>Dual HIV-1 infection associated with rapid disease progression</article-title><source>Lancet</source><volume>363</volume><fpage>619</fpage><lpage>622</lpage><pub-id pub-id-type="pmid">14987889</pub-id></citation></ref><ref id="ppat-0030177-b014"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brenner</surname><given-names>B</given-names></name><name><surname>Routy</surname><given-names>JP</given-names></name><name><surname>Quan</surname><given-names>Y</given-names></name><name><surname>Moisi</surname><given-names>D</given-names></name><name><surname>Oliveira</surname><given-names>M</given-names></name><etal/></person-group><year>2004</year><article-title>Persistence of multidrug-resistant HIV-1 in primary infection leading to superinfection</article-title><source>AIDS</source><volume>18</volume><fpage>1653</fpage><lpage>1660</lpage><pub-id pub-id-type="pmid">15280776</pub-id></citation></ref><ref id="ppat-0030177-b015"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koelsch</surname><given-names>KK</given-names></name><name><surname>Smith</surname><given-names>DM</given-names></name><name><surname>Little</surname><given-names>SJ</given-names></name><name><surname>Ignacio</surname><given-names>CC</given-names></name><name><surname>Macaranas</surname><given-names>TR</given-names></name><etal/></person-group><year>2003</year><article-title>Clade B HIV-1 superinfection with wild-type virus after primary infection with drug-resistant clade B virus</article-title><source>AIDS</source><volume>17</volume><fpage>F11</fpage><lpage>16</lpage><pub-id pub-id-type="pmid">12700477</pub-id></citation></ref><ref id="ppat-0030177-b016"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yang</surname><given-names>OO</given-names></name><name><surname>Daar</surname><given-names>ES</given-names></name><name><surname>Jamieson</surname><given-names>BD</given-names></name><name><surname>Balamurugan</surname><given-names>A</given-names></name><name><surname>Smith</surname><given-names>DM</given-names></name><etal/></person-group><year>2005</year><article-title>Human immunodeficiency virus type 1 clade B superinfection: evidence for differential immune containment of distinct clade B strains</article-title><source>J Virol</source><volume>79</volume><fpage>860</fpage><lpage>868</lpage><pub-id pub-id-type="pmid">15613314</pub-id></citation></ref><ref id="ppat-0030177-b017"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yerly</surname><given-names>S</given-names></name><name><surname>Jost</surname><given-names>S</given-names></name><name><surname>Monnat</surname><given-names>M</given-names></name><name><surname>Telenti</surname><given-names>A</given-names></name><name><surname>Cavassini</surname><given-names>M</given-names></name><etal/></person-group><year>2004</year><article-title>HIV-1 co/super-infection in intravenous drug users</article-title><source>AIDS</source><volume>18</volume><fpage>1413</fpage><lpage>1421</lpage><pub-id pub-id-type="pmid">15199317</pub-id></citation></ref><ref id="ppat-0030177-b018"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jost</surname><given-names>S</given-names></name><name><surname>Bernard</surname><given-names>MC</given-names></name><name><surname>Kaiser</surname><given-names>L</given-names></name><name><surname>Yerly</surname><given-names>S</given-names></name><name><surname>Hirschel</surname><given-names>B</given-names></name><etal/></person-group><year>2002</year><article-title>A patient with HIV-1 superinfection</article-title><source>N Engl J Med</source><volume>347</vo