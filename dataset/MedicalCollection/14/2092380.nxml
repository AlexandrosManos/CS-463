014"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leitmeyer</surname><given-names>KC</given-names></name><name><surname>Vaughn</surname><given-names>DW</given-names></name><name><surname>Watts</surname><given-names>DM</given-names></name><name><surname>Salas</surname><given-names>R</given-names></name><name><surname>Villalobos</surname><given-names>I</given-names></name><etal/></person-group><year>1999</year><article-title>Dengue virus structural differences that correlate with pathogenesis</article-title><source>J Virol</source><volume>73</volume><fpage>4738</fpage><lpage>4747</lpage><pub-id pub-id-type="pmid">10233934</pub-id></citation></ref><ref id="ppat-0030183-b015"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cologna</surname><given-names>R</given-names></name><name><surname>Rico-Hesse</surname><given-names>R</given-names></name></person-group><year>2003</year><article-title>American genotype structures decrease dengue virus output from human monocytes and dendritic cells</article-title><source>J Virol</source><volume>77</volume><fpage>3929</fpage><lpage>3938</lpage><pub-id pub-id-type="pmid">12634353</pub-id></citation></ref><ref id="ppat-0030183-b016"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pryor</surname><given-names>MJ</given-names></name><name><surname>Carr</surname><given-names>JM</given-names></name><name><surname>Hocking</surname><given-names>H</given-names></name><name><surname>Davidson</surname><given-names>AD</given-names></name><name><surname>Li</surname><given-names>P</given-names></name><etal/></person-group><year>2001</year><article-title>Replication of dengue virus type 2 in human monocyte-derived macrophages: comparisons of isolates and recombinant viruses with substitutions at amino acid 390 in the envelope glycoprotein</article-title><source>Am J Trop Med Hyg</source><volume>65</volume><fpage>427</fpage