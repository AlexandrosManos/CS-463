<article-title>Endogenous retroviruses and the evolution of resistance to retroviral infection</article-title><source>Trends Microbiol</source><volume>5</volume><fpage>313</fpage><lpage>318</lpage><pub-id pub-id-type="pmid">9263409</pub-id></citation></ref><ref id="ppat-0030170-b011"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Ryder</surname><given-names>ML</given-names></name></person-group><year>1983</year><source>Sheep &#x00026; man</source><publisher-loc>London</publisher-loc><publisher-name>Gerald Duckworth &#x00026; Co</publisher-name></citation></ref><ref id="ppat-0030170-b012"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Palmarini</surname><given-names>M</given-names></name><name><surname>Sharp</surname><given-names>JM</given-names></name><name><surname>De las Heras</surname><given-names>M</given-names></name><name><surname>Fan</surname><given-names>H</given-names></name></person-group><year>1999</year><article-title>Jaagsiekte sheep retrovirus is necessary and sufficient to induce a contagious lung cancer in sheep</article-title><source>J Virol</source><volume>73</volume><fpage>6964</fpage><lpage>6972</lpage><pub-id pub-id-type="pmid">10400795</pub-id></citation></ref><ref id="ppat-0030170-b013"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Palmarini</surname><given-names>M</given-names></name><name><surname>Fan</surname><given-names>H</given-names></name></person-group><year>2001</year><article-title>Retrovirus-induced ovine pulmonary adenocarcinoma, an animal model for lung cancer</article-title><source>J Natl Cancer Inst</source><volume>93</volume><fpage>1603</fpage><lpage>1614</lpage><pub-id pub-id-type="pmid">11698564</pub-id></citation></ref><ref id="ppat-0030170-b014"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Palmarini</surname><given-names>M</given-names></name><name><surname>Hallwirth</surname><given-names>C</given-names></name><name><surname>York</surname><given-names>D</given-names></name><name><surname>Murgia</surname><given-names>C</given-names></name><name><surname>de Oliveira</surname><given-names>T</given-names></name><etal/></person-group><year>2000</year><article-title>Molecular cloning and functional analysis of three type D endogenous retroviruses of sheep reveal a different cell tropism from that of the highly related exogenous jaagsiekte sheep retrovirus</article-title><source>J Virol</source><volume>74</volume><fpage>8065</fpage><lpage>8076</lpage><pub-id pub-id-type="pmid">10933716</pub-id></citation></ref><ref id="ppat-0030170-b015"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hecht</surname><given-names>SJ</given-names></name><name><surname>Stedman</surname><given-names>KE</given-names></name><name><surname>Carlson</surname><given-names>JO</given-names></name><name><surname>DeMartini</surname><given-names>JC</given-names></name></person-group><year>1996</year><article-title>Distribution of endogenous type B and type D sheep retrovirus sequences in ungulates and other mammals</article-title><source>Proc Natl Acad Sci U S A</source><volume>93</volume><fpage>3297</fpage><lpage>3302</lpage><pub-id pub-id-type="pmid">8622932</pub-id></citation></ref><ref id="ppat-0030170-b016"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>DeMartini</surname><given-names>JC</given-names></name><name><surname>Carlson</surname><given-names>JO</given-names></name><name><surname>Leroux</surname><given-names>C</given-names></name><name><surname>Spencer</surname><given-names>T</given-names></name><name><surname>Palmarini</surname><given-names>M</given-names></name></person-group><year>2003</year><article-title>Endogenous retroviruses related to jaagsiekte sheep retrovirus</article-title><source>Curr Top Microbiol Immunol</source><volume>275</volume><fpage>1