me><surname>Rao</surname><given-names>C</given-names></name><name><surname>Hemed</surname><given-names>Y</given-names></name><name><surname>Whiting</surname><given-names>DR</given-names></name><name><surname>Yang</surname><given-names>G</given-names></name><name><surname>Chandramohan</surname><given-names>D</given-names></name><name><surname>Alberti</surname><given-names>K</given-names></name><name><surname>Lopez</surname><given-names>AD</given-names></name></person-group><year>2006</year><article-title>Core verbal autopsy procedures with comparative validation results from two countries</article-title><source>PLoS Med</source><volume>3</volume><elocation-id>e268</elocation-id><comment>doi:<ext-link ext-link-type="doi" xlink:href="10.1371/journal.pmed.0030268">10.1371/journal.pmed.0030268</ext-link></comment></citation></ref><ref id="pmed-0040327-b030"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Varmus</surname><given-names>H</given-names></name><name><surname>Klausner</surname><given-names>R</given-names></name><name><surname>Zerhouni</surname><given-names>E</given-names></name><name><surname>Acharya</surname><given-names>T</given-names></name><name><surname>Daar</surname><given-names>AS</given-names></name><etal/></person-group><year>2003</year><article-title>Public health. Grand challenges in global health</article-title><source>Science</source><volume>302</volume><fpage>398</fpage><lpage>399</lpage><pub-id pub-id-type="pmid">14563993</pub-id></citation></ref><ref id="pmed-0040327-b031"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lopman</surname><given-names>BA</given-names></name><name><surname>Barnabas</surname><given-names>RV</given-names></name><name><surname>Boerma</surname><given-names>JT</given-names></name><name><surname>Chawira</surname><given-names>G</given-names></name><name><surname>Gaitskell</surname><given-names>K</given-names></name><etal/></person-group><ye