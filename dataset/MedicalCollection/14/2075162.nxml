pe="pmid">17259969</pub-id></citation></ref><ref id="pone.0001212-Huang1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>Y</given-names></name><name><surname>Burkhardt</surname><given-names>JK</given-names></name></person-group><year>2007</year><article-title>T-cell-receptor-dependent actin regulatory mechanisms.</article-title><source>J Cell Sci</source><volume>120</volume><fpage>723</fpage><lpage>730</lpage><pub-id pub-id-type="pmid">17314246</pub-id></citation></ref><ref id="pone.0001212-Call1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Call</surname><given-names>ME</given-names></name><name><surname>Wucherpfennig</surname><given-names>KW</given-names></name></person-group><year>2005</year><article-title>The T cell receptor: critical role of the membrane environment in receptor assembly and function.</article-title><source>Annu Rev Immunol</source><volume>23</volume><fpage>101</fpage><lpage>125</lpage><pub-id pub-id-type="pmid">15771567</pub-id></citation></ref><ref id="pone.0001212-Cantrell1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cantrell</surname><given-names>D</given-names></name></person-group><year>1996</year><article-title>T cell antigen receptor signal transduction pathways.</article-title><source>Annu Rev Immunol</source><volume>14</volume><fpage>259</fpage><lpage>274</lpage><pub-id pub-id-type="pmid">8717515</pub-id></citation></ref><ref id="pone.0001212-Krautkramer1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Krautkramer</surname><given-names>E</given-names></name><name><surname>Giese</surname><given-names>SI</given-names></name><name><surname>Gasteier</surname><given-names>JE</given-names></name><name><surname>Muranyi</surname><given-names>W</given-names></name><name><surn