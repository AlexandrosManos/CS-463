rticle-title>Emotion and motivation I: defensive and appetitive reactions in picture processing</article-title><source>Emotion</source><year>2001</year><volume>1</volume><fpage>276</fpage><lpage>298</lpage><pub-id pub-id-type="pmid">12934687</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carpenter</surname><given-names>MG</given-names></name><name><surname>Frank</surname><given-names>JS</given-names></name><name><surname>Silcher</surname><given-names>CP</given-names></name></person-group><article-title>Surface height effects on postural control: A hypothesis for a stiffness strategy for stance</article-title><source>J Vestib Res</source><year>1999</year><volume>9</volume><fpage>277</fpage><lpage>286</lpage><pub-id pub-id-type="pmid">10472040</pub-id></citation></ref></ref-list></back></article>