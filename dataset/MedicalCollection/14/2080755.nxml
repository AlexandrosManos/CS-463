-title><source>Am J Trop Med Hyg</source><volume>70</volume><fpage>591</fpage><lpage>596</lpage><pub-id pub-id-type="pmid">15210997</pub-id></citation></ref><ref id="pone.0001243-Etang1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Etang</surname><given-names>J</given-names></name><name><surname>Fondjo</surname><given-names>E</given-names></name><name><surname>Chandre</surname><given-names>F</given-names></name><name><surname>Morlais</surname><given-names>I</given-names></name><name><surname>Brengues</surname><given-names>C</given-names></name><etal/></person-group><year>2006</year><article-title>First report of knockdown mutations in the malaria vector <italic>Anopheles gambiae</italic> from Cameroon.</article-title><source>Am J Trop Med Hyg</source><volume>74</volume><fpage>795</fpage><lpage>797</lpage><pub-id pub-id-type="pmid">16687682</pub-id></citation></ref><ref id="pone.0001243-Pinto1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pinto</surname><given-names>J</given-names></name><name><surname>Lynd</surname><given-names>A</given-names></name><name><surname>Elissa</surname><given-names>N</given-names></name><name><surname>Donnelly</surname><given-names>MJ</given-names></name><name><surname>Costa</surname><given-names>C</given-names></name><etal/></person-group><year>2006</year><article-title>Co-occurrence of East and West African <italic>kdr</italic> mutations suggests high levels of resistance to pyrethroid insecticides in <italic>Anopheles gambiae</italic> from Libreville, Gabon.</article-title><source>Med Vet Entomol</source><volume>20</volume><fpage>27</fpage><lpage>32</lpage><pub-id pub-id-type="pmid">16608487</pub-id></citation></ref><ref id="pone.0001243-Verhaeghen1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Verhaeghen</surname><given-names>K</given-names></name><nam