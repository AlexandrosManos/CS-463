</name></person-group><article-title>Acute brucellosis associated with massive proteinuria</article-title><source>Nephron</source><year>1996</year><volume>72</volume><fpage>688</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">8730444</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ustun</surname><given-names>I</given-names></name><name><surname>Ozcakar</surname><given-names>L</given-names></name><name><surname>Arda</surname><given-names>N</given-names></name><name><surname>Duranay</surname><given-names>M</given-names></name><name><surname>Bayrak</surname><given-names>E</given-names></name><name><surname>Duman</surname><given-names>K</given-names></name><name><surname>Atabay</surname><given-names>M</given-names></name><name><surname>Cakal</surname><given-names>BE</given-names></name><name><surname>Altundag</surname><given-names>K</given-names></name><name><surname>Guler</surname><given-names>S</given-names></name></person-group><article-title>Brucella glomerulonephritis: case report and review of the literature</article-title><source>South Med J</source><year>2005</year><volume>98</volume><fpage>1216</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">16440924</pub-id><pub-id pub-id-type="doi">10.1097/01.SMJ.0000163307.87372.38</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garcia de Lucas</surname><given-names>MD</given-names></name><name><surname>Castillo Dominguez</surname><given-names>JC</given-names></name><name><surname>Martinez Gonzalez</surname><given-names>MS</given-names></name></person-group><article-title>Brucella myopericarditis</article-title><source>Rev Esp Cardiol</source><year>2004</year><volume>57</volume><fpage>709</fpage><pub-id pub-id-type="pmid">15274859</pub-id><pub-id pub-id-type="doi">10.1157/13064200</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jubber</surname><given-names>AS</given-names></name><name><surname>Gunawardana</surname><given-names>DR</given-names></name><name><surname>Lulu</surname><given-names>AR</given-names></name></person-group><article-title>Acute pulmonary edema in Brucella myocarditis and interstitial pneumonitis</article-title><source>Chest</source><year>1990</year><volume>97</volume><fpage>1008</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">2323233</pub-id><pub-id pub-id-type="doi">10.1378/chest.97.4.1008</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Irmak</surname><given-names>H</given-names></name><name><surname>Buzgan</surname><given-names>T</given-names></name><name><surname>Evirgen</surname><given-names>O</given-names></name><name><surname>Akdeniz</surname><given-names>H</given-names></name><name><surname>Demiroz</surname><given-names>AP</given-names></name><name><surname>Abdoel</surname><given-names>TH</given-names></name><name><surname>Smits</surname><given-names>HL</given-names></name></person-group><article-title>Use of the Brucella IgM and IgG flow assays in the serodiagnosis of human brucellosis in an area endemic for brucellosis</article-title><source>Am J Trop Med Hyg</source><year>2004</year><volume>70</volume><fpage>688</fpage><lpage>94</lpage><pub-id pub-id-type="pmid">15211015</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roushan</surname><given-names>MR</given-names></name><name><surname>Amin</surname><given-names>MJ</given-names></name><name><surname>Abdoel</surname><given-names>TH</given-names></name><name><surname>Smits</surname><given-names>HL</given-names></name></person-group><article-title>Application of a user-friendly Brucella-specific IgM and IgG antibody assay for the rapid confirmation of Rose Bengal-positive patients in a hospital in Iran</article-title><source>Trans R Soc Trop Med Hyg</source><year>2005</year><volume>99</volume><fpage>744</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">16095642</pub-id><pub-id pub-id-type="doi">10.1016/j.trstmh.2005.02.009</pub-id></citation></ref></ref-list></back></article>