me>21</volume><fpage>i77</fpage><lpage>i78</lpage></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Missal</surname><given-names>K</given-names></name><name><surname>Zhu</surname><given-names>X</given-names></name><name><surname>Rose</surname><given-names>D</given-names></name><name><surname>Deng</surname><given-names>W</given-names></name><name><surname>Skogerb&#x000f8;</surname><given-names>G</given-names></name><name><surname>Chen</surname><given-names>R</given-names></name><name><surname>Stadler</surname><given-names>PF</given-names></name></person-group><article-title>Prediction of Structured Non-Coding RNAs in the Genome of the Nematode <italic>Caenorhabitis elegans</italic></article-title><source>J Exp Zool: Mol Dev Evol</source><year>2006</year><volume>306B</volume><fpage>379</fpage><lpage>392</lpage><pub-id pub-id-type="doi">10.1002/jez.b.21086</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Washietl</surname><given-names>S</given-names></name><name><surname>Hofacker</surname><given-names>IL</given-names></name><name><surname>Lukasser</surname><given-names>M</given-names></name><name><surname>H&#x000fc;ttenhofer</surname><given-names>A</given-names></name><name><surname>Stadler</surname><given-names>PF</given-names></name></person-group><article-title>Mapping of conserved RNA secondary structures predicts thousands of functional noncoding RNAs in the human genome</article-title><source>Nat Biotechnol</source><year>2005</year><volume>23</volume><fpage>1383</fpage><lpage>1390</lpage><pub-id pub-id-type="pmid">16273071</pub-id><pub-id pub-id-type="doi">10.1038/nbt1144</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pedersen</surname><given-names>JS</given-names></name><name><surname>Bejerano</surname><given-names>G</given-names></n