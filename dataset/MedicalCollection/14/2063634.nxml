><article-title>Mapping of 195 genes in cattle and updated comparing map with man, mouse, rat and pig</article-title><source>Cytogenetics and Genome Research</source><year>2003</year><volume>102</volume><fpage>16</fpage><lpage>24</lpage><pub-id pub-id-type="pmid">14970673</pub-id></citation></ref><ref id="b11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Iannuzzi</surname><given-names>L</given-names></name></person-group><article-title>ZOO-FISH and R-banding reveal extensive conservation of human chromosome regions in euchromatic regions of river buffalo chromosomes</article-title><source>Cytogenetics and Cell Genetics</source><year>1998</year><volume>82</volume><fpage>210</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">9858819</pub-id></citation></ref><ref id="b12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Iannuzzi</surname><given-names>L</given-names></name></person-group><article-title>Comparison of the human with the sheep genomes by use of human chromosome-specific painting probes</article-title><source>Mammalian Genome</source><year>1999</year><volume>10</volume><fpage>719</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">10384047</pub-id></citation></ref><ref id="b13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Iannuzzi</surname><given-names>L</given-names></name><etal/></person-group><article-title>Comparative FISH-mapping of bovid X chromosomes reveals homologies and divercences between the subfamilies Bovinae and Caprinae</article-title><source>Cytogenetics and Cell Genetics</source><year>2000a</year><volume>89</volume><fpage>171</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">10965117</pub-id></citation></ref><ref id="b14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Iannuzzi</surname><given-names>L</given-names></name><etal/></person-group><article-title>Sixteen type I loci from six chromosomes were comparatively fluorescent in-situ mapped to river buffalo (<italic>Bubalus bubalis</italic>) and sheep (<italic>Ovis aries</italic>) chromosomes</article-title><source>Chromosome Research</source><year>2000b</year><volume>8</volume><fpage>447</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">10997785</pub-id></citation></ref><ref id="b15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Iannuzzi</surname><given-names>L</given-names></name><etal/></person-group><article-title>Comparative FISH-mapping in river buffalo and sheep chromosomes: assignment of forty autosomal type I loci from sixteen human chromosomes</article-title><source>Cytogenetics and Cell Genetics</source><year>2001a</year><volume>94</volume><fpage>43</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">11701953</pub-id></citation></ref><ref id="b16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Iannuzzi</surname><given-names>L</given-names></name><etal/></person-group><article-title>A case of azoospermia in a cattle bull carrying an Y-autosome reciprocal translocation</article-title><source>Cytogenetics and Cell Genetics</source><year>2001b</year><volume>95</volume><fpage>225</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">12063403</pub-id></citation></ref><ref id="b17"><citation citation-type="other"><collab>ISCNDB</collab><source>International System for Chromosome Nomenclature of Domestic Bovids</source><year>2001</year><volume>92</volume><fpage>283</fpage><lpage>99</lpage><comment>Cytogenetics and Cell Genetics (Ed. by &#x02013;co-ordinator)</comment></citation></ref><ref id="b18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maddox</surname><given-names>JF</given-names></name><etal/></person-group><article-title>An enhanced linkage map of the sheep genome comprising more than 1000 loci</article-title><source>Genome Research</source><year>2001</year><volume>11</volume><fpage>1275</fpage><lpage>89</lpage><pub-id pub-id-type="pmid">11435411</pub-id></citation></ref><ref id="b19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Milenkovic</surname><given-names>D</given-names></name><etal/></person-group><article-title>Cytogenetic localization of 136 genes in the horse: comparative mapping with the human genome</article-title><source>Mammalian Genome</source><year>2002</year><volume>13</volume><fpage>524</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">12370783</pub-id></citation></ref><ref id="b20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pinton</surname><given-names>P</given-names></name></person-group><article-title>Localization of 113 anchor loci in pigs: improvement of the comparative map for humans, pigs, and goats</article-title><source>Mammalian Genome</source><year>2000</year><volume>11</volume><fpage>306</fpage><lpage>15</lpage><pub-id pub-id-type="pmid">10754107</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pinton</surname><given-names>A</given-names></name><etal/></person-group><article-title>Comparison of male and female meiotic segregation patterns in translocation heterozygotes: a case study in an animal model (<italic>Sus scrofa domestica</italic> L.)</article-title><source>Human Reproduction</source><year>2005</year><volume>20</volume><fpage>2476</fpage><lpage>82</lpage><pub-id pub-id-type="pmid">15878917</pub-id></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Piumi</surname><given-names>F</given-names></name><etal/></person-group><article-title>Comparative cytogenetic mapping reveals chromosome rearrangements between the X chromosomes of two closely related mammalian species (cattle and goats)</article-title><source>Cytogenetics and Cell Genetics</source><year>1998</year><volume>81</volume><fpage>36</fpage><lpage>41</lpage><pub-id pub-id-type="pmid">9691172</pub-id></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Robinson</surname><given-names>TJ</given-names></name><etal/></person-group><article-title>A molecular cytogenetic analysis of the X chromosome repatterning in the Bovidae: transpositions, inversions, and phylogenetic inference</article-title><source>Cytogenetics and Cell Genetics</source><year>1998</year><volume>80</volume><fpage>179</fpage><lpage>84</lpage><pub-id pub-id-type="pmid">9678354</pub-id></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schibler</surname><given-names>L</given-names></name><etal/></person-group><article-title>Comparative gene mapping: a fine-scale survey of chromosome rearrangements between ruminants and humans</article-title><source>Genome Research</source><year>1998a</year><volume>8</volume><fpage>901</fpage><lpage>15</lpage><pub-id pub-id-type="pmid">9750190</pub-id></citation></ref><ref id="b25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schibler</surname><given-names>L</given-names></name><etal/></person-group><article-title>Construction and extensive characterization of a goat bacterial artificial chromosome library with threefold genome coverage</article-title><source>Mammalian Genome</source><year>1998b</year><volume>9</volume><fpage>119</fpage><lpage>24</lpage><pub-id pub-id-type="pmid">9457672</pub-id></citation></ref><ref id="b26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schibler</surname><given-names>L</given-names></name><etal/></person-group><article-title>A first generation bovine BAC-based physical map</article-title><source>Genetics Selection Evolution</source><year>2004</year><volume>36</volume><fpage>105</fpage><lpage>22</lpage></citation></ref><ref id="b27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schibler</surname><given-names>L</given-names></name><etal/></person-group><article-title>High-resolution comparative mapping among man, cattle and mouse suggests a role for repeat sequences in mammalian genome</article-title><source>BMC Genomics</source><year>2006</year><volume>7</volume><fpage>194</fpage><pub-id pub-id-type="pmid">16882342</pub-id></citation></ref></ref-list><sec sec-type="supplementary-material"><title>Supplementary Material</title><p>The following supplementary material is available for this article online from <ext-link ext-link-type="uri" xlink:href="http://www.blackwell-synergy.com/doi/full/10.1111/j.1365-2052.2007.01598.x">http://www.blackwell-synergy.com/doi/full/10.1111/j.1365-2052.2007.01598.x</ext-link></p><supplementary-material content-type="local-data" id="SD1"><label>Table S1</label><caption><p>Loci assigned to chromosome bands or regions in sheep (OAR), compared to bovine (BTA) and goat (CHI) assignments.</p></caption><media xlink:href="age0038-0233_TableS1.doc" xlink:type="simple" id="N0x1c68460N0x32d53e0" position="anchor" mimetype="application" mime-subtype="msword"/></supplementary-material></sec></back></article>