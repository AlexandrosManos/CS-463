<name><surname>Okoyeh</surname><given-names>JN</given-names></name><name><surname>Pillai</surname><given-names>CR</given-names></name><name><surname>Chitnis</surname><given-names>CE</given-names></name></person-group><year>1999</year><article-title><named-content content-type="genus-species">Plasmodium falciparum</named-content> field isolates commonly use erythrocyte invasion pathways that are independent of sialic acid residues of glycophorin A</article-title><source>Infect Immun</source><volume>67</volume><fpage>5784</fpage><lpage>5791</lpage><pub-id pub-id-type="pmid">10531229</pub-id></citation></ref><ref id="pmed-0040320-b012"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Triglia</surname><given-names>T</given-names></name><name><surname>Healer</surname><given-names>J</given-names></name><name><surname>Caruana</surname><given-names>SR</given-names></name><name><surname>Hodder</surname><given-names>AN</given-names></name><name><surname>Anders</surname><given-names>RF</given-names></name><etal/></person-group><year>2000</year><article-title>Apical membrane antigen 1 plays a central role in erythrocyte invasion by <italic>Plasmodium</italic> species</article-title><source>Mol Microbiol</source><volume>38</volume><fpage>706</fpage><lpage>718</lpage><pub-id pub-id-type="pmid">11115107</pub-id></citation></ref><ref id="pmed-0040320-b013"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Casey</surname><given-names>JL</given-names></name><name><surname>Coley</surname><given-names>AM</given-names></name><name><surname>Anders</surname><given-names>RF</given-names></name><name><surname>Murphy</surname><given-names>VJ</given-names></name><name><surname>Humberstone</surname><given-names>KS</given-names></name><etal/></person-group><year>2004</year><article-title>Antibodies to malaria peptide mimics inhibit <named-content content-type="genus-species">Plasmodium falciparum</named-content> in