element-citation></ref><ref id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bec</surname><given-names>G</given-names></name><name><surname>Kerjan</surname><given-names>P</given-names></name><name><surname>Zha</surname><given-names>XD</given-names></name><name><surname>Waller</surname><given-names>JP</given-names></name></person-group><article-title>Valyl-tRNA synthetase from rabbit liver. I. Purification as a heterotypic complex in association with elongation factor 1</article-title><source>J. Biol. Chem</source><year>1989</year><volume>264</volume><fpage>21131</fpage><lpage>21137</lpage><pub-id pub-id-type="pmid">2556394</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Negrutskii</surname><given-names>BS</given-names></name><name><surname>Budkevich</surname><given-names>TV</given-names></name><name><surname>Shalak</surname><given-names>VF</given-names></name><name><surname>Turkovskaya</surname><given-names>GV</given-names></name><name><surname>El'skaya</surname><given-names>AV</given-names></name></person-group><article-title>Rabbit translation elongation factor 1 alpha stimulates the activity of homologous aminoacyl-tRNA synthetase</article-title><source>FEBS Lett</source><year>1996</year><volume>382</volume><fpage>18</fpage><lpage>20</lpage><pub-id pub-id-type="pmid">8612747</pub-id></element-citation></ref><ref id="B19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Negrutskii</surname><given-names>BS</given-names></name><name><surname>Shalak</surname><given-names>VF</given-names></name><name><surname>Kerjan</surname><given-names>P</given-names></name><name><surname>El'skaya</surname><given-names>AV</given-names></name><name><surname>Mirande</surname><given-names>M</given-names></name></person-group><