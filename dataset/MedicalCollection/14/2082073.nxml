id pub-id-type="pmid">15128561</pub-id></citation></ref><ref id="pone.0001229-Gearry1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gearry</surname><given-names>RB</given-names></name><name><surname>Richardson</surname><given-names>A</given-names></name><name><surname>Frampton</surname><given-names>CM</given-names></name><name><surname>Collett</surname><given-names>JA</given-names></name><name><surname>Burt</surname><given-names>MJ</given-names></name><etal/></person-group><year>2006</year><article-title>High incidence of Crohn's disease in Canterbury, New Zealand: results of an epidemiologic study.</article-title><source>Inflamm Bowel Dis</source><volume>12</volume><fpage>936</fpage><lpage>943</lpage><pub-id pub-id-type="pmid">17012964</pub-id></citation></ref><ref id="pone.0001229-Vind1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vind</surname><given-names>I</given-names></name><name><surname>Riis</surname><given-names>L</given-names></name><name><surname>Jess</surname><given-names>T</given-names></name><name><surname>Knudsen</surname><given-names>E</given-names></name><name><surname>Pedersen</surname><given-names>N</given-names></name><etal/></person-group><year>2006</year><article-title>Increasing incidences of inflammatory bowel disease and decreasing surgery rates in Copenhagen City and County, 2003-2005: a population-based study from the Danish Crohn colitis database.</article-title><source>Am J Gastroenterol</source><volume>101</volume><fpage>1274</fpage><lpage>1282</lpage><pub-id pub-id-type="pmid">16771949</pub-id></citation></ref><ref id="pone.0001229-Hildebrand1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hildebrand</surname><given-names>H</given-names></name><name><surname>Finkel</surname><given-names>Y</given-names></name><name><surname>Grahnquist</surname><given-na