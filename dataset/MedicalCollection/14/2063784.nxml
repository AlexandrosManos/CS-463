xref></td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">TLG205</td><td colspan="1" rowspan="1" align="left" valign="top"><italic>MAT</italic>&#x003b1; <italic>ade2-1 leu2-1,112 trp1-&#x00394;</italic><italic>1 his3-&#x00394;</italic><italic>200 ura3-52 pUN100[LEU2 CEN4 DsRED-NOP1] pTD125[URA3 CEN GFP-POP1]</italic></td><td colspan="1" rowspan="1" align="left" valign="top">This study</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">TLG206</td><td colspan="1" rowspan="1" align="left" valign="top"><italic>MAT</italic>&#x003b1; <italic>ade2-1(or ade1) leu2-3,112 trp1-&#x00394;</italic><italic>1 his3-&#x00394;</italic><italic>200 ura3-52 cdc15-1 pUN100[LEU2 CEN4 DsRED-NOP1] &#x00085;&#x02003;&#x02003;&#x02003;&#x02003;pTD125[URA3 CEN GFP-POP1]</italic></td><td colspan="1" rowspan="1" align="left" valign="top">This study</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">TLG208</td><td colspan="1" rowspan="1" align="left" valign="top"><italic>MATa ade2-1(or ade1) leu2-3,112 trp1-&#x00394;</italic><italic>1 his3-&#x00394;</italic><italic>200 ura3-52 cdc5-1 pUN100[LEU2 CEN4 DsRED-NOP1] pTD125[URA3 CEN &#x00085;&#x02003;&#x02003;&#x02003;&#x02003;GFP-POP1]</italic></td><td colspan="1" rowspan="1" align="left" valign="top">This study</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">TLG212</td><td colspan="1" rowspan="1" align="left" valign="top"><italic>MAT</italic>&#x003b1; <italic>ade2-1 leu2-1,112 trp1-&#x00394;</italic><italic>1 his3-&#x00394;</italic><italic>200 ura3-52 pTD125[URA3 CEN GFP-POP1]</italic></td><td colspan="1" rowspan="1" align="left" valign="top">This study</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">TLG216</td><td colspan="1" rowspan="1" align="left" valign="top"><italic>MATa ade2 his3-&#x00394;</italic><italic>200 leu2-3,112 trp1-&#x00394;</italic><italic>1 ura3-52 snm1-&#x00394;</italic><italic>1&#x02237;HIS3 pTC120[LEU2 CEN SNM1] pTD125[URA3 CEN GFP-POP1]</itali