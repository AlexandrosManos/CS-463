me><surname>Genant</surname><given-names>HK</given-names></name><name><surname>Engelke</surname><given-names>K</given-names></name><name><surname>Fuerst</surname><given-names>T</given-names></name><name><surname>Gl&#x000fc;er</surname><given-names>CC</given-names></name><name><surname>Grampp</surname><given-names>S</given-names></name><name><surname>Harris</surname><given-names>ST</given-names></name><etal/></person-group><article-title>Non invasive assessment of bone mineral and structure: state of the art</article-title><source>J Bone Miner Res</source><year>1996</year><volume>11</volume><fpage>707</fpage><lpage>730</lpage><pub-id pub-id-type="pmid">8725168</pub-id></mixed-citation></ref><ref id="CR12"><label>12.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mazess</surname><given-names>R</given-names></name><name><surname>Collick</surname><given-names>B</given-names></name><name><surname>Trempe</surname><given-names>J</given-names></name><name><surname>Barden</surname><given-names>H</given-names></name><name><surname>Hanson</surname><given-names>J</given-names></name></person-group><article-title>Performance evaluation of a dual energy X-ray bone densitometer</article-title><source>Calcif Tissue Int</source><year>1998</year><volume>44</volume><fpage>228</fpage><lpage>232</lpage><pub-id pub-id-type="doi">10.1007/BF02556569</pub-id><pub-id pub-id-type="pmid">2493329</pub-id></mixed-citation></ref><ref id="CR13"><label>13.</label><mixed-citation publication-type="book"><source>Assessment of fracture risk and its application to screening for postmenopausal osteoporosis</source><year>1994</year><publisher-loc>Geneva</publisher-loc><publisher-name>WHO</publisher-name></mixed-citation></ref><ref id="CR14"><label>14.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Marshall</surname><given-names>D</given-names></name><name><surname>Johnell</surname><given-