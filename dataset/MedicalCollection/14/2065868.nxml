></name></person-group><article-title>Willingness to pay: what's in a name</article-title><source>Pharmacoeconomics</source><year>1998</year><volume>14</volume><fpage>465</fpage><lpage>470</lpage><pub-id pub-id-type="pmid">10344912</pub-id><pub-id pub-id-type="doi">10.2165/00019053-199814050-00001</pub-id></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Mitchell</surname><given-names>R</given-names></name><name><surname>Carson</surname><given-names>R</given-names></name></person-group><source>A contingent valuation estimate of national freshwater benefits: technical report to the U.S. Environmental Protection Agency</source><year>1984</year><publisher-name>Washington, DC, Resources for the Future</publisher-name></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bateman</surname><given-names>I</given-names></name><name><surname>Langford</surname><given-names>I</given-names></name><name><surname>Munro</surname><given-names>A</given-names></name><name><surname>Starner</surname><given-names>C</given-names></name><name><surname>Sugden</surname><given-names>R</given-names></name></person-group><article-title>Estimating four Hicksian welfare measures for a public good: a contingent valuation investigation.</article-title><source>Land Econ</source><year>2000</year><volume>76</volume><fpage>355</fpage><lpage>373</lpage><pub-id pub-id-type="doi">10.2307/3147034</pub-id></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Mas-Colell</surname><given-names>A</given-names></name><name><surname>Whinston</surname><given-names>MD</given-names></name><name><surname>Green</surname><given-names>J</given-names></name></person-group><source>Microeconomic Theory</source><year>1995</year><publisher-name>Oxford, Oxford University Press</publisher-name></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dong</surname><given-names>H</given-names></name><name><surname>Kouyate</surname><given-names>B</given-names></name><name><surname>Cairns</surname><given-names>J</given-names></name><name><surname>Mugisha</surname><given-names>F</given-names></name><name><surname>Sauerborn</surname><given-names>R</given-names></name></person-group><article-title>Willingness-to-pay for community-based insurance in Burkina Faso</article-title><source>Health Econ</source><year>2003</year><volume>12</volume><fpage>849</fpage><lpage>862</lpage><pub-id pub-id-type="pmid">14508869</pub-id><pub-id pub-id-type="doi">10.1002/hec.771</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dong</surname><given-names>H</given-names></name><name><surname>Mugisha</surname><given-names>F</given-names></name><name><surname>Gbangou</surname><given-names>A</given-names></name><name><surname>Kouyate</surname><given-names>B</given-names></name><name><surname>Sauerborn</surname><given-names>R</given-names></name></person-group><article-title>The feasibility of community-based insurance in Burkina Faso</article-title><source>Health Policy</source><year>2004</year><volume>69</volume><fpage>45</fpage><lpage>53</lpage><pub-id pub-id-type="pmid">15484606</pub-id><pub-id pub-id-type="doi">10.1016/j.healthpol.2003.12.001</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dong</surname><given-names>H</given-names></name><name><surname>Kouyate</surname><given-names>B</given-names></name><name><surname>Cairns</surname><given-names>J</given-names></name><name><surname>Sauerborn</surname><given-names>R</given-names></name></person-group><article-title>Differential willingness of household heads to pay community-based health insurance premia for themselves and other household members</ar