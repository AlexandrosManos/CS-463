/source><year>2000</year><volume>83</volume><fpage>569</fpage><lpage>72</lpage><pub-id pub-id-type="pmid">10944593</pub-id></element-citation></ref><ref id="CIT8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ollila</surname><given-names>DW</given-names></name><name><surname>Hsueh</surname><given-names>EC</given-names></name><name><surname>Stern</surname><given-names>SL</given-names></name><name><surname>Morton</surname><given-names>DL</given-names></name></person-group><article-title>Metastasectomy for recurrent stage IV melanoma</article-title><source>J Surg Oncol</source><year>1999</year><volume>71</volume><fpage>209</fpage><lpage>13</lpage><pub-id pub-id-type="pmid">10440757</pub-id></element-citation></ref></ref-list></back></article>