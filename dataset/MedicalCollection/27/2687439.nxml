-type="author"><name><surname>Fire</surname><given-names>A</given-names></name><name><surname>Xu</surname><given-names>S</given-names></name><name><surname>Montgomery</surname><given-names>MK</given-names></name><name><surname>Kostas</surname><given-names>SA</given-names></name><name><surname>Driver</surname><given-names>SE</given-names></name><name><surname>Mello</surname><given-names>CC</given-names></name></person-group><article-title>Potent and specific genetic interference by double-stranded RNA in Caenorhabditis elegans</article-title><source>Nature</source><year>1998</year><volume>391</volume><fpage>806</fpage><lpage>811</lpage><pub-id pub-id-type="pmid">9486653</pub-id><pub-id pub-id-type="doi">10.1038/35888</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Price</surname><given-names>DR</given-names></name><name><surname>Gatehouse</surname><given-names>JA</given-names></name></person-group><article-title>RNAi-mediated crop protection against insects</article-title><source>Trends Biotechnol</source><year>2008</year><volume>26</volume><fpage>393</fpage><lpage>400</lpage><comment>Epub 2008 May 2022</comment><pub-id pub-id-type="pmid">18501983</pub-id><pub-id pub-id-type="doi">10.1016/j.tibtech.2008.04.004</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marcus</surname><given-names>JM</given-names></name></person-group><article-title>Jumping genes and AFLP maps: transforming lepidopteran color pattern genetics</article-title><source>Evol Dev</source><year>2005</year><volume>7</volume><fpage>108</fpage><lpage>114</lpage><pub-id pub-id-type="pmid">15733308</pub-id><pub-id pub-id-type="doi">10.1111/j.1525-142X.2005.05012.x</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tomoyasu</surname><given-names>Y</given-names></name><name><surname>Denell</surname><given-names>RE</given-names></name></person-group><article-title>Larval RNAi in Tribolium (Coleoptera) for analyzing adult development</article-title><source>Dev Genes Evol</source><year>2004</year><volume>214</volume><fpage>575</fpage><lpage>578</lpage><comment>Epub 2004 Sep 2009</comment><pub-id pub-id-type="pmid">15365833</pub-id><pub-id pub-id-type="doi">10.1007/s00427-004-0434-0</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bucher</surname><given-names>G</given-names></name><name><surname>Scholten</surname><given-names>J</given-names></name><name><surname>Klingler</surname><given-names>M</given-names></name></person-group><article-title>Parental RNAi in Tribolium (Coleoptera)</article-title><source>Curr Biol</source><year>2002</year><volume>12</volume><fpage>R85</fpage><lpage>86</lpage><pub-id pub-id-type="pmid">11839285</pub-id><pub-id pub-id-type="doi">10.1016/S0960-9822(02)00666-8</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Anselme</surname><given-names>C</given-names></name><name><surname>Vallier</surname><given-names>A</given-names></name><name><surname>Balmand</surname><given-names>S</given-names></name><name><surname>Fauvarque</surname><given-names>MO</given-names></name><name><surname>Heddi</surname><given-names>A</given-names></name></person-group><article-title>Host <italic>PGRP </italic>gene expression and bacterial release in endosymbiosis of the weevil <italic>Sitophilus zeamais</italic></article-title><source>Appl Environ Microbiol</source><year>2006</year><volume>72</volume><fpage>6766</fpage><lpage>6772</lpage><pub-id pub-id-type="pmid">17021229</pub-id><pub-id pub-id-type="doi">10.1128/AEM.00942-06</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goto</surname><given-names>A</given-names></name><name><surname>Blandin</surname><given-names>S</given-names></name><name><surname>Royet</surname><given-names>J</given-names></name><name><surname>Reichhart</surname><given-names>JM</given-names></name><name><surname>Levashina</surname><given-names>EA</given-names></name></person-group><article-title>Silencing of Toll pathway components by direct injection of double-stranded RNA into Drosophila adult flies</article-title><source>Nucleic Acids Res</source><year>2003</year><volume>31</volume><fpage>6619</fpage><lpage>6623</lpage><pub-id pub-id-type="pmid">14602922</pub-id><pub-id pub-id-type="doi">10.1093/nar/gkg852</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Loppin</surname><given-names>B</given-names></name><name><surname>Lepetit</surname><given-names>D</given-names></name><name><surname>Dorus</surname><given-names>S</given-names></name><name><surname>Couble</surname><given-names>P</given-names></name><name><surname>Karr</surname><given-names>TL</given-names></name></person-group><article-title>Origin and neofunctionalization of a Drosophila paternal effect gene essential for zygote viability</article-title><source>Curr Biol</source><year>2005</year><volume>15</volume><fpage>87</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">15668163</pub-id><pub-id pub-id-type="doi">10.1016/j.cub.2004.12.071</pub-id></citation></ref><ref id="B24"><citation citation-type="other"><person-group person-group-type="author"><collab>Team RDC</collab></person-group><article-title>R: A language and environment for statistical computing. R Foundation for Statistical Computing</article-title><source>Vienna, Austria</source><year>2005</year><ext-link ext-link-type="uri" xlink:href="http://www.R-project.org"/></citation></ref></ref-list></back></article>