-names>CA</given-names></name><name><surname>Voaklander</surname><given-names>DC</given-names></name><name><surname>Johnston</surname><given-names>DW</given-names></name><name><surname>Suarez-Almazor</surname><given-names>ME</given-names></name></person-group><article-title>The effect of age on pain, function, and quality of life after total hip and knee arthroplasty</article-title><source>Arch Intern Med</source><year>2001</year><volume>161</volume><issue>3</issue><fpage>454</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">11176772</pub-id></citation></ref><ref id="R12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Williams</surname><given-names>A</given-names></name><name><surname>Dunning</surname><given-names>T</given-names></name><name><surname>Manias</surname><given-names>E</given-names></name></person-group><article-title>Continuity of care and general wellbeing of patients with comorbidities requiring joint replacement</article-title><source>J Adv Nurs</source><year>2007</year><volume>57</volume><issue>3</issue><fpage>244</fpage><lpage>56</lpage><pub-id pub-id-type="pmid">17233645</pub-id></citation></ref><ref id="R13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>LT</given-names></name><name><surname>Lee</surname><given-names>JA</given-names></name><name><surname>Chua</surname><given-names>BS</given-names></name><name><surname>Howe</surname><given-names>TS</given-names></name></person-group><article-title>Hip fractures in the elderly: the impact of comorbid illnesses on hospitalizsation costs</article-title><source>Ann Acad Med Singapore</source><year>2007</year><volume>36</volume><issue>9</issue><fpage>784</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">17925990</pub-id></citation></ref><ref id="R14"><label>14</label><citation citation-type="other"><person-group person-group-type="author"><name><surname>Tuo