><volume>10</volume><issue>6</issue><fpage>1871</fpage><lpage>1874</lpage><pub-id pub-id-type="pmid">15041700</pub-id></citation></ref><ref id="B7"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hegi</surname><given-names>ME</given-names></name><name><surname>Diserens</surname><given-names>A-C</given-names></name><name><surname>Gorlia</surname><given-names>T</given-names></name><etal/></person-group><article-title>						<italic>MGMT</italic> gene silencing and benefit from temozolomide in glioblastoma</article-title><source><italic>The New England Journal of Medicine</italic></source><year>2005</year><volume>352</volume><issue>10</issue><fpage>997</fpage><lpage>1003</lpage><pub-id pub-id-type="pmid">15758010</pub-id></citation></ref><ref id="B8"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gerson</surname><given-names>SL</given-names></name></person-group><article-title>MGMT: its role in cancer aetiology and cancer therapeutics</article-title><source><italic>Nature Reviews Cancer</italic></source><year>2004</year><volume>4</volume><issue>4</issue><fpage>296</fpage><lpage>307</lpage><pub-id pub-id-type="pmid">15057289</pub-id></citation></ref><ref id="B9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Singer-Sam</surname><given-names>J</given-names></name><name><surname>LeBon</surname><given-names>JM</given-names></name><name><surname>Tanguay</surname><given-names>RL</given-names></name><name><surname>Riggs</surname><given-names>AD</given-names></name></person-group><article-title>A quantitative HpaII-PCR assay to measure methylation of DNA from a small number of cells</article-title><source><italic>Nucleic Acids Research</italic></source><year>1990</year><volume>18</volume><issue>3</issue><fpage>p. 687</fpage></citation></ref><ref id="B10"><label>10</label><citation citation-type="journal">