<volume>10</volume><fpage>1</fpage><lpage>10</lpage><pub-id pub-id-type="pmid">9046488</pub-id></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Postert</surname><given-names>T</given-names></name><name><surname>Federlein</surname><given-names>J</given-names></name><name><surname>Weber</surname><given-names>S</given-names></name><etal/></person-group><article-title>Second harmonic imaging in acute middle cerebral artery infarction: preliminary results</article-title><source>Stroke</source><year>1999</year><volume>30</volume><fpage>1702</fpage><lpage>1706</lpage><pub-id pub-id-type="pmid">10436124</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Seidel</surname><given-names>G</given-names></name><name><surname>Greis</surname><given-names>C</given-names></name><name><surname>Sonne</surname><given-names>J</given-names></name><etal/></person-group><article-title>Harmonic gray scale imaging of the human brain</article-title><source>J Neuroimaging</source><year>1999</year><volume>9</volume><fpage>171</fpage><lpage>174</lpage><pub-id pub-id-type="pmid">10436760</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hann</surname><given-names>LE</given-names></name><name><surname>Bach</surname><given-names>AM</given-names></name><name><surname>Cramer</surname><given-names>LD</given-names></name><etal/></person-group><article-title>Hepatic sonography: comparison of tissue harmonic and standard sonography techniques</article-title><source>AJR Am J Roentgenol</source><year>1999</year><volume>173</volume><fpage>201</fpage><lpage>206</lpage><pub-id pub-id-type="pmid">10397127</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation pub