 align="left" rowspan="1" colspan="1">Latanoprost</td><td valign="top" align="left" rowspan="1" colspan="1">801</td><td valign="top" align="left" rowspan="1" colspan="1">Mean IOP similar at 8 a.m. and 10 a.m. but lower at 4 p.m. with travoprost than latanoprost (p = 0.0191)</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b29-opth-1-11">Fellman et al 2002</xref></td><td valign="top" align="left" rowspan="1" colspan="1">Timolol</td><td valign="top" align="left" rowspan="1" colspan="1">605</td><td valign="top" align="left" rowspan="1" colspan="1">Mean IOP lower with travoprost than timolol at 10 of 13 time points (p &#x02264; 0.03)</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b25-opth-1-11">Denis et al 2006a</xref>, <xref ref-type="bibr" rid="b26-opth-1-11">b</xref></td><td valign="top" align="left" rowspan="1" colspan="1">Latanoprost</td><td valign="top" align="left" rowspan="1" colspan="1">2052</td><td valign="top" align="left" rowspan="1" colspan="1">More eyes reached target IOP with travoprost than latanoprost (p &#x02264; 0.0344)</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b14-opth-1-11">Cantor et al 2004</xref>, <xref ref-type="bibr" rid="b13-opth-1-11">2006</xref></td><td valign="top" align="left" rowspan="1" colspan="1">Bimatoprost</td><td valign="top" align="left" rowspan="1" colspan="1">157</td><td valign="top" align="left" rowspan="1" colspan="1">Mean IOP similar at 1 p.m. and 4 p.m. but lower with bimatoprost than travoprost at 9 a.m. (p = 0.014)</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b69-opth-1-11">Parrish et al 2003</xref></td><td valign="top" align="left" rowspan="1" colspan="1">Latanoprost</td><td valign="top" align="left" rowspan="1" colspan="1">410</td><td valign="top" align="left" rowspan="1" colspan="1">Mean IOP similar with both drugs (p &#x0003e; 0.05)</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b69-opth-1-11">Parrish et al 2003</xref></td><td valign="top" align="left" rowspan="1" colspan="1">Bimatoprost</td><td valign="top" align="left" rowspan="1" colspan="1">410</td><td valign="top" align="left" rowspan="1" colspan="1">Mean IOP similar with both drugs (p &#x0003e; 0.05)</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b30-opth-1-11">Franks et al 2006</xref></td><td valign="top" align="left" rowspan="1" colspan="1">Latanoprost/Timolol</td><td valign="top" align="left" rowspan="1" colspan="1">110</td><td valign="top" align="left" rowspan="1" colspan="1">Mean IOP similar with both drugs (p &#x0003e; 0.05)</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b83-opth-1-11">Suzuki et al 2006</xref></td><td valign="top" align="left" rowspan="1" colspan="1">Dorzolamide/Timolol</td><td valign="top" align="left" rowspan="1" colspan="1">56</td><td valign="top" align="left" rowspan="1" colspan="1">Mean IOP lower with travoprost than dorzolamide/timolol (p &#x0003c; 0.01)</td></tr></tbody></table><table-wrap-foot><fn id="tfn1-opth-1-11"><p><bold>Abbreviations:</bold> IOP, intraocular pressure</p></fn></table-wrap-foot></table-wrap><table-wrap id="t2-opth-1-11" position="float"><label>Table 2</label><caption><p>Summary of key travoprost safety data</p></caption><table frame="hsides" rules="groups"><thead><tr><th valign="top" align="left" rowspan="1" colspan="1"><bold>Safety event</bold></th><th valign="top" align="left" rowspan="1" colspan="1"><bold>Incidence in eyes treated with travoprost</bold></th><th valign="top" align="left" rowspan="1" colspan="1"><bold>References</bold></th></tr></thead><tbody><tr><td valign="top" align="left" rowspan="1" colspan="1">Conjunctival hyperemia</td><td valign="top" align="left" rowspan="1" colspan="1">32.5%&#x02013;49.5%</td><td valign="top" align="lef