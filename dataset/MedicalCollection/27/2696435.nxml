-group><article-title>Spain: Going smoke free</article-title><source>Tob Control</source><year>2006</year><volume>15</volume><fpage>79</fpage><lpage>80</lpage><pub-id pub-id-type="pmid">16565449</pub-id></citation></ref><ref id="B13"><citation citation-type="other"><person-group person-group-type="author"><collab>DOGC</collab></person-group><article-title>Catalan Law 10/1991, of 10 may modifying Law 20/1985 de Prevenci&#x000f3; i provisi&#x000f3; de substances dependets[Prevention and Healthcare Provision for Substances which may Create Dependency]</article-title><source>DOGC 1445 22-05-1991</source></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fern&#x000e1;ndez</surname><given-names>E</given-names></name><name><surname>Fu</surname><given-names>M</given-names></name><name><surname>Mart&#x000ed;nez</surname><given-names>C</given-names></name><name><surname>Mart&#x000ed;nez-S&#x000e1;nchez</surname><given-names>JM</given-names></name><name><surname>L&#x000f3;pez</surname><given-names>MJ</given-names></name><name><surname>Mart&#x000ed;n-Pujol</surname><given-names>A</given-names></name><name><surname>Centrich</surname><given-names>F</given-names></name><name><surname>Mu&#x000f1;oz</surname><given-names>G</given-names></name><name><surname>Nebot</surname><given-names>M</given-names></name><name><surname>Salt&#x000f3;</surname><given-names>E</given-names></name></person-group><article-title>Secondhand smoke in hospitals before and after a ban on smoking in Catalonia (Spain)</article-title><source>Prev Med</source><year>2008</year><volume>47</volume><fpage>624</fpage><lpage>28</lpage><pub-id pub-id-type="pmid">18845179</pub-id><pub-id pub-id-type="doi">10.1016/j.ypmed.2008.09.003</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ouranou</surname><given-names>A</given-names></name></person-group><article-title>Self-audit 