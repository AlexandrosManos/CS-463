tation-type="journal"><person-group person-group-type="author"><name><surname>Marchak</surname><given-names>BE</given-names></name><name><surname>Thompson</surname><given-names>WK</given-names></name><name><surname>Duffy</surname><given-names>P</given-names></name><name><surname>Miyaki</surname><given-names>T</given-names></name><name><surname>Bryan</surname><given-names>MH</given-names></name><name><surname>Bryan</surname><given-names>AC</given-names></name><name><surname>Froese</surname><given-names>AB</given-names></name></person-group><article-title>Treatment of RDS by high-frequency oscillatory ventilation: a preliminary report</article-title><source>J Pediatr</source><year>1981</year><volume>99</volume><fpage>287</fpage><lpage>292</lpage><pub-id pub-id-type="pmid">7252695</pub-id><pub-id pub-id-type="doi">10.1016/S0022-3476(81)80480-5</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McCulloch</surname><given-names>PR</given-names></name><name><surname>Forkert</surname><given-names>PG</given-names></name><name><surname>Froese</surname><given-names>AB</given-names></name></person-group><article-title>Lung volume maintenance prevents lung injury during high-frequency oscillatory ventilation in surfactant-deficient rabbits</article-title><source>Am Rev Respir Dis</source><year>1988</year><volume>137</volume><fpage>1185</fpage><lpage>1192</lpage><pub-id pub-id-type="pmid">3195813</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><collab>HIFI Study Group</collab></person-group><article-title>High-frequency oscillatory ventilation compared with conventional mechanical ventilation in the treatment of respiratory failure in preterm infants</article-title><source>N Engl J Med</source><year>1989</year><volume>320</volume><fpage>88</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">2643039</pub-id></citation></ref><ref id="B15"><c