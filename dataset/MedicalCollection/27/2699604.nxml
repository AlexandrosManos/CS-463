erson-group><article-title>The GTPas superfamily: Conserved structure and molecular mechanism</article-title><source>Nature</source><year>1991</year><volume>349</volume><fpage>117</fpage><lpage>27</lpage><pub-id pub-id-type="pmid">1898771</pub-id></element-citation></ref><ref id="CIT16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Haag</surname><given-names>JD</given-names></name><name><surname>Lindstrom</surname><given-names>MJ</given-names></name><name><surname>Gould</surname><given-names>MN</given-names></name></person-group><article-title>Limonene induced regression of mammary carcinomas</article-title><source>Cancer Res</source><year>1992</year><volume>52</volume><fpage>4021</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">1617679</pub-id></element-citation></ref><ref id="CIT17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rabi</surname><given-names>T</given-names></name><name><surname>Ramachandran</surname><given-names>C</given-names></name><name><surname>Fonseca</surname><given-names>HB</given-names></name><name><surname>Alomo</surname><given-names>A</given-names></name><name><surname>Melnick</surname><given-names>SJ</given-names></name><name><surname>Escalon</surname><given-names>E</given-names></name></person-group><article-title>Novel drug amooranin induces apoptosis through caspase activity in human breast carcinoma cell lines</article-title><source>Breast Cancer Res Treat</source><year>2003</year><volume>80</volume><fpage>321</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">14503804</pub-id></element-citation></ref><ref id="CIT18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Oridate</surname><given-names>N</given-names></name><name><surname>Suzuki</surname><given-names>S</given-names></name><name><surname>Higuchi</surname><given-names>M