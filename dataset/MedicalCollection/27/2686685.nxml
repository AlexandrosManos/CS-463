s></name></person-group><source>Subset Selection in Regression</source><year>2002</year><edition>Second</edition><publisher-name>Chapman &#x00026; Hall/CRC</publisher-name></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tibshirani</surname><given-names>R</given-names></name></person-group><article-title>Regression shrinkage and selection via the lasso</article-title><source>J R Statist Soc B</source><year>1996</year><volume>58</volume><fpage>267</fpage><lpage>288</lpage></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fan</surname><given-names>J</given-names></name><name><surname>Lv</surname><given-names>J</given-names></name></person-group><article-title>Sure independence screening for ultrahigh dimensional feature space</article-title><source>J R Statist Soc B</source><year>2008</year><volume>70</volume><fpage>849</fpage><lpage>911</lpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Breiman</surname><given-names>L</given-names></name></person-group><article-title>Heuristics of instability and stabilization in model selection</article-title><source>The Annals of Statistics</source><year>1996</year><volume>24</volume><fpage>2350</fpage><lpage>2383</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zou</surname><given-names>H</given-names></name><name><surname>Hastie</surname><given-names>T</given-names></name></person-group><article-title>Regularization and variable selection via the elastic net</article-title><source>J R Statist Soc B</source><year>2005</year><volume>67</volume><fpage>301</fpage><lpage>320</lpage></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Granger</surname><given-names>CWJ</given-