me><name><surname>Desmond</surname><given-names>TJ</given-names></name><name><surname>Frey</surname><given-names>KA</given-names></name><name><surname>Maren</surname><given-names>S</given-names></name></person-group><article-title>Hippocampal inactivation disrupts the acquisition and contextual encoding of fear extinction</article-title><source>J. Neurosci.</source><year>2005</year><volume>25</volume><fpage>8978</fpage><lpage>8987</lpage><pub-id pub-id-type="pmid">16192388</pub-id></citation></ref><ref id="b16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Craig</surname><given-names>AD</given-names></name></person-group><article-title>Interoception: the sense of the physiological condition of the body</article-title><source>Curr. Opin. Neurobiol.</source><year>2003</year><volume>13</volume><fpage>500</fpage><lpage>505</lpage><pub-id pub-id-type="pmid">12965300</pub-id></citation></ref><ref id="b17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Effting</surname><given-names>M</given-names></name><name><surname>Kind</surname><given-names>M</given-names></name></person-group><article-title>Contextual control of human fear associations in a renewal paradigm</article-title><source>Behav. Res. Ther.</source><year>2007</year><volume>45</volume><fpage>2002</fpage><lpage>2008</lpage><pub-id pub-id-type="pmid">17451643</pub-id></citation></ref><ref id="b18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fanselow</surname><given-names>MS</given-names></name></person-group><article-title>Contextual fear, gestalt memories, and the hippocampus</article-title><source>Behav. Brain Res.</source><year>2000</year><volume>110</volume><fpage>71</fpage><lpage>81</lpage></citation></ref><ref id="b19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Foa</surname><given-names>EB</given-names></name><name><surname>Dancu</