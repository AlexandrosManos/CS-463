lisher-name>Cambridge University Press</publisher-name></mixed-citation></ref><ref id="pone.0006055-Hughes1"><label>27</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hughes</surname><given-names>KA</given-names></name><name><surname>Reynolds</surname><given-names>RM</given-names></name></person-group><year>2005</year><article-title>Evolutionary and mechanistic theories of aging.</article-title><source>Annu Rev Entomol</source><volume>50</volume><fpage>421</fpage><lpage>445</lpage><comment>Available: <ext-link ext-link-type="uri" xlink:href="http://arjournals.annualreviews.org.floyd.lib.umn.edu/doi/abs/10.1146/annurev.ento.50.071803.130409">http://arjournals.annualreviews.org.floyd.lib.umn.edu/doi/abs/10.1146/annurev.ento.50.071803.130409</ext-link> via the Internet</comment><pub-id pub-id-type="pmid">15355246</pub-id></mixed-citation></ref><ref id="pone.0006055-Tatar2"><label>28</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Tatar</surname><given-names>M</given-names></name><name><surname>Promislow</surname><given-names>DEL</given-names></name></person-group><year>1997</year><article-title>Fitness costs of female reproduction.</article-title><source>Evolution</source><volume>51</volume><fpage>1323</fpage><lpage>1326</lpage></mixed-citation></ref><ref id="pone.0006055-Findlay1"><label>29</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Findlay</surname><given-names>GD</given-names></name><name><surname>Yi</surname><given-names>X</given-names></name><name><surname>MacCoss</surname><given-names>MJ</given-names></name><name><surname>Swanson</surname><given-names>WJ</given-names></name></person-group><year>2008</year><article-title>Proteomics reveals novel <italic>Drosophila</italic> seminal fluid proteins transferred at mating.</article-title><source>PLoS Biology</source><volume>6</volume><fpage>1417</fpage><lpage>1426</lpage></mixed-citation></ref><ref id="pone.0006055-Rauser1"><label>30</label><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Rauser</surname><given-names>CL</given-names></name><name><surname>Mueller</surname><given-names>LD</given-names></name><name><surname>Travisano</surname><given-names>M</given-names></name><name><surname>Rose</surname><given-names>MR</given-names></name></person-group><year>2009</year><article-title>Evolution of aging and late life.</article-title><person-group person-group-type="editor"><name><surname>Rose</surname><given-names>MR</given-names></name><name><surname>Garland</surname><given-names>TJ</given-names></name></person-group><source>Experimental Evolution: Concepts, Methods, and Applications of Selection Experiments</source><publisher-loc>Berkeley</publisher-loc><publisher-name>University of California Press</publisher-name></mixed-citation></ref><ref id="pone.0006055-Gruber1"><label>31</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gruber</surname><given-names>J</given-names></name><name><surname>Tang</surname><given-names>SY</given-names></name><name><surname>Halliwell</surname><given-names>B</given-names></name></person-group><year>2007</year><article-title>Evidence for a trade-off between survival and fitness caused by resveratrol treatment of <italic>Caenorhabditis elegans</italic>.</article-title><source>Ann N Y Acad Sci</source><volume>1100(Biogerontology Mechanisms and Interventions)</volume><fpage>530</fpage><lpage>542</lpage><comment>Available: <ext-link ext-link-type="uri" xlink:href="http://dx.doi.org/10.1196/annals.1395.059">http://dx.doi.org/10.1196/annals.1395.059</ext-link> via the Internet</comment><pub-id pub-id-type="pmid">17460219</pub-id></mixed-citation></ref></ref-list><fn-group><fn fn-type="conflict"><p><bold>Competing Interests: </bold>The authors have declared that no competing inte