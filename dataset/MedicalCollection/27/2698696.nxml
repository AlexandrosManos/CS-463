cation-type="journal"><person-group person-group-type="author"><name><surname>Lin</surname><given-names>LF</given-names></name><name><surname>Doherty</surname><given-names>DH</given-names></name><name><surname>Lile</surname><given-names>JD</given-names></name><etal/></person-group><year>1993</year><article-title>GDNF: a glial cell line-derived neurotrophic factor for midbrain dopaminergic neurons</article-title><source>Science</source><volume>260</volume><fpage>1130</fpage><lpage>2</lpage><pub-id pub-id-type="pmid">8493557</pub-id></mixed-citation></ref><ref id="b10-co-2-233"><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Mangelsdorf</surname><given-names>DJ</given-names></name><name><surname>Umesono</surname><given-names>K</given-names></name><name><surname>Evans</surname><given-names>RM</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Sporn</surname><given-names>MB</given-names></name><name><surname>Roberts</surname><given-names>AB</given-names></name><name><surname>Goodman</surname><given-names>DS</given-names></name></person-group><year>1994</year><source>The Retinoids. Biology, Chemistry, and Medicine</source><publisher-name>Raven Press</publisher-name><publisher-loc>New York</publisher-loc><fpage>314</fpage><lpage>49</lpage></mixed-citation></ref><ref id="b11-co-2-233"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>McGee Sanftner</surname><given-names>LH</given-names></name><name><surname>Abel</surname><given-names>H</given-names></name><name><surname>Hauswirth</surname><given-names>WW</given-names></name><etal/></person-group><year>2001</year><article-title>Glial cell line derived neurotrophic factor delays photoreceptor degeneration in a transgenic rat model of retinitis pigmentosa</article-title><source>Mol Ther</source><volume>4</volume><fpage>622</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">11735347</pub-id></mixed-citation></ref><ref id="b12-co-2-233"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Miyajima</surname><given-names>H</given-names></name><name><surname>Osanai</surname><given-names>M</given-names></name><name><surname>Chiba</surname><given-names>H</given-names></name><etal/></person-group><year>2005</year><article-title>Glyceraldehyde-derived advanced glycation end-products preferentially induce VEGF expression and reduce GDNF expression in human astrocytes</article-title><source>Biochem Biophys Res Commun</source><volume>330</volume><fpage>361</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">15796891</pub-id></mixed-citation></ref><ref id="b13-co-2-233"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nishikiori</surname><given-names>N</given-names></name><name><surname>Mitamura</surname><given-names>Y</given-names></name><name><surname>Tashimo</surname><given-names>A</given-names></name><etal/></person-group><year>2005</year><article-title>Glial cell line-derived neurotrophic factor in the vitreous of patients with proliferative diabetic retinopathy</article-title><source>Diabetes Care</source><volume>28</volume><fpage>2588</fpage></mixed-citation></ref><ref id="b14-co-2-233"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nishikiori</surname><given-names>N</given-names></name><name><surname>Osanai</surname><given-names>M</given-names></name><name><surname>Chiba</surname><given-names>H</given-names></name><etal/></person-group><year>2007a</year><article-title>Glial cell-derived cytokines attenuate the breakdown of vascular integrity in diabetic retinopathy</article-title><source>Diabetes</source><volume>56</volume><fpage>1333</fpage><lpage>40</lpage></mixed-citation></ref><ref id="b15-co-2-233"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nishikiori</surname><given-names>N</given-names></name><name><surname>Osanai</surname><given-names>M</given-names></name><name><surname>Chiba</surname><given-names>H</given-names></name><etal/></person-group><year>2007b</year><article-title>Inhibitory effects of retinoic acid receptor alpha stimulants on murine cataractogenesis through suppression of deregulated calpains</article-title><source>Invest Ophthalmol Vis Sci</source><volume>48</volume><fpage>2224</fpage><lpage>9</lpage></mixed-citation></ref><ref id="b16-co-2-233"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Politi</surname><given-names>LE</given-names></name><name><surname>Rotstein</surname><given-names>NP</given-names></name><name><surname>Carri</surname><given-names>NG</given-names></name></person-group><year>2001</year><article-title>Effect of GDNF on neuroblast proliferation and photoreceptor survival: additive protection with docosahexaenoic acid</article-title><source>Invest Ophthalmol Vis Sci</source><volume>42</volume><fpage>3008</fpage><lpage>15</lpage><pub-id pub-id-type="pmid">11687549</pub-id></mixed-citation></ref><ref id="b17-co-2-233"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Tezel</surname><given-names>G</given-names></name><name><surname>Wax</surname><given-names>MB</given-names></name></person-group><year>1999</year><article-title>Inhibition of caspase activity in retinal cell apoptosis induced by various stimuli in vitro</article-title><source>Invest Ophthalmol Vis Sci</source><volume>40</volume><fpage>2660</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">10509663</pub-id></mixed-citation></ref><ref id="b18-co-2-233"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Thang</surname><given-names>SH</given-names></name><name><surname>Kobayashi</surname><given-names>M</given-names></name><name><surname>Matsuoka</surname><given-names>I</given-names></name></person-group><year>2000</year><article-title>Regulation of glial cell line-derived neurotrophic factor responsiveness in developing rat sympathetic neurons by retinoic acid and bone morphogenetic protein-2</article-title><source>J Neurosci</source><volume>20</volume><fpage>2917</fpage><lpage>25</lpage><pub-id pub-id-type="pmid">10751444</pub-id></mixed-citation></ref><ref id="b19-co-2-233"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Treanor</surname><given-names>JJ</given-names></name><name><surname>Goodman</surname><given-names>L</given-names></name><name><surname>de Sauvage</surname><given-names>F</given-names></name><etal/></person-group><year>1996</year><article-title>Characterization of a multicomponent receptor for GDNF</article-title><source>Nature</source><volume>382</volume><fpage>80</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">8657309</pub-id></mixed-citation></ref><ref id="b20-co-2-233"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wu</surname><given-names>WC</given-names></name><name><surname>Lai</surname><given-names>CC</given-names></name><name><surname>Chen</surname><given-names>SL</given-names></name><name><surname>Sun</surname><given-names>MH</given-names></name><etal/></person-group><year>2004</year><article-title>GDNF gene therapy attenuates retinal ischemic injuries in rats</article-title><source>Mol Vis</source><volume>10</volume><fpage>93</fpage><lpage>102</lpage><pub-id pub-id-type="pmid">14961006</pub-id></mixed-citation></ref></ref-list></back><floats-group><fig id="f1-co-2-233" position="float"><label>Figure 1</label><caption><p>RAs inhibited the apoptosis during the development of diabetic retinopathy. <bold>A</bold> and <bold>B</bold>, Apoptosis of retinal cells in retina. (<bold>A</bold>, apoptotic cell counts, TdT-dUTP terminal nick-end labeling assay. <bold>B</bold>, laser-scanning confocal analysis.)</p><p><bold>Abbreviations:</bold> Ctrl, control mice; ATRA, all-trans-retinoic acid (ATRA)-treated diabetic mice; Am580, Am580-treated diabetic mice; DM, diabetic mice.</p><p><bold>Notes:</bold> **p &#x0003c; 0.01 Scale bars: 25 &#x003bc;m. The choroid (C), retinal pigment epithelium (RPE), outer nuclear layer (ONL), outer plexiform layer (OPL), inner nuclear layer (INL), inner plexiform layer (IPL), and the ganglion cell layer (GCL) are labeled in the micrograph.</p></caption><graphic xlink:href="co-2-233f1"/></fig></floats-group></article>