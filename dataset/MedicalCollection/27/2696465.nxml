</td><td></td><td align="center">bcr/abl</td><td align="center">3</td></tr><tr><td align="center"><bold>23</bold></td><td align="center">f</td><td align="center">MDS</td><td align="center">52</td><td align="center">M</td><td align="center">PBSCT</td><td align="center">no</td><td></td><td></td><td align="center">15</td></tr><tr><td align="center"><bold>24</bold></td><td align="center">f</td><td align="center">CML</td><td align="center">1</td><td align="center">n.k.</td><td align="center">BMT</td><td align="center">no</td><td></td><td></td><td align="center">3</td></tr><tr><td align="center"><bold>25</bold></td><td align="center">f</td><td align="center">ALL</td><td align="center">14</td><td align="center">C</td><td align="center">PBSCT</td><td align="center">yes</td><td align="center">n.k./+361</td><td></td><td align="center">2</td></tr><tr><td colspan="10"><hr></hr></td></tr><tr><td align="center"><bold>26</bold></td><td align="center">m</td><td align="center">AML</td><td align="center">89</td><td align="center">M</td><td align="center">PBSCT</td><td align="center">no</td><td></td><td></td><td align="center">4</td></tr><tr><td align="center"><bold>27</bold></td><td align="center">f</td><td align="center">AML</td><td align="center">49</td><td align="center">C</td><td align="center">PBSCT</td><td align="center">no</td><td></td><td></td><td align="center">14</td></tr><tr><td align="center"><bold>28</bold></td><td align="center">f</td><td align="center">AML</td><td align="center">48</td><td align="center">M</td><td align="center">PBSCT</td><td align="center">yes</td><td align="center">infection/+144</td><td></td><td align="center">2</td></tr><tr><td align="center"><bold>29</bold></td><td align="center">m</td><td align="center">CML</td><td align="center">49</td><td align="center">C</td><td align="center">PBSCT</td><td align="center">yes</td><td align="center">GvHD/+833</td><td align="center">bcr/abl</td><td align="center">16</td></tr><tr><td align="center"><bold>30</bold