oup person-group-type="author"><name><surname>Klein</surname><given-names>GA</given-names></name><name><surname>Calderwood</surname><given-names>R</given-names></name><name><surname>MacGregor</surname><given-names>D</given-names></name></person-group><article-title>Critical decision method for eliciting knowledge</article-title><source>IEEE Trans Syst Man Cybern</source><year>1989</year><volume>19</volume><fpage>462</fpage><lpage>472</lpage><pub-id pub-id-type="doi">10.1109/21.31053</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crandall</surname><given-names>BW</given-names></name></person-group><article-title>A comparative study of think-aloud and critical decision knowledge elicitation methods</article-title><source>ACM SIGART Bulletin</source><year>1989</year><volume>108</volume><fpage>144</fpage><lpage>146</lpage><pub-id pub-id-type="doi">10.1145/63266.63288</pub-id></citation></ref><ref id="B9"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Glasser</surname><given-names>BG</given-names></name></person-group><source>Doing grounded theory: Issues and discussions</source><year>1998</year><publisher-name>Mill Valley, CA: Sociology Press</publisher-name></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Johnson-Laird</surname><given-names>P</given-names></name></person-group><source>Mental Models</source><year>1983</year><publisher-name>Cambridge, MA: Harvard University Press</publisher-name></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Schumacher</surname><given-names>R</given-names></name><name><surname>Czerwinski</surname><given-names>M</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Hoffman R</surname></name></person-group><article-title>Mental models and the acquisition of expert knowledge</article-title><source>The psychology of expertise</source><year>1992</year><publisher-name>New York: Springer-Verlag</publisher-name><fpage>61</fpage><lpage>79</lpage></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Klein</surname><given-names>GA</given-names></name><name><surname>Calderwood</surname><given-names>R</given-names></name><name><surname>Clinton-Cirocco</surname><given-names>A</given-names></name></person-group><article-title>Rapid decision making on the fireground</article-title><source>30th Annual Meeting; Human Factors and Ergonomics Society</source><year>1986</year><publisher-name>Santa Monica, CA; Human Factors and Ergonomics Society</publisher-name><fpage>576</fpage><lpage>580</lpage></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Klinger</surname><given-names>DW</given-names></name><name><surname>Andriole</surname><given-names>SJ</given-names></name><name><surname>Militello</surname><given-names>LG</given-names></name><name><surname>Adelman</surname><given-names>L</given-names></name><name><surname>Klein</surname><given-names>G</given-names></name><name><surname>Gomes</surname><given-names>ME</given-names></name></person-group><article-title>Designing for performance: a cognitive systems engineering approach to modifying an AWACS human-computer interface</article-title><source>Technical Report AL/CF-TR-1993-0093)</source><publisher-name>Wright-Patterson AFB, OH: Department of the Air Force, Armstrong Laboratory, Air Force Materiel Command</publisher-name></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaempf</surname><given-names>GL</given-names></name><name><surname>Klein</surname><given-names>GA</given-names></name><name><surname>Thordsen</surname><given-names>ML</given-names></name><name><surname>Wolf</surname><given-names>S</given-names></name></person-group><article-title>Decision making in complex command-and-control environments</article-title><source>Human Factors</source><year>1996</year><volume>38</volume><fpage>220</fpage><lpage>231</lpage><pub-id pub-id-type="doi">10.1518/001872096779047986</pub-id></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Orasanu</surname><given-names>J</given-names></name><name><surname>Fischer</surname><given-names>U</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Zsambok C, Klein GA</surname></name></person-group><article-title>Finding decisions in natural environments: The view from the cockpit</article-title><source>Naturalistic decision making</source><year>1997</year><publisher-name>Mahwah, NJ: Lawrence Erlbaum Associates</publisher-name><fpage>343</fpage><lpage>358</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Randel</surname><given-names>JM</given-names></name><name><surname>Pugh</surname><given-names>HL</given-names></name><name><surname>Reed</surname><given-names>SK</given-names></name></person-group><article-title>Methods for analyzing cognitive skills for a technical task</article-title><source>Int J Hum Comput Stud</source><year>1996</year><volume>45</volume><fpage>579</fpage><lpage>597</lpage><pub-id pub-id-type="doi">10.1006/ijhc.1996.0068</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crandall</surname><given-names>B</given-names></name><name><surname>Getchell-Reiter</surname><given-names>K</given-names></name></person-group><article-title>Critical decision method: A technique for eliciting concrete assessment indicators from the intuition of NICU nurses</article-title><source>ANS Adv Nurs Sci</source><year>1993</year><volume>16</volume><fpage>42</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">8311424</pub-id></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Calderwood</surname><given-names>R</given-names></name><name><surname>Crandall</surname><given-names>B</given-names></name><name><surname>Klein</surname><given-names>GA</given-names></name></person-group><article-title>Expert and novice fire ground command decisions (KATR-858(D)-87-02F)</article-title><source>Final Report under contract MDA903-85-C-0327 for the US</source><year>1987</year><publisher-name>Army Research Institute Alexandria, VA: Fairborn, OH, Klein Associates Inc</publisher-name></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Militello</surname><given-names>LG</given-names></name><name><surname>Hutton</surname><given-names>RJB</given-names></name></person-group><article-title>Applied Cognitive Task Analysis (ACTA): A practitioner's toolkit for understanding cognitive task demands</article-title><source>Ergonomics</source><year>1998</year><volume>41</volume><fpage>1618</fpage><lpage>1641</lpage><pub-id pub-id-type="pmid">9819578</pub-id><pub-id pub-id-type="doi">10.1080/001401398186108</pub-id></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Crandall</surname><given-names>B</given-names></name><name><surname>Klein</surname><given-names>G</given-names></name><name><surname>Hoffman</surname><given-names>RR</given-names></name></person-group><source>Working minds: A practitioner's guide to Cognitive Task Analysis</source><year>2006</year><publisher-name>Cambridge, MA: The MIT Press</publisher-name></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cohen</surname><given-names>T</given-names></name><name><surname>Blatter</surname><given-names>B</given-names></name><nam