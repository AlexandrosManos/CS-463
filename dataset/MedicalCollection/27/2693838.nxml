ames></name></person-group><article-title>Evaluation of outcome in critically ill patients with nosocomial enterobacter bacteremia: results of a matched cohort study</article-title><source>Chest</source><year>2003</year><volume>123</volume><fpage>1208</fpage><lpage>1213</lpage><pub-id pub-id-type="pmid">12684313</pub-id></element-citation></ref></ref-list></back></article>