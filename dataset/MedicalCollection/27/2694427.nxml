me><name><surname>Murray</surname><given-names>T</given-names></name><name><surname>Xu</surname><given-names>J</given-names></name><name><surname>Thun</surname><given-names>MJ</given-names></name></person-group><article-title>Cancer statistics 2007</article-title><source>CA Cancer J Clin</source><year>2007</year><volume>57</volume><fpage>43</fpage><lpage>66</lpage><!--PubMed citation query: 'CA Cancer J Clin||57|43||bib9|'--><pub-id pub-id-type="pmid">17237035</pub-id></citation></ref><ref id="bib10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaifi</surname><given-names>JT</given-names></name><name><surname>Yekebas</surname><given-names>EF</given-names></name><name><surname>Schurr</surname><given-names>P</given-names></name><name><surname>Obonyo</surname><given-names>D</given-names></name><name><surname>Wachowiak</surname><given-names>R</given-names></name><name><surname>Busch</surname><given-names>P</given-names></name><name><surname>Heinecke</surname><given-names>A</given-names></name><name><surname>Pantel</surname><given-names>K</given-names></name><name><surname>Izbicki</surname><given-names>JR</given-names></name></person-group><article-title>Tumor-cell homing to lymph nodes and bone marrow and CXCR4 expression in esophageal cancer</article-title><source>J Natl Cancer Inst</source><year>2005</year><volume>97</volume><fpage>1840</fpage><lpage>1847</lpage><!--PubMed citation query: 'J Natl Cancer Inst||97|1840||bib10|'--><pub-id pub-id-type="pmid">16368946</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaplan</surname><given-names>EL</given-names></name><name><surname>Meier</surname><given-names>P</given-names></name></person-group><article-title>Non-parametric estimations from incomplete observations</article-title><source>J Am Stat Assoc</source><year>1958</year><volume>53</volume><fpage>457</fpage><lpage>481</lpage><!--PubMed citat