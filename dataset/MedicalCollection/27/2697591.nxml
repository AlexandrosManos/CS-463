ent:</bold><break/><bold>Mild &#x02013; Moderate &#x02013; Severe (%)</bold></th><th valign="top" align="left" rowspan="1" colspan="1"><bold>45 mg</bold></th><th valign="top" align="left" rowspan="1" colspan="1"><bold>30 mg</bold></th><th valign="top" align="left" rowspan="1" colspan="1"><bold>22.5 mg</bold></th><th valign="top" align="left" rowspan="1" colspan="1"><bold>7.5 mg</bold></th></tr></thead><tbody><tr><td valign="top" align="left" rowspan="1" colspan="1">Hot flashes</td><td valign="top" align="left" rowspan="1" colspan="1">33&#x02013;24&#x02013;0</td><td valign="top" align="left" rowspan="1" colspan="1">59&#x02013;18&#x02013;2</td><td valign="top" align="left" rowspan="1" colspan="1">49&#x02013;10&#x02013;0</td><td valign="top" align="left" rowspan="1" colspan="1">44&#x02013;12&#x02013;1</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Injection site reaction</td><td valign="top" align="left" rowspan="1" colspan="1">14&#x02013;1&#x02013;0</td><td valign="top" align="left" rowspan="1" colspan="1">22&#x02013;0&#x02013;0</td><td valign="top" align="left" rowspan="1" colspan="1">89&#x02013;14&#x02013;0</td><td valign="top" align="left" rowspan="1" colspan="1">29&#x02013;4&#x02013;1</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Fatigue</td><td valign="top" align="left" rowspan="1" colspan="1">7&#x02013;5&#x02013;0</td><td valign="top" align="left" rowspan="1" colspan="1">10&#x02013;4&#x02013;0</td><td valign="top" align="left" rowspan="1" colspan="1">6&#x02013;0&#x02013;0</td><td valign="top" align="left" rowspan="1" colspan="1">13&#x02013;4&#x02013;0</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Testicular atrophy</td><td valign="top" align="left" rowspan="1" colspan="1">5&#x02013;2&#x02013;0</td><td valign="top" align="left" rowspan="1" colspan="1">4&#x02013;0&#x02013;0</td><td valign="top" align="left" rowspan="1" colspan="1">2&#x02013;0&#x02013;0</td><td valign="top" align="left" rowspan="1" colsp