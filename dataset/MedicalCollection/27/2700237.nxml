ef id="CR11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barreto</surname><given-names>S</given-names></name><name><surname>McManus</surname><given-names>M</given-names></name></person-group><article-title>Casting the net for &#x0201c;depression&#x0201d; among ethnic minority children from high-risk urban communities</article-title><source>Clinical Psychology Review</source><year>1997</year><volume>17</volume><fpage>823</fpage><lpage>845</lpage></citation><citation citation-type="display-unstructured">Barreto, S., &#x00026; McManus, M. (1997). Casting the net for &#x0201c;depression&#x0201d; among ethnic minority children from high-risk urban communities. Clinical Psychology Review,17, 823&#x02013;845. doi:10.1016/S0272-7358(97)00054-8. <pub-id pub-id-type="pmid">9439870</pub-id></citation></ref><ref id="CR12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Beardslee</surname><given-names>W</given-names></name><name><surname>Podorefsky</surname><given-names>D</given-names></name></person-group><article-title>Resilient adolescents whose parents have serious affective and other psychiatric disorders: The importance of self-understanding and relationships</article-title><source>The American Journal of Psychiatry</source><year>1988</year><volume>145</volume><fpage>63</fpage><lpage>69</lpage></citation><citation citation-type="display-unstructured">Beardslee, W., &#x00026; Podorefsky, D. (1988). Resilient adolescents whose parents have serious affective and other psychiatric disorders: The importance of self-understanding and relationships. The American Journal of Psychiatry,145, 63&#x02013;69. <pub-id pub-id-type="pmid">3337294</pub-id></citation></ref><ref id="CR13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Beardslee</surname><given-names>W</given-names></name><name><surname>Versage</surname><given-names>E</given-names></name><name><surname>Gladstone</surname><given-names>T</given-names></name></person-group><article-title>Children of affectively ill parents: A review of the past ten years</article-title><source>Journal of the American Academy of Child and Adolescent Psychiatry</source><year>1998</year><volume>37</volume><fpage>1134</fpage><lpage>1141</lpage></citation><citation citation-type="display-unstructured">Beardslee, W., Versage, E., &#x00026; Gladstone, T. (1998). Children of affectively ill parents: A review of the past ten years. Journal of the American Academy of Child and Adolescent Psychiatry,37, 1134&#x02013;1141. <pub-id pub-id-type="pmid">9808924</pub-id></citation></ref><ref id="CR14"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Beardslee</surname><given-names>WR</given-names></name></person-group><source>Out of the darkened room: When a parent is depressed: Protecting the children and strengthening the family</source><year>2003</year><publisher-loc>Boston, MA</publisher-loc><publisher-name>Little Brown &#x00026; Co</publisher-name></citation><citation citation-type="display-unstructured">Beardslee, W. R. (2003). Out of the darkened room: When a parent is depressed: Protecting the children and strengthening the family. Boston, MA: Little Brown &#x00026; Co. </citation></ref><ref id="CR15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bell</surname><given-names>C</given-names></name></person-group><article-title>Community violence: Causes, prevention, and intervention</article-title><source>Journal of the National Medical Association</source><year>1997</year><volume>89</volume><fpage>657</fpage><lpage>662</lpage></citation><citation citation-type="display-unstructured">Bell, C. (1997). Community violence: Causes, prevention, and intervention. Journal of the National Medical Association,89, 657&#x02013;662. <pub-id pub-id-type="pmid">9347679</pub-id></citation></ref><ref id="CR16"><citation cita