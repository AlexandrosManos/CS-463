><name><surname>Kishida</surname><given-names>O</given-names></name><etal/></person-group><year>2005</year><article-title>Genetic basis of phenotypic plasticity for predator-induced morphological defenses in anuran tadpole, <italic>Rana pirica</italic>, using cDNA subtraction and microarray analysis.</article-title><source>Biochemical and Biophysical Research Communications</source><volume>330</volume><fpage>1138</fpage><lpage>1145</lpage><pub-id pub-id-type="pmid">15823562</pub-id></citation></ref><ref id="pone.0005936-Swaab1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Swaab</surname><given-names>DF</given-names></name><name><surname>Bao</surname><given-names>AM</given-names></name><name><surname>Lucassen</surname><given-names>PJ</given-names></name></person-group><year>2005</year><article-title>The stress system in the human brain in depression and neurodegeneration.</article-title><source>Ageing Res Rev</source><volume>4</volume><fpage>141</fpage><lpage>194</lpage><pub-id pub-id-type="pmid">15996533</pub-id></citation></ref><ref id="pone.0005936-Jovine1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jovine</surname><given-names>L</given-names></name><name><surname>Qi</surname><given-names>H</given-names></name><name><surname>Williams</surname><given-names>Z</given-names></name><name><surname>Litscher</surname><given-names>E</given-names></name><name><surname>Wassarman</surname><given-names>PM</given-names></name></person-group><year>2002</year><article-title>The ZP domain is a conserved module for polymerization of extracellular proteins.</article-title><source>Nat Cell Biol</source><volume>4</volume><fpage>457</fpage><lpage>461</lpage><pub-id pub-id-type="pmid">12021773</pub-id></citation></ref><ref id="pone.0005936-Kokot1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kokot</surname><given-names>F</given-names></name><name><surname>Dulawa</surname><given-names>J</given-names></name></person-group><year>2000</year><article-title>Tamm-Horsfall protein updated.</article-title><source>Nephron</source><volume>85</volume><fpage>97</fpage><lpage>102</lpage><pub-id pub-id-type="pmid">10867513</pub-id></citation></ref><ref id="pone.0005936-Kumar1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kumar</surname><given-names>S</given-names></name><name><surname>Muchmore</surname><given-names>A</given-names></name></person-group><year>1990</year><article-title>Tamm-Horsfall protein&#x02014;uromodulin (1950-1990).</article-title><source>Kidney Int</source><volume>37</volume><fpage>1395</fpage><lpage>1401</lpage><pub-id pub-id-type="pmid">2194064</pub-id></citation></ref><ref id="pone.0005936-Hession1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hession</surname><given-names>C</given-names></name><name><surname>Decker</surname><given-names>JM</given-names></name><name><surname>Sherblom</surname><given-names>AP</given-names></name><name><surname>Kumar</surname><given-names>S</given-names></name><name><surname>Yue</surname><given-names>CC</given-names></name><etal/></person-group><year>1987</year><article-title>Uromodulin (Tamm-Horsfall glycoprotein): a renal ligand for lymphokines.</article-title><source>Science</source><volume>237</volume><fpage>1479</fpage><lpage>1484</lpage><pub-id pub-id-type="pmid">3498215</pub-id></citation></ref><ref id="pone.0005936-Rhodes1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rhodes</surname><given-names>DC</given-names></name></person-group><year>2000</year><article-title>Binding of Tamm-Horsfall protein to complement 1q measured by ELISA and resonant mirror biosensor techniques under various ionic-strength conditions.</article-title><sour