on-group><article-title>Observer performance in detecting multiple radiographic signals</article-title><source>Radiology</source><year>1976</year><volume>121</volume><fpage>337</fpage><lpage>347</lpage><pub-id pub-id-type="pmid">981610</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Metz</surname><given-names>CE</given-names></name><name><surname>Goodenough</surname><given-names>DJ</given-names></name><name><surname>Rossmann</surname><given-names>K</given-names></name></person-group><article-title>Evaluation of receiver operating characteristic curve data in terms of information theory, with applications in radiography</article-title><source>Radiology</source><year>1973</year><volume>109</volume><fpage>297</fpage><lpage>303</lpage><pub-id pub-id-type="pmid">4742316</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dwyer</surname><given-names>AJ</given-names></name></person-group><article-title>In pursuit of a piece of the ROC</article-title><source>Radiology</source><year>1996</year><volume>201</volume><fpage>621</fpage><lpage>625</lpage><pub-id pub-id-type="pmid">8939207</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Metz</surname><given-names>CE</given-names></name></person-group><article-title>ROC methodology in radiologic imaging</article-title><source>Invest Radiol</source><year>1986</year><volume>21</volume><fpage>720</fpage><lpage>733</lpage><pub-id pub-id-type="pmid">3095258</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Obuchowski</surname><given-names>NA</given-names></name></person-group><article-title>Sample size tables for receiver operating characteristics studies</article-title><source>AJR Am J Roentgenol</source><year>2000</year><volume>175</volume><fpage>603</fpage><lpage>608</lpage><pub-id pub-id-type="pmid">10954438</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bulpitt</surname><given-names>CJ</given-names></name></person-group><article-title>Confidence intervals</article-title><source>Lancet</source><year>1987</year><volume>1</volume><fpage>494</fpage><lpage>497</lpage><pub-id pub-id-type="pmid">2881050</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Thaete</surname><given-names>FL</given-names></name><name><surname>Fuhrman</surname><given-names>CR</given-names></name><name><surname>Oliver</surname><given-names>JH</given-names></name><etal/></person-group><article-title>Digital radiography and conventional imaging of the chest: a comparison of observer performance</article-title><source>AJR Am J Roentgenol</source><year>1994</year><volume>162</volume><fpage>575</fpage><lpage>581</lpage><pub-id pub-id-type="pmid">8109499</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ishigaki</surname><given-names>T</given-names></name><name><surname>Endo</surname><given-names>T</given-names></name><name><surname>Ikeda</surname><given-names>M</given-names></name><etal/></person-group><article-title>Subtle pulmonary disease: detection with computed radiography versus conventional chest radiography</article-title><source>Radiology</source><year>1996</year><volume>201</volume><fpage>51</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">8816520</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Blume</surname><given-names>H</given-names></name><name><surname>Steven</surname><given-names>PM</given-names></name><name><surname>Cobb</surname><given-names>M</given-names></name><name><surname>Ho</surname><given-names>AM</given-names></name><name><surname>Stevens</surname><given-names>F</given-names></name><name><surname>Muller</surname><given-names>S</given-names></name></person-group><article-title>Characterization of high-resolution liquid-crystal displays for medical images</article-title><source>Proc SPIE</source><year>2002</year><volume>4681</volume><fpage>23</fpage><lpage>28</lpage></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Pavlicek</surname><given-names>W</given-names></name><name><surname>Owen</surname><given-names>JM</given-names></name><name><surname>Peter</surname><given-names>MB</given-names></name></person-group><article-title>Active-matrix liquid crystal displays for clinical imaging: comparison with cathode ray tube displays</article-title><source>J Digit Imaging</source><year>2000</year><volume>13</volume><fpage>155</fpage><lpage>161</lpage><pub-id pub-id-type="pmid">10847388</pub-id></element-citation></ref></ref-list></back><floats-group><table-wrap id="T1" position="float"><label>Table 1</label><caption><p>Comparison of Observer Performance in Detecting Small Solitary Pulmonary Nodules, and Average Reading Time for LCD Monitor and CRT Monitor</p></caption><graphic xlink:href="kjr-4-153-i001"/><table-wrap-foot><fn><p>Note.-Data are Az values&#x000b1;standard error; 95% CIs are for mean difference of Az values.</p><p>LCD = liquid crystal display monitor, CRT = cathode-ray tube monitor</p><p>Readers 1 - 3: Board-certified radiologists</p><p>Readers 4 - 8: Senior residents in the department of diagnostic radiology</p><p><sup>*</sup>Standard error value was not given because the data were degenerative.</p></fn></table-wrap-foot></table-wrap></floats-group></article>