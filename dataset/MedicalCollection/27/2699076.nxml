><name><surname>Murray</surname><given-names>RE</given-names></name><name><surname>Rao</surname><given-names>PM</given-names></name><name><surname>Novelline</surname><given-names>RA</given-names></name></person-group><article-title>Epiploic appendagitis: The emegency department presentation</article-title><source>J Emerg Med</source><year>2002</year><volume>22</volume><fpage>9</fpage><lpage>13</lpage><pub-id pub-id-type="pmid">11809550</pub-id></element-citation></ref><ref id="CIT8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sandrasegaran</surname><given-names>K</given-names></name><name><surname>Maglinte</surname><given-names>DD</given-names></name><name><surname>Rajesh</surname><given-names>A</given-names></name><name><surname>Akisik</surname><given-names>FM</given-names></name></person-group><article-title>Primary epiloic appendagitis: CT diagnosis</article-title><source>Emerg Radiol</source><year>2004</year><volume>11</volume><fpage>9</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">15278705</pub-id></element-citation></ref><ref id="CIT9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Singh</surname><given-names>AK</given-names></name><name><surname>Gervais</surname><given-names>DA</given-names></name><name><surname>Hahn</surname><given-names>PF</given-names></name><name><surname>Rhea</surname><given-names>J</given-names></name><name><surname>Mueller</surname><given-names>PR</given-names></name></person-group><article-title>CT appearance of acute appendagitis</article-title><source>AJR Am J Roentgenol</source><year>2004</year><volume>183</volume><fpage>1303</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15505294</pub-id></element-citation></ref><ref id="CIT10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kulah</surname><given-names>B</given-nam