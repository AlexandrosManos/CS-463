<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Arthritis Res Ther</journal-id><journal-title>Arthritis Research &#x00026; Therapy</journal-title><issn pub-type="ppub">1478-6354</issn><issn pub-type="epub">1478-6362</issn><publisher><publisher-name>BioMed Central</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">19144159</article-id><article-id pub-id-type="pmc">2688237</article-id><article-id pub-id-type="publisher-id">ar2591</article-id><article-id pub-id-type="doi">10.1186/ar2591</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research Article</subject></subj-group></article-categories><title-group><article-title>Women, men, and rheumatoid arthritis: analyses of disease activity, disease characteristics, and treatments in the QUEST-RA Study</article-title></title-group><contrib-group><contrib id="A1" corresp="yes" contrib-type="author"><name><surname>Sokka</surname><given-names>Tuulikki</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>tuulikki.sokka@ksshp.fi</email></contrib><contrib id="A2" contrib-type="author"><name><surname>Toloza</surname><given-names>Sergio</given-names></name><xref ref-type="aff" rid="I2">2</xref><email>sergiotol@yahoo.com</email></contrib><contrib id="A3" contrib-type="author"><name><surname>Cutolo</surname><given-names>Maurizio</given-names></name><xref ref-type="aff" rid="I3">3</xref><email>mcutolo@unige.it</email></contrib><contrib id="A4" contrib-type="author"><name><surname>Kautiainen</surname><given-names>Hannu</given-names></name><xref ref-type="aff" rid="I4">4</xref><email>hannu.kautiainen@medcare.fi</email></contrib><contrib id="A5" contrib-type="author"><name><surname>Makinen</surname><given-names>Heidi</given-names></name><xref ref-type="aff" rid="I5">5</xref><email>heidi.makinen@ksshp.fi</email></contrib><contrib id="A6" contrib-type="author"><name><surname>Gogus</surname><given-names>Feride</given-names></name><xref ref-type="aff" rid="I6">6</xref><email>feride_g@yahoo.com</email></contrib><contrib id="A7" contrib-type="author"><name><surname>Skakic</surname><given-names>Vlado</given-names></name><xref ref-type="aff" rid="I7">7</xref><email>skaka@beotel.net</email></contrib><contrib id="A8" contrib-type="author"><name><surname>Badsha</surname><given-names>Humeira</given-names></name><xref ref-type="aff" rid="I8">8</xref><email>humeira.badsha@dbaj.ae</email></contrib><contrib id="A9" contrib-type="author"><name><surname>Peets</surname><given-names>T&#x000f5;nu</given-names></name><xref ref-type="aff" rid="I9">9</xref><email>tonup001@yahoo.com</email></contrib><contrib id="A10" contrib-type="author"><name><surname>Baranauskaite</surname><given-names>Asta</given-names></name><xref ref-type="aff" rid="I10">10</xref><email>astai@centras.lt</email></contrib><contrib id="A11" contrib-type="author"><name><surname>G&#x000e9;her</surname><given-names>P&#x000e1;l</given-names></name><xref ref-type="aff" rid="I11">11</xref><email>geherpal@freemail.hu</email></contrib><contrib id="A12" contrib-type="author"><name><surname>&#x000da;jfalussy</surname><given-names>Ilona</given-names></name><xref ref-type="aff" rid="I12">12</xref><email>ujfalussy@irgalmas.hu</email></contrib><contrib id="A13" contrib-type="author"><name><surname>Skopouli</surname><given-names>Fotini N</given-names></name><xref ref-type="aff" rid="I13">13</xref><email>fskopouli@hua.gr</email></contrib><contrib id="A14" contrib-type="author"><name><surname>Mavrommati</surname><given-names>Maria</given-names></name><xref ref-type="aff" rid="I14">14</xref><email>mmavromm@otenet.gr</email></contrib><contrib id="A15" contrib-type="author"><name><surname>Alten</surname><given-names>Rieke</given-names></name><xref ref-type="aff" rid="I15">15</xref><email>rieke.alten@schlosspark-klinik.de</email></contrib><contrib id="A16" contrib-type="author"><name><surname>Pohl</surname><given-names>Christof</given-names></name><xref ref-type="aff" rid="I15">15</xref><email>christof.pohl@schlosspark-klinik.de</email></contrib><contrib id="A17" contrib-type="author"><name><surname>Sibilia</surname><given-names>Jean</given-names></name><xref ref-type="aff" rid="I16">16</xref><email>jean.sibilia@wanadoo.fr</email></contrib><contrib id="A18" contrib-type="author"><name><surname>Stancati</surname><given-names>Andrea</given-names></name><xref ref-type="aff" rid="I17">17</xref><email>a.stancati@ireum.it</email></contrib><contrib id="A19" contrib-type="author"><name><surname>Salaffi</surname><given-names>Fausto</given-names></name><xref ref-type="aff" rid="I17">17</xref><email>fsalaff@tin.it</email></contrib><contrib id="A20" contrib-type="author"><name><surname>Romanowski</surname><given-names>Wojciech</given-names></name><xref ref-type="aff" rid="I18">18</xref><email>wojrom@mediclub.pl</email></contrib><contrib id="A21" contrib-type="author"><name><surname>Zarowny-Wierzbinska</surname><given-names>Danuta</given-names></name><xref ref-type="aff" rid="I19">19</xref><email>tms7460@gmail.com</email></contrib><contrib id="A22" contrib-type="author"><name><surname>Henrohn</surname><given-names>Dan</given-names></name><xref ref-type="aff" rid="I20">20</xref><email>dan_henrohn@hotmail.com</email></contrib><contrib id="A23" contrib-type="author"><name><surname>Bresnihan</surname><given-names>Barry</given-names></name><xref ref-type="aff" rid="I21">21</xref><email>academicresearch@st-vincents.ie</email></contrib><contrib id="A24" contrib-type="author"><name><surname>Minnock</surname><given-names>Patricia</given-names></name><xref ref-type="aff" rid="I22">22</xref><email>PMinnock@olh.ie</email></contrib><contrib id="A25" contrib-type="author"><name><surname>Knudsen</surname><given-names>Lene Surland</given-names></name><xref ref-type="aff" rid="I23">23</xref><email>surland@dadlnet.dk</email></contrib><contrib id="A26" contrib-type="author"><name><surname>Jacobs</surname><given-names>Johannes WG</given-names></name><xref ref-type="aff" rid="I24">24</xref><email>J.W.G.Jacobs@umcutrecht.nl</email></contrib><contrib id="A27" contrib-type="author"><name><surname>Calvo-Alen</surname><given-names>Jaime</given-names></name><xref ref-type="aff" rid="I25">25</xref><email>jcalvo@hsll.scsalud.es</email></contrib><contrib id="A28" contrib-type="author"><name><surname>Lazovskis</surname><given-names>Juris</given-names></name><xref ref-type="aff" rid="I26">26</xref><email>lazovskisj@cbdha.nshealth.ca</email></contrib><contrib id="A29" contrib-type="author"><name><surname>Pinheiro</surname><given-names>Geraldo da Rocha Castelar</given-names></name><xref ref-type="aff" rid="I27">27</xref><email>geraldo.castelar@gmail.com</email></contrib><contrib id="A30" contrib-type="author"><name><surname>Karateev</surname><given-names>Dmitry</given-names></name><xref ref-type="aff" rid="I28">28</xref><email>dekar@inbox.ru</email></contrib><contrib id="A31" contrib-type="author"><name><surname>Andersone</surname><given-names>Daina</given-names></name><xref ref-type="aff" rid="I29">29</xref><email>d.andersone@stradini.lv</email></contrib><contrib id="A32" contrib-type="author"><name><surname>Rexhepi</surname><given-names>Sylejman</given-names></name><xref ref-type="aff" rid="I30">30</xref><email>sylejmanrexhepi@hotmail.com</email></contrib><contrib id="A33" contrib-type="author"><name><surname>Yazici</surname><given-names>Yusuf</given-names></name><xref ref-type="aff" rid="I31">31</xref><email>yusuf@yazici.net</email></contrib><contrib id="A34" contrib-type="author"><name><surname>Pincus</surname><given-names>Theodore</given-names></name><xref ref-type="aff" rid="I31">31</xref><email>tedpincus@gmail.com</email></contrib><contrib id="A35" contrib-type="author"><collab>the QUEST-RA Group</collab><email>tuulikki.sokk