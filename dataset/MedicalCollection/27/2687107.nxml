me><name><surname>Sato</surname><given-names>M</given-names></name></person-group><article-title>A pharmacologic review of raloxifene</article-title><source>J Bone Miner Metab</source><year>1996</year><volume>14</volume><fpage>1</fpage><lpage>9</lpage></citation></ref><ref id="R17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jilka</surname><given-names>RL</given-names></name><name><surname>Hangoc</surname><given-names>G</given-names></name><name><surname>Girasole</surname><given-names>G</given-names></name><etal/></person-group><article-title>Increased osteoclast development after estrogen loss: Medication by interleukin-6</article-title><source>Science</source><year>1992</year><volume>257</volume><fpage>88</fpage><lpage>91</lpage><pub-id pub-id-type="pmid">1621100</pub-id></citation></ref><ref id="R18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yang</surname><given-names>NN</given-names></name><name><surname>Venugopalan</surname><given-names>M</given-names></name><name><surname>Hardikar</surname><given-names>S</given-names></name><name><surname>Glasebrook</surname><given-names>A</given-names></name></person-group><article-title>Identification of an estrogen response element activated by metabolites of &#x003b2;-estradiol and raloxifene</article-title><source>Science</source><year>1996</year><volume>273</volume><issue>5279</issue><fpage>1222</fpage><lpage>25</lpage><pub-id pub-id-type="pmid">8703055</pub-id></citation></ref><ref id="R19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gianni</surname><given-names>W</given-names></name><name><surname>Ricci</surname><given-names>A</given-names></name><name><surname>Gazzaniga</surname><given-names>P</given-names></name><etal/></person-group><article-title>Raloxifene modulates inter-leukin-6 and tumor necrosis factor-{alpha} synthesis <italic>in vivo</italic>: Re-sults from a pilot clinical study</article-title><source>J Clin Endocrinol Metab</source><year>2004</year><volume>89</volume><issue>12</issue><fpage>6097</fpage><lpage>99</lpage><pub-id pub-id-type="pmid">15579764</pub-id></citation></ref><ref id="R20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kumar</surname><given-names>V</given-names></name><name><surname>Green</surname><given-names>S</given-names></name><name><surname>Stack</surname><given-names>G</given-names></name><name><surname>Berry</surname><given-names>M</given-names></name><name><surname>Jin</surname><given-names>JR</given-names></name><name><surname>Chambon</surname><given-names>P</given-names></name></person-group><article-title>Functional domains of the human estrogen receptor</article-title><source>Cell</source><year>1987</year><volume>51</volume><fpage>941</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">3690665</pub-id></citation></ref><ref id="R21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heaney</surname><given-names>RP</given-names></name></person-group><article-title>Is the paradigm shifting?</article-title><source>Bone</source><year>2003</year><volume>33</volume><fpage>457</fpage><lpage>65</lpage><pub-id pub-id-type="pmid">14555248</pub-id></citation></ref><ref id="R22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Turner</surname><given-names>CH</given-names></name><name><surname>Sato</surname><given-names>M</given-names></name><name><surname>Bryant</surname><given-names>HU</given-names></name></person-group><article-title>Raloxifene preserves bone strength and bone mass in ovariectomized rats</article-title><source>Endocrinology</source><year>1994</year><volume>135</volume><issue>5</issue><fpage>2001</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">7956922</pub-id></citation>