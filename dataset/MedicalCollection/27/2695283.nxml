o><mml:mi>t</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:math></inline-formula> and <italic>R</italic><sub>q</sub>(<italic>t</italic>) = <italic>q</italic> <sup>(D<sub>2</sub>O)</sup> (t)/<italic>q</italic><sup>(H<sub>2</sub>O)</sup> (<italic>t</italic>), according to the experimental data [<xref ref-type="bibr" rid="b23-ijms-10-02383">23</xref>&#x02013;<xref ref-type="bibr" rid="b25-ijms-10-02383">25</xref>].</p></caption><graphic xlink:href="ijms-10-02383f5"/></fig><fig id="f6-ijms-10-02383" position="float"><label>Figure 6.</label><caption><p>The behavior of the entropy diameter for normal and heavy water, according to the experimental data [<xref ref-type="bibr" rid="b28-ijms-10-02383">28</xref>,<xref ref-type="bibr" rid="b29-ijms-10-02383">29</xref>].</p></caption><graphic xlink:href="ijms-10-02383f6"/></fig><fig id="f7-ijms-10-02383" position="float"><label>Figure 7.</label><caption><p>The temperature dependence of pH for the normal water.</p></caption><graphic xlink:href="ijms-10-02383f7"/></fig><fig id="f8-ijms-10-02383" position="float"><label>Figure 8.</label><caption><p>Temperature dependencies of <italic>p&#x00048;&#x00342;</italic> and <italic>p&#x00044;&#x00342;</italic>.</p></caption><graphic xlink:href="ijms-10-02383f8"/></fig><fig id="f9-ijms-10-02383" position="float"><label>Figure 9.</label><caption><p>The temperature dependence of the isothermic elasticity modulus for glycerol and water at atmospheric pressure [<xref ref-type="bibr" rid="b10-ijms-10-02383">10</xref>].</p></caption><graphic xlink:href="ijms-10-02383f9"/></fig><fig id="f10-ijms-10-02383" position="float"><label>Figure 10.</label><caption><p>Spectra of <sup>1</sup><italic>H</italic> &#x02013; <italic>NMR</italic> for the water-glycerol solution with the mole concentration <italic>x</italic>=0.51 of glycerol at different temperatures: <italic>a</italic> &#x02013; 308<italic>K</italic>, <italic>b</italic>=283<italic>K</italic>, <italic>c</italic>&#x02013;273<italic>K</italic>, according to [<xref ref-type="bibr" rid="b11-ijms-10-02383">11</xref>].</p></caption><graphic xlink:href="ijms-10-02383f10"/></fig><fig id="f11-ijms-10-02383" position="float"><label>Figure 11.</label><caption><p>Temperature dependencies (&#x02022; &#x02022; &#x02022;) of the self-diffusion coefficient <italic>D</italic><italic><sub>S</sub></italic>, according to [<xref ref-type="bibr" rid="b36-ijms-10-02383">36</xref>,<xref ref-type="bibr" rid="b38-ijms-10-02383">38</xref>] (a) and its collective part <italic>D</italic><italic><sub>c</sub></italic>, according to <xref ref-type="disp-formula" rid="FD11">Equation (11)</xref>; (b) for water molecules in the water solution of <italic>LiCl</italic> at <italic>z</italic><italic><sub>w</sub></italic> = 6.05. Other symbols (&#x000d7; &#x02013; [<xref ref-type="bibr" rid="b15-ijms-10-02383">15</xref>], + &#x02013; [<xref ref-type="bibr" rid="b16-ijms-10-02383">16</xref>], &#x02013; [<xref ref-type="bibr" rid="b36-ijms-10-02383">36</xref>]) in (a) correspond to the experimental data for pure water.</p></caption><graphic xlink:href="ijms-10-02383f11"/></fig><fig id="f12-ijms-10-02383" position="float"><label>Figure 12.</label><caption><p>Temperature dependencies (&#x02022; &#x02022; &#x02022;) of the self-diffusion coefficient <italic>D</italic><italic><sub>S</sub></italic>, according to [<xref ref-type="bibr" rid="b36-ijms-10-02383">36</xref>] (a) and its collective part <italic>D</italic><italic><sub>c</sub></italic>, according to <xref ref-type="disp-formula" rid="FD11">Equation (11)</xref>; (b) for water molecules in the water solution of <italic>NaCl</italic> at <italic>z</italic><italic><sub>w</sub></italic> = 6.05. All other designations have the same sense as in Figure <xref ref-type="fig" rid="f11-ijms-10-02383">11</xref>.</p></caption><graphic xlink:href="ijms-10-02383f12"/></fig><fig id="f13-ijms-10-02383" position="float"><label>Figure 13.</label><caption><p>Temperature dependencies (&#x02022; &#x02022; &#x02022;) of the self-diffusion coefficient <italic>D</italic><italic><sub>S</sub></italic>, according to [<xref ref-type="bibr" rid="b36-ijms-10-02383">36</xref>] (a) and its collective part <italic>D</italic><italic><sub>c</sub></italic>, according to <xref ref-type="disp-formula" rid="FD11">Equation (11)</xref>; (b) for water molecules in the water solution of <italic>KCl</italic> at <italic>z</italic><italic><sub>w</sub></italic> =6.05. All other designations have the same sense as in Figure <xref ref-type="fig" rid="f12-ijms-10-02383">12</xref>.</p></caption><graphic xlink:href="ijms-10-02383f13"/></fig><fig id="f14-ijms-10-02383" position="float"><label>Figure 14.</label><caption><p>Temperature dependencies of the ratios <inline-formula><mml:math id="M140"><mml:msubsup><mml:mi>R</mml:mi><mml:mo>&#x003c5;</mml:mo><mml:mrow><mml:mo stretchy="false">(</mml:mo><mml:msub><mml:mi>H</mml:mi><mml:mn>2</mml:mn></mml:msub><mml:mi>O</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mrow></mml:msubsup><mml:mo stretchy="false">(</mml:mo><mml:mi>t</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:math></inline-formula> = &#x003c5;<italic><sup>(H</sup></italic><sup><sub>2</sub></sup><italic><sup>O</sup></italic><sup>)</sup><italic>(t)</italic>/<italic>&#x003c5;</italic><italic><sup>(Ar)</sup></italic><italic>(t)</italic> and <italic>R</italic><italic><sub>&#x003c5;</sub></italic>(<italic>t</italic>) <italic>= &#x003c5;</italic><sup>(</sup><italic><sup>D</sup></italic><sup><sub>2</sub></sup><italic><sup>O</sup></italic><sup>)</sup><italic>(t)</italic>/<italic>&#x003c5;</italic><sup>(</sup><italic><sup>H</sup></italic><sup><sub>2</sub></sup><italic><sup>O</sup></italic><sup>)</sup><italic>(t)</italic> on the coexistence curves of normal and heavy water, and argon, according to [<xref ref-type="bibr" rid="b24-ijms-10-02383">24</xref>,<xref ref-type="bibr" rid="b25-ijms-10-02383">25</xref>].</p></caption><graphic xlink:href="ijms-10-02383f14"/></fig><table-wrap id="t1-ijms-10-02383" position="float"><label>Table 1.</label><caption><p>The values of <italic>D</italic><italic><sub>s</sub></italic>, <italic>D</italic><italic><sub>c</sub></italic> and <mml:math id="M141"><mml:msubsup><mml:mo>&#x003c4;</mml:mo><mml:mn>0</mml:mn><mml:mrow><mml:mo stretchy="false">(</mml:mo><mml:mi>w</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mrow></mml:msubsup></mml:math> for the water- <italic>NaCl</italic> solutions.</p></caption><table frame="hsides" rules="groups"><thead><tr><th valign="bottom" align="left" rowspan="1" colspan="1">Solution</th><th valign="bottom" align="center" rowspan="1" colspan="1"><inline-formula><mml:math id="M142"><mml:msubsup><mml:mi>r</mml:mi><mml:mi>c</mml:mi><mml:mo>+</mml:mo></mml:msubsup></mml:math></inline-formula>, &#x001fa;</th><th valign="bottom" align="center" rowspan="1" colspan="1"><italic>z</italic><italic><sub>w</sub></italic></th><th valign="bottom" align="center" rowspan="1" colspan="1"><italic>D</italic><italic><sub>s</sub></italic> &#x000b7;10<sup>5</sup>, <italic>cm</italic><sup>2</sup>/<italic>s</italic></th><th valign="bottom" align="center" rowspan="1" colspan="1"><italic>D</italic><italic><sub>c</sub></italic> &#x000b7;10<sup>5</sup>, <italic>cm</italic><sup>2</sup>/<italic>s</italic></th><th valign="bottom" align="center" rowspan="1" colspan="1"><inline-formula><mml:math id="M143"><mml:msubsup><mml:mo>&#x003c4;</mml:mo><mml:mn>0</mml:mn><mml:mrow><mml:mo stretchy="false">(</mml:mo><mml:mi>w</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mrow></mml:msubsup><mml:mo>&#x022c5;</mml:mo><mml:msup><mml:mn>10</mml:mn><mml:mrow><mml:mn>12</mml:mn></mml:mrow></mml:msup><mml:mi>s</mml:mi></mml:math></inline-formula></th></tr></thead><tbody><tr><td valign="top" align="left" rowspan="1" colspan="1"><italic>W</italic> &#x02013; <italic>NaCl</italic></td><td valign="top" align="center" rowspan="1" colspan="1">0.98</td><td valign="top" align="center" rowspan="1" colspan="1">27.8</td><td valign="top" align="center" rowspan="1" colspan