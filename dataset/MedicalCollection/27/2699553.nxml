>KJ</given-names></name></person-group><year>1995</year><article-title>The responses of <italic>Glossina fuscipes fuscipes</italic> Newstead to odour attractants and traps.</article-title><source>Journal of African Zoology</source><volume>109</volume><fpage>23</fpage><lpage>30</lpage></mixed-citation></ref><ref id="pntd.0000474-Rogers1"><label>8</label><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Rogers</surname><given-names>D</given-names></name><name><surname>Robinson</surname><given-names>TP</given-names></name></person-group><year>2004</year><article-title>Tsetse distribution.</article-title><person-group person-group-type="editor"><name><surname>Maudlin</surname><given-names>I</given-names></name><name><surname>Holmes</surname><given-names>PH</given-names></name><name><surname>Miles</surname><given-names>MA</given-names></name></person-group><source>The trypanosomiases</source><publisher-name>CABI</publisher-name><fpage>139</fpage><lpage>180</lpage></mixed-citation></ref><ref id="pntd.0000474-Simarro1"><label>9</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Simarro</surname><given-names>PP</given-names></name></person-group><year>2006</year><article-title>Human African trypanosomiasis: an epidemiological update.</article-title><source>WHO Weekly Epidemiological Record</source><volume>81</volume><fpage>69</fpage><lpage>80</lpage></mixed-citation></ref><ref id="pntd.0000474-Green1"><label>10</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Green</surname><given-names>CH</given-names></name></person-group><year>1988</year><article-title>The effect of color on trap oriented and screen oriented responses in <italic>Glossina palpalis palpalis</italic> (Robineau-Desvoidy) (Diptera, Glossinidae).</article-title><source>Bulletin Of Entomological Research</source><volume>78</volume><fpage>591</fpage><lpage>604</lpage></mixed-citation></ref><ref id="pntd.0000474-Laveissire1"><label>11</label><mixed-citation publication-type="other"><person-group person-group-type="author"><name><surname>Laveissi&#x000e8;re</surname><given-names>C</given-names></name><name><surname>Garcia</surname><given-names>A</given-names></name><name><surname>San&#x000e9;</surname><given-names>B</given-names></name></person-group><year>2003</year><source>Lutte contre la maladie du sommeil et soins de sant&#x000e9; primaire</source><fpage>243</fpage></mixed-citation></ref><ref id="pntd.0000474-Laveissiere1"><label>12</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Laveissiere</surname><given-names>C</given-names></name><name><surname>Couret</surname><given-names>D</given-names></name><name><surname>Grebaut</surname><given-names>P</given-names></name></person-group><year>1987</year><article-title>Recherche sur les ecrans pour la lutte contra les glossines en region forestiere de Cote d'Ivoire. Mise au point d'un nouvel ecran.</article-title><source>Cahiers 0 R S T 0 M Serie Entomologie Medicale et Parasitologie</source><volume>25</volume><fpage>145</fpage><lpage>164</lpage></mixed-citation></ref><ref id="pntd.0000474-Challier1"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Challier</surname><given-names>A</given-names></name><name><surname>Eyraud</surname><given-names>M</given-names></name><name><surname>Lafaye</surname><given-names>A</given-names></name><name><surname>Laveissiere</surname><given-names>C</given-names></name></person-group><year>1977</year><article-title>Amelioration due rendement du piege biconique pour glossines (Diptera, Glossinidae) par l'emploi d'un cone inferieur bleu.</article-title><source>Cah ORSTOM, Ser Entomol med Parasitol</source><volume>15</volume><fpage>283</fpage><lpage>286</lpage></mixed-citation></ref><ref id="pntd.0000474-Vale2"><label>14</l