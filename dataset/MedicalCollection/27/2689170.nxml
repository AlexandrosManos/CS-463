dshoorn</surname><given-names>A</given-names></name></person-group><article-title>Accelerating Knowledge to Action in Client-Driven Care: Piloting a Social Interaction Approach to Knowledge Translation</article-title><source>Canadian Journal of Nursing Research</source><year>2008</year><volume>40</volume><fpage>58</fpage><lpage>74</lpage><pub-id pub-id-type="pmid">18714898</pub-id></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Aho</surname><given-names>JA</given-names></name></person-group><source>The things of the world: A social phenomenology</source><year>1998</year><publisher-name>Westport, Connecticut: Praeger</publisher-name></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Schwandt</surname><given-names>T</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Denzin N, Lincoln Y</surname></name></person-group><article-title>Three epistemological stances for qualitative inquiry: Interpretivism, hermenuetics and social constructionism</article-title><source>Handbook of Qualitative Research</source><year>2000</year><edition>2</edition><publisher-name>CA: Thousand Oaks</publisher-name><fpage>189</fpage><lpage>213</lpage></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Dopson</surname><given-names>S</given-names></name><name><surname>Fitzgerald</surname><given-names>L</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Dopson S, Fitzgerald L</surname></name></person-group><article-title>The Active Role of Context</article-title><source>Knowledge to Action?: Evidence-based Health Care in Context</source><year>2005</year><publisher-name>Oxford: University Press</publisher-name><fpage>79</fpage><lpage>102</lpage></citation></ref><ref id="B21"><citation citation-type="journal"><person-group