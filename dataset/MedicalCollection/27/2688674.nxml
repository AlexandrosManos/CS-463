>2008</year><volume>82</volume><fpage>2150</fpage><lpage>2160</lpage><pub-id pub-id-type="pmid">18094186</pub-id></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reeves</surname><given-names>PM</given-names></name><name><surname>Bommarius</surname><given-names>B</given-names></name><name><surname>Lebeis</surname><given-names>S</given-names></name><name><surname>McNulty</surname><given-names>S</given-names></name><name><surname>Christensen</surname><given-names>J</given-names></name><name><surname>Swimm</surname><given-names>A</given-names></name><etal/></person-group><article-title>Disabling poxvirus pathogenesis by inhibition of Abl-family tyrosine kinases</article-title><source>Nat Med</source><year>2005</year><volume>11</volume><fpage>731</fpage><lpage>739</lpage><pub-id pub-id-type="pmid">15980865</pub-id></citation></ref><ref id="b25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rietdorf</surname><given-names>J</given-names></name><name><surname>Ploubidou</surname><given-names>A</given-names></name><name><surname>Reckmann</surname><given-names>I</given-names></name><name><surname>Holmstr&#x000f6;m</surname><given-names>A</given-names></name><name><surname>Frischknecht</surname><given-names>F</given-names></name><name><surname>Zettl</surname><given-names>M</given-names></name><etal/></person-group><article-title>Kinesin dependent movement on microtubules precedes actin based motility of vaccinia virus</article-title><source>Nature Cell Biol</source><year>2001</year><volume>3</volume><fpage>992</fpage><lpage>1000</lpage><pub-id pub-id-type="pmid">11715020</pub-id></citation></ref><ref id="b26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roberts</surname><given-names>KL</given-names></name><name><surname>Smith</surname><given-names>GL</given-names></name></person-group><article-title>Vaccinia virus morphogenesis and dissemination</article-title><source>Trends Microbiol</source><year>2008</year><volume>16</volume><fpage>472</fpage><lpage>479</lpage><pub-id pub-id-type="pmid">18789694</pub-id></citation></ref><ref id="b27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rodriguez</surname><given-names>JF</given-names></name><name><surname>Janeczko</surname><given-names>R</given-names></name><name><surname>Esteban</surname><given-names>M</given-names></name></person-group><article-title>Isolation and characterization of neutralizing monoclonal antibodies to vaccinia virus</article-title><source>J Virol</source><year>1985</year><volume>56</volume><fpage>482</fpage><lpage>488</lpage><pub-id pub-id-type="pmid">4057358</pub-id></citation></ref><ref id="b28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roper</surname><given-names>RL</given-names></name><name><surname>Wolffe</surname><given-names>EJ</given-names></name><name><surname>Weisberg</surname><given-names>A</given-names></name><name><surname>Moss</surname><given-names>B</given-names></name></person-group><article-title>The envelope protein encoded by the A33R gene is required for formation of actin-containing microvilli and efficient cell-to-cell spread of vaccinia virus</article-title><source>J Virol</source><year>1998</year><volume>72</volume><fpage>4192</fpage><lpage>4204</lpage><pub-id pub-id-type="pmid">9557708</pub-id></citation></ref><ref id="b29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>R&#x000f6;ttger</surname><given-names>S</given-names></name><name><surname>Frischknecht</surname><given-names>F</given-names></name><name><surname>Reckmann</surname><given-names>I</given-names></name><name><surname>Smith</surname><given-names>GL</given-names></name><name><surname>Way</surname><given-names>M</given-names></name></person-group><article-title>Interactions between vaccinia virus