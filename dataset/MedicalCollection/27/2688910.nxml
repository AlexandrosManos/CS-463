"book"><person-group person-group-type="author"><name><surname>B&#x000f6;sze</surname><given-names>Z</given-names></name><collab>(Ed)</collab></person-group><source>Bioactive Components of Milk</source><year>2008</year><publisher-name>Heidelberg: Springer</publisher-name></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldman</surname><given-names>AS</given-names></name></person-group><article-title>Evolution of the mammary gland defense system and the ontogeny of the immune system</article-title><source>J Mammary Gland Biol Neoplasia</source><year>2002</year><volume>7</volume><fpage>277</fpage><lpage>289</lpage><pub-id pub-id-type="pmid">12751892</pub-id><pub-id pub-id-type="doi">10.1023/A:1022852700266</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tucker</surname><given-names>HA</given-names></name></person-group><article-title>Endocrinology of lactation</article-title><source>Semin Perinatol</source><year>1979</year><volume>3</volume><fpage>199</fpage><lpage>223</lpage><pub-id pub-id-type="pmid">230600</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nicholas</surname><given-names>K</given-names></name><name><surname>Simpson</surname><given-names>K</given-names></name><name><surname>Wilson</surname><given-names>M</given-names></name><name><surname>Trott</surname><given-names>J</given-names></name><name><surname>Shaw</surname><given-names>D</given-names></name></person-group><article-title>The tammar wallaby: a model to study putative autocrine-induced changes in milk composition</article-title><source>J Mammary Gland Biol Neoplasia</source><year>1997</year><volume>2</volume><fpage>299</fpage><lpage>310</lpage><pub-id pub-id-type="pmid">10882313</pub-id><pub-id pub-id-type="doi">10.1023/A:1026392623090</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sharp</surname><given-names>JA</given-names></name><name><surname>Lefevre</surname><given-names>C</given-names></name><name><surname>Nicholas</surname><given-names>KR</given-names></name></person-group><article-title>Lack of functional alpha-lactalbumin prevents involution in Cape fur seals and identifies the protein as an apoptotic milk factor in mammary gland involution</article-title><source>BMC Biol</source><year>2008</year><volume>6</volume><fpage>48</fpage><pub-id pub-id-type="pmid">18986549</pub-id><pub-id pub-id-type="doi">10.1186/1741-7007-6-48</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mikkelsen</surname><given-names>TS</given-names></name><name><surname>Wakefield</surname><given-names>MJ</given-names></name><name><surname>Aken</surname><given-names>B</given-names></name><name><surname>Amemiya</surname><given-names>CT</given-names></name><name><surname>Chang</surname><given-names>JL</given-names></name><name><surname>Duke</surname><given-names>S</given-names></name><name><surname>Garber</surname><given-names>M</given-names></name><name><surname>Gentles</surname><given-names>AJ</given-names></name><name><surname>Goodstadt</surname><given-names>L</given-names></name><name><surname>Heger</surname><given-names>A</given-names></name><name><surname>Jurka</surname><given-names>J</given-names></name><name><surname>Kamal</surname><given-names>M</given-names></name><name><surname>Mauceli</surname><given-names>E</given-names></name><name><surname>Searle</surname><given-names>SM</given-names></name><name><surname>Sharpe</surname><given-names>T</given-names></name><name><surname>Baker</surname><given-names>ML</given-names></name><name><surname>Batzer</surname><given-names>MA</given-names></name><name><surname>Benos</surname><given-names>PV</given-names></name><name><surname>Belov</surname><