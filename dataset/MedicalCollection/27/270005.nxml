en-names>N</given-names></name><name><surname>Thurston</surname><given-names>RJ</given-names></name></person-group><article-title>The effects of methylxanthines on the mobility of stored turkey semen</article-title><source>Poult Sci</source><year>2000</year><volume>79</volume><fpage>1803</fpage><lpage>1809</lpage><pub-id pub-id-type="pmid">11194044</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schlegel</surname><given-names>W</given-names></name><name><surname>Rotermund</surname><given-names>S</given-names></name><name><surname>Farber</surname><given-names>G</given-names></name><name><surname>Nieschlag</surname><given-names>E</given-names></name></person-group><article-title>The influence of prostaglandins on sperm mobility</article-title><source>Prostaglandins</source><year>1981</year><volume>21</volume><fpage>87</fpage><lpage>99</lpage><pub-id pub-id-type="pmid">7208955</pub-id><pub-id pub-id-type="doi">10.1016/0090-6980(81)90199-4</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fayed</surname><given-names>AH</given-names></name></person-group><article-title>Effect of prostaglandin F2 alpha and methylxanthines on enzymic release of bull epididymal spermatozoa in vitro</article-title><source>Contraception</source><year>1996</year><volume>53</volume><fpage>181</fpage><lpage>184</lpage><pub-id pub-id-type="pmid">8689884</pub-id><pub-id pub-id-type="doi">10.1016/0010-7824(96)00008-X</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schaefer</surname><given-names>M.</given-names></name><name><surname>Hofmann</surname><given-names>T</given-names></name><name><surname>Schultz</surname><given-names>G</given-names></name><name><surname>Gudermann</surname><given-names>T</given-names></name></person-group><article-title>A new prostaglan