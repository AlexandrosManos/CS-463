n citation-type="journal"><person-group person-group-type="author"><name><surname>Linacre</surname><given-names>JM</given-names></name></person-group><article-title>Optimizing rating scale category effectiveness</article-title><source>J Appl Meas</source><year>2002</year><volume>3</volume><fpage>85</fpage><lpage>106</lpage><pub-id pub-id-type="pmid">11997586</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wright</surname><given-names>BD</given-names></name><name><surname>Linacre</surname><given-names>M</given-names></name></person-group><article-title>Reasonable Mean-square Fit Values</article-title><source>Rasch Measurement Transactions</source><year>1994</year><volume>8</volume><fpage>3</fpage></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wright</surname><given-names>BD</given-names></name><name><surname>Mok</surname><given-names>M</given-names></name></person-group><article-title>Rasch models overview</article-title><source>J Appl Meas</source><year>2000</year><volume>1</volume><fpage>83</fpage><lpage>106</lpage><pub-id pub-id-type="pmid">12023559</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weiss</surname><given-names>DJ</given-names></name></person-group><article-title>Improvement measurement quality and efficiency with adaptive testing</article-title><source>Applied Psychological Measurement</source><year>1982</year><volume>6</volume><fpage>473</fpage><lpage>492</lpage><pub-id pub-id-type="doi">10.1177/014662168200600408</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weiss</surname><given-names>DJ</given-names></name></person-group><article-title>Adaptive testing by computer</article-title><source>Journal of Consulting and Clinical Psychology</source><year>1985</year><volume>3</volume><fpage>774</fpage><lpage>789</lpage><pub-id pub-id-type="pmid">3841355</pub-id><pub-id pub-id-type="doi">10.1037/0022-006X.53.6.774</pub-id></citation></ref></ref-list></back></article>