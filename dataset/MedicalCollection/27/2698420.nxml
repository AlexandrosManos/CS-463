l"><person-group person-group-type="author"><name><surname>Jia</surname><given-names>H</given-names></name><name><surname>Uphold</surname><given-names>CR</given-names></name><name><surname>Wu</surname><given-names>S</given-names></name><name><surname>Reid</surname><given-names>K</given-names></name><name><surname>Findley</surname><given-names>K</given-names></name><name><surname>Duncan</surname><given-names>PW</given-names></name></person-group><article-title>Health-related quality of life among men with HIV infection: Effects of social support, coping and depression</article-title><source>AIDS Patient Care STDS</source><year>2004</year><volume>18</volume><fpage>594</fpage><lpage>603</lpage><pub-id pub-id-type="pmid">15630787</pub-id></element-citation></ref><ref id="R17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jia</surname><given-names>H</given-names></name><name><surname>Uphold</surname><given-names>CR</given-names></name><name><surname>Zheng</surname><given-names>Y</given-names></name><etal/></person-group><article-title>A further investigation of health-related quality of life over time among men with HIV infection in the HAART era</article-title><source>Qual Life Res</source><year>2007</year><volume>16</volume><fpage>961</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">17468942</pub-id></element-citation></ref><ref id="R18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>C</given-names></name><name><surname>Johnson</surname><given-names>L</given-names></name><name><surname>Ostrow</surname><given-names>D</given-names></name><name><surname>Silvestre</surname><given-names>A</given-names></name><name><surname>Visscher</surname><given-names>B</given-names></name><name><surname>Jacobson</surname><given-names>LP</given-names></name></person-group><article-title>Predictors for lower quality of lif