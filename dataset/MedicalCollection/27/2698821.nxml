id pub-id-type="pmid">12757530</pub-id></mixed-citation></ref><ref id="B27"><mixed-citation publication-type="book"><name><surname>Gigerenzer</surname><given-names>G</given-names></name><source>Reckoning with Risk</source><year>2002</year><publisher-name>London: Penguin</publisher-name></mixed-citation></ref><ref id="B28"><mixed-citation publication-type="journal"><name><surname>Biehl</surname><given-names>M</given-names></name><name><surname>Halpern-Felsher</surname><given-names>BL</given-names></name><article-title>Adolescents' and adults' understanding of probability expressions</article-title><source>Journal of Adolescent Health</source><year>2001</year><volume>28</volume><fpage>30</fpage><lpage>35</lpage><pub-id pub-id-type="doi">10.1016/S1054-139X(00)00176-2</pub-id><pub-id pub-id-type="pmid">11137903</pub-id></mixed-citation></ref><ref id="B29"><mixed-citation publication-type="journal"><name><surname>Gigerenzer</surname><given-names>G</given-names></name><name><surname>Edwards</surname><given-names>A</given-names></name><article-title>Simple tools for understanding risks: from innumeracy to insight</article-title><source>British Medical Journal</source><year>2003</year><volume>327</volume><fpage>741</fpage><lpage>744</lpage><pub-id pub-id-type="pmid">14512488</pub-id><pub-id pub-id-type="doi">10.1136/bmj.327.7417.741</pub-id></mixed-citation></ref><ref id="B30"><mixed-citation publication-type="journal"><name><surname>Lipkus</surname><given-names>IM</given-names></name><name><surname>Hollands</surname><given-names>JG</given-names></name><article-title>The visual communication of risks</article-title><source>Journal Natl Cancer Inst Monogr</source><year>1999</year><volume>25</volume><fpage>149</fpage><lpage>163</lpage></mixed-citation></ref><ref id="B31"><mixed-citation publication-type="journal"><name><surname>Woloshin</surname><given-names>S</given-names></name><name><surname>Schwartz</surname><given-names>LM</given-names></name><article-title>How can we he