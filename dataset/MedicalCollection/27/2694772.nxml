iven-names>PA</given-names></name></person-group><article-title>Surgical Debridement: the Key to Successful Wound Healing and Reconstruction</article-title><source>Clin Podiatr Med Surg</source><year>2000</year><volume>17</volume><fpage>599</fpage><lpage>630</lpage><pub-id pub-id-type="pmid">11070797</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brem</surname><given-names>H</given-names></name><name><surname>Sheehan</surname><given-names>P</given-names></name><name><surname>Rosenberg</surname><given-names>HJ</given-names></name><name><surname>Schneider</surname><given-names>JS</given-names></name><name><surname>Boulton</surname><given-names>AJ</given-names></name></person-group><article-title>Evidence-based protocol for diabetic foot ulcers</article-title><source>Plast Reconstr Surg</source><year>2006</year><volume>117</volume><fpage>193S</fpage><lpage>209S</lpage><comment>discussion 210S&#x02013;211S</comment><pub-id pub-id-type="pmid">16799388</pub-id><pub-id pub-id-type="doi">10.1097/01.prs.0000225459.93750.29</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Falabella</surname><given-names>AF</given-names></name></person-group><article-title>Debridement and wound bed preparation</article-title><source>Dermatol Ther</source><year>2006</year><volume>19</volume><fpage>317</fpage><lpage>325</lpage><pub-id pub-id-type="pmid">17199674</pub-id><pub-id pub-id-type="doi">10.1111/j.1529-8019.2006.00090.x</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Granick</surname><given-names>M</given-names></name><name><surname>Boykin</surname><given-names>J</given-names></name><name><surname>Gamelli</surname><given-names>R</given-names></name><name><surname>Schultz</surname><given-names>G</given-names></name><name><surname>Tenenhaus</surname><given-names>M</given-names></name></person-group><article-title>Toward a common language: surgical wound bed preparation and debridement</article-title><source>Wound Repair Regen</source><year>2006</year><volume>14</volume><fpage>S1</fpage><lpage>10</lpage><pub-id pub-id-type="pmid">16939471</pub-id><pub-id pub-id-type="doi">10.1111/j.1524-475X.2005.00096.x</pub-id></citation></ref><ref id="B8"><citation citation-type="other"><article-title>CDC Guidelines for Environmental Infection Control in Health-Care Facilities</article-title><year>2003</year><fpage>89</fpage><lpage>94</lpage><ext-link ext-link-type="uri" xlink:href="http://www.cdc.gov/ncidod/dhqp/gl_environinfection.html"/></citation></ref></ref-list></back></article>