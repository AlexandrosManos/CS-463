d pub-id-type="pmid">18495056</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rahim</surname><given-names>RT</given-names></name><name><surname>Adler</surname><given-names>MW</given-names></name><name><surname>Meissler</surname><given-names>JJ</given-names><suffix>Jr</suffix></name><name><surname>Cowan</surname><given-names>A</given-names></name><name><surname>Rogers</surname><given-names>TJ</given-names></name><name><surname>Geller</surname><given-names>EB</given-names></name><name><surname>Eisenstein</surname><given-names>TK</given-names></name></person-group><article-title>Abrupt or precipitated withdrawal from morphine induces immunosuppression</article-title><source>J Neuroimmunol</source><year>2002</year><volume>127</volume><fpage>88</fpage><lpage>95</lpage><pub-id pub-id-type="pmid">12044979</pub-id><pub-id pub-id-type="doi">10.1016/S0165-5728(02)00103-0</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Govitrapong</surname><given-names>P</given-names></name><name><surname>Suttitum</surname><given-names>T</given-names></name><name><surname>Kotchabhakdi</surname><given-names>N</given-names></name><name><surname>Uneklabh</surname><given-names>T</given-names></name></person-group><article-title>Alterations of immune functions in heroin addicts and heroin withdrawal subjects</article-title><source>J Pharmacol Exp Ther</source><year>1998</year><volume>286</volume><fpage>883</fpage><lpage>889</lpage><pub-id pub-id-type="pmid">9694946</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Feng</surname><given-names>P</given-names></name><name><surname>Wilson</surname><given-names>QM</given-names></name><name><surname>Meissler</surname><given-names>JJ</given-names><suffix>Jr</suffix></name><name><surname>Adler</surname><given-names>MW</g