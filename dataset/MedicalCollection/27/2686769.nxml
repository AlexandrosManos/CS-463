structured">Morse Z, Nakahara S. English language education in Japanese dental schools. Eur J Dent Educ. 2001;5:168&#x02013;72. <pub-id pub-id-type="pmid">11683894</pub-id></citation></ref><ref id="CR6"><label>6.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nuttall</surname><given-names>M</given-names></name></person-group><article-title>English in Japan</article-title><source>Jpn Railw Transp Rev.</source><year>2000</year><volume>25</volume><fpage>56</fpage></citation><citation citation-type="display-unstructured">Nuttall M. English in Japan. Jpn Railw Transp Rev. 2000;25:56. </citation></ref><ref id="CR7"><label>7.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Choi</surname><given-names>M</given-names></name></person-group><article-title>Korean students in Australian universities: Intercultural issues</article-title><source>High Educ Res Dev.</source><year>1997</year><volume>16</volume><fpage>263</fpage><lpage>282</lpage><pub-id pub-id-type="doi">10.1080/0729436970160302</pub-id></citation><citation citation-type="display-unstructured">Choi M. Korean students in Australian universities: Intercultural issues. High Educ Res Dev. 1997;16:263&#x02013;82. </citation></ref><ref id="CR8"><label>8.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jackson</surname><given-names>FR</given-names></name></person-group><article-title>Seven strategies to support a culturally responsive pedagogy</article-title><source>J Reading.</source><year>1993</year><volume>37</volume><fpage>298</fpage><lpage>303</lpage></citation><citation citation-type="display-unstructured">Jackson FR. Seven strategies to support a culturally responsive pedagogy. J Reading. 1993;37:298&#x02013;303. </citation></ref><ref id="CR9"><label>9.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tierney</surname><given-names>LM</given-names></name></person-group><article-title>An experience in Japanese academic medicine</article-title><source>West J Med.</source><year>1994</year><volume>160</volume><fpage>139</fpage><lpage>145</lpage></citation><citation citation-type="display-unstructured">Tierney LM Jr. An experience in Japanese academic medicine. West J Med. 1994;160:139&#x02013;45. <pub-id pub-id-type="pmid">8160464</pub-id></citation></ref><ref id="CR10"><label>10.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Teo</surname><given-names>AR</given-names></name></person-group><article-title>Misperceptions of medical education in Japan: how reform is changing the landscape</article-title><source>Keio J Med.</source><year>2007</year><volume>56</volume><fpage>61</fpage><lpage>63</lpage><pub-id pub-id-type="doi">10.2302/kjm.56.61</pub-id></citation><citation citation-type="display-unstructured">Teo AR. Misperceptions of medical education in Japan: how reform is changing the landscape. Keio J Med. 2007;56:61&#x02013;3. <pub-id pub-id-type="pmid">17609590</pub-id></citation></ref><ref id="CR11"><label>11.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mulligan</surname><given-names>D</given-names></name><name><surname>Kirkpatrick</surname><given-names>A</given-names></name></person-group><article-title>How much do they understand? Lectures, students and comprehension</article-title><source>High Educ Res Dev.</source><year>2000</year><volume>19</volume><issue>3</issue><fpage>311</fpage><lpage>335</lpage><pub-id pub-id-type="doi">10.1080/758484352</pub-id></citation><citation citation-type="display-unstructured">Mulligan D, Kirkpatrick A. How much do they understand? Lectures, students and comprehension. High Educ Res Dev. 2000;19(3):311&#x02013;335. </citation></ref><ref id="CR12"><label>12.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chur-Hansen</surname><given-names>A</given-names></name></person-group><article-title>Teaching support in the behavioural sciences for non-english speaking background medical undergraduates</article-title><source>Med Educ.</source><year>1999</year><volume>33</volume><fpage>404</fpage><lpage>410</lpage><pub-id pub-id-type="doi">10.1046/j.1365-2923.1999.00335.x</pub-id></citation><citation citation-type="display-unstructured">Chur-Hansen A. Teaching support in the behavioural sciences for non-english speaking background medical undergraduates. Med Educ.1999;33:404&#x02013;10. <pub-id pub-id-type="pmid">10354315</pub-id></citation></ref><ref id="CR13"><label>13.</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Flowerdew</surname><given-names>J</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Flowerdew</surname><given-names>J</given-names></name></person-group><article-title>Research of relevance to second language lecture comprehension&#x02014;an overview</article-title><source>Academic Listening</source><year>1994</year><publisher-loc>Cambridge</publisher-loc><publisher-name>Cambridge University Press</publisher-name><fpage>10</fpage></citation><citation citation-type="display-unstructured">Flowerdew J. Research of relevance to second language lecture comprehension&#x02014;an overview. In: Flowerdew J, ed. Academic Listening. Cambridge: Cambridge University Press; 1994:10. </citation></ref><ref id="CR14"><label>14.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Griffiths</surname><given-names>R</given-names></name></person-group><article-title>Speech rate and NNS comprehension: A preliminary study in time-benefit analysis</article-title><source>Language Learning.</source><year>1990</year><volume>40</volume><fpage>311</fpage><lpage>336</lpage><pub-id pub-id-type="doi">10.1111/j.1467-1770.1990.tb00666.x</pub-id></citation><citation ci