tion citation-type="journal"><person-group person-group-type="author"><name><surname>Rimailho</surname><given-names>A</given-names></name><name><surname>Riou</surname><given-names>B</given-names></name><name><surname>Richard</surname><given-names>C</given-names></name><name><surname>Auzepy</surname><given-names>P</given-names></name></person-group><article-title>Fulminant necrotizing fasciitis and nonsteroidal anti-inflammatory drugs</article-title><source>J Infect Dis</source><year>1987</year><volume>155</volume><fpage>143</fpage><lpage>146</lpage><pub-id pub-id-type="pmid">3540138</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schummer</surname><given-names>W</given-names></name><name><surname>Schummer</surname><given-names>C</given-names></name></person-group><article-title>Nonsteroidal anti-inflammatory drugs and streptococcal toxic shock syndrome</article-title><source>Intensive Care Med</source><year>2002</year><volume>28</volume><fpage>1194</fpage><pub-id pub-id-type="pmid">12400522</pub-id><pub-id pub-id-type="doi">10.1007/s00134-002-1376-5</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Veenstra</surname><given-names>RP</given-names></name><name><surname>Manson</surname><given-names>WE</given-names></name><name><surname>Werf</surname><given-names>TS</given-names></name><name><surname>Fijen</surname><given-names>JW</given-names></name><name><surname>Tulleken</surname><given-names>JE</given-names></name><name><surname>Zijlstru</surname><given-names>JG</given-names></name><name><surname>Ligtenberg</surname><given-names>JJM</given-names></name></person-group><article-title>Fulminant necrotizing fasciitis and nonsteroidal anti-inflammatory drugs</article-title><source>Intensive Care Med</source><year>2001</year><volume>27</volume><fpage>1831</fpage><pub-id pub-id-type="pmid">11810132</pub-id><pub-id pub