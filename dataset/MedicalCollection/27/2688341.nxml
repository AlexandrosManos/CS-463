="1" colspan="1">307.1</th><th align="center" rowspan="1" colspan="1">307.2</th><th align="center" rowspan="1" colspan="1">307.3</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">Control</td><td align="right" rowspan="1" colspan="1">1.0</td><td align="right" rowspan="1" colspan="1">1.0</td><td align="right" rowspan="1" colspan="1">1.0</td><td align="right" rowspan="1" colspan="1">1.0</td><td align="right" rowspan="1" colspan="1">1.0</td></tr><tr><td align="left" rowspan="1" colspan="1">IL-4</td><td align="right" rowspan="1" colspan="1">5.0</td><td align="right" rowspan="1" colspan="1">4.4</td><td align="right" rowspan="1" colspan="1">5.6</td><td align="right" rowspan="1" colspan="1">2.8</td><td align="right" rowspan="1" colspan="1">2.6</td></tr><tr><td align="left" rowspan="1" colspan="1">TGF-&#x003b2;</td><td align="right" rowspan="1" colspan="1">2.7</td><td align="right" rowspan="1" colspan="1">7.7</td><td align="right" rowspan="1" colspan="1">16.3</td><td align="right" rowspan="1" colspan="1">12.8</td><td align="right" rowspan="1" colspan="1">1.0</td></tr><tr><td align="left" rowspan="1" colspan="1">IL-4/TGF-&#x003b2;</td><td align="right" rowspan="1" colspan="1">33.8</td><td align="right" rowspan="1" colspan="1">86.9</td><td align="right" rowspan="1" colspan="1">75.9</td><td align="right" rowspan="1" colspan="1">7.1</td><td align="right" rowspan="1" colspan="1">11.8</td></tr><tr><td align="left" rowspan="1" colspan="1">IL-4/Dex</td><td align="right" rowspan="1" colspan="1">0.6</td><td align="right" rowspan="1" colspan="1">1.2</td><td align="right" rowspan="1" colspan="1">2.5</td><td align="right" rowspan="1" colspan="1">2.2</td><td align="right" rowspan="1" colspan="1">3.5</td></tr><tr><td align="left" rowspan="1" colspan="1">IL-4/Dex/TGF-&#x003b2;</td><td align="right" rowspan="1" colspan="1">2.5</td><td align="right" rowspan="1" colspan="1">6.3</td><td align="right" rowspan="1" colspan="1">16.8</td><td align="right" rowspan="1" colspan="1">6.4</td><td align="right" rowspan="1" colspan="1">3.7</td></tr><tr><td align="left" rowspan="1" colspan="1">Dex/TGF-&#x003b2;</td><td align="right" rowspan="1" colspan="1">0.5</td><td align="right" rowspan="1" colspan="1">0.1</td><td align="right" rowspan="1" colspan="1">0.0</td><td align="right" rowspan="1" colspan="1">0.4</td><td align="right" rowspan="1" colspan="1">0.2</td></tr><tr><td align="left" rowspan="1" colspan="1">IFN&#x003b3;</td><td align="right" rowspan="1" colspan="1">0.8</td><td align="right" rowspan="1" colspan="1">2.5</td><td align="right" rowspan="1" colspan="1">0.6</td><td align="right" rowspan="1" colspan="1">0.1</td><td align="right" rowspan="1" colspan="1">0.4</td></tr><tr><td align="left" rowspan="1" colspan="1">IFN&#x003b3;/TGF-&#x003b2;</td><td align="right" rowspan="1" colspan="1">1.8</td><td align="right" rowspan="1" colspan="1">5.0</td><td align="right" rowspan="1" colspan="1">0.7</td><td align="right" rowspan="1" colspan="1">0.9</td><td align="right" rowspan="1" colspan="1">0.3</td></tr></tbody></table></table-wrap></floats-group></article>