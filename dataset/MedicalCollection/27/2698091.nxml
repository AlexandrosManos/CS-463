cation-type="journal"><person-group person-group-type="author"><name><surname>Dhondt</surname><given-names>A</given-names></name><name><surname>Vanholder</surname><given-names>R</given-names></name><name><surname>Waterloos</surname><given-names>MA</given-names></name><etal/></person-group><article-title>Citrate anticoagulation does not correct cuprophane bioincompatibility as evaluated by the expression of leukocyte surface molecules</article-title><source>Nephrol Dial Transplant</source><year>1998</year><volume>13</volume><fpage>1752</fpage><lpage>1758</lpage><pub-id pub-id-type="pmid">9681723</pub-id></element-citation></ref><ref id="R26"><label>26</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Morath</surname><given-names>C</given-names></name><name><surname>Miftari</surname><given-names>N</given-names></name><name><surname>Dikow</surname><given-names>R</given-names></name><etal/></person-group><article-title>Sodium citrate anticoagulation during sustained low efficiency dialysis (SLED) in patients with acute renal failure and severely impaired liver function</article-title><source>Nephrol Dial Transplant</source><year>2008</year><volume>23</volume><fpage>421</fpage><lpage>422</lpage><pub-id pub-id-type="pmid">17913732</pub-id></element-citation></ref></ref-list></back></article>