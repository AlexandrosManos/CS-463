</ref><ref id="B9"><label>9</label><mixed-citation publication-type="book"><volume>65</volume><year>2000</year><fpage>80865</fpage><lpage>80879</lpage><publisher-loc>Bethesda (MD)</publisher-loc><publisher-name>US Department of Health and Human Services</publisher-name><article-title>The Office of Minority Health. Assuring cultural competence in health care: recommendation for national standards and an outcome-focused research agenda</article-title><source>Federal Register</source></mixed-citation></ref><ref id="B10"><label>10</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Solis</surname><given-names>JN</given-names></name><name><surname>Marks</surname><given-names>G</given-names></name><name><surname>Garcia</surname><given-names>M</given-names></name><name><surname>Shelton</surname><given-names>D</given-names></name></person-group><volume>80</volume><issue>Suppl</issue><year>1990</year><fpage>11</fpage><lpage>19</lpage><article-title>Acculturation access to care, and use of preventive services by Hispanics: findings from the HHANES 1982-1984</article-title><source>Am J Public Health</source><pub-id pub-id-type="pmid">9187576</pub-id></mixed-citation></ref><ref id="B11"><label>11</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Richardson</surname><given-names>JL</given-names></name><name><surname>Marks</surname><given-names>G</given-names></name><name><surname>Solis</surname><given-names>JM</given-names></name><name><surname>Collins</surname><given-names>LM</given-names></name><name><surname>Birba</surname><given-names>L</given-names></name><name><surname>Hisserich</surname><given-names>JC</given-names></name></person-group><year>1987</year><volume>16</volume><fpage>761</fpage><lpage>774</lpage><article-title>Frequency and adequacy of breast cancer screening among elderly Hispanic women</article-title><source>Prev Med</source><pub-id pub-id-type="pmid">3432226</pub-id></mixed-citation></ref><ref id="B12"><label>12</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ismail</surname><given-names>AI</given-names></name><name><surname>Szpunar</surname><given-names>SM</given-names></name></person-group><year>1990</year><volume>50</volume><fpage>24</fpage><lpage>31</lpage><article-title>Oral health status of Mexican Americans with low and high acculturation status: findings from southwestern HHANES, 1982-84</article-title><source>J Public Health Dent</source><pub-id pub-id-type="pmid">2295999</pub-id></mixed-citation></ref><ref id="B13"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ismail</surname><given-names>AI</given-names></name><name><surname>Burt</surname><given-names>BA</given-names></name><name><surname>Brunelle</surname><given-names>JA</given-names></name><name><surname>Szpunar</surname><given-names>SM</given-names></name></person-group><volume>37</volume><issue>SS-3</issue><year>1988</year><fpage>33</fpage><lpage>45</lpage><article-title>Dental caries and periodontal disease among Mexican American children from 5 southwestern states, 1982-1983</article-title><source>Morb Mortal Wkly Rep Surveill Summ</source></mixed-citation></ref><ref id="B14"><label>14</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ismail</surname><given-names>AI</given-names></name><name><surname>Szpunar</surname><given-names>SM</given-names></name></person-group><volume>80</volume><issue>Suppl</issue><year>1990</year><fpage>66</fpage><lpage>70</lpage><article-title>The prevalence of total tooth loss, dental caries, and periodontal disease in Mexican Americans, Cuban Americans, and Puerto Ricans: findings from HHANES 1982-1984</article-title><source>Am J Public Health</source></mixed-citation></ref><ref id="B15"><label>15</label><mixed-citation publication-ty