lign="left">6</td><td align="left">0.05</td></tr><tr><td colspan="5"><hr/></td></tr><tr><td align="left">Menarche age</td><td/><td/><td align="left">938</td><td align="left">82</td></tr><tr><td align="left">&#x02003;&#x02264; 13 years</td><td align="left">1</td><td align="left">0.934</td><td align="left">561</td><td align="left">49</td></tr><tr><td align="left">&#x02003;&#x0003e;13 years</td><td align="left">0.99 (0.75&#x02013;1.30)</td><td/><td align="left">377</td><td align="left">33</td></tr><tr><td colspan="5"><hr/></td></tr><tr><td align="left">History of BC in SDR</td><td/><td/><td align="left">1148</td><td align="left">100</td></tr><tr><td align="left">&#x02003;No</td><td align="left">1</td><td align="left">0.758</td><td align="left">996</td><td align="left">87</td></tr><tr><td align="left">&#x02003;Yes</td><td align="left">0.94 (0.65&#x02013;1.36)</td><td/><td align="left">152</td><td align="left">13</td></tr><tr><td colspan="5"><hr/></td></tr><tr><td align="left">History of BC in FDR</td><td/><td/><td align="left">1148</td><td align="left">100</td></tr><tr><td align="left">&#x02003;No</td><td align="left">1</td><td align="left">0.22</td><td align="left">881</td><td align="left">77</td></tr><tr><td align="left">&#x02003;Yes</td><td align="left">0.83 (0.62&#x02013;1.11)</td><td/><td align="left">267</td><td align="left">23</td></tr><tr><td colspan="5"><hr/></td></tr><tr><td align="left">Duration of breast feeding</td><td/><td/><td align="left">205</td><td align="left">18</td></tr><tr><td align="left">&#x02003;&#x02264; 3 years</td><td align="left">1</td><td align="left">0.175</td><td align="left">78</td><td align="left">7</td></tr><tr><td align="left">&#x02003;4&#x02013;6 years</td><td align="left">2.03 (0.96&#x02013;4.29)</td><td/><td align="left">68</td><td align="left">6</td></tr><tr><td align="left">&#x02003;&#x0003e;6 years</td><td align="left">1.62 (0.71&#x02013;3.69)</td><td/><td align="left">59</td><td align="left">5</td></tr></tbody></table><table-wr