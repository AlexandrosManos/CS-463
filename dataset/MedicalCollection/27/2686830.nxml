hem 262:3118&#x02013;3122 <pub-id pub-id-type="pmid">2950094</pub-id></citation></ref><ref id="CR6"><label>6.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Steinberg</surname><given-names>TH</given-names></name><name><surname>Newman</surname><given-names>AS</given-names></name><name><surname>Swanson</surname><given-names>JA</given-names></name><name><surname>Silverstein</surname><given-names>SC</given-names></name></person-group><article-title>ATP<sup>4&#x02212;</sup> permeabilizes the plasma membrane of mouse macrophages to fluorescent dyes</article-title><source>J Biol Chem</source><year>1987</year><volume>262</volume><fpage>8884</fpage><lpage>8888</lpage></citation><citation citation-type="display-unstructured">Steinberg TH, Newman AS, Swanson JA, Silverstein SC (1987) ATP4&#x02212; permeabilizes the plasma membrane of mouse macrophages to fluorescent dyes. J Biol Chem 262:8884&#x02013;8888 <pub-id pub-id-type="pmid">3597398</pub-id></citation></ref><ref id="CR7"><label>7.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Greenberg</surname><given-names>S</given-names></name><name><surname>Virgilio</surname><given-names>F</given-names></name><name><surname>Steinberg</surname><given-names>TH</given-names></name><name><surname>Silverstein</surname><given-names>SC</given-names></name></person-group><article-title>Extracellular nucleotides mediate Ca<sup>2+</sup> fluxes in J774 macrophages by two distinct mechanisms</article-title><source>J Biol Chem</source><year>1988</year><volume>263</volume><fpage>10337</fpage><lpage>10343</lpage></citation><citation citation-type="display-unstructured">Greenberg S, Di Virgilio F, Steinberg TH, Silverstein SC (1988) Extracellular nucleotides mediate Ca2+ fluxes in J774 macrophages by two distinct mechanisms. J Biol Chem 263:10337&#x02013;10343 <pub-id pub-id-type="pmid">3392016</pub-id></citation></ref><ref id="CR8"><label>8.</label>