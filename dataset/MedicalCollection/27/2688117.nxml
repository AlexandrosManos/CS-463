<name><surname>Hermans</surname><given-names>G</given-names></name><name><surname>De Jonghe</surname><given-names>B</given-names></name><name><surname>Bruyninckx</surname><given-names>F</given-names></name><name><surname>Van den Berghe</surname><given-names>G</given-names></name></person-group><article-title>Interventions for preventing critical illness polyneuropathy and critical illness myopathy</article-title><source>Cochrane Database Syst Rev</source><year>2009</year><fpage>CD006832</fpage><pub-id pub-id-type="pmid">19160304</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>de Letter</surname><given-names>MA</given-names></name><name><surname>Schmitz</surname><given-names>PI</given-names></name><name><surname>Visser</surname><given-names>LH</given-names></name><name><surname>Verheul</surname><given-names>FA</given-names></name><name><surname>Schellens</surname><given-names>RL</given-names></name><name><surname>Op de Coul</surname><given-names>DA</given-names></name><name><surname>Meche</surname><given-names>FG van der</given-names></name></person-group><article-title>Risk factors for the development of polyneuropathy and myopathy in critically ill patients</article-title><source>Crit Care Med</source><year>2001</year><volume>29</volume><fpage>2281</fpage><lpage>2286</lpage><pub-id pub-id-type="pmid">11801825</pub-id><pub-id pub-id-type="doi">10.1097/00003246-200112000-00008</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Jonghe</surname><given-names>B</given-names></name><name><surname>Sharshar</surname><given-names>T</given-names></name><name><surname>Lefaucheur</surname><given-names>JP</given-names></name><name><surname>Authier</surname><given-names>FJ</given-names></name><name><surname>Durand-Zaleski</surname><given-names>I</given-names></name><name><surname>Boussarsar</surname><given-names>M</given