"><name><surname>Ergonul</surname><given-names>O</given-names></name><name><surname>Whitehouse</surname><given-names>CA</given-names></name><person-group person-group-type="editor">Ergonul O, Whitehouse CA</person-group><article-title>Future Research</article-title><source>Crimean-Congo Hemorrhagic Fever: A Global Perspective</source><year>2007</year><publisher-name>Dordrecht (NL): Springer</publisher-name><fpage>307</fpage><lpage>308</lpage></mixed-citation></ref></ref-list></back></article>