n-group-type="author"><name><surname>Swanson</surname><given-names>J</given-names></name><name><surname>Volkow</surname><given-names>N</given-names></name></person-group><year>2002</year><article-title>Pharmacokinetic and pharmacodynamic properties of stimulants: implications for the design of new treatments for ADHD.</article-title><source>Behav Brain Res</source><volume>130</volume><fpage>73</fpage><lpage>78</lpage><pub-id pub-id-type="pmid">11864720</pub-id></mixed-citation></ref><ref id="pone.0006102-Volkow1"><label>15</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Volkow</surname><given-names>N</given-names></name><name><surname>Wang</surname><given-names>G</given-names></name><name><surname>Newcorn</surname><given-names>J</given-names></name><name><surname>Fowler</surname><given-names>J</given-names></name><name><surname>Telang</surname><given-names>F</given-names></name><etal/></person-group><year>2007</year><article-title>Brain dopamine transporter levels in treatment and drug na&#x000ef;ve adults with ADHD.</article-title><source>Neuroimage</source><volume>34</volume><fpage>1182</fpage><lpage>1190</lpage><pub-id pub-id-type="pmid">17126039</pub-id></mixed-citation></ref><ref id="pone.0006102-Gainetdinov1"><label>16</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gainetdinov</surname><given-names>R</given-names></name><name><surname>Jones</surname><given-names>S</given-names></name><name><surname>Caron</surname><given-names>M</given-names></name></person-group><year>1999</year><article-title>Functional hyperdopaminergia in dopamine transporter knock-out mice.</article-title><source>Biol Psychiatry</source><volume>46</volume><fpage>303</fpage><lpage>311</lpage><pub-id pub-id-type="pmid">10435196</pub-id></mixed-citation></ref><ref id="pone.0006102-Volkow2"><label>17</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Volkow</surname><given-names>N</given-names></name><name><surname>Fowler</surname><given-names>J</given-names></name><name><surname>Wang</surname><given-names>G</given-names></name><name><surname>Telang</surname><given-names>F</given-names></name><name><surname>Logan</surname><given-names>J</given-names></name><etal/></person-group><year>2008</year><article-title>Methylphenidate decreased the amount of glucose needed by the brain to perform a cognitive task.</article-title><source>PLoS ONE</source><volume>3</volume><fpage>e2017</fpage><pub-id pub-id-type="pmid">18414677</pub-id></mixed-citation></ref><ref id="pone.0006102-Tomasi1"><label>18</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Tomasi</surname><given-names>D</given-names></name><name><surname>Ernst</surname><given-names>T</given-names></name><name><surname>Caparelli</surname><given-names>EC</given-names></name><name><surname>Chang</surname><given-names>L</given-names></name></person-group><year>2004</year><article-title>Practice-induced changes of brain function during visual attention: A parametric fMRI study at 4 Tesla.</article-title><source>NeuroImage</source><volume>23</volume><fpage>1414</fpage><lpage>1421</lpage><pub-id pub-id-type="pmid">15589105</pub-id></mixed-citation></ref><ref id="pone.0006102-Salahpour1"><label>19</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Salahpour</surname><given-names>A</given-names></name><name><surname>Ramsey</surname><given-names>A</given-names></name><name><surname>Medvedev</surname><given-names>I</given-names></name><name><surname>Kile</surname><given-names>B</given-names></name><name><surname>Sotnikova</surname><given-names>T</given-names></name><etal/></person-group><year>2008</year><article-title>Increased amphetamine-induced hyperactivity and reward in mice overexpressing the dopamine transporter.</article-title><sourc