d="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wolfowicz</surname><given-names>CB</given-names></name><name><surname>HuangFu</surname><given-names>T</given-names></name><name><surname>Chua</surname><given-names>KY</given-names></name></person-group><article-title>Expression and immunogenicity of the major house dust mite allergen Der p 1 following DNA immunization</article-title><source>Vaccine</source><year>2003</year><volume>21</volume><fpage>1195</fpage><lpage>1204</lpage><pub-id pub-id-type="pmid">12559798</pub-id></element-citation></ref><ref id="B16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Tanaka</surname><given-names>H</given-names></name><name><surname>Masuda</surname><given-names>T</given-names></name><name><surname>Tokuoka</surname><given-names>S</given-names></name><name><surname>Komai</surname><given-names>M</given-names></name><name><surname>Nagao</surname><given-names>K</given-names></name><name><surname>Takahashi</surname><given-names>Y</given-names></name><name><surname>Nagai</surname><given-names>H</given-names></name></person-group><article-title>The effect of allergen-induced airway inflammation on airway remodeling in a murine model of allergic asthma</article-title><source>Inflamm Res</source><year>2001</year><volume>50</volume><fpage>616</fpage><lpage>624</lpage><pub-id pub-id-type="pmid">11822788</pub-id></element-citation></ref><ref id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ellis</surname><given-names>R</given-names></name><name><surname>Leigh</surname><given-names>R</given-names></name><name><surname>Southam</surname><given-names>D</given-names></name><name><surname>O'Byrne</surname><given-names>PM</given-names></name><name><surname>Inman</surname><given-names>MD</given-names></name></person-group><artic