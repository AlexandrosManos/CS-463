rson-group-type="author"><name><surname>Reynen</surname><given-names>K</given-names></name></person-group><article-title>Cardiac myxomas</article-title><source>N Engl J Med</source><year>1995</year><volume>333</volume><fpage>1610</fpage><lpage>1617</lpage><pub-id pub-id-type="pmid">7477198</pub-id></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Basso</surname><given-names>C</given-names></name><name><surname>Valente</surname><given-names>M</given-names></name><name><surname>Poletti</surname><given-names>A</given-names></name><name><surname>Casarotto</surname><given-names>D</given-names></name><name><surname>Thiene</surname><given-names>G</given-names></name></person-group><article-title>Surgical pathology of primary cardiac and pericardial tumors</article-title><source>Eur J Cardiothorac Surg</source><year>1997</year><volume>12</volume><fpage>730</fpage><lpage>738</lpage><pub-id pub-id-type="pmid">9458144</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ha</surname><given-names>JW</given-names></name><name><surname>Kang</surname><given-names>WC</given-names></name><name><surname>Chung</surname><given-names>N</given-names></name><name><surname>Chang</surname><given-names>BC</given-names></name><name><surname>Rim</surname><given-names>SJ</given-names></name><name><surname>Kwon</surname><given-names>JW</given-names></name><etal/></person-group><article-title>Echocardiographic and morphologic characteristics of left atrial myxoma and their relation to systemic embolism</article-title><source>Am J Cardiol</source><year>1999</year><volume>83</volume><fpage>1579</fpage><lpage>1582</lpage><pub-id pub-id-type="pmid">10363879</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kosuga</surname><given-names>T</given-names></name><name><surname>Fukunaga</surname><given-names>S</given-names></name><name><surname>Kawara</surname><given-names>T</given-names></name><name><surname>Yokose</surname><given-names>S</given-names></name><name><surname>Akasu</surname><given-names>K</given-names></name><name><surname>Tayama</surname><given-names>E</given-names></name><etal/></person-group><article-title>Surgery for primary cardiac tumors. Clinical experience and surgical results in 60 patients</article-title><source>J Cardiovasc Surg</source><year>2002</year><volume>43</volume><fpage>581</fpage><lpage>587</lpage><pub-id pub-id-type="pmid">12386567</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Centofanti</surname><given-names>P</given-names></name><name><surname>Di Rosa</surname><given-names>E</given-names></name><name><surname>Deorsola</surname><given-names>L</given-names></name><name><surname>Dato</surname><given-names>GM</given-names></name><name><surname>Patane</surname><given-names>F</given-names></name><name><surname>La Torre</surname><given-names>M</given-names></name><etal/></person-group><article-title>Primary cardiac tumors: early and late results of surgical treatment in 91 patients</article-title><source>Ann Thorac Surg</source><year>1999</year><volume>68</volume><fpage>1236</fpage><lpage>1241</lpage><pub-id pub-id-type="pmid">10543485</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jones</surname><given-names>DR</given-names></name><name><surname>Warden</surname><given-names>HE</given-names></name><name><surname>Murray</surname><given-names>GF</given-names></name><name><surname>Hill</surname><given-names>RC</given-names></name><name><surname>Graeber</surname><given-names>GM</given-names></name><name><surname>Cruzzavala</surname><given-names>JL</given-names></name><etal/></person-group><article-title>Biatrial approach to cardiac myxomas: a 30-year clinical experience</article-title><source>Ann Thorac Surg</source><year>1995</year><volume>59</volume><fpage>851</fpage><lpage>856</lpage><pub-id pub-id-type="pmid">7695408</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Keeling</surname><given-names>IM</given-names></name><name><surname>Oberwalder</surname><given-names>P</given-names></name><name><surname>Anelli-Monti</surname><given-names>M</given-names></name><name><surname>Schuchlenz</surname><given-names>H</given-names></name><name><surname>Demel</surname><given-names>U</given-names></name><name><surname>Tilz</surname><given-names>GP</given-names></name><etal/></person-group><article-title>Cardiac myxomas: 24 years of experience in 49 patients</article-title><source>Eur J Cardiothorac Surg</source><year>2002</year><volume>22</volume><fpage>971</fpage><lpage>977</lpage><pub-id pub-id-type="pmid">12467822</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gawdzinski</surname><given-names>MP</given-names></name><name><surname>Sypula</surname><given-names>S</given-names></name></person-group><article-title>The long term results of treatment of heart myxomas with special attention to very rare myxoma of the right ventricle</article-title><source>J Cardiovasc Surg</source><year>1996</year><volume>37</volume><fpage>121</fpage><lpage>129</lpage><pub-id pub-id-type="pmid">10064364</pub-id></element-citation></ref></ref-list></back><floats-group><table-wrap id="T1" position="float"><label>Table 1</label><caption><p>Clinical Features</p></caption><graphic xlink:href="ymj-47-367-i001"/><table-wrap-foot><fn><p>LA, left atrial; RA, right atrial; RV, right ventricular; LIPV, left inferior pulmonary vein; MV, mitral valve.</p></fn></table-wrap-foot></table-wrap><table-wrap id="T2" position="float"><label>Table 2</label><caption><p>Operation Methods</p></caption><graphic xlink:href="ymj-47-367-i002"/><table-wrap-foot><fn><p>MV, mitral valve; CABG, coronary artery bypass graft; AVR, aortic valve replacement; VSD, ventricular septal defect; TV, tricuspid valve.</p></fn></table-wrap-foot></table-wrap><table-wrap id="T3" position="float"><label>Table 3</label><caption><p>Surgical Results</p></caption><graphic xlink:href="ymj-47-367-i003"/></table-wrap></floats-group></article>