>2004</year><volume>25</volume><fpage>S232</fpage><lpage>233</lpage><pub-id pub-id-type="pmid">15549544</pub-id></element-citation></ref><ref id="R28"><label>28</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Anonymous</surname><given-names/></name></person-group><source>A guide to the development of children&#x02019;s palliative care services. Published jointly by Association for Children with Life-threatening or Terminal Conditions and their Families, and Royal College of Paediatrics and Child Health</source><year>1997</year></element-citation></ref><ref id="R29"><label>29</label><element-citation publication-type="journal"><collab>American academy of Pediatrics and Canadian Paediatric society</collab><article-title>Prevention and Management of pain and stress in neonate</article-title><source>Pediatrics</source><year>2000</year><volume>105</volume><fpage>454</fpage><lpage>461</lpage><pub-id pub-id-type="pmid">10654977</pub-id></element-citation></ref><ref id="R30"><label>30</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chiswick</surname><given-names>ML</given-names></name></person-group><article-title>Assessment of pain in neonates</article-title><source>Lancet</source><year>2000</year><volume>355</volume><fpage>6</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">10615882</pub-id></element-citation></ref><ref id="R31"><label>31</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mathew</surname><given-names>PJ</given-names></name><name><surname>Mathew</surname><given-names>JL</given-names></name></person-group><article-title>Assessment and management of pain in infants</article-title><source>Postgrad. Med. J</source><year>2003</year><volume>79</volume><fpage>438</fpage><lpage>443</lpage><pub-id pub-id-type="pmid">12954954</pub-id></element-citation></ref><ref id="R32"><label>32</label><eleme