oup person-group-type="author"><name><surname>Umpierrez</surname><given-names>GE</given-names></name><name><surname>Kelly</surname><given-names>JP</given-names></name><name><surname>Navarrete</surname><given-names>JE</given-names></name><name><surname>Casals</surname><given-names>MM</given-names></name><name><surname>Kitabchi</surname><given-names>AE</given-names></name></person-group><article-title>Hyperglycemic crises in urban blacks</article-title>.<source>Arch Intern Med</source><year>1997</year>;<volume>157</volume>:<fpage>669</fpage>&#x02013;<lpage>675</lpage><pub-id pub-id-type="pmid">9080921</pub-id></mixed-citation></ref><ref id="B10"><label>10</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ennis</surname><given-names>ED</given-names></name><name><surname>Stahl</surname><given-names>EJVB</given-names></name><name><surname>Kreisberg</surname><given-names>RA</given-names></name></person-group><article-title>The hyperosmolar hyperglycemic syndrome</article-title>.<source>Diabetes Rev</source><year>1994</year>;<volume>2</volume>:<fpage>115</fpage>&#x02013;<lpage>126</lpage></mixed-citation></ref><ref id="B11"><label>11</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lorber</surname><given-names>D</given-names></name></person-group><article-title>Nonketotic hypertonicity in diabetes mellitus</article-title>.<source>Med Clin North Am</source><year>1995</year>;<volume>79</volume>:<fpage>39</fpage>&#x02013;<lpage>52</lpage><pub-id pub-id-type="pmid">7808094</pub-id></mixed-citation></ref><ref id="B12"><label>12</label><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Kitabchi</surname><given-names>AE</given-names></name><name><surname>Fisher</surname><given-names>JN</given-names></name><name><surname>Murphy</surname><given-names>MB</given-names></name><name><surname>Rumbak</surname><given-names>MJ</given-names></name></person-group><article-title>Diabetic ketoacidosis and the hyperglycemic hyperosmolar nonketotic state</article-title>. In<source><italic>Joslin's Diabetes Mellitus</italic></source><edition>13th ed</edition><person-group person-group-type="editor"><name><surname>Kahn</surname><given-names>CR</given-names></name><name><surname>Weir</surname><given-names>GC</given-names></name></person-group> Eds.<publisher-loc>Philadelphia</publisher-loc>,<publisher-name>Lea &#x00026; Febiger</publisher-name>,<year>1994</year>, p.<fpage>738</fpage>&#x02013;<lpage>770</lpage></mixed-citation></ref><ref id="B13"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kitabchi</surname><given-names>AE</given-names></name><name><surname>Umpierrez</surname><given-names>GE</given-names></name><name><surname>Murphy</surname><given-names>MB</given-names></name><name><surname>Kreisberg</surname><given-names>RA</given-names></name></person-group><article-title>Hyperglycemic crises in adult patients with diabetes</article-title>.<source>Diabetes Care</source><year>2006</year>;<volume>29</volume>:<fpage>2739</fpage>&#x02013;<lpage>2748</lpage><pub-id pub-id-type="pmid">17130218</pub-id></mixed-citation></ref><ref id="B14"><label>14</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>DeFronzo</surname><given-names>RA</given-names></name><name><surname>Matzuda</surname><given-names>M</given-names></name><name><surname>Barret</surname><given-names>E</given-names></name></person-group><article-title>Diabetic ketoacidosis: a combined metabolic-nephrologic approach to therapy</article-title>.<source>Diabetes Rev</source><year>1994</year>;<volume>2</volume>:<fpage>209</fpage>&#x02013;<lpage>238</lpage></mixed-citation></ref><ref id="B15"><label>15</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Luzi</surname><given-nam