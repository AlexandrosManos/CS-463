.CCR-05-0177</pub-id><pub-id pub-id-type="pmid">16203795</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><name><surname>Veltman</surname><given-names>JA</given-names></name><name><surname>Fridlyand</surname><given-names>J</given-names></name><name><surname>Pejavar</surname><given-names>S</given-names></name><name><surname>Olshen</surname><given-names>AB</given-names></name><name><surname>Korkola</surname><given-names>JE</given-names></name><name><surname>DeVries</surname><given-names>S</given-names></name><article-title>Array-based comparative genomic hybridization for genome-wide screening of DNA copy number in bladder tumors</article-title><source>Cancer Res</source><year>2003</year><volume>63</volume><fpage>2872</fpage><lpage>2880</lpage><pub-id pub-id-type="pmid">12782593</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Hurst</surname><given-names>CD</given-names></name><name><surname>Fiegler</surname><given-names>H</given-names></name><name><surname>Carr</surname><given-names>P</given-names></name><name><surname>Williams</surname><given-names>S</given-names></name><name><surname>Carter</surname><given-names>NP</given-names></name><name><surname>Knowles</surname><given-names>MA</given-names></name><article-title>High-resolution analysis of genomic copy number alterations in bladder cancer by microarray-based comparative genomic hybridization</article-title><source>Oncogene</source><year>2004</year><volume>23</volume><fpage>2250</fpage><lpage>2263</lpage><pub-id pub-id-type="doi">10.1038/sj.onc.1207260</pub-id><pub-id pub-id-type="pmid">14968109</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Zhao</surname><given-names>X</given-names></name><name><surname>Li</surname><given-names>C</given-names></name><name><surname>Paez</surname><given-names>JG</given-names></name><name><surname>Chin</surname><given-names>K</given-n