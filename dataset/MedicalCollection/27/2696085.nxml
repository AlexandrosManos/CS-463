-id pub-id-type="pmid">15708128</pub-id></citation></ref><ref id="pone.0005971-Blois1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blois</surname><given-names>SM</given-names></name><name><surname>Kammerer</surname><given-names>U</given-names></name><name><surname>Alba Soto</surname><given-names>C</given-names></name><name><surname>Tometten</surname><given-names>MC</given-names></name><name><surname>Shaikly</surname><given-names>V</given-names></name><etal/></person-group><year>2007</year><article-title>Dendritic Cells: Key to Fetal Tolerance?</article-title><source>Biol Reprod</source></citation></ref><ref id="pone.0005971-Laskarin1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Laskarin</surname><given-names>G</given-names></name><name><surname>Redzovic</surname><given-names>A</given-names></name><name><surname>Rubesa</surname><given-names>Z</given-names></name><name><surname>Mantovani</surname><given-names>A</given-names></name><name><surname>Allavena</surname><given-names>P</given-names></name><etal/></person-group><year>2008</year><article-title>Decidual natural killer cell tuning by autologous dendritic cells.</article-title><source>Am J Reprod Immunol</source><volume>59</volume><fpage>433</fpage><lpage>445</lpage><pub-id pub-id-type="pmid">18405314</pub-id></citation></ref><ref id="pone.0005971-Aluvihare1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Aluvihare</surname><given-names>VR</given-names></name><name><surname>Kallikourdis</surname><given-names>M</given-names></name><name><surname>Betz</surname><given-names>AG</given-names></name></person-group><year>2004</year><article-title>Regulatory T cells mediate maternal tolerance to the fetus.</article-title><source>Nat Immunol</source><volume>5</volume><fpage>266</fpage><lpage>271</lpage><pub-id pub-id-type="pmid">14758358</p