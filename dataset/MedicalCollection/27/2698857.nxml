ype="journal"><person-group person-group-type="author"><name><surname>Molina</surname><given-names>JC</given-names></name><name><surname>Chotro</surname><given-names>MG</given-names></name><name><surname>Spear</surname><given-names>NE</given-names></name></person-group><article-title>Early (preweanling) recognition of alcohol's orosensory cues resulting from acute ethanol intoxication</article-title><source>Behav Neural Biol</source><year>1989</year><volume>51</volume><fpage>307</fpage><lpage>25</lpage><pub-id pub-id-type="pmid">2730496</pub-id><pub-id pub-id-type="doi">10.1016/S0163-1047(89)90961-8</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hunt</surname><given-names>PS</given-names></name><name><surname>Molina</surname><given-names>JC</given-names></name><name><surname>Rajachandran</surname><given-names>L</given-names></name><name><surname>Spear</surname><given-names>LP</given-names></name><name><surname>Spear</surname><given-names>NE</given-names></name></person-group><article-title>Chronic administration of alcohol in the developing rat: expression of functional tolerance and alcohol olfactory aversions</article-title><source>Behav Neural Biol</source><year>1993</year><volume>59</volume><fpage>87</fpage><lpage>99</lpage><pub-id pub-id-type="pmid">8476387</pub-id><pub-id pub-id-type="doi">10.1016/0163-1047(93)90795-J</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Varlinskaya</surname><given-names>EI</given-names></name><name><surname>Spear</surname><given-names>LP</given-names></name><name><surname>Spear</surname><given-names>NE</given-names></name></person-group><article-title>Acute effects of ethanol on behavior of adolescent rats: Role of social context</article-title><source>Alcohol Clin Exp Res</source><year>2001</year><volume>25</volume><fpage>377</fpage><lpage>385</lpage><pub-id pub-id-type="pmid">11290848</pub-id><pub-id pub-id-type="doi">10.1111/j.1530-0277.2001.tb02224.x</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Youngentob</surname><given-names>SL</given-names></name></person-group><article-title>A method for the rapid automated assessment of olfactory function</article-title><source>Chem Senses</source><year>2005</year><volume>30</volume><fpage>219</fpage><lpage>229</lpage><pub-id pub-id-type="pmid">15741600</pub-id><pub-id pub-id-type="doi">10.1093/chemse/bji017</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Youngentob</surname><given-names>SL</given-names></name><name><surname>Kent</surname><given-names>PF</given-names></name><name><surname>Sheehe</surname><given-names>PR</given-names></name><name><surname>Molina</surname><given-names>JC</given-names></name><name><surname>Spear</surname><given-names>NE</given-names></name><name><surname>Youngentob</surname><given-names>LM</given-names></name></person-group><article-title>Experience-induced fetal plasticity: The effect of gestational ethanol exposure on the behavioral and neurophysiologic olfactory response to ethanol odor in early postnatal and adult rats</article-title><source>Behav Neurosc</source><year>2007</year><volume>121</volume><fpage>1293</fpage><lpage>1305</lpage><pub-id pub-id-type="doi">10.1037/0735-7044.121.6.1293</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Youngentob</surname><given-names>SL</given-names></name><name><surname>Glendinning</surname><given-names>JI</given-names></name></person-group><article-title>Fetal ethanol exposure increases ethanol intake by making it smell and taste better</article-title><source>Proc Natl Acad Sci USA</source><year>2009</year><volume>106</volume><fpage>5359</fpage><lpage>5364</lpage><pub-id pub-i