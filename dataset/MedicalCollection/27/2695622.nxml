from blood to brain</article-title><source>J Neurochem</source><year>1981</year><volume>36</volume><fpage>1463</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">7264642</pub-id></citation></ref><ref id="R18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Patlak</surname><given-names>CS</given-names></name><name><surname>Blasberg</surname><given-names>RG</given-names></name></person-group><article-title>Graphical evaluation of blood-to-brain transfer constants from multiple-time uptake data. Generalizations</article-title><source>J Cereb Blood Flow Meta</source><year>1985</year><volume>5</volume><fpage>584</fpage><lpage>90</lpage></citation></ref><ref id="R19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Raichle</surname><given-names>ME</given-names></name><name><surname>Martin</surname><given-names>WR</given-names></name><name><surname>Herscovitch</surname><given-names>P</given-names></name><name><surname>Mintun</surname><given-names>MA</given-names></name><name><surname>Markham</surname><given-names>J</given-names></name></person-group><article-title>Brain blood flow measured with intravenous H<sub>2</sub><sup>15</sup>O.II. Implementation and validation</article-title><source>J Nucl Med</source><year>1983</year><volume>24</volume><fpage>790</fpage><lpage>978</lpage><pub-id pub-id-type="pmid">6604140</pub-id></citation></ref><ref id="R20"><label>20</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Beck</surname><given-names>JV</given-names></name><name><surname>Arnold</surname><given-names>KJ</given-names></name></person-group><source>Parameter estimation in Engineering and Science</source><year>1977</year><publisher-loc> New York</publisher-loc><publisher-name>John Wiley and Sons</publisher-name></citation></ref><ref id="R21"><label>21</label><citation citation-type="journal"><person-group person-grou