cle-title><source>Arch Oral Biol</source><year>2001</year><volume>46</volume><fpage>955</fpage><lpage>962</lpage><pub-id pub-id-type="pmid">11451410</pub-id></element-citation></ref><ref id="B19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Zeng</surname><given-names>W</given-names></name><name><surname>Lee</surname><given-names>MG</given-names></name><name><surname>Yan</surname><given-names>M</given-names></name><name><surname>Diaz</surname><given-names>J</given-names></name><name><surname>Benzamin</surname><given-names>I</given-names></name><name><surname>Marino</surname><given-names>CR</given-names></name><etal/></person-group><article-title>Immuno and functional characterization of CFTR in submandibular and pancreatic acinar and duct cells</article-title><source>Am J Physiol</source><year>1997</year><volume>273</volume><fpage>C442</fpage><lpage>C455</lpage><pub-id pub-id-type="pmid">9277342</pub-id></element-citation></ref><ref id="B20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Xu</surname><given-names>X</given-names></name><name><surname>Diaz</surname><given-names>J</given-names></name><name><surname>Zhao</surname><given-names>H</given-names></name><name><surname>Muallem</surname><given-names>S</given-names></name></person-group><article-title>Chacterization, localization and axial distribution of calcium signaling receptors in the rat submandibular salivary glands ducts</article-title><source>J Physiol (Lond)</source><year>1996</year><volume>491</volume><fpage>647</fpage><lpage>662</lpage><pub-id pub-id-type="pmid">8815200</pub-id></element-citation></ref><ref id="B21"><label>21</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hong</surname><given-names>JH</given-names></name><name><surname>Lee</surname><given-names>SI</given-names></name><name><surname>Kim</surname><given-names>KE</given-names></name><name><surname>Yong</surname><given-names>TS</given-names></name><name><surname>Seo</surname><given-names>JT</given-names></name><name><surname>Sohn</surname><given-names>MH</given-names></name><etal/></person-group><article-title>German cockroach extract activates protease-activated receptor 2 in human airway epithelial cells</article-title><source>J Allergy Clin Immunol</source><year>2004</year><volume>113</volume><fpage>315</fpage><lpage>319</lpage><pub-id pub-id-type="pmid">14767448</pub-id></element-citation></ref><ref id="B22"><label>22</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bernfeld</surname><given-names>P</given-names></name></person-group><article-title>Enzymes of starch degradation and synthesis</article-title><source>Adv Enzymol Relat Subj Biochem</source><year>1951</year><volume>12</volume><fpage>379</fpage><lpage>428</lpage><pub-id pub-id-type="pmid">14885023</pub-id></element-citation></ref><ref id="B23"><label>23</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>C</given-names></name><name><surname>Ullrich</surname><given-names>B</given-names></name><name><surname>Zhang</surname><given-names>JZ</given-names></name><name><surname>Anderson</surname><given-names>RG</given-names></name><name><surname>Brose</surname><given-names>N</given-names></name><name><surname>Sudhof</surname><given-names>TC</given-names></name><etal/></person-group><article-title>Calcium dependent and independent activities of neural and non-neural synaptotagmin</article-title><source>Nature</source><year>1995</year><volume>375</volume><fpage>594</fpage><lpage>599</lpage><pub-id pub-id-type="pmid">7791877</pub-id></element-citation></ref><ref id="B24"><label>24</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Saegusa</surname><giv