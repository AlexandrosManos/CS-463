id pub-id-type="pmid">16020728</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Das</surname><given-names>A</given-names></name><name><surname>Banday</surname><given-names>M</given-names></name><name><surname>Bellofatto</surname><given-names>V</given-names></name></person-group><article-title>RNA polymerase transcription machinery in trypanosomes</article-title><source>Eukaryot. Cell</source><year>2008</year><volume>7</volume><fpage>429</fpage><lpage>434</lpage><pub-id pub-id-type="pmid">17951525</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gilinger</surname><given-names>G</given-names></name><name><surname>Bellofatto</surname><given-names>V</given-names></name></person-group><article-title>Trypanosome spliced leader RNA genes contain the first identified RNA polymerase II gene promoter in these organisms</article-title><source>Nucleic Acids Res.</source><year>2001</year><volume>29</volume><fpage>1556</fpage><lpage>1564</lpage><pub-id pub-id-type="pmid">11266558</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>G&#x000fc;nzl</surname><given-names>A</given-names></name><name><surname>Ullu</surname><given-names>E</given-names></name><name><surname>D&#x000f6;rner</surname><given-names>M</given-names></name><name><surname>Fragoso</surname><given-names>SP</given-names></name><name><surname>Hoffmann</surname><given-names>KF</given-names></name><name><surname>Milner</surname><given-names>JD</given-names></name><name><surname>Morita</surname><given-names>Y</given-names></name><name><surname>Nguu</surname><given-names>EK</given-names></name><name><surname>Vanacova</surname><given-names>S</given-names></name><name><surname>W&#x000fc;ns