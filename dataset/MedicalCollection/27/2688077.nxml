rs.</article-title><source>Int J Health Serv</source><volume>26</volume><fpage>569</fpage><lpage>589</lpage><pub-id pub-id-type="pmid">8840204</pub-id></citation></ref><ref id="pmed.1000087-Weich1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weich</surname><given-names>S</given-names></name><name><surname>Lewis</surname><given-names>G</given-names></name></person-group><year>1998</year><article-title>Poverty, unemployment, and common mental disorders: Population based cohort study.</article-title><source>BMJ</source><volume>317</volume><fpage>115</fpage><lpage>119</lpage><pub-id pub-id-type="pmid">9657786</pub-id></citation></ref><ref id="pmed.1000087-Belkic1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Belkic</surname><given-names>KL</given-names></name><name><surname>Landsbergis</surname><given-names>PA</given-names></name><name><surname>Schnall</surname><given-names>PL</given-names></name><name><surname>Baker</surname><given-names>D</given-names></name></person-group><year>2004</year><article-title>Is job strain a major source of cardiovascular disease risk?</article-title><source>Scand J Work Environ Health</source><volume>30</volume><fpage>85</fpage><lpage>128</lpage><pub-id pub-id-type="pmid">15127782</pub-id></citation></ref><ref id="pmed.1000087-Bosma1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bosma</surname><given-names>H</given-names></name><name><surname>Peter</surname><given-names>R</given-names></name><name><surname>Siegrist</surname><given-names>J</given-names></name><name><surname>Marmot</surname><given-names>M</given-names></name></person-group><year>1998</year><article-title>Two alternative job stress models and the risk of coronary heart disease.</article-title><source>Am J Pub Health</source><volume>88</volume><fpage>68</fpage><lpage>74</lpage><pub-id pub-id-