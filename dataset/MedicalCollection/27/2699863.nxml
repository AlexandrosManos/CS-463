td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;9. rs17060480</td><td align="center" rowspan="1" colspan="1">A/T</td><td align="char" char="." rowspan="1" colspan="1">0.07</td><td align="center" rowspan="1" colspan="1">A</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td align="char" char="." rowspan="1" colspan="1">0.16</td><td align="center" rowspan="1" colspan="1">2 &#x000d7; 10<sup>&#x02212;3</sup></td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;12. SIM-1</td><td align="center" rowspan="1" colspan="1">C/T</td><td align="char" char="." rowspan="1" colspan="1">0.95</td><td rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">&#x02014;</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;13. Arg665His</td><td align="center" rowspan="1" colspan="1">G/A</td><td align="char" char="." rowspan="1" colspan="1">0.54</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">&#x02014;</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;15. rs3798514</td><td align="center" rowspan="1" colspan="1">A/G</td><td align="char" char="." rowspan="1" colspan="1">0.01</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">G</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#