tion-type="journal"><person-group person-group-type="author"><name><surname>Radin</surname><given-names>EL</given-names></name><name><surname>Yang</surname><given-names>KH</given-names></name><name><surname>Riegger</surname><given-names>C</given-names></name><name><surname>Kish</surname><given-names>VL</given-names></name><name><surname>Oconnor</surname><given-names>JJ</given-names></name></person-group><article-title>Relationship between lower-limb dynamics and knee-joint pain</article-title><source>J Orthopaed Res</source><year>1991</year><volume>9</volume><fpage>398</fpage><lpage>405</lpage><pub-id pub-id-type="doi">10.1002/jor.1100090312</pub-id></citation></ref><ref id="B7"><citation citation-type="book"><person-group person-group-type="author"><collab>BS EN ISO 6721-1</collab></person-group><source>Plastics &#x02013; Determination of dynamic mechanical properties &#x02013; Part 1: General principles</source><year>2002</year><publisher-name>London: British Standards Institute</publisher-name></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wands</surname><given-names>I</given-names></name><name><surname>Shepherd</surname><given-names>DET</given-names></name><name><surname>Hukins</surname><given-names>DWL</given-names></name></person-group><article-title>Viscoelastic properties of composites of calcium alginate and hydroxyapatite</article-title><source>J Mater Sci: Mater Med</source><year>2008</year><volume>19</volume><fpage>2417</fpage><lpage>2421</lpage><pub-id pub-id-type="pmid">18197363</pub-id><pub-id pub-id-type="doi">10.1007/s10856-007-3364-3</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kiefer</surname><given-names>GN</given-names></name><name><surname>Sundby</surname><given-names>K</given-names></name><name><surname>McAllister</surname><given-names>D</given-names></name><name><surname>Shrive</surname><g