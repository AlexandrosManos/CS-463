ection</source><year>1982</year><volume>44</volume><fpage>934</fpage><lpage>935</lpage></citation></ref><ref id="B23"><label>23</label><citation citation-type="journal"><person-group><name><surname>Khan</surname><given-names>Z</given-names></name><name><surname>Bhadouria</surname><given-names>P</given-names></name><name><surname>Bisen</surname><given-names>PS</given-names></name></person-group><article-title>Nutritional and therapeutic potential of Spirulina</article-title><source>Curr Pharm Biotechnol</source><year>2005</year><volume>6</volume><fpage>373</fpage><lpage>379</lpage><pub-id pub-id-type="pmid">16248810</pub-id></citation></ref><ref id="B24"><label>24</label><citation citation-type="journal"><person-group><name><surname>Kay</surname><given-names>RA</given-names></name></person-group><article-title>Microalgae as food and supplement</article-title><source>Critical Reviews in Food Science and Nutrition</source><year>1991</year><volume>30</volume><fpage>555</fpage><lpage>573</lpage><pub-id pub-id-type="pmid">1741951</pub-id></citation></ref><ref id="B25"><label>25</label><citation citation-type="journal"><person-group><name><surname>Garc&#x000ed;a-Mart&#x000ed;nez</surname><given-names>D</given-names></name><name><surname>Rup&#x000e9;rez</surname><given-names>FJ</given-names></name><name><surname>Ugarte</surname><given-names>P</given-names></name></person-group><etal/><article-title>Tocopherol fate in plasma and liver of streptozotocin-treated rats that orally received antioxidants and Spirulina extracts</article-title><source>Int J Vitam Nutr Res</source><year>2007</year><volume>77</volume><fpage>263</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">18271281</pub-id></citation></ref><ref id="B26"><label>26</label><citation citation-type="journal"><person-group><name><surname>Torres-Duran</surname><given-names>PV</given-names></name><name><surname>Miranda-Zamora</surname><given-names>R</given-names></name><name><surname>Paredes-Carbajal</surname><given-name