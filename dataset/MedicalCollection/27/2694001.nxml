source><volume>77</volume><fpage>10</fpage><lpage>3</lpage></mixed-citation></ref><ref id="b13-co-2-525"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cook</surname><given-names>EB</given-names></name><name><surname>Stahl</surname><given-names>JL</given-names></name><name><surname>Barney</surname><given-names>NP</given-names></name><etal/></person-group><year>2000</year><article-title>Olopatadine inhibits TNF alpha release from human conjunctival mast cells</article-title><source>Ann Allergy Asthma Immunol</source><volume>84</volume><fpage>504</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">10831003</pub-id></mixed-citation></ref><ref id="b14-co-2-525"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Corum</surname><given-names>I</given-names></name><name><surname>Yeniad</surname><given-names>B</given-names></name><name><surname>Bilgin</surname><given-names>LK</given-names></name><etal/></person-group><year>2005</year><article-title>Efficiency of olopatadine hydrochloride 0.1% in the treatment of vernal keratoconjunctivitis and goblet cell density</article-title><source>J Ocul Pharmacol Ther</source><volume>21</volume><fpage>400</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">16245967</pub-id></mixed-citation></ref><ref id="b15-co-2-525"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ganz</surname><given-names>M</given-names></name><name><surname>Koll</surname><given-names>E</given-names></name><name><surname>Gausche</surname><given-names>J</given-names></name><etal/></person-group><year>2003</year><article-title>Ketotifen fumarate and olopatadine hydrochloride in the treatment of allergic conjunctivitis: a real-world comparison of efficacy and ocular comfort</article-title><source>Adv Ther</source><volume>20</volume><fpage>79</fpage><lpage>91</lpage><pub-id pub-id-type="pmid">12836808</pub-id></mixed-citation