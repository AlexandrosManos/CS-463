forms</article-title><source>J Comput Biol</source><year>2005</year><volume>12</volume><fpage>407</fpage><lpage>415</lpage><pub-id pub-id-type="pmid">15882139</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Healy</surname><given-names>J</given-names></name><name><surname>Thomas</surname><given-names>EE</given-names></name><name><surname>Schwartz</surname><given-names>JT</given-names></name><name><surname>Wigler</surname><given-names>M</given-names></name></person-group><article-title>Annotating large genomes with exact word matches</article-title><source>Genome research</source><year>2003</year><volume>13</volume><fpage>2306</fpage><lpage>2315</lpage><pub-id pub-id-type="pmid">12975312</pub-id></citation></ref></ref-list></back></article>