t Neurol</source><volume>6</volume><fpage>521</fpage><lpage>532</lpage><pub-id pub-id-type="pmid">17509487</pub-id></citation></ref><ref id="pone.0005827-Hussain1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hussain</surname><given-names>R</given-names></name><name><surname>Bittles</surname><given-names>AH</given-names></name></person-group><year>1998</year><article-title>The prevalence and demographic characteristics of consanguineous marriages in Pakistan.</article-title><source>J Biosoc Sci</source><volume>30</volume><fpage>261</fpage><lpage>275</lpage><pub-id pub-id-type="pmid">9746828</pub-id></citation></ref><ref id="pone.0005827-Ravi1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ravi</surname><given-names>G</given-names></name><name><surname>Manjeet</surname><given-names>B</given-names></name><name><surname>Vishal</surname><given-names>C</given-names></name></person-group><year>2007</year><article-title>Chronic daily headache: medication overuse and psychiatric morbidity.</article-title><source>J Pak Psych Society</source><volume>4</volume><fpage>19</fpage><lpage>24</lpage></citation></ref><ref id="pone.0005827-Chakravarty1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chakravarty</surname><given-names>A</given-names></name></person-group><year>2003</year><article-title>Chronic daily headaches: clinical profile in Indian patients.</article-title><source>Cephalalgia</source><volume>23</volume><fpage>348</fpage><lpage>353</lpage><pub-id pub-id-type="pmid">12780764</pub-id></citation></ref></ref-list><fn-group><fn fn-type="conflict"><p><bold>Competing Interests: </bold>The authors have declared that no competing interests exist.</p></fn><fn fn-type="financial-disclosure"><p><bold>Funding: </bold>The authors have no support or funding to report.</p></fn></fn-group></back></artic