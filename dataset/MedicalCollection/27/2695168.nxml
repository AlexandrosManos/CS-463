</person-group><year>1993</year><article-title>Functional assessment: Toward a dialectical view of person-environment relations</article-title><source>Am J Occup Ther</source><volume>47</volume><fpage>248</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">8456925</pub-id></citation></ref><ref id="b11-cia-0102-189"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leon</surname><given-names>D</given-names></name></person-group><year>1997</year><article-title>Huge variation in Russian mortality rates 1984&#x02013;94: Artifact, alcohol, or what?</article-title><source>Lancet</source><volume>350</volume><fpage>383</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">9259651</pub-id></citation></ref><ref id="b12-cia-0102-189"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McEwen</surname><given-names>M</given-names></name></person-group><year>1993</year><article-title>The health motivation assessment inventory</article-title><source>West J Nurs Res</source><volume>15</volume><fpage>770</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">8284933</pub-id></citation></ref><ref id="b13-cia-0102-189"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Molina</surname><given-names>JA</given-names></name></person-group><year>1983&#x02013;84</year><article-title>Understanding the biopsychosocial model</article-title><source>Int J Psychiatry Med</source><volume>13</volume><fpage>29</fpage><lpage>36</lpage><pub-id pub-id-type="pmid">6885262</pub-id></citation></ref><ref id="b14-cia-0102-189"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Notzon</surname><given-names>FC</given-names></name><name><surname>Komarov</surname><given-names>YM</given-names></name><name><surname>Ermakov</surname><given-names>SP</given-names></name><etal/></person-group><year>1998</year><article-title>Causes of declining life expectancy in Russia</art