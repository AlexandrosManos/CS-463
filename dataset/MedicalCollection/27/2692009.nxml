name><given-names>M</given-names></name><name><surname>Haslam</surname><given-names>R</given-names></name></person-group><article-title>Expression profiling of the response of Arabidopsis thaliana to methanol stimulation</article-title><source>Phytochemistry</source><year>2004</year><volume>65</volume><fpage>2305</fpage><lpage>2316</lpage><pub-id pub-id-type="pmid">15381001</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ellis</surname><given-names>C</given-names></name><name><surname>Karafyllidis</surname><given-names>I</given-names></name><name><surname>Wasternack</surname><given-names>C</given-names></name><name><surname>Turner</surname><given-names>JG</given-names></name></person-group><article-title>The Arabidopsis mutant cev1 links cell wall signaling to jasmonate and ethylene responses</article-title><source>The Plant Cell</source><year>2002</year><volume>14</volume><fpage>1557</fpage><lpage>1566</lpage><pub-id pub-id-type="pmid">12119374</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fall</surname><given-names>R</given-names></name><name><surname>Benson</surname><given-names>AA</given-names></name></person-group><article-title>Leaf methanol&#x02014;the simplest natural product from plants</article-title><source>Trends in Plant Science</source><year>1996</year><volume>1</volume><fpage>296</fpage><lpage>301</lpage></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giri</surname><given-names>AP</given-names></name><name><surname>W&#x000fc;nsche</surname><given-names>H</given-names></name><name><surname>Mitra</surname><given-names>S</given-names></name><name><surname>Zavala</surname><given-names>JA</given-names></name><name><surname>Muck</surname><given-names>A</given-names></name><name><surname>Svatos</surname><given-names>A</