ournal"><person-group person-group-type="author"><name><surname>Yudovich</surname><given-names>YE</given-names></name><name><surname>Ketris</surname><given-names>MP</given-names></name></person-group><article-title>Arsenic in coal: a review</article-title><source>Int J Coal Geol</source><year>2005</year><volume>61</volume><fpage>141</fpage><lpage>196</lpage><pub-id pub-id-type="doi">10.1016/j.coal.2004.09.003</pub-id></citation><citation citation-type="display-unstructured">Yudovich YE, Ketris MP (2005b) Arsenic in coal: a review. Int J Coal Geol 61:141&#x02013;196. doi:10.1016/j.coal.2004.09.003 </citation></ref><ref id="CR15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zheng</surname><given-names>N</given-names></name><name><surname>Wang</surname><given-names>QC</given-names></name><name><surname>Zheng</surname><given-names>DM</given-names></name></person-group><article-title>Health risk of Hg, Pb, Cd, Zn, and Cu to the inhabitants around Huludao Zinc Plant in China via consumption of vegetables</article-title><source>Sci Total Environ</source><year>2007</year><volume>283</volume><fpage>81</fpage><lpage>89</lpage></citation><citation citation-type="display-unstructured">Zheng N, Wang QC, Zheng DM (2007) Health risk of Hg, Pb, Cd, Zn, and Cu to the inhabitants around Huludao Zinc Plant in China via consumption of vegetables. Sci Total Environ 283:81&#x02013;89. doi:10.1016/j.scitotenv.2007.05.002 <pub-id pub-id-type="pmid">17573096</pub-id></citation></ref><ref id="CR16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zheng</surname><given-names>DM</given-names></name><name><surname>Wang</surname><given-names>QC</given-names></name><name><surname>Zhang</surname><given-names>ZS</given-names></name><etal/></person-group><article-title>Bioaccumulation of total and methyl mercury by arthropods</article-title><source>Bull Environ Contam Toxicol</source><year>2008</year><volume>81</volume><fpage>95</fpage><lpage>100</lpage><pub-id pub-id-type="doi">10.1007/s00128-008-9393-x</pub-id></citation><citation citation-type="display-unstructured">Zheng DM, Wang QC, Zhang ZS et al (2008) Bioaccumulation of total and methyl mercury by arthropods. Bull Environ Contam Toxicol 81:95&#x02013;100. doi:10.1007/s00128-008-9393-x <pub-id pub-id-type="pmid">18365125</pub-id></citation></ref></ref-list></back></article>