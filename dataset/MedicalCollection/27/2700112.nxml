roup person-group-type="author"><name><surname>Pfaffl</surname><given-names>MW</given-names></name><name><surname>Tichopad</surname><given-names>A</given-names></name><name><surname>Prgomet</surname><given-names>C</given-names></name><name><surname>Neuvians</surname><given-names>TP</given-names></name></person-group><article-title>Determination of stable housekeeping genes, differentially regulated target genes and sample integrity: BestKeeper &#x02013; Excel-based tool using pair-wise correlations</article-title><source>Biotechnol Lett</source><year>2004</year><volume>26</volume><fpage>509</fpage><lpage>515</lpage><pub-id pub-id-type="pmid">15127793</pub-id><pub-id pub-id-type="doi">10.1023/B:BILE.0000019559.84305.47</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Breugelmans</surname><given-names>B</given-names></name><name><surname>Simonet</surname><given-names>G</given-names></name><name><surname>van Hoef</surname><given-names>V</given-names></name><name><surname>Claeys</surname><given-names>I</given-names></name><name><surname>Van Soest</surname><given-names>S</given-names></name><name><surname>Broeck</surname><given-names>J Vanden</given-names></name></person-group><article-title>Quantitative RT-PCR analysis of pacifastin-related precursor transcripts during the reproductive cycle of solitarious and gregarious desert locusts</article-title><source>Insect Mol Biol</source><year>2008</year><volume>17</volume><fpage>137</fpage><lpage>145</lpage><pub-id pub-id-type="pmid">18353103</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2583.2008.00793.x</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gentile</surname><given-names>C</given-names></name><name><surname>Lima</surname><given-names>JB</given-names></name><name><surname>Peixoto</surname><given-names>AA</given-names></name></person-group><article-title>Isolation of a fragment homologous to the rp49 constitutive gene of <italic>Drosophila </italic>in the Neotropical malaria vector <italic>Anopheles aquasalis </italic>(Diptera: Culicidae)</article-title><source>Mem Inst Oswaldo Cruz</source><year>2005</year><volume>100</volume><fpage>545</fpage><lpage>547</lpage><pub-id pub-id-type="pmid">16302065</pub-id><pub-id pub-id-type="doi">10.1590/S0074-02762005000600008</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chintapalli</surname><given-names>VR</given-names></name><name><surname>Wang</surname><given-names>J</given-names></name><name><surname>Dow</surname><given-names>JA</given-names></name></person-group><article-title>Using FlyAtlas to identify better <italic>Drosophila melanogaster </italic>models of human disease</article-title><source>Nat Genet</source><year>2007</year><volume>39</volume><fpage>715</fpage><lpage>720</lpage><pub-id pub-id-type="pmid">17534367</pub-id><pub-id pub-id-type="doi">10.1038/ng2049</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boda</surname><given-names>E</given-names></name><name><surname>Pini</surname><given-names>A</given-names></name><name><surname>Hoxha</surname><given-names>E</given-names></name><name><surname>Parolisi</surname><given-names>R</given-names></name><name><surname>Tempia</surname><given-names>F</given-names></name></person-group><article-title>Selection of Reference Genes for Quantitative Real-time RT-PCR Studies in Mouse Brain</article-title><source>J Mol Neurosci</source><year>2008</year><volume>37</volume><fpage>238</fpage><lpage>253</lpage><pub-id pub-id-type="pmid">18607772</pub-id><pub-id pub-id-type="doi">10.1007/s12031-008-9128-9</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Infante</surname><given-names>C</given-names>