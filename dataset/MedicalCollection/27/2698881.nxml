 id="B8"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Sawicki</surname><given-names>GS</given-names></name><name><surname>Lewis</surname><given-names>CL</given-names></name><name><surname>Ferris</surname><given-names>DP</given-names></name></person-group><article-title>It pays to have a spring in your step</article-title><source>Exercise and Sport Science Reviews</source><year>2009</year><comment></comment></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gordon</surname><given-names>KE</given-names></name><name><surname>Ferris</surname><given-names>DP</given-names></name></person-group><article-title>Learning to walk with a robotic ankle exoskeleton</article-title><source>Journal of Biomechanics</source><year>2007</year><volume>40</volume><fpage>2636</fpage><lpage>2644</lpage><pub-id pub-id-type="pmid">17275829</pub-id><pub-id pub-id-type="doi">10.1016/j.jbiomech.2006.12.006</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cain</surname><given-names>SM</given-names></name><name><surname>Gordon</surname><given-names>KE</given-names></name><name><surname>Ferris</surname><given-names>DP</given-names></name></person-group><article-title>Locomotor adaptation to a powered ankle-foot orthosis depends on control method</article-title><source>Journal of Neuroengineering and Rehabilitation</source><year>2007</year><volume>4</volume><fpage>48</fpage><pub-id pub-id-type="pmid">18154649</pub-id><pub-id pub-id-type="doi">10.1186/1743-0003-4-48</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kinnaird</surname><given-names>CR</given-names></name><name><surname>Ferris</surname><given-names>DP</given-names></name></person-group><article-title>Medial gastrocnemius myoelectric control of a robotic ankle exoskeleton<