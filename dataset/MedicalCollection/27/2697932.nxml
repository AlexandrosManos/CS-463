" colspan="1">75.0</td><td valign="bottom" align="center" rowspan="1" colspan="1"><italic>p</italic> &#x0003c; 0.0001</td></tr><tr><td valign="bottom" align="left" rowspan="1" colspan="1">Partner&#x02019;s HIV serostatus = don&#x02019;t care</td><td valign="bottom" align="center" rowspan="1" colspan="1">58.3</td><td valign="bottom" align="center" rowspan="1" colspan="1">21.1</td><td valign="bottom" align="center" rowspan="1" colspan="1">62.9</td><td valign="bottom" align="center" rowspan="1" colspan="1">22.7</td><td valign="bottom" align="center" rowspan="1" colspan="1"><italic>p</italic> &#x0003c; 0.0001</td></tr></tbody></table></table-wrap></floats-group></article>