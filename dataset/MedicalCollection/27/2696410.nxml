name><name><surname>Lauren-Maatta</surname><given-names>C</given-names></name><name><surname>Vassilieva</surname><given-names>LL</given-names></name><name><surname>Lynch</surname><given-names>M</given-names></name><name><surname>Leroi</surname><given-names>AM</given-names></name></person-group><article-title>Spontaneous mutational variation for body size in <italic>Caenorhabditis elegans</italic></article-title><source>Genetics</source><year>2002</year><volume>162</volume><fpage>755</fpage><lpage>765</lpage><pub-id pub-id-type="pmid">12399386</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Estes</surname><given-names>S</given-names></name><name><surname>Ajie</surname><given-names>BC</given-names></name><name><surname>Lynch</surname><given-names>M</given-names></name><name><surname>Phillips</surname><given-names>PC</given-names></name></person-group><article-title>Spontaneous mutational correlations for life-history, morphological and behavioral characters in <italic>Caenorhabditis elegans</italic></article-title><source>Genetics</source><year>2005</year><volume>170</volume><fpage>645</fpage><lpage>653</lpage><pub-id pub-id-type="pmid">15834140</pub-id><pub-id pub-id-type="doi">10.1534/genetics.104.040022</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vassilieva</surname><given-names>LL</given-names></name><name><surname>Lynch</surname><given-names>M</given-names></name></person-group><article-title>The rate of spontaneous mutation for life-history traits in <italic>Caenorhabditis elegans</italic></article-title><source>Genetics</source><year>1999</year><volume>151</volume><fpage>119</fpage><lpage>129</lpage><pub-id pub-id-type="pmid">9872953</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Halligan</surname><given-names>DL</giv