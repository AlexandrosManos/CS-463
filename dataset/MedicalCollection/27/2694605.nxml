" colspan="1">+</td></tr><tr><td align="center" rowspan="1" colspan="1">Quail</td><td align="center" rowspan="1" colspan="1">n.e.</td><td align="center" rowspan="1" colspan="1">n.e.</td><td align="center" rowspan="1" colspan="1">n.e.</td></tr><tr><td align="center" rowspan="1" colspan="1">Chicken </td><td align="center" rowspan="1" colspan="1">n.e.</td><td align="center" rowspan="1" colspan="1">n.e.</td><td align="center" rowspan="1" colspan="1">n.e.</td></tr><tr><td align="center" rowspan="1" colspan="1">Pig [<xref ref-type="bibr" rid="R39">39</xref>]</td><td align="center" rowspan="1" colspan="1">&#x000d8;</td><td align="center" rowspan="1" colspan="1">+</td><td align="center" rowspan="1" colspan="1">++</td></tr><tr><td align="center" rowspan="1" colspan="1">Cat [<xref ref-type="bibr" rid="R41">41</xref>,<xref ref-type="bibr" rid="R42">42</xref>]</td><td align="center" rowspan="1" colspan="1">&#x000d8;</td><td align="center" rowspan="1" colspan="1">+</td><td align="center" rowspan="1" colspan="1">++</td></tr><tr><td align="center" rowspan="1" colspan="1">Dog [<xref ref-type="bibr" rid="R43">43</xref>]</td><td align="center" rowspan="1" colspan="1">&#x000d8;</td><td align="center" rowspan="1" colspan="1">+</td><td align="center" rowspan="1" colspan="1">++</td></tr><tr><td align="center" rowspan="1" colspan="1">Monkey [<xref ref-type="bibr" rid="R48">48</xref>-<xref ref-type="bibr" rid="R50">50</xref>]</td><td align="center" rowspan="1" colspan="1">+</td><td align="center" rowspan="1" colspan="1">+</td><td align="center" rowspan="1" colspan="1">+</td></tr><tr><td align="center" rowspan="1" colspan="1">Human [<xref ref-type="bibr" rid="R51">51</xref>-<xref ref-type="bibr" rid="R55">55</xref>]</td><td align="center" rowspan="1" colspan="1">+</td><td align="center" rowspan="1" colspan="1">(+)</td><td align="center" rowspan="1" colspan="1">+</td></tr></tbody></table><table-wrap-foot><fn id="T3FN3"><p>n.e. = not examined; &#x000d8; = no, (+) = possible, + = clear, ++ = substantial source of optic nerve head capillaries.</p></fn></table-wrap-foot></table-wrap><table-wrap id="T4" position="float"><label>Table 4</label><caption><p>Comparative Data of the Inner Retina</p></caption><table frame="hsides" rules="groups" width="100%"><thead><tr><th rowspan="1" colspan="1">Animal</th><th rowspan="1" colspan="1">Ganglion Cell Number (Average)</th><th rowspan="1" colspan="1">% of Amacrine Cells of the Ganglion Cell Layer Neurons</th><th rowspan="1" colspan="1">Astrocytes in the Inner Retina</th></tr></thead><tbody><tr><td align="center" rowspan="1" colspan="1">Mouse</td><td align="center" rowspan="1" colspan="1">32,000 &#x02013; 87,000 [<xref ref-type="bibr" rid="R56">56</xref>]</td><td align="center" rowspan="1" colspan="1">59% [<xref ref-type="bibr" rid="R59">59</xref>]</td><td align="center" rowspan="1" colspan="1">+</td></tr><tr><td align="center" rowspan="1" colspan="1">Rat</td><td align="center" rowspan="1" colspan="1">72,371 - 113,000 [<xref ref-type="bibr" rid="R52">52</xref>-<xref ref-type="bibr" rid="R58">58</xref>]</td><td align="center" rowspan="1" colspan="1">50% [<xref ref-type="bibr" rid="R60">60</xref>,<xref ref-type="bibr" rid="R61">61</xref>]</td><td align="center" rowspan="1" colspan="1">+</td></tr><tr><td align="center" rowspan="1" colspan="1">Rabbit</td><td align="center" rowspan="1" colspan="1">250,000 - 394,000 [<xref ref-type="bibr" rid="R63">63</xref>,<xref ref-type="bibr" rid="R64">64</xref>,<xref ref-type="bibr" rid="R66">66</xref>]</td><td align="center" rowspan="1" colspan="1">31,7% [<xref ref-type="bibr" rid="R67">67</xref>,<xref ref-type="bibr" rid="R68">68</xref>]</td><td align="center" rowspan="1" colspan="1">(+), only in vascular streak region [<xref ref-type="bibr" rid="R62">62</xref>]</td></tr><tr><td align="center" rowspan="1" colspan="1">Quail</td><td align="center" rowspan="1" colspan="1">2,000,000 [<xref ref-type="bibr" rid="R73">73</xref>]</td><td align="center" rowspan="1" colspan="1">? [<xref ref-type="bibr" rid="R73">73</xref>]</td><td align="center" rowspan="1" colspan="1">&#x000d8; [<xref ref-type="bibr" rid="R69">69</xref>]</td></tr><tr><td align="center" rowspan="1" colspan="1">Chicken</td><td align="center" rowspan="1" colspan="1">2,400,000 [<xref ref-type="bibr" rid="R74">74</xref>]</td><td align="center" rowspan="1" colspan="1">- 35% [<xref ref-type="bibr" rid="R75">75</xref>,<xref ref-type="bibr" rid="R76">76</xref>]</td><td align="center" rowspan="1" colspan="1">&#x000d8; [<xref ref-type="bibr" rid="R69">69</xref>]</td></tr><tr><td align="center" rowspan="1" colspan="1">Pig</td><td align="center" rowspan="1" colspan="1">442,629 [<xref ref-type="bibr" rid="R77">77</xref>]</td><td align="center" rowspan="1" colspan="1">31% [<xref ref-type="bibr" rid="R78">78</xref>]</td><td align="center" rowspan="1" colspan="1">+, mainly around vessels [<xref ref-type="bibr" rid="R79">79</xref>,<xref ref-type="bibr" rid="R80">80</xref>]</td></tr><tr><td align="center" rowspan="1" colspan="1">Cat</td><td align="center" rowspan="1" colspan="1">193,000 [<xref ref-type="bibr" rid="R82">82</xref>]</td><td align="center" rowspan="1" colspan="1">80% [<xref ref-type="bibr" rid="R107">107</xref>-<xref ref-type="bibr" rid="R109">109</xref>]</td><td align="center" rowspan="1" colspan="1">+, mainly around nerve fibers [<xref ref-type="bibr" rid="R103">103</xref>-<xref ref-type="bibr" rid="R105">105</xref>]</td></tr><tr><td align="center" rowspan="1" colspan="1">Dog</td><td align="center" rowspan="1" colspan="1">148,303 [<xref ref-type="bibr" rid="R81">81</xref>]</td><td rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">+, mainly around vessels [<xref ref-type="bibr" rid="R102">102</xref>]</td></tr><tr><td align="center" rowspan="1" colspan="1">Monkey</td><td align="center" rowspan="1" colspan="1">900,000 &#x02013; 1,500,000 [<xref ref-type="bibr" rid="R110">110</xref>-<xref ref-type="bibr" rid="R113">113</xref>]</td><td align="center" rowspan="1" colspan="1">Fovea 5%, nasal 30%, temporal 50% [<xref ref-type="bibr" rid="R115">115</xref>]</td><td align="center" rowspan="1" colspan="1">+, mainly around vessels</td></tr><tr><td align="center" rowspan="1" colspan="1">Human</td><td align="center" rowspan="1" colspan="1">700,000 &#x02013; 1,500,000 [<xref ref-type="bibr" rid="R114">114</xref>]</td><td align="center" rowspan="1" colspan="1">Fovea 3%, peripheral - 80% [<xref ref-type="bibr" rid="R114">114</xref>]</td><td align="center" rowspan="1" colspan="1">+, mainly around vessels</td></tr></tbody></table><table-wrap-foot><fn id="T4FN1"><p>? = No quantified or estimated data available.</p></fn><fn id="T4FN2"><p>&#x000d8; = no, (+) = limited, + = ubiquitous presence of astrocytes.</p></fn></table-wrap-foot></table-wrap></floats-group></article>