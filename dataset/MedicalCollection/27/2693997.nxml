</name><name><surname>Shields</surname><given-names>JA</given-names></name><etal/></person-group><year>1999</year><article-title>Radiation retinopathy following plaque radiotherapy for posterior uveal melanoma</article-title><source>Arch Ophthalmol</source><volume>117</volume><fpage>609</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">10326957</pub-id></mixed-citation></ref><ref id="b11-co-2-275"><mixed-citation publication-type="book"><collab>International Commission on Radiological Protection</collab><year>1991</year><source>1990 Recommendations of the International Commission on Radiological Protection</source><publisher-loc>New York, NY</publisher-loc></mixed-citation></ref><ref id="b12-co-2-275"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kaiserman</surname><given-names>I</given-names></name><name><surname>Anteby</surname><given-names>I</given-names></name><name><surname>Chowers</surname><given-names>I</given-names></name><etal/></person-group><year>2004</year><article-title>Post-brachytherapy initial tumour regression rate correlates with metastatic spread in posterior uveal melanoma</article-title><source>Br J Ophthalmol</source><volume>88</volume><fpage>892</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">15205232</pub-id></mixed-citation></ref><ref id="b13-co-2-275"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kan</surname><given-names>Z</given-names></name><name><surname>Kobayashi</surname><given-names>S</given-names></name><name><surname>Phongkitkarun</surname><given-names>S</given-names></name><etal/></person-group><year>2005a</year><article-title>Functional CT quantification of tumor perfusion after transhepatic arterial embolization in a rat model</article-title><source>Radiology</source><volume>237</volume><fpage>144</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">16183930</pub-id></mixed-citation></ref><ref id="b14-co-2-275"><mixed-citat