-type="doi">10.1152/ajpheart.01368.2005</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mendelman</surname><given-names>A</given-names></name><name><surname>Zarchin</surname><given-names>N</given-names></name><name><surname>Rifkind</surname><given-names>J</given-names></name><name><surname>Mayevsky</surname><given-names>A</given-names></name></person-group><article-title>Brain multiparametric responses to carbon monoxide in the aging rat</article-title><source>Brain Res</source><year>2000</year><volume>867</volume><fpage>217</fpage><lpage>22</lpage><pub-id pub-id-type="pmid">10837816</pub-id><pub-id pub-id-type="doi">10.1016/S0006-8993(00)02326-X</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Raub</surname><given-names>JA</given-names></name><name><surname>Mathieu-Nolf</surname><given-names/></name><name><surname>Hampson</surname><given-names>NB</given-names></name><name><surname>Thom</surname><given-names>SR</given-names></name></person-group><article-title>Carbon monoxide poisoning- a public heath perspective</article-title><source>Toxicology</source><year>2000</year><volume>145</volume><fpage>1</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">10771127</pub-id><pub-id pub-id-type="doi">10.1016/S0300-483X(99)00217-6</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Resch</surname><given-names>H</given-names></name><name><surname>Zawinka</surname><given-names>C</given-names></name><name><surname>Weiger</surname><given-names>Gm</given-names></name><name><surname>Schmetter</surname><given-names>L</given-names></name><name><surname>Garhofer</surname><given-names>G</given-names></name></person-group><article-title>Inhaled carbon monoxide increases retinal and choroidal blood flow in healthy humans</article-title><source>Invest Ophthalmol and Vis Sci</source><year>2005</year><volume>46</volume><fpage>4275</fpage><lpage>4280</lpage><pub-id pub-id-type="pmid">16249508</pub-id><pub-id pub-id-type="doi">10.1167/iovs.05-0417</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sorhaug</surname><given-names>S</given-names></name><name><surname>Steinshamn</surname><given-names>S</given-names></name><name><surname>Nilsen</surname><given-names>OG</given-names></name><name><surname>Waldum</surname><given-names>HL</given-names></name></person-group><article-title>Chronic inhalation of carbon monoxide: effects on the respiratory and cardiovascular system at doses corresponding to tobacco smoking</article-title><source>Toxicology</source><year>2006</year><volume>228</volume><fpage>280</fpage><lpage>290</lpage><pub-id pub-id-type="pmid">17056171</pub-id><pub-id pub-id-type="doi">10.1016/j.tox.2006.09.008</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McGregor</surname><given-names>HP</given-names></name><name><surname>Westcott</surname><given-names>K</given-names></name><name><surname>Walker</surname><given-names>DW</given-names></name></person-group><article-title>The effect of prenatal exposure to carbon monoxide on breathing and growth of the newborn guinea pig</article-title><source>Int Pediatrics Research Found</source><year>1998</year><volume>43</volume><fpage>126</fpage><lpage>131</lpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mereu</surname><given-names>G</given-names></name><name><surname>Cammalleri</surname><given-names>M</given-names></name><name><surname>Fa</surname><given-names>M</given-names></name><name><surname>Francesconi</surname><given-names>W</given-names></name><name><surname>Saba</surname><given-names>P</given-names></name><name><surname>Tattoli</surname><given-names>M</given-names></name><name><surname>Trabace</surname><given-names>L</given-names></name><name><surname>Vaccari</surname><given-names>A</given-names></name><name><surname>Cuomo</surname><given-names>V</given-names></name></person-group><article-title>Prenatal exposure to a low concentration of carbon monoxide disrupts hippocampal long-term potentiation in rat offspring</article-title><source>J Pharmacol Exp Ther</source><year>2000</year><volume>294</volume><fpage>728</fpage><lpage>734</lpage><pub-id pub-id-type="pmid">10900254</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Montagnani</surname><given-names>M</given-names></name><name><surname>Serio</surname><given-names>M</given-names></name><name><surname>Potenza</surname><given-names>MA</given-names></name><name><surname>Mansi</surname><given-names>G</given-names></name><name><surname>De Salvia</surname><given-names>MA</given-names></name><name><surname>Caginao</surname><given-names>R</given-names></name><name><surname>Cuomo</surname><given-names>V</given-names></name><name><surname>Mitolo Chieppa</surname><given-names>D</given-names></name></person-group><article-title>Prenatal exposure to carbon monoxide and vascular responsiveness of rat resistance vessels</article-title><source>Life Sci</source><year>1996</year><volume>59</volume><fpage>1553</fpage><lpage>1561</lpage><pub-id pub-id-type="pmid">8890936</pub-id><pub-id pub-id-type="doi">10.1016/0024-3205(96)00486-9</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Neuberger</surname><given-names>M</given-names></name><name><surname>Endler</surname><given-names>M</given-names></name><name><surname>Resch</surname><given-names>W</given-names></name></person-group><article-title>Carbon monoxide in mother and newborn infant from smoking during pregnancy</article-title><source>Zentralbl Bakteriol Mikrobiol Hyg (B)</source><year>1982</year><volume>176</volume><fpage>349</fpage><lpage>353</lpage><pub-id pub-id-type="pmid">7148208</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lavezzi</surname><given-names>AM</given-names></name><name><surname>Ottaviani</surname><given-names>G</given-names></name><name><surname>Matturi</surname><given-names>L</given-names></name></person-group><article-title>Adverse effects of prenatal tobacco smoke exposure on biological parameters of the developing brainstem</article-title><source>Neurobiology of Disease</source><year>2005</year><volume>20</volume><fpage>601</fpage><lpage>607</lpage><pub-id pub-id-type="pmid">15925516</pub-id><pub-id pub-id-type="doi">10.1016/j.nbd.2005.04.015</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Longo</surname><given-names>LD</given-names></name></person-group><article-title>The biological effects of carbon monoxide on the pregnant woman, fetus and newborn infant</article-title><source>Am J Obstetric Gynecol</source><year>1977</year><volume>129</volume><fpage>69</fpage><lpage>103</lpage></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Di Giovanni</surname><given-names>V</given-names></name><name><surname>Cagiano</surname><given-names>R</given-names></name><name><surname>De Silva</surname><given-names>MA</given-names></name><name><surname>Giustino</surname><given-names>A</given-names></name><name><surname>Lacomba</surname><given-names>C</given-names></name><name><surname>Renna</surname><given-names>G</given-names></name><name><surname>Cuomo</surname><given-names>V</given-names></name></person-group><article-title>Neurobehavioral changes produced in rats by prenatal exposure to carbon monoxide</article-title><source>Brain Res</source><year>1993</year><volume>616</volu