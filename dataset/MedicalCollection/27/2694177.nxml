pe="author"><name><surname>Coreil</surname><given-names>J</given-names></name><name><surname>Augustin</surname><given-names>A</given-names></name><name><surname>Holt</surname><given-names>E</given-names></name><name><surname>Halsey</surname><given-names>NA</given-names></name></person-group><article-title>Use of ethnographic research for instrument development in a case- control study of immunization use in Haiti</article-title><source>Int J Epedemiol</source><year>1989</year><volume>18</volume><fpage>33</fpage><lpage>37</lpage></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Millman</surname><given-names>ML</given-names></name></person-group><source>Access to health care</source><year>1993</year><publisher-name>Institute of Medicine. National Academy Press, Washington, DC</publisher-name><fpage>69</fpage></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Onyiriuka</surname><given-names>AN</given-names></name></person-group><article-title>Vaccination default rates among children attending a static immunization clinic in Benin City, Nigeria</article-title><source>Journal of Medicine and Biomedical Research</source><year>2005</year><volume>4</volume><fpage>71</fpage><lpage>77</lpage></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Mahy</surname><given-names>M</given-names></name></person-group><source>Childhood mortality in the developing world: a review of evidence from the Demographic and Health Surveys</source><year>2003</year><publisher-name>Calverton, MD, Macro International Inc., DHS Comparative Reports, No. 4</publisher-name></citation></ref></ref-list></back></article>