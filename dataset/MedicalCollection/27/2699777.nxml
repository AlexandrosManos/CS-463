citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mundt-Petersen</surname><given-names>U</given-names></name><name><surname>Petersen</surname><given-names>A</given-names></name><name><surname>Emgard</surname><given-names>M</given-names></name><etal/></person-group><year>2000</year><article-title>Caspase inhibition increases embryonic striatal graft survival</article-title><source>Exp Neurol</source><volume>164</volume><fpage>112</fpage><lpage>20</lpage><pub-id pub-id-type="pmid">10877921</pub-id></mixed-citation></ref><ref id="b18-co-2-743"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nishitoh</surname><given-names>H</given-names></name><name><surname>Matsuzawa</surname><given-names>A</given-names></name><name><surname>Tobiume</surname><given-names>K</given-names></name><etal/></person-group><year>2002</year><article-title>ASK1 is essential for endoplasmic reticulum stress-induced neuronal cell death triggered by expanded polyglutamine repeats</article-title><source>Genes Dev</source><volume>16</volume><fpage>1345</fpage><lpage>55</lpage><pub-id pub-id-type="pmid">12050113</pub-id></mixed-citation></ref><ref id="b19-co-2-743"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Oshitari</surname><given-names>T</given-names></name><name><surname>Hata</surname><given-names>N</given-names></name><name><surname>Yamamoto</surname><given-names>S</given-names></name></person-group><year>2008a</year><article-title>Endoplasmic reticulum stress and diabetic retinopathy</article-title><source>Vasc Health Risk Manag</source><volume>4</volume><fpage>115</fpage><lpage>22</lpage><pub-id pub-id-type="pmid">18629365</pub-id></mixed-citation></ref><ref id="b20-co-2-743"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Oshitari</surname><given-names>T</given-names></name><name><surname>Roy</surna