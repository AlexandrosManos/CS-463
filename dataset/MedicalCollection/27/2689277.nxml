>79593&#x02013;79727</td><td align="center">44</td><td align="left">4.89</td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left">077R</td><td align="center">79834&#x02013;80316</td><td align="center">160</td><td align="left">17.24</td><td></td><td align="left">2e-78</td><td align="left">95</td><td align="left"><ext-link ext-link-type="gen" xlink:href="YP_003804">YP_003804</ext-link></td><td align="left">ATV</td><td></td></tr><tr><td align="left">078L</td><td align="center">81742-80768</td><td align="center">324</td><td align="left">36.13</td><td align="left">Zinc finger C2H2 type domain signature (PS00028)</td><td align="left">2e-178</td><td align="left">98</td><td align="left"><ext-link ext-link-type="gen" xlink:href="YP_031652">YP_031652</ext-link></td><td align="left">FV3</td><td align="left">ring finger protein</td></tr><tr><td align="left">079L</td><td align="center">83005-81917</td><td align="center">362</td><td align="left">38.14</td><td></td><td align="left">5e-167</td><td align="left">100</td><td align="left"><ext-link ext-link-type="gen" xlink:href="YP_031653">YP_031653</ext-link></td><td align="left">FV3</td><td></td></tr><tr><td align="left">080R<sup>a</sup></td><td align="center">81987&#x02013;82415</td><td align="center">142</td><td align="left">14.81</td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left">081R<sup>a</sup></td><td align="center">82500&#x02013;82943</td><td align="center">147</td><td align="left">15.30</td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left">082L</td><td align="center">83316-83062</td><td align="center">84</td><td align="left">9.26</td><td align="left">Possible membrane associated motif in LPS-induced tumor necrosis factor (smart00714)</td><td align="left">7e-30</td><td align="left">98</td><td align="left"><ext-link ext-link-type="gen" xlink:href="YP_031654">YP_031654</ext-link></td><td align="left">FV3</td><td align="left">LPS-induced tu