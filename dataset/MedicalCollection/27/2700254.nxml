ne.0006091-Sandel1"><label>15</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sandel</surname><given-names>M</given-names></name><name><surname>Wright</surname><given-names>RJ</given-names></name></person-group><year>2006</year><article-title>When home is where the stress is: expanding the dimensions of housing that influence asthma morbidity.</article-title><source>Arch Dis Child</source><volume>91</volume><fpage>942</fpage><lpage>948</lpage><pub-id pub-id-type="pmid">17056870</pub-id></mixed-citation></ref><ref id="pone.0006091-Gupta1"><label>16</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gupta</surname><given-names>RS</given-names></name><name><surname>Zhang</surname><given-names>X</given-names></name><name><surname>Sharp</surname><given-names>LK</given-names></name><name><surname>Shannon</surname><given-names>JJ</given-names></name><name><surname>Weiss</surname><given-names>KB</given-names></name></person-group><year>2008</year><article-title>Geographic variability in childhood asthma prevalence in Chicago.</article-title><source>J Allergy Clin Immunol</source><volume>121</volume><fpage>639</fpage><lpage>645 e631</lpage><pub-id pub-id-type="pmid">18243285</pub-id></mixed-citation></ref><ref id="pone.0006091-Wright7"><label>17</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wright</surname><given-names>RJ</given-names></name></person-group><year>2006</year><article-title>Health effects of socially toxic neighborhoods: the violence and urban asthma paradigm.</article-title><source>Clin Chest Med</source><volume>27</volume><fpage>413</fpage><lpage>421, v</lpage><pub-id pub-id-type="pmid">16880051</pub-id></mixed-citation></ref><ref id="pone.0006091-Kawachi1"><label>18</label><mixed-citation publication-type="book"><person-group person-group-type="editor"><name><surname>Kawachi</surname><giv