an="1">600</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Number of subjects</td><td valign="top" align="left" rowspan="1" colspan="1">10</td><td valign="top" align="left" rowspan="1" colspan="1">5</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Elimination half-life (h)</td><td valign="top" align="left" rowspan="1" colspan="1">2.5 (16)</td><td valign="top" align="left" rowspan="1" colspan="1">2.1 (29)</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Plasma clearance (L/h/m<sup>2</sup>)</td><td valign="top" align="left" rowspan="1" colspan="1">7.88 (18)</td><td valign="top" align="left" rowspan="1" colspan="1">6.25 (31)</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Renal clearance (L/h/m<sup>2</sup>)</td><td valign="top" align="left" rowspan="1" colspan="1">3.35 (36)</td><td valign="top" align="left" rowspan="1" colspan="1">&#x02013;</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Volume of distribution (L/m<sup>2</sup>)<xref ref-type="table-fn" rid="tfn1-tcrm-5-361">a</xref></td><td valign="top" align="left" rowspan="1" colspan="1">22.4 (22)</td><td valign="top" align="left" rowspan="1" colspan="1">22.0 (55)</td></tr></tbody></table><table-wrap-foot><fn id="tfn1-tcrm-5-361"><label>a</label><p>Steady stage volume of distribution.</p></fn></table-wrap-foot></table-wrap><table-wrap id="t2-tcrm-5-361" position="float"><label>Table 2</label><caption><p>Sequelae at 3-month follow-up in studies TT01 and TT02<xref ref-type="bibr" rid="b28-tcrm-5-361">28</xref>,<xref ref-type="bibr" rid="b47-tcrm-5-361">47</xref></p></caption><table frame="hsides" rules="groups"><thead><tr><th valign="top" align="left" rowspan="1" colspan="1"><bold>Sequelae</bold></th><th valign="top" align="left" rowspan="1" colspan="1"><bold>TT01 / TT02 (N = 54)</bold></th></tr></thead><tbody><tr><td valign="top" align="left" rowspan="1" colspan="1">None</td><td valign="top" align="left" rowspan="1" colspan="1">39 (72.2 %)</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">At least one</td><td valign="top" align="left" rowspan="1" colspan="1">15 (27.8 %)</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Sensory disturbances</td><td valign="top" align="left" rowspan="1" colspan="1">9 (16.7 %)</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Skin atrophy</td><td valign="top" align="left" rowspan="1" colspan="1">5 (9.3 %)</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Pain</td><td valign="top" align="left" rowspan="1" colspan="1">10 (18.5 %)</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Disfigurement</td><td valign="top" align="left" rowspan="1" colspan="1">1 (1.9 %)</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Limitation of movement</td><td valign="top" align="left" rowspan="1" colspan="1">1 (1.9 %)</td></tr></tbody></table></table-wrap></floats-wrap></article>