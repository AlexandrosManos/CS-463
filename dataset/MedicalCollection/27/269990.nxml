oup><article-title>Models for longitudinal data: a generalized estimating equations approach</article-title><source>Biometrics</source><year>1988</year><volume>44</volume><fpage>1049</fpage><lpage>1060</lpage><pub-id pub-id-type="pmid">3233245</pub-id></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wessely</surname><given-names>S</given-names></name><name><surname>Hotopf</surname><given-names>M</given-names></name><name><surname>Sharpe</surname><given-names>M</given-names></name></person-group><source>In Chronic Fatigue and its Syndromes</source><year>1998</year><publisher-name>Oxford: Oxford University Press</publisher-name><fpage>139</fpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jason</surname><given-names>LA</given-names></name><name><surname>Richman</surname><given-names>JA</given-names></name><name><surname>Rademaker</surname><given-names>AW</given-names></name><name><surname>Jordan</surname><given-names>KM</given-names></name><name><surname>Plioplys</surname><given-names>AV</given-names></name><name><surname>Taylor</surname><given-names>RR</given-names></name><name><surname>McCready</surname><given-names>W</given-names></name><name><surname>Huang</surname><given-names>CF</given-names></name><name><surname>Plioplys</surname><given-names>S</given-names></name></person-group><article-title>A community-based study of chronic fatigue syndrome</article-title><source>Arch Intern Med</source><year>1999</year><volume>159</volume><fpage>2129</fpage><lpage>2137</lpage><pub-id pub-id-type="pmid">10527290</pub-id><pub-id pub-id-type="doi">10.1001/archinte.159.18.2129</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morriss</surname><given-names>R</given-names></name><name><surname>Sharpe</surname><given-names>M</given-names></name><name><surname>Sharpley</surname><given-names>AL</given-names></name><name><surname>Cowen</surname><given-names>PJ</given-names></name><name><surname>Hawton</surname><given-names>K</given-names></name><name><surname>Morris</surname><given-names>J</given-names></name></person-group><article-title>Abnormalities of sleep in patients with the chronic fatigue syndrome</article-title><source>BMJ</source><year>1993</year><volume>306</volume><fpage>1161</fpage><lpage>1164</lpage><pub-id pub-id-type="pmid">8499816</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Whiting</surname><given-names>P</given-names></name><name><surname>Bagnall</surname><given-names>A</given-names></name><name><surname>Sowden</surname><given-names>A</given-names></name><name><surname>Cornell</surname><given-names>JE</given-names></name><name><surname>Mullrow</surname><given-names>C</given-names></name><name><surname>Ramirez</surname><given-names>G</given-names></name></person-group><article-title>Interventions for the treatment and management of chronic fatigue syndrome: a systematic review</article-title><source>JAMA</source><year>2001</year><volume>286</volume><fpage>1360</fpage><lpage>1368</lpage><pub-id pub-id-type="pmid">11560542</pub-id><pub-id pub-id-type="doi">10.1001/jama.286.11.1360</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eisenberg</surname><given-names>DM</given-names></name><name><surname>Roger</surname><given-names>B</given-names></name><name><surname>Ettner</surname><given-names>SL</given-names></name><etal></etal></person-group><article-title>Trends in alternative medicine use in the United States, 1990&#x02013;1997: results of a follow-up national survey</article-title><source>JAMA</source><year>1998</year><volume>280</volume><fpage>1569</fpage><lpage>1575</lpage><pub-id pub-id-type="pmid">9820257</pub-id><pub-id pub-id-type="doi">10.1001/jama.280.18.1569</pub-id></citation></ref></ref-list></back></article>