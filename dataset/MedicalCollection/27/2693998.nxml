NaCl</td><td align="left" rowspan="1" colspan="1">Purified water</td><td align="left" rowspan="1" colspan="1">1.4% polyvinyl alcohol</td><td align="left" rowspan="1" colspan="1">260&#x02013;330 mOsm/kg</td></tr><tr><td align="left" rowspan="1" colspan="1">Nevanac<sup>&#x000ae;</sup></td><td align="left" rowspan="1" colspan="1">Nepafenac 0.1%</td><td align="left" rowspan="1" colspan="1">Tyloxapol</td><td align="left" rowspan="1" colspan="1">Carbomer 974P</td><td align="left" rowspan="1" colspan="1">Benzalkonium chloride 0.005%</td><td align="left" rowspan="1" colspan="1">EDTA</td><td align="left" rowspan="1" colspan="1">NaOH or HCL</td><td align="left" rowspan="1" colspan="1">Mannitol</td><td align="left" rowspan="1" colspan="1">Purified water</td><td align="left" rowspan="1" colspan="1">None</td><td align="left" rowspan="1" colspan="1">305 mOsm/kg</td></tr><tr><td align="left" rowspan="1" colspan="1">Xibrom<sup>&#x000ae;</sup></td><td align="left" rowspan="1" colspan="1">Bromfenac 0.09%</td><td align="left" rowspan="1" colspan="1">Polysorbate 80</td><td align="left" rowspan="1" colspan="1">Boric acid</td><td align="left" rowspan="1" colspan="1">Benzalkonium chloride 0.005%</td><td align="left" rowspan="1" colspan="1">EDTA</td><td align="left" rowspan="1" colspan="1">NaOH</td><td align="left" rowspan="1" colspan="1">None</td><td align="left" rowspan="1" colspan="1">Purified water</td><td align="left" rowspan="1" colspan="1">povidone</td><td align="left" rowspan="1" colspan="1">Sodium sulfite anhydrous 2 mg/mL, 300 mOsm/kg</td></tr><tr><td align="left" rowspan="1" colspan="1">Indocid<sup>&#x000ae;</sup> (not marketed in the US)</td><td align="left" rowspan="1" colspan="1">Indomethacin 1%</td><td align="left" rowspan="1" colspan="1">Polysorbate 80</td><td align="left" rowspan="1" colspan="1">None</td><td align="left" rowspan="1" colspan="1">Benzalkonium chloride</td><td align="left" rowspan="1" colspan="1">EDTA</td><td align="left" rowspan="1" colspan="1">None</td><td 