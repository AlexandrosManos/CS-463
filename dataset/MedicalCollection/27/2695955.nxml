ic><sub>2</sub></td><td align="left" rowspan="1" colspan="1"><italic>y</italic><sub><italic>i</italic></sub> = <italic>&#x003b2;</italic><sub><italic>j</italic>1</sub> + <italic>&#x003b2;</italic><sub><italic>j</italic>2</sub><italic>f</italic><sub><italic>i</italic></sub> + <italic>&#x003b2;</italic><sub><italic>j</italic>3</sub><italic>f</italic><sub><italic>i</italic></sub><sup>2</sup> + <italic>&#x003f5;</italic><sub><italic>ji</italic></sub>, </td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>t</bold> = (<italic>t</italic><sub>1</sub>,&#x02026;, <italic>t</italic><sub><italic>k</italic>&#x02212;1</sub>)</td></tr><tr><td align="center" colspan="2" rowspan="1"><hr/></td></tr><tr><td align="left" rowspan="2" colspan="1"><italic>m</italic><sub>3</sub></td><td align="left" rowspan="1" colspan="1"><italic>y</italic><sub><italic>i</italic></sub> = <italic>&#x003b2;</italic><sub><italic>j</italic>1</sub> + <italic>&#x003b2;</italic><sub><italic>j</italic>2</sub><italic>f</italic><sub><italic>i</italic></sub> + <italic>&#x003b2;</italic><sub><italic>j</italic>3</sub><italic>f</italic><sub><italic>i</italic></sub><sup>2</sup> + <italic>&#x003b2;</italic><sub><italic>j</italic>4</sub><italic>f</italic><sub><italic>i</italic></sub><sup>3</sup> + <italic>&#x003f5;</italic><sub><italic>ji</italic></sub>, </td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>t</bold> = (<italic>t</italic><sub>1</sub>,&#x02026;, <italic>t</italic><sub><italic>k</italic>&#x02212;1</sub>)</td></tr><tr><td align="center" colspan="2" rowspan="1"><hr/></td></tr><tr><td align="left" rowspan="2" colspan="1"><italic>m</italic><sub>4</sub></td><td align="left" rowspan="1" colspan="1"><italic>y</italic><sub><italic>i</italic></sub> = <italic>&#x003b2;</italic><sub><italic>j</italic>1</sub> + <italic>&#x003b2;</italic><sub><italic>j</italic>2</sub><italic>f</italic><sub><italic>i</italic></sub> + <italic>&#x003b2;</italic><sub><italic>j</italic>3</sub><italic>f</italic><sub><italic>i</it