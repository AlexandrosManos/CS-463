icle-title>Intraductal papillary tumors of the pancreas: evaluation with magnetic resonance cholangiopancreatography</article-title><source>Am J Gastroenterol</source><year>1998</year><volume>93</volume><fpage>156</fpage><lpage>159</lpage><pub-id pub-id-type="pmid">9468232</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Koito</surname><given-names>K</given-names></name><name><surname>Namieno</surname><given-names>T</given-names></name><name><surname>Ichimura</surname><given-names>T</given-names></name><etal/></person-group><article-title>Mucin-producing pancreatic tumors: comparison of MR cholangiopancreatography with endoscopic retrograde cholangiopancreatography</article-title><source>Radiology</source><year>1998</year><volume>208</volume><fpage>231</fpage><lpage>237</lpage><pub-id pub-id-type="pmid">9646818</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Onaya</surname><given-names>H</given-names></name><name><surname>Itai</surname><given-names>Y</given-names></name><name><surname>Niitsu</surname><given-names>M</given-names></name><name><surname>Chiba</surname><given-names>T</given-names></name><name><surname>Michishita</surname><given-names>N</given-names></name><name><surname>Saida</surname><given-names>Y</given-names></name></person-group><article-title>Ductectatic mucinous cystic neoplasm of the pancreas: evaluation with MR cholangiopancreatography</article-title><source>AJR Am J Roentgenol</source><year>1998</year><volume>171</volume><fpage>171</fpage><lpage>177</lpage><pub-id pub-id-type="pmid">9648782</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Fukukura</surname><given-names>Y</given-names></name><name><surnam