nt Biosci</source><volume>13</volume><fpage>302</fpage><lpage>311</lpage><pub-id pub-id-type="pmid">17981548</pub-id></citation></ref><ref id="pone.0005886-Kemi1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kemi</surname><given-names>OJ</given-names></name><name><surname>Ellingsen</surname><given-names>O</given-names></name><name><surname>Smith</surname><given-names>GL</given-names></name><name><surname>Wisloff</surname><given-names>U</given-names></name></person-group><year>2008</year><article-title>Exercise-induced changes in calcium handling in left ventricular cardiomyocytes.</article-title><source>Front Biosci</source><volume>13</volume><fpage>356</fpage><lpage>368</lpage><pub-id pub-id-type="pmid">17981553</pub-id></citation></ref><ref id="pone.0005886-Ascenso1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ascens&#x000e3;o</surname><given-names>A</given-names></name><name><surname>Ferreira</surname><given-names>R</given-names></name><name><surname>Magalh&#x000e3;es</surname><given-names>J</given-names></name></person-group><year>2007</year><article-title>Exercise-induced cardioprotection&#x02013;biochemical, morphological and functional evidence in whole tissue and isolated mitochondria.</article-title><source>Int J Cardiol</source><volume>117</volume><fpage>16</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">16860886</pub-id></citation></ref><ref id="pone.0005886-Bauman1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bauman</surname><given-names>AE</given-names></name></person-group><year>2004</year><article-title>Updating the evidence that physical activity is good for health: an epidemiological review.</article-title><source>J Sci Med Sport</source><volume>7</volume><fpage>6</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">15214597</pub-id></citation></ref><ref id="pone.0005886-Saraceni1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Saraceni</surname><given-names>C</given-names></name><name><surname>Broderick</surname><given-names>TL</given-names></name></person-group><year>2007</year><article-title>Cardiac and metabolic consequences of aerobic exercise training in experimental diabetes.</article-title><source>Curr Diabetes Rev</source><volume>3</volume><fpage>75</fpage><lpage>84</lpage><pub-id pub-id-type="pmid">18220658</pub-id></citation></ref><ref id="pone.0005886-Musi1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Musi</surname><given-names>N</given-names></name><name><surname>Hayashi</surname><given-names>T</given-names></name><name><surname>Fujii</surname><given-names>N</given-names></name><name><surname>Hirshman</surname><given-names>MF</given-names></name><name><surname>Witters</surname><given-names>LA</given-names></name><etal/></person-group><year>2001</year><article-title>AMP-activated protein kinase activity and glucose uptake in rat skeletal muscle.</article-title><source>Am J Physiol Endocrinol Metab</source><volume>280</volume><fpage>677</fpage><lpage>684</lpage></citation></ref><ref id="pone.0005886-Tunstall1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tunstall</surname><given-names>RJ</given-names></name><name><surname>Mehan</surname><given-names>KA</given-names></name><name><surname>Wadley</surname><given-names>GD</given-names></name><name><surname>Collier</surname><given-names>GR</given-names></name><name><surname>Bonen</surname><given-names>A</given-names></name><etal/></person-group><year>2002</year><article-title>Exercise training increases lipid metabolism gene expression in human skeletal muscle.</article-title><source>Am J Physiol Endocrinol Metab</source><volume>283</volume><fpage>E66</fpage><lpage>72</lpage><pub-id pub-