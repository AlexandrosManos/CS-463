s></name><name><surname>Dunne</surname><given-names>B</given-names></name><name><surname>Witton</surname><given-names>CJ</given-names></name><name><surname>Forsyth</surname><given-names>A</given-names></name><name><surname>Cooke</surname><given-names>TG</given-names></name><name><surname>Bartlett</surname><given-names>JM</given-names></name></person-group><article-title>Can molecular markers predict when to implement treatment with aromatase inhibitors in invasive breast cancer?</article-title><source>Clin Cancer Res</source><year>2005</year><volume>11</volume><fpage>4835</fpage><lpage>4842</lpage><pub-id pub-id-type="pmid">16000581</pub-id><pub-id pub-id-type="doi">10.1158/1078-0432.CCR-05-0196</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Witton</surname><given-names>CJ</given-names></name><name><surname>Reeves</surname><given-names>JR</given-names></name><name><surname>Going</surname><given-names>JJ</given-names></name><name><surname>Cooke</surname><given-names>TG</given-names></name><name><surname>Bartlett</surname><given-names>JM</given-names></name></person-group><article-title>Expression of the HER1&#x02013;4 family of receptor tyrosine kinases in breast cancer</article-title><source>J Pathol</source><year>2003</year><volume>200</volume><fpage>290</fpage><lpage>297</lpage><pub-id pub-id-type="pmid">12845624</pub-id><pub-id pub-id-type="doi">10.1002/path.1370</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Slamon</surname><given-names>DJ</given-names></name><name><surname>Clark</surname><given-names>GM</given-names></name><name><surname>Wong</surname><given-names>SG</given-names></name><name><surname>Levin</surname><given-names>WJ</given-names></name><name><surname>Ullrich</surname><given-names>A</given-names></name><name><surname>McGuire</surname><given-names>WL</given-names></name></person-group><ar