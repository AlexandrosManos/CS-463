-type="pmid">17681384</pub-id></element-citation></ref><ref id="R5"><label>5</label><element-citation publication-type="journal"><name><surname>Eckersall</surname><given-names>P.D.</given-names></name><name><surname>Young</surname><given-names>F.J.</given-names></name><name><surname>McComb</surname><given-names>C.</given-names></name><name><surname>Hogarth</surname><given-names>C.J.</given-names></name><name><surname>Safi</surname><given-names>S.</given-names></name><name><surname>Weber</surname><given-names>A.</given-names></name><etal/><article-title>Acute phase proteins in serum and milk from dairy cows with clinical mastitis</article-title><source>Vet. Rec.</source><year>2001</year><volume>148</volume><fpage>35</fpage><lpage>41</lpage><pub-id pub-id-type="pmid">11202551</pub-id></element-citation></ref><ref id="R6"><label>6</label><element-citation publication-type="journal"><name><surname>Eckersall</surname><given-names>P.D.</given-names></name><name><surname>Young</surname><given-names>F.J.</given-names></name><name><surname>Nolan</surname><given-names>A.M.</given-names></name><name><surname>Knight</surname><given-names>C.H.</given-names></name><name><surname>McComb</surname><given-names>C.</given-names></name><name><surname>Waterston</surname><given-names>M.M.</given-names></name><etal/><article-title>Acute phase proteins in bovine milk in an experimental model of <italic>Staphylococcus aureus</italic> subclinical mastitis</article-title><source>J. Dairy Sci.</source><year>2006</year><volume>89</volume><fpage>1488</fpage><lpage>1501</lpage><pub-id pub-id-type="pmid">16606719</pub-id></element-citation></ref><ref id="R7"><label>7</label><element-citation publication-type="journal"><name><surname>Gervois</surname><given-names>P.</given-names></name><name><surname>Kleemann</surname><given-names>R.</given-names></name><name><surname>Pilon</surname><given-names>A.</given-names></name><name><surname>Percevault</surname><given-names>F.</given-names></name><name><surname>Koenig</surname><given-names>W.</given-names></name><name><surname>Staels</surname><given-names>B.</given-names></name><name><surname>Kooistra</surname><given-names>T.</given-names></name><article-title>Global suppression of IL-6-induced acute phase response gene expression after chronic in vivo treatment with the peroxisome proliferator-activated receptor-&#x003b1; activator fenofibrate</article-title><source>J. Biol. Chem.</source><year>2004</year><volume>279</volume><fpage>16154</fpage><lpage>16160</lpage><pub-id pub-id-type="pmid">14764586</pub-id></element-citation></ref><ref id="R8"><label>8</label><element-citation publication-type="journal"><name><surname>Gr&#x000f6;nlund</surname><given-names>U.</given-names></name><name><surname>Hall&#x000e9;n Sandgren</surname><given-names>C.</given-names></name><name><surname>Persson Waller</surname><given-names>K.</given-names></name><article-title>Haptoglobin and serum amyloid A in milk from dairy cows with chronic sub-clinical mastitis</article-title><source>Vet. Res.</source><year>2005</year><volume>36</volume><fpage>191</fpage><lpage>198</lpage><pub-id pub-id-type="pmid">15720972</pub-id></element-citation></ref><ref id="R9"><label>9</label><element-citation publication-type="journal"><name><surname>Hiss</surname><given-names>S.</given-names></name><name><surname>Mielenz</surname><given-names>M.</given-names></name><name><surname>Bruckmaier</surname><given-names>R.M.</given-names></name><name><surname>Sauerwein</surname><given-names>H.</given-names></name><article-title>Haptoglobin concentrations in blood and milk after endotoxin challenge and quantification of mammary Hp mRNA expression</article-title><source>J. Dairy Sci.</source><year>2004</year><volume>87</volume><fpage>3778</fpage><lpage>3784</lpage><pub-id pub-id-type="pmid">15483161</pub-id></element-citation></ref><ref id="R10"><label>10</label><element-citation publication-type="journal"><name><surname>Huynh</surname><given-names>H.T.</given-names></na