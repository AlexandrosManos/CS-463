><given-names>D</given-names></name><name><surname>Cripe</surname><given-names>L</given-names></name><name><surname>Turek</surname><given-names>LP</given-names></name><article-title>Perinatal transmission and maternal risks of human papillomavirus infection</article-title><source>Cancer Detect Prev</source><year>1995</year><volume>19</volume><fpage>196</fpage><lpage>205</lpage><pub-id pub-id-type="pmid">7750107</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><name><surname>Smith</surname><given-names>EM</given-names></name><name><surname>Johnson</surname><given-names>SR</given-names></name><name><surname>Cripe</surname><given-names>TP</given-names></name><name><surname>Pignatari</surname><given-names>S</given-names></name><name><surname>Turek</surname><given-names>L</given-names></name><article-title>Perinatal vertical transmission of human papillomavirus and subsequent development of respiratory tract papillomatosis</article-title><source>Ann Otol Rhinol Laryngol</source><year>1991</year><volume>100</volume><fpage>479</fpage><lpage>483</lpage><pub-id pub-id-type="pmid">1647745</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Watts</surname><given-names>DH</given-names></name><name><surname>Koutsky</surname><given-names>LA</given-names></name><name><surname>Holmes</surname><given-names>KK</given-names></name><name><surname>Goldman</surname><given-names>D</given-names></name><name><surname>Kuypers</surname><given-names>J</given-names></name><name><surname>Kiviat</surname><given-names>NB</given-names></name><name><surname>Galloway</surname><given-names>DA</given-names></name><article-title>Low risk of perinatal transmission of human papillomavirus: results from a prospective cohort study</article-title><source>Am J Obstet Gynecol</source><year>1998</year><volume>178</volume><fpage>365</fpage><lpage>373</lpage><pub-id pub-id-type="doi">10.1016/S0002-9378(98)80027-6</pub-id><pu