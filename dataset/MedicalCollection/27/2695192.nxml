1">164.8 (9.2)</td><td valign="top" align="left" rowspan="1" colspan="1">0.849</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><bold>Gender</bold>: Male N (%)</td><td valign="top" align="left" rowspan="1" colspan="1">16 (64)</td><td valign="top" align="left" rowspan="1" colspan="1">23 (79)</td><td valign="top" align="left" rowspan="1" colspan="1">0.218</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><bold>Ethnicity</bold> N (%)<xref ref-type="table-fn" rid="tfn2-copd-2-313">*</xref></td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1">0.061</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">&#x02003;&#x02003;East Indians (Indo-Trinidadian)</td><td valign="top" align="left" rowspan="1" colspan="1">9 (36)</td><td valign="top" align="left" rowspan="1" colspan="1">16 (55)</td><td valign="top" align="left" rowspan="1" colspan="1"/></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">&#x02003;&#x02003;African (Afro-Trinidadian)</td><td valign="top" align="left" rowspan="1" colspan="1">8 (32)</td><td valign="top" align="left" rowspan="1" colspan="1">10 (35)</td><td valign="top" align="left" rowspan="1" colspan="1"/></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Other</td><td valign="top" align="left" rowspan="1" colspan="1">8 (32)</td><td valign="top" align="left" rowspan="1" colspan="1">3 (10)</td><td valign="top" align="left" rowspan="1" colspan="1"/></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><bold>BMI</bold> kg/m<sup>2</sup> (median (IQR)</td><td valign="top" align="left" rowspan="1" colspan="1">27.4 (25.9, 29.9)</td><td valign="top" align="left" rowspan="1" colspan="1">24.0 (20.5, 27.0)</td><td valign="top" align="left" rowspan="1" colspan="1">0.001</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><bold>Lung Function</bold> (mean (SD))</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">FEV<sub>1</sub>/L</td><td valign="top" align="left" rowspan="1" colspan="1">2.25 (0.77)</td><td valign="top" align="left" rowspan="1" colspan="1">1.43 (0.60)</td><td valign="top" align="left" rowspan="1" colspan="1">&#x0003c;0.001</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">FVC/L</td><td valign="top" align="left" rowspan="1" colspan="1">2.91 (1.02)</td><td valign="top" align="left" rowspan="1" colspan="1">2.72 (0.82)</td><td valign="top" align="left" rowspan="1" colspan="1">0.18</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">FEV<sub>1</sub>/FVC %</td><td valign="top" align="left" rowspan="1" colspan="1">78.1 (8.3)</td><td valign="top" align="left" rowspan="1" colspan="1">53.1 (14.0)</td><td valign="top" align="left" rowspan="1" colspan="1">&#x0003c;0.001</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">FEV<sub>1</sub> % predicted</td><td valign="top" align="left" rowspan="1" colspan="1">76.1 (17.2)</td><td valign="top" align="left" rowspan="1" colspan="1">49.1 (16.3)</td><td valign="top" align="left" rowspan="1" colspan="1">&#x0003c;0.001</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"><bold>SGRQ Scores</bold> (median (IQR))</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Impact</td><td valign="top" align="left" rowspan="1" colspan="1">0.0 (0.0, 0.0)</td><td valign="top" align="left" rowspan="1" colspan="1">35.7 (10.0, 50.8)</td><td valign="top" align="left" rowspan="1" colspan="1">&#x0003c;0.001</td></tr><tr><td valign="top" align="left" rowspan="