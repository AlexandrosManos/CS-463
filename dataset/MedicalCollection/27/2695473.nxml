0"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mackenbach</surname><given-names>JP</given-names></name><name><surname>Kunst</surname><given-names>AE</given-names></name></person-group><article-title>Measuring the magnitude of socio-economic inequalities in health: An overview of available measures illustrated with two examples from Europe</article-title><source>Soc Sci &#x00026; Med</source><year>1997</year><volume>44</volume><fpage>757</fpage><lpage>771</lpage><pub-id pub-id-type="pmid">9080560</pub-id><pub-id pub-id-type="doi">10.1016/S0277-9536(96)00073-1</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McKenzie</surname><given-names>D</given-names></name></person-group><article-title>Measuring inequality with asset indicators</article-title><source>J Pop Economics</source><year>2005</year><volume>18</volume><fpage>229</fpage><lpage>260</lpage><pub-id pub-id-type="doi">10.1007/s00148-005-0224-7</pub-id></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Matovu</surname><given-names>F</given-names></name></person-group><source>Equity in malaria treatment and prevention: an analysis of the socioeconomic dimension in tanga district, Tanzania</source><year>2008</year><publisher-name>PhD thesis. University of London, London School of Hygiene and Tropical Medicine</publisher-name></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Noor</surname><given-names>AM</given-names></name><name><surname>Omumbo</surname><given-names>JA</given-names></name><name><surname>Amin</surname><given-names>AA</given-names></name><name><surname>Zurovac</surname><given-names>D</given-names></name><name><surname>Snow</surname><given-names>RW</given-names></name></person-group><article-title>Wealth, mother's education and physical acces