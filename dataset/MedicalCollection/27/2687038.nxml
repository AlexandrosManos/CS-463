volume>15</volume>:<fpage>802</fpage>&#x02013;<lpage>5</lpage> <pub-id pub-id-type="doi">10.3201/eid1505.081084</pub-id><pub-id pub-id-type="pmid">19402975</pub-id></citation></ref><ref id="R11"><label>11. </label><citation citation-type="journal"><string-name><surname>Songer</surname> <given-names>JG</given-names></string-name>, <string-name><surname>Trinh</surname> <given-names>HT</given-names></string-name>, <string-name><surname>Killgore</surname> <given-names>GE</given-names></string-name>, <string-name><surname>Thompson</surname> <given-names>AD</given-names></string-name>, <string-name><surname>McDonald</surname> <given-names>LC</given-names></string-name>, <string-name><surname>Limbago</surname> <given-names>BM</given-names></string-name> <article-title><italic>Clostridum difficile</italic> in retail meat products, USA, 2007.</article-title><source>Emerg Infect Dis</source> <year>2009</year>;<volume>15</volume>:<fpage>819</fpage>&#x02013;<lpage>21</lpage> <pub-id pub-id-type="doi">10.3201/eid1505.081071</pub-id><pub-id pub-id-type="pmid">19402980</pub-id></citation></ref><ref id="R12"><label>12. </label><citation citation-type="web">The seed salon: Alexis Rockman + Neil deGrasse Tyson [cited 2009 Apr 10]. Available from <ext-link ext-link-type="uri" xlink:href="http://seedmagazine.com/content/print/the_seed_salon_alexis_rockman_neil_degrass_ty">http://seedmagazine.com/content/print/the_seed_salon_alexis_rockman_neil_degrass_ty</ext-link></citation></ref></ref-list></back></article>