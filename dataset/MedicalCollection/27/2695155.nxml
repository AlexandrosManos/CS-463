</person-group><article-title>The primate striatum: neuronal activity in relation to spatial attention versus motor preparation</article-title><source>Eur. J. Neurosci.</source><year>1997</year><volume>9</volume><fpage>2152</fpage><lpage>2168</lpage><pub-id pub-id-type="pmid">9421175</pub-id></citation></ref><ref id="b10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brucke</surname><given-names>C</given-names></name><name><surname>Kupsch</surname><given-names>A</given-names></name><name><surname>Schneider</surname><given-names>GH</given-names></name><name><surname>Hariz</surname><given-names>MI</given-names></name><name><surname>Nuttin</surname><given-names>B</given-names></name><name><surname>Kopp</surname><given-names>U</given-names></name><name><surname>Kempf</surname><given-names>F</given-names></name><name><surname>Trottenberg</surname><given-names>T</given-names></name><name><surname>Doyle</surname><given-names>L</given-names></name><name><surname>Chen</surname><given-names>CC</given-names></name><name><surname>Yarrow</surname><given-names>K</given-names></name><name><surname>Brown</surname><given-names>P</given-names></name><name><surname>Kuhn</surname><given-names>AA</given-names></name></person-group><article-title>The subthalamic region is activated during valence-related emotional processing in patients with Parkinson&#x02019;s disease</article-title><source>Eur. J. Neurosci.</source><year>2007</year><volume>26</volume><fpage>767</fpage><lpage>774</lpage><pub-id pub-id-type="pmid">17686048</pub-id></citation></ref><ref id="b11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cassidy</surname><given-names>M</given-names></name><name><surname>Mazzone</surname><given-names>P</given-names></name><name><surname>Oliviero</surname><given-names>A</given-names></name><name><surname>Insola</surname><given-names>A</given-names></name><name><surname>Tonali</surname><given-names>P</