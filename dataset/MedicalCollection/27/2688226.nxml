n-group-type="author"><name><surname>Pahl</surname><given-names>HL</given-names></name></person-group><article-title>Activators and target genes of Rel/NF-&#x003ba;B transcription factors</article-title><source>Oncogene</source><year>1999</year><volume>18</volume><fpage>6853</fpage><lpage>6866</lpage><pub-id pub-id-type="pmid">10602461</pub-id><pub-id pub-id-type="doi">10.1038/sj.onc.1203239</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moynagh</surname><given-names>PN</given-names></name></person-group><article-title>The NF-&#x003ba;B pathway</article-title><source>J Cell Sci</source><year>2005</year><volume>118</volume><issue>Pt 20</issue><fpage>4589</fpage><lpage>4592</lpage><pub-id pub-id-type="pmid">16219681</pub-id><pub-id pub-id-type="doi">10.1242/jcs.02579</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cummins</surname><given-names>EP</given-names></name><name><surname>Berra</surname><given-names>E</given-names></name><name><surname>Comerford</surname><given-names>KM</given-names></name><name><surname>Fitzgerald</surname><given-names>KT</given-names></name><name><surname>Seeballuck</surname><given-names>F</given-names></name><name><surname>Godson</surname><given-names>C</given-names></name><name><surname>Nielsen</surname><given-names>JE</given-names></name><name><surname>Moynagh</surname><given-names>P</given-names></name><name><surname>Pouyssegur</surname><given-names>J</given-names></name><name><surname>Taylor</surname><given-names>CT</given-names></name></person-group><article-title>Prolyl hydroxylase-1 negatively regulates IkB kinase-&#x003b2; giving insight into hypoxia-induced NFkB activity</article-title><source>Proc Natl Acad Sci USA</source><year>2006</year><volume>103</volume><fpage>18154</fpage><lpage>18159</lpage><pub-id pub-id-type="pmid">17114296</pub-id><pub-id pub-id-type="doi">10.1073/pnas.0602235103</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koong</surname><given-names>AC</given-names></name><name><surname>Chen</surname><given-names>EY</given-names></name><name><surname>Giaccia</surname><given-names>AJ</given-names></name></person-group><article-title>Hypoxia causes the activation of nuclear factor &#x003ba;B through the phosphorylation of I&#x003ba;B&#x003b1; on tyrosine residues</article-title><source>Cancer Res</source><year>1994</year><volume>54</volume><fpage>1425</fpage><lpage>1430</lpage><pub-id pub-id-type="pmid">8137243</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rius</surname><given-names>J</given-names></name><name><surname>Guma</surname><given-names>M</given-names></name><name><surname>Schachtrup</surname><given-names>C</given-names></name><name><surname>Akassoglou</surname><given-names>K</given-names></name><name><surname>Zinkernagel</surname><given-names>AS</given-names></name><name><surname>Nizet</surname><given-names>V</given-names></name><name><surname>Johnson</surname><given-names>RS</given-names></name><name><surname>Haddad</surname><given-names>GG</given-names></name><name><surname>Karin</surname><given-names>M</given-names></name></person-group><article-title>NF-&#x003ba;B links innate immunity to the hypoxic response through transcriptional regulation of HIF-1&#x003b1;</article-title><source>Nature</source><year>2008</year><volume>453</volume><fpage>807</fpage><lpage>811</lpage><pub-id pub-id-type="pmid">18432192</pub-id><pub-id pub-id-type="doi">10.1038/nature06905</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>N</given-names></name><name><surname>Karin</surname><given-names>M</given-names></name></person-group><article-title>Ionizing radiation