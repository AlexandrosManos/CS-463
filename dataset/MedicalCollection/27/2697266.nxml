rname>Williams</surname><given-names>MA</given-names></name><name><surname>Spronk</surname><given-names>CA</given-names></name><name><surname>Bonvin</surname><given-names>AM</given-names></name><name><surname>Nilges</surname><given-names>M</given-names></name></person-group><article-title>Refinement of protein structures in explicit solvent</article-title><source>Proteins</source><year>2003</year><volume>50</volume><fpage>496</fpage><lpage>506</lpage><pub-id pub-id-type="pmid">12557191</pub-id></citation></ref><ref id="R52"><label>52</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Laskowski</surname><given-names>RA</given-names></name><name><surname>Rullmannn</surname><given-names>JA</given-names></name><name><surname>MacArthur</surname><given-names>MW</given-names></name><name><surname>Kaptein</surname><given-names>R</given-names></name><name><surname>Thornton</surname><given-names>JM</given-names></name></person-group><article-title>AQUA and PROCHECK-NMR: programs for checking the quality of protein structures solved by NMR</article-title><source>J Biomol NMR</source><year>1996</year><volume>8</volume><fpage>477</fpage><lpage>86</lpage><pub-id pub-id-type="pmid">9008363</pub-id></citation></ref><ref id="R53"><label>53</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>LK</given-names></name><name><surname>Rance</surname><given-names>M</given-names></name><name><surname>Chazin</surname><given-names>WJ</given-names></name><name><surname>Palmer</surname><given-names>AG</given-names><suffix>3rd</suffix></name></person-group><article-title>Rotational diffusion anisotropy of proteins from simultaneous analysis of 15N and 13C alpha nuclear spin relaxation</article-title><source>J Biomol NMR</source><year>1997</year><volume>9</volume><fpage>287</fpage><lpage>98</lpage><pub-id pub-id-type="pmid">9204557</pub-id></citation></ref></ref-list></sec></app></a