<floats-group><table-wrap id="t1-copd-2-471" position="float"><label>Table 1</label><caption><p>Absolute contraindications for NIV</p></caption><table frame="hsides" rules="groups"><tbody><tr><td valign="top" align="left" rowspan="1" colspan="1">Cardiac or respiratory arrest</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Severe encephalopathy</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Severe gastrointestinal bleeding</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Severe haemodynamic instability with or without unstable cardiac angina</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Facial surgery or trauma</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Upper airway obstruction</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Inability to protect the airway and/or high risk of aspiration</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Inability to clear secretions</td></tr></tbody></table></table-wrap></floats-group></article>