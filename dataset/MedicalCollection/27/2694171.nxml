/citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nkwi</surname><given-names>PN</given-names></name></person-group><article-title>Perceptions and treatment of diarrhoeal disease in Cameroon</article-title><source>Journal of Diarrhoeal Disease Research</source><year>1994</year><volume>12</volume><fpage>35</fpage><lpage>41</lpage></citation></ref><ref id="B11"><citation citation-type="other"><article-title>ASSA2003 AIDS and Demographic Model</article-title><ext-link ext-link-type="uri" xlink:href="http://www.actuarialsociety.org.za/Aids_Model-269.aspx"/></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><collab>WHO</collab></person-group><source>Global Tuberculosis Control: Country profile for South Africa</source><year>2007</year><publisher-name>Geneva: World Health Organisation</publisher-name></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goudge</surname><given-names>J</given-names></name><name><surname>Gilson</surname><given-names>L</given-names></name><name><surname>Russell</surname><given-names>S</given-names></name><name><surname>Gumede</surname><given-names>T</given-names></name><name><surname>Mills</surname><given-names>A</given-names></name></person-group><article-title>The household costs of illness in rural South Africa with free public primary care and hospital exemptions for the poor</article-title><source>Journal of Tropical Medicine and International Health</source><year>2009</year><volume>14</volume><fpage>458</fpage><lpage>467</lpage><pub-id pub-id-type="doi">10.1111/j.1365-3156.2009.02256.x</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goudge</surname><given-names>J</given-names></name><name><surname>Russell</surname><given-names>S</given-names></name><name><surname>Gilson</surname><given-names>L</given-names></name><name><surname>Gumede</surname><given-names>T</given-names></name><name><surname>Tollman</surname><given-names>S</given-names></name><name><surname>Mills</surname><given-names>A</given-names></name></person-group><article-title>Illness related impoverishment in rural South Africa: why does social protection work for some households but not others?</article-title><source>Journal for International Development</source><year>2009</year><volume>21</volume><fpage>231</fpage><lpage>251</lpage><pub-id pub-id-type="doi">10.1002/jid.1550</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kahn</surname><given-names>K</given-names></name><name><surname>Graenne</surname><given-names>M</given-names></name><name><surname>Collinson</surname><given-names>MA</given-names></name><name><surname>Tollman</surname><given-names>SM</given-names></name></person-group><article-title>Mortality trends in a new South Africa: Hard to make a fresh start</article-title><source>Scandanvian Journal of Public Health</source><year>2007</year><volume>35</volume><fpage>26</fpage><lpage>34</lpage><pub-id pub-id-type="doi">10.1080/14034950701355668</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bebbington</surname><given-names>A</given-names></name></person-group><article-title>Capitals and capabilities: A framework for analyzing peasant viability, rural livelihoods and poverty</article-title><source>World Development</source><year>1999</year><volume>27</volume><fpage>2021</fpage><lpage>2044</lpage><pub-id pub-id-type="doi">10.1016/S0305-750X(99)00104-7</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Seeley</surname><given-names>J</given-names></name><name><surname>Biraro</surname><given-names>S</given-names></name><name><surname>Shafer</surname><given-names>LA</given-names></name><name><surname>Nasirumbi</surname><given-names>P</given-names></name><name><surname>Foster</surname><given-names>S</given-names></name><name><surname>Whitworth</surname><given-names>J</given-names></name><name><surname>Grosskurth</surname><given-names>H</given-names></name></person-group><article-title>Using in-depth qualitative data to enhance our understanding of quantitative resutls regarding the impact of HIV and AIDS on households in rural Ugana</article-title><source>Social Science and Medicine</source><year>2008</year><volume>67</volume><fpage>1434</fpage><lpage>1446</lpage><pub-id pub-id-type="pmid">18701204</pub-id><pub-id pub-id-type="doi">10.1016/j.socscimed.2008.07.001</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coast</surname><given-names>J</given-names></name></person-group><article-title>The appropriate use of qualitative methods in health economics</article-title><source>Health Economics</source><year>1999</year><volume>8</volume><fpage>345</fpage><lpage>353</lpage><pub-id pub-id-type="pmid">10398527</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1099-1050(199906)8:4&#x0003c;345::AID-HEC432&#x0003e;3.0.CO;2-Q</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mitchell</surname><given-names>JC</given-names></name></person-group><article-title>Case and situation analysis</article-title><source>Sociological Review</source><year>1983</year><volume>31</volume><fpage>187</fpage><lpage>211</lpage></citation></ref><ref id="B20"><citation citation-type="other"><person-group person-group-type="author"><collab>Republic of South Africa</collab></person-group><article-title>UNGASS Country Progress Report</article-title><source>Pretoria</source><year>2008</year></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-grou