r>2002</year><article-title>Fundus photography for measurement of macular pigment density distribution in children</article-title><source>Invest Ophthalmol Vis Sci</source><volume>43</volume><fpage>1450</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">11980860</pub-id></mixed-citation></ref><ref id="b11-opth-1-25"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>AM</given-names></name></person-group><year>1990</year><article-title>Development of visual sensitivity to light and color vision in human infants: A critical review</article-title><source>Vis Res</source><volume>30</volume><fpage>1159</fpage><lpage>88</lpage><pub-id pub-id-type="pmid">2205977</pub-id></mixed-citation></ref><ref id="b12-opth-1-25"><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>JL</given-names></name></person-group><year>1965</year><article-title>Flicker and intermittent stimulation</article-title><person-group person-group-type="editor"><name><surname>Graham</surname><given-names>CH</given-names></name></person-group><source>Vision and Visual Perception</source><volume>Vol 1</volume><publisher-loc>New York</publisher-loc><publisher-name>John Wiley and Sons</publisher-name><fpage>251</fpage><lpage>320</lpage></mixed-citation></ref><ref id="b13-opth-1-25"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Canfield</surname><given-names>L</given-names></name><name><surname>Clandinin</surname><given-names>M</given-names></name><name><surname>Davies</surname><given-names>D</given-names></name><etal/></person-group><year>2003</year><article-title>Multinational study of major breast milk carotenoids of healthy mothers</article-title><source>Eur J Nutr</source><volume>42</volume><fpage>133</fpage><lpage>41</lpage><pub-id pub-id-type="pmid">12811470</pub-id></mixed-citation></ref><ref id="b14-opth-1-25"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Canfield</surname><given-names>L</given-names></name><name><surname>Giuliano</surname><given-names>A</given-names></name><name><surname>Neilson</surname><given-names>E</given-names></name><etal/></person-group><year>1997</year><article-title>Beta-carotene in breast milk and serum is increased after a single beta-carotene dose</article-title><source>Am J Clin Nutr</source><volume>66</volume><fpage>52</fpage><lpage>61</lpage><pub-id pub-id-type="pmid">9209169</pub-id></mixed-citation></ref><ref id="b15-opth-1-25"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chan</surname><given-names>C</given-names></name><name><surname>Leung</surname><given-names>IYF</given-names></name><name><surname>Lam</surname><given-names>KW</given-names></name><etal/></person-group><year>1998</year><article-title>The occurrence of retinol and carotenoids in human subretinal fluid</article-title><source>Curr Eye Res</source><volume>17</volume><fpage>890</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">9746436</pub-id></mixed-citation></ref><ref id="b16-opth-1-25"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cook</surname><given-names>JE</given-names></name><name><surname>Becker</surname><given-names>DL</given-names></name></person-group><year>1995</year><article-title>Gap junctions in the vertebrate retina</article-title><source>Microsc Res Tech</source><volume>31</volume><fpage>408</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">8534902</pub-id></mixed-citation></ref><ref id="b17-opth-1-25"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Crabtree</surname><given-names>DV</given-names></name><name><surname>Ojima</surname><given-names>I</given-names></name><name><surname>Geng</surname><given-names>X</given-names></name><etal/></person-