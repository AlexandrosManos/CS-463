="left" rowspan="1" colspan="1">Fasting glycine (mg/dL)</td><td valign="top" align="center" rowspan="1" colspan="1">118&#x000b1;64</td><td valign="top" align="center" rowspan="1" colspan="1">136&#x000b1;70</td><td valign="top" align="center" rowspan="1" colspan="1">0,36</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">LDL-C (mg/dL)</td><td valign="top" align="center" rowspan="1" colspan="1">117&#x000b1;42</td><td valign="top" align="center" rowspan="1" colspan="1">125&#x000b1;46</td><td valign="top" align="center" rowspan="1" colspan="1">0,56</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">HDL-C (mg/dL)</td><td valign="top" align="center" rowspan="1" colspan="1">39&#x000b1;9</td><td valign="top" align="center" rowspan="1" colspan="1">41&#x000b1;14</td><td valign="top" align="center" rowspan="1" colspan="1">0,75</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">TG (mg/dL)</td><td valign="top" align="center" rowspan="1" colspan="1">123&#x000b1;47</td><td valign="top" align="center" rowspan="1" colspan="1">158&#x000b1;78</td><td valign="top" align="center" rowspan="1" colspan="1">0,11</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Serum creatinine (mg/dL)</td><td valign="top" align="center" rowspan="1" colspan="1">1.25&#x000b1;0.50</td><td valign="top" align="center" rowspan="1" colspan="1">1.13&#x000b1;0.35</td><td valign="top" align="center" rowspan="1" colspan="1">0,35</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Use of aspirin (yes/no)</td><td valign="top" align="center" rowspan="1" colspan="1">0/18</td><td valign="top" align="center" rowspan="1" colspan="1">33/24</td><td valign="top" align="center" rowspan="1" colspan="1">&#x0003c;0.001</td></tr></tbody></table><table-wrap-foot><fn id="tfn1-cln64_4p323"><p>Student&#x02019;s t test or Fisher exact test</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>