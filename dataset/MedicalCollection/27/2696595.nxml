ous, per unit)</italic></td><td align="left" rowspan="1" colspan="1"><italic>0.96</italic></td><td align="left" rowspan="1" colspan="1"><italic>1.03</italic></td><td align="left" rowspan="1" colspan="1"><italic>(0.94&#x02013;1.13)</italic></td><td align="left" rowspan="1" colspan="1"><italic>0.5</italic></td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"><italic>Date enrolled (continuous, per year)</italic></td><td align="left" rowspan="1" colspan="1"><italic>0.95</italic></td><td align="left" rowspan="1" colspan="1"><italic>0.96</italic></td><td align="left" rowspan="1" colspan="1"><italic>(0.82&#x02013;1.12)</italic></td><td align="left" rowspan="1" colspan="1"><italic>0.6</italic></td></tr><tr><td align="left" rowspan="1" colspan="1">Intermediate<xref ref-type="table-fn" rid="nt104">2</xref></td><td align="left" rowspan="1" colspan="1">Water source</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Tap</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">0.04</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Stand Pipe</td><td align="left" rowspan="1" colspan="1">1.0</td><td align="left" rowspan="1" colspan="1">1.0</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Bore Hole</td><td align="left" rowspan="1" colspan="1">1.08</td><td align="left" rowspan="1" colspan="1">1.15</td><td align="left" rowspan="1" colspan="1">(0.89&#x02013;1.48)</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" col