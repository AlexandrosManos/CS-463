e>Lancet Infect Dis</source><volume>7</volume><fpage>93</fpage><lpage>104</lpage><pub-id pub-id-type="pmid">17251080</pub-id></citation></ref><ref id="pntd.0000473-Brahmbhatt1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brahmbhatt</surname><given-names>H</given-names></name><name><surname>Sullivan</surname><given-names>D</given-names></name><name><surname>Kigozi</surname><given-names>G</given-names></name><name><surname>Askin</surname><given-names>F</given-names></name><name><surname>Wabwire-Mangen</surname><given-names>F</given-names></name><etal/></person-group><year>2008</year><article-title>Association of HIV and Malaria With Mother-to-Child Transmission, Birth Outcomes, and Child Mortality.</article-title><source>J Acquir Immune Defic Syndr</source><volume>47</volume><fpage>472</fpage><lpage>476</lpage><pub-id pub-id-type="pmid">18332766</pub-id></citation></ref><ref id="pntd.0000473-Gamble1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gamble</surname><given-names>C</given-names></name><name><surname>Ekwaru</surname><given-names>PJ</given-names></name><name><surname>Garner</surname><given-names>P</given-names></name><name><surname>ter Kuile</surname><given-names>FO</given-names></name></person-group><year>2007</year><article-title>Insecticide-treated nets for the prevention of malaria in pregnancy: a systematic review of randomised controlled trials.</article-title><source>PLoS Med</source><volume>4</volume><fpage>e107</fpage><comment>doi:10.1371/journal.pmed.0040107</comment><pub-id pub-id-type="pmid">17388668</pub-id></citation></ref><ref id="pntd.0000473-Menndez1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Men&#x000e9;ndez</surname><given-names>C</given-names></name><name><surname>D'Alessandro</surname><given-names>U</given-names></name><name><surname>ter Kuile</surname><given-names>FO</given-names></name></person-group><year>2007</year><article-title>Reducing the burden of malaria in pregnancy by preventive strategies.</article-title><source>Lancet Infect Dis</source><volume>7</volume><fpage>126</fpage><lpage>135</lpage><pub-id pub-id-type="pmid">17251083</pub-id></citation></ref><ref id="pntd.0000473-vanderPaal1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van der Paal</surname><given-names>L</given-names></name><name><surname>Shafer</surname><given-names>LA</given-names></name><name><surname>Mayanja</surname><given-names>BN</given-names></name><name><surname>Whitworth</surname><given-names>JA</given-names></name><name><surname>Grosskurth</surname><given-names>H</given-names></name></person-group><year>2007</year><article-title>Effect of pregnancy on HIV disease progression and survival among women in rural Uganda.</article-title><source>Trop Med Int Health</source><volume>12</volume><fpage>920</fpage><lpage>928</lpage><pub-id pub-id-type="pmid">17697086</pub-id></citation></ref><ref id="pntd.0000473-Mpairwe1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mpairwe</surname><given-names>H</given-names></name><name><surname>Muhangi</surname><given-names>L</given-names></name><name><surname>Namujju</surname><given-names>PB</given-names></name><name><surname>Kisitu</surname><given-names>A</given-names></name><name><surname>Tumusiime</surname><given-names>A</given-names></name><etal/></person-group><year>2005</year><article-title>HIV Risk Perception and Prevalence in a Program for Prevention of Mother-to-Child HIV Transmission.</article-title><source>J Acquir Immune Defic Syndr</source><volume>39</volume><fpage>354</fpage><lpage>358</lpage><pub-id pub-id-type="pmid">15980698</pub-id></citation></ref><ref id="pntd.0000473-Elliott1"><label>19</label><citation citation-type="journal"><person-group person-group-type="