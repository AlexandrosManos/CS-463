d pub-id-type="pmid">1989526</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cooper</surname><given-names>A. J.</given-names></name><name><surname>Kristal</surname><given-names>B. S.</given-names></name></person-group> (<year>1997</year>). <article-title>Multiple roles of glutathione in the central nervous system</article-title>. <source>Biol. Chem.</source><volume>378</volume>, <fpage>793</fpage>&#x02013;<lpage>802</lpage><pub-id pub-id-type="pmid">9377474</pub-id></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Deutsch</surname><given-names>J.</given-names></name></person-group> (<year>1984</year>). <article-title>Glucose-6-phosphate dehydrogenase</article-title>. In <source>Methods of Enzymatic Analysis</source>, <person-group person-group-type="editor"><name><surname>Bergmeyer</surname><given-names>H. U.</given-names></name><name><surname>Bergmeyer</surname><given-names>J.</given-names></name><name><surname>Gra&#x000df;l</surname><given-names>M.</given-names></name></person-group>, eds (<publisher-loc>Weinheim</publisher-loc>, <publisher-name>Verlag Chemie</publisher-name>), pp. <fpage>190</fpage>&#x02013;<lpage>197</lpage></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dringen</surname><given-names>R.</given-names></name></person-group> (<year>2000</year>). <article-title>Metabolism and functions of glutathione in brain</article-title>. <source>Prog. Neurobiol.</source><volume>62</volume>, <fpage>649</fpage>&#x02013;<lpage>671</lpage><pub-id pub-id-type="doi">10.1016/S0301-0082(99)00060-X</pub-id><pub-id pub-id-type="pmid">10880854</pub-id></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Dringen</surname><given-name