vity</article-title><source>Hum Gene Ther</source><year>1996</year><volume>7</volume><fpage>2157</fpage><lpage>2164</lpage><pub-id pub-id-type="pmid">8934229</pub-id><pub-id pub-id-type="doi">10.1089/hum.1996.7.17-2157</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Han</surname><given-names>X</given-names></name><name><surname>Kasahara</surname><given-names>N</given-names></name><name><surname>Kan</surname><given-names>YW</given-names></name></person-group><article-title>Ligand-directed retroviral targeting of human breast cancer cells</article-title><source>Proc Natl Acad Sci USA</source><year>1995</year><volume>92</volume><fpage>9747</fpage><lpage>9751</lpage><pub-id pub-id-type="pmid">7568210</pub-id><pub-id pub-id-type="doi">10.1073/pnas.92.21.9747</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kasahara</surname><given-names>N</given-names></name><name><surname>Dozy</surname><given-names>AM</given-names></name><name><surname>Kan</surname><given-names>YW</given-names></name></person-group><article-title>Tissue-specific targeting of retroviral vectors through ligand-receptor interactions</article-title><source>Science</source><year>1994</year><volume>266</volume><fpage>1373</fpage><lpage>1376</lpage><pub-id pub-id-type="pmid">7973726</pub-id><pub-id pub-id-type="doi">10.1126/science.7973726</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marin</surname><given-names>M</given-names></name><name><surname>Noel</surname><given-names>D</given-names></name><name><surname>Valsesia-Wittman</surname><given-names>S</given-names></name><name><surname>Brockly</surname><given-names>F</given-names></name><name><surname>Etienne-Julan</surname><given-names>M</given-names></name><name><surname>Russell</surname><given-names>S</given-names></name