pan="2" colspan="1">D6 (Guilt)</td><td valign="top" align="left" rowspan="1" colspan="1">r = &#x02212;0.25</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">p &#x0003c; 0.05</td></tr><tr><td valign="top" align="left" rowspan="2" colspan="1">D7 (Hopelessness)</td><td valign="top" align="left" rowspan="1" colspan="1">r = &#x02212;0.30</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">p &#x0003c; 0.05</td></tr><tr><td valign="top" align="left" rowspan="2" colspan="1">P4 (Psychological aspects)</td><td valign="top" align="left" rowspan="1" colspan="1">r = &#x02212;0.35</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">p &#x0003c; 0.005</td></tr></tbody></table><table-wrap-foot><fn id="tfn6-ndt-5-207"><p><bold>Notes:</bold> Negative correlations involving BMI with age and specific subscales. As the patient grows affected by the ED, a worse profile and a more negative BMI are noticed.</p></fn><fn id="tfn7-ndt-5-207"><p><bold>Abbreviations:</bold> BMI, body mass index; ED, eating disorder.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>