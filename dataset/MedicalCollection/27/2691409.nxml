mid">7783885</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bloch</surname><given-names>MH</given-names></name><name><surname>Leckman</surname><given-names>JF</given-names></name><name><surname>Zhu</surname><given-names>H</given-names></name><name><surname>Peterson</surname><given-names>BS</given-names></name></person-group><article-title>Caudate volumes in childhood predict symptom severity in adults with Tourette syndrome</article-title><source>Neurology</source><year>2005</year><volume>65</volume><fpage>1253</fpage><lpage>1258</lpage><pub-id pub-id-type="pmid">16247053</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Castellanos</surname><given-names>FX</given-names></name><name><surname>Giedd</surname><given-names>JN</given-names></name><name><surname>Hamburger</surname><given-names>SD</given-names></name><name><surname>Marsh</surname><given-names>WL</given-names></name><name><surname>Rapoport</surname><given-names>JL</given-names></name></person-group><article-title>Brain morphometry in Tourette's syndrome: the influence of comorbid attention-deficit/hyperactivity disorder</article-title><source>Neurology</source><year>1996</year><volume>47</volume><fpage>1581</fpage><lpage>1583</lpage><pub-id pub-id-type="pmid">8960751</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Peterson</surname><given-names>BS</given-names></name><name><surname>Leckman</surname><given-names>JF</given-names></name><name><surname>Tucker</surname><given-names>D</given-names></name><name><surname>Scahill</surname><given-names>L</given-names></name><name><surname>Staib</surname><given-names>L</given-names></name><name><surname>Zhang</surname><given-names>H</given-names></name><etal></etal></person-group><article-title>Preliminary findings of antistreptococc