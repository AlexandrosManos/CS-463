>Nature</source><volume>444</volume><fpage>567</fpage><lpage>573</lpage><pub-id pub-id-type="pmid">17136086</pub-id></citation></ref><ref id="pone.0005917-Pallen2"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pallen</surname><given-names>MJ</given-names></name><name><surname>Beatson</surname><given-names>SA</given-names></name><name><surname>Bailey</surname><given-names>CM</given-names></name></person-group><year>2005</year><article-title>Bioinformatics, genomics and evolution of non-flagellar type-III secretion systems: a Darwinian perpective.</article-title><source>FEMS Microbiol Rev</source><volume>29</volume><fpage>201</fpage><lpage>229</lpage><pub-id pub-id-type="pmid">15808742</pub-id></citation></ref><ref id="pone.0005917-Page1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Page</surname><given-names>AL</given-names></name><name><surname>Parsot</surname><given-names>C</given-names></name></person-group><year>2002</year><article-title>Chaperones of the type III secretion pathway: jacks of all trades.</article-title><source>Mol Microbiol</source><volume>46</volume><fpage>1</fpage><lpage>11</lpage><pub-id pub-id-type="pmid">12366826</pub-id></citation></ref><ref id="pone.0005917-PetnickiOcwieja1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Petnicki-Ocwieja</surname><given-names>T</given-names></name><name><surname>Schneider</surname><given-names>DJ</given-names></name><name><surname>Tam</surname><given-names>VC</given-names></name><name><surname>Chancey</surname><given-names>ST</given-names></name><name><surname>Shan</surname><given-names>L</given-names></name><etal/></person-group><year>2002</year><article-title>Genomewide identification of proteins secreted by the Hrp type III protein secretion system of <italic>Pseudomonas syringae</italic> pv. <italic>tomato</italic> DC3000.</ar