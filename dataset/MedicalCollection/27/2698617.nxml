Endosc</source><year>1991</year><volume>5</volume><fpage>20</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">1871670</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Welch</surname><given-names>JP</given-names></name></person-group><article-title>Smooth muscle tumors of the stomach</article-title><source>Am J Surg</source><year>1975</year><volume>130</volume><fpage>279</fpage><lpage>285</lpage><pub-id pub-id-type="pmid">1166915</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Weinstein</surname><given-names>WM</given-names></name></person-group><article-title>Mucosal biopsy techniques and interaction with the pathologist</article-title><source>Gastrointest Endosc Clin N Am</source><year>2000</year><volume>10</volume><fpage>555</fpage><lpage>572</lpage><pub-id pub-id-type="pmid">11036533</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gress</surname><given-names>F</given-names></name><name><surname>Schmitt</surname><given-names>C</given-names></name><name><surname>Savides</surname><given-names>T</given-names></name><etal/></person-group><article-title>Interobserver agreement for EUS in the evaluation and diagnosis of submucosal masses</article-title><source>Gastrointest Endosc</source><year>2001</year><volume>53</volume><fpage>71</fpage><lpage>76</lpage><pub-id pub-id-type="pmid">11154492</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>R&#x000f6;sch</surname><given-names>T</given-names></name><name><surname>Kapfer</surname><given-names>B</given-names></name><name><surname>Will</surname><given-names>U</given-names>