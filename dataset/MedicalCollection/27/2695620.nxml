fields</article-title><source>Electroencephalogr Clin Neurophysiol</source><year>1971</year><volume>31</volume><fpage>439</fpage><lpage>49</lpage><pub-id pub-id-type="pmid">4107798</pub-id></citation></ref><ref id="R109"><label>109</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Strik</surname><given-names>WK</given-names></name><name><surname>Lehmann</surname><given-names>D</given-names></name></person-group><article-title>Data-determined window size and space-oriented segmentation of spontaneous EEG map series</article-title><source>Electroencephalogr Clin Neurophysiol</source><year>1993</year><volume>87</volume><fpage>169</fpage><lpage>74</lpage><pub-id pub-id-type="pmid">7691547</pub-id></citation></ref><ref id="R110"><label>110</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pascual-Marqui</surname><given-names>R</given-names></name><name><surname>Michel</surname><given-names>C</given-names></name><name><surname>Lehmann</surname><given-names>D</given-names></name></person-group><article-title>Segmentation of brain electrical activity into microstates</article-title><source>IEEE Trans Biomed Eng</source><year>1995</year><volume>42</volume><fpage>658</fpage><lpage>65</lpage><pub-id pub-id-type="pmid">7622149</pub-id></citation></ref><ref id="R111"><label>111</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koenig</surname><given-names>T</given-names></name><name><surname>Lehmann</surname><given-names>D</given-names></name></person-group><article-title>Microstates in language-related brain potentials show noun-verb differences</article-title><source>Brain Lang</source><year>1996</year><volume>53</volume><fpage>169</fpage><lpage>82</lpage><pub-id pub-id-type="pmid">8726532</pub-id></citation></ref><ref id="R112"><label>112</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leh