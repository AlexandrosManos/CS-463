up><article-title>Functional analysis of the contribution of RhoA and RhoC GTPases to invasive breast carcinoma.</article-title><source>Cancer Res</source><year>2004</year><volume>64</volume><fpage>8694</fpage><lpage>8701</lpage><pub-id pub-id-type="pmid">15574779</pub-id><pub-id pub-id-type="doi">10.1158/0008-5472.CAN-04-2247</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sahai</surname><given-names>E</given-names></name><name><surname>Marshall</surname><given-names>CJ</given-names></name></person-group><article-title>Differing modes of tumour cell invasion have distinct requirements for Rho/ROCK signalling and extracellular proteolysis.</article-title><source>Nat Cell Biol</source><year>2003</year><volume>5</volume><fpage>711</fpage><lpage>719</lpage><pub-id pub-id-type="pmid">12844144</pub-id><pub-id pub-id-type="doi">10.1038/ncb1019</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wheeler</surname><given-names>AP</given-names></name><name><surname>Ridley</surname><given-names>AJ</given-names></name></person-group><article-title>RhoB affects macrophage adhesion, integrin expression and migration.</article-title><source>Exp Cell Res</source><year>2007</year><volume>313</volume><fpage>3505</fpage><lpage>3516</lpage><pub-id pub-id-type="pmid">17692842</pub-id><pub-id pub-id-type="doi">10.1016/j.yexcr.2007.07.014</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stoletov</surname><given-names>K</given-names></name><name><surname>Montel</surname><given-names>V</given-names></name><name><surname>Lester</surname><given-names>RD</given-names></name><name><surname>Gonias</surname><given-names>SL</given-names></name><name><surname>Klemke</surname><given-names>R</given-names></name></person-group><article-title>High-resolution imaging of t