lay-unstructured">Mahnken AH, Rohde D, Brkovic D, G&#x000fc;nther RW, Tacke JA (2005) Percutaneous radiofrequency ablation of renal cell carcinoma: preliminary results. Acta Radiol 46:208&#x02013;214 <pub-id pub-id-type="pmid">15902899</pub-id></citation></ref><ref id="CR17"><label>17.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Michaels</surname><given-names>MJ</given-names></name><name><surname>Rhee</surname><given-names>HK</given-names></name><name><surname>Mourtzinos</surname><given-names>AP</given-names></name><etal/></person-group><article-title>Incomplete renal tumor destruction using radio frequency interstitial ablation</article-title><source>J Urol</source><year>2002</year><volume>168</volume><fpage>2406</fpage><lpage>2410</lpage><pub-id pub-id-type="doi">10.1016/S0022-5347(05)64155-9</pub-id></citation><citation citation-type="display-unstructured">Michaels MJ, Rhee HK, Mourtzinos AP, et al. (2002) Incomplete renal tumor destruction using radio frequency interstitial ablation. J Urol 168:2406&#x02013;2410 <pub-id pub-id-type="pmid">12441927</pub-id></citation></ref><ref id="CR18"><label>18.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldberg</surname><given-names>SN</given-names></name><name><surname>Gazelle</surname><given-names>GS</given-names></name><name><surname>Compton</surname><given-names>CC</given-names></name><etal/></person-group><article-title>Treatment of intrahepatic malignancy with radiofrequency ablation: radiologic-pathologic correlation</article-title><source>Cancer</source><year>2000</year><volume>88</volume><issue>11</issue><fpage>2452</fpage><lpage>2463</lpage><pub-id pub-id-type="doi">10.1002/1097-0142(20000601)88:11&#x0003c;2452::AID-CNCR5&#x0003e;3.0.CO;2-3</pub-id></citation><citation citation-type="display-unstructured">Goldberg SN, Gazelle GS, Compton CC, et al. (2000) Treatment of intrahepatic malignancy with radiofrequency ablation: radiologic-pathologic correlation. Cancer 88(11):2452&#x02013;2463 <pub-id pub-id-type="pmid">10861420</pub-id></citation></ref><ref id="CR19"><label>19.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goethuys</surname><given-names>H</given-names></name><name><surname>Poppel</surname><given-names>H</given-names></name><name><surname>Oyen</surname><given-names>R</given-names></name><etal/></person-group><article-title>The case against fine-needle aspiration cytology for small solid kidney tumors</article-title><source>Eur Urol</source><year>1996</year><volume>29</volume><fpage>284</fpage><lpage>287</lpage></citation><citation citation-type="display-unstructured">Goethuys H, Van Poppel H, Oyen R, et al. (1996) The case against fine-needle aspiration cytology for small solid kidney tumors. Eur Urol 29:284&#x02013;287 <pub-id pub-id-type="pmid">8740032</pub-id></citation></ref><ref id="CR20"><label>20.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wood</surname><given-names>BJ</given-names></name><name><surname>Khan</surname><given-names>MA</given-names></name><name><surname>McGovern</surname><given-names>F</given-names></name><etal/></person-group><article-title>Imaging guided biopsy of renal masses: indications, accuracy and impact on clinical management</article-title><source>J Urol</source><year>1999</year><volume>161</volume><fpage>1470</fpage><lpage>1474</lpage><pub-id pub-id-type="doi">10.1016/S0022-5347(05)68929-X</pub-id></citation><citation citation-type="display-unstructured">Wood BJ, Khan MA, McGovern F, et al. (1999) Imaging guided biopsy of renal masses: indications, accuracy and impact on clinical management. J Urol 161:1470&#x02013;1474 <pub-id pub-id-type="pmid">10210375</pub-id></citation></ref><ref id="CR21"><label>21.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Silverman</surname><given-names>SG</given-names></name><name><surname>Gan</surname><given-names>YU</given-names></name><name><surname>Mortele</surname><given-names>KJ</given-names></name><etal/></person-group><article-title>Renal masses in the adult patient: the role of percutaneous biopsy</article-title><source>Radiology</source><year>2006</year><volume>240</volume><issue>1</issue><fpage>6</fpage><lpage>22</lpage><pub-id pub-id-type="doi">10.1148/radiol.2401050061</pub-id></citation><citation citation-type="display-unstructured">Silverman SG, Gan YU, Mortele KJ, et al. (2006) Renal masses in the adult patient: the role of percutaneous biopsy. Radiology 240(1):6&#x02013;22 <pub-id pub-id-type="pmid">16709793</pub-id></citation></ref><ref id="CR22"><label>22.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McDougal</surname><given-names>WS</given-names></name><name><surname>Gervais</surname><given-names>DA</given-names></name><name><surname>McGovern</surname><given-names>FJ</given-names></name><name><surname>Mueller</surname><given-names>PR</given-names></name></person-group><article-title>Long-term follow up of patients with renal cell carcinoma treated with radiofrequency ablation with curative intent</article-title><source>J Urol</source><year>2005</year><volume>174</volume><issue>1</issue><fpage>61</fpage><lpage>63</lpage><pub-id pub-id-type="doi">10.1097/01.ju.0000162046.45024.2b</pub-id></citation><citation citation-type="display-unstructured">McDougal WS, Gervais DA, McGovern FJ, Mueller PR (2005) Long-term follow up of patients with renal cell carcinoma treated with radiofrequency ablation with curative intent. J Urol 174(1):61&#x02013;63 <pub-id pub-id-type="pmid">15947578</pub-id></citation></ref></ref-list></back></article>