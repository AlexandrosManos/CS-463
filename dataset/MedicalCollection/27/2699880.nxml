char="(" rowspan="1" colspan="1">0.44 (0.27&#x02013;0.63)</td><td align="char" char="." rowspan="1" colspan="1">0.10</td></tr><tr><td align="left" rowspan="1" colspan="1">Female</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;Whole population</td><td align="char" char="&#x000b1;" rowspan="1" colspan="1">5.17 &#x000b1; 0.60</td><td align="char" char="." rowspan="1" colspan="1">1.00</td><td align="char" char="." rowspan="1" colspan="1">0.07</td><td align="char" char="." rowspan="1" colspan="1">1.00</td><td align="char" char="." rowspan="1" colspan="1">0.06</td><td align="char" char="." rowspan="1" colspan="1">1.00</td><td align="char" char="." rowspan="1" colspan="1">0.13</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;Highest risk group (5%) assessed by</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;All predictors</td><td align="char" char="&#x000b1;" rowspan="1" colspan="1">5.55 &#x000b1; 0.96</td><td align="char" char="(" rowspan="1" colspan="1">3.09 (2.36&#x02013;3.73)</td><td align="char" char="." rowspan="1" colspan="1">0.22</td><td align="char" char="(" rowspan="1" colspan="1">2.05 (1.37&#x02013;2.60)</td><td align="char" char="." rowspan="1" colspan="1">0.13</td><td align="char" char="(" rowspan="1" colspan="1">2.61 (2.10&#x02013;2.96)</td><td align="char" char="." rowspan="1" colspan="1">0.35</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#