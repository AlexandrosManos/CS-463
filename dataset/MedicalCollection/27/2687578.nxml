ame><surname>Verreet</surname><given-names>PR</given-names></name><name><surname>Borchard</surname><given-names>F</given-names></name><name><surname>St&#x000f6;ltzing</surname><given-names>H</given-names></name><name><surname>Thon</surname><given-names>K</given-names></name><name><surname>R&#x000f6;her</surname><given-names>HD</given-names></name></person-group><article-title>Status of gastrectomy in the multi-modality therapy concept of primary non-Hodgkin's lymphoma of the stomach</article-title><source>Langenbecks Arch Chir</source><year>1990</year><volume>375</volume><fpage>151</fpage><lpage>155</lpage><pub-id pub-id-type="pmid">2355789</pub-id></element-citation></ref><ref id="B20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Brands</surname><given-names>F</given-names></name><name><surname>Monig</surname><given-names>SP</given-names></name><name><surname>Raab</surname><given-names>M</given-names></name></person-group><article-title>Treatment and prognosis of gastric lymphoma</article-title><source>Eur J Surg</source><year>1997</year><volume>163</volume><fpage>803</fpage><lpage>813</lpage><pub-id pub-id-type="pmid">9414040</pub-id></element-citation></ref><ref id="B21"><label>21</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Brooks</surname><given-names>JJ</given-names></name><name><surname>Enterline</surname><given-names>HT</given-names></name></person-group><article-title>Primary gastric lymphomas: A clinicopathologic study of 58 cases with long-term follow-up and literature review</article-title><source>Cancer</source><year>1983</year><volume>51</volume><fpage>701</fpage><lpage>711</lpage><pub-id pub-id-type="pmid">6336982</pub-id></element-citation></ref><ref id="B22"><label>22</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nakamura</surname><given-names>S</given-na