ub-id-type="pmid">16407533</pub-id></citation></ref><ref id="B12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vickers</surname><given-names>A</given-names></name><name><surname>Wilson</surname><given-names>P</given-names></name><name><surname>Kleijnen</surname><given-names>J</given-names></name></person-group><article-title>Acupuncture</article-title><source>Qual Saf Health Care</source><year>2002</year><volume>11</volume><fpage>92</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">12078381</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ma</surname><given-names>SX</given-names></name></person-group><article-title>Neurobiology of acupuncture: toward CAM</article-title><source>Evid Based Complement Alternat Med</source><year>2004</year><volume>1</volume><fpage>41</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15257325</pub-id></citation></ref><ref id="B14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lewith</surname><given-names>GT</given-names></name><name><surname>White</surname><given-names>PJ</given-names></name><name><surname>Pariente</surname><given-names>J</given-names></name></person-group><article-title>Investigating acupuncture using brain imaging techniques: the current state of play</article-title><source>Evid Based Complement Alternat Med</source><year>2005</year><volume>2</volume><fpage>315</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">16136210</pub-id></citation></ref><ref id="B15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ernst</surname><given-names>E</given-names></name></person-group><article-title>Acupuncture &#x02013; a critical analysis</article-title><source>J Intern Med</source><year>2006</year><volume>259</volume><fpage>125</fpage><lpage>37</lpage><pub-id pub-id-type="pmid">16420542</pub-id></citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lewith</surname><given-names>GT</given-names></name><name><surname>White</surname><given-names>PJ</given-names></name><name><surname>Kaptchuk</surname><given-names>TJ</given-names></name></person-group><article-title>Developing a research strategy for acupuncture</article-title><source>Clin J Pain</source><year>2006</year><volume>22</volume><fpage>632</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">16926579</pub-id></citation></ref><ref id="B17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Joyce</surname><given-names>CRB</given-names></name></person-group><article-title>Placebo and complementary medicine</article-title><source>Lancet</source><year>1994</year><volume>334</volume><fpage>1279</fpage><lpage>81</lpage><pub-id pub-id-type="pmid">7967992</pub-id></citation></ref><ref id="B18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vallance</surname><given-names>AK</given-names></name></person-group><article-title>Something out of nothing: the placebo effect</article-title><source>Advan Psychiatr Treat</source><year>2006</year><volume>12</volume><fpage>287</fpage><lpage>96</lpage></citation></ref><ref id="B19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Benedetti</surname><given-names>F</given-names></name><name><surname>Mayberg</surname><given-names>HS</given-names></name><name><surname>Wager</surname><given-names>TD</given-names></name><name><surname>Stohler</surname><given-names>CS</given-names></name><name><surname>Zubieta</surname><given-names>JK</given-names></name></person-group><article-title>Neurobiological mechanisms of the placebo effect</article-title><source>J Neurosci</source><year>2005</year><volume>25</volume><fpage>10390</fpage><lpage>402</lpage><pub-id pub-id-type="pmid">16280578</pub-id></citation></ref><ref id="B20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wager</surname><given-names>TD</given-names></name><name><surname>Rilling</surname><given-names>JK</given-names></name><name><surname>Smith</surname><given-names>EE</given-names></name><name><surname>Sokolik</surname><given-names>A</given-names></name><name><surname>Casey</surname><given-names>KL</given-names></name><name><surname>Davidson</surname><given-names>RJ</given-names></name><name><surname>Kosslyn</surname><given-names>SM</given-names></name><name><surname>Rose</surname><given-names>RM</given-names></name><name><surname>Cohen</surname><given-names>JD</given-names></name></person-group><article-title>Placebo-induced changes in FMRI in the anticipation and experience of pain</article-title><source>Science</source><year>2004</year><volume>303</volume><fpage>1162</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">14976306</pub-id></citation></ref><ref id="B21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Petrovic</surname><given-names>P</given-names></name><name><surname>Kalso</surname><given-names>E</given-names></name><name><surname>Petersson</surname><given-names>KM</given-names></name><name><surname>Ingvar</surname><given-names>M</given-names></name></person-group><article-title>Placebo and opioid analgesia&#x02014;imaging a shared neuronal network</article-title><source>Science</source><year>2002</year><volume>295</volume><fpage>1737</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">11834781</pub-id></citation></ref><ref id="B22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Benedetti</surname><given-names>F</given-names></name><name><surname>Amanzio</surname><given-names>M</given-names></name></person-gr