me><name><surname>Bagley</surname><given-names>J</given-names></name><name><surname>Skaznik-Wikiel</surname><given-names>M</given-names></name><name><surname>Lee</surname><given-names>H-J</given-names></name><name><surname>Adams</surname><given-names>GB</given-names></name><name><surname>Niikura</surname><given-names>Y</given-names></name><name><surname>Tschudy</surname><given-names>KS</given-names></name><name><surname>Tilly</surname><given-names>JC</given-names></name><name><surname>Cortes</surname><given-names>ML</given-names></name><name><surname>Forkert</surname><given-names>R</given-names></name><etal/></person-group><article-title>Oocyte generation in adult mammalian ovaries by putative germ cells derived from bone marrow and peripheral blood</article-title><source>Cell</source><year>2005</year><volume>a 122</volume><fpage>303</fpage><lpage>315</lpage><pub-id pub-id-type="pmid">16051153</pub-id></citation></ref><ref id="GAP036C17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnson</surname><given-names>J</given-names></name><name><surname>Skaznik-Wikiel</surname><given-names>M</given-names></name><name><surname>Lee</surname><given-names>HJ</given-names></name><name><surname>Niikura</surname><given-names>Y</given-names></name><name><surname>Tilly</surname><given-names>JC</given-names></name><name><surname>Tilly</surname><given-names>JL</given-names></name></person-group><article-title>Setting the record straight on data supporting postnatal oogenesis in female mammals</article-title><source>Cell Cycle</source><year>2005</year><volume>b 4</volume><fpage>1471</fpage><lpage>1477</lpage><pub-id pub-id-type="pmid">16222117</pub-id></citation></ref><ref id="GAP036C18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kerr</surname><given-names>JB</given-names></name><name><surname>Myers</surname><given-names>M</given-names></name><name><surname>Britt</surname><given-names>KL</give