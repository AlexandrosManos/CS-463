roup person-group-type="author"><name><surname>Stratton</surname><given-names>CW</given-names></name></person-group><year>2003</year><article-title>Dead bugs don't mutate: Susceptibility issues in the emergence of bacterial resistance.</article-title><source>Emerging Infectious Diseases</source><volume>9(1)</volume><fpage>10</fpage><lpage>15</lpage><pub-id pub-id-type="pmid">12533275</pub-id></citation></ref><ref id="pone.0005923-Levison1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Levison</surname><given-names>ME</given-names></name></person-group><year>2004</year><article-title>Pharmacodynamics of antimicrobial drugs-Review.</article-title><source>Infect Dis Clin North Am</source><volume>18(3)</volume><fpage>451</fpage><lpage>65</lpage><pub-id pub-id-type="pmid">15308272</pub-id></citation></ref><ref id="pone.0005923-Siegele1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Siegele</surname><given-names>DA</given-names></name><name><surname>Hu</surname><given-names>JC</given-names></name></person-group><year>1997</year><article-title>Gene expression from plasmids containing the <italic>ara</italic>BAD promoter as subsaturating inducer concentrations represents mixed populations.</article-title><source>Proc Natl Acad Sci USA</source><volume>94</volume><fpage>8168</fpage><lpage>8172</lpage><pub-id pub-id-type="pmid">9223333</pub-id></citation></ref><ref id="pone.0005923-Yagil1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yagil</surname><given-names>G</given-names></name><name><surname>Yagil</surname><given-names>E</given-names></name></person-group><year>1971</year><article-title>On the relation between effector concentration and the rate of induced enzyme synthesis.</article-title><source>Biophys J</source><volume>11(1)</volume><fpage>11</fpage><lpage>27</lpage><pub-id pub-id-type="