><ref id="b18-bmi-03-303"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Legrier</surname><given-names>ME</given-names></name><name><surname>de Pinieux</surname><given-names>G</given-names></name><name><surname>Boye</surname><given-names>K</given-names></name><etal/></person-group><year>2004</year><article-title>Mucinous differentiation features associated with hormonal escape in a human prostate cancer xenograft</article-title><source>Br. J. Cancer</source><volume>90</volume><issue>3</issue><fpage>720</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">14760390</pub-id></mixed-citation></ref><ref id="b19-bmi-03-303"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Levitin</surname><given-names>F</given-names></name><name><surname>Stern</surname><given-names>O</given-names></name><name><surname>Weiss</surname><given-names>M</given-names></name><etal/></person-group><year>2005</year><article-title>The MUC1 SEA module is a self-cleaving domain. </article-title><source>J. Biol. Chem</source><volume>280</volume><issue>39</issue><fpage>33374</fpage><lpage>86</lpage><pub-id pub-id-type="pmid">15987679</pub-id></mixed-citation></ref><ref id="b20-bmi-03-303"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>C</given-names></name><name><surname>Berx</surname><given-names>G</given-names></name><name><surname>Larsson</surname><given-names>C</given-names></name><etal/></person-group><year>1999</year><article-title>Distinct deleted regions on chromosome segment 16q23&#x02013;24 associated with metastases in prostate cancer</article-title><source>Genes Chromosomes Cancer</source><volume>24</volume><issue>3</issue><fpage>175</fpage><lpage>82</lpage><pub-id pub-id-type="pmid">10451696</pub-id></mixed-citation></ref><ref id="b21-bmi-03-303"><mixed-citation publication-type="journal"><person-group person-group-ty