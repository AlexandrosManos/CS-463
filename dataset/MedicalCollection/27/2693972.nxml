lspan="1">6%</td><td align="left" rowspan="1" colspan="1">2%</td><td align="right" rowspan="1" colspan="1">&#x0003c;0.050</td></tr><tr><td align="left" rowspan="1" colspan="1">Proportion with severe visual loss</td><td align="left" rowspan="1" colspan="1">10%</td><td align="left" rowspan="1" colspan="1">22%</td><td align="right" rowspan="1" colspan="1">&#x0003c;0.001</td></tr><tr><td align="left" rowspan="1" colspan="1">Proportion with vision &#x02264;20/200</td><td align="left" rowspan="1" colspan="1">38%</td><td align="left" rowspan="1" colspan="1">56%</td><td align="right" rowspan="1" colspan="1">&#x0003c;0.001</td></tr></tbody></table></table-wrap><table-wrap id="t2-co-2-339" position="float"><label>Table 2</label><caption><p>Impact of treatment discontinuation on visual outcome at week 102</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1"/><th align="left" rowspan="1" colspan="1">Continued pegaptanib sodium (n = 133)</th><th align="left" rowspan="1" colspan="1">Discontinued pegaptanib sodium (n = 132)</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">Mean visual loss</td><td align="left" rowspan="1" colspan="1">0.6 letters</td><td align="left" rowspan="1" colspan="1">5.3 letters</td></tr><tr><td align="left" rowspan="1" colspan="1">Loss of &#x02265;15 letters</td><td align="left" rowspan="1" colspan="1">15.8%</td><td align="left" rowspan="1" colspan="1">26.5%</td></tr><tr><td align="left" rowspan="1" colspan="1">Loss of &#x02265;30 letters</td><td align="left" rowspan="1" colspan="1">2.3%</td><td align="left" rowspan="1" colspan="1">4.7%</td></tr></tbody></table></table-wrap></floats-group></article>