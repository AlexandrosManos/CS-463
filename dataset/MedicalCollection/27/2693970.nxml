1">6 Months</th><th align="left" rowspan="1" colspan="1">9 Months</th><th align="left" rowspan="1" colspan="1">12 Months</th><th align="left" rowspan="1" colspan="1">24 Months</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">&#x0003c;21</td><td align="left" rowspan="1" colspan="1">97.34%</td><td align="left" rowspan="1" colspan="1">89.38%</td><td align="left" rowspan="1" colspan="1">84.95%</td><td align="left" rowspan="1" colspan="1">88.49%</td><td align="left" rowspan="1" colspan="1">86.82%</td><td align="left" rowspan="1" colspan="1">94.54%</td><td align="left" rowspan="1" colspan="1">90%</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x0003e;21&#x02013;&#x0003c;25</td><td align="left" rowspan="1" colspan="1">2.21%</td><td align="left" rowspan="1" colspan="1">4.42%</td><td align="left" rowspan="1" colspan="1">8.4%</td><td align="left" rowspan="1" colspan="1">7.07%</td><td align="left" rowspan="1" colspan="1">8.38%</td><td align="left" rowspan="1" colspan="1">0.90%</td><td align="left" rowspan="1" colspan="1">5%</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x0003e;25&#x02013;&#x0003c;30</td><td align="left" rowspan="1" colspan="1">0.44%</td><td align="left" rowspan="1" colspan="1">3.53%</td><td align="left" rowspan="1" colspan="1">2.21%</td><td align="left" rowspan="1" colspan="1">3.53%</td><td align="left" rowspan="1" colspan="1">1.19%</td><td align="left" rowspan="1" colspan="1">1.81%</td><td align="left" rowspan="1" colspan="1">5%</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x0003e;30&#x02013;&#x0003c;35</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">1.76%</td><td align="left" rowspan="1" colspan="1">2.21%</td><td align="left" rowspan="1" colspan="1">0.44%</td><td align="left" rowspan="1" colspan="1">2.65%</td><td align="left" rowspan="1" colspan="1">2.72%</td><td align="left" rowspan="1" colspan="1">0</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x0003e;35&#x