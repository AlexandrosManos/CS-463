">0.717</td></tr><tr><td align="left" rowspan="1" colspan="1"># of IVTA injections</td><td align="left" rowspan="1" colspan="1">0.201</td><td align="left" rowspan="1" colspan="1">0.176</td></tr><tr><td align="left" rowspan="1" colspan="1">Refractive error</td><td align="left" rowspan="1" colspan="1">0.305</td><td align="left" rowspan="1" colspan="1">0.269</td></tr><tr><td align="left" rowspan="1" colspan="1">Diabetes</td><td align="left" rowspan="1" colspan="1">0.17</td><td align="left" rowspan="1" colspan="1">0.199</td></tr><tr><td align="left" rowspan="1" colspan="1">Hypertension</td><td align="left" rowspan="1" colspan="1">0.158</td><td align="left" rowspan="1" colspan="1">0.23</td></tr><tr><td align="left" rowspan="1" colspan="1">Glaucoma</td><td align="left" rowspan="1" colspan="1">0.126</td><td align="left" rowspan="1" colspan="1">0.113</td></tr><tr><td colspan="3" align="left" rowspan="1">Reason for IVTA injection</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;ME</td><td align="left" rowspan="1" colspan="1">0.063</td><td align="left" rowspan="1" colspan="1">0.654</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;CRVO</td><td align="left" rowspan="1" colspan="1">0.161</td><td align="left" rowspan="1" colspan="1">0.225</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;BRVO</td><td align="left" rowspan="1" colspan="1">0.134</td><td align="left" rowspan="1" colspan="1">0.963</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;CNV</td><td align="left" rowspan="1" colspan="1">0.109</td><td align="left" rowspan="1" colspan="1">0.4</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;AMD</td><td align="left" rowspan="1" colspan="1">0.151</td><td align="left" rowspan="1" colspan="1">0.254</td></tr></tbody></table><table-wrap-foot><fn id="tfn1-co-2-269"><label>*</label><p><bold>Note:</bold> Pearson&#x02019;s correlation (SPSS version 13.0, Chicago, IL)</p></fn></table-wrap-foot></table-wrap></floats-group></article>