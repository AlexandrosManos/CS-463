>43</lpage><pub-id pub-id-type="pmid">15076785</pub-id></citation></ref><ref id="b36-cia-0103-213"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kirkcaldy</surname><given-names>BD</given-names></name><name><surname>Shephard</surname><given-names>RJ</given-names></name><name><surname>Siefen</surname><given-names>RG</given-names></name></person-group><year>2002</year><article-title>The relationship between physical activity and self-image and problem behaviour among adolescents</article-title><source>Soc Psychiatry Psychiatr Epidemiol</source><volume>37</volume><fpage>544</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">12395145</pub-id></citation></ref><ref id="b37-cia-0103-213"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koffler</surname><given-names>KH</given-names></name><name><surname>Menkes</surname><given-names>RA</given-names></name><name><surname>Redmond</surname><given-names>WE</given-names></name><etal/></person-group><year>1992</year><article-title>Strength training accelerates gastrointestinal transit in middle-aged and older men</article-title><source>Med Sci Sports Exerc</source><volume>24</volume><fpage>415</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">1560736</pub-id></citation></ref><ref id="b38-cia-0103-213"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kurl</surname><given-names>S</given-names></name><name><surname>Laukkanen</surname><given-names>JA</given-names></name><name><surname>Rauramaa</surname><given-names>R</given-names></name><etal/></person-group><year>2003</year><article-title>Cardiorespiratory fitness and the risk for stroke in men</article-title><source>Arch Intern Med</source><volume>163</volume><fpage>1682</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">12885683</pub-id></citation></ref><ref id="b39-cia-0103-213"><citation citation-type="journal"><person-group person-group-type="author"><name