>15769534</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Flemming</surname><given-names>RG</given-names></name><name><surname>Murphy</surname><given-names>CJ</given-names></name><name><surname>Abrams</surname><given-names>GA</given-names></name><name><surname>Goodman</surname><given-names>SL</given-names></name><name><surname>Nealey</surname><given-names>PF</given-names></name></person-group><article-title>Effects of synthetic micro- and nano-structured surfaces on cell behavior</article-title><source>Biomaterials</source><year>1999</year><volume>20</volume><issue>6</issue><fpage>573</fpage><lpage>88</lpage><pub-id pub-id-type="pmid">10213360</pub-id></element-citation></ref><ref id="B19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Teixeira</surname><given-names>AI</given-names></name><name><surname>Abrams</surname><given-names>GA</given-names></name><name><surname>Bertics</surname><given-names>PJ</given-names></name><name><surname>Murphy</surname><given-names>CJ</given-names></name><name><surname>Nealey</surname><given-names>PF</given-names></name></person-group><article-title>Epithelial contact guidance on well-defined micro- and nanostructured substrates</article-title><source>J Cell Sci</source><year>2003</year><volume>116</volume><issue>10</issue><fpage>1881</fpage><lpage>92</lpage><pub-id pub-id-type="pmid">12692189</pub-id></element-citation></ref><ref id="B20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wilkinson</surname><given-names>CDW</given-names></name><name><surname>Riehle</surname><given-names>M</given-names></name><name><surname>Wood</surname><given-names>M</given-names></name><name><surname>Gallagher</surname><given-names>J</given-names></name><name><surname>Curtis</surname><given-names>