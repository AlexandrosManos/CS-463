group-type="author"><name><surname>Douwes</surname><given-names>J</given-names></name><name><surname>Pearce</surname><given-names>N</given-names></name></person-group><article-title>Asthma and the westernization 'package'</article-title><source>Int J Epidemiol</source><year>2002</year><volume>31</volume><fpage>1098</fpage><lpage>1102</lpage><pub-id pub-id-type="pmid">12540698</pub-id><pub-id pub-id-type="doi">10.1093/ije/31.6.1098</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hong</surname><given-names>CY</given-names></name><name><surname>Ng</surname><given-names>TP</given-names></name><name><surname>Wong</surname><given-names>ML</given-names></name><name><surname>Koh</surname><given-names>KT</given-names></name><name><surname>Goh</surname><given-names>LG</given-names></name><name><surname>Ling</surname><given-names>SL</given-names></name></person-group><article-title>Lifestyle and behavioral risk factors associated with asthma morbidity in adults</article-title><source>QJM</source><year>1994</year><volume>87</volume><fpage>639</fpage><lpage>645</lpage><pub-id pub-id-type="pmid">7987660</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Abdul</surname><given-names>WA</given-names></name><name><surname>Mostafa</surname><given-names>OA</given-names></name></person-group><article-title>Arabian incense exposure among Qatari asthmatic children. A possible risk factor</article-title><source>Saudi Med J</source><year>2007</year><volume>28</volume><fpage>476</fpage><lpage>478</lpage><pub-id pub-id-type="pmid">17334490</pub-id></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Groom</surname><given-names>N</given-names></name></person-group><source>A study of the Arabian Incense Trade</source><year>1981</year><publisher-name>London, Longman</publisher-name></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lin</surname><given-names>TC</given-names></name><name><surname>Krishnaswamy</surname><given-names>G</given-names></name><name><surname>Chi</surname><given-names>DS</given-names></name></person-group><article-title>Incense smoke: clinical, structural and molecular effects on airway disease</article-title><source>Clin Mol Allergy</source><year>2008</year><volume>6</volume><fpage>3</fpage><pub-id pub-id-type="pmid">18439280</pub-id><pub-id pub-id-type="doi">10.1186/1476-7961-6-3</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dawod</surname><given-names>ST</given-names></name><name><surname>Hussain</surname><given-names>AA</given-names></name></person-group><article-title>Childhood asthma in Qatar</article-title><source>Ann Allergy Asthma Immunol</source><year>1995</year><volume>75</volume><fpage>360</fpage><lpage>364</lpage><pub-id pub-id-type="pmid">7583854</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hijazi</surname><given-names>Z</given-names></name><name><surname>Ezeamuzie</surname><given-names>CI</given-names></name><name><surname>Khan</surname><given-names>M</given-names></name><name><surname>Dowaisan</surname><given-names>AR</given-names></name></person-group><article-title>Characteristics of asthmatic children in Kuwait</article-title><source>J Asthma</source><year>2002</year><volume>39</volume><fpage>603</fpage><lpage>609</lpage><pub-id pub-id-type="pmid">12442949</pub-id><pub-id pub-id-type="doi">10.1081/JAS-120014924</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Alarifi</surname><given-names>SA</given-names></name><name><surname>Mubarak</surname><given-names>MM</given-names></name><name><surname>Alokail</surname><given-names>MS</given-names></name></person-group><article-title>Ultrastructural changes of pneumocytes of rat exposed to Arabian incense (Bakhour)</article-title><source>Saudi Med J</source><year>2004</year><volume>25</volume><fpage>1689</fpage><lpage>1693</lpage><pub-id pub-id-type="pmid">15573203</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weiland</surname><given-names>SK</given-names></name><name><surname>Bjorksten</surname><given-names>B</given-names></name><name><surname>Brunekreef</surname><given-names>B</given-names></name><name><surname>Cookson</surname><given-names>WO</given-names></name><name><surname>von</surname><given-names>ME</given-names></name><name><surname>Strachan</surname><given-names>DP</given-names></name></person-group><article-title>Phase II of the International Study of Asthma and Allergies in Childhood (ISAAC II): rationale and methods</article-title><source>Eur Respir J</source><year>2004</year><volume>24</volume><fpage>406</fpage><lpage>412</lpage><pub-id pub-id-type="pmid">15358699</pub-id><pub-id pub-id-type="doi">10.1183/09031936.04.00090303</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Asher</surname><given-names>MI</given-names></name><name><surname>Montefort</surname><given-names>S</given-names></name><name><surname>Bjorksten</surname><given-names>B</given-names></name><name><surname>Lai</surname><given-names>CK</given-names></name><name><surname>Strachan</surname><given-names>DP</given-names></name><name><surname>Weiland</surname><given-names>SK</given-names></name><name><surname>Williams</surname><given-names>H</given-names></name></person-group><article-title>Worldwide time trends in the prevalence of symptoms of asthma, allergic rhinoconjunctivitis, and eczema in childhood: ISAAC Phases One and Three repeat multicountry cross-sectional surveys</article-title><source>Lancet</source><year>2006</year><volume>368</volume><fpage>733</fpage><lpage>743</lpage><pub-id pub-id-type="pmid">16935684</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(06)69283-0</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lebowitz</surname><given-names>MD</given-names></name></person-group><article-title>Health effects of indoor pollutants</article-title><source>Annu Rev Public Health</source><year>1983</year><volume>4</volume><fpage>203</fpage><lpage>221</lpage><pub-id pub-id-type="pmid">6860438</pub-id><pub-id pub-id-type="doi">10.1146/annurev.pu.04.050183.001223</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yang</surname><given-names>CY</given-names></name><name><surname>Chiu</surname><given-names>JF</given-names></name><name><surname>Cheng</surname><given-names>MF</given-names></name><name><surname>Lin</surname><given-names>MC</given-names></name></person-group><article-title>Effects of indoor environmental factors on respiratory health of children in a subtropical climate</article-title><source>Environ Res</source><year>1997</year><volume>75</volume><fpage>49</fpage><lpage>55</lpage><pub-id pub-id-type="pmid">9356194</pub-id><pub-id pub-id-type="doi">10.1006/enrs.1997.3774</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ho</surname><given-names>CK</given-names></name><name><surname>Tseng</surname><given-names>WR</given-names></name><name><surname>Yang</surname><given-names>CY</given-names></name></person-group><article-title>Adverse respiratory and irritant health effects in temple workers in Taiwan</article-title><source>J Toxicol Environ Health</source><year>2005</year><volume>68</volume><fpage>1465</fpage><lpage>1470</lpage><pub-id pub-id-type="doi">10.1080/15287390590967405</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>YL</given-names></name><name><surname>Lin</surname><given-names>YC</given-names></name><name><surname>Hsiue</surname><given-names>TR</given-names></name><name><surname>Hwang</surname><given-names>BF</given-names></name><name><surname>Guo</surname><given-names>YL</given-names></name></person-group><article-title>Indoor and outdoor environmental exposures, parental atopy, and physician-diagnosed asthma in Taiwanese schoolchildren</article-title><source>Pediatrics</source><year>2003</year><volume>112</volume><fpage>389</fpage><lpage>395</lpage><pub-id pub-id-type="doi">10.1542/peds.112.5.e389</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koo</surname><given-names>LC</given-names></name><name><surname>Ho</surname><given-names>JC</given-names></name><name><surname>Tominnaga</surname><given-names>S</given-names></name><name><surname>Matsushita</surname><given-names>H</given-names></name><name><surname>Matsuki</surname><given-names>H</given-names></name><name><surname>Shimizu</surname><given-names>H</given-names></name><name><surname>Morri</surname><given-names>T</given-names></name><name><surname>Wong</surname><given-names>MC</given-names></name><name><surname>Ng Cye</surname><given-names>F</given-names></name></person-group><article-title>Is Chinese incense smoke hazardous to respiratory health?</article-title><source>Indoor Eviron</source><year>1995</year><volume>4</volume><fpage>334</fpage><lpage>343</lpage></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dossing</surname><given-names>M</given-names></name><name><surname>Khan</surname><given-names>J</given-names></name><name><surname>al-Rabiah</surname><given-names>F</given-names></name></person-group><article-title>Risk factors for chronic obstructive lung disease in Saudi Arabia</article-title><source>Respir Med</source><year>1994</year><volume>88</volume><fpage>519</fpage><lpage>522</lpage><pub-id pub-id-type="pmid">7972976</pub-id><pub-id pub-id-type="doi">10.1016/S0954-6111(05)80334-8</pub-id></citation></ref></ref-list></back></article>