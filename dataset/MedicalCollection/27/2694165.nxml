ume><issue>4</issue><fpage>1050</fpage><lpage>1057</lpage><pub-id pub-id-type="pmid">11704330</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martin</surname><given-names>LP</given-names></name><name><surname>Hamilton</surname><given-names>TC</given-names></name><name><surname>Schilder</surname><given-names>RJ</given-names></name></person-group><article-title>Platinum resistance: the role of DNA repair pathways</article-title><source>Clin Cancer Res</source><year>2008</year><volume>14</volume><issue>5</issue><fpage>1291</fpage><lpage>1295</lpage><pub-id pub-id-type="pmid">18316546</pub-id><pub-id pub-id-type="doi">10.1158/1078-0432.CCR-07-2238</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Borst</surname><given-names>P</given-names></name><name><surname>Rottenberg</surname><given-names>S</given-names></name><name><surname>Jonkers</surname><given-names>J</given-names></name></person-group><article-title>How do real tumors become resistant to cisplatin?</article-title><source>Cell Cycle</source><year>2008</year><volume>7</volume><issue>10</issue><fpage>1353</fpage><lpage>1359</lpage><pub-id pub-id-type="pmid">18418074</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Watanabe</surname><given-names>Y</given-names></name><name><surname>Koi</surname><given-names>M</given-names></name><name><surname>Hemmi</surname><given-names>H</given-names></name><name><surname>Hoshai</surname><given-names>H</given-names></name><name><surname>Noda</surname><given-names>K</given-names></name></person-group><article-title>A change in microsatellite instability caused by cisplatin-based chemotherapy of ovarian cancer</article-title><source>Br J Cancer</source><year>2001</year><volume>85</volume><issue>7</issue><fpage>1064</fpage><lpage>1069</lpage><pub-id pub-id-type="pmid">11592780</pub-id><pub-id pub-id-type="doi">10.1038/sj.bjc.6692037</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lin</surname><given-names>X</given-names></name><name><surname>Howell</surname><given-names>SB</given-names></name></person-group><article-title>DNA mismatch repair and p53 function are major determinants of the rate of development of cisplatin resistance</article-title><source>Mol Cancer Ther</source><year>2006</year><volume>5</volume><issue>5</issue><fpage>1239</fpage><lpage>1247</lpage><pub-id pub-id-type="pmid">16731756</pub-id><pub-id pub-id-type="doi">10.1158/1535-7163.MCT-05-0491</pub-id></citation></ref></ref-list></back></article>