bel><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grasso</surname><given-names>M</given-names></name></person-group><article-title>Bladder cancer: a major public health issue</article-title><source>Eur Urol Suppl</source><year>2008</year><volume>7</volume><fpage>510</fpage><lpage>515</lpage><pub-id pub-id-type="doi">10.1016/j.eursup.2008.04.001</pub-id></citation><citation citation-type="display-unstructured">Grasso M (2008) Bladder cancer: a major public health issue. Eur Urol Suppl 7:510&#x02013;515. doi:10.1016/j.eursup.2008.04.001 </citation></ref><ref id="CR16"><label>16.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Uchida</surname><given-names>A</given-names></name><name><surname>Yonou</surname><given-names>H</given-names></name><name><surname>Hayashi</surname><given-names>E</given-names></name><etal/></person-group><article-title>Intravesical instillation of bacille Calmette-Guerin for superficial bladder cancer: cost-effectiveness analysis</article-title><source>Urology</source><year>2007</year><volume>69</volume><fpage>275</fpage><lpage>279</lpage><pub-id pub-id-type="doi">10.1016/j.urology.2006.10.017</pub-id></citation><citation citation-type="display-unstructured">Uchida A, Yonou H, Hayashi E et al (2007) Intravesical instillation of bacille Calmette-Guerin for superficial bladder cancer: cost-effectiveness analysis. Urology 69:275&#x02013;279. doi:10.1016/j.urology.2006.10.017 <pub-id pub-id-type="pmid">17320663</pub-id></citation></ref><ref id="CR17"><label>17.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Babjuk</surname><given-names>M</given-names></name><name><surname>Oosterlinck</surname><given-names>W</given-names></name><name><surname>Sylvester</surname><given-names>R</given-names></name><etal/></person-group><article-title>EAU guidelines on non-muscle-invasive urothelial carcinoma of the bladder</arti