"><mixed-citation publication-type="other">Bril B, Dietrich G, Foucart J, Fuwa K, Hirata S (2008) Tool use as a way to assess cognition: how do captive chimpanzees handle the weight of the hammer when cracking a nut? Anim Cogn. doi:10.1007/s10071-008-0184-x</mixed-citation></ref><ref id="CR8"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Buchanan-Smith</surname><given-names>HM</given-names></name></person-group><article-title>Recent advances in color vision research</article-title><source>Am J Primatol</source><year>2005</year><volume>67</volume><fpage>393</fpage><lpage>398</lpage><pub-id pub-id-type="doi">10.1002/ajp.20194</pub-id><pub-id pub-id-type="pmid">16342071</pub-id></mixed-citation></ref><ref id="CR9"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Call</surname><given-names>J</given-names></name></person-group><article-title>Inferences about the location of food in the great apes (<italic>Pan paniscus</italic>, <italic>Pan troglodytes</italic>, <italic>Gorilla gorilla</italic>, <italic>Pongo pygmaeus</italic>)</article-title><source>J Comp Psychol</source><year>2004</year><volume>118</volume><fpage>232</fpage><lpage>241</lpage><pub-id pub-id-type="doi">10.1037/0735-7036.118.2.232</pub-id><pub-id pub-id-type="pmid">15250810</pub-id></mixed-citation></ref><ref id="CR10"><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Call</surname><given-names>J</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Hurley</surname><given-names>S</given-names></name><name><surname>Nudds</surname><given-names>M</given-names></name></person-group><article-title>Descartes&#x02019; two errors: reasoning and reflection from a comparative perspective</article-title><source>Rational animals</source><year>2006</year><publisher-loc>Oxford</publisher-loc><publisher-name>Oxford University Press</publisher-name><fpage>219</fpage><lpage>234</lpage></mixed-citation></ref><ref id="CR11"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Call</surname><given-names>J</given-names></name></person-group><article-title>Apes know that hidden objects can affect the orientation of other objects</article-title><source>Cognition</source><year>2007</year><volume>105</volume><fpage>1</fpage><lpage>25</lpage><pub-id pub-id-type="doi">10.1016/j.cognition.2006.08.004</pub-id><pub-id pub-id-type="pmid">17026977</pub-id></mixed-citation></ref><ref id="CR12"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Davis</surname><given-names>RR</given-names></name><name><surname>Markowitz</surname><given-names>H</given-names></name></person-group><article-title>Orangutan performance on a light&#x02013;dark reversal discrimination in the zoo</article-title><source>Primates</source><year>1978</year><volume>19</volume><fpage>755</fpage><lpage>759</lpage><pub-id pub-id-type="doi">10.1007/BF02373641</pub-id></mixed-citation></ref><ref id="CR13"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dominy</surname><given-names>NJ</given-names></name><name><surname>Lucas</surname><given-names>PW</given-names></name><name><surname>Osorio</surname><given-names>D</given-names></name><name><surname>Yamashita</surname><given-names>N</given-names></name></person-group><article-title>The sensory ecology of primate food perception</article-title><source>Evol Anthropol</source><year>2001</year><volume>10</volume><fpage>171</fpage><lpage>186</lpage><pub-id pub-id-type="doi">10.1002/evan.1031</pub-id></mixed-citation></ref><ref id="CR14"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dufour</surname><given-names>V</given-names></name><name><surname>Sterck</surname><given-names>EHM</given-names></name></person-group><