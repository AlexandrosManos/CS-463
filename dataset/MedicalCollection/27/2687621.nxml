ven-names>A</given-names></name><name><surname>Beccia</surname><given-names>M</given-names></name></person-group><article-title>Central nervous system vasculitis</article-title><source>J Neurol Sci</source><year>1998</year><volume>153</volume><fpage>159</fpage><lpage>171</lpage><pub-id pub-id-type="pmid">9511875</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Siva</surname><given-names>A</given-names></name></person-group><article-title>Vasculitis of the nervous system</article-title><source>J Neurol</source><year>2001</year><volume>248</volume><fpage>451</fpage><lpage>468</lpage><pub-id pub-id-type="pmid">11499635</pub-id></citation></ref><ref id="B14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Scolding</surname><given-names>NJ</given-names></name><name><surname>Joseph</surname><given-names>FG</given-names></name></person-group><article-title>The neuropathology and pathogenesis of systemic lupus erythematosus</article-title><source>Neuropathol Appl Neurobiol</source><year>2002</year><volume>28</volume><fpage>173</fpage><lpage>189</lpage><pub-id pub-id-type="pmid">12060342</pub-id></citation></ref><ref id="B15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jennekens</surname><given-names>FG</given-names></name><name><surname>Kater</surname><given-names>L</given-names></name></person-group><article-title>The central nervous system in systemic lupus erythematosus: part 2. pathogenetic mechanisms of clinical syndromes: a literature investigation</article-title><source>Rheumatology</source><year>2002</year><volume>41</volume><fpage>619</fpage><lpage>630</lpage><pub-id pub-id-type="pmid">12048287</pub-id></citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meroni</surn