bel><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Farhadifar</surname><given-names>R</given-names></name><name><surname>R&#x000f6;per</surname><given-names>JC</given-names></name><name><surname>Aigouy</surname><given-names>B</given-names></name><name><surname>Eaton</surname><given-names>S</given-names></name><name><surname>J&#x000fc;licher</surname><given-names>F</given-names></name></person-group><year>2007</year><article-title>The influence of cell mechanics, cell-cell interactions, and                        proliferation on epithelial packing.</article-title><source>Curr Biol</source><volume>17</volume><fpage>2095</fpage><lpage>2104</lpage><pub-id pub-id-type="pmid">18082406</pub-id></mixed-citation></ref><ref id="pcbi.1000412-Thry1"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Th&#x000e9;ry</surname><given-names>M</given-names></name><name><surname>Jim&#x000e9;nez-Dalmaroni</surname><given-names>A</given-names></name><name><surname>Racine</surname><given-names>V</given-names></name><name><surname>Bornens</surname><given-names>M</given-names></name><name><surname>J&#x000fc;licher</surname><given-names>F</given-names></name></person-group><year>2007</year><article-title>Experimental and theoretical study of mitotic spindle                        orientation.</article-title><source>Nature</source><volume>447</volume><fpage>493</fpage><lpage>498</lpage><pub-id pub-id-type="pmid">17495931</pub-id></mixed-citation></ref><ref id="pcbi.1000412-Feldman1"><label>14</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Feldman</surname><given-names>J</given-names></name><name><surname>Geimer</surname><given-names>S</given-names></name><name><surname>Marshall</surname><given-names>W</given-names></name></person-group><year>2007</year><article-title>The mother centriole plays an instructive role in de