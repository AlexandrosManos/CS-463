owspan="1" colspan="1">6</td><td align="center" rowspan="1" colspan="1">79</td><td align="center" rowspan="1" colspan="1">F</td><td align="center" rowspan="1" colspan="1">L</td><td align="center" rowspan="1" colspan="1">n/a</td><td align="center" rowspan="1" colspan="1">n/a</td><td align="center" rowspan="1" colspan="1">CB</td><td align="center" rowspan="1" colspan="1">SBL</td><td align="center" rowspan="1" colspan="1">SM</td><td align="center" rowspan="1" colspan="1">Dead</td><td align="center" rowspan="1" colspan="1">775</td></tr><tr><td align="left" colspan="11" rowspan="1"><hr/></td></tr><tr><td align="center" rowspan="1" colspan="1">7</td><td align="center" rowspan="1" colspan="1">52</td><td align="center" rowspan="1" colspan="1">M</td><td align="center" rowspan="1" colspan="1">L</td><td align="center" rowspan="1" colspan="1">n/a</td><td align="center" rowspan="1" colspan="1">n/a</td><td align="center" rowspan="1" colspan="1">EB</td><td align="center" rowspan="1" colspan="1">SBL</td><td align="center" rowspan="1" colspan="1">C</td><td align="center" rowspan="1" colspan="1">Dead</td><td align="center" rowspan="1" colspan="1">1045</td></tr><tr><td align="left" colspan="11" rowspan="1"><hr/></td></tr><tr><td align="center" rowspan="1" colspan="1">8</td><td align="center" rowspan="1" colspan="1">65</td><td align="center" rowspan="1" colspan="1">F</td><td align="center" rowspan="1" colspan="1">L, P</td><td align="center" rowspan="1" colspan="1">+</td><td align="center" rowspan="1" colspan="1">+</td><td align="center" rowspan="1" colspan="1">FNA/CB</td><td align="center" rowspan="1" colspan="1">SBL</td><td align="center" rowspan="1" colspan="1">Dx, C</td><td align="center" rowspan="1" colspan="1">Dead</td><td align="center" rowspan="1" colspan="1">133</td></tr><tr><td align="left" colspan="11" rowspan="1"><hr/></td></tr><tr><td align="center" rowspan="1" colspan="1">9</td><td align="center" rowspan="1" colspan="1">58</td><td align="center" rowspan="1" colspan="1">F</