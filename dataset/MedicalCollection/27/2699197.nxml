d pub-id-type="pmid">17457172</pub-id></element-citation></ref><ref id="b12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wiseman</surname><given-names>C</given-names></name><name><surname>Liao</surname><given-names>KT</given-names></name></person-group><article-title>Primary lymphoma of the breast</article-title><source>Cancer</source><year>1972</year><volume>29</volume><issue>6</issue><fpage>1705</fpage><lpage>12</lpage><pub-id pub-id-type="pmid">4555557</pub-id></element-citation></ref><ref id="b13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bari&#x0015f;ta</surname><given-names>I</given-names></name><name><surname>Baltali</surname><given-names>E</given-names></name><name><surname>Tekuzman</surname><given-names>G</given-names></name><name><surname>Kars</surname><given-names>A</given-names></name><name><surname>Ruacan</surname><given-names>S</given-names></name><name><surname>Ozi&#x0015f;ik</surname><given-names>Y</given-names></name><etal/></person-group><article-title>Primary breast lymphomas: a retrospective analysis of twelve cases</article-title><source>Acta Oncol</source><year>2000</year><volume>39</volume><issue>2</issue><fpage>135</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">10859001</pub-id></element-citation></ref><ref id="b14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Domchek</surname><given-names>SM</given-names></name><name><surname>Hecht</surname><given-names>JL</given-names></name><name><surname>Fleming</surname><given-names>MD</given-names></name><name><surname>Pinkus</surname><given-names>GS</given-names></name><name><surname>Canellos</surname><given-names>GP</given-names></name></person-group><article-title>Lymphomas of the breast, primary and secondary involvement</article-title><source>Cancer</source><year>2002</year><v