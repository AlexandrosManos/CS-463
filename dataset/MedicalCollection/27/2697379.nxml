colspan="1">Human</td><td align="left" rowspan="1" colspan="1">21</td><td align="left" rowspan="1" colspan="1">V-4</td><td align="left" rowspan="1" colspan="1">1, 2, 3</td></tr><tr><td align="left" rowspan="1" colspan="1">489246</td><td align="left" rowspan="1" colspan="1">FJ969470</td><td align="left" rowspan="1" colspan="1">Cocle, Aguadulce</td><td align="left" rowspan="1" colspan="1">1995</td><td align="left" rowspan="1" colspan="1">Human</td><td align="left" rowspan="1" colspan="1">24</td><td align="left" rowspan="1" colspan="1">V-4</td><td align="left" rowspan="1" colspan="1">1, 2, 9</td></tr><tr><td align="left" rowspan="1" colspan="1">489247</td><td align="left" rowspan="1" colspan="1">FJ969471</td><td align="left" rowspan="1" colspan="1">Panama, Felipillo</td><td align="left" rowspan="1" colspan="1">1996</td><td align="left" rowspan="1" colspan="1">Human</td><td align="left" rowspan="1" colspan="1">&#x0003e;15</td><td align="left" rowspan="1" colspan="1">V-4</td><td align="left" rowspan="1" colspan="1">1, 9, 10</td></tr><tr><td align="left" rowspan="1" colspan="1">474590</td><td align="left" rowspan="1" colspan="1">FJ969449</td><td align="left" rowspan="1" colspan="1">Panama, Mananitas</td><td align="left" rowspan="1" colspan="1">1997</td><td align="left" rowspan="1" colspan="1">Human</td><td align="left" rowspan="1" colspan="1">16</td><td align="left" rowspan="1" colspan="1">V-2</td><td align="left" rowspan="1" colspan="1">1, 2, 3, 9, 11, 12, 16</td></tr><tr><td align="left" rowspan="1" colspan="1">487315</td><td align="left" rowspan="1" colspan="1">FJ969463</td><td align="left" rowspan="1" colspan="1">Panama, Felipillo</td><td align="left" rowspan="1" colspan="1">1997</td><td align="left" rowspan="1" colspan="1">Human</td><td align="left" rowspan="1" colspan="1">28</td><td align="left" rowspan="1" colspan="1">V-3</td><td align="left" rowspan="1" colspan="1">1, 2, 3, 4, 5, 6, 9, 10, 11, 13</td></tr><tr><td align="left" rowspan="1" colspan="1">487308</td><td align="left" rowspan="1" colspan="1">FJ969457</td><td align="left" rowspan="1" colspan="1">Darien, Sambu</td><td align="left" rowspan="1" colspan="1">1998</td><td align="left" rowspan="1" colspan="1">Human</td><td align="left" rowspan="1" colspan="1">10</td><td align="left" rowspan="1" colspan="1">V-2</td><td align="left" rowspan="1" colspan="1">1, 2, 3, 4, 11</td></tr><tr><td align="left" rowspan="1" colspan="1">487309</td><td align="left" rowspan="1" colspan="1">FJ969458</td><td align="left" rowspan="1" colspan="1">Darien, Sambu</td><td align="left" rowspan="1" colspan="1">1998</td><td align="left" rowspan="1" colspan="1">Human</td><td align="left" rowspan="1" colspan="1">16</td><td align="left" rowspan="1" colspan="1">V-2</td><td align="left" rowspan="1" colspan="1">1, 2, 9, 11</td></tr><tr><td align="left" rowspan="1" colspan="1">487310</td><td align="left" rowspan="1" colspan="1">FJ969459</td><td align="left" rowspan="1" colspan="1">Darien, Sambu</td><td align="left" rowspan="1" colspan="1">1998</td><td align="left" rowspan="1" colspan="1">Human</td><td align="left" rowspan="1" colspan="1">15</td><td align="left" rowspan="1" colspan="1">V-3</td><td align="left" rowspan="1" colspan="1">1, 2, 9, 11, 13</td></tr><tr><td align="left" rowspan="1" colspan="1">487311</td><td align="left" rowspan="1" colspan="1">FJ969460</td><td align="left" rowspan="1" colspan="1">Darien, Sambu</td><td align="left" rowspan="1" colspan="1">1998</td><td align="left" rowspan="1" colspan="1">Human</td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">V-3</td><td align="left" rowspan="1" colspan="1">1, 2, 11</td></tr><tr><td align="left" rowspan="1" colspan="1">487312</td><td align="left" rowspan="1" colspan="1">FJ969461</td><td align="left" rowspan="1" colspan="1">Darien, Sambu</td><td align="left" rowspan="1" colspan="1">1998</td><td align="left" rowspan="1" colspan="1">Human</td><td align="left" rowspan="1" colspan="1">23</td><td align="left" rowsp