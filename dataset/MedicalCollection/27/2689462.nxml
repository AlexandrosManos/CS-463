 J Respir Crit Care Med</source><year>1997</year><volume>155</volume><fpage>1309</fpage><lpage>1315</lpage><pub-id pub-id-type="pmid">9105072</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Balaraman</surname><given-names>V</given-names></name><name><surname>Meister</surname><given-names>J</given-names></name><name><surname>Ku</surname><given-names>TL</given-names></name><name><surname>Sood</surname><given-names>SL</given-names></name><name><surname>Tam</surname><given-names>E</given-names></name><name><surname>Killeen</surname><given-names>J</given-names></name><name><surname>Uyehara</surname><given-names>CF</given-names></name><name><surname>Egan</surname><given-names>E</given-names></name><name><surname>Easa</surname><given-names>D</given-names></name></person-group><article-title>Lavage administration of dilute surfactants after acute lung injury in neonatal piglets</article-title><source>Am J Respir Crit Care Med</source><year>1998</year><volume>158</volume><fpage>12</fpage><lpage>17</lpage><pub-id pub-id-type="pmid">9655700</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cordingley</surname><given-names>JJ</given-names></name><name><surname>Keogh</surname><given-names>BF</given-names></name></person-group><article-title>The pulmonary physician in critical care. 8: Ventilatory management of ALI/ARDS</article-title><source>Thorax</source><year>2002</year><volume>57</volume><fpage>729</fpage><lpage>734</lpage><pub-id pub-id-type="pmid">12149536</pub-id><pub-id pub-id-type="doi">10.1136/thorax.57.8.729</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Derdak</surname><given-names>S</given-names></name><name><surname>Mehta</surname><given-names>S</given-names></name><name><surname>Stewart</surname><given-names>TE</given-names></na