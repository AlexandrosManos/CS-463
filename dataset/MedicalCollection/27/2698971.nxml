pe="journal"><person-group person-group-type="author"><name><surname>Cronin</surname><given-names>KA</given-names></name><name><surname>Snowdon</surname><given-names>CT</given-names></name></person-group><article-title>The effects of unequal reward distributions on cooperative problem solving by cotton-top tamarins (<italic>Saguinus oedipus</italic>)</article-title><source>Anim Behav</source><year>2008</year><volume>75</volume><fpage>245</fpage><lpage>257</lpage><pub-id pub-id-type="doi">10.1016/j.anbehav.2007.04.032</pub-id></citation><citation citation-type="display-unstructured">Cronin KA, Snowdon CT (2008) The effects of unequal reward distributions on cooperative problem solving by cotton-top tamarins (Saguinus oedipus). Anim Behav 75:245&#x02013;257 <pub-id pub-id-type="pmid">19122748</pub-id></citation></ref><ref id="CR10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cronin</surname><given-names>KA</given-names></name><name><surname>Kurian</surname><given-names>AV</given-names></name><name><surname>Snowdon</surname><given-names>CT</given-names></name></person-group><article-title>Cooperative problem solving in a cooperatively breeding primate</article-title><source>Anim Behav</source><year>2005</year><volume>69</volume><issue>1</issue><fpage>133</fpage><lpage>142</lpage><pub-id pub-id-type="doi">10.1016/j.anbehav.2004.02.024</pub-id></citation><citation citation-type="display-unstructured">Cronin KA, Kurian AV, Snowdon CT (2005) Cooperative problem solving in a cooperatively breeding primate. Anim Behav 69(1):133&#x02013;142 <pub-id pub-id-type="pmid">16804561</pub-id></citation></ref><ref id="CR11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Waal</surname><given-names>FBM</given-names></name></person-group><article-title>The chimpanzee&#x02019;s service economy: food for grooming</article-title><source>Evol Human Behav</source><year>1997</year><volume>18</volume><fpage>375</fpage><lpage>386</lpage><pub-id pub-id-type="doi">10.1016/S1090-5138(97)00085-8</pub-id></citation><citation citation-type="display-unstructured">de Waal FBM (1997) The chimpanzee&#x02019;s service economy: food for grooming. Evol Human Behav 18:375&#x02013;386 </citation></ref><ref id="CR12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Waal</surname><given-names>FBM</given-names></name></person-group><article-title>Attitudinal reciprocity in food sharing among brown capuchin monkeys</article-title><source>Anim Behav</source><year>2000</year><volume>60</volume><fpage>253</fpage><lpage>261</lpage><pub-id pub-id-type="doi">10.1006/anbe.2000.1471</pub-id></citation><citation citation-type="display-unstructured">de Waal FBM (2000) Attitudinal reciprocity in food sharing among brown capuchin monkeys. Anim Behav 60:253&#x02013;261 <pub-id pub-id-type="pmid">10973728</pub-id></citation></ref><ref id="CR13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Waal</surname><given-names>FBM</given-names></name><name><surname>Berger</surname><given-names>ML</given-names></name></person-group><article-title>Payment for labour in monkeys</article-title><source>Nature</source><year>2000</year><volume>404</volume><fpage>563</fpage><pub-id pub-id-type="doi">10.1038/35007138</pub-id></citation><citation citation-type="display-unstructured">de Waal FBM, Berger ML (2000) Payment for labour in monkeys. Nature 404:563 <pub-id pub-id-type="pmid">10766228</pub-id></citation></ref><ref id="CR14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Duffy</surname><given-names>KG</given-names></name><name><surname>Wrangham</surname><given-names>RW</given-names></name><name><surname>Silk</surname><given-names>JB</given-names></name></person-group><article-title>Male chimpanzees exchange political support for mating opportunities</article-title><source>Curr Biol</source