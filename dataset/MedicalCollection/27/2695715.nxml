<label>19.</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Charmaz</surname><given-names>K</given-names></name></person-group><article-title>Constructivist and objectivist grounded theory</article-title><person-group person-group-type="editor"><name><surname>Denzin</surname><given-names>NK</given-names></name><name><surname>Lincoln</surname><given-names>YS</given-names></name></person-group><source>Handbook of Qualitative Research</source><edition>2nd ed</edition><publisher-loc>Thousand Oaks, CA</publisher-loc><publisher-name>Sage Publications</publisher-name><year>2000</year><fpage>509</fpage><lpage>35</lpage></citation></ref></ref-list></back><floats-wrap><fig id="f1-co16-3-26" position="float"><label>FIGURE 1</label><caption><p><italic>Model of disability after treatment for breast cancer and of implications for practice.</italic> <italic><sc>rom</sc></italic><italic> = range of motion;</italic> <italic><sc>pts</sc></italic><italic> = physical therapists;</italic> <italic><sc>ots</sc></italic> <italic>= occupational therapists.</italic></p></caption><graphic xlink:href="co16-3-26f1"/></fig><table-wrap id="t1-co16-3-26" position="float"><label>TABLE I</label><caption><p>Demographics of the study participants</p></caption><table frame="hsides" rules="groups"><thead><tr><th valign="middle" align="center" rowspan="1" colspan="1"><italic>Characteristic</italic></th><th valign="middle" align="center" rowspan="1" colspan="1"><italic>(</italic>n<italic>)</italic></th><th valign="middle" align="center" rowspan="1" colspan="1"><italic>(%)</italic></th></tr></thead><tbody><tr><td valign="top" align="left" rowspan="1" colspan="1">Age</td><td valign="top" align="center" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1"/></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">&#x02003;&#x02003;30&#x02013;39 years</td><td valign="top" align="center" rowspan="1" colspan="1">4</td><td valign="top"