cation-type="journal"><person-group person-group-type="author"><name><surname>Gillim-Ross</surname><given-names>L</given-names></name><name><surname>Subbarao</surname><given-names>K</given-names></name></person-group><year>2006</year><article-title>Emerging respiratory viruses: challenges and vaccine strategies.</article-title><source>Clin Microbiol Rev</source><volume>19</volume><fpage>614</fpage><lpage>636</lpage><pub-id pub-id-type="pmid">17041137</pub-id></mixed-citation></ref><ref id="pone.0006032-Schulman1"><label>8</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Schulman</surname><given-names>JL</given-names></name><name><surname>Palese</surname><given-names>P</given-names></name></person-group><year>1977</year><article-title>Virulence factors of influenza A viruses: WSN virus neuraminidase required for plaque production in MDBK cells.</article-title><source>J Virol</source><volume>24</volume><fpage>170</fpage><lpage>176</lpage><pub-id pub-id-type="pmid">561860</pub-id></mixed-citation></ref><ref id="pone.0006032-WHO1"><label>9</label><mixed-citation publication-type="other"><collab>WHO</collab><year>2001</year><article-title>Influenza in the world: 1 October 1999&#x02013;30 September 2000, in Wkly.</article-title><source>Epidemiol Rec</source><fpage>49</fpage><lpage>53</lpage></mixed-citation></ref><ref id="pone.0006032-Bright1"><label>10</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bright</surname><given-names>RA</given-names></name><name><surname>Carter</surname><given-names>DM</given-names></name><name><surname>Crevar</surname><given-names>CJ</given-names></name><name><surname>Toapanta</surname><given-names>FR</given-names></name><name><surname>Steckbeck</surname><given-names>JD</given-names></name><etal/></person-group><year>2008</year><article-title>Cross-Clade Protective Immune Responses to Influenza Viruses with H5N1 HA and NA Elicited by an Influenza Virus-Like Particle.</article-title><source>PLoS ONE</source><volume>3</volume><fpage>e1501</fpage><pub-id pub-id-type="pmid">18231588</pub-id></mixed-citation></ref><ref id="pone.0006032-Bright2"><label>11</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bright</surname><given-names>RA</given-names></name><name><surname>Carter</surname><given-names>DM</given-names></name><name><surname>Daniluk</surname><given-names>S</given-names></name><name><surname>Toapanta</surname><given-names>FR</given-names></name><name><surname>Ahmad</surname><given-names>A</given-names></name><etal/></person-group><year>2007</year><article-title>Influenza virus-like particles elicit broader immune responses than whole virion inactivated influenza virus or recombinant hemagglutinin.</article-title><source>Vaccine</source><volume>25</volume><fpage>3871</fpage><lpage>3878</lpage><pub-id pub-id-type="pmid">17337102</pub-id></mixed-citation></ref><ref id="pone.0006032-Mahmood1"><label>12</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mahmood</surname><given-names>K</given-names></name><name><surname>Bright</surname><given-names>R</given-names></name><name><surname>Mytle</surname><given-names>N</given-names></name><name><surname>Carter</surname><given-names>D</given-names></name><name><surname>Crevar</surname><given-names>C</given-names></name><etal/></person-group><year>2008</year><article-title>H5N1 VLP vaccine induced protection in ferrets against lethal challenge with highly pathogenic H5N1 influenza viruses.</article-title><source>Vaccine</source><volume>26</volume><fpage>5393</fpage><lpage>5399</lpage><pub-id pub-id-type="pmid">18706956</pub-id></mixed-citation></ref><ref id="pone.0006032-Pushko1"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Pushko</surname><given-names>P</given-names></n