 Breath</source><year>2003</year><volume>7</volume><fpage>77</fpage><lpage>86</lpage><pub-id pub-id-type="pmid">12861487</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Schwab</surname><given-names>RJ</given-names></name><name><surname>Gefter</surname><given-names>WB</given-names></name><name><surname>Hoffman</surname><given-names>EA</given-names></name><name><surname>Gupta</surname><given-names>KB</given-names></name><name><surname>Pack</surname><given-names>AI</given-names></name></person-group><article-title>Dynamic upper airway imaging during awake respiration in normal subjects and patients with sleep disordered breathing</article-title><source>Am Rev Respir Dis</source><year>1993</year><volume>148</volume><fpage>1385</fpage><lpage>1400</lpage><pub-id pub-id-type="pmid">8239180</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>IG</given-names></name><name><surname>Zamel</surname><given-names>N</given-names></name><name><surname>Hoffstein</surname><given-names>V</given-names></name></person-group><article-title>Pharyngeal cross-sectional area in normal men and women</article-title><source>J Appl Physiol</source><year>1986</year><volume>61</volume><fpage>890</fpage><lpage>895</lpage><pub-id pub-id-type="pmid">3759773</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Haponik</surname><given-names>EF</given-names></name><name><surname>Smith</surname><given-names>PL</given-names></name><name><surname>Bohlman</surname><given-names>ME</given-names></name><name><surname>Allen</surname><given-names>RP</given-names></name><name><surname>Goldman</surname><given-names>SM</given-names></name><name><surname