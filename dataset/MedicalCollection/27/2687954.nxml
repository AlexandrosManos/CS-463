ame><etal/></person-group><article-title>Architecture and inherent robustness of a bacterial cell-cycle control system</article-title><source>Proc. Natl Acad. Sci. USA</source><year>2008</year><volume>105</volume><fpage>11340</fpage><lpage>11345</lpage><pub-id pub-id-type="pmid">18685108</pub-id></citation></ref><ref id="B38"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shinar</surname><given-names>G</given-names></name><etal/></person-group><article-title>Input-output robustness in simple bacterial signaling systems</article-title><source>Proc. Natl Acad. Sci. USA</source><year>2007</year><volume>104</volume><fpage>19931</fpage><lpage>19935</lpage><pub-id pub-id-type="pmid">18077424</pub-id></citation></ref><ref id="B39"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stelling</surname><given-names>J</given-names></name><etal/></person-group><article-title>Robustness of cellular functions</article-title><source>Cell</source><year>2004a</year><volume>118</volume><fpage>675</fpage><lpage>685</lpage><pub-id pub-id-type="pmid">15369668</pub-id></citation></ref><ref id="B40"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stelling</surname><given-names>J</given-names></name><etal/></person-group><article-title>Robustness properties of circadian clock architectures</article-title><source>Proc. Natl Acad. Sci. USA</source><year>2004b</year><volume>101</volume><fpage>13210</fpage><lpage>13215</lpage><pub-id pub-id-type="pmid">15340155</pub-id></citation></ref><ref id="B41"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vecchio</surname><given-names>DD</given-names></name><etal/></person-group><article-title>Modular cell biology: retroactivity and insulation</article-title><source>Mol. Syst. Biol.</source><year>2008</year><volume>4</volume><fpage>161</fpage><pub-id pub-id-type="pmid">18277378</pub-id></ci