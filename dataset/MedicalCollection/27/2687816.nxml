e><surname>Hardy</surname><given-names>BE</given-names></name><name><surname>Filler</surname><given-names>RM</given-names></name></person-group><article-title>Surgery for anomalies of the urachus</article-title><source>J Pediatr Surg</source><year>1983</year><volume>18</volume><fpage>370</fpage><lpage>372</lpage><pub-id pub-id-type="pmid">6620076</pub-id></element-citation></ref><ref id="B5"><label>5</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Steegmuller</surname><given-names>KW</given-names></name><name><surname>Marklin</surname><given-names>HM</given-names></name><name><surname>Hollis</surname><given-names>HW</given-names><suffix>Jr</suffix></name></person-group><article-title>Intraoperative hemodynamic investigations during portacarval shunt</article-title><source>Arch Surg</source><year>1984</year><volume>119</volume><fpage>269</fpage><lpage>273</lpage><pub-id pub-id-type="pmid">6607720</pub-id></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>McCollum</surname><given-names>MO</given-names></name><name><surname>Macneily</surname><given-names>AE</given-names></name><name><surname>Blair</surname><given-names>GK</given-names></name></person-group><article-title>Surgical implications of urachal remnants: Presentation and management</article-title><source>J Pediatr Surg</source><year>2003</year><volume>38</volume><fpage>798</fpage><lpage>803</lpage><pub-id pub-id-type="pmid">12720197</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bourne</surname><given-names>CW</given-names></name><name><surname>May</surname><given-names>JE</given-names></name></person-group><article-title>Urachal remnants: benign or malignant?</article-title><source>J Urol</source><year>1977</year><volume>118</volume><