iven-names></name></person-group><article-title>Subunit rules governing the sorting of internalized AMPA receptors in hippocampal neurons</article-title><source>Neuron</source><year>2004</year><volume>43</volume><fpage>221</fpage><lpage>236</lpage><pub-id pub-id-type="pmid">15260958</pub-id></citation></ref><ref id="R32"><label>32</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Regalado</surname><given-names>MP</given-names></name><name><surname>Terry-Lorenzo</surname><given-names>RT</given-names></name><name><surname>Waites</surname><given-names>CL</given-names></name><name><surname>Garner</surname><given-names>CC</given-names></name><name><surname>Malenka</surname><given-names>RC</given-names></name></person-group><article-title>Transsynaptic signaling by postsynaptic synapse-associated protein 97</article-title><source>J. Neurosci</source><year>2006</year><volume>26</volume><fpage>2343</fpage><lpage>2357</lpage><pub-id pub-id-type="pmid">16495462</pub-id></citation></ref><ref id="R33"><label>33</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Colledge</surname><given-names>M</given-names></name><etal/></person-group><article-title>Targeting of PKA to glutamate receptors through a MAGUK-AKAP complex</article-title><source>Neuron</source><year>2000</year><volume>27</volume><fpage>107</fpage><lpage>119</lpage><pub-id pub-id-type="pmid">10939335</pub-id></citation></ref><ref id="R34"><label>34</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McGee</surname><given-names>AW</given-names></name><name><surname>Bredt</surname><given-names>DS</given-names></name></person-group><article-title>Identification of an intramolecular interaction between the SH3 and guanylate kinase domains of PSD-95</article-title><source>J. Biol. Chem</source><year>1999</year><volume>274</volume><fpage>17431</fpage><lpage>17436</lpage><pub-id pub-id-typ