/volume><fpage>236</fpage><lpage>243</lpage><pub-id pub-id-type="pmid">16798918</pub-id></citation></ref><ref id="b22-tcrm-5-0217"><label>22.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hermans</surname><given-names>R</given-names></name><name><surname>Fossion</surname><given-names>E</given-names></name><name><surname>Ioannides</surname><given-names>C</given-names></name><name><surname>Van de Bogaert</surname><given-names>W</given-names></name><name><surname>Ghekiere</surname><given-names>J</given-names></name><name><surname>Baert</surname><given-names>AL</given-names></name></person-group><article-title>CT findings in osteoradionecrosis of the mandibule</article-title><source>Skeletal Radiol</source><year>1996</year><volume>25</volume><fpage>31</fpage><lpage>36</lpage><pub-id pub-id-type="pmid">8717116</pub-id></citation></ref><ref id="b23-tcrm-5-0217"><label>23.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Woo</surname><given-names>SB</given-names></name><name><surname>Hellstein</surname><given-names>JW</given-names></name><name><surname>Kalmar</surname><given-names>JR</given-names></name></person-group><article-title>Narrative [corrected] review: bisphosphonates and osteonecrosis of the jaws</article-title><source>Ann Intern Med</source><year>2006</year><volume>144</volume><fpage>753</fpage><lpage>761</lpage><pub-id pub-id-type="pmid">16702591</pub-id></citation></ref><ref id="b24-tcrm-5-0217"><label>24.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Resza</surname><given-names>AA</given-names></name><name><surname>Rodan</surname><given-names>GA</given-names></name></person-group><article-title>Nitrogen-containing bisphosphonates mechanism of action</article-title><source>Mini Rev Med Chem</source><year>2004</year><volume>4</volume><fpage>711</fpage><lpage>719</lpage><pub-id pub-id-type="pmid">15379639</pub-id>