-type="pmid">1381981</pub-id></citation></ref><ref id="b5-tcrm-5-413"><label>5.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>JJ</given-names></name><name><surname>Swope</surname><given-names>DM</given-names></name></person-group><article-title>Clinical pharmacology of rasagiline: a novel, second-generation propargylamine for the treatment of Parkinson disease</article-title><source>J Clin Pharmacol</source><year>2005</year><volume>45</volume><issue>8</issue><fpage>878</fpage><lpage>894</lpage><pub-id pub-id-type="pmid">16027398</pub-id></citation></ref><ref id="b6-tcrm-5-413"><label>6.</label><citation citation-type="journal"><article-title>DATATOP: a multicenter controlled clinical trial in early Parkinson&#x02019;s disease. Parkinson Study Group</article-title><source>Arch Neurol</source><year>1989</year><volume>46</volume><issue>10</issue><fpage>1052</fpage><lpage>1060</lpage><pub-id pub-id-type="pmid">2508608</pub-id></citation></ref><ref id="b7-tcrm-5-413"><label>7.</label><citation citation-type="journal"><article-title>Effects of tocopherol and deprenyl on the progression of disability in early Parkinson&#x02019;s disease. The Parkinson Study Group</article-title><source>N Engl J Med</source><year>1993</year><volume>328</volume><issue>3</issue><fpage>176</fpage><lpage>183</lpage><pub-id pub-id-type="pmid">8417384</pub-id></citation></ref><ref id="b8-tcrm-5-413"><label>8.</label><citation citation-type="journal"><article-title>Impact of deprenyl and tocopherol treatment on Parkinson&#x02019;s disease in DATATOP subjects not requiring levodopa. Parkinson Study Group</article-title><source>Ann Neurol</source><year>1996</year><volume>39</volume><issue>1</issue><fpage>29</fpage><lpage>36</lpage><pub-id pub-id-type="pmid">8572663</pub-id></citation></ref><ref id="b9-tcrm-5-413"><label>9.</label><citation citation-type="book"><person-group person-group-type="author"><collab>Somerset Pharm