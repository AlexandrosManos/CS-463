</lpage><pub-id pub-id-type="pmid">14561818</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Andrew</surname><given-names>PJ</given-names></name><name><surname>Mayer</surname><given-names>B</given-names></name></person-group><article-title>Enzymatic function of nitric oxide synthases</article-title><source><italic>Cardiovascular Research</italic></source><year>1999</year><volume>43</volume><issue>3</issue><fpage>521</fpage><lpage>531</lpage><pub-id pub-id-type="pmid">10690324</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Alvarez</surname><given-names>MN</given-names></name><name><surname>Piacenza</surname><given-names>L</given-names></name><name><surname>Irigo&#x000ed;n</surname><given-names>F</given-names></name><name><surname>Peluffo</surname><given-names>G</given-names></name><name><surname>Radi</surname><given-names>R</given-names></name></person-group><article-title>Macrophage-derived peroxynitrite diffusion and toxicity to <italic>Trypanosoma cruzi</italic></article-title><source><italic>Archives of Biochemistry and Biophysics</italic></source><year>2004</year><volume>432</volume><issue>2</issue><fpage>222</fpage><lpage>232</lpage><pub-id pub-id-type="pmid">15542061</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mu&#x000f1;oz-Fern&#x000e1;ndez</surname><given-names>MA</given-names></name><name><surname>Fern&#x000e1;ndez</surname><given-names>MA</given-names></name><name><surname>Fresno</surname><given-names>M</given-names></name></person-group><article-title>Activation of human macrophages for the killing of intracellular <italic>Trypanosoma cruzi</italic> by TNF-<italic>&#x003b1;</italic> and IFN-<italic>&#x003b3;</italic> through a nitric oxide-dependent mechanism</article-title><source><italic>Immunology Letters</italic></source><year>1992</year><volume>33</volume><issue>1</issue><fpage>35</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">1330900</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Melo</surname><given-names>RC</given-names></name><name><surname>Fabrino</surname><given-names>DL</given-names></name><name><surname>D'Avila</surname><given-names>H</given-names></name><name><surname>Teixeira</surname><given-names>HC</given-names></name><name><surname>Ferreira</surname><given-names>AP</given-names></name></person-group><article-title>Production of hydrogen peroxide by peripheral blood monocytes and specific macrophages during experimental infection with <italic>Trypanosoma cruzi</italic> in vivo</article-title><source><italic>Cell Biology International</italic></source><year>2003</year><volume>27</volume><issue>10</issue><fpage>853</fpage><lpage>861</lpage><pub-id pub-id-type="pmid">14499666</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Martins</surname><given-names>GA</given-names></name><name><surname>Cardoso</surname><given-names>MAG</given-names></name><name><surname>Aliberti</surname><given-names>JCS</given-names></name><name><surname>Silva</surname><given-names>JS</given-names></name></person-group><article-title>Nitric oxide-induced apoptotic cell death in the acute phase of <italic>Trypanosoma cruzi</italic> infection in mice</article-title><source><italic>Immunology Letters</italic></source><year>1998</year><volume>63</volume><issue>2</issue><fpage>113</fpage><lpage>120</lpage><pub-id pub-id-type="pmid">9761373</pub-id></element-citation></ref><ref id="B16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bergeron</surname><given-names>M</given-names></name><name><surname>Olivier</surname><given-names>M</given-names></name></person-group><article-title>						<italic>Trypanosoma cruzi</italic>-mediated IFN-<italic>&#x003b3;</italic>-inducible nitric oxide output in macrophages is regulated by <italic>iNOS</italic> mRNA stability</article-title><source><italic>The Journal of Immunology</italic></source><year>2006</year><volume>177</volume><issue>9</issue><fpage>6271</fpage><lpage>6280</lpage><pub-id pub-id-type="pmid">17056557</pub-id></element-citation></ref><ref id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dhiman</surname><given-names>M</given-names></name><name><surname>Estrada-Franco</surname><given-names>JG</given-names></name><name><surname>Pando</surname><given-names>JM</given-names></name><etal/></person-group><article-title>Increased myeloperoxidase activity and protein  nitration are indicators of inflammation in patients with Chagas' disease</article-title><source><italic>Clinical and Vaccine Immunology</italic></source><year>2009</year><volume>16</volume><issue>5</issue><fpage>660</fpage><lpage>666</lpage><pub-id pub-id-type="pmid">19297613</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>P&#x000e9;rez-Fuentes</surname><given-names>R</given-names></name><name><surname>Gu&#x000e9;gan</surname><given-names>J-F</given-names></name><name><surname>Barnab&#x000e9;</surname><given-names>C</given-names></name><etal/></person-group><article-title>Severity of chronic Chagas disease is associated with cytokine/antioxidant imbalance in chronically  individuals</article-title><source><italic>International Journal for Parasitology</italic></source><year>2003</year><volume>33</volume><issue>3</issue><fpage>293</fpage><lpage>299<