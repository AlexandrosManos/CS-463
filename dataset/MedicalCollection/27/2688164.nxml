ge><pub-id pub-id-type="pmid">9112551</pub-id></element-citation></ref><ref id="B5"><label>5</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Allen</surname><given-names>JW</given-names></name><name><surname>Song</surname><given-names>J</given-names></name><name><surname>Velcek</surname><given-names>FT</given-names></name></person-group><article-title>Acute presentation of infected urachal cysts: case report and review of diagnosis and therapeutic interventions</article-title><source>Pediatr Emerg Care</source><year>2004</year><volume>20</volume><fpage>108</fpage><lpage>111</lpage><pub-id pub-id-type="pmid">14758308</pub-id></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nirasawa</surname><given-names>Y</given-names></name><name><surname>Ito</surname><given-names>Y</given-names></name><name><surname>Tanaka</surname><given-names>H</given-names></name><name><surname>Seki</surname><given-names>N</given-names></name></person-group><article-title>Urachal cyst associated with a suprapubic sinus</article-title><source>Pediatr Surg Int</source><year>1999</year><volume>15</volume><fpage>275</fpage><lpage>276</lpage><pub-id pub-id-type="pmid">10370044</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bauer</surname><given-names>SB</given-names></name><name><surname>Retik</surname><given-names>AB</given-names></name></person-group><article-title>Urachal anomalies and related umbilical disorders</article-title><source>Urol Clin North Am</source><year>1978</year><volume>5</volume><fpage>195</fpage><lpage>211</lpage><pub-id pub-id-type="pmid">417444</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Blichert-Toft</surname><given-names>M</given-names></name><name><surname>Nielsen</surname><given-names>OV</given-names></name></person-group><article-title>Congenital patent urachus and acquired variants. Diagnosis and treatment. Review of the literature and report of five cases</article-title><source>Acta Chir Scand</source><year>1971</year><volume>137</volume><fpage>807</fpage><lpage>814</lpage><pub-id pub-id-type="pmid">5148862</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Newman</surname><given-names>BM</given-names></name><name><surname>Karp</surname><given-names>MP</given-names></name><name><surname>Jeweet</surname><given-names>TC</given-names></name><name><surname>Cooney</surname><given-names>DR</given-names></name></person-group><article-title>Advances in the management of infected urachal cysts</article-title><source>J Pediatr Surg</source><year>1986</year><volume>21</volume><fpage>1051</fpage><lpage>1054</lpage><pub-id pub-id-type="pmid">3794969</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>McCollum</surname><given-names>MO</given-names></name><name><surname>Macneily</surname><given-names>AE</given-names></name><name><surname>Blair</surname><given-names>GK</given-names></name></person-group><article-title>Surgical implications of urachal remnants: Presentation and management</article-title><source>J Pediatr Surg</source><year>2003</year><volume>38</volume><fpage>798</fpage><lpage>803</lpage><pub-id pub-id-type="pmid">12720197</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ozbek</surname><given-names>SS</given-names></name><name><surname>Pourbagher</surname><given-names>MA</given-names></name><name><surname>Pourbagher</surname><given-names>A</given-names></name></person-group><article-title>Urachal remnants in asymptomatic children: gray-scale and color Doppler sonographic findings</article-title><source>J Clin Ultrasound</source><year>2001</year><volume>29</volume><fpage>218</fpage><lpage>222</lpage><pub-id pub-id-type="pmid">11323776</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kojima</surname><given-names>Y</given-names></name><name><surname>Miyake</surname><given-names>O</given-names></name><name><surname>Taniwaki</surname><given-names>H</given-names></name><name><surname>Morimoto</surname><given-names>A</given-names></name><name><surname>Takahashi</surname><given-names>S</given-names></name><name><surname>Fujiwara</surname><given-names>I</given-names></name></person-group><article-title>Infected urachal cyst ruptured during medical palliation</article-title><source>Int J Urol</source><year>2003</year><volume>10</volume><fpage>174</fpage><lpage>176</lpage><pub-id pub-id-type="pmid">12622715</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Campanale</surname><given-names>RP</given-names></name><name><surname>Krumbach</surname><given-names>RW</given-names></name></person-group><article-title>Intraperitoneal perforation of infected urachal cyst</article-title><source>Am J Surg</source><year>1955</year><volume>90</volume><fpage>143</fpage><lpage>145</lpage><pub-id pub-id-type="pmid">14388190</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Goldman</surname><given-names>IL</given-names></name><name><surname>Caldamone</surname><given-names>AA</given-names></name><name><surname>Gauderer</surname><given-names>M</given-names></name><name><surname>Hampel</surname><given-names>N</given-names></name><name><surname>Wesselhoeft</surname><given-names>CW</given-names></name><name><surname>Elder</surname><given-names>JS</given-names></name></person-group><article-title>Infected urachal cysts: a review of 10 cases</article-title><source>J Urol</source><year>1988</year><volume>140</volume><fpage>375</fpage><lpage>378</lpage><pub-id pub-id-type="pmid">3398141</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Borten</surname><given-names>M</given-names></name><name><surname>Friedman</surname><given-names>EA</given-names></name></person-group><article-title>Spontaneous prevesical (Retzius-space) abscess with extraperitoneal presacral dissemination. A case report</article-title><source>J Reprod Med</source><year>1984</year><volume>29</volume><fpage>841</fpage><lpage>844</lpage><pub-id pub-id-type="pmid">6394755</pub-id></element-citation></ref><ref id="B16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>MacMillan</surname><given-names>RW</given-names></name><name><surname>Schullinger</surname><given-names>JN</given-names></name><name><surname>Santulli</surname><given-names>TV</given-names></name></person-group><article-title>Pyourachus: an unusual surgical problem</article-title><source>J Pediatr Surg</source><year>1973</year><volume>8</volume><fpage>387</fpage><lpage>389</lpage><pub-id pub-id-type="pmid">4197666</pub-id></element-citation></ref><ref id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nagasaki</surname><given-names>A</given-names></name><name><surname>Handa</surname><given-names>N</given-names></name><name><surname>Kawanami</surname><given-names>T</given-names></name></person-group><article-title>Diagnosis of urachal anomalies in infancy and childhood by contrast fistulography, ultrasound and CT</article-title><source>Pediatr Radiol</source><year>1991</year><volume>21</volume><fpage>321</fpage><lpage>323</lpage><pub-id pub-id-type="pmid">1891254</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cilento</surname><given-names>BG</given-names><suffix>Jr</suffix></name><name><surname>Bauer</surname><given-names>SB</given-names></name><name><surname>Retik</surname><given-names>AB</given-names></name><name><surname>Peters</surname><given-names>CA</given-names></name><name><surname>Atala</surname><given-names>A</given-names></name></person-group><article-title>Urachal anomalies: defining the best diagnostic modality</article-title><source>Urology</source><year>1998</year><volume>52</volume><fpage>120</fpage><lpage>122</lpage><pub-id pub-id-type="pmid">9671882</pub-id></element-citation></ref></ref-list></back><floats-group><fig id="F1" position="float"><label>Fig. 1</label><caption><p>Abdominal ultrasonographic finding of a urachal cyst (longitudinal view). A cystic lesion is shown on the dome area of the urinary bladder (arrow).</p></caption><graphic xlink:href="ymj-47-423-g001"/></fig><fig id="F2" position="float"><label>Fig. 2</label><caption><p>MRI finding of a urachal cyst (arrow, T1-weighted sagittal view).</p></caption><graphic xlink:href="ymj-47-423-g002"/></fig><table-wrap id="T1" position="float"><label>Table 1</label><caption><p>Patient Presentation Details</p></caption><graphic xlink:href="ymj-47-423-i001"/><table-wrap-foot><fn><p>VCUG, voiding cystourethrogram; CT, computed tomography; MRI, magnetic resonance imaging.</p></fn></table-wrap-foot></table-wrap><table-wrap id="T2" position="float"><label>Table 2</label><caption><p>Results of Urinalysis, Urine Culture, Blood and Wound Culture</p></caption><graphic xlink:href="ymj-47-423-i002"/><table-wrap-foot><fn><p>WBC, whit