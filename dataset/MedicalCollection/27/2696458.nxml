ame><name><surname>Scarlato</surname><given-names>G</given-names></name><article-title>IP-10 and MCP-1 levels in CSF and serum from multiple sclerosis patients with different clinical subtypes of the disease</article-title><source>J Neurol Sci</source><year>2002</year><volume>195</volume><fpage>41</fpage><lpage>46</lpage><pub-id pub-id-type="doi">10.1016/S0022-510X(01)00680-3</pub-id><pub-id pub-id-type="pmid">11867072</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Mahad</surname><given-names>DJ</given-names></name><name><surname>Howell</surname><given-names>SJ</given-names></name><name><surname>Woodroofe</surname><given-names>MN</given-names></name><article-title>Expression of chemokines in the CSF and correlation with clinical disease activity in patients with multiple sclerosis</article-title><source>J Neurol Neurosurg Psychiatry</source><year>2002</year><volume>72</volume><fpage>498</fpage><lpage>502</lpage><pub-id pub-id-type="pmid">11909910</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Tanuma</surname><given-names>N</given-names></name><name><surname>Sakuma</surname><given-names>H</given-names></name><name><surname>Sasaki</surname><given-names>A</given-names></name><name><surname>Matsumoto</surname><given-names>Y</given-names></name><article-title>Chemokine expression by astrocytes plays a role in microglia/macrophage activation and subsequent neurodegeneration in secondary progressive multiple sclerosis</article-title><source>Acta Neuropathol</source><year>2006</year><volume>112</volume><fpage>195</fpage><lpage>204</lpage><pub-id pub-id-type="doi">10.1007/s00401-006-0083-7</pub-id><pub-id pub-id-type="pmid">16733654</pub-id></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="journal"><name><surname>Mastorakos</surname><given-names>G</given-names></name><name><surname>Ilias</surname><given-names>I</given-names></name><article-titl