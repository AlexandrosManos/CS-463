n-group-type="author"><name><surname>Ehlting</surname><given-names>B</given-names></name><name><surname>Dluzniewska</surname><given-names>P</given-names></name><name><surname>Dietrich</surname><given-names>H</given-names></name><etal/></person-group><article-title>Interaction of nitrogen nutrition and salinity in Grey poplar (<italic>Populus tremula</italic>&#x000d7;<italic>alba</italic>)</article-title><source>Plant, Cell and Environment</source><year>2007</year><volume>30</volume><fpage>796</fpage><lpage>811</lpage></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Flowers</surname><given-names>TJ</given-names></name><name><surname>Colmer</surname><given-names>TD</given-names></name></person-group><article-title>Salinity tolerance in halophytes</article-title><source>New Phytologist</source><year>2008</year><volume>179</volume><fpage>945</fpage><lpage>963</lpage><pub-id pub-id-type="pmid">18565144</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garcia</surname><given-names>A</given-names></name><name><surname>Rizzo</surname><given-names>CA</given-names></name><name><surname>Ud-Din</surname><given-names>J</given-names></name><name><surname>Bartos</surname><given-names>SL</given-names></name><name><surname>Senadhira</surname><given-names>D</given-names></name><name><surname>Flowers</surname><given-names>TJ</given-names></name><name><surname>Yeo</surname><given-names>AR</given-names></name></person-group><article-title>Sodium and potassium transport to the xylem are inherited independently in rice, and the mechanism of sodium:potassium selectivity differs between rice and wheat</article-title><source>Plant, Cell and Environment</source><year>1997</year><volume>20</volume><fpage>1167</fpage><lpage>1174</lpage></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gobert</surname><given-names>A</given-names></name><name><surname>Park</surname><given-names>G</given-names></name><name><surname>Amtmann</surname><given-names>A</given-names></name><name><surname>Sanders</surname><given-names>D</given-names></name><name><surname>Maathuis</surname><given-names>FJM</given-names></name></person-group><article-title><italic>Arabidopsis thaliana</italic> cyclic nucleotide gated channel 3 forms a non-selective ion transporter involved in germination and cation transport</article-title><source>Journal of Experimental Botany</source><year>2006</year><volume>57</volume><fpage>791</fpage><lpage>800</lpage><pub-id pub-id-type="pmid">16449377</pub-id></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gong</surname><given-names>HJ</given-names></name><name><surname>Randall</surname><given-names>DP</given-names></name><name><surname>Flowers</surname><given-names>TJ</given-names></name></person-group><article-title>Silicon deposition in the root reduces sodium uptake in rice (<italic>Oryza sativa</italic> L.) seedlings by reducing bypass flow</article-title><source>Plant, Cell and Environment</source><year>2006</year><volume>29</volume><fpage>1970</fpage><lpage>1979</lpage></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grabov</surname><given-names>A</given-names></name></person-group><article-title>Plant KT/KUP/HAK potassium transporters: single family&#x02013;multiple functions</article-title><source>Annals of Botany</source><year>2008</year><volume>99</volume><fpage>1035</fpage><lpage>1041</lpage><pub-id pub-id-type="pmid">17495982</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Geisler</surname><given-names>M</given-names></name><name><surname>Axelsen</surname><given-names>KB</given-names></name><name>