nal"><person-group person-group-type="author"><name><surname>Diarra</surname><given-names>D</given-names></name><name><surname>Stolina</surname><given-names>M</given-names></name><name><surname>Polzer</surname><given-names>K</given-names></name><name><surname>Zwerina</surname><given-names>J</given-names></name><name><surname>Ominsky</surname><given-names>MS</given-names></name><name><surname>Dwyer</surname><given-names>D</given-names></name><name><surname>Korb</surname><given-names>A</given-names></name><name><surname>Smolen</surname><given-names>J</given-names></name><name><surname>Hoffmann</surname><given-names>M</given-names></name><name><surname>Scheinecker</surname><given-names>C</given-names></name><name><surname>Heide</surname><given-names>D van der</given-names></name><name><surname>Landewe</surname><given-names>R</given-names></name><name><surname>Lacey</surname><given-names>D</given-names></name><name><surname>Richards</surname><given-names>WG</given-names></name><name><surname>Schett</surname><given-names>G</given-names></name></person-group><article-title>Dickkopf-1 is a master regulator of joint remodeling</article-title><source>Nat Med</source><year>2007</year><volume>13</volume><fpage>156</fpage><lpage>163</lpage><pub-id pub-id-type="pmid">17237793</pub-id><pub-id pub-id-type="doi">10.1038/nm1538</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fujita</surname><given-names>K</given-names></name><name><surname>Janz</surname><given-names>S</given-names></name></person-group><article-title>Attenuation of WNT signaling by DKK-1 and -2 regulates BMP2-induced osteoblast differentiation and expression of OPG, RANKL and M-CSF</article-title><source>Mol Cancer</source><year>2007</year><volume>6</volume><fpage>71</fpage><pub-id pub-id-type="pmid">17971207</pub-id><pub-id pub-id-type="doi">10.1186/1476-4598-6-71</pub-id></citation></ref></ref-list></back></article>