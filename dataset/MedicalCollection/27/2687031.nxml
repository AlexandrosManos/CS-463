p" align="left" rowspan="1" colspan="1"><hr/></td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1">Fur length</td><td valign="top" align="center" rowspan="1" colspan="1">349</td><td valign="top" align="center" rowspan="1" colspan="1">15.5</td><td valign="top" align="center" rowspan="1" colspan="1">0.494</td><td valign="top" align="center" rowspan="1" colspan="1">0.069</td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1"> Short/ medium</td><td valign="top" align="center" rowspan="1" colspan="1">255</td><td valign="top" align="center" rowspan="1" colspan="1">17.6</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1"> Long<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">94<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">9.6<hr/></td><td valign="top" align="left" rowspan="1" colspan="1"><hr/></td><td valign="top" align="left" rowspan="1" colspan="1"><hr/></td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1">Activity</td><td valign="top" align="center" rowspan="1" colspan="1">439</td><td valign="top" align="center" rowspan="1" colspan="1">13.0</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1">&#x0003c;0.001</td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1"> Pet</td><td valign="top" align="center" rowspan="1" colspan="1">258</td><td valign="top" align="center" rowspan="1" colspan="1">8.5</td><td valign="top" align="center" rowspan="1" colspan="1">Ref</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1"> Hunting</td><td valign="top" align="center" rowspan="1" colspan="1">133</td><td valign="top" align="center" rowspan="1" colspan