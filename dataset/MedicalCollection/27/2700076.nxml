e><pub-id pub-id-type="pmid">16396701</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Saltzman</surname><given-names>CL</given-names></name><name><surname>Zimmerman</surname><given-names>MB</given-names></name><name><surname>O'Rourke</surname><given-names>M</given-names></name><name><surname>Brown</surname><given-names>TD</given-names></name><name><surname>Buckwalter</surname><given-names>JA</given-names></name><name><surname>Johnston</surname><given-names>R</given-names></name></person-group><article-title>Impact of comorbidities on the measurement of health in patients with ankle osteoarthritis</article-title><source>J Bone Joint Surg Am</source><year>2006</year><volume>88</volume><fpage>2366</fpage><lpage>72</lpage><pub-id pub-id-type="pmid">17079392</pub-id><pub-id pub-id-type="doi">10.2106/JBJS.F.00295</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Siebens</surname><given-names>HC</given-names></name></person-group><article-title>Musculoskeletal problems as comorbidities</article-title><source>Am J Phys Med Rehabil</source><year>2007</year><volume>86</volume><fpage>S69</fpage><lpage>78</lpage><pub-id pub-id-type="pmid">17370373</pub-id><pub-id pub-id-type="doi">10.1097/PHM.0b013e31802ba581</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sprangers</surname><given-names>MA</given-names></name><name><surname>de Regt</surname><given-names>EB</given-names></name><name><surname>Andries</surname><given-names>F</given-names></name><etal></etal></person-group><article-title>Which chronic conditions are associated with better or poorer quality of life?</article-title><source>J Clin Epidemiol</source><year>2000</year><volume>53</volume><fpage>895</fpage><lpage>907</lpage><pub-id pub-id-type="pmid">11004416</pub-id><pub-id pub-id-typ