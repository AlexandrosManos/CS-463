doi">10.1016/j.ypmed.2004.03.033</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gomez</surname><given-names>SL</given-names></name><name><surname>Tan</surname><given-names>S</given-names></name><name><surname>Keegan</surname><given-names>TH</given-names></name><name><surname>Clarke</surname><given-names>CA</given-names></name></person-group><article-title>Disparities in mammographic screening for Asian women in California: a cross-sectional analysis to identify meaningful groups for targeted intervention</article-title><source>BMC cancer</source><year>2007</year><volume>7</volume><fpage>201</fpage><pub-id pub-id-type="pmid">17961259</pub-id><pub-id pub-id-type="doi">10.1186/1471-2407-7-201</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>J</given-names></name><name><surname>Jang</surname><given-names>SN</given-names></name></person-group><article-title>Socioeconomic Disparities in Breast Cancer Screening among US Women: Trends from 2000 to 2005</article-title><source>Journal of preventive medicine and public health = Yebang Uihakhoe chi</source><year>2008</year><volume>41</volume><fpage>186</fpage><lpage>194</lpage><pub-id pub-id-type="pmid">18515996</pub-id><pub-id pub-id-type="doi">10.3961/jpmph.2008.41.3.186</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kelaher</surname><given-names>M</given-names></name><name><surname>Stellman</surname><given-names>JM</given-names></name></person-group><article-title>The impact of medicare funding on the use of mammography among older women: implications for improving access to screening</article-title><source>Prev Med</source><year>2000</year><volume>31</volume><fpage>658</fpage><lpage>664</lpage><pub-id pub-id-type="pmid">11133332</pub-id><pub-id pub-id-type="d