e></person-group><year>1943</year><article-title>The chemical nature of compounds which inhibit the function of the thyroid gland</article-title><source>J Pharmacol Exper Therap</source><volume>78</volume><fpage>79</fpage><lpage>89</lpage></mixed-citation></ref><ref id="b7-co-2-295"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Burnet</surname><given-names>FM</given-names></name></person-group><year>1959</year><article-title>Autoimmune disease</article-title><source>BMJ</source><volume>2</volume><fpage>645</fpage><lpage>50</lpage><fpage>720</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">13806210</pub-id></mixed-citation></ref><ref id="b8-co-2-295"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bottazzo</surname><given-names>GF</given-names></name><name><surname>Florin-Christensen</surname><given-names>A</given-names></name><name><surname>Doniach</surname><given-names>D</given-names></name></person-group><year>1974</year><article-title>Islet cell antibodies in diabetes mellitus with autoimmune polyendocrine deficiencies</article-title><source>Lancet</source><volume>2</volume><fpage>1279</fpage><lpage>83</lpage><pub-id pub-id-type="pmid">4139522</pub-id></mixed-citation></ref><ref id="b9-co-2-295"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cheynier</surname><given-names>R</given-names></name><name><surname>Henrickwark</surname><given-names>S</given-names></name><name><surname>Wain-Hobson</surname><given-names>S</given-names></name></person-group><year>1998</year><article-title>Somatic hypermutation in the T cell receptor V beta gene in microdissected splenic white pulps from HIV-1-positive patients</article-title><source>European J Immunology</source><volume>28</volume><fpage>1604</fpage><lpage>10</lpage><pub-id pub-id-type="pmid">9603466</pub-id></mixed-citation></ref><ref id="b10-co-2-295"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Englert</surname><given-names>H</given-names></name><name><surname>Katelaris</surname><given-names>C</given-names></name><name><surname>McGill</surname><given-names>N</given-names></name><etal/></person-group><year>2005</year><article-title>&#x0201c;Grape-sultana&#x0201d; sign represents a favourable response to aggressive treatment of early diffuse systemic scleroderma&#x0201d;</article-title><source>Intern Med J</source><volume>35</volume><fpage>436</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15958118</pub-id></mixed-citation></ref><ref id="b11-co-2-295"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Fisher</surname><given-names>AJ</given-names></name><name><surname>Rutherford</surname><given-names>RM</given-names></name><name><surname>Bozzino</surname><given-names>J</given-names></name><etal/></person-group><year>2005</year><article-title>The safety and efficacy of total lymphoid irradiation in progressive bronchiolitis obliterans syndrome after lung transplantation</article-title><source>American J Transplant</source><volume>5</volume><fpage>537</fpage><lpage>43</lpage></mixed-citation></ref><ref id="b12-co-2-295"><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Graves</surname><given-names>RJ</given-names></name></person-group><year>1838</year><source>Clinical lectures</source><publisher-loc>Philadelphia</publisher-loc><publisher-name>Adam Waldie</publisher-name><fpage>134</fpage><lpage>6</lpage></mixed-citation></ref><ref id="b13-co-2-295"><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Harington</surname><given-names>CR</given-names></name></person-group><year>1933</year><source>The thyroid gland</source><publisher-loc>London</publisher-loc><publisher-name>Oxford Univ Pr</publisher-name></mixed-citation></ref><ref id="b14-co-2-295"><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Kelly</surname><given-names>FC</given-names></name><name><surname>Snedden</surname><given-names>WW</given-names></name></person-group><year>1960</year><source>Prevalence and geographic distribution of endemic goitre</source><publisher-loc>Geneva</publisher-loc><publisher-name>World Health Organisation</publisher-name></mixed-citation></ref><ref id="b15-co-2-295"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kennedy</surname><given-names>TH</given-names></name></person-group><year>1942</year><article-title>Thioureas as goitrogenic substances</article-title><source>Nature</source><volume>150</volume><fpage>233</fpage><lpage>4</lpage></mixed-citation></ref><ref id="b16-co-2-295"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kriss</surname><given-names>JP</given-names></name><name><surname>Pleshakov</surname><given-names>V</given-names></name><name><surname>Rosenblum</surname><given-names>AL</given-names></name><etal/></person-group><year>1967</year><article-title>Studies on the pathogenesis of the ophthalmopathy of Graves&#x02019; disease</article-title><source>J Clin Endocrinol Metab</source><volume>27</volume><fpage>582</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">6071430</pub-id></mixed-citation></ref><ref id="b17-co-2-295"><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Klintworth</surname><given-names>GK</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Rubin</surname><given-names>E</given-names></name><name><surname>Farber</surname><given-names>JL</given-names></name></person-group><year>1988</year><article-title>The eye</article-title><source>Pathology</source><edition>2nd edn</edition><publisher-loc>Philadelphia</publisher-loc><publisher-name>Lippincott</publisher-name><fpage>1456</fpage><lpage>83</lpage></mixed-citation></ref><ref id="b18-co-2-295"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nayac</surname><given-names>RC</given-names></name><name><surname>Agardh</surname><given-names>E</given-names></name><name><surname>Kwok</surname><given-names>MG</given-names></name><etal/></person-group><year>2005</year><article-title>Albinuria and hypertension are independently associated with circulating antipericyte autoantibodies in type 2 diabetic patients</article-title><source>Metabolism</source><volume>54</volume><fpage>188</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">15690312</pub-id></mixed-citation></ref><ref id="b19-co-2-295"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nayac</surname><given-names>RC</given-names></name><name><surname>Lynch</surname><given-names>K</given-names></name><name><surname>Gustavsson</surname><given-names>C</given-names></name><etal/></person-group><year>2007</year><article-title>Circulating antipericyte autoantibodies: a novel modifier of risk of progression of diabetic retinopathy</article-title><source>Retina</source><volume>27</volume><fpage>211</fpage><lpage>15</lpage><pub-id pub-id-type="pmid">17290204</pub-id></mixed-citation></ref><ref id="b20-co-2-295"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Purves</surname><given-names>HD</given-names></name></person-group><year>1974</year><article-title>The aetiology and prophylaxis of endemic goitre and cretinism</article-title><source>New Zealand Med J</source><volume>80</volume><fpage>477</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">4532198</pub-id></mixed-citation></ref><ref id="b21-co-2-295"><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Rundle</surname><given-names>FF</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Pitt-Rivers</surname><given-names>R</given-names></name><name><surname>Trotter</surname><given-names>WR</given-names></name></person-group><year>1964</year><article-title>The eye signs of Graves&#x02019; disease</article-title><source>The thyroid gland</source><volume>2</volume><publisher-loc>London</publisher-loc><publisher-name>Butterworth</publisher-name><fpage>171</fpage><lpage>97</lpage></mixed-citation></ref><ref id="b22-co-2-295"><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Sherwin</surname><given-names>RS</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Goldman</surname><given-names>L</given-names></name><name><surname>Bennett</surname><given-names>JC</given-names></name></person-group><year>2000</year><article-title>Diabetes mellitus</article-title><source>Cecil Textbook of Medicine</source><edition>21st edn</edition><publisher-loc>Philadelphia</publisher-loc><publisher-name>Saunders</publisher-name><fpage>1267</fpage><lpage>8</lpage></mixed-citation></ref></ref-list></back><floats-group><fig id="f1-co-2-295" position="float"><label>Figure 1</label><caption><p>Diabetic retinopathy, illustrating the loss of pericytes and associated collapse of the vasculature. Copyright &#x000a9; 1988. Reprinted with permission from <xref ref-type="bibr" rid="b17-co-2-295">Klintworth GK. 1988</xref>. The eye. In: Rubin E, Farber JL (eds). Pathology. 2nd edn. Philadelphia: Lippincott, pp. 1456&#x02013;83.</p></caption><graphic xlink:href="co-2-295f1"/></fig></floats-group></article>