e><pub-id pub-id-type="doi">10.1016/j.annemergmed.2004.09.012</pub-id><pub-id pub-id-type="pmid">16271675</pub-id></mixed-citation></ref><ref id="CR13"><label>13.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jaimes</surname><given-names>F</given-names></name><name><surname>Farbiarz</surname><given-names>J</given-names></name><name><surname>Alvarez</surname><given-names>D</given-names></name><name><surname>Mart&#x000ed;nez</surname><given-names>C</given-names></name></person-group><article-title>Comparison between logistic regression and neural networks to predict death in patients with suspected sepsis in the emergency room</article-title><source>Crit Care</source><year>2005</year><volume>9</volume><issue>2</issue><fpage>R150</fpage><lpage>R156</lpage><pub-id pub-id-type="doi">10.1186/cc3054</pub-id><pub-id pub-id-type="pmid">15774048</pub-id></mixed-citation></ref><ref id="CR14"><label>14.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Heckerling</surname><given-names>PS</given-names></name><name><surname>Gerber</surname><given-names>BS</given-names></name><name><surname>Tape</surname><given-names>TG</given-names></name><name><surname>Wigton</surname><given-names>RS</given-names></name></person-group><article-title>Prediction of community-acquired pneumonia using artificial neural networks</article-title><source>Med Decis Making</source><year>2003</year><volume>23</volume><issue>2</issue><fpage>112</fpage><lpage>121</lpage><pub-id pub-id-type="doi">10.1177/0272989X03251247</pub-id><pub-id pub-id-type="pmid">12693873</pub-id></mixed-citation></ref><ref id="CR15"><label>15.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bekta&#x0015f;</surname><given-names>F</given-names></name><name><surname>Eken</surname><given-names>C</given-names></name><name><surname>Soyuncu</surname><given-names>S</giv