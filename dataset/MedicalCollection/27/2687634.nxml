ven-names></name></person-group><person-group person-group-type="editor"><name><surname>Finnie</surname><given-names>NR</given-names></name></person-group><article-title>Speech</article-title><source>Handling the young child with cerebral palsy at home</source><year>1997</year><edition>3rd ed</edition><publisher-loc>Oxford</publisher-loc><publisher-name>Butterworth-Heinemann</publisher-name><fpage>112</fpage><lpage>117</lpage></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Stamer</surname><given-names>MH</given-names></name></person-group><source>Posture and movement of the child with cerebral palsy</source><year>2000</year><publisher-loc>San Antonio, Texas</publisher-loc><publisher-name>Therapy Skill Builders</publisher-name><fpage>79</fpage></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Leopando</surname><given-names>MT</given-names></name><name><surname>Moussavi</surname><given-names>Z</given-names></name><name><surname>Holbrow</surname><given-names>J</given-names></name><name><surname>Chernick</surname><given-names>V</given-names></name><name><surname>Pasterkamp</surname><given-names>H</given-names></name><name><surname>Rempel</surname><given-names>G</given-names></name></person-group><article-title>Effect of a soft Boston orthosis on pulmonary mechanics in severe cerebral palsy</article-title><source>Pediatr Pulmonol</source><year>1999</year><volume>28</volume><fpage>53</fpage><lpage>58</lpage><pub-id pub-id-type="pmid">10406051</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>De Troyer</surname><given-names>A</given-names></name><name><surname>Deisser</surname><given-names>P</given-names></name></person-group><article-title>The effects of intermittent positive pressure breathing on patients with respiratory muscle weakness</article-title><source>Am Rev Respir Dis</source><year>1981</year><volume>124</volume><fpage>132</fpage><lpage>137</lpage><pub-id pub-id-type="pmid">7020511</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Estenne</surname><given-names>M</given-names></name><name><surname>De Troyer</surname><given-names>A</given-names></name></person-group><article-title>The effects of tetraplegia on chest wall statics</article-title><source>Am Rev Respir dis</source><year>1986</year><volume>134</volume><fpage>121</fpage><lpage>124</lpage><pub-id pub-id-type="pmid">2942066</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bach</surname><given-names>JR</given-names></name><name><surname>Bianchi</surname><given-names>C</given-names></name></person-group><article-title>Prevention of pectus excavatum for children with spinal muscular atrophy type 1</article-title><source>Am J Phys Med Rehabil</source><year>2003</year><volume>82</volume><fpage>815</fpage><lpage>819</lpage><pub-id pub-id-type="pmid">14508413</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lissoni</surname><given-names>A</given-names></name><name><surname>Aliverti</surname><given-names>A</given-names></name><name><surname>Molteni</surname><given-names>F</given-names></name><name><surname>Bach</surname><given-names>JR</given-names></name></person-group><article-title>Spinal muscular atrophy: kinematic breathing analysis</article-title><source>Am J Phys Med Rehabil</source><year>1996</year><volume>75</volume><fpage>332</fpage><lpage>339</lpage><pub-id pub-id-type="pmid">8873699</pub-id></elemen