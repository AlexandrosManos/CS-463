me><surname>Quinn</surname><given-names>JP</given-names></name></person-group><article-title>Current concepts in antibiotic-resistant Gramnegative bacteria</article-title><source>Expert Rev Anti Infect Ther</source><year>2007</year><volume>5</volume><fpage>833</fpage><lpage>843</lpage><pub-id pub-id-type="pmid">17914917</pub-id><pub-id pub-id-type="doi">10.1586/14787210.5.5.833</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bhattacharjee</surname><given-names>I</given-names></name><name><surname>Chatterjee</surname><given-names>SK</given-names></name><name><surname>Chatterjee</surname><given-names>S</given-names></name><name><surname>Chandra</surname><given-names>G</given-names></name></person-group><article-title>Antibacterial potentiality of <italic>Argemone mexicana </italic>solvent extracts against some pathogenic bacteria</article-title><source>Mem Inst Oswaldo Cruz</source><year>2006</year><volume>101</volume><fpage>645</fpage><lpage>648</lpage><pub-id pub-id-type="pmid">17072477</pub-id><pub-id pub-id-type="doi">10.1590/S0074-02762006000600011</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koduru</surname><given-names>S</given-names></name><name><surname>Grierson</surname><given-names>DS</given-names></name><name><surname>Afolayan</surname><given-names>AJ</given-names></name></person-group><article-title>Antimicrobial activity of <italic>Solanum aculeastrum</italic></article-title><source>Pharm Biol</source><year>2006</year><volume>44</volume><fpage>283</fpage><lpage>286</lpage><pub-id pub-id-type="doi">10.1080/13880200600714145</pub-id></citation></ref><ref id="B9"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lorenzi</surname><given-names>H</given-names></name></person-group><source><italic>&#x000c1;rvores brasileiras: manual de identifica&#x000e7;&#x000e3;o e cultivo de plantas arb&#x000f3;reas nativas do Brasil</italic></source><year>1998</year><publisher-name>S&#x000e3;o Paulo: Ed. Plantarum-Nova Odessa</publisher-name></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Joly</surname><given-names>AB</given-names></name></person-group><source><italic>Bot&#x000e2;nica: Introdu&#x000e7;&#x000e3;o &#x000e0; taxonomia vegetal</italic></source><year>1998</year><publisher-name>S&#x000e3;o Paulo: Companhia Editora Nacional</publisher-name></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weinberg</surname><given-names>MLD</given-names></name><name><surname>Gottlieb</surname><given-names>OR</given-names></name><name><surname>De Oliveira</surname><given-names>GG</given-names></name></person-group><article-title>The chemistry of Brazilian Bignoniaceae. Part 2. Naphthoquinones from <italic>Zeyhera tuberculosa</italic></article-title><source>Phytochemistry</source><year>1976</year><volume>15</volume><fpage>570</fpage><pub-id pub-id-type="doi">10.1016/S0031-9422(00)88983-9</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gupta</surname><given-names>RB</given-names></name><name><surname>Khanna</surname><given-names>RN</given-names></name></person-group><article-title>An unambiguous synthesis of 4-hydroxy- <italic>alpha </italic>-lapachone and its <italic>beta </italic>isomer</article-title><source>Indian J Chem</source><year>1978</year><volume>16B</volume><fpage>35</fpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kutney</surname><given-names>JP</given-names></name><name><surname>Hanssen</surname><given-names>HW</given-names></name></person-group><article-title>5,6,7-Trimethoxyflavone and 5,6,7,8-tetramethoxyflavone from <italic>Zeyhera tuberculosa</italic></article-title><source>Phytochemistry</source><year>1971</year><volume>10</volume><fpage>3298</fpage><lpage>3302</lpage><pub-id pub-id-type="doi">10.1016/S0031-9422(00)97399-0</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bauer</surname><given-names>AW</given-names></name><name><surname>Kirby</surname><given-names>E</given-names></name><name><surname>Sherris</surname><given-names>EM</given-names></name><name><surname>Turk</surname><given-names>M</given-names></name></person-group><article-title>Antibiotic by standardized single disk method</article-title><source>Am J Clin Pathol</source><year>1966</year><volume>45</volume><fpage>493</fpage><lpage>496</lpage><pub-id pub-id-type="pmid">5325707</pub-id></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><collab>National Committee for Clinical Laboratory Standards</collab></person-group><source>Methods for dilution antimicrobial susceptibility tests for bacteria that grow aerobically: approved standard &#x02013; 8th ed., NCCLS document M7-A6 and MIC testing supplemental tables M100-S13 &#x02013; 6th ed</source><year>2003</year><publisher-name>NCCLS, Wayne, Pennsylvania, USA</publisher-name></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><collab>National Committee for Clinical Laboratory Standards</collab></person-group><source>National Committee for clinical laboratory standards for antimicrobial disk susceptibility tests: approved standards</source><year>2005</year><edition>6</edition><publisher-name>NCCLS, Wayne, Pennsylvania, USA</publisher-name></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chandrasekaran</surname><given-names>M</given-names></name><name><surname>Venkatesalu</surname><given-names>V</given-names></name></person-group><article