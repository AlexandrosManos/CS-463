mes></name><name><surname>Katzenstein</surname><given-names>DA</given-names></name><name><surname>Maldonado</surname><given-names>Y</given-names></name><name><surname>Hill</surname><given-names>D</given-names></name><name><surname>Bassett</surname><given-names>MT</given-names></name></person-group><article-title>The feasibility of voluntary counseling and HIV testing for pregnant women using community volunteers in Zimbabwe</article-title><source>International Journal of STD &#x00026; AIDS</source><year>2005</year><volume>16</volume><fpage>755</fpage><lpage>759</lpage><pub-id pub-id-type="pmid">16303072</pub-id><pub-id pub-id-type="doi">10.1258/095646205774763090</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grinstead</surname><given-names>OA</given-names></name><name><surname>Straten</surname><given-names>A Van Der</given-names></name><collab>The Voluntary HIV-1 Counseling and Testing Efficacy Study Group</collab></person-group><article-title>Counsellors' perspectives on the experience of providing HIV counselling in Kenya and Tanzania: the voluntary HIV-1 counselling and testing efficacy study group</article-title><source>AIDS Care</source><year>2000</year><volume>12</volume><fpage>625</fpage><lpage>642</lpage><pub-id pub-id-type="pmid">11218548</pub-id><pub-id pub-id-type="doi">10.1080/095401200750003806</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zachariah</surname><given-names>R</given-names></name><name><surname>Teck</surname><given-names>R</given-names></name><name><surname>Buhendwa</surname><given-names>L</given-names></name><name><surname>Labana</surname><given-names>S</given-names></name><name><surname>Chinji</surname><given-names>C</given-names></name><name><surname>Humblet</surname><given-names>P</given-names></name><name><surname>Harries</surname><given-names>AD</given-names></name></person-group><article-title>How can the community contribute in the fight against HIV/AIDS and tuberculosis? An example from a rural district in Malawi</article-title><source>Transactions of the Royal Society of Tropical Medicine and Hygiene</source><year>2006</year><volume>100</volume><fpage>167</fpage><lpage>175</lpage><pub-id pub-id-type="pmid">16214192</pub-id><pub-id pub-id-type="doi">10.1016/j.trstmh.2005.07.008</pub-id></citation></ref></ref-list></back></article>