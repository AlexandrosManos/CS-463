owspan="1" colspan="1">7&#x02013;12</td><td align="left" rowspan="1" colspan="1">10</td><td align="left" rowspan="1" colspan="1">33</td><td align="left" rowspan="1" colspan="1">1.20</td><td align="left" rowspan="1" colspan="1">0.97(0.61&#x02013;1.54)</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">13&#x02013;24</td><td align="left" rowspan="1" colspan="1">12</td><td align="left" rowspan="1" colspan="1">42</td><td align="left" rowspan="1" colspan="1">1.13</td><td align="left" rowspan="1" colspan="1">0.83(0.47&#x02013;1.45)</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">&#x0003e;24</td><td align="left" rowspan="1" colspan="1">11</td><td align="left" rowspan="1" colspan="1">45</td><td align="left" rowspan="1" colspan="1">0.97</td><td align="left" rowspan="1" colspan="1">0.99(0.63&#x02013;1.55)</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Overall</td><td align="left" rowspan="1" colspan="1">51</td><td align="left" rowspan="1" colspan="1">184</td><td align="left" rowspan="1" colspan="1">1.10</td><td align="left" rowspan="1" colspan="1">1.14(0.90&#x02013;1.43)</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Past Use</td><td align="left" rowspan="1" colspan="1">41</td><td align="left" rowspan="1" colspan="1">134</td><td align="left" rowspan="1" colspan="1">1.19</td><td align="left" rowspan="1" colspan="1">0.94(0.74&#x02013;1.19)</td></tr><tr><td align="left" rowspan="1" colspan="1">Pioglitazone</td><td align="left" rowspan="1" colspan="1">1&#x02013;6</td><td align="left" rowspan="1" colspan="1">18</td><td align="left" rowspan="1" colspan="1">64</td><td align="left" rowspan="1" colspan="1">1.12</td><td align="left" rowspan="1" colspan="1">1.21 (0.72&#x02013;2.04)</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">7&#x02013;12</td><td ali