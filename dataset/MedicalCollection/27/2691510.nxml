align="center" rowspan="1" colspan="1"><bold>95% CI</bold></th><th valign="top" align="center" rowspan="1" colspan="1"><bold>p</bold></th></tr></thead><tbody><tr><td valign="top" align="left" rowspan="1" colspan="1">Urobilinogen</td><td valign="top" align="center" rowspan="1" colspan="1">3.58</td><td valign="top" align="center" rowspan="1" colspan="1">1.29, 9.03</td><td valign="top" align="center" rowspan="1" colspan="1">0.0024</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Urine bilirubin</td><td valign="top" align="center" rowspan="1" colspan="1">4.32</td><td valign="top" align="center" rowspan="1" colspan="1">1.11, 14.45</td><td valign="top" align="center" rowspan="1" colspan="1">0.0052</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Urine hemoglobin</td><td valign="top" align="center" rowspan="1" colspan="1">3.41</td><td valign="top" align="center" rowspan="1" colspan="1">1.65, 7.75</td><td valign="top" align="center" rowspan="1" colspan="1">0.0004</td></tr><tr><td align="left" valign="top" colspan="4" rowspan="1"><hr/></td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="center" rowspan="1" colspan="1"><bold>No injury</bold></td><td valign="top" align="center" rowspan="1" colspan="1"><bold>Injury</bold></td><td valign="top" align="center" rowspan="1" colspan="1"><bold>Total</bold></td></tr><tr><td align="left" valign="top" colspan="4" rowspan="1"><hr/></td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">No urobilinogen</td><td valign="top" align="center" rowspan="1" colspan="1">439 (90%)</td><td valign="top" align="center" rowspan="1" colspan="1">49 (10%)</td><td valign="top" align="center" rowspan="1" colspan="1">488</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Urobilinogen</td><td valign="top" align="center" rowspan="1" colspan="1">20 (71%)</td><td valign="top" align="center" rowspan="1" colspan="1">8 (29%)</td><td valign="top" align="center" row