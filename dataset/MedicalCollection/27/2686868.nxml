2"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pillon</surname><given-names>B</given-names></name><name><surname>Dubois</surname><given-names>B</given-names></name></person-group><article-title>Memory and executive processes in corticobasal degeneration</article-title><source>Adv Neurol</source><year>2000</year><volume>82</volume><fpage>91</fpage><lpage>101</lpage><pub-id pub-id-type="pmid">10624474</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Graham</surname><given-names>NL</given-names></name><name><surname>Bak</surname><given-names>TH</given-names></name><name><surname>Hodges</surname><given-names>JR</given-names></name></person-group><article-title>Corticobasal degeneration as a cognitive disorder</article-title><source>Mov Disord</source><year>2003</year><volume>18</volume><fpage>1224</fpage><lpage>1232</lpage><pub-id pub-id-type="pmid">14639661</pub-id></citation></ref><ref id="B14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Caine</surname><given-names>D</given-names></name></person-group><article-title>Posterior cortical atrophy: a review of the literature</article-title><source>Neurocase</source><year>2004</year><volume>10</volume><fpage>382</fpage><lpage>385</lpage><pub-id pub-id-type="pmid">15788276</pub-id></citation></ref></ref-list></back><floats-wrap><fig id="F1" position="float"><label>Figure 1</label><caption><p>Brain MRI showing significant cortical atrophy in both parietal areas, which was more prominent on the left side with diffuse cortical atrophic changes in T1-weighted images.</p></caption><graphic xlink:href="jcn-4-94-g001"/></fig><fig id="F2" position="float"><label>Figure 2</label><caption><p>Brain FDG-PET imaging with SPM analysis showing prominent asymmetric (left-dominant) hypometabolism on both parietal and left temporal areas. Significant hypometabolism was also observed in both frontal lobes.</p></caption><graphic xlink:href="jcn-4-94-g002"/></fig><table-wrap id="T1" position="float"><label>Table</label><caption><p>Detailed neuropsychological assessment results in our patient with corticobasal degeneration (CBD)</p></caption><graphic xlink:href="jcn-4-94-i001"/><table-wrap-foot><fn><p>K-BNT; Korean version of the Boston Naming Test, Rey CFT; Rey-Osterrieth Complex Figure Test, K-MMSE; Korean version of the Mini-Mental State Examination.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>