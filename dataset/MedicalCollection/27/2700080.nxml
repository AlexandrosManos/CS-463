016/j.bej.2005.04.003</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hermann</surname><given-names>R</given-names></name><name><surname>Walther</surname><given-names>N</given-names></name><name><surname>Maier</surname><given-names>U</given-names></name><name><surname>B&#x000fc;chs</surname><given-names>J</given-names></name></person-group><article-title>Optical method for the determination of the oxygen-transfer capacity of small bioreactors based on sulfite oxidation</article-title><source>Biotechnology and Bioengineering</source><year>2001</year><volume>74</volume><fpage>355</fpage><lpage>363</lpage><pub-id pub-id-type="pmid">11427937</pub-id><pub-id pub-id-type="doi">10.1002/bit.1126</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kensy</surname><given-names>F</given-names></name><name><surname>Zimmermann</surname><given-names>HF</given-names></name><name><surname>Knabben</surname><given-names>I</given-names></name><name><surname>Anderlei</surname><given-names>T</given-names></name><name><surname>Trauthwein</surname><given-names>H</given-names></name><name><surname>Dingerdissen</surname><given-names>U</given-names></name><name><surname>Buchs</surname><given-names>J</given-names></name></person-group><article-title>Oxygen transfer phenomena in 48-well microtiter plates: determination by optical monitoring of sulfite oxidation and verification by real-time measurement during microbial growth</article-title><source>Biotechnol Bioeng</source><year>2005</year><volume>89</volume><fpage>698</fpage><lpage>708</lpage><pub-id pub-id-type="pmid">15696519</pub-id><pub-id pub-id-type="doi">10.1002/bit.20373</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lu</surname><given-names>C</given-names></name><name><surname>Bentley</surname><giv