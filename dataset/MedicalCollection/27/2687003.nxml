<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:mml="http://www.w3.org/1998/Math/MathML" article-type="other" xml:lang="EN"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Emerg Infect Dis</journal-id><journal-id journal-id-type="publisher-id">EID</journal-id><journal-title>Emerging Infectious Diseases</journal-title><issn pub-type="ppub">1080-6040</issn><issn pub-type="epub">1080-6059</issn><publisher><publisher-name>Centers for Disease Control and Prevention</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmc">2687003</article-id><article-id pub-id-type="publisher-id">08-1412</article-id><article-id pub-id-type="doi">10.3201/eid1505.081412</article-id><article-categories><subj-group subj-group-type="heading"><subject>Another Dimension</subject></subj-group></article-categories><title-group><article-title>Nothing But Tears</article-title></title-group><contrib-group><contrib contrib-type="author" corresp="yes"><name><surname>Krysan</surname><given-names>Damian J.</given-names></name></contrib></contrib-group><author-notes><corresp id="cor1">Address for correspondence: Damian J. Krysan, University of Rochester Pediatrics, Box 850, 601 Elmwood Ave, Rochester, NY 14642, USA; email: <email xlink:href="damian_krysan@urmc.rochester.edu">damian_krysan@urmc.rochester.edu</email></corresp></author-notes><pub-date pub-type="ppub"><month>5</month><year>2009</year></pub-date><volume>15</volume><issue>5</issue><fpage>854</fpage><lpage>854</lpage></article-meta></front><body><verse-group><verse-line>What do I do</verse-line><verse-line>My little one,</verse-line><verse-line>Lying oh so low?</verse-line><verse-line>Is all that I do</verse-line><verse-line>For me or for you,</verse-line><verse-line>Hoping for a cure?</verse-line><verse-line>Do I take your hand,</verse-line><verse-line>Do I let you lie,</verse-line><verse-line>Do I leave you alone in the snow?</verse-line><verse-line>To do no harm,</verse-line><verse-line>To close my bag,</verse-line><verse-line>To treat you with nothing but tears.</verse-line></verse-group></body><back><fn-group><fn fn-type="citation"><p><italic>Suggested citation for this article</italic>: Krysan DJ. Nothing but tears [another dimension]. 2009 May [<italic>date cited</italic>]. Available from <ext-link ext-link-type="uri" xlink:href="http://www.cdc.gov/EID/content/15/5/854.htm">http://www.cdc.gov/EID/content/15/5/854.htm</ext-link></p></fn></fn-group><bio><p>Dr Krysan is assistant professor of pediatrics in the Division of Pediatric Infectious Diseases, University of Rochester Pediatrics, Rochester, New York. His research interests are yeast cell wall biology, <italic>Candida albicans</italic> genetics, and high-throughput screening for antifungal drugs.</p></bio></back></article>