="top" align="left" rowspan="1" colspan="1">Palmer et al 2001<xref ref-type="bibr" rid="b82-ndt-5-137">82</xref></td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Prostate cancer</td><td valign="top" align="left" rowspan="1" colspan="1">0.42</td><td valign="top" align="left" rowspan="1" colspan="1">Palmer et al 2001<xref ref-type="bibr" rid="b82-ndt-5-137">82</xref></td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Colorectal cancer</td><td valign="top" align="left" rowspan="1" colspan="1">0.35</td><td valign="top" align="left" rowspan="1" colspan="1">Palmer et al 2001<xref ref-type="bibr" rid="b82-ndt-5-137">82</xref></td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Breast cancer</td><td valign="top" align="left" rowspan="1" colspan="1">0.27</td><td valign="top" align="left" rowspan="1" colspan="1">Palmer et al 2001<xref ref-type="bibr" rid="b82-ndt-5-137">82</xref></td></tr></tbody></table><table-wrap-foot><fn id="tfn1-ndt-5-137"><p><bold>Abbreviation:</bold> ADHD, adult attention deficit hyperactivity disorder.</p></fn></table-wrap-foot></table-wrap><table-wrap id="t2-ndt-5-137" position="float"><label>Table 2</label><caption><p>Prevalence of depression comorbid with ADHD</p></caption><table frame="hsides" rules="groups"><thead><tr><th valign="middle" align="left" rowspan="1" colspan="1"><bold>Reference</bold></th><th valign="middle" align="left" rowspan="1" colspan="1"><bold>Prevalence of depression with ADHD</bold></th></tr></thead><tbody><tr><td valign="top" align="left" rowspan="1" colspan="1">Biederman et al 2008<xref ref-type="bibr" rid="b55-ndt-5-137">55</xref></td><td valign="top" align="left" rowspan="1" colspan="1">40.7%</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Able et al 2007<xref ref-type="bibr" rid="b21-ndt-5-137">21</xref></td><td valign="top" align="left" rowspan="1" colspan="1">31.0%</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Kessler et al 2006<xr