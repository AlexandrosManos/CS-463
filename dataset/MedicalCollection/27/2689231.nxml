<lpage>6428</lpage><pub-id pub-id-type="pmid">16923784</pub-id><pub-id pub-id-type="doi">10.1128/IAI.00639-06</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Ang</surname><given-names>CS</given-names></name><name><surname>Veith</surname><given-names>PD</given-names></name><name><surname>Dashper</surname><given-names>SG</given-names></name><name><surname>Reynolds</surname><given-names>EC</given-names></name><article-title>Application of 16O/18O reverse proteolytic labeling to determine the effect of biofilm culture on the cell envelope proteome of <italic>Porphyromonas gingivalis </italic>W50</article-title><source>Proteomics</source><year>2008</year><volume>8</volume><fpage>1645</fpage><lpage>1660</lpage><pub-id pub-id-type="doi">10.1002/pmic.200700557</pub-id><pub-id pub-id-type="pmid">18409167</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Aas</surname><given-names>JA</given-names></name><name><surname>Paster</surname><given-names>BJ</given-names></name><name><surname>Stokes</surname><given-names>LN</given-names></name><name><surname>Olsen</surname><given-names>I</given-names></name><name><surname>Dewhirst</surname><given-names>FE</given-names></name><article-title>Defining the normal bacterial flora of the oral cavity</article-title><source>J Clin Microbiol</source><year>2005</year><volume>43</volume><fpage>5721</fpage><lpage>5732</lpage><pub-id pub-id-type="pmid">16272510</pub-id><pub-id pub-id-type="doi">10.1128/JCM.43.11.5721-5732.2005</pub-id></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="journal"><name><surname>Kuboniwa</surname><given-names>M</given-names></name><name><surname>Tribble</surname><given-names>GD</given-names></name><name><surname>James</surname><given-names>CE</given-names></name><name><surname>Kilic</surname><given-names>AO</given-names></name><name><surname>Tao</surname><given-names>L</given-names></name><nam