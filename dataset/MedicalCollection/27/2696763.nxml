td align="left" valign="top" charoff="50">&#x02003;2</td><td align="char" valign="top" char="." charoff="50">67</td><td align="char" valign="top" char="." charoff="50">37</td><td align="char" valign="top" char="." charoff="50">30</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">0.3671</td><td align="char" valign="top" char="." charoff="50">0.8012</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;3</td><td align="char" valign="top" char="." charoff="50">75</td><td align="char" valign="top" char="." charoff="50">45</td><td align="char" valign="top" char="." charoff="50">30</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">0.2621</td><td align="char" valign="top" char="." charoff="50">0.8066</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Unknown</td><td align="char" valign="top" char="." charoff="50">10</td><td align="char" valign="top" char="." charoff="50">5</td><td align="char" valign="top" char="." charoff="50">5</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td><td align="char" valign="top" char="." charoff="50">&#x000a0;</td></tr><tr><td colspan="7" align="left" valign="top" charoff="50"><italic>NPI</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;1 (good)</td><td align="char" valign="top" char="." charoff="50">42</td><td alig