</year><volume>4</volume><fpage>215</fpage><lpage>223</lpage></mixed-citation></ref><ref id="b25-ijerph-06-01609"><label>25.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hadi</surname><given-names>A</given-names></name></person-group><article-title>Fighting arsenic at the grassroots: experience of BRAC`s community awareness initiative in Bangladesh</article-title><source>Health Policy Plann</source><year>2003</year><volume>18</volume><fpage>83</fpage><lpage>100</lpage></mixed-citation></ref><ref id="b26-ijerph-06-01609"><label>26.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Paul</surname><given-names>BK</given-names></name></person-group><article-title>Arsenic contamination awareness among the rural residents in Bangladesh</article-title><source>Soc. Sci. Med</source><year>2004</year><volume>59</volume><fpage>1741</fpage><lpage>1755</lpage><pub-id pub-id-type="pmid">15279930</pub-id></mixed-citation></ref><ref id="b27-ijerph-06-01609"><label>27.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rosado</surname><given-names>JL</given-names></name><name><surname>Ronquillo</surname><given-names>D</given-names></name><name><surname>Kordas</surname><given-names>K</given-names></name><name><surname>Rojas</surname><given-names>O</given-names></name><name><surname>Alatorre</surname><given-names>J</given-names></name><name><surname>Lopez</surname><given-names>P</given-names></name><name><surname>Garcia-Vargas</surname><given-names>G</given-names></name><name><surname>Caamano</surname><given-names>MC</given-names></name><name><surname>Cebrian</surname><given-names>ME</given-names></name><name><surname>Stoltzfus</surname><given-names>R</given-names></name></person-group><article-title>Arsenic exposure and cognitive performance in mexican schoolchildren</article-title><source>Environ. Health Perspect</