ource><year>2001</year><volume>7</volume><fpage>1142</fpage><lpage>1152</lpage><pub-id pub-id-type="pmid">11497432</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Zimmerly</surname><given-names>S</given-names></name><name><surname>Hausner</surname><given-names>G</given-names></name><name><surname>Wu</surname><given-names>X</given-names></name></person-group><article-title>Phylogenetic relationships among group II intron ORFs</article-title><source>Nucleic Acids Res.</source><year>2001</year><volume>29</volume><fpage>1238</fpage><lpage>1250</lpage><pub-id pub-id-type="pmid">11222775</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dai</surname><given-names>L</given-names></name><name><surname>Chai</surname><given-names>D</given-names></name><name><surname>Gu</surname><given-names>SQ</given-names></name><name><surname>Gabel</surname><given-names>J</given-names></name><name><surname>Noskov</surname><given-names>SY</given-names></name><name><surname>Blocker</surname><given-names>FJ</given-names></name><name><surname>Lambowitz</surname><given-names>AM</given-names></name><name><surname>Zimmerly</surname><given-names>S</given-names></name></person-group><article-title>A three-dimensional model of a group II intron RNA and its interaction with the intron-encoded reverse transcriptase</article-title><source>Mol. Cell</source><year>2008</year><volume>30</volume><fpage>1</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">18406319</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Toor</surname><given-names>N</given-names></name><name><surname>Keating</surname><given-names>KS</given-names></name><name><surname>Taylor</surname><given-names>SD<