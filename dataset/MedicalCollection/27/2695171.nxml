ext-link-type="uri" xlink:href="http://www.cdc.gov/ncipc/falls/fallprev.pdf">http://www.cdc.gov/ncipc/falls/fallprev.pdf</ext-link></citation></ref><ref id="b12-cia-0102-169"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ignatavicius</surname><given-names>D</given-names></name></person-group><year>2000</year><article-title>Do you help staff rise to the fall-prevention challenge?</article-title><source>Nurs Manage</source><volume>31</volume><fpage>27</fpage><lpage>31</lpage><pub-id pub-id-type="pmid">10818937</pub-id></citation></ref><ref id="b13-cia-0102-169"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnson</surname><given-names>M</given-names></name><name><surname>Cusick</surname><given-names>A</given-names></name><name><surname>Chang</surname><given-names>S</given-names></name></person-group><year>2001</year><article-title>Home-screen: a short scale to measure fall risk in the home</article-title><source>Public Health Nurs</source><volume>18</volume><fpage>169</fpage><lpage>77</lpage><pub-id pub-id-type="pmid">11359618</pub-id></citation></ref><ref id="b14-cia-0102-169"><citation citation-type="book"><person-group person-group-type="editor"><name><surname>Kohn</surname><given-names>LT</given-names></name><name><surname>Corrigan</surname><given-names>J</given-names></name><name><surname>Donaldson</surname><given-names>MS</given-names></name></person-group><year>2000</year><source>To err is human: building a safer health system</source><publisher-loc>Washington DC</publisher-loc><publisher-name>Nat Acad Press</publisher-name></citation></ref><ref id="b15-cia-0102-169"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Morse</surname><given-names>J</given-names></name></person-group><year>1997</year><source>Preventing patient falls</source><publisher-loc>Thousand Oaks CA</publisher-loc><publisher-name>SAGE</publisher-name></citation></ref><