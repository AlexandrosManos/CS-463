628</lpage><pub-id pub-id-type="doi">10.1038/360627a0</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mayr</surname><given-names>E</given-names></name></person-group><article-title>A local flora and the biological species concept</article-title><source>Am J Bot</source><year>1992</year><volume>79</volume><fpage>222</fpage><lpage>238</lpage><pub-id pub-id-type="doi">10.2307/2445111</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rieseberg</surname><given-names>LH</given-names></name><name><surname>Wood</surname><given-names>TE</given-names></name><name><surname>Baack</surname><given-names>EJ</given-names></name></person-group><article-title>The nature of plant species</article-title><source>Nature</source><year>2006</year><volume>440</volume><fpage>524</fpage><lpage>527</lpage><pub-id pub-id-type="pmid">16554818</pub-id><pub-id pub-id-type="doi">10.1038/nature04402</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rieseberg</surname><given-names>LH</given-names></name><name><surname>Brouillet</surname><given-names>L</given-names></name></person-group><article-title>Are many plant species paraphyletic?</article-title><source>Taxon</source><year>1994</year><volume>43</volume><fpage>21</fpage><lpage>32</lpage><pub-id pub-id-type="doi">10.2307/1223457</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chase</surname><given-names>MW</given-names></name><name><surname>Cowan</surname><given-names>RS</given-names></name><name><surname>Hollingsworth</surname><given-names>PM</given-names></name><name><surname>Berg</surname><given-names>C van den</given-names></name><name><surname>Madri&#x000f1;&#x000e1;n</surname><given-names>S</given-names></name><name><surname>Pe