l:mtext><mml:mn>,</mml:mn></mml:mrow></mml:mtd></mml:mtr><mml:mtr><mml:mtd columnalign="left"><mml:mrow><mml:mo minsize="1em" maxsize="1em">(</mml:mo><mml:mo minsize="1em" maxsize="1em">(</mml:mo><mml:mo minsize="1em" maxsize="1em">(</mml:mo><mml:msubsup><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mi>v</mml:mi></mml:mrow><mml:mrow><mml:mo stretchy="false">(</mml:mo><mml:mi>n</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mrow></mml:msubsup><mml:mo>&#x02009;</mml:mo><mml:mi>&#x02009;</mml:mi><mml:mn>.</mml:mn><mml:mo>*</mml:mo><mml:msubsup><mml:mrow><mml:mi>E</mml:mi></mml:mrow><mml:mrow><mml:mi>v</mml:mi></mml:mrow><mml:mrow><mml:mo stretchy="false">(</mml:mo><mml:mi>n</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mrow></mml:msubsup><mml:mo minsize="1em" maxsize="1em">)</mml:mo><mml:msub><mml:mrow><mml:mstyle mathsize="normal"><mml:mrow><mml:mn mathvariant="bold">1</mml:mn></mml:mrow></mml:mstyle></mml:mrow><mml:mrow><mml:mi>K</mml:mi></mml:mrow></mml:msub><mml:mo minsize="1em" maxsize="1em">)</mml:mo></mml:mrow></mml:mtd><mml:mtd/></mml:mtr><mml:mtr><mml:mtd columnalign="left"><mml:mi>&#x02009;</mml:mi><mml:mi>&#x02009;</mml:mi><mml:mn>.</mml:mn><mml:mo>/</mml:mo><mml:mo minsize="1em" maxsize="1em">(</mml:mo><mml:msubsup><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mi>v</mml:mi></mml:mrow><mml:mrow><mml:mo stretchy="false">(</mml:mo><mml:mi>n</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mrow></mml:msubsup><mml:msub><mml:mrow><mml:mstyle mathsize="normal"><mml:mrow><mml:mn mathvariant="bold">1</mml:mn></mml:mrow></mml:mstyle></mml:mrow><mml:mrow><mml:mi>K</mml:mi></mml:mrow></mml:msub><mml:mo minsize="1em" maxsize="1em">)</mml:mo><mml:mo minsize="1em" maxsize="1em">)</mml:mo><mml:msubsup><mml:mrow><mml:mstyle mathsize="normal"><mml:mrow><mml:mn mathvariant="bold">1</mml:mn></mml:mrow></mml:mstyle></mml:mrow><mml:mrow><mml:mi>K</mml:mi></mml:mrow><mml:mrow><mml:mo>&#x022a4;</mml:mo></mml:mrow></mml:msubsup><mml:mn>,</mml:mn></mml:mtd><mml: