roup-type="author"><name><surname>Fisher</surname><given-names>RA</given-names></name></person-group><article-title>Frequency distributions of the values of the correlation coefficient in samples from an indefinitely large population</article-title><source><italic>Biometrika</italic></source><year>1915</year><volume>10</volume><issue>4</issue><fpage>507</fpage><lpage>521</lpage></element-citation></ref><ref id="B21"><label>21</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hawkins</surname><given-names>DL</given-names></name></person-group><article-title>Using <italic>U</italic> statistics to derive the asymptotic distribution of Fisher's <italic>Z</italic> statistic</article-title><source><italic>The American Statistician</italic></source><year>1989</year><volume>43</volume><issue>4</issue><fpage>235</fpage><lpage>237</lpage></element-citation></ref><ref id="B22"><label>22</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>W&#x000fc;lfert</surname><given-names>F</given-names></name><name><surname>Kok</surname><given-names>WTh</given-names></name><name><surname>Smilde</surname><given-names>AK</given-names></name></person-group><article-title>Influence of temperature on vibrational spectra and consequences for the predictive ability of multivariate models</article-title><source><italic>Analytical Chemistry</italic></source><year>1998</year><volume>70</volume><issue>9</issue><fpage>1761</fpage><lpage>1767</lpage></element-citation></ref><ref id="B23"><label>23</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Snee</surname><given-names>RD</given-names></name></person-group><article-title>Validation of regression models: methods and examples</article-title><source><italic>Technometrics</italic></source><year>1977</year><volume>19</volume><issue>4</issue><fpage>415</fpage><lpage>428</lpage></elemen