itation citation-type="journal"><person-group person-group-type="author"><name><surname>M&#x000fc;ller</surname><given-names>WH</given-names></name><name><surname>van Aelst</surname><given-names>AC</given-names></name><name><surname>van der Krift</surname><given-names>TP</given-names></name><name><surname>Boekhout</surname><given-names>T</given-names></name></person-group><year>1994</year><article-title>Scanning electron microscopy of the septal pore cap of the basidiomycete <italic>Schizophyllum commune</italic>.</article-title><source>Can J Microbiol</source><volume>40</volume><fpage>879</fpage><lpage>883</lpage></citation></ref><ref id="pone.0005977-Trinci1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Trinci</surname><given-names>APJ</given-names></name><name><surname>Collinge</surname><given-names>AJ</given-names></name></person-group><year>1974</year><article-title>Occlusion of the septal pores of damaged hyphae of <italic>Neurospora crassa</italic> by hexagonal crystals.</article-title><source>Protoplasma</source><volume>80</volume><fpage>57</fpage><lpage>67</lpage><pub-id pub-id-type="pmid">4275239</pub-id></citation></ref><ref id="pone.0005977-Aylmore1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Aylmore</surname><given-names>RC</given-names></name><name><surname>Wakley</surname><given-names>GE</given-names></name><name><surname>Todd</surname><given-names>NK</given-names></name></person-group><year>1984</year><article-title>Septal sealing in the basidiomycete <italic>Coriolus versicolor</italic>.</article-title><source>J Gen Microbiol</source><volume>130</volume><fpage>2975</fpage><lpage>2982</lpage></citation></ref><ref id="pone.0005977-Markham1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Markham</surname><given-names>P</given-names></name></person-group><year>1994</year