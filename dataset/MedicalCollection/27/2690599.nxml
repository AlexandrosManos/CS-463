ub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Zellweger</surname><given-names>JP</given-names></name><name><surname>Zellweger</surname><given-names>A</given-names></name><name><surname>Ansermet</surname><given-names>S</given-names></name><article-title>Contact tracing using a new T-cell-based test: better correlation with tuberculosis exposure than the tuberculin skin test</article-title><source>Int J Tuberc Lung Dis</source><year>2005</year><volume>9</volume><fpage>1242</fpage><lpage>1247</lpage><pub-id pub-id-type="pmid">16333932</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Nienhaus</surname><given-names>A</given-names></name><name><surname>Schablon</surname><given-names>A</given-names></name><name><surname>Bacle</surname><given-names>CL</given-names></name><article-title>Evaluation of the interferon-gamma release assay in healthcare workers</article-title><source>Int Arch Occup Environ Health</source><year>2008</year><volume>81</volume><fpage>295</fpage><lpage>300</lpage><pub-id pub-id-type="doi">10.1007/s00420-007-0212-1</pub-id><pub-id pub-id-type="pmid">17605033</pub-id></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="journal"><name><surname>Tissot</surname><given-names>F</given-names></name><name><surname>Zanetti</surname><given-names>G</given-names></name><name><surname>Francioli</surname><given-names>P</given-names></name><article-title>Influence of bacille Calmette-Guerin vaccination on size of tuberculin skin test reaction: to what size?</article-title><source>Clin Infect Dis</source><year>2005</year><volume>40</volume><fpage>211</fpage><lpage>217</lpage><pub-id pub-id-type="doi">10.1086/426434</pub-id><pub-id pub-id-type="pmid">15655737</pub-id></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="journal"><name><surname>Alvi</surname><given-names>AR</given-names></name><name><surname>Hussain</surname><gi