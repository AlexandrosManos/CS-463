e="doi">10.1016/j.eurpsy.2004.06.031</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tunis</surname><given-names>SL</given-names></name><name><surname>Faries</surname><given-names>DE</given-names></name><name><surname>Nyhuis</surname><given-names>AW</given-names></name><name><surname>Kinon</surname><given-names>BJ</given-names></name><name><surname>Ascher-Svanum</surname><given-names>H</given-names></name><name><surname>Aquila</surname><given-names>R</given-names></name></person-group><article-title>Cost-effectiveness of olanzapine as first-line treatment for schizophrenia: results from a randomized, open-label, 1-year trial</article-title><source>Value Health</source><year>2006</year><volume>9</volume><fpage>77</fpage><lpage>89</lpage><pub-id pub-id-type="pmid">16626411</pub-id><pub-id pub-id-type="doi">10.1111/j.1524-4733.2006.00083.x</pub-id></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Ruud</surname><given-names>T</given-names></name><name><surname>Gr&#x000e5;we</surname><given-names>RW</given-names></name><name><surname>Hatling</surname><given-names>T</given-names></name></person-group><source>Acute Psychiatric Treatment in Norway &#x02013; results from a multicenter study (In Norwegian)</source><year>2006</year><publisher-name>Sintef Helse, Trondheim, Norway</publisher-name></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Karterud</surname><given-names>S</given-names></name><name><surname>Pedersen</surname><given-names>G</given-names></name><name><surname>Loevdahl</surname><given-names>H</given-names></name><name><surname>Friis</surname><given-names>S</given-names></name></person-group><source>Global Assessment of Functioning &#x02013; Split Version (S-GAF): Background and Scoring Manual</source><year>1998</year><publisher-name>Ullev&#x000e5;l University Hospital, Department of Psychiatry. Oslo, Norway</publisher-name></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><collab>American Psychiatric Assosiation</collab></person-group><source>Diagnostic and Statistical Manual of Mental Disorders</source><year>1994</year><edition>4</edition><publisher-name>American Psychiatric Publishing, Washington DC</publisher-name></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wing</surname><given-names>JK</given-names></name><name><surname>Beevor</surname><given-names>AS</given-names></name><name><surname>Curtis</surname><given-names>RH</given-names></name><name><surname>Park</surname><given-names>SB</given-names></name><name><surname>Hadden</surname><given-names>S</given-names></name><name><surname>Burns</surname><given-names>A</given-names></name></person-group><article-title>Health of the Nation Outcome Scales (HoNOS). Research and development</article-title><source>Br J Psychiatry</source><year>1998</year><volume>172</volume><fpage>11</fpage><lpage>18</lpage><pub-id pub-id-type="pmid">9534825</pub-id><pub-id pub-id-type="doi">10.1192/bjp.172.1.11</pub-id></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><collab>World Health Organization</collab></person-group><source>The ICD-10 Classification of Mental and Behavioural Disorders, Clinical Description and Diagnostic Guidelines</source><year>1992</year><publisher-name>World Health Organization, Geneva</publisher-name></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bazire</surname><given-names>S</given-names></name></person-group><source>Psychotropic Drug Directory</source><year>2005</year><publisher-name>Fivepin Limited, Salisbury</publisher-name></citation></ref><ref id="B19"><citation citation-type="journal"><person-group 