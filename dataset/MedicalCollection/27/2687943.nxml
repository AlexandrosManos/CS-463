e>Trends Genet.</source><year>2001</year><volume>17</volume><fpage>388</fpage><lpage>391</lpage><pub-id pub-id-type="pmid">11418218</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Llinas</surname><given-names>M</given-names></name><etal/></person-group><article-title>Comparative whole genome transcriptome analysis of three <italic>Plasmodium falciparum</italic> strains</article-title><source>Nucleic Acids Res.</source><year>2006</year><volume>34</volume><fpage>1166</fpage><lpage>1173</lpage><pub-id pub-id-type="pmid">16493140</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Monks</surname><given-names>SA</given-names></name><etal/></person-group><article-title>Genetic inheritance of gene expression in human cell lines</article-title><source>Am. J. Hum. Genet.</source><year>2004</year><volume>75</volume><fpage>1094</fpage><lpage>1105</lpage><pub-id pub-id-type="pmid">15514893</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Petretto</surname><given-names>E</given-names></name><etal/></person-group><article-title>Heritability and tissue specificity of expression quantitative trait loci</article-title><source>PLoS Genet</source><year>2006</year><volume>2</volume><fpage>e172</fpage><pub-id pub-id-type="pmid">17054398</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Quackenbush</surname><given-names>J</given-names></name></person-group><article-title>Microarray data normalization and transformation</article-title><source>Nat. Genet.</source><year>2002</year><volume>32</volume><fpage>496</fpage><lpage>501</lpage><pub-id pub-id-type="pmid">12454644</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rockman</surname><given-names>MV</given-names></name><name><surname>Kruglyak</surname><given-names>L</given-names></name></person-group><article-title>Genetics of global gene expression</article-title><source>Nat. Rev. Genet.</source><year>2006</year><volume>7</volume><fpage>862</fpage><lpage>872</lpage><pub-id pub-id-type="pmid">17047685</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sen</surname><given-names>S</given-names></name><name><surname>Churchill</surname><given-names>GA</given-names></name></person-group><article-title>A statistical framework for quantitative trait mapping</article-title><source>Genetics</source><year>2001</year><volume>159</volume><fpage>371</fpage><lpage>387</lpage><pub-id pub-id-type="pmid">11560912</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Storey</surname><given-names>JD</given-names></name><etal/></person-group><article-title>Multiple locus linkage analysis of genomewide expression in yeast</article-title><source>PLoS Biol.</source><year>2005</year><volume>3</volume><fpage>e267</fpage><pub-id pub-id-type="pmid">16035920</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Storey</surname><given-names>JD</given-names></name><name><surname>Tibshirani</surname><given-names>R</given-names></name></person-group><article-title>Statistical significance for genomewide studies</article-title><source>Proc. Natl Acad. Sci. USA</source><year>2003</year><volume>100</volume><fpage>9440</fpage><lpage>9445</lpage><pub-id pub-id-type="pmid">12883005</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stranger</surname><given-names>BE</given-names></name><etal/></person-group><article-title>Genome-wide associations of gene expression variation in humans</article-title><source>PLoS Genet.</source><year>2005</year><volume>1</volume><fpage>e78</fpage><pub-id pub-id-type="pmid">16362079</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stranger</surname><given-names>BE</given-names></name><etal/></person-group><article-title>Population genomics of human gene expression</article-title><source>Nat. Genet.</source><year>2007</year><volume>39</volume><fpage>1217</fpage><lpage>1224</lpage><pub-id pub-id-type="pmid">17873874</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Su</surname><given-names>XZ</given-names></name><name><surname>Wootton</surname><given-names>JC</given-names></name></person-group><article-title>Genetic mapping in the human malaria parasite <italic>Plasmodium falciparum</italic></article-title><source>Mol. Microbiol.</source><year>2004</year><volume>53</volume><fpage>1573</fpage><lpage>1582</lpage><pub-id pub-id-type="pmid">15341640</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yvert</surname><given-names>G</given-names></name><etal/></person-group><article-title>Trans-acting regulatory variation in Saccharomyces cerevisiae and the role of transcription factors</article-title><source>Nat. Genet.</source><year>2003</year><volume>35</volume><fpage>57</fpage><lpage>64</lpage><pub-id pub-id-type="pmid">12897782</pub-id></citation></ref></ref-list></back></article>