bel>12.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dartsch</surname><given-names>P. C.</given-names></name><name><surname>Hammerle</surname><given-names>H.</given-names></name></person-group><article-title>Orientation response of arterial smooth muscle cells to mechanical stimulation</article-title><source>Eur. J. Cell Biol.</source><year>1986</year><volume>41</volume><fpage>339</fpage><lpage>346</lpage></citation><citation citation-type="display-unstructured">Dartsch, P.C. and Hammerle, H. 1986 Orientation response of arterial smooth muscle cells to mechanical stimulation. Eur. J. Cell Biol. 41, 339&#x02013;346. <pub-id pub-id-type="pmid">3530766</pub-id></citation></ref><ref id="CR13"><label>13.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eastwood</surname><given-names>M.</given-names></name><name><surname>Mudera</surname><given-names>V. C.</given-names></name><name><surname>McGrouther</surname><given-names>D. A.</given-names></name><name><surname>Brown</surname><given-names>R. A.</given-names></name></person-group><article-title>Effect of precise mechanical loading on fibroblast populated collagen lattices: morphological changes</article-title><source>Cell Motil. Cytoskeleton</source><year>1998</year><volume>40</volume><fpage>13</fpage><lpage>21</lpage><pub-id pub-id-type="doi">10.1002/(SICI)1097-0169(1998)40:1&#x0003c;13::AID-CM2&#x0003e;3.0.CO;2-G</pub-id></citation><citation citation-type="display-unstructured">Eastwood, M., Mudera, V.C., McGrouther, D.A., and Brown, R.A. 1998 Effect of precise mechanical loading on fibroblast populated collagen lattices: morphological changes. Cell Motil. Cytoskeleton 40, 13&#x02013;21. doi:10.1002/(SICI)1097-0169(1998)40:1&#x0003c;13::AID-CM2&#x0003e;3.0.CO;2-G <pub-id pub-id-type="pmid">9605968</pub-id></citation></ref><ref id="CR14"><label>14.</label><citation citation-type="journal"><person-group person-group-type="a