>1992</year><volume>38</volume><fpage>135</fpage><lpage>43</lpage><pub-id pub-id-type="pmid">1574608</pub-id><pub-id pub-id-type="doi">10.1016/0167-0115(92)90052-V</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bhogal</surname><given-names>R</given-names></name><name><surname>Smith</surname><given-names>DM</given-names></name><name><surname>Bloom</surname><given-names>SR</given-names></name></person-group><article-title>Investigation and characterization of binding sites for islet amyloid polypeptide in rat membranes</article-title><source>Endocrinology</source><year>1992</year><volume>130</volume><fpage>906</fpage><lpage>13</lpage><pub-id pub-id-type="pmid">1310282</pub-id><pub-id pub-id-type="doi">10.1210/en.130.2.906</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mulder</surname><given-names>H</given-names></name><name><surname>Lindh</surname><given-names>AC</given-names></name><name><surname>Ekblad</surname><given-names>E</given-names></name><name><surname>Westermark</surname><given-names>P</given-names></name><name><surname>Sundler</surname><given-names>F</given-names></name></person-group><article-title>Islet amyloid polypeptide is expressed in endocrine cells of the gastric mucosa in the rat and mouse</article-title><source>Gastroenterology</source><year>1994</year><volume>107</volume><fpage>712</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">8076756</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tingstedt</surname><given-names>JE</given-names></name><name><surname>Edlund</surname><given-names>H</given-names></name><name><surname>Madsen</surname><given-names>OD</given-names></name><name><surname>Larsson</surname><given-names>LI</given-names></name></person-group><article-title>Gastric amylin expression. Cellular ide