e><source>Virus Research</source><year>2004</year><volume>106</volume><fpage>147</fpage><lpage>165</lpage><pub-id pub-id-type="pmid">15567494</pub-id><pub-id pub-id-type="doi">10.1016/j.virusres.2004.08.012</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schmitt</surname><given-names>AP</given-names></name><name><surname>Lamb</surname><given-names>RA</given-names></name></person-group><article-title>Influenza virus assembly and budding at the viral budozone</article-title><source>Advances in Virus Research</source><year>2005</year><volume>64</volume><fpage>383</fpage><lpage>416</lpage><pub-id pub-id-type="pmid">16139601</pub-id><pub-id pub-id-type="doi">10.1016/S0065-3527(05)64012-2</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cros</surname><given-names>JF</given-names></name><name><surname>Palese</surname><given-names>P</given-names></name></person-group><article-title>Trafficking of viral genomic RNA into and out of the nucleus: influenza, Thogoto and Borna disease viruses</article-title><source>Virus Research</source><year>2003</year><volume>95</volume><fpage>3</fpage><lpage>12</lpage><pub-id pub-id-type="pmid">12921991</pub-id><pub-id pub-id-type="doi">10.1016/S0168-1702(03)00159-X</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garcia-Robles</surname><given-names>I</given-names></name><name><surname>Akarsu</surname><given-names>H</given-names></name><name><surname>Muller</surname><given-names>CW</given-names></name><name><surname>Ruigrok</surname><given-names>RWH</given-names></name><name><surname>Baudin</surname><given-names>F</given-names></name></person-group><article-title>Interaction of influenza virus proteins with nucleosomes</article-title><source>Virology</source><year>2005</year><volume>332</volume><fpage>329<