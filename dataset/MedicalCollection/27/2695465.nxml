icle-title><source>J Mol Catal B:Enzym</source><year>2003</year><volume>22</volume><fpage>329</fpage><lpage>338</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tanaka</surname><given-names>A</given-names></name><name><surname>Sugimoto</surname><given-names>H</given-names></name><name><surname>Muta</surname><given-names>Y</given-names></name><name><surname>Mizuno</surname><given-names>T</given-names></name><name><surname>Senoo</surname><given-names>K</given-names></name><name><surname>Obata</surname><given-names>H</given-names></name><name><surname>Inouye</surname><given-names>K</given-names></name></person-group><article-title>Differential scanning Calorimetry of the effects of Ca2+ on the thermal unfolding of Pseudomonas cepacia lipase</article-title><source>Biosci Biotechnol Biochem</source><year>2003</year><volume>67</volume><fpage>207</fpage><lpage>210</lpage><pub-id pub-id-type="pmid">12619699</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lang</surname><given-names>D</given-names></name><name><surname>Hofmann</surname><given-names>B</given-names></name><name><surname>Haalck</surname><given-names>L</given-names></name><name><surname>Hecht</surname><given-names>HJ</given-names></name><name><surname>Spener</surname><given-names>F</given-names></name><name><surname>Schmid</surname><given-names>RD</given-names></name><name><surname>Schomburg</surname><given-names>D</given-names></name></person-group><article-title>Crystal structure of a bacterial lipase from Chromobacterium viscosum ATCC 6918 refined at 1.6 angstrom resolution</article-title><source>J Mol Biol</source><year>1996</year><volume>259</volume><fpage>704</fpage><lpage>717</lpage><pub-id pub-id-type="pmid">8683577</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thure