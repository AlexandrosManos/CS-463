-title>Caspase activity plays an essential role in long-term memory</article-title>. <source>Neuroreport</source><volume>11</volume>, <fpage>2811</fpage>&#x02013;<lpage>2816</lpage><pub-id pub-id-type="doi">10.1097/00001756-200008210-00040</pub-id><pub-id pub-id-type="pmid">10976968</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Maria</surname><given-names>R.</given-names></name><name><surname>Zeuner</surname><given-names>A.</given-names></name><name><surname>Eramo</surname><given-names>A.</given-names></name><name><surname>Domenichelli</surname><given-names>C.</given-names></name><name><surname>Bonci</surname><given-names>D.</given-names></name><name><surname>Grignani</surname><given-names>F.</given-names></name><name><surname>Srinivasula</surname><given-names>S. M.</given-names></name><name><surname>Alnemri</surname><given-names>E. S.</given-names></name><name><surname>Testa</surname><given-names>U.</given-names></name><name><surname>Peschle</surname><given-names>C.</given-names></name></person-group> (<year>1999</year>). <article-title>Negative regulation of erythropoiesis by caspase-mediated cleavage of GATA-1</article-title>. <source>Nature</source><volume>401</volume>, <fpage>489</fpage>&#x02013;<lpage>493</lpage><pub-id pub-id-type="doi">10.1038/46809</pub-id><pub-id pub-id-type="pmid">10519553</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>DeBotton</surname><given-names>S.</given-names></name><name><surname>Sabri</surname><given-names>S.</given-names></name><name><surname>Daugas</surname><given-names>E.</given-names></name><name><surname>Zermati</surname><given-names>Y.</given-names></name><name><surname>Guidotti</surname><given-names>J. E.</given-names></name><name><surname>Hermine</surname><given-names>O.</given-names></name><name><surname>Kroemer</surname><given-names>G.</given-names></name>