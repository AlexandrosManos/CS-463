-title><source>Am Rev Respir Dis</source><volume>103</volume><fpage>57</fpage><lpage>67</lpage><pub-id pub-id-type="pmid">5540840</pub-id></citation></ref><ref id="b14-copd-2-189"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morris</surname><given-names>JF</given-names></name><name><surname>Temple</surname><given-names>WP</given-names></name><name><surname>Koski</surname><given-names>A</given-names></name></person-group><year>1973</year><article-title>Normal values for the ratio of one-second forced expiratory volume to forced vital capacity</article-title><source>Am Rev Respir Dis</source><volume>108</volume><fpage>1000</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">4741868</pub-id></citation></ref><ref id="b15-copd-2-189"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morris</surname><given-names>JF</given-names></name></person-group><year>1976</year><article-title>Spirometry in the evaluation of pulmonary function</article-title><source>West J Med</source><volume>125</volume><fpage>110</fpage><lpage>18</lpage><pub-id pub-id-type="pmid">969495</pub-id></citation></ref><ref id="b16-copd-2-189"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pellegrino</surname><given-names>R</given-names></name><name><surname>Viegi</surname><given-names>G</given-names></name><name><surname>Brusasco</surname><given-names>V</given-names></name><etal/></person-group><year>2005</year><article-title>ATS/ERS Task Force: Standardisation of lung function testing. Interpretative strategies for lung function tests</article-title><source>Eur Respir J</source><volume>26</volume><fpage>948</fpage><lpage>68</lpage><pub-id pub-id-type="pmid">16264058</pub-id></citation></ref><ref id="b17-copd-2-189"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Quanjer</surname><given-names>P</given-names></name><name><surname>Dalhuijsen</