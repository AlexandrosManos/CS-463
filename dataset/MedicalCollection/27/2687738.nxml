/year><volume>128</volume><fpage>941</fpage><lpage>949</lpage><pub-id pub-id-type="pmid">11098136</pub-id></element-citation></ref><ref id="B16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kawaguchi</surname><given-names>N</given-names></name><name><surname>Sundberg</surname><given-names>C</given-names></name><name><surname>Kveiborg</surname><given-names>M</given-names></name><name><surname>Moghadaszadeh</surname><given-names>B</given-names></name><name><surname>Asmar</surname><given-names>M</given-names></name><name><surname>Dietrich</surname><given-names>N</given-names></name><etal/></person-group><article-title>ADAM12 induces actin cytoskeleton and extracellular matrix reorganization during early adipocyte differentiation by regulating beta1 integrin function</article-title><source>J Cell Sci</source><year>2003</year><volume>116</volume><fpage>3893</fpage><lpage>3904</lpage><pub-id pub-id-type="pmid">12915587</pub-id></element-citation></ref><ref id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Loechel</surname><given-names>F</given-names></name><name><surname>Fox</surname><given-names>JW</given-names></name><name><surname>Murphy</surname><given-names>G</given-names></name><name><surname>Albrechtsen</surname><given-names>R</given-names></name><name><surname>Wewer</surname><given-names>UM</given-names></name></person-group><article-title>ADAM 12-S cleaves IGFBP-3 and IGFBP-5 and is inhibited by TIMP-3</article-title><source>Biochem Biophys Res Commun</source><year>2000</year><volume>278</volume><fpage>511</fpage><lpage>515</lpage><pub-id pub-id-type="pmid">11095942</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lum</surname><given-names>L</given-names></name><name><surname>Reid</surname><given-names