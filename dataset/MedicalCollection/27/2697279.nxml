="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/></tr><tr><td align="left" valign="bottom" rowspan="1" colspan="1">Right amygdala</td><td align="center" valign="bottom" rowspan="1" colspan="1">none</td><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/></tr><tr><td align="left" valign="bottom" rowspan="1" colspan="1">Left inferior frontal (BA 9)</td><td align="center" valign="bottom" rowspan="1" colspan="1">304</td><td align="center" valign="bottom" rowspan="1" colspan="1">4.09</td><td align="center" valign="bottom" rowspan="1" colspan="1">-40</td><td align="center" valign="bottom" rowspan="1" colspan="1">18</td><td align="center" valign="bottom" rowspan="1" colspan="1">30</td></tr><tr><td align="left" valign="bottom" rowspan="1" colspan="1">Right inferior frontal</td><td align="center" valign="bottom" rowspan="1" colspan="1">none</td><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/></tr><tr><td align="left" valign="bottom" rowspan="1" colspan="1">Left insula</td><td align="center" valign="bottom" rowspan="1" colspan="1">none</td><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/></tr><tr><td align="left" valign="bottom" rowspan="1" colspan="1">Right insula</td><td align="center" valign="bottom" rowspan="1" colspan="1">164</td><td align="center" valign="bottom" rowspan="1" colspan="1">3.29</td><td align="center" valign="bottom" rowspan="1" colspan="1">40</td><td align="center" valign="bottom" rowspan="1" colspan="1">-2</td><td align="center" valign="bottom" rowspan="1" colspan="1">2</td></tr><tr><td align="left" valign="bottom" rowspan="1" colspan="1">Left striatum (putamen, nucleus accumbens)</td><td align="center" valign="bottom" rowspan="1" colspan="1">161</td><td align="center" valign="bottom" rowspan="1" colspan="1">3.64</td><td align="center" valign="bottom" rowspan="1" colspan="1">-18</td><td align="center" valign="bottom" rowspan="1" colspan="1">8</td><td align="center" valign="bottom" rowspan="1" colspan="1">6</td></tr><tr><td align="left" valign="bottom" rowspan="1" colspan="1">Right striatum</td><td align="center" valign="bottom" rowspan="1" colspan="1">none</td><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/></tr><tr><td align="left" valign="bottom" rowspan="1" colspan="1">Left thalamus</td><td align="center" valign="bottom" rowspan="1" colspan="1">265</td><td align="center" valign="bottom" rowspan="1" colspan="1">3.35</td><td align="center" valign="bottom" rowspan="1" colspan="1">-10</td><td align="center" valign="bottom" rowspan="1" colspan="1">-2</td><td align="center" valign="bottom" rowspan="1" colspan="1">4</td></tr><tr><td align="left" valign="bottom" rowspan="1" colspan="1">Right thalamus</td><td align="center" valign="bottom" rowspan="1" colspan="1">none</td><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1"/></tr><tr><td align="left" valign="bottom" rowspan="1" colspan="1">Occipital lobe (BA 17,18)</td><td align="center" valign="bottom" rowspan="1" colspan="1">934</td><td align="center" valign="bottom" rowspan="1" colspan="1">3.87</td><td align="center" valign="bottom" rowspan="1" colspan="1">-12</td><td align="center" valign="bottom" rowspan="1" colspan="1">-90</td><td align="center" valign="bottom" rowspan="1" colspan="1">-6</td></tr></tbody></table><table-wrap-foot><fn id="TFN2"><p>BA = Brodmann area.</p></fn></table-wrap-foot></table-wrap><table-wrap id="T3" position="float"><label>Table 3</label><caption><p>Size, significance level (z-score), and Talaraich coordinates of clusters with greater activation in the fattening food photograph condition than in the object condition in regions of interest analyses (P &#x0003c; 0.05, corrected for multiple comparisons).</p></caption><table frame="below" rules="groups"><thead><tr><th valign="bottom" align="left" rowspan="1" colspan="1">Fattening Food &#x0003e; Object</th><th valign="bottom" align="center" rowspan="1" colspan="1">No. of voxels</th><th valign="bottom" align="center" rowspan="1" colspan="1">Maximum z-score</th><th valign="bottom" align="center" rowspan="1" colspan="1">x <italic>(mm)</italic></th><th valign="bottom" align="center" rowspan="1" colspan="1">y <italic>(mm)</italic></th><th valign="bottom" align="center" rowspan="1" colspan="1">z <italic>(mm)</italic></th></tr></thead><tbody><tr><td align="left" valign="bottom" rowspan="1" colspan="1">Brainstem (midbrain)</td><td align="center" valign="bottom" rowspan="1" colspan="1">1025</td><td align="center" valign="bottom" rowspan="1" colspan="1">3.64</td><td align="center" valign="bottom" rowspan="1" colspan="1">-6</td><td align="center" valign="bottom" rowspan="1" colspan="1">-28</td><td align="center" valign="bottom" rowspan="1" colspan="1">-8</td></tr><tr><td align="left" valign="bottom" rowspan="1" colspan="1">Brainstem (near 4th ventricle)</td><td align="center" valign="bottom" rowspan="1" colspan="1"/><td align="center" valign="bottom" rowspan="1" colspan="1">