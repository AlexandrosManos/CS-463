</citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>I</given-names></name><name><surname>Haines</surname><given-names>A</given-names></name></person-group><article-title>Health costs of the Gulf war</article-title><source>BMJ</source><year>1991</year><volume>3003</volume><fpage>303</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">1888936</pub-id><pub-id pub-id-type="doi">10.1136/bmj.303.6797.303</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ascherio</surname><given-names>A</given-names></name><name><surname>Chase</surname><given-names>T</given-names></name><name><surname>Cote</surname><given-names>T</given-names></name><name><surname>Dehaes</surname><given-names>G</given-names></name><name><surname>Hoskins</surname><given-names>E</given-names></name><name><surname>Laaouei</surname><given-names>J</given-names></name><etal></etal></person-group><article-title>Effect of the Gulf war on infant and child mortality in Iraq</article-title><source>N Engl J Med</source><year>1992</year><volume>327</volume><fpage>931</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">1513350</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ali</surname><given-names>MM</given-names></name><name><surname>Shah</surname><given-names>SH</given-names></name></person-group><article-title>Sanctions and childhood mortality in Iraq</article-title><source>The Lancet</source><year>2000</year><volume>355</volume><fpage>1851</fpage><lpage>7</lpage><pub-id pub-id-type="doi">10.1016/S0140-6736(00)02289-3</pub-id></citation></ref><ref id="B17"><citation citation-type="other"><article-title>Situation analysis of children and women in Iraq-1997. Part Two: Child survival, rights and basic needs</article-title><ext-link ext-link-type="uri" xlink:href="unicef.htmhttp://iraqaction.org/oldsite/UNICEF1998.html"/><comment>Accessed on 7 March 2009</comment></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Al-Kubaisy</surname><given-names>W</given-names></name><name><surname>Al-Rubaiy</surname><given-names>MG</given-names></name><name><surname>Nassief</surname><given-names>HA</given-names></name></person-group><article-title>Xerophthalmia among hospitalized Iraqi children</article-title><source>East Mediterr Health J</source><year>2002</year><volume>8</volume><fpage>496</fpage><lpage>502</lpage><pub-id pub-id-type="pmid">15603030</pub-id></citation></ref><ref id="B19"><citation citation-type="other"><article-title>Countries and their cultures: Culture of Iraq</article-title><ext-link ext-link-type="uri" xlink:href="http://www.everyculture.com/Ge-It/Iraq.html"/><comment>Accessed on 7 March 2009</comment></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Etiler</surname><given-names>N</given-names></name><name><surname>Velipasaoglu</surname><given-names>S</given-names></name><name><surname>Aktekin</surname><given-names>M</given-names></name></person-group><article-title>Risk factors for overall and persistent diarrhoea in infancy in Antalya, Turkey: a cohort study</article-title><source>Public Health</source><year>2004</year><volume>118</volume><fpage>62</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">14643628</pub-id><pub-id pub-id-type="doi">10.1016/S0033-3506(03)00132-X</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mashal</surname><given-names>T</given-names></name><name><surname>Takano</surname><given-names>T</given-names></name><name><surname>Nakamura</surname><given-names>K</given-names></name><name><surname>Kizuki</surname><given-names>M</given-names></name><name><surname>Hemat</surname><given-names>S</given-names></name><name><surname>Watanabe</surname><given-names>M</given-names></name><name><surname>Seino</surname><given-names>K</given-names></name></person-group><article-title>Factors associated with the health and nutritional status of children under 5 years of age in Afghanistan: family behaviour related to women and past experience of war-ralated hardships</article-title><source>BMC Public Health</source><year>2008</year><volume>8</volume><fpage>301</fpage><pub-id pub-id-type="pmid">18759988</pub-id><pub-id pub-id-type="doi">10.1186/1471-2458-8-301</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nimri</surname><given-names>LF</given-names></name><name><surname>Hijazi</surname><given-names>S</given-names></name></person-group><article-title>Rotavirus-associated diarrhoea in children in a refugee camp in Jordan</article-title><source>J Diarrhoeal Dis Res</source><year>1996</year><volume>14</volume><fpage>1</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">8708326</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Muhsen</surname><given-names>K</given-names></name><name><surname>Athamna</surname><given-names>A</given-names></name><name><surname>Cohen</surname><given-names>D</given-names></name></person-group><article-title>Incidence and risk factors of diarrheal diseases among 3&#x02013;5 years old Israeli Arab children attending</article-title><source>Harefuah</source><year>2001</year><volume>146</volume><fpage>341</fpage><lpage>344</lpage><pub-id pub-id-type="pmid">17674548</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rahmanifar</surname><given-names>A</given-names></name><name><surname>Kirksey</surname><given-names>A</given-names></name><name><surname>McCabe</surname><given-names>GP</given-names></name><name><surname>Galal</surname><given-names>OM</given-names></name><name><surname>Harrison</surname><given-names>GG</given-names></name><name><surname>Jerome</surname><given-names>NW</given-names></name></person-group><article-title>Respiratory tract and diarrheal infections of breast-fed infants from birth to 6 months of age in household contexts of an Egyptian village</article-title><source>Eur J Clin Nutr</source><year>1996</year><volume>50</volume><fpage>655</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">8909931</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sha</surname><given-names>NM</given-names></name><name><surname>Sha</surname><given-names>MA</given-names></name><name><surname>Radovanovic</surname><given-names>Z</given-names></name></person-group><article-title>Social class and morbidity differences among Kuwaiti children</article-title><source>J Health Popul Dev Ctries</source><year>1999</year><volume>2</volume><fpage>58</fpage><lpage>69</lpage><pub-id pub-id-type="pmid">12349110</pub-id></citation></ref></ref-list></back></article>