><pub-id pub-id-type="pmid">15469732</pub-id></citation></ref><ref id="B31"><label>31</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Narayanan</surname><given-names>S</given-names></name><name><surname>Surolia</surname><given-names>A</given-names></name><name><surname>Karande</surname><given-names>AA</given-names></name></person-group><article-title>Ribosome-inactivating protein and apoptosis: abrin causes cell death via mitochondrial pathway in Jurkat cells</article-title><source>Biochem J</source><year>2004</year><volume>377</volume><fpage>233</fpage><lpage>40</lpage><comment>Pt 1</comment><pub-id pub-id-type="pmid">13129434</pub-id></citation></ref></ref-list></back></article>