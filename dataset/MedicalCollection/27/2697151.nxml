ation citation-type="journal"><person-group person-group-type="author"><name><surname>Bolden</surname><given-names>JE</given-names></name><name><surname>Peart</surname><given-names>MJ</given-names></name><name><surname>Johnstone</surname><given-names>RW</given-names></name></person-group><article-title>Anticancer activities of histone deacetylase inhibitors</article-title><source>Nat Rev Drug Discov</source><year>2006</year><volume>5</volume><fpage>769</fpage><lpage>784</lpage><pub-id pub-id-type="pmid">16955068</pub-id><pub-id pub-id-type="doi">10.1038/nrd2133</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Ruijter</surname><given-names>AJM</given-names></name><name><surname>Van Gennip</surname><given-names>AH</given-names></name><name><surname>Caron</surname><given-names>HN</given-names></name><name><surname>Kemp</surname><given-names>S</given-names></name><name><surname>Van Kuilemburg</surname><given-names>ABP</given-names></name></person-group><article-title>Histone deacetylases (HDACs): Characterization of the classical HDAC family</article-title><source>Biochem J</source><year>2003</year><volume>370</volume><fpage>737</fpage><lpage>749</lpage><pub-id pub-id-type="pmid">12429021</pub-id><pub-id pub-id-type="doi">10.1042/BJ20021321</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Verdin</surname><given-names>E</given-names></name><name><surname>Dequiedt</surname><given-names>F</given-names></name><name><surname>Kasler</surname><given-names>G</given-names></name></person-group><article-title>Class II histone deacetylases: versatile regulators</article-title><source>Trends Genet</source><year>2003</year><volume>19</volume><fpage>5286</fpage><lpage>5293</lpage><pub-id pub-id-type="doi">10.1016/S0168-9525(03)00073-8</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mai</surname><given-names>A</given-names></name></person-group><article-title>The therapeutic uses of chromatin-modifying agents</article-title><source>Expert Opin Ther Targets</source><year>2007</year><volume>11</volume><fpage>835</fpage><lpage>851</lpage><pub-id pub-id-type="pmid">17504020</pub-id><pub-id pub-id-type="doi">10.1517/14728222.11.6.835</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Williams</surname><given-names>SA</given-names></name><name><surname>Greene</surname><given-names>WC</given-names></name></person-group><article-title>Regulation of HIV-1 latency by T-cell activation</article-title><source>Cytokine</source><year>2007</year><volume>39</volume><fpage>63</fpage><lpage>74</lpage><pub-id pub-id-type="pmid">17643313</pub-id><pub-id pub-id-type="doi">10.1016/j.cyto.2007.05.017</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Imai</surname><given-names>K</given-names></name><name><surname>Okamoto</surname><given-names>T</given-names></name></person-group><article-title>Transcriptional repression of human immunodeficiency virus type 1 by AP-4</article-title><source>J Biol Chem</source><year>2006</year><volume>281</volume><fpage>12495</fpage><lpage>12505</lpage><pub-id pub-id-type="pmid">16540471</pub-id><pub-id pub-id-type="doi">10.1074/jbc.M511773200</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jiang</surname><given-names>G</given-names></name><name><surname>Espeseth</surname><given-names>A</given-names></name><name><surname>Hazuda</surname><given-names>DJ</given-names></name><name><surname>Margolis</surname><given-names>DM</given-names></name></person-group><article-title>c-Myc and Sp1 contribute to proviral latency by recruiting histone deacetylase 1 to the human immu