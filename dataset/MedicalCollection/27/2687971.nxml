ame><surname>Hamel</surname><given-names>A</given-names></name></person-group><article-title>Finding a maximum compatible tree is NP-hard for sequences and trees</article-title><source>Appl. Math. Lett.</source><year>1996</year><volume>9</volume><fpage>55</fpage><lpage>60</lpage></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Song</surname><given-names>YS</given-names></name><name><surname>Hein</surname><given-names>J</given-names></name></person-group><article-title>Constructing minimal ancestral recombination graphs</article-title><source>J. Comp. Biol.</source><year>2005</year><volume>12</volume><fpage>147</fpage><lpage>169</lpage></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Than</surname><given-names>C</given-names></name><etal/></person-group><article-title>Phylonet: a software package for analyzing and reconstructing reticulate evolutionary relationships</article-title><source>BMC Bioinformatics</source><year>2008</year><volume>9</volume><fpage>1</fpage><lpage>16</lpage><pub-id pub-id-type="pmid">18173834</pub-id></citation></ref><ref id="B30"><citation citation-type="book"><person-group person-group-type="author"><name><surname>van Iersel</surname><given-names>L</given-names></name><name><surname>Kelk</surname><given-names>S</given-names></name></person-group><article-title>Constructing the simplest possible phylogenetic network from triplets</article-title><source>Proceedings of ISAAC'08.</source><year>2008</year><volume>5369</volume><publisher-loc>Berlin/Heidelberg, Gold Coast, Australia</publisher-loc><publisher-name>Springer</publisher-name><fpage>472</fpage><lpage>483</lpage></citation></ref><ref id="B31"><citation citation-type="book"><person-group person-group-type="author"><name><surname>van Iersel</surname><given-names>L</given-names></name><etal/></person-group><article-title>Constructing level-2 phylogenetic networks from triplets</article-title><source>International Conference on Computational Molecular Biology (RECOMB).</source><year>2008</year><volume>4955</volume><publisher-loc>Berlin/Heidelberg</publisher-loc><publisher-name>Springer Verlag</publisher-name><fpage>450</fpage><lpage>462</lpage><comment>of <italic>Lecture Notes in Computer Science</italic></comment></citation></ref><ref id="B32"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>L</given-names></name><etal/></person-group><article-title>Perfect phylogenetic networks with recombination</article-title><source>Proceedings of the 16th ACM Symposium on Applied Computing (SAC'01).</source><year>2001</year><publisher-loc>Las Vegas, NV, USA</publisher-loc><fpage>46</fpage><lpage>50</lpage></citation></ref></ref-list></back></article>