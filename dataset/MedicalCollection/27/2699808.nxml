<given-names>C</given-names></name><etal/></person-group><year>1987</year><article-title>Identification of the structural gene encoding the SH-activated hemolysin of <italic>Listeria monocytogenes</italic>: listeriolysin O is homologous to streptolysin O and pneumolysin</article-title><source>Infect Immun</source><volume>55</volume><fpage>3225</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">2824384</pub-id></mixed-citation></ref><ref id="b22-co-2-793"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Miller</surname><given-names>JJ</given-names></name><name><surname>Scott</surname><given-names>IU</given-names></name><name><surname>Flynn</surname><given-names>HW</given-names></name><etal/></person-group><year>2004</year><article-title>Endophthalmitis caused by <italic>Streptococcus pneumoniae</italic></article-title><source>Am J Ophthalmol</source><volume>138</volume><fpage>231</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">15289132</pub-id></mixed-citation></ref><ref id="b23-co-2-793"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ng</surname><given-names>EW</given-names></name><name><surname>Costa</surname><given-names>JR</given-names></name><name><surname>Samiy</surname><given-names>N</given-names></name><etal/></person-group><year>2002</year><article-title>Contribution of pneumolysin and autolysin to the pathogenesis of experimental pneumococcal endophthalmitis</article-title><source>Retina</source><volume>22</volume><fpage>622</fpage><lpage>32</lpage><pub-id pub-id-type="pmid">12441729</pub-id></mixed-citation></ref><ref id="b24-co-2-793"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ng</surname><given-names>EW</given-names></name><name><surname>Samiy</surname><given-names>N</given-names></name><name><surname>Cousins</surname><given-names>FV</given-names></name><etal/></person-group><year>1997</year><artic