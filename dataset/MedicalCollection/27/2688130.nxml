f nutrient transporters</article-title><source>J Cereb Blood Flow Metab</source><year>2007</year><volume>27</volume><fpage>1766</fpage><lpage>1791</lpage><pub-id pub-id-type="pmid">17579656</pub-id><pub-id pub-id-type="doi">10.1038/sj.jcbfm.9600521</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thomale</surname><given-names>UW</given-names></name><name><surname>Griebenow</surname><given-names>M</given-names></name><name><surname>Mautes</surname><given-names>A</given-names></name><name><surname>Beyer</surname><given-names>TF</given-names></name><name><surname>Dohse</surname><given-names>NK</given-names></name><name><surname>Stroop</surname><given-names>R</given-names></name><name><surname>Sakowitz</surname><given-names>OW</given-names></name><name><surname>Unterberg</surname><given-names>AW</given-names></name><name><surname>Stover</surname><given-names>JF</given-names></name></person-group><article-title>Heterogeneous regional and temporal energetic impairment following controlled cortical impact injury in rats</article-title><source>Neurol Res</source><year>2007</year><volume>29</volume><fpage>594</fpage><lpage>603</lpage><pub-id pub-id-type="pmid">17535559</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parsons</surname><given-names>MW</given-names></name><name><surname>Barber</surname><given-names>PA</given-names></name><name><surname>Desmond</surname><given-names>PM</given-names></name><name><surname>Baird</surname><given-names>TA</given-names></name><name><surname>Darby</surname><given-names>DG</given-names></name><name><surname>Byrnes</surname><given-names>G</given-names></name><name><surname>Tress</surname><given-names>BM</given-names></name><name><surname>Davis</surname><given-names>SM</given-names></name></person-group><article-title>Acute hyperglycemia adversely affects stroke outcome: a magnetic