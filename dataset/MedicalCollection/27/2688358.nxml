"pmid">9464798</pub-id></mixed-citation></ref><ref id="b34-bmi-03-269"><label>34</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Takei</surname><given-names>M</given-names></name><name><surname>Nakagawa</surname><given-names>H</given-names></name><name><surname>Endo</surname><given-names>K</given-names></name></person-group><year>1993</year><article-title>Mast cell activation by pedicellarial toxin of sea urchin, Tosopneustes pileolus</article-title><source>FEBS Lett</source><volume>328</volume><fpage>59</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">7688324</pub-id></mixed-citation></ref><ref id="b35-bmi-03-269"><label>35</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kikuchi</surname><given-names>M</given-names></name><name><surname>Nakano</surname><given-names>M</given-names></name><name><surname>Inoue</surname><given-names>Y</given-names></name><name><surname>Itho</surname><given-names>K</given-names></name></person-group><year>1999</year><article-title>Identification of a SART-1-derived peptide capable of inducing the HLA-A-24-restricted and tumor-specific cytotoxic T lymphocytes</article-title><source>Int. J. Cancer</source><volume>81</volume><fpage>459</fpage><lpage>65</lpage><pub-id pub-id-type="pmid">10209962</pub-id></mixed-citation></ref><ref id="b36-bmi-03-269"><label>36</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>SP</given-names></name><name><surname>Tinerney</surname><given-names>RJ</given-names></name><name><surname>Thomas</surname><given-names>WA</given-names></name></person-group><year>1997</year><article-title>Conserved CTL epitopes within EBV latent membrane protein 2; a potential target for CTL-based tumor therapy. </article-title><source>J. Immunol</source><volume>158</volume><fpage>3325</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">91