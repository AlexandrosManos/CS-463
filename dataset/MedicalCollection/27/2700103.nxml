/name><name><surname>Day</surname><given-names>I</given-names></name><name><surname>Ide</surname><given-names>L</given-names></name></person-group><source>Smoking by children in Great Britain A review of the literature</source><year>1972</year><publisher-name>London: Social Science Research Council/Medical Research Council</publisher-name></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Baron</surname><given-names>RM</given-names></name><name><surname>Kenny</surname><given-names>DA</given-names></name></person-group><article-title>The moderator-mediator variable distinction in social psychological research: Conceptual, strategic and statistical considerations</article-title><source>J Pers Soc Psychol</source><year>1986</year><volume>51</volume><fpage>1173</fpage><lpage>1182</lpage><pub-id pub-id-type="pmid">3806354</pub-id><pub-id pub-id-type="doi">10.1037/0022-3514.51.6.1173</pub-id></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kenny</surname><given-names>DA</given-names></name><name><surname>Kashy</surname><given-names>DA</given-names></name><name><surname>Bolger</surname><given-names>N</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Gilbert D, Fiske S, Lindzey G</surname></name></person-group><article-title>Data analysis in social psychology</article-title><source>The handbook of social psychology</source><year>1998</year><volume>1</volume><edition>4</edition><publisher-name>Boston, MA: McGraw-Hill</publisher-name><fpage>233</fpage><lpage>265</lpage></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Connor</surname><given-names>M</given-names></name><name><surname>Armitage</surname><given-names>JA</given-names></name></person-group><article-title>Extending the theory of planned behavior; a review and avenues for further research</article-title><source>J Appl Soc Psychol</source><year>1998</year><volume>28</volume><fpage>1429</fpage><lpage>1464</lpage><pub-id pub-id-type="doi">10.1111/j.1559-1816.1998.tb01685.x</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lechner</surname><given-names>L</given-names></name><name><surname>De Vries</surname><given-names>H</given-names></name></person-group><article-title>Starting participation in an employee fitness program: attitudes, social influence, and self-efficacy</article-title><source>Prev Med</source><year>1995</year><volume>24</volume><fpage>627</fpage><lpage>633</lpage><pub-id pub-id-type="pmid">8610087</pub-id><pub-id pub-id-type="doi">10.1006/pmed.1995.1098</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Markham</surname><given-names>WA</given-names></name><name><surname>Featherstone</surname><given-names>K</given-names></name><name><surname>Taket</surname><given-names>A</given-names></name><name><surname>Trenchard-Mabere</surname><given-names>E</given-names></name><name><surname>Ross</surname><given-names>M</given-names></name></person-group><article-title>Smoking amongst UK Bangladeshi adolescents aged 14&#x02013;15</article-title><source>Health Educ Res</source><year>2001</year><volume>16</volume><fpage>143</fpage><lpage>156</lpage><pub-id pub-id-type="pmid">11345659</pub-id><pub-id pub-id-type="doi">10.1093/her/16.2.143</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sparks</surname><given-names>P</given-names></name><name><surname>Shepherd</surname><given-names>R</given-names></name><name><surname>Wieringa</surname><given-names>N</given-names></name><name><surname>Zimmermanns</surname><given-names>N</given-names></name></person-group><article-title>Perceived behavioural control, unrealistic optimism and dietary change: an exploratory study</article-title><source>Appetite</source><year>1995</year><volume>24</volume><fpage>243</fpage><lpage>255</lpage><pub-id pub-id-type="pmid">7574571</pub-id><pub-id pub-id-type="doi">10.1016/S0195-6663(95)99787-3</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Connelly</surname><given-names>J</given-names></name><name><surname>Green</surname><given-names>J</given-names></name><name><surname>Lechner</surname><given-names>L</given-names></name><name><surname>Mittelmark</surname><given-names>MB</given-names></name><name><surname>Rigby</surname><given-names>AS</given-names></name><name><surname>Roberts</surname><given-names>C</given-names></name></person-group><article-title>The European smoking prevention framework approach (ESFA) project: observations by six commentators</article-title><source>Health Educ Res</source><year>2003</year><volume>18</volume><fpage>664</fpage><lpage>677</lpage><pub-id pub-id-type="doi">10.1093/her/cyg052</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sutton</surname><given-names>S</given-names></name></person-group><article-title>Predicting and explaining intention and behavior: how well are we doing?</article-title><source>J Appl Soc Psychol</source><year>1998</year><volume>28</volume><fpage>1317</fpage><lpage>1338</lpage><pub-id pub-id-type="doi">10.1111/j.1559-1816.1998.tb01679.x</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Randall</surname><given-names>DM</given-names></name><name><surname>Wolff</surname><given-names>JA</given-names></name></person-group><article-title>The time interval in the intention-behaviour relationship.: Meta analysis</article-title><source>Brit J Soc Psychol</source><year>1994</year><volume>33</volume><fpage>405</fpage><lpage>418</lpage></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sheeran</surname><given-names>P</given-names></name><name><surname>Orbell</surname><given-names>S</given-names></name></person-group><article-title>Do intentions predict condom use? Meta analysis and examination of six moderator variables</article-title><source>Brit J Soc Psychol</source><year>1998</year><volume>37</volume><fpage>231</fpage><lpage>250</lpage><pub-id pub-id-type="pmid">9639864</pub-id></citation></ref></ref-list></back></article>