oc. Natl. Acad. Sci. USA</source><year>2004</year><volume>101</volume><fpage>1345</fpage><lpage>1349</lpage><pub-id pub-id-type="pmid">14736915</pub-id></element-citation></ref><ref id="b16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Stinear</surname><given-names>T</given-names></name><name><surname>Hong</surname><given-names>H</given-names></name><name><surname>Frigui</surname><given-names>W</given-names></name><name><surname>Pryor</surname><given-names>MJ</given-names></name><name><surname>Brosch</surname><given-names>R</given-names></name><name><surname>Garnier</surname><given-names>T</given-names></name><name><surname>Leadlay</surname><given-names>PF</given-names></name><name><surname>Cole</surname><given-names>ST</given-names></name></person-group><source>J. Bacteriol.</source><year>2005</year><volume>187</volume><fpage>1668</fpage><lpage>1676</lpage><pub-id pub-id-type="pmid">15716437</pub-id></element-citation></ref><ref id="b17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Yip</surname><given-names>MJ</given-names></name><name><surname>Porter</surname><given-names>JL</given-names></name><name><surname>Fyfe</surname><given-names>JAM</given-names></name><name><surname>Lavender</surname><given-names>CJ</given-names></name><name><surname>Portaels</surname><given-names>F</given-names></name><name><surname>Rhodes</surname><given-names>M</given-names></name><name><surname>Kator</surname><given-names>H</given-names></name><name><surname>Colorni</surname><given-names>A</given-names></name><name><surname>Jenkin</surname><given-names>GA</given-names></name><name><surname>Stinear</surname><given-names>T</given-names></name></person-group><source>J. Bacteriol.</source><year>2007</year><volume>189</volume><fpage>2021</fpage><lpage>2029</lpage><pub-id pub-id-type="pmid">17172337</pub-id></element-citation></ref><ref id="b18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Judd</surname><given-names>TC</given-names></name><name><surname>Bischoff</surname><given-names>A</given-names></name><name><surname>Kishi</surname><given-names>Y</given-names></name><name><surname>Adusumilli</surname><given-names>S</given-names></name><name><surname>Small</surname><given-names>PL</given-names></name></person-group><source>Org. Lett.</source><year>2004</year><volume>6</volume><fpage>4901</fpage><lpage>4904</lpage><pub-id pub-id-type="pmid">15606095</pub-id></element-citation></ref><ref id="b19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Stover</surname><given-names>CK</given-names></name><name><surname>de La Cruz</surname><given-names>VF</given-names></name><name><surname>F&#x000fc;rst</surname><given-names>TR</given-names></name><name><surname>Burlein</surname><given-names>JE</given-names></name><name><surname>Benson</surname><given-names>LA</given-names></name><name><surname>Bansal</surname><given-names>GP</given-names></name><name><surname>Young</surname><given-names>JF</given-names></name><name><surname>Lee</surname><given-names>MH</given-names></name><name><surname>Hatfull</surname><given-names>GF</given-names></name><name><surname>Snapper</surname><given-names>SB</given-names></name><name><surname>Barletta</surname><given-names>RG</given-names></name><name><surname>Jacobs</surname><given-names>WR</given-names><suffix>Jr</suffix></name><name><surname>Bloom</surname><given-names>BR</given-names></name></person-group><source>Nature</source><year>1991</year><volume>351</volume><fpage>456</fpage><lpage>460</lpage><pub-id pub-id-type="pmid">1904554</pub-id></element-citation></ref><ref id="b20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Talaat</surname><given-names>AM</given-names></name><name><surname>Trucksis</surname><given-names>M</given-names></name></person-group><source>Am. J. Vet. Res.</source><year>2000</year><volume>61</volume><fpage>125</fpage><lpage>128</lpage><pub-id pub-id-type="pmid">10685681</pub-id></element-citation></ref></ref-list></back></article>