rowspan="1" colspan="1">17.42</td><td align="left" rowspan="1" colspan="1">1201.15</td><td align="left" rowspan="1" colspan="1">172.83</td></tr><tr><td align="left" rowspan="1" colspan="1">Eagan</td><td align="left" rowspan="1" colspan="1">b</td><td align="left" rowspan="1" colspan="1">M</td><td align="left" rowspan="1" colspan="1">5.4&#x000d7;10<sup>&#x02212;3</sup></td><td align="left" rowspan="1" colspan="1">5.4&#x000d7;10<sup>&#x02212;3</sup></td><td align="left" rowspan="1" colspan="1">17.63</td><td align="left" rowspan="1" colspan="1">n/a</td><td align="left" rowspan="1" colspan="1">n/a</td></tr><tr><td align="left" rowspan="1" colspan="1">PittHH&#x0002a;</td><td align="left" rowspan="1" colspan="1">nt</td><td align="left" rowspan="1" colspan="1">OM</td><td align="left" rowspan="1" colspan="1">3.0&#x000d7;10<sup>&#x02212;3</sup></td><td align="left" rowspan="1" colspan="1">2.8&#x000d7;10<sup>&#x02212;8</sup></td><td align="left" rowspan="1" colspan="1">17.81</td><td align="left" rowspan="1" colspan="1">1264.19</td><td align="left" rowspan="1" colspan="1">162.62</td></tr><tr><td align="left" rowspan="1" colspan="1">PittAA&#x0002a;</td><td align="left" rowspan="1" colspan="1">nt</td><td align="left" rowspan="1" colspan="1">OM</td><td align="left" rowspan="1" colspan="1">9.0&#x000d7;10<sup>&#x02212;3</sup></td><td align="left" rowspan="1" colspan="1">8.9&#x000d7;10<sup>&#x02212;3</sup></td><td align="left" rowspan="1" colspan="1">18.04</td><td align="left" rowspan="1" colspan="1">1266.07</td><td align="left" rowspan="1" colspan="1">157.07</td></tr><tr><td align="left" rowspan="1" colspan="1">1207</td><td align="left" rowspan="1" colspan="1">nt</td><td align="left" rowspan="1" colspan="1">OM</td><td align="left" rowspan="1" colspan="1">3.2&#x000d7;10<sup>&#x02212;2</sup></td><td align="left" rowspan="1" colspan="1">5.0&#x000d7;10<sup>&#x02212;4</sup></td><td align="left" rowspan="1" colspan="1">18.52</td><td align="left" rowspan="1" colspan="1">n/a</td><td align="