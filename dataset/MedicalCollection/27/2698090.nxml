ion publication-type="journal"><person-group person-group-type="author"><name><surname>Keane</surname><given-names>WF</given-names></name><name><surname>Eknoyan</surname><given-names>G</given-names></name></person-group><article-title>Proteinuria, albuminuria, risk, assessment, detection, elimination (PARADE): a position paper of the National Kidney Foundation</article-title><source>Am J Kidney Dis</source><year>1999</year><volume>33</volume><fpage>1004</fpage><lpage>1010</lpage><pub-id pub-id-type="pmid">10213663</pub-id></element-citation></ref><ref id="R21"><label>21</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hillege</surname><given-names>HL</given-names></name><name><surname>Janssen</surname><given-names>WM</given-names></name><name><surname>Bak</surname><given-names>AA</given-names></name><etal/></person-group><article-title>Microalbuminuria is common, also in a nondiabetic, nonhypertensive population, and an independent indicator of cardiovascular risk factors and cardiovascular morbidity</article-title><source>J Intern Med</source><year>2001</year><volume>249</volume><fpage>519</fpage><lpage>526</lpage><pub-id pub-id-type="pmid">11422658</pub-id></element-citation></ref><ref id="R22"><label>22</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Iseki</surname><given-names>K</given-names></name><name><surname>Iseki</surname><given-names>C</given-names></name><name><surname>Ikemiya</surname><given-names>Y</given-names></name><etal/></person-group><article-title>Risk of developing end-stage renal disease in a cohort of mass screening</article-title><source>Kidney Int</source><year>1996</year><volume>49</volume><fpage>800</fpage><lpage>805</lpage><pub-id pub-id-type="pmid">8648923</pub-id></element-citation></ref><ref id="R23"><label>23</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Levey</surname><given-names>AS</given-names></name><name><surname>Eckardt</surname><given-names>KU</given-names></name><name><surname>Tsukamoto</surname><given-names>Y</given-names></name><etal/></person-group><article-title>Definition and classification of chronic kidney disease: a position statement from Kidney Disease Improving Global Outcomes (KDIGO)</article-title><source>Kidney Int</source><year>2005</year><volume>67</volume><fpage>2089</fpage><lpage>2100</lpage><pub-id pub-id-type="pmid">15882252</pub-id></element-citation></ref><ref id="R24"><label>24</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Levin</surname><given-names>A</given-names></name></person-group><article-title>Identification of patients and risk factors in chronic kidney disease&#x02014;evaluating risk factors and therapeutic strategies</article-title><source>Nephrol Dial Transplant</source><year>2001</year><volume>16</volume><issue>Suppl 7</issue><fpage>57</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">11590259</pub-id></element-citation></ref><ref id="R25"><label>25</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Pi-Sunyer</surname><given-names>FX</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Shils</surname><given-names>ME</given-names></name><name><surname>Olson</surname><given-names>JA</given-names></name><name><surname>Shike</surname><given-names>M</given-names></name><name><surname>Ross</surname><given-names>AC</given-names></name></person-group><article-title>Obesity</article-title><source>Modern Nutrition in Health and Diseases,</source><year>1999</year><edition>9th edn.</edition><publisher-loc>New York</publisher-loc><publisher-name>Williams &#x00026; Wilkins</publisher-name><fpage>1395</fpage><lpage>1418</lpage></element-citation></ref><ref id="R26"><label>26</label><element-citation publication-type="journal"><person-g