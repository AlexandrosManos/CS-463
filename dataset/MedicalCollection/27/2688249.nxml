name><given-names>EM</given-names></name><name><surname>De Keyser</surname><given-names>F</given-names></name></person-group><article-title>Synovial histopathology of psoriatic arthritis, both oligo- and polyarticular, resembles spondyloarthropathy more than it does rheumatoid arthritis</article-title><source>Arthritis Res Ther</source><year>2005</year><volume>7</volume><fpage>R569</fpage><lpage>580</lpage><pub-id pub-id-type="pmid">15899044</pub-id><pub-id pub-id-type="doi">10.1186/ar1698</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vernon-Roberts</surname><given-names>B</given-names></name><name><surname>Barnes</surname><given-names>CG</given-names></name><name><surname>Revell</surname><given-names>A</given-names></name></person-group><article-title>Synovial pathology in Beh&#x000e7;et's syndrome</article-title><source>Ann Rheum Dis</source><year>1978</year><volume>37</volume><fpage>139</fpage><lpage>145</lpage><pub-id pub-id-type="pmid">646465</pub-id><pub-id pub-id-type="doi">10.1136/ard.37.2.139</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gibson</surname><given-names>T</given-names></name><name><surname>Laurent</surname><given-names>R</given-names></name><name><surname>Highton</surname><given-names>J</given-names></name><name><surname>Wilton</surname><given-names>M</given-names></name><name><surname>Dyson</surname><given-names>M</given-names></name><name><surname>Millis</surname><given-names>R</given-names></name></person-group><article-title>Synovial histopathology of Beh&#x000e7;et's syndrome</article-title><source>Ann Rheum Dis</source><year>1981</year><volume>40</volume><fpage>376</fpage><lpage>381</lpage><pub-id pub-id-type="pmid">7020613</pub-id><pub-id pub-id-type="doi">10.1136/ard.40.4.376</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-ty