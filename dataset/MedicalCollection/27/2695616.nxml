citation publication-type="book"><person-group person-group-type="editor"><name><surname>Foley</surname><given-names>B</given-names></name><name><surname>Hamling</surname><given-names>J</given-names></name><name><surname>Lee</surname><given-names>P</given-names></name><etal/></person-group><year>2002</year><source>International smoking statistics</source><publisher-loc>Oxford, UK</publisher-loc><publisher-name>Institute of Preventive Medicine, Oxford Univ Pr</publisher-name></element-citation></ref><ref id="b10-copd-2-177"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jha</surname><given-names>P</given-names></name><name><surname>Enas</surname><given-names>EA</given-names></name><name><surname>Yusuf</surname><given-names>S</given-names></name></person-group><year>1993</year><article-title>Coronary artery disease in Asian Indians: prevalence and risk factors</article-title><source>Asian Am Pac Islander J Health</source><volume>1</volume><fpage>161</fpage><lpage>75</lpage></element-citation></ref><ref id="b11-copd-2-177"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jindal</surname><given-names>SK</given-names></name><collab>Asthma Epidemiology Study Group</collab></person-group><year>2006a</year><article-title>A multicentric study on epidemiology of chronic obstructive pulmonary disease and its relationship with tobacco smoking and environmental tobacco smoke exposure</article-title><source>Ind J Chest Dis Allied Sc</source><volume>48</volume><fpage>23</fpage><lpage>9</lpage></element-citation></ref><ref id="b12-copd-2-177"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jindal</surname><given-names>SK</given-names></name><collab>Asthma Epidemiology Study Group</collab></person-group><year>2006b</year><article-title>Tobacco smoking in India: prevalence, quit rates and respiratory morbidity</article-title><s