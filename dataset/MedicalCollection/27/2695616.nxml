><article-title>Social class and coronary disease in a rural population of north India</article-title><source>Eur Heart J</source><volume>18</volume><fpage>588</fpage><lpage>95</lpage><pub-id pub-id-type="pmid">9129887</pub-id></element-citation></ref><ref id="b27-copd-2-177"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Singh</surname><given-names>RB</given-names></name><name><surname>Sharma</surname><given-names>JP</given-names></name><name><surname>Rastogi</surname><given-names>V</given-names></name><etal/></person-group><year>1997b</year><article-title>Prevalence of coronary artery disease and coronary risk factors in rural and urban populations of north India</article-title><source>Eur Heart J</source><volume>18</volume><fpage>1728</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">9402447</pub-id></element-citation></ref><ref id="b28-copd-2-177"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Singh</surname><given-names>RB</given-names></name><name><surname>Singh</surname><given-names>V</given-names></name><name><surname>Kulshrestra</surname><given-names>SK</given-names></name><etal/></person-group><year>2005</year><article-title>Social class and all cause mortality in an urban population of north India</article-title><source>Acta Cardiol</source><volume>60</volume><fpage>611</fpage><lpage>17</lpage><pub-id pub-id-type="pmid">16385922</pub-id></element-citation></ref><ref id="b29-copd-2-177"><mixed-citation publication-type="other"><person-group person-group-type="author"><name><surname>Singh</surname><given-names>V</given-names></name></person-group><year>2002</year>Chemical analysis of inorganic metal ions in the diets of victims in relation to cause of death. PhD Thesis accepted by MJP Rohilkhand University.</mixed-citation></ref><ref id="b30-copd-2-177"><element-citation publication-type="book"><person-group person-group-type="author"><collab>[WHO] World Health Organization</collab></person-group><year>2005</year><source>The world health report 2005: Reducing risks, promoting healthy life</source><publisher-loc>Geneva</publisher-loc><publisher-name>WHO</publisher-name></element-citation></ref><ref id="b31-copd-2-177"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Yusuf</surname><given-names>S</given-names></name><name><surname>Reddy</surname><given-names>S</given-names></name><name><surname>Ounpuu</surname><given-names>S</given-names></name><etal/></person-group><year>2001a</year><article-title>Global burden of cardiovascular disease. Part 1, general considerations and epidemiologic transition, risk factors and impact of urbanization</article-title><source>Circulation</source><volume>104</volume><fpage>2746</fpage><lpage>53</lpage><pub-id pub-id-type="pmid">11723030</pub-id></element-citation></ref><ref id="b32-copd-2-177"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Yusuf</surname><given-names>S</given-names></name><name><surname>Reddy</surname><given-names>S</given-names></name><name><surname>Ounpuu</surname><given-names>S</given-names></name><etal/></person-group><year>2001b</year><article-title>Part II. Variations in cardiovascular disease by specific ethnic groups and geographic regions and prevention strategies</article-title><source>Circulation</source><volume>104</volume><fpage>2855</fpage><lpage>64</lpage><pub-id pub-id-type="pmid">11733407</pub-id></element-citation></ref></ref-list></back><floats-group><table-wrap id="t1-copd-2-177" position="float"><label>Table 1</label><caption><p>Clinical data and tobacco consumption among decedents studied, based on records and assessment by questionnaire</p></caption><table frame="hsides" rules="groups"><thead><tr><th valign="top" align="left" rowspan="2" colspan="1"><bold>Clinical data</bold></th><th valign="top" align="left" colspan="2" rowspan="1"><bo