 rowspan="1" colspan="1">DOWN</td><td align="left" rowspan="1" colspan="1">DOWN</td></tr><tr><td align="left" rowspan="1" colspan="1">matrix metallopeptidase 14</td><td align="left" rowspan="1" colspan="1">MMP14</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">UP</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">matrix metallopeptidase 28</td><td align="left" rowspan="1" colspan="1">MMP28</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">UP</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">DOWN</td></tr><tr><td align="left" rowspan="1" colspan="1">SERPIN genes: tend to be upregulated by SMM; attenuated by AZT</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">serpin peptidase inhibitor, clade A, member 1</td><td align="left" rowspan="1" colspan="1">SERPINA1</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">UP</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">serpin peptidase inhibitor, clade A, member 3</td><td align="left" rowspan="1" colspan="1">SERPINA3</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">UP</td><td align="left" ro