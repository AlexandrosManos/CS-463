i">10.1016/S1352-2310(01)00493-9</pub-id></mixed-citation></ref><ref id="B28"><mixed-citation publication-type="journal"><name><surname>Greco</surname><given-names>SL</given-names></name><name><surname>Wilson</surname><given-names>AM</given-names></name><name><surname>Spengler</surname><given-names>JD</given-names></name><name><surname>Levy</surname><given-names>JI</given-names></name><article-title>Spatial patterns of mobile source particulate matter emissions-to-exposure relationships across the United States</article-title><source>Atmospheric Environment</source><year>2007</year><volume>41</volume><fpage>1011</fpage><lpage>1025</lpage><pub-id pub-id-type="doi">10.1016/j.atmosenv.2006.09.025</pub-id></mixed-citation></ref><ref id="B29"><mixed-citation publication-type="journal"><name><surname>Marshall</surname><given-names>JD</given-names></name><name><surname>Riley</surname><given-names>WJ</given-names></name><name><surname>McKone</surname><given-names>TE</given-names></name><name><surname>Nazaroff</surname><given-names>WW</given-names></name><article-title>Intake fraction of primary pollutants: motor vehicle emissions in the South Coast Air Basin</article-title><source>Atmos Environ</source><year>2003</year><volume>37</volume><fpage>3455</fpage><lpage>3468</lpage><pub-id pub-id-type="doi">10.1016/S1352-2310(03)00269-3</pub-id></mixed-citation></ref></ref-list></back></article>