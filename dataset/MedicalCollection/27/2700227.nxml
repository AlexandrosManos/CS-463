olume><fpage>9</fpage><lpage>12</lpage><pub-id pub-id-type="pmid">533976</pub-id></mixed-citation></ref><ref id="CR8"><label>8.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nowak</surname><given-names>RM</given-names></name><name><surname>Pensier</surname><given-names>MI</given-names></name><name><surname>Sarkar</surname><given-names>DD</given-names></name><etal/></person-group><article-title>Comparison of peak expiratory flow rate and FEV1 admission criteria for acute bronchial asthma</article-title><source>Ann Emerg Med</source><year>1982</year><volume>11</volume><issue>2</issue><fpage>64</fpage><lpage>69</lpage><pub-id pub-id-type="doi">10.1016/S0196-0644(82)80298-9</pub-id><pub-id pub-id-type="pmid">7137687</pub-id></mixed-citation></ref><ref id="CR9"><label>9.</label><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Hyatt</surname><given-names>RE</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Fishman</surname><given-names>AP</given-names></name></person-group><article-title>Forced expiration</article-title><source>Handbook of physiology</source><year>1986</year><publisher-loc>Bethesda</publisher-loc><publisher-name>American Physiological Society</publisher-name><fpage>295</fpage><lpage>314</lpage></mixed-citation></ref><ref id="CR10"><label>10.</label><mixed-citation publication-type="other">Primatesta P, Bost L, Dong W (1996) Health survery for England. Stationery Office, London</mixed-citation></ref><ref id="CR11"><label>11.</label><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Fletcher</surname><given-names>CM</given-names></name></person-group><source>The natural history of chronic bronchitis and emphysema</source><year>1976</year><publisher-loc>Oxford</publisher-loc><publisher-name>Oxford University Press</publisher-name></mixed-citation></ref><ref id="CR12"><label>12.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bowe</surname><given-names>EA</given-names></name><name><surname>Boysen</surname><given-names>PG</given-names></name><name><surname>Broome</surname><given-names>JA</given-names></name><name><surname>Klein</surname><given-names>EF</given-names><suffix>Jr</suffix></name></person-group><article-title>Accurate determination of end-tidal carbon dioxide during administration of oxygen by nasal cannulae</article-title><source>J Clin Monit</source><year>1989</year><volume>5</volume><fpage>105</fpage><lpage>110</lpage><pub-id pub-id-type="doi">10.1007/BF01617883</pub-id><pub-id pub-id-type="pmid">2498467</pub-id></mixed-citation></ref><ref id="CR13"><label>13.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Loughnan</surname><given-names>TE</given-names></name><name><surname>Monagle</surname><given-names>J</given-names></name><name><surname>Copland</surname><given-names>JM</given-names></name><name><surname>Ranjan</surname><given-names>P</given-names></name><name><surname>Chen</surname><given-names>MF</given-names></name></person-group><article-title>A comparison of carbon dioxide monitoring and oxygenation between facemask and divided nasal cannula</article-title><source>Anaesth Intensive Care</source><year>2000</year><volume>28</volume><issue>2</issue><fpage>151</fpage><lpage>154</lpage><pub-id pub-id-type="pmid">10788965</pub-id></mixed-citation></ref><ref id="CR14"><label>14.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Yaron</surname><given-names>M</given-names></name><name><surname>Padyk</surname><given-names>P</given-names></name><name><surname>Hutsinpiller</surname><given-names>M</given-names></name><name><surname>Cairns</surname><given-names>CB</given-names></name></person-group><article-title>Utility of expiratory capnogram in the assessment of bronchospasm</article-title><source>Ann Emerg Med</source><year>1996</year><volume>28</volume><fpage>403</fpage><lpage>407</lpage><pub-id pub-id-type="doi">10.1016/S0196-0644(96)70005-7</pub-id><pub-id pub-id-type="pmid">8839525</pub-id></mixed-citation></ref><ref id="CR15"><label>15.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Egleston</surname><given-names>CV</given-names></name><name><surname>Ben Aslam</surname><given-names>BH</given-names></name><name><surname>Lambert</surname><given-names>MA</given-names></name></person-group><article-title>Capnography for monitoring non-intubated spontaneously breathing patients in an emergency room setting</article-title><source>J Accid Emerg Med</source><year>1997</year><volume>14</volume><fpage>222</fpage><lpage>224</lpage><pub-id pub-id-type="pmid">9248908</pub-id></mixed-citation></ref><ref id="CR16"><label>16.</label><mixed-citation publication-type="other">Zainudin BMZ (1996) Guidelines on management of adult asthma&#x02014;a consensus statement. Malaysian Thoracic Society</mixed-citation></ref><ref id="CR17"><label>17.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Fischl</surname><given-names>MA</given-names></name><name><surname>Pitchenik</surname><given-names>A</given-names></name><name><surname>Gardner</surname><given-names>LB</given-names></name></person-group><article-title>An index predicting relapse and need for hospitalization in patients with acute bronchial asthma</article-title><source>N Engl J Med</source><year>1981</year><volume>305</volume><fpage>783</fpage><lpage>789</lpage><pub-id pub-id-type="pmid">7266631</pub-id></mixed-citation></ref><ref id="CR18"><label>18.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nowak</surname><given-names>RM</given-names></name><name><surname>Pensler</surname><given-names>MI</given-names></name><name><surname>Sarkar</surname><given-names>DD</given-names></name><etal/></person-group><article-title>Comparison of peak expiratory flow rate and FEV1 admission criteria for acute bronchial asthma</article-title><source>Ann Emerg Med</source><year>1982</year><volume>11</volume><issue>2</issue><fpage>64</fpage><lpage>69</lpage><pub-id pub-id-type="doi">10.1016/S0196-0644(82)80298-9</pub-id><pub-id pub-id-type="pmid">7137687</pub-id></mixed-citation></ref><ref id="CR19"><label>19.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Corre</surname><given-names>KA</given-names></name><name><surname>Rothstein</surname><given-names>RJ</given-names></name></person-group><article-title>Assessing severity of adult asthma and need for hospitalization</article-title><source>Ann Emerg Med</source><year>1985</year><volume>14</volume><fpage>45</fpage><lpage>52</lpage><pub-id pub-id-type="doi">10.1016/S0196-0644(85)80735-6</pub-id><pub-id pub-id-type="pmid">3880636</pub-id></mixed-citation></ref><ref id="CR20"><label>20.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Landis</surname><given-names>B</given-names></name><name><surname>Romano</surname><given-names>PM</given-names></name></person-group><article-title>A scoring system for capnogram biofeedback: preliminary findings</article-title><source>Appl Psychophysiol Biofeedback</source><year>1998</year><volume>23</volume><issue>2</issue><fpage>75</fpage><lpage>91</lpage><pub-id pub-id-type="doi">10.1023/A:1022195721961</pub-id><pub-id pub-id-type="pmid">9789622</pub-id></mixed-citation></ref><ref id="CR21"><label>21.</label><mixed-citation publication-type="other">Goldman JM (2000) Development of clinical capnography analysis system. Director of Anaesthesiology Research, University of Colorado Health Sciences Center. Web-based paper <ext-link ext-link-type="uri" xlink:href="http://www.acmeanesthesia.com/">http://www.acmeanesthesia.com/</ext-link></mixed-citation></ref><ref id="CR22"><label>22.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bhavani-Shankar</surname><given-names>K</given-names></name><name><surname>Kumar</surname><given-names>AY</given-names></name><name><surname>Moseley</surname><given-names>HS</given-names></name><name><surname>Ahyee-Hallsworth</surname><given-names>R</given-names></name></person-group><article-title>Terminology and the current limitations of time capnography: a brief review</article-title><source>J Clin Monit</source><year>1995</year><volume>11</volume><fpage>175</fpage><lpage>182</lpage><pub-id pub-id-type="doi">10.1007/BF01617719</pub-id><pub-id pub-id-type="pmid">7623057</pub-id></mixed-citation></ref></ref-list><fn-group><fn><p>The views expressed in this paper are those of the author(s) and not those of the editors, editorial board or publisher.</p></fn></fn-group></back></article>