-group-type="author"><name><surname>Gattinoni</surname><given-names>L</given-names></name><name><surname>D'Andrea</surname><given-names>L</given-names></name><name><surname>Pelosi</surname><given-names>P</given-names></name><name><surname>Vitale</surname><given-names>G</given-names></name><name><surname>Pesenti</surname><given-names>A</given-names></name><name><surname>Fumagalli</surname><given-names>R</given-names></name></person-group><article-title>Regional effects and mechanism of positive end-expiratory pressure in early adult respiratory distress syndrome</article-title><source>JAMA</source><year>1993</year><volume>269</volume><fpage>2122</fpage><lpage>2127</lpage><pub-id pub-id-type="pmid">8468768</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Muscedere</surname><given-names>JG</given-names></name><name><surname>Mullen</surname><given-names>JB</given-names></name><name><surname>Gan</surname><given-names>K</given-names></name><name><surname>Slutsky</surname><given-names>AS</given-names></name></person-group><article-title>Tidal ventilation at low airway pressures can augment lung injury</article-title><source>Am J Respir Crit Care Med</source><year>1994</year><volume>149</volume><fpage>1327</fpage><lpage>1334</lpage><pub-id pub-id-type="pmid">8173774</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Eisner</surname><given-names>MD</given-names></name><name><surname>Thompson</surname><given-names>BT</given-names></name><name><surname>Schoenfeld</surname><given-names>D</given-names></name><name><surname>Anzueto</surname><given-names>A</given-names></name><name><surname>Matthay</surname><given-names>MA</given-names></name></person-group><article-title>Airway pressures and early barotrauma in patients with acute lung injury and acute respi