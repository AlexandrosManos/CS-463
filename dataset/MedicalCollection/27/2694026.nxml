>64</volume><fpage>31</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">3582100</pub-id></mixed-citation></ref><ref id="b8-co-2-503"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>De Potter</surname><given-names>P</given-names></name><name><surname>Shields</surname><given-names>CL</given-names></name><name><surname>Shields</surname><given-names>JA</given-names></name></person-group><year>1993</year><article-title>Malignant melanoma of the conjunctiva</article-title><source>Int Ophthalmol Clin</source><volume>33</volume><fpage>25</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">8407189</pub-id></mixed-citation></ref><ref id="b9-co-2-503"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Demirci</surname><given-names>H</given-names></name><name><surname>McCormick</surname><given-names>SA</given-names></name><name><surname>Finger</surname><given-names>PT</given-names></name></person-group><year>2000</year><article-title>Topical mitomycin chemotherapy for conjunctival malignant melanoma and primary acquired melanosis with atypia: clinical experience with histopathologic observations</article-title><source>Arch Ophthalmol</source><volume>118</volume><fpage>885</fpage><lpage>91</lpage><pub-id pub-id-type="pmid">10900099</pub-id></mixed-citation></ref><ref id="b10-co-2-503"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Divine</surname><given-names>RD</given-names></name><name><surname>Anderson</surname><given-names>RL</given-names></name></person-group><year>1983</year><article-title>Nitrous oxide cryotherapy for intraepithelial epithelioma of the conjunctiva</article-title><source>Arch Ophthalmol</source><volume>101</volume><fpage>782</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">6847469</pub-id></mixed-citation></ref><ref id="b11-co-2-503"><mixed-citation publication-type="journal"><person-group person-group-type