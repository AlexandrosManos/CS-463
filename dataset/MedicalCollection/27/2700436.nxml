 pub-id-type="pmid">5644323</pub-id></element-citation></ref><ref id="CIT22"><label>22</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ashour</surname><given-names>M</given-names></name></person-group><article-title>Hemodynamic alterations in bronchiectasis: A base for a new subclassification of the disease</article-title><source>J Thorac Cardiovasc Surg</source><year>1996</year><volume>112</volume><fpage>328</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">8751499</pub-id></element-citation></ref><ref id="CIT23"><label>23</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Braun</surname><given-names>NM</given-names></name><name><surname>Arora</surname><given-names>NS</given-names></name><name><surname>Rochester</surname><given-names>DF</given-names></name></person-group><article-title>Force-length relationship of the normal human diaphragm</article-title><source>J App Physiol</source><year>1982</year><volume>53</volume><fpage>405</fpage><lpage>12</lpage></element-citation></ref><ref id="CIT24"><label>24</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Loubeyre</surname><given-names>P</given-names></name><name><surname>Paret</surname><given-names>M</given-names></name><name><surname>Revel</surname><given-names>D</given-names></name><name><surname>Wiesendanger</surname><given-names>T</given-names></name><name><surname>Brune</surname><given-names>J</given-names></name></person-group><article-title>Thin-section CT detection of emphysema associated with bronchiectasis and correlation with pulmonary function tests</article-title><source>Chest</source><year>1996</year><volume>109</volume><fpage>360</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">8620706</pub-id></element-citation></ref><ref id="CIT25"><label>25</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Helbich</surname><given-names>TH</given-names></name><name><surname>Heinz-Peer</surname><given-names>G</given-names></name><name><surname>Fleischmann</surname><given-names>D</given-names></name><name><surname>Wojnarowski</surname><given-names>C</given-names></name><name><surname>Wunderbaldinger</surname><given-names>P</given-names></name><name><surname>Huber</surname><given-names>S</given-names></name><etal/></person-group><article-title>Evolution of CT findings in patients with cystic fibrosis</article-title><source>AJR Am J Roentgenol</source><year>1999</year><volume>173</volume><fpage>81</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">10397104</pub-id></element-citation></ref><ref id="CIT26"><label>26</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Alzeer</surname><given-names>AH</given-names></name><name><surname>Al-Mobeirek</surname><given-names>AF</given-names></name><name><surname>Al-Otair</surname><given-names>HA</given-names></name><name><surname>Elzamzamy</surname><given-names>UA</given-names></name><name><surname>Joherjy</surname><given-names>IA</given-names></name><name><surname>Shaffi</surname><given-names>AS</given-names></name></person-group><article-title>Right and left ventricular function and pulmonary artery pressure in patients with bronchiectasis</article-title><source>Chest</source><year>2008</year><volume>133</volume><fpage>468</fpage><lpage>73</lpage><pub-id pub-id-type="pmid">18071019</pub-id></element-citation></ref><ref id="CIT27"><label>27</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Arcasoy</surname><given-names>SM</given-names></name><name><surname>Christie</surname><given-names>JD</given-names></name><name><surname>Ferrari</surname><given-names>VA</given-names></name><name><surname>Sutton</surname><given-names>MS</given-names></name><name><surname>Zisman</surname><given-names>DA</given-names></name><name><surname>Blumenthal</surname><given-names>NP</given-names></name><etal/></person-group><article-title>Echocardiographic assessment of pulmonary hypertension in patients with advanced lung disease</article-title><source>Am J Respir Crit Care Med</source><year>2003</year><volume>167</volume><fpage>735</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">12480614</pub-id></element-citation></ref></ref-list></back></article>