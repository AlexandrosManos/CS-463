d></td><td align="center">CAA</td><td align="center">TTG</td><td align="center">1</td><td align="center">1</td><td align="center">2</td><td align="center">UUG</td><td align="center">0.76</td><td align="center">1.69</td><td align="center">1.66</td></tr><tr><td></td><td align="center">CAG</td><td align="center">CTG</td><td align="center">3</td><td align="center">2</td><td align="center">4</td><td align="center">CUG</td><td align="center">3.32</td><td align="center">2.1</td><td align="center">1.8</td></tr><tr><td colspan="10"><hr></hr></td></tr><tr><td align="center"><bold>Glu</bold></td><td align="center">GAA</td><td align="center">TTC</td><td align="center">1</td><td align="center">1</td><td align="center">1</td><td align="center">UUC</td><td align="center">1.14</td><td align="center">3.17</td><td align="center">2.17</td></tr><tr><td></td><td align="center">GAG</td><td align="center">CTC</td><td align="center">2</td><td align="center">2</td><td align="center">4 (95%) <sup>1</sup></td><td align="center">CUC</td><td align="center">3.32</td><td align="center">3.81</td><td align="center">2.21</td></tr><tr><td colspan="10"><hr></hr></td></tr><tr><td align="center"><bold>Gly</bold></td><td align="center">GGT</td><td align="center">ACC</td><td align="center">0</td><td align="center">0</td><td align="center">0</td><td align="center"><bold><underline>GCC</underline></bold></td><td align="center">1.25</td><td align="center">2.27</td><td align="center">1.51</td></tr><tr><td></td><td align="center">GGC</td><td align="center">GCC</td><td align="center">4</td><td align="center">3</td><td align="center">4</td><td></td><td align="center">3.36</td><td align="center">1.49</td><td align="center">1.95</td></tr><tr><td></td><td align="center">GGA</td><td align="center">TCC</td><td align="center">1</td><td align="center">1</td><td align="center">2</td><td align="center">UCC</td><td align="center">0.64</td><td align="center">1.56</td><td align="center">2.16</td></tr><tr><td></td><td align=