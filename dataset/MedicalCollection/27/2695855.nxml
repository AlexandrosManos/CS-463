me></person-group><article-title>Infectious agents of sheep scrapie may persist in the environment for at last 16 years</article-title><source>Journal of General Virology</source><year>2006</year><volume>87</volume><fpage>3737</fpage><lpage>3740</lpage><pub-id pub-id-type="pmid">17098992</pub-id></citation></ref><ref id="b9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ghani</surname><given-names>AC</given-names></name><name><surname>Ferguson</surname><given-names>NM</given-names></name><name><surname>Donnelly</surname><given-names>CA</given-names></name><name><surname>Anderson</surname><given-names>RM</given-names></name></person-group><article-title>Factors determining the pattern of the variant Creutzfeldt-Jakob disease (vCJD) epidemic in the UK</article-title><source>Proceedings of the Royal Society, Series B</source><year>2003</year><volume>270</volume><fpage>689</fpage><lpage>698</lpage></citation></ref><ref id="b10"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Grear</surname><given-names>DA</given-names></name></person-group><source>Chronic Wasting Disease Infection Patterns in Female White-tailed Deer Related to Demographics, Genetic Relationships, and Spatial Proximity of Infected Deer in Southern Wisconsin</source><year>2006</year><publisher-loc>Madison, WI, USA</publisher-loc><publisher-name>M.Sc. University of Wisconsin</publisher-name></citation></ref><ref id="b11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grear</surname><given-names>DA</given-names></name><name><surname>Samuel</surname><given-names>MD</given-names></name><name><surname>Langenberg</surname><given-names>JA</given-names></name><name><surname>Keane</surname><given-names>D</given-names></name></person-group><article-title>Demographic patterns and harvest vulnerability of chronic wasting disease infected white-tailed deer in Wisconsin</article-title><source>Journal of Wildlife Management</source><year>2006</year><volume>70</volume><fpage>546</fpage><lpage>553</lpage></citation></ref><ref id="b12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gross</surname><given-names>JE</given-names></name><name><surname>Miller</surname><given-names>MW</given-names></name></person-group><article-title>Chronic wasting disease in mule deer: disease dynamics and control</article-title><source>Journal of Wildlife Management</source><year>2001</year><volume>65</volume><fpage>205</fpage><lpage>215</lpage></citation></ref><ref id="b13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Joly</surname><given-names>DO</given-names></name><name><surname>Ribic</surname><given-names>CA</given-names></name><name><surname>Langenberg</surname><given-names>JA</given-names></name><name><surname>Beheler</surname><given-names>K</given-names></name><name><surname>Batha</surname><given-names>CA</given-names></name><name><surname>Dhuey</surname><given-names>BJ</given-names></name><name><surname>Rolley</surname><given-names>RE</given-names></name><name><surname>Bartelt</surname><given-names>G</given-names></name><name><surname>Van Deelen</surname><given-names>TR</given-names></name><name><surname>Samuel</surname><given-names>MD</given-names></name></person-group><article-title>Chronic wasting disease in free-ranging Wisconsin white-tailed deer</article-title><source>Emerging Infectious Diseases</source><year>2003</year><volume>9</volume><fpage>599</fpage><lpage>601</lpage><pub-id pub-id-type="pmid">12737746</pub-id></citation></ref><ref id="b14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Joly</surname><given-names>DO</given-names></name><name><surname>Samuel</surname><given-names>MD</given-names></name><name><surname>Langenberg</surname><given-names>JA</given-names></name><name><surname>Blanchong</surname><given-names>JA</given-na