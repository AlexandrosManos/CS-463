<given-names>N</given-names></name></person-group><article-title>Kinetics of renaturation of DNA</article-title><source>J. Mol. Biol.</source><year>1968</year><volume>31</volume><fpage>349</fpage><lpage>370</lpage><pub-id pub-id-type="pmid">5637197</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Blake</surname><given-names>RD</given-names></name><name><surname>Klotz</surname><given-names>LC</given-names></name><name><surname>Fresco</surname><given-names>JR</given-names></name></person-group><article-title>Polynucleotides.9. Temperature dependence of kinetics of complex formation in equimolar mixtures of polyriboadenylate and polyribouridylate</article-title><source>J. Am. Chem. Soc.</source><year>1968</year><volume>90</volume><fpage>3556</fpage><lpage>3562</lpage><pub-id pub-id-type="pmid">5651564</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chan</surname><given-names>V</given-names></name><name><surname>Graves</surname><given-names>DJ</given-names></name><name><surname>McKenzie</surname><given-names>SE</given-names></name></person-group><article-title>The biophysics of DNA hybridization with immobilized oligonucleotide probes</article-title><source>Biophys. J.</source><year>1995</year><volume>69</volume><fpage>2243</fpage><lpage>2255</lpage><pub-id pub-id-type="pmid">8599632</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Axelrod</surname><given-names>D</given-names></name><name><surname>Wang</surname><given-names>MD</given-names></name></person-group><article-title>Reduction-of-dimensionality kinetics at reaction-limited cell-surface receptors</article-title><source>Biophys. J.</source><year>1994</year><volume>66</volume