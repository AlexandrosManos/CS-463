><name><surname>Hillman</surname><given-names>K</given-names></name><name><surname>Chen</surname><given-names>J</given-names></name><name><surname>Cretikos</surname><given-names>M</given-names></name><name><surname>Bellomo</surname><given-names>R</given-names></name><name><surname>Brown</surname><given-names>D</given-names></name><name><surname>Doig</surname><given-names>G</given-names></name><name><surname>Finfer</surname><given-names>S</given-names></name><name><surname>Flabouris</surname><given-names>A</given-names></name><name><surname>MERIT study investigators</surname><given-names/></name></person-group><article-title>Introduction of the medical emergency team (MET) system; a cluster randomised controlled trial</article-title><source>Lancet</source><year>2005</year><volume>365</volume><fpage>2091</fpage><lpage>2097</lpage><pub-id pub-id-type="pmid">15964445</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(05)66733-5</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chan</surname><given-names>PS</given-names></name><name><surname>Khalid</surname><given-names>A</given-names></name><name><surname>Longmore</surname><given-names>LS</given-names></name><name><surname>Berg</surname><given-names>RA</given-names></name><name><surname>Kosiborod</surname><given-names>M</given-names></name><name><surname>Spertus</surname><given-names>JA</given-names></name></person-group><article-title>Hospital-wide code rates and mortality before and after implementation of a rapid response team</article-title><source>JAMA</source><year>2008</year><volume>300</volume><fpage>2506</fpage><lpage>2513</lpage><pub-id pub-id-type="pmid">19050194</pub-id><pub-id pub-id-type="doi">10.1001/jama.2008.715</pub-id></citation></ref></ref-list></back></article>