, <string-name><surname>Adjemian</surname> <given-names>J</given-names></string-name>, <string-name><surname>Dabritz</surname> <given-names>H</given-names></string-name>, <string-name><surname>Brown</surname> <given-names>RN</given-names></string-name> <article-title><italic>Anaplasma phagocytophilum</italic> infection in small mammal hosts of <italic>Ixodes</italic> ticks, western United States.</article-title><source>Emerg Infect Dis</source> <year>2008</year>;<volume>14</volume>:<fpage>1147</fpage>&#x02013;<lpage>50</lpage> <pub-id pub-id-type="doi">10.3201/eid1407.071599</pub-id><pub-id pub-id-type="pmid">18598645</pub-id></citation></ref><ref id="R5"><label>5. </label><citation citation-type="journal"><string-name><surname>Barbet</surname> <given-names>AF</given-names></string-name>, <string-name><surname>Lundgren</surname> <given-names>A</given-names></string-name>, <string-name><surname>Alleman</surname> <given-names>R</given-names></string-name>, <string-name><surname>Stuen</surname> <given-names>S</given-names></string-name>, <string-name><surname>Bj&#x000f6;ersdorff</surname> <given-names>A</given-names></string-name>, <string-name><surname>Brown</surname> <given-names>R</given-names></string-name>, <etal/><article-title>Structure of the expression site reveals extensive global diversity in MSP2/P44 variants of <italic>Anaplasma phagocytophilum.</italic></article-title><source>Infect Immun</source> <year>2006</year>;<volume>74</volume>:<fpage>6429</fpage>&#x02013;<lpage>37</lpage> <pub-id pub-id-type="doi">10.1128/IAI.00809-06</pub-id><pub-id pub-id-type="pmid">16966408</pub-id></citation></ref></ref-list></back></article>