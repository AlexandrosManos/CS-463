age><lpage>166</lpage><pub-id pub-id-type="pmid">12692410</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cianciara</surname><given-names>J</given-names></name></person-group><article-title>Hepatitis A shifting epidemiology in Poland and Eastern Europe</article-title><source>Vaccine</source><year>2000</year><volume>18</volume><issue>Suppl 1</issue><fpage>S68</fpage><lpage>S70</lpage><pub-id pub-id-type="pmid">10683553</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>D'Amelio</surname><given-names>R</given-names></name><name><surname>Molica</surname><given-names>C</given-names></name><name><surname>Biselli</surname><given-names>R</given-names></name><name><surname>Stroffolini</surname><given-names>T</given-names></name></person-group><article-title>Surveillance of infectious diseases in the Italian militars as pre-requisite for tailored vaccination programme</article-title><source>Vaccine</source><year>2001</year><volume>19</volume><fpage>2006</fpage><lpage>2011</lpage><pub-id pub-id-type="pmid">11228371</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Pham</surname><given-names>B</given-names></name><name><surname>Duval</surname><given-names>B</given-names></name><name><surname>De Serres</surname><given-names>G</given-names></name><name><surname>Gilca</surname><given-names>V</given-names></name><name><surname>Tricco</surname><given-names>AC</given-names></name><name><surname>Ochnio</surname><given-names>J</given-names></name><name><surname>Scheifele</surname><given-names>DW</given-names></name></person-group><article-title>Seroprevalence of hepatitis A infection in a low endemicity country: a systematic review</article-title><source>BMC Infect Dis</source><year>2005</year><volume>5</volume><fpage>56</fpage><pub-id pub-id-type="pmid">16001978</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Scott</surname><given-names>PT</given-names></name><name><surname>Niebuhr</surname><given-names>DW</given-names></name><name><surname>McGready</surname><given-names>JB</given-names></name><name><surname>Gaydos</surname><given-names>JC</given-names></name></person-group><article-title>Hepatitis B immunity in United States military recruits</article-title><source>J Infect Dis</source><year>2005</year><volume>191</volume><fpage>1835</fpage><lpage>1841</lpage><pub-id pub-id-type="pmid">15871116</pub-id></element-citation></ref></ref-list></back><floats-group><table-wrap id="T1" position="float"><label>Table 1</label><caption><p>Annual incidence of the hepatitis A cases reported among young Korean soldiers</p></caption><graphic xlink:href="jkms-22-546-i001"/></table-wrap><table-wrap id="T2" position="float"><label>Table 2</label><caption><p>Clinical characteristics and initial laboratory findings of patients with acute hepatitis A in the military personnel of Korea</p></caption><graphic xlink:href="jkms-22-546-i002"/><table-wrap-foot><fn><p><sup>*</sup>Values are reported as no. (%) of patients unless otherwise indicated.</p><p><sup>&#x02020;</sup>Values are reported as mean&#x000b1;standard deviation (range). <sup>&#x02021;</sup>Peak bilirubin level (mg/dL); 7.2&#x000b1;4.6 (1.8-22.9).</p></fn></table-wrap-foot></table-wrap></floats-group></article>