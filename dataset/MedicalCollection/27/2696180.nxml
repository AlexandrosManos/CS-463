></person-group><article-title>Reduced production rates of testosterone and dihydrotestosterone in healthy men treated with rosiglitazone</article-title><source><italic>Metabolism: Clinical and Experimental</italic></source><year>2003</year><volume>52</volume><issue>2</issue><fpage>230</fpage><lpage>232</lpage><pub-id pub-id-type="pmid">12601638</pub-id></element-citation></ref><ref id="B16"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rubin</surname><given-names>GL</given-names></name><name><surname>Duong</surname><given-names>JH</given-names></name><name><surname>Clyne</surname><given-names>CD</given-names></name><etal/></person-group><article-title>Ligands for the peroxisomal proliferator-activated receptor <italic>&#x003b3;</italic> and the retinoid X receptor inhibit aromatase cytochrome P450 <italic>(CYP19)</italic> expression mediated by promoter II in human breast adipose</article-title><source><italic>Endocrinology</italic></source><year>2002</year><volume>143</volume><issue>8</issue><fpage>2863</fpage><lpage>2871</lpage><pub-id pub-id-type="pmid">12130549</pub-id></element-citation></ref><ref id="B17"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gasic</surname><given-names>S</given-names></name><name><surname>Nagamani</surname><given-names>M</given-names></name><name><surname>Green</surname><given-names>A</given-names></name><name><surname>Urban</surname><given-names>RJ</given-names></name></person-group><article-title>Troglitazone is a competitive inhibitor of 3<italic>&#x003b2;</italic>-hydroxysteroid dehydrogenase enzyme in the ovary</article-title><source><italic>American Journal of Obstetrics &#x00026; Gynecology</italic></source><year>2001</year><volume>184</volume><issue>4</issue><fpage>575</fpage><lpage>579</lpage><pub-id pub-id-type="pmid">11262455</pub-id></element-citation></ref><ref id="B18"><label>17