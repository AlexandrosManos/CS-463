<name><surname>Capparelli</surname><given-names>EV</given-names></name><name><surname>Bastian</surname><given-names>JF</given-names></name><name><surname>Bradley</surname><given-names>DJ</given-names></name><name><surname>Glode</surname><given-names>MP</given-names></name><name><surname>Santa</surname><given-names>S</given-names></name><etal/></person-group><article-title>Cerebrospinal fluid profile in patients with acute Kawasaki disease</article-title><source>Pediatr Infect Dis J</source><year>1998</year><volume>17</volume><fpage>478</fpage><lpage>481</lpage><pub-id pub-id-type="pmid">9655538</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Okada</surname><given-names>T</given-names></name><name><surname>Harada</surname><given-names>K</given-names></name><name><surname>Okuni</surname><given-names>M</given-names></name></person-group><article-title>Serum HDL-cholesterol and lipoprotein fraction in Kawasaki disease (acute mucocutaneous lymph node syndrome)</article-title><source>Jpn Circ J</source><year>1982</year><volume>46</volume><fpage>1039</fpage><lpage>1044</lpage><pub-id pub-id-type="pmid">6956753</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Newburger</surname><given-names>JW</given-names></name><name><surname>Burns</surname><given-names>JC</given-names></name><name><surname>Beiser</surname><given-names>AS</given-names></name><name><surname>Loscalzo</surname><given-names>J</given-names></name></person-group><article-title>Altered lipid profile after Kawasaki syndrome</article-title><source>Circulation</source><year>1991</year><volume>84</volume><fpage>625</fpage><lpage>631</lpage><pub-id pub-id-type="pmid">1860206</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><perso