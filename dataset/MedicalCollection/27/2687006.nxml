itation-type="journal"><string-name><surname>Aubry-Damon</surname> <given-names>H</given-names></string-name>, <string-name><surname>Grenet</surname> <given-names>K</given-names></string-name>, <string-name><surname>Sall-Ndiaye</surname> <given-names>P</given-names></string-name>, <string-name><surname>Che</surname> <given-names>D</given-names></string-name>, <string-name><surname>Cordeiro</surname> <given-names>E</given-names></string-name>, <string-name><surname>Bougnoux</surname> <given-names>ME</given-names></string-name>, <etal/><article-title>Antimicrobial resistance in commensal flora of pig farmers.</article-title><source>Emerg Infect Dis</source> <year>2004</year>;<volume>10</volume>:<fpage>873</fpage>&#x02013;<lpage>9</lpage><pub-id pub-id-type="pmid">15200822</pub-id></citation></ref></ref-list></back></article>