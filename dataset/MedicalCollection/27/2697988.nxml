<citation citation-type="journal"><person-group person-group-type="author"><name><surname>Highlander</surname><given-names>SK</given-names></name><name><surname>Chidambaram</surname><given-names>M</given-names></name><name><surname>Engler</surname><given-names>MJ</given-names></name><name><surname>Weinstock</surname><given-names>GM</given-names></name></person-group><article-title>DNA sequence of the <italic>Pasteurella haemolytica </italic>leukotoxin gene cluster</article-title><source>DNA</source><year>1989</year><volume>8</volume><fpage>15</fpage><lpage>28</lpage><pub-id pub-id-type="pmid">2707120</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Highlander</surname><given-names>SK</given-names></name><name><surname>Engler</surname><given-names>MJ</given-names></name><name><surname>Weinstock</surname><given-names>GM</given-names></name></person-group><article-title>Secretion and expression of the <italic>Pasteurella haemolytica </italic>leukotoxin</article-title><source>J Bacteriol</source><year>1990</year><volume>172</volume><fpage>2343</fpage><lpage>2350</lpage><pub-id pub-id-type="pmid">2185213</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Strathdee</surname><given-names>CA</given-names></name><name><surname>Lo</surname><given-names>RY</given-names></name></person-group><article-title>Regulation of expression of the <italic>Pasteurella haemolytica </italic>leukotoxin determinant</article-title><source>J Bacteriol</source><year>1989</year><volume>171</volume><fpage>5955</fpage><lpage>5962</lpage><pub-id pub-id-type="pmid">2478522</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Larsen</surname><given-names>J</given-names></name><name><surname>Pedersen</surname><given-names>AG</given-names></name><name><surname>Christensen</