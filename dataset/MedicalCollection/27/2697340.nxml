e>Clin Orthop Relat Res</source><year>1988</year><volume>227</volume><fpage>99</fpage><lpage>102</lpage><pub-id pub-id-type="pmid">3338227</pub-id></mixed-citation></ref><ref id="CR15"><label>15.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Turner</surname><given-names>JA</given-names></name><name><surname>Ersek</surname><given-names>M</given-names></name><name><surname>Herron</surname><given-names>L</given-names></name><etal/></person-group><article-title>Patient outcomes after lumbar spinal fusions</article-title><source>JAMA</source><year>1992</year><volume>268</volume><fpage>907</fpage><lpage>911</lpage><pub-id pub-id-type="doi">10.1001/jama.268.7.907</pub-id><pub-id pub-id-type="pmid">1640622</pub-id></mixed-citation></ref><ref id="CR16"><label>16.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Brantigan</surname><given-names>JW</given-names></name><name><surname>Steffee</surname><given-names>AD</given-names></name><name><surname>Geiger</surname><given-names>JM</given-names></name></person-group><article-title>A carbon fiber implant to aid interbody lumbar fusion. Mechanical testing</article-title><source>Spine</source><year>1991</year><volume>16</volume><fpage>S277</fpage><lpage>S282</lpage><pub-id pub-id-type="doi">10.1097/00007632-199106001-00020</pub-id><pub-id pub-id-type="pmid">1862425</pub-id></mixed-citation></ref><ref id="CR17"><label>17.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ray</surname><given-names>CD</given-names></name></person-group><article-title>Threaded titanium cages for lumbar interbody fusions</article-title><source>Spine</source><year>1997</year><volume>22</volume><fpage>667</fpage><lpage>679</lpage><pub-id pub-id-type="doi">10.1097/00007632-199703150-00019</pub-id><pub-id pub-id-type="pmid">9089940</pub-id></mixed-citation></ref><ref id="CR18"><label>18.