><table-wrap id="t1-tcrm-5-0081" position="float"><label>Table 1</label><caption><p>Systemic conditions associated with angioid streaks</p></caption><table frame="hsides" rules="groups"><tbody><tr><td align="left" rowspan="1" colspan="1">&#x02022; Hemochromatosis</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02022; Acromegaly</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02022; Diabetes mellitus</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02022; Sickle-cell hemoglobinopathies</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02022; Pseudoxanthoma elasticum</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02022; Acquired hemolytic anaemia</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02022; Hereditary spherocytosis</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02022; Myopia</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02022; Neurofibromatosis</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02022; Paget&#x02019;s disease</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02022; Ehlers&#x02013;Danlos syndrome</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02022; Sturge&#x02013;Weber syndrome</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02022; Hyperphosphatemia</td></tr></tbody></table></table-wrap></floats-wrap></article>