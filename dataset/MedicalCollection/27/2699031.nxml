l of Clinical Endocrinology and Metabolism</source><volume>75</volume><fpage>127</fpage><lpage>134</lpage><pub-id pub-id-type="pmid">1619000</pub-id></mixed-citation></ref><ref id="pone.0006014-Weitzman1"><label>9</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Weitzman</surname><given-names>ED</given-names></name><name><surname>Moline</surname><given-names>ML</given-names></name><name><surname>Czeisler</surname><given-names>CA</given-names></name><name><surname>Zimmerman</surname><given-names>JC</given-names></name></person-group><year>1982</year><article-title>Chronobiology of aging: Temperature, sleep-wake rhythms and entrainment.</article-title><source>Neurobiology of Aging</source><volume>3</volume><fpage>299</fpage><lpage>309</lpage><pub-id pub-id-type="pmid">7170047</pub-id></mixed-citation></ref><ref id="pone.0006014-Kendall1"><label>10</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kendall</surname><given-names>AR</given-names></name><name><surname>Lewy</surname><given-names>AJ</given-names></name><name><surname>Sack</surname><given-names>RL</given-names></name></person-group><year>2001</year><article-title>Effects of aging on the intrinsic circadian period of totally blind humans.</article-title><source>Journal of Biological Rhythms</source><volume>16</volume><fpage>87</fpage><lpage>95</lpage><pub-id pub-id-type="pmid">11220783</pub-id></mixed-citation></ref><ref id="pone.0006014-WirzJustice1"><label>11</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wirz-Justice</surname><given-names>A</given-names></name><name><surname>Wever</surname><given-names>RA</given-names></name><name><surname>Aschoff</surname><given-names>J</given-names></name></person-group><year>1984</year><article-title>Seasonality in freerunning circadian rhythms in man.</article-title><source>Naturwissenschaften</source><volume>71</volume><fpage>316</fpage><lpage>319</lpage><pub-id pub-id-type="pmid">6472481</pub-id></mixed-citation></ref><ref id="pone.0006014-Wever2"><label>12</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wever</surname><given-names>RA</given-names></name></person-group><year>1984</year><article-title>Sex differences in human circadian rhythms: Intrinsic periods and sleep fractions.</article-title><source>Experientia</source><volume>40</volume><fpage>1226</fpage><lpage>1234</lpage><pub-id pub-id-type="pmid">6500007</pub-id></mixed-citation></ref><ref id="pone.0006014-Aschoff1"><label>13</label><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Aschoff</surname><given-names>J</given-names></name></person-group><year>1965</year><article-title>The phase-angle difference in circadian periodicity.</article-title><person-group person-group-type="editor"><name><surname>Aschoff</surname><given-names>J</given-names></name></person-group><source>Circadian Clocks</source><publisher-loc>Amsterdam</publisher-loc><publisher-name>North-Holland Publishing Co</publisher-name><fpage>262</fpage><lpage>276</lpage></mixed-citation></ref><ref id="pone.0006014-Pittendrigh2"><label>14</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Pittendrigh</surname><given-names>CS</given-names></name><name><surname>Daan</surname><given-names>S</given-names></name></person-group><year>1976</year><article-title>A functional analysis of circadian pacemakers in nocturnal rodents. IV. Entrainment: pacemaker as clock.</article-title><source>Journal of Comparative Physiology</source><volume>106</volume><fpage>291</fpage><lpage>331</lpage></mixed-citation></ref><ref id="pone.0006014-Duffy1"><label>15</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Duffy</surname><given-names>JF</given-names></name><name><surname>Rimmer</surname><given-names>DW</given-names></name><name><surname>Czeisler</surname><given-names>CA</given-names></name></person-group><year>2001</year><article-title>Association of intrinsic circadian period with morningness-eveningness, usual wake time, and circadian phase.</article-title><source>Behavioral Neuroscience</source><volume>115</volume><fpage>895</fpage><lpage>899</lpage><pub-id pub-id-type="pmid">11508728</pub-id></mixed-citation></ref><ref id="pone.0006014-Horne1"><label>16</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Horne</surname><given-names>JA</given-names></name><name><surname>Ostberg</surname><given-names>O</given-names></name></person-group><year>1976</year><article-title>Self-assessment questionnaire to determine morningness-eveningness in human circadian rhythms.</article-title><source>International Journal of Chronobiology</source><volume>4</volume><fpage>97</fpage><lpage>110</lpage><pub-id pub-id-type="pmid">1027738</pub-id></mixed-citation></ref><ref id="pone.0006014-Wright1"><label>17</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wright</surname><given-names>KP</given-names></name><name><surname>Gronfier</surname><given-names>C</given-names></name><name><surname>Duffy</surname><given-names>JF</given-names></name><name><surname>Czeisler</surname><given-names>CA</given-names></name></person-group><year>2005</year><article-title>Intrinsic period and light intensity determine the phase relationship between melatonin and sleep in humans.</article-title><source>Journal of Biological Rhythms</source><volume>20</volume><fpage>168</fpage><lpage>177</lpage><pub-id pub-id-type="pmid">15834113</pub-id></mixed-citation></ref><ref id="pone.0006014-Burgess2"><label>18</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Burgess</surname><given-names>HJ</giv