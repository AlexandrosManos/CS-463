Ke Za Zhi</source><volume>39</volume><fpage>163</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">12880574</pub-id></mixed-citation></ref></ref-list></back><floats-group><table-wrap id="t1-co-2-575" position="float"><label>Table 1</label><caption><p>Organisms in bacterial isolates during 2001&#x02013;2004 in China</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1">Bacteria</th><th colspan="2" align="left" rowspan="1">2001&#x02013;2002<hr/></th><th colspan="2" align="left" rowspan="1">2003&#x02013;2004<hr/></th><th colspan="2" align="left" rowspan="1">Total<hr/></th></tr><tr><th align="left" rowspan="1" colspan="1"/><th align="left" rowspan="1" colspan="1">Isolates</th><th align="left" rowspan="1" colspan="1">Percent (%)</th><th align="left" rowspan="1" colspan="1">Isolates</th><th align="left" rowspan="1" colspan="1">Percent (%)</th><th align="left" rowspan="1" colspan="1">Isolates</th><th align="left" rowspan="1" colspan="1">Percent (%)</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1"><italic>Staphylococcus epdiermidis</italic></td><td align="left" rowspan="1" colspan="1">22</td><td align="left" rowspan="1" colspan="1">15.83</td><td align="left" rowspan="1" colspan="1">17</td><td align="left" rowspan="1" colspan="1">12.14</td><td align="left" rowspan="1" colspan="1">39</td><td align="left" rowspan="1" colspan="1">13.98</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Staphylococcus aureus</italic></td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">6.47</td><td align="left" rowspan="1" colspan="1">11</td><td align="left" rowspan="1" colspan="1">7.86</td><td align="left" rowspan="1" colspan="1">20</td><td align="left" rowspan="1" colspan="1">7.17</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Micrococcus sp.</italic></td><td align="left" rowspan="1" colspan="1">18</td><td align="left" rowspan="1" colspan="1">12.95</td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">6.43</td><td align="left" rowspan="1" colspan="1">27</td><td align="left" rowspan="1" colspan="1">9.68</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Pneumonococcus</italic></td><td align="left" rowspan="1" colspan="1">11</td><td align="left" rowspan="1" colspan="1">7.91</td><td align="left" rowspan="1" colspan="1">10</td><td align="left" rowspan="1" colspan="1">7.14</td><td align="left" rowspan="1" colspan="1">21</td><td align="left" rowspan="1" colspan="1">7.53</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Streptococcus &#x003b1;-hem</italic>.</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">2.16</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">2.14</td><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">2.15</td></tr><tr><td align="left" rowspan="1" colspan="1">Other Gram-positive cocci</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">1.44</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">2.86</td><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">2.15</td></tr><tr><td content-type="background-color:#A8A8A8" align="left" rowspan="1" colspan="1">Total Gram-positive cocci</td><td content-type="background-color:#A8A8A8" align="left" rowspan="1" colspan="1">65</td><td content-type="background-color:#A8A8A8" align="left" rowspan="1" colspan="1">46.76</td><td content-type="background-color:#A8A8A8" align="left" rowspan="1" colspan="1">54</td><td content-type="background-color:#A8A8A8" align="left" rowspan="1" colspan="1">38.57</td><td content-type="background-color:#A8A8A8" align="left" rowspan="1" colspan="1">119</td><td content-type="background-color:#A8A8A8" align="left" rowspan="1" colspan="1">42.65</td></tr><tr><td ali