><fpage>107</fpage><lpage>116</lpage><pub-id pub-id-type="pmid">1090005</pub-id><pub-id pub-id-type="doi">10.1126/science.1090005</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cooper</surname><given-names>TF</given-names></name><name><surname>Rozen</surname><given-names>DE</given-names></name><name><surname>Lenski</surname><given-names>RE</given-names></name></person-group><article-title>Parallel changes in gene expression after 20,000 generations of evolution in <italic>Escherichia coli</italic></article-title><source>Proc Natl Acad Sci USA</source><year>2003</year><volume>100</volume><fpage>1072</fpage><lpage>1077</lpage><pub-id pub-id-type="pmid">12538876</pub-id><pub-id pub-id-type="doi">10.1073/pnas.0334340100</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferea</surname><given-names>TL</given-names></name><name><surname>Botstein</surname><given-names>D</given-names></name><name><surname>Brown</surname><given-names>PO</given-names></name><name><surname>Rosenzweig</surname><given-names>RF</given-names></name></person-group><article-title>Systematic changes in gene expression patterns following adaptive evolution in yeast</article-title><source>Proc Natl Acad Sci USA</source><year>1999</year><volume>96</volume><fpage>9721</fpage><lpage>9726</lpage><pub-id pub-id-type="pmid">10449761</pub-id><pub-id pub-id-type="doi">10.1073/pnas.96.17.9721</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gompel</surname><given-names>N</given-names></name><name><surname>Prud'homme</surname><given-names>B</given-names></name><name><surname>Wittkopp</surname><given-names>PJ</given-names></name><name><surname>Kassner</surname><given-names>VA</given-names></name><name><surname>Carroll</surname><given-names>SB</given-names></name></person-group><ar