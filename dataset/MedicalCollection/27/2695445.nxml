</name><name><surname>Sundaresan</surname><given-names>G</given-names></name><name><surname>Wu</surname><given-names>AM</given-names></name><name><surname>Gambhir</surname><given-names>SS</given-names></name><name><surname>Weiss</surname><given-names>S</given-names></name></person-group><article-title>Quantum dots for live cells, in vivo imaging, and diagnostics</article-title><source>Science</source><year>2005</year><volume>307</volume><fpage>538</fpage><lpage>544</lpage><pub-id pub-id-type="pmid">15681376</pub-id><pub-id pub-id-type="doi">10.1126/science.1104274</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schaefer</surname><given-names>BC</given-names></name><name><surname>Kappler</surname><given-names>JW</given-names></name><name><surname>Kupfer</surname><given-names>A</given-names></name><name><surname>Marrack</surname><given-names>P</given-names></name></person-group><article-title>Complex and dynamic redistribution of NF-{kappa}B signaling intermediates in response to T cell receptor stimulation</article-title><source>Proc Natl Acad Sci USA</source><year>2004</year><volume>101</volume><fpage>1004</fpage><lpage>1009</lpage><pub-id pub-id-type="pmid">14724296</pub-id><pub-id pub-id-type="doi">10.1073/pnas.0307858100</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dustin</surname><given-names>ML</given-names></name></person-group><article-title>Cell adhesion molecules and actin cytoskeleton at immune synapses and kinapses</article-title><source>Curr Opin Cell Biol</source><year>2007</year><volume>19</volume><fpage>529</fpage><lpage>533</lpage><pub-id pub-id-type="pmid">17923403</pub-id><pub-id pub-id-type="doi">10.1016/j.ceb.2007.08.003</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Su</surname><given-names>H</given-names></name><name><surname>Bidere</surname><given-names>N</given-names></name><name><surname>Zheng</surname><given-names>L</given-names></name><name><surname>Cubre</surname><given-names>A</given-names></name><name><surname>Sakai</surname><given-names>K</given-names></name><name><surname>Dale</surname><given-names>J</given-names></name><name><surname>Salmena</surname><given-names>L</given-names></name><name><surname>Hakem</surname><given-names>R</given-names></name><name><surname>Straus</surname><given-names>S</given-names></name><name><surname>Lenardo</surname><given-names>M</given-names></name></person-group><article-title>Requirement for caspase-8 in NF-kappaB activation by antigen receptor</article-title><source>Science</source><year>2005</year><volume>307</volume><fpage>1465</fpage><lpage>1468</lpage><pub-id pub-id-type="pmid">15746428</pub-id><pub-id pub-id-type="doi">10.1126/science.1104765</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schaefer</surname><given-names>BC</given-names></name><name><surname>Mitchell</surname><given-names>TC</given-names></name><name><surname>Kappler</surname><given-names>JW</given-names></name><name><surname>Marrack</surname><given-names>P</given-names></name></person-group><article-title>A novel family of retroviral vectors for the rapid production of complex stable cell lines</article-title><source>Anal Biochem</source><year>2001</year><volume>297</volume><fpage>86</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">11567531</pub-id><pub-id pub-id-type="doi">10.1006/abio.2001.5327</pub-id></citation></ref></ref-list></back></article>