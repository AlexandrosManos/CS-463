></name></person-group><article-title>Impaired leucocyte functions in diabetic patients</article-title><source>Diabet Med</source><year>1997</year><volume>14</volume><fpage>29</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">9017350</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1096-9136(199701)14:1&#x0003c;29::AID-DIA300&#x0003e;3.0.CO;2-V</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Piantadosi</surname><given-names>CA</given-names></name><name><surname>Schwartz</surname><given-names>DA</given-names></name></person-group><article-title>The acute respiratory distress syndrome</article-title><source>Ann Intern Med</source><year>2004</year><volume>141</volume><fpage>460</fpage><lpage>470</lpage><pub-id pub-id-type="pmid">15381520</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bellingan</surname><given-names>GJ</given-names></name></person-group><article-title>The pulmonary physician in critical care * 6: The pathogenesis of ALI/ARDS</article-title><source>Thorax</source><year>2002</year><volume>57</volume><fpage>540</fpage><lpage>546</lpage><pub-id pub-id-type="pmid">12037231</pub-id><pub-id pub-id-type="doi">10.1136/thorax.57.6.540</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meduri</surname><given-names>GU</given-names></name><name><surname>Kohler</surname><given-names>G</given-names></name><name><surname>Headley</surname><given-names>S</given-names></name><name><surname>Tolley</surname><given-names>E</given-names></name><name><surname>Stentz</surname><given-names>F</given-names></name><name><surname>Postlethwaite</surname><given-names>A</given-names></name></person-group><article-title>Inflammatory cytokines in the BAL of patients with ARDS. Persistent elevation over time predicts poor outcome</article-title><source