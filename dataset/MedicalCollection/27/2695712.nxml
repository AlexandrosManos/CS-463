d pub-id-type="pmid">11711370</pub-id></citation></ref><ref id="b13-co16-3-55"><label>13.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hoshi</surname><given-names>S</given-names></name><name><surname>Sasaki</surname><given-names>M</given-names></name><name><surname>Muto</surname><given-names>A</given-names></name><etal/></person-group><article-title>Case of carcinosarcoma of urinary bladder obtained a pathologically complete response by neoadjuvant chemoradiotherapy</article-title><source>Int J Urol</source><year>2007</year><volume>14</volume><fpage>79</fpage><lpage>81</lpage><pub-id pub-id-type="pmid">17199866</pub-id></citation></ref></ref-list></back><floats-wrap><fig id="f1-co16-3-55" position="float"><label>FIGURE 1</label><caption><p>Invasive high-grade urothelial carcinoma (arrow) with prominent sarcomatoid and neuroendocrine elements.</p></caption><graphic xlink:href="co16-3-55f1"/></fig><fig id="f2-co16-3-55" position="float"><label>FIGURE 2</label><caption><p>Post-chemoradiation treatment biopsy, showing benign urothelial mucosa without residual tumour.</p></caption><graphic xlink:href="co16-3-55f2"/></fig></floats-wrap></article>