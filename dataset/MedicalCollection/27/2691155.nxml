age><comment>Epub June 19 2008</comment><pub-id pub-id-type="pmid">18561865</pub-id></citation></ref><ref id="CIT0020"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dunn</surname><given-names>JT</given-names></name></person-group><article-title>Editorial: What's happening to our iodine?</article-title><source>J Clin Endocrinol Metab</source><year>1998</year><volume>83</volume><fpage>3398</fpage><lpage>400</lpage><pub-id pub-id-type="pmid">9768637</pub-id></citation></ref><ref id="CIT0021"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Delange</surname><given-names>F</given-names></name><name><surname>Benoist</surname><given-names>B</given-names></name><name><surname>Pretell</surname><given-names>E</given-names></name><name><surname>Dunn</surname><given-names>JT</given-names></name></person-group><article-title>Deficiency in the world: where do we stand at the turn of the century?</article-title><source>Thyroid</source><year>2001</year><volume>11</volume><fpage>437</fpage><lpage>49</lpage><pub-id pub-id-type="pmid">11396702</pub-id></citation></ref></ref-list></back></article>