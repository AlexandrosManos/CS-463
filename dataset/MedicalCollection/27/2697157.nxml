fpage><lpage>616</lpage><pub-id pub-id-type="pmid">15353016</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pearson</surname><given-names>S</given-names></name><name><surname>Colbert</surname><given-names>AP</given-names></name><name><surname>McNames</surname><given-names>J</given-names></name><name><surname>Baumgartner</surname><given-names>M</given-names></name><name><surname>Hammerschlag</surname><given-names>R</given-names></name></person-group><article-title>Electrical skin impedance at acupuncture points</article-title><source>J Altern Complement Med</source><year>2007</year><volume>13</volume><fpage>409</fpage><lpage>418</lpage><pub-id pub-id-type="pmid">17532733</pub-id><pub-id pub-id-type="doi">10.1089/acm.2007.6258</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Borys</surname><given-names>B</given-names></name></person-group><article-title>[Psychology in contemporary medicine]</article-title><source>Pol Merkur Lekarski</source><year>2008</year><volume>25</volume><fpage>35</fpage><lpage>39</lpage><pub-id pub-id-type="pmid">19025047</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Teutsch</surname><given-names>C</given-names></name></person-group><article-title>Patient-doctor communication</article-title><source>Med Clin North Am</source><year>2003</year><volume>87</volume><fpage>1115</fpage><lpage>1145</lpage><pub-id pub-id-type="pmid">14621334</pub-id><pub-id pub-id-type="doi">10.1016/S0025-7125(03)00066-X</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Xie</surname><given-names>Y</given-names></name><name><surname>Li</surname><given-names>H</given-names></name><name><surname>Xiao</surname><given-names>W</given-names></name></person-group><article-title>Neurobiological mechanisms of the meridian and the propagation of needle feeling along the meridian pathway</article-title><source>Sci China C Life Sci </source><year>1996</year><volume>39</volume><fpage>99</fpage><lpage>112</lpage><pub-id pub-id-type="pmid">8760476</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>Y</given-names></name><name><surname>Yuan</surname><given-names>L</given-names></name><name><surname>He</surname><given-names>ZQ</given-names></name><name><surname>Wang</surname><given-names>CL</given-names></name></person-group><article-title>[Study on the meridians and acupoints based on fasciaology: an elicitation of the study on digital human being]</article-title><source>Zhongguo Zhen Jiu</source><year>2006</year><volume>26</volume><fpage>785</fpage><lpage>788</lpage><pub-id pub-id-type="pmid">17165500</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brissett</surname><given-names>AE</given-names></name><name><surname>Sherris</surname><given-names>DA</given-names></name></person-group><article-title>Scar contractures, hypertrophic scars, and keloids</article-title><source>Facial Plast Surg</source><year>2001</year><volume>17</volume><fpage>263</fpage><lpage>272</lpage><pub-id pub-id-type="pmid">11735059</pub-id><pub-id pub-id-type="doi">10.1055/s-2001-18827</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kawamata</surname><given-names>S</given-names></name><name><surname>Ozawa</surname><given-names>J</given-names></name><name><surname>Hashimoto</surname><given-names>M</given-names></name><name><surname>Kurose</surname><given-names>T</given-names></name><name><surname>Shinohara</surname><given-names>H</given-names></name></person-group><article-title>Structure of the rat subcutaneous connective tissue in relation to its sliding mechanism</article-title><source>Arch Histol Cytol</source><year>2003</year><volume>66</volume><fpage>273</fpage><lpage>279</lpage><pub-id pub-id-type="pmid">14527168</pub-id><pub-id pub-id-type="doi">10.1679/aohc.66.273</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guimberteau</surname><given-names>JC</given-names></name><name><surname>Sentucq-Rigall</surname><given-names>J</given-names></name><name><surname>Panconi</surname><given-names>B</given-names></name><name><surname>Boileau</surname><given-names>R</given-names></name><name><surname>Mouton</surname><given-names>P</given-names></name><name><surname>Bakhach</surname><given-names>J</given-names></name></person-group><article-title>[Introduction to the knowledge of subcutaneous sliding system in humans]</article-title><source>Ann Chir Plast Esthet</source><year>2005</year><volume>50</volume><fpage>19</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">15695007</pub-id><pub-id pub-id-type="doi">10.1016/j.anplas.2004.10.012</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Becker</surname><given-names>RF</given-names></name></person-group><article-title>The meaning of fascia and fascial continuity</article-title><source>Osteopath Ann</source><year>1975</year><volume>3</volume><fpage>8</fpage><lpage>32</lpage></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huijing</surname><given-names>PA</given-names></name><name><surname>Baan</surname><given-names>GC</given-names></name></person-group><article-title>Extramuscular myofascial force transmission within the rat anterior tibial compartment: proximo-distal differences in muscle force</article-title><source>Acta Physiol Scand</source><year>2001</year><volume>173</volume><fpage>297</fpage><lpage>311</lpage><pub-id pub-id-type="pmid">11736692</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-201X.2001.00911.x</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maas</surname><given-names>H</given-names></name><name><surname>Baan</surname><given-names>GC</given-names></name><name><surname>Huijing</surname><given-names>PA</given-names></name></person-group><article-title>Intermuscular interaction via myofascial force transmission: effects of tibialis anterior and extensor hallucis longus length on force transmission from rat extensor digitorum longus muscle</article-title><source>J Biomech</source><year>2001</year><volume>34</volume><fpage>927</fpage><lpage>940</lpage><pub-id pub-id-type="pmid">11410176</pub-id><pub-id pub-id-type="doi">10.1016/S0021-9290(01)00055-0</pub-id></citation></ref></ref-list></back></article>