align="top" align="center" rowspan="1" colspan="1">39 (34&#x02013;44)</td><td valign="top" align="center" rowspan="1" colspan="1">8 (6&#x02013;12)</td><td valign="top" align="center" rowspan="1" colspan="1">0.000001</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Progression-free survival [months (95% confidence interval)] Initial report</td><td valign="top" align="center" rowspan="1" colspan="1">11 (10&#x02013;12)</td><td valign="top" align="center" rowspan="1" colspan="1">5 (4&#x02013;6)</td><td valign="top" align="center" rowspan="1" colspan="1">0.001</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Updated (<sc>asco</sc> 2008)</td><td valign="top" align="center" rowspan="1" colspan="1">11 (11&#x02013;13)</td><td valign="top" align="center" rowspan="1" colspan="1">5 (4&#x02013;6)</td><td valign="top" align="center" rowspan="1" colspan="1">0.000001</td></tr></tbody></table><table-wrap-foot><fn id="tfn1-co16-s1-s24"><p><sc>asco</sc>= American Society of Clinical oncology (annual meeting).</p></fn></table-wrap-foot></table-wrap><table-wrap id="t2-co16-s1-s24" position="float"><label>TABLE II</label><caption><p>Post-study therapy</p></caption><table frame="hsides" rules="groups"><thead><tr><th valign="middle" align="left" rowspan="1" colspan="1"/><th valign="middle" align="center" rowspan="1" colspan="1"><italic>Sunitinib</italic> (<italic>%</italic>)</th><th valign="middle" align="center" rowspan="1" colspan="1"><italic>Interferon</italic> (<italic>%</italic>)</th><th valign="middle" align="center" rowspan="1" colspan="1">p <italic>Value</italic></th></tr></thead><tbody><tr><td valign="top" align="left" rowspan="1" colspan="1">Any further therapy</td><td valign="top" align="center" rowspan="1" colspan="1">56</td><td valign="top" align="center" rowspan="1" colspan="1">59</td><td valign="top" align="center" rowspan="1" colspan="1"><sc>ns</sc></td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Sunitinib</td><td valign="top" align="center" rowspan="1" colspan="1">11</td><td valign="top" align="center" rowspan="1" colspan="1">33</td><td valign="top" align="center" rowspan="1" colspan="1"><sc>ss</sc></td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">other <sc>vegf</sc>-targeted</td><td valign="top" align="center" rowspan="1" colspan="1">33</td><td valign="top" align="center" rowspan="1" colspan="1">32</td><td valign="top" align="center" rowspan="1" colspan="1"><sc>ns</sc></td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Cytokines</td><td valign="top" align="center" rowspan="1" colspan="1">20</td><td valign="top" align="center" rowspan="1" colspan="1">13</td><td valign="top" align="center" rowspan="1" colspan="1"><sc>ns</sc></td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Inhibitors of m<sc>tor</sc></td><td valign="top" align="center" rowspan="1" colspan="1">9</td><td valign="top" align="center" rowspan="1" colspan="1">4</td><td valign="top" align="center" rowspan="1" colspan="1"><sc>ns</sc></td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Chemotherapy</td><td valign="top" align="center" rowspan="1" colspan="1">6</td><td valign="top" align="center" rowspan="1" colspan="1">6</td><td valign="top" align="center" rowspan="1" colspan="1"><sc>ns</sc></td></tr></tbody></table><table-wrap-foot><fn id="tfn2-co16-s1-s24"><p><sc>ns</sc> = nonsignificant; <sc>ss</sc> = statistically significant; <sc>vegf</sc> = vascular endothelial growth factor; m<sc>tor</sc> = mammalian target of rapamycin.</p></fn></table-wrap-foot></table-wrap></floats-group></article>