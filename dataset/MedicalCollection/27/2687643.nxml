/lpage><pub-id pub-id-type="pmid">11090360</pub-id></element-citation></ref><ref id="B5"><label>5</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ortiz</surname><given-names>GM</given-names></name><name><surname>Wellons</surname><given-names>M</given-names></name><name><surname>Brancato</surname><given-names>J</given-names></name><name><surname>Vo</surname><given-names>HT</given-names></name><name><surname>Zinn</surname><given-names>RL</given-names></name><name><surname>Clarkson</surname><given-names>DE</given-names></name><etal/></person-group><article-title>Structured antiretroviral treatment interruptions in chronically HIV-1-infected subjects</article-title><source>Proc Natl Acad Sci USA</source><year>2001</year><volume>98</volume><fpage>13288</fpage><lpage>13293</lpage><pub-id pub-id-type="pmid">11687611</pub-id></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Davey</surname><given-names>RT</given-names><suffix>Jr</suffix></name><name><surname>Bhat</surname><given-names>N</given-names></name><name><surname>Yoder</surname><given-names>C</given-names></name><name><surname>Chun</surname><given-names>TW</given-names></name><name><surname>Metcalf</surname><given-names>JA</given-names></name><name><surname>Dewar</surname><given-names>R</given-names></name><etal/></person-group><article-title>HIV-1 and T cell dynamics after interruption of highly active antiretroviral therapy (HAART) in patients with a history of sustained viral suppression</article-title><source>Proc Natl Acad Sci USA</source><year>1999</year><volume>96</volume><fpage>15109</fpage><lpage>15114</lpage><pub-id pub-id-type="pmid">10611346</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Youle</surname><given-names>M</given-names></name><name><surname>Janossy</surname><given-names>G</given-names></name><name><surname>Turnbull</surname><given-names>W</given-names></name><name><surname>Tilling</surname><given-names>R</given-names></name><name><surname>Loveday</surname><given-names>C</given-names></name><name><surname>Mocroft</surname><given-names>A</given-names></name><etal/></person-group><article-title>Changes in CD4 lymphocyte counts after interruption of therapy in patients with viral failure on protease inhibitor-containing regimens. Royal Free Centre for HIV Medicine</article-title><source>AIDS</source><year>2000</year><volume>14</volume><fpage>1717</fpage><lpage>1720</lpage><pub-id pub-id-type="pmid">10985307</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sun</surname><given-names>Y</given-names></name><name><surname>Iglesias</surname><given-names>E</given-names></name><name><surname>Samri</surname><given-names>A</given-names></name><name><surname>Kamkamidze</surname><given-names>G</given-names></name><name><surname>Decoville</surname><given-names>T</given-names></name><name><surname>Carcelain</surname><given-names>G</given-names></name><etal/></person-group><article-title>A systematic comparison of methods to measure HIV-1 specific CD8 T cells</article-title><source>J Immunol Methods</source><year>2003</year><volume>272</volume><fpage>23</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">12505709</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Carcelain</surname><given-names>G</given-names></name><name><surname>Tubiana</surname><given-names>R</given-names></name><name><surname>Samri</surname><given-names>A</given-names></name><name><surname>Calvez</surname><given-names>V</given-names></name><name><surname>Delaugerre</surname><given-names>C</given-names></nam