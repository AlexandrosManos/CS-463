45.8), I62V (99.9), I64V (99.9), T74P (99.7), V82A (99.8), I84V (99.6)</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">D67N (22.1), K103N (22.5), M184V (21.7), G190A (20.8), <bold>L210W (14.6), T215F (19.9)</bold></td><td align="left" rowspan="1" colspan="1"><bold><italic>M41L (2.8)</italic></bold>, <bold><italic>A62V (1.4)</italic></bold>, <italic>T69A (3.1)</italic>, <bold><italic>K70R (3)</italic></bold>, <bold><italic>F77L (2.5)</italic></bold>, <bold><italic>Y181C (1.1)</italic></bold>, <bold><italic>K219E (6.4)</italic></bold></td></tr><tr><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">304,000</td><td align="left" rowspan="1" colspan="1">ABC 3TC LPV/r (07)</td><td align="left" rowspan="1" colspan="1">AZT D4T DDI EFV LPV/r</td><td align="left" rowspan="1" colspan="1">M36I (41.9) L63P (100), I93L (100)</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">K103N (67.7), M184V (37.3)</td><td align="left" rowspan="1" colspan="1"><bold><italic>M41L (5.7)</italic></bold></td></tr><tr><td align="left" rowspan="1" colspan="1">5</td><td align="left" rowspan="1" colspan="1">13,080</td><td align="left" rowspan="1" colspan="1">TDF FTC ATV/r (10/07)</td><td align="left" rowspan="1" colspan="1">AZT 3TC EFV (11/05)</td><td align="left" rowspan="1" colspan="1">V32I (99.8), M36I (99.4), I47V (99.2), I50L (48), I62V (100), I64V (100), A71V (100), L90M (100)</td><td align="left" rowspan="1" colspan="1"><italic>M46I (28.3)</italic></td><td align="left" rowspan="1" colspan="1">M41L (76.3), K103N (46.9), M184V (21.4), <bold>L210W (14.5)</bold>, <bold>T215Y (15.8)</bold></td><td align="left" rowspan="1" colspan="1"><bold><italic>A62V (7.9)</italic></bold></td></tr><tr><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">100,000</td><td align="left" rowspan="1" colspan="1">ABC 3TC EFV (10/07)</td><td align="left" rowspan="1" colspan="1">AZ