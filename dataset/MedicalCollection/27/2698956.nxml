-group person-group-type="author"><name><surname>Antonov</surname><given-names>J</given-names></name><name><surname>Goldstein</surname><given-names>DR</given-names></name><name><surname>Oberli</surname><given-names>A</given-names></name><name><surname>Baltzer</surname><given-names>A</given-names></name><name><surname>Pirotta</surname><given-names>M</given-names></name><etal/></person-group><year>2005</year><article-title>Reliable gene expression measurements from degraded RNA by quantitative real-time PCR depend on short amplicons and a proper normalization.</article-title><source>Lab Invest</source><volume>85</volume><fpage>1040</fpage><lpage>1050</lpage><pub-id pub-id-type="pmid">15951835</pub-id></mixed-citation></ref><ref id="pone.0005911-Cronin1"><label>8</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cronin</surname><given-names>M</given-names></name><name><surname>Pho</surname><given-names>M</given-names></name><name><surname>Dutta</surname><given-names>D</given-names></name><name><surname>Stephans</surname><given-names>JC</given-names></name><name><surname>Shak</surname><given-names>S</given-names></name><etal/></person-group><year>2004</year><article-title>Measurement of gene expression in archival paraffin-embedded tissues: development and performance of a 92-gene reverse transcriptase-polymerase chain reaction assay.</article-title><source>Am J Pathol</source><volume>164</volume><fpage>35</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">14695316</pub-id></mixed-citation></ref><ref id="pone.0005911-Buyse1"><label>9</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Buyse</surname><given-names>M</given-names></name><name><surname>Loi</surname><given-names>S</given-names></name><name><surname>van't Veer</surname><given-names>L</given-names></name><name><surname>Viale</surname><given-names>G</given-names></name><name><surname>Delorenzi</surname>