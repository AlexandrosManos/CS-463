f><ref id="pone.0006114-Mereghetti1"><label>6</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mereghetti</surname><given-names>L</given-names></name><name><surname>Sitkiewicz</surname><given-names>I</given-names></name><name><surname>Green</surname><given-names>NM</given-names></name><name><surname>Musser</surname><given-names>JM</given-names></name></person-group><year>2008</year><article-title>Remodeling of the <italic>Streptococcus agalactiae</italic> transcriptome in response to growth temperature.</article-title><source>PLoS ONE</source><volume>3</volume><fpage>e2785</fpage><pub-id pub-id-type="pmid">18665215</pub-id></mixed-citation></ref><ref id="pone.0006114-Mereghetti2"><label>7</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mereghetti</surname><given-names>L</given-names></name><name><surname>Sitkiewicz</surname><given-names>I</given-names></name><name><surname>Green</surname><given-names>NM</given-names></name><name><surname>Musser</surname><given-names>JM</given-names></name></person-group><year>2008</year><article-title>Extensive adaptive changes occur in the transcriptome of <italic>Streptococcus agalactiae</italic> (group B <italic>Streptococcus</italic>) in response to incubation with human blood.</article-title><source>Plos ONE</source><volume>3(9)</volume><fpage>e3143</fpage><pub-id pub-id-type="pmid">18769548</pub-id></mixed-citation></ref><ref id="pone.0006114-Graham1"><label>8</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Graham</surname><given-names>MR</given-names></name><name><surname>Virtaneva</surname><given-names>K</given-names></name><name><surname>Porcella</surname><given-names>SF</given-names></name><name><surname>Barry</surname><given-names>WT</given-names></name><name><surname>Gowen</surname><given-names>BB</given-names></name><etal/></person-group><year>2005</