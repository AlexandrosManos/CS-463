n></ref><ref id="B7"><citation citation-type="book"><person-group person-group-type="author"><collab>Office National des Statistiques</collab></person-group><source>Annuaires statistiques 1995&#x02013;2005</source><publisher-name>Minist&#x000e8;re des affaires &#x000e9;conomiques et du d&#x000e9;veloppement, Mauritanie</publisher-name><fpage>144</fpage></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moody</surname><given-names>A</given-names></name></person-group><article-title>Rapid diagnostic tests for malaria parasites</article-title><source>Clin Microbiol Rev</source><year>2002</year><volume>15</volume><fpage>66</fpage><lpage>78</lpage><pub-id pub-id-type="pmid">11781267</pub-id><pub-id pub-id-type="doi">10.1128/CMR.15.1.66-78.2002</pub-id></citation></ref><ref id="B9"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Shute</surname><given-names>GT</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Wernsdorfer WH, McGregor I</surname></name></person-group><article-title>The microscopic diagnosis of malaria</article-title><source>Malaria</source><year>1988</year><publisher-name>Churchill Livingstone, Edinburgh</publisher-name><fpage>805</fpage></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Trape</surname><given-names>JF</given-names></name><name><surname>Peelman</surname><given-names>P</given-names></name><name><surname>Morault-Peelman</surname><given-names>B</given-names></name></person-group><article-title>Criteria for diagnosing clinical malaria among a semi-immune population exposed to intense and perennial transmission</article-title><source>Trans R Soc Trop Med Hyg</source><year>1985</year><volume>79</volume><fpage>435</fpage><lpage>442</lpage><pub-id pub-id-type="pmid">3909550</pub-id><pub-id pub-id-type="doi">10.1016/0035-9203(85)90054-9</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Snounou</surname><given-names>G</given-names></name><name><surname>Viriyakosol</surname><given-names>S</given-names></name><name><surname>Zhu</surname><given-names>XP</given-names></name><name><surname>Jarra</surname><given-names>W</given-names></name><name><surname>Pinheiro</surname><given-names>L</given-names></name><name><surname>do Rosario</surname><given-names>VE</given-names></name><name><surname>Thaithong</surname><given-names>S</given-names></name><name><surname>Brown</surname><given-names>KN</given-names></name></person-group><article-title>High sensitivity of detection of human malaria parasites by use of nested polymerase chain reaction amplification</article-title><source>Mol Biochem Parasitol</source><year>1993</year><volume>61</volume><fpage>315</fpage><lpage>320</lpage><pub-id pub-id-type="pmid">8264734</pub-id><pub-id pub-id-type="doi">10.1016/0166-6851(93)90077-B</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gillies</surname><given-names>MT</given-names></name><name><surname>De Meillon</surname><given-names>D</given-names></name></person-group><article-title>The Anophelinae of Africa South of the Sahara</article-title><source>Publ South Afri Inst Med Res</source><year>1968</year><volume>54</volume><fpage>343</fpage></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gillies</surname><given-names>MT</given-names></name><name><surname>Coetzee</surname><given-names>M</given-names></name></person-group><article-title>A supplement to the <italic>Anophelinae </italic>of Africa South of the Sahara</article-title><source>Publ South Afri Inst Med Res</source><year>1987</year><volume>55</volume><edition>2</edition><fpage>143</fpage></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Scott</surname><given-names>JA</given-names></name><name><surname>Brogdon</surname><given-names>WG</given-names></name><name><surname>Collins</surname><given-names>FH</given-names></name></person-group><article-title>Identification of single specimens of the <italic>Anopheles gambiae </italic>complex by the polymerase chain reaction</article-title><source>Am J Trop Med Hyg</source><year>1993</year><volume>49</volume><fpage>520</fpage><lpage>529</lpage><pub-id pub-id-type="pmid">8214283</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burkot</surname><given-names>TR</given-names></name><name><surname>Williams</surname><given-names>Jl</given-names></name><name><surname>Schneider</surname><given-names>I</given-names></name></person-group><article-title>Identification of <italic>Plasmodium falciparum</italic>-infected mosquitoes by a double antibody enzyme-linked immunosorbent assay</article-title><source>Am J Trop Med Hyg</source><year>1984</year><volume>33</volume><fpage>783</fpage><lpage>788</lpage><pub-id pub-id-type="pmid">6385740</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wirtz</surname><given-names>R</given-names></name><name><surname>Zavala</surname><given-names>F</given-names></name><name><surname>Charoenvit</surname><given-names>Y</given-names></name><name><surname>Campbell</surname><given-names>GH</given-names></name><name><surname>Burkot</surname><given-names>TR</given-names></name><name><surname>Schneider</surname><given-names>I</given-names></name><name><surname>Esser</surname><given-names>KM</given-names></name><name><surname>Beaudouin</surname><given-names>RL</given-names></name><name><surname>Andre</surname><given-names>RG</given-names></name></person-group><article-title>Comparative testing monoclonal antibodies against <italic>Plasmodium falciparum </italic>sporozo&#x000ef;tes for ELISA development</article-title><source>Bull World Health Organ</source><year>1987</year><volume>65</volume><fpage>39</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">3555879</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Othnigu&#x000e9;</surname><given-names>N</given-names></name><name><surname>Wyss</surname><given-names>K</given-names></name><name><surname>Tanner</surname><given-names>M</given-names></name><name><surname>Genton</surname><given-names>B</given-names></name></person-group><article-title>Urban malaria in the Sahel: prevalence and seasonality of presumptive malaria and parasitaemia at primary care level in Chad</article-title><source>Trop Med Int Health</source><year>2006</year><volume>11</volume><fpage>204</fpage><lpage>210</lpage><pub-id pub-id-type="pmid">16451345</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-3156.2005.01551.x</pub-id></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Coulibaly</surname><given-names>A</given-names></name></person-group><source>Analyse du syst&#x000e8;me vectoriel du district de Nouakchott</source><year>1997</year><publisher-name>PNLP, OMS Mauritanie</publisher-name></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rabarijaona</surname><given-names>LP</given-names></name><name><surname>Ariey</surname><given-names>F</given-names></name><name><surname>Matra</surname><given-names>R</given-names></name><name><surname>Cot</surname><given-names>S</given-names></name><name><surname>Raharimalala</surname><given-names>AL</given-names></name><name><surname>Ranaivo</surname><given-names>LH</given-names></name><name><surname>Le Bras</surname><given-names>J</given-names></name><name><surname>Robert</surname><given-names>V</given-names></name><name><surname>Randrianarivelojosia</surname><given-names>M</given-names></name></person-group><article-title>Low autochtonous urban malaria in Antananarivo (Madagascar)</article-title><source>Malar J</source><year>2006</year><volume>5</volume><fpage>27</fpage><pub-id pub-id-type="pmid">16573843</pub-id><pub-id pub-id-type="doi">10.1186/1475-2875-5-27</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gasquet</surname><given-names>M</given-names></name><name><surname>Delmont</surname><given-names>J</given-names></name><name><surname>Le Bras</surname><given-names>J</given-names></name></person-group><article-title>Chloroquine-resistant falciparum malaria in Mauritania</article-title><source>Lancet</source><year>1995</year><volume>346</volume><fpage>1556</fpage><pub-id pub-id-type="pmid">7491060</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(95)92083-8</pub-id></citation></ref></ref-list></back></article>