erson-group-type="author"><name><surname>Kricka</surname><given-names>LJ</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Burtis CA, Ashwood ER, Bruns DE</surname></name></person-group><article-title>Principles of immunochemical techniques</article-title><source>Tietz textbook of clinical chemistry and molecular diagnostics</source><year>2006</year><edition>4</edition><publisher-name>St. Louis, MO: Elsevier Saunders</publisher-name><fpage>219</fpage><lpage>243</lpage></citation></ref><ref id="B7"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Porter</surname><given-names>WH</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Burtis CA, Ashwood ER, Bruns DE</surname></name></person-group><article-title>Clinical toxicology</article-title><source>Tietz textbook of clinical chemistry and molecular diagnostics</source><year>2006</year><publisher-name>St. Louis, MO: Elsevier Saunders</publisher-name><fpage>1287</fpage><lpage>1369</lpage></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mul&#x000e9;</surname><given-names>SJ</given-names></name><name><surname>Bastos</surname><given-names>ML</given-names></name><name><surname>Jukofsky</surname><given-names>D</given-names></name></person-group><article-title>Evaluation of immunoassay methods for detection, in urine, of drugs subject to abuse</article-title><source>Clin Chem</source><year>1974</year><volume>20</volume><fpage>243</fpage><lpage>248</lpage><pub-id pub-id-type="pmid">4130418</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Spector</surname><given-names>S</given-names></name><name><surname>Flynn</surname><given-names>EJ</given-names></name></person-group><article-title>Barbiturates: radioimmunoassay</article-title><source>Science</source><year>1971</