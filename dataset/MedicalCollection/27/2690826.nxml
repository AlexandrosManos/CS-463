ub-id-type="pmid">8118845</pub-id></citation></ref><ref id="pone.0005897-Gendre1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gendre</surname><given-names>N</given-names></name><name><surname>Luer</surname><given-names>K</given-names></name><name><surname>Friche</surname><given-names>S</given-names></name><name><surname>Grillenzoni</surname><given-names>N</given-names></name><name><surname>Ramaekers</surname><given-names>A</given-names></name><etal/></person-group><year>2004</year><article-title>Integration of complex larval chemosensory organs into the adult nervous system of Drosophila.</article-title><source>Development</source><volume>131</volume><fpage>83</fpage><lpage>92</lpage><pub-id pub-id-type="pmid">14645122</pub-id></citation></ref><ref id="pone.0005897-DamblyChaudiere1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dambly-Chaudiere</surname><given-names>C</given-names></name><name><surname>Jamet</surname><given-names>E</given-names></name><name><surname>Burri</surname><given-names>M</given-names></name><name><surname>Bopp</surname><given-names>D</given-names></name><name><surname>Basler</surname><given-names>K</given-names></name><etal/></person-group><year>1992</year><article-title>The paired box gene pox neuro: a determinant of poly-innervated sense organs in Drosophila.</article-title><source>Cell</source><volume>69</volume><fpage>159</fpage><lpage>172</lpage><pub-id pub-id-type="pmid">1348214</pub-id></citation></ref><ref id="pone.0005897-DamblyChaudiere2"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dambly-Chaudiere</surname><given-names>C</given-names></name><name><surname>Leyns</surname><given-names>L</given-names></name></person-group><year>1992</year><article-title>The determination of sense organs in Drosophila: a search for interacting genes.</article-title><s