June 2008</date-in-citation><comment>Available at      <ext-link ext-link-type="uri" xlink:href="http://www.impairment.com/use_of_AMA_guides_maps.htm">http://www.impairment.com/use_of_AMA_guides_maps.htm</ext-link></comment></element-citation></ref><ref id="B38"><label>38</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Hall</surname><given-names>LB</given-names></name></person-group><source>New Hampshire-Analysis of AMA guides</source><year>2008</year><month>5</month><day>02</day><edition>6th edition</edition><publisher-loc>Plainfield, VT</publisher-loc><publisher-name>National Council on Compensation Insurance, Inc</publisher-name></element-citation></ref><ref id="B39"><label>39</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Hall</surname><given-names>LB</given-names></name></person-group><source>Vermont-Analysis of AMA guides</source><year>2008</year><month>5</month><day>02</day><edition>6th edition</edition><publisher-loc>Plainfield, VT</publisher-loc><publisher-name>National Council on Compensation Insurance, Inc</publisher-name></element-citation></ref><ref id="B40"><label>40</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Hall</surname><given-names>LB</given-names></name></person-group><source>Rhode Island-Analysis of AMA guides</source><year>2008</year><month>5</month><day>02</day><edition>6th edition</edition><publisher-loc>Plainfield, VT</publisher-loc><publisher-name>National Council on Compensation Insurance, Inc</publisher-name></element-citation></ref><ref id="B41"><label>41</label><element-citation publication-type="webpage"><person-group person-group-type="author"><name><surname>Walleser</surname><given-names>HM</given-names></name></person-group><source>2008 Iowa AMA Guides task force process report</source><date-in-citation>accessed 6 June 2008</date-in-citation><comment>Available