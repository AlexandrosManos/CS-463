n-group><article-title>The effect of compensation involvement on the reporting of pain and disability by patients referred for rehabilitation of chronic low back pain</article-title><source>Spine</source><year>1997</year><volume>22</volume><fpage>2016</fpage><lpage>2024</lpage><pub-id pub-id-type="pmid">9306533</pub-id></element-citation></ref><ref id="B22"><label>22</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Guest</surname><given-names>GH</given-names></name><name><surname>Drummond</surname><given-names>PD</given-names></name></person-group><article-title>Effect of compensation on emotional state and disability in chronic back pain</article-title><source>Pain</source><year>1992</year><volume>48</volume><fpage>125</fpage><lpage>130</lpage><pub-id pub-id-type="pmid">1534164</pub-id></element-citation></ref><ref id="B23"><label>23</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jamison</surname><given-names>RN</given-names></name><name><surname>Matt</surname><given-names>DA</given-names></name><name><surname>Parris</surname><given-names>WC</given-names></name></person-group><article-title>Effects of time, limited vs. unlimited compensation on pain behavior and treatment outcome in low back pain patients</article-title><source>J Psychosom Res</source><year>1988</year><volume>32</volume><fpage>277</fpage><lpage>283</lpage><pub-id pub-id-type="pmid">2972831</pub-id></element-citation></ref><ref id="B24"><label>24</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Leavitt</surname><given-names>F</given-names></name></person-group><article-title>The physical exertion factor in compensable work injuries; a hidden flaw in previous research</article-title><source>Spine</source><year>1992</year><volume>17</volume><fpage>307</fpage><lpage>310</lpage><pub-id pub-id-type="pmid">1533059</pub-id></element-citation></ref><ref id="B25"><label>25</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Milhous</surname><given-names>RL</given-names></name><name><surname>Haugh</surname><given-names>LD</given-names></name><name><surname>Frymoyer</surname><given-names>JW</given-names></name><name><surname>Ruess</surname><given-names>JM</given-names></name><name><surname>Gallagher</surname><given-names>RM</given-names></name><name><surname>Wilder</surname><given-names>DG</given-names></name><name><surname>Callas</surname><given-names>PW</given-names></name></person-group><article-title>Determinants of vocational disability in patients with low back pain</article-title><source>Arch Phys Med Rehabil</source><year>1989</year><volume>70</volume><fpage>589</fpage><lpage>593</lpage><pub-id pub-id-type="pmid">2527487</pub-id></element-citation></ref><ref id="B26"><label>26</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Fredrickson</surname><given-names>BE</given-names></name><name><surname>Trief</surname><given-names>PM</given-names></name><name><surname>VanBeveren</surname><given-names>P</given-names></name><name><surname>Yuan</surname><given-names>HA</given-names></name><name><surname>Baum</surname><given-names>G</given-names></name></person-group><article-title>Rehabilitation of the patient with chronic back pain: a search for outcome predictors</article-title><source>Spine</source><year>1988</year><volume>13</volume><fpage>351</fpage><lpage>353</lpage><pub-id pub-id-type="pmid">2968668</pub-id></element-citation></ref><ref id="B27"><label>27</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Guck</surname><given-names>TP</given-names></name><name><surname>Meilman</surname><given-names>PW</given-names></name><name><surname>Skultety</surname><given-names>FK</given-names></name><name><surname>Dowd</surname><given-names>ET</given-names></name></person-group><article-title>Prediction of long-term outcome of multidisciplinary pain treatment</article-title><source>Arch Phys Med Rehabil</source><year>1986</year><volume>67</volume><fpage>293</fpage><lpage>296</lpage><pub-id pub-id-type="pmid">3707313</pub-id></element-citation></ref><ref id="B28"><label>28</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Leigh</surname><given-names>JP</given-names></name><name><surname>Markowitz</surname><given-names>SB</given-names></name><name><surname>Fahs</surname><given-names>M</given-names></name><name><surname>Shin</surname><given-names>C</given-names></name><name><surname>Landrigan</surname><given-names>PJ</given-names></name></person-group><article-title>Occupational injury and illness in the United States: estimates of cost, morbidity and mortality</article-title><source>Arch Intern Med</source><year>1997</year><volume>157</volume><fpage>1557</fpage><lpage>1568</lpage><pub-id pub-id-type="pmid">9236557</pub-id></element-citation></ref><ref id="B29"><label>29</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Berkowitz</surname><given-names>M</given-names></name><name><surname>Burton</surname><given-names>JF</given-names><suffix>Jr</suffix></name></person-group><source>Permanent disability benefits in workers' compensation</source><year>1987</year><publisher-loc>Kalamazoo, MI</publisher-loc><publisher-name>W.E. Upjohn Institute for Employment Research</publisher-name></element-citation></ref><ref id="B30"><label>30</label><element-citation publication-type="book"><source>American Medical Association guides to the evaluation of permanent impairment</source><year>1971</year><publisher-loc>Chicago, IL</publisher-loc><publisher-name>American Medical Association</publisher-name></element-citation></ref><ref id="B31"><label>31</label><element-citation publication-type="book"><sourc