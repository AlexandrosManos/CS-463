pmid">17690571</pub-id><pub-id pub-id-type="doi">10.1097/QAD.0b013e328270356a</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Palella</surname><given-names>FJ</given-names><suffix>Jr</suffix></name><name><surname>Cole</surname><given-names>SR</given-names></name><name><surname>Chmiel</surname><given-names>JS</given-names></name><name><surname>Riddler</surname><given-names>SA</given-names></name><name><surname>Visscher</surname><given-names>B</given-names></name><name><surname>Dobs</surname><given-names>A</given-names></name><name><surname>Williams</surname><given-names>C</given-names></name></person-group><article-title>Anthropometrics and examiner-reported body habitus abnormalities in the multicenter AIDS cohort study</article-title><source>Clin Infect Dis</source><year>2004</year><volume>38</volume><fpage>903</fpage><lpage>907</lpage><pub-id pub-id-type="pmid">14999638</pub-id><pub-id pub-id-type="doi">10.1086/381684</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dybul</surname><given-names>M</given-names></name><name><surname>Fauci</surname><given-names>AS</given-names></name><name><surname>Bartlett</surname><given-names>JG</given-names></name><name><surname>Kaplan</surname><given-names>JE</given-names></name><name><surname>Pau</surname><given-names>AK</given-names></name></person-group><article-title>Guidelines for using antiretroviral agents among HIV-infected adults and adolescents</article-title><source>Ann Intern Med</source><year>2002</year><volume>137</volume><fpage>381</fpage><lpage>433</lpage><pub-id pub-id-type="pmid">12617573</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>T</given-names></name><name><surname>Wang</surname><given-names>Z</given-names></name><name><surname>Chu</surname>