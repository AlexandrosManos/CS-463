-title><source>Eur Child Adolesc Psychiatry</source><year>2006</year><volume>15</volume><fpage>300</fpage><lpage>307</lpage><pub-id pub-id-type="pmid">16572276</pub-id><pub-id pub-id-type="doi">10.1007/s00787-006-0537-4</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rowe</surname><given-names>SK</given-names></name><name><surname>Rapaport</surname><given-names>MH</given-names></name></person-group><article-title>Classification and treatment of sub-threshold depression</article-title><source>Curr Opin Psychiatry</source><year>2006</year><volume>19</volume><fpage>9</fpage><lpage>13</lpage><pub-id pub-id-type="pmid">16612172</pub-id><pub-id pub-id-type="doi">10.1097/01.yco.0000194148.26766.ba</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fifer</surname><given-names>SK</given-names></name><name><surname>Mathias</surname><given-names>SD</given-names></name><name><surname>Patrick</surname><given-names>DL</given-names></name><name><surname>Mzonson</surname><given-names>P</given-names></name><name><surname>Lubeck</surname><given-names>DP</given-names></name><name><surname>Buesching</surname><given-names>DP</given-names></name></person-group><article-title>Untreated anxiety among adult primary care patients in a health maintenance organization</article-title><source>Arch Gen Psychiatry</source><year>1994</year><volume>51</volume><fpage>740</fpage><lpage>750</lpage><pub-id pub-id-type="pmid">8080351</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldberg</surname><given-names>D</given-names></name></person-group><article-title>Epidemiology of mental disorders in primary care settings</article-title><source>Epidemiol Rev</source><year>1995</year><volume>17</volume><fpage>182</fpage><lpage>190</lpage><pub-id pub-id-type="pmid">8521936<