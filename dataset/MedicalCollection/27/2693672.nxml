-wrap id="bwc-66-07-0471-t04" position="float"><label>Table 4</label><caption><title>Specific prevalence rates of at least one clinically diagnosed upper limb MSD according to occupation</title></caption><table frame="hsides" rules="groups"><colgroup span="1"><col align="left" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/></colgroup><thead><tr><td rowspan="2" align="left" colspan="1">Occupation (French classification PCS)</td><td colspan="3" align="left" rowspan="1">Men</td><td colspan="3" align="left" rowspan="1">Women</td></tr><tr><td align="left" rowspan="1" colspan="1">No</td><td align="left" rowspan="1" colspan="1">n</td><td align="left" rowspan="1" colspan="1">%</td><td align="left" rowspan="1" colspan="1">No</td><td align="left" rowspan="1" colspan="1">n</td><td align="left" rowspan="1" colspan="1">%</td></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">3. Managers and professionals (PCS 31&#x02013;38)</td><td align="char" rowspan="1" colspan="1">210</td><td align="char" rowspan="1" colspan="1">18</td><td align="char" rowspan="1" colspan="1">8.6</td><td align="char" rowspan="1" colspan="1">78</td><td align="char" rowspan="1" colspan="1">6</td><td align="char" rowspan="1" colspan="1">7.7</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;Administrative managers (PCS 32&#x02013;35)</td><td align="char" rowspan="1" colspan="1">42</td><td align="char" rowspan="1" colspan="1">3</td><td align="char" rowspan="1" colspan="1">7.1</td><td align="char" rowspan="1" colspan="1">25</td><td align="char" rowspan="1" colspan="1">3</td><td align="char" rowspan="1" colspan="1">12.0</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;Directors and chief executives (PCS 37)</td