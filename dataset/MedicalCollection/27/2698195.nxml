uthor"><name><surname>Egilmez</surname><given-names>NK</given-names></name><name><surname>Hess</surname><given-names>SD</given-names></name><name><surname>Chen</surname><given-names>FA</given-names></name><name><surname>Takita</surname><given-names>H</given-names></name><name><surname>Conway</surname><given-names>TF</given-names></name><name><surname>Bankert</surname><given-names>RB</given-names></name></person-group><article-title>Human CD4<sup>+</sup> effector T cells mediate indirect interleukin-12 and interferon-&#x003b3;-dependent suppression of autologous HLA-negative lung tumor xenografts in severe combined immunodeficient mice</article-title><source>Cancer Res</source><year>2002</year><volume>62</volume><fpage>2611</fpage><lpage>2617</lpage><pub-id pub-id-type="pmid">11980657</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chuang</surname><given-names>M</given-names></name><name><surname>Lee</surname><given-names>MW</given-names></name><name><surname>Zhao</surname><given-names>D</given-names></name><name><surname>Severson</surname><given-names>DL</given-names></name></person-group><article-title>Metabolism of a long chain diacylglycerol by permeabilized A10 smooth muscle cells</article-title><source>Am J Physiol</source><year>1993</year><volume>265</volume><fpage>C927</fpage><lpage>C933</lpage><pub-id pub-id-type="pmid">8238317</pub-id></element-citation></ref><ref id="B16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Forcic</surname><given-names>D</given-names></name><name><surname>Mazuran</surname><given-names>R</given-names></name></person-group><article-title>Modulation of [Ca<sup>2+</sup>]<sub>i</sub> in freshly isolated mouse lymphocytes with in vivo priming</article-title><source>Immunol Lett</source><year>1999</year><volume>67</volume><fpage>23</fpage><lpage>30</l