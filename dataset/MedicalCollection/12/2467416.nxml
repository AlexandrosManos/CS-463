"><name><surname>Chen</surname><given-names>KT</given-names></name></person-group><article-title>Gallbladder vasculitis</article-title><source>J Clin Gastroenterol</source><year>1989</year><volume>11</volume><fpage>537</fpage><lpage>540</lpage><pub-id pub-id-type="pmid">2571633</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zizic</surname><given-names>TM</given-names></name></person-group><article-title>Vascular lesions in SLE</article-title><source>Md Med J</source><year>1991</year><volume>40</volume><fpage>887</fpage><lpage>899</lpage><pub-id pub-id-type="pmid">1943518</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gobbi</surname><given-names>S</given-names></name><name><surname>Sarli</surname><given-names>L</given-names></name><name><surname>Violi</surname><given-names>V</given-names></name><name><surname>Roncoroni</surname><given-names>L</given-names></name></person-group><article-title>Laparoscopically assisted treatment of acute abdomen in systemic lupus erythematosus</article-title><source>Surg Endosc</source><year>2000</year><volume>14</volume><fpage>1085</fpage><lpage>1086</lpage><pub-id pub-id-type="pmid">11287987</pub-id></citation></ref></ref-list></back></article>