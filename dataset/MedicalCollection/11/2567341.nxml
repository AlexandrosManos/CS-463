group><article-title>Explaining diffusion patterns for complex health care innovations</article-title><source>Health Care Management Review</source><year>2002</year><volume>27</volume><fpage>60</fpage><lpage>73</lpage><pub-id pub-id-type="pmid">12146784</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Michie</surname><given-names>S</given-names></name><name><surname>Abraham</surname><given-names>C</given-names></name></person-group><article-title>Intervention to change health behaviours: Evidence based or evidence inspired?</article-title><source>Psychology &#x00026; Health</source><year>2004</year><volume>19</volume><fpage>29</fpage><lpage>49</lpage><pub-id pub-id-type="doi">10.1080/0887044031000141199</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ockene</surname><given-names>IS</given-names></name><name><surname>Ockene</surname><given-names>JK</given-names></name></person-group><article-title>Barriers to lifestyle change, and the need to develop an integrated approach to prevention</article-title><source>Cardiology Clinics</source><year>1996</year><volume>14</volume><fpage>159</fpage><lpage>169</lpage><pub-id pub-id-type="pmid">9072288</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McClaran</surname><given-names>J</given-names></name><name><surname>Kaufman</surname><given-names>DM</given-names></name><name><surname>Toombs</surname><given-names>M</given-names></name><name><surname>Beardall</surname><given-names>S</given-names></name><name><surname>Levy</surname><given-names>I</given-names></name><name><surname>Chockalingam</surname><given-names>A</given-names></name></person-group><article-title>From death and disability to patient empowerment: an interprofessional partnership to achieve cardiovascular health in Canada</arti