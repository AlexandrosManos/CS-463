ion></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Landis</surname><given-names>JR</given-names></name><name><surname>Koch</surname><given-names>GG</given-names></name></person-group><article-title>The measurement of observer agreement for categorical data</article-title><source>Biometrics</source><year>1977</year><volume>33</volume><fpage>159</fpage><lpage>174</lpage><pub-id pub-id-type="pmid">843571</pub-id><pub-id pub-id-type="doi">10.2307/2529310</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bolton-Smith</surname><given-names>C</given-names></name><name><surname>Woodward</surname><given-names>M</given-names></name><name><surname>Tunstall-Pedoe</surname><given-names>H</given-names></name><name><surname>Morrison</surname><given-names>C</given-names></name></person-group><article-title>Accuracy of the estimated prevalence of obesity from self reported height and weight in an adult Scottish population</article-title><source>J Epidemiol Community Health</source><year>2000</year><volume>54</volume><fpage>143</fpage><lpage>148</lpage><pub-id pub-id-type="pmid">10715748</pub-id><pub-id pub-id-type="doi">10.1136/jech.54.2.143</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Taylor</surname><given-names>AW</given-names></name><name><surname>Dal Grande</surname><given-names>E</given-names></name><name><surname>Gill</surname><given-names>TK</given-names></name><name><surname>Chittleborough</surname><given-names>CR</given-names></name><name><surname>Wilson</surname><given-names>DH</given-names></name><name><surname>Adams</surname><given-names>RJ</given-names></name><etal></etal></person-group><article-title>How valid are self-reported height and weight? A comparison between CATI self-report and clinic measurements using a large cohort study</article-title><source>Aust N Z J Public Health</source><year>2006</year><volume>30</volume><fpage>238</fpage><lpage>246</lpage><pub-id pub-id-type="pmid">16800200</pub-id><pub-id pub-id-type="doi">10.1111/j.1467-842X.2006.tb00864.x</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ziebland</surname><given-names>S</given-names></name><name><surname>Thorogood</surname><given-names>M</given-names></name><name><surname>Fuller</surname><given-names>A</given-names></name><name><surname>Muir</surname><given-names>J</given-names></name></person-group><article-title>Desire for the body normal: body image and discrepancies between self reported and measured height and weight in a British population</article-title><source>J Epidemiol Community Health</source><year>1996</year><volume>50</volume><fpage>105</fpage><lpage>106</lpage><pub-id pub-id-type="pmid">8762365</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Katzmarzyk</surname><given-names>PT</given-names></name><name><surname>Perusse</surname><given-names>L</given-names></name><name><surname>Rao</surname><given-names>DC</given-names></name><name><surname>Bouchard</surname><given-names>C</given-names></name></person-group><article-title>Familial risk of obesity and central adipose tissue distribution in the general Canadian population</article-title><source>Am J Epidemiol</source><year>1999</year><volume>149</volume><fpage>933</fpage><lpage>942</lpage><pub-id pub-id-type="pmid">10342802</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Katzmarzyk</surname><given-names>PT</given-names></name><name><surname>Perusse</surname><given-names>L</given-names></name><name><surname>Rao</surname><given-names>DC</given-names></name><name><surname>Bouchard</surname><given-names>C</given-names></name></person-group><article-title>Familial risk of overweight and obesity in the Canadian population using the WHO/NIH criteria</article-title><source>Obes Res</source><year>2000</year><volume>8</volume><fpage>194</fpage><lpage>197</lpage><pub-id pub-id-type="pmid">10757206</pub-id><pub-id pub-id-type="doi">10.1038/oby.2000.21</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lake</surname><given-names>JK</given-names></name><name><surname>Power</surname><given-names>C</given-names></name><name><surname>Cole</surname><given-names>TJ</given-names></name></person-group><article-title>Child to adult body mass index in the 1958 British birth cohort: associations with parental obesity</article-title><source>Arch Dis Child</source><year>1997</year><volume>77</volume><fpage>376</fpage><lpage>381</lpage><pub-id pub-id-type="pmid">9487953</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sande</surname><given-names>MA van der</given-names></name><name><surname>Walraven</surname><given-names>GE</given-names></name><name><surname>Milligan</surname><given-names>PJ</given-names></name><name><surname>Banya</surname><given-names>WA</given-names></name><name><surname>Ceesay</surname><given-names>SM</given-names></name><name><surname>Nyan</surname><given-names>OA</given-names></name><etal></etal></person-group><article-title>Family history: an opportunity for early interventions and improved control of hypertension, obesity and diabetes</article-title><source>Bull World Health Organ</source><year>2001</year><volume>79</volume><fpage>321</fpage><lpage>328</lpage><pub-id pub-id-type="pmid">11357211</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Whitaker</surname><given-names>RC</given-names></name><name><surname>Wright</surname><given-names>JA</given-names></name><name><surname>Pepe</surname><given-names>MS</given-names></name><name><surname>Seidel</surname><given-names>KD</given-names></name><name><surname>Dietz</surname><given-names>WH</given-names></name></person-group><article-title>Predicting obesity in young adulthood from childhood and parental obesity</article-title><source>N Engl J Med</source><year>1997</year><volume>337</volume><fpage>869</fpage><lpage>873</lpage><pub-id pub-id-type="pmid">9302300</pub-id><pub-id pub-id-type="doi">10.1056/NEJM199709253371301</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oliveira</surname><given-names>AM</given-names></name><name><surname>Oliveira</surname><given-names>AC</given-names></name><name><surname>Almeida</surname><given-names>MS</given-names></name><name><surname>Oliveira</surname><given-names>N</given-names></name><name><surname>Adan</surname><given-names>L</given-names></name></person-group><article-title>Influence of the family nucleus on obesity in children from northeastern Brazil: a cross-section study</article-title><source>BMC Public Health</source><year>2007</year><volume>7</volume><fpage>235</fpage><pub-id pub-id-type="pmid">17822567</pub-id><pub-id pub-id-type="doi">10.1186/1471-2458-7-235</pub-id></citation></ref></ref-list></back></article>