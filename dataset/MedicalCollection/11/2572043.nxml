"pmid">15128351</pub-id><pub-id pub-id-type="doi">10.1111/j.1572-0241.2004.04152.x</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schefer</surname><given-names>H</given-names></name><name><surname>Mattmann</surname><given-names>S</given-names></name><name><surname>Joss</surname><given-names>RA</given-names></name></person-group><article-title>Hereditary persistence of alpha- fetoprotein. Case report and review of the literature</article-title><source>Ann Oncol</source><year>1999</year><volume>9</volume><fpage>667</fpage><lpage>672</lpage><pub-id pub-id-type="pmid">9681083</pub-id><pub-id pub-id-type="doi">10.1023/A:1008243311122</pub-id></citation></ref></ref-list></back></article>