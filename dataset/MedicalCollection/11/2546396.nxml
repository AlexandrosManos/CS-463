tion-type="journal"><person-group person-group-type="author"><name><surname>Ragauskas</surname><given-names>AJ</given-names></name><name><surname>Williams</surname><given-names>CK</given-names></name><name><surname>Davison</surname><given-names>BH</given-names></name><name><surname>Britovsek</surname><given-names>G</given-names></name><name><surname>Cairney</surname><given-names>J</given-names></name><name><surname>Eckert</surname><given-names>CA</given-names></name><name><surname>Frederick</surname><given-names>WJ</given-names><suffix>Jr</suffix></name><name><surname>Hallet</surname><given-names>JP</given-names></name><name><surname>Leak</surname><given-names>DJ</given-names></name><name><surname>Liotta</surname><given-names>CL</given-names></name><name><surname>Mielenz</surname><given-names>JR</given-names></name><name><surname>Murphy</surname><given-names>R</given-names></name><name><surname>Templer</surname><given-names>R</given-names></name><name><surname>Tschaplinski</surname><given-names>T</given-names></name></person-group><article-title>The path forward for biofuels and biomaterials</article-title><source>Science</source><year>2006</year><volume>311</volume><fpage>484</fpage><lpage>489</lpage><pub-id pub-id-type="pmid">16439654</pub-id><pub-id pub-id-type="doi">10.1126/science.1114736</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wright</surname><given-names>M</given-names></name><name><surname>Brown</surname><given-names>RC</given-names></name></person-group><article-title>Establishing the optimal sizes of different kinds of biorefineries</article-title><source>Biofuels Bioprod Bioref</source><year>2007</year><volume>1</volume><fpage>191</fpage><lpage>200</lpage><pub-id pub-id-type="doi">10.1002/bbb.25</pub-id></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wooley</surname><given-names>R</given-names></nam