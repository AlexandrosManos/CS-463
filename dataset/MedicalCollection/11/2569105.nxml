talic> = 0.661)</td><td align="left" rowspan="1" colspan="1">&#x02212;0.241 (<italic>p</italic> = 0.003)</td></tr><tr><td align="left" rowspan="1" colspan="1">MeHg</td><td align="center" rowspan="1" colspan="1">&#x02212;0.001 (<italic>p</italic> = 0.98)</td><td align="left" rowspan="1" colspan="1">&#x02212;0.078 (<italic>p</italic> = 0.367)</td><td align="left" rowspan="1" colspan="1">&#x02212;0.001 (<italic>p</italic> = 0.989)</td><td align="left" rowspan="1" colspan="1">&#x02212;0.164 (<italic>p</italic> = 0.073)</td></tr><tr><td align="left" rowspan="1" colspan="1">MeHg + PCB controlled</td><td align="center" rowspan="1" colspan="1">&#x02212;0.031 (<italic>p</italic> = 0.70)</td><td align="left" rowspan="1" colspan="1">&#x02212;0.059 (<italic>p</italic> = 0.472)</td><td align="left" rowspan="1" colspan="1">&#x02212;0.001 (<italic>p</italic> = 0.983)</td><td align="left" rowspan="1" colspan="1">&#x02212;0.170 (<italic>p</italic> = 0.050)</td></tr></tbody></table><table-wrap-foot><fn id="tfn11-ehp-116-1416"><p>Although 156 subjects had placental PCBs available, 145 had both placental PCBs and MeHg available. We based the combined PCB + MeHg analyses on this latter sample.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>