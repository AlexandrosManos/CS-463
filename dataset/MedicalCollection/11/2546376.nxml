/citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zangari</surname><given-names>M</given-names></name><etal></etal></person-group><article-title>Increased risk of deep-vein thrombosis in patients with multiple myeloma receiving thalidomide and chemotherapy</article-title><source>Blood</source><year>2001</year><volume>98</volume><fpage>1614</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">11520815</pub-id><pub-id pub-id-type="doi">10.1182/blood.V98.5.1614</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Urbauer</surname><given-names>E</given-names></name><etal></etal></person-group><article-title>Thromboembolic events during treatment with thalidomide</article-title><source>Blood</source><volume>99</volume><fpage>4247</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">12043695</pub-id><pub-id pub-id-type="doi">10.1182/blood-2001-12-0245</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kumar</surname><given-names>S</given-names></name><name><surname>Witzig</surname><given-names>TE</given-names></name><name><surname>Rajkumar</surname><given-names>SV</given-names></name></person-group><article-title>Thalidomid: current role in the treatment of non-plasma cell malignancies</article-title><source>J Clin Oncol</source><year>2004</year><volume>22</volume><fpage>2477</fpage><lpage>88</lpage><pub-id pub-id-type="pmid">15197211</pub-id><pub-id pub-id-type="doi">10.1200/JCO.2004.10.127</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buttin</surname><given-names>BM</given-names></name><name><surname>Moore</surname><given-names>MJ</given-names></name></person-group><article-title>Thalidomide-induced reversible interstitial pneumonitis in a patient with recurrent ovarian cancer</article-title><source>Gynecol Oncol</source><year>2008</year><pub-id pub-id-type="pmid">18191185</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Onozawa</surname><given-names>M</given-names></name><etal></etal></person-group><article-title>Side effects and good effects from new chemotherapeutic agents. Case 2. Thalidomide-induced interstitial pneumonitis</article-title><source>J Clin Oncol</source><year>2005</year><volume>23</volume><fpage>2425</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">15800335</pub-id><pub-id pub-id-type="doi">10.1200/JCO.2005.04.054</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Behrens</surname><given-names>RJ</given-names></name><name><surname>Gulley</surname><given-names>JL</given-names></name><name><surname>Dahut</surname><given-names>WL</given-names></name></person-group><article-title>Pulmonary toxicity during prostate cancer treatment with docetaxel and thalidomide</article-title><source>Am J Ther</source><year>2003</year><volume>10</volume><fpage>228</fpage><lpage>32</lpage><pub-id pub-id-type="pmid">12756431</pub-id><pub-id pub-id-type="doi">10.1097/00045391-200305000-00011</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Iguchi</surname><given-names>T</given-names></name><etal></etal></person-group><article-title>[Interstitial pneumonia during treatment with thalidomide in a patient with multiple myeloma]</article-title><source>Rinsho Ketsueki</source><year>2004</year><volume>45</volume><fpage>1064</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">15510838</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carrion Valero</surname><given-names>F</given-names></name><name><surname>Bertomeu Gonzalez</surname><given-names>V</given-names></name></person-group><article-title>Lung toxicity due to thalidomide</article-title><source>Arch Bronconeumol</source><year>2002</year><volume>38</volume><fpage>492</fpage><lpage>494</lpage><pub-id pub-id-type="pmid">12372201</pub-id></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Baum</surname><given-names>GL</given-names></name><name><surname>Crapo</surname><given-names>JD</given-names></name></person-group><source>Baum's textbook of pulmonary diseases</source><year>2004</year><volume>xxii</volume><edition>7</edition><publisher-name>Philadelphia: Lippincott Williams &#x00026; Wilkins</publisher-name><fpage>1479</fpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thornburg</surname><given-names>A</given-names></name><etal></etal></person-group><article-title>Hypersensitivity pneumonitis-like syndrome associated with the use of lenalidomide</article-title><source>Chest</source><year>2007</year><volume>131</volume><fpage>1572</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">17494808</pub-id><pub-id pub-id-type="doi">10.1378/chest.06-1734</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Feaver</surname><given-names>AA</given-names></name><etal></etal></person-group><article-title>Thalidomide-induced organizing pneumonia</article-title><source>South Med J</source><year>2006</year><volume>99</volume><fpage>1292</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">17195429</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Younis</surname><given-names>TH</given-names></name><etal></etal></person-group><article-title>Reversible pulmonary hypertension and thalidomide therapy for multiple myeloma</article-title><source>Br J Haematol</source><year>2003</year><volume>121</volume><fpage>191</fpage><lpage>2</lpage><pub-id pub-id-type="pmid">12670354</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2141.2003.04245_2.x</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hattori</surname><given-names>Y</given-names></name><etal></etal></person-group><article-title>Pulmonary hypertension and thalidomide therapy in multiple myeloma</article-title><source>Br J Haematol</source><year>2005</year><volume>128</volume><fpage>885</fpage><lpage>7</lpage><comment>author reply 887&#x02013;8.</comment><pub-id pub-id-type="pmid">15755296</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2141.2005.05389.x</pub-id></citation></ref></ref-list></back></article>