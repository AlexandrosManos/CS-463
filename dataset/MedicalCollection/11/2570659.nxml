id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chang</surname><given-names>J</given-names></name><name><surname>Berg</surname><given-names>CJ</given-names></name><name><surname>Saltzman</surname><given-names>LE</given-names></name><name><surname>Herndon</surname><given-names>J</given-names></name></person-group><article-title>Homicide: a leading cause of injury deaths among pregnant and postpartum women in the United States, 1991&#x02013;1999</article-title><source>Am J Public Health</source><year>2005</year><volume>95</volume><fpage>471</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15727979</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rosen</surname><given-names>D</given-names></name><name><surname>Seng</surname><given-names>JS</given-names></name><name><surname>Tolman</surname><given-names>RM</given-names></name><name><surname>Mallinger</surname><given-names>G</given-names></name></person-group><article-title>Intimate partner violence, depression, and posttraumatic stress disorder as additional predictors of low birth weight infants among low-income mothers</article-title><source>J Interpers Violence</source><year>2007</year><volume>22</volume><fpage>1305</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">17766728</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fox</surname><given-names>AM</given-names></name><name><surname>Jackson</surname><given-names>SS</given-names></name><name><surname>Hansen</surname><given-names>NB</given-names></name><name><surname>Gasa</surname><given-names>N</given-names></name><name><surname>Crewe</surname><given-names>M</given-names></name><name><surname>Sikkema</surname><given-names>KJ</given-names></name></person-group><article-title>In their own voices: a qualitative study of women's risk for intimate partner violen