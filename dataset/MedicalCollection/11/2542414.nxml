ion></ref><ref id="ppat.1000169-Probert1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Probert</surname><given-names>WS</given-names></name><name><surname>Johnson</surname><given-names>BJ</given-names></name></person-group><year>1998</year><article-title>Identification of a 47 kDa fibronectin-binding protein expressed by <italic>Borrelia burgdorferi</italic> isolate B31.</article-title><source>Mol Microbiol</source><volume>30</volume><fpage>1003</fpage><lpage>1015</lpage><pub-id pub-id-type="pmid">9988477</pub-id></citation></ref><ref id="ppat.1000169-Coburn3"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coburn</surname><given-names>J</given-names></name><name><surname>Chege</surname><given-names>W</given-names></name><name><surname>Magoun</surname><given-names>L</given-names></name><name><surname>Bodary</surname><given-names>SC</given-names></name><name><surname>Leong</surname><given-names>JM</given-names></name></person-group><year>1999</year><article-title>Characterization of a candidate <italic>Borrelia burgdorferi</italic> &#x003b2;<sub>3</sub>-chain integrin ligand identified using a phage display library.</article-title><source>Mol Microbiol</source><volume>34</volume><fpage>926</fpage><lpage>940</lpage><pub-id pub-id-type="pmid">10594819</pub-id></citation></ref><ref id="ppat.1000169-Behera1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Behera</surname><given-names>AK</given-names></name><name><surname>Hildebrand</surname><given-names>E</given-names></name><name><surname>Uematsu</surname><given-names>S</given-names></name><name><surname>Akira</surname><given-names>S</given-names></name><name><surname>Coburn</surname><given-names>J</given-names></name><etal/></person-group><year>2006</year><article-title>Identification of a TLR-independent pathway for <italic>Borrelia burgdorf