<tr><td align="left" rowspan="1" colspan="1"><italic>&#x003b1;</italic></td><td align="left" rowspan="1" colspan="1">Angular parameter of <italic>S</italic><italic>p</italic></td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>&#x003b2;</italic></td><td align="left" rowspan="1" colspan="1">CB projection angle</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>&#x003b3;</italic><sub><italic>m</italic></sub></td><td align="left" rowspan="1" colspan="1">Full fan angle</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>&#x003c1;</italic></td><td align="left" rowspan="1" colspan="1">Displacement parameter of <italic>S</italic><italic>p</italic></td></tr></tbody></table></table-wrap><table-wrap id="tab2" position="float"><label>Table 2</label><caption><p>Simulationparameters.</p></caption><table frame="hsides" rules="groups"><tbody><tr><td align="left" rowspan="1" colspan="1">Source to detector distance (<italic>D</italic> + <italic>D</italic><sub><italic>o</italic><italic>d</italic></sub>)</td><td align="center" rowspan="1" colspan="1">700 mm</td></tr><tr><td align="left" rowspan="1" colspan="1">Source to axis distance (<italic>D</italic>)</td><td align="center" rowspan="1" colspan="1">350 mm</td></tr><tr><td align="left" rowspan="1" colspan="1">Detector size</td><td align="center" rowspan="1" colspan="1">512 &#x000d7; 512</td></tr><tr><td align="left" rowspan="1" colspan="1">Detector element pitch</td><td align="center" rowspan="1" colspan="1">0.781 mm</td></tr><tr><td align="left" rowspan="1" colspan="1">Full cone angle in the <italic>z</italic> direction</td><td align="center" rowspan="1" colspan="1">32<italic>deg</italic></td></tr><tr><td align="left" rowspan="1" colspan="1">Full fan angle in the <italic>x</italic>-<italic>y</italic> plane</td><td align="center" rowspan="1" colspan="1">32<italic>deg</italic></td></tr><tr><td align="left" rowspan="1" colspan="1">Projection number of a full scan</td><td align="center" rowspan="1" colspan="1">800</td></tr><tr><td align="left" rowspan="1" colspan="1">Reconstructed volume</td><td align="center" rowspan="1" colspan="1">256 &#x000d7; 256 &#x000d7; 256</td></tr><tr><td align="left" rowspan="1" colspan="1">Reconstructed voxel size</td><td align="center" rowspan="1" colspan="1">0.781 mm</td></tr></tbody></table></table-wrap></floats-wrap></article>