<name><surname>Wand</surname><given-names>M</given-names></name></person-group><year>2003</year><article-title>Geoadditive models</article-title><source>Appl Stat</source><volume>52</volume><fpage>1</fpage><lpage>18</lpage></citation></ref><ref id="b17-ehp-116-1333"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kan</surname><given-names>H</given-names></name><name><surname>Heiss</surname><given-names>G</given-names></name><name><surname>Rose</surname><given-names>KM</given-names></name><name><surname>Whitsel</surname><given-names>E</given-names></name><name><surname>Lurmann</surname><given-names>F</given-names></name><name><surname>London</surname><given-names>SJ</given-names></name></person-group><year>2007</year><article-title>Traffic exposure and lung function in adults: the Atherosclerosis Risk in Communities study</article-title><source>Thorax</source><volume>62</volume><issue>10</issue><fpage>873</fpage><lpage>879</lpage><pub-id pub-id-type="pmid">17442705</pub-id></citation></ref><ref id="b18-ehp-116-1333"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Karita</surname><given-names>K</given-names></name><name><surname>Yano</surname><given-names>E</given-names></name><name><surname>Jinsart</surname><given-names>W</given-names></name><name><surname>Boudoung</surname><given-names>D</given-names></name><name><surname>Tamura</surname><given-names>K</given-names></name></person-group><year>2001</year><article-title>Respiratory symptoms and pulmonary function among traffic police in Bangkok, Thailand</article-title><source>Arch Environ Health</source><volume>56</volume><issue>5</issue><fpage>467</fpage><lpage>470</lpage><pub-id pub-id-type="pmid">11777030</pub-id></citation></ref><ref id="b19-ehp-116-1333"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Katsouyanni</surname><given-names>K</given-names></name><name><surname>Touloumi</surname