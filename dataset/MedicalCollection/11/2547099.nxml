 citation-type="journal"><person-group person-group-type="author"><name><surname>Mendez</surname><given-names>OE</given-names></name><name><surname>Shang</surname><given-names>J</given-names></name><name><surname>Jungreis</surname><given-names>CA</given-names></name><name><surname>Kaufer</surname><given-names>DI</given-names></name></person-group><article-title>Diffusion weighted MRI in CJD is a better diagnostic marker than CSF protein 14-3-3</article-title><source>J Neuroimaging</source><year>2003</year><volume>13</volume><fpage>147</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">12722497</pub-id><pub-id pub-id-type="doi">10.1177/1051228403251085</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Young</surname><given-names>GS</given-names></name><name><surname>Geschwind</surname><given-names>DM</given-names></name><name><surname>Fischbein</surname><given-names>JN</given-names></name><name><surname>Martindale</surname><given-names>LJ</given-names></name><name><surname>Henry</surname><given-names>GR</given-names></name><name><surname>Liu</surname><given-names>S</given-names></name><etal></etal></person-group><article-title>Diffusion weighted and fluid attenuated inversion recovery imaging in Creutzfeldt-Jakob disease: High sensitivity and specificity for diagnosis</article-title><source>Am J Neuroradiol</source><year>2005</year><volume>26</volume><fpage>1551</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">15956529</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Praveen</surname><given-names>KS</given-names></name><name><surname>Sinha</surname><given-names>S</given-names></name><name><surname>Chandrasekhar</surname><given-names>HS</given-names></name><name><surname>Vijayan</surname><given-names>J</given-names></name><name><surname>Taly</surname><given-names>AB</given-names></name></person-group><article-title>Sporadic onset Creutzfeldt-Jacob disease: Interesting MRI observations</article-title><source>Neurol India</source><year>2006</year><volume>54</volume><fpage>418</fpage><lpage>420</lpage><pub-id pub-id-type="pmid">17114856</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><collab>World Health Organisation</collab></person-group><article-title>Consensus on criteria for diagnosis of sporadic CJD</article-title><source>Weekly Epidemiol Rec</source><year>1998</year><volume>73</volume><fpage>361</fpage><lpage>5</lpage></citation></ref></ref-list></back></article>