olume>64</volume><fpage>389</fpage><lpage>400</lpage><pub-id pub-id-type="doi">10.1016/S0011-393X(03)00112-7</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parmarksiz</surname><given-names>S</given-names></name><name><surname>Yuksel</surname><given-names>N</given-names></name><name><surname>Karabas</surname><given-names>VL</given-names></name><name><surname>Ozkan</surname><given-names>B</given-names></name><name><surname>Demirci</surname><given-names>G</given-names></name><name><surname>Caglar</surname><given-names>Y</given-names></name></person-group><article-title>A comparison of travoprost, la-tanoprost and the fixed combination of dorzolamide and timolol in patients with pseudoexfoliation glaucoma</article-title><source>Eur J Ophthalmol</source><year>2006</year><volume>16</volume><fpage>73</fpage><lpage>80</lpage><pub-id pub-id-type="pmid">16496249</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stefan</surname><given-names>C</given-names></name><name><surname>Nenciu</surname><given-names>A</given-names></name><name><surname>Malcea</surname><given-names>C</given-names></name><name><surname>Tebeanu</surname><given-names>E</given-names></name></person-group><article-title>Axial length of the ocular globe and hypotensive effect in glaucoma therapy with prostaglandin analogs</article-title><source>Oftalmologia</source><year>2005</year><volume>49</volume><fpage>47</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">16524126</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lawrence</surname><given-names>J</given-names></name><name><surname>Reid</surname><given-names>J</given-names></name><name><surname>Taylor</surname><given-names>G</given-names></name><name><surname>Stirling</surname><given-names>C</given-names></name><name><surn