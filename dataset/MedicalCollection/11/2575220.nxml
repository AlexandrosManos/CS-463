><year>2006</year><volume>34</volume><fpage>D82</fpage><lpage>D85</lpage><pub-id pub-id-type="pmid">16381980</pub-id></citation></ref><ref id="B32"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Boser</surname><given-names>BE</given-names></name><name><surname>Guyon</surname><given-names>IM</given-names></name><name><surname>Vapnik</surname><given-names>VN</given-names></name></person-group><article-title>A training algorithm for optimal margin classifiers</article-title><source>Proceedings of the 5th Annual ACM Workshop on Computational Learning Theory</source><year>1992</year><publisher-name>ACM Press</publisher-name><fpage>144</fpage><lpage>152</lpage></citation></ref><ref id="B33"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Chih-Wei</surname><given-names>H</given-names></name><name><surname>Chih-Chung</surname><given-names>C</given-names></name><name><surname>Chih-Jen</surname><given-names>L</given-names></name></person-group><source>A Practical Guide to Support Vector Classification</source><year>2004</year><publisher-name>National Taiwan University</publisher-name></citation></ref><ref id="B34"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bradley</surname><given-names>E</given-names></name><name><surname>Gail</surname><given-names>G</given-names></name></person-group><article-title>A Leisurely Look at the Bootstrap, the Jackknife, and Cross-Validation</article-title><source>The American Statistician</source><year>1983</year><volume>37</volume><fpage>36</fpage><lpage>48</lpage></citation></ref></ref-list></back></article>