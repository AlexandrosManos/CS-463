p-type="author"><name><surname>Letterie</surname><given-names>GS</given-names></name></person-group><article-title>Medical education as a science: The quality of evidence for computer-assisted instruction</article-title><source>Am J Obstet Gynecol</source><year>2003</year><volume>188</volume><fpage>849</fpage><lpage>853</lpage><pub-id pub-id-type="pmid">12634669</pub-id><pub-id pub-id-type="doi">10.1067/mob.2003.168</pub-id></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Russell</surname><given-names>TL</given-names></name></person-group><source>The no Significant Difference Phenomenon</source><year>1999</year><publisher-name>Carolina: Office of Instructional Telecommunications, North Carolina State Univeristy</publisher-name></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cohen</surname><given-names>PA</given-names></name><name><surname>Dacanay</surname><given-names>LS</given-names></name></person-group><article-title>A meta-analysis of computer-based instruction in nursing education</article-title><source>Comput Nurs</source><year>1994</year><volume>12</volume><fpage>89</fpage><lpage>97</lpage><pub-id pub-id-type="pmid">8199929</pub-id></citation></ref><ref id="B13"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Kanten-McCoy</surname><given-names>RA</given-names></name><name><surname>Flanagan</surname><given-names>JR</given-names></name></person-group><article-title>Web-based tutorial training for a regional network of clinical providers</article-title><source>Nashville: Proc AMIA Symp</source><year>1997</year><fpage>348</fpage><lpage>353</lpage></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Moore</surname><given-names>MG</given-names></name><name><surname>Kearsley</surname><given-names>G</given-names></name></person-group><source>Distance Education: A Systems View</source><year>1996</year><publisher-name>Belmont, CA: Wadsworth</publisher-name></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Phipps</surname><given-names>R</given-names></name><name><surname>Merisotis</surname><given-names>J</given-names></name></person-group><source>What's the Difference? A Review of Contemporary Research on the Effectiveness of Distance Learning in Higher Education</source><year>1999</year><publisher-name>Washinton DC: The Institute for Higher Education Policy</publisher-name></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Friedman</surname><given-names>CP</given-names></name></person-group><article-title>The research we should be doing</article-title><source>Acad Med</source><year>1994</year><volume>69</volume><fpage>455</fpage><lpage>457</lpage><pub-id pub-id-type="pmid">8003158</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lewis</surname><given-names>MJ</given-names></name><name><surname>Davies</surname><given-names>R</given-names></name><name><surname>Jenkins</surname><given-names>D</given-names></name><name><surname>Tait</surname><given-names>MI</given-names></name></person-group><article-title>A review of evaluative studies of computer-based learning in nursing education</article-title><source>Nurse Educ Today</source><year>2001</year><volume>21</volume><fpage>26</fpage><lpage>37</lpage><pub-id pub-id-type="pmid">11162255</pub-id><pub-id pub-id-type="doi">10.1054/nedt.2000.0494</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Debourgh</surname><given-names>GA</given-names></name></person-group><article-title>Predictors of student satisfaction in distance-delivered graduate nursing courses: What matters most?</article-title><source>J Prof Nurs</source><year>2003</year><volume>19</volume><fpage>149</fpage><lpage>163</lpage><pub-id pub-id-type="pmid">12836145</pub-id><pub-id pub-id-type="doi">10.1016/S8755-7223(03)00072-3</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cook</surname><given-names>DA</given-names></name></person-group><article-title>Learning and cognitive styles in web-based learning: theory, evidence, and application</article-title><source>Acad Med</source><year>2005</year><volume>80</volume><fpage>266</fpage><lpage>78</lpage><pub-id pub-id-type="pmid">15734809</pub-id><pub-id pub-id-type="doi">10.1097/00001888-200503000-00012</pub-id></citation></ref><ref id="B20"><citation citation-type="other"><article-title>Health Insurance Portability and Accountability Act of 1996</article-title><source>18 USC &#x000a7;264 (West 1994)</source></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gostin</surname><given-names>LO</given-names></name></person-group><article-title>National health information privacy: Regulations under the health insurance portability and accountability act</article-title><source>JAMA</source><year>2001</year><volume>285</volume><fpage>3015</fpage><lpage>3021</lpage><pub-id pub-id-type="pmid">11410101</pub-id><pub-id pub-id-type="doi">10.1001/jama.285.23.3015</pub-id></citation></ref><ref id="B22"><citation citation-type="other"><person-group person-group-type="author"><collab>Department of Health and Human Services</collab></person-group><article-title>Standards for Privacy of Individually Identifiable Health Information: Final Rule</article-title><source>45 CFR &#x000a7;160&#x02013;164</source></citation></ref><ref id="B23"><citation citation-type="other"><article-title>64 Federal Register.12 434 (February 26, 2001)</article-title></citation></ref><ref id="B24"><citation