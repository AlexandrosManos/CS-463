id="B8"><label>8</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Neidle</surname><given-names>S</given-names></name></person-group><source>Nucleic Acid Structure and Recognition.</source><year>2002</year><publisher-loc>Oxford University Press</publisher-loc><publisher-name>Oxford</publisher-name></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Haq</surname><given-names>I</given-names></name></person-group><article-title>Thermodynamics of drug-DNA interactions</article-title><source>Arch. Biochem. Biophys.</source><year>2002</year><volume>403</volume><fpage>1</fpage><lpage>15</lpage><pub-id pub-id-type="pmid">12061796</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Vargiu</surname><given-names>AV</given-names></name><name><surname>Ruggerone</surname><given-names>P</given-names></name><name><surname>Magistrato</surname><given-names>A</given-names></name><name><surname>Carloni</surname><given-names>P</given-names></name></person-group><article-title>Anthramycin-DNA binding explored by molecular simulations</article-title><source>J. Phys. Chem. B</source><year>2006</year><volume>110</volume><fpage>24687</fpage><lpage>24695</lpage><pub-id pub-id-type="pmid">17134232</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Spiegel</surname><given-names>K</given-names></name><name><surname>Rothlisberger</surname><given-names>U</given-names></name><name><surname>Carloni</surname><given-names>P</given-names></name></person-group><article-title>Duocarmycins binding to DNA investigated by molecular simulation</article-title><source>J. Phys. Chem. B</source><year>2006</year><volume>110</volume><fp