pan="1" colspan="1">&#x02003;High</td><td rowspan="1" colspan="1">1.00</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">1.00</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">&#x02003;Low</td><td rowspan="1" colspan="1">1.87</td><td rowspan="1" colspan="1">1.12&#x02013;3.14</td><td rowspan="1" colspan="1">0.017</td><td rowspan="1" colspan="1">1.79</td><td rowspan="1" colspan="1">1.04&#x02013;3.08</td><td rowspan="1" colspan="1">0.037</td></tr></tbody></table><table-wrap-foot><fn><p>HR, hazard ratio; CI, confidence interval. <sup>a</sup>Excluding one patient who died of post-operative complication. <sup>b</sup>Cox proportional-hazards regression model. <sup>c</sup>Including wedge resection. <sup>d</sup>Median longest diameter of primary tumor. <sup>e</sup>Post-operative pathologic staging.</p></fn></table-wrap-foot></table-wrap><table-wrap id="HYN089TB5" position="float"><label>Table&#x000a0;5.</label><caption><p>Multivariate analysis of disease-free survival and overall survival in Stages II and III (<italic>n</italic> = 103)<sup>a</sup></p></caption><table frame="hsides" rules="groups"><colgroup span="1"><col align="left" span="1"/><col align="char" char="." span="1"/><col align="char" char="." span="1"/><col align="char" char="." span="1"/><col align="char" char="." span="1"/><col align="char" char="." span="1"/><col align="char" char="." span="1"/></colgroup><thead><tr><th align="left" rowspan="1" colspan="1">Prognostic factors</th><th align="left" colspan="3" rowspan="1">Disease-free survival<hr/></th><th align="left" colspan="3" rowspan="1">Overall survival<hr/></th></tr><tr><th align="left" rowspan="1" colspan="1">HR</th><th align="left" rowspan="1" colspan="1">95% CI</th><th align="left" rowspan="1" colspan="1"><italic>P</italic> value<sup>b</sup></th><th align="left" rowspan="1" colspan="1">HR</th><th align="left" rowspan="1" colspan="1">95% CI</th><th align="left" rows