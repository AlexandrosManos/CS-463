ame></person-group><source>Multivariate Kalibration &#x02013; Ein praktischer Leitfaden zur Methodenentwicklung in der quantitativen Analytik Ettlingen</source><year>2005</year><edition>4</edition></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schenk</surname><given-names>T</given-names></name><name><surname>Schuphan</surname><given-names>I</given-names></name><name><surname>Schmidt</surname><given-names>B</given-names></name></person-group><article-title>High-performance Liquid Chromatographic determination of the rhamnolipids produced by <italic>Pseudomonas aeruginosa</italic></article-title><source>J Chromatogr A</source><year>1995</year><volume>693</volume><fpage>7</fpage><lpage>13</lpage><pub-id pub-id-type="pmid">7697163</pub-id><pub-id pub-id-type="doi">10.1016/0021-9673(94)01127-Z</pub-id></citation></ref></ref-list></back></article>