or"><name><surname>De Jong</surname><given-names>BHJ</given-names></name><name><surname>Cairns</surname><given-names>MA</given-names></name><name><surname>Haggerty</surname><given-names>PK</given-names></name><name><surname>Ramirez-Marcial</surname><given-names>N</given-names></name><name><surname>Ochoa-Gaona</surname><given-names>S</given-names></name><name><surname>Mendoza-Vega</surname><given-names>J</given-names></name><name><surname>Gonzalez-Espinosa</surname><given-names>M</given-names></name><name><surname>March-Mifsut</surname><given-names>I</given-names></name></person-group><article-title>Land-use change carbon flux between 1970's and 1990's in central highlands of Chiapas, Mexico</article-title><source>Environmental Management</source><year>1999</year><volume>23</volume><fpage>373</fpage><lpage>385</lpage><pub-id pub-id-type="pmid">9950699</pub-id><pub-id pub-id-type="doi">10.1007/s002679900193</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cairns</surname><given-names>MA</given-names></name><name><surname>Haggerty</surname><given-names>PK</given-names></name><name><surname>Alvarez</surname><given-names>R</given-names></name><name><surname>De Jong</surname><given-names>BHJ</given-names></name><name><surname>Olmsted</surname><given-names>I</given-names></name></person-group><article-title>Tropical Mexico's recent land-use change: a region's contribution to global carbon cycle</article-title><source>Ecological Applications</source><year>2000</year><volume>10</volume><fpage>1426</fpage><lpage>1441</lpage><pub-id pub-id-type="doi">10.1890/1051-0761(2000)010[1426:TMSRLU]2.0.CO;2</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Jong</surname><given-names>BHJ</given-names></name><name><surname>Ochoa-Gaona</surname><given-names>S</given-names></name><name><surname>Castillo-Santiago</surname><given-names>MA</given-names></name><name><surname>Ramirez-Marcial</surname><given-names>N</given-names></name><name><surname>Cairns</surname><given-names>MA</given-names></name></person-group><article-title>Carbon flux and patterns of land-use/land-cover change in the Selva Lacandona, Mexico</article-title><source>Ambio</source><year>2000</year><volume>29</volume><fpage>504</fpage><lpage>511</lpage><pub-id pub-id-type="doi">10.1639/0044-7447(2000)029[0504:CFAPOL]2.0.CO;2</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Post</surname><given-names>WM</given-names></name><name><surname>Kwon</surname><given-names>CK</given-names></name></person-group><article-title>Soil carbon sequestration and land-use change: processes and potential</article-title><source>Global Change Biology</source><year>2000</year><volume>6</volume><fpage>317</fpage><lpage>327</lpage><pub-id pub-id-type="doi">10.1046/j.1365-2486.2000.00308.x</pub-id></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><collab>SARH</collab></person-group><article-title>Secretaria de Agricultura y Recursos Hidraulicos: Rehabilitacion de los distritos de riego Bajo Rio Bravo (25) y del Rio San Juan (26), Tamaulipas. Resumen</article-title><source>Infraestructura, Recursos y Servicios</source><year>1980</year><publisher-name>SARH. Mexico. D.F</publisher-name></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><collab>Proderleon</collab></person-group><article-title>Promotora del Desarrollo Rural de Nuevo Leon: Estadisticas de cambio de uso de suelo 1980&#x02013;1986</article-title><source>Gobierno del Estado de Nuevo Leon</source><year>1990</year><publisher-name>Monterrey, N.L., Mexico</publisher-name><fpage>1980</fpage><lpage>1986</lpage></citation></ref><ref id="B19"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Maldonado</surname><given-names>A</given-names></name></person-group><article-title>Desertificaci&#x000f3;n en la subcuenca del Rio Limon, Linares, N.L. Tesis Profesional de Licenciatura</article-title><source>Facultad de Ciencias Forestales, UANL Linares, NL, Mexico</source><year>1992</year></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Trevi&#x000f1;o</surname><given-names>E</given-names></name><name><surname>Akca</surname><given-names>A</given-names></name><name><surname>N&#x000e1;var</surname><given-names>J</given-names></name><name><surname>Jimenez</surname><given-names>J</given-names></name><name><surname>Aguirre</surname><given-names>O</given-names></name></person-group><article-title>Detection of land use change by satellite imagery in the municipality of Linares, Nuevo Leon, Mexico</article-title><source>Proceedings of the Fifth International Conference on Desert Development</source><volume>I</volume><publisher-name>Texas Tech University</publisher-name><comment>August 12 &#x02013; 17, 1996</comment></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Palacios-Prieto</surname><given-names>E</given-names></name></person-group><article-title>La condici&#x000f3;n actual de los recursos forestales en Mexico. Resultados del Inventario Nacional Forestal 2000</article-title><source>Investigaciones Geograficas</source><year>2000</year><volume>43</volume><fpage>183</fpage><lpage>203</lpage></citation></ref><ref id="B22"><citation citation-type="other"><person-group person-group-type="author"><collab>WWF</collab></person-group><article-title>Ecoregions of the World. Neartic Desert and Shrublands</article-title><source>Tamaulipan Mezquital (NA1312)</source><year>2001</year></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Siegenthaler</surname><given-names>U</given-names></name><name><surname>Sarmiento</surname><given-names>JL</given-names></name></person-group><article-title>Atmospheric carbon dioxide and the ocean</article-title><source>Nature</source><year>1993</year><volume>365</volume><fpage>119</fpage><lpage>125</lpage><pub-id pub-id-type="doi">10.1038/365119a0</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>N&#x000e1;var</surname><given-names>J</given-names></name><name><surname>N&#x000e1;jera</surname><given-names>J</given-names></name><name><surname>Jurado</surname><given-names>E</given-names></name></person-group><article-title>Preliminary estimates of biomass growth in the Tamaulipan thornscrub of northeastern Mexico</article-title><source>Journal of Arid Environments</source><year>2001</year><volume>47</volume><fpage>281</fpage><lpage>290</lpage><pub-id pub-id-type="doi">10.1006/jare.2000.0708</pub-id></citation></ref><ref id="B25"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Heiseke</surname><given-names>D</given-names></name></person-group><article-title>El matorral como recurso forestal. Reporte cient&#x000ed;fico N&#x000fa;mero 1</article-title><source>Facultad de Ciencias Forestales UANL, Linares, N L, M&#x000e9;xico</source><year>1985</year><fpage>31</fpage></citation></ref><ref id="B26"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Carstens</surname><given-names>A</given-names></name></person-group><article-title>Gottinger Beitrage zur Land &#x02013; und Forstwirtschaft in der Tropen Subtropen</article-title><source>Heft 40</source><year>1987</year><publisher-name>University of Gottingen. Gottingen, Germany</publisher-name></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Castellanos</surname><given-names>J</given-names></name><name><surname>Maass</surname><given-na