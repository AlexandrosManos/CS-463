91777</pub-id><pub-id pub-id-type="doi">10.1073/pnas.0705856104</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Palese</surname><given-names>P</given-names></name><name><surname>Tobita</surname><given-names>K</given-names></name><name><surname>Ueda</surname><given-names>M</given-names></name><name><surname>Compans</surname><given-names>RW</given-names></name></person-group><article-title>Characterization of temperature sensitive influenza virus mutants defective in neuraminidase</article-title><source>Virology</source><year>1974</year><volume>61</volume><fpage>397</fpage><lpage>410</lpage><pub-id pub-id-type="pmid">4472498</pub-id><pub-id pub-id-type="doi">10.1016/0042-6822(74)90276-1</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nayak</surname><given-names>DP</given-names></name><name><surname>Reichl</surname><given-names>U</given-names></name></person-group><article-title>Neuraminidase activity assays for monitoring MDCK cell culture derived influenza virus</article-title><source>J Virol Methods</source><year>2004</year><volume>122</volume><fpage>9</fpage><lpage>15</lpage><pub-id pub-id-type="pmid">15488615</pub-id><pub-id pub-id-type="doi">10.1016/j.jviromet.2004.07.005</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tuppy</surname><given-names>H</given-names></name><name><surname>Palese</surname><given-names>P</given-names></name></person-group><article-title>A chromogenic substrate for the investigation of neuraminidases</article-title><source>FEBS Lett</source><year>1969</year><volume>3</volume><fpage>72</fpage><lpage>75</lpage><pub-id pub-id-type="pmid">11946972</pub-id><pub-id pub-id-type="doi">10.1016/0014-5793(69)80100-6</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-gr