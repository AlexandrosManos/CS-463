ame><surname>Fujita</surname><given-names>J</given-names></name><name><surname>Sakiyama</surname><given-names>M</given-names></name><article-title>Chronic diarrhoea with thickening of the colonic wall</article-title><source>Gut</source><year>2007</year><volume>56</volume><issue>1</issue><fpage>94</fpage><lpage>114</lpage><pub-id pub-id-type="doi">10.1136/gut.2006.093096</pub-id><pub-id pub-id-type="pmid">17172587</pub-id></mixed-citation></ref><ref id="B6"><mixed-citation publication-type="journal"><name><surname>McMenamin</surname><given-names>DS</given-names></name><name><surname>Bhuta</surname><given-names>SS</given-names></name><article-title>Mesenteric panniculitis versus pancreatitis: a computed tomography diagnostic dilemma</article-title><source>Australas Radiol</source><year>2005</year><volume>49</volume><issue>1</issue><fpage>84</fpage><lpage>87</lpage><pub-id pub-id-type="doi">10.1111/j.1440-1673.2005.01406.x</pub-id><pub-id pub-id-type="pmid">15727618</pub-id></mixed-citation></ref><ref id="B7"><mixed-citation publication-type="journal"><name><surname>Azzam</surname><given-names>I</given-names></name><name><surname>Croitoru</surname><given-names>S</given-names></name><name><surname>Naschitz</surname><given-names>JE</given-names></name><article-title>Sclerosing mesenteritis: a diagnostic challenge</article-title><source>Isr Med Assoc J</source><year>2004</year><volume>6</volume><issue>9</issue><fpage>567</fpage><lpage>568</lpage><pub-id pub-id-type="pmid">15373322</pub-id></mixed-citation></ref><ref id="B8"><mixed-citation publication-type="journal"><name><surname>Hammoud</surname><given-names>D</given-names></name><name><surname>Khoury</surname><given-names>N</given-names></name><name><surname>Rouhana</surname><given-names>G</given-names></name><name><surname>Abou Sleiman</surname><given-names>C</given-names></name><name><surname>Haddad</surname><given-names>M</given-names></name><article-title>Intraabdominal panniculitis. Report of three cases and review of the literature</article-title><source>J Med Liban</source><year>1999</year><volume>47</volume><issue>5</issue><fpage>321</fpage><lpage>325</lpage><pub-id pub-id-type="pmid">10887539</pub-id></mixed-citation></ref><ref id="B9"><mixed-citation publication-type="journal"><name><surname>Goh</surname><given-names>J</given-names></name><name><surname>Otridge</surname><given-names>B</given-names></name><name><surname>Brady</surname><given-names>H</given-names></name><name><surname>Breatnach</surname><given-names>E</given-names></name><name><surname>Dervan</surname><given-names>P</given-names></name><name><surname>MacMathuna</surname><given-names>P</given-names></name><article-title>Aggressive multiple myeloma presenting as mesenteric panniculitis</article-title><source>Am J Gastroenterol</source><year>2001</year><volume>96</volume><issue>1</issue><fpage>238</fpage><lpage>241</lpage><pub-id pub-id-type="doi">10.1111/j.1572-0241.2001.03384.x</pub-id><pub-id pub-id-type="pmid">11197260</pub-id></mixed-citation></ref><ref id="B10"><mixed-citation publication-type="journal"><name><surname>Grieser</surname><given-names>C</given-names></name><name><surname>Denecke</surname><given-names>T</given-names></name><name><surname>Langrehr</surname><given-names>J</given-names></name><name><surname>Hamm</surname><given-names>B</given-names></name><name><surname>Hanninen</surname><given-names>EL</given-names></name><article-title>Sclerosing Mesenteritis as a Rare Cause of Upper Abdominal Pain and Digestive Disorders</article-title><source>Acta Radiol</source><year>2008</year><volume>23</volume><fpage>1</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">18608010</pub-id></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><name><surname>Pickhardt</surname><given-names>PJ</given-names></name><name><surname>Bhalla</surname><given-names>S</given-names></name><article-title>Unusual nonneoplastic peritoneal and subperitoneal conditions: CT findings</article-title><source>Radiographics</source><year>2005</year><volume>25</volume><issue>3</issue><fpage>719</fpage><lpage>730</lpage><pub-id pub-id-type="doi">10.1148/rg.253045145</pub-id><pub-id pub-id-type="pmid">15888621</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><name><surname>Horton</surname><given-names>KM</given-names></name><name><surname>Lawler</surname><given-names>LP</given-names></name><name><surname>Fishman</surname><given-names>EK</given-names></name><article-title>CT findings in sclerosing mesenteritis (panniculitis): spectrum of disease</article-title><source>Radiographics</source><year>2003</year><volume>23</volume><issue>6</issue><fpage>1561</fpage><lpage>1567</lpage><pub-id pub-id-type="doi">10.1148/rg.1103035010</pub-id><pub-id pub-id-type="pmid">14615565</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Koornstra</surname><given-names>JJ</given-names></name><name><surname>van Olffen</surname><given-names>GH</given-names></name><name><surname>van Noort</surname><given-names>G</given-names></name><article-title>Retractile mesenteritis: to treat or not to treat</article-title><source>Hepatogastroenterology</source><year>1997</year><volume>44</volume><issue>14</issue><fpage>408</fpage><lpage>410</lpage><pub-id pub-id-type="pmid">9164510</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Ginsburg</surname><given-names>PM</given-names></name><name><surname>Ehrenpreis</surname><given-names>ED</given-names></name><article-title>A pilot study of thalidomide for patients with symptomatic mesenteric panniculitis</article-title><source>Aliment Pharmacol Ther</source><year>2002</year><volume>16</volume><issue>12</issue><fpage>2115</fpage><lpage>2122</lpage><pub-id pub-id-type="doi">10.1046/j.1365-2036.2002.01383.x</pub-id><pub-id pub-id-type="pmid">12452945</pub-id></mixed-citation></ref></ref-list></back></article>