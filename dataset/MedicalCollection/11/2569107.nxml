"author"><name><surname>Diette</surname><given-names>GB</given-names></name><name><surname>Hansel</surname><given-names>NN</given-names></name><name><surname>Buckley</surname><given-names>TJ</given-names></name><name><surname>Curtin-Brosnan</surname><given-names>J</given-names></name><name><surname>Eggleston</surname><given-names>PA</given-names></name><name><surname>Matsui</surname><given-names>EC</given-names></name><etal/></person-group><year>2007</year><article-title>Home indoor pollutant exposures among inner-city children with and without asthma</article-title><source>Environ Health Perspect</source><volume>115</volume><fpage>1665</fpage><lpage>1669</lpage><pub-id pub-id-type="pmid">18008001</pub-id></citation></ref><ref id="b10-ehp-116-1428"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Diggle</surname><given-names>PJ</given-names></name><name><surname>Heagerty</surname><given-names>P</given-names></name><name><surname>Liang</surname><given-names>KY</given-names></name><name><surname>Zeger</surname><given-names>S</given-names></name></person-group><year>2002</year><source>The Analysis of Longitudinal Data</source><edition>2</edition><publisher-loc>Oxford, UK</publisher-loc><publisher-name>Oxford University Press</publisher-name></citation></ref><ref id="b11-ehp-116-1428"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Florey</surname><given-names>CV</given-names></name><name><surname>Melia</surname><given-names>RJ</given-names></name><name><surname>Chinn</surname><given-names>S</given-names></name><name><surname>Goldstein</surname><given-names>BD</given-names></name><name><surname>Brooks</surname><given-names>AG</given-names></name><name><surname>John</surname><given-names>HH</given-names></name><etal/></person-group><year>1979</year><article-title>The relation between respiratory illness in primary schoolchildren and the use of gas for cooking. III. Nitrogen dioxide, respiratory illness and lung infection</article-title><source>Int J Epidemiol</source><volume>8</volume><fpage>347</fpage><lpage>353</lpage><pub-id pub-id-type="pmid">541157</pub-id></citation></ref><ref id="b12-ehp-116-1428"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garrett</surname><given-names>MH</given-names></name><name><surname>Hooper</surname><given-names>MA</given-names></name><name><surname>Hooper</surname><given-names>BM</given-names></name><name><surname>Abramson</surname><given-names>MJ</given-names></name></person-group><year>1998</year><article-title>Respiratory symptoms in children and indoor exposure to nitrogen dioxide and gas stoves</article-title><source>Am J Respir Crit Care Med</source><volume>158</volume><fpage>891</fpage><lpage>895</lpage><pub-id pub-id-type="pmid">9731022</pub-id></citation></ref><ref id="b13-ehp-116-1428"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gauderman</surname><given-names>WJ</given-names></name><name><surname>Avol</surname><given-names>E</given-names></name><name><surname>Lurmann</surname><given-names>F</given-names></name><name><surname>Kuenzili</surname><given-names>N</given-names></name><name><surname>Gilliland</surname><given-names>F</given-names></name><name><surname>Peters</surname><given-names>J</given-names></name><etal/></person-group><year>2005</year><article-title>Childhood asthma and exposure to traffic and nitrogen dioxide</article-title><source>Epidemiology</source><volume>16</volume><issue>6</issue><fpage>737</fpage><lpage>743</lpage><pub-id pub-id-type="pmid">16222162</pub-id></citation></ref><ref id="b14-ehp-116-1428"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hansel</surname><given-names>NN</given-names></name><name><surname>Eggleston</surname><given-names>PA</given-names></name><name><surname>Krishnan</surname><given-names>JA</given-names></name><name><surname>Curtin-Brosnan</surname><given-names>J</given-names></name><name><surname>Rand</surname><given-names>CS</given-names></name><name><surname>Patino</surname><given-names>CM</given-names></name><etal/></person-group><year>2006</year><article-title>Asthma-related health status determinants of environmental control practices for inner-city preschool children</article-title><source>Ann Allergy Asthma Immunol</source><volume>97</volume><fpage>409</fpage><lpage>417</lpage><pub-id pub-id-type="pmid">17042150</pub-id></citation></ref><ref id="b15-ehp-116-1428"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hasselblad</surname><given-names>V</given-names></name><name><surname>Eddy</surname><given-names>DM</given-names></name><name><surname>Kotchmar</surname><given-names>DJ</given-names></name></person-group><year>1992</year><article-title>Synthesis of environmental evidence: nitrogen dioxide epidemiology studies</article-title><source>J Air Waste Manage Assoc</source><volume>42</volume><fpage>662</fpage><lpage>671</lpage><pub-id pub-id-type="pmid">1627322</pub-id></citation></ref><ref id="b16-ehp-116-1428"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hoek</surname><given-names>G</given-names></name><name><surname>Brunekreef</surname><given-names>B</given-names></name><name><surname>Meijer</surname><given-names>R</given-names></name><name><surname>Scholten</surname><given-names>A</given-names></name><name><surname>Boleij</surname><given-names>J</given-names></name></person-group><year>1984</year><article-title>Indoor nitrogen dioxide pollution and respiratory symptoms of schoolchildren</article-title><source>Int Arch Occup Environ Health</source><volume>55</volume><fpage>79</fpage><lpage>86</lpage><pub-id pub-id-type="pmid">6526503</pub-id></citation></ref><ref id="b17-ehp-116-1428"><citation citation-type="book"><collab>Institute of Medicine Committee on the Assessment of Asthma and Indoor Air</col