gn="char" rowspan="1" colspan="1">398.8 (377.9 to 419.7)</td><td align="char" rowspan="1" colspan="1">70120</td><td align="char" rowspan="1" colspan="1">1078</td><td align="char" rowspan="1" colspan="1">288.8 (271.5 to 306.1)</td><td align="char" rowspan="1" colspan="1">73068</td><td align="char" rowspan="1" colspan="1">627</td><td align="char" rowspan="1" colspan="1">160.0 (147.5 to 172.6)</td></tr><tr><td align="left" rowspan="1" colspan="1">Republic of Ireland</td><td align="char" rowspan="1" colspan="1">219663</td><td align="char" rowspan="1" colspan="1">4924</td><td align="char" rowspan="1" colspan="1">405.1 (393.8 to 416.4)</td><td align="char" rowspan="1" colspan="1">189829</td><td align="char" rowspan="1" colspan="1">3726</td><td align="char" rowspan="1" colspan="1">303.2 (293.4 to 313.0)</td><td align="char" rowspan="1" colspan="1">146708</td><td align="char" rowspan="1" colspan="1">2187</td><td align="char" rowspan="1" colspan="1">191.9 (183.4 to 200.4)</td></tr><tr><td align="left" rowspan="1" colspan="1">Italy</td><td align="char" rowspan="1" colspan="1">33737</td><td align="char" rowspan="1" colspan="1">283</td><td align="char" rowspan="1" colspan="1">231.3 (202.4 to 260.2)</td><td align="char" rowspan="1" colspan="1">33698</td><td align="char" rowspan="1" colspan="1">276</td><td align="char" rowspan="1" colspan="1">160.0 (140.9 to 179.0)</td><td align="char" rowspan="1" colspan="1">35183</td><td align="char" rowspan="1" colspan="1">226</td><td align="char" rowspan="1" colspan="1">106.2 (92.1 to 120.3)</td></tr><tr><td align="left" rowspan="1" colspan="1">Spain</td><td align="char" rowspan="1" colspan="1">12296</td><td align="char" rowspan="1" colspan="1">74</td><td align="char" rowspan="1" colspan="1">210.0 (159.3 to 260.7)</td><td align="char" rowspan="1" colspan="1">11101</td><td align="char" rowspan="1" colspan="1">73</td><td align="char" rowspan="1" colspan="1">159.7 (121.0 to 198.3)</td><td align="char" rowspan="1" colspan="1">11531</td><td align=