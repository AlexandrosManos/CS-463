e</article-title><source>Lancet</source><year>1999</year><volume>353</volume><fpage>1634</fpage><lpage>1636</lpage><pub-id pub-id-type="pmid">10335777</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(99)00163-4</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Day</surname><given-names>CP</given-names></name></person-group><article-title>Genes or environment to determine alcoholic liver disease and non-alcoholic fatty liver disease</article-title><source>Liver International</source><year>2006</year><volume>26</volume><fpage>1021</fpage><lpage>1028</lpage><pub-id pub-id-type="pmid">17032401</pub-id><pub-id pub-id-type="doi">10.1111/j.1478-3231.2006.01323.x</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chu</surname><given-names>CJ</given-names></name><name><surname>Lu</surname><given-names>RH</given-names></name><name><surname>Wang</surname><given-names>SS</given-names></name><name><surname>Chang</surname><given-names>FY</given-names></name><name><surname>Wu</surname><given-names>SL</given-names></name><name><surname>Lu</surname><given-names>CL</given-names></name><name><surname>Chun</surname><given-names>BC</given-names></name><name><surname>Chang</surname><given-names>CY</given-names></name><name><surname>Wu</surname><given-names>MY</given-names></name><name><surname>Lee</surname><given-names>SD</given-names></name></person-group><article-title>Risk factors associated with non-alcoholic fatty liver disease in Chinese patients and the role of tumor necrosis factor-alpha</article-title><source>Hepatogastroenterology</source><year>2007</year><volume>54</volume><fpage>2099</fpage><lpage>2102</lpage><pub-id pub-id-type="pmid">18251167</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jarrar</surname><given-names>MH</given-names></name><name><surname>Baranova</surname><given-names>A</given-names></name><name><surname>Collantes</surname><given-names>R</given-names></name><name><surname>Ranard</surname><given-names>B</given-names></name><name><surname>Stepanova</surname><given-names>M</given-names></name><name><surname>Bennett</surname><given-names>C</given-names></name><name><surname>Fang</surname><given-names>Y</given-names></name><name><surname>Elariny</surname><given-names>H</given-names></name><name><surname>Goodman</surname><given-names>Z</given-names></name><name><surname>Chandhoke</surname><given-names>V</given-names></name><name><surname>Younossi</surname><given-names>ZM</given-names></name></person-group><article-title>Adipokines and cytokines in non-alcoholic fatty liver disease</article-title><source>Aliment Pharmacol Ther</source><year>2008</year><volume>27</volume><fpage>412</fpage><lpage>421</lpage><pub-id pub-id-type="pmid">18081738</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Manco</surname><given-names>M</given-names></name><name><surname>Marcellini</surname><given-names>M</given-names></name><name><surname>Giannone</surname><given-names>G</given-names></name><name><surname>Nobili</surname><given-names>V</given-names></name></person-group><article-title>Correlation of serum TNF-alpha levels and histologic liver injury scores in pediatric nonalcoholic fatty liver disease</article-title><source>Am J Clin Pathol</source><year>2007</year><volume>127</volume><fpage>954</fpage><lpage>960</lpage><pub-id pub-id-type="pmid">17509993</pub-id><pub-id pub-id-type="doi">10.1309/6VJ4DWGYDU0XYJ8Q</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Seo</surname><given-names>YS</given-names></name><name><surname>Kim</surname><given-names>JH</given-names></name><name><surname>Jo</surname><given-names>NY</given-names></name><name><surnam