nd electromagnetic Hypersensitivity</article-title><source>Bioelectromagnetics</source><year>2003</year><volume>24</volume><fpage>387</fpage><lpage>394</lpage><pub-id pub-id-type="pmid">12929157</pub-id><pub-id pub-id-type="doi">10.1002/bem.10138</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schr&#x000f6;ttner</surname><given-names>J</given-names></name><name><surname>Leitgeb</surname><given-names>N</given-names></name><name><surname>Hillert</surname><given-names>L</given-names></name></person-group><article-title>Investigation of Electric Current Perception Thershold of Different EHS Groups</article-title><source>Bioelectromagnetics</source><year>2007</year><volume>28</volume><fpage>208</fpage><lpage>213</lpage><pub-id pub-id-type="pmid">17080457</pub-id><pub-id pub-id-type="doi">10.1002/bem.20294</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hillert</surname><given-names>L</given-names></name><name><surname>Berglind</surname><given-names>N</given-names></name><name><surname>Arnetz</surname><given-names>BB</given-names></name><name><surname>Bellander</surname><given-names>T</given-names></name></person-group><article-title>Prevalence of self-reported hypersensitivity to electric or magnetic fields in a population-based questionnaire survey</article-title><source>Scand J Work Environ Health</source><year>2002</year><volume>28</volume><fpage>33</fpage><lpage>41</lpage><pub-id pub-id-type="pmid">11871850</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Levallois</surname><given-names>P</given-names></name><name><surname>Neutra</surname><given-names>R</given-names></name><name><surname>Lee</surname><given-names>G</given-names></name><name><surname>Hristova</surname><given-names>L</given-names></name></person-group><article-titl