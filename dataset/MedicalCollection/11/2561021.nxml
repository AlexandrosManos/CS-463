Lin</surname><given-names>SJ</given-names></name></person-group><article-title>Potential risk of sternal wires</article-title><source>Eur J Cardiothorac Surg</source><year>2004</year><volume>25</volume><fpage>812</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">15082287</pub-id><pub-id pub-id-type="doi">10.1016/j.ejcts.2003.11.043</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shih</surname><given-names>CM</given-names></name><name><surname>Su</surname><given-names>YY</given-names></name><name><surname>Lin</surname><given-names>SJ</given-names></name><name><surname>Shih</surname><given-names>CC</given-names></name></person-group><article-title>Failure analysis of explanted sternal wires</article-title><source>Biomaterials</source><year>2005</year><volume>26</volume><fpage>2053</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">15576179</pub-id><pub-id pub-id-type="doi">10.1016/j.biomaterials.2004.07.005</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harjula</surname><given-names>A</given-names></name><name><surname>Jarvinen</surname><given-names>A</given-names></name></person-group><article-title>Postoperative median sternotomy dehiscence</article-title><source>Scand J Thorac Cardiovasc Surg</source><year>1983</year><volume>17</volume><fpage>277</fpage><lpage>81</lpage><pub-id pub-id-type="pmid">6359393</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jacobs</surname><given-names>JJ</given-names></name><name><surname>Gilbert</surname><given-names>JL</given-names></name><name><surname>Urban</surname><given-names>RM</given-names></name></person-group><article-title>Corrosion of metal orthopaedic implants</article-title><source>J Bone Joint Surg Am</source><year>1998</year><volume>80</volume><fpage>268</fpage><lpage>82</lpage><pu