s1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Williams</surname><given-names>BA</given-names></name><name><surname>Gwirtz</surname><given-names>RM</given-names></name><name><surname>Wold</surname><given-names>BJ</given-names></name></person-group><year>2004</year><article-title>Genomic DNA as a cohybridization standard for mammalian microarray measurements.</article-title><source>Nucleic Acids Res</source><volume>32</volume><fpage>e81</fpage><pub-id pub-id-type="pmid">15190126</pub-id></citation></ref><ref id="pntd.0000323-Williams2"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Williams</surname><given-names>BA</given-names></name><name><surname>Gwirtz</surname><given-names>RM</given-names></name><name><surname>Wold</surname><given-names>BJ</given-names></name></person-group><year>2006</year><article-title>Genomic DNA as a general cohybridization standard for ratiometric microarrays.</article-title><source>Methods Enzymol</source><volume>410</volume><fpage>237</fpage><lpage>279</lpage><pub-id pub-id-type="pmid">16938555</pub-id></citation></ref><ref id="pntd.0000323-Sidders1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sidders</surname><given-names>B</given-names></name><name><surname>Withers</surname><given-names>M</given-names></name><name><surname>Kendall</surname><given-names>SL</given-names></name><name><surname>Bacon</surname><given-names>J</given-names></name><name><surname>Waddell</surname><given-names>SJ</given-names></name><etal/></person-group><year>2007</year><article-title>Quantification of global transcription patterns in prokaryotes using spotted microarrays.</article-title><source>Genome Biol</source><volume>8</volume><fpage>R265</fpage><pub-id pub-id-type="pmid">18078514</pub-id></citation></ref><ref id="pntd.0000323-Smithers1"><label>16</label><citation citation