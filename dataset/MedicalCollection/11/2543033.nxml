-names>RE</given-names></name><name><surname>Gasior</surname><given-names>GH</given-names></name><name><surname>Loveland</surname><given-names>KG</given-names></name><name><surname>Southwick</surname><given-names>PC</given-names></name></person-group><article-title>Use of the percentage of free prostate-specific antigen to enhance differentiation of prostate cancer from benign prostatic disease: a prospective multicenter clinical trial</article-title><source>JAMA</source><year>1998</year><volume>279</volume><fpage>1542</fpage><lpage>1547</lpage><pub-id pub-id-type="pmid">9605898</pub-id><pub-id pub-id-type="doi">10.1001/jama.279.19.1542</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Loeb</surname><given-names>S</given-names></name><name><surname>Roehl</surname><given-names>KA</given-names></name><name><surname>Catalona</surname><given-names>WJ</given-names></name><name><surname>Nadler</surname><given-names>RB</given-names></name></person-group><article-title>Prostate specific antigen velocity threshold for predicting prostate cancer in young men</article-title><source>J Urol</source><year>2007</year><volume>177</volume><fpage>899</fpage><lpage>902</lpage><pub-id pub-id-type="pmid">17296371</pub-id><pub-id pub-id-type="doi">10.1016/j.juro.2006.10.028</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moul</surname><given-names>JW</given-names></name><name><surname>Sun</surname><given-names>L</given-names></name><name><surname>Hotaling</surname><given-names>JM</given-names></name><name><surname>Fitzsimons</surname><given-names>NJ</given-names></name><name><surname>Polascik</surname><given-names>TJ</given-names></name><name><surname>Robertson</surname><given-names>CN</given-names></name><name><surname>Dahm</surname><given-names>P</given-names></name><name><surname>Anscher</surname><given-names>MS</given-names></na