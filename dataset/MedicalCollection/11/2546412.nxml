con J</source><year>2004</year><volume>114</volume><fpage>464</fpage><lpage>498</lpage><pub-id pub-id-type="doi">10.1111/j.1468-0297.2004.00255.x</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Antonazzo</surname><given-names>E</given-names></name><name><surname>Scott</surname><given-names>A</given-names></name><name><surname>Skatun</surname><given-names>D</given-names></name><name><surname>Elliot</surname><given-names>R</given-names></name></person-group><article-title>The labour market for nursing: A review of the labour supply literature</article-title><source>Health Econ</source><year>2003</year><volume>12</volume><fpage>465</fpage><lpage>78</lpage><pub-id pub-id-type="pmid">12759916</pub-id><pub-id pub-id-type="doi">10.1002/hec.737</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Duckett</surname><given-names>S</given-names></name></person-group><article-title>The Australian health workforce: Facts and futures</article-title><source>Aust Health Rev</source><year>2000</year><volume>23</volume><fpage>60</fpage><lpage>77</lpage><pub-id pub-id-type="pmid">11256272</pub-id></citation></ref><ref id="B9"><citation citation-type="book"><person-group person-group-type="author"><collab>Victorian Government Department of Human Services</collab></person-group><source>Nurse recruitment and retention committee: Final report</source><year>2001</year><publisher-name>Melbourne, Aust; VDHS</publisher-name></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><collab>Department of Education Science and Training</collab></person-group><source>National review of nursing education 2002 Our Duty of Care</source><year>2002</year><publisher-name>Canberra, Aust: DEST</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.dest.gov.au/archive/highered/nursing/pubs/duty_o