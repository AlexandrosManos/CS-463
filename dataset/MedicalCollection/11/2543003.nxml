ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Messahel</surname><given-names>BF</given-names></name></person-group><article-title>Total tracheal obliteration with a low-pressure cuffed tracheal tube</article-title><source>Br J Anaesth</source><year>1994</year><volume>73</volume><fpage>697</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">7826804</pub-id><pub-id pub-id-type="doi">10.1093/bja/73.5.697</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moschini</surname><given-names>V</given-names></name><name><surname>Losappio</surname><given-names>S</given-names></name><name><surname>Dabrowska</surname><given-names>D</given-names></name><name><surname>Iorno</surname><given-names>V</given-names></name></person-group><article-title>Tracheal rupture after tracheal intubation: effectiveness of conservative treatment</article-title><source>Minerva Anestesiol</source><year>2006</year><volume>72</volume><fpage>1007</fpage><lpage>12</lpage><pub-id pub-id-type="pmid">17235268</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaloud</surname><given-names>H</given-names></name><name><surname>Smolle-Juettner</surname><given-names>FM</given-names></name><name><surname>Prause</surname><given-names>G</given-names></name><name><surname>List</surname><given-names>WF</given-names></name></person-group><article-title>Iatrogenic Ruptures of the Tracheobronchial Tree</article-title><source>Chest</source><year>1997</year><volume>112</volume><fpage>774</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">9315814</pub-id><pub-id pub-id-type="doi">10.1378/chest.112.3.774</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hilmi</surname><given-names>IA</given-names></name><name><surname>Sulvian</surname><given-names>E</given-names></name><name><surname>Quinlan</surname><given-names>J</given-names></name><name><surname>Shekar</surname><given-names>S</given-names></name></person-group><article-title>Esophageal tear: An unusual complication after difficult endotracheal intubation</article-title><source>Anesth Analg</source><year>2003</year><volume>97</volume><fpage>911</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">12933429</pub-id><pub-id pub-id-type="doi">10.1213/01.ANE.0000077074.66151.D4</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reed</surname><given-names>MF</given-names></name><name><surname>Mathisen</surname><given-names>DJ</given-names></name></person-group><article-title>Tracheoesophageal fistula</article-title><source>Chest Surg Clin N Am</source><year>2003</year><volume>13</volume><fpage>271</fpage><lpage>89</lpage><pub-id pub-id-type="pmid">12755313</pub-id><pub-id pub-id-type="doi">10.1016/S1052-3359(03)00030-9</pub-id></citation></ref></ref-list></back></article>