f><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tada</surname><given-names>Y</given-names></name><name><surname>Sato</surname><given-names>H</given-names></name><name><surname>Yoshizawa</surname><given-names>S</given-names></name><name><surname>Kimura</surname><given-names>H</given-names></name><name><surname>Kitamura</surname><given-names>M</given-names></name><name><surname>Kusaba</surname><given-names>T</given-names></name><name><surname>Nagasawa</surname><given-names>K</given-names></name></person-group><article-title>Remitting seronegative symmetrical synovitis with pitting oedema associated with gastric carcinoma</article-title><source>J Rheumatol</source><year>1997</year><volume>24</volume><fpage>974</fpage><lpage>975</lpage><pub-id pub-id-type="pmid">9150093</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cantini</surname><given-names>F</given-names></name><name><surname>Olivieri</surname><given-names>I</given-names></name><name><surname>Salvarani</surname><given-names>C</given-names></name></person-group><article-title>More on remitting seronegative symmetrical synovitis with pitting oedema as paraneoplastic syndrome</article-title><source>J Rheumatol</source><year>1998</year><volume>25</volume><fpage>188</fpage><lpage>189</lpage><pub-id pub-id-type="pmid">9458232</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gisserot</surname><given-names>O</given-names></name><name><surname>Cremades</surname><given-names>S</given-names></name><name><surname>Landais</surname><given-names>C</given-names></name><name><surname>Leyral</surname><given-names>G</given-names></name><name><surname>Bernard</surname><given-names>P</given-names></name><name><surname>de Jaur&#x000e9;guiberry</surname><given-names>JP</given-names></name></person-group><article-title>RS3PE revealing recurrent non-Hodkin's lymphoma</article-title><source>Joint Bone Spine</source><year>2004</year><volume>71</volume><fpage>424</fpage><lpage>426</lpage><pub-id pub-id-type="pmid">15474395</pub-id><pub-id pub-id-type="doi">10.1016/j.jbspin.2003.07.005</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sayarlioglu</surname><given-names>M</given-names></name></person-group><article-title>Remitting serongative symmetrical synovitis with pitting oedema (RS3PE) syndrome and malignancy</article-title><source>Eur J Ger Med</source><year>2004</year><volume>1</volume><fpage>3</fpage><lpage>5</lpage></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Agarwal</surname><given-names>V</given-names></name><name><surname>Dabra</surname><given-names>AK</given-names></name><name><surname>Kaur</surname><given-names>R</given-names></name><name><surname>Sachdev</surname><given-names>A</given-names></name><name><surname>Singh</surname><given-names>R</given-names></name></person-group><article-title>RS3PE: Ultrasonograph as a diagnostic tool</article-title><source>Clin Rheumatology</source><year>2005</year><volume>24</volume><fpage>476</fpage><lpage>479</lpage><pub-id pub-id-type="doi">10.1007/s10067-004-1061-x</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Unlu</surname><given-names>Z</given-names></name><name><surname>Orguc</surname><given-names>S</given-names></name><name><surname>Ovali</surname><given-names>GY</given-names></name><name><surname>Tarhan</surname><given-names>S</given-names></name><name><surname>Dayan</surname><given-names>I</given-names></name><name><surname>Angin</surname><given-names>A</given-names></name></person-group><article-title>MRI findings in a case of remitting seronegative symmetrical synovitis with pitting edema</article-title><source>Clin Rheumatology</source><year>2005</year><volume>24</volume><fpage>648</fpage><lpage>651</lpage><pub-id pub-id-type="doi">10.1007/s10067-005-1127-4</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Takeguchi</surname><given-names>T</given-names></name><name><surname>Sugawara</surname><given-names>Y</given-names></name><name><surname>Kikuchi</surname><given-names>K</given-names></name><name><surname>Miki</surname><given-names>H</given-names></name><name><surname>Mochizuki</surname><given-names>T</given-names></name><name><surname>Ikezoe</surname><given-names>J</given-names></name><name><surname>Sada</surname><given-names>E</given-names></name><name><surname>Hasegawa</surname><given-names>H</given-names></name><name><surname>Seike</surname><given-names>M</given-names></name></person-group><article-title>RS3PE: Scintigraphic and Magnetic resonance imaging findings</article-title><source>Clinical Nuclear Medicine</source><year>2003</year><volume>28</volume><fpage>766</fpage><lpage>769</lpage><pub-id pub-id-type="pmid">12973003</pub-id><pub-id pub-id-type="doi">10.1097/01.rlu.0000082678.99921.17</pub-id></citation></ref></ref-list></back></article>