 browser</article-title><source>Genome Res.</source><year>2004</year><volume>14</volume><fpage>951</fpage><lpage>955</lpage><pub-id pub-id-type="pmid">15123591</pub-id></element-citation></ref><ref id="B19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cheng</surname><given-names>J</given-names></name><name><surname>Dutra</surname><given-names>A</given-names></name><name><surname>Takesono</surname><given-names>A</given-names></name><name><surname>Garrett-Beal</surname><given-names>L</given-names></name><name><surname>Schwartzberg</surname><given-names>PL</given-names></name></person-group><article-title>Improved generation of C57BL/6J mouse embryonic stem cells in a defined serum-free media</article-title><source>Genesis</source><year>2004</year><volume>39</volume><fpage>100</fpage><lpage>104</lpage><pub-id pub-id-type="pmid">15170695</pub-id></element-citation></ref><ref id="B20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>YT</given-names></name><name><surname>Liu</surname><given-names>P</given-names></name><name><surname>Bradley</surname><given-names>A</given-names></name></person-group><article-title>Inducible gene trapping with drug-selectable markers and Cre/loxP to identify developmentally regulated genes</article-title><source>Mol. Cell. Biol.</source><year>2004</year><volume>24</volume><fpage>9930</fpage><lpage>9941</lpage><pub-id pub-id-type="pmid">15509795</pub-id></element-citation></ref><ref id="B21"><label>21</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Sambrook</surname><given-names>J</given-names></name><name><surname>Fritsch</surname><given-names>EF</given-names></name><name><surname>Maniatis</surname><given-names>T</given-names></name></person-group><article-title>Molecular Cloning: A Laboratory Manual</article-title><ye