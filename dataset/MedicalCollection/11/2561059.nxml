tation-type="journal"><person-group person-group-type="author"><name><surname>DaSilva</surname><given-names>AF</given-names></name><name><surname>Granziera</surname><given-names>C</given-names></name><name><surname>Snyder</surname><given-names>J</given-names></name><name><surname>Hadjikhani</surname><given-names>N</given-names></name></person-group><year>2007</year><article-title>Thickening in the somatosensory cortex of patients with migraine.</article-title><source>Neurology</source><volume>69</volume><fpage>1990</fpage><lpage>1995</lpage><pub-id pub-id-type="pmid">18025393</pub-id></citation></ref><ref id="pone.0003396-Schaechter1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schaechter</surname><given-names>JD</given-names></name><name><surname>Moore</surname><given-names>CI</given-names></name><name><surname>Connell</surname><given-names>BD</given-names></name><name><surname>Rosen</surname><given-names>BR</given-names></name><name><surname>Dijkhuizen</surname><given-names>RM</given-names></name></person-group><year>2006</year><article-title>Structural and functional plasticity in the somatosensory cortex of chronic stroke patients.</article-title><source>Brain</source><volume>129</volume><fpage>2722</fpage><lpage>2733</lpage><pub-id pub-id-type="pmid">16921177</pub-id></citation></ref><ref id="pone.0003396-Becerra1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Becerra</surname><given-names>L</given-names></name><name><surname>Morris</surname><given-names>S</given-names></name><name><surname>Bazes</surname><given-names>S</given-names></name><name><surname>Gostic</surname><given-names>R</given-names></name><name><surname>Sherman</surname><given-names>S</given-names></name><etal/></person-group><year>2006</year><article-title>Trigeminal neuropathic pain alters responses in CNS circuits to mechanical (brush) and thermal (cold and heat) stimuli.<