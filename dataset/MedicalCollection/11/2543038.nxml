/given-names></name></person-group><article-title>A randomized trial of a low-carbohydrate diet for obesity</article-title><source>N Engl J Med</source><year>2003</year><volume>348</volume><fpage>2082</fpage><lpage>2090</lpage><pub-id pub-id-type="pmid">12761365</pub-id><pub-id pub-id-type="doi">10.1056/NEJMoa022207</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fine</surname><given-names>EJ</given-names></name><name><surname>Feinman</surname><given-names>R</given-names></name><name><surname>Isasi</surname><given-names>C</given-names></name><name><surname>Wylie-Rosett</surname><given-names>J</given-names></name></person-group><article-title>A new systematic review of low carbohydrate diets</article-title><source>Obesity Research</source><year>2004</year><volume>12 (Suppl)</volume><fpage>223P</fpage></citation></ref></ref-list></back></article>