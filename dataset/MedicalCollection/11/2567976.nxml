l"><person-group person-group-type="author"><name><surname>Gertow</surname><given-names>K</given-names></name><name><surname>Cedervall</surname><given-names>J</given-names></name><name><surname>Unger</surname><given-names>C</given-names></name><name><surname>Sz&#x000f6;ke</surname><given-names>K</given-names></name><name><surname>Blennow</surname><given-names>E</given-names></name><name><surname>Imreh</surname><given-names>MP</given-names></name><name><surname>Ahrlund-Richter</surname><given-names>L</given-names></name></person-group><source>J Cell Biochem</source><year>2007</year><volume>100</volume><fpage>1518</fpage><lpage>1525</lpage><pub-id pub-id-type="pmid">17131387</pub-id><pub-id pub-id-type="doi">10.1002/jcb.21144</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pera</surname><given-names>MF</given-names></name></person-group><source>Nat Biotech</source><year>2004</year><volume>22</volume><fpage>42</fpage><pub-id pub-id-type="doi">10.1038/nbt0104-42</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Inzunza</surname><given-names>J</given-names></name><name><surname>Sahlen</surname><given-names>S</given-names></name><name><surname>Holmberg</surname><given-names>K</given-names></name><name><surname>Str&#x000f6;mberg</surname><given-names>AM</given-names></name><name><surname>Teerijoki</surname><given-names>H</given-names></name><name><surname>Blennow</surname><given-names>E</given-names></name><name><surname>Hovatta</surname><given-names>O</given-names></name><name><surname>Malmgren</surname><given-names>H</given-names></name></person-group><source>Mol Hum Reprod</source><year>2004</year><volume>10</volume><fpage>461</fpage><lpage>466</lpage><pub-id pub-id-type="pmid">15044603</pub-id><pub-id pub-id-type="doi">10.1093/molehr/gah051</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buzzard</surname><given-names>JJ</given-names></name><name><surname>Gough</surname><given-names>NM</given-names></name><name><surname>Crook</surname><given-names>JM</given-names></name><name><surname>Colman</surname><given-names>A</given-names></name></person-group><source>Nat Biotech</source><year>2004</year><volume>22</volume><fpage>381</fpage><lpage>382</lpage><pub-id pub-id-type="doi">10.1038/nbt0404-381</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mitalipova</surname><given-names>M</given-names></name><name><surname>Rao</surname><given-names>RR</given-names></name><name><surname>Hoyer</surname><given-names>DM</given-names></name><name><surname>Johnson</surname><given-names>JA</given-names></name><name><surname>Meisner</surname><given-names>LF</given-names></name><name><surname>Jones</surname><given-names>KL</given-names></name><name><surname>Dalton</surname><given-names>S</given-names></name><name><surname>Stice</surname><given-names>SL</given-names></name></person-group><source>Nat Biotech</source><year>2005</year><volume>23</volume><fpage>19</fpage><lpage>20</lpage><pub-id pub-id-type="doi">10.1038/nbt0105-19</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Caisander</surname><given-names>G</given-names></name><name><surname>Park</surname><given-names>H</given-names></name><name><surname>Frej</surname><given-names>K</given-names></name><name><surname>Lindqvist</surname><given-names>J</given-names></name><name><surname>Bergh</surname><given-names>C</given-names></name><name><surname>Lundin</surname><given-names>K</given-names></name><name><surname>Hanson</surname><given-names>C</given-names></name></person-group><source>Chromosome Res</source><year>2006</year><volume>14</volume><fpage>131</fpage><lpage>137</lpage><pub-id pub-id-type="pmid">16544187</pub-id><pub-id pub-id-type="doi">10.1007/s10577-006-1019-8</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hardarson</surname><given-names>T</given-names></name><name><surname>Caisander</surname><given-names>G</given-names></name><name><surname>Sjogren</surname><given-names>A</given-names></name><name><surname>Hanson</surname><given-names>C</given-names></name><name><surname>Hamberger</surname><given-names>L</given-names></name><name><surname>Lundin</surname><given-names>K</given-names></name></person-group><source>Hum Reprod</source><year>2003</year><volume>18</volume><fpage>399</fpage><lpage>407</lpage><pub-id pub-id-type="pmid">12571180</pub-id><pub-id pub-id-type="doi">10.1093/humrep/deg092</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hanson</surname><given-names>C</given-names></name><name><surname>Caisander</surname><given-names>G</given-names></name></person-group><source>APMIS</source><year>2005</year><volume>113</volume><fpage>751</fpage><lpage>755</lpage><pub-id pub-id-type="pmid">16480447</pub-id><pub-id pub-id-type="doi">10.1111/j.1600-0463.2005.apm_305.x</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wilton</surname><given-names>L</given-names></name></person-group><source>Prenat Diagn</source><year>2002</year><volume>22</volume><fpage>512</fpage><lpage>518</lpage><pub-id pub-id-type="pmid">12116318</pub-id><pub-id pub-id-type="doi">10.1002/pd.388</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Inzunza</surname><given-names>J</given-names></name><name><surname>Gertow</surname><given-names>K</given-names></name><name><surname>Stromberg</surname><given-names>AM</given-names></name><name><surname>Matilainen</surname><given-names>E