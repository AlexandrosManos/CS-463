gn="left">T</td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left"><bold>VLMT trial 6 &#x02013; 5 (loss due to interference)</bold></td><td align="left">BE</td><td align="left">0.76</td><td align="left">1.7</td><td align="left">5.55</td><td align="left">.0001</td><td align="left">0.13</td></tr><tr><td></td><td align="left">NS</td><td align="left">2.1</td><td align="left">2.44</td><td></td><td></td><td></td></tr><tr><td></td><td align="left">SS</td><td align="left">1.97</td><td align="left">1.61</td><td></td><td></td><td></td></tr><tr><td></td><td align="left">TS</td><td align="left">2.45</td><td align="left">1.73</td><td></td><td></td><td></td></tr><tr><td></td><td align="left">PA</td><td align="left">2.88</td><td align="left">2.1</td><td></td><td></td><td></td></tr><tr><td></td><td align="left">T</td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left"><bold>VLMT trial 7 &#x02013; 5 (loss due to delay)</bold></td><td align="left">BE</td><td align="left">0.7</td><td align="left">1.61</td><td align="left">6.4</td><td align="left">.0001</td><td align="left">0.15</td></tr><tr><td></td><td align="left">NS</td><td align="left">2.62</td><td align="left">2.8</td><td></td><td></td><td></td></tr><tr><td></td><td align="left">SS</td><td align="left">2.37</td><td align="left">2.09</td><td></td><td></td><td></td></tr><tr><td></td><td align="left">TS</td><td align="left">3.33</td><td align="left">2.04</td><td></td><td></td><td></td></tr><tr><td></td><td align="left">PA</td><td align="left">2.63</td><td align="left">2.34</td><td></td><td></td><td></td></tr><tr><td></td><td align="left">T</td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left"><bold>VLMT recognition</bold></td><td align="left">BE</td><td align="left">14.4</td><td align="left">1.27</td><td align="left">7.56</td><td align="left">.0001</td><td align="left">0.17</td></tr><tr><td></td><td align="left">NS</td><td align="left">11.4</td><td align="left">3.8</td><td>