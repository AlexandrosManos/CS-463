sification</article-title><source>Proteomics</source><year>2007</year><volume>7</volume><fpage>2800</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">17639603</pub-id><pub-id pub-id-type="doi">10.1002/pmic.200700093</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Horn</surname><given-names>F</given-names></name><name><surname>Bettler</surname><given-names>E</given-names></name><name><surname>Oliveira</surname><given-names>L</given-names></name><name><surname>Campagne</surname><given-names>F</given-names></name><name><surname>Cohen</surname><given-names>FE</given-names></name><name><surname>Vriend</surname><given-names>G</given-names></name></person-group><article-title>GPCRDB information system for G protein-coupled receptors</article-title><source>Nucleic Acids Res</source><year>2003</year><volume>31</volume><fpage>294</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">12520006</pub-id><pub-id pub-id-type="doi">10.1093/nar/gkg103</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Attwood</surname><given-names>TK</given-names></name></person-group><article-title>A compendium of specific motifs for diagnosing GPCR subtypes</article-title><source>Trends Pharmacol Sci</source><year>2001</year><volume>22</volume><fpage>162</fpage><lpage>165</lpage><pub-id pub-id-type="pmid">11282406</pub-id><pub-id pub-id-type="doi">10.1016/S0165-6147(00)01658-8</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Flower</surname><given-names>DR</given-names></name><name><surname>Attwood</surname><given-names>TK</given-names></name></person-group><article-title>Integrative bioinformatics for functional genome annotation: trawling for G protein-coupled receptors</article-title><source>Semin Cell Dev Biol</source><year>2004</year><volume>15</volume><fpage>693<