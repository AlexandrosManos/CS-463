bold></td><td colspan="1" rowspan="1" align="left" valign="top">Env<sub>233-241</sub>CL9</td><td colspan="1" rowspan="1" align="left" valign="top">Env<sub>622-630</sub>TL9</td><td colspan="1" rowspan="1" align="left" valign="top">Env<sub>729-738</sub>ST10</td><td colspan="1" rowspan="1" align="left" valign="top">Tat<sub>28-35</sub>SL8</td><td colspan="1" rowspan="1" align="left" valign="top">Vif<sub>144-152</sub>QA9</td><td colspan="1" rowspan="1" align="left" valign="top">Vpx<sub>8-18</sub>II11</td><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="left" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">SIVmac239&#x00394;nef</td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>CAPPGYALL</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>TVPWPNASL</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>SSPPSYFQQT</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>STPESANL</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>QVPSLQYLA</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>IPPGNSGEETI</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="left" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">SIVsmE660</td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>.........</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>......ET.</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>....A.V..I</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>P.......</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>.........</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>...........</monospace></td><td colspan="