p">Env<sub>317-325</sub>KM9</td><td colspan="1" rowspan="1" align="left" valign="top">Env<sub>359-367</sub>QY9</td><td colspan="1" rowspan="1" align="left" valign="top">Env<sub>519-528</sub>GF10</td><td colspan="1" rowspan="1" align="left" valign="top">Env<sub>760-768</sub>SY9</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">SIVmac239&#x00394;nef</td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>GSENLKSLY</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>FSIPLDEEF</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>LSQEQEGCY</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>RTIISLNKY</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>KTVLPVTIM</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>QTIVKHPRY</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>GTSRNKRGVF</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>SSWPWQIEY</monospace></td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">SIVsmE660</td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>.........</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>.........</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>.........</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>.........</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>.........</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>E.L......</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>.A........</monospace></td><td colspan="1" rowspan="1" align="left" valign="top"><monospace>R........</monospace></td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">01022</td><td colspan="1" rowsp