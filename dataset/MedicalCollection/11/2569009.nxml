p person-group-type="author"><name><surname>Fultz</surname><given-names>N</given-names></name><name><surname>Herzog</surname><given-names>R</given-names></name></person-group><article-title>Self-Reported Social and Emotional Impact of Urinary Incontinence</article-title><source>J Am Geriatr Soc</source><year>2001</year><volume>49</volume><fpage>892</fpage><lpage>899</lpage><pub-id pub-id-type="pmid">11527480</pub-id><pub-id pub-id-type="doi">10.1046/j.1532-5415.2001.49179.x</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bodden-Heidrich</surname><given-names>R</given-names></name><name><surname>Beckmann</surname><given-names>M</given-names></name><name><surname>Libera</surname><given-names>B</given-names></name><name><surname>Rechenberger</surname><given-names>I</given-names></name><name><surname>Bender</surname><given-names>H</given-names></name></person-group><article-title>Psychosomatic aspects of urinary incontinence</article-title><source>Arch Gynecol Obst</source><year>1999</year><volume>262</volume><fpage>151</fpage><lpage>156</lpage><pub-id pub-id-type="pmid">10326634</pub-id><pub-id pub-id-type="doi">10.1007/s004040050243</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nygaard</surname><given-names>I</given-names></name><name><surname>Turvey</surname><given-names>C</given-names></name><name><surname>Burns</surname><given-names>T</given-names></name><name><surname>Crischilles</surname><given-names>E</given-names></name><name><surname>Wallace</surname><given-names>R</given-names></name></person-group><article-title>Urinary incontinence and depression in middle-aged United States women</article-title><source>Obstet Gynecol</source><year>2003</year><volume>101</volume><fpage>71</fpage><lpage>76</lpage><pub-id pub-id-type="doi">10.1016/S0029-7844(02)02658-3</pub-id></citation></ref><ref id="B20"><citati