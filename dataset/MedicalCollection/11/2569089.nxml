ble frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1">Developmental period</th><th align="center" rowspan="1" colspan="1">Sensory magnitude</th><th align="center" rowspan="1" colspan="1">Sensory habituation</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">Very early (2&#x02013;6 weeks)</td><td align="center" rowspan="1" colspan="1">0.39<xref ref-type="table-fn" rid="tfn2-ehp-116-1322">*</xref></td><td align="center" rowspan="1" colspan="1">0.23</td></tr><tr><td align="left" rowspan="1" colspan="1">Early (2&#x02013;12 weeks)</td><td align="center" rowspan="1" colspan="1">0.42<xref ref-type="table-fn" rid="tfn3-ehp-116-1322">**</xref></td><td align="center" rowspan="1" colspan="1">0.25</td></tr><tr><td align="left" rowspan="1" colspan="1">Preweaning (14&#x02013;26 weeks)</td><td align="center" rowspan="1" colspan="1">0.34<xref ref-type="table-fn" rid="tfn2-ehp-116-1322">*</xref></td><td align="center" rowspan="1" colspan="1">0.13</td></tr><tr><td align="left" rowspan="1" colspan="1">6&#x02013;12 months (28&#x02013;52 weeks)</td><td align="center" rowspan="1" colspan="1">0.30<xref ref-type="table-fn" rid="tfn4-ehp-116-1322">#</xref></td><td align="center" rowspan="1" colspan="1">0.03</td></tr><tr><td align="left" rowspan="1" colspan="1">Postchelation (68&#x02013;112 weeks)</td><td align="center" rowspan="1" colspan="1">&#x02212;0.23</td><td align="center" rowspan="1" colspan="1">0.26</td></tr></tbody></table><table-wrap-foot><fn id="tfn1-ehp-116-1322"><p><italic>n</italic> = 39, lead-exposed animals only.</p></fn><fn id="tfn2-ehp-116-1322"><label>*</label><p><italic>p</italic> &#x0003c; 0.05.</p></fn><fn id="tfn3-ehp-116-1322"><label>**</label><p><italic>p</italic> &#x0003c; 0.01.</p></fn><fn id="tfn4-ehp-116-1322"><label>#</label><p><italic>p</italic> &#x0003c; 0.10.</p></fn></table-wrap-foot></table-wrap><table-wrap id="t2-ehp-116-1322" position="float"><label>Table 2</label><caption><p>Blood lead concentrations [me