ame><given-names>L</given-names></name><name><surname>Sander</surname><given-names>C</given-names></name></person-group><article-title>Dali/FSSP classification of three-dimensional protein folds</article-title><source>Nucleic Acids Res</source><year>1997</year><volume>25</volume><fpage>231</fpage><lpage>234</lpage><pub-id pub-id-type="pmid">9016542</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Krissinel</surname><given-names>E</given-names></name><name><surname>Henrick</surname><given-names>K</given-names></name></person-group><article-title>Secondary-structure matching (SSM), a new tool for fast protein structure alignment in three dimensions</article-title><source>Acta Crystallogr D Biol Crystallogr</source><year>2004</year><volume>60</volume><fpage>2256</fpage><lpage>2268</lpage><pub-id pub-id-type="pmid">15572779</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shindyalov</surname><given-names>IN</given-names></name><name><surname>Bourne</surname><given-names>PE</given-names></name></person-group><article-title>Protein structure alignment by incremental combinatorial extension (CE) of optimal path</article-title><source>Protein Engineering</source><year>1998</year><volume>11</volume><fpage>739</fpage><lpage>747</lpage><pub-id pub-id-type="pmid">9796821</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Taylor</surname><given-names>W</given-names></name><name><surname>Orengo</surname><given-names>C</given-names></name></person-group><article-title>SSAP: sequential structure alignment program for protein structure comparison</article-title><source>Methods Enzymol</source><year>1996</year><volume>266</volume><fpage>617</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">8743709</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sutcliffe</surname><given-names>MJ</given-names></name><name><surname>Haneef</surname><given-names>I</given-names></name><name><surname>Carney</surname><given-names>D</given-names></name><name><surname>Blundell</surname><given-names>TL</given-names></name></person-group><article-title>Knowledge based moddelling of homologous proteins, part I: three-dimensional frameworks derived from the simultaneous superposition of multiple structures</article-title><source>Protein Engineering</source><year>1987</year><volume>1</volume><fpage>377</fpage><lpage>384</lpage><pub-id pub-id-type="pmid">3508286</pub-id></citation></ref><ref id="B22"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Chew</surname><given-names>LP</given-names></name><name><surname>Kedem</surname><given-names>K</given-names></name></person-group><article-title>Finding the Consensus Shape for a Protein Family (Extended Abstract)</article-title><year>2002</year><ext-link ext-link-type="uri" xlink:href="http://citeseer.ist.psu.edu/596999.html"/></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guda</surname><given-names>C</given-names></name><name><surname>Lu</surname><given-names>S</given-names></name><name><surname>Scheeff</surname><given-names>ED</given-names></name><name><surname>Bourne</surname><given-names>PE</given-names></name><name><surname>Shindyalov</surname><given-names>LN</given-names></name></person-group><article-title>CE-MC: a multiple protein structure alignment server</article-title><source>Nucleic Acids Research</source><year>2004</year><volume>32</volume><comment>"W100-3".</comment></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lupyan</surname><given-names>D</given-names></name><name><surname>Leo-Macias</surname><given-names>A</given-