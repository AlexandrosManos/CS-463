erson-group person-group-type="author"><name><surname>Bardoni</surname><given-names>R</given-names></name><name><surname>Torsney</surname><given-names>C</given-names></name><name><surname>Tong</surname><given-names>CK</given-names></name><name><surname>Prandini</surname><given-names>M</given-names></name><name><surname>MacDermott</surname><given-names>AB</given-names></name></person-group><article-title>Presynaptic NMDA receptors modulate glutamate release from primary sensory neurons in rat spinal cord dorsal horn</article-title><source>J Neurosci</source><year>2004</year><volume>24</volume><fpage>2774</fpage><lpage>2781</lpage><pub-id pub-id-type="pmid">15028770</pub-id><pub-id pub-id-type="doi">10.1523/JNEUROSCI.4637-03.2004</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Araque</surname><given-names>A</given-names></name><name><surname>Perea</surname><given-names>G</given-names></name></person-group><article-title>Glial modulation of synaptic transmission in culture</article-title><source>Glia</source><year>2004</year><volume>47</volume><fpage>241</fpage><lpage>248</lpage><pub-id pub-id-type="pmid">15252813</pub-id><pub-id pub-id-type="doi">10.1002/glia.20026</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Newman</surname><given-names>EA</given-names></name></person-group><article-title>New roles for astrocytes: regulation of synaptic transmission</article-title><source>Trends Neurosci</source><year>2003</year><volume>26</volume><fpage>536</fpage><lpage>542</lpage><pub-id pub-id-type="pmid">14522146</pub-id><pub-id pub-id-type="doi">10.1016/S0166-2236(03)00237-6</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Volterra</surname><given-names>A</given-names></name><name><surname>Meldolesi</surname><given-names>J</given-names><