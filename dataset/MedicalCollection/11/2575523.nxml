ame><name><surname>Riley-Berger</surname><given-names>R</given-names></name><name><surname>Harshman</surname><given-names>L</given-names></name><name><surname>Kopp</surname><given-names>A</given-names></name><name><surname>Vacha</surname><given-names>S</given-names></name><name><surname>Nuzhdin</surname><given-names>S</given-names></name><name><surname>Wayne</surname><given-names>M</given-names></name></person-group><article-title>Extensive sex-specific nonadditivity of gene expression in <italic>Drosophila melanogaster</italic>.</article-title><source>Genetics</source><year>2004</year><volume>167</volume><fpage>1791</fpage><lpage>1799</lpage><pub-id pub-id-type="pmid">15342517</pub-id><pub-id pub-id-type="doi">10.1534/genetics.104.026583</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vuylsteke</surname><given-names>M</given-names></name><name><surname>van Eeuwijk</surname><given-names>F</given-names></name><name><surname>Van Hummelen</surname><given-names>P</given-names></name><name><surname>Kuiper</surname><given-names>M</given-names></name><name><surname>Zabeau</surname><given-names>M</given-names></name></person-group><article-title>Genetic analysis of variation in gene expression in <italic>Arabidopsis thaliana</italic>.</article-title><source>Genetics</source><year>2005</year><volume>171</volume><fpage>1267</fpage><lpage>1275</lpage><pub-id pub-id-type="pmid">16020790</pub-id><pub-id pub-id-type="doi">10.1534/genetics.105.041509</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Landry</surname><given-names>CR</given-names></name><name><surname>Wittkopp</surname><given-names>PJ</given-names></name><name><surname>Taubes</surname><given-names>CH</given-names></name><name><surname>Ranz</surname><given-names>JM</given-names></name><name><surname>Clark</surname><given-names>AG</given-names></name><name><surname>Hartl</surname><given-names>DL</given-names></name></person-group><article-title>Compensatory <italic>cis</italic>-<italic>trans </italic>evolution and the dysregulation of gene expression in interspecific hybrids of <italic>Drosophila</italic>.</article-title><source>Genetics</source><year>2005</year><volume>171</volume><fpage>1813</fpage><lpage>1822</lpage><pub-id pub-id-type="pmid">16143608</pub-id><pub-id pub-id-type="doi">10.1534/genetics.105.047449</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hegarty</surname><given-names>MJ</given-names></name><name><surname>Barker</surname><given-names>GL</given-names></name><name><surname>Wilson</surname><given-names>ID</given-names></name><name><surname>Abbott</surname><given-names>RJ</given-names></name><name><surname>Edwards</surname><given-names>KJ</given-names></name><name><surname>Hiscock</surname><given-names>SJ</given-names></name></person-group><article-title>Transcriptome shock after interspecific hybridization in senecio is ameliorated by genome duplication.</article-title><source>Curr Biol</source><year>2006</year><volume>16</volume><fpage>1652</fpage><lpage>1659</lpage><pub-id pub-id-type="pmid">16920628</pub-id><pub-id pub-id-type="doi">10.1016/j.cub.2006.06.071</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McClintock</surname><given-names>B</given-names></name></person-group><article-title>The significance of responses of the genome to challenge.</article-title><source>Science</source><year>1984</year><volume>226</volume><fpage>792</fpage><lpage>801</lpage><pub-id pub-id-type="pmid">15739260</pub-id><pub-id pub-id-type="doi">10.1126/science.15739260</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wittkopp</surname><given-names>PJ</given-names></name><name><surname>Haerum</surname><given-names>BK</given-names></name><name><surname>Clark</surname><given-names>AG</given-names></name></person-group><article-title>Evolutionary changes in cis and trans gene regulation.</article-title><source>Nature</source><year>2004</year><volume>430</volume><fpage>85</fpage><lpage>88</lpage><pub-id pub-id-type="pmid">15229602</pub-id><pub-id pub-id-type="doi">10.1038/nature02698</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Veitia</surname><given-names>RA</given-names></name></person-group><article-title>Exploring the molecular etiology of dominant-negative mutations.</article-title><source>Plant Cell</source><year>2007</year><volume>19</volume><fpage>3843</fpage><lpage>3851</lpage><pub-id pub-id-type="pmid">18083908</pub-id><pub-id pub-id-type="doi">10.1105/tpc.107.055053</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burgio</surname><given-names>G</given-names></name><name><surname>Szatanik</surname><given-names>M</given-names></name><name><surname>Guenet</surname><given-names>JL</given-names></name><name><surname>Arnau</surname><given-names>MR</given-names></name><name><surname>Panthier</surname><given-names>JJ</given-names></name><name><surname>Montagutelli</surname><given-names>X</given-names></name></person-group><article-title>Interspecific recombinant congenic strains between C57BL/6 and mice of the <italic>Mus spretus </italic>species: a powerful tool to dissect genetic control of complex traits.</article-title><source>Genetics</source><year>2007</year><volume>177</volume><fpage>2321</fpage><lpage>2333</lpage><pub-id pub-id-type="pmid">17947429</pub-id><pub-id pub-id-type="doi">10.1534/genetics.107.078006</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Orth</surname><given-names>A</given-names><