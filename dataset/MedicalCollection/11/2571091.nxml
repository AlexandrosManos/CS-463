17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Spector</surname><given-names>WD</given-names></name><etal></etal></person-group><article-title>The hierarchical relationship between activities of daily living and instrumental activities of daily living</article-title><source>J Chronic Dis</source><year>1987</year><volume>40</volume><fpage>481</fpage><lpage>489</lpage><pub-id pub-id-type="pmid">3597653</pub-id><pub-id pub-id-type="doi">10.1016/0021-9681(87)90004-X</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thorsell</surname><given-names>KB</given-names></name><name><surname>Nordstr&#x000f6;m</surname><given-names>B</given-names></name><name><surname>Nyberg</surname><given-names>P</given-names></name><name><surname>Sivberg</surname><given-names>BV</given-names></name></person-group><article-title>Can care of elderly be measured? A method for estimating the individual care of recipients in community health care</article-title><source>BMC-Geriatric</source><year>2006</year><volume>6</volume><fpage>14</fpage><pub-id pub-id-type="doi">10.1186/1471-2318-6-14</pub-id></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Altman</surname><given-names>D</given-names></name></person-group><source>Practical Statistics for Medical Research</source><year>1991</year><publisher-name>London: Chapman &#x00026; Hall/CRC</publisher-name></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Polit</surname><given-names>DF</given-names></name><name><surname>Beck</surname><given-names>CT</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Wilkins LW</surname></name></person-group><source>Essentials of Nursing Research Methods, Appraisal, and Utilization</source><year>2006</year><edition>6</edition><publisher-name>JB Lippincott Company, Philadelphia</publisher-name></citation></ref></ref-list></back></article>