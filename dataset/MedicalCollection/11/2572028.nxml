pe</article-title><source>Pediatr Cardiol</source><year>1996</year><volume>17</volume><fpage>86</fpage><lpage>90</lpage><pub-id pub-id-type="pmid">8833492</pub-id></element-citation></ref><ref id="R11"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Alehan</surname><given-names>D</given-names></name><name><surname>Lenk</surname><given-names>M</given-names></name><name><surname>Ozme</surname><given-names>S</given-names></name><etal/></person-group><article-title>Comparison of sensitivity and specificity of tilt protocols with and without isoproterenol in children with unexplained syncope</article-title><source>Pacing Clin Electrophysiol</source><year>1997</year><volume>20</volume><fpage>1769</fpage><lpage>1776</lpage><pub-id pub-id-type="pmid">9249830</pub-id></element-citation></ref><ref id="R12"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Strieper</surname><given-names>MJ</given-names></name><name><surname>Auld</surname><given-names>DO</given-names></name><name><surname>Hulse</surname><given-names>JE</given-names></name><etal/></person-group><article-title>Evaluation of recurrent pediatric syncope: role of tilt table testing</article-title><source>Pediatrics</source><year>1994</year><volume>93</volume><fpage>660</fpage><lpage>662</lpage><pub-id pub-id-type="pmid">8134225</pub-id></element-citation></ref><ref id="R13"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Boysen</surname><given-names>A</given-names></name><name><surname>Lewin</surname><given-names>MA</given-names></name><name><surname>Uhlemann</surname><given-names>F</given-names></name></person-group><article-title>Common patterns of response to the head-up tilt test in children and adolescents</article-title><source>Cardiol Young</source><year>2006</year><volume>16</volume><fpage>537</fpage><lpage>539</lpage><pub-id pub-id-type="pmid">17116266</pub-id></element-citation></ref><ref id="R14"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Foglia-Manzillo</surname><given-names>G</given-names></name><name><surname>Romano</surname><given-names>M</given-names></name><name><surname>Corrado</surname><given-names>G</given-names></name></person-group><article-title>Reproducibility of asystole during head-up tilt testing in patients with neurally mediated syncope</article-title><source>Europace</source><year>2002</year><volume>4</volume><fpage>365</fpage><lpage>367</lpage><pub-id pub-id-type="pmid">12408255</pub-id></element-citation></ref><ref id="R15"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kapoor</surname><given-names>WN</given-names></name><name><surname>Smith</surname><given-names>M</given-names></name><name><surname>Miller</surname><given-names>NL</given-names></name></person-group><article-title>Upright tilt testing in evaluating syncope: a comprehensive literature review</article-title><source>Am J Med</source><year>1994</year><volume>97</volume><fpage>78</fpage><lpage>88</lpage><pub-id pub-id-type="pmid">8030660</pub-id></element-citation></ref><ref id="R16"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lewis</surname><given-names>DA</given-names></name><name><surname>Zlotocha</surname><given-names>J</given-names></name><name><surname>Henke</surname><given-names>L</given-names></name><etal/></person-group><article-title>Specificity of head-up tilt testing in adolescents: effect of various degrees of tilt challenge in normal control subjects</article-title><source>J Am Coll Cardiol</source><year>1997</year><volume>30</volume><fpage>1057</fpage><lpage>1060</lpage><pub-id pub-id-type="pmid">9316539</pub-id></element-citation></ref><ref id="R17"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Natale</surname><given-names>A</given-names></name><name><surname>Akhtar</surname><given-names>M</given-names></name><name><surname>Jazayeri</surname><given-names>M</given-names></name><etal/></person-group><article-title>Provocation of hypotension during head-up tilt testing in subjects with no history of syncope or pre-syncope</article-title><source>Circulation</source><year>1995</year><volume>92</volume><fpage>54</fpage><lpage>58</lpage><pub-id pub-id-type="pmid">7788917</pub-id></element-citation></ref><ref id="R18"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Raviele</surname><given-names>A</given-names></name><name><surname>Menozzi</surname><given-names>C</given-names></name><name><surname>Brignole</surname><given-names>M</given-names></name><etal/></person-group><article-title>Value of head-up tilt testing potentiated with sublingual nitroglycerine to access the origin of unexplained syncope</article-title><source>Am J Cardiol</source><year>1995</year><volume>76</volume><fpage>267</fpage><lpage>272</lpage><pub-id pub-id-type="pmid">7618622</pub-id></element-citation></ref><ref id="R19"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Vlahos</surname><given-names>AP</given-names></name><name><surname>Tzoufi</surname><given-names>M</given-names></name><name><surname>Katsouras</surname><given-names>CS</given-names></name><etal/></person-group><article-title>Provocation of neurocardiogenic syncope during head-up tilt testing in children: comparison between isoproterenol and nitroglycerin</article-title><source>Pediatrics</source><year>2007</year><volume>119</volume><fpage>e419</fpage><lpage>e425</lpage><pub-id pub-id-type="pmid">17224456</pub-id></element-citation></ref></ref-list></back><floats-group><table-wrap id="T1" position="float"><label>Table 1</label><caption><p>TILT TABLE TEST - Questionnaire</p></caption><graphic xlink:href="ipej080242-01"/></table-wrap></floats-group></article>