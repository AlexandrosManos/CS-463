page><lpage>359</lpage><comment>(in Japanese)</comment></citation></ref><ref id="B10"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Endler</surname><given-names>NS</given-names></name><name><surname>Parker</surname><given-names>JDA</given-names></name></person-group><article-title>Coping inventory for stressful situations (CISS): Manual</article-title><source>Multi-Health Systems, Inc: Tronto</source><year>1990</year></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Furukawa</surname><given-names>T</given-names></name><name><surname>Suzuki</surname><given-names>MA</given-names></name><name><surname>Saito</surname><given-names>Y</given-names></name><name><surname>Hamanaka</surname><given-names>T</given-names></name></person-group><article-title>Reliability and Validity of the Japanese Version of the Coping Inventory for Stressful Situations (CISS): A Contribution to the Cross-cultural Studies of Coping</article-title><source>Seishin Shinkeigaku Zasshi</source><year>1993</year><volume>95</volume><fpage>602</fpage><lpage>620</lpage><comment>(in Japanese)</comment><pub-id pub-id-type="pmid">8234537</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Suzuki</surname><given-names>S</given-names></name><name><surname>Sakano</surname><given-names>Y</given-names></name></person-group><article-title>Development of a Cognitive Appraisal Rating Scale (CARS) and its Validation</article-title><source>Human science research (Waseda human science research)</source><year>1998</year><volume>7</volume><fpage>113</fpage><lpage>124</lpage><comment>(in Japanese)</comment></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lazarus</surname><given-names>RS</given-names></name><name><surname>Folkman</surname><given-names>S</given-names></n