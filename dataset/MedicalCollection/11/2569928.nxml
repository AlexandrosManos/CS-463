year><volume>115</volume><fpage>S483</fpage><lpage>523</lpage><pub-id pub-id-type="pmid">15753926</pub-id><pub-id pub-id-type="doi">10.1016/j.jaci.2005.01.010</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chapman</surname><given-names>JA</given-names></name><name><surname>Bernstein</surname><given-names>IL</given-names></name><name><surname>Lee</surname><given-names>RE</given-names></name><name><surname>Oppenheimer</surname><given-names>J</given-names></name><name><surname>Nicklas</surname><given-names>RA</given-names></name><name><surname>Portnoy</surname><given-names>JM</given-names></name><name><surname>Sicherer</surname><given-names>SH</given-names></name><name><surname>Schuller</surname><given-names>DE</given-names></name><name><surname>Spector</surname><given-names>SL</given-names></name><name><surname>Khan</surname><given-names>D</given-names></name><name><surname>Lang</surname><given-names>D</given-names></name><name><surname>Simon</surname><given-names>RA</given-names></name><name><surname>Tilles</surname><given-names>SA</given-names></name><name><surname>Blessing-Moore</surname><given-names>J</given-names></name><name><surname>Wallace</surname><given-names>D</given-names></name><name><surname>Teuber</surname><given-names>SS</given-names></name></person-group><article-title>Food allergy: a practice parameter</article-title><source>Ann Allergy Asthma Immunol</source><year>2006</year><volume>96</volume><fpage>S1</fpage><lpage>68</lpage><pub-id pub-id-type="pmid">16597066</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sampson</surname><given-names>HA</given-names></name><name><surname>Munoz-Furlong</surname><given-names>A</given-names></name><name><surname>Bock</surname><given-names>SA</given-names></name><name><surname>Schmitt</surname><given-names>C</given-names></name><name><surname>Bass</surnam