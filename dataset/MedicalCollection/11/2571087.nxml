&#x000f5;&#x000ed;v") magyar ford&#x000ed;t&#x000e1;sa, hazai popul&#x000e1;ci&#x000f3;n v&#x000e9;gzett m&#x000e9;r&#x000e9;sek eredm&#x000e9;nyei</article-title><source>Fogorv Sz</source><year>1999</year><volume>92</volume><fpage>307</fpage><lpage>315</lpage><pub-id pub-id-type="pmid">10575818</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cesar</surname><given-names>J</given-names></name><name><surname>de Moraes</surname><given-names>ABA</given-names></name><name><surname>Milgrom</surname><given-names>P</given-names></name><name><surname>Kleinknecht</surname><given-names>RA</given-names></name></person-group><article-title>Cross validation of a Brazilian version of the Dental Fear Survey</article-title><source>Community Dent Oral Epidemiol</source><year>1993</year><volume>21</volume><fpage>148</fpage><lpage>150</lpage><pub-id pub-id-type="pmid">8348788</pub-id><pub-id pub-id-type="doi">10.1111/j.1600-0528.1993.tb00740.x</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Firat</surname><given-names>D</given-names></name><name><surname>Tunc</surname><given-names>EP</given-names></name><name><surname>Sar</surname><given-names>V</given-names></name></person-group><article-title>Dental anxiety among adults in Turkey</article-title><source>J Contemp Dent Pract</source><year>2006</year><volume>7</volume><fpage>75</fpage><lpage>82</lpage><pub-id pub-id-type="pmid">16820810</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lago-M&#x000e9;ndez</surname><given-names>L</given-names></name><name><surname>Diniz-Freitas</surname><given-names>M</given-names></name><name><surname>Senra-Rivera</surname><given-names>C</given-names></name><name><surname>Seoane-Pesqueira</surname><given-names>G</given-names></name><name><surname>G&#x000e1;ndara-Rey<