e><pub-id pub-id-type="pmid">7647936</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cavazza</surname><given-names>A</given-names></name><name><surname>Sassatelli</surname><given-names>R</given-names></name><name><surname>De Marco</surname><given-names>L</given-names></name></person-group><article-title>Osseous metaplasia in an intestinal adenomatous polyp. Case report and review of the literature</article-title><source>Pathologica</source><year>1996</year><volume>88</volume><fpage>511</fpage><lpage>513</lpage><pub-id pub-id-type="pmid">9206779</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shafritz</surname><given-names>AB</given-names></name><name><surname>Shore</surname><given-names>EM</given-names></name><name><surname>Gannon</surname><given-names>FH</given-names></name><name><surname>Zasloff</surname><given-names>MA</given-names></name><name><surname>Taub</surname><given-names>R</given-names></name><name><surname>Muenke</surname><given-names>M</given-names></name><name><surname>Kaplan</surname><given-names>FS</given-names></name></person-group><article-title>Overexpression of an osteogenic morphogen on Fibrodysplasia ossificans progressiva</article-title><source>N Engl J Med</source><year>1996</year><volume>335</volume><fpage>591</fpage><lpage>593</lpage><pub-id pub-id-type="pmid">8678940</pub-id><pub-id pub-id-type="doi">10.1056/NEJM199608223350804</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Apostolidis</surname><given-names>NS</given-names></name><name><surname>Legakis</surname><given-names>NC</given-names></name><name><surname>Gregoriadis</surname><given-names>GC</given-names></name><name><surname>Androulakakis</surname><given-names>PA</given-names></name><name><surname>Romanos</surname><given-names>AN</given-names