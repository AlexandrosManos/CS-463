/citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kry</surname><given-names>SF</given-names></name><name><surname>Salehpour</surname><given-names>M</given-names></name><name><surname>Followill</surname><given-names>DS</given-names></name><name><surname>Stovall</surname><given-names>M</given-names></name><name><surname>Kuban</surname><given-names>DA</given-names></name><name><surname>White</surname><given-names>RA</given-names></name><name><surname>Rosen</surname><given-names>II</given-names></name></person-group><article-title>Out-of-field photon and neutron dose equivalents from step-and-shoot intensity-modulated radiation therapy</article-title><source>Int J Radiat Oncol Biol Phys</source><year>2005</year><volume>62</volume><fpage>1204</fpage><lpage>1216</lpage><pub-id pub-id-type="pmid">15990026</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giorgia</surname><given-names>N</given-names></name><name><surname>Antonella</surname><given-names>F</given-names></name><name><surname>Eugenio</surname><given-names>V</given-names></name><name><surname>Alessandro</surname><given-names>C</given-names></name><name><surname>Filippo</surname><given-names>A</given-names></name><name><surname>Luca</surname><given-names>C</given-names></name></person-group><article-title>What is an acceptably smoothed fluence? Dosimetric and delivery considerations for dynamic sliding window IMRT</article-title><source>Radiat Oncol</source><year>2007</year><volume>2</volume><fpage>42</fpage><pub-id pub-id-type="pmid">18036217</pub-id><pub-id pub-id-type="doi">10.1186/1748-717X-2-42</pub-id></citation></ref></ref-list></back></article>