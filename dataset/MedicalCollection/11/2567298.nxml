ame><surname>Angus</surname><given-names>D</given-names></name><name><surname>Bolton</surname><given-names>DM</given-names></name></person-group><article-title>Sclerosing lipogranuloma of the genitalia treated with corticosteroids</article-title><source>Int Urol Nephrol</source><year>2006</year><volume>38</volume><fpage>97</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">16502060</pub-id><pub-id pub-id-type="doi">10.1007/s11255-005-8572-5</pub-id></citation></ref></ref-list></back></article>