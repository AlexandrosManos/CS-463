t presentation</article-title><source>Int J Radiat Oncol Biol Phys</source><year>2000</year><volume>46</volume><fpage>383</fpage><lpage>390</lpage><pub-id pub-id-type="pmid">10661345</pub-id><pub-id pub-id-type="doi">10.1016/S0360-3016(99)00444-7</pub-id></citation></ref></ref-list></back></article>