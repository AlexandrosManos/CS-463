 id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oldham</surname><given-names>WM</given-names></name><name><surname>Hamm</surname><given-names>HE</given-names></name></person-group><article-title>Heterotrimeric G protein activation by G-protein-coupled receptors</article-title><source>Nat Rev Mol Cell Biol</source><year>2008</year><volume>9</volume><fpage>60</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">18043707</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamm</surname><given-names>HE</given-names></name></person-group><article-title>The many faces of G protein signaling</article-title><source>J Biol Chem</source><year>1998</year><volume>273</volume><fpage>669</fpage><lpage>672</lpage><pub-id pub-id-type="pmid">9422713</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Neer</surname><given-names>EJ</given-names></name></person-group><article-title>Heterotrimeric G proteins: organizers of transmembrane signals</article-title><source>Cell</source><year>1995</year><volume>80</volume><fpage>249</fpage><lpage>257</lpage><pub-id pub-id-type="pmid">7834744</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cabrera-Vera</surname><given-names>TM</given-names></name><name><surname>Vanhauwe</surname><given-names>J</given-names></name><name><surname>Thomas</surname><given-names>TO</given-names></name><name><surname>Medkova</surname><given-names>M</given-names></name><name><surname>Preininger</surname><given-names>A</given-names></name><name><surname>Mazzoni</surname><given-names>MR</given-names></name><name><surname>Hamm</surname><given-names>HE</given-names></name></person-group><article-title>Insights into G protein structure, function, and regulation</article-title><source>Endocr Rev