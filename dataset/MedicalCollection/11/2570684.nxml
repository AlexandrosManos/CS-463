e><pub-id pub-id-type="pmid">18165493</pub-id></citation></ref><ref id="B10"><citation citation-type="other"><article-title>The Global Fund. Press Release &#x02013; 30 November 2005</article-title><ext-link ext-link-type="uri" xlink:href="http://www.theglobalfund.org/en/media_center/press/pr_051130.asp"/></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cohen</surname><given-names>JM</given-names></name><name><surname>Singh</surname><given-names>I</given-names></name></person-group><source>Global Forecast of ACT Demand</source><year>2008</year><publisher-name>Boston: Clinton Foundation HIV/AIDS Initiative</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.clintonfoundation.org/what-we-do/clinton-hiv-aids-initiative/information-center-resources"/></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lu</surname><given-names>C</given-names></name><name><surname>Michaud</surname><given-names>CM</given-names></name><name><surname>Khan</surname><given-names>K</given-names></name><name><surname>Murray</surname><given-names>CJ</given-names></name></person-group><article-title>Absorptive capacity and disbursements by the Global Fund to Fight AIDS, Tuberculosis and Malaria: analysis of grant implementation</article-title><source>Lancet</source><year>2006</year><volume>368</volume><fpage>483</fpage><lpage>488</lpage><pub-id pub-id-type="pmid">16890835</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(06)69156-3</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Radelet</surname><given-names>S</given-names></name><name><surname>Siddiqi</surname><given-names>B</given-names></name></person-group><article-title>Global Fund grant programmes: an analysis of evaluation scores</article-title><source>Lancet</source><year>2007</year><volume>369</volume><fp