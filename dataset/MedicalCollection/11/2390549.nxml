le-title><source>Lancet</source><year>2003</year><volume>3</volume><fpage>722</fpage><lpage>727</lpage></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Davis</surname><given-names>P</given-names></name></person-group><article-title>Viral infections, acquired immunodeficiency syndrome, and rheumatic diseases</article-title><source>Curr Opin Rheumatol</source><year>1992</year><volume>4</volume><fpage>529</fpage><lpage>533</lpage><pub-id pub-id-type="pmid">1503877</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sekigawa</surname><given-names>I</given-names></name><name><surname>Kaneko</surname><given-names>H</given-names></name><name><surname>Hishikawa</surname><given-names>T</given-names></name><name><surname>Hashimoto</surname><given-names>H</given-names></name><name><surname>Hirose</surname><given-names>S</given-names></name><name><surname>Kaneko</surname><given-names>Y</given-names></name><name><surname>Maruyama</surname><given-names>N</given-names></name></person-group><article-title>HIV infection and SLE: their pathogenic relationship</article-title><source>Clin Exp Rheumatol</source><year>1998</year><volume>16</volume><fpage>175</fpage><lpage>80</lpage><pub-id pub-id-type="pmid">9536396</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kopelman</surname><given-names>RG</given-names></name><name><surname>Zolla-Pazner</surname><given-names>S</given-names></name></person-group><article-title>Association of human immunodeficiency virus infection and autoimmune phenomena</article-title><source>Am J Med</source><year>1988</year><volume>84</volume><fpage>82</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">3257353</pub-id><pub-id pub-id-type="doi">10.1016/0002-9343(88)90012-5</pub-id></citation></ref></ref-list></back></article>