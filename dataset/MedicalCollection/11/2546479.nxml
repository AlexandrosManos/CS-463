names></name><etal/></person-group><article-title>The health-related quality of life and economic burden of constipation</article-title><source>Pharmacoeconomics</source><year>2005</year><volume>23</volume><fpage>461</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15896098</pub-id></citation></ref><ref id="b9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>DiPalma</surname><given-names>JA</given-names></name><name><surname>Cleveland</surname><given-names>MV</given-names></name><name><surname>McGowan</surname><given-names>J</given-names></name><etal/></person-group><article-title>A randomized, multicenter, placebo-controlled trial of polyethylene glycol laxative for chronic treatment of chronic constipation</article-title><source>Am J Gastroenterol</source><year>2007</year><volume>102</volume><fpage>1436</fpage><lpage>41</lpage><pub-id pub-id-type="pmid">17403074</pub-id></citation></ref><ref id="b10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Drossman</surname><given-names>DA</given-names></name><name><surname>Chey</surname><given-names>WD</given-names></name><name><surname>Panas</surname><given-names>R</given-names></name><etal/></person-group><article-title>Lubiprostone significantly improves symptom relief rates in adults with irritable bowel syndrome and constipation (IBS-C): data from two, twelve-week, randomized, placebo-controlled, double blind trials</article-title><source>Gastroenterol</source><year>2007</year><volume>132</volume><fpage>2586</fpage><lpage>7</lpage></citation></ref><ref id="b11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grider</surname><given-names>JR</given-names></name><name><surname>Jin</surname><given-names>JG</given-names></name></person-group><article-title>Distinct populations of sensory neurons mediate the peristaltic reflex elicited by muscle stretch and mucosal stimulation</article-title><source>J Neurosci</source><year>1994</year><volume>14</volume><fpage>2854</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">7514213</pub-id></citation></ref><ref id="b12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Higgins</surname><given-names>PDR</given-names></name><name><surname>Johanson</surname><given-names>JF</given-names></name></person-group><article-title>Epidemiology of chronic constipation in North America: A systematic review</article-title><source>Am J Gastroenterol</source><year>2004</year><volume>99</volume><fpage>750</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">15089911</pub-id></citation></ref><ref id="b13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Irvine</surname><given-names>EJ</given-names></name><name><surname>Ferrazzi</surname><given-names>S</given-names></name><name><surname>Pare</surname><given-names>P</given-names></name><etal/></person-group><article-title>Health-related quality of life in functional GI disorders: focus on constipation and resource utilization</article-title><source>Am J Gastroenterol</source><year>2002</year><volume>97</volume><fpage>1986</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">12190165</pub-id></citation></ref><ref id="b14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johanson</surname><given-names>JF</given-names></name><name><surname>Gargano</surname><given-names>MA</given-names></name><name><surname>Holland</surname><given-names>PC</given-names></name><etal/></person-group><article-title>Phase III, randomized withdrawal study of RU-0211, a novel chloride channel activator for the treatment of constipation</article-title><source>Gastroenterol</source><year>2004</year><volume>126</volume><fpage>A298</fpage><comment>Abstract 749</comment></citation></ref><ref id="b15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johanson</surname><given-names>JF</given-names></name><name><surname>Gargano</surname><given-names>MA</given-names></name><name><surname>Holland</surname><given-names>PC</given-names></name><etal/></person-group><article-title>Initial and sustained effects of lubiprostone, a chloride channel-2 (ClC-2) activator for the treatment of constipation: data from a 4-week Phase III study</article-title><source>Am J Gastroenterol</source><year>2005a</year><volume>100</volume><fpage>A884</fpage></citation></ref><ref id="b16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johanson</surname><given-names>JF</given-names></name><name><surname>Gargano</surname><given-names>MA</given-names></name><name><surname>Holland</surname><given-names>PC</given-names></name><etal/></person-group><article-title>Phase III study of lubiprostone, a chloride channel-2 (ClC-2) activator for the treatment of constipation: safety and primacy efficacy</article-title><source>Am J Gastroenterol</source><year>2005b</year><volume>100</volume><fpage>A896</fpage></citation></ref><ref id="b17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johanson</surname><given-names>JF</given-names></name><name><surname>Morton</surname><given-names>D</given-names></name><name><surname>Geenan</surname><given-names>J</given-names></name><etal/></person-group><article-title>Multicenter, 4-week, double-blind, randomized, placebo-controlled trial of lubiprostone, a locally-acting type-2 chloride channel activator, in patients with chronic constipation</article-title><source>Am J Gastroenterol</source><year>2008</year><volume>103</volume><fpage>170</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">17916109</pub-id></citation></ref><ref id="b18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johanson</surname><given-names>JF</given-names></name><name><surname>Panas</surname><given-names>R</given-names></name><name><surname>Holland</surname><given-names>PC</given-names></name><etal/></person-group><article-title>Long-term efficacy of lubiprostone for the treatment of chronic constipation</article-title><source>Gastroenterol</source><year>2006a</year><volume>130</volume><fpage>A317</fpage></citation></ref><ref id="b19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johanson</surname><given-names>JF</given-names></name><name><surname>Panas</surname><given-names>R</given-names></name><name><surname>Holland</surname><given-names>PC</given-names></name><etal/></person-group><article-title>A dose-ranging, double-blind, placebo-controlled study of lubiprostone in subjects with irritable bowel syndrome and constipation (IBS-C)</article-title><source>Gastroenterol</source><year>2006b</year><volume>130</volume><fpage>A25</fpage></citation></ref><ref id="b20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johanson</surname><given-names>JF</given-names></name><name><surname>Ueno</surname><given-names>R</given-names></name></person-group><article-title>Lubiprostone, a locally acting chloride channel activator, in adult patients with chronic constipation: a double-blind, placebo-controlled, dose-ranging study to evaluate efficacy and safety</article-title><source>Aliment Pharmacol Ther</source><year>2007</year><volume>25</volume><fpage>1351</fpage><lpage>61</lpage><pub-id pub-id-type="pmid">17509103</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lacy</surname><given-names>BE</given-names></name><name><surname>Cole</surname><given-names>MS</given-names></name></person-group><article-title>Constipation in the older adult</article-title><source>Clinical Geriatr</source><year>2004</year><volume>12</volume><fpage>44</fpage><lpage>54</lpage></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-ty