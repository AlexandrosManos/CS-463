 id="b10-ehp-116-1396"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Choi</surname><given-names>H</given-names></name><name><surname>Jedrychowski</surname><given-names>W</given-names></name><name><surname>Spengler</surname><given-names>J</given-names></name><name><surname>Camann</surname><given-names>DE</given-names></name><name><surname>Whyatt</surname><given-names>RM</given-names></name><name><surname>Rauh</surname><given-names>V</given-names></name><etal/></person-group><year>2006</year><article-title>International studies of prenatal exposure to polycyclic aromatic hydrocarbons and fetal growth</article-title><source>Environ Health Perspect</source><volume>114</volume><fpage>1744</fpage><lpage>1750</lpage><pub-id pub-id-type="pmid">17107862</pub-id></citation></ref><ref id="b11-ehp-116-1396"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chow</surname><given-names>JC</given-names></name><name><surname>Watson</surname><given-names>JG</given-names></name><name><surname>Chen</surname><given-names>LW</given-names></name><name><surname>Koracin</surname><given-names>D</given-names></name><name><surname>Zielenska</surname><given-names>B</given-names></name><name><surname>Tang</surname><given-names>D</given-names></name><etal/></person-group><year>2006</year><article-title>Exposure to PM<sub>2.5</sub> and PAHs from the Tongliang, China, epidemiological study</article-title><source>J Environ Sci Health A Tox Hazard Subst Environ Eng</source><volume>41</volume><fpage>517</fpage><lpage>542</lpage><pub-id pub-id-type="pmid">16779929</pub-id></citation></ref><ref id="b12-ehp-116-1396"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cui</surname><given-names>H</given-names></name><name><surname>Hou</surname><given-names>J</given-names></name><name><surname>Ma</surname><given-names>G</given-names></name></person-group><year>2001</year><article-title>Influences of rearing style on the intellectual development of infants [in Chinese]</article-title><source>Wei sheng yan jiu</source><volume>30</volume><fpage>362</fpage><lpage>364</lpage><pub-id pub-id-type="pmid">12561622</pub-id></citation></ref><ref id="b13-ehp-116-1396"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Drillien</surname><given-names>CM</given-names></name><name><surname>Pickering</surname><given-names>RM</given-names></name><name><surname>Drummond</surname><given-names>MB</given-names></name></person-group><year>1988</year><article-title>Predictive value of screening for different areas of development</article-title><source>Dev Med Child Neurol</source><volume>30</volume><fpage>294</fpage><lpage>305</lpage><pub-id pub-id-type="pmid">2456962</pub-id></citation></ref><ref id="b14-ehp-116-1396"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Economy</surname><given-names>EC</given-names></name></person-group><year>2003</year><source>China&#x02019;s Environmental Challenge: Political, Social, and Economic Implications</source><publisher-loc>New York</publisher-loc><publisher-name>Council on Foreign Relations</publisher-name></citation></ref><ref id="b15-ehp-116-1396"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guo</surname><given-names>R</given-names></name><name><surname>Yang</surname><given-names>J</given-names></name><name><surname>Liu</surname><given-names>D</given-names></name><name><surname>Liu</surname><given-names>Z</given-names></name></person-group><year>2002</year><article-title>Transformation behavior of trace elements during coal pyrolysis</article-title><source>Fuel Process Technol</source><volume>77&#x02013;78</volume><fpage>137</fpage><lpage>143</lpage></citation></ref><ref id="b16-ehp-116-1396"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hudon</surname><given-name