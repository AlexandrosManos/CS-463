e="simple" xlink:href="http://dis.embl.de/">http://dis.embl.de/</uri></td><td align="center" rowspan="1" colspan="1">[<xref ref-type="bibr" rid="R7">7</xref>]</td></tr><tr><td align="center" rowspan="1" colspan="1">DISOPRED</td><td align="center" rowspan="1" colspan="1"><uri xlink:type="simple" xlink:href="http://bioinf.cs.ucl.ac.uk/disopred/">http://bioinf.cs.ucl.ac.uk/disopred/</uri></td><td align="center" rowspan="1" colspan="1">[<xref ref-type="bibr" rid="R19">19</xref>]</td></tr><tr><td align="center" rowspan="1" colspan="1">DRIPRED</td><td align="center" rowspan="1" colspan="1"><uri xlink:type="simple" xlink:href="http://www.sbc.su.se/~maccallr/disorder/">http://www.sbc.su.se/~maccallr/disorder/</uri></td><td align="center" rowspan="1" colspan="1">[<xref ref-type="bibr" rid="R20">20</xref>]</td></tr><tr><td align="center" rowspan="1" colspan="1">FOLDINDEX</td><td align="center" rowspan="1" colspan="1"><uri xlink:type="simple" xlink:href="http://bip.weizmann.ac.il/fldbin/findex">http://bip.weizmann.ac.il/fldbin/findex</uri></td><td align="center" rowspan="1" colspan="1">[<xref ref-type="bibr" rid="R21">21</xref>]</td></tr><tr><td align="center" rowspan="1" colspan="1">GLOBPLOT_B</td><td align="center" rowspan="1" colspan="1"><uri xlink:type="simple" xlink:href="http://globplot.embl.de/">http://globplot.embl.de/</uri></td><td align="center" rowspan="1" colspan="1">[<xref ref-type="bibr" rid="R22">22</xref>]</td></tr><tr><td align="center" rowspan="1" colspan="1">GLOBPLOT_r</td><td align="center" rowspan="1" colspan="1"><uri xlink:type="simple" xlink:href="http://globplot.embl.de/">http://globplot.embl.de/</uri></td><td align="center" rowspan="1" colspan="1">[<xref ref-type="bibr" rid="R22">22</xref>]</td></tr><tr><td align="center" rowspan="1" colspan="1">IUPRED_L</td><td align="center" rowspan="1" colspan="1"><uri xlink:type="simple" xlink:href="http://iupred.enzim.hu/">http://iupred.enzim.hu/</uri></td><td align="center" rowspan="1" colspan="1">[<xref ref-type