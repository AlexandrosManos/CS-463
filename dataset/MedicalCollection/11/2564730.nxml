>0</td><td align="center" valign="top" charoff="50">16</td><td align="left" valign="top" charoff="50">Low significance prediction</td></tr><tr><td align="left" valign="top" charoff="50">G1 arrest</td><td align="center" valign="top" charoff="50"><inline-graphic id="illus17" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="msb200853-i17.jpg"/></td><td align="left" valign="top" charoff="50">p-ERK</td><td align="char" valign="top" char="." charoff="50">&#x02212;0.09</td><td align="char" valign="top" char="." charoff="50">(&#x02212;0.16, &#x02212;0.01)</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">15</td><td align="left" valign="top" charoff="50">Low significance prediction</td></tr><tr><td align="left" valign="top" charoff="50">mTOR</td><td align="center" valign="top" charoff="50"><inline-graphic id="illus18" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="msb200853-i18.jpg"/></td><td align="left" valign="top" charoff="50">Apoptosis</td><td align="char" valign="top" char="." charoff="50">&#x02212;0.07</td><td align="char" valign="top" char="." charoff="50">(&#x02212;0.12, &#x02212;0.02)</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">12</td><td align="left" valign="top" charoff="50">Low significance prediction</td></tr><tr><td align="left" valign="top" charoff="50">MEK</td><td align="center" valign="top" charoff="50"><inline-graphic id="illus19" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="msb200853-i19.jpg"/></td><td align="left" valign="top" charoff="50">MEK</td><td align="char" valign="top" char="." charoff="50">&#x02212;0.13</td><td align="char" valign="top" char="." charoff="50">(&#x02212;0.21, &#x02212;0.07)</td><td align="center" valign="top" charoff="50">0</td><td align="center" valign="top" charoff="50">8</td><td align="left" valign="top" charoff="50">Low significance prediction</td></tr><tr><td align="left" valign="top" charoff="50">EGFR</td><td align="center" valign="top" charoff="50"><inline-graphic id="illus20" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="msb200853-i20.jpg"/></td><td align="left" valign="top" charoff="50">p-RAF</td><td align="char" valign="top" char="." charoff="50">&#x02212;0.03</td><td align="char" valign="top" char="." charoff="50">(&#x02212;0.11, &#x02212;0.04)</td><td align="center" valign="top" charoff="50">6</td><td align="center" valign="top" charoff="50">2</td><td align="left" valign="top" charoff="50">Low significance prediction</td></tr></tbody></table><table-wrap-foot><fn id="t1-fn1"><p>Statistical assessment of inferred molecular interactions as shown in <xref ref-type="fig" rid="f3">Figure 3</xref>. Column &#x02018;Mean <italic>W</italic><sub>ij</sub>' shows the average interaction strength between the target and the regulator, as obtained from 200 bootstrapping simulations (see <xref ref-type="supplementary-material" rid="S1">Supplementary information</xref>). 90&#x00025; confidence intervals (CI) for the interaction strength are shown. The left column of posterior probabilities shows the fraction of models with a positive regulation in the Monte Carlo simulation. The right column shows the fraction of models with negative regulation (for instance, inhibition of apoptosis by p-AKT was present in 77&#x00025; of models). The names p-P70S6K and p-p70S6K are synonymous.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>