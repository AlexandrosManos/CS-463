Apoptosis</td><td align="char" valign="top" char="." charoff="50">&#x02212;0.39</td><td align="char" valign="top" char="." charoff="50">(&#x02212;0.43, &#x02212;0.36)</td><td align="center" valign="top" charoff="50">0</td><td align="center" valign="top" charoff="50"><bold>77</bold></td><td align="left" valign="top" charoff="50"><bold>AKT controls survival in MCF7 cells</bold></td></tr><tr><td align="left" valign="top" charoff="50">PKC-&#x003b4;</td><td align="center" valign="top" charoff="50"><inline-graphic id="illus11" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="msb200853-i11.jpg"/></td><td align="left" valign="top" charoff="50">G1 arrest</td><td align="char" valign="top" char="." charoff="50">&#x02212;0.12</td><td align="char" valign="top" char="." charoff="50">(&#x02212;0.20, &#x02212;0.06)</td><td align="center" valign="top" charoff="50">0</td><td align="center" valign="top" charoff="50"><bold>41</bold></td><td align="left" valign="top" charoff="50"><bold>Prediction</bold></td></tr><tr><td align="left" valign="top" charoff="50">p-ERK</td><td align="center" valign="top" charoff="50"><inline-graphic id="illus12" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="msb200853-i12.jpg"/></td><td align="left" valign="top" charoff="50">EGFR</td><td align="char" valign="top" char="." charoff="50">&#x02212;0.28</td><td align="char" valign="top" char="." charoff="50">(&#x02212;0.42, &#x02212;0.17)</td><td align="center" valign="top" charoff="50">0</td><td align="center" valign="top" charoff="50"><bold>36</bold></td><td align="left" valign="top" charoff="50"><bold>MAPK negative feedback loop</bold></td></tr><tr><td align="left" valign="top" charoff="50">G1 arrest</td><td align="center" valign="top" charoff="50"><inline-graphic id="illus13" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="msb200853-i13.jpg"/></td><td align="left" valign="top" charoff="50">p-eIF4E</td><td align="char" valign="top" char="." charoff="50">&#x02212;0.33</td><td align="char" v