>50</volume><fpage>485</fpage><lpage>524</lpage><pub-id pub-id-type="pmid">11618378</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Botting</surname><given-names>B</given-names></name><name><surname>Dunnell</surname><given-names>K</given-names></name></person-group><article-title>Trends in fertility and contraception in the last quarter of the 20th century</article-title><source>Popul Trends</source><year>2000</year><fpage>32</fpage><lpage>39</lpage><pub-id pub-id-type="pmid">10909103</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maher</surname><given-names>J</given-names></name><name><surname>Macfarlane</surname><given-names>A</given-names></name></person-group><article-title>Trends in live births and birthweight by social class, marital status and mother's age, 1976-2000</article-title><source>Health Stat Q</source><year>2004</year><volume>23</volume><fpage>34</fpage><lpage>42</lpage><ext-link ext-link-type="uri" xlink:href="http://www.statistics.gov.uk/downloads/theme_health/HSQ23.pdf#page=36"/><pub-id pub-id-type="pmid">15704383</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Breart</surname><given-names>G</given-names></name></person-group><article-title>Delayed childbearing</article-title><source>Eur J Obstet Gynecol Reprod Biol</source><year>1997</year><volume>75</volume><fpage>71</fpage><lpage>73</lpage><pub-id pub-id-type="pmid">9447350</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guyer</surname><given-names>B</given-names></name><name><surname>Hoyert</surname><given-names>DL</given-names></name><name><surname>Martin</surname><given-names>JA</given-names></name><name><surname>Ventura</surname><given-names>SJ</given-names></name><name>