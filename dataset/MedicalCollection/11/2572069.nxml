/fpage><lpage>689</lpage><pub-id pub-id-type="pmid">12185045</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reeves</surname><given-names>ME</given-names></name></person-group><article-title>Lactating adenoma presenting as a giant breast mass</article-title><source>Surgery</source><year>2000</year><volume>127</volume><fpage>586</fpage><lpage>588</lpage><pub-id pub-id-type="pmid">10819069</pub-id><pub-id pub-id-type="doi">10.1067/msy.2000.102603</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Neuenschwander</surname><given-names>S</given-names></name><name><surname>Schwartz</surname><given-names>A</given-names></name><name><surname>Teresa</surname><given-names>L</given-names></name></person-group><article-title>Involution of the lactating mammary gland is inhibited by the IGF system in a transgenic mouse model</article-title><source>J Clin Invest</source><year>1996</year><volume>97</volume><fpage>2225</fpage><lpage>2232</lpage><pub-id pub-id-type="pmid">8636401</pub-id><pub-id pub-id-type="doi">10.1172/JCI118663</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ackler</surname><given-names>S</given-names></name><name><surname>Ahmad</surname><given-names>S</given-names></name><name><surname>Tobias</surname><given-names>C</given-names></name><name><surname>Johnson</surname><given-names>MD</given-names></name><name><surname>Glazer</surname><given-names>RI</given-names></name></person-group><article-title>Delayed mammary gland involution in MMTV-AKT1 transgenic mice</article-title><source>Oncogene</source><year>2002</year><volume>21</volume><fpage>198</fpage><lpage>206</lpage><pub-id pub-id-type="pmid">11803463</pub-id><pub-id pub-id-type="doi">10.1038/sj.onc.1205052</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"