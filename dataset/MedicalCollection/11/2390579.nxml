/source><year>2004</year><volume>63</volume><fpage>1102</fpage><lpage>1104</lpage><pub-id pub-id-type="pmid">15452310</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kalay</surname><given-names>N</given-names></name><name><surname>Ozdogru</surname><given-names>I</given-names></name><name><surname>Cetinkaya</surname><given-names>Y</given-names></name><name><surname>Eryol</surname><given-names>NK</given-names></name><name><surname>Dogan</surname><given-names>A</given-names></name><name><surname>Gul</surname><given-names>I</given-names></name><name><surname>Inanc</surname><given-names>T</given-names></name><name><surname>Ikizceli</surname><given-names>I</given-names></name><name><surname>Oguzhan</surname><given-names>A</given-names></name><name><surname>Abaci</surname><given-names>A</given-names></name></person-group><article-title>Cardiovascular effects of carbon monoxide poisoning</article-title><source>Am J Cardiol</source><year>2007</year><volume>99</volume><fpage>322</fpage><lpage>324</lpage><pub-id pub-id-type="pmid">17261390</pub-id><pub-id pub-id-type="doi">10.1016/j.amjcard.2006.08.030</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wolff</surname><given-names>E</given-names></name></person-group><article-title>Carbon monoxide poisoning with severe myonecrosis and acute renal failure</article-title><source>Am J Emerg Med</source><year>1994</year><volume>12</volume><fpage>347</fpage><lpage>349</lpage><pub-id pub-id-type="pmid">8179748</pub-id><pub-id pub-id-type="doi">10.1016/0735-6757(94)90157-0</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Prockop</surname><given-names>LD</given-names></name></person-group><article-title>Carbon monoxide brain toxicity: clinical, magnetic resonance imaging, magnetic resonance spectroscopy, and neuropsychological effects in 9 people</article-title><source>J Neuroimaging</source><year>2005</year><volume>15</volume><fpage>144</fpage><lpage>149</lpage><pub-id pub-id-type="pmid">15746226</pub-id><pub-id pub-id-type="doi">10.1177/1051228404273819</pub-id></citation></ref></ref-list></back></article>