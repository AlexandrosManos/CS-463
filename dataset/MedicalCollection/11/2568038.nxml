;1)</td><td align="char" char="(" rowspan="1" colspan="1">10288&#x02013;11422 (&#x02212;1)</td><td align="char" char="(" rowspan="1" colspan="1">10478&#x02013;11615 (&#x02212;1)</td></tr><tr><td rowspan="1" colspan="1">tRNA-S</td><td align="center" rowspan="1" colspan="1">+</td><td rowspan="1" colspan="1">UGA</td><td align="char" char="(" rowspan="1" colspan="1">11409&#x02013;11474 (0)</td><td align="char" char="(" rowspan="1" colspan="1">11591&#x02013;11657 (0)</td><td align="char" char="(" rowspan="1" colspan="1">11491&#x02013;11557 (0)</td><td align="char" char="(" rowspan="1" colspan="1">11627&#x02013;11693 (0)</td><td align="char" char="(" rowspan="1" colspan="1">11423&#x02013;11489 (0)</td><td align="char" char="(" rowspan="1" colspan="1">11616&#x02013;11683 (0)</td></tr><tr><td rowspan="1" colspan="1"><italic>nad1</italic></td><td align="center" rowspan="1" colspan="1">&#x02212;</td><td rowspan="1" colspan="1"/><td align="char" char="(" rowspan="1" colspan="1">11493&#x02013;12440 (18)</td><td align="char" char="(" rowspan="1" colspan="1">11676&#x02013;12626 (18)</td><td align="char" char="(" rowspan="1" colspan="1">11580&#x02013;12530 (22)</td><td align="char" char="(" rowspan="1" colspan="1">11712&#x02013;12662 (18)</td><td align="char" char="(" rowspan="1" colspan="1">11507&#x02013;12460 (17)</td><td align="char" char="(" rowspan="1" colspan="1">11701&#x02013;12651 (17)</td></tr><tr><td rowspan="1" colspan="1">tRNA-L</td><td align="center" rowspan="1" colspan="1">&#x02212;</td><td rowspan="1" colspan="1">UAG</td><td align="char" char="(" rowspan="1" colspan="1">12442&#x02013;12506 (1)</td><td align="char" char="(" rowspan="1" colspan="1">12628&#x02013;12691 (1)</td><td align="char" char="(" rowspan="1" colspan="1">12532&#x02013;12594 (1)</td><td align="char" char="(" rowspan="1" colspan="1">12664&#x02013;12728 (1)</td><td align="char" char="(" rowspan="1" colspan="1">12462&#x02013;12523 (1)</td><td align="char" char="(" rowspan="1" colspan="1">12653&#x02013