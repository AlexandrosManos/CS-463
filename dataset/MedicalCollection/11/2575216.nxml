n-names>RA</given-names></name></person-group><article-title>Colorectal cancer screening. Knowledge and practices among Korean Americans</article-title><source>Cancer Practice</source><year>1998</year><volume>6</volume><fpage>167</fpage><lpage>75</lpage><pub-id pub-id-type="pmid">9652248</pub-id><pub-id pub-id-type="doi">10.1046/j.1523-5394.1998.006003167.x</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tang</surname><given-names>TS</given-names></name><name><surname>Solomon</surname><given-names>LJ</given-names></name><name><surname>McCracken</surname><given-names>LM</given-names></name></person-group><article-title>Barriers to fecal occult blood testing and sigmoidoscopy among older Chinese-American women</article-title><source>Cancer Practice</source><year>2001</year><volume>9</volume><fpage>277</fpage><lpage>82</lpage><pub-id pub-id-type="pmid">11879329</pub-id><pub-id pub-id-type="doi">10.1046/j.1523-5394.2001.96008.x</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yu</surname><given-names>ESH</given-names></name><name><surname>Kim</surname><given-names>KK</given-names></name><name><surname>Chen</surname><given-names>EH</given-names></name><name><surname>Brintnall</surname><given-names>RA</given-names></name><name><surname>Liu</surname><given-names>WT</given-names></name></person-group><article-title>Colorectal cancer screening among Chinese Americans: a community-based study of knowledge and practice</article-title><source>Journal of Psychosocial Oncology</source><year>2001</year><volume>19</volume><fpage>97</fpage><lpage>112</lpage><pub-id pub-id-type="doi">10.1300/J077v19n03_08</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lindholm</surname><given-names>E</given-names></name><name><surname>Berglund</surname><given-na