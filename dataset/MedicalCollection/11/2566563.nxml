normality</article-title><source>Clin Lab Haematol</source><year>2003</year><volume>25</volume><fpage>187</fpage><lpage>190</lpage><pub-id pub-id-type="pmid">12755797</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2257.2003.00511.x</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stone</surname><given-names>MJ</given-names></name></person-group><article-title>Myeloma and macroglobulinaemia: what are the criteria for diagnosis?</article-title><source>Clin Lymphoma</source><year>2002</year><volume>3</volume><fpage>23</fpage><lpage>25</lpage><pub-id pub-id-type="pmid">12141951</pub-id><pub-id pub-id-type="doi">10.3816/CALM2002.n.007</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dierlamm</surname><given-names>T</given-names></name><name><surname>Laack</surname><given-names>E</given-names></name><name><surname>Dierlamm</surname><given-names>J</given-names></name><name><surname>Fiedler</surname><given-names>W</given-names></name><name><surname>Hossfeld</surname><given-names>DK</given-names></name></person-group><article-title>IgM myeloma: a report of four cases</article-title><source>Ann Hematol</source><year>2002</year><volume>81</volume><fpage>136</fpage><lpage>139</lpage><pub-id pub-id-type="pmid">11904738</pub-id><pub-id pub-id-type="doi">10.1007/s00277-001-0420-9</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Annibali</surname><given-names>O</given-names></name><name><surname>Petrucci</surname><given-names>MT</given-names></name><name><surname>Del Bianco</surname><given-names>P</given-names></name><name><surname>Gallucci</surname><given-names>C</given-names></name><name><surname>Levi</surname><given-names>A</given-names></name><name><surname>Foa</surname><given-names>R</given-names></name><name><surname>Avvisati</surname><given-names>G</given-names></name></person-group><article-title>IgM multiple myeloma: report of four cases and review of the literature</article-title><source>Leuk Lymphoma</source><year>2006</year><volume>47</volume><fpage>1565</fpage><lpage>1569</lpage><pub-id pub-id-type="pmid">16966268</pub-id><pub-id pub-id-type="doi">10.1080/10428190600604450</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Masanes</surname><given-names>F</given-names></name><name><surname>Pedrol</surname><given-names>F</given-names></name><name><surname>Blade</surname><given-names>J</given-names></name><name><surname>Casademont</surname><given-names>J</given-names></name><name><surname>de la Sierra</surname><given-names>A</given-names></name><name><surname>Martinez-Orozco</surname><given-names>F</given-names></name><name><surname>Grau</surname><given-names>JM</given-names></name><name><surname>Ingelmo</surname><given-names>M</given-names></name></person-group><article-title>IgM myeloma: a report of 2 cases</article-title><source>Med Clin (Barc)</source><year>1991</year><volume>96</volume><fpage>777</fpage><lpage>779</lpage><pub-id pub-id-type="pmid">1908542</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Gramont</surname><given-names>A</given-names></name><name><surname>Grosbois</surname><given-names>B</given-names></name><name><surname>Michaux</surname><given-names>JL</given-names></name><name><surname>Peny</surname><given-names>AM</given-names></name><name><surname>Pollet</surname><given-names>JP</given-names></name><name><surname>Smadja</surname><given-names>N</given-names></name><name><surname>Krulik</surname><given-names>M</given-names></name><name><surname>Debray</surname><given-names>J</given-names></name><name><surname>Bernard</surname><given-names>JF</given-names></name><name><surname>Monoconduit</surname><given-names>M</given-names></name></person-group><article-title>IgM myeloma: 6 cases and a review of the literature</article-title><source>Rev Med Interne</source><year>1990</year><volume>11</volume><fpage>13</fpage><lpage>18</lpage><pub-id pub-id-type="pmid">2109345</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Konduri</surname><given-names>K</given-names></name><name><surname>Sahota</surname><given-names>SS</given-names></name><name><surname>Babbage</surname><given-names>G</given-names></name><name><surname>Tong</surname><given-names>AW</given-names></name><name><surname>Kumar</surname><given-names>P</given-names></name><name><surname>Newman</surname><given-names>JT</given-names></name><name><surname>Stone</surname><given-names>MJ</given-names></name></person-group><article-title>Immunoglobulin M myeloma: evaluation of molecular features and cytokine expression</article-title><source>Clin Lymphoma</source><year>2005</year><volume>5</volume><fpage>285</fpage><lpage>289</lpage><pub-id pub-id-type="pmid">15794867</pub-id><pub-id pub-id-type="doi">10.3816/CLM.2005.n.018</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Feyler</surname><given-names>S</given-names></name><name><surname>O'Connor</surname><given-names>SJ</given-names></name><name><surname>Rawstron</surname><given-names>AC</given-names></name><name><surname>Subash</surname><given-names>C</given-names></name><name><surname>Ross</surname><given-names>FM</given-names></name><name><surname>Pratt</surname><given-names>G</given-names></name><name><surname>Drayson</surname><given-names>MT</given-names></name><name><surname>Ashcroft</surname><given-names>J</given-names></name><name><surname>Cook</surname><given-names>G</given-names></name><name><surname>Owen</surname><given-names>RG</given-names></name></person-group><article-title>IgM myeloma a rare entity characterized by a CD20-CD56-CD117-immunophenotypes and the t(11;14)</article-title><source>Br J Haematol</source><year>2008</year><volume>140</volume><fpage>547</fpage><lpage>551</lpage><pub-id pub-id-type="pmid">18275432</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2141.2007.06969.x</pub-id></citation></ref></ref-list></back></article>