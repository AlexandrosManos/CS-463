me><given-names>M</given-names></name><name><surname>Pol</surname><given-names>S</given-names></name><name><surname>Brechot</surname><given-names>C</given-names></name><name><surname>Paranhos-Baccala</surname><given-names>G</given-names></name><name><surname>Lotteau</surname><given-names>V</given-names></name></person-group><article-title>Characterization of low- and very-low-density hepatitis C virus RNA-containing particles</article-title><source>J Virol</source><year>2002</year><volume>76</volume><fpage>6919</fpage><lpage>6928</lpage><pub-id pub-id-type="pmid">12072493</pub-id><pub-id pub-id-type="doi">10.1128/JVI.76.14.6919-6928.2002</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hino</surname><given-names>K</given-names></name><name><surname>Fujii</surname><given-names>K</given-names></name><name><surname>Korenaga</surname><given-names>M</given-names></name><name><surname>Murakami</surname><given-names>C</given-names></name><name><surname>Okazaki</surname><given-names>M</given-names></name><name><surname>Okuda</surname><given-names>M</given-names></name><name><surname>Okita</surname><given-names>K</given-names></name></person-group><article-title>Correlation between relative number of circulating low-density hepatitis C virus particles and disease activity in patients with chronic hepatitis C</article-title><source>Dig Dis Sci</source><year>1997</year><volume>42</volume><fpage>2476</fpage><lpage>2481</lpage><pub-id pub-id-type="pmid">9440623</pub-id><pub-id pub-id-type="doi">10.1023/A:1018800225815</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shimizu</surname><given-names>YK</given-names></name><name><surname>Hijikata</surname><given-names>M</given-names></name><name><surname>Iwamoto</surname><given-names>A</given-names></name><name><surname>Alter</surname><given-names>HJ</given-names></name><name>