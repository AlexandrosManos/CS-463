source><volume>33</volume><fpage>73</fpage><lpage>80</lpage></citation></ref><ref id="pcbi.1000204-Lawrence1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lawrence</surname><given-names>S</given-names></name></person-group><year>2001</year><article-title>Free online availability substantially increases a paper's impact.</article-title><source>Nature</source><volume>411</volume><fpage>521</fpage><pub-id pub-id-type="pmid">11385534</pub-id></citation></ref><ref id="pcbi.1000204-Eysenbach1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eysenbach</surname><given-names>G</given-names></name></person-group><year>2006</year><article-title>Citation advantage of open access articles.</article-title><source>PLoS Biol</source><volume>4</volume><fpage>e157. doi:10.1371/journal.pbio.0040157</fpage><pub-id pub-id-type="pmid">16683865</pub-id></citation></ref><ref id="pcbi.1000204-MacCallum2"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>MacCallum</surname><given-names>CJ</given-names></name><name><surname>Parthasarathy</surname><given-names>H</given-names></name></person-group><year>2006</year><article-title>Open access increases citation rate.</article-title><source>PLoS Biol</source><volume>4</volume><fpage>e176. doi:10.1371/journal.pbio.0040176</fpage><pub-id pub-id-type="pmid">16683866</pub-id></citation></ref><ref id="pcbi.1000204-Cohen1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cohen</surname><given-names>B</given-names></name></person-group><year>2004</year><article-title>PLoS Biology in action.</article-title><source>PLoS Biol</source><volume>2</volume><fpage>E25. doi:10.1371/journal.pbio.0020025</fpage><pub-id pub-id-type="pmid">14737199</pub-id></citation></ref><ref id="pcbi.1000204-BernersLee1"><label>25</label><citation ci