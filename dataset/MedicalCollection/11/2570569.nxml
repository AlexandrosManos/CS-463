easured <italic>in vivo.</italic></p></caption><graphic xlink:href="TOCMJ-1-15_F4"/></fig><table-wrap id="T1" position="float"><label>Table 1</label><caption><p>Subject Characteristics</p></caption><table frame="border" rules="all" width="50%"><thead><tr><th align="center" rowspan="1" colspan="1">Characteristic</th><th align="center" rowspan="1" colspan="1">Control</th><th align="center" rowspan="1" colspan="1">Normal</th><th align="center" rowspan="1" colspan="1">Varicose Veins</th></tr></thead><tbody><tr><td align="center" rowspan="1" colspan="1">Subject &#x00026; Limb numbers</td><td align="center" rowspan="1" colspan="1">12</td><td align="center" rowspan="1" colspan="1">10</td><td align="center" rowspan="1" colspan="1">12</td></tr><tr><td align="center" rowspan="1" colspan="1">Age (mean&#x000b1;SD, years)</td><td align="center" rowspan="1" colspan="1">50.2&#x000b1;8.3</td><td align="center" rowspan="1" colspan="1">38.7&#x000b1;7.7</td><td align="center" rowspan="1" colspan="1">41.4&#x000b1;8.5</td></tr><tr><td align="center" rowspan="1" colspan="1">Sex (Number, M/F)</td><td align="center" rowspan="1" colspan="1">6/6</td><td align="center" rowspan="1" colspan="1">5/5</td><td align="center" rowspan="1" colspan="1">6/6</td></tr><tr><td align="center" rowspan="1" colspan="1">Body Mass Index (mean&#x000b1;SD, kg/m<sup>2</sup>)</td><td align="center" rowspan="1" colspan="1">29.9&#x000b1;4.5</td><td align="center" rowspan="1" colspan="1">28.1&#x000b1;1.8</td><td align="center" rowspan="1" colspan="1">27.1&#x000b1;4.5</td></tr></tbody></table></table-wrap><table-wrap id="T2" position="float"><label>Table 2</label><caption><p>Subject Medical Conditions and Medications</p></caption><table frame="border" rules="all" width="50%"><thead><tr><th align="center" rowspan="1" colspan="1">Characteristic</th><th align="center" rowspan="1" colspan="1">Control Veins (N)</th><th align="center" rowspan="1" colspan="1">Varicose Veins (N)</th></tr></thead><tbody><tr><td align="left" rows