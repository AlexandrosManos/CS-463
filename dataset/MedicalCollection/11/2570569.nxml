ce>Pharmacol Rep</source><year>2005</year><volume>57</volume><fpage>113</fpage><lpage>130</lpage><pub-id pub-id-type="pmid">15849385</pub-id></citation></ref><ref id="R22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Renno</surname><given-names>WM</given-names></name><name><surname>Saleh</surname><given-names>F</given-names></name><name><surname>Wali</surname><given-names>M</given-names></name></person-group><article-title>A Journey across the Wall of Varicose Veins. What Physicians Do Not Often See with the Naked Eye</article-title><source>Med Princ Pract</source><year>2006</year><volume>15</volume><fpage>9</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">16340222</pub-id></citation></ref><ref id="R23"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bassenge</surname><given-names>E</given-names></name></person-group><article-title>Endothelial function in different organs</article-title><source>Prog Cardiovasc Dis</source><year>1996</year><volume>39</volume><fpage>209</fpage><lpage>228</lpage><pub-id pub-id-type="pmid">8970574</pub-id></citation></ref><ref id="R24"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Takase</surname><given-names>S</given-names></name><name><surname>Bergan</surname><given-names>JJ</given-names></name><name><surname>Schmid-Schoubein</surname><given-names>G</given-names></name></person-group><article-title>Expression of adhesion molecules and cytokines on saphenous veins in chronic venous insufficiency</article-title><source>Ann Vasc Surg</source><year>2000</year><volume>14</volume><fpage>427</fpage><lpage>435</lpage><pub-id pub-id-type="pmid">10990550</pub-id></citation></ref><ref id="R25"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shebuski</surname><given-names>RJ</given-names></name><name><surnam