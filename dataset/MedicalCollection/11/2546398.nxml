ion-type="journal"><person-group person-group-type="author"><name><surname>Kandel</surname><given-names>ER</given-names></name></person-group><article-title>Genes, nerve cells, and the remembrance of things past</article-title><source>J Neuropsychiatry Clin Neurosci</source><year>1989</year><volume>1</volume><fpage>103</fpage><lpage>125</lpage><pub-id pub-id-type="pmid">2562494</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kandel</surname><given-names>ER</given-names></name></person-group><article-title>The molecular biology of memory storage: a dialogue between genes and synapses</article-title><source>Science</source><year>2001</year><volume>294</volume><fpage>1030</fpage><lpage>1038</lpage><pub-id pub-id-type="pmid">11691980</pub-id><pub-id pub-id-type="doi">10.1126/science.1067020</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bailey</surname><given-names>CH</given-names></name><name><surname>Montarolo</surname><given-names>P</given-names></name><name><surname>Chen</surname><given-names>M</given-names></name><name><surname>Kandel</surname><given-names>ER</given-names></name><name><surname>Schacher</surname><given-names>S</given-names></name></person-group><article-title>Inhibitors of protein and RNA synthesis block structural changes that accompany long-term heterosynaptic plasticity in Aplysia</article-title><source>Neuron</source><year>1992</year><volume>9</volume><fpage>749</fpage><lpage>758</lpage><pub-id pub-id-type="pmid">1356372</pub-id><pub-id pub-id-type="doi">10.1016/0896-6273(92)90037-E</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Glanzman</surname><given-names>DL</given-names></name><name><surname>Kandel</surname><given-names>ER</given-names></name><name><surname>Schacher</surname><given-names>S</given-nam