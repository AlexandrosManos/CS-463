><fpage>123</fpage><lpage>131</lpage><pub-id pub-id-type="pmid">15518235</pub-id></element-citation></ref><ref id="bib9"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cannon</surname><given-names>D.M.</given-names></name><name><surname>Ichise</surname><given-names>M.</given-names></name><name><surname>Fromm</surname><given-names>S.J.</given-names></name><name><surname>Nugent</surname><given-names>A.C.</given-names></name><name><surname>Rollis</surname><given-names>D.</given-names></name><name><surname>Gandhi</surname><given-names>S.K.</given-names></name><name><surname>Klaver</surname><given-names>J.M.</given-names></name><name><surname>Charney</surname><given-names>D.S.</given-names></name><name><surname>Manji</surname><given-names>H.K.</given-names></name><name><surname>Drevets</surname><given-names>W.C.</given-names></name></person-group><article-title>Serotonin transporter binding in bipolar disorder assessed using [<sup>11</sup>C]DASB and positron emission tomography</article-title><source>Biol. Psychiatry</source><volume>60</volume><year>2006</year><fpage>207</fpage><lpage>217</lpage><pub-id pub-id-type="pmid">16875929</pub-id></element-citation></ref><ref id="bib10"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chaouloff</surname><given-names>F.</given-names></name><name><surname>Castanon</surname><given-names>N.</given-names></name><name><surname>Mormede</surname><given-names>P.</given-names></name></person-group><article-title>Paradoxical differences in animal models of anxiety among the Roman rat lines</article-title><source>Neurosci. Lett.</source><volume>182</volume><year>1994</year><fpage>217</fpage><lpage>221</lpage><pub-id pub-id-type="pmid">7715814</pub-id></element-citation></ref><ref id="bib13"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Duman</surname><given-names>R.S.</given-names><