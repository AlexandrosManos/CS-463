-names>A</given-names></name><name><surname>Sayal</surname><given-names>A</given-names></name><name><surname>Kayaalp</surname><given-names>SO</given-names></name></person-group><article-title>The hydroxylation of omeprazole correlates with S-mephenytoin and proguanil metabolism</article-title><source>Eur J Clin Pharmacol</source><year>1997</year><volume>53</volume><supplement>3&#x02013;4</supplement><fpage>261</fpage><lpage>264</lpage><!--PubMed citation query: 'Eur J Clin Pharmacol||53|261||bib10|'--><pub-id pub-id-type="pmid">9476042</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>Y</given-names></name><name><surname>Hou</surname><given-names>J</given-names></name><name><surname>Jiang</surname><given-names>H</given-names></name><name><surname>Wang</surname><given-names>D</given-names></name><name><surname>Fu</surname><given-names>W</given-names></name><name><surname>Yuan</surname><given-names>Z</given-names></name><name><surname>Chen</surname><given-names>Y</given-names></name><name><surname>Zhou</surname><given-names>L</given-names></name></person-group><article-title>Polymorphisms of CYP2C19 gene are associated with the efficacy of thalidomide based regimens in multiple myeloma</article-title><source>Haematologica</source><year>2007</year><volume>92</volume><supplement>9</supplement><fpage>1246</fpage><lpage>1249</lpage><!--PubMed citation query: 'Haematologica||92|1246||bib11|'--><pub-id pub-id-type="pmid">17666363</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morgan</surname><given-names>E</given-names></name><name><surname>Goralski</surname><given-names>K</given-names></name><name><surname>Piquette-Miller</surname><given-names>M</given-names></name><name><surname>Renton</surname><given-names>K</given-names></name><name><surname>Robertson</surname><given-names>G</given-n