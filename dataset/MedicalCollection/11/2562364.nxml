><given-names>R</given-names></name><name><surname>Fass</surname><given-names>J</given-names></name><name><surname>Adam</surname><given-names>G</given-names></name><name><surname>Cremerius</surname><given-names>U</given-names></name><name><surname>Dohmen</surname><given-names>B</given-names></name><name><surname>Klever</surname><given-names>P</given-names></name><name><surname>Sabri</surname><given-names>O</given-names></name><name><surname>Schumpelick</surname><given-names>V</given-names></name><name><surname>Buell</surname><given-names>U</given-names></name></person-group><article-title>Fluorine-18 fluorodeoxyglucose positron emission tomography in the differential diagnosis of pancreatic carcinoma: a report of 106 cases</article-title><source>Eur J Nucl Med</source><year>1997</year><volume>24</volume><issue>6</issue><fpage>678</fpage><lpage>682</lpage><pub-id pub-id-type="pmid">9169578</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Inokuma</surname><given-names>T</given-names></name><name><surname>Tamaki</surname><given-names>N</given-names></name><name><surname>Torizuka</surname><given-names>T</given-names></name><name><surname>Magata</surname><given-names>Y</given-names></name><name><surname>Fujii</surname><given-names>M</given-names></name><name><surname>Yonekura</surname><given-names>Y</given-names></name><name><surname>Kajiyama</surname><given-names>T</given-names></name><name><surname>Ohshio</surname><given-names>G</given-names></name><name><surname>Imamura</surname><given-names>M</given-names></name><name><surname>Konishi</surname><given-names>J</given-names></name></person-group><article-title>Evaluation of pancreatic tumors with positron emission tomography and F-18 fluorodeoxyglucose: comparison with CT and US</article-title><source>Radiology</source><year>1995</year><volume>195</volume><issue>2</issue><fpage>345</fpage><lpage>352</lpage><pub-id pub-id-type="pmid">7724751</