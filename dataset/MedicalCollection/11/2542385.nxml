itle>Genome-wide identification of cuticular protein genes in the silkworm, <italic>Bombyx mori</italic></article-title><source>Insect Biochem Mol Biol</source><comment></comment></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Karouzou</surname><given-names>MV</given-names></name><name><surname>Spyropoulos</surname><given-names>Y</given-names></name><name><surname>Iconomidou</surname><given-names>VA</given-names></name><name><surname>Cornman</surname><given-names>RS</given-names></name><name><surname>Hamodrakas</surname><given-names>SJ</given-names></name><name><surname>Willis</surname><given-names>JH</given-names></name></person-group><article-title>Drosophila cuticular proteins with the R&#x00026;R Consensus: annotation and classification with a new tool for discriminating RR-1 and RR-2 sequences</article-title><source>Insect Biochem Mol Biol</source><year>2007</year><volume>37</volume><fpage>754</fpage><lpage>760</lpage><pub-id pub-id-type="pmid">17628275</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Consortium</surname><given-names>THGS</given-names></name></person-group><article-title>Insights into social insects from the genome of the honeybee Apis mellifera</article-title><source>Nature</source><year>2006</year><volume>443</volume><fpage>931</fpage><lpage>949</lpage><pub-id pub-id-type="pmid">17073008</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cornman</surname><given-names>RS</given-names></name><name><surname>Togawa</surname><given-names>T</given-names></name><name><surname>Dunn</surname><given-names>WA</given-names></name><name><surname>He</surname><given-names>N</given-names></name><name><surname>Emmons</surname><given-names>AC</given-names></name><name><surname>Willis</surname><given-names>JH</given-names></name></per