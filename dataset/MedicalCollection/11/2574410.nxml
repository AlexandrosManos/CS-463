mes>E</given-names></name><name><surname>Hodges</surname><given-names>L</given-names></name><name><surname>Rothbaum</surname><given-names>B</given-names></name></person-group><year>2005</year><article-title>Cognitive behavioral therapy for public-speaking anxiety using virtual reality for exposure.</article-title><source>Depression and Anxiety</source><volume>22</volume><fpage>156</fpage><lpage>158</lpage><pub-id pub-id-type="pmid">16231290</pub-id></citation></ref><ref id="pone.0003628-Klinger1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Klinger</surname><given-names>E</given-names></name><name><surname>Bouchard</surname><given-names>S</given-names></name><name><surname>Legeron</surname><given-names>P</given-names></name><name><surname>Roy</surname><given-names>S</given-names></name><name><surname>Lauer</surname><given-names>F</given-names></name><etal/></person-group><year>2005</year><article-title>Virtual reality therapy versus cognitive behavior therapy for social phobia: a preliminary controlled study.</article-title><source>Cyberpsychol Behav</source><volume>8</volume><fpage>76</fpage><lpage>88</lpage><pub-id pub-id-type="pmid">15738695</pub-id></citation></ref><ref id="pone.0003628-Rizzo1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rizzo</surname><given-names>AA</given-names></name><name><surname>Bowerly</surname><given-names>T</given-names></name><name><surname>Buckwalter</surname><given-names>JG</given-names></name><name><surname>Klimchuk</surname><given-names>D</given-names></name><name><surname>Mitura</surname><given-names>R</given-names></name><etal/></person-group><year>2006</year><article-title>A virtual reality scenario for all seasons: the virtual classroom.</article-title><source>CNS Spectr</source><volume>11</volume><fpage>35</fpage><lpage>44</lpage><pub-id pub-id-type="pmid">16400254</pub-id></citation></ref><ref id="pone.0003628-Mitchell1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mitchell</surname><given-names>P</given-names></name><name><surname>Parsons</surname><given-names>S</given-names></name><name><surname>Leonard</surname><given-names>A</given-names></name></person-group><year>2007</year><article-title>Using Virtual Environments for Teaching Social Understanding to 6 Adolescents with Autistic Spectrum Disorders.</article-title><source>J Autism Dev Disord</source><volume>37</volume><fpage>589</fpage><lpage>600</lpage><pub-id pub-id-type="pmid">16900403</pub-id></citation></ref><ref id="pone.0003628-daCosta1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>da Costa</surname><given-names>RM</given-names></name><name><surname>de Carvalho</surname><given-names>LA</given-names></name></person-group><year>2004</year><article-title>The acceptance of virtual reality devices for cognitive rehabilitation: a report of positive results with schizophrenia.</article-title><source>Comput Methods Programs Biomed</source><volume>73</volume><fpage>173</fpage><lpage>182</lpage><pub-id pub-id-type="pmid">14980398</pub-id></citation></ref><ref id="pone.0003628-Ku1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ku</surname><given-names>J</given-names></name><name><surname>Cho</surname><given-names>W</given-names></name><name><surname>Kim</surname><given-names>JJ</given-names></name><name><surname>Peled</surname><given-names>A</given-names></name><name><surname>Wiederhold</surname><given-names>BK</given-names></name><etal/></person-group><year>2003</year><article-title>A virtual environment for investigating schizophrenic patients' characteristics: assessment of cognitive and navigation ability.</article-title><source>Cyberpsychol Behav</source><volume>6</volume><fpage>397</fpage><lpage>404</lpage><pub-id pub-id-typ