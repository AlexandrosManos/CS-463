ge><pub-id pub-id-type="pmid">17126910</pub-id></citation></ref><ref id="pone.0003628-SpencerSmith1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Spencer-Smith</surname><given-names>J</given-names></name><name><surname>Wild</surname><given-names>H</given-names></name><name><surname>Innes-Ker</surname><given-names>AH</given-names></name><name><surname>Townsend</surname><given-names>J</given-names></name><name><surname>Duffy</surname><given-names>C</given-names></name><etal/></person-group><year>2001</year><article-title>Making faces: creating three-dimensional parameterized models of facial expression.</article-title><source>Behav Res Methods Instrum Comput</source><volume>33</volume><fpage>115</fpage><lpage>123</lpage><pub-id pub-id-type="pmid">11447663</pub-id></citation></ref><ref id="pone.0003628-Ku2"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ku</surname><given-names>J</given-names></name><name><surname>Jang</surname><given-names>HJ</given-names></name><name><surname>Kim</surname><given-names>KU</given-names></name><name><surname>Kim</surname><given-names>JH</given-names></name><name><surname>Park</surname><given-names>SH</given-names></name><etal/></person-group><year>2005</year><article-title>Experimental results of affective valence and arousal to avatar's facial expressions.</article-title><source>Cyberpsychol Behav</source><volume>8</volume><fpage>493</fpage><lpage>503</lpage><pub-id pub-id-type="pmid">16232042</pub-id></citation></ref><ref id="pone.0003628-Schilbach1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schilbach</surname><given-names>L</given-names></name><name><surname>Koubeissi</surname><given-names>MZ</given-names></name><name><surname>David</surname><given-names>N</given-names></name><name><surname>Vogeley</surname><given-names>K</given-names></name><name><s