-type="pmid">16878227</pub-id></mixed-citation></ref><ref id="b13"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mishra</surname><given-names>V</given-names></name><name><surname>Barrere</surname><given-names>B</given-names></name><name><surname>Hong</surname><given-names>R</given-names></name><etal/></person-group>  <article-title>Evaluation of bias in HIV seroprevalence estimates from national household surveys.</article-title> <source>Sex Transm Infect</source> <comment>2008 (this issue).</comment></mixed-citation></ref><ref id="b14"><label>14</label><mixed-citation publication-type="book"><collab>NACA</collab> <source>Botswana AIDS Impact Survey II</source>. <publisher-loc>Botswana</publisher-loc>: <publisher-name>NACA, CSO, UNDP, ACHAP, UNICEF</publisher-name>, <year>2004</year></mixed-citation></ref><ref id="b15"><label>15</label><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Shisana</surname><given-names>O</given-names></name><name><surname>Rehle</surname><given-names>T</given-names></name><name><surname>Simbayi</surname><given-names>LC</given-names></name><etal/></person-group> . <source>South African national HIV prevalence, HIV incidence, behaviour and communication Survey, 2005</source>. <publisher-loc>Cape Town</publisher-loc>: <publisher-name>HSRC Press</publisher-name>, <year>2005</year></mixed-citation></ref><ref id="b16"><label>16</label><mixed-citation publication-type="book"><collab>National Statistical Office (NSO) [Malawi], ORC Macro</collab> <source>Malawi demographic and health survey 2004</source>. <publisher-loc>Calverton, MD</publisher-loc>: <publisher-name>NSO and ORC Macro</publisher-name>, <year>2005</year></mixed-citation></ref><ref id="b17"><label>17</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>T</given-names></name><name><surname>S