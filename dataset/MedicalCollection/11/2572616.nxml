">Hong Kong 1963</td><td align="left" colspan="2">Hong Kong 1993</td><td align="left" colspan="2">Hong Kong 2005/6</td><td align="left" colspan="2">China 2005</td></tr><tr><td></td><td colspan="2"><hr></hr></td><td colspan="2"><hr></hr></td><td colspan="2"><hr></hr></td><td colspan="2"><hr></hr></td></tr><tr><td></td><td align="left">P<sub>85</sub></td><td align="left">P<sub>95</sub></td><td align="left">P<sub>85</sub></td><td align="left">P<sub>95</sub></td><td align="left">P<sub>85</sub></td><td align="left">P<sub>95</sub></td><td align="left">P<sub>85</sub></td><td align="left">P<sub>95</sub></td></tr></thead><tbody><tr><td align="left"><bold>Boys</bold></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left">7</td><td align="left">15.1</td><td align="left">16.1</td><td align="left">17.9</td><td align="left">19.6</td><td align="left">18.8</td><td align="left">21.4</td><td align="left">17.0</td><td align="left">19.6</td></tr><tr><td align="left">8</td><td align="left">15.5</td><td align="left">16.7</td><td align="left">18.4</td><td align="left">20.3</td><td align="left">19.4</td><td align="left">22.2</td><td align="left">17.7</td><td align="left">20.4</td></tr><tr><td align="left">9</td><td align="left">15.5</td><td align="left">16.6</td><td align="left">19.1</td><td align="left">21.2</td><td align="left">20.1</td><td align="left">23.1</td><td align="left">18.4</td><td align="left">21.3</td></tr><tr><td align="left">10</td><td align="left">15.9</td><td align="left">17.1</td><td align="left">19.7</td><td align="left">22.2</td><td align="left">20.9</td><td align="left">24.1</td><td align="left">19.4</td><td align="left">22.2</td></tr><tr><td align="left">11</td><td align="left">16.6</td><td align="left">18.1</td><td align="left">20.3</td><td align="left">23.0</td><td align="left">21.6</td><td align="left">25.0</td><td align="left">20.1</td><td align="left">23.0</td></tr><tr><td align="left">12</td><td align="left">17.2</td><td align="left">18.9</td><td align="left">20.8</td><td align="left">23.7</td><td align="left">22.3</td><td align="left">25.7</td><td align="left">21.0</td><td align="left">23.9</td></tr><tr><td align="left">13</td><td align="left">18.0</td><td align="left">19.8</td><td align="left">21.3</td><td align="left">24.4</td><td align="left">22.7</td><td align="left">26.2</td><td align="left">21.9</td><td align="left">25.0</td></tr><tr><td align="left">14</td><td align="left">18.5</td><td align="left">20.2</td><td align="left">21.9</td><td align="left">25.1</td><td align="left">23.1</td><td align="left">26.6</td><td align="left">22.8</td><td align="left">25.9</td></tr><tr><td align="left">15</td><td align="left">19.2</td><td align="left">20.9</td><td align="left">22.3</td><td align="left">25.6</td><td align="left">23.5</td><td align="left">26.9</td><td align="left">23.5</td><td align="left">26.8</td></tr><tr><td align="left">16</td><td align="left">19.9</td><td align="left">21.7</td><td align="left">22.8</td><td align="left">26.1</td><td align="left">23.7</td><td align="left">27.2</td><td align="left">24.2</td><td align="left">27.7</td></tr><tr><td align="left">17</td><td align="left">20.3</td><td align="left">22.1</td><td align="left">23.2</td><td align="left">26.4</td><td align="left">23.9</td><td align="left">27.3</td><td align="left">25.0</td><td align="left">28.5</td></tr><tr><td align="left">18</td><td align="left">20.5</td><td align="left">22.2</td><td align="left">23.4</td><td align="left">26.6</td><td align="left">24.1</td><td align="left">27.3</td><td align="left">24.8</td><td align="left">28.2</td></tr><tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left"><bold>Girls</bold></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left">7</td><td align="left">14.9</td><td align="left">15.9</td><td align="left">17.2</td><td align="left">19.1</td><td align="left">17.7<