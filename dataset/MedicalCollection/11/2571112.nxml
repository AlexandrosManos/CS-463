-names></name><name><surname>Cunnick</surname><given-names>JE</given-names></name></person-group><article-title>Enhancement of innate and adaptive immune functions by multiple <italic>Echinacea </italic>species</article-title><source>J Med Food</source><year>2007</year><volume>10</volume><fpage>423</fpage><lpage>434</lpage><pub-id pub-id-type="pmid">17887935</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matthias</surname><given-names>A</given-names></name><name><surname>Banhury</surname><given-names>L</given-names></name><name><surname>Stevenson</surname><given-names>LM</given-names></name><name><surname>Leach</surname><given-names>DN</given-names></name><name><surname>Lehmann</surname><given-names>RP</given-names></name></person-group><article-title>Alkylamides from Echinacea modulate induced immune responses in macrophages</article-title><source>Immunol invest</source><year>2007</year><volume>36</volume><fpage>117</fpage><lpage>130</lpage><pub-id pub-id-type="pmid">17365014</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goel</surname><given-names>V</given-names></name><name><surname>Chang</surname><given-names>C</given-names></name><name><surname>Slama</surname><given-names>J</given-names></name><name><surname>Barton</surname><given-names>R</given-names></name><name><surname>Bauer</surname><given-names>R</given-names></name><name><surname>Gahler</surname><given-names>R</given-names></name><name><surname>Basu</surname><given-names>T</given-names></name></person-group><article-title>Echinacea stimulates macrophage function in the lung and spleen of normal rats</article-title><source>J Nutr Biochem</source><year>2002</year><volume>13</volume><fpage>487</fpage><pub-id pub-id-type="pmid">12165361</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><