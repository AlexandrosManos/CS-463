ge>166</lpage><pub-id pub-id-type="pmid">15115689</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bodinet</surname><given-names>C</given-names></name><name><surname>Lindequist</surname><given-names>U</given-names></name><name><surname>Teuscher</surname><given-names>E</given-names></name><name><surname>Freudenstein</surname><given-names>J</given-names></name></person-group><article-title>Effect of an orally applied herbal immunomodulator on cytokine induction and antibody response in normal and immunosuppressed mice</article-title><source>Phytomedicine</source><year>2002</year><volume>9</volume><fpage>606</fpage><lpage>613</lpage><pub-id pub-id-type="pmid">12487324</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bauer</surname><given-names>V</given-names></name><name><surname>Jurcic</surname><given-names>K</given-names></name><name><surname>Puhlmann</surname><given-names>J</given-names></name><name><surname>Wagner</surname><given-names>V</given-names></name></person-group><article-title>Immunologic in vivo and in vitro examinations of <italic>Echinacea </italic>extracts</article-title><source>Arzneim Forsch</source><year>1998</year><volume>38</volume><fpage>276</fpage><lpage>281</lpage><pub-id pub-id-type="pmid">3370076</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roesler</surname><given-names>J</given-names></name><name><surname>Emmendorffer</surname><given-names>A</given-names></name><name><surname>Steinmuller</surname><given-names>C</given-names></name><name><surname>Luettig</surname><given-names>B</given-names></name><name><surname>Wagner</surname><given-names>H</given-names></name><name><surname>Lohmann-Matthes</surname><given-names>ML</given-names></name></person-group><article-title>Application of purified polysaccharides from cell cultures of the plant <italic>Echinacea purpurea </italic>to test subjects mediates activation of the phagocyte system</article-title><source>Int J Immunopharmacol</source><year>1991</year><volume>13</volume><fpage>931</fpage><lpage>941</lpage><pub-id pub-id-type="pmid">1761359</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Luettig</surname><given-names>B</given-names></name><name><surname>Steinmuller</surname><given-names>C</given-names></name><name><surname>Gifford</surname><given-names>GE</given-names></name><name><surname>Wagner</surname><given-names>H</given-names></name><name><surname>Lohmann-Matthes</surname><given-names>ML</given-names></name></person-group><article-title>Macrophage activation by the polysaccharide arabinogalactan isolated from plant cell cultures of <italic>Echinacea purpurea</italic></article-title><source>J Natl Cancer Inst</source><year>1989</year><volume>81</volume><fpage>669</fpage><lpage>675</lpage><pub-id pub-id-type="pmid">2785214</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sperber</surname><given-names>SJ</given-names></name><name><surname>Shah</surname><given-names>LP</given-names></name><name><surname>Gilbert</surname><given-names>RD</given-names></name><name><surname>Ritchey</surname><given-names>TW</given-names></name><name><surname>Monto</surname><given-names>AS</given-names></name></person-group><article-title><italic>Echinacea purpurea </italic>for prevention of experimental rhinovirus colds</article-title><source>Clin Infect Dis</source><year>2004</year><volume>38</volume><fpage>1367</fpage><lpage>1371</lpage><pub-id pub-id-type="pmid">15156472</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Taylor</surname><given-names>JA</given-names></name><name><surname>Weber</su