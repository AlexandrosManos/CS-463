<td align="center" rowspan="1" colspan="1">&#x02212;0.31 (&#x02212;1.43 to 0.81)</td><td align="center" rowspan="1" colspan="1">0.6 (&#x02212;54.6 to 54.8)</td></tr><tr><td align="left" rowspan="1" colspan="1">Coarse PM (&#x003bc;g/m<sup>3</sup>)</td><td align="center" rowspan="1" colspan="1">0.04 (&#x02212;0.65 to 0.73)</td><td align="center" rowspan="1" colspan="1">0.17 (&#x02212;1.25 to 1.60)</td><td align="center" rowspan="1" colspan="1">0.02 (&#x02212;0.03 to 0.08)</td></tr><tr><td align="left" rowspan="1" colspan="1">PM<sub>2.5</sub> (&#x003bc;g/m<sup>3</sup>)</td><td align="center" rowspan="1" colspan="1">&#x02212;0.21 (&#x02212;1.84 to 1.41)</td><td align="center" rowspan="1" colspan="1">&#x02212;0.74 (&#x02212;2.47 to 0.98)</td><td align="center" rowspan="1" colspan="1">38.7 (&#x02212;1.07 to 78.4)<xref ref-type="table-fn" rid="tfn5-ehp-116-1423">*</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Black smoke (10<sup>&#x02212;5</sup>/m)</td><td align="center" rowspan="1" colspan="1">&#x02212;1.46 (&#x02212;17.38 to 14.43)</td><td align="center" rowspan="1" colspan="1">3.29 (&#x02212;2.13 to 8.72)</td><td align="center" rowspan="1" colspan="1">200.6 (&#x02212;222.3 to 623.4)</td></tr><tr><td colspan="4" align="left" rowspan="1">Roadways (km)</td></tr><tr><td align="left" rowspan="1" colspan="1">Distance to bridge</td><td align="center" rowspan="1" colspan="1">0.006 (&#x02212;0.13 to 0.14)</td><td align="center" rowspan="1" colspan="1">&#x02212;0.02 (&#x02212;0.16 to 0.13)</td><td align="center" rowspan="1" colspan="1">&#x02212;3.2 (&#x02212;14.9 to 0.86)</td></tr><tr><td align="left" rowspan="1" colspan="1">Length of local roadways within 200 m of the home</td><td align="center" rowspan="1" colspan="1">&#x02212;0.15 (&#x02212;1.27 to 0.96)</td><td align="center" rowspan="1" colspan="1">&#x02212;0.70 (&#x02212;1.88 to 0.48)</td><td align="center" rowspan="1" colspan="1">65.6 (1.5 to 129.8)<xref ref-type="table-fn" rid="tfn6-ehp-116-1423">**</xref><