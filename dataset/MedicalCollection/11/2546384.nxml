n-type="book"><person-group person-group-type="author"><collab>National Institute of Population Studies</collab></person-group><source>Pakistan Demographic and Health Survey 2006&#x02013;2007</source><year>2007</year><publisher-name>Preliminary Report. Islamabad</publisher-name></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Nishtar</surname><given-names>S</given-names></name></person-group><source>Restructuring basic health units-Mandatory safeguards</source><year>2006</year><publisher-name>Pakistan Health Policy Forum. Heartfile. Islamabad</publisher-name></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><collab>Government of Pakistan</collab></person-group><source>Pakistan social and living standards measurement survey 2004&#x02013;05</source><year>2005</year><publisher-name>Federal Bureau of Statistics. Islamabad</publisher-name></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><collab>Government of Pakistan</collab></person-group><source>Lady Health Workers Program 2003&#x02013;2008 PC-1</source><year>2003</year><publisher-name>Ministry of Health. Islamabad</publisher-name></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><collab>World Health Organization</collab></person-group><source>Pakistan's experience in Lady Health Workers Program</source><year>2004</year><publisher-name>Regional Committee for the Eastern Mediterranean. Cairo</publisher-name></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><collab>Government of Pakistan</collab></person-group><source>Reproductive Health Services Package</source><year>1999</year><publisher-name>Ministry of Health and Ministry of Population Welfare. Islamabad</publisher-name></citation></ref><ref id="B25"><citation citation-type="book"><person-group person-group-type="author"><collab>Government of Pakistan, National Health Policy 2001</collab></person-group><source>The Way Forward</source><year>2001</year><publisher-name>Ministry of Health, Islamabad</publisher-name></citation></ref><ref id="B26"><citation citation-type="book"><person-group person-group-type="author"><collab>Government of Pakistan</collab></person-group><source>Population Policy of Pakistan</source><year>2001</year><publisher-name>Ministry of Population Welfare. Islamabad</publisher-name></citation></ref><ref id="B27"><citation citation-type="book"><person-group person-group-type="author"><collab>Government of Pakistan</collab></person-group><source>National Policy for Development and Empowerment of Women</source><year>2002</year><publisher-name>Ministry of Women Development. Islamabad</publisher-name></citation></ref><ref id="B28"><citation citation-type="book"><person-group person-group-type="author"><collab>Government of Pakistan</collab></person-group><source>Poverty Reduction Strategy Paper 2003</source><year>2003</year><publisher-name>Poverty Reduction Strategy Paper Secretariat, Ministry of Finance. Islamabad</publisher-name></citation></ref><ref id="B29"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Mumtaz</surname><given-names>K</given-names></name></person-group><source>Reducing the Gender Gap/Engendering PRSP 2. Support to PRSP-II Formulation Project</source><year>2008</year><publisher-name>Ministry of Finance. Islamabad</publisher-name></citation></ref><ref id="B30"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hussain</surname><given-names>A</given-names></name></person-group><source>Pakistan National Human Development Report 2003 Poverty, Growth and Governance</source><year>2003</year><publisher-name>Islamabad: UNDP</publisher-name></citation></ref><ref id="B31"><citation citation-type="book"><person-group person-group-type="author"><collab>Government of Pakistan</collab></person-group><source>Pakistan Millennium Development Goals Report 2005</source><year>2005</year><publisher-name>Center for Research for Poverty Reduction and Income Distribution. Planning Commission. Islamabad</publisher-name></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sathar</surname><given-names>ZA</given-names></name><name><surname>Singh</surname><given-names>S</given-names></name><name><surname>Fikree</surname><given-names>FF</given-names></name></person-group><article-title>Estimating the incidence of abortion in Pakistan</article-title><source>Stud Fam Plann</source><year>2007</year><volume>38</volume><fpage>11</fpage><lpage>22</lpage><pub-id pub-id-type="pmid">17385379</pub-id><pub-id pub-id-type="doi">10.1111/j.1728-4465.2007.00112.x</pub-id></citation></ref><ref id="B33"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Akhter</surname><given-names>HH</given-names></name></person-group><article-title>Mid level provider in menstrual regulation: Bangladesh experience</article-title><source>Proceedings of the Conference on Expanding Access: Advancing the roles of midlevel providers in menstrual regulation and elective abortion care: South Africa</source><comment>2&#x02013;6 December 2001</comment></citation></ref><ref id="B34"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Larijani</surname><given-names>B</given-names></name></person-group><article-title>Changing Parameters for abortion in Iran</article-title><source>Indian J Med Ethics</source><year>2006</year><volume>4</volume><fpage>4</fpage></citation></ref><ref id="B35"><citation citation-type="other"><person-group person-group-type="author"><collab>Population Action International</collab></person-group><article-title>How donor countries fall short of meeting Reproductive Health</article-title><ext-link ext-link-type="uri" xlink:href="http://www.populationaction.org/Publications/Fact_Sheets/FS8/Summary.shtml"/></citation></ref><ref id="B36"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cohen</surname><given-names>SA</given-names></name></person-group><source>Global gag rule: exporting antiabortion ideology at the expense of American values</source><year>2001</year><volume>4</volume><publisher-name>The Guttmacher Report on Public Policy, Washington DC</publisher-name></citation></ref><ref id="B37"><citation citation-type="other"><person-group person-group-type="author"><collab>World Health Organization</collab></person-group><article-title>Country Profile: Pakistan</article-title><ext-link ext-link-type="uri" xlink:href="http://www.who.int/countries/pak/en/"/></citation></ref><ref id="B38"><citation citation-type="other"><person-group person-group-type="author"><collab>United Nation Population Fund</collab></person-group><source>Investing in People: National Progress in Implementing the ICPD Progrmme of Action 1994&#x02013;2004 New York</source><year>2004</year></citation></ref><ref id="B39"><citation citation-type="other"><person-group person-group-type="author"><collab>United Nations</collab></person-group><source>The Millennium Development Goals Report 2006 New York</source><year>2006</year></citation></ref><ref id="B40"><citation citation-type="book"><person-group person-group-type="author"><collab>Government of Pakistan</collab></person-group><source>Pakistan: National Maternal and Child Health Policy &#x00026; Strategic Framework</source><year>2005</year><publisher-name>Ministry of Health. Islamabad</publisher-name></citation></ref><ref id="B41"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Siddiqi</surname><given-names>S</given-names></name><name><surname>Haq</surname><given-names>IU</given-names></name><name><surname>Ghaffar</surname><given-names>A</given-names></name><name><surname>Akhtar</surname><given-names>T</given-names></name><name><surname>Mahaini</surname><given-names>R</given-names></name></person-group><article-title>Pakistan's maternal and child health policy: analysis, lessons and the way forward</article-title><source>Health Policy</source><year>2004</year><volume>69</volume><fpage>117</fpage><lpage>130</lpage><pub-id pub-id-type="pmid">15484612</pub-id><pub-id pub-id-type="doi">10.1016/j.healthpol.2003.12.007</pub-id></citation></ref></ref-list></back></article>