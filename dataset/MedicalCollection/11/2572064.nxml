d">8059422</pub-id><pub-id pub-id-type="doi">10.1002/tera.1420490304</pub-id></citation></ref><ref id="B6"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Guilford</surname><given-names>JP</given-names></name></person-group><source>Psychometric Methods</source><year>1954</year><publisher-name>McGraw-Hill, New York</publisher-name></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martin</surname><given-names>CR</given-names></name><name><surname>Newell</surname><given-names>RJ</given-names></name></person-group><article-title>Is the 12-item General Health Questionnaire (GHQ-12) confounded by scoring method in individuals with facial disfigurement?</article-title><source>Psychology and Health</source><year>2005</year><volume>20</volume><fpage>651</fpage><lpage>659</lpage><pub-id pub-id-type="doi">10.1080/14768320500060061</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shevlin</surname><given-names>M</given-names></name><name><surname>Adamson</surname><given-names>G</given-names></name></person-group><article-title>Alternative Factor Models and Factorial Invariance of the GHQ-12: A Large Sample Analysis Using Confirmatory Factor Analysis</article-title><source>Psychological Assessment</source><year>2005</year><volume>17</volume><fpage>231</fpage><lpage>236</lpage><pub-id pub-id-type="pmid">16029110</pub-id><pub-id pub-id-type="doi">10.1037/1040-3590.17.2.231</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Graetz</surname><given-names>B</given-names></name></person-group><article-title>Multidimensional properties of the General Health Questionnaire</article-title><source>Social Psychiatry &#x00026; Psychiatric Epidemiology</source><year>1991</year><fpage>132</fpage><lpage>8</lpage><pub-id pub-id-type="pmi