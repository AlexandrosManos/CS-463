age><pub-id pub-id-type="pmid">12558550</pub-id></citation></ref><ref id="pone.0003543-Okada2"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Okada</surname><given-names>Y</given-names></name></person-group><year>2006</year><article-title>Cell volume-sensitive chloride channels: phenotypic properties and molecular identity.</article-title><source>Contrib Nephrol</source><volume>152</volume><fpage>9</fpage><lpage>24</lpage><pub-id pub-id-type="pmid">17065805</pub-id></citation></ref><ref id="pone.0003543-Banderali1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Banderali</surname><given-names>U</given-names></name><name><surname>Roy</surname><given-names>G</given-names></name></person-group><year>1992</year><article-title>Anion channels for amino-acids in Mdck cells.</article-title><source>Am J Physiol</source><volume>263</volume><fpage>C1200</fpage><lpage>C1207</lpage><pub-id pub-id-type="pmid">1282298</pub-id></citation></ref><ref id="pone.0003543-Jackson1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jackson</surname><given-names>PS</given-names></name><name><surname>Strange</surname><given-names>K</given-names></name></person-group><year>1993</year><article-title>Volume-sensitive anion channels mediate swelling-activated inositol and taurine efflux.</article-title><source>Am J Physiol</source><volume>265</volume><fpage>C1489</fpage><lpage>C1500</lpage><pub-id pub-id-type="pmid">8279513</pub-id></citation></ref><ref id="pone.0003543-PasantesMorales1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pasantes-Morales</surname><given-names>H</given-names></name><name><surname>Moran</surname><given-names>J</given-names></name><name><surname>Schousboe</surname><given-names>A</given-names></name></person-group><year>1990</year><artic