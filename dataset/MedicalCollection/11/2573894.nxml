b-id pub-id-type="pmid">17274820</pub-id><pub-id pub-id-type="doi">10.1186/gb-2007-8-2-r16</pub-id></citation></ref><ref id="B12"><citation citation-type="other"><article-title>NCBI Genbank nr protein sequence database</article-title><ext-link ext-link-type="uri" xlink:href="ftp://ftp.ncbi.nih.gov/blast/db/"/></citation></ref><ref id="B13"><citation citation-type="other"><article-title>NCBI taxonomy database</article-title><ext-link ext-link-type="uri" xlink:href="ftp://ftp.ncbi.nih.gov/pub/taxonomy"/></citation></ref><ref id="B14"><citation citation-type="other"><article-title>MySQL database home page</article-title><ext-link ext-link-type="uri" xlink:href="http://www.mysql.com/"/></citation></ref><ref id="B15"><citation citation-type="other"><article-title>NCBI Taxonomy Browser</article-title><ext-link ext-link-type="uri" xlink:href="http://www.ncbi.nlm.nih.gov/Taxonomy/"/></citation></ref><ref id="B16"><citation citation-type="other"><article-title>NCBI Genbank genomes</article-title><ext-link ext-link-type="uri" xlink:href="ftp://ftp.ncbi.nih.gov/genbank/genomes/"/></citation></ref><ref id="B17"><citation citation-type="other"><article-title>DOE Joint Genome Institute Integrated Microbial Genomes</article-title><ext-link ext-link-type="uri" xlink:href="http://img.jgi.doe.gov/"/></citation></ref><ref id="B18"><citation citation-type="other"><article-title>J. Craig Venter Institute, Moore marine Microbial Sequencing Project</article-title><ext-link ext-link-type="uri" xlink:href="https://research.venterinstitute.org/moore/"/></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gal-Mor</surname><given-names>O</given-names></name><name><surname>Finlay</surname><given-names>BB</given-names></name></person-group><article-title>Pathogenicity islands: a molecular toolbox for bacterial virulence</article-title><source>Cell Microbiol</source><year>2006</year><volume>8</volume><fpage>1707</fpage><lpage>1719</lpage><pub-id pub-id-type="pmid">16939533</pub-id><pub-id pub-id-type="doi">10.1111/j.1462-5822.2006.00794.x</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sriramulu</surname><given-names>DD</given-names></name></person-group><article-title>Adaptive expression of foreign genes in the clonal variants of bacteria: From proteomics to clinical application</article-title><source>Proteomics</source><year>2008</year><volume>8</volume><fpage>882</fpage><lpage>892</lpage><pub-id pub-id-type="pmid">18297656</pub-id><pub-id pub-id-type="doi">10.1002/pmic.200700811</pub-id></citation></ref><ref id="B21"><citation citation-type="other"><article-title>NCBI microbial genomes</article-title><ext-link ext-link-type="uri" xlink:href="http://www.ncbi.nlm.nih.gov/genomes/lproks.cgi"/></citation></ref><ref id="B22"><citation citation-type="other"><article-title>JCVI Comprehensive Microbial Resource</article-title><ext-link ext-link-type="uri" xlink:href="http://cmr.jcvi.org/"/></citation></ref><ref id="B23"><citation citation-type="other"><article-title>Microbial Genome Database for Comparative Analysis</article-title><ext-link ext-link-type="uri" xlink:href="http://mbgd.genome.ad.jp/"/></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garcia-Vallve</surname><given-names>S</given-names></name><name><surname>Guzman</surname><given-names>E</given-names></name><name><surname>Montero</surname><given-names>MA</given-names></name><name><surname>Romeu</surname><given-names>A</given-names></name></person-group><article-title>HGT-DB: a database of putative horizontally transferred genes in prokaryotic complete genomes</article-title><source>Nucleic Acids Res</source><year>2003</year><volume>31</volume><fpage>187</fpage><lpage>189</lpage><pub-id pub-id-type="pmid">12519978</pub-id><pub-id pub-id-type="pmid">12519978</pub-id><pub-id pub-id-type="doi">10.1093/nar/gkg004</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tsirigos</surname><given-names>A</given-names></name><name><surname>Rigoutsos</surname><given-names>I</given-names></name></person-group><article-title>A new computational method for the detection of horizontal gene transfer events</article-title><source>Nucleic Acids Res</source><year>2005</year><volume>33</volume><fpage>922</fpage><lpage>933</lpage><pub-id pub-id-type="pmid">15716310</pub-id><pub-id pub-id-type="doi">10.1093/nar/gki187</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Charlebois</surname><given-names>RL</given-names></name><name><surname>Clarke</surname><given-names>GD</given-names></name><name><surname>Beiko</surname><given-names>RG</given-names></name><name><surname>St Jean</surname><given-names>A</given-names></name></person-group><article-title>Characterization of species-specific genes using a flexible, web-based querying system</article-title><source>FEMS Microbiol Lett</source><year>2003</year><volume>225</volume><fpage>213</fpage><lpage>220</lpage><pub-id pub-id-type="pmid">12951244</pub-id><pub-id pub-id-type="pmid">12951244</pub-id><pub-id pub-id-type="doi">10.1016/S0378-1097(03)00512-3</pub-id></citation></ref></ref-list></back></article>