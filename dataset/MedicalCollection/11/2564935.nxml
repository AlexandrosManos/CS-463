">1.095</td><td align="center">1.524</td><td align="center">0.9336</td><td align="center">0.2265</td></tr><tr><td align="left">GLE1 RNA export mediator-like (yeast)</td><td align="center">-0.8643</td><td align="center">-0.341</td><td align="center">-0.2584</td><td align="center">-0.6748</td></tr><tr><td align="left">glucosaminyl (N-acetyl) transferase 2, I-branching enzyme</td><td align="center">2.377</td><td align="center">1.534</td><td align="center">2.844</td><td align="center">1.225</td></tr><tr><td align="left">GNAS complex locus</td><td align="center">-0.6085</td><td align="center">-1.294</td><td align="center">-1.715</td><td align="center">-1.55</td></tr><tr><td align="left">GRO3 oncogene</td><td align="center">-0.3814</td><td align="center">-1.003</td><td align="center">-0.9765</td><td align="center">-0.7961</td></tr><tr><td align="left">growth factor independent 1</td><td align="center">1.282</td><td align="center">0.2066</td><td align="center">0.669</td><td align="center">0.7891</td></tr><tr><td align="left">growth hormone receptor</td><td align="center">-0.3103</td><td align="center">-1.458</td><td align="center">-0.8417</td><td align="center">-1.296</td></tr><tr><td align="left">H. sapiens ARS gene, component B.</td><td align="center">0.3962</td><td align="center">1.059</td><td align="center">1.186</td><td align="center">0.6116</td></tr><tr><td align="left">heat shock 27 kDa protein 2</td><td align="center">-0.6707</td><td align="center">-0.7274</td><td align="center">-2.224</td><td align="center">-1.424</td></tr><tr><td align="left">hemoglobin, zeta</td><td align="center">-0.4909</td><td align="center">-0.8871</td><td align="center">-0.4189</td><td align="center">-0.149</td></tr><tr><td align="left">high-mobility group 20A</td><td align="center">1.768</td><td align="center">2.038</td><td align="center">0.7883</td><td align="center">0.5271</td></tr><tr><td align="left">Homo sapiens IGHG3 gene for immunoglobulin heavy chain gamma</td><td align="center">1.