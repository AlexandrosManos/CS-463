e="author"><name><surname>Rigby</surname><given-names>RA</given-names></name><name><surname>Stasinopoulos</surname><given-names>DM</given-names></name></person-group><article-title>Generalized additive models for location, scale and shape</article-title><source>Applied Statistics</source><year>2005</year><volume>54</volume><fpage>507</fpage><lpage>554</lpage></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Koenker</surname><given-names>R</given-names></name></person-group><article-title>Quantile Regression</article-title><source>Econometric Society Monographs</source><year>2005</year><edition>1</edition></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kalies</surname><given-names>H</given-names></name><name><surname>Heinrich</surname><given-names>J</given-names></name><name><surname>Borte</surname><given-names>N</given-names></name><name><surname>Schaaf</surname><given-names>B</given-names></name><name><surname>von Berg</surname><given-names>A</given-names></name><name><surname>von Kries</surname><given-names>R</given-names></name><name><surname>Wichmann</surname><given-names>HE</given-names></name><name><surname>Bolte</surname><given-names>G</given-names></name></person-group><article-title>The effect of breastfeeding on weight gain in infants: results of a birth cohort study</article-title><source>European Journal of Medical Research</source><year>2005</year><volume>10</volume><fpage>36</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">15737952</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dorea</surname><given-names>JG</given-names></name></person-group><article-title>Maternal smoking and infant feeding: breastfeeding is better and safer</article-title><source>Maternal and Child Health Journal</source><year>2007</year><volume>11</volume><fpage>287</fpage><lpage>91</lpage><pub-id pub-id-type="pmid">17226091</pub-id><pub-id pub-id-type="doi">10.1007/s10995-006-0172-1</pub-id></citation></ref><ref id="B23"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Stasinopoulos</surname><given-names>DM</given-names></name><name><surname>Rigby</surname><given-names>RA</given-names></name><name><surname>Akantziliotou</surname><given-names>C</given-names></name></person-group><article-title>The GAMLSS Package</article-title><source>R help files</source><year>2006</year></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Toschke</surname><given-names>AM</given-names></name><name><surname>Martin</surname><given-names>RM</given-names></name><name><surname>von Kries</surname><given-names>R</given-names></name><name><surname>Wells</surname><given-names>J</given-names></name><name><surname>Smith</surname><given-names>GD</given-names></name><name><surname>Ness</surname><given-names>AR</given-names></name></person-group><article-title>Infant feeding method and obesity: BMI and DXA measurements at 9&#x02013;10 years from the Avon Longitudinal Study of Parents and Children (ALSPAC)</article-title><source>American Journal of Clinical Nutrition</source><year>2007</year><volume>85</volume><fpage>1578</fpage><lpage>1585</lpage><pub-id pub-id-type="pmid">17556696</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Borghi</surname><given-names>E</given-names></name><name><surname>de Onis</surname><given-names>M</given-names></name><name><surname>Garza</surname><given-names>C</given-names></name><name><surname>Broeck</surname><given-names>J Van den</given-names></name><name><surname>Frongillo</surname><given-names>EA</given-names></name><name><surname>Grummer-Strawn</surname><given-names>L</given-names></name><name><surname>Van Buuren</surname><given-nam