tion citation-type="journal"><person-group person-group-type="author"><name><surname>Wong</surname><given-names>C</given-names></name><name><surname>Chang</surname><given-names>H</given-names></name><name><surname>Pasupathy</surname><given-names>S</given-names></name><name><surname>Khin</surname><given-names>L</given-names></name><name><surname>Tan</surname><given-names>J</given-names></name><name><surname>Low</surname><given-names>C</given-names></name></person-group><article-title>Necrotizing fasciitis: clinical presentation, microbiology, and determinants of mortality</article-title><source>J Bone Joint Surg Am</source><year>2003</year><volume>85-A</volume><fpage>1454</fpage><lpage>1460</lpage><pub-id pub-id-type="pmid">12925624</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cornia</surname><given-names>PB</given-names></name><name><surname>Davidson</surname><given-names>HL</given-names></name><name><surname>Lipsky</surname><given-names>BA</given-names></name></person-group><article-title>The evaluation and treatment of complicated skin and skin structure infections</article-title><source>Expert Opin Pharmacother</source><year>2008</year><volume>9</volume><fpage>717</fpage><lpage>730</lpage><pub-id pub-id-type="pmid">18345950</pub-id><pub-id pub-id-type="doi">10.1517/14656566.9.5.717</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sendi</surname><given-names>P</given-names></name><name><surname>Johansson</surname><given-names>L</given-names></name><name><surname>Norrby-Teglund</surname><given-names>A</given-names></name></person-group><article-title>Invasive group B Streptococcal disease in non-pregnant adults. A review with emphasis on skin and soft-tissue infections</article-title><source>Infection</source><year>2008</year><volume>36</volume><fpage>100</fpage><lpage>111</lpage><pub-id pub-id-type="pmid"