<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:mml="http://www.w3.org/1998/Math/MathML" article-type="research-article" xml:lang="EN"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">PLoS ONE</journal-id><journal-id journal-id-type="publisher-id">plos</journal-id><journal-id journal-id-type="pmc">plosone</journal-id><journal-title>PLoS ONE</journal-title><issn pub-type="epub">1932-6203</issn><publisher><publisher-name>Public Library of Science</publisher-name><publisher-loc>San Francisco, USA</publisher-loc></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">18974833</article-id><article-id pub-id-type="pmc">2571995</article-id><article-id pub-id-type="publisher-id">08-PONE-RA-05100R1</article-id><article-id pub-id-type="doi">10.1371/journal.pone.0003583</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research Article</subject></subj-group><subj-group subj-group-type="Discipline"><subject>Biotechnology</subject><subject>Cardiovascular Disorders</subject><subject>Genetics and Genomics</subject></subj-group></article-categories><title-group><article-title>Concept, Design and Implementation of a Cardiovascular Gene-Centric 50 K SNP Array for Large-Scale Genomic Association Studies</article-title><alt-title alt-title-type="running-head">IBC Array Tech Spec Paper</alt-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Keating</surname><given-names>Brendan J.</given-names></name><xref ref-type="aff" rid="aff1"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name><surname>Tischfield</surname><given-names>Sam</given-names></name><xref ref-type="aff" rid="aff2"><sup>2</sup></xref><xref ref-type="aff" rid="aff3"><sup>3</sup></xref></contrib><contrib contrib-type="author"><name><surname>Murray</surname><given-names>Sarah S.</given-names></name><xref ref-type="aff" rid="aff4"><sup>4</sup></xref></contrib><contrib contrib-type="author"><name><surname>Bhangale</surname><given-names>Tushar</given-names></name><xref ref-type="aff" rid="aff5"><sup>5</sup></xref></contrib><contrib contrib-type="author"><name><surname>Price</surname><given-names>Thomas S.</given-names></name><xref ref-type="aff" rid="aff6"><sup>6</sup></xref></contrib><contrib contrib-type="author"><name><surname>Glessner</surname><given-names>Joseph T.</given-names></name><xref ref-type="aff" rid="aff7"><sup>7</sup></xref></contrib><contrib contrib-type="author"><name><surname>Galver</surname><given-names>Luana</given-names></name><xref ref-type="aff" rid="aff10"><sup>10</sup></xref></contrib><contrib contrib-type="author"><name><surname>Barrett</surname><given-names>Jeffrey C.</given-names></name><xref ref-type="aff" rid="aff8"><sup>8</sup></xref></contrib><contrib contrib-type="author"><name><surname>Grant</surname><given-names>Struan F. A.</given-names></name><xref ref-type="aff" rid="aff7"><sup>7</sup></xref></contrib><contrib contrib-type="author"><name><surname>Farlow</surname><given-names>Deborah N.</given-names></name><xref ref-type="aff" rid="aff2"><sup>2</sup></xref></contrib><contrib contrib-type="author"><name><surname>Chandrupatla</surname><given-names>Hareesh R.</given-names></name><xref ref-type="aff" rid="aff9"><sup>9</sup></xref></contrib><contrib contrib-type="author"><name><surname>Hansen</surname><given-names>Mark</given-names></name><xref ref-type="aff" rid="aff10"><sup>10</sup></xref></contrib><contrib contrib-type="author"><name><surname>Ajmal</surname><given-names>Saad</given-names></name><xref ref-type="aff" rid="aff9"><sup>9</sup></xref></contrib><contrib contrib-type="author"><name><surname>Papanicolaou</surname><given-names>George J.</given-names></name><xref ref-type="aff" rid="aff11"><sup>11</sup></xref></contrib><contrib contrib-type="author"><name><surname>Guo</surname><given-names>Yiran</given-