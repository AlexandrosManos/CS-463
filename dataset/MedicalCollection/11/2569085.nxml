</ref><ref id="b7-ehp-116-1294"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fresquet</surname><given-names>F</given-names></name><name><surname>Pourageaud</surname><given-names>F</given-names></name><name><surname>Leblais</surname><given-names>V</given-names></name><name><surname>Brandes</surname><given-names>RP</given-names></name><name><surname>Savineau</surname><given-names>JP</given-names></name><name><surname>Marthan</surname><given-names>R</given-names></name><etal/></person-group><year>2006</year><article-title>Role of reactive oxygen species and gp91phox in endothelial dysfunction of pulmonary arteries induced by chronic hypoxia</article-title><source>Br J Pharmacol</source><volume>148</volume><fpage>714</fpage><lpage>723</lpage><pub-id pub-id-type="pmid">16715116</pub-id></citation></ref><ref id="b8-ehp-116-1294"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Friebe</surname><given-names>A</given-names></name><name><surname>Koesling</surname><given-names>D</given-names></name></person-group><year>2003</year><article-title>Regulation of nitric oxide-sensitive guanylyl cyclase</article-title><source>Circ Res</source><volume>93</volume><fpage>96</fpage><lpage>105</lpage><pub-id pub-id-type="pmid">12881475</pub-id></citation></ref><ref id="b9-ehp-116-1294"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gewaltig</surname><given-names>MT</given-names></name><name><surname>Kojda</surname><given-names>G</given-names></name></person-group><year>2002</year><article-title>Vasoprotection by nitric oxide: mechanisms and therapeutic potential</article-title><source>Cardiovasc Res</source><volume>55</volume><fpage>250</fpage><lpage>260</lpage><pub-id pub-id-type="pmid">12123764</pub-id></citation></ref><ref id="b10-ehp-116-1294"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Greenberg</surname><given-names>S</given-names></name><name><surname>Xie</surname><given-names>J</given-names></name><name><surname>Wang</surname><given-names>Y</given-names></name><name><surname>Cai</surname><given-names>B</given-names></name><name><surname>Kolls</surname><given-names>J</given-names></name><name><surname>Nelson</surname><given-names>S</given-names></name><etal/></person-group><year>1993</year><article-title>Tumor necrosis factor-alpha inhibits endothelium-dependent relaxation</article-title><source>J Appl Physiol</source><volume>74</volume><fpage>2394</fpage><lpage>2403</lpage><pub-id pub-id-type="pmid">8335573</pub-id></citation></ref><ref id="b11-ehp-116-1294"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hoek</surname><given-names>G</given-names></name><name><surname>Brunekreef</surname><given-names>B</given-names></name><name><surname>Fischer</surname><given-names>P</given-names></name><name><surname>van Wijnen</surname><given-names>J</given-names></name></person-group><year>2001</year><article-title>The association between air pollution and heart failure, arrhythmia, embolism, thrombosis, and other cardiovascular causes of death in a time series study</article-title><source>Epidemiology</source><volume>12</volume><fpage>355</fpage><lpage>357</lpage><pub-id pub-id-type="pmid">11337606</pub-id></citation></ref><ref id="b12-ehp-116-1294"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>AL</given-names></name><name><surname>Vita</surname><given-names>JA</given-names></name></person-group><year>2006</year><article-title>Effects of systemic inflammation on endothelium-dependent vasodilatation</article-title><source>Trends Cardiovasc Med</source><volume>16</volume><fpage>15</fpage><lpage>20</lpage><pub-id pub-id-type="pmid">16387625</pub-id></citation></ref><ref id="b13-ehp-116-1294"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>YC</given-names></name><name><surname>Wu</surname><given-names>W</given-names></name><name><surname>Ghio</surname><given-names>AJ</given-names></name><name><surname>Carter</surname><given-names>JD</given-names></name><name><surname>Silbajoris</surname><given-names>R</given-names></name><name><surname>Devlin</surname><given-names>RB</given-names></name><etal/></person-group><year>2002</year><article-title>Activation of EGF receptors mediates pulmonary vasoconstriction induced by residual oil fly ash</article-title><source>Exp Lung Res</source><volume>28</volume><fpage>19</fpage><lpage>38</lpage><pub-id pub-id-type="pmid">11792073</pub-id></citation></ref><ref id="b14-ehp-116-1294"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ikeda</surname><given-names>M</given-names></name><name><surname>Suzuki</surname><given-names>M</given-names></name><name><surname>Watarai</surname><given-names>K</given-names></name><name><surname>Sagai</surname><given-names>M</given-names></name><name><surname>Tomita</surname><given-names>T</given-names></name></person-group><year>1995</year><article-title>Impairment of endothelium-dependent relaxation by diesel exhaust particles in rat thoracic aorta</article-title><source>Jpn J Pharmacol</source><volume>68</volume><fpage>183</fpage><lpage>189</lpage><pub-id pub-id-type="pmid">7563975</pub-id></citation></ref><ref id="b15-ehp-116-1294"><citation citation-type="book"><collab>Institute of Laboratory Animal Resources</collab><year>1996</year><source>Guide for the Care and Use of Laboratory Animals</source><edition>7</edition><publisher-loc>Washington, DC</publisher-loc><publisher-name>National Academy Press</publisher-name></citation></ref><ref id="b16-ehp-116-1294"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jim&#x000e9;nez-Altay&#x000f3;</surname><given-names>F</given-names></name><name><surname>Briones</surname><given