son-group person-group-type="author"><name><surname>Tambay</surname><given-names>JL</given-names></name><name><surname>Catlin</surname><given-names>G</given-names></name></person-group><year>1995</year><article-title>Sample design of the national population health survey</article-title><source>Health Rep</source><volume>7</volume><fpage>29</fpage><lpage>38</lpage><fpage>31</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">7578995</pub-id></citation></ref><ref id="pmed-0050211-b019"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johansen</surname><given-names>H</given-names></name><name><surname>Nguyen</surname><given-names>K</given-names></name><name><surname>Mao</surname><given-names>L</given-names></name><name><surname>Marcoux</surname><given-names>R</given-names></name><name><surname>Gao</surname><given-names>R</given-names></name><etal/></person-group><year>2004</year><article-title>Influenza vaccination</article-title><source>Health Rep</source><volume>15</volume><fpage>33</fpage><lpage>43</lpage><pub-id pub-id-type="pmid">15151029</pub-id></citation></ref><ref id="pmed-0050211-b020"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johansen</surname><given-names>H</given-names></name><name><surname>Sambell</surname><given-names>C</given-names></name><name><surname>Zhao</surname><given-names>H</given-names></name></person-group><year>2006</year><article-title>Flu shots - national and provincial/territorial trends</article-title><source>Health Rep</source><volume>17</volume><fpage>49</fpage><lpage>54</lpage><pub-id pub-id-type="pmid">16335693</pub-id></citation></ref><ref id="pmed-0050211-b021"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kwong</surname><given-names>JC</given-names></name><name><surname>Sambell</surname><given-names>C</given-names></name><name><surname>Johansen</surname><given-names>H</given-names></name><name><surname