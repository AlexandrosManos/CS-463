r>                                                <mml:mtr>                                                   <mml:mtd>                                                      <mml:mn>0</mml:mn>                                                   </mml:mtd>                                                   <mml:mtd>                                                      <mml:mrow>                                                         <mml:mi>i</mml:mi>                                                         <mml:mi>f</mml:mi>                                                         <mml:mtext>&#x000a0;</mml:mtext>                                                         <mml:mi>f</mml:mi>                                                         <mml:mo stretchy="false">(</mml:mo>                                                         <mml:msubsup>                                                            <mml:mi>w</mml:mi>                                                            <mml:mrow>                                                               <mml:mi>k</mml:mi>                                                               <mml:mo>,</mml:mo>                                                               <mml:mi>t</mml:mi>                                                            </mml:mrow>                                                            <mml:mi>I</mml:mi>                                                         </mml:msubsup>                                                         <mml:mo stretchy="false">)</mml:mo>                                                         <mml:mo>=</mml:mo>                                                         <mml:mn>0</mml:mn>                                                         <mml:mtext>&#x000a0;</mml:mtext>                                                         <mml:mi>a</mml:mi>                                                         <mml:mi>n</mml:mi>                                                        