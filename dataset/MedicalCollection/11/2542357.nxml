<source>Stat Med</source><year>1999</year><volume>18</volume><fpage>3283</fpage><lpage>3298</lpage><pub-id pub-id-type="pmid">10602151</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1097-0258(19991215)18:23&#x0003c;3283::AID-SIM316&#x0003e;3.0.CO;2-Z</pub-id></citation></ref></ref-list></back></article>