</source><year>1997</year><volume>11</volume><fpage>468</fpage><lpage>72</lpage><pub-id pub-id-type="pmid">9260247</pub-id><pub-id pub-id-type="doi">10.1007/s004670050318</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Probst</surname><given-names>P</given-names></name><name><surname>Mahler</surname><given-names>F</given-names></name><name><surname>Krneta</surname><given-names>A</given-names></name><name><surname>Descoeudres</surname><given-names>C</given-names></name></person-group><article-title>Percutaneous transluminal dilatation for restoration of angioaccess in chronic hemodialysis patients</article-title><source>Cardiovasc and Interv Radiol</source><year>1982</year><volume>5</volume><fpage>257</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">6218875</pub-id><pub-id pub-id-type="doi">10.1007/BF02565407</pub-id></citation></ref></ref-list></back></article>