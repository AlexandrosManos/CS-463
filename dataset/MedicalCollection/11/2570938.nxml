/citation></ref><ref id="R8"><label>8. </label><citation citation-type="journal"><collab>World Health Organization Global Influenza Program Surveillance Network</collab> <article-title>Evolution of H5N1 avian influenza viruses in Asia.</article-title><source>Emerg Infect Dis</source> <year>2005</year>;<volume>11</volume>:<fpage>1515</fpage>&#x02013;<lpage>21</lpage><pub-id pub-id-type="pmid">16318689</pub-id></citation></ref><ref id="R9"><label>9. </label><citation citation-type="web"><collab>Food and Agricultural Organization of the United Nations</collab> Avian Influenza Disease Emergency Bulletin. <year>2006</year>; issue 43 [cited 2007 Oct 10]. Available from <ext-link ext-link-type="uri" xlink:href="http://www.fao.org/avianflu/en/AIDEnews.html">http://www.fao.org/avianflu/en/AIDEnews.html</ext-link></citation></ref><ref id="R10"><label>10. </label><citation citation-type="web"><string-name><surname>Zwickl</surname> <given-names>DJ</given-names></string-name> Genetic algorithm approaches for the phylogenetic analysis of large biological sequence datasets under the maximum likelihood criterion [dissertation]. Austin (TX): The University of Texas at Austin; <year>2006</year> Available from <ext-link ext-link-type="uri" xlink:href="http://www.bio.utexas.edu/faculty/antisense/garli/Garli.html">www.bio.utexas.edu/faculty/antisense/garli/Garli.html</ext-link></citation></ref><ref id="R11"><label>11. </label><citation citation-type="journal"><string-name><surname>Buchy</surname> <given-names>P</given-names></string-name>, <string-name><surname>Mardy</surname> <given-names>S</given-names></string-name>, <string-name><surname>Vong</surname> <given-names>S</given-names></string-name>, <string-name><surname>Toyoda</surname> <given-names>T</given-names></string-name>, <string-name><surname>Aubin</surname> <given-names>JT</given-names></string-name>, <string-name><surname>Miller</surname> <given-names>M</given-names></string-name>, <etal/><article-title>Influenza A/H5N1 virus infection in humans in Cambodia.</article-title><source>J Clin Virol</source> <year>2007</year>;<volume>39</volume>:<fpage>164</fpage>&#x02013;<lpage>8</lpage> <pub-id pub-id-type="doi">10.1016/j.jcv.2007.04.010</pub-id><pub-id pub-id-type="pmid">17526430</pub-id></citation></ref><ref id="R12"><label>12. </label><citation citation-type="journal"><string-name><surname>Zhu</surname> <given-names>QY</given-names></string-name>, <string-name><surname>Qin</surname> <given-names>ED</given-names></string-name>, <string-name><surname>Wang</surname> <given-names>W</given-names></string-name>, <string-name><surname>Yu</surname> <given-names>J</given-names></string-name>, <string-name><surname>Liu</surname> <given-names>BH</given-names></string-name>, <string-name><surname>Hu</surname> <given-names>Y</given-names></string-name>, <etal/><article-title>Fatal infection with influenza A (H5N1) virus in China.</article-title><source>N Engl J Med</source> <year>2006</year>;<volume>354</volume>:<fpage>2731</fpage>&#x02013;<lpage>2</lpage> <pub-id pub-id-type="doi">10.1056/NEJMc066058</pub-id><pub-id pub-id-type="pmid">16790715</pub-id></citation></ref><ref id="R13"><label>13. </label><citation citation-type="journal"><string-name><surname>Stevens</surname> <given-names>J</given-names></string-name>, <string-name><surname>Blixt</surname> <given-names>O</given-names></string-name>, <string-name><surname>Tumpey</surname> <given-names>TM</given-names></string-name>, <string-name><surname>Taubenberger</surname> <given-names>JK</given-names></string-name>, <string-name><surname>Paulson</surname> <given-names>JC</given-names></string-name>, <string-name><surname>Wilson</surname> <given-names>IA</given-names></string-name> <article-title>Structure and receptor specificity of the hemagglutinin from and H5N1 influenza virus.</article-title><source>Science</source> <year>2006</year>;<volume>312</volume>:<fpage>404</fpage>&#x02013;<lpage>10</lpage> <pub-id pub-id-type="doi">10.1126/science.1124513</pub-id><pub-id pub-id-type="pmid">16543414</pub-id></citation></ref><ref id="R14"><label>14. </label><citation citation-type="journal"><string-name><surname>Yamada</surname> <given-names>S</given-names></string-name>, <string-name><surname>Suzuki</surname> <given-names>Y</given-names></string-name>, <string-name><surname>Suzuki</surname> <given-names>T</given-names></string-name>, <string-name><surname>Le</surname> <given-names>MQ</given-names></string-name>, <string-name><surname>Nidom</surname> <given-names>CA</given-names></string-name>, <string-name><surname>Sakai-Tagawa</surname> <given-names>Y</given-names></string-name>, <etal/><article-title>Haemagglutinin mutations responsible for the binding of H5N1 influenza A viruses to human-type receptors.</article-title><source>Nature</source> <year>2006</year>;<volume>444</volume>:<fpage>378</fpage>&#x02013;<lpage>82</lpage> <pub-id pub-id-type="doi">10.1038/nature05264</pub-id><pub-id pub-id-type="pmid">17108965</pub-id></citation></ref><ref id="R15"><label>15. </label><citation citation-type="journal"><string-name><surname>Cheung</surname> <given-names>CL</given-names></string-name>, <string-name><surname>Rayner</surname> <given-names>JM</given-names></string-name>, <string-name><surname>Smith</surname> <given-names>GJD</given-names></string-name>, <string-name><surname>Wang</surname> <given-names>P</given-names></string-name>, <string-name><surname>Naipospos</surname> <given-names>TSP</given-names></string-name>, <string-name><surname>Zhang</surname> <given-names>J</given-names></string-name>, <etal/><article-title>Distribution of amantadine-resistant H5N1 avian influenza variants in Asia.</article-title><source>J Infect Dis</source> <year>2006</year>;<volume>193</volume>:<fpage>1626</fpage>&#x02013;<lpage>9</lpage> <pub-id pub-id-type="doi">10.1086/504723</pub-id><pub-id pub-id-type="pmid">16703504</pub-id></citation></ref></ref-list></back></article>