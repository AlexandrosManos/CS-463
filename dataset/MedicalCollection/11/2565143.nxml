<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:mml="http://www.w3.org/1998/Math/MathML" xml:lang="EN" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">J Neural Transplant Plast</journal-id><journal-id journal-id-type="publisher-id">NP</journal-id><journal-title>Journal of Neural Transplantation &#x00026; Plasticity</journal-title><issn pub-type="ppub">0792-8483</issn><publisher><publisher-name>Hindawi Publishing Corporation</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">1515481</article-id><article-id pub-id-type="pmc">2565143</article-id><article-id pub-id-type="doi">10.1155/NP.1992.135</article-id><article-categories><subj-group subj-group-type="heading"><subject>Article</subject></subj-group></article-categories><title-group><article-title>Estrogen Receptors are Present in Neocortical Transplants</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Pedersen</surname><given-names>Erik B.</given-names></name><xref ref-type="aff" rid="I1"><sup>1, 2</sup></xref><xref ref-type="aff" rid="I2"/><xref ref-type="corresp" rid="cor1">*</xref></contrib><contrib contrib-type="author"><name><surname>O'Keefe</surname><given-names>Joan A.</given-names></name><xref ref-type="aff" rid="I1"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name><surname>Handa</surname><given-names>Robert J.</given-names></name><xref ref-type="aff" rid="I1"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name><surname>Castro</surname><given-names>Anthony J.</given-names></name><xref ref-type="aff" rid="I1"><sup>1</sup></xref></contrib></contrib-group><aff id="I1"><sup>1</sup>Department of Cell Biology, Neurobiology and Anatomy, Loyola University Stritch School of Medicine, Maywood, IL 60153, USA</aff><aff id="I2"><sup>2</sup>pharmaBiotec, Institute of Neurobiology, University of Aarhus, Aarhus C DK-8000, Denmark</aff><author-notes><corresp id="cor1">*Erik B. Pedersen</corresp></author-notes><pub-date pub-type="ppub"><year>1992</year></pub-date><volume>3</volume><issue>2-3</issue><fpage>135</fpage><lpage>138</lpage><permissions><copyright-statement>Copyright &#x000a9; 1992.</copyright-statement><copyright-year>1992</copyright-year></permissions><abstract><p>Fetal neocortical tissue was grafted intoneocortical lesion cavities made in newborn rats.After two weeks survival, <italic>in vitro</italic> binding of [<sup>3</sup>H]-estradiol to cytosolic preparations provided evidence of estrogen receptors within the transplants. The observed high levels correspond to previous work demonstrating elevated estrogenreceptor levels during the first postnatal week in the rat cerebral cortex.</p></abstract></article-meta></front></article>