rname>Lucas</surname><given-names>AR</given-names></name></person-group><source>Thromb. Haemost</source><year>2006</year><volume>95</volume><issue>3</issue><fpage>499</fpage><lpage>510</lpage><pub-id pub-id-type="pmid">16525579</pub-id></element-citation></ref><ref id="R6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lomas</surname><given-names>DA</given-names></name><name><surname>Evans</surname><given-names>DL</given-names></name><name><surname>Upton</surname><given-names>C</given-names></name><name><surname>McFadden</surname><given-names>G</given-names></name><name><surname>Carrell</surname><given-names>RW</given-names></name></person-group><source>J. Biol. Chem</source><year>1993</year><volume>268</volume><issue>1</issue><fpage>516</fpage><lpage>521</lpage><pub-id pub-id-type="pmid">8416956</pub-id></element-citation></ref><ref id="R7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nash</surname><given-names>P</given-names></name><name><surname>Whitty</surname><given-names>A</given-names></name><name><surname>Handwerker</surname><given-names>J</given-names></name><name><surname>Macen</surname><given-names>J</given-names></name><name><surname>McFadden</surname><given-names>G</given-names></name></person-group><source>J. Biol. Chem</source><year>1998</year><volume>273</volume><issue>33</issue><fpage>20982</fpage><lpage>20991</lpage><pub-id pub-id-type="pmid">9694848</pub-id></element-citation></ref><ref id="R8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dai</surname><given-names>E</given-names></name><name><surname>Viswanathan</surname><given-names>K</given-names></name><name><surname>Sun</surname><given-names>YM</given-names></name><name><surname>Li</surname><given-names>X</given-names></name><name><surname>Liu</surname><given-names>L</given-names></n