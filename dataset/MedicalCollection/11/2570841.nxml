<volume>44</volume>:<fpage>4363</fpage>&#x02013;<lpage>70</lpage> <pub-id pub-id-type="doi">10.1128/JCM.00680-06</pub-id><pub-id pub-id-type="pmid">17035490</pub-id></citation></ref><ref id="R4"><label>4. </label><citation citation-type="journal"><string-name><surname>Brew</surname> <given-names>SD</given-names></string-name>, <string-name><surname>Perrett</surname> <given-names>LL</given-names></string-name>, <string-name><surname>Stack</surname> <given-names>JA</given-names></string-name>, <string-name><surname>Macmillan</surname> <given-names>AP</given-names></string-name>, <string-name><surname>Staunton</surname> <given-names>NJ</given-names></string-name> <article-title>Human exposure to <italic>Brucella</italic> recovered from a sea mammal.</article-title><source>Vet Rec</source> <year>1999</year>;<volume>144</volume>:<fpage>483</fpage><pub-id pub-id-type="pmid">10358880</pub-id></citation></ref><ref id="R5"><label>5. </label><citation citation-type="journal"><string-name><surname>Whatmore</surname> <given-names>AM</given-names></string-name>, <string-name><surname>Perrett</surname> <given-names>LL</given-names></string-name>, <string-name><surname>Macmillan</surname> <given-names>AP</given-names></string-name> <article-title>Characterisation of the genetic diversity of <italic>Brucella</italic> by multilocus sequencing.</article-title><source>BMC Microbiol</source> <year>2007</year>;<volume>7</volume>:<fpage>34</fpage> <pub-id pub-id-type="doi">10.1186/1471-2180-7-34</pub-id><pub-id pub-id-type="pmid">17448232</pub-id></citation></ref><ref id="R6"><label>6. </label><citation citation-type="journal"><string-name><surname>Ewalt</surname> <given-names>DR</given-names></string-name>, <string-name><surname>Payeur</surname> <given-names>JB</given-names></string-name>, <string-name><surname>Martin</surname> <given-names>BM</given-names></string-name>, <string-name><surname>Cummins</surname> <given-names>DR</given-names></string-name>, <string-name><surname>Miller</s