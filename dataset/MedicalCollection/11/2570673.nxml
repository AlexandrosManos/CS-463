ame><given-names>D</given-names></name><name><surname>Bertozzi</surname><given-names>CR</given-names></name></person-group><article-title>New directions in glycoprotein engineering</article-title><source>Tetrahedron</source><year>2000</year><volume>56</volume><fpage>9515</fpage><lpage>9525</lpage><pub-id pub-id-type="doi">10.1016/S0040-4020(00)00836-X</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hevehan</surname><given-names>DL</given-names></name><name><surname>De Bernardez Clark</surname><given-names>E</given-names></name></person-group><article-title>Oxidative renaturation of lysozyme at high concentrations</article-title><source>Biotechnol Bioeng</source><year>1997</year><volume>54</volume><fpage>221</fpage><lpage>230</lpage><pub-id pub-id-type="pmid">18634088</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1097-0290(19970505)54:3&#x0003c;221::AID-BIT3&#x0003e;3.0.CO;2-H</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rudolph</surname><given-names>R</given-names></name><name><surname>Lilie</surname><given-names>H</given-names></name></person-group><article-title>In vitro folding of inclusion body proteins</article-title><source>FASEB J</source><year>1996</year><volume>10</volume><fpage>49</fpage><lpage>56</lpage><pub-id pub-id-type="pmid">8566547</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Bernardez Clark</surname><given-names>E</given-names></name></person-group><article-title>Refolding of recombinant proteins</article-title><source>Curr Opin Biotechn</source><year>1998</year><volume>9</volume><fpage>157</fpage><lpage>163</lpage><pub-id pub-id-type="doi">10.1016/S0958-1669(98)80109-2</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kalia</surname><given-names>J</given-names></name><name><surname>Raines</surname><given-names>RT</given-names></name></person-group><article-title>Reactivity of intein thioesters: appending a functional group to a protein</article-title><source>Chem Bio Chem</source><year>2006</year><volume>7</volume><fpage>1375</fpage><lpage>1383</lpage><pub-id pub-id-type="pmid">16897799</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sydor</surname><given-names>JR</given-names></name><name><surname>Mariano</surname><given-names>M</given-names></name><name><surname>Sideris</surname><given-names>S</given-names></name><name><surname>Nock</surname><given-names>S</given-names></name></person-group><article-title>Establishment of Intein-Mediated Protein Ligation under Denaturing Conditions: C-Terminal Labeling of a Single-Chain Antibody for Biochip Screening</article-title><source>Bioconjugate Chem</source><year>2002</year><volume>13</volume><fpage>707</fpage><lpage>712</lpage><pub-id pub-id-type="doi">10.1021/bc025534z</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brzezinska</surname><given-names>E</given-names></name></person-group><article-title>Disulfides. 1. Syntheses using 2,2'-dithiobis(benzothiazole)</article-title><source>J Org Chem</source><year>1994</year><volume>59</volume><fpage>8239</fpage><lpage>8244</lpage><pub-id pub-id-type="doi">10.1021/jo00105a048</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Raines</surname><given-names>RT</given-names></name></person-group><article-title>Ribonuclease A</article-title><source>Chem Rev</source><year>1998</year><volume>98</volume><fpage>1045</fpage><lpage>1065</lpage><pub-id pub-id-type="pmid">11848924</pub-id><pub-id pub-id-type="doi">10.1021/cr960427h</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kelemen</surname><given-names>BR</given-names></name><name><surname>Klink</surname><given-names>TA</given-names></name><name><surname>Behlke</surname><given-names>MA</given-names></name><name><surname>Eubanks</surname><given-names>SR</given-names></name><name><surname>Leland</surname><given-names>PA</given-names></name><name><surname>Raines</surname><given-names>RT</given-names></name></person-group><article-title>Hypersensitive substrate for ribonucleases</article-title><source>Nucl Acid Res</source><year>1999</year><volume>27</volume><fpage>3696</fpage><lpage>3701</lpage><pub-id pub-id-type="doi">10.1093/nar/27.18.3696</pub-id></citation></ref></ref-list></back></article>