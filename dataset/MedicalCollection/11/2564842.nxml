</td><td align="char" rowspan="1" colspan="1">1423</td><td align="char" rowspan="1" colspan="1">35.1</td><td align="char" rowspan="1" colspan="1">268</td><td align="char" rowspan="1" colspan="1">27.4</td><td align="char" rowspan="1" colspan="1">1756</td><td align="char" rowspan="1" colspan="1">33.1</td><td align="char" rowspan="1" colspan="1">572</td><td align="char" rowspan="1" colspan="1">30.8</td><td align="char" rowspan="1" colspan="1">1184</td><td align="char" rowspan="1" colspan="1">34.3</td></tr><tr><td align="left" rowspan="1" colspan="1">Sex</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x000a0;&#x000a0;&#x000a0;&#x000a0;Male</td><td align="char" rowspan="1" colspan="1">2029</td><td align="char" rowspan="1" colspan="1">49.1</td><td align="char" rowspan="1" colspan="1">443</td><td align="char" rowspan="1" colspan="1">43.9</td><td align="char" rowspan="1" colspan="1">3270</td><td align="char" rowspan="1" colspan="1">60.6**</td><td align="char" rowspan="1" colspan="1">1017</td><td align="char" rowspan="1" colspan="1">53.3</td><td align="char" rowspan="1" colspan="1">2253</td><td align="char" rowspan="1" colspan="1">64.5**</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x000a0;&#x000a0;&#x000a0;&#x000a0;Female</td><td align="char" rowspan="1" colspan="1">2104</td><td align="char" rowspan="1" colspan="1">50.9</td><td align="char" rowspan="1" colspan="1">567</td><td align="char" rowspan="1" colspan="1">56.1</td><td align="char" rowspan="1" colspan="1">2128</td><td align="char" rowspan="1" colspan="1">39.4</td><td align="char" rowspan=