me>19</volume><fpage>2507</fpage><lpage>2517</lpage><pub-id pub-id-type="pmid">5086240</pub-id></citation></ref><ref id="bib69"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fust</surname><given-names>A</given-names></name><name><surname>Pauls</surname><given-names>J</given-names></name><name><surname>Augath</surname><given-names>M</given-names></name><name><surname>Murayama</surname><given-names>Y</given-names></name><name><surname>Oeltermann</surname><given-names>A</given-names></name><name><surname>Logothetis</surname><given-names>NK</given-names></name></person-group><article-title>The influence of anaesthetic agents on neural activity in visual cortex revealed by electrophysiology and high-resolution functional MRI</article-title><source>33rd Society for Neuroscience Meeting</source><volume>69</volume><fpage>14</fpage></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gaohong</surname><given-names>W</given-names></name><name><surname>Feng</surname><given-names>L</given-names></name><name><surname>Zhu</surname><given-names>L</given-names></name><name><surname>Xiaoli</surname><given-names>Z</given-names></name><name><surname>Shi-Jiang</surname><given-names>L</given-names></name></person-group><article-title>Transient relationships among BOLD, CBV, and CBF changes in rat brain as detected by functional MRI</article-title><source>Magn Reson Med.</source><year>2002</year><volume>48</volume><fpage>987</fpage><lpage>993</lpage><pub-id pub-id-type="pmid">12465108</pub-id></citation></ref><ref id="bib18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gjedde</surname><given-names>A</given-names></name><name><surname>Marrett</surname><given-names>S</given-names></name><name><surname>Vafaee</surname><given-names>M</given-names></name></person-group><article-title>Oxidative and nonoxidative metabolism of excited neurons and astrocytes</article-title><source>J Cereb Blood Flow Metab.</source><year>2002</year><volume>22</volume><fpage>1</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">11807388</pub-id></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grubb</surname><given-names>RL</given-names><suffix>Jr</suffix></name><name><surname>Raichle</surname><given-names>ME</given-names></name><name><surname>Eichling</surname><given-names>JO</given-names></name><name><surname>Ter-Pogossian</surname><given-names>MM</given-names></name></person-group><article-title>The effects of changes in PaCO2 on cerebral blood volume, blood flow, and vascular mean transit time</article-title><source>Stroke.</source><year>1974</year><volume>5</volume><fpage>630</fpage><lpage>639</lpage><pub-id pub-id-type="pmid">4472361</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hoge</surname><given-names>RD</given-names></name><name><surname>Atkinson</surname><given-names>J</given-names></name><name><surname>Gill</surname><given-names>B</given-names></name><name><surname>Crelier</surname><given-names>GR</given-names></name><name><surname>Marrett</surname><given-names>S</given-names></name><name><surname>Pike</surname><given-names>GB</given-names></name></person-group><article-title>Linear coupling between cerebral blood flow and oxygen consumption in activated human cortex</article-title><source>Proc Natl Acad Sci USA.</source><year>1999</year><volume>96</volume><fpage>9403</fpage><lpage>9408</lpage><pub-id pub-id-type="pmid">10430955</pub-id></citation></ref><ref id="bib21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Horvath</surname><given-names>I</given-names></name><name><surname>Sandor</surname><given-names>NT</given-names></name><name><surname>Ruttner</surname><given-names>Z</given-names></name><name><surname