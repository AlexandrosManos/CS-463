ge>41</lpage></citation></ref><ref id="b15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hirsch</surname><given-names>RJ</given-names></name><name><surname>Lupo</surname><given-names>M</given-names></name><name><surname>Cohen</surname><given-names>JL</given-names></name><name><surname>Duffy</surname><given-names>D</given-names></name></person-group><article-title>Case Reports: delayed presentation of impending necrosis following soft tissue augmentation with hyaluronic acid and successful management with hyaluronidase</article-title><source>J Drugs Dermatol</source><year>2007</year><volume>6</volume><fpage>325</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">17373195</pub-id></citation></ref><ref id="b16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>H&#x000f6;nig</surname><given-names>JF</given-names></name><name><surname>Brink</surname><given-names>U</given-names></name><name><surname>Korabiowska</surname><given-names>M</given-names></name></person-group><article-title>Severe granulomatous allergic tissue reaction after hyaluronic acid injection in the treatment of facial lines and its surgical correction</article-title><source>J Craniof Surg</source><year>2003</year><volume>14</volume><fpage>197</fpage><lpage>200</lpage></citation></ref><ref id="b17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johl</surname><given-names>SS</given-names></name><name><surname>Burgett</surname><given-names>RA</given-names></name></person-group><article-title>Dermal filler agents: a practical review</article-title><source>Curr Opin Ophthalmol</source><year>2006</year><volume>14</volume><fpage>471</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">16932063</pub-id></citation></ref><ref id="b18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kane</surname><given-names>MAC</given-names></name></person-group><article-title>Advanced techniques for using Restylane in the lower eyelids</article-title><source>Aesthetic Surg</source><year>2007</year><volume>27</volume><fpage>90</fpage><lpage>2</lpage></citation></ref><ref id="b19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kelly</surname><given-names>PE</given-names></name></person-group><article-title>Injectable success: from fillers to Botox</article-title><source>Facial Plast Surg</source><year>2007</year><volume>23</volume><fpage>7</fpage><lpage>18</lpage><pub-id pub-id-type="pmid">17330767</pub-id></citation></ref><ref id="b20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Little</surname><given-names>JW</given-names></name></person-group><article-title>Volumetric perceptions in midfacial aging with altered priorities for rejuvenation</article-title><source>Plast Reconstr Surg</source><year>2000</year><volume>105</volume><fpage>252</fpage><lpage>66</lpage><pub-id pub-id-type="pmid">10626998</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lowe</surname><given-names>NJ</given-names></name><name><surname>Maxwell</surname><given-names>CA</given-names></name><name><surname>Patanaik</surname><given-names>R</given-names></name></person-group><article-title>Adverse reactions to dermal fillers: review</article-title><source>Dermatol Surg</source><year>2005</year><volume>31</volume><fpage>1616</fpage><lpage>25</lpage><pub-id pub-id-type="pmid">16416647</pub-id></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lupo</surname><given-names>MP</given-names></name></person-group><article-title>Hyaluronic acid fillers in facial rejuvenation</article-title><source>Semin Cutan Med Surg</source><year>2006</year><volume>25</volume><fpage>122</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">17055390</pub-id></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matarasso</surname><given-names>SL</given-names></name><name><surname>Carruthers</surname><given-names>JD</given-names></name><name><surname>Jewell</surname><given-names>ML</given-names></name></person-group><collab>the Restylane Consensus Group</collab><article-title>Consensus recommendations for soft tissue augmentation with nonanimal stabilized hyaluronic acid (Restylane)</article-title><source>Plast Reconstr Surg</source><year>2006</year><volume>117</volume><fpage>3S</fpage><lpage>34S</lpage><pub-id pub-id-type="pmid">16531934</pub-id></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Monheit</surname><given-names>GD</given-names></name></person-group><article-title>Hylaform: a new hyaluronic acid filler in soft tissue augmentation</article-title><source>Facial Plast Surg</source><year>2004</year><volume>20</volume><fpage>153</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15643583</pub-id></citation></ref><ref id="b25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Monheit</surname><given-names>GD</given-names></name><name><surname>Coleman</surname><given-names>KM</given-names></name></person-group><article-title>Hyaluronic acid fillers</article-title><source>Dermatol Ther</source><year>2006</year><volume>16</volume><fpage>141</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">16784513</pub-id></citation></ref><ref id="b26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Narins</surname><given-names>RS</given-names></name><name><surname>Bowman</surname><given-names>PH</given-names></name></person-group><article-title>Injectable skin fillers</article-title><source>Clin Plast Surg</source><year>2005</year><volume>32</volume><fpage>151</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">158