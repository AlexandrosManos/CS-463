ume><fpage>537</fpage><lpage>542</lpage><pub-id pub-id-type="pmid">16121763</pub-id><pub-id pub-id-type="doi">10.1007/s10654-005-4263-x</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Davis</surname><given-names>MA</given-names></name><name><surname>Neuhaus</surname><given-names>JM</given-names></name><name><surname>Ettinger</surname><given-names>WH</given-names></name><name><surname>Mueller</surname><given-names>WH</given-names></name></person-group><article-title>Body fat distribution and osteoarthritis</article-title><source>Am J Epidemiol</source><year>1990</year><volume>132</volume><fpage>701</fpage><lpage>707</lpage><pub-id pub-id-type="pmid">2403110</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hochberg</surname><given-names>MC</given-names></name><name><surname>Lethbridge-Cejku</surname><given-names>M</given-names></name><name><surname>Plato</surname><given-names>CC</given-names></name><name><surname>Wigley</surname><given-names>FM</given-names></name><name><surname>Tobin</surname><given-names>JD</given-names></name></person-group><article-title>Factors associated with osteoarthritis of the hand in males: data from the Baltimore Longitudinal Study of Aging</article-title><source>Am J Epidemiol</source><year>1991</year><volume>134</volume><fpage>1121</fpage><lpage>1127</lpage><pub-id pub-id-type="pmid">1746522</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hochberg</surname><given-names>MC</given-names></name><name><surname>Lethbridge-Cejku</surname><given-names>M</given-names></name><name><surname>Scott</surname><given-names>WW</given-names><suffix>Jr</suffix></name><name><surname>Plato</surname><given-names>CC</given-names></name><name><surname>Tobin</surname><given-names>JD</given-names></name></person-group><artic