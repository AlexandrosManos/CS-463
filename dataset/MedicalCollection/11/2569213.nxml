" rowspan="1" colspan="1">Convergent</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">(ii) No</td><td align="left" rowspan="1" colspan="1">(ii) Yes</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Strabismus operated on</td></tr><tr><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">M</td><td align="left" rowspan="1" colspan="1">BL &#x0201c;central anterior polar capsular&#x0201d; developmental</td><td align="left" rowspan="1" colspan="1">10 years</td><td align="left" rowspan="1" colspan="1">Yes</td><td align="left" rowspan="1" colspan="1">(i) No</td><td align="left" rowspan="1" colspan="1">(i) No</td><td align="left" rowspan="1" colspan="1">No</td><td align="left" rowspan="1" colspan="1">Zonular</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">1/12</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">(ii) No</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Rupture</td></tr><tr><td align="left" rowspan="1" colspan="1">10</td><td align="left" rowspan="1" colspan="1">F</td><td align="left" rowspan="1" colspan="1">Congenital</td><td align="left" rowspan="1" colspan="1">10/12</td><td align="left" rowspan="1" colspan="1">Yes</td><td align="left" rowspan="1" colspan="1">(i) Yes</td><td align="left" rowspan="1" colspan="1">(i) No</td><td align="left" rowspan="1" colspan="1">No</td><td align="left" rowspan="1" colspan="1">Exotropia</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowsp