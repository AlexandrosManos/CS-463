n="1" colspan="1">Mean corpuscular volume (fl): Pre-infection level</td><td align="left" rowspan="1" colspan="1">77.8</td><td align="left" rowspan="1" colspan="1">81.6</td><td align="left" rowspan="1" colspan="1">80.9</td><td align="left" rowspan="1" colspan="1">78.4</td><td align="left" rowspan="1" colspan="1">76.8</td><td align="left" rowspan="1" colspan="1">73.5</td><td align="left" rowspan="1" colspan="1">79.9</td><td align="left" rowspan="1" colspan="1">77.4</td><td align="left" rowspan="1" colspan="1">77.9</td></tr><tr><td align="left" rowspan="1" colspan="1">Mean corpuscular volume: &#x00025; change at 32 dpi</td><td align="left" rowspan="1" colspan="1">&#x02212;12.6</td><td align="left" rowspan="1" colspan="1">&#x02212;9.9</td><td align="left" rowspan="1" colspan="1">&#x02212;12.6</td><td align="left" rowspan="1" colspan="1">&#x0002b;2.0</td><td align="left" rowspan="1" colspan="1">&#x02212;2.5</td><td align="left" rowspan="1" colspan="1">&#x02212;1.1</td><td align="left" rowspan="1" colspan="1">&#x02212;11.1</td><td align="left" rowspan="1" colspan="1">&#x02212;6.8</td><td align="left" rowspan="1" colspan="1">&#x02212;0.7</td></tr><tr><td align="left" rowspan="1" colspan="1">Mean corpuscular volume: &#x00025; change at extremis</td><td align="left" rowspan="1" colspan="1">&#x02212;0.9</td><td align="left" rowspan="1" colspan="1">&#x02212;11.3</td><td align="left" rowspan="1" colspan="1">&#x0002b;1.1</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">&#x02212;1.6</td><td align="left" rowspan="1" colspan="1">&#x0002b;9.5</td><td align="left" rowspan="1" colspan="1">&#x02212;15.6</td><td align="left" rowspan="1" colspan="1">&#x02212;12.9</td><td align="left" rowspan="1" colspan="1">&#x02212;12.5</td></tr><tr><td align="left" rowspan="1" colspan="1">Mean corpuscular haemoglobin (pg): Pre-infection level</td><td align="left" rowspan="1" colspan="1">23.4</td><td align="left" rowspan="1" colspan="1">25.1</td><td align="left" row