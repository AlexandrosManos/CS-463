</source><volume>37</volume><fpage>137</fpage><lpage>141</lpage><pub-id pub-id-type="pmid">6106349</pub-id></citation></ref><ref id="pntd.0000238-Naessens1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Naessens</surname><given-names>J</given-names></name><name><surname>Mwangi</surname><given-names>DM</given-names></name><name><surname>Buza</surname><given-names>J</given-names></name><name><surname>Moloo</surname><given-names>SK</given-names></name></person-group><year>2003</year><article-title>Local skin reaction (chancre) induced following inoculation of metacyclic trypanosomes in cattle by tsetse flies is dependent on CD4 T lymphocytes.</article-title><source>Parasite Immunol</source><volume>25</volume><fpage>413</fpage><lpage>419</lpage><pub-id pub-id-type="pmid">14651588</pub-id></citation></ref><ref id="pntd.0000238-Morrison1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morrison</surname><given-names>WI</given-names></name><name><surname>Black</surname><given-names>PW</given-names></name><name><surname>Paris</surname><given-names>J</given-names></name><name><surname>Hinson</surname><given-names>CJ</given-names></name><name><surname>Wells</surname><given-names>PW</given-names></name></person-group><year>1982</year><article-title>Protective immunity and specificity by irradiated with <italic>T. brucei.</italic></article-title><source>Parasite Immunol</source><volume>4</volume><fpage>395</fpage><lpage>407</lpage><pub-id pub-id-type="pmid">7155625</pub-id></citation></ref><ref id="pntd.0000238-Smith1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>DH</given-names></name><name><surname>Bailey</surname><given-names>JW</given-names></name></person-group><year>1997</year><article-title>Human Africa trypanosomiasis in south Eastern Uganda: clinical diversity an