><name><surname>Baudouin</surname><given-names>C</given-names></name><name><surname>Pisella</surname><given-names>PJ</given-names></name><name><surname>Fillacier</surname><given-names>K</given-names></name><etal/></person-group> <article-title>Ocular surface inflammatory changes induced by topical antiglaucoma drugs: human and animal studies.</article-title> <source>Ophthalmology</source> <year>1999</year>;<volume>106</volume>:<fpage>556</fpage>&#x02013;<lpage>63</lpage><pub-id pub-id-type="pmid">10080214</pub-id></mixed-citation></ref><ref id="b28"><label>28</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mietz</surname><given-names>H</given-names></name><name><surname>Niesen</surname><given-names>U</given-names></name><name><surname>Krieglstein</surname><given-names>GK</given-names></name></person-group> <article-title>The effect of preservatives and antiglaucomatous medication on the histopathology of the conjunctiva.</article-title> <source>Graefes Arch Clin Exp Opthalmol</source> <year>1994</year>;<volume>232</volume>:<fpage>561</fpage>&#x02013;<lpage>5</lpage></mixed-citation></ref><ref id="b29"><label>29</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hamard</surname><given-names>P</given-names></name><name><surname>Blondin</surname><given-names>C</given-names></name><name><surname>Debbasch</surname><given-names>C</given-names></name><etal/></person-group> <article-title>In vitro effects of preserved and unpreserved antiglaucoma drugs on apoptotic marker expression by human trabecular cells.</article-title> <source>Graefes Arch Clin Exp Opthalmol</source> <year>2003</year>;<volume>241</volume>:<fpage>1037</fpage>&#x02013;<lpage>43</lpage></mixed-citation></ref><ref id="b30"><label>30</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Pisella</surname><given-names>PJ</given-names></name><name