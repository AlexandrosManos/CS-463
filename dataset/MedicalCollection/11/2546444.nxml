-type="journal"><person-group person-group-type="author"><name><surname>Kaiser</surname><given-names>E</given-names></name><name><surname>Colescott</surname><given-names>RL</given-names></name><name><surname>Bossinger</surname><given-names>CD</given-names></name><name><surname>Cook</surname><given-names>PI</given-names></name></person-group><year>1970</year><article-title>Color test for detection of free terminal amino groups in the solid-phase synthesis of peptides.</article-title><source>Anal Biochem.</source><volume>34</volume><fpage>595</fpage><lpage>598</lpage><pub-id pub-id-type="pmid">5443684</pub-id></citation></ref><ref id="pone.0003296-Oliveira1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oliveira</surname><given-names>VX</given-names><suffix>Jr</suffix></name><name><surname>F&#x000e1;zio</surname><given-names>MA</given-names></name><name><surname>Miranda</surname><given-names>MTM</given-names></name><name><surname>Silva</surname><given-names>JM</given-names></name><name><surname>Bittencourt</surname><given-names>JC</given-names></name><etal/></person-group><year>2005</year><article-title>Leptin fragments induce Fos immunoreactivity in rat hypothalamus.</article-title><source>Regulatory Peptides.</source><volume>127</volume><fpage>123</fpage><lpage>132</lpage><pub-id pub-id-type="pmid">15680478</pub-id></citation></ref><ref id="pone.0003296-Oliveira2"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oliveira</surname><given-names>VX</given-names><suffix>Jr</suffix></name><name><surname>Machado</surname><given-names>A</given-names></name><name><surname>F&#x000e1;zio</surname><given-names>MA</given-names></name><name><surname>Pesquero</surname><given-names>JB</given-names></name><name><surname>Santos</surname><given-names>RL</given-names></name><etal/></person-group><year>2003</year><article-title>Novel angiotensin II lactam bridge cyclic analogues.</article-title><source>Biopolymers.</source><volume>71</volume><fpage>372</fpage></citation></ref><ref id="pone.0003296-Oliveira3"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oliveira</surname><given-names>VX</given-names></name><name><surname>Fazio</surname><given-names>MA</given-names></name><name><surname>Santos</surname><given-names>EL</given-names></name><name><surname>Pesquero</surname><given-names>JB</given-names></name><name><surname>Miranda</surname><given-names>A</given-names></name></person-group><year>2008</year><article-title>In vitro evaluation of leptin fragments activity on the ob receptor.</article-title><source>Journal of Peptide Science.</source><volume>14</volume><fpage>617</fpage><lpage>625</lpage><pub-id pub-id-type="pmid">18008380</pub-id></citation></ref><ref id="pone.0003296-Jubilut1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jubilut</surname><given-names>GN</given-names></name><name><surname>Marcheto</surname><given-names>R</given-names></name><name><surname>Cilli</surname><given-names>EM</given-names></name><name><surname>Oliveira</surname><given-names>E</given-names></name><name><surname>Miranda</surname><given-names>A</given-names></name><etal/></person-group><year>1997</year><article-title>Comparative time course study of aminoacyl- and peptidyl-resin hydrolysis.</article-title><source>J Braz Chem Soc</source><volume>8</volume><fpage>65</fpage><lpage>70</lpage></citation></ref><ref id="pone.0003296-Fzio1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>F&#x000e1;zio</surname><given-names>MA</given-names></name><name><surname>Oliveira</surname><given-names>VX</given-names><suffix>Jr</suffix></name><name><surname>Bulet</surname><given-names>P</given-names></name><name><surname>Miranda</surname><given-names>MTM</given-names></name><name><surname>Daffre</surname><given-names>S</given-names></name><etal/></person-group><year>2006</year><article-title>Structure&#x02013;activity relationship studies of gomesin: importance of the disulfide bridges for conformation, bioactivities and serum stability.</article-title><source>Biopolymers.</source><volume>84</volume><fpage>205</fpage><lpage>218</lpage><pub-id pub-id-type="pmid">16235231</pub-id></citation></ref><ref id="pone.0003296-Thathy1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thathy</surname><given-names>V</given-names></name><name><surname>Severson</surname><given-names>DW</given-names></name><name><surname>Christensen</surname><given-names>BM</given-names></name></person-group><year>1994</year><article-title>Reinterpretation of the genetics of susceptibility of <italic>Aedes aegipty</italic> to <italic>Plasmodium gallinaceum</italic>.</article-title><source>Journal of Parasitology.</source><volume>80</volume><fpage>705</fpage><lpage>712</lpage><pub-id pub-id-type="pmid">7931905</pub-id></citation></ref><ref id="pone.0003296-Munstermann1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Munstermann</surname><given-names>LE</given-names></name><name><surname>Conn</surname><given-names>JE</given-names></name></person-group><year>1997</year><article-title>Systematics of mosquito disease vectors (Diptera, Culicidae): Impact of molecular biology and cladistic analysis.</article-title><source>Annual Review of Entomol.</source><volume>42</volume><fpage>351</fpage><lpage>369</lpage></citation></ref><ref id="pone.0003296-deLaraCapurro1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>de Lara Capurro</surname><given-names>M</given-names></name><name><surname>Coleman</surname><given-names>J</given-names></name><name><surname>Beerntsen</surname><given-names>BT</given-names></name><name><surname>Myles</surname><given-names>KM</given-names></name><name><surname>Olson</surname><given-names>KE</given-names></name><etal/></person-group><year>2000</year><article-title>Virus-expressed, recombinant single-chain antibody blocks sporozoite infection of salivary glands in Plasmodium gallinaceum-infected Aedes aegypti.</article-title><source>Am J Trop Med Hyg.</source><volume>62</volume><fpage>427</fpage><lpage>33</lpage><pub-id pub-id-type="pmid">11220756</pub-id></citation></ref></ref-list><fn-group><fn fn-type="conflict"><p><bold>Competing Interests: </bold>The authors have declared that no competing interests exist.</p></fn><fn fn-type="financial-disclosure"><p><bold>Funding: </bold>This work is supported by Funda&#x000e7;&#x000e3;o de Amparo a Pesquisa do Estado de S&#x000e3;o Paulo (FAPESP). A.M., C.M. and M.L.C. are fellows from CNPq.</p></fn></fn-group></back></article>