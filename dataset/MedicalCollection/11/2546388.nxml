><name><surname>Laplante</surname><given-names>DP</given-names></name><name><surname>Barr</surname><given-names>RG</given-names></name><name><surname>Brunet</surname><given-names>A</given-names></name><name><surname>Galbaud du Fort</surname><given-names>G</given-names></name><name><surname>Meaney</surname><given-names>ML</given-names></name><name><surname>Saucier</surname><given-names>JF</given-names></name><name><surname>Zelazo</surname><given-names>PR</given-names></name><name><surname>King</surname><given-names>S</given-names></name></person-group><article-title>Stress during pregnancy affects general intellectual and language functioning in human toddlers</article-title><source>Pediatr Res</source><year>2004</year><volume>56</volume><fpage>400</fpage><lpage>410</lpage><pub-id pub-id-type="pmid">15240860</pub-id><pub-id pub-id-type="doi">10.1203/01.PDR.0000136281.34035.44</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kinney</surname><given-names>DK</given-names></name><name><surname>Miller</surname><given-names>AM</given-names></name><name><surname>Crowley</surname><given-names>DJ</given-names></name><name><surname>Huang</surname><given-names>E</given-names></name><name><surname>Gerber</surname><given-names>E</given-names></name></person-group><article-title>Autism prevalence following prenatal exposure to hurricanes and tropical storms in Louisiana</article-title><source>J Autism Dev Disord</source><year>2008</year><volume>38</volume><fpage>481</fpage><lpage>488</lpage><pub-id pub-id-type="pmid">17619130</pub-id><pub-id pub-id-type="doi">10.1007/s10803-007-0414-0</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schneider</surname><given-names>ML</given-names></name><name><surname>Roughton</surname><given-names>EC</given-names></name><name><surname>Koehler</surname><given-names>AJ</given-names></name><n