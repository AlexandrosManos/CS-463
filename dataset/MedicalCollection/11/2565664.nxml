0-00006</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schachter</surname><given-names>J</given-names></name></person-group><article-title>Chlamydial Infections</article-title><source>N Engl J Med</source><year>1978</year><volume>298</volume><fpage>428</fpage><lpage>435</lpage><pub-id pub-id-type="pmid">340951</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnson</surname><given-names>RM</given-names></name></person-group><article-title>Murine oviduct epithelial cell cytokine responses to <italic>Chlamydia muridarum </italic>infection include interleukin-12-p70 secretion</article-title><source>Infect Immun</source><year>2004</year><volume>72</volume><fpage>3951</fpage><lpage>3960</lpage><pub-id pub-id-type="pmid">15213139</pub-id><pub-id pub-id-type="doi">10.1128/IAI.72.7.3951-3960.2004</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Steinmann</surname><given-names>RM</given-names></name></person-group><article-title>The dendritic cell system and its role in immunogenecity</article-title><source>Annu Rev Immunol</source><year>1991</year><volume>9</volume><fpage>271</fpage><lpage>276</lpage><pub-id pub-id-type="pmid">1910679</pub-id><pub-id pub-id-type="doi">10.1146/annurev.iy.09.040191.001415</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sallusto</surname><given-names>F</given-names></name><name><surname>Lanzavecchia</surname><given-names>A</given-names></name></person-group><article-title>Mobilizing dendritic cells for tolerance, priming and chronic inflammation</article-title><source>J Exp Med</source><year>1999</year><volume>189</volume><fpage>611</fpage><lpage>614</lpage><pub-id pub-id-type="pmid">9989975</pub-id><pub-id pub-id-type="doi">10.1