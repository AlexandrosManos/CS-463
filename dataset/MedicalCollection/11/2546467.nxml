</source><year>1999</year><volume>282</volume><fpage>1344</fpage><lpage>52</lpage><pub-id pub-id-type="pmid">10527181</pub-id></citation></ref><ref id="b19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harris</surname><given-names>ST</given-names></name><name><surname>Watts</surname><given-names>NB</given-names></name><name><surname>Li</surname><given-names>Z</given-names></name><etal/></person-group><article-title>Two-year efficacy and tolerability of risedronate once a week for the treatment of women with postmenopausal osteoporosis</article-title><source>Curr Med Res Opin</source><year>2004</year><volume>20</volume><fpage>757</fpage><lpage>64</lpage><comment>Erratum in: <italic>Curr Med Res Opin</italic>, 20:1690</comment><pub-id pub-id-type="pmid">15140343</pub-id></citation></ref><ref id="b20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Keen</surname><given-names>R</given-names></name><name><surname>Jodar</surname><given-names>E</given-names></name><name><surname>Iolascon</surname><given-names>G</given-names></name><etal/></person-group><article-title>European women&#x02019;s preference for osteoporosis treatment: influence of clinical effectiveness and dosing frequency</article-title><source>Curr Med Res Opin</source><year>2006</year><volume>22</volume><fpage>2375</fpage><lpage>81</lpage><pub-id pub-id-type="pmid">17257451</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kendler</surname><given-names>D</given-names></name><name><surname>Kung</surname><given-names>AW</given-names></name><name><surname>Fuleihan</surname><given-names>Gel-H</given-names></name><etal/></person-group><article-title>Patients with osteoporosis prefer once weekly to once daily dosing with alendronate</article-title><source>Maturitas</source><year>2004</year><volume>48</volume><fpage>243</fpage><lpage>51</lpage><pub-id