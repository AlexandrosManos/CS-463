" rules="groups"><thead><tr><th align="left">Region</th><th colspan="6" align="left">Right hand<hr/></th><th colspan="6" align="left">Left hand<hr/></th></tr><tr><th/><th align="left">Side</th><th colspan="3" align="left">Talairach coordinates in MNI space<hr/></th><th align="left"><italic>Z</italic>-value</th><th align="left">Correlation analysis (<italic>r</italic><sup>2</sup>)</th><th align="left">Side</th><th colspan="3" align="left">Talairach coordinates in MNI space<hr/></th><th align="left"><italic>Z</italic>-value</th><th align="left">Correlation analysis (<italic>r</italic><sup>2</sup>)</th></tr><tr><th/><th/><th align="left"><italic>x</italic></th><th align="left"><italic>y</italic></th><th align="left"><italic>z</italic></th><th/><th/><th/><th align="left"><italic>x</italic></th><th align="left"><italic>y</italic></th><th align="left"><italic>z</italic></th><th/><th/></tr></thead><tbody><tr><td colspan="13" align="left">Increasing dispersion with increasing age<sup>2</sup></td></tr><tr><td rowspan="2" align="left">&#x000a0;Intraparietal sulcus</td><td align="left">R</td><td align="char">38</td><td align="char">&#x02212;62</td><td align="char">38</td><td align="char">4.80<sup>*</sup></td><td align="char">0.52</td><td align="left">R</td><td align="char">28</td><td align="char">&#x02212;72</td><td align="char">48</td><td align="char">4.15</td><td align="char">0.39</td></tr><tr><td/><td/><td/><td/><td/><td/><td align="left">L</td><td align="char">&#x02212;22</td><td align="char">&#x02212;72</td><td align="char">50</td><td align="char">4.17</td><td align="char">0.43</td></tr><tr><td colspan="13" align="left">&#x02028;&#x02028;</td></tr><tr><td rowspan="2" align="left">&#x000a0;Cerebellum (lobule VI)</td><td/><td/><td/><td/><td/><td/><td align="left">R</td><td align="char">40</td><td align="char">&#x02212;48</td><td align="char">&#x02212;28</td><td align="char">4.99<sup>*</sup></td><td align="char">0.57</td></tr><tr><td/><td/><td/><td/><td/><td/><td align="left