" char="." rowspan="1" colspan="1">0.48</td><td align="char" char="." rowspan="1" colspan="1">1.0</td><td align="char" char="." rowspan="1" colspan="1">0.1</td><td align="char" char="." rowspan="1" colspan="1">0.24</td><td align="char" char="." rowspan="1" colspan="1">0.16</td><td align="char" char="." rowspan="1" colspan="1">0.86</td><td align="char" char="." rowspan="1" colspan="1">0.52</td></tr><tr><td rowspan="1" colspan="1"><italic>&#x003b8;</italic>, <italic>&#x003b8;</italic>&#x02032;</td><td align="char" char="." rowspan="1" colspan="1">0.8</td><td align="char" char="." rowspan="1" colspan="1">0.79</td><td align="char" char="." rowspan="1" colspan="1">0.84</td><td align="char" char="." rowspan="1" colspan="1">0.62</td><td align="char" char="." rowspan="1" colspan="1">0.79</td><td align="char" char="." rowspan="1" colspan="1">0.73</td><td align="char" char="." rowspan="1" colspan="1">0.81</td><td align="char" char="." rowspan="1" colspan="1">0.7</td><td align="char" char="." rowspan="1" colspan="1">0.61</td><td align="char" char="." rowspan="1" colspan="1">0.66</td><td align="char" char="." rowspan="1" colspan="1">0.63</td><td align="char" char="." rowspan="1" colspan="1">0.93</td><td align="char" char="." rowspan="1" colspan="1">0.64</td><td align="char" char="." rowspan="1" colspan="1">0.8</td><td align="char" char="." rowspan="1" colspan="1">1.0</td></tr></tbody></table></table-wrap><table-wrap id="tbl4" position="float"><table frame="hsides" rules="groups"><thead><tr><th valign="bottom" align="left" rowspan="1" colspan="1">site #</th><th valign="bottom" rowspan="1" colspan="1">&#x0200a;downstream connections</th></tr></thead><tbody><tr><td rowspan="1" colspan="1">1</td><td rowspan="1" colspan="1">&#x0200a;2,3,4,7</td></tr><tr><td rowspan="1" colspan="1">2</td><td rowspan="1" colspan="1">&#x0200a;6,7</td></tr><tr><td rowspan="1" colspan="1">3</td><td rowspan="1" colspan="1">&#x0200a;4,5</td></tr><tr><td rowspan="1" colspan="1">etc.</td><td rowspan="1" cols