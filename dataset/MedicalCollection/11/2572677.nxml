.org/doi:10.1007/BF02058648">doi:10.1007/BF02058648</ext-link></citation></ref><ref id="bib5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blank</surname><given-names>S.</given-names></name><name><surname>Arnoldi</surname><given-names>M.</given-names></name><name><surname>Khoshnavaz</surname><given-names>S.</given-names></name><name><surname>Treccani</surname><given-names>L.</given-names></name><name><surname>Kuntz</surname><given-names>M.</given-names></name><name><surname>Mann</surname><given-names>K.</given-names></name><name><surname>Grathwohl</surname><given-names>G.</given-names></name><name><surname>Fritz</surname><given-names>M.</given-names></name></person-group><article-title>The nacre protein perlucin nucleates growth of calcium carbonate crystals</article-title><source>J. Microsc</source><volume>212</volume><year>2003</year><fpage>280</fpage><lpage>291</lpage><ext-link ext-link-type="uri" xlink:href="http://dx.doi.org/doi:10.1111/j.1365-2818.2003.01263.x">doi:10.1111/j.1365-2818.2003.01263.x</ext-link><pub-id pub-id-type="pmid">14629554</pub-id></citation></ref><ref id="bib6"><citation citation-type="other">Carpenter, W. 1847 <italic>Rep. Br. Ass. Adv. Sci. 17th Meeting</italic>, pp. 93&#x02013;134.</citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cartwright</surname><given-names>J.</given-names></name><name><surname>Checa</surname><given-names>A.G.</given-names></name></person-group><article-title>The dynamics of nacre self assembly</article-title><source>J. R. Soc. Interface</source><volume>4</volume><year>2007</year><fpage>491</fpage><lpage>504</lpage><ext-link ext-link-type="uri" xlink:href="http://dx.doi.org/doi:10.1098/rsif.2006.0188">doi:10.1098/rsif.2006.0188</ext-link><pub-id pub-id-type="pmid">17251136</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname