ge><ext-link ext-link-type="uri" xlink:href="http://dx.doi.org/doi:10.1016/0266-3538(89)90024-9">doi:10.1016/0266-3538(89)90024-9</ext-link></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>X.D.</given-names></name><name><surname>Xu</surname><given-names>Z.H.</given-names></name><name><surname>Wang</surname><given-names>R.Z.</given-names></name></person-group><article-title><italic>In situ</italic> observation of nanograin rotation and deformation in nacre</article-title><source>Nano Lett</source><volume>6</volume><year>2006</year><fpage>2301</fpage><lpage>2304</lpage><ext-link ext-link-type="uri" xlink:href="http://dx.doi.org/doi:10.1021/nl061775u">doi:10.1021/nl061775u</ext-link><pub-id pub-id-type="pmid">17034101</pub-id></citation></ref><ref id="bib13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Magonov</surname><given-names>S.N.</given-names></name><name><surname>Yerina</surname><given-names>N.A.</given-names></name></person-group><article-title>Visualization of nanostructures with atomic force microscopy</article-title><person-group person-group-type="editor"><name><surname>Yao</surname><given-names>N.</given-names></name><name><surname>Wang</surname><given-names>Z.L.</given-names></name></person-group><source>Handbook of microscopy for nontechnology</source><year>2005</year><publisher-name>Kluwer Academic Publishers</publisher-name><publisher-loc>New York, NY</publisher-loc><fpage>113</fpage><lpage>155</lpage></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morse</surname><given-names>D.E.</given-names></name><name><surname>Cariolou</surname><given-names>M.A.</given-names></name><name><surname>Stucky</surname><given-names>G.D.</given-names></name><name><surname>Zaremba</surname><given-names>C.M.</given-names></name><name><surname>Hansma</surname><g