<lpage>11</lpage></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ofori-Adjei</surname><given-names>D</given-names></name><name><surname>Antes</surname><given-names>G</given-names></name><name><surname>Tharyan</surname><given-names>P</given-names></name><name><surname>Slade</surname><given-names>E</given-names></name><name><surname>Tamber</surname><given-names>PS</given-names></name></person-group><article-title>Have Online International Medical Journals Made Local Journals Obsolete?</article-title><source>PLoS Medicine</source><year>2006</year><volume>3</volume><fpage>e359</fpage><pub-id pub-id-type="pmid">16942397</pub-id><pub-id pub-id-type="doi">10.1371/journal.pmed.0030359</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shetty</surname><given-names>P</given-names></name></person-group><article-title>Comment: The developing world needs its own science journals</article-title><source>New Scientist</source><year>2008</year><fpage>20</fpage><comment><bold>9 July 2008</bold></comment><pub-id pub-id-type="doi">10.1016/S0262-4079(08)61723-6</pub-id></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kwan</surname><given-names>T-W</given-names></name></person-group><person-group person-group-type="editor"><name><surname>de Bary WT</surname></name></person-group><article-title>The Overdominance of English in Global Education</article-title><source>Confucian Tradition and Global Education</source><year>2007</year><publisher-name>Hong Kong and New York City: The Chinese University Press and Columbia University Press</publisher-name><fpage>83</fpage><lpage>105</lpage></citation></ref><ref id="B13"><citation citation-type="other"><article-title>Budapest Open Access Initiative</article-title><ext-link ext-link-type="uri" xlink:href="http://www.soros.org/openaccess/index.shtml"/></citation></ref><ref id="B14"><citation citation-type="other"><article-title>Open Access Overview &#x02013; Focusing on open access to peer-reviewed research articles and their preprints</article-title><ext-link ext-link-type="uri" xlink:href="http://www.earlham.edu/~peters/fos/overview.htm"/></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fung</surname><given-names>IC-H</given-names></name></person-group><article-title>Chinese journals: a guide for epidemiologists</article-title><source>Emerg Themes Epidemiol</source><year>2008</year><volume>5</volume><fpage>20</fpage><pub-id pub-id-type="pmid">18826604</pub-id><pub-id pub-id-type="doi">10.1186/1742-7622-5-20</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>Q</given-names></name><name><surname>Tian</surname><given-names>L-G</given-names></name><name><surname>Xiao</surname><given-names>S-H</given-names></name><name><surname>Zhen</surname><given-names>Q</given-names></name><name><surname>Steinmann</surname><given-names>P</given-names></name><name><surname>Mak</surname><given-names>T</given-names></name><name><surname>Utzinger</surname><given-names>J</given-names></name><name><surname>Zhou</surname><given-names>X-N</given-names></name></person-group><article-title>Harnessing the wealth of Chinese scientific literature: schistosomiasis research and control in China</article-title><source>Emerg Themes Epidemiol</source><year>2008</year><volume>5</volume><fpage>19</fpage><pub-id pub-id-type="pmid">18826598</pub-id><pub-id pub-id-type="doi">10.1186/1742-7622-5-19</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barreto</surname><given-names>ML</given-names></name><name><surname>Barata</surname><given-names>RB</given-names></name></person-group><art