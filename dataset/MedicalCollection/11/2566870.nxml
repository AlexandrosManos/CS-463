year>2006</year><volume>103</volume><fpage>16698</fpage><lpage>16703</lpage><pub-id pub-id-type="pmid">17075070</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mohr</surname><given-names>S</given-names></name><name><surname>Stryker</surname><given-names>JM</given-names></name><name><surname>Lambowitz</surname><given-names>AM</given-names></name></person-group><article-title>A DEAD-box protein functions as an ATP-dependent RNA chaperone in group I intron splicing</article-title><source>Cell</source><year>2002</year><volume>109</volume><fpage>769</fpage><lpage>779</lpage><pub-id pub-id-type="pmid">12086675</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Morlang</surname><given-names>S</given-names></name><name><surname>Weglohner</surname><given-names>W</given-names></name><name><surname>Franceschi</surname><given-names>F</given-names></name></person-group><article-title>Hera from Thermus thermophilus: the first thermostable DEAD-box helicase with an RNase P protein motif</article-title><source>J. Mol. Biol.</source><year>1999</year><volume>294</volume><fpage>795</fpage><lpage>805</lpage><pub-id pub-id-type="pmid">10610797</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rudolph</surname><given-names>MG</given-names></name><name><surname>Heissmann</surname><given-names>R</given-names></name><name><surname>Wittmann</surname><given-names>JG</given-names></name><name><surname>Klostermeier</surname><given-names>D</given-names></name></person-group><article-title>Crystal structure and nucleotide binding of the Thermus thermophilus RNA helicase Hera N-terminal domain</article-title><source>J. Mol. Biol.</source><year>2006</year><vo