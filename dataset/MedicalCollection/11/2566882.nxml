 disease</article-title><source>Acta Biochim. Pol.</source><year>2007</year><volume>54</volume><fpage>413</fpage><lpage>434</lpage><pub-id pub-id-type="pmid">17893748</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lindahl</surname><given-names>T</given-names></name><name><surname>Wood</surname><given-names>RD</given-names></name></person-group><article-title>Quality control by DNA repair</article-title><source>Science</source><year>1999</year><volume>286</volume><fpage>1897</fpage><lpage>1905</lpage><pub-id pub-id-type="pmid">10583946</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mol</surname><given-names>CD</given-names></name><name><surname>Parikh</surname><given-names>SS</given-names></name><name><surname>Putnam</surname><given-names>CD</given-names></name><name><surname>Lo</surname><given-names>TP</given-names></name><name><surname>Tainer</surname><given-names>JA</given-names></name></person-group><article-title>DNA repair mechanisms for the recognition and removal of damaged DNA bases</article-title><source>Annu. Rev. Biophys. Biomol. Struct.</source><year>1999</year><volume>28</volume><fpage>101</fpage><lpage>128</lpage><pub-id pub-id-type="pmid">10410797</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Parikh</surname><given-names>SS</given-names></name><name><surname>Mol</surname><given-names>CD</given-names></name><name><surname>Hosfield</surname><given-names>DJ</given-names></name><name><surname>Tainer</surname><given-names>JA</given-names></name></person-group><article-title>Envisioning the molecular choreography of DNA base excision repair</article-title><source>Curr. Opin. Struct. Biol.</source><year>1999</year><