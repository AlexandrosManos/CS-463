ation-type="journal"><person-group person-group-type="author"><name><surname>Southall</surname><given-names>JE</given-names></name><name><surname>Okely</surname><given-names>AD</given-names></name><name><surname>Steele</surname><given-names>JR</given-names></name></person-group><article-title>Actual and perceived competence in overweight and non-overweight children</article-title><source>Pediatr Exerc Sci</source><year>2004</year><volume>16</volume><fpage>15</fpage><lpage>24</lpage></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wrotniak</surname><given-names>BH</given-names></name><name><surname>Epstein</surname><given-names>LH</given-names></name><name><surname>Dorn</surname><given-names>JM</given-names></name><name><surname>Jones</surname><given-names>KE</given-names></name><name><surname>Kondilis</surname><given-names>VA</given-names></name></person-group><article-title>The Relationship Between Motor Proficiency and Physical Activity in Children</article-title><source>Pediatrics</source><year>2006</year><volume>118</volume><fpage>1758</fpage><lpage>1765</lpage><pub-id pub-id-type="doi">10.1542/peds.2006-0742</pub-id></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Booth</surname><given-names>M</given-names></name><name><surname>Okely</surname><given-names>AD</given-names></name><name><surname>Denney-Wilson</surname><given-names>E</given-names></name><name><surname>Hardy</surname><given-names>L</given-names></name><name><surname>Yang</surname><given-names>B</given-names></name><name><surname>Dobbins</surname><given-names>T</given-names></name></person-group><source>NSW Schools Physical Activity and Nutrition Survey (SPANS) 2004 Full Report</source><year>2006</year><publisher-name>Sydney, NSW: NSW Department of Health</publisher-name><comment>Report No.: SHPN 060056 ISBN 0 7347 3929</comment></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Okely</surname><given-names>AD</given-names></name><name><surname>Booth</surname><given-names>M</given-names></name><name><surname>Patterson</surname><given-names>JW</given-names></name></person-group><article-title>Relationship of physical activity to fundamental movement skills among adolescents</article-title><source> Med Sci Sports Exerc</source><year>2001</year><volume>33</volume><fpage>1899</fpage><lpage>1904</lpage><pub-id pub-id-type="pmid">11689741</pub-id></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Okely</surname><given-names>AD</given-names></name></person-group><article-title>The relationship of participation in organised sports and games, participation in nonorganised physical activity, and cardiorespiratory endurance to fundamental motor skill ability among adolescents</article-title><source>PhD Thesis</source><year>1999</year><publisher-name>University of Wollongong, Faculty of Education</publisher-name></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stodden</surname><given-names>DF</given-names></name><name><surname>Langendorfer</surname><given-names>SJ</given-names></name><name><surname>Roberton</surname><given-names>MA</given-names></name><name><surname>Kelbley</surname><given-names>L</given-names></name></person-group><article-title>Association between motor skill competence and health-related physical fitness</article-title><source>J Sport Exerc Psychol</source><year>2007</year><volume>29</volume><fpage>S45</fpage><lpage>2</lpage></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Okely</surname><given-names>AD</given-names></name><name><surname>Booth</surname><given-names>M</given-names></name><name><surname>Patterson</surname><given-names>J</given-names></name></person-group><article-title>Relationship of Cardiorespiratory Endurance to Fundamental Movement Skill Proficiency Among Adolescents</article-title><source>Pediatric Exercise Science</source><year>2001</year><volume>13</volume><fpage>380</fpage><lpage>391</lpage></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harter</surname><given-names>S</given-names></name></person-group><article-title>Effectance Motivation Reconsidered: Toward a Developmental Model</article-title><source>Human Development</source><year>1978</year><volume>21</volume><fpage>34</fpage><lpage>64</lpage></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Harter</surname><given-names>S</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Roberts GC, Landers DM</surname></name></person-group><article-title>The development of competence motivation in the mastery of cognitive &#x00026; physical skills: Is there still a place for joy?</article-title><source>Psychology of Motor Behaviour &#x00026; Sport</source><year>1980</year><publisher-name>Illinois: Champaign Illinois: Human Kinetics</publisher-name><fpage>3</fpage><lpage>29</lpage><comment>1981b</comment></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harter</surname><given-names>S</given-names></name></person-group><article-title>A Model of Mastery Motivation in Children: Individual Differences and Developmental Change</article-title><source>Minnesota Symposium on Child Psychology</source><year>1981</year><volume>14</volume><fpage>215</fpage><lpage>255</lpage></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harter</surname><given-names>S</given-names></name></person-group><article-title>The Perceived Competence Scale f