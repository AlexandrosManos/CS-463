s></name></person-group><article-title>Physical Fitness in childhood and adolescence: a powerful marker of health</article-title><source> Int J Obes (Lond)</source><year>2008</year><volume>32</volume><fpage>1</fpage><lpage>11</lpage><pub-id pub-id-type="pmid">18043605</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nader</surname><given-names>PR</given-names></name><name><surname>Bradley</surname><given-names>RH</given-names></name><name><surname>Houts</surname><given-names>RM</given-names></name><name><surname>McRitchie</surname><given-names>SL</given-names></name><name><surname>O'Brien</surname><given-names>M</given-names></name></person-group><article-title>Moderate-to-Vigorous Physical Activity From Ages 9 to 15 Years</article-title><source>JAMA</source><year>2008</year><volume>300</volume><fpage>295</fpage><lpage>395</lpage><pub-id pub-id-type="pmid">18632544</pub-id><pub-id pub-id-type="doi">10.1001/jama.300.3.295</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dollman</surname><given-names>J</given-names></name><name><surname>Olds</surname><given-names>T</given-names></name></person-group><article-title>Distributional changes in the performance of Australian children on tests of cardiorespiratory endurance</article-title><source>Med Sport Sci</source><year>2007</year><volume>50</volume><fpage>210</fpage><lpage>25</lpage><pub-id pub-id-type="pmid">17387260</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hagger</surname><given-names>M</given-names></name><name><surname>Ashford</surname><given-names>B</given-names></name><name><surname>Stambulova</surname><given-names>N</given-names></name></person-group><article-title>Russian and British Children's Physical Self-Perceptions and Physical Activity Participation</article-title><source>Pediatr Exerc Science</source><year>1998</year><volume>10</volume><fpage>137</fpage><lpage>152</lpage></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Raudsepp</surname><given-names>L</given-names></name><name><surname>Liblik</surname><given-names>R</given-names></name><name><surname>Hannus</surname><given-names>A</given-names></name></person-group><article-title>Children's and Adolescents' Physical Self-Perceptions as Related to Vigorous Physical Activity and Physical Fitness</article-title><source>Pediatr Exerc Science</source><year>2002</year><volume>14</volume><fpage>97</fpage><lpage>106</lpage></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crocker</surname><given-names>PRE</given-names></name><name><surname>Eklund</surname><given-names>RC</given-names></name><name><surname>Kowalski</surname><given-names>KC</given-names></name></person-group><article-title>Children's physical activity and physical self-perceptions</article-title><source>J Sports Sci</source><year>2000</year><volume>18</volume><fpage>383</fpage><lpage>394</lpage><pub-id pub-id-type="pmid">10902673</pub-id><pub-id pub-id-type="doi">10.1080/02640410050074313</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fox</surname><given-names>KR</given-names></name><name><surname>Corbin</surname><given-names>CB</given-names></name></person-group><article-title>The Physical Self-Perception Profile: Development and Preliminary Validation</article-title><source>J Sport Exerc Psychol</source><year>1989</year><volume>11</volume><fpage>408</fpage><lpage>430</lpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roberts</surname><given-names>GC</given-names></name><name><surname>Kleiber</surname><given-names>DA</give