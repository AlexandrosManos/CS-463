 ATLS</collab></person-group><article-title>Suporte Avan&#x000e7;ado de Vida no Trauma, manual do curso para alunos</article-title><year>2004</year><fpage>87</fpage><lpage>107</lpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McDonough</surname><given-names>KH</given-names></name><name><surname>Giaimo</surname><given-names>MEBS</given-names></name><name><surname>Miller</surname><given-names/></name><name><surname>Harvey</surname><given-names>I</given-names></name></person-group><article-title>Low-Dose Ethanol Alters the Cardiovascular, Metabolic, and Respiratory Compensation for Severe Blood Loss</article-title><source>The Journal of Trauma</source><year>2002</year><volume>53</volume><fpage>541</fpage><lpage>548</lpage><pub-id pub-id-type="pmid">12352494</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hasenboehler</surname><given-names>E</given-names></name><name><surname>Williams</surname><given-names>A</given-names></name></person-group><article-title>Metabolic changes after polytrauma: an imperative for early nutritional support</article-title><source>World Journal of Emergency Surgery</source><year>2006</year><volume>1</volume><fpage>29</fpage><pub-id pub-id-type="pmid">17020610</pub-id><pub-id pub-id-type="pmid">17020610</pub-id><pub-id pub-id-type="doi">10.1186/1749-7922-1-29</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adrogue</surname><given-names>HJ</given-names></name><name><surname>Madias</surname><given-names>NE</given-names></name></person-group><article-title>Management of life threatening acid base disorders</article-title><source>N Engl J Med</source><year>1998</year><volume>338</volume><fpage>26</fpage><lpage>34</lpage><comment>26 and 107</comment><pub-id pub-id-type="pmid">9414329</pub-id><pub-id pub-id-type="