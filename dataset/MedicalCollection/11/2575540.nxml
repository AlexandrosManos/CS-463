age>1991</fpage><lpage>1996</lpage><pub-id pub-id-type="pmid">12466114</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cheang</surname><given-names>MC</given-names></name><name><surname>Voduc</surname><given-names>D</given-names></name><name><surname>Bajdik</surname><given-names>C</given-names></name><name><surname>Leung</surname><given-names>S</given-names></name><name><surname>McKinney</surname><given-names>S</given-names></name><name><surname>Chia</surname><given-names>SK</given-names></name><name><surname>Perou</surname><given-names>CM</given-names></name><name><surname>Nielsen</surname><given-names>TO</given-names></name></person-group><article-title>Basal-like breast cancer defined by five biomarkers has superior prognostic value than triple-negative phenotype</article-title><source>Clin Cancer Res</source><year>2008</year><volume>14</volume><fpage>1368</fpage><lpage>1376</lpage><pub-id pub-id-type="pmid">18316557</pub-id><pub-id pub-id-type="doi">10.1158/1078-0432.CCR-07-1658</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yang</surname><given-names>XR</given-names></name><name><surname>Sherman</surname><given-names>ME</given-names></name><name><surname>Rimm</surname><given-names>DL</given-names></name><name><surname>Lissowska</surname><given-names>J</given-names></name><name><surname>Brinton</surname><given-names>LA</given-names></name><name><surname>Peplonska</surname><given-names>B</given-names></name><name><surname>Hewitt</surname><given-names>SM</given-names></name><name><surname>Anderson</surname><given-names>WF</given-names></name><name><surname>Szeszenia-Dabrowska</surname><given-names>N</given-names></name><name><surname>Bardin-Mikolajczak</surname><given-names>A</given-names></name><name><surname>Zatonski</surname><given-names>W</given-names></name><name><surname>Cartun</surname><given-names