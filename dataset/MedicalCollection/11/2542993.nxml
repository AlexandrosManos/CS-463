-group person-group-type="author"><name><surname>Arendt</surname><given-names>J</given-names></name></person-group><article-title>Importance and relevance of melatonin to human biological rhythms</article-title><source>J Neuroendocrinol</source><year>2003</year><volume>15</volume><fpage>427</fpage><lpage>431</lpage><pub-id pub-id-type="pmid">12622845</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2826.2003.00987.x</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wehr</surname><given-names>TA</given-names></name></person-group><article-title>Melatonin and Seasonal Rhythms</article-title><source>J Biol Rhythms</source><year>1997</year><volume>12</volume><fpage>518</fpage><lpage>527</lpage><pub-id pub-id-type="pmid">9406025</pub-id><pub-id pub-id-type="doi">10.1177/074873049701200605</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bronson</surname><given-names>FH</given-names></name></person-group><article-title>Are humans seasonally photoperiodic?</article-title><source>J Biol Rhythms</source><year>2004</year><volume>19</volume><fpage>180</fpage><lpage>192</lpage><pub-id pub-id-type="pmid">15155003</pub-id><pub-id pub-id-type="doi">10.1177/0748730404264658</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Puchalski</surname><given-names>W</given-names></name><name><surname>Lynch</surname><given-names>GR</given-names></name></person-group><article-title>Evidence for differences in circadian organization of hamsters hamsters exposed to short day photoperiod</article-title><source>J Comp Physiol A</source><year>1986</year><volume>159</volume><fpage>7</fpage><lpage>11</lpage><pub-id pub-id-type="pmid">3746726</pub-id><pub-id pub-id-type="doi">10.1007/BF00612490</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><pe