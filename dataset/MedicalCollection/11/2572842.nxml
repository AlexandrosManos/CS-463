" rowspan="1" colspan="1">0&#x00025;</td></tr><tr><td align="left" rowspan="1" colspan="1">11,13,28</td><td align="left" rowspan="1" colspan="1">&#x0005b;South African&#x0005d;</td><td align="left" rowspan="1" colspan="1">92</td><td align="left" rowspan="1" colspan="1">8</td><td align="left" rowspan="1" colspan="1">9&#x00025;</td><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">0&#x00025;</td></tr><tr><td align="left" rowspan="1" colspan="1">12</td><td align="left" rowspan="1" colspan="1">Sudano-Zambezian</td><td align="left" rowspan="1" colspan="1">189</td><td align="left" rowspan="1" colspan="1">20</td><td align="left" rowspan="1" colspan="1">11&#x00025;</td><td align="left" rowspan="1" colspan="1">13</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">0&#x00025;</td></tr><tr><td align="left" rowspan="1" colspan="1">15</td><td align="left" rowspan="1" colspan="1">Madagascan</td><td align="left" rowspan="1" colspan="1">52</td><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">12&#x00025;</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">0&#x00025;</td></tr><tr><td align="left" rowspan="1" colspan="1">16</td><td align="left" rowspan="1" colspan="1">Indian</td><td align="left" rowspan="1" colspan="1">147</td><td align="left" rowspan="1" colspan="1">26</td><td align="left" rowspan="1" colspan="1">18&#x00025;</td><td align="left" rowspan="1" colspan="1">12</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">17&#x00025;</td></tr><tr><td align="left" rowspan="1" colspan="1">17</td><td align="left" rowspan="1" colspan="1">Indo-Chinese</td><td align="left" rowspan="1" colspan="1">153</td><td align="left" rowspan="1" colspan="1">28</td><td align="left" rowspan="1" colspan="1">18&#x00025;