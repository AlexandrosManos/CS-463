</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Menzies</surname><given-names>D</given-names></name><name><surname>Pai</surname><given-names>M</given-names></name><name><surname>Comstock</surname><given-names>G</given-names></name></person-group><year>2007</year><article-title>Meta-analysis: new tests for the diagnosis of latent tuberculosis infection: areas of uncertainty and recommendations for research.</article-title><source>Ann Intern Med</source><volume>146</volume><fpage>340</fpage><lpage>54</lpage><pub-id pub-id-type="pmid">17339619</pub-id></citation></ref><ref id="pone.0003417-Lalvani1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lalvani</surname><given-names>A</given-names></name></person-group><year>2007</year><article-title>Diagnosing tuberculosis infection in the 21st century: new tools to tackle an old enemy.</article-title><source>Chest</source><volume>131</volume><fpage>1898</fpage><lpage>906</lpage><pub-id pub-id-type="pmid">17565023</pub-id></citation></ref><ref id="pone.0003417-Domnguez1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dom&#x000ed;nguez</surname><given-names>J</given-names></name><name><surname>Ruiz-Manzano</surname><given-names>J</given-names></name><name><surname>De Souza-Galv&#x000e3;o</surname><given-names>M</given-names></name><name><surname>Latorre</surname><given-names>I</given-names></name><name><surname>Mil&#x000e0;</surname><given-names>C</given-names></name><name><surname>Blanco</surname><given-names>S</given-names></name><etal/></person-group><year>2008</year><article-title>Comparison of two commercially available gamma interferon blood tests for immunodiagnosis of tuberculosis.</article-title><source>Clin Vaccine Immunol</source><volume>15</volume><fpage>168</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">17978008</pub-id></citation></ref><ref id="pone.0003417-Arend1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arend</surname><given-names>SM</given-names></name><name><surname>Thijsen</surname><given-names>SF</given-names></name><name><surname>Leyten</surname><given-names>EM</given-names></name><name><surname>Bouwman</surname><given-names>JJ</given-names></name><name><surname>Franken</surname><given-names>WP</given-names></name><name><surname>Koster</surname><given-names>BF</given-names></name><etal/></person-group><year>2007</year><article-title>Comparison of two interferon-gamma assays and tuberculin skin test for tracing tuberculosis contacts.</article-title><source>Am J Respir Crit Care Med</source><volume>175</volume><fpage>618</fpage><lpage>27</lpage><pub-id pub-id-type="pmid">17170386</pub-id></citation></ref><ref id="pone.0003417-Lalvani2"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lalvani</surname><given-names>A</given-names></name><name><surname>Pathan</surname><given-names>AA</given-names></name><name><surname>Durkan</surname><given-names>H</given-names></name><name><surname>Wilkinson</surname><given-names>KA</given-names></name><name><surname>Whelan</surname><given-names>A</given-names></name><name><surname>Deeks</surname><given-names>JJ</given-names></name><etal/></person-group><year>2001</year><article-title>Enhanced contact tracing and spatial tracking of <italic>Mycobacterium tuberculosis</italic> infection by enumeration of antigen-specific T cells.</article-title><source>Lancet</source><volume>357</volume><fpage>2017</fpage><lpage>21</lpage><pub-id pub-id-type="pmid">11438135</pub-id></citation></ref><ref id="pone.0003417-Lalvani3"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lalvani</surname><given-names>A</given-names></name><name><surname>Pathan</surname><given-names>AA</given-names></name><name><surnam