n="center">2.6</td><td align="center">2.2&#x02013;3.0</td><td align="right">2 026</td><td align="center">7.8</td><td align="center">7.5&#x02013;8.1</td></tr><tr><td align="right">Stroke/TIA</td><td align="right">905</td><td align="center">2.7</td><td align="right">116</td><td align="center">1.4</td><td align="center">1.2&#x02013;1.7</td><td align="right">789</td><td align="center">3.1</td><td align="center">2.9&#x02013;3.3</td></tr><tr><td align="right">PAD</td><td align="right">839</td><td align="center">2.5</td><td align="right">82</td><td align="center">1.0</td><td align="center">0.8&#x02013;1.3</td><td align="right">757</td><td align="center">3.0</td><td align="center">2.7&#x02013;3.2</td></tr><tr><td align="right">Heart Failure</td><td align="right">1 959</td><td align="center">5.7</td><td align="right">236</td><td align="center">2.9</td><td align="center">2.5&#x02013;3.3</td><td align="right">1 723</td><td align="center">6.6</td><td align="center">6.3&#x02013;6.9</td></tr><tr><td align="left"><bold>Diabetes</bold></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="right">Type 1 (acc. to GP)</td><td align="right">199</td><td align="center">0.6</td><td align="right">45</td><td align="center">0.6</td><td align="center">0.4&#x02013;0.8</td><td align="right">154</td><td align="center">0.6</td><td align="center">0.5&#x02013;0.7</td></tr><tr><td align="right">Type 2 (acc. to GP)</td><td align="right">4 274</td><td align="center">12.6</td><td align="right">492</td><td align="center">6.2</td><td align="center">5.6&#x02013;6.7</td><td align="right">3782</td><td align="center">14.6</td><td align="center">14.2&#x02013;15.1</td></tr><tr><td colspan="9"><hr></hr></td></tr><tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td colspan="9"><hr></hr></td></tr><tr><td></td><td align="right"><bold>mean &#x000b1; SD</bold></td><td></td><td align="right"><bold>mean</bold></td><td></td><td align