ype="author"><name><surname>Cecer&#x000e9;</surname><given-names>MC</given-names></name><name><surname>Vazquez-Prokopec</surname><given-names>GM</given-names></name><name><surname>G&#x000fc;rtler</surname><given-names>RE</given-names></name><name><surname>Kitron</surname><given-names>U</given-names></name></person-group><year>1997</year><article-title>Reinfestation sources for Chagas disease vector, Triatoma infestans, Argentina.</article-title><source>Emerging Infectious Diseases</source><volume>12</volume><fpage>1096</fpage><lpage>1102</lpage></citation></ref><ref id="pone.0003585-Brenire1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Breni&#x000e8;re</surname><given-names>SF</given-names></name><name><surname>Bosseno</surname><given-names>MF</given-names></name><name><surname>Vargas</surname><given-names>F</given-names></name><name><surname>Yaksic</surname><given-names>N</given-names></name><name><surname>Noireau</surname><given-names>F</given-names></name><etal/></person-group><year>1998</year><article-title>Smallness of the panmictic unit of Triatoma infestans (Hemiptera: Reduviidae).</article-title><source>J Med Entomol</source><volume>35</volume><fpage>911</fpage><lpage>917</lpage><pub-id pub-id-type="pmid">9835679</pub-id></citation></ref><ref id="pone.0003585-Brenire2"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Breni&#x000e8;re</surname><given-names>SF</given-names></name><name><surname>Bosseno</surname><given-names>MF</given-names></name><name><surname>Noireau</surname><given-names>F</given-names></name><name><surname>Yacsik</surname><given-names>N</given-names></name><name><surname>Liegeard</surname><given-names>P</given-names></name><etal/></person-group><year>2002</year><article-title>Integrate study of a Bolivian population infected by Trypanosoma cruzi, the agent of Chagas disease.</article-title><source>Mem Inst Oswaldo Cruz</source><volume>97</volume><fpage>289</fpage><lpage>295</lpage><pub-id pub-id-type="pmid">12048553</pub-id></citation></ref><ref id="pone.0003585-Pizarro1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pizarro</surname><given-names>J</given-names></name><name><surname>Ribera</surname><given-names>W</given-names></name><name><surname>Aguirre</surname><given-names>A</given-names></name><name><surname>De Muynck</surname><given-names>A</given-names></name></person-group><year>1996</year><article-title>Estudio parasitol&#x000f3;gico-entomol&#x000f3;gico de traiatom&#x000ed;neos procedentes de la provincia Zud&#x000e1;&#x000f1;ez del Departamento de Chuquisaca.</article-title><source>Archivos Bolivianos de Medicina Vol III</source><volume>52</volume><fpage>29</fpage><lpage>33</lpage></citation></ref><ref id="pone.0003585-Cecer2"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cecer&#x000e9;</surname><given-names>MC</given-names></name><name><surname>G&#x000fc;rtler</surname><given-names>RE</given-names></name><name><surname>Chuit</surname><given-names>R</given-names></name><name><surname>Cohen</surname><given-names>JE</given-names></name></person-group><year>1997</year><article-title>Effects of chickens on the prevalence of infestation and population density of Triatoma infestans in rural houses of north-west Argentina.</article-title><source>Med Vet Entomol</source><volume>11</volume><fpage>383</fpage><lpage>388</lpage><pub-id pub-id-type="pmid">9430119</pub-id></citation></ref><ref id="pone.0003585-Dujardin2"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dujardin</surname><given-names>JP</given-names></name><name><surname>Cardozo</surname><given-names>L</given-names></name><name><surname>Schofield</surname><given-names>C</given-names></name></person-group><year>1996</year><article-title>Geneti