-1300"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Frumkin</surname><given-names>H</given-names></name><name><surname>Frank</surname><given-names>L</given-names></name><name><surname>Jackson</surname><given-names>RJ</given-names></name></person-group><year>2004</year><source>Urban Sprawl and Public Health</source><publisher-loc>Washington, DC</publisher-loc><publisher-name>Island Press</publisher-name></citation></ref><ref id="b16-ehp-116-1300"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Han</surname><given-names>B</given-names></name><name><surname>Small</surname><given-names>BJ</given-names></name><name><surname>Haley</surname><given-names>WE</given-names></name></person-group><year>1999</year><article-title>The effects of race, gender, and education on the structure of self-rated health among community-dwelling older adults</article-title><source>Ann NY Acad Sci</source><volume>886</volume><fpage>442</fpage><lpage>446</lpage><pub-id pub-id-type="pmid">10681946</pub-id></citation></ref><ref id="b17-ehp-116-1300"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Horgas</surname><given-names>AL</given-names></name><name><surname>Wilms</surname><given-names>HU</given-names></name><name><surname>Baltes</surname><given-names>MM</given-names></name></person-group><year>1998</year><article-title>Daily life in very old age: everyday activities as expression of successful living</article-title><source>Gerontologist</source><volume>38</volume><fpage>556</fpage><lpage>568</lpage><pub-id pub-id-type="pmid">9803644</pub-id></citation></ref><ref id="b18-ehp-116-1300"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>House</surname><given-names>JS</given-names></name><name><surname>Landis</surname><given-names>KR</given-names></name><name><surname>Umberson</surname><given-names>D</given-names></name></person-group><year>1988</year><article-title>Social relationships and health</article-title><source>Science</source><volume>241</volume><fpage>540</fpage><lpage>545</lpage><pub-id pub-id-type="pmid">3399889</pub-id></citation></ref><ref id="b19-ehp-116-1300"><citation citation-type="book"><collab>Institute of Medicine and Transportation Research Board of the National Academies</collab><year>2005</year><article-title>Does The Built Environment Influence Physical Activity?</article-title><source>Examining The Evidence</source><comment>Report No. 282</comment><publisher-loc>Washington, DC</publisher-loc><publisher-name>National Academy of Sciences</publisher-name></citation></ref><ref id="b20-ehp-116-1300"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Jacobs</surname><given-names>J</given-names></name></person-group><year>1961</year><source>The Death and Life of Great American Cities</source><publisher-loc>New York</publisher-loc><publisher-name>Vintage Books</publisher-name><comment>repr</comment><year>1992</year></citation></ref><ref id="b21-ehp-116-1300"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jylh&#x000e4;</surname><given-names>M</given-names></name><name><surname>Guralnik</surname><given-names>JM</given-names></name><name><surname>Balfour</surname><given-names>J</given-names></name><name><surname>Fried</surname><given-names>LP</given-names></name></person-group><year>2001</year><article-title>Walking difficulty, walking speed, and age as predictors of self-rated health: the Women&#x02019;s Health and Aging Study</article-title><source>J Gerontol A Med Sci</source><volume>56A</volume><fpage>M609</fpage><lpage>M617</lpage></citation></ref><ref id="b22-ehp-116-1300"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kawachi</surname><given-names>I</given-names></name></person-group><year>1999</year><article-title>Social capital and community effects on population and individual health</article-title><source>Ann NY Acad Sci</source><volume>896</volume><fpage>120</fpage><lpage>130</lpage><pub-id pub-id-type="pmid">10681893</pub-id></citation></ref><ref id="b23-ehp-116-1300"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kline</surname><given-names>RB</given-names></name></person-group><year>2005</year><source>Principles and Practice of Structural Equation Modeling</source><edition>2</edition><publisher-loc>New York</publisher-loc><publisher-name>Guilford</publisher-name></citation></ref><ref id="b24-ehp-116-1300"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Krause</surname><given-names>N</given-names></name></person-group><year>1995</year><article-title>Negative interaction and satisfaction with social support among older adults</article-title><source>J Gerontol B Psychol Sci Soc Sci</source><volume>50B</volume><fpage>59</fpage><lpage>73</lpage></citation></ref><ref id="b25-ehp-116-1300"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Krause</surname><given-names>N</given-names></name></person-group><year>1996</year><article-title>Neighborhood deterioration and self-rated health in later life</article-title><source>Psychol Aging</source><volume>11</volume><issue>2</issue><fpage>342</fpage><lpage>352</lpage><pub-id pub-id-type="pmid">8795063</pub-id></citation></ref><ref id="b26-ehp-116-1300"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Krause</surname><given-names>N</given-names></name></person-group><year>1998</year><article-title>Neighborhood deterioration, religious coping, and changes in health during late life</article-title><source>Gerontologist</source><volume>38</volume><fpage>653</fpage><lpage>664</lpage><pub-id pub-id-type="pmid">9868846</pub-id></citation></ref><ref id="b27-ehp-116-1300"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Krause</surname><given-names>N</given-names></name><name><surname>Liang</surname><given-names>J</given-names></name><name><surname>Yatomi</surname><given-names>N</given-names></name></person-group><year>1989</year><article-title>Satisfaction with social support and depressive symptoms: a panel analysis</article-title><source>Psychol Aging</source><volume>4</volume><issue>1</issue><fpage>88</fpage><lpage>97</lpage><pub-id pub-id-type="pmid">2803616</pub-id></citation></ref><ref id="b28-ehp-116-1300"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Krause</surname><given-names>N</given-names></name><name><surname>Markides</surname><given-names>K</given-names></name></person-group><year>1990</year><article-title>Measuring social support among older adults</article-title><source>Int J Aging Hum Dev</source><volume>30</volume><fpage>37</fpage><lpage>53</lpage><pub-id pub-id-type="pmid">2407665</pub-id></citation></ref><ref id="b29-ehp-116-1300"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kweon</surname><given-names>B-S</given-names></name><name><surname>Sullivan</surname><given-names>WC</given-names></name><name><surname>Wiley</surname><given-names>AR</given-names></name></person-group><year>1998</year><article-title>Green common spaces and the social integration of inner-city older adults</article-title><source>Environ Behav</source><volume>30</volume><issue>6</issue><fpage>832</fpage><lpage>827</lpage></citation></ref><ref id="b30-ehp-116-1300"><citation citation-type="book"><person-group person-group-type="editor"><name><surname>Leccese</surname><given-names>M</given-names></name><name><surname>McCormick</surname><given-names>K</given-names></name></person-group><year>2000</year><source>Charter of the New Urbanism</source><publisher-loc>New York</publisher-loc><publisher-name>McGraw-Hill</publisher-name></citation></ref><ref id="b31-ehp-11