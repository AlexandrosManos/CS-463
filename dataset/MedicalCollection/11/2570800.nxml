points from the search space <italic>X</italic>.</p></caption><graphic xlink:href="IJBI2008-513478.alg1"/></fig><table-wrap id="tab1" position="float"><label>Table 1</label><caption><p>Registration results.</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1">Class expert</th><th align="center" rowspan="1" colspan="1">1</th><th align="center" rowspan="1" colspan="1">2</th><th align="center" rowspan="1" colspan="1">3</th><th align="center" rowspan="1" colspan="1">4</th><th align="center" rowspan="1" colspan="1">Mean score</th><th align="center" rowspan="1" colspan="1">Class 1,2,3</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">A</td><td align="center" rowspan="1" colspan="1">107 (81.7%)</td><td align="center" rowspan="1" colspan="1">15 (11.4%)</td><td align="center" rowspan="1" colspan="1">6 (6.4%)</td><td align="center" rowspan="1" colspan="1">3 (2.3%)</td><td align="center" rowspan="1" colspan="1">1.27</td><td align="center" rowspan="1" colspan="1">128 (97.7%)</td></tr><tr><td align="left" rowspan="1" colspan="1">B</td><td align="center" rowspan="1" colspan="1">98 (74.8%)</td><td align="center" rowspan="1" colspan="1">21 (16.0%)</td><td align="center" rowspan="1" colspan="1">4 (3.1%)</td><td align="center" rowspan="1" colspan="1">8 (6.1%)</td><td align="center" rowspan="1" colspan="1">1.41</td><td align="center" rowspan="1" colspan="1">123 (93.9%)</td></tr></tbody></table></table-wrap></floats-wrap></article>