-group-type="author"><name><surname>Simmons</surname><given-names>D</given-names></name><name><surname>Williams</surname><given-names>DR</given-names></name><name><surname>Powell</surname><given-names>MJ</given-names></name></person-group><article-title>Prevalence of diabetes in a predominantly Asian community: preliminary findings of the Coventry diabetes study</article-title><source>Bmj</source><year>1989</year><volume>298</volume><fpage>18</fpage><lpage>21</lpage><pub-id pub-id-type="pmid">2492840</pub-id></citation></ref><ref id="B6"><citation citation-type="other"><person-group person-group-type="author"><collab>World Health Organisation</collab></person-group><article-title>Therapeutic Patient Education: continuing education programmes for healthcare providers in the field of prevention of chronic diseases</article-title><source>Report of a WHO Working Group</source><year>1998</year></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hawthorne</surname><given-names>K</given-names></name><name><surname>Tomlinson</surname><given-names>S</given-names></name></person-group><article-title>Pakistani moslems with Type 2 diabetes mellitus: effect of sex, literacy skills, known diabetic complications and place of care on diabetic knowledge, reported self-monitoring management and glycaemic control</article-title><source>Diabet Med</source><year>1999</year><volume>16</volume><fpage>591</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">10445836</pub-id><pub-id pub-id-type="doi">10.1046/j.1464-5491.1999.00102.x</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Greenhalgh</surname><given-names>T</given-names></name><name><surname>Helman</surname><given-names>C</given-names></name><name><surname>Chowdhury</surname><given-names>AM</given-names></name></person-group><article-title>Health beliefs and folk models of diabetes in British Bangladeshis: a qualitative study</article-title><source>British Medical Journal</source><year>1998</year><volume>316</volume><fpage>978</fpage><lpage>983</lpage><pub-id pub-id-type="pmid">9550958</pub-id></citation></ref><ref id="B9"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Deakin</surname><given-names>T</given-names></name></person-group><source>Expert patient education versus routine treatment (X-PERT) [PhD thesis]</source><year>2004</year><publisher-name>Nuffield Institute for Health</publisher-name></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Toobert</surname><given-names>DJ</given-names></name><name><surname>Hampson</surname><given-names>SE</given-names></name><name><surname>Glasgow</surname><given-names>RE</given-names></name></person-group><article-title>The summary of diabetes self-care activities measure, results from 7 studies and a revised scale</article-title><source>Diabetes Care</source><year>2000</year><volume>23</volume><fpage>943</fpage><lpage>950</lpage><pub-id pub-id-type="pmid">10895844</pub-id><pub-id pub-id-type="doi">10.2337/diacare.23.7.943</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clemente</surname><given-names>CC</given-names></name><name><surname>Prochaska</surname><given-names>JO</given-names></name></person-group><article-title>Self-change and therapy change of smoking behaviour: a comparison of processes of change in cessation and maintenance</article-title><source>Addictive Behaviors</source><year>1982</year><volume>7</volume><fpage>133</fpage><lpage>142</lpage><pub-id pub-id-type="pmid">7102444</pub-id><pub-id pub-id-type="doi">10.1016/0306-4603(82)90038-7</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simmons</surname><given-names>D</given-names></name><name><surname>Voyle</surname><given-names>JA</given-names></name><name><surname>Fou</surname><given-names>F</given-names></name><name><surname>Feo</surname><given-names>S</given-names></name><name><surname>Leakehe</surname><given-names>L</given-names></name></person-group><article-title>Tale of two churches: differential impact of a church-based diabetes control programme among Pacific Islands people in New Zealand</article-title><source>Diabet Med</source><year>2004</year><volume>21</volume><fpage>122</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">14984446</pub-id><pub-id pub-id-type="doi">10.1111/j.1464-5491.2004.01020.x</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chang</surname><given-names>CT</given-names></name></person-group><article-title>Applicability of the stages of change and Weight Efficacy Lifestyle Questionnaire with natives of Sarawak, Malaysia</article-title><source>Rural Remote Health</source><year>2007</year><volume>7</volume><fpage>864</fpage><pub-id pub-id-type="pmid">18076311</pub-id></citation></ref><ref id="B14"><citation citation-type="other"><article-title>Camden Equalities Unit, Camden Bangladeshi Residents Survey, in Camden Equalities Unit and Institute of Education</article-title><source>London UK</source><year>1996</year></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Chalmers</surname><given-names>R</given-names></name></person-group><source>Learning Sylheti in London: Centre for Bangladeshi Studies</source><year>1996</year><publisher-name>R. Institute, Editor. University of Surrey</publisher-name></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>K</given-names></name><etal></etal></person-group><article-title>Discovering the research priorities of people with diabetes in a multicultural community : a focus group study</article-title><source>British Journal of General Practice</source><year>2006</year><volume>56</volume><fpage>206</fpage><lpage>213</lpage><pub-id pub-id-type="pmid">16536961</pub-id></citation></ref></ref-list></back></article>