title>Evolving strategies for enzyme engineering.</article-title><source>Current Opinion in Structural Biology</source><volume>15</volume><fpage>447</fpage><pub-id pub-id-type="pmid">16006119</pub-id></citation></ref><ref id="pgen.1000256-Stemmer1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stemmer</surname><given-names>WP</given-names></name></person-group><year>1994</year><article-title>DNA shuffling by random fragmentation and reassembly: in vitro recombination for molecular evolution.</article-title><source>Proc Natl Acad Sci U S A</source><volume>91</volume><fpage>10747</fpage><lpage>10751</lpage><pub-id pub-id-type="pmid">7938023</pub-id></citation></ref><ref id="pgen.1000256-Jiang1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jiang</surname><given-names>L</given-names></name><name><surname>Althoff</surname><given-names>EA</given-names></name><name><surname>Clemente</surname><given-names>FR</given-names></name><name><surname>Doyle</surname><given-names>L</given-names></name><name><surname>Rothlisberger</surname><given-names>D</given-names></name><etal/></person-group><year>2008</year><article-title>De novo computational design of retro-aldol enzymes.</article-title><source>Science</source><volume>319</volume><fpage>1387</fpage><lpage>1391</lpage><pub-id pub-id-type="pmid">18323453</pub-id></citation></ref><ref id="pgen.1000256-Arnold1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arnold</surname><given-names>FH</given-names></name></person-group><year>1998</year><article-title>When blind is better: Protein design by evolution.</article-title><source>Nat Biotech</source><volume>16</volume><fpage>617</fpage></citation></ref><ref id="pgen.1000256-Chica1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chica</surname><given-names>RA</given-names></name><name><surname>Doucet</surname><given-names>N</given-names></name><name><surname>Pelletier</surname><given-names>JN</given-names></name></person-group><year>2005</year><article-title>Semi-rational approaches to engineering enzyme activity: combining the benefits of directed evolution and rational design.</article-title><source>Current Opinion in Biotechnology</source><volume>16</volume><fpage>378</fpage><pub-id pub-id-type="pmid">15994074</pub-id></citation></ref><ref id="pgen.1000256-Patrick1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Patrick</surname><given-names>WM</given-names></name><name><surname>Firth</surname><given-names>AE</given-names></name></person-group><year>2005</year><article-title>Strategies and computational tools for improving randomized protein libraries.</article-title><source>Biomolecular Engineering</source><volume>22</volume><fpage>105</fpage><pub-id pub-id-type="pmid">16095966</pub-id></citation></ref><ref id="pgen.1000256-Miyazaki1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Miyazaki</surname><given-names>K</given-names></name><name><surname>Arnold</surname><given-names>FH</given-names></name></person-group><year>1999</year><article-title>Exploring nonnatural evolutionary pathways by saturation mutagenesis: rapid improvement of protein function.</article-title><source>J Mol Evol</source><volume>49</volume><fpage>716</fpage><lpage>720</lpage><pub-id pub-id-type="pmid">10594172</pub-id></citation></ref><ref id="pgen.1000256-Guo1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guo</surname><given-names>HH</given-names></name><name><surname>Choe</surname><given-names>J</given-names></name><name><surname>Loeb</surname><given-names>LA</given-names></name></person-group><year>2004</year><article-title>Protein tolerance to random amino acid change.</article-title><source>PNAS</source><volume>101</volume><fpage>9205</fpage><lpage>9210</lpage><pub-id pub-id-type="pmid">15197260</pub-id></citation></ref><ref id="pgen.1000256-Drummond1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Drummond</surname><given-names>DA</given-names></name><name><surname>Iverson</surname><given-names>BL</given-names></name><name><surname>Georgiou</surname><given-names>G</given-names></name><name><surname>Arnold</surname><given-names>FH</given-names></name></person-group><year>2005</year><article-title>Why High-error-rate Random Mutagenesis Libraries are Enriched in Functional and Improved Proteins.</article-title><source>Journal of Molecular Biology</source><volume>350</volume><fpage>806</fpage><lpage>816</lpage><pub-id pub-id-type="pmid">15939434</pub-id></citation></ref><ref id="pgen.1000256-Bloom2"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bloom</surname><given-names>JD</given-names></name><name><surname>Labthavikul</surname><given-names>ST</given-names></name><name><surname>Otey</surname><given-names>CR</given-names></name><name><surname>Arnold</surname><given-names>FH</given-names></name></person-group><year>2006</year><article-title>Protein stability promotes evolvability.</article-title><source>Proceedings of the National Academy of Sciences</source><volume>103</volume><fpage>5869</fpage><lpage>5874</lpage></citation></ref><ref id="pgen.1000256-Lambert1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lambert</surname><given-names>T</given-names></name><name><surname>Ploy</surname><given-names>MC</given-names></name><name><surname>Courvalin</surname><given-names>P</given-names></name></person-group><year>1994</year><article-title>A spontaneous point mutation in the aac(6&#x02032;)-Ib&#x02032; gene results in altered substrate spec