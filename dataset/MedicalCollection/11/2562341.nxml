bel>7. </label><citation citation-type="journal"><string-name><surname>Southwick</surname> <given-names>CH</given-names></string-name>, <string-name><surname>Siddiqi</surname> <given-names>MF</given-names></string-name> <article-title>Population status of nonhuman primates in Asia, with emphasis on rhesus macaques in India.</article-title><source>Am J Primatol</source> <year>1994</year>;<volume>34</volume>:<fpage>51</fpage>&#x02013;<lpage>9</lpage> <pub-id pub-id-type="doi">10.1002/ajp.1350340110</pub-id></citation></ref><ref id="R8"><label>8. </label><citation citation-type="journal"><string-name><surname>Wolcott</surname> <given-names>LT</given-names></string-name> <article-title>Hanuman: power-dispensing monkey in North Indian folk religion.</article-title><source>J Asian Stud</source> <year>1978</year>;<volume>37</volume>:<fpage>653</fpage>&#x02013;<lpage>61</lpage> <pub-id pub-id-type="doi">10.2307/2054368</pub-id></citation></ref><ref id="R9"><label>9. </label><citation citation-type="journal"><string-name><surname>Jones-Engel</surname> <given-names>L</given-names></string-name>, <string-name><surname>Engel</surname> <given-names>GA</given-names></string-name>, <string-name><surname>Heidrich</surname> <given-names>J</given-names></string-name>, <string-name><surname>Chalise</surname> <given-names>M</given-names></string-name>, <string-name><surname>Poudel</surname> <given-names>N</given-names></string-name>, <string-name><surname>Viscidi</surname> <given-names>R</given-names></string-name>, <etal/><article-title>Temple monkeys and health implications of commensalism, Kathmandu, Nepal.</article-title><source>Emerg Infect Dis</source> <year>2006</year>;<volume>12</volume>:<fpage>900</fpage>&#x02013;<lpage>6</lpage><pub-id pub-id-type="pmid">16707044</pub-id></citation></ref><ref id="R10"><label>10. </label><citation citation-type="journal"><string-name><surname>Schillaci</surname> <given-names>M</given-names></string-name>, <string-name><surname>Jones-Engel</sur