ation></ref><ref id="CR17"><label>17.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mellor</surname><given-names>J</given-names></name><name><surname>Milyo</surname><given-names>J</given-names></name></person-group><article-title>State social capital and individual health status</article-title><source>J Health Polit Policy Law</source><year>2005</year><volume>30</volume><issue>6</issue><fpage>1101</fpage><lpage>1130</lpage><pub-id pub-id-type="doi">10.1215/03616878-30-6-1101</pub-id></citation><citation citation-type="display-unstructured">Mellor J, Milyo J. State social capital and individual health status. J Health Polit Policy Law. 2005;30(6):1101&#x02013;1130. <pub-id pub-id-type="pmid">16481309</pub-id></citation></ref><ref id="CR18"><label>18.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lynch</surname><given-names>J</given-names></name><name><surname>Smith</surname><given-names>GD</given-names></name><name><surname>Hillemeier</surname><given-names>M</given-names></name><name><surname>Shaw</surname><given-names>M</given-names></name><name><surname>Raghunathan</surname><given-names>T</given-names></name><name><surname>Kaplan</surname><given-names>G</given-names></name></person-group><article-title>Income inequality, the psychosocial environment, and health: comparisons of wealthy nations</article-title><source>Lancet</source><year>2001</year><volume>358</volume><fpage>194</fpage><lpage>200</lpage><pub-id pub-id-type="doi">10.1016/S0140-6736(01)05407-1</pub-id></citation><citation citation-type="display-unstructured">Lynch J, Smith GD, Hillemeier M, Shaw M, Raghunathan T, Kaplan G. Income inequality, the psychosocial environment, and health: comparisons of wealthy nations. Lancet. 2001;358:194&#x02013;200. <pub-id pub-id-type="pmid">11476836</pub-id></citation></ref><ref id="CR19"><label>19.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kawachi</surname><given-names>I</given-names></name><name><surname>Kennedy</surname><given-names>BP</given-names></name><name><surname>Lochner</surname><given-names>K</given-names></name><name><surname>Prothrow-Stith</surname><given-names>D</given-names></name></person-group><article-title>Social capital, income inequality and mortality</article-title><source>Am J Public Health</source><year>1997</year><volume>87</volume><fpage>1491</fpage><lpage>1498</lpage></citation><citation citation-type="display-unstructured">Kawachi I, Kennedy BP, Lochner K, Prothrow-Stith D. Social capital, income inequality and mortality. Am J Public Health. 1997;87:1491&#x02013;1498. <pub-id pub-id-type="pmid">9314802</pub-id></citation></ref><ref id="CR20"><label>20.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Galea</surname><given-names>S</given-names></name><name><surname>Vlahov</surname><given-names>D</given-names></name></person-group><article-title>Urban health: evidence, challenges and directions</article-title><source>Annu Rev Public Health</source><year>2005</year><volume>26</volume><fpage>341</fpage><lpage>365</lpage><pub-id pub-id-type="doi">10.1146/annurev.publhealth.26.021304.144708</pub-id></citation><citation citation-type="display-unstructured">Galea S, Vlahov D. Urban health: evidence, challenges and directions. Annu Rev Public Health. 2005;26:341&#x02013;365. <pub-id pub-id-type="pmid">15760293</pub-id></citation></ref><ref id="CR21"><label>21.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Whitehead</surname><given-names>M</given-names></name><name><surname>Diderichsen</surname><given-names>F</given-names></name></person-group><article-title>Social capital and health: tip-toeing through the minefield of evidence</article-title><source>Lancet</source><year>2001</year><volume>358</volume><issue>9277</issue><fpage>165</fpage><lpage>166</lpage><pu