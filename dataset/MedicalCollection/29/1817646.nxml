e-title>Quality of life: What is it?</article-title><source>Geriatr Nurs</source><year>1995</year><volume>16</volume><fpage>49</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">7774817</pub-id><pub-id pub-id-type="doi">10.1016/S0197-4572(05)80001-1</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Efklides</surname><given-names>A</given-names></name><name><surname>Kalaitzidou</surname><given-names/></name><name><surname>Chankin</surname><given-names>G</given-names></name></person-group><article-title>Subjective quality of life in old age in Greece</article-title><source>Eur Psychologist</source><year>2003</year><volume>8</volume><fpage>178</fpage><lpage>191</lpage><pub-id pub-id-type="doi">10.1027//1016-9040.8.3.178</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Von Heideken Wagert</surname><given-names>P</given-names></name><name><surname>Ronnmark</surname><given-names>B</given-names></name><name><surname>Rosendahl</surname><given-names>E</given-names></name><name><surname>Lundin-Olsson</surname><given-names>L</given-names></name><name><surname>Gustavsson</surname><given-names>JM</given-names></name><name><surname>Nygren</surname><given-names>B</given-names></name><name><surname>Lundman</surname><given-names>B</given-names></name><name><surname>Norberg</surname><given-names>A</given-names></name><name><surname>Gustafson</surname><given-names>Y</given-names></name></person-group><article-title>Morale in the oldest old: the Umea 85+ study</article-title><source>Age Ageing</source><year>2005</year><volume>34</volume><fpage>249</fpage><lpage>255</lpage><pub-id pub-id-type="pmid">15784647</pub-id><pub-id pub-id-type="doi">10.1093/ageing/afi044</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fagerstr&#x000f6;m</surname><given-names>