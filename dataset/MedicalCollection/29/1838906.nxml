 method</article-title><source>Proceedings of the Royal Society of London Series B</source><year>1993</year><volume>252</volume><fpage>231</fpage><lpage>236</lpage><pub-id pub-id-type="pmid">8394584</pub-id><pub-id pub-id-type="doi">10.1098/rspb.1993.0070</pub-id></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Miya</surname><given-names>M</given-names></name><name><surname>Saitoh</surname><given-names>K</given-names></name><name><surname>Wood</surname><given-names>R</given-names></name><name><surname>Nishida</surname><given-names>M</given-names></name><name><surname>Mayden</surname><given-names>RL</given-names></name></person-group><article-title>New primers for amplifying and sequencing the mitochondrial ND4/ND5 gene region of the Cypriniformes (Actinopterygii: Ostariophysi)</article-title><source>Ichthyological Research</source><year>2006</year><volume>53</volume><fpage>75</fpage><lpage>81</lpage><pub-id pub-id-type="doi">10.1007/s10228-005-0303-5</pub-id></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>R&#x000fc;ber</surname><given-names>L</given-names></name><name><surname>Britz</surname><given-names>R</given-names></name><name><surname>Tan</surname><given-names>HH</given-names></name><name><surname>Ng</surname><given-names>PKL</given-names></name><name><surname>Zardoya</surname><given-names>R</given-names></name></person-group><article-title>Evolution of mouthbrooding and life-history correlates in the fighting fish genus <italic>Betta</italic></article-title><source>Evolution</source><year>2004</year><volume>58</volume><fpage>799</fpage><lpage>813</lpage><pub-id pub-id-type="pmid">15154556</pub-id><pub-id pub-id-type="doi">10.1554/03-364</pub-id></citation></ref><ref id="B33"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Akaike</surname><given-names>H</given-names></name></per