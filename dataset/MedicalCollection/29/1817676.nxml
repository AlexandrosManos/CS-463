" rowspan="1" colspan="1">0.078</td><td align="left" rowspan="1" colspan="1">0.025</td><td align="center" rowspan="1" colspan="1">0.002</td></tr><tr><td align="left" rowspan="1" colspan="1">Screened in fall</td><td align="center" rowspan="1" colspan="1">0.081</td><td align="left" rowspan="1" colspan="1">0.025</td><td align="center" rowspan="1" colspan="1">0.001</td></tr><tr><td align="left" rowspan="1" colspan="1">Constant</td><td align="center" rowspan="1" colspan="1">1.327</td><td align="left" rowspan="1" colspan="1">0.0466</td><td align="center" rowspan="1" colspan="1">0.000</td></tr></tbody></table><table-wrap-foot><fn id="tfn2-ehp0115-000221"><p>The referent group for the interaction term is use of chloramines &#x000d7; year built after 1975.</p></fn></table-wrap-foot></table-wrap></sec><ref-list><title>References</title><ref id="b1-ehp0115-000221"><citation citation-type="journal"><person-group><name><surname>Bellinger</surname><given-names>DC</given-names></name></person-group><year>1995</year><article-title>Interpreting the literature on lead and child development: the neglected role of the &#x0201c;experimental system</article-title><source>Neurotoxicol Teratol</source><volume>17</volume><issue>3</issue><fpage>201</fpage><lpage>212</lpage><pub-id pub-id-type="pmid">7542726</pub-id></citation></ref><ref id="b2-ehp0115-000221"><citation citation-type="journal"><person-group><name><surname>Canfield</surname><given-names>RL</given-names></name><name><surname>Henderson</surname><given-names>CR</given-names></name><name><surname>Cory-Slechta</surname><given-names>DA</given-names></name><name><surname>Cox</surname><given-names>C</given-names></name><name><surname>Jusko</surname><given-names>TA</given-names></name><name><surname>Lanphear</surname><given-names>BP</given-names></name></person-group><year>2003a</year><article-title>Intellectual impairment in children with blood lead concentrations below 10 &#x003bc;g per deciliter</article-title><source>N Engl J Med</