name><surname>Woodgett</surname><given-names>JR</given-names></name></person-group><year>2002</year><article-title>Multiple phosphoinositide 3-kinase-dependent steps in activation of protein kinase B</article-title><source>Mol Cell Biol</source><volume>22</volume><fpage>6247</fpage><lpage>6260</lpage><pub-id pub-id-type="pmid">12167717</pub-id></element-citation></ref><ref id="b57-ehp0115-000734"><element-citation publication-type="journal"><person-group><name><surname>Short</surname><given-names>AL</given-names></name><name><surname>Wright</surname><given-names>FE</given-names></name><name><surname>Whitney</surname><given-names>JE</given-names></name></person-group><year>1965</year><article-title>Effects of anareobiosis and cell poisons on glucose uptake of hemidiaphragms and epdidymal fat pads in vitro</article-title><source>Diabetes</source><volume>14</volume><fpage>128</fpage><lpage>131</lpage><pub-id pub-id-type="pmid">14262219</pub-id></element-citation></ref><ref id="b58-ehp0115-000734"><element-citation publication-type="journal"><person-group><name><surname>Souza</surname><given-names>K</given-names></name><name><surname>Maddock</surname><given-names>DA</given-names></name><name><surname>Zhang</surname><given-names>Q</given-names></name><name><surname>Chen</surname><given-names>J</given-names></name><name><surname>Chiu</surname><given-names>C</given-names></name><name><surname>Mehta</surname><given-names>S</given-names></name><etal/></person-group><year>2001</year><article-title>Arsenite activation of P13K/AKT cell survival pathway is mediated by p38 in cultured human keratinocytes</article-title><source>Mol Med</source><volume>7</volume><fpage>767</fpage><lpage>772</lpage><pub-id pub-id-type="pmid">11788791</pub-id></element-citation></ref><ref id="b59-ehp0115-000734"><element-citation publication-type="journal"><person-group><name><surname>Sowell</surname><given-names>MO</given-names></name><name><surname>Robinson</surname><given-names>KA</given-names></n