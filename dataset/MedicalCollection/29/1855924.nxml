g 135,000 Norwegian men and women</article-title><source>Am J Epidemiol</source><year>2004</year><volume>160</volume><fpage>969</fpage><lpage>976</lpage><pub-id pub-id-type="pmid">15522853</pub-id><pub-id pub-id-type="doi">10.1093/aje/kwh303</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Akerman</surname><given-names>MJ</given-names></name><name><surname>Calacanis</surname><given-names>CM</given-names></name><name><surname>Madsen</surname><given-names>MK</given-names></name></person-group><article-title>Relationship between asthma severity and obesity</article-title><source>J Asthma</source><year>2004</year><volume>41</volume><fpage>521</fpage><lpage>526</lpage><pub-id pub-id-type="pmid">15360059</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Belamarich</surname><given-names>PF</given-names></name><name><surname>Luder</surname><given-names>E</given-names></name><name><surname>Kattan</surname><given-names>M</given-names></name><name><surname>Mitchell</surname><given-names>H</given-names></name><name><surname>Islam</surname><given-names>S</given-names></name><name><surname>Lynn</surname><given-names>H</given-names></name><name><surname>Crain</surname><given-names>EF</given-names></name></person-group><article-title>Do obese inner-city children with asthma have more symptoms than nonobese children with asthma?</article-title><source>Pediatrics</source><year>2000</year><volume>106</volume><fpage>1436</fpage><lpage>1441</lpage><pub-id pub-id-type="pmid">11099600</pub-id><pub-id pub-id-type="doi">10.1542/peds.106.6.1436</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>von Mutius</surname><given-names>E</given-names></name><name><surname>Schwartz</surname><given-names>J</given-names></name><name><surname>Neas</surname><given-names>LM