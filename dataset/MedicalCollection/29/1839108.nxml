 person-group-type="author"><name><surname>Wang</surname><given-names>Y</given-names></name><name><surname>Collins</surname><given-names>C</given-names></name><name><surname>Tang</surname><given-names>S</given-names></name><name><surname>Martineau</surname><given-names>T</given-names></name></person-group><article-title>Health Systems Decentralization and Human Resources Management in Low and Middle Income Countries</article-title><source>Public Administration and Development</source><year>2002</year><volume>22</volume><fpage>439</fpage><lpage>453</lpage><pub-id pub-id-type="doi">10.1002/pad.246</pub-id></citation></ref><ref id="B6"><citation citation-type="other"><person-group person-group-type="author"><collab>World Bank</collab></person-group><article-title>World Bank List of Economies (July 2005)</article-title><ext-link ext-link-type="uri" xlink:href="http://www.iscb.org/pdfs/WorldBankClassificationList2005.pdf"/></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Anand</surname><given-names>S</given-names></name><name><surname>Barnighausen</surname><given-names>T</given-names></name></person-group><article-title>Human resources and health outcomes: cross-country econometric study</article-title><source>Lancet</source><year>2004</year><volume>364</volume><fpage>1603</fpage><lpage>1609</lpage><pub-id pub-id-type="pmid">15519630</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(04)17313-3</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Robinson</surname><given-names>JJ</given-names></name><name><surname>Wharrad</surname><given-names>H</given-names></name></person-group><article-title>The relationship between attendance at birth and maternal mortality rates: an exploration of United Nations' data sets including the ratios of physicians and nurses to population, GNP per capita and female literacy</article-title><sour