age><pub-id pub-id-type="pmid">1604375</pub-id><pub-id pub-id-type="doi">10.1016/0277-9536(92)90253-M</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nixon</surname><given-names>J</given-names></name><name><surname>Ulmann</surname><given-names>P</given-names></name></person-group><article-title>The relationship between health care expenditure and health outcomes. Evidence and caveats for a causal link</article-title><source>Eur J Health Econ</source><year>2006</year><volume>7</volume><fpage>7</fpage><lpage>18</lpage><pub-id pub-id-type="pmid">16429295</pub-id><pub-id pub-id-type="doi">10.1007/s10198-005-0336-8</pub-id></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><collab>WHO East Mediterranean Regional Office</collab></person-group><source>The Work of the WHO in the East Mediterranean Region: Annual Report of the Regional Director</source><year>2004</year><publisher-name>Cairo: World Health Organization</publisher-name></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><collab>WHO East Mediterranean Regional Office</collab></person-group><source>The Work of the WHO in the East Mediterranean Region: Annual Report of the Regional Director</source><year>2005</year><publisher-name>Cairo: World Health Organization</publisher-name></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Aiken</surname><given-names>LH</given-names></name><name><surname>Clarke</surname><given-names>SP</given-names></name><name><surname>Sloane</surname><given-names>DM</given-names></name><name><surname>Sochalski</surname><given-names>J</given-names></name><name><surname>Silber</surname><given-names>JH</given-names></name></person-group><article-title>Hospital nurse staffing and patient mortality, nurse burnout, and job dissatisfaction</article-title><source>JAMA</source><year>2002</year><volume>288</volume><fpage>1987</fpage><lpage>1993</lpage><pub-id pub-id-type="pmid">12387650</pub-id><pub-id pub-id-type="doi">10.1001/jama.288.16.1987</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>O'Brien-Pallas</surname><given-names>L</given-names></name><name><surname>Alksnis</surname><given-names>C</given-names></name><name><surname>Wang</surname><given-names>S</given-names></name><name><surname>Birch</surname><given-names>S</given-names></name><name><surname>Tomblin Murphy</surname><given-names>G</given-names></name><name><surname>Roy</surname><given-names>FA</given-names></name><name><surname>Sajan</surname><given-names>P</given-names></name></person-group><article-title>Early retirement among RNs: Estimating the size of the problem in Canada</article-title><source>Longwoods Review</source><year>2003</year><volume>1</volume><fpage>2</fpage><lpage>9</lpage></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bloor</surname><given-names>K</given-names></name><name><surname>Maynard</surname><given-names>A</given-names></name></person-group><source>Planning Human Resources in Health Care: Towards an economic approach &#x02013; An International Comparative Review</source><year>2003</year><publisher-name>Ottawa, Canada. Canadian Health Services Research Foundation</publisher-name></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Baranek</surname><given-names>PM</given-names></name></person-group><source>A review of Scopes of Practice of Health Professions in Canada: A Balancing Act</source><year>2005</year><publisher-name>Toronto, Ontario: Health Council of Canada</publisher-name></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><collab>World Health Organi