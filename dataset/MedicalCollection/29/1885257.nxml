>2857</lpage><pub-id pub-id-type="pmid">4517939</pub-id><pub-id pub-id-type="doi">10.1073/pnas.70.10.2853</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Frigaard</surname><given-names>NU</given-names></name><name><surname>Martinez</surname><given-names>A</given-names></name><name><surname>Mincer</surname><given-names>TJ</given-names></name><name><surname>DeLong</surname><given-names>EF</given-names></name></person-group><article-title>Proteorhodopsin lateral gene transfer between marine planktonic Bacteria and Archaea</article-title><source>Nature</source><year>2006</year><volume>439</volume><fpage>847</fpage><lpage>850</lpage><pub-id pub-id-type="pmid">16482157</pub-id><pub-id pub-id-type="doi">10.1038/nature04435</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matsuno-Yagi</surname><given-names>A</given-names></name><name><surname>Mukohata</surname><given-names>Y</given-names></name></person-group><article-title>Two possible roles of bacteriorhodopsin; a comparative study of strains of Halobacterium halobium differing in pigmentation</article-title><source>Biochem Biophys Res Commun</source><year>1977</year><volume>78</volume><fpage>237</fpage><lpage>243</lpage><pub-id pub-id-type="pmid">20882</pub-id><pub-id pub-id-type="doi">10.1016/0006-291X(77)91245-1</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Spudich</surname><given-names>EN</given-names></name><name><surname>Spudich</surname><given-names>JL</given-names></name></person-group><article-title>Control of transmembrane ion fluxes to select halorhodopsin-deficient and other energy-transduction mutants of Halobacterium halobium</article-title><source>Proc Natl Acad Sci U S A</source><year>1982</year><volume>79</volume><fpage>4308</fpage><lpage>4312</lpage><pub-id pub-id-ty