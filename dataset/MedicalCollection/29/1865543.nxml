ame>Wolf JB, Brodie ED, Wade MJ</surname></name></person-group><article-title>Epistasis as a genetic constraint within populations and an accelerant of adaptive divergence among them</article-title><source>Epistasis and the Evolutionary Process</source><year>2000</year><publisher-name>Oxford University Press</publisher-name><fpage>213</fpage><lpage>231</lpage></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Dobzhansky</surname><given-names>T</given-names></name></person-group><source>Genetics and the Origin of Species</source><year>1937</year><publisher-name>Columbia University Press</publisher-name><pub-id pub-id-type="pmid">17246845</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Orr</surname><given-names>HA</given-names></name></person-group><article-title>The population genetics of speciation: the evolution of hybrid incompatibilities</article-title><source>Genetics</source><year>1995</year><volume>139</volume><fpage>1805</fpage><lpage>1813</lpage><pub-id pub-id-type="pmid">7789779</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Turelli</surname><given-names>M</given-names></name><name><surname>Orr</surname><given-names>HA</given-names></name></person-group><article-title>Dominance, epistasis and the genetics of postzygotic isolation</article-title><source>Genetics</source><year>2000</year><volume>154</volume><fpage>1663</fpage><lpage>1679</lpage><pub-id pub-id-type="pmid">10747061</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Demuth</surname><given-names>JP</given-names></name><name><surname>Wade</surname><given-names>MJ</given-names></name></person-group><article-title>On the theoretical and empirical framework for studying genetic interactions within and among species</article-title><source>Am Nat</source><year>2005</year><volume>165</volume><fpage>524</fpage><lpage>536</lpage><pub-id pub-id-type="pmid">15795850</pub-id><pub-id pub-id-type="doi">10.1086/429276</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kondrashov</surname><given-names>AS</given-names></name></person-group><article-title>Classification of hypotheses on the advantage of amphimixis</article-title><source>J Heredity</source><year>1993</year><volume>84</volume><fpage>372</fpage><lpage>387</lpage></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Otto</surname><given-names>SP</given-names></name><name><surname>Feldman</surname><given-names>MW</given-names></name></person-group><article-title>Deleterious mutations, variable epistatic interactions, and the evolution of recombination</article-title><source>Theor Pop Biol</source><year>1997</year><volume>51</volume><fpage>134</fpage><lpage>147</lpage><pub-id pub-id-type="pmid">9169238</pub-id><pub-id pub-id-type="doi">10.1006/tpbi.1997.1301</pub-id></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Peters</surname><given-names>AD</given-names></name><name><surname>Lively</surname><given-names>CM</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Wolf JB, Brodie ED, Wade MJ</surname></name></person-group><article-title>Epistasis and the maintenance of sex</article-title><source>Epistasis and the Evolutionary Process</source><year>2000</year><publisher-name>Oxford University Press</publisher-name><fpage>99</fpage><lpage>112</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kouyos</surname><given-names>RD</given-names></name><name><surname>Otto</surname><given-names>SP</given-names></name><name><surname>Bonhoeffer</surname><given-names>S</given-names></name></person-group><article-title>Effect of varying epistasis on the evolution of recombination</article-title><source>Genetics</source><year>2006</year><volume>173</volume><fpage>589</fpage><lpage>597</lpage><pub-id pub-id-type="pmid">16547114</pub-id><pub-id pub-id-type="doi">10.1534/genetics.105.053108</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Elena</surname><given-names>SF</given-names></name><name><surname>Lenski</surname><given-names>RE</given-names></name></person-group><article-title>Epistasis between new mutations and genetic background and a test of genetic canalization</article-title><source>Evolution</source><year>2001</year><volume>55</volume><fpage>1746</fpage><lpage>1752</lpage><pub-id pub-id-type="pmid">11681730</pub-id><pub-id pub-id-type="doi">10.1554/0014-3820(2001)055[1746:EBNMAG]2.0.CO;2</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wilke</surname><given-names>CO</given-names></name><name><surname>Wang</surname><given-names>J</given-names></name><name><surname>Ofria</surname><given-names>C</given-names></name><name><surname>Lenski</surname><given-names>RE</given-names></name><name><surname>Adami</surname><given-names>C</given-names></name></person-group><article-title>Evolution of digital organisms at high mutation rate leads to survival of the flattest</article-title><source>Nature</source><year>2001</year><volume>412</volume><fpage>331</fpage><lpage>333</lpage><pub-id pub-id-type="pmid">11460163</pub-id><pub-id pub-id-type="doi">10.1038/35085569</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burch</surname><given-names>CL</given-names></name><name><surname>Chao</surname><given-names>L</given-names></name></person-gr