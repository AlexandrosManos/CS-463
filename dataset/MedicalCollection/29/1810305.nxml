="journal"><person-group person-group-type="author"><name><surname>Sherwin</surname><given-names>T</given-names></name><name><surname>Gull</surname><given-names>K</given-names></name></person-group><article-title>The cell division cycle of <italic>Trypanosoma brucei brucei </italic>: timing of event markers and cytoskeletal modulations</article-title><source>Philos Trans R Soc Lond B Biol Sci</source><year>1989</year><volume>323</volume><fpage>573</fpage><lpage>588</lpage><pub-id pub-id-type="pmid">2568647</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ashall</surname><given-names>F</given-names></name><name><surname>Angliker</surname><given-names>H</given-names></name><name><surname>Shaw</surname><given-names>E</given-names></name></person-group><article-title>Lysis of trypanosomes by peptidyl fluoromethyl ketones</article-title><source>Biochem Biophy Res Commun</source><year>1990</year><volume>170</volume><fpage>923</fpage><lpage>929</lpage><pub-id pub-id-type="doi">10.1016/0006-291X(90)92179-4</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wilcox</surname><given-names>D</given-names></name><name><surname>Mason</surname><given-names>RW</given-names></name></person-group><article-title>Inhibition of cysteine proteinases in lysosomes and whole cells</article-title><source>Biochem J</source><year>1992</year><volume>285</volume><fpage>495</fpage><lpage>502</lpage><pub-id pub-id-type="pmid">1637341</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crawford</surname><given-names>C</given-names></name><name><surname>Mason</surname><given-names>RW</given-names></name><name><surname>Wikstrom</surname><given-names>P</given-names></name><name><surname>Shaw</surname><given-names>E</given-names></name></person-group><article-title>The design of peptidyldiazomethane inhibitors to distinguish between the cysteine proteinases calpain II, cathepsin L and cathepsin B</article-title><source>Biochem J</source><year>1988</year><volume>253</volume><fpage>751</fpage><lpage>758</lpage><pub-id pub-id-type="pmid">2845932</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Engel</surname><given-names>JC</given-names></name><name><surname>Doyle</surname><given-names>PS</given-names></name><name><surname>Palmer</surname><given-names>J</given-names></name><name><surname>Hsieh</surname><given-names>I</given-names></name><name><surname>Bainton</surname><given-names>DF</given-names></name><name><surname>McKerrow</surname><given-names>JH</given-names></name></person-group><article-title>Cysteine protease inhibitors alter Golgi complex ultrastructure and function in <italic>Trypanosoma cruzi</italic></article-title><source>J Cell Sci</source><year>1998</year><volume>111</volume><fpage>597</fpage><lpage>606</lpage><pub-id pub-id-type="pmid">9454733</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rosenthal</surname><given-names>PJ</given-names></name><name><surname>Wollish</surname><given-names>WS</given-names></name><name><surname>Palmer</surname><given-names>JT</given-names></name><name><surname>Rasnick</surname><given-names>D</given-names></name></person-group><article-title>Antimalarial effects of peptide inhibitors of a <italic>Plasmodium falciparum </italic>cysteine proteinase</article-title><source>J Clin Invest</source><year>1991</year><volume>88</volume><fpage>1467</fpage><lpage>1472</lpage><pub-id pub-id-type="pmid">1939639</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rosenthal</surname><given-names>PJ</given-names></name></person-group><article-title><italic>Plasmodium falci