tle><source>JAMA</source><year>1998</year><volume>279</volume><fpage>1548</fpage><lpage>1553</lpage><pub-id pub-id-type="pmid">9605899</pub-id><pub-id pub-id-type="doi">10.1001/jama.279.19.1548</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rafferty</surname><given-names>AP</given-names></name><name><surname>McGee</surname><given-names>HB</given-names></name><name><surname>Miller</surname><given-names>CE</given-names></name><name><surname>Reyes</surname><given-names>M</given-names></name></person-group><article-title>Prevalence of complementary and alternative medicine use: state-specific estimates from the 2001 Behavioral Risk Factor Surveillance System</article-title><source>Am J Public Health</source><year>2002</year><volume>92</volume><fpage>1598</fpage><lpage>1600</lpage><pub-id pub-id-type="pmid">12356602</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burge</surname><given-names>SK</given-names></name><name><surname>Albright</surname><given-names>TL</given-names></name></person-group><article-title>Use of complementary and alternative medicine among family practice patients in south Texas</article-title><source>Am J Public Health</source><year>2002</year><volume>92</volume><fpage>1614</fpage><lpage>1616</lpage><pub-id pub-id-type="pmid">12356609</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Baldwin</surname><given-names>CM</given-names></name><name><surname>Long</surname><given-names>K</given-names></name><name><surname>Kroesen</surname><given-names>K</given-names></name><name><surname>Brooks</surname><given-names>AJ</given-names></name><name><surname>Bell</surname><given-names>IR</given-names></name></person-group><article-title>A profile of military veterans in the southwestern United States who use complementary an