SR1<sup>+</sup>/ERBB2<sup>-</sup></td></tr><tr><td align="center">ULL-D-096</td><td align="center">ERBB2</td><td align="center">ERBB2<sup>+</sup></td></tr><tr><td align="center">ULL-D-099</td><td align="center">Basal-like</td><td align="center">ESR1<sup>-</sup>/ERBB2<sup>-</sup></td></tr><tr><td align="center">ULL-D-101</td><td align="center">ERBB2</td><td align="center">ERBB2<sup>+</sup></td></tr><tr><td align="center">ULL-D-122</td><td align="center">Luminal A</td><td align="center">ESR1<sup>+</sup>/ERBB2<sup>-</sup></td></tr><tr><td align="center">ULL-D-132</td><td align="center">None</td><td align="center">ESR1<sup>+</sup>/ERBB2<sup>-</sup></td></tr><tr><td align="center">ULL-D-135</td><td align="center">None</td><td align="center">ESR1<sup>+</sup>/ERBB2<sup>-</sup></td></tr><tr><td align="center">ULL-D-139</td><td align="center">Basal-like</td><td align="center">ESR1<sup>-</sup>/ERBB2<sup>-</sup></td></tr><tr><td align="center">ULL-D-143</td><td align="center">Luminal A</td><td align="center">ESR1<sup>+</sup>/ERBB2<sup>-</sup></td></tr><tr><td align="center">ULL-D-144</td><td align="center">Luminal A</td><td align="center">ESR1<sup>+</sup>/ERBB2<sup>-</sup></td></tr><tr><td align="center">ULL-D-183</td><td align="center">None</td><td align="center">ESR1<sup>+</sup>/ERBB2<sup>-</sup></td></tr></tbody></table></table-wrap></sec></back></article>