group person-group-type="author"><name><surname>Karron</surname><given-names>RA</given-names></name><name><surname>Wright</surname><given-names>PF</given-names></name><name><surname>Crowe</surname><given-names>JE</given-names><suffix>Jr</suffix></name><name><surname>Clements-Mann</surname><given-names>ML</given-names></name><name><surname>Thompson</surname><given-names>J</given-names></name><name><surname>Makhene</surname><given-names>M</given-names></name><name><surname>Casey</surname><given-names>R</given-names></name><name><surname>Murphy</surname><given-names>BR</given-names></name></person-group><article-title>Evaluation of two live, cold-passaged, temperature-sensitive respiratory syncytial virus vaccines in chimpanzees and in human adults, infants, and children.</article-title><source>J Infect Dis</source><year>1997</year><volume>176</volume><fpage>1428</fpage><lpage>1436</lpage><pub-id pub-id-type="pmid">9395351</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Collins</surname><given-names>PL</given-names></name><name><surname>Whitehead</surname><given-names>SS</given-names></name><name><surname>Bukreyev</surname><given-names>A</given-names></name><name><surname>Fearns</surname><given-names>R</given-names></name><name><surname>Teng</surname><given-names>MN</given-names></name><name><surname>Juhasz</surname><given-names>K</given-names></name><name><surname>Chanock</surname><given-names>RM</given-names></name><name><surname>Murphy</surname><given-names>BR</given-names></name></person-group><article-title>Rational design of live-attenuated recombinant vaccine virus for human respiratory syncytial virus by reverse genetics.</article-title><source>Adv Virus Res</source><year>1999</year><volume>54</volume><fpage>423</fpage><lpage>451</lpage><pub-id pub-id-type="pmid">10547682</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="autho