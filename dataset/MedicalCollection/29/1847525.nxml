me><surname>Saini</surname><given-names>A</given-names></name><name><surname>Kumar</surname><given-names>D</given-names></name><name><surname>Yadav</surname><given-names>NS</given-names></name><name><surname>Chand</surname><given-names>K</given-names></name><name><surname>Mor</surname><given-names>S</given-names></name><name><surname>Dhawan</surname><given-names>SN</given-names></name></person-group><source>J Chem Soc Perkin Trans</source><year>1995</year><volume>I</volume><fpage>177</fpage><lpage>81</lpage><pub-id pub-id-type="doi">10.1039/p19950000177</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Van Tamelen</surname><given-names>EE</given-names></name><name><surname>Whitesides</surname><given-names>TH</given-names></name></person-group><source>J Am Chem Soc</source><year>1971</year><volume>93</volume><fpage>6129</fpage><lpage>40</lpage><pub-id pub-id-type="doi">10.1021/ja00752a025</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Van Tamelen</surname><given-names>EE</given-names></name><name><surname>Whitesides</surname><given-names>TH</given-names></name></person-group><source>J Am Chem Soc</source><year>1968</year><volume>90</volume><fpage>3894</fpage><lpage>96</lpage><pub-id pub-id-type="doi">10.1021/ja01016a071</pub-id></citation></ref></ref-list></back></article>