ar>1995</year><volume>21</volume><fpage>58</fpage><lpage>83</lpage></citation></ref><ref id="b9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bergem</surname><given-names>M</given-names></name></person-group><article-title>Long-term maintenance of in vitro cultured honeybee (<italic>Apis mellifera</italic>) embryonic cells</article-title><source>BMC Dev Biol</source><year>2006</year><volume>6</volume><fpage>17</fpage><lpage>17</lpage><comment>online</comment><pub-id pub-id-type="pmid">16545111</pub-id></citation></ref><ref id="b10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boutros</surname><given-names>M</given-names></name><etal/></person-group><article-title>Genome-wide RNAi analysis of growth and viability in <italic>Drosophila</italic> cells</article-title><source>Science</source><year>2004</year><volume>303</volume><fpage>832</fpage><lpage>835</lpage><pub-id pub-id-type="pmid">14764878</pub-id></citation></ref><ref id="b11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carsten</surname><given-names>LD</given-names></name></person-group><article-title>Gene expression patterns accompanying a dietary switch in <italic>Drosophila melanogaster</italic></article-title><source>Mol Ecol</source><year>2005</year><volume>14</volume><fpage>3203</fpage><lpage>3208</lpage><pub-id pub-id-type="pmid">16101785</pub-id></citation></ref><ref id="b12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clarke</surname><given-names>ND</given-names></name></person-group><article-title>Rank order metrics for quantifying the association of sequence features with gene regulation</article-title><source>Bioinformatics</source><year>2003</year><volume>19</volume><fpage>212</fpage><lpage>218</lpage><pub-id pub-id-type="pmid">12538241</pub-id></citation></ref><ref id="b13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Colombani</surname><given-names>J</given-names></name><etal/></person-group><article-title>Antagonistic actions of ecdysone and insulins determine final size in <italic>Drosophila</italic></article-title><source>Science</source><year>2005</year><volume>310</volume><fpage>667</fpage><lpage>670</lpage><pub-id pub-id-type="pmid">16179433</pub-id></citation></ref><ref id="b14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Corona</surname><given-names>M</given-names></name></person-group><article-title>Differential expression of mitochondrial genes between queens and workers during caste determination in the honeybee <italic>Apis mellifera</italic></article-title><source>J Exp Biol</source><year>1999</year><volume>202</volume><fpage>929</fpage><lpage>938</lpage><pub-id pub-id-type="pmid">10085265</pub-id></citation></ref><ref id="b15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cunha</surname><given-names>AC</given-names></name></person-group><article-title>Molecular cloning and expression of a hexamerin cDNA from the honey bee</article-title><source>J Insect Physiol</source><year>2005</year><volume>51</volume><fpage>1135</fpage><lpage>1147</lpage><pub-id pub-id-type="pmid">16055147</pub-id></citation></ref><ref id="b16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Darwin</surname><given-names>CR</given-names></name></person-group><source>On the Origin of Species by Means of Natural Selection</source><year>1859</year><publisher-loc>London</publisher-loc><publisher-name>John Murray</publisher-name></citation></ref><ref id="b17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Davidson</surname><given-names>EH</given-names></name></person-group><source>Genomic Regulatory Systems: Development and Evolution</source><year>2001</year><publisher-loc>San Diego</publisher-loc><publisher-name>Academic Press</publisher-name></citation></ref><ref id="b18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eder</surname><given-names>J</given-names></name></person-group><article-title>Correlation of cytochrome c titer and respiration in <italic>Apis mellifera</italic>: adaptive responses to caste determination defines workers, intercastes and queens</article-title><source>Comp Biochem Physiol B</source><year>1983</year><volume>76</volume><fpage>703</fpage><lpage>716</lpage></citation></ref><ref id="b19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Engels</surname><given-names>W</given-names></name></person-group><article-title>Occurrence and significance of vitellogenins in female castes of social Hymenoptera</article-title><source>Am Zool</source><year>1974</year><volume>14</volume><fpage>1229</fpage><lpage>1237</lpage></citation></ref><ref id="b20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Evans</surname><given-names>JD</given-names></name></person-group><article-title>Differential gene expression between developing queens and workers in the honey bee, <italic>Apis mellifera</italic></article-title><source>Proc Natl Acad Sci USA</source><year>1999</year><volume>96</volume><fpage>5575</fpage><lpage>5580</lpage><pub-id pub-id-type="pmid">10318926</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Evans</surname><given-names>JD</given-names></name></person-group><article-title>Expression profiles during honeybee caste determination</article-title><source>Genome Biol 2</source><year>2000</year><volume>1</volume><comment>6 pages, online <ext-link ext-link-type="uri" xlink:href="http://genomebiology.com/2000/2/1/research/0001.1">http://genomebiology.com/2000/2/1/research/0001.1</ext-link></comment></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Forbes</surname><given-names>A</given-names></name></person-group><article-title>Nanos and Pumilio have critical roles in the development and function of <italic>Drosophila</italic> germline stem cells</article-title><source>Development</source><year>1998</year><volume>125</volume><fpage>679</fpage><lpage>690</lpage><pub-id pub-id-type="pmid">9435288</pub-id></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gonz&#x000e1;lez-Reyes</surname><given-names>A</given-names></name></person-group><article-title>Polarization of both major body axes in <italic>Drosophila</italic> by <italic>gurken-torpedo</italic> signalling</article-title><source>Nature</source><year>1995</year><volume>375</volume><fpage>654</fpage><lpage>658</lpage><pub-id pub-id-type="pmid">7791898</pub-id></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goodisman</surname><given-names>MA</given-names></name></person-group><article-title>Evolution of insect metamorphosis: a microarray-based study of larval and adult gene expression in the ant <italic>Camponotus festinatus</italic></article-title><source>Evolution</source><year>2005</year><volume>59</volume><fpage>858</fpage><lpage>870</lpage><pub-id pub-id-type="pmid">15926695</pub-id></citation></ref><ref id="b25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gordon</surname><given-names>DB</given-names></name></person-group><article-title>TAMO: a flexible, object-oriented framework for analysing transcriptional regulation using DNA-sequence motifs</article-title><source>Bioinformatics</source><year>2005</year><volume>21</volume><fpage>3164</fpage><lpage>3165</lpage><pub-id pub-id-type="pmid">15905282</pub-id></citation></ref><ref id="b26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guidugli</surname><given-names>KR</given-names></name></person-group><article-title>A member of the short-chain dehydrogenase/reductase (SDR) superfamily is a target of the ecdysone response in honey bee (<italic>Apis mellifera</italic>) caste development</article-title><source>Apidologie</source><year>2004</year><volume>35</volume><fpage>37</fpage><lpage>47</lpage></citation></ref><ref id="b27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guidugli</surname><given-names>KR</given-names></name></person-group><article-title>Vitellogenin regulates hormonal dynamics in the worker caste of a eusocial insect</article-title><source>FEBS Lett</source><year>2005</year><volume>579</volume><fpage>4961</fpage><lpage>4965</lpage><pub-id pub-id-type="pmid">16122739</pub-id></citation></ref><ref id="b28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hagedorn</surname><given-names>HH</given-names></name></person-group><article-title>The evolution of vitellogenins, cyclorrhaphan yolk proteins and related molecules</article-title><source>Adv Insect Physiol</source><year>1998</year><volume>27</volume><fpage>335</fpage><lpage>384</lpage></citation></ref><ref id="b29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hall</surname><given-names>TA</given-names></name></person-group><article-title>BioEdit: a user-friendly biological sequence alignment editor and analysis program for Windows 95/98/NT</article-title><source>Nucleic Acids Symp Ser</source><year>1999</year><volume>41</volume><fpage>95</fpage><lpage>98</lpage></citation></ref><ref id="b30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamilton</surname><given-names>WD</given-names></name></person-group><article-title>The genetical theory of social behaviour I. &#x00026; II</article-title><source>J Theor Biol</source>