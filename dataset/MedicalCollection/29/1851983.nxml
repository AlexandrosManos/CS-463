me><surname>Herzog</surname><given-names>E</given-names></name></person-group><year>2005</year><article-title>Vasoactive intestinal polypeptide mediates circadian rhythmicity and synchrony in mammalian clock neurons</article-title><source>Nat Neurosci</source><volume>8</volume><fpage>476</fpage><lpage>483</lpage><pub-id pub-id-type="pmid">15750589</pub-id></citation></ref><ref id="pcbi-0030068-b020"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yamaguchi</surname><given-names>S</given-names></name><name><surname>Isejima</surname><given-names>H</given-names></name><name><surname>Matsuo</surname><given-names>T</given-names></name><name><surname>Okura</surname><given-names>R</given-names></name><name><surname>Yagita</surname><given-names>K</given-names></name><etal/></person-group><year>2003</year><article-title>Synchronization of cellular clocks in the suprachiasmatic nucleus</article-title><source>Science</source><volume>302</volume><fpage>1408</fpage><lpage>1412</lpage><pub-id pub-id-type="pmid">14631044</pub-id></citation></ref><ref id="pcbi-0030068-b021"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nitabach</surname><given-names>M</given-names></name><name><surname>Blau</surname><given-names>J</given-names></name><name><surname>Holmes</surname><given-names>T</given-names></name></person-group><year>2002</year><article-title>Electrical silencing of <italic>Drosophila</italic> pacemaker neurons stops the free-running circadian clock</article-title><source>Cell</source><volume>109</volume><fpage>485</fpage><lpage>495</lpage><pub-id pub-id-type="pmid">12086605</pub-id></citation></ref><ref id="pcbi-0030068-b022"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lundkvist</surname><given-names>G</given-names></name><name><surname>Block</surname><given-names>G</given-names></name></person-group><year>2005</year><article-title>Role of neuronal membrane events in circadian rhythm generation</article-title><source>Methods Enzymol</source><volume>393</volume><fpage>623</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">15817316</pub-id></citation></ref><ref id="pcbi-0030068-b023"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Becker-Weimann</surname><given-names>S</given-names></name><name><surname>Wolf</surname><given-names>J</given-names></name><name><surname>Herzel</surname><given-names>H</given-names></name><name><surname>Kramer</surname><given-names>A</given-names></name></person-group><year>2004</year><article-title>Modeling feedback loops of the mammalian circadian oscillator</article-title><source>Biophys J</source><volume>87</volume><fpage>3023</fpage><lpage>3034</lpage><pub-id pub-id-type="pmid">15347590</pub-id></citation></ref><ref id="pcbi-0030068-b024"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Noguchi</surname><given-names>T</given-names></name><name><surname>Watanabe</surname><given-names>K</given-names></name><name><surname>Ogura</surname><given-names>A</given-names></name><name><surname>Yamaoka</surname><given-names>S</given-names></name></person-group><year>2004</year><article-title>The clock in the dorsal suprachiasmatic nucleus runs faster than that in the ventral</article-title><source>Eur J Neurosci</source><volume>20</volume><fpage>3199</fpage><lpage>3199</lpage><pub-id pub-id-type="pmid">15579176</pub-id></citation></ref><ref id="pcbi-0030068-b025"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lundkvist</surname><given-names>G</given-names></name><name><surname>Kwak</surname><given-names>Y</given-names></name><name><surname>Davis</surname><given-names>E</given-names></name><name><surname>Tei</surname><given-names>H</given-names></name><name><surname>Block</surname><given-names>G</given-names></name></person-group><year>2005</year><article-title>A calci