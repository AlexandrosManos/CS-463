-type="author"><name><surname>Riserus</surname><given-names>U</given-names></name><name><surname>Arnlov</surname><given-names>J</given-names></name><name><surname>Brismar</surname><given-names>K</given-names></name><name><surname>Zethelius</surname><given-names>B</given-names></name><name><surname>Berglund</surname><given-names>L</given-names></name><name><surname>Vessby</surname><given-names>B</given-names></name></person-group><article-title>Sagittal abdominal diameter is a strong anthropometric marker of insulin resistance and hyperproinsulinemia in obese men</article-title><source>Diabetes Care</source><year>2004</year><volume>27</volume><fpage>2041</fpage><lpage>2046</lpage><pub-id pub-id-type="pmid">15277437</pub-id><pub-id pub-id-type="doi">10.2337/diacare.27.8.2041</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Turcato</surname><given-names>E</given-names></name><name><surname>Bosello</surname><given-names>O</given-names></name><name><surname>Di Francesco</surname><given-names>V</given-names></name><name><surname>Harris</surname><given-names>TB</given-names></name><name><surname>Zoico</surname><given-names>E</given-names></name><name><surname>Bissoli</surname><given-names>L</given-names></name><name><surname>Fracassi</surname><given-names>E</given-names></name><name><surname>Zamboni</surname><given-names>M</given-names></name></person-group><article-title>Waist circumference and abdominal sagittal diameter as surrogates of body fat distribution in the elderly: their relation with cardiovascular risk factors</article-title><source>Int J Obes Relat Metab Disord</source><year>2000</year><volume>24</volume><fpage>1005</fpage><lpage>1010</lpage><pub-id pub-id-type="pmid">10951539</pub-id><pub-id pub-id-type="doi">10.1038/sj.ijo.0801352</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Richelsen</surname><gi