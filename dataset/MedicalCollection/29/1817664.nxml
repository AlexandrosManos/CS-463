>Ann Intern Med</source><volume>118</volume><fpage>448</fpage><lpage>454</lpage><pub-id pub-id-type="pmid">8382459</pub-id></citation></ref><ref id="b11-ehp0115-000146"><citation citation-type="journal"><person-group><name><surname>Chan</surname><given-names>LC</given-names></name><name><surname>Lam</surname><given-names>TH</given-names></name><name><surname>Li</surname><given-names>CK</given-names></name><name><surname>Lau</surname><given-names>YI</given-names></name><name><surname>Li</surname><given-names>CK</given-names></name><name><surname>Yuen</surname><given-names>HL</given-names></name><etal/></person-group><year>2002</year><article-title>Is the timing of exposure to infection a major determinant of acute lymphoblastic leukaemia in Hong Kong?</article-title><source>Paediatr Perinat Epidemiol</source><volume>16</volume><fpage>154</fpage><lpage>165</lpage><pub-id pub-id-type="pmid">12060313</pub-id></citation></ref><ref id="b12-ehp0115-000146"><citation citation-type="journal"><person-group><name><surname>Chang</surname><given-names>ET</given-names></name><name><surname>Zheng</surname><given-names>T</given-names></name><name><surname>Lennette</surname><given-names>ET</given-names></name><name><surname>Weir</surname><given-names>EG</given-names></name><name><surname>Borowitz</surname><given-names>M</given-names></name><name><surname>Mann</surname><given-names>RB</given-names></name><etal/></person-group><year>2004a</year><article-title>Heterogeneity of risk factors and antibody profiles in Epstein-Barr virus genome-positive and -negative Hodgkin lymphoma</article-title><source>J Infect Dis</source><volume>189</volume><fpage>2271</fpage><lpage>2281</lpage><pub-id pub-id-type="pmid">15181575</pub-id></citation></ref><ref id="b13-ehp0115-000146"><citation citation-type="journal"><person-group><name><surname>Chang</surname><given-names>ET</given-names></name><name><surname>Zheng</surname><given-names>T</given-names></name><name><surname>Weir</surname><given-names>EG</given-names></name><name><surname>Borowitz</surname><given-names>M</given-names></name><name><surname>Mann</surname><given-names>RB</given-names></name><name><surname>Spiegelman</surname><given-names>D</given-names></name><etal/></person-group><year>2004b</year><article-title>Childhood social environment and Hodgkin&#x02019;s lymphoma: new findings from a population-based case-control study</article-title><source>Cancer Epidemiol Biomarkers Prev</source><volume>13</volume><fpage>1361</fpage><lpage>1370</lpage><pub-id pub-id-type="pmid">15298959</pub-id></citation></ref><ref id="b14-ehp0115-000146"><citation citation-type="journal"><person-group><name><surname>Chang</surname><given-names>KC</given-names></name><name><surname>Khen</surname><given-names>NT</given-names></name><name><surname>Jones</surname><given-names>D</given-names></name><name><surname>Su</surname><given-names>JJ</given-names></name></person-group><year>2005</year><article-title>Epstein-Barr virus is associated with all histological subtypes of Hodgkin lymphoma in Vietnamese children with special emphasis on the entity of lymphocyte predominance subtype</article-title><source>Hum Pathol</source><volume>36</volume><fpage>747</fpage><lpage>755</lpage><pub-id pub-id-type="pmid">16084943</pub-id></citation></ref><ref id="b15-ehp0115-000146"><citation citation-type="journal"><person-group><name><surname>Dockerty</surname><given-names>JD</given-names></name><name><surname>Skegg</surname><given-names>DCG</given-names></name><name><surname>Elwood</surname><given-names>JM</given-names></name><name><surname>Herbison</surname><given-names>GP</given-names></name><name><surname>Becroft</surname><given-names>DMO</given-names></name><name><surname>Lewis</surname><given-names>ME</given-names></name></person-group><year>1999</year><article-title>Infections, vaccinations, and the risk of childhood leukaemia</article-title><source>Br J Cancer</source><volume>80</volume><fpage>1483</fpage><lpage>1489</lpage><pub-id p