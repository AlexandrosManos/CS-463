ce>International Classification of Impairments, Disabilities and Handicaps</source><year>1980</year><publisher-name>Geneva: World Health Organisation</publisher-name></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><collab>World Health Organisation</collab></person-group><source>The International Classification of Functioning, Disability and Health</source><year>2001</year><publisher-name>Geneva: World Health Organisation</publisher-name></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Likert</surname><given-names>R</given-names></name></person-group><article-title>A technique for the measurement of attitudes</article-title><source>Archives of Psychology</source><year>1932</year><volume>140</volume><fpage>44</fpage><lpage>60</lpage></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guttman</surname><given-names>LL</given-names></name></person-group><article-title>A basis for the scaling of quantitative data</article-title><source>Am Sociol Rev</source><year>1944</year><volume>9</volume><fpage>139</fpage><lpage>150</lpage><pub-id pub-id-type="doi">10.2307/2086306</pub-id></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Thurstone</surname><given-names>L</given-names></name><name><surname>Chave</surname><given-names>EJ</given-names></name></person-group><source>The measurement of attitude</source><year>1929</year><publisher-name>Chicago: University of Chicago Press</publisher-name></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pollard</surname><given-names>B</given-names></name><name><surname>Johnston</surname><given-names>M</given-names></name></person-group><article-title>Problems with the Sickness Impact Profile: a theoretically based analysis and a proposal for a new method of implementation and scoring</article-title><source>Soc Sci Med</source><year>2001</year><volume>52</volume><fpage>921</fpage><lpage>934</lpage><pub-id pub-id-type="pmid">11234865</pub-id><pub-id pub-id-type="doi">10.1016/S0277-9536(00)00194-5</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chard</surname><given-names>JA</given-names></name><name><surname>Tallon</surname><given-names>D</given-names></name><name><surname>Dieppe</surname><given-names>PA</given-names></name></person-group><article-title>Epidemiology of research into interventions for the treatment of osteoarthritis of the knee joint</article-title><source>Ann Rheum Dis</source><year>2000</year><volume>59</volume><fpage>414</fpage><lpage>418</lpage><pub-id pub-id-type="pmid">10834855</pub-id><pub-id pub-id-type="doi">10.1136/ard.59.6.414</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ranawat</surname><given-names>CS</given-names></name><name><surname>Insall</surname><given-names>J</given-names></name><name><surname>Shine</surname><given-names>J</given-names></name></person-group><article-title>Duo-Condylar knee arthroscopy</article-title><source>Clin Orthop Relat Res</source><year>1976</year><volume>120</volume><fpage>76</fpage><lpage>92</lpage><pub-id pub-id-type="pmid">975669</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>D'Aubigne</surname><given-names>RM</given-names></name><name><surname>Postel</surname><given-names>M</given-names></name></person-group><article-title>Hip arthroplasty and acrylic prosthesis</article-title><source>Journal of Bone and Joint Surgery-American Volume</source><year>1954</year><volume>36-A</volume><fpage>451</fpage><lpage>465</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bergner</surname><given-names>M</given-names></name><name><surname>Bobbitt</surname><given-names>RA</given-names></name><name><surname>Carter</surname><given-names>WB</given-names></name><name><surname>Gilson</surname><given-names>BS</given-names></name></person-group><article-title>The Sickness Impact Profile &#x02013; development and final revision of a health-status measure</article-title><source>Med Care</source><year>1981</year><volume>19</volume><fpage>787</fpage><lpage>805</lpage><pub-id pub-id-type="pmid">7278416</pub-id><pub-id pub-id-type="doi">10.1097/00005650-198108000-00001</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><article-title>Euroqol-A New Facility for the Measurement of Health-Related Quality-Of-Life</article-title><source>Health Policy</source><year>1990</year><volume>16</volume><fpage>199</fpage><lpage>208</lpage><pub-id pub-id-type="pmid">10109801</pub-id><pub-id pub-id-type="doi">10.1016/0168-8510(90)90421-9</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ware</surname><given-names>JE</given-names></name></person-group><article-title>Standards for Validating Health Measures &#x02013; Definition and Content</article-title><source>J Chronic Dis</source><year>1987</year><volume>40</volume><fpage>473</fpage><lpage>480</lpage><pub-id pub-id-type="pmid">3298292</pub-id><pub-id pub-id-type="doi">10.1016/0021-9681(87)90003-8</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ware</surname><given-names>JE</given-names></name><name><surname>Sherbourne</surname><given-names>CD</given-names></name></person-group><article-title>The MOS 36-item short-form health survey (SF-36) .1. Conceptual-framework and item selection</article-title><source>Med Care</source><year>1992</year><volume>30</volume><fpage>473</fp