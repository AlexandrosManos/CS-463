997</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">4</td></tr><tr><td align="left" rowspan="1" colspan="1">1998</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">1</td></tr><tr><td align="left" rowspan="1" colspan="1">no consistent change</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">6</td></tr></tbody></table><table-wrap-foot><fn id="nt101"><p>For definition of upsurge, see text.</p></fn></table-wrap-foot></table-wrap><table-wrap id="pone-0000500-t002" position="float"><object-id pub-id-type="doi">10.1371/journal.pone.0000500.t002</object-id><label>Table 2</label><caption><title>Years of maximally statistically significant discontinuities in rainfall and snow cover recorded at sites in the three Baltic countries.</title></caption><graphic id="pone-0000500-t002-2" xlink:href="pone.0000500.t002"/><table frame="hsides" rules="groups" alternate-form-of="pone-0000500-t002-2"><colgroup span="1"><col align="left" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/></colgroup><thead><tr><td align="left" rowspan="1" colspan="1">Rainfall</td><td align="left" rowspan="1" colspan="1"/><td colspan="12" align="left" rowspan="1">Year of maximally significant discontinuity</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">County</td><td align="left" rowspan="1" colspan="1">Jan</td><td align="left" rowspan="1" colspan="1">Feb</td><td al