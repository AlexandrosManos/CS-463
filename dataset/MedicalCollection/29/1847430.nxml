her</source><year>2005</year><volume>10</volume><fpage>335</fpage><lpage>341</lpage><pub-id pub-id-type="pmid">15865228</pub-id></citation></ref><ref id="B48"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ng'weshemi</surname><given-names>J</given-names></name><name><surname>Urassa</surname><given-names>M</given-names></name><name><surname>Isingo</surname><given-names>R</given-names></name><name><surname>Mwaluko</surname><given-names>G</given-names></name><name><surname>Ngalula</surname><given-names>J</given-names></name><name><surname>Boerma</surname><given-names>T</given-names></name><name><surname>Marston</surname><given-names>M</given-names></name><name><surname>Zaba</surname><given-names>B</given-names></name></person-group><article-title>HIV impact on mother and child mortality in rural Tanzania</article-title><source>J Acquir Immune Defic Syndr</source><year>2003</year><volume>33</volume><fpage>393</fpage><lpage>404</lpage><pub-id pub-id-type="pmid">12843752</pub-id></citation></ref><ref id="B49"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rouet</surname><given-names>F</given-names></name><name><surname>Fassinou</surname><given-names>P</given-names></name><name><surname>Inwoley</surname><given-names>A</given-names></name><name><surname>Anaky</surname><given-names>MF</given-names></name><name><surname>Kouakoussui</surname><given-names>A</given-names></name><name><surname>Rouzioux</surname><given-names>C</given-names></name><name><surname>Blanche</surname><given-names>S</given-names></name><name><surname>Msellati</surname><given-names>P</given-names></name></person-group><article-title>Long-term survival and immuno-virological response of African HIV-1-infected children to highly active antiretroviral therapy regimens</article-title><source>AIDS</source><year>2006</year><volume>20</volume><fpage>2315</fpage><lpage>2319</lpage><pub-id pub-id-type="pmid">17117017</pub-id><pub-id pub-id-type="doi">10.1097/QAD.0b013e328010943b</pub-id></citation></ref></ref-list><sec sec-type="display-objects"><title>Figures and Tables</title><fig position="float" id="F1"><label>Figure 1</label><caption><p><bold>HIV status and HAART in the primary caregivers of the Sinikithemba paediatric cohor</bold>: The Sinikithemba cohort was cared for by 214 familial and non-familial primary caregivers. Of these 214 primary caregivers; 105 (49.1%) had tested positive for HIV of whom 68 (64.8%) were also receiving HAART at Sinikithemba, 86 (40.2%) were unaware of their status, and 23 (10.7%) had tested HIV negative. Ten children were in institutional care (orphanage), no primary caregiver identified.</p></caption><graphic xlink:href="1471-2431-7-13-1"/></fig><fig position="float" id="F2"><label>Figure 2</label><caption><p><bold>CD4% and Viral Loads changes of the Sinikithemba paediatric cohort in response to HAART</bold>: A. Median increase in CD4% from baseline. The vertical bars in subfigure A indicate IQR. B. Percentage of cohort achieving undetectable viral loads. The vertical bars in subfigure B indicate 95% CI.</p></caption><graphic xlink:href="1471-2431-7-13-2"/></fig><fig position="float" id="F3"><label>Figure 3</label><caption><p>Kaplan-Meier mortality survival curve of the cohort.</p></caption><graphic xlink:href="1471-2431-7-13-3"/></fig><table-wrap position="float" id="T1"><label>Table 1</label><caption><p>Baseline characteristics of the Sinikithemba paediatric cohort</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="left"><bold>Demography</bold></td><td align="left"><bold>[n (%)]</bold></td></tr></thead><tbody><tr><td align="left"><bold>Children</bold></td><td align="left">151</td></tr><tr><td align="left"><bold>Female</bold></td><td align="left">77 (51.0%)</td></tr><tr><td align="left"><bold>Age</bold></td><td></td></tr><tr><td align="left">&#x02003;&#x0003c; 3 years</td><td align="left">39 (25.8%)</td></tr><tr><td align="left">&#x0