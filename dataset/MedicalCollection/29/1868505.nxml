" colspan="1">&#x02002;MK534</td><td align="left" rowspan="1" colspan="1">ADA600 <italic>ompR</italic>::Tn5, insertion after codon 47 of 239, P1 donor MK4E44</td><td align="left" rowspan="1" colspan="1">This work</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02002;MK535</td><td align="left" rowspan="1" colspan="1">ADA600 <italic>ompR</italic>::Tn5, insertion after codon 96 of 239, P1 donor MK10F34</td><td align="left" rowspan="1" colspan="1">This work</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02002;MK557</td><td align="left" rowspan="1" colspan="1">ADA600 <italic>degS</italic>::Tn5, P1 donor MK6D31</td><td align="left" rowspan="1" colspan="1">This work</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02002;MK559</td><td align="left" rowspan="1" colspan="1">ADA600 <italic>degS</italic>::Tn5, P1 donor MK6D31, wild-type &#x003c3;<sup>E</sup> activity</td><td align="left" rowspan="1" colspan="1">This work</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02002;MK600</td><td align="left" rowspan="1" colspan="1">ADA600 <italic>ponB</italic>::Tn5, insertion after codon 363 of 844, P1 donor MK7E17</td><td align="left" rowspan="1" colspan="1">This work</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02002;MK601</td><td align="left" rowspan="1" colspan="1">ADA600 <italic>tatC</italic>::Tn5, insertion after codon 76 of 258, P1 donor MK7C1</td><td align="left" rowspan="1" colspan="1">This work</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02002;MK602</td><td align="left" rowspan="1" colspan="1">ADA600 <italic>lysS</italic>::Tn5, insertion after codon 432 of 505, P1 donor MK6F18</td><td align="left" rowspan="1" colspan="1">This work</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02002;MK603</td><td align="left" rowspan="1" colspan="1">ADA600 <italic>degP</italic>::Tn5, insertion after codon 54 of 474, P1 donor MK7A41</td><td align="left" rowspan="1" colspan="1">This work</td></tr><tr><td align="left" rowspan=