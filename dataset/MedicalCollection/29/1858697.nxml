</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Drin</surname><given-names>G</given-names></name><name><surname>Temsamani</surname><given-names>J</given-names></name></person-group><article-title>Translocation of protegrin I through phospholipid membranes: role of peptide folding</article-title><source>Biochim Biophys Acta</source><year>2002</year><volume>1559</volume><fpage>160</fpage><lpage>170</lpage><pub-id pub-id-type="pmid">11853682</pub-id><pub-id pub-id-type="doi">10.1016/S0005-2736(01)00447-3</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Panchal</surname><given-names>RG</given-names></name><name><surname>Smart</surname><given-names>ML</given-names></name><name><surname>Bowser</surname><given-names>DN</given-names></name><name><surname>Williams</surname><given-names>DA</given-names></name><name><surname>Petrou</surname><given-names>S</given-names></name></person-group><article-title>Pore-forming proteins and their application in biotechnology</article-title><source>Curr Pharm Biotechnol</source><year>2002</year><volume>3</volume><fpage>99</fpage><lpage>115</lpage><pub-id pub-id-type="pmid">12022262</pub-id><pub-id pub-id-type="doi">10.2174/1389201023378418</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sokolov</surname><given-names>Y</given-names></name><name><surname>Mirzabekov</surname><given-names>T</given-names></name><name><surname>Martin</surname><given-names>DW</given-names></name><name><surname>Lehrer</surname><given-names>RI</given-names></name><name><surname>Kagan</surname><given-names>BL</given-names></name></person-group><article-title>Membrane channel formation by antimicrobial protegrins</article-title><source>Biochim Biophys Acta</source><year>1999</year><volume>1420</volume><fpage>23</fpage><lpage>29</l