r</article-title><source>Clin Cancer Res</source><year>2003</year><volume>9</volume><fpage>4423</fpage><lpage>4234</lpage><pub-id pub-id-type="pmid">14555515</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dehn</surname><given-names>H</given-names></name><name><surname>Hogdall</surname><given-names>EV</given-names></name><name><surname>Johansen</surname><given-names>JS</given-names></name><name><surname>Jorgensen</surname><given-names>M</given-names></name><name><surname>Price</surname><given-names>PA</given-names></name><name><surname>Engelholm</surname><given-names>SA</given-names></name><name><surname>Hogdall</surname><given-names>CK</given-names></name></person-group><article-title>Plasma YKL-40, as a prognostic tumor marker in recurrent ovarian cancer</article-title><source>Acta Obstet Gynecol Scand</source><year>2003</year><volume>82</volume><fpage>287</fpage><lpage>293</lpage><pub-id pub-id-type="pmid">12694127</pub-id><pub-id pub-id-type="doi">10.1034/j.1600-0412.2003.00010.x</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dupont</surname><given-names>J</given-names></name><name><surname>Tanwar</surname><given-names>MK</given-names></name><name><surname>Thaler</surname><given-names>HT</given-names></name><name><surname>Fleisher</surname><given-names>M</given-names></name><name><surname>Kauff</surname><given-names>N</given-names></name><name><surname>Hensley</surname><given-names>ML</given-names></name><name><surname>Sabbatini</surname><given-names>P</given-names></name><name><surname>Anderson</surname><given-names>S</given-names></name><name><surname>Aghajanian</surname><given-names>C</given-names></name><name><surname>Holland</surname><given-names>EC</given-names></name><name><surname>Spriggs</surname><given-names>DR</given-names></name></person-group><article-title>Early detection and prognosis of