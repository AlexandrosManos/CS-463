e>290</lpage><pub-id pub-id-type="doi">10.1348/135532500168047</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Callahan</surname><given-names>L</given-names></name></person-group><article-title>Correctional officer attitudes toward inmates with mental disorders</article-title><source>International Journal of Forensic Mental Health</source><year>2004</year><volume>3</volume><fpage>37</fpage><lpage>54</lpage></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carr-Walker</surname><given-names>P</given-names></name><name><surname>Bowers</surname><given-names>L</given-names></name><name><surname>Callaghan</surname><given-names>P</given-names></name><name><surname>Nijman</surname><given-names>H</given-names></name><name><surname>Paton</surname><given-names>J</given-names></name></person-group><article-title>Attitudes towards personality disorders: comparisons between prison officers and psychiatric nurses</article-title><source>Legal and Criminological Psychology</source><year>2004</year><volume>9</volume><fpage>265</fpage><lpage>277</lpage><pub-id pub-id-type="doi">10.1348/1355325041719347</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ajzen</surname><given-names>I</given-names></name></person-group><article-title>Nature and operation of attitudes</article-title><source>Annual Review of Psychology</source><year>2001</year><volume>52</volume><fpage>27</fpage><lpage>58</lpage><pub-id pub-id-type="pmid">11148298</pub-id><pub-id pub-id-type="doi">10.1146/annurev.psych.52.1.27</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wood</surname><given-names>W</given-names></name></person-group><article-title>Attitude change: persuation and social influence</article-title><so