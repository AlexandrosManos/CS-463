ion: An audit in the former Northern Region</article-title><source>Br J Gen Pract</source><year>1997</year><volume>47</volume><fpage>297</fpage><lpage>300</lpage><pub-id pub-id-type="pmid">9219406</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dighe</surname><given-names>AM</given-names></name><name><surname>Grace</surname><given-names>JF</given-names></name></person-group><article-title>General practice management of childhood urinary tract infection</article-title><source>J R Coll Physicians London</source><year>1984</year><volume>34</volume><fpage>324</fpage><lpage>327</lpage></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Paulus</surname><given-names>DL</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Robinson JP, Shaver PR and Wrightsman LS</surname></name></person-group><article-title>Measurement and control of response bias</article-title><source>Measures of personality and social psychological attitudes</source><year>1991</year><publisher-name>San Diego (CA), Academic Press</publisher-name><fpage>17</fpage><lpage>59</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Esbj&#x000f6;rner</surname><given-names>E</given-names></name><name><surname>Berg</surname><given-names>U</given-names></name><name><surname>Hansson</surname><given-names>S</given-names></name></person-group><article-title>Epidemiology of chronic renal failure in children: A report from Sweden 1986-1994</article-title><source>Pediatr Nephrol</source><year>1997</year><volume>11</volume><fpage>438</fpage><lpage>442</lpage><pub-id pub-id-type="pmid">9260241</pub-id><pub-id pub-id-type="doi">10.1007/s004670050312</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grol</surname><given-names>R</given-names></name></person-group><article-title>Beliefs and evidence in changing clinical practice</article-title><source>Brit Med J</source><year>1997</year><volume>315</volume><fpage>418</fpage><lpage>421</lpage><pub-id pub-id-type="pmid">9277610</pub-id></citation></ref></ref-list></back></article>