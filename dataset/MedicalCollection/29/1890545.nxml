age>1054</lpage><pub-id pub-id-type="pmid">11044002</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lyons</surname><given-names>MS</given-names></name><name><surname>Lindsell</surname><given-names>CJ</given-names></name><name><surname>Trott</surname><given-names>AT</given-names></name></person-group><article-title>Emergency department pelvic examination and Pap testing: addressing patient misperceptions</article-title><source>Acad Emerg Med</source><year>2004</year><volume>11</volume><fpage>405</fpage><lpage>408</lpage><pub-id pub-id-type="pmid">15064218</pub-id><pub-id pub-id-type="doi">10.1197/j.aem.2003.10.031</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Idestrom</surname><given-names>M</given-names></name><name><surname>Milsom</surname><given-names>I</given-names></name><name><surname>Andersson-Ellstrom</surname><given-names>A</given-names></name></person-group><article-title>Knowledge and attitudes about the Pap-smear screening program: a population-based study of women aged 20-59 years</article-title><source>Acta Obstet Gynecol Scand</source><year>2002</year><volume>81</volume><fpage>962</fpage><lpage>967</lpage><pub-id pub-id-type="pmid">12366488</pub-id><pub-id pub-id-type="doi">10.1034/j.1600-0412.2002.811011.x</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leslie</surname><given-names>NS</given-names></name><name><surname>Deiriggi</surname><given-names>P</given-names></name><name><surname>Gross</surname><given-names>S</given-names></name><name><surname>DuRant</surname><given-names>E</given-names></name><name><surname>Smith</surname><given-names>C</given-names></name><name><surname>Veshnesky</surname><given-names>JG</given-names></name></person-group><article-title>Knowledge, attitudes, and practices surrounding brea