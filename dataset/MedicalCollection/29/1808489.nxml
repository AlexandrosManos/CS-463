in gene expression</article-title><source>Proc Natl Acad Sci U S A</source><volume>99</volume><fpage>12795</fpage><lpage>12800</lpage><pub-id pub-id-type="pmid">12237400</pub-id></citation></ref><ref id="pcbi-0030024-b078"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blake</surname><given-names>WJ</given-names></name><name><surname>Kaern</surname><given-names>M</given-names></name><name><surname>Cantor</surname><given-names>CR</given-names></name><name><surname>Collins</surname><given-names>JJ</given-names></name></person-group><year>2003</year><article-title>Noise in eukaryotic gene expression</article-title><source>Nature</source><volume>422</volume><fpage>633</fpage><lpage>637</lpage><pub-id pub-id-type="pmid">12687005</pub-id></citation></ref><ref id="pcbi-0030024-b079"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Paulsson</surname><given-names>J</given-names></name></person-group><year>2004</year><article-title>Summing up the noise in gene networks</article-title><source>Nature</source><volume>427</volume><fpage>415</fpage><lpage>418</lpage><pub-id pub-id-type="pmid">14749823</pub-id></citation></ref><ref id="pcbi-0030024-b080"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Raser</surname><given-names>JM</given-names></name><name><surname>O'Shea</surname><given-names>EK</given-names></name></person-group><year>2004</year><article-title>Control of stochasticity in eukaryotic gene expression</article-title><source>Science</source><volume>304</volume><fpage>1811</fpage><lpage>1814</lpage><pub-id pub-id-type="pmid">15166317</pub-id></citation></ref><ref id="pcbi-0030024-b081"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Becskei</surname><given-names>A</given-names></name><name><surname>Kaufmann</surname><given-names>BB</given-names></name><name><surname>van Oudenaarden</surname><given-names