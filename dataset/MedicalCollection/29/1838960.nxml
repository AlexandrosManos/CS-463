ation publication-type="journal"><person-group person-group-type="author"><name><surname>Lynch</surname><given-names>G</given-names></name></person-group><article-title>Memory and the brain: unexpected chemistries and a new pharmacology</article-title><source><italic>Neurobiology of Learning and Memory</italic></source><year>1998</year><volume>70</volume><issue>1-2</issue><fpage>82</fpage><lpage>100</lpage><pub-id pub-id-type="pmid">9753589</pub-id></element-citation></ref><ref id="B21"><label>21</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nakagami</surname><given-names>Y</given-names></name><name><surname>Abe</surname><given-names>K</given-names></name><name><surname>Nishiyama</surname><given-names>N</given-names></name><name><surname>Matsuki</surname><given-names>N</given-names></name></person-group><article-title>Laminin degradation by plasmin regulates long-term potentiation</article-title><source><italic>The Journal of Neuroscience</italic></source><year>2000</year><volume>20</volume><issue>5</issue><fpage>2003</fpage><lpage>2010</lpage><pub-id pub-id-type="pmid">10684901</pub-id></element-citation></ref><ref id="B22"><label>22</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Pinkstaff</surname><given-names>JK</given-names></name><name><surname>Detterich</surname><given-names>J</given-names></name><name><surname>Lynch</surname><given-names>G</given-names></name><name><surname>Gall</surname><given-names>C</given-names></name></person-group><article-title>Integrin subunit gene expression is regionally differentiated in adult brain</article-title><source><italic>The Journal of Neuroscience</italic></source><year>1999</year><volume>19</volume><issue>5</issue><fpage>1541</fpage><lpage>1556</lpage><pub-id pub-id-type="pmid">10024342</pub-id></element-citation></ref><ref id="B23"><label>23</label><element-citation publication-type="journal"><perso