ge><pub-id pub-id-type="pmid">16264936</pub-id><pub-id pub-id-type="doi">10.1038/ncponc0139</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Krasin</surname><given-names>MJ</given-names></name><name><surname>Crawford</surname><given-names>BT</given-names></name><name><surname>Zhu</surname><given-names>Y</given-names></name><name><surname>Evans</surname><given-names>ES</given-names></name><name><surname>Sontag</surname><given-names>MR</given-names></name><name><surname>Kun</surname><given-names>LE</given-names></name><name><surname>Merchant</surname><given-names>TE</given-names></name></person-group><article-title>Intensity-modulated radiation therapy for children with intraocular retinoblastoma: potential sparing of the bony orbit</article-title><source>Clin Oncol</source><year>2004</year><volume>16</volume><fpage>215</fpage><lpage>222</lpage><pub-id pub-id-type="doi">10.1016/j.clon.2003.11.008</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kuppersmith</surname><given-names>RB</given-names></name><name><surname>Teh</surname><given-names>BS</given-names></name><name><surname>Donovan</surname><given-names>DT</given-names></name><name><surname>Mai</surname><given-names>WY</given-names></name><name><surname>Chiu</surname><given-names>JK</given-names></name><name><surname>Woo</surname><given-names>SY</given-names></name><name><surname>Butler</surname><given-names>EB</given-names></name></person-group><article-title>The use of intensity modulated radiotherapy for the treatment of extensive and recurrent juvenile angiofibroma</article-title><source>Int J Pediatr Otorhinolaryngol</source><year>2000</year><volume>52</volume><fpage>261</fpage><lpage>268</lpage><pub-id pub-id-type="pmid">10841956</pub-id><pub-id pub-id-type="doi">10.1016/S0165-5876(00)00297-4</pub-id></citation></ref><ref id="B15"><citation citation-t