al"><person-group person-group-type="author"><name><surname>Astone</surname><given-names>J</given-names></name><name><surname>Strauss</surname><given-names>SM</given-names></name><name><surname>Vassilev</surname><given-names>ZP</given-names></name><name><surname>Des Jarlais</surname><given-names>DC</given-names></name></person-group><article-title>Provision of hepatitis C education in a nationwide sample of drug treatment programs</article-title><source>J Drug Educ</source><year>2003</year><volume>33</volume><fpage>107</fpage><lpage>117</lpage><pub-id pub-id-type="pmid">12773028</pub-id><pub-id pub-id-type="doi">10.2190/YEGL-GX4W-HGRA-EDC7</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Strauss</surname><given-names>SM</given-names></name><name><surname>Astone-Twerell</surname><given-names>JM</given-names></name><name><surname>Munoz-Plaza</surname><given-names>C</given-names></name><name><surname>Des Jarlais</surname><given-names>DC</given-names></name><name><surname>Gwadz</surname><given-names>M</given-names></name><name><surname>Hagan</surname><given-names>H</given-names></name><name><surname>Osborne</surname><given-names>A</given-names></name><name><surname>Rosenblum</surname><given-names>A</given-names></name></person-group><article-title>Hepatitis C knowledge among staff in U.S. drug treatment programs</article-title><source>J Drug Educ</source><year>2006</year><volume>36</volume><fpage>141</fpage><lpage>168</lpage><pub-id pub-id-type="pmid">17153514</pub-id><pub-id pub-id-type="doi">10.2190/3EMQ-N350-W4XN-WT1X</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pearlman</surname><given-names>BL</given-names></name></person-group><article-title>Hepatitis C treatment update</article-title><source>Am J Med</source><year>2004</year><volume>117</volume><fpage>344</fpage><lpage>352</lpage><pub-id pub-id-type="p