d="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kudirka</surname><given-names>DT</given-names></name><name><surname>Schaeffer</surname><given-names>GW</given-names></name><name><surname>Beanzinger</surname><given-names>PS</given-names></name></person-group><article-title>Stability of ploidy in meristems of plants regenerated from anther calli of wheat <italic>(Triticum aestivum L. em. Thell.)</italic></article-title><source>Genome</source><year>1989</year><volume>32</volume><fpage>1068</fpage><lpage>1073</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Devaux</surname><given-names>P</given-names></name><name><surname>Kilian</surname><given-names>A</given-names></name><name><surname>Kleinhofs</surname><given-names>A</given-names></name></person-group><article-title>Anther culture and <italic>Hordeum bulbosum</italic>-derived barley doubled haploids: mutations and methylation</article-title><source>Mol Gen Genet</source><year>1993</year><volume>241</volume><fpage>674</fpage><lpage>679</lpage><pub-id pub-id-type="pmid">7903412</pub-id><pub-id pub-id-type="doi">10.1007/BF00279910</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guzy-Wr&#x000f3;blewska</surname><given-names>J</given-names></name><name><surname>Szarejko</surname><given-names>I</given-names></name></person-group><article-title>Molecular and agronomic evaluation of wheat double haploid lines obtained through maize pollination and anther methods</article-title><source>Plant Breeding</source><year>2003</year><volume>122</volume><fpage>305</fpage><lpage>313</lpage><pub-id pub-id-type="doi">10.1046/j.1439-0523.2003.00858.x</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vuylsteke</surname><given-names>M</given-names></name><na