e><pub-id pub-id-type="pmid">12390539</pub-id><pub-id pub-id-type="doi">10.1034/j.1600-0684.2002.02003.x</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fujimoto</surname><given-names>A</given-names></name><name><surname>Mitalipov</surname><given-names>SM</given-names></name><name><surname>Clepper</surname><given-names>LL</given-names></name><name><surname>Wolf</surname><given-names>DP</given-names></name></person-group><article-title>Development of a monkey model for the study of primate genomic imprinting</article-title><source>Mol Hum Reprod</source><year>2005</year><volume>11</volume><fpage>413</fpage><lpage>422</lpage><pub-id pub-id-type="pmid">15908455</pub-id><pub-id pub-id-type="doi">10.1093/molehr/gah180</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Spindel</surname><given-names>ER</given-names></name><name><surname>Pauley</surname><given-names>MA</given-names></name><name><surname>Jia</surname><given-names>Y</given-names></name><name><surname>Gravett</surname><given-names>C</given-names></name><name><surname>Thompson</surname><given-names>SL</given-names></name><name><surname>Boyle</surname><given-names>NF</given-names></name><name><surname>Ojeda</surname><given-names>SR</given-names></name><name><surname>Norgren</surname><given-names>RB</given-names><suffix>Jr.</suffix></name></person-group><article-title>Leveraging human genomic information to identify nonhuman primate sequences for expression array development</article-title><source>BMC Genomics</source><year>2005</year><volume>6</volume><fpage>160</fpage><pub-id pub-id-type="pmid">16288651</pub-id><pub-id pub-id-type="doi">10.1186/1471-2164-6-160</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Norgren</surname><given-names>RB</given-names></name></person-group><