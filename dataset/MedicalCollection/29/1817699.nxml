<italic>n</italic> = 622)</td><td align="center" rowspan="1" colspan="1">0.38 &#x000b1; 0.13</td><td align="center" rowspan="1" colspan="1">0.23</td><td align="center" rowspan="1" colspan="1">0.34</td><td align="center" rowspan="1" colspan="1">0.88</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Infants unexposed in proximity model (<italic>n</italic> = 347)</td><td align="center" rowspan="1" colspan="1">0.32 &#x000b1; 0.06</td><td align="center" rowspan="1" colspan="1">0.23</td><td align="center" rowspan="1" colspan="1">0.30</td><td align="center" rowspan="1" colspan="1">0.68</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Infants exposed to stop/go traffic in proximity model (<italic>n</italic> = 99)</td><td align="center" rowspan="1" colspan="1">0.42 &#x000b1; 0.14</td><td align="center" rowspan="1" colspan="1">0.25</td><td align="center" rowspan="1" colspan="1">0.37</td><td align="center" rowspan="1" colspan="1">0.83</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Infants exposed to moving traffic in proximity model (<italic>n</italic> = 176)</td><td align="center" rowspan="1" colspan="1">0.49 &#x000b1; 0.14</td><td align="center" rowspan="1" colspan="1">0.29</td><td align="center" rowspan="1" colspan="1">0.44</td><td align="center" rowspan="1" colspan="1">0.88</td></tr></tbody></table></table-wrap><table-wrap id="t4-ehp0115-000278" position="float"><label>Table 4</label><caption><p>AORs<xref ref-type="table-fn" rid="tfn6-ehp0115-000278">a</xref> (95% CIs) for ECAT exposure levels and wheezing without a cold.</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1">Exposure to ECAT (&#x003bc;g/m<sup>3</sup>)</th><th align="center" rowspan="1" colspan="1">AOR (95% CI)</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">0.2</td><td align="center" rowspan="1" colspan="1">1.00 (reference)</td></tr><tr><td align="left" rowspan="1" colspan="1">0.3</td><td align="