><name><surname>Metselaar</surname><given-names>JM</given-names></name><name><surname>Wauben</surname><given-names>MH</given-names></name><name><surname>Wagenaar-Hilbers</surname><given-names>JP</given-names></name><name><surname>Boerman</surname><given-names>OC</given-names></name><name><surname>Storm</surname><given-names>G</given-names></name></person-group><article-title>Complete remission of experimental arthritis by joint targeting of glucocorticoids with long-circulating liposomes</article-title><source>Arthritis Rheum</source><year>2003</year><volume>48</volume><fpage>2059</fpage><lpage>2066</lpage><pub-id pub-id-type="pmid">12847701</pub-id><pub-id pub-id-type="doi">10.1002/art.11140</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fiehn</surname><given-names>C</given-names></name><name><surname>Muller-Ladner</surname><given-names>U</given-names></name><name><surname>Gay</surname><given-names>S</given-names></name><name><surname>Krienke</surname><given-names>S</given-names></name><name><surname>Freudenberg-Konrad</surname><given-names>S</given-names></name><name><surname>Funk</surname><given-names>J</given-names></name><name><surname>Ho</surname><given-names>AD</given-names></name><name><surname>Sinn</surname><given-names>H</given-names></name><name><surname>Wunder</surname><given-names>A</given-names></name></person-group><article-title>Albumin-coupled methotrexate (MTX-HSA) is a new anti-arthritic drug which acts synergistically to MTX</article-title><source>Rheumatology (Oxford)</source><year>2004</year><volume>43</volume><fpage>1097</fpage><lpage>1105</lpage><pub-id pub-id-type="pmid">15199219</pub-id><pub-id pub-id-type="doi">10.1093/rheumatology/keh254</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Timofeevski</surname><given-names>SL</given-names></name><name><surname>Panarin</surname><given