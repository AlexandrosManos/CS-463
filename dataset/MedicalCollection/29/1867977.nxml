ear>2003</year><article-title>Adverse pregnancy outcomes around incinerators and crematoriums in Cumbria, north west England, 1956&#x02013;93</article-title><source>J Epidemiol Community Health</source><volume>57</volume><fpage>456</fpage><lpage>461</lpage><pub-id pub-id-type="pmid">12775795</pub-id></element-citation></ref><ref id="b20-ehp0115-000776"><element-citation publication-type="journal"><person-group><name><surname>Elliott</surname><given-names>P</given-names></name><name><surname>Briggs</surname><given-names>D</given-names></name><name><surname>Morris</surname><given-names>S</given-names></name><name><surname>de Hoogh</surname><given-names>C</given-names></name><name><surname>Hurt</surname><given-names>C</given-names></name><name><surname>Jensen</surname><given-names>TK</given-names></name><etal/></person-group><year>2001</year><article-title>Risk of adverse birth outcomes in populations living near landfill sites</article-title><source>BMJ</source><volume>323</volume><fpage>363</fpage><lpage>368</lpage><pub-id pub-id-type="pmid">11509424</pub-id></element-citation></ref><ref id="b21-ehp0115-000776"><element-citation publication-type="journal"><person-group><name><surname>Fell</surname><given-names>DB</given-names></name><name><surname>Dodds</surname><given-names>L</given-names></name><name><surname>King</surname><given-names>WD</given-names></name></person-group><year>2004</year><article-title>Residential mobility during pregnancy</article-title><source>Paediatr Perinat Epidemiol</source><volume>18</volume><fpage>408</fpage><lpage>414</lpage><pub-id pub-id-type="pmid">15535816</pub-id></element-citation></ref><ref id="b22-ehp0115-000776"><element-citation publication-type="journal"><person-group><name><surname>Fielder</surname><given-names>HM</given-names></name><name><surname>Poon-King</surname><given-names>CM</given-names></name><name><surname>Palmer</surname><given-names>SR</given-names></name><name><surname>Moss</surname><given-names>N</given-names><