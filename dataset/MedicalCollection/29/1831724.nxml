erson-group><name><surname>Mabeya</surname><given-names>HM</given-names></name></person-group><year>2004</year><article-title>Characteristics of women admitted with obstetric fistula in the rural hospitals in West Pokot, Kenya</article-title><comment>Post Graduate Training Course in Reproductive Health 2004, Moi Referral and Teaching Hospital, Eldoret, Kenya. Available: <ext-link ext-link-type="uri" xlink:href="http://www.gfmer.ch/Medical_education_En/PGC_RH_2004/Obstetric_fistula_Kenya.htm">http://www.gfmer.ch/Medical_education_En/PGC_RH_2004/Obstetric_fistula_Kenya.htm</ext-link>. Accessed 21 February 2007</comment></citation></ref><ref id="pmed-0040071-b012"><citation citation-type="journal"><person-group><name><surname>Fenton</surname><given-names>PM</given-names></name><name><surname>Whitty</surname><given-names>JM</given-names></name><name><surname>Reynolds</surname><given-names>F</given-names></name></person-group><year>2003</year><article-title>Caesarean section in Malawi: Prospective study of early maternal and perinatal mortality</article-title><source>BMJ</source><volume>327</volume><fpage>587</fpage><lpage>591</lpage><pub-id pub-id-type="pmid">12969922</pub-id></citation></ref><ref id="pmed-0040071-b013"><citation citation-type="book"><person-group person-group-type="editor"><name><surname>Johanson</surname><given-names>R</given-names></name><name><surname>Cox</surname><given-names>C</given-names></name><name><surname>Grady</surname><given-names>K</given-names></name><name><surname>Howell</surname><given-names>C</given-names></name></person-group><comment>editors</comment><year>2003</year><source>Managing obstetric emergencies and trauma. The MOET course manual</source><publisher-loc>London</publisher-loc><publisher-name>RCOG Press</publisher-name></citation></ref><ref id="pmed-0040071-b014"><citation citation-type="journal"><person-group><name><surname>Verkuyl</surname><given-names>DAA</given-names></name></person-group><year>2002</year><article-title>Sterilisation during unplanned caesarean sections for women likely to have a completed family&#x02014;Should they be offered? Experience in a country with limited health resources</article-title><source>BJOG</source><volume>109</volume><fpage>900</fpage><lpage>904</lpage><comment>Available: <ext-link ext-link-type="uri" xlink:href="http://www.blackwell-synergy.com/links/doi/10.1111/j.1471-0528.2002.99427.x/abs/">http://www.blackwell-synergy.com/links/doi/10.1111/j.1471-0528.2002.99427.x/abs/</ext-link>. Accessed 21 February 2007</comment><pub-id pub-id-type="pmid">12197369</pub-id></citation></ref><ref id="pmed-0040071-b015"><citation citation-type="book"><person-group person-group-type="editor"><name><surname>King</surname><given-names>M</given-names></name><name><surname>Mola</surname><given-names>G</given-names></name></person-group><comment>editors</comment><year>2006</year><article-title>Chapter 24.7: Symphysiotomy</article-title><source>Safe motherhood in developing countries</source><publisher-loc>London</publisher-loc><publisher-name>Marie Stopes International</publisher-name><comment>ISBN 0-9544212-2-1. Available: <ext-link ext-link-type="uri" xlink:href="http://www.mariestopes.org.uk">http://www.mariestopes.org.uk</ext-link>. Accessed 7 March 2007</comment></citation></ref><ref id="pmed-0040071-b016"><citation citation-type="journal"><person-group><name><surname>Guise</surname><given-names>JM</given-names></name><name><surname>McDonagh</surname><given-names>MS</given-names></name><name><surname>Osterweil</surname><given-names>P</given-names></name><name><surname>Nygren</surname><given-names>P</given-names></name><name><surname>Chan</surname><given-names>BKS</given-names></name><etal/></person-group><year>2004</year><article-title>Systematic review of the incidence and consequences of uterine rupture in women with previous caesarean section</article-title><source>BMJ</source><volume>329</volume><fpage>19</fpage><lpage>25</lpage><pub-id pub-id-type="pmid">15231616</pub-id></citation></ref><ref id="pmed-0040071-b017"><citation citation-type="book"><person-group><name><surname>Spaans</surname><given-names>WA</given-names></name></person-group><year>2004</year><article-title>Vaginal birth after caesarean section</article-title><comment>PhD Thesis</comment><publisher-name>University of Amsterdam</publisher-name><comment>ISBN 9064643482</comment></citation></ref><ref id="pmed-0040071-b018"><citation citation-type="journal"><person-group><name><surname>Silver</surname><given-names>RM</given-names></name><name><surname>Landon</surname><given-names>MB</given-names></name><name><surname>Rouse</surname><given-names>DJ</given-names></name><name><surname>Leveno</surname><given-names>KJ</given-names></name><name><surname>Ohel</surname><given-names>G</given-names></name><etal/></person-group><year>2006</year><article-title>Maternal morbidity associated with multiple repeat cesarean deliveries</article-title><source>Obst Gyn</source><volume>107</volume><fpage>1226</fpage><lpage>1232</lpage></citation></ref></ref-list><fn-group><fn id="n3" fn-type="current-aff"><p>Douwe Arie Anne Verkuyl is in the Department of Obstetrics and Gynecology, Bethesda Hospital, Hoogeveen, The Netherlands. E-mail: <email>verkuyl&#x00040;freeler.nl</email></p></fn><fn id="n1" fn-type="financial-disclosure"><p><bold>Funding:</bold> The author received no specific funding for this article.</p></fn><fn id="n2" fn-type="conflict"><p><bold>Competing Interests:</bold> The author has declared that no competing interests exist.</p></fn></fn-group></back></article>