 id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sakurai</surname><given-names>M</given-names></name><name><surname>Miyasaka</surname><given-names>Y</given-names></name></person-group><article-title>Neural Fibrosis and the Effect of Neurolysis</article-title><source>J Bone Joint Surg Br</source><year>1986</year><volume>68</volume><fpage>483</fpage><lpage>488</lpage><pub-id pub-id-type="pmid">3015976</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Choi</surname><given-names>SJ</given-names></name><name><surname>Ahn</surname><given-names>DS</given-names></name></person-group><article-title>Correlation of clinical history and electrodiagnostic abnormalities with outcome after surgery for carpal tunnel syndrome</article-title><source>Plast Reconstr Surg</source><year>1998</year><volume>102</volume><fpage>2374</fpage><lpage>2380</lpage><pub-id pub-id-type="pmid">9858172</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Friedenberg</surname><given-names>SM</given-names></name><name><surname>Zimprich</surname><given-names>T</given-names></name><name><surname>Harper</surname><given-names>CM</given-names></name></person-group><article-title>The natural history of long thoracic and spinal accessory neuropathies</article-title><source>Muscle Nerve</source><year>2002</year><volume>25</volume><fpage>535</fpage><lpage>539</lpage><pub-id pub-id-type="pmid">11932971</pub-id><pub-id pub-id-type="doi">10.1002/mus.10068</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>DH</given-names></name><name><surname>Han</surname><given-names>K</given-names></name><name><surname>Tiel</surname><given-names>RL</given-names></name><name><surname>Murovic</surname><given-names>JA</given-name