mes></name><name><surname>Solovei</surname><given-names>I</given-names></name><name><surname>Cremer</surname><given-names>C</given-names></name><name><surname>Cremer</surname><given-names>T</given-names></name></person-group><article-title>Evolutionary conservation of chromosome territory arrangements in cell nuclei from higher primates</article-title><source>Proc Natl Acad Sci U S A</source><year>2002</year><volume>99</volume><fpage>4424</fpage><lpage>4429</lpage><pub-id pub-id-type="pmid">11930003</pub-id><pub-id pub-id-type="doi">10.1073/pnas.072618599</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldman</surname><given-names>RD</given-names></name><name><surname>Gruenbaum</surname><given-names>Y</given-names></name><name><surname>Moir</surname><given-names>RD</given-names></name><name><surname>Shumaker</surname><given-names>DK</given-names></name><name><surname>Spann</surname><given-names>TP</given-names></name></person-group><article-title>Nuclear lamins: building blocks of nuclear architecture</article-title><source>Genes Dev</source><year>2002</year><volume>16</volume><fpage>533</fpage><lpage>547</lpage><pub-id pub-id-type="pmid">11877373</pub-id><pub-id pub-id-type="doi">10.1101/gad.960502</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thomson</surname><given-names>I</given-names></name><name><surname>Gilchrist</surname><given-names>S</given-names></name><name><surname>Bickmore</surname><given-names>WA</given-names></name><name><surname>Chubb</surname><given-names>JR</given-names></name></person-group><article-title>The radial positioning of chromatin is not inherited through mitosis but is established de novo in early G1</article-title><source>Curr Biol</source><year>2004</year><volume>14</volume><fpage>166</fpage><lpage>172</lpage><pub-id pub-id-type="pmid">14738741</pub-id><pub-id pub-id-type="doi">10.1016/j.cub.2003.12.024</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parada</surname><given-names>LA</given-names></name><name><surname>Roix</surname><given-names>JJ</given-names></name><name><surname>Misteli</surname><given-names>T</given-names></name></person-group><article-title>An uncertainty principle in chromosome positioning</article-title><source>Trends Cell Biol</source><year>2003</year><volume>13</volume><fpage>393</fpage><lpage>396</lpage><pub-id pub-id-type="pmid">12888289</pub-id><pub-id pub-id-type="doi">10.1016/S0962-8924(03)00149-1</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vazquez</surname><given-names>J</given-names></name><name><surname>Belmont</surname><given-names>AS</given-names></name><name><surname>Sedat</surname><given-names>JW</given-names></name></person-group><article-title>Multiple regimes of constrained chromosome motion are regulated in the interphase Drosophila nucleus</article-title><source>Curr Biol</source><year>2001</year><volume>11</volume><fpage>1227</fpage><lpage>1239</lpage><pub-id pub-id-type="pmid">11525737</pub-id><pub-id pub-id-type="doi">10.1016/S0960-9822(01)00390-6</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chubb</surname><given-names>JR</given-names></name><name><surname>Boyle</surname><given-names>S</given-names></name><name><surname>Perry</surname><given-names>P</given-names></name><name><surname>Bickmore</surname><given-names>WA</given-names></name></person-group><article-title>Chromatin motion is constrained by association with nuclear compartments in human cells</article-title><source>Curr Biol</source><year>2002</year><volume>12</volume><fpage>439</fpage><lpage>445</lpage><pub-id pub-id-type="pmid">11909528</pub-id><pub-id pub-id-type="doi">10.1016/S096