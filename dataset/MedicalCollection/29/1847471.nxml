n="1"><hr/></td></tr><tr><td rowspan="1" colspan="1">GABA (also see <xref ref-type="table" rid="T2">Table 2</xref>)</td><td rowspan="1" colspan="1">GABA-A <italic>&#x003b1;</italic>5 subunit KO mice</td><td align="center" rowspan="1" colspan="1">0</td><td rowspan="1" colspan="1">&#x02191; hippocampal-dependent trace conditioning, 0 delayed or contextual conditioning</td><td align="center" rowspan="1" colspan="1">[<xref ref-type="bibr" rid="B48">48</xref>]</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">GABA-A <italic>&#x003b3;</italic>2 subunit HZ mice</td><td align="center" rowspan="1" colspan="1">&#x02191;</td><td rowspan="1" colspan="1">&#x02191; cued fear conditioning, 0 spatial memory</td><td align="center" rowspan="1" colspan="1">[<xref ref-type="bibr" rid="B49">49</xref>]</td></tr><tr><td rowspan="1" colspan="1"/><td colspan="4" rowspan="1"><hr/></td></tr><tr><td rowspan="1" colspan="1">Histamine</td><td rowspan="1" colspan="1">Histamine H3 receptor KO mice</td><td align="center" rowspan="1" colspan="1">&#x02193;</td><td rowspan="1" colspan="1">0 habituation, &#x02191; spatial memory and learning, higher resistance to amnestic effects of scopolamine</td><td align="center" rowspan="1" colspan="1">[<xref ref-type="bibr" rid="B50">50</xref>, <xref ref-type="bibr" rid="B51">51</xref>]</td></tr><tr><td rowspan="1" colspan="1"/><td colspan="4" rowspan="1"><hr/></td></tr><tr><td rowspan="1" colspan="1">Glycine</td><td rowspan="1" colspan="1">Glycine transporter 1 brain-selective disruption</td><td align="center" rowspan="1" colspan="1">0</td><td rowspan="1" colspan="1">&#x02191; aversive Pavlovian conditioning</td><td align="center" rowspan="1" colspan="1">[<xref ref-type="bibr" rid="B52">52</xref>]</td></tr><tr><td rowspan="1" colspan="1"/><td colspan="4" rowspan="1"><hr/></td></tr><tr><td rowspan="3" colspan="1">Glutamate</td><td rowspan="1" colspan="1">B subunit ionotropic receptor KO mice</td><td align="center" rowspan="1" colspan="1"/><td 