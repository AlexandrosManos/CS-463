id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schultz</surname><given-names>AA</given-names></name><name><surname>Geary</surname><given-names>PA</given-names></name><name><surname>Casey</surname><given-names>FS</given-names></name><name><surname>Fournier</surname><given-names>MA</given-names></name></person-group><article-title>Joining education and service in exploring discharge needs</article-title><source>J Community Health Nurs</source><year>1997</year><volume>14</volume><fpage>141</fpage><lpage>153</lpage><pub-id pub-id-type="pmid">9282535</pub-id><pub-id pub-id-type="doi">10.1207/s15327655jchn1403_2</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simon</surname><given-names>EP</given-names></name><name><surname>Showers</surname><given-names>N</given-names></name><name><surname>Blumenfield</surname><given-names>S</given-names></name><name><surname>Holden</surname><given-names>G</given-names></name><name><surname>Wu</surname><given-names>X</given-names></name></person-group><article-title>Delivery of home care services after discharge: what really happens</article-title><source>Health Soc Work</source><year>1995</year><volume>20</volume><fpage>5</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">9154420</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Williams</surname><given-names>EI</given-names></name><name><surname>Fitton</surname><given-names>F</given-names></name></person-group><article-title>Use of nursing and social services by elderly patients discharged from hospital</article-title><source>Br J Gen Pract</source><year>1991</year><volume>41</volume><fpage>72</fpage><lpage>75</lpage><pub-id pub-id-type="pmid">2031740</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>