ype="book"><person-group person-group-type="author"><name><surname>Wehner</surname><given-names>R</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Lehrer M</surname></name></person-group><article-title>The ant's celestial compass system: Spectral and polarization channels</article-title><source>Orientation and Communication in Arthropods</source><year>1997</year><publisher-name>Basel, Birkh&#x000e4;user Verlag</publisher-name><fpage>145</fpage><lpage>185</lpage></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Labhart</surname><given-names>T</given-names></name><name><surname>Meyer</surname><given-names>EP</given-names></name></person-group><article-title>Neural mechanisms in insect navigation: polarization compass and odometer</article-title><source>Current Opinion in Neurobiology</source><year>2002</year><volume>12</volume><fpage>707</fpage><lpage>714</lpage><pub-id pub-id-type="pmid">12490263</pub-id><pub-id pub-id-type="doi">10.1016/S0959-4388(02)00384-7</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wittlinger</surname><given-names>M</given-names></name><name><surname>Wehner</surname><given-names>R</given-names></name><name><surname>Wolf</surname><given-names>H</given-names></name></person-group><article-title>The Ant Odometer: Stepping on Stilts and Stumps</article-title><source>Science</source><year>2006</year><volume>312</volume><fpage>1965</fpage><lpage>1967</lpage><pub-id pub-id-type="pmid">16809544</pub-id><pub-id pub-id-type="doi">10.1126/science.1126912</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thi&#x000e9;lin-Bescond</surname><given-names>M</given-names></name><name><surname>Beugnon</surname><given-names>G</given-names></name></person-group><article-title>Vision-independent odometry in the ant Cataglyphis cursor</article-title><source>Naturwissenschaften</source><year>2005</year><volume>92</volume><fpage>193</fpage><lpage>197</lpage><pub-id pub-id-type="pmid">15772808</pub-id><pub-id pub-id-type="doi">10.1007/s00114-005-0609-1</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ronacher</surname><given-names>B</given-names></name><name><surname>Wehner</surname><given-names>R</given-names></name></person-group><article-title>Desert ants Cataglyphis fortis use self-induced optic flow to measure distances travelled</article-title><source>Journal of Comparative Physiology A, Sensory, Neural, and Behavioral Physiology</source><year>1995</year><volume>177</volume><fpage>21</fpage><lpage>27</lpage></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ronacher</surname><given-names>B</given-names></name><name><surname>Gallizzi</surname><given-names>K</given-names></name><name><surname>Wohlgemuth</surname><given-names>S</given-names></name><name><surname>Wehner</surname><given-names>R</given-names></name></person-group><article-title>Lateral optic flow does not influence distance estimation in the desert ant Cataglyphis fortis</article-title><source>Journal of Experimental Biology</source><year>2000</year><volume>203</volume><fpage>1113</fpage><lpage>1121</lpage><pub-id pub-id-type="pmid">10708632</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sch&#x000e4;fer</surname><given-names>M</given-names></name><name><surname>Wehner</surname><given-names>R</given-names></name></person-group><article-title>Loading does not affect measurement of walking distance in desert ants Cataglyphis fortis</article-title><source>Verhandlungen der Deutschen Zoologischen Gesellschaft</source><year>1993</year><volume>86</volume><fpage>270</fpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wohlgemuth</surname><given-names>S</given-names></name><name><surname>Ronacher</surname><given-names>B</given-names></name><name><surname>Wehner</surname><given-names>R</given-names></name></person-group><article-title>Distance estimation in the third dimension in desert ants</article-title><source>Journal of Comparative Physiology A, Sensory, Neural, and Behavioral Physiology</source><year>2002</year><volume>188</volume><fpage>273</fpage><lpage>281</lpage><pub-id pub-id-type="doi">10.1007/s00359-002-0301-2</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wohlgemuth</surname><given-names>S</given-names></name><name><surname>Ronacher</surname><given-names>B</given-names></name><name><surname>Wehner</surname><given-names>R</given-names></name></person-group><article-title>Ant odometry in the third dimension</article-title><source>Nature</source><year>2001</year><volume>411</volume><fpage>795</fpage><lpage>798</lpage><pub-id pub-id-type="pmid">11459057</pub-id><pub-id pub-id-type="doi">10.1038/35081069</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grah</surname><given-names>G</given-names></name><name><surname>Wehner</surname><given-names>R</given-names></name><name><surname>Ronacher</surname><given-names>B</given-names></name></person-group><article-title>Path integration in a three-dimensional maze: ground distance estimation keeps desert ants Cataglyphis fortis on course</article-title><source>J Exp Biol</source><year>2005</year><volume>208</volume><fpage>4005</fpage><lpage>4011</lpage><pub-id pub-id-type="pmid">16244161</pub-id><pub-id pub-id-type="doi">10.1242/jeb.01873</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Knaden</surname><given-names>M</given-names></name><name><surname>Lange</surname><given-names>C</given-names></name><name><surname>Wehner</surname><given-names>R</given-names></name></person-group><article-title>The importance of procedural knowledge in desert-ant navigation</article-title><source>Current Biology</source><year>2006</year><volume>16</volume><fpage>R916</fpage><lpage>R917</lpage><pub-id pub-id-type="pmid">17084686</pub-id><pub-id pub-id-type="doi">10.1016/j.cub.2006.09.059</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Collett</surname><given-names>TS</given-names></name><name><surname>Collett</surname><given-names>M</given-names></name><name><surname>Wehner</surname><given-names>R</given-names></name></person-group><article-title>The guidance of desert ants by extended landmarks</article-title><source>Journal of Experimental Biology</source><year>2001</year><volume>204</volume><fpage>1635</fpage><lpage>1639</lpage><pub-id pub-id-type="pmid">11398752</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bisch-Knaden</surname><given-names>S</given-names></name><name><surname>Wehner</surname><given-names>R</given-names></name></person-group><article-title>Egocentric information helps desert ants to navigate around familiar obstacles</article-title><source>Journal of Experimental Biology</source><year>2001</year><volume>204</volume><fpage>4177</fpage><lpage>4184</lpage><pub-id pub-id-type="pmid">11815643</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wehner</surname><given-names>R</given-names></name><name><surname>Boyer</surname><given-names>M</given-names></name><name><surname>Loertscher</surname><given-names>F</given-names></name><name><surname>Sommer</surname><given-names>S</given-names></name><name><surna