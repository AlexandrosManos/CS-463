1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pawelec</surname><given-names>G</given-names></name><name><surname>Akbar</surname><given-names>A</given-names></name><name><surname>Caruso</surname><given-names>C</given-names></name><name><surname>Solana</surname><given-names>R</given-names></name><name><surname>Grubeck-Loebenstein</surname><given-names>B</given-names></name><etal/></person-group><year>2005</year><article-title>Human immunosenescence: is it infectious?</article-title><source>Immun Rev</source><volume>25</volume><fpage>257</fpage><lpage>268</lpage><pub-id pub-id-type="pmid">15882359</pub-id></citation></ref><ref id="pone.0000492-Marchant1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marchant</surname><given-names>A</given-names></name><name><surname>Appay</surname><given-names>V</given-names></name><name><surname>Sande</surname><given-names>M van der</given-names></name><name><surname>Dulphy</surname><given-names>N</given-names></name><name><surname>Liesnard</surname><given-names>C</given-names></name><etal/></person-group><year>2003</year><article-title>Mature CD8(&#x0002b;) T lymphocyte response to viral infection during fetal life.</article-title><source>J Clin Invest.</source><volume>111</volume><fpage>1747</fpage><lpage>1755</lpage><pub-id pub-id-type="pmid">12782677</pub-id></citation></ref><ref id="pone.0000492-Looney1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Looney</surname><given-names>RJ</given-names></name><name><surname>Falsey</surname><given-names>A</given-names></name><name><surname>Campbell</surname><given-names>D</given-names></name><name><surname>Torres</surname><given-names>A</given-names></name><name><surname>Kolassa</surname><given-names>J</given-names></name><etal/></person-group><year>1999</year><article-title>Role of cytomegalovirus in the T