/ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maeda</surname><given-names>T</given-names></name><name><surname>Ohnishi</surname><given-names>S</given-names></name></person-group><article-title>Activation of influenza virus by acidic media causes haemolysis and fusion of eythrocytes</article-title><source>FEBS Lett</source><year>1980</year><volume>122</volume><fpage>283</fpage><lpage>287</lpage><pub-id pub-id-type="pmid">7202720</pub-id><pub-id pub-id-type="doi">10.1016/0014-5793(80)80457-1</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zoueva</surname><given-names>OP</given-names></name><name><surname>Bailly</surname><given-names>JE</given-names></name><name><surname>Nicholls</surname><given-names>R</given-names></name><name><surname>Brown</surname><given-names>EG</given-names></name></person-group><article-title>Aggregation of influenza virus ribonucleocapsids at low pH</article-title><source>Virus Research</source><year>2002</year><volume>85</volume><fpage>141</fpage><lpage>149</lpage><pub-id pub-id-type="pmid">12034481</pub-id><pub-id pub-id-type="doi">10.1016/S0168-1702(02)00028-X</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Josling</surname><given-names>P</given-names></name><name><surname>Steadman</surname><given-names>S</given-names></name></person-group><article-title>Use of cellulose powder for the treatment of seasonal allergic rhinitis</article-title><source>Advances in Therapy</source><year>2003</year><volume>20</volume><fpage>213</fpage><lpage>219</lpage><pub-id pub-id-type="pmid">14669817</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Andersen</surname><given-names>I</given-names></name><name><surname>Proctor</surname><given-names>DF</given-names></name></person-group><article-title>Measurement of nasal mucociliary clearance</article-title><source>Eur J Respir Dis</source><year>1983</year><volume>64</volume><fpage>37</fpage><lpage>40</lpage></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnston</surname><given-names>SL</given-names></name></person-group><article-title>Anti-influenza therapies</article-title><source>Virus Research</source><year>2002</year><volume>82</volume><fpage>147</fpage><lpage>152</lpage><pub-id pub-id-type="pmid">11885942</pub-id><pub-id pub-id-type="doi">10.1016/S0168-1702(01)00397-5</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hayden</surname><given-names>FG</given-names></name><name><surname>Treanor</surname><given-names>JJ</given-names></name><name><surname>Betts</surname><given-names>RF</given-names></name><name><surname>Lobo</surname><given-names>M</given-names></name><name><surname>Esinhart</surname><given-names>JD</given-names></name><name><surname>Hussey</surname><given-names>EK</given-names></name></person-group><article-title>Safety and efficacy of the neuraminidase inhibitor GG167 in experimental human influenza</article-title><source>J Am Med Assoc</source><year>1996</year><volume>275</volume><fpage>295</fpage><lpage>299</lpage><pub-id pub-id-type="doi">10.1001/jama.275.4.295</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>White</surname><given-names>C</given-names></name><name><surname>Kolble</surname><given-names>R</given-names></name><name><surname>Carlson</surname><given-names>R</given-names></name><name><surname>Lipson</surname><given-names>N</given-names></name></person-group><article-title>The impact of a health campaign on hand hygiene and upper respiratory illness among college students living in residence halls</article-title><source>J Am Coll Health</source><year>2005</year><volume>53</volume><fpage>175</fpage><lpage>181</lpage><pub-id pub-id-type="pmid">15663066</pub-id><pub-id pub-id-type="doi">10.3200/JACH.53.4.175-181</pub-id></citation></ref></ref-list></back></article>