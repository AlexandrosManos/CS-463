ournal"><person-group person-group-type="author"><name><surname>Ofran</surname><given-names>Y</given-names></name><name><surname>Rost</surname><given-names>B</given-names></name></person-group><year>2003</year><article-title>Analysing six types of protein&#x02013;protein interfaces</article-title><source>J Mol Biol</source><volume>325</volume><fpage>377</fpage><lpage>387</lpage><pub-id pub-id-type="pmid">12488102</pub-id></citation></ref><ref id="pcbi-0030042-b006"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bogan</surname><given-names>AA</given-names></name><name><surname>Thorn</surname><given-names>KS</given-names></name></person-group><year>1998</year><article-title>Anatomy of hot spots in protein interfaces</article-title><source>J Mol Biol</source><volume>280</volume><fpage>1</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">9653027</pub-id></citation></ref><ref id="pcbi-0030042-b007"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chakrabarti</surname><given-names>P</given-names></name><name><surname>Janin</surname><given-names>J</given-names></name></person-group><year>2002</year><article-title>Dissecting protein&#x02013;protein recognition sites</article-title><source>Proteins</source><volume>47</volume><fpage>334</fpage><lpage>343</lpage><pub-id pub-id-type="pmid">11948787</pub-id></citation></ref><ref id="pcbi-0030042-b008"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lo Conte</surname><given-names>L</given-names></name><name><surname>Chothia</surname><given-names>C</given-names></name><name><surname>Janin</surname><given-names>J</given-names></name></person-group><year>1999</year><article-title>The atomic structure of protein&#x02013;protein recognition sites</article-title><source>J Mol Biol</source><volume>285</volume><fpage>2177</fpage><lpage>2198</lpage><pub-id pub-id-type="pmid">9925793</pub-id></citation></ref><ref id="pcbi-0030042-b009"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jones</surname><given-names>S</given-names></name><name><surname>Thornton</surname><given-names>JM</given-names></name></person-group><year>1997</year><article-title>Analysis of protein&#x02013;protein interaction sites using surface patches</article-title><source>J Mol Biol</source><volume>272</volume><fpage>121</fpage><lpage>132</lpage><pub-id pub-id-type="pmid">9299342</pub-id></citation></ref><ref id="pcbi-0030042-b010"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guharoy</surname><given-names>M</given-names></name><name><surname>Chakrabarti</surname><given-names>P</given-names></name></person-group><year>2005</year><article-title>Conservation and relative importance of residues across protein&#x02013;protein interfaces</article-title><source>Proc Natl Acad Sci U S A</source><volume>102</volume><fpage>15447</fpage><lpage>15452</lpage><pub-id pub-id-type="pmid">16221766</pub-id></citation></ref><ref id="pcbi-0030042-b011"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>DeLano</surname><given-names>WL</given-names></name></person-group><year>2002</year><article-title>Unraveling hot spots in binding interfaces: Progress and challenges</article-title><source>Curr Opin Struct Biol</source><volume>12</volume><fpage>14</fpage><lpage>20</lpage><pub-id pub-id-type="pmid">11839484</pub-id></citation></ref><ref id="pcbi-0030042-b012"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Keskin</surname><given-names>O</given-names></name><name><surname>Ma</surname><given-names>B</given-names></name><name><surname>Rogale</surname><given-names>K</given-names></name><name><surname>Gunasekaran</surname><given-names>K</given-names></name><name><surname>Nussinov</surname><given-names>R</given-names></name></person-group><year>2005</year><article-title>Protein&#x02013;protein interactions: Organization, cooperativity and mapping in a bottom-up Systems Biology approach</article-title><source>Phys Biol</source><volume>2</volume><fpage>S24</fpage><lpage>S35</lpage><pub-id pub-id-type="pmid">16204846</pub-id></citation></ref><ref id="pcbi-0030042-b013"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Res</surname><given-names>I</given-names></name><name><surname>Lichtarge</surname><given-names>O</given-names></name></person-group><year>2005</year><article-title>Character and evolution of protein&#x02013;protein interfaces</article-title><source>Phys Biol</source><volume>2</volume><fpage>S36</fpage><lpage>S43</lpage><pub-id pub-id-type="pmid">16204847</pub-id></citation></ref><ref id="pcbi-0030042-b014"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ma</surname><given-names>B</given-names></name><name><surname>Elkayam</surname><given-names>T</given-names></name><name><surname>Wolfson</surname><given-names>H</given-names></name><name><surname>Nussinov</surname><given-names>R</given-names></name></person-group><year>2003</year><article-title>Protein&#x02013;protein interactions: Structurally conserved residues distinguish between binding sites and exposed protein surfaces</article-title><source>Proc Natl Acad Sci U S A</source><volume>100</volume><fpage>5772</fpage><lpage>5777</lpage><pub-id pub-id-type="pmid">12730379</pub-id></citation></ref><ref id="pcbi-0030042-b015"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sheinerman</surname><given-names>FB</given-names></name><name><surname>Honig</surname><given-names>B</given-names></name></person-group><year>2002</year><article-title>On the role of electrostatic interactions in the design of protein&#x02013;protein interfaces</article-title><source>J Mol Biol</source><volume>318</volume><fpage>161</fpage><lpage>177</lpage><pub-id pub-id-type="pmid">12054776</pub-id></citation></ref><ref id="pcbi-0030042-b016"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kortemme</surname><given-names>T</given-names></name><name><surname>Baker</surname><given-names>D</given-names></name></person-group><year>2002</year><article-title>A simple physical model for binding energy hot spots in protein&#x02013;protein complexes</article-title><source>Proc Natl Acad Sci U S A</source><volume>99</volume><fpage>14116</fpage><lpage>14121</lpage><pub-id pub-id-type="pmid">12381794</pub-id></citation></ref><ref id="pcbi-0030042-b017"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fernandez</surname><given-names>A</given-names></name><name><surname>Scheraga</surname><given-names>HA</given-names></name></person-group><year>2003</year><article-title>Insufficiently dehydrated hydrogen bonds as determinants of protein interactions</article-title><source>Proc Natl Acad Sci U S A</source><volume>100</volume><fpage>113</fpage><lpage>118</lpage><pub-id pub-id-type="pmid">12518060</pub-id></citation></ref><ref id="pcbi-0030042-b018"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kundrotas</surname><given-names>PJ</given-names></name><name><surname>Alexov</surname><given-names>E</given-names></name></person-group><year>2006</year><article-title>Electrostatic properties of protein&#x02013;protein complexes</article-title><source>Biophys J</source><volume>91</volume><fpage>1724</fpage><lpage>1736</lpage><pub-id pub-id-type="pmid">16782791</pub-id></citation></ref><ref id="pcbi-0030042-b019"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Valdar</surname><given-names>WS</given-names></name><name><surname>Thornton</surname><given-names>JM</given-names></name></person-group><year>2001</year><article-title>Protein&#x02013;protein interfaces: Analysis of amino acid conservation in homod