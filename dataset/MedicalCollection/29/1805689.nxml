</td><td align="left" rowspan="1" colspan="1">1&#x00025;</td><td align="left" rowspan="1" colspan="1">0&#x00025;</td><td align="left" rowspan="1" colspan="1">100&#x00025;</td><td align="left" rowspan="1" colspan="1">GSK&#x0002b;BMS</td></tr><tr><td align="left" rowspan="1" colspan="1">Total</td><td align="left" rowspan="1" colspan="1">187,361</td><td align="left" rowspan="1" colspan="1">34&#x00025;</td><td align="left" rowspan="1" colspan="1">17&#x00025;</td><td align="left" rowspan="1" colspan="1">83&#x00025;</td><td align="left" rowspan="1" colspan="1">-</td></tr></tbody></table><table-wrap-foot><fn id="nt104"><p>N&#x0200a;&#x0003d;&#x0200a;501 Orders</p></fn><fn id="nt105"><label>&#x0002a;</label><p>BMS&#x0200a;&#x0003d;&#x0200a;Bristol Myers Squibb, GSK&#x0200a;&#x0003d;&#x0200a;GlaxoSmithKline, BI&#x0200a;&#x0003d;&#x0200a;Boehringer Ingelheim</p></fn></table-wrap-foot></table-wrap><table-wrap id="pone-0000278-t003" position="float"><object-id pub-id-type="doi">10.1371/journal.pone.0000278.t003</object-id><label>Table 3</label><caption><title>Sources of Generic Antiretroviral Drugs</title></caption><graphic id="pone-0000278-t003-3" xlink:href="pone.0000278.t003"/><table frame="hsides" rules="groups" alternate-form-of="pone-0000278-t003-3"><colgroup span="1"><col align="left" span="1"/><col align="center" span="1"/><col align="center" span="1"/></colgroup><thead><tr><td align="left" rowspan="1" colspan="1">Country of Manufacture</td><td align="left" rowspan="1" colspan="1">India</td><td align="left" rowspan="1" colspan="1">South Africa</td></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">Generic Volume (patient years)</td><td align="left" rowspan="1" colspan="1">288,439</td><td align="left" rowspan="1" colspan="1">51,947</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x00025; of Total Generics Volume</td><td align="left" rowspan="1" colspan="1">85&#x00025;</td><td align="left" rowspan="1" colspan="1">15&#x00025;</td></tr><tr><td align="le