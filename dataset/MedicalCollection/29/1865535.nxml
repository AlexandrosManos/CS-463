citation-type="journal"><person-group person-group-type="author"><name><surname>Golitsyn</surname><given-names>GS</given-names></name><name><surname>Yaroshevich</surname><given-names>MI</given-names></name></person-group><article-title>Specific features of the recurrence of tropical cyclones versus their energy</article-title><source>Doklady Earth Sciences</source><year>2000</year><volume>372</volume><fpage>770</fpage><lpage>772</lpage></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>J&#x000f8;rgensen</surname><given-names>SE</given-names></name><name><surname>Svirezhev</surname><given-names>YM</given-names></name></person-group><source>Towards a Thermodynamic Theory for Ecological Systems</source><year>2004</year><publisher-name>Oxford, Elsevier</publisher-name></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Alexandrov</surname><given-names>GA</given-names></name><name><surname>Oikawa</surname><given-names>T</given-names></name></person-group><article-title>Contemporary variations of terrestrial net primary production: The use of satellite data in the light of an extremal principle</article-title><source>Ecological Modelling</source><year>1997</year><volume>95</volume><fpage>113</fpage><lpage>118</lpage><pub-id pub-id-type="doi">10.1016/S0304-3800(96)00031-2</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oikawa</surname><given-names>T</given-names></name><name><surname>Saeki</surname><given-names>T</given-names></name></person-group><article-title>Light regime in relation to plant population geometry. I. A Monte Carlo simulation of light microclimates within a random distribution foliage.</article-title><source>Bot Mag Tokyo</source><year>1977</year><volume>90</volume><fpage>1</fpage><lpage>10</lpage><pub-id pub-id-type="doi">10.1007/BF02489465<