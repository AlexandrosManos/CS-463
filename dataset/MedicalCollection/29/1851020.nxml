citation citation-type="journal"><person-group person-group-type="author"><name><surname>Danson</surname><given-names>MJ</given-names></name><name><surname>Hough</surname><given-names>DW</given-names></name></person-group><article-title>Structure, function and stability of enzymes from the Archaea</article-title><source>Trends in Microbiology</source><year>1998</year><volume>6</volume><fpage>307</fpage><lpage>314</lpage><pub-id pub-id-type="pmid">9746940</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yip</surname><given-names>KSP</given-names></name><name><surname>Britton</surname><given-names>KL</given-names></name><name><surname>Stillman</surname><given-names>TJ</given-names></name><name><surname>Lebbink</surname><given-names>J</given-names></name><name><surname>de Vos</surname><given-names>WM</given-names></name><name><surname>Robb</surname><given-names>FT</given-names></name><name><surname>Vetriani</surname><given-names>C</given-names></name><name><surname>Maeder</surname><given-names>D</given-names></name><name><surname>Rice</surname><given-names>DW</given-names></name></person-group><article-title>Insights into the molecular basis of the thermal stability from the analysis of ion-pair networks in the glutamate dehydrogenase family</article-title><source>European Journal of Biochemistry</source><year>1998</year><volume>255</volume><fpage>336</fpage><lpage>346</lpage><pub-id pub-id-type="pmid">9716374</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Karshikoff</surname><given-names>A</given-names></name><name><surname>Ladenstein</surname><given-names>R</given-names></name></person-group><article-title>Ion pairs and the thermotolerance of proteins from hyperthermophiles: a "traffic rule" for hot roads</article-title><source>Trends in Biochemical Sciences</source><year>2001</year><volume>26</volume><fpage