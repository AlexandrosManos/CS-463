></name><name><surname>Fortiana</surname><given-names>J</given-names></name><name><surname>Currie</surname><given-names/></name><name><surname>R.</surname><given-names>VJ</given-names></name></person-group><article-title>Socio-economic indexes in surveys for comparisisons between countries</article-title><source>Social Indicators Research</source><year>2004</year><volume>67</volume><fpage>315</fpage><lpage>332</lpage><pub-id pub-id-type="doi">10.1023/B:SOCI.0000032341.14612.b8</pub-id></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hosmer</surname><given-names>DW</given-names></name><name><surname>Lemeshow</surname><given-names>S</given-names></name></person-group><article-title>Applied logistic regression</article-title><source>Wiley series in probability and statistics: texts and reference section</source><year>2000</year><edition>2nd</edition><publisher-name>New York , Wiley-Interscience</publisher-name><fpage>373</fpage></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Greenberger</surname><given-names>E</given-names></name><name><surname>Chen</surname><given-names>C</given-names></name><name><surname>Tally</surname><given-names>SR</given-names></name><name><surname>Qi</surname><given-names>D</given-names></name></person-group><article-title>Family, peer, and individual correlates of depressive symptomatology among U.S. and Chinese adolescents</article-title><source>J Consult Clin Psychol</source><year>2000</year><volume>68</volume><fpage>209</fpage><lpage>219</lpage><pub-id pub-id-type="pmid">10780120</pub-id><pub-id pub-id-type="doi">10.1037/0022-006X.68.2.209</pub-id></citation></ref><ref id="B20"><citation citation-type="other"><person-group person-group-type="author"><collab>Kinds counts state-level data online</collab></person-group><article-title>[www.kidscount.org]</article-title></citation></ref><ref id="B21"><cita