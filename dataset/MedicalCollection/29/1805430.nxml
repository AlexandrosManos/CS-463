<pub-id pub-id-type="doi">10.1080/01650250444000126</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>La Greca</surname><given-names>AM</given-names></name><name><surname>Harrison</surname><given-names>HM</given-names></name></person-group><article-title>Adolescent peer relations, friendships, and romantic relationships: do they predict social anxiety and depression?</article-title><source>J Clin Child Adolesc Psychol</source><year>2005</year><volume>34</volume><fpage>49</fpage><lpage>61</lpage><pub-id pub-id-type="pmid">15677280</pub-id><pub-id pub-id-type="doi">10.1207/s15374424jccp3401_5</pub-id></citation></ref></ref-list></back></article>