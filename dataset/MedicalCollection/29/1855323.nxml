tion citation-type="journal"><person-group person-group-type="author"><name><surname>Holton</surname><given-names>TA</given-names></name><name><surname>Cornish</surname><given-names>EC</given-names></name></person-group><article-title>Genetics and biochemistry of anthocyanin biosynthesis.</article-title><source>Plant Cell</source><year>1995</year><volume>7</volume><fpage>1071</fpage><lpage>1083</lpage><pub-id pub-id-type="pmid">12242398</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goto</surname><given-names>K</given-names></name><name><surname>Meyerowitz</surname><given-names>EM</given-names></name></person-group><article-title>Function and regulation of the Arabidopsis floral homeotic gene PISTILLATA</article-title><source>Genes and Development</source><year>1994</year><volume>8</volume><fpage>1548</fpage><lpage>1560</lpage><pub-id pub-id-type="pmid">7958839</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bowman</surname><given-names>JL</given-names></name><name><surname>Smyth</surname><given-names>DR</given-names></name><name><surname>Meyerowitz</surname><given-names>EM</given-names></name></person-group><article-title>Genes directing flower development in Arabidopsis.</article-title><source>The Plant Cell</source><year>1989</year><volume>1</volume><fpage>37</fpage><lpage>52</lpage><pub-id pub-id-type="pmid">2535466</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Whittall</surname><given-names>JB</given-names></name><name><surname>Voelckel</surname><given-names>C</given-names></name><name><surname>Kliebenstein</surname><given-names>DJ</given-names></name><name><surname>Hodges</surname><given-names>SA</given-names></name></person-group><article-title>Convergence, constraint and the role of gene expression during adaptive ra