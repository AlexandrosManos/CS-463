><name><surname>Hernandez</surname><given-names>C</given-names></name><name><surname>Visser</surname><given-names>PB</given-names></name><name><surname>Brown</surname><given-names>DJF</given-names></name><name><surname>Bol</surname><given-names>JF</given-names></name></person-group><article-title>Transmission of tobacco rattle virus isolate PpK20 by its nematode vector requires one of the two non-structural genes in the viral RNA 2</article-title><source>Journal of General Virology</source><year>1997</year><volume>78</volume><fpage>465</fpage><lpage>467</lpage><pub-id pub-id-type="pmid">9018070</pub-id></citation></ref><ref id="B17"><citation citation-type="other"><person-group person-group-type="author"><collab>VIDE</collab></person-group><article-title>VIDE Database</article-title><ext-link ext-link-type="uri" xlink:href="http://image.fs.uidaho.edu/vide/descr808.htm"/></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>Y</given-names></name><name><surname>Nakayama</surname><given-names>N</given-names></name><name><surname>Schiff</surname><given-names>M</given-names></name><name><surname>Litt</surname><given-names>A</given-names></name><name><surname>Irish</surname><given-names>VF</given-names></name><name><surname>Dinesh-Kumar</surname><given-names>SP</given-names></name></person-group><article-title>Virus induced gene silencing of a DEFICIENS ortholog in Nicotiana benthamiana</article-title><source>Plant Molecular Biology</source><year>2004</year><volume>54</volume><fpage>701</fpage><lpage>711</lpage><pub-id pub-id-type="pmid">15356389</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>CC</given-names></name><name><surname>Cai</surname><given-names>XZ</given-names></name><name><surname>Wang</surname><given-names>XM</given-names></name><name><surname>Zheng</surname><g