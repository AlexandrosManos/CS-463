tal/></person-group><source>J Mol Biol</source><year>1995</year><volume>253</volume><fpage>333</fpage><pub-id pub-id-type="pmid">7563093</pub-id></citation></ref><ref id="R12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Deng</surname><given-names>J</given-names></name><etal/></person-group><source>J Med Chem</source><year>2005</year><volume>48</volume><fpage>1496</fpage><pub-id pub-id-type="pmid">15743192</pub-id></citation></ref><ref id="R13"><label>13</label><citation citation-type="web"><comment><ext-link ext-link-type="uri" xlink:href="http://mcl1.ncifcrf.gov/integrase/asv_y3.html">http://mcl1.ncifcrf.gov/integrase/asv_y3.html</ext-link></comment></citation></ref><ref id="R14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lubkowski</surname><given-names>J</given-names></name><etal/></person-group><source>App Biol Sci</source><year>1998</year><volume>95</volume><fpage>4831</fpage></citation></ref><ref id="R15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berman</surname><given-names>HM</given-names></name><etal/></person-group><source>Nucleic Acids Res</source><year>2000</year><volume>28</volume><fpage>235</fpage><pub-id pub-id-type="pmid">10592235</pub-id></citation></ref><ref id="R16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brady</surname><given-names>GP</given-names></name><etal/></person-group><source>J Comp Aided Mol Design</source><year>2000</year><volume>14</volume><fpage>383</fpage></citation></ref><ref id="R17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>R</given-names></name><etal/></person-group><source>J Mol Model</source><year>2000</year><volume>6</volume><fpage>498</fpage></citation></ref><ref id="R18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barreca</surname><given-names>ML</given-names></name><etal/></person-group><source>J Med Chem</source><year>2005</year><volume>48</volume><fpage>7084</fpage><pub-id pub-id-type="pmid">16250669</pub-id></citation></ref><ref id="R19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nicklaus</surname><given-names>MC</given-names></name><etal/></person-group><source>J Med Chem</source><year>1997</year><volume>40</volume><fpage>920</fpage><pub-id pub-id-type="pmid">9083480</pub-id></citation></ref><ref id="R20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hong</surname><given-names>H</given-names></name><etal/></person-group><source>J Med Chem</source><year>1997</year><volume>40</volume><fpage>930</fpage><pub-id pub-id-type="pmid">9083481</pub-id></citation></ref><ref id="R21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Neamati</surname><given-names>N</given-names></name><etal/></person-group><source>Mol Pharmacol</source><year>1997</year><volume>52</volume><fpage>1041</fpage><pub-id pub-id-type="pmid">9415714</pub-id></citation></ref><ref id="R22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dayam</surname><given-names>R</given-names></name><etal/></person-group><source>J Med Chem</source><year>2005</year><volume>48</volume><fpage>8009</fpage><pub-id pub-id-type="pmid">16335925</pub-id></citation></ref><ref id="R23"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Deng</surname><given-names>J</given-names></name><etal/></person-group><source>J Med Chem</source><year>2005</year><volume>48</volume><fpage>1496</fpage><pub-id pub-id-type="pmid">15743192</pub-id></citation></ref><re