e>Mutat Res</source><volume>262</volume><fpage>63</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">1702518</pub-id></citation></ref><ref id="pcbi-0030093-b013"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Khrapko</surname><given-names>K</given-names></name><name><surname>Hanekamp</surname><given-names>JS</given-names></name><name><surname>Thilly</surname><given-names>WG</given-names></name><name><surname>Belenkii</surname><given-names>A</given-names></name><name><surname>Foret</surname><given-names>F</given-names></name><etal/></person-group><year>1994</year><article-title>Constant denaturant capillary electrophoresis (CDCE): A high resolution approach to mutational analysis</article-title><source>Nucleic Acids Res</source><volume>22</volume><fpage>364</fpage><lpage>369</lpage><pub-id pub-id-type="pmid">8127674</pub-id></citation></ref><ref id="pcbi-0030093-b014"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lerman</surname><given-names>LS</given-names></name><name><surname>Silverstein</surname><given-names>K</given-names></name></person-group><year>1987</year><article-title>Computational simulation of DNA melting and its application to denaturing gradient gel electrophoresis</article-title><source>Methods Enzymol</source><volume>155</volume><fpage>482</fpage><lpage>501</lpage><pub-id pub-id-type="pmid">2828875</pub-id></citation></ref><ref id="pcbi-0030093-b015"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wartell</surname><given-names>R</given-names></name><name><surname>Benight</surname><given-names>AS</given-names></name></person-group><year>1985</year><article-title>Thermal denaturation of DNA molecules: A comparison of theory with experiment</article-title><source>Phys Rep</source><volume>126</volume><fpage>67</fpage><lpage>107</lpage></citation></ref><ref id="pcbi-0030093-b016"><citation citation-type="journal"><person-group 