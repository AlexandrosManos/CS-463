on-type="journal"><person-group person-group-type="author"><name><surname>Chambers</surname><given-names>R</given-names></name><name><surname>Campbell</surname><given-names>I</given-names></name></person-group><article-title>Anxiety and depression in general practitioners: associations with type of practice, fundholding, gender and other personal characteristics</article-title><source>Family Practice</source><year>1996</year><volume>13</volume><fpage>170</fpage><lpage>173</lpage><pub-id pub-id-type="doi">10.1093/fampra/13.2.170</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Laflamme</surname><given-names>L</given-names></name><name><surname>Blank</surname><given-names>VL</given-names></name></person-group><article-title>Age-related accident risks: longitudinal study of Swedish iron ore miners</article-title><source>American Journal of Industrial Medicine</source><year>1996</year><volume>30</volume><fpage>479</fpage><lpage>487</lpage><pub-id pub-id-type="pmid">8892554</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1097-0274(199610)30:4&#x0003c;479::AID-AJIM14&#x0003e;3.0.CO;2-1</pub-id></citation></ref></ref-list></back></article>