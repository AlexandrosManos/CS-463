-group person-group-type="author"><name><surname>Meding</surname><given-names>B</given-names></name><name><surname>Swanbeck</surname><given-names>G</given-names></name></person-group><article-title>Predictive factors for hand eczema</article-title><source>Contact Dermatitis</source><year>1990</year><volume>23</volume><fpage>154</fpage><lpage>161</lpage><pub-id pub-id-type="pmid">2149316</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Montnemery</surname><given-names>P</given-names></name><name><surname>Svensson</surname><given-names>C</given-names></name><name><surname>Adelroth</surname><given-names>E</given-names></name><name><surname>Lofdahl</surname><given-names>CG</given-names></name><name><surname>Andersson</surname><given-names>M</given-names></name><name><surname>Greiff</surname><given-names>L</given-names></name><name><surname>Persson</surname><given-names>CG</given-names></name></person-group><article-title>Prevalence of nasal symptoms and their relation to self-reported asthma and chronic bronchitis/emphysema</article-title><source>Eur Respir J</source><year>2001</year><volume>17</volume><fpage>596</fpage><lpage>603</lpage><pub-id pub-id-type="pmid">11401051</pub-id><pub-id pub-id-type="doi">10.1183/09031936.01.17405960</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Montnemery</surname><given-names>P</given-names></name><name><surname>Adelroth</surname><given-names>E</given-names></name><name><surname>Heuman</surname><given-names>K</given-names></name><name><surname>Johannisson</surname><given-names>A</given-names></name><name><surname>Johansson</surname><given-names>SA</given-names></name><name><surname>Lindholm</surname><given-names>LH</given-names></name><name><surname>Lundback</surname><given-names>B</given-names></name><name><surname>Lofdahl</surname><given-names>CG</given-names></name></pers