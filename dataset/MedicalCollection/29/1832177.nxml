</td></tr></thead><tbody><tr><td align="left">4&#x02013;6</td><td align="left">8 (39)</td><td align="left">8 (40)</td><td align="left">1531</td><td align="left">0.749</td></tr><tr><td align="left">6&#x02013;8</td><td align="left">10 (42)</td><td align="left">10 (35)</td><td align="left">1688</td><td align="left">0.581</td></tr><tr><td align="left">8&#x02013;10</td><td align="left">11 (82)</td><td align="left">11 (80)</td><td align="left">6356</td><td align="left">0.243</td></tr><tr><td align="left">10&#x02013;12</td><td align="left">11 (13)</td><td align="left">12 (13)</td><td align="left">170</td><td align="left">0.761</td></tr><tr><td align="left">12&#x02013;14</td><td align="left">14 (39)</td><td align="left">13 (39)</td><td align="left">1642</td><td align="left">0.282</td></tr><tr><td align="left">14&#x02013;16</td><td align="left">13.5 (40)</td><td align="left">14 (34)</td><td align="left">1291</td><td align="left">0.0264</td></tr><tr><td align="left">16&#x02013;18</td><td align="left">14 (25)</td><td align="left">15 (19)</td><td align="left">40.5</td><td align="left">0.0001</td></tr><tr><td align="left">18&#x02013;20</td><td align="left">17 (21)</td><td align="left">17 (28)</td><td align="left">5075</td><td align="left">0.4083</td></tr><tr><td align="left">20&#x02013;22</td><td align="left">17 (2)</td><td align="left">17 (5)</td><td align="left">N/A</td><td align="left">-</td></tr><tr><td align="left">22&#x02013;24</td><td align="left">17 (4)</td><td align="left">17 (5)</td><td align="left">N/A</td><td align="left">-</td></tr></tbody></table></table-wrap></sec></back></article>