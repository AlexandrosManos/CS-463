="B11"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Ghozlan</surname><given-names>SAS</given-names></name><name><surname>Abdelhamid</surname><given-names>IA</given-names></name><name><surname>Ibrahim</surname><given-names>HM</given-names></name><name><surname>Elnagdi</surname><given-names>MH</given-names></name></person-group><source>Arkivoc</source><year>2007</year><volume>xv</volume><fpage>53</fpage></citation></ref></ref-list></back></article>