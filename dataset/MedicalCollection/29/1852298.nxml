<pub-id pub-id-type="doi">10.1126/science.1080659</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>XG</given-names></name><name><surname>Sandk&#x000fc;hler</surname><given-names>J</given-names></name></person-group><article-title>Characterization of long-term potentiation of C-fiber-evoked potentials in spinal dorsal horn of adult rat: essential role of NK1 and NK2 receptors</article-title><source>J Neurophysiol</source><year>1997</year><volume>78</volume><fpage>1973</fpage><lpage>1982</lpage><pub-id pub-id-type="pmid">9325365</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schouenborg</surname><given-names>J</given-names></name></person-group><article-title>Functional and topographical properties of field potentials evoked in rat dorsal horn by cutaneous C-fibre stimulation</article-title><source>J Physiol</source><year>1984</year><volume>356</volume><fpage>169</fpage><lpage>192</lpage><pub-id pub-id-type="pmid">6520786</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ikeda</surname><given-names>H</given-names></name><name><surname>Murase</surname><given-names>K</given-names></name></person-group><article-title>Glial nitric oxide-mediated long-term presynaptic facilitation revealed by optical imaging in rat spinal dorsal horn</article-title><source>J Neurosci</source><year>2004</year><volume>24</volume><fpage>9888</fpage><lpage>9896</lpage><pub-id pub-id-type="pmid">15525773</pub-id><pub-id pub-id-type="doi">10.1523/JNEUROSCI.2608-04.2004</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ikeda</surname><given-names>H</given-names></name><name><surname>Stark</surname><given-names>J</given-names></name><name><surname>Fischer</su