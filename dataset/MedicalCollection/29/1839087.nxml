age><pub-id pub-id-type="pmid">12780362</pub-id><pub-id pub-id-type="doi">10.1046/j.1360-0443.2003.00376.x</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Galea</surname><given-names>S</given-names></name><name><surname>Ahern</surname><given-names>J</given-names></name><name><surname>Tardiff</surname><given-names>K</given-names></name><name><surname>Leon</surname><given-names>A</given-names></name><name><surname>Coffin</surname><given-names>PO</given-names></name><name><surname>Derr</surname><given-names>K</given-names></name><name><surname>Vlahov</surname><given-names>D</given-names></name></person-group><article-title>Racial/ethnic disparities in overdose mortality trends in New York City, 1990-1998</article-title><source>J Urban Health</source><year>2003</year><volume>80</volume><fpage>201</fpage><lpage>211</lpage><pub-id pub-id-type="pmid">12791796</pub-id></citation></ref><ref id="B11"><citation citation-type="other"><person-group person-group-type="author"><collab>New York City Department of Health and Mental Hygiene</collab></person-group><article-title>Summary of Vital Statistics 2003</article-title><year>2004</year></citation></ref><ref id="B12"><citation citation-type="journal"><article-title>Heroin overdose deaths--Multnomah County, Oregon, 1993-1999</article-title><source>MMWR Morb Mortal Wkly Rep</source><year>2000</year><volume>49</volume><fpage>633</fpage><lpage>636</lpage><pub-id pub-id-type="pmid">10926305</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><article-title>Unintentional opiate overdose deaths--King County, Washington, 1990-1999</article-title><source>MMWR Morb Mortal Wkly Rep</source><year>2000</year><volume>49</volume><fpage>636</fpage><lpage>640</lpage><pub-id pub-id-type="pmid">10926306</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Darke</surname><g