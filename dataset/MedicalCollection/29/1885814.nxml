n-names></name><name><surname>Cosset</surname><given-names>FL</given-names></name></person-group><article-title>Surface-engineering of lentiviral vectors</article-title><source>J Gene Med</source><year>2004</year><volume>6</volume><fpage>S83</fpage><lpage>S94</lpage><pub-id pub-id-type="pmid">14978753</pub-id><pub-id pub-id-type="doi">10.1002/jgm.494</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martin-Martinez</surname><given-names>MD</given-names></name><name><surname>Stoenoiu</surname><given-names>M</given-names></name><name><surname>Verkaeren</surname><given-names>C</given-names></name><name><surname>Devuyst</surname><given-names>O</given-names></name><name><surname>Delporte</surname><given-names>C</given-names></name></person-group><article-title>Recombinant adenovirus administration in rat peritoneum: endothelial expression and safety concerns</article-title><source>Nephrol Dial Transplant</source><year>2004</year><volume>10</volume><fpage>1293</fpage><lpage>1297</lpage><pub-id pub-id-type="pmid">14993505</pub-id><pub-id pub-id-type="doi">10.1093/ndt/gfh042</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hollon</surname><given-names>T</given-names></name></person-group><article-title>Researchers and regulators reflect on first gene therapy death</article-title><source>Nat Med</source><year>2000</year><volume>6</volume><fpage>6</fpage><pub-id pub-id-type="pmid">10613797</pub-id><pub-id pub-id-type="doi">10.1038/71545</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wysocki</surname><given-names>PJ</given-names></name><name><surname>Grabarczyk</surname><given-names>P</given-names></name><name><surname>Mackiewicz-Wysocka</surname><given-names>M</given-names></name><name><surname>Kowalczyk</surname><given-names>DW</given-nam