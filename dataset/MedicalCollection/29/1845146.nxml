="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wagner</surname><given-names>M</given-names></name><name><surname>Horn</surname><given-names>M</given-names></name></person-group><article-title>The Planctomycetes, Verrucomicrobia, Chlamydiae and sister phyla comprise a superphylum with biotechnological and medical relevance</article-title><source>Curr Opin Biotechnol</source><year>2006</year><volume>17</volume><fpage>241</fpage><lpage>249</lpage><pub-id pub-id-type="pmid">16704931</pub-id><pub-id pub-id-type="doi">10.1016/j.copbio.2006.05.005</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jenkins</surname><given-names>C</given-names></name><name><surname>Samudrala</surname><given-names>R</given-names></name><name><surname>Anderson</surname><given-names>I</given-names></name><name><surname>Hedlund</surname><given-names>BP</given-names></name><name><surname>Petroni</surname><given-names>G</given-names></name><name><surname>Michailova</surname><given-names>N</given-names></name><name><surname>Pinel</surname><given-names>N</given-names></name><name><surname>Overbeek</surname><given-names>R</given-names></name><name><surname>Rosati</surname><given-names>G</given-names></name><name><surname>Staley</surname><given-names>JT</given-names></name></person-group><article-title>Genes for the cytoskeletal protein tubulin in the bacterial genus Prosthecobacter</article-title><source>Proc Natl Acad Sci U S A</source><year>2002</year><volume>99</volume><fpage>17049</fpage><lpage>17054</lpage><pub-id pub-id-type="pmid">12486237</pub-id><pub-id pub-id-type="doi">10.1073/pnas.012516899</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sontag</surname><given-names>CA</given-names></name><name><surname>Staley</surname><given-names>JT</given-names></name><name><surname>Erickson</surname><given-names>HP</given-names></name></person-group><article-title>In vitro assembly and GTP hydrolysis by bacterial tubulins BtubA and BtubB</article-title><source>Journal of Cell Biology</source><year>2005</year><volume>169</volume><fpage>233</fpage><lpage>238</lpage><pub-id pub-id-type="pmid">15851515</pub-id><pub-id pub-id-type="doi">10.1083/jcb.200410027</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Attwood</surname><given-names>TK</given-names></name></person-group><article-title>The PRINTS database: a resource for identification of protein families</article-title><source>Brief Bioinform</source><year>2002</year><volume>3</volume><fpage>252</fpage><lpage>263</lpage><pub-id pub-id-type="pmid">12230034</pub-id><pub-id pub-id-type="doi">10.1093/bib/3.3.252</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barker</surname><given-names>WC</given-names></name><name><surname>Pfeiffer</surname><given-names>F</given-names></name><name><surname>George</surname><given-names>DG</given-names></name></person-group><article-title>Superfamily classification in PIR-International Protein Sequence Database</article-title><source>Methods Enzymol</source><year>1996</year><volume>266</volume><fpage>59</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">8743677</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jobb</surname><given-names>G</given-names></name><name><surname>von Haeseler</surname><given-names>A</given-names></name><name><surname>Strimmer</surname><given-names>K</given-names></name></person-group><article-title>TREEFINDER: a powerful graphical analysis environment for molecular phylogenetics</article-title><source>BMC Evol Biol</source><year>2004</year><volume>4</volume><fpage>18</fpage><pub-id pub-id-type="pmid">15222900</pub-id><pub-id pub-id-type="doi">10.1186/1471-2148-4-18</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vicente</surname><given-names>M</given-names></name><name><surname>Gomez</surname><given-names>MJ</given-names></name><name><surname>Ayala</surname><given-names>JA</given-names></name></person-group><article-title>Regulation of transcription of cell division genes in the <italic>Escherichia coli</italic> dcw cluster</article-title><source>Cell Mol Life Sci</source><year>1998</year><volume>54</volume><fpage>317</fpage><lpage>324</lpage><pub-id pub-id-type="pmid">9614967</pub-id><pub-id pub-id-type="doi">10.1007/s000180050158</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schlieper</surname><given-names>D</given-names></name><name><surname>Oliva</surname><given-names>MA</given-names></name><name><surname>Andreu</surname><given-names>JM</given-names></name><name><surname>Lowe</surname><given-names>J</given-names></name></person-group><article-title>Structure of bacterial tubulin BtubA/B: Evidence for horizontal gene transfer</article-title><source>Proceedings of the National Academy of Sciences of the United States of America</source><year>2005</year><volume>102</volume><fpage>9170</fpage><lpage>9175</lpage><pub-id pub-id-type="pmid">15967998</pub-id><pub-id pub-id-type="doi">10.1073/pnas.0502859102</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jain</surname><given-names>R</given-names></name><name><surname>Rivera</surname><given-names>MC</given-names></name><name><surname>Lake</surname><given-names>JA</given-names></name></person-group><article-title>Horizontal gene transfer among genomes: the complexity hypothesis</article-title><source>Proc Natl Acad Sci U S A</source><year>1999</year><volume>96</volume><fpage>3801</fpage><lpage>