on citation-type="other"><person-group person-group-type="author"><name><surname>Grimme</surname><given-names>S</given-names></name><name><surname>Oestreich</surname><given-names>M</given-names></name></person-group><year>2006</year><comment>unpublished results</comment></citation></ref></ref-list></back></article>