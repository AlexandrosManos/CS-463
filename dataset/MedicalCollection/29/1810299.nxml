tion citation-type="journal"><person-group person-group-type="author"><name><surname>Schmidt</surname><given-names>DR</given-names></name><name><surname>O'Malley</surname><given-names>SJ</given-names></name><name><surname>Leighton</surname><given-names>JL</given-names></name></person-group><source>J Am Chem Soc</source><year>2003</year><volume>12</volume><fpage>1190</fpage><lpage>1191</lpage><pub-id pub-id-type="pmid">12553820</pub-id><pub-id pub-id-type="doi">10.1021/ja0283201</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oestreich</surname><given-names>M</given-names></name><name><surname>Rendler</surname><given-names>S</given-names></name></person-group><source>Angew Chem Int Ed</source><year>2005</year><volume>44</volume><fpage>1661</fpage><lpage>1664</lpage><pub-id pub-id-type="doi">10.1002/anie.200462355</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rendler</surname><given-names>S</given-names></name><name><surname>Auer</surname><given-names>G</given-names></name><name><surname>Oestreich</surname><given-names>M</given-names></name></person-group><source>Angew Chem Int Ed</source><year>2005</year><volume>44</volume><fpage>7620</fpage><lpage>7624</lpage><pub-id pub-id-type="doi">10.1002/anie.200502631</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rendler</surname><given-names>S</given-names></name><name><surname>Oestreich</surname><given-names>M</given-names></name><name><surname>Butts</surname><given-names>CP</given-names></name><name><surname>Lloyd-Jones</surname><given-names>GC</given-names></name></person-group><source>J Am Chem Soc</source><year>2007</year><volume>129</volume><fpage>502</fpage><lpage>503</lpage><pub-id pub-id-type="pmid">17227008</pub-id><pub-id pub-id-type="doi">10.1021/ja067780h</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rendler</surname><given-names>S</given-names></name><name><surname>Auer</surname><given-names>G</given-names></name><name><surname>Keller</surname><given-names>M</given-names></name><name><surname>Oestreich</surname><given-names>M</given-names></name></person-group><source>Adv Synth Catal</source><year>2006</year><volume>348</volume><fpage>1171</fpage><lpage>1182</lpage><pub-id pub-id-type="doi">10.1002/adsc.200606071</pub-id></citation></ref><ref id="B12"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Bertrand</surname><given-names>G</given-names></name><name><surname>Dubac</surname><given-names>J</given-names></name><name><surname>Mazerolles</surname><given-names>P</given-names></name><name><surname>Ancelle</surname><given-names>J</given-names></name></person-group><source>Nouv J Chim</source><year>1982</year><volume>6</volume><fpage>381</fpage><lpage>386</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Larson</surname><given-names>GL</given-names></name><name><surname>Torres</surname><given-names>E</given-names></name></person-group><source>J Organomet Chem</source><year>1985</year><volume>293</volume><fpage>19</fpage><lpage>27</lpage><pub-id pub-id-type="doi">10.1016/0022-328X(85)80241-2</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jankowski</surname><given-names>P</given-names></name><name><surname>Schaumann</surname><given-names>E</given-names></name><name><surname>Wicha</surname><given-names>J</given-names></name><name><surname>Zarecki</surname><given-names>A</given-names></name><name><surname>Adiwidjaja</surname><given-names>G</given-names></name></person-group><source>Tetrahedron: Asymmetry</source><year>1999</year><volume>10</volume><fpage>519</f