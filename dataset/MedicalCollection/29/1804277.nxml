">1</td><td align="center">0.837</td><td align="center">1</td><td align="center">0.8168</td><td align="center">1</td><td align="center">0.8664</td><td align="center">0.9875</td><td align="center">0.8666</td></tr><tr><td align="center">2</td><td align="center">1</td><td align="center">0.9764</td><td align="center">1</td><td align="center">0.9772</td><td align="center">1</td><td align="center">0.9784</td><td align="center">1</td><td align="center">0.9766</td><td align="center">0.95</td><td align="center">0.6488</td><td align="center">0.9875</td><td align="center">0.8296</td><td align="center">1</td><td align="center">0.2624</td><td align="center">0.9375</td><td align="center">0.8766</td><td align="center">0.9</td><td align="center">0.8768</td></tr><tr><td align="center">3</td><td align="center">1</td><td align="center">0.9644</td><td align="center">1</td><td align="center">0.966</td><td align="center">1</td><td align="center">0.9708</td><td align="center">1</td><td align="center">0.9682</td><td align="center">0.8375</td><td align="center">0.9378</td><td align="center">0.9625</td><td align="center">0.9018</td><td align="center">0.9625</td><td align="center">0.8876</td><td align="center">0.95</td><td align="center">0.9016</td><td align="center">0.9375</td><td align="center">0.9018</td></tr></tbody></table><table-wrap-foot><p>Sequential GA, parallel GA (2 and 4 islands mode) and support vector machines (SVM binary and single), logitBoost, linear discriminant analysis (LDA), logistic regression (LR), and linear least squares regression (LS) for three sets of template vectors of different dimensions were tested. Se and Sp are defined in Eq. 7 and 8.</p></table-wrap-foot></table-wrap><table-wrap position="float" id="T2"><label>Table 2</label><caption><p>Comparison of classification performance of the parallel and sequential GA with other classification algorithms |x| = 40.</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="center">Pattern</td><td align=