ype="book"><person-group person-group-type="author"><name><surname>Cantu-Paz</surname><given-names>E</given-names></name></person-group><source>Efficient and accurate parallel genetic algorithms.</source><year>2001</year><publisher-name>Massachusetts, USA  , Kluwer Academic Publishers</publisher-name></citation></ref><ref id="B24"><citation citation-type="book"><article-title>Stanford MicroArray Database</article-title><source>http://genome-www5stanfordedu</source><publisher-name> http://genome-www5.stanford.edu</publisher-name></citation></ref><ref id="B25"><citation citation-type="book"><person-group person-group-type="author"><name><surname>To</surname><given-names>CC</given-names></name><name><surname>Vohradsky</surname><given-names>J</given-names></name></person-group><source>Classification of proteomic kinetic patterns using supervised genetic programming: Edinbourgh, UK.					</source><year>2005</year><fpage> 1823</fpage><lpage>1830</lpage></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bentley</surname><given-names>SD</given-names></name><name><surname>Chater</surname><given-names>KF</given-names></name><name><surname>Cerdeno-Tarraga</surname><given-names>AM</given-names></name><name><surname>Challis</surname><given-names>GL</given-names></name><name><surname>Thomson</surname><given-names>NR</given-names></name><name><surname>James</surname><given-names>KD</given-names></name><name><surname>Harris</surname><given-names>DE</given-names></name><name><surname>Quail</surname><given-names>MA</given-names></name><name><surname>Kieser</surname><given-names>H</given-names></name><name><surname>Harper</surname><given-names>D</given-names></name><name><surname>Bateman</surname><given-names>A</given-names></name><name><surname>Brown</surname><given-names>S</given-names></name><name><surname>Chandra</surname><given-names>G</given-names></name><name><surname>Chen</surname><given-names>CW</given-names