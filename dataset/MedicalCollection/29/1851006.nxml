ames></name><name><surname>Donalisio</surname><given-names>MR</given-names></name></person-group><article-title>Use of remote sensing to study the influence of environmental changes on malaria distribution in the Brazilian Amazon</article-title><source>Cadernos de Sa&#x000fa;de P&#x000fa;blica</source><year>2006</year><volume>22</volume><fpage>517</fpage><lpage>526</lpage><pub-id pub-id-type="doi">10.1590/S0102-311X2006000300006</pub-id></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Takken</surname><given-names>W</given-names></name><name><surname>Vilarinhos</surname><given-names>PTR</given-names></name><name><surname>Schneider</surname><given-names>P</given-names></name><name><surname>Santos</surname><given-names>F</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Bogers RJ, Martens P, Takken W</surname></name></person-group><article-title>Effects of environmental change on malaria in the Amazon region of Brazil</article-title><source>Environmental Change and Malaria Risk Global and Local Implications</source><year>2005</year><volume>11</volume><publisher-name>Wageningen University Research Centre</publisher-name><fpage>113</fpage><lpage>123</lpage><ext-link ext-link-type="uri" xlink:href="http://library.wur.nl/frontis/environmental_change/11_takken.pdf"/></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Deane</surname><given-names>LM</given-names></name></person-group><article-title>Malaria vectors in Brazil</article-title><source>Memorias do Instituto Oswaldo Cruz</source><year>1986</year><volume>81</volume><fpage>5</fpage><lpage>14</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vittor</surname><given-names>AY</given-names></name><name><surname>Gilman</surname><given-names>RH</given-names></name><name><surname>Tielsch</surname><given-names>J</given-names></name><name><surname>Glass</surname><given-names>G</given-names></name><name><surname>Shields</surname><given-names>T</given-names></name><name><surname>Lozano</surname><given-names>WS</given-names></name><name><surname>Pinedo-Cancino</surname><given-names>V</given-names></name><name><surname>Patz</surname><given-names>JA</given-names></name></person-group><article-title>The effect of deforestation on the human-biting rate of Anopheles darlingi, the primary vector of Falciparum malaria in the Peruvian Amazon</article-title><source>Am J Trop Med Hyg</source><year>2006</year><volume>74</volume><fpage>3</fpage><lpage>11</lpage><pub-id pub-id-type="pmid">16407338</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Castro</surname><given-names>MC</given-names></name><name><surname>Monte-Mor</surname><given-names>RL</given-names></name><name><surname>Sawyer</surname><given-names>DO</given-names></name><name><surname>Singer</surname><given-names>BH</given-names></name></person-group><article-title>Malaria risk on the Amazon frontier</article-title><source>Proc Natl Acad Sci USA</source><year>2006</year><volume>103</volume><fpage>2452</fpage><lpage>2457</lpage><pub-id pub-id-type="pmid">16461902</pub-id><pub-id pub-id-type="doi">10.1073/pnas.0510576103</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Singer</surname><given-names>BH</given-names></name><name><surname>Castro</surname><given-names>MC</given-names></name></person-group><article-title>Agricultural Colonization and Malaria on the Amazon Frontier</article-title><source>Annals of the New York Academy of Sciences</source><year>2001</year><volume>954</volume><fpage>184</fpage><lpage>222</lpage><pub-id pub-id-type="pmid">11797857</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-gr