-id pub-id-type="pmid">15537478</pub-id></citation></ref><ref id="b8"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gawel</surname><given-names>MJ</given-names></name></person-group><article-title>Systematic review of the use of triptans in acute migraine</article-title><source>Can J Neurol Sci</source><year>2001</year><volume>28</volume><fpage>30</fpage><lpage>41</lpage><pub-id pub-id-type="pmid">11252291</pub-id></citation></ref><ref id="b9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gibbs</surname><given-names>TS</given-names></name><etal/></person-group><article-title>Health care utilization in patients with migraine: demographics and patterns of care in the ambulatory setting</article-title><source>Headache</source><year>2003</year><volume>43</volume><fpage>330</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">12656703</pub-id></citation></ref><ref id="b10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>MacGregor</surname><given-names>EA</given-names></name></person-group><article-title>The doctor and the migraine patient: improving compliance</article-title><source>Neurology</source><year>1997</year><volume>48</volume><issue>Suppl. 3</issue><fpage>S16</fpage><lpage>20</lpage><pub-id pub-id-type="pmid">9071265</pub-id></citation></ref><ref id="b11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dowson</surname><given-names>AJ</given-names></name></person-group><article-title>Patients&#x02019; preference for triptans and other medications as a tool for assessing the efficacy of acute treatments for migraine</article-title><source>J Headache Pain</source><year>2005</year><volume>6</volume><fpage>112</fpage><lpage>20</lpage><pub-id pub-id-type="pmid">16355291</pub-id></citation></ref><ref id="b12"><label>12</label><citation c