-group><article-title>"Backside nonconformity and locking restrains affect liner/shell load transfer mechanism and relative motion in modular acetabular components for total hip replacement"</article-title><source>Journal of Biomechanics</source><year>1998</year><volume>31</volume><fpage>431</fpage><lpage>437</lpage><pub-id pub-id-type="pmid">9727340</pub-id><pub-id pub-id-type="doi">10.1016/S0021-9290(98)00030-X</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bergmann</surname><given-names>G</given-names></name><name><surname>Graichen</surname><given-names>F</given-names></name><name><surname>Rohlman</surname><given-names>A</given-names></name><name><surname>Linke</surname><given-names>H</given-names></name></person-group><article-title>"Hip Joint Forces During Load Carrying"</article-title><source>Journal of Clinical Orthopedics</source><year>1997</year><volume>335</volume><fpage>190</fpage><lpage>201</lpage></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brand</surname><given-names>RA</given-names></name><name><surname>Pedersen</surname><given-names>DR</given-names></name><name><surname>Davy</surname><given-names>DT</given-names></name></person-group><article-title>"Comparison of hip force calculations and measurements in the same patient"</article-title><source>The Journal of Arthroplasty</source><year>1994</year><volume>9</volume><fpage>45</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">8163975</pub-id><pub-id pub-id-type="doi">10.1016/0883-5403(94)90136-8</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morlock</surname><given-names>M</given-names></name><name><surname>Sheneider</surname><given-names>E</given-names></name><name><surname>Blumh</surname><given-names>A</given-names></name><name><surname>Vollmer</surname><given-names>M</given-names></name><name><surname>Bergmann</surname><given-names>G</given-names></name><name><surname>Muller</surname><given-names>V</given-names></name><name><surname>Honl</surname><given-names>M</given-names></name></person-group><article-title>"Duration and frequency of every day activities in total hip patients"</article-title><source>Journal of Biomechanics</source><year>2001</year><volume>34</volume><fpage>873</fpage><lpage>881</lpage><pub-id pub-id-type="pmid">11410171</pub-id><pub-id pub-id-type="doi">10.1016/S0021-9290(01)00035-5</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bergmann</surname><given-names>G</given-names></name><name><surname>Deuretzbacher</surname><given-names>G</given-names></name><name><surname>Heller</surname><given-names>M</given-names></name><name><surname>Graichen</surname><given-names>F</given-names></name><name><surname>Rohlmann</surname><given-names>A</given-names></name><name><surname>Strauss</surname><given-names>J</given-names></name><name><surname>Duda</surname><given-names>GN</given-names></name></person-group><article-title>"Hip contact forces and gait patterns from routine activities"</article-title><source>Journal of Biomechanics</source><year>2001</year><volume>34</volume><fpage>859</fpage><lpage>871</lpage><pub-id pub-id-type="pmid">11410170</pub-id><pub-id pub-id-type="doi">10.1016/S0021-9290(01)00040-9</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ipavec</surname><given-names>M</given-names></name><name><surname>Brand</surname><given-names>RA</given-names></name><name><surname>Pedersen</surname><given-names>DR</given-names></name><name><surname>Mavcic</surname><given-names>B</given-names></name><name><surname>Kralj-Iglic</surname><given-names>V</given-names></name><name><surname>Iglic</surname><given-names>A</given-names></name></person-group><article-title>"Mathematical modeling of stress in the hip during gait"</article-title><source>Journal of Biomechanics</source><year>1999</year><volume>32</volume><fpage>1229</fpage><lpage>1235</lpage><pub-id pub-id-type="pmid">10541074</pub-id><pub-id pub-id-type="doi">10.1016/S0021-9290(99)00119-0</pub-id></citation></ref></ref-list></back></article>