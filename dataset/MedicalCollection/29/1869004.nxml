float" id="F2"><label>Figure 2</label><caption><p>Task 1B results for all organisms: precision vs. recall.</p></caption><graphic xlink:href="1471-2105-6-S1-S11-2"/></fig><fig position="float" id="F3"><label>Figure 3</label><caption><p>Distribution of ambiguous synonyms in Fly, Mouse and Yeast task 1B lexical resources.</p></caption><graphic xlink:href="1471-2105-6-S1-S11-3"/></fig><table-wrap position="float" id="T1"><label>Table 1</label><caption><p>Task 1B training and test data sets</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="left"><bold>Abstracts</bold></td><td align="left"><bold>Yeast</bold></td><td align="left"><bold>Fly</bold></td><td align="left"><bold>Mouse</bold></td></tr></thead><tbody><tr><td align="left">Training (noisy annotation)</td><td align="left">5000</td><td align="left">5000</td><td align="left">5000</td></tr><tr><td align="left">Development test (hand corrected)</td><td align="left">108</td><td align="left">110</td><td align="left">250</td></tr><tr><td align="left">Blind Test (extensively corrected)</td><td align="left">250</td><td align="left">250</td><td align="left">250</td></tr></tbody></table></table-wrap><table-wrap position="float" id="T2"><label>Table 2</label><caption><p>Task 1B results on Yeast gene list task</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="left"><bold>YEAST</bold></td><td align="left"><bold>F-measure</bold></td><td align="left"><bold>Precision</bold></td><td align="left"><bold>Recall</bold></td><td align="center"><bold>True Positives</bold></td><td align="center"><bold>False Positives</bold></td><td align="center"><bold>Missed</bold></td></tr></thead><tbody><tr><td align="left"><bold>Gold Standard</bold></td><td align="left"><bold>1.000</bold></td><td align="left"><bold>1.000</bold></td><td align="left"><bold>1.000</bold></td><td align="center"><bold>613</bold></td><td align="center"><bold>0</bold></td><td align="center"><bold>0</bold></td></tr><tr><td align="left"><