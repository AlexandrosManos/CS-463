ref id="pcbi-0030043-b020"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bowers</surname><given-names>PM</given-names></name><name><surname>O'Connor</surname><given-names>BD</given-names></name><name><surname>Cokus</surname><given-names>SJ</given-names></name><name><surname>Sprinzak</surname><given-names>E</given-names></name><name><surname>Yeates</surname><given-names>TO</given-names></name><etal/></person-group><year>2005</year><article-title>Utilizing logical relationships in genomic data to decipher cellular processes</article-title><source>Febs J</source><volume>272</volume><fpage>5110</fpage><lpage>5118</lpage><pub-id pub-id-type="pmid">16218945</pub-id></citation></ref><ref id="pcbi-0030043-b021"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bowers</surname><given-names>PM</given-names></name><name><surname>Cokus</surname><given-names>SJ</given-names></name><name><surname>Eisenberg</surname><given-names>D</given-names></name><name><surname>Yeates</surname><given-names>TO</given-names></name></person-group><year>2004</year><article-title>Use of logic relation-ships to decipher protein network organization</article-title><source>Science</source><volume>306</volume><fpage>2246</fpage><lpage>2249</lpage><pub-id pub-id-type="pmid">15618515</pub-id></citation></ref><ref id="pcbi-0030043-b022"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pagel</surname><given-names>P</given-names></name><name><surname>Wong</surname><given-names>P</given-names></name><name><surname>Frishman</surname><given-names>D</given-names></name></person-group><year>2004</year><article-title>A domain interaction map based on phylogenetic profiling</article-title><source>J Mol Biol</source><volume>344</volume><fpage>1331</fpage><lpage>1346</lpage><pub-id pub-id-type="pmid">15561146</pub-id></citation></ref><ref id="pcbi-0030043-b023"><citation citation-type="journal