e><lpage>183</lpage><pub-id pub-id-type="pmid">15715523</pub-id><pub-id pub-id-type="doi">10.1042/BC20040098</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nakahara</surname><given-names>H</given-names></name><name><surname>Dennis</surname><given-names>JE</given-names></name><name><surname>Bruder</surname><given-names>SP</given-names></name><name><surname>Haynesworth</surname><given-names>SE</given-names></name><name><surname>Lennon</surname><given-names>DP</given-names></name><name><surname>Caplan</surname><given-names>AI</given-names></name></person-group><article-title>In vitro differentiation of bone and hypertrophic cartilage from periosteal-derived cells</article-title><source>Exp Cell Res</source><year>1991</year><volume>195</volume><fpage>492</fpage><lpage>503</lpage><pub-id pub-id-type="pmid">2070830</pub-id><pub-id pub-id-type="doi">10.1016/0014-4827(91)90401-F</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nakahara</surname><given-names>H</given-names></name><name><surname>Goldberg</surname><given-names>VM</given-names></name><name><surname>Caplan</surname><given-names>AI</given-names></name></person-group><article-title>Culture-expanded human periosteal-derived cells exhibit osteochondral potential in vivo</article-title><source>J Orthop Res</source><year>1991</year><volume>9</volume><fpage>465</fpage><lpage>476</lpage><pub-id pub-id-type="pmid">2045973</pub-id><pub-id pub-id-type="doi">10.1002/jor.1100090402</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bosch</surname><given-names>P</given-names></name><name><surname>Musgrave</surname><given-names>DS</given-names></name><name><surname>Lee</surname><given-names>JY</given-names></name><name><surname>Cummins</surname><given-names>J</given-names></name><name><surna