n citation-type="journal"><person-group person-group-type="author"><name><surname>Johansson</surname><given-names>A</given-names></name><name><surname>Farlow</surname><given-names>J</given-names></name><name><surname>Larsson</surname><given-names>P</given-names></name><name><surname>Dukerich</surname><given-names>M</given-names></name><name><surname>Chambers</surname><given-names>E</given-names></name><name><surname>Bystrom</surname><given-names>M</given-names></name><name><surname>Fox</surname><given-names>J</given-names></name><name><surname>Chu</surname><given-names>M</given-names></name><name><surname>Forsman</surname><given-names>M</given-names></name><name><surname>Sjostedt</surname><given-names>A</given-names></name><etal></etal></person-group><article-title>Worldwide genetic relationships among <italic>Francisella tularensis </italic>isolates determined by multiple-locus variable-number tandem repeat analysis</article-title><source>J Bacteriol</source><year>2004</year><volume>186</volume><fpage>5808</fpage><lpage>5818</lpage><pub-id pub-id-type="pmid">15317786</pub-id><pub-id pub-id-type="doi">10.1128/JB.186.17.5808-5818.2004</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schouls</surname><given-names>LM</given-names></name><name><surname>van der Ende</surname><given-names>A</given-names></name><name><surname>Damen</surname><given-names>M</given-names></name><name><surname>van de Pol</surname><given-names>I</given-names></name></person-group><article-title>Multiple-locus variable-number tandem repeat analysis of <italic>Neisseria meningitidis </italic>yields groupings similar to those obtained by multilocus sequence typing</article-title><source>J Clin Microbiol</source><year>2006</year><volume>44</volume><fpage>1509</fpage><lpage>1518</lpage><pub-id pub-id-type="pmid">16597884</pub-id><pub-id pub-id-type="doi">10.1128/JCM.44.4.1509-1518.2006</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johansson</surname><given-names>A</given-names></name><name><surname>Koskiniemi</surname><given-names>S</given-names></name><name><surname>Gottfridsson</surname><given-names>P</given-names></name><name><surname>Wistrom</surname><given-names>J</given-names></name><name><surname>Monsen</surname><given-names>T</given-names></name></person-group><article-title>Multiple-locus variable-number tandem repeat analysis for typing of <italic>Staphylococcus epidermidis</italic></article-title><source>J Clin Microbiol</source><year>2006</year><volume>44</volume><fpage>260</fpage><lpage>265</lpage><pub-id pub-id-type="pmid">16390986</pub-id><pub-id pub-id-type="doi">10.1128/JCM.44.1.260-265.2006</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Top</surname><given-names>J</given-names></name><name><surname>Schouls</surname><given-names>LM</given-names></name><name><surname>Bonten</surname><given-names>MJM</given-names></name><name><surname>Willems</surname><given-names>RJL</given-names></name></person-group><article-title>Multiple-locus variable-number tandem repeat analysis, a novel typing scheme to study the genetic relatedness and epidemiology of <italic>Enterococcus faecium </italic>isolates</article-title><source>J Clin Microbiol</source><year>2004</year><volume>42</volume><fpage>4503</fpage><lpage>4511</lpage><pub-id pub-id-type="pmid">15472301</pub-id><pub-id pub-id-type="doi">10.1128/JCM.42.10.4503-4511.2004</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Titze-de-Almeida</surname><given-names>R</given-names></name><name><surname>Willems</surname><given-names>RJL</given-names></name><name><surname>Top</surname><given-names>J</given-names></name><name><surname>Rodrigues</surname><given-names>IP</given-names></name><name><su