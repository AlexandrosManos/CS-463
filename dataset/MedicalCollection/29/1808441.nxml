rce><year>1996</year><volume>128</volume><fpage>S8</fpage><lpage>S13</lpage><pub-id pub-id-type="doi">10.1016/S0022-3476(96)70003-3</pub-id></citation></ref><ref id="B17"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Wilton</surname><given-names>P</given-names></name></person-group><article-title>K I G S: Adverse Events Report No 11. Pharmacia International growth Database. To August 2000</article-title></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Quigley</surname><given-names>C</given-names></name><name><surname>Gill</surname><given-names>A</given-names></name><name><surname>Crowe</surname><given-names>B</given-names></name><name><surname>Robling</surname><given-names>K</given-names></name><name><surname>Chipman</surname><given-names>J</given-names></name><name><surname>Rose</surname><given-names>S</given-names></name><name><surname>Ross</surname><given-names>J</given-names></name><name><surname>Cassoria</surname><given-names>F</given-names></name><name><surname>Wolka</surname><given-names>A</given-names></name><name><surname>Wit</surname><given-names>J</given-names></name><name><surname>Rekers-Mambarg</surname><given-names>L</given-names></name><name><surname>Cutler</surname><given-names>G</given-names></name></person-group><article-title>Safety of growth hormone treatment in pediatric patients with idiopathic stature</article-title><source>J Clin Endocrinol Metab</source><year>2005</year><volume>90</volume><fpage>5188</fpage><lpage>5196</lpage><pub-id pub-id-type="pmid">15899952</pub-id><pub-id pub-id-type="doi">10.1210/jc.2004-2543</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tolo</surname><given-names>V</given-names></name></person-group><article-title>Spinal deformity in short-stature syndromes</article-title><source>Instr Course Lect</source><year>1990</year><volume>39</volume><fpage>399</fpage><lpage>405</lpage><pub-id pub-id-type="pmid">2186130</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lippe</surname><given-names>B</given-names></name></person-group><article-title>Turner Syndrome</article-title><source>Endocrinology and Metabolism Clinics of North America</source><year>1991</year><volume>20</volume><fpage>121</fpage><lpage>152</lpage><pub-id pub-id-type="pmid">2029883</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>J</given-names></name><name><surname>Rosenfeld</surname><given-names>S</given-names></name><name><surname>Keyak</surname><given-names>J</given-names></name></person-group><article-title>Increased prevalence of scoliosis in Turner Syndrome</article-title><source>J Ped Orthop</source><year>2001</year><fpage>765</fpage><lpage>766</lpage><pub-id pub-id-type="doi">10.1097/00004694-200111000-00012</pub-id></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>DW</given-names></name><name><surname>Jones</surname><given-names>KL</given-names></name></person-group><source>Recognizable Patterns of Human Malformation</source><year>1988</year><edition>Third</edition><publisher-name>W B Saunders Company</publisher-name><fpage>72</fpage></citation></ref></ref-list></back></article>