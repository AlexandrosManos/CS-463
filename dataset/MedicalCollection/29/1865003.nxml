colspan="1">1.11</td><td align="char" char="." rowspan="1" colspan="1"><bold>1.33</bold></td></tr><tr><td align="left" rowspan="1" colspan="1">147</td><td align="char" char="." rowspan="1" colspan="1">1739.90</td><td align="left" rowspan="1" colspan="1">912</td><td align="left" rowspan="1" colspan="1"><italic>cis</italic>-aconitic acid</td><td align="char" char="." rowspan="1" colspan="1">1.87</td><td align="char" char="." rowspan="1" colspan="1">1.46</td><td align="char" char="." rowspan="1" colspan="1">0.81</td><td align="char" char="." rowspan="1" colspan="1">0.75</td></tr><tr><td align="left" rowspan="1" colspan="1">338</td><td align="char" char="." rowspan="1" colspan="1">2055.40</td><td align="left" rowspan="1" colspan="1">665</td><td align="left" rowspan="1" colspan="1"><italic>cis</italic>-sinapic acid</td><td align="char" char="." rowspan="1" colspan="1">1.26</td><td align="char" char="." rowspan="1" colspan="1"><bold>1.51</bold></td><td align="char" char="." rowspan="1" colspan="1">1.23</td><td align="char" char="." rowspan="1" colspan="1">1.31</td></tr><tr><td align="left" rowspan="1" colspan="1">273</td><td align="char" char="." rowspan="1" colspan="1">1803.35</td><td align="left" rowspan="1" colspan="1">973</td><td align="left" rowspan="1" colspan="1">Citric acid</td><td align="char" char="." rowspan="1" colspan="1"><bold>0.72</bold></td><td align="char" char="." rowspan="1" colspan="1"><bold>0.66</bold></td><td align="char" char="." rowspan="1" colspan="1">0.88</td><td align="char" char="." rowspan="1" colspan="1">0.85</td></tr><tr><td align="left" rowspan="1" colspan="1">157</td><td align="char" char="." rowspan="1" colspan="1">1839.40</td><td align="left" rowspan="1" colspan="1">974</td><td align="left" rowspan="1" colspan="1">Dehydroascorbic acid</td><td align="char" char="." rowspan="1" colspan="1">1.40</td><td align="char" char="." rowspan="1" colspan="1"><bold>2.42</bold></td><td align="char" char="." rowspan="1" colspan="1">1.69</td><td align="c