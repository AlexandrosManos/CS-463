>20</volume><issue>3</issue><fpage>539</fpage><lpage>544</lpage><pub-id pub-id-type="pmid">12358326</pub-id><pub-id pub-id-type="doi">10.1183/09031936.02.00532002</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Landbo</surname><given-names>C</given-names></name><name><surname>Prescott</surname><given-names>E</given-names></name><name><surname>Lange</surname><given-names>P</given-names></name><name><surname>Vestbo</surname><given-names>J</given-names></name><name><surname>Almdal</surname><given-names>TP</given-names></name></person-group><article-title>Prognostic value of nutritional status in chronic obstructive pulmonary disease</article-title><source>Am J Respir Crit Care Med</source><year>1999</year><volume>160</volume><issue>6</issue><fpage>1856</fpage><lpage>1861</lpage><pub-id pub-id-type="pmid">10588597</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schols</surname><given-names>AM</given-names></name><name><surname>Slangen</surname><given-names>J</given-names></name><name><surname>Volovics</surname><given-names>L</given-names></name><name><surname>Wouters</surname><given-names>EF</given-names></name></person-group><article-title>Weight loss is a reversible factor in the prognosis of chronic obstructive pulmonary disease</article-title><source>Am J Respir Crit Care Med</source><year>1998</year><volume>157</volume><issue>6 Pt 1</issue><fpage>1791</fpage><lpage>1797</lpage><pub-id pub-id-type="pmid">9620907</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamilton</surname><given-names>AL</given-names></name><name><surname>Killian</surname><given-names>KJ</given-names></name><name><surname>Summers</surname><given-names>E</given-names></name><name><surname>Jones</surname><given-names>NL</given-names></name></person-group><artic