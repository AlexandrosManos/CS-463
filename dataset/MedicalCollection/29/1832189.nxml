></name><name><surname>Lacquet</surname><given-names>LM</given-names></name><name><surname>Fagard</surname><given-names>R</given-names></name><name><surname>Rogiers</surname><given-names>P</given-names></name></person-group><article-title>Corticosteroids contribute to muscle weakness in chronic airflow obstruction</article-title><source>Am J Respir Crit Care Med</source><year>1994</year><volume>150</volume><issue>1</issue><fpage>11</fpage><lpage>16</lpage><pub-id pub-id-type="pmid">8025735</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hopkinson</surname><given-names>NS</given-names></name><name><surname>Nickol</surname><given-names>AH</given-names></name><name><surname>Payne</surname><given-names>J</given-names></name><name><surname>Hawe</surname><given-names>E</given-names></name><name><surname>Man</surname><given-names>WD</given-names></name><name><surname>Moxham</surname><given-names>J</given-names></name><name><surname>Montgomery</surname><given-names>H</given-names></name><name><surname>Polkey</surname><given-names>MI</given-names></name></person-group><article-title>Angiotensin converting enzyme genotype and strength in chronic obstructive pulmonary disease</article-title><source>Am J Respir Crit Care Med</source><year>2004</year><volume>170</volume><issue>4</issue><fpage>395</fpage><lpage>399</lpage><pub-id pub-id-type="pmid">15117739</pub-id><pub-id pub-id-type="doi">10.1164/rccm.200304-578OC</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hopkinson</surname><given-names>NS</given-names></name><name><surname>Eleftheriou</surname><given-names>KI</given-names></name><name><surname>Payne</surname><given-names>J</given-names></name><name><surname>Nickol</surname><given-names>AH</given-names></name><name><surname>Hawe</surname><given-names>E</given-names></name><name><surname>Moxham</surname><given-nam