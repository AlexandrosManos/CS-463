lpage>870</lpage><pub-id pub-id-type="doi">10.1034/j.1600-0889.1999.t01-4-00001.x</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Janssens</surname><given-names>IA</given-names></name><name><surname>Freibauer</surname><given-names>A</given-names></name><name><surname>Ciais</surname><given-names>P</given-names></name><name><surname>Smith</surname><given-names>P</given-names></name><name><surname>Nabuurs</surname><given-names>GJ</given-names></name><name><surname>Folberth</surname><given-names>G</given-names></name><name><surname>Schlamadinger</surname><given-names>B</given-names></name><name><surname>Hutjes</surname><given-names>RWA</given-names></name><name><surname>Ceulemans</surname><given-names>R</given-names></name><name><surname>Schulze</surname><given-names>ED</given-names></name><name><surname>Valentini</surname><given-names>R</given-names></name><name><surname>Dolman</surname><given-names>AJ</given-names></name></person-group><article-title>Europe's terrestrial biosphere absorbs 7 to 12% of European anthropogenic CO2 emissions</article-title><source>Science</source><year>2003</year><volume>300</volume><fpage>1538</fpage><lpage>1542</lpage><pub-id pub-id-type="pmid">12764201</pub-id><pub-id pub-id-type="doi">10.1126/science.1083592</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maksyutov</surname><given-names>S</given-names></name><name><surname>Machida</surname><given-names>T</given-names></name><name><surname>Mukai</surname><given-names>H</given-names></name><name><surname>Patra</surname><given-names>PK</given-names></name><name><surname>Nakazawa</surname><given-names>T</given-names></name><name><surname>Inoue</surname><given-names>G</given-names></name></person-group><article-title>Effect of recent observations on Asian CO2 flux estimates by transport model inversions</article-title><source>Tellu