rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">8294</td><td align="center" rowspan="1" colspan="1">5140</td><td align="center" rowspan="1" colspan="1">2444</td><td align="center" rowspan="1" colspan="1">976</td></tr><tr><td rowspan="1" colspan="1">Total</td><td align="center" rowspan="1" colspan="1">142</td><td align="center" rowspan="1" colspan="1">156406</td><td align="center" rowspan="1" colspan="1">80369</td><td align="center" rowspan="1" colspan="1">59474</td><td align="center" rowspan="1" colspan="1">18765</td></tr></tbody></table></table-wrap><table-wrap id="T2" position="float"><label>Table 2</label><caption><title>Number of ortholog sets sharing sequences across stress conditions</title></caption><table frame="hsides" rules="groups"><thead><tr><th align="center" valign="top" rowspan="1" colspan="1">Stress Condition</th><th align="center" valign="top" rowspan="1" colspan="1">Number of tentative ortholog sets</th></tr></thead><tbody><tr><td rowspan="1" colspan="1">Heat + Cold</td><td align="center" rowspan="1" colspan="1">91</td></tr><tr><td rowspan="1" colspan="1">Heat + Dehydration</td><td align="center" rowspan="1" colspan="1">1171</td></tr><tr><td rowspan="1" colspan="1">Heat + Salt</td><td align="center" rowspan="1" colspan="1">69</td></tr><tr><td rowspan="1" colspan="1">Cold + Dehydration</td><td align="center" rowspan="1" colspan="1">6851</td></tr><tr><td rowspan="1" colspan="1">Cold + Salt</td><td align="center" rowspan="1" colspan="1">348</td></tr><tr><td rowspan="1" colspan="1">Dehydration + Salt</td><td align="center" rowspan="1" colspan="1">3304</td></tr><tr><td rowspan="1" colspan="1">Heat + Cold + Dehydration</td><td align="center" rowspan="1" colspan="1">2105</td></tr><tr><td rowspan="1" colspan="1">Heat + Dehydration + Salt</td><td align="center" rowspan="1" colspan="1">2323</td></tr><tr><td rowspan="1" colspan="1">Cold + Dehydration + Salt</td><td align="center" rowspan="1" colspan="1">10416</td></tr><tr><td rowspan="1" colspan="1">Heat + Cold + Salt</td><td align="center" rowspan="1" colspan="1">371</td></tr><tr><td rowspan="1" colspan="1">Heat + Cold + Salt + Dehydration</td><td align="center" rowspan="1" colspan="1">8390</td></tr></tbody></table></table-wrap><fig id="F1" position="float"><label>Figure 1</label><caption><p>Screen captures of the database GUI. (A) Home page, (B) plant species covered in the current version of the        database, (C - H) query pages</p></caption><graphic xlink:href="97320630001225F1"/></fig></sec><fn-group><fn id="FN1" fn-type="other"><p>      <bold>Citation:</bold>Balaji <italic>et al.</italic>,  Bioinformation 1(6): 225-227 (2006)</p></fn></fn-group></back></article>