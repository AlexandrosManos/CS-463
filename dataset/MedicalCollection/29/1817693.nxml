e>Nat Med</source><volume>5</volume><issue>3</issue><fpage>280</fpage><lpage>285</lpage><pub-id pub-id-type="pmid">10086382</pub-id></citation></ref><ref id="b12-ehp0115-000243"><citation citation-type="journal"><person-group><name><surname>Crawford</surname><given-names>ED</given-names></name></person-group><year>2003</year><article-title>Epidemiology of prostate cancer</article-title><source>Urology</source><volume>62</volume><issue>suppl 1</issue><fpage>3</fpage><lpage>12</lpage><pub-id pub-id-type="pmid">14706503</pub-id></citation></ref><ref id="b13-ehp0115-000243"><citation citation-type="journal"><person-group><name><surname>Culig</surname><given-names>Z</given-names></name></person-group><year>2004</year><article-title>Androgen receptor cross-talk with cell signaling pathways</article-title><source>Growth Factors</source><volume>22</volume><issue>3</issue><fpage>179</fpage><lpage>184</lpage><pub-id pub-id-type="pmid">15518241</pub-id></citation></ref><ref id="b14-ehp0115-000243"><citation citation-type="journal"><person-group><name><surname>Culig</surname><given-names>Z</given-names></name><name><surname>Bartsch</surname><given-names>G</given-names></name></person-group><year>2006</year><article-title>Androgen axis in prostate cancer</article-title><source>J Cell Biochem</source><volume>99</volume><issue>2</issue><fpage>373</fpage><lpage>381</lpage><pub-id pub-id-type="pmid">16598769</pub-id></citation></ref><ref id="b15-ehp0115-000243"><citation citation-type="journal"><person-group><name><surname>Culig</surname><given-names>Z</given-names></name><name><surname>Hobisch</surname><given-names>A</given-names></name><name><surname>Cronauer</surname><given-names>MV</given-names></name><name><surname>Radmayr</surname><given-names>C</given-names></name><name><surname>Trapman</surname><given-names>J</given-names></name><name><surname>Hittmair</surname><given-names>A</given-names></name><etal/></person-group><year>1994</year><article-title>Androgen receptor activati