" colspan="1">85</td><td align="right" rowspan="1" colspan="1">39</td><td align="right" rowspan="1" colspan="1">33</td><td align="right" rowspan="1" colspan="1">94</td><td align="center" rowspan="1" colspan="1">49.3 &#x000b1; 22.8</td><td align="center" rowspan="1" colspan="1">7.3 &#x000b1; 5.0</td><td align="center" rowspan="1" colspan="1">31.2 &#x000b1; 16.1</td></tr><tr><td align="left" rowspan="1" colspan="1">J</td><td align="right" rowspan="1" colspan="1">4</td><td align="right" rowspan="1" colspan="1">6</td><td align="right" rowspan="1" colspan="1">NA</td><td align="right" rowspan="1" colspan="1">NA</td><td align="right" rowspan="1" colspan="1">NA</td><td align="right" rowspan="1" colspan="1">NA</td><td align="right" rowspan="1" colspan="1">NA</td><td align="center" rowspan="1" colspan="1">NA</td><td align="center" rowspan="1" colspan="1">6.2 &#x000b1; 2.5</td><td align="center" rowspan="1" colspan="1">15.2 &#x000b1; 9.4</td></tr></tbody></table><table-wrap-foot><fn id="tfn1-ehp0115-000182"><p>NA, not available; data were lost through instrument malfunction, and sufficient sample for a rerun was not available. Data on food intake are reported as percentage of recommended intake by the <xref ref-type="bibr" rid="b43-ehp0115-000182">USDA (2006)</xref>.</p></fn><fn id="tfn2-ehp0115-000182"><label>a</label><p>Subject uses reverse osmosis water.</p></fn></table-wrap-foot></table-wrap></sec><ref-list><title>References</title><ref id="b1-ehp0115-000182"><citation citation-type="other"><collab>Almstr&#x000f6;m P</collab> 2006. The Interplay between Iodine and Perchlorate in the Human Body [Master&#x02019;s thesis]. Stockholm:University of Stockholm, Sweden. E309 in Optimization and Systems Theory.</citation></ref><ref id="b2-ehp0115-000182"><citation citation-type="journal"><person-group><name><surname>Arcus-Arth</surname><given-names>A</given-names></name><name><surname>Krowech</surname><given-names>G</given-names></name><name><surname>Zeise</surname><given-names>L</