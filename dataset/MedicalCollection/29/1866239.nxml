d><td></td></tr><tr><td align="left">&#x0003e; 60</td><td></td><td></td><td align="center">31</td><td align="center">4.6</td><td align="center">100</td><td align="center">17.4</td><td align="center">125</td><td align="center">20.8</td><td></td></tr><tr><td align="left" colspan="10">Quality of the time spent in the waiting room</td></tr><tr><td align="left">Unacceptable</td><td align="center">1834</td><td align="center">93.9</td><td align="center">28</td><td align="center">4.2</td><td align="center">68</td><td align="center">12.0</td><td align="center">119</td><td align="center">20.1</td><td align="center">&#x0003c; 0.0001</td></tr><tr><td align="left">Poor</td><td></td><td></td><td align="center">84</td><td align="center">12.4</td><td align="center">120</td><td align="center">21.2</td><td align="center">128</td><td align="center">21.7</td><td></td></tr><tr><td align="left">Good</td><td></td><td></td><td align="center">439</td><td align="center">64.8</td><td align="center">271</td><td align="center">47.9</td><td align="center">290</td><td align="center">49.1</td><td></td></tr><tr><td align="left">Very good</td><td></td><td></td><td align="center">126</td><td align="center">18.6</td><td align="center">107</td><td align="center">18.9</td><td align="center">54</td><td align="center">9.1</td><td></td></tr><tr><td align="left" colspan="10">Confidentiality and privacy of the clinic personnel</td></tr><tr><td align="left">Poor</td><td align="center">1873</td><td align="center">95.9</td><td align="center">34</td><td align="center">4.9</td><td align="center">101</td><td align="center">17.2</td><td align="center">149</td><td align="center">25.0</td><td align="center">&#x0003c; 0.0001</td></tr><tr><td align="left">Good</td><td></td><td></td><td align="center">293</td><td align="center">42.5</td><td align="center">236</td><td align="center">40.1</td><td align="center">259</td><td align="center">43.5</td><td></td></tr><tr><td align="left">Very good</td><td></td><td></td><td align