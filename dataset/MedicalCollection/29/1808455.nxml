r"><name><surname>Smirk</surname><given-names>C</given-names></name><name><surname>Morris</surname><given-names>H</given-names></name></person-group><article-title>The anatomy and reconstruction of the patellofemoral ligament</article-title><source>The Knee</source><year>2003</year><volume>10</volume><fpage>221</fpage><lpage>227</lpage><pub-id pub-id-type="pmid">12893143</pub-id><pub-id pub-id-type="doi">10.1016/S0968-0160(03)00038-3</pub-id></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bicos</surname><given-names>J</given-names></name><name><surname>Carofino</surname><given-names>B</given-names></name><name><surname>Andersen</surname><given-names>M</given-names></name><name><surname>Schepsis</surname><given-names>AA</given-names></name><name><surname>Fulkerson</surname><given-names>JP</given-names></name><name><surname>Mazzocca</surname><given-names>A</given-names></name></person-group><article-title>Patellofemoral forces after medial patellofemoral ligament reconstruction</article-title><source>J Knee Surg</source><year>2006</year><volume>19</volume><fpage>317</fpage><lpage>326</lpage><pub-id pub-id-type="pmid">17080655</pub-id></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ma</surname><given-names>CB</given-names></name><name><surname>Francis</surname><given-names>K</given-names></name><name><surname>Towers</surname><given-names>J</given-names></name><name><surname>Irrgang</surname><given-names>J</given-names></name><name><surname>Fu</surname><given-names>FH</given-names></name><name><surname>Harner</surname><given-names>CH</given-names></name></person-group><article-title>Hamstring anterior cruciate reconstruction: a comparison of bioabsorbable interference screw and endobutton-post fixation</article-title><source>Arthroscopy</source><year>2004</year><volume>20</volume><fpage>122</fpage><lpage>128</lpage><pub-id pub-id-type="pmid">14760343</pub-id></citation></ref><ref id="B33"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Elias</surname><given-names>JJ</given-names></name><name><surname>Cosgarea</surname><given-names>AJ</given-names></name></person-group><article-title>Technical errors during medial patellofemoral ligament reconstruction could overload medial patellofemoral cartilage</article-title><source>Am J Sport Med</source><year>2006</year><volume>34</volume><fpage>1478</fpage><lpage>1485</lpage><pub-id pub-id-type="doi">10.1177/0363546506287486</pub-id></citation></ref><ref id="B34"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ellera Gomes</surname><given-names>JL</given-names></name><name><surname>Marczyk</surname><given-names>LRS</given-names></name><name><surname>de Cesar</surname><given-names>PC</given-names></name><name><surname>Jungblut</surname><given-names>CF</given-names></name></person-group><article-title>Medial patellofemoral ligament reconstraction with semitendinous autograft for chronic patellar instability: a follow study</article-title><source>Arthroscopy</source><year>2004</year><volume>20</volume><fpage>147</fpage><lpage>151</lpage><pub-id pub-id-type="pmid">14760346</pub-id></citation></ref></ref-list><sec sec-type="display-objects"><title>Figures and Tables</title><fig position="float" id="F1"><label>Figure 1</label><caption><p>Examination under anaesthesia revealing marked patella instability.</p></caption><graphic xlink:href="1471-2474-8-22-1"/></fig><fig position="float" id="F2"><label>Figure 2</label><caption><p>Following medial and lateral parapatellar incisions, the patella is stabilised using a large clamp on the right of the figure. Tunnels are produced by sequential drill holes in the superior half of the patella, 1 cm apart.</p></caption><graphic xlink:href="1471-2474-8-22-2"/></fig><fig position="float" id="F3"><label>Figure 3</label><caption><p>A Beath pin is used to pass a Vicryl loop through the patella tunnels.</p></caption><graphic xlink:href="1471-2474-8-22-3"/></fig><fig position="float" id="F4"><label>Figure 4</label><caption><p>The graft is passed through the tunnels, laterally then medially.</p></caption><graphic xlink:href="1471-2474-8-22-4"/></fig><fig position="float" id="F5"><label>Figure 5</label><caption><p>The medial epicondyle is exposed and the Beath pin is placed across the transepicondylar axis and a tunnel is drilled to accommodate and secure both ends of the graft. The graft is passed between the second and third layers of the knee.</p></caption><graphic xlink:href="1471-2474-8-22-5"/></fig><fig position="float" id="F6"><label>Figure 6</label><caption><p>The graft is pulled into the tunnel using Vicryl through the eye of the Beath pin.</p></caption><graphic xlink:href="1471-2474-8-22-6"/></fig><fig position="float" id="F7"><label>Figure 7</label><caption><p>After cycling the knee through a full range of movements to allow graft tension to settle, the graft is secured using an interference fit screw.</p></caption><graphic xlink:href="1471-2474-8-22-7"/></fig><fig position="float" id="F8"><label>Figure 8</label><caption><p>The improved stability of the patella is confirmed.</p></caption><graphic xlink:href="1471-2474-8-22-8"/></fig></sec></back></article>