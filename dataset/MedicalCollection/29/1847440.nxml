n-type="journal"><person-group person-group-type="author"><name><surname>Parron</surname><given-names>C</given-names></name><name><surname>Poucet</surname><given-names>B</given-names></name><name><surname>Save</surname><given-names>E</given-names></name></person-group><article-title>Entorhinal cortex lesions impair the use of distal but not proximal landmarks during place navigation in the rat.</article-title><source>Behavioural Brain Research</source><year>2004</year><volume>154</volume><fpage>345</fpage><lpage>352</lpage><pub-id pub-id-type="pmid">15313022</pub-id><pub-id pub-id-type="doi">10.1016/j.bbr.2004.03.006</pub-id></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Whishaw</surname><given-names>IQ</given-names></name><name><surname>Gharbawie</surname><given-names>OM</given-names></name><name><surname>Clark</surname><given-names>BJ</given-names></name><name><surname>Lehmann</surname><given-names>H</given-names></name></person-group><article-title>The exploratory behavior of rats in an open environment optimizes security</article-title><source>Behavioural Brain Research</source><year>2006</year><volume>171</volume><fpage>230</fpage><lpage>239</lpage><pub-id pub-id-type="pmid">16678279</pub-id><pub-id pub-id-type="doi">10.1016/j.bbr.2006.03.037</pub-id></citation></ref><ref id="B32"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Thinus-Blanc</surname><given-names>C</given-names></name><name><surname>Save</surname><given-names>E</given-names></name><name><surname>Poucet</surname><given-names>B</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Foreman N and Gillet R</surname></name></person-group><article-title>Animal spatial cognition and exploration</article-title><source>A Handbook of Spatial Research Paradigms and Methodology</source><year>1998</year><publisher-name>East Sussex, England, Psychology Press</pub