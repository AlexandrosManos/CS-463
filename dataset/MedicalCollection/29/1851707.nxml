s></name></person-group><article-title>Why do parents decide against immunization? The effect of health beliefs and health professionals</article-title><source>Child: care, health and development</source><year>2003</year><volume>29</volume><fpage>303</fpage><lpage>311</lpage><pub-id pub-id-type="pmid">12823336</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2214.2003.00347.x</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Evans</surname><given-names>M</given-names></name><name><surname>Stoddart</surname><given-names>H</given-names></name><name><surname>Condon</surname><given-names>L</given-names></name><name><surname>Freeman</surname><given-names>E</given-names></name><name><surname>Grizzell</surname><given-names>M</given-names></name><name><surname>Mullen</surname><given-names>R</given-names></name></person-group><article-title>Parents' perspectives on the MMR immunisation: a focus group study</article-title><source>British Journal of General Practice</source><year>2003</year><volume>51</volume><fpage>904</fpage><lpage>910</lpage><pub-id pub-id-type="pmid">11761204</pub-id></citation></ref><ref id="B10"><citation citation-type="other"><article-title>GPs demand medical chiefs quit over MMR. </article-title><source>Guardian, June 13 2003</source></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hargreaves</surname><given-names>I</given-names></name><name><surname>Lewis</surname><given-names>J</given-names></name><name><surname>Speers</surname><given-names>T</given-names></name></person-group><source>Towards a better map:  Science, the public and the media</source><year>2003</year><publisher-name>Cardiff , Cardiff University</publisher-name></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clements</surname><given-names>CJ</given-names></name><name><surname>Ratzan</surname><given-names>S</given-names></name></person-group><article-title>Misled and confused?  Telling the public about MMR vaccine safety</article-title><source>Journal of Medical Ethics</source><year>2003</year><volume>29</volume><fpage>22</fpage><lpage>26</lpage><pub-id pub-id-type="pmid">12569190</pub-id><pub-id pub-id-type="doi">10.1136/jme.29.1.22</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bellaby</surname><given-names>P</given-names></name></person-group><article-title>Communication and miscommunication of risk:  understanding UK parents' attitudes to combined MMR vaccination</article-title><source>British Medical Journal</source><year>2003</year><volume>327</volume><fpage>725</fpage><lpage>727</lpage><pub-id pub-id-type="pmid">14512482</pub-id><pub-id pub-id-type="doi">10.1136/bmj.327.7417.725</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burgess</surname><given-names>DC</given-names></name><name><surname>Burgess</surname><given-names>MA</given-names></name><name><surname>Leask</surname><given-names>JA</given-names></name></person-group><article-title>The MMR vaccination and autism controversy in United Kigdom 1998-2005:  Inevitable community outrage or a failure of risk communication?</article-title><source>Vaccine</source><year>2006</year><volume>24</volume><fpage>3921</fpage><lpage>3928</lpage><pub-id pub-id-type="pmid">16564116</pub-id><pub-id pub-id-type="doi">10.1016/j.vaccine.2006.02.033</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Poortinga</surname><given-names>W</given-names></name><name><surname>Bickerstaff</surname><given-names>K</given-names></name><name><surname>Langford</surname><given-names>I</given-names></name><name><surname>Niewohner</surname><given-names>J</given-names></name>