c>03, 58</italic></bold></td><td align="right">2/258</td><td align="center">0.009</td></tr></tbody></table><table-wrap-foot><p><sup>1</sup>Frequency (f)</p><p><sup>2</sup>Probability (p)</p><p>Not significant (ns)</p></table-wrap-foot></table-wrap><table-wrap position="float" id="T3"><label>Table 3</label><caption><p>Haplotype statistical analysis for Panel 3, extending haplotypes into the complotype and HLA-DRB1 regions.</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="center"><bold><italic>HLA-A*</italic></bold></td><td align="center"><bold><italic>HLA-E*</italic></bold></td><td align="center"><bold><italic>HLA-Cw*/B*</italic></bold></td><td align="center"><bold><italic>Complotype</italic></bold></td><td align="center"><bold><italic>HLA-DRB1*</italic></bold></td><td align="center"><bold>f</bold><sup>1</sup></td><td align="center"><bold>P</bold><sup>2</sup></td><td align="center"><bold><italic>HLA-E*</italic></bold></td><td align="center"><bold><italic>HLA-Cw*/B*</italic></bold></td><td align="center"><bold><italic>Complotype</italic></bold></td><td align="center"><bold><italic>HLA-DRB1*</italic></bold></td><td align="center"><bold>f</bold><sup>1</sup></td><td align="center"><bold>P</bold><sup>2</sup></td></tr></thead><tbody><tr><td align="center"><bold><italic>01</italic></bold></td><td align="center"><bold><italic>0101</italic></bold></td><td align="center"><bold><italic>07, 08</italic></bold></td><td align="center"><bold><italic>SC01</italic></bold></td><td align="center"><bold><italic>03</italic></bold></td><td align="right">41/256</td><td align="center">&#x0003c; 1 &#x000d7; 10<sup>-7</sup></td><td align="center"><bold><italic>0101</italic></bold></td><td align="center"><bold><italic>07, 08</italic></bold></td><td align="center"><bold><italic>SC01</italic></bold></td><td align="center"><bold><italic>03</italic></bold></td><td align="right">48/258</td><td align="center">1 &#x000d7; 10<sup>-5</sup></td></tr><tr><td align="center"><bold><it