e><pub-id pub-id-type="pmid">15889621</pub-id></citation></ref><ref id="B23"><label>23</label><citation citation-type="journal"><person-group><name><surname>Piccirillo</surname><given-names>SGM</given-names></name><name><surname>Vescovi A</surname><given-names>L</given-names></name></person-group><article-title>Bone morphogenetic proteins inhibit the tumorigenic potential of human brain tumour-initiating cells</article-title><source>Nature</source><year>2006</year><volume>444</volume><fpage>761</fpage><lpage>765</lpage><pub-id pub-id-type="pmid">17151667</pub-id></citation></ref><ref id="B24"><label>24</label><citation citation-type="journal"><person-group><name><surname>Vescovi A</surname><given-names>L</given-names></name><name><surname>Galli</surname><given-names>R</given-names></name></person-group><article-title>and Reynolds B A. Brain tumour stem cells. Nature Rev</article-title><source>Cancer</source><year>2006</year><volume>6</volume><fpage>425</fpage><lpage>436</lpage><pub-id pub-id-type="pmid">16723989</pub-id></citation></ref><ref id="B25"><label>25</label><citation citation-type="journal"><person-group><name><surname>Ingram</surname><given-names>DK</given-names></name><name><surname>Zhu</surname><given-names>M</given-names></name><name><surname>Mamczarz</surname><given-names>J</given-names></name><name><surname>Zou</surname><given-names>S</given-names></name><name><surname>Lane</surname><given-names>MA</given-names></name><name><surname>Roth</surname><given-names>GS</given-names></name><name><surname>deCabo</surname><given-names>R</given-names></name></person-group><article-title>Calorie restriction mimetics: an emerging research field</article-title><source>Aging Cell</source><year>2006</year><volume>5</volume><issue>2</issue><fpage>97</fpage><lpage>108</lpage><pub-id pub-id-type="pmid">16626389</pub-id></citation></ref><ref id="B26"><label>26</label><citation citation-type="journal"><person-group><name><surname>Keilbronn</surname><given-names>LK</given