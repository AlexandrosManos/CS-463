or"><name><surname>B.N. Fields DMKPMH</surname></name></person-group><article-title>Cytomegaloviruses and their replication</article-title><source>Fields Virology</source><year>1996</year><edition>3rd</edition><publisher-name>New York, Lippincott - Raven Publishers</publisher-name><fpage>2447</fpage><lpage>2492</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bratcher</surname><given-names>DF</given-names></name><name><surname>Bourne</surname><given-names>N</given-names></name><name><surname>Bravo</surname><given-names>FJ</given-names></name><name><surname>Schleiss</surname><given-names>MR</given-names></name><name><surname>Slaoui</surname><given-names>M</given-names></name><name><surname>Myers</surname><given-names>MG</given-names></name><name><surname>Bernstein</surname><given-names>DI</given-names></name></person-group><article-title>Effect of passive antibody on congenital cytomegalovirus infection in guinea pigs</article-title><source>J Infect Dis</source><year>1995</year><volume>172</volume><fpage>944</fpage><lpage>950</lpage><pub-id pub-id-type="pmid">7561214</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harrison</surname><given-names>CJ</given-names></name><name><surname>Burger</surname><given-names>R</given-names></name></person-group><article-title>Low maternal CD4 count at inception of gestational cytomegalovirus (CMV) infection and impaired humoral response: effect on congenital CMV infection in the guinea pig</article-title><source>Clin Immunol Immunopathol</source><year>1991</year><volume>60</volume><fpage>171</fpage><lpage>180</lpage><pub-id pub-id-type="pmid">1676941</pub-id><pub-id pub-id-type="doi">10.1016/0090-1229(91)90061-E</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Choi</surname><given-names>YC</given-names></name><name><surname>Hsiung</surname><given-names>GD</given-names></name></person-group><article-title>Cytomegalovirus infection in guinea pigs. II. Transplacental and horizontal transmission</article-title><source>J Infect Dis</source><year>1978</year><volume>138</volume><fpage>197</fpage><lpage>202</lpage><pub-id pub-id-type="pmid">210239</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Griffith</surname><given-names>BP</given-names></name><name><surname>Lucia</surname><given-names>HL</given-names></name><name><surname>Hsiung</surname><given-names>GD</given-names></name></person-group><article-title>Brain and visceral involvement during congenital cytomegalovirus infection of guinea pigs</article-title><source>Pediatr Res</source><year>1982</year><volume>16</volume><fpage>455</fpage><lpage>459</lpage><pub-id pub-id-type="pmid">6285263</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bia</surname><given-names>FJ</given-names></name><name><surname>Griffith</surname><given-names>BP</given-names></name><name><surname>Fong</surname><given-names>CK</given-names></name><name><surname>Hsiung</surname><given-names>GD</given-names></name></person-group><article-title>Cytomegaloviral infections in the guinea pig: experimental models for human disease</article-title><source>Rev Infect Dis</source><year>1983</year><volume>5</volume><fpage>177</fpage><lpage>195</lpage><pub-id pub-id-type="pmid">6302812</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Woolf</surname><given-names>NK</given-names></name><name><surname>Koehrn</surname><given-names>FJ</given-names></name><name><surname>Harris</surname><given-names>JP</given-names></name><name><surname>Richman</surname><given-names>DD</given-names></name></person-group><article-title>Congen