F00585056</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clement</surname><given-names>DL</given-names></name><name><surname>Brugmans</surname><given-names>J</given-names></name></person-group><article-title>Reactive hyperemia in patients with intermittent claudication, and correlation with other diagnostic methods</article-title><source>Angiology</source><year>1980</year><volume>31</volume><fpage>189</fpage><lpage>197</lpage><pub-id pub-id-type="pmid">7369549</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bartoli</surname><given-names>V</given-names></name><name><surname>Dorigo</surname><given-names>B</given-names></name><name><surname>Tedeschi</surname><given-names>E</given-names></name><name><surname>Biti</surname><given-names>G</given-names></name><name><surname>Voegelin</surname><given-names>MR</given-names></name></person-group><article-title>Behavior of calf blood flow in normal subjects and in patients with intermittent claudication during a 24-h time span</article-title><source>Chronobiologia</source><year>1975</year><volume>2</volume><fpage>13</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">1192904</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barclay</surname><given-names>JK</given-names></name></person-group><article-title>A delivery-independent blood flow effect on skeletal muscle fatigue</article-title><source>J Appl Physiol</source><year>1986</year><volume>61</volume><fpage>1084</fpage><lpage>1090</lpage><pub-id pub-id-type="pmid">3759747</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tschakovsky</surname><given-names>ME</given-names></name><name><surname>Shoemaker</surname><given-names>JK</given-names></name><name><surname>Hughson</surname><given-names>RL</given-names></name></person-group><article-title>Beat-by-beat forearm blood flow with Doppler ultrasound and strain-gauge plethysmography</article-title><source>J Appl Physiol</source><year>1995</year><volume>79</volume><fpage>713</fpage><lpage>719</lpage><pub-id pub-id-type="pmid">8567508</pub-id></citation></ref></ref-list></back></article>