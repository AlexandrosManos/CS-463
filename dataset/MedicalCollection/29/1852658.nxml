>2.9<xref ref-type="table-fn" rid="tfn3-ehp0115-000648">b</xref> (2.3&#x02013;3.9)</td><td align="center" rowspan="1" colspan="1">0.8 (0.6&#x02013;1.1)</td></tr><tr><td align="left" rowspan="1" colspan="1">DMA (&#x003bc;g/g Cr)</td><td align="center" rowspan="1" colspan="1">408.8<xref ref-type="table-fn" rid="tfn2-ehp0115-000648">a</xref>,<xref ref-type="table-fn" rid="tfn4-ehp0115-000648">c</xref>,<xref ref-type="table-fn" rid="tfn6-ehp0115-000648">e</xref> (329.6&#x02013;507.0)</td><td align="center" rowspan="1" colspan="1">423.2<xref ref-type="table-fn" rid="tfn3-ehp0115-000648">b</xref>,<xref ref-type="table-fn" rid="tfn5-ehp0115-000648">b</xref> (325.8&#x02013;549.7)</td><td align="center" rowspan="1" colspan="1">206.1<xref ref-type="table-fn" rid="tfn2-ehp0115-000648">a</xref>,<xref ref-type="table-fn" rid="tfn5-ehp0115-000648">d</xref> (172.4&#x02013;246.3)</td><td align="center" rowspan="1" colspan="1">163.5<xref ref-type="table-fn" rid="tfn3-ehp0115-000648">b</xref> (137.5&#x02013;194.3)</td><td align="center" rowspan="1" colspan="1">29.3<xref ref-type="table-fn" rid="tfn3-ehp0115-000648">b</xref> (22.0&#x02013;39.0)</td><td align="center" rowspan="1" colspan="1">7.7 (5.4&#x02013;11.1)</td></tr><tr><td align="left" rowspan="1" colspan="1">TAs (&#x003bc;g/g Cr)</td><td align="center" rowspan="1" colspan="1">573.5<xref ref-type="table-fn" rid="tfn2-ehp0115-000648">a</xref>,<xref ref-type="table-fn" rid="tfn4-ehp0115-000648">c</xref>,<xref ref-type="table-fn" rid="tfn6-ehp0115-000648">e</xref> (464.8&#x02013;707.5)</td><td align="center" rowspan="1" colspan="1">631.7<xref ref-type="table-fn" rid="tfn3-ehp0115-000648">b</xref>,<xref ref-type="table-fn" rid="tfn5-ehp0115-000648">d</xref> (485.6&#x02013;821.7)</td><td align="center" rowspan="1" colspan="1">304.8<xref ref-type="table-fn" rid="tfn2-ehp0115-000648">a</xref>,<xref ref-type="table-fn" rid="tfn5-ehp0115-000648">d</xref> (257.4&#x02013;361.1)</td><td align="center" rowspan="1" colspan="1">248.7<xref ref