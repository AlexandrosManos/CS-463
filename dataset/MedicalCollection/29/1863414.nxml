me><surname>Winstead-Fry</surname><given-names>P</given-names></name><name><surname>Schultz</surname><given-names>A</given-names></name></person-group><article-title>Psychometric analysis of the Functional Assessment of Cancer Therapy-General (FACT-G) scale in a rural sample</article-title><source>Cancer</source><year>1997</year><volume>79</volume><fpage>2446</fpage><lpage>2452</lpage><pub-id pub-id-type="pmid">9191537</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1097-0142(19970615)79:12&#x0003c;2446::AID-CNCR23&#x0003e;3.0.CO;2-Q</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kemmler</surname><given-names>G</given-names></name><name><surname>Holzner</surname><given-names>B</given-names></name><name><surname>Kopp</surname><given-names>M</given-names></name><name><surname>Dunser</surname><given-names>M</given-names></name><name><surname>Greil</surname><given-names>R</given-names></name><name><surname>Hahn</surname><given-names>E</given-names></name><name><surname>Sperner-Unterweger</surname><given-names>B</given-names></name></person-group><article-title>Multidimensional scaling as a tool for analysing quality of life data</article-title><source>Qual Life Res</source><year>2002</year><volume>11</volume><fpage>223</fpage><lpage>233</lpage><pub-id pub-id-type="pmid">12074260</pub-id><pub-id pub-id-type="doi">10.1023/A:1015207400490</pub-id></citation></ref><ref id="B9"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Rasch</surname><given-names>G</given-names></name></person-group><source>Probabilistic models for some intelligence and attainment test</source><year>1980</year><publisher-name>Chicago: University of Chicago Press</publisher-name></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dapueto</surname><given-names>JJ</given-names></name><name><surname>Francolino</surname><given-names>C</given-names></name><name><surname>Servente</surname><given-names>L</given-names></name><name><surname>Chang</surname><given-names>CH</given-names></name><name><surname>Gotta</surname><given-names>I</given-names></name><name><surname>Levin</surname><given-names>R</given-names></name><name><surname>del CarmenAbreu</surname><given-names>M</given-names></name></person-group><article-title>Evaluation of the Functional Assessment of Cancer Therapy-General (FACT-G) Spanish Version 4 in South America: Classic psychometric and Item Response Theory analyses</article-title><source>Health Qual Life Outcomes</source><year>2003</year><volume>1</volume><fpage>32</fpage><pub-id pub-id-type="pmid">12969512</pub-id><pub-id pub-id-type="doi">10.1186/1477-7525-1-32</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cook</surname><given-names>KF</given-names></name><name><surname>Rabeneck</surname><given-names>L</given-names></name><name><surname>Campbell</surname><given-names>CJM</given-names></name><name><surname>Wray</surname><given-names>NP</given-names></name></person-group><article-title>Evaluation of a multidimensional measure of dyspepsia-related health for use in a randomized clinical trial</article-title><source>J Clin Epidemiol</source><year>1999</year><volume>52</volume><fpage>381</fpage><lpage>392</lpage><pub-id pub-id-type="pmid">10360332</pub-id><pub-id pub-id-type="doi">10.1016/S0895-4356(99)00018-9</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stucki</surname><given-names>G</given-names></name><name><surname>Daltroy</surname><given-names>L</given-names></name><name><surname>Katz</surname><given-names>JN</given-names></name><name><surname>Johannesson</surname><given-names>M</given-names></name><name><surname>Liang</surname><given-names>MH</given-names></name></person-group><article-title>Interpreta