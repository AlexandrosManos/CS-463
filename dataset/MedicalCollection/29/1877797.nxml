><lpage>1007</lpage><pub-id pub-id-type="pmid">10071295</pub-id></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Ganz</surname><given-names>PA</given-names></name><name><surname>Goodwin</surname><given-names>PJ</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Lipscomb J, Gotay CC, Snyder C</surname></name></person-group><article-title>Quality of Life in Breast Cancer: What Have We Learned and Where Do We Go from Here?</article-title><source>Outcomes Assessment in Cancer: Measures, Methods, and Applications</source><year>2005</year><publisher-name>Cambridge, United Kingdom , Cambridge University Press</publisher-name><fpage>93</fpage><lpage>125</lpage></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Donaldson</surname><given-names>MS</given-names></name></person-group><article-title>Taking stock of health-related quality-of-life measurement in oncology practice in the United States</article-title><source>Journal of the National Cancer Institute Monographs</source><year>2004</year><fpage>155</fpage><lpage>167</lpage><pub-id pub-id-type="pmid">15504926</pub-id><pub-id pub-id-type="doi">10.1093/jncimonographs/lgh017</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goodwin</surname><given-names>PJ</given-names></name><name><surname>Black</surname><given-names>JT</given-names></name><name><surname>Bordeleau</surname><given-names>LJ</given-names></name><name><surname>Ganz</surname><given-names>PA</given-names></name></person-group><article-title>Health-related quality-of-life measurement in randomized clinical trials in breast cancer - Taking stock</article-title><source>Journal of the National Cancer Institute</source><year>2003</year><volume>95</volume><fpage>263</fpage><lpage>281</lpage><pub-id pub-id-type="pmid">12591983</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mandelblatt</surname><given-names>J</given-names></name><name><surname>Armetta</surname><given-names>C</given-names></name><name><surname>Yabroff</surname><given-names>KR</given-names></name><name><surname>Liang</surname><given-names>W</given-names></name><name><surname>Lawrence</surname><given-names>W</given-names></name></person-group><article-title>Descriptive review of the literature on breast cancer outcomes: 1990 through 2000</article-title><source>Journal of the National Cancer Institute Monographs</source><year>2004</year><volume>33</volume><fpage>8</fpage><lpage>44</lpage><pub-id pub-id-type="pmid">15504918</pub-id><pub-id pub-id-type="doi">10.1093/jncimonographs/lgh003</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rosser</surname><given-names>JE</given-names></name><name><surname>Maguire</surname><given-names>P</given-names></name></person-group><article-title>Dilemmas in General-Practice - the Care of the Cancer-Patient</article-title><source>Social Science and Medicine</source><year>1982</year><volume>16</volume><fpage>315</fpage><lpage>322</lpage><pub-id pub-id-type="pmid">7100982</pub-id><pub-id pub-id-type="doi">10.1016/0277-9536(82)90341-0</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maguire</surname><given-names>P</given-names></name></person-group><article-title>Barriers to Psychological Care of the Dying</article-title><source>British Medical Journal</source><year>1985</year><volume>291</volume><fpage>1711</fpage><lpage>1713</lpage><pub-id pub-id-type="pmid">3935253</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schor</surname><given-names>EL</given-names></name><na