"journal"><person-group person-group-type="author"><name><surname>Thomas</surname><given-names>JW</given-names></name><name><surname>Touchman</surname><given-names>JW</given-names></name><name><surname>Blakesley</surname><given-names>RW</given-names></name><name><surname>Bouffard</surname><given-names>GG</given-names></name><name><surname>Beckstrom-Sternberg</surname><given-names>SM</given-names></name><etal/></person-group><year>2003</year><article-title>Comparative analyses of multi-species sequences from targeted genomic regions</article-title><source>Nature</source><volume>424</volume><fpage>788</fpage><lpage>793</lpage><pub-id pub-id-type="pmid">12917688</pub-id></citation></ref><ref id="pcbi-0030074-b018"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Kriegs</surname><given-names>JO</given-names></name><name><surname>Churakov</surname><given-names>G</given-names></name><name><surname>Kiefmann</surname><given-names>M</given-names></name><name><surname>Jordan</surname><given-names>U</given-names></name><name><surname>Brosius</surname><given-names>J</given-names></name><etal/></person-group><year>2006</year><article-title>Retroposed elements as archives for the evolutionary history of placental mammals</article-title><source>PLoS Biol</source><volume>4</volume><elocation-id>e91.</elocation-id></citation></ref><ref id="pcbi-0030074-b019"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bashir</surname><given-names>A</given-names></name><name><surname>Ye</surname><given-names>C</given-names></name><name><surname>Price</surname><given-names>AL</given-names></name><name><surname>Bafna</surname><given-names>V</given-names></name></person-group><year>2005</year><article-title>Orthologous repeats and mammalian phylogenetic inference</article-title><source>Genome Res</source><volume>15</volume><fpage>998</fpage><lpage>1006</lpage><pub-id pub-id-type="pmid">15998912</pub-id></citation></ref>