erson-group><person-group person-group-type="editor"><name><surname>Morse</surname><given-names>RA</given-names></name></person-group><article-title>Antibiotic systems in honey, nectar, and pollen</article-title><source>Honey Bee Pest, Predators, and Diseases</source><year>1997</year><publisher-loc>Medina, OH</publisher-loc><publisher-name>A.I. Root Co.</publisher-name><fpage>455</fpage><lpage>468</lpage></citation></ref><ref id="b14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Casteels-Josson</surname><given-names>K</given-names></name></person-group><article-title>Apidaecin multipeptide precursor structure: a putative mechanism for amplification of the insect antibacterial response</article-title><source>Embo J</source><year>1993</year><volume>12</volume><fpage>1569</fpage><lpage>1578</lpage><pub-id pub-id-type="pmid">8467807</pub-id></citation></ref><ref id="b15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Casteels-Josson</surname><given-names>K</given-names></name></person-group><article-title>Acute transcriptional response of the honeybee peptide-antibiotics gene repertoire and required post-translational conversion of the precursor structures</article-title><source>J Biol Chem</source><year>1994</year><volume>269</volume><fpage>28569</fpage><lpage>28575</lpage><pub-id pub-id-type="pmid">7961803</pub-id></citation></ref><ref id="b16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chang</surname><given-names>CI</given-names></name></person-group><article-title>Structure of tracheal cytotoxin in complex with a heterodimeric pattern-recognition receptor</article-title><source>Science</source><year>2006</year><volume>311</volume><fpage>1761</fpage><lpage>1764</lpage><pub-id pub-id-type="pmid">16556841</pub-id></citation></ref><ref id="b17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>Y</given-names></name></person-group><article-title>Transmission of Kashmir bee virus by the ectoparasitic mite Varroa destructor</article-title><source>Apidologie</source><year>2004</year><volume>35</volume><fpage>441</fpage><lpage>448</lpage></citation></ref><ref id="b18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chenna</surname><given-names>R</given-names></name></person-group><article-title>Multiple sequence alignment with the Clustal series of programs</article-title><source>Nucleic Acids Res</source><year>2003</year><volume>31</volume><fpage>3497</fpage><lpage>3500</lpage><pub-id pub-id-type="pmid">12824352</pub-id></citation></ref><ref id="b19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Christe</surname><given-names>P</given-names></name></person-group><article-title>Evidence for collective medication in ants</article-title><source>Ecol Lett</source><year>2003</year><volume>6</volume><fpage>19</fpage><lpage>22</lpage></citation></ref><ref id="b20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Christophides</surname><given-names>GK</given-names></name></person-group><article-title>Immunity-related genes and gene families in Anopheles gambiae</article-title><source>Science</source><year>2002</year><volume>298</volume><fpage>159</fpage><lpage>165</lpage><pub-id pub-id-type="pmid">12364793</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Christophides</surname><given-names>GK</given-names></name></person-group><article-title>Comparative and functional genomics of the innate immune system in the malaria vector Anopheles gambiae</article-title><source>Immunol Rev</source><year>2004</year><volume>198</volume><fpage>127</fpage><lpage>148</lpage><pub-id pub-id-type="pmid">15199960</pub-id></citation></ref><ref id="b22"><citation c