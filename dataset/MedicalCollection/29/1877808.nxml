up-type="author"><name><surname>Hermsdorfer</surname><given-names>J</given-names></name><name><surname>Hagl</surname><given-names>E</given-names></name><name><surname>Nowak</surname><given-names>DA</given-names></name><name><surname>Marquardt</surname><given-names>C</given-names></name></person-group><article-title>Grip force control during object manipulation in cerebral stroke</article-title><source>Clin Neurophysiol</source><year>2003</year><volume>114</volume><fpage>915</fpage><lpage>929</lpage><pub-id pub-id-type="pmid">12738439</pub-id><pub-id pub-id-type="doi">10.1016/S1388-2457(03)00042-7</pub-id></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Flanagan</surname><given-names>JR</given-names></name><name><surname>Johansson</surname><given-names>RS</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Ramachandran VS</surname></name></person-group><article-title>Hand movements </article-title><source>Ecyclopedia of human brain</source><year>2002</year><volume>2</volume><publisher-name>San Diego, CA , Academic Press</publisher-name><fpage>399</fpage><lpage>414</lpage></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kamper</surname><given-names>DG</given-names></name><name><surname>McKenna-Cole</surname><given-names>AN</given-names></name><name><surname>Kahn</surname><given-names>LE</given-names></name><name><surname>Reinkensmeyer</surname><given-names>DJ</given-names></name></person-group><article-title>Alterations in reaching after stroke and their relation to movement direction and impairment severity</article-title><source>Arch Phys Med Rehabil</source><year>2002</year><volume>83</volume><fpage>702</fpage><lpage>707</lpage><pub-id pub-id-type="pmid">11994811</pub-id><pub-id pub-id-type="doi">10.1053/apmr.2002.32446</pub-id></citation></ref></ref-list></back></article>