tle><source>J Med Chem</source><year>1987</year><volume>30</volume><fpage>1126</fpage><lpage>1135</lpage><pub-id pub-id-type="pmid">3599020</pub-id><pub-id pub-id-type="doi">10.1021/jm00390a003</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hellberg</surname><given-names>S</given-names></name><name><surname>Sj&#x000f6;str&#x000f6;m</surname><given-names>M</given-names></name><name><surname>Wold</surname><given-names>S</given-names></name></person-group><article-title>The prediction of bradykinin potentiating potency of pentapeptides. An example of a peptide quantitative structure-activity relationship.</article-title><source>Acta Chem Scand B</source><year>1986</year><volume>40</volume><fpage>135</fpage><lpage>140</lpage><pub-id pub-id-type="pmid">3705868</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mee</surname><given-names>RP</given-names></name><name><surname>Auton</surname><given-names>TR</given-names></name><name><surname>Morgan</surname><given-names>PJ</given-names></name></person-group><article-title>Design of active analogues of a 15-residue peptide using D-optimal design, QSAR and a combinatorial search algorithm.</article-title><source>J Pept Res</source><year>1997</year><volume>49</volume><fpage>89</fpage><lpage>102</lpage><pub-id pub-id-type="pmid">9128105</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Norinder</surname><given-names>U</given-names></name><name><surname>Rivera</surname><given-names>C</given-names></name><name><surname>Unden</surname><given-names>A</given-names></name></person-group><article-title>A quantitative structure-activity relationship study of some substance P-related peptides. A multivariate approach using PLS and variable selection</article-title><source>J Pept Res</source><year>1997</