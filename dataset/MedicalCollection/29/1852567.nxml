gland Journal of Medicine</source><year>2003</year><volume>348</volume><fpage>538</fpage><lpage>549</lpage><pub-id pub-id-type="pmid">12571262</pub-id><pub-id pub-id-type="doi">10.1056/NEJMra020526</pub-id></citation></ref><ref id="B36"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldstein</surname><given-names>DB</given-names></name><name><surname>Hirschorn</surname><given-names>JN</given-names></name></person-group><article-title>In genetic control of disease, does "race" matter?</article-title><source>Nature Genetics</source><year>2004</year><volume>36</volume><fpage>1243</fpage><lpage>1244</lpage><pub-id pub-id-type="pmid">15565101</pub-id><pub-id pub-id-type="doi">10.1038/ng1204-1243</pub-id></citation></ref><ref id="B37"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Holden</surname><given-names>C</given-names></name></person-group><article-title>Race and medicine</article-title><source>Science</source><year>2003</year><volume>302</volume><fpage>594</fpage><lpage>596</lpage><pub-id pub-id-type="pmid">14576420</pub-id><pub-id pub-id-type="doi">10.1126/science.302.5645.594</pub-id></citation></ref><ref id="B38"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Couzin</surname><given-names>J</given-names></name></person-group><article-title>In asians and whites, gene expression varies by race</article-title><source>Science</source><year>2007</year><volume>315</volume><fpage>173</fpage><lpage>174</lpage><pub-id pub-id-type="pmid">17218500</pub-id><pub-id pub-id-type="doi">10.1126/science.315.5809.173a</pub-id></citation></ref><ref id="B39"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Mayr</surname><given-names>E</given-names></name></person-group><source>What Makes Biology Unique? Considerations on the Autonomy of a Scientific Discipline</source><year>2004</year><publisher-name>Cambridge: Cambridge University Press</publisher-name></citation></ref></ref-list></back></article>