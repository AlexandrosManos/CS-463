roup person-group-type="author"><name><surname>Lave</surname><given-names>LB</given-names></name><name><surname>Ennever</surname><given-names>FK</given-names></name><name><surname>Rosencrantz</surname><given-names>HS</given-names></name><name><surname>Ommen</surname><given-names>GS</given-names></name></person-group><article-title>Information value of the rodent bioassay</article-title><source>Nature</source><year>1988</year><volume>336</volume><fpage>631</fpage><lpage>633</lpage><pub-id pub-id-type="pmid">3143914</pub-id><pub-id pub-id-type="doi">10.1038/336631a0</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moore</surname><given-names>LB</given-names></name><name><surname>Parks</surname><given-names>DJ</given-names></name><name><surname>Jones</surname><given-names>SA</given-names></name><name><surname>Bledsoe</surname><given-names>RK</given-names></name><name><surname>Consler</surname><given-names>TG</given-names></name><name><surname>Stimmel</surname><given-names>JB</given-names></name><name><surname>Goodwin</surname><given-names>B</given-names></name><name><surname>Liddell</surname><given-names>C</given-names></name><name><surname>Blanchard</surname><given-names>SG</given-names></name><name><surname>Willson</surname><given-names>TM</given-names></name><name><surname>Collins</surname><given-names>JL</given-names></name><name><surname>Kliewer</surname><given-names>SA</given-names></name></person-group><article-title>Orphan nuclear receptors constitutive androstane receptor and pregnane x receptor share xenobiotic and steroid ligands</article-title><source>The Journal of Biological Chemistry</source><year>2000</year><volume>275</volume><fpage>15122</fpage><lpage>15126</lpage><pub-id pub-id-type="pmid">10748001</pub-id><pub-id pub-id-type="doi">10.1074/jbc.M001215200</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name