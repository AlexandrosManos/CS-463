<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Radiat Oncol</journal-id><journal-title>Radiation Oncology (London, England)</journal-title><issn pub-type="epub">1748-717X</issn><publisher><publisher-name>BioMed Central</publisher-name><publisher-loc>London</publisher-loc></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">17343751</article-id><article-id pub-id-type="pmc">1828737</article-id><article-id pub-id-type="publisher-id">1748-717X-2-12</article-id><article-id pub-id-type="doi">10.1186/1748-717X-2-12</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research</subject></subj-group></article-categories><title-group><article-title>The impact of radiotherapy in the treatment of desmoid tumours. An international survey of 110 patients. A study of the Rare Cancer Network</article-title></title-group><contrib-group><contrib id="A1" corresp="yes" contrib-type="author"><name><surname>Baumert</surname><given-names>Brigitta G</given-names></name><xref ref-type="aff" rid="I1">1</xref><xref ref-type="aff" rid="I2">2</xref><email>brigitta.baumert@maastro.nl</email></contrib><contrib id="A2" contrib-type="author"><name><surname>Spahr</surname><given-names>Martin O</given-names></name><xref ref-type="aff" rid="I1">1</xref><email>martin@spahrquartett.ch</email></contrib><contrib id="A3" contrib-type="author"><name><surname>Hochstetter</surname><given-names>Arthur Von</given-names></name><xref ref-type="aff" rid="I3">3</xref><email>pie@pathol.unizh.ch</email></contrib><contrib id="A4" contrib-type="author"><name><surname>Beauvois</surname><given-names>Sylvie</given-names></name><xref ref-type="aff" rid="I4">4</xref><xref ref-type="aff" rid="I25">25</xref><email>sbeauvois@clstjean.be</email></con