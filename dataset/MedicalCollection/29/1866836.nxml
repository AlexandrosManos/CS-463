r">1.27 (2)</td></tr><tr><td align="left">All affected</td><td align="center">220</td><td align="center">5.47 (1)</td><td align="center">222</td><td align="center">7.41 (1)</td></tr><tr><td align="left">&#x02003;Linked</td><td align="center">166</td><td align="center">5.59 (1)</td><td align="center">161</td><td align="center">7.34 (1)</td></tr><tr><td align="left">&#x02003;Unlinked</td><td align="center">54</td><td align="center">5.09 (1)</td><td align="center">61</td><td align="center">7.60 (1)</td></tr><tr><td align="left">Control</td><td align="center">100</td><td align="center">0.70 (1)</td><td align="center">100</td><td align="center">0.70 (1)</td></tr></tbody></table><table-wrap-foot><p>*Q3-Q1: interquartile range</p></table-wrap-foot></table-wrap></sec></back></article>