="center">19.685</td><td align="center">4.234</td><td align="center">8.842</td><td align="center">0.620</td><td align="center">1.301</td><td align="center">0.380</td><td align="center">0.616</td></tr><tr><td align="left"><italic>p</italic>-value<sup>1</sup></td><td></td><td align="center">0.010</td><td align="center">0.002</td><td align="center">0.040</td><td align="center">0.007</td><td align="center">0.734</td><td align="center">0.587</td><td align="center">0.537</td><td align="center">0.674</td></tr><tr><td align="left"><italic>p</italic>-value<sup>2</sup></td><td align="left">Bon<sup>3</sup></td><td align="center">0.040</td><td align="center">0.008</td><td align="center">0.160</td><td align="center">0.028</td><td align="center">1.000</td><td align="center">1.000</td><td align="center">1.000</td><td align="center">1.000</td></tr><tr><td></td><td align="left">Holm</td><td align="center">0.040</td><td align="center">0.008</td><td align="center">0.160</td><td align="center">0.028</td><td align="center">1.000</td><td align="center">0.742</td><td align="center">0.888</td><td align="center">1.000</td></tr><tr><td></td><td align="left">wy<sup>4</sup></td><td align="center">0.037</td><td align="center">0.076</td><td align="center">0.141</td><td align="center">0.025</td><td align="center">0.920</td><td align="center">0.680</td><td align="center">0.542</td><td align="center">0.886</td></tr><tr><td colspan="10"><hr></hr></td></tr><tr><td></td><td></td><td align="center" colspan="4">rs749407</td><td align="center" colspan="4">rs980972</td></tr><tr><td colspan="10"><hr></hr></td></tr><tr><td align="left">Test statistic</td><td></td><td align="center">0.619</td><td align="center">0.929</td><td align="center">0.586</td><td align="center">0.586</td><td align="center">4.900</td><td align="center">5.244</td><td align="center">3.848</td><td align="center">4.820</td></tr><tr><td align="left"><italic>p</italic>-value<sup>1</sup></td><td></td><td align="center">0.734</td><td align="ce