owspan="1" colspan="1">&#x02212;4.86389</td><td align="left" rowspan="1" colspan="1">Unknown</td><td align="left" rowspan="1" colspan="1">LG2</td><td align="left" rowspan="1" colspan="1">&#x02212;</td></tr><tr><td align="left" rowspan="1" colspan="1">12</td><td align="left" rowspan="1" colspan="1">BB160010A10B11</td><td align="left" rowspan="1" colspan="1">BI512703</td><td align="left" rowspan="1" colspan="1">+</td><td align="left" rowspan="1" colspan="1">0.40742</td><td align="left" rowspan="1" colspan="1">4.79587</td><td align="left" rowspan="1" colspan="1">Predicted (GB14785)</td><td align="left" rowspan="1" colspan="1">LG7</td><td align="left" rowspan="1" colspan="1">mapmodulin</td></tr><tr><td align="left" rowspan="1" colspan="1">13</td><td align="left" rowspan="1" colspan="1">BB160023B20H03</td><td align="left" rowspan="1" colspan="1">BI516947</td><td align="left" rowspan="1" colspan="1">+</td><td align="left" rowspan="1" colspan="1">0.58835</td><td align="left" rowspan="1" colspan="1">4.58093</td><td align="left" rowspan="1" colspan="1">MRJP4 (NM_001011610)</td><td align="left" rowspan="1" colspan="1">LG11</td><td align="left" rowspan="1" colspan="1">&#x02212;</td></tr><tr><td align="left" rowspan="1" colspan="1">14</td><td align="left" rowspan="1" colspan="1">BB170004A20C08</td><td align="left" rowspan="1" colspan="1">BI503042</td><td align="left" rowspan="1" colspan="1">+</td><td align="left" rowspan="1" colspan="1">0.58392</td><td align="left" rowspan="1" colspan="1">4.50234</td><td align="left" rowspan="1" colspan="1">Unknown</td><td align="left" rowspan="1" colspan="1">LG14</td><td align="left" rowspan="1" colspan="1">&#x02212;</td></tr><tr><td align="left" rowspan="1" colspan="1">15</td><td align="left" rowspan="1" colspan="1">BB170012B20B02</td><td align="left" rowspan="1" colspan="1">BI509225</td><td align="left" rowspan="1" colspan="1">&#x02212;</td><td align="left" rowspan="1" colspan="1">0.47082</td><td align="left" rowspan="1" colspan="1">&#x02212;4.35128</td><td align="left" rowspan="1" colspan="1">Predicted (GB11410)</td><td align="left" rowspan="1" colspan="1">LG4</td><td align="left" rowspan="1" colspan="1">CG31803</td></tr><tr><td align="left" rowspan="1" colspan="1">16</td><td align="left" rowspan="1" colspan="1">BB160006A20B02</td><td align="left" rowspan="1" colspan="1">BI511564</td><td align="left" rowspan="1" colspan="1">+</td><td align="left" rowspan="1" colspan="1">0.48269</td><td align="left" rowspan="1" colspan="1">4.05937</td><td align="left" rowspan="1" colspan="1">Unknown</td><td align="left" rowspan="1" colspan="1">LG1</td><td align="left" rowspan="1" colspan="1">&#x02212;</td></tr><tr><td align="left" rowspan="1" colspan="1">17</td><td align="left" rowspan="1" colspan="1">BB160016B10G12</td><td align="left" rowspan="1" colspan="1">BI514886</td><td align="left" rowspan="1" colspan="1">+</td><td align="left" rowspan="1" colspan="1">0.35545</td><td align="left" rowspan="1" colspan="1">4.02584</td><td align="left" rowspan="1" colspan="1">Predicted (GB16628)</td><td align="left" rowspan="1" colspan="1">LGUn</td><td align="left" rowspan="1" colspan="1">RpL6</td></tr><tr><td align="left" rowspan="1" colspan="1">18</td><td align="left" rowspan="1" colspan="1">BB170019B20B11</td><td align="left" rowspan="1" colspan="1">BI506253</td><td align="left" rowspan="1" colspan="1">+</td><td align="left" rowspan="1" colspan="1">0.30753</td><td align="left" rowspan="1" colspan="1">3.99177</td><td align="left" rowspan="1" colspan="1">Predicted (GB11074)</td><td align="left" rowspan="1" colspan="1">LG2</td><td align="left" rowspan="1" colspan="1">CG7886</td></tr><tr><td align="left" rowspan="1" colspan="1">19</td><td align="left" rowspan="1" colspan="1">BB160005B10G11</td><td align="left" rowspan="1" colspan="1">BI511393</td><td align="left" rowspan="1" colspan="1">&#x02212;</td><td align="left" rowspan="1" colspan="1">0.31552</td><td align="left" rowspan="1" colspan="1">&#x02212;3.94055</td><td align="left" rowspan="1" colspan="1">Predicted (GB17176)</td><td align="left" rowspan="1" colspan="1">LG4</td><td align="left" rowspan="1" colspan="1">CG7231</td></tr><tr><td align="left" rowspan="1" colspan="1">20</td><td align="left" rowspan="1" colspan="1">BB170011B20D04</td><td align="left" rowspan="1" colspan="1">BI503319</td><td align="left" rowspan="1" colspan="1">+</td><td align="left" rowspan="1" colspan="1">0.52384</td><td align="left" rowspan="1" colspan="1">3.90507</td><td align="left" rowspan="1" colspan="1">Predicted (GB13722)</td><td align="left" rowspan="1" colspan="1">LG6</td><td align="left" rowspan="1" colspan="1">glucocerebrosidase</td></tr><tr><td align="left" colspan="9" rowspan="1">Abdominal tissue</td></tr><tr><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">BB170032A10H06</td><td align="left" rowspan="1" colspan="1">BI505487</td><td align="left" rowspan="1" colspan="1">+</td><td align="left" rowspan="1" colspan="1">0.8815213</td><td align="left" rowspan="1" colspan="1">11.776712<xref ref-type="table-fn" rid="tf1-3">*</xref></td><td align="left" rowspan="1" colspan="1">Predicted (GB14261)</td><td align="left" rowspan="1" colspan="1">LG5</td><td align="left" rowspan="1" colspan="1">NPC2-like</td></tr><tr><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">BB170008A10E05</td><td align="left" rowspan="1" colspan="1">BI507942</td><td align="left" rowspan="1" colspan="1">+</td><td align="left" rowspan="1" colspan="1">0.5827994</td><td align="left" rowspan="1" colspan="1">11.635177<xref ref-type="table-fn" rid="tf1-3">*</xref></td><td align="left" rowspan="1" colspan="1">Predicted (GB14261)</td><td align="left" rowspan="1" colspan="1">LG5</td><td align="left" rowspan="1" colspan="1">NPC2-like</td></tr><tr><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">BB160011A10H06</td><td align="left" rowspan="1" colspan="1">BI513067</td><td align="left" rowspan="