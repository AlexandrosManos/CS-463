1</lpage><pub-id pub-id-type="pmid">958399</pub-id></citation></ref><ref id="pone.0000434-Elowitz1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Elowitz</surname><given-names>MB</given-names></name><name><surname>Levine</surname><given-names>AJ</given-names></name><name><surname>Siggia</surname><given-names>ED</given-names></name><name><surname>Swain</surname><given-names>PS</given-names></name></person-group><year>2002</year><article-title>Stochastic Gene Expression in a Single Cell</article-title><source><italic>Science</italic></source><fpage>1183</fpage><pub-id pub-id-type="pmid">12183631</pub-id></citation></ref><ref id="pone.0000434-Hasty1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hasty</surname><given-names>J</given-names></name><name><surname>Pradines</surname><given-names>J</given-names></name><name><surname>Dolnik</surname><given-names>M</given-names></name><name><surname>Collins</surname><given-names>JJ</given-names></name></person-group><year>2000</year><article-title>Noise-based switches and amplifiers for gene expression.</article-title><source><italic>Proc. Natl. Acad. Sci. USA</italic></source><volume>97</volume><fpage>2075</fpage><lpage>2080</lpage><pub-id pub-id-type="pmid">10681449</pub-id></citation></ref><ref id="pone.0000434-Furusawa1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Furusawa</surname><given-names>C</given-names></name><name><surname>Suzuki</surname><given-names>T</given-names></name><name><surname>Kashiwagi</surname><given-names>A</given-names></name><name><surname>Yomo</surname><given-names>T</given-names></name><name><surname>Kaneko</surname><given-names>K</given-names></name></person-group><year>2005</year><article-title>Ubiquity of Log-normal Distributions in Intra-cellular Reaction Dynamics.</article-title><source><italic>BIOPHYSICS</italic></source><volume>1</volume><fpage>25</fpage><lpage>31</lpage></citation></ref><ref id="pone.0000434-BarEven1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bar-Even</surname><given-names>A</given-names></name><etal/></person-group><year>2006</year><article-title>Noise in protein expression scales with natural protein abundance.</article-title><source>Nature Genetics</source><volume>38</volume><fpage>636</fpage><lpage>643</lpage><pub-id pub-id-type="pmid">16715097</pub-id></citation></ref><ref id="pone.0000434-Kaern1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaern</surname><given-names>M</given-names></name><name><surname>Elston</surname><given-names>TC</given-names></name><name><surname>Blake</surname><given-names>WJ</given-names></name><name><surname>Collins</surname><given-names>JJ</given-names></name></person-group><year>2005</year><article-title>Stochasticity in gene expression: from theories to phenotypes.</article-title><source>Nat. Rev. Genet.</source><volume>6</volume><fpage>451</fpage><lpage>464</lpage><pub-id pub-id-type="pmid">15883588</pub-id></citation></ref><ref id="pone.0000434-Ueda1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ueda</surname><given-names>M</given-names></name><name><surname>Sako</surname><given-names>Y</given-names></name><name><surname>Tanaka</surname><given-names>T</given-names></name><name><surname>Devreotes</surname><given-names>P</given-names></name><name><surname>Yanagida</surname><given-names>T</given-names></name></person-group><year>2001</year><article-title>Single-molecule analysis of chemotactic signaling in Dictyostelium cells.</article-title><source><italic>Science</italic></source><volume>294</volume><fpage>864</fpage><lpage>867</lpage><pub-id pub-id-type="pmid">11679673</pub-id></citation></ref><ref id="pone.0000434-Kashiwagi1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kashiwagi</surname><given-names>A</given-names></name><name><surname>Urabe</surname><given-names>I</given-names></name><name><surname>Kaneko</surname><given-names>K</given-names></name><name><surname>Yomo</surname><given-names>T</given-names></name></person-group><year>2006</year><article-title>Adaptive response of a gene network to environmental changes by attractor selection.</article-title><source>Plos One,</source><volume>1</volume><fpage>e49</fpage><pub-id pub-id-type="pmid">17183678</pub-id></citation></ref><ref id="pone.0000434-Sawai1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sawai</surname><given-names>S</given-names></name><name><surname>Thomason</surname><given-names>PA</given-names></name><name><surname>Cox</surname><given-names>EC</given-names></name></person-group><year>2005</year><article-title>An autoregulatory circuit for long-range self-organization in Dictyostelium cell populations.</article-title><source><italic>Nature</italic></source><fpage>323</fpage><lpage>326</lpage><pub-id pub-id-type="pmid">15662425</pub-id></citation></ref><ref id="pone.0000434-Kaneko1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaneko</surname><given-names>K</given-names></name><name><surname>Yomo</surname><given-names>T</given-names></name></person-group><year>1999</year><article-title>Isologous diversification for robust development of cell society.</article-title><source><italic>J. Theor. Biol</italic></source><fpage>243</fpage><lpage>256</lpage><pub-id pub-id-type="pmid">10433890</pub-id></citation></ref><ref id="pone.0000434-Kaneko2"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaneko</surname><given-names>K</given-names></name></person-group><year>2006</year><article-title><italic>Life: An Introduction to Complex Systems Biology</italic>, Springer</article-title></citation></ref><ref id="pone.0000434-Sato1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sato</surname><given-names>K</given-names></name><name><surname>Ito</surname><given-names>Y</given-names></name><name><surname>Yomo</surname><given-names>T</given-names></name><name><surname>Kaneko</surname><given-names>K</given-names></name></person-group><year>2003</year><article-title>On the Relation between Fluctuation and Response in Biological Systems.</article-title><source><italic>Proc. Nat. Acad. Sci. USA</italic></source><volume>100</volume><fpage>14086</fpage><lpage>14090</lpage><pub-id pub-id-type="pmid">14615583</pub-id></citation></ref><ref id="pone.0000434-Kaneko3"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaneko</surname><given-names>K</given-names></name><name><surname>Furusawa</surname><given-names>C</given-names></name></person-group><year>2006</year><article-title>An evolutionary relationship between genetic variation and phenotypic fluctuation</article-title><source><italic>J. Theo. Biol</italic></source><fpage>78</fpage><lpage>86</lpage></citation></ref><ref id="pone.0000434-Ancel1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ancel</surname><given-names>LW</given-names></name><name><surname>Fontana</surname><given-names>W</given-names></name></person-group><year>2002</year><article-title>Plasticity, Evolvability, and Modularity in RNA.</article-title><source><italic>J. Experimental Zoology</italic></source><fpage>242</fpage><lpage>283</lpage></citation></ref><ref id="pone.0000434-Kirschner1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kirschner</surname><given-names>MW</given-names></name><name><surname>Gerhart</surname><given-names>JC</given-names></name></person-group><year>2005</year><article-title><italic>The Plausbility of Life</italic>, Yale Univ. Press</article-title></citation></ref><ref id="pone.0000434-Schmalhausen1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schmalhausen</surname><given-names>II</given-names></name></person-group><year>1949</year><article-title><italic>Factors of Evolution: The theory of Stabilizing Selection</italic> (Univ. of Chicago Press, Chicago) (reprinted 1986)</article-title></citation></ref><ref id="pone.0000434-Waddington1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Waddington</surname><given-names>CH</given-names></name></person-group><year>1957</year><article-title><italic>The Strategy of the Genes</italic>, Allen &#x00026; Unwin, London</article-title></citation></ref><ref id="pone.0000434-Wagner2"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wagner</surname><given-names>GP</given-names></name><name><surname>Booth</surname><given-names>G</given-names></name><name><surname>Bagheri-Chaichian</surname><given-names>H</given-names></name></person-group><year>1997</year><article-title>A population Genetic Theory of Canalization, Evolution</article-title><fpage>329</fpage><lpage>347</lpage></citation></ref><ref id="pone.0000434-Siegal1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Siegal</surname><given-names>ML</given-names></name><name><surname>Bergman</surname><given-names>A</given-names></name></person-group><year>2002</year><article-title>Waddington's canalization revisited: Developmental stability and evolution.</article-title><source>Proc Nat. Acad. Sci. USA</source><fpage>10528</fpage><lpage>10532</lpage><pub-id pub-id-type="pmid">12082173</pub-id></citation></ref><ref id="pone.0000434-Fisher1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fisher</surname><given-names>RA</given-names></name></person-group><year>1930</year><year>1958</year><article-title><italic>The Genetical Theory of Natural Selection</italic>, Oxford Univ. Press</article-title></citation></ref><ref id="pone.0000434-Edwards1"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Edwards</surname><given-names>AWF</given-names></name></person-group><year>2000</year><article-title><italic>Foundations of mathematical genetics</italic>, Cambridge University Press</article-title></citation></ref><ref id="pone.0000434-Futuyma1"><label>27</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Futuyma</surname><given-names>DJ</given-names></name></person-group><year>1986</year><article-title><italic>Evolutionary Biology</italic> (Second edition), Sinauer Associates Inc., Sunderland</article-title></citation></ref><ref id="pone.0000434-Eigen1"><label>28</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eigen</surname><given-names>M</given-names></name><name><surname>Schuster</surname><given-names>P</given-names></name></person-group><year>1979</year><article-title><italic>The Hypercycle</italic>, Springer</article-title></citation></ref><ref id="pone.0000434-Glass1"><label>29</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Glass</surname><given-names>L</given-names></name><name><surname>Kauffman</surname><given-names>SA</given-names></name></person-group><year>1973</year><article-title>The logical analysis of continuous, non-linear biochemical control networks.</article-title><source>J. Theor. Biol</source><fpage>103</fpage><lpage>129</lpage><pub-id pub-id-type="pmid">4741704</pub-id></citation></ref><ref id="pone.0000434-Mjolsness1"><label>30</label>