person-group-type="author"><name><surname>Balagu&#x000e9;</surname><given-names>F</given-names></name><name><surname>Dutoit</surname><given-names>G</given-names></name><name><surname>Waldburger</surname><given-names>M</given-names></name></person-group><article-title>Low back pain in schoolchildren. An epidemiological study</article-title><source>Scand J Rehabil Med</source><year>1988</year><volume>20</volume><fpage>175</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">2976526</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Troussier</surname><given-names>B</given-names></name><name><surname>Davoine</surname><given-names>P</given-names></name><name><surname>de Gaudemaris</surname><given-names>R</given-names></name><name><surname>Fauconnier</surname><given-names>J</given-names></name><name><surname>Phelip</surname><given-names>X</given-names></name></person-group><article-title>Back pain in school children. A study among 1178 pupils</article-title><source>Scand J Rehabil Med</source><year>1994</year><volume>26</volume><fpage>143</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">7801063</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gedalia</surname><given-names>A</given-names></name><name><surname>Person</surname><given-names>DA</given-names></name><name><surname>Brewer</surname><given-names>EJ</given-names><suffix>Jr</suffix></name><name><surname>Giannini</surname><given-names>EH</given-names></name></person-group><article-title>Hypermobility of the joints in juvenile episodic arthritis/arthralgia</article-title><source>J Pediatr</source><year>1985</year><volume>107</volume><fpage>873</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">4067743</pub-id><pub-id pub-id-type="doi">10.1016/S0022-3476(85)80178-5</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-typ