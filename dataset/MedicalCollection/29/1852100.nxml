son-group person-group-type="author"><collab>PFMA</collab></person-group><article-title>Pet Food Manufacturers Association.  Pet ownership trends.</article-title><ext-link ext-link-type="uri" xlink:href="http://www.pfma.com/public/petownership.htm"/></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Franti</surname><given-names>CE</given-names></name><name><surname>Kraus</surname><given-names>JF</given-names></name></person-group><article-title>Aspects of pet ownership in Yolo-County California</article-title><source>J Am Vet Med Assoc</source><year>1974</year><volume>164</volume><fpage>166</fpage><lpage>171</lpage><pub-id pub-id-type="pmid">4811896</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Franti</surname><given-names>CE</given-names></name><name><surname>Kraus</surname><given-names>JF</given-names></name><name><surname>Borhani</surname><given-names>NO</given-names></name><name><surname>Johnson</surname><given-names>SL</given-names></name><name><surname>Tucker</surname><given-names>SD</given-names></name></person-group><article-title>Pet ownership in rural Northern California (El-Dorado County)</article-title><source>J Am Vet Med Assoc</source><year>1980</year><volume>176</volume><fpage>143</fpage><lpage>149</lpage><pub-id pub-id-type="pmid">7353990</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leslie</surname><given-names>BE</given-names></name><name><surname>Meek</surname><given-names>AH</given-names></name><name><surname>Kawash</surname><given-names>GF</given-names></name><name><surname>McKeown</surname><given-names>DB</given-names></name></person-group><article-title>An epidemiologic investigation of pet ownership in Ontario</article-title><source>Canadian Veterinary Journal-Revue Veterinaire Canadienne</source><year>1994</year><volume>35</volume><fpage>218</fpage><lpage>222</lpage></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>McHarg</surname><given-names>M</given-names></name><name><surname>Baldock</surname><given-names>C</given-names></name><name><surname>Headey</surname><given-names>B</given-names></name><name><surname>Robinson</surname><given-names>A</given-names></name></person-group><source>National people and pets survey</source><year>1995</year><publisher-name>Australia, Urban Animal Management Coalition</publisher-name></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Teclaw</surname><given-names>R</given-names></name><name><surname>Mendlein</surname><given-names>J</given-names></name><name><surname>Garbe</surname><given-names>P</given-names></name><name><surname>Mariolis</surname><given-names>P</given-names></name></person-group><article-title>Characteristics of pet populations and households in the Purdue-Comparative-Oncology-Program Catchment-Area, 1988</article-title><source>J Am Vet Med Assoc</source><year>1992</year><volume>201</volume><fpage>1725</fpage><lpage>1729</lpage><pub-id pub-id-type="pmid">1293114</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Troutman</surname><given-names>CM</given-names></name></person-group><article-title>Veterinary services market for companion animals.</article-title><source>J Am Vet Med Assoc</source><year>1988</year><volume>193</volume><fpage>920</fpage><lpage>922, 1056-1058, 1217-1219</lpage><pub-id pub-id-type="pmid">3192472</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wise</surname><given-names>JK</given-names></name><name><surname>Kushman</surname><given-names>JE</given-names></name></person-group><article-title>Pet ownership by life group</article-title><source>J Am Vet Med Assoc</source><year>1984</year><volume>185</volume><fpage>687</fpage><lpage>690</lpage><pub-id pub-id-type="pmid">6490495</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wise</surname><given-names>JK</given-names></name><name><surname>Yang</surname><given-names>JJ</given-names></name></person-group><article-title>Veterinary Service Market For Companion Animals, 1992 .1. Companion Animal Ownership And Demographics</article-title><source>J Am Vet Med Assoc</source><year>1992</year><volume>201</volume><fpage>990</fpage><lpage>992</lpage><pub-id pub-id-type="pmid">1429146</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Beck</surname><given-names>AM</given-names></name><name><surname>Meyers</surname><given-names>NM</given-names></name></person-group><article-title>Health enhancement and companion animal ownership</article-title><source>Annu Rev Public Health</source><year>1996</year><volume>17</volume><fpage>247</fpage><lpage>257</lpage><pub-id pub-id-type="pmid">8724226</pub-id><pub-id pub-id-type="doi">10.1146/annurev.pu.17.050196.001335</pub-id></citation></ref><ref id="B25"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Messent</surname><given-names>PR</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Anderson RK, Hart BL, Hart LA</surname></name></person-group><article-title>Correlates and effects of pet ownership</article-title><source>The pet connection: Its influence on our health and quality of life</source><year>1984</year><publisher-name>Minneapolis , Center to study Human-Animal Relationships and Environments, University of Minnesota.</publisher-name><fpage>331</fpage><lpage>340</lpage></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tower</surname><given-names>RB</given-names></name><name><surname>Nokota</surname><given-names>M</given-names></name></person-group><article-title>Pet companionship and depression: results from a United States Internet sample</article-title><source>Anthrozoos</source><year>2006</year><volume>19</volume><fpage>50</fpage><lpage>64</lpage></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brand</surname><given-names>U</given-names></name></person-group><article-title>Comparative survey of dog owners in Berlin and Brandenburg, Germany</article-title><source>Tierarztl Umsch</source><year>2002</year><volume>57</volume><fpage>309</fpage><lpage>316</lpage></citation></ref><ref id="B28"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Sharma</surname><given-names>S</given-names></name></person-group><article-title>Cluster Analysis</article-title><source>Applied Multivariate Techniques</source><year>1996</year><publisher-name> John Wiled and Sons Inc</publisher-name><fpage>185</fpage><lpage>237</lpage></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Robertson</surname><given-names>ID</given-names></name><name><surname>Shaw</surname><given-names>SE</given-names></name><name><surname>Clark</surname><given-names>WT</given-names></name></person-group><article-title>The use of health management practices by a randomly selected group of dog owners in Perth</article-title><source>Aust Vet Pract</source><year>1991</year><volume>21</volume><fpage>126</fpage><lpage>130</lpage></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tenkate</surname><given-names>TD</given-names></name><name><surname>Stafford</surname><given-names>RJ</given-names></name></person-group><article-title>Risk factors for campylobacter infection in infants and young children: a matched case-control study</article-title><source>Epidemiol Infect</source><year>2001</year><volume>127</volume><fpage>399</fpage><lpage>4040</lpage><pub-id pub-id-type="pmid">11811871</pub-id></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Feldmann</surname><given-names>BM</given-names></name></person-group><article-title>Why people own pets - Pet owner psychology and the deliquent owner.</article-title><source>Animal Regulation Studies</source><year>1997</year><volume>1</volume><fpage>87</fpage><lpage>94</lpage></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Selby</surname><given-names>LA</given-names></name><name><surname>Rhoades</surname><given-names>JD</given-names></name><name><surname>Irvin</surname><given-names>JA</given-names></name><name><surname>Carey</surname><given-names>GE</given-names></name><name><surname>Wade</surname><given-names>RG</given-names></name></person-group><article-title>Values and limitations of pet ownership</article-title><source>J Am Vet Med Assoc</source><year>1980</year><volume>176</volume><fpage>1274</fpage><lpage>1276</lpage><pub-id pub-id-type="pmid">7429927</pub-id></citation></ref><ref id="B33"><citation citation-type="other"><article-title>Standard Occupational Classification</article-title><ext-link ext-link-type="uri" xlink:href="http://www.statistics.gov.uk/nsbase/methods_quality/ns_sec/soc2000.asp#vol1 "/></citation></ref></ref-list><sec sec-type="display-objects"><title>Figures and Tables</title><fig position="float" id="F1"><label>Figure 1</label><caption><p><bold>Reported contact with dogs (other than own dog) for Dog-owning (DO) and Dog-free (DF) households</bold>. The numbers indicate the number of respondents in each category. DO households were significantly more likely to have more frequent contact with dogs, compared to DF households (P &#x0003c; 0.001).</p></caption><graphic xlink:href="1746-6148-3-5-1"/></fig><table-wrap position="float" id="T1"><label>Table 1</label><caption><p>Univariable analysis of factors associated with dog ownership in a community in Cheshire, UK.</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="left"><bold>Variable</bold></td><td align="center"><bold>DO</bold></td><td align="center"><bold>DF</bold></td><td align="center"><bold>OR</bold></td><td align="center"><bold>95% CI</bold></td><td align="center"><bold>P-value</bold></td></tr></thead><tbody><tr><td align="left"><bold>Birds</bold></td><td></td><td></td><td></td><td></td><td align="center"><bold>0.02</bold></td></tr><tr><td align="left">&#x02003;No</td><td align="center">246</td><td align="center">788</td><td align="center">1</td><td></td><td></td></tr><tr><td align="left">&#x02003;Yes</td><td align="center">16</td><td align="center">24</td><td align="center">2.1</td><td align="center">1.1&#x02013;4.1</td><td></td></tr><tr><td align="left"><bold>Fish</bold></td><td></td><td></td><td></td><td></td><td align="center"><bold>0.02</bold></td></tr><tr><td align="left">&#x02003;No</td><td align="center">220</td><td align="center">725</td><td align="center">1</td><td></td><td></td></tr><tr><td align="left">&#x02003;Yes</td><td align="center">42</td><td align="center">87</td><td align="center">1.6</td><td align="center">1.1&#x02013;2.4</td><td></td></tr><tr><td align="left"><bold>Horse</bold></td><td></td><td></td><td></td><td></td><td align="center"><bold>0.002*</bold></td></tr><tr><td align="left">&#x02003;No</td><td align="center">253</td><td align="center">807</td><td align="center">1</td><td></td><td></td></tr><tr><td align="left">&#x02003;Yes</td><td align="center">9</td><td align="center">5</td><td align="center">5.7</td><td align="center">1.9&#x02013;17.3</td><td></td></tr><tr><td align="left"><bold>N&#x000b0; Persons</bold></td><td></td><td></td><td></td><td></td><td align="center"><bold>&#x