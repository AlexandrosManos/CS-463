itation-type="book"><person-group person-group-type="author"><name><surname>Heisenberg</surname><given-names>W</given-names></name></person-group><year>1952</year><article-title>Philosophic Problems of Quantum Physics.</article-title><publisher-loc>Woodbridge, CT</publisher-loc><publisher-name>Ox Bow</publisher-name></citation></ref><ref id="pone.0000443-Schrdinger1"><label>81</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Schr&#x000f6;dinger</surname><given-names>E</given-names></name></person-group><year>1944</year><article-title>What is life?</article-title><publisher-loc>London</publisher-loc><publisher-name>Cambridge University Press</publisher-name></citation></ref><ref id="pone.0000443-Lum1"><label>82</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lum</surname><given-names>CS</given-names></name><name><surname>Zhurov</surname><given-names>Y</given-names></name><name><surname>Cropper</surname><given-names>EC</given-names></name><name><surname>Weiss</surname><given-names>KR</given-names></name><name><surname>Brezina</surname><given-names>V</given-names></name></person-group><year>2005</year><article-title>Variability of swallowing performance in intact, freely feeding <italic>Aplysia</italic>.</article-title><source>J Neurophysiol</source><volume>94</volume><fpage>2427</fpage><lpage>2446</lpage><pub-id pub-id-type="pmid">15944235</pub-id></citation></ref><ref id="pone.0000443-Shultz1"><label>83</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shultz</surname><given-names>S</given-names></name><name><surname>Dunbar</surname><given-names>R</given-names></name></person-group><year>2006</year><article-title>Chimpanzee and felid diet composition is influenced by prey brain size.</article-title><source>Biology Letters</source><volume>2</volume><fpage>505</fpage><lpage>508</lpage><pub-id pub-id-type="pmid">17148274</pub-id></