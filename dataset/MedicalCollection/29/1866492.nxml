eft">33%</td><td align="left">0.76</td><td align="left">0.90</td><td></td><td></td></tr><tr><td align="left">&#x02003;&#x0003e; 65 years</td><td align="left">37%</td><td align="left">NA</td><td align="left">24%</td><td align="left">0.47</td><td align="left">0.64</td><td align="left">0.70</td><td></td></tr></tbody></table><table-wrap-foot><p><sup>A</sup>Based on the multivariate model with <italic>p </italic>= 4.</p></table-wrap-foot></table-wrap></sec></back></article>