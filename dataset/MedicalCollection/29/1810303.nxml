itation-type="journal"><person-group person-group-type="author"><name><surname>Martin</surname><given-names>OR</given-names></name><name><surname>Rao</surname><given-names>SP</given-names></name><name><surname>Kurz</surname><given-names>KG</given-names></name><name><surname>El-Shenawy</surname><given-names>HA</given-names></name></person-group><source>J Am Chem Soc</source><year>1988</year><volume>110</volume><fpage>8698</fpage><lpage>8700</lpage><pub-id pub-id-type="doi">10.1021/ja00234a022</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reetz</surname><given-names>MT</given-names></name><name><surname>Jung</surname><given-names>A</given-names></name><name><surname>Bolm</surname><given-names>C</given-names></name></person-group><source>Tetrahedron</source><year>1988</year><volume>44</volume><fpage>3889</fpage><lpage>3898</lpage><pub-id pub-id-type="doi">10.1016/S0040-4020(01)86643-6</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reetz</surname><given-names>MT</given-names></name><name><surname>Jung</surname><given-names>A</given-names></name></person-group><source>J Am Chem Soc</source><year>1983</year><volume>105</volume><fpage>4833</fpage><lpage>4835</lpage><pub-id pub-id-type="doi">10.1021/ja00352a051</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Evans</surname><given-names>DA</given-names></name><name><surname>Dart</surname><given-names>MJ</given-names></name><name><surname>Duffy</surname><given-names>JL</given-names></name><name><surname>Yang</surname><given-names>MG</given-names></name></person-group><source>J Am Chem Soc</source><year>1996</year><volume>118</volume><fpage>4322</fpage><lpage>4343</lpage><pub-id pub-id-type="doi">10.1021/ja953901u</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jervis</surname><given-names>PJ</given-names></name><name><surname>Kariuki</surname><given-names>BM</given-names></name><name><surname>Cox</surname><given-names>LR</given-names></name></person-group><source>Org Lett</source><year>2006</year><volume>8</volume><fpage>4649</fpage><lpage>4652</lpage><pub-id pub-id-type="pmid">16986972</pub-id><pub-id pub-id-type="doi">10.1021/ol061957v</pub-id></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Eliel</surname><given-names>EL</given-names></name><name><surname>Wilen</surname><given-names>SH</given-names></name></person-group><article-title>Conformational aspects of the chemistry of six-membered ring compounds</article-title><source>Stereochemistry of Organic Compounds</source><year>1994</year><publisher-name>New York: Wiley and Sons</publisher-name><fpage>686</fpage><lpage>754</lpage></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heathcock</surname><given-names>CH</given-names></name><name><surname>Pirrung</surname><given-names>MC</given-names></name><name><surname>Montgomery</surname><given-names>SH</given-names></name><name><surname>Lampe</surname><given-names>J</given-names></name></person-group><source>Tetrahedron</source><year>1981</year><volume>23</volume><fpage>4087</fpage><lpage>4095</lpage><pub-id pub-id-type="doi">10.1016/S0040-4020(01)93284-3</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>AB</given-names></name><name><surname>Levenberg</surname><given-names>PA</given-names></name></person-group><source>Synthesis</source><year>1981</year><fpage>567</fpage><lpage>570</lpage><pub-id pub-id-type="doi">10.1055/s-1981-29532</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ganesan</surname><given-names>K</given-names></name><name><surname>Brown</surname><given-names>HC</given-names></name></person-group><source>J Org Chem</source><year>1994</year><volume>59</volume><fpage>2336</fpage><lpage>2340</lpage><comment>(data for ethyl esters <bold><italic>syn</italic></bold>- and <bold><italic>anti</italic>-8b</bold>)</comment><pub-id pub-id-type="doi">10.1021/jo00088a012</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matteson</surname><given-names>DS</given-names></name><name><surname>Michnick</surname><given-names>TJ</given-names></name></person-group><source>Organometallics</source><year>1990</year><volume>9</volume><fpage>3171</fpage><lpage>3177</lpage><comment>(data for <italic>t</italic>-butyl esters <bold><italic>syn</italic></bold>- and <bold><italic>anti</italic>-9a</bold>)</comment><pub-id pub-id-type="doi">10.1021/om00162a031</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ireland</surname><given-names>RE</given-names></name><name><surname>Liu</surname><given-names>L</given-names></name></person-group><source>J Org Chem</source><year>1993</year><volume>58</volume><fpage>2899</fpage><pub-id pub-id-type="doi">10.1021/jo00062a040</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dess</surname><given-names>DB</given-names></name><name><surname>Martin</surname><given-names>JC</given-names></name></person-group><source>J Am Chem Soc</source><year>1991</year><volume>113</volume><fpage>7277</fpage><lpage>7287</lpage><pub-id pub-id-type="doi">10.1021/ja00019a027</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crich</surname><given-names>D</given-names></name><name><surname>Smith</surname><given-names>M</given-names></name><name><surname>Yao</surname><given-names>Q</given-names></name><name><surname>Picione</surname><given-names>J</given-names></name></person-group><source>Synthesis</source><year>2001</year><fpage>323</fpage><lpage>326</lpage><pub-id pub-id-type="doi">10.1055/s-2001-10798</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stragies</surname><given-names>R</given-names></name><name><surname>Blechert</surname><given-names>S</given-names></name></person-group><source>Tetrahedron</source><year>1999</year><volume>55</volume><fpage>8179</fpage><lpage>8188</lpage><pub-id pub-id-type="doi">10.1016/S0040-4020(99)00299-9</pub-id></citation></ref><ref id="B26"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Bradley</surname><given-names>GW</given-names></name><name><surname>Thomas</surname><given-names>EJ</given-names></name></person-group><source>Synlett</source><year>1997</year><fpage>629</fpage><lpage>631</lpage></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Angoh</surname><given-names>AG</given-names></name><name><surname>Clive</surname><given-names>DLJ</given-names></name></person-group><source>J Chem Soc Chem Commun</source><year>1984</year><fpage>534</fpage><lpage>536</lpage><pub-id pub-id-type="doi">10.1039/c39840000534</pub-id></citation></ref></ref-list></back></article>