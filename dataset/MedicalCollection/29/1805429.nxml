312</lpage><pub-id pub-id-type="pmid">11527871</pub-id><pub-id pub-id-type="doi">10.1093/heapol/16.3.302</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berman</surname><given-names>P</given-names></name></person-group><article-title>Cost analysis as a management tool for improving the efficiency of primary care: some examples from Java</article-title><source>Int J Health Plann Manage</source><year>1986</year><volume>1</volume><fpage>275</fpage><lpage>288</lpage><pub-id pub-id-type="pmid">10311982</pub-id></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Duggal</surname><given-names>R</given-names></name><name><surname>Amin</surname><given-names>S</given-names></name></person-group><source>Cost of health care: a household survey in an Indian district, Bombay</source><year>1989</year><publisher-name>Bombay: Foundation for Research in Community Health</publisher-name></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gertler</surname><given-names>P</given-names></name><name><surname>van der Gaag</surname><given-names>J</given-names></name></person-group><source>The willingness to pay for medical care: evidence from two developing countries</source><year>1990</year><publisher-name>Baltimore: Johns Hopkins University Press</publisher-name></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meng</surname><given-names>Q</given-names></name><name><surname>Li</surname><given-names>R</given-names></name><name><surname>Cheng</surname><given-names>G</given-names></name><name><surname>Blas</surname><given-names>E</given-names></name></person-group><article-title>Provision and financial burden of TB services in a financially decentralised system: a case study from Shandong, China</article-title><source>Int J Health Plann Manage</source><year>2004</year><volume>19</volume><fpage>S45</fpage><lpage>S62</lpage><pub-id pub-id-type="pmid">15686060</pub-id><pub-id pub-id-type="doi">10.1002/hpm.774</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cheng</surname><given-names>G</given-names></name><name><surname>Tolhurst</surname><given-names>R</given-names></name><name><surname>Li</surname><given-names>R</given-names></name><name><surname>Meng</surname><given-names>Q</given-names></name><name><surname>Tang</surname><given-names>S</given-names></name></person-group><article-title>Factors affecting delays in the tuberculosis diagnosis in rural China: a case study in four counties in Shandong Province</article-title><source>Trans R Soc Trop Med Hyg</source><year>2005</year><volume>99</volume><fpage>355</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">15780342</pub-id><pub-id pub-id-type="doi">10.1016/j.trstmh.2004.07.005</pub-id></citation></ref><ref id="B16"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Zhang</surname><given-names>T</given-names></name><name><surname>Liu</surname><given-names>X</given-names></name><name><surname>Bromley</surname><given-names>H</given-names></name><name><surname>Tang</surname><given-names>S</given-names></name></person-group><article-title>Perceptions of tuberculosis and health seeking behaviour in rural Inner Mongolia, China</article-title><source>Health Policy</source><comment><ext-link ext-link-type="uri" xlink:href="http://www.elsevier.com/locate/healthpol"/></comment></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Xu</surname><given-names>B</given-names></name><name><surname>Dong</surname><given-names>H</given-names></name><name><surname>Zhao</surname><given-names>Q</given-names></name><name><surname>Bogg</surname><given-names>L</given-names></name></person-group><article-title>DOTS in China &#x02013; removing barriers or moving barriers?</article-title><source>Health Policy &#x00026; Planning</source><year>2006</year><volume>21</volume><fpage>365</fpage><lpage>72</lpage><pub-id pub-id-type="pmid">16940302</pub-id><pub-id pub-id-type="doi">10.1093/heapol/czl019</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zhan</surname><given-names>S</given-names></name><name><surname>Wang</surname><given-names>L</given-names></name><name><surname>Yin</surname><given-names>A</given-names></name><name><surname>Blas</surname><given-names>E</given-names></name></person-group><article-title>Revenue-driven in TB control &#x02013; three cases in China</article-title><source>Int J Health PLann Mgmt</source><year>2004</year><volume>19</volume><fpage>S63</fpage><lpage>S78</lpage><pub-id pub-id-type="doi">10.1002/hpm.778</pub-id></citation></ref></ref-list></back></article>