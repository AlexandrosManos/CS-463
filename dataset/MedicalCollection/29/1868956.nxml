 citation-type="journal"><person-group person-group-type="author"><name><surname>Bryant</surname><given-names>JE</given-names></name><name><surname>Vasconcelos</surname><given-names>PFC</given-names></name><name><surname>Rynbrand</surname><given-names>R</given-names></name><name><surname>Mutebi</surname><given-names>JP</given-names></name><name><surname>Higgs</surname><given-names>ST</given-names></name><etal/></person-group><year>2005</year><article-title>Size heterogeneity in the 3&#x02032; non-coding region of South American strains of yellow fever virus</article-title><source>J Virol</source><volume>79</volume><fpage>3807</fpage><lpage>3821</lpage><pub-id pub-id-type="pmid">15731274</pub-id></citation></ref><ref id="ppat-0030075-b024"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jenkins</surname><given-names>GMR</given-names></name></person-group><year>2002</year><article-title>Rates of molecular evolution in RNA viruses: A quantitative phylogenetic analysis</article-title><source>J Mol Evol</source><volume>54</volume><fpage>156</fpage><lpage>165</lpage><pub-id pub-id-type="pmid">11821909</pub-id></citation></ref><ref id="ppat-0030075-b025"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bryant</surname><given-names>JE</given-names></name><name><surname>Wang</surname><given-names>H</given-names></name><name><surname>Cabezas</surname><given-names>C</given-names></name><name><surname>Ramirez</surname><given-names>G</given-names></name><name><surname>Watts</surname><given-names>D</given-names></name><etal/></person-group><year>2003</year><article-title>Yellow fever virus in enzootic in Peru</article-title><source>Emerg Inf Dis</source><volume>9</volume><fpage>926</fpage><lpage>933</lpage></citation></ref><ref id="ppat-0030075-b026"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vasconcelos</surname><given-names>PFC</given-names></name><n