<name><surname>Lora</surname><given-names>J</given-names></name><etal/></person-group><year>1999</year><article-title>Urbanisation of yellow fever in Santa Cruz, Bolivia</article-title><source>Lancet</source><volume>353</volume><fpage>1558</fpage><lpage>1562</lpage><pub-id pub-id-type="pmid">10334253</pub-id></citation></ref><ref id="ppat-0030075-b018"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>H</given-names></name><name><surname>Jennings</surname><given-names>AD</given-names></name><name><surname>Ryman</surname><given-names>KD</given-names></name><name><surname>Late</surname><given-names>CM</given-names></name><name><surname>Wang</surname><given-names>E</given-names></name><etal/></person-group><year>1997</year><article-title>Genetic variation among strains of wild-type yellow fever virus from Senegal</article-title><source>J Gen Virol</source><volume>78</volume><fpage>1349</fpage><lpage>1352</lpage><pub-id pub-id-type="pmid">9191928</pub-id></citation></ref><ref id="ppat-0030075-b019"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Deubel</surname><given-names>V</given-names></name><name><surname>Pailliez</surname><given-names>JP</given-names></name><name><surname>Cornet</surname><given-names>M</given-names></name><name><surname>Schlesinger</surname><given-names>JJ</given-names></name><name><surname>Diop</surname><given-names>M</given-names></name><etal/></person-group><year>1985</year><article-title>Homogeneity among Senegalese strains of yellow fever virus</article-title><source>Am J Trop Med Hyg</source><volume>34</volume><fpage>976</fpage><lpage>983</lpage><pub-id pub-id-type="pmid">4037185</pub-id></citation></ref><ref id="ppat-0030075-b020"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Deubel</surname><given-names>V</given-names></name><name><surname>Digoutte</surname><given-names>JP</given-names></n