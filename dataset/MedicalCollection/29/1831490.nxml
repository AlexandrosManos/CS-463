align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"><bold>1</bold></td><td align="left" rowspan="1" colspan="1">4.132e-04</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">H2iT2</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">H2iTi</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">H2TH2</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">0</td><td align="left" r