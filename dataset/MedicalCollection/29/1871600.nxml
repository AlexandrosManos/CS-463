mes>L</given-names></name><name><surname>Beelen</surname><given-names>M</given-names></name><name><surname>Gallee</surname><given-names>M</given-names></name><name><surname>Hollema</surname><given-names>H</given-names></name><name><surname>Benraadt</surname><given-names>J</given-names></name><name><surname>Leeuwen</surname><given-names>F</given-names></name></person-group><article-title>The Comprehensive Cancer Centres' ALERT group. Risk and prognosis of endometrial cancer after tamoxifen for breast cancer</article-title><source>Lancet</source><year>2000</year><volume>356</volume><fpage>881</fpage><lpage>887</lpage><pub-id pub-id-type="pmid">11036892</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(00)02677-5</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Granberg</surname><given-names>S</given-names></name><name><surname>Wikland</surname><given-names>M</given-names></name><name><surname>Karlsson</surname><given-names>B</given-names></name><name><surname>Norstrom</surname><given-names>A</given-names></name><name><surname>Friberg</surname><given-names>LG</given-names></name></person-group><article-title>Endometrial thickness as measured by endo-vaginal Ultrasonography for Identifying Endometrial Abnormality</article-title><source>Am Jour of Obstet Gynecol</source><year>1991</year><volume>164</volume><fpage>47</fpage><lpage>52</lpage><pub-id pub-id-type="pmid">1986624</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hanchard</surname><given-names>B</given-names></name><name><surname>Blake</surname><given-names>G</given-names></name><name><surname>Wolff</surname><given-names>C</given-names></name><name><surname>Samuels</surname><given-names>E</given-names></name><name><surname>Waugh</surname><given-names>N</given-names></name><name><surname>Simpson</surname><given-names>D</given-names></name><name><surname>R