span="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td colspan="4" rowspan="1"><hr/></td></tr><tr><td rowspan="1" colspan="1"><italic>Microalbuminuria</italic></td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">Urinary AER &#x0003e;20 mcg/min</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr></tbody></table></table-wrap></sec></back></article>