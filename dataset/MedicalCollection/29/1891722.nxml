/tr><tr><td rowspan="3" align="center" colspan="1">6b</td><td rowspan="3" align="center" colspan="1">3</td><td align="center" rowspan="1" colspan="1">Arg-541(NH)</td><td align="center" rowspan="1" colspan="1">5(O)</td><td align="center" rowspan="1" colspan="1">2.64</td><td rowspan="3" align="center" colspan="1">1</td><td rowspan="3" align="center" colspan="1">Ser-624(OG)</td><td rowspan="3" align="center" colspan="1">5(O)</td><td rowspan="3" align="center" colspan="1">2.41</td></tr><tr><td align="center" rowspan="1" colspan="1">Trp-762(NE1)</td><td align="center" rowspan="1" colspan="1">4(O)</td><td align="center" rowspan="1" colspan="1">3.11</td></tr><tr><td align="center" rowspan="1" colspan="1">Ser-624(OG)</td><td align="center" rowspan="1" colspan="1">13(O)</td><td align="center" rowspan="1" colspan="1">2.93</td></tr></tbody></table></table-wrap><table-wrap id="T1B" position="float"><label>Table 1b</label><caption><title>List of hydrogen bonding interactions between the phosphonate inhibitors and mycolyltransferase, Ag85C</title></caption><table frame="hsides" rules="groups"><thead><tr><th colspan="2" align="center" rowspan="1"/><th colspan="4" align="center" rowspan="1">Goldscore</th><th colspan="4" align="center" rowspan="1">ChemScore</th></tr></thead><tbody><tr><th align="center" rowspan="1" colspan="1">Mol Name</th><th align="center" rowspan="1" colspan="1">No. of H bonds</th><th align="center" rowspan="1" colspan="1">Protein residue atom</th><th align="center" rowspan="1" colspan="1">Ligand atom</th><th align="center" rowspan="1" colspan="1">H bond distance &#x0212b;</th><th align="center" rowspan="1" colspan="1">No. of H bonds</th><th align="center" rowspan="1" colspan="1">Protein residue atom</th><th align="center" rowspan="1" colspan="1">Ligand atom</th><th align="center" rowspan="1" colspan="1">H bond distance &#x0212b;</th></tr><tr><td rowspan="6" align="center" colspan="1">11b</td><td rowspan="6" align="center" colspan="1">7</td><td align="center" row