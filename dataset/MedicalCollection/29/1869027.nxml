mid">1984780</pub-id><pub-id pub-id-type="doi">10.1002/art.1780340113</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Twilt</surname><given-names>M</given-names></name><name><surname>Mobers</surname><given-names>SM</given-names></name><name><surname>Arends</surname><given-names>LR</given-names></name><name><surname>ten Cate</surname><given-names>R</given-names></name><name><surname>van Suijlekom-Smit</surname><given-names>L</given-names></name></person-group><article-title>Temporomandibular involvement in juvenile idiopathic arthritis</article-title><source>J Rheumatol</source><year>2004</year><volume>31</volume><fpage>1418</fpage><lpage>1422</lpage><pub-id pub-id-type="pmid">15229966</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Laiho</surname><given-names>K</given-names></name><name><surname>Savolainen</surname><given-names>A</given-names></name><name><surname>Kautiainen</surname><given-names>H</given-names></name><name><surname>Kekki</surname><given-names>P</given-names></name><name><surname>Kauppi</surname><given-names>M</given-names></name></person-group><article-title>The cervical spine in juvenile chronic arthritis</article-title><source>Spine J</source><year>2002</year><volume>2</volume><fpage>89</fpage><lpage>94</lpage><pub-id pub-id-type="pmid">14588266</pub-id><pub-id pub-id-type="doi">10.1016/S1529-9430(02)00151-1</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martini</surname><given-names>G</given-names></name><name><surname>Bacciliero</surname><given-names>U</given-names></name><name><surname>Tregnaghi</surname><given-names>A</given-names></name><name><surname>Montesco</surname><given-names>MC</given-names></name><name><surname>Zulian</surname><given-names>F</given-names></name></person-group><article-title>Isolated temporomandibular synovitis as unique presentation of juvenile idiopathic arthritis</article-title><source>J Rheumatol</source><year>2001</year><volume>28</volume><fpage>1689</fpage><lpage>1692</lpage><pub-id pub-id-type="pmid">11469480</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Uziel</surname><given-names>Y</given-names></name><name><surname>Rathaus</surname><given-names>V</given-names></name><name><surname>Pomeranz</surname><given-names>A</given-names></name><name><surname>Solan</surname><given-names>H</given-names></name><name><surname>Wolach</surname><given-names>B</given-names></name></person-group><article-title>Torticollis as the sole initial presenting sign of systemic onset juvenile rheumatoid arthritis</article-title><source>J Rheumatol</source><year>1998</year><volume>25</volume><fpage>166</fpage><lpage>172</lpage><pub-id pub-id-type="pmid">9458223</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Henry</surname><given-names>CH</given-names></name><name><surname>Hughes</surname><given-names>CV</given-names></name><name><surname>Gerard</surname><given-names>HC</given-names></name><name><surname>Hudson</surname><given-names>AP</given-names></name><name><surname>Wolford</surname><given-names>LM</given-names></name></person-group><article-title>Reactive arthritis: preliminary microbiologic analysis of the human temporomandibular joint</article-title><source>J Oral Maxillofac Surg</source><year>2000</year><volume>58</volume><fpage>1137</fpage><lpage>1142</lpage><pub-id pub-id-type="pmid">11021709</pub-id><pub-id pub-id-type="doi">10.1053/joms.2000.9575</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fox</surname><given-names>B</given-names></name><name><surname>Sahuquillo</surname><given-names>J</given-names></nam