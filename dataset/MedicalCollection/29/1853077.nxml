er-name>Washington, D.C.: Smithsonian Institution Press</publisher-name></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rosatte</surname><given-names>RC</given-names></name></person-group><article-title>Management of raccoons (Procyon lotor) in Ontario, Canada: Do human intervention and disease have significant impact on raccoon proportions?</article-title><source>Mammalia</source><year>2000</year><volume>64</volume><fpage>369</fpage><lpage>390</lpage></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cayo</surname><given-names>MR</given-names></name><name><surname>Talbot</surname><given-names>TO</given-names></name></person-group><article-title>Positional error in automated geocoding of residential addresses</article-title><source>Int J Health Geogr</source><year>2003</year><volume>2</volume><fpage>10</fpage><pub-id pub-id-type="pmid">14687425</pub-id><pub-id pub-id-type="doi">10.1186/1476-072X-2-10</pub-id></citation></ref><ref id="B24"><citation citation-type="other"><article-title>The Rabies Reporter Newsletter (Vol 8&#x02013;14)</article-title><ext-link ext-link-type="uri" xlink:href="http://www.gis.queensu.ca/rreporter/"/></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cousens</surname><given-names>S</given-names></name><name><surname>Smith</surname><given-names>PG</given-names></name><name><surname>Ward</surname><given-names>H</given-names></name><name><surname>Everington</surname><given-names>D</given-names></name><name><surname>Knight</surname><given-names>RSG</given-names></name><name><surname>Zeidler</surname><given-names>M</given-names></name><name><surname>Stewart</surname><given-names>G</given-names></name><name><surname>Smith-Bathgate</surname><given-names>EAB</given-names></name><name><surname>Macleod</surname><given-names>MA</given-names