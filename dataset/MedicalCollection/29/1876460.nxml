doi">10.1002/(SICI)1097-0258(19980430)17:8&#x0003c;873::AID-SIM779&#x0003e;3.0.CO;2-I</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simel</surname><given-names>DL</given-names></name><name><surname>Samsa</surname><given-names>GP</given-names></name><name><surname>Matchar</surname><given-names>DB</given-names></name></person-group><article-title>Likelihood ratios with confidence: sample size estimation for diagnostic test studies</article-title><source>J Clin Epidemiol</source><year>1991</year><volume>44</volume><fpage>763</fpage><lpage>770</lpage><pub-id pub-id-type="pmid">1941027</pub-id><pub-id pub-id-type="doi">10.1016/0895-4356(91)90128-V</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Steurer</surname><given-names>J</given-names></name><name><surname>Fischer</surname><given-names>JE</given-names></name><name><surname>Bachmann</surname><given-names>LM</given-names></name><name><surname>Koller</surname><given-names>M</given-names></name><name><surname>ter Riet</surname><given-names>G</given-names></name></person-group><article-title>Communicating accuracy of tests to general practitioners: a controlled study</article-title><source>Bmj</source><year>2002</year><volume>324</volume><fpage>824</fpage><lpage>826</lpage><pub-id pub-id-type="pmid">11934776</pub-id><pub-id pub-id-type="doi">10.1136/bmj.324.7341.824</pub-id></citation></ref></ref-list></back></article>