in Intellegent Systems: Networks of Plausible Inference.</source><year>1988</year><publisher-loc>San Mateo, California</publisher-loc><publisher-name>Morgan Kaufman</publisher-name></citation></ref><ref id="R15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ikeda</surname><given-names>M</given-names></name><etal/></person-group><source>Nucleic Acids Res</source><year>2003</year><volume>31</volume><fpage>406</fpage><pub-id pub-id-type="pmid">12520035</pub-id></citation></ref><ref id="R16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gardy</surname><given-names>JL</given-names></name><etal/></person-group><source>Nucleic Acids Res</source><year>2003</year><volume>31</volume><fpage>3613</fpage><pub-id pub-id-type="pmid">12824378</pub-id></citation></ref></ref-list><sec sec-type="display-objects"><title>Figures and Tables</title><table-wrap id="T1" position="float"><label>Table 1</label><caption><title>Performance of the alpha-helical predictor</title></caption><table frame="hsides" rules="groups"><thead><tr><th align="center" valign="top" rowspan="1" colspan="1">Sequence type</th><th align="center" valign="top" rowspan="1" colspan="1">LOO crossvalidation (%)</th><th align="center" valign="top" rowspan="1" colspan="1">5-fold crossvalidation (%)</th><th align="center" valign="top" rowspan="1" colspan="1">MCC (%)</th></tr></thead><tbody><tr><td rowspan="1" colspan="1">Prokaryotic</td><td rowspan="1" colspan="1">77.4</td><td rowspan="1" colspan="1">75.2</td><td rowspan="1" colspan="1">0.856</td></tr><tr><td rowspan="1" colspan="1">Eukaryotic</td><td rowspan="1" colspan="1">61.4</td><td rowspan="1" colspan="1">58.6</td><td rowspan="1" colspan="1">0.795</td></tr></tbody></table></table-wrap></sec><fn-group><fn id="FN1" fn-type="other"><p>      <bold>Citation:</bold>Taylor            <italic>et al.</italic>, Bioinformation 1(6): 234-236 (2006) </p></fn></