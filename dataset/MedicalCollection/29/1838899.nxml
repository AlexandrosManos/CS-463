me><name><surname>Register</surname><given-names>E</given-names></name><name><surname>Curotto</surname><given-names>J</given-names></name><name><surname>Kurtz</surname><given-names>M</given-names></name><name><surname>Kelly</surname><given-names>R</given-names></name></person-group><article-title>An improved protocol for the preparation of yeast cells for transformation by electroporation</article-title><source>Yeast</source><year>1998</year><volume>14</volume><fpage>565</fpage><lpage>571</lpage><pub-id pub-id-type="pmid">9605506</pub-id></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Sambrook</surname><given-names>JE</given-names></name><name><surname>Russel</surname><given-names>DW</given-names></name></person-group><source>Molecular cloning: A laboratory manual</source><year>2001</year><publisher-name>New York: Cold Spring Harbor Laboratory Press</publisher-name></citation></ref></ref-list><sec sec-type="display-objects"><title>Figures and Tables</title><fig position="float" id="F1"><label>Figure 1</label><caption><p>The shuttle vector pTRKH3.</p></caption><graphic xlink:href="1472-6750-7-15-1"/></fig><table-wrap position="float" id="T1"><label>Table 1</label><caption><p>DNA transformation efficiency of <italic>L. lactis </italic>spp. <italic>lactis </italic>cells with and without pretreatment with LiAc and DTT. Results are the mean (&#x000b1; SD) of 6 replications</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="center">LiAc (mM)</td><td align="center">DTT (mM)</td><td align="center" colspan="2">Transformants/&#x003bc;g DNA</td></tr><tr><td></td><td></td><td align="center"><italic>L. lactis </italic>LM0230</td><td align="center"><italic>L. lactis </italic>ATCC 11454</td></tr></thead><tbody><tr><td align="center">0</td><td align="center">0</td><td align="center">1.20 &#x000b1; 0.50 &#x000d7; 10<sup>5</sup></td><td align="center">1.00 &#x000b1; 0.48 &#x000d7; 10<sup>4</sup></td></tr><tr><td align="center">100</td><td align="center">0</td><td align="center">1.10 &#x000b1; 0.52 &#x000d7; 10<sup>5</sup></td><td align="center">1.20 &#x000b1; 0.50 &#x000d7; 10<sup>4</sup></td></tr><tr><td align="center">0</td><td align="center">10</td><td align="center">13.00 &#x000b1; 8.02 &#x000d7; 10<sup>6</sup></td><td align="center">7.00 &#x000b1; 5.01 &#x000d7; 10<sup>5</sup></td></tr><tr><td align="center">100</td><td align="center">10</td><td align="center">225.00 &#x000b1; 52.51 &#x000d7; 10<sup>7</sup></td><td align="center">117.00 &#x000b1; 42.55 &#x000d7; 10<sup>6</sup></td></tr></tbody></table></table-wrap><table-wrap position="float" id="T2"><label>Table 2</label><caption><p>Effect of cell density on transformation efficiency of <italic>L. lactis </italic>spp. <italic>lactis </italic>LM0230. Results are the mean (&#x000b1; SD) of 6 replications</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="center">Cells &#x000d7; 10<sup>9</sup>/ml</td><td align="center">Transformants/&#x003bc;g DNA</td></tr></thead><tbody><tr><td align="center">0.5</td><td align="center">5.00 &#x000b1; 0.75 &#x000d7; 10<sup>7</sup></td></tr><tr><td align="center">1.0</td><td align="center">22.00 &#x000b1; 13.00 &#x000d7; 10<sup>7</sup></td></tr><tr><td align="center">2.5</td><td align="center">53.60 &#x000b1; 27.12 &#x000d7; 10<sup>7</sup></td></tr><tr><td align="center">5.0</td><td align="center">162.00 &#x000b1; 75.40 &#x000d7; 10<sup>7</sup></td></tr><tr><td align="center">10</td><td align="center">221.00&#x000b1; 50.00 &#x000d7; 10<sup>7</sup></td></tr></tbody></table></table-wrap></sec></back></article>