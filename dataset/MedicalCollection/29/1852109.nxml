StoryId=4926 "/><comment>(accessed February 24<sup>th</sup>, 2007)</comment></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Phaosavasdi</surname><given-names>S</given-names></name><name><surname>Tannirandorn</surname><given-names>Y</given-names></name><name><surname>Wilde</surname><given-names>H</given-names></name><name><surname>Taneepanichskul</surname><given-names>S</given-names></name><name><surname>Hongladarom</surname><given-names>S</given-names></name></person-group><article-title>New-world and transcultural impact on Thai medical practices and professional behaviour</article-title><source>J Med Assoc Thai</source><year>2001</year><volume>84</volume><fpage>1650</fpage><lpage>2</lpage><pub-id pub-id-type="pmid">11853312</pub-id></citation></ref></ref-list></back></article>