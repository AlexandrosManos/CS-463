f="EF059847">EF059847</ext-link>], E609 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059848">EF059848</ext-link>], E616 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059849">EF059849</ext-link>], E620 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059850">EF059850</ext-link>], E621 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059851">EF059851</ext-link>], E622 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059852">EF059852</ext-link>], E624 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059853">EF059853</ext-link>], E625 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059854">EF059854</ext-link>], E626 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059855">EF059855</ext-link>], E627 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059856">EF059856</ext-link>], E632 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059857">EF059857</ext-link>], E639 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059858">EF059858</ext-link>], E644 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059859">EF059859</ext-link>], E676 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059860">EF059860</ext-link>], E680 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059861">EF059861</ext-link>], E681 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059862">EF059862</ext-link>], E688 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059863">EF059863</ext-link>], E694 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059864">EF059864</ext-link>], E717 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059865">EF059865</ext-link>], E739 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059867">EF059867</ext-link>], E757 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059869">EF059869</ext-link>], E761 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059870">EF059870</ext-link>], E768 [GenBank: <ext-link ext-link-type="gen" xlink:href="EF059871">EF059871</ext-link>], E769 [G