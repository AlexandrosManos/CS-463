Y752939">AY752939</ext-link>], z858 [GenBank: <ext-link ext-link-type="gen" xlink:href="AY752936">AY752936</ext-link>], z954 [GenBank: <ext-link ext-link-type="gen" xlink:href="AY752938">AY752938</ext-link>], zES11 [GenBank: <ext-link ext-link-type="gen" xlink:href="AY803187">AY803187</ext-link>], zES4 [GenBank: <ext-link ext-link-type="gen" xlink:href="AY803186">AY803186</ext-link>], zESVO7 [GenBank: <ext-link ext-link-type="gen" xlink:href="AY803189">AY803189</ext-link>].</p></sec></sec><sec><title>Authors' contributions</title><p>CI performed the biochemical profiling and collated the data. AL and RS analyzed the 16S rRNA gene sequences. NM and SF performed the statistical analysis of the phenotypic data. EB and JM performed the Ribotyping and analysis. IC is responsible for the f-AFLP analysis at the BCCM/LMG Bacteria Collection, where the AFLP analyses were performed. HJ managed the project and edited the manuscript. All authors contributed to the text and read and approved the final manuscript.</p></sec><sec sec-type="supplementary-material"><title>Supplementary Material</title><supplementary-material content-type="local-data" id="S1"><caption><title>Additional file 1</title><p>Description of <italic>E. sakazakii </italic>biogroups.</p></caption><media xlink:href="1471-2148-7-64-S1.doc" mimetype="application" mime-subtype="msword"><caption><p>Click here for file</p></caption></media></supplementary-material></sec></body><back><ack><sec><title>Acknowledgements</title><p>The authors would like to acknowledge Nicole Garofalo (NRC) for assistance with the biochemical tests, Tracy Clegg (UCD) for statistical analysis of biochemical data and Marjan De Wachter for performing the AFLP analyses. Also to thank Johan Goris for advice on DNA-DNA hybridization methods, Jim Farmer for advice on the taxonomy of <italic>Enterobacteriaceae</italic>, and Jean-Paul Euz&#x000e9;by for advice on appropriate latinization of names. Phonetic pronunciations are based on the American Heritage<sup>&#x000ae; </sup>Dictionary. NM and SF acknowledge the financial support provided through the Irish Governments FIRM programme project no.: 05/R&#x00026;D/D/363. The AFLP<sup>&#x000ae; </sup>technology is subject to patents and patent applications and AFLP<sup>&#x000ae; </sup>is a registered trademark, all owned by Keygene N.V., the Netherlands. The BCCM/LMG Bacteria collection is supported by the Prime Minister's Services &#x02013; Federal Office for Scientific, Technical and Cultural Affairs, Belgium.</p></sec></ack><ref-list><ref id="B1"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Farmer</surname><given-names>JJ</given-names><suffix>III</suffix></name><name><surname>Asbury</surname><given-names>MA</given-names></name><name><surname>Hickman</surname><given-names>FW</given-names></name><name><surname>Brenner</surname><given-names>DJ</given-names></name><collab>the Enterobacteriaceae Study Group (USA)</collab></person-group><article-title><italic>Enterobacter sakazakii</italic>: a new species of "<italic>Enterobacteriaceae</italic>" isolated from clinical specimens</article-title><source>Int J Syst Bacteriol</source><year>1980</year><volume>30</volume><fpage>569</fpage><lpage>584</lpage></citation></ref><ref id="B2"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Iversen</surname><given-names>C</given-names></name><name><surname>Waddington</surname><given-names>M</given-names></name><name><surname>On</surname><given-names>SL</given-names></name><name><surname>Forsythe</surname><given-names>S</given-names></name></person-group><article-title>Identification and phylogeny of <italic>Enterobacter sakazakii </italic>relative to <italic>Enterobacter </italic>and <italic>Citrobacter </italic>species</article-title><source>J Clin Microbiol</source><year>2004</year><volume>42</volume><fpage>5368</fpage><lpage>5370</lpage><pub-id pub-id-type="pmid">15528745</pub-id><pub-id pub-i