mes></name></person-group><article-title>Human bone marrow stromal cells express a distinct set of biologically functional chemokine receptors</article-title><source>Stem Cells</source><year>2006</year><volume>24</volume><fpage>1030</fpage><lpage>1041</lpage><pub-id pub-id-type="pmid">16253981</pub-id><pub-id pub-id-type="doi">10.1634/stemcells.2005-0319</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Song</surname><given-names>L</given-names></name><name><surname>Webb</surname><given-names>NE</given-names></name><name><surname>Song</surname><given-names>Y</given-names></name><name><surname>Tuan</surname><given-names>RS</given-names></name></person-group><article-title>Identification and functional analysis of candidate genes regulating mesenchymal stem cell self-renewal and multipotency</article-title><source>Stem Cells</source><year>2006</year><volume>24</volume><fpage>1707</fpage><lpage>1718</lpage><pub-id pub-id-type="pmid">16574750</pub-id><pub-id pub-id-type="doi">10.1634/stemcells.2005-0604</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jiang</surname><given-names>Y</given-names></name><name><surname>Vaessen</surname><given-names>B</given-names></name><name><surname>Lenvik</surname><given-names>T</given-names></name><name><surname>Blackstad</surname><given-names>M</given-names></name><name><surname>Reyes</surname><given-names>M</given-names></name><name><surname>Verfaillie</surname><given-names>CM</given-names></name></person-group><article-title>Multipotent progenitor cells can be isolated from postnatal murine bone marrow, muscle, and brain</article-title><source>Exp Hematol</source><year>2002</year><volume>30</volume><fpage>896</fpage><lpage>904</lpage><pub-id pub-id-type="pmid">12160841</pub-id><pub-id pub-id-type="doi">10.1016/S0301-472X(02)00869-X</pub-id></citation></ref><ref id="B15"><citati