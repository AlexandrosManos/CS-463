pe="journal"><person-group person-group-type="author"><name><surname>Bensidhoum</surname><given-names>M</given-names></name><name><surname>Chapel</surname><given-names>A</given-names></name><name><surname>Francois</surname><given-names>S</given-names></name><name><surname>Demarquay</surname><given-names>C</given-names></name><name><surname>Mazurier</surname><given-names>C</given-names></name><name><surname>Fouillard</surname><given-names>L</given-names></name><name><surname>Bouchet</surname><given-names>S</given-names></name><name><surname>Bertho</surname><given-names>JM</given-names></name><name><surname>Gourmelon</surname><given-names>P</given-names></name><name><surname>Aigueperse</surname><given-names>J</given-names></name><etal></etal></person-group><article-title>Homing of in vitro expanded Stro-1- or Stro-1+ human mesenchymal stem cells into the NOD/SCID mouse and their role in supporting human CD34 cell engraftment</article-title><source>Blood</source><year>2004</year><volume>103</volume><fpage>3313</fpage><lpage>3319</lpage><pub-id pub-id-type="pmid">14715641</pub-id><pub-id pub-id-type="doi">10.1182/blood-2003-04-1121</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carter</surname><given-names>RA</given-names></name><name><surname>Wicks</surname><given-names>IP</given-names></name></person-group><article-title>Vascular cell adhesion molecule 1 (CD106): a multifaceted regulator of joint inflammation</article-title><source>Arthritis Rheum</source><year>2001</year><volume>44</volume><fpage>985</fpage><lpage>994</lpage><pub-id pub-id-type="pmid">11352261</pub-id><pub-id pub-id-type="doi">10.1002/1529-0131(200105)44:5&#x0003c;985::AID-ANR176&#x0003e;3.0.CO;2-P</pub-id></citation></ref><ref id="B9"><citation citation-type="other"><article-title>PROW: CD73</article-title><ext-link ext-link-type="uri" xlink:href="http://mpr.nci.nih.gov/PROW/guide/1470319548_g.htm"/></citation></ref><re