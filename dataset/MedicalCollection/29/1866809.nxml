pub-id-type="pmid">11313775</pub-id><pub-id pub-id-type="doi">10.1038/sj.ejhg.5200625</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lake</surname><given-names>S</given-names></name><name><surname>Blacker</surname><given-names/></name><name><surname>Laird</surname><given-names>N</given-names></name></person-group><article-title>Family based tests in the presence of association</article-title><source>Am J Hum Genet</source><year>2001</year><volume>67</volume><fpage>1515</fpage><lpage>1525</lpage><pub-id pub-id-type="pmid">11058432</pub-id><pub-id pub-id-type="doi">10.1086/316895</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sullivan</surname><given-names>PF</given-names></name><name><surname>Neale</surname><given-names>BM</given-names></name><name><surname>Neale</surname><given-names>MC</given-names></name><name><surname>van den Oord</surname><given-names>E</given-names></name><name><surname>Kendler</surname><given-names>KS</given-names></name></person-group><article-title>Multipoint and single point non-parametric linkage analysis with imperfect data</article-title><source>Am J Med Genet</source><year>2003</year><volume>121B</volume><fpage>89</fpage><lpage>94</lpage><pub-id pub-id-type="doi">10.1002/ajmg.b.20069</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Foroud</surname><given-names>T</given-names></name><name><surname>Edenberg</surname><given-names>HJ</given-names></name><name><surname>Goate</surname><given-names>A</given-names></name><name><surname>Rice</surname><given-names>J</given-names></name><name><surname>Flury</surname><given-names>L</given-names></name><name><surname>Koller</surname><given-names>DL</given-names></name><name><surname>Bierut</surname><given-names>LJ</given-names></name><name><surname>Conneally</sur