ven-names></name><name><surname>Shafiee</surname><given-names>A</given-names></name><name><surname>Saemian</surname><given-names>N</given-names></name><name><surname>Shirvani</surname><given-names>G</given-names></name><name><surname>Daha</surname><given-names>FJ</given-names></name></person-group><source>Applied Radiation and Isotopes</source><year>2004</year><volume>60</volume><fpage>665</fpage><pub-id pub-id-type="pmid">15082044</pub-id><pub-id pub-id-type="doi">10.1016/j.apradiso.2003.12.003</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Elnagdi</surname><given-names>MH</given-names></name><name><surname>Elmoghayer</surname><given-names>MRH</given-names></name><name><surname>Hafez</surname><given-names>EA</given-names></name><name><surname>Almina</surname><given-names>HH</given-names></name></person-group><source>J Org Chem</source><year>1975</year><volume>40</volume><fpage>2604</fpage><pub-id pub-id-type="doi">10.1021/jo00906a007</pub-id></citation></ref><ref id="B11"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Ghozlan</surname><given-names>SAS</given-names></name><name><surname>Abdelhamid</surname><given-names>IA</given-names></name><name><surname>Elnagdi</surname><given-names>MH</given-names></name></person-group><source>Arkivoc</source><year>2006</year><volume>XV</volume><fpage>53</fpage></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Fan</surname><given-names>WQ</given-names></name><name><surname>Katritzky</surname><given-names>AR</given-names></name></person-group><source>Comprehensive Heterocyclic Chemistry II</source><year>1996</year><volume>4</volume><publisher-name>Elsevier: New York</publisher-name></citation></ref><ref id="B13"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Tiemann</surname><given-names>F</given-names></name></person-group><source>Chem Ber</source><year>1891</year><volume>24</volume><fpage>4162</fpage></citation></ref><ref id="B14"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Al-Matar</surname><given-names>H</given-names></name><name><surname>Riyadh</surname><given-names>SM</given-names></name><name><surname>Elnagdi</surname><given-names>MH</given-names></name></person-group><source>Tetrahedron</source><year>2006</year><comment></comment></citation></ref><ref id="B15"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Al-Saleh</surname><given-names>B</given-names></name><name><surname>El-Apasery</surname><given-names>MA</given-names></name><name><surname>Abdel-Aziz</surname><given-names>RS</given-names></name><name><surname>Elnagdi</surname><given-names>MH</given-names></name></person-group><source>J Heterocyclic Chem</source><year>2005</year><volume>42</volume><fpage>563</fpage></citation></ref></ref-list></back></article>