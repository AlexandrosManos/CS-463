id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kapur</surname><given-names>S</given-names></name><name><surname>Mann</surname><given-names>JJ</given-names></name></person-group><article-title>Role of the dopaminergic system in depression</article-title><source>Biol Psychiatry</source><year>1992</year><volume>32</volume><fpage>1</fpage><lpage>17</lpage><pub-id pub-id-type="pmid">1391289</pub-id><pub-id pub-id-type="doi">10.1016/0006-3223(92)90137-O</pub-id></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Golomb</surname><given-names>BA</given-names></name><collab>(Ed)</collab></person-group><article-title>Further discussion of the acetylcholine-serotonin relationship</article-title><source>Pyridostigmine bromide (A review of the scientific literature as it pertains to Gulf War illnesses)</source><year>1999</year><volume>2</volume><publisher-name>Washington (DC): RAND Corporation</publisher-name><fpage>299</fpage><lpage>301</lpage></citation></ref></ref-list></back></article>