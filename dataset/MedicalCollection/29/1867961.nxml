-group><year>2001</year><article-title>Particulate matter and heart rate variability among elderly retirees: the Baltimore 1998 PM study</article-title><source>J Expo Anal Environ Epidemiol</source><volume>11</volume><fpage>116</fpage><lpage>122</lpage><pub-id pub-id-type="pmid">11409004</pub-id></element-citation></ref><ref id="b10-ehp0115-000769"><element-citation publication-type="journal"><person-group><name><surname>Dhalla</surname><given-names>NS</given-names></name><name><surname>Temsah</surname><given-names>RM</given-names></name><name><surname>Netticadan</surname><given-names>T</given-names></name></person-group><year>2000</year><article-title>Role of oxidative stress in cardiovascular diseases</article-title><source>J Hypertens</source><volume>18</volume><fpage>655</fpage><lpage>673</lpage><pub-id pub-id-type="pmid">10872549</pub-id></element-citation></ref><ref id="b11-ehp0115-000769"><element-citation publication-type="journal"><person-group><name><surname>D&#x02019;Ippoliti</surname><given-names>D</given-names></name><name><surname>Forastiere</surname><given-names>F</given-names></name><name><surname>Ancona</surname><given-names>C</given-names></name><name><surname>Agabiti</surname><given-names>N</given-names></name><name><surname>Fusco</surname><given-names>D</given-names></name><name><surname>Michelozzi</surname><given-names>P</given-names></name><etal/></person-group><year>2003</year><article-title>Air pollution and myocardial infarction in Rome: a case-crossover analysis</article-title><source>Epidemiology</source><volume>14</volume><fpage>528</fpage><lpage>535</lpage><pub-id pub-id-type="pmid">14501267</pub-id></element-citation></ref><ref id="b12-ehp0115-000769"><element-citation publication-type="journal"><person-group><name><surname>Dockery</surname><given-names>DW</given-names></name></person-group><year>2001</year><article-title>Epidemiologic evidence of cardiovascular effects of particulate air pollution</article-title><source>Environ Health Perspect</source><volume>109</volume><fpage>483</fpage><lpage>486</lpage><pub-id pub-id-type="pmid">11544151</pub-id></element-citation></ref><ref id="b13-ehp0115-000769"><element-citation publication-type="journal"><person-group><name><surname>Dockery</surname><given-names>DW</given-names></name><name><surname>Pope</surname><given-names>CA</given-names><suffix>III</suffix></name><name><surname>Xu</surname><given-names>X</given-names></name><name><surname>Spengler</surname><given-names>JD</given-names></name><name><surname>Ware</surname><given-names>JH</given-names></name><name><surname>Fay</surname><given-names>ME</given-names></name><etal/></person-group><year>1993</year><article-title>An association between air pollution and mortality in six U.S. Cities</article-title><source>N Engl J Med</source><volume>329</volume><fpage>1753</fpage><lpage>1759</lpage><pub-id pub-id-type="pmid">8179653</pub-id></element-citation></ref><ref id="b14-ehp0115-000769"><element-citation publication-type="journal"><person-group><name><surname>Ewing</surname><given-names>DJ</given-names></name></person-group><year>1991</year><article-title>Heart rate variability: an important new risk factor in patients following myocardial infarction</article-title><source>Clin Cardiol</source><volume>14</volume><fpage>683</fpage><lpage>685</lpage><pub-id pub-id-type="pmid">1914273</pub-id></element-citation></ref><ref id="b15-ehp0115-000769"><element-citation publication-type="journal"><person-group><name><surname>Ghio</surname><given-names>AJ</given-names></name><name><surname>Kim</surname><given-names>C</given-names></name><name><surname>Devlin</surname><given-names>RB</given-names></name></person-group><year>2000</year><article-title>Concentrated ambient air particles induce mild pulmonary inflammation in healthy human volunteers</article-title><source>Am J Respir Crit Care Med</source><volume>162</volume><fpage>981</fpage><lpage>988</lpage><pub-id pub-id-type="pmid">10988117</pub-id></element-cit