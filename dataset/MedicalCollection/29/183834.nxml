</person-group><article-title>Common methodological problems in factor analytic studies</article-title><source>Journal of Consulting &#x00026; Clinical Psychology</source><year>1978</year><volume>46</volume><fpage>648</fpage><lpage>659</lpage><pub-id pub-id-type="doi">10.1037//0022-006X.46.4.648</pub-id></citation></ref><ref id="B28"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Tabachnick</surname><given-names>Barbara G.</given-names></name><name><surname>Fidell</surname><given-names>Linda S.</given-names></name></person-group><source>Using multivariate statistics</source><year>1989</year><edition>2nd</edition><publisher-name>New York, Harper &#x00026; Row</publisher-name><fpage>xxii, 746 p.</fpage></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kasper</surname><given-names>MJ</given-names></name><name><surname>Peterson</surname><given-names>MG</given-names></name><name><surname>Allegrante</surname><given-names>JP</given-names></name></person-group><article-title>The need for comprehensive educational osteoporosis prevention programs for young women: results from a second osteoporosis prevention survey</article-title><source>Arthritis Rheum</source><year>2001</year><volume>45</volume><fpage>28</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">11308058</pub-id><pub-id pub-id-type="doi">10.1002/1529-0131(200102)45:1&#x0003c;28::AID-ANR80&#x0003e;3.3.CO;2-7</pub-id></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ailinger</surname><given-names>RL</given-names></name><name><surname>Emerson</surname><given-names>J</given-names></name></person-group><article-title>Women's knowledge of osteoporosis</article-title><source>Appl Nurs Res</source><year>1998</year><volume>11</volume><fpage>111</fpage><lpage>114</lpage><pub-id pub-id-type="pmid">9757610</pub-id></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Piaseu</surname><given-names>N</given-names></name><name><surname>Belza</surname><given-names>B</given-names></name><name><surname>Mitchell</surname><given-names>P</given-names></name></person-group><article-title>Testing the effectiveness of an osteoporosis educational program for nursing students in Thailand</article-title><source>Arthritis Rheum</source><year>2001</year><volume>45</volume><fpage>246</fpage><lpage>251</lpage><pub-id pub-id-type="pmid">11409665</pub-id><pub-id pub-id-type="doi">10.1002/1529-0131(200106)45:3&#x0003c;246::AID-ART256&#x0003e;3.3.CO;2-P</pub-id></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ribeiro</surname><given-names>V</given-names></name><name><surname>Blakeley</surname><given-names>J</given-names></name><name><surname>Laryea</surname><given-names>M</given-names></name></person-group><article-title>Women's knowledge and practices regarding the prevention and treatment of osteoporosis</article-title><source>Health Care Women Int</source><year>2000</year><volume>21</volume><fpage>347</fpage><lpage>353</lpage><pub-id pub-id-type="pmid">11813780</pub-id><pub-id pub-id-type="doi">10.1080/073993300245195</pub-id></citation></ref><ref id="B33"><citation citation-type="book"><source>Health and Wellbeing in Tasmania</source><year>1999</year><publisher-name>Hobart, Department of Health and Human Services</publisher-name></citation></ref></ref-list></back></article>