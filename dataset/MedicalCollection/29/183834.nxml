><given-names>SL</given-names></name></person-group><article-title>Osteoporosis prevention in premenopausal women: using a stage model approach to examine the predictors of behavior</article-title><source>Health Psychol</source><year>1996</year><volume>15</volume><fpage>84</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">8681924</pub-id><pub-id pub-id-type="doi">10.1037//0278-6133.15.2.84</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Phillipov</surname><given-names>G</given-names></name><name><surname>Phillips</surname><given-names>PJ</given-names></name><name><surname>Leach</surname><given-names>G</given-names></name><name><surname>Taylor</surname><given-names>AW</given-names></name></person-group><article-title>Public perceptions and self-reported prevalence of osteoporosis in South Australia</article-title><source>Osteoporos Int</source><year>1998</year><volume>8</volume><fpage>552</fpage><lpage>556</lpage><pub-id pub-id-type="pmid">10326060</pub-id><pub-id pub-id-type="doi">10.1007/s001980050098</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Magnus</surname><given-names>JH</given-names></name><name><surname>Joakimsen</surname><given-names>RM</given-names></name><name><surname>Berntsen</surname><given-names>GK</given-names></name><name><surname>Tollan</surname><given-names>A</given-names></name><name><surname>Soogaard</surname><given-names>AJ</given-names></name></person-group><article-title>What do Norwegian women and men know about osteoporosis?</article-title><source>Osteoporos Int</source><year>1996</year><volume>6</volume><fpage>32</fpage><lpage>36</lpage><pub-id pub-id-type="pmid">8845597</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Waller</surname><given-names>J</given-names></name><name><surname>Eriksson</sur