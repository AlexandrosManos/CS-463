tion></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Papanikolaou</surname><given-names>EG</given-names></name><name><surname>Bourgain</surname><given-names>C</given-names></name><name><surname>Kolibianakis</surname><given-names>E</given-names></name><name><surname>Tournaye</surname><given-names>H</given-names></name><name><surname>Devroey</surname><given-names>P</given-names></name></person-group><article-title>Steroid recepter expression in late follicular phase endometrium in GnRH antagonist IVF cycles is already transformation in the absence of secretory changes</article-title><source>Hum Reprod</source><year>2005</year><volume>20</volume><fpage>1541</fpage><lpage>1547</lpage><pub-id pub-id-type="pmid">15705618</pub-id><pub-id pub-id-type="doi">10.1093/humrep/deh793</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Friedler</surname><given-names>S</given-names></name><name><surname>Gilboa</surname><given-names>S</given-names></name><name><surname>Schachter</surname><given-names>M</given-names></name><name><surname>Raziel</surname><given-names>A</given-names></name><name><surname>Strassburger</surname><given-names>D</given-names></name><name><surname>Ron</surname><given-names>ELR</given-names></name></person-group><article-title>Luteal phase characteristics following GnRH antagonist or agonist treatment &#x02013; a comparative study</article-title><source>Reprod Biomed Online</source><year>2006</year><volume>12</volume><fpage>27</fpage><lpage>32</lpage><pub-id pub-id-type="pmid">16454930</pub-id></citation></ref></ref-list></back></article>