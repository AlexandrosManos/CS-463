title><source>Nature Genet</source><year>1999</year><volume>23</volume><fpage>151</fpage><lpage>157</lpage><pub-id pub-id-type="pmid">10508510</pub-id><pub-id pub-id-type="doi">10.1038/13783</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burley</surname><given-names>SK</given-names></name></person-group><article-title>An overview of structural genomics</article-title><source>Nature Struct Biol</source><year>2000</year><volume>7</volume><fpage>932</fpage><lpage>934</lpage><pub-id pub-id-type="pmid">11103991</pub-id><pub-id pub-id-type="doi">10.1038/80697</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brenner</surname><given-names>SE</given-names></name></person-group><article-title>A tour of structural genomics</article-title><source>Nature Rev Genet</source><year>2001</year><volume>2</volume><fpage>801</fpage><lpage>809</lpage><pub-id pub-id-type="pmid">11584296</pub-id><pub-id pub-id-type="doi">10.1038/35093574</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stevens</surname><given-names>RC</given-names></name><name><surname>Yokoyama</surname><given-names>S</given-names></name><name><surname>Wilson</surname><given-names>IA</given-names></name></person-group><article-title>Global efforts in structural genomics</article-title><source>Science</source><year>2001</year><volume>294</volume><fpage>89</fpage><lpage>92</lpage><pub-id pub-id-type="pmid">11588249</pub-id><pub-id pub-id-type="doi">10.1126/science.1066011</pub-id></citation></ref><ref id="B19"><citation citation-type="other"><article-title>Concept Clearance for the PSI-2 Production Phase</article-title><ext-link ext-link-type="uri" xlink:href="http://www.nigms.nih.gov/News/Reports/council-psi-sept03.htm"/></citation></ref><ref id="B20"><citation citation-type="journal"><