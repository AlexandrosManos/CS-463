me><surname>Merelli</surname><given-names>E</given-names></name></person-group><article-title>Hermes: agent-base middleware for mobile computing</article-title><source>Mobile Computing, LNCS</source><year>2005</year><volume>3465</volume><fpage>234</fpage><lpage>270</lpage></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ye</surname><given-names>J</given-names></name><name><surname>McGinnis</surname><given-names>S</given-names></name><name><surname>Madden</surname><given-names>T</given-names></name></person-group><article-title>BLAST: improvements for better sequence analysis</article-title><source>Nucleic Acids Res</source><year>2006</year><volume>34</volume><fpage>W6</fpage><lpage>W9</lpage><pub-id pub-id-type="pmid">16845079</pub-id><pub-id pub-id-type="doi">10.1093/nar/gkl164</pub-id></citation></ref><ref id="B18"><citation citation-type="other"><article-title>DNA Data Bank of Japan</article-title><ext-link ext-link-type="uri" xlink:href="http://www.ddbj.nig.ac.jp/"/></citation></ref><ref id="B19"><citation citation-type="other"><article-title>FASTA format</article-title><ext-link ext-link-type="uri" xlink:href="http://en.wikipedia.org/wiki/Fasta_format"/></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thompson</surname><given-names>J</given-names></name><name><surname>Higgins</surname><given-names>D</given-names></name><name><surname>Gibson</surname><given-names>T</given-names></name></person-group><article-title>CLUSTAL W: improving the sensitivity of progressive multiple sequence alignment through sequence weighting, position-specific gap penalties and weight matrix choice</article-title><source>Nucleic Acids Res</source><year>1994</year><volume>22</volume><fpage>4673</fpage><lpage>4680</lpage><pub-id pub-id-type="pmid">7984417</pub-id><pub-id pub-id-type="doi">10.1093/nar/22.22.4673</pub-id></citation></ref><ref id="B21"><citation citation-type="other"><article-title>A flash presentation of BioWMS</article-title><ext-link ext-link-type="uri" xlink:href="http://litbio.cs.unicam.it/biowms/video.html"/></citation></ref><ref id="B22"><citation citation-type="other"><article-title>XSLT: XSL Transformations</article-title><ext-link ext-link-type="uri" xlink:href="http://www.w3.org/TR/xslt"/></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cannata</surname><given-names>N</given-names></name><name><surname>Merelli</surname><given-names>E</given-names></name><name><surname>Altman</surname><given-names>R</given-names></name></person-group><article-title>Time to Organize the Bioinformatics Resourceome</article-title><source>PloS Computational Biology</source><year>2005</year><volume>1</volume><ext-link ext-link-type="uri" xlink:href="http://dx.doi.org/10.1371/journal.pcbi.0010076"/><pub-id pub-id-type="pmid">16738704</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jennings</surname><given-names>N</given-names></name><name><surname>R</surname><given-names>N</given-names></name></person-group><article-title>On Agent based Software Engineering</article-title><source>Artificial Intelligence</source><year>2000</year><volume>117</volume><fpage>277</fpage><lpage>296</lpage><pub-id pub-id-type="doi">10.1016/S0004-3702(99)00107-1</pub-id></citation></ref><ref id="B25"><citation citation-type="other"><article-title>Site of HermesV2</article-title><ext-link ext-link-type="uri" xlink:href="http://hermes.cs.unicam.it/"/></citation></ref><ref id="B26"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Bartocci</surname><given-names>E</given-names></name><name><surname>Mariani</surname><given-names>L</given-names></name><name><surname>Merelli</surname><given-names>E</given-names></name></person-group><article-title>An XML view of the "World"</article-title><source>ICEIS (1)</source><year>2003</year><fpage>19</fpage><lpage>27</lpage></citation></ref><ref id="B27"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Senger</surname><given-names>M</given-names></name><name><surname>Rice</surname><given-names>P</given-names></name><name><surname>Oinn</surname><given-names>T</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Cox SJ</surname></name></person-group><article-title>Soaplab &#x02013; a unified Sesame door to analysis tools pages</article-title><source>Proceedings of UK e-Science All Hands Meeting: 2&#x02013;4 September 2003; Nottingham</source><year>2003</year><fpage>515</fpage><lpage>519</lpage></citation></ref><ref id="B28"><citation citation-type="other"><article-title>XQuery 1.0: An XML Query Language</article-title><ext-link ext-link-type="uri" xlink:href="http://www.w3.org/TR/xquery/"/></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dowell</surname><given-names>R</given-names></name><name><surname>Jokerst</surname><given-names>R</given-names></name><name><surname>Day</surname><given-names>A</given-names></name><name><surname>Eddy</surname><given-names>S</given-names></name><name><surname>Stein</surname><given-names>L</given-names></name></person-group><article-title>The distributed annotation system</article-title><source>BMC Bioinformatics</source><year>2001</year><volume>2</volume><fpage>7</fpage><pub-id pub-id-type="pmid">11667947</pub-id><pub-id pub-id-type="doi">10.1186/1471-2105-2-7</pub-id></citation></ref></ref-list><sec sec-type="display-objects"><title>Figures and Tables</title><fig position="float" id="F1"><label>Figure 1</label><caption><p><bold>BioWMS according to WfMC reference model</bold>. The WfMC Reference Model specifies a framework for workflow systems, identifying their characteristics, functions and interfaces.</p></caption><graphic xlink:href="1471-2105-8-S1-S2-1"/></fig><fig position="float" id="F2"><label>Figure 2</label><caption><p><bold>Example of a workflow in BioWMS</bold>. Screenshot of a workflow example in BioWMS. The goal is to obtain a global alignment of the Arthrobacter koreensis partial 16S rRNA gene sequence [GI:70663476] with the first three best hits of a BLAST [17] alignment in the DDBJ [18] database.</p></caption><graphic xlink:href="1471-2105-8-S1-S2-2"/></fig><fig position="float" id="F3"><label>Figure 3</label><caption><p><bold>Graphical notation of Workflow elements available in WebWFlow</bold>. BioWMS has three main elements: 1) Workflow-Start element; 2) Workflow-Stop element; 3) Workflow-Activity element.</p></caption><graphic xlink:href="1471-2105-8-S1-S2-3"/></fig><fig position="float" id="F4"><label>Figure 4</label><caption><p><bold>Setting up an activity: step-by-step</bold>. Steps required to add and set a domain specific activity: 1) Select the <italic>activity </italic>item from the multiple choice box; 2) Edit the added activity; 3) Specify the activity performer; 4) Select the activity application domain; 5) Select the user domain activity; 6) Fill the input/output formal parameters; 7) The activity is added and set.</p></caption><graphic xlink:href="1471-2105-8-S1-S2-4"/></fig><fig position="float" id="F5"><label>Figure 5</label><caption><p>Sequence Workflow patterns available using WebWFlow.</p></caption><graphic xlink:href="1471-2105-8-S1-S2-5"/></fig><fig position="float" id="F6"><label>Figure 6</label><caption><p>Concurrence Workflow patterns available using WebWFlow.</p></caption><graphic xlink:href="1471-2105-8-S1-S2-6"/></fig><fig position="float" id="F7"><label>Figure 7</label><caption><p>If Workflow patterns available using WebWFlow.</p></caption><graphic xlink:href="1471-2105-8-S1-S2-7"/></fig><fig position="float" id="F8"><label>Figure 8</label><caption><p>Iterator Workflow patterns available using WebWFlow.</p></caption><graphic xlink:href="1471-2105-8-S1-S2-8"/></fig><fig position="float" id="F9"><label>Figure 9</label><caption><p><bold>Workflow patterns available using WebWFlow</bold>. The basic workflow elements are: workflow-start element, workflow-end element and activity element. The control-flow patterns available in WebWFlow are: <italic>sequence</italic>, <italic>concurrence</italic>, <italic>if </italic>and <italic>iterator</italic>.</p></caption><graphic xlink:href="1471-2105-8-S1-S2-9"/></fig><fig position="float" id="F10"><label>Figure 10</label><caption><p><bold>Managing results</bold>. User can check at any time the state of the submitted workflows and the corresponding produced results. For each workflow is provided a measure of its execution time.</p></caption><graphic xlink:href="1471-2105-8-S1-S2-10"/></fig><fig position="float" id="F11"><label>Figure 11</label><caption><p><bold>BioWMS has been implemented over Hermes middleware</bold>. Entities located at each layer of Hermes Architecture. Any user level workflow is mapped into an agent-level workflow and compiled to a pool of mobile user agents, the Workflow Executors (WEs) which interact with Service Agents (SAs).</p></caption><graphic xlink:href="1471-2105-8-S1-S2-11"/></fig><table-wrap position="float" id="T1"><label>Table 1</label><caption><p>Application domain libraries available</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="left"><bold>Application domain library</bold></td><td align="left"><bold>Description</bold></td></tr></thead><tbody><tr><td align="left">AIXO</td><td align="left">A set of primitive activities to convert a format to XML</td></tr><tr><td align="left">Alignment</td><td align="left">A set of primitive and complex activities for sequence alignment</td></tr><tr><td align="left">BioWMS</td><td align="left">A set of primitive activities to store and to log messages in BioWMS</td></tr><tr><td align="left">Email</td><td align="left">A set of primitive activities to send emails</td></tr><tr><td align="left">Hermes</td><td align="left">A set of primitive activities to exploit Hermes middleware</td></tr><tr><td align="left">O2I</td><td align="left">A set of complex activities wrapping O2I SoapLab services</td></tr><tr><td align="left">Taverna Output</td><td align="left">A set of primitive activities to store data in Taverna format</td></tr><tr><td align="left">Util</td><td align="left">A set of primitive and complex activities to manage data</td></tr><tr><td align="left">WebServices</td><td align="left">A set of primitive activities to invoke a Web Service</td></tr><tr><td align="left">XML Manipulation</td><td align="left">A set of primitive and complex activities using XSLT and XQuery</td></tr></tbody></table></table-wrap></sec></back></article>