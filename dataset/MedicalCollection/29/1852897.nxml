icle-title>An overview on biological mechanisms of PPARs</article-title><source><italic>Pharmacological Research</italic></source><year>2005</year><volume>51</volume><issue>2</issue><fpage>85</fpage><lpage>94</lpage><pub-id pub-id-type="pmid">15629253</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cunard</surname><given-names>R</given-names></name></person-group><article-title>The potential use of PPAR<italic>&#x003b1;</italic> agonists as immunosuppressive agents</article-title><source><italic>Current Opinion in Investigational Drugs</italic></source><year>2005</year><volume>6</volume><issue>5</issue><fpage>467</fpage><lpage>472</lpage><pub-id pub-id-type="pmid">15912959</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Martinasso</surname><given-names>G</given-names></name><name><surname>Maggiora</surname><given-names>M</given-names></name><name><surname>Trombetta</surname><given-names>A</given-names></name><name><surname>Canuto</surname><given-names>RA</given-names></name><name><surname>Muzio</surname><given-names>G</given-names></name></person-group><article-title>Effects of di(2-ethylhexyl) phthalate, a widely used peroxisome proliferator and plasticizer, on cell growth in the human keratinocyte cell line NCTC 2544</article-title><source><italic>Journal of Toxicology and Environmental Health, Part A</italic></source><year>2006</year><volume>69</volume><issue>5</issue><fpage>353</fpage><lpage>365</lpage><pub-id pub-id-type="pmid">16455614</pub-id></element-citation></ref><ref id="B16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Burdick</surname><given-names>AD</given-names></name><name><surname>Kim</surname><given-names>DJ</given-names></name><name><surname>Peraza</surname><given-names>MA</given-names></name><name><surname>Gonzalez</surname><given-names>FJ</given-names></name><name><surname>Peters</surname><given-names>JM</given-names></name></person-group><article-title>The role of peroxisome proliferator-activated receptor-<italic>&#x003b2;</italic>/<italic>&#x003b4;</italic> in epithelial cell growth and differentiation</article-title><source><italic>Cellular Signalling</italic></source><year>2006</year><volume>18</volume><issue>1</issue><fpage>9</fpage><lpage>20</lpage><pub-id pub-id-type="pmid">16109478</pub-id></element-citation></ref><ref id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sampath</surname><given-names>H</given-names></name><name><surname>Ntambi</surname><given-names>JM</given-names></name></person-group><article-title>Polyunsaturated fatty acid regulation of genes of lipid metabolism</article-title><source><italic>Annual Review of Nutrition</italic></source><year>2005</year><volume>25</volume><fpage>317</fpage><lpage>340</lpage></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Maggiora</surname><given-names>M</given-names></name><name><surname>Bologna</surname><given-names>M</given-names></name><name><surname>Cer&#x000f9;</surname><given-names>MP</given-names></name><etal/></person-group><article-title>An overview of the effect of linoleic and conjugated-linoleic acids on the growth of several human tumor cell lines</article-title><source><italic>International Journal of Cancer</italic></source><year>2004</year><volume>112</volume><issue>6</issue><fpage>909</fpage><lpage>919</lpage></element-citation></ref><ref id="B19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Muzio</surname><given-names>G</given-names></name><name><surname>Trombetta</surname><given-names>A</given-names></name><name><surname>Maggiora</surname><given-names>M</given-names></name><etal/></person-group><article-title>Arachidonic acid suppresses growth of human lung tumor A549 cells through down-regulation of ALDH3A1 expression</article-title><source><italic>Free Radical Biology and Medicine</italic></source><year>2006</year><volume>40</volume><issue>11</issue><fpage>1929</fpage><lpage>1938</lpage><pub-id pub-id-type="pmid">16716894</pub-id></element-citation></ref><ref id="B20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Muzio</surname><given-names>G</given-names></name><name><surname>Martinasso</surname><given-names>G</given-names></name><name><surname>Trombetta</surname><given-names>A</given-names></name><name><surname>Di Simone</surname><given-names>D</given-names></name><name><surname>Canuto</surname><given-names>RA</given-names></name><name><surname>Maggiora</surname><given-names>M</given-names></name></person-group><article-title>HMG-CoA reductase and PPAR<italic>&#x003b1;</italic> are involved in clofibrate-induced apoptosis in human keratinocytes</article-title><source><italic>Apoptosis</italic></source><year>2006</year><volume>11</volume><issue>2</issue><fpage>265</fpage><lpage>275</lpage><pub-id pub-id-type="pmid">16502264</pub-id></element-citation></ref><ref id="B21"><label>21</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Keshamouni</surname><given-names>VG</given-names></name><name><surname>Reddy</surname><given-names>RC</given-names></name><name><surname>Arenberg</surname><given-names>DA</given-names></name><etal/></person-group><article-title>Peroxisome proliferator-activated receptor-<italic>&#x003b3;</italic> activation inhibits tumor progression in non-small-cell lung cancer</article-title><source><italic>Oncogene</italic></source><year>2004</year><volume>23</volume><issue>1</issue><fpage>1