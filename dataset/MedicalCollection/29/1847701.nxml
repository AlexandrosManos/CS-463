le><table-wrap-foot><fn id="nt101"><p>Total input of genomic DNA is 100 ng for each reaction.</p></fn><fn id="nt102"><p>P: positive. N: Negative</p></fn></table-wrap-foot></table-wrap><table-wrap id="pone-0000380-t002" position="float"><object-id pub-id-type="doi">10.1371/journal.pone.0000380.t002</object-id><label>Table 2</label><caption><title>Primers for PAMP</title></caption><graphic id="pone-0000380-t002-2" xlink:href="pone.0000380.t002"/><table frame="hsides" rules="groups" alternate-form-of="pone-0000380-t002-2"><colgroup span="1"><col align="left" span="1"/><col align="center" span="1"/><col align="center" span="1"/></colgroup><thead><tr><td align="left" rowspan="1" colspan="1">Primer</td><td align="left" rowspan="1" colspan="1">Sequence</td><td align="left" rowspan="1" colspan="1">Location</td></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1"><bold>F<sub>A1</sub></bold></td><td align="left" rowspan="1" colspan="1"><named-content content-type="gene">TTTCTGCTATTTCCTGAAC</named-content></td><td align="left" rowspan="1" colspan="1">55654&#x02013;55672</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>F<sub>A2</sub></bold></td><td align="left" rowspan="1" colspan="1"><named-content content-type="gene">CAGTATGCGTGTGCTCAG</named-content></td><td align="left" rowspan="1" colspan="1">56279&#x02013;56296</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>F<sub>A3</sub></bold></td><td align="left" rowspan="1" colspan="1"><named-content content-type="gene">AAATAGAGGTGCAGTGCTC</named-content></td><td align="left" rowspan="1" colspan="1">57913&#x02013;57931</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>F<sub>A4</sub></bold></td><td align="left" rowspan="1" colspan="1"><named-content content-type="gene">GGGAAGGCATATATCTACG</named-content></td><td align="left" rowspan="1" colspan="1">58800&#x02013;58818</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>F<sub>B1</sub></bold></td><td align="left" rowspan="1" colspan="