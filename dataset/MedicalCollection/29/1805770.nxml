/name></person-group><article-title>US graduate medical education, 2004&#x02013;2005: trends in primary care specialties</article-title><source>JAMA</source><year>2005</year><volume>294</volume><fpage>1075</fpage><lpage>1082</lpage><pub-id pub-id-type="pmid">16145028</pub-id><pub-id pub-id-type="doi">10.1001/jama.294.9.1075</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Licciardone</surname><given-names>JC</given-names></name><name><surname>Brimhall</surname><given-names>AK</given-names></name><name><surname>King</surname><given-names>LN</given-names></name></person-group><article-title>Osteopathic manipulative treatment for low back pain: a systematic review and meta-analysis of randomized controlled trials</article-title><source>BMC Musculoskelet Disord</source><year>2005</year><volume>6</volume><fpage>43</fpage><comment>doi:10.1186/1471-2474-6-43</comment><pub-id pub-id-type="pmid">16080794</pub-id><pub-id pub-id-type="doi">10.1186/1471-2474-6-43</pub-id></citation></ref><ref id="B8"><citation citation-type="other"><article-title><italic>Osteopathic Medicine and Primary Care </italic>Editorial Board</article-title><ext-link ext-link-type="uri" xlink:href="http://www.om-pc.com/edboard/"/></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eysenbach</surname><given-names>G</given-names></name></person-group><article-title>Citation advantage of open access articles</article-title><source>PLoS Biol</source><year>2006</year><volume>4</volume><fpage>e157</fpage><comment>doi:10.1371/journal.pbio.0040157</comment><pub-id pub-id-type="pmid">16683865</pub-id><pub-id pub-id-type="doi">10.1371/journal.pbio.0040157</pub-id></citation></ref><ref id="B10"><citation citation-type="other"><article-title><italic>Osteopathic Medicine and Primary Care</italic> homepage</article-title><ext-link ext-link-type="uri" xlink:href="http://www.