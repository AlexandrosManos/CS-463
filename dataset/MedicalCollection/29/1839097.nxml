on></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Restuccia</surname><given-names>JD</given-names></name></person-group><article-title>The evolution of hospital utilization review methods in the United States.[see comment]</article-title><source>International Journal for Quality in Health Care</source><year>1995</year><volume>7</volume><fpage>253</fpage><lpage>260</lpage><pub-id pub-id-type="pmid">8595463</pub-id><pub-id pub-id-type="doi">10.1016/1353-4505(95)00016-O</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Payne</surname><given-names>SM</given-names></name></person-group><article-title>Identifying and managing inappropriate hospital utilization: a policy synthesis</article-title><source>Health Services Research</source><year>1987</year><volume>22</volume><fpage>709</fpage><lpage>769</lpage><pub-id pub-id-type="pmid">3121538</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Santos-Eggimann</surname><given-names>B</given-names></name><name><surname>Sidler</surname><given-names>M</given-names></name><name><surname>Schopfer</surname><given-names>D</given-names></name><name><surname>Blanc</surname><given-names>T</given-names></name></person-group><article-title>Comparing results of concurrent and retrospective designs in a hospital utilization review</article-title><source>International Journal for Quality in Health Care</source><year>1997</year><volume>9</volume><fpage>115</fpage><lpage>120</lpage><pub-id pub-id-type="pmid">9154497</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chopard</surname><given-names>P</given-names></name><name><surname>Perneger</surname><given-names>TV</given-names></name><name><surname>Gaspoz</surname><given-names>JM</given-names></name><name><surname>Lovis</surname><given-names>C</given-names></name><name><surname>Gousset</surname><given-names>D</given-names></name><name><surname>Rouillard</surname><given-names>C</given-names></name><name><surname>Sarasin</surname><given-names>FP</given-names></name><name><surname>Unger</surname><given-names>PF</given-names></name><name><surname>Waldvogel</surname><given-names>FA</given-names></name><name><surname>Junod</surname><given-names>AF</given-names></name></person-group><article-title>Predictors of inappropriate hospital days in a department of internal medicine</article-title><source>International Journal of Epidemiology</source><year>1998</year><volume>27</volume><fpage>513</fpage><lpage>519</lpage><pub-id pub-id-type="pmid">9698145</pub-id><pub-id pub-id-type="doi">10.1093/ije/27.3.513</pub-id></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Trerise</surname><given-names>B</given-names></name><name><surname>Dodek</surname><given-names>P</given-names></name><name><surname>Leung</surname><given-names>A</given-names></name><name><surname>Spinelli</surname><given-names>JS</given-names></name></person-group><source>Inappropriate underutilization of services in an acute care hospital</source><year>1999</year><publisher-name>Vancouver BC, Centre for Health Evaluation and Outcome Science</publisher-name></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McDonagh</surname><given-names>MS</given-names></name><name><surname>Smith</surname><given-names>DH</given-names></name><name><surname>Goddard</surname><given-names>M</given-names></name></person-group><article-title>Measuring appropriate use of acute beds. A systematic review of methods and results.[erratum appears in Health Policy 2000 Nov 17;54(2):163]</article-title><source>Health Policy</source><year>2000</year><volume>53</volume><fpage>157</fpage><lpage>184</lpage><pub-id pub-id-type="pmid">10996065</pub-id><pub-id pub-id-type="doi">10.1016/S0168-8510(00)00092-0</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>O'Donnell</surname><given-names>J</given-names></name><name><surname>Pilla</surname><given-names>J</given-names></name><name><surname>Van Gemert</surname><given-names>L</given-names></name></person-group><article-title>Which hospital admissions are appropriate?</article-title><source>Australian Health Review</source><year>1990</year><volume>12</volume><fpage>19</fpage><lpage>33</lpage><pub-id pub-id-type="pmid">10108324</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Murray</surname><given-names>ME</given-names></name><name><surname>Darmody</surname><given-names>JV</given-names></name></person-group><article-title>Clinical and fiscal outcomes of utilization review</article-title><source>Outcomes Management</source><year>2004</year><volume>8</volume><fpage>19</fpage><lpage>25</lpage><pub-id pub-id-type="pmid">14740580</pub-id></citation></ref><ref id="B27"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bruce</surname><given-names>S</given-names></name><name><surname>DeCoster</surname><given-names>C</given-names></name><name><surname>Trumble-Waddell</surname><given-names>J</given-names></name><name><surname>Burchill</surname><given-names>C</given-names></name><name><surname>De Haney</surname><given-names>S</given-names></name></person-group><source>Acuity of Patients Hospitalized for Medical Conditions at Winnipeg Acute Care Hospitals</source><year>2001</year><publisher-name>Manitoba Centre for Health Policy and Evaluation</publisher-name></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gertman</surname><given-names>PM</given-names></name><name><surname>Rest