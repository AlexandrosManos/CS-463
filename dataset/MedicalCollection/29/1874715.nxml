r><month>9</month><day>6</day><volume>327</volume><issue>7414</issue><fpage>536</fpage><lpage>42</lpage><comment><ext-link ext-link-type="uri" xlink:href="http://bmj.com/cgi/pmidlookup?view=long&#x00026;pmid=12958114"/></comment><pub-id pub-id-type="medline">12958114</pub-id><pub-id pub-id-type="doi">10.1136/bmj.327.7414.536</pub-id><pub-id pub-id-type="pii">327/7414/536</pub-id><pub-id pub-id-type="pmid">12958114</pub-id></element-citation></ref><ref id="ref6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bien</surname><given-names>TH</given-names></name><name><surname>Miller</surname><given-names>WR</given-names></name><name><surname>Tonigan</surname><given-names>JS</given-names></name></person-group><article-title>Brief interventions for alcohol problems: a review</article-title><source>Addiction</source><year>1993</year><month>3</month><volume>88</volume><issue>3</issue><fpage>315</fpage><lpage>35</lpage><pub-id pub-id-type="medline">12958114</pub-id><pub-id pub-id-type="doi">10.1111/j.1360-0443.1993.tb00820.x</pub-id><pub-id pub-id-type="pmid">8461850</pub-id></element-citation></ref><ref id="ref7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Heather</surname><given-names>Nick</given-names></name></person-group><article-title>Effectiveness of brief interventions proved beyond reasonable doubt</article-title><source>Addiction</source><year>2002</year><month>3</month><volume>97</volume><issue>3</issue><fpage>293</fpage><lpage>4</lpage><pub-id pub-id-type="medline">11964102</pub-id><pub-id pub-id-type="pii">105a</pub-id><pub-id pub-id-type="doi">10.1046/j.1360-0443.2002.0105a.x</pub-id><pub-id pub-id-type="pmid">11964102</pub-id></element-citation></ref><ref id="ref8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Moyer</surname><given-names>Anne</given-n