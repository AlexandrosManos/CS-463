id="B17"><citation citation-type="other"><article-title>ImageJ: Image processing and analysis in Java</article-title><ext-link ext-link-type="uri" xlink:href="http://rsb.info.nih.gov/ij"/></citation></ref><ref id="B18"><citation citation-type="journal"><article-title>Executive Summary of The Third Report of The National Cholesterol Education Program (NCEP) Expert Panel on Detection, Evaluation, And Treatment of High Blood Cholesterol In Adults (Adult Treatment Panel III)</article-title><source>JAMA</source><year>2001</year><volume>285</volume><fpage>2486</fpage><lpage>2497</lpage><pub-id pub-id-type="pmid">11368702</pub-id><pub-id pub-id-type="doi">10.1001/jama.285.19.2486</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hegele</surname><given-names>RA</given-names></name></person-group><article-title>Lessons from human mutations in PPARgamma</article-title><source>Int J Obes (Lond)</source><year>2005</year><volume>29 Suppl 1</volume><fpage>S31</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">15711581</pub-id><pub-id pub-id-type="doi">10.1038/sj.ijo.0802911</pub-id></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hegele</surname><given-names>RA</given-names></name></person-group><article-title>Genetic Lipodystrophies: Models for Insulin Resistance</article-title><source>Curr Med Chem - Imun, Endoc &#x00026; Metab Agents</source><year>2002</year><publisher-name> Bentham Science Publishers Ltd.</publisher-name><fpage>245</fpage><lpage>250</lpage><pub-id pub-id-type="doi">10.2174/1568013023358799</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kullberg</surname><given-names>J</given-names></name><name><surname>Angelhed</surname><given-names>JE</given-names></name><name><surname>Lonn</surname><given-names>L</given-names></name><name><surname>B