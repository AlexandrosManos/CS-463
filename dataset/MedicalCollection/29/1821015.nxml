urnal"><person-group person-group-type="author"><name><surname>Yang</surname><given-names>G</given-names></name><name><surname>Fang</surname><given-names>L</given-names></name><name><surname>Tan</surname><given-names>J</given-names></name><name><surname>Qi</surname><given-names>G</given-names></name><name><surname>Zhang</surname><given-names>Y</given-names></name><name><surname>Samet</surname><given-names>JM</given-names></name><name><surname>Taylor</surname><given-names>CE</given-names></name><name><surname>Becker</surname><given-names>K</given-names></name><name><surname>Xu</surname><given-names>J</given-names></name></person-group><article-title>Smoking in China: findings of the 1996 national prevalence survey</article-title><source>JAMA</source><year>1999</year><volume>282</volume><fpage>1247</fpage><lpage>53</lpage><pub-id pub-id-type="pmid">10517427</pub-id><pub-id pub-id-type="doi">10.1001/jama.282.13.1247</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hu</surname><given-names>TW</given-names></name><name><surname>Tsai</surname><given-names>YW</given-names></name></person-group><article-title>Cigarette consumption in rural China: survey results from three provinces</article-title><source>Am J Public Health</source><year>2000</year><volume>90</volume><fpage>1785</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">11076252</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gu</surname><given-names>D</given-names></name><name><surname>Wu</surname><given-names>X</given-names></name><name><surname>Reynolds</surname><given-names>K</given-names></name><name><surname>Duan</surname><given-names>X</given-names></name><name><surname>Xin</surname><given-names>X</given-names></name><name><surname>Reynolds</surname><given-names>F</given-names></name><name><surname>Whelton</surname><given-names>PK</given-names></name><n