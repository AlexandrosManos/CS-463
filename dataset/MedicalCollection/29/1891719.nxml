etal/></person-group><source>Genome Res</source><year>2001</year><volume>11</volume><fpage>566</fpage><pub-id pub-id-type="pmid">11282972</pub-id></citation></ref><ref id="R13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fabre</surname><given-names>E</given-names></name><etal/></person-group><source>Mol Biol Evol</source><year>2005</year><volume>22</volume><fpage>856</fpage><pub-id pub-id-type="pmid">15616141</pub-id></citation></ref><ref id="R14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Preuss</surname><given-names>TM</given-names></name><etal/></person-group><source>Journal of Biomedical Discovery and Collaboration</source><year>2006</year><volume>1</volume><fpage>17</fpage><pub-id pub-id-type="pmid">17134486</pub-id></citation></ref><ref id="R15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Alm</surname><given-names>EJ</given-names></name><etal/></person-group><source>Genome Res</source><year>2005</year><volume>15</volume><fpage>1015</fpage><pub-id pub-id-type="pmid">15998914</pub-id></citation></ref></ref-list><fn-group><fn id="FN1" fn-type="other"><p>        <bold>Citation:</bold>Sivashankari &#x00026; Shanmughavel, Bioinformation 1(9): 376-378 (2007)</p></fn></fn-group></back></article>