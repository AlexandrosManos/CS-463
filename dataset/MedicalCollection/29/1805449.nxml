-0378(98)00050-3</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shevchuk</surname><given-names>MM</given-names></name><name><surname>Nuovo</surname><given-names>GJ</given-names></name><name><surname>Khalife</surname><given-names>G</given-names></name></person-group><article-title>HIV in testis: quantitative histology and HIV localization in germ cells</article-title><source>J Reprod Immunol</source><year>1998</year><volume>41</volume><fpage>69</fpage><lpage>79</lpage><pub-id pub-id-type="pmid">10213301</pub-id><pub-id pub-id-type="doi">10.1016/S0165-0378(98)00049-7</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pudney</surname><given-names>J</given-names></name><name><surname>Nguyen</surname><given-names>H</given-names></name><name><surname>Xu</surname><given-names>C</given-names></name><name><surname>Anderson</surname><given-names>DJ</given-names></name></person-group><article-title>Microscopic evidence against HIV-1 infection of germ cells or attachment to sperm</article-title><source>J Reprod Immunol</source><year>1999</year><volume>44</volume><fpage>57</fpage><lpage>77</lpage><pub-id pub-id-type="pmid">10530761</pub-id><pub-id pub-id-type="doi">10.1016/S0165-0378(99)00020-0</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Al-Alwan</surname><given-names>MM</given-names></name><name><surname>Rowden</surname><given-names>G</given-names></name><name><surname>Lee</surname><given-names>TD</given-names></name><name><surname>West</surname><given-names>KA</given-names></name></person-group><article-title>Fascin is involved in the antigen presentation activity of mature dendritic cells</article-title><source>J Immunol</source><year>2001</year><volume>166</volume><fpage>338</fpage><lpage>345</lpage><pub-id pub-id-type="pmid">11123310