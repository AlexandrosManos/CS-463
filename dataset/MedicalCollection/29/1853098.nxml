/article-title><source>J Clin Microbiol</source><year>2003</year><volume>41</volume><fpage>2068</fpage><lpage>2079</lpage><pub-id pub-id-type="pmid">12734250</pub-id><pub-id pub-id-type="doi">10.1128/JCM.41.5.2068-2079.2003</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>HS</given-names></name><name><surname>Schell</surname><given-names>MA</given-names></name><name><surname>Yu</surname><given-names>Y</given-names></name><name><surname>Ulrich</surname><given-names>RL</given-names></name><name><surname>Sarria</surname><given-names>SH</given-names></name><name><surname>Nierman</surname><given-names>WC</given-names></name><name><surname>DeShazer</surname><given-names>D</given-names></name></person-group><article-title>Bacterial genome adaptation to niches: divergence of the potential virulence genes in three Burkholderia species of different survival strategies</article-title><source>BMC Genomics</source><year>2005</year><volume>6</volume><fpage>174</fpage><pub-id pub-id-type="pmid">16336651</pub-id><pub-id pub-id-type="doi">10.1186/1471-2164-6-174</pub-id></citation></ref><ref id="B8"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Howe</surname><given-names>C</given-names></name></person-group><article-title>Glanders</article-title><source>The Oxford Medicine</source><year>1950</year><publisher-name>New York , Oxford Univ. Press</publisher-name><fpage>185&#x02013;202</fpage></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Srinivasan</surname><given-names>A</given-names></name><name><surname>Kraus</surname><given-names>CN</given-names></name><name><surname>DeShazer</surname><given-names>D</given-names></name><name><surname>Becker</surname><given-names>PM</given-names></name><name><surname>Dick</surname><given-names>JD</given-names></name><name><surname>Spac