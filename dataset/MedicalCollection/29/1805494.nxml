>Trop Med Int Health</source><year>2001</year><volume>6</volume><fpage>1062</fpage><lpage>1069</lpage><pub-id pub-id-type="pmid">11737843</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-3156.2001.00813.x</pub-id></citation></ref></ref-list></back></article>