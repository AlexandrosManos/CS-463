</year><volume>28</volume><fpage>387</fpage><lpage>395</lpage><pub-id pub-id-type="pmid">12101550</pub-id></citation></ref><ref id="B9"><citation citation-type="other"><article-title>U.S. Pharmacopeia MedMarx </article-title><ext-link ext-link-type="uri" xlink:href="http://www.medmarx.com"/></citation></ref><ref id="B10"><citation citation-type="other"><article-title>Institute for Safe Medication Practices' Medication Errors Reporting Program </article-title><ext-link ext-link-type="uri" xlink:href="http://www.ismp.org/Pages/communications.asp"/></citation></ref><ref id="B11"><citation citation-type="other"><article-title>Emergency Care Research Institute </article-title><ext-link ext-link-type="uri" xlink:href="http://www.ecri.org"/></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tuttle</surname><given-names>D</given-names></name><name><surname>Holloway</surname><given-names>R</given-names></name><name><surname>Baird</surname><given-names>T</given-names></name><name><surname>Sheehan</surname><given-names>B</given-names></name><name><surname>Skelton</surname><given-names>WK</given-names></name></person-group><article-title>Electronic reporting to improve patient safety</article-title><source>Qual Saf Health Care</source><year>2004</year><volume>13</volume><fpage>281</fpage><lpage>286</lpage><pub-id pub-id-type="pmid">15289631</pub-id><pub-id pub-id-type="doi">10.1136/qshc.2003.009100</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tokars</surname><given-names>JI</given-names></name><name><surname>Miller</surname><given-names>ER</given-names></name><name><surname>Stein</surname><given-names>G</given-names></name></person-group><article-title>New national surveillance system for hemodialysis-associated infections: initial results</article-title><source>Am J Infect Control</source><year>2002</year><volume>30</volume><fpage>288</fpage><lpage>295</lpage><pub-id pub-id-type="pmid">12163863</pub-id><pub-id pub-id-type="doi">10.1067/mic.2002.120904</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zhou</surname><given-names>W</given-names></name><name><surname>Pool</surname><given-names>V</given-names></name><name><surname>Iskander</surname><given-names>JK</given-names></name><name><surname>English-Bullard</surname><given-names>R</given-names></name><name><surname>Ball</surname><given-names>R</given-names></name><name><surname>Wise</surname><given-names>RP</given-names></name><name><surname>Haber</surname><given-names>P</given-names></name><name><surname>Pless</surname><given-names>RP</given-names></name><name><surname>Mootrey</surname><given-names>G</given-names></name><name><surname>Ellenberg</surname><given-names>SS</given-names></name><name><surname>Braun</surname><given-names>MM</given-names></name><name><surname>Chen</surname><given-names>RT</given-names></name></person-group><article-title>Surveillance for safety after immunization: Vaccine Adverse Event Reporting System (VAERS)--United States, 1991-2001</article-title><source>MMWR Surveill Summ</source><year>2003</year><volume>52</volume><fpage>1</fpage><lpage>24</lpage><pub-id pub-id-type="pmid">12825543</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Holzmueller</surname><given-names>CG</given-names></name><name><surname>Pronovost</surname><given-names>PJ</given-names></name><name><surname>Dickman</surname><given-names>F</given-names></name><name><surname>Thompson</surname><given-names>DA</given-names></name><name><surname>Wu</surname><given-names>AW</given-names></name><name><surname>Lubomski</surname><given-names>LH</given-names></name><name><surname>Fahey</surname><given-names>M</given-names></name><name><surname>Steinwachs</surname><given-names>DM</given-names></