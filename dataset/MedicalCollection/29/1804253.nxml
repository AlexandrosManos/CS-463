e><etal/></person-group><article-title>Increased whole body protein breakdown predominates over increased whole body protein synthesis in multiple organ failure</article-title><source>Clin Sci (Colch)</source><year>1993</year><volume>84</volume><fpage>655</fpage><lpage>661</lpage><pub-id pub-id-type="pmid">8334812</pub-id></citation></ref><ref id="B19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Biols</surname><given-names>G</given-names></name><name><surname>Tiogo</surname><given-names>G</given-names></name><name><surname>Ciocechi</surname><given-names>B</given-names></name><etal/></person-group><article-title>Metabolic response to injury and sepsis: changes in protein metabolism</article-title><source>Nutrition</source><year>1997</year><volume>13</volume><fpage>52</fpage><lpage>57</lpage></citation></ref><ref id="B20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zedler</surname><given-names>S</given-names></name><name><surname>Faist</surname><given-names>E</given-names></name></person-group><article-title>The impact of endogenous triggers on trauma-associated inflammation</article-title><source>Curr Opin Crit Care</source><year>2006</year><volume>12</volume><fpage>595</fpage><lpage>601</lpage><pub-id pub-id-type="pmid">17077693</pub-id></citation></ref><ref id="B21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hilderbrand</surname><given-names>F</given-names></name><name><surname>Pape</surname><given-names>HC</given-names></name><name><surname>Krettek</surname><given-names>C</given-names></name></person-group><article-title>The importance of cytokines in the post traumatic inflammatory reaction</article-title><source>Unfallchirug</source><year>2005</year><volume>180</volume><fpage>793</fpage><lpage>796</lpage></citation></ref><ref id="B22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wray</surname><given-names>C</given-names></name><name><surname>Memmen</surname><given-names>J</given-names></name><name><surname>Hasselgren</surname><given-names>P</given-names></name></person-group><article-title>Catabolic response to stress and potential benefits of nutritional support</article-title><source>Nutrition</source><year>2002</year><volume>18</volume><fpage>97</fpage><lpage>102</lpage><pub-id pub-id-type="pmid">11827779</pub-id></citation></ref><ref id="B23"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hart</surname><given-names>D</given-names></name><name><surname>Wolf</surname><given-names>S</given-names></name><name><surname>Micak</surname><given-names>R</given-names></name><etal/></person-group><article-title>Persistence of muscle catabolism after severe burn</article-title><source>Surgery</source><year>2002</year><volume>128</volume><fpage>12</fpage><lpage>19</lpage></citation></ref><ref id="B24"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Connolly</surname><given-names>AB</given-names></name><name><surname>Vernon</surname><given-names>DR</given-names></name></person-group><article-title>Manipulation of the metabolic response for management of patients with severe surgical illness: review</article-title><source>World J Surg</source><year>2000</year><volume>24</volume><fpage>696</fpage><lpage>704</lpage><pub-id pub-id-type="pmid">10773122</pub-id></citation></ref><ref id="B25"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kehlet</surname><given-names>H</given-names></name></person-group><article-title>Manipulation of the metabolic response in clinical practice</article-title><source>World J Surg</source><year>2000</year><volume>24</volume><fpage>690</fpage><lpage>695</lpage><pub-id pub-id-type="pmid">