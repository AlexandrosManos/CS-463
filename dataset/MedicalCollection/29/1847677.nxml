on-group person-group-type="author"><name><surname>Wong</surname><given-names>F</given-names></name><name><surname>Liu</surname><given-names>P</given-names></name><name><surname>Lilly</surname><given-names>L</given-names></name><name><surname>Bomzon</surname><given-names>A</given-names></name><name><surname>Blendis</surname><given-names>L</given-names></name></person-group><article-title>Role of cardiac structural and functional abnormalities in the pathogenesis of hyperdynamic circulation and renal sodium retention in cirrhosis</article-title><source>Clin Sci (Lond)</source><year>1999</year><volume>97</volume><fpage>259</fpage><lpage>267</lpage><pub-id pub-id-type="pmid">10464050</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wong</surname><given-names>F</given-names></name><name><surname>Girgrah</surname><given-names>N</given-names></name><name><surname>Graba</surname><given-names>J</given-names></name><name><surname>Allidina</surname><given-names>Y</given-names></name><name><surname>Liu</surname><given-names>P</given-names></name><name><surname>Blendis</surname><given-names>L</given-names></name></person-group><article-title>The cardiac response to exercise in cirrhosis</article-title><source>Gut</source><year>2001</year><volume>49</volume><fpage>268</fpage><lpage>75</lpage><pub-id pub-id-type="pmid">11454805</pub-id><pub-id pub-id-type="doi">10.1136/gut.49.2.268</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blendis</surname><given-names>L</given-names></name><name><surname>Wong</surname><given-names>F</given-names></name></person-group><article-title>Is there a cirrhotic cardiomyopathy?</article-title><source>Am J Gastroenterol</source><year>2000</year><volume>95</volume><fpage>3026</fpage><lpage>3028</lpage><pub-id pub-id-type="pmid">11095313</pub-id><pub-id pub-id-type="doi">10.1111/j.1572-0241.200