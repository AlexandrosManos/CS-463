r"><name><surname>Johnston</surname><given-names>MC</given-names><suffix>M.</suffix></name></person-group><person-group person-group-type="editor"><name><surname>Jones EWPJRBJR</surname></name></person-group><article-title>Regulation of carbon and phosphate utilization.</article-title><source>The Molecular Biology of the Yeast Saccharomyces</source><year>1992</year><volume>2</volume><publisher-name>Cold Spring Harbor, NY, Cold Spring Harbor Laboratory Press</publisher-name><fpage>193&#x02013;281</fpage></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Louvion</surname><given-names>JF</given-names></name><name><surname>Havaux-Copf</surname><given-names>B</given-names></name><name><surname>Picard</surname><given-names>D</given-names></name></person-group><article-title>Fusion of GAL4-VP16 to a steroid-binding domain provides a tool for gratuitous induction of galactose-responsive genes in yeast</article-title><source>Gene</source><year>1993</year><volume>131</volume><fpage>129</fpage><lpage>134</lpage><pub-id pub-id-type="pmid">8370533</pub-id><pub-id pub-id-type="doi">10.1016/0378-1119(93)90681-R</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stafford</surname><given-names>GA</given-names></name><name><surname>Morse</surname><given-names>RH</given-names></name></person-group><article-title>Chromatin remodeling by transcriptional activation domains in a yeast episome</article-title><source>J Biol Chem</source><year>1997</year><volume>272</volume><fpage>11526</fpage><lpage>11534</lpage><pub-id pub-id-type="pmid">9111067</pub-id><pub-id pub-id-type="doi">10.1074/jbc.272.17.11526</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Metzger</surname><given-names>D</given-names></name><name><surname>White</surname><given-names>JH</given-names></nam