urnal"><person-group person-group-type="author"><name><surname>Macreadie</surname><given-names>IG</given-names></name><name><surname>Horaitis</surname><given-names>O</given-names></name><name><surname>Verkuylen</surname><given-names>AJ</given-names></name><name><surname>Savin</surname><given-names>KW</given-names></name></person-group><article-title>Improved shuttle vectors for cloning and high-level Cu(2+)-mediated expression of foreign genes in yeast</article-title><source>Gene</source><year>1991</year><volume>104</volume><fpage>107</fpage><lpage>111</lpage><pub-id pub-id-type="pmid">1916270</pub-id><pub-id pub-id-type="doi">10.1016/0378-1119(91)90474-P</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>West</surname><given-names>RW</given-names><suffix>Jr.</suffix></name><name><surname>Yocum</surname><given-names>RR</given-names></name><name><surname>Ptashne</surname><given-names>M</given-names></name></person-group><article-title>Saccharomyces cerevisiae GAL1-GAL10 divergent promoter region: location and function of the upstream activating sequence UASG</article-title><source>Mol Cell Biol</source><year>1984</year><volume>4</volume><fpage>2467</fpage><lpage>2478</lpage><pub-id pub-id-type="pmid">6392852</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yocum</surname><given-names>RR</given-names></name><name><surname>Hanley</surname><given-names>S</given-names></name><name><surname>West</surname><given-names>R</given-names><suffix>Jr.</suffix></name><name><surname>Ptashne</surname><given-names>M</given-names></name></person-group><article-title>Use of lacZ fusions to delimit regulatory elements of the inducible divergent GAL1-GAL10 promoter in Saccharomyces cerevisiae</article-title><source>Mol Cell Biol</source><year>1984</year><volume>4</volume><fpage>1985</fpage><lpage>1998</lpage><pub-id pub-id-type="pmi