al"><person-group person-group-type="author"><name><surname>Maldonado</surname><given-names>PE</given-names></name><name><surname>Godecke</surname><given-names>I</given-names></name><name><surname>Gray</surname><given-names>CM</given-names></name><name><surname>Bonhoeffer</surname><given-names>T</given-names></name></person-group><year>1997</year><article-title>Orientation selectivity in pinwheel centers in cat striate cortex.</article-title><source>Science</source><volume>276</volume><fpage>1551</fpage><lpage>1555</lpage><pub-id pub-id-type="pmid">9171056</pub-id></citation></ref><ref id="pone.0000251-Rao1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rao</surname><given-names>SC</given-names></name><name><surname>Toth</surname><given-names>LJ</given-names></name><name><surname>Sur</surname><given-names>M</given-names></name></person-group><year>1997</year><article-title>Optically imaged maps of orientation preference in primary visual cortex of cats and ferrets.</article-title><source>Journal of Comparative Neurology</source><volume>387</volume><fpage>358</fpage><lpage>370</lpage><pub-id pub-id-type="pmid">9335420</pub-id></citation></ref><ref id="pone.0000251-Shmuel1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shmuel</surname><given-names>A</given-names></name><name><surname>Grinvald</surname><given-names>A</given-names></name></person-group><year>2000</year><article-title>Coexistence of linear zones and pinwheels within orientation maps in cat visual cortex.</article-title><source>Proceedings of the National Academy of Sciences of the United States of America</source><volume>97</volume><fpage>5568</fpage><lpage>5573</lpage><pub-id pub-id-type="pmid">10805812</pub-id></citation></ref><ref id="pone.0000251-Everson1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Everson</surname><g