ame></person-group><article-title>Diurnal variation of plasma cortisol levels in infancy</article-title><source>Journal of Pediatric Endocrinology and Metabolism</source><year>1998</year><volume>11</volume><fpage>549</fpage><lpage>553</lpage><pub-id pub-id-type="pmid">9777576</pub-id></citation></ref><ref id="b24"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Spangler</surname><given-names>G</given-names></name></person-group><article-title>The emergence of adrenocortical circadian function in newborns and infants and its relationship to sleep, feeding and maternal adrenocortical activity</article-title><source>Early Human Development</source><year>1991</year><volume>25</volume><fpage>197</fpage><lpage>208</lpage><pub-id pub-id-type="pmid">1935741</pub-id></citation></ref><ref id="b25"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kiess</surname><given-names>W</given-names></name></person-group><article-title>Salivary cortisol levels throughout childhood and adolescence: relation with age, pubertal stage, and weight</article-title><source>Pediatric Research</source><year>1995</year><volume>37</volume><fpage>502</fpage><lpage>506</lpage><pub-id pub-id-type="pmid">7596692</pub-id></citation></ref><ref id="b26"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Watamura</surname><given-names>SE</given-names></name></person-group><article-title>Developmental changes in baseline cortisol activity in early childhood: relations with napping and effortful control</article-title><source>Developmental Psychobiology</source><year>2004</year><volume>45</volume><fpage>125</fpage><lpage>133</lpage><pub-id pub-id-type="pmid">15505801</pub-id></citation></ref><ref id="b27"><label>27</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hng</surname><given-names>TM<