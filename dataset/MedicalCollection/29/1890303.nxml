06</td><td align="left">6.11E-07</td></tr></tbody></table><table-wrap-foot><p>The actual FDR in gene selections across the 100 simulations under each configuration by these methods was compared to that of q-value method using one-tail paired t-statistics.</p></table-wrap-foot></table-wrap><table-wrap position="float" id="T3"><label>Table 3</label><caption><p>P-values comparing power by different methods.</p></caption><table frame="hsides" rules="groups"><thead><tr><td></td><td align="center"><italic>&#x003c1;</italic></td><td align="center">True <italic>&#x003c0;</italic><sub>0</sub></td><td align="left">BY</td><td align="left">SampG.q</td><td align="left">SampS.q</td><td align="left">SampG.m</td><td align="left">SampS.m</td></tr></thead><tbody><tr><td align="center">Data-B</td><td align="center">0.3</td><td align="center">0.9</td><td align="left">3.71E-17</td><td align="left">1.10E-04</td><td align="left">1.06E-04</td><td align="left">2.06E-02</td><td align="left">8.37E-03</td></tr><tr><td></td><td></td><td align="center">0.8</td><td align="left">2.74E-31</td><td align="left">3.93E-05</td><td align="left">2.97E-05</td><td align="left">1.94E-03</td><td align="left">5.58E-04</td></tr><tr><td></td><td></td><td align="center">0.7</td><td align="left">7.82E-34</td><td align="left">7.72E-08</td><td align="left">2.57E-08</td><td align="left">3.20E-07</td><td align="left">1.09E-07</td></tr><tr><td></td><td></td><td align="center">0.6</td><td align="left">4.48E-48</td><td align="left">8.31E-12</td><td align="left">9.01E-12</td><td align="left">2.78E-12</td><td align="left">5.55E-13</td></tr><tr><td></td><td align="center">0.5</td><td align="center">0.9</td><td align="left">1.67E-08</td><td align="left">4.95E-03</td><td align="left">3.35E-03</td><td align="left">3.73E-02</td><td align="left">7.94E-03</td></tr><tr><td></td><td></td><td align="center">0.8</td><td align="left">1.06E-13</td><td align="left">7.70E-04</td><td align="left">6.05E-06</td><td align="left">4.06E-02</td