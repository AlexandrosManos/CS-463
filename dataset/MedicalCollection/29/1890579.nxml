r"><name><surname>Kobayashi</surname><given-names>H</given-names></name></person-group><article-title>Retinoid signaling controls mouse pancreatic exocrine lineage selection through epithelial-mesenchymal interactions</article-title><source>Gastroenterology</source><year>2002</year><volume>123</volume><fpage>1331</fpage><lpage>1340</lpage><pub-id pub-id-type="pmid">12360493</pub-id></citation></ref><ref id="b27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kramer</surname><given-names>B</given-names></name></person-group><article-title>Regulation of the proportion of insulin cells in embryonic chick pancreas: effect of a growth factor-reduced extracellular matrix in combination with retinoic acid</article-title><source>In Vitro Cell Dev Biol Anim</source><year>2003</year><volume>39</volume><fpage>196</fpage><lpage>198</lpage><pub-id pub-id-type="pmid">14613334</pub-id></citation></ref><ref id="b29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>Z</given-names></name></person-group><article-title>Multifaceted pancreatic mesenchymal control of epithelial lineage selection</article-title><source>Dev Biol</source><year>2004</year><volume>269</volume><fpage>252</fpage><lpage>263</lpage><pub-id pub-id-type="pmid">15081371</pub-id></citation></ref><ref id="b30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maden</surname><given-names>M</given-names></name></person-group><article-title>Retinoid signalling in the development of the central nervous system</article-title><source>Nat Rev Neurosci</source><year>2002</year><volume>3</volume><fpage>843</fpage><lpage>853</lpage><pub-id pub-id-type="pmid">12415292</pub-id></citation></ref><ref id="b31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maldonado</surname><given-names>TS</given-names></name></person-group><article-title>Base