 id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bere</surname><given-names>E</given-names></name><name><surname>Klepp</surname><given-names>K-I</given-names></name></person-group><article-title>Changes in accessibility and preferences predict children's future fruit and vegetable intake</article-title><source>Int J Behav Nutr Phys Act</source><year>2005</year><volume>2</volume><fpage>15</fpage><pub-id pub-id-type="pmid">16216124</pub-id><pub-id pub-id-type="doi">10.1186/1479-5868-2-15</pub-id></citation></ref><ref id="B7"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Sallis</surname><given-names>JF</given-names></name><name><surname>Owen</surname><given-names>N</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Glanz K, Lewis FM, Rimer BK</surname></name></person-group><article-title>Ecological models</article-title><source>Health Behaviour and Health Education: Theory, Research and Practice</source><year>1997</year><edition>second</edition><publisher-name>San Francisco: Jossey-Bass publishers</publisher-name><fpage>403</fpage><lpage>24</lpage></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bere</surname><given-names>E</given-names></name><name><surname>Veier&#x000f8;d</surname><given-names>MB</given-names></name><name><surname>Klepp</surname><given-names>K-I</given-names></name></person-group><article-title>The Norwegian School Fruit Programme: evaluating paid vs. no-cost subscriptions</article-title><source>Prev Med</source><year>2005</year><volume>41</volume><fpage>463</fpage><lpage>470</lpage><pub-id pub-id-type="pmid">15917042</pub-id><pub-id pub-id-type="doi">10.1016/j.ypmed.2004.11.024</pub-id></citation></ref><ref id="B9"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bere</surname><given-names>E</given-names></name><n