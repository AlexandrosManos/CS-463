ge><pub-id pub-id-type="pmid">10348335</pub-id><pub-id pub-id-type="doi">10.1016/S0013-4694(98)00112-6</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jokeit</surname><given-names>H</given-names></name><name><surname>Makeig</surname><given-names>S</given-names></name></person-group><article-title>Different event-related patterns of gamma-band power in brain waves of fast-and slow-reacting subjects</article-title><source>Proc Natl Acad Sci USA</source><year>1994</year><volume>91</volume><fpage>6339</fpage><lpage>6343</lpage><pub-id pub-id-type="pmid">8022783</pub-id><pub-id pub-id-type="doi">10.1073/pnas.91.14.6339</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Basar-Eroglu</surname><given-names>C</given-names></name><name><surname>Struber</surname><given-names>D</given-names></name><name><surname>Schurmann</surname><given-names>M</given-names></name><name><surname>Stadler</surname><given-names>M</given-names></name><name><surname>Basar</surname><given-names>E</given-names></name></person-group><article-title>Gamma-band responses in the brain: a short review of psychophysiological correlates and functional significance</article-title><source>Int J Psychophysiol</source><year>1996</year><volume>24</volume><fpage>101</fpage><lpage>112</lpage><pub-id pub-id-type="pmid">8978437</pub-id><pub-id pub-id-type="doi">10.1016/S0167-8760(96)00051-7</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tallon-Baudry</surname><given-names>C</given-names></name><name><surname>Bertrand</surname><given-names>O</given-names></name><name><surname>Peronnet</surname><given-names>F</given-names></name><name><surname>Pernier</surname><given-names>J</given-names></name></person-group><article-title>Induced <italic>&#x003b3;</italic>-Band Activity during the