 id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Alexanderson</surname><given-names>K</given-names></name><name><surname>Arrel&#x000f6;v</surname><given-names>B</given-names></name><name><surname>Hagberg</surname><given-names>J</given-names></name><name><surname>Karlsryd</surname><given-names>E</given-names></name><name><surname>L&#x000f6;fgren</surname><given-names>A</given-names></name><name><surname>Ponzer</surname><given-names>S</given-names></name></person-group><source>L&#x000e4;karens arbete med sjukskrivning- en enk&#x000e4;tstudie. (Physician&#x02019;s work with sick listing &#x02013; a questionnaire study)</source><year>2005</year><publisher-name>Sweden , Swedish Social Insurance Agency, Karolinska Institute, Stockholm County Council, and &#x000d6;sterg&#x000f6;tland County Council</publisher-name></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carne</surname><given-names>S</given-names></name></person-group><article-title>Sick absence certification. Analysis of one group practice in 1967</article-title><source>Br Med J</source><year>1969</year><volume>1</volume><fpage>147</fpage><lpage>149</lpage><pub-id pub-id-type="pmid">5762275</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Handfield-Jones</surname><given-names>RP</given-names></name></person-group><article-title>Who Shall Help The Doctor?Ancillaries, Prescriptions, And Certificates</article-title><source>Lancet</source><year>1964</year><volume>14</volume><fpage>1173</fpage><lpage>1174</lpage><pub-id pub-id-type="pmid">14213588</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(64)92696-0</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Englund</surname><given-names>L</given-names></name><name><surname>Svardsudd</surname><