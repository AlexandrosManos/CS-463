icle-title>The Clinical Evaluation of QT/QTc Interval Prolongation and Proarrhythmic Potential for Non-Antiarrhythmic Drugs</article-title><year>2004</year><ext-link ext-link-type="uri" xlink:href="http://www.emea.eu.int/pdfs/human/ich/000204en.pdf."/></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cheng</surname><given-names>J</given-names></name></person-group><article-title>Evidences of the gender-related differences in cardiac repolarization and the underlying mechanisms in different animal species and human</article-title><source>Fundam Clin Pharmacol</source><year>2006</year><volume>20</volume><fpage>1</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">16448390</pub-id><pub-id pub-id-type="doi">10.1111/j.1472-8206.2005.00384.x</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pham</surname><given-names>TV</given-names></name><name><surname>Rosen</surname><given-names>MR</given-names></name></person-group><article-title>Sex, hormones, and repolarization</article-title><source>Cardiovasc Res</source><year>2002</year><volume>53</volume><fpage>740</fpage><lpage>751</lpage><pub-id pub-id-type="pmid">11861044</pub-id><pub-id pub-id-type="doi">10.1016/S0008-6363(01)00429-1</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Drici</surname><given-names>M-D</given-names></name></person-group><article-title>Influence of gender on drug-acquired long QT syndrome</article-title><source>Eur Heart J Supplements</source><year>2001</year><volume>3</volume><fpage>K41</fpage><lpage>K47</lpage><pub-id pub-id-type="doi">10.1016/S1520-765X(01)90005-7</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ito</surname><given-names>H</given-names></name><name><surname>Kono</surname><give