></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Comai</surname><given-names>L</given-names></name><name><surname>Henikoff</surname><given-names>S</given-names></name></person-group><article-title>TILLING: practical single-nucleotide mutation discovery</article-title><source>Plant J</source><year>2006</year><volume>45</volume><fpage>684</fpage><lpage>694</lpage><pub-id pub-id-type="pmid">16441355</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-313X.2006.02670.x</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Henikoff</surname><given-names>S</given-names></name><name><surname>Comai</surname><given-names>L</given-names></name></person-group><article-title>Single-nucleotide mutations for plant functional genomics</article-title><source>Annu Rev Plant Biol</source><year>2003</year><volume>54</volume><fpage>375</fpage><lpage>401</lpage><pub-id pub-id-type="pmid">14502996</pub-id><pub-id pub-id-type="doi">10.1146/annurev.arplant.54.031902.135009</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wienholds</surname><given-names>E</given-names></name><name><surname>van Eeden</surname><given-names>F</given-names></name><name><surname>Kosters</surname><given-names>M</given-names></name><name><surname>Mudde</surname><given-names>J</given-names></name><name><surname>Plasterk</surname><given-names>RH</given-names></name><name><surname>Cuppen</surname><given-names>E</given-names></name></person-group><article-title>Efficient target-selected mutagenesis in zebrafish</article-title><source>Genome Res</source><year>2003</year><volume>13</volume><fpage>2700</fpage><lpage>2707</lpage><pub-id pub-id-type="pmid">14613981</pub-id><pub-id pub-id-type="doi">10.1101/gr.1725103</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-gro