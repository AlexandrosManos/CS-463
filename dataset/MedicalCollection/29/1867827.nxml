</article-title><source>Bioinformatics</source><year>2004</year><volume>20</volume><fpage>5</fpage><lpage>20</lpage><pub-id pub-id-type="pmid">14693803</pub-id><pub-id pub-id-type="doi">10.1093/bioinformatics/btg364</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Luan</surname><given-names>Y</given-names></name><name><surname>Li</surname><given-names>H</given-names></name></person-group><article-title>Model-based methods for identifying periodically expressed genes based on time course microarray gene expression data</article-title><source>Bioinformatics</source><year>2004</year><volume>20</volume><fpage>332</fpage><lpage>339</lpage><pub-id pub-id-type="pmid">14960459</pub-id><pub-id pub-id-type="doi">10.1093/bioinformatics/btg413</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ruf</surname><given-names>T</given-names></name></person-group><article-title>The Lomb-Scargle Periodogram in biological rhythm research: Analysis of incomplete and unequally spaced time-series</article-title><source>Biological Rhythm Research</source><year>1999</year><volume>30</volume><fpage>178</fpage><lpage>201</lpage><pub-id pub-id-type="doi">10.1076/brhm.30.2.178.1422</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bohn</surname><given-names>A</given-names></name><name><surname>Hinderlich</surname><given-names>S</given-names></name><name><surname>Hutt</surname><given-names>MT</given-names></name><name><surname>Kaiser</surname><given-names>F</given-names></name><name><surname>Luttge</surname><given-names>U</given-names></name></person-group><article-title>Identification of rhythmic subsystems in the circadian cycle of crassulacean acid metabolism under thermoperiodic perturbations</article-title><source>Biol Chem</source><year>2003</year><volume>384