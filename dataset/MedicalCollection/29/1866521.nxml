ic xlink:href="1471-2156-4-S1-S81-i2.gif"/>)</td><td align="left">2.4 (1.3, 3.5)</td><td align="left">8.4 (7.0, 9.8)</td></tr><tr><td align="left">Individual (1000 &#x000d7; <graphic xlink:href="1471-2156-4-S1-S81-i3.gif"/>)</td><td align="left">16.7 (15.6, 17.8)</td><td align="left">23.3 (21.5, 25.1)</td></tr><tr><td align="left">Total (1000 &#x000d7; &#x003c3;<sup>2</sup>)</td><td align="left">22.0</td><td align="left">33.5</td></tr><tr><td align="left">Sibling (&#x003b3;<sub><italic>Sib</italic></sub>)</td><td align="left">0.96 (0.87, 1.0)</td><td align="left">0.63 (0.56, 0.70)</td></tr><tr><td align="left">Parent-offspring (&#x003b3;<sub><italic>PO</italic></sub>)</td><td align="left">0.36 (0.22, 0.50)</td><td align="left">0.37 (0.30, 0.44)</td></tr></tbody></table></table-wrap><table-wrap position="float" id="T3"><label>Table 3</label><caption><p>Bivariate correlation coefficients and 95% confidence intervals for ln(SBP) and ln(CHOL) indifferent relative pairs</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="left">Relative pair</td><td align="center">Correlation</td></tr></thead><tbody><tr><td align="left">Within individuals</td><td align="right">0.24 (0.20, 0.29)</td></tr><tr><td align="left">Sibling-sibling</td><td align="right">0.047 (-0.020, 0.096)</td></tr><tr><td align="left">Parent-offspring</td><td align="right">0.008 (-0.031, 0.048)</td></tr><tr><td align="left">Spouse-spouse</td><td align="right">-0.030 (-0.110, 0.050)</td></tr><tr><td align="left">Genetic (&#x003c1;<sub><italic>a</italic></sub>)</td><td align="right">0.024 (-0.229, 0.278)</td></tr><tr><td align="left">Environmental (&#x003c1;<sub><italic>se</italic></sub>)</td><td align="right">0.33 (0.075, 0.58)</td></tr><tr><td align="left">Individual (&#x003c1;<sub><italic>e</italic></sub>)</td><td align="right">0.043 (0.001, 0.086)</td></tr></tbody></table></table-wrap></sec></back></article>