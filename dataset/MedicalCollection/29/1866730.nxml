/name><name><surname>Roses</surname><given-names>AD</given-names></name><name><surname>Gilbert</surname><given-names>JR</given-names></name><name><surname>Vance</surname><given-names>JM</given-names></name><name><surname>Haines</surname><given-names>JL</given-names></name><name><surname>Pericak-Vance</surname><given-names>MA</given-names></name></person-group><article-title>Age at onset in two common neurodegenerative diseases is genetically controlled</article-title><source>Am J Hum Genet</source><year>2002</year><volume>70</volume><fpage>985</fpage><lpage>993</lpage><pub-id pub-id-type="pmid">11875758</pub-id><pub-id pub-id-type="doi">10.1086/339815</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Allen</surname><given-names>AS</given-names></name><name><surname>Martin</surname><given-names>ER</given-names></name><name><surname>Li</surname><given-names>Y-J</given-names></name></person-group><article-title>A nonparametric genetic association test for age-at-onset data</article-title><source>Am J Hum Genet</source><year>2003</year><volume>73</volume><fpage>616</fpage></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schaid</surname><given-names>DJ</given-names></name></person-group><article-title>General score tests for associations of genetic markers with disease using cases and their parents</article-title><source>Genet Epidemiol</source><year>1996</year><volume>13</volume><fpage>423</fpage><lpage>449</lpage><pub-id pub-id-type="pmid">8905391</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1098-2272(1996)13:5&#x0003c;423::AID-GEPI1&#x0003e;3.0.CO;2-3</pub-id></citation></ref></ref-list><sec sec-type="display-objects"><title>Figures and Tables</title><fig position="float" id="F1"><label>Figure 1</label><caption><p><bold>Association results of all markers in chromosome 14 (A) and chromosome 15 (B). The <italic>p</italic