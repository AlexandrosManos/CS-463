en-names>ME</given-names></name></person-group><article-title>Management of metastatic melanoma during pregnancy</article-title><source>BMJ</source><year>1998</year><volume>316</volume><fpage>848</fpage><lpage>849</lpage><pub-id pub-id-type="pmid">9549460</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Silipo</surname><given-names>V</given-names></name><name><surname>Simone</surname><given-names>P</given-names></name><name><surname>Mariani</surname><given-names>G</given-names></name><name><surname>Buccini</surname><given-names>P</given-names></name><name><surname>Ferrari</surname><given-names>A</given-names></name><name><surname>Catricala</surname><given-names>C</given-names></name></person-group><article-title>Malignant melanoma and pregnancy</article-title><source>Melanoma Res</source><year>2006</year><volume>16</volume><fpage>497</fpage><lpage>500</lpage><pub-id pub-id-type="pmid">17119450</pub-id><pub-id pub-id-type="doi">10.1097/01.cmr.0000232295.91536.09</pub-id></citation></ref></ref-list></back></article>