</td><td align="center" rowspan="1" colspan="1">5</td><td align="center" rowspan="1" colspan="1">8</td><td align="right" rowspan="1" colspan="1">25</td><td align="right" rowspan="1" colspan="1">31</td><td align="right" rowspan="1" colspan="1">30,535</td><td align="right" rowspan="1" colspan="1">39,315</td><td align="right" rowspan="1" colspan="1">2,205</td><td align="right" rowspan="1" colspan="1">2,811</td></tr></tbody></table></table-wrap><table-wrap id="t2-ehp0115-000659" position="float"><label>Table 2</label><caption><p>Arsenic concentrations in coal, food, and indoor air in Guizhou, China.</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1"/><th colspan="4" align="center" rowspan="1">Arsenic in:<hr/></th></tr><tr><th align="left" rowspan="1" colspan="1">Endemic county</th><th align="center" rowspan="1" colspan="1">Coal (mg/kg)</th><th align="center" rowspan="1" colspan="1">Unventilated stove-dried corn (mg/kg)</th><th align="center" rowspan="1" colspan="1">Unventilated stove-dried chili (mg/kg)</th><th align="center" rowspan="1" colspan="1">Indoor air (mg/m<sup>3</sup>)</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">Xingren<xref ref-type="table-fn" rid="tfn2-ehp0115-000659">a</xref></td><td align="center" rowspan="1" colspan="1">418 &#x000b1; 530 (13)</td><td align="left" rowspan="1" colspan="1">4 &#x000b1; 3 (70)</td><td align="center" rowspan="1" colspan="1">512 &#x000b1; 300 (71)</td><td align="center" rowspan="1" colspan="1">0.3 &#x000b1; 0.2 (37)</td></tr><tr><td align="left" rowspan="1" colspan="1">Xingyi</td><td align="center" rowspan="1" colspan="1">265 &#x000b1; 352 (14)</td><td align="left" rowspan="1" colspan="1">7 &#x000b1; 12 (20)</td><td align="center" rowspan="1" colspan="1">694 &#x000b1; 545 (20)</td><td align="center" rowspan="1" colspan="1">&#x02014;</td></tr><tr><td align="left" rowspan="1" colspan="1">Anlong</td><td align="center" rowspan="1" colspan="1">624 &#x000b1; 8