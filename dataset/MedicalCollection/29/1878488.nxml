cle-title><source>Lancet</source><year>2005</year><volume>366</volume><fpage>2012</fpage><lpage>2018</lpage><pub-id pub-id-type="pmid">16338450</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(05)67669-6</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moorthy</surname><given-names>VS</given-names></name><name><surname>Imoukhuede</surname><given-names>EB</given-names></name><name><surname>Milligan</surname><given-names>P</given-names></name><name><surname>Bojang</surname><given-names>K</given-names></name><name><surname>Keating</surname><given-names>S</given-names></name><name><surname>Kaye</surname><given-names>P</given-names></name><name><surname>Pinder</surname><given-names>M</given-names></name><name><surname>Gilbert</surname><given-names>SC</given-names></name><name><surname>Walraven</surname><given-names>G</given-names></name><name><surname>Brian</surname><given-names>M</given-names></name><name><surname>Greenwood</surname><given-names>BM</given-names></name><name><surname>Hill</surname><given-names>ASV</given-names></name></person-group><article-title>Randomised, double-blind, controlled vaccine efficacy trial of DNA/MVA ME-TRAP against malaria infection in Gambian adults</article-title><source>PLoS Med</source><year>2004</year><volume>1</volume><fpage>e33</fpage><pub-id pub-id-type="pmid">15526058</pub-id><pub-id pub-id-type="doi">10.1371/journal.pmed.0010033</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><collab>Centers for Disease Control and Prevention</collab></person-group><article-title>Hepatitis B virus: a comprehensive strategy for eliminating transmission in the United States through universal childhood vaccination: recommendations of the Immunization Practices Advisory Committee (ACIP)</article-title><source>MMWR</source><year>1991</year><volume>40</volume><fpage>1</fpage><lpage>19</lpage></citation></ref><ref id="B11"><citation citation-type="other"><article-title>Child Care Act 1983, no 74</article-title></citation></ref><ref id="B12"><citation citation-type="other"><article-title>Constitution of the Republic of South Africa 1996, No.108</article-title></citation></ref><ref id="B13"><citation citation-type="other"><article-title>Age of Majority Act 1972, No.57</article-title></citation></ref><ref id="B14"><citation citation-type="other"><article-title>Children's Act 2005, No. 38</article-title><ext-link ext-link-type="uri" xlink:href="http://ci.org.za/depts/ci/plr/pdf/bills/childrensAct38-2005.pdf"/></citation></ref><ref id="B15"><citation citation-type="other"><person-group person-group-type="author"><collab>Institute of Child Health</collab></person-group><article-title>Topic E 11: clinical investigation of medicinal products in the paediatric population</article-title><year>2000</year><ext-link ext-link-type="uri" xlink:href="http://www.emea.eu.int/pdfs/human/ich/271199EN.pdf"/></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Levine</surname><given-names>RJ</given-names></name></person-group><source>Ethics and regulation of clinical research</source><year>1988</year><publisher-name>London: Yale University Press</publisher-name></citation></ref><ref id="B17"><citation citation-type="other"><article-title>National Health Act No. 61, of 2003, Government Gazette No. 27503, 18 April 2005</article-title></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><collab>Department of Health</collab></person-group><source>Ethics in health research: principles, structures and processes</source><year>2004</year><publisher-name>Pretoria</publisher-name></citation></ref><ref id="B19"><citation citation-type="other"><person-group person-group-type="author"><collab>South African Medical Research Council</collab></person-group><article-title>Guidelines on ethics of medical research: HIV preventative vaccine trials</article-title><source>Cape Town</source><year>2003</year><ext-link ext-link-type="uri" xlink:href="http://www.sahealthinfo.org/ethics/ethicsbook5.pdf"/></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><collab>Department of Health</collab></person-group><source>Guidelines for good practice in the conduct of clinical trials in human participants in South Africa</source><year>2000</year><publisher-name>Pretoria</publisher-name></citation></ref><ref id="B21"><citation citation-type="other"><person-group person-group-type="author"><collab>South African Medical Research Council</collab></person-group><article-title>Guidelines onethics of medical research: general principles</article-title><source>Cape Town</source><year>2001</year><ext-link ext-link-type="uri" xlink:href="http://www.sahealthinfo.org/ethics/ethicsbook1.pdf"/></citation></ref><ref id="B22"><citation citation-type="other"><person-group person-group-type="author"><collab>Republic of South Africa, Government Gazette</collab></person-group><article-title>Regulations relating to research on human subjects</article-title><source>Gazette No 8629, 23 February, 2007, Regulation No 29637, regulations 10&#x02013;16</source></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Strode</surname><given-names>A</given-names></name><name><surname>Slack</surname><given-names>C</given-names></name><name><surname>Grant</surname><given-names>K</given-names></name><name><surname>Mushariwa</surname><given-names>M</given-names></name></person-group><article-title>Ethical and legal challenges in enrolling adolescents in medical research in South Africa: implications for HIV vaccine trials</article-title><source>South African Journal of Science</source><year>2005</year><volume>101</volume><fpage>224</fpage><lpage>228</lpage></citation></ref><ref id="B24"><cit