title><source>Acta Odontol Scand</source><year>1993</year><volume>51</volume><fpage>323</fpage><lpage>331</lpage><pub-id pub-id-type="pmid">8279273</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tuxen</surname><given-names>A</given-names></name><name><surname>Bakke</surname><given-names>M</given-names></name><name><surname>Pinholt</surname><given-names>EM</given-names></name></person-group><article-title>Comparative data from young men and women on masseter muscle fibres, function and facial morphology</article-title><source>Arch Oral Biol</source><year>1999</year><volume>44</volume><fpage>509</fpage><lpage>518</lpage><pub-id pub-id-type="pmid">10401529</pub-id><pub-id pub-id-type="doi">10.1016/S0003-9969(99)00008-4</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goto</surname><given-names>TK</given-names></name><name><surname>Langenbach</surname><given-names>GE</given-names></name><name><surname>Korioth</surname><given-names>TW</given-names></name><name><surname>Hagiwara</surname><given-names>M</given-names></name><name><surname>Tonndorf</surname><given-names>ML</given-names></name><name><surname>Hannam</surname><given-names>AG</given-names></name></person-group><article-title>Functional movements of putative jaw muscle insertions</article-title><source>Anat Rec</source><year>1995</year><volume>242</volume><fpage>278</fpage><lpage>288</lpage><pub-id pub-id-type="pmid">7668413</pub-id><pub-id pub-id-type="doi">10.1002/ar.1092420218</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goto</surname><given-names>TK</given-names></name><name><surname>Langenbach</surname><given-names>GE</given-names></name><name><surname>Hannam</surname><given-names>AG</given-names></name></person-group><article-title>Length changes in the human masseter muscle after jaw movement</article-title><source>Anat Rec</source><year>2001</year><volume>262</volume><fpage>293</fpage><lpage>300</lpage><pub-id pub-id-type="pmid">11241197</pub-id><pub-id pub-id-type="doi">10.1002/1097-0185(20010301)262:3&#x0003c;293::AID-AR1043&#x0003e;3.0.CO;2-B</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gesch</surname><given-names>D</given-names></name><name><surname>Kirbschus</surname><given-names>A</given-names></name><name><surname>Gedrange</surname><given-names>T</given-names></name></person-group><article-title>Do bivariate and multivariate cephalometric analyses lead to different results concerning the skeletal cause of postnormal occlusion?</article-title><source>Funct Orthod</source><year>2005</year><volume>22</volume><fpage>6</fpage><lpage>8</lpage><comment>10, 12-3</comment><pub-id pub-id-type="pmid">16536177</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Throckmorton</surname><given-names>GS</given-names></name><name><surname>Ellis</surname><given-names>E</given-names><suffix>3rd</suffix></name><name><surname>Buschang</surname><given-names>PH</given-names></name></person-group><article-title>Morphologic and biomechanical correlates with maximum bite forces in orthognathic surgery patients</article-title><source>J Oral Maxillofac Surg</source><year>2000</year><volume>58</volume><fpage>515</fpage><lpage>524</lpage><pub-id pub-id-type="pmid">10800907</pub-id><pub-id pub-id-type="doi">10.1016/S0278-2391(00)90014-4</pub-id></citation></ref></ref-list></back></article>