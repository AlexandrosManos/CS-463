"pmid">7770778</pub-id></citation></ref><ref id="pone.0000319-Shadlen1"><label>37</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shadlen</surname><given-names>MN</given-names></name><name><surname>Newsome</surname><given-names>WT</given-names></name></person-group><year>1995</year><article-title>Is there a signal in the noise?</article-title><source>Curr Opin Neurobiol</source><volume>5</volume><fpage>248</fpage><lpage>250</lpage><pub-id pub-id-type="pmid">7620314</pub-id></citation></ref><ref id="pone.0000319-Softky2"><label>38</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Softky</surname><given-names>WR</given-names></name></person-group><year>1995</year><article-title>Simple codes versus efficient codes.</article-title><source>Curr Opin Neurobiol</source><volume>5</volume><fpage>239</fpage><lpage>247</lpage><pub-id pub-id-type="pmid">7620313</pub-id></citation></ref><ref id="pone.0000319-Nowak1"><label>39</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nowak</surname><given-names>LG</given-names></name><name><surname>Sanchez-Vives</surname><given-names>MV</given-names></name><name><surname>McCormick</surname><given-names>DA</given-names></name></person-group><year>1997</year><article-title>Influence of low and high frequency inputs on spike timing in visual cortical neurons.</article-title><source>Cereb Cortex</source><volume>7</volume><fpage>487</fpage><lpage>501</lpage><pub-id pub-id-type="pmid">9276174</pub-id></citation></ref><ref id="pone.0000319-Stevens1"><label>40</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stevens</surname><given-names>CF</given-names></name><name><surname>Zador</surname><given-names>AM</given-names></name></person-group><year>1998</year><article-title>Input synchrony and the irregular firing of cortical neurons.</article-title><source>Nat