339</lpage><pub-id pub-id-type="pmid">16421149</pub-id><pub-id pub-id-type="doi">10.1136/bmj.38701.399942.63</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vandenbroucke</surname><given-names>JP</given-names></name></person-group><article-title>Case reports of suspected adverse drug reactions: case reports were dismissed too quickly</article-title><source>BMJ</source><year>2006</year><volume>332</volume><fpage>488</fpage><pub-id pub-id-type="pmid">16497772</pub-id><pub-id pub-id-type="doi">10.1136/bmj.332.7539.488</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Browman</surname><given-names>GP</given-names></name></person-group><article-title>Essence of evidence-based medicine: a case report</article-title><source>J Clin Oncol</source><year>1999</year><volume>17</volume><fpage>1969</fpage><lpage>1973</lpage><pub-id pub-id-type="pmid">10561246</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hoffman</surname><given-names>JR</given-names></name></person-group><article-title>Rethinking case reports</article-title><source>West J Med</source><year>1999</year><volume>170</volume><fpage>253</fpage><lpage>254</lpage><pub-id pub-id-type="pmid">10379213</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vandenbroucke</surname><given-names>JP</given-names></name></person-group><article-title>Case reports in an evidence-based world</article-title><source>J R Soc Med</source><year>1999</year><volume>92</volume><fpage>159</fpage><lpage>163</lpage><pub-id pub-id-type="pmid">10450190</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Glasziou</surname><given-names>P</given-names></name><name><surname>Vandenbroucke</surname><given-names>JP</given-names></name><name><surname>Chalmers</surname><given-names>I</given-names></name></person-group><article-title>Assessing the quality of research</article-title><source>BMJ</source><year>2004</year><volume>328</volume><fpage>39</fpage><lpage>41</lpage><pub-id pub-id-type="pmid">14703546</pub-id><pub-id pub-id-type="doi">10.1136/bmj.328.7430.39</pub-id></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Jenicek</surname><given-names>M</given-names></name></person-group><source>Clinical Case Reporting in Evidence-Based Medicine</source><year>1999</year><publisher-name>Oxford: Butterworth-Heinemann</publisher-name><fpage>117</fpage></citation></ref></ref-list></back></article>