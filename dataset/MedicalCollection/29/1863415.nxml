></name></person-group><article-title>Magnetic nano- and microparticles for targeted drug delivery</article-title><source>Smart nanoparticles in nanomedicine &#x02013; the MML series</source><year>2006</year><volume>8</volume><publisher-name>London, UK: Kentus Books</publisher-name><fpage>77</fpage><lpage>126</lpage></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gersting</surname><given-names>SW</given-names></name><name><surname>Schillinger</surname><given-names>U</given-names></name><name><surname>Lausier</surname><given-names>J</given-names></name><name><surname>Nicklaus</surname><given-names>P</given-names></name><name><surname>Rudolph</surname><given-names>C</given-names></name><name><surname>Plank</surname><given-names>C</given-names></name><name><surname>Reinhardt</surname><given-names>D</given-names></name><name><surname>Rosenecker</surname><given-names>J</given-names></name></person-group><article-title>Gene delivery to respiratory epithelial cells by magnetofection</article-title><source>J Gene Med</source><year>2004</year><volume>6</volume><fpage>913</fpage><lpage>922</lpage><pub-id pub-id-type="pmid">15293350</pub-id><pub-id pub-id-type="doi">10.1002/jgm.569</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johannsen</surname><given-names>M</given-names></name><name><surname>Thiesen</surname><given-names>B</given-names></name><name><surname>Gneveckow</surname><given-names>U</given-names></name><name><surname>Taymoorian</surname><given-names>K</given-names></name><name><surname>Waldofner</surname><given-names>N</given-names></name><name><surname>Scholz</surname><given-names>R</given-names></name><name><surname>Deger</surname><given-names>S</given-names></name><name><surname>Jung</surname><given-names>K</given-names></name><name><surname>Loening</surname><given-names>SA</given-names></name><name><surname>Jor