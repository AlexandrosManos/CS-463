trics</source><year>1998</year><volume>54</volume><fpage>646</fpage><lpage>661</lpage><pub-id pub-id-type="pmid">9660631</pub-id><pub-id pub-id-type="doi">10.2307/3109771</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Conaway</surname><given-names>MR</given-names></name></person-group><article-title>A random effects model for binary data</article-title><source>Biometrics</source><year>1990</year><volume>46</volume><fpage>317</fpage><lpage>328</lpage><pub-id pub-id-type="doi">10.2307/2531437</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pulkstenis</surname><given-names>EP</given-names></name><name><surname>Ten Have</surname><given-names>TR</given-names></name><name><surname>Landis</surname><given-names>JR</given-names></name></person-group><article-title>Model for the analysis of binary longitudinal pain data subject to informative dropout through remediation</article-title><source>J Am Stat Assoc</source><year>1998</year><volume>93</volume><fpage>438</fpage><lpage>450</lpage><pub-id pub-id-type="doi">10.2307/2670091</pub-id></citation></ref></ref-list></back></article>