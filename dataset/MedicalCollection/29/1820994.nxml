rson-group person-group-type="author"><name><surname>&#x000d8;ster&#x000e5;s</surname><given-names>O</given-names></name><name><surname>Lund</surname><given-names>A</given-names></name></person-group><article-title>Epidemiological Analyses of the Associations between Bovine Udder Health and Housing</article-title><source>Prev vet med</source><year>1988</year><volume>6</volume><fpage>79</fpage><lpage>90</lpage><pub-id pub-id-type="doi">10.1016/0167-5877(88)90046-3</pub-id></citation></ref></ref-list></back></article>