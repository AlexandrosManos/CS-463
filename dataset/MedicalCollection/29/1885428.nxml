ividuals</article-title><source>J Epidemiol Community Health</source><year>2005</year><volume>59</volume><fpage>729</fpage><lpage>36</lpage><pub-id pub-id-type="pmid">16100308</pub-id></citation></ref><ref id="B25"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Rasbash</surname><given-names>J</given-names></name><name><surname>Steele</surname><given-names>F</given-names></name><name><surname>Browne</surname><given-names>W</given-names></name></person-group><source>A User's Guide to MLwiN, Version 2.0. Documentation Version 2.1e</source><year>2003</year><publisher-name>London, UK: Centre for Multilevel Modelling, Institute of Education, University of London</publisher-name></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Davis</surname><given-names>P</given-names></name><name><surname>Gribben</surname><given-names>B</given-names></name></person-group><article-title>Rational prescribing and interpractitioner variation. A multilevel approach</article-title><source>Int J Technol Assess Health Care</source><year>1995</year><volume>11</volume><fpage>428</fpage><lpage>442</lpage><pub-id pub-id-type="pmid">7591545</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Davis</surname><given-names>P</given-names></name><name><surname>Gribben</surname><given-names>B</given-names></name><name><surname>Lay-Yee</surname><given-names>R</given-names></name><name><surname>Scott</surname><given-names>A</given-names></name></person-group><article-title>How much variation in clinical activity is there between general practitioners? A multi-level analysis of decision-making in primary care</article-title><source>J Health Serv Res Policy</source><year>2002</year><volume>7</volume><fpage>202</fpage><lpage>208</lpage><pub-id pub-id-type="pmid">12425779</pub-id></citation></ref><ref id="B28"><citation citati