me><name><surname>Sanyal</surname><given-names>S</given-names></name><name><surname>Templeton</surname><given-names>TJ</given-names></name></person-group><article-title>Hypervariability within the Rifin, Stevor and Pfmc-2TM superfamilies in <italic>Plasmodium falciparum</italic></article-title><source>Nucleic Acids Res</source><year>2006</year><volume>34</volume><fpage>6696</fpage><lpage>6707</lpage><pub-id pub-id-type="pmid">17148488</pub-id><pub-id pub-id-type="doi">10.1093/nar/gkl942</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Janssen</surname><given-names>CS</given-names></name><name><surname>Phillips</surname><given-names>RS</given-names></name><name><surname>Turner</surname><given-names>CM</given-names></name><name><surname>Barrett</surname><given-names>MP</given-names></name></person-group><article-title><italic>Plasmodium </italic>interspersed repeats: the major multigene superfamily of malaria parasites</article-title><source>Nucleic Acids Res</source><year>2004</year><volume>32</volume><fpage>5712</fpage><lpage>5720</lpage><pub-id pub-id-type="pmid">15507685</pub-id><pub-id pub-id-type="doi">10.1093/nar/gkh907</pub-id></citation></ref></ref-list></back></article>