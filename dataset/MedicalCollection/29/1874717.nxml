mes></name><name><surname>Bardon</surname><given-names>Christiana G</given-names></name><name><surname>Spurr</surname><given-names>Cynthia D</given-names></name><name><surname>Carchidi</surname><given-names>Patricia J</given-names></name><name><surname>Kittler</surname><given-names>Anne F</given-names></name><name><surname>Goldszer</surname><given-names>Robert C</given-names></name><name><surname>Fairchild</surname><given-names>David G</given-names></name><name><surname>Sussman</surname><given-names>Andrew J</given-names></name><name><surname>Kuperman</surname><given-names>Gilad J</given-names></name><name><surname>Bates</surname><given-names>David W</given-names></name></person-group><article-title>A cost-benefit analysis of electronic medical records in primary care</article-title><source>Am J Med</source><year>2003</year><month>4</month><day>1</day><volume>114</volume><issue>5</issue><fpage>397</fpage><lpage>403</lpage><pub-id pub-id-type="medline">12714130</pub-id><pub-id pub-id-type="pii">S0002934303000573</pub-id><pub-id pub-id-type="doi">10.1016/S0002-9343(03)00057-3</pub-id><pub-id pub-id-type="pmid">12714130</pub-id></element-citation></ref><ref id="ref12"><label>12</label><element-citation publication-type="book"><collab collab-type="authors">National Committee for Quality Assurance</collab><source>Physician Practice Connections: A Summary of Draft Standards and Elements (Version 2)</source><year>2005</year><publisher-loc>Washington, DC</publisher-loc><publisher-name>National Committee for Quality Assurance</publisher-name></element-citation></ref><ref id="ref13"><label>13</label><element-citation publication-type="book"><collab collab-type="authors">Advisory Board Company</collab><source>Clinical IT Benchmarking Survey</source><year>2006</year><publisher-loc>Washington, DC</publisher-loc><publisher-name>Advisory Board Company</publisher-name><fpage>183</fpage><lpage>220</lpage></element-citation></ref><ref id="ref14"><label>14</label><element-citation pub