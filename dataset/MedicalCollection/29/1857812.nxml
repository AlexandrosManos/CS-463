pe="pmid">15223341</pub-id></citation></ref><ref id="pcbi-0030076-b027"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chaturvedi</surname><given-names>R</given-names></name><name><surname>Huang</surname><given-names>C</given-names></name><name><surname>Kazmierczak</surname><given-names>B</given-names></name><name><surname>Schneider</surname><given-names>T</given-names></name><name><surname>Izaguirre</surname><given-names>JA</given-names></name><etal/></person-group><year>2005</year><article-title>On multiscale approaches to three-dimensional modelling of morphogenesis</article-title><source>J R Soc Interface</source><volume>2</volume><fpage>237</fpage><lpage>253</lpage><pub-id pub-id-type="pmid">16849182</pub-id></citation></ref><ref id="pcbi-0030076-b028"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Christley</surname><given-names>S</given-names></name><name><surname>Newman</surname><given-names>SA</given-names></name><name><surname>Alber</surname><given-names>MS</given-names></name></person-group><year>2007</year><article-title>Agent-based model for developmental pattern formation with multiscale dynamics and varying cell geometry</article-title><comment>In:</comment><person-group person-group-type="editor"><name><surname>Deutsch</surname><given-names>IA</given-names></name><name><surname>Brusch</surname><given-names>L</given-names></name><name><surname>Byrne</surname><given-names>H</given-names></name><name><surname>de Vries</surname><given-names>G</given-names></name><name><surname>Herzel</surname><given-names>HP</given-names></name></person-group><source>Mathematical modeling of biological systems, volume I</source><publisher-loc>Boston</publisher-loc><publisher-name>Birkh&#x000e4;user</publisher-name><fpage>155</fpage><lpage>167</lpage></citation></ref><ref id="pcbi-0030076-b029"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Christley<