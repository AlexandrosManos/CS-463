1998</year><volume>4</volume><fpage>321</fpage><lpage>327</lpage><pub-id pub-id-type="pmid">9500606</pub-id><pub-id pub-id-type="doi">10.1038/nm0398-321</pub-id></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Steinbeck</surname><given-names>J</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Shillinglaw S, Benson J</surname></name></person-group><article-title>On Fishing</article-title><source>America and Americans and selected nonfiction</source><year>2002</year><publisher-name>Viking, Penguin Putman Inc., New York, NY</publisher-name><fpage>132</fpage><lpage>135</lpage></citation></ref></ref-list></back></article>