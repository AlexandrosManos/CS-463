er">32</td><td align="center">1.0</td><td align="center">-</td></tr><tr><td align="left">&#x02003;&#x0003e;0, &#x0003c;= 8.6 ppm*yrs.</td><td align="center">60</td><td align="center">9</td><td align="center">0.7</td><td align="center">0.3&#x02013;1.4</td><td align="center">10</td><td align="center">1.8</td><td align="center">0.8&#x02013;3.8</td><td align="center">8</td><td align="center">0.8</td><td align="center">0.4&#x02013;1.8</td><td align="center">6</td><td align="center">1.0</td><td align="center">0.4&#x02013;2.4</td><td align="center">2</td><td align="center">0.7</td><td align="center">0.2&#x02013;3.0</td></tr><tr><td align="left">&#x02003;&#x0003e;8.6, &#x0003c;= 130 ppm*yrs.</td><td align="center">48</td><td align="center">10</td><td align="center">0.9</td><td align="center">0.4&#x02013;1.9</td><td align="center">7</td><td align="center">1.5</td><td align="center">0.6&#x02013;3.5</td><td align="center">14</td><td align="center">1.6</td><td align="center">0.8&#x02013;3.2</td><td align="center">4</td><td align="center">0.7</td><td align="center">0.2&#x02013;2.0</td><td align="center">3</td><td align="center">1.1</td><td align="center">0.3&#x02013;3.8</td></tr><tr><td align="left">&#x02003;&#x0003e;130 ppm*yrs.</td><td align="center">12</td><td align="center">1</td><td align="center">0.3</td><td align="center">0.04&#x02013;2.6</td><td align="center">2</td><td align="center">1.3</td><td align="center">0.3&#x02013;6.4</td><td align="center">2</td><td align="center">0.7</td><td align="center">0.1&#x02013;3.1</td><td align="center">3</td><td align="center">1.8</td><td align="center">0.5&#x02013;6.8</td><td align="center">1</td><td align="center">1.4</td><td align="center">0.2&#x02013;11.8</td></tr><tr><td align="left"><italic>Trend test*</italic></td><td></td><td></td><td></td><td align="center"><italic>P = 0.52 (neg.)</italic></td><td></td><td></td><td align="center"><italic>P = 0.51</italic></td><td></td><td></td><td align="center"><italic>P = 0.48</italic></td>