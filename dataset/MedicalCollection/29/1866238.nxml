a cohort for intervention trials.</article-title><source>J Acquir Immune Defic Syndr</source><year>2000</year><volume>23</volume><fpage>405</fpage><lpage>409</lpage><pub-id pub-id-type="pmid">10866233</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yahya-Malima</surname><given-names>KI</given-names></name><name><surname>Olsen</surname><given-names>BE</given-names></name><name><surname>Matee</surname><given-names>MI</given-names></name><name><surname>Fylkesnes</surname><given-names>K</given-names></name></person-group><article-title>The silent HIV epidemic among pregnant women within rural Northern Tanzania</article-title><source>BMC Public Health</source><year>2006</year><volume>6</volume><fpage>109</fpage><pub-id pub-id-type="pmid">16643653</pub-id><pub-id pub-id-type="doi">10.1186/1471-2458-6-109</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arroyo</surname><given-names>MA</given-names></name><name><surname>Hoelscher</surname><given-names>M</given-names></name><name><surname>Sateren</surname><given-names>W</given-names></name><name><surname>Samky</surname><given-names>E</given-names></name><name><surname>Maboko</surname><given-names>L</given-names></name><name><surname>Hoffman</surname><given-names>O</given-names></name><name><surname>Kijak</surname><given-names>G</given-names></name><name><surname>Robb</surname><given-names>M</given-names></name><name><surname>Birx</surname><given-names>DL</given-names></name><name><surname>McCutchan</surname><given-names>FE</given-names></name></person-group><article-title>HIV-1 diversity and prevalence differ between urban and rural areas in the Mbeya region of Tanzania</article-title><source>AIDS</source><year>2005</year><volume>19</volume><fpage>1517</fpage><lpage>1524</lpage><pub-id pub-id-type="pmid">16135906</pub-id><pub-id pub-id-type="doi">10.1097/01.aids.000018