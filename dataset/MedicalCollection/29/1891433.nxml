wspan="1" colspan="1">98.01</td><td align="left" rowspan="1" colspan="1">1.99</td><td align="left" rowspan="1" colspan="1">-</td></tr><tr><td align="left" rowspan="1" colspan="1">Eur&#x000e1;sia<xref ref-type="table-fn" rid="nt103">&#x0002a;</xref></td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">20</td><td align="left" rowspan="1" colspan="1">98.18</td><td align="left" rowspan="1" colspan="1">1.06</td><td align="left" rowspan="1" colspan="1">0.76</td></tr><tr><td align="left" rowspan="1" colspan="1">East Asia</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">18</td><td align="left" rowspan="1" colspan="1">100.59</td><td align="left" rowspan="1" colspan="1">&#x02212;0.59</td><td align="left" rowspan="1" colspan="1">-</td></tr><tr><td align="left" rowspan="1" colspan="1">Oceania</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">85.05</td><td align="left" rowspan="1" colspan="1">14.95</td><td align="left" rowspan="1" colspan="1">-</td></tr><tr><td align="left" rowspan="1" colspan="1">America</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">84.71</td><td align="left" rowspan="1" colspan="1">15.29</td><td align="left" rowspan="1" colspan="1">-</td></tr></tbody></table><table-wrap-foot><fn id="nt103"><label>&#x0002a;</label><p>The haplotype block is composed of <italic>DXS1012, DXS1002, DXS225, DXS1019 and DXS8114</italic>.</p></fn><fn id="nt104"><label>&#x0002a;&#x0002a;</label><p>Eurasia encompasses Europe, Middle East and Central Asia.</p></fn></table-wrap-foot></table-wrap><table-wrap id="pone-0000557-t004" position="float"><object-id pub-id-type="doi">10.1371/journal.pone.0000557.t004</object-id><label>Table 4</label><caption><title>Posterior means and quantiles for BATWING analysis.</title></caption><graph