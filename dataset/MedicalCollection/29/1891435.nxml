><source>Nature</source><volume>396</volume><fpage>643</fpage><lpage>649</lpage><pub-id pub-id-type="pmid">9872311</pub-id></citation></ref><ref id="pone.0000558-Rajagopalan1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rajagopalan</surname><given-names>H</given-names></name><name><surname>Lengauer</surname><given-names>C</given-names></name></person-group><year>2004</year><article-title>Aneuploidy and cancer.</article-title><source>Nature</source><volume>432</volume><fpage>338</fpage><lpage>341</lpage><pub-id pub-id-type="pmid">15549096</pub-id></citation></ref><ref id="pone.0000558-Cimini1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cimini</surname><given-names>D</given-names></name><name><surname>Degrassi</surname><given-names>F</given-names></name></person-group><year>2005</year><article-title>Aneuploidy: a matter of bad connections.</article-title><source>Trends Cell Biol</source><volume>15</volume><fpage>442</fpage><lpage>451</lpage><pub-id pub-id-type="pmid">16023855</pub-id></citation></ref><ref id="pone.0000558-Ly1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ly</surname><given-names>DH</given-names></name><name><surname>Lockhart</surname><given-names>DJ</given-names></name><name><surname>Lerner</surname><given-names>R</given-names></name><name><surname>Schultz</surname><given-names>PG</given-names></name></person-group><year>2000</year><article-title>Mitotic misregulation and human aging.</article-title><source>Science</source><volume>287</volume><fpage>2486</fpage><lpage>2492</lpage><pub-id pub-id-type="pmid">10741968</pub-id></citation></ref><ref id="pone.0000558-Youssoufian1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Youssoufian</surname><given-names>H</given-names></name><name><surname>Pyeritz</surname><g