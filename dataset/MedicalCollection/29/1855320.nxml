rce>Anal Biochem</source><year>1987</year><volume>162</volume><fpage>156</fpage><lpage>159</lpage><pub-id pub-id-type="pmid">2440339</pub-id><pub-id pub-id-type="doi">10.1016/0003-2697(87)90021-2</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Campiotto</surname><given-names>S</given-names></name><name><surname>Pinho</surname><given-names>JR</given-names></name><name><surname>Carrilho</surname><given-names>FJ</given-names></name><name><surname>Da Silva</surname><given-names>LC</given-names></name><name><surname>Souto</surname><given-names>FJ</given-names></name><name><surname>Spinelli</surname><given-names>V</given-names></name><name><surname>Pereira</surname><given-names>LM</given-names></name><name><surname>Coelho</surname><given-names>HS</given-names></name><name><surname>Silva</surname><given-names>AO</given-names></name><name><surname>Fonseca</surname><given-names>JC</given-names></name><name><surname>Rosa</surname><given-names>H</given-names></name><name><surname>Lacet</surname><given-names>CM</given-names></name><name><surname>Bernardini</surname><given-names>AP</given-names></name></person-group><article-title>Geographic distribution of hepatitis C virus genotypes in Brazil</article-title><source>Braz J Med Biol Res</source><year>2005</year><volume>38</volume><fpage>41</fpage><lpage>49</lpage><pub-id pub-id-type="pmid">15665987</pub-id><pub-id pub-id-type="doi">10.1590/S0100-879X2005000100007</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jadoul</surname><given-names>M</given-names></name><name><surname>Cornu</surname><given-names>C</given-names></name><name><surname>van Ypersele de Strihou</surname><given-names>C</given-names></name></person-group><article-title>Universal precautions prevent hepatitis C virus transmission: a 54 month follow-up of the Belgian Multicenter Study. The Universitaires C