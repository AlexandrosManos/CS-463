n></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Knight</surname><given-names>CD</given-names></name><name><surname>Griffin</surname><given-names>FD</given-names></name></person-group><article-title>An improved technique for low anterior resection using the EEA stapler</article-title><source>Surgery</source><year>1980</year><volume>88</volume><fpage>710</fpage><lpage>714</lpage><pub-id pub-id-type="pmid">7434211</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cohen</surname><given-names>Z</given-names></name><name><surname>Myers</surname><given-names>E</given-names></name><name><surname>Langer</surname><given-names>B</given-names></name><name><surname>Taylor</surname><given-names>B</given-names></name><name><surname>Railton</surname><given-names>RH</given-names></name><name><surname>Jamieson</surname><given-names>C</given-names></name></person-group><article-title>Double stapling technique for low anterior resection</article-title><source>Dis Colon Rectum</source><year>1983</year><volume>26</volume><fpage>231</fpage><lpage>235</lpage><pub-id pub-id-type="pmid">6839891</pub-id><pub-id pub-id-type="doi">10.1007/BF02562484</pub-id></citation></ref><ref id="B18"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Griffen</surname><given-names>FD</given-names></name><name><surname>Knight</surname><given-names>CD</given-names></name></person-group><article-title>Low rectal anastomosis with the EEA stapler</article-title><source>Surgical Rounds</source><comment>1983, September 18&#x02013;26.</comment></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Feinberg</surname><given-names>SM</given-names></name><name><surname>Parker</surname><given-names>F</given-names></name><name><surname>Cohen</surname><given-names>Z</given-names></