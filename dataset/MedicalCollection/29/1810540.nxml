ame></person-group><article-title>Archived specimens: a platform for discussion</article-title><source>Community Genet</source><year>1999</year><volume>2</volume><fpage>51</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">11787507</pub-id><pub-id pub-id-type="doi">10.1159/000016187</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Becich</surname><given-names>MJ</given-names></name><name><surname>Gilbertson</surname><given-names>JR</given-names></name><name><surname>Gupta</surname><given-names>D</given-names></name><name><surname>Patel</surname><given-names>A</given-names></name><name><surname>Grzybicki</surname><given-names>DM</given-names></name><name><surname>Raab</surname><given-names>SS</given-names></name></person-group><article-title>Pathology and patient safety: the critical role of pathology informatics in error reduction and quality initiatives</article-title><source>Clin Lab Med</source><year>2004</year><volume>24</volume><fpage>913</fpage><lpage>43, vi</lpage><pub-id pub-id-type="pmid">15555749</pub-id><pub-id pub-id-type="doi">10.1016/j.cll.2004.05.019</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Melamed</surname><given-names>J</given-names></name><name><surname>Datta</surname><given-names>MW</given-names></name><name><surname>Becich</surname><given-names>MJ</given-names></name><name><surname>Orenstein</surname><given-names>JM</given-names></name><name><surname>Dhir</surname><given-names>R</given-names></name><name><surname>Silver</surname><given-names>S</given-names></name><name><surname>Fidelia-Lambert</surname><given-names>M</given-names></name><name><surname>Kadjacsy-Balla</surname><given-names>A</given-names></name><name><surname>Macias</surname><given-names>V</given-names></name><name><surname>Patel</surname><given-names>A</given-names></name><name><surname>Walden</surname><given-names>