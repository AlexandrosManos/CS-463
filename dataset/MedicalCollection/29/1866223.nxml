rats</article-title><source>Braz J Med Biol Res</source><year>2000</year><volume>33</volume><fpage>1363</fpage><lpage>1368</lpage><pub-id pub-id-type="pmid">11050669</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ahmed</surname><given-names>SS</given-names></name><name><surname>Jaferi</surname><given-names>GA</given-names></name><name><surname>Narang</surname><given-names>RM</given-names></name><name><surname>Regan</surname><given-names>TJ</given-names></name></person-group><article-title>Preclinical abnormality of left ventricular function in diabetes mellitus</article-title><source>Am Heart J</source><year>1975</year><volume>89</volume><fpage>53</fpage><lpage>8</lpage><pub-id pub-id-type="doi">10.1016/0002-8703(75)90039-3</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maeda</surname><given-names>CY</given-names></name><name><surname>Fernandes</surname><given-names>TG</given-names></name><name><surname>Timm</surname><given-names>HB</given-names></name><name><surname>Irigoyen</surname><given-names>MC</given-names></name></person-group><article-title>Autonomic dysfunction in short-term experimental diabetes</article-title><source>Hypertension</source><year>1995</year><volume>26</volume><fpage>1100</fpage><lpage>1104</lpage><pub-id pub-id-type="pmid">7498976</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Joffe</surname><given-names>II</given-names></name><name><surname>Travers</surname><given-names>KE</given-names></name><name><surname>Perreault-Micali</surname><given-names>CL</given-names></name><name><surname>Hampton</surname><given-names>T</given-names></name><name><surname>Katz</surname><given-names>SE</given-names></name><name><surname>Morgan</surname><given-names>JP</given-names></name><name><surname>Douglas</surname><given