/source><year>1999</year><volume>144</volume><issue>5</issue><fpage>111</fpage><lpage>114</lpage><pub-id pub-id-type="pmid">10070699</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gibbs</surname><given-names>EPJ</given-names></name><name><surname>Rweyemam</surname><given-names>MM</given-names></name></person-group><article-title>Bovine herpesvirus 1</article-title><source>Vet Bull</source><year>1977</year><volume>47</volume><fpage>317</fpage><lpage>343</lpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Graham</surname><given-names>DA</given-names></name><name><surname>German</surname><given-names>A</given-names></name><name><surname>McLaren</surname><given-names>IE</given-names></name><name><surname>Fitzpatrick</surname><given-names>DA</given-names></name></person-group><article-title>Testing of bulk tank milk from Northern Ireland dairy herds for viral RNA and antibody to bovine viral diarrhoea virus</article-title><source>Vet Rec</source><year>2001</year><volume>149</volume><issue>9</issue><fpage>261</fpage><lpage>265</lpage><pub-id pub-id-type="pmid">11558660</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Houe</surname><given-names>H</given-names></name></person-group><article-title>Epidemiology of bovine viral diarrhea virus</article-title><source>Vet Clin North Am Food Anim Pract</source><year>1995</year><volume>11</volume><issue>3</issue><fpage>521</fpage><lpage>547</lpage><pub-id pub-id-type="pmid">8581861</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Houe</surname><given-names>H</given-names></name></person-group><article-title>Epidemiological features and economical importance of bovine virus diarrhoea virus (BVDV) infections</article-titl