n-names></name></person-group><article-title>Neuroanatomy of the self: evidence from patients with frontotemporal dementia</article-title><source>Neurology</source><year>2001</year><volume>11</volume><fpage>817</fpage><lpage>21</lpage><pub-id pub-id-type="pmid">11552010</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shi</surname><given-names>J</given-names></name><name><surname>Shaw</surname><given-names>CL</given-names></name><name><surname>Du Plessis</surname><given-names>D</given-names></name><name><surname>Richardson</surname><given-names>AM</given-names></name><name><surname>Bailey</surname><given-names>KL</given-names></name><name><surname>Julien</surname><given-names>C</given-names></name><name><surname>Stopford</surname><given-names>C</given-names></name><name><surname>Thompson</surname><given-names>J</given-names></name><name><surname>Varma</surname><given-names>A</given-names></name><name><surname>Craufurd</surname><given-names>D</given-names></name><name><surname>Tian</surname><given-names>J</given-names></name><name><surname>Pickering-Brown</surname><given-names>S</given-names></name><name><surname>Neary</surname><given-names>D</given-names></name><name><surname>Snowden</surname><given-names>JS</given-names></name><name><surname>Mann</surname><given-names>DM</given-names></name></person-group><article-title>Histopathological changes underlying frontotemporal lobar degeneration with clinicopathological correlation</article-title><source>Acta Neuropathol</source><year>2005</year><volume>110</volume><fpage>501</fpage><lpage>12</lpage><pub-id pub-id-type="pmid">16222525</pub-id><pub-id pub-id-type="doi">10.1007/s00401-005-1079-4</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kertesz</surname><given-names>A</given-names></name><name><surname>McMonagle</surname><given-names>P</given-names></name><name