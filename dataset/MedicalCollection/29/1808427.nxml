"pone.0000297-Blick1"><label>35</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blick</surname><given-names>DW</given-names></name><name><surname>Adair</surname><given-names>ER</given-names></name><name><surname>Hurt</surname><given-names>WD</given-names></name><name><surname>Sherry</surname><given-names>CJ</given-names></name><name><surname>Walters</surname><given-names>TJ</given-names></name><etal/></person-group><year>1997</year><article-title>Thresholds of microwave-evoked warmth sensation in human skin.</article-title><source>Bioelectromagnetics</source><volume>18</volume><fpage>403</fpage><lpage>409</lpage><pub-id pub-id-type="pmid">9261536</pub-id></citation></ref><ref id="pone.0000297-Brown1"><label>36</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>DO</given-names></name><name><surname>Lu</surname><given-names>ST</given-names></name><name><surname>Elson</surname><given-names>EC</given-names></name></person-group><year>1994</year><article-title>Characteristics of evoked body movements in mice.</article-title><source>Bioelectromagnetics</source><volume>15</volume><fpage>143</fpage><lpage>161</lpage><pub-id pub-id-type="pmid">8024606</pub-id></citation></ref><ref id="pone.0000297-Reeder1"><label>37</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reeder</surname><given-names>WG</given-names></name><name><surname>Cowles</surname><given-names>RB</given-names></name></person-group><year>1951</year><article-title>Aspects of thermoregulation in bats.</article-title><source>J Mammal</source><volume>32</volume><fpage>389</fpage><lpage>403</lpage></citation></ref><ref id="pone.0000297-Neuweiler1"><label>38</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Neuweiler</surname><given-names>G</given-names></name></person-group><year>2000</year><source>The bi