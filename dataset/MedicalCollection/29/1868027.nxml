-title>Prevalence of neural tube defects in the province of Quebec, 1992</article-title><source>Can J Public Health</source><year>1999</year><volume>90</volume><fpage>237</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">10489719</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Allard</surname><given-names>P</given-names></name><name><surname>Rochette</surname><given-names>L</given-names></name></person-group><article-title>The descriptive epidemiology of hysterectomy, Province of Quebec, 1981&#x02013;1988</article-title><source>Ann Epidemiol</source><year>1991</year><volume>1</volume><fpage>541</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">1669534</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Choiniere</surname><given-names>R</given-names></name><name><surname>Pageau</surname><given-names>M</given-names></name><name><surname>Ferland</surname><given-names>M</given-names></name></person-group><article-title>Prevalence and geographic disparities in certain congenital anomalies in Quebec: comparison of estimation methods</article-title><source>Chronic Dis Can</source><year>1999</year><volume>20</volume><fpage>51</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">10455037</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pilote</surname><given-names>L</given-names></name><name><surname>Lavoie</surname><given-names>F</given-names></name><name><surname>Ho</surname><given-names>V</given-names></name><name><surname>Eisenberg</surname><given-names>MJ</given-names></name></person-group><article-title>Changes in the treatment and outcomes of acute myocardial infarction in Quebec, 1988&#x02013;1995</article-title><source>Can Med Assoc J</source><year>2000</year><volume>163</volume><fpage>31</fpage><lpage>6</lpage><pub-id pub-id-type="pmi