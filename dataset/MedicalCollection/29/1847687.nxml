><article-title>Integrated algorithms for image analysis and classification of nuclear division for high-content cell-cycle screening</article-title><source>Int J Computational Intelligence and Applications</source><year>2006</year><volume>6</volume><fpage>21</fpage><lpage>43</lpage><pub-id pub-id-type="doi">10.1142/S1469026806001769</pub-id></citation></ref><ref id="B24"><citation citation-type="other"><person-group person-group-type="author"><collab>Velliste M.</collab><collab>Murphy R.F.</collab></person-group><article-title>Automated determination of protein subcellular locations from 3D fluorescence microscope images</article-title><year>2002</year><fpage>867</fpage><lpage>870</lpage></citation></ref><ref id="B25"><citation citation-type="other"><article-title>LIBSVM: a library for support vector machines</article-title><ext-link ext-link-type="uri" xlink:href="http://www.csie.ntu.edu.tw/~cjlin/libsvm"/></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><collab>Varma S.</collab><collab>Simon R.</collab></person-group><article-title>Bias in error estimation when using cross-validation for model selection</article-title><source>BMC Bioinformatics</source><year>2006</year><volume>7</volume><fpage>91</fpage><pub-id pub-id-type="pmid">16504092</pub-id><pub-id pub-id-type="doi">10.1186/1471-2105-7-91</pub-id></citation></ref><ref id="B27"><citation citation-type="book"><person-group person-group-type="author"><collab>Vapnik V.N.</collab></person-group><source>Statistical learning theory</source><year>1998</year><publisher-name>New York , John Wiley and Sons</publisher-name></citation></ref></ref-list></back></article>