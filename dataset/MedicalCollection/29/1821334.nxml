rson-group-type="author"><name><surname>Jovanov</surname><given-names>E</given-names></name><name><surname>Lilenkovic</surname><given-names>A</given-names></name><name><surname>Otto</surname><given-names>C</given-names></name><name><surname>de Groen</surname><given-names>P</given-names></name></person-group><article-title>A wireless body area network of intelligent motion sensors for computer assisted phsycial rehabilitation</article-title><source>Journal of NeuroEngineering and Rehabilitation</source><year>2005</year><volume>2</volume></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Miller</surname><given-names>N</given-names></name><name><surname>Jenkins</surname><given-names>O</given-names></name><name><surname>Kallman</surname><given-names>M</given-names></name><name><surname>Matari&#x00107;</surname><given-names>M</given-names></name></person-group><article-title>Motion Capture from Inertial Sensing for Untethered Humanoid Teleoperation</article-title><source>Proceedings, IEEE-RAS International Conference on Humanoid Robotics (Humanoids-2004)</source><year>2004</year><publisher-name>Santa Monica, CA</publisher-name></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gerkey</surname><given-names>B</given-names></name><name><surname>Vaughan</surname><given-names>R</given-names></name><name><surname>Howard</surname><given-names>A</given-names></name></person-group><article-title>The Player/Stage Project: Tools for Multi-Robot Distributed Sensor Systems</article-title><source>Proceedings of the International Conference on Advanced Robotics</source><year>2003</year><publisher-name>Coimbra, Portugal</publisher-name><fpage>317</fpage><lpage>323</lpage></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Powers</surname><given-names>A</given-names></name><name><surname>Kiesler</surname><given-names>S</given-names></name></person-group><article-title>The Advisor Robot: Tracing People's Mental Model from a Robot's Physical Attributes</article-title><source>Proceedings of the 2006 ACM Conference on Human-Robot Interaction</source><year>2006</year><publisher-name>Salt Lake City, UT: ACM Press</publisher-name><fpage>218</fpage><lpage>225</lpage></citation></ref><ref id="B22"><citation citation-type="other"><article-title>Interaction Lab: Human Robot Interaction for Post-Stroke Recovery Robot Project Page</article-title><ext-link ext-link-type="uri" xlink:href="http://www-robotics.usc.edu/interaction/?l=Research:Projects:post_stroke:index"/></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wainer</surname><given-names>J</given-names></name><name><surname>Feil-Seifer</surname><given-names>D</given-names></name><name><surname>Shell</surname><given-names>D</given-names></name><name><surname>Matari&#x00107;</surname><given-names>M</given-names></name></person-group><article-title>The role of physical embodiment in human-robot interaction</article-title><source>IEEE Proceedings of the International Workshop on Robot and Human Interactive Communication</source><year>2006</year><publisher-name>Hatfield, United Kingdom</publisher-name><fpage>117</fpage><lpage>122</lpage></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Koenig</surname><given-names>N</given-names></name><name><surname>Howard</surname><given-names>A</given-names></name></person-group><article-title>Design and use paradigms for gazebo, and open-source multi-robot simulator</article-title><source>IEEE/RSJ International Conference on Intelligent Robots and Systems</source><year>2004</year><publisher-name>Sendai, Japan</publisher-name><fpage>2149</fpage><lpage>2154</lpage></citation></ref><ref id="B25"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kanda</surname><given-names>T</given-names></name><name><surname>Hirano</surname><given-names>T</given-names></name><name><surname>Eaton</surname><given-names>D</given-names></name><name><surname>Ishiguro</surname><given-names>H</given-names></name></person-group><article-title>Person Identification and Interaction of Social Robots by Using Wireless Tags</article-title><source>IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS2003)</source><year>2003</year><publisher-name>Las Vegas, NV</publisher-name><fpage>1657</fpage><lpage>1664</lpage></citation></ref></ref-list></back></article>