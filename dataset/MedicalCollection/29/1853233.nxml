lspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">20</td><td align="left" rowspan="1" colspan="1">1,9&#x000b1;0,1</td><td align="left" rowspan="1" colspan="1">3,1&#x000b1;0,3</td><td align="left" rowspan="1" colspan="1">2875</td><td align="left" rowspan="1" colspan="1">875</td><td align="left" rowspan="1" colspan="1">NA</td><td align="left" rowspan="1" colspan="1">167</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">n&#x0200a;&#x0003d;&#x0200a;150</td><td align="left" rowspan="1" colspan="1">n&#x0200a;&#x0003d;&#x0200a;150</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">19</td><td align="left" rowspan="1" colspan="1">2,7&#x000b1;0,1</td><td align="left" rowspan="1" colspan="1">3,9&#x000b1;0,2</td><td align="left" rowspan="1" colspan="1">3200</td><td align="left" rowspan="1" colspan="1">2175</td><td align="left" rowspan="1" colspan="1">NA</td><td align="left" rowspan="1" colspan="1">549</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">n&#x0200a;&#x0003d;&#x0200a;215</td><td align="left" rowspan="1" colspan="1">n&#x0200a;&#x0003d;&#x0200a;215</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">24</td><td align="left" rowspan="1" colspan="1">3,8&#x000b1;0,3</td><td align="left" rowspan="1" colspan="1">6,2&#x000b1;0,6</td><td align="left" rowspan="1" colspan="1">675</td><td align="left" rowspan="1" colspan="1