e>9</volume><fpage>143</fpage><lpage>155</lpage><pub-id pub-id-type="doi">10.1101/gr.9.11.1143</pub-id></citation></ref><ref id="B23"><citation citation-type="other"><article-title>TORQUE PBS implementation</article-title><ext-link ext-link-type="uri" xlink:href="http://www.clusterresources.com/products/torque/"/></citation></ref><ref id="B24"><citation citation-type="other"><article-title>NCBI VECTOR Database</article-title><ext-link ext-link-type="uri" xlink:href="ftp://ftp.ncbi.nih.gov/blast/db/FASTA/vector.gz"/></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jurka</surname><given-names>J</given-names></name></person-group><article-title>Repbase Update: a database and an electronic journal of repetitive elements</article-title><source>Trends Genet</source><year>2000</year><volume>9</volume><fpage>418</fpage><lpage>420</lpage><pub-id pub-id-type="pmid">10973072</pub-id><pub-id pub-id-type="doi">10.1016/S0168-9525(00)02093-X</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>X</given-names></name><name><surname>Madan</surname><given-names>A</given-names></name></person-group><article-title>CAP3: A DNA sequence assembly program</article-title><source>Genome Res</source><year>1999</year><volume>9</volume><fpage>868</fpage><lpage>877</lpage><pub-id pub-id-type="pmid">10508846</pub-id><pub-id pub-id-type="doi">10.1101/gr.9.9.868</pub-id></citation></ref><ref id="B27"><citation citation-type="other"><article-title>MPIBlast software</article-title><ext-link ext-link-type="uri" xlink:href="http://mpiblast.lanl.gov/"/></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Apweiler</surname><given-names>A</given-names></name><etal></etal></person-group><article-title>UniProt: the Universal Protein Knowledgebase</article-title><source>Nucleic Acids Res</source><year>2004</year><volume>32</volume><fpage>D115</fpage><lpage>D119</lpage><pub-id pub-id-type="pmid">14681372</pub-id><pub-id pub-id-type="doi">10.1093/nar/gkh131</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><collab>The Gene Ontology Consortium</collab></person-group><article-title>Gene Ontology: tool for the unification of biology</article-title><source>Nat Genet</source><year>2000</year><volume>25</volume><fpage>25</fpage><lpage>29</lpage><pub-id pub-id-type="pmid">10802651</pub-id><pub-id pub-id-type="doi">10.1038/75556</pub-id></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><collab>The Gene Ontology Consortium</collab></person-group><article-title>The Gene Ontology (GO) database and informatics resource</article-title><source>Nucleic Acids Res</source><volume>32</volume><fpage>D258</fpage><lpage>D261</lpage><pub-id pub-id-type="pmid">14681407</pub-id><pub-id pub-id-type="doi">10.1093/nar/gkh036</pub-id></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kanehisa</surname><given-names>M</given-names></name><name><surname>Goto</surname><given-names>S</given-names></name><name><surname>Kawashima</surname><given-names>S</given-names></name><name><surname>Okuno</surname><given-names>Y</given-names></name><name><surname>Hattori</surname><given-names>M</given-names></name></person-group><article-title>The KEGG resources for deciphering the genome</article-title><source>Nucleic Acids Res</source><year>2004</year><volume>32</volume><fpage>D277</fpage><lpage>D280</lpage><pub-id pub-id-type="pmid">14681412</pub-id><pub-id pub-id-type="doi">10.1093/nar/gkh063</pub-id></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bairoch</surname><given-names>A</given-names></name></person-group><article-title>The ENZYME database in 2000</article-title><source>Nucleic Acids Res</source><volume>28</volume><fpage>304</fpage><lpage>305</lpage><pub-id pub-id-type="pmid">10592255</pub-id><pub-id pub-id-type="doi">10.1093/nar/28.1.304</pub-id></citation></ref><ref id="B33"><citation citation-type="other"><article-title>Globus toolkit</article-title><ext-link ext-link-type="uri" xlink:href="http://www-unix.globus.org/toolkit/"/></citation></ref><ref id="B34"><citation citation-type="other"><article-title>Sun Grid Engine</article-title><ext-link ext-link-type="uri" xlink:href="http://gridengine.sunsource.net/"/></citation></ref></ref-list><sec sec-type="display-objects"><title>Figures and Tables</title><fig position="float" id="F1"><label>Figure 1</label><caption><p><bold>Schematic view of ParPEST pipeline</bold>. EST sequences in GenBank or FASTA format can be submitted to the pipeline. ParPEST performs automatically the consecutive processes (ESTS cleaning, clustering, assembling and BLAST comparisons) as represented by blank arrows (&#x021d2;). Data flow is represented by simple arrows (&#x02192;). Databases supporting the analysis are included. The results are adequately reported and organized into a MySQL relational database indicated too. As reported, the database can be queried by SQL calls and is accessible to users by web based intuitive interfaces.</p></caption><graphic xlink:href="1471-2105-6-S4-S9-1"/></fig><fig position="float" id="F2"><label>Figure 2</label><caption><p><bold>Global execution time of PARPEST</bold>. Results are shown to compare execution time of the pipeline with different number of working nodes. Time is reported in hours.</p></caption><graphic xlink:href="1471-2105-6-S4-S9-2"/></fig><fig position="float" id="F3"><label>Figure 3</label><caption><p><bold>Average execution time per sequence</bold>. Data are reported to compare the average execution time per sequence in datasets of different dimension using a different number of working nodes. Time is reported in seconds.</p></caption><graphic xlink:href="1471-2105-6-S4-S9-3"/></fig><fig position="float" id="F4"><label>Figure 4</label><caption><p><bold>The Entity-Relationship (ER) diagram of the MySQL database</bold>. The ER diagram is reported to show the database structure schema. The schema describes the entities included in the database and their relationships.</p></caption><graphic xlink:href="1471-2105-6-S4-S9-4"/></fig><fig position="float" id="F5"><label>Figure 5</label><caption><p><bold>A screenshot of the EST Browser</bold>. ESTs can be retrieved by sequence features collected in the input step (a); by functional annotations (b); by specific properties reported by their processing.</p></caption><graphic xlink:href="1471-2105-6-S4-S9-5"/></fig><fig position="float" id="F6"><label>Figure 6</label><caption><p><bold>A screenshot of the CLUSTER Browser</bold>. Clusters can be retrieved using their identifier in the database and their structural features (a); functional annotation can be included in the query (b).</p></caption><graphic xlink:href="1471-2105-6-S4-S9-6"/></fig><fig position="float" id="F7"><label>Figure 7</label><caption><p><bold>A screenshot of the graphical organization of a cluster</bold>. Windows reporting the length of the assembled contig (line in orange), the alignment of the ESTs that build the contig (in green) and the regions of the contig involved in blast matches (in dark grey). In light grey trimmed regions are reported too.</p></caption><graphic xlink:href="1471-2105-6-S4-S9-7"/></fig><table-wrap position="float" id="T1"><label>Table 1</label><caption><p>Execution times for different node and data-set configurations. The execution times (in seconds) are collected for each step of the pipeline: 1) Blast on ESTs: functional annotation of raw EST sequences; 2) Pre-processing: vector contaminations cleaning and low complexity and interspersed repeat sequences masking; 3) Clustering; 4) Assembling; 5) Blast on Contigs: functional annotation of consensus sequences. Tot: is the global execution time of the pipeline.</p></caption><table frame="hsides" rules="groups"><thead><tr><td></td><td align="center"><bold>#sequences</bold></td><td align="center"><bold>Blast on ESTs</bold></td><td align="center"><bold>Pre-processing</bold></td><td align="center"><bold>Clustering</bold></td><td align="center"><bold>Assembling</bold></td><td align="center"><bold>Blast on Contigs</bold></td><td align="center"><bold>TOT</bold></td></tr></thead><tbody><tr><td align="center"><bold>4 nodes</bold></td><td align="center">250</td><td align="center">3712</td><td align="center">441</td><td align="center">15</td><td align="center">201</td><td align="center">501</td><td align="center">4870</td></tr><tr><td></td><td align="center">500</td><td align="center">7072</td><td align="center">613</td><td align="center">15</td><td align="center">201</td><td align="center">441</td><td align="center">8342</td></tr><tr><td></td><td align="center">1000</td><td align="center">13643</td><td align="center">857</td><td align="center">30</td><td align="center">202</td><td align="center">1474</td><td align="center">16206</td></tr><tr><td></td><td align="center">5000</td><td align="center">70490</td><td align="center">2979</td><td align="center">150</td><td align="center">257</td><td align="center">6806</td><td align="center">80682</td></tr><tr><td></td><td align="center">10000</td><td align="center">14559</td><td align="center">6029</td><td align="center">346</td><td align="center">328</td><td align="center">16045</td><td align="center">168287</td></tr><tr><td colspan="8"><hr></hr></td></tr><tr><td align="center"><bold>6 nodes</bold></td><td align="center">250</td><td align="center">1992</td><td align="center">441</td><td align="center">15</td><td align="center">201</td><td align="center">350</td><td align="center">2999</td></tr><tr><td></td><td align="center">500</td><td align="center">3648</td><td align="center">443</td><td align="center">15</td><td align="center">201</td><td align="center">421</td><td align="center">4728</td></tr><tr><td></td><td align="center">1000</td><td align="center">6911</td><td align="center">847</td><td align="center">30</td><td align="center">212</td><td align="center">903</td><td align="center">8903</td></tr><tr><td></td><td align="center">5000</td><td align="center">35647</td><td align="center">2834</td><td align="center">136</td><td align="center">268</td><td align="center">4137</td><td align="center">43022</td></tr><tr><td></td><td align="center">10000</td><td align="center">72525</td><td align="center">5483</td><td align="center">240</td><td align="center">357</td><td align="center">7845</td><td align="center">86450</td></tr><tr><td colspan="8"><hr></hr></td></tr><tr><td align="center"><bold>8 nodes</bold></td><td align="center">250</td><td align="center">1600</td><td align="center">441</td><td align="center">15</td><td align="center">201</td><td align="center">280</td><td align="center">2537</td></tr><tr><td></td><td align="center">500</td><td align="center">2517</td><td align="center">443</td><td align="center">15</td><td align="center">202</td><td align="center">461</td><td align="center">3910</td></tr><tr><td></td><td align="center">1000</td><td align="center">4704</td><td align="center">797</td><td align="center">30</td><td align="center">212</td><td align="center">733</td><td align="center">6476</td></tr><tr><td></td><td align="center">5000</td><td align="center">23819</td><td align="center">2784</td><td align="center">121</td><td align="center">267</td><td align="center">2853</td><td align="center">29844</td></tr><tr><td></td><td align="center">10000</td><td align="center">48700</td><td align="center">5377</td><td align="center">240</td><td align="center">357</td><td align="center">7845</td><td align="center">62519</td></tr></tbody></table></table-wrap></sec></back></article>