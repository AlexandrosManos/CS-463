>60</volume><fpage>83</fpage><lpage>90</lpage><pub-id pub-id-type="doi">10.1016/0304-3959(94)00094-U</pub-id><pub-id pub-id-type="pmid">7715945</pub-id></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="journal"><name><surname>Valentino</surname><given-names>K</given-names></name><name><surname>Newcomb</surname><given-names>R</given-names></name><name><surname>Gadbois</surname><given-names>T</given-names></name><name><surname>Singh</surname><given-names>T</given-names></name><name><surname>Bowersox</surname><given-names>S</given-names></name><name><surname>Bitner</surname><given-names>S</given-names></name><name><surname>Justice</surname><given-names>A</given-names></name><name><surname>Yamashiro</surname><given-names>D</given-names></name><name><surname>Hoffman</surname><given-names>BB</given-names></name><name><surname>Ciaranello</surname><given-names>R</given-names></name><name><surname>Miljanich</surname><given-names>G</given-names></name><name><surname>Ramachandran</surname><given-names>J</given-names></name><article-title>A selective N-type calcium channel antagonist protects against neuronal loss after global cerebral ischemia</article-title><source>Proc Natl Acad Sci</source><year>1993</year><volume>90</volume><fpage>7894</fpage><lpage>7</lpage><pub-id pub-id-type="doi">10.1073/pnas.90.16.7894</pub-id><pub-id pub-id-type="pmid">8102803</pub-id></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="journal"><name><surname>Miljanich</surname><given-names>GP</given-names></name><article-title>Venom peptides as human pharmaceuticals</article-title><source>Sci Med</source><year>1997</year><volume>4</volume><issue>5</issue><fpage>6</fpage><lpage>15</lpage></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="journal"><name><surname>Bowersox</surname><given-names>SS</given-names></name><name><surname>Tich</surname><given-names>N</given-names></name><name><surname>Mayo</surname><given-names>M</given-names></name><