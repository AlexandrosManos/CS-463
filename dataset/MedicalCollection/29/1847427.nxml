name><surname>Behl</surname><given-names>HM</given-names></name><article-title>Environment &#x00026; Biodiversity: Agenda for future</article-title><source>ICPEP-3</source><year>2005</year><ext-link ext-link-type="uri" xlink:href="http://www.geocities.com/isebindia/ICPEP-3/ICPEP3-S-2.html">http://www.geocities.com/isebindia/ICPEP-3/ICPEP3-S-2.html</ext-link></mixed-citation></ref><ref id="B10"><mixed-citation publication-type="book"><name><surname>Chivian</surname><given-names>E</given-names></name><source>Biodiversity: Its Importance to Human Health</source><year>2002</year><publisher-name>Center for Health and the Global Environment. Harvard Medical School</publisher-name></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><name><surname>Cowden</surname><given-names>CJ</given-names></name><name><surname>Paterson</surname><given-names>I</given-names></name><article-title>Cancer drugs better than taxol?</article-title><source>Nature</source><year>1997</year><volume>387</volume><fpage>238</fpage><lpage>239</lpage><pub-id pub-id-type="doi">10.1038/387238a0</pub-id><pub-id pub-id-type="pmid">9153384</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><name><surname>Nicolaou</surname><given-names>KC</given-names></name><name><surname>Guy</surname><given-names>RK</given-names></name><name><surname>Potier</surname><given-names>P</given-names></name><article-title>Taxoids: new weapons against cancer</article-title><source>Scientific American</source><year>1996</year><volume>274</volume><issue>6</issue><fpage>94</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">8643952</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>McGuire</surname><given-names>WP</given-names></name><name><surname>Rowinsky</surname><given-names>EK</given-names></name><name><surname>Rosenshein</surname><given-names>NB</given-names></name><name><surname>Grumbine</surname><given-names>FC</gi