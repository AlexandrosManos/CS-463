cle-title>Cross-cultural differences in GPs' attitudes towards complementary and alternative medicine: a survey comparing regions of the UK and Germany</article-title><source>Complement Ther Med</source><year>2002</year><volume>10</volume><fpage>141</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">12568142</pub-id><pub-id pub-id-type="doi">10.1016/S0965229902000560</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ernst</surname><given-names>E</given-names></name><name><surname>Resch</surname><given-names>KL</given-names></name><name><surname>White</surname><given-names>AR</given-names></name></person-group><article-title>Complementary medicine. What physicians think of it : a meta-analysis</article-title><source>Arch Intern Med</source><year>1995</year><volume>155</volume><fpage>2405</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">7503598</pub-id><pub-id pub-id-type="doi">10.1001/archinte.155.22.2405</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pirotta</surname><given-names>M</given-names></name><name><surname>Farish</surname><given-names>SJ</given-names></name><name><surname>Kotsirilos</surname><given-names>V</given-names></name><name><surname>Cohen</surname><given-names>MM</given-names></name></person-group><article-title>Characteristics of Victorian general practitioners who practice complementary therapies</article-title><source>Aust Fam Physician</source><year>2002</year><volume>31</volume><fpage>1133</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">12516519</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Astin</surname><given-names>JA</given-names></name><name><surname>Marie</surname><given-names>A</given-names></name><name><surname>Pelletier</surname><given-names>KR</given-names></name><name><surname>Hansen</surnam