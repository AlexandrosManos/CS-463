rnal"><person-group person-group-type="author"><name><surname>Cram</surname><given-names>P</given-names></name><name><surname>Rosenthal</surname><given-names>GE</given-names></name><name><surname>Ohsfeldt</surname><given-names>R</given-names></name><name><surname>Wallace</surname><given-names>RB</given-names></name><name><surname>Schlechte</surname><given-names>J</given-names></name><name><surname>Schiff</surname><given-names>GD</given-names></name></person-group><article-title>Failure to recognize and act on abnormal test results: the case of screening bone densitometry</article-title><source>Jt Comm J Qual Patient Saf</source><year>2005</year><volume>31</volume><fpage>90</fpage><lpage>97</lpage><pub-id pub-id-type="pmid">15791768</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Edelman</surname><given-names>D</given-names></name></person-group><article-title>Outpatient diagnostic errors: unrecognized hyperglycemia</article-title><source>Eff Clin Pract</source><year>2002</year><volume>5</volume><fpage>11</fpage><lpage>16</lpage><pub-id pub-id-type="pmid">11874191</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Poon</surname><given-names>EG</given-names></name><name><surname>Haas</surname><given-names>JS</given-names></name><name><surname>Louise</surname><given-names>PA</given-names></name><name><surname>Gandhi</surname><given-names>TK</given-names></name><name><surname>Burdick</surname><given-names>E</given-names></name><name><surname>Bates</surname><given-names>DW</given-names></name><name><surname>Brennan</surname><given-names>TA</given-names></name></person-group><article-title>Communication factors in the follow-up of abnormal mammograms</article-title><source>J Gen Intern Med</source><year>2004</year><volume>19</volume><fpage>316</fpage><lpage>323</lpage><pub-id pub-id-type="pmid">15061740</pub-id><pub