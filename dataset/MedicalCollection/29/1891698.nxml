ame>Yu</surname><given-names>AM</given-names></name><etal/></person-group><source>Drug Metab Rev</source><year>2004</year><volume>36</volume><fpage>243</fpage><pub-id pub-id-type="pmid">15237854</pub-id></citation></ref><ref id="R10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bairoch</surname><given-names>A</given-names></name><etal/></person-group><source>Brief Bioinform</source><year>2004</year><volume>5</volume><fpage>39</fpage><pub-id pub-id-type="pmid">15153305</pub-id></citation></ref><ref id="R11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Altschul</surname><given-names>SF</given-names></name><etal/></person-group><source>Nucleic Acids Res</source><year>1997</year><volume>25</volume><fpage>3389</fpage><pub-id pub-id-type="pmid">9254694</pub-id></citation></ref><ref id="R12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hewett</surname><given-names>M</given-names></name><etal/></person-group><source>Nucleic Acids Res</source><year>2002</year><volume>30</volume><fpage>163</fpage><pub-id pub-id-type="pmid">11752281</pub-id></citation></ref><ref id="R13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sun</surname><given-names>LZ</given-names></name><etal/></person-group><source>Bioinformatics</source><year>2002</year><volume>18</volume><fpage>1699</fpage><pub-id pub-id-type="pmid">12490461</pub-id></citation></ref><ref id="R14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ogata</surname><given-names>H</given-names></name><etal/></person-group><source>Nucleic Acids Res</source><year>1999</year><volume>27</volume><fpage>29</fpage><pub-id pub-id-type="pmid">9847135</pub-id></citation></ref></ref-list><sec sec-type="display-objects"><title>Figures and Tables</title><fig id="F1" position="float"><label>Figure 1</label><caption><p>Over all process of database</p></caption><graphic xlink:href="97320630001248F1"/></fig><fig id="F2" position="float"><label>Figure 2</label><caption><p><bold>(a)</bold> Home page of DrMetZ DB <bold>(b)</bold> Shows search criteria <bold>(c)</bold> Report of Drug <bold>(d)</bold> Reference display with         it's PubMed link <bold>(e)</bold> BLAST search result against Cytochrome P450 database</p></caption><graphic xlink:href="97320630001248F2"/></fig></sec><fn-group><fn id="FN1" fn-type="other"><p>      <bold>Citation:</bold>Remya &#x00026; Nagarajan, Bioinformation 1(7): 248-250 (2006)</p></fn></fn-group></back></article>