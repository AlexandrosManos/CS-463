>12030704</pub-id></citation></ref><ref id="pone.0000457-Feng1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Feng</surname><given-names>B</given-names></name><name><surname>Wang</surname><given-names>X</given-names></name><name><surname>Hauser</surname><given-names>M</given-names></name><name><surname>Kaufmann</surname><given-names>S</given-names></name><name><surname>Jentsch</surname><given-names>S</given-names></name><etal/></person-group><year>2001</year><article-title>Molecular cloning and characterization of WdPKS1, a gene involved in dihydroxynaphthalene melanin biosynthesis and virulence in <italic>Wangiella (Exophiala) dermatitidis</italic>.</article-title><source>Infect Immun</source><volume>69</volume><fpage>1781</fpage><lpage>1794</lpage><pub-id pub-id-type="pmid">11179356</pub-id></citation></ref><ref id="pone.0000457-Wang1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>Y</given-names></name><name><surname>Aisen</surname><given-names>P</given-names></name><name><surname>Casadevall</surname><given-names>A</given-names></name></person-group><year>1996</year><article-title>Melanin, melanin &#x0201c;ghosts,&#x0201d; and melanin composition in Cryptococcus neoformans. Infec.</article-title><source>Immun.</source><volume>64</volume><fpage>2420</fpage><lpage>2424</lpage></citation></ref><ref id="pone.0000457-Eisenman1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eisenman</surname><given-names>HC</given-names></name><name><surname>Nosanchuk</surname><given-names>JD</given-names></name><name><surname>Webber</surname><given-names>JB</given-names></name><name><surname>Emerson</surname><given-names>RJ</given-names></name><name><surname>Camesano</surname><given-names>TA</given-names></name><etal/></person-group><year>2005</year><article-title>Microstructure of cell wall-associated melanin in the human pathogenic fungus Cryptococcus neoformans.</article-title><source>Biochemistry</source><volume>44</volume><fpage>3683</fpage><lpage>3693</lpage><pub-id pub-id-type="pmid">15751945</pub-id></citation></ref><ref id="pone.0000457-Enochs1"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Enochs</surname><given-names>WS</given-names></name><name><surname>Nilges</surname><given-names>MJ</given-names></name><name><surname>Swartz</surname><given-names>HM</given-names></name></person-group><year>1993</year><article-title>A standardized test for the identification and characterization of melanins using electron paramagnetic resonance (EPR) spectroscopy.</article-title><source>Pigment Cell Res.</source><volume>6</volume><fpage>91</fpage><lpage>99</lpage><pub-id pub-id-type="pmid">8391699</pub-id></citation></ref><ref id="pone.0000457-Gan1"><label>27</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gan</surname><given-names>EV</given-names></name><name><surname>Haberman</surname><given-names>HF</given-names></name><name><surname>Menon</surname><given-names>IA</given-names></name></person-group><year>1976</year><article-title>Electron transfer properties of melanin.</article-title><source>Arch. Biochem. Biophys.</source><volume>173</volume><fpage>666</fpage><lpage>672</lpage><pub-id pub-id-type="pmid">5959</pub-id></citation></ref><ref id="pone.0000457-Kuhn1"><label>28</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kuhn</surname><given-names>DM</given-names></name><name><surname>Balkis</surname><given-names>M</given-names></name><name><surname>Chandra</surname><given-names>J</given-names></name><name><surname>Mukherjee</surname><given-names>PK</given-names></name><name><surname>Ghannoum</surname><given-names>MA</given-names></name></person-group><year>2003</year><article-title>Uses and limitations of the XTT assay in studies of Candida growth and metabolism.</article-title><source>J Clin Microbiol.</source><volume>41</volume><fpage>506</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">12517908</pub-id></citation></ref><ref id="pone.0000457-Berridge1"><label>29</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berridge</surname><given-names>MV</given-names></name><name><surname>Herst</surname><given-names>PM</given-names></name><name><surname>Tan</surname><given-names>AS</given-names></name></person-group><year>2005</year><article-title>Tetrazolium dyes as tools in cell biology: new insights into their cellular reduction.</article-title><source>Biotechnol Annu Rev.</source><volume>11</volume><fpage>127</fpage><lpage>52</lpage><pub-id pub-id-type="pmid">16216776</pub-id></citation></ref><ref id="pone.0000457-Hicks1"><label>30</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hicks</surname><given-names>JK</given-names></name><name><surname>D'Souza</surname><given-names>CA</given-names></name><name><surname>Cox</surname><given-names>GM</given-names></name><name><surname>Heitman</surname><given-names>J</given-names></name></person-group><year>2004</year><article-title>Cyclic AMP-dependent protein kinase catalytic subunits have divergent roles in virulence factor production in two varieties of the fungal pathogen Cryptococcus neoformans.</article-title><source>Eukaryot Cell</source><volume>3</volume><fpage>14</fpage><lpage>26</lpage><pub-id pub-id-type="pmid">14871933</pub-id></citation></ref><ref id="pone.0000457-Boomer1"><label>31</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boomer</surname><given-names>SM</given-names></name><name><surname>Pierson</surname><given-names>BK</given-names></name><name><surname>Austinhirst</surname><given-names>R</given-names></name><name><surname>Castenholz</surname><give