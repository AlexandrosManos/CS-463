 id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garnett</surname><given-names>GP</given-names></name><name><surname>Kim</surname><given-names>JJ</given-names></name><name><surname>French</surname><given-names>K</given-names></name><name><surname>Goldie</surname><given-names>SJ</given-names></name></person-group><article-title>Modelling the impact of HPV vaccines on cervical cancer and screening programmes</article-title><source>Vaccine</source><year>2006</year><volume>24</volume><fpage>S178</fpage><lpage>86</lpage><pub-id pub-id-type="pmid">16950005</pub-id><pub-id pub-id-type="doi">10.1016/j.vaccine.2006.05.116</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zimet</surname><given-names>GD</given-names></name><name><surname>Liddon</surname><given-names>N</given-names></name><name><surname>Rosenthal</surname><given-names>SL</given-names></name><name><surname>Lazcano-Ponce</surname><given-names>E</given-names></name><name><surname>Allen</surname><given-names>B</given-names></name></person-group><article-title>Psychosocial aspects of vaccine acceptability</article-title><source>Vaccine</source><year>2006</year><volume>24</volume><fpage>S201</fpage><lpage>209</lpage><pub-id pub-id-type="pmid">16950008</pub-id><pub-id pub-id-type="doi">10.1016/j.vaccine.2006.06.017</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brabin</surname><given-names>L</given-names></name><name><surname>Roberts</surname><given-names>SA</given-names></name><name><surname>Farzaneh</surname><given-names>F</given-names></name><name><surname>Kitchener</surname><given-names>HC</given-names></name></person-group><article-title>Future acceptance of adolescent human papillomavirus vaccination: a survey of parental attitudes</article-title><source>Vaccine</source><year>2006</year><volume>24</volume><