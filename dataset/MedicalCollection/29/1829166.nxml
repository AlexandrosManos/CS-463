="right">100.0</td><td align="right">100.0</td><td align="right">100.0</td></tr><tr><td align="center">15</td><td align="right">100</td><td align="center">1.0</td><td align="right">4.7</td><td align="right">3.1</td><td align="right">3.2</td><td align="right">3.1</td><td align="right">22.3</td><td align="right">23.2</td><td align="right">23.6</td><td align="right">24.2</td></tr><tr><td></td><td></td><td align="center">1.2</td><td align="right">4.6</td><td align="right">3.1</td><td align="right">3.3</td><td align="right">3.3</td><td align="right">50.0</td><td align="right">51.2</td><td align="right">51.8</td><td align="right">52.4</td></tr><tr><td></td><td></td><td align="center">1.4</td><td align="right">4.6</td><td align="right">3.3</td><td align="right">3.5</td><td align="right">3.6</td><td align="right">74.2</td><td align="right">75.7</td><td align="right">76.2</td><td align="right">76.7</td></tr><tr><td></td><td></td><td align="center">1.6</td><td align="right">4.5</td><td align="right">3.4</td><td align="right">3.7</td><td align="right">3.8</td><td align="right">89.0</td><td align="right">90.3</td><td align="right">90.7</td><td align="right">90.9</td></tr><tr><td></td><td></td><td align="center">1.8</td><td align="right">4.5</td><td align="right">3.9</td><td align="right">4.1</td><td align="right">4.3</td><td align="right">96.0</td><td align="right">97.1</td><td align="right">97.2</td><td align="right">97.3</td></tr><tr><td></td><td></td><td align="center">2.0</td><td align="right">4.5</td><td align="right">4.5</td><td align="right">4.6</td><td align="right">4.9</td><td align="right">98.8</td><td align="right">99.3</td><td align="right">99.4</td><td align="right">99.4</td></tr><tr><td></td><td></td><td align="center">2.5</td><td align="right">4.6</td><td align="right">5.0</td><td align="right">5.1</td><td align="right">5.2</td><td align="right">100.0</td><td align="right">100.0</td><td align="right">100.0</td><td align="right">100.0</td></tr><tr><td></td><td></td><td align="center">3.0</td><td align="right">4.5</td><td align="right">5.1</td><td align="right">5.0</td><td align="right">5.2</td><td align="right">100.0</td><td align="right">100.0</td><td align="right">100.0</td><td align="right">100.0</td></tr></tbody></table><table-wrap-foot><p>The average FDR and power estimates from 500 simulations at the FDR level of 5%. The same number of genes is selected using the Benjamini and Hochberg procedure from the p-value ranking at FDR = 5%. All values are in percentages.</p></table-wrap-foot></table-wrap><table-wrap position="float" id="T5"><label>Table 5</label><caption><p>Simulation Results for the Correlated Models with <italic>&#x003c1; </italic>= 0.3</p></caption><table frame="hsides" rules="groups"><thead><tr><td></td><td></td><td></td><td align="center" colspan="4">FDR</td><td align="center" colspan="4">Power</td></tr><tr><td></td><td></td><td></td><td colspan="4"><hr></hr></td><td colspan="4"><hr></hr></td></tr><tr><td align="center"><italic>n</italic></td><td align="right"><italic>m</italic><sub>1</sub></td><td align="center"><italic>&#x003b4;</italic></td><td align="right">P-val</td><td align="right">P-adm</td><td align="right">Convex</td><td align="right">Pareto</td><td align="right">P-val</td><td align="right">P-adm</td><td align="right">Convex</td><td align="right">Pareto</td></tr></thead><tbody><tr><td align="center">10</td><td align="right">50</td><td align="center">1.0</td><td align="right">4.9</td><td align="right">3.2</td><td align="right">3.1</td><td align="right">3.0</td><td align="right">2.2</td><td align="right">3.0</td><td align="right">2.9</td><td align="right">3.0</td></tr><tr><td></td><td></td><td align="center">1.2</td><td align="right">5.3</td><td align="right">3.4</td><td align="right">3.1</td><td align="right">3.1</td><td align="right">7.7</td><td align="right">9.0</td><td align="right">9.1</td><td align="right">9.5</td></tr><tr><td></td><td></td><td align="center">1.4</td><td align="right">4.8</t