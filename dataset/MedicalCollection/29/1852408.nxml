-type="pmid">15691715</pub-id><pub-id pub-id-type="doi">10.1016/j.mcn.2004.10.002</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Diagana</surname><given-names>TT</given-names></name><name><surname>Thomas</surname><given-names>U</given-names></name><name><surname>Prokopenko</surname><given-names>SN</given-names></name><name><surname>Xiao</surname><given-names>B</given-names></name><name><surname>Worley</surname><given-names>PF</given-names></name><name><surname>Thomas</surname><given-names>JB</given-names></name></person-group><article-title>Mutation of <italic>Drosophila </italic>homer disrupts control of locomotor activity and behavioral plasticity.</article-title><source>J Neurosci</source><year>2002</year><volume>22</volume><fpage>428</fpage><lpage>436</lpage><pub-id pub-id-type="pmid">11784787</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Foa</surname><given-names>L</given-names></name><name><surname>Rajan</surname><given-names>I</given-names></name><name><surname>Haas</surname><given-names>K</given-names></name><name><surname>Wu</surname><given-names>GY</given-names></name><name><surname>Brakeman</surname><given-names>P</given-names></name><name><surname>Worley</surname><given-names>P</given-names></name><name><surname>Cline</surname><given-names>H</given-names></name></person-group><article-title>The scaffold protein, Homer1b/c, regulates axon pathfinding in the central nervous system <italic>in vivo</italic>.</article-title><source>Nat Neurosci</source><year>2001</year><volume>4</volume><fpage>499</fpage><lpage>506</lpage><pub-id pub-id-type="pmid">11319558</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Foa</surname><given-names>L</given-names></name><name><surname>Jensen</surname><given-names>K</given-names></name><