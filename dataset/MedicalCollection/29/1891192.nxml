-group><name><surname>Rosenberg</surname><given-names>SA</given-names></name><name><surname>Lotze</surname><given-names>MT</given-names></name><name><surname>Yang</surname><given-names>JC</given-names></name><name><surname>Aebersold</surname><given-names>PM</given-names></name><etal/></person-group><article-title>Experience with the use of high-dose interleukin-2 in the treatment of 652 cancer patients</article-title><source>Ann Surg</source><year>1989</year><volume>210</volume><fpage>474</fpage><lpage>84</lpage><pub-id pub-id-type="pmid">2679456</pub-id></citation></ref><ref id="b21-co14_1p021"><label>21</label><citation citation-type="journal"><person-group><name><surname>Thatcher</surname><given-names>N</given-names></name><name><surname>Dazzi</surname><given-names>H</given-names></name><name><surname>Johnson</surname><given-names>RJ</given-names></name><etal/></person-group><article-title>Recombinant interleukin-2 (ril-2) given intrasplenically and intravenously for advanced malignant melanoma. A phase i and ii study</article-title><source>Br J Cancer</source><year>1989</year><volume>60</volume><fpage>770</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">2803954</pub-id></citation></ref><ref id="b22-co14_1p021"><label>22</label><citation citation-type="journal"><person-group><name><surname>Legha</surname><given-names>SS</given-names></name><name><surname>Gianan</surname><given-names>MA</given-names></name><name><surname>Plager</surname><given-names>C</given-names></name><name><surname>Eton</surname><given-names>OE</given-names></name><name><surname>Papadopoulous</surname><given-names>NE</given-names></name></person-group><article-title>Evaluation of interleukin-2 administered by continuous infusion in patients with metastatic melanoma</article-title><source>Cancer</source><year>1996</year><volume>77</volume><fpage>89</fpage><lpage>96</lpage><pub-id pub-id-type="pmid">8630945</pub-id></citation></ref><ref id="b23-co14_1p021"><label>23</label><citation citation-ty