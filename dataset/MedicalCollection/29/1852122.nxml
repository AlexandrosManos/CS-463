b028"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>O'Neal</surname><given-names>CM</given-names></name><name><surname>Crawford</surname><given-names>SE</given-names></name><name><surname>Estes</surname><given-names>MK</given-names></name><name><surname>Conner</surname><given-names>ME</given-names></name></person-group><year>1997</year><article-title>Rotavirus VLPs administered mucosally induce protective immunity</article-title><source>J Virol</source><volume>71</volume><fpage>8707</fpage><lpage>8717</lpage><pub-id pub-id-type="pmid">9343229</pub-id></citation></ref><ref id="pmed-0040121-b029"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Velazquez</surname><given-names>FR</given-names></name><name><surname>Matson</surname><given-names>DO</given-names></name><name><surname>Calva</surname><given-names>JJ</given-names></name><name><surname>Guerrero</surname><given-names>L</given-names></name><name><surname>Morrow</surname><given-names>AL</given-names></name><etal/></person-group><year>1996</year><article-title>Rotavirus infections in infants as protection against subsequent infections</article-title><source>N Engl J Med</source><volume>335</volume><fpage>1022</fpage><lpage>1028</lpage><pub-id pub-id-type="pmid">8793926</pub-id></citation></ref><ref id="pmed-0040121-b030"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Velazquez</surname><given-names>FR</given-names></name><name><surname>Matson</surname><given-names>DO</given-names></name><name><surname>Guerrero</surname><given-names>ML</given-names></name><name><surname>Shults</surname><given-names>J</given-names></name><name><surname>Calva</surname><given-names>JJ</given-names></name><etal/></person-group><year>2000</year><article-title>Serum antibody as a marker of protection against natural rotavirus infection and disease</article-title><source>J Infect Dis</source><volume>182</volume><