 commands.</article-title><source>Nature</source><volume>404</volume><fpage>390</fpage><lpage>394</lpage><pub-id pub-id-type="pmid">10746726</pub-id></citation></ref><ref id="pone.0000299-Moore1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moore</surname><given-names>T</given-names></name><name><surname>Armstrong</surname><given-names>KM</given-names></name></person-group><year>2003</year><article-title>Selective gating of visual signals by microstimulation of frontal cortex.</article-title><source>Nature</source><volume>421</volume><fpage>370</fpage><lpage>373</lpage><pub-id pub-id-type="pmid">12540901</pub-id></citation></ref><ref id="pone.0000299-Mayberg1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mayberg</surname><given-names>HS</given-names></name><name><surname>Lozano</surname><given-names>AM</given-names></name><name><surname>Voon</surname><given-names>V</given-names></name><name><surname>McNeely</surname><given-names>HE</given-names></name><name><surname>Seminowicz</surname><given-names>D</given-names></name><etal/></person-group><year>2005</year><article-title>Deep brain stimulation for treatment-resistant depression.</article-title><source>Neuron</source><volume>45</volume><fpage>651</fpage><lpage>660</lpage><pub-id pub-id-type="pmid">15748841</pub-id></citation></ref><ref id="pone.0000299-Kumar1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kumar</surname><given-names>R</given-names></name><name><surname>Lozano</surname><given-names>AM</given-names></name><name><surname>Kim</surname><given-names>YJ</given-names></name><name><surname>Hutchison</surname><given-names>WD</given-names></name><name><surname>Sime</surname><given-names>E</given-names></name><etal/></person-group><year>1998</year><article-title>Double-blind evaluation of subthalamic nucleus deep brain stimulati