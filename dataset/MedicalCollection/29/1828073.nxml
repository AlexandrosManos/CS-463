><source>J Control Release</source><volume>70</volume><fpage>399</fpage><lpage>421</lpage><pub-id pub-id-type="pmid">11182210</pub-id></citation></ref><ref id="b32-ijn-1-507"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Masamune</surname><given-names>K</given-names></name><name><surname>Kunitomo</surname><given-names>K</given-names></name><name><surname>Sasaki</surname><given-names>K</given-names></name><etal/></person-group><year>1997</year><article-title>Bile-induced DNA strand breaks and biochemical analysis of bile acids in an experimental model of anomalous arrangement of the pancreaticobiliary ducts</article-title><source>J Med Invest</source><volume>44</volume><fpage>47</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">9395717</pub-id></citation></ref><ref id="b33-ijn-1-507"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Murakami</surname><given-names>T</given-names></name><name><surname>Sato</surname><given-names>H</given-names></name><name><surname>Nakatani</surname><given-names>S</given-names></name><etal/></person-group><year>2001</year><article-title>Biliary tract of the rat as observed by scanning electron microscopy of cast samples</article-title><source>Arch Histol Cytol</source><volume>64</volume><fpage>439</fpage><lpage>47</lpage><pub-id pub-id-type="pmid">11757912</pub-id></citation></ref><ref id="b34-ijn-1-507"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nathwani</surname><given-names>AC</given-names></name><name><surname>Davidoff</surname><given-names>AM</given-names></name><name><surname>Hanawa</surname><given-names>H</given-names></name><etal/></person-group><year>2002</year><article-title>Sustained high-level expression of human factor IX (hFIX) after liver-targeted delivery of recombinant adeno-associated virus encoding the hFIX gene in rhesus macaques</article-title><source>Blood</source><volume>100</volume><