ml:msub></mml:mrow></mml:mfrac><mml:mo>&#x022c5;</mml:mo><mml:mfrac><mml:mrow><mml:msub><mml:mi>C</mml:mi><mml:mrow><mml:mtext>NADH</mml:mtext></mml:mrow></mml:msub></mml:mrow><mml:mrow><mml:msub><mml:mi>K</mml:mi><mml:mrow><mml:mtext>NADH</mml:mtext></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:mo>+</mml:mo><mml:mfrac><mml:mrow><mml:msub><mml:mi>C</mml:mi><mml:mrow><mml:msup><mml:mrow><mml:mtext>NAD</mml:mtext></mml:mrow><mml:mtext>+</mml:mtext></mml:msup></mml:mrow></mml:msub></mml:mrow><mml:mrow><mml:msub><mml:mi>K</mml:mi><mml:mrow><mml:msup><mml:mrow><mml:mtext>NAD</mml:mtext></mml:mrow><mml:mtext>+</mml:mtext></mml:msup></mml:mrow></mml:msub></mml:mrow></mml:mfrac></mml:mrow></mml:mfrac></mml:mrow><mml:mo>)</mml:mo></mml:mrow></mml:mrow><mml:annotation encoding="MathType-MTEF"> MathType@MTEF@5@5@@C4D9@</mml:annotation></mml:semantics></mml:math></inline-formula></td></tr><tr><td align="left" colspan="2">This is a sum of several enzymatic reactions at complex I &#x02013; V that constitute the electron transport chain and oxidative phosphorylation in the mitochondrial matrix. FAD and FADH<sub>2 </sub>are considered equivalent to 2/3 NAD<sup>+ </sup>and 2/3 NADH. Unlike other reactions, here NADH and NAD<sup>+ </sup>are treated as substrates rather than controllers. Furthermore, 1 NADH is assumed to produce 3 ATP (i.e., P/O ratio = 3 for substrate NADH). To account for the proton leak, the stoichiometries for NADH and NAD<sup>+ </sup>are adjusted to 1.88 and that for ATP, ADP and Pi are accordingly adjusted to 3*1.88 = 5.64.</td></tr><tr><td align="left">22. Phosphocreatine Breakdown</td><td align="center">PCR + ADP &#x02192; CR + ATP</td></tr><tr><td align="center" colspan="2"><inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M103" name="1475-925X-6-14-i83" overflow="scroll"><mml:semantics definitionURL="" encoding=""><mml:mrow><mml:msub><mml:mi>&#x003c6;</mml:mi><mml:mrow><mml:mtext>PCR</mml:mtext><mml:mo>&#x02192;</mml:mo><mml:mt