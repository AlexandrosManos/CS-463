ml:mo>)</mml:mo></mml:mrow></mml:mrow><mml:annotation encoding="MathType-MTEF"> MathType@MTEF@5@5@@8237@</mml:annotation></mml:semantics></mml:math></inline-formula></td></tr><tr><td align="left" colspan="2">This is lumping of 4 reactions G6P &#x02194; F6P, F6P + ATP &#x02192; F16BP + ADP, F16BP &#x02194; DHAP + GA3P, and DHAP &#x02194; GA3P. The activity of the enzyme <italic>phosphofructo kinase </italic>in this reaction is assumed to be regulated by the energy metabolite concentration ratio C<sub>AMP</sub>/C<sub>ATP</sub>.</td></tr><tr><td align="left">5. Glyceraldehyde 3-Phosphate Breakdown</td><td align="center">GA3P + Pi + NAD<sup>+ </sup>&#x02192; BPG + NADH</td></tr><tr><td align="center" colspan="2"><inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M86" name="1475-925X-6-14-i66" overflow="scroll"><mml:semantics definitionURL="" encoding=""><mml:mrow><mml:msub><mml:mi>&#x003c6;</mml:mi><mml:mrow><mml:mtext>GA3P</mml:mtext><mml:mo>&#x02192;</mml:mo><mml:mtext>BPG</mml:mtext></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:msub><mml:mi>V</mml:mi><mml:mrow><mml:mtext>GA3P</mml:mtext><mml:mo>&#x02192;</mml:mo><mml:mtext>BPG</mml:mtext></mml:mrow></mml:msub><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mfrac><mml:mrow><mml:mfrac><mml:mrow><mml:msub><mml:mi>C</mml:mi><mml:mrow><mml:msup><mml:mrow><mml:mtext>NAD</mml:mtext></mml:mrow><mml:mo>+</mml:mo></mml:msup></mml:mrow></mml:msub></mml:mrow><mml:mrow><mml:msub><mml:mi>C</mml:mi><mml:mrow><mml:mtext>NADH</mml:mtext></mml:mrow></mml:msub></mml:mrow></mml:mfrac></mml:mrow><mml:mrow><mml:msub><mml:mi>K</mml:mi><mml:mrow><mml:mfrac><mml:mrow><mml:msup><mml:mrow><mml:mtext>NAD</mml:mtext></mml:mrow><mml:mtext>+</mml:mtext></mml:msup></mml:mrow><mml:mrow><mml:mtext>NADH</mml:mtext></mml:mrow></mml:mfrac></mml:mrow></mml:msub><mml:mo>+</mml:mo><mml:mfrac><mml:mrow><mml:msub><mml:mi>C</mml:mi><mml:mrow><mml:msup><mml:mrow><mml:mtext>NAD</mml:mtext></mml:mrow><mml:mo>+</mml:mo></mml:msup></mml:mrow></