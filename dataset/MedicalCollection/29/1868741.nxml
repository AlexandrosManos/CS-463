l:annotation></mml:semantics></mml:math></inline-formula></td></tr><tr><td align="left">23. Phosphocreatine Synthesis</td><td align="center">CR + ATP &#x02192; PCR + ADP</td></tr><tr><td align="center" colspan="2"><inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M104" name="1475-925X-6-14-i84" overflow="scroll"><mml:semantics definitionURL="" encoding=""><mml:mrow><mml:msub><mml:mi>&#x003c6;</mml:mi><mml:mrow><mml:mtext>CR</mml:mtext><mml:mo>&#x02192;</mml:mo><mml:mi>P</mml:mi><mml:mtext>CR</mml:mtext></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:msub><mml:mi>V</mml:mi><mml:mrow><mml:mtext>CR</mml:mtext><mml:mo>&#x02192;</mml:mo><mml:mi>P</mml:mi><mml:mtext>CR</mml:mtext></mml:mrow></mml:msub><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mfrac><mml:mrow><mml:mfrac><mml:mrow><mml:msub><mml:mi>C</mml:mi><mml:mrow><mml:mtext>ATP</mml:mtext></mml:mrow></mml:msub></mml:mrow><mml:mrow><mml:msub><mml:mi>C</mml:mi><mml:mrow><mml:mtext>ADP</mml:mtext></mml:mrow></mml:msub></mml:mrow></mml:mfrac></mml:mrow><mml:mrow><mml:msub><mml:mi>K</mml:mi><mml:mrow><mml:mfrac><mml:mrow><mml:mtext>ATP</mml:mtext></mml:mrow><mml:mrow><mml:mtext>ADP</mml:mtext></mml:mrow></mml:mfrac></mml:mrow></mml:msub><mml:mo>+</mml:mo><mml:mfrac><mml:mrow><mml:msub><mml:mi>C</mml:mi><mml:mrow><mml:mtext>ATP</mml:mtext></mml:mrow></mml:msub></mml:mrow><mml:mrow><mml:msub><mml:mi>C</mml:mi><mml:mrow><mml:mtext>ADP</mml:mtext></mml:mrow></mml:msub></mml:mrow></mml:mfrac></mml:mrow></mml:mfrac></mml:mrow><mml:mo>)</mml:mo></mml:mrow><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mfrac><mml:mrow><mml:mfrac><mml:mrow><mml:msub><mml:mi>C</mml:mi><mml:mrow><mml:mtext>CR</mml:mtext></mml:mrow></mml:msub></mml:mrow><mml:mrow><mml:msub><mml:mi>K</mml:mi><mml:mrow><mml:mtext>CR</mml:mtext></mml:mrow></mml:msub></mml:mrow></mml:mfrac></mml:mrow><mml:mrow><mml:mtext>1</mml:mtext><mml:mo>+</mml:mo><mml:mfrac><mml:mrow><mml:msub><mml:mi>C</mml:mi><mml:mrow><mml:mtext>CR</mml:mtext></mml:mrow></mml:m