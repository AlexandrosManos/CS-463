/td><td align="left" rowspan="1" colspan="1">0.74 (0.17&#x02013;3.10)</td></tr><tr><td colspan="3" align="left" rowspan="1">Ever received treatment for trypanosomiasis</td></tr><tr><td align="left" rowspan="1" colspan="1">No</td><td align="left" rowspan="1" colspan="1">70/1503 (4.7)</td><td align="left" rowspan="1" colspan="1">1.00</td></tr><tr><td align="left" rowspan="1" colspan="1">Yes</td><td align="left" rowspan="1" colspan="1">4/105 (3.8)</td><td align="left" rowspan="1" colspan="1">0.81 (0.29&#x02013;2.27)</td></tr><tr><td colspan="3" align="left" rowspan="1">Ever received injections for treatment of tuberculosis</td></tr><tr><td align="left" rowspan="1" colspan="1">No</td><td align="left" rowspan="1" colspan="1">70/1544 (4.5)</td><td align="left" rowspan="1" colspan="1">1.00</td></tr><tr><td align="left" rowspan="1" colspan="1">Yes</td><td align="left" rowspan="1" colspan="1">4/63 (6.4)</td><td align="left" rowspan="1" colspan="1">1.43 (0.50&#x02013;4.04)</td></tr><tr><td colspan="3" align="left" rowspan="1">Ever received blood transfusions</td></tr><tr><td align="left" rowspan="1" colspan="1">No</td><td align="left" rowspan="1" colspan="1">65/1419 (4.6)</td><td align="left" rowspan="1" colspan="1">1.00</td></tr><tr><td align="left" rowspan="1" colspan="1">Yes</td><td align="left" rowspan="1" colspan="1">9/187 (4.8)</td><td align="left" rowspan="1" colspan="1">1.05 (0.52&#x02013;2.15)</td></tr><tr><td colspan="3" align="left" rowspan="1">Ever had traditional scarifications</td></tr><tr><td align="left" rowspan="1" colspan="1">No</td><td align="left" rowspan="1" colspan="1">47/1111 (4.2)</td><td align="left" rowspan="1" colspan="1">1.00</td></tr><tr><td align="left" rowspan="1" colspan="1">Yes</td><td align="left" rowspan="1" colspan="1">27/497 (5.4)</td><td align="left" rowspan="1" colspan="1">1.30 (0.80&#x02013;2.11)</td></tr><tr><td colspan="3" align="left" rowspan="1">Vaccination scar</td></tr><tr><td align="left" rowspan="1" colspan="1">No</td><td align=