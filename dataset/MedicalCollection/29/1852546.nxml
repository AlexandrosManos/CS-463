roup><article-title>Hox cluster duplications and the opportunity for evolutionary novelties</article-title><source>Proc Natl Acad Sci USA</source><year>2003</year><volume>100</volume><fpage>14603</fpage><lpage>14606</lpage><pub-id pub-id-type="pmid">14638945</pub-id><pub-id pub-id-type="doi">10.1073/pnas.2536656100</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simons</surname><given-names>C</given-names></name><name><surname>Pheasant</surname><given-names>M</given-names></name><name><surname>Makunin</surname><given-names>IV</given-names></name><name><surname>Mattick</surname><given-names>JS</given-names></name></person-group><article-title>Transposon-free regions in mammalian genomes</article-title><source>Genome Res</source><year>2006</year><volume>16</volume><fpage>164</fpage><lpage>172</lpage><pub-id pub-id-type="pmid">16365385</pub-id><pub-id pub-id-type="doi">10.1101/gr.4624306</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grover</surname><given-names>D</given-names></name><name><surname>Majumder</surname><given-names>PP</given-names></name><name><surname>Rao</surname><given-names>CB</given-names></name><name><surname>Brahmachari</surname><given-names>SK</given-names></name><name><surname>Mukerji</surname><given-names>M</given-names></name></person-group><article-title>Nonrandom distribution of Alu elements in genes of various functional categories: insight from analysis of human chromosomes 21 and 22</article-title><source>Mol Biol Evol</source><year>2003</year><volume>20</volume><fpage>1420</fpage><lpage>1424</lpage><pub-id pub-id-type="pmid">12832639</pub-id><pub-id pub-id-type="doi">10.1093/molbev/msg153</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van de Lagemaat</surname><given-names>LN</given-names></name><na