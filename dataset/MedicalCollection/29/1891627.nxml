lume>17</volume><fpage>31</fpage><pub-id pub-id-type="pmid">10078605</pub-id></citation></ref><ref id="R10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kelly</surname><given-names>K</given-names></name></person-group><source>J Chem Comp Group</source><year>1999</year></citation></ref><ref id="R11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vriend</surname><given-names>G</given-names></name></person-group><source>J Mol Graph</source><year>1990</year><volume>8</volume><fpage>52</fpage><pub-id pub-id-type="pmid">2268628</pub-id></citation></ref><ref id="R12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Luthy</surname><given-names>R</given-names></name><etal/></person-group><source>Nature</source><year>1992</year><volume>356</volume><fpage>83</fpage><pub-id pub-id-type="pmid">1538787</pub-id></citation></ref><ref id="R13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kabsch</surname><given-names>W</given-names></name></person-group><source>Acta cryst</source><year>1978</year><volume>A34</volume><fpage>827</fpage></citation></ref><ref id="R14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dirr</surname><given-names>H</given-names></name><etal/></person-group><source>J Mol Biol</source><year>1994</year><volume>243</volume><fpage>72</fpage><pub-id pub-id-type="pmid">7932743</pub-id></citation></ref><ref id="R15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oakley</surname><given-names>J</given-names></name><etal/></person-group><source>Biochemistry</source><year>1998</year><volume>37</volume><fpage>9912</fpage><pub-id pub-id-type="pmid">9665696</pub-id></citation></ref><ref id="R16"><label>16</label><citati