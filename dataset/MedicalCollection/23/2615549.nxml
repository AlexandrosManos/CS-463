olspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top">1.10 (1.01 to 1.19)</td></tr><tr><td colspan="8" rowspan="1" align="left" valign="top">Admission type:</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;Elective</td><td colspan="1" rowspan="1" align="center" valign="top">6469</td><td colspan="1" rowspan="1" align="center" valign="top">1405</td><td colspan="1" rowspan="1" align="center" valign="top">1.00&#x02021;</td><td colspan="1" rowspan="2" align="center" valign="middle">0.75</td><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top">1.00&#x02021;</td><td colspan="1" rowspan="2" align="center" valign="middle">0.13</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;Emergency</td><td colspan="1" rowspan="1" align="center" valign="top">17 007</td><td colspan="1" rowspan="1" align="center" valign="top">3648</td><td colspan="1" rowspan="1" align="center" valign="top">1.01 (0.95 to 1.07)</td><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top">1.05 (0.99 to 1.12)</td></tr><tr><td colspan="8" rowspan="1" align="left" valign="top">Type of hospital attended:</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;Public</td><td colspan="1" rowspan="1" align="center" valign="top">19 542</td><td colspan="1" rowspan="1" align="center" valign="top">4063</td><td colspan="1" rowspan="1" align="center" valign="top">1.00&#x02021;</td><td colspan="1" rowspan="3" align="center" valign="middle">&#x0003c;0.001</td><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top">1.00</td><td colspan="1" rowspan="3" align="center" valign="middle">&#x0003c;0.001</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;Private</td><td colspan="1" rowspan="1" align="center" valign