><name><surname>van Dalen</surname><given-names>PJ</given-names></name><name><surname>Pavicic</surname><given-names>MJ</given-names></name><name><surname>de Graaff</surname><given-names>J</given-names></name></person-group><article-title>Enumeration of mutans streptococci in clinical samples by using monoclonal antibodies</article-title><source>J Clin Microbiol</source><year>1990</year><volume>28</volume><fpage>2467</fpage><lpage>2472</lpage><pub-id pub-id-type="pmid">2254421</pub-id></citation></ref><ref id="b16-0010031"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kneist</surname><given-names>S</given-names></name><name><surname>Heinrich</surname><given-names>WR</given-names></name><name><surname>Laurish</surname><given-names>L</given-names></name></person-group><article-title>Evaluation of a new caries risk test</article-title><source>Independent Dentistry</source><year>1999</year><fpage>76</fpage><lpage>84</lpage></citation></ref><ref id="b17-0010031"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>YH</given-names></name><name><surname>Lau</surname><given-names>PC</given-names></name><name><surname>Lee</surname><given-names>JH</given-names></name><name><surname>Ellen</surname><given-names>RP</given-names></name><name><surname>Cvitkovitch</surname><given-names>DG</given-names></name></person-group><article-title>Natural genetic transformation of Streptococcus mutans growing in biofilms</article-title><source>J Bacteriol</source><year>2001</year><volume>183</volume><fpage>897</fpage><lpage>908</lpage><pub-id pub-id-type="pmid">11208787</pub-id></citation></ref><ref id="b18-0010031"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lorenz</surname><given-names>MG</given-names></name><name><surname>Wackernagel</surname><given-names>W</given-names></name></person-grou