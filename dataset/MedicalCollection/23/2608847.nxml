ype="journal"><person-group person-group-type="author"><name><surname>Alabadi</surname><given-names>D.</given-names></name><name><surname>Oyama</surname><given-names>T.</given-names></name><name><surname>Yanovsky</surname><given-names>M. J.</given-names></name><name><surname>Harmon</surname><given-names>F. G.</given-names></name><name><surname>Mas</surname><given-names>P.</given-names></name><name><surname>Kay</surname><given-names>S. A.</given-names></name></person-group><article-title>Reciprocal regulation between TOC1 and LHY/CCA1 within the Arabidopsis circadian clock</article-title><source>Science</source><year>2001</year><volume>293</volume><fpage>880</fpage><lpage>883</lpage><pub-id pub-id-type="pmid">11486091</pub-id></citation></ref><ref id="DSN025C16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gigolashvili</surname><given-names>T.</given-names></name><name><surname>Yatusevich</surname><given-names>R.</given-names></name><name><surname>Berger</surname><given-names>B.</given-names></name><name><surname>Muller</surname><given-names>C.</given-names></name><name><surname>Flugge</surname><given-names>U. I.</given-names></name></person-group><article-title>The R2R3-MYB transcription factor HAG1/MYB28 is a regulator of methionine-derived glucosinolate biosynthesis in <italic>Arabidopsis thaliana</italic></article-title><source>Plant J.</source><year>2007</year><volume>51</volume><fpage>247</fpage><lpage>261</lpage><pub-id pub-id-type="pmid">17521412</pub-id></citation></ref><ref id="DSN025C17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ihmels</surname><given-names>J.</given-names></name><name><surname>Levy</surname><given-names>R.</given-names></name><name><surname>Barkai</surname><given-names>N.</given-names></name></person-group><article-title>Principles of transcriptional control in the metabolic network of <italic>Saccharomyces cerevi