cation-type="journal"><person-group person-group-type="author"><name><surname>Fujiwara</surname><given-names>S</given-names></name><name><surname>Nakagawa</surname><given-names>K</given-names></name><name><surname>Harada</surname><given-names>H</given-names></name><name><surname>Nagato</surname><given-names>S</given-names></name><name><surname>Furukawa</surname><given-names>K</given-names></name><name><surname>Teraoka</surname><given-names>M</given-names></name><etal/></person-group><article-title>Silencing hypoxia-inducible factor-1alpha inhibits cell migration and invasion under hypoxic environment in malignant gliomas</article-title><source>Int J Oncol</source><year>2007</year><volume>30</volume><fpage>793</fpage><lpage>802</lpage><pub-id pub-id-type="pmid">17332917</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cantley</surname><given-names>LC</given-names></name></person-group><article-title>The phosphoinositide 3-kinase pathway</article-title><source>Science</source><year>2002</year><volume>296</volume><fpage>1655</fpage><lpage>1657</lpage><pub-id pub-id-type="pmid">12040186</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Debatin</surname><given-names>KM</given-names></name></person-group><article-title>Apoptosis pathways in cancer and cancer therapy</article-title><source>Cancer Immunol Immunother</source><year>2004</year><volume>53</volume><fpage>153</fpage><lpage>159</lpage><pub-id pub-id-type="pmid">14749900</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Karagiannis</surname><given-names>TC</given-names></name><name><surname>El-Osta</surname><given-names>A</given-names></name></person-group><article-title>siRNAs: mechanism of RNA interference, <italic>in vivo</italic> and potential clinical applications</article-title><source>Cancer Biol Ther</source><year>2004</year><volume>3</volume><fpage>1069</fpage><lpage>1074</lpage><pub-id pub-id-type="pmid">15539939</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chang</surname><given-names>HS</given-names></name><name><surname>Lin</surname><given-names>CH</given-names></name><name><surname>Chen</surname><given-names>YC</given-names></name><name><surname>Yu</surname><given-names>WC</given-names></name></person-group><article-title>Using siRNA technique to generate transgenic animals with spatiotemporal and conditional gene knockdown</article-title><source>Am J Pathol</source><year>2004</year><volume>165</volume><fpage>1535</fpage><lpage>1541</lpage><pub-id pub-id-type="pmid">15509524</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hsieh</surname><given-names>AC</given-names></name><name><surname>Bo</surname><given-names>R</given-names></name><name><surname>Manola</surname><given-names>J</given-names></name><name><surname>Vazquez</surname><given-names>F</given-names></name><name><surname>Bare</surname><given-names>O</given-names></name><name><surname>Khvorova</surname><given-names>A</given-names></name><etal/></person-group><article-title>A library of siRNA duplexes targeting the phosphoinositide 3-kinase pathway: determinants of gene silencing for use in cell-based screens</article-title><source>Nucleic Acids Res</source><year>2004</year><volume>32</volume><fpage>893</fpage><lpage>901</lpage><pub-id pub-id-type="pmid">14769947</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Zhao</surname><given-names>Q</given-names></name><name><surname>Du</surname><given-names>J</given-names></name><name><surname>Gu</surname><given-names>H</given-names></name><name><surname>Teng</surname><given-names>X</given-names></name><name><surname>Zhang</surname><given-names>Q</given-names></name><name><surname>Qin</surname><given-names>H</given-names></name><etal/></person-group><article-title>Effects of YC-1 on hypoxia-inducible factor 1-driven transcription activity, cell proliferative vitality, and apoptosis in hypoxic human pancreatic cancer cells</article-title><source>Pancreas</source><year>2007</year><volume>34</volume><fpage>242</fpage><lpage>247</lpage><pub-id pub-id-type="pmid">17312464</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Yang</surname><given-names>L</given-names></name><name><surname>Cao</surname><given-names>Z</given-names></name><name><surname>Li</surname><given-names>F</given-names></name><name><surname>Post</surname><given-names>DE</given-names></name><name><surname>Van Meir</surname><given-names>EG</given-names></name><name><surname>Zhong</surname><given-names>H</given-names></name><etal/></person-group><article-title>Tumor-specific gene expression using the survivin promoter is further increased by hypoxia</article-title><source>Gene Ther</source><year>2004</year><volume>11</volume><fpage>1215</fpage><lpage>1223</lpage><pub-id pub-id-type="pmid">15141159</pub-id></element-citation></ref></ref-list></back><floats-group><fig id="F1" position="float"><label>Fig. 1</label><caption><p>Western blottings of control (C) and HIF-1&#x003b1; (H) siRNA transfected MIA paca-2 cell line in normoxia and hypoxia condition show that HIF-1&#x003b1; expression was suppressed in siRNA transfected MIA paca-2 cell line.</p></caption><graphic xlink:href="ymj-49-295-g001"/></fig><fig id="F2" position="float"><label>Fig. 2</label><caption><p>Cell proliferation assay of control (C) and HIF-1&#x003b1; (H) siRNA transfected MIA paca-2 cell lines treated with gemicitabine (G1: 127 &#x000b5;mol/L, G2: 254 &#x000b5;mol/L) show that HIF-1&#x003b1; (H) siRNA transfected MIA paca-2 cell line is more susceptible to gemicitabine, especially under hypoxia (h).</p></caption><graphic xlink:href="ymj-49-295-g002"/></fig><fig id="F3" position="float"><label>Fig. 3</label><caption><p>Caspase-3 activity is increased more in HIF-1&#x003b1; siRNA transfected MIA paca-2 cell line (H) than in control siRNA transfected MIA paca-2 cell lines (C). Similar results were also observed in gemicitabine (G) and hypoxia (h) groups.</p></caption><graphic xlink:href="ymj-49-295-g003"/></fig><fig id="F4" position="float"><label>Fig. 4</label><caption><p>Difference in tumor growth of control (C) and HIF-1&#x003b1; (H) siRNA transfected MIA paca-2 cell lines treated with or without gemicitabine (G: 120 mg/kg), showing that HIF-1&#x003b1; (H) siRNA transfected MIA paca-2 cell line is slower than that of control and siRNA transfected MIA paca-2 cell lines.</p></caption><graphic xlink:href="ymj-49-295-g004"/></fig><fig id="F5" position="float"><label>Fig. 5</label><caption><p>Immunohistofluorescence of tumor in each group of mice treated with gemicitabine to confirm HiF-1&#x003b1; inhibition. HiF-1&#x003b1; (H) siRNA transfected tumor shows less cellularity than control (C) (&#x000d7;100).</p></caption><graphic xlink:href="ymj-49-295-g005"/></fig></floats-group></article>