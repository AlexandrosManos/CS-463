roup><article-title>Cortical evoked potentials due to motion contrast in the blind hemifield</article-title><source>NeuroReport</source><year>1999</year><volume>10</volume><fpage>3595</fpage><lpage>3600</lpage><pub-id pub-id-type="pmid">10619650</pub-id></citation></ref><ref id="R17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nakamura</surname><given-names>Y</given-names></name><name><surname>Ohtsuka</surname><given-names>K</given-names></name></person-group><article-title>Topographical analysis of motion-triggered visual-evoked potentials in man</article-title><source>Jap J Ophthalmol</source><year>1999</year><volume>43</volume><fpage>36</fpage><lpage>43</lpage><pub-id pub-id-type="pmid">10197741</pub-id></citation></ref><ref id="R18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Watson</surname><given-names>JDG</given-names></name><name><surname>Myers R</surname><given-names>Frackowiak</given-names></name><etal/></person-group><article-title>Area V5 of the human brain: evidence from a combined study using positron emission tomography and magnetic resonance imaging</article-title><source>Cereb Cortex</source><year>1993</year><volume>3</volume><fpage>79</fpage><lpage>94</lpage><pub-id pub-id-type="pmid">8490322</pub-id></citation></ref><ref id="R19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tootell</surname><given-names>RBH</given-names></name><name><surname>Reppas</surname><given-names>JB</given-names></name><name><surname>Kwong</surname><given-names>KK</given-names></name><etal/></person-group><article-title>Functional analysis of human MT and related visual cortical areas using magnetic resonance imaging</article-title><source>J Neurosci</source><year>1995</year><volume>15</volume><fpage>3215</fpage><lpage>3230</lpage><pub-id pub-id-type="pmid">7722658</pub-id></citation></ref><ref id="R20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Probst</surname><given-names>T</given-names></name><name><surname>Plendl</surname><given-names>H</given-names></name><name><surname>Paulus</surname><given-names>W</given-names></name><name><surname>Wist</surname><given-names>ER</given-names></name><name><surname>Scherg</surname><given-names>M</given-names></name></person-group><article-title>Identification of the visual motion area (area V5) in the human brain by dipole source analysis</article-title><source>Exp Brain Res</source><year>1993</year><volume>93</volume><fpage>345</fpage><lpage>351</lpage><pub-id pub-id-type="pmid">8491274</pub-id></citation></ref><ref id="R21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hollants-Gilhuijs</surname><given-names>MAM</given-names></name><name><surname>De Munck</surname><given-names>JC</given-names></name><name><surname>Kubova</surname><given-names>Z</given-names></name><name><surname>van Royen</surname><given-names>E</given-names></name><name><surname>Sekreijse</surname><given-names>H</given-names></name></person-group><article-title>The development of hemispheric asymmetry in human motion VEPs</article-title><source>Vis Res</source><year>2000</year><volume>40</volume><fpage>1</fpage><lpage>11</lpage><pub-id pub-id-type="pmid">10768037</pub-id></citation></ref><ref id="R22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McKeefry</surname><given-names>DJ</given-names></name></person-group><article-title>Visual evoked potential elicited by chromatic motion onset</article-title><source>Vis Res</source><year>2001</year><volume>41</volume><fpage>2005</fpage><lpage>2025</lpage><pub-id pub-id-type="pmid">11412889</pub-id></citation></ref><ref id="R23"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McKeefry</surname><given-names>DJ</given-names></name></person-group><article-title>The influence of stimulus chromaticity on the isoluminant motion-onset VEP</article-title><source>Vis Res</source><year>2002</year><volume>42</volume><fpage>909</fpage><lpage>922</lpage><pub-id pub-id-type="pmid">11927355</pub-id></citation></ref><ref id="R24"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Livingstone</surname><given-names>M</given-names></name><name><surname>Hubel</surname><given-names>DH</given-names></name></person-group><article-title>Psychophysical evidence for separate channels for the perception of form, color, movement and depth</article-title><source>J Neurosci</source><year>1987</year><volume>7</volume><fpage>3146</fpage><lpage>3486</lpage></citation></ref><ref id="R25"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McKeefry</surname><given-names>DJ</given-names></name><name><surname>Zeki</surname><given-names>S</given-names></name></person-group><article-title>The position and topography of the human colour centre as revealed by functional magnetic resonance imaging</article-title><source>Brain</source><year>1997</year><volume>120</volume><fpage>2229</fpage><lpage>2242</lpage><pub-id pub-id-type="pmid">9448578</pub-id></citation></ref><ref id="R26"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cavanagh</surname><given-names>P</given-names></name><name><surname>Favreau</surname><given-names>O</given-names></name></person-group><article-title>Color and luminance share a common motion pathway</article-title><source>Vis Res</source><year>1985</year><volume>25</volume><fpage>1595</fpage><lpage>1601</lpage><pub-id pub-id-type="pmid">3832582</pub-id></citation></ref><ref id="R27"><label>27</label><citation citation-type="journal"><person-group person-group-type="author