e>478</lpage><pub-id pub-id-type="pmid">8327700</pub-id></element-citation></ref><ref id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Yu</surname><given-names>JS</given-names></name><name><surname>Rofsky</surname><given-names>NM</given-names></name></person-group><article-title>Dynamic subtraction MR imaging of the liver: advantages and pitfalls</article-title><source>AJR Am J Roentgenol</source><year>2003</year><volume>180</volume><fpage>1351</fpage><lpage>1357</lpage><pub-id pub-id-type="pmid">12704050</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Turnbull</surname><given-names>LW</given-names></name><name><surname>Buckley</surname><given-names>DL</given-names></name><name><surname>Turnbull</surname><given-names>LS</given-names></name><name><surname>Liney</surname><given-names>GP</given-names></name><name><surname>Knowles</surname><given-names>AJ</given-names></name></person-group><article-title>Differentiation of prostatic carcinoma and benign prostatic hyperplasia: correlation between dynamic Gd-DTPA-enhanced MR imaging and histopathology</article-title><source>J Magn Reson Imaging</source><year>1999</year><volume>9</volume><fpage>311</fpage><lpage>316</lpage><pub-id pub-id-type="pmid">10077030</pub-id></element-citation></ref><ref id="B19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Shukla-Dave</surname><given-names>A</given-names></name><name><surname>Hricak</surname><given-names>H</given-names></name><name><surname>Eberhardt</surname><given-names>SC</given-names></name><name><surname>Olgac</surname><given-names>S</given-names></name><name><surname>Muruganandham</surname><given-names>M</given-names></name><name><surname>Scardino</surname><given-names>PT</given-names></name><etal/></person-grou