-group><article-title>Prostate cancer: correlation of MR images with tissue optical density at pathologic examination</article-title><source>Radiology</source><year>1991</year><volume>179</volume><fpage>837</fpage><lpage>842</lpage><pub-id pub-id-type="pmid">2028002</pub-id></element-citation></ref><ref id="B5"><label>5</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Engelbrecht</surname><given-names>MR</given-names></name><name><surname>Huisman</surname><given-names>HJ</given-names></name><name><surname>Laheij</surname><given-names>RJ</given-names></name><name><surname>Jager</surname><given-names>GJ</given-names></name><name><surname>van Leenders</surname><given-names>GJ</given-names></name><name><surname>Hulsbergen-Van De Kaa</surname><given-names>CA</given-names></name><etal/></person-group><article-title>Discrimination of prostate cancer from normal peripheral zone and central gland tissue by using dynamic contrast-enhanced MR imaging</article-title><source>Radiology</source><year>2003</year><volume>229</volume><fpage>248</fpage><lpage>254</lpage><pub-id pub-id-type="pmid">12944607</pub-id></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>White</surname><given-names>S</given-names></name><name><surname>Hricak</surname><given-names>H</given-names></name><name><surname>Forstner</surname><given-names>R</given-names></name><name><surname>Kurhanewicz</surname><given-names>J</given-names></name><name><surname>Vigneron</surname><given-names>DB</given-names></name><name><surname>Zaloudek</surname><given-names>CJ</given-names></name><etal/></person-group><article-title>Prostate cancer: effect of postbiopsy hemorrhage on interpretation of MR images</article-title><source>Radiology</source><year>1995</year><volume>195</volume><fpage>385</fpage><lpage>390</lpage><pub-id pub-id-type="pmid">7724756</pub-id></eleme