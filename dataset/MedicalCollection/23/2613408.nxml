id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Beggs</surname><given-names>I</given-names></name></person-group><article-title>The radiology of hydatid disease</article-title><source>AJR Am J Roentgenol</source><year>1985</year><volume>145</volume><fpage>639</fpage><lpage>648</lpage><pub-id pub-id-type="pmid">3895873</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Halezeroglu</surname><given-names>S</given-names></name><name><surname>Celik</surname><given-names>M</given-names></name><name><surname>Uysal</surname><given-names>A</given-names></name><name><surname>Senol</surname><given-names>C</given-names></name><name><surname>Keles</surname><given-names>M</given-names></name><name><surname>Arman</surname><given-names>B</given-names></name></person-group><article-title>Giant hydatid cysts of the lung</article-title><source>J Thoraco Cardiovasc</source><year>1997</year><volume>113</volume><fpage>712</fpage><lpage>717</lpage><pub-id pub-id-type="doi">10.1016/S0022-5223(97)70228-9</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Galanakis</surname><given-names>E</given-names></name><name><surname>Besis</surname><given-names>S</given-names></name><name><surname>Pappa</surname><given-names>C</given-names></name><name><surname>Nicolopoulos</surname><given-names>P</given-names></name><name><surname>Lapatsanis</surname><given-names>P</given-names></name></person-group><article-title>Treatment of complicated pulmonary echinococosis with albendazole in childhood</article-title><source>Scand J Infect Dis</source><year>1997</year><volume>29</volume><fpage>638</fpage><lpage>640</lpage><pub-id pub-id-type="pmid">9571752</pub-id><pub-id pub-id-type="doi">10.3109/00365549709035913</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ayles</surname><given-names>HM</given-names></name><name><surname>Corbett</surname><given-names>EL</given-names></name><name><surname>Taylor</surname><given-names>I</given-names></name><name><surname>Cowie</surname><given-names>AGG</given-names></name><name><surname>Bligh</surname><given-names>J</given-names></name><name><surname>Walmsley</surname><given-names>K</given-names></name><name><surname>Bryceson</surname><given-names>ADM</given-names></name></person-group><article-title>A combined medical and surgical approach to hydatid disease: 12 years' experience at the Hospital for Tropical Disease, London</article-title><source>Ann R Coll Surg Engl</source><year>2002</year><volume>84</volume><fpage>100</fpage><lpage>105</lpage><pub-id pub-id-type="pmid">11995745</pub-id></citation></ref></ref-list></back></article>