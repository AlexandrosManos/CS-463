rname>Rhodes</surname><given-names>D</given-names></name><name><surname>Wasan</surname><given-names>SK</given-names></name><name><surname>Appel</surname><given-names>LJ</given-names></name></person-group><article-title>Results of the diet, exercise, and weight loss intervention trial (DEW-IT)</article-title><source>Hypertension</source><year>2002</year><volume>40</volume><fpage>612</fpage><lpage>618</lpage><pub-id pub-id-type="pmid">12411452</pub-id><pub-id pub-id-type="doi">10.1161/01.HYP.0000037217.96002.8E</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Svetkey</surname><given-names>LP</given-names></name><name><surname>Loria</surname><given-names>CM</given-names></name></person-group><article-title>Blood pressure effects of vitamin C: What's the key question?</article-title><source>Hypertension</source><year>2002</year><volume>40</volume><fpage>789</fpage><lpage>791</lpage><pub-id pub-id-type="pmid">12468557</pub-id><pub-id pub-id-type="doi">10.1161/01.HYP.0000038340.95407.43</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Frei</surname><given-names>B</given-names></name></person-group><article-title>On the role of vitamin C and other antioxidants in atherogenesis and vascular dysfunction</article-title><source>Proc Soc Exp Biol Med</source><year>1999</year><volume>222</volume><fpage>196</fpage><lpage>204</lpage><pub-id pub-id-type="pmid">10601878</pub-id><pub-id pub-id-type="doi">10.1046/j.1525-1373.1999.d01-136.x</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Duvall</surname><given-names>WL</given-names></name></person-group><article-title>Endothelial dysfunction and antioxidants</article-title><source>Mt Sinai J Med</source><year>2005</year><volume>72</volume><fpage>71</fpage><lpage>80</lpage><pub-id pub-id-type="pmid">15770336</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jacques</surname><given-names>PF</given-names></name></person-group><article-title>A cross-sectional study of vitamin C intake and blood pressure in the elderly</article-title><source>Int J Vitam Nutr Res</source><year>1992</year><volume>62</volume><fpage>252</fpage><lpage>255</lpage><pub-id pub-id-type="pmid">1473908</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Salonen</surname><given-names>JT</given-names></name><name><surname>Salonen</surname><given-names>R</given-names></name><name><surname>Ihanainen</surname><given-names>M</given-names></name><name><surname>Parviainen</surname><given-names>M</given-names></name><name><surname>Seppanen</surname><given-names>R</given-names></name><name><surname>Kantola</surname><given-names>M</given-names></name><name><surname>Seppanen</surname><given-names>K</given-names></name><name><surname>Rauramaa</surname><given-names>R</given-names></name></person-group><article-title>Blood pressure, dietary fats, and antioxidants</article-title><source>Am J Clin Nutr</source><year>1988</year><volume>48</volume><fpage>1226</fpage><lpage>1232</lpage><pub-id pub-id-type="pmid">3189209</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Riemersma</surname><given-names>RA</given-names></name><name><surname>Oliver</surname><given-names>M</given-names></name><name><surname>Elton</surname><given-names>RA</given-names></name><name><surname>Alfthan</surname><given-names>G</given-names></name><name><surname>Vartiainen</surname><given-names>E</given-names></name><name><surname>Salo</surname><given-names>M</given-names></name><name><surname>Rubba</surname><given-names>P</given-names></name><name><surname>Mancini</surname><given-names>M</given-names></name><name><surname>Georgi</surname><given-names>H</given-names></name><name><surname>Vuilleumeir</surname><given-names>JP</given-names></name></person-group><article-title>Plasma antioxidants and coronary heart disease: vitamins C and E, and selenium</article-title><source>Eur J Clin Nutr</source><year>1990</year><volume>44</volume><fpage>143</fpage><lpage>150</lpage><pub-id pub-id-type="pmid">2132414</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koh</surname><given-names>ET</given-names></name><name><surname>Stewart</surname><given-names>T</given-names></name></person-group><article-title>Interrelationship among the blood components and anthropometric measurements</article-title><source>Nutr Rep Int</source><year>1978</year><volume>18</volume><fpage>539</fpage><lpage>549</lpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koh</surname><given-names>ET</given-names></name><name><surname>Chi</surname><given-names>MS</given-names></name></person-group><article-title>Relationship of serum vitamin C and globulin fractions with anthropometric measurements in adults</article-title><source>Nutr Rep Int</source><year>1980</year><volume>21</volume><fpage>537</fpage><lpage>549</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yoshioka</surname><given-names>M</given-names></name><name><surname>Matsushita</surname><given-names/></name><name><surname>Chuman</surname><given-names>Y</given-names></name></person-group><article-title>Inverse association of serum ascorbic acid level and blood pressure or rate of hypertension in male adults aged 30&#x02013;39 years</article-title><source>Int J Vitam Nutr Res</source><year>1984</year><volume>54</volume><fpage>343</fpage><lpage>347</lpage><pub-id pub-id-type="pmid">6151942</pub-id></citation></ref><ref id="B14"><cit