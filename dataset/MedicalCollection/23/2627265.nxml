7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Madersbacher</surname><given-names>S</given-names></name><name><surname>Pedevilla</surname><given-names>M</given-names></name><name><surname>Vingers</surname><given-names>L</given-names></name><name><surname>Susani</surname><given-names>M</given-names></name><name><surname>Marberger</surname><given-names>M</given-names></name></person-group><article-title>Effect of high-intensity focused ultrasound on human prostate cancer in vivo</article-title><source>Cancer Res</source><year>1995</year><volume>55</volume><fpage>3346</fpage><lpage>3351</lpage><pub-id pub-id-type="pmid">7542168</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dalecki</surname><given-names>D</given-names></name></person-group><article-title>Mechanical bioeffects of ultrasound</article-title><source>Annu Rev Biomed Eng</source><year>2004</year><volume>6</volume><fpage>229</fpage><lpage>248</lpage><pub-id pub-id-type="pmid">15255769</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><article-title>American institute of ultrasound in medicine, bioeffects committee. Bioeffects consideration of the safety of diagnostic ultrasound</article-title><source>J Ultrasound Med</source><year>1988</year><volume>7</volume><fpage>S1</fpage><lpage>S38</lpage><pub-id pub-id-type="pmid">3054148</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Crocker</surname><given-names>MJ</given-names></name></person-group><source>Encyclopedia of acoustics</source><year>1997</year><edition>1st ed</edition><publisher-loc>New York</publisher-loc><publisher-name>John Wiley &#x00026; Sons</publisher-name><fpage>6</fpage></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Nyborg</surname><given-names>WL</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Wu</surname><given-names>J</given-names></name><name><surname>Nyborg</surname><given-names>WL</given-names></name></person-group><article-title>Mechanisms for bioeffects of ultrasound relevant to therapeutic applications</article-title><source>Emerging therapeutic ultrasound</source><year>2006</year><edition>1st ed</edition><publisher-loc>Singapore</publisher-loc><publisher-name>World Scientific Publishing</publisher-name><fpage>5</fpage><lpage>67</lpage></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>ter Haar</surname><given-names>GR</given-names></name></person-group><article-title>Therapeutic application of ultrasound</article-title><source>Prog Biophys Mol Biol</source><year>2007</year><volume>93</volume><fpage>111</fpage><lpage>129</lpage><pub-id pub-id-type="pmid">16930682</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>ter Haar</surname><given-names>GR</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Hill</surname><given-names>CR</given-names></name><name><surname>Bamber</surname><given-names>JC</given-names></name><name><surname>ter Haar</surname><given-names>GR</given-names></name></person-group><article-title>Therapeutic and surgical applications</article-title><source>Physical principles of medical ultrasound</source><year>2004</year><edition>2nd ed</edition><publisher-loc>West Sussex</publisher-loc><publisher-name>John Wiley &#x00026; Sons</publisher-name><fpage>407</fpage><lpage>456</lpage></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Vaezy</surname><given-names>S</given-names></name><name><surname>Andrew</surname><given-names>M</given-names></name><name><surname>Kaczkowski</surname><given-names>P</given-names></name><name><surname>Crum</surname><given-names>L</given-names></name></person-group><article-title>Image-guided acoustic therapy</article-title><source>Annu Rev Biomed Eng</source><year>2001</year><volume>3</volume><fpage>375</fpage><lpage>390</lpage><pub-id pub-id-type="pmid">11447068</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Hynynen</surname><given-names>K</given-names></name><name><surname>McDannold</surname><given-names>N</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Wu</surname><given-names>J</given-names></name><name><surname>Nyborg</surname><given-names>WL</given-names></name></person-group><article-title>MRI-guided focused ultrasound for local tissue ablation and other image-guided interventions</article-title><source>Emerging therapeutic ultrasound</source><year>2006</year><edition>1st ed</edition><publisher-loc>Singapore</publisher-loc><publisher-name>World Scientific Publishing</publisher-name><fpage>167</fpage><lpage>218</lpage></element-citation></ref><ref id="B16"><label>16</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>ter Haar</surname><given-names>GR</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Hill</surname><given-names>CR</given-names></name><name><surname>Bamber</surname><given-names>JC</given-names></name><name><surname>ter Haar</surname><given-names>GR</given-names></name></person-group><article-title>Ultrasonic biophysics</article-title><source>Physical principles of medical ultrasound</source><year>2004</year><edition>2nd ed</edition><publisher-loc>West Sussex</publisher-loc><publisher-name>John Wiley &#x00026; Sons</publisher-name><fpage>348</fpage><lpage>406</lpage></element-citation></ref><ref id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kennedy</surname><given-names>JE</given-names></name><name><surname>ter Haar</surname><given-names>GR</given-names></name><name><surname>Cranston</surname><given-names>D</given-names></name></person-group><article-title>High intensity focused ultrasound: surgery of the future?</article-title><source>Br J Radiol</source><year>2003</year><volume>76</volume><fpage>590</fpage><lpage>599</lpage><pub-id pub-id-type="pmid">14500272</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Crocker</surname><given-names>MJ</given-names></name></person-group><source>Encyclopedia of acoustics</source><year>1997</year><edition>1st ed</edition><publisher-loc>New York</publisher-loc><publisher-name>John Wiley &#x00026; Sons</publisher-name><fpage>1727</fpage></element-citation></ref><ref id="B19"><label>19</label><element-citation publication-type="book"><source>Biological Effects of Ultrasound: Mechanisms and Clinical Implications, NCRP Report #74</source><year>1983</year><publisher-name>National Council on Radiation Protection and Measurements (NCRP)</publisher-name></element-citation></ref><ref id="B20"><label>20</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Leslie</surname><given-names>TA</given-names></name><name><surname>Kennedy</surname><given-names>JE</given-names></name></person-group><article-title>High-intensity focused ultrasound principles, current uses, and potential for the future</article-title><source>Ultrasound Q</source><year>2006</year><volume>22</volume><fpage>263</fpage><lpage>272</