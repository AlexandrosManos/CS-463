3-415918.001"/></fig><table-wrap id="tab1" orientation="portrait" position="float"><label>Table 1</label><caption><p>Patient data.</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1">&#x02009;</th><th align="center" rowspan="1" colspan="1">Mean &#x000b1; SD </th><th align="center" rowspan="1" colspan="1">Range </th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">Mean age (years) </td><td align="center" rowspan="1" colspan="1">66 &#x000b1; 13 </td><td align="center" rowspan="1" colspan="1">25&#x02013;85 </td></tr><tr><td align="left" rowspan="1" colspan="1">Gender (male/female)</td><td align="center" rowspan="1" colspan="1">46/17 </td><td align="center" rowspan="1" colspan="1">&#x02009;</td></tr><tr><td align="left" rowspan="1" colspan="1">Body mass index (kg/m<sup>2</sup>)</td><td align="center" rowspan="1" colspan="1">23.5 &#x000b1; 3.3 </td><td align="center" rowspan="1" colspan="1">17&#x02013;34 </td></tr><tr><td align="left" rowspan="1" colspan="1">Operative time (min) </td><td align="center" rowspan="1" colspan="1">312 &#x000b1; 144 </td><td align="center" rowspan="1" colspan="1">89&#x02013;727 </td></tr><tr><td align="left" rowspan="1" colspan="1">Estimated blood loss (mL) </td><td align="center" rowspan="1" colspan="1">251 &#x000b1; 365 </td><td align="center" rowspan="1" colspan="1">10&#x02013;1690 </td></tr><tr><td align="left" rowspan="1" colspan="1">Concurrent disease (<italic>n</italic>) </td><td align="center" rowspan="1" colspan="1">16 (25.4%) </td><td align="center" rowspan="1" colspan="1">&#x02009;</td></tr><tr><td align="left" rowspan="1" colspan="1">History of abdominal surgery (<italic>n</italic>) </td><td align="center" rowspan="1" colspan="1">5 (7.9%) </td><td align="center" rowspan="1" colspan="1">&#x02009;</td></tr></tbody></table></table-wrap><table-wrap id="tab2" orientation="portrait" position="float"><label>Table 2</label><caption><p>Surgical procedures.</p></caption><table