ical protein</td><td align="center"><italic>Oryza sativa</italic></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AP008208">AP008208</ext-link></td></tr><tr><td align="left">Hypothetical protein</td><td align="center"><italic>Oryza sativa</italic></td><td align="center"><ext-link ext-link-type="gen" xlink:href="NM_001057688">NM_001057688</ext-link></td></tr><tr><td align="left">Hypothetical protein</td><td align="center"><italic>Oryza sativa</italic></td><td align="center"><ext-link ext-link-type="gen" xlink:href="NM_001066910">NM_001066910</ext-link></td></tr><tr><td align="left">Hypothetical protein</td><td align="center"><italic>Oryza sativa</italic></td><td align="center"><ext-link ext-link-type="gen" xlink:href="NM_001053573">NM_001053573</ext-link></td></tr><tr><td align="left">Hypothetical protein</td><td align="center"><italic>Oryza sativa</italic></td><td align="center"><ext-link ext-link-type="gen" xlink:href="CT829595">CT829595</ext-link></td></tr><tr><td align="left">Hypothetical protein</td><td align="center"><italic>Oryza sativa</italic></td><td align="center"><ext-link ext-link-type="gen" xlink:href="CT834076">CT834076</ext-link></td></tr></tbody></table></table-wrap><table-wrap position="float" id="T2"><label>Table 2</label><caption><p>Genes detected exclusively in roots of the susceptible genotype (IRAT20) SSH library</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="left"><bold>Encoded protein</bold></td><td align="center"><bold>Homologous organism</bold></td><td align="center"><bold>Accession number</bold></td></tr></thead><tbody><tr><td align="left"><bold>Proteins of known function</bold></td><td></td><td></td></tr><tr><td align="left">T complex 11 family protein</td><td align="center"><italic>Oryza sativa</italic></td><td align="center">NM_001059402</td></tr><tr><td align="left">Protein kinase domain containing protein</td><td align="center"><italic>Oryza sativa</italic></td><td align="center">NM_001071926<