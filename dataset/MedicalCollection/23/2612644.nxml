3</year><publisher-name>Stuttgart: Schattauer Verlag</publisher-name></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cysarz</surname><given-names>D</given-names></name><name><surname>Schurholz</surname><given-names>T</given-names></name><name><surname>Bettermann</surname><given-names>H</given-names></name><name><surname>Kummell</surname><given-names>HC</given-names></name></person-group><article-title>Evaluation of modulations in heart rate variability caused by a composition of herbal extracts</article-title><source>Arzneimittelforschung</source><year>2000</year><volume>50</volume><fpage>420</fpage><lpage>424</lpage><pub-id pub-id-type="pmid">10858869</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cysarz</surname><given-names>D</given-names></name><name><surname>Heckmann</surname><given-names>C</given-names></name><name><surname>Kummell</surname><given-names>HC</given-names></name></person-group><article-title>[The effects of Cardiodoron on cardio-respiratory coordination&#x02013;a literature review]</article-title><source>Forsch Komplementarmed Klass Naturheilkd</source><year>2002</year><volume>9</volume><fpage>292</fpage><lpage>297</lpage><pub-id pub-id-type="pmid">12417806</pub-id><pub-id pub-id-type="doi">10.1159/000067523</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>B&#x000fc;ssing</surname><given-names>A</given-names></name><name><surname>Ostermann</surname><given-names>T</given-names></name><name><surname>Matthiesen</surname><given-names>PF</given-names></name></person-group><article-title>Inanspruchnahme unterst&#x000fc;tzender komplement&#x000e4;rmedizinischer Verfahren bei Tumorpatienten in der sp&#x000e4;teren Phase</article-title><source>Deutsche Zeitschrift f&#x000fc;r Onkologie</source><year>2007</year><volume>39</volu