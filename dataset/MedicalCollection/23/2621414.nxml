itle><source>J Am Acad Dermatology</source><volume>35</volume><fpage>835</fpage><lpage>8</lpage></citation></ref><ref id="b12-tcrm-4-1135"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Primka</surname><given-names>EJ</given-names></name><name><surname>Camisa</surname><given-names>C</given-names></name></person-group><year>1997</year><article-title>Methotrexate-induced toxic epidermal necrolysis in a patient with psoriasis</article-title><source>J Am Acad Dermatol</source><volume>36</volume><fpage>815</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">9146556</pub-id></citation></ref><ref id="b13-tcrm-4-1135"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reed</surname><given-names>KM</given-names></name><name><surname>Sober</surname><given-names>AJ</given-names></name></person-group><year>1983</year><article-title>Methotrexate-induced necrolysis</article-title><source>J Am Acad Dermatol</source><volume>8</volume><fpage>677</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">6863626</pub-id></citation></ref><ref id="b14-tcrm-4-1135"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yang</surname><given-names>C</given-names></name><name><surname>Yang</surname><given-names>LJ</given-names></name><name><surname>Jaing</surname><given-names>TH</given-names></name><etal/></person-group><year>2000</year><article-title>Toxic epidermal necrolysis following combination of methotrexate and trimethoprim-sulfamethoxazole</article-title><source>Int J Dermatol</source><volume>39</volume><fpage>621</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">10971734</pub-id></citation></ref><ref id="b15-tcrm-4-1135"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zackheim</surname><given-names>HS</given-names></name><name><surname>Epstein</surname><given-names>EH</given-names><suffix>Jr</suffix></name></person-group><year>1989</y