 children</article-title><source>WHO Bull</source><year>1993</year><volume>71</volume><fpage>485</fpage><lpage>9</lpage></element-citation></ref><ref id="ref7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rahi</surname><given-names>JS</given-names></name><name><surname>Sripathi</surname><given-names>S</given-names></name><name><surname>Gilbert</surname><given-names>CE</given-names></name><name><surname>Foster</surname><given-names>A</given-names></name></person-group><article-title>Childhood blindness dueto vitamin A deficiency in India: Regional variations</article-title><source>Arch Dis Child</source><year>1995</year><volume>72</volume><fpage>330</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">7763066</pub-id></element-citation></ref><ref id="ref8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gogate</surname><given-names>P</given-names></name><name><surname>Deshpande</surname><given-names>M</given-names></name><name><surname>Sudrik</surname><given-names>S</given-names></name><name><surname>Kishore</surname><given-names>H</given-names></name><name><surname>Taras</surname><given-names>S</given-names></name><name><surname>Gilbert</surname><given-names>C</given-names></name></person-group><article-title>Changing pattern of childhood blindness in Maharashtra, India</article-title><source>Br J Ophthalmol</source><year>2007</year><volume>91</volume><fpage>8</fpage><lpage>12</lpage><pub-id pub-id-type="pmid">16809383</pub-id></element-citation></ref><ref id="ref9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Titiyal</surname><given-names>JS</given-names></name><name><surname>Pal</surname><given-names>N</given-names></name><name><surname>Murthy</surname><given-names>GV</given-names></name><name><surname>Gupta</surname><given-names>SK</given-names></name><name