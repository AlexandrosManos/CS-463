="journal"><person-group person-group-type="author"><name><surname>Carlson</surname><given-names>NE</given-names></name><name><surname>Roach</surname><given-names>RB</given-names><suffix>Jr</suffix></name></person-group><article-title>Platelet-rich plasma: clinical applications in dentistry</article-title><source>J Am Dent Assoc (1939)</source><year>2002</year><volume>133</volume><fpage>1383</fpage><lpage>1386</lpage></citation></ref><ref id="b13-0010192"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Anitua</surname><given-names>E</given-names></name><name><surname>Andia</surname><given-names>I</given-names></name><name><surname>Ardanza</surname><given-names>B</given-names></name><name><surname>Nurden</surname><given-names>P</given-names></name><name><surname>Nurden</surname><given-names>AT</given-names></name></person-group><article-title>Autologous platelets as a source of proteins for healing and tissue regeneration</article-title><source>Thromb Haemost</source><year>2004</year><volume>91</volume><fpage>4</fpage><lpage>15</lpage><pub-id pub-id-type="pmid">14691563</pub-id></citation></ref><ref id="b14-0010192"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lucarelli</surname><given-names>E</given-names></name><name><surname>Donati</surname><given-names>D</given-names></name><name><surname>Cenacchi</surname><given-names>A</given-names></name><name><surname>Fornasari</surname><given-names>PM</given-names></name></person-group><article-title>Bone reconstruction of large defects using bone marrow derived autologous stem cells</article-title><source>Transfus Apher Sci</source><year>2004</year><volume>30</volume><fpage>169</fpage><lpage>174</lpage><pub-id pub-id-type="pmid">15062758</pub-id></citation></ref><ref id="b15-0010192"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hanna</surname><