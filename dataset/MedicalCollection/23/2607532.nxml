 products</article-title><source>J. Agric. Food Chem.</source><year>2005</year><volume>53</volume><fpage>3259</fpage><lpage>3264</lpage><pub-id pub-id-type="pmid">15826086</pub-id></citation></ref><ref id="b6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Claeys</surname><given-names>WL</given-names></name><name><surname>De Vleeschouwer</surname><given-names>K</given-names></name><name><surname>Hendrickx</surname><given-names>ME</given-names></name></person-group><article-title>Quantifying the formation of carcinogens during food processing: acrylamide</article-title><source>Trends Food Sci. Technol.</source><year>2005</year><volume>16</volume><fpage>181</fpage><lpage>193</lpage></citation></ref><ref id="b7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dybing</surname><given-names>E</given-names></name><name><surname>Farmer</surname><given-names>PB</given-names></name><name><surname>Andersen</surname><given-names>M</given-names></name><name><surname>Fennell</surname><given-names>TR</given-names></name><name><surname>Lalljie</surname><given-names>SP</given-names></name><name><surname>M&#x000fc;ller</surname><given-names>DJ</given-names></name><name><surname>Olin</surname><given-names>S</given-names></name><name><surname>Petersen</surname><given-names>BJ</given-names></name><name><surname>Schlatter</surname><given-names>J</given-names></name><name><surname>Scholz</surname><given-names>G</given-names></name><name><surname>Scimeca</surname><given-names>JA</given-names></name><name><surname>Slimani</surname><given-names>N</given-names></name><name><surname>T&#x000f6;rnqvist</surname><given-names>M</given-names></name><name><surname>Tuijtelaars</surname><given-names>S</given-names></name><name><surname>Verger</surname><given-names>P</given-names></name></person-group><article-title>Human exposure and internal dose assessments of acrylamide in food</article-title><source>Food Chem. Tox