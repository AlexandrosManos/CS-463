ource>Methods Mol Cell Biol</source><year>1994</year><volume>5</volume><fpage>25</fpage><lpage>40</lpage></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koeuth</surname><given-names>T</given-names></name><name><surname>Versalovic</surname><given-names>J</given-names></name><name><surname>Lupski</surname><given-names>JR</given-names></name></person-group><article-title>Differential subsequence conservation of interspersed repetitive <italic>Streptococcus pneumoniae </italic>BOX elements in diverse bacteria</article-title><source>Genome Res</source><year>1995</year><volume>5</volume><fpage>408</fpage><lpage>418</lpage><pub-id pub-id-type="pmid">8750201</pub-id><pub-id pub-id-type="doi">10.1101/gr.5.4.408</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martin</surname><given-names>B</given-names></name><name><surname>Humbert</surname><given-names>O</given-names></name><name><surname>Camara</surname><given-names>M</given-names></name><name><surname>Guenzi</surname><given-names>E</given-names></name><name><surname>Walker</surname><given-names>J</given-names></name><name><surname>Mitchell</surname><given-names>T</given-names></name><name><surname>Andrew</surname><given-names>P</given-names></name><name><surname>Prudhomme</surname><given-names>M</given-names></name><name><surname>Alloing</surname><given-names>G</given-names></name><name><surname>Hakenbeck</surname><given-names>R</given-names></name><name><surname>Morrison</surname><given-names>DA</given-names></name><name><surname>Boulnois</surname><given-names>GJ</given-names></name><name><surname>Claverys</surname><given-names>JP</given-names></name></person-group><article-title>A highly conserved repeated DNA element located in the chromosome of <italic>Streptococcus pneumoniae</italic></article-title><source>Nucleic Acids Res</source><year>1992</year><volume>20</volume><fpage>3479</fpage><lpage>3483</lpage><pub-id pub-id-type="pmid">1630918</pub-id><pub-id pub-id-type="doi">10.1093/nar/20.13.3479</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Van Belkum</surname><given-names>A</given-names></name><name><surname>Scherer</surname><given-names>S</given-names></name><name><surname>Van Alphen</surname><given-names>L</given-names></name><name><surname>Verbrugh</surname><given-names>H</given-names></name></person-group><article-title>Short-sequence DNA repeats in prokaryotic genomes</article-title><source>Microbiol Mol Biol Rev</source><year>1998</year><volume>62</volume><fpage>275</fpage><lpage>293</lpage><pub-id pub-id-type="pmid">9618442</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chmielewski</surname><given-names>R</given-names></name><name><surname>Wieliczko</surname><given-names>A</given-names></name><name><surname>Kuczkowski</surname><given-names>M</given-names></name><name><surname>Mazurkiewicz</surname><given-names>M</given-names></name><name><surname>Ugorski</surname><given-names>M</given-names></name></person-group><article-title>Comparison of ITS profiling, REP- and ERIC-PCR of <italic>Salmonella enteritidis </italic>isolates from Poland</article-title><source>J Vet Med</source><year>2002</year><volume>49</volume><fpage>163</fpage><lpage>168</lpage><pub-id pub-id-type="doi">10.1046/j.1439-0450.2002.00544.x</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Niemann</surname><given-names>S</given-names></name><name><surname>P&#x000fc;hler</surname><given-names>A</given-names></name><name><surname>Ticky</surname><given-names>HV</given-names></name><name><surname>Simon</surname><given-names>R</given-names></name><name><surname>Selbitschka</surname><given-names>W</given-names></name></pers