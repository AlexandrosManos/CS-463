me><surname>Robinson</surname><given-names>NA</given-names></name></person-group><article-title>The epidermal keratinocyte as a model for the study of gene regulation and cell differentiation</article-title><source>Physiol Rev</source><year>1997</year><volume>77</volume><fpage>397</fpage><lpage>424</lpage><pub-id pub-id-type="pmid">9114819</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fischer</surname><given-names>H</given-names></name><name><surname>Eckhart</surname><given-names>L</given-names></name><name><surname>Mildner</surname><given-names>M</given-names></name><name><surname>Jaeger</surname><given-names>K</given-names></name><name><surname>Buchberger</surname><given-names>M</given-names></name><name><surname>Ghannadan</surname><given-names>M</given-names></name><name><surname>Tschachler</surname><given-names>E</given-names></name></person-group><article-title>DNase1L2 degrades nuclear DNA during corneocyte formation</article-title><source>J Invest Dermatol</source><year>2007</year><volume>127</volume><fpage>24</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">16902420</pub-id><pub-id pub-id-type="doi">10.1038/sj.jid.5700503</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mascetti</surname><given-names>G</given-names></name><name><surname>Carrara</surname><given-names>S</given-names></name><name><surname>Vergani</surname><given-names>L</given-names></name></person-group><article-title>Relationship between chromatin compactness and dye uptake for in situ chromatin stained with DAPI</article-title><source>Cytometry</source><year>2001</year><volume>44</volume><fpage>113</fpage><lpage>119</lpage><pub-id pub-id-type="pmid">11378861</pub-id><pub-id pub-id-type="doi">10.1002/1097-0320(20010601)44:2&#x0003c;113::AID-CYTO1089&#x0003e;3.0.CO;2-A</pub-id></citation></ref></ref-list></back></article>