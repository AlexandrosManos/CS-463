rson-group-type="author"><name><surname>Keene</surname><given-names>AR</given-names></name><name><surname>Cullen</surname><given-names>DJ</given-names></name></person-group><article-title>Therapeutic Intervention Scoring System: update 1983</article-title><source>Critical Care Medicine</source><year>1983</year><volume>11</volume><fpage>1</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">6848305</pub-id><pub-id pub-id-type="doi">10.1097/00003246-198301000-00001</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guttman</surname><given-names>L</given-names></name></person-group><article-title>A basis for analyzing test-retest reliability</article-title><source>Psychometrika</source><year>1945</year><volume>10</volume><fpage>255</fpage><lpage>283</lpage><pub-id pub-id-type="doi">10.1007/BF02288892</pub-id></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>J&#x000f6;reskog</surname><given-names>KG</given-names></name></person-group><article-title>Statistical analysis of sets of congeneric tests</article-title><source>Psychometrika</source><year>1971</year><volume>36</volume><fpage>109</fpage><lpage>133</lpage><pub-id pub-id-type="doi">10.1007/BF02291393</pub-id></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Raykov</surname><given-names>T</given-names></name></person-group><article-title>Behavioral scale reliability and measurement invariance evaluation using latent variable modeling</article-title><source>Behavioral therapy</source><year>2004</year><volume>35</volume><fpage>299</fpage><lpage>331</lpage><pub-id pub-id-type="doi">10.1016/S0005-7894(04)80041-8</pub-id></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reuterberg</surname><given-names>SE</given-names></name><name><surnam