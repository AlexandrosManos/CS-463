>21</volume><fpage>311</fpage><lpage>316</lpage><pub-id pub-id-type="pmid">15107369</pub-id><pub-id pub-id-type="doi">10.1136/emj.2003.011122</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vlantis</surname><given-names>ACTR</given-names></name><name><surname>Wong</surname><given-names>DK</given-names></name><name><surname>Woo</surname><given-names>JK</given-names></name><name><surname>van Hasselt</surname><given-names>CA</given-names></name></person-group><article-title>The impact of severe acute respiratory syndrome on otorhinolaryngological services at the Prince of Wales Hospital in Hong Kong</article-title><source>Laryngoscope</source><year>2004</year><volume>114</volume><fpage>171</fpage><lpage>174</lpage><pub-id pub-id-type="pmid">14710016</pub-id><pub-id pub-id-type="doi">10.1097/00005537-200401000-00032</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>WK</given-names></name><name><surname>Cheng</surname><given-names>YC</given-names></name><name><surname>Chung</surname><given-names>YT</given-names></name><name><surname>Lin</surname><given-names>CC</given-names></name></person-group><article-title>The impact of the SARS outbreak on an urban emergency department in Taiwan</article-title><source>Med Care</source><year>2005</year><volume>43</volume><fpage>168</fpage><lpage>172</lpage><pub-id pub-id-type="pmid">15655430</pub-id><pub-id pub-id-type="doi">10.1097/00005650-200502000-00010</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>HH</given-names></name><name><surname>Yen</surname><given-names>DH</given-names></name><name><surname>Kao</surname><given-names>WF</given-names></name><name><surname>Wang</surname><given-names>LM</given-names></name><name><surname>Huang</surna