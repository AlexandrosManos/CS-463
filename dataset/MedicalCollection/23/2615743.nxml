n-group><article-title>Comparison of obstetric outcomes in recipients of donor oocytes vs. women of advanced maternal age with autologous oocytes</article-title><source>J Reprod Med</source><year>2007</year><volume>52</volume><fpage>585</fpage><lpage>90</lpage><pub-id pub-id-type="pmid">17847755</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wiggins</surname><given-names>DA</given-names></name><name><surname>Main</surname><given-names>E</given-names></name></person-group><article-title>Outcomes of pregnancies achieved by donor egg in vitro fertilization &#x02013; a comparison with standard in vitro fertilization pregnancies</article-title><source>AJOG</source><year>2005</year><volume>192</volume><fpage>2002</fpage><lpage>8</lpage><pub-id pub-id-type="doi">10.1016/j.ajog.2005.02.059</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sauer</surname><given-names>MV</given-names></name><name><surname>Paulson</surname><given-names>RJ</given-names></name><name><surname>Lobo</surname><given-names>RA</given-names></name></person-group><article-title>Oocyte donation to women of advanced reproductive age: pregnancy results and obstetrical outcomes in patients 45 years and older</article-title><source>Hum Reprod</source><year>1996</year><volume>11</volume><fpage>2540</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">8981151</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Abdalla</surname><given-names>HI</given-names></name><name><surname>Billett</surname><given-names>A</given-names></name><name><surname>Kan</surname><given-names>AKS</given-names></name><etal></etal></person-group><article-title>Obstetric outcome in 232 ovum donation pregnancies</article-title><source>BJOG</source><year>1998</year><volume>105</volume><fpage>332</fpage><lpage>7</lpage><pub-id pub-id-type="doi">10.1111/j.1471-0528.1998.tb10096.x</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Krieg</surname><given-names>SA</given-names></name><name><surname>Henne</surname><given-names>MB</given-names></name><name><surname>Westphal</surname><given-names>LM</given-names></name></person-group><article-title>Obstetric outcomes in donor oocyte pregnancies compared with advanced maternal age in in vitro fertilization pregnancies</article-title><source>Fertil Steril</source><year>2008</year><volume>90</volume><fpage>65</fpage><lpage>70</lpage><pub-id pub-id-type="pmid">17727845</pub-id><pub-id pub-id-type="doi">10.1016/j.fertnstert.2007.06.014</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jacobsson</surname><given-names>B</given-names></name><name><surname>Ladfors</surname><given-names>L</given-names></name><name><surname>Milsom</surname><given-names>I</given-names></name></person-group><article-title>Advanced maternal age and adverse perinatal outcome</article-title><source>Obstet Gynecol</source><year>2004</year><volume>104</volume><fpage>727</fpage><lpage>33</lpage><pub-id pub-id-type="pmid">15458893</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Peipert</surname><given-names>JF</given-names></name><name><surname>Bracken</surname><given-names>MB</given-names></name></person-group><article-title>Maternal age: an independent risk factor for cesarean delivery</article-title><source>Obstet Gynecol</source><year>1993</year><volume>81</volume><fpage>200</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">8423950</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Paulson</surname><given-names>RJ</given-names></name><name><surname>Boostanfar</surname><given-names>R</given-names></name><name><surname>Saadat</surname><given-names>P</given-names></name></person-group><article-title>Pregnancy in the sixt decade of life. Obstetric outcomes in women of advanced reproductive age</article-title><source>JAMA</source><year>2002</year><volume>288</volume><fpage>2320</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">12425710</pub-id><pub-id pub-id-type="doi">10.1001/jama.288.18.2320</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><collab>American College of Obstetricians and Gynecologists Committee Opinion</collab></person-group><article-title>Surgery and patient choice: The ethics of decision making</article-title><source>Obstet Gynecol</source><year>2003</year><volume>102</volume><fpage>1101</fpage><lpage>1106</lpage><pub-id pub-id-type="pmid">14672494</pub-id><pub-id pub-id-type="doi">10.1016/j.obstetgynecol.2003.09.030</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Landau</surname><given-names>R</given-names></name></person-group><article-title>The promise of post-menopausal pregnancy (PMP)</article-title><source>Soc Work Health Care</source><year>2004</year><volume>40</volume><fpage>53</fpage><lpage>69</lpage><pub-id pub-id-type="pmid">15831433</pub-id><pub-id pub-id-type="doi">10.1300/J010v40n01_04</pub-id></citation></ref></ref-list></back></article>