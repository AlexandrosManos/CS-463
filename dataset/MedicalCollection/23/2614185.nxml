on-type="journal"><person-group person-group-type="author"><name><surname>Doolittle</surname><given-names>WF</given-names></name></person-group><year>1999b</year><article-title>Lateral genomics</article-title><source>Trends Cell Biol</source><volume>9</volume><issue>12</issue><fpage>M5</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">10611671</pub-id></citation></ref><ref id="b12-ebo-4-109"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eisen</surname><given-names>JA</given-names></name><name><surname>Fraser</surname><given-names>CM</given-names></name></person-group><year>2003</year><article-title>Phylogenomics: intersection of evolution and genomics</article-title><source>Science</source><volume>300</volume><issue>5626</issue><fpage>1706</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">12805538</pub-id></citation></ref><ref id="b13-ebo-4-109"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Genereux</surname><given-names>DP</given-names></name><name><surname>Logsdon</surname><given-names>JM</given-names><suffix>Jr</suffix></name></person-group><year>2003</year><article-title>Much ado about bacteria-to-vertebrate lateral gene transfer</article-title><source>Trends Genet</source><volume>19</volume><issue>4</issue><fpage>191</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">12683971</pub-id></citation></ref><ref id="b14-ebo-4-109"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gogarten</surname><given-names>JP</given-names></name><name><surname>Kibak</surname><given-names>H</given-names></name><name><surname>Dittrich</surname><given-names>P</given-names></name><name><surname>Taiz</surname><given-names>L</given-names></name><name><surname>Bowman</surname><given-names>EJ</given-names></name><name><surname>Bowman</surname><given-names>BJ</given-names></name><name><surname>Manolson</surname><given-names>MF</given-names></name><name><surname>Poole</surname><given-names>RJ</given-names></name><name><surname>Date</surname><given-names>T</given-names></name><name><surname>Oshima</surname><given-names>T</given-names></name><etal/></person-group><year>1989</year><article-title>Evolution of the vacuolar H+-ATPase: implications for the origin of eukaryotes</article-title><source>Proc Natl Acad Sci, USA</source><volume>86</volume><issue>17</issue><fpage>6661</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">2528146</pub-id></citation></ref><ref id="b15-ebo-4-109"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gogarten</surname><given-names>JP</given-names></name></person-group><year>1995</year><article-title>The early evolution of cellular life</article-title><source>Trends in Ecology and Evolution</source><volume>10</volume><fpage>147</fpage><lpage>51</lpage></citation></ref><ref id="b16-ebo-4-109"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hilario</surname><given-names>E</given-names></name><name><surname>Gogarten</surname><given-names>JP</given-names></name></person-group><year>1993</year><article-title>Horizontal transfer of ATPase genes&#x02014;the tree of life becomes a net of life</article-title><source>Biosystems</source><volume>31</volume><issue>2&#x02013;3</issue><fpage>111</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">8155843</pub-id></citation></ref><ref id="b17-ebo-4-109"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>J</given-names></name><name><surname>Gogarten</surname><given-names>JP</given-names></name></person-group><year>2006</year><article-title>Ancient horizontal gene transfer can benefit phylogenetic reconstruction</article-title><source>Trends Genet</source><volume>22</volume><issue>7</issue><fpage>361</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">16730850</pub-id></citation></ref><ref id="b18-ebo-4-109"><citation citation-t