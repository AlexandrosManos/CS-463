><surname>Morlais</surname><given-names>I</given-names></name><name><surname>Ravel</surname><given-names>S</given-names></name><name><surname>Grebaut</surname><given-names>P</given-names></name><name><surname>Dumas</surname><given-names>V</given-names></name><name><surname>Cuny</surname><given-names>G</given-names></name></person-group><article-title>New molecular marker for Trypanosoma (Duttonella) vivax identification</article-title><source>Acta Trop</source><year>2001</year><volume>80</volume><fpage>207</fpage><lpage>213</lpage><pub-id pub-id-type="pmid">11700177</pub-id><pub-id pub-id-type="doi">10.1016/S0001-706X(01)00160-7</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reifenberg</surname><given-names>JM</given-names></name><name><surname>Solano</surname><given-names>P</given-names></name><name><surname>Duvallet</surname><given-names>G</given-names></name><name><surname>Cuisance</surname><given-names>D</given-names></name><name><surname>Simpore</surname><given-names>J</given-names></name><name><surname>Cuny</surname><given-names>G</given-names></name></person-group><article-title>Molecular characterization of trypanosome isolates from naturally infected domestic animals in Burkina, Faso</article-title><source>Vet Parasitol</source><year>1997</year><volume>71</volume><fpage>251</fpage><lpage>262</lpage><pub-id pub-id-type="pmid">9299694</pub-id><pub-id pub-id-type="doi">10.1016/S0304-4017(97)00011-3</pub-id></citation></ref></ref-list></back></article>