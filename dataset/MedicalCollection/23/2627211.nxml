e>274</lpage><pub-id pub-id-type="pmid">11780897</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sandalcioglu</surname><given-names>IE</given-names></name><name><surname>Wanke</surname><given-names>I</given-names></name><name><surname>Schoch</surname><given-names>B</given-names></name><name><surname>Gasser</surname><given-names>T</given-names></name><name><surname>Regel</surname><given-names>JP</given-names></name><name><surname>Doerfler</surname><given-names>A</given-names></name><etal/></person-group><article-title>Endovascularly or surgically treated vertebral artery and posterior inferior cerebellar artery aneurysms: clinical analysis and results</article-title><source>Zentralbl Neurochir</source><year>2005</year><volume>66</volume><fpage>9</fpage><lpage>16</lpage><pub-id pub-id-type="pmid">15744623</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lubicz</surname><given-names>B</given-names></name><name><surname>Leclerc</surname><given-names>X</given-names></name><name><surname>Gauvrit</surname><given-names>JY</given-names></name><name><surname>Lejeune</surname><given-names>J</given-names></name><name><surname>Pruvo</surname><given-names>JP</given-names></name></person-group><article-title>Endovascular treatment of peripheral cerebellar artery aneurysms</article-title><source>AJNR Am J Neuroradiol</source><year>2003</year><volume>24</volume><fpage>1208</fpage><lpage>1213</lpage><pub-id pub-id-type="pmid">12812956</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mericle</surname><given-names>RA</given-names></name><name><surname>Reig</surname><given-names>AS</given-names></name><name><surname>Burry</surname><given-names>MV