</source><volume>17</volume><fpage>3</fpage><lpage>18</lpage><pub-id pub-id-type="pmid">12617879</pub-id></citation></ref><ref id="b30-tcrm-4-927"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vaughan</surname><given-names>D</given-names></name><name><surname>Drumm</surname><given-names>B</given-names></name></person-group><year>1999</year><article-title>Treatment of fistulas with granulocyte colony-stimulating factor in a patient with Crohn&#x02019;s disease</article-title><source>N Engl J Med</source><volume>340</volume><fpage>239</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">9917236</pub-id></citation></ref><ref id="b31-tcrm-4-927"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Visser</surname><given-names>G</given-names></name><name><surname>Rake</surname><given-names>JP</given-names></name><name><surname>Labrune</surname><given-names>P</given-names></name><etal/></person-group><year>2002</year><article-title>Granulocyte colony-stimulating factor in glycogen storage disease type 1b. Results of the European Study on Glycogen Storage Disease Type 1</article-title><source>Eur J Pediatr</source><volume>161</volume><issue>Suppl 1</issue><fpage>S83</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">12373578</pub-id></citation></ref><ref id="b32-tcrm-4-927"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wilk</surname><given-names>JN</given-names></name><name><surname>Viney</surname><given-names>JL</given-names></name></person-group><year>2002</year><article-title>GM-CSF treatment for Crohn&#x02019;s disease: a stimulating new therapy?</article-title><source>Curr Opin Investig Drugs</source><volume>3</volume><fpage>1291</fpage><lpage>6</lpage></citation></ref><ref id="b33-tcrm-4-927"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yamaguchi</surname><given-names>T</given-names></name><name><surnam