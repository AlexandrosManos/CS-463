ience</source><year>2000</year><edition>4th edn</edition><publisher-loc>New York</publisher-loc><publisher-name>McGraw-Hill</publisher-name><fpage>430</fpage><lpage>451</lpage></citation></ref><ref id="b7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grassi</surname><given-names>C</given-names></name><name><surname>Deriu</surname><given-names>F</given-names></name><name><surname>Passatore</surname><given-names>M</given-names></name></person-group><article-title>Effect of sympathetic nervous system activation on the tonic vibration reflex in rabbit jaw closing muscles</article-title><source>J Physiol</source><year>1993</year><volume>469</volume><fpage>601</fpage><lpage>613</lpage><pub-id pub-id-type="pmid">8271218</pub-id></citation></ref><ref id="b8"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Iversen</surname><given-names>S</given-names></name><name><surname>Iversen</surname><given-names>L</given-names></name><name><surname>Saper</surname><given-names>CB</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Kandel</surname><given-names>ER</given-names></name><name><surname>Schwartz</surname><given-names>JH</given-names></name><name><surname>Jessell</surname><given-names>TM</given-names></name></person-group><article-title>The autonomic nervous system and the hypothalamus</article-title><source>Principles of neuronal science</source><year>2000</year><edition>4th edn</edition><publisher-loc>New York</publisher-loc><publisher-name>McGraw-Hill</publisher-name><fpage>960</fpage><lpage>981</lpage></citation></ref><ref id="b9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Takata</surname><given-names>Y</given-names></name><name><surname>Nakajima</surname><given-names>T</given-names></name><name><surname>Yamada</surname><given-names>Y</given-names></name></person-group><article-title>Quantitative evaluation of the tonic vibration reflex (TVR) in the masseter muscle</article-title><source>J Oral Maxillofac Surg</source><year>1996</year><volume>54</volume><fpage>1307</fpage><lpage>1313</lpage><pub-id pub-id-type="pmid">8941181</pub-id></citation></ref><ref id="b10"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Ueda</surname><given-names>K</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Uematsu</surname><given-names>H</given-names></name><name><surname>Inaba</surname><given-names>S</given-names></name><name><surname>Watanabe</surname><given-names>M</given-names></name></person-group><article-title>IV-2 Sessyoku enge rehabilitation</article-title><source>Koureishya Shika guidebook</source><year>2005</year><publisher-loc>Tokyo</publisher-loc><publisher-name>Ishiyaku</publisher-name><fpage>248</fpage><lpage>275</lpage><comment>(in Japanese)</comment></citation></ref><ref id="b11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yamaoka</surname><given-names>M</given-names></name><name><surname>Hiraba</surname><given-names>H</given-names></name><name><surname>Ueda</surname><given-names>K</given-names></name><name><surname>Fujiwara</surname><given-names>T</given-names></name></person-group><article-title>Development of a vibratile stimulation apparatus for orofacial rehabilitation</article-title><source>Nihondaigaku Shigakubu Kiyou</source><year>2007</year><volume>35</volume><fpage>13</fpage><lpage>18</lpage><comment>(in Japanese)</comment></citation></ref><ref id="b12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yrjama</surname><given-names>M</given-names></name><name><surname>Vanharanta</surname><given-names>H</given-names></name></person-group><article-title>Bony vibrotactile stimulation: A new, non-invasive method for examining intradiscal pain</article-title><source>Eur Spine J</source><year>1994</year>