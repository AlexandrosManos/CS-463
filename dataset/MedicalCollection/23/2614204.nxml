8</td><td align="center" rowspan="1" colspan="1">0.310</td><td align="center" rowspan="1" colspan="1">0.574</td><td align="center" rowspan="1" colspan="1">0.853</td><td align="center" rowspan="1" colspan="1">27</td><td align="center" rowspan="1" colspan="1">0.262</td><td align="center" rowspan="1" colspan="1">0.599</td><td align="center" rowspan="1" colspan="1">0.879</td></tr><tr><td align="left" rowspan="1" colspan="1">55</td><td align="center" rowspan="1" colspan="1">0.165</td><td align="center" rowspan="1" colspan="1">0.695</td><td align="center" rowspan="1" colspan="1">0.858</td><td align="center" rowspan="1" colspan="1">30</td><td align="center" rowspan="1" colspan="1">0.164</td><td align="center" rowspan="1" colspan="1">0.733</td><td align="center" rowspan="1" colspan="1">0.879</td></tr><tr><td align="left" rowspan="1" colspan="1">57</td><td align="center" rowspan="1" colspan="1">0.326</td><td align="center" rowspan="1" colspan="1">0.589</td><td align="center" rowspan="1" colspan="1">0.811</td><td align="center" rowspan="1" colspan="1">32</td><td align="center" rowspan="1" colspan="1">0.366</td><td align="center" rowspan="1" colspan="1">0.917</td><td align="center" rowspan="1" colspan="1">0.665</td></tr><tr><td align="left" rowspan="1" colspan="1">65</td><td align="center" rowspan="1" colspan="1">0.139</td><td align="center" rowspan="1" colspan="1">0.736</td><td align="center" rowspan="1" colspan="1">0.823</td><td align="center" rowspan="1" colspan="1">35</td><td align="center" rowspan="1" colspan="1">0.628</td><td align="center" rowspan="1" colspan="1">0.283</td><td align="center" rowspan="1" colspan="1">0.977</td></tr><tr><td align="left" rowspan="1" colspan="1">70</td><td align="center" rowspan="1" colspan="1">0.948</td><td align="center" rowspan="1" colspan="1">0.936</td><td align="center" rowspan="1" colspan="1">0.474</td><td align="center" rowspan="1" colspan="1">38</td><td align="center" rowspan="1" colspan="1">0.445</td><td align="center" rowspan="1" c