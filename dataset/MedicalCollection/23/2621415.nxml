 J</source><volume>199</volume><fpage>784</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">16395370</pub-id></citation></ref><ref id="b11-tcrm-4-1111"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dar-Odeh</surname><given-names>NS</given-names></name><name><surname>Abu-Hammad</surname><given-names>OA</given-names></name><name><surname>Khraisat</surname><given-names>AS</given-names></name><etal/></person-group><year>2008</year><article-title>An analysis of therapeutic, adult antibiotic prescriptions issued by dental practitioners in Jordan</article-title><source>Chemotherapy</source><volume>54</volume><fpage>17</fpage><lpage>22</lpage><pub-id pub-id-type="pmid">18063860</pub-id></citation></ref><ref id="b12-tcrm-4-1111"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Demirbas</surname><given-names>F</given-names></name><name><surname>Gjermo</surname><given-names>PE</given-names></name><name><surname>Preus</surname><given-names>HR</given-names></name></person-group><year>2006</year><article-title>Antibiotic prescribing practices among Norwegian dentists</article-title><source>Acta Odontol Scand</source><volume>64</volume><fpage>355</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">17123912</pub-id></citation></ref><ref id="b13-tcrm-4-1111"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dogan</surname><given-names>EA</given-names></name><name><surname>Dora</surname><given-names>B</given-names></name></person-group><year>2005</year><article-title>Transient partial ophthalmoplegia and Horner&#x02019;s syndrome after intraoral local anesthesia</article-title><source>J Clin Neurosci</source><volume>12</volume><fpage>696</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">16040248</pub-id></citation></ref><ref id="b14-tcrm-4-1111"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Epstein</surname><given-names