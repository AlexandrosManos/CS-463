/etal></person-group><article-title>Meta-analysis: chondroitin for osteoarthritis of the knee or hip</article-title><source>Ann Intern Med</source><year>2007</year><volume>146</volume><fpage>580</fpage><lpage>590</lpage><pub-id pub-id-type="pmid">17438317</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schneider</surname><given-names>V</given-names></name><name><surname>L&#x000e9;vesque</surname><given-names>LE</given-names></name><name><surname>Zhang</surname><given-names>B</given-names></name><name><surname>Hutchinson</surname><given-names>T</given-names></name><name><surname>Brophi</surname><given-names>JM</given-names></name></person-group><article-title>Association of selective and conventional nonsteroidal anti-inflammatory drugs with acute renal failure: a population-based, nested case-control analysis</article-title><source>Am J Epidemiol</source><year>2006</year><volume>164</volume><fpage>881</fpage><lpage>889</lpage><pub-id pub-id-type="pmid">17005625</pub-id><pub-id pub-id-type="doi">10.1093/aje/kwj331</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Graham</surname><given-names>DJ</given-names></name></person-group><article-title>COX-2 inhibitors, other NSAIDs, and cardiovascular risk. The seduction of common sense</article-title><source>JAMA</source><year>2006</year><volume>296</volume><fpage>1653</fpage><lpage>1656</lpage><pub-id pub-id-type="pmid">16968830</pub-id><pub-id pub-id-type="doi">10.1001/jama.296.13.jed60058</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Borer</surname><given-names>JS</given-names></name><name><surname>Simon</surname><given-names>LS</given-names></name></person-group><article-title>Cardiovascular and gastrointestinal effects of COX-2 inhibitors and NSAIDs: achieving a balance</article-title><source>Arthritis Res Ther</source><year>2005</year><volume>7</volume><fpage>S14</fpage><lpage>S22</lpage><pub-id pub-id-type="pmid">16168077</pub-id><pub-id pub-id-type="doi">10.1186/ar1794</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zhang</surname><given-names>J</given-names></name><name><surname>Ding</surname><given-names>EL</given-names></name><name><surname>Song</surname><given-names>Y</given-names></name></person-group><article-title>Adverse effects of cyclooxygenase 2 inhibitors on renal and arrhythmia events. Meta-analysis of randomized trials</article-title><source>JAMA</source><year>2006</year><volume>296</volume><fpage>1619</fpage><lpage>1632</lpage><pub-id pub-id-type="pmid">16968832</pub-id><pub-id pub-id-type="doi">10.1001/jama.296.13.jrv60015</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tanne</surname><given-names>JH</given-names></name></person-group><article-title>Reports cite cardiovascular risks of COX2 inhibitors and NSAIDs</article-title><source>BMJ</source><year>2006</year><volume>333</volume><fpage>565</fpage><pub-id pub-id-type="pmid">16973994</pub-id><pub-id pub-id-type="doi">10.1136/bmj.333.7568.565-a</pub-id></citation></ref><ref id="B11"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Towheed</surname><given-names>TE</given-names></name><name><surname>Maxwell</surname><given-names>L</given-names></name><name><surname>Judd</surname><given-names>MG</given-names></name><name><surname>Catton</surname><given-names>M</given-names></name><name><surname>Hochberg</surname><given-names>MC</given-names></name><name><surname>Wells</surname><given-names>G</given-names></name></person-group><article-title>Acetaminophen for osteoarthritis</article-title><source>Cochrane Database Syst Rev</source><fpage>CD004257</fpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Research</surname><given-names>Highlights</given-names></name></person-group><article-title>Potential anti-inflammatory role of paracetamol in knee OA</article-title><source>Nat Clin Pract Rheumatl</source><year>2007</year><volume>3</volume><fpage>67</fpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kearney</surname><given-names>PM</given-names></name><name><surname>Baigent</surname><given-names>C</given-names></name><name><surname>Godwin</surname><given-names>J</given-names></name><name><surname>Halls</surname><given-names>H</given-names></name><name><surname>Emberson</surname><given-names>JR</given-names></name><name><surname>Patrono</surname><given-names>C</given-names></name></person-group><article-title>Do selective cyclo-oxygenase-2 inhibitors and traditional non-steroidal anti-inflammatory drugs increase the risk of atherothrombosis? Meta-analysis of randomised trials</article-title><source>BMJ</source><year>2006</year><volume>332</volume><fpage>1302</fpage><pub-id pub-id-type="pmid">16740558</pub-id><pub-id pub-id-type="doi">10.1136/bmj.332.7553.1302</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Watson</surname><given-names>DJ</given-names></name><name><surname>Harper</surname><given-names>SE</given-names></name><name><surname>Zhao</surname><given-names>PL</given-names></name><name><surname>Quan</surname><given-names>H</given-names></name><name><surname>Bolognese</surname><given-names>JA</given-names></name><name><surname>Simon</surname><given-names>TJ</given-names></name></person-group><article-title>Gastrointestinal tolerability of the selective cyclooxygenase-2 (COX-2) inhibitor rofecoxib compared with nonselective COX-1 and COX-2 inhibitors in osteoarthritis</article-title><source>Arch Intern Med</source><