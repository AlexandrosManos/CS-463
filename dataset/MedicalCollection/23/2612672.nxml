><person-group person-group-type="author"><name><surname>Bratengeier</surname><given-names>K</given-names></name></person-group><article-title>2-Step IMAT and 2-Step IMRT in three dimensions</article-title><source>Med Phys</source><year>2005</year><volume>32</volume><fpage>3849</fpage><lpage>3861</lpage><pub-id pub-id-type="pmid">16475785</pub-id><pub-id pub-id-type="doi">10.1118/1.2134928</pub-id></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bratengeier</surname><given-names>K</given-names></name></person-group><article-title>IMRT Segment Predefinition using 2-Step IMRT</article-title><source>Radiother Oncol</source><year>2005</year><volume>84</volume><publisher-name>8th Biennial ESTRO meeting on Physics and Radiation Technology for Clinical Radiotherapy; Lisboa</publisher-name><fpage>S190</fpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brahme</surname><given-names>A</given-names></name><name><surname>Roos</surname><given-names>JE</given-names></name><name><surname>Lax</surname><given-names>I</given-names></name></person-group><article-title>Solution of an integral equation encountered in rotation therapy</article-title><source>Phys Med Biol</source><year>1982</year><volume>27</volume><fpage>1221</fpage><lpage>1229</lpage><pub-id pub-id-type="pmid">7146095</pub-id><pub-id pub-id-type="doi">10.1088/0031-9155/27/10/002</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Alber</surname><given-names>M</given-names></name><name><surname>Nusslin</surname><given-names>F</given-names></name></person-group><article-title>Optimization of intensity modulated radiotherapy under constraints for static and dynamic MLC delivery</article-title><source>Phys Med Biol</source><year>2001</year><volume>46</volume><fpage>3229</fpage><lpage>3239</lpage><pub-id pu