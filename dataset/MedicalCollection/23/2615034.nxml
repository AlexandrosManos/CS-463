me><surname>Furlong</surname><given-names>MA</given-names></name><name><surname>Fanburg-Smith</surname><given-names>JC</given-names></name><name><surname>Childers</surname><given-names>EL</given-names></name></person-group><article-title>Lipoma of the oral and maxillofacial region: site and subclassification of 125 cases</article-title><source>Oral Surg Oral Med Oral Pathol Oral Radiol Endod</source><year>2004</year><volume>98</volume><fpage>441</fpage><lpage>450</lpage><pub-id pub-id-type="pmid">15472660</pub-id><pub-id pub-id-type="doi">10.1016/j.tripleo.2004.02.071</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>de Visscher</surname><given-names>JG</given-names></name></person-group><article-title>Lipomas and fibrolipomas of the oral cavity</article-title><source>J Maxillofac Surg</source><year>1982</year><volume>10</volume><fpage>177</fpage><lpage>181</lpage><pub-id pub-id-type="pmid">6957523</pub-id><pub-id pub-id-type="doi">10.1016/S0301-0503(82)80036-2</pub-id></citation></ref><ref id="B8"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Fletcher</surname><given-names>C</given-names></name><name><surname>Unni</surname><given-names>K</given-names></name><name><surname>Mertens</surname><given-names>F</given-names></name></person-group><article-title>Adipocytic tumors</article-title><source>Pathology and Genetics of Tumors of Soft Tissue and Bone World Health Organization Classification of Tumors</source><year>2002</year><publisher-name>Lyon, France: IARC Press</publisher-name><fpage>9</fpage><lpage>46</lpage></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kacker</surname><given-names>A</given-names></name><name><surname>Taskin</surname><given-names>M</given-names></name></person-group><article-title>Atypical intramuscular lipomas of the tongue</article-title><source>J Laryng