ce><year>2004</year><volume>33</volume><fpage>72</fpage><lpage>76</lpage><pub-id pub-id-type="pmid">15389313</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Anavi</surname><given-names>Y</given-names></name><name><surname>Gross</surname><given-names>M</given-names></name><name><surname>Calderon</surname><given-names>S</given-names></name></person-group><article-title>Disturbed lower denture stability due to lipoma in the floor of the mouth</article-title><source>J Oral Rehabil</source><year>1995</year><volume>22</volume><fpage>83</fpage><lpage>85</lpage><pub-id pub-id-type="pmid">7897564</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2842.1995.tb00215.x</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Flaitz</surname><given-names>CM</given-names></name></person-group><article-title>Oral lymphoepithelial cysts in a young child</article-title><source>Pediatr Dent</source><year>2000</year><volume>22</volume><fpage>422</fpage><lpage>423</lpage><pub-id pub-id-type="pmid">11048314</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Longo</surname><given-names>F</given-names></name><name><surname>Maremonti</surname><given-names>P</given-names></name><name><surname>Mangone</surname><given-names>GM</given-names></name><name><surname>De Maria</surname><given-names>G</given-names></name><name><surname>Califano</surname><given-names>L</given-names></name></person-group><article-title>Midline (dermoid) cysts of the floor of the mouth: report of 16 cases and review of surgical techniques</article-title><source>Plast Reconstr Surg</source><year>2003</year><volume>112</volume><fpage>1560</fpage><lpage>1565</lpage><pub-id pub-id-type="pmid">14578785</pub-id><pub-id pub-id-type="doi">10.1097/01.PRS.0000086735.56187.22</pub-id></citation></ref></ref-list></back></article>