ent-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hickey</surname><given-names>MS</given-names></name><name><surname>Kiernan</surname><given-names>GJ</given-names></name><name><surname>Weaver</surname><given-names>KE</given-names></name></person-group><article-title>Evaluation of abdominal pain</article-title><source>Emerg Med Clin North Am</source><year>1989</year><volume>7</volume><fpage>437</fpage><lpage>452</lpage><pub-id pub-id-type="pmid">2663451</pub-id></element-citation></ref><ref id="b12-ijgm-5-789"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Feinstein</surname><given-names>B</given-names></name><name><surname>Langton</surname><given-names>JNK</given-names></name><name><surname>Jameson</surname><given-names>RM</given-names></name><etal/></person-group><article-title>Experiments on pain referred from deep somatic tissues</article-title><source>J Bone Joint Surg Am</source><year>1954</year><volume>36</volume><fpage>981</fpage><lpage>997</lpage><pub-id pub-id-type="pmid">13211692</pub-id></element-citation></ref><ref id="b13-ijgm-5-789"><label>13</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Silen</surname><given-names>W</given-names></name></person-group><article-title>Cholecystitis and other causes of acute pain in the right upper quadrant of the abdomen</article-title><source>Cope&#x02019;s Early Diagnosis of the Acute Abdomen</source><publisher-loc>New York</publisher-loc><publisher-name>Oxford</publisher-name><year>2010</year><fpage>131</fpage><lpage>140</lpage></element-citation></ref><ref id="b14-ijgm-5-789"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Giamberardino</surname><given-names>MA</given-names></name><name><surname>De Laurentis</surname><given-names>S</given-names></name><name><surname>Affaitati</surname><given-names>G</given-names></name><etal/></person-group><article-title>Modulation of pain and hyperalgesia from the urinary tract by algogenic conditions of the reproductive organs in women</article-title><source>Neurosci Lett</source><year>2001</year><volume>304</volume><issue>1&#x02013;2</issue><fpage>61</fpage><lpage>64</lpage><pub-id pub-id-type="pmid">11335055</pub-id></element-citation></ref><ref id="b15-ijgm-5-789"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wagner</surname><given-names>JM</given-names></name><name><surname>McKinney</surname><given-names>WP</given-names></name><name><surname>Carpenter</surname><given-names>JL</given-names></name></person-group><article-title>Does this patient have appendicitis?</article-title><source>JAMA</source><year>1996</year><volume>2786</volume><fpage>1589</fpage><lpage>1594</lpage><pub-id pub-id-type="pmid">8918857</pub-id></element-citation></ref><ref id="b16-ijgm-5-789"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kraemer</surname><given-names>M</given-names></name><name><surname>Franke</surname><given-names>C</given-names></name><name><surname>Ohmann</surname><given-names>C</given-names></name><etal/></person-group><article-title>Acute appendicitis in late adulthood: incidence, presentation, and outcome. Results of a prospective multicenter acute abdominal pain study and a review for the literature</article-title><source>Arch Surg</source><year>2000</year><volume>3835</volume><fpage>470</fpage><lpage>481</lpage></element-citation></ref><ref id="b17-ijgm-5-789"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Brewer</surname><given-names>RJ</given-names></name><name><surname>Golden</surname><given-names>GT</given-names></name><name><surname>Hitch</surname><given-names>DC</given-names></name><et