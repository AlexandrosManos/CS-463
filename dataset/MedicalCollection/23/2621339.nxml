><year>2005</year><article-title>Legislation for smoke-free workplaces and health of bar workers in Ireland: before and after study</article-title><source>BMJ</source><volume>331</volume><fpage>1117</fpage><lpage>1120</lpage><pub-id pub-id-type="pmid">16230313</pub-id></citation></ref><ref id="pone.0004244-Mulcahy1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mulcahy</surname><given-names>M</given-names></name><name><surname>Evans</surname><given-names>DS</given-names></name><name><surname>Hammond</surname><given-names>SK</given-names></name><name><surname>Repace</surname><given-names>JL</given-names></name><name><surname>Byrne</surname><given-names>M</given-names></name></person-group><year>2005</year><article-title>Secondhand smoke exposure and risk following the Irish smoking ban: an assessment of salivary cotinine concentrations in hotel workers and air nicotine levels in bars</article-title><source>Tob Control</source><volume>14</volume><fpage>384</fpage><lpage>388</lpage><pub-id pub-id-type="pmid">16319361</pub-id></citation></ref><ref id="pone.0004244-Ellingsen1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ellingsen</surname><given-names>DG</given-names></name><name><surname>Fladseth</surname><given-names>G</given-names></name><name><surname>Daae</surname><given-names>HL</given-names></name><name><surname>Gj&#x000f8;lstad</surname><given-names>M</given-names></name><name><surname>Hj&#x000e6;rheim</surname><given-names>K</given-names></name><etal/></person-group><year>2006</year><article-title>Airborne exposure and biological monitoring of bar and restaurant workers before and after the introduction of a smoking ban.</article-title><source>J Environ Monit</source><volume>8</volume><fpage>362</fpage><lpage>368</lpage><pub-id pub-id-type="pmid">16528420</pub-id></citation></ref><ref id="pone.0004244-Abrams1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Abrams</surname><given-names>SM</given-names></name><name><surname>Mahoney</surname><given-names>MC</given-names></name><name><surname>Hyland</surname><given-names>A</given-names></name><name><surname>Cummings</surname><given-names>KM</given-names></name><name><surname>Davis</surname><given-names>W</given-names></name><etal/></person-group><year>2006</year><article-title>Early evidence on the effectiveness of clean indoor air legislation in New York State</article-title><source>Am J Public Health</source><volume>96</volume><fpage>296</fpage><lpage>298</lpage><pub-id pub-id-type="pmid">16380571</pub-id></citation></ref><ref id="pone.0004244-Hahn1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hahn</surname><given-names>EJ</given-names></name><name><surname>Rayens</surname><given-names>MK</given-names></name><name><surname>York</surname><given-names>N</given-names></name><name><surname>Okoli</surname><given-names>CT</given-names></name><name><surname>Zhang</surname><given-names>M</given-names></name><etal/></person-group><year>2006</year><article-title>Effects of a smoke-free law on hair nicotine and respiratory symptoms of restaurant and bar workers.</article-title><source>J Occup Environ Med</source><volume>48</volume><fpage>906</fpage><lpage>913</lpage><pub-id pub-id-type="pmid">16966957</pub-id></citation></ref><ref id="pone.0004244-Menzies1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Menzies</surname><given-names>D</given-names></name><name><surname>Nair</surname><given-names>A</given-names></name><name><surname>Williamson</surname><given-names>PA</given-names></name><name><surname>Schembri</surname><given-names>S</given-names></name><name><surname>Al-Khairalla</surname><given-names>MZH</given-names></name><etal/></person-group><year>2006</year><article-title>Respiratory symptoms, pulmonary function, and markers of inflammation among bar workers before and after a legislative ban on smoking in public places.</article-title><source>JAMA</source><volume>296</volume><fpage>1742</fpage><lpage>1748</lpage><pub-id pub-id-type="pmid">17032987</pub-id></citation></ref><ref id="pone.0004244-Goodman1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goodman</surname><given-names>P</given-names></name><name><surname>Agnew</surname><given-names>M</given-names></name><name><surname>McCaffrey</surname><given-names>M</given-names></name><name><surname>Paul</surname><given-names>G</given-names></name><name><surname>Clancy</surname><given-names>L</given-names></name></person-group><year>2007</year><article-title>Effects of the Irish smoking ban on respiratory health of bar workers and air quality in Dublin pubs.</article-title><source>Am J Resp Crit Care Med</source><volume>175</volume><fpage>840</fpage><lpage>845</lpage><pub-id pub-id-type="pmid">17204724</pub-id></citation></ref><ref id="pone.0004244-Valente1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Valente</surname><given-names>P</given-names></name><name><surname>Forastiere</surname><given-names>F</given-names></name><name><surname>Bacosi</surname><given-names>A</given-names></name><name><surname>Cattani</surname><given-names>G</given-names></name><name><surname>DiCarlo</surname><given-names>S</given-names></name><etal/></person-group><year>2007</year><article-title>Exposure to fine and ultrafine particles from secondhand smoke in public places before and after the smoking ban, Italy 2005.</article-title><source>Tob Control</source><volume>16</volume><fpage>312</fpage><lpage>317</lpage><pub-id pub-id-type="pmid">17897989</pub-id></citation></ref><ref id="pone.0004244-Semple1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"