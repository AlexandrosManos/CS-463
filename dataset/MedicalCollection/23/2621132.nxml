>Am J Gastroenterol</source><year>1989</year><volume>84</volume><fpage>1115</fpage><lpage>1119</lpage><pub-id pub-id-type="pmid">2672792</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roggli</surname><given-names>VL</given-names></name><name><surname>Kim</surname><given-names>HS</given-names></name><name><surname>Hawkins</surname><given-names>E</given-names></name></person-group><article-title>Congenital generalized fibromatosis with visceral involvement: a case report</article-title><source>Cancer</source><year>1980</year><volume>45</volume><fpage>954</fpage><lpage>960</lpage><pub-id pub-id-type="pmid">7260846</pub-id><pub-id pub-id-type="doi">10.1002/1097-0142(19800301)45:5&#x0003c;954::AID-CNCR2820450520&#x0003e;3.0.CO;2-Q</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dessanti</surname><given-names>A</given-names></name><name><surname>Massarelli</surname><given-names>G</given-names></name><name><surname>Bosincu</surname><given-names>L</given-names></name><name><surname>Canu</surname><given-names>L</given-names></name><name><surname>Nova</surname><given-names>G</given-names></name><name><surname>Dettori</surname><given-names>G</given-names></name></person-group><article-title>Aggressive congenital fibromatosis of the small intestine in the newborn: report of a case and review of literature</article-title><source>Eur J Pediatr Surg</source><year>1999</year><volume>9</volume><fpage>422</fpage><lpage>425</lpage><pub-id pub-id-type="pmid">10661858</pub-id><pub-id pub-id-type="doi">10.1055/s-2008-1072298</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Numanoglu</surname><given-names>A</given-names></name><name><surname>Davies</surname><given-names>J</given-names></name><name><surname>Milar</surname><given-names>AJ</given-names></