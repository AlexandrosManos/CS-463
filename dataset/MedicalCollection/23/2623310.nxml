roup><year>2004</year><source>NCI Thesaurus: Using science-based terminology to integrate cancer research results</source><conf-name>Proc. Medinfo 2004</conf-name><conf-loc>San Francisco, CA</conf-loc><fpage>33</fpage><lpage>7</lpage></mixed-citation></ref><ref id="b8-cin-6-0293"><mixed-citation publication-type="confproc"><person-group person-group-type="author"><name><surname>Dolin</surname><given-names>RH</given-names></name><name><surname>Mattison</surname><given-names>JE</given-names></name><name><surname>Cohn</surname><given-names>S</given-names></name><etal/></person-group><person-group person-group-type="editor"><name><surname>Fieschi</surname><given-names>M</given-names></name><name><surname>Coiera</surname><given-names>E</given-names></name><name><surname>Li</surname><given-names>Y-C</given-names></name></person-group><year>2004</year><source>Kaiser Permanente&#x02019;s Convergent Medical Terminology</source><conf-name>Proc. Medinfo 2004</conf-name><conf-loc>San Francisco, CA</conf-loc><fpage>346</fpage><lpage>50</lpage></mixed-citation></ref><ref id="b9-cin-6-0293"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Druss</surname><given-names>BG</given-names></name><name><surname>Marcus</surname><given-names>SC</given-names></name></person-group><year>2005</year><article-title>Growth and decentralization of the medical literature: implications for evidence-based medicine</article-title><source>J. Med. Libr. Assoc</source><volume>93</volume><issue>4</issue><fpage>499</fpage><lpage>501</lpage><pub-id pub-id-type="pmid">16239948</pub-id></mixed-citation></ref><ref id="b10-cin-6-0293"><mixed-citation publication-type="web"><collab>EMBL</collab><date-in-citation>(2007 Sept. 5 (accessed)</date-in-citation><source>EMBL Nucleotide Sequence Database</source><comment>URL: <ext-link ext-link-type="uri" xlink:href="http://www.ebi.ac.uk/embl">http://www.ebi.ac.uk/embl</ext-link></comment></mixed-citation></ref><ref id="b11-cin-6-0293"><mixed-citation publication-type="web"><collab>Entrez Gene</collab><date-in-citation>2008 Jan. 8 (accessed))</date-in-citation><source>Entrez Gene</source><comment>URL: <ext-link ext-link-type="uri" xlink:href="http://www.ncbi.nlm.nih.gov/sites/entrez?db=ene">http://www.ncbi.nlm.nih.gov/sites/entrez?db=ene</ext-link></comment></mixed-citation></ref><ref id="b12-cin-6-0293"><mixed-citation publication-type="web"><collab>GenBank</collab><date-in-citation>2007 Aug. 23 (accessed))</date-in-citation><source>GenBank overview</source><comment>URL: <ext-link ext-link-type="uri" xlink:href="http://www.ncbi.nlm.nih.gov/Genbank">http://www.ncbi.nlm.nih.gov/Genbank</ext-link></comment></mixed-citation></ref><ref id="b13-cin-6-0293"><mixed-citation publication-type="book"><person-group person-group-type="author"><name><surname>Golbeck</surname><given-names>J</given-names></name><name><surname>Fragoso</surname><given-names>G</given-names></name><name><surname>Hartel</surname><given-names>FW</given-names></name><name><surname>Hendler</surname><given-names>J</given-names></name><name><surname>Parsia</surname><given-names>B</given-names></name><name><surname>Oberthaler</surname><given-names>J</given-names></name></person-group><year>2003</year><publisher-loc>The</publisher-loc><publisher-name>National Cancer Institute</publisher-name><article-title>&#x02019;s thesaurus and ontology</article-title><source>Journal of Web Semantics</source><volume>1</volume><issue>1</issue></mixed-citation></ref><ref id="b14-cin-6-0293"><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Hartel</surname><given-names>FW</given-names></name><name><surname>de Coronado</surname><given-names>S</given-names></name><name><surname>Dionne</surname><given-names>R</given-names></name><name><surname>Fragoso</surname><given-names>G</given-names></name><name><surname>Golbeck</surname><given-names>J</given-names></name></person-group><year>2005</year><arti