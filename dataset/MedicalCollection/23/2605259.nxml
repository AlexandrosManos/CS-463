></ref><ref id="pone.0004058-Mitchell1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mitchell</surname><given-names>GF</given-names></name><name><surname>Garcia</surname><given-names>EG</given-names></name><name><surname>Wood</surname><given-names>SM</given-names></name><name><surname>Diasanta</surname><given-names>R</given-names></name><name><surname>Almonte</surname><given-names>R</given-names></name><etal/></person-group><year>1990</year><article-title>Studies on the sex ratio of worms in schistosome infection.</article-title><source>Parasitology</source><volume>101</volume><fpage>27</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">2122397</pub-id></citation></ref><ref id="pone.0004058-Ho1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ho</surname><given-names>YH</given-names></name><name><surname>He</surname><given-names>YX</given-names></name></person-group><year>1963</year><article-title>On the host specificity of <italic>Schistosoma japonicum</italic>.</article-title><source>Chin Med J</source><volume>82</volume><fpage>403</fpage><lpage>414</lpage></citation></ref><ref id="pone.0004058-Guo1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Guo</surname><given-names>J</given-names></name><name><surname>Li</surname><given-names>Y</given-names></name><name><surname>Gray</surname><given-names>D</given-names></name><name><surname>Ning</surname><given-names>A</given-names></name><name><surname>Hu</surname><given-names>G</given-names></name><etal/></person-group><year>2006</year><article-title>A drug-based intervention study on the importance of buffaloes for human <italic>Schistosoma japonicum</italic> infection around Poyang Lake, People's Republic of China.</article-title><source>Am J Trop Med Hyg</source><volume>74</volume><fpage>335</fpage><lpage>341</lpage><pub-id pub-id-type="pmi