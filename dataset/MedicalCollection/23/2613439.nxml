-type="author"><name><surname>Bults</surname><given-names>R</given-names></name><name><surname>Wac</surname><given-names>K</given-names></name><name><surname>van Halteren</surname><given-names>A</given-names></name><name><surname>Nicola</surname><given-names>V</given-names></name><name><surname>Konstantas</surname><given-names>D</given-names></name></person-group><article-title>Goodput analysis of 3G wireless networks supporting m-health services</article-title><conf-name>In: Proceedings of the 8th International Conference on Telecommunications (ConTEL '05), vol. 1</conf-name><conf-date>June 2005</conf-date><conf-loc>Zagreb, Croatia</conf-loc><fpage>99</fpage><lpage>106</lpage></citation></ref><ref id="B11"><label>11</label><citation citation-type="confproc"><person-group person-group-type="author"><name><surname>Courreges</surname><given-names>F</given-names></name><name><surname>Vieyres</surname><given-names>P</given-names></name><name><surname>Istepanian</surname><given-names>RSH</given-names></name></person-group><article-title>Advances in robotic tele-echography services&#x02014;the OTELO system</article-title><conf-name>In: Proceedings of the 26th Annual International Conference of the IEEE Engineering in Medicine and Biology Society (EMBC '04), vol. 7</conf-name><conf-date>September 2004</conf-date><conf-loc>Francisco, Calif, USA</conf-loc><fpage>5371</fpage><lpage>5374</lpage></citation></ref><ref id="B12"><label>12</label><citation citation-type="other"><article-title>3rd Generation Partnership Project</article-title><comment>February 2008, <ext-link ext-link-type="uri" xlink:href="http://www.3gpp.org/">http://www.3gpp.org/</ext-link>.</comment></citation></ref><ref id="B13"><label>13</label><citation citation-type="other"><collab>3GPP TS 25.308</collab><article-title>High Speed Downlink Packet Access</article-title><comment>Overall Description; Stage 2, v6.3.0, 2004</comment></citation></ref><ref id="B14"><label>14</label><citation citation-type="other"><collab>3GPP TR 25.896</collab><article-title>Feasibility Study for Enhanced Uplink for UTRA FDD</article-title><comment>Release 6, v6.0.0, 2004</comment></citation></ref><ref id="B15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Holma</surname><given-names>H</given-names></name><name><surname>Toskala</surname><given-names>A</given-names></name><name><surname>Ranta-aho</surname><given-names>K</given-names></name><name><surname>Pirskanen</surname><given-names>J</given-names></name></person-group><article-title>High-speed packet access evolution in 3GPP release 7 [Topics in radio communications]</article-title><source><italic>IEEE Communications Magazine</italic></source><year>2007</year><volume>45</volume><issue>12</issue><fpage>29</fpage><lpage>35</lpage></citation></ref><ref id="B16"><label>16</label><citation citation-type="book"><person-group person-group-type="editor"><name><surname>Holma</surname><given-names>H</given-names></name><name><surname>Toskala</surname><given-names>A</given-names></name></person-group><source><italic>HSDPA/HSUPA for UMTS</italic></source><year>2006</year><publisher-loc>New York, NY, USA</publisher-loc><publisher-name>John Wiley &#x00026; Sons</publisher-name></citation></ref><ref id="B17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ackerman</surname><given-names>M</given-names></name><name><surname>Craft</surname><given-names>R</given-names></name><name><surname>Ferrante</surname><given-names>F</given-names></name><name><surname>Kratz</surname><given-names>M</given-names></name><name><surname>Mandil</surname><given-names>S</given-names></name><name><surname>Sapci</surname><given-names>H</given-names></name></person-group><article-title>Chapter 6: telemedicine technology</article-title><source><italic>Telemedicine Journal and e-Health</italic></source><year>2002</year><volume>8</volume><issue>1</issue><fpage>71</fpage><lpage>78</lpage><pub-id pub-id-type="pmid">12020407</pub-id></citation></ref><ref id="B18"><label>18</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Maglogiannis</surname><given-names>I</given-names></name><name><surname>Karpouzis</surname><given-names>K</given-names></name><name><surname>Wallace</surname><given-names>M</given-names></name></person-group><source><italic>Image, Signal and Distributed Data Processing for Networked eHealth Applications</italic></source><year>2006</year><publisher-loc>San Rafael, Calif, USA</publisher-loc><publisher-name>Morgan &#x00026; Claypool</publisher-name><series>Lectures in Biomedical Engineering</series></citation></ref><ref id="B19"><label>19</label><citation citation-type="other"><collab>International Telecommunication Union, Telecommunication Development Bureau, ITU-D Study Group 2</collab><article-title>Question 14-1/2: application of telecommunications in health care, technical information&#x02014;a mobile medical image transmission system in Japan</article-title><comment>PocketMIMAS.  Rapporteurs Meeting Q14-1/2 Japan, 2004</comment></citation></ref><ref id="B20"><label>20</label><citation citation-type="confproc"><person-group person-group-type="author"><name><surname>LeRouge</surname><given-names>C</given-names></name><name><surname>Garfield</surname><given-names>MJ</given-names></name><name><surname>Hevner</surname><given-names>AR</given-names></name></person-group><article-title>Quality attributes in telemedicine video conferencing</article-title><conf-name>In: Proceedings of the 35th Hawaii International Conference on System Sciences (HICSS '02), vol. 6</conf-name><conf-date>January 2002</conf-date><conf-loc>Big Island, Hawaii, USA</conf-loc></citation></ref><ref id="B21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Istepanian</surname><given-names>RSH</given-names></name><name><surname>Jovanov</surname><given-names>E</given-names></name><name><surname>Zhang</surname><given-names>YT</given-names></name></person-group><article-title>Guest editorial introduction to the special section on m-health: beyond seamless mobility and global wireless health-care connectivity</article-title><source><italic>IEEE Transactions on Information Technology in Biomedicine</italic></source><year>2004</year><volume>8</volume><issue>4</issue><fpage>405</fpage><lpage>414</lpage><pub-id pub-id-type="pmid">15615031</pub-id></citation></ref><ref id="B22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maglogiannis</surname><given-names>I</given-names></name><name><surname>Delakouridis</surname><given-names>C</given-names></name><name><surname>Kazatzopoulos</surname><given-names>L</given-names></name></person-group><article-title>Enabling collaborative medical diagnosis over the Internet via peer-to-peer distribution of electronic health records</article-title><source><italic>Journal of Medical Systems</italic></source><year>2006</year><volume>30</volume><issue>2</issue><fpage>107</fpage><lpage>116</lpage><pub-id pub-id-type="pmid">16705995</pub-id></citation></ref><ref id="B23"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maglogiannis</surname><given-names>I</given-names></name><name><surname>Doukas</surname><given-names>C</given-names></name><name><surname>Kormentzas</surname><given-names>G</given-names></name><name><surname>Pliakas</surname><given-names>T</given-names></name></person-group><article-title>Wavelet based compression with ROI coding  support for mobile access to DICOM images over heterogeneous radio networks</article-title><comment>to appear in <italic>IEEE Transactions on Information Technology in Biomedicine</italic></comment></citation></ref><ref id="B24"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vouyioukas</surname><given-names>D</given-names></name><name><surname>Maglogiannis</surname><given-names>I</given-names></name><name><surname>Komnakos</surname><given-names>D</given-names></name></person-group><article-title>Emergency m-health services through high-speed 3G systems: simulation and performance evaluation</article-title><source><italic>Simulation</italic></source><year>2007</year><volume>83</volume><issue>4</issue><fpage>329</fpage><lpage>345</lpage></citation></ref><ref id="B25"><label>25</label><citation citation-type="confproc"><person-group person-group-type="author"><name><surname>Komnakos</surname><given-names>D</given-names></name><name><surname>Constantinou</surname><given-names>P</given-names></name><name><surname>Vouyioukas</surname><given-names>D</given-names></name><name><surname>Maglogiannis</surname><given-names>I</given-names></name></person-group><article-title>QOS study performance of an integrated satellite telemedicine platform</article-title><conf-name>In: Proceedings of the 18th Annual IEEE International Symposium on Personal, Indoor and Mobile Radio Communications (PIMRC '07)</conf-name><conf-date>September 2007</conf-date><conf-loc>Athens, Greece</conf-loc><fpage>1</fpage><lpage>5</lpage></citation></ref><ref id="B26"><label>26</label><citation citation-type="other"><collab>OPNET</collab><comment>February 2008, <ext-link ext-link-type="uri" xlink:href="http://www.opnet.com/">http://www.opnet.com/</ext-link>.</comment></citation></ref><ref id="B27"><label>27</label><citation citation-type="gov"><collab>ETSI</collab><article-title>Universal Mobile Telecommunications System (UMTS); selection procedures for the choice of radio transmission technologies of the UMTS</article-title><year>1998</year><publisher-loc>Sophia Antipolis, France</publisher-loc><publisher-name>European Telecommunications Standards Institute</publisher-name><comment>Tech. Rep. 101 112 V3.2.0.</comment></citation></ref><ref id="B28"><label>28</label><citation