oup person-group-type="author"><name><surname>Endicott</surname><given-names>J</given-names></name><name><surname>Russell</surname><given-names>JM</given-names></name><name><surname>Raskin</surname><given-names>J</given-names></name><etal/></person-group><year>2007</year><article-title>Duloxetine treatment for role functioning improvement in generalized anxiety disorder: three independent studies</article-title><source>J Clin Psychiatry</source><volume>68</volume><fpage>518</fpage><lpage>24</lpage><pub-id pub-id-type="pmid">17474806</pub-id></citation></ref><ref id="b14-ndt-4-929"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Engleman</surname><given-names>ES</given-names></name><name><surname>Perry</surname><given-names>KW</given-names></name><name><surname>Mayle</surname><given-names>DA</given-names></name><etal/></person-group><year>1995</year><article-title>Simultaneous increases of extracellular monoamines in microdyalisates from hypothalamus of conscious rats by duloxetine, a dual serotonin and norepinephrine uptake inhibitor</article-title><source>Neuropsychopharmacology</source><volume>12</volume><fpage>287</fpage><lpage>95</lpage><pub-id pub-id-type="pmid">7576005</pub-id></citation></ref><ref id="b15-ndt-4-929"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fava</surname><given-names>M</given-names></name><name><surname>Martinez</surname><given-names>JM</given-names></name><name><surname>Greist</surname><given-names>J</given-names></name><etal/></person-group><year>2007</year><article-title>The efficacy and tolerability of duloxetine in the treatment of anxious versus nonanxious depression: a post-hoc analysis of an open-label outpatient study</article-title><source>Ann Clin Psychiatry</source><volume>19</volume><fpage>187</fpage><lpage>95</lpage><pub-id pub-id-type="pmid">17729021</pub-id></citation></ref><ref id="b16-ndt-4-929"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Frampton</surname><given-names>JE</given-names></name><name><surname>Plosker</surname><given-names>GL</given-names></name></person-group><year>2007</year><article-title>Duloxetine: a review of its use in the treatment of major depressive disorder</article-title><source>CNS Drugs</source><volume>21</volume><fpage>581</fpage><lpage>609</lpage><pub-id pub-id-type="pmid">17579500</pub-id></citation></ref><ref id="b17-ndt-4-929"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fuller</surname><given-names>RW</given-names></name><name><surname>Hemrick-Luecke</surname><given-names>SK</given-names></name><name><surname>Snoddy</surname><given-names>HD</given-names></name></person-group><year>1994</year><article-title>Effects of duloxetine, an antidepressant drug candidate, on concentrations of monoamines and their metabolites in rats and mice</article-title><source>J Pharmacol Exp Ther</source><volume>269</volume><fpage>132</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">7513356</pub-id></citation></ref><ref id="b18-ndt-4-929"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gambi</surname><given-names>F</given-names></name><name><surname>De Berardis</surname><given-names>D</given-names></name><name><surname>Campanella</surname><given-names>D</given-names></name><etal/></person-group><year>2005</year><article-title>Mirtazapine treatment of generalized anxiety disorder: a fixed dose, open label study</article-title><source>J Psychopharmacol</source><volume>19</volume><fpage>483</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">16166185</pub-id></citation></ref><ref id="b19-ndt-4-929"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goodman</surname><given-names>WK</given-names></name></person-group><year>2004</year><article-title>Selecting pharmacotherapy for generalized anxiety disorder</article-title><source>J Clin Psychiatry</source><volume>65</volume><fpage>8</fpage><lpage>13</lpage><pub-id pub-id-type="pmid">15384931</pub-id></citation></ref><ref id="b20-ndt-4-929"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Graeff</surname><given-names>FG</given-names></name><name><surname>Viana</surname><given-names>MB</given-names></name><name><surname>Mora</surname><given-names>PO</given-names></name></person-group><year>1997</year><article-title>Dual role of 5-HT in defense and anxiety</article-title><source>Neurosci Biobehav Rev</source><volume>21</volume><fpage>791</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">9415904</pub-id></citation></ref><ref id="b21-ndt-4-929"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Greenberg</surname><given-names>PE</given-names></name><name><surname>Sisitsky</surname><given-names>T</given-names></name><name><surname>Kessler</surname><given-names>RC</given-names></name><etal/></person-group><year>1999</year><article-title>The economic burden of anxiety disorders in the 1990s</article-title><source>J Clin Psychiatry</source><volume>60</volume><fpage>427</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">10453795</pub-id></citation></ref><ref id="b22-ndt-4-929"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hanretta</surname><given-names>AT</given-names></name><name><surname>Malek-Ahmadi</surname><given-names>P</given-names></name></person-group><year>2007</year><article-title>Combined Use of ECT with Duloxetine and Olanzapine: A Case Report</article-title><source>J ECT</source><volume>22</volume><fpage>139</fpage><lpage>41</lpage><pub-id pub-id-type="pmid">16801831</pub-id></citation></ref><ref id="b23-ndt-4-929"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hariri</surname><given-names>AR</given-names></name><name><surname>Mattay</surname><given-names>VS</given-na