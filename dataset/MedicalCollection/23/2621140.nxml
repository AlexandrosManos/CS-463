9768895</pub-id><pub-id pub-id-type="doi">10.1302/0301-620X.80B5.8657</pub-id></citation></ref><ref id="B6"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Watson-Jones</surname><given-names>R</given-names></name></person-group><source>Fractures and Joint Injuries</source><year>1940</year><edition>First</edition><publisher-name>Williams &#x00026; Wilkins</publisher-name></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dewey</surname><given-names>P</given-names></name><name><surname>Browne</surname><given-names>PS</given-names></name></person-group><article-title>Fracture-dislocation of the lumbo-sacral spine with cauda equina lesion. Report of two cases</article-title><source>J Bone Joint Surg Br</source><year>1968</year><volume>50</volume><fpage>635</fpage><lpage>638</lpage><pub-id pub-id-type="pmid">5702056</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Samberg</surname><given-names>LC</given-names></name></person-group><article-title>Fracture-dislocation of the lumbosacral spine. A case report</article-title><source>J Bone Joint Surg Am</source><year>1975</year><volume>57</volume><fpage>1007</fpage><lpage>1008</lpage><pub-id pub-id-type="pmid">1184631</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boldin</surname><given-names>C</given-names></name><name><surname>Grechenig</surname><given-names>W</given-names></name><name><surname>Fankhauser</surname><given-names>F</given-names></name><name><surname>Sorantin</surname><given-names>E</given-names></name></person-group><article-title>Traumatic unilateral facet dislocation of the lumbosacral junction</article-title><source>Injury</source><year>2004</year><volume>35</volume><fpage>950</fpage><lpage>952</lpage><pub-id pub-id-type="pmid">15302256</pub-id