e><fpage>50176</fpage><lpage>50182</lpage><pub-id pub-id-type="pmid">12364327</pub-id></citation></ref><ref id="b12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chowdhury</surname><given-names>SF</given-names></name><name><surname>Villamor</surname><given-names>VB</given-names></name><name><surname>Guerrero</surname><given-names>RH</given-names></name><name><surname>Leal</surname><given-names>I</given-names></name><name><surname>Brun</surname><given-names>R</given-names></name><name><surname>Croft</surname><given-names>SL</given-names></name><etal/></person-group><article-title>Design, synthesis, and evaluation of inhibitors of trypanosomal and leishmanial dihydrofolate reductase</article-title><source>J Med Chem</source><year>1999</year><volume>42</volume><fpage>4300</fpage><lpage>4312</lpage><pub-id pub-id-type="pmid">10543874</pub-id></citation></ref><ref id="b13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clarke</surname><given-names>SJ</given-names></name><name><surname>Farrugia</surname><given-names>DC</given-names></name><name><surname>Aherne</surname><given-names>GW</given-names></name><name><surname>Pritchard</surname><given-names>DM</given-names></name><name><surname>Benstead</surname><given-names>J</given-names></name><name><surname>Jackman</surname><given-names>AL</given-names></name></person-group><article-title>Balb/c mice as a preclinical model for raltitrexed-induced gastrointestinal toxicity</article-title><source>Clin Cancer Res</source><year>2000</year><volume>6</volume><fpage>285</fpage><lpage>296</lpage><pub-id pub-id-type="pmid">10656460</pub-id></citation></ref><ref id="b14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cruz</surname><given-names>A</given-names></name><name><surname>Beverley</surname><given-names>SM</given-names></name></person-group><article-title>Gene replacement in parasitic protozoa</arti