></name><name><surname>Bosch</surname><given-names>JLHR</given-names></name><name><surname>Blom</surname><given-names>JHM</given-names></name><name><surname>Lycklama &#x000e0; Nijeholt</surname><given-names>AAB</given-names></name><name><surname>van Mastrigt</surname><given-names>R</given-names></name></person-group><article-title>Development of a non-invasive strategy to classify bladder outlet obstruction in male patients with LUTS</article-title><source><italic>Neurourology and Urodynamics</italic></source><year>2002</year><volume>21</volume><issue>2</issue><fpage>117</fpage><lpage>125</lpage><pub-id pub-id-type="pmid">11857664</pub-id></citation></ref><ref id="B7"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Walter</surname><given-names>JS</given-names></name><name><surname>Andros</surname><given-names>G</given-names></name><name><surname>Stokes</surname><given-names>S</given-names></name><etal/></person-group><article-title>Urodynamic verification of noninvasive back-pressure recordings from the urinary bladder</article-title><source><italic>Techniques in Urology</italic></source><year>1998</year><volume>4</volume><issue>4</issue><fpage>185</fpage><lpage>191</lpage><pub-id pub-id-type="pmid">9891999</pub-id></citation></ref><ref id="B8"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Griffiths</surname><given-names>CJ</given-names></name><name><surname>Rix</surname><given-names>D</given-names></name><name><surname>MacDonald</surname><given-names>AM</given-names></name><name><surname>Drinnan</surname><given-names>MJ</given-names></name><name><surname>Pickard</surname><given-names>RS</given-names></name><name><surname>Ramsden</surname><given-names>PD</given-names></name></person-group><article-title>Noninvasive measurement of bladder pressure by controlled inflation of a penile cuff</article-title><source><italic>The Journal of Urology</italic></