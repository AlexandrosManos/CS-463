>14</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Griffiths</surname><given-names>DJ</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Mundy</surname><given-names>AR</given-names></name><name><surname>Stephenson</surname><given-names>TP</given-names></name><name><surname>Wein</surname><given-names>AJ</given-names></name></person-group><article-title>Hydrodynamics and mechanics of the bladder and urethra</article-title><source><italic>Urodynamics: Principles, Practice and Application</italic></source><year>1994</year><edition>2nd edition</edition><publisher-loc>London, UK</publisher-loc><publisher-name>Churchill Livingstone</publisher-name><fpage>71</fpage><lpage>81</lpage></citation></ref><ref id="B15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schafer</surname><given-names>W</given-names></name></person-group><article-title>Urethral resistance? Urodynamic concepts of physiological and pathological bladder outlet function during voiding</article-title><source><italic>Neurourology and Urodynamics</italic></source><year>1985</year><volume>4</volume><issue>3</issue><fpage>161</fpage><lpage>201</lpage></citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schfer</surname><given-names>W</given-names></name><name><surname>Abrams</surname><given-names>P</given-names></name><name><surname>Liao</surname><given-names>L</given-names></name><etal/></person-group><article-title>Good urodynamic practices: uroflowmetry, filling cystometry, and pressure-flow studies</article-title><source><italic>Neurourology and Urodynamics</italic></source><year>2002</year><volume>21</volume><issue>3</issue><fpage>261</fpage><lpage>274</lpage><pub-id pub-id-type="pmid">11948720</pub-id></citation></ref><ref id="B17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McIntosh</surname><given-names>SL</given-names></name><name><surname>Drinnan</surname><given-names>MJ</given-names></name><name><surname>Pickard</surname><given-names>RS</given-names></name><name><surname>Robson</surname><given-names>WA</given-names></name><name><surname>Ramsden</surname><given-names>PD</given-names></name><name><surname>Griffiths</surname><given-names>CJ</given-names></name></person-group><article-title>Non-invasive bladder pressure monitoring&#x02014;how does interrupting the urinary stream affect intra-vesicle pressure?</article-title><source><italic>Neurourology and Urodynamics</italic></source><year>2001</year><volume>20</volume><fpage>382</fpage><lpage>386</lpage></citation></ref><ref id="B18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McIntosh</surname><given-names>SL</given-names></name><name><surname>Griffiths</surname><given-names>CJ</given-names></name><name><surname>Drinnan</surname><given-names>MJ</given-names></name><name><surname>Robson</surname><given-names>WA</given-names></name><name><surname>Ramsden</surname><given-names>PD</given-names></name><name><surname>Pickard</surname><given-names>RS</given-names></name></person-group><article-title>Noninvasive measurement of bladder pressure. Does mechanical interruption of the urinary stream inhibit detrusor contraction?</article-title><source><italic>The Journal of Urology</italic></source><year>2003</year><volume>169</volume><issue>3</issue><fpage>1003</fpage><lpage>1006</lpage><pub-id pub-id-type="pmid">12576831</pub-id></citation></ref><ref id="B19"><label>19</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Conover</surname><given-names>WJ</given-names></name></person-group><source><italic>Practical Nonparametric Statistics</italic></source><year>1971</year><publisher-loc>New York, NY, USA</publisher-loc><publisher-name>