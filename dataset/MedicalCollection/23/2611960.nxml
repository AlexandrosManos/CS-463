ype="journal"><person-group person-group-type="author"><name><surname>Crazzolara</surname><given-names>R</given-names></name><name><surname>Puelacher</surname><given-names>W</given-names></name><name><surname>Ninkovic</surname><given-names>M</given-names></name><name><surname>Zelger</surname><given-names>B</given-names></name><name><surname>Buchberger</surname><given-names>W</given-names></name><name><surname>Meister</surname><given-names>B</given-names></name><name><surname>Zimmerhackl</surname><given-names>LB</given-names></name><name><surname>Klein-Franke</surname><given-names>A</given-names></name></person-group><article-title>Teratocarcinosarcoma of the oral cavity</article-title><source>Pediatr Blood Cancer</source><year>2004</year><volume>43</volume><fpage>687</fpage><lpage>691</lpage><pub-id pub-id-type="pmid">15390296</pub-id><pub-id pub-id-type="doi">10.1002/pbc.20139</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>NM</given-names></name><name><surname>Chambers</surname><given-names>SE</given-names></name><name><surname>Billson</surname><given-names>VR</given-names></name><name><surname>Lang</surname><given-names>I</given-names></name><name><surname>West</surname><given-names>CP</given-names></name><name><surname>Bell</surname><given-names>JE</given-names></name></person-group><article-title>Oral teratoma (epignathus) with intracranial extension: a report of two cases</article-title><source>Prenat Diagn</source><year>1993</year><volume>13</volume><fpage>945</fpage><lpage>952</lpage><pub-id pub-id-type="pmid">8309901</pub-id><pub-id pub-id-type="doi">10.1002/pd.1970131008</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vandenhaute</surname><given-names>B</given-names></name><name><surname>Leteurtre</surname><given-names>E</given-names></name><name><surname>Lecomte-Houcke