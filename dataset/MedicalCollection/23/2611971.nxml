ntern Med</source><year>2001</year><volume>161</volume><fpage>1581</fpage><lpage>1586</lpage><pub-id pub-id-type="pmid">11434789</pub-id><pub-id pub-id-type="doi">10.1001/archinte.161.13.1581</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haslam</surname><given-names>DM</given-names></name><name><surname>James</surname><given-names>PW</given-names></name></person-group><article-title>Obesity</article-title><source>Lancet</source><year>2005</year><volume>366</volume><fpage>1197</fpage><lpage>1209</lpage><pub-id pub-id-type="pmid">16198769</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(05)67483-1</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Colleen</surname><given-names>D</given-names></name></person-group><article-title>Large-scale interventions and programmes addressing nutrition-related chronic diseases and obesity: examples from 14 countries</article-title><source>Public Health Nutr</source><year>2002</year><volume>5</volume><fpage>275</fpage><lpage>277</lpage><pub-id pub-id-type="pmid">12027295</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Flegal</surname><given-names>KM</given-names></name><name><surname>Graubard</surname><given-names>BI</given-names></name><name><surname>Williamson</surname><given-names>DF</given-names></name><name><surname>Gail</surname><given-names>MH</given-names></name></person-group><article-title>Excess deaths associated with underweight, overweight, and obesity</article-title><source>JAMA</source><year>2005</year><volume>293</volume><fpage>1861</fpage><lpage>1867</lpage><pub-id pub-id-type="pmid">15840860</pub-id><pub-id pub-id-type="doi">10.1001/jama.293.15.1861</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surnam