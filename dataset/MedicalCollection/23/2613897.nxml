><given-names>S</given-names></name><name><surname>Aydin</surname><given-names>R</given-names></name></person-group><article-title>Enterocutaneous fistula due to polypropylene mesh Migration</article-title><source>Irish Journal of Medical Science</source><volume>171</volume><pub-id pub-id-type="pmid">15736365</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morris-Stiff</surname><given-names>GJ</given-names></name><name><surname>Hughes</surname><given-names>LE</given-names></name></person-group><article-title>The outcomes of nonabsorbable Mesh placed within the abdominal cavity: literature review and clinical experience</article-title><source>J Am Coll Surg</source><year>1998</year><volume>186</volume><fpage>352</fpage><lpage>67</lpage><pub-id pub-id-type="pmid">9510268</pub-id><pub-id pub-id-type="doi">10.1016/S1072-7515(98)00002-7</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Khaira</surname><given-names>Hs</given-names></name><name><surname>Lall</surname><given-names>P</given-names></name><name><surname>Hunter</surname><given-names>B</given-names></name><name><surname>Brown</surname><given-names>JH</given-names></name></person-group><article-title>Repair of incisional hernias</article-title><source>J R Coll Surg Edinb</source><year>2001</year><volume>46</volume><fpage>39</fpage><lpage>43</lpage><pub-id pub-id-type="pmid">11242742</pub-id></citation></ref></ref-list></back></article>