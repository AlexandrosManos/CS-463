-id-type="pmid">21415712</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Girolami</surname><given-names>A</given-names></name><name><surname>Allemand</surname><given-names>E</given-names></name><name><surname>Bertozzi</surname><given-names>I</given-names></name><name><surname>Candeo</surname><given-names>N</given-names></name><name><surname>Marun</surname><given-names>S</given-names></name><name><surname>Girolami</surname><given-names>B</given-names></name></person-group><article-title>Thrombotic events in patients with congenital prekallikrein deficiency: a critical evaluation of all reported cases</article-title><source><italic>Acta Haematologica</italic></source><year>2010</year><volume>123</volume><issue>4</issue><fpage>210</fpage><lpage>214</lpage><pub-id pub-id-type="other">2-s2.0-77951251161</pub-id><pub-id pub-id-type="pmid">20424433</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Acar</surname><given-names>K</given-names></name><name><surname>Ya&#x0011f;ci</surname><given-names>M</given-names></name><name><surname>Sucak</surname><given-names>GT</given-names></name><name><surname>Haznedar</surname><given-names>R</given-names></name></person-group><article-title>Isolated prolonged activated partial thromboplastin time in an asymptomatic patient: fletcher factor deficiency</article-title><source><italic>Thrombosis Research</italic></source><year>2006</year><volume>118</volume><issue>6</issue><fpage>765</fpage><lpage>766</lpage><pub-id pub-id-type="other">2-s2.0-33750532272</pub-id><pub-id pub-id-type="pmid">16414101</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kitchens</surname><given-names>CS</given-names></name