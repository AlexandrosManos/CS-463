le-title><source>Brain Res</source><year>1994</year><volume>643</volume><fpage>302</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">8032924</pub-id></element-citation></ref><ref id="r11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Sherry</surname><given-names>DM</given-names></name><name><surname>St Jules</surname><given-names>RS</given-names></name><name><surname>Townes-Anderson</surname><given-names>E</given-names></name></person-group><article-title>Morphologic and neurochemical target selectivity of regenerating adult photoreceptors in vitro.</article-title><source>J Comp Neurol</source><year>1996</year><volume>376</volume><fpage>476</fpage><lpage>88</lpage><pub-id pub-id-type="pmid">8956112</pub-id></element-citation></ref><ref id="r12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gouras</surname><given-names>P</given-names></name><name><surname>Du</surname><given-names>J</given-names></name><name><surname>Gelanze</surname><given-names>M</given-names></name><name><surname>Kwun</surname><given-names>R</given-names></name><name><surname>Kjeldbye</surname><given-names>H</given-names></name><name><surname>Lopez</surname><given-names>R</given-names></name></person-group><article-title>Transplantation of photoreceptors labeled with tritiated-thymidine into RCS rats.</article-title><source>Invest Ophthalmol Vis Sci</source><year>1991</year><volume>32</volume><fpage>1704</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">2016147</pub-id></element-citation></ref><ref id="r13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gouras</surname><given-names>P</given-names></name><name><surname>Du</surname><given-names>J</given-names></name><name><surname>Kjeldbye</surname><given-names>H</given-names></name><name><surname>Yamamoto</surname><given-names>S</given-na