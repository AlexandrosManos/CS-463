<name><surname>Godoy</surname><given-names>LM</given-names></name><name><surname>Daboin</surname><given-names>KP</given-names></name><name><surname>Casiraghi</surname><given-names>O</given-names></name><name><surname>Garcia</surname><given-names>AM</given-names></name><name><surname>Luna</surname><given-names>MA</given-names></name></person-group><article-title>Laryngeal osteosarcoma: a clinicopathologic analysis of four cases and comparison with a carcinosarcoma</article-title><source>Ann Diagn Pathol</source><year>2002</year><volume>6</volume><fpage>1</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">11842374</pub-id><pub-id pub-id-type="doi">10.1053/adpa.2002.30604</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rossi</surname><given-names>RM</given-names></name><name><surname>Landas</surname><given-names>SK</given-names></name><name><surname>Kelly</surname><given-names>DR</given-names></name><name><surname>Marsh</surname><given-names>WL</given-names></name></person-group><article-title>Osteosarcoma of the larynx</article-title><source>Otolaryngol Head Neck Surg</source><year>1998</year><volume>118</volume><fpage>385</fpage><lpage>388</lpage><pub-id pub-id-type="pmid">9527123</pub-id><pub-id pub-id-type="doi">10.1016/S0194-5998(98)70321-3</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Topaloglu</surname><given-names>I</given-names></name><name><surname>Isiksacan</surname><given-names>V</given-names></name><name><surname>Ulusoy</surname><given-names>S</given-names></name><name><surname>Sisman</surname><given-names>S</given-names></name></person-group><article-title>Osteosarcoma of the larynx</article-title><source>Otolaryngol Head Neck Surg</source><year>2004</year><volume>131</volume><fpage>789</fpage><lpage>790</lpage><pub-id pub-id-type="pmid">15523469</pub-id><pub-id pub-id-type="doi">10.1016/j.otohns.