a0;<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td></tr><tr><td align="left" valign="bottom">&#x02003;1 and 2<hr/></td><td align="center" valign="bottom">98 (41.17%)<hr/></td><td align="center" valign="bottom">24 (24.5%)<hr/></td><td align="center" valign="bottom">74 (75.5%)<hr/></td><td align="center" valign="bottom">***<hr/></td></tr><tr><td align="left" valign="bottom">&#x02003;3<hr/></td><td align="center" valign="bottom">100 (42.0%)<hr/></td><td align="center" valign="bottom">44 (43.6%)<hr/></td><td align="center" valign="bottom">56(56.4%)<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td></tr><tr><td align="left" valign="bottom">&#x02003;4 and 5<hr/></td><td align="center" valign="bottom">40 (16.8%)<hr/></td><td align="center" valign="bottom">32 (80.0%)<hr/></td><td align="center" valign="bottom">8 (20.0%)<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td></tr><tr><td align="left" valign="bottom">Gold<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td></tr><tr><td align="left" valign="bottom">&#x02003;0<hr/></td><td align="center" valign="bottom">102 (42.7%)<hr/></td><td align="center" valign="bottom">52 (51.0%)<hr/></td><td align="center" valign="bottom">50 (49.0%)<hr/></td><td align="center" valign="bottom">*<hr/></td></tr><tr><td align="left" valign="bottom">&#x02003;1 and 2<hr/></td><td align="center" valign="bottom">61 (25.5%)<hr/></td><td align="center" valign="bottom">26 (42.6%)<hr/></td><td align="center" valign="bottom">35 (57.4%)<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td></tr><tr><td align="left" valign="bottom">&#x02003;3 and 4<hr/></td><td align="center" valign="bottom">76 (31.8%)<hr/></td><td align="center" valign="bottom">22 (28.9%)<hr/></td><td align="center" valign="bottom">54 (71.1%)<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td></tr><tr><td align="left" valign="bottom">Smoker<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td></tr><tr><td align="left" valign="bottom">&#x02003;No<hr/></td><td align="center" valign="bottom">50 (23.0%)<hr/></td><td align="center" valign="bottom">24 (48.0%)<hr/></td><td align="center" valign="bottom">26 (52.0%)<hr/></td><td align="center" valign="bottom">NS<hr/></td></tr><tr><td align="left" valign="bottom">&#x02003;Yes<hr/></td><td align="center" valign="bottom">34 (15.7%)<hr/></td><td align="center" valign="bottom">16 (47.1%)<hr/></td><td align="center" valign="bottom">18 (52.9%)<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td></tr><tr><td align="left" valign="bottom">&#x02003;Former smoker<hr/></td><td align="center" valign="bottom">130 (59.9%)<hr/></td><td align="center" valign="bottom">51 (39.2%)<hr/></td><td align="center" valign="bottom">79 (60.8%)<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td></tr><tr><td align="left" valign="bottom">&#x02003;Passive smoker<hr/></td><td align="center" valign="bottom">3 (1.4%)<hr/></td><td align="center" valign="bottom">1 (33.3%)<hr/></td><td align="center" valign="bottom">2 (66.7%)<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td></tr><tr><td align="left" valign="bottom">Tachypnea<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td><td align="center" valign="bottom">&#x000a0;<hr/></td></tr><tr><td align="left" valign="bottom">&#x02003;No<hr/></td><td align="center" valign="bottom">149 (62.3%)<hr/></td><td align="center" valign="bottom">76 (51.0%)<hr/></td><td align="center" valign="bottom">73 (49.0