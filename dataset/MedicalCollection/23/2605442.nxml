><pub-id pub-id-type="doi">10.1111/j.1469-0691.2004.00936.x</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Donlan</surname><given-names>R</given-names></name></person-group><article-title>Biofilms and device-associated infections</article-title><source>Emerg Infect Dis</source><year>2001</year><volume>7</volume><fpage>277</fpage><lpage>81</lpage><pub-id pub-id-type="pmid">11294723</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Linde</surname><given-names>HJ</given-names></name><name><surname>Hahn</surname><given-names>J</given-names></name><name><surname>Holler</surname><given-names>E</given-names></name><name><surname>Reischl</surname><given-names>U</given-names></name><name><surname>Lehn</surname><given-names>N</given-names></name></person-group><article-title>Septicemia due to <italic>Acinetobacter junii</italic></article-title><source>J Clin Microbiol</source><year>2002</year><volume>40</volume><fpage>2696</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">12089313</pub-id><pub-id pub-id-type="doi">10.1128/JCM.40.7.2696-2697.2002</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schinabeck</surname><given-names>M</given-names></name><name><surname>Ghannoum</surname><given-names>M</given-names></name></person-group><article-title>Catheter-related infections-diagnosis, treatment and prevention</article-title><source>Clin Microbiol Newsletter</source><year>2003</year><volume>25</volume><fpage>113</fpage><lpage>118</lpage><pub-id pub-id-type="doi">10.1016/S0196-4399(03)80036-3</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Juretschko</surname><given-names>S</given-names></name><name><surname>Loy</surname><given-names>A</given-names></name><name><su