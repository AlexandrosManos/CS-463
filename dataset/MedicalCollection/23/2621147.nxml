 Chem</source><year>2001</year><volume>73</volume><fpage>993</fpage><lpage>1031</lpage><pub-id pub-id-type="doi">10.1351/pac200173060993</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Silbergeld</surname><given-names>EK</given-names></name></person-group><article-title>Risk assessment: the perspective and experience of U.S. environmentalists</article-title><source>Environ Health Perspect</source><year>1993</year><volume>101</volume><fpage>100</fpage><lpage>104</lpage><pub-id pub-id-type="pmid">8354185</pub-id><pub-id pub-id-type="doi">10.2307/3431414</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jardine</surname><given-names>CG</given-names></name><name><surname>Hrudey</surname><given-names>SE</given-names></name><name><surname>Shortreed</surname><given-names>JH</given-names></name><name><surname>Craig</surname><given-names>L</given-names></name><name><surname>Krewski</surname><given-names>D</given-names></name><name><surname>Furgal</surname><given-names>C</given-names></name><name><surname>McColl</surname><given-names>S</given-names></name></person-group><article-title>Risk management frameworks for human health and environmental risks</article-title><source>J Toxicol Environ Health, Part B</source><year>2003</year><volume>6</volume><fpage>569</fpage><lpage>641</lpage><pub-id pub-id-type="doi">10.1080/716100632</pub-id></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Covello</surname><given-names>VT</given-names></name><name><surname>Merkhofer</surname><given-names>MW</given-names></name></person-group><source>Risk assessment methods Approaches for assessing health and environmental risks</source><year>1993</year><publisher-name>New York: Plenum Press</publisher-name></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Greim</surname><given-names>H</given-names></name><name><surname>Arand</surname><given-names>M</given-names></name><name><surname>Autrup</surname><given-names>H</given-names></name><name><surname>Bolt</surname><given-names>HM</given-names></name><name><surname>Bridges</surname><given-names>J</given-names></name><name><surname>Dybing</surname><given-names>E</given-names></name><name><surname>Glomot</surname><given-names>R</given-names></name><name><surname>Foa</surname><given-names>V</given-names></name><name><surname>Schulte-Hermann</surname><given-names>R</given-names></name></person-group><article-title>Toxicological to the discussion about REACH</article-title><source>Arch Toxicol</source><year>2006</year><volume>80</volume><fpage>121</fpage><lpage>124</lpage><pub-id pub-id-type="pmid">16411136</pub-id><pub-id pub-id-type="doi">10.1007/s00204-005-0039-z</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Renn</surname><given-names>O</given-names></name></person-group><article-title>Three decades of risk research: accomplishments and new challenges</article-title><source>J Risk Res</source><year>1998</year><volume>1</volume><fpage>49</fpage><lpage>71</lpage><pub-id pub-id-type="doi">10.1080/136698798377321</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Santillo</surname><given-names>D</given-names></name><name><surname>Johnston</surname><given-names>P</given-names></name><name><surname>Stringer</surname><given-names>R</given-names></name></person-group><article-title>Management of chemical exposure: the limitations of a risk-based approach</article-title><source>Int J Risk Assess Manag</source><year>2000</year><volume>1</volume><fpage>160</fpage><lpage>180</lpage><pub-id pub-id-type="doi">10.1504/IJRAM.2000.001495</pub-id></citation></ref><ref id="B18"><cit