<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="correction"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">J Cell Biol</journal-id><journal-id journal-id-type="publisher-id">jcb</journal-id><journal-title>The Journal of Cell Biology</journal-title><issn pub-type="ppub">0021-9525</issn><issn pub-type="epub">1540-8140</issn><publisher><publisher-name>The Rockefeller University Press</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmc">2606953</article-id><article-id pub-id-type="publisher-id">1834iti20081202c</article-id><article-id pub-id-type="doi">10.1083/jcb.1834iti20081202c</article-id><article-categories><subj-group subj-group-type="heading"><subject>Corrections</subject><subj-group><subject>Correction</subject></subj-group></subj-group></article-categories><title-group><article-title>Uniting to save cancer cells</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Leslie</surname><given-names>Mitch</given-names></name></contrib></contrib-group><pub-date pub-type="ppub"><day>29</day><month>12</month><year>2008</year></pub-date><volume>183</volume><issue>7</issue><fpage>1315</fpage><lpage>1315</lpage><permissions><copyright-statement>Copyright &#x000a9; 2008, The Rockefeller University Press</copyright-statement></permissions><self-uri xlink:title="pdf" xlink:href="jcb1831315.pdf"/></article-meta></front><body><p>Vol. 183 No. 4, November 17, 2008. Page <related-article related-article-type="corrected-article" vol="183" page="569" id="N0x1c7bf20N0x1decd30" ext-link-type="pmc">569</related-article>.</p><p>Due to a production error, the two-panel image in the original story was reversed. The correct image appears below.</p><p>The html and pdf versions of this article have been corrected. The error remains only in the print version.</p><p><fig position="float" id="fig1"><label>Figure 1</label><caption><p>Vitamin D spurs cancer cells to take on the spread-out epithelial phenotype (left), but they are more rounded if RhoA is disrupted (right).</p></caption><graphic xlink:href="jcb1831315f01"></graphic></fig></p></body></article>