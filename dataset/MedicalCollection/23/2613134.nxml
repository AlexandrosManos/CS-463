/volume><fpage>7</fpage><pub-id pub-id-type="pmid">18211688</pub-id><pub-id pub-id-type="doi">10.1186/1477-7525-6-7</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reinfjell</surname><given-names>T</given-names></name><name><surname>Lofstad</surname><given-names>GE</given-names></name><name><surname>Veenstra</surname><given-names>M</given-names></name><name><surname>Vikan</surname><given-names>A</given-names></name><name><surname>Diseth</surname><given-names>TH</given-names></name></person-group><article-title>Health-related quality of life and intellectual functioning in children in remission from acute lymphoblastic leukaemia</article-title><source>Acta Paediatr</source><year>2007</year><volume>96</volume><fpage>1280</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">17590194</pub-id><pub-id pub-id-type="doi">10.1111/j.1651-2227.2007.00383.x</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gkoltsiou</surname><given-names>K</given-names></name><name><surname>Dimitrakaki</surname><given-names>C</given-names></name><name><surname>Tzavara</surname><given-names>C</given-names></name><name><surname>Papaevangelou</surname><given-names>V</given-names></name><name><surname>Varni</surname><given-names>JW</given-names></name><name><surname>Tountas</surname><given-names>Y</given-names></name></person-group><article-title>Measuring health-related quality of life in Greek children: psychometric properties of the Greek version of the Pediatric Quality of Life Inventory(TM) 4.0 Generic Core Scales</article-title><source>Qual Life Res</source><year>2008</year><volume>17</volume><fpage>299</fpage><lpage>305</lpage><pub-id pub-id-type="pmid">18080786</pub-id><pub-id pub-id-type="doi">10.1007/s11136-007-9294-1</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><nam