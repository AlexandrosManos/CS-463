rm-4-0983">Demers et al (1998)</xref></td><td align="left" rowspan="1" colspan="1">184</td><td align="left" rowspan="1" colspan="1">Venography</td><td align="left" rowspan="1" colspan="1">33</td><td align="left" rowspan="1" colspan="1">17.9%</td></tr><tr><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b31-vhrm-4-0983">Jaureguito et al (1999)</xref></td><td align="left" rowspan="1" colspan="1">239</td><td align="left" rowspan="1" colspan="1">Venography</td><td align="left" rowspan="1" colspan="1">7</td><td align="left" rowspan="1" colspan="1">2.9%</td></tr><tr><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b71-vhrm-4-0983">Wirth et al (2001)</xref></td><td align="left" rowspan="1" colspan="1">117</td><td align="left" rowspan="1" colspan="1">Venography</td><td align="left" rowspan="1" colspan="1">5</td><td align="left" rowspan="1" colspan="1">4.3%</td></tr><tr><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b12-vhrm-4-0983">Delis et al (2001)</xref></td><td align="left" rowspan="1" colspan="1">102</td><td align="left" rowspan="1" colspan="1">Color Duplex</td><td align="left" rowspan="1" colspan="1">8</td><td align="left" rowspan="1" colspan="1">7.41%</td></tr><tr><td align="left" rowspan="1" colspan="1">Total</td><td align="left" rowspan="1" colspan="1">1,032</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">65</td><td align="left" rowspan="1" colspan="1">6.29%</td></tr></tbody></table><table-wrap-foot><fn id="tfn4-vhrm-4-0983"><p>Adapted with permission from <xref ref-type="bibr" rid="b71-vhrm-4-0983">Wirth T, Schneider B, Misselwitz F, et al. 2001</xref>. Prevention of venous thromboembolism after knee arthroscopy with low-molecular weight heparin (reviparin): results of a randomized, controlled trial. <italic>Arthroscopy</italic>, 17:393&#x02013;9. Copyright &#x000a9; Elsevier Ltd, and reproduced with permission from <xref ref-type="bibr" rid="b47-vhrm-4-0983">Montebug