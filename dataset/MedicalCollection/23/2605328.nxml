d align="left" rowspan="1" colspan="1">101</td><td align="left" rowspan="1" colspan="1">Duplex ultrasound</td><td align="left" rowspan="1" colspan="1">12/11.88%</td></tr><tr><td align="left" rowspan="1" colspan="1">Nandroparin</td><td align="left" rowspan="1" colspan="1">3,075</td><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b27-vhrm-4-0983">Holland and Schain (1995)</xref></td><td align="left" rowspan="1" colspan="1">101</td><td align="left" rowspan="1" colspan="1">Unknown</td><td align="left" rowspan="1" colspan="1">5/4.95%</td></tr><tr><td align="left" rowspan="1" colspan="1">Parnaparin</td><td align="left" rowspan="1" colspan="1">3,200&#x02013;4,250</td><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b47-vhrm-4-0983">Montebugnoli et al (2007)</xref></td><td align="left" rowspan="1" colspan="1">509</td><td align="left" rowspan="1" colspan="1">Compression ultrasound</td><td align="left" rowspan="1" colspan="1">0/0.00%</td></tr></tbody></table><table-wrap-foot><fn id="tfn5-vhrm-4-0983"><p><bold>Abbreviations:</bold> DVT, deep vein thrombosis; LMWH, low-molecular-weight heparins; UFH, unfractionated heparins.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>