al"><person-group person-group-type="author"><name><surname>Sagdullaev</surname><given-names>BT</given-names></name><name><surname>McCall</surname><given-names>MA</given-names></name></person-group><article-title>Stimulus size and intensity alter fundamental properties in the primary visual cortex of the mouse</article-title><source>Visual Neuroscience</source><year>2005</year><volume>22</volume><fpage>649</fpage><lpage>659</lpage><pub-id pub-id-type="pmid">16332276</pub-id><pub-id pub-id-type="doi">10.1017/S0952523805225142</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grubb</surname><given-names>MS</given-names></name><name><surname>Thompson</surname><given-names>ID</given-names></name></person-group><article-title>Quantitative characterization of visual response properties in the mouse dorsal lateral geniculate nucleus</article-title><source>Journal of Neurophysiology</source><year>2003</year><volume>90</volume><fpage>3594</fpage><lpage>3607</lpage><pub-id pub-id-type="pmid">12944530</pub-id><pub-id pub-id-type="doi">10.1152/jn.00699.2003</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>Q</given-names></name><name><surname>Burkhalter</surname><given-names>A</given-names></name></person-group><article-title>Area map of mouse visual cortex</article-title><source>Journal of Comparative Neurology</source><year>2007</year><volume>502</volume><fpage>339</fpage><lpage>357</lpage><pub-id pub-id-type="pmid">17366604</pub-id><pub-id pub-id-type="doi">10.1002/cne.21286</pub-id></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Franklin</surname><given-names>KBJ</given-names></name><name><surname>Paxinos</surname><given-names>G</given-names></name></person-group><source>The mouse brain in stereotaxic coordinates</source><y