center" rowspan="1" colspan="1">100</td><td align="center" rowspan="1" colspan="1">4</td><td align="center" rowspan="1" colspan="1">BGN</td><td align="center" rowspan="1" colspan="1">NM_001711</td><td align="center" rowspan="1" colspan="1">100</td><td align="center" rowspan="1" colspan="1">47</td><td align="center" rowspan="1" colspan="1">MSN</td><td align="center" rowspan="1" colspan="1">NM_002444</td><td align="center" rowspan="1" colspan="1">66.666</td></tr><tr><td align="center" rowspan="1" colspan="1">5</td><td align="center" rowspan="1" colspan="1">JUND</td><td align="center" rowspan="1" colspan="1">NM_005354</td><td align="center" rowspan="1" colspan="1">100</td><td align="center" rowspan="1" colspan="1">5</td><td align="center" rowspan="1" colspan="1">CLU</td><td align="center" rowspan="1" colspan="1">NM_001831</td><td align="center" rowspan="1" colspan="1">100</td><td align="center" rowspan="1" colspan="1">48</td><td align="center" rowspan="1" colspan="1">APOC1</td><td align="center" rowspan="1" colspan="1">NM_001645</td><td align="center" rowspan="1" colspan="1">66.666</td></tr><tr><td align="center" rowspan="1" colspan="1">6</td><td align="center" rowspan="1" colspan="1">KIAA0220</td><td align="center" style="background-color:#AAAAAA" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">100</td><td align="center" rowspan="1" colspan="1">6</td><td align="center" rowspan="1" colspan="1">COL1A2</td><td align="center" rowspan="1" colspan="1">NM_000089</td><td align="center" rowspan="1" colspan="1">100</td><td align="center" rowspan="1" colspan="1">49</td><td align="center" rowspan="1" colspan="1">BENE</td><td align="center" rowspan="1" colspan="1">NM_005434</td><td align="center" rowspan="1" colspan="1">66.666</td></tr><tr><td align="center" rowspan="1" colspan="1">7</td><td align="center" rowspan="1" colspan="1">LGALS1</td><td align="center" rowspan="1" colspan="1">NM_002305</td><td align="center" rowspan="1" colspan="1">100</td><td align="center" rowspan="1" colspan="1">7</td><td align="center" rowspan="1" colspan="1">CYP2B</td><td align="center" style="background-color:#AAAAAA" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">100</td><td align="center" rowspan="1" colspan="1">50</td><td align="center" rowspan="1" colspan="1">COL3A1</td><td align="center" rowspan="1" colspan="1">NM_000090</td><td align="center" rowspan="1" colspan="1">66.666</td></tr><tr><td align="center" rowspan="1" colspan="1">8</td><td align="center" rowspan="1" colspan="1">MGP</td><td align="center" rowspan="1" colspan="1">NM_000900</td><td align="center" rowspan="1" colspan="1">100</td><td align="center" rowspan="1" colspan="1">8</td><td align="center" rowspan="1" colspan="1">FOXG1A</td><td align="center" rowspan="1" colspan="1">NM_005249</td><td align="center" rowspan="1" colspan="1">100</td><td align="center" rowspan="1" colspan="1">51</td><td align="center" rowspan="1" colspan="1">PFN1</td><td align="center" rowspan="1" colspan="1">NM_005022</td><td align="center" rowspan="1" colspan="1">66.666</td></tr><tr><td align="center" rowspan="1" colspan="1">9</td><td align="center" rowspan="1" colspan="1">PTGDS</td><td align="center" rowspan="1" colspan="1">NM_000954</td><td align="center" rowspan="1" colspan="1">100</td><td align="center" rowspan="1" colspan="1">9</td><td align="center" rowspan="1" colspan="1">FTL</td><td align="center" rowspan="1" colspan="1">NM_000146</td><td align="center" rowspan="1" colspan="1">100</td><td align="center" rowspan="1" colspan="1">52</td><td align="center" rowspan="1" colspan="1">PGAM1</td><td align="center" rowspan="1" colspan="1">NM_002629</td><td align="center" rowspan="1" colspan="1">66.666</td></tr><tr><td align="center" rowspan="1" colspan="1">10</td><td align="center" rowspan="1" colspan="1">RPL37</td><td align="center" rowspan="1" colspan="1">NM_000997</td><td align="center" rowspan="1" colspan="1">100</td><td align="center" rowspan="1" colspan="1">10</td><td align="center