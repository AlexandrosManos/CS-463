d align="center">Classifiers</td><td align="center" colspan="5"><italic>m</italic>-fold of genes</td></tr><tr><td></td><td></td><td></td><td colspan="5"><hr></hr></td></tr><tr><td></td><td></td><td></td><td align="center">1-fold</td><td align="center">2-fold</td><td align="center">3-fold</td><td align="center">4-fold</td><td align="center">5-fold</td></tr></thead><tbody><tr><td align="center">CNS</td><td align="center">GDI.Dominant</td><td align="center">OVO.SVM-L</td><td align="center">35.5 &#x000b1; 1.0</td><td align="center">32.0 &#x000b1; 1.1</td><td align="center">27.4 &#x000b1; 1.0</td><td align="center">26.6 &#x000b1; 1.1</td><td align="center">24.3 &#x000b1; 1.0</td></tr><tr><td></td><td></td><td align="center">OVO.SVM-R</td><td align="center">36.5 &#x000b1; 1.1</td><td align="center">30.8 &#x000b1; 1.1</td><td align="center">27.4 &#x000b1; 1.1</td><td align="center">25.8 &#x000b1; 1.1</td><td align="center">24.0 &#x000b1; 1.0</td></tr><tr><td></td><td></td><td align="center">OVA.SVM-L</td><td align="center">35.9 &#x000b1; 1.4</td><td align="center">32.8 &#x000b1; 1.2</td><td align="center">28.8 &#x000b1; 1.0</td><td align="center">27.8 &#x000b1; 1.0</td><td align="center">26.3 &#x000b1; 1.0</td></tr><tr><td></td><td></td><td align="center">OVA.SVM-R</td><td align="center">35.2 &#x000b1; 1.2</td><td align="center">29.9 &#x000b1; 1.2</td><td align="center">27.7 &#x000b1; 1.0</td><td align="center">26.3 &#x000b1; 1.0</td><td align="center">25.3 &#x000b1; 1.0</td></tr><tr><td></td><td></td><td align="center">NMC</td><td align="center">33.5 &#x000b1; 1.1</td><td align="center">27.0 &#x000b1; 1.0</td><td align="center">23.7 &#x000b1; 1.0</td><td align="center">22.9 &#x000b1; 1.0</td><td align="center">21.4 &#x000b1; 0.9</td></tr><tr><td></td><td></td><td align="center">NNC</td><td align="center">33.0 &#x000b1; 1.1</td><td align="center">28.1 &#x000b1; 1.1</td><td align="center">25.6 &#x000b1; 1.0</td><td align="center">26.1 &#x000b1; 0.9</td><td align="center">25.1 &#x000b1; 0.9</td></tr><tr><td></td><td colspan="7"><hr></hr></td></tr><tr><td></td><td align="center">OVA.SNR [<xref ref-type="bibr" rid="B12">12</xref>]</td><td align="center">OVO.SVM-L</td><td align="center">37.1 &#x000b1; 1.1</td><td align="center">30.5 &#x000b1; 1.0</td><td align="center">27.0 &#x000b1; 1.0</td><td align="center">23.5 &#x000b1; 1.0</td><td align="center">21.6 &#x000b1; 1.0</td></tr><tr><td></td><td></td><td align="center">OVO.SVM-R</td><td align="center">35.9 &#x000b1; 1.1</td><td align="center">29.6 &#x000b1; 1.0</td><td align="center">27.1 &#x000b1; 1.0</td><td align="center">23.2 &#x000b1; 1.0</td><td align="center">21.6 &#x000b1; 1.0</td></tr><tr><td></td><td></td><td align="center">OVA.SVM-L</td><td align="center">36.8 &#x000b1; 1.1</td><td align="center">30.9 &#x000b1; 1.1</td><td align="center">26.8 &#x000b1; 0.9</td><td align="center">22.8 &#x000b1; 0.9</td><td align="center">20.8 &#x000b1; 0.9</td></tr><tr><td></td><td></td><td align="center">OVA.SVM-R</td><td align="center">35.2 &#x000b1; 1.1</td><td align="center">29.1 &#x000b1; 0.9</td><td align="center">26.1 &#x000b1; 0.9</td><td align="center">23.7 &#x000b1; 0.9</td><td align="center">21.6 &#x000b1; 1.0</td></tr><tr><td></td><td></td><td align="center">NMC</td><td align="center">32.8 &#x000b1; 1.1</td><td align="center">26.3 &#x000b1; 1.0</td><td align="center">23.5 &#x000b1; 1.0</td><td align="center">20.6 &#x000b1; 0.8</td><td align="center">18.5 &#x000b1; 0.9</td></tr><tr><td></td><td></td><td align="center">NNC</td><td align="center">34.9 &#x000b1; 1.0</td><td align="center">28.3 &#x000b1; 1.0</td><td align="center">26.0 &#x000b1; 1.0</td><td align="center">24.0 &#x000b1; 0.9</td><td align="center">21.5 &#x000b1; 1.0</td></tr><tr><td></td><td colspan="7"><hr></hr></td></tr><tr><td></td><td align="center">ANOVA+Correlation [<xref ref-type="bibr" rid="B11">11</xref>]</td><td align="center">OVO.SVM-L</td><td align="center">38.5 &#x000b1; 1.1</td><td align="center">32.2 &#x000b1; 1.0</td><td align="center">27.0 &#x000b1; 0.9</td><td align="center">24.0 &#x000b1; 0.8</td><td align="center">21.6 &#x000b1; 0.8</td></tr><tr><td></td><td></td><td align="center">OVO.SVM-R</td><td align="center">37.1 &#x000b1; 1.1</td><td align="center">30.8 &#x000b1; 1.0</td><td align="center">27.4 &#x000b1; 1.0</td><td align="center">25.0 &#x000b1; 0.9</td><td align="center">21.4 &#x000b1; 0.8</td></tr><tr><td></td><td></td><td align="center">OVA.SVM-L</td><td align="center">38.5 &#x000b1; 1.1</td><td align="center">33.4 &#x000b1; 1.0</td><td align="center">27.4 &#x000b1; 1.0</td><td align="center">25.5 &#x000b1; 0.8</td><td align="center">23.2 &#x000b1; 0.8</td></tr><tr><td></td><td></td><td align="center">OVA.SVM-R</td><td align="center">35.8 &#x000b1; 1.1</td><td align="center">31.0 &#x000b1; 1.1</td><td align="center">26.0 &#x000b1; 1.0</td><td align="center">25.1 &#x000b1; 0.8</td><td align="center">24.1 &#x000b1; 0.9</td></tr><tr><td></td><td></td><td align="center">NMC</td><td align="center">33.7 &#x000b1; 1.3</td><td align="center">24.9 &#x000b1; 0.9</td><td align="center">20.8 &#x000b1; 0.8</td><td align="center">19.7 &#x000b1; 0.8</td><td align="center">19.2 &#x000b1; 0.8</td></tr><tr><td></td><td></td><td align="center">NNC</td><td align="center">36.0 &#x000b1; 1.2</td><td align="center">29.7 &#x000b1; 1.0</td><td align="center">24.4 &#x000b1; 0.9</td><td align="center">23.3 &#x000b1; 0.8</td><td align="center">21.4 &#x000b1; 0.7</td></tr><tr><td colspan="8"><hr></hr></td></tr><tr><td align="center">Lung Cancer</td><td align="center">GDI.Dominant</td><td align="center">OVO.SVM-L</td><td align="center">9.5 &#x000b1; 0.3</td><td align="center">8.1 &#x000b1; 0.3</td><td align="center">7.8 &#x000b1; 0.3</td><td align="center">7.8 &#x000b1; 0.3</td><td align="center">7.4 &#x000b1; 0.3</td></tr><tr><td></td><td></td><td align="center">OVO.SVM-R</td><td align="center">10.0 &#x000b1; 0.4</td><td align="center">8.3 &#x000b1; 0.3</td><td align="center">8.1 &#