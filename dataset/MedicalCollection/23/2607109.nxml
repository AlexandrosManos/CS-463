isher-name>London: Her Majesty's Stationary Office</publisher-name></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hettiaratchy</surname><given-names>S</given-names></name><name><surname>Moloney</surname><given-names>D</given-names></name><name><surname>Clarke</surname><given-names>J</given-names></name></person-group><article-title>Patients with acute skin loss: are they best managed on a burns unit?</article-title><source>Ann R Coll Surg Engl</source><year>2001</year><volume>83</volume><fpage>26</fpage><lpage>29</lpage><pub-id pub-id-type="pmid">11212445</pub-id></citation></ref><ref id="B27"><citation citation-type="other"><person-group person-group-type="author"><collab>UK Department of Health, Computing for Health</collab></person-group><article-title>Critical Care Minimum Data Set</article-title><ext-link ext-link-type="uri" xlink:href="http://www.dh.gov.uk/assetRoot/04/12/65/14/04126514.pdf"/></citation></ref><ref id="B28"><citation citation-type="other"><article-title>Case Mix Programme participating units</article-title><ext-link ext-link-type="uri" xlink:href="http://www.icnarc.org/audit/cmp/participating-units"/></citation></ref></ref-list></back></article>