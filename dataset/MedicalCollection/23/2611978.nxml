ef><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tasaki</surname><given-names>K</given-names></name><name><surname>Shima</surname><given-names>T</given-names></name><name><surname>Matsumura</surname><given-names>S</given-names></name><name><surname>Okada</surname><given-names>Y</given-names></name><name><surname>Nishida</surname><given-names>M</given-names></name><name><surname>Yamada</surname><given-names>T</given-names></name><name><surname>Okita</surname><given-names>S</given-names></name><name><surname>Kagawa</surname><given-names>R</given-names></name></person-group><article-title>A case of subdural effusion secondary to dural metastasis of prostatic cancer: case report</article-title><source>No Shinkei Geka</source><year>1990</year><volume>18</volume><fpage>539</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">2395513</pub-id></citation></ref></ref-list></back></article>