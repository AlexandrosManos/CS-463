ogy</source><volume>130</volume><fpage>632</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">16530503</pub-id></citation></ref><ref id="pone.0004085-Wiegand1"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wiegand</surname><given-names>J</given-names></name><name><surname>Buggisch</surname><given-names>P</given-names></name><name><surname>Boecher</surname><given-names>W</given-names></name><name><surname>Zeuzem</surname><given-names>S</given-names></name><name><surname>Gelbmann</surname><given-names>CM</given-names></name></person-group><collab>et al.; German HEP-NET Acute HCV Study Group</collab><year>2006</year><article-title>Early monotherapy with pegylated interferon alpha-2b for acute hepatitis C infection: the HEP-NET acute-HCV-II study.</article-title><source>Hepatology</source><volume>43</volume><fpage>250</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">16440367</pub-id></citation></ref><ref id="pone.0004085-Kamal2"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kamal</surname><given-names>SM</given-names></name><name><surname>Moustafa</surname><given-names>KN</given-names></name><name><surname>Chen</surname><given-names>J</given-names></name><name><surname>Fehr</surname><given-names>J</given-names></name><name><surname>Abdel Moneim</surname><given-names>A</given-names></name><etal/></person-group><year>2006</year><article-title>Duration of peginterferon therapy in acute hepatitis C: a randomized trial.</article-title><source>Hepatology</source><volume>43</volume><fpage>923</fpage><lpage>31</lpage><pub-id pub-id-type="pmid">16628640</pub-id></citation></ref><ref id="pone.0004085-Calleri1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Calleri</surname><given-names>G</given-names></name><name><surname>Cariti</surname><given-names>G</given-names></name><name><surname>Gaiottino</surname><given-names>F</given-names></name><name><surname>De Rosa</surname><given-names>FG</given-names></name><name><surname>Bargiacchi</surname><given-names>O</given-names></name><etal/></person-group><year>2007</year><article-title>A short course of pegylated interferon-alpha in acute HCV hepatitis.</article-title><source>J Viral Hepat</source><volume>14</volume><fpage>116</fpage><lpage>21</lpage><pub-id pub-id-type="pmid">17244251</pub-id></citation></ref><ref id="pone.0004085-DeRosa1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Rosa</surname><given-names>FG</given-names></name><name><surname>Bargiacchi</surname><given-names>O</given-names></name><name><surname>Audagnotto</surname><given-names>S</given-names></name><name><surname>Garazzino</surname><given-names>S</given-names></name><name><surname>Cariti</surname><given-names>G</given-names></name><etal/></person-group><year>2007</year><article-title>Twelve-week treatment of acute hepatitis C virus with pegylated interferon-alfa-2b in injection drug users.</article-title><source>Clin Infect Dis</source><volume>45</volume><fpage>583</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">17682992</pub-id></citation></ref><ref id="pone.0004085-Licata1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Licata</surname><given-names>A</given-names></name><name><surname>Di Bona</surname><given-names>D</given-names></name><name><surname>Schepis</surname><given-names>F</given-names></name><name><surname>Shahied</surname><given-names>L</given-names></name><name><surname>Craxi</surname><given-names>A</given-names></name><name><surname>Camma</surname><given-names>C</given-names></name></person-group><year>2003</year><article-title>When and how to treat acute hepatitis C?</article-title><source>Journal of Hepatology</source><volume>39</volume><fpage>1056</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">14642626</pub-id></citation></ref><ref id="pone.0004085-Wedemeyer1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wedemeyer</surname><given-names>H</given-names></name><name><surname>J&#x000e4;ckel</surname><given-names>E</given-names></name><name><surname>Wiegand</surname><given-names>J</given-names></name><name><surname>Cornberg</surname><given-names>M</given-names></name><name><surname>Manns</surname><given-names>MP</given-names></name></person-group><year>2004</year><article-title>Whom? When? How? Another piece of evidence for early treatment of acute hepatitis C.</article-title><source>Hepatology</source><volume>39</volume><fpage>1201</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">15122747</pub-id></citation></ref><ref id="pone.0004085-Zekry1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zekry</surname><given-names>A</given-names></name><name><surname>Patel</surname><given-names>K</given-names></name><name><surname>McHutchinson</surname><given-names>JG</given-names></name></person-group><year>2005</year><article-title>Treatment of acute hepatitis C infection: more pieces of the puzzle?</article-title><source>J Hepatol</source><volume>42</volume><fpage>293</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">15710209</pub-id></citation></ref><ref id="pone.0004085-DeRosa2"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Rosa</surname><given-names>F</given-names></name><name><surname>Cariti</surname><given-names>G</given-names></name><name><surname>Di Perri</surname><given-names>G</given-names></name></person-group><year>2006</year><article-title>Acute hepatitis C: dosage and compliance.</article-title><source>Hepatology</source><volume>44</volume><fpage>511</fpage><pub-id pub-id-type="pmid">16871564</pub-id></citation></ref><ref id="pone.0004085-Frank1"><label>14</label><citation citation-typ