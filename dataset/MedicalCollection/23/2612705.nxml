son-group person-group-type="author"><name><surname>Roduit</surname><given-names>R</given-names></name><name><surname>Schorderet</surname><given-names>DF</given-names></name></person-group><article-title>MAP kinase pathways in UV-induced apoptosis of retinal pigment epithelium ARPE19 cells.</article-title><source>Apoptosis</source><year>2008</year><volume>13</volume><fpage>343</fpage><lpage>53</lpage><pub-id pub-id-type="pmid">18253836</pub-id></citation></ref><ref id="r16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sparrow</surname><given-names>JR</given-names></name><name><surname>Cai</surname><given-names>B</given-names></name></person-group><article-title>Blue light-induced apoptosis of A2Econtaining RPE: involvement of caspase-3 and protection by Bcl-2.</article-title><source>Invest Ophthalmol Vis Sci</source><year>2001</year><volume>42</volume><fpage>1356</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">11328751</pub-id></citation></ref><ref id="r17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sparrow</surname><given-names>JR</given-names></name><name><surname>Zhou</surname><given-names>J</given-names></name><name><surname>Ben-Shabat</surname><given-names>S</given-names></name><name><surname>Vollmer</surname><given-names>H</given-names></name><name><surname>Itagaki</surname><given-names>Y</given-names></name><name><surname>Nakanishi</surname><given-names>K</given-names></name></person-group><article-title>Involvement of oxidative mechanisms in blue-light-induced damage to A2E-laden RPE.</article-title><source>Invest Ophthalmol Vis Sci</source><year>2002</year><volume>43</volume><fpage>1222</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">11923269</pub-id></citation></ref><ref id="r18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tipoe</surname><given-names>GL</given-names></name><name><surname>Leung</surname><given-names>TM</given-names></name><name><surname>Hung</surname><given-names>MW</given-names></name><name><surname>Fung</surname><given-names>ML</given-names></name></person-group><article-title>Green tea polyphenols as an anti-oxidant and anti-inflammatory agent for cardiovascular protection.</article-title><source>Cardiovasc Hematol Disord Drug Targets</source><year>2007</year><volume>7</volume><fpage>135</fpage><lpage>44</lpage><pub-id pub-id-type="pmid">17584048</pub-id></citation></ref><ref id="r19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Farris</surname><given-names>P</given-names></name></person-group><article-title>Idebenone, green tea, and Coffeeberry extract: new and innovative antioxidants.</article-title><source>Dermatol Ther</source><year>2007</year><volume>20</volume><fpage>322</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">18045357</pub-id></citation></ref><ref id="r20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yao</surname><given-names>K</given-names></name><name><surname>Ye</surname><given-names>P</given-names></name><name><surname>Zhang</surname><given-names>L</given-names></name><name><surname>Tan</surname><given-names>J</given-names></name><name><surname>Tang</surname><given-names>X</given-names></name><name><surname>Zhang</surname><given-names>Y</given-names></name></person-group><article-title>Epigallocatechin gallate protects against oxidative stress-induced mitochondria-dependent apoptosis in human lens epithelial cells.</article-title><source>Mol Vis</source><year>2008</year><volume>14</volume><fpage>217</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">18334937</pub-id></citation></ref><ref id="r21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hirai</surname><given-names>M</given-names></name><name><surname>