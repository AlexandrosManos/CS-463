<given-names>GJ</given-names></name><etal/></person-group> <article-title>Eosinophil-derived cationic proteins activate the synthesis of remodeling factors by airway epithelial cells.</article-title><source>J Immunol</source><year>2006</year>;<volume>177</volume>:<fpage>4861</fpage>&#x02013;<lpage>9</lpage><pub-id pub-id-type="pmid">16982928</pub-id></citation></ref><ref id="b6"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Furuta</surname><given-names>GT</given-names></name><name><surname>Nieuwenhuis</surname><given-names>EE</given-names></name><name><surname>Karhausen</surname><given-names>J</given-names></name><etal/></person-group> <article-title>Eosinophils alter colonic epithelial barrier function: role for major basic protein.</article-title><source>Am J Physiol Gastrointest Liver Physiol</source><year>2005</year>;<volume>289</volume>:<fpage>G890</fpage>&#x02013;<lpage>7</lpage><pub-id pub-id-type="pmid">16227527</pub-id></citation></ref><ref id="b7"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>KC</given-names></name><name><surname>Gleich</surname><given-names>GJ</given-names></name><name><surname>Lee</surname><given-names>MK</given-names></name></person-group> <article-title>Two eosinophil granule proteins, eosinophil peroxidase and major basic protein, inhibit mucin release from hamster tracheal surface epithelial cells in primary culture.</article-title><source>Inflamm Res</source><year>1999</year>;<volume>48</volume>:<fpage>314</fpage>&#x02013;<lpage>7</lpage><pub-id pub-id-type="pmid">10442483</pub-id></citation></ref><ref id="b8"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mishra</surname><given-names>A</given-names></name><name><surname>Wang</surname><given-names>M</given-names></name><name><surname>Pemmaraju</surname><given-names>VR</given-names></name><etal/></person-group> <article-title>Esophageal remodeling develops as a consequence of tissue specific IL-5-induced eosinophilia.</article-title><source>Gastroenterology</source><year>2008</year>;<volume>134</volume>:<fpage>204</fpage>&#x02013;<lpage>14</lpage><pub-id pub-id-type="pmid">18166354</pub-id></citation></ref><ref id="b9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Furuta</surname><given-names>GT</given-names></name><name><surname>Ackerman</surname><given-names>SJ</given-names></name><name><surname>Varga</surname><given-names>J</given-names></name><etal/></person-group> <article-title>Eosinophil granule-derived major basic protein induces IL-8 expression in human intestinal myofibroblasts.</article-title><source>Clin Exp Immunol</source><year>2000</year>;<volume>122</volume>:<fpage>35</fpage>&#x02013;<lpage>40</lpage><pub-id pub-id-type="pmid">11012615</pub-id></citation></ref><ref id="b10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>EM</given-names></name><name><surname>Katz</surname><given-names>C</given-names></name><name><surname>Butters</surname><given-names>R</given-names></name><etal/></person-group> <article-title>Polyarginine, polylysine, and protamine mimic the effects of high extracellular calcium concentrations on dispersed bovine parathyroid cells.</article-title><source>J Bone Miner Res</source><year>1991</year>;<volume>6</volume>:<fpage>1217</fpage>&#x02013;<lpage>25</lpage><pub-id pub-id-type="pmid">1666808</pub-id></citation></ref><ref id="b11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>EM</given-names></name><name><surname>MacLeod</surname><given-names>RJ</given-names></name></person-group> <article-title>Extracellular calcium sensing and extracellular calcium signaling.</article-title><source>Physiol Rev</source><year>2001</year>;<volume>81</volume>:<fpage>239</fpage>&#x02013;<lpage>7</lpage><pub-id pub-id-type="pmid">11152759</pub-id></citation></ref><ref id="b12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Justinich</surname><given-names>CJ</given-names></name><name><surname>Mak</surname><given-names>N</given-names></name><name><surname>Pacheco</surname><given-names>I</given-names></name><etal/></person-group> <article-title>The extracellular calcium-sensing receptor (CaSR) on human esophagus and evidence of expression of the CaSR on the esophageal epithelial cell line (HET-1A).</article-title><source>Am J Physiol Gastrointest Liver Physiol</source><year>2007</year>;<volume>294</volume>:<fpage>G120</fpage>&#x02013;<lpage>9</lpage><pub-id pub-id-type="pmid">17962359</pub-id></citation></ref><ref id="b13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thomas</surname><given-names>LL</given-names></name><name><surname>Kubo</surname><given-names>H</given-names></name><name><surname>Loegering</surname><given-names>DJ</given-names></name><etal/></person-group> <article-title>Peptide-based analysis of amino acid sequences important to the biological activity of eosinophil granule major basic protein.</article-title><source>Immunol Lett</source><year>2001</year>;<volume>78</volume>:<fpage>175</fpage>&#x02013;<lpage>81</lpage><pub-id pub-id-type="pmid">11578692</pub-id></citation></ref><ref id="b14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garcia</surname><given-names>BH</given-names><suffix>2nd</suffix></name><name><surname>Hargrave</surname><given-names>A</given-names></name><name><surname>Morgan</surname><given-names>A</given-names></name><etal/></person-group> <article-title>Antibody microarray analysis of inflammatory mediator release by human leukemia T-cells and 