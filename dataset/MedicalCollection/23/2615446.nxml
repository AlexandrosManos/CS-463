 J</source><year>2004</year><volume>3</volume><fpage>3</fpage><pub-id pub-id-type="pmid">14998435</pub-id><pub-id pub-id-type="doi">10.1186/1475-2875-3-3</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dandona</surname><given-names>L</given-names></name><name><surname>Dandona</surname><given-names>R</given-names></name></person-group><article-title>Drop of HIV estimate for India to less than half</article-title><source>Lancet</source><year>2007</year><volume>370</volume><fpage>1811</fpage><lpage>1813</lpage><pub-id pub-id-type="pmid">18061043</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(07)61756-5</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shelton</surname><given-names>JD</given-names></name></person-group><article-title>Ten myths and one truth about generalised HIV epidemics</article-title><source>Lancet</source><year>2007</year><volume>370</volume><fpage>1809</fpage><lpage>1811</lpage><pub-id pub-id-type="pmid">18061042</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(07)61755-3</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Whitworth</surname><given-names>J</given-names></name><name><surname>Morgan</surname><given-names>D</given-names></name><name><surname>Quigley</surname><given-names>M</given-names></name><name><surname>Smith</surname><given-names>A</given-names></name><name><surname>Mayanja</surname><given-names>B</given-names></name><name><surname>Eotu</surname><given-names>H</given-names></name><name><surname>Omoding</surname><given-names>N</given-names></name><name><surname>Okongo</surname><given-names>M</given-names></name><name><surname>Malamba</surname><given-names>S</given-names></name><name><surname>Ojwiya</surname><given-names>A</given-names></name></person-group><article-title>Effect of HIV-1 and 