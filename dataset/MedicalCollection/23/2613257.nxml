-names>D</given-names></name><name><surname>Gygi</surname><given-names>SP</given-names></name></person-group><article-title>A proteomic strategy for gaining insights into protein sumoylation in yeast</article-title><source>Mol Cell Proteomics</source><year>2005</year><volume>4</volume><fpage>246</fpage><lpage>254</lpage><pub-id pub-id-type="pmid">15542864</pub-id></citation></ref><ref id="b10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Desterro</surname><given-names>JM</given-names></name><name><surname>Thomson</surname><given-names>J</given-names></name><name><surname>Hay</surname><given-names>RT</given-names></name></person-group><article-title>Ubch9 conjugates SUMO but not ubiquitin</article-title><source>FEBS Lett</source><year>1997</year><volume>417</volume><fpage>297</fpage><lpage>300</lpage><pub-id pub-id-type="pmid">9409737</pub-id></citation></ref><ref id="b11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Desterro</surname><given-names>JM</given-names></name><name><surname>Rodriguez</surname><given-names>MS</given-names></name><name><surname>Hay</surname><given-names>RT</given-names></name></person-group><article-title>SUMO-1 modification of IkappaBalpha inhibits NF-kappaB activation</article-title><source>Mol Cell</source><year>1998</year><volume>2</volume><fpage>233</fpage><lpage>239</lpage><pub-id pub-id-type="pmid">9734360</pub-id></citation></ref><ref id="b12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Droucheau</surname><given-names>E</given-names></name><name><surname>Primot</surname><given-names>A</given-names></name><name><surname>Thomas</surname><given-names>V</given-names></name><name><surname>Mattei</surname><given-names>D</given-names></name><name><surname>Knockaert</surname><given-names>M</given-names></name><name><surname>Richardson</surname><given-names>C</given-names></name><etal/></person-group><article