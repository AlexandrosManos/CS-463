f><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Puklin-Faucher</surname><given-names>E</given-names></name><name><surname>Gao</surname><given-names>M</given-names></name><name><surname>Schulten</surname><given-names>K</given-names></name><name><surname>Vogel</surname><given-names>V</given-names></name></person-group><article-title>How the headpiece hinge angle is opened: new insights into the dynamics of integrin activation</article-title><source>Journal of Cell Biology</source><year>2006</year><volume>175</volume><fpage>349</fpage><lpage>360</lpage><pub-id pub-id-type="pmid">17060501</pub-id><pub-id pub-id-type="doi">10.1083/jcb.200602071</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Comisar</surname><given-names>WA</given-names></name><name><surname>Hsiong</surname><given-names>SX</given-names></name><name><surname>Kong</surname><given-names>HJ</given-names></name><name><surname>Mooney</surname><given-names>DJ</given-names></name><name><surname>Linderman</surname><given-names>JJ</given-names></name></person-group><article-title>Multi-scale modeling to predict ligand presentation within RGD nanopatterned hydrogels</article-title><source>Biomaterials</source><year>2006</year><volume>27</volume><fpage>2322</fpage><lpage>2329</lpage><pub-id pub-id-type="pmid">16316682</pub-id><pub-id pub-id-type="doi">10.1016/j.biomaterials.2005.10.037</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bodin</surname><given-names>A</given-names></name><name><surname>Ahrenstedt</surname><given-names>L</given-names></name><name><surname>Fink</surname><given-names>H</given-names></name><name><surname>Brumer</surname><given-names>H</given-names></name><name><surname>Risberg</surname><given-names>B</given-names></name><name><surname>Gatenholm</surname><given-names>P</given-n