"1" colspan="1">3.68</td><td align="center" rowspan="1" colspan="1">6.63E-11</td></tr><tr><td align="left" rowspan="1" colspan="1">3</td><td align="center" rowspan="1" colspan="1">hsa-miR-28</td><td align="center" rowspan="1" colspan="1">3.75</td><td align="center" rowspan="1" colspan="1">5.73E-10</td></tr><tr><td align="left" rowspan="1" colspan="1">3</td><td align="center" rowspan="1" colspan="1">hsa-miR-34a_(sub_1)</td><td align="center" rowspan="1" colspan="1">3.36</td><td align="center" rowspan="1" colspan="1">3.58E-07</td></tr><tr><td align="left" rowspan="1" colspan="1">3</td><td align="center" rowspan="1" colspan="1">hsa-miR-101</td><td align="center" rowspan="1" colspan="1">6.37</td><td align="center" rowspan="1" colspan="1">1.41E-15</td></tr><tr><td align="left" rowspan="1" colspan="1">3</td><td align="center" rowspan="1" colspan="1">hsa-miR-130a</td><td align="center" rowspan="1" colspan="1">6.58</td><td align="center" rowspan="1" colspan="1">3.89E-15</td></tr><tr><td align="left" rowspan="1" colspan="1">4</td><td align="center" rowspan="1" colspan="1">hsa-miR-199a*</td><td align="center" rowspan="1" colspan="1">4.52</td><td align="center" rowspan="1" colspan="1">1.79E-08</td></tr><tr><td align="left" rowspan="1" colspan="1">4</td><td align="center" rowspan="1" colspan="1">hsa-miR-199a_(sub_1)</td><td align="center" rowspan="1" colspan="1">4.03</td><td align="center" rowspan="1" colspan="1">1.51E-05</td></tr><tr><td align="left" rowspan="1" colspan="1">4</td><td align="center" rowspan="1" colspan="1">mmu-miR-199b</td><td align="center" rowspan="1" colspan="1">3.68</td><td align="center" rowspan="1" colspan="1">2.62E-05</td></tr><tr><td align="left" rowspan="1" colspan="1">4</td><td align="center" rowspan="1" colspan="1">hsa-miR-200a</td><td align="center" rowspan="1" colspan="1">3.02</td><td align="center" rowspan="1" colspan="1">1.62E-05</td></tr><tr><td align="left" rowspan="1" colspan="1">4</td><td align="center" rowspan="1" colspan="1">hsa-miR-214</td><td align="center" rowspan="1" colspan="1">4.05</td><td align="center" rowspan="1" colspan="1">3.81E-07</td></tr><tr><td align="left" rowspan="1" colspan="1">5</td><td align="center" rowspan="1" colspan="1">hsa-miR-99a</td><td align="center" rowspan="1" colspan="1">6.99</td><td align="center" rowspan="1" colspan="1">2.78E-07</td></tr><tr><td align="left" rowspan="1" colspan="1">5</td><td align="center" rowspan="1" colspan="1">hsa-miR-100</td><td align="center" rowspan="1" colspan="1">5.26</td><td align="center" rowspan="1" colspan="1">3.80E-07</td></tr><tr><td align="left" rowspan="1" colspan="1">6</td><td align="center" rowspan="1" colspan="1">hsa-miR-33</td><td align="center" rowspan="1" colspan="1">5.56</td><td align="center" rowspan="1" colspan="1">4.82E-07</td></tr><tr><td align="left" rowspan="1" colspan="1">6</td><td align="center" rowspan="1" colspan="1">hsa-miR-141</td><td align="center" rowspan="1" colspan="1">4.46</td><td align="center" rowspan="1" colspan="1">3.58E-06</td></tr></tbody></table></table-wrap></floats-group></article>