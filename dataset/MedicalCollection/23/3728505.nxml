><surname>Khoury</surname><given-names>MJ</given-names></name></person-group><article-title>Research priorities for evaluating family history in the prevention of common chronic diseases</article-title><source><italic>American Journal of Preventive Medicine</italic></source><year>2003</year><volume>24</volume><issue>2</issue><fpage>128</fpage><lpage>135</lpage><pub-id pub-id-type="other">2-s2.0-12244303612</pub-id><pub-id pub-id-type="pmid">12568818</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Qureshi</surname><given-names>N</given-names></name><name><surname>Carroll</surname><given-names>JC</given-names></name><name><surname>Wilson</surname><given-names>B</given-names></name><etal/></person-group><article-title>The current state of cancer family history collection tools in primary care: a systematic review</article-title><source><italic>Genetics in Medicine</italic></source><year>2009</year><volume>11</volume><issue>7</issue><fpage>495</fpage><lpage>506</lpage><pub-id pub-id-type="other">2-s2.0-68749111581</pub-id><pub-id pub-id-type="pmid">19521245</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wilson</surname><given-names>BJ</given-names></name><name><surname>Carroll</surname><given-names>JC</given-names></name><name><surname>Allanson</surname><given-names>J</given-names></name><etal/></person-group><article-title>Family history tools in primary care: does one size fit all?</article-title><source><italic>Public Health Genomics</italic></source><year>2012</year><volume>15</volume><issue>3-4</issue><fpage>181</fpage><lpage>188</lpage><pub-id pub-id-type="other">2-s2.0-84859570056</pub-id><pub-id pub-id-type="pmid">22488461</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Scheuner</surname><given-names>MT</given-names></name><name><surname>Wang</surname><given-names>SJ</given-names></name><name><surname>Raffel</surname><given-names>LJ</given-names></name><name><surname>Larabel</surname><given-names>SK</given-names></name><name><surname>Totter</surname><given-names>JI</given-names></name></person-group><article-title>Family history: a comprehensive genetic risk assessment method for the chronic conditions of adulthood</article-title><source><italic>American Journal of Medical Genetics</italic></source><year>1997</year><volume>71</volume><fpage>315</fpage><lpage>324</lpage><pub-id pub-id-type="pmid">9268102</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Scheuner</surname><given-names>MT</given-names></name><name><surname>Gordon</surname><given-names>OK</given-names></name></person-group><article-title>Genetic risk assessment for comon diseases</article-title><source><italic>Emery and Riomin&#x02019;s Principal and Practice of Medical Genetics</italic></source><year>2002</year><edition>4th edition</edition><publisher-loc>London, UK</publisher-loc><publisher-name>Churchill Livingstone</publisher-name><fpage>654</fpage><lpage>674</lpage></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Robins</surname><given-names>R</given-names></name><name><surname>Metcalfe</surname><given-names>S</given-names></name></person-group><article-title>Integrating genetics as practices of primary care</article-title><source><italic>Social Science and Medicine</italic></source><year>2004</year><volume>59</volume><issue>2</issue><fpage>223</fpage><lpage>233</lpage><pub-id pub-id-type="other">2-s2.0-2042434544</pub-id><pub-id pub-id-type="pmid">15110415</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mathers</surname><given-names>J</given-names></name><name><surname>Greenfield</surname><given-names>S</given-names></name><name><surname>Metcalfe</surname><given-names>A</given-names></name><name><surname>Cole</surname><given-names>T</given-names></name><name><surname>Flanagan</surname><given-names>S</given-names></name><name><surname>Wilson</surname><given-names>S</given-names></name></person-group><article-title>Family history in primary care: understanding GPs&#x02019; resistance to clinical genetics&#x02014;qualitative study</article-title><source><italic>British Journal of General Practice</italic></source><year>2010</year><volume>60</volume><issue>574</issue><fpage>e221</fpage><lpage>e230</lpage><pub-id pub-id-type="other">2-s2.0-77952852651</pub-id><pub-id pub-id-type="pmid">20423577</pub-id></element-citation></ref><ref id="B14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Julian-Reynier</surname><given-names>C</given-names></name><name><surname>Nippert</surname><given-names>I</given-names></name><name><surname>Calefato</surname><given-names>J</given-names></name><etal/></person-group><article-title>Genetics in clinical practice: general practitioners&#x02019; educational priorities in European countries</article-title><source><italic>Genetics in Medicine</italic></source><year>2008</year><volume>10</volume><issue>2</issue><fpage>107</fpage><lpage>113</lpage><pub-id pub-id-type="other">2-s2.0-39449098569</pub-id><pub-id pub-id-type="pmid">18281917</pub-id></element-citation></ref><ref id="B15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Skirton</surname><given-names>H</given-names></name><name><surname>Lewis</surname><given-names>C</given-names></name><name><surname>Kent</surname><given-names