><citation citation-type="journal"><person-group person-group-type="author"><name><surname>de Forges</surname><given-names>BR</given-names></name><name><surname>Koslow</surname><given-names>JA</given-names></name><name><surname>Poore</surname><given-names>GCB</given-names></name></person-group><year>2000</year><article-title>Diversity and endemism of the benthic seamount fauna in the southwest Pacific.</article-title><source>Nature</source><volume>405</volume><fpage>944</fpage><lpage>947</lpage><pub-id pub-id-type="pmid">10879534</pub-id></citation></ref><ref id="pone.0004141-Wilson1"><label>15</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wilson</surname><given-names>RR</given-names></name><name><surname>Kaufmann</surname><given-names>RS</given-names></name></person-group><year>1987</year><article-title>Seamount biota and biogeography.</article-title><person-group person-group-type="editor"><name><surname>Keating</surname><given-names>BH</given-names></name><etal/></person-group><source>Seamounts, Islands, and Atolls</source><publisher-loc>Washington</publisher-loc><publisher-name>American Geophysical Union</publisher-name><fpage>227</fpage><lpage>237</lpage></citation></ref><ref id="pone.0004141-Hubbs1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hubbs</surname><given-names>CL</given-names></name></person-group><year>1959</year><article-title>Initial discoveries of fish faunas on seamounts and offshore banks in the eastern Pacific.</article-title><source>Pacific Science</source><volume>12</volume><fpage>311</fpage><lpage>316</lpage></citation></ref><ref id="pone.0004141-Rogers1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rogers</surname><given-names>AD</given-names></name></person-group><year>1994</year><article-title>The biology of seamounts.</article-title><source>Advances in Marine Biology</source><volume>30</volume><fpage>304</fpage><lpage>360</lpage></citation></ref><ref id="pone.0004141-McClain1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McClain</surname><given-names>CR</given-names></name></person-group><year>2007</year><article-title>Guest Editorial: Seamounts: identity crisis or split personality?</article-title><source>Journal of Biogeography Online</source><fpage>1</fpage><lpage>8</lpage></citation></ref><ref id="pone.0004141-OHara1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>O'Hara</surname><given-names>TD</given-names></name></person-group><year>2007</year><article-title>Seamounts: centres of endemism or species richness for ophiuroids.</article-title><source>Global Ecology and Biogeography</source><volume>16</volume><fpage>720</fpage><lpage>732</lpage></citation></ref><ref id="pone.0004141-Samadi1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Samadi</surname><given-names>S</given-names></name><name><surname>Bottan</surname><given-names>L</given-names></name><name><surname>Macpherson</surname><given-names>E</given-names></name><name><surname>Richer de Forges</surname><given-names>B</given-names></name><name><surname>Boisselier</surname><given-names>M-C</given-names></name></person-group><year>2006</year><article-title>Seamount endemism questioned by the geographical distribution and population genetic structure of marine invertebrates.</article-title><source>Marine Biology</source><volume>149</volume><fpage>1463</fpage><lpage>1475</lpage></citation></ref><ref id="pone.0004141-Lundsten1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lundsten</surname><given-names>L</given-names></name><name><surname>Barry</surname><given-names>JP</given-names></name><name><surname>Caillet</surname><given-names>GM</given-names></name><name><surname>Clague</surname><given-names>DA</given-names></name><name><surname>DeVogelaere</surname><given-names>AP</given-names></name><name><surname>Geller</surname><given-names>JB</given-names></name></person-group><year>in press</year><article-title>Benthic Invertebrate Communities on Three Seamounts off Southern and Central California, USA.</article-title><source>Marine Ecology Progress Series</source></citation></ref><ref id="pone.0004141-Rizk1"><label>22</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Rizk</surname><given-names>S</given-names></name><name><surname>Ryan</surname><given-names>J</given-names></name></person-group><year>2006</year><source>Seamount influences of surface ocean circulation</source><publisher-loc>Moss Landing, CA</publisher-loc><publisher-name>Monterey Bay Aquarium Research Institute</publisher-name></citation></ref><ref id="pone.0004141-Koslow1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koslow</surname><given-names>JA</given-names></name><name><surname>Gowlett-Holmes</surname><given-names>K</given-names></name><name><surname>Lowry</surname><given-names>JK</given-names></name><name><surname>O'Hara</surname><given-names>t</given-names></name><name><surname>Poore</surname><given-names>GCB</given-names></name><etal/></person-group><year>2001</year><article-title>Seamount benthic macrofauna off southern Tasmania: community structure and impacts of trawling.</article-title><source>Marine Ecology Progress Series</source><volume>213</volume><fpage>111</fpage><lpage>125</lpage></citation></ref><ref id="pone.0004141-Genin1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Genin</surname><given-names>A</given-names></name></person-group><year>2004</year><article-title>Bio-physical coupling in the formation of zooplankton and fish aggregations over abrupt topographies.</article-title><source>Journal of Marine Systems</source><volume>50</volume><fpage>3</fpage><lpage>20</lpage></citation></ref><ref id="pone.0004141-Holt1"><label>25</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Holt</surname><given-names>RD</given-names></name></person-group><year>1993</year><article-title>Ecology at the mesoscale: the influence of regional processes on local communities.</article-title><person-group person-group-type="editor"><name><surname>Ricklefs</surname><given-names>RE</given-names></name><name><surname>Schluter</surname><given-names>D</given-names></name></person-group><source>Species Diversity in Ecological Communities: Historical and Geographical Perspectives</source><publisher-loc>Chicago</publisher-loc><publisher-name>University of Chicago Press</publisher-name><fpage>77</fpage><lpage>88</lpage></citation></ref><ref id="pone.0004141-Johnston1"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Johnston</surname><given-names>P</given-names></name><name><surname>Santillo</surname><given-names>D</given-names></name></person-group><year>2004</year><article-title>Conservation of seamount ecosystems: application of a marine protected areas concept.</article-title><source>Archive of Fishery and Marine Research</source><volume>51</volume><fpage>305</fpage><lpage>319</lpage></citation></ref><ref id="pone.0004141-Stone1"><label>27</label><citation citation-type="other"><person-group person-group-type="author"><name><surname>Stone</surname><given-names>G</given-names></name><name><surname>Madin</surname><given-names>L</given-names></name><name><surname>Stocks</surname><given-names>K</given-names></name><name><surname>Hovermale</surname><given-names>G</given-names></name><name><surname>Hoagland</surname><given-names>P</given-names></name><etal/></person-group><year>2003</year><article-title>Seamount Biodiversity, Exploitation and C