rticle-title><source>Philosophical Transactions: Biological Sciences</source><volume>353</volume><fpage>219</fpage><lpage>230</lpage></citation></ref><ref id="pone.0004141-Gaston3"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gaston</surname><given-names>KJ</given-names></name></person-group><year>1996</year><article-title>Species-range-size distributions: patterns, mechanisms and implications.</article-title><source>Trends in Ecology and Evolution</source><volume>11</volume><fpage>197</fpage><lpage>201</lpage></citation></ref><ref id="pone.0004141-Vermeij1"><label>8</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Vermeij</surname><given-names>G</given-names></name></person-group><year>2004</year><article-title>Island life: a view from the sea.</article-title><person-group person-group-type="editor"><name><surname>Lomolino</surname><given-names>MV</given-names></name><name><surname>Heaney</surname><given-names>LR</given-names></name></person-group><source>Frontiers of Biogeography: New Directions in the Geography of Nature</source><publisher-loc>Sunderland, MA</publisher-loc><publisher-name>Sinauer Associates</publisher-name><fpage>239</fpage><lpage>254</lpage></citation></ref><ref id="pone.0004141-Roberts1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roberts</surname><given-names>CM</given-names></name><name><surname>Hawkins</surname><given-names>JP</given-names></name></person-group><year>1999</year><article-title>Extinction risk in the sea.</article-title><source>Trends in Ecology and Evolution</source><volume>14</volume><fpage>241</fpage><lpage>246</lpage><pub-id pub-id-type="pmid">10354629</pub-id></citation></ref><ref id="pone.0004141-Gage1"><label>10</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gage</surname><given-names>JD</given-names></name><