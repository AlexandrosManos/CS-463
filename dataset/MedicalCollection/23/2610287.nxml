ume>53</volume><fpage>303</fpage><lpage>11</lpage><pub-id pub-id-type="pmid">2908194</pub-id></citation></ref><ref id="r13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yamazaki</surname><given-names>A</given-names></name></person-group><article-title>The GTP-binding protein-dependent activation and deactivation of cyclic GMP phosphodiesterase in rod photoreceptors.</article-title><source>Adv Second Messenger Phosphoprotein Res</source><year>1992</year><volume>25</volume><fpage>135</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">1313256</pub-id></citation></ref><ref id="r14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yamazaki</surname><given-names>A</given-names></name><name><surname>Stein</surname><given-names>PJ</given-names></name><name><surname>Chernoff</surname><given-names>N</given-names></name><name><surname>Bitensky</surname><given-names>MW</given-names></name></person-group><article-title>Activation mechanism of rod outer segment cyclic GMP phosphodiesterase. Release of inhibitor by the GTP/GTP-binding protein.</article-title><source>J Biol Chem</source><year>1983</year><volume>258</volume><fpage>8188</fpage><lpage>94</lpage><pub-id pub-id-type="pmid">6305976</pub-id></citation></ref><ref id="r15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Whalen</surname><given-names>MM</given-names></name><name><surname>Bitensky</surname><given-names>MW</given-names></name></person-group><article-title>Comparison of the phosphodiesterase inhibitory subunit interactions of frog and bovine rod outer segments.</article-title><source>Biochem J</source><year>1989</year><volume>259</volume><fpage>13</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">2541680</pub-id></citation></ref><ref id="r16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><na