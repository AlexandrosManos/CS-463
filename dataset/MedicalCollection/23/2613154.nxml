<ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Segura</surname><given-names>JM</given-names></name><name><surname>Castells</surname><given-names>X</given-names></name><name><surname>Casamitjana</surname><given-names>M</given-names></name><name><surname>Macia</surname><given-names>F</given-names></name><name><surname>Ferrer</surname><given-names>F</given-names></name></person-group><article-title>Utilization of screening mammography as a preventive practice prior to initiating a population-based breast cancer screening program</article-title><source>J Clin Epidemiol</source><year>2000</year><volume>53</volume><fpage>595</fpage><lpage>603</lpage><pub-id pub-id-type="pmid">10880778</pub-id><pub-id pub-id-type="doi">10.1016/S0895-4356(99)00201-2</pub-id></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cabre</surname><given-names>A</given-names></name><name><surname>Domingo</surname><given-names>A</given-names></name></person-group><source>Demografia i Immigraci&#x000f3;, 1991&#x02013;2005</source><year>2007</year><publisher-name>Barcelona: BBVA, Departament d'Economia i Finances de la Generalitat de Catalunya</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.ced.uab.es/"/></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Borras</surname><given-names>JM</given-names></name><name><surname>Guillen</surname><given-names>M</given-names></name><name><surname>Sanchez</surname><given-names>V</given-names></name><name><surname>Junca</surname><given-names>S</given-names></name><name><surname>Vicente</surname><given-names>R</given-names></name></person-group><article-title>Educational level, voluntary private health insurance and opportunistic cancer screening among women in Catalonia (Spain)</article-title><source>Eur J Cancer Prev</source><year>1999</year><volume>8</volume><fpage>427</fpage><lpage>434</lpage><pub-id pub-id-type="pmid">10548398</pub-id></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Rogers</surname><given-names>E</given-names></name></person-group><source>Diffusion of innovations</source><year>1995</year><edition>4</edition><publisher-name>New York: Free Press</publisher-name></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>O'Brien</surname><given-names>RM</given-names></name><name><surname>Hudson</surname><given-names>K</given-names></name><name><surname>Stockard</surname><given-names>J</given-names></name></person-group><article-title>A mixed model estimation of age, period, and cohort effects</article-title><source>Soc Methods Res</source><year>2008</year><volume>36</volume><fpage>402</fpage><lpage>428</lpage><pub-id pub-id-type="doi">10.1177/0049124106290392</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Masuet</surname><given-names>C</given-names></name><name><surname>Seculi</surname><given-names>E</given-names></name><name><surname>Brugulat</surname><given-names>P</given-names></name><name><surname>Tresserras</surname><given-names>R</given-names></name></person-group><article-title>The practice of preventive mammography in Catalonia [Spain]: a step forward</article-title><source>Gac Sanit</source><year>2004</year><volume>18</volume><fpage>321</fpage><lpage>325</lpage><pub-id pub-id-type="pmid">15324643</pub-id></citation></ref><ref id="B25"><citation citation-type="book"><person-group person-group-type="author"><collab>EACP programme "Europe Against Cancer Programme"</collab></person-group><source>European Guideline for Quality Assurance in Mammography Screening</source><year>1996</year><edition>2</edition><publisher-name>Luxemburg: European Comission</publisher-name></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bare</surname><given-names>ML</given-names></name><name><surname>Montes</surname><given-names>J</given-names></name><name><surname>Florensa</surname><given-names>R</given-names></name><name><surname>Sent'is</surname><given-names>M</given-names></name><name><surname>Donoso</surname><given-names>L</given-names></name></person-group><article-title>Factors related to non-participation in a population-based breast cancer screening programme</article-title><source>Eur J Cancer Prev</source><year>2003</year><volume>12</volume><fpage>487</fpage><lpage>494</lpage><pub-id pub-id-type="pmid">14639126</pub-id><pub-id pub-id-type="doi">10.1097/00008469-200312000-00007</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Borrell</surname><given-names>C</given-names></name><name><surname>Rohlfs</surname><given-names>I</given-names></name><name><surname>Ferrando</surname><given-names>J</given-names></name><name><surname>Pasarin</surname><given-names>MI</given-names></name><name><surname>Dominguez-Berjon</surname><given-names>F</given-names></name><name><surname>Plasencia</surname><given-names>A</given-names></name></person-group><article-title>Social inequalities in perceived health and the use of health services in a southern European urban area</article-title><source>Int J Health Serv</source><year>1999</year><volume>29</volume><fpage>743</fpage><lpage>764</lpage><pub-id pub-id-type="pmid">10615572</pub-id><pub-id pub-id-type="doi">10.2190/MVW3-PJ88-LYG4-EWQT</pub-id></citation></ref></ref-list></back></article>