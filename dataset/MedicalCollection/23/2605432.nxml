nal"><person-group person-group-type="author"><name><surname>Kirigia</surname><given-names>JM</given-names></name><name><surname>Emrouznejad</surname><given-names>A</given-names></name><name><surname>Sambo</surname><given-names>LG</given-names></name><name><surname>Munguti</surname><given-names>N</given-names></name><name><surname>Liambila</surname><given-names>W</given-names></name></person-group><article-title>Using Data Envelopment Analysis to measure the technical efficiency of public health centres in Kenya</article-title><source>Journal of Medical Systems</source><year>2004</year><volume>28</volume><fpage>155</fpage><lpage>166</lpage><pub-id pub-id-type="pmid">15195846</pub-id><pub-id pub-id-type="doi">10.1023/B:JOMS.0000023298.31972.c9</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kirigia</surname><given-names>JM</given-names></name><name><surname>Emrouznejad</surname><given-names>A</given-names></name><name><surname>Sambo</surname><given-names>LG</given-names></name></person-group><article-title>Measurement of technical efficiency of public hospitals in Kenya: using data envelopment analysis</article-title><source>Journal of Medical Systems</source><year>2002</year><volume>26</volume><fpage>39</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">11777310</pub-id><pub-id pub-id-type="doi">10.1023/A:1013090804067</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zere</surname><given-names>E</given-names></name><name><surname>Mbeeli</surname><given-names>T</given-names></name><name><surname>Shangula</surname><given-names>K</given-names></name><name><surname>Mandlhate</surname><given-names>C</given-names></name><name><surname>Mutirua</surname><given-names>K</given-names></name><name><surname>Tjivambi</surname><given-names>B</given-names></name><name><surname>Kapenambili</surname><given-names>W</given-name