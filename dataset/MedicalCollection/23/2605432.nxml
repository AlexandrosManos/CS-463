n</source><year>2005</year><volume>3</volume><fpage>9</fpage><pub-id pub-id-type="pmid">16188021</pub-id><pub-id pub-id-type="doi">10.1186/1478-7547-3-9</pub-id></citation></ref><ref id="B27"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Coelli</surname><given-names>TJ</given-names></name></person-group><article-title>A guide to DEAP version 2.1: A Data Envelopment Analysis Programme</article-title><source>CEPA working paper 96/8, department of econometrics</source><year>1996</year><publisher-name>University of New England</publisher-name></citation></ref><ref id="B28"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Charnes</surname><given-names>A</given-names></name><name><surname>Cooper</surname><given-names>W</given-names></name><name><surname>Lewin</surname><given-names>AY</given-names></name><name><surname>Seiford</surname><given-names>LW</given-names></name></person-group><source>Data Envelopment Analysis: Theory</source><year>1994</year><publisher-name>Methodology and Applications Kluwer Academic Publishers</publisher-name></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zere</surname><given-names>EA</given-names></name><name><surname>Addison</surname><given-names>T</given-names></name><name><surname>McIntyre</surname><given-names>D</given-names></name></person-group><article-title>Hospital efficiency in sub-Saharan Africa: evidence from South Africa</article-title><source>South African Journal of Economics</source><year>2000</year><volume>69</volume><fpage>336</fpage><lpage>358</lpage></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kirigia</surname><given-names>JM</given-names></name><name><surname>Lambo</surname><given-names>E</given-names></name><name><surname>Sambo</surname><given-names>LG</given-names></name></person-group><article-title>Are public hospitals in Kwazulu-Natal Province of South Africa technically efficient</article-title><source>African Journal of Health Sciences</source><year>2000</year><volume>7</volume><fpage>25</fpage><lpage>32</lpage><pub-id pub-id-type="pmid">17650022</pub-id></citation></ref><ref id="B31"><citation citation-type="other"><person-group person-group-type="author"><collab>New Partnership for Africa's Development (NEPAD)</collab></person-group><article-title>Human Development Programme</article-title><source>NEPAD Health Strategy Pretoria</source><year>2001</year></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boussofiane</surname><given-names>A</given-names></name><name><surname>Dyson</surname><given-names>RG</given-names></name><name><surname>Thanassoulis</surname><given-names>E</given-names></name></person-group><article-title>Applied data envelopment analysis</article-title><source>Eur J Oper Res</source><year>1991</year><volume>53</volume><fpage>1</fpage><lpage>15</lpage><pub-id pub-id-type="doi">10.1016/0377-2217(91)90331-O</pub-id></citation></ref></ref-list></back></article>