pe="doi">10.1002/(SICI)1096-8652(199902)60:2&#x0003c;130::AID-AJH8&#x0003e;3.0.CO;2-Z</pub-id><pub-id pub-id-type="pmid">9929105</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><name><surname>Perez</surname><given-names>HD</given-names></name><name><surname>Kramer</surname><given-names>N</given-names></name><article-title>Pulmonary hypertension in systemic lupus erythematosus: report of four cases and review of the literature</article-title><source>Semin Arthritis Rheum</source><year>1981</year><volume>11</volume><fpage>177</fpage><lpage>181</lpage><pub-id pub-id-type="doi">10.1016/0049-0172(81)90098-6</pub-id><pub-id pub-id-type="pmid">7025213</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Morrison</surname><given-names>EB</given-names></name><name><surname>Gaffney</surname><given-names>FA</given-names></name><name><surname>Eigenbrodt</surname><given-names>EH</given-names></name><name><surname>Reynolds</surname><given-names>RC</given-names></name><name><surname>Buja</surname><given-names>LM</given-names></name><article-title>Severe pulmonary hypertension associated with macronodular (postnecrotic) cirrhosis and autoimmune phenomena</article-title><source>Am J Med</source><year>1980</year><volume>69</volume><fpage>513</fpage><lpage>519</lpage><pub-id pub-id-type="doi">10.1016/0002-9343(80)90461-1</pub-id><pub-id pub-id-type="pmid">7424941</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Lang</surname><given-names>JM</given-names></name><name><surname>Oberling</surname><given-names>F</given-names></name><name><surname>Mayer</surname><given-names>S</given-names></name><name><surname>Heid</surname><given-names>E</given-names></name><article-title>Auto-immunity in primary myelofibrosis</article-title><source>Biomedicine</source><year>1976</year><volume>25</volume><fpage>39</fpage><pub-id pub-id-type="pmid">963193</pub-id><