abel>16</label><citation citation-type="book"><collab>Great Britain</collab><article-title>Poor Law Commissioners</article-title><source>Seventh annual report of the Poor law commissioners, with appendices: so far as the same relate to the administration of the Irish poor relief act</source><year>1841</year><publisher-loc>London</publisher-loc><publisher-name>W Clowes &#x00026; Sons</publisher-name><fpage>A358</fpage><comment>Vaccination under 21 and 22 V.I.C</comment></citation></ref><ref id="b17"><label>17</label><citation citation-type="other"><collab>Great Britain</collab><source>Poor Law Commissioners Twenty-second and seventeenth Annual Reports of Poor Law Commission; ca 1870, 1865</source><fpage>377</fpage></citation></ref><ref id="b18"><label>18</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Creighton</surname><given-names>C</given-names></name></person-group><source>A history of epidemics in Britain</source><year>1965</year><edition>2nd ed</edition><publisher-loc>London</publisher-loc><publisher-name>Frank Cassell</publisher-name><fpage>614</fpage><lpage>6</lpage><fpage>620</fpage><comment>2 volumes</comment></citation></ref><ref id="b19"><label>19</label><citation citation-type="other"><source>Belfast Water Acts 1840-1920</source><comment>Available from the Public Record Office, Northern Ireland. WAT1/3H/1/3</comment></citation></ref><ref id="b20"><label>20</label><citation citation-type="journal"><article-title>Royal Medical &#x00026; Chirurgical Society meeting Tuesday, April 23<sup>rd</sup> 1861. McCormac H. On the true nature and absolute preventability of tubercula consumption</article-title><source>Lancet</source><year>1861</year><volume>1966</volume><fpage>434</fpage><lpage>5</lpage></citation></ref><ref id="b21"><label>21</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cassell</surname><given-names>RD</given-names></name></person-group><source>Medical chari