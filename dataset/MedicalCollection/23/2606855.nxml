n1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lin</surname><given-names>SJ</given-names></name><name><surname>Schranz</surname><given-names>J</given-names></name><name><surname>Teutsch</surname><given-names>SM</given-names></name></person-group><year>2001</year><article-title>Aspergillosis case-fatality rate: systematic review of the literature.</article-title><source>Clin Infect Dis</source><volume>32</volume><fpage>358</fpage><lpage>366</lpage><pub-id pub-id-type="pmid">11170942</pub-id></citation></ref><ref id="ppat.1000258-Talbot1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Talbot</surname><given-names>GH</given-names></name><name><surname>Bradley</surname><given-names>J</given-names></name><name><surname>Edwards</surname><given-names>JE</given-names><suffix>Jr</suffix></name><name><surname>Gilbert</surname><given-names>D</given-names></name><name><surname>Scheld</surname><given-names>M</given-names></name><etal/></person-group><year>2006</year><article-title>Bad bugs need drugs: an update on the development pipeline from the Antimicrobial Availability Task Force of the Infectious Diseases Society of America.</article-title><source>Clin Infect Dis</source><volume>42</volume><fpage>657</fpage><lpage>668</lpage><pub-id pub-id-type="pmid">16447111</pub-id></citation></ref><ref id="ppat.1000258-Robson1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Robson</surname><given-names>GD</given-names></name><name><surname>Huang</surname><given-names>J</given-names></name><name><surname>Wortman</surname><given-names>J</given-names></name><name><surname>Archer</surname><given-names>DB</given-names></name></person-group><year>2005</year><article-title>A preliminary analysis of the process of protein secretion and the diversity of putative secreted hydrolases encoded in <italic>Aspergillus fumigatus</italic>: insights from the genome.</article-title><source>Med Mycol</source><volume>43</volume><issue>Suppl 1</issue><fpage>S41</fpage><lpage>47</lpage><pub-id pub-id-type="pmid">16110791</pub-id></citation></ref><ref id="ppat.1000258-Gifford1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gifford</surname><given-names>AH</given-names></name><name><surname>Klippenstein</surname><given-names>JR</given-names></name><name><surname>Moore</surname><given-names>MM</given-names></name></person-group><year>2002</year><article-title>Serum stimulates growth of and proteinase secretion by <italic>Aspergillus fumigatus</italic>.</article-title><source>Infect Immun</source><volume>70</volume><fpage>19</fpage><lpage>26</lpage><pub-id pub-id-type="pmid">11748159</pub-id></citation></ref><ref id="ppat.1000258-Berka1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berka</surname><given-names>RM</given-names></name><name><surname>Kodama</surname><given-names>KH</given-names></name><name><surname>Rey</surname><given-names>MW</given-names></name><name><surname>Wilson</surname><given-names>LJ</given-names></name><name><surname>Ward</surname><given-names>M</given-names></name></person-group><year>1991</year><article-title>The development of <italic>Aspergillus niger</italic> var. awamori as a host for the expression and secretion of heterologous gene products.</article-title><source>Biochem Soc Trans</source><volume>19</volume><fpage>681</fpage><lpage>685</lpage><pub-id pub-id-type="pmid">1783197</pub-id></citation></ref><ref id="ppat.1000258-DunnColeman1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dunn-Coleman</surname><given-names>NS</given-names></name><name><surname>Bloebaum</surname><given-names>P</given-names></name><name><surname>Berka</surname><given-names>RM</given-names></name><name><surname>Bodie</surname><given-names>E</given-names></name><name><surname>Robinson</surname><given-names>N</given-names></name><etal/></person-group><year>1991</year><article-title>Commercial levels of chymosin production by <italic>Aspergillus</italic>.</article-title><source>Biotechnology (N Y)</source><volume>9</volume><fpage>976</fpage><lpage>981</lpage><pub-id pub-id-type="pmid">1368725</pub-id></citation></ref><ref id="ppat.1000258-Nyyssonen1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nyyssonen</surname><given-names>E</given-names></name><name><surname>Penttila</surname><given-names>M</given-names></name><name><surname>Harkki</surname><given-names>A</given-names></name><name><surname>Saloheimo</surname><given-names>A</given-names></name><name><surname>Knowles</surname><given-names>JK</given-names></name><etal/></person-group><year>1993</year><article-title>Efficient production of antibody fragments by the filamentous fungus <italic>Trichoderma reesei</italic>.</article-title><source>Biotechnology (N Y)</source><volume>11</volume><fpage>591</fpage><lpage>595</lpage><pub-id pub-id-type="pmid">7763606</pub-id></citation></ref><ref id="ppat.1000258-Romanos1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Romanos</surname><given-names>MA</given-names></name><name><surname>Scorer</surname><given-names>CA</given-names></name><name><surname>Clare</surname><given-names>JJ</given-names></name></person-group><year>1992</year><article-title>Foreign gene expression in yeast: a review.</article-title><source>Yeast</source><volume>8</volume><fpage>423</fpage><lpage>488</lpage><pub-id pub-id-type="pmid">1502852</pub-id></citation></ref><ref id="ppat.1000258-Helenius1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Helenius</surname><given-names>A</given-names></name><name><surname>Aebi</surname><give