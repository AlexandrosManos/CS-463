ink-type="uri" xlink:href="http://www.hbi.ir/"/></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Batterham</surname><given-names>MJ</given-names></name><name><surname>Garsia</surname><given-names>R</given-names></name><name><surname>Greenop</surname><given-names>P</given-names></name></person-group><article-title>Measurement of body composition in people with HIV/AIDS: a comparison of bioelectrical impedance and skinfold anthropometry with dual-energy X-ray absorptiometry</article-title><source>J Am Diet Assoc</source><year>1999</year><volume>99</volume><fpage>1109</fpage><lpage>1111</lpage><pub-id pub-id-type="pmid">10491684</pub-id><pub-id pub-id-type="doi">10.1016/S0002-8223(99)00267-9</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nakashima</surname><given-names>AK</given-names></name><name><surname>Fleming</surname><given-names>PL</given-names></name></person-group><article-title>HIV/AIDS surveillance in the United States, 1981&#x02013;2001</article-title><source>J Acquir Immune Defic Syndr</source><year>2003</year><volume>32</volume><fpage>68</fpage><lpage>85</lpage></citation></ref><ref id="B21"><citation citation-type="other"><person-group person-group-type="author"><collab>Centers for Disease Control and Prevention</collab></person-group><article-title>HIV Prevention Strategic Plan Through 2005</article-title><ext-link ext-link-type="uri" xlink:href="http://www.cdc.gov/hiv/resources/reports/PSP/pdf/prev-strat-plan.pdf"/></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nazrul Islam</surname><given-names>SK</given-names></name><name><surname>Jahangir Hossain</surname><given-names>K</given-names></name><name><surname>Ahmed</surname><given-names>A</given-names></name><name><surname>Ahsan</surname><given-names>M</given-names></name></person