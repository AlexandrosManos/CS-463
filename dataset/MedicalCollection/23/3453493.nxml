>10.1016/0035-9203(89)90241-1</pub-id><pub-id pub-id-type="pmid">2694476</pub-id></mixed-citation></ref><ref id="B10"><mixed-citation publication-type="journal"><name><surname>Morley</surname><given-names>D</given-names></name><name><surname>Woodland</surname><given-names>M</given-names></name><name><surname>Cuthberson</surname><given-names>WFJ</given-names></name><article-title>Controlled trial of pyremethamine in pregnant women in an African village</article-title><source>BMJ</source><year>1964</year><volume>1</volume><fpage>67</fpage><lpage>68</lpage></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><name><surname>Falade</surname><given-names>CO</given-names></name><name><surname>Yusuf</surname><given-names>BO</given-names></name><name><surname>Fadero</surname><given-names>FF</given-names></name><name><surname>Mokuolu</surname><given-names>OA</given-names></name><name><surname>Hamer</surname><given-names>DH</given-names></name><name><surname>Salako</surname><given-names>LA</given-names></name><article-title>Intermittent preventive treatment with sulfadoxine-pyrimethamineis effective in preventing maternal and placental malaria in Ibadan, South West Nigeria</article-title><source>Malar J</source><year>2007</year><volume>6</volume><fpage>88</fpage><pub-id pub-id-type="doi">10.1186/1475-2875-6-88</pub-id><pub-id pub-id-type="pmid">17617910</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="book"><collab>World Health Organization</collab><source>Guidelines for the treatment of malaria</source><year>2007</year><publisher-name>WHO, Geneva</publisher-name></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="book"><collab>World Health Organization</collab><source>Technical Expert Group Meeting on Intermittent Preventive Treatment in Pregnancy (IPTp)</source><year>2008</year><publisher-name>WHO, Geneva</publisher-name></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal">