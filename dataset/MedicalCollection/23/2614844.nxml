le><source>Cancer</source><year>1980</year><volume>46</volume><issue>suppl</issue><fpage>2884</fpage><lpage>2888</lpage><pub-id pub-id-type="pmid">7448733</pub-id><pub-id pub-id-type="doi">10.1002/1097-0142(19801215)46:12+&#x0003c;2884::AID-CNCR2820461429&#x0003e;3.0.CO;2-U</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ravdin</surname><given-names>PM</given-names></name><name><surname>Green</surname><given-names>S</given-names></name><name><surname>Dorr</surname><given-names>TM</given-names></name><name><surname>McGuire</surname><given-names>WL</given-names></name><name><surname>Fabian</surname><given-names>C</given-names></name><name><surname>Pugh</surname><given-names>RP</given-names></name><name><surname>Carter</surname><given-names>RD</given-names></name><name><surname>Rivkin</surname><given-names>SE</given-names></name><name><surname>Borst</surname><given-names>JR</given-names></name><name><surname>Belt</surname><given-names>RJ</given-names></name><etal></etal></person-group><article-title>Prognostic significance of progesterone receptor levels in estrogen receptor-positive patients with metastatic breast cancer treated with tamoxifen: results of a prospective Southwest Oncology Group study</article-title><source>J Clin Oncol</source><year>1992</year><volume>10</volume><fpage>1284</fpage><lpage>1291</lpage><pub-id pub-id-type="pmid">1634918</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rasmussen</surname><given-names>BB</given-names></name><name><surname>Regan</surname><given-names>MM</given-names></name><name><surname>Lykkesfeldt</surname><given-names>AE</given-names></name><name><surname>Dell'Orto</surname><given-names>P</given-names></name><name><surname>Del Curto</surname><given-names>B</given-names></name><name><surname>Henriksen</surname><given-names>KL</given-names></name><name><surname>Mast