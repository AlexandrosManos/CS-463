<pub-id pub-id-type="pmid">12004966</pub-id></citation></ref><ref id="pone.0003914-Harrison1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harrison</surname><given-names>M</given-names></name><name><surname>Abu-Elmagd</surname><given-names>M</given-names></name><name><surname>Grocott</surname><given-names>T</given-names></name><name><surname>Yates</surname><given-names>C</given-names></name><name><surname>Gavrilovic</surname><given-names>J</given-names></name><etal/></person-group><year>2004</year><article-title>Matrix metalloproteinase genes in Xenopus development.</article-title><source>Developmental dynamics</source><volume>231</volume><fpage>214</fpage><lpage>220</lpage><pub-id pub-id-type="pmid">15305302</pub-id></citation></ref><ref id="pone.0003914-Fujimoto1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fujimoto</surname><given-names>K</given-names></name><name><surname>Nakajima</surname><given-names>K</given-names></name><name><surname>Yaoita</surname><given-names>Y</given-names></name></person-group><year>2007</year><article-title>Expression of matrix metalloproteinase genes in regressing or remodeling organs during amphibian metamorphosis.</article-title><source>Development, growth &#x00026; differentiation</source><volume>49</volume><fpage>131</fpage><lpage>143</lpage></citation></ref><ref id="pone.0003914-Hasebe1"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hasebe</surname><given-names>T</given-names></name><name><surname>Hartman</surname><given-names>R</given-names></name><name><surname>Matsuda</surname><given-names>H</given-names></name><name><surname>Shi</surname><given-names>Y-B</given-names></name></person-group><year>2006</year><article-title>Spatial and temporal expression profiles suggest the involvement of gelatinase A and membrane type 1 matrix metalloproteinas