><td align="left" rowspan="1" colspan="1">3.1</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">IX Soft tissue sarcoma</td><td align="left" rowspan="1" colspan="1">56</td><td align="left" rowspan="1" colspan="1">5.4</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td colspan="2" align="left" rowspan="1">30</td><td align="left" rowspan="1" colspan="1">5.8</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">X Germ cell tumor</td><td align="left" rowspan="1" colspan="1">30</td><td align="left" rowspan="1" colspan="1">2.9</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td colspan="2" align="left" rowspan="1">18</td><td align="left" rowspan="1" colspan="1">3.5</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">XI &#x00026; XII Other tumor<xref ref-type="table-fn" rid="nt109">g</xref></td><td align="left" rowspan="1" colspan="1">12</td><td align="left" rowspan="1" colspan="1">1.2</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td colspan="2" align="left" rowspan="1">7</td><td align="left" rowspan="1" colspan="1">1.4</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Langerhans Cell Histiocytosis</td><td align="left" rowspan="1" colspan="1">47</td><td align="left" rowspan="1" colspan="1">4.5</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td colspan="2" align="left" rowspan="1">34</td><td align="left" rowspan="1" colspan="1">6.6</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Therapy</italic><xref ref-type="table-fn" rid="nt110">h</xref></td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td colspan="2" 