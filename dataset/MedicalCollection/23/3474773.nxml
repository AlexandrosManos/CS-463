d><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x02265;40</td><td colspan="2" align="left" rowspan="1">20.5</td><td align="left" rowspan="1" colspan="1">2.70</td><td align="left" rowspan="1" colspan="1">1.02</td><td align="left" rowspan="1" colspan="1">7.16</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">15.4</td><td align="left" rowspan="1" colspan="1">0.97</td><td align="left" rowspan="1" colspan="1">0.36</td><td align="left" rowspan="1" colspan="1">2.63</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Parents education</italic></td><td colspan="2" align="left" rowspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">0.035</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">0.008</td></tr><tr><td align="left" rowspan="1" colspan="1">Primary education</td><td colspan="2" align="left" rowspan="1">4.6</td><td align="left" rowspan="1" colspan="1">0.40</td><td align="left" rowspan="1" colspan="1">0.13</td><td align="left" rowspan="1" colspan="1">1.18</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">20.5</td><td align="left" rowspan="1" colspan="1">1.89</td><td align="left" rowspan="1" colspan="1">1.03</td><td align="left" rowspan="1" colspan="1">3.49</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Secondary education</td><td colspan="2" align="left" rowspan="1">9.8</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1"