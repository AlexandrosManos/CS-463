/lpage><pub-id pub-id-type="pmid">20652607</pub-id></element-citation></ref><ref id="b14-sensors-13-06477"><label>14.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kockro</surname><given-names>R.A.</given-names></name><name><surname>Hwang</surname><given-names>P.Y.</given-names></name></person-group><article-title>Virtual temporal bone: an interactive 3-dimensional learning aid for cranial base surgery</article-title><source>Neurosurgery</source><year>2009</year><volume>64</volume><fpage>216</fpage><lpage>229</lpage><pub-id pub-id-type="pmid">19404102</pub-id></element-citation></ref><ref id="b15-sensors-13-06477"><label>15.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Stadie</surname><given-names>A.T.</given-names></name><name><surname>Kockro</surname><given-names>R.A.</given-names></name><name><surname>Serra</surname><given-names>L.</given-names></name><name><surname>Fischer</surname><given-names>G.</given-names></name><name><surname>Schwandt</surname><given-names>E.</given-names></name><name><surname>Grunert</surname><given-names>P.</given-names></name><name><surname>Reisch</surname><given-names>R.</given-names></name></person-group><article-title>Neurosurgical craniotomy localization using a virtual reality planning system versus intraoperative image-guided navigation</article-title><source>Int. J. Comput. Assist. Radiol. Surg.</source><year>2011</year><volume>6</volume><fpage>565</fpage><lpage>572</lpage><pub-id pub-id-type="pmid">20809398</pub-id></element-citation></ref><ref id="b16-sensors-13-06477"><label>16.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rosset</surname><given-names>A.</given-names></name><name><surname>Spadola</surname><given-names>L.</given-names></name><name><surname>Ratib</surname><given-names>O.</given-names></name></person-group><article-title>OsiriX: An open-source software for navigating in multidimensional DICOM images</article-title><source>J. Digit Imag.</source><year>2004</year><volume>17</volume><fpage>205</fpage><lpage>216</lpage></element-citation></ref><ref id="b17-sensors-13-06477"><label>17.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Beyer</surname><given-names>J.</given-names></name><name><surname>Hadwiger</surname><given-names>M.</given-names></name><name><surname>Wolfsberger</surname><given-names>S.</given-names></name><name><surname>B&#x000fc;hler</surname><given-names>K.</given-names></name></person-group><article-title>High-quality multimodal volume rendering for preoperative planning of neurosurgical interventions</article-title><source>IEEE Trans. Vis. Comput. Graph.</source><year>2007</year><volume>13</volume><fpage>1696</fpage><lpage>1703</lpage><pub-id pub-id-type="pmid">17968127</pub-id></element-citation></ref><ref id="b18-sensors-13-06477"><label>18.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Paleologos</surname><given-names>T.S.</given-names></name><name><surname>Wadley</surname><given-names>J.P.</given-names></name><name><surname>Kitchen</surname><given-names>N.D.</given-names></name><name><surname>Thomas</surname><given-names>D.G.</given-names></name></person-group><article-title>Clinical utility and cost- effectiveness of interactive image-guided craniotomy: Clinical comparison between conventional and image-guided meningioma surgery</article-title><source>Neurosurgery</source><year>2000</year><volume>47</volume><fpage>40</fpage><lpage>47</lpage><pub-id pub-id-type="pmid">10917345</pub-id></element-citation></ref><ref id="b19-sensors-13-06477"><label>19.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Pieper</surname><given-names>S.</given-names></name><name><surname>Lorensen</surname><given-name