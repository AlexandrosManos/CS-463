tation citation-type="journal"><person-group person-group-type="author"><name><surname>Dale</surname><given-names>JB</given-names></name><name><surname>Chiang</surname><given-names>EY</given-names></name><name><surname>Liu</surname><given-names>S</given-names></name><name><surname>Courtney</surname><given-names>HS</given-names></name><name><surname>Hasty</surname><given-names>DL</given-names></name></person-group><year>1999</year><article-title>New protective antigen of group A streptococci.</article-title><source>J Clin Invest</source><volume>103</volume><fpage>1261</fpage><lpage>1268</lpage><pub-id pub-id-type="pmid">10225969</pub-id></citation></ref><ref id="pone.0004166-Maguin1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maguin</surname><given-names>E</given-names></name><name><surname>Prevost</surname><given-names>H</given-names></name><name><surname>Ehrlich</surname><given-names>SD</given-names></name><name><surname>Gruss</surname><given-names>A</given-names></name></person-group><year>1996</year><article-title>Efficient insertional mutagenesis in lactococci and other gram-positive bacteria.</article-title><source>J Bacteriol</source><volume>178</volume><fpage>931</fpage><lpage>935</lpage><pub-id pub-id-type="pmid">8550537</pub-id></citation></ref><ref id="pone.0004166-Lancefield1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lancefield</surname><given-names>RC</given-names></name></person-group><year>1928</year><article-title>The antigenic complex of Streptococcus hemolyticus, I Demonstration of a type-specific substance in extracts of Streptococcus hemolyticus.</article-title><source>J Exp Med</source><volume>47</volume><fpage>9</fpage><lpage>10</lpage></citation></ref><ref id="pone.0004166-Chaffin1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chaffin</surname><given-names