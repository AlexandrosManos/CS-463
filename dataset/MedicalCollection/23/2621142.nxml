></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gerety</surname><given-names>RJ</given-names></name><name><surname>Smallwood</surname><given-names>LA</given-names></name><name><surname>Finlayson</surname><given-names>JS</given-names></name><name><surname>Tabor</surname><given-names>E</given-names></name></person-group><article-title>Standardization of the antibody to hepatitis A virus (anti-HAV) content of immunoglobulin</article-title><source>Dev Biol Stand</source><year>1983</year><volume>54</volume><fpage>411</fpage><lpage>416</lpage><pub-id pub-id-type="pmid">6317492</pub-id></citation></ref></ref-list></back></article>