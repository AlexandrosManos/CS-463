S Med</source><year>2005</year><volume>2</volume><fpage>e166</fpage><pub-id pub-id-type="pmid">15913387</pub-id><pub-id pub-id-type="doi">10.1371/journal.pmed.0020166</pub-id></citation></ref></ref-list></back></article>