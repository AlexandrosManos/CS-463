-title>Participation in a Gendered Environment: The Case of Community Forestry in India</article-title><source>Human Ecology</source><year>2004</year><volume>32</volume><fpage>365</fpage><lpage>381</lpage><pub-id pub-id-type="doi">10.1023/B:HUEC.0000028086.63366.3d</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Voeks</surname><given-names>RA</given-names></name></person-group><article-title>Are women reservoirs of traditional plant knowledge? Gender, Ethnobotany and globalization in northeast Brazil</article-title><source>Singapore Journal of Tropical Geography</source><year>2007</year><volume>28</volume><fpage>7</fpage><lpage>20</lpage><pub-id pub-id-type="doi">10.1111/j.1467-9493.2006.00273.x</pub-id></citation></ref><ref id="B28"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Vazquez-Garc&#x000ed;a</surname><given-names>V</given-names></name></person-group><article-title>Gender, ethnicity, and economic status in plant management: Uncultivated edible plant among the Nahuas and Popolucas of Veracruz, M&#x000e9;xico</article-title><source>Agriculture and Human Values</source><year>2007</year><comment></comment></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parlee</surname><given-names>B</given-names></name><name><surname>Berkes</surname><given-names>F</given-names></name><collab>the Teetl it Gwich in Renewable Resources Council</collab></person-group><article-title>Health of the Land, Health of the People: A Case Study on Gwich'in Berry Harvesting in Northern Canada</article-title><source>EcoHealth</source><year>2005</year><volume>2</volume><fpage>127</fpage><lpage>137</lpage><pub-id pub-id-type="doi">10.1007/s10393-005-3870-z</pub-id></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Salick</surname><gi