ystem</article-title><source>Ugeskr Laeger</source><year>1999</year><volume>16</volume><fpage>4740</fpage><lpage>4743</lpage><pub-id pub-id-type="pmid">10500461</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bruunsgaard</surname><given-names>H</given-names></name><name><surname>Andersen-Ranberg</surname><given-names>K</given-names></name><name><surname>Jeune</surname><given-names>B</given-names></name><name><surname>Pedersen</surname><given-names>AN</given-names></name><name><surname>Skinh&#x000f8;j</surname><given-names>P</given-names></name><name><surname>Pedersen</surname><given-names>BK</given-names></name></person-group><article-title>A high plasma concentration of TNF-alpha is associated with dementia in centenarians</article-title><source>J Gerontol A Biol Sci Med Sci</source><year>1999</year><volume>54</volume><fpage>M357</fpage><lpage>64</lpage><pub-id pub-id-type="pmid">10462168</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zanni</surname><given-names>F</given-names></name><name><surname>Vescovini</surname><given-names>R</given-names></name><name><surname>Biasini</surname><given-names>C</given-names></name><name><surname>Fagnoni</surname><given-names>F</given-names></name><name><surname>Zanlari</surname><given-names>L</given-names></name><name><surname>Telera</surname><given-names>A</given-names></name><name><surname>Di Pede</surname><given-names>P</given-names></name><name><surname>Passeri</surname><given-names>G</given-names></name><name><surname>Pedrazzoni</surname><given-names>M</given-names></name><name><surname>Passeri</surname><given-names>M</given-names></name><name><surname>Franceschi</surname><given-names>C</given-names></name><name><surname>Sansoni</surname><given-names>P</given-names></name></person-group><article-title>Marked increase with age of type 1 cytokines within memory and 