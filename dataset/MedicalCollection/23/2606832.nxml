n="bottom"><italic>P</italic></th><th colspan="1" rowspan="1" align="center" valign="bottom">Positive paternal history of type 2 diabetes</th><th colspan="1" rowspan="1" align="center" valign="bottom"><italic>P</italic></th></tr></thead><tbody><tr><td colspan="1" rowspan="1" align="left" valign="top"><italic>n</italic></td><td colspan="1" rowspan="1" align="center" valign="top">1,240</td><td colspan="1" rowspan="1" align="center" valign="top">620</td><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top">327</td><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top">248</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Male sex</td><td colspan="1" rowspan="1" align="center" valign="top">50</td><td colspan="1" rowspan="1" align="center" valign="top">49</td><td colspan="1" rowspan="1" align="center" valign="top">0.431</td><td colspan="1" rowspan="1" align="center" valign="top">49</td><td colspan="1" rowspan="1" align="center" valign="top">0.688</td><td colspan="1" rowspan="1" align="center" valign="top">49</td><td colspan="1" rowspan="1" align="char" char="." valign="top">0.711</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Age (years)</td><td colspan="1" rowspan="1" align="center" valign="top">43.4 &#x000b1; 10.0</td><td colspan="1" rowspan="1" align="center" valign="top">43.9 &#x000b1; 10.2</td><td colspan="1" rowspan="1" align="center" valign="top">0.344</td><td colspan="1" rowspan="1" align="center" valign="top">46.1 &#x000b1; 10.1</td><td colspan="1" rowspan="1" align="center" valign="top">&#x0003c;0.001</td><td colspan="1" rowspan="1" align="center" valign="top">40.8 &#x000b1; 9.7</td><td colspan="1" rowspan="1" align="char" char="." valign="top">&#x0003c;0.001</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Age at onset of diabetes (yea