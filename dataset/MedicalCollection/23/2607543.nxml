><name><surname>Pluymers</surname><given-names>W</given-names></name><name><surname>Busschots</surname><given-names>K</given-names></name><name><surname>De Clercq</surname><given-names>E</given-names></name><etal/></person-group><year>2003</year><article-title>LEDGF/p75 is essential for nuclear and chromosomal targeting of HIV-1 integrase in human cells.</article-title><source>J Biol Chem</source><volume>278</volume><fpage>33528</fpage><lpage>33539</lpage><pub-id pub-id-type="pmid">12796494</pub-id></citation></ref><ref id="pone.0004155-Butler1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Butler</surname><given-names>SL</given-names></name><name><surname>Hansen</surname><given-names>MS</given-names></name><name><surname>Bushman</surname><given-names>FD</given-names></name></person-group><year>2001</year><article-title>A quantitative assay for HIV DNA integration in vivo.</article-title><source>Nat Med</source><volume>7</volume><fpage>631</fpage><lpage>634</lpage><pub-id pub-id-type="pmid">11329067</pub-id></citation></ref><ref id="pone.0004155-Gelderblom1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gelderblom</surname><given-names>HC</given-names></name><name><surname>Vatakis</surname><given-names>DN</given-names></name><name><surname>Burke</surname><given-names>SA</given-names></name><name><surname>Lawrie</surname><given-names>SD</given-names></name><name><surname>Bristol</surname><given-names>GC</given-names></name><etal/></person-group><year>2008</year><article-title>Viral complementation allows HIV-1 replication without integration.</article-title><source>Retrovirology</source><volume>5</volume><fpage>60</fpage><pub-id pub-id-type="pmid">18613957</pub-id></citation></ref><ref id="pone.0004155-Odawara1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Odawara</surname><given-names>