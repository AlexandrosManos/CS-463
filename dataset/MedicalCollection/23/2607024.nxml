"author"><name><surname>Thomarat</surname><given-names>F</given-names></name><name><surname>Vivar&#x000e9;s</surname><given-names>CP</given-names></name><name><surname>Gouy</surname><given-names>M</given-names></name></person-group><year>2004</year><article-title>Phylogenetic analysis of the complete genome sequence of <italic>Encephalitozoon cuniculi</italic> supports the fungal origin of microsporidia and reveals a high frequency of fast-evolving genes.</article-title><source>J Mol Evol</source><volume>59</volume><fpage>780</fpage><lpage>791</lpage><pub-id pub-id-type="pmid">15599510</pub-id></citation></ref><ref id="ppat.1000261-Weiss1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weiss</surname><given-names>LM</given-names></name></person-group><year>2001</year><article-title>Microsporidia: emerging pathogenic protists.</article-title><source>Acta Trop</source><volume>78</volume><fpage>89</fpage><lpage>102</lpage><pub-id pub-id-type="pmid">11230819</pub-id></citation></ref><ref id="ppat.1000261-Didier2"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Didier</surname><given-names>ES</given-names></name><name><surname>Stovall</surname><given-names>ME</given-names></name><name><surname>Green</surname><given-names>LC</given-names></name><name><surname>Brindley</surname><given-names>PJ</given-names></name><name><surname>Sestak</surname><given-names>K</given-names></name><etal/></person-group><year>2004</year><article-title>Epidemiology of microsporidiosis: sources and modes of transmission.</article-title><source>Vet Parasitol</source><volume>126</volume><fpage>145</fpage><lpage>166</lpage><pub-id pub-id-type="pmid">15567583</pub-id></citation></ref><ref id="ppat.1000261-Didier3"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Didier</surname><given-names>ES</given-names></name><name><surname>Didier</surname><given-names>PJ</given-names></name><name><surname>Snowden</surname><given-names>KF</given-names></name><name><surname>Shadduck</surname><given-names>JA</given-names></name></person-group><year>2000</year><article-title>Microsporidiosis in mammals.</article-title><source>Microbes Infect</source><volume>2</volume><fpage>709</fpage><lpage>720</lpage><pub-id pub-id-type="pmid">10884622</pub-id></citation></ref><ref id="ppat.1000261-Franzen1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Franzen</surname><given-names>C</given-names></name><name><surname>Muller</surname><given-names>A</given-names></name></person-group><year>2001</year><article-title>Microsporidiosis: human diseases and diagnosis.</article-title><source>Microbes Infect</source><volume>3</volume><fpage>389</fpage><lpage>400</lpage><pub-id pub-id-type="pmid">11369276</pub-id></citation></ref><ref id="ppat.1000261-Vavra1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vavra</surname><given-names>J</given-names></name><name><surname>Yachnis</surname><given-names>AT</given-names></name><name><surname>Shadduck</surname><given-names>JA</given-names></name><name><surname>Orenstein</surname><given-names>JM</given-names></name></person-group><year>1998</year><article-title>Microsporidia of the genus <italic>Trachipleistophora</italic>&#x02014;causative agents of human microsporidiosis: description of <italic>Trachipleistophora anthropophthera</italic> n. sp. (Protozoa: Microsporidia).</article-title><source>J Eukaryot Microbiol</source><volume>45</volume><fpage>273</fpage><lpage>283</lpage><pub-id pub-id-type="pmid">9627987</pub-id></citation></ref><ref id="ppat.1000261-Weber1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weber</surname><given-names>R</given-names></name><name><surname>Mathis</surname><given-names>A