>15854878</pub-id><pub-id pub-id-type="doi">10.1016/S1473-3099(05)70092-X</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haines</surname><given-names>A</given-names></name><name><surname>Patz</surname><given-names>JA</given-names></name></person-group><article-title>Health effects of climate change</article-title><source>JAMA</source><year>2004</year><volume>291</volume><fpage>99</fpage><lpage>103</lpage><pub-id pub-id-type="pmid">14709582</pub-id><pub-id pub-id-type="doi">10.1001/jama.291.1.99</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haines</surname><given-names>A</given-names></name><name><surname>Kovats</surname><given-names>RS</given-names></name><name><surname>Campbell-Lendrum</surname><given-names>D</given-names></name><name><surname>Corvalan</surname><given-names>C</given-names></name></person-group><article-title>Climate change and human health: impacts, vulnerability and public health</article-title><source>Public Health</source><year>2006</year><volume>120</volume><fpage>585</fpage><lpage>596</lpage><pub-id pub-id-type="pmid">16542689</pub-id><pub-id pub-id-type="doi">10.1016/j.puhe.2006.01.002</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haines</surname><given-names>A</given-names></name></person-group><article-title>Global warming and vector-borne disease</article-title><source>Lancet</source><year>1998</year><volume>351</volume><fpage>1737</fpage><lpage>1738</lpage><pub-id pub-id-type="pmid">9734919</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(05)77778-3</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Githeko</surname><given-names>AK</given-names></name><name><surname>Lindsay</surname><given-names>SW</given-names></name><name><surname>Confalonieri</surname><given-names>UE</given-names></name><name><surname>Patz</surname><given-names>JA</given-names></name></person-group><article-title>Climate change and vector-borne diseases: a regional analysis</article-title><source>Bull World Health Organ</source><year>2000</year><volume>78</volume><fpage>1136</fpage><lpage>1147</lpage><pub-id pub-id-type="pmid">11019462</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Epstein</surname><given-names>PR</given-names></name></person-group><article-title>Climate change and human health</article-title><source>N Engl J Med</source><year>2005</year><volume>353</volume><fpage>1433</fpage><lpage>1436</lpage><pub-id pub-id-type="pmid">16207843</pub-id><pub-id pub-id-type="doi">10.1056/NEJMp058079</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Epstein</surname><given-names>PR</given-names></name></person-group><article-title>Is global warming harmful to health?</article-title><source>Sci Am</source><year>2000</year><volume>283</volume><fpage>50</fpage><lpage>57</lpage><pub-id pub-id-type="pmid">10914399</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Epstein</surname><given-names>PR</given-names></name></person-group><article-title>Global warming and vector-borne disease</article-title><source>Lancet</source><year>1998</year><volume>351</volume><fpage>1737</fpage><comment>author reply 1738</comment><pub-id pub-id-type="pmid">9734918</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(05)77777-1</pub-id></citation></ref><ref id="B25"><citation citation-type="book"><person-group person-group-type="author"><collab>Intergovernmental Panel on Climate Change I</collab></person-group><source>Impacts, adaptations and mitigation of climate change: scientific-technical ana