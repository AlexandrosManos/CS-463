-type="journal"><person-group person-group-type="author"><name><surname>Lyou</surname><given-names>CY</given-names></name><name><surname>Yang</surname><given-names>SK</given-names></name><name><surname>Choe</surname><given-names>DH</given-names></name><name><surname>Lee</surname><given-names>BH</given-names></name><name><surname>Kim</surname><given-names>KH</given-names></name></person-group><article-title>Mammographic and sonographic findings of primary breast lymphoma</article-title><source>Clin Imaging</source><year>2007</year><volume>31</volume><fpage>234</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">17599616</pub-id><pub-id pub-id-type="doi">10.1016/j.clinimag.2007.02.028</pub-id></citation></ref></ref-list></back></article>