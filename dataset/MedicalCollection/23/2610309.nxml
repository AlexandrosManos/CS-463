/><th colspan="1" rowspan="1" align="center" valign="top"/><th colspan="1" rowspan="1" align="center" valign="top"><bold>Genotype A</bold></th><th colspan="1" rowspan="1" align="center" valign="top"><bold>Genotype B</bold></th></tr></thead><tbody><tr><td colspan="1" rowspan="1" align="left" valign="top"> 1 </td><td colspan="1" rowspan="1" align="left" valign="top"> Grape </td><td colspan="1" rowspan="1" align="left" valign="top"><italic>Vitis vinifera</italic></td><td colspan="1" rowspan="1" align="left" valign="top"> Nakornratchasima; Thailand </td><td colspan="1" rowspan="1" align="left" valign="top"> 41 </td><td colspan="1" rowspan="1" align="center" valign="top"> - </td><td colspan="1" rowspan="1" align="center" valign="top"> - </td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top"> 2 </td><td colspan="1" rowspan="1" align="left" valign="top"> Yellow papaya </td><td colspan="1" rowspan="1" align="left" valign="top"><italic>Carica papaya</italic></td><td colspan="1" rowspan="1" align="left" valign="top"> Bangkok; Thailand </td><td colspan="1" rowspan="1" align="left" valign="top"> 25 </td><td colspan="1" rowspan="1" align="center" valign="top"> - </td><td colspan="1" rowspan="1" align="center" valign="top"> - </td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="left" valign="top"> Green papaya </td><td colspan="1" rowspan="1" align="left" valign="top"><italic>Carica papaya</italic></td><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="left" valign="top"> 17 </td><td colspan="1" rowspan="1" align="center" valign="top"> - </td><td colspan="1" rowspan="1" align="center" valign="top"> - </td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top"/><td colspan="1" rowspan="1" align="left" valign="top"> Papaya with antrachnose disease </td><td colspan="1" rowspan="1" align="left" valign="top"><italic>Carica papaya</italic></td><td colspan="1" rowspan="1" align