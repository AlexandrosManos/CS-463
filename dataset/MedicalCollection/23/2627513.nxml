 rowspan="1" colspan="1">OR (95% CI)</th></tr></thead><tbody><tr><td rowspan="2" align="center" valign="middle" colspan="1"><bold>AST </bold></td><td align="center" rowspan="1" colspan="1">Male gender</td><td align="center" rowspan="1" colspan="1">6.31 (1.74-22.85)</td><td align="center" rowspan="1" colspan="1">Total cholesterol<xref ref-type="table-fn" rid="T2FN2">1</xref></td><td align="center" rowspan="1" colspan="1">0.76 (0.61-0.93)</td></tr><tr><td align="center" rowspan="1" colspan="1">CD8<sup>+</sup><xref ref-type="table-fn" rid="T2FN3">2</xref></td><td align="center" rowspan="1" colspan="1">0.43 (0.24-0.76)</td><td align="center" rowspan="1" colspan="1">Age<xref ref-type="table-fn" rid="T2FN4">3</xref></td><td align="center" rowspan="1" colspan="1">1.42 (1.06-1.89)</td></tr><tr><td rowspan="3" align="center" valign="middle" colspan="1"><bold>ALT </bold></td><td align="center" rowspan="1" colspan="1">Male gender</td><td align="center" rowspan="1" colspan="1">6.06 (2.14-17.12)</td><td align="center" rowspan="1" colspan="1">Total cholesterol<xref ref-type="table-fn" rid="T2FN2">1</xref></td><td align="center" rowspan="1" colspan="1">0.79 (0.65-0.97)</td></tr><tr><td align="center" rowspan="1" colspan="1">Age<xref ref-type="table-fn" rid="T2FN4">3</xref></td><td align="center" rowspan="1" colspan="1">0.61 (0.43-0.85)</td><td align="center" rowspan="1" colspan="1">CD4<sup>+</sup><xref ref-type="table-fn" rid="T2FN3">2</xref></td><td align="center" rowspan="1" colspan="1">1.23 (1.02-1.48)</td></tr><tr><td align="center" rowspan="1" colspan="1">BMI</td><td align="center" rowspan="1" colspan="1">1.16 (1.02-1.31)</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td align="center" rowspan="1" colspan="1"><bold>GGT</bold></td><td align="center" rowspan="1" colspan="1">Alcohol consumption</td><td align="center" rowspan="1" colspan="1">3.78 (1.56-9.19)</td><td align="center" rowspan="1" colspan="1">Alcohol consumption</td><td align="center" rowspan="1" colspan="1">2.01 (1.02-3.97)</td></tr></tbody></table><table-wrap-foot><fn id="T2FN1"><p>NOTE. All models were adjusted for gender, alcohol consumption, duration of injection drug use, BMI, total cholesterol, CD4<sup>+</sup> and CD8<sup>+</sup> cell counts. Only significant factors associated with liver enzyme elevations are shown (<italic>P</italic>&#x0003c;0.05).</p></fn><fn id="T2FN2"><label>1</label><p>OR for an increase of 20 mg/100ml in total cholesterol.</p></fn><fn id="T2FN3"><label>2</label><p> OR for an increase of 0.25*Log<sub>10</sub> in CD4+ and CD8+ cells.</p></fn><fn id="T2FN4"><label>3</label><p>OR for five years of age increase.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>