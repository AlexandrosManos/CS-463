source><year>1993</year><volume>100</volume><fpage>230</fpage><lpage>237</lpage><pub-id pub-id-type="pmid">8437832</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Good</surname><given-names>WV</given-names></name></person-group><article-title>Revised Indications for the Treatment of Retinopathy of Prematurity. Results of the Early Treatment for Retinopathy of Prematurity Randomized Trial</article-title><source>Arch Ophthalmol</source><year>2003</year><volume>121</volume><fpage>1684</fpage><lpage>1696</lpage><pub-id pub-id-type="pmid">14662586</pub-id><pub-id pub-id-type="doi">10.1001/archopht.121.12.1684</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><collab>Cryotherapy for Retinopathy of Prematurity Cooperative Group</collab></person-group><article-title>Multicenter trial of cryotherapy for retinopathy of prematurity: ophthalmological outcomes at 10 years</article-title><source>Arch Ophthalmol</source><year>2001</year><volume>119</volume><fpage>1110</fpage><lpage>33</lpage><pub-id pub-id-type="pmid">11483076</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hardy</surname><given-names>RJ</given-names></name><name><surname>Palmer</surname><given-names>EA</given-names></name><name><surname>Dobson</surname><given-names>V</given-names></name></person-group><article-title>Risk Analysis of Prethreshold Retinopathy of Prematurity</article-title><source>Archives of Ophthalmology</source><year>2003</year><volume>121</volume><fpage>1697</fpage><lpage>1701</lpage><pub-id pub-id-type="pmid">14662587</pub-id><pub-id pub-id-type="doi">10.1001/archopht.121.12.1697</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coats</surname><given-names>DK</given-names></name></person-group><article-title>Involution of Retinopathy of Prematurity After Laser Treatment: Factors Associated With Development of Retinal Detachment</article-title><source>Am J Ophthalmol</source><year>2005</year><volume>140</volume><fpage>214</fpage><lpage>222</lpage><pub-id pub-id-type="pmid">16086945</pub-id><pub-id pub-id-type="doi">10.1016/j.ajo.2004.12.106</pub-id></citation></ref></ref-list></back></article>