">46.2</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Central</td><td align="left" rowspan="1" colspan="1">20,262</td><td align="left" rowspan="1" colspan="1">26.3</td><td align="left" rowspan="1" colspan="1">20,600</td><td align="left" rowspan="1" colspan="1">26.7</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Southern</td><td align="left" rowspan="1" colspan="1">18,375</td><td align="left" rowspan="1" colspan="1">23.8</td><td align="left" rowspan="1" colspan="1">18,262</td><td align="left" rowspan="1" colspan="1">23.7</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Eastern</td><td align="left" rowspan="1" colspan="1">2,436</td><td align="left" rowspan="1" colspan="1">3.2</td><td align="left" rowspan="1" colspan="1">2,556</td><td align="left" rowspan="1" colspan="1">3.4</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Cardiac arrhythmias</td><td align="left" rowspan="1" colspan="1">9,911</td><td align="left" rowspan="1" colspan="1">12.9</td><td align="left" rowspan="1" colspan="1">4,745</td><td align="left" rowspan="1" colspan="1">6.2</td><td align="left" rowspan="1" colspan="1">&#x0003c;0.001</td></tr><tr><td align="left" rowspan="1" colspan="1">Congestive heart failure</td><td align="left" rowspan="1" colspan="1">6,314</td><td align="left" rowspan="1" colspan="1">8.2</td><td align="left" rowspan="1" colspan="1">3,110</td><td align="left" rowspan="1" colspan="1">4.0</td><td align="left" rowspan="1" colspan="1">&#x0003c;0.001</td></tr><tr><td align="left" rowspan="1" colspan="1">Valvular disease</td><td align="left" rowspan="1" colspan="1">1,926</td><td align="left" rowspan="1" colspan="1">2.5</td><td align="left" rowspan="1" colspan="1">847</td><td align="left" rowspan="1" colspan="1">1.1</td><td align="left" rowspan="1" colspan="1">&#x0003c;0.001</td></tr><tr><td align="lef