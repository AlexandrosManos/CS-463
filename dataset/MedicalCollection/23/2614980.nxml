id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dee</surname><given-names>SA</given-names></name><name><surname>Molitor</surname><given-names>TW</given-names></name><name><surname>Rossow</surname><given-names>KD</given-names></name></person-group><article-title>Epidemiological and diagnostic observations following the elimination of porcine reproductive and respiratory syndrome virus from a breeding herd of pigs by the test and removal protocol</article-title><source>Vet Rec</source><year>2000</year><volume>146</volume><fpage>211</fpage><lpage>213</lpage><pub-id pub-id-type="pmid">10731069</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nodelijk</surname><given-names>G</given-names></name><name><surname>De Jong</surname><given-names>MCM</given-names></name><name><surname>Van Nes</surname><given-names>A</given-names></name><name><surname>Vernooy</surname><given-names>JCM</given-names></name><name><surname>Van Leengoed</surname><given-names>LAMG</given-names></name><name><surname>Pol</surname><given-names>JMA</given-names></name><name><surname>Verheijden</surname><given-names>JHM</given-names></name></person-group><article-title>Introduction, persistence and fade-out of porcine reproductive and respiratory syndrome virus in a Dutch breeding herd: A mathematical analysis</article-title><source>Epidemiology and Infection</source><year>2000</year><volume>124</volume><fpage>173</fpage><lpage>182</lpage><pub-id pub-id-type="pmid">10722145</pub-id><pub-id pub-id-type="doi">10.1017/S0950268899003246</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dee</surname><given-names>SA</given-names></name><name><surname>Joo</surname><given-names>HS</given-names></name></person-group><article-title>Prevention of the spread of porcine reproductive and res