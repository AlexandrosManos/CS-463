l"><person-group person-group-type="author"><name><surname>Spijkerman</surname><given-names>IJ</given-names></name><name><surname>van Ameijden</surname><given-names>EJ</given-names></name><name><surname>Mientjes</surname><given-names>GH</given-names></name><name><surname>Coutinho</surname><given-names>RA</given-names></name><name><surname>Hoek</surname><given-names>A van den</given-names></name></person-group><article-title>Human immunodeficiency virus infection and other risk factors for skin abscesses and endocarditis among injection drug users</article-title><source>J Clin Epidemiol</source><year>1996</year><volume>49</volume><fpage>1149</fpage><lpage>54</lpage><pub-id pub-id-type="pmid">8826995</pub-id><pub-id pub-id-type="doi">10.1016/0895-4356(96)00180-1</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tyndall</surname><given-names>M</given-names></name><name><surname>Kerr</surname><given-names>T</given-names></name><name><surname>Zhang</surname><given-names>R</given-names></name><name><surname>King</surname><given-names>E</given-names></name><name><surname>Montaner</surname><given-names>JG</given-names></name><name><surname>Wood</surname><given-names>E</given-names></name></person-group><article-title>Attendance, drug use patterns, and referrals made from North America's first supervised injection facility</article-title><source>Drug Alcohol Depend</source><year>2005</year><volume>83</volume><fpage>193</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">16356659</pub-id><pub-id pub-id-type="doi">10.1016/j.drugalcdep.2005.11.011</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wood</surname><given-names>E</given-names></name><name><surname>Kerr</surname><given-names>T</given-names></name><name><surname>Lloyd-Smith</surname><given-names>E</given-names></name><name><surname>Buchner</surname><given-names>C</