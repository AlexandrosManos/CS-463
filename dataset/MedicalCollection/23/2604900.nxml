><name><surname>Hirono</surname><given-names>N</given-names></name><name><surname>Hashimoto</surname><given-names>M</given-names></name><name><surname>Yasuda</surname><given-names>M</given-names></name><name><surname>Ishii</surname><given-names>K</given-names></name><name><surname>Sakamoto</surname><given-names>S</given-names></name><name><surname>Kazui</surname><given-names>H</given-names></name><name><surname>Mori</surname><given-names>E</given-names></name></person-group><article-title>The effect of APOE epsilon4 allele on cerebral glucose metabolism in AD is a function of age at onset</article-title><source>Neurology</source><year>2002</year><volume>58</volume><fpage>743</fpage><lpage>750</lpage><pub-id pub-id-type="pmid">11889238</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hirono</surname><given-names>N</given-names></name><name><surname>Mori</surname><given-names>E</given-names></name><name><surname>Yasuda</surname><given-names>M</given-names></name><name><surname>Ishii</surname><given-names>K</given-names></name><name><surname>Ikejiri</surname><given-names>Y</given-names></name><name><surname>Imamura</surname><given-names>T</given-names></name><name><surname>Shimomura</surname><given-names>T</given-names></name><name><surname>Hashimoto</surname><given-names>M</given-names></name><name><surname>Yamashita</surname><given-names>H</given-names></name><name><surname>Sasaki</surname><given-names>M</given-names></name></person-group><article-title>Lack of association of apolipoprotein E epsilon4 allele dose with cerebral glucose metabolism in Alzheimer disease</article-title><source>Alzheimer Dis Assoc Disord</source><year>1998</year><volume>12</volume><fpage>362</fpage><lpage>367</lpage><pub-id pub-id-type="pmid">9876966</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mosconi</surname><given-names>L</g