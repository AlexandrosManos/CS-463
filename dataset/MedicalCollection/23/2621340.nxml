"><label>26</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Waite</surname><given-names>AE</given-names></name></person-group><year>1976</year><source>The Hermetic and Alchemical Writings of Paracelsus</source><publisher-loc>Berkeley</publisher-loc><publisher-name>Shambhala Publ</publisher-name><fpage>159</fpage></citation></ref><ref id="pone.0004245-Sjostrom1"><label>27</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Sjostrom</surname><given-names>E</given-names></name></person-group><year>1989</year><source>Wood Chemistry</source><publisher-loc>New York</publisher-loc><publisher-name>Academic Press</publisher-name><fpage>11</fpage></citation></ref><ref id="pone.0004245-Winandy1"><label>28</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Winandy</surname><given-names>JE</given-names></name><name><surname>Rowell</surname><given-names>RM</given-names></name></person-group><year>1984</year><article-title>The chemistry of wood strength, chapt.11,</article-title><person-group person-group-type="editor"><name><surname>Rowell</surname><given-names>RM</given-names></name></person-group><source>The Chemistry of Solid Wood, Advan. in Chemistry Series 207.</source><publisher-loc>Washington DC</publisher-loc><fpage>239</fpage></citation></ref><ref id="pone.0004245-Barnes1"><label>29</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barnes</surname><given-names>HM</given-names></name><name><surname>Windandy</surname><given-names>JE</given-names></name></person-group><year>1986</year><article-title>Effect of preservatives on the properties of treated wood.</article-title><source>Amer Wood Preserv Assoc Proc</source><volume>82</volume><fpage>95</fpage><lpage>104</lpage></citation></ref><ref id="pone.0004245-www.nagyvaryviolins.com1"><label>30</label><citation citation-type="other"><ext-link ext-link