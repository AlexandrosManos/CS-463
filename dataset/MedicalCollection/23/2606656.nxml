fibrosis</article-title><source>AJDC</source><year>1989</year><volume>143</volume><fpage>944</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">2502909</pub-id></citation></ref><ref id="R9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Graft</surname><given-names>DF</given-names></name><name><surname>Mischler</surname><given-names>E</given-names></name><name><surname>Farell</surname><given-names>PM</given-names></name><etal/></person-group><article-title>Granulocyte chemiluminescence in adolescent patients with cystic fibrosis</article-title><source>ARRD</source><year>1982</year><volume>125</volume><fpage>540</fpage><lpage>4</lpage></citation></ref><ref id="R10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kemp</surname><given-names>T</given-names></name><name><surname>Doumont</surname><given-names>A</given-names></name><name><surname>Van Geffel</surname><given-names>R</given-names></name><etal/></person-group><article-title>Alteration of NFMLP induced response in cystic fibrosis neutrophils</article-title><source>Ped Res</source><year>1986</year><volume>20</volume><fpage>520</fpage><lpage>6</lpage></citation></ref><ref id="R11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kharazmi</surname><given-names>A</given-names></name><name><surname>Schiotz</surname><given-names>P</given-names></name><name><surname>Hoiby</surname><given-names>N</given-names></name><etal/></person-group><article-title>Demonstration of neutrophil chemotactic activity in sputum of CF patients with Pseudomonas</article-title><source>Eur JCI</source><year>1986</year><volume>16</volume><fpage>143</fpage><lpage>8</lpage></citation></ref><ref id="R12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kharazami</surname><given-names>A</given-names></name><name><sur