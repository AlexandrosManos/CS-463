ce>Motivating people Best of HBR Harvard Business Review</source><year>2002</year></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pathman</surname><given-names>DE</given-names></name><name><surname>Konrad</surname><given-names>TR</given-names></name><name><surname>Williams</surname><given-names>ES</given-names></name><name><surname>Scheckler</surname><given-names>WE</given-names></name><name><surname>Linzer</surname><given-names>M</given-names></name><name><surname>Douglas</surname><given-names>J</given-names></name></person-group><article-title>Physician Job satisfaction, job dissatisfaction, and physician turnover</article-title><source>J Fam Pract</source><year>2002</year><volume>51</volume><fpage>593</fpage><pub-id pub-id-type="pmid">12160487</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ullrich</surname><given-names>RA</given-names></name></person-group><article-title>Herzberg revisited: factors in job dissatisfaction</article-title><source>J Nurs Adm</source><year>1978</year><volume>8</volume><fpage>19</fpage><lpage>24</lpage><pub-id pub-id-type="pmid">299547</pub-id><pub-id pub-id-type="doi">10.1097/00005110-197810000-00004</pub-id></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Thiero</surname><given-names>M</given-names></name></person-group><article-title>Surproduction des m&#x000e9;decins au Mali: une opportunit&#x000e9; pour renforcer la premi&#x000e8;re ligne</article-title><source>Master thesis in public health</source><year>2007</year><publisher-name>Institute Tropical Medicine, Anwerp</publisher-name></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kone</surname><given-names>Y</given-names></name></person-group><article-title>Ad&#x000e9;quation entre la formati