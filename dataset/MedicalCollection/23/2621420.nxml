<source>Hepatology</source><volume>29</volume><fpage>1655</fpage><lpage>61</lpage><pub-id pub-id-type="pmid">10347104</pub-id></citation></ref><ref id="b8-tcrm-4-919"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Braga</surname><given-names>LLBC</given-names></name><name><surname>Souza</surname><given-names>MHLP</given-names></name><name><surname>Barbosa</surname><given-names>AMC</given-names></name><etal/></person-group><year>2006</year><article-title>Diagnosis of spontaneous bacterial peritonitis in cirrhotic patients in northeastern Brazil by use of rapid urine-screening test</article-title><source>Sao Paulo Med J</source><volume>24</volume><fpage>141</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">17119690</pub-id></citation></ref><ref id="b9-tcrm-4-919"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brule</surname><given-names>M</given-names></name><name><surname>Hillemand</surname><given-names>P</given-names></name><name><surname>Goutner</surname><given-names>B</given-names></name></person-group><year>1939</year><article-title>Septicemie a colibacille et peritonite terminale chez une cirrhotique</article-title><source>Bull Soc Med Hop Paris</source><volume>63</volume><fpage>1167</fpage></citation></ref><ref id="b10-tcrm-4-919"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cachin</surname><given-names>M</given-names></name></person-group><year>1955</year><article-title>[Sur un syndrome ictero-ascitique avec colibacillemie]</article-title><source>Rev Med Chir Mal Foie</source><volume>30</volume><fpage>5</fpage><pub-id pub-id-type="pmid">13290494</pub-id></citation></ref><ref id="b11-tcrm-4-919"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Caroli</surname><given-names>J</given-names></name><name><surname>Platteborse</surname><given-names>R</given-names></name></person-group><year>1956</ye