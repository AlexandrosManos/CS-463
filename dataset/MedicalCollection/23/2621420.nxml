81</lpage><pub-id pub-id-type="pmid">15758619</pub-id></citation></ref><ref id="b15-tcrm-4-919"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chang</surname><given-names>CS</given-names></name><name><surname>Chen</surname><given-names>GH</given-names></name><name><surname>Lien</surname><given-names>HC</given-names></name><etal/></person-group><year>1998</year><article-title>Small intestine dysmotility and bacterial overgrowth in cirrhotic patients with spontaneous bacterial peritonitis</article-title><source>Hepatology</source><volume>28</volume><fpage>1187</fpage><lpage>90</lpage><pub-id pub-id-type="pmid">9794900</pub-id></citation></ref><ref id="b16-tcrm-4-919"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cholongitas</surname><given-names>E</given-names></name><name><surname>Papatheodoridis</surname><given-names>GV</given-names></name><name><surname>Lahanas</surname><given-names>A</given-names></name><etal/></person-group><year>2005</year><article-title>Increasing frequency of Gram-positive bacteria in spontaneous bacterial peritonitis</article-title><source>Liver Int</source><volume>25</volume><fpage>57</fpage><lpage>61</lpage><pub-id pub-id-type="pmid">15698399</pub-id></citation></ref><ref id="b17-tcrm-4-919"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Christou</surname><given-names>L</given-names></name><name><surname>Pappas</surname><given-names>G</given-names></name><name><surname>Falagas</surname><given-names>ME</given-names></name></person-group><year>2007</year><article-title>Bacterial infection-related morbidity and mortality in cirrhosis</article-title><source>Am J Gastroenterol</source><volume>102</volume><fpage>1510</fpage><lpage>17</lpage><pub-id pub-id-type="pmid">17509025</pub-id></citation></ref><ref id="b18-tcrm-4-919"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cirera</surname><given-names>I</given-names></name><name><surname>Bauer</surname><given-names>TM</given-names></name><name><surname>Navasa</surname><given-names>M</given-names></name><etal/></person-group><year>2001</year><article-title>Bacterial translocation of enteric organisms in patients with cirrhosis</article-title><source>J Hepatol</source><volume>34</volume><fpage>32</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">11211904</pub-id></citation></ref><ref id="b19-tcrm-4-919"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Conn</surname><given-names>HO</given-names></name></person-group><year>1964</year><article-title>Spontaneous peritonitis and bacteremia in Laennec&#x02019;s cirrhosis caused by enteric organisms. A relatively common but rarely recognized syndrome</article-title><source>Ann Intern Med</source><volume>60</volume><fpage>568</fpage><lpage>80</lpage><pub-id pub-id-type="pmid">14138877</pub-id></citation></ref><ref id="b20-tcrm-4-919"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coral</surname><given-names>G</given-names></name><name><surname>Mattos</surname><given-names>AA</given-names></name><name><surname>Damo</surname><given-names>DF</given-names></name><etal/></person-group><year>2002</year><article-title>[Preval&#x000ea;ncia e progn&#x000f3;stico da peritonite bacteriana espont&#x000e2;nea. Experi&#x000ea;ncia em pacientes internados em um hospital geral de Porto Alegre, RS, Brasil (1991&#x02013;2000)]</article-title><source>Arq Gastroenterol</source><volume>39</volume><fpage>158</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">12778307</pub-id></citation></ref><ref id="b21-tcrm-4-919"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Devill&#x000e9;</surname><given-names>WL</given-names></name><name><surname>Yzermans</surname><given-names>JC</given-names></name><name><surname>van Duijn</surname><given-names>NP</given-