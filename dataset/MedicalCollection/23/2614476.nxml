l"><person-group person-group-type="author"><name><surname>Grant</surname><given-names>VJ</given-names></name><name><surname>Yang</surname><given-names>S</given-names></name></person-group><year>2003</year><article-title>Achieving women and declining sex ratios.</article-title><source>Hum Biol</source><volume>75</volume><fpage>917</fpage><lpage>927</lpage><pub-id pub-id-type="pmid">15018039</pub-id></citation></ref><ref id="pone.0004195-Sheldon1"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sheldon</surname><given-names>BC</given-names></name><name><surname>West</surname><given-names>SA</given-names></name></person-group><year>2004</year><article-title>Maternal dominance, maternal condition, and offspring sex ratio in ungulate mammals.</article-title><source>Am Nat</source><volume>163</volume><fpage>40</fpage><lpage>54</lpage><pub-id pub-id-type="pmid">14767835</pub-id></citation></ref><ref id="pone.0004195-Larson1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Larson</surname><given-names>MA</given-names></name><name><surname>Kimura</surname><given-names>K</given-names></name><name><surname>Kubisch</surname><given-names>HM</given-names></name><name><surname>Roberts</surname><given-names>RM</given-names></name></person-group><year>2001</year><article-title>Sexual dimorphism among bovine embryos in their ability to make the transition to expanded blastocyst and in the expression of the signaling molecule IFN-tau.</article-title><source>Proc Nat Acad Sci USA</source><volume>98</volume><fpage>9677</fpage><lpage>9682</lpage><pub-id pub-id-type="pmid">11481449</pub-id></citation></ref><ref id="pone.0004195-Cameron2"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cameron</surname><given-names>EZ</given-names></name><name><surname>Lemons</surname><given-names>P</given-names></name><name><surna