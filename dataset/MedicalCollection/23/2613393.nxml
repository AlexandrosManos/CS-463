86</pub-id><pub-id pub-id-type="doi">10.1002/jcb.240540404</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gutterman</surname><given-names>JU</given-names></name></person-group><article-title>Cytokine therapeutics: Lessons from interferon &#x003b1;</article-title><source>Proc Natl Acad Sci USA</source><year>1994</year><volume>91</volume><fpage>1198</fpage><lpage>1205</lpage><pub-id pub-id-type="pmid">8108387</pub-id><pub-id pub-id-type="doi">10.1073/pnas.91.4.1198</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gutterman</surname><given-names>JU</given-names></name><name><surname>Blumenschein</surname><given-names>GR</given-names></name><name><surname>Alexanian</surname><given-names>R</given-names></name><name><surname>Yap</surname><given-names>HY</given-names></name><name><surname>Buzdar</surname><given-names>AU</given-names></name><name><surname>Cabanillas</surname><given-names>F</given-names></name><name><surname>Hortobagyi</surname><given-names>GN</given-names></name><name><surname>Hersh</surname><given-names>EM</given-names></name><name><surname>Rasmussen</surname><given-names>SL</given-names></name><name><surname>Harmon</surname><given-names>M</given-names></name><name><surname>Kramer</surname><given-names>M</given-names></name><name><surname>Pestka</surname><given-names>S</given-names></name></person-group><article-title>Leukocyte interferon-induced tumor regression in human metastatic breast cancer, multiple myeloma, and malignant lymphoma</article-title><source>Ann Intern Med</source><year>1980</year><volume>93</volume><fpage>399</fpage><lpage>406</lpage><pub-id pub-id-type="pmid">6159812</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gutterman</surname><given-names>JU</given-names></name><name><surname>Fine</surname>