name><surname>Kuntz</surname><given-names>KM</given-names></name></person-group><article-title>Cost-effectiveness of screening for colorectal cancer in the general population</article-title><source>J Am Med Assoc</source><year>2000b</year><volume>284</volume><fpage>1954</fpage><lpage>1961</lpage><!--PubMed citation query: 'J Am Med Assoc||284|1954||bib13|'--></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Garvican</surname><given-names>L</given-names></name></person-group><article-title>Planning for a possible national colorectal cancer screening programme</article-title><source>J Med Screen</source><year>1998</year><volume>5</volume><fpage>187</fpage><lpage>194</lpage><!--PubMed citation query: 'J Med Screen||5|187||bib14|'--><pub-id pub-id-type="pmid">9934649</pub-id></citation></ref><ref id="bib15"><citation citation-type="other"><person-group person-group-type="author"><collab>Government Actuary's Department</collab></person-group><article-title>Interim life tables</article-title><year>2003</year></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hardcastle</surname><given-names>JD</given-names></name><name><surname>Armitage</surname><given-names>NC</given-names></name><name><surname>Chamberlain</surname><given-names>JO</given-names></name><name><surname>Amar</surname><given-names>SS</given-names></name><name><surname>James</surname><given-names>PD</given-names></name><name><surname>Balfour</surname><given-names>TW</given-names></name></person-group><article-title>Fecal occult blood screening for colorectal cancer in the general population</article-title><source>Cancer</source><year>1986</year><volume>58</volume><fpage>397</fpage><lpage>403</lpage><!--PubMed citation query: 'Cancer||58|397||bib16|'--><pub-id pub-id-type="pmid">3719535</pub-id></citation></ref><ref id="bib17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hardcastle</surname><given-names>JD</given-names></name><name><surname>Chamberlain</surname><given-names>JO</given-names></name><name><surname>Robinson</surname><given-names>MHE</given-names></name><name><surname>Moss</surname><given-names>SM</given-names></name><name><surname>Amar</surname><given-names>SS</given-names></name><name><surname>Balfour</surname><given-names>TW</given-names></name><name><surname>James</surname><given-names>PD</given-names></name><name><surname>Mangham</surname><given-names>CM</given-names></name></person-group><article-title>Randomised controlled trial of faecal-occult-blood screening for colorectal cancer</article-title><source>The Lancet</source><year>1996</year><volume>348</volume><fpage>1472</fpage><lpage>1477</lpage><!--PubMed citation query: 'The Lancet||348|1472||bib17|'--></citation></ref><ref id="bib18"><citation citation-type="other"><person-group person-group-type="author"><collab>HM Treasury</collab></person-group><article-title>Gross Domestic Product (GDP) deflator values</article-title><year>2002</year></citation></ref><ref id="bib19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Imperiale</surname><given-names>TF</given-names></name><name><surname>Wagner</surname><given-names>DL</given-names></name><name><surname>Lin</surname><given-names>CY</given-names></name><name><surname>Larkin</surname><given-names>GN</given-names></name><name><surname>Rogge</surname><given-names>JD</given-names></name><name><surname>Ransohoff</surname><given-names>DF</given-names></name></person-group><article-title>Risk of advanced proximal neoplasms in asymptomatic adults according to the distal colorectal findings</article-title><source>N Engl J Med</source><year>2000</year><volume>343</volume><fpage>169</fpage><lpage>174</lpage><!--PubMed citation query: 'N Engl J Med||343|169||bib19|'--><pub-id pub-id-type="pmid">10900275</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Karnon</surname><given-names>J</given-names></name><name><surname>Goyder</surname><given-names>E</given-names></name><name><surname>Tappenden</surname><given-names>P</given-names></name><name><surname>McPhie</surname><given-names>S</given-names></name><name><surname>Towers</surname><given-names>I</given-names></name><name><surname>Brazier</surname><given-names>J</given-names></name><name><surname>Madan</surname><given-names>J</given-names></name></person-group><article-title>A review and critique of modelling in prioritising and designing screening programmes</article-title><source>Health Technol Assess</source><year>2007</year><volume>11</volume><fpage>1</fpage><lpage>145</lpage><!--PubMed citation query: 'Health Technol Assess||11|1||bib20|'--></citation></ref><ref id="bib21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kewenter</surname><given-names>J</given-names></name><name><surname>Brevinge</surname><given-names>H</given-names></name><name><surname>Engaras</surname><given-names>B</given-names></name></person-group><article-title>Results of screening, rescreening and follow-up in a prospective randomized study for detection of colorectal cancer by faecal occult blood testing. Results for 68&#x02009;308 subjects</article-title><source>Scand J Gastroenterol</source><year>1994</year><volume>29</volume><fpage>468</fpage><lpage>473</lpage><!--PubMed citation query: 'Scand J Gastroenterol||29|468||bib21|'--><pub-id pub-id-type="pmid">8036464</pub-id></citation></ref><ref id="bib22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kronborg</surname><given-names>O</given-names></name><name><surname>Fenger</surname><given-names>C</given-names></name><name><surname>Olsen</surname><given-names>J</given-names></name><name><surname>Jorgensen</surname><given-names>OD</given-names></name><name><surname>Sondergaard</surname><given-names>O</given-names></name></person-group><article-title>Randomised study of screening for colorectal cancer with faecal occult blood test</article-title><source>The Lancet</source><year>1996</year><volume>348</volume><fpage>1467</fpage><lpage>1471</lpage><!--PubMed citation query: 'The Lancet||348|1467||bib22|'--></citation></ref><ref id="bib23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leslie</surname><given-names>A</given-names></name><name><surname>Carey</surname><given-names>FA</given-names></name><name><surname>Pratt</surname><given-names>NR</given-names></name><name><surname>Steele</surname><given-names>RJC</given-names></name></person-group><article-title>The colorectal adenoma-carcinoma sequence</article-title><source>Br J Surg</source><year>2002</year><volume>89</volume><fpage>845</fpage><lpage>860</lpage><!--PubMed citation query: 'Br J Surg||89|845||bib23|'--><pub-id pub-id-type="pmid">12081733</pub-id></citation></ref><ref id="bib24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lund</surname><given-names>JN</given-names></name><name><surname>Scholefield</surname><given-names>JH</given-names></name><name><surname>Grainge</surname><given-names>MJ</given-names></name><name><surname>Smith</surname><given-names>SJ</given-names></name><name><surname>Mangham</surname><given-names>CM</given-names></name><name><surname>Armitage</surname><given-names>NC</given-names></name><name><surname>Robinson</surname><given-names>MHE</given-names></name><name><surname>Logan</surname><given-names>RFA</given-names></name></person-group><article-title>Risks, costs and compliance limit colorectal adenoma surveillance: lessons from a randomised trial</article-title><source>Gut</source><year>2001</year><volume>49</volume><fpage>91</fpage><lpage>96</lpage><!--PubMed citation query: 'Gut||49|91||bib24|'--><pub-id pub-id-type="pmid">11413116</pub-id></cit