#x02013; 15 years)</td><td align="center">39.9</td><td align="center">3481</td><td align="center">(533)</td><td align="center">13354</td><td align="center">31.7</td><td align="center">11012</td><td align="center">33.2</td><td align="center">145698</td><td align="center">41.6</td></tr><tr><td align="left">&#x02003;College or postgraduate</td><td align="center">22.6</td><td align="center">3433</td><td align="center">(562)</td><td align="center">9118</td><td align="center">21.7</td><td align="center">7269</td><td align="center">21.9</td><td align="center">79975</td><td align="center">22.8</td></tr><tr><td align="left">&#x02003;(&#x02265; 16 years)</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left">&#x02003;Missing</td><td align="center">5.9</td><td align="center">3333</td><td align="center">(573)</td><td align="center">3140</td><td align="center">7.5</td><td align="center">2324</td><td align="center">7.0</td><td align="center">19677</td><td align="center">5.6</td></tr><tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left">APNCU</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left">&#x02003;None</td><td align="center">0.6</td><td align="center">3267</td><td align="center">(714)</td><td align="center">251</td><td align="center">0.6</td><td align="center">337</td><td align="center">1.0</td><td align="center">1825</td><td align="center">0.5</td></tr><tr><td align="left">&#x02003;Inadequate</td><td align="center">7.8</td><td align="center">3308</td><td align="center">(571)</td><td align="center">4511</td><td align="center">10.7</td><td align="center">3147</td><td align="center">9.5</td><td align="center">25652</td><td align="center">7.3</td></tr><tr><td align="left">&#x02003;Intermediate</td><td align="center">8.0</td><td align="center">3487</td><td align="center">(509)</td><td align="center">38