le>Inflammation as a cardiovascular risk factor</article-title><source>Circulation</source><year>2004</year><volume>109</volume><fpage>II2</fpage><lpage>10</lpage><pub-id pub-id-type="pmid">15173056</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kuehn</surname><given-names>MJ</given-names></name><name><surname>Kesty</surname><given-names>NC</given-names></name></person-group><article-title>Bacterial outer membrane vesicles and the host-pathogen interaction</article-title><source>Genes Dev</source><year>2005</year><volume>19</volume><fpage>2645</fpage><lpage>2655</lpage><pub-id pub-id-type="pmid">16291643</pub-id><pub-id pub-id-type="doi">10.1101/gad.1299905</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wai</surname><given-names>SN</given-names></name><name><surname>Lindmark</surname><given-names>B</given-names></name><name><surname>Soderblom</surname><given-names>T</given-names></name><name><surname>Takade</surname><given-names>A</given-names></name><name><surname>Westermark</surname><given-names>M</given-names></name><name><surname>Oscarsson</surname><given-names>J</given-names></name><name><surname>Jass</surname><given-names>J</given-names></name><name><surname>Richter-Dahlfors</surname><given-names>A</given-names></name><name><surname>Mizunoe</surname><given-names>Y</given-names></name><name><surname>Uhlin</surname><given-names>BE</given-names></name></person-group><article-title>Vesicle-mediated export and assembly of pore-forming oligomers of the enterobacterial ClyA cytotoxin</article-title><source>Cell</source><year>2003</year><volume>115</volume><fpage>25</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">14532000</pub-id><pub-id pub-id-type="doi">10.1016/S0092-8674(03)00754-2</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gophna</surname><given-names>U</given-names></name><name><surname>Ideses</surname><given-names>D</given-names></name><name><surname>Rosen</surname><given-names>R</given-names></name><name><surname>Grundland</surname><given-names>A</given-names></name><name><surname>Ron</surname><given-names>EZ</given-names></name></person-group><article-title>OmpA of a septicemic Escherichia coli O78&#x02013;secretion and convergent evolution</article-title><source>Int J Med Microbiol</source><year>2004</year><volume>294</volume><fpage>373</fpage><lpage>381</lpage><pub-id pub-id-type="pmid">15595387</pub-id><pub-id pub-id-type="doi">10.1016/j.ijmm.2004.08.004</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hellman</surname><given-names>J</given-names></name><name><surname>Loiselle</surname><given-names>PM</given-names></name><name><surname>Tehan</surname><given-names>MM</given-names></name><name><surname>Allaire</surname><given-names>JE</given-names></name><name><surname>Boyle</surname><given-names>LA</given-names></name><name><surname>Kurnick</surname><given-names>JT</given-names></name><name><surname>Andrews</surname><given-names>DM</given-names></name><name><surname>Sik Kim</surname><given-names>K</given-names></name><name><surname>Warren</surname><given-names>HS</given-names></name></person-group><article-title>Outer membrane protein A, peptidoglycan-associated lipoprotein, and murein lipoprotein are released by Escherichia coli bacteria into serum</article-title><source>Infect Immun</source><year>2000</year><volume>68</volume><fpage>2566</fpage><lpage>2572</lpage><pub-id pub-id-type="pmid">10768945</pub-id><pub-id pub-id-type="doi">10.1128/IAI.68.5.2566-2572.2000</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Toren</surname><given-names>A</given-names></name><name><surname>Orr</surname><given-names>E</given-na