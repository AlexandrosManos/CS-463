/source><year>1982</year></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Simmons</surname><given-names>R</given-names></name><name><surname>Corey</surname><given-names>M</given-names></name><name><surname>Cowen</surname><given-names>L</given-names></name><name><surname>Keenan</surname><given-names>N</given-names></name><name><surname>Robertson</surname><given-names>J</given-names></name><name><surname>Levison</surname><given-names>H</given-names></name></person-group><article-title>Emotional Adjustment of Early Adolescents with Cystic Fibrosis</article-title><source>Psychosom Med</source><year>1985</year><volume>47</volume><fpage>111</fpage><lpage>122</lpage><pub-id pub-id-type="pmid">4048358</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Olsson</surname><given-names>CA</given-names></name><name><surname>Bond</surname><given-names>L</given-names></name><name><surname>Johnson</surname><given-names>MW</given-names></name><name><surname>Forer</surname><given-names>DL</given-names></name><name><surname>Boyce</surname><given-names>MF</given-names></name><name><surname>Sawyer</surname><given-names>SM</given-names></name></person-group><article-title>Adolescent chronic illness: A qualitative study of psychosocial adjustment</article-title><source>Ann Acad Med Singapore</source><year>2003</year><volume>32</volume><fpage>43</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">12625097</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brydolf</surname><given-names>M</given-names></name><name><surname>Segesten</surname><given-names>K</given-names></name></person-group><article-title>Living with ulcerative colitis: Experiences of adolescents and young adults</article-title><source>Journal of Advanced Nursing</source><year>1996</year><volume>23</volume><fpage>39</fpage><lpage>47</lpage><pub-id pub-id-type="pmid">8708222</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2648.1996.tb03133.x</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Erwin-Toth</surname><given-names>P</given-names></name></person-group><article-title>The effect of ostomy surgery between the ages of 6 and 12 years on psychosocial development during childhood, adolescence, and young adulthood</article-title><source>J Wound Ostomy Continence Nurs</source><year>1999</year><volume>26</volume><fpage>77</fpage><lpage>85</lpage><pub-id pub-id-type="pmid">10373863</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nicholas</surname><given-names>DB</given-names></name><name><surname>Smith</surname><given-names>C</given-names></name><name><surname>Munk</surname><given-names>M</given-names></name><name><surname>Otley</surname><given-names>A</given-names></name><name><surname>Avolio</surname><given-names>J</given-names></name><name><surname>Griffiths</surname><given-names>AM</given-names></name></person-group><article-title>Challenges and strategies of children and adolescents with Inflammatory Bowel Disease</article-title><source>Health Qual Life Outcomes</source><volume>5</volume><fpage>28</fpage><pub-id pub-id-type="pmid">17531097</pub-id><pub-id pub-id-type="doi">10.1186/1477-7525-5-28</pub-id></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Fetterman</surname><given-names>DM</given-names></name></person-group><article-title>A Wilderness Guide: Methods and Techniques</article-title><source>In Ethnography: Step by Step</source><year>1998</year><publisher-name>Thousand Oaks, CA: Sage</publisher-name><fpage>31</fpage><lpage>62</lpage></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Creswell</surname><given-names>JW</given-names></name></person-group><source>Qualitative Inquiry and Research Design: Choosing Among Five Traditions</source><year>1998</year><publisher-name>Thousand Oaks: Sage</publisher-name></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kitzinger</surname><given-names>J</given-names></name></person-group><article-title>The methodology of focus groups: the importance of interaction between research participants</article-title><source>Sociology of Health</source><year>1994</year><volume>16</volume><fpage>103</fpage><lpage>121</lpage><pub-id pub-id-type="doi">10.1111/1467-9566.ep11347023</pub-id></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>McCracken</surname><given-names>G</given-names></name></person-group><source>The Long Interview</source><year>1988</year><publisher-name>Thousand Oaks: Sage</publisher-name></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lincoln</surname><given-names/></name><name><surname>Guba</surname><given-names/></name></person-group><source>Naturalistic inquiry</source><year>1985</year><publisher-name>Beverly Hills, CA: Sage</publisher-name></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Erlandson</surname><given-names>D</given-names></name><name><surname>Harris</surname><given-names>E</given-names></name><name><surname>Skipper</surname><given-names>BL</given-names></name><name><surname>Allen</surname><given-names>SD</given-names></name></person-group><source>Doing Naturalistic Inquiry</source><year>1993</year><publisher-name>Newbury Park: Sage</publisher-name></citation></ref></ref-list></back></article>