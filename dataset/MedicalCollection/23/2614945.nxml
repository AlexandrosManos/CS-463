rce>J Craniofac Genet Dev Biol</source><year>1993</year><volume>13</volume><fpage>98</fpage><lpage>108</lpage><pub-id pub-id-type="pmid">8325973</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jensen</surname><given-names>BL</given-names></name><name><surname>Kreiborg</surname><given-names>S</given-names></name></person-group><article-title>Craniofacial growth in cleidocranial dysplasia-a roentgencephalometric study</article-title><source>J Craniofac Genet Dev Biol</source><year>1995</year><volume>15</volume><fpage>35</fpage><lpage>43</lpage><pub-id pub-id-type="pmid">7601912</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Quinn</surname><given-names>PD</given-names></name><name><surname>Lewis</surname><given-names>J</given-names></name><name><surname>Levin</surname><given-names>LM</given-names></name></person-group><article-title>Surgical management of a patient with cleidocranial dysplasia: a case report</article-title><source>Special Care Dent</source><year>1992</year><volume>12</volume><fpage>131</fpage><lpage>133</lpage><pub-id pub-id-type="doi">10.1111/j.1754-4505.1992.tb00429.x</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jensen</surname><given-names>BL</given-names></name><name><surname>Kreiborg</surname><given-names>S</given-names></name></person-group><article-title>Development of the dentition in cleidocranial dysplasia</article-title><source>J Oral Pathol Med</source><year>1990</year><volume>19</volume><fpage>89</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">2341976</pub-id><pub-id pub-id-type="doi">10.1111/j.1600-0714.1990.tb00803.x</pub-id></citation></ref></ref-list></back></article>