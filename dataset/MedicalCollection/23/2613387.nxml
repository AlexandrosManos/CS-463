-names></name></person-group><article-title>Reoperation rates following lumbar spine surgery and the influence of spinal fusion procedures</article-title><source>Spine</source><year>2007</year><volume>32</volume><fpage>382</fpage><lpage>387</lpage><pub-id pub-id-type="pmid">17268274</pub-id><pub-id pub-id-type="doi">10.1097/01.brs.0000254104.55716.46</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ross</surname><given-names>JS</given-names></name><name><surname>Obuchowski</surname><given-names>N</given-names></name><name><surname>Zepp</surname><given-names>R</given-names></name></person-group><article-title>The postoperative lumbar spine: evaluation of epidural scar over a 1-year period</article-title><source>AJNR Am J Neuroradiol</source><year>1998</year><volume>19</volume><fpage>183</fpage><lpage>186</lpage><pub-id pub-id-type="pmid">9432177</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cauchoix</surname><given-names>J</given-names></name><name><surname>Ficat</surname><given-names>C</given-names></name><name><surname>Girard</surname><given-names>B</given-names></name></person-group><article-title>Repeat surgery after disc excision</article-title><source>Spine</source><year>1978</year><volume>3</volume><fpage>256</fpage><lpage>259</lpage><pub-id pub-id-type="pmid">152469</pub-id><pub-id pub-id-type="doi">10.1097/00007632-197809000-00011</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hurme</surname><given-names>M</given-names></name><name><surname>Katevuo</surname><given-names>K</given-names></name><name><surname>Nykvist</surname><given-names>F</given-names></name><name><surname>Aalto</surname><given-names>T</given-names></name><name><surname>Alaranta</surname><given-names>H</given-names></name><name><surname>Einola</surname><g