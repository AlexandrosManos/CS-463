names></name></person-group><article-title>Cardiorespiratory fitness and adiposity as mortality predictors in older adults</article-title><source>JAMA</source><volume>298</volume><fpage>2507</fpage><lpage>16</lpage><comment>2007, Dec 5</comment><pub-id pub-id-type="pmid">18056904</pub-id><pub-id pub-id-type="doi">10.1001/jama.298.21.2507</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cattell</surname><given-names>V</given-names></name></person-group><article-title>Poor people, poor places, and poor health: the mediating role of social networks and social capital</article-title><source>Social Science &#x00026; Medicine</source><year>2001</year><volume>52</volume><fpage>1501</fpage><lpage>1516</lpage><pub-id pub-id-type="pmid">11314847</pub-id><pub-id pub-id-type="doi">10.1016/S0277-9536(00)00259-8</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jordan</surname><given-names>JE</given-names></name><name><surname>Osborne</surname><given-names>RH</given-names></name></person-group><article-title>Chronic disease self-management education programs: challenges ahead</article-title><source>Med J Aust</source><volume>186</volume><fpage>84</fpage><lpage>7</lpage><comment>2007, Jan 15</comment><pub-id pub-id-type="pmid">17223770</pub-id></citation></ref></ref-list></back></article>