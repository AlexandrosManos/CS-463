itation-type="journal"><person-group person-group-type="author"><name><surname>Fehm</surname><given-names>T</given-names></name><name><surname>Sagalowsky</surname><given-names>A</given-names></name><name><surname>Clifford</surname><given-names>E</given-names></name><name><surname>Beitsch</surname><given-names>P</given-names></name><name><surname>Saboorian</surname><given-names>H</given-names></name><name><surname>Euhus</surname><given-names>D</given-names></name><name><surname>Meng</surname><given-names>S</given-names></name><name><surname>Morrison</surname><given-names>L</given-names></name><name><surname>Tucker</surname><given-names>T</given-names></name><name><surname>Lane</surname><given-names>N</given-names></name><name><surname>Ghadimi</surname><given-names>BM</given-names></name><name><surname>Heselmeyer-Haddad</surname><given-names>K</given-names></name><name><surname>Ried</surname><given-names>T</given-names></name><name><surname>Rao</surname><given-names>C</given-names></name><name><surname>Uhr</surname><given-names>J</given-names></name></person-group><article-title>Cytogenetic evidence that circulating epithelial cells in patients with carcinoma are malignant</article-title><source>Clin Cancer Res</source><year>2002</year><volume>8</volume><fpage>2073</fpage><lpage>2084</lpage><pub-id pub-id-type="pmid">12114406</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meng</surname><given-names>S</given-names></name><name><surname>Tripathy</surname><given-names>D</given-names></name><name><surname>Shete</surname><given-names>S</given-names></name><name><surname>Ashfaq</surname><given-names>R</given-names></name><name><surname>Haley</surname><given-names>B</given-names></name><name><surname>Perkins</surname><given-names>S</given-names></name><name><surname>Beitsch</surname><given-names>P</given-names></name><name><surname>Khan</surname><given-names>A</given-names></name><name><surname