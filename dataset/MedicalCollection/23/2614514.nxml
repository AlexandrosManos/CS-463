me><given-names>W</given-names></name></person-group><article-title>Epithelial cells in bone marrow of breast cancer patients at time of primary surgery: clinical outcome during long-term follow-up</article-title><source>J Clin Oncol</source><year>2001</year><volume>19</volume><fpage>3669</fpage><lpage>3674</lpage><pub-id pub-id-type="pmid">11504748</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cote</surname><given-names>RJ</given-names></name><name><surname>Rosen</surname><given-names>PP</given-names></name><name><surname>Lesser</surname><given-names>ML</given-names></name><name><surname>Old</surname><given-names>LJ</given-names></name><name><surname>Osborne</surname><given-names>MP</given-names></name></person-group><article-title>Prediction of early relapse in patients with operable breast cancer by detection of occult bone marrow micrometastases</article-title><source>J Clin Oncol</source><year>1991</year><volume>9</volume><fpage>1749</fpage><lpage>1756</lpage><pub-id pub-id-type="pmid">1919627</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Braun</surname><given-names>S</given-names></name><name><surname>Marth</surname><given-names>C</given-names></name></person-group><article-title>Circulating tumor cells in metastatic breast cancer &#x02013; toward individualized treatment?</article-title><source>N Engl J Med</source><year>2004</year><volume>351</volume><fpage>824</fpage><lpage>826</lpage><pub-id pub-id-type="pmid">15317898</pub-id><pub-id pub-id-type="doi">10.1056/NEJMe048163</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Braun</surname><given-names>S</given-names></name><name><surname>Vogl</surname><given-names>FD</given-names></name><name><surname>Naume</surname><given-names>B</given-names></name><name><surname>Janni<