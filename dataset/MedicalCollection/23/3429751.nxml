rname><given-names>O</given-names></name></person-group><article-title>A prospective study of colonoscopy practice in the UK today: are we adequately prepared for national colorectal cancer screening tomorrow?</article-title><source>Gut</source><year>2004</year><volume>53</volume><fpage>277</fpage><lpage>283</lpage><pub-id pub-id-type="pmid">14724164</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Church</surname><given-names>JM</given-names></name></person-group><article-title>Complete colonoscopy: how often? And if not, why not?</article-title><source>Am J Gastroenterol</source><year>1994</year><volume>89</volume><fpage>556</fpage><lpage>560</lpage><pub-id pub-id-type="pmid">8147359</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cirocco</surname><given-names>WC</given-names></name><name><surname>Rusin</surname><given-names>LC</given-names></name></person-group><article-title>Factors that predict incomplete colonoscopy</article-title><source>Dis Colon Rectum</source><year>1995</year><volume>38</volume><fpage>964</fpage><lpage>968</lpage><pub-id pub-id-type="pmid">7656745</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rex</surname><given-names>DK</given-names></name><name><surname>Goodwine</surname><given-names>BW</given-names></name></person-group><article-title>Method of colonoscopy in 42 consecutive patients presenting after prior incomplete colonoscopy</article-title><source>Am J Gastroenterol</source><year>2002</year><volume>97</volume><fpage>1148</fpage><lpage>1151</lpage><pub-id pub-id-type="pmid">12014719</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><