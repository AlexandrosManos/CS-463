ine</source><year>2007</year><volume>32</volume><fpage>2387</fpage><lpage>2397</lpage><pub-id pub-id-type="pmid">17906584</pub-id><pub-id pub-id-type="doi">10.1097/BRS.0b013e318124ffb8</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bolton</surname><given-names>JE</given-names></name></person-group><article-title>Accuracy of recall of usual pain intensity in back pain patients</article-title><source>Pain</source><year>1999</year><volume>83</volume><fpage>533</fpage><lpage>539</lpage><pub-id pub-id-type="pmid">10568862</pub-id><pub-id pub-id-type="doi">10.1016/S0304-3959(99)00161-X</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kuornika</surname><given-names>I</given-names></name><name><surname>Jonsson</surname><given-names>B</given-names></name><name><surname>Kilbom</surname><given-names>A</given-names></name><name><surname>Vinterberg</surname><given-names>H</given-names></name><name><surname>Biering-Sorensen</surname><given-names>F</given-names></name><name><surname>Andersson</surname><given-names>G</given-names></name><name><surname>Jorgensen</surname><given-names>K</given-names></name></person-group><article-title>Standardised Nordic questionnaires for the analysis of musculoskeletal symptoms</article-title><source>Appl Ergon</source><year>1987</year><volume>18</volume><fpage>233</fpage><lpage>237</lpage><pub-id pub-id-type="pmid">15676628</pub-id><pub-id pub-id-type="doi">10.1016/0003-6870(87)90010-X</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adams</surname><given-names>MA</given-names></name><name><surname>Mannion</surname><given-names>AF</given-names></name><name><surname>Dolan</surname><given-names>P</given-names></name></person-group><article-title>Personal risk factors for first time low back pain</article-title>