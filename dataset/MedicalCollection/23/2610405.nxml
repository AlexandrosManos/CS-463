l"><person-group person-group-type="author"><name><surname>Ezzeddine</surname><given-names>ZD</given-names></name><name><surname>Yang</surname><given-names>X</given-names></name><name><surname>DeChiara</surname><given-names>T</given-names></name><name><surname>Yancopoulos</surname><given-names>G</given-names></name><name><surname>Cepko</surname><given-names>CL</given-names></name></person-group><article-title>Postmitotic cells fated to become rod photoreceptors can be respecified by CNTF treatment of the retina.</article-title><source>Development</source><year>1997</year><volume>124</volume><fpage>1055</fpage><lpage>67</lpage><pub-id pub-id-type="pmid">9056780</pub-id></citation></ref><ref id="r14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Neophytou</surname><given-names>C</given-names></name><name><surname>Vernallis</surname><given-names>AB</given-names></name><name><surname>Smith</surname><given-names>A</given-names></name><name><surname>Raff</surname><given-names>MC</given-names></name></person-group><article-title>Muller-cell-derived leukaemia inhibitory factor arrests rod photoreceptor differentiation at a postmitotic pre-rod stage of development.</article-title><source>Development</source><year>1997</year><volume>124</volume><fpage>2345</fpage><lpage>54</lpage><pub-id pub-id-type="pmid">9199361</pub-id></citation></ref><ref id="r15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schulz-Key</surname><given-names>S</given-names></name><name><surname>Hofmann</surname><given-names>HD</given-names></name><name><surname>Beisenherz-Huss</surname><given-names>C</given-names></name><name><surname>Barbisch</surname><given-names>C</given-names></name><name><surname>Kirsch</surname><given-names>M</given-names></name></person-group><article-title>Ciliary neurotrophic factor as a transient negative regulator of rod development in rat retina.</article-