0</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>B&#x000fc;lthoff</surname><given-names>HH</given-names></name><name><surname>Edelman</surname><given-names>S</given-names></name></person-group><year>1992</year><article-title>Psychophysical support for a two-dimensional view interpolation theory of object recognition.</article-title><source>Proc Nat Acad Sci (USA)</source><volume>89</volume><fpage>60</fpage><lpage>64</lpage><pub-id pub-id-type="pmid">1729718</pub-id></citation></ref><ref id="pone.0004086-Liu1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>CH</given-names></name><name><surname>Chaudhuri</surname><given-names>A</given-names></name></person-group><year>2002</year><article-title>Reassessing the 3/4 view effect in face recognition.</article-title><source>Cognition</source><volume>83</volume><fpage>31</fpage><lpage>48</lpage><pub-id pub-id-type="pmid">11814485</pub-id></citation></ref><ref id="pone.0004086-Kourtzi1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kourtzi</surname><given-names>Z</given-names></name><name><surname>DiCarlo</surname><given-names>JJ</given-names></name></person-group><year>2006</year><article-title>Learning and neural plasticity in visual object recognition.</article-title><source>Curr Opin Neurobiol</source><volume>16</volume><fpage>152</fpage><lpage>158</lpage><pub-id pub-id-type="pmid">16563736</pub-id></citation></ref><ref id="pone.0004086-Perrett1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Perrett</surname><given-names>DI</given-names></name><name><surname>Oram</surname><given-names>MW</given-names></name><name><surname>Ashbridge</surname><given-names>E</given-names></name></person-group><year>1998</year><article-title>Evidence accumulation in cell populations responsive to faces: an account of generalization of recognition without mental transformations.</article-title><source>Cognition</source><volume>67</volume><fpage>111</fpage><lpage>145</lpage><pub-id pub-id-type="pmid">9735538</pub-id></citation></ref><ref id="pone.0004086-Logothetis2"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Logothetis</surname><given-names>NK</given-names></name><name><surname>Pauls</surname><given-names>J</given-names></name><name><surname>Poggio</surname><given-names>T</given-names></name></person-group><year>1995</year><article-title>Shape representation in the inferior temporal cortex of monkeys.</article-title><source>Curr Biol</source><volume>5</volume><fpage>552</fpage><lpage>563</lpage><pub-id pub-id-type="pmid">7583105</pub-id></citation></ref><ref id="pone.0004086-Poggio1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Poggio</surname><given-names>T</given-names></name><name><surname>Edelman</surname><given-names>S</given-names></name></person-group><year>1990</year><article-title>A network that learns to recognize three-dimensional objects.</article-title><source>Nature</source><volume>343</volume><fpage>263</fpage><lpage>266</lpage><pub-id pub-id-type="pmid">2300170</pub-id></citation></ref><ref id="pone.0004086-Spetch1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Spetch</surname><given-names>ML</given-names></name><name><surname>Friedman</surname><given-names>A</given-names></name></person-group><year>2003</year><article-title>Recognizing rotated views of objects: Interpolation versus generalization by humans and pigeons.</article-title><source>Psych Bull Rev</source><volume>10</volume><fpage>135</fpage><lpage>140</lpage></citation></ref><ref id="pone.0004086-Dyer1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dyer</surname><given-names>AG</given-names></name><name><surname>Rosa</surname><given-names>MGP</given-names></name><name><surname>Reser</surname><given-names>DH</given-names></name></person-group><year>2008</year><article-title>Honeybees can recognise images of complex natural scenes for use as potential landmarks.</article-title><source>J Exp Biol</source><volume>211</volume><fpage>1180</fpage><lpage>1186</lpage><pub-id pub-id-type="pmid">18375842</pub-id></citation></ref><ref id="pone.0004086-Giurfa1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giurfa</surname><given-names>M</given-names></name><name><surname>Zhang</surname><given-names>S</given-names></name><name><surname>Jenett</surname><given-names>A</given-names></name><name><surname>Menzel</surname><given-names>R</given-names></name><name><surname>Srinivasan</surname><given-names>MV</given-names></name></person-group><year>2001</year><article-title>The concepts of &#x02018;sameness&#x02019; and &#x02018;difference&#x02019; in an insect.</article-title><source>Nature</source><volume>410</volume><fpage>930</fpage><lpage>933</lpage><pub-id pub-id-type="pmid">11309617</pub-id></citation></ref><ref id="pone.0004086-Stach1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stach</surname><given-names>S</given-names></name><name><surname>Bernard</surname><given-names>J</given-names></name><name><surname>Giurfa</surname><given-names>M</given-names></name></person-group><year>2004</year><article-title>Local-feature assembling in the visual pattern recognition and generalization in honeybees.</article-title><source>Nature</source><volume>429</volume><fpage>758</fpage><lpage>761</lpage><pub-id pub-id-type="pmid">15201910</pub-id></citation></ref><ref id="pone.0004086-Zhang1"><label>20</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Zhang</surname><given-names>SW</given-names></name><name><surname>Srinivasan</surname><given-names>MV</given-names></name></person-group><year>2004</year><article-title>Exploration of cognitive capacity in honeybees: Higher functions emerge from a small brain.</article-title><person-group person-group-type="editor"><name><surname>Prete</surname><given-names>FR</given-names></name></person-group><source>Complex Worlds From Simpler Nervous Systems</source><publisher-loc>Cambridge</publisher-loc><publisher-name>The MIT Press</publisher-name><fpage>41</fpage><lpage>74</lpage></citation></ref><ref id="pone.0004086-Rind1"><label>21</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Rind</surname><given-names>FC</given-names></name></person-group><year>2004</year><article-title>Bioinspired sensors: From insect eyes to robot vision.</article-title><person-group person-group-type="editor"><name><surname>Christensen</surname><given-names>TA</given-names></name></person-group><source>Methods in Insect Sensory Neuroscience</source><publisher-loc>Boca Raton</publisher-loc><publisher-name>CRC Press</publisher-name><fpage>213</fpage><lpage>235</lpage></citation></ref><ref id="pone.0004086-Dyer2"><label>22</label><citation citation-type="other"><person-group person-group-type="author"><name><surname>Dyer</surname><given-names>AG</given-names></name><name><surname>Reser</surname><given-names>DH</given-names></name><name><surname>Chittka</surname><given-names>L</given-names></name><name><surname>Zhang</surname><given-names>Y</given-names></name><name><surname>Rosa</surname><given-names>MGP</given-names></name></person-group><article-title>Miniature brains link inner and outer features.; 2007 12&#x02013;17 July; Melbourne, Australia.</article-title><fpage>301</fpage><comment>World Congress of Neuroscience</comment></citation></ref><ref id="pone.0004086-Giurfa2"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giurfa</surname><given-names>M</given-names></name><name><surname>Hammer</surname><given-names>M</given-names></name><name><surname>Stach</surname><given-names>S</given-names></name><name><surname>Stollhoff</surname><given-names>N</given-names></name><name><surname>M&#x000fc;ller-Deisig</surname><given-names>N</given-names></name><etal/></person-group><year>1999</year><article-title>Pattern learning by honeybees: conditioning procedure and recognition strategy.</article-title><source>Anim Behav</source><volume>57</volume><fpage>315</fpage><lpage>324</lpage><pub-id pub-id-type="pmid">10049470</pub-id></citation></ref><ref id="pone.0004086-Dyer3"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dyer</surname><given-names>AG</given-names></name><name><surname>Neumeyer</surname><given-names>C</given-names></name><name><surname>Chittka</surname><given-names>L</given-names></name></person-group><year>2005</year><article-title>Honeybee (<italic>Apis mellifera</italic>) vision can discriminate between and recognise images of human faces.</article-title><source>J Exp Biol</source><volume>208</volume><fpage>4709</fpage><lpage>4714</lpage><pub-id pub-id-type="pmid">16326952</pub-id></citation></ref><ref id="pone.0004086-Bernard1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bernard</surname><given-names>J</given-names></name><name><surname>Stach</surname><given-names>S</given-names></name><name><surname>Giurfa</surname><given-names>M</given-names></name></person-group><year>2007</year><article-title>Categorization of visual stimuli in the honeybee <italic>Apis mellifera</italic>.</article-title><source>Anim Cogn</source><volume>9</volume><fpage>257</fpage><lpage>270</lpage></citation></ref><ref id="pone.0004086-Collett1"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Collett</surna