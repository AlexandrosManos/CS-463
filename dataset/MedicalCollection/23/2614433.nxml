</year><volume>86</volume><fpage>603</fpage><lpage>613</lpage><pub-id pub-id-type="pmid">16246381</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jeffery</surname><given-names>RW</given-names></name><name><surname>Utter</surname><given-names>J</given-names></name></person-group><article-title>The changing environment and population obesity in the United States</article-title><source>Obesity Research</source><year>2003</year><volume>11</volume><fpage>12S</fpage><lpage>22S</lpage><pub-id pub-id-type="pmid">14569035</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Prentice</surname><given-names>A</given-names></name><name><surname>Jebb</surname><given-names>S</given-names></name></person-group><article-title>Fast foods, energy density, and obesity: a possible mechanistic link</article-title><source>obesity reviews</source><year>2003</year><volume>4</volume><fpage>187</fpage><lpage>194</lpage><pub-id pub-id-type="pmid">14649369</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Story</surname><given-names>M</given-names></name><name><surname>Kaphingst</surname><given-names>KM</given-names></name><name><surname>Robinson-O'Brien</surname><given-names>R</given-names></name><name><surname>Glanz</surname><given-names>K</given-names></name></person-group><article-title>Creating Healthy Food and Eating Environments: Policy and Environmental Approaches</article-title><source>Annu Rev Public Health</source><year>2008</year><volume>29</volume><fpage>1</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">18173380</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bowman</surname><given-names>SA</given-names></name><name><surname>Vinyard</surname><given-names>BT</given-name