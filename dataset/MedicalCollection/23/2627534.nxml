-group-type="editor"><name><surname>Thompson</surname><given-names>JK</given-names></name></person-group><source>Body image, eating disorders and obesity an integrative guide for assessment and treatment</source><year>1996</year><publisher-loc>Washington:DC</publisher-loc><publisher-name>American Psychological Association</publisher-name><fpage>49</fpage><lpage>81</lpage></citation></ref><ref id="R9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gittelsohn</surname><given-names>J</given-names></name><name><surname>Harris</surname><given-names>SB</given-names></name><name><surname>Thorne-Lyman</surname><given-names>AL</given-names></name><etal/></person-group><article-title>Body image concepts differ by age and sex in an Ojibway-Cree community in Canada</article-title><source>J Nutr</source><year>1996</year><volume>126</volume><fpage>2990</fpage><lpage>3000</lpage><pub-id pub-id-type="pmid">9001366</pub-id></citation></ref><ref id="R10"><label>10</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Thompson</surname><given-names>JK</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Thompson</surname><given-names>JK</given-names></name></person-group><source>Body image, eating disorders and obesity an integrative guide for assessment and treatment</source><year>1996</year><publisher-loc>Washington:DC</publisher-loc><publisher-name>American Psychological Association</publisher-name><fpage>1</fpage><lpage>20</lpage></citation></ref><ref id="R11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weber</surname><given-names>C</given-names></name><name><surname>Bronner</surname><given-names>E</given-names></name><name><surname>Their</surname><given-names>P</given-names></name><etal/></person-group><article-title>Body experience and mental representation of body image in patients with haematological malignancies and cancer as assessed with the Body Grid</article-title><source>Br J Med Psychol</source><year>2001</year><volume>74</volume><fpage>507</fpage><lpage>21</lpage><pub-id pub-id-type="pmid">11780798</pub-id></citation></ref><ref id="R12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grabe</surname><given-names>S</given-names></name><name><surname>Hyde</surname><given-names>JS</given-names></name></person-group><article-title>Ethnicity and body dissatisfaction among women in the United States A meta-analysis</article-title><source>Psychol Bull</source><year>2006</year><volume>132</volume><fpage>622</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">16822170</pub-id></citation></ref><ref id="R13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kraus</surname><given-names>PL</given-names></name></person-group><article-title>Body image, decision making, and breast cancer treatment</article-title><source>Cancer Nurs</source><year>1999</year><volume>22</volume><fpage>421</fpage><lpage>27</lpage><pub-id pub-id-type="pmid">10603689</pub-id></citation></ref><ref id="R14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hider</surname><given-names>S</given-names></name><name><surname>Wong</surname><given-names>M</given-names></name><name><surname>Ortiz</surname><given-names>M</given-names></name><etal/></person-group><article-title>Does a regular exercise program for ankylosing spondylitis influence body image?</article-title><source>Scand J Rheumatol</source><year>2002</year><volume>31</volume><fpage>168</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">12195632</pub-id></citation></ref><ref id="R15"><label>15</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Williams</surname><given-names>B</given-names></name></person-group><article-title>The body experience in the context of arthritis: a psychosocial perspective [dissertation]</article-title><source>Dissertation Advisor Bartels J</source><year>2001</year><publisher-loc>Coventry (UK)</publisher-loc><publisher-name>Coventry University</publisher-name></citation></ref><ref id="R16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Slade</surname><given-names>PD</given-names></name><name><surname>Dewey</surname><given-names>ME</given-names></name><name><surname>Newton</surname><given-names>T</given-names></name><etal/></person-group><article-title>Development and preliminary validation of the Body Satisfaction Scale (BSS)</article-title><source>Psych Health</source><year>1990</year><volume>4</volume><fpage>213</fpage><lpage>20</lpage></citation></ref><ref id="R17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sloane</surname><given-names>PD</given-names></name><name><surname>Callahan</surname><given-names>L</given-names></name><name><surname>Kahwati</surname><given-names>L</given-names></name></person-group><article-title>Development of a practice-based patient cohort for primary care research</article-title><source>Fam Med</source><year>2006</year><volume>38</volume><fpage>50</fpage><lpage>57</lpage><pub-id pub-id-type="pmid">16378259</pub-id></citation></ref><ref id="R18"><label>18</label><citation citation-type="web"><article-title> Data and Statistics - BRFSS Arthritis Questions 1996-2009 2002) BRFSS Optional Module (Arthritis Burden Questions)</article-title><source>[cited] Available from <uri xlink:type="simple" xlink:href="http://www.cdc.gov/arthritis/ data_statistics/brfss_questions.htm">http://www.cdc.gov/arthritis/ data_statistics/brfss_questions.htm</uri></source><year>2007</year><month>10</month><access-date>20</access-date></citation></ref><ref id="R19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leventhal</surname><given-names>LJ</given-names></name></person-group><article-title>Management of fibromyalgia</article-title><source>Ann Intern Med</source><year>1999</year><volume>131</volume><fpage>850</fpage><lpage>58</lpage><pub-id pub-id-type="pmid">10610631</pub-id></citation></ref></ref-list></back><floats-wrap><fig id="F1" position="float"><label>Fig. (1)</label><caption><p>Scree plot of 3-factor structure of the overall sample.</p></caption><graphic xlink:href="TORJ-2-64_F1"/></fig><table-wrap id="T1" position="float"><label>Table 1</label><caption><p>Frequency Distribution of Demographic and Other Characteristics of the Study Sample (N=937)<xref ref-type="table-fn" rid="T1FN1">*</xref></p></caption><table frame="border" rules="all" width="100%"><thead><tr><th rowspan="1" colspan="1">Characteristics</th><th rowspan="1" colspan="1">Percent (%)</th></tr></thead><tbody><tr><td rowspan="1" colspan="1">Females</td><td align="center" rowspan="1" colspan="1">74.2</td></tr><tr><td rowspan="1" colspan="1">Caucasians</td><td align="center" rowspan="1" colspan="1">79.9</td></tr><tr><td rowspan="1" colspan="1">Income &#x0003c; $30,000</td><td align="center" rowspan="1" colspan="1">24.5</td></tr><tr><td rowspan="1" colspan="1">Less than HS education</td><td align="center" rowspan="1" colspan="1">16.0</td></tr><tr><td rowspan="1" colspan="1">Osteoarthritis</td><td align="center" rowspan="1" colspan="1">51.3</td></tr><tr><td rowspan="1" colspan="1">Rheumatoid arthritis</td><td align="center" rowspan="1" colspan="1">23.3</td></tr><tr><td rowspan="1" colspan="1">Fibromyalgia</td><td align="center" rowspan="1" colspan="1">12.6</td></tr><tr><td rowspan="1" colspan="1">Bursitis/Tendonitis</td><td align="center" rowspan="1" colspan="1">46.8</td></tr><tr><td rowspan="1" colspan="1">Carpal Tunnel</td><td align="center" rowspan="1" colspan="1">21.3</td></tr><tr><td rowspan="1" colspan="1">Gout</td><td align="center" rowspan="1" colspan="1">14.4</td></tr><tr><td rowspan="1" colspan="1">Other arthritis</td><td align="center" rowspan="1" colspan="1">11.8</td></tr><tr><td rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"><bold>Mean &#x000b1; SD</bold></td></tr><tr><td rowspan="1" colspan="1">BMI</td><td align="center" rowspan="1" colspan="1">30.2&#x000b1;7.1</td></tr><tr><td rowspan="1" colspan="1">Age</td><td align="center" rowspan="1" colspan="1">61&#x000b1;13.1</td></tr></tbody></table><table-wrap-foot><fn id="T1FN1"><label>*</label><p>Complete case analysis only. Many individuals reported multiple arthritis conditions.</p></fn></table-wrap-foot></table-wrap><table-wrap id="T2" position="float"><label>Table 2</label><caption><p>KMO and Bartlett's Test Statistics of 3-Factor Structure of the Overall Sample</p></caption><table frame="border" rules="all" width="100%"><thead><tr><th rowspan="1" colspan="1">Kaiser-Meyer-Olkin Measure of Sampling Adequacy</th><th align="center" rowspan="1" colspan="1">.77</th></tr></thead><tbody><tr><td colspan="2" rowspan="1"><bold>&#x000a0;&#x000a0; Bartlett's Test of Sphericity</bold></td></tr><tr><td rowspan="1" colspan="1">&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;Approx. Chi-Square</td><td align="center" rowspan="1" colspan="1">3041.57</td></tr><tr><td rowspan="1" colspan="1">&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;df</td><td align="center" rowspan="1" colspan="1">36</td></tr><tr><td rowspan="1" colspan="1">&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;Sig.</td><td align="center" rowspan="1" colspan="1">.000</td></tr></tbody></table></table-wrap><table-wrap id="T3" position="float"><label>Table 3</label><caption><p>Structure Matrix of the 3-Factor ABES Scale of the Overall Sample</p></caption><table frame="border" rules="all" width="100%"><thead><tr><th colspan="4" rowspan="1">Items&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0; &#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0; &#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;&#x000a0;Components</th></tr></thead><tbody><tr><td rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"><bold>1</bold></td><td align="center" rowspan="1" colspan="1"><bold>2</bold></td><td align="center" rowspan="1" colspan="1"><bold>3</bold></td></tr><tr><td rowspan="1" colspan="1">1. I am happy with my body</td><td align="center" rowspan="1" colspan="1"><bold>.839</bold></td><td align="center" rowspan="1" colspan="1">-.233</td><td align="center" rowspan="1" colspan="1">.042</td></tr><tr><td rowspan="1" colspan="1">2. I am happy with my posture</td><td align="center" rowspan="1" colspan="1"><bold>.813</bold></td><td align="center" rowspan="1" colspan="1">-.280</td><td align="center" rowspan="1" colspan="1">.062</td></tr><tr><td rowspan="1" colspan="1">3. I am happy with the way I walk</td><td align="center" rowspan="1" colspan="1"><bold>.820</bold></td><td align="center" rowspan="1" colspan="1">-.329</td><td align="center" rowspan="1" colspan="1">.066</td></tr><tr><td rowspan="1" colspan="1">4. My body is physically attractive</td><td align="center" rowspan="1" colspan="1"><bold>.814</bold></td><td align="center" rowspan="1" colspan="1">-.125</td><td align="center" rowspan="1" colspan="1">.033</td></tr><tr><td rowspan="1" colspan="1">5. I am self-conscious about the parts of my body affected by arthritis that are visible to others</td><td align="center" rowspan="1" colspan="1">.189</td><td align="center" rowspan="1" colspan="1">-.061</td><td align="center" rowspan="1" colspan="1"><bold>.825</bold></td></tr><tr><td rowspan="1" colspan="1">6. I am concerned with the physical fitness of my body-</td><td align="center" rowspan="1" colspan="1">-.096</td><td align="center" rowspan="1" colspan="1">.238</td><td align="center" rowspan="1" colspan="1"><bold>.821</bold></td></tr><tr><td rowspan="1" colspan="1">7. I am self-conscious about my body</td><td align="center" rowspan="1" colspan="1">-.208</td><td align="center" rowspan="1" colspan="1"><bold>.803</bold></td><td align="center" rowspan="1" colspan="1">.257</td></tr><tr><td rowspan="1" colspan="1">8. I wear particular clothing to hide certain parts of my body affected by arthritis</td><td align="center" rowspan="1" colspan="1">-.248</td><td align="center" rowspan="1" colspan="1"><bold>.907</bold></td><td align="center" rowspan="1" colspan="1">-.009</td></tr><tr><td rowspan="1" colspan="1">9. I am embarrassed about the parts of my body affected by arthritis</td><td align="center" rowspan="1" colspan="1">-.305</td><td align="center" rowspan="1" colspan="1"><bold>.904</bold></td><td align="center" rowspan="1" colspan="1">.031</td></tr></tbody></table><table-wrap-foot><fn id="T3FN3"><p>Extraction Method: Principal Component Analysis. Rotation Method: Oblimin with Kaiser Normalization. Bold Numbers Indicate Items&#x02019; High Loadings.</p></fn></table-wrap-foot></table-wrap><table-wrap id="T4" position="float"><label>Table 4</label><caption><p>Factor Loadings and Total Variance for 3-Factor Model of the Overall Sample (Total Variance Ex-plained)</p></caption><table frame="border" rules="all" width="100%"><thead><tr><th rowspan="2" colspan="1">Component</th><th colspan="3" rowspan="1">Extraction Sums of Squared Loadings</th><th rowspan="2" colspan="1">Rotation Total</th></tr><tr><th rowspan="1" colspan="1">Total</th><th rowspan="1" colspan="1">% of Variance</th><th rowspan="1" colspan="1">Cumulative %</th></tr></thead><tbody><tr><td align="center" rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">3.33</td><td align="center" rowspan="1" colspan="1">37.03</td><td align="center" rowspan="1" colspan="1">37.03</td><td align="center" rowspan="1" colspan="1">2.94</td></tr><tr><td align="center" rowspan="1" colspan="1">2</td><td align="center" rowspan="1" colspan="1">1.85</td><td align="center" rowspan="1" colspan="1">20.58</td><td align="center" rowspan="1" colspan="1">57.61</td><td align="center" rowspan="1" colspan="1">2.60</td></tr><tr><td align="center" rowspan="1" colspan="1">3</td><td align="center" rowspan="1" colspan="1">1.30</td><td align="center" rowspan="1" colspan="1">14.40</td><td align="center" rowspan="1" colspan="1">72.00</td><td align="center" rowspan="1" colspan="1">1.43</td></tr></tbody></table><table-wrap-foot><fn id="T4FN4"><p>Extraction Method: Principal Component Analysis.</p></fn></table-wrap-foot></table-wrap><table-wrap id="T5" position="float"><label>Table 5</label><caption><p