osa </italic>Neurons in Defined-Medium Organotypic Slice Culture are Similar to Those in Acute Slices from Young Adult Rats</article-title><source>Pain</source><year>2006</year><volume>121</volume><fpage>261</fpage><lpage>275</lpage><pub-id pub-id-type="pmid">16516387</pub-id><pub-id pub-id-type="doi">10.1016/j.pain.2006.01.009</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lu</surname><given-names>VB</given-names></name><name><surname>Ballanyi</surname><given-names>K</given-names></name><name><surname>Colmers</surname><given-names>WF</given-names></name><name><surname>Smith</surname><given-names>PA</given-names></name></person-group><article-title>Neuron type-specific effects of brain-derived neurotrophic factor in rat superficial dorsal horn and their relevance to 'central sensitization'</article-title><source>J Physiol</source><year>2007</year><volume>584</volume><fpage>543</fpage><lpage>563</lpage><pub-id pub-id-type="pmid">17761774</pub-id><pub-id pub-id-type="doi">10.1113/jphysiol.2007.141267</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ruangkittisakul</surname><given-names>A</given-names></name><name><surname>Schwarzacher</surname><given-names>SW</given-names></name><name><surname>Secchia</surname><given-names>L</given-names></name><name><surname>Poon</surname><given-names>BY</given-names></name><name><surname>Ma</surname><given-names>Y</given-names></name><name><surname>Funk</surname><given-names>GD</given-names></name><etal></etal></person-group><article-title>High sensitivity to neuromodulator-activated signaling pathways at physiological [K+] of confocally imaged respiratory center neurons in on-line-calibrated newborn rat brainstem slices</article-title><source>J Neurosci</source><year>2006</year><volume>26</volume><fpage>11870</fpage><lpage>11880</lpage><pub-id pub-id-type="pmid">17108160</