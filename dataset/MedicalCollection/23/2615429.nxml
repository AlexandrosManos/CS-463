/year><volume>14</volume><fpage>1</fpage><lpage>10</lpage><pub-id pub-id-type="pmid">14707165</pub-id><pub-id pub-id-type="doi">10.1101/gr.1717804</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pollard</surname><given-names>SL</given-names></name><name><surname>Holland</surname><given-names>PW</given-names></name></person-group><article-title>Evidence for 14 homeobox gene clusters in human genome ancestry</article-title><source>Current Biology</source><year>2000</year><volume>10</volume><fpage>1059</fpage><lpage>1062</lpage><pub-id pub-id-type="pmid">10996074</pub-id><pub-id pub-id-type="doi">10.1016/S0960-9822(00)00676-X</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kasahara</surname><given-names>M</given-names></name></person-group><article-title>The 2R hypothesis: an update</article-title><source>Curr Opin Immunol</source><year>2007</year><volume>19</volume><fpage>547</fpage><lpage>552</lpage><pub-id pub-id-type="pmid">17707623</pub-id><pub-id pub-id-type="doi">10.1016/j.coi.2007.07.009</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Abbasi</surname><given-names>AA</given-names></name><name><surname>Grzeschik</surname><given-names>KH</given-names></name></person-group><article-title>An insight into the phylogenetic history of HOX linked gene families in vertebrates</article-title><source>BMC Evol Biol</source><year>2007</year><volume>7</volume><fpage>239</fpage><pub-id pub-id-type="pmid">18053128</pub-id><pub-id pub-id-type="doi">10.1186/1471-2148-7-239</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hughes</surname><given-names>AL</given-names></name><name><surname>Friedman</surname><given-names>R</given-names></name></person-group><article-