title><source>Lancet</source><year>1999</year><volume>354</volume><fpage>1932</fpage><lpage>39</lpage><pub-id pub-id-type="pmid">10622295</pub-id></citation></ref><ref id="R11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lipksy</surname><given-names>PE</given-names></name><name><surname>van der Heijde</surname><given-names>DM</given-names></name><name><surname>St Clair</surname><given-names>EW</given-names></name><etal/></person-group><article-title>Anti-tumor necrosis factor alpha trial in rheumatoid arthritis with concomitant therapy study group, Infliximab and methotrexate in the treatment of rheumatoid arthritis</article-title><source>N Engl J Med</source><year>2000</year><volume>343</volume><fpage>1594</fpage><lpage>1602</lpage><pub-id pub-id-type="pmid">11096166</pub-id></citation></ref><ref id="R12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Constantin</surname><given-names>A</given-names></name><name><surname>Loubet-Lescoulie</surname><given-names>P</given-names></name><name><surname>Lambert</surname><given-names>N</given-names></name><etal/></person-group><article-title>Anti-inflammatory and immunoregulatory action of methotrexate in the treatment of rheumatoid arthritis, evidence of increased interleukin-4 and interleukin-10 gene expression demonstrated <italic>in vitro</italic> by competitive reverse transcription-polymerase chain reaction</article-title><source>Arthritis Rheum</source><year>1998</year><volume>41</volume><fpage>48</fpage><lpage>57</lpage><pub-id pub-id-type="pmid">9433869</pub-id></citation></ref><ref id="R13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kang</surname><given-names>BY</given-names></name><name><surname>Chung</surname><given-names>SW</given-names></name><name><surname>Im</surname><given-names>SY</given-names></name><name><surname>Choe</su