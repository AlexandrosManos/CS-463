/ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Waldorf</surname><given-names>D</given-names></name><name><surname>Reinarman</surname><given-names>C</given-names></name><name><surname>Murphy</surname><given-names>S</given-names></name></person-group><source>Cocaine Changes: The Experiences of Using and Quitting</source><year>1991</year><publisher-name>Philadelphia: Temple University Press</publisher-name></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reinarman</surname><given-names>C</given-names></name><name><surname>Cohen</surname><given-names>P</given-names></name></person-group><article-title>Lineaments of cannabis culture: rules regulating use in Amsterdam and San Francisco</article-title><source>Contemporary Justice Review</source><year>2007</year><volume>10</volume><fpage>393</fpage><lpage>410</lpage><pub-id pub-id-type="doi">10.1080/10282580701677451</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cheung</surname><given-names>Y</given-names></name></person-group><article-title>Substance use and developments in harm reduction</article-title><source>CMAJ</source><year>2000</year><volume>162</volume><fpage>1697</fpage><lpage>1700</lpage><pub-id pub-id-type="pmid">10870502</pub-id></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Erickson</surname><given-names>P</given-names></name><name><surname>Riley</surname><given-names>D</given-names></name><name><surname>Cheung</surname><given-names>Y</given-names></name><name><surname>O'Hare</surname><given-names>P</given-names></name></person-group><source>Harm Reduction: A New Direction for Drug Policies and Programs</source><year>1997</year><publisher-name>Toronto: University of Toronto Press</publisher-name></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Alexander</surname><given-names>A</given-names></name></person-group><article-title>Beyond Vancouver's "Four Pillars": an historical analysis</article-title><source>International Journal of Drug Policy</source><year>2006</year><volume>17</volume><fpage>118</fpage><lpage>123</lpage><pub-id pub-id-type="doi">10.1016/j.drugpo.2005.12.009</pub-id></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Boyd</surname><given-names>S</given-names></name><name><surname>Marcellus</surname><given-names>L</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Boyd S, Marcellus L</surname></name></person-group><article-title>Harm reduction in action</article-title><source>With Child: Substance Use During Pregnancy: A Woman-centred Approach</source><year>2007</year><publisher-name>Halifax: Fernwood Press</publisher-name></citation></ref><ref id="B16"><citation citation-type="other"><person-group person-group-type="author"><collab>Canadian HIV/AIDS Legal Network</collab></person-group><source>"Nothing About Us Without Us": Greater, Meaningful Involvement of People Who Use Illegal Drugs: A Public Health, Ethical, and Human Rights Imperative Author</source><year>2005</year></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grunskin</surname><given-names>S</given-names></name><name><surname>Plafker</surname><given-names>K</given-names></name><name><surname>Smith-Estelle</surname><given-names>A</given-names></name></person-group><article-title>Understanding and responding to youth substance use: the contribution of a health and human rights framework</article-title><source>American Journal of Public Health</source><year>2001</year><volume>91</volume><fpage>1954</fpage><lpage>1963</lpage><pub-id pub-id-type="pmid">11726374</pub-id><pub-