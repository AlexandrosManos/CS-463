20211+</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kobilka</surname><given-names>BK</given-names></name></person-group><article-title>G protein coupled receptor structure and activation</article-title><source>Biochim Biophys Acta</source><year>2007</year><volume>1768</volume><fpage>794</fpage><lpage>807</lpage><pub-id pub-id-type="pmid">17188232</pub-id><pub-id pub-id-type="doi">10.1016/j.bbamem.2006.10.021</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jakub&#x000ed;k</surname><given-names>J</given-names></name><name><surname>Bac&#x000e1;kov&#x000e1;</surname><given-names>L</given-names></name><name><surname>Lis&#x000e1;</surname><given-names>V</given-names></name><name><surname>el-Fakahany</surname><given-names>EE</given-names></name><name><surname>Tucek</surname><given-names>S</given-names></name></person-group><article-title>Activation of muscarinic acetylcholine receptors via their allosteric binding sites</article-title><source>Proc Natl Acad Sci USA</source><year>1997</year><volume>93</volume><fpage>A8705</fpage><lpage>8709</lpage><pub-id pub-id-type="doi">10.1073/pnas.93.16.8705</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thomas</surname><given-names>EA</given-names></name><name><surname>Carson</surname><given-names>MJ</given-names></name><name><surname>Neal</surname><given-names>MJ</given-names></name><name><surname>Sutcliffe</surname><given-names>JG</given-names></name></person-group><article-title>Unique allosteric regulation of 5-hydroxytryptamine receptor-mediated signal transduction by oleamide</article-title><source>Proc Natl Acad Sci USA</source><year>1997</year><volume>94</volume><fpage>14115</fpage><lpage>14119</lpage><pub-id pub-id-type="pmid">9391162</pub-id><pub-id pub-id-type="doi">10.1073/pnas.94