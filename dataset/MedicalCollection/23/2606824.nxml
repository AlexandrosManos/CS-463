n="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;<italic>n</italic></td><td colspan="1" rowspan="1" align="char" char="." valign="top">121</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Age (years)</td><td colspan="1" rowspan="1" align="center" valign="top">61 &#x000b1; 8</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Age categories (&#x00025;)</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;40&#x02013;49 years</td><td colspan="1" rowspan="1" align="char" char="." valign="top">9</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;50&#x02013;59 years</td><td colspan="1" rowspan="1" align="char" char="." valign="top">36</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;60&#x02013;69 years</td><td colspan="1" rowspan="1" align="char" char="." valign="top">41</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02265;70 years</td><td colspan="1" rowspan="1" align="char" char="." valign="top">14</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Sex (&#x00025;)</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;Male</td><td colspan="1" rowspan="1" align="char" char="." valign="top">61</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;Female</td><td colspan="1" rowspan="1" align="char" char="." valign="top">39</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Race (&#x00025;)</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;White</td><td colspan="1" rowspan="1" align="char" char="." valign="top">55</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;African American</td><td colspan="1" rowspan="1" align="char" char="." valign="top">33</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;Other or missing</td><td colspan="1" rowspan="1" align="char" char="." valign="top">12</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Body weight (lb)</td><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;Men</td><td colspan="1" rowspan="1" align="center" valign="top">226 &#x000b1; 38</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;Women</td><td colspan="1" rowspan="1" align="center" valign="top">191 &#x000b1; 36</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Adherence score<xref ref-type="table-fn" rid="t1fn1">&#x0002a;</xref></td><td colspan="1" rowspan="1" align="center" valign="top">1.02 &#x000b1; 0.23</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">&#x02003;&#x02003;&#x02003;&#x02003;Current or ex-smoker (&#x00025;)<xref ref-type="table-fn" rid="t1fn2">&