5 d<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">0.67 (0.46&#x02013;0.88)<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">0.40(0.133&#x02013;0.67)<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">0.98 (0.95&#x02013;1.00)<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">1.00<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">0.25 (0.075&#x02013;0.48)<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">3.93 &#x02028;(2.10&#x02013;11.92)<hr/></td></tr><tr><td valign="top" align="left" scope="col" rowspan="1" colspan="1">Campylobacteriosis</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/></tr><tr><td valign="top" align="left" scope="col" rowspan="1" colspan="1">	With blood</td><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/><td valign="top" align="left" rowspan="1" colspan="1"/></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1">		1&#x02013;2 d</td><td valign="top" align="center" rowspan="1" colspan="1">0.10 (0.07&#x02013;0.14)</td><td valign="top" align="center" rowspan="1" colspan="1">0.85 (0.72&#x02013;0.98)</td><td valign="top" align="center" rowspan="1" colspan="1">0.90 (0.85&#x02013;0.95)</td><td valign="top" align="center" rowspan="1" colspan="1">1.00</td><td valign="top" align="center" rowspan="1" colspan="1">0.08 (0.056&#x02013;0.11)</td><td valign="top" align="center" rowspan="1" colspan="1">12.40 &#x02028;(9.16&#x02013;17.82)</td></tr><tr><