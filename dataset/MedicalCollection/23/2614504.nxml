son-group-type="author"><name><surname>Cui</surname><given-names>X</given-names></name><name><surname>Schiff</surname><given-names>R</given-names></name><name><surname>Arpino</surname><given-names>G</given-names></name><name><surname>Osborne</surname><given-names>CK</given-names></name><name><surname>Lee</surname><given-names>AV</given-names></name></person-group><article-title>Biology of progesterone receptor loss in breast cancer and its implications for endocrine therapy</article-title><source>J Clin Oncol</source><year>2005</year><volume>23</volume><fpage>7721</fpage><lpage>7735</lpage><pub-id pub-id-type="pmid">16234531</pub-id><pub-id pub-id-type="doi">10.1200/JCO.2005.09.004</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>HJ</given-names></name><name><surname>Neven</surname><given-names>P</given-names></name><name><surname>Drijkoningen</surname><given-names>M</given-names></name><name><surname>Paridaens</surname><given-names>R</given-names></name><name><surname>Wildiers</surname><given-names>H</given-names></name><name><surname>Van Limbergen</surname><given-names>E</given-names></name><name><surname>Berteloot</surname><given-names>P</given-names></name><name><surname>Amant</surname><given-names>F</given-names></name><name><surname>Vergote</surname><given-names>I</given-names></name><name><surname>Christiaens</surname><given-names>MR</given-names></name></person-group><article-title>Association between tumour characteristics and HER-2/neu by immunohistochemistry in 1362 women with primary operable breast cancer</article-title><source>J Clin Pathol</source><year>2005</year><volume>58</volume><fpage>611</fpage><lpage>616</lpage><pub-id pub-id-type="pmid">15917412</pub-id><pub-id pub-id-type="doi">10.1136/jcp.2004.022772</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fagerhol