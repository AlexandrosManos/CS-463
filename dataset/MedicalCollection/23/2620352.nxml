erson-group-type="author"><name><surname>Perumal</surname><given-names>R</given-names></name><name><surname>Isakeit</surname><given-names>T</given-names></name><name><surname>Menz</surname><given-names>M</given-names></name><name><surname>Katile</surname><given-names>S</given-names></name><name><surname>No</surname><given-names>EG</given-names></name><name><surname>Magill</surname><given-names>CW</given-names></name></person-group><article-title>Characterization and genetic distance analysis of isolates of <italic>Peronosclerospora sorghi </italic>using AFLP fingerprinting</article-title><source>Mycological Research</source><year>2006</year><volume>110</volume><fpage>471</fpage><lpage>478</lpage><pub-id pub-id-type="pmid">16546365</pub-id><pub-id pub-id-type="doi">10.1016/j.mycres.2005.12.007</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jeffreys</surname><given-names>AJ</given-names></name><name><surname>Wilson</surname><given-names>V</given-names></name><name><surname>Thein</surname><given-names>SL</given-names></name></person-group><article-title>Hypervariable 'minisatellite' regions in human DNA</article-title><source>Nature</source><year>1985</year><volume>314</volume><fpage>67</fpage><lpage>73</lpage><pub-id pub-id-type="pmid">3856104</pub-id><pub-id pub-id-type="doi">10.1038/314067a0</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tautz</surname><given-names>D</given-names></name><name><surname>Renz</surname><given-names>M</given-names></name></person-group><article-title>Simple sequences are ubiquitous repetitive components of eukaryotic genomes</article-title><source>Nucleic Acids Res</source><year>1984</year><volume>12</volume><fpage>4127</fpage><lpage>4138</lpage><pub-id pub-id-type="pmid">6328411</pub-id><pub-id pub-id-type="doi">10.1093/nar/12.10.4127</pub-id></citation></ref><ref id="B18"><c