></name><name><surname>Fadiora</surname><given-names>FO</given-names></name><name><surname>Agbakwuru</surname><given-names>EA</given-names></name></person-group><article-title>Generalized peritonitis secondary to typhoid ileal perforation: Assessment of severity using modified APACHE II score</article-title><source>Indian J surg</source><year>2005</year><volume>67</volume><fpage>29</fpage><lpage>33</lpage></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adesunkanmi</surname><given-names/></name><name><surname>Abdul Rashid</surname><given-names>K</given-names></name><name><surname>Badmus</surname><given-names/></name><name><surname>Tajudeen</surname><given-names>A</given-names></name><name><surname>Olukayode</surname><given-names>O</given-names></name></person-group><article-title>Causes and determinants of outcome of intestinal perforations in a semi urban African community</article-title><source>Surgical practice</source><year>2003</year><volume>7</volume><fpage>116</fpage><lpage>123</lpage></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Agarwall</surname><given-names>N</given-names></name><name><surname>Saha</surname><given-names>S</given-names></name><name><surname>Srivastava</surname><given-names>A</given-names></name><name><surname>Chumber</surname><given-names>S</given-names></name><name><surname>Dhar</surname><given-names>A</given-names></name><name><surname>Garg</surname><given-names>S</given-names></name></person-group><article-title>Peritonitis 10 years experience in a single surgical unit</article-title><source>Trop Gastroenterol</source><year>2007</year><volume>28</volume><fpage>117</fpage><lpage>20</lpage><pub-id pub-id-type="pmid">18384000</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Malangoni</surname><given-names>MA</given-names></name><name><surname>Inui</surname><given-names>T</given-names></name></person-group><article-title>Peritonitis the western experience</article-title><source>World J emerg surg</source><year>2006</year><volume>1</volume><fpage>25</fpage><pub-id pub-id-type="pmid">16953882</pub-id><pub-id pub-id-type="doi">10.1186/1749-7922-1-25</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gupta</surname><given-names>S</given-names></name><name><surname>Kaushik</surname><given-names>R</given-names></name></person-group><article-title>Peritonitis &#x02013; the Eastern experience</article-title><source>World J Emerg Surg</source><volume>1</volume><fpage>13</fpage><comment>2006; Apr 26; PMID 16759427</comment><pub-id pub-id-type="pmid">16759427</pub-id><pub-id pub-id-type="doi">10.1186/1749-7922-1-13</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Siu</surname><given-names>WT</given-names></name><name><surname>Leong</surname><given-names>HT</given-names></name><name><surname>Law</surname><given-names>BK</given-names></name><name><surname>Chau</surname><given-names>CH</given-names></name><name><surname>Li</surname><given-names>AC</given-names></name><name><surname>Fung</surname><given-names>KH</given-names></name><name><surname>Tai</surname><given-names>YP</given-names></name><name><surname>Li</surname><given-names>MK</given-names></name></person-group><article-title>Laproscopic repair for perforated peptic ulcer. A randomized controlled trial</article-title><source>Ann Surg</source><year>2002</year><volume>235</volume><fpage>313</fpage><lpage>319</lpage><pub-id pub-id-type="pmid">11882751</pub-id><pub-id pub-id-type="doi">10.1097/00000658-200203000-00001</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jhobta</surname><given-names>RS Singh</give