ine Catalase</bold></td><td align="center" rowspan="1" colspan="1">p = 0.10</td><td align="center" rowspan="1" colspan="1">p = 0.05</td><td align="center" rowspan="1" colspan="1">p = 0.01</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>Bovine serum albumin</bold></td><td align="center" rowspan="1" colspan="1">p = 0.04</td><td align="center" rowspan="1" colspan="1">p = 0.05</td><td align="center" rowspan="1" colspan="1">p = 0.01</td></tr><tr><td colspan="4" align="left" rowspan="1"><bold>Spectral Count</bold> (no. protein tested = 345)<xref ref-type="table-fn" rid="tfn2-cin-6-0243">*</xref></td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>Bovine Catalase</bold></td><td align="center" rowspan="1" colspan="1">p = 0.08</td><td align="center" rowspan="1" colspan="1">p = 0.01</td><td align="center" rowspan="1" colspan="1">p = 0.05</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>Bovine serum albumin</bold></td><td align="center" rowspan="1" colspan="1">p = 0.02</td><td align="center" rowspan="1" colspan="1">p = 0.01</td><td align="center" rowspan="1" colspan="1">p = 0.24</td></tr></tbody></table><table-wrap-foot><fn id="tfn2-cin-6-0243"><label>*</label><p>Total number of proteins identified and quantified by each method.</p></fn></table-wrap-foot></table-wrap></floats-group></article>