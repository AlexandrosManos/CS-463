<ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dickson</surname><given-names>RA</given-names></name></person-group><article-title>Conservative treatment for idiopathic scoliosis</article-title><source>J Bone Joint Surg Br</source><year>1985</year><volume>67</volume><fpage>176</fpage><lpage>181</lpage><pub-id pub-id-type="pmid">3872301</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dolan</surname><given-names>LA</given-names></name><name><surname>Donnelly</surname><given-names>MJ</given-names></name><name><surname>Spratt</surname><given-names>KF</given-names></name><name><surname>Weinstein</surname><given-names>SL</given-names></name></person-group><article-title>Professional opinion concerning the effectiveness of bracing relative to observation in adolescent idiopathic scoliosis</article-title><source>J Pediatr Orthop</source><year>2007</year><volume>27</volume><fpage>270</fpage><lpage>276</lpage><pub-id pub-id-type="pmid">17414008</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldberg</surname><given-names>CJ</given-names></name><name><surname>Moore</surname><given-names>DP</given-names></name><name><surname>Fogarty</surname><given-names>EE</given-names></name><name><surname>Dowling</surname><given-names>FE</given-names></name></person-group><article-title>Adolescent idiopathic scoliosis: the effect of brace treatment on the incidence of surgery</article-title><source>Spine</source><year>2001</year><volume>26</volume><fpage>42</fpage><lpage>47</lpage><pub-id pub-id-type="pmid">11148644</pub-id><pub-id pub-id-type="doi">10.1097/00007632-200101010-00009</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Negrini</surname><given-names>S</given-names></name><name><surname>Marchini</surname><given-names>G</given-names></name></person-group><article-title>Efficacy of the Symmetric, Patient-oriented, Rigid, Three-dimensional, active (SPoRT) concept of bracing for scoliosis: a prospective study of the Sforzesco versus Lyon brace</article-title><source>Eura Medicophys</source><year>2007</year><volume>43</volume><fpage>171</fpage><lpage>181</lpage><pub-id pub-id-type="pmid">16955065</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Negrini</surname><given-names>S</given-names></name><name><surname>Marchini</surname><given-names>G</given-names></name><name><surname>Tomaello</surname><given-names>L</given-names></name></person-group><article-title>The Sforzesco brace and SPoRT concept (Symmetric, Patient-oriented, Rigid, Three-dimensional) versus the Lyon brace and 3-point systems for bracing idiopathic scoliosis</article-title><source>Stud Health Technol Inform</source><year>2006</year><volume>123</volume><fpage>245</fpage><lpage>249</lpage><pub-id pub-id-type="pmid">17108434</pub-id></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Zaina</surname><given-names>F</given-names></name><name><surname>Negrini</surname><given-names>S</given-names></name><name><surname>Monticone</surname><given-names>M</given-names></name><name><surname>Paroli</surname><given-names>C</given-names></name><name><surname>Aulisa</surname><given-names>AG</given-names></name></person-group><article-title>Repeatability of the Aesthetic Index for adolescent scoliosis idiopathic evaluation</article-title><source>4th International Conference on Conservative Management of Spinal Deformities: 13&#x02013;16 May 2007</source><year>2007</year><publisher-name>Boston: SOSORT (Society on Scoliosis Orthopaedic and Rehabilitation Treatment)</publisher-name></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-