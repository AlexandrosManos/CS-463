ml:mo stretchy="true">&#x000af;</mml:mo></mml:mrow></mml:mover></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mi>k</mml:mi></mml:mrow></mml:msub><mml:mo>&#x02212;</mml:mo><mml:mi>&#x003bc;</mml:mi><mml:mo minsize="1em" maxsize="1em">)</mml:mo></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msup></mml:mrow><mml:mo minsize="1em" maxsize="1em">|</mml:mo></mml:mrow><mml:mrow><mml:mrow><mml:mo stretchy="false">(</mml:mo><mml:mi>&#x003b1;</mml:mi><mml:mo>+</mml:mo><mml:msub><mml:mrow><mml:mi>N</mml:mi></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mi>k</mml:mi></mml:mrow></mml:msub><mml:mo stretchy="false">)</mml:mo><mml:mo>/</mml:mo><mml:mn>2</mml:mn></mml:mrow><mml:mrow/></mml:mrow></mml:msup></mml:mrow></mml:mfrac><mml:mn>.</mml:mn></mml:mtd></mml:mtr></mml:mtable></mml:mrow></mml:math></disp-formula>The dataenters this equationvia<disp-formula id="eq004"><label>(21)</label><mml:math id="M28"><mml:mrow><mml:mtable><mml:mtr><mml:mtd/><mml:mtd><mml:msub><mml:mrow><mml:mover accent="true"><mml:mrow><mml:mi>x</mml:mi></mml:mrow><mml:mrow><mml:mo stretchy="true">&#x000af;</mml:mo></mml:mrow></mml:mover></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mi>k</mml:mi></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:mfrac><mml:mrow><mml:mn>1</mml:mn></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>N</mml:mi></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mi>k</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:mstyle displaystyle="true"><mml:mrow><mml:munder><mml:mrow><mml:mo>&#x02211;</mml:mo></mml:mrow><mml:mrow><mml:mi>j</mml:mi><mml:mo>&#x02223;</mml:mo><mml:msub><mml:mrow><mml:mi>&#x003b4;</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>&#x02110;</mml:mi></mml:mrow><mml:mrow><mml:mi>j</mml:mi></mml:mrow></mml:msub><mml:mn>,</mml:mn><mml:mi>e</mml:mi></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:mi>k</mml:mi></mml:mrow></mml:munder></mml:mrow></mml:mstyle><mml:msub><mml:mrow><mml:mi>d</mml:mi></mml:mrow><mml:mrow><mml:msup><mml:mrow><mml:mi>e</mml:mi></mml:mrow><mml:mrow><mml:mo>&#x02032;</mml:mo></mml:mrow></mml:msup><mml:mn>,</mml:mn><mml:msub><mml:mrow><mml:mi>&#x02110;</mml:mi></mml:mrow><mml:mrow><mml:mi>j</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:msub><mml:mn>,</mml:mn><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:msub><mml:mrow><mml:mi>s</mml:mi></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mi>k</mml:mi></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:mstyle displaystyle="true"><mml:mrow><mml:munder><mml:mrow><mml:mo>&#x02211;</mml:mo></mml:mrow><mml:mrow><mml:mi>j</mml:mi><mml:mo>&#x02223;</mml:mo><mml:msub><mml:mrow><mml:mi>&#x003b4;</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>&#x02110;</mml:mi></mml:mrow><mml:mrow><mml:mi>j</mml:mi></mml:mrow></mml:msub><mml:mn>,</mml:mn><mml:mi>e</mml:mi></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:mi>k</mml:mi></mml:mrow></mml:munder></mml:mrow></mml:mstyle><mml:msup><mml:mrow><mml:mo minsize="1em" maxsize="1em">(</mml:mo><mml:msub><mml:mrow><mml:mi>d</mml:mi></mml:mrow><mml:mrow><mml:msup><mml:mrow><mml:mi>e</mml:mi></mml:mrow><mml:mrow><mml:mo>&#x02032;</mml:mo></mml:mrow></mml:msup><mml:mn>,</mml:mn><mml:msub><mml:mrow><mml:mi>&#x02110;</mml:mi></mml:mrow><mml:mrow><mml:mi>j</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:msub><mml:mo>&#x02212;</mml:mo><mml:msub><mml:mrow><mml:mover accent="true"><mml:mrow><mml:mi>x</mml:mi></mml:mrow><mml:mrow><mml:mo stretchy="true">&#x000af;</mml:mo></mml:mrow></mml:mover></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mi>k</mml:mi></mml:mrow></mml:msub><mml:mo minsize="1em" maxsize="1em">)</mml:mo></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msup><mml:mn>.</mml:mn></mml:mtd></mml:mtr></mml:mtable></mml:mrow></mml:math></disp-formula></p></statement></p></sec><sec sec-type="subsection" id="subsec5.2"><title>5.2. Maximum Likelihood Learning of the Local Parameters</title><p>Let the topology <italic>&#x1d4af;</italic> and the interventions <italic>&#x02110;</italic><sub><italic>j</italic></sub> be given. For learning the parameters of thelocal distributions <italic>p</italic>(<italic>e</italic>&#x02032; &#x02223; <italic>e</italic>),we perform maximum likelihood estimation in two different settings. Theobservables are assumed to follow either a binomial distribution or a Gaussiandistribution.</p><p><statement id="head2"><title>Binary Observables</title><p>For an effect <italic>e</italic> &#x02208; <italic>&#x02130;</italic>,let its observable <italic>e</italic>&#x02032; be a binary random variable with values in {0, 1},and let <italic>p</italic>(<italic>e</italic>&#x02032; = 1 &#x02223; <italic>e</italic> = <italic>x</italic>) = <italic>&#x003b2;</italic><sub><italic>e</italic>,<italic>x</italic></sub>, <italic>x</italic> &#x02208; {0, 1}.The model is then completely parameterized by the topology <italic>&#x1d4af;</italic> and <italic>&#x02112;</italic> = {<italic>&#x003b2;</italic><sub><italic>e</italic>,<italic>x</italic></sub> &#x02223; <italic>e</italic> &#x02208; <italic>&#x02130;</italic>, &#x02009;  <italic>x</italic> &#x02208; {0, 1}}.</p></statement></p><p>Note that<disp-formula id="eq20"><label>(22)</label><mml:math id="M29"><mml:mrow><mml:mtable columnalign="left"><mml:mtr><mml:mtd/><mml:mtd><mml:mi>P</mml:mi><mml:mo stretchy="false">(</mml:mo><mml:msub><mml:mrow><mml:mi>D</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>,</mml:mo><mml:mo>&#x02026;</mml:mo><mml:mo>,</mml:mo><mml:msub><mml:mrow><mml:mi>D</mml:mi></mml:mrow><mml:mrow><mml:mi>N</mml:mi></mml:mrow></mml:msub><mml:mo>&#x02223;</mml:mo><mml:mi>&#x1d4af;</mml:mi><mml:mn>,</mml:mn><mml:mi>&#x02112;</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mtd></mml:mtr><mml:mtr><mml:mtd/><mml:mtd><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mo>=</mml:mo><mml:mtext>&#x02009;</mml:mtext><mml:mtext>&#x02009;</mml:mtext><mml:mstyle displaystyle="true"><mml:mrow><mml:munderover><mml:mrow><mml:mo>&#x0220f;</mml:mo></mml:mrow><mml:mrow><mml:mi>j</mml:mi><mml:mo>=</mml:mo><mml:mn>1</mml:mn></mml:mrow><mml:mrow><mml:mi>N</mml:mi></mml:mrow></mml:munderover></mml:mrow></mml:mstyle><mml:mtext>&#x02009;</mml:mtext><mml:mstyle displaystyle="true"><mml:mrow><mml:munder><mml:mrow><mml:mo>&#x0220f;</mml:mo></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mo>&#x02208;</mml:mo><mml:mi>&#x02130;</mml:mi></mml:mrow></mml:munder></mml:mrow></mml:mstyle><mml:mi>p</mml:mi><mml:mo minsize="1em" maxsize="1em">(</mml:mo><mml:msup><mml:mrow><mml:mi>e</mml:mi></mml:mrow><mml:mrow><mml:mo>&#x02032;</mml:mo></mml:mrow></mml:msup><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi>d</mml:mi></mml:mrow><mml:mrow><mml:msup><mml:mrow><mml:mi>e</mml:mi></mml:mrow><mml:mrow><mml:mo>&#x02032;</mml:mo></mml:mrow></mml:msup><mml:mn>,</mml:mn><mml:msub><mml:mrow><mml:mi>&#x02110;</mml:mi></mml:mrow><mml:mrow><mml:mi>j</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:msub><mml:mo>&#x02223;</mml:mo><mml:mi>e</mml:mi><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi>&#x003b4;</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>&#x02110;</mml:mi></mml:mrow><mml:mrow><mml:mi>j</mml:mi></mml:mrow></mml:msub><mml:mn>,</mml:mn><mml:mi>e</mml:mi></mml:mrow></mml:msub><mml:mo minsize="1em" maxsize="1em">)</mml:mo></mml:mtd></mml:mtr><mml:mtr><mml:mtd/><mml:mtd><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mo>=</mml:mo><mml:mstyle displaystyle="true"><mml:mrow><mml:munder><mml:mrow><mml:mo>&#x0220f;</mml:mo></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mo>&#x02208;</mml:mo><mml:mi>&#x02130;</mml:mi></mml:mrow></mml:munder></mml:mrow></mml:mstyle><mml:mtext>&#x02009;</mml:mtext><mml:mstyle displaystyle="true"><mml:mrow><mml:munder><mml:mrow><mml:mo>&#x0220f;</mml:mo></mml:mrow><mml:mrow><mml:mi>x</mml:mi><mml:mo>&#x02208;</mml:mo><mml:mo minsize="0.75em" maxsize="0.75em">{</mml:mo><mml:mn>0</mml:mn><mml:mo>,</mml:mo><mml:mn>1</mml:mn><mml:mo minsize="0.75em" maxsize="0.75em">}</mml:mo></mml:mrow></mml:munder></mml:mrow></mml:mstyle><mml:mtext>&#x02009;</mml:mtext><mml:mstyle displaystyle="true"><mml:mrow><mml:munder><mml:mrow><mml:mo>&#x0220f;</mml:mo></mml:mrow><mml:mrow><mml:mi>j</mml:mi><mml:mo>&#x02223;</mml:mo><mml:msub><mml:mrow><mml:mi>&#x003b4;</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>&#x02110;</mml:mi></mml:mrow><mml:mrow><mml:mi>j</mml:mi></mml:mrow></mml:msub><mml:mn>,</mml:mn><mml:mi>e</mml:mi></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:mi>x</mml:mi></mml:mrow></mml:munder></mml:mrow></mml:mstyle><mml:mi>p</mml:mi><mml:mo minsize="1em" maxsize="1em">(</mml:mo><mml:msup><mml:mrow><mml:mi>e</mml:mi></mml:mrow><mml:mrow><mml:mo>&#x02032;</mml:mo></mml:mrow></mml:msup><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi>d</mml:mi></mml:mrow><mml:mrow><mml:msup><mml:mrow><mml:mi>e</mml:mi></mml:mrow><mml:mrow><mml:mo>&#x02032;</mml:mo></mml:mrow></mml:msup><mml:mn>,</mml:mn><mml:msub><mml:mrow><mml:mi>&#x02110;</mml:mi></mml:mrow><mml:mrow><mml:mi>j</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:msub><mml:mo>&#x02223;</mml:mo><mml:mi>e</mml:mi><mml:mo>=</mml:mo><mml:mi>x</mml:mi><mml:mo minsize="1em" maxsize="1em">)</mml:mo></mml:mtd></mml:mtr><mml:mtr><mml:mtd/><mml:mtd><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mo>=</mml:mo><mml:mstyle displaystyle="true"><mml:mrow><mml:munder><mml:mrow><mml:mo>&#x0220f;</mml:mo></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mo>&#x02208;</mml:mo><mml:mi>&#x02130;</mml:mi></mml:mrow></mml:munder></mml:mrow></mml:mstyle><mml:mtext>&#x02009;</mml:mtext><mml:mstyle displaystyle="true"><mml:mrow><mml:munder><mml:mrow><mml:mo>&#x0220f;</mml:mo></mml:mrow><mml:mrow><mml:mi>x</mml:mi><mml:mo>&#x02208;</mml:mo><mml:mo minsize="0.75em" maxsize="0.75em">{</mml:mo><mml:mn>0</mml:mn><mml:mo>,</mml:mo><mml:mn>1</mml:mn><mml:mo minsize="0.75em" maxsize="0.75em">}</mml:mo></mml:mrow></mml:munder></mml:mrow></mml:mstyle><mml:mi>B</mml:mi><mml:mo minsize="1em" maxsize="1em">(</mml:mo><mml:mi>k</mml:mi><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi>N</mml:mi></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mi>x</mml:mi><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>;</mml:mo><mml:mi>n</mml:mi><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi>N</mml:mi></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mi>x</mml:mi></mml:mrow></mml:msub><mml:mn>,</mml:mn><mml:mi>p</mml:mi><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi>&#x003b2;</mml:mi></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mn>,</mml:mn><mml:mi>x</mml:mi></mml:mrow></mml:msub><mml:mo minsize="1em" maxsize="1em">)</mml:mo><mml:mo>,</mml:mo></mml:mtd></mml:mtr></mml:mtable><mml:mtable width="auto" columnalign="left"><mml:mtr><mml:mtd><mml:mtext>&#x02009;</mml:mtext></mml:mtd></mml:mtr><mml:mtr><mml:mtd/></mml:mtr><mml:mtr><mml:mtd/></mml:mtr></mml:mtable></mml:mrow></mml:math></disp-formula>with <inline-formula><mml:math id="M30"><mml:mrow><mml:mi>B</mml:mi><mml:mo stretchy="false">(</mml:mo><mml:mi>k</mml:mi><mml:mo>;</mml:mo><mml:mi>n</mml:mi><mml:mn>,</mml:mn><mml:mi>p</mml:mi><mml:mo stretchy="false">)</mml:mo><mml:mo>=</mml:mo><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mtable><mml:mtr><mml:mtd><mml:mi>n</mml:mi></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mi>k</mml:mi></mml:mtd></mml:mtr></mml:mtable></mml:mrow><mml:mo>)</mml:mo></mml:mrow><mml:msup><mml:mrow><mml:mi>p</mml:mi></mml:mrow><mml:mrow><mml:mi>k</mml:mi></mml:mrow></mml:msup><mml:msup><mml:mrow><mml:mo stretchy="false">(</mml:mo><mml:mn>1</mml:mn><mml:mo>&#x02212;</mml:mo><mml:mi>p</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mrow><mml:mrow><mml:mi>n</mml:mi><mml:mo>&#x02212;</mml:mo><mml:mi>k</mml:mi></mml:mrow></mml:msup></mml:mrow></mml:math></inline-formula>.The parameter set <inline-formula><mml:math id="M31"><mml:mrow><mml:mover accent="true"><mml:mi>&#x02112;</mml:mi><mml:mo>^</mml:mo></mml:mover></mml:mrow></mml:math></inline-formula> that maximizes expression (<xref ref-type="disp-formula" rid="eq20">22</xref>)is<disp-formula id="eq21"><label>(23)</label><mml:math id="M32"><mml:mrow><mml:msub><mml:mrow><mml:mover accent="true"><mml:mrow><mml:mi>&#x003b2;</mml:mi></mml:mrow><mml:mrow><mml:mo>^</mml:mo></mml:mrow></mml:mover></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mn>,</mml:mn><mml:mi>x</mml:mi></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:mfrac><mml:mrow><mml:msub><mml:mrow><mml:mi>N</mml:mi></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mi>x</mml:mi><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>N</mml:mi></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mi>x</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:mn>,</mml:mn><mml:mi>&#x02003;</mml:mi><mml:mi>e</mml:mi><mml:mo>&#x02208;</mml:mo><mml:mi>&#x02130;</mml:mi><mml:mn>,</mml:mn><mml:mtext>&#x02009;</mml:mtext><mml:mtext>&#x02009;</mml:mtext><mml:mi>x</mml:mi><mml:mo>&#x02208;</mml:mo><mml:mo minsize="0.75em" maxsize="0.75em">{</mml:mo><mml:mn>0</mml:mn><mml:mo>,</mml:mo><mml:mn>1</mml:mn><mml:mo minsize="0.75em" maxsize="0.75em">}</mml:mo></mml:mrow></mml:math></disp-formula>(the ratios with a denominatorof zero are irrelevant for the evaluation of (<xref ref-type="disp-formula" rid="eq20">22</xref>) and are set to zero).</p><p><statement id="head4"><title>Continuous Observables</title><p>There is an analogous way of doing ML estimation inthe case of continuous observable variables if oneassumes <italic>p</italic>(<italic>e</italic>&#x02032; &#x02223; <italic>e</italic> = <italic>x</italic>) to be a normal distribution with mean <italic>&#x003bc;</italic><sub><italic>e</italic>,<italic>x</italic></sub> and variance <italic>&#x003c3;</italic><sub><italic>e</italic>, <italic>x</italic></sub><sup>2</sup>, <italic>e</italic> &#x02208; <italic>&#x02130;</italic>, <italic>x</italic> &#x02208; {0, 1}.</p></statement></p><p>Note that<disp-formula id="eq22"><label>(24)</label><mml:math id="M33"><mml:mrow><mml:mtable width="auto" columnalign="left"><mml:mtr><mml:mtd/><mml:mtd><mml:mi>P</mml:mi><mml:mo minsize="1em" maxsize="1em">(</mml:mo><mml:msub><mml:mrow><mml:mi>D</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>,</mml:mo><mml:mo>&#x02026;</mml:mo><mml:mo>,</mml:mo><mml:msub><mml:mrow><mml:mi>D</mml:mi></mml:mrow><mml:mrow><mml:mi>N</mml:mi></mml:mrow></mml:msub><mml:mo>&#x02223;</mml:mo><mml:mi>&#x1d4af;</mml:mi><mml:mn>,</mml:mn><mml:mi>&#x02112;</mml:mi><mml:mo minsize="1em" maxsize="1em">)</mml:mo></mml:mtd></mml:mtr><mml:mtr><mml:mtd/><mml:mtd><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mo>=</mml:mo><mml:mstyle displaystyle="true"><mml:mrow><mml:munderover><mml:mrow><mml:mo>&#x0220f;</mml:mo></mml:mrow><mml:mrow><mml:mi>j</mml:mi><mml:mo>=</mml:mo><mml:mn>1</mml:mn></mml:mrow><mml:mrow><mml:mi>N</mml:mi></mml:mrow></mml:munderover></mml:mrow></mml:mstyle><mml:mtext>&#x02009;</mml:mtext><mml:mstyle displaystyle="true"><mml:mrow><mml:munder><mml:mrow><mml:mo>&#x0220f;</mml:mo></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mo>&#x02208;</mml:mo><mml:mi>&#x02130;</mml:mi></mml:mrow></mml:munder></mml:mrow></mml:mstyle><mml:mi>p</mml:mi><mml:mo minsize="1em" maxsize="1em">(</mml:mo><mml:msup><mml:mrow><mml:mi>e</mml:mi></mml:mrow><mml:mrow><mml:mo>&#x02032;</mml:mo></mml:mrow></mml:msup><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi>d</mml:mi></mml:mrow><mml:mrow><mml:msup><mml:mrow><mml:mi>e</mml:mi></mml:mrow><mml:mrow><mml:mo>&#x02032;</mml:mo></mml:mrow></mml:msup><mml:mn>,</mml:mn><mml:msub><mml:mrow><mml:mi>&#x02110;</mml:mi></mml:mrow><mml:mrow><mml:mi>j</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:msub><mml:mo>&#x02223;</mml:mo><mml:mi>e</mml:mi><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi>&#x003b4;</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>&#x02110;</mml:mi></mml:mrow><mml:mrow><mml:mi>j</mml:mi></mml:mrow></mml:msub><mml:mn>,</mml:mn><mml:mi>e</mml:mi></mml:mrow></mml:msub><mml:mo minsize="1em" maxsize="1em">)</mml:mo><mml:mo>,</mml:mo></mml:mtd></mml:mtr><mml:mtr><mml:mtd/><mml:mtd><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mo>=</mml:mo><mml:mstyle displaystyle="true"><mml:mrow><mml:munder><mml:mrow><mml:mo>&#x0220f;</mml:mo></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mo>&#x02208;</mml:mo><mml:mi>&#x02130;</mml:mi></mml:mrow></mml:munder></mml:mrow></mml:mstyle><mml:mtext>&#x02009;</mml:mtext><mml:mstyle displaystyle="true"><mml:mrow><mml:munder><mml:mrow><mml:mo>&#x0220f;</mml:mo></mml:mrow><mml:mrow><mml:mi>x</mml:mi><mml:mo>&#x02208;</mml:mo><mml:mo minsize="0.75em" maxsize="0.75em">{</mml:mo><mml:mn>0</mml:mn><mml:mo>,</mml:mo><mml:mn>1</mml:mn><mml:mo minsize="0.75em" maxsize="0.75em">}</mml:mo></mml:mrow></mml:munder></mml:mrow></mml:mstyle><mml:mtext>&#x02009;</mml:mtext><mml:mstyle displaystyle="true"><mml:mrow><mml:munder><mml:mrow><mml:mo>&#x0220f;</mml:mo></mml:mrow><mml:mrow><mml:mi>j</mml:mi><mml:mo>&#x02223;</mml:mo><mml:msub><mml:mrow><mml:mi>&#x003b4;</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>&#x02110;</mml:mi></mml:mrow><mml:mrow><mml:mi>j</mml:mi></mml:mrow></mml:msub><mml:mn>,</mml:mn><mml:mi>e</mml:mi></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:mi>x</mml:mi></mml:mrow></mml:munder></mml:mrow></mml:mstyle><mml:mi>p</mml:mi><mml:mo minsize="1em" maxsize="1em">(</mml:mo><mml:msup><mml:mrow><mml:mi>e</mml:mi></mml:mrow><mml:mrow><mml:mo>&#x02032;</mml:mo></mml:mrow></mml:msup><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi>d</mml:mi></mml:mrow><mml:mrow><mml:msup><mml:mrow><mml:mi>e</mml:mi></mml:mrow><mml:mrow><mml:mo>&#x02032;</mml:mo></mml:mrow></mml:msup><mml:mn>,</mml:mn><mml:msub><mml:mrow><mml:mi>&#x02110;</mml:mi></mml:mrow><mml:mrow><mml:mi>j</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:msub><mml:mo>&#x02223;</mml:mo><mml:mi>e</mml:mi><mml:mo>=</mml:mo><mml:mi>x</mml:mi><mml:mo minsize="1em" maxsize="1em">)</mml:mo></mml:mtd></mml:mtr><mml:mtr><mml:mtd/><mml:mtd><mml:mi>&#x02003;</mml:mi><mml:mi>&#x02003;</mml:mi><mml:mo>=</mml:mo><mml:mstyle displaystyle="true"><mml:mrow><mml:munder><mml:mrow><mml:mo>&#x0220f;</mml:mo></mml:mrow><mml:mrow><mml:mi>e</mml:mi><mml:mo>&#x02208;</mml:mo><mml:mi>&#x02130;</mml:mi></mml:mrow></mml:munder></