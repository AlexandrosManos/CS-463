lume>26</volume><fpage>1296</fpage><lpage>1301</lpage><pub-id pub-id-type="pmid">12360044</pub-id><pub-id pub-id-type="doi">10.1097/00000478-200210000-00006</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Herrington</surname><given-names>JL</given-names></name><name><surname>Edwards</surname><given-names>WH</given-names></name><name><surname>Grossman</surname><given-names>LA</given-names></name></person-group><article-title>Mesenteric Manifestations of Weber-Christian disease</article-title><source>Annals of Surgery</source><year>1961</year><volume>154</volume><fpage>949</fpage><lpage>955</lpage><pub-id pub-id-type="pmid">13906825</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jura</surname><given-names>SV</given-names></name></person-group><article-title>Mesenterile retrattile e sclerosante</article-title><source>Policlinica (Sez Prat)</source><year>1924</year><volume>31</volume><fpage>575</fpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Daskalogiannaki</surname><given-names>M</given-names></name><name><surname>Voloudaki</surname><given-names>A</given-names></name><name><surname>Prassopoulos</surname><given-names>P</given-names></name><name><surname>Magkanas</surname><given-names>E</given-names></name><name><surname>Stefanaki</surname><given-names>K</given-names></name><name><surname>Apostolaki</surname><given-names>E</given-names></name><name><surname>Gourtsoyiannis</surname><given-names>N</given-names></name></person-group><article-title>CT evaluation of mesenteric panniculitis: prevalence and associated diseases</article-title><source>AJR Am J Roentgenol</source><year>2000</year><volume>174</volume><fpage>427</fpage><lpage>431</lpage><pub-id pub-id-type="pmid">10658720</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Popkharitov</surname><given-names>AI</given-names></name><name><surname>Chomov</surname><given-names>GN</given-names></name></person-group><article-title>Mesenteric panniculitis of the sigmoid colon: a case report and review of the literature</article-title><source>J Med Case Reports</source><year>2007</year><volume>1</volume><fpage>108</fpage><pub-id pub-id-type="pmid">17910751</pub-id><pub-id pub-id-type="doi">10.1186/1752-1947-1-108</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goh</surname><given-names>J</given-names></name><name><surname>Otridge</surname><given-names>B</given-names></name><name><surname>Brady</surname><given-names>H</given-names></name><name><surname>Breatnach</surname><given-names>E</given-names></name><name><surname>Dervan</surname><given-names>P</given-names></name><name><surname>MacMathuna</surname><given-names>P</given-names></name></person-group><article-title>Aggressive multiple myeloma presenting as mesenteric panniculitis</article-title><source>Am J Gastroenterol</source><year>2001</year><volume>96</volume><fpage>238</fpage><lpage>241</lpage><pub-id pub-id-type="pmid">11197260</pub-id><pub-id pub-id-type="doi">10.1111/j.1572-0241.2001.03384.x</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Valls</surname><given-names>C</given-names></name></person-group><article-title>Fat-ring sign in sclerosing mesenteritis</article-title><source>AJR Am J Roentgenol</source><year>2000</year><volume>174</volume><fpage>259</fpage><lpage>260</lpage><pub-id pub-id-type="pmid">10628492</pub-id></citation></ref></ref-list></back></article>