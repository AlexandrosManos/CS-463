e><name><surname>Acu</surname><given-names>B</given-names></name></person-group><article-title>Cervical partial hydatidiform molar pregnancy</article-title><source>Gynecol Obstet Invest.</source><year>2008</year><volume>66</volume><issue>2</issue><fpage>142</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">18583920</pub-id></element-citation></ref><ref id="CIT0006"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chauhan</surname><given-names>MB</given-names></name><name><surname>Chaudhary</surname><given-names>P</given-names></name><name><surname>Dahiya</surname><given-names>P</given-names></name><name><surname>Sangwan</surname><given-names>K</given-names></name><name><surname>Sen</surname><given-names>J</given-names></name></person-group><article-title>Molar cornual ectopic pregnancy</article-title><source>Acta Obstet Gynecol Scand.</source><year>2006</year><volume>85</volume><issue>5</issue><fpage>625</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">16752246</pub-id></element-citation></ref><ref id="CIT0007"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Zite</surname><given-names>NB</given-names></name><name><surname>Lipscomb</surname><given-names>GH</given-names></name><name><surname>Merrill</surname><given-names>K</given-names></name></person-group><article-title>Molar cornual ectopic pregnancy</article-title><source>Obstet Gynecol.</source><year>2002</year><volume>99</volume><issue>5 Pt 2</issue><fpage>891</fpage><lpage>2</lpage><pub-id pub-id-type="pmid">11975948</pub-id></element-citation></ref><ref id="CIT0008"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Church</surname><given-names>E</given-names></name><name><surname>Hanna</surname><given-names>L</given-names></name><name><surname>New</surname><given-names>F</given-names></name><name><surname>Uku</surname><given-names>A</given-names></name><name><surname>Awad</surname><given-names>H</given-names></name><name><surname>Watson</surname><given-names>AJ</given-names></name></person-group><article-title>Ovarian molar pregnancy</article-title><source>J Obstet Gynaecol.</source><year>2008</year><volume>28</volume><issue>6</issue><fpage>660</fpage><lpage>1</lpage><pub-id pub-id-type="pmid">19003680</pub-id></element-citation></ref><ref id="CIT0009"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Leung</surname><given-names>F</given-names></name><name><surname>Terzibachian</surname><given-names>JJ</given-names></name><name><surname>Chung Fat</surname><given-names>B</given-names></name><name><surname>Lassabe</surname><given-names>C</given-names></name><name><surname>Knoepffler</surname><given-names>F</given-names></name><name><surname>Maillet</surname><given-names>R</given-names></name><etal/></person-group><article-title>[Heterotopic ovarian hydatidiform mole. A case report]</article-title><source>Gynecol Obstet Fertil.</source><year>2009</year><volume>37</volume><issue>9</issue><fpage>749</fpage><lpage>51</lpage><comment>French</comment><pub-id pub-id-type="pmid">19682939</pub-id></element-citation></ref><ref id="CIT0010"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Snyman</surname><given-names>LC</given-names></name></person-group><article-title>Case report of an intra-uterine pregnancy complicated by an ectopic invasive molar pregnancy</article-title><source>Southern Afr J Gynae Oncol.</source><year>2009</year><volume>1</volume><issue>2</issue><fpage>69</fpage><lpage>70</lpage></element-citation></ref><ref id="CIT0011"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rotas</surname><given-names>M</given-names></name><name><surname>Khulpateea</surname><given-names>N</given-names></name><name><surname>Binder</surname><given-names>D</given-names></name></person-group><article-title>Gestational choriocarcinoma arising from a cornual ectopic pregnancy: a case report and review of the literature</article-title><source>Arch Gynecol Obstet.</source><year>2007</year><volume>276</volume><issue>6</issue><fpage>645</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">17581760</pub-id></element-citation></ref><ref id="CIT0012"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bakri</surname><given-names>YN</given-names></name><name><surname>Amri</surname><given-names>A</given-names></name><name><surname>Mulla</surname><given-names>J</given-names></name></person-group><article-title>Gestational choriocarcinoma in a tubal ectopic pregnancy</article-title><source>Acta Obstet Gynecol Scand.</source><year>1992</year><volume>71</volume><issue>1</issue><fpage>67</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">1315103</pub-id></element-citation></ref><ref id="CIT0013"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kagel</surname><given-names>T</given-names></name><name><surname>Lemburg</surname><given-names>SP</given-names></name><name><surname>M&#x000fc;ller</surname><given-names>KM</given-names></name><name><surname>Laczkovics</surname><given-names>A</given-names></name><name><surname>Nicolas</surname><given-names>V</given-names></name><name><surname>Heyer</surname><given-names>CM</given-names></name></person-group><article-title>[Mediastinal metastasis of a tubal choriocarcinoma following ectopic pregnancy as a rare cause of thoracic pain]</article-title><source>Zentralbl Gynakol.</source><year>2006</year><volume>128</volume><issue>2</issue><fpage>90</fpage><lpage>4</lpage><comment>German</comment><pub-id pub-id-type="pmid">16673252</pub-id></element-citation></ref><ref id="CIT0014"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Fowler</surname><given-names>DJ</given-names></name><name><surname>Lindsay</surname><given-names>I</given-names></name><name><surname>Seckl</surname><given-names>MJ</given-names></name><name><surname>Sebire</surname><given-names>NJ</given-names></name></person-group><article-title>Routine pre-evacuation ultrasound diagnosis of hydatidiform mole: experience of more than 1000 cases from a regional referral center</article-title><source>Ultrasound Obstet Gynecol.</source><year>2006</year><volume>27</volume><issue>1</issue><fpage>56</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">16273594</pub-id></element-citation></ref><ref id="CIT0015"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Burton</surname><given-names>JL</given-names></name><name><surname>Lidbury</surname><given-names>EA</given-names></name><name><surname>Gillespie</surname><given-names>AM</given-names></name><name><surname>Tidy</surname><given-names>JA</given-names></name><name><surname>Smith</surname><given-names>O</given-names></name><name><surname>Lawry</surname><given-names>J</given-names></name><etal/></person-group><article-title>Over-diagnosis of hydatidiform mole in early tubal ectopic pregnancy</article-title><source>Histopathology.</source><year>2001</year><volume>38</volume><issue>5</issue><fpage>409</fpage><lpage>17</lpage><pub-id pub-id-type="pmid">11422477</pub-id></element-citation></ref></ref-list></back></article>