person-group-type="author"><name><surname>Nordenskj&#x000f6;ld</surname><given-names>B</given-names></name><name><surname>Rosell</surname><given-names>J</given-names></name><name><surname>Rutqvist</surname><given-names>LE</given-names></name><name><surname>Malmstr&#x000f6;m</surname><given-names>PO</given-names></name><name><surname>Bergh</surname><given-names>J</given-names></name><name><surname>Bengtsson</surname><given-names>NO</given-names></name><name><surname>Hatschek</surname><given-names>T</given-names></name><name><surname>Wallgren</surname><given-names>A</given-names></name><name><surname>Carstensen</surname><given-names>J</given-names></name></person-group><article-title>Coronary heart disease mortality after 5 years of adjuvant tamoxifen therapy: results from a randomized trial</article-title><source>J Natl Cancer Inst</source><year>2005</year><volume>7</volume><fpage>1609</fpage><lpage>1610</lpage></citation></ref><ref id="B4"><citation citation-type="book"><source>Good Clinical Practice Handbook: Guidance for Implementation</source><publisher-name>World Health Organization</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.nccn.org/professionals/physician_gls/PDF/breast.pdf"/></citation></ref><ref id="B5"><citation citation-type="other"><article-title>PDQ<sup>&#x000ae;</sup></article-title><ext-link ext-link-type="uri" xlink:href="http://www.cancer.gov/cancertopics/pdq"/></citation></ref><ref id="B6"><citation citation-type="other"><article-title>Ontario Institute for Cancer Research</article-title><ext-link ext-link-type="uri" xlink:href="http://www.oicr.on.ca/"/></citation></ref><ref id="B7"><citation citation-type="other"><article-title>Ontario Cancer Research Ethics Board</article-title><ext-link ext-link-type="uri" xlink:href="http://www.oicr.on.ca/ocreb/about.htm"/></citation></ref></ref-list></back></article>