"pmid">16175681</pub-id><pub-id pub-id-type="doi">10.1016/S0029-7844(01)01747-1</pub-id></citation></ref><ref id="B9"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Rothman</surname><given-names>KJ</given-names></name><name><surname>Greenland</surname><given-names>S</given-names></name><name><surname>Lash</surname><given-names>TL</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Rothman KJ, Greenland S, Lash TL</surname></name></person-group><article-title>Case-control studies</article-title><source>Modern Epidemiology</source><year>2008</year><edition>3</edition><publisher-name>Philadelphia: Lippincott, Williams &#x00026; Wilkins</publisher-name><fpage>111</fpage><lpage>127</lpage></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barlow</surname><given-names>WE</given-names></name><name><surname>Ichikawa</surname><given-names>L</given-names></name><name><surname>Rosner</surname><given-names>D</given-names></name><name><surname>Izumi</surname><given-names>S</given-names></name></person-group><article-title>Analysis of case-cohort designs</article-title><source>J Clin Epidemiol</source><year>1999</year><volume>52</volume><fpage>1165</fpage><lpage>1172</lpage><pub-id pub-id-type="pmid">10580779</pub-id><pub-id pub-id-type="doi">10.1016/S0895-4356(99)00102-X</pub-id></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hosmer</surname><given-names>DW</given-names></name><name><surname>Lemeshow</surname><given-names>S</given-names></name></person-group><source>Applied logistic regression</source><year>2000</year><edition>2</edition><publisher-name>New York: John Wiley &#x00026; Sons</publisher-name><pub-id pub-id-type="pmid">10886529</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surna