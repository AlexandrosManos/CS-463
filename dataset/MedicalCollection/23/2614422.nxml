e="author"><name><surname>Israel</surname><given-names>B</given-names></name><name><surname>Schultz</surname><given-names>A</given-names></name><name><surname>Parker</surname><given-names>E</given-names></name><name><surname>Becker</surname><given-names>A</given-names></name><name><surname>Allen</surname><given-names>A</given-names></name><name><surname>Guzman</surname><given-names>J</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Minkler M, Wallerstein N. San</surname></name></person-group><article-title>Critical Issues in Developing and Following Community Based Participatory Research Principles</article-title><source>Community-Based Participatory Research for Health</source><year>2003</year><publisher-name>Francisco: Jossey-Bass</publisher-name><fpage>53</fpage><lpage>76</lpage></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Macaulay</surname><given-names>A</given-names></name><name><surname>Paradis</surname><given-names>G</given-names></name><name><surname>Potvin</surname><given-names>L</given-names></name><name><surname>Cross</surname><given-names>E</given-names></name><name><surname>Saad-Haddad</surname><given-names>C</given-names></name><name><surname>McComber</surname><given-names>A</given-names></name><name><surname>Desrosiers</surname><given-names>S</given-names></name><name><surname>Kirby</surname><given-names>R</given-names></name><name><surname>Montour</surname><given-names>L</given-names></name><name><surname>Lamping</surname><given-names>D</given-names></name><etal></etal></person-group><article-title>The Kahnawake Schools Diabetes Prevention Project: Intervention, evaluation, and baseline results of a diabetes primary prevention program with a native community in Canada</article-title><source>Prev Med</source><year>1997</year><volume>26</volume><fpage>779</fpage><lpage>790</lpage><pub-id pub-id-type="pmid">9388789</pub-id><pub-id pub-id