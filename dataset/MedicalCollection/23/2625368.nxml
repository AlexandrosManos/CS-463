b-id></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="journal"><name><surname>Tenhumberg</surname><given-names>B</given-names></name><name><surname>Keller</surname><given-names>MA</given-names></name><name><surname>Possingham</surname><given-names>HP</given-names></name><name><surname>Tyre</surname><given-names>AJ</given-names></name><article-title>Optimal patch leaving behaviour: a case of study using the parasitoid <italic>Cotesia rubecula</italic></article-title><source>Journal of Animal Ecology</source><year>2001</year><volume>70</volume><fpage>683</fpage><lpage>691</lpage><pub-id pub-id-type="doi">10.1046/j.1365-2656.2001.00530.x</pub-id></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="journal"><name><surname>Alphen van</surname><given-names>JJM</given-names></name><name><surname>Bernstein</surname><given-names>C</given-names></name><name><surname>Driessen</surname><given-names>G</given-names></name><article-title>Information acquisition and time allocation in insect parasitoids</article-title><source>Trends in Ecology and Evolution</source><year>2003</year><volume>18</volume><fpage>81</fpage><lpage>87</lpage><pub-id pub-id-type="doi">10.1016/S0169-5347(02)00035-6</pub-id></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="journal"><name><surname>Wang</surname><given-names>XG</given-names></name><name><surname>Keller</surname><given-names>MA</given-names></name><article-title>Patch time allocation by the parasitoid <italic>Diadegma semiclausum </italic>(Hymenoptera : Ichneumonidae). II. Effects of host density and distribution</article-title><source>Journal of Insect Behavior</source><year>2005</year><volume>18</volume><fpage>171</fpage><lpage>186</lpage><pub-id pub-id-type="doi">10.1007/s10905-005-0473-z</pub-id></mixed-citation></ref><ref id="B19"><mixed-citation publication-type="journal"><name><surname>Outreman</surname><given-names>Y</given-names></name><name><surname>Le Ralec</surname><given-names>A</given-names></name><name><surname>Wajnberg</surname><given-names>E</given-names></name><name><surname>Pierre</surname><given-names>JS</given-names></name><article-title>Effects of within- and among-patch experiences on the patch-leaving decision rules in an insect parasitoid</article-title><source>Behavioral Ecology and Sociobiology</source><year>2005</year><volume>58</volume><fpage>208</fpage><lpage>217</lpage><pub-id pub-id-type="doi">10.1007/s00265-004-0895-1</pub-id></mixed-citation></ref><ref id="B20"><mixed-citation publication-type="journal"><name><surname>Wajnberg</surname><given-names>E</given-names></name><name><surname>Bernhard</surname><given-names>P</given-names></name><name><surname>Hamelin</surname><given-names>F</given-names></name><name><surname>Boivin</surname><given-names>G</given-names></name><article-title>Optimal patch time allocation for time-limited foragers</article-title><source>Behavioural Ecology and Sociobiology</source><year>2006</year><volume>60</volume><fpage>1</fpage><lpage>10</lpage><pub-id pub-id-type="doi">10.1007/s00265-005-0131-7</pub-id></mixed-citation></ref><ref id="B21"><mixed-citation publication-type="journal"><name><surname>Vinson</surname><given-names>SB</given-names></name><article-title>Host selection by insect parasitoids</article-title><source>Annual Review of Entomology</source><year>1976</year><volume>21</volume><fpage>109</fpage><lpage>128</lpage><pub-id pub-id-type="doi">10.1146/annurev.en.21.010176.000545</pub-id></mixed-citation></ref><ref id="B22"><mixed-citation publication-type="journal"><name><surname>Lewis</surname><given-names>WJ</given-names></name><name><surname>Jones</surname><given-names>RL</given-names></name><article-title>Substance that stimulates host-seeking by <italic>Microplitis croceipes </italic>(Hymenoptera : Braconidae), a parasite of <italic>Heliothis species</italic></article-title><source>Annals of the Entomological Society of America</source><year>1971</year><volume>64</volume><fpage>471</fpage><lpage>473</lpage></mixed-citation></ref><ref id="B23"><mixed-citation publication-type="journal"><name><surname>Bouchard</surname><given-names>Y</given-names></name><name><surname>Cloutier</surname><given-names>C</given-names></name><article-title>Honeydew as a source of host-searching kairomones for the aphid parasitoid <italic>Aphidius nigripes </italic>(Hymenoptera : Aphidiidae)</article-title><source>Canadian Journal of Zoology</source><year>1984</year><volume>62</volume><fpage>1513</fpage><lpage>1520</lpage></mixed-citation></ref><ref id="B24"><mixed-citation publication-type="journal"><name><surname>Ayal</surname><given-names>Y</given-names></name><article-title>The foraging strategy of <italic>Diaeretiella rapae</italic>. I. The concept of the elementary unit</article-title><source>Journal of Animal Ecology</source><year>1987</year><volume>56</volume><fpage>1057</fpage><lpage>1068</lpage><pub-id pub-id-type="doi">10.2307/4966</pub-id></mixed-citation></ref><ref id="B25"><mixed-citation publication-type="journal"><name><surname>Budenberg</surname><given-names>WJ</given-names></name><article-title>Honeydew as a contact kairomone for aphid parasitoids</article-title><source>Entomologia Experimentalis et Applicata</source><year>1990</year><volume>55</volume><fpage>139</fpage><lpage>147</lpage><pub-id pub-id-type="doi">10.1007/BF00352575</pub-id></mixed-citation></ref><ref id="B26"><mixed-citation publication-type="journal"><name><surname>NgiSong</surname><given-names>AJ</given-names></name><name><surname>Overholt</surname><given-names>WA</given-names></name><article-title>Host location and acceptance by <italic>Cotesia flavipes </italic>Cameron and <italic>C. sesamiae </italic>Cameron (Hymenoptera: Braconidae), parasitoids of African gramineous stemborers: Role of frass and other host cues</article-title><source>Biological Control</source><year>1997</year><volume>9</volume><fpage>136</fpage><lpage>142</lpage><pub-id pub-id-type="doi">10.1006/bco