l research</article-title><source>Prog Neuropsychopharmacol</source><year>1979</year><volume>3</volume><fpage>287</fpage><lpage>91</lpage><pub-id pub-id-type="pmid">400986</pub-id><pub-id pub-id-type="doi">10.1016/0364-7722(79)90093-6</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cole</surname><given-names>JO</given-names></name></person-group><article-title>Research barriers in psychopharmacology</article-title><source>Am J Psychiatry</source><year>1977</year><volume>134</volume><fpage>896</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">879353</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stahl</surname><given-names>SM</given-names></name></person-group><article-title>Needs and opportunities for innovation in psychopharmacology</article-title><source>J R Soc Med</source><year>1987</year><volume>80</volume><fpage>413</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">3656311</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Young</surname><given-names>SN</given-names></name></person-group><article-title>Risk in research&#x02013;from the Nuremberg Code to the tri-council code: implications for clinical trials of psychotropic drugs</article-title><source>J Psychiatry Neurosci</source><year>1998</year><volume>23</volume><fpage>149</fpage><lpage>55</lpage><pub-id pub-id-type="pmid">9595888</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Charlton</surname><given-names>BG</given-names></name></person-group><article-title>Psychopharmacology and the human condition</article-title><source>J R Soc Med</source><year>1998</year><volume>91</volume><fpage>599</fpage><lpage>601</lpage><pub-id pub-id-type="pmid">10325883</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Young</surname><given-names>SN</given-names></name></person-group><article-title>Why psychopharmacological researchers need to become more vocal and thoughtful in debating issues in research ethics</article-title><source>J Psychiatry Neurosci</source><year>1998</year><volume>23</volume><fpage>147</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">9595887</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leon</surname><given-names>CA</given-names></name></person-group><article-title>Ethical aspects of psychopharmacology</article-title><source>Prog Neuropsychopharmacol</source><year>1979</year><volume>3</volume><fpage>297</fpage><lpage>301</lpage><pub-id pub-id-type="pmid">400988</pub-id><pub-id pub-id-type="doi">10.1016/0364-7722(79)90095-X</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Muller-Oerlinghausen</surname><given-names>B</given-names></name></person-group><article-title>Ethical problems in clinical psychopharmacology</article-title><source>Int J Clin Pharmacol Biopharm</source><year>1978</year><volume>16</volume><fpage>443</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">700905</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Alexander</surname><given-names>L</given-names></name></person-group><article-title>New dimensions in legal and ethical concepts for human research. 2. Special problems of medical disciplines. Psychiatry: methods and processes for investigation of drugs</article-title><source>Ann N Y Acad Sci</source><year>1970</year><volume>169</volume><fpage>344</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">4907478</pub-id><pub-id pub-id-type="doi">10.1111/j.1749-6632.1970.tb54741.x</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Katz</surname><given-names>MM</given-names></name></person-group><article-title>Ethical issues in the use of human subjects in psychopharmacologic research</article-title><source>Am Psychol</source><year>1967</year><volume>22</volume><fpage>360</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">6041094</pub-id><pub-id pub-id-type="doi">10.1037/h0024884</pub-id></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kanigel</surname><given-names>R</given-names></name></person-group><source>Apprentice to genius: The making of a scientific dynasty</source><year>1986</year><publisher-name>New York: Macmillan;</publisher-name></citation></ref><ref id="B25"><citation citation-type="other"><person-group person-group-type="author"><collab>Office of Human Subjects Research</collab></person-group><article-title>Guidelines for the Conduct of Research Involving Human Subjects at the National Institutes of Health</article-title><year>1986</year><ext-link ext-link-type="uri" xlink:href="http://www.nihtraining.com/ohsrsite/guidelines/GrayBooklet82404.pdf"/></citation></ref></ref-list></back></article>