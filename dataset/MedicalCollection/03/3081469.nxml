</person-group><article-title>Psoriasiform drug eruption associated with metformin hydrochloride: A case report</article-title><source>Dermatol Online J</source><year>2003</year><volume>9</volume><fpage>11</fpage><pub-id pub-id-type="pmid">12952758</pub-id></element-citation></ref><ref id="ref9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ben Salem</surname><given-names>C</given-names></name><name><surname>Hmouda</surname><given-names>H</given-names></name><name><surname>Slim</surname><given-names>R</given-names></name><name><surname>Denguezli</surname><given-names>M</given-names></name><name><surname>Belajouza</surname><given-names>C</given-names></name><name><surname>Bouraoui</surname><given-names>K</given-names></name></person-group><article-title>Rare case of metformin-induced leukocytoclastic vasculitis</article-title><source>Ann Pharmacother</source><year>2006</year><volume>40</volume><fpage>1685</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">16882868</pub-id></element-citation></ref><ref id="ref10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lamey</surname><given-names>PJ</given-names></name><name><surname>Gibson</surname><given-names>J</given-names></name><name><surname>Barclay</surname><given-names>SC</given-names></name><name><surname>Miller</surname><given-names>S</given-names></name></person-group><article-title>Grinspan's syndrome: A drug-induced phenomenon?</article-title><source>Oral Surg Oral Med Oral Pathol</source><year>1990</year><volume>70</volume><fpage>184</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">2290647</pub-id></element-citation></ref><ref id="ref11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Shore</surname><given-names>SA</given-names></name><name><surname>Williams</surname><given-names>ES</given-names></name><name><surname>Zhu</surname><given-names>M</given-names></name></person-group><article-title>No effect of metformin on the innate airway hyperresponsiveness and increased responses to ozone observed in obese mice</article-title><source>J Appl Physiol</source><year>2008</year><volume>105</volume><fpage>1127</fpage><lpage>33</lpage><pub-id pub-id-type="pmid">18703763</pub-id></element-citation></ref></ref-list></back></article>