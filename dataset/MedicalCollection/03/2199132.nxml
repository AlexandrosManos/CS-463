>Activating and inhibitory mutations in adjacent tyrosines in the kinase domain of ZAP-70</article-title><source>J Biol Chem</source><year>1995</year><volume>270</volume><fpage>18730</fpage><lpage>18733</lpage><pub-id pub-id-type="pmid">7642520</pub-id></citation></ref><ref id="B9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kong</surname><given-names>G</given-names></name><name><surname>Dalton</surname><given-names>M</given-names></name><name><surname>Wardenburg</surname><given-names>JB</given-names></name><name><surname>Straus</surname><given-names>D</given-names></name><name><surname>Kurosaki</surname><given-names>T</given-names></name><name><surname>Chan</surname><given-names>AC</given-names></name></person-group><article-title>Distinct tyrosine phosphorylation sites within ZAP-70 mediate activation and negative regulation of antigen receptor function</article-title><source>Mol Cell Biol</source><year>1996</year><volume>16</volume><fpage>5026</fpage><lpage>5035</lpage><pub-id pub-id-type="pmid">8756661</pub-id></citation></ref><ref id="B10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Peri</surname><given-names>KG</given-names></name><name><surname>Veillette</surname><given-names>A</given-names></name></person-group><article-title>Tyrosine protein kinases in T lymphocytes</article-title><source>Chem Immunol</source><year>1994</year><volume>59</volume><fpage>19</fpage><lpage>39</lpage><pub-id pub-id-type="pmid">7945927</pub-id></citation></ref><ref id="B11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Park</surname><given-names>DJ</given-names></name><name><surname>Rho</surname><given-names>HW</given-names></name><name><surname>Rhee</surname><given-names>SG</given-names></name></person-group><article-title>CD3 stimulation causes phosphorylation of phospholipase C-&#x003b3;1 on serine and tyrosine residues in a human T cell line</article-title><source>Proc Natl Acad  Sci USA</source><year>1991</year><volume>88</volume><fpage>5453</fpage><lpage>5456</lpage><pub-id pub-id-type="pmid">1828897</pub-id></citation></ref><ref id="B12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weiss</surname><given-names>A</given-names></name><name><surname>Koretzky</surname><given-names>G</given-names></name><name><surname>Schatzman</surname><given-names>RC</given-names></name><name><surname>Kadlecek</surname><given-names>T</given-names></name></person-group><article-title>Functional activation of the T-cell antigen receptor induces tyrosine phosphorylation of phospholipase C-&#x003b3;1</article-title><source>Proc  Natl Acad Sci USA</source><year>1991</year><volume>88</volume><fpage>5484</fpage><lpage>5488</lpage><pub-id pub-id-type="pmid">1712101</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bustelo</surname><given-names>XR</given-names></name><name><surname>Ledbetter</surname><given-names>JA</given-names></name><name><surname>Barbacid</surname><given-names>M</given-names></name></person-group><article-title>Product of vav proto-oncogene defines a new class of tyrosine protein kinase substrates</article-title><source>Nature (Lond)</source><year>1992</year><volume>356</volume><fpage>68</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">1311423</pub-id></citation></ref><ref id="B14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Donovan</surname><given-names>JA</given-names></name><name><surname>Wange</surname><given-names>RL</given-names></name><name><surname>Langdon</surname><given-names>WY</given-names></name><name><surname>Samelson</surname><given-names>LE</given-names></name></person-group><article-title>The protein product of the c-cbl prot