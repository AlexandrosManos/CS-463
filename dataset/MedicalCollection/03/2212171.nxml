></ref><ref id="B24"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kelsoe</surname><given-names>G</given-names></name></person-group><article-title>Life and death in germinal centers (redux)</article-title><source>Immunity</source><year>1996</year><volume>4</volume><fpage>107</fpage><lpage>111</lpage><pub-id pub-id-type="pmid">8624801</pub-id></citation></ref><ref id="B25"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rajewsky</surname><given-names>K</given-names></name></person-group><article-title>Clonal selection and learning in the antibody system</article-title><source>Nature</source><year>1996</year><volume>381</volume><fpage>751</fpage><lpage>758</lpage><pub-id pub-id-type="pmid">8657279</pub-id></citation></ref></ref-list><fn-group><fn><p>This work was supported by a grant-in-aid from The Ministry of Education, Science and Culture of Japan  and the grant from Nagase Science and Technology Foundation.</p></fn><fn><p>Address correspondence to Hitoshi Ohmori, Department of Biotechnology, Faculty of Engineering,  Okayama University, Tsushima-Naka, Okayama 700, Japan. Phone: 81-86-251-8197; Fax: 81-86-251-8197; E-mail: <email>hit2224&#x00040;biotech.okayama-u.ac.jp</email></p></fn></fn-group></back></article>