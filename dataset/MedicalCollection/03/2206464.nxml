me>London, UK: Royal College of Physicians</publisher-name></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Menon</surname><given-names>V</given-names></name><name><surname>Harrington</surname><given-names>RA</given-names></name><name><surname>Hochman</surname><given-names>JS</given-names></name><name><surname>Cannon</surname><given-names>CP</given-names></name><name><surname>Goodman</surname><given-names>SD</given-names></name><name><surname>Wilcox</surname><given-names>RG</given-names></name><name><surname>Schunemann</surname><given-names>HJ</given-names></name><name><surname>Ohman</surname><given-names>EM</given-names></name></person-group><article-title>Thrombolysis and adjunctive therapy in acute myocardial infarction: The Seventh ACCP Conference on Antithrombotic and Thrombolytic Therapy</article-title><source>Chest</source><year>2004</year><volume>126</volume><issue>3 Suppl</issue><fpage>549S</fpage><lpage>575S</lpage><pub-id pub-id-type="pmid">15383484</pub-id><pub-id pub-id-type="doi">10.1378/chest.126.3_suppl.549S</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><collab>The National Institute of Neurological Disorders and Stroke rt-PA study group</collab></person-group><article-title>Tissue plasminogen activator for acute stroke</article-title><source>N Engl J Med</source><year>1995</year><volume>333</volume><fpage>1581</fpage><lpage>1587</lpage><pub-id pub-id-type="pmid">7477192</pub-id><pub-id pub-id-type="doi">10.1056/NEJM199512143332401</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hacke</surname><given-names>W</given-names></name><name><surname>Donnan</surname><given-names>G</given-names></name><name><surname>Fieschi</surname><given-names>C</given-names></name><name><surname>Kaste</surname><given-names>M</given-names></name><name><surname>von Kummer</surname><given-names>R</given-names></name><name><surname>Broder-ick</surname><given-names>JP</given-names></name><name><surname>Brott</surname><given-names>T</given-names></name><name><surname>Frankel</surname><given-names>M</given-names></name><name><surname>Grotta</surname><given-names>JC</given-names></name><name><surname>Haley</surname><given-names>EC</given-names><suffix>Jr</suffix></name><etal></etal></person-group><article-title>Association of outcome with early stroke treatment: Pooled analysis of ATLANTIS, ECASS, and NINDS rt-PA stroke trials</article-title><source>Lancet</source><year>2004</year><volume>363</volume><fpage>768</fpage><lpage>744</lpage><pub-id pub-id-type="pmid">15016487</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(04)15692-4</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><collab>Stroke Unit Trialist' Collaboration</collab></person-group><article-title>Organised inpatient (stroke unit) care for stroke (Cochrane Review)</article-title><source>Cochrane Database Syst Rev</source><year>2002</year><volume>1</volume><fpage>CD000197</fpage><pub-id pub-id-type="pmid">11869570</pub-id></citation></ref></ref-list></back></article>