mes>VL</given-names></name><name><surname>Stewart</surname><given-names>TA</given-names></name><name><surname>Braciale</surname><given-names>TJ</given-names></name></person-group><article-title>Response to influenza infection in mice with a targeted disruption in the interferon &#x003b3; gene</article-title><source>J Exp Med</source><year>1993</year><volume>178</volume><fpage>1725</fpage><lpage>1732</lpage><pub-id pub-id-type="pmid">8228818</pub-id></citation></ref><ref id="B12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lukacher</surname><given-names>AE</given-names></name><name><surname>Braciale</surname><given-names>VL</given-names></name><name><surname>Braciale</surname><given-names>TJ</given-names></name></person-group><article-title>In vivo effector function of influenza virus&#x02013;specific cytotoxic T lymphocyte clones is highly specific</article-title><source>J Exp Med</source><year>1984</year><volume>160</volume><fpage>814</fpage><lpage>826</lpage><pub-id pub-id-type="pmid">6206190</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ada</surname><given-names>GL</given-names></name><name><surname>Jones</surname><given-names>PD</given-names></name></person-group><article-title>The immune response to influenza infection. [Review]</article-title><source>Curr Top Microbiol Immunol</source><year>1986</year><volume>128</volume><fpage>1</fpage><lpage>54</lpage><pub-id pub-id-type="pmid">3533447</pub-id></citation></ref><ref id="B14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Murphy</surname><given-names>BR</given-names></name><name><surname>Clements</surname><given-names>ML</given-names></name></person-group><article-title>The systemic and mucosal immune response of humans to influenza A virus. [Review]</article-title><source>Curr Top Microbiol Immunol</source><year>1989</year><volume>146</volume><fpage>107</fpage><lpage>116</lpage><pub-id pub-id-type="pmid">2659262</pub-id></citation></ref><ref id="B15"><label>15</label><citation citation-type="other">Yewdell, J.W., and C.J. Hackett. 1989. Specificity and function of T lymphocytes induced by influenza A viruses. <italic>In</italic> The  Influenza Viruses. R.M. Krug, editor. Plenum Press, New  York. pp. 361&#x02013;434.</citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brundler</surname><given-names>MA</given-names></name><name><surname>Aichele</surname><given-names>P</given-names></name><name><surname>Bachmann</surname><given-names>M</given-names></name><name><surname>Kitamura</surname><given-names>D</given-names></name><name><surname>Rajewsky</surname><given-names>K</given-names></name><name><surname>Zinkernagel</surname><given-names>RM</given-names></name></person-group><article-title>Immunity to viruses in B cell&#x02013;deficient mice: influence of antibodies on virus persistence and on T cell memory</article-title><source>Eur J Immunol</source><year>1996</year><volume>26</volume><fpage>2257</fpage><lpage>2262</lpage><pub-id pub-id-type="pmid">8814275</pub-id></citation></ref><ref id="B17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kitamura</surname><given-names>D</given-names></name><name><surname>Rajewsky</surname><given-names>K</given-names></name></person-group><article-title>Targeted disruption of mu chain membrane exon causes loss of heavy-chain allelic exclusion [see comments]</article-title><source>Nature</source><year>1992</year><volume>356</volume><fpage>154</fpage><lpage>156</lpage><pub-id pub-id-type="pmid">1545868</pub-id></citation></ref><ref id="B18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Epstein</surname><given-names>MM</given-names></name><name><surname>Di Rosa</surname><given-names>F</given-names></name><name><surname>Jankovic</surname><given-names>D</given-names></name><name><surname>Sher</surname><given-names>A</given-names></name><name><surname>Matzinger</surname><given-names>P</given-names></name></person-group><article-title>Successful T cell priming in B cell&#x02013;deficient mice</article-title><source>J Exp Med</source><year>1995</year><volume>182</volume><fpage>915</fpage><lpage>922</lpage><pub-id pub-id-type="pmid">7561694</pub-id></citation></ref><ref id="B19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Topham</surname><given-names>DJ</given-names></name><name><surname>Tripp</surname><given-names>RA</given-names></name><name><surname>Hamilton-Easton</surname><given-names>AM</given-names></name><name><surname>Sarawar</surname><given-names>SR</given-names></name><name><surname>Doherty</surname><given-names>PC</given-names></name></person-group><article-title>Quantitative analysis of the  influenza virus-specific CD4<sup>&#x0002b;</sup>T cell memory in the absence of B cells and Ig</article-title><source>J Immunol</source><year>1996</year><volume>157</volume><fpage>2947</fpage><lpage>2952</lpage><pub-id pub-id-type="pmid">8816401</pub-id></citation></ref><ref id="B20"><label>20</label><citation citation-type="other">Murphy, B.R., and R.B. Webster. 1996. Orthomyxoviruses.  Third ed. <italic>In</italic> Fields Virology, B.N. Fields, D.M. Knipe, and  P.M. Howley, editors. Lippincott - Raven, Philadelphia. pp.  1397&#x02013;1445.</citation></ref><ref id="B21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Askonas</surname><given-names>BA</given-names></name></person-group><article-title>Our immune defence against influenza</article-title><source>Biochem Soc Trans</source><year>1980</year><volume>8</volume><fpage>257</fpage><lpage>260</lpage><pub-id pub-id-type="pmid">6967434</pub-id></citation></ref><ref id="B22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Asano</surname><given-names>MS</given-names></name><name><surname>Ahmed</surname><given-names>R</given-names></name></person-group><article-title>CD8 T cell memory in B cell&#x02013;deficient mice</article-title><source>J Exp Med</source><year>1996</year><volume>183</volume><fpage>2165</fpage><lpage>2174</lpage><pub-id pub-id-type="pmid">8642326</pub-id></citation></ref><ref id="B23"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Di</surname><given-names>RF</given-names></name><name><surname>Matzinger</surname><given-names>P</given-names></name></person-group><article-title>Long-lasting CD8 T cell memory in the absence of CD4 T cells or B cells</article-title><source>J Exp  Med</source><year>1996</year><volume>183</volume><fpage>2153</fpage><lpage>2163</lpage><pub-id pub-id-type="pmid">8642325</pub-id></citation></ref><ref id="B24"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Scherle</surname><given-names>PA</given-names></name><name><surname>Palladino</surname><given-names>G</given-names></name><name><surname>Gerhard</surname><given-names>W</given-names></name></person-group><article-title>Mice can recover from pulmonary influenza virus infection in the absence of class I&#x02013;restricted cytotoxic T cells</article-title><source>J Immunol</source><year>1992</year><volume>148</volume><fpage>212</fpage><lpage>217</lpage><pub-id pub-id-type="pmid">1530795</pub-id></citation></ref><ref id="B25"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tripp</surname><given-names>RA</given-names></name><name><surname>Sarawar</surname><given-names>SR</given-names></name><name><surname>Doherty</surname><given-names>PC</given-names></name></person-group><article-title>Characteristics of the influenza virus-specific CD8<sup>&#x0002b;</sup>T cell response in mice homozygous for disruption of the H-2lAb gene</article-title><source>J  Immunol</source><year>1995</year><volume>155</volume><fpage>2955</fpage><lpage>2959</lpage><pub-id pub-id-type="pmid">7673713</pub-id></citation></ref></ref-list></back></article>