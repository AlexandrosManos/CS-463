><article-title>Materialism and well-being: a conflicting values perspective</article-title><source>JCR</source><year>2002</year><volume>29</volume><fpage>348</fpage><lpage>370</lpage></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nosse</surname><given-names>LJ</given-names></name><name><surname>Sagiv</surname><given-names>L</given-names></name></person-group><article-title>Theory-Based Study of the Basic Values of 565 Physical Therapists</article-title><source>Physical Therapy</source><year>2005</year><volume>85</volume><fpage>834</fpage><lpage>854</lpage><pub-id pub-id-type="pmid">16117595</pub-id></citation></ref></ref-list></back></article>