e><volume>36</volume><fpage>183</fpage><lpage>189</lpage><year>2004</year><pub-id pub-id-type="pmid">14704668</pub-id><pub-id pub-id-type="doi">10.1038/ng1288</pub-id><person-group><name><surname>Sen</surname><given-names>G</given-names></name><name><surname>Wehrman</surname><given-names>TS</given-names></name><name><surname>Myers</surname><given-names>JW</given-names></name><name><surname>Blau</surname><given-names>HM</given-names></name></person-group></citation></ref><ref id="r15"><citation citation-type="journal"><article-title>Enzymatic production of RNAi libraries from cDNAs.</article-title><source>Nat Genet</source><volume>36</volume><fpage>190</fpage><lpage>196</lpage><year>2004</year><pub-id pub-id-type="pmid">14704669</pub-id><pub-id pub-id-type="doi">10.1038/ng1290</pub-id><person-group><name><surname>Shirane</surname><given-names>D</given-names></name><name><surname>Sugao</surname><given-names>K</given-names></name><name><surname>Namiki</surname><given-names>S</given-names></name><name><surname>Tanabe</surname><given-names>M</given-names></name><name><surname>Iino</surname><given-names>M</given-names></name><name><surname>Hirose</surname><given-names>K</given-names></name></person-group></citation></ref><ref id="r16"><citation citation-type="journal"><article-title>Rational siRNA design for RNA interference.</article-title><source>Nat Biotechnol</source><volume>22</volume><fpage>326</fpage><lpage>330</lpage><year>2004</year><pub-id pub-id-type="pmid">14758366</pub-id><pub-id pub-id-type="doi">10.1038/nbt936</pub-id><person-group><name><surname>Reynolds</surname><given-names>A</given-names></name><name><surname>Leake</surname><given-names>D</given-names></name><name><surname>Boese</surname><given-names>Q</given-names></name><name><surname>Scaringe</surname><given-names>S</given-names></name><name><surname>Marshall</surname><given-names>WS</given-names></name><name><surname>Khvorova</surname><given-names>A</given-names></name></person-group></citation></ref><ref id="r17"><citation citation-type="journal"><article-title>Guidelines for the selection of highly effective siRNA sequences for mammalian and chick RNA interference.</article-title><source>Nucleic Acids Res</source><volume>32</volume><fpage>936</fpage><lpage>948</lpage><year>2004</year><pub-id pub-id-type="pmid">14769950</pub-id><pub-id pub-id-type="doi">10.1093/nar/gkh247</pub-id><person-group><name><surname>Ui-Tei</surname><given-names>K</given-names></name><name><surname>Naito</surname><given-names>Y</given-names></name><name><surname>Takahashi</surname><given-names>F</given-names></name><name><surname>Haraguchi</surname><given-names>T</given-names></name><name><surname>Ohki-Hamazaki</surname><given-names>H</given-names></name><name><surname>Juni</surname><given-names>A</given-names></name><name><surname>Ueda</surname><given-names>R</given-names></name><name><surname>Saigo</surname><given-names>K</given-names></name></person-group></citation></ref><ref id="r18"><citation citation-type="journal"><article-title>RNA interference in mammalian cells using siRNAs synthesized with T7 RNA polymerase.</article-title><source>Nucleic Acids Res</source><volume>30</volume><fpage>e46</fpage><year>2002</year><pub-id pub-id-type="pmid">12000851</pub-id><pub-id pub-id-type="doi">10.1093/nar/30.10.e46</pub-id><person-group><name><surname>Donze</surname><given-names>O</given-names></name><name><surname>Picard</surname><given-names>D</given-names></name></person-group></citation></ref><ref id="r19"><citation citation-type="journal"><article-title>A resource for large-scale RNA-interference-based screens in mammals.</article-title><source>Nature</source><volume>428</volume><fpage>427</fpage><lpage>431</lpage><year>2004</year><pub-id pub-id-type="pmid">15042091</pub-id><pub-id pub-id-type="doi">10.1038/nature02370</pub-id><person-group><name><surname>Paddison</surname><given-names>PJ</given-names></name><name><surname>Silva</surname><given-names>JM</given-names></name><name><sur