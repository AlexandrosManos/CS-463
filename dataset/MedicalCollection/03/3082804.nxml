<surname>Alper</surname><given-names>S</given-names></name><etal/></person-group><article-title>Gastrointestinal side effect profile due to the use of alendronate in the treatment of osteoporosis</article-title><source>Yonsei Med J</source><year>2003</year><volume>44</volume><issue>6</issue><fpage>961</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">14703602</pub-id></element-citation></ref><ref id="CIT6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Miller</surname><given-names>PD</given-names></name></person-group><article-title>Anti-resorptives in the management of osteoporosis</article-title><source>Best Pract Res Clin Endocrinol Metab</source><year>2008</year><volume>22</volume><issue>5</issue><fpage>849</fpage><lpage>68</lpage><pub-id pub-id-type="pmid">19028360</pub-id></element-citation></ref><ref id="CIT7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Miller</surname><given-names>PD</given-names></name><name><surname>Woodson</surname><given-names>G</given-names></name><name><surname>Licata</surname><given-names>AA</given-names></name><name><surname>Ettinger</surname><given-names>MP</given-names></name><name><surname>Mako</surname><given-names>B</given-names></name><name><surname>Smith</surname><given-names>ME</given-names></name><etal/></person-group><article-title>Rechallenge of patients who had discontinued alendronate therapy because of upper gastrointestinal symptoms</article-title><source>Clin Ther</source><year>2000</year><volume>22</volume><issue>12</issue><fpage>1433</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">11192135</pub-id></element-citation></ref><ref id="CIT8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jarvis</surname><given-names>CI</given-names></name><name><surname>Morin</surname><given-names>AK</given-names></name><name