k"><person-group person-group-type="author"><name><surname>Brockwell</surname><given-names>PJ</given-names></name><name><surname>Davis</surname><given-names>RA</given-names></name></person-group><source>Time Series. Theory and Methods</source><year>1991</year><edition>Second</edition><publisher-name>New York: Springer-Verlag</publisher-name></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Brockwell</surname><given-names>PJ</given-names></name><name><surname>Davis</surname><given-names>RA</given-names></name></person-group><source>Introduction to time series and forecasting</source><year>2002</year><edition>Second</edition><publisher-name>New York: Springer-Verlag</publisher-name></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Diggle</surname><given-names>P</given-names></name><name><surname>Rowlingson</surname><given-names>B</given-names></name><name><surname>Su</surname><given-names>T</given-names></name></person-group><article-title>Point process methodology for on-line spatio-temporal disease surveillance</article-title><source>Environmetrics</source><year>2005</year><volume>16</volume><fpage>423</fpage><lpage>434</lpage><pub-id pub-id-type="doi">10.1002/env.712</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fienberg</surname><given-names>S</given-names></name><name><surname>Shmueli</surname><given-names>G</given-names></name></person-group><article-title>Statistical Issues and Challenges Associated with Rapid Detection of Bio-terrorist Attacks</article-title><source>Statistics in Medicine</source><year>2005</year><volume>24</volume><fpage>513</fpage><lpage>529</lpage><pub-id pub-id-type="pmid">15678405</pub-id><pub-id pub-id-type="doi">10.1002/sim.2032</pub-id></citation></ref></ref-list></back></article>