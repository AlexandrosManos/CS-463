></name><name><surname>Feldman</surname><given-names>D</given-names></name></person-group><article-title>Inhibition of adrenal steroidogenesis by the anesthetic etomidate</article-title><source>N Engl J Med</source><year>1984</year><volume>310</volume><fpage>1415</fpage><lpage>1421</lpage><pub-id pub-id-type="pmid">6325910</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Watt</surname><given-names>I</given-names></name><name><surname>Ledingham</surname><given-names>IM</given-names></name></person-group><article-title>Mortality amongst multiple trauma patients admitted to an intensive therapy unit</article-title><source>Anaesthesia</source><year>1984</year><volume>39</volume><fpage>973</fpage><lpage>981</lpage><pub-id pub-id-type="pmid">6496912</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2044.1984.tb08885.x</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ledingham</surname><given-names>I</given-names></name><name><surname>Watt</surname><given-names>I</given-names></name></person-group><article-title>Influence of sedation on mortality in critically ill multiple trauma patients</article-title><source>Lancet</source><year>1983</year><volume>1</volume><fpage>1270</fpage><pub-id pub-id-type="pmid">6134053</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(83)92712-5</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Absalom</surname><given-names>A</given-names></name><name><surname>Pledger</surname><given-names>D</given-names></name><name><surname>Kong</surname><given-names>A</given-names></name></person-group><article-title>Adrenocortical function in critically ill patients 24 h after a single dose of etomidate</article-title><source>Anaesthesia</source><year>1999</year><volume>54</volume><fpage>861</fpage><lpage>867</lpage><pub-id pub-id-type="pmid">10460557</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2044.1999.01003.x</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Malerba</surname><given-names>G</given-names></name><name><surname>Romano-Girard</surname><given-names>F</given-names></name><name><surname>Cravoisy</surname><given-names>A</given-names></name><name><surname>Dousset</surname><given-names>B</given-names></name><name><surname>Nace</surname><given-names>L</given-names></name><name><surname>Levy</surname><given-names>B</given-names></name><name><surname>Bollaert</surname><given-names>P-E</given-names></name></person-group><article-title>Risk factors of relative adrenocortical deficiency in intensive care patients needing mechanical ventilation</article-title><source>Intensive Care Med</source><year>2005</year><volume>31</volume><fpage>388</fpage><lpage>392</lpage><pub-id pub-id-type="pmid">15703896</pub-id><pub-id pub-id-type="doi">10.1007/s00134-004-2550-8</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Annane</surname><given-names>D</given-names></name></person-group><article-title>Etomidate and intensive care physicians</article-title><source>Intensive Care Med</source><year>2005</year><volume>31</volume><fpage>1454</fpage><pub-id pub-id-type="doi">10.1007/s00134-005-2755-5</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Annane</surname><given-names>D</given-names></name></person-group><article-title>ICU physicians should abandon the use of etomidate!</article-title><source>Intensive Care Med</source><year>2005</year><volume>31</volume><fpage>325</fpage><lpage>326</lpage><pub-id pub-id-type="pmid">15750800</pub-id><pub-id pub-id-type="doi">10.1007/s00134-005-2560-1</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><p