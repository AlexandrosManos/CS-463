b-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Villa</surname><given-names>P</given-names></name><name><surname>Jim&#x000e9;nez</surname><given-names>M</given-names></name><name><surname>Soriano</surname><given-names>MC</given-names></name><name><surname>Manzanares</surname><given-names>J</given-names></name><name><surname>Casasnovas</surname><given-names>P</given-names></name></person-group><article-title>Serum cystatin C concentration as a marker of acute renal dysfunction in critically ill patients</article-title><source>Crit Care</source><year>2005</year><volume>9</volume><fpage>R139</fpage><lpage>143</lpage><pub-id pub-id-type="pmid">15774046</pub-id><pub-id pub-id-type="doi">10.1186/cc3044</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huber</surname><given-names>AR</given-names></name><name><surname>Risch</surname><given-names>L</given-names></name></person-group><article-title>Recent developments in the evaluation of glomerular filtration rate: is there a place for beta-trace?</article-title><source>Clin Chem</source><year>2005</year><volume>51</volume><fpage>1329</fpage><lpage>1330</lpage><pub-id pub-id-type="pmid">16040837</pub-id><pub-id pub-id-type="doi">10.1373/clinchem.2005.053389</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Newman</surname><given-names>DJ</given-names></name></person-group><article-title>Cystatin C</article-title><source>Ann Clin Biochem</source><year>2002</year><volume>39</volume><fpage>89</fpage><lpage>104</lpage><pub-id pub-id-type="pmid">11928770</pub-id><pub-id pub-id-type="doi">10.1258/0004563021901847</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bianchi</surname><given-names>C</given-names></name><name><su