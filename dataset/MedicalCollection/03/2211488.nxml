given-names>W</given-names></name><name><surname>Ko</surname><given-names>MS</given-names></name></person-group><article-title>Transcriptome analysis of mouse stem cells and early embryos</article-title><source>PLoS Biol</source><year>2003</year><volume>1</volume><fpage>E74</fpage><pub-id pub-id-type="pmid">14691545</pub-id><pub-id pub-id-type="doi">10.1371/journal.pbio.0000074</pub-id></citation></ref><ref id="B2"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamatani</surname><given-names>T</given-names></name><name><surname>Carter</surname><given-names>MG</given-names></name><name><surname>Sharov</surname><given-names>AA</given-names></name><name><surname>Ko</surname><given-names>MS</given-names></name></person-group><article-title>Dynamics of global gene expression changes during mouse preimplantation development</article-title><source>Dev Cell</source><year>2004</year><volume>6</volume><fpage>117</fpage><lpage>131</lpage><pub-id pub-id-type="pmid">14723852</pub-id><pub-id pub-id-type="doi">10.1016/S1534-5807(03)00373-3</pub-id></citation></ref><ref id="B3"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kocabas</surname><given-names>AM</given-names></name><name><surname>Crosby</surname><given-names>J</given-names></name><name><surname>Ross</surname><given-names>PJ</given-names></name><name><surname>Otu</surname><given-names>HH</given-names></name><name><surname>Beyhan</surname><given-names>Z</given-names></name><name><surname>Can</surname><given-names>H</given-names></name><name><surname>Tam</surname><given-names>WL</given-names></name><name><surname>Rosa</surname><given-names>GJ</given-names></name><name><surname>Halgren</surname><given-names>RG</given-names></name><name><surname>Lim</surname><given-names>B</given-names></name><name><surname>Fernandez</surname><given-names>E</given-names></name><name><surname>Cibelli</surname><given-names>JB</given-names></name></person-group