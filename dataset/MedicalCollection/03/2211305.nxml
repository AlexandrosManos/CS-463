<name><surname>Martin</surname><given-names>JJ</given-names></name><name><surname>Rossor</surname><given-names>M</given-names></name><name><surname>Owen</surname><given-names>MJ</given-names></name><name><surname>Mullan</surname><given-names>M</given-names></name><name><surname>Percy</surname><given-names>ME</given-names></name><name><surname>Karlinsky</surname><given-names>H</given-names></name><name><surname>Rich</surname><given-names>S</given-names></name><name><surname>Heston</surname><given-names>L</given-names></name><name><surname>Montesi</surname><given-names>M</given-names></name><name><surname>Mortilla</surname><given-names>M</given-names></name><name><surname>Nacmias</surname><given-names>N</given-names></name><name><surname>Gusella</surname><given-names>JF</given-names></name><name><surname>Hardy</surname><given-names>JA</given-names></name></person-group><article-title>Genetic linkage studies suggest that Alzheimer's disease is not a single homogeneous disorder</article-title><source>Nature</source><year>1990</year><volume>347</volume><fpage>194</fpage><lpage>197</lpage><pub-id pub-id-type="pmid">2395471</pub-id><pub-id pub-id-type="doi">10.1038/347194a0</pub-id></citation></ref><ref id="B3"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schellenberg</surname><given-names>GD</given-names></name><name><surname>Bird</surname><given-names>TD</given-names></name><name><surname>Wijsman</surname><given-names>EM</given-names></name><name><surname>Orr</surname><given-names>HT</given-names></name><name><surname>Anderson</surname><given-names>L</given-names></name><name><surname>Nemens</surname><given-names>E</given-names></name><name><surname>White</surname><given-names>JA</given-names></name><name><surname>Bonnycastle</surname><given-names>L</given-names></name><name><surname>Weber</surname><given-names>JL</given-names></name><name><surname>Alonso</surname><given-names>ME</given-names></name><etal></etal></person-group