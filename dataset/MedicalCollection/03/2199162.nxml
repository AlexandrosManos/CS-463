><name><surname>Kiefer</surname><given-names>R</given-names></name><name><surname>Haas</surname><given-names>CA</given-names></name><name><surname>Kreutzberg</surname><given-names>GW</given-names></name></person-group><article-title>Gamma interferon&#x02013;like immunoreactive material in rat neurons: evidence against a close relationship to gamma interferon</article-title><source>Neuroscience</source><year>1991</year><volume>45</volume><fpage>551</fpage><lpage>560</lpage><pub-id pub-id-type="pmid">1775233</pub-id></citation></ref><ref id="B11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wood</surname><given-names>PM</given-names></name></person-group><article-title>Separation of functional Schwann cells and neurons from normal peripheral nerve tissue</article-title><source>Brain Res</source><year>1976</year><volume>115</volume><fpage>361</fpage><lpage>375</lpage><pub-id pub-id-type="pmid">135599</pub-id></citation></ref><ref id="B12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Neumann</surname><given-names>H</given-names></name><name><surname>Cavali&#x000e9;</surname><given-names>A</given-names></name><name><surname>Jenne</surname><given-names>DE</given-names></name><name><surname>Wekerle</surname><given-names>H</given-names></name></person-group><article-title>Induction of MHC class I genes in neurons</article-title><source>Science</source><year>1995</year><volume>269</volume><fpage>549</fpage><lpage>552</lpage><pub-id pub-id-type="pmid">7624779</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>K&#x000e4;&#x000e4;b</surname><given-names>G</given-names></name><name><surname>Brandl</surname><given-names>G</given-names></name><name><surname>Marx</surname><given-names>A</given-names></name><name><surname>Wekerle</surname><given-names>H</given-names><