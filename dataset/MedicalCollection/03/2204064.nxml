110</volume><fpage>294</fpage><lpage>305</lpage></citation></ref><ref id="pone.0001518-Brosnan4"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brosnan</surname><given-names>SF</given-names></name><name><surname>de Waal</surname><given-names>FBM</given-names></name></person-group><year>2003</year><article-title>Monkeys reject unequal pay.</article-title><source>Nature</source><volume>425</volume><fpage>297</fpage><lpage>299</lpage><pub-id pub-id-type="pmid">13679918</pub-id></citation></ref><ref id="pone.0001518-Brosnan5"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brosnan</surname><given-names>SF</given-names></name><name><surname>de Waal</surname><given-names>FBM</given-names></name></person-group><year>2004</year><article-title>A concept of value during experimental exchange in brown capuchin monkeys.</article-title><source>Folia primatol</source><volume>75</volume><fpage>317</fpage><lpage>330</lpage><pub-id pub-id-type="pmid">15486443</pub-id></citation></ref><ref id="pone.0001518-Westergaard1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Westergaard</surname><given-names>GC</given-names></name><name><surname>Evans</surname><given-names>TA</given-names></name><name><surname>Howell</surname><given-names>S</given-names></name></person-group><year>2007</year><article-title>Token mediated tool exchange between tufted capuchin monkeys (<italic>Cebus apella</italic>).</article-title><source>Anim Cogn</source></citation></ref><ref id="pone.0001518-Addessi1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Addessi</surname><given-names>E</given-names></name><name><surname>Crescimbene</surname><given-names>L</given-names></name><name><surname>Visalberghi</surname><given-names>E</given-names></name></person-group><year>2007</year><ar