tation citation-type="journal"><person-group person-group-type="author"><name><surname>Hick</surname><given-names>JL</given-names></name><name><surname>O'Laughlin</surname><given-names>DT</given-names></name></person-group><article-title>Concept of operations for triage of mechanical ventilation in an epidemic</article-title><source>Acad Emerg Med</source><year>2006</year><volume>13</volume><fpage>223</fpage><lpage>229</lpage><pub-id pub-id-type="pmid">16400088</pub-id><pub-id pub-id-type="doi">10.1197/j.aem.2005.07.037</pub-id></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><collab>Agency for Healthcare Research and Quality (AHRQ)</collab></person-group><person-group person-group-type="editor"><name><surname>Phillips S, Knebel A</surname></name></person-group><source>Providing Mass Medical Care with Scarce Resources: A Community Planning Guide AHRQ Publication No 07001</source><year>2006</year><publisher-name>Rockville, MD: AHRQ</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.ahrq.gov/research/mce/"/></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Christian</surname><given-names>MD</given-names></name><name><surname>Hawryluck</surname><given-names>L</given-names></name><name><surname>Wax</surname><given-names>RS</given-names></name><name><surname>Cook</surname><given-names>T</given-names></name><name><surname>Lazar</surname><given-names>NM</given-names></name><name><surname>Herridge</surname><given-names>MS</given-names></name><name><surname>Muller</surname><given-names>MP</given-names></name><name><surname>Gowans</surname><given-names>DR</given-names></name><name><surname>Fortier</surname><given-names>W</given-names></name><name><surname>Burkle</surname><given-names>FM</given-names></name></person-group><article-title>Development of a triage protocol for critical care during an influenza pandemic</article-title><sourc