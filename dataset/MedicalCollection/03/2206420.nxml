son-group person-group-type="author"><name><surname>Saffle</surname><given-names>JR</given-names></name><name><surname>Gibran</surname><given-names>N</given-names></name><name><surname>Jordan</surname><given-names>M</given-names></name></person-group><article-title>Defining the ratio of outcomes to resources for triage of burn patients in mass casualties</article-title><source>J Burn Care Rehabil</source><year>2005</year><volume>26</volume><fpage>478</fpage><lpage>482</lpage><pub-id pub-id-type="pmid">16278561</pub-id><pub-id pub-id-type="doi">10.1097/01.bcr.0000185452.92833.c0</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koenig</surname><given-names>KL</given-names></name><name><surname>Goans</surname><given-names>RE</given-names></name><name><surname>Hatchett</surname><given-names>RJ</given-names></name><name><surname>Mettler</surname><given-names>FA</given-names><suffix>Jr</suffix></name><name><surname>Schumacher</surname><given-names>TA</given-names></name><name><surname>Noji</surname><given-names>EK</given-names></name><name><surname>Jarrett</surname><given-names>DG</given-names></name></person-group><article-title>Medical treatment of radiological casualties: current concepts</article-title><source>Ann Emerg Med</source><year>2005</year><volume>45</volume><fpage>643</fpage><lpage>652</lpage><pub-id pub-id-type="pmid">15940101</pub-id><pub-id pub-id-type="doi">10.1016/j.annemergmed.2005.01.020</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Turai</surname><given-names>I</given-names></name><name><surname>Veress</surname><given-names>K</given-names></name><name><surname>Gunalp</surname><given-names>B</given-names></name><name><surname>Souchkevitch</surname><given-names>G</given-names></name></person-group><article-title>Medical response to radiation incidents and radionuclear threats</article-title><