"journal"><person-group person-group-type="author"><name><surname>Abdelwahab</surname><given-names>IF</given-names></name><name><surname>Kenan</surname><given-names>S</given-names></name><name><surname>Hermann</surname><given-names>G</given-names></name><name><surname>Klein</surname><given-names>MJ</given-names></name><name><surname>Lewis</surname><given-names>MM</given-names></name></person-group><article-title>Tuberculous peroneal tenosynovitis</article-title><source>J Bone Joint Surg Am</source><year>1993</year><volume>75</volume><fpage>1687</fpage><lpage>90</lpage><pub-id pub-id-type="pmid">8245062</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adams</surname><given-names>R</given-names></name><name><surname>Jones</surname><given-names>G</given-names></name><name><surname>Marble</surname><given-names>HC</given-names></name></person-group><article-title>Tuberculous tenosynovitis</article-title><source>N Engl J Med</source><year>1940</year><volume>223</volume><fpage>706</fpage><lpage>8</lpage></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Watts</surname><given-names>HG</given-names></name><name><surname>Lifeso</surname><given-names>RM</given-names></name></person-group><article-title>Current concepts review: tuberculosis of bones and joints</article-title><source>J Bone Joint Surg Am</source><year>1996</year><volume>78</volume><fpage>288</fpage><lpage>98</lpage><pub-id pub-id-type="pmid">8609123</pub-id></citation></ref></ref-list></back></article>