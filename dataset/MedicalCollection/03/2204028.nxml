<name><surname>Nakagawa</surname><given-names>h</given-names></name><name><surname>Yuoki</surname><given-names>Y</given-names></name><name><surname>Ogurusu</surname><given-names>K</given-names></name><name><surname>Saino</surname><given-names>S</given-names></name><name><surname>Wani</surname><given-names>T</given-names></name><name><surname>Kawagushi</surname><given-names>Y</given-names></name></person-group><article-title>Multiple gastric carcinoids and pituitary adenoma in type A gastritis</article-title><source>Intern Med</source><year>1997</year><volume>36</volume><fpage>787</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">9392350</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pearse</surname><given-names>AG</given-names></name></person-group><article-title>Common cytochemical and ultrastructural characteristics of cells producing polypeptide hormones (the APUD series) and their relevance to thyroid and ultimobranchial C cells and calcitonin</article-title><source>Proc R Soc Lond B Biol Sci</source><volume>170</volume><fpage>71</fpage><lpage>80</lpage><comment>1968 May 14</comment><pub-id pub-id-type="pmid">4384885</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hemminki</surname><given-names>K</given-names></name><name><surname>Li</surname><given-names>X</given-names></name></person-group><article-title>Incidence trends and risk factors of carcinoid tumors: a nationwide epidemiologic study from Sweden</article-title><source>Cancer</source><year>2001</year><volume>92</volume><fpage>2204</fpage><lpage>2210</lpage><pub-id pub-id-type="pmid">11596039</pub-id><pub-id pub-id-type="doi">10.1002/1097-0142(20011015)92:8&#x0003c;2204::AID-CNCR1564&#x0003e;3.0.CO;2-R</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Duh</surname><given