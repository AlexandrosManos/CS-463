rticle-title>Health effects of dioxin exposure: a 20-year mortality study</article-title><source>Am J Epidemiol</source><volume>153</volume><fpage>1031</fpage><lpage>1044</lpage><pub-id pub-id-type="pmid">11390319</pub-id></citation></ref><ref id="b7-ehp0116-000070"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carlsen</surname><given-names>E</given-names></name><name><surname>Giwercman</surname><given-names>A</given-names></name><name><surname>Keiding</surname><given-names>N</given-names></name><name><surname>Skakkebaek</surname><given-names>N</given-names></name></person-group><year>1992</year><article-title>Evidence for decreasing quality of semen during the past 50 years</article-title><source>BMJ</source><volume>305</volume><fpage>609</fpage><lpage>613</lpage><pub-id pub-id-type="pmid">1393072</pub-id></citation></ref><ref id="b8-ehp0116-000070"><citation citation-type="web"><person-group person-group-type="editor"><name><surname>Damstra</surname><given-names>T</given-names></name><name><surname>Barlow</surname><given-names>S</given-names></name><name><surname>Bergman</surname><given-names>A</given-names></name><name><surname>Kavlock</surname><given-names>R</given-names></name><name><surname>Van Der Kraak</surname><given-names>G</given-names></name></person-group><year>2002</year><source>Global Assessment of the State-of-the-Science of Endocrine Disruptors</source><comment>Available: <ext-link ext-link-type="uri" xlink:href="http://www.ehponline.org/who/">http://www.ehponline.org/who/</ext-link></comment><access-date>[accessed 26 February 2007]</access-date></citation></ref><ref id="b9-ehp0116-000070"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>David</surname><given-names>G</given-names></name><name><surname>Bisson</surname><given-names>JP</given-names></name><name><surname>Czyglik</surname><given-names>F</given-names></name><name><surname>Jouannet</surname><given-names>P<