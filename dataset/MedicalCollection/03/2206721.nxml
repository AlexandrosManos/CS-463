ame><given-names>E</given-names></name></person-group><article-title>Dissociation between steroid receptor expression and cell proliferation in the human breast</article-title><source>Cancer Res</source><year>1997</year><volume>57</volume><fpage>4987</fpage><lpage>4991</lpage><pub-id pub-id-type="pmid">9371488</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Petersen</surname><given-names>OW</given-names></name><name><surname>H&#x000f8;yer</surname><given-names>PE</given-names></name><name><surname>van Deurs</surname><given-names>B</given-names></name></person-group><article-title>Frequency and distribution of estrogen receptor-positive cells in normal, nonlactating human breast tissue</article-title><source>Cancer Res</source><year>1987</year><volume>47</volume><fpage>5748</fpage><lpage>5751</lpage><pub-id pub-id-type="pmid">3664479</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fabris</surname><given-names>G</given-names></name><name><surname>Marchetti</surname><given-names>E</given-names></name><name><surname>Marzola</surname><given-names>A</given-names></name><name><surname>Bagni</surname><given-names>A</given-names></name><name><surname>Querzoli</surname><given-names>P</given-names></name><name><surname>Nenci</surname><given-names>I</given-names></name></person-group><article-title>Pathophysiology of estrogen receptors in mammary tissue by monoclonal antibodies</article-title><source>J Steroid Biochem</source><year>1987</year><volume>27</volume><fpage>171</fpage><lpage>176</lpage><pub-id pub-id-type="pmid">3695478</pub-id><pub-id pub-id-type="doi">10.1016/0022-4731(87)90307-4</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adams</surname><given-names>BD</given-names></name><name><surname>Furneaux</surname><given-names>H</gi