pe="journal"><person-group person-group-type="author"><name><surname>Selmaj</surname><given-names>KW</given-names></name><name><surname>Raine</surname><given-names>CS</given-names></name></person-group><article-title>Tumor necrosis factor mediates myelin and oligodendrocyte damage in vitro</article-title><source>Ann  Neurol</source><year>1988</year><volume>23</volume><fpage>339</fpage><lpage>346</lpage><pub-id pub-id-type="pmid">3132891</pub-id></citation></ref><ref id="B11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bazzoni</surname><given-names>F</given-names></name><name><surname>Beutler</surname><given-names>B</given-names></name></person-group><article-title>The tumor necrosis factor ligand and receptor families</article-title><source>N Engl J Med</source><year>1996</year><volume>334</volume><fpage>1717</fpage><lpage>1725</lpage><pub-id pub-id-type="pmid">8637518</pub-id></citation></ref><ref id="B12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Frei</surname><given-names>K</given-names></name><name><surname>Eugster</surname><given-names>HP</given-names></name><name><surname>Bopst</surname><given-names>M</given-names></name><name><surname>Constantinescu</surname><given-names>CS</given-names></name><name><surname>Lavi</surname><given-names>E</given-names></name><name><surname>Fontana</surname><given-names>A</given-names></name></person-group><article-title>Tumor necrosis factor &#x003b1; and lymphotoxin &#x003b1; are not required for induction of acute experimental autoimmune encephalomyelitis</article-title><source>J Exp Med</source><year>1997</year><volume>185</volume><fpage>2177</fpage><lpage>2182</lpage><pub-id pub-id-type="pmid">9182689</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Togni</surname><given-names>P</given-names></name><name><surname>Goellner</surname><given-names>J</given-names></name><name><surname>Ruddle</surname><given-names>NH</given-names></name><name><surname>Streeter</surname><given-names>PR</given-names></name><name><surname>Fick</surname><given-names>A</given-names></name><name><surname>Mariathasan</surname><given-names>S</given-names></name><name><surname>Smith</surname><given-names>SC</given-names></name><name><surname>Carlson</surname><given-names>R</given-names></name><name><surname>Shornick</surname><given-names>LP</given-names></name><name><surname>Strauss-Schoenberger</surname><given-names>J</given-names></name><etal/></person-group><article-title>Abnormal development of peripheral lymphoid organs in mice deficient in lymphotoxin</article-title><source>Science (Wash DC)</source><year>1994</year><volume>264</volume><fpage>703</fpage><lpage>707</lpage><pub-id pub-id-type="pmid">8171322</pub-id></citation></ref><ref id="B14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Theofilopoulos</surname><given-names>AN</given-names></name></person-group><article-title>The basis of autoimmunity: part II. Genetic predisposition</article-title><source>Immunol Today</source><year>1995</year><volume>16</volume><fpage>150</fpage><lpage>159</lpage><pub-id pub-id-type="pmid">7718089</pub-id></citation></ref><ref id="B15"><label>15</label><citation citation-type="other">K&#x000f6;rner, H., M. Cook, D.S. Riminton, F.A. Lemckert, R.M.  Hoek, B. Ledermann, F. K&#x000f6;ntgen, B. Fazekas de St. Groth,  and J.D. Sedgwick. 1997. Distinct roles for lymphotoxin-&#x003b1;  and tumor necrosis factor in organogenesis and spatial organisation of lymphoid tissue. <italic>Eur. J. Immunol.</italic> In press.</citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gardinier</surname><given-names>MV</given-names></name><name><surname>Amiguet</surname><given-names>P</given-names></name><name><surname>Linington</surname><given-names>C</given-names></name><name><surname>Matthieu</surname><given-names>JM</given-names></name></person-group><article-title>Myelin/oligodendrocyte glycoprotein is a unique member of the immunoglobulin superfamily</article-title><source>J Neurosci Res</source><year>1992</year><volume>33</volume><fpage>177</fpage><lpage>187</lpage><pub-id pub-id-type="pmid">1453482</pub-id></citation></ref><ref id="B17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ford</surname><given-names>AL</given-names></name><name><surname>Goodsall</surname><given-names>AL</given-names></name><name><surname>Hickey</surname><given-names>WF</given-names></name><name><surname>Sedgwick</surname><given-names>JD</given-names></name></person-group><article-title>Normal adult ramified microglia separated from other  central nervous system macrophages by flow cytometric sorting. Phenotypic differences defined and direct ex vivo antigen presentation to myelin basic protein-reactive CD4<sup>&#x0002b;</sup>T cells compared</article-title><source>J Immunol</source><year>1995</year><volume>154</volume><fpage>4309</fpage><lpage>4321</lpage><pub-id pub-id-type="pmid">7722289</pub-id></citation></ref><ref id="B18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Linington</surname><given-names>C</given-names></name><name><surname>Bradl</surname><given-names>M</given-names></name><name><surname>Lassmann</surname><given-names>H</given-names></name><name><surname>Brunner</surname><given-names>C</given-names></name><name><surname>Vass</surname><given-names>K</given-names></name></person-group><article-title>Augmentation of demyelination in rat acute allergic encephalomyelitis by circulating mouse monoclonal antibodies directed against a myelin/oligodendrocyte glycoprotein</article-title><source>Am J Pathol</source><year>1988</year><vo