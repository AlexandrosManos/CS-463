ear><article-title>Abundant raw material for cis-regulatory evolution in humans</article-title><source>Mol Biol Evol</source><volume>19</volume><fpage>1991</fpage><lpage>2004</lpage><pub-id pub-id-type="pmid">12411608</pub-id></citation></ref><ref id="pcbi-0040005-b013"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Montgomery</surname><given-names>SB</given-names></name><name><surname>Griffith</surname><given-names>OL</given-names></name><name><surname>Sleumer</surname><given-names>MC</given-names></name><name><surname>Bergman</surname><given-names>CM</given-names></name><name><surname>Bilenky</surname><given-names>M</given-names></name><etal/></person-group><year>2006</year><article-title>ORegAnno: an open access database and curation system for literature-derived promoters, transcription factor binding sites and regulatory variation</article-title><source>Bioinformatics</source><volume>22</volume><fpage>637</fpage><lpage>640</lpage><pub-id pub-id-type="pmid">16397004</pub-id></citation></ref><ref id="pcbi-0040005-b014"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buckland</surname><given-names>PR</given-names></name><name><surname>Hoogendoorn</surname><given-names>B</given-names></name><name><surname>Coleman</surname><given-names>SL</given-names></name><name><surname>Guy</surname><given-names>CA</given-names></name><name><surname>Smith</surname><given-names>SK</given-names></name><etal/></person-group><year>2005</year><article-title>Strong bias in the location of functional promoter polymorphisms</article-title><source>Hum Mutat</source><volume>26</volume><fpage>214</fpage><lpage>223</lpage><pub-id pub-id-type="pmid">16086313</pub-id></citation></ref><ref id="pcbi-0040005-b015"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pastinen</surname><given-names>T</given-names></name><name><surname>Hudson</surname><given-names>TJ</given-names