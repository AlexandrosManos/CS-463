</volume><fpage>1401</fpage><lpage>1405</lpage><pub-id pub-id-type="pmid">8643643</pub-id></citation></ref><ref id="B7"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Alam</surname><given-names>SM</given-names></name><name><surname>Travers</surname><given-names>PJ</given-names></name><name><surname>Wung</surname><given-names>JL</given-names></name><name><surname>Nasholds</surname><given-names>W</given-names></name><name><surname>Redpath</surname><given-names>S</given-names></name><name><surname>Jameson</surname><given-names>SC</given-names></name><name><surname>Gascoigne</surname><given-names>NR</given-names></name></person-group><article-title>T-cell-receptor affinity and thymocyte positive selection</article-title><source>Nature</source><year>1996</year><volume>381</volume><fpage>616</fpage><lpage>620</lpage><pub-id pub-id-type="pmid">8637599</pub-id></citation></ref><ref id="B8"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Seth</surname><given-names>A</given-names></name><name><surname>Stern</surname><given-names>LJ</given-names></name><name><surname>Ottenhoff</surname><given-names>TH</given-names></name><name><surname>Engel</surname><given-names>I</given-names></name><name><surname>Owen</surname><given-names>MJ</given-names></name><name><surname>Lamb</surname><given-names>JR</given-names></name><name><surname>Klausner</surname><given-names>RD</given-names></name><name><surname>Wiley</surname><given-names>DC</given-names></name></person-group><article-title>Binary and ternary complexes between T-cell receptor, class II MHC and superantigen in vitro</article-title><source>Nature</source><year>1994</year><volume>369</volume><fpage>324</fpage><lpage>327</lpage><pub-id pub-id-type="pmid">8183371</pub-id></citation></ref><ref id="B9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Abrahmsen</s