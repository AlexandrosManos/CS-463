tation-type="journal"><person-group person-group-type="author"><name><surname>Comak</surname><given-names>E</given-names></name><name><surname>Arslan</surname><given-names>A</given-names></name><name><surname>T&#x000fc;rko&#x0011f;lu</surname><given-names>I</given-names></name></person-group><article-title>A decision support system based on support vector machines for diagnosis of the heart valve diseases</article-title><source>Comput Biol Med</source><year>2007</year><volume>37</volume><fpage>21</fpage><lpage>27</lpage><pub-id pub-id-type="pmid">16426598</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yoon</surname><given-names>Y</given-names></name><name><surname>Song</surname><given-names>J</given-names></name><name><surname>Hong</surname><given-names>SH</given-names></name><name><surname>Kim</surname><given-names>JQ</given-names></name></person-group><article-title>Analysis of multiple single nucleotide polymorphisms of candidate genes related to coronary heart disease susceptibility by using support vector machines</article-title><source>Clin Chem Lab Med</source><year>2003</year><volume>41</volume><fpage>529</fpage><lpage>534</lpage><pub-id pub-id-type="pmid">12747598</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pochet</surname><given-names>NL</given-names></name><name><surname>Suykens</surname><given-names>JA</given-names></name></person-group><article-title>Support vector machines versus logistic regression: improving prospective performance in clinical decision-making</article-title><source>Ultrasound Obstet Gynecol</source><year>2006</year><volume>27</volume><fpage>607</fpage><lpage>608</lpage><pub-id pub-id-type="pmid">16715467</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clermont</surname><given-names>G</given