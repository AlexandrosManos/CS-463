-type="journal"><person-group person-group-type="author"><name><surname>Miller</surname><given-names>PS</given-names></name></person-group><year>2006</year><article-title>The computiful game.</article-title><source>Nature</source><volume>441</volume><fpage>784</fpage></citation></ref><ref id="pone.0001552-Tatem1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tatem</surname><given-names>AJ</given-names></name><name><surname>Guerra</surname><given-names>CA</given-names></name><name><surname>Atkinson</surname><given-names>PM</given-names></name><name><surname>Hay</surname><given-names>SI</given-names></name></person-group><year>2004</year><article-title>Momentous sprint at the 2156 Olympics ?</article-title><source>Nature</source><volume>431</volume><fpage>525</fpage><pub-id pub-id-type="pmid">15457248</pub-id></citation></ref><ref id="pone.0001552-IOC1"><label>9</label><citation citation-type="book"><collab>IOC</collab><article-title>Official website of the Olympic movement.</article-title><comment><ext-link ext-link-type="uri" xlink:href="http://www.olympic.org">http://www.olympic.org</ext-link></comment></citation></ref><ref id="pone.0001552-1"><label>10</label><citation citation-type="book"><article-title>Swimming U home.</article-title><comment><ext-link ext-link-type="uri" xlink:href="http://www.usaswimming.org">http://www.usaswimming.org</ext-link></comment></citation></ref><ref id="pone.0001552-FINA1"><label>11</label><citation citation-type="book"><collab>FINA</collab><article-title>Official FINA website.</article-title><comment><ext-link ext-link-type="uri" xlink:href="http://www.fina.org">http://www.fina.org</ext-link></comment></citation></ref><ref id="pone.0001552-2"><label>12</label><citation citation-type="book"><article-title>Chidlovski AR Lift Up, History of Olympic Weightlifting.</article-title><comment><ext-link ext-link-type="uri" xlink:href="http://www.chidlovski.net/liftup">http://www.chi