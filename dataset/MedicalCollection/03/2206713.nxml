roup person-group-type="author"><name><surname>Clarke</surname><given-names>RB</given-names></name><name><surname>Anderson</surname><given-names>E</given-names></name><name><surname>Howell</surname><given-names>A</given-names></name><name><surname>Potten</surname><given-names>CS</given-names></name></person-group><article-title>Regulation of human breast epithelial stem cells</article-title><source>Cell Prolif</source><year>2003</year><volume>36</volume><issue>Suppl 1</issue><fpage>45</fpage><lpage>58</lpage><pub-id pub-id-type="pmid">14521515</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2184.36.s.1.5.x</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zeps</surname><given-names>N</given-names></name><name><surname>Dawkins</surname><given-names>HJ</given-names></name><name><surname>Papadimitriou</surname><given-names>JM</given-names></name><name><surname>Redmond</surname><given-names>SL</given-names></name><name><surname>Walters</surname><given-names>MI</given-names></name></person-group><article-title>Detection of a population of long-lived cells in mammary epithelium of the mouse</article-title><source>Cell Tissue Res</source><year>1996</year><volume>286</volume><fpage>525</fpage><lpage>536</lpage><pub-id pub-id-type="pmid">8929355</pub-id><pub-id pub-id-type="doi">10.1007/s004410050722</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shackleton</surname><given-names>M</given-names></name><name><surname>Vaillant</surname><given-names>F</given-names></name><name><surname>Simpson</surname><given-names>KJ</given-names></name><name><surname>Stingl</surname><given-names>J</given-names></name><name><surname>Smyth</surname><given-names>GK</given-names></name><name><surname>Asselin-Labat</surname><given-names>ML</given-names></name><name><surname>Wu</surname><given-names>L</given-names></name><name><surname>Linde