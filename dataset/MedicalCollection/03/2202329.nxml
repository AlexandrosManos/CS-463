l"><person-group person-group-type="author"><name><surname>Pusterla</surname><given-names>N</given-names></name><name><surname>Wolfensberger</surname><given-names>C</given-names></name><name><surname>Gerber-Bretscher</surname><given-names>R</given-names></name><name><surname>Lutz</surname><given-names>H</given-names></name></person-group><article-title>Comparison of indirect immunofluorescence for <italic>Ehrlichia phagocytophila </italic>and <italic>Ehrlichia equi </italic>in horses</article-title><source>Equine Vet J</source><year>1997</year><volume>29</volume><fpage>490</fpage><lpage>492</lpage><pub-id pub-id-type="pmid">9413725</pub-id></citation></ref><ref id="B21"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Scott</surname><given-names>GR</given-names></name></person-group><source>Annual report, Centre of Tropical Veterinary Medicine, Edinburgh</source><year>1976</year><fpage>20</fpage></citation></ref><ref id="B22"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Scott</surname><given-names>GR</given-names></name></person-group><source>Annual report, Centre of Tropical Veterinary Medicine, Edinburgh</source><year>1981</year><fpage>18</fpage></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stuen</surname><given-names>S</given-names></name><name><surname>Artursson</surname><given-names>K</given-names></name></person-group><article-title>Effects of the dose of <italic>Ehrlichia phagocytophila </italic>on the severity of experimental infections in lambs</article-title><source>Vet Rec</source><year>2000</year><volume>146</volume><fpage>669</fpage><lpage>672</lpage><pub-id pub-id-type="pmid">10883856</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stuen</surname><given-names>S</given-names></name><name><surname>Hardeng</surname><given