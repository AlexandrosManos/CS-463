person-group><article-title>Deviant peri-ooestrual hormone patterns affect the epithelium of the uterine tube in repeat-breeder heifers</article-title><source>Reprod Fert Dev</source><year>2002</year><volume>14</volume><fpage>461</fpage><lpage>469</lpage><pub-id pub-id-type="doi">10.1071/RD02029</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>B&#x000e5;ge</surname><given-names>R</given-names></name><name><surname>Petyim</surname><given-names>S</given-names></name><name><surname>Larsson</surname><given-names>B</given-names></name><name><surname>Hallap</surname><given-names>T</given-names></name><name><surname>Bergqvist</surname><given-names>AS</given-names></name><name><surname>Gustafsson</surname><given-names>H</given-names></name><name><surname>Rodr&#x000ed;guez-Mart&#x000ed;nez</surname><given-names>H</given-names></name></person-group><article-title>Oocyte competence in repeat-breeder heifers: effects of an optimized ovum pick-up schedule on expression of ooestrus, follicular development and fertility</article-title><source>Reprod Fert Dev</source><year>2003</year><volume>15</volume><fpage>115</fpage><lpage>123</lpage><pub-id pub-id-type="doi">10.1071/RD02094</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Diskin</surname><given-names>MG</given-names></name><name><surname>Sreenan</surname><given-names>JM</given-names></name></person-group><article-title>Fertilisation and embryonic mortality rates in beef heifers after artificial insemination</article-title><source>J Reprod Fert</source><year>1980</year><volume>59</volume><fpage>463</fpage><lpage>468</lpage></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dobson</surname><given-names>H</given-names></name><name><surname>Smith</surname><given-names>RF</given-names></name></person-group><article-title>What is stress, and how does it affect reproduction?</article-title><source>Anim Reprod Sci</source><year>2000</year><volume>60&#x02013;61</volume><fpage>743</fpage><lpage>752</lpage><pub-id pub-id-type="doi">10.1016/S0378-4320(00)00080-4</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Duchens</surname><given-names>M</given-names></name><name><surname>Forsberg</surname><given-names>M</given-names></name><name><surname>Gustafsson</surname><given-names>H</given-names></name><name><surname>Edqvist</surname><given-names>L-E</given-names></name><name><surname>Rodr&#x000ed;guez-Mart&#x000ed;nez</surname><given-names>H</given-names></name></person-group><article-title>Reproductive performance of heifers induced to ooestrous asynchrony by suprabasal plasma progesterone levels</article-title><source>Anim Reprod Sci</source><year>1995</year><volume>39</volume><fpage>171</fpage><lpage>182</lpage><pub-id pub-id-type="doi">10.1016/0378-4320(95)01395-G</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Echternkamp</surname><given-names>SE</given-names></name></person-group><article-title>Relationship between LH and cortisol in acutely stressed beef cows</article-title><source>Theriogenology</source><year>1984</year><volume>22</volume><fpage>305</fpage><lpage>311</lpage><pub-id pub-id-type="pmid">16725962</pub-id><pub-id pub-id-type="doi">10.1016/0093-691X(84)90487-4</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Forsberg</surname><given-names>M</given-names></name><name><surname>Tagle</surname><given-names>R</given-names></name><name><surname>Madej</surname><given-names>A</given-names></name><name><surname>Molina</surname><given-names>JR</given-names></name><name><surname>Carlsson</surname><given-names>M-A</given-names></name></person-group><article-title>Radioimmunoassay of bovine, ovine and porcine luteinizing hormone with a monoclonal antibody and human tracer</article-title><source>Acta Vet Scand</source><year>1993</year><volume>34</volume><fpage>255</fpage><lpage>262</lpage><pub-id pub-id-type="pmid">8310898</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Graden</surname><given-names>AP</given-names></name><name><surname>Olds</surname><given-names>D</given-names></name><name><surname>Mochow</surname><given-names>CR</given-names></name><name><surname>Mutter</surname><given-names>LR</given-names></name></person-group><article-title>Causes of fertilisation failure in repeat breeding cattle</article-title><source>J Dairy Sci</source><year>1968</year><volume>51</volume><fpage>778</fpage><lpage>781</lpage><pub-id pub-id-type="pmid">5648809</pub-id></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gustafsson</surname><given-names>H</given-names></name></person-group><article-title>Clinical, morphological and endocrine studies in repeat breeder heifers and their embryos</article-title><source>Doctoral Thesis</source><year>1985</year><publisher-name>SLU, Uppsala</publisher-name><comment>ISBN 91-576-2305-8</comment></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gustafsson</surname><given-names>H</given-names></name></person-group><article-title>Characteristics of embryos from repeat breeder and virgin heifers</article-title><source>Theriogenology</source><year>1985</year><volume>23</volume><fpage>487</fpage><lpage>498</lpage><pub-id pub-id-type="pmid">16726019</pub-id><pub-id pub-id-type="doi">10.1016/0093-691X(85)90021-4</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gustafsson</surname><given