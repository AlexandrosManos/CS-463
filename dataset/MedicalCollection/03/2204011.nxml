 pub-id-type="doi">10.1002/ajim.10270</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liebers</surname><given-names>V</given-names></name><name><surname>Bruning</surname><given-names>T</given-names></name><name><surname>Raulf-Heimsoth</surname><given-names>M</given-names></name></person-group><article-title>Occupational endotoxin-exposure and possible health effects on humans</article-title><source>Am J Ind Med</source><year>2006</year><volume>49</volume><fpage>474</fpage><lpage>91</lpage><pub-id pub-id-type="pmid">16586405</pub-id><pub-id pub-id-type="doi">10.1002/ajim.20310</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boffetta</surname><given-names>P</given-names></name></person-group><article-title>Endotoxins in Lung Cancer Prevention</article-title><source>J Natl Cancer Inst</source><year>2007</year><volume>99</volume><fpage>339</fpage><pub-id pub-id-type="pmid">17341719</pub-id><pub-id pub-id-type="doi">10.1093/jnci/djk084</pub-id></citation></ref></ref-list></back></article>