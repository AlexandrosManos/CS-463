ge><pub-id pub-id-type="pmid">11171774</pub-id><pub-id pub-id-type="doi">10.1378/chest.119.2_suppl.385S</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Orr</surname><given-names>PH</given-names></name><name><surname>Peeling</surname><given-names>RW</given-names></name><name><surname>Fast</surname><given-names>M</given-names></name><name><surname>Brunka</surname><given-names>J</given-names></name><name><surname>Duckworth</surname><given-names>H</given-names></name><name><surname>Harding</surname><given-names>GK</given-names></name><name><surname>Nicolle</surname><given-names>LE</given-names></name></person-group><article-title>Serological study of responses to selected pathogens causing respiratory tract infection in the institutionalized elderly</article-title><source>Clin Infect Dis</source><year>1996</year><volume>23</volume><fpage>1240</fpage><lpage>1245</lpage><pub-id pub-id-type="pmid">8953065</pub-id></citation></ref></ref-list></back></article>