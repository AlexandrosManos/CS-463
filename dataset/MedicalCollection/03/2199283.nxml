="1">142</td><td align="center" rowspan="1" colspan="1">38</td><td align="center" rowspan="1" colspan="1">50</td><td align="center" rowspan="1" colspan="1">54</td><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Age<xref ref-type="table-fn" rid="tfn1-ehp0116-000021">a</xref> (years)</td><td align="center" rowspan="1" colspan="1">42.9 (19&#x02013;64)</td><td align="center" rowspan="1" colspan="1">44.1 (19&#x02013;64)</td><td align="center" rowspan="1" colspan="1">40.9 (19&#x02013;64)</td><td align="center" rowspan="1" colspan="1">43.7 (19&#x02013;64)</td><td align="center" rowspan="1" colspan="1">0.81</td></tr><tr><td align="left" rowspan="1" colspan="1">BMI<xref ref-type="table-fn" rid="tfn2-ehp0116-000021">b</xref> (kg/m<sup>2</sup>)</td><td align="center" rowspan="1" colspan="1">27.1 (26.4&#x02013;27.7)</td><td align="center" rowspan="1" colspan="1">27.4 (26.3&#x02013;28.5)</td><td align="center" rowspan="1" colspan="1">26.8 (25.6&#x02013;27.8)</td><td align="center" rowspan="1" colspan="1">27.1 (26.0&#x02013;28.2)</td><td align="center" rowspan="1" colspan="1">0.73</td></tr><tr><td align="left" rowspan="1" colspan="1">Ethnicity<xref ref-type="table-fn" rid="tfn3-ehp0116-000021">c</xref></td><td align="center" rowspan="1" colspan="1">292/300</td><td align="center" rowspan="1" colspan="1">96/100</td><td align="center" rowspan="1" colspan="1">97/100</td><td align="center" rowspan="1" colspan="1">99/100</td><td align="center" rowspan="1" colspan="1">0.19</td></tr><tr><td align="left" rowspan="1" colspan="1">Vegetarian</td><td align="center" rowspan="1" colspan="1">18/300</td><td align="center" rowspan="1" colspan="1">4/100</td><td align="center" rowspan="1" colspan="1">6/100</td><td align="center" rowspan="1" colspan="1">8/100</td><td align="center" rowspan="1" colspan="1">0.23</td></tr></tbody></table><table-wrap-foot><fn id="tfn1-ehp0116-000021"><label>a</label><p>Mean (range).</p></fn><fn id="tfn2-ehp0116-000021"><label