02032; untranslated)</td><td align="left"/><td align="left">GL:</td><td align="left"/><td align="left">GTG <bold>ACT</bold><bold>ACT</bold> TTG (RT)</td><td align="left"/><td align="left">40</td></tr><tr><td align="left"/><td align="left"/><td align="left"/><td align="left"/><td align="left"/><td align="left"/><td align="left">3B62:</td><td align="left"/><td align="left">GTG &#x000a0;&#x000a0;&#x000a0;&#x000a0;<bold>ACT</bold> TTG</td><td align="left"/><td align="left"/></tr><tr><td align="left">&#x02003;3B44</td><td align="left"/><td align="left">Murine V<sub>H</sub> 186.2</td><td align="left"/><td align="left">4 single-base deletions (leader intron)</td><td align="left"/><td align="left">VH186.2:</td><td align="left"/><td align="left"><bold>GG</bold>C,&#x000a0;&#x000a0;&#x000a0;&#x000a0;<bold>GG</bold>T (RT)</td><td align="left"/><td align="left">39, 40</td></tr><tr><td align="left"/><td align="left"/><td align="left"/><td align="left"/><td align="left"/><td align="left"/><td align="left">3B62:</td><td align="left"/><td align="left"><bold>G</bold> C,&#x000a0;&#x000a0;&#x000a0;&#x000a0;<bold>G</bold> T</td><td align="left"/><td align="left"/></tr><tr><td align="left"/><td align="left"/><td align="left"/><td align="left"/><td align="left"/><td align="left"/><td colspan="3" align="left">Other 2 events unrelated</td><td align="left"/><td align="left"/></tr><tr><td align="left">&#x02003;M167</td><td align="left"/><td align="left">Murine VH107/DFL16.1/JH1</td><td align="left"/><td align="left">2 single-base insertions (leader intron)</td><td align="left"/><td align="left">GL:</td><td align="left"/><td align="left">A<bold>TAG</bold><bold>A</bold>AGAT<bold>TAGTA</bold>G (RT)</td><td align="left"/><td align="left">41</td></tr><tr><td align="left"/><td align="left"/><td align="left"/><td align="left"/><td align="left"/><td align="left"/><td align="left">M167</td><td align="left"/><td align="left">A<bold><underline>TAGTA</underline></bold>AGAT<bold><underline>TAGTA</underlin