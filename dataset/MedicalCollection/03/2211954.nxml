l">del Hoyo, G.M., P. Martin, H.H. Vargas, S. Ruiz, C.F. Arias, and C. Ardavin. <year>2002</year>. Characterization of a common precursor population for dendritic cells. <source>Nature.</source> <volume>415</volume>:<fpage>1043</fpage>&#x02013;1047.<pub-id pub-id-type="pmid">11875574</pub-id></citation></ref><ref id="bib29"><label>29</label><citation citation-type="journal">Nutt, S.L., B. Heavey, A.G. Rolink, and M. Busslinger. <year>1999</year>. Commitment to the B-lymphoid lineage depends on the transcription factor Pax5. <source>Nature.</source> <volume>401</volume>:<fpage>556</fpage>&#x02013;562.<pub-id pub-id-type="pmid">10524622</pub-id></citation></ref></ref-list></back></article>