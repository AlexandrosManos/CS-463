-group-type="author"><name><surname>Hall</surname><given-names>EJ</given-names></name></person-group><article-title>Radiation damage and the dose-rate effect. In: Hall EJ, ed.</article-title><source>Radiobiology for the Radiologist, 3rd ed. Philadelphia: JB Lippincott</source><year>1988</year><fpage>108</fpage><lpage>36</lpage></citation></ref><ref id="B8"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coutard</surname><given-names>H</given-names></name></person-group><article-title>Principles of x-ray therapy of malignant diseases</article-title><source>Lancet</source><year>1934</year><volume>2</volume><fpage>1</fpage><lpage>8</lpage></citation></ref><ref id="B9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Powers</surname><given-names>WE</given-names></name><name><surname>Tolmach</surname><given-names>LJ</given-names></name></person-group><article-title>Demonstration of an anoxic component in a mouse tumor cell population by in vivo assay of survival following radiation</article-title><source>Radiology</source><year>1964</year><volume>83</volume><fpage>328</fpage><lpage>36</lpage><pub-id pub-id-type="pmid">14207425</pub-id></citation></ref><ref id="B10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Terasima</surname><given-names>T</given-names></name><name><surname>Tolmach</surname><given-names>LJ</given-names></name></person-group><article-title>X-ray sensitivity and DNA synthesis in synchronous population of HeLa cells</article-title><source>Science</source><year>1963</year><volume>140</volume><fpage>490</fpage><lpage>2</lpage><pub-id pub-id-type="pmid">13980636</pub-id></citation></ref><ref id="B11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sinclair</surname><given-names>WK</given-names></name><name><surname>Morton</sur