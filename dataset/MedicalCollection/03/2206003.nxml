ournal"><person-group person-group-type="author"><name><surname>Hopewell</surname><given-names>JW</given-names></name></person-group><article-title>The skin: its structure and response to ionizing radiation</article-title><source>Int J Radiat Biol</source><year>1990</year><volume>57</volume><issue>4</issue><fpage>751</fpage><lpage>73</lpage><pub-id pub-id-type="pmid">1969905</pub-id></citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Halprin</surname><given-names>KM</given-names></name></person-group><article-title>Epidermal &#x0201c;turnover time&#x0201d;&#x02014;a re-examination</article-title><source>Br J Dermatol</source><year>1972</year><volume>86</volume><issue>1</issue><fpage>14</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">4551262</pub-id></citation></ref><ref id="B17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lever</surname><given-names>WF</given-names></name><name><surname>Schaumburg-Lever</surname><given-names>G</given-names></name></person-group><article-title>Inflammatory diseases due to physical agents and foreign substances. In:</article-title><source>Histopathology of the Skin, 3rd ed. Philadelphia: JB Lippincott</source><year>1990</year><fpage>232</fpage><lpage>51</lpage></citation></ref><ref id="B18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rudolph</surname><given-names>R</given-names></name><name><surname>Arganese</surname><given-names>T</given-names></name><name><surname>Woodward</surname><given-names>M</given-names></name></person-group><article-title>The ultrastructure and etiology of chronic radiotherapy damage in human skin</article-title><source>Ann Plast Surg</source><year>1982</year><volume>9</volume><issue>4</issue><fpage>282</fpage><lpage>92</lpage><pub-id pub-id-type="pmid">7149558</pub-id></citation></ref><ref id="B19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dobbs</surname><given-names>WGH</given-names></name></person-group><article-title>A statistical study of the effects of roentgen rays on wound healing</article-title><source>Am J Roentgenol</source><year>1939</year><volume>41</volume><fpage>625</fpage><lpage>32</lpage></citation></ref><ref id="B20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moore</surname><given-names>MJ</given-names></name></person-group><article-title>The effect of radiation on connective tissue</article-title><source>Otolaryngol Clin N Am</source><year>1984</year><volume>17</volume><issue>2</issue><fpage>389</fpage><lpage>99</lpage></citation></ref><ref id="B21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kindwall</surname><given-names>EP</given-names></name></person-group><article-title>Hyperbaric oxygen's effect on radiation necrosis</article-title><source>Clin Plast Surg</source><year>1993</year><volume>20</volume><issue>3</issue><fpage>473</fpage><lpage>83</lpage><pub-id pub-id-type="pmid">8324986</pub-id></citation></ref><ref id="B22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chang</surname><given-names>HS</given-names></name><name><surname>Hom</surname><given-names>DB</given-names></name><name><surname>Agarwal</surname><given-names>RP</given-names></name><etal/></person-group><article-title>Effects of basic fibroblast growth factor on irradiated porcine skin flaps</article-title><source>Arch Otolaryngol Head Neck Surg</source><year>1998</year><volume>124</volume><fpage>307</fpage><lpage>12</lpage><pub-id pub-id-type="pmid">9525516</pub-id></citation></ref><ref id="B23"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ariyan</surname><given-names>S</given-names></name><name><surname>Craft</surname><given-names>RL</given-names></name><name><surname>Goldberg</surname><given-names>NH</given-names></name></person-group><article-title>An experimental model to determine the effects of adjuvant therapy on the incidence of postoperative wound infection: II. Evaluating preoperative chemotherapy</article-title><source>Plast Reconstr Surg</source><year>1980</year><volume>65</volume><fpage>338</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">6766559</pub-id></citation></ref><ref id="B24"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Luce</surname><given-names>EA</given-names></name></person-group><article-title>The irradiated wound</article-title><source>Surg Clin N Am</source><year>1984</year><volume>64</volume><issue>4</issue><fpage>821</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">6591499</pub-id></citation></ref><ref id="B25"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arnold</surname><given-names>PG</given-names></name><name><surname>Lovich</surname><given-names>SF</given-names></name><name><surname>Pairolero</surname><given-names>PC</given-names></name></person-group><article-title>Muscle flaps in irradiated wounds: an account of 100 consecutive cases</article-title><source>Plast Reconstr Surg</source><year>1994</year><volume>93</volume><fpage>324</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">8310024</pub-id></citation></ref><ref id="B26"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Payne</surname><given-names>WG</given-names></name><name><surname>Walusimbi</surname><given-names>MS</given-names></name><name><surname>Blue</surname><given-names>ML</given-names></name><etal/></person-group><article-title>Radiated groin wounds: pitfalls in reconstruction</article-title><source>Am Surg</source><year>2003</year><volume>6