.7</td><td colspan="1" rowspan="1" align="left"><italic>&#x000a0;J558.52</italic></td><td colspan="1" rowspan="1" align="right">J558</td><td colspan="1" rowspan="1" align="left">P2.12</td><td colspan="1" rowspan="1" align="center">J<sub>H</sub>4</td><td colspan="1" rowspan="1" align="char" char=".">99.6</td><td colspan="1" rowspan="1" align="char" char=".">100</td><td colspan="1" rowspan="1" align="left"><italic>cy9</italic></td><td colspan="1" rowspan="1" align="left">v&#x003ba;9/10</td><td colspan="1" rowspan="1" align="center">J<sub>k</sub>2</td></tr><tr><td colspan="1" rowspan="1" align="char" char=".">421</td><td colspan="1" rowspan="1" align="char" char=".">96.3</td><td colspan="1" rowspan="1" align="char" char=".">94.6</td><td colspan="1" rowspan="1" align="left"><italic>&#x000a0;J558.17</italic></td><td colspan="1" rowspan="1" align="right">J558</td><td colspan="1" rowspan="1" align="left">D16.1, P2.9</td><td colspan="1" rowspan="1" align="center">J<sub>H</sub>4</td><td colspan="1" rowspan="1" align="char" char=".">97.8</td><td colspan="1" rowspan="1" align="char" char=".">95.7</td><td colspan="1" rowspan="1" align="left"><italic>8-27</italic></td><td colspan="1" rowspan="1" align="left">v&#x003ba;8</td><td colspan="1" rowspan="1" align="center">J<sub>k</sub>5</td></tr><tr><td colspan="1" rowspan="1" align="char" char=".">424</td><td colspan="1" rowspan="1" align="char" char=".">97.3</td><td colspan="1" rowspan="1" align="char" char=".">94.9</td><td colspan="1" rowspan="1" align="left"><italic>&#x000a0;J558.35</italic></td><td colspan="1" rowspan="1" align="right">J558</td><td colspan="1" rowspan="1" align="left">P2.5/7</td><td colspan="1" rowspan="1" align="center">J<sub>H</sub>1</td><td colspan="1" rowspan="1" align="char" char=".">99.2</td><td colspan="1" rowspan="1" align="char" char=".">97.6</td><td colspan="1" rowspan="1" align="left"><italic>ai4</italic></td><td colspan="1" rowspan="1" align="left">v&#x003ba;4/5</td><td colspan="1" rowspan="1" align="center">J<sub>k</sub>5</td></tr><tr><td colspan="1" rowspan="1" align="char" char=".">425</td><td colspan="1" rowspan="1" align="char" char=".">95.7</td><td colspan="1" rowspan="1" align="char" char=".">89.1</td><td colspan="1" rowspan="1" align="left"><italic>&#x000a0;J558.32</italic></td><td colspan="1" rowspan="1" align="right">J558</td><td colspan="1" rowspan="1" align="left">P2.5/7, P2.13</td><td colspan="1" rowspan="1" align="center">J<sub>H</sub>2</td><td colspan="1" rowspan="1" align="char" char=".">98.5</td><td colspan="1" rowspan="1" align="char" char=".">95.7</td><td colspan="1" rowspan="1" align="left"><italic>cr1</italic></td><td colspan="1" rowspan="1" align="left">v&#x003ba;1</td><td colspan="1" rowspan="1" align="center">J<sub>k</sub>1</td></tr><tr><td colspan="1" rowspan="1" align="char" char=".">426</td><td colspan="1" rowspan="1" align="char" char=".">96.8</td><td colspan="1" rowspan="1" align="char" char=".">91.5</td><td colspan="1" rowspan="1" align="left"><italic>V-BK</italic></td><td colspan="1" rowspan="1" align="right">7183</td><td colspan="1" rowspan="1" align="left">P2.4/6, P2.10</td><td colspan="1" rowspan="1" align="center">J<sub>H</sub>2</td><td colspan="1" rowspan="1" align="char" char=".">98.9</td><td colspan="1" rowspan="1" align="char" char=".">98.9</td><td colspan="1" rowspan="1" align="left"><italic>12-44</italic></td><td colspan="1" rowspan="1" align="left">v&#x003ba;12/13</td><td colspan="1" rowspan="1" align="center">J<sub>k</sub>5</td></tr><tr><td colspan="1" rowspan="1" align="char" char=".">531</td><td colspan="1" rowspan="1" align="char" char=".">98.2</td><td colspan="1" rowspan="1" align="char" char=".">95.7</td><td colspan="1" rowspan="1" align="left"><italic>&#x000a0;J558.52</italic></td><td colspan="1" rowspan="1" align="right">J558</td><td colspan="1" rowspan="1" align="left">D16.1, D16.2</td><td colspan="1" rowspan="1" align="center">J<sub>H</sub>2</td><td colspan="1" rowspan="1" align="char" char=".">97.3</td><td colspan="1" rowspan="1" align="char" char=".">94.3</td><td colspan="1" rowspan="1" align="left"><italic>19-13</italic></td><td colspan="1" rowspan="1" align="left">v&#x003ba;19/28</td><td colspan="1" rowspan="1" align="center">J<sub>k</sub>2</td></tr><tr><td colspan="1" rowspan="1" align="char" char=".">540</td><td colspan="1" rowspan="1" align="char" char=".">91.3</td><td colspan="1" rowspan="1" align="char" char=".">85.9</td><td colspan="1" rowspan="1" align="left"><italic>&#x000a0;J558.2</italic></td><td colspan="1" rowspan="1" align="right">J558</td><td colspan="1" rowspan="1" align="left">D16.2</td><td colspan="1" rowspan="1" align="center">J<sub>H</sub>2</td><td colspan="1" rowspan="1" align="char" char=".">&#x000a0;100</td><td colspan="1" rowspan="1" align="char" char=".">100</td><td colspan="1" rowspan="1" align="left"><italic>21-2</italic></td><td colspan="1" rowspan="1" align="left">v&#x003ba;21</td><td colspan="1" rowspan="1" align="center">J<sub>k</sub>4</td></tr><tr><td colspan="1" rowspan="1" align="char" char=".">593</td><td colspan="1" rowspan="1" align="char" char=".">98.3</td><td colspan="1" rowspan="1" align="char" char=".">96.9</td><td colspan="1" rowspan="1" align="left"><italic>&#x000a0;J558.52</italic></td><td colspan="1" rowspan="1" align="right">J558</td><td colspan="1" rowspan="1" align="left">P2.4/6</td><td colspan="1" rowspan="1" align="center">J<sub>H</sub>4</td><td colspan="1" rowspan="1" align="char" char=".">98.9</td><td colspan="1" rowspan="1" align="char" char=".">96.6</td><td colspan="1" rowspan="1" align="left"><italic>ba9</italic></td><td colspan="1" rowspan="1" align="left">v&#x003ba;9/10</td><td colspan="1" rowspan="1" align="center">J<sub>k</sub>1</td></tr><tr><td colspan="1" rowspan="1" align="char" char=".">600</td><td colspan="1" rowspan="1" align="char" char=".">97.8</td><td colspan="1" rowspan="1" align="char" char=".">96.7</td><td colspan="1" rowspan="1" align="left"><italic>&#x000a0;J558.22</italic></td><td colspan="1" row