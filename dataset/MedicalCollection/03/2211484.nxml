or"><name><surname>Norman</surname><given-names>G</given-names></name><name><surname>Streiner</surname><given-names>D</given-names></name></person-group><source>Biostatistics: The Bare Essentials</source><year>2000</year><publisher-name>Hamilton, Ontario , B.C. Decker</publisher-name></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bland</surname><given-names>M</given-names></name><name><surname>Altman</surname><given-names>D</given-names></name></person-group><article-title>Comparing two methods of clinical measurement: a personal history</article-title><source>Int J Epidemiol</source><year>1995</year><volume>24</volume><fpage>S7</fpage><lpage>S14</lpage><pub-id pub-id-type="pmid">7558556</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Halkett</surname><given-names>GKB</given-names></name><name><surname>Arbon</surname><given-names>P</given-names></name><name><surname>Scutter</surname><given-names>SD</given-names></name><name><surname>Borg</surname><given-names>M</given-names></name></person-group><article-title>The phenomenon of making decisions during the experience of early breast cancer</article-title><source>Eur J Cancer Care</source><year>2007</year><volume>16 </volume><fpage>322</fpage><lpage>330</lpage><pub-id pub-id-type="doi">10.1111/j.1365-2354.2007.00778.x</pub-id></citation></ref></ref-list></back></article>