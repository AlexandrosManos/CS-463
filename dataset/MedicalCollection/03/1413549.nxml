 id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>JA</given-names></name><name><surname>Earis</surname><given-names>A</given-names></name><name><surname>Woodcock</surname><given-names>AA</given-names></name><name><surname>Earis</surname><given-names>JE</given-names></name></person-group><article-title>Acoustic Properties of Spontaneous Coughs in Common Respiratory Diseases [abstract]</article-title><source>Am J Respir Crit Care Med</source><year>2004</year><volume>169</volume><fpage>A200</fpage></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sovijarvi</surname><given-names>AR</given-names></name><name><surname>Dalmasso</surname><given-names>F</given-names></name><name><surname>Vanderschoot</surname><given-names>J</given-names></name><name><surname>Malberg</surname><given-names>LP</given-names></name><name><surname>Righini</surname><given-names>G</given-names></name><name><surname>Stoneman</surname><given-names>SAT</given-names></name></person-group><article-title>Definition of Terms for Applications of Respiratory Sounds</article-title><source>Eur Respir Rev</source><year>2000</year><volume>10</volume><fpage>597</fpage><lpage>610</lpage></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Coope</surname><given-names>R</given-names></name></person-group><source>Diseases of the Chest</source><year>1948</year><edition>2nd</edition><publisher-name> E &#x00026; S Livingstone</publisher-name></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Swartz</surname><given-names>MH</given-names></name></person-group><article-title>History and Examination</article-title><source>Textbook of Physical Examination</source><year>2001</year><edition>4th</edition><publisher-name> Saunders</publisher-name><fpage