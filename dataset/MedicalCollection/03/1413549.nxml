-name> Churchill Livingstone</publisher-name><fpage>118</fpage></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Ogilvie</surname><given-names>C</given-names></name></person-group><source>Chamberlain's Sign's and Symptoms in Clinical Medicine</source><year>1980</year><publisher-name> Wright</publisher-name><fpage>161</fpage></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Everitt</surname><given-names>BS</given-names></name><name><surname>Landau</surname><given-names>S</given-names></name><name><surname>Leese</surname><given-names>M</given-names></name></person-group><source>Cluster Analysis</source><year>2001</year><edition>4th</edition><publisher-name> Hodder Arnold </publisher-name></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chang</surname><given-names>AB</given-names></name><name><surname>Gaffney</surname><given-names>JT</given-names></name><name><surname>Eastburn</surname><given-names>MM</given-names></name><name><surname>Faoagali</surname><given-names>J</given-names></name><name><surname>Cox</surname><given-names>NC</given-names></name><name><surname>Masters</surname><given-names>IB</given-names></name></person-group><article-title>Cough quality in children: a comparison of subjective vs. bronchoscopic findings</article-title><source>Respir Res</source><year>2005</year><volume>6</volume><fpage>3</fpage><pub-id pub-id-type="pmid">15638942</pub-id><pub-id pub-id-type="doi">10.1186/1465-9921-6-3</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Olia</surname><given-names>PM</given-names></name><name><surname>Sestini</surname><given-names>P</given-names></name><name><surname>Vagliasindi</surname><given-names>M</given-names></name></person-group><article-title>Acoustic parameters of voluntary cough in healthy non-smoking subjects</article-title><source>Respirology</source><year>2000</year><volume>5</volume><fpage>271</fpage><pub-id pub-id-type="pmid">11022990</pub-id><pub-id pub-id-type="doi">10.1046/j.1440-1843.2000.00259.x</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ishikawa</surname><given-names>S</given-names></name><name><surname>Kasparian</surname><given-names>R</given-names></name><name><surname>Blanco</surname><given-names>J</given-names></name><name><surname>Sotherland</surname><given-names>D</given-names></name><name><surname>Clubb</surname><given-names>R</given-names></name><name><surname>Kenny</surname><given-names>L</given-names></name><name><surname>Workowicz</surname><given-names>J</given-names></name><name><surname>MacDonnell</surname><given-names>KF</given-names></name></person-group><article-title>Observer variabitlity in interpretation of voluntary cough of 'bronchitics' and 'asthmatics' [abstract]</article-title><source>ILSA Proceedings Paris</source><year>1987</year><volume>10</volume></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Elliott</surname><given-names>MW</given-names></name><name><surname>Adams</surname><given-names>L</given-names></name><name><surname>Cockcroft</surname><given-names>A</given-names></name><name><surname>MacRae</surname><given-names>KD</given-names></name><name><surname>Murphy</surname><given-names>K</given-names></name><name><surname>Guz</surname><given-names>A</given-names></name></person-group><article-title>The language of breathlessness. Use of verbal descriptors by patients with cardiopulmonary disease</article-title><source>Am Rev Respir Dis</source><year>1991</year><volume>144</volume><fpage>826</fpage><pub-id pub-id-type="pmid">1928956</pub-id></citation></ref></ref-list></back></article>