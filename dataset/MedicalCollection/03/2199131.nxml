itation-type="journal"><person-group person-group-type="author"><name><surname>Stafford</surname><given-names>WHL</given-names></name><name><surname>Blackman</surname><given-names>MJ</given-names></name><name><surname>Harris</surname><given-names>A</given-names></name><name><surname>Shai</surname><given-names>S</given-names></name><name><surname>Grainger</surname><given-names>M</given-names></name><name><surname>Holder</surname><given-names>AA</given-names></name></person-group><article-title>N-terminal amino acid sequence of the <italic>Plasmodium falciparum</italic>merozoite surface protein&#x02013;1 (MSP-1) polypeptides</article-title><source>Mol Biochem Parasitol</source><year>1994</year><volume>66</volume><fpage>157</fpage><lpage>160</lpage><pub-id pub-id-type="pmid">7984180</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blackman</surname><given-names>MJ</given-names></name><name><surname>Chappel</surname><given-names>JA</given-names></name><name><surname>Shai</surname><given-names>S</given-names></name><name><surname>Holder</surname><given-names>AA</given-names></name></person-group><article-title>A conserved parasite serine protease processes the <italic>Plasmodium falciparum</italic>merozoite surface protein&#x02013;1 (MSP1)</article-title><source>Mol  Biochem Parasitol</source><year>1993</year><volume>62</volume><fpage>103</fpage><lpage>114</lpage><pub-id pub-id-type="pmid">8114810</pub-id></citation></ref><ref id="B14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>O'Dea</surname><given-names>KP</given-names></name><name><surname>McKean</surname><given-names>PG</given-names></name><name><surname>Harris</surname><given-names>A</given-names></name><name><surname>Brown</surname><given-names>KN</given-names></name></person-group><article-title>Processing of the <italic>Plasmodium chabaudi chabaudi</itali