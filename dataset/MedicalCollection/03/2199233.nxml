d="bib47"><citation citation-type="journal">Thiery, J.P., and D. Chopin. <year>1999</year>. Epithelial cell plasticity in development and tumor progression. <source>Cancer Metastasis Rev.</source> <volume>18</volume>:<fpage>31</fpage>&#x02013;42.<pub-id pub-id-type="pmid">10505544</pub-id></citation></ref><ref id="bib48"><citation citation-type="journal">Traverse, S., K. Seedorf, H. Paterson, C.J. Marshall, P. Cohen, and A. Ullrich. <year>1994</year>. EGF triggers neuronal differentiation of PC12 cell that overexpress the EGF receptor. <source>Curr. Biol.</source> <volume>4</volume>:<fpage>694</fpage>&#x02013;701.<pub-id pub-id-type="pmid">7953555</pub-id></citation></ref><ref id="bib49"><citation citation-type="journal">Webb, C.P., L. Van Aelst, M.H. Wigler, and G.F. Vande Woude. <year>1998</year>. Signaling pathways in Ras-mediated tumorigenicity and metastasis. <source>Proc. Natl. Acad. Sci. USA.</source> <volume>95</volume>:<fpage>8773</fpage>&#x02013;8778.<pub-id pub-id-type="pmid">9671754</pub-id></citation></ref><ref id="bib50"><citation citation-type="journal">Weinstein, M., X. Yang, C. Li, X. Xu, J. Gotay, and C.X. Deng. <year>1998</year>. Failure of egg cylinder elongation and mesoderm induction in mouse embryos lacking the tumor suppressor smad2. <source>Proc. Natl. Acad. Sci. USA.</source> <volume>95</volume>:<fpage>9378</fpage>&#x02013;9383.<pub-id pub-id-type="pmid">9689088</pub-id></citation></ref><ref id="bib51"><citation citation-type="journal">Yang, X., C. Li, X. Xu, and C. Deng. <year>1998</year>. The tumor suppressor SMAD4/DPC4 is essential for epiblast proliferation and mesoderm induction in mice. <source>Proc. Natl. Acad. Sci. USA.</source> <volume>95</volume>:<fpage>3667</fpage>&#x02013;3672.<pub-id pub-id-type="pmid">9520423</pub-id></citation></ref><ref id="bib52"><citation citation-type="journal">Yu, Y., and J.D. Sato. <year>1999</year>. MAP kinases, phosphatidylinositol 3-kinase, and p70 S6 kinase mediate the mitogenic response of human en