></name><name><surname>Melbye</surname><given-names>M</given-names></name><name><surname>Wohlfahrt</surname><given-names>J</given-names></name><name><surname>Sorensen</surname><given-names>TI</given-names></name></person-group><article-title>Growth patterns and the risk of breast cancer in women</article-title><source>N Engl J Med</source><year>2004</year><volume>351</volume><fpage>1619</fpage><lpage>1626</lpage><pub-id pub-id-type="pmid">15483280</pub-id><pub-id pub-id-type="doi">10.1056/NEJMoa040576</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van</surname><given-names>GE</given-names></name><name><surname>Schalken</surname><given-names>JA</given-names></name></person-group><article-title>Morphogenic and tumorigenic potentials of the mammary growth hormone/growth hormone receptor system</article-title><source>Mol Cell Endocrinol</source><year>2002</year><volume>197</volume><fpage>153</fpage><lpage>165</lpage><pub-id pub-id-type="pmid">12431808</pub-id><pub-id pub-id-type="doi">10.1016/S0303-7207(02)00259-9</pub-id></citation></ref></ref-list></back></article>