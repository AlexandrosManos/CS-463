">2118993</pub-id></citation></ref><ref id="CandeandEzzell1986"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cande</surname><given-names>W.Z.</given-names></name><name><surname>Ezzell</surname><given-names>R.M.</given-names></name></person-group><article-title>Evidence for regulation of lamellipodial and tail contraction of glycerinated chicken embryonic fibroblasts by myosin light chain kinase</article-title><source>Cell Motil. Cytoskelet.</source><volume>6</volume><year>1986</year><fpage>640</fpage><lpage>648</lpage></citation></ref><ref id="Carmelietetal1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carmeliet</surname><given-names>P.</given-names></name><name><surname>Schoonjans</surname><given-names>L.</given-names></name><name><surname>Kieckens</surname><given-names>L.</given-names></name><name><surname>Ream</surname><given-names>B.</given-names></name><name><surname>Degan</surname><given-names>J.</given-names></name><name><surname>Bronson</surname><given-names>R.</given-names></name><name><surname>De Vos</surname><given-names>R.</given-names></name><name><surname>van den Oord</surname><given-names>J.J.</given-names></name><name><surname>Collen</surname><given-names>D.</given-names></name><name><surname>Mulligan</surname><given-names>R.C.</given-names></name></person-group><article-title>Physiologic consequences of loss of plasminogen activator gene function in mice</article-title><source>Nature.</source><volume>368</volume><year>1994</year><fpage>419</fpage><lpage>424</lpage><pub-id pub-id-type="pmid">8133887</pub-id></citation></ref><ref id="Catlingetal1995"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Catling</surname><given-names>A.D.</given-names></name><name><surname>Schaeffer</surname><given-names>H.J.</given-names></name><name><surname>Reuter</surname><given-names>C.W.</given-names></name><name><surname>Reddy</surnam