-type="journal"><person-group person-group-type="author"><name><surname>Galai</surname><given-names>N</given-names></name><name><surname>Lepri</surname><given-names>A</given-names></name><name><surname>Viahov</surname><given-names>D</given-names></name><name><surname>Pezzotti</surname><given-names>P</given-names></name><name><surname>Sinicco</surname><given-names>A</given-names></name><etal/></person-group><year>1996</year><article-title>Temporal trends of initial CD4 cells counts following human immunodeficiency virus seroconversion in Italy, 1985-1992. The Human Immunodeficiency Virus Italian Seroconversion Study.</article-title><source>Am J Epidemiol</source><volume>143</volume><fpage>278</fpage><lpage>282</lpage><pub-id pub-id-type="pmid">8561162</pub-id></citation></ref><ref id="pone.0001525-CASCADE1"><label>8</label><citation citation-type="journal"><collab>CASCADE</collab><year>2000</year><article-title>Time from HIV-1 seroconversion to AIDS and death before widespread use of highly-active anti-retroviral therapy: a collaborative re-analysis. Collaborative Group on AIDS Incubation and HIV Survival including the CASCADE EU Concerted Action. Concerted Action on Seroconversion to AIDS and Death in Europe.</article-title><source>Lancet</source><volume>355</volume><fpage>1131</fpage><lpage>1137</lpage><pub-id pub-id-type="pmid">10791375</pub-id></citation></ref><ref id="pone.0001525-CASCADE2"><label>9</label><citation citation-type="journal"><collab>CASCADE</collab><year>2003</year><article-title>Differences in CD4 cell counts at seroconversion and decline among 5739 HIV-1-infected individuals with well-estimated dates of seroconversion.</article-title><source>J Acquir Immune Defic Syndr</source><volume>34</volume><fpage>76</fpage><lpage>83</lpage><pub-id pub-id-type="pmid">14501798</pub-id></citation></ref><ref id="pone.0001525-Mller1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>M&#x000fc;ller</surname><given-names>V</given-names></name><name><surname>Ledergerber</surname><given-names>B</given-names></name><name><surname>Perrin</surname><given-names>L</given-names></name><name><surname>Klimkait</surname><given-names>T</given-names></name><name><surname>Furrer</surname><given-names>H</given-names></name><etal/></person-group><year>2006</year><article-title>Stable virulence levels in the HIV epidemic of Switzerland over two decades.</article-title><source>Aids</source><volume>20</volume><fpage>889</fpage><lpage>894</lpage><pub-id pub-id-type="pmid">16549973</pub-id></citation></ref><ref id="pone.0001525-Keet1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Keet</surname><given-names>IPM</given-names></name><name><surname>Veugelers</surname><given-names>PJ</given-names></name><name><surname>Koot</surname><given-names>M</given-names></name><name><surname>de Weerd</surname><given-names>MH</given-names></name><name><surname>Roos</surname><given-names>MTL</given-names></name><etal/></person-group><year>1996</year><article-title>Temporal trends of the natural history of HIV-1 infection following seroconversion between 1984 and 1993.</article-title><source>AIDS</source><volume>10</volume><fpage>1601</fpage><lpage>1602</lpage><pub-id pub-id-type="pmid">8931802</pub-id></citation></ref><ref id="pone.0001525-Arien1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arien</surname><given-names>KK</given-names></name><name><surname>Vanham</surname><given-names>G</given-names></name><name><surname>Arts</surname><given-names>EJ</given-names></name></person-group><year>2007</year><article-title>Is HIV-1 evolving to a less virulent form in humans?</article-title><source>Nat Rev Microbiol</source><volume>5</volume><fpage>141</fpage><lpage>151</lpage><pub-id pub-id-type="pmid">17203103</pub-id></citation></ref><ref id="pone.0001525-Arien2"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arien</surname><given-names>KK</given-names></name><name><surname>Troyer</surname><given-names>RM</given-names></name><name><surname>Gali</surname><given-names>Y</given-names></name><name><surname>Colebunders</surname><given-names>RL</given-names></name><name><surname>Arts</surname><given-names>EJ</given-names></name><etal/></person-group><year>2005</year><article-title>Replicative fitness of historical and recent HIV-1 isolates suggests HIV-1 attenuation over time.</article-title><source>Aids</source><volume>19</volume><fpage>1555</fpage><lpage>1564</lpage><pub-id pub-id-type="pmid">16184024</pub-id></citation></ref><ref id="pone.0001525-Gali1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gali</surname><given-names>Y</given-names></name><name><surname>Berkhout</surname><given-names>B</given-names></name><name><surname>Vanham</surname><given-names>G</given-names></name><name><surname>Bakker</surname><given-names>M</given-names></name><name><surname>Back</surname><given-names>NK</given-names></name><etal/></person-group><year>2007</year><article-title>Survey of the temporal changes in HIV-1 replicative fitness in the Amsterdam Cohort.</article-title><source>Virology</source><volume>364</volume><fpage>140</fpage><lpage>146</lpage><pub-id pub-id-type="pmid">17395236</pub-id></citation></ref><ref id="pone.0001525-Ewald1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ewald</surname><given-names>P</given-names></name></person-group><year>1994</year><article-title>Evolution of mutation rate and virulence among human retroviruses.</article-title><source>Philos Trans R Soc Lond B Biol Sci</source><volume>346</volume><fpage>333</fpage><lpage>341</lpage><pub-id pub-id-type="pmid">7708828</pub-id></citation></ref><ref id="pone.0001525-Kestens1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kestens</surname><given-names>L</given-names></name><name><surname>Vingerhoets</surname><given-names>J</given-names></name><name><surname>Peeters</surname><given-names>M</given-names></name><name><surname>Vanham</surname><given-names>G</given-names></name><name><surname>Vereecken</surname><given-names>C</given-names></name><etal/></person-group><year>1995</year><article-title>Phenotypic and functional parameters of cellular immunity in a chimpanzee with a naturally acquired simian immunodeficiency virus infection.</article-title><source>J Infect Dis</source><volume>172</volume><fpage>957</fpage><lpage>963</lpage><pub-id pub-id-type="pmid">7561216</pub-id></citation></ref><ref id="pone.0001525-Fultz1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fultz</surname><given-names>P</given-names></name><name><surname>Gordon</surname><given-names>T</given-names></name><name><surname>Anderson</surname><given-names>D</given-names></name><name><surname>McClure</surname><given-names>H</given-names></name></person-group><year>1990</year><article-title>Prevalence of natural infection with simian immunodeficiency virus and simian T-cell leukemia virus type I in a breeding colony of sooty mangabey monkeys.</article-title><source>AIDS</source><volume>4</volume><fpage>619</fpage><lpage>625</lpage><pub-id pub-id-type="pmid">2168716</pub-id></citation></ref><ref id="pone.0001525-Allen1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Allen</surname><given-names>TM</given-names></name><name><surname>Altfeld</surname><given-names>M</given-names></name><name><surname>Yu</surname><given-names>XG</given-names></name><name><surname>O'Sullivan</surname><given-names>KM</given-names></name><name><surname>Lichterfeld</surname><given-names>M</given-names></name><etal/></person-group><year>2004</year><article