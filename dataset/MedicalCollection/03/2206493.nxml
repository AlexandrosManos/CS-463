></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ely</surname><given-names>EW</given-names></name><name><surname>Inouye</surname><given-names>SK</given-names></name><name><surname>Bernard</surname><given-names>GR</given-names></name><name><surname>Gordon</surname><given-names>S</given-names></name><name><surname>Francis</surname><given-names>J</given-names></name><name><surname>May</surname><given-names>L</given-names></name><name><surname>Truman</surname><given-names>B</given-names></name><name><surname>Speroff</surname><given-names>T</given-names></name><name><surname>Gautam</surname><given-names>S</given-names></name><name><surname>Margolin</surname><given-names>R</given-names></name><name><surname>Hart</surname><given-names>RP</given-names></name><name><surname>Dittus</surname><given-names>R</given-names></name></person-group><article-title>Delirium in mechanically ventilated patients: validity and reliability of the confusion assessment method for the intensive care unit (CAM-ICU)</article-title><source>JAMA</source><year>2001</year><volume>286</volume><fpage>2703</fpage><lpage>2710</lpage><pub-id pub-id-type="pmid">11730446</pub-id><pub-id pub-id-type="doi">10.1001/jama.286.21.2703</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sleigh</surname><given-names>JW</given-names></name><name><surname>Andrzejowski</surname><given-names>J</given-names></name><name><surname>Steyn-Ross</surname><given-names>A</given-names></name><name><surname>Steyn-Ross</surname><given-names>M</given-names></name></person-group><article-title>The bispectral index: a measure of depth of sleep?</article-title><source>Anesth Analg</source><year>1999</year><volume>88</volume><fpage>659</fpage><lpage>661</lpage><pub-id pub-id-type="pmid">10072023</pub-id><pub-id pub-id-type="doi">10.1097/00000539-199903000-00035</pub-id></citation></ref><ref id="B10"><