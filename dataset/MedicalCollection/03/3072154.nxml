umilast</td><td align="left" valign="top" rowspan="1" colspan="1">0.000</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">LABA</td><td align="left" valign="top" rowspan="1" colspan="1">0.000</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">LAMA</td><td align="left" valign="top" rowspan="1" colspan="1">0.000</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">ICS</td><td align="left" valign="top" rowspan="1" colspan="1">0.000</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Roflumilast + LABA</td><td align="left" valign="top" rowspan="1" colspan="1">0.000</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Roflumilast + LAMA</td><td align="left" valign="top" rowspan="1" colspan="1">0.000</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Roflumilast + ICS</td><td align="left" valign="top" rowspan="1" colspan="1">0.000</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">LABA + LAMA</td><td align="left" valign="top" rowspan="1" colspan="1">0.000</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">LABA + ICS</td><td align="left" valign="top" rowspan="1" colspan="1">0.000</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">LAMA + ICS</td><td align="left" valign="top" rowspan="1" colspan="1">0.000</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Roflumilast + LABA + LAMA</td><td align="left" valign="top" rowspan="1" colspan="1">0.000</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Roflumilast + LABA + ICS</td><td align="left" valign="top" rowspan="1" colspan="1">0.000</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">LAMA + LABA + ICS</td><td align="left" valign="top" rowspan="1" colspan="1">0.003</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Roflumilast + LABA + LAMA + ICS</td><td align="left" valign="top" rowspan="1" colspan="1">0.997</td></tr></tbody></t