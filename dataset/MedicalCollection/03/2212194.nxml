arteries</article-title><source>J Mol Cell Cardiol</source><year>1997</year><volume>29</volume><fpage>881</fpage><lpage>894</lpage><pub-id pub-id-type="pmid">9152849</pub-id></citation></ref><ref id="B24"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Alon</surname><given-names>R</given-names></name><name><surname>Fuhlbrigge</surname><given-names>RC</given-names></name><name><surname>Finger</surname><given-names>EB</given-names></name><name><surname>Springer</surname><given-names>TA</given-names></name></person-group><article-title>Interactions through L-selectin between leukocytes and adherent leukocytes nucleate rolling adhesions on selectins and VCAM-1 in shear flow</article-title><source>J Cell Biol</source><year>1996</year><volume>135</volume><fpage>849</fpage><lpage>865</lpage><pub-id pub-id-type="pmid">8909556</pub-id></citation></ref></ref-list><fn-group><fn id="FN1"><label>1</label><p><italic>Abbreviations used in this paper:</italic> EC, endothelial cell; FMLP, <italic>N</italic>-formyl-methionyl-leucyl-phenylalanine.</p></fn></fn-group></back></article>