-id></citation></ref><ref id="B11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brocke</surname><given-names>S</given-names></name><name><surname>Gijbels</surname><given-names>K</given-names></name><name><surname>Allegretta</surname><given-names>M</given-names></name><name><surname>Ferber</surname><given-names>I</given-names></name><name><surname>Piercy</surname><given-names>C</given-names></name><name><surname>Blankenstein</surname><given-names>T</given-names></name><name><surname>Martin</surname><given-names>R</given-names></name><name><surname>Utz</surname><given-names>U</given-names></name><name><surname>Karin</surname><given-names>N</given-names></name><name><surname>Mitchell</surname><given-names>D</given-names></name><etal/></person-group><article-title>Treatment of experimental encephalomyelitis with a peptide analogue of myelin basic protein</article-title><source>Nature (Lond)</source><year>1996</year><volume>379</volume><fpage>343</fpage><lpage>346</lpage><pub-id pub-id-type="pmid">8552189</pub-id></citation></ref><ref id="B12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leonard</surname><given-names>JP</given-names></name><name><surname>Waldburger</surname><given-names>KE</given-names></name><name><surname>Goldman</surname><given-names>SJ</given-names></name></person-group><article-title>Prevention of experimental autoimmune encephalitis by antibodies against interleukin 12</article-title><source>J Exp Med</source><year>1995</year><volume>181</volume><fpage>381</fpage><lpage>386</lpage><pub-id pub-id-type="pmid">7528773</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Billiau</surname><given-names>A</given-names></name><name><surname>Heremans</surname><given-names>H</given-names></name><name><surname>Vandekerckhove</surname><given-names>F</given-names></name><name><surname>Dijkmans</surname><given-names>R</given-names></name><name><surname>Sobis</surname><given-names>H</given-names></name><name><surname>Meulepas</surname><given-names>E</given-names></name><name><surname>Carton</surname><given-names>H</given-names></name></person-group><article-title>Enhancement of experimental allergic encephalomyelitis in mice by antibodies against IFN-&#x003b3;</article-title><source>J Immunol</source><year>1988</year><volume>140</volume><fpage>1506</fpage><lpage>1510</lpage><pub-id pub-id-type="pmid">3126227</pub-id></citation></ref><ref id="B14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Steinman</surname><given-names>L</given-names></name></person-group><article-title>A few autoreactive cells in an autoimmune infiltrate control a vast population of nonspecific cells: a tale of smart bombs and the infantry</article-title><source>Proc Natl Acad Sci  USA</source><year>1996</year><volume>93</volume><fpage>2253</fpage><lpage>2256</lpage><pub-id pub-id-type="pmid">8637858</pub-id></citation></ref><ref id="B15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cannella</surname><given-names>B</given-names></name><name><surname>Gao</surname><given-names>YL</given-names></name><name><surname>Brosnan</surname><given-names>C</given-names></name><name><surname>Raine</surname><given-names>CS</given-names></name></person-group><article-title>IL-10 fails to abrogate experimental autoimmune encephalomyelitis</article-title><source>J Neurosci Res</source><year>1996</year><volume>45</volume><fpage>735</fpage><lpage>746</lpage><pub-id pub-id-type="pmid">8892085</pub-id></citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lafaille</surname><given-names>JJ</given-names></name><name><surname>Nagashima</surname><given-names>K</gi