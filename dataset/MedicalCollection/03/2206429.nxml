</article-title><source>J Appl Physiol</source><year>1967</year><volume>23</volume><fpage>215</fpage><lpage>220</lpage><pub-id pub-id-type="pmid">6031191</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Verbrugge</surname><given-names>SJ</given-names></name><name><surname>Bohm</surname><given-names>SH</given-names></name><name><surname>Gommers</surname><given-names>D</given-names></name><name><surname>Zimmerman</surname><given-names>LJ</given-names></name><name><surname>Lachmann</surname><given-names>B</given-names></name></person-group><article-title>Surfactant impairment after mechanical ventilation with large alveolar surface area changes and effects of positive end-expiratory pressure</article-title><source>Br J Anaesth</source><year>1998</year><volume>80</volume><fpage>360</fpage><lpage>364</lpage><pub-id pub-id-type="pmid">9623439</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wyszogrodski</surname><given-names>I</given-names></name><name><surname>Kyei-Aboagye</surname><given-names>K</given-names></name><name><surname>Taeusch</surname><given-names>HW</given-names><suffix>Jr</suffix></name><name><surname>Avery</surname><given-names>ME</given-names></name></person-group><article-title>Surfactant inactivation by hyperventilation: conservation by end-expiratory pressure</article-title><source>J Appl Physiol</source><year>1975</year><volume>38</volume><fpage>461</fpage><lpage>466</lpage><pub-id pub-id-type="pmid">1097385</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Halter</surname><given-names>JM</given-names></name><name><surname>Steinberg</surname><given-names>JM</given-names></name><name><surname>Gatto</surname><given-names>LA</given-names></name><name><surname>Dirocco</surname><given-names>JD</given-names></name><name><