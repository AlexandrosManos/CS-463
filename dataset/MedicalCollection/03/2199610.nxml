focal adhesion kinase</article-title><source>Prog. Biophys. Mol. Biol.</source><volume>71</volume><year>1999</year><fpage>435</fpage><lpage>478</lpage><pub-id pub-id-type="pmid">10354709</pub-id></citation></ref><ref id="Schlessinger2000"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schlessinger</surname><given-names>J.</given-names></name></person-group><article-title>New roles for Src kinases in control of cell survival and angiogenesis</article-title><source>Cell</source><volume>100</volume><year>2000</year><fpage>293</fpage><lpage>296</lpage><pub-id pub-id-type="pmid">10676810</pub-id></citation></ref><ref id="SchwartzandIngber1994"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schwartz</surname><given-names>M.A.</given-names></name><name><surname>Ingber</surname><given-names>D.E.</given-names></name></person-group><article-title>Integrating with integrins</article-title><source>Mol. Biol. Cell</source><volume>5</volume><year>1994</year><fpage>389</fpage><lpage>393</lpage><pub-id pub-id-type="pmid">8054683</pub-id></citation></ref><ref id="Schwartzbergetal1997"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schwartzberg</surname><given-names>P.L.</given-names></name><name><surname>Xing</surname><given-names>L.</given-names></name><name><surname>Hoffmann</surname><given-names>O.</given-names></name><name><surname>Lowell</surname><given-names>C.A.</given-names></name><name><surname>Garrett</surname><given-names>L.</given-names></name><name><surname>Boyce</surname><given-names>B.F.</given-names></name><name><surname>Varmus</surname><given-names>H.E.</given-names></name></person-group><article-title>Rescue of osteoclast function by transgenic expression of kinase-deficient Src in src-/- mutant mice</article-title><source>Genes Devel.</source><volume>11</volume><year>1997</year><fpage>2835</fpage><lpage>2844</lpage><pub-id pub-id-type="p