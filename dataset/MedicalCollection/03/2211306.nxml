td><td align="center">89.8</td><td align="center"><bold>1.54 [1.23&#x02013;1.93]</bold></td><td align="center"><bold>&#x0003c;0.001</bold></td><td></td><td></td><td></td><td></td></tr><tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left"><italic>Windows</italic></td><td></td><td></td><td align="center"><italic>NS</italic></td><td align="center"><italic>0.763</italic></td><td align="center"><italic>NS</italic></td><td align="center"><italic>0.692</italic></td><td align="center"><italic>NS</italic></td><td align="center"><italic>0.422</italic></td></tr><tr><td align="left">None</td><td align="center">402</td><td align="center">16.0</td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left">Open</td><td align="center">2001</td><td align="center">79.8</td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left">Closed</td><td align="center">106</td><td align="center">4.2</td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left"><italic>Foundation</italic></td><td></td><td></td><td align="center"><italic>NS</italic></td><td align="center"><italic>0.815</italic></td><td align="center"><italic>NS</italic></td><td align="center"><italic>0.778</italic></td><td align="center"><italic>NS</italic></td><td align="center"><italic>0.112</italic></td></tr><tr><td align="left">Raised on poles</td><td align="center">22</td><td align="center">0.9</td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left">Built on ground</td><td align="center">2487</td><td align="center">99.1</td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><tr><td align="left"><italic>Kitchen</italic></td><td></td><td></td><td align="center"><italic>NS</italic></td><td align