person-group person-group-type="author"><name><surname>Halluaer</surname><given-names>P.L.</given-names></name><name><surname>Bradshow</surname><given-names>H.L.</given-names></name><name><surname>Hasting</surname><given-names>K.E.M.</given-names></name></person-group><article-title>Complex fiber-type-specific expression of fast skeletal muscle troponin I gene constructs in transgenic mice</article-title><source>Development.</source><volume>119</volume><year>1993</year><fpage>691</fpage><lpage>701</lpage><pub-id pub-id-type="pmid">8187638</pub-id></citation></ref><ref id="Heslopetal2000"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heslop</surname><given-names>L.</given-names></name><name><surname>Morgan</surname><given-names>J.E.</given-names></name><name><surname>Partridge</surname><given-names>T.A.</given-names></name></person-group><article-title>Evidence for a myogenic stem cell that is exhausted in dystrophic muscle</article-title><source>J. Cell Sci</source><volume>113</volume><year>2000</year><fpage>2299</fpage><lpage>2308</lpage><pub-id pub-id-type="pmid">10825301</pub-id></citation></ref><ref id="Hoffmanetal1987"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hoffman</surname><given-names>E.P.</given-names></name><name><surname>Brown</surname><given-names>R.H.</given-names></name><name><surname>Kunkel</surname><given-names>L.M.</given-names></name></person-group><article-title>Dystrophinthe protein product of the Duchenne muscular dystrophy locus</article-title><source>Cell</source><volume>51</volume><year>1987</year><fpage>919</fpage><lpage>928</lpage><pub-id pub-id-type="pmid">3319190</pub-id></citation></ref><ref id="Hoffmanetal1990"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hoffman</surname><given-names>E.P.</given-names></name><name><surname>Morgan</surname><given-names>J.E.</given-names></name><name><surname>Watkins<