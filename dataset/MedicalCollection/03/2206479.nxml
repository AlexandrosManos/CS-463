<lpage>1514</lpage><pub-id pub-id-type="pmid">325407</pub-id></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><collab>The UK Renal Registry</collab></person-group><source>The Seventh Annual Report</source><year>2004</year><publisher-name>Bristol: UK Renal Registry</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.renalreg.com/Report%202004/Cover_Frame.htm"/></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Manhes</surname><given-names>G</given-names></name><name><surname>Heng</surname><given-names>AE</given-names></name><name><surname>Aublet-Cuvelier</surname><given-names>B</given-names></name><name><surname>Gazuy</surname><given-names>N</given-names></name><name><surname>Deteix</surname><given-names>P</given-names></name><name><surname>Souweine</surname><given-names>B</given-names></name></person-group><article-title>Clinical features and outcome of chronic dialysis patients admitted to an intensive care unit</article-title><source>Nephrol Dial Transplant</source><year>2005</year><volume>20</volume><fpage>1127</fpage><lpage>1133</lpage><pub-id pub-id-type="pmid">15769813</pub-id><pub-id pub-id-type="doi">10.1093/ndt/gfh762</pub-id></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Stevens</surname><given-names>P</given-names></name><name><surname>Crowe</surname><given-names>A</given-names></name><name><surname>Lipkin</surname><given-names>G</given-names></name><name><surname>Harrison</surname><given-names>D</given-names></name></person-group><article-title>The changing face of ARF in the intensive care unit: data from the Casemix Programme [abstract]</article-title><source>Proceedings of the XLII ERA-EDTA Congress; 4&#x02013;7 June 2005; Istanbul, Turkey</source><year>2005</year><publisher-name>Parma, Italy: European Renal Association</publisher-name><ext-li