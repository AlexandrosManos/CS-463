name><name><surname>Moore</surname><given-names>KW</given-names></name></person-group><article-title>A receptor for interleukin 10 is related to interferon receptors</article-title><source>Proc Natl Acad Sci USA</source><year>1993</year><volume>90</volume><fpage>11267</fpage><lpage>11271</lpage><pub-id pub-id-type="pmid">8248239</pub-id></citation></ref><ref id="B5"><label>5</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>Y</given-names></name><name><surname>Wei</surname><given-names>SH</given-names></name><name><surname>Ho</surname><given-names>AS</given-names></name><name><surname>de Waal</surname><given-names>R</given-names></name><name><surname>Malefyt</surname></name><name><surname>Moore</surname><given-names>KW</given-names></name></person-group><article-title>Expression cloning and characterization of a human IL-10 receptor</article-title><source>J Immunol</source><year>1994</year><volume>152</volume><fpage>1821</fpage><lpage>1829</lpage><pub-id pub-id-type="pmid">8120391</pub-id></citation></ref><ref id="B6"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Aguet</surname><given-names>M</given-names></name><name><surname>Dembic</surname><given-names>Z</given-names></name><name><surname>Merlin</surname><given-names>G</given-names></name></person-group><article-title>Molecular cloning and expression of the human interferon-gamma receptor</article-title><source>Cell</source><year>1988</year><volume>55</volume><fpage>273</fpage><lpage>280</lpage><pub-id pub-id-type="pmid">2971451</pub-id></citation></ref><ref id="B7"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hemmi</surname><given-names>S</given-names></name><name><surname>B&#x000f6;hni</surname><given-names>R</given-names></name><name><surname>Stark</surname><given-names>G</given-names></name><name><surname>DiMarco</surn