id="t2"><label>Table 2</label><caption><title>Affinities of WT and mutant FIR1&#x0002b;2 to HH27</title></caption><alternatives><table frame="hsides" rules="groups" border="1"><colgroup><col align="left"/><col align="center"/><col align="center"/><col align="center"/><col align="center"/><col align="center"/></colgroup><thead valign="bottom"><tr><th align="left" valign="top" charoff="50">FIR</th><th align="center" valign="top" charoff="50"><italic>r</italic><sub>0</sub></th><th align="center" valign="top" charoff="50"><italic>K</italic><sub>d1</sub></th><th align="center" valign="top" charoff="50"><italic>r</italic><sub>1</sub></th><th align="center" valign="top" charoff="50"><italic>K</italic><sub>d2</sub></th><th align="center" valign="top" charoff="50"><italic>r</italic><sub>2</sub></th></tr></thead><tbody valign="top"><tr><td align="left" valign="top" charoff="50">WT</td><td align="center" valign="top" charoff="50">0.034&#x000b1;0.002</td><td align="center" valign="top" charoff="50">2.3&#x000b1;1.8</td><td align="center" valign="top" charoff="50">0.065&#x000b1;0.012</td><td align="center" valign="top" charoff="50">74&#x000b1;47</td><td align="center" valign="top" charoff="50">0.12&#x000b1;0.01</td></tr><tr><td align="left" valign="top" charoff="50">Y115L</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">81&#x000b1;31</td><td align="center" valign="top" charoff="50"><sup>&#x0002a;</sup></td><td align="center" valign="top" charoff="50">380&#x000b1;110</td><td align="center" valign="top" charoff="50"><sup>&#x0002a;</sup></td></tr><tr><td align="left" valign="top" charoff="50">F157L</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">140&#x000b1;85</td><td align="center" valign="top" charoff="50"><sup>&#x0002a;</sup></td><td align="center" valign="top" charoff="50">490&#x000b1;310</td><td align="center" valign="top" charoff="50"><sup>&#x0002a;</sup></td>