></tr><tr><td align="left" valign="top" charoff="50">&#x02329;<italic>I</italic>&#x0232a;/&#x02329;&#x003c3;&#x0232a; (highest shell)</td><td align="center" valign="top" charoff="50">21.8 (2.26)</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">Completeness, &#x00025; (highest shell)</td><td align="center" valign="top" charoff="50">97.5 (92.2)</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td colspan="4" align="left" valign="top" charoff="50"><italic>Refinement</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Space group</td><td align="center" valign="top" charoff="50">P3<sub>1</sub></td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Unit cell</td><td align="center" valign="top" charoff="50"><italic>a</italic>=<italic>b</italic>=63.135 &#x000c5;, <italic>c</italic>=82.589 &#x000c5;, &#x003b1;=&#x003b2;=90&#x000b0;, &#x003b3;=120&#x000b0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;Resolution (&#x000c5;)</td><td align="center" valign="top" charoff="50">2.1</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;<italic>R</italic><sub>work</sub>/<italic>R</italic><sub>free</sub></td><td align="center" valign="