.0&#x02013;1,015.0</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;NO<sub>2</sub></td><td align="center" rowspan="1" colspan="1">10</td><td align="center" rowspan="1" colspan="1">52.3 &#x000b1; 9.5</td><td align="center" rowspan="1" colspan="1">37.9 &#x02013;65.2</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;O<sub>3</sub></td><td align="center" rowspan="1" colspan="1">10</td><td align="center" rowspan="1" colspan="1">12.4 &#x000b1; 3.3</td><td align="center" rowspan="1" colspan="1">7.1&#x02013;17.5</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Formaldehyde</td><td align="center" rowspan="1" colspan="1">9</td><td align="center" rowspan="1" colspan="1">5.8 &#x000b1; 0.6</td><td align="center" rowspan="1" colspan="1">5.0&#x02013;7.0</td></tr><tr><td colspan="4" align="left" rowspan="1">Indoor/outdoor ratios</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;SO<sub>2</sub></td><td align="center" rowspan="1" colspan="1">34</td><td align="center" rowspan="1" colspan="1">0.38 &#x000b1; 0.17</td><td align="center" rowspan="1" colspan="1">0.11&#x02013;0.76</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;NO<sub>2</sub></td><td align="center" rowspan="1" colspan="1">34</td><td align="center" rowspan="1" colspan="1">0.78 &#x000b1; 0.22</td><td align="center" rowspan="1" colspan="1">0.38&#x02013;1.19</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;O<sub>3</sub></td><td align="center" rowspan="1" colspan="1">34</td><td align="center" rowspan="1" colspan="1">0.91 &#x000b1; 0.93</td><td align="center" rowspan="1" colspan="1">0.18&#x02013;5.1</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Formaldehyde</td><td align="center" rowspan="1" colspan="1">31</td><td align="center" rowspan="1" colspan="1">0.39 &#x000b1; 0.18</td><td align="center" rowspan="1" colspan="1">0.14&#x02013;0.83</td></tr></tbody></table><table-wrap-foot><fn id="tfn4-ehp0116-000090"><label>a</label><p>Number of classrooms and schools with available pollutant measurements.</p></fn></table-wrap-foot></table-wrap><table-wrap id="t3-ehp0116-000090" position="float"><label>Table 3</label><caption><p>Conventional multiple logistic regression on asthmatic symptoms associated with indoor and outdoor air pollutants [OR (95% CI)].<xref ref-type="table-fn" rid="tfn6-ehp0116-000090">a</xref></p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1"/><th align="center" rowspan="1" colspan="1">Cumulative asthma</th><th align="center" rowspan="1" colspan="1">Wheeze or whistling in the chest</th><th align="center" rowspan="1" colspan="1">Daytime attacks of breathlessness</th><th align="center" rowspan="1" colspan="1">Nocturnal attacks of breathlessness</th><th align="center" rowspan="1" colspan="1">Furry pet or pollen allergy</th><th align="center" rowspan="1" colspan="1">Respiratory infection</th></tr></thead><tbody><tr><td colspan="7" align="left" rowspan="1">Indoor</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;SO<sub>2</sub><xref ref-type="table-fn" rid="tfn7-ehp0116-000090">b</xref></td><td align="left" rowspan="1" colspan="1">1.14 (0.85&#x02013;1.54)</td><td align="left" rowspan="1" colspan="1">1.18 (1.03&#x02013;1.35)<xref ref-type="table-fn" rid="tfn11-ehp0116-000090">*</xref></td><td align="left" rowspan="1" colspan="1">1.07 (0.98&#x02013;1.16)</td><td align="left" rowspan="1" colspan="1">1.28 (1.02&#x02013;1.59)<xref ref-type="table-fn" rid="tfn11-ehp0116-000090">*</xref></td><td align="center" rowspan="1" colspan="1">1.12 (0.92&#x02013;1.36)</td><td align="right" rowspan="1" colspan="1">0.94 (0.86&#x02013;1.02)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;NO<sub>2</sub><xref ref-type="table-fn" rid="tfn7-ehp0116-000090">b</xref></td><td align="left" rowspan="1" colspan="1">1.26 (0.80&#x02013;1.98)</td><td align="left" rowspan="1" colspan="1">1.12 (0.91&#x02013;1.39)</td><td align="left" rowspan="1" c