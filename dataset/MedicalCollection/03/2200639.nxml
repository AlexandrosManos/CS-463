lume>66</volume><fpage>119</fpage><lpage>128</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Southwell</surname><given-names>CJ</given-names></name><name><surname>Jarman</surname><given-names>PJ</given-names></name></person-group><article-title>Macropod studies at Wallaby Creek III. The effect of fire on pasture ultilisation by macropodids and cattle</article-title><source>Australian Wildlife Research</source><year>1987</year><volume>14</volume><fpage>117</fpage><lpage>124</lpage><pub-id pub-id-type="doi">10.1071/WR9870117</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bowman</surname><given-names>DM</given-names></name></person-group><article-title>The impact of Aboriginal landscape burning on the Australian biota</article-title><source>New Phytologist</source><year>1998</year><volume>140</volume><fpage>385</fpage><lpage>410</lpage><pub-id pub-id-type="doi">10.1046/j.1469-8137.1998.00289.x</pub-id></citation></ref><ref id="B15"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Denny</surname><given-names>M</given-names></name></person-group><article-title>The red kangaroo and the arid environment</article-title><source>The Kangaroo Keepers</source><year>1985</year><fpage>55</fpage><lpage>57</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Caughley</surname><given-names>G</given-names></name><name><surname>Brown</surname><given-names>B</given-names></name><name><surname>Noble</surname><given-names>J</given-names></name></person-group><article-title>Movement of kangaroos after a fire in mallee woodland</article-title><source>Australian Wildlife Research</source><year>1985</year><volume>12</volume><fpage>349</fpage><lpage>353</lpage><pub-id pub-id-type="doi">10.1071/WR9850349</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Provenza</surname><given-names>FD</given-names></name><name><surname>Villalba</surname><given-names>JJ</given-names></name><name><surname>Dziba</surname><given-names>LE</given-names></name><name><surname>Atwood</surname><given-names>SB</given-names></name><name><surname>Banner</surname><given-names>RE</given-names></name></person-group><article-title>Linking herbivore experience, varied diets, and plant biochemical diversity</article-title><source>Small Ruminant Research</source><year>2003</year><volume>49</volume><fpage>257</fpage><lpage>274</lpage><pub-id pub-id-type="doi">10.1016/S0921-4488(03)00143-3</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rafferty</surname><given-names>C</given-names></name><name><surname>Lamont</surname><given-names>BB</given-names></name><name><surname>Hanley</surname><given-names>ME</given-names></name><name><surname>Robertson</surname><given-names>H</given-names></name></person-group><article-title>Selective feeding by western grey kangaroos on seedlings of Hakea species varying in morphology and chemistry</article-title><source>Plant Ecology</source><year>2004</year><volume>177</volume><fpage>201</fpage><lpage>208</lpage><pub-id pub-id-type="doi">10.1007/s11258-005-2362-0</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wann</surname><given-names>JM</given-names></name><name><surname>Bell</surname><given-names>DT</given-names></name></person-group><article-title>Dietary preferences of the black-gloved wallaby (Macropus irma) and the western grey kangaroo (M. fuliginosus) in Whiteman Park, Perth, Western Australia</article-title><source>Journal of the Royal Society of Western Australia</source><year>1997</year><volume>80</volume><fpage>55</fpage><lpage>62</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dawson</surname><given-names>TJ</given-names></name><name><surname>McTavish</surname><given-names>KJ</given-names></name><name><surname>Munn</surname><given-names>AJ</given-names></name><name><surname>Holloway</surname><given-names>J</given-names></name></person-group><article-title>Water use and the thermoregulatory behaviour of kangaroos in arid regions: insights into the colonisation of arid rangelands in Australia by the Eastern Grey Kangaroo (Macropus giganteus)</article-title><source>Journal Of Comparative Physiology B, Biochemical, Systemic, And Environmental Physiology</source><year>2006</year><volume>176</volume><fpage>45</fpage><lpage>53</lpage><pub-id pub-id-type="pmid">16208512</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parsons</surname><given-names>MH</given-names></name><name><surname>Lamont</surname><given-names>BB</given-names></name><name><surname>Koch</surname><given-names>JM</given-names></name><name><surname>Dods</surname><given-names>K</given-names></name></person-group><article-title>Using multiple indices to disentangle drought, herbivory, and competition effects</article-title><source>Restoration Ecology</source><year>2007</year><volume>15</volume><fpage>250</fpage><lpage>262</lpage><pub-id pub-id-type="doi">10.1111/j.1526-100X.2007.00208.x</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rafferty</surname><given-names>C</given-names></name></person-group><article-title>Selective herbivory by mammals on young plants at two densities</article-title><source>Acta Oecologica</source><year>2006</year><volume>in press</volume></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parsons</surname><given-n