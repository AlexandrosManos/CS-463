rname><given-names>R</given-names></name><name><surname>Jacques</surname><given-names>PF</given-names></name><name><surname>Dinarello</surname><given-names>CA</given-names></name><name><surname>Wilson</surname><given-names>PW</given-names></name><name><surname>Abad</surname><given-names>LW</given-names></name><name><surname>Harris</surname><given-names>T</given-names></name></person-group><article-title>Insulin-like growth factor-1 and interleukin 6 predict sarcopenia in very old community-living men and women: the Framingham Heart Study</article-title><source>J Am Geriatr Soc</source><year>2003</year><volume>51</volume><fpage>1237</fpage><lpage>1243</lpage><pub-id pub-id-type="pmid">12919235</pub-id><pub-id pub-id-type="doi">10.1046/j.1532-5415.2003.51407.x</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bruunsgaard</surname><given-names>H</given-names></name><name><surname>Pedersen</surname><given-names>BK</given-names></name></person-group><article-title>Age-related inflammatory cytokines and disease</article-title><source>Allergy Clin North Am</source><year>2003</year><volume>23</volume><fpage>15</fpage><lpage>39</lpage><pub-id pub-id-type="doi">10.1016/S0889-8561(02)00056-5</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leng</surname><given-names>SX</given-names></name><name><surname>Yang</surname><given-names>H</given-names></name><name><surname>Walston</surname><given-names>JD</given-names></name></person-group><article-title>Decreased cell proliferation and altered cytokine production in frail older adults</article-title><source>Aging Clin Exp Res</source><year>2004</year><volume>16</volume><fpage>249</fpage><lpage>252</lpage><pub-id pub-id-type="pmid">15462470</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Baggiolini</s