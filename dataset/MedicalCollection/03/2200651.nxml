 progress</article-title><source>Circulation</source><year>1993</year><volume>87</volume><fpage>1430</fpage><lpage>1433</lpage><pub-id pub-id-type="pmid">8462174</pub-id></citation></ref><ref id="B12"><citation citation-type="book"><article-title>Report of the working group on arteriosclerosis ofthe national heart, lung, and blood institute</article-title><source>DHEW publication No (NIH)</source><year>1981</year><volume>2</volume><publisher-name>WASHINGTON DC, US government printing office</publisher-name><fpage>82</fpage><lpage>2035</lpage></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Stamler</surname><given-names>J</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Chatterjee K, Cheitlin MP, Karlines J</surname></name></person-group><article-title>Epidemiology, established major risk factors, and the primary prevention of coronary heart disease</article-title><source>Cardiology</source><year>1991</year><volume>2</volume><fpage>1</fpage><pub-id pub-id-type="doi">10.1159/000107167</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Anderson</surname><given-names>KM</given-names></name><name><surname>Wilson</surname><given-names>PWF</given-names></name><name><surname>Odell</surname><given-names>PM</given-names></name><name><surname>Kannel</surname><given-names>WB</given-names></name></person-group><article-title>An updated coronary risk profile: A statement for health professionals</article-title><source>Circulation</source><year>1991</year><volume>83</volume><fpage>356</fpage><pub-id pub-id-type="pmid">1984895</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Braun</surname><given-names>LT</given-names></name><name><surname>Davidson</surname><given-names>MH</given-names></name></person-group><article-t