d="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Craig</surname><given-names>AD</given-names></name></person-group><article-title>How do you feel? Interoception: the sense of the physiological condition of the body</article-title><source>Nat Rev Neurosci</source><year>2002</year><volume>3</volume><fpage>655</fpage><lpage>666</lpage><pub-id pub-id-type="pmid">12154366</pub-id></citation></ref><ref id="B25"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Rolls</surname><given-names>ET</given-names></name></person-group><source>The Brain and Emotion</source><year>1999</year><publisher-name>Oxford: Oxford University Press</publisher-name></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barrett</surname><given-names>L</given-names></name><name><surname>Henzi</surname><given-names>P</given-names></name><name><surname>Dunbar</surname><given-names>R</given-names></name></person-group><article-title>Primate cognition: from 'what now?' to 'what if?'</article-title><source>Trends Cogn Sci</source><year>2003</year><volume>7</volume><fpage>494</fpage><lpage>497</lpage><pub-id pub-id-type="pmid">14585446</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eisenberg</surname><given-names>N</given-names></name></person-group><article-title>Emotion, regulation, and moral development</article-title><source>Annu Rev Psychol</source><year>2000</year><volume>51</volume><fpage>665</fpage><lpage>697</lpage><pub-id pub-id-type="pmid">10751984</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Preston</surname><given-names>SD</given-names></name><name><surname>de Waal</surname><given-names>FB</given-names></name></person-group><article-title>Empathy: Its ultimate and proximate bases</article-title><source>Behav Brain Sci</source><year>2002</year><volume>25</volume><fpage>1</fpage><lpage>20</lpage><comment>discussion 20&#x02013;71</comment><pub-id pub-id-type="pmid">12625087</pub-id></citation></ref><ref id="B29"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Ickes</surname><given-names>W</given-names></name></person-group><source>Empathic Accuracy</source><year>1997</year><publisher-name>New York: The Guilford Press</publisher-name></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Flavell</surname><given-names>JH</given-names></name></person-group><article-title>Cognitive development: children's knowledge about the mind</article-title><source>Annu Rev Psychol</source><year>1999</year><volume>50</volume><fpage>21</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">10074674</pub-id></citation></ref><ref id="B31"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Schulkin</surname><given-names>J</given-names></name></person-group><source>Bodily Sensibility</source><year>2004</year><publisher-name>New York: Oxford University Press</publisher-name></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chartrand</surname><given-names>TL</given-names></name><name><surname>Bargh</surname><given-names>JA</given-names></name></person-group><article-title>The chameleon effect: the perception-behavior link and social interaction</article-title><source>J Pers Soc Psychol</source><year>1999</year><volume>76</volume><fpage>893</fpage><lpage>910</lpage><pub-id pub-id-type="pmid">10402679</pub-id></citation></ref><ref id="B33"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hatfield</surname><given-names>E</given-names></name><name><surname>Cacioppo</surname><given-names>J</given-names></name><name><surname>Rapso