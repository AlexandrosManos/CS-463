page>58</fpage><comment>doi: 10.1186/1471-2334-5-58</comment><pub-id pub-id-type="pmid">16018804</pub-id><pub-id pub-id-type="doi">10.1186/1471-2334-5-58</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sulkowski</surname><given-names>MS</given-names></name></person-group><article-title>Drug-induced liver injury associated with antiretroviral therapy that includes HIV-1 protease inhibitors</article-title><source>Clin Infect Dis</source><year>2004</year><volume>38</volume><fpage>90</fpage><lpage>97</lpage><pub-id pub-id-type="pmid">14679453</pub-id><pub-id pub-id-type="doi">10.1086/381444</pub-id></citation></ref><ref id="B16"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Rockstroh</surname><given-names>JK</given-names></name></person-group><article-title>Management of HIV and hepatitis virus coinfections: New Clinical Data</article-title><ext-link ext-link-type="uri" xlink:href="http://www.medscape.com/viewarticle/520187"/></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wolters</surname><given-names>LM</given-names></name><name><surname>Niesters</surname><given-names>HG</given-names></name><name><surname>de Man</surname><given-names>RA</given-names></name><name><surname>Schalm</surname><given-names>SW</given-names></name></person-group><article-title>Antiviral treatment for human immunodeficiency virus patients co-infected with hepatitis B virus: combined effect for both infections, an obtainable goal?</article-title><source>Antiviral Res</source><year>1999</year><volume>42</volume><fpage>71</fpage><lpage>76</lpage><pub-id pub-id-type="pmid">10333144</pub-id><pub-id pub-id-type="doi">10.1016/S0166-3542(99)00016-9</pub-id></citation></ref></ref-list></back></article>