e></person-group><article-title>Complementary and alternative medicine: the next generation of health promotion?</article-title><source>Health Promot Int</source><year>2003</year><volume>18</volume><fpage>265</fpage><lpage>72</lpage><pub-id pub-id-type="pmid">12920147</pub-id></citation></ref><ref id="B10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Conti</surname><given-names>AA</given-names></name><name><surname>Galanti</surname><given-names>C</given-names></name><name><surname>Gensini</surname><given-names>GF</given-names></name></person-group><article-title>Is evidence based medicine really a craze? A methodological comment from the Italian Centre for Evidence Based Medicine</article-title><source>Ital Heart J Suppl</source><year>2000</year><volume>1</volume><fpage>1192</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">11140289</pub-id></citation></ref><ref id="B11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Owen</surname><given-names>D</given-names></name><name><surname>Lewith</surname><given-names>GT</given-names></name></person-group><article-title>Teaching integrated care: CAM familiarisation courses</article-title><source>Med J Aust</source><year>2004</year><volume>181</volume><fpage>276</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">15347280</pub-id></citation></ref><ref id="B12"><label>12</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Vannacci</surname><given-names>A</given-names></name><name><surname>Giovanardi</surname><given-names>CM</given-names></name><name><surname>Geppetti</surname><given-names>P</given-names></name><name><surname>Mugelli</surname><given-names>A</given-names></name><name><surname>Gensini</surname><given-names>GF</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Giarelli</surname><given-names>G</given-names></name><name><surname>Roberti di Sarsina</surname><given-names>P</given-names></name><name><surname>Silvestrini</surname><given-names>B</given-names></name></person-group><article-title>Modelli di integrazione a livello di didattica universitaria</article-title><source>Le Medicine Non Convenzionali in Italia</source><year>2007</year><publisher-loc>Milano, Italy</publisher-loc><publisher-name>Franco Angeli Sanit&#x000e0;</publisher-name><fpage>205</fpage><lpage>17</lpage></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gensini</surname><given-names>GF</given-names></name><name><surname>Panti</surname><given-names>A</given-names></name><name><surname>Conti</surname><given-names>AA</given-names></name></person-group><article-title>The Florence Medical School Centre for Higher Education and Translational Research in General Practice</article-title><source>Med Educ</source><year>2007</year><volume>41</volume><fpage>504</fpage><pub-id pub-id-type="pmid">17470082</pub-id></citation></ref><ref id="B14"><label>14</label><citation citation-type="other"><comment>Ordine dei Medici Chirurghi e degli Odontoiatri della Provincia di Firenze. Deliberazione n. 45 del 18/4/2000. Linee guida per la presenza dei medici, degli odontoiatri e delle strutture sanitarie sulla rete Internet</comment></citation></ref><ref id="B15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rampes</surname><given-names>H</given-names></name><name><surname>Sharples</surname><given-names>F</given-names></name><name><surname>Fisher</surname><given-names>P</given-names></name></person-group><article-title>Complementary medicine in the medical curriculum</article-title><source>J R Soc Med</source><year>1997</year><volume>90</volume><fpage>357</fpage><pub-id pub-id-type="pmid">9227394</pub-id></citation></ref></ref-list></back></article>