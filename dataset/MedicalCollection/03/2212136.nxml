rname><given-names>SE</given-names></name><name><surname>Naas</surname><given-names>TP</given-names></name><name><surname>DeBerardinis</surname><given-names>RJ</given-names></name><name><surname>Boeke</surname><given-names>JD</given-names></name><etal/></person-group><year>1996</year><article-title>High frequency retrotransposition in cultured mammalian cells.</article-title><source>Cell</source><volume>87</volume><fpage>917</fpage><lpage>927</lpage><pub-id pub-id-type="pmid">8945518</pub-id></citation></ref><ref id="pone.0001547-Kolosha1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kolosha</surname><given-names>VO</given-names></name><name><surname>Martin</surname><given-names>SL</given-names></name></person-group><year>1997</year><article-title>In vitro properties of the first ORF protein from mouse LINE-1 support its role in ribonucleoprotein particle formation during retrotransposition.</article-title><source>Proc Natl Acad Sci U S A</source><volume>94</volume><fpage>10155</fpage><lpage>10160</lpage><pub-id pub-id-type="pmid">9294179</pub-id></citation></ref><ref id="pone.0001547-Cost1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cost</surname><given-names>GJ</given-names></name><name><surname>Feng</surname><given-names>Q</given-names></name><name><surname>Jacquier</surname><given-names>A</given-names></name><name><surname>Boeke</surname><given-names>JD</given-names></name></person-group><year>2002</year><article-title>Human L1 element target-primed reverse transcription in vitro.</article-title><source>Embo J</source><volume>21</volume><fpage>5899</fpage><lpage>5910</lpage><pub-id pub-id-type="pmid">12411507</pub-id></citation></ref><ref id="pone.0001547-Szak1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Szak</surname><given-names>ST</given-names></name><name><surname>Pickeral</surname><given-names>OK</given-names></name><name><surname>Makalowski</surname><given-names>W</given-names></name><name><surname>Boguski</surname><given-names>MS</given-names></name><name><surname>Landsman</surname><given-names>D</given-names></name><etal/></person-group><year>2002</year><article-title>Molecular archeology of L1 insertions in the human genome.</article-title><source>Genome Biol</source><volume>3</volume><fpage>research0052</fpage><pub-id pub-id-type="pmid">12372140</pub-id></citation></ref><ref id="pone.0001547-Jurka1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jurka</surname><given-names>J</given-names></name></person-group><year>1997</year><article-title>Sequence patterns indicate an enzymatic involvement in integration of mammalian retroposons.</article-title><source>Proc Natl Acad Sci U S A</source><volume>94</volume><fpage>1872</fpage><lpage>1877</lpage><pub-id pub-id-type="pmid">9050872</pub-id></citation></ref><ref id="pone.0001547-Kazazian1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kazazian</surname><given-names>HH</given-names><suffix>Jr</suffix></name><name><surname>Wong</surname><given-names>C</given-names></name><name><surname>Youssoufian</surname><given-names>H</given-names></name><name><surname>Scott</surname><given-names>AF</given-names></name><name><surname>Phillips</surname><given-names>DG</given-names></name><etal/></person-group><year>1988</year><article-title>Haemophilia A resulting from de novo insertion of L1 sequences represents a novel mechanism for mutation in man.</article-title><source>Nature</source><volume>332</volume><fpage>164</fpage><lpage>166</lpage><pub-id pub-id-type="pmid">2831458</pub-id></citation></ref><ref id="pone.0001547-vandenHurk1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van den Hurk</surname><given-names>JA</given-names></name><name><surname>Meij</surname><given-names>IC</given-names></name><name><surname>Seleme</surname><given-names>MC</given-names></name><name><surname>Kano</surname><given-names>H</given-names></name><name><surname>Nikopoulos</surname><given-names>K</given-names></name><etal/></person-group><year>2007</year><article-title>L1 retrotransposition can occur early in human embryonic development.</article-title><source>Hum Mol Genet</source><volume>16</volume><fpage>1587</fpage><lpage>1592</lpage><pub-id pub-id-type="pmid">17483097</pub-id></citation></ref><ref id="pone.0001547-Meischl1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meischl</surname><given-names>C</given-names></name><name><surname>Boer</surname><given-names>M</given-names></name><name><surname>Ahlin</surname><given-names>A</given-names></name><name><surname>Roos</surname><given-names>D</given-names></name></person-group><year>2000</year><article-title>A new exon created by intronic insertion of a rearranged LINE-1 element as the cause of chronic granulomatous disease.</article-title><source>Eur J Hum Genet</source><volume>8</volume><fpage>697</fpage><lpage>703</lpage><pub-id pub-id-type="pmid">10980575</pub-id></citation></ref><ref id="pone.0001547-Musova1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Musova</surname><given-names>Z</given-names></name><name><surname>Hedvicakova</surname><given-names>P</given-names></name><name><surname>Mohrmann</surname><given-names>M</given-names></name><name><surname>Tesarova</surname><given-names>M</given-names></name><name><surname>Krepelova</surname><given-names>A</given-names></name><etal/></person-group><year>2006</year><article-title>A novel insertion of a rearranged L1 element in exon 44 of the dystrophin gene: further evidence for possible bias in retroposon integration.</article-title><source>Biochem Biophys Res Commun</sour