roup person-group-type="author"><name><surname>Lunkenheimer</surname><given-names>PP</given-names></name><name><surname>Frank</surname><given-names>I</given-names></name><name><surname>Ising</surname><given-names>H</given-names></name><name><surname>Keller</surname><given-names>H</given-names></name><name><surname>Dickhut</surname><given-names>HH</given-names></name></person-group><article-title>Intrapulmonary gas exchange during simulated apnea due to transtracheal periodic intrathoracic pressure changes [in German]</article-title><source>Anaesthesist</source><year>1973</year><volume>22</volume><fpage>232</fpage><lpage>238</lpage><pub-id pub-id-type="pmid">4721562</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jonson</surname><given-names>B</given-names></name><name><surname>Similowski</surname><given-names>T</given-names></name><name><surname>Levy</surname><given-names>P</given-names></name><name><surname>Viires</surname><given-names>N</given-names></name><name><surname>Pariente</surname><given-names>R</given-names></name></person-group><article-title>Expiratory flushing of airways: a method to reduce deadspace ventilation</article-title><source>Eur Respir J</source><year>1990</year><volume>3</volume><fpage>1202</fpage><lpage>1205</lpage><pub-id pub-id-type="pmid">2128626</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Robertis</surname><given-names>E</given-names></name><name><surname>Sigurdsson</surname><given-names>SE</given-names></name><name><surname>Drefeldt</surname><given-names>B</given-names></name><name><surname>Jonson</surname><given-names>B</given-names></name></person-group><article-title>Aspiration of airway dead space. A new method to enhance CO<sub>2 </sub>elimination</article-title><source>Am J Respir Crit Care Med</source><year>1999</year><volume>159</volume><fpage>728</fpage><lpage>