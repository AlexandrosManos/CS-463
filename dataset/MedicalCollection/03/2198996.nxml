ts</article-title><source>EMBO (Eur  Mol Biol Organ) J</source><year>1986</year><volume>5</volume><fpage>1799</fpage><lpage>1808</lpage><pub-id pub-id-type="pmid">2944745</pub-id></citation></ref><ref id="B4"><label>4</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Van den Elsen</surname><given-names>P</given-names></name><name><surname>Shepley</surname><given-names>B-A</given-names></name><name><surname>Borst</surname><given-names>J</given-names></name><name><surname>Coligan</surname><given-names>JE</given-names></name><name><surname>Markham</surname><given-names>AF</given-names></name><name><surname>Orkin</surname><given-names>S</given-names></name><name><surname>Terhorst</surname><given-names>T</given-names></name></person-group><article-title>Isolation of cDNA clones encoding the 20K T3 glycoprotein of human T-cell receptor complex</article-title><source>Nature (Lond)</source><year>1984</year><volume>312</volume><fpage>413</fpage><lpage>418</lpage><pub-id pub-id-type="pmid">6095101</pub-id></citation></ref><ref id="B5"><label>5</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weissman</surname><given-names>AM</given-names></name><name><surname>Hou</surname><given-names>D</given-names></name><name><surname>Orloff</surname><given-names>DG</given-names></name><name><surname>Modi</surname><given-names>WS</given-names></name><name><surname>Seuanez</surname><given-names>H</given-names></name><name><surname>O'Brian</surname><given-names>SJ</given-names></name><name><surname>Klausner</surname><given-names>RD</given-names></name></person-group><article-title>Molecular cloning and chromosomal localization of the human T-cell receptor &#x003b6; chain: distinction from the molecular CD3 complex</article-title><source>Proc Natl Acad Sci USA</source><year>1988</year><volume>85</volume><fpage>9709</fpage><lpage>9713</lpage><pub-id pub-id-type="pmid">2974162</pub-id></citation></ref