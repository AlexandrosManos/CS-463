lspan="1">SSTS<sub>0</sub></td><td rowspan="1" colspan="1">+0.32<sup>n.s.</sup></td><td rowspan="1" colspan="1">Ice<sub>&#x02212;2</sub></td><td rowspan="1" colspan="1">94</td><td rowspan="1" colspan="1">4.45</td></tr><tr><td rowspan="1" colspan="1"/><td colspan="7" align="left" rowspan="1"><italic>numbers</italic> (<italic>X</italic><sub><italic>t</italic>+1</sub>&#x02212;<italic>X</italic><sub><italic>t</italic></sub>)</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">6</td><td align="char" char="." rowspan="1" colspan="1">1.75<sup>*</sup></td><td rowspan="1" colspan="1">&#x02212;0.82<sup>**</sup></td><td rowspan="1" colspan="1">ln(<italic>N</italic><sub>0</sub>)</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">42</td><td rowspan="1" colspan="1">4.42</td></tr><tr><td rowspan="1" colspan="1">7</td><td align="char" char="." rowspan="1" colspan="1">2.94<sup>**</sup></td><td rowspan="1" colspan="1">&#x02212;0.75<sup>**</sup></td><td rowspan="1" colspan="1">ln(<italic>N</italic><sub>0</sub>)</td><td rowspan="1" colspan="1">&#x02212;0.54<sup>*</sup></td><td rowspan="1" colspan="1">ln(<italic>N</italic><sub>&#x02212;1</sub>)</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">61</td><td rowspan="1" colspan="1">4.90</td></tr><tr><td rowspan="1" colspan="1">8</td><td align="char" char="." rowspan="1" colspan="1">1.44<sup>*</sup></td><td rowspan="1" colspan="1">&#x02212;0.62<sup>*</sup></td><td rowspan="1" colspan="1">ln(<italic>N</italic><sub>&#x02212;1</sub>)</td><td rowspan="1" colspan="1">+1.18<sup>**</sup></td><td rowspan="1" colspan="1">SSTS<sub>0</sub></td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">58</td><td rowspan="1" colspan="1">5.43</td></tr><tr><td rowspan="1" colspan="1">9</td><td align="char" char="." rowspan="1" colspan="1">33.44<sup>**</sup></td><td rowspan="1" colspan="1">&#x02212;0.74<sup>**</sup></td><td rowspan="1" colspan="1">ln(<italic>N</italic><sub>0</sub>)</td><td rowspan="1" colspan="1">&#x02212;0.93<sup>**</sup></td><td rowspan="1" colspan="1">ln(<italic>N</italic><sub>&#x02212;1</sub>)</td><td rowspan="1" colspan="1">+0.51<sup>**</sup></td><td rowspan="1" colspan="1">Ice<sub><italic>&#x02212;</italic>2</sub></td><td rowspan="1" colspan="1">87</td><td rowspan="1" colspan="1">0.00 (26.61)</td></tr><tr><td rowspan="1" colspan="1">10</td><td align="char" char="." rowspan="1" colspan="1">2.54<sup>**</sup></td><td rowspan="1" colspan="1">&#x02212;1.06<sup>**</sup></td><td rowspan="1" colspan="1">ln(<italic>N</italic><sub>&#x02212;1</sub>)</td><td rowspan="1" colspan="1">+2.08<sup>**</sup></td><td rowspan="1" colspan="1">SST<sub>&#x02212;1</sub></td><td rowspan="1" colspan="1">+20.91<sup>**</sup></td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">79</td><td rowspan="1" colspan="1">4.64</td></tr></tbody></table></table-wrap></floats-wrap></article>