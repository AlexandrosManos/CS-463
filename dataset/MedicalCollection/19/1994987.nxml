me><surname>Forscher</surname><given-names>BK</given-names></name></person-group><year>1980</year><article-title>The role of the referee</article-title><source>Scholarly Publishing</source><volume>11</volume><fpage>165</fpage><lpage>169</lpage></citation></ref><ref id="pcbi-0030190-b020"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Commoner</surname><given-names>B</given-names></name></person-group><year>1978</year><article-title>Peering at peer review</article-title><source>Hosp Practice</source><volume>13</volume><fpage>25, 29</fpage></citation></ref><ref id="pcbi-0030190-b021"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Shand</surname><given-names>J</given-names></name></person-group><year>2000</year><source>Arguing well</source><publisher-loc>London</publisher-loc><publisher-name>Routledge</publisher-name></citation></ref><ref id="pcbi-0030190-b022"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ingle</surname><given-names>DJ</given-names></name></person-group><year>1972</year><article-title>Fallacies and errors in the wonderlands of biology, medicine and Lewis Carroll</article-title><source>Perspect Biol Med</source><volume>15</volume><fpage>254</fpage><lpage>281</lpage><pub-id pub-id-type="pmid">4551973</pub-id></citation></ref><ref id="pcbi-0030190-b023"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Glantz</surname><given-names>SA</given-names></name></person-group><year>1997</year><source>Primer of biostatistics. 4th edition</source><publisher-loc>New York</publisher-loc><publisher-name>McGraw-Hill</publisher-name></citation></ref><ref id="pcbi-0030190-b024"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bailar</surname><given-names>JC</given-names></name></person-group><year>1976</year><article-title>Bailar's laws of data analysis</article-title>