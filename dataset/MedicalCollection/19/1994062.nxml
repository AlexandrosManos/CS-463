p-type="author"><name><surname>Langer</surname><given-names>M</given-names></name><name><surname>Gabor</surname><given-names>EM</given-names></name><name><surname>Liebeton</surname><given-names>K</given-names></name><name><surname>Meurer</surname><given-names>G</given-names></name><name><surname>Niehaus</surname><given-names>F</given-names></name><name><surname>Schulze</surname><given-names>R</given-names></name><name><surname>Eck</surname><given-names>J</given-names></name><name><surname>Lorenz</surname><given-names>P</given-names></name></person-group><article-title>Metagenomics: An inexhaustible access to nature's diversity</article-title><source>Biotechnol J</source><year>2006</year><volume>1</volume><fpage>815</fpage><lpage>821</lpage><pub-id pub-id-type="pmid">16897828</pub-id><pub-id pub-id-type="doi">10.1002/biot.200600111</pub-id></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gupta</surname><given-names>MN</given-names></name><collab>Ed</collab></person-group><source>Methods in affinity-based separation of proteins/enzymes</source><year>2002</year><publisher-name>Berlin: Springer-Verlag</publisher-name></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gupta</surname><given-names>MN</given-names></name><collab>Ed</collab></person-group><source>Methods in non-aqueous enzymology</source><year>2000</year><publisher-name>Berlin: Springer-Verlag</publisher-name></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Short</surname><given-names>PL</given-names></name></person-group><article-title>Out of the ivory tower</article-title><source>C&#x00026;EN</source><year>2006</year><volume>84</volume><fpage>15</fpage><lpage>21</lpage></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gupta</surname><given-names>MN</given-names></name><name><surname>Roy</surname><given-names>I</given-names></name></person-group><article-title>Enzymes in organic media: Forms, function and applications</article-title><source>Eur J Biochem</source><year>2004</year><volume>271</volume><fpage>1</fpage><lpage>9</lpage><pub-id pub-id-type="doi">10.1111/j.1432-1033.2004.04163.x</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roy</surname><given-names>I</given-names></name><name><surname>Gupta</surname><given-names>MN</given-names></name></person-group><article-title>Applications of microwaves in biological sciences</article-title><source>Curr Sci</source><year>2003</year><volume>85</volume><fpage>1685</fpage><lpage>1693</lpage></citation></ref></ref-list></back></article>