<label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nobel</surname><given-names>J</given-names></name><name><surname>Baerlocher</surname><given-names>MO</given-names></name><name><surname>Silverberg</surname><given-names>J</given-names></name></person-group><article-title>Management of type 2 diabetes mellitus. Role of thiazolidinediones</article-title><source>Can Fam Physician</source><year>2005</year><volume>51</volume><fpage>683</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15934272</pub-id></element-citation></ref><ref id="b14"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lebovitz</surname><given-names>HE</given-names></name></person-group><article-title>Oral therapies for diabetic hyperglycemia</article-title><source>Endocrinol Metab Clin North Am</source><year>2001</year><volume>30</volume><fpage>909</fpage><lpage>33</lpage><pub-id pub-id-type="pmid">11727405</pub-id></element-citation></ref><ref id="b15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Luna</surname><given-names>B</given-names></name><name><surname>Feinglos</surname><given-names>M</given-names></name></person-group><article-title>Oral agents in the management of type 2 diabetes mellitus</article-title><source>Am Fam Physician</source><year>2001</year><volume>63</volume><fpage>1747</fpage><lpage>56</lpage><pub-id pub-id-type="pmid">11352285</pub-id></element-citation></ref><ref id="b16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wright</surname><given-names>A</given-names></name><name><surname>Burden</surname><given-names>AC</given-names></name><name><surname>Paisley</surname><given-names>RB</given-names></name><etal/></person-group><article-title>Sulfonylurea inadequacy: efficacy of addition of insulin over 6 y