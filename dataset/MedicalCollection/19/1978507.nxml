n_Page"/></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zheng</surname><given-names>W</given-names></name><name><surname>Doniach</surname><given-names>S</given-names></name></person-group><article-title>A comparative study of motor-protein motions by using a simple elastic network model</article-title><source>Proc Natl Acad Sci</source><year>2003</year><volume>100</volume><fpage>13253</fpage><lpage>13258</lpage><pub-id pub-id-type="pmid">14585932</pub-id><pub-id pub-id-type="doi">10.1073/pnas.2235686100</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gerstein</surname><given-names>M</given-names></name><name><surname>Krebs</surname><given-names>W</given-names></name></person-group><article-title>A database of molecular motions</article-title><source>Nucleic Acids Res</source><year>1998</year><volume>26</volume><fpage>4280</fpage><lpage>90</lpage><ext-link ext-link-type="uri" xlink:href="http://www.molmovdb.org/"/><pub-id pub-id-type="pmid">9722650</pub-id><pub-id pub-id-type="doi">10.1093/nar/26.18.4280</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kabsch</surname><given-names>W</given-names></name><name><surname>Sander</surname><given-names>C</given-names></name></person-group><article-title>Dictionary of protein secondary structure: pattern recognition of hydrogen-bonded and geometrical features</article-title><source>Biopolymers</source><year>1983</year><volume>22</volume><fpage>2577</fpage><lpage>2637</lpage><pub-id pub-id-type="pmid">6667333</pub-id><pub-id pub-id-type="doi">10.1002/bip.360221211</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Porollo</surname><given-names>A</given-names></name><name><surname>Meller</surname><given-names>J</given-n