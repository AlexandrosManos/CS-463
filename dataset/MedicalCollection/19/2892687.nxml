me><surname>Barendregt</surname><given-names>WB</given-names></name><name><surname>Tan</surname><given-names>ACITL</given-names></name><name><surname>Rosman</surname><given-names>C</given-names></name></person-group><article-title>Colonoscopic perforations: a review of 30,366 patients</article-title><source><italic>Surgical Endoscopy and Other Interventional Techniques</italic></source><year>2007</year><volume>21</volume><issue>6</issue><fpage>994</fpage><lpage>997</lpage><pub-id pub-id-type="pmid">17453289</pub-id></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Damore</surname><given-names>LJ</given-names><suffix>II</suffix></name><name><surname>Rantis</surname><given-names>PC</given-names></name><name><surname>Vernava</surname><given-names>AM</given-names><suffix>III</suffix></name><name><surname>Longo</surname><given-names>WE</given-names></name></person-group><article-title>Colonoscopic perforations: etiology, diagnosis, and management</article-title><source><italic>Diseases of the Colon and Rectum</italic></source><year>1996</year><volume>39</volume><issue>11</issue><fpage>1308</fpage><lpage>1314</lpage><pub-id pub-id-type="pmid">8918445</pub-id></element-citation></ref><ref id="B12"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ecker</surname><given-names>MD</given-names></name><name><surname>Goldstein</surname><given-names>M</given-names></name><name><surname>Hoexter</surname><given-names>B</given-names></name><name><surname>Hyman</surname><given-names>RA</given-names></name><name><surname>Naidich</surname><given-names>JB</given-names></name><name><surname>Stein</surname><given-names>HL</given-names></name></person-group><article-title>Benign pneumoperitoneum after fiberoptic colonoscopy. A prospective study of 100 patients</article-title><source><italic>Gastroenterology</italic></source><year>1977</year><volume>73</volume><issue>2</issue><fpage>226</fpage><lpage>230</lpage><pub-id pub-id-type="pmid">873121</pub-id></element-citation></ref><ref id="B13"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kavin</surname><given-names>H</given-names></name><name><surname>Sinicrope</surname><given-names>F</given-names></name><name><surname>Esker</surname><given-names>AH</given-names></name></person-group><article-title>Management of perforation of the colon at colonoscopy</article-title><source><italic>American Journal of Gastroenterology</italic></source><year>1992</year><volume>87</volume><issue>2</issue><fpage>161</fpage><lpage>167</lpage><pub-id pub-id-type="pmid">1734693</pub-id></element-citation></ref><ref id="B14"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cobb</surname><given-names>WS</given-names></name><name><surname>Heniford</surname><given-names>BT</given-names></name><name><surname>Sigmon</surname><given-names>LB</given-names></name><name><surname>Hasan</surname><given-names>R</given-names></name><name><surname>Simms</surname><given-names>C</given-names></name><name><surname>Kercher</surname><given-names>KW</given-names></name><name><surname>Matthews</surname><given-names>BD</given-names></name></person-group><article-title>Colonoscopic perforations: incidence, management, and outcomes</article-title><source><italic>American Surgeon</italic></source><year>2004</year><volume>70</volume><issue>9</issue><fpage>750</fpage><lpage>757</lpage><pub-id pub-id-type="pmid">15481289</pub-id></element-citation></ref><ref id="B15"><label>14</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Carlsen</surname><given-names>CU</given-names></name><name><surname>Andreassen</surname><given-names>KH</given-names></name></person-group><article-title>Benign pneumoperitoneum and scrotal emphysema after colonoscopy</article-title><source><italic>Ugeskrift for Laeger</italic></source><year>1992</year><volume>154</volume><issue>25</issue><fpage>1785</fpage><lpage>1786</lpage><pub-id pub-id-type="pmid">1632021</pub-id></element-citation></ref><ref id="B16"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Goerg</surname><given-names>KJ</given-names></name><name><surname>D&#x000fc;ber</surname><given-names>C</given-names></name></person-group><article-title>Retroperitoneal, mediastinal and subcutaneous emphysema with pneumothorax after colonoscopy</article-title><source><italic>Deutsche Medizinische Wochenschrift</italic></source><year>1996</year><volume>121</volume><issue>21</issue><fpage>693</fpage><lpage>696</lpage><pub-id pub-id-type="pmid">8646976</pub-id></element-citation></ref><ref id="B17"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Brynitz</surname><given-names>S</given-names></name><name><surname>Kjaerg&#x000e5;rd</surname><given-names>H</given-names></name><name><surname>Struckmann</surname><given-names>J</given-names></name></person-group><article-title>Perforations from colonoscopy during diagnosis and treatment of polyps</article-title><source><italic>Annales Chirurgiae et Gynaecologiae</italic></source><year>1986</year><volume>75</volume><issue>3</issue><fpage>142</fpage><lpage>145</lpage><pub-id pub-id-type="pmid">3740781</pub-id></element-citation></ref><ref id="B18"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nelson</surname><given-names>RL</given-names></name><name><surname>Abcarian</surname><given-names>H</given-names></name><name><surname>Prasad</surname><given-names>ML</given-names></name></person-group><article-title>Iatrogenic perforation of the colon and rectum</article-title><source><italic>Diseases of the Colon and Rectum</italic></source><year>1982</year><volume>25</volume><issue>4</issue><fpage>305</fpage><lpage>308</lpage><pub-id pub-id-type="pmid">7083975</pub-id></element-citation></ref><ref id="B19"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ghazi</surname><given-names>A</given-names></name><name><surname>Grossmann</surname><given-names>M</given-names></name></person-group><article-title>Complications of colonoscopy and polypectomy</article-title><source><italic>Surgical Clinics of North America</italic></source><year>1982</year><volume>62</volume><issue>5</issue><fpage>889</fpage><lpage>896</lpage><pub-id pub-id-type="pmid">6981859</pub-id></element-citation></ref></ref-list></back><floats-group><fig id="fig1" position="float"><label>Figure 1</label><caption><p>Chest radiography with free intra-abdominal air with elevated left and right hemidiaphragm.</p></caption><graphic xlink:href="CRM2010-631036.001"/></fig><fig id="fig2" position="float"><label>Figure 2</label><caption><p>Abdomen CT with free intra-abdominal air.</p></caption><graphic xlink:href="CRM2010-631036.002"/></fig></floats-group></article>