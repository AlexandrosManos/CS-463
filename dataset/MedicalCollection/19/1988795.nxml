on></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Turner</surname><given-names>M</given-names></name><name><surname>Hodzovic</surname><given-names>I</given-names></name><name><surname>Mapleson</surname><given-names>WW</given-names></name></person-group><article-title>Simulated clinical evaluation of four fluid warming devices*</article-title><source>Anaesthesia</source><year>2006</year><volume>61</volume><fpage>571</fpage><lpage>575</lpage><pub-id pub-id-type="pmid">16704592</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2044.2006.04589.x</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eastlund</surname><given-names>T</given-names></name><name><surname>Van Duren</surname><given-names>A</given-names></name><name><surname>Clay</surname><given-names>ME</given-names></name></person-group><article-title>Effect of heat on stored red cells during non-flow conditions in a blood-warming device</article-title><source>Vox Sang</source><year>1999</year><volume>76</volume><fpage>216</fpage><lpage>219</lpage><pub-id pub-id-type="pmid">10394140</pub-id><pub-id pub-id-type="doi">10.1159/000031054</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chalmers</surname><given-names>C</given-names></name><name><surname>Russell</surname><given-names>WJ</given-names></name></person-group><article-title>When does blood haemolyse? A temperature study</article-title><source>Br J Anaesth</source><year>1974</year><volume>46</volume><fpage>742</fpage><lpage>746</lpage><pub-id pub-id-type="pmid">4621197</pub-id><pub-id pub-id-type="doi">10.1093/bja/46.10.742</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Holzman</surname><given-names>S</given-names></name><name><surname>Connolly</surname><given-names>RJ</given-names></name><name><surname>Schwaitzberg</surname><given-names>SD</given-names></name></person-group><article-title>The effect of in-line microwave energy on blood: a potential modality for blood warming</article-title><source>J Trauma</source><year>1992</year><volume>33</volume><fpage>89</fpage><lpage>93; discussion 93-4</lpage><pub-id pub-id-type="pmid">1635111</pub-id></citation></ref></ref-list></back></article>