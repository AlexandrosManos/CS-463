ncy department</article-title><source>N Engl J Med</source><year>2000</year><volume>342</volume><issue>16</issue><fpage>1163</fpage><lpage>1170</lpage><pub-id pub-id-type="pmid">10770981</pub-id></mixed-citation></ref><ref id="b7-vhrm-6-307"><label>7.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>TH</given-names></name><name><surname>Rouan</surname><given-names>GW</given-names></name><name><surname>Weisberg</surname><given-names>MC</given-names></name><etal/></person-group><article-title>Clinical characteristics and natural history of patients with acute myocardial infarction sent home from the emergency room</article-title><source>Am J Cardiol</source><year>1987</year><volume>60</volume><issue>4</issue><fpage>219</fpage><lpage>224</lpage><pub-id pub-id-type="pmid">3618483</pub-id></mixed-citation></ref><ref id="b8-vhrm-6-307"><label>8.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>McCarthy</surname><given-names>BD</given-names></name><name><surname>Beshansky</surname><given-names>JR</given-names></name><name><surname>D&#x02019;Agostino</surname><given-names>RB</given-names></name><name><surname>Selker</surname><given-names>HP</given-names></name></person-group><article-title>Missed diagnoses of acute myocardial infarction in the emergency department: results from a multicenter study</article-title><source>Ann Emerg Med</source><year>1993</year><volume>22</volume><issue>3</issue><fpage>579</fpage><lpage>582</lpage><pub-id pub-id-type="pmid">8442548</pub-id></mixed-citation></ref><ref id="b9-vhrm-6-307"><label>9.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Tatum</surname><given-names>JL</given-names></name><name><surname>Jesse</surname><given-names>RL</given-names></name><name><surname>Kontos</surname><given-names>MC</given-names></name><etal/></person-group><art