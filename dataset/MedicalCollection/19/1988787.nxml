id pub-id-type="doi">10.1016/0165-1781(89)90047-4</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grandner</surname><given-names>MA</given-names></name><name><surname>Kripke</surname><given-names>DF</given-names></name><name><surname>Yoon</surname><given-names>IY</given-names></name><name><surname>Youngstedt</surname><given-names>SD</given-names></name></person-group><article-title>Criterion validity of the Pittsburgh Sleep Quality Index:  Investigation in a non-clinical sample</article-title><source>Sleep and Biological Rhythms</source><year>2006</year><volume>4</volume><fpage>129</fpage><lpage>136</lpage><pub-id pub-id-type="doi">10.1111/j.1479-8425.2006.00207.x</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jean-Louis</surname><given-names>G</given-names></name><name><surname>Kripke</surname><given-names>DF</given-names></name><name><surname>Cole</surname><given-names>RJ</given-names></name><name><surname>Assmus</surname><given-names>JD</given-names></name><name><surname>Langer</surname><given-names>RD</given-names></name></person-group><article-title>Sleep detection with an accelerometer actigraph:  comparisons with polysomnography</article-title><source>Physiol Behav</source><year>2001</year><volume>72</volume><fpage>21</fpage><lpage>28</lpage><pub-id pub-id-type="pmid">11239977</pub-id><pub-id pub-id-type="doi">10.1016/S0031-9384(00)00355-3</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jean-Louis</surname><given-names>G</given-names></name><name><surname>Kripke</surname><given-names>DF</given-names></name><name><surname>Mason</surname><given-names>WJ</given-names></name><name><surname>Elliott</surname><given-names>JA</given-names></name><name><surname>Youngstedt</surname><given-names>SD</given-names></name></person-gro