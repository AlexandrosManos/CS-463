isher-name><fpage>196</fpage><lpage>210</lpage></citation></ref><ref id="pone.0000998-Thiel1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thiel</surname><given-names>BL</given-names></name><name><surname>Guess</surname><given-names>KB</given-names></name><name><surname>Viney</surname><given-names>C</given-names></name></person-group><year>1997</year><article-title>Non-periodic lattice crystals in the hierarchical microstructure of spider (major ampullate) silk.</article-title><source>Biopolymers</source><volume>41</volume><fpage>703</fpage><lpage>719</lpage><pub-id pub-id-type="pmid">9128438</pub-id></citation></ref><ref id="pone.0000998-Vollrath1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vollrath</surname><given-names>F</given-names></name><name><surname>Knight</surname><given-names>DP</given-names></name></person-group><year>1999</year><article-title>Structure and function of the silk production pathway in the spider Nephila edulis.</article-title><source>Int J Biol Macromol</source><volume>24</volume><fpage>243</fpage><lpage>249</lpage><pub-id pub-id-type="pmid">10342771</pub-id></citation></ref><ref id="pone.0000998-Vollrath2"><label>12</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Vollrath</surname><given-names>F</given-names></name><name><surname>Sponner</surname><given-names>A</given-names></name></person-group><year>2005</year><article-title>The route to synthetic silks.</article-title><person-group person-group-type="editor"><name><surname>Blackburn</surname><given-names>RS</given-names></name></person-group><source>Biodegradable and Sustainable Fibres</source><publisher-loc>Cambridge</publisher-loc><publisher-name>Woodhead</publisher-name><fpage>245</fpage><lpage>270</lpage></citation></ref><ref id="pone.0000998-Parkhe1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parkhe</surname><given-names>AD</given-names></name><name><surname>Seeley</surname><given-names>SK</given-names></name><name><surname>Gardner</surname><given-names>K</given-names></name><name><surname>Thompson</surname><given-names>L</given-names></name><name><surname>Lewis</surname><given-names>RV</given-names></name></person-group><year>1997</year><article-title>Structural studies of spider silk proteins in the fibre.</article-title><source>J Mol Recognit</source><volume>10</volume><fpage>1</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">9179774</pub-id></citation></ref><ref id="pone.0000998-Porter1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Porter</surname><given-names>D</given-names></name><name><surname>Vollrath</surname><given-names>F</given-names></name><name><surname>Shao</surname><given-names>Z</given-names></name></person-group><year>2005</year><article-title>Predicting the mechanical properties of spider silk as a model nanostructured polymer.</article-title><source>Eur Phys J E Soft Matter</source><volume>16</volume><fpage>199</fpage><lpage>206</lpage><comment>Epub 2005 Feb 2022.</comment><pub-id pub-id-type="pmid">15729511</pub-id></citation></ref><ref id="pone.0000998-vanBeek1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van Beek</surname><given-names>JD</given-names></name><name><surname>Hess</surname><given-names>S</given-names></name><name><surname>Vollrath</surname><given-names>F</given-names></name><name><surname>Meier</surname><given-names>BH</given-names></name></person-group><year>2002</year><article-title>The molecular structure of spider dragline silk: folding and orientation of the protein backbone.</article-title><source>Proc Natl Acad Sci U S A</source><volume>99</volume><fpage>10266</fpage><lpage>10271</lpage><pub-id pub-id-type="pmid">12149440</pub-id></citation></r