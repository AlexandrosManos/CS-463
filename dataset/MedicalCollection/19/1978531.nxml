 MAP2 mRNAs.</article-title><source>J Neurosci</source><volume>19</volume><fpage>8818</fpage><lpage>8829</lpage><pub-id pub-id-type="pmid">10516301</pub-id></citation></ref><ref id="pone.0000961-Muslimov2"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Muslimov</surname><given-names>IA</given-names></name><name><surname>Santi</surname><given-names>E</given-names></name><name><surname>Homel</surname><given-names>P</given-names></name><name><surname>Perini</surname><given-names>S</given-names></name><name><surname>Higgins</surname><given-names>D</given-names></name><etal/></person-group><year>1997</year><article-title>RNA transport in dendrites: a cis-acting targeting element is contained within neuronal BC1 RNA.</article-title><source>J Neurosci</source><volume>17</volume><fpage>4722</fpage><lpage>4733</lpage><pub-id pub-id-type="pmid">9169532</pub-id></citation></ref><ref id="pone.0000961-Huang1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>YS</given-names></name><name><surname>Jung</surname><given-names>MY</given-names></name><name><surname>Sarkissian</surname><given-names>M</given-names></name><name><surname>Richter</surname><given-names>JD</given-names></name></person-group><year>2002</year><article-title>N-methyl-D-aspartate receptor signaling results in Aurora kinase-catalyzed CPEB phosphorylation and alpha CaMKII mRNA polyadenylation at synapses.</article-title><source>Embo J</source><volume>21</volume><fpage>2139</fpage><lpage>2148</lpage><pub-id pub-id-type="pmid">11980711</pub-id></citation></ref><ref id="pone.0000961-Cristofanilli1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cristofanilli</surname><given-names>M</given-names></name><name><surname>Iacoangeli</surname><given-names>A</given-names></name><name><surname>Muslimov</surname><given-names>