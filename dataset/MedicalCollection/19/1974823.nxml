l</source><year>2004</year><volume>54</volume><fpage>546</fpage><lpage>560</lpage><pub-id pub-id-type="pmid">15469523</pub-id></citation></ref><ref id="b20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Park</surname><given-names>Y</given-names></name></person-group><article-title>Short fimbriae of <italic>Porphyromonas gingivalis</italic> and their role in coadhesion with <italic>Streptococcus gordonii</italic></article-title><source>Infect Immun</source><year>2005</year><volume>73</volume><fpage>3983</fpage><lpage>3989</lpage><pub-id pub-id-type="pmid">15972485</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Park</surname><given-names>Y</given-names></name></person-group><article-title>Expression of the short fimbriae of <italic>Porphyromonas gingivalis</italic> is regulated in oral bacterial consortia</article-title><source>FEMS Microbiol Lett</source><year>2006</year><volume>262</volume><fpage>65</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">16907740</pub-id></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Socransky</surname><given-names>SS</given-names></name></person-group><article-title>Periodontal microbial ecology</article-title><source>Periodontol 2000</source><year>2005</year><volume>38</volume><fpage>135</fpage><lpage>187</lpage><pub-id pub-id-type="pmid">15853940</pub-id></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stock</surname><given-names>AM</given-names></name></person-group><article-title>Two-component signal transduction</article-title><source>Annu Rev Biochem</source><year>2000</year><volume>69</volume><fpage>183</fpage><lpage>215</lpage><pub-id pub-id-type="pmid">10966457</pub-id></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tokuda</surname><given-names>M</given-names></name></person-group><article-title>Role of <italic>Porphyromonas gingivalis</italic> protease activity in colonization of oral surfaces</article-title><source>Infect Immun</source><year>1996</year><volume>64</volume><fpage>4067</fpage><lpage>4073</lpage><pub-id pub-id-type="pmid">8926070</pub-id></citation></ref><ref id="b25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weinberg</surname><given-names>A</given-names></name></person-group><article-title>Role of fimbriae in <italic>Porphyromonas gingivalis</italic> invasion of gingival epithelial cells</article-title><source>Infect Immun</source><year>1997</year><volume>65</volume><fpage>313</fpage><lpage>316</lpage><pub-id pub-id-type="pmid">8975930</pub-id></citation></ref><ref id="b26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Xie</surname><given-names>H</given-names></name></person-group><article-title>Promoter architecture of the <italic>Porphyromonas gingivalis</italic> fimbrillin gene</article-title><source>Infect Immun</source><year>1999</year><volume>67</volume><fpage>3227</fpage><lpage>3235</lpage><pub-id pub-id-type="pmid">10377095</pub-id></citation></ref><ref id="b27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Xie</surname><given-names>H</given-names></name></person-group><article-title>Environmental regulation of fimbrial gene expression in <italic>Porphyromonas</italic> <italic>gingivalis</italic></article-title><source>Infect Immun</source><year>1997</year><volume>65</volume><fpage>2265</fpage><lpage>2271</lpage><pub-id pub-id-type="pmid">9169762</pub-id></citation></ref><ref id="b28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Xie</surname><given-names>H</given-names></name></person-group><article-title>Regulation of the <italic>Porphyromonas gingivalis</italic> fimA (Fimbrillin) gene</article-title><source>Infect Immun</source><year>2000a</year><volume>68</volume><fpage>6574</fpage><lpage>6579</lpage><pub-id pub-id-type="pmid">11083767</pub-id></citation></ref><ref id="b29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Xie</surname><given-names>H</given-names></name></person-group><article-title>Intergeneric communication in dental plaque biofilms</article-title><source>J Bacteriol</source><year>2000b</year><volume>182</volume><fpage>7067</fpage><lpage>7069</lpage><pub-id pub-id-type="pmid">11092870</pub-id></citation></ref><ref id="b30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Xie</surname><given-names>H</given-names></name></person-group><article-title><italic>Porphyromonas gingivalis</italic> genes involved in fimA regulation</article-title><source>Infect Immun</source><year>2004</year><volume>72</volume><fpage>651</fpage><lpage>658</lpage><pub-id pub-id-type="pmid">14742505</pub-id></citation></ref><ref id="b31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Xie</surname><given-names>H</given-names></name></person-group><article-title>Inhibition of human immunodeficiency virus Type 1 entry by a binding domain of <italic>Porphyromonas gingivalis</italic> gingipain</article-title><source>Antimicrob Agents Chemother</source><year>2006</year><volume>50</volume><fpage>3070</fpage><lpage>3074</lpage><pub-id pub-id-type="pmid">16940103</pub-id></citation></ref></ref-list></back></article>