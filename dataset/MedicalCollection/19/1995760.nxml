><article-title>A monomeric red fluorescent protein.</article-title><source>Proc Natl Acad Sci U S A</source><volume>99</volume><fpage>7877</fpage><lpage>7882</lpage><pub-id pub-id-type="pmid">12060735</pub-id></citation></ref><ref id="pone.0001011-Shaner1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shaner</surname><given-names>NC</given-names></name><name><surname>Campbell</surname><given-names>RE</given-names></name><name><surname>Steinbach</surname><given-names>PA</given-names></name><name><surname>Giepmans</surname><given-names>BN</given-names></name><name><surname>Palmer</surname><given-names>AE</given-names></name><etal/></person-group><year>2004</year><article-title>Improved monomeric red, orange and yellow fluorescent proteins derived from Discosoma sp. red fluorescent protein.</article-title><source>Nat Biotechnol</source><volume>22</volume><fpage>1567</fpage><lpage>1572</lpage><pub-id pub-id-type="pmid">15558047</pub-id></citation></ref><ref id="pone.0001011-AdjoboHermans1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adjobo-Hermans</surname><given-names>MJ</given-names></name><name><surname>Goedhart</surname><given-names>J</given-names></name><name><surname>Gadella</surname><given-names>TW</given-names><suffix>Jr</suffix></name></person-group><year>2006</year><article-title>Plant G protein heterotrimers require dual lipidation motifs of G{alpha} and G{gamma} and do not dissociate upon activation.</article-title><source>J Cell Sci</source><volume>119</volume><fpage>5087</fpage><lpage>5097</lpage><pub-id pub-id-type="pmid">17158913</pub-id></citation></ref><ref id="pone.0001011-Galperin1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Galperin</surname><given-names>E</given-names></name><name><surname>Verkhusha</surname><given-names>VV</given-names></name><name><surname>Sorkin</surname><given-names>A</given-names></name></person-group><year>2004</year><article-title>Three-chromophore FRET microscopy to analyze multiprotein interactions in living cells.</article-title><source>Nat Methods</source><volume>1</volume><fpage>209</fpage><lpage>217</lpage><pub-id pub-id-type="pmid">15782196</pub-id></citation></ref><ref id="pone.0001011-He1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>He</surname><given-names>L</given-names></name><name><surname>Wu</surname><given-names>X</given-names></name><name><surname>Simone</surname><given-names>J</given-names></name><name><surname>Hewgill</surname><given-names>D</given-names></name><name><surname>Lipsky</surname><given-names>PE</given-names></name></person-group><year>2005</year><article-title>Determination of tumor necrosis factor receptor-associated factor trimerization in living cells by CFP-&#x0003e;YFP-&#x0003e;mRFP FRET detected by flow cytometry.</article-title><source>Nucleic Acids Res</source><volume>33</volume><fpage>e61</fpage><pub-id pub-id-type="pmid">15805120</pub-id></citation></ref><ref id="pone.0001011-Wu1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wu</surname><given-names>X</given-names></name><name><surname>Simone</surname><given-names>J</given-names></name><name><surname>Hewgill</surname><given-names>D</given-names></name><name><surname>Siegel</surname><given-names>R</given-names></name><name><surname>Lipsky</surname><given-names>PE</given-names></name><etal/></person-group><year>2006</year><article-title>Measurement of two caspase activities simultaneously in living cells by a novel dual FRET fluorescent indicator probe.</article-title><source>Cytometry A</source><volume>69</volume><fpage>477</fpage><lpage>486</lpage><pub-id pub-id-type="pmid">16683263</pub-id></citation></ref><ref id="pone.0001011-Domingo1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Domingo</surname><given-names>B</given-names></name><name><surname>Sabariegos</surname><given-names>R</given-names></name><name><surname>Picazo</surname><given-names>F</given-names></name><name><surname>Llopis</surname><given-names>J</given-names></name></person-group><year>2007</year><article-title>Imaging FRET standards by steady-state fluorescence and lifetime methods.</article-title><source>Microsc Res Tech</source></citation></ref><ref id="pone.0001011-Koushik1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koushik</surname><given-names>SV</given-names></name><name><surname>Chen</surname><given-names>H</given-names></name><name><surname>Thaler</surname><given-names>C</given-names></name><name><surname>Puhl</surname><given-names>HL</given-names><suffix>3rd</suffix></name><name><surname>Vogel</surname><given-names>SS</given-names></name></person-group><year>2006</year><article-title>Cerulean, Venus, and VenusY67C FRET reference standards.</article-title><source>Biophys J</source><volume>91</volume><fpage>L99</fpage><lpage>L101</lpage><pub-id pub-id-type="pmid">17040988</pub-id></citation></ref><ref id="pone.0001011-vanMunster1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van Munster</surname><given-names>EB</given-names></name><name><surname>Gadella</surname><given-names>TW</given-names></name></person-group><year>2005</year><article-title>Fluorescence lifetime imaging microscopy (FLIM).</article-title><source>Adv Biochem Eng Biotechnol</source><volume>95</volume><fpage>143</fpage><lpage>175</lpage><pub-id pub-id-type="pmid">16080268</pub-id></citation></ref><ref id="pone.0001011-JaresErijman2"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jares-Erijman</surname><given-names>EA</given-names></name><name><surname>Jovin</surna