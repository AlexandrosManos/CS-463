/name></person-group><year>2006</year><article-title>Imaging molecular interactions in living cells by FRET microscopy.</article-title><source>Curr Opin Chem Biol</source><volume>10</volume><fpage>409</fpage><lpage>416</lpage><pub-id pub-id-type="pmid">16949332</pub-id></citation></ref><ref id="pone.0001011-Frster1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>F&#x000f6;rster</surname><given-names>T</given-names></name></person-group><year>1948</year><article-title>Zwischenmolekulare Energiewanderung und Fluorescenz.</article-title><source>Ann Phys</source><volume>2</volume><fpage>55</fpage><lpage>75</lpage></citation></ref><ref id="pone.0001011-Stryer1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stryer</surname><given-names>L</given-names></name></person-group><year>1978</year><article-title>Fluorescence energy transfer as a spectroscopic ruler.</article-title><source>Annu Rev Biochem</source><volume>47</volume><fpage>819</fpage><lpage>846</lpage><pub-id pub-id-type="pmid">354506</pub-id></citation></ref><ref id="pone.0001011-Griesbeck1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Griesbeck</surname><given-names>O</given-names></name><name><surname>Baird</surname><given-names>GS</given-names></name><name><surname>Campbell</surname><given-names>RE</given-names></name><name><surname>Zacharias</surname><given-names>DA</given-names></name><name><surname>Tsien</surname><given-names>RY</given-names></name></person-group><year>2001</year><article-title>Reducing the environmental sensitivity of yellow fluorescent protein. Mechanism and applications.</article-title><source>J Biol Chem</source><volume>276</volume><fpage>29188</fpage><lpage>29194</lpage><pub-id pub-id-type="pmid">11387331</pub-id></citation></ref><ref id="pone.0001011-Kremers1"><label>10</label><citation citation-type="journal