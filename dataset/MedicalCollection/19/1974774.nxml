>54</volume><fpage>64</fpage><lpage>69</lpage><pub-id pub-id-type="pmid">7054219</pub-id></citation></ref><ref id="b7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Baylor</surname><given-names>SM</given-names></name></person-group><article-title>Measurement and interpretation of cytoplasmic [Ca<sup>2+</sup>]i signals from calcium-indicator dyes</article-title><source>News Physiol. Sci.</source><year>2000</year><volume>15</volume><fpage>19</fpage><lpage>26</lpage><pub-id pub-id-type="pmid">11390871</pub-id></citation></ref><ref id="b8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Begley</surname><given-names>JG</given-names></name></person-group><article-title>Altered calcium homeostasis and mitochondrial dysfunction in cortical synaptic compartments of presinilin-1 mutant mice</article-title><source>J. Neurochem.</source><year>1999</year><volume>72</volume><fpage>1030</fpage><lpage>1039</lpage><pub-id pub-id-type="pmid">10037474</pub-id></citation></ref><ref id="b9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Belan</surname><given-names>P</given-names></name></person-group><article-title>Calcium clamp in isolated neurons of the snail <italic>Helix pomatia</italic></article-title><source>J. Physiol. (Lond.)</source><year>1993</year><volume>462</volume><fpage>47</fpage><lpage>58</lpage><pub-id pub-id-type="pmid">8392572</pub-id></citation></ref><ref id="b10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berridge</surname><given-names>MJ</given-names></name></person-group><article-title>Calcium signaling and cell proliferation</article-title><source>Bioessays</source><year>1995</year><volume>17</volume><fpage>491</fpage><lpage>500</lpage><pub-id pub-id-type="pmid">7575490</pub-id></citation></ref><ref id="b11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berridge</surname><given-names>MJ</given-names></name></person-group><article-title>Neuronal calcium signaling</article-title><source>Neuron</source><year>1998</year><volume>21</volume><fpage>13</fpage><lpage>26</lpage><pub-id pub-id-type="pmid">9697848</pub-id></citation></ref><ref id="b12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bevan</surname><given-names>RD</given-names></name></person-group><article-title>Functional and structural changes in the rabbit ear artery after sympathetic denervation</article-title><source>Circ. Res.</source><year>1981</year><volume>48</volume><fpage>478</fpage><lpage>485</lpage><pub-id pub-id-type="pmid">7249283</pub-id></citation></ref><ref id="b13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Blaustein</surname><given-names>MP</given-names></name></person-group><article-title>Sodium/calcium exchange: its physiological implications</article-title><source>Physiol. Rev.</source><year>1999</year><volume>79</volume><fpage>763</fpage><lpage>854</lpage><pub-id pub-id-type="pmid">10390518</pub-id></citation></ref><ref id="b14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bodkin</surname><given-names>NL</given-names></name></person-group><article-title>Mortality and morbidity in laboratory-maintained Rhesus monkeys and effects of long-term dietary restriction</article-title><source>J. Gerontol. A Biol. Sci Med. Sci.</source><year>2003</year><volume>58</volume><fpage>212</fpage><lpage>219</lpage><pub-id pub-id-type="pmid">12634286</pub-id></citation></ref><ref id="b15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Borton</surname><given-names>M</given-names></name></person-group><article-title>The effects of ageing on neuronal uptake of noradrenaline in the rat</article-title><source>Naunyn Schmiedebergs Arch. Pharmacol.</source><year>1989</year><volume>340</volume><fpage>139</fpage><lpage>143</lpage><pub-id pub-id-type="pmid">2812032</pub-id></citation></ref><ref id="b16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buchholz</surname><given-names>J</given-names></name></person-group><article-title>Effect of age on prejunctional modulation of NE release</article-title><source>J. Pharmacol. Exp. Ther.</source><year>1990</year><volume>252</volume><fpage>159</fpage><lpage>164</lpage><pub-id pub-id-type="pmid">2153798</pub-id></citation></ref><ref id="b17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buchholz</surname><given-names>J</given-names></name></person-group><article-title>Age-related changes in the sensitivity of sympathetic nerves to altered extracellular calcium in tail arteries of F-344 rats</article-title><source>Neurobiol. Aging</source><year>1994</year><volume>15</volume><fpage>197</fpage><lpage>201</lpage><pub-id pub-id-type="pmid">7838291</pub-id></citation></ref><ref id="b18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buchholz</surname><given-names>J</given-names></name></person-group><article-title>Impact of age on modulation of norepinephrine release from sympathetic nerves in the rat superior mesentery artery</article-title><source>Life Sci.</source><year>1998</year><volume>62</volume><fpage>679</fpage><lpage>686</lpage><pub-id pub-id-type="pmid">9472727</pub-id></citation></ref><ref id="b19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buchholz</surname><given-names>J</given-names></name></person-group><article-title>Advancing age alters intracellular calcium buffering in rat adrenergic nerves</article-title><source>Neurobiol. Aging</source><year>1996</year><volume>17</volume><fpage>885</fpage><lpage>892</lpage><pub-id pub-id-type="pmid">9363800</pub-id></citation></ref><ref id="b20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buchholz</surname><given-names>J</given-names></name></person-group><article-title>Influence of age on control of norepinephrine release from the rat tail artery</article-title><source>J. Pharmacol. Exp. Ther.</source><year>1992</year><volume>260</volume><fpage>722</fpage><lpage>727</lpage><pub-id pub-id-type="pmid">1346642</pub-id></citation></ref><ref id="b21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cardinali</surname><given-names>DP</given-names></name></person-group><article-title>The sympathetic superior cervical ganglia as peripheral neuroendocrine centers</article-title><source>J. Neural Transm.</source><year>1981</year><volume>52</volume><fpage>1</fpage><lpage>21</lpage><pub-id pub-id-type="pmid">7026734</pub-id></citation></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>PS</given-names></name></person-group><article-title>Sympathetic nerve sprouting, electrical remodeling and the mechanisms of sudden cardiac death</article-title><source>Cardiovasc. Res.</source><year>2001</year><volume>50</volume><fpage>409</fpage><lpage>416</lpage><pub-id pub-id-type="pmid">11334845</pub-id></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Choi</surname><given-names>DW</given-names></name></person-group><article-title>Excitotoxic cell death</article-title><source>J. Neurobiol.</source><year>1992</year><volume>23</volume><fpage>1261</fpage><lpage>1276</lpage><pub-id pub-id-type="pmid">1361523</pub-id></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clancy</surname><given-names>DJ</given-names></name></person-group><article-title>Extension of life-span by loss of CHICO, a drosphila insulin receptor substrate protein</article-title><source>Scienc