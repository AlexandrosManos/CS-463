span="1" colspan="1">47</td><td align="left" rowspan="1" colspan="1">47</td></tr><tr><td align="left" rowspan="1" colspan="1">GALK2</td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">99</td><td align="left" rowspan="1" colspan="1">14</td><td align="left" rowspan="1" colspan="1">13</td><td align="left" rowspan="1" colspan="1">59</td><td align="left" rowspan="1" colspan="1">228</td><td align="left" rowspan="1" colspan="1">50</td><td align="left" rowspan="1" colspan="1">49</td></tr><tr><td align="left" rowspan="1" colspan="1">GFRA1</td><td align="left" rowspan="1" colspan="1">5</td><td align="left" rowspan="1" colspan="1">60</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">105</td><td align="left" rowspan="1" colspan="1">408</td><td align="left" rowspan="1" colspan="1">41</td><td align="left" rowspan="1" colspan="1">39</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">GLYATL1</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">33</td><td align="left" rowspan="1" colspan="1">11</td><td align="left" rowspan="1" colspan="1">11</td><td align="left" rowspan="1" colspan="1">78</td><td align="left" rowspan="1" colspan="1">290</td><td align="left" rowspan="1" colspan="1">46</td><td align="left" rowspan="1" colspan="1">45</td></tr><tr><td align="left" rowspan="1" colspan="1">INHBA</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">22</td><td align="left" rowspan="1" colspan="1">11</td><td align="left" rowspan="1" colspan="1">11</td><td align="left" rowspan="1" colspan="1">19</td><td align="left" rowspan="1" colspan="1">76</td><td align="left" rowspan="1" colspan="1">34</td><td align="left" rowspan="1" colspan="1">34</td></tr><tr><td align="left" rowspan="1" colspan="1">KCNH6</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">33</t