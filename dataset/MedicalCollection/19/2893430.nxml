></element-citation></ref><ref id="CIT8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dorigo-Zetsma</surname><given-names>JW</given-names></name><name><surname>Dankert</surname><given-names>J</given-names></name><name><surname>Zaat</surname><given-names>SA</given-names></name></person-group><article-title>Genotyping of <italic>Mycoplasma pneumoniae</italic> clinical isolates reveals eight P1 subtypes within two genomic groups</article-title><source>J Clin Microbiol</source><year>2000</year><volume>38</volume><fpage>965</fpage><lpage>70</lpage><pub-id pub-id-type="pmid">10698981</pub-id></element-citation></ref><ref id="CIT9"><label>9</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Jacobs</surname><given-names>E</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Razin</surname><given-names>S</given-names></name><name><surname>Herrman</surname><given-names>R</given-names></name></person-group><article-title><italic>Mycoplasma pneumoniae</italic> disease manifestations and epidemiology</article-title><source>Molecular biology and pathogenesis of mycoplasmas</source><year>2002</year><publisher-loc>New York</publisher-loc><publisher-name>Kluwer Academic/Plenum Publishers</publisher-name><fpage>519</fpage><lpage>30</lpage></element-citation></ref><ref id="CIT10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kashyap</surname><given-names>B</given-names></name><name><surname>Kumar</surname><given-names>S</given-names></name><name><surname>Sethi</surname><given-names>GR</given-names></name><name><surname>Das</surname><given-names>BC</given-names></name><name><surname>Saigal</surname><given-names>SR</given-names></name></person-group><article-title>Comparison of PCR, culture and serological tests for the diagnosis of <italic>Mycoplasma pne