ames></name><name><surname>Yamanaka</surname><given-names>A</given-names></name><name><surname>Ichiba</surname><given-names>T</given-names></name><name><surname>Toyokawa</surname><given-names>T</given-names></name><name><surname>Kamada</surname><given-names>Y</given-names></name><name><surname>Tamamura</surname><given-names>T</given-names></name><name><surname>Maruyama</surname><given-names>S</given-names></name></person-group><article-title>Antihypertensive effect of an extract of Passiflora edulis rind in spontaneously hypertensive rats</article-title><source>Biosci Biotechnol Biochem</source><year>2006</year><volume>70</volume><fpage>718</fpage><lpage>721</lpage><pub-id pub-id-type="pmid">16556991</pub-id><pub-id pub-id-type="doi">10.1271/bbb.70.718</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rowe</surname><given-names>CA</given-names></name><name><surname>Nantz</surname><given-names>MP</given-names></name><name><surname>Deniera</surname><given-names>C</given-names></name><name><surname>Green</surname><given-names>K</given-names></name><name><surname>Talcott</surname><given-names>ST</given-names></name><name><surname>Percival</surname><given-names>SS</given-names></name></person-group><article-title>Inhibition of neoplastic transformation of benzo[alpha]pyrene-treated BALB/c 3T3 murine cells by a phytochemical extract of passionfruit juice</article-title><source>J Med Food</source><year>2004</year><volume>7</volume><fpage>402</fpage><lpage>407</lpage><pub-id pub-id-type="pmid">15671681</pub-id><pub-id pub-id-type="doi">10.1089/jmf.2004.7.402</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dhawan</surname><given-names>K</given-names></name><name><surname>Kumar</surname><given-names>S</given-names></name><name><surname>Sharma</surname><given-names>A</given-names></name></person-group><article-title>Eva