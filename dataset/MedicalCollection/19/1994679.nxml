ncy</article-title><source>Neuropsychology</source><year>2000</year><volume>14</volume><fpage>353</fpage><lpage>360</lpage><pub-id pub-id-type="pmid">10928738</pub-id><pub-id pub-id-type="doi">10.1037/0894-4105.14.3.353</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Herrmann</surname><given-names>JM</given-names></name><name><surname>Ehlis</surname><given-names>C-A</given-names></name><name><surname>Scheuerpflug</surname><given-names>P</given-names></name><name><surname>Fallgatter</surname><given-names>JA</given-names></name></person-group><article-title>Optical topography, with near-infrared spectroscopy during a verbal-fluency task</article-title><source>Journal of Psychophysiology</source><year>2005</year><volume>19</volume><fpage>100</fpage><lpage>105</lpage><pub-id pub-id-type="doi">10.1027/0269-8803.19.2.100</pub-id></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gainotti</surname><given-names>G</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Borod J</surname></name></person-group><article-title>Neuropsychological theories of emotion</article-title><source>The Neuropsychology of Emotion</source><year>2000</year><publisher-name>New York: Oxford University Press</publisher-name><fpage>214</fpage><lpage>236</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ochsner</surname><given-names>NK</given-names></name><name><surname>Ray</surname><given-names>DR</given-names></name><name><surname>Cooper</surname><given-names>CJ</given-names></name><name><surname>Robertson</surname><given-names>RE</given-names></name><name><surname>Chopra</surname><given-names>S</given-names></name><name><surname>Gabrieli</surname><given-names>EDJ</given-names></name><name><surname>Gross</surname><given-names>JJ</given-name