"author"><name><surname>Glick</surname><given-names>M</given-names></name><name><surname>Zigler</surname><given-names>E</given-names></name></person-group><article-title>Developmental differences in the symptomatology of psychiatric inpatients with and without mild mental retardation</article-title><source>Am J Ment Retard</source><year>1995</year><volume>99</volume><fpage>407</fpage><lpage>417</lpage><pub-id pub-id-type="pmid">7695882</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moss</surname><given-names>S</given-names></name><name><surname>Prosser</surname><given-names>H</given-names></name><name><surname>Goldberg</surname><given-names>D</given-names></name></person-group><article-title>Validity of the schizophrenia diagnosis of the psychiatric assessment schedule for adults with developmental disability (PAS-ADD)</article-title><source>Br J Psychiatry</source><year>1996</year><volume>168</volume><fpage>359</fpage><lpage>367</lpage><pub-id pub-id-type="pmid">8833693</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hatton</surname><given-names>C</given-names></name><name><surname>Haddock</surname><given-names>G</given-names></name><name><surname>Taylor</surname><given-names>JL</given-names></name><name><surname>Coldwell</surname><given-names>J</given-names></name><name><surname>Crossley</surname><given-names>R</given-names></name><name><surname>Peckham</surname><given-names>N</given-names></name></person-group><article-title>The reliability and validity of general psychotic rating scales with people with mild and moderate intellectual disabilities: an empirical investigation</article-title><source>J Intellect Disabil Res</source><year>2005</year><volume>49</volume><fpage>490</fpage><lpage>500</lpage><pub-id pub-id-type="pmid">15966956</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2788.2005.00696.x</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zimmermann</surname><given-names>G</given-names></name><name><surname>Favrod</surname><given-names>J</given-names></name><name><surname>Trieu</surname><given-names>VH</given-names></name><name><surname>Pomini</surname><given-names>V</given-names></name></person-group><article-title>The effect of cognitive behavioral treatment on the positive symptoms of schizophrenia spectrum disorders: A meta-analysis</article-title><source>Schizophr Res</source><year>2005</year><volume>77</volume><fpage>1</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">16005380</pub-id><pub-id pub-id-type="doi">10.1016/j.schres.2005.02.018</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sturmey</surname><given-names>P</given-names></name></person-group><article-title>Cognitive therapy with people with intellectual disabilities: A selective review and critique.</article-title><source>Clin Psychol Psychother</source><year>2004</year><volume>11</volume><fpage>222</fpage><lpage>232</lpage><pub-id pub-id-type="doi">10.1002/cpp.409</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haddock</surname><given-names>G</given-names></name><name><surname>Lobban</surname><given-names>F</given-names></name><name><surname>Hatton</surname><given-names>C</given-names></name><name><surname>Carson</surname><given-names>R</given-names></name></person-group><article-title>Cognitive-behaviour therapy for people with psychosis and mild intellectual disabilities: a case series.</article-title><source>Clin Psychol Psychother</source><year>2004</year><volume>11</volume><fpage>282</fpage><lpage>298</lpage><pub-id pub-id-type="doi">10.1002/cpp.414</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chadwick</surname><given-names>P</given-names></name><name><surname>Lees</surname><given-names>S</given-names></name><name><surname>Birchwood</surname><given-names>M</given-names></name></person-group><article-title>The revised Beliefs About Voices Questionnaire (BAVQ-R)</article-title><source>Br J Psychiatry</source><year>2000</year><volume>177</volume><fpage>229</fpage><lpage>232</lpage><pub-id pub-id-type="pmid">11040883</pub-id><pub-id pub-id-type="doi">10.1192/bjp.177.3.229</pub-id></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Favrod</surname><given-names>J</given-names></name><name><surname>Scheder</surname><given-names>D</given-names></name></person-group><source>Faire face aux hallucinations auditives : de l'intrusion &#x000e0; l'autonomie</source><year>2003</year><publisher-name>Charleroi , Socrate Editions Promarex</publisher-name></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Peled</surname><given-names>A</given-names></name><name><surname>Ritsner</surname><given-names>M</given-names></name><name><surname>Hirschmann</surname><given-names>S</given-names></name><name><surname>Geva</surname><given-names>AB</given-names></name><name><surname>Modai</surname><given-names>I</given-names></name></person-group><article-title>Touch feel illusion in schizophrenic patients</article-title><source>Biol Psychiatry</source><year>2000</year><volume>48</volume><fpage>1105</fpage><lpage>1108</lpage><pub-id pub-id-type="pmid">11094144</pub-id><pub-id pub-id-type="doi">10.1016/S0006-3223(00)00947-1</pub-id></citation></ref></ref-list></back></article>