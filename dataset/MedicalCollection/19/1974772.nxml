</article-title><source>J Learn Dis</source><year>1993</year><volume>26</volume><fpage>491</fpage><lpage>5</lpage></citation></ref><ref id="b14"><label>14</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Miller</surname><given-names>FG</given-names></name></person-group><source>The Adult SASSI-3 Manual</source><year>1999</year><publisher-loc>Springville, IN</publisher-loc><publisher-name>The SASSI Institute</publisher-name></citation></ref><ref id="b15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Myerholtz</surname><given-names>LE</given-names></name></person-group><article-title>Screening DUI offenders for alcohol problems: psychometric assessment of the Substance Abuse Subtle Screening Inventory</article-title><source>Psychol Addict Behav</source><year>1997</year><volume>11</volume><fpage>155</fpage><lpage>65</lpage></citation></ref></ref-list></back></article>