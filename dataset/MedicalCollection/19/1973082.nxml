pub-id-type="pmid">7729650</pub-id><pub-id pub-id-type="doi">10.1016/0016-5085(95)90708-4</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Uil</surname><given-names>JJ</given-names></name><name><surname>van Elburg</surname><given-names>RM</given-names></name><name><surname>van Overbeek</surname><given-names>FM</given-names></name><name><surname>Mulder</surname><given-names>CJJ</given-names></name><name><surname>van Berge-Henegouwen</surname><given-names>GP</given-names></name><name><surname>Heymans</surname><given-names>HSA</given-names></name></person-group><article-title>Clinical implications of the sugar absorption test: intestinal permeability test to assess mucosal barrier function</article-title><source>Scand J Gastroenterol</source><year>1997</year><volume>32</volume><fpage>70</fpage><lpage>78</lpage><pub-id pub-id-type="pmid">9018770</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meddings</surname><given-names>JB</given-names></name><name><surname>Sutherland</surname><given-names>LR</given-names></name><name><surname>Byles</surname><given-names>NI</given-names></name><name><surname>Wallace</surname><given-names>JL</given-names></name></person-group><article-title>Sucrose: a novel permeability marker for gastroduodenal disease</article-title><source>Gastroenterology</source><year>1993</year><volume>104</volume><fpage>1619</fpage><lpage>1626</lpage><pub-id pub-id-type="pmid">8500718</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Melichar</surname><given-names>B</given-names></name><name><surname>Dvorak</surname><given-names>J</given-names></name><name><surname>Hyspler</surname><given-names>R</given-names></name><name><surname>Zadak</surname><given-names>Z</given-names></name></person-group><article-title>Intestinal permea