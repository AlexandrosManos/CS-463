ext-link></td></tr><tr><td></td><td align="left">Colombia</td><td align="left">H. Hamilton</td><td align="center"><ext-link ext-link-type="gen" xlink:href="DQ288326">DQ288326</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="DQ288341">DQ288341</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="DQ288359">DQ288359</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="DQ288378">DQ288378</ext-link></td><td></td></tr><tr><td align="left"><italic>H. fisheri</italic></td><td align="left">Hawaii</td><td align="left">H. Hamilton</td><td align="center"><ext-link ext-link-type="gen" xlink:href="AY642331">AY642331</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="DQ288350">DQ288350</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="DQ288369">DQ288369</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AY277340">AY277340</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AY277358">AY277358</ext-link></td></tr><tr><td></td><td align="left">Hawaii</td><td align="left">H. Hamilton</td><td align="center"><ext-link ext-link-type="gen" xlink:href="AY642331">AY642331</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="DQ288351">DQ288351</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="DQ288370">DQ288370</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="AY277340">AY277340</ext-link></td><td></td></tr><tr><td align="left"><italic>H. fuscus</italic></td><td align="left">Egypt (Red Sea)</td><td align="left">H. Gabr</td><td align="center"><ext-link ext-link-type="gen" xlink:href="AY642337">AY642337</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="DQ288354">DQ288354</ext-link></td><td align="center"><ext-link ext-link-type="gen" xlink:href="DQ288371">DQ288371</ext-link></td><td align="center"><ext-link ext-link-type="ge