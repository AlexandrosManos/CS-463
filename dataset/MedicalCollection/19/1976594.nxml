></person-group><year>2004</year><article-title>The mitotic serine threonine kinase, Aurora-2, is a potential target for drug development in human pancreatic cancer.</article-title><source>Mol. Cancer Ther</source><volume>3</volume><fpage>451</fpage><lpage>457</lpage><pub-id pub-id-type="pmid">15078988</pub-id></citation></ref><ref id="pone.0000944-Tatsuka1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tatsuka</surname><given-names>M</given-names></name><name><surname>Sato</surname><given-names>S</given-names></name><name><surname>Kitajima</surname><given-names>S</given-names></name><name><surname>Suto</surname><given-names>S</given-names></name><name><surname>Kawai</surname><given-names>H</given-names></name><etal/></person-group><year>2005</year><article-title>Overexpression of Aurora-A potentiates HRAS-mediated oncogenic transformation and is implicated in oral carcinogenesis.</article-title><source>Oncogene</source><volume>24</volume><fpage>1122</fpage><lpage>1127</lpage><pub-id pub-id-type="pmid">15592510</pub-id></citation></ref><ref id="pone.0000944-Tanaka1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tanaka</surname><given-names>T</given-names></name><name><surname>Kimura</surname><given-names>M</given-names></name><name><surname>Matsunaga</surname><given-names>K</given-names></name><name><surname>Fukada</surname><given-names>D</given-names></name><name><surname>Mori</surname><given-names>H</given-names></name><etal/></person-group><year>1999</year><article-title>Centrosomal kinase AIK1 is overexpressed in invasive ductal carcinoma of the breast.</article-title><source>Cancer Res</source><volume>59</volume><fpage>2041</fpage><lpage>2044</lpage><pub-id pub-id-type="pmid">10232583</pub-id></citation></ref><ref id="pone.0000944-Takahashi1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Takahashi</surname><given-names>T</given-names></name><name><surname>Futamura</surname><given-names>M</given-names></name><name><surname>Yoshimi</surname><given-names>N</given-names></name><name><surname>Sano</surname><given-names>J</given-names></name><name><surname>Katada</surname><given-names>M</given-names></name><etal/></person-group><year>2000</year><article-title>Centrosomal kinases, HsAIRK1 and HsAIRK3, are overexpressed in primary colorectal cancers.</article-title><source>Jpn J Cancer Res</source><volume>91</volume><fpage>1007</fpage><lpage>1014</lpage><pub-id pub-id-type="pmid">11050471</pub-id></citation></ref><ref id="pone.0000944-Gritsko1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gritsko</surname><given-names>TM</given-names></name><name><surname>Coppola</surname><given-names>D</given-names></name><name><surname>Paciga</surname><given-names>JE</given-names></name><name><surname>Yang</surname><given-names>L</given-names></name><name><surname>Sun</surname><given-names>M</given-names></name><etal/></person-group><year>2003</year><article-title>Activation and overexpression of centrosome kinase BTAK/Aurora-A in human ovarian cancer.</article-title><source>Clin Cancer Res</source><volume>9</volume><fpage>1420</fpage><lpage>1426</lpage><pub-id pub-id-type="pmid">12684414</pub-id></citation></ref><ref id="pone.0000944-Li1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname><given-names>D</given-names></name><name><surname>Zhu</surname><given-names>J</given-names></name><name><surname>Firozi</surname><given-names>PF</given-names></name><name><surname>Abbruzzese</surname><given-names>JL</given-names></name><name><surname>Evans</surname><given-names>DB</given-names></name><etal/></person-group><year>2003</year><article-title>Overexpression of oncogenic STK15/BTAK/Aurora A kinase in human pancreatic cancer.</article-title><so