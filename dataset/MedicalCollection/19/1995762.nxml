ition="float"><object-id pub-id-type="doi">10.1371/journal.pone.0000975.t002</object-id><label>Table 2</label><caption><title>Association of demographic and life-style characteristics, vascular risk factors, laboratory parameters and medication with EPC-CFUs number (n&#x0200a;&#x0003d;&#x0200a;542)</title></caption><graphic id="pone-0000975-t002-2" xlink:href="pone.0000975.t002"/><table frame="hsides" rules="groups" alternate-form-of="pone-0000975-t002-2"><colgroup span="1"><col align="left" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/></colgroup><thead><tr><td align="left" rowspan="1" colspan="1">C<sc>haracteristic</sc><xref ref-type="table-fn" rid="nt106">&#x0002a;</xref></td><td colspan="3" align="left" rowspan="1"><sc>tertile group for epc number</sc></td><td align="left" rowspan="1" colspan="1">P Value for Trend<xref ref-type="table-fn" rid="nt107">&#x02020;</xref></td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Low EPC colony number (n&#x0200a;&#x0003d;&#x0200a;180)</td><td align="left" rowspan="1" colspan="1">Medium colony number (n&#x0200a;&#x0003d;&#x0200a;181)</td><td align="left" rowspan="1" colspan="1">High colony number (n&#x0200a;&#x0003d;&#x0200a;181)</td><td align="left" rowspan="1" colspan="1"/></tr></thead><tbody><tr><td colspan="5" align="left" rowspan="1"><bold>EPC-CFUs (per 10<sup>6</sup> PBMNC)</bold></td></tr><tr><td align="left" rowspan="1" colspan="1">Median</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">91</td><td align="left" rowspan="1" colspan="1">407</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Range</td><td align="left" rowspan="1" colspan="1">0&#x02013;23</td><td align="left" rowspan="1" colspan="1">24&#x02013;202</td><td align="left" rowspan="1" colspan="1">203&#x02013;1032</td><td align="left" rowspan="1" co