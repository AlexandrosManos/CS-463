nter">100</td><td align="center">5</td><td align="center">[<xref ref-type="bibr" rid="B39">39</xref>]</td></tr><tr><td></td><td align="center">RPM</td><td align="center">9 i.p.</td><td align="center">1&#x02013;28</td><td align="center">28</td><td align="center">0 to &#x0003c;&#x02013;5</td><td align="center">0</td><td align="center">5</td><td></td></tr><tr><td></td><td></td><td align="center">12 i.p.</td><td align="center">14&#x02013;28</td><td align="center">28</td><td align="center">0 to &#x0003c;&#x02013;5</td><td align="center">0</td><td align="center">5</td><td></td></tr><tr><td align="left">Rat</td><td align="center">Control</td><td align="center">-</td><td align="center">0&#x02013;30</td><td align="center">30</td><td align="center">100</td><td align="center">100</td><td align="center">6</td><td align="center">[<xref ref-type="bibr" rid="B26">26</xref>]</td></tr><tr><td></td><td align="center">CsA</td><td align="center">1 s.c.</td><td align="center">0&#x02013;30</td><td align="center">30</td><td align="center">100</td><td align="center">25</td><td align="center">4</td><td></td></tr><tr><td></td><td></td><td align="center">2 s.c.</td><td align="center">0&#x02013;30</td><td align="center">30</td><td align="center">0</td><td align="center">0</td><td align="center">4</td><td></td></tr><tr><td></td><td></td><td align="center">5 s.c.</td><td align="center">0&#x02013;30</td><td align="center">30</td><td align="center">0</td><td align="center">0</td><td align="center">6</td><td></td></tr><tr><td></td><td align="center">DSG</td><td align="center">1 i.p.</td><td align="center">0&#x02013;30</td><td align="center">30</td><td align="center">100</td><td align="center">100</td><td align="center">6</td><td></td></tr><tr><td></td><td align="center">MPM</td><td align="center">2 i.p.</td><td align="center">0&#x02013;30</td><td align="center">30</td><td align="center">50</td><td align="center">50</td><td align="center">4</td><td></td></tr><tr><td></td><td></td><td align="center">20 i.p.</td><td align="center">0&#x02013;30</td><td align="center">30</td><td align="center">100</td><td align="center">100</td><td align="center">6</td><td></td></tr><tr><td></td><td></td><td align="center">40 i.p.<sup>*</sup></td><td align="center">0&#x02013;30</td><td align="center">30</td><td align="center">100</td><td align="center">100</td><td align="center">4</td><td></td></tr><tr><td align="left">Rat</td><td align="center">Control</td><td align="center">-</td><td align="center">0&#x02013;28</td><td align="center">28</td><td align="center">100</td><td></td><td align="center">n.r.</td><td align="center">[<xref ref-type="bibr" rid="B32">32</xref>]</td></tr><tr><td></td><td align="center">CsA</td><td align="center">5</td><td align="center">0&#x02013;28</td><td align="center">28</td><td align="center">0</td><td></td><td></td><td></td></tr><tr><td></td><td align="center">RPM</td><td align="center">6</td><td align="center">0&#x02013;28</td><td align="center">28</td><td align="center">0</td><td></td><td></td><td></td></tr><tr><td></td><td align="center">DSG</td><td align="center">2.5</td><td align="center">0&#x02013;28</td><td align="center">28</td><td align="center">100</td><td></td><td></td><td></td></tr><tr><td></td><td align="center">LFM</td><td align="center">20</td><td align="center">0&#x02013;28</td><td align="center">28</td><td align="center">5</td><td></td><td></td><td></td></tr><tr><td></td><td align="center">MPA</td><td align="center">40</td><td align="center">0&#x02013;28</td><td align="center">28</td><td align="center">30</td><td></td><td></td><td></td></tr><tr><td align="left">Rat</td><td align="center">Control</td><td align="center">-</td><td align="center">0&#x02013;27</td><td align="center">28</td><td align="center">100</td><td align="center">100</td><td align="center">All 5&#x02013;10</td><td align="center">[<xref ref-type="bibr" rid="B34">34</xref>]</td></tr><tr><td></td><td></td><td></td><td align="center">0&#x02013;50</td><td align="center">28</