d="pone.0001025-Allen1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Allen</surname><given-names>FH</given-names></name></person-group><year>2002</year><article-title>The Cambridge Structural Database: a quarter of a million crystal structures and rising.</article-title><source>Acta Crystallogr Sect B: Struct Sci</source><volume>58</volume><fpage>380</fpage><lpage>388</lpage></citation></ref><ref id="pone.0001025-Beusen1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Beusen</surname><given-names>DD</given-names></name><name><surname>Shands</surname><given-names>EFB</given-names></name><name><surname>Karasek</surname><given-names>SF</given-names></name><name><surname>Marshall</surname><given-names>GR</given-names></name><name><surname>Dammkoehler</surname><given-names>RA</given-names></name></person-group><year>1996</year><article-title>Systematic search in conformational analysis.</article-title><source>J Mol Struc (Theochem)</source><volume>370</volume><fpage>157</fpage><lpage>171</lpage></citation></ref><ref id="pone.0001025-Leach1"><label>17</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Leach</surname><given-names>AR</given-names></name></person-group><year>1991</year><article-title>A survey of methods for searching the conformational space of small and medium-sized molecules.</article-title><person-group person-group-type="editor"><name><surname>Lipkowitz</surname><given-names>BK</given-names></name><name><surname>Boyd</surname><given-names>BD</given-names></name></person-group><publisher-name>Reviews in Computational Chemistry: John Wiley &#x00026; Sons, Inc</publisher-name><fpage>1</fpage><lpage>55</lpage></citation></ref><ref id="pone.0001025-Bostrm1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bostr&#x000f6;m</surname><given-nam