me><surname>Nakamura</surname><given-names>T</given-names></name><name><surname>Kawachi</surname><given-names>K</given-names></name><name><surname>Saito</surname><given-names>Y</given-names></name><etal/></person-group><article-title>Effects of ARB or ACE-inhibitor administration on plasma levels of adlosterone and adiponectin in hypertension</article-title><source>Int Heart J</source><year>2009</year><volume>50</volume><fpage>501</fpage><lpage>512</lpage><pub-id pub-id-type="pmid">19609054</pub-id></mixed-citation></ref><ref id="b17-vhrm-6-113"><label>17.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kappert</surname><given-names>K</given-names></name><name><surname>Tsuprykov</surname><given-names>O</given-names></name><name><surname>Kaufmann</surname><given-names>J</given-names></name><etal/></person-group><article-title>Chronic treatment with losartan results in sufficient serum levels of the metabolite EXP3179 for PPAR {gamma} activation</article-title><source>Hypertension</source><year>2009</year><volume>54</volume><fpage>738</fpage><lpage>743</lpage><pub-id pub-id-type="pmid">19687349</pub-id></mixed-citation></ref><ref id="b18-vhrm-6-113"><label>18.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Janke</surname><given-names>J</given-names></name><name><surname>Schupp</surname><given-names>M</given-names></name><name><surname>Engeli</surname><given-names>S</given-names></name><etal/></person-group><article-title>Angiotensin type 1 receptor antagonists induce human in-vitro adipogenesis through peroxisome proliferator-activated receptor-gamma activation</article-title><source>J Hypertens</source><year>2006</year><volume>24</volume><fpage>1809</fpage><lpage>1816</lpage><pub-id pub-id-type="pmid">16915030</pub-id></mixed-citation></ref><ref id="b19-vhrm-6-113"><label>19.</label><mixed-citation publication-type="journal"><person-group person-group-