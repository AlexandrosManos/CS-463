2</year><volume>16</volume><issue>Suppl 2</issue><fpage>S13</fpage><lpage>S16</lpage><pub-id pub-id-type="pmid">11967728</pub-id></mixed-citation></ref><ref id="b7-vhrm-6-113"><label>7.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Burnier</surname><given-names>M</given-names></name><name><surname>Brunner</surname><given-names>HR</given-names></name></person-group><article-title>Angiotensin II receptor antagonists</article-title><source>Lancet</source><year>2000</year><volume>355</volume><fpage>637</fpage><lpage>645</lpage><pub-id pub-id-type="pmid">10696996</pub-id></mixed-citation></ref><ref id="b8-vhrm-6-113"><label>8.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ebner</surname><given-names>T</given-names></name><name><surname>Heinzel</surname><given-names>G</given-names></name><name><surname>Prox</surname><given-names>A</given-names></name><etal/></person-group><article-title>Disposition and chemical stability of telmisartan 1-<italic>O-</italic>acylglucuronide</article-title><source>Drug Metab Dispos</source><year>1999</year><volume>27</volume><fpage>1143</fpage><lpage>1149</lpage><pub-id pub-id-type="pmid">10497140</pub-id></mixed-citation></ref><ref id="b9-vhrm-6-113"><label>9.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Stangier</surname><given-names>J</given-names></name><name><surname>Su</surname><given-names>CAPF</given-names></name><name><surname>van Heiningen</surname><given-names>PNM</given-names></name><etal/></person-group><article-title>Inhibitory effect of telmisartan on the blood pressure response to angiotensin II challenge</article-title><source>J Cardiovasc Pharmacol</source><year>2001</year><volume>38</volume><fpage>672</fpage><lpage>685</lpage><pub-id pub-id-type="pmid">11602814</pub-id></mixed-citation></ref><ref id="b10-vhrm-6-113"><label>10.</label><mixed-cita