00658-199805000-00012</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Taheri</surname><given-names>PA</given-names></name><name><surname>Butz</surname><given-names>AB</given-names></name><name><surname>Watts</surname><given-names>CM</given-names></name><name><surname>Griffes</surname><given-names>LC</given-names></name><name><surname>Greenfield</surname><given-names>LJ</given-names></name></person-group><article-title>Trauma services: A profit center?</article-title><source>J Am Coll Surg</source><year>1999</year><volume>188</volume><fpage>349</fpage><lpage>54</lpage><pub-id pub-id-type="pmid">10195717</pub-id><pub-id pub-id-type="doi">10.1016/S1072-7515(99)00021-6</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Benzaquen</surname><given-names>BS</given-names></name><name><surname>Eisenberg</surname><given-names>MJ</given-names></name><name><surname>Challapalli</surname><given-names>R</given-names></name><name><surname>Nguyen</surname><given-names>T</given-names></name><name><surname>Brown</surname><given-names>KJ</given-names></name><name><surname>Topol</surname><given-names>EJ</given-names></name></person-group><article-title>Correlates of in-hospital cost among patients undergoing abdominal aortic aneurysm repair</article-title><source>Am Heart J</source><year>1998</year><volume>136</volume><fpage>696</fpage><lpage>702</lpage><pub-id pub-id-type="pmid">9778074</pub-id><pub-id pub-id-type="doi">10.1016/S0002-8703(98)70018-3</pub-id></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ellis</surname><given-names>SG</given-names></name><name><surname>Miller</surname><given-names>DP</given-names></name><name><surname>Brown</surname><given-names>KJ</given-names></name><name><surname>Omoigui</surname><given-names>N</given-names></name><name><surname>Howell</surname><given-names>GL</given-names></name><name><surname>Kutner</surname><given-names>M</given-names></name><name><surname>Topol</surname><given-names>EJ</given-names></name></person-group><article-title>In-hospital cost of percutaneous coronary revascularization</article-title><source>Circulation</source><year>1995</year><volume>92</volume><fpage>741</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">7641352</pub-id></citation></ref><ref id="B31"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Drummond</surname><given-names>MF</given-names></name><name><surname>O'Brien</surname><given-names>B</given-names></name><name><surname>Stoddart</surname><given-names>GL</given-names></name><name><surname>Torrance</surname><given-names>GW</given-names></name></person-group><source>Methods for the economic evaluation of health care programmes</source><year>1997</year><edition>2</edition><publisher-name>Oxford: Oxford University Press</publisher-name><fpage>52</fpage><lpage>3</lpage></citation></ref></ref-list></back></article>