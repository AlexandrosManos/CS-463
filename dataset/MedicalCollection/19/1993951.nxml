tion></ref><ref id="b22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rus</surname><given-names>HG</given-names></name><name><surname>Vlaicu</surname><given-names>R</given-names></name><name><surname>Niculescu</surname><given-names>F</given-names></name></person-group><article-title>Interleukin-6 and interleukin-8 protein and gene expression in human arterial atherosclerotic wall</article-title><source>Atherosclerosis</source><year>1996</year><volume>127</volume><fpage>263</fpage><lpage>71</lpage><pub-id pub-id-type="pmid">9125317</pub-id></citation></ref><ref id="b23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Serrano</surname><given-names>CV</given-names><suffix>Jr</suffix></name><name><surname>Ramires</surname><given-names>JAF</given-names></name><name><surname>Venturinelli</surname><given-names>M</given-names></name></person-group><article-title>Coronary angioplasty results in leukocyte and platelet activation with adhesion molecule expression. Evidence of inflammatory responses in coronary angioplasty</article-title><source>J Am Coll Cardiol</source><year>1997</year><volume>29</volume><fpage>1276</fpage><lpage>83</lpage><pub-id pub-id-type="pmid">9137224</pub-id></citation></ref><ref id="b24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shimomura</surname><given-names>H</given-names></name><name><surname>Ogawa</surname><given-names>H</given-names></name><name><surname>Arai</surname><given-names>H</given-names></name><etal/></person-group><article-title>Serial changes in plasma levels of soluble P selectin in patients with acute myocardial infarction</article-title><source>Am J Cardiol</source><year>1998</year><volume>81</volume><fpage>397</fpage><lpage>400</lpage><pub-id pub-id-type="pmid">9485126</pub-id></citation></ref><ref id="b25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Si