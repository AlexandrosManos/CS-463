0</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brunekreef</surname><given-names>B</given-names></name></person-group><article-title>Air pollution and life expectancy: is there a relation?</article-title><source>Occup Environ Med</source><year>1997</year><volume>54</volume><fpage>781</fpage><lpage>784</lpage><pub-id pub-id-type="pmid">9538349</pub-id></citation></ref><ref id="B8"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Mechler</surname><given-names>R</given-names></name><name><surname>Amann</surname><given-names>M</given-names></name><name><surname>Sch&#x000f6;pp</surname><given-names>W</given-names></name></person-group><source>A methodology to estimate changes in statistical life expectancy due to the control of particulate matter air pollution</source><year>2002</year><publisher-name>Laxenburg, Austria , International Institute for Applied System Analysis (IIASA)</publisher-name></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nevalainen</surname><given-names>J</given-names></name><name><surname>Pekkanen</surname><given-names>J</given-names></name></person-group><article-title>The effect of particulate air pollution on life expectancy</article-title><source>Sci Total Environ</source><year>1998</year><volume>217</volume><fpage>137</fpage><lpage>141</lpage><pub-id pub-id-type="pmid">9695177</pub-id><pub-id pub-id-type="doi">10.1016/S0048-9697(98)00172-7</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dockery</surname><given-names>DW</given-names></name><name><surname>Pope</surname><given-names>CA</given-names><suffix>III</suffix></name><name><surname>Xu</surname><given-names>X</given-names></name><name><surname>Spengler</surname><given-names>JD</given-names></name><name><surname>Ware</surname><given-names>JH</given-names></name><name><surname>Fay</surname><given-names>ME</given-names></name><name><surname>Ferris</surname><given-names>BG</given-names><suffix>Jr.</suffix></name><name><surname>Speizer et</surname><given-names/></name></person-group><article-title>An association between air pollution and mortality in six U.S. cities</article-title><source>N Engl J Med</source><year>1993</year><volume>329</volume><fpage>1753</fpage><lpage>1759</lpage><pub-id pub-id-type="pmid">8179653</pub-id><pub-id pub-id-type="doi">10.1056/NEJM199312093292401</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pope</surname><given-names>CA</given-names></name><name><surname>Thun</surname><given-names>MJ</given-names></name><name><surname>Namboodiri</surname><given-names>MM</given-names></name><name><surname>Dockery</surname><given-names>DW</given-names></name><name><surname>Evans</surname><given-names>JS</given-names></name><name><surname>Speizer</surname><given-names>FE</given-names></name><name><surname>Heath</surname><given-names>CW</given-names></name></person-group><article-title>Particulate air-pollution as a predictor of mortality in a prospective-study of US adults</article-title><source>Am J Respir Crit Care Med</source><year>1995</year><volume>151</volume><fpage>669</fpage><lpage>674</lpage><pub-id pub-id-type="pmid">7881654</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rabl</surname><given-names>A</given-names></name></person-group><article-title>Interpretation of air pollution mortality: Number of deaths or years of life lost?</article-title><source>J Air Waste Manag Assoc</source><year>2003</year><volume>53</volume><fpage>41</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">12568252</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leksell</surname><given-names>I</given-names></name><name><surname>Rabl</surname><given-names>A</given-names></name></person-group><article-title>Air pollution and mortality: Quantification and valuation of years of life lost</article-title><source>Risk Anal</source><year>2001</year><volume>21</volume><fpage>843</fpage><lpage>857</lpage><pub-id pub-id-type="pmid">11798121</pub-id><pub-id pub-id-type="doi">10.1111/0272-4332.215156</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coyle</surname><given-names>D</given-names></name><name><surname>Stieb</surname><given-names>D</given-names></name><name><surname>Burnett</surname><given-names>RT</given-names></name><name><surname>DeCivita</surname><given-names>P</given-names></name><name><surname>Krewski</surname><given-names>D</given-names></name><name><surname>Chen</surname><given-names>Y</given-names></name><name><surname>Thun</surname><given-names>MJ</given-names></name></person-group><article-title>Impact of particulate air pollution on quality-adjusted life expectancy in Canada</article-title><source>J Toxicol Environ Health</source><year>2003</year><volume>66</volume><fpage>1847</fpage><lpage>1863</lpage><pub-id pub-id-type="doi">10.1080/15287390306447</pub-id></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Holland</surname><given-names>M</given-names></name><name><surname>Hurley</surname><given-names>F</given-names></name><name><surname>Hunt</surname><given-names>A</given-names></name><name><surname>Watkiss</surname><given-names>P</given-names></name></person-group><source>Methodology Paper (Volume 3) for Service Contract for carrying out cost-benefit analysis of air quality related issues, in particular in the clean air for Europe (CAFE) programme</source><year>2005</year><publisher-name>Didcot, UK , AEA Technology Environment</publisher-name></citation></