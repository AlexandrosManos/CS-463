>16</volume><fpage>323</fpage><lpage>331</lpage><pub-id pub-id-type="pmid">15953975</pub-id><pub-id pub-id-type="doi">10.1007/s10552-004-4323-7</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Palmer</surname><given-names>WL</given-names><suffix>Jr</suffix></name><name><surname>Hatch</surname><given-names>EE</given-names></name><name><surname>Troisi</surname><given-names>R</given-names></name><name><surname>Titus-Ernstoff</surname><given-names>L</given-names></name><name><surname>Strohsnitter</surname><given-names>W</given-names></name><name><surname>Kaufman</surname><given-names>R</given-names></name><name><surname>Herbst</surname><given-names>AL</given-names></name><name><surname>Noller</surname><given-names>KL</given-names></name><name><surname>Hyer</surname><given-names>M</given-names></name><name><surname>Hoover</surname><given-names>RN</given-names></name></person-group><article-title>Prenatal diethylstilbestrol exposure and risk of breast cancer</article-title><source>Cancer Epidemiol Biomarkers Prev</source><year>2006</year><volume>15</volume><fpage>1509</fpage><lpage>1514</lpage><pub-id pub-id-type="pmid">16896041</pub-id><pub-id pub-id-type="doi">10.1158/1055-9965.EPI-06-0109</pub-id></citation></ref></ref-list></back></article>