/publisher-loc><publisher-name>Ashgate Publishing</publisher-name><page-count count="300"/></citation></ref><ref id="pcbi-0030189-b017"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wiback</surname><given-names>S</given-names></name><name><surname>Famili</surname><given-names>I</given-names></name><name><surname>Greenberg</surname><given-names>HJ</given-names></name><name><surname>Palsson</surname><given-names>B&#x000d8;</given-names></name></person-group><year>2004</year><article-title>Monte Carlo sampling can be used to determine the size and shape of the steady-state flux space</article-title><source>J Theor Biol</source><volume>228</volume><fpage>437</fpage><lpage>447</lpage><pub-id pub-id-type="pmid">15178193</pub-id></citation></ref><ref id="pcbi-0030189-b018"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wiback</surname><given-names>S</given-names></name><name><surname>Famili</surname><given-names>I</given-names></name><name><surname>Mahadevan</surname><given-names>R</given-names></name><name><surname>Palsson</surname><given-names>B&#x000d8;</given-names></name></person-group><year>2005</year><article-title>k-Cone analysis: Determining all candidate values for kinetic parameters on a network scale</article-title><source>Biophys J</source><volume>88</volume><fpage>1616</fpage><lpage>1625</lpage><pub-id pub-id-type="pmid">15626710</pub-id></citation></ref><ref id="pcbi-0030189-b019"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bailey</surname><given-names>JE</given-names></name></person-group><year>2001</year><article-title>Complex biology with no parameters</article-title><source>Nat Biotechnol</source><volume>19</volume><fpage>503</fpage><lpage>504</lpage><pub-id pub-id-type="pmid">11385433</pub-id></citation></ref><ref id="pcbi-0030189-b020"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>KS</given-names></name><name><surname>Sethna</surname><given-names>JP</given-names></name></person-group><year>2003</year><article-title>Statistical mechanical approaches to models with many poorly known parameters</article-title><source>Phys Rev E</source><volume>68</volume><fpage>021904</fpage></citation></ref><ref id="pcbi-0030189-b021"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>KS</given-names></name><name><surname>Hill</surname><given-names>CC</given-names></name><name><surname>Calero</surname><given-names>GA</given-names></name><name><surname>Myers</surname><given-names>CR</given-names></name><name><surname>Lee</surname><given-names>KH</given-names></name><etal/></person-group><year>2004</year><article-title>The statistical mechanics of complex signaling networks: Nerve growth factor signaling</article-title><source>Phys Biol</source><volume>1</volume><fpage>184</fpage><lpage>195</lpage><pub-id pub-id-type="pmid">16204838</pub-id></citation></ref><ref id="pcbi-0030189-b022"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Frederiksen</surname><given-names>SL</given-names></name><name><surname>Jacobsen</surname><given-names>KW</given-names></name><name><surname>Brown</surname><given-names>KS</given-names></name><name><surname>Sethna</surname><given-names>JP</given-names></name></person-group><year>2004</year><article-title>Bayesian ensemble approach to error estimation of interatomic potentials</article-title><source>Phys Rev Lett</source><volume>93</volume><fpage>165501</fpage><pub-id pub-id-type="pmid">15525000</pub-id></citation></ref><ref id="pcbi-0030189-b023"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Waterfall</surname><given-names>JJ</given-names></name><name><surname>Casey</surname><given-names>FP</given-names></name><name><surname>Gutenkunst</surname><given-nam