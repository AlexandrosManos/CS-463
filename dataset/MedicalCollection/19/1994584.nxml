pub-id></citation></ref><ref id="pone.0001001-Bassett1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bassett</surname><given-names>MT</given-names></name><name><surname>Latif</surname><given-names>AS</given-names></name><name><surname>Katzenstein</surname><given-names>DA</given-names></name><name><surname>Emmanuel</surname><given-names>JC</given-names></name></person-group><year>1992</year><article-title>Sexual behavior and risk factors for HIV infection in a group of male factory workers who donated blood in Harare, Zimbabwe.</article-title><source>J Acquir Immune Defic Syndr</source><volume>5</volume><fpage>556</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">1588490</pub-id></citation></ref><ref id="pone.0001001-Berkley1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Berkley</surname><given-names>SF</given-names></name><name><surname>Widy-Wirski</surname><given-names>R</given-names></name><name><surname>Okware</surname><given-names>SI</given-names></name><name><surname>Downing</surname><given-names>R</given-names></name><name><surname>Linnan</surname><given-names>MJ</given-names></name><etal/></person-group><year>1989</year><article-title>Risk factors associated with HIV infection in Uganda.</article-title><source>J Infect Dis</source><volume>160</volume><fpage>22</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">2732515</pub-id></citation></ref><ref id="pone.0001001-Miotti1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Miotti</surname><given-names>PG</given-names></name><name><surname>Dallabetta</surname><given-names>G</given-names></name><name><surname>Ndovi</surname><given-names>E</given-names></name><name><surname>Liomba</surname><given-names>G</given-names></name><name><surname>Saah</surname><given-names>AJ</given-names></name><etal/></person-group><year>1990</year><article-title>HIV-1 and pregnant women: associated factors, prevalence, estimate of incidence and role in fetal wastage in central Africa.</article-title><source>AIDS</source><volume>4</volume><fpage>733</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">2261131</pub-id></citation></ref><ref id="pone.0001001-Chao1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chao</surname><given-names>A</given-names></name><name><surname>Bulterys</surname><given-names>M</given-names></name><name><surname>Musanganire</surname><given-names>F</given-names></name><name><surname>Habimana</surname><given-names>P</given-names></name><name><surname>Nawrocki</surname><given-names>P</given-names></name><etal/></person-group><year>1994</year><article-title>Risk factors associated with prevalent HIV-1 infection among pregnant women in Rwanda. National University of Rwanda-Johns Hopkins University AIDS Research Team.</article-title><source>Int J Epidemiol</source><volume>23</volume><fpage>371</fpage><lpage>80</lpage><pub-id pub-id-type="pmid">8082965</pub-id></citation></ref><ref id="pone.0001001-Hunter1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hunter</surname><given-names>DJ</given-names></name><name><surname>Maggwa</surname><given-names>BN</given-names></name><name><surname>Mati</surname><given-names>JK</given-names></name><name><surname>Tukei</surname><given-names>PM</given-names></name><name><surname>Mbugua</surname><given-names>S</given-names></name></person-group><year>1994</year><article-title>Sexual behavior, sexually transmitted diseases, male circumcision and risk of HIV infection among women in Nairobi, Kenya.</article-title><source>AIDS</source><volume>8</volume><fpage>93</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">8011242</pub-id></citation></ref><ref id="pone.0001001-Serwadda1"><label>18</label><citation citation-type="journal"><person-group person-group-ty