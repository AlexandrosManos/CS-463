r>2007</year><volume>120</volume><fpage>281</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">17349454</pub-id><pub-id pub-id-type="doi">10.1016/j.amjmed.2006.12.009</pub-id></citation></ref></ref-list></back></article>