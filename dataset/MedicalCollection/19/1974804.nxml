<etal/></person-group><article-title>Randomised crossover trial of transdermal fentanyl and sustained release oral morphine for treating chronic non-cancer pain</article-title><source>BMJ</source><year>2001</year><volume>322</volume><fpage>1154</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">11348910</pub-id></citation></ref><ref id="b28"><label>28</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Klepstad</surname><given-names>P</given-names></name></person-group><article-title>Effects on cancer patients&#x02019; health-related quality of life after the start of morphine therapy</article-title><source>J Pain Symptom Manage</source><year>2000</year><volume>20</volume><fpage>19</fpage><lpage>26</lpage><pub-id pub-id-type="pmid">10946165</pub-id></citation></ref><ref id="b29"><label>29</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meuser</surname><given-names>T</given-names></name></person-group><article-title>Symptoms during cancer pain treatment following WHO-guidelines: a longitudinal follow-up study of symptom prevalence, severity and etiology</article-title><source>J Pain</source><year>2001</year><volume>93</volume><fpage>247</fpage><lpage>57</lpage></citation></ref><ref id="b30"><label>30</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Longstreth</surname><given-names>GF</given-names></name></person-group><article-title>Functional bowel disorders</article-title><source>Gastroenterology</source><year>2006</year><volume>130</volume><fpage>1480</fpage><lpage>91</lpage><pub-id pub-id-type="pmid">16678561</pub-id></citation></ref><ref id="b31"><label>31</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Devulder</surname><given-names>J</given-names></name></person-group><article-title>Impact of long-term use of opioids on quality of life in patients with chronic, non-malignant pain</article-title><source>Curr Med Res Opin</source><year>2005</year><volume>21</volume><fpage>1555</fpage><lpage>68</lpage><pub-id pub-id-type="pmid">16238895</pub-id></citation></ref><ref id="b32"><label>32</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fallon</surname><given-names>M</given-names></name></person-group><article-title>Constipation in cancer patients: prevalence, pathogenesis and cost-related issues</article-title><source>Eur J Pain</source><year>1999</year><volume>3</volume><fpage>3</fpage><lpage>7</lpage></citation></ref><ref id="b33"><label>33</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leslie</surname><given-names>J</given-names></name></person-group><article-title>Opioid-induced constipation compromises pain management and impacts patients quality of life</article-title><source>Anesthesiology</source><year>2006</year><volume>105</volume><comment>A1490</comment></citation></ref><ref id="b34"><label>34</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McNicol</surname><given-names>E</given-names></name><etal/></person-group><article-title>Management of opioid side effects in cancer-related and chronic noncancer pain: a systematic review</article-title><source>J Pain</source><year>2003</year><volume>4</volume><fpage>231</fpage><lpage>56</lpage><pub-id pub-id-type="pmid">14622694</pub-id></citation></ref><ref id="b35"><label>35</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bell</surname><given-names>T</given-names></name><etal/></person-group><article-title>OBD symptoms impair quality of life and daily activities, regardless of frequency and duration of opioid treatment: results of a US patient survey (PROBE survey)</article-title><source>The 25th Annual Scientific Meeting of the American Pain Society</source><publisher-loc>San Antonia, TX, USA</publi