<person-group person-group-type="author"><name><surname>Bolan</surname><given-names>P</given-names></name><name><surname>Nelson</surname><given-names>M</given-names></name><name><surname>Garwood</surname><given-names>M</given-names></name></person-group><article-title>A novel tissue marker for multimodal breast imaging</article-title><conf-name>In: Radiological Society of North America (RSNA) 91st Scientific Assembly and Annual Meeting</conf-name><conf-date>November-December, 2005</conf-date><conf-loc>Chicago, Ill, USA</conf-loc><fpage>624</fpage><comment>Abstract LPH01-03.</comment></citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McDonald</surname><given-names>MA</given-names></name><name><surname>Watkin</surname><given-names>KL</given-names></name></person-group><article-title>Small particulate gadolinium oxide and gadolinium oxide albumin microspheres as multimodal contrast and therapeutic agents</article-title><source><italic>Investigative Radiology</italic></source><year>2003</year><volume>38</volume><issue>6</issue><fpage>305</fpage><lpage>310</lpage><pub-id pub-id-type="pmid">12908697</pub-id></citation></ref></ref-list></back></article>