e><surname>Khalish</surname><given-names>R</given-names></name></person-group><article-title>Adenocarcinoma of the distal esophagus and gastric cardia. Comparison of results of transhiatal esophagectomy and thoracoabdominal esophago-gastrectomy</article-title><source>J Thorac Cardiovasc Surg</source><year>1986</year><volume>91</volume><fpage>242</fpage><lpage>247</lpage><pub-id pub-id-type="pmid">3945092</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stark</surname><given-names>SP</given-names></name><name><surname>Romberg</surname><given-names>MS</given-names></name><name><surname>Pierce</surname><given-names>GE</given-names></name><name><surname>Hermreck</surname><given-names>AS</given-names></name><name><surname>Jewell</surname><given-names>WR</given-names></name><name><surname>Moran</surname><given-names>JF</given-names></name><name><surname>Cherian</surname><given-names>G</given-names></name><name><surname>Delcore</surname><given-names>R</given-names></name><name><surname>Thomas</surname><given-names>JH</given-names></name></person-group><article-title>Transhiatal versus transthoracic oesophagectomy for adenocarcinoma of the distal oesophagus and cardia</article-title><source>Am J Surg</source><year>1996</year><volume>172</volume><fpage>478</fpage><lpage>482</lpage><pub-id pub-id-type="pmid">8942548</pub-id><pub-id pub-id-type="doi">10.1016/S0002-9610(96)00224-3</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sasako</surname><given-names>M</given-names></name><name><surname>Sano</surname><given-names>T</given-names></name><name><surname>Yamamoto</surname><given-names>S</given-names></name><name><surname>Sairenji</surname><given-names>M</given-names></name><name><surname>Arai</surname><given-names>K</given-names></name><name><surname>Kinoshita</surname><given-names>T</given-names></name><name><surname>N