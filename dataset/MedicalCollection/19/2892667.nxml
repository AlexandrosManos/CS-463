">15988687</pub-id></element-citation></ref><ref id="B8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Travis</surname><given-names>WD</given-names></name><name><surname>Garg</surname><given-names>K</given-names></name><name><surname>Franklin</surname><given-names>WA</given-names></name><etal/></person-group><article-title>Evolving concepts in the pathology and computed tomography imaging of lung adenocarcinoma and bronchioloalveolar carcinoma</article-title><source><italic>Journal of Clinical Oncology</italic></source><year>2005</year><volume>23</volume><issue>14</issue><fpage>3279</fpage><lpage>3287</lpage><pub-id pub-id-type="pmid">15886315</pub-id></element-citation></ref><ref id="B9"><label>9</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Cagle</surname><given-names>PT</given-names></name><name><surname>Allen</surname><given-names>TC</given-names></name><name><surname>Beasley</surname><given-names>MB</given-names></name></person-group><source><italic>Diagnostic Pulmonary Pathology</italic></source><year>2000</year><volume>585</volume><edition>1st edition</edition><publisher-loc>New York, NY, USA</publisher-loc><publisher-name>Marcel Dekker</publisher-name></element-citation></ref><ref id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kuhlman</surname><given-names>JE</given-names></name><name><surname>Fishman</surname><given-names>EK</given-names></name><name><surname>Kuhajda</surname><given-names>FP</given-names></name><etal/></person-group><article-title>Solitary bronchioloalveolar carcinoma: CT criteria</article-title><source><italic>Radiology</italic></source><year>1988</year><volume>167</volume><issue>2</issue><fpage>379</fpage><lpage>382</lpage><pub-id pub-id-type="pmid">2833764</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-cit