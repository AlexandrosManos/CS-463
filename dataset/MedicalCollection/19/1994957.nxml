ype="journal"><person-group person-group-type="author"><name><surname>Agaba</surname><given-names>EA</given-names></name></person-group><article-title>Does rectal washout during anterior resection prevent local tumor recurrence?</article-title><source>Dis Colon Rectum</source><year>2004</year><volume>47</volume><fpage>291</fpage><lpage>296</lpage><pub-id pub-id-type="pmid">14991490</pub-id><pub-id pub-id-type="doi">10.1007/s10350-003-0046-1</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Terzi</surname><given-names>C</given-names></name><name><surname>Unek</surname><given-names>T</given-names></name><name><surname>Sagol</surname><given-names>O</given-names></name><name><surname>Yilmaz</surname><given-names>T</given-names></name><name><surname>Fuzun</surname><given-names>M</given-names></name><name><surname>Sokmen</surname><given-names>S</given-names></name><name><surname>Ergor</surname><given-names>G</given-names></name><name><surname>Kupeliogu</surname><given-names>A</given-names></name></person-group><article-title>Is rectal washout necessary in anterior resection for rectal cancer? A prospective clinical study</article-title><source>World J Surg</source><year>2006</year><volume>30</volume><fpage>233</fpage><lpage>241</lpage><pub-id pub-id-type="doi">10.1007/s00268-005-0300-x</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Holm</surname><given-names>T</given-names></name><name><surname>Cedermark</surname><given-names>B</given-names></name><name><surname>Rutqvist</surname><given-names>LE</given-names></name></person-group><article-title>Local recurrence of rectal adenocarcinoma after 'curative' surgery with and without preoperative radiotherapy</article-title><source>Br J Surg</source><year>1944</year><volume>81</volume><fpage>452</fpage><lpage>455</lpage><pub-id pub-id-type="doi">10.1002/bjs.1800810344</p