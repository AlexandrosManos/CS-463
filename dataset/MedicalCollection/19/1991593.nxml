 colspan="1">NS</td><td align="left" rowspan="1" colspan="1">NS</td><td align="left" rowspan="1" colspan="1">NS</td></tr><tr><td align="left" rowspan="1" colspan="1">CSP</td><td align="left" rowspan="1" colspan="1">68&#x00025;</td><td align="left" rowspan="1" colspan="1">NS</td><td align="left" rowspan="1" colspan="1">NS</td><td align="left" rowspan="1" colspan="1">NS</td><td align="left" rowspan="1" colspan="1">NS</td><td align="left" rowspan="1" colspan="1">NS</td></tr><tr><td align="left" rowspan="1" colspan="1">PSE</td><td align="left" rowspan="1" colspan="1">78&#x00025;</td><td align="left" rowspan="1" colspan="1">NS</td><td align="left" rowspan="1" colspan="1">NS</td><td align="left" rowspan="1" colspan="1">NS</td><td align="left" rowspan="1" colspan="1">NS</td><td align="left" rowspan="1" colspan="1">NS</td></tr></tbody></table></table-wrap><table-wrap id="pone-0000978-t003" position="float"><object-id pub-id-type="doi">10.1371/journal.pone.0000978.t003</object-id><label>Table 3</label><caption><title>Geometric means and 95&#x00025; Confidence intervals in brackets of log transformed OD values against several blood stage antigens (AMA1, EBA-175, MSP-1<sub>19</sub>, MSP-2, MSP-3), circumsporozoite protein (CSP), and parasite schizont extract (PSE) of <italic>Plasmodium falciparum</italic> in urban and rural sera of Burkina Faso.</title></caption><graphic id="pone-0000978-t003-3" xlink:href="pone.0000978.t003"/><table frame="hsides" rules="groups" alternate-form-of="pone-0000978-t003-3"><colgroup span="1"><col align="left" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/></colgroup><thead><tr><td align="left" rowspan="1" colspan="1">Antigen</td><td align="left" rowspan="1" colspan="1">AA</td><td align="left" rowspan="1" colspan="1">AC</td><td align="left" rowspan="1" colspan="1">AS</td><td align="left" rowspan="1" colspan=