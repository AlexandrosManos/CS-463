"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ono-Saito</surname><given-names>N</given-names></name><name><surname>Niki</surname><given-names>I</given-names></name><name><surname>Hidaka</surname><given-names>H</given-names></name></person-group><year>1999</year><article-title>H-series protein kinase inhibitors and potential clinical applications.</article-title><source>Pharmacol Ther</source><volume>82</volume><fpage>123</fpage><lpage>131</lpage><pub-id pub-id-type="pmid">10454191</pub-id></citation></ref><ref id="pone.0000982-SeboltLeopold1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sebolt-Leopold</surname><given-names>JS</given-names></name><name><surname>English</surname><given-names>JM</given-names></name></person-group><year>2006</year><article-title>Mechanisms of drug inhibition of signaling molecules.</article-title><source>Nature</source><volume>441</volume><fpage>457</fpage><lpage>462</lpage><pub-id pub-id-type="pmid">16724058</pub-id></citation></ref><ref id="pone.0000982-Fabian1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fabian</surname><given-names>MA</given-names></name><name><surname>r d Biggs</surname><given-names>WH</given-names></name><name><surname>Treiber</surname><given-names>DK</given-names></name><name><surname>Atteridge</surname><given-names>CE</given-names></name><name><surname>Azimioara</surname><given-names>MD</given-names></name><etal/></person-group><year>2005</year><article-title>A small molecule-kinase interaction map for clinical kinase inhibitors.</article-title><source>Nat Biotechnol</source><volume>23</volume><fpage>329</fpage><lpage>336</lpage><pub-id pub-id-type="pmid">15711537</pub-id></citation></ref><ref id="pone.0000982-Rohl1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rohl</surname><given-names>CA</given-names></name><name><surname>Strauss</surname><given-names>CE</given-names></name><name><surname>Misura</surname><given-names>KM</given-names></name><name><surname>Baker</surname><given-names>D</given-names></name></person-group><year>2004</year><article-title>Protein structure prediction using Rosetta.</article-title><source>Methods Enzymol</source><volume>383</volume><fpage>66</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">15063647</pub-id></citation></ref><ref id="pone.0000982-LaRondeLeBlanc2"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>LaRonde-LeBlanc</surname><given-names>N</given-names></name><name><surname>Wlodawer</surname><given-names>A</given-names></name></person-group><year>2004</year><article-title>Crystal structure of <italic>A. fulgidus</italic> Rio2 defines a new family of serine protein kinases.</article-title><source>Structure</source><volume>12</volume><fpage>1585</fpage><lpage>1594</lpage><pub-id pub-id-type="pmid">15341724</pub-id></citation></ref><ref id="pone.0000982-Grishin1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grishin</surname><given-names>NV</given-names></name></person-group><year>2001</year><article-title>Fold change in evolution of protein structures.</article-title><source>J Struct Biol</source><volume>134</volume><fpage>167</fpage><lpage>185</lpage><pub-id pub-id-type="pmid">11551177</pub-id></citation></ref><ref id="pone.0000982-Todd1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Todd</surname><given-names>AE</given-names></name><name><surname>Orengo</surname><given-names>CA</given-names></name><name><surname>Thornton</surname><given-names>JM</given-names></name></person-group><year>2002</year><article-title>Plasticity of enzyme active sites.</article-title><source>Trends Biochem Sci</source><volume>27</volu