/www.itarda.or.jp/english/">http://www.itarda.or.jp/english/</ext-link><comment>Accessed July 1, 2010.</comment></mixed-citation></ref><ref id="B8"><mixed-citation publication-type="book"><collab>Japan National Police Agency</collab><source>The Police Report about fatal traffic crashes in 2007</source><year>2008</year><publisher-name>Japan Tokyo</publisher-name><comment>(in Japanese)</comment></mixed-citation></ref><ref id="B9"><mixed-citation publication-type="book"><name><surname>Laflamme</surname><given-names>L</given-names></name><name><surname>Svanstr&#x000f6;m</surname><given-names>L</given-names></name><name><surname>Schelp</surname><given-names>L</given-names></name><source>Safety Promotion Research. A Public Health Approach to Accident and Injury Prevention</source><year>1999</year><publisher-name>Stockholm: Karolinska Institutet</publisher-name><fpage>63</fpage><lpage>82</lpage></mixed-citation></ref><ref id="B10"><mixed-citation publication-type="other"><name><surname>McCaig</surname><given-names>LF</given-names></name><name><surname>Nawar</surname><given-names>EW</given-names></name><article-title>National Hospital Ambulatory Medical Care Survey: 2004 emergency department summary</article-title><source>Adv Data</source><year>2006</year><fpage>1</fpage><lpage>29</lpage></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><name><surname>Perry</surname><given-names>MJ</given-names></name><name><surname>Sun</surname><given-names>BX</given-names></name><name><surname>Zhang</surname><given-names>HX</given-names></name><article-title>Emergency department surveillance of occupational injuries in Shanghai's Putuo District, People's Republic of China</article-title><source>Ann Epidemiol</source><year>2005</year><volume>15</volume><fpage>351</fpage><lpage>7</lpage><pub-id pub-id-type="doi">10.1016/j.annepidem.2004.12.007</pub-id><pub-id pub-id-type="pmid">15840548</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-ty