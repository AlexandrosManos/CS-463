-loc><fpage>81</fpage><lpage>90</lpage></citation></ref><ref id="B17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matsuzawa</surname><given-names>K.</given-names></name><name><surname>Kosako</surname><given-names>H.</given-names></name><name><surname>Inagaki</surname><given-names>N.</given-names></name><name><surname>Shibata</surname><given-names>H.</given-names></name><name><surname>Mukai</surname><given-names>H.</given-names></name><name><surname>Ono</surname><given-names>Y.</given-names></name><name><surname>Amano</surname><given-names>M.</given-names></name><name><surname>Kaibuchi</surname><given-names>K.</given-names></name><name><surname>Matsuura</surname><given-names>Y.</given-names></name><name><surname>Azuma</surname><given-names>I.</given-names></name><name><surname>Inagaki</surname><given-names>M.</given-names></name></person-group><year>1997</year><article-title>Domain-specific phosphorylation of vimentin and glial fibrillary acidic protein by PKN</article-title><source>Biochem. Biophys. Res. Commun.</source><volume>234</volume><fpage>621</fpage><lpage>625</lpage><pub-id pub-id-type="pmid">9175763</pub-id></citation></ref><ref id="B18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Milhorat</surname><given-names>T. H.</given-names></name><name><surname>Mosher</surname><given-names>M. B.</given-names></name><name><surname>Hammock</surname><given-names>M. K.</given-names></name><name><surname>Murphy</surname><given-names>C. F.</given-names></name></person-group><year>1970</year><article-title>Evidence for choroid-pleux absorption in hydrocephalus</article-title><source>N. Engl. J. Med.</source><volume>283</volume><fpage>286</fpage><lpage>289</lpage><pub-id pub-id-type="pmid">5427058</pub-id></citation></ref><ref id="B19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Miwa</sur