roup person-group-type="author"><name><surname>MacMillan</surname><given-names>HL</given-names></name><name><surname>Walsh</surname><given-names>CA</given-names></name><name><surname>Jamieson</surname><given-names>E</given-names></name><name><surname>Wong</surname><given-names>MY</given-names></name><name><surname>Faries</surname><given-names>EJ</given-names></name><name><surname>McCue</surname><given-names>H</given-names></name><name><surname>MacMillan</surname><given-names>AB</given-names></name><name><surname>Offord</surname><given-names>DD</given-names></name></person-group><article-title>The health of Ontario First Nations people: results from the Ontario First Nations Regional Health Survey</article-title><source>Can J Public Health</source><year>2003</year><volume>94</volume><fpage>168</fpage><lpage>172</lpage><pub-id pub-id-type="pmid">12790487</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jin</surname><given-names>A</given-names></name><name><surname>Martin</surname><given-names>JD</given-names></name><name><surname>Sarin</surname><given-names>C</given-names></name></person-group><article-title>A diabetes mellitus in the First Nations population of British Columbia, Canada. Part 1. Mortality</article-title><source>Int J Circumpolar Health</source><year>2002</year><volume>61</volume><fpage>251</fpage><lpage>253</lpage><pub-id pub-id-type="pmid">12369114</pub-id></citation></ref><ref id="B13"><citation citation-type="other"><article-title>Responding to the challenge of diabetes in Canada. First report of the National Diabetes Surveillence System (NDSS).</article-title><source>Health Canada</source><year>2003</year></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Denny</surname><given-names>CH</given-names></name><name><surname>Holtzman</surname><given-names>D</given-names></name><name><surname>Goins</surnam