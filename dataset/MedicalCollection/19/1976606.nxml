</article-title><source>Journal of Biosocial Science</source><year>1999</year><volume>31</volume><fpage>343</fpage><lpage>360</lpage><pub-id pub-id-type="pmid">10453247</pub-id><pub-id pub-id-type="doi">10.1017/S0021932099003430</pub-id></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><collab>United Nations Department of Economic and Social Affairs</collab></person-group><source>Fertility, Contraception and Population Policies</source><year>2003</year><publisher-name>New York: United Nations Department of Economic and Social Affairs</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.un.org/esa/population/publications/contraception2003/Web-final-text.PDF"/></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Leite</surname><given-names>IC</given-names></name><name><surname>Gupta</surname><given-names>N</given-names></name><name><surname>Rodrigues</surname><given-names>RN</given-names></name></person-group><article-title>Female sterilisation in Latin America: cross-national perspectives</article-title><source>Journal of Biosocial Science</source><year>2004</year><volume>36</volume><fpage>683</fpage><lpage>698</lpage><pub-id pub-id-type="pmid">15535458</pub-id><pub-id pub-id-type="doi">10.1017/S0021932003006369</pub-id></citation></ref></ref-list></back></article>