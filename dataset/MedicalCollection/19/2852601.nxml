tle><source><italic>Indian Journal of Gastroenterology</italic></source><year>1998</year><volume>17</volume><issue>2</issue><fpage>63</fpage><lpage>64</lpage><pub-id pub-id-type="pmid">9563226</pub-id></element-citation></ref><ref id="B6"><label>6</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Harada</surname><given-names>N</given-names></name><name><surname>Chijiiwa</surname><given-names>Y</given-names></name><name><surname>Yao</surname><given-names>T</given-names></name><name><surname>Koyanagi</surname><given-names>M</given-names></name><name><surname>Ono</surname><given-names>Y</given-names></name><name><surname>Motomura</surname><given-names>S</given-names></name></person-group><article-title>Inflammatory myoglandular polyp</article-title><source><italic>Journal of Clinical Gastroenterology</italic></source><year>1999</year><volume>29</volume><issue>1</issue><fpage>104</fpage><lpage>105</lpage><pub-id pub-id-type="pmid">10405247</pub-id></element-citation></ref><ref id="B7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kayhan</surname><given-names>B</given-names></name><name><surname>K&#x000fc;&#x000e7;&#x000fc;kel</surname><given-names>F</given-names></name><name><surname>Akdo&#x0011f;an</surname><given-names>M</given-names></name><name><surname>Ozaslan</surname><given-names>E</given-names></name><name><surname>K&#x000fc;&#x000e7;&#x000fc;kba&#x0015f;</surname><given-names>TA</given-names></name><name><surname>Ato&#x0011f;lu</surname><given-names>O</given-names></name></person-group><article-title>Inflammatory myoglandular polyp: a rare cause of hematochezia</article-title><source><italic>Turkish Journal of Gastroenterology</italic></source><year>2004</year><volume>15</volume><issue>2</issue><fpage>117</fpage><lpage>119</lpage><pub-id pub-id-type="pmid">15334325</pub-id></element-citation></ref><ref id="B8"><label>8</label><element