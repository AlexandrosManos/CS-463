oup person-group-type="editor"><name><surname>Meyerowitz EM</surname></name></person-group><article-title>Molecular and Developmental Biology of Inorganic Nitrogen Nutrition</article-title><source>The Arabidopsis Book</source><year>2002</year><publisher-name>Rockville, MD , American Society of Plant Biologists</publisher-name></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crawford</surname><given-names>NM</given-names></name><name><surname>Glass</surname><given-names>ADM</given-names></name></person-group><article-title>Molecular and physiological aspects of nitrate uptake in plants</article-title><source>Trends in Plant Science</source><year>1998</year><volume>3</volume><fpage>389</fpage><lpage>395</lpage><pub-id pub-id-type="doi">10.1016/S1360-1385(98)01311-9</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crawford</surname><given-names>NM</given-names></name></person-group><article-title>Nitrate - Nutrient and Signal for Plant-Growth</article-title><source>Plant Cell</source><year>1995</year><volume>7</volume><fpage>859</fpage><lpage>868</lpage><pub-id pub-id-type="pmid">7640524</pub-id><pub-id pub-id-type="doi">10.1105/tpc.7.7.859</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stitt</surname><given-names>M</given-names></name></person-group><article-title>Nitrate regulation of metabolism and growth</article-title><source>Current Opinion in Plant Biology</source><year>1999</year><volume>2</volume><fpage>178</fpage><lpage>186</lpage><pub-id pub-id-type="pmid">10375569</pub-id><pub-id pub-id-type="doi">10.1016/S1369-5266(99)80033-8</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lam</surname><given-names>HM</given-names></name><name><surname>Coschigano</surname><given-names>KT</given-names></name><name><surname>Oliveira</surname><given-names>IC</given-names></name><name><surname>Melo-Oliveira</surname><given-names>R</given-names></name><name><surname>Coruzzi</surname><given-names>GM</given-names></name></person-group><article-title>The Molecular-Genetics of Nitrogen Assimilation into Amino Acids in Higher Plants</article-title><source>Annu Rev Plant Physiol Plant Mol Biol</source><year>1996</year><volume>47</volume><fpage>569</fpage><lpage>593</lpage><pub-id pub-id-type="pmid">15012301</pub-id><pub-id pub-id-type="doi">10.1146/annurev.arplant.47.1.569</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Campbell</surname><given-names>WH</given-names></name></person-group><article-title>NITRATE REDUCTASE STRUCTURE, FUNCTION AND REGULATION: Bridging the Gap between Biochemistry and Physiology</article-title><source>Annu Rev Plant Physiol Plant Mol Biol</source><year>1999</year><volume>50</volume><fpage>277</fpage><lpage>303</lpage><pub-id pub-id-type="pmid">15012211</pub-id><pub-id pub-id-type="doi">10.1146/annurev.arplant.50.1.277</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cheng</surname><given-names>CL</given-names></name><name><surname>Dewdney</surname><given-names>J</given-names></name><name><surname>Kleinhofs</surname><given-names>A</given-names></name><name><surname>Goodman</surname><given-names>HM</given-names></name></person-group><article-title>Cloning and nitrate induction of nitrate reductase mRNA</article-title><source>Proc Natl Acad Sci U S A</source><year>1986</year><volume>83</volume><fpage>6825</fpage><lpage>6828</lpage><pub-id pub-id-type="pmid">16593758</pub-id><pub-id pub-id-type="doi">10.1073/pnas.83.18.6825</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cr