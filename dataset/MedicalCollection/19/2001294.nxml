"B17"><citation citation-type="other"><article-title>Palliative Care Policy Center</article-title><ext-link ext-link-type="uri" xlink:href="http://www.medicaring.org/index.html"/></citation></ref><ref id="B18"><citation citation-type="other"><person-group person-group-type="author"><collab>Last Acts Committee</collab></person-group><article-title>A Record of Accomplishment in End-of-Life Care. </article-title><ext-link ext-link-type="uri" xlink:href="http://www.rwjf.org/newsroom/featureDetail.jsp?featureID=886&#x00026;type=3"/></citation></ref><ref id="B19"><citation citation-type="other"><person-group person-group-type="author"><collab>Last Acts Committee</collab></person-group><article-title>Means To A Better End. A Report in Dying In America Today</article-title><ext-link ext-link-type="uri" xlink:href="http://www.rwjf.org/files/publications/other/meansbetterend.pdf"/></citation></ref><ref id="B20"><citation citation-type="other"><person-group person-group-type="author"><collab>National Conference of Commissioners on Uniform State Laws</collab></person-group><article-title>ULC Response to Washington Post Article</article-title><ext-link ext-link-type="uri" xlink:href="http://www.anatomicalgiftact.org/DesktopDefault.aspx?tabindex=0&#x00026;tabid=74"/></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cooper</surname><given-names>S</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Thinker A</surname></name></person-group><source>Cooper, S. Informed Consent and Malformed Consent</source><ext-link ext-link-type="uri" xlink:href="http://www.americanthinker.com/2007/06/informed_consent_and_malformed.html"/></citation></ref><ref id="B22"><citation citation-type="other"><person-group person-group-type="author"><collab>National Consensus Project For Quality Palliative Care Steering Committee</collab></person-group><article-title>Clinical Practice Guidelines for Quality Palliative Care</article-title><ext-link ext-link-type="uri" xlink:href="http://www.nationalconsensusproject.org/Guidelines_Download.asp"/></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rady</surname><given-names>MY</given-names></name><name><surname>Verheijde</surname><given-names>JL</given-names></name><name><surname>McGregor</surname><given-names>J</given-names></name></person-group><article-title>Organ donation after circulatory death: the forgotten donor</article-title><source>Crit Care</source><year>2006</year><volume> 10</volume><fpage>166</fpage><lpage>169</lpage><pub-id pub-id-type="pmid">17020597</pub-id><pub-id pub-id-type="doi">10.1186/cc5038</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rady</surname><given-names>MY</given-names></name><name><surname>Verheijde</surname><given-names>JL</given-names></name><name><surname>McGregor</surname><given-names>J</given-names></name></person-group><article-title>Non-heart beating or cardiac death organ donation: Why we should care.</article-title><source>J Hosp Med</source><year>2007</year><volume>2</volume><fpage>324</fpage><lpage>334</lpage><pub-id pub-id-type="doi">10.1002/jhm.204</pub-id></citation></ref></ref-list></back></article>