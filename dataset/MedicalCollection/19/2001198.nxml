d><td align="center"><bold>10<sup>-2</sup></bold></td><td align="center">10<sup>-1</sup></td><td align="center">N/A</td><td align="center">N/A</td><td align="center">N/A</td></tr><tr><td align="left">20.01.03</td><td align="left">C-compound and carbohydrate transport</td><td align="center">10<sup>-1</sup></td><td align="center">N/A</td><td align="center">10<sup>-1</sup></td><td align="center"><bold>10<sup>-2</sup></bold></td><td align="center">N/A</td><td align="center"><bold>10<sup>-2</sup></bold></td><td align="center">N/A</td><td align="center">10<sup>-1</sup></td><td align="center">N/A</td><td align="center">N/A</td><td align="center">N/A</td></tr><tr><td align="left">20.09.07</td><td align="left">Vesicular transport (Golgi network, etc.)</td><td align="center"><bold>10<sup>-2</sup></bold></td><td align="center">10<sup>-1</sup></td><td align="center">N/A</td><td align="center">10<sup>-1</sup></td><td align="center">N/A</td><td align="center">N/A</td><td align="center">10<sup>-1</sup></td><td align="center">N/A</td><td align="center">10<sup>-1</sup></td><td align="center">N/A</td><td align="center">N/A</td></tr><tr><td align="left"><bold>30.05.01.10</bold></td><td align="left"><bold>Two-component signal transduction system (sensor kinase component)</bold></td><td align="center">N/A</td><td align="center"><bold>10<sup>-2</sup></bold></td><td align="center">N/A</td><td align="center">N/A</td><td align="center">N/A</td><td align="center">N/A</td><td align="center">N/A</td><td align="center">N/A</td><td align="center">N/A</td><td align="center">N/A</td><td align="center">N/A</td></tr><tr><td align="left"><bold>32</bold></td><td align="left"><bold>CELL RESCUE, DEFENSE AND VIRULENCE</bold></td><td align="center">10<sup>-1</sup></td><td align="center">10<sup>1</sup></td><td align="center"><bold>10<sup>-2</sup></bold></td><td align="center"><bold>10<sup>-2</sup></bold></td><td align="center"><bold>10<sup>-2</sup></bold></td><td align="center"><bold>10<sup>-4</sup></bold>