person-group-type="author"><name><surname>Medina</surname><given-names>E</given-names></name><name><surname>North</surname><given-names>RJ</given-names></name></person-group><article-title>The Bcg gene (Nramp1) does not determine resistance of mice to virulent <italic>Mycobacterium tuberculosis</italic>.</article-title><source>Ann NY Acad Sci</source><year>1996</year><volume>797</volume><fpage>257</fpage><lpage>259</lpage><pub-id pub-id-type="pmid">8993372</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bellamy</surname><given-names>R</given-names></name><name><surname>Ruwende</surname><given-names>C</given-names></name><name><surname>Corrah</surname><given-names>T</given-names></name><name><surname>McAdam</surname><given-names>KP</given-names></name><name><surname>Whittle</surname><given-names>HC</given-names></name><name><surname>Hill</surname><given-names>AV</given-names></name></person-group><article-title>Variations in the NRAMP1 gene and susceptibility to tuberculosis in West Africans.</article-title><source>N Engl J Med</source><year>1998</year><volume>338</volume><fpage>640</fpage><lpage>644</lpage><pub-id pub-id-type="pmid">9486992</pub-id><pub-id pub-id-type="doi">10.1056/NEJM199803053381002</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schluger</surname><given-names>NW</given-names></name><name><surname>Rom</surname><given-names>WN</given-names></name></person-group><article-title>The host immune response to tuberculosis.</article-title><source>Am J Respir Crit Care Med</source><year>1998</year><volume>157</volume><fpage>679</fpage><lpage>691</lpage><pub-id pub-id-type="pmid">9517576</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Glatman-Freedman</surname><given-names>A</given-names></name><name><surname>Martin</s