e><surname>Singh-Gasson</surname><given-names>S</given-names></name><name><surname>Green</surname><given-names>RD</given-names></name><name><surname>Yue</surname><given-names>Y</given-names></name><name><surname>Nelson</surname><given-names>C</given-names></name><name><surname>Blattner</surname><given-names>F</given-names></name><name><surname>Sussman</surname><given-names>MR</given-names></name><name><surname>Cerrina</surname><given-names>F</given-names></name></person-group><article-title>Maskless fabrication of light-directed oligonucleotide microarrays using a digital micromirror array</article-title><source>Nat Biotechnol</source><year>1999</year><volume>17</volume><fpage>974</fpage><lpage>978</lpage><pub-id pub-id-type="pmid">10504697</pub-id><pub-id pub-id-type="doi">10.1038/13664</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Baum</surname><given-names>M</given-names></name><name><surname>Bielau</surname><given-names>S</given-names></name><name><surname>Rittner</surname><given-names>N</given-names></name><name><surname>Schmid</surname><given-names>K</given-names></name><name><surname>Eggelbusch</surname><given-names>K</given-names></name><name><surname>Dahms</surname><given-names>M</given-names></name><name><surname>Schlauersbach</surname><given-names>A</given-names></name><name><surname>Tahedl</surname><given-names>H</given-names></name><name><surname>Beier</surname><given-names>M</given-names></name><name><surname>Guimil</surname><given-names>R</given-names></name><name><surname>Scheffler</surname><given-names>M</given-names></name><name><surname>Hermann</surname><given-names>C</given-names></name><name><surname>Funk</surname><given-names>JM</given-names></name><name><surname>Wixmerten</surname><given-names>A</given-names></name><name><surname>Rebscher</surname><given-names>H</given-names></name><name><surname>Honig</surname><given-names>M</given-names></name><name><surname>An