-type="pmid">12383461</pub-id><pub-id pub-id-type="doi">10.1016/S0277-9536(01)00309-4</pub-id></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><collab>Royal Australian College of General Practitioners</collab></person-group><source>Annual Report</source><year>2005</year><publisher-name>Melbourne: RACGP</publisher-name></citation></ref><ref id="B17"><citation citation-type="book"><source>Royal Australian College of General Practitioners: Annual Report</source><year>2006</year><publisher-name>Melbourne: RACGP</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.racgp.org.au/Content/NavigationMenu/About/Governance/Annualreport/2006RACGPAnnualReport.pdf"/></citation></ref><ref id="B18"><citation citation-type="other"><article-title>General Practice Education and Training</article-title><ext-link ext-link-type="uri" xlink:href="http://www.agpt.com.au/praxis.php/home?PRXSESSID=21e9e1bd0c647cf8a06c68267b252cb6"/></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><collab>Royal Australian College of General Practitioners</collab></person-group><source>Curriculum for Australian General Practice</source><year>1998</year><publisher-name>Melbourne: RACGP</publisher-name></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><collab>Royal Australian College of General Practitioners</collab></person-group><source>Standards for General Practice</source><year>2005</year><edition>3</edition><publisher-name>Melbourne: RACGP</publisher-name></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><collab>Royal Australian College of General Practitioners</collab></person-group><source>QA &#x00026; CPD Program: 2002&#x02013;4 Triennium</source><year>2001</year><publisher-name>Melbourne: Royal Australian College of General Practitioners</publisher-name></citation></ref><ref id="B22"><citation citation-type="other"><article-title>Health Care for Refugees and Asylum Seekers</article-title><ext-link ext-link-type="uri" xlink:href="http://www.racgp.org.au/refugeehealth"/></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Self</surname><given-names>DJ</given-names></name><name><surname>Jecker</surname><given-names>NS</given-names></name><name><surname>Baldwin</surname><given-names>DC</given-names><suffix>Jr</suffix></name></person-group><article-title>The moral orientations of justice and care among young physicians</article-title><source>Camb Quart Health Ethics</source><year>2003</year><volume>12</volume><fpage>54</fpage><lpage>60</lpage><pub-id pub-id-type="doi">10.1017/S0963180103121068</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fairhurst</surname><given-names>K</given-names></name><name><surname>May</surname><given-names>C</given-names></name></person-group><article-title>What General Practitioners find satisfying in their work: implications for health care system reform</article-title><source>Ann Fam Med</source><year>2006</year><volume>4</volume><fpage>500</fpage><lpage>505</lpage><pub-id pub-id-type="pmid">17148627</pub-id><pub-id pub-id-type="doi">10.1370/afm.565</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McAvoy</surname><given-names>B</given-names></name><name><surname>Coster</surname><given-names>G</given-names></name></person-group><article-title>General Practice and the New Zealand health reforms: lessons for Australia</article-title><source>Aus NZ Health Policy</source><year>2005</year><volume>2</volume><comment>doi:10.1186/1743-8462-2</comment></citation></ref><ref id="B26"><citation citation-type="other"><article-title>Action on health Inequalities through General Practice III</article-title><ext-link ext-link-type="uri" xlink:href="http://www.racgp.org.au/Content/NavigationMenu/Advocacy/IssuesinGeneralPractice/Healthinequalities/inequalities.htm"/></citation></ref></ref-list></back></article>