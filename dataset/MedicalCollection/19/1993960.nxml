<name><surname>Hougaard Jensen</surname><given-names>K</given-names></name><etal/></person-group><article-title>Fate in intermittent claudication: outcome and risk factors</article-title><source>Br Med J</source><year>1986</year><volume>293</volume><fpage>1137</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">3094806</pub-id></citation></ref><ref id="b12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kannel</surname><given-names>WB</given-names></name><name><surname>Shurtleff</surname><given-names>D</given-names></name></person-group><article-title>The Framingham Study. Cigarettes and the development of intermittent claudication</article-title><source>Geriatrics</source><year>1973</year><volume>28</volume><fpage>61</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">4683662</pub-id></citation></ref><ref id="b13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Littoy</surname><given-names>FN</given-names></name><name><surname>Baker</surname><given-names>WH</given-names></name></person-group><article-title>Acute aortic occlusion &#x02013; a multifaceted catastrophe</article-title><source>J Vasc Surg</source><year>1986</year><volume>4</volume><fpage>211</fpage><lpage>16</lpage><pub-id pub-id-type="pmid">3747030</pub-id></citation></ref><ref id="b14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mansur</surname><given-names>AP</given-names></name><name><surname>Favarato</surname><given-names>D</given-names></name><name><surname>Souza</surname><given-names>MF</given-names></name><etal/></person-group><article-title>Trends in death from circulatory diseases in Brazil between 1979 and 1996</article-title><source>Arq Bras Cardiol</source><year>2001</year><volume>76</volume><fpage>504</fpage><lpage>10</lpage></citation></ref><ref id="b15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Murabito</surname><gi