><surname>Gold</surname><given-names>G</given-names></name><name><surname>Giannakopoulos</surname><given-names>P</given-names></name><name><surname>Montes-Paixao</surname><given-names>JC</given-names></name><name><surname>Herrmann</surname><given-names>FR</given-names></name><name><surname>Mulligan</surname><given-names>R</given-names></name><name><surname>Michel</surname><given-names>JP</given-names></name><etal/></person-group><article-title>Sensitivity and specificity of newly proposed clinical criteria for possible vascular dementia</article-title><source>Neurology</source><year>1997</year><volume>49</volume><fpage>690</fpage><lpage>694</lpage><pub-id pub-id-type="pmid">9305324</pub-id></element-citation></ref><ref id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Jellinger</surname><given-names>KA</given-names></name></person-group><article-title>Vascular-ischemic dementia: an update</article-title><source>J Neural Transm Suppl</source><year>2002</year><volume>62</volume><fpage>1</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">12456046</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Markesbery</surname><given-names>W</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Markesbery</surname><given-names>WR</given-names></name></person-group><article-title>Vascular dementia</article-title><source>Neuropathology of dementing disorders</source><year>1998</year><publisher-loc>London</publisher-loc><publisher-name>Arnold</publisher-name><fpage>293</fpage><lpage>311</lpage></element-citation></ref><ref id="B19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Seno</surname><given-names>H</given-names></name><name><surname>Ishino</surname><given-names>H</given-names></name><