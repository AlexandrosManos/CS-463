ource><year>2000</year><volume>10</volume><fpage>1890</fpage><lpage>1902</lpage><pub-id pub-id-type="pmid">11116085</pub-id><pub-id pub-id-type="doi">10.1101/gr.164800</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>TX</given-names></name><name><surname>Zhou</surname><given-names>Y</given-names></name><name><surname>Kanki</surname><given-names>JP</given-names></name><name><surname>Deng</surname><given-names>M</given-names></name><name><surname>Rhodes</surname><given-names>J</given-names></name><name><surname>Yang</surname><given-names>HW</given-names></name><name><surname>Sheng</surname><given-names>XM</given-names></name><name><surname>Zon</surname><given-names>LI</given-names></name><name><surname>Look</surname><given-names>AT</given-names></name></person-group><article-title>Evolutionary conservation of zebrafish linkage group 14 with frequently deleted regions of human chromosome 5 in myeloid malignancies.</article-title><source>Proc Natl Acad Sci USA</source><year>2002</year><volume>99</volume><fpage>6136</fpage><lpage>6141</lpage><pub-id pub-id-type="pmid">11983906</pub-id><pub-id pub-id-type="doi">10.1073/pnas.072560099</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Patton</surname><given-names>EE</given-names></name><name><surname>Zon</surname><given-names>LI</given-names></name></person-group><article-title>The art and design of genetic screens: zebrafish.</article-title><source>Nat Rev Genet</source><year>2001</year><volume>2</volume><fpage>956</fpage><lpage>966</lpage><pub-id pub-id-type="pmid">11733748</pub-id><pub-id pub-id-type="doi">10.1038/35103567</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gaiano</surname><given-names>N</given-names></name><name><surname>Amsterdam</surname><given-na