><pub-id pub-id-type="pmid">15239961</pub-id><pub-id pub-id-type="doi">10.1016/j.devcel.2004.06.005</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Balciunas</surname><given-names>D</given-names></name><name><surname>Davidson</surname><given-names>AE</given-names></name><name><surname>Sivasubbu</surname><given-names>S</given-names></name><name><surname>Hermanson</surname><given-names>SB</given-names></name><name><surname>Welle</surname><given-names>Z</given-names></name><name><surname>Ekker</surname><given-names>SC</given-names></name></person-group><article-title>Enhancer trapping in zebrafish using the Sleeping Beauty transposon.</article-title><source>BMC Genomics</source><year>2004</year><volume>5</volume><fpage>62</fpage><pub-id pub-id-type="pmid">15347431</pub-id><pub-id pub-id-type="doi">10.1186/1471-2164-5-62</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parinov</surname><given-names>S</given-names></name><name><surname>Kondrichin</surname><given-names>I</given-names></name><name><surname>Korzh</surname><given-names>V</given-names></name><name><surname>Emelyanov</surname><given-names>A</given-names></name></person-group><article-title>Tol2 transposon-mediated enhancer trap to identify developmentally regulated zebrafish genes in vivo.</article-title><source>Dev Dyn</source><year>2004</year><volume>231</volume><fpage>449</fpage><lpage>459</lpage><pub-id pub-id-type="pmid">15366023</pub-id><pub-id pub-id-type="doi">10.1002/dvdy.20157</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sivasubbu</surname><given-names>S</given-names></name><name><surname>Balciunas</surname><given-names>D</given-names></name><name><surname>Davidson</surname><given-names>AE</given-names></name><name><surname>Pickart</surname><given-names>MA</give