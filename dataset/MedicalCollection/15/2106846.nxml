-type="journal"><person-group person-group-type="author"><name><surname>Berns</surname><given-names>A</given-names></name></person-group><article-title>Good news for gene therapy.</article-title><source>N Engl J Med</source><year>2004</year><volume>350</volume><fpage>1679</fpage><lpage>1680</lpage><pub-id pub-id-type="pmid">15084702</pub-id><pub-id pub-id-type="doi">10.1056/NEJMcibr040341</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pages</surname><given-names>JC</given-names></name><name><surname>Bru</surname><given-names>T</given-names></name></person-group><article-title>Toolbox for retrovectorologists.</article-title><source>J Gene Med</source><year>2004</year><volume>6</volume><issue>Suppl 1</issue><fpage>S67</fpage><lpage>S82</lpage><pub-id pub-id-type="pmid">14978752</pub-id><pub-id pub-id-type="doi">10.1002/jgm.498</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kohn</surname><given-names>D</given-names></name><name><surname>Sadelain</surname><given-names>M</given-names></name><name><surname>Dunbar</surname><given-names>C</given-names></name><name><surname>Bodine</surname><given-names>D</given-names></name><name><surname>Kiem</surname><given-names>HP</given-names></name><name><surname>Candotti</surname><given-names>F</given-names></name><name><surname>Tisdale</surname><given-names>J</given-names></name><name><surname>Riviere</surname><given-names>I</given-names></name><name><surname>Blau</surname><given-names>CA</given-names></name><name><surname>Richard</surname><given-names>RE</given-names></name><etal></etal></person-group><article-title>American Society of Gene Therapy (ASGT) ad hoc subcommittee on retroviral-mediated gene transfer to hematopoietic stem cells.</article-title><source>Mol Ther</source><year>2003</year><volume>8</volume><fpage>180</fpage><lpage>187</lpage><pub-id pub-id-type="pm