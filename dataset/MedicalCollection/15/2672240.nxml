n-names>F</given-names></name><etal/></person-group><article-title>Mental stress induces prolonged endothelial dysfunction via endothelin-A receptors</article-title><source>Circulation</source><year>2002</year><volume>105</volume><fpage>2817</fpage><lpage>2820</lpage><pub-id pub-id-type="pmid">12070106</pub-id></mixed-citation></ref><ref id="b10-wjem-9-0104"><label>10</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ghiadoni</surname><given-names>L</given-names></name><name><surname>Donald</surname><given-names>AE</given-names></name><name><surname>Cropley</surname><given-names>M</given-names></name><etal/></person-group><article-title>Mental stress induces transient endothelial dysfunction in humans</article-title><source>Circulation</source><year>2000</year><volume>102</volume><fpage>2473</fpage><lpage>2478</lpage><pub-id pub-id-type="pmid">11076819</pub-id></mixed-citation></ref><ref id="b11-wjem-9-0104"><label>11</label><mixed-citation publication-type="book"><person-group person-group-type="editor"><name><surname>Zipes</surname><given-names>DP</given-names></name><name><surname>Libby</surname><given-names>P</given-names></name><name><surname>Bonow</surname><given-names>R</given-names></name><name><surname>Braunwald</surname><given-names>E</given-names></name></person-group><source>Braunwald&#x02018;s Heart Disease: A Textbook of Cardiovascular Medicine</source><edition>7</edition><publisher-loc>Philadelphia, PA</publisher-loc><publisher-name>Saunders</publisher-name><year>2005</year></mixed-citation></ref><ref id="b12-wjem-9-0104"><label>12</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Akashi</surname><given-names>YJ</given-names></name><name><surname>Barbaro</surname><given-names>G</given-names></name><name><surname>Sakurai</surname><given-names>T</given-names></name><etal/></person-group><article-title>Cardiac autonomic imbalance in patients with reversible ventricular dysfunction Takotsubo cardiomyopathy</article-title><source>Q J Med</source><year>2007</year><volume>100</volume><fpage>335</fpage><lpage>343</lpage></mixed-citation></ref><ref id="b13-wjem-9-0104"><label>13</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wittstein</surname><given-names>IS</given-names></name><name><surname>Thiemann</surname><given-names>DR</given-names></name><name><surname>Lima</surname><given-names>JA</given-names></name><etal/></person-group><article-title>Neurohumoral features of myocardial stunning due to sudden emotional stress</article-title><source>N Engl J Med</source><year>2005</year><volume>352</volume><fpage>539</fpage><lpage>548</lpage><pub-id pub-id-type="pmid">15703419</pub-id></mixed-citation></ref><ref id="b14-wjem-9-0104"><label>14</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ellison</surname><given-names>GM</given-names></name><name><surname>Torella</surname><given-names>D</given-names></name><name><surname>Karakikes</surname><given-names>I</given-names></name><etal/></person-group><article-title>Acute &#x003b2;-adrenergic overload produces myocyte damage through calcium leakage from ryanodine receptor 2 but spares cardiac stem cells</article-title><source>J Biol Chem</source><year>2007</year><volume>282</volume><fpage>11397</fpage><lpage>11409</lpage><pub-id pub-id-type="pmid">17237229</pub-id></mixed-citation></ref><ref id="b15-wjem-9-0104"><label>15</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bybee</surname><given-names>KA</given-names></name><name><surname>Murphy</surname><given-names>J</given-names></name><name><surname>Prasad</surname><given-names>A</given-names></name><etal/></person-group><article-title>Acute impairment of regional myocardial glucose uptake in the apical ballooning (Takotsubo) syndrome</article-title><source>J Nucl Cardiol</source><year>2006</year><volume>13</volume><fpage>244</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">16580961</pub-id></mixed-citation></ref><ref id="b16-wjem-9-0104"><label>16</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Akashi</surname><given-names>YJ</given-names></name><name><surname>Nakazawa</surname><given-names>K</given-names></name><name><surname>Sakakibara</surname><given-names>M</given-names></name><etal/></person-group><article-title>Reversible left ventricular dysfunction &#x0201c;Takotsubo&#x0201d; cardiomyopathy related to catecholamine cardiotoxicity</article-title><source>J Electrocardiol</source><year>2002</year><volume>35</volume><fpage>351</fpage><lpage>356</lpage><pub-id pub-id-type="pmid">12395363</pub-id></mixed-citation></ref><ref id="b17-wjem-9-0104"><label>17</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Akashi</surname><given-names>YJ</given-names></name><name><surname>Nakazawa</surname><given-names>K</given-names></name><name><surname>Sakakibara</surname><given-names>M</given-names></name><etal/></person-group><article-title><sup>123</sup>I-MIBG myocardial scintigraphy in patients with &#x0201c;Takotsubo&#x0201d; cardiomyopathy</article-title><source>J Nucl Med</source><year>2004</year><volume>45</volume><fpage>1121</fpage><lpage>1127</lpage><pub-id pub-id-type="pmid">15235057</pub-id></mixed-citation></ref><ref id="b18-wjem-9-0104"><label>18</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dote</surname><given-names>K</given-names></name><name><surname>Sato</surname><given-names>H</given-names></name><name><surname>Uchida</surname><given-names>T</given-names></name><etal/></person-group><article-title>Myocardial stunning due to simultaneous multivessel coronary spasms: a review of 5 cases</article-title><source>J Cardiol</source><year>1991</year><volume>21</volume><fpage>203</fpage><lpage>214</lpage><pub-id pub-id-type="pmid">1841907</pub-id></mixed-citation></ref><ref id="b19-wjem-9-0104"><label>19</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Pavin</surname><given-names>D</given-names></name><name><surname>Le Breton</surname><given-names>H</given-names></name><name><surname>Daubert</surname><given-names>C</given-names></name></person-group><article-title>Human stress cardiomyopathy mimicking acute myocardial syndrome</article-title><source>Heart</source><year>1997</year><volume>78</volume><fpage>509</fpage><lpage>511</lpage><pub-id pub-id-type="pmid">9415014</pub-id></mixed-citation></ref><ref id="b20-wjem-9-0104"><label>20</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Seth</surname><given-names>PS</given-names></name><name><surname>Aurigemma</surname><given-names>GP</given-names></name><name><surname>Krasnow</surname><given-names>JM</given-names></name><etal/></person-group><article-title>A syndrome of transient left ventricular apical wall motion abnormality in the absence of coronary disease: a perspective from the United States</article-title><source>Cardiology</source><year>2003</year><volume>100</volume><fpage>61</fpage><lpage>66</lpage><pub-id pub-id-type="pmid">14557691</pub-id></mixed-citation></ref><ref id="b21-wjem-9-0104"><label>21</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gianni</surname><given-names>M</given-names></name><name><surname>Dentali</surname><given-names>F</given-names></name><name><surname>Grandi</surname><given-names>AM</given-names></name><etal/></person-group><article-title>Apical ballooning syndrome or Takotsubo cardiomyopathy: a systematic review</article-title><source>Eur Heart J</source><year>2006</year><volume>27</volume><fpage>1523</fpage><lpage>1529</lpage><pub-id pub-id-type="pmi