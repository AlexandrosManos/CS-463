-type="editor"><name><surname>Janis CM, Scott KM, Jacobs LL</surname></name></person-group><article-title>Mustelidae</article-title><source>Evolution of Tertiary Mammals of North America</source><year>1998</year><volume>1</volume><publisher-name>Cambridge: Cambridge University Press</publisher-name><fpage>152</fpage><lpage>173</lpage></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schmidt-Kittler</surname><given-names>N</given-names></name></person-group><article-title>Zur Stammesgeschichte der mardervervandten Raubtiergruppen (Musteloidea, Carnivora)</article-title><source>Ecologae Geol Helv</source><year>1981</year><volume>74</volume><fpage>753</fpage><lpage>801</lpage></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wolsan</surname><given-names>M</given-names></name></person-group><article-title>Phylogeny and classification of early European <italic>Mustelida </italic>(Mammalia: Carnivora)</article-title><source>Acta Theriol</source><year>1993</year><volume>38</volume><fpage>345</fpage><lpage>384</lpage></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hunt</surname><given-names>RM</given-names><suffix>Jr</suffix></name></person-group><person-group person-group-type="editor"><name><surname>Gittleman JL</surname></name></person-group><article-title>Biogeography of the Order Carnivora</article-title><source>Carnivore Behavior, Ecology and Evolution</source><year>1996</year><volume>2</volume><publisher-name>Ithaca, NY: Cornell University Press</publisher-name><fpage>485</fpage><lpage>541</lpage></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>X</given-names></name><name><surname>Zhanxiang</surname><given-names>Q</given-names></name><name><surname>Wang</surname