n>3rd</edition><publisher-name>Philadelphia , North American Nursing Diagnosis Association</publisher-name></citation></ref><ref id="B5"><citation citation-type="book"><person-group person-group-type="author"><collab>Johnson M</collab><collab>Maas M</collab></person-group><source>Nursing Outcome Classification (NOC)</source><year>1997</year><publisher-name>St. Louis , Mosby</publisher-name></citation></ref><ref id="B6"><citation citation-type="book"><person-group person-group-type="author"><collab>International Council of Nurses</collab></person-group><source>International Classification for Nursing Practice (ICNP) - Beta 2 Version</source><year>2001</year><publisher-name>Geneva , International Council of Nurses</publisher-name></citation></ref><ref id="B7"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Weber</surname><given-names>P</given-names></name><name><surname>Bamert</surname><given-names>U</given-names></name><name><surname>Steuer</surname><given-names>B</given-names></name><name><surname>Spani</surname><given-names>S</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Marin Heimar</surname></name></person-group><article-title>Easy tool to collect Swiss nursing workload classification LEP(R)</article-title><source>International Congress in Nursing Informatics, 2003, Rio de Janeiro Proceeding of 8&#x000ba; International Congress in Nursing Informatics</source><year>2003</year><publisher-name>Washington , IMIA/NI</publisher-name></citation></ref><ref id="B8"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Maeder</surname><given-names>C</given-names></name><name><surname>Bamert</surname><given-names>U</given-names></name><name><surname>Baumberger</surname><given-names>D</given-names></name><name><surname>Dubach</surname><given-names>A</given-names></name><name><surname>K&#x000fc;hne</surname><given-names>G</given-names></name></person-group><article-title>Short Description of the LEP&#x000ae; Method: Nursing 2, Physiotherapy, Nursing 3</article-title><ext-link ext-link-type="uri" xlink:href="http://www.lep.ch/index.php?option=com_remository&#x00026;Itemid=27&#x00026;func=startdown&#x00026;id=65  "/></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><collab>Jelles F</collab><collab>van Bennekom CAM</collab><collab>Lankhorst GJ</collab></person-group><article-title>Instruments to structure interdisciplinary team conferences in rehabilitation medicine: added value of the rehabilitation activities profile</article-title><source>Journal of Rehabilitation Sciences</source><year>1995</year><volume>8</volume><fpage>51</fpage><lpage>57</lpage></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hawkins</surname><given-names>S</given-names></name><name><surname>Stone</surname><given-names>K</given-names></name><name><surname>Plummer</surname><given-names>L</given-names></name></person-group><article-title>An holistic approach to turning patients</article-title><source>Nursing Standard</source><year>1999</year><volume>14</volume><fpage>51</fpage><lpage>56</lpage><pub-id pub-id-type="pmid">10983058</pub-id></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><collab>World Health Organisation (WHO)</collab></person-group><source>International Classification of Functioning, Disability and Health: ICF.</source><year>2001</year><publisher-name>Geneva , WHO</publisher-name></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Van Achterberg</surname><given-names>T</given-names></name><name><surname>Holleman</surname><given-names>G</given-names></name><name><surname>Heijnen-Kaales</surname><given-names>Y</given-names></name><name><surname>Van der Brug</surname><given-names>Y</given-names></name><name><surname>Roodbol</surname><given-names>G</given-names></name><name><surname>Stallinga</surname><given-names>HA</given-names></name><name><surname>Hellema</surname><given-names>F</given-names></name><name><surname>Frederiks</surname><given-names>CM</given-names></name></person-group><article-title>Using a multidisciplinary classification in nursing: the International Classification of Functioning Disability and Health</article-title><source>Journal of Advanced Nursing</source><year>2005</year><volume>49</volume><fpage>432</fpage><lpage>441</lpage><pub-id pub-id-type="pmid">15701158</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2648.2004.03307.x</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heinen</surname><given-names>MM</given-names></name><name><surname>van Achterberg</surname><given-names>T</given-names></name><name><surname>Roodbol</surname><given-names>G</given-names></name><name><surname>Frederiks</surname><given-names>CMA</given-names></name></person-group><article-title>Applying ICF in nursing practice: classifying elements of nursing diagnoses</article-title><source>International Nursing Review</source><year>2005</year><volume>52</volume><fpage>304</fpage><lpage>312</lpage><pub-id pub-id-type="pmid">16238727</pub-id><pub-id pub-id-type="doi">10.1111/j.1466-7657.2005.00433.x</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van Achterberg</surname><given-names>T</given-names></name><name><surname>Frederiks</surname><given-names>C</given-names></name><name><surname>Thien</surname><given-names>N</given-names></name><name><surname>Coenen</surname><given-names>C</given-names></name><name><surname>Persoon</surname><given-names>A</given-names></name></person-group><article-title>Using ICIDH-2 in the classification of nursing diagnoses: results from two pilot studies</article-title><source>Journal of Advanced Nursing</source><year>2002</year><volume>37</volume><fpage>135</fpage><lpage>144</lpage><pub-id pub-id-type="pmid">11851781</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2648.2002.02085.x</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Boldt</surname><given-names>C</given-names></name><name><surname>Brach</surname><given-names>M</given-names></name><name><surname>Grill</surname><given-names>E</given-names></name><name><surname>Berthou</surname><given-names>A</given-names></name><name><surname>Meister</surname><given-names>K</given-names></name><name><surname>Monika</surname><given-names>S</given-names></name><name><surname>Stucki</surname><given-names>G</given-names></name></person-group><article-title>The ICF categories identified in nursing interventions administered to neurological patients with post-acute rehabilitation needs</article-title><source>Disability and Rehabilitation</source><year>2005</year><volume>27</volume><fpage>431</fpage><lpage>436</lpage><pub-id pub-id-type="pmid">16040546</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kearney</surname><given-names>PM</given-names></name><name><surname>Pryor</surname><given-names>J</given-names></name></person-group><article-title>The International Classification of Functioning, Disability and Health (ICF) and nursing</article-title><source>Journal of Advanced Nursing</source><year>2004</year><volume>46</volume><fpage>162</fpage><lpage>170</lpage><pub-id pub-id-type="pmid">15056329</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2648.2003.02976.x</pub-id></citation></ref><ref id="B17"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Br&#x000fc;gger</surname><given-names>U</given-names></name><name><surname>Bamert</surname><given-names>U</given-names></name><name><surname>Maeder</surname><g