e>185</fpage><lpage>208</lpage><pub-id pub-id-type="doi">10.1504/IJTG.2005.007050</pub-id></citation></ref><ref id="B20"><citation citation-type="other"><article-title>International partnerships of research excellence UK-USA academic collaboration</article-title><ext-link ext-link-type="uri" xlink:href="http://www.wolfson.ox.ac.uk/UK-US-Academic-Collaboration/GarethRobertsIPoREx.pdf"/></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Katz</surname><given-names>JS</given-names></name><name><surname>Martin</surname><given-names>BR</given-names></name></person-group><article-title>What is research collaboration?</article-title><source>Research Policy</source><year>1997</year><volume>26</volume><fpage>1</fpage><lpage>18</lpage><pub-id pub-id-type="doi">10.1016/S0048-7333(96)00917-1</pub-id></citation></ref></ref-list></back></article>