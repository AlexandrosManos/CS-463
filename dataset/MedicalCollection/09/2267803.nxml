age>594</fpage><lpage>599</lpage></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bosetti</surname><given-names>C</given-names></name><name><surname>Levi</surname><given-names>F</given-names></name><name><surname>Lucchini</surname><given-names>F</given-names></name><name><surname>Negri</surname><given-names>E</given-names></name><name><surname>La Vecchia</surname><given-names>C</given-names></name></person-group><article-title>Lung cancer mortality in European women: recent trends and perspectives</article-title><source>Ann Oncol</source><year>2005</year><volume>16</volume><fpage>1597</fpage><lpage>1604</lpage><pub-id pub-id-type="pmid">16014639</pub-id><pub-id pub-id-type="doi">10.1093/annonc/mdi313</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bernal P&#x000e9;rez</surname><given-names>M</given-names></name></person-group><article-title>Increase of lung cancer in women (in Spanish)</article-title><source>Med Clin (Barc)</source><year>2002</year><volume>119</volume><fpage>435</fpage><lpage>436</lpage></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weiss</surname><given-names>W</given-names></name></person-group><article-title>Cigarette Smoking and Lung Cancer Trends. A light at the end of the tunnel?</article-title><source>Chest</source><year>1997</year><volume>111</volume><fpage>1414</fpage><lpage>1416</lpage><pub-id pub-id-type="pmid">9149602</pub-id><pub-id pub-id-type="doi">10.1378/chest.111.5.1414</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tyczynski</surname><given-names>JE</given-names></name><name><surname>Bray</surname><given-names>F</given-names></name><name><surname>Parkin</surname><given-names>DM</given-names></name></person-group><article-title>Lung cancer in Europe in 2000: epidemiology, prevention, and early detection</article-title><source>Lancet Oncol</source><year>2003</year><volume>4</volume><fpage>45</fpage><lpage>55</lpage><pub-id pub-id-type="pmid">12517539</pub-id><pub-id pub-id-type="doi">10.1016/S1470-2045(03)00960-4</pub-id></citation></ref><ref id="B9"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lopez-Abente</surname><given-names>G</given-names></name><name><surname>Poll&#x000e1;n</surname><given-names>M</given-names></name><name><surname>Aragon&#x000e9;s</surname><given-names>N</given-names></name><name><surname>P&#x000e9;rez</surname><given-names>B</given-names></name><name><surname>Ll&#x000e1;cer</surname><given-names>A</given-names></name><name><surname>P&#x000e9;rez</surname><given-names>J</given-names></name><etal></etal></person-group><source>Mortality trends in Spain, 1952&#x02013;1996: age, cohort and period effect (in Spanish)</source><year>2002</year><publisher-name>Madrid: Instituto de Salud Carlos III</publisher-name></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><collab>European Commission</collab></person-group><source>The health status of the European Union Narrowing the health gap</source><year>2003</year><publisher-name>Luxembourg: Office for Official Publications of the European Communities</publisher-name></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Molarius</surname><given-names>A</given-names></name><name><surname>Parsons</surname><given-names>RW</given-names></name><name><surname>Dobson</surname><given-names>AJ</given-names></name><name><surname>Evans</surname><given-names>A</given-names></name><name><surname>Fortmann</surname><given-names>SP</given-names></name><name><surname>Jamrozik</surname><given-names>K</given-names></name><name><surname>Kuulasmaa</surname><given-names>K</given-names></name><name><surname>Moltchanov</surname><given-names>V</given-names></name><name><surname>Sans</surname><given-names>S</given-names></name><name><surname>Tuomilehto</surname><given-names>J</given-names></name><name><surname>Puska</surname><given-names>P</given-names></name></person-group><article-title>Trends in cigarette smoking in 36 populations from the early 1980s to the mid-1990s: findings from the WHO MONICA project</article-title><source>Am J Public Health</source><year>2001</year><volume>91</volume><fpage>206</fpage><lpage>212</lpage><pub-id pub-id-type="pmid">11211628</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Graham</surname><given-names>H</given-names></name></person-group><article-title>Smoking prevalence among women in the European community 1950&#x02013;1990</article-title><source>Soc Sci Med</source><year>1996</year><volume>43</volume><fpage>243</fpage><lpage>254</lpage><pub-id pub-id-type="pmid">8844928</pub-id><pub-id pub-id-type="doi">10.1016/0277-9536(95)00369-X</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brennan</surname><given-names>P</given-names></name><name><surname>Bray</surname><given-names>I</given-names></name></person-group><article-title>Recent trends and future directions for lung cancer mortality in Europe</article-title><source>Br J Cancer</source><year>2002</year><volume>87</volume><fpage>43</fpage><lpage>48</lpage><pub-id pub-id-type="pmid">12085254</pub-id><pub-id pub-id-type="doi">10.1038/sj.bjc.6600352</pub-id></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Mart&#x000ed;nez Beneito</surname><given-names>MA</given-names></name><name><surname>L&#x000f3;pez Qu&#x000ed;lez</surname><given-names>A</given-names></name><name><surname>Amador Iscla</surname><given-names>A</given-names></name><name><surname>Melchor Al&#x000f3;s</surname><given-names>I</given-names></name><name><surname>Botella Rocamora</surname><given-names>P</given-names></name><name><surname>Abell&#x000e1;n Andres</surname><given-names>C</given-names></name><name><surname>Abell&#x000e1;n Andr&#x000e9;s</surname><given-names>JJ</given-names></name><name><surname>Verdejo Ma&#x000f1;ez</surname><given-names>F</given-names></name><name><surname>Zurriaga Llor&#x000e9;ns</surname><given-names>O</given-names></name><name><surname>Vanaclocha Luna</surname><given-names>H</given-names></name><name><surname>Escolano Puig</surname><given-names>M</given-names></name></person-group><source>Mortality Atlas of the Comunitat Valenciana 1991&#x02013;2000 (in Spanish) Valencia (Spain)</source><year>2005</year><publisher-name>Generalitat Valenciana. Conselleria de Sanitat</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.sp.san.gva.es/DgspWeb/atlas/"/></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pickle</surname><given-names>LW</given-names></name><name><surname>Mungiole</surname><given-names>M</given-names></name><name><surname>Jones</surname><given-names>GK</given-names></name><name><surname>White</surname><given-names>AA</given-names></name></person-group><article-title>Exploring spatial patterns of mortality: the new atlas of United States mortality</article-title><source>Stat Med</source><year>1999</year><volume>18</volume><fpage>3211</fpage><lpage>3220</lpage><pub-id pub-id-type="pmid">10602146</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1097-0258(19991215)18:23&#x0003c;3211::AID-SIM311&#x0003e;3.0.CO;2-Q</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Devesa</surname><given-names>SS</given-names></name><name><surname>Grauman</surname><given-names>DJ</given-names></name><name><surname>Blot</surname><given-names>WJ</given-names></name><name><surname>Fraumeni</surname><given-names>JF</given-names></name></person-group><article-title>Cancer surveillance series: changing geographic patterns of lung cancer mortality in the United States, 1950 through 1994</article-title><source>J Natl Can Inst</source><year>1999</year><volume>91</volume><fpage>1040</fpage><lpage>1050</lpage><pub-id pub-id-type="doi">10.1093/jnci/91.12.1040</pub-id></citation></ref><ref id="B17"><citation citation-type="book"><source>International Classification of Diseases, 9th revision, Clinical Modification</source><year>1979</year><publisher-name>Washington, DC: Department of Health and Human Services (DHHS No. PHS 80&#x02013;1260)</publisher-name></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><collab>World Health Organization</collab></person-group><source>International Classification of Diseases, (ICD-10) Tenth Revision, WHO edition</source><year>1992</year><publisher-name>Geneva, Switzerland</publisher-name></citation></ref><ref id="B19"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Mart&#x000ed;nez-Beneito</surname><given-names>MA</given-names></name><name><surname>L&#x000f3;pez Qu&#x000ed;lez</surname><given-names>A</given-names></name><name><surname>Botella Rocamora</surname><given-names>P</given-names></name></person-group><article-title>An autoregressive approach to spatio-temporal disease mapping</article-title><source>Statistics in medicine</source><year>2007</year><comment>Published on-line. DOI: 10.1002/sim.3103</comment></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Spiegelhalter</surname><given-names>DJ</given-names></name><name><surname>Best</surname><given-names>NG</given-names></name><name><surname>Carlin</surname><given-names>BP</given-names></name><etal></etal></person-group><article-title>Bayesian measures of model complexity and fit (with discussion