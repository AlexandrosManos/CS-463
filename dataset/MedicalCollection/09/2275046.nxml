year>2002</year><pub-id pub-id-type="pmid">11912488</pub-id><pub-id pub-id-type="doi">10.1038/nature734</pub-id><person-group><name><surname>Gottar</surname><given-names>M</given-names></name><name><surname>Gobert</surname><given-names>V</given-names></name><name><surname>Michel</surname><given-names>T</given-names></name><name><surname>Belvin</surname><given-names>M</given-names></name><name><surname>Duyk</surname><given-names>G</given-names></name></person-group></citation></ref><ref id="r9"><citation citation-type="journal"><article-title>Functional genomic analysis of phagocytosis and identification of a Drosophila receptor for E. coli.</article-title><source>Nature</source><volume>416</volume><fpage>644</fpage><lpage>648</lpage><year>2002</year><pub-id pub-id-type="pmid">11912489</pub-id><pub-id pub-id-type="doi">10.1038/nature735</pub-id><person-group><name><surname>Ramet</surname><given-names>M</given-names></name><name><surname>Manfruelli</surname><given-names>P</given-names></name><name><surname>Pearson</surname><given-names>A</given-names></name><name><surname>Mathey-Prevot</surname><given-names>B</given-names></name><name><surname>Ezekowitz</surname><given-names>RA</given-names></name></person-group></citation></ref><ref id="r10"><citation citation-type="journal"><article-title>Drosophila immune deficiency (IMD) is a death domain protein that activates antibacterial defense and can promote apoptosis.</article-title><source>Dev Cell</source><volume>1</volume><fpage>503</fpage><lpage>514</lpage><year>2001</year><pub-id pub-id-type="pmid">11703941</pub-id><pub-id pub-id-type="doi">10.1016/S1534-5807(01)00059-4</pub-id><person-group><name><surname>Georgel</surname><given-names>P</given-names></name><name><surname>Naitza</surname><given-names>S</given-names></name><name><surname>Kappler</surname><given-names>C</given-names></name><name><surname>Ferrandon</surname><given-names>D</given-names></name><name><surname>Zachary</surname><given-names>D</given-names></name></person-group></citation></ref><ref id="r11"><citation citation-type="journal"><article-title>Inhibitor of apoptosis 2 and TAK1-binding protein are components of the Drosophila Imd pathway.</article-title><source>Embo J</source><volume>24</volume><fpage>3423</fpage><lpage>3434</lpage><year>2005</year><pub-id pub-id-type="pmid">16163390</pub-id><pub-id pub-id-type="doi">10.1038/sj.emboj.7600807</pub-id><person-group><name><surname>Kleino</surname><given-names>A</given-names></name><name><surname>Valanne</surname><given-names>S</given-names></name><name><surname>Ulvila</surname><given-names>J</given-names></name><name><surname>Kallio</surname><given-names>J</given-names></name><name><surname>Myllymaki</surname><given-names>H</given-names></name></person-group></citation></ref><ref id="r12"><citation citation-type="journal"><article-title>An RNA interference screen identifies Inhibitor of Apoptosis Protein 2 as a regulator of innate immune signalling in Drosophila.</article-title><source>EMBO Rep</source><volume>6</volume><fpage>979</fpage><lpage>984</lpage><year>2005</year><pub-id pub-id-type="pmid">16170305</pub-id><pub-id pub-id-type="doi">10.1038/sj.embor.7400530</pub-id><person-group><name><surname>Gesellchen</surname><given-names>V</given-names></name><name><surname>Kuttenkeuler</surname><given-names>D</given-names></name><name><surname>Steckel</surname><given-names>M</given-names></name><name><surname>Pelte</surname><given-names>N</given-names></name><name><surname>Boutros</surname><given-names>M</given-names></name></person-group></citation></ref><ref id="r13"><citation citation-type="journal"><article-title>Mutations in the Drosophila dTAK1 gene reveal a conserved function for MAPKKKs in the control of rel/NF-kappaB-dependent innate immune responses.</article-title><source>Genes Dev</source><volume>15</volume><fpage>1900</fpage><lpage>1912</lpage><year>2001</year><pub-id pub-id-type="pmid">11485985</pub-id><pub-id pub-id-type="doi">10.1101/gad.203301</pub-id><person-group><name><surname>Vidal</surname><given-names>S</given-names></name><name><surname>Khush</surname><given-names>RS</given-names></name><name><surname>Leulier</surname><given-names>F</given-names></name><name><surname>Tzou</surname><given-names>P</given-names></name><name><surname>Nakamura</surname><given-names>M</given-names></name></person-group></citation></ref><ref id="r14"><citation citation-type="journal"><article-title>Immune activation of NF-kappaB and JNK requires Drosophila TAK1.</article-title><source>J Biol Chem</source><volume>278</volume><fpage>48928</fpage><lpage>48934</lpage><year>2003</year><pub-id pub-id-type="pmid">14519762</pub-id><pub-id pub-id-type="doi">10.1074/jbc.M304802200</pub-id><person-group><name><surname>Silverman</surname><given-names>N</given-names></name><name><surname>Zhou</surname><given-names>R</given-names></name><name><surname>Erlich</surname><given-names>RL</given-names></name><name><surname>Hunter</surname><given-names>M</given-names></name><name><surname>Bernstein</surname><given-names>E</given-names></name></person-group></citation></ref><ref id="r15"><citation citation-type="journal"><article-title>Sequential Activation of Signaling Pathways during Innate Immune Responses in Drosophila.</article-title><source>Dev Cell</source><volume>3</volume><fpage>711</fpage><lpage>722</lpage><year>2002</year><pub-id pub-id-type="pmid">12431377</pub-id><pub-id pub-id-type="doi">10.1016/S1534-5807(02)00325-8</pub-id><person-group><name><surname>Boutros</surname><given-names>M</given-names></name><name><surname>Agaisse</surname><given-names>H</given-names></name><name><surname>Perrimon</surname><given-names>N</given-names></name></person-group></citation></ref><ref id="r16"><citation citation-type="journal"><article-title>A Drosophila IkappaB kinase complex required for Relish cleavage and antibacterial immunity.</article-title><source>Genes Dev</source><volume>14</volume><fpage>2461</fpage><lpage>2471</lpage><year>2000</year><pub-id pub-id-type="pmid">11018014</pub-id><pub-id pub-id-type="doi">10.1101/gad.817800</pub-id><person-group><name><surname>Silverman</surname><given-names>N</given-names></name><name><surname>Zhou</surname><given-names>R</given-names></name><name><surname>Stoven</surname><given-names>S</given-names></name><name><surname>Pandey</surname><given-names>N</given-names></name><name><surname>Hultmark</surname><given-names>D</given-names></name></person-group></citation></ref><ref id="r17"><citation citation-type="journal"><article-title>Origins of immunity: Relish, a compound Rel-like gene in the antibacterial defense of Drosophila.</article-title><source>Proc Natl Acad Sci USA</source><volume>93</volume><fpage>10343</fpage><lpage>10347</lpage><year>1996</year><pub-id pub-id-type="pmid">8816802</pub-id><pub-id pub-id-type="doi">10.1073/pnas.93.19.10343</pub-id><person-group><name><surname>Dushay</surname><given-names>MS</given-names></name><name><surname>Asling</surname><given-names>B</given-names></name><name><surname>Hultmark</surname><given-names>D</given-names></name></person-group></citation></ref><ref id="r18"><citation citation-type="journal"><article-title>Regulated nuclear import of Rel proteins in the Drosophila immune response.</article-title><source>Nature</source><volume>293</volume><fpage>93</fpage><lpage>97</lpage><year>1998</year><pub-id pub-id-type="doi">10.1038/32195</pub-id><person-group><name><surname>Wu</surname><given-names>LP</given-names></name><name><surname>Anderson</surname><given-names>KV</given-names></name></person-group><pub-id pub-id-type="pmid">9510254</pub-id></citation></ref><ref id="r19"><citation citation-type="journal"><article-title>Caspase-mediated processing of the Drosophila NF-kappaB factor Relish.</article-title><source>Proc Natl Acad Sci USA</source><volume>100</volume><fpage>5991</fpage><lpage>5996</lpage><year>2003</year><pub-id pub-id-type="pmid">12732719</pub-id><pub-id pub-id-type="doi">10.1073/pnas.1035902100</pub-id><