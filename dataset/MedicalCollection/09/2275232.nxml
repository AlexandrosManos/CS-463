person-group-type="editor"><name><surname>RN S</surname></name></person-group><article-title>Corrosion of metallic implants</article-title><source>Advances in Orthopaedic Surgery Vol 2</source><year>1994</year><publisher-name>St. Louis, Mosby</publisher-name><fpage>279</fpage><lpage>319</lpage></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jacobs</surname><given-names>JJ</given-names></name><name><surname>Skipor</surname><given-names>AK</given-names></name><name><surname>Black</surname><given-names>J</given-names></name><name><surname>L</surname><given-names>M</given-names></name><name><surname>Urban</surname><given-names>RL</given-names></name><name><surname>Galante</surname><given-names>JO</given-names></name></person-group><article-title>Metal release in patients with loose titanium-alloy total hip replacements</article-title><source>Trans of the fourth world biomaterials conference, Berlin</source><year>1992</year><volume>266</volume></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Black</surname><given-names>J</given-names></name></person-group><article-title>Systemic effects of biomaterials</article-title><source>Biomater</source><year>1984</year><volume>5</volume><fpage>12</fpage><lpage>17</lpage></citation></ref><ref id="B12"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Jacobs</surname><given-names>JJ</given-names></name></person-group><article-title>Particulate wear</article-title><year>1994</year><fpage>83</fpage><lpage>87</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yang</surname><given-names>J</given-names></name><name><surname>Black</surname><given-names>J</given-names></name></person-group><article-title>Competitive binding of chromium cobalt and nickel to serum proteins</article-title><source>Biomater</source><year>1994</year><volume>15</volume><fpage>262</fpage><lpage>268</lpage><pub-id pub-id-type="doi">10.1016/0142-9612(94)90049-3</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yang</surname><given-names>J</given-names></name><name><surname>Merritt</surname><given-names>K</given-names></name></person-group><article-title>Production of monoclonal antibodies to study corrosion of Co-Cr biomaterials</article-title><source>J Biomed Mater Res</source><year>1996</year><volume>31</volume><fpage>71</fpage><lpage>80</lpage><pub-id pub-id-type="pmid">8731151</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1097-4636(199605)31:1&#x0003c;71::AID-JBM9&#x0003e;3.0.CO;2-N</pub-id></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Liden</surname><given-names>C</given-names></name><name><surname>Maibach</surname><given-names>HI</given-names></name><name><surname>Howard</surname><given-names>I</given-names></name><name><surname>Wahlberg</surname><given-names>JE</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Goyer RA, Klaasen CD and Waalkes M</surname></name></person-group><source>Skin</source><year>1995</year><publisher-name>New York, Academic Press</publisher-name><fpage>447</fpage><lpage>464</lpage></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Angle</surname><given-names>C</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Goyer RA, Klaassen CD and Waalkes MP</surname></name></person-group><article-title>Organ-specific Therapeutic Intervention</article-title><source>Metal Toxicology</source><year>1995</year><publisher-name>New York, Academic Press</publisher-name><fpage>71</fpage><lpage>110</lpage></citation></ref><ref id="B17"><citation citation-type="journal"