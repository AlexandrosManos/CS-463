e><surname>Rush</surname><given-names>JS</given-names></name><name><surname>Deenick</surname><given-names>E</given-names></name><name><surname>Avery</surname><given-names>D</given-names></name><name><surname>Jun</surname><given-names>J</given-names></name><name><surname>Hodgkin</surname><given-names>PD</given-names></name></person-group></citation></ref><ref id="r8"><citation citation-type="journal"><article-title>S-phase detection with an antibody to bromodeoxyuridine. Role of DNase pretreatment.</article-title><source>J immunol Methods</source><fpage>93</fpage><lpage>97</lpage><year>1986</year><person-group><name><surname>Gonchoroff</surname><given-names>NJ</given-names></name><name><surname>Katzmann</surname><given-names>JA</given-names></name><name><surname>Surriw</surname><given-names>RM</given-names></name><name><surname>Evans</surname><given-names>EL</given-names></name><name><surname>Houck</surname><given-names>DW</given-names></name><name><surname>Kline</surname><given-names>BC</given-names></name><name><surname>Greipp</surname><given-names>PR</given-names></name><name><surname>Loken</surname><given-names>MR</given-names></name></person-group><pub-id pub-id-type="pmid">3486230</pub-id></citation></ref><ref id="r9"><citation citation-type="journal"><article-title>Characterization of monoclonal antibodies to bromodeoxyuridine.</article-title><source>Cytometry</source><fpage>6</fpage><lpage>501</lpage><year>1985</year><person-group><name><surname>Vanderlaan</surname><given-names>M</given-names></name><name><surname>Thomas</surname><given-names>CB</given-names></name></person-group></citation></ref><ref id="r10"><citation citation-type="journal"><article-title>Determination of lymphocyte division by flow cytometry.</article-title><source>J. Immunol. Methods</source><fpage>171</fpage><lpage>183</lpage><year>1994</year><person-group><name><surname>Lyons</surname><given-names>AB</given-names></name><name><surname>Parish</surname><given-names>CR</given-names></name></person-group></citation></ref><ref id="r11"><citation citation-type="journal"><article-title>Functional Signatures in antiviral T cell Immunity for monitoring virus associated diseases.</article-title><source>Nature Rev Immunol</source><volume>6</volume><fpage>417</fpage><lpage>422</lpage><year>2006</year><pub-id pub-id-type="pmid">16622477</pub-id><pub-id pub-id-type="doi">10.1038/nri1840</pub-id><person-group><name><surname>Pantaleo</surname><given-names>G</given-names></name><name><surname>Harari</surname><given-names>A</given-names></name></person-group></citation></ref><ref id="r12"><citation citation-type="journal"><article-title>T cells and viral persistence: lessons from diverse infections.</article-title><source>Nature Immunol.</source><volume>6</volume><fpage>873</fpage><lpage>879</lpage><year>2005</year><pub-id pub-id-type="pmid">16116467</pub-id><pub-id pub-id-type="doi">10.1038/ni1241</pub-id><person-group><name><surname>Klenerman</surname><given-names>P</given-names></name><name><surname>Hill</surname><given-names>A</given-names></name></person-group></citation></ref><ref id="r13"><citation citation-type="journal"><article-title>HIV specific CD8T cell proliferation is coupled to perforin expression in nonprogressors.</article-title><source>Nature Immunol</source><volume>3</volume><fpage>1061</fpage><lpage>1068</lpage><year>2002</year><pub-id pub-id-type="pmid">12368910</pub-id><pub-id pub-id-type="doi">10.1038/ni845</pub-id><person-group><name><surname>Migueles</surname><given-names>SA</given-names></name><name><surname>Laborico</surname><given-names>AC</given-names></name><name><surname>Shupert</surname><given-names>WL</given-names></name><name><surname>Sabbaghian</surname><given-names>MS</given-names></name><name><surname>Rabin</surname><given-names>R</given-names></name><name><surname>Hallahan</surname><given-names>CW</given-names></name><name><surname>Van Baarle</surname><given-names>D</given-names></name><name><surname>Kostense</surname><given-names>S</given-names></name><name><surname>Miedema</surname><given-names>F</given-names></name><name><surname>McLaughlin</surname><given-names>M</given-names></name><name><surname>Ehler</surname><given-names>L</given-names></name><name><surname>Metcalf</surname><given-names>J</given-names></name><name><surname>Liu</surname><given-names>S</given-names></name><name><surname>Connors</surname><given-names>M</given-names></name></person-group></citation></ref><ref id="r14"><citation citation-type="journal"><article-title>Large clonal expansions of human virus-specific memory cytotoxic T lymphocytes within the CD57+CD38-CD8+ T cell population.</article-title><source>Immunology</source><volume>98</volume><fpage>443</fpage><lpage>449</lpage><year>1999</year><pub-id pub-id-type="pmid">10583606</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2567.1999.00901.x</pub-id><person-group><name><surname>Weekes</surname><given-names>M</given-names></name><name><surname>Wills</surname><given-names>MR</given-names></name><name><surname>Mynard</surname><given-names>K</given-names></name><name><surname>Hicks</surname><given-names>R</given-names></name><name><surname>Sissons</surname><given-names>JG</given-names></name><name><surname>Carmichael</surname><given-names>AJ</given-names></name></person-group></citation></ref><ref id="r15"><citation citation-type="journal"><article-title>Viral-antigen dependence and T cell receptor expression in leucocytes from rhabdovirus immunized trout.</article-title><source>Vet Immunol Immunopath</source><volume>68</volume><fpage>73</fpage><lpage>89</lpage><year>1999</year><pub-id pub-id-type="doi">10.1016/S0165-2427(99)00013-6</pub-id><person-group><name><surname>Estepa</surname><given-names>A</given-names></name><name><surname>Alvarez</surname><given-names>F</given-names></name><name><surname>Ezquerrra</surname><given-names>A</given-names></name><name><surname>Coll</surname><given-names>JM</given-names></name></person-group></citation></ref><ref id="r16"><citation citation-type="journal"><article-title>Development and characterization of a model system to study amphibian immune responses to iridoviruses.</article-title><source>Virology</source><volume>311</volume><issue>2</issue><fpage>254</fpage><lpage>262</lpage><year>2003</year><pub-id pub-id-type="pmid">12842616</pub-id><pub-id pub-id-type="doi">10.1016/S0042-6822(03)00151-X</pub-id><person-group><name><surname>Gantress</surname><given-names>J</given-names></name><name><surname>Maniero</surname><given-names>GD</given-names></name><name><surname>Cohen</surname><given-names>N</given-names></name><name><surname>Robert</surname><given-names>J</given-names></name></person-group></citation></ref><ref id="r17"><citation citation-type="journal"><article-title>Adaptive immunity and histopathology in frog virus 3-infected Xenopus.</article-title><source>Virology</source><volume>332</volume><fpage>667</fpage><lpage>675</lpage><year>2005</year><pub-id pub-id-type="doi">10.1016/j.virol.2004.12.012</pub-id><person-group><name><surname>Robert</surname><given-names>J</given-names></name><name><surname>Morales</surname><given-names>H</given-names></name><name><surname>Wayne</surname><given-names>B</given-names></name><name><surname>Cohen</surname><given-names>N</given-names></name><name><surname>Marr</surname><given-names>S</given-names></name><name><surname>Gantress</surname><given-names>J</given-names></name></person-group><pub-id pub-id-type="pmid">15680432</pub-id></citation></ref><ref id="r18"><citation citation-type="journal"><article-title>In vivo characterization of primary and secondary anti- ranavirus CD8 T cell responses in Xenopus laevis.</article-title><source>J Virology</source><volume>81</volume><fpage>2240</fpage><lpage>2248</lpage><year>2007</year><pub-id pub-id-type="pmid">17182687</pub-id><pub-id pub-id-type="doi">10.1128/JVI.01104-06</pub-id><person-group><name><surname>Morales</surname><given-names>H</given-names></name><name><surname>Robert</surname><given-names>J</given-names></name></person-group></citation></ref><ref id="r19"><citation citation-type="journal"><article-title>Reagents specific for MHC I antigens of Xenopus.</article-title><source>Amer Zool</source><volume>31</volume><fpage>580</fpage><lpage>591</lpage><year>1991</year><person-group><name><surname>Flajnik</surname><given-names>MF</given-names></name><name><surname>Taylor</surname><given-names>E</given-names></name><name><surname>Canel</surname><given-names>C</given-names></name><name><surname>Grossberge</surname><given-names>D</given-names></name><name><surname>Du Pasquier</surname><given-names>L</given-names></name></person-group></citation></ref><ref id="r20"><citation citation-type="journal"><article-title>Studies in Xenopus immunoglobulins using monoclonal antibodies.</article-title><source>Mol Immunol</source><volume>21</volume><fpage>257</fpage><lpage>270</lpage><year>1984</year><pub-id pub-id-type="pmid">6203031</pub-id><pub-id pub-id-type="doi">10.1016/0161-5890(84)90096-8</pub-id><person-group><name><surname>Hsu</surname><given-names>E</given-names></name><name><surname>Du Pasquier</surname><given-names>L</given-names></name></person-group></citation></ref><ref id="r21"><citation citation-type="journal"><article-title>Phylogeny of Lymphocyte Structure and Function.</article-title><source>Amer Zool</source><volume>15</volume><issue>1</issue><fpage>119</fpage><lpage>133</lpage><year>1975</year><person-group><name><surname>Cohen</surname><given-names>N</given-names></name></person-group></citation></ref><ref id="r22"><citation citation-type="journal"><article-title>Generation of a long-lasting, protective, and neutralizing antibody response to the ranavirus FV3 by the frog Xenopus.</article-title><source>Devel Comp Immunol</source><volume>30</volume><fpage>649</fpage><lpage>657</lpage><year>2006</year><pub-id pub-id-type="pmid">16380162</pub-id><pub-id pub-id-type="doi">10.1016/j.dci.2005.09.007</pub-id><person-group><name><surname>Maniero</surname><given-names>CD</given-names></name><name><surname>Morales</surname><given-names>H</given-names></name><name><surname>Gantress</surname><given-names>J</given-names></name><name><surname>Robert</surname><given-names>J</given-names></name></person-group></citation></ref><ref id="r23"><citation citation-type="journal"><article-title>Phylogenetic conservation of gp96-mediated antigen specific cellular immunity: New evidence from adoptive cell transfer in Xenopus.</article-title><source>Transplantation</source><volume>78</volume><issue>10</issue><fpage>1415</fpage><lpage>1421</lpage><year>2004</year><pub-id pub-id-type="pmid">15599304</pub-id><pub-id pub-id-type="doi">10.1097/01.TP.0000140846.73210.91</pub-id><person-group><name><surname>Maniero</surname><given-names>CD</given-names></name><name><surname>Robert</surname><given-names>J</given-names></name></person-group></citation></ref></ref-list></back></article>