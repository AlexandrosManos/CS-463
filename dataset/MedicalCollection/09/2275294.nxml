mes></name><name><surname>Zurn</surname><given-names>P</given-names></name><name><surname>Diallo</surname><given-names>K</given-names></name><name><surname>Adams</surname><given-names>O</given-names></name><name><surname>Dal Poz</surname><given-names>MR</given-names></name></person-group><article-title>The role of wages in the migration of health care professionals from developing countries</article-title><source>Hum Resour Health</source><year>2004</year><volume>2</volume><fpage>3</fpage><pub-id pub-id-type="pmid">15115549</pub-id><pub-id pub-id-type="pmid">15115549</pub-id><pub-id pub-id-type="doi">10.1186/1478-4491-2-3</pub-id></citation></ref><ref id="B17"><citation citation-type="other"><article-title>Uganda 2007 Crime &#x00026; Safety Report</article-title></citation></ref><ref id="B18"><citation citation-type="other"><person-group person-group-type="author"><collab>International Migration and the Millennium Development Goals</collab></person-group><article-title>Selected Papers of the UNFPA Expert Group Meeting</article-title><source>United Nations Population Fund</source><year>2005</year><fpage>1</fpage><lpage>261</lpage></citation></ref><ref id="B19"><citation citation-type="other"><person-group person-group-type="author"><collab>Health Mo</collab></person-group><article-title>Human Resources for Health Policy</article-title><year>2006</year><fpage>1</fpage><lpage>26</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mullan</surname><given-names>F</given-names></name></person-group><article-title>Some thoughts on the white-follows-green law</article-title><source>Health Affairs (Millwood)</source><year>2002</year><volume>21</volume><fpage>158</fpage><lpage>159</lpage><pub-id pub-id-type="pmid">11900068</pub-id><pub-id pub-id-type="doi">10.1377/hlthaff.21.1.158</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><su