e="row" rowspan="1" colspan="1"><hr/></td><td valign="top" align="left" rowspan="1" colspan="1"><hr/></td><td valign="top" align="left" rowspan="1" colspan="1">K.LVAASQAALGL.-<hr/></td><td valign="top" align="left" rowspan="1" colspan="1">1014.2<hr/></td><td valign="top" align="left" rowspan="1" colspan="1">0.59<hr/></td><td valign="top" align="left" rowspan="1" colspan="1">3.39<hr/></td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1"><hr/></td><td valign="top" align="left" rowspan="1" colspan="1"><hr/></td><td valign="top" align="left" rowspan="1" colspan="1">K.CCAAADPHECYAK.V<hr/></td><td valign="top" align="left" rowspan="1" colspan="1">1553.63<hr/></td><td valign="top" align="left" rowspan="1" colspan="1">0.36<hr/></td><td valign="top" align="left" rowspan="1" colspan="1">4.29<hr/></td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1"><hr/></td><td valign="top" align="left" rowspan="1" colspan="1"><hr/></td><td valign="top" align="left" rowspan="1" colspan="1">R.RPCFSALEVDETYVPK.E<hr/></td><td valign="top" align="left" rowspan="1" colspan="1">1912.12<hr/></td><td valign="top" align="left" rowspan="1" colspan="1">0.32<hr/></td><td valign="top" align="left" rowspan="1" colspan="1">3.87<hr/></td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1"><hr/></td><td valign="top" align="left" rowspan="1" colspan="1"><hr/></td><td valign="top" align="left" rowspan="1" colspan="1">K.QNCELFEQLGEYK.F<hr/></td><td valign="top" align="left" rowspan="1" colspan="1">1658.78<hr/></td><td valign="top" align="left" rowspan="1" colspan="1">0.56<hr/></td><td valign="top" align="left" rowspan="1" colspan="1">4.37<hr/></td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1"><hr/></td><td valign="top" align="left" rowspan="1" colspan="1"><hr/></td><td valign="top" align="left" rowspan="1" colspan="1">K.EFNAETFTFHADICTLSEK.E<hr/></td><td valign="top" align="left" rowspan="1" colspan="1">2261.