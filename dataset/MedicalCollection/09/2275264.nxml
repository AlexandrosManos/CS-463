><given-names>A</given-names></name><name><surname>Fitzgerald</surname><given-names>S</given-names></name><name><surname>Vogelzang</surname><given-names>R</given-names></name></person-group><article-title>Renal Manifestations of AIDS</article-title><source>RadioGraphics</source><year>1993</year><volume>13</volume><fpage>587</fpage><lpage>596</lpage><pub-id pub-id-type="pmid">8316666</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rao</surname><given-names>TK</given-names></name><name><surname>Filippone</surname><given-names>EJ</given-names></name><name><surname>Nicastri</surname><given-names>AD</given-names></name><name><surname>Landesman</surname><given-names>SH</given-names></name><name><surname>Frean</surname><given-names>E</given-names></name><name><surname>Chen</surname><given-names>CK</given-names></name><name><surname>Friedman</surname><given-names>EA</given-names></name></person-group><article-title>Associated focal and segmental glomerulosclerosis in the Acquired Immunodeficiency Syndrome</article-title><source>N Engl J Med</source><year>1984</year><volume>310</volume><fpage>669</fpage><lpage>673</lpage><pub-id pub-id-type="pmid">6700641</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Frassetto</surname><given-names>L</given-names></name><name><surname>Schwenfeld</surname><given-names>P</given-names></name><name><surname>Humphrey</surname><given-names>M</given-names></name></person-group><article-title>Increasing incidence of human Immunodeficiency virus &#x02013; associated nephropathy at San Francisco General Hospital</article-title><source>Am J Kidney Dis</source><year>1991</year><volume>18</volume><fpage>655</fpage><lpage>659</lpage><pub-id pub-id-type="pmid">1962649</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vella</surname><given-names>S</given-names></name><name><surname>Giuliano</surname><given-names>M</given-names></name><name><surname>Pezzotti</surname><given-names>P</given-names></name><name><surname>Agresti</surname><given-names>MG</given-names></name><name><surname>Tomino</surname><given-names>C</given-names></name><name><surname>Floridia</surname><given-names>M</given-names></name><name><surname>Greco</surname><given-names>D</given-names></name><name><surname>Moroni</surname><given-names>M</given-names></name><name><surname>Visco</surname><given-names>G</given-names></name><name><surname>Milazzo</surname><given-names>Fl</given-names></name></person-group><article-title>Survival of zidovudine-treated patients with AIDS compared with that of contemporary untreated patients. Italian Zidovudine Evaluation Group</article-title><source>JAMA</source><year>1992</year><volume>267</volume><fpage>1232</fpage><lpage>1236</lpage><pub-id pub-id-type="pmid">1538560</pub-id><pub-id pub-id-type="doi">10.1001/jama.267.9.1232</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gold</surname><given-names>JWN</given-names></name></person-group><article-title>HIV infection: diagnosis and management</article-title><source>Med Clin North Am</source><year>1992</year><volume>76</volume><fpage>1</fpage><lpage>18</lpage><pub-id pub-id-type="pmid">1727532</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schaffer</surname><given-names>RM</given-names></name><name><surname>Schwartz</surname><given-names>GE</given-names></name><name><surname>Becker</surname><given-names>JA</given-names></name><name><surname>Rao</surname><given-names>TKS</given-names></name><name><surname>Shih</surname><given-names>YH</given-names></name></person-group><article-title>Renal ultrasound in acquired immunodeficiency syndrome</article-title><source>Radiology</source><year>1984</year><volume>153</volume><fpage>511</fpage><lpage>513</lpage><pub-id pub-id-type="pmid">6385112</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Valeri</surname><given-names>A</given-names></name><name><surname>Neusy</surname><given-names>AJ</given-names></name></person-group><article-title>Acute and chronic renal disease in hospitalized AIDS patients</article-title><source>Clin Nephrol</source><year>1991</year><volume>35</volume><fpage>110</fpage><lpage>118</lpage><pub-id pub-id-type="pmid">2032395</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bourgoignie</surname><given-names>JJ</given-names></name><name><surname>Meneses</surname><given-names>R</given-names></name><name><surname>Ortiz</surname><given-names>C</given-names></name><name><surname>Jaffe</surname><given-names>D</given-names></name><name><surname>Pardo</surname><given-names>V</given-names></name></person-group><article-title>The clinical spectrum of renal disease associated with human immunodeficiency virus</article-title><source>Am J Kidney Dis</source><year>1988</year><volume>12</volume><fpage>131</fpage><lpage>137</lpage><pub-id pub-id-type="pmid">3041800</pub-id></citation></ref></ref-list></back></article>