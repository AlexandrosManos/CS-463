ame><name><surname>Zhuang</surname><given-names>P</given-names></name><name><surname>Geng</surname><given-names>J</given-names></name></person-group><article-title>Real-time 3D-surface-guided head refixation useful for fractionated stereotactic radiotherapy</article-title><source><italic>Medical Physics</italic></source><year>2006</year><volume>33</volume><issue>2</issue><fpage>492</fpage><lpage>503</lpage><pub-id pub-id-type="pmid">16532957</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Djajaputra</surname><given-names>D</given-names></name><name><surname>Li</surname><given-names>S</given-names></name></person-group><article-title>Real-time 3D surface-image-guided beam setup in radiotherapy of breast cancer</article-title><source><italic>Medical Physics</italic></source><year>2005</year><volume>32</volume><issue>1</issue><fpage>65</fpage><lpage>75</lpage><pub-id pub-id-type="pmid">15719956</pub-id></citation></ref><ref id="B14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nelder</surname><given-names>JA</given-names></name><name><surname>Mead</surname><given-names>R</given-names></name></person-group><article-title>A simplex method for function minimization</article-title><source><italic>Computer</italic></source><year>1965</year><volume>5</volume><issue>7</issue><fpage>308</fpage><lpage>313</lpage></citation></ref><ref id="B15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>M&#x000e4;kel&#x000e4;</surname><given-names>T</given-names></name><name><surname>Clarysse</surname><given-names>P</given-names></name><name><surname>Sipil&#x000e4;</surname><given-names>O</given-names></name><etal/></person-group><article-title>A review of cardiac image registration methods</article-title><source><italic>IEEE Transactions on Medical Imaging</italic></source><year>2002</year><volume>21</volume><issue>9</issue><fpage>1011</fpage><lpage>1021</lpage><pub-id pub-id-type="pmid">12564869</pub-id></citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van den Elsen</surname><given-names>PA</given-names></name><name><surname>Pol</surname><given-names>EJD</given-names></name><name><surname>Viergever</surname><given-names>MA</given-names></name></person-group><article-title>Medical image matching-a review with classification</article-title><source><italic>IEEE Engineering in Medicine and Biology Magazine</italic></source><year>1993</year><volume>12</volume><issue>1</issue><fpage>26</fpage><lpage>39</lpage></citation></ref><ref id="B17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maintz</surname><given-names>JBA</given-names></name><name><surname>Viergever</surname><given-names>MA</given-names></name></person-group><article-title>A survey of medical image registration</article-title><source><italic>Medical Image Analysis</italic></source><year>1998</year><volume>2</volume><issue>1</issue><fpage>1</fpage><lpage>36</lpage><pub-id pub-id-type="pmid">10638851</pub-id></citation></ref><ref id="B18"><label>18</label><citation citation-type="confproc"><person-group person-group-type="author"><name><surname>Efrat</surname><given-names>A</given-names></name><name><surname>Itai</surname><given-names>A</given-names></name></person-group><article-title>Improvements on bottleneck matching and related problems using geometry</article-title><month>5</month><conf-name>In: Proceedings of the 12th Annual Symposium on Computational Geometry</conf-name><conf-date>1996</conf-date><conf-loc>Philadelphia, Pa, USA</conf-loc><fpage>301</fpage><lpage>310</lpage></citation></ref><ref id="B19"><label>19</label><citation citation-type="confproc"><person-group person-group-type="author"><name><surname>Kirchberg</surname><given-names>KJ</given-names></name><name><surname>Jesorsky</surname><given-names>O</given-names></name><name><surname>Frischholz</surname><given-names>R</given-names></name></person-group><article-title>Genetic model optimization for Hausdorff distance-based face localization</article-title><month>6</month><conf-name>In: Proceedings of the International ECCV 2002 Workshop on Biometric Authentication, vol. 2359</conf-name><conf-date>2002</conf-date><conf-loc>Copenhagen, Denmark</conf-loc><fpage>103</fpage><lpage>111</lpage><series>Lecture Notes in Computer Science</series></citation></ref><ref id="B20"><label>20</label><citation citation-type="confproc"><person-group person-group-type="author"><name><surname>Indyk</surname><given-names>P</given-names></name><name><surname>Venkatasubramanian</surname><given-names>S</given-names></name></person-group><article-title>Approximate congruence in nearly linear time</article-title><month>1</month><conf-name>In: Proceedings of the 11th Annual ACM-SIAM Symposium on Discrete Algorithms</conf-name><conf-date>2000</conf-date><conf-loc>San Francisco, Calif, USA</conf-loc><fpage>354</fpage><lpage>360</lpage></citation></ref><ref id="B21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pollard</surname><given-names>AE</given-names></name><name><surname>Barr</surname><given-names>RC</given-names></name></person-group><article-title>Adaptive sampling of intracellular and extracellular cardiac potentials with the fan method</article-title><source><italic>Medical and Biological Engineering and Computing</italic></source><year>1987</year><volume>25</volume><issue>3</issue><fpage>261</fpage><lpage>268</lpage><pub-id pub-id-type="pmid">3449720</pub-id></citation></ref></ref-list></back><floats-wrap><fig id="fig1" position="float"><label>Figure 1</label><caption><p>Principle of the frame-based method. (a) Geometry of the treatment room. (b) Frame geometryand coordinate system.</p></caption><graphic xlink:href="IJBI2007-62030.001"/></fig><fig id="fig2" position="float"><label>Figure 2</label><caption><p>Calibration piece.</p></caption><graphic xlink:href="IJBI2007-62030.002"/></fig><fig id="fig3" position="float"><label>Figure 3</label><caption><p>Calibration piece dimensions and coordinate systems.</p></caption><graphic xlink:href="IJBI2007-62030.003"/></fig><fig id="fig4" position="float"><label>Figure 4</label><caption><p>Appropriateness of the dHd. (a) Feature space for tworotation angles given in degrees. The <italic>D</italic><sub><italic>m</italic></sub> (3D sensordata) and <italic>D</italic><sub><italic>t</italic></sub> (CT modality)point sets were acquired for a phantom (plaster head). The <italic>h</italic>(<italic>D</italic><sub><italic>m</italic></sub>, <italic>D</italic><sub><italic>t</italic></sub>) surface is notonly convex for these two angles, but also for all other parameters of the isometry.(b) Similarity measure evolution. The decimal logarithm values of <italic>h</italic>(<italic>D</italic><sub><italic>m</italic></sub>, <italic>D</italic><sub><italic>t</italic></sub>) are given foreach iteration of the optimization. The combination of the steepest gradientand the simplex allows both a fast and accurate convergence.</p></caption><graphic xlink:href="IJBI2007-62030.004"/></fig><fig id="fig5" position="float"><label>Figure 5</label><caption><p>Data down-sampling algorithm.</p></caption><graphic xlink:href="IJBI2007-62030.005"/></fig><fig id="fig6" position="float"><label>Figure 6</label><caption><p>Simulation room. (a) Orthogonal control radiographs. (b) Room geometry.</p></caption><graphic xlink:href="IJBI2007-62030.006"/></fig><fig id="fig7" position="float"><label>Figure 7</label><caption><p>Registration results for humans. (a) Man with closedeyes and mouth. (b) Man with closed eyes and open mouth. The window in (b)indicates the data of the image to be transformed in the first registrationtest (the whole 3D points are used in the second test). The colour rays are thestructured light information used for the 3D point reconstruction. (c) Computeddistances between homologous points of (a) and (b) after registration. (d)Computed distances between homologous points of (e) and (f) after registration.(e) Woman with closed eyes and mouth. (f) Woman with open eyes and closedmouth.</p></caption><graphic xlink:href="IJBI2007-62030.007"/></fig><table-wrap id="tab1" position="float"><label>Table 1</label><caption><p>Inherentaccuracy of the registration algorithm according to the data down-samplingparameter <italic>&#x003b5;</italic>.</p></caption><table frame="hsides" rules="groups"><thead><tr><th rowspan="1" colspan="1"><inline-formula><mml:math id="M101"><mml:mrow><mml:msubsup><mml:mrow><mml:mover accent="true"><mml:mi>T</mml:mi><mml:mo stretchy="true">&#x002dc;</mml:mo></mml:mover></mml:mrow><mml:mrow><mml:mtext>test</mml:mtext></mml:mrow><mml:mrow><mml:mo>&#x02212;</mml:mo><mml:mn>1</mml:mn></mml:mrow></mml:msubsup></mml:mrow></mml:math></inline-formula> parameter values</th><th rowspan="1" colspan="1"><inline-formula><mml:math id="M102"><mml:mrow><mml:msubsup><mml:mrow><mml:mover accent="true"><mml:mi>T</mml:mi><mml:mo stretchy="true">&#x002dc;</mml:mo></mml:mover></mml:mrow><mml:mrow><mml:mtext>test</mml:mtext></mml:mrow><mml:mrow><mml:mo>&#x02212;</mml:mo><mml:mn>1</mml:mn></mml:mrow></mml:msubsup><mml:mo>&#x02212;</mml:mo></mml:mrow></mml:math></inline-formula><inline-formula><mml:math id="M103"><mml:mrow><mml:msub><mml:mrow><mml:mover accent="true"><mml:mi>T</mml:mi><mml:mo stretchy="true">&#x002dc;</mml:mo></mml:mover></mml:mrow><mml:mrow><mml:mtext>CT</mml:mtext><mml:mn>,3</mml:mn><mml:mtext>DS</mml:mtext></mml:mrow></mml:msub></mml:mrow></mml:math></inline-formula> (<italic>&#x003b5;</italic> = 0)</th><th rowspan="1" colspan="1"><inline-formula><mml:math id="M104"><mml:mrow><mml:msubsup><mml:mrow><mml:mover accent="true"><mml:mi>T</mml:mi><mml:mo stretchy="true">&#x002dc;</mml:mo></mm