<name><surname>O'Donnell</surname><given-names>M</given-names></name><name><surname>Silverstein</surname><given-names>SD</given-names></name></person-group><article-title>Optimum displacement for compound image generation in medical ultrasound</article-title><source><italic>IEEE Transactions on Ultrasonics, Ferroelectrics, and Frequency Control</italic></source><year>1988</year><volume>35</volume><issue>4</issue><fpage>470</fpage><lpage>476</lpage></citation></ref><ref id="B10"><label>10</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Scharf</surname><given-names>LL</given-names></name></person-group><source><italic>Statistical Signal Processing: Detection, Estimation, and Time Series Analysis</italic></source><year>1991</year><publisher-loc>Reading, Mass, USA</publisher-loc><publisher-name>Addison-Wesley</publisher-name></citation></ref><ref id="B12"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Park</surname><given-names>SC</given-names></name><name><surname>Park</surname><given-names>MK</given-names></name><name><surname>Kang</surname><given-names>MG</given-names></name></person-group><article-title>Super-resolution image reconstruction: a technical overview</article-title><source><italic>IEEE Signal Processing Magazine</italic></source><year>2003</year><volume>20</volume><issue>3</issue><fpage>21</fpage><lpage>36</lpage></citation></ref><ref id="B13"><label>12</label><citation citation-type="gov"><person-group person-group-type="author"><name><surname>Borman</surname><given-names>S</given-names></name><name><surname>Stevenson</surname><given-names>RL</given-names></name></person-group><article-title>Super-resolution image reconstruction enhancement of low-resolution image sequences: a comprehensive review with directions for future research</article-title><year>1998</year><month>7</month><publisher-loc>Notre Dame, Ind, USA</publisher-loc><publisher-name>Laboratory for Image and Signal Analysis, University of Notre Dame</publisher-name></citation></ref><ref id="B14"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Irani</surname><given-names>M</given-names></name><name><surname>Peleg</surname><given-names>S</given-names></name></person-group><article-title>Motion analysis for image enhancement: resolution, occlusion and transparency</article-title><source><italic>Journal of Visual Communications and Image Representation</italic></source><year>1993</year><volume>4</volume><issue>4</issue><fpage>324</fpage><lpage>335</lpage></citation></ref><ref id="B15"><label>14</label><citation citation-type="confproc"><person-group person-group-type="author"><name><surname>Tom</surname><given-names>BC</given-names></name><name><surname>Katsaggelos</surname><given-names>AK</given-names></name></person-group><article-title>Reconstruction of a high resolution image from multiple degraded mis-registered low resolution images</article-title><month>9</month><conf-name>In: Visual Communications and Image Processing (VCIP '94), vol. 2308 of Proceedings of SPIE</conf-name><conf-date>1994</conf-date><conf-loc>Chicago, Ill, USA</conf-loc><fpage>971</fpage><lpage>981</lpage></citation></ref><ref id="B16"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Youla</surname><given-names>DC</given-names></name><name><surname>Stark</surname><given-names>H</given-names></name></person-group><article-title>Image restoration by the method of convex projections: part I&#x02014;theory</article-title><source><italic>IEEE Transactions on Medical Imaging</italic></source><year>1982</year><volume>1</volume><issue>2</issue><fpage>81</fpage><lpage>94</lpage><pub-id pub-id-type="pmid">18238261</pub-id></citation></ref><ref id="B17"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sezan</surname><given-names>MI</given-names></name><name><surname>Stark</surname><given-names>H</given-names></name></person-group><article-title>Image restoration by the method of convex projections: part II&#x02014;applications and numerical results</article-title><source><italic>IEEE Transactions on Medical Imaging</italic></source><year>1982</year><volume>1</volume><issue>2</issue><fpage>95</fpage><lpage>101</lpage><pub-id pub-id-type="pmid">18238262</pub-id></citation></ref><ref id="B18"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ghiglia</surname><given-names>DC</given-names></name></person-group><article-title>Space-invariant deblurring given N independently blurred images of a common object</article-title><source><italic>Journal of the Optical Society of America A</italic></source><year>1984</year><volume>1</volume><issue>4</issue><fpage>398</fpage><lpage>402</lpage></citation></ref><ref id="B11"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tupholme</surname><given-names>GE</given-names></name></person-group><article-title>Generation of acoustic pulses by baffled plane pistons</article-title><source><italic>Mathematika</italic></source><year>1969</year><volume>16</volume><fpage>209</fpage><lpage>224</lpage></citation></ref></ref-list></back><floats-wrap><fig id="fig1" position="float"><label>Figure 1</label><caption><p>Illustration of 3D volume reconstruction from 2D freehand B-scans.</p></caption><graphic xlink:href="IJBI2008-274164.001"/></fig><fig id="fig2" position="float"><label>Figure 2</label><caption><p>Nonuniform resolution feature in bilinearreconstruction volume from freehand 2D slices: (a) high resolution incross-sectional view, (b) low resolution in sagittal view.</p></caption><graphic xlink:href="IJBI2008-274164.002"/></fig><fig id="fig3" position="float"><label>Figure 3</label><caption><p>Compounded 3D volume for two orthogonal datasets: (a) cross-sectional view, (b) sagittal view.</p></caption><graphic xlink:href="IJBI2008-274164.003"/></fig><fig id="fig4" position="float"><label>Figure 4</label><caption><p>Reconstructionresult for a spherical target from synthetic ultrasound data: (a) a slice ofsimulation data, (b)-(c) a slice of reconstruction result from bilinear and MMSE methods, (d) sagittal view of simulation data, (e)-(f) sagittal view from bilinear and MMSEreconstruction results.</p></caption><graphic xlink:href="IJBI2008-274164.004"/></fig><fig id="fig5" position="float"><label>Figure 5</label><caption><p>(a) A slice of clinical US B-scan of prostate, (b) a slice of bilinear reconstruction, and (c) a slice of MMSE reconstruction.</p></caption><graphic xlink:href="IJBI2008-274164.005"/></fig><fig id="fig6" position="float"><label>Figure 6</label><caption><p>Two synthetic 3D ultrasound image sets <bold>I</bold><sub>1</sub> and <bold>I</bold><sub>2</sub>. <bold>I</bold><sub>1</sub> and <bold>I</bold><sub>2</sub> are imaged the same region but with differentspeckle pattern: (a) <bold>I</bold><sub>1</sub> cross-sectional view, (b) <bold>I</bold><sub>1</sub> sagittal view, (c) <bold>I</bold><sub>2</sub> cross-sectional view, (d) <bold>I</bold><sub>2</sub> sagittal view.</p></caption><graphic xlink:href="IJBI2008-274164.006"/></fig><fig id="fig7" position="float"><label>Figure 7</label><caption><p>Two reconstructed 3D ultrasound image sets: (a) <bold>J</bold><sub>1</sub> cross-sectional view, (b) <bold>J</bold><sub>1</sub> sagittal view, (c) <bold>J</bold><sub>2</sub> cross-sectional view, (d) <bold>J</bold><sub>2</sub> sagittal view.</p></caption><graphic xlink:href="IJBI2008-274164.007"/></fig><fig id="fig8" position="float"><label>Figure 8</label><caption><p>Comparison of compounded3D ultrasound images by two methods: (a) cross-sectionalview of the dataset by conventional method, (b) sagittal view of the dataset byconventional method, (c) cross-sectional view of the dataset by MMSE method, (d) sagittal view of the dataset byMMSE method.</p></caption><graphic xlink:href="IJBI2008-274164.008"/></fig></floats-wrap></article>