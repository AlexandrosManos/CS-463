id pub-id-type="doi">10.1023/A:1011977415287</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Slowther</surname><given-names>A</given-names></name><name><surname>Bunch</surname><given-names>C</given-names></name><name><surname>Woolnough</surname><given-names>B</given-names></name><name><surname>Hope</surname><given-names>T</given-names></name></person-group><article-title>Clinical ethics support services in the UK: An investigation of the current provision of ethics support to health professionals in the UK</article-title><source>J Med Ethics</source><year>2001</year><volume>27</volume><fpage>i2</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">11314606</pub-id><pub-id pub-id-type="doi">10.1136/jme.27.suppl_1.i2</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Slowther</surname><given-names>A</given-names></name><name><surname>Underwood</surname><given-names>M</given-names></name></person-group><article-title>Is there a need for a clinical ethics support service in the UK?</article-title><source>J Med Ethics</source><year>1998</year><volume>24</volume><fpage>207</fpage><pub-id pub-id-type="pmid">9650117</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Connelly</surname><given-names>JE</given-names></name><name><surname>DalleMura</surname><given-names>S</given-names></name></person-group><article-title>Ethical problems in the medical office</article-title><source>JAMA</source><year>1988</year><volume>260</volume><fpage>812</fpage><lpage>815</lpage><pub-id pub-id-type="pmid">3392813</pub-id><pub-id pub-id-type="doi">10.1001/jama.260.6.812</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lo</surname><given-names>B</given-names></name><name><surname>Schroeder</surname><given-names>SA</given-names></name></person-group><article-title>Frequency of ethical dilemmas in a medical inpatient service</article-title><source>Arch Intern Med</source><year>1981</year><volume>141</volume><fpage>1062</fpage><lpage>1064</lpage><pub-id pub-id-type="pmid">7247591</pub-id><pub-id pub-id-type="doi">10.1001/archinte.141.8.1062</pub-id></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Flick</surname><given-names>U</given-names></name></person-group><source>An introduction to qualitative research</source><year>2006</year><edition>3</edition><publisher-name>Sage Publications</publisher-name></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lofland</surname><given-names>J</given-names></name><name><surname>Lofland</surname><given-names>LH</given-names></name></person-group><source>Analyzing social settings: A guide to qualitative observation and analysis</source><year>1995</year><edition>3</edition><publisher-name>Wadsworth Publishing Company</publisher-name></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McGee</surname><given-names>G</given-names></name><name><surname>Caplan</surname><given-names>AL</given-names></name><name><surname>Spanogle</surname><given-names>JP</given-names></name><name><surname>Asch</surname><given-names>DA</given-names></name></person-group><article-title>A national study of ethics committees</article-title><source>Am J Bioeth</source><year>2001</year><volume>1</volume><fpage>60</fpage><lpage>64</lpage><pub-id pub-id-type="pmid">11954647</pub-id><pub-id pub-id-type="doi">10.1162/152651601317139531</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Finucane</surname><given-names>TE</given-names></name><name><surname>Christmas</surname><given-names>C</given-names></name><name><surname>Travis</surname><given-names>K</given-names></name></person-group><article-title>Tube feeding in patients with advanced dementia</article-title><source>JAMA</source><year>1999</year><volume>282</volume><fpage>1364</fpage><lpage>1370</lpage><pub-id pub-id-type="doi">10.1001/jama.282.14.1365</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gillick</surname><given-names>MR</given-names></name></person-group><article-title>Rethinking the role of tube feeding in patients with advanced dementia</article-title><source>N Engl J Med</source><year>2000</year><volume>342</volume><fpage>206</fpage><lpage>210</lpage><pub-id pub-id-type="pmid">10639550</pub-id><pub-id pub-id-type="doi">10.1056/NEJM200001203420312</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Aulisio</surname><given-names>MP</given-names></name><name><surname>Arnold</surname><given-names>M</given-names></name><name><surname>Youngner</surname><given-names>SJ</given-names></name></person-group><article-title>Health care ethics consultation: Nature, goals, and competencies. A position paper from the Society for Health and Human Values-Society for Bioethics Consultation Task Force on Standards for Bioethics Consultation</article-title><source>Ann Intern Med</source><year>2000</year><volume>133</volume><fpage>59</fpage><lpage>69</lpage><pub-id pub-id-type="pmid">10877742</pub-id></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><collab>Society for Health and Human Values-Society for Bioethics Consultation</collab></person-group><source>Core Competencies for Health Care Ethics Consultation: The Report of the American Society for Bioethics and Humanities</source><year>1998</year><publisher-name>Glenview, IL: American Society for Bioethics Consultation</publisher-name></citation></ref><ref id="B25"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Mizuno</surname><given-names>T</given-names></name><name><surname>Maeda</surname><given-names>S</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Akabayashi A</surname></name></person-group><article-title>Shumatuki iryou</article-title><source>Introduction to Biomedical Ethics 1</source><year>2005</year><publisher-name>Tokyo: Keisou-shobo</publisher-name><fpage>246</fpage><lpage>266</lpage><comment>(in Japanese)</comment></citation></ref><ref id="B26"><citation citation-type="other"><article-title>WHO, "Definition of palliative care,"</article-title><year>2002</year><ext-link ext-link-type="uri" xlink:href="http://www.who.int/cancer/palliative/definition/en/"/><comment>accessed 18 June 2007</comment></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stevens</surname><given-names>LM</given-names></name><name><surname>Lynm</surname><given-names>C</given-names></name><name><surname>Glass</surname><given-names>RM</given-names></name></person-group><article-title>Palliative care</article-title><source>JAMA</source><year>2005</year><volume>293</volume><fpage>1410</fpage><pub-id pub-id-type="pmid">15769975</pub-id><pub-id pub-id-type="doi">10.1001/jama.293.11.1410</pub-id></citation></ref></ref-list></back></article>