><name><surname>Wilkinson</surname><given-names>D</given-names></name><name><surname>Sturm</surname><given-names>AW</given-names></name></person-group><year>1997</year><article-title>Diagnosing tuberculosis in a resource-poor setting: the value of sputum concentration.</article-title><source>Trans R Soc Trop Med Hyg</source><volume>91</volume><fpage>420</fpage><lpage>421</lpage><pub-id pub-id-type="pmid">9373638</pub-id></citation></ref><ref id="pone.0001933-Hudson1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hudson</surname><given-names>CP</given-names></name><name><surname>Wood</surname><given-names>R</given-names></name><name><surname>Maartens</surname><given-names>G</given-names></name></person-group><year>2000</year><article-title>Diagnosing HIV-associated tuberculosis: reducing costs and diagnostic delay.</article-title><source>Int J Tuberc Lung Dis</source><volume>4</volume><fpage>240</fpage><lpage>245</lpage><pub-id pub-id-type="pmid">10751070</pub-id></citation></ref><ref id="pone.0001933-Selvakumar1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Selvakumar</surname><given-names>N</given-names></name><name><surname>Rahman</surname><given-names>F</given-names></name><name><surname>Garg</surname><given-names>R</given-names></name><name><surname>Rajasekaran</surname><given-names>S</given-names></name><name><surname>Mohan</surname><given-names>NS</given-names></name><etal/></person-group><year>2002</year><article-title>Evaluation of the phenol ammonium sulfate sedimentation smear microscopy method for diagnosis of pulmonary tuberculosis.</article-title><source>J Clin Microbiol</source><volume>40</volume><fpage>3017</fpage><lpage>3020</lpage><pub-id pub-id-type="pmid">12149368</pub-id></citation></ref><ref id="pone.0001933-Behr1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Behr</surname><given-names>MA</given-names></name><name><surname>Warren</surname><given-names>SA</given-names></name><name><surname>Salamon</surname><given-names>H</given-names></name><name><surname>Hopewell</surname><given-names>PC</given-names></name><name><surname>Ponce de</surname><given-names>LA</given-names></name><etal/></person-group><year>1999</year><article-title>Transmission of Mycobacterium tuberculosis from patients smear-negative for acid-fast bacilli.</article-title><source>Lancet</source><volume>353</volume><fpage>444</fpage><lpage>449</lpage><pub-id pub-id-type="pmid">9989714</pub-id></citation></ref><ref id="pone.0001933-Auer1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Auer</surname><given-names>C</given-names></name><name><surname>Sarol</surname><given-names>J</given-names><suffix>Jr</suffix></name><name><surname>Tanner</surname><given-names>M</given-names></name><name><surname>Weiss</surname><given-names>M</given-names></name></person-group><year>2000</year><article-title>Health seeking and perceived causes of tuberculosis among patients in Manila, Philippines.</article-title><source>Trop Med Int Health</source><volume>5</volume><fpage>648</fpage><lpage>656</lpage><pub-id pub-id-type="pmid">11044280</pub-id></citation></ref><ref id="pone.0001933-Crampin1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Crampin</surname><given-names>AC</given-names></name><name><surname>Floyd</surname><given-names>S</given-names></name><name><surname>Mwaungulu</surname><given-names>F</given-names></name><name><surname>Black</surname><given-names>G</given-names></name><name><surname>Ndhlovu</surname><given-names>R</given-names></name><etal/></person-group><year>2001</year><article-title>Comparison of two versus three smears in identifying culture-positive tuberculosis patients in a rural African setting with high HIV prevalence.</article-title><source>Int J Tuberc Lung Dis</source><volume>5</volume><fpage>994</fpage><lpage>999</lpage><pub-id pub-id-type="pmid">11716350</pub-id></citation></ref><ref id="pone.0001933-Harries1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harries</surname><given-names>AD</given-names></name><name><surname>Mphasa</surname><given-names>NB</given-names></name><name><surname>Mundy</surname><given-names>C</given-names></name><name><surname>Banerjee</surname><given-names>A</given-names></name><name><surname>Kwanjana</surname><given-names>JH</given-names></name><etal/></person-group><year>2000</year><article-title>Screening tuberculosis suspects using two sputum smears.</article-title><source>Int J Tuberc Lung Dis</source><volume>4</volume><fpage>36</fpage><lpage>40</lpage><pub-id pub-id-type="pmid">10654642</pub-id></citation></ref></ref-list><fn-group><fn fn-type="conflict"><p><bold>Competing Interests: </bold>The authors have declared that no competing interests exist.</p></fn><fn fn-type="financial-disclosure"><p><bold>Funding: </bold>Funding was provided by Stellenbosch University, MRC and NRF for this work.</p></fn></fn-group></back></article>