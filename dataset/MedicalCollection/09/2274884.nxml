td><td align="left" rowspan="1" colspan="1">DamID</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>esc</bold></td><td align="left" rowspan="1" colspan="1">FBpp0079907</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="pgen.1000045-Tolhuis2">&#x0005b;21&#x0005d;</xref></td><td align="left" rowspan="1" colspan="1">Kc167</td><td align="left" rowspan="1" colspan="1">DamID</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>eve</bold></td><td align="left" rowspan="1" colspan="1">FBpp0087478</td><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="pgen.1000045-Pym1">&#x0005b;26&#x0005d;</xref></td><td align="left" rowspan="1" colspan="1">embryos</td><td align="left" rowspan="1" colspan="1">DamID</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>Trl</bold></td><td align="left" rowspan="1" colspan="1">FBpp0089419</td><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td ali