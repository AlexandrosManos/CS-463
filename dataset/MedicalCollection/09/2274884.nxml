d align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="pgen.1000045-Tolhuis2">&#x0005b;21&#x0005d;</xref></td><td align="left" rowspan="1" colspan="1">Kc167</td><td align="left" rowspan="1" colspan="1">DamID</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>His1</bold></td><td align="left" rowspan="1" colspan="1">FBpp0085248</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">(a)</td><td align="left" rowspan="1" colspan="1">Kc167</td><td align="left" rowspan="1" colspan="1">DamID</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>His3.3A</bold></td><td align="left" rowspan="1" colspan="1">FBpp0078649</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">x</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="pgen.1000045-Mito1">&#x0005b;27&#x0005d;</xref></td><td align="left" rowspan="1" colspan="1">S2</td><