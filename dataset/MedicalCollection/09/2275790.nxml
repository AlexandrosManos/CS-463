tation citation-type="journal"><person-group person-group-type="author"><name><surname>Aumann</surname><given-names>RJ</given-names></name></person-group><year>2006</year><article-title>War and peace.</article-title><source>Proc. Natl. Acad. Sci. USA</source><volume>103</volume><fpage>17075</fpage><lpage>17078</lpage><pub-id pub-id-type="pmid">17093044</pub-id></citation></ref><ref id="pone.0001917-Macy1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Macy</surname><given-names>MW</given-names></name><name><surname>Flache</surname><given-names>A</given-names></name></person-group><year>2002</year><article-title>Learning dynamics in social dilemmas.</article-title><source>Proc. Natl. Acad. Sci. USA</source><volume>99</volume><fpage>7229</fpage><lpage>7236</lpage><pub-id pub-id-type="pmid">12011402</pub-id></citation></ref><ref id="pone.0001917-Kirschner1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kirschner</surname><given-names>M</given-names></name><name><surname>Gerhart</surname><given-names>J</given-names></name></person-group><year>1998</year><article-title>Evolvability.</article-title><source>Proc. Natl. Acad. Sci. USA</source><volume>95</volume><fpage>8420</fpage><lpage>8427</lpage><pub-id pub-id-type="pmid">9671692</pub-id></citation></ref><ref id="pone.0001917-Csermely1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Csermely</surname><given-names>P</given-names></name></person-group><year>2006</year><article-title>Weak Links: Stabilizers of Complex Systems from Proteins to Social Networks (Springer, Heidelberg).</article-title></citation></ref><ref id="pone.0001917-Skyrms1"><label>24</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Skyrms</surname><given-names>B</given-names></name></person-group><year>2004</year><source>The Stag Hu