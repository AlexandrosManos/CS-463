n-group person-group-type="author"><name><surname>Markmon</surname><given-names>M</given-names></name></person-group><article-title>Second-line chemotherapy of epithelial ovarian cancer</article-title><source>Expert Rev Anticancer Ther</source><year>2003</year><volume>3</volume><fpage>31</fpage><lpage>36</lpage><pub-id pub-id-type="pmid">12597347</pub-id><pub-id pub-id-type="doi">10.1586/14737140.3.1.31</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moss</surname><given-names>C</given-names></name><name><surname>Kaye</surname><given-names>SB</given-names></name></person-group><article-title>Ovarian cancer: progress and continuing controversies in management</article-title><source>Eur J Cancer</source><year>2002</year><volume>38</volume><fpage>1701</fpage><lpage>1707</lpage><pub-id pub-id-type="pmid">12175685</pub-id><pub-id pub-id-type="doi">10.1016/S0959-8049(02)00161-2</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kita</surname><given-names>T</given-names></name><name><surname>Kikuchi</surname><given-names>Y</given-names></name><name><surname>Hirata</surname><given-names>J</given-names></name><name><surname>Nagata</surname><given-names>I</given-names></name></person-group><article-title>Prognosis of ovarian cancer today</article-title><source>Cancer J</source><year>1998</year><volume>11</volume><fpage>201</fpage><lpage>207</lpage></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goff</surname><given-names>BA</given-names></name><name><surname>Paley</surname><given-names>PJ</given-names></name><name><surname>Greer</surname><given-names>BE</given-names></name><name><surname>Gown</surname><given-names>AM</given-names></name></person-group><article-title>Evaluation of chemoresistance markers in women with epithelial ovarian carcinoma</arti