mes>MA</given-names></name><article-title>Synergy between visual and olfactory cues in nectar feeding by naive hawk moths, <italic>Manduca sexta</italic></article-title><source>Anim Behav</source><year>2002</year><volume>64</volume><fpage>685</fpage><lpage>695</lpage><pub-id pub-id-type="doi">10.1006/anbe.2002.4010</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Schiestl</surname><given-names>FP</given-names></name><article-title>Floral evolution and pollinator mate choice in a sexually deceptive orchid</article-title><source>J Evol Biol</source><year>2004</year><volume>17</volume><fpage>67</fpage><lpage>75</lpage><pub-id pub-id-type="doi">10.1046/j.1420-9101.2003.00650.x</pub-id><pub-id pub-id-type="pmid">15000649</pub-id></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="journal"><name><surname>Plepys</surname><given-names>D</given-names></name><name><surname>Ibarra</surname><given-names>F</given-names></name><name><surname>L&#x000f6;fstedt</surname><given-names>C</given-names></name><article-title>Volatiles from flowers of <italic>Platanthera bifolia </italic>(Orchidaceae) attractive to the silver Y moth, <italic>Autographa gamma </italic>(Lepidoptera: Noctuidae)</article-title><source>Oikos</source><year>2002</year><volume>99</volume><fpage>69</fpage><lpage>74</lpage><pub-id pub-id-type="doi">10.1034/j.1600-0706.2002.990107.x</pub-id></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="journal"><name><surname>D&#x000f6;tterl</surname><given-names>S</given-names></name><name><surname>Wolfe</surname><given-names>LM</given-names></name><name><surname>Jurgens</surname><given-names>A</given-names></name><article-title>Qualitative and quantitative analyses of flower scent in <italic>Silene latifolia</italic></article-title><source>Phytochemistry</source><year>2005</year><volume>66</volume><fpage>203</fpage><lpage>213</lpage><pub-id pub-id-type="doi">10.1016/j.phytochem.2004.12.002</pub-id><pub-id pub-id-type="pmid">15652577</pub-id></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="journal"><name><surname>Schiestl</surname><given-names>FP</given-names></name><name><surname>Ayasse</surname><given-names>M</given-names></name><name><surname>Paulus</surname><given-names>HF</given-names></name><name><surname>L&#x000f6;fstedt</surname><given-names>C</given-names></name><name><surname>Hansson</surname><given-names>BS</given-names></name><name><surname>Ibarra</surname><given-names>F</given-names></name><name><surname>Francke</surname><given-names>W</given-names></name><article-title>Orchid pollination by sexual swindle</article-title><source>Nature</source><year>1999</year><volume>399</volume><fpage>421</fpage><lpage>422</lpage><pub-id pub-id-type="doi">10.1038/20829</pub-id></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="journal"><name><surname>Schiestl</surname><given-names>FP</given-names></name><name><surname>Peakall</surname><given-names>R</given-names></name><name><surname>Mant</surname><given-names>J</given-names></name><name><surname>Ibarra</surname><given-names>F</given-names></name><name><surname>Schulz</surname><given-names>C</given-names></name><name><surname>Francke</surname><given-names>S</given-names></name><name><surname>Francke</surname><given-names>W</given-names></name><article-title>The chemistry of sexual deception in an orchid wasp pollination system</article-title><source>Science</source><year>2003</year><volume>302</volume><fpage>437</fpage><lpage>438</lpage><pub-id pub-id-type="doi">10.1126/science.1087835</pub-id><pub-id pub-id-type="pmid">14564006</pub-id></mixed-citation></ref><ref id="B19"><mixed-citation publication-type="journal"><name><surname>Stensmyr</surname><given-names>MC</given-names></name><name><surname>Urru</surname><given-names>I</given-names></name><name><surname>Collu</surname><given-names>I</given-names></name><name><surname>Celander</surname><given-names>M</