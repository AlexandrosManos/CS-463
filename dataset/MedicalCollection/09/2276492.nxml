erson-group-type="author"><name><surname>White</surname><given-names>HR</given-names></name><name><surname>McMorris</surname><given-names>BJ</given-names></name><name><surname>Catalano</surname><given-names>RF</given-names></name><name><surname>Fleming</surname><given-names>CB</given-names></name><name><surname>Haggerty</surname><given-names>KP</given-names></name><name><surname>Abbott</surname><given-names>RD</given-names></name></person-group><article-title>Increases in alcohol and marijuana use during the transition out of high school into emerging adulthood: The effects of leaving home, going to college, and high school protective factors</article-title><source>J Stud Alcohol</source><year>2006</year><volume>67</volume><fpage>810</fpage><lpage>22</lpage><pub-id pub-id-type="pmid">17060997</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hallett</surname><given-names>TB</given-names></name><name><surname>Lewis</surname><given-names>JJ</given-names></name><name><surname>Lopman</surname><given-names>BA</given-names></name><name><surname>Nyamukapa</surname><given-names>CA</given-names></name><name><surname>Mushati</surname><given-names>P</given-names></name><name><surname>Wambe</surname><given-names>M</given-names></name><name><surname>Garnett</surname><given-names>GP</given-names></name><name><surname>Gregson</surname><given-names>S</given-names></name></person-group><article-title>Age at first sex and HIV infection in rural Zimbabwe</article-title><source>Stud Fam Plann</source><year>2007</year><volume>38</volume><fpage>1</fpage><lpage>10</lpage><pub-id pub-id-type="pmid">17385378</pub-id><pub-id pub-id-type="doi">10.1111/j.1728-4465.2007.00111.x</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><collab>Centers for Disease Control and Prevention (CDC)</collab></person-group><article-title>Trends in HIV-related risk behavio