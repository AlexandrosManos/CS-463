crophage-specific chemotaxin</article-title><source>J Biol Chem</source><year>1990</year><volume>265</volume><fpage>2973</fpage><lpage>2978</lpage><pub-id pub-id-type="pmid">2406243</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>EG</given-names></name><name><surname>Boone</surname><given-names>DL</given-names></name><name><surname>Chai</surname><given-names>S</given-names></name><name><surname>Libby</surname><given-names>SL</given-names></name><name><surname>Chien</surname><given-names>M</given-names></name><name><surname>Lodolce</surname><given-names>JP</given-names></name><name><surname>Ma</surname><given-names>A</given-names></name></person-group><article-title>Failure to regulate TNF-induced NF-kappa-B and cell death responses in A20-deficient mice</article-title><source>Science</source><year>2000</year><volume>289</volume><fpage>2350</fpage><lpage>2354</lpage><pub-id pub-id-type="pmid">11009421</pub-id><pub-id pub-id-type="doi">10.1126/science.289.5488.2350</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zhang</surname><given-names>B</given-names></name><name><surname>Guan</surname><given-names>CC</given-names></name><name><surname>Chen</surname><given-names>WT</given-names></name><name><surname>Zhang</surname><given-names>P</given-names></name><name><surname>Yan</surname><given-names>M</given-names></name><name><surname>Shi</surname><given-names>JH</given-names></name><name><surname>Qin</surname><given-names>CL</given-names></name><name><surname>Yang</surname><given-names>Q</given-names></name></person-group><article-title>A20 inhibits human salivary adenoid cystic carcinoma cells invasion via blocking nuclear factor-kappaB activation</article-title><source>Chin Med J (Engl)</source><year>2007</year><volume>120</volume><fpage>1830</fpage><lpage>1835</lpage><pub-id pub-id-typ