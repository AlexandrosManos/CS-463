ion></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arena</surname><given-names>S</given-names></name><name><surname>Rappa</surname><given-names>C</given-names></name><name><surname>Del Frate</surname><given-names>E</given-names></name><name><surname>Cenci</surname><given-names>S</given-names></name><name><surname>Villani</surname><given-names>C</given-names></name></person-group><article-title>A natural alternative to menopausal hormone replacement therapy. Phytoestrogens</article-title><source>Minerva Ginecol</source><year>2002</year><volume>54</volume><fpage>53</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">11828270</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adlercreutz</surname><given-names>H</given-names></name></person-group><article-title>Western diet and western disease: some hormonal and biochemical mechanisms and associations</article-title><source>Scand J Clin Lab Invest</source><year>1990</year><volume>50</volume><fpage>S3</fpage><lpage>23</lpage><pub-id pub-id-type="doi">10.3109/00365519009085798</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Miksicek</surname><given-names>RJ</given-names></name></person-group><article-title>Interaction of naturally occurring nonsteroidal estrogens with expressed recombinant human estrogen receptor</article-title><source>J Steroid Biochem Mol Biol</source><year>1994</year><volume>49</volume><fpage>153</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">8031711</pub-id><pub-id pub-id-type="doi">10.1016/0960-0760(94)90005-1</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Messina</surname><given-names>M</given-names></name></person-group><article-title>Modem applications of an ancient bean: soybeans and the prevention and treatment of chronic disease</article-title><source>J Nutr</source><year>1995</year><volume>125</volume><fpage>S567</fpage><lpage>9</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sirtori</surname><given-names>CR</given-names></name><name><surname>Lovati</surname><given-names>MR</given-names></name><name><surname>Manzoni</surname><given-names>C</given-names></name><name><surname>Monetti</surname><given-names>M</given-names></name><name><surname>Pazzucconi</surname><given-names>F</given-names></name><name><surname>Gatti</surname><given-names>E</given-names></name></person-group><article-title>Soy and cholesterol reduction: clinical experience</article-title><source>J Nutr</source><year>1995</year><volume>125</volume><fpage>598S</fpage><lpage>605S</lpage><pub-id pub-id-type="pmid">7884540</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Adlercreutz</surname><given-names>H</given-names></name><name><surname>H&#x000e4;m&#x000e4;l&#x000e4;inen</surname><given-names>E</given-names></name><name><surname>Gorbach</surname><given-names>S</given-names></name><name><surname>Goldin</surname><given-names>B</given-names></name></person-group><article-title>Dietary phytoestrogens and the menopause in Japan</article-title><source>Lancet</source><year>1992</year><volume>339</volume><fpage>1233</fpage><pub-id pub-id-type="pmid">1349965</pub-id><pub-id pub-id-type="doi">10.1016/0140-6736(92)91174-7</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Agnusdei</surname><given-names>D</given-names></name><name><surname>Gennari</surname><given-names>C</given-names></name><name><surname>Bufalino</surname><given-names>L</given-names></name></person-group><article-title>Prevention of early postmenopausal bone loss using low doses of conjugated estrogens