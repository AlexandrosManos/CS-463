rson-group person-group-type="author"><name><surname>Wang</surname><given-names>J</given-names></name><name><surname>McLeod</surname><given-names>D</given-names></name><name><surname>Henson</surname><given-names>DB</given-names></name><name><surname>Bishop</surname><given-names>PN</given-names></name></person-group><article-title>Age-dependent changes in the basal retinovitreous adhesion.</article-title><source>Invest Ophthalmol Vis Sci</source><year>2003</year><volume>44</volume><fpage>1793</fpage><lpage>800</lpage><pub-id pub-id-type="pmid">12714607</pub-id></citation></ref><ref id="r19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ponsioen</surname><given-names>TL</given-names></name><name><surname>van der Worp</surname><given-names>RJ</given-names></name><name><surname>van Luyn</surname><given-names>MJ</given-names></name><name><surname>Hooymans</surname><given-names>JM</given-names></name><name><surname>Los</surname><given-names>LI</given-names></name></person-group><article-title>Packages of vitreous collagen (type II) in the human retina: an indication of postnatal collagen turnover?</article-title><source>Exp Eye Res</source><year>2005</year><volume>80</volume><fpage>643</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">15862171</pub-id></citation></ref><ref id="r20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bishop</surname><given-names>PN</given-names></name></person-group><article-title>The biochemical structure of mammalian vitreous.</article-title><source>Eye</source><year>1996</year><volume>10</volume><fpage>664</fpage><lpage>70</lpage><pub-id pub-id-type="pmid">9091361</pub-id></citation></ref><ref id="r21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ihanamaki</surname><given-names>T</given-names></name><name><surname>Pelliniemi</surname><given-names>LJ</given-name