n-group person-group-type="author"><name><surname>Croner</surname><given-names>SR</given-names></name><name><surname>Brueckl</surname><given-names>MW</given-names></name><name><surname>Reingruber</surname><given-names>B</given-names></name><name><surname>Hohenberger</surname><given-names>W</given-names></name><name><surname>Guenther</surname><given-names>K</given-names></name></person-group><article-title>Age and manifestations related symptoms in familial adenomatous polyposis</article-title><source>BMC Cancer</source><year>2005</year><volume>5</volume><fpage>1</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15631637</pub-id></element-citation></ref><ref id="CIT0007"><label>7</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Nowacki</surname><given-names>MP</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Krakowski</surname><given-names>M</given-names></name></person-group><article-title>Rak jelita grubego</article-title><source>Zalecenia post&#x00119;powania diagnostyczno-terapeutycznego w nowotworach zlosliwych [Polish]</source><year>2007</year><publisher-loc>Gdansk</publisher-loc><publisher-name>Wydawnictwo Via Medica</publisher-name><fpage>153</fpage><lpage>7</lpage></element-citation></ref><ref id="CIT0008"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Boardman</surname><given-names>LA</given-names></name><name><surname>Schmidt</surname><given-names>S</given-names></name><name><surname>Lindor</surname><given-names>NM</given-names></name><etal/></person-group><article-title>A search for germline APC mutations in early onset colorectal cancer or familial colorectal cancer with normal DNA mismatch repair</article-title><source>Genes Chromosomes Cancer</source><year>2001</year><volume>30</volume><fpage>181</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">11135435</pub-id></element-citation></ref>