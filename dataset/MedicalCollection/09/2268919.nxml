rce>J Med Syst</source><year>2006</year><volume>30</volume><fpage>23</fpage><lpage>32</lpage><pub-id pub-id-type="pmid">16548411</pub-id><pub-id pub-id-type="doi">10.1007/s10916-006-7400-5</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Parker</surname><given-names>EB</given-names></name><name><surname>Campbell</surname><given-names>JL</given-names></name></person-group><article-title>Measuring access to primary medical care: some examples of the use of geographical information system</article-title><source>Health Place</source><year>1998</year><volume>4</volume><fpage>183</fpage><lpage>193</lpage><pub-id pub-id-type="pmid">10671022</pub-id><pub-id pub-id-type="doi">10.1016/S1353-8292(98)00010-0</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martin</surname><given-names>D</given-names></name><name><surname>Wrigley</surname><given-names>H</given-names></name><name><surname>Barnett</surname><given-names>S</given-names></name><name><surname>Roderick</surname><given-names>P</given-names></name></person-group><article-title>Increasing the sophistication of access measurement in a rural healthcare study</article-title><source>Health Place</source><year>2002</year><volume>8</volume><fpage>3</fpage><lpage>13</lpage><pub-id pub-id-type="pmid">11852259</pub-id><pub-id pub-id-type="doi">10.1016/S1353-8292(01)00031-4</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Deck</surname><given-names>D</given-names></name><name><surname>Carlson</surname><given-names>MJ</given-names></name></person-group><article-title>Access to publicly funded methadone maintenance treatment in two western states</article-title><source>J Behav Health Serv Res</source><year>2004</year><volume>31</volume><fpage>164</fpage><lpage>177</lpage><pub-id pub-id-type="pmid">15255224</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Higgs</surname><given-names>G</given-names></name></person-group><article-title>A literature review of the use of GIS-based measures of access to health care services</article-title><source>Health Serv Outcomes Res Methodol</source><year>2005</year><volume>5</volume><fpage>119</fpage><lpage>139</lpage><pub-id pub-id-type="doi">10.1007/s10742-005-4304-7</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Richards</surname><given-names>TB</given-names></name><name><surname>Croner</surname><given-names>CM</given-names></name><name><surname>Rushton</surname><given-names>G</given-names></name><name><surname>Brown</surname><given-names>CK</given-names></name><name><surname>Fowler</surname><given-names>L</given-names></name></person-group><article-title>Information technology: Geographic information systems and public health: Mapping the future</article-title><source>Public Health Rep</source><year>1999</year><volume>114</volume><fpage>359</fpage><lpage>373</lpage><pub-id pub-id-type="pmid">10501137</pub-id><pub-id pub-id-type="doi">10.1093/phr/114.4.359</pub-id></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bertrand</surname><given-names>WE</given-names></name><name><surname>Mock</surname><given-names>NB</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Lepper MJC, Scholten HJ, Stern RM</surname></name></person-group><article-title>Spatial information to make a difference: value added decision-making in the health sector with geographical information systems</article-title><source>The added value of geographical information systems in public and environmental health</source><year>1995</year><publisher-name>Dordrecht: Kluwer Academic Publishers</publisher-name><fpage>265</fpage><lpage>275</lpage></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cromley</surname><given-names>EK</given-names></name><name><surname>McLafferty</surname><given-names>SL</given-names></name></person-group><source>GIS and Public Health</source><year>2002</year><publisher-name>New York: The Guilford Press</publisher-name></citation></ref><ref id="B14"><citation citation-type="other"><person-group person-group-type="author"><collab>Central Intelligence Agency</collab></person-group><article-title>The World Factbook</article-title><ext-link ext-link-type="uri" xlink:href="https://www.cia.gov/library/publications/the-world-factbook/index.html"/></citation></ref><ref id="B15"><citation citation-type="other"><person-group person-group-type="author"><collab>Census and Statistics Department</collab></person-group><article-title>2006 Population by-census</article-title><ext-link ext-link-type="uri" xlink:href="http://www.bycensus2006.gov.hk/index.htm"/></citation></ref><ref id="B16"><citation citation-type="other"><person-group person-group-type="author"><collab>Central Registry of Drug Abuse</collab></person-group><article-title>CRDA 55<sup>th </sup>Report</article-title><ext-link ext-link-type="uri" xlink:href="http://www.nd.gov.hk/55_report.htm"/></citation></ref><ref id="B17"><citation citation-type="other"><person-group person-group-type="author"><collab>Narcotics, Division Security Bureau</collab></person-group><article-title>Methadone treatment programme review 2000</article-title><ext-link ext-link-type="uri" xlink:href="http://sc.info.gov.hk/gb/www.nd.gov.hk/MTP_s_e.htm"/></citation></ref><ref id="B18"><citation citation-type="other"><person-group person-group-type="author"><collab>Environmental Systems Research Institute</collab></person-group><article-title>ArcGIS 9.1</article-title><source>Redlands</source><year>1999</year><ext-link ext-link-type="uri" xlink:href="http://www.esri.com"/></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Flowerdew</surname><given-names>R</given-names></name><name><surname>Green</surname><given-names>M</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Fotheringham S, Rogerson P</surname></name></person-group><article-title>Areal interpolation and types of data</article-title><source>Spatial Analysis and GIS</source><year>1994</year><publisher-name>London: Taylor &#x00026; Francis Ltd</publisher-name><fpage>121</fpage><lpage>146</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reibel</surname><given-names>M</given-names></name><name><surname>Bufalino</surname><given-names>ME</given-names></name></person-group><article-title>Street-weighted interpolation techniques for demographic count estimation in incompatible zone systems</article-title><source>Environ Plan A</source><year>2005</year><volume>37</volume><fpage>127</fpage><lpage>139</lpage><pub-id pub-id-type="doi">10.1068/a36202</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sadahiro</surname><given-names>Y</given-names></name></person-group><article-title>Accuracy of areal interpolation: A comparison of alternative methods</article-title><source>J Geogr Syst</source><year>1999</year><volume>1</volume><fpage>323</fpage><lpage>346</lpage><pub-id pub-id-type="doi">10.1007/s101090050017</pub-id></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><collab>World Health Organization</collab></person-group><source>Background paper for the Technical Consultation on Effective Coverage of Health Systems</source><year>2001</year><publisher-name>Geneva</publisher-name></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tanahashi</surname><given-names>T</given-names></name></person-group><article-title>Health service coverage and its evaluation</article-title><source>Bull World Health Organ</source><year>1978</year><volume>56</volume><fpage>295</fpage><lpage>303</lpage><pub-id pub-id-type="pmid">96953</pub-id></citation></ref><ref id="B24"><citation citation-type="other"><person-group person-group-type="author"><collab>European Observatory on Health Systems and Policies</collab></person-group><article-title>The Observatory's Health Systems Glossary</article-title><ext-link ext-link-type="uri" xlink:href="http://www.euro.who.int/observatory/Glossary/TopPage"/></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gulzar</surname><given-names>L</given-names></name></person-group><article-title>Access to health care</article-title><source>Image J Nurs Sch</source><year>1999</year><volume>31</volume><fpage>13</fpage><lpage>19</lpage><pub-id pub-id-type="pmid">10081206</pub-id><pub-id pub-id-type="doi">10.1111/j.1547-5069.1999.tb00414.x</pub-id></citation></ref><ref id="B26"><citation citation-type="book"><person-group person-group-type="author"><collab>World Health Organization</collab></person-group><source>Technical Meeting for the Development of a Framework for Universal Access to HIV/AIDS Prevention, Treatment and Care in the Health Sector: Background Paper On The Concept Of Universal Access</source><year>2005</year><publisher-name>Geneva</publisher-name></citation></ref><ref id="B27"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hogarth</surname><given-names>J</given-names></name></person-group><source>Glossary of Health Care Terminology</source><year>1975</year><publisher-name>Copenhagen</publisher-name></citation></ref><ref id="B28"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lee</surname><given-names>SS</given-names></name><name><surname>Pang</surname><given-names>PTT</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Thomas Y, Richardson D, Cheung I</surname></name></person-group><article-title>Integrated assessment of addiction epidemiology in Hong Kong 1996 &#x02013; 2005</article-title><source>Geography and Drug Addiction</source><publisher-name>London: Springer</publisher-name><comment></comment></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kamel Boulos</surname><given-names>MN</given-names></name></person-group><article-title>Towards evidence-based, GIS-driven national spatial health information infrastructure and surveillance services in the United Kingdom</article-title><source>Int J Health Geogr</source><year>2004</year><volume>3</volume><fpage>1</fpage><pub-id pub-id-type="pmid">14748927</pub-id><pub-id pub-id-type="doi">10.1186/1476-072X-3-1</pub-id></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Witten</surname><given-names>K</given-names></name><name><surname>Exeter</surname><given-names>D</given-names></name><name><surname>Field</surname><given-names>A</given-names></name></person-group><article-title>The quality of urban environments: Mapping variation in access to community resources</article-title><source>Urban Stud</source><year>2003</year><volume>40</volume><fpage>161</fpage><lpage>177</lpage><pub-id pub-id-type="doi">10.1080/00420980220080221</pub-id></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haynes</surname><given-names>R</given-names></name><name><surname>Jones</surname><given-names>AP</given-names></name><name><surname>Sauerzapf</surname><given-names>V</given-names></name><name><surname>Zhao</surname><given-names>H</given-names></name></person-group><article-title>Validation of travel times to hospital estimated by GIS</article-title><source>Int J Health Geogr</source><year>2006</year><volume>5</volume><fpage>40</fpage><pub-id pub-id-type="pmid">16984650</pub-id><pub-id pub-id-type="doi">10.1186/1476-072X-5-40</pub-id></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sherman</surname><given-names>JE</given-names></name><name><surname>Spencer</surname><given-names>J</given-names></name><name><surname>Preisser</surname><given-names>JS</given-names></name><name><surname>Gesler</surname><given-names>WM</given-names></name><name><surname>Arcury</surname><given-names>TA</given-names></name></person-group><article-title>A suite of methods for representing activity space in a healthcare accessibility study</article-title><source>Int J Health Geogr</source><year>2005</year><volume>4</volume><fpage>24</fpage><pub-id pub-id-type="pmid">16236174</pub-id><pub-id pub-id-type="doi">10.1186/1476-072X-4-24</pub-id></citation></ref></ref-list></back></article>