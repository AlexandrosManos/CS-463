page><pub-id pub-id-type="pmid">7947755</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Skripkin</surname><given-names>E</given-names></name><name><surname>Paillart</surname><given-names>JC</given-names></name><name><surname>Marquet</surname><given-names>R</given-names></name><name><surname>Ehresmann</surname><given-names>B</given-names></name><name><surname>Ehresmann</surname><given-names>C</given-names></name></person-group><article-title>Identification of the primary site of the human immunodeficiency virus type 1 RNA dimerization in vitro</article-title><source>Proc. Natl Acad. Sci. USA</source><year>1994</year><volume>91</volume><fpage>4945</fpage><lpage>4949</lpage><pub-id pub-id-type="pmid">8197162</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Paillart</surname><given-names>JC</given-names></name><name><surname>Marquet</surname><given-names>R</given-names></name><name><surname>Skripkin</surname><given-names>E</given-names></name><name><surname>Ehresmann</surname><given-names>B</given-names></name><name><surname>Ehresmann</surname><given-names>C</given-names></name></person-group><article-title>Mutational analysis of the bipartite dimer linkage structure of human immunodeficiency virus type 1 genomic RNA</article-title><source>J. Biol. Chem</source><year>1994</year><volume>269</volume><fpage>27486</fpage><lpage>27493</lpage><pub-id pub-id-type="pmid">7961663</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Muriaux</surname><given-names>D</given-names></name><name><surname>Girard</surname><given-names>PM</given-names></name><name><surname>Bonnet-Mathoniere</surname><given-names>B</given-names></name><name><surname>P