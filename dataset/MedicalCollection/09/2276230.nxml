ame><surname>Brigger</surname><given-names>I</given-names></name><name><surname>Dubernet</surname><given-names>C</given-names></name><name><surname>Couvreur</surname><given-names>P</given-names></name></person-group><article-title>Nanoparticles in cancer therapy and diagnosis</article-title><source>Adv Drug Deliv Rev</source><year>2002</year><volume>54</volume><fpage>631</fpage><lpage>651</lpage><pub-id pub-id-type="pmid">12204596</pub-id><pub-id pub-id-type="doi">10.1016/S0169-409X(02)00044-3</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cuenca</surname><given-names>AG</given-names></name><name><surname>Jiang</surname><given-names>H</given-names></name><name><surname>Hochwald</surname><given-names>SN</given-names></name><name><surname>Delano</surname><given-names>M</given-names></name><name><surname>Cance</surname><given-names>WG</given-names></name><name><surname>Grobmyer</surname><given-names>SR</given-names></name></person-group><article-title>Emerging implications of nanotechnology on cancer diagnostics and therapeutics</article-title><source>Cancer</source><year>2006</year><volume>107</volume><fpage>459</fpage><lpage>466</lpage><pub-id pub-id-type="pmid">16795065</pub-id><pub-id pub-id-type="doi">10.1002/cncr.22035</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jain</surname><given-names>KK</given-names></name></person-group><article-title>Nanotechnology-based drug delivery for cancer</article-title><source>Technol Cancer Res Treat</source><year>2005</year><volume>4</volume><fpage>407</fpage><lpage>416</lpage><pub-id pub-id-type="pmid">16029059</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zhang</surname><given-names>Z</given-names></name><name><surname>Yang</surname><given-names>X</given-names></name><name><surname>Z