l pathology</source><year>2002</year><volume>10</volume><fpage>167</fpage><lpage>8; author reply 168-9</lpage><pub-id pub-id-type="pmid">12075413</pub-id><pub-id pub-id-type="doi">10.1177/106689690201000213</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arif</surname><given-names>S</given-names></name><name><surname>Blanes</surname><given-names>A</given-names></name><name><surname>Diaz-Cano</surname><given-names>SJ</given-names></name></person-group><article-title>Hashimoto's thyroiditis shares features with early papillary thyroid carcinoma</article-title><source>Histopathology</source><year>2002</year><volume>41</volume><fpage>357</fpage><lpage>362</lpage><pub-id pub-id-type="pmid">12383219</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2559.2002.01467.x</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Powell Jr</surname><given-names>DJ</given-names></name><name><surname>Russell</surname><given-names>JP</given-names></name><name><surname>Li</surname><given-names>G</given-names></name><name><surname>Kuo</surname><given-names>BA</given-names></name><name><surname>Fidanza</surname><given-names>V</given-names></name><name><surname>Huebner</surname><given-names>K</given-names></name><name><surname>Rothstein</surname><given-names>JL</given-names></name></person-group><article-title>Altered gene expression in immunogenic poorly differentiated thyroid carcinomas from RET/PTC3(p53-/-) mice</article-title><source>Oncogene</source><year>2001</year><volume>20</volume><fpage>3235</fpage><lpage>3246</lpage><pub-id pub-id-type="pmid">11423973</pub-id><pub-id pub-id-type="doi">10.1038/sj.onc.1204425</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Borrello</surname><given-names>MG</given-names></name><name><surname>Alberti</surname><given-n