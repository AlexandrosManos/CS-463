rson-group-type="author"><name><surname>Ordi</surname><given-names>J</given-names></name><name><surname>Ismail</surname><given-names>MR</given-names></name><name><surname>Ventura</surname><given-names>PJ</given-names></name><name><surname>Kahigwa</surname><given-names>E</given-names></name><name><surname>Hirt</surname><given-names>R</given-names></name><name><surname>Cardesa</surname><given-names>A</given-names></name><name><surname>Alonso</surname><given-names>PL</given-names></name><name><surname>Menendez</surname><given-names>C</given-names></name></person-group><article-title>Massive chronic intervillositis of the placenta associated with malaria infection</article-title><source>Am J Surg Pathol</source><year>1998</year><volume>22</volume><fpage>1006</fpage><lpage>1011</lpage><pub-id pub-id-type="pmid">9706981</pub-id><pub-id pub-id-type="doi">10.1097/00000478-199808000-00011</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Galbraith</surname><given-names>RM</given-names></name><name><surname>Fox</surname><given-names>H</given-names></name><name><surname>Hsi</surname><given-names>B</given-names></name><name><surname>Galbraith</surname><given-names>GM</given-names></name><name><surname>Bray</surname><given-names>RS</given-names></name><name><surname>Faulk</surname><given-names>WP</given-names></name></person-group><article-title>The human materno-foetal relationship in malaria. II. Histological, ultrastructural and immunopathological studies of the placenta</article-title><source>Trans R Soc Trop Med Hyg</source><year>1980</year><volume>74</volume><fpage>61</fpage><lpage>72</lpage><pub-id pub-id-type="pmid">7001685</pub-id><pub-id pub-id-type="doi">10.1016/0035-9203(80)90012-7</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Menendez</surname><given-names>C</given-names></name><name><surname>Ordi</surname><g