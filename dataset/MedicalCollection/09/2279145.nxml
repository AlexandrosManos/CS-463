on-group person-group-type="author"><name><surname>Sperling</surname><given-names>C</given-names></name><name><surname>Maitz</surname><given-names>MF</given-names></name><name><surname>Talkenberger</surname><given-names>S</given-names></name><name><surname>Gouzy</surname><given-names>MF</given-names></name><name><surname>Groth</surname><given-names>T</given-names></name><name><surname>Werner</surname><given-names>C</given-names></name></person-group><article-title>In vitro blood reactivity to hydroxylated and non-hydroxylated polymer surfaces</article-title><source>Biomaterials</source><year>2007</year><volume>28</volume><fpage>3617</fpage><lpage>3625</lpage><pub-id pub-id-type="pmid">17524475</pub-id><pub-id pub-id-type="doi">10.1016/j.biomaterials.2007.04.041</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brynda</surname><given-names>E</given-names></name><name><surname>Houska</surname><given-names>M</given-names></name><name><surname>Jirouskova</surname><given-names>M</given-names></name><name><surname>Dyr</surname><given-names>JE</given-names></name></person-group><article-title>Albumin and heparin multilayer coatings for blood-contacting medical devices</article-title><source>J Biomed Mater Res</source><year>2000</year><volume>51</volume><fpage>249</fpage><lpage>257</lpage><pub-id pub-id-type="pmid">10825225</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1097-4636(200008)51:2&#x0003c;249::AID-JBM14&#x0003e;3.0.CO;2-X</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Laredo</surname><given-names>J</given-names></name><name><surname>Xue</surname><given-names>L</given-names></name><name><surname>Husak</surname><given-names>VA</given-names></name><name><surname>Ellinger</surname><given-names>J</given-names></name><name><surname>Singh</surname><given-names>G</given-names></name><name><surname>Zamora</surname><given-names>PO</given-names></name><name><surname>Greisler</surname><given-names>HP</given-names></name></person-group><article-title>Silyl-heparin bonding improves the patency and in vivo thromboresistance of carbon-coated polytetrafluoroethylene vascular grafts</article-title><source>J Vasc Surg</source><year>2004</year><volume>39</volume><fpage>1059</fpage><lpage>1065</lpage><pub-id pub-id-type="pmid">15111862</pub-id><pub-id pub-id-type="doi">10.1016/j.jvs.2003.12.025</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Moon</surname><given-names>JJ</given-names></name><name><surname>Lee</surname><given-names>SH</given-names></name><name><surname>West</surname><given-names>JL</given-names></name></person-group><article-title>Synthetic Biomimetic Hydrogels Incorporated with Ephrin-A1 for Therapeutic Angiogenesis</article-title><source>Biomacromolecules</source><year>2007</year><volume>8</volume><fpage>42</fpage><lpage>49</lpage><pub-id pub-id-type="pmid">17206786</pub-id><pub-id pub-id-type="doi">10.1021/bm060452p</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dalby</surname><given-names>MJ</given-names></name><name><surname>Riehle</surname><given-names>MO</given-names></name><name><surname>Johnstone</surname><given-names>H</given-names></name><name><surname>Affrossman</surname><given-names>S</given-names></name><name><surname>Curtis</surname><given-names>ASG</given-names></name></person-group><article-title>In vitro reaction of endothelial cells to polymer demixed nanotopography</article-title><source>Biomaterials</source><year>2002</year><volume>23</volume><fpage>2945</fpage><lpage>2954</lpage><pub-id pub-id-type="pmid">12069336</pub-id><pub-id pub-id-type="doi">10.1016/S0142-9612(01)00424-0</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author">