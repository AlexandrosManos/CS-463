</pub-id></citation></ref><ref id="pgen.1000053-Stohs1"><label>5</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stohs</surname><given-names>SJ</given-names></name><name><surname>Bagchi</surname><given-names>D</given-names></name></person-group><year>1995</year><article-title>Oxidative mechanisms in the toxicity of metal ions.</article-title><source>Free Radic Biol Med</source><volume>18</volume><fpage>321</fpage><lpage>336</lpage><pub-id pub-id-type="pmid">7744317</pub-id></citation></ref><ref id="pgen.1000053-Ercal1"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ercal</surname><given-names>N</given-names></name><name><surname>Gurer-Orhan</surname><given-names>H</given-names></name><name><surname>Aykin-Burns</surname><given-names>N</given-names></name></person-group><year>2001</year><article-title>Toxic metals and oxidative stress part I: mechanisms involved in metal-induced oxidative damage.</article-title><source>Curr Top Med Chem</source><volume>1</volume><fpage>529</fpage><lpage>539</lpage><pub-id pub-id-type="pmid">11895129</pub-id></citation></ref><ref id="pgen.1000053-Harris1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harris</surname><given-names>GK</given-names></name><name><surname>Shi</surname><given-names>X</given-names></name></person-group><year>2003</year><article-title>Signaling by carcinogenic metals and metal-induced reactive oxygen species.</article-title><source>Mutat Res</source><volume>533</volume><fpage>183</fpage><lpage>200</lpage><pub-id pub-id-type="pmid">14643420</pub-id></citation></ref><ref id="pgen.1000053-Tams1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tam&#x000e1;s</surname><given-names>MJ</given-names></name><name><surname>Labarre</surname><given-names>J</given-names></name><name><surname>Toledano</surname><given-names>MB</given-names></name><name><surname>Wysocki</surname><given-names>R</given-names></name></person-group><year>2006</year><article-title>Mechanisms of toxic metal tolerance in yeast.</article-title><fpage>395</fpage><lpage>454</lpage></citation></ref><ref id="pgen.1000053-Chen1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>F</given-names></name><name><surname>Shi</surname><given-names>X</given-names></name></person-group><year>2002</year><article-title>Intracellular signal transduction of cells in response to carcinogenic metals.</article-title><source>Crit Rev Oncol Hematol</source><volume>42</volume><fpage>105</fpage><lpage>121</lpage><pub-id pub-id-type="pmid">11923072</pub-id></citation></ref><ref id="pgen.1000053-Zhao1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zhao</surname><given-names>H</given-names></name><name><surname>Eide</surname><given-names>D</given-names></name></person-group><year>1996</year><article-title>The yeast ZRT1 gene encodes the zinc transporter protein of a high-affinity uptake system induced by zinc limitation.</article-title><source>Proc Natl Acad Sci U S A</source><volume>93</volume><fpage>2454</fpage><lpage>2458</lpage><pub-id pub-id-type="pmid">8637895</pub-id></citation></ref><ref id="pgen.1000053-Liu1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>XF</given-names></name><name><surname>Culotta</surname><given-names>VC</given-names></name></person-group><year>1999</year><article-title>Post-translation control of Nramp metal transport in yeast. Role of metal ions and the BSD2 gene.</article-title><source>J Biol Chem</source><volume>274</volume><fpage>4863</fpage><lpage>4868</lpage><pub-id pub-id-type="pmid">9988727</pub-id></citation></ref><ref id="pgen.1000053-Vatamaniuk1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vatamaniuk</surname><given-names>OK</given-names></name><name><surname>Mari</surname><given-names>S</given-names></name><name><surname>Lu</surname><given-names>YP</given-names></name><name><surname>Rea</surname><given-names>PA</given-names></name></person-group><year>2000</year><article-title>Mechanism of heavy metal ion activation of phytochelatin (PC) synthase: blocked thiols are sufficient for PC synthase-catalyzed transpeptidation of glutathione and related thiol peptides.</article-title><source>J Biol Chem</source><volume>275</volume><fpage>31451</fpage><lpage>31459</lpage><pub-id pub-id-type="pmid">10807919</pub-id></citation></ref><ref id="pgen.1000053-Giaever1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giaever</surname><given-names>G</given-names></name><name><surname>Chu</surname><given-names>AM</given-names></name><name><surname>Ni</surname><given-names>L</given-names></name><name><surname>Connelly</surname><given-names>C</given-names></name><name><surname>Riles</surname><given-names>L</given-names></name><etal/></person-group><year>2002</year><article-title>Functional profiling of the Saccharomyces cerevisiae genome.</article-title><source>Nature</source><volume>418</volume><fpage>387</fpage><lpage>391</lpage><pub-id pub-id-type="pmid">12140549</pub-id></citation></ref><ref id="pgen.1000053-Haugen1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haugen</surname><given-names>AC</given-names></name><name><surname>Kelley</surname><given-names>R</given-names></name><name><surname>Collins</surname><given-names>JB</given-names></name><name><surname>Tucker</surname><given-names>CJ</given-names></name><name><surname>Deng</surname><given-names>C</given-names></name><etal/></person-group><year>2004</year><article-title>Integrating phenotypic a