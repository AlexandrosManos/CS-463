86/1476-069X-6-38</pub-id></citation></ref><ref id="B16"><citation citation-type="other"><person-group person-group-type="author"><collab>World Health Organization/UNICEF</collab></person-group><source>Meeting the MDG Drinking Water and Sanitation The urban and rural challenge of the decade Geneva</source><year>2006</year><ext-link ext-link-type="uri" xlink:href="http://www.who.int/water_sanitation_health/monitoring/jmp2006/en/index.html"/></citation></ref><ref id="B17"><citation citation-type="other"><person-group person-group-type="author"><collab>World Bank</collab></person-group><source>The little green data book Washington</source><year>2006</year></citation></ref><ref id="B18"><citation citation-type="other"><person-group person-group-type="author"><collab>World Health Organization</collab></person-group><source>World Health Statistics 2007 Geneva</source><year>2007</year><ext-link ext-link-type="uri" xlink:href="http://www.who.int/whosis/whostat2007/en/index.html"/></citation></ref><ref id="B19"><citation citation-type="other"><person-group person-group-type="author"><collab>World Health Organization</collab></person-group><source>WHOSIS &#x02013; World Health Organization Statistical Information System Geneva</source><year>2007</year><ext-link ext-link-type="uri" xlink:href="http://www.who.int/whosis"/></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Desai</surname><given-names>M</given-names></name><name><surname>Mehta</surname><given-names>S</given-names></name><name><surname>Smith</surname><given-names>K</given-names></name></person-group><source>Indoor smoke from solid fuels &#x02013; Assessing the environmental burden of disease at national and local levels</source><year>2004</year><publisher-name>Geneva: World Health Organization</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.who.int/quantifying_ehimpacts/national/en/"/><comment>[Pr&#x000fc;ss-&#x000dc;st&#x000fc;n A, Campbell-Lendrum D, Corval&#x000e1;n C, Woodward A (Series Editors): <italic>Environmental Burden of Disease Series</italic>, No. 4]</comment></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Fewtrell</surname><given-names>L</given-names></name><name><surname>Pr&#x000fc;ss-&#x000dc;st&#x000fc;n</surname><given-names>A</given-names></name><name><surname>Bos</surname><given-names>R</given-names></name><name><surname>Gore</surname><given-names>F</given-names></name><name><surname>Bartram</surname><given-names>J</given-names></name></person-group><source>Water, sanitation and hygiene &#x02013; Quantifying the health impact at national and local levels in countries with incomplete water supply and sanitation coverage</source><year>2007</year><publisher-name>Geneva: World Health Organization</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.who.int/quantifying_ehimpacts/national/en/"/><comment>[Pr&#x000fc;ss-&#x000dc;st&#x000fc;n A, Campbell-Lendrum D, Corval&#x000e1;n C, Woodward A (Series Editors): <italic>Environmental Burden of Disease Series</italic>, No. 15]</comment></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Ostro</surname><given-names>B</given-names></name></person-group><source>Outdoor air pollution &#x02013; Assessing the environmental burden of disease at national and local levels</source><year>2004</year><publisher-name>Geneva: World Health Organization</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.who.int/quantifying_ehimpacts/national/en/"/><comment>[Pr&#x000fc;ss-&#x000dc;st&#x000fc;n A, Campbell-Lendrum D, Corval&#x000e1;n C, Woodward A (Series Editors): <italic>Environmental Burden of Disease Series</italic>, No. 5]</comment></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Pr&#x000fc;ss-&#x000dc;st&#x000fc;n</surname><given-names>A</given-names></name><name><surname>Kay</surname><given-names>D</given-names></name><name><surname>Fewtrell</surname><given-names>L</given-names></name><name><surname>Bartram</surname><given-names>J</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Ezzati M, Lopez AD, Rodgers A, Murray CJL</surname></name></person-group><article-title>Unsafe water, sanitation and hygiene</article-title><source>Comparative quantification of health risks</source><year>2004</year><volume>2</volume><publisher-name>Geneva: World Health Organization</publisher-name><fpage>1321</fpage><lpage>1352</lpage><ext-link ext-link-type="uri" xlink:href="http://www.who.int/publications/cra"/></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Smith</surname><given-names>KR</given-names></name><name><surname>Mehta</surname><given-names>S</given-names></name><name><surname>Maeusezahl-Feuz</surname><given-names>M</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Ezzati M, Lopez AD, Rodgers A, Murray CJL</surname></name></person-group><article-title>Indoor air pollution from solid household fuels</article-title><source>Comparative quantification of health risks</source><year>2004</year><volume>2</volume><publisher-name>Geneva: World Health Organization</publisher-name><fpage>1435</fpage><lpage>1493</lpage><ext-link ext-link-type="uri" xlink:href="http://www.who.int/publications/cra"/></citation></ref><ref id="B25"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Cohen</surname><given-names>AJ</given-names></name><name><surname>Anderson</surname><given-names>HR</given-names></name><name><surname>Ostro</surname><given-names>B</given-names></name><name><surname>Pandey</surname><given-names>KD</given-names></name><name><surname>Krzyzanowski</surname><given-names>M</given-names></name><name><surname>K&#x000fc;nzli</surname><given-names>N</given-names></name><name><surname>Gutschmidt</surname><given-names>K</given-names></name><name><surname>Pope</surname><given-names>CA</given-names><suffix>III</suffix></name><name><surname>Romieu</surname><given-names>I</given-names></name><name><surname>Samet</surname><given-names>JM</given-names></name><name><surname>Smith</surname><given-names>KR</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Ezzati M, Lopez AD, Rodgers A, Murray CJL</surname></name></person-group><article-title>Urban air pollution</article-title><source>Comparative quantification of health risks</source><year>2004</year><volume>2</volume><publisher-name>Geneva: World Health Organization</publisher-name><fpage>1353</fpage><lpage>1433</lpage><ext-link ext-link-type="uri" xlink:href="http://www.who.int/publications/cra"/></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morgenstern</surname><given-names>H</given-names></name><name><surname>Bursic</surname><given-names>ES</given-names></name></person-group><article-title>A method for using epidemiological data to estimate the potential impact of an intervention on the health status of a target population</article-title><source>J Community Health</source><year>1982</year><volume>7</volume><fpage>292</fpage><lpage>309</lpage><pub-id pub-id-type="pmid">7130448</pub-id><pub-id pub-id-type="doi">10.1007/BF01318961</pub-id></citation></ref><ref id="B27"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Last</surname><given-names>JM</given-names></name></person-group><source>A dictionary of epidemiology</source><year>2001</year><publisher-name>New York: Oxford University Press/International Epidemiological Association</publisher-name></citation></ref><ref id="B28"><citation citation-type="other"><person-group person-group-type="author"><collab>World Health Organization</collab></person-group><source>Air Quality Guidelines for particulate matter, ozone, nitrogen dioxide and sulfur dioxide Global Update 2005 Geneva</source><year>2006</year></citation></ref><ref id="B29"><citation citation-type="other"><article-title>World Health Organization website: Disability adjusted life years (DALY)</article-title><ext-link ext-link-type="uri" xlink:href="http://www.who.int/healthinfo/boddaly/en/"/></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pr&#x000fc;ss-&#x000dc;st&#x000fc;n</surname><given-names>A</given-names></name><name><surname>Corval&#x000e1;n</surname><given-names>C</given-names></name></person-group><article-title>How much disease burden can be prevented by environmental interventions</article-title><source>Epidemiology</source><year>2007</year><volume>18</volume><fpage>167</fpage><lpage>178</lpage><pub-id pub-id-type="pmid">16971860</pub-id><pub-id pub-id-type="doi">10.1097/01.ede.0000239647.26389.80</pub-id></citation></ref><ref id="B31"><citation citation-type="other"><person-group person-group-type="author"><collab>World Health Organization</collab></person-group><article-title>WHO website. Commission on Social Determinants of Health</article-title><ext-link ext-link-type="uri" xlink:href="http://www.who.int/social_determinants/en/"/></citation></ref></ref-list></back></article>