demiological Data, 1998-2004</source><year>2006</year><publisher-name>Pan American Health Organization World Health Organization</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.paho.org/English/AD/DPC/CD/mal-2005.htm"/></citation></ref><ref id="B14"><citation citation-type="other"><article-title>Regional Strategic plan for malaria in the Americas 2006 - 2010</article-title><year>2006</year><ext-link ext-link-type="uri" xlink:href="http://www.paho.org/English/AD/DPC/CD/mal-reg-strat-plan-06.pdf"/></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="editor"><name><surname>Organization WT</surname></name></person-group><article-title>Tourism Market Trends: Americas</article-title><source>Tourism Market Trends</source><year>2006</year><publisher-name>Madrid, Spain, World Tourism Organization</publisher-name><fpage>1</fpage><lpage>272</lpage></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Verret</surname><given-names>C</given-names></name><name><surname>Cabianca</surname><given-names>B</given-names></name><name><surname>Haus-Cheymol</surname><given-names>R</given-names></name><name><surname>Lafille</surname><given-names>JJ</given-names></name><name><surname>Loran-Haranqui</surname><given-names>G</given-names></name><name><surname>Spiegel</surname><given-names>A</given-names></name></person-group><article-title>Malaria outbreak in troops returning from French Guiana</article-title><source>Emerging Infectious Diseases</source><year>2006</year><volume>12</volume><fpage>1794</fpage><lpage>1795</lpage><pub-id pub-id-type="pmid">17283642</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Behrens</surname><given-names>RH</given-names></name><name><surname>Bisoffi</surname><given-names>Z</given-names></name><name><surname>Bj&#x000f6;rkman</surname><given-names>A</given