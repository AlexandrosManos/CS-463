wspan="1" colspan="1">Triphala, T4</td><td align="center" rowspan="1" colspan="1">0.3 V</td><td align="center" rowspan="1" colspan="1">7 &#x000b1; 3</td><td align="center" rowspan="1" colspan="1">33 &#x000b1; 6</td><td align="center" rowspan="1" colspan="1">10 &#x000b1; 3</td></tr></tbody></table></table-wrap><table-wrap id="T2" position="float"><label>Table&#x000a0;2</label><caption><p>Rate constants for the reaction of different radicals with curcumin</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" valign="middle" rowspan="1" colspan="1">Radical</th><th align="center" valign="middle" rowspan="1" colspan="1">Medium</th><th align="center" valign="middle" rowspan="1" colspan="1">Rate constant M<sup>&#x02212;1</sup>s<sup>&#x02212;1</sup></th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">N<sub>3</sub><sup>&#x000b7;</sup></td><td align="left" rowspan="1" colspan="1">10% acetonitrile-water</td><td align="center" rowspan="1" colspan="1">3.4 &#x000d7; 10<sup>9</sup></td></tr><tr><td align="left" rowspan="1" colspan="1">N<sub>3</sub><sup>&#x000b7;</sup></td><td align="left" rowspan="1" colspan="1">Tx-100 micelles</td><td align="center" rowspan="1" colspan="1">1.2 &#x000d7; 10<sup>9</sup></td></tr><tr><td align="left" rowspan="1" colspan="1">CCl<sub>3</sub>O<sub>2</sub></td><td align="left" rowspan="1" colspan="1">48% Isopropanol-water</td><td align="center" rowspan="1" colspan="1">1.2 &#x000d7; 10<sup>8</sup></td></tr><tr><td align="left" rowspan="1" colspan="1">Lipid peroxyl radical</td><td align="left" rowspan="1" colspan="1">Linoleic acid micelles</td><td align="center" rowspan="1" colspan="1">7.3 &#x000d7; 10<sup>5</sup></td></tr><tr><td align="left" rowspan="1" colspan="1">DPPH</td><td align="left" rowspan="1" colspan="1">Acetonitrile</td><td align="center" rowspan="1" colspan="1">1.6 &#x000d7; 10<sup>2</sup></td></tr><tr><td align="left" rowspan="1" colspan="1">Superoxide radical</td><td align="left" rowspan="1" colspan