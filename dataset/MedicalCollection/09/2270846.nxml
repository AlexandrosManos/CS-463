><lpage>1991</lpage><pub-id pub-id-type="pmid">10997404</pub-id><pub-id pub-id-type="doi">10.1097/00002030-200009080-00015</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marins</surname><given-names>JR</given-names></name><name><surname>Jamal</surname><given-names>LF</given-names></name><name><surname>Chen</surname><given-names>SY</given-names></name><name><surname>Barros</surname><given-names>MB</given-names></name><name><surname>Hudes</surname><given-names>ES</given-names></name><name><surname>Barbosa</surname><given-names>AA</given-names></name><name><surname>Chequer</surname><given-names>P</given-names></name><name><surname>Teixeira</surname><given-names>PR</given-names></name><name><surname>Hearst</surname><given-names>N</given-names></name></person-group><article-title>Dramatic improvement in survival among adult Brazilian AIDS patients</article-title><source>AIDS</source><year>2003</year><volume>17</volume><fpage>1675</fpage><lpage>1682</lpage><pub-id pub-id-type="pmid">12853750</pub-id><pub-id pub-id-type="doi">10.1097/00002030-200307250-00012</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Santoro-Lopes</surname><given-names>G</given-names></name><name><surname>de Pinho</surname><given-names>AM</given-names></name><name><surname>Harrison</surname><given-names>LH</given-names></name><name><surname>Schecter</surname><given-names>M</given-names></name></person-group><article-title>Reduced risk of tuberculosis among Brazilian patients with advanced human immunodeficiency virus infections treated with highly active antiretroviral therapy</article-title><source>Clin Infect Dis</source><year>2002</year><volume>34</volume><fpage>543</fpage><lpage>546</lpage><pub-id pub-id-type="pmid">11797184</pub-id><pub-id pub-id-type="doi">10.1086/338641</pub-id></citation></ref><ref id="B11"><citation citation-type="jo