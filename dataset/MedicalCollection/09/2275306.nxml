left">Rate</th><th align="left">(95% CI)</th></tr></thead><tbody><tr><td align="left"/><td align="left">All Cancers</td><td char="." align="char">82.8</td><td align="left">(75.7, 90.5)</td><td align="left">All Cancers</td><td char="." align="char">167.8</td><td align="left">(163.4, 172.4)</td><td align="left">All Cancers</td><td char="." align="char">155.6</td><td align="left">(150.6, 160.8)</td></tr><tr><td align="left">1</td><td align="left">Lung</td><td char="." align="char">17.2</td><td align="left">(14.1, 21.1)</td><td align="left">Lung</td><td char="." align="char">47.0</td><td align="left">(44.78, 49.5)</td><td align="left">Lung</td><td char="." align="char">47.9</td><td align="left">(45.7, 50.8)</td></tr><tr><td align="left">2</td><td align="left">Prostate</td><td char="." align="char">10.6</td><td align="left">(7.8, 14.2)</td><td align="left">Liver</td><td char="." align="char">20.3</td><td align="left">(18.8, 21.9)</td><td align="left">Prostate</td><td char="." align="char">17.8</td><td align="left">(16.1, 19.8)</td></tr><tr><td align="left">3</td><td align="left">Pancreas</td><td char="." align="char">5.8</td><td align="left">(4.1, 8.3)</td><td align="left">Colorectum</td><td char="." align="char">19.5</td><td align="left">(18.0, 21.2)</td><td align="left">Colorectum</td><td char="." align="char">16.1</td><td align="left">(14.6, 17.8)</td></tr><tr><td align="left">4</td><td align="left">Liver</td><td char="." align="char">5.3</td><td align="left">(3.6, 7.7)</td><td align="left">Stomach</td><td char="." align="char">11.7</td><td align="left">(10.5, 12.9)</td><td align="left">Liver</td><td char="." align="char">11.3</td><td align="left">(10.1, 12.7)</td></tr><tr><td align="left">5</td><td align="left">Leukemia</td><td char="." align="char">4.8</td><td align="left">(3.3, 7.1)</td><td align="left">Prostate</td><td char="." align="char">10.4</td><td align="left">(9.2, 11.7)</td><td align="left">Non-Hodgkin</td><td char="." align="char">9.1</td><td align="left">(7.9, 10.4)</td></tr></tbody></table><table frame="hsides" rules="groups"><thead><tr><th align="left"/><th align="left" colspan="3">Guamanian</th><th align="left" colspan="3">Native Hawaiian<sup>b</sup></th><th align="left" colspan="3">Japanese</th></tr></thead><tbody><tr><td align="left"/><td align="left">All Cancers</td><td char="." align="char">147.0</td><td align="left">(106.5, 201.8)</td><td align="left">All Cancers</td><td char="." align="char">263.7</td><td align="left">(243.7, 285.4)</td><td align="left">All Cancers</td><td char="." align="char">173.7</td><td align="left">(167.7, 179.9)</td></tr><tr><td align="left">1</td><td align="left">Lung</td><td char="." align="char">47.4</td><td align="left">(28.4, 81.0)</td><td align="left">Lung</td><td char="." align="char">87.7</td><td align="left">(76.4, 100.7)</td><td align="left">Lung</td><td char="." align="char">39.5</td><td align="left">(36.7, 42.5)</td></tr><tr><td align="left">2</td><td align="left"/><td align="left">nr</td><td align="left"/><td align="left">Colorectum</td><td char="." align="char">26.9</td><td align="left">(20.8, 34.9)</td><td align="left">Colorectum</td><td char="." align="char">25.8</td><td align="left">(23.6, 28.3)</td></tr><tr><td align="left">3</td><td align="left"/><td align="left">nr</td><td align="left"/><td align="left">Prostate</td><td char="." align="char">21.9</td><td align="left">(15.7, 30.1)</td><td align="left">Stomach</td><td char="." align="char">16.6</td><td align="left">(14.8, 18.7)</td></tr><tr><td align="left">4</td><td align="left"/><td align="left">nr</td><td align="left"/><td align="left">Stomach</td><td char="." align="char">14.1</td><td align="left">(9.9, 20.2)</td><td align="left">Prostate</td><td char="." align="char">15.2</td><td align="left">(13.5, 17.3)</td></tr><tr><td align="left">5</td><td align="left"/><td align="left">nr</td><td align="left"/><td align="left">Liver</td><td char="." align="char">11.8</td><td align="left">(7.9, 17.7)</td><td align="left">