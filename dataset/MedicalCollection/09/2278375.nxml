ame><surname>Kaul</surname><given-names>R</given-names></name><name><surname>Morrison</surname><given-names>VA</given-names></name><etal/></person-group><year>2005</year><article-title>Fine-scale structural variation of the human genome.</article-title><source>Nat Genet</source><volume>37</volume><fpage>727</fpage><lpage>732</lpage><pub-id pub-id-type="pmid">15895083</pub-id></citation></ref><ref id="pcbi.1000051-Ruan1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ruan</surname><given-names>Y</given-names></name><name><surname>Ooi</surname><given-names>HS</given-names></name><name><surname>Choo</surname><given-names>SW</given-names></name><name><surname>Chiu</surname><given-names>KP</given-names></name><name><surname>Zhao</surname><given-names>XD</given-names></name><etal/></person-group><year>2007</year><article-title>Fusion transcripts and transcribed retrotransposed loci discovered through comprehensive transcriptome analysis using Paired-End diTags (PETs).</article-title><source>Genome Res</source><volume>17</volume><fpage>828</fpage><lpage>838</lpage><pub-id pub-id-type="pmid">17568001</pub-id></citation></ref><ref id="pcbi.1000051-Bentley1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bentley</surname><given-names>DR</given-names></name></person-group><year>2006</year><article-title>Whole-genome re-sequencing.</article-title><source>Curr Opin Genet Dev</source><volume>16</volume><fpage>545</fpage><lpage>552</lpage><pub-id pub-id-type="pmid">17055251</pub-id></citation></ref><ref id="pcbi.1000051-httpmarketing1"><label>13</label><citation citation-type="other"><ext-link ext-link-type="uri" xlink:href="http://marketing.appliedbiosystems.com/images/Product/Solid_Knowledge/SOLiD_Chemistry_Presentation_1019.pdf">http://marketing.appliedbiosystems.com/images/Product/Solid_Knowledge/SOLiD_Chemistry_Presentation_1019.pdf</ext-link></citation></re