 id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Steiniger-White</surname><given-names>M</given-names></name><name><surname>Rayment</surname><given-names>I</given-names></name><name><surname>Renznikoff</surname><given-names>WS</given-names></name></person-group><article-title>Structure/function insights into Tn5 transposition</article-title><source>Curr. Opin. Struct. Biol.</source><year>2004</year><volume>14</volume><fpage>50</fpage><lpage>57</lpage><pub-id pub-id-type="pmid">15102449</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Golden</surname><given-names>SS</given-names></name><name><surname>Ishiura</surname><given-names>M</given-names></name><name><surname>Johnson</surname><given-names>CH</given-names></name><name><surname>Kondo</surname><given-names>T</given-names></name></person-group><article-title>Cyanobacterial circadian rhythms</article-title><source>Annu. Rev. Plant Physiol. Plant Mol. Biol.</source><year>1997</year><volume>48</volume><fpage>327</fpage><lpage>354</lpage><pub-id pub-id-type="pmid">15012266</pub-id></element-citation></ref><ref id="B19"><label>19</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Schreiber</surname><given-names>E</given-names></name><name><surname>Matthias</surname><given-names>P</given-names></name><name><surname>Mueller</surname><given-names>M</given-names></name><name><surname>Schaffner</surname><given-names>W</given-names></name></person-group><article-title>Rapid detection of octamer binding proteins with &#x0201c;mini-extracts&#x0201d;, prepared from a small number of cells</article-title><source>Nucleic Acids Res.</source><year>1989</year><volume>17</volume><fpage>6419</fpage><pub-id pub-id-type="pmid">2771659</pub-id></element-citation></ref><ref id="B20"><label>2