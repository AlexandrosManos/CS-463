t">53</td><td align="left">26</td><td align="left">9</td><td align="left">19</td><td align="left">11</td><td align="left">67</td><td align="left">16</td><td align="left">13</td></tr><tr><td align="left">Opossum Otop2</td><td align="left">30</td><td align="left">12</td><td align="left">23</td><td align="left">10</td><td align="left">11</td><td align="left">46</td><td align="left">32</td><td align="left">6</td><td align="left">19</td><td align="left">11</td><td align="left">65</td><td align="left">16</td><td align="left">13</td></tr><tr><td align="left"><italic>X. tropicalis </italic>Otop2</td><td align="left">31*</td><td align="left">12</td><td align="left">22</td><td align="left">10</td><td align="left">11</td><td align="left">54</td><td align="left">25</td><td align="left">8</td><td align="left">19</td><td align="left">11</td><td align="left">62</td><td align="left">16</td><td align="left">13</td></tr><tr><td align="left">Stickleback Otop2</td><td align="left">31*</td><td align="left">12</td><td align="left">23</td><td align="left">10</td><td align="left">11</td><td align="left">52</td><td align="left">20</td><td align="left">12</td><td align="left">19</td><td align="left">11</td><td align="left">64</td><td align="left">16</td><td align="left">13</td></tr><tr><td colspan="14"><hr/></td></tr><tr><td align="left">Mouse Otop3</td><td align="left">70</td><td align="left">12</td><td align="left">23</td><td align="left">10</td><td align="left">11</td><td align="left">44</td><td align="left">24</td><td align="left">8</td><td align="left">19</td><td align="left">11</td><td align="left">54</td><td align="left">16</td><td align="left">13</td></tr><tr><td align="left">Rat Otop3</td><td align="left">71</td><td align="left">12</td><td align="left">23</td><td align="left">10</td><td align="left">11</td><td align="left">44</td><td align="left">24</td><td align="left">8</td><td align="left">19</td><td align="left">11</td><td align="left">54</td><td align="left">16</td><td align="left">13</td></tr><tr><td align="left">Human OTOP3</td><td align="left">89</td><td align="left">12</td><td align="left">23</td><td align="left">10</td><td align="left">11</td><td align="left">44</td><td align="left">24</td><td align="left">8</td><td align="left">19</td><td align="left">11</td><td align="left">54</td><td align="left">16</td><td align="left">13</td></tr><tr><td align="left">Dog Otop3</td><td align="left">71</td><td align="left">12</td><td align="left">23</td><td align="left">10</td><td align="left">11</td><td align="left">44</td><td align="left">24</td><td align="left">8</td><td align="left">19</td><td align="left">11</td><td align="left">54</td><td align="left">16</td><td align="left">13</td></tr><tr><td align="left">Opossum Otop3</td><td align="left">59*</td><td align="left">12</td><td align="left">23</td><td align="left">10</td><td align="left">11</td><td align="left">44</td><td align="left">24</td><td align="left">8</td><td align="left">19</td><td align="left">11</td><td align="left">58</td><td align="left">16</td><td align="left">13</td></tr><tr><td align="left">Platypus Otop3</td><td align="left">51*</td><td align="left">12</td><td align="left">23</td><td align="left">10</td><td align="left">11</td><td align="left">44</td><td align="left">24</td><td align="left">8</td><td align="left">19</td><td align="left">11</td><td align="left">51</td><td align="left">16</td><td align="left">13</td></tr><tr><td align="left">Chicken Otop3</td><td align="left">24</td><td align="left">12</td><td align="left">23</td><td align="left">10</td><td align="left">11</td><td align="left">44</td><td align="left">23</td><td align="left">8</td><td align="left">19</td><td align="left">11</td><td align="left">62</td><td align="left">16</td><td align="left">13</td></tr><tr><td align="left"><italic>X. tropicalis </italic>Otop3</td><td align="left">34</td><td align="left">12</td><td align="left">23</td><td align="left">10</td><td align="left">11</td><td align="left">43</td><td align="left">22</td><td align="left">8</td><td align="left">19</td><td align="left">11</td><td align="left">46</td><td align="left">16</td><td align="left">13</td></tr><tr><td align="left">Stickleback Otop3</td><td align="left">48</td><td align="left">12</td><td align="left">23</td><td align="left">10</td><td align="left">11</td><td align="left">45</td><td align="left">28</td><td align="left">8</td><td align="left">19</td><td align="left">11</td><td align="left">60</td><td align="left">16</td><td align="left">13</td></tr><tr><td align="left">Fugu Otop3</td><td align="left">1*</td><td align="left">12</td><td align="left">23</td><td align="left">10</td><td align="left">11</td><td align="left">45</td><td align="left">27</td><td align="left">8</td><td align="left">19</td><td align="left">11</td><td align="left">44</td><td align="left">16</td><td align="left">11</td></tr><tr><td colspan="14"><hr/></td></tr><tr><td align="left"><italic>D. melanogaster </italic>OTOPLa</td><td align="left">64</td><td align="left">14</td><td align="left">79</td><td align="left">13</td><td align="left">11</td><td align="left">337</td><td align="left">43</td><td align="left">8</td><td align="left">15</td><td align="left">9</td><td align="left">14</td><td align="left">16</td><td align="left">19</td></tr><tr><td align="left"><italic>A. gambiae </italic>OTOPLa</td><td align="left">65</td><td align="left">14</td><td align="left">69</td><td align="left">13</td><td align="left">11</td><td align="left">264</td><td align="left">43</td><td align="left">8</td><td align="left">15</td><td align="left">9</td><td align="left">14</td><td align="left">16</td><td align="left">19</td></tr><tr><td align="left">A. mellifera. OTOPLa</td><td align="left">73</td><td align="left">14</td><td align="left">74</td><td align="left">13</td><td align="left">11</td><td align="left">202</td><td align="left">44</td><td align="left">8</td><td align="left">15</td><td align="left">9</td><td align="left">14</td><td align="left">16</td><td align="left">19</td></tr><tr><td colspan="14"><hr/></td></tr><tr><td align="left"><italic>T. castaneum </italic>OTOPLa</td><td align="left">65</td><td align="left">14</td><td align="left">79</td><td align="left">13</td><td align="left">11</td><td align="left">148</td><td align="left">42</td><td align="left">8</td><td align="left">15</td><td align="left">9</td><td align="left">14</td><td align="left">16</td><td align="left">19</td></tr><tr><td align="left"><italic>D. melanogaster </italic>OTOPLb</td><td align="left">76</td><td align="left">14</td><td align="left">26</td><td align="left">13</td><td align="left">12</td><td align="left">94</td><td align="left">34</td><td align="left">8</td><td align="left">20</td><td align="left">10</td><td align="left">14</td><td align="left">16</td><td align="left">19</td></tr><tr><td align="left"><italic>D. pseudoobscura </italic>OTOPLb</td><td align="left">76</td><td align="left">14</td><td align="left">26</td><td align="left">13</td><td align="left">12</td><td align="left">94</td><td align="left">34</td><td align="left">8</td><td align="left">20</td><td align="left">10</td><td align="left">14</td><td align="left">16</td><td align="left">19</td></tr><tr><td align="left"><italic>A. gambiae </italic>OTOPLb1</td><td align="left">26</td><td align="left">14</td><td align="left">28</td><td align="left">13</td><td align="left">12</td><td align="left">91</td><td align="left">37</td><td align="left">8</td><td align="left">21</td><td align="left">10</td><td align="left">14</td><td align="left">16</td><td align="left">22</td></tr><tr><td align="left"><italic>A. aegypti </italic>OTOPLb1</td><td align="left">197</td><td align="left">14</td><td align="left">26</td><td align="left">13</td><td align="left">12</td><td align="left">87</td><td align="left">37</td><td align="left">8</td><td align="left">21</td><td align="left">10</td><td align="left">14</td><td align="left">16</td><td align="left">22</td></tr><tr><td align="left"><italic>T. cas