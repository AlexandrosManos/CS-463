"1"><bold>34.5</bold></td><td align="left" rowspan="1" colspan="1">13.71</td><td align="left" rowspan="1" colspan="1">0.001</td><td align="left" rowspan="1" colspan="1">61.79</td><td align="left" rowspan="1" colspan="1">38.67</td><td align="left" rowspan="1" colspan="1">23.12</td><td align="left" rowspan="1" colspan="1"><bold>37.4</bold></td><td align="left" rowspan="1" colspan="1">31.18</td><td align="left" rowspan="1" colspan="1">0.000</td></tr><tr><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">49.02</td><td align="left" rowspan="1" colspan="1">50.89</td><td align="left" rowspan="1" colspan="1">&#x02212;1.87</td><td align="left" rowspan="1" colspan="1"><bold>3.7</bold></td><td align="left" rowspan="1" colspan="1">19.09</td><td align="left" rowspan="1" colspan="1">0.000</td><td align="left" rowspan="1" colspan="1">48.84</td><td align="left" rowspan="1" colspan="1">39.44</td><td align="left" rowspan="1" colspan="1">9.40</td><td align="left" rowspan="1" colspan="1"><bold>19.2</bold></td><td align="left" rowspan="1" colspan="1">15.37</td><td align="left" rowspan="1" colspan="1">0.000</td><td align="left" rowspan="1" colspan="1">54.32</td><td align="left" rowspan="1" colspan="1">39.44</td><td align="left" rowspan="1" colspan="1">14.88</td><td align="left" rowspan="1" colspan="1"><bold>27.4</bold></td><td align="left" rowspan="1" colspan="1">75.58</td><td align="left" rowspan="1" colspan="1">0.000</td></tr><tr><td align="left" rowspan="1" colspan="1">7</td><td align="left" rowspan="1" colspan="1">0.180</td><td align="left" rowspan="1" colspan="1">0.172</td><td align="left" rowspan="1" colspan="1">0.008</td><td align="left" rowspan="1" colspan="1"><bold>4.4</bold></td><td align="left" rowspan="1" colspan="1">21.70</td><td align="left" rowspan="1" colspan="1">0.000</td><td align="left" rowspan="1" colspan="1">0.163</td><td align="left" rowspan="1" colspan="1">0.163</td><td align="left" rowspan="1" colspan="1">0.000</td><td align="l