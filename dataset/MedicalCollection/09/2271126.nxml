pone.0001923-Jackson1"><label>31</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Jackson</surname><given-names>JD</given-names></name></person-group><year>1998</year><article-title>Classical electrodynamics.</article-title><publisher-loc>New York</publisher-loc><publisher-name>Wiley</publisher-name></citation></ref><ref id="pone.0001923-Roth1"><label>32</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Roth</surname><given-names>BJ</given-names></name><name><surname>Basser</surname><given-names>PJ</given-names></name></person-group><year>1990</year><article-title>A model of the stimulation of a nerve fiber by electromagnetic induction.</article-title><source>IEEE Trans Biomed Eng</source><volume>37</volume><fpage>588</fpage><lpage>597</lpage><pub-id pub-id-type="pmid">2354840</pub-id></citation></ref><ref id="pone.0001923-Corthout1"><label>33</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Corthout</surname><given-names>E</given-names></name><name><surname>Barker</surname><given-names>AT</given-names></name><name><surname>Cowey</surname><given-names>A</given-names></name></person-group><year>2001</year><article-title>Transcranial magnetic stimulation. Which part of the current waveform causes the stimulation?</article-title><source>Exp Brain Res</source><volume>141</volume><fpage>128</fpage><lpage>132</lpage><pub-id pub-id-type="pmid">11685417</pub-id></citation></ref><ref id="pone.0001923-Barker2"><label>34</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barker</surname><given-names>AT</given-names></name><name><surname>Garnham</surname><given-names>CW</given-names></name><name><surname>Freeston</surname><given-names>IL</given-names></name></person-group><year>1991</year><article-title>Magnetic nerve stimulation: the effect of waveform on efficiency, determination of neural mem