b-id pub-id-type="pmid">3876077</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hooyman</surname><given-names>JR</given-names></name><name><surname>Melton</surname><given-names>LJ</given-names><suffix>3rd</suffix></name><name><surname>Nelson</surname><given-names>AM</given-names></name><name><surname>O'Fallon</surname><given-names>WM</given-names></name><name><surname>Riggs</surname><given-names>BL</given-names></name></person-group><article-title>Fractures after rheumatoid arthritis. A population-based study</article-title><source>Arthritis &#x00026; Rheumatism</source><year>1984</year><volume>27</volume><fpage>1353</fpage><lpage>61</lpage><pub-id pub-id-type="pmid">6508860</pub-id><pub-id pub-id-type="doi">10.1002/art.1780271205</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Compston</surname><given-names>J</given-names></name></person-group><article-title>Guidelines for the management of osteoporosis: the present and the future</article-title><source>Osteoporosis International</source><year>2005</year><volume>16</volume><fpage>1173</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">15983729</pub-id><pub-id pub-id-type="doi">10.1007/s00198-005-1894-4</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brand</surname><given-names>CA</given-names></name><name><surname>Jolley</surname><given-names>D</given-names></name><name><surname>Tellus</surname><given-names>M</given-names></name><name><surname>Muirden</surname><given-names>KD</given-names></name><name><surname>Wark</surname><given-names>JD</given-names></name></person-group><article-title>Risk factors for osteoporosis and fracture in patients attending rheumatology outpatient clinics</article-title><source>Australian &#x00026; New Zealand Journal of Medicine</source><year>1999<