l Plant Microbe Interact</source><year>2007</year><volume>20</volume><fpage>1175</fpage><lpage>1182</lpage><pub-id pub-id-type="doi">10.1094/MPMI-20-10-1175</pub-id><pub-id pub-id-type="pmid">17918619</pub-id></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="journal"><name><surname>Temporini</surname><given-names>ED</given-names></name><name><surname>VanEtten</surname><given-names>HD</given-names></name><article-title>An analysis of the phylogenetic distribution of the pea pathogenicity genes of <italic>Nectria haematococca</italic></article-title><source>Curr Genet</source><year>2004</year><volume>46</volume><fpage>29</fpage><lpage>36</lpage><pub-id pub-id-type="doi">10.1007/s00294-004-0506-8</pub-id><pub-id pub-id-type="pmid">15118835</pub-id></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="book"><name><surname>Hershkovitz</surname><given-names>MA</given-names></name><name><surname>Zimmer</surname><given-names>EA</given-names></name><name><surname>Hahn</surname><given-names>WJ</given-names></name><person-group person-group-type="editor">Hollingsworth P, Bateman R, Gornall R</person-group><article-title>Ribosomal DNA and angiosperm systematics</article-title><source>Molecular Systematics and Plant Evolution</source><year>1999</year><publisher-name>Taylor &#x00026; Francis</publisher-name><fpage>268</fpage><lpage>326</lpage></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="book"><name><surname>White</surname><given-names>TJ</given-names></name><name><surname>Bruns</surname><given-names>T</given-names></name><name><surname>Lee</surname><given-names>S</given-names></name><name><surname>Taylor</surname><given-names>JW</given-names></name><source>Amplification and direct sequencing of fungal ribosomal RNA genes for phylogenetics</source><year>1990</year><publisher-name>San Diego, CA: Academic Press</publisher-name></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="journal"><name><surname>Johanson</surname><given-names>A</given-names></name><name><surname>Turner</surname><given-names>HC</given-names></name><name><surname>Mckay</surname><given-names>GJ</given-names></name><name><surname>Brown</surname><given-names>AE</given-names></name><article-title>A PCR-based method to distinguish fungi of rice sheath-blight complex, <italic>Rhizoctonia solani, R. oryzae </italic>and <italic>R. oryzae-sativae</italic></article-title><source>FEMS Microbiol Lett</source><year>1998</year><volume>162</volume><fpage>289</fpage><lpage>294</lpage><pub-id pub-id-type="pmid">9627963</pub-id></mixed-citation></ref><ref id="B19"><mixed-citation publication-type="journal"><name><surname>Plamann</surname><given-names>M</given-names></name><name><surname>Minke</surname><given-names>PE</given-names></name><name><surname>Tinsley</surname><given-names>JH</given-names></name><name><surname>Bruno</surname><given-names>KS</given-names></name><article-title>Cytoplasmic dynein and actin-related protein Arpl are required for normal nuclear distribution in filamentous fungi</article-title><source>J Cell Biol</source><year>1994</year><volume>127</volume><fpage>139</fpage><lpage>149</lpage><pub-id pub-id-type="doi">10.1083/jcb.127.1.139</pub-id><pub-id pub-id-type="pmid">7929559</pub-id></mixed-citation></ref><ref id="B20"><mixed-citation publication-type="other"><name><surname>Sneh</surname><given-names>B</given-names></name><name><surname>Burpee</surname><given-names>L</given-names></name><name><surname>Ogoshi</surname><given-names>A</given-names></name><article-title>Identification of <italic>Rhizoctonia </italic>species</article-title><source>APS Press, St Paul, MN, USA</source><year>1991</year></mixed-citation></ref><ref id="B21"><mixed-citation publication-type="journal"><name><surname>Woese</surname><given-names>CR</given-names></name><article-title>The universal ancestor</article-title><source>PNAS</source><year>1998</year><volume>95</volume><fpage>6854</fpage><lpage>6859</lpage><pub-id pub-id-type="doi">10.1073/pnas.95.12.6854</pub-id><pub-id pub-id-type="pmid">9618502</pub-id></mixed-citation></ref><ref id="B22"><mixed-citation publication-type="book"><name><surname>Sambrook</surname><given-names>J</given-names></name><name><surname>Frisch</surname><given-names>EF</given-names></name><name><surname>Maniatis</surname><given-names>T</given-names></name><source>Molecular Cloning: A Laboratory Manual</source><year>1989</year><edition>second</edition><publisher-name>Cold Spring Harbor Laboratory, Cold Spring Harbor, NY</publisher-name></mixed-citation></ref></ref-list></back></article>