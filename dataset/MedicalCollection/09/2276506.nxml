id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fisher</surname><given-names>JO</given-names></name><name><surname>Birch</surname><given-names>LL</given-names></name></person-group><article-title>Eating in the absence of hunger and overweight in girls from 5 to 7 y of age</article-title><source>Am J Clin Nutr</source><year>2002</year><volume>76</volume><fpage>226</fpage><lpage>231</lpage><pub-id pub-id-type="pmid">12081839</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>JL</given-names></name><name><surname>Kennedy</surname><given-names>C</given-names></name></person-group><article-title>Family Functioning, Parenting Style and Chinese Children's Weight Status</article-title><source>Journal of Family Nursing</source><year>2004</year><volume>10</volume><fpage>262</fpage><lpage>279</lpage><pub-id pub-id-type="doi">10.1177/1074840704264021</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brann</surname><given-names>LS</given-names></name><name><surname>Skinner</surname><given-names>JD</given-names></name></person-group><article-title>More controlling child-feeding practices are found among parents of boys with an average body mass index compared with parents of boys with a high body mass index</article-title><source>J Am Diet Assoc</source><year>2005</year><volume>105</volume><fpage>1411</fpage><lpage>1416</lpage><pub-id pub-id-type="pmid">16129082</pub-id><pub-id pub-id-type="doi">10.1016/j.jada.2005.06.005</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>JL</given-names></name><name><surname>Kennedy</surname><given-names>C</given-names></name><name><surname>Yeh</surname><given-names>CH</given-names></name><name><surname>Kools</s