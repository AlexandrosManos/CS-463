B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hatcher</surname><given-names>L</given-names></name></person-group><source>A Step-by-Step Approach to Using SAS for Factor Analysis and Structural Equation Modeling</source><year>1994</year><publisher-name>SAS Institute Inc. Cary, NC</publisher-name></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Kleinbaum</surname><given-names>D</given-names></name><name><surname>Kupper</surname><given-names>LL</given-names></name><name><surname>Muller</surname><given-names>KE</given-names></name></person-group><source>Applied Regression Analysis and Other Multivariable Methods</source><year>1988</year><edition>2</edition><publisher-name>PWS-Kent, Boston, MA</publisher-name><pub-id pub-id-type="pmid">3395499</pub-id></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gorsuch</surname><given-names>RL</given-names></name></person-group><source>Factor Analysis, Second Edition</source><year>1983</year><publisher-name>Lawrence Erlbaum Associates, Publishers, Hillsdale, NJ</publisher-name></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vaarst</surname><given-names>M</given-names></name><name><surname>Paarup-Laursen</surname><given-names>B</given-names></name><name><surname>Houe</surname><given-names>H</given-names></name><name><surname>Fossing</surname><given-names>C</given-names></name><name><surname>Andersen</surname><given-names>HJ</given-names></name></person-group><article-title>Farmers' choice of medical treatment of mastitis in Danish dairy herds based on qualitative research interviews</article-title><source>J Dairy Sci</source><year>2002</year><volume>85</volume><fpage>992</fpage><lpage>1001</lpage><pub-id pub-id-type="pmid">12018446</pub-id></citation></ref><ref id="B17"><citation c