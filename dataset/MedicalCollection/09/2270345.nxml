lign="left" rowspan="1" colspan="1">10</td><td align="left" rowspan="1" colspan="1">1,3</td><td align="left" rowspan="1" colspan="1">0.037 (&#x000b1;0.02)</td><td align="left" rowspan="1" colspan="1">0.53 (&#x000b1;0.06)</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">House 2</td><td align="left" rowspan="1" colspan="1">2003</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Pop 5</td><td align="left" rowspan="1" colspan="1">Portuguesa</td><td align="left" rowspan="1" colspan="1">Terronal</td><td align="left" rowspan="1" colspan="1">Palm 2 by pop 2</td><td align="left" rowspan="1" colspan="1">2003</td><td align="left" rowspan="1" colspan="1">35</td><td align="left" rowspan="1" colspan="1">1,3</td><td align="left" rowspan="1" colspan="1">0.02 (&#x000b1;0.01)</td><td align="left" rowspan="1" colspan="1">0.33 (&#x000b1;0.08)</td></tr><tr><td align="left" rowspan="1" colspan="1">Pop 6</td><td align="left" rowspan="1" colspan="1">Portuguesa</td><td align="left" rowspan="1" colspan="1">Los Rastrojos</td><td align="left" rowspan="1" colspan="1">House</td><td align="left" rowspan="1" colspan="1">2004</td><td align="left" rowspan="1" colspan="1">22</td><td align="left" rowspan="1" colspan="1">1,2</td><td align="left" rowspan="1" colspan="1">0.0004 (&#x000b1;0.001)</td><td align="left" rowspan="1" colspan="1">0.17 (&#x000b1;0.10)</td></tr><tr><td align="left" rowspan="1" colspan="1">Pop 7</td><td align="left" rowspan="1" colspan="1">Portuguesa</td><td align="left" rowspan="1" colspan="1">Los Rastrojos</td><td align="left" rowspan="1" colspan="1">Palm</td><td align="left" rowspan="1" colspan="1">2004</td><td align="left" rowspan="1" colspan="1">10</td><td align="left" rowspa