</volume><fpage>57</fpage><lpage>64</lpage><pub-id pub-id-type="pmid">15635139</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burroughs</surname><given-names>TE</given-names></name><name><surname>Waterman</surname><given-names>AD</given-names></name><name><surname>Gallagher</surname><given-names>TH</given-names></name><name><surname>Waterman</surname><given-names>B</given-names></name><name><surname>Jeffe</surname><given-names>DB</given-names></name><name><surname>Dunagan</surname><given-names>WC</given-names></name><name><surname>Garbutt</surname><given-names>J</given-names></name><name><surname>Cohen</surname><given-names>MM</given-names></name><name><surname>Cira</surname><given-names>J</given-names></name><name><surname>Fraser</surname><given-names>VJ</given-names></name></person-group><article-title>Medication Safety: Patients' Concerns About Medical Errors During Hospitalization</article-title><source>Joint Commission Journal on Quality and Patient Safety</source><year>2007</year><volume>33</volume><fpage>5</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">17283937</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wasson</surname><given-names>JH</given-names></name><name><surname>MacKenzie</surname><given-names>TA</given-names></name><name><surname>Hall</surname><given-names>M</given-names></name></person-group><article-title>Patients use an internet technology to report when things go wrong</article-title><source>Qual Saf Health Care</source><year>2007</year><volume>16</volume><fpage>213</fpage><lpage>215</lpage><pub-id pub-id-type="pmid">17545349</pub-id><pub-id pub-id-type="doi">10.1136/qshc.2006.019810</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>MacPherson</surname><given-names>H</given-names></name><name><surname