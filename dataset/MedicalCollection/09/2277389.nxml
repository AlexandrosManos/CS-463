ticle-title>Interim Pre-Pandemic Planning Guidance:  Community Strategy for Pandemic Influenza Mitigation in the United States--Early, Targeted, Layered Use of Nonpharmaceuticial Interventions</article-title><ext-link ext-link-type="uri" xlink:href="http://www.pandemicflu.gov/plan/community/community_mitigation.pdf"/></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><collab>Homeland Security Council</collab></person-group><person-group person-group-type="editor"><name><surname>Council WHHS</surname></name></person-group><source>National Strategy for Pandemic Influenze:  Implementation Plan, One Year Summary</source><year>2007</year></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hatchett</surname><given-names>RJ</given-names></name><name><surname>Mecher</surname><given-names>CE</given-names></name><name><surname>Lipsitch</surname><given-names>M</given-names></name></person-group><article-title>Public health interventions and epidemic intensity during the 1918 influenza pandemic</article-title><source>Proc Natl Acad Sci U S A</source><year>2007</year><pub-id pub-id-type="pmid">17416679</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Markel</surname><given-names>H</given-names></name><name><surname>Stern</surname><given-names>AM</given-names></name><name><surname>Navarro</surname><given-names>JA</given-names></name><name><surname>Michalsen</surname><given-names>JR</given-names></name><name><surname>Monto</surname><given-names>AS</given-names></name><name><surname>DiGiovanni</surname><given-names>C</given-names></name></person-group><article-title>Nonpharmaceutical influenza mitigation strategies, US communities, 1918-1920 pandemic</article-title><source>Emerging Infectious Diseases</source><year>2006</year><volume>12</volume><pub-id pub-id-type="pmid">17326953</pub-id></citation></ref><ref id="B26"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bootsma</surname><given-names>MCJ</given-names></name><name><surname>Ferguson</surname><given-names>NM</given-names></name></person-group><article-title>The effect of public health measures on the 1918 influenza pandemic in US cities</article-title><source>Proceedings of the National Academy of Sciences of the United States of America</source><year>2007</year><volume>104</volume><publisher-name>2101 CONSTITUTION AVE NW, WASHINGTON, DC 20418 USA , NATL ACAD SCIENCES</publisher-name><fpage>7588</fpage><pub-id pub-id-type="pmid">17416677</pub-id><pub-id pub-id-type="doi">10.1073/pnas.0611071104</pub-id></citation></ref><ref id="B27"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Killworth</surname><given-names>PD</given-names></name><name><surname>Bernard</surname><given-names>HR</given-names></name></person-group><article-title>INFORMANT ACCURACY IN SOCIAL NETWORK DATA-III - COMPARISON OF TRIADIC STRUCTURE IN BEHAVIORAL AND COGNITIVE DATA</article-title><source>Social Networks</source><year>1979</year><volume>2</volume><publisher-name>PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS , ELSEVIER SCIENCE BV</publisher-name><fpage>19</fpage><pub-id pub-id-type="doi">10.1016/0378-8733(79)90009-1</pub-id></citation></ref><ref id="B28"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Beutel S</surname><given-names>P</given-names></name><name><surname>Shkedy</surname><given-names>Z</given-names></name><name><surname>Aerts</surname><given-names>M</given-names></name><name><surname>Van Damme</surname><given-names>P</given-names></name></person-group><article-title>Social mixing patterns for transmission models of close contact infections: exploring self-evaluation and diary-based data collection through a web-based interface</article-title><source>Epidemiology and Infection</source><year>2006</year><volume>134</volume><publisher-name>32 AVENUE OF THE AMERICAS, NEW YORK, NY 10013-2473 USA , CAMBRIDGE UNIV PRESS</publisher-name><fpage>1158</fpage><pub-id pub-id-type="pmid">16707031</pub-id><pub-id pub-id-type="doi">10.1017/S0950268806006418</pub-id></citation></ref></ref-list></back></article>