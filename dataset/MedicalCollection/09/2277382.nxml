mes></name><name><surname>Reed</surname><given-names>CJ</given-names></name><name><surname>Green</surname><given-names>DJ</given-names></name><name><surname>Hankey</surname><given-names>GJ</given-names></name><name><surname>Arnolda</surname><given-names>LF</given-names></name></person-group><article-title>Ultrasound settings significantly alter arterial lumen and wall thickness measurements</article-title><source>Cardiovasc Ultrasound</source><year>2008</year><volume>6</volume><comment>ioi:10.1186/1476-7120-1186-1186</comment><pub-id pub-id-type="pmid">18208623</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bots</surname><given-names>ML</given-names></name><name><surname>Baldassarre</surname><given-names>D</given-names></name><name><surname>Simon</surname><given-names>A</given-names></name><name><surname>de Groot</surname><given-names>E</given-names></name><name><surname>O'Leary</surname><given-names>DH</given-names></name><name><surname>Riley</surname><given-names>W</given-names></name><name><surname>Kastelein</surname><given-names>JJ</given-names></name><name><surname>Grobbee</surname><given-names>DE</given-names></name></person-group><article-title>Carotid intima-media thickness and coronary atherosclerosis: weak or strong relations?</article-title><source>Eur Heart J</source><year>2007</year><volume>28</volume><fpage>398</fpage><lpage>406</lpage><pub-id pub-id-type="pmid">17277033</pub-id><pub-id pub-id-type="doi">10.1093/eurheartj/ehl482</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Al-Shali</surname><given-names>K</given-names></name><name><surname>House</surname><given-names>AA</given-names></name><name><surname>Hanley</surname><given-names>AJ</given-names></name><name><surname>Kahn</surname><given-names>HM</given-names></name><name><surname>Harris</surname><given-names>SB</given-names></name><name>