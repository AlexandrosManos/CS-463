176</td><td align="right">4339</td><td align="right">4447</td></tr></tbody></table></table-wrap><table-wrap position="float" id="T5"><label>Table 5</label><caption><p>Centiles for Girls, Multiparous</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="center"><bold>Gestational Age</bold></td><td align="center"><bold>No</bold>.</td><td align="center"><bold>L d.f. = 4</bold></td><td align="center"><bold>M d.f. = 14</bold></td><td align="center"><bold>S d.f. = 8</bold></td><td align="center"><bold>3<sup>rd</sup></bold></td><td align="center"><bold>5<sup>th</sup></bold></td><td align="center"><bold>10<sup>th</sup></bold></td><td align="center"><bold>25<sup>th</sup></bold></td><td align="center"><bold>50<sup>th</sup></bold></td><td align="center"><bold>75<sup>th</sup></bold></td><td align="center"><bold>90<sup>th</sup></bold></td><td align="center"><bold>95<sup>th</sup></bold></td><td align="center"><bold>97<sup>th</sup></bold></td></tr></thead><tbody><tr><td align="right"><bold>24</bold></td><td align="right">65</td><td align="right">1.14</td><td align="right">630</td><td align="right">0.247</td><td align="right">326</td><td align="right">366</td><td align="right">426</td><td align="right">524</td><td align="right">630</td><td align="right">734</td><td align="right">826</td><td align="right">881</td><td align="right">916</td></tr><tr><td align="right"><bold>25</bold></td><td align="right">59</td><td align="right">1.11</td><td align="right">720</td><td align="right">0.245</td><td align="right">377</td><td align="right">422</td><td align="right">489</td><td align="right">599</td><td align="right">719</td><td align="right">837</td><td align="right">942</td><td align="right">1004</td><td align="right">1044</td></tr><tr><td align="right"><bold>26</bold></td><td align="right">101</td><td align="right">1.09</td><td align="right">832</td><td align="right">0.244</td><td align="right">442</td><td align="right">492</td><td align="right">568</td><td align="right"