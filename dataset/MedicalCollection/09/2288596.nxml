p person-group-type="author"><name><surname>Baricault</surname><given-names>S</given-names></name><name><surname>Soubrane</surname><given-names>JC</given-names></name><name><surname>Courville</surname><given-names>P</given-names></name><name><surname>Young</surname><given-names>P</given-names></name><name><surname>Joly</surname><given-names>P</given-names></name></person-group><article-title>Eryth&#x000e8;me n&#x000e9;crolytique migrateur au cours d'une maladie de Waldmann</article-title><source>Ann Dermatol Venereol</source><year>2006</year><volume>133</volume><fpage>693</fpage><lpage>696</lpage><pub-id pub-id-type="pmid">17053741</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kalman</surname><given-names>S</given-names></name><name><surname>Bakkaloglu</surname><given-names>S</given-names></name><name><surname>Dalgic</surname><given-names>B</given-names></name><name><surname>Ozkaya</surname><given-names>O</given-names></name><name><surname>Soylemezoglu</surname><given-names>O</given-names></name><name><surname>Buyan</surname><given-names>N</given-names></name></person-group><article-title>Recurrent hemolytic uremic syndrome associated with intestinal lymphangiectasia</article-title><source>J Nephrol</source><year>2007</year><volume>20</volume><fpage>246</fpage><lpage>249</lpage><pub-id pub-id-type="pmid">17514630</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sahli</surname><given-names>H</given-names></name><name><surname>Ben Mbarek</surname><given-names>R</given-names></name><name><surname>Elleuch</surname><given-names>M</given-names></name><name><surname>Azzouz</surname><given-names>D</given-names></name><name><surname>Meddeb</surname><given-names>N</given-names></name><name><surname>Ch&#x000e9;our</surname><given-names>E</given-names></name><name><surname>Azzouz</surname><given-names>MM</given-names>