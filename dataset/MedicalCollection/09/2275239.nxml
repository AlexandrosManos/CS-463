itle>The NHS Modernisation Agency</article-title><source>Tackling Cancelled Operations Published December 2001</source><year>2001</year><publisher-name>London: Department of Health</publisher-name></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Durani</surname><given-names>P</given-names></name><name><surname>Seagrave</surname><given-names>M</given-names></name><name><surname>Neumann</surname><given-names>L</given-names></name></person-group><article-title>The Use of Theatre Time in Elective Orthopaedic Surgery</article-title><source>Ann R Coll Surg Engl</source><year>2005</year><volume>87</volume><fpage>170</fpage><lpage>172</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Iyer</surname><given-names>RV</given-names></name><name><surname>Likhith</surname><given-names>AM</given-names></name><name><surname>McLean</surname><given-names>JA</given-names></name><name><surname>Perera</surname><given-names>S</given-names></name><name><surname>Davis</surname><given-names>CH</given-names></name></person-group><article-title>Audit of operating theatre time utilization in neurosurgery</article-title><source>Br J Neurosurg</source><year>2004</year><volume>18</volume><fpage>333</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15702830</pub-id><pub-id pub-id-type="doi">10.1080/02688690400004852</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haiart</surname><given-names>DC</given-names></name><name><surname>Paul</surname><given-names>AB</given-names></name><name><surname>Griffiths</surname><given-names>JM</given-names></name></person-group><article-title>AN audit of operating theatre time in a peripheral teaching surgical unit</article-title><source>Postgrad Med J</source><year>1990</year><volume>66</volume><fpage>612</fpage><lpage>5</lpage><pub-id pu