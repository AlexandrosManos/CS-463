/pub-id><pub-id pub-id-type="doi">10.1302/0301-620X.84B5.12571</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Novakovic</surname><given-names>M</given-names></name><name><surname>Panajotovic</surname><given-names>L</given-names></name><name><surname>Kozarski</surname><given-names>J</given-names></name><name><surname>Piscevic</surname><given-names>B</given-names></name><name><surname>Stepic</surname><given-names>N</given-names></name></person-group><article-title>Complications in the use of vascularized fibular grafts: classification and treatment</article-title><source>Acta Chir Iugosl</source><year>2001</year><volume>48</volume><fpage>19</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">11889973</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>J</given-names></name><name><surname>Wang</surname><given-names>Z</given-names></name><name><surname>Hu</surname><given-names>Y</given-names></name><name><surname>Liang</surname><given-names>G</given-names></name><name><surname>Huang</surname><given-names>Y</given-names></name></person-group><article-title>Complications of massive allografts after segmental resection of malignant bone tumors</article-title><source>Zhongh ua Wai Ke Za Zhi</source><year>2000</year><volume>38</volume><fpage>332</fpage><lpage>335</lpage><pub-id pub-id-type="pmid">11832049</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ashton</surname><given-names>BA</given-names></name><name><surname>Allen</surname><given-names>TD</given-names></name><name><surname>Howlett</surname><given-names>CR</given-names></name><name><surname>Eaglesom</surname><given-names>CC</given-names></name><name><surname>Hattori</surname><given-names>A</given-names></name><name><surname>Owen</surname><given-names>M</given