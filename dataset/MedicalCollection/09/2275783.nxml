itation publication-type="journal"><name><surname>Weir</surname><given-names>JT</given-names></name><article-title>Divergent timing and patterns of species accumulation in lowland and highland neotropical birds</article-title><source>Evolution</source><year>2006</year><volume>60</volume><issue>4</issue><fpage>842</fpage><lpage>855</lpage><pub-id pub-id-type="pmid">16739464</pub-id></mixed-citation></ref><ref id="B20"><mixed-citation publication-type="journal"><name><surname>Fjeldsa</surname><given-names>J</given-names></name><name><surname>Lovett</surname><given-names>JC</given-names></name><article-title>Geographical patterns of old and young species in African forest biota: The significance of specific montane areas as evolutionary centres</article-title><source>Biodiversity and Conservation</source><year>1997</year><volume>6</volume><issue>3</issue><fpage>325</fpage><lpage>346</lpage><pub-id pub-id-type="doi">10.1023/A:1018356506390</pub-id></mixed-citation></ref><ref id="B21"><mixed-citation publication-type="journal"><name><surname>Demenocal</surname><given-names>PB</given-names></name><article-title>Pliopleistocene African Climate</article-title><source>Science</source><year>1995</year><volume>270</volume><issue>5233</issue><fpage>53</fpage><lpage>59</lpage><pub-id pub-id-type="doi">10.1126/science.270.5233.53</pub-id><pub-id pub-id-type="pmid">7569951</pub-id></mixed-citation></ref><ref id="B22"><mixed-citation publication-type="other"><name><surname>Hewitt</surname><given-names>G</given-names></name><article-title>The structure of biodiversity &#x02013; insights from molecular phylogeography</article-title><source>Frontiers in Zoology</source><year>2004</year><issue>1</issue><fpage>4</fpage><pub-id pub-id-type="doi">10.1186/1742-9994-1-4</pub-id><pub-id pub-id-type="pmid">15679920</pub-id></mixed-citation></ref><ref id="B23"><mixed-citation publication-type="journal"><name><surname>DeMenocal</surname><given-names>PB</given-names></name><article-title>African