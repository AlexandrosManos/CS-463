-id pub-id-type="doi">10.1016/S0014-2999(00)00650-6</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Honore</surname><given-names>P</given-names></name><name><surname>Buritova</surname><given-names>J</given-names></name><name><surname>Besson</surname><given-names>JM</given-names></name></person-group><article-title>Carrageenin-evoked c-Fos expression in rat lumbar spinal cord: the effects of indomethacin</article-title><source>Eur J Phamacol</source><year>1995</year><volume>272</volume><fpage>249</fpage><lpage>259</lpage><pub-id pub-id-type="doi">10.1016/0014-2999(94)00656-R</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buritova</surname><given-names>J</given-names></name><name><surname>Honore</surname><given-names>P</given-names></name><name><surname>Besson</surname><given-names>JM</given-names></name></person-group><article-title>Ketoprofen produces profound inhibition of spinal c-Fos protein expression resulting from an inflammatory stimulus but not from noxious heat</article-title><source>Pain</source><year>1996</year><volume>67</volume><fpage>379</fpage><lpage>389</lpage><pub-id pub-id-type="pmid">8951933</pub-id><pub-id pub-id-type="doi">10.1016/0304-3959(96)03138-7</pub-id></citation></ref></ref-list></back></article>