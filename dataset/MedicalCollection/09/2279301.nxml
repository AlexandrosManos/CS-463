<!DOCTYPE article PUBLIC "-//NLM//DTD JATS (Z39.96) Journal Archiving and Interchange DTD v1.0 20120330//EN" "JATS-archivearticle1.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:mml="http://www.w3.org/1998/Math/MathML" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">PLoS Pathog</journal-id><journal-id journal-id-type="publisher-id">plos</journal-id><journal-id journal-id-type="publisher-id">plpa</journal-id><journal-id journal-id-type="pmc">plospath</journal-id><journal-title-group><journal-title>PLoS Pathogens</journal-title></journal-title-group><issn pub-type="ppub">1553-7366</issn><issn pub-type="epub">1553-7374</issn><publisher><publisher-name>Public Library of Science</publisher-name><publisher-loc>San Francisco, USA</publisher-loc></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">18389084</article-id><article-id pub-id-type="pmc">2279301</article-id><article-id pub-id-type="publisher-id">07-PLPA-RA-0636R1</article-id><article-id pub-id-type="doi">10.1371/journal.ppat.1000029</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research Article</subject></subj-group><subj-group subj-group-type="Discipline"><subject>Neurological Disorders/Prion Diseases</subject></subj-group></article-categories><title-group><article-title>Beyond PrP<sup>res</sup> Type 1/Type 2 Dichotomy in Creutzfeldt-Jakob Disease</article-title><alt-title alt-title-type="running-head">PrPres Diversity and s and i CJD</alt-title></title-group><contrib-group><contrib contrib-type="author" equal-contrib="yes"><name><surname>Uro-Coste</surname><given-names>Emmanuelle</given-names></name><xref ref-type="aff" rid="aff1"><sup>1</sup></xref></contrib><contrib contrib-type="author" equal-contrib="yes"><name><surname>Cassard</surname><given-names>Herv&#x000e9;</given-names></name><xref ref-type="aff" rid="aff2"><sup>2</sup></xref></contrib><contrib contrib-type="author"><