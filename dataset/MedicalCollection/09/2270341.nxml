d align="left" rowspan="1" colspan="1"/></tr><tr><td colspan="6" align="left" rowspan="1"><bold>Classification</bold></td></tr><tr><td align="left" rowspan="1" colspan="1">BT</td><td align="left" rowspan="1" colspan="1">46</td><td align="left" rowspan="1" colspan="1">62.1</td><td align="left" rowspan="1" colspan="1">43</td><td align="left" rowspan="1" colspan="1">58.9</td><td align="left" rowspan="1" colspan="1">0.12</td></tr><tr><td align="left" rowspan="1" colspan="1">BT (PN)<xref ref-type="table-fn" rid="nt101">&#x0002a;&#x0002a;</xref></td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">4.1</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">BL (PN)<xref ref-type="table-fn" rid="nt101">&#x0002a;&#x0002a;&#x0002a;</xref></td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">4</td><td align="left" rowspan="1" colspan="1">5.5</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">BL</td><td align="left" rowspan="1" colspan="1">18</td><td align="left" rowspan="1" colspan="1">24.3</td><td align="left" rowspan="1" colspan="1">17</td><td align="left" rowspan="1" colspan="1">23.3</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">LL</td><td align="left" rowspan="1" colspan="1">7</td><td align="left" rowspan="1" colspan="1">9.5</td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">12.3</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td colspan="6" align="left" rowspan="1"><bold>Smear BI</bold><xref ref-type="table-fn" rid="nt101">&#x0002a;&#x0002a;&#x0002a;&#x0002a;</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Positive</td><td align="left" rowspan="1" colspan="1">23</