"author"><name><surname>Gregson</surname><given-names>S</given-names></name><name><surname>Donnelly</surname><given-names>CA</given-names></name><name><surname>Parker</surname><given-names>CG</given-names></name><name><surname>Anderson</surname><given-names>RM</given-names></name></person-group><year>1996</year><article-title>Demographic approaches to the estimation of incidence of HIV-1 infection among adults from age-specific prevalence data in stable endemic conditions</article-title><source>AIDS</source><volume>10</volume><fpage>1689</fpage><lpage>1697</lpage><pub-id pub-id-type="pmid">8970690</pub-id></citation></ref><ref id="pmed-0050080-b023"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Saidel</surname><given-names>T</given-names></name><name><surname>Sokal</surname><given-names>D</given-names></name><name><surname>Rice</surname><given-names>J</given-names></name><name><surname>Buzingo</surname><given-names>T</given-names></name><name><surname>Hassig</surname><given-names>S</given-names></name></person-group><year>1996</year><article-title>Validation of a method to estimate age-specific human immunodeficiency virus (HIV) incidence rates in developing countries using population-based seroprevalence data</article-title><source>Am J Epidemiol</source><volume>144</volume><fpage>214</fpage><lpage>223</lpage><pub-id pub-id-type="pmid">8686690</pub-id></citation></ref><ref id="pmed-0050080-b024"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Batter</surname><given-names>V</given-names></name><name><surname>Matela</surname><given-names>B</given-names></name><name><surname>Nsuami</surname><given-names>M</given-names></name><name><surname>Manzila</surname><given-names>T</given-names></name><name><surname>Kamenga</surname><given-names>M</given-names></name><etal/></person-group><year>1994</year><article-title>High HIV-1 incidence in young women masked by stable overall seroprevalence