</pub-id></citation></ref><ref id="pcbi.1000047-Pawson1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pawson</surname><given-names>T</given-names></name><name><surname>Scott</surname><given-names>JD</given-names></name></person-group><year>1997</year><article-title>Signaling through scaffold, anchoring, and adaptor proteins.</article-title><source>Science</source><volume>278</volume><fpage>2075</fpage><lpage>2080</lpage><pub-id pub-id-type="pmid">9405336</pub-id></citation></ref><ref id="pcbi.1000047-Xu1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Xu</surname><given-names>W</given-names></name><name><surname>Harrison</surname><given-names>SC</given-names></name><name><surname>Eck</surname><given-names>MJ</given-names></name></person-group><year>1997</year><article-title>Three-dimensional structure of the tyrosine kinase c-src.</article-title><source>Nature</source><volume>385</volume><fpage>595</fpage><lpage>602</lpage><pub-id pub-id-type="pmid">9024657</pub-id></citation></ref><ref id="pcbi.1000047-Sicheri1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sicheri</surname><given-names>F</given-names></name><name><surname>Moarefi</surname><given-names>I</given-names></name><name><surname>Kuriyan</surname><given-names>J</given-names></name></person-group><year>1997</year><article-title>Crystal structure of the Src family tyrosine kinase Hck.</article-title><source>Nature</source><volume>385</volume><fpage>602</fpage><lpage>609</lpage><pub-id pub-id-type="pmid">9024658</pub-id></citation></ref><ref id="pcbi.1000047-Schindler1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schindler</surname><given-names>T</given-names></name><name><surname>Sicheri</surname><given-names>F</given-names></name><name><surname>Pico</surname><given-names>A</given-names></name><name><surname>Gazit</surname><given-names>A</given-names></name><name><surname>Levitzki</surname><given-names>A</given-names></name><etal/></person-group><year>1999</year><article-title>Crystal structure of Hck in complex with a Src family-selective tyrosine kinase inhibitor.</article-title><source>Mol Cell</source><volume>3</volume><fpage>639</fpage><lpage>648</lpage><pub-id pub-id-type="pmid">10360180</pub-id></citation></ref><ref id="pcbi.1000047-Yamaguchi1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yamaguchi</surname><given-names>H</given-names></name><name><surname>Hendrickson</surname><given-names>WA</given-names></name></person-group><year>1996</year><article-title>Structural basis for activation of human lymphocyte kinase Lck upon tyrosine phosphorylation.</article-title><source>Nature</source><volume>384</volume><fpage>484</fpage><lpage>489</lpage><pub-id pub-id-type="pmid">8945479</pub-id></citation></ref><ref id="pcbi.1000047-Xu2"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Xu</surname><given-names>W</given-names></name><name><surname>Doshi</surname><given-names>A</given-names></name><name><surname>Lei</surname><given-names>M</given-names></name><name><surname>Eck</surname><given-names>MJ</given-names></name><name><surname>Harrison</surname><given-names>SC</given-names></name></person-group><year>1999</year><article-title>Crystal structures of c-Src reveal features of its autoinhibitory mechanism.</article-title><source>Mol Cell</source><volume>3</volume><fpage>629</fpage><lpage>638</lpage><pub-id pub-id-type="pmid">10360179</pub-id></citation></ref><ref id="pcbi.1000047-CowanJacob1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cowan-Jacob</surname><given-names>SW</given-names></name><name><surname>Fendrich</surname><given-names>G</given-names></name><name><surname>Manley</surname><given-names>PW</given-names></name><name><surname>Jahnke</surname><given-names>W</given-names></name><name><surname>Fabbro</surname><given-names>D</given-names></name><etal/></person-group><year>2005</year><article-title>The crystal structure of a c-Src complex in an active conformation suggests possible steps in c-Src activation.</article-title><source>Structure</source><volume>13</volume><fpage>861</fpage><lpage>871</lpage><pub-id pub-id-type="pmid">15939018</pub-id></citation></ref><ref id="pcbi.1000047-Knighton1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Knighton</surname><given-names>D</given-names></name><name><surname>Zheng</surname><given-names>J</given-names></name><name><surname>Ten Eyck</surname><given-names>L</given-names></name><name><surname>Ashford</surname><given-names>V</given-names></name><name><surname>Xuong</surname><given-names>N</given-names></name><etal/></person-group><year>1991</year><article-title>Crystal structure of the catalytic subunit of cyclic adenosine monophosphate-dependent protein kinase.</article-title><source>Science</source><volume>253</volume><fpage>407</fpage><lpage>414</lpage><pub-id pub-id-type="pmid">1862342</pub-id></citation></ref><ref id="pcbi.1000047-Taylor1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Taylor</surname><given-names>S</given-names></name><name><surname>Radzio-Andzelm</surname><given-names>E</given-names></name></person-group><year>1994</year><article-title>Three protein kinase structures define a common motif.</article-title><source>Structure</source><volume>15</volume><fpage>345</fpage><lpage>355</lpage><pub-id pub-id-type="pmid">8081750</pub-id></citation></ref><ref id="pcbi.1000047-Gullingsrud1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gullingsrud</surname><given-names>