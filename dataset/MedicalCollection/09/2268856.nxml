e>Geraldine</surname><given-names>P</given-names></name></person-group><article-title>Infectious keratitis.</article-title><source>Curr Opin Infect Dis</source><year>2007</year><volume>20</volume><fpage>129</fpage><lpage>41</lpage><pub-id pub-id-type="pmid">17496570</pub-id></citation></ref><ref id="r7"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Srinivasan</surname><given-names>M</given-names></name></person-group><article-title>Fungal Keratitis.</article-title><source>Curr Opin Ophthalmol</source><year>2004</year><volume>15</volume><fpage>321</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">15232472</pub-id></citation></ref><ref id="r8"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>O&#x02019;Day</surname><given-names>DM</given-names></name></person-group><article-title>Selection of appropriate antifungal therapy.</article-title><source>Cornea</source><year>1987</year><volume>6</volume><fpage>238</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">3319407</pub-id></citation></ref><ref id="r9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Poole</surname><given-names>TRG</given-names></name><name><surname>Hunter</surname><given-names>DL</given-names></name><name><surname>Maliwa</surname><given-names>EM</given-names></name><name><surname>Ramsay</surname><given-names>AR</given-names></name></person-group><article-title>Aetiology of microbial keratitis in northern Tanzania.</article-title><source>Br J Ophthalmol</source><year>2002</year><volume>86</volume><fpage>941</fpage><lpage>2</lpage><pub-id pub-id-type="pmid">12140229</pub-id></citation></ref><ref id="r10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Levin</surname><given-names>LA</given-names></name><name><surname>Avery</surname><given-names>R</given-names></name><name><sur