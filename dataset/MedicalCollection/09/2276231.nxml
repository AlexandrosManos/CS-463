align="center"><bold>D</bold></td><td align="center"><bold>A</bold></td><td align="center"><bold>K</bold></td><td align="center"><bold>V</bold></td><td align="center"><bold>H</bold></td></tr><tr><td></td><td align="center">experiment A</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td></tr><tr><td></td><td align="center">experiment B</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td></tr><tr><td></td><td align="center">experiment C</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td></tr><tr><td></td><td align="center">experiment D</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td></tr><tr><td align="left"><bold>Pat A-WT40</bold></td><td align="center"><bold>start</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>L</bold></td><td align="center"><bold>E</bold></td><td align="center"><bold>K</bold></td><td align="center"><bold>V</bold></td><td align="center"><bold>I</bold></td><td align="center"><bold>W</bold></td><td align="center"><bold>K</bold></td><td align="center"><bold>F</bold></td><td align="center"><bold>Y</bold></td><td align="center"><bold>T</bold></td><td align="center"><bold>T</bold></td><td align="center"><bold>D</bold></td><td align="center"><bold>A</bold></td><td align="center"><bold>K</bold></td><td align="center"><bold>V</bold></td><td align="center"><bold>H</bold></td></tr><tr><td></td><td align="center">experiment A</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td></tr><tr><td></td><td align="center">experiment B</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td></tr><tr><td></td><td align="center">experiment C</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td></tr><tr><td></td><td align="center">experiment D</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td></tr><tr><td align="left"><bold>K43E only</bold></td><td align="center"><bold>start</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>E</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td><td align="center"><bold>-</bold></td></tr><tr><td></td><td align="center">experiment A</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">T/I</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td><td align="center">.</td></tr><tr><td></td>