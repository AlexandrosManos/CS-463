ge><lpage>9207</lpage><year>1990</year><pub-id pub-id-type="pmid">2160965</pub-id><person-group><name><surname>Chien</surname><given-names>MM</given-names></name><name><surname>Cambier</surname><given-names>JC</given-names></name></person-group></citation></ref><ref id="r15"><citation citation-type="journal"><article-title>B lymphocyte receptors and polyphosphoinositide degradation.</article-title><source>Cell</source><volume>41</volume><issue>3</issue><fpage>999</fpage><lpage>1006</lpage><year>1985</year><pub-id pub-id-type="pmid">2408764</pub-id><pub-id pub-id-type="doi">10.1016/S0092-8674(85)80080-5</pub-id><person-group><name><surname>Bijsterbosch</surname><given-names>MK</given-names></name><name><surname>Meade</surname><given-names>CJ</given-names></name><name><surname>Turner</surname><given-names>GA</given-names></name><name><surname>Klaus</surname><given-names>GG</given-names></name></person-group></citation></ref><ref id="r16"><citation citation-type="journal"><article-title>Transitional type 1 and 2 B lymphocyte subsets are differentially responsive to antigen receptor signaling.</article-title><source>J Biol Chem</source><volume>277</volume><issue>50</issue><fpage>48009</fpage><lpage>48019</lpage><year>2002</year><pub-id pub-id-type="doi">10.1074/jbc.M200305200</pub-id><person-group><name><surname>Petro</surname><given-names>JB</given-names></name><name><surname>Gerstein</surname><given-names>RM</given-names></name><name><surname>Lowe</surname><given-names>J</given-names></name><name><surname>Carte</surname><given-names>RS</given-names></name><name><surname>Shinners</surname><given-names>N</given-names></name><name><surname>Khan</surname><given-names>WN</given-names></name></person-group><pub-id pub-id-type="pmid">12356763</pub-id></citation></ref><ref id="r17"><citation citation-type="journal"><article-title>Transitional B lymphocyte subsets operate as distinct checkpoints in murine splenic B cell development.</article-title><source>J Immunol</source><vo