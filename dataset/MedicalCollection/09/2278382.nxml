ype="journal"><person-group person-group-type="author"><name><surname>Abdool Karim</surname><given-names>Q</given-names></name><name><surname>Abdool Karim</surname><given-names>SS</given-names></name><name><surname>Soldan</surname><given-names>K</given-names></name><name><surname>Zondi</surname><given-names>M</given-names></name></person-group><year>1995</year><article-title>Reducing the risk of HIV infection among South African Sex Workers: Socioeconomic and Gender Barriers.</article-title><source>Am J Public Health</source><volume>85</volume><fpage>1521</fpage><lpage>1525</lpage><pub-id pub-id-type="pmid">7485664</pub-id></citation></ref><ref id="pone.0001954-Ramjee1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ramjee</surname><given-names>G</given-names></name><name><surname>Karim</surname><given-names>SS</given-names></name><name><surname>Sturm</surname><given-names>AW</given-names></name></person-group><year>1998</year><article-title>Sexually transmitted infections among sex workers in KwaZulu-Natal, South Africa.</article-title><source>Sex Transm Dis</source><volume>25</volume><fpage>346</fpage><lpage>349</lpage><pub-id pub-id-type="pmid">9713913</pub-id></citation></ref><ref id="pone.0001954-Ramjee2"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ramjee</surname><given-names>G</given-names></name><name><surname>Morar</surname><given-names>NS</given-names></name><name><surname>Alary</surname><given-names>M</given-names></name><name><surname>Mukenge-Tshibaka</surname><given-names>L</given-names></name><name><surname>Vuylsteke</surname><given-names>B</given-names></name><etal/></person-group><year>2000</year><article-title>Challenges in the conduct of vaginal microbicide effectiveness trials in the developing world.</article-title><source>AIDS</source><volume>14</volume><fpage>2553</fpage><lpage>2557</lpage><pub-id pub-id-type="pmid">11101067</pub-id></citation></ref><ref id="pone.0001954-Gouws1"><label>12</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gouws</surname><given-names>E</given-names></name></person-group><year>2005</year><article-title>HIV Incidence Rates in South Africa.</article-title><person-group person-group-type="editor"><name><surname>Abdool Karim</surname><given-names>S</given-names></name><name><surname>Abdool Karim</surname><given-names>Q</given-names></name></person-group><source>HIV/AIDS in South Africa</source><publisher-loc>New York</publisher-loc><publisher-name>Cambridge University Press</publisher-name><fpage>67</fpage><lpage>76</lpage></citation></ref><ref id="pone.0001954-Dunkle1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dunkle</surname><given-names>KL</given-names></name><name><surname>Jewkes</surname><given-names>RK</given-names></name><name><surname>Brown</surname><given-names>HC</given-names></name><name><surname>Gray</surname><given-names>GE</given-names></name><name><surname>McIntryre</surname><given-names>JA</given-names></name><etal/></person-group><year>2004</year><article-title>Transactional sex among women in Soweto, South Africa: prevalence, risk factors and association with HIV infection.</article-title><source>Soc Sci Med</source><volume>59</volume><fpage>1581</fpage><lpage>1592</lpage><pub-id pub-id-type="pmid">15279917</pub-id></citation></ref><ref id="pone.0001954-Shisana1"><label>14</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Shisana</surname><given-names>O</given-names></name><name><surname>Rehle</surname><given-names>T</given-names></name><name><surname>Simbayi</surname><given-names>LC</given-names></name><name><surname>Parker</surname><given-names>W</given-names></name><name><surname>Zuma</surname><given-names>K</given-names></name><etal/></person-group><year>2005</year><article-title>South African National HIV Prevalence, HIV Incidence, Behaviour and Communication Survey, 2005.</article-title><publisher-loc>Cape Town</publisher-loc><publisher-name>HSRC Press</publisher-name><fpage>33</fpage><lpage>50</lpage></citation></ref><ref id="pone.0001954-Allen1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Allen</surname><given-names>TM</given-names></name><name><surname>Altfeld</surname><given-names>M</given-names></name><name><surname>Geer</surname><given-names>SC</given-names></name><name><surname>Kalife</surname><given-names>ET</given-names></name><name><surname>Moore</surname><given-names>C</given-names></name><etal/></person-group><year>2005</year><article-title>Selective escape from CD8&#x0002b; T-cell responses represents a major driving force of human immunodeficiency virus type 1 (HIV-1) sequence diversity and reveals constraints on HIV-1 evolution.</article-title><source>J Virol</source><volume>79</volume><fpage>13239</fpage><lpage>13249</lpage><pub-id pub-id-type="pmid">16227247</pub-id></citation></ref><ref id="pone.0001954-Begaud1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Begaud</surname><given-names>E</given-names></name><name><surname>Chartier</surname><given-names>L</given-names></name><name><surname>Marechal</surname><given-names>V</given-names></name><name><surname>Ipero</surname><given-names>J</given-names></name><name><surname>Leal</surname><given-names>J</given-names></name><etal/></person-group><year>2006</year><article-title>Reduced CD4 T cell activation and in vitro susceptibility to HIV-1 infection in exposed uninfected Central Africans.</article-title><source>Retrovirology</source><volume>3</volume><fpage>35</fpage><pub-id pub-id-type="pmid">16792805</pub-id></citation></ref><ref id="pone.0001954-Fowke1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surnam