r" rowspan="1" colspan="1">0.0769</td></tr><tr><td colspan="5" rowspan="1"><hr/></td></tr><tr><td align="center" colspan="5" rowspan="1">SPIRAL</td></tr><tr><td colspan="5" rowspan="1"><hr/></td></tr><tr><td align="center" rowspan="1" colspan="1">None</td><td align="center" rowspan="1" colspan="1">0.1658</td><td align="center" rowspan="1" colspan="1">0.0908</td><td align="center" rowspan="1" colspan="1">0.0769</td><td align="center" rowspan="1" colspan="1">0.0767</td></tr><tr><td align="center" rowspan="1" colspan="1">Approximation</td><td align="center" rowspan="1" colspan="1">0.1686</td><td align="center" rowspan="1" colspan="1">0.0864</td><td align="center" rowspan="1" colspan="1">0.0773</td><td align="center" rowspan="1" colspan="1">0.0768</td></tr><tr><td align="center" rowspan="1" colspan="1">Voronoi</td><td align="center" rowspan="1" colspan="1">0.1360</td><td align="center" rowspan="1" colspan="1">0.0812</td><td align="center" rowspan="1" colspan="1">0.0781</td><td align="center" rowspan="1" colspan="1">0.0779</td></tr><tr><td colspan="5" rowspan="1"><hr/></td></tr><tr><td align="center" colspan="5" rowspan="1">SPIRAL with noise</td></tr><tr><td colspan="5" rowspan="1"><hr/></td></tr><tr><td align="center" rowspan="1" colspan="1">Voronoi</td><td align="center" rowspan="1" colspan="1">0.1444</td><td align="center" rowspan="1" colspan="1">0.0937</td><td align="center" rowspan="1" colspan="1">0.0971</td><td align="center" rowspan="1" colspan="1">0.1010</td></tr></tbody></table></table-wrap><table-wrap id="tab2" position="float"><label>Table 2</label><caption><p>CPU time andmemory usage for different iteration numbers (no.) and sizes <italic>N</italic> of the <italic>k</italic>-space data andthe reconstructed phantom.</p></caption><table frame="hsides" rules="groups"><thead><tr><th rowspan="1" colspan="1"/><th align="center" colspan="4" rowspan="1">CPU time in seconds</th><th align="center" rowspan="1" colspan="1">MByte</th></tr></thead><tbody><tr><td rowspan="1