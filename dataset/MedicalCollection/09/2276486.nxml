type="doi">10.1001/jama.285.4.421</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harris</surname><given-names>CM</given-names></name><name><surname>Scrivener</surname><given-names>G</given-names></name></person-group><article-title>Fundholders' prescribing costs: the first five years</article-title><source>BMJ</source><year>1996</year><volume>313</volume><fpage>1531</fpage><lpage>1534</lpage><pub-id pub-id-type="pmid">8978232</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rafferty</surname><given-names>T</given-names></name><name><surname>Wilson-Davis</surname><given-names>K</given-names></name><name><surname>McGavock</surname><given-names>H</given-names></name></person-group><article-title>How has fundholding in Northern Ireland affected prescribing patterns? A longitudinal study</article-title><source>BMJ</source><year>1997</year><volume>315</volume><fpage>166</fpage><lpage>170</lpage><pub-id pub-id-type="pmid">9251548</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ekedahl</surname><given-names>A</given-names></name><name><surname>M&#x000e5;nsson</surname><given-names>N</given-names></name></person-group><article-title>Unclaimed prescriptions after automated prescription transmittals to pharmacies</article-title><source>Pharm World Sci</source><year>2004</year><volume>26</volume><fpage>26</fpage><lpage>31</lpage><pub-id pub-id-type="pmid">15018256</pub-id><pub-id pub-id-type="doi">10.1023/B:PHAR.0000013464.09197.41</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tobi</surname><given-names>H</given-names></name><name><surname>van den Heuvel</surname><given-names>NJ</given-names></name><name><surname>de Jong-van den Berg</surname><given-names>LT</given-names></name></person-group><article-title>Does uncollected medication reduce the validity of pharmacy dispensing data?</article-title><source>Pharmacoepidemiol Drug Saf</source><year>2004</year><volume>13</volume><fpage>497</fpage><lpage>500</lpage><pub-id pub-id-type="pmid">15269934</pub-id><pub-id pub-id-type="doi">10.1002/pds.928</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jyrkk&#x000e4;</surname><given-names>J</given-names></name><name><surname>Vartiainen</surname><given-names>L</given-names></name><name><surname>Hartikainen</surname><given-names>S</given-names></name><name><surname>Sulkava</surname><given-names>R</given-names></name><name><surname>Enlund</surname><given-names>H</given-names></name></person-group><article-title>Increasing use of medicines in elderly persons: a five-year follow-up of the Kuopio 75+Study</article-title><source>Eur J Clin Pharmacol</source><year>2006</year><volume>62</volume><fpage>151</fpage><lpage>158</lpage><pub-id pub-id-type="pmid">16408226</pub-id><pub-id pub-id-type="doi">10.1007/s00228-005-0079-6</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>J&#x000f6;rgensen</surname><given-names>T</given-names></name><name><surname>Johansson</surname><given-names>S</given-names></name><name><surname>Kennerfalk</surname><given-names>A</given-names></name><name><surname>Wallander</surname><given-names>MA</given-names></name><name><surname>Sv&#x000e4;rdsudd</surname><given-names>K</given-names></name></person-group><article-title>Prescription drug use, diagnoses, and healthcare utilization among the elderly</article-title><source>Ann Pharmacother</source><year>2001</year><volume>35</volume><fpage>1004</fpage><lpage>1009</lpage><pub-id pub-id-type="pmid">11573845</pub-id><pub-id pub-id-type="doi">10.1345/aph.10351</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Klaukka</surname><given-names>T</given-names></name><name><surname>Makela</surname><given-names>M</given-names></name><name><surname>Sipila</surname><given-names>J</given-names></name><name><surname>Martikainen</surname><given-names>J</given-names></name></person-group><article-title>Multiuse of medicines in Finland</article-title><source>Med Care</source><year>1993</year><volume>31</volume><fpage>445</fpage><lpage>450</lpage><pub-id pub-id-type="pmid">8501991</pub-id><pub-id pub-id-type="doi">10.1097/00005650-199305000-00006</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Antonov</surname><given-names>K</given-names></name><name><surname>Isacson</surname><given-names>D</given-names></name></person-group><article-title>Use of analgesics in Sweden--the importance of sociodemographic factors, physical fitness, health and health-related factors, and working conditions</article-title><source>Soc Sci Med</source><year>1996</year><volume>42</volume><fpage>1473</fpage><lpage>1481</lpage><pub-id pub-id-type="pmid">8771630</pub-id><pub-id pub-id-type="doi">10.1016/0277-9536(96)87321-7</pub-id></citation></ref></ref-list></back></article>