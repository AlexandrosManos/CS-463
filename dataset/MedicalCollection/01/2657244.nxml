<lpage>1386</lpage><pub-id pub-id-type="pmid">17046470</pub-id></mixed-citation></ref><ref id="CR19"><label>19.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ronsmans</surname><given-names>C</given-names></name><name><surname>Campbell</surname><given-names>OMR</given-names></name><name><surname>McDermott</surname><given-names>J</given-names></name><name><surname>Koblinsky</surname><given-names>M</given-names></name></person-group><article-title>Questioning the indicators of need for obstetric care</article-title><source>Bull World Health Organ</source><year>2002</year><volume>80</volume><issue>4</issue><fpage>317</fpage><lpage>324</lpage><pub-id pub-id-type="pmid">12075369</pub-id></mixed-citation></ref><ref id="CR20"><label>20.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ross</surname><given-names>JA</given-names></name><name><surname>Begala</surname><given-names>JE</given-names></name></person-group><article-title>Measures of strength for maternal health programs in 55 developing countries: the MNPI study</article-title><source>Matern Child Health J</source><year>2005</year><volume>9</volume><issue>1</issue><fpage>59</fpage><lpage>70</lpage><pub-id pub-id-type="doi">10.1007/s10995-005-2548-z</pub-id><pub-id pub-id-type="pmid">15880975</pub-id></mixed-citation></ref><ref id="CR21"><label>21.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Goodburn</surname><given-names>EA</given-names></name></person-group><article-title>Using process indicators to monitor and evaluate obstetric services in developing countries</article-title><source>J Am Med Womens Assoc</source><year>2002</year><volume>57</volume><issue>3</issue><fpage>145</fpage><lpage>148</lpage><pub-id pub-id-type="pmid">12146605</pub-id></mixed-citation></ref><ref id="CR22"><label>22.</label><mixed-citation publication-type="journal