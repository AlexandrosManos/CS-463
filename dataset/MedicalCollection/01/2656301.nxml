-647"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Teicher</surname><given-names>MH</given-names></name><name><surname>Tomoda</surname><given-names>A</given-names></name><name><surname>Andersen</surname><given-names>SL</given-names></name></person-group><year>2006</year><article-title>Neurobiological consequences of early stress and childhood maltreatment: are results from human and animal studies comparable?</article-title><source>Ann NY Acad Sci</source><volume>1071</volume><fpage>313</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">16891580</pub-id></citation></ref><ref id="b38-ndt-3-647"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Watson</surname><given-names>S</given-names></name><name><surname>Gallagher</surname><given-names>P</given-names></name><name><surname>Del-Estal</surname><given-names>D</given-names></name><etal/></person-group><year>2002</year><article-title>Hypothalamic-pituitary-adrenal axis function in patients with chronic depression</article-title><source>Psychological Medicine</source><volume>32</volume><fpage>1021</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">12214783</pub-id></citation></ref><ref id="b39-ndt-3-647"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Watson</surname><given-names>S</given-names></name><name><surname>Gallagher</surname><given-names>P</given-names></name><name><surname>Ritchie</surname><given-names>JC</given-names></name><etal/></person-group><year>2004</year><article-title>Hypothalamic-pituitary-adrenal axis function in patients with bipolar disorder</article-title><source>British Journal of Psychiatry</source><volume>184</volume><fpage>496</fpage><lpage>502</lpage><pub-id pub-id-type="pmid">15172943</pub-id></citation></ref><ref id="b40-ndt-3-647"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Webster</surname><given-names>MJ</given-name