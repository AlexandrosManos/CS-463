<!DOCTYPE article PUBLIC "-//NLM//DTD Journal Archiving and Interchange DTD v2.3 20070202//EN" "archivearticle.dtd"><article xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:mml="http://www.w3.org/1998/Math/MathML" article-type="research-article" xml:lang="EN"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">PLoS Med</journal-id><journal-id journal-id-type="publisher-id">plos</journal-id><journal-id journal-id-type="pmc">plosmed</journal-id><journal-title>PLoS Medicine</journal-title><issn pub-type="ppub">1549-1277</issn><issn pub-type="epub">1549-1676</issn><publisher><publisher-name>Public Library of Science</publisher-name><publisher-loc>San Francisco, USA</publisher-loc></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">19365539</article-id><article-id pub-id-type="pmc">2661256</article-id><article-id pub-id-type="publisher-id">08-PLME-RA-1538R3</article-id><article-id pub-id-type="doi">10.1371/journal.pmed.1000055</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research Article</subject></subj-group><subj-group subj-group-type="Discipline"><subject>Infectious Diseases/Antimicrobials and Drug Resistance</subject></subj-group></article-categories><title-group><article-title>Multiple Origins and Regional Dispersal of Resistant <italic>dhps</italic> in African <italic>Plasmodium falciparum</italic> Malaria</article-title><alt-title alt-title-type="running-head">Resistance Dispersal in African Malaria</alt-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Pearce</surname><given-names>Richard J.</given-names></name><xref ref-type="aff" rid="aff1"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name><surname>Pota</surname><given-names>Hirva</given-names></name><xref ref-type="aff" rid="aff1"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name><surname>Evehe</surname><given-names>Marie-Solange B.</given-names></name><xref ref-type="aff" rid="aff2"><sup>2</sup></xref></contrib><contrib contrib-type="author"><name><surname>B&#x000e2;</surname><given-names>El-Hadj</given-names></name><xref ref-type="aff" rid="aff3"><sup>3</sup></xref></contrib><contrib contrib-type="author"><name><surname>Mombo-Ngoma</surname><given-names>Ghyslain</given-names></name><xref ref-type="aff" rid="aff4"><sup>4</sup></xref><xref ref-type="aff" rid="aff5"><sup>5</sup></xref></contrib><contrib contrib-type="author"><name><surname>Malisa</surname><given-names>Allen L.</given-names></name><xref ref-type="aff" rid="aff6"><sup>6</sup></xref><xref ref-type="aff" rid="aff7"><sup>7</sup></xref></contrib><contrib contrib-type="author"><name><surname>Ord</surname><given-names>Rosalynn</given-names></name><xref ref-type="aff" rid="aff1"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name><surname>Inojosa</surname><given-names>Walter</given-names></name><xref ref-type="aff" rid="aff8"><sup>8</sup></xref></contrib><contrib contrib-type="author"><name><surname>Matondo</surname><given-names>Alexandre</given-names></name><xref ref-type="aff" rid="aff9"><sup>9</sup></xref></contrib><contrib contrib-type="author"><name><surname>Diallo</surname><given-names>Diadier A.</given-names></name><xref ref-type="aff" rid="aff10"><sup>10</sup></xref></contrib><contrib contrib-type="author"><name><surname>Mbacham</surname><given-names>Wilfred</given-names></name><xref ref-type="aff" rid="aff2"><sup>2</sup></xref></contrib><contrib contrib-type="author"><name><surname>van den Broek</surname><given-names>Ingrid V.</given-names></name><xref ref-type="aff" rid="aff11"><sup>11</sup></xref></contrib><contrib contrib-type="author"><name><surname>Swarthout</surname><given-names>Todd D.</given-names></name><xref ref-type="aff" rid="aff11"><sup>11</sup></xref></contrib><contrib contrib-type="author"><name><surname>Getachew</surname><given-names>Asefaw</given-names></name><xref ref-type="aff" rid="aff12"><sup>12</sup></xref></contrib><contrib contrib-type="author"><name><surname>Dejene</surname><given-names>Seyoum</given-names></name><xref ref-type="aff" rid="aff13"><sup>13</sup></xref></contrib><contrib contrib-type="author"><name><surname>Grobusch</surname><given-names>Martin P.</given-names></name><xref ref-type="aff" rid="aff4"><sup>4</sup></xref><xref ref-type="aff" rid="aff14"><sup>14</sup></xref></contrib><contrib contrib-type="author"><name><surname>Njie</surname><given-names>Fanta</given-names></name><xref ref-type="aff" rid="aff15"><sup>15</sup></xref></contrib><contrib contrib-type="author" deceased="yes"><name><surname>Dunyo</surname><given-names>Samuel</given-names></name><xref ref-type="aff" rid="aff15"><sup>15</sup></xref></contrib><contrib contrib-type="author"><name><surname>Kweku</surname><given-names>Margaret</given-names></name><xref ref-type="aff" rid="aff1"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name><surname>Owusu-Agyei</surname><given-names>Seth</given-names></name><xref ref-type="aff" rid="aff1"><sup>1</sup></xref><xref ref-type="aff" rid="aff16"><sup>16</sup></xref></contrib><contrib contrib-type="author"><name><surname>Chandramohan</surname><given-names>Daniel</given-names></name><xref ref-type="aff" rid="aff1"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name><surname>Bonnet</surname><given-names>Maryline</given-names></name><xref ref-type="aff" rid="aff17"><sup>17</sup></xref></contrib><contrib contrib-type="author"><name><surname>Guthmann</surname><given-names>Jean-Paul</given-names></name><xref ref-type="aff" rid="aff17"><sup>17</sup></xref><xref ref-type="aff" rid="aff18"><sup>18</sup></xref></contrib><contrib contrib-type="author"><name><surname>Clarke</surname><given-names>Sian</given-names></name><xref ref-type="aff" rid="aff1"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name><surname>Barnes</surname><given-names>Karen I.</given-names></name><xref ref-type="aff" rid="aff19"><sup>19</sup></xref></contrib><contrib contrib-type="author"><name><surname>Streat</surname><given-names>Elizabeth</given-names></name><xref ref-type="aff" rid="aff20"><sup>20</sup></xref></contrib><contrib contrib-type="author"><name><surname>Katokele</surname><given-names>Stark T.</given-names></name><xref ref-type="aff" rid="aff21"><sup>21</sup></xref></contrib><contrib contrib-type="author"><name><surname>Uusiku</surname><given-names>Petrina</given-names></name><xref ref-type="aff" rid="aff21"><sup>21</sup></xref></contrib><contrib contrib-type="author"><name><surname>Agboghoroma</surname><given-names>Chris O.</given-names></name><xref ref-type="aff" rid="aff22"><sup>22</sup></xref></contrib><contrib contrib-type="author"><name><surname>Elegba</surname><given-names>Olufunmilayo Y.</given-names></name><xref ref-type="aff" rid="aff22"><sup>22</sup></xref></contrib><contrib contrib-type="author"><name><surname>Ciss&#x000e9;</surname><given-names>Badara</given-names></name><xref ref-type="aff" rid="aff23"><sup>23</sup></xref></contrib><contrib contrib-type="author"><name><surname>A-Elbasit</surname><given-names>Ishraga E.</given-names></name><xref ref-type="aff" rid="aff24"><sup>24</sup></xref></contrib><contrib contrib-type="author"><name><surname>Giha</surname><given-names>Hayder A.</given-names></name><xref ref-type="aff" rid="aff24"><sup>24</sup></xref><xref ref-type="aff" rid="aff25"><sup>25</sup></xref></contrib><contrib contrib-type="author"><name><surname>Kachur</surname><given-names>S. Patrick</given-names></name><xref ref-type="aff" rid="aff26"><sup>26</sup></xref></contrib><contrib contrib-type="author"><name><surname>Lynch</surname><given-names>Caroline</given-names></name><xref ref-type="aff" rid="aff1"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name><surname>Rwakimari</surname><given-names>John B.</given-names></name><xref ref-type="aff" rid="aff27"><sup>27</sup></xref></contrib><contrib contrib-type="author"><name><surname>Chanda</surname><given-names>Pascalina</given-nam