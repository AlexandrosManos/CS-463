surname><given-names>AI</given-names></name><name><surname>Ross</surname><given-names>S</given-names></name><name><surname>Lowenthal</surname><given-names>MS</given-names></name><name><surname>Fusaro</surname><given-names>V</given-names></name><name><surname>Fishman</surname><given-names>DA</given-names></name><name><surname>Petricoin</surname><given-names>EF</given-names><suffix>3rd</suffix></name></person-group><publisher-loc>Liotta</publisher-loc></citation></ref><ref id="b30-cin-01-53"><citation citation-type="journal"><collab>LA</collab><year>2003</year><article-title>Biomarker amplification by serum carrier protein binding</article-title><source>Dis Markers</source><volume>19</volume><fpage>1</fpage><lpage>10</lpage><pub-id pub-id-type="pmid">14757941</pub-id></citation></ref><ref id="b31-cin-01-53"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Merchant</surname><given-names>M</given-names></name><name><surname>Weinberger</surname><given-names>SR</given-names></name></person-group><year>2002</year><article-title>Recent advancements in surface-enhanced laser desorption/ionization-time of flight-mass spectrometry</article-title><source>Electrophoresis</source><volume>21</volume><issue>6</issue><fpage>1164</fpage><lpage>77</lpage><pub-id pub-id-type="pmid">10786889</pub-id></citation></ref><ref id="b32-cin-01-53"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Mukherjee</surname><given-names>S</given-names></name><name><surname>Golland</surname><given-names>P</given-names></name><name><surname>Panchenko</surname><given-names>D</given-names></name></person-group><year>2002</year><article-title>Permutation Tests for Classification</article-title><source>AI Memo AIM-2003&#x02013;019</source><publisher-name>Massachusetts Institute of Technology</publisher-name></citation></ref><ref id="b33-cin-01-53"><citation citation-type="journal"><person-group person-group-type="author"><name><surn