ven-names></name><name><surname>Kira</surname><given-names>S</given-names></name></person-group><article-title>Development of a New Instrument for Evaluating Individuals' Dietary Intakes</article-title><source>J Am Diet Assoc</source><year>2006</year><volume>106</volume><fpage>1588</fpage><lpage>1593</lpage><pub-id pub-id-type="pmid">17000191</pub-id><pub-id pub-id-type="doi">10.1016/j.jada.2006.07.004</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Farzanfar</surname><given-names>R</given-names></name><name><surname>Finkelstein</surname><given-names>J</given-names></name><name><surname>Friedman</surname><given-names>RH</given-names></name></person-group><article-title>Testing the usability of two automated home-based patient-management systems</article-title><source>J Med Syst</source><year>2004</year><volume>28</volume><fpage>143</fpage><lpage>153</lpage><pub-id pub-id-type="pmid">15195845</pub-id><pub-id pub-id-type="doi">10.1023/B:JOMS.0000023297.50379.3c</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eng</surname><given-names>TR</given-names></name><name><surname>Maxfield</surname><given-names>A</given-names></name><name><surname>Patrick</surname><given-names>K</given-names></name><name><surname>Deering</surname><given-names>MJ</given-names></name><name><surname>Ratzan</surname><given-names>SC</given-names></name><name><surname>Gustafson</surname><given-names>DH</given-names></name></person-group><article-title>Access to Health Information and Support A Public Highway or a Private Road?</article-title><source>JAMA</source><year>1998</year><volume>280</volume><fpage>1371</fpage><lpage>1375</lpage><pub-id pub-id-type="pmid">9794322</pub-id><pub-id pub-id-type="doi">10.1001/jama.280.15.1371</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oenema</surname><given-names>A</given-names></name><name><surname>Brug</surname><given-names>J</given-names></name></person-group><article-title>Feedback strategies to raise awareness of personal dietary intake: results of a randomized controlled trial</article-title><source>Prev Med</source><year>2003</year><volume>36</volume><fpage>429</fpage><lpage>439</lpage><pub-id pub-id-type="pmid">12649051</pub-id><pub-id pub-id-type="doi">10.1016/S0091-7435(02)00043-9</pub-id></citation></ref><ref id="B13"><citation citation-type="other"><person-group person-group-type="author"><collab>National Statistics Online</collab></person-group><source>First Release: Internet Access 2007 Households and Individuals</source><year>2007</year><fpage>1</fpage></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><collab>DoH (UK Department of Health)</collab></person-group><source>Dietary Reference Values for Food Energy and Nutrients for the United Kingdom: Report of the Panel on Dietary Reference Values of the Committee on Medical Aspects of Food Policy</source><year>1991</year><edition>1</edition><publisher-name>Norwich: The Stationery Office for Her Majesty's Stationery Office</publisher-name></citation></ref><ref id="B15"><citation citation-type="other"><person-group person-group-type="author"><collab>The Scottish Office Department of Health</collab></person-group><source>Eating for Health: A Diet Action Plan for Scotland</source><year>1996</year></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Welch</surname><given-names>AA</given-names></name><name><surname>McTaggart</surname><given-names>A</given-names></name><name><surname>Mulligan</surname><given-names>AA</given-names></name><name><surname>Luben</surname><given-names>R</given-names></name><name><surname>Walker</surname><given-names>N</given-names></name><name><surname>Khaw</surname><given-names>KT</given-names></name><name><surname>Day</surname><given-names>NE</given-names></name><name><surname>Bingham</surname><given-names>SA</given-names></name></person-group><article-title>DINER (Data Into Nutrients for Epidemiological Research) &#x02013; a new data-entry program for nutritional analysis in the EPIC-Norfolk cohort and the 7-day non-weighed record method</article-title><source>Public Health Nutr</source><year>2001</year><volume>4</volume><fpage>1253</fpage><lpage>1265</lpage><pub-id pub-id-type="pmid">11796089</pub-id><pub-id pub-id-type="doi">10.1079/PHN2001196</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bingham</surname><given-names>SA</given-names></name><name><surname>Gill</surname><given-names>C</given-names></name><name><surname>Welch</surname><given-names>A</given-names></name><name><surname>Day</surname><given-names>K</given-names></name><name><surname>Cassidy</surname><given-names>A</given-names></name><name><surname>Khaw</surname><given-names>KT</given-names></name><name><surname>Sneyd</surname><given-names>MJ</given-names></name><name><surname>Key</surname><given-names>TJA</given-names></name><name><surname>Roe</surname><given-names>L</given-names></name><name><surname>Day</surname><given-names>NE</given-names></name></person-group><article-title>Comparison of dietary assessment methods in nutritional epidemiology: Weighed records v. 24 h recalls, food-frequency questionnaires and estimated-diet records</article-title><source>British Journal of Nutrition</source><year>1994</year><volume>72</volume><fpage>619</fpage><lpage>643</lpage><pub-id pub-id-type="pmid">7986792</pub-id><pub-id pub-id-type="doi">10.1079/BJN19940064</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Masson</surname><given-names>LF</given-names></name><name><surname>McNeill</surname><given-names>G</given-names></nam