title><source>Hum Resour Health</source><year>2006</year><volume>4</volume><fpage>2</fpage><pub-id pub-id-type="pmid">16469107</pub-id><pub-id pub-id-type="doi">10.1186/1478-4491-4-2</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pope</surname><given-names>C</given-names></name><name><surname>Ziebland</surname><given-names>S</given-names></name><name><surname>Mays</surname><given-names>N</given-names></name></person-group><article-title>Qualitative research in health care: analysing qualitative data</article-title><source>BMJ</source><year>2000</year><volume>320</volume><fpage>114</fpage><lpage>116</lpage><pub-id pub-id-type="pmid">10625273</pub-id><pub-id pub-id-type="doi">10.1136/bmj.320.7227.114</pub-id></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Ritchie</surname><given-names>J</given-names></name><name><surname>Spencer</surname><given-names>L</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Bryman A, Burgess R</surname></name></person-group><article-title>Qualitative data analysis for applied policy research</article-title><source>Analysing Qualitative Data</source><year>1993</year><publisher-name>London: Routledge</publisher-name><fpage>173</fpage><lpage>194</lpage></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Buchan</surname><given-names>J</given-names></name><name><surname>McCaffery</surname><given-names>J</given-names></name></person-group><article-title>Health workforce innovations: a synthesis of four promising practices</article-title><source>Health Workforce Promising Practices</source><year>2007</year><publisher-name>The Capacity Project. Washington, DC: United States Agency for International Development Global Health/HIV/AIDS</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.capacityproject.org/images/stories/files/synthesis.pdf"/></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Caffrey</surname><given-names>M</given-names></name><name><surname>Frelick</surname><given-names>G</given-names></name></person-group><article-title>Attracting and retaining nurse tutors in Malawi</article-title><source>Health Workforce "Innovative Approaches and Promising Practices" Study</source><year>2006</year><publisher-name>The Capacity Project. Washington, DC: United States Agency for International Development Global Health/HIV/AIDS and the Africa Bureau Office of Sustainable Development</publisher-name><ext-link ext-link-type="uri" xlink:href="http://www.capacityproject.org/images/stories/files/promising_practices_malawi.pdf"/></citation></ref><ref id="B23"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lehmann</surname><given-names>U</given-names></name></person-group><source>Mid-level health workers. The state of the evidence on programmes, activities, costs and impact on health outcomes. A literature review</source><year>2008</year><publisher-name>Geneva: WHO Department of Human Resources for Health</publisher-name></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Huddart</surname><given-names>J</given-names></name><name><surname>Picazo</surname><given-names>OF</given-names></name></person-group><source>The Health Sector Human Resource Crisis in Africa: An Issues Paper</source><year>2003</year><publisher-name>Washington, DC: United States Agency for International Development, Bureau for Africa, Office of Sustainable Development</publisher-name></citation></ref></ref-list></back></article>