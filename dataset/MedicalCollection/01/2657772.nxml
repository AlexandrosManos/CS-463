r"><name><surname>Vujicic</surname><given-names>M</given-names></name><name><surname>Zurn</surname><given-names>P</given-names></name><name><surname>Diallo</surname><given-names>K</given-names></name><name><surname>Adams</surname><given-names>O</given-names></name><name><surname>Dal Poz</surname><given-names>MR</given-names></name></person-group><article-title>The role of wages in the migration of health care professionals from developing countries</article-title><source>Hum Resour Health</source><year>2004</year><volume>2</volume><fpage>3</fpage><pub-id pub-id-type="pmid">15115549</pub-id><pub-id pub-id-type="doi">10.1186/1478-4491-2-3</pub-id></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Awases</surname><given-names>M</given-names></name><name><surname>Gbary</surname><given-names>A</given-names></name><name><surname>Nyoni</surname><given-names>J</given-names></name><name><surname>Chatora</surname><given-names>R</given-names></name></person-group><source>Migration of Health Professionals in Six Countries: a Synthesis Report</source><year>2004</year><publisher-name>Brazzaville: World Health Organization</publisher-name></citation></ref><ref id="B14"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Green</surname><given-names>J</given-names></name><name><surname>Thorogood</surname><given-names>N</given-names></name></person-group><source>Qualitative Methods for Health Research</source><year>2004</year><publisher-name>London: Sage</publisher-name></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Martineau</surname><given-names>T</given-names></name><name><surname>Lehmann</surname><given-names>U</given-names></name><name><surname>Matwa</surname><given-names>P</given-names></name><name><surname>Kathyola</surname><given-names>J</given-names></name><name><surname>Storey</surname><given-names>K</gi