itation citation-type="journal"><person-group person-group-type="author"><name><surname>Walworth</surname><given-names>NC</given-names></name></person-group><article-title>DNA damage: Chk1 and Cdc25, more than meets the eye</article-title><source>Curr Opin Genet Dev</source><year>2001</year><volume>11</volume><fpage>78</fpage><lpage>82</lpage><pub-id pub-id-type="pmid">11163155</pub-id><pub-id pub-id-type="doi">10.1016/S0959-437X(00)00160-X</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fletcher</surname><given-names>L</given-names></name><name><surname>Cerniglia</surname><given-names>GJ</given-names></name><name><surname>Nigg</surname><given-names>EA</given-names></name><name><surname>Yend</surname><given-names>TJ</given-names></name><name><surname>Muschel</surname><given-names>RJ</given-names></name></person-group><article-title>Inhibition of centrosome separation after DNA damage: a role for Nek2</article-title><source>Radiat Res</source><year>2004</year><volume>162</volume><fpage>128</fpage><lpage>135</lpage><pub-id pub-id-type="pmid">15387139</pub-id><pub-id pub-id-type="doi">10.1667/RR3211</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zhang</surname><given-names>W</given-names></name><name><surname>Fletcher</surname><given-names>L</given-names></name><name><surname>Muschel</surname><given-names>RJ</given-names></name></person-group><article-title>The role of Polo-like kinase 1 in the inhibition of centrosome separation after ionizing radiation</article-title><source>J Biol Chem</source><year>2005</year><volume>280</volume><fpage>42994</fpage><lpage>42999</lpage><pub-id pub-id-type="pmid">16157594</pub-id><pub-id pub-id-type="doi">10.1074/jbc.M505450200</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fry</surname><given