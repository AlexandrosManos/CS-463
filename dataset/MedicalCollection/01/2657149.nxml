es></name><collab>Eds</collab></person-group><source>What Works? Evidence-based Policy and Practice in Public Services</source><year>2000</year><publisher-name>Bristol: The Policy Press</publisher-name></citation></ref><ref id="B31"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Peters</surname><given-names>BG</given-names></name></person-group><source>Managing Horizontal Government: The Politics of Coordination Research Paper No 21</source><year>1998</year><publisher-name>Canadian Centre for Management Development</publisher-name></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lindquist</surname><given-names>E</given-names></name></person-group><article-title>Strategy, capacity and horizontal governance: Perspectives from Australia and Canada</article-title><source>Optimum Online</source><year>2004</year><volume>34</volume></citation></ref><ref id="B33"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hess</surname><given-names>M</given-names></name><name><surname>Adams</surname><given-names>D</given-names></name></person-group><article-title>Knowing and skilling in contemporary public administration</article-title><source>Aust J Public Adm</source><year>2002</year><volume>61</volume><fpage>68</fpage><lpage>79</lpage><pub-id pub-id-type="doi">10.1111/1467-8500.00303</pub-id></citation></ref><ref id="B34"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Painter</surname><given-names>M</given-names></name><name><surname>Pierre</surname><given-names>J</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Painter M, Pierre J</surname></name></person-group><article-title>Conclusions: Challenges to policy capacity</article-title><source>Challenges to State Policy Capacity: Global Trends and Comparative Perspectives</source><year>2005</year><publi