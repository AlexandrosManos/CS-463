/volume>:<fpage>332</fpage>&#x02013;<lpage>45</lpage> <pub-id pub-id-type="doi">10.1006/viro.2000.0630</pub-id><pub-id pub-id-type="pmid">11118357</pub-id></citation></ref><ref id="R24"><label>24. </label><citation citation-type="journal"><string-name><surname>Schilling</surname> <given-names>S</given-names></string-name>, <string-name><surname>Emmerich</surname> <given-names>P</given-names></string-name>, <string-name><surname>Klempa</surname> <given-names>B</given-names></string-name>, <string-name><surname>Auste</surname> <given-names>B</given-names></string-name>, <string-name><surname>Schnaith</surname> <given-names>E</given-names></string-name>, <string-name><surname>Schmitz</surname> <given-names>H</given-names></string-name>, <etal/><article-title>Hantavirus disease outbreak in Germany: limitations of routine serological diagnostics and clustering of virus sequences of human and rodent origin.</article-title><source>J Clin Microbiol</source> <year>2007</year>;<volume>45</volume>:<fpage>3008</fpage>&#x02013;<lpage>14</lpage> <pub-id pub-id-type="doi">10.1128/JCM.02573-06</pub-id><pub-id pub-id-type="pmid">17626170</pub-id></citation></ref></ref-list></back></article>