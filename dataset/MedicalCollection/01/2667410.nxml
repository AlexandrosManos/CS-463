e><pub-id pub-id-type="pmid">17181593</pub-id><pub-id pub-id-type="doi">10.1111/j.1423-0410.2006.00858.x</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mitra</surname><given-names>B</given-names></name><name><surname>Mori</surname><given-names>A</given-names></name><name><surname>Cameron</surname><given-names>PA</given-names></name><name><surname>Fitzgerald</surname><given-names>M</given-names></name><name><surname>Street</surname><given-names>A</given-names></name><name><surname>Bailey</surname><given-names>M</given-names></name></person-group><article-title>Massive blood transfusion and trauma resuscitation</article-title><source>Injury</source><year>2007</year><volume>38</volume><fpage>1023</fpage><lpage>1029</lpage><pub-id pub-id-type="pmid">17572415</pub-id><pub-id pub-id-type="doi">10.1016/j.injury.2007.03.021</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vaslef</surname><given-names>SN</given-names></name><name><surname>Knudsen</surname><given-names>NW</given-names></name><name><surname>Neligan</surname><given-names>PJ</given-names></name><name><surname>Sebastian</surname><given-names>MW</given-names></name></person-group><article-title>Massive transfusion exceeding 50 units of blood products in trauma patients</article-title><source>J Trauma</source><year>2002</year><volume>53</volume><fpage>291</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">12169936</pub-id><pub-id pub-id-type="doi">10.1097/00005373-200208000-00017</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grottke</surname><given-names>O</given-names></name><name><surname>Henzler</surname><given-names>D</given-names></name><name><surname>Rossaint</surname><given-names>R</given-names></name></person-group><article-title>Use of blood and blood products in tra