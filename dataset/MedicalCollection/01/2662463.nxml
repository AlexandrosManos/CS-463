age>175</fpage><lpage>180</lpage><pub-id pub-id-type="pmid">17516937</pub-id></citation></ref><ref id="b14-ijms-10-00001"><label>14.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Awad</surname><given-names>WA</given-names></name><name><surname>Razzazi-Fazeli</surname><given-names>E</given-names></name><name><surname>Bohm</surname><given-names>J</given-names></name><name><surname>Zentek</surname><given-names>J</given-names></name></person-group><article-title>Effects of B-trichothecenes on luminal glucose transport across the isolated jejunal epithelium of broiler chickens</article-title><source>J. Anim. Physiol. Anim. Nutr. (Berl.)</source><year>2008</year><volume>92</volume><fpage>225</fpage><lpage>230</lpage><pub-id pub-id-type="pmid">18477301</pub-id></citation></ref><ref id="b15-ijms-10-00001"><label>15.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Van De Walle</surname><given-names>J</given-names></name><name><surname>Romier</surname><given-names>B</given-names></name><name><surname>Larondelle</surname><given-names>Y</given-names></name><name><surname>Schneider</surname><given-names>YJ</given-names></name></person-group><article-title>Influence of deoxynivalenol on NF-kappaB activation and IL-8 secretion in human intestinal Caco-2 cells</article-title><source>Toxicol. Lett</source><year>2008</year><volume>177</volume><fpage>205</fpage><lpage>214</lpage><pub-id pub-id-type="pmid">18343055</pub-id></citation></ref><ref id="b16-ijms-10-00001"><label>16.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pinton</surname><given-names>P</given-names></name><name><surname>Accensi</surname><given-names>F</given-names></name><name><surname>Beauchamp</surname><given-names>E</given-names></name><name><surname>Cossalter</surname><given-names>AM</given-names></name><name><surname>Callu</surname><given-names>P</given-names></nam