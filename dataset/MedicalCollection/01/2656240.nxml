me><name><surname>Tesfasyone</surname><given-names>H</given-names></name><name><surname>Gregersen</surname><given-names>PK</given-names></name><name><surname>Behrens</surname><given-names>TW</given-names></name><name><surname>Baechler</surname><given-names>EC</given-names></name></person-group><article-title>IFN-regulated chemokines are reliable biomarkers of systemic lupus erythematosus</article-title><source>Arthritis Rheum</source><year>2007</year><volume>56</volume><fpage>S782</fpage></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hua</surname><given-names>J</given-names></name><name><surname>Kirou</surname><given-names>KA</given-names></name><name><surname>Crow</surname><given-names>MK</given-names></name></person-group><article-title>Distinct clinical manifestations in SLE are associated with interferon vs. inflammatory gene expression induced by distinct immune stimuli</article-title><source>Arthritis Rheum</source><year>2008</year><volume>58</volume><fpage>S342</fpage></citation></ref></ref-list></back></article>