mixed-citation publication-type="other">Kecskes, Z.B., Davis, M.W., 2002. Rapid correction of early metabolic acidaemia in comparison with placebo, no intervention or slow correction in LBW infants. Cochrane Database Syst. Rev. (1):CD002976.</mixed-citation></ref><ref id="bib11"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Keenan</surname><given-names>W.J.</given-names></name></person-group><article-title>Recommendations for management of the child born through meconium-stained amniotic fluid</article-title><source>Pediatrics</source><volume>113</volume><year>2004</year><fpage>133</fpage><lpage>134</lpage><pub-id pub-id-type="pmid">14702463</pub-id></element-citation></ref><ref id="bib12"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lawn</surname><given-names>J.E.</given-names></name><name><surname>Cousens</surname><given-names>S.</given-names></name><name><surname>Zupan</surname><given-names>J.</given-names></name><collab>Lancet Neonatal Survival Steering Team</collab></person-group><article-title>4 million neonatal deaths: when? where? why?</article-title><source>Lancet</source><volume>365</volume><year>2005</year><fpage>891</fpage><lpage>900</lpage><pub-id pub-id-type="pmid">15752534</pub-id></element-citation></ref><ref id="bib13"><mixed-citation publication-type="other">Lawn, C.J., Weir, F.J., McGuire, W., 2005b. Base administration or fluid bolus for preventing morbidity and mortality in preterm infants with metabolic acidosis. Cochrane Database Syst. Rev. (2):CD003215.</mixed-citation></ref><ref id="bib14"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Linder</surname><given-names>N.</given-names></name><name><surname>Aranda</surname><given-names>J.V.</given-names></name><name><surname>Tsur</surname><given-names>M.</given-names></name><name><surname>Matoth</surname><given-names>I.</given-names></