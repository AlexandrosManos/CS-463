given-names></name><name><surname>Einarsdottir</surname><given-names>H</given-names></name><name><surname>Gunnarsdottir</surname><given-names>S</given-names></name><name><surname>Gylfason</surname><given-names>A</given-names></name><name><surname>Vaccarino</surname><given-names>V</given-names></name><name><surname>Hooper</surname><given-names>WC</given-names></name><name><surname>Reilly</surname><given-names>MP</given-names></name><name><surname>Granger</surname><given-names>CB</given-names></name><name><surname>Austin</surname><given-names>H</given-names></name><name><surname>Rader</surname><given-names>DJ</given-names></name><name><surname>Shah</surname><given-names>SH</given-names></name><name><surname>Quyyumi</surname><given-names>AA</given-names></name><article-title>A common variant on chromosome 9p21affects the risk of myocardial infarction.</article-title><source>Science</source><year>2007</year><volume>316</volume><fpage>1491</fpage><lpage>1493</lpage><pub-id pub-id-type="doi">10.1126/science.1142842</pub-id><pub-id pub-id-type="pmid">17478679</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><name><surname>McGuire</surname><given-names>AL</given-names></name><name><surname>Cho</surname><given-names>MK</given-names></name><name><surname>McGuire</surname><given-names>SE</given-names></name><name><surname>Caulfield</surname><given-names>T</given-names></name><article-title>The future of personal genomics.</article-title><source>Science</source><year>2007</year><volume>317</volume><fpage>1687</fpage><pub-id pub-id-type="pmid">17885116</pub-id><pub-id pub-id-type="doi">10.1126/science.1147475</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>McPherson</surname><given-names>R</given-names></name><name><surname>Pertsemlidis</surname><given-names>A</given-names></name><name><surname>Kavaslar</surname><given-names>N</given-names></name><name><surname>Stewart</surname><given-n