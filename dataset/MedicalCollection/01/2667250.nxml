pone.0005222-Woodbury1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Woodbury</surname><given-names>D</given-names></name><name><surname>Schwarz</surname><given-names>EJ</given-names></name><name><surname>Prockop</surname><given-names>DJ</given-names></name><name><surname>Black</surname><given-names>IB</given-names></name></person-group><year>2000</year><article-title>Adult rat and human bone marrow stromal cells differentiate into neurons.</article-title><source>J Neurosci Res</source><volume>61</volume><fpage>364</fpage><lpage>370</lpage><pub-id pub-id-type="pmid">10931522</pub-id></citation></ref><ref id="pone.0005222-Deng1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Deng</surname><given-names>W</given-names></name><name><surname>Obrocka</surname><given-names>M</given-names></name><name><surname>Fischer</surname><given-names>I</given-names></name><name><surname>Prockop</surname><given-names>DJ</given-names></name></person-group><year>2001</year><article-title>In vitro differentiation of human marrow stromal cells into early progenitors of neural cells by conditions that increase intracellular cyclic AMP.</article-title><source>Biochem Biophys Res Commun</source><volume>282</volume><fpage>148</fpage><lpage>152</lpage><pub-id pub-id-type="pmid">11263984</pub-id></citation></ref><ref id="pone.0005222-Jin1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jin</surname><given-names>K</given-names></name><name><surname>Mao</surname><given-names>XO</given-names></name><name><surname>Batteur</surname><given-names>S</given-names></name><name><surname>Sun</surname><given-names>Y</given-names></name><name><surname>Greenberg</surname><given-names>DA</given-names></name></person-group><year>2003</year><article-title>Induction of neuronal markers in bone marrow cells: differential effects of growth factors and patterns of intracellular expression.</article-title><source>Exp Neurol</source><volume>184</volume><fpage>78</fpage><lpage>89</lpage><pub-id pub-id-type="pmid">14637082</pub-id></citation></ref><ref id="pone.0005222-Kabos1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kabos</surname><given-names>P</given-names></name><name><surname>Ehtesham</surname><given-names>M</given-names></name><name><surname>Kabosova</surname><given-names>A</given-names></name><name><surname>Black</surname><given-names>KL</given-names></name><name><surname>Yu</surname><given-names>JS</given-names></name></person-group><year>2002</year><article-title>Generation of neural progenitor cells from whole adult bone marrow.</article-title><source>Exp Neurol</source><volume>178</volume><fpage>288</fpage><lpage>293</lpage><pub-id pub-id-type="pmid">12504887</pub-id></citation></ref><ref id="pone.0005222-Kohyama1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kohyama</surname><given-names>J</given-names></name><name><surname>Abe</surname><given-names>H</given-names></name><name><surname>Shimazaki</surname><given-names>T</given-names></name><name><surname>Koizumi</surname><given-names>A</given-names></name><name><surname>Nakashima</surname><given-names>K</given-names></name><etal/></person-group><year>2001</year><article-title>Brain from bone: efficient &#x0201c;meta-differentiation&#x0201d; of marrow stroma-derived mature osteoblasts to neurons with Noggin or a demethylating agent.</article-title><source>Differentiation</source><volume>68</volume><fpage>235</fpage><lpage>244</lpage><pub-id pub-id-type="pmid">11776476</pub-id></citation></ref><ref id="pone.0005222-Alexanian1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Alexanian</surname><given-names>AR</given-names></name><name><surname>Maiman</surname><given-names>DJ</given-names></name><name><surname>Kurpad</surname><given-names>SN</given-names></name><name><surname>Gennarelli</surname><given-names>TA</given-names></name></person-group><year>2008</year><article-title>In vitro and in vivo Characterization of Neurally Modified Mesenchymal Stem Cells Induced by Epigenetic Modifiers and Neural Stem Cell Environment.</article-title><source>Stem Cells Dev</source></citation></ref><ref id="pone.0005222-Corti1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Corti</surname><given-names>S</given-names></name><name><surname>Locatelli</surname><given-names>F</given-names></name><name><surname>Strazzer</surname><given-names>S</given-names></name><name><surname>Salani</surname><given-names>S</given-names></name><name><surname>Del Bo</surname><given-names>R</given-names></name><etal/></person-group><year>2002</year><article-title>Modulated generation of neuronal cells from bone marrow by expansion and mobilization of circulating stem cells with in vivo cytokine treatment.</article-title><source>Exp Neurol</source><volume>177</volume><fpage>443</fpage><lpage>452</lpage><pub-id pub-id-type="pmid">12429190</pub-id></citation></ref><ref id="pone.0005222-MunozElias1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Munoz-Elias</surname><given-names>G</given-names></name><name><surname>Marcus</surname><given-names>AJ</given-names></name><name><surname>Coyne</surname><given-names>TM</given-names></name><name><surname>Woodbury</surname><given-names>D</given-names></name><name><surname>Black</surname><given-names>IB</given-names></name></person-group><year>2004</year><article-title>Adult bone marrow stromal cells in the embryonic brain: engraftment, migration, differentiation, and long-term survival.</article-title><source>J Neurosci</source><volume>24</volume><fpage>4585</fpage><lpage>4595</lpage><pub-id pub-id-type="pmid