person-group><article-title>A case of spondylitis tuberculosa in the Danish Neolithic Age</article-title><source><italic>Danish Medical Bulletin</italic></source><year>1972</year><volume>19</volume><issue>5</issue><fpage>176</fpage><lpage>180</lpage><pub-id pub-id-type="pmid">4558854</pub-id></citation></ref><ref id="B3"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bartels</surname><given-names>P</given-names></name></person-group><article-title>Tuberkulose (Wirbelkaries) in der jungen Steinzeit</article-title><source><italic>Archiv f&#x000fc;r Anthropologie</italic></source><year>1907</year><volume>6</volume><fpage>243</fpage><lpage>255</lpage></citation></ref><ref id="B13"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hershkovitz</surname><given-names>I</given-names></name><name><surname>Donoghue</surname><given-names>HD</given-names></name><name><surname>Minnikin</surname><given-names>DE</given-names></name><etal/></person-group><article-title>Detection and molecular characterization of 9000-year-old <italic>Mycobacterium tuberculosis</italic> from a Neolithic settlement in the Eastern Mediterranean</article-title><source><italic>PLoS ONE</italic></source><year>2008</year><volume>3</volume><issue>10, article e3426</issue><fpage>1</fpage><lpage>6</lpage></citation></ref><ref id="B29"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Salo</surname><given-names>WL</given-names></name><name><surname>Aufderheide</surname><given-names>AC</given-names></name><name><surname>Buikstra</surname><given-names>J</given-names></name><name><surname>Holcomb</surname><given-names>TA</given-names></name></person-group><article-title>Identification of <italic>Mycobacterium tuberculosis</italic> DNA in a pre-Columbian Peruvian mummy</article-title><source><italic>Proceedings of the National Academy of Sciences of the United States of America</italic></source><year>1994</year><volume>91</volume><issue>6</issue><fpage>2091</fpage><lpage>2094</lpage><pub-id pub-id-type="pmid">8134354</pub-id></citation></ref><ref id="B1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arriaza</surname><given-names>BT</given-names></name><name><surname>Salo</surname><given-names>W</given-names></name><name><surname>Aufderheide</surname><given-names>AC</given-names></name><name><surname>Holcomb</surname><given-names>TA</given-names></name></person-group><article-title>Pre-Columbian tuberculosis in Northern Chile: molecular and skeletal evidence</article-title><source><italic>American Journal of Physical Anthropology</italic></source><year>1995</year><volume>98</volume><issue>1</issue><fpage>37</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">8579189</pub-id></citation></ref><ref id="B2"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arriaza</surname><given-names>B</given-names></name><name><surname>Cartmell</surname><given-names>LL</given-names></name><name><surname>Moragas</surname><given-names>C</given-names></name><name><surname>Nerlich</surname><given-names>AG</given-names></name><name><surname>Aufderheide</surname><given-names>AC</given-names></name></person-group><article-title>The bioarchaeological value of human mummies without provenience</article-title><source><italic>Chungara</italic></source><year>2008</year><volume>40</volume><fpage>55</fpage><lpage>65</lpage></citation></ref><ref id="B15"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Konomi</surname><given-names>N</given-names></name><name><surname>Lebwohl</surname><given-names>E</given-names></name><name><surname>Mowbray</surname><given-names>K</given-names></name><name><surname>Tattersall</surname><given-names>I</given-names></name><name><surname>