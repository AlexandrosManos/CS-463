<tr><td rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;<italic>LjOa24</italic></td><td rowspan="1" colspan="1">UVI1 (<italic>Pisum sativum</italic>; Q9AUH7)</td><td rowspan="1" colspan="1">4.5E-08</td><td rowspan="1" colspan="1">BB999920</td></tr><tr><td rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;<italic>LjOa163</italic></td><td rowspan="1" colspan="1">UVI1 (<italic>Pisum sativum</italic>; Q9AUH7)</td><td rowspan="1" colspan="1">1.2E-07</td><td rowspan="1" colspan="1">BB999914</td></tr><tr><td rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;<italic>LjOa51-1</italic></td><td rowspan="1" colspan="1">Unknown protein (<italic>Populus trichocarpa</italic>; ABK94704)</td><td rowspan="1" colspan="1">0.001</td><td rowspan="1" colspan="1">BB999923</td></tr><tr><td rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;<italic>LjOa146</italic></td><td rowspan="1" colspan="1">Unnamed protein (<italic>Vitis vinifera</italic>; CAO44822)</td><td rowspan="1" colspan="1">0.004</td><td rowspan="1" colspan="1">BB999925</td></tr><tr><td rowspan="1" colspan="1">No homology</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;<italic>LjOa162-2</italic></td><td rowspan="1" colspan="1">None</td><td rowspan="1" colspan="1">&#x02013;</td><td rowspan="1" colspan="1">BB999895</td></tr></tbody></table></table-wrap><table-wrap id="tbl2" position="float"><label>Table 2.</label><caption><p>Genes showing up-regulated expression in the roots of <italic>Lotus japonicus</italic> after 6 d of <italic>Striga hermonthica</italic> inoculation</p></caption><table frame="hsides" rules="groups"><thead><tr><td rowspan="1" colspan="1">Clone</td><td rowspan="1" colspan="1">Homology (species; accession number)</td><td rowspan="1" colspan="1"><italic>E</italic>-value</td><td rowspan="1" colspan="1">Accession no.</td></tr></thead><tbody><tr><td rowspan="1" c