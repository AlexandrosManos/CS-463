lume><fpage>1221</fpage><lpage>1235</lpage><pub-id pub-id-type="pmid">12225913</pub-id><pub-id pub-id-type="doi">10.1016/S0965-1748(02)00085-1</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Handler</surname><given-names>AM</given-names></name><name><surname>Harrell</surname><given-names>RA</given-names><suffix>2nd</suffix></name></person-group><article-title>Germline transformation of Drosophila melanogaster with the piggyBac transposon vector</article-title><source>Insect Mol Biol</source><year>1999</year><volume>8</volume><fpage>449</fpage><lpage>457</lpage><pub-id pub-id-type="pmid">10634970</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2583.1999.00139.x</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lobo</surname><given-names>NF</given-names></name><name><surname>Clayton</surname><given-names>JR</given-names></name><name><surname>Fraser</surname><given-names>MJ</given-names></name><name><surname>Kafatos</surname><given-names>FC</given-names></name><name><surname>Collins</surname><given-names>FH</given-names></name></person-group><article-title>High efficiency germ-line transformation of mosquitoes</article-title><source>Nat Protoc</source><year>2006</year><volume>1</volume><fpage>1312</fpage><lpage>1317</lpage><pub-id pub-id-type="pmid">17406416</pub-id><pub-id pub-id-type="doi">10.1038/nprot.2006.221</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Handler</surname><given-names>AM</given-names></name></person-group><article-title>Use of the piggyBac transposon for germ-line transformation of insects</article-title><source>Insect Biochem Mol Biol</source><year>2002</year><volume>32</volume><fpage>1211</fpage><lpage>1220</lpage><pub-id pub-id-type="pmid">12225912</pub-id><pub-id pub-id-type="doi">10.1016/S0965-1748(02)00084-X</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sarkar</surname><given-names>A</given-names></name><name><surname>Atapattu</surname><given-names>A</given-names></name><name><surname>Belikoff</surname><given-names>EJ</given-names></name><name><surname>Heinrich</surname><given-names>JC</given-names></name><name><surname>Li</surname><given-names>X</given-names></name><name><surname>Horn</surname><given-names>C</given-names></name><name><surname>Wimmer</surname><given-names>EA</given-names></name><name><surname>Scott</surname><given-names>MJ</given-names></name></person-group><article-title>Insulated piggyBac vectors for insect transgenesis</article-title><source>BMC Biotechnol</source><year>2006</year><volume>6</volume><fpage>27</fpage><pub-id pub-id-type="pmid">16776846</pub-id><pub-id pub-id-type="doi">10.1186/1472-6750-6-27</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nimmo</surname><given-names>DD</given-names></name><name><surname>Alphey</surname><given-names>L</given-names></name><name><surname>Meredith</surname><given-names>JM</given-names></name><name><surname>Eggleston</surname><given-names>P</given-names></name></person-group><article-title>High efficiency site-specific genetic engineering of the mosquito genome</article-title><source>Insect Mol Biol</source><year>2006</year><volume>15</volume><fpage>129</fpage><lpage>136</lpage><pub-id pub-id-type="pmid">16640723</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2583.2006.00615.x</pub-id></citation></ref></ref-list></back></article>