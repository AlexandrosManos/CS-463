f id="B16"><mixed-citation publication-type="journal"><name><surname>Snead</surname><given-names>OC</given-names><suffix>III</suffix></name><name><surname>Bearden</surname><given-names>LJ</given-names></name><article-title>Naloxone overcomes the dopaminergic, EEG, and behavioral effects of gamma-hydroxybutyrate</article-title><source>Neurology</source><year>1980</year><volume>30</volume><fpage>832</fpage><lpage>838</lpage><pub-id pub-id-type="doi">10.1212/WNL.30.8.832</pub-id><pub-id pub-id-type="pmid">7191065</pub-id></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="journal"><name><surname>Dyer</surname><given-names>JE</given-names></name><article-title>Gamma-hydroxybutyrate: A health-food product producing coma and seizure-like activity</article-title><source>Am J Emerg Med</source><year>1991</year><volume>9</volume><fpage>321</fpage><lpage>324</lpage><pub-id pub-id-type="doi">10.1016/0735-6757(91)90050-T</pub-id><pub-id pub-id-type="pmid">2054002</pub-id></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="journal"><name><surname>Smith</surname><given-names>KM</given-names></name><article-title>Drugs used in acquaintance rape</article-title><source>J Am Pharm Assoc</source><year>1999</year><volume>39</volume><fpage>519</fpage><lpage>525</lpage></mixed-citation></ref><ref id="B19"><mixed-citation publication-type="journal"><collab>Xyrem International Study Group</collab><article-title>A double-blind, placebo-controlled study demonstrates sodium oxybate is effective for the treatment of excessive daytime sleepiness in narcolepsy</article-title><source>J Clin Sleep Med</source><year>2005</year><volume>15</volume><fpage>391</fpage><lpage>397</lpage></mixed-citation></ref><ref id="B20"><mixed-citation publication-type="journal"><name><surname>Nava</surname><given-names>F</given-names></name><name><surname>Premi</surname><given-names>S</given-names></name><name><surname>Manzato</surname><given-names>E</given-names></name><name><surname>Campagnola</surname><given-names>W</given-names></name><name><surname>Lucchini</surname><given-names>A</given-names></name><name><surname>Gessa</surname><given-names>GL</given-names></name><article-title>Gamma-hydroxybutyrate reduces both withdrawal syndrome and hypercortisolism in severe abstinent alcoholics: An open study vs. diazepam</article-title><source>Am J Drug Alcohol Abuse</source><year>2007</year><volume>33</volume><fpage>379</fpage><lpage>392</lpage><pub-id pub-id-type="doi">10.1080/00952990701315046</pub-id><pub-id pub-id-type="pmid">17613965</pub-id></mixed-citation></ref><ref id="B21"><mixed-citation publication-type="journal"><name><surname>Scharf</surname><given-names>MB</given-names></name><name><surname>Baumann</surname><given-names>M</given-names></name><name><surname>Berkowitz</surname><given-names>DV</given-names></name><article-title>The effects of sodium oxybate on clinical symptoms and sleep patterns in patients with fibromyalgia</article-title><source>J Rheumatol</source><year>2003</year><volume>30</volume><fpage>1070</fpage><lpage>1074</lpage><pub-id pub-id-type="pmid">12734908</pub-id></mixed-citation></ref><ref id="B22"><mixed-citation publication-type="journal"><name><surname>Schwartz</surname><given-names>TL</given-names></name><article-title>Gamma hydroxy butyric acid and sodium oxybate used to treat posttraumatic stress disorder</article-title><source>CNS Spectrums</source><year>2007</year><volume>12</volume><fpage>884</fpage><lpage>886</lpage><pub-id pub-id-type="pmid">18229429</pub-id></mixed-citation></ref><ref id="B23"><mixed-citation publication-type="journal"><name><surname>Frucht</surname><given-names>SJ</given-names></name><name><surname>Houghton</surname><given-names>WC</given-names></name><name><surname>Bordelon</surname><given-names>Y</given-names></name><name><surname>Greene</surname><given-names>PE</given-names></name><name><surname>Louis</surname><given-names>ED</given-names></name><article-title>A single-blind, o