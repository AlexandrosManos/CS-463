e><volume>106</volume><issue>6</issue><fpage>1140</fpage><lpage>1146</lpage><pub-id pub-id-type="pmid">11112898</pub-id></citation></ref><ref id="b14-ehp-117-475"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Diaz-Sanchez</surname><given-names>D</given-names></name><name><surname>Tsien</surname><given-names>A</given-names></name><name><surname>Fleming</surname><given-names>J</given-names></name><name><surname>Saxon</surname><given-names>A</given-names></name></person-group><year>1997</year><article-title>Combined diesel exhaust particulate and ragweed allergen challenge markedly enhances human in vivo nasal ragweed-specific IgE and skews cytokine production to a T helper cell 2-type pattern</article-title><source>J Immunol</source><volume>158</volume><issue>5</issue><fpage>2406</fpage><lpage>2413</lpage><pub-id pub-id-type="pmid">9036991</pub-id></citation></ref><ref id="b15-ehp-117-475"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dietert</surname><given-names>RR</given-names></name><name><surname>Etzel</surname><given-names>RA</given-names></name><name><surname>Chen</surname><given-names>D</given-names></name><name><surname>Halonen</surname><given-names>M</given-names></name><name><surname>Holladay</surname><given-names>SD</given-names></name><name><surname>Jarabek</surname><given-names>AM</given-names></name><etal/></person-group><year>2000</year><article-title>Workshop to identify critical windows of exposure for children&#x02019;s health: immune and respiratory systems work group summary</article-title><source>Environ Health Perspect</source><volume>108</volume><issue>suppl 3</issue><fpage>483</fpage><lpage>490</lpage><pub-id pub-id-type="pmid">10852848</pub-id></citation></ref><ref id="b16-ehp-117-475"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dominici</surname><given-names>F</given-names></name><name><surname>Peng</surname><