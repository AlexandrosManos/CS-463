/citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lethbridge</surname><given-names>J</given-names></name></person-group><article-title>Public sector reform and demand for human resources for health (HRH)</article-title><source>Hum Resour Health</source><year>2004</year><volume>2</volume><fpage>15</fpage><pub-id pub-id-type="pmid">15560841</pub-id><pub-id pub-id-type="doi">10.1186/1478-4491-2-15</pub-id></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Omar</surname><given-names>M</given-names></name></person-group><source>Consultancy report on Health Sector Reform Training Needs Assessment</source><year>2003</year><publisher-name>Tehran, World Health Organization</publisher-name><comment>Ref Type: Report</comment></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Omar</surname><given-names>M</given-names></name><name><surname>Tarin</surname><given-names>E</given-names></name><name><surname>Ashjaei</surname><given-names>K</given-names></name><name><surname>Mirzoev</surname><given-names>T</given-names></name><name><surname>Sheikh</surname><given-names>MR</given-names></name></person-group><article-title>In-country capacity development of a training institute: an Iranian experience</article-title><source>J Health Organ Manag</source><year>2007</year><volume>21</volume><fpage>519</fpage><lpage>532</lpage><pub-id pub-id-type="pmid">18062605</pub-id><pub-id pub-id-type="doi">10.1108/14777260710834319</pub-id></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Knight</surname><given-names>P</given-names></name></person-group><source>The effects of post-graduate certificates: A report to the project sponsors and partners</source><year>2006</year><publisher-name>The Institute of Educational Technology; The