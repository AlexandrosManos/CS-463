ands</article-title><source>Bioorg Med Chem</source><year>2006</year><volume>14</volume><fpage>6988</fpage><lpage>6997</lpage><pub-id pub-id-type="pmid">16837201</pub-id><pub-id pub-id-type="doi">10.1016/j.bmc.2006.06.028</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ostenfeld</surname><given-names>MS</given-names></name><name><surname>Fehrenbacher</surname><given-names>N</given-names></name><name><surname>Hoyer-Hansen</surname><given-names>M</given-names></name><etal></etal></person-group><article-title>Effective tumor cell death by sigma-2 receptor ligand siramesine involves lysosomal leakage and oxidative stress</article-title><source>Cancer Res</source><year>2005</year><volume>65</volume><fpage>8975</fpage><lpage>8983</lpage><pub-id pub-id-type="pmid">16204071</pub-id><pub-id pub-id-type="doi">10.1158/0008-5472.CAN-05-0269</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schnell</surname><given-names>MA</given-names></name><name><surname>Hardy</surname><given-names>C</given-names></name><name><surname>Hawley</surname><given-names>M</given-names></name><name><surname>Propert</surname><given-names>KJ</given-names></name><name><surname>Wilson</surname><given-names>JM</given-names></name></person-group><article-title>Effect of blood collection technique in mice on clinical pathology parameters</article-title><source>Hum Gene Ther</source><year>2002</year><volume>13</volume><fpage>155</fpage><lpage>61</lpage><pub-id pub-id-type="pmid">11779419</pub-id><pub-id pub-id-type="doi">10.1089/10430340152712700</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jones</surname><given-names>S</given-names></name><name><surname>Zhang</surname><given-names>X</given-names></name><name><surname>Parsons</surname><given-names>DW</given-names></nam