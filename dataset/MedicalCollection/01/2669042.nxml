me><given-names>K</given-names></name><etal></etal></person-group><article-title>Response of chemosensitive and chemoresistant leukemic cell lines to drug therapy: simultaneous assessment of proliferation, apoptosis, and necrosis</article-title><source>Cytometry</source><year>2000</year><volume>42</volume><fpage>50</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">10679743</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1097-0320(20000215)42:1&#x0003c;50::AID-CYTO8&#x0003e;3.0.CO;2-C</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>X</given-names></name><name><surname>Wang</surname><given-names>C</given-names></name><name><surname>Qin</surname><given-names>YW</given-names></name><etal></etal></person-group><article-title>Simultaneous suppression of multidrug resistance and antiapoptotic cellular defense induces apoptosis in chemoresistant human acute myeloid leukemia cells</article-title><source>Leuk Res</source><year>2007</year><volume>31</volume><fpage>989</fpage><lpage>994</lpage><pub-id pub-id-type="pmid">17067671</pub-id><pub-id pub-id-type="doi">10.1016/j.leukres.2006.09.001</pub-id></citation></ref></ref-list></back></article>