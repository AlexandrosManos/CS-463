n></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nikiforov</surname><given-names>YE</given-names></name></person-group><article-title>RET/PTC rearrangement in thyroid tumors</article-title><source>Endocr Pathol</source><year>2002</year><volume>13</volume><fpage>3</fpage><lpage>16</lpage><pub-id pub-id-type="pmid">12114746</pub-id><pub-id pub-id-type="doi">10.1385/EP:13:1:03</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Herrmann</surname><given-names>M</given-names></name></person-group><article-title>Standard and molecular cytogenetics of endocrine tumors</article-title><source>Am J Clin Pathol</source><year>2003</year><volume>119</volume><fpage>S17</fpage><lpage>S38</lpage><pub-id pub-id-type="pmid">12951842</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Santoro</surname><given-names>M</given-names></name><name><surname>Carlomagno</surname><given-names>F</given-names></name><name><surname>Melillo</surname><given-names>RM</given-names></name><name><surname>Fusco</surname><given-names>A</given-names></name></person-group><article-title>Dysfunction of the RET receptor in human cancer</article-title><source>Cel Mol Life Sci</source><year>2004</year><volume>61</volume><fpage>2954</fpage><lpage>2964</lpage><pub-id pub-id-type="doi">10.1007/s00018-004-4276-8</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jossart</surname><given-names>GH</given-names></name><name><surname>Greulich</surname><given-names>KM</given-names></name><name><surname>Siperstein</surname><given-names>AE</given-names></name><name><surname>Duh</surname><given-names>Q</given-names></name><name><surname>Clark</surname><given-names>OH</given-names></name><name><surname>Weier</surname><given-names>HU</g