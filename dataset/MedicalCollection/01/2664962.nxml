align="left" rowspan="1" colspan="1">Mixed</td></tr><tr><td align="left" rowspan="1" colspan="1">Q7@63</td><td align="left" rowspan="1" colspan="1">NREM min</td><td align="left" rowspan="1" colspan="1">State Length</td><td align="left" rowspan="1" colspan="1">7</td><td align="left" rowspan="1" colspan="1">65.140</td><td align="left" rowspan="1" colspan="1">114.924</td><td align="left" rowspan="1" colspan="1">4.443</td><td align="left" rowspan="1" colspan="1">.027</td><td align="left" rowspan="1" colspan="1">Light</td></tr><tr><td align="left" rowspan="1" colspan="1">Q9@15</td><td align="left" rowspan="1" colspan="1">lat NREM</td><td align="left" rowspan="1" colspan="1">Latency</td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">15.160</td><td align="left" rowspan="1" colspan="1">46.527</td><td align="left" rowspan="1" colspan="1">3.062</td><td align="left" rowspan="1" colspan="1">.026</td><td align="left" rowspan="1" colspan="1">24 hour</td></tr><tr><td align="left" rowspan="1" colspan="1">Q12@28</td><td align="left" rowspan="1" colspan="1">db TS</td><td align="left" rowspan="1" colspan="1">Fragmentation</td><td align="left" rowspan="1" colspan="1">12</td><td align="left" rowspan="1" colspan="1">27.580</td><td align="left" rowspan="1" colspan="1">71.050</td><td align="left" rowspan="1" colspan="1">3.111</td><td align="left" rowspan="1" colspan="1">.035</td><td align="left" rowspan="1" colspan="1">24 hour</td></tr><tr><td align="left" rowspan="1" colspan="1">Q12@28</td><td align="left" rowspan="1" colspan="1">db NREM</td><td align="left" rowspan="1" colspan="1">Fragmentation</td><td align="left" rowspan="1" colspan="1">12</td><td align="left" rowspan="1" colspan="1">27.580</td><td align="left" rowspan="1" colspan="1">71.050</td><td align="left" rowspan="1" colspan="1">3.119</td><td align="left" rowspan="1" colspan="1">.036</td><td align="left" rowspan="1" colspan="1">24 hour</td></tr><tr><td align="left" rowspan="1" colspan="1"