align="left" rowspan="1" colspan="1">5894</td><td align="left" rowspan="1" colspan="1">35.84</td><td align="left" rowspan="1" colspan="1">2853</td><td align="left" rowspan="1" colspan="1">n/a</td><td align="left" rowspan="1" colspan="1">n/a</td><td align="left" rowspan="1" colspan="1">n/a</td><td align="left" rowspan="1" colspan="1">n/a</td></tr><tr><td align="left" rowspan="1" colspan="1">C56</td><td align="left" rowspan="1" colspan="1">Cottages</td><td align="left" rowspan="1" colspan="1">F, A</td><td align="left" rowspan="1" colspan="1">30.2</td><td align="left" rowspan="1" colspan="1">2184</td><td align="left" rowspan="1" colspan="1">30.65</td><td align="left" rowspan="1" colspan="1">2302</td><td align="left" rowspan="1" colspan="1">n/a</td><td align="left" rowspan="1" colspan="1">n/a</td><td align="left" rowspan="1" colspan="1">n/a</td><td align="left" rowspan="1" colspan="1">n/a</td></tr><tr><td align="left" rowspan="1" colspan="1">C57</td><td align="left" rowspan="1" colspan="1">Cottages</td><td align="left" rowspan="1" colspan="1">M, A</td><td align="left" rowspan="1" colspan="1">42.8</td><td align="left" rowspan="1" colspan="1">4501</td><td align="left" rowspan="1" colspan="1">50.74</td><td align="left" rowspan="1" colspan="1">5578</td><td align="left" rowspan="1" colspan="1">n/a</td><td align="left" rowspan="1" colspan="1">n/a</td><td align="left" rowspan="1" colspan="1">n/a</td><td align="left" rowspan="1" colspan="1">n/a</td></tr><tr><td align="left" rowspan="1" colspan="1">C60</td><td align="left" rowspan="1" colspan="1">Cottages</td><td align="left" rowspan="1" colspan="1">M, A</td><td align="left" rowspan="1" colspan="1">70.6</td><td align="left" rowspan="1" colspan="1">7433</td><td align="left" rowspan="1" colspan="1">48.61</td><td align="left" rowspan="1" colspan="1">4912</td><td align="left" rowspan="1" colspan="1">n/a</td><td align="left" rowspan="1" colspan="1">n/a</td><td align="left" rowspan="1" colspan="1">n/a</td><td align="left" rowspan="1" 