</volume><fpage>2756</fpage><lpage>67</lpage><pub-id pub-id-type="pmid">8941100</pub-id></citation></ref><ref id="b12-vhrm-4-1179"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dormandy</surname><given-names>JA</given-names></name><name><surname>Rutherford</surname><given-names>RB</given-names></name></person-group><year>2000</year><article-title>Management of peripheral arterial disease (PAD). TransAtlantic Inter- Society Consensus (TASC)</article-title><source>J Vasc Surg</source><volume>31</volume><fpage>S1e</fpage><lpage>S296</lpage><pub-id pub-id-type="pmid">10666287</pub-id></citation></ref><ref id="b13-vhrm-4-1179"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dzau</surname><given-names>VJ</given-names></name><name><surname>Re</surname><given-names>R</given-names></name></person-group><year>1994</year><article-title>Tissue angiotensin system in cardiovascular medicine: a paradigm shift?</article-title><source>Circulation</source><volume>89</volume><fpage>493</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">8281685</pub-id></citation></ref><ref id="b14-vhrm-4-1179"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Enseleit</surname><given-names>F</given-names></name><name><surname>L&#x000fc;scher</surname><given-names>TF</given-names></name><name><surname>Ruschitzka</surname><given-names>F</given-names></name></person-group><year>2003</year><article-title>Angiotensin-converting enzyme inhibition and endothelial dysfunction: focus on ramipril</article-title><source>Eur Heart J Suppl</source><volume>5</volume><issue>Suppl A</issue><fpage>A31</fpage><lpage>A36</lpage></citation></ref><ref id="b15-vhrm-4-1179"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Feringa</surname><given-names>HH</given-names></name><name><surname>van Waning</surname><given-names>VH</given-names></name><name><surname>Ba