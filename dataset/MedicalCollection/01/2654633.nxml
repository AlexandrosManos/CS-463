ef><ref id="b18-ndt-3-219"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chue</surname><given-names>P</given-names></name><name><surname>Cheung</surname><given-names>R</given-names></name></person-group><year>2006</year><article-title>Minimising the risk of diabetes in patients with schizophrenia and bipolar disorder</article-title><source>Int J of Psychiatr in Clin Pract</source><volume>10</volume><fpage>105</fpage><lpage>16</lpage></citation></ref><ref id="b19-ndt-3-219"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>DelBello</surname><given-names>MP</given-names></name><name><surname>Schwiers</surname><given-names>ML</given-names></name><name><surname>Rosenberg</surname><given-names>HL</given-names></name><etal/></person-group><year>2002</year><article-title>A double-blind, randomized, placebo-controlled study of quetiapine as adjunctive treatment for adolescent mania</article-title><source>J Am Acad Child Adolesc Psychiatry</source><volume>41</volume><fpage>1216</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">12364843</pub-id></citation></ref><ref id="b20-ndt-3-219"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Nayer</surname><given-names>A</given-names></name><name><surname>Windhager</surname><given-names>E</given-names></name><name><surname>Irmansyah</surname></name><etal/></person-group><year>2003</year><article-title>Efficacy and tolerability of quetiapine in patients with schizophrenia switched from other antipsychotics</article-title><source>Int J Psych Clin Pract</source><volume>7</volume><fpage>59</fpage><lpage>66</lpage></citation></ref><ref id="b21-ndt-3-219"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>DeVane</surname><given-names>CL</given-names></name><name><surname>Nemeroff</surname><given-names>CB</given-names></name></person-group><year>2001</year><article-title>Clini