-title><source>Proc Natl Acad Sci U S A</source><year>1998</year><volume>95</volume><fpage>3996</fpage><lpage>4001</lpage><pub-id pub-id-type="pmid">9520481</pub-id></citation></ref><ref id="R21"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Llado</surname><given-names>J</given-names></name><etal/></person-group><article-title>Degeneration of respiratory motor neurons in the SOD1 G93A transgenic rat model of ALS</article-title><source>Neurobiol Dis</source><year>2006</year><volume>21</volume><fpage>110</fpage><lpage>118</lpage><pub-id pub-id-type="pmid">16084734</pub-id></citation></ref><ref id="R22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tankersley</surname><given-names>CG</given-names></name><name><surname>Haenggeli</surname><given-names>C</given-names></name><name><surname>Rothstein</surname><given-names>JD</given-names></name></person-group><article-title>Respiratory impairment in a mouse model of amyotrophic lateral sclerosis</article-title><source>J Appl Physiol</source><year>2007</year><volume>102</volume><fpage>926</fpage><lpage>932</lpage><pub-id pub-id-type="pmid">17110520</pub-id></citation></ref><ref id="R23"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Matsumoto</surname><given-names>A</given-names></name><etal/></person-group><article-title>Disease progression of human SOD1 (G93A) transgenic ALS model rats</article-title><source>J Neurosci Res</source><year>2006</year><volume>83</volume><fpage>119</fpage><lpage>133</lpage><pub-id pub-id-type="pmid">16342121</pub-id></citation></ref><ref id="R24"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maragakis</surname><given-names>NJ</given-names></name><etal/></person-group><article-title>Glial restricted precursors protect against chronic glutamate neurotoxicity of motor neurons in vitro</article-title><source>Glia</source><year>2005</year><volume>50</volume><fpage>145</fpage><lpage>159</lpage><pub-id pub-id-type="pmid">15657939</pub-id></citation></ref><ref id="R25"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mitsui</surname><given-names>T</given-names></name><name><surname>Fischer</surname><given-names>I</given-names></name><name><surname>Shumsky</surname><given-names>JS</given-names></name><name><surname>Murray</surname><given-names>M</given-names></name></person-group><article-title>Transplants of fibroblasts expressing BDNF and NT-3 promote recovery of bladder and hindlimb function following spinal contusion injury in rats</article-title><source>Exp Neurol</source><year>2005</year><volume>194</volume><fpage>410</fpage><lpage>431</lpage><pub-id pub-id-type="pmid">16022868</pub-id></citation></ref><ref id="R26"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maragakis</surname><given-names>NJ</given-names></name><name><surname>Rothstein</surname><given-names>JD</given-names></name></person-group><article-title>Glutamate transporters: animal models to neurologic disease</article-title><source>Neurobiol Dis</source><year>2004</year><volume>15</volume><fpage>461</fpage><lpage>473</lpage><pub-id pub-id-type="pmid">15056453</pub-id></citation></ref><ref id="R27"><label>27</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Federici</surname><given-names>T</given-names></name><name><surname>Boulis</surname><given-names>NM</given-names></name></person-group><article-title>Gene-based treatment of motor neuron diseases</article-title><source>Muscle Nerve</source><year>2006</year><volume>33</volume><fpage>302</fpage><lpage>323</lpage><pub-id pub-id-type="pmid">16228969</pub-id></citation></ref><ref id="R28"><label>28</label><citation citation-type="journal"><person-