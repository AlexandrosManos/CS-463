rson-group-type="author"><name><surname>Janecki</surname><given-names>CJ</given-names></name><name><surname>Shahcheragh</surname><given-names>GH</given-names></name></person-group><article-title>The forward elevation maneuver for reduction of anterior dislocations of the shoulder</article-title><source>Clin Orthop</source><year>1982</year><volume>164</volume><fpage>177</fpage><lpage>180</lpage></citation><citation citation-type="display-unstructured">Janecki CJ, Shahcheragh GH (1982) The forward elevation maneuver for reduction of anterior dislocations of the shoulder. Clin Orthop 164:177&#x02013;180 <pub-id pub-id-type="pmid">7067281</pub-id></citation></ref><ref id="CR6"><label>6.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Manes</surname><given-names>HR</given-names></name></person-group><article-title>A new method of shoulder reduction in the elderly</article-title><source>Clin Orthop</source><year>1980</year><volume>147</volume><fpage>200</fpage><lpage>222</lpage></citation><citation citation-type="display-unstructured">Manes HR (1980) A new method of shoulder reduction in the elderly. Clin Orthop 147:200&#x02013;222 <pub-id pub-id-type="pmid">7371296</pub-id></citation></ref><ref id="CR7"><label>7.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Plummer</surname><given-names>D</given-names></name><name><surname>Clinton</surname><given-names>J</given-names></name></person-group><article-title>The external rotation method for reduction of acute anterior shoulder dislocation</article-title><source>Emerg Med Clin North Am</source><year>1989</year><volume>7</volume><fpage>165</fpage><lpage>175</lpage></citation><citation citation-type="display-unstructured">Plummer D, Clinton J (1989) The external rotation method for reduction of acute anterior shoulder dislocation. Emerg Med Clin North Am 7:165&#x02013;175 <pub-id pub-id-type="pmid">2917505</pub-id></citation></ref><ref id="CR8"><label>8.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kuhn</surname><given-names>JE</given-names></name></person-group><article-title>Treating the initial anterior shoulder dislocation&#x02013;&#x02013;an evidence-based medicine approach</article-title><source>Sports Med Arthrosc</source><year>2006</year><volume>14</volume><issue>4</issue><fpage>192</fpage><lpage>198</lpage><pub-id pub-id-type="doi">10.1097/01.jsa.0000212328.25345.de</pub-id></citation><citation citation-type="display-unstructured">Kuhn JE (2006) Treating the initial anterior shoulder dislocation&#x02013;&#x02013;an evidence-based medicine approach. Sports Med Arthrosc 14(4):192&#x02013;198 <pub-id pub-id-type="pmid">17135968</pub-id></citation></ref><ref id="CR9"><label>9.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ashton</surname><given-names>HR</given-names></name><name><surname>Hassan</surname><given-names>Z</given-names></name></person-group><article-title>Best evidence topic report. Kocher&#x02019;s or Milch&#x02019;s technique for reduction of anterior shoulder dislocations</article-title><source>Emerg Med J</source><year>2006</year><volume>23</volume><issue>7</issue><fpage>570</fpage><lpage>571</lpage><pub-id pub-id-type="doi">10.1136/emj.2006.038521</pub-id></citation><citation citation-type="display-unstructured">Ashton HR, Hassan Z (2006) Best evidence topic report. Kocher&#x02019;s or Milch&#x02019;s technique for reduction of anterior shoulder dislocations. Emerg Med J 23(7):570&#x02013;571 <pub-id pub-id-type="pmid">16794109</pub-id></citation></ref><ref id="CR10"><label>10.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Milch</surname><given-names>H</given-names></name></person-group><article-title>Treatment of dislocation of the shoulder</article-title><source>Surgery</source><year>1938</year><volume>3</volume><fp