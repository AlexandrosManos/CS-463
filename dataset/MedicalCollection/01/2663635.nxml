</ref><ref id="CR10"><label>10.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vano</surname><given-names>E</given-names></name><name><surname>Gonzalez</surname><given-names>L</given-names></name><name><surname>Beneytez</surname><given-names>F</given-names></name><etal/></person-group><article-title>Lens injuries induced by occupational exposure in non-optimized interventional radiology laboratories</article-title><source>Br J Radiol</source><year>1998</year><volume>71</volume><fpage>728</fpage><lpage>733</lpage></citation><citation citation-type="display-unstructured">Vano E, Gonzalez L, Beneytez F, et al (1998) Lens injuries induced by occupational exposure in non-optimized interventional radiology laboratories. Br J Radiol 71:728&#x02013;33 <pub-id pub-id-type="pmid">9771383</pub-id></citation></ref><ref id="CR11"><label>11.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Limacher</surname><given-names>MC</given-names></name><name><surname>Douglas</surname><given-names>PS</given-names></name><name><surname>Germano</surname><given-names>G</given-names></name><etal/></person-group><article-title>ACC expert consensus document. Radiation safety in the practice of cardiology. American College of Cardiology</article-title><source>J Am Coll Cardiol</source><year>1998</year><volume>31</volume><fpage>892</fpage><lpage>913</lpage><pub-id pub-id-type="doi">10.1016/S0735-1097(98)00047-3</pub-id></citation><citation citation-type="display-unstructured">Limacher MC, Douglas PS, Germano G, et al (1998) ACC expert consensus document. Radiation safety in the practice of cardiology. American College of Cardiology. J Am Coll Cardiol 31:892&#x02013;13 <pub-id pub-id-type="pmid">9525565</pub-id></citation></ref><ref id="CR12"><label>12.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cardella</surname><given-names>JF</given-names></name><name><surname>Casarella</surname><given-names>WJ</given-names></name><name><surname>DeWeese</surname><given-names>JA</given-names></name><etal/></person-group><article-title>Optimal resources for the examination and endovascular treatment of the peripheral and visceral vascular systems. AHA intercouncil report on peripheral and visceral angiographic and interventional laboratories</article-title><source>Circulation</source><year>1994</year><volume>89</volume><fpage>1481</fpage><lpage>1493</lpage></citation><citation citation-type="display-unstructured">Cardella JF, Casarella WJ, DeWeese JA, et al (1994) Optimal resources for the examination and endovascular treatment of the peripheral and visceral vascular systems. AHA intercouncil report on peripheral and visceral angiographic and interventional laboratories. Circulation 89:1481&#x02013;493 <pub-id pub-id-type="pmid">8124831</pub-id></citation></ref><ref id="CR13"><label>13.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zufall</surname><given-names>DL</given-names></name></person-group><article-title>Credentialing: an ongoing concern in health care</article-title><source>Health Care Manage Rev</source><year>1981</year><volume>6</volume><fpage>71</fpage><lpage>77</lpage></citation><citation citation-type="display-unstructured">Zufall DL (1981) Credentialing: an ongoing concern in health care. Health Care Manage Rev 6:71&#x02013;7 <pub-id pub-id-type="pmid">7239927</pub-id></citation></ref><ref id="CR14"><label>14.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brooks</surname><given-names>DC</given-names></name><name><surname>Morrisey</surname><given-names>MA</given-names></name></person-group><article-title>Credentialing: say good-bye to the &#x02018;rubber stamp&#x02013;</article-title><source>Hospitals</source><year>1985</year><volume>59</volume><fpage>50</fpage><lpage>52</lpage></citation><citation citation-type="display-unstructured">Brooks DC, Morrisey MA (1985) Credentialing: say good-bye to the &#x02018;rubber stamp&#x02013; Hospitals 59:50&#x02013;2 <pub-id pub-id-type="pmid">3997109</pub-id></citation></ref><ref id="CR15"><label>15.</label><citation citation-type="book"><source>Managing the use of fluoroscopy in medical institutions AAPM report no. 58</source><year>1998</year><publisher-loc>Madison</publisher-loc><publisher-name>Medical Physics Publishing</publisher-name></citation><citation citation-type="display-unstructured">American Association of Physicists in Medicine (1998) Managing the use of fluoroscopy in medical institutions AAPM report no. 58. Medical Physics Publishing, Madison </citation></ref><ref id="CR16"><label>16.</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wagner</surname><given-names>LK</given-names></name><name><surname>Archer</surname><given-names>BR</given-names></name></person-group><source>Minimizing risks from fluoroscopic x-rays; bioeffects, instrumentation and examination, a credentialing program for physicians</source><year>2004</year><edition>4</edition><publisher-loc>Houston</publisher-loc><publisher-name>Partners in Radiation Management</publisher-name></citation><citation citation-type="display-unstructured">Wagner LK, Archer BR (2004) Minimizing risks from fluoroscopic x-rays; bioeffects, instrumentation and examination, a credentialing program for physicians, 4th edn. Partners in Radiation Management, Houston </citation></ref></ref-list></back></article>