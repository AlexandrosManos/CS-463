colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;Participants with FPG &#x02264;99 mg/dl</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;FPG, per 5 mg/dl</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td align="char" char="(" rowspan="1" colspan="1">1.29 (1.06&#x02013;1.58)</td><td align="center" rowspan="1" colspan="1"><bold>&#x02014;</bold></td><td align="char" char="(" rowspan="1" colspan="1">1.24 (1.02&#x02013;1.51)</td><td align="char" char="(" rowspan="1" colspan="1">1.27 (1.04&#x02013;1.56)</td><td align="center" rowspan="1" colspan="1"><bold>&#x02014;</bold></td><td align="char" char="(" rowspan="1" colspan="1">1.21 (0.99&#x02013;1.48)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;A1C (%)</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02264;4.9 (5.3)<xref ref-type="table-fn" rid="TF1-2">&#x02020;</xref></td><td align="right" rowspan="1" colspan="1">1,568</td><td align="char" char="(" rowspan="1" colspan="1">21 (1.3)</td><td align="center" rowspan="1" colspan="1"><bold>&#x02014;</bold></td><td align="char" char="." rowspan="1" colspan="1">1.00</td><td align="char" char="." rowspan="1" colspan="1">1.00</td><td align="center" rowspan="1" colspan="1"><bold>&#x02014;</bold></td><td align="char" char="." rowspan="1" colspan="1">1.00</td><td align="char" char="." rowspan="1" colspan="1">1.00</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;5.0&#x02013;5.4 (5.4&#x02013;5.7)<xref ref-type="table-fn" rid="TF1-2">&#x02020;</xref></td><td align="right" rowspan="1" colspan="1">1,955</td><td align="char" char="(" rowspan="1" colspan="1">37 (1.9)</td><td align="center" rowspan="1" colspan="1"><bold>&#x02014;</bold></td><td align="char" char="(" rowspan="1" colspan="1">1.42 (0.83&#x02013;2.44)</td><td align="char" char="(" rowspan="1" colspan="1">1.35 (0.79&#x02013;2.33)</td><td align="center" rowspan="1" colspan="1"><bold>&#x02014;</bold></td><td align="char" char="(" rowspan="1" colspan="1">1.32 (0.76&#x02013;2.27)</td><td align="char" char="(" rowspan="1" colspan="1">1.26 (0.73&#x02013;2.17)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;5.5&#x02013;5.9 (5.8&#x02013;6.2)<xref ref-type="table-fn" rid="TF1-2">&#x02020;</xref></td><td align="right" rowspan="1" colspan="1">535</td><td align="char" char="(" rowspan="1" colspan="1">45 (8.4)</td><td align="center" rowspan="1" colspan="1"><bold>&#x02014;</bold></td><td align="char" char="(" rowspan="1" colspan="1">6.77 (3.99&#x02013;11.47)</td><td align="char" char="(" rowspan="1" colspan="1">6.43 (3.79&#x02013;10.92)</td><td align="center" rowspan="1" colspan="1"><bold>&#x02014;</bold></td><td align="char" char="(" rowspan="1" colspan="1">6.51 (3.76&#x02013;11.30)</td><td align="char" char="(" rowspan="1" colspan="1">6.17 (3.54&#x02013;10.74)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x02003;&#x