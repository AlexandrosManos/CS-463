><surname>Nilstun</surname><given-names>T</given-names></name><name><surname>Norup</surname><given-names>M</given-names></name><name><surname>Paci</surname><given-names>E</given-names></name><name><surname>van der Wal</surname><given-names>G</given-names></name><name><surname>van der Maas</surname><given-names>PJ</given-names></name></person-group><article-title>End-of-life decision-making in six European countries: descriptive study</article-title><source>Lancet</source><year>2003</year><volume>362</volume><fpage>345</fpage><lpage>350</lpage><pub-id pub-id-type="pmid">12907005</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(03)14019-6</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Onwuteaka-Philipsen</surname><given-names>BD</given-names></name><name><surname>van der Heide</surname><given-names>A</given-names></name><name><surname>Koper</surname><given-names>D</given-names></name><name><surname>Keij-Deerenberg</surname><given-names>I</given-names></name><name><surname>Rietjens</surname><given-names>JA</given-names></name><name><surname>Rurup</surname><given-names>ML</given-names></name><name><surname>Vrakking</surname><given-names>AM</given-names></name><name><surname>Georges</surname><given-names>JJ</given-names></name><name><surname>Muller</surname><given-names>MT</given-names></name><name><surname>van der Wal</surname><given-names>G</given-names></name><name><surname>van der Maas</surname><given-names>PJ</given-names></name></person-group><article-title>Euthanasia and other end-of-life decisions in the Netherlands in 1995, and 2001</article-title><source>Lancet</source><year>1990</year><volume>362</volume><fpage>395</fpage><lpage>399</lpage><pub-id pub-id-type="pmid">12907015</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(03)14029-9</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bilsen</surna