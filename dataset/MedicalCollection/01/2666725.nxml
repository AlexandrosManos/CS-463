e>228</lpage><pub-id pub-id-type="pmid">13155512</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coutaux</surname><given-names>A</given-names></name><name><surname>Adam</surname><given-names>F</given-names></name><name><surname>Willer</surname><given-names>JC</given-names></name><name><surname>Le Bars</surname><given-names>D</given-names></name></person-group><article-title>Hyperalgesia and allodynia: peripheral mechanisms</article-title><source>Joint Bone Spine</source><year>2005</year><volume>72</volume><fpage>359</fpage><lpage>371</lpage><pub-id pub-id-type="pmid">16214069</pub-id><pub-id pub-id-type="doi">10.1016/j.jbspin.2004.01.010</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nozaki-Taguchi</surname><given-names>N</given-names></name><name><surname>Yaksh</surname><given-names>TL</given-names></name></person-group><article-title>A novel model of primary and secondary hyperalgesia after mild thermal injury in the rat</article-title><source>Neurosci Lett</source><year>1998</year><volume>254</volume><fpage>25</fpage><lpage>28</lpage><pub-id pub-id-type="pmid">9780083</pub-id><pub-id pub-id-type="doi">10.1016/S0304-3940(98)00648-X</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schaible</surname><given-names>HG</given-names></name><name><surname>Del Rosso</surname><given-names>A</given-names></name><name><surname>Matucci-Cerinic</surname><given-names>M</given-names></name></person-group><article-title>Neurogenic aspects of inflammation</article-title><source>Rheum Dis Clin North Am</source><year>2005</year><volume>31</volume><fpage>77</fpage><lpage>101</lpage><comment>ix.</comment><pub-id pub-id-type="pmid">15639057</pub-id><pub-id pub-id-type="doi">10.1016/j.rdc.2004.09.004</pub-id></citation></ref><ref id="B9"><citation cita