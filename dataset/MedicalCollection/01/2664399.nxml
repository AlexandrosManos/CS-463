haroff="50">7.36</td><td align="center" valign="top" charoff="50">17.6</td><td align="center" valign="top" charoff="50">6.62</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">5</td><td align="center" valign="top" charoff="50">4.58</td><td align="center" valign="top" charoff="50">60.3</td><td align="center" valign="top" charoff="50">3.3</td><td align="center" valign="top" charoff="50">15.8</td><td align="center" valign="top" charoff="50">13.35</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">10</td><td align="center" valign="top" charoff="50">4.12</td><td align="center" valign="top" charoff="50">23.45</td><td align="center" valign="top" charoff="50">15.3</td><td align="center" valign="top" charoff="50">23.85</td><td align="center" valign="top" charoff="50">30.85</td></tr><tr><td align="left" valign="top" charoff="50">Combination</td><td align="center" valign="top" charoff="50">1</td><td align="center" valign="top" charoff="50">2.92</td><td align="center" valign="top" charoff="50">45.6</td><td align="center" valign="top" charoff="50">11.45</td><td align="center" valign="top" charoff="50">24.1</td><td align="center" valign="top" charoff="50">16.35</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">3</td><td align="center" valign="top" charoff="50">2.21</td><td align="center" valign="top" charoff="50">33.5</td><td align="center" valign="top" charoff="50">10.6</td><td align="center" valign="top" charoff="50">39.7</td><td align="center" valign="top" charoff="50">12.3</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">5</td><td align="center" valign="top" charoff="50">3.31</td><td align="center" valign="top" charoff="50">9.065</td><td align="center" valign="top" charoff="50">6.1</td><td align="center" valign="top" char