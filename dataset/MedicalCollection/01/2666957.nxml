</year><publisher-loc>Cambridge</publisher-loc><publisher-name>Cambridge University Press</publisher-name></citation></ref><ref id="R26"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>H</given-names></name><name><surname>Singh</surname><given-names>P</given-names></name></person-group><article-title>Concept Net A Practical Commonsense Reasoning Toolkit</article-title><source>BT Technol J</source><year>2004</year><volume>4</volume><fpage>211</fpage><lpage>226</lpage></citation></ref><ref id="R27"><label>27</label><citation citation-type="confproc" id="N0x1d35d00N0x2066c90"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>H</given-names></name><name><surname>Singh</surname><given-names>P</given-names></name></person-group><article-title>Commonsense Reasoning in and over Natural Language </article-title><year>2004</year><conf-name>Proceedings of the 8th International Conference on Knowledge-Based Intelligent Information &#x00026; Engineering Systems</conf-name><conf-date>September 22-24</conf-date><conf-loc>Wellington New Zealand</conf-loc></citation><citation citation-type="book" id="N0x1d35d00N0x2066e10"><source>Lecture Notes in Artificial Intelligence</source><year>2004</year><publisher-loc>Berlin</publisher-loc><publisher-name>Springer-Verlag</publisher-name></citation></ref><ref id="R28"><label>28</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Birman-Deych</surname><given-names>E</given-names></name><name><surname>Radford</surname><given-names>MJ</given-names></name><name><surname>Nilasena</surname><given-names>DS</given-names></name><name><surname>Gage</surname><given-names>BF</given-names></name></person-group><article-title>Use and effectiveness of warfarin in Medicare beneficiaries with atrial fibrillation</article-title><source>Stroke</source><year>2006</year><volume>4</volume><fpage>1070</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">16528001</pub-id></citation></ref><ref id="R29"><label>29</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Niiranen</surname><given-names>S</given-names></name><name><surname>Wartiovaara-Kautto</surname><given-names>U</given-names></name><name><surname>Syrjala</surname><given-names>M</given-names></name><etal/></person-group><article-title>Reorganization of oral anticoagulant (warfarin) treatment follow-up</article-title><source>Scand J Prim Health Care</source><year>2006</year><volume>1</volume><fpage>33</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">16612853</pub-id></citation></ref><ref id="R30"><label>30</label><citation citation-type="web"><article-title>Resource Description Framework </article-title><source>Available from: <uri xlink:type="simple" xlink:href="http: //www.w3.org/RDF."> http: //www.w3.org/RDF</uri></source><access-date>[cited 2008 January 31]</access-date></citation></ref></ref-list></back><floats-wrap><fig id="F1" position="float"><label>Fig. (1).</label><caption><p>Conceptual system architecture.</p></caption><graphic xlink:href="TOMINFOJ-2-42_F1"/></fig></floats-wrap></article>