on citation-type="journal"><person-group person-group-type="author"><name><surname>Ernst</surname><given-names>ME</given-names></name><name><surname>Messmer</surname><given-names>PR</given-names></name><name><surname>Franco</surname><given-names>M</given-names></name><name><surname>Gonzalez</surname><given-names>JL</given-names></name></person-group><article-title>Nurses' job satisfaction, stress, and recognition in a pediatric setting setting</article-title><source>Pediatr Nurs</source><year>2004</year><volume>30</volume><fpage>219</fpage><lpage>27</lpage><comment>Erratum in: Pediatr Nurs. 2005, <bold>31(1)</bold>:20</comment><pub-id pub-id-type="pmid">15311648</pub-id><pub-id pub-id-type="doi">10.1016/j.pediatrneurol.2003.07.007</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Akerstedt</surname><given-names>T</given-names></name></person-group><article-title>Psychological and psychophysiological effects of shift work</article-title><source>Scand J Work Environ Health</source><year>1990</year><volume>16</volume><fpage>67</fpage><lpage>73</lpage><pub-id pub-id-type="pmid">2189223</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dyer</surname><given-names>C</given-names></name></person-group><article-title>GPs faced escalating litigation</article-title><source>BMJ</source><year>1999</year><volume>318</volume><fpage>830</fpage><pub-id pub-id-type="pmid">10092252</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shanafelt</surname><given-names>TD</given-names></name><name><surname>Bradley</surname><given-names>KA</given-names></name><name><surname>Wipf</surname><given-names>JE</given-names></name><name><surname>Back</surname><given-names>AL</given-names></name></person-group><article-title>Burnout and self-reported patient care in an internal medicine residency program</article-title><source>Ann Intern Med</source><year>2002</year><volume>136</volume><fpage>358</fpage><lpage>67</lpage><pub-id pub-id-type="pmid">11874308</pub-id></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mc Cue</surname><given-names>JD</given-names></name></person-group><article-title>The effects of stress on physicians and their medical practice</article-title><source>New Engl J Med</source><year>1982</year><volume>306</volume><fpage>458</fpage><lpage>463</lpage><pub-id pub-id-type="pmid">7057844</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Frank</surname><given-names>E</given-names></name><name><surname>McMurray</surname><given-names>JE</given-names></name><name><surname>Linzer</surname><given-names>M</given-names></name><etal></etal></person-group><article-title>Career satisfaction od US women physicians: Results from the Women Physicians' Health study. Society of General Internal medicine Career Satisfaction Study Group</article-title><source>Arch Intern Med</source><year>1999</year><volume>159</volume><fpage>1417</fpage><lpage>1426</lpage><pub-id pub-id-type="pmid">10399893</pub-id><pub-id pub-id-type="doi">10.1001/archinte.159.13.1417</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kellermanan</surname><given-names>S</given-names></name><name><surname>Herold</surname><given-names>J</given-names></name></person-group><article-title>Physician response to surveys. A review of sthe literature</article-title><source>Am J Prev Med</source><year>2001</year><volume>20</volume><fpage>61</fpage><lpage>71</lpage><pub-id pub-id-type="doi">10.1016/S0749-3797(00)00258-0</pub-id></citation></ref></ref-list></back></article>