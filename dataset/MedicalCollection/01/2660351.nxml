tion-type="journal"><person-group person-group-type="author"><name><surname>James</surname><given-names>KE</given-names></name><name><surname>Schneider</surname><given-names>H</given-names></name><name><surname>Ansell</surname><given-names>SW</given-names></name><name><surname>Evers</surname><given-names>M</given-names></name><name><surname>Robba</surname><given-names>L</given-names></name><name><surname>Uszynski</surname><given-names>G</given-names></name><name><surname>Pedersen</surname><given-names>N</given-names></name><name><surname>Newton</surname><given-names>AE</given-names></name><name><surname>Russell</surname><given-names>SJ</given-names></name><name><surname>Vogel</surname><given-names>JC</given-names></name><name><surname>Kilian</surname><given-names>A</given-names></name></person-group><article-title>Diversity Arrays Technology (DArT) for Pan-Genomic Evolutionary Studies of Non-Model Organisms</article-title><source>PLoS ONE</source><year>2008</year><volume>3</volume><fpage>e1682</fpage><comment>doi:10.1371/journal.pone.0001682</comment><pub-id pub-id-type="pmid">18301759</pub-id><pub-id pub-id-type="doi">10.1371/journal.pone.0001682</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rafalski</surname><given-names>JA</given-names></name></person-group><article-title>Novel genetic mapping tools in plants: SNPs and LD-based approaches</article-title><source>Plant Sci</source><year>2002</year><volume>162</volume><fpage>329</fpage><lpage>333</lpage><pub-id pub-id-type="doi">10.1016/S0168-9452(01)00587-8</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oberhagemann</surname><given-names>P</given-names></name><name><surname>Chatot-Balandras</surname><given-names>C</given-names></name><name><surname>Sch&#x000e4;fer-Preg</surname><given-names>R</given-names></name><name><surname>Wegener</surname><given-nam