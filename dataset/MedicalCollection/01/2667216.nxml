rowspan="1" colspan="1">.116</td><td align="left" rowspan="1" colspan="1">&#x02212;.017</td><td align="left" rowspan="1" colspan="1">.086</td><td align="left" rowspan="1" colspan="1">.003</td><td align="left" rowspan="1" colspan="1">.115</td><td align="left" rowspan="1" colspan="1">.035</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">P</td><td align="left" rowspan="1" colspan="1">.326</td><td align="left" rowspan="1" colspan="1">.448</td><td align="left" rowspan="1" colspan="1">.154</td><td align="left" rowspan="1" colspan="1">.823</td><td align="left" rowspan="1" colspan="1">.310</td><td align="left" rowspan="1" colspan="1">.967</td><td align="left" rowspan="1" colspan="1">.179</td><td align="left" rowspan="1" colspan="1">.655</td></tr><tr><td align="left" rowspan="1" colspan="1">Delayed Recall</td><td align="left" rowspan="1" colspan="1">Beta</td><td align="left" rowspan="1" colspan="1">&#x02212;.064</td><td align="left" rowspan="1" colspan="1">.043</td><td align="left" rowspan="1" colspan="1">&#x02212;.087</td><td align="left" rowspan="1" colspan="1">.032</td><td align="left" rowspan="1" colspan="1">&#x02212;.068</td><td align="left" rowspan="1" colspan="1">.035</td><td align="left" rowspan="1" colspan="1">&#x02212;.068</td><td align="left" rowspan="1" colspan="1">.017</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">P</td><td align="left" rowspan="1" colspan="1">.421</td><td align="left" rowspan="1" colspan="1">.563</td><td align="left" rowspan="1" colspan="1">.279</td><td align="left" rowspan="1" colspan="1">.668</td><td align="left" rowspan="1" colspan="1">.416</td><td align="left" rowspan="1" colspan="1">.645</td><td align="left" rowspan="1" colspan="1">.418</td><td align="left" rowspan="1" colspan="1">.824</td></tr><tr><td align="left" rowspan="1" colspan="1">Digits Backwards</td><td align="left" rowspan="1" colspan="1">Beta</td><td align="left" rowspan="1" colspan