2854</pub-id></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Amin</surname><given-names>A</given-names></name><name><surname>Cohendet</surname><given-names>P</given-names></name></person-group><source>Architectures of knowledge</source><year>2004</year><publisher-name>Oxford: Oxford University Press</publisher-name></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Nonaka</surname><given-names>I</given-names></name><name><surname>Takeuchi</surname><given-names>H</given-names></name></person-group><source>The knowledge-creating company</source><year>1995</year><publisher-name>New York, Oxford University Press</publisher-name></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Elliott</surname><given-names>S</given-names></name><name><surname>O'Loughlin</surname><given-names>J</given-names></name><name><surname>Robinson</surname><given-names>K</given-names></name><name><surname>Eyles</surname><given-names>J</given-names></name><name><surname>Cameron</surname><given-names>R</given-names></name><name><surname>Harvey</surname><given-names>D</given-names></name><name><surname>Raine</surname><given-names>K</given-names></name><name><surname>Gelskey</surname><given-names>D</given-names></name></person-group><article-title>Conceptualizing Dissemination Research and Activity: The Case of the Canadian Heart Health Initiative</article-title><source>Health Education Behavior</source><year>2003</year><volume>30</volume><fpage>267</fpage><lpage>282</lpage><pub-id pub-id-type="doi">10.1177/1090198103030003003</pub-id></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Yanow</surname><given-names>D</given-names></name></person-group><source>Conducting Interpretive Policy Analysis</source><year>2000</year><publisher-name>Thousand Oaks, CA, Sage Publications</publisher-name></citation></ref><ref id="B16"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Patton</surname><given-names>MQ</given-names></name></person-group><source>Qualitative Research &#x00026; Evaluation Methods</source><year>2002</year><edition>3</edition><publisher-name>Thousand Oaks, CA, Sage Publications</publisher-name></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Miles</surname><given-names>MB</given-names></name><name><surname>Huberman</surname><given-names>AM</given-names></name></person-group><source>Qualitative Data Analysis</source><year>1994</year><edition>2</edition><publisher-name>Thousand Oaks, CA, Sage Publications</publisher-name></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Creswell</surname><given-names>JW</given-names></name></person-group><source>Research Design: Qualitative, Quantitative, and Mixed Methods Approaches</source><year>2003</year><edition>2</edition><publisher-name>Thousand Oaks, CA, Sage Publications</publisher-name></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><collab>WHO</collab></person-group><source>Declaration of Alma-Ata International Conference on Primary Health Care</source><year>1978</year><publisher-name>Alma-Ata, USSR, World Health Organization</publisher-name></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Legowski</surname><given-names>B</given-names></name><name><surname>McKay</surname><given-names>L</given-names></name></person-group><source>Health beyond Health Care: Twenty five years of Federal Health Policy Development</source><year>2000</year><publisher-name>Ottawa, Canadian Policy Research Networks</publisher-name></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><collab>WHO</collab></person-group><source>The Jakarta Declaration on Leading Health Promotion into the 21st Century The Fourth International Conference on Health Promotion: New Players for a New Era -Leading Health Promotion into the 21st Century</source><year>1997</year><publisher-name>Jakarta, Indonesia, World Health Organization</publisher-name></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Grundy</surname><given-names>S</given-names></name></person-group><article-title>Primary prevention of coronary heart disease</article-title><source>Circulation</source><year>1998</year><volume>97</volume><fpage>1876</fpage><lpage>1887</lpage><pub-id pub-id-type="pmid">9603549</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kannel</surname><given-names>W</given-names></name></person-group><article-title>Fifty years of the Framlington study contributions to understanding hypertension</article-title><source>Hypertension</source><year>2000</year><volume>18</volume><fpage>S13</fpage><lpage>S20</lpage></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Stamler</surname><given-names>J</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Marmot M, Elliott P</surname></name></person-group><article-title>Establishing major coronary risk factors</article-title><source>Coronary heart disease epidemiology</source><year>1992</year><publisher-name>New York: Oxford University Press</publisher-name></citation></ref><ref id="B25"><citation citation-type="other"><person-group person-group-type="author"><collab>Health Canada</collab></person-group><source>Victoria Declaration on heart health International Heart Health Conference, Victoria, Canada</source><year>1992</year></citation></ref><ref id="B26"><citation citation-type="other"><person-group person-group-type="author"><collab>Autonomous Government of Catalonia, Department of Health and Security</collab></person-group><source>Catalonia Declaration: Investing in Heart Health International Heart Health Conference, Barcelona, Spain</source><year>1995</year></citation></ref><ref id="B27"><citation citation-type="other"><person-group person-group-type="author"><collab>Singapore National Heart Association</collab></person-group><source>Singapore Declaration: Forging the Will for Heart Health in the Next Millennium International Heart Health Conference, Singapore</source><year>1998</year></citation></ref><ref id="B28"><citation citation-type="other"><source>Osaka Declaration: health, economics and political action: stemming the global tide of cardiovascular disease Fourth International Heart Health Conference, Osaka, Japan</source><year>2001</year></citation></ref><ref id="B29"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Puska</surname><given-names>P</given-names></name><name><surname>Tuomilehto</surname><given-names>J</given-names></name><name><surname>Nissinen</surname><given-names>A</given-names></name><name><surname>Vartiainen</surname><given-names>E</given-names></name></person-group><source>The North Karelia Project: 20 year results and experiences</source><year>1995</year><publisher-name>Helsinki University Printing House, Helsinki</publisher-name></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Farquhar</surname><given-names>J</given-names></name><name><surname>Fortmann</surname><given-names>SP</given-names></name><name><surname>Flora</surname><given-names>JA</given-names></name><name><surname>Taylor</surname><given-names>CB</given-names></name><name><surname>Haskell</surname><given-names>WL</given-names></name><name><surname>Williams</surname><given-names>PT</given-names></na