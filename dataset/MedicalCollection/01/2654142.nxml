"left" rowspan="1" colspan="1">0067<xref ref-type="table-fn" rid="nt103">b</xref></td><td align="left" rowspan="1" colspan="1">transcriptional regulator LytR family</td><td align="left" rowspan="1" colspan="1">21.08</td></tr><tr><td align="left" rowspan="1" colspan="1">0068<xref ref-type="table-fn" rid="nt103">b</xref></td><td align="left" rowspan="1" colspan="1">hypothetical protein</td><td align="left" rowspan="1" colspan="1">8.71</td></tr><tr><td align="left" rowspan="1" colspan="1">0069<xref ref-type="table-fn" rid="nt103">b</xref></td><td align="left" rowspan="1" colspan="1">polysaccharide capsule synthesis protein</td><td align="left" rowspan="1" colspan="1">22.30</td></tr><tr><td align="left" rowspan="1" colspan="1">0070<xref ref-type="table-fn" rid="nt103">b</xref></td><td align="left" rowspan="1" colspan="1">hypothetical protein</td><td align="left" rowspan="1" colspan="1">13.21</td></tr><tr><td align="left" rowspan="1" colspan="1">0071<xref ref-type="table-fn" rid="nt103">b</xref></td><td align="left" rowspan="1" colspan="1">glycosyl transferase WecB/TagA/CpsF family</td><td align="left" rowspan="1" colspan="1">11.79</td></tr><tr><td align="left" rowspan="1" colspan="1">0072<xref ref-type="table-fn" rid="nt103">b</xref></td><td align="left" rowspan="1" colspan="1"><italic>wzy</italic>; polysaccharide polymerase</td><td align="left" rowspan="1" colspan="1">9.07</td></tr><tr><td align="left" rowspan="1" colspan="1">0073<xref ref-type="table-fn" rid="nt103">b</xref></td><td align="left" rowspan="1" colspan="1">glycosyl transferase group 2 family protein</td><td align="left" rowspan="1" colspan="1">15.82</td></tr><tr><td align="left" rowspan="1" colspan="1">0075</td><td align="left" rowspan="1" colspan="1">first of two overlapping orfs with similarity to IS3 genes</td><td align="left" rowspan="1" colspan="1">10.51</td></tr><tr><td align="left" rowspan="1" colspan="1">0076</td><td align="left" rowspan="1" colspan="1">transposase</td><td align="left" rowspan="1"