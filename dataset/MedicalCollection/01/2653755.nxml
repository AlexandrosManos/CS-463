><article-title>The presence of a systemic inflammatory response predicts poorer survival in patients receiving adjuvant 5-FU chemotherapy following potentially curative resection for colorectal cancer</article-title><source>Br J Cancer</source><year>2006</year><volume>94</volume><supplement>12</supplement><fpage>1833</fpage><lpage>1836</lpage><!--PubMed citation query: 'Br J Cancer||94|1833||bib6|'--><pub-id pub-id-type="pmid">16721360</pub-id></citation></ref><ref id="bib7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Du Klos</surname><given-names>TW</given-names></name><name><surname>Mold</surname><given-names>C</given-names></name></person-group><article-title>C-reactive protein: an activator of innate immunity and a modulator of adaptive immunity</article-title><source>Immunol Res</source><year>2004</year><volume>30</volume><supplement>3</supplement><fpage>261</fpage><lpage>277</lpage><!--PubMed citation query: 'Immunol Res||30|261||bib7|'--><pub-id pub-id-type="pmid">15531769</pub-id></citation></ref><ref id="bib8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dukes</surname><given-names>CE</given-names></name><name><surname>Bussey</surname><given-names>HJR</given-names></name></person-group><article-title>The spread of rectal cancer and its effect on prognosis</article-title><source>Br J Cancer</source><year>1958</year><volume>12</volume><fpage>309</fpage><lpage>320</lpage><!--PubMed citation query: 'Br J Cancer||12|309||bib8|'--><pub-id pub-id-type="pmid">13596482</pub-id></citation></ref><ref id="bib9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Forrest</surname><given-names>LM</given-names></name><name><surname>McMillan</surname><given-names>DC</given-names></name><name><surname>McArdle</surname><given-names>CS</given-names></name><name><surname>Angerson</surname><given-names>WJ</given-names></name><name><surname>Dunlop</su