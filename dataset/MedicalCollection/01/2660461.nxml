d pub-id-type="pmid">9488525</pub-id></citation></ref><ref id="B12"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gruessner</surname><given-names>RW</given-names></name><name><surname>Sutherland</surname><given-names>DE</given-names></name><name><surname>Kandaswamy</surname><given-names>R</given-names></name><name><surname>Gruessner</surname><given-names>AC</given-names></name></person-group>:<article-title>Over 500 solitary pancreas transplants in nonuremic patients with brittle diabetes mellitus</article-title>.<source><italic>Transplantation</italic></source><volume>85</volume>:<fpage>42</fpage>&#x02013;<lpage>47</lpage>,<year>2008</year><pub-id pub-id-type="pmid">18192910</pub-id></citation></ref></ref-list></back></article>