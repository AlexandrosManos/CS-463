-id-type="pmid">10926298</pub-id><pub-id pub-id-type="doi">10.1203/00006450-200008000-00016</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cleare</surname><given-names>AJ</given-names></name></person-group><article-title>The neuroendocrinology of chronic fatigue syndrome</article-title><source>Endocr Rev</source><year>2003</year><volume>24</volume><fpage>236</fpage><lpage>252</lpage><pub-id pub-id-type="pmid">12700181</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fulcher</surname><given-names>KY</given-names></name><name><surname>White</surname><given-names>PD</given-names></name></person-group><article-title>Strength and physiological response to exercise in patients with chronic fatigue syndrome</article-title><source>J Neurol Neurosurg Psychiatry</source><year>2000</year><volume>69</volume><fpage>302</fpage><lpage>307</lpage><pub-id pub-id-type="pmid">10945803</pub-id><pub-id pub-id-type="doi">10.1136/jnnp.69.3.302</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schillings</surname><given-names>ML</given-names></name><name><surname>Kalkman</surname><given-names>JS</given-names></name><name><surname>Werf</surname><given-names>SP van der</given-names></name><name><surname>van Engelen</surname><given-names>BG</given-names></name><name><surname>Bleijenberg</surname><given-names>G</given-names></name><name><surname>Zwarts</surname><given-names>MJ</given-names></name></person-group><article-title>Diminished central activation during maximal voluntary contraction in chronic fatigue syndrome</article-title><source>Clin Neurophysiol</source><year>2004</year><volume>115</volume><fpage>2518</fpage><lpage>2524</lpage><pub-id pub-id-type="pmid">15465441</pub-id><pub-id pub-id-type="doi">10.1016/j.clinph.2004.06.007</pub-id></citation>