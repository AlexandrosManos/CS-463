ion citation-type="journal"><person-group person-group-type="author"><name><surname>Gong</surname><given-names>P.</given-names></name><name><surname>Guan</surname><given-names>X.</given-names></name><name><surname>Inouye</surname><given-names>L.S.</given-names></name><name><surname>Deng</surname><given-names>Y.</given-names></name><name><surname>Pirooznia</surname><given-names>M.</given-names></name><name><surname>Perkins</surname><given-names>E.J.</given-names></name></person-group><article-title>Transcriptomic analysis of RDX and TNT interactive sublethal effects in the earthworm <italic>Eisenia fetida</italic></article-title><source>BMC Genomics</source><volume>9</volume><issue>Suppl. 1</issue><year>2008</year><fpage>S15</fpage><ext-link ext-link-type="uri" xlink:href="http://dx.doi.org/doi:10.1186/1471-2164-9-S1-S15">doi:10.1186/1471-2164-9-S1-S15</ext-link><pub-id pub-id-type="pmid">18366604</pub-id></citation></ref><ref id="bib20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gould</surname><given-names>S.J.</given-names></name></person-group><article-title>Nonmoral nature</article-title><source>Nat. Hist</source><volume>91</volume><year>1982</year><fpage>19</fpage><lpage>26</lpage></citation></ref><ref id="bib21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hale</surname><given-names>C.M.</given-names></name><name><surname>Frelich</surname><given-names>L.E.</given-names></name><name><surname>Reich</surname><given-names>P.B.</given-names></name></person-group><article-title>Exotic European earthworm invasion dynamics in northern forests of Minnesota, USA</article-title><source>Ecol. Appl</source><volume>15</volume><year>2005</year><fpage>848</fpage><lpage>860</lpage><ext-link ext-link-type="uri" xlink:href="http://dx.doi.org/doi:10.1890/03-5345">doi:10.1890/03-5345</ext-link></citation></ref><ref id="bib22"><citation citation-type="journal"><person-group person-group-type=