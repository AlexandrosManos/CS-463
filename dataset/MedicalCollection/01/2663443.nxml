n="1">Lercanidipine 20 mg vs amlodipine 10 mg or nifedipine GITS 60 mg</td><td align="left" rowspan="1" colspan="1">2 months</td><td align="left" rowspan="1" colspan="1">39.7 vs 57.3</td></tr><tr><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b13-vhrm-4-1159">Burnier 2007</xref></td><td align="left" rowspan="1" colspan="1">2199</td><td align="left" rowspan="1" colspan="1">Observational, non-interventional</td><td align="left" rowspan="1" colspan="1">Lercanidipine 10 mg/20 mg; mono, step on, or substitution therapy</td><td align="left" rowspan="1" colspan="1">2 months</td><td align="left" rowspan="1" colspan="1">0.6&#x02013;3</td></tr><tr><td align="left" rowspan="1" colspan="1">ELYPSE 2002</td><td align="left" rowspan="1" colspan="1">9059</td><td align="left" rowspan="1" colspan="1">Observational</td><td align="left" rowspan="1" colspan="1">Lercanidipine 10 mg</td><td align="left" rowspan="1" colspan="1">3 months</td><td align="left" rowspan="1" colspan="1">1.2</td></tr><tr><td align="left" rowspan="1" colspan="1">COHORT 2002</td><td align="left" rowspan="1" colspan="1">828</td><td align="left" rowspan="1" colspan="1">Prospective, randomized, double blind</td><td align="left" rowspan="1" colspan="1">Lercanidipine 10 mg vs amlodipine 5 mg vs lacidipine 2 mg</td><td align="left" rowspan="1" colspan="1">12 months</td><td align="left" rowspan="1" colspan="1">9 vs 19 vs 4</td></tr></tbody></table><table-wrap-foot><fn id="tfn3-vhrm-4-1159"><label>a</label><p>Studies were selected by performing a Pubmed query with &#x0201c;lercanidipine&#x0201d;, &#x0201c;adherence&#x0201d;, &#x0201c;compliance&#x0201d; and &#x0201c;tolerability&#x0201d; as search terms.</p></fn></table-wrap-foot></table-wrap><table-wrap id="t3-vhrm-4-1159" position="float"><label>Table 3</label><caption><p>Lercanidipine and its efficacy in combination therapy</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1">Study</th><th align="left" rowspan="1" colspan="1">Pts (n)</th><th align="left" rowspan="1" colspan="1">Hypertensive patient category</th><th align="left" rowspan="1" colspan="1">Type of study</th><th align="left" rowspan="1" colspan="1">Treatment</th><th align="left" rowspan="1" colspan="1">Duration</th><th align="left" rowspan="1" colspan="1">Mean blood pressure (BP) difference (mmHg)</th><th align="left" rowspan="1" colspan="1">Remarks</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b2-vhrm-4-1159">Agrawal 2006</xref></td><td align="left" rowspan="1" colspan="1">174</td><td align="left" rowspan="1" colspan="1">Diabetes type 1 or 2 (age 18&#x02013;80)</td><td align="left" rowspan="1" colspan="1">Randomized double blind</td><td align="left" rowspan="1" colspan="1">Enalapril 20 mg + lercanidipine add-on vs enalapril 20 mg + hydrochlorothiazide add-on</td><td align="left" rowspan="1" colspan="1">20 weeks</td><td align="left" rowspan="1" colspan="1">&#x02212;9.3 vs &#x02212;7.4</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b18-vhrm-4-1159">Cleophas 2001</xref></td><td align="left" rowspan="1" colspan="1">34</td><td align="left" rowspan="1" colspan="1">Diabetes type 2</td><td align="left" rowspan="1" colspan="1">Open label</td><td align="left" rowspan="1" colspan="1">ACE-inhibitor + lercanidipine vs ACE-inhibitor + metoprolol</td><td align="left" rowspan="1" colspan="1">6 months</td><td align="left" rowspan="1" colspan="1">&#x02212;6 &#x000b1; 10</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b24-vhrm-4-1159">Grandi 2008</xref></td><td align="left" rowspan="1" colspan="1">24</td><td align="left" rowspan="1" colspan="1">Never treated hypertension</td><td align="left" rowspan="1" colspan="1">Randomized pilot study</td><td align="left" rowspan="1" colspan="1">Ramipril + candesartan vs ramipril + lercanidipine</td><td align="left" rowspan="1" colspan="1">6 months</td><td align="left" rowspan="1" colspan="1">&#x02212;13.3 vs &#x02212;12.3</td><td align="left" rowspan="1" colspan="1">Less ventricular remodeling in lercanidipine group</td></tr><tr><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b45-vhrm-4-1159">Puig 2007</xref></td><td align="left" rowspan="1" colspan="1">75</td><td align="left" rowspan="1" colspan="1">Elderly (aged 60&#x02013;85)</td><td align="left" rowspan="1" colspan="1">Randomized double blind</td><td align="left" rowspan="1" colspan="1">Lercanidipine 10 mg vs enalapril20 mg vs combination of the two vs placebo</td><td align="left" rowspan="1" colspan="1">4 months</td><td align="left" rowspan="1" colspan="1">&#x02212;5.0 vs &#x02212;5.9 vs &#x02212;16.9 compared with placebo</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b43-vhrm-4-1159">Poncelet 2004</xref> AGATE study</td><td align="left" rowspan="1" colspan="1">756</td><td align="left" rowspan="1" colspan="1">Age &#x0003e; 65 vs age &#x0003c; 65</td><td align="left" rowspan="1" colspan="1">Open study</td><td align="left" rowspan="1" colspan="1">Lercanidipine alone (10&#x02013;20 mg) or lercanidipine in combination (not specified)</td><td align="left" rowspan="1" colspan="1">6 weeks</td><td align="left" rowspan="1" colspan="1">&#x02212;8 to &#x02212;11</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b26-vhrm-4-1159">Guillen 2003</xref></td><td align="left" rowspan="1" colspan="1">1562</td><td align="left" rowspan="1" colspan="1">Never treated hypertension</td><td align="left" rowspan="1" colspan="1">Observational, prospective</td><td align="left" rowspan="1" colspan="1">Lercanidipine alone; enalapril20 mg added after 1 month if BP was not controlled (38%)</td><td align="left" rowspan="1" colspan="1">6 months</td><td align=