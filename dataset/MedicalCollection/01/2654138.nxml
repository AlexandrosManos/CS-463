id="b13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cremin</surname><given-names>&#x000cd;</given-names></name><name><surname>Mushati</surname><given-names>P</given-names></name><name><surname>Hallett</surname><given-names>TB</given-names></name><etal/></person-group> <article-title>Measuring trends in age at first sex and age at marriage in Manicaland, Zimbabwe.</article-title><source>Sex Transm Infect</source><comment>2009;<bold>85</bold>(Suppl I)</comment>:<fpage>i34</fpage>&#x02013;<lpage>i40</lpage></citation></ref><ref id="b14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McGrath</surname><given-names>N</given-names></name><name><surname>Nyirenda</surname><given-names>M</given-names></name><name><surname>Hosegood</surname><given-names>V</given-names></name><etal/></person-group> <article-title>Age at first sex in rural South Africa.</article-title><source>Sex Transm Infect</source><comment>2009;<bold>85</bold>(Suppl I)</comment>:<fpage>i49</fpage>&#x02013;<lpage>i55</lpage></citation></ref><ref id="b15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Budlender</surname><given-names>D</given-names></name><name><surname>Choboloane</surname><given-names>N</given-names></name><name><surname>Simelane</surname><given-names>S</given-names></name></person-group> <article-title>Marriage patterns in South Africa: methodological and substantive issues.</article-title><source>S Afr J Demogr</source><year>2005</year>;<volume>9</volume>:<fpage>1</fpage>&#x02013;<lpage>25</lpage></citation></ref><ref id="b16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marston</surname><given-names>M</given-names></name><name><surname>Slaymaker</surname><given-names>E</given-names></name><name><surname>Cremin</surname><given-names>&#x000cd;</given-