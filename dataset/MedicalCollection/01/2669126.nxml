ticle-title>Long-term response toward inorganic carbon limitation in wild type and glycolate turnover mutants of the cyanobacterium <italic>Synechocystis</italic> sp. strain PCC 6803.</article-title><source>Plant Physiol</source><volume>144</volume><fpage>1946</fpage><lpage>1959</lpage><pub-id pub-id-type="pmid">17600135</pub-id></citation></ref><ref id="pone.0005331-Hihara1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hihara</surname><given-names>Y</given-names></name><name><surname>Kamei</surname><given-names>A</given-names></name><name><surname>Kanehisa</surname><given-names>M</given-names></name><name><surname>Kaplan</surname><given-names>A</given-names></name><name><surname>Ikeuchi</surname><given-names>M</given-names></name></person-group><year>2001</year><article-title>DNA microarray analysis of cyanobacterial gene expression during acclimation to high light.</article-title><source>Plant Cell</source><volume>13</volume><fpage>793</fpage><lpage>806</lpage><pub-id pub-id-type="pmid">11283337</pub-id></citation></ref><ref id="pone.0005331-Huang1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>L</given-names></name><name><surname>McCluskey</surname><given-names>MP</given-names></name><name><surname>Ni</surname><given-names>H</given-names></name><name><surname>LaRossa</surname><given-names>RA</given-names></name></person-group><year>2002</year><article-title>Global gene expression profiles of the cyanobacterium <italic>Synechocystis</italic> sp. strain PCC 6803 in response to irradiation with UV-B and white light.</article-title><source>J Bacteriol</source><volume>184</volume><fpage>6845</fpage><lpage>6858</lpage><pub-id pub-id-type="pmid">12446635</pub-id></citation></ref><ref id="pone.0005331-Li1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Li</surname