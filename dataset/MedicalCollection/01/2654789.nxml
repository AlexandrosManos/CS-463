                                  <mml:mrow>                                             <mml:msub>                                                <mml:mtext>O</mml:mtext>                                                <mml:mrow>                                                   <mml:mn>2</mml:mn>                                                   <mml:mo stretchy="false">(</mml:mo>                                                   <mml:mi>g</mml:mi>                                                   <mml:mo stretchy="false">)</mml:mo>                                                </mml:mrow>                                             </mml:msub>                                          </mml:mrow>                                       </mml:msub>                                       <mml:mo>&#x02212;</mml:mo>                                       <mml:mn>64.933</mml:mn>                                       <mml:mi>log</mml:mi>                                       <mml:mo>&#x02061;</mml:mo>                                       <mml:msub>                                          <mml:mi>a</mml:mi>                                          <mml:mrow>                                             <mml:mtext>H</mml:mtext>                                             <mml:mo>+</mml:mo>                                          </mml:mrow>                                       </mml:msub>                                    </mml:mrow>                                 </mml:mtd>                              </mml:mtr>                           </mml:mtable>                        </mml:mrow>                                             </mml:semantics>                  </mml:math></disp-formula></p><p>where <inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M50" name="1467-4866-9-10-i30" overflow="scroll"><mml:semantics><mml:mover accent="true"><mml:mi>A</mml:mi><mml:mo>&#x000af;</mml:mo></mml:mover></mml:semantics></mml:math></inline-formula><sub>16