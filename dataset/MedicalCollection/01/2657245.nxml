ation></ref><ref id="CR6"><label>6.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Knill</surname><given-names>RL</given-names></name></person-group><article-title>Difficult laryngoscopy made easy with a &#x0201c;BURP&#x0201d;</article-title><source>Can J Anaesth</source><year>1993</year><volume>40</volume><fpage>279</fpage><lpage>282</lpage><pub-id pub-id-type="pmid">8467551</pub-id></mixed-citation></ref><ref id="CR7"><label>7.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Schuler</surname><given-names>J</given-names></name><name><surname>Maier</surname><given-names>B</given-names></name><name><surname>Behrens</surname><given-names>S</given-names></name><name><surname>Thimme</surname><given-names>W</given-names></name></person-group><article-title>Present treatment of acute myocardial infarction in patients over 75&#x000a0;years&#x02014;data from the Berlin Myocardial Infarction Registry (BHIR)</article-title><source>Clin Res Cardiol</source><year>2006</year><volume>95</volume><fpage>360</fpage><lpage>367</lpage><pub-id pub-id-type="doi">10.1007/s00392-006-0393-8</pub-id><pub-id pub-id-type="pmid">16741630</pub-id></mixed-citation></ref><ref id="CR8"><label>8.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Engelter</surname><given-names>ST</given-names></name><name><surname>Reichhart</surname><given-names>M</given-names></name><name><surname>Sekoranja</surname><given-names>L</given-names></name><name><surname>Georgiadis</surname><given-names>D</given-names></name><name><surname>Baumann</surname><given-names>A</given-names></name><etal/></person-group><article-title>Thrombolysis in stroke patients aged 80&#x000a0;years and older: Swiss survey of IV thrombolysis</article-title><source>Neurology</source><year>2005</year><volume>65</volume><fpage>1795</fpage><lpage>1798</lpage><pub-id pub-id-type="doi">10.1212/01.wnl.0000183702.04080.27</pub-id><pub-id pub-id-type="pmid">16221951</pub-id></mixed-citation></ref><ref id="CR9"><label>9.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Alter</surname><given-names>DA</given-names></name><name><surname>Manuel</surname><given-names>DG</given-names></name><name><surname>Gunraj</surname><given-names>N</given-names></name><name><surname>Anderson</surname><given-names>G</given-names></name><name><surname>Naylor</surname><given-names>CD</given-names></name><name><surname>Laupacis</surname><given-names>A</given-names></name></person-group><article-title>Age, risk-benefit trade-offs, and the projected effects of evidence-based therapies</article-title><source>Am J Med</source><year>2004</year><volume>116</volume><fpage>540</fpage><lpage>545</lpage><pub-id pub-id-type="doi">10.1016/j.amjmed.2003.10.039</pub-id><pub-id pub-id-type="pmid">15063816</pub-id></mixed-citation></ref><ref id="CR10"><label>10.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Yanagawa</surname><given-names>Y</given-names></name><name><surname>Sakamoto</surname><given-names>T</given-names></name><name><surname>Okada</surname><given-names>Y</given-names></name><name><surname>Tuzuki</surname><given-names>N</given-names></name><name><surname>Katoh</surname><given-names>H</given-names></name><etal/></person-group><article-title>Intubation without premedication may worsen outcome for unconsciousness patients with intracranial hemorrhage</article-title><source>Am J Emerg Med</source><year>2005</year><volume>23</volume><fpage>182</fpage><lpage>185</lpage><pub-id pub-id-type="doi">10.1016/j.ajem.2004.01.009</pub-id><pub-id pub-id-type="pmid">15765341</pub-id></mixed-citation></ref></ref-list><fn-group><fn><p>Disclaimer: The views expressed in this paper are those of the author(s) and not those of the editors, editorial board or publisher.</p></fn></fn-group></back></article>