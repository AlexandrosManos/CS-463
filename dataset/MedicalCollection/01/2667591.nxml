id="B10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Thomas</surname><given-names>E</given-names></name><name><surname>Cyteval</surname><given-names>C</given-names></name><name><surname>Abiad</surname><given-names>L</given-names></name><name><surname>Picot</surname><given-names>MC</given-names></name><name><surname>Taourel</surname><given-names>P</given-names></name><name><surname>Blotman</surname><given-names>F</given-names></name></person-group><article-title>Efficacy of transforaminal versus interspinous corticosteroid injection in discal radiculalgia - a prospective, randomized, double-blind study</article-title><source>Clin Rheumatol</source><year>2003</year><volume>22</volume><fpage>299</fpage><lpage>304</lpage><pub-id pub-id-type="pmid">14579160</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Manchikanti</surname><given-names>L</given-names></name><name><surname>Pakanati</surname><given-names>R</given-names></name><name><surname>Pampati</surname><given-names>V</given-names></name></person-group><article-title>Comparison of three routes of epidural steroid injections in low back pain</article-title><source>Pain Dig</source><year>1999</year><volume>9</volume><fpage>277</fpage><lpage>285</lpage></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wilson-MacDonald</surname><given-names>J</given-names></name><name><surname>Burt</surname><given-names>G</given-names></name><name><surname>Griffin</surname><given-names>D</given-names></name><name><surname>Glynn</surname><given-names>C</given-names></name></person-group><article-title>Epidural steroid injection for nerve root compression. A randomised, controlled trial</article-title><source>J Bone Joint Surg Br</source><year>200