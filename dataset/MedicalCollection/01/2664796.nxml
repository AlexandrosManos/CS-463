name><surname>Ford</surname><given-names>D</given-names></name><name><surname>Hsu</surname><given-names>F</given-names></name><name><surname>Garcia</surname><given-names>R</given-names></name><name><surname>Herrero</surname><given-names>P</given-names></name><name><surname>Saffitz</surname><given-names>J</given-names></name><name><surname>Schaffer</surname><given-names>J</given-names></name></person-group><article-title>A novel mouse model of lipotoxic cardiomyopathy</article-title><source>J Clin Invest</source><year>2001</year><volume>107</volume><fpage>813</fpage><lpage>822</lpage><pub-id pub-id-type="pmid">11285300</pub-id><pub-id pub-id-type="doi">10.1172/JCI10947</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rijzewijk</surname><given-names>LJvdMR</given-names></name><name><surname>Smit</surname><given-names>JW</given-names></name><name><surname>Diamant</surname><given-names>M</given-names></name><name><surname>Bax</surname><given-names>JJ</given-names></name><name><surname>Hammer</surname><given-names>S</given-names></name><name><surname>Romijn</surname><given-names>JA</given-names></name><name><surname>de Roos</surname><given-names>A</given-names></name><name><surname>Lamb</surname><given-names>HJ</given-names></name></person-group><article-title>Myocardial steatosis is an independent predictor of diastolic dysfunction in type 2 diabetes mellitus</article-title><source>J Am Coll Cardiol</source><year>2008</year><volume>52</volume><fpage>1793</fpage><lpage>1799</lpage><pub-id pub-id-type="pmid">19022158</pub-id><pub-id pub-id-type="doi">10.1016/j.jacc.2008.07.062</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schaffer</surname><given-names>J</given-names></name></person-group><article-title>Lipotoxicity: when tissues overeat</article-title><source>Curr Opin Lipidol</source><year>2003</year><volume>1