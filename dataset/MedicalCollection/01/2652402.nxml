ced></mml:mfenced><mml:mrow><mml:mn>1</mml:mn><mml:mo>&#x02212;</mml:mo><mml:mi mathvariant="italic">y0i</mml:mi></mml:mrow></mml:msup></mml:mrow></mml:mfrac></mml:mrow></mml:mtd></mml:mtr></mml:mtable></mml:mrow></mml:math></disp-formula>                </p><p>Replace the missing value <italic>c<sub>i</sub></italic>  by                  <mml:math id="apq"><mml:mrow><mml:msup><mml:msub><mml:mover><mml:mi mathvariant="italic">&#x003c9;</mml:mi><mml:mo>&#x000af;</mml:mo></mml:mover><mml:mi>i</mml:mi></mml:msub><mml:mfenced open="(" close=")"><mml:mi>t</mml:mi></mml:mfenced></mml:msup></mml:mrow></mml:math> in the log-likelihood function with the complete data and then in the M-step, we maximize</p><p>                    <mml:math id="appen7"><mml:mrow><mml:mtable rowalign="center"><mml:mtr><mml:mtd><mml:mtable rowalign="center"><mml:mtr><mml:mtd><mml:mrow><mml:msup><mml:mi>Q</mml:mi><mml:mfenced open="(" close=")"><mml:mi>t</mml:mi></mml:mfenced></mml:msup><mml:mo>=</mml:mo></mml:mrow></mml:mtd><mml:mtd><mml:mrow><mml:mo>&#x02212;</mml:mo><mml:mrow><mml:munderover><mml:mo>&#x02211;</mml:mo><mml:mrow><mml:mi>i</mml:mi><mml:mo>=</mml:mo><mml:mn>1</mml:mn></mml:mrow><mml:msub><mml:mi>n</mml:mi><mml:mn>1</mml:mn></mml:msub></mml:munderover><mml:mrow><mml:mfenced open="[" close="]"><mml:mrow><mml:mn>1</mml:mn><mml:mo>+</mml:mo><mml:mi mathvariant="italic">exp</mml:mi><mml:mfenced open="(" close=")"><mml:mrow><mml:mrow><mml:munderover><mml:mo>&#x02211;</mml:mo><mml:mrow><mml:mi>j</mml:mi><mml:mo>=</mml:mo><mml:mn>0</mml:mn></mml:mrow><mml:mi>p</mml:mi></mml:munderover><mml:msub><mml:mi mathvariant="italic">&#x003b2;</mml:mi><mml:mi>j</mml:mi></mml:msub></mml:mrow><mml:msub><mml:mi>x</mml:mi><mml:mrow><mml:mn>2</mml:mn><mml:mi mathvariant="italic">ij</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfenced></mml:mrow></mml:mfenced><mml:mo>+</mml:mo><mml:mrow><mml:munderover><mml:mo>&#x02211;</mml:mo><mml:mrow><mml:mi>i</mml:mi><mml:mo>=</mml:mo><mml:mn>1</mml:mn></mml:mrow><mml:msub><mml:mi>n</mml:mi><mml:mn>1</mml:mn></mml:msub></mml:munderover><mml:mi mathvariant="italic">y1i</mml:mi></mml:mrow><mml:mrow><mml:munderover><mml:mo>&#x02211;</mml:mo><mml:mrow><mml:mi>j</mml:mi><mml:mo>=</mml:mo><mml:mn>0</mml:mn></mml:mrow><mml:mi>p</mml:mi></mml:munderover><mml:mrow><mml:msub><mml:mi mathvariant="italic">&#x003b2;</mml:mi><mml:mi>j</mml:mi></mml:msub><mml:msub><mml:mi>x</mml:mi><mml:mrow><mml:mn>2</mml:mn><mml:mi mathvariant="italic">ij</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mrow></mml:mrow></mml:mrow></mml:mrow></mml:mtd></mml:mtr></mml:mtable></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mrow><mml:mo>+</mml:mo><mml:mrow><mml:munderover><mml:mo>&#x02211;</mml:mo><mml:mrow><mml:mi>i</mml:mi><mml:mo>=</mml:mo><mml:mn>1</mml:mn></mml:mrow><mml:mi mathvariant="italic">n0</mml:mi></mml:munderover><mml:mfenced open="{" close="}"><mml:mrow><mml:msubsup><mml:mover><mml:mi mathvariant="italic">&#x003c9;</mml:mi><mml:mo>&#x000af;</mml:mo></mml:mover><mml:mi>i</mml:mi><mml:mfenced open="(" close=")"><mml:mi>t</mml:mi></mml:mfenced></mml:msubsup><mml:mtext>log</mml:mtext><mml:mfenced open="[" close="]"><mml:mrow><mml:msubsup><mml:mi mathvariant="italic">&#x003c0;</mml:mi><mml:mrow><mml:mn>1</mml:mn><mml:mi>i</mml:mi></mml:mrow><mml:mi mathvariant="italic">y0i</mml:mi></mml:msubsup><mml:msup><mml:mfenced open="(" close=")"><mml:mrow><mml:mn>1</mml:mn><mml:mo>&#x02212;</mml:mo><mml:msub><mml:mi mathvariant="italic">&#x003c0;</mml:mi><mml:mrow><mml:mn>1</mml:mn><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfenced><mml:mrow><mml:mn>1</mml:mn><mml:mo>&#x02212;</mml:mo><mml:mi mathvariant="italic">y0i</mml:mi></mml:mrow></mml:msup></mml:mrow></mml:mfenced><mml:mo>+</mml:mo><mml:mfenced open="(" close=")"><mml:mrow><mml:mn>1</mml:mn><mml:mo>&#x02212;</mml:mo><mml:msubsup><mml:mover><mml:mi mathvariant="italic">&#x003c9;</mml:mi><mml:mo>&#x000af;</mml:mo></mml:mover><mml:mi>i</mml:mi><mml:mfenced open="(" close=")"><mml:mi>t</mml:mi></mml:mfenced></mml:msubsup></mml:mrow></mml:mfenced><mml:mtext>log</mml:mtext><mml:mfenced open="[" close="]"><mml:mrow><mml:msubsup><mml:mi mathvariant="italic">&#x003c0;</mml:mi><mml:mrow><mml:mn>0</mml:mn><mml:mi>i</mml:mi></mml:mrow><mml:mi mathvariant="italic">y0i</mml:mi></mml:msubsup><mml:msup><mml:mfenced open="(" close=")"><mml:mrow><mml:mn>1</mml:mn><mml:mo>&#x02212;</mml:mo><mml:msub><mml:mi mathvariant="italic">&#x003c0;</mml:mi><mml:mrow><mml:mn>0</mml:mn><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfenced><mml:mrow><mml:mn>1</mml:mn><mml:mo>&#x02212;</mml:mo><mml:mi mathvariant="italic">y0i</mml:mi></mml:mrow></mml:msup></mml:mrow></mml:mfenced></mml:mrow></mml:mfenced></mml:mrow></mml:mrow></mml:mtd></mml:mtr></mml:mtable></mml:mrow></mml:math>                </p><p>with respect to &#x003b2;. To do so, we can use the Newton-Raphson iteration method which needs the first and the second partial derivatives given below.</p><p>                    <mml:math id="appen4"><mml:mrow><mml:mtable rowalign="center"><mml:mtr><mml:mtd><mml:mrow><mml:mfrac><mml:mrow><mml:mo>&#x02202;</mml:mo><mml:msup><mml:mi>Q</mml:mi><mml:mfenced open="(" close=")"><mml:mi>t</mml:mi></mml:mfenced></mml:msup></mml:mrow><mml:mrow><mml:mo>&#x02202;</mml:mo><mml:msub><mml:mi mathvariant="italic">&#x003b2;</mml:mi><mml:mi>j</mml:mi></mml:msub></mml:mrow></mml:mfrac><mml:mo>=</mml:mo></mml:mrow></mml:mtd><mml:mtd><mml:mrow><mml:mo>&#x02212;</mml:mo><mml:mrow><mml:munderover><mml:mo>&#x02211;</mml:mo><mml:mrow><mml:mi>i</mml:mi><mml:mo>=</mml:mo><mml:mn>1</mml:mn></mml:mrow><mml:msub><mml:mi>n</mml:mi><mml:mn>1</mml:mn></mml:msub></mml:munderover><mml:mrow><mml:msub><mml:mi>x</mml:mi><mml:mrow><mml:mn>2</mml:mn><mml:mi mathvariant="italic">ij</mml:mi></mml:mrow></mml:msub><mml:msub><mml:mi mathvariant="italic">&#x003c0;</mml:mi><mml:mrow><mml:mn>2</mml:mn><mml:mi>i</mml:mi></mml:mrow></mml:msub><mml:mo>+</mml:mo><mml:mrow><mml:munderover><mml:mo>&#x02211;</mml:mo><mml:mrow><mml:mi>i</mml:mi><mml:mo>=</mml:mo><mml:mn>1</mml:mn></mml:mrow><mml:msub><mml:mi>n</mml:mi><mml:mn>1</mml:mn></mml:msub></mml:munderover><mml:mrow><mml:msub><mml:mi>y</mml:mi><mml:mi mathvariant="italic">li</mml:mi></mml:msub><mml:msub><mml:mi>x</mml:mi><mml:mrow><mml:mn>2</mml:mn><mml:mi mathvariant="italic">ij</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mrow><mml:mo>+</mml:mo><mml:mrow><mml:munderover><mml:mo>&#x02211;</mml:mo><mml:mrow><mml:mi>i</mml:mi><mml:mo>=</mml:mo><mml:mn>1</mml:mn></mml:mrow><mml:msub><mml:mi>n</mml:mi><mml:mn>0</mml:mn></mml:msub></mml:munderover><mml:mfenced open="[" close="]"><mml:mrow><mml:msub><mml:mi>x</mml:mi><mml:mrow><mml:mn>1</mml:mn><mml:mi mathvariant="italic">ij</mml:mi></mml:mrow></mml:msub><mml:msubsup><mml:mover><mml:mi mathvariant="italic">&#x003c9;</mml:mi><mml:mo>&#x000af;</mml:mo></mml:mover><mml:mrow><mml:mn>2</mml:mn><mml:mi>i</mml:mi></mml:mrow><mml:mfenced open="(" close=")"><mml:mi>t</mml:mi></mml:mfenced></mml:msubsup><mml:mfenced open="(" close=")"><mml:mrow><mml:msub><mml:mi>y</mml:mi><mml:mrow><mml:mn>0</mml:mn><mml:mi>i</mml:mi></mml:mrow></mml:msub><mml:mo>&#x02212;</mml:mo><mml:msub><mml:mi mathvariant="italic">&#x003c0;</mml:mi><mml:mrow><mml:mn>1</mml:mn><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfenced><mml:mo>+</mml:mo><mml:msub><mml:mi>x</mml:mi><mml:mrow><mml:mn>0</mml:mn><mml:mi mathvariant="italic">ij</mml:mi></mml:mrow></mml:msub><mml:msubsup><mml:mover><mml:mi mathvariant="italic">&#x003c9;</mml:mi><mml:mo>&#x000af;</mml:mo></mml:mover><mml:mi>i</mml:mi><mml:mfenced open="(" close=")"><mml:mi>t</mml:mi></mml:mfenced></mml:msubsup><mml:mfenced open="(" close=")"><mml:mrow><mml:msub><mml:mi>y</mml:mi><mml:mrow><mml:mn>0</mml:mn><mml:mi>i</mml:mi></mml:mrow></mml:msub><mml:mo>&#x02212;</mml:mo><mml:msub><mml:mi mathvariant="italic">&#x003c0;</mml:mi><mml:mrow><mml:mn>0</mml:mn><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfenced></mml:mrow></mml:mfenced></mml:mrow></mml:mrow></mml:mrow></mml:mrow></mml:mtd></mml:mtr><mml:mtr><mml:mtd><mml:mrow><mml:mfrac><mml:mrow><mml:msup><mml:mo>&#x02202;</mml:mo><mml:mn>2</mml:mn></mml:msup><mml:msup><mml:mi>Q</mml:mi><mml:mfenced open="(" close=")"><mml:mi>t</mml:mi></mml:mfenced></mml:msup></mml:mrow><mml:mrow><mml:mo>&#x02202;</mml:mo><mml:msub><mml:mi mathvariant="italic">&#x003b2;</mml:mi><mml:mi>j</mml:mi></mml:msub><mml:msub><mml:mi mathvariant="italic">&#x003b2;</mml:mi><mml:mi>k</mml:mi></mml:msub></mml:mrow></mml:mfrac><mml:mo>=</mml:mo></mml:mrow></mml:mtd><mml:mtd><mml:mrow><mml:mo>&#x02212;</mml:mo><mml:mrow><mml:munderover><mml:mo>&#x02211;</mml:mo><mml:mrow><mml:mi>i</mml:mi><mml:mo>=</mml:mo><mml:mn>1</mml:mn></mml:mrow><mml:msub><mml:mi>n</mml:mi><mml:mn>1</mml:mn></mml:msub></mml:munderover><mml:mrow><mml:msub><mml:mi>x</mml:mi><mml:mrow><mml:mn>2</mml:mn><mml:mi mathvariant="italic">ij</mml:mi></mml:mrow></mml:msub><mml:msub><mml:mi>x</mml:mi><mml:mrow><mml:mn>2</mml:mn><mml:mi mathvariant="italic">ik</mml:mi></mml:mrow></mml:msub><mml:msub><mml:mi mathvariant="italic">&#x003c0;</mml:mi><mml:mrow><mml:mn>2</mml:mn><mml:mi>i</mml:mi></mml:mrow></mml:msub><mml:mfenced open="(" close=")"><mml:mrow><mml:mn>1</mml:mn><mml:mo>&#x02212;</mml:mo><mml:msub><mml:mi mathvariant="italic">&#x003c0;</mml:mi><mml:mrow><mml:mn>2</mml:mn><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfenced><mml:mo>&#x02212;</mml:mo><mml:mrow><mml:munderover><mml:mo>&#x02211;</mml:mo><mml:mrow><mml:mi>i</mml:mi><mml:mo>=</mml:mo><mml:mn>1</mml:mn></mml:mrow><mml:msub><mml:mi>n</mml:mi><mml:mn>0</mml:mn></mml:msub></mml:munderover><mml:mfenced open="[" close="]"><mml:mrow><mml:msub><mml:mi>x</mml:mi><mml:mrow><mml:mn>1</mml:mn><mml:mi mathvariant="italic">ij</mml:mi></mml:mrow></mml:msub><mml:msub><mml:mi>x</mml:mi><mml:mrow><mml:mn>1</mml:mn><mml:mi mathvariant="italic">ik</mml:mi></mml:mrow></mml:msub><mml:msubsup><mml:mover><mml:mi mathvariant="italic">&#x003c9;</mml:mi><mml:mo>&#x000af;</mml:mo></mml:mover><mml:mi>i</mml:mi><mml:mfenced open="(" close=")"><mml:mi>t</mml:mi></mml:mfenced></mml:msubsup><mml:msub><mml:mi mathvariant="italic">&#x003c0;</mml:mi><mml:mrow><mml:mn>1</mml:mn><mml:mi>i</mml:mi></mml:mrow></mml:msub><mml:mfenced open="(" close=")"><mml:mrow><mml:mn>1</mml:mn><mml:mo>&#x02212;</mml:mo><mml:msub><mml:mi mathvariant="italic">&#x003c0;</mml:mi><mml:mrow><mml:mn>1</mml:mn><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfenced><mml:mo>+</mml:mo><mml:msub><mml:mi>x</mml:mi><mml:mrow><mml:mn>0</mml:mn><mml:mi mathvariant="italic">ij</mml:mi></mml:mrow></mml:msub><mml:msub><mml:mi>x</mml:mi><mml:mrow><mml:mn>0</mml:mn><mml:mi mathvariant="italic">ik</mml:mi></mml:mrow></mml:msub><mml:msubsup><mml:mover><mml:mi mathvariant="italic">&#x003c9;</mml:mi><mml:mo>&#x000af;</mml:mo></mml:mover><mml:mi>i</mml:mi><mml:mfenced open="(" close=")"><mml:mi>t</mml:mi></mml:mfenced></mml:msubsup><mml:msub><mml:mi mathvariant="italic">&#x003c0;</mml:mi><mml:mrow><mml:mn>0</mml:mn><mml:mi>i</mml:mi></mml:mrow></mml:msub><mml:mfenced open="(" close=")"><mml:mrow><mml:mn>1</mml:mn><mml:mo>&#x02212;</mml:mo><mml:msub><mml:mi mathvariant="italic">&#x003c0;</mml:mi><mml:mrow><mml:mn>0</mml:mn><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfenced></mml:mrow></mml:mfenced></mml:mrow></mml:mrow></mml:mrow></mml:mrow></mml:mtd></mml:mtr></mml:mtable></mml:mrow></mml:math>                </p><p>The Hessian matrix at the (<italic>t</italic>) th iteration is given by                       <mml:math id="Aeq5"><mml:mrow><mml:msup><mml:mi>H</mml:mi><mml:mfenced open="(" close=")"><mml:mi>t</mml:mi></mml:mfenced></mml:msup><mml:mo>=</mml:mo><mml:mfrac><mml:mrow><mml:msup><mml:mo>&#x02202;</mml:mo><mml:mn>2</mml:mn></mml:msup><mml:msup><mml:mi>Q</mml:mi><mml:mfenced open="(" close=")"><mml:mi>t</mml:mi></mml:mfenced></mml:msup></mml:mrow><mml:mrow><mml:mo>&#x02202;</mml:mo><mml:msub><mml:mi mathvariant="italic">&#x003b2;</mml:mi><mml:mi>j</mml:mi></mml:msub><mml:msub><mml:mi mathvariant="italic">&#x003b2;</mml:mi><mml:mi>k</mml:mi></mml:msub></mml:mrow></mml:mfrac></mml:mrow></mml:math>which leads to the updated parameters &#x003b2; at the (<italic>t</italic>+1) th iteration</p><p>                    <mml:math id="A2"><mml:mrow><mml:mtable rowalign="center"><mml:mtr><mml:mtd><mml:mrow><mml:msup><mml:mi mathvariant="normal">&#x003b2;</mml:mi><mml:mfenced open="(" close=")"><mml:mrow><mml:mi>t</mml:mi><mml:mo>+</mml:mo><mml:mn>1</mml:mn></mml:mrow></mml:mfenced></mml:msup><mml:mo>=</mml:mo></mml:mrow></mml:mtd><mml:mtd><mml:mrow><mml:msup><mml:mi mathvariant="normal">&#x003b2;</mml:mi><mml:mfenced open="(" close=")"><mml:mi>t</mml:mi></mml:mfenced></mml:msup><mml:mo>&#x02212;</mml:mo><mml:msup><mml:mfenced open="[" close="]"><mml:msup><mml:mi>H</mml:mi><mml:mfenced open="(" close=")"><mml:mi>t</mml:mi></mml:mfenced></mml:msup></mml:mfenced><mml:mrow><mml:mo>&#x02212;</mml:mo><mml:mn>1</mml:mn></mml:mrow></mml:msup><mml:msup><mml:mi>u</mml:mi><mml:mo>&#x02032;</mml:mo></mml:msup></mml:mrow></mml:mtd></mml:mtr></mml:mtable></mml:mrow></mml:math>                </p><p>Where <italic>u</italic> is a vector of first derivative of <italic>Q<sup>(t)</sup></italic>  with respect to <italic>&#x003b2;<sub>j</sub></italic> . The EM algorithm is repeated between Equation (A1) and (A2) until certain convergence criteria is satisfied. One of the by-product of using Newton-Raphson method is that we can easily obtain the standard errors of the estimated parameters through the Hessian matrix.</p></sec></app></app-group><ref-list><title>REFERENCES</title><ref id="R1"><label>1</label><citation citation-type="journal"><collab>The International HapMap Consortium</collab><article-title>The International HapMap Project</article-title><source> Nature</source><year>2003</year><volume>426</volume><fpage>789</fpage><lpage>794</lpage></citation></ref><ref id="R2"><label>2</label><citation citation-type="journal"><collab>The International HapMap Consortium</collab><article-title> The haplotype map of the human genome</article-title><source>Nature</source><year>2005</year><volume>437</volume><fpage>1299</fpage><lpage>1320</lpage><pub-id pub-id-type="pmid">16255080</pub-id></citation></ref><ref id="R3"><label>3</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Risch</surname><given-names>N</given-names></name><name><surname>Merikangas</surname><given-names>K</given-names></name></person-group><article-title>The future of genetic studies of complex human diseases</article-title><source>Science</source><year>1996</year><volume>273</volume><fpage>1516</fpage><lpage>1517</lpage><pub-id pub-id-type="pmid">8801636</pub-id></citation></ref><ref id="R4"><label>4</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Olson</surname><given-names>JM</given-names></name><name><surname>Wijsman</surname><given-names>EM</given-names></name></person-group><article-title>Design and sample size considerations in the detection of linkage disequilibrium with a marker locus</article-title><source>Am. J. Hum. Genet</source><year>1994</year><volume>55</volume><fpage>574</fpage><lpage>580</lpage><pub-id pub-id-type="pmid">8079996</pub-id></citation></ref><ref id="R5"><label>5</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Strittmatter</surname><given-names>WJ</given-names></name><name><surname>Roses</surname><given-names>AD</given-names></name></person-group><article-title>Apolipoprotein E and Alzheimer Disease</article-title><source>Proc. Natl. Acad. Sci. USA</source><year>1995</year><volume>92</volume><fpage>4725</fpage><lpage>4727</lpage><pub-id pub-id-type="pmid">7761390</pub-id></citation></ref><ref id="R6"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stram</surname><given-names>SO</given-names></name><name><surname>Pearce</surname><give