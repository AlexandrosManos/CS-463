></name></person-group><source>IEEE Trans Ind Appl</source><year>1994</year><volume>30</volume><fpage>835</fpage><lpage>843</lpage></citation></ref><ref id="B30"><citation citation-type="other"><person-group person-group-type="author"><name><surname>H&#x000f6;lzel</surname><given-names>R</given-names></name></person-group><source>J Electrostat</source><year>2002</year><volume>56</volume><fpage>435</fpage><lpage>447</lpage></citation></ref><ref id="B31"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Tuukkanen</surname><given-names>S</given-names></name><name><surname>Kuzyk</surname><given-names>A</given-names></name><name><surname>Toppari</surname><given-names>JJ</given-names></name><name><surname>H&#x000e4;kkinen</surname><given-names>H</given-names></name><name><surname>Hyt&#x000f6;nen</surname><given-names>VP</given-names></name><name><surname>Niskanen</surname><given-names>E</given-names></name><name><surname>Rinki&#x000f6;</surname><given-names>M</given-names></name><name><surname>T&#x000f6;rm&#x000e4;</surname><given-names>P</given-names></name></person-group><source>Nanotechnol</source><year>2007</year><volume>18</volume><fpage>295204</fpage></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>H&#x000f6;lzel</surname><given-names>R</given-names></name></person-group><source>Biochim Biophys Acta</source><year>1999</year><volume>1450</volume><fpage>53</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">10231555</pub-id></citation></ref><ref id="B33"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>H&#x000f6;lzel</surname><given-names>R</given-names></name></person-group><source>Biophys J</source><year>1997</year><volume>73</volume><fpage>1103</fpage><lpage>1109</lpage><pub-id pub-id-type="pmid">9251826</pub-id></citation></ref><ref id="B34"><citation citation-type="book"><person-group person-group-type="author"><nam