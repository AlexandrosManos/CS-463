t" rowspan="1" colspan="1">54235891</td><td align="left" rowspan="1" colspan="1">33144</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>miR-23a&#x0223c;miR-27a&#x0223c;miR-24-2</bold></td><td align="left" rowspan="1" colspan="1"><bold>Chr19: 13808473 (</bold>&#x02212;<bold>)</bold></td><td align="left" rowspan="1" colspan="1"><bold>&#x0005b;13807348, 13809097&#x0005d;</bold></td><td align="left" rowspan="1" colspan="1"><bold>CpG&#x02212;</bold></td><td align="left" rowspan="1" colspan="1"><bold>13808448</bold></td><td align="left" rowspan="1" colspan="1"><bold>0</bold></td></tr><tr><td align="left" rowspan="1" colspan="1">miR-181c&#x0223c;miR-181d</td><td align="left" rowspan="1" colspan="1">Chr19: 13846512 (&#x0002b;)</td><td align="left" rowspan="1" colspan="1">&#x0005b;13832848, 13834847&#x0005d;</td><td align="left" rowspan="1" colspan="1"><bold>CpG&#x02212;</bold></td><td align="left" rowspan="1" colspan="1"><italic>none predicted</italic></td><td align="left" rowspan="1" colspan="1"><bold><italic>NA</italic></bold></td></tr><tr><td align="left" rowspan="1" colspan="1">miR-99b&#x0223c;let-7e&#x0223c;miR125a</td><td align="left" rowspan="1" colspan="1">Chr19: 56887676 (&#x0002b;)</td><td align="left" rowspan="1" colspan="1">&#x0005b;56882098, 56886347&#x0005d;</td><td align="left" rowspan="1" colspan="1">CpG&#x0002b;</td><td align="left" rowspan="1" colspan="1"><italic>none predicted</italic></td><td align="left" rowspan="1" colspan="1"><bold><italic>NA</italic></bold></td></tr><tr><td align="left" rowspan="1" colspan="1">miR-216a&#x0223c;miR-217</td><td align="left" rowspan="1" colspan="1">Chr2: 56069698 (&#x02212;)</td><td align="left" rowspan="1" colspan="1">&#x0005b;56072783, 56074282&#x0005d;</td><td align="left" rowspan="1" colspan="1">CpG&#x02212;</td><td align="left" rowspan="1" colspan="1">56073933</td><td align="left" rowspan="1" colspan="1">3985</td></tr><tr><td align="left" rowspan="1" colspan="1">miR-301b&#x0223c;miR-130b</td><td align="l