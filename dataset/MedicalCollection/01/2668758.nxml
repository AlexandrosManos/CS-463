/td></tr><tr><td align="left" rowspan="1" colspan="1">miR-26b</td><td align="left" rowspan="1" colspan="1">CTDSP1</td><td align="left" rowspan="1" colspan="1">Chr2: 218975612 (&#x0002b;)</td><td align="left" rowspan="1" colspan="1">&#x0005b;218968033, 218974282&#x0005d;</td></tr><tr><td align="left" rowspan="1" colspan="1">miR-103-2</td><td align="left" rowspan="1" colspan="1">PANK2</td><td align="left" rowspan="1" colspan="1">Chr20: 3846140 (&#x0002b;)</td><td align="left" rowspan="1" colspan="1">&#x0005b;3816001, 3820000&#x0005d;</td></tr><tr><td align="left" rowspan="1" colspan="1">miR-185</td><td align="left" rowspan="1" colspan="1">C22orf25</td><td align="left" rowspan="1" colspan="1">Chr22: 18400661 (&#x0002b;)</td><td align="left" rowspan="1" colspan="1">&#x0005b;18387533, 18389782&#x0005d;</td></tr><tr><td align="left" rowspan="1" colspan="1">miR-191&#x0223c;miR-425</td><td align="left" rowspan="1" colspan="1">DALRD3</td><td align="left" rowspan="1" colspan="1">Chr3: 49033146 (&#x02212;)</td><td align="left" rowspan="1" colspan="1">&#x0005b;49026104, 49038353&#x0005d;</td></tr><tr><td align="left" rowspan="1" colspan="1">miR-15b&#x0223c;miR-16-2</td><td align="left" rowspan="1" colspan="1">SMC4</td><td align="left" rowspan="1" colspan="1">Chr3: 161605069 (&#x0002b;)</td><td align="left" rowspan="1" colspan="1">&#x0005b;161598354, 161603353&#x0005d;</td></tr><tr><td align="left" rowspan="1" colspan="1">miR-378</td><td align="left" rowspan="1" colspan="1">PPARGC1B</td><td align="left" rowspan="1" colspan="1">Chr5: 149092580 (&#x0002b;)</td><td align="left" rowspan="1" colspan="1">&#x0005b;149089935, 149091684&#x0005d;</td></tr><tr><td align="left" rowspan="1" colspan="1">miR-103-1</td><td align="left" rowspan="1" colspan="1">PANK3</td><td align="left" rowspan="1" colspan="1">Chr5: 167920556 (&#x02212;)</td><td align="left" rowspan="1" colspan="1">&#x0005b;167938685, 167940184&#x0005d;</td></tr><tr><td align="left" rowspan="1" colspan="1">miR-335</td><td align=