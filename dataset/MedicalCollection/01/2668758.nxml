span="1" colspan="1">Chr17: 1564031 (&#x02212;)</td><td align="left" rowspan="1" colspan="1">&#x0005b;1563059, 1569558&#x0005d;</td></tr><tr><td align="left" rowspan="1" colspan="1">miR-636</td><td align="left" rowspan="1" colspan="1">SFRS2</td><td align="left" rowspan="1" colspan="1">Chr17: 72244225 (&#x02212;)</td><td align="left" rowspan="1" colspan="1">&#x0005b;72244059, 72246308&#x0005d;</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>miR-146a</bold></td><td align="left" rowspan="1" colspan="1"><bold>DQ658414</bold></td><td align="left" rowspan="1" colspan="1"><bold>Chr5: 159844936 (&#x0002b;)</bold></td><td align="left" rowspan="1" colspan="1"><bold>&#x0005b;159826435, 159828934&#x0005d;</bold></td></tr></tbody></table><table-wrap-foot><fn id="nt102"><label/><p><italic>Host gene</italic>: the gene whose intron the miRNA was found in. Other column names as in <xref ref-type="table" rid="pone-0005279-t001">Table 1</xref>. Bold letters designate genes that are known to be co-transcribed with their host genes.</p></fn></table-wrap-foot></table-wrap><table-wrap id="pone-0005279-t003" position="float"><object-id pub-id-type="doi">10.1371/journal.pone.0005279.t003</object-id><label>Table 3</label><caption><title>Identification of promoters for <italic>intragenic</italic> miRNA genes.</title></caption><graphic id="pone-0005279-t003-3" xlink:href="pone.0005279.t003"/><table frame="hsides" rules="groups" alternate-form-of="pone-0005279-t003-3"><colgroup span="1"><col align="left" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/></colgroup><thead><tr><td align="left" rowspan="1" colspan="1">miRNA</td><td align="left" rowspan="1" colspan="1">Host Gene</td><td align="left" rowspan="1" colspan="1">Chromosomal location</td><td align="left" rowspan="1" colspan="1">ChIP-chip region</td><td align="left" rowspan="1" colspan="1">