" valign="top" charoff="50">Tamoxifen (<xref ref-type="other" rid="bib42">Smith <italic>et al</italic>, 2005</xref>)</td><td align="center" valign="top" charoff="50">108</td><td align="center" valign="top" charoff="50">39 (36&#x00025;)</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">22 (20&#x00025;)</td><td align="center" valign="top" charoff="50">8/36 (22&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50"><italic>P</italic>=n/s</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50"><italic>P</italic>=n/s</td><td align="center" valign="top" charoff="50">P A <italic>vs</italic> T=0.03</td></tr><tr><td align="left" valign="top" charoff="50">Exemestane</td><td align="center" valign="top" charoff="50">36</td><td align="center" valign="top" charoff="50">32 (88&#x00025;)</td><td align="center" valign="top" charoff="50">24 (67&#x00025;)</td><td align="center" valign="top" charoff="50">25 (69&#x00025;)</td><td align="center" valign="top" charoff="50">14 (39&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50">Tamoxifen (<xref ref-type="other" rid="bib39">Semiglazov <italic>et al</italic>, 2005</xref>)</td><td align="center" valign="top" charoff="50">37</td><td align="center" valign="top" charoff="50">19 (51&#x00025;)</td><td align="center" valign="top" charoff="50">15 (40&#x00025;)</td><td align="center" valign="top" charoff="50">15 (40&#x00025;)</td><td align="center" valign="top" charoff="50">4 (11&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50"><italic>P</italic>=n/s</td><td align="center" valign="top" charoff="50"><italic>P</italic>=n/s</td><td align="center" valign="top" charoff="5