2003;Other</td><td align="center" rowspan="1" colspan="1">2</td></tr><tr><td colspan="2" align="left" rowspan="1">&#x02003;Educational attainment</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Some high school or less</td><td align="center" rowspan="1" colspan="1">13</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;High school graduate</td><td align="center" rowspan="1" colspan="1">22</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Vocational school</td><td align="center" rowspan="1" colspan="1">2</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Some college</td><td align="center" rowspan="1" colspan="1">21</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;College graduate</td><td align="center" rowspan="1" colspan="1">24</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Graduate school</td><td align="center" rowspan="1" colspan="1">18</td></tr><tr><td colspan="2" align="left" rowspan="1">&#x02003;Body size</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Underweight</td><td align="center" rowspan="1" colspan="1">1</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Normal weight</td><td align="center" rowspan="1" colspan="1">34</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Overweight</td><td align="center" rowspan="1" colspan="1">37</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Obese</td><td align="center" rowspan="1" colspan="1">28</td></tr></tbody></table></table-wrap><table-wrap id="t2-ehp-117-442" position="float"><label>Table 2</label><caption><p>Descriptive statistics for food outlet density (stores/km<sup>2</sup>).</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1">Food outlet type</th><th align="center" rowspan="1" colspan="1">Density (mean &#x000b1; SD) (10th, 90th percentiles