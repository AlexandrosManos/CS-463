tion></ref><ref id="b16-cln63_2p0215"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Emont</surname><given-names>SL</given-names></name><name><surname>Dorrell</surname><given-names>KB</given-names></name><name><surname>Mcclain</surname><given-names>R</given-names></name></person-group><article-title>The burden of smoking-attributable mortality among African Americans - Indiana, 1990</article-title><source>Addict Behav</source><year>1995</year><volume>20</volume><fpage>563</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">8712054</pub-id></citation></ref><ref id="b17-cln63_2p0215"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stapleton</surname><given-names>MP</given-names></name><name><surname>Palmer</surname><given-names>CT</given-names></name></person-group><article-title>Cigarette smoking in Kentucky: Smoking-attributable mortality and Years of potential life lost</article-title><source>J Ky Med Assoc</source><year>1998</year><volume>96</volume><fpage>451</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">9834581</pub-id></citation></ref><ref id="b18-cln63_2p0215"><label>18</label><citation citation-type="journal"><collab>Center of Disease Control and Prevention</collab><article-title>Annual Smoking-Attributable Mortality, Years of Potential Life Lost, and Economic Costs, United States, 1995&#x02013;1999</article-title><source>MMWR</source><year>2002</year><volume>51</volume><fpage>300</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">12002168</pub-id></citation></ref><ref id="b19-cln63_2p0215"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lopez</surname><given-names>AD</given-names></name><name><surname>Ezzati</surname><given-names>M</given-names></name></person-group><article-title>Estimates of global mortality attributable to smoking in 2000</article-title><source>Lancet</source><ye