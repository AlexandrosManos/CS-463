b-id-type="pmid">10076491</pub-id></citation></ref><ref id="b26-cln63_2p0215"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Illing</surname><given-names>EMM</given-names></name><name><surname>Kaiserman</surname><given-names>MJ</given-names></name></person-group><article-title>Mortality Attributable to Tobacco Use in Canada and its Regions, 1994 and 1996</article-title><source>Chronic Dis Can</source><year>1999</year><volume>20</volume><fpage>111</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">10557201</pub-id></citation></ref><ref id="b27-cln63_2p0215"><label>27</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Mathers</surname><given-names>C</given-names></name><name><surname>Vos</surname><given-names>T</given-names></name><name><surname>Stevenson</surname><given-names>C</given-names></name></person-group><source>The Burden of Disease and Injury in Australia: summary report</source><publisher-name>Australian Institute of Health and Welfare: National Capital Printing</publisher-name><year>1999</year></citation></ref><ref id="b28-cln63_2p0215"><label>28</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Lopez</surname><given-names>AD</given-names></name><name><surname>Mathers</surname><given-names>CD</given-names></name><name><surname>Ezzati</surname><given-names>M</given-names></name><name><surname>Jamison</surname><given-names>DT</given-names></name><name><surname>Murray</surname><given-names>CJL</given-names></name></person-group><source>Global Burden of Disease and Risk Factors</source><publisher-loc>Washington</publisher-loc><publisher-name>Oxford University Press and World Bank</publisher-name><year>2006</year></citation></ref><ref id="b29-cln63_2p0215"><label>29</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ezzati</surname><given-names>M</given-names></name><name><surname>Hoorn</surname><given-names>SV</given-names></name><name><surname>Rodgers</surname><given-names>A</given-names></name><name><surname>Lopez</surname><given-names>AD</given-names></name><name><surname>Mathers</surname><given-names>CD</given-names></name><name><surname>Murray</surname><given-names>CJL</given-names></name></person-group><article-title>Estimates of global and regional potential health gains from reducing multiple major risk factors</article-title><source>Lancet</source><year>2003</year><volume>362</volume><fpage>271</fpage><lpage>80</lpage><pub-id pub-id-type="pmid">12892956</pub-id></citation></ref><ref id="b30-cln63_2p0215"><label>30</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Danaei</surname><given-names>G</given-names></name><name><surname>Vander Hoorn</surname><given-names>S</given-names></name><name><surname>Lopez</surname><given-names>AD</given-names></name><name><surname>Murray</surname><given-names>CJL</given-names></name><name><surname>Ezzati</surname><given-names>M</given-names></name></person-group><article-title>Causes of Cancer in the World: Comparative Risk Assessment of Nine Behavioral and Environmental Risk Factors</article-title><source>Lancet</source><year>2005</year><volume>366</volume><fpage>1784</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">16298215</pub-id></citation></ref><ref id="b31-cln63_2p0215"><label>31</label><citation citation-type="journal"><collab>Center of Disease Control and Prevention</collab><article-title>Perspectives in disease prevention and health promotion and smoking-attributable mortality and years of potential life lost, United States, 1984</article-title><source>MMWR</source><year>1997</year><volume>46</volume><fpage>444</fpage><lpage>51</lpage><pub-id pub-id-type="pmid">9182206</pub-id></citation></ref><ref id="b32-cln63_2p0215"><label>32</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Levy</surname><given-names>RA</given-names></name></person-group><article-title>Estimating the numbers of smoking-related deaths</article-title><source>J Am Med Assoc</source><year>2000</year><volume>284</volume><fpage>2319</fpage><lpage>20</lpage></citation></ref><ref id="b33-cln63_2p0215"><label>33</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Malarcher</surname><given-names>AM</given-names></name><name><surname>Schulman</surname><given-names>J</given-names></name><name><surname>Epstein</surname><given-names>LA</given-names></name></person-group><article-title>Methodological Issues in Estimating Smoking-Attributable Mortality in the United States</article-title><source>Am J Epidemiol</source><year>2000</year><volume>152</volume><fpage>573</fpage><lpage>84</lpage><pub-id pub-id-type="pmid">10997548</pub-id></citation></ref><ref id="b34-cln63_2p0215"><label>34</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sterling</surname><given-names>TD</given-names></name><name><surname>Rosebaum</surname><given-names>WL</given-names></name><name><surname>Weikam</surname><given-names>JJ</given-names></name></person-group><article-title>Risk Attribution and Tobacco-Related Deaths</article-title><source>Am J Epidemiol</source><year>1993</year><volume>138</volume><fpage>128</fpage><lpage>39</lpage><pub-id pub-id-type="pmid">8342531</pub-id></citation></ref></ref-list></back><floats-wrap><fig id="f1-cln63_2p0215" position="float"><label>Figure 1</label><caption><p>Relative risks of the main tobacco-related diseases used in the Global Burden of Disease Survey. Rio de Janeiro State, Brazil, 2000</p></caption><graphic xlink:href="cln63_2p0215f1"/></fig><table-wrap id="t1-cln63_2p0215" position="float"><label>Table 1</label><caption><p>Disability-adjusted life years (DALYs) and their smoking-attributable fraction, according to gender and estimated cause of disease, for individuals &#x02265; 30 y