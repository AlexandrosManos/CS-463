288-X</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maxia</surname><given-names>A</given-names></name><name><surname>Lancioni</surname><given-names>MC</given-names></name><name><surname>Foddis</surname><given-names>C</given-names></name><name><surname>Ballero</surname><given-names>M</given-names></name></person-group><article-title>Biodiversit&#x000e0; floristica e medicina popolare della Sardegna</article-title><source>Inform Bot Ital</source><year>2005</year><volume>37</volume><fpage>988</fpage><lpage>989</lpage></citation></ref><ref id="B15"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Atzei</surname><given-names>AD</given-names></name></person-group><source>Le piante nella tradizione popolare della Sardegna</source><year>2003</year><publisher-name>Sassari: C. Delfino</publisher-name><pub-id pub-id-type="pmid">12650569</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lombardini</surname><given-names>C</given-names></name><name><surname>Bruschi</surname><given-names>P</given-names></name><name><surname>Signorini</surname><given-names>MA</given-names></name></person-group><article-title>Ricerca etnobotanica. Un'indagine nel territorio di San Miniato</article-title><source>Boll Accad Euteleti (San Miniato)</source><year>2006</year><volume>73</volume><fpage>275</fpage><lpage>285</lpage></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Pignatti</surname><given-names>S</given-names></name></person-group><source>Flora d'Italia</source><year>1982</year><publisher-name>Bologna: Edagricole</publisher-name></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Signorini</surname><given-names>MA</given-names></name><name><surname>Lombardini</