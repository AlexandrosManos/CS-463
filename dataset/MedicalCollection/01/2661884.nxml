urce><year>2003</year><volume>110</volume><fpage>55</fpage><lpage>69</lpage></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ansaldi</surname><given-names>M</given-names></name><name><surname>Tomei</surname><given-names>PE</given-names></name></person-group><article-title>Specie vegetali selvatiche e coltivate di uso medicinale nella tradizione popolare delle Apuane settentrionali</article-title><source>Atti Soc Tosc Sci Nat Mem Serie B</source><year>1997</year><volume>104</volume><fpage>19</fpage><lpage>34</lpage></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Uncini Manganelli</surname><given-names>RE</given-names></name><name><surname>Tomei</surname><given-names>PE</given-names></name></person-group><article-title>Ethnobotanical studies of the Tuscan Archipelago</article-title><source>J Ethnopharmacol</source><year>1999</year><volume>65</volume><fpage>181</fpage><lpage>202</lpage><pub-id pub-id-type="pmid">10404416</pub-id><pub-id pub-id-type="doi">10.1016/S0378-8741(98)00177-9</pub-id></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giachetti</surname><given-names>G</given-names></name><name><surname>Tomei</surname><given-names>PE</given-names></name></person-group><article-title>Piante officinali nell'uso tradizionale del territorio mugellano (Toscana)</article-title><source>Atti Soc Ital Sci Nat Museo Civ Stor Nat Milano</source><year>2003</year><volume>144</volume><fpage>23</fpage><lpage>49</lpage></citation></ref></ref-list></back></article>