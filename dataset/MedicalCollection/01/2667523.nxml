>10</volume><fpage>199</fpage><lpage>203</lpage></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hansson</surname><given-names>H</given-names></name><name><surname>Karlsson-Parra</surname><given-names>A</given-names></name></person-group><article-title>Canine antinuclear antibodies: Comparison of immunofluorescence staining patterns and precipitin reactivity</article-title><source>Acta Vet Scand</source><year>1999</year><volume>40</volume><fpage>205</fpage><lpage>212</lpage><pub-id pub-id-type="pmid">10605137</pub-id></citation></ref><ref id="B21"><citation citation-type="book"><person-group person-group-type="author"><name><surname>McCarty</surname><given-names>GA</given-names></name><name><surname>Valencia</surname><given-names>DW</given-names></name><name><surname>Fritzler</surname><given-names>MJ</given-names></name></person-group><source>ANA standardization and interpretation</source><year>1984</year><volume>1</volume><publisher-name>New York: Oxford University Press</publisher-name><pub-id pub-id-type="pmid">6400637</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Artursson</surname><given-names>K</given-names></name><name><surname>Gunnarsson</surname><given-names>A</given-names></name><name><surname>Wikstr&#x000f6;m</surname><given-names>U-B</given-names></name><name><surname>Olsson Engvall</surname><given-names>E</given-names></name></person-group><article-title>A serological and clinical follow-up in horses with confirmed equine granulocytic ehrlichiosis</article-title><source>Equine Veterinary Journal</source><year>1999</year><volume>31</volume><issue>6</issue><fpage>473</fpage><lpage>477</lpage><pub-id pub-id-type="pmid">10596927</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Madigan</surname><given-names>JE</given-names></na