p-type="editor"><name><surname>Kwon-Chung</surname><given-names>KJ</given-names></name><name><surname>Bennett</surname><given-names>JE</given-names></name></person-group><article-title>Cryptococcosis</article-title><source>Medical mycology</source><year>1992</year><publisher-loc>Philadelphia</publisher-loc><publisher-name>Lea &#x00026; Febiger</publisher-name><fpage>397</fpage><lpage>446</lpage></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wu</surname><given-names>B</given-names></name><name><surname>Liu</surname><given-names>H</given-names></name><name><surname>Huang</surname><given-names>J</given-names></name><name><surname>Zhang</surname><given-names>W</given-names></name><name><surname>Zhnag</surname><given-names>T</given-names></name></person-group><article-title>Pulmoanry cryptococcosis in non-AIDS patients</article-title><source>Clin Invest Med</source><year>2009</year><volume>32</volume><fpage>e70</fpage><lpage>e77</lpage><pub-id pub-id-type="pmid">19178882</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>H</given-names></name><name><surname>Kang</surname><given-names>SJ</given-names></name><name><surname>Suh</surname><given-names>GY</given-names></name><name><surname>Chung</surname><given-names>MP</given-names></name><name><surname>Kwon</surname><given-names>OJ</given-names></name><name><surname>Rhee</surname><given-names>CH</given-names></name><etal/></person-group><article-title>Predictors for benign solitary pulmonary nodule in tuberculosis-endemic area</article-title><source>Korean J Intern Med</source><year>2001</year><volume>16</volume><fpage>236</fpage><lpage>241</lpage><pub-id pub-id-type="pmid">11855152</pub-id></element-citation></ref><ref id="B13"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lortholary</surname><given-names>O</given-names></name><name><surname>Nunez</surname><given-names>H</given-names></name><name><surname>Brauner</surname><given-names>MW</given-names></name><name><surname>Dromer</surname><given-names>F</given-names></name></person-group><article-title>Pulmonary cryptococcosis</article-title><source>Semin Respir Crit Care Med</source><year>2004</year><volume>25</volume><fpage>145</fpage><lpage>157</lpage><pub-id pub-id-type="pmid">16088458</pub-id></element-citation></ref></ref-list></back><floats-group><fig id="F1" position="float"><label>Fig. 1</label><caption><p>(A) Chest radiograph shows patch opacity in the lower lobe of the left lung (arrow). (B) Chest computerized tomography (CT) demonstrates multiple nodules in the lower lobe of the left lung (arrow).</p></caption><graphic xlink:href="kjped-53-971-g001"/></fig><fig id="F2" position="float"><label>Fig. 2</label><caption><p>A) Biopsy specimen shows multiple variable-sized (diameter range, 2-20 &#x000b5;m), round to oval yeasts with narrow-necked budding (arrow); (Gomori methenamine silver staining, &#x000d7;400). B) Multiple round to oval yeasts with budding show a faint rim of mucicarmine staining, indicating the characteristic rose-red capsule of <italic>Cryptococcus neoformans</italic> (arrow; Mayer's mucicarmine staining, &#x000d7;1,000).</p></caption><graphic xlink:href="kjped-53-971-g002"/></fig><fig id="F3" position="float"><label>Fig. 3</label><caption><p>(A) Follow-up chest radiograph shows decreased opacity in the lower lobe of the left lung (arrow). (B) Follow-up chest CT image reveals resolution of lesions in the lower lobe of the left lung.</p></caption><graphic xlink:href="kjped-53-971-g003"/></fig></floats-group></article>