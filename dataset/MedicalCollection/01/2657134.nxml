d.2007.05.036</pub-id></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Murdoch</surname><given-names>J</given-names></name></person-group><article-title>The spaces of actor network theory</article-title><source>Geoforum</source><year>1998</year><volume>29</volume><fpage>357</fpage><lpage>74</lpage><pub-id pub-id-type="doi">10.1016/S0016-7185(98)00011-6</pub-id></citation></ref><ref id="B31"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Star</surname><given-names>SL</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Star SL</surname></name></person-group><article-title>The politics of formal representations</article-title><source>Ecologies of knowledge: work and politics in science and technology</source><year>1995</year><publisher-name>New York: State University of New York Press</publisher-name><fpage>89</fpage><lpage>118</lpage></citation></ref></ref-list></back></article>