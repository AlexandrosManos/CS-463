lign="center" rowspan="1" colspan="1">62/61</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1">SA-11/G3P[1]/Si</td><td valign="top" align="center" rowspan="1" colspan="1">77/85</td><td valign="top" align="center" rowspan="1" colspan="1">79/84</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1">71/72</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1">94/96</td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1">CMP034/G2P[27]/Po</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02013;</td><td valign="top" align="center" rowspan="1" colspan="1"><bold>99/100</bold></td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1">YM/G11P[7]/Po</td><td valign="top" align="center" rowspan="1" colspan="1">88/94</