publication-type="journal"><person-group person-group-type="author"><name><surname>Sechtem</surname><given-names>U</given-names></name><name><surname>Mahrholdt</surname><given-names>H</given-names></name></person-group><article-title>Can delayed enhancement and T2-weighted imaging distinguish acute from chronic myocardial infarction?</article-title><source>Nat Clin Pract Cardiovasc Med</source><year>2004</year><volume>1</volume><fpage>22</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">16265255</pub-id></element-citation></ref><ref id="B11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wisenberg</surname><given-names>G</given-names></name><name><surname>Prato</surname><given-names>FS</given-names></name><name><surname>Carroll</surname><given-names>SE</given-names></name><name><surname>Turner</surname><given-names>KL</given-names></name><name><surname>Marshall</surname><given-names>T</given-names></name></person-group><article-title>Serial nuclear magnetic resonance imaging of acute myocardial infarction with and without reperfusion</article-title><source>Am Heart J</source><year>1988</year><volume>115</volume><fpage>510</fpage><lpage>518</lpage><pub-id pub-id-type="pmid">3344656</pub-id></element-citation></ref><ref id="B12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Higgins</surname><given-names>CB</given-names></name><name><surname>Herfkens</surname><given-names>R</given-names></name><name><surname>Lipton</surname><given-names>MJ</given-names></name><name><surname>Sievers</surname><given-names>R</given-names></name><name><surname>Sheldon</surname><given-names>P</given-names></name><name><surname>Kaufman</surname><given-names>L</given-names></name><etal/></person-group><article-title>Nuclear magnetic resonance imaging of acute myocardial infarction in dogs: alterations in magnetic relaxation times</article-title><sourc