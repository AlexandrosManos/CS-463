<fpage>1976</fpage><lpage>1979</lpage><pub-id pub-id-type="pmid">16946522</pub-id><pub-id pub-id-type="doi">10.1248/bpb.29.1976</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Safayhi</surname><given-names>H</given-names></name><name><surname>Sailer</surname><given-names>ER</given-names></name><name><surname>Ammon</surname><given-names>HP</given-names></name></person-group><article-title>Mechanism of 5-lipoxygenase inhibition by acetyl-11-keto-&#x003b2;-boswellic acid</article-title><source>Mol Pharmacol</source><year>1995</year><volume>47</volume><fpage>1212</fpage><lpage>1216</lpage><pub-id pub-id-type="pmid">7603462</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Anthoni</surname><given-names>C</given-names></name><name><surname>Laukoetter</surname><given-names>MG</given-names></name><name><surname>Rijcken</surname><given-names>E</given-names></name><name><surname>Vowinkel</surname><given-names>T</given-names></name><name><surname>Mennigen</surname><given-names>R</given-names></name><name><surname>Muller</surname><given-names>S</given-names></name><name><surname>Senninger</surname><given-names>N</given-names></name><name><surname>Russell</surname><given-names>J</given-names></name><name><surname>Jauch</surname><given-names>J</given-names></name><name><surname>Bergmann</surname><given-names>J</given-names></name><etal></etal></person-group><article-title>Mechanisms underlying the anti-inflammatory actions of boswellic acid derivatives in experimental colitis</article-title><source>Am J Physiol Gastrointest Liver Physiol</source><year>2006</year><volume>290</volume><fpage>G1131</fpage><lpage>1137</lpage><pub-id pub-id-type="pmid">16423918</pub-id><pub-id pub-id-type="doi">10.1152/ajpgi.00562.2005</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="autho