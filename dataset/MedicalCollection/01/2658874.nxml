f id="b17-ebo-01-51"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eisen</surname><given-names>JA</given-names></name><name><surname>Fraser</surname><given-names>CM</given-names></name></person-group><year>2003</year><article-title>Phylogenomics: intersection of evolution and genomics</article-title><source>Science</source><volume>5626 </volume><issue>300</issue><fpage>1706</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">12805538</pub-id></citation></ref><ref id="b18-ebo-01-51"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Felsenstein</surname><given-names>J</given-names></name></person-group><year>1996</year><article-title>Inferring phylogenies from protein sequences by parsimony, distance, and likelihood methods</article-title><source>Methods Enzymol</source><issue>266</issue><fpage>418</fpage><lpage>27</lpage><pub-id pub-id-type="pmid">8743697</pub-id></citation></ref><ref id="b19-ebo-01-51"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Felsenstein</surname><given-names>J</given-names></name></person-group><year>2001</year><article-title>Taking variation of evolutionary rates between sites into account in inferring phylogenies</article-title><source>J Mol Evol</source><volume>53</volume><fpage>4</fpage><lpage>5</lpage><fpage>447</fpage><lpage>55</lpage></citation></ref><ref id="b20-ebo-01-51"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fitch</surname><given-names>WM</given-names></name></person-group><year>1970</year><article-title>Distinguishing homologous from analogous proteins</article-title><source>Syst Zool</source><volume>2 </volume><issue>19</issue><fpage>99</fpage><lpage>113</lpage><pub-id pub-id-type="pmid">5449325</pub-id></citation></ref><ref id="b21-ebo-01-51"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fitch</surname><given-nam