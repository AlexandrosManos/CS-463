</td><td align="center">0.16</td><td align="center">0.12</td><td align="center">0.0016</td><td align="center">0.0009</td><td align="center">0.0024</td><td align="center">0%</td></tr><tr><td align="left">CAM</td><td align="center">118</td><td align="center">837</td><td align="center">0.12</td><td align="center">0.00</td><td align="center">7.99</td><td align="center">0.73</td><td align="center">0.97</td><td align="center">-0.0018</td><td align="center">0.0013</td><td align="center">-0.0006</td><td align="center">0%</td></tr><tr><td align="left">COBND</td><td align="center">63</td><td align="center">760</td><td align="center">0.21</td><td align="center">-0.06</td><td align="center">2.42</td><td align="center">0.16</td><td align="center">0.52</td><td align="center">-0.0017</td><td align="center">0.0019</td><td align="center">0.0002</td><td align="center">2%</td></tr><tr><td align="left">COMT</td><td align="center">856</td><td align="center">7 073</td><td align="center">0.02</td><td align="center">-0.25</td><td align="center">3.63</td><td align="center">0.11</td><td align="center">0.06</td><td align="center">0.0000</td><td align="center">0.0015</td><td align="center">0.0015</td><td align="center">0%</td></tr><tr><td align="left">LAND</td><td align="center">22</td><td align="center">73</td><td align="center">0.74</td><td align="center">0.06</td><td align="center">3.99</td><td align="center">0.41</td><td align="center">2.95</td><td align="center">-0.0029</td><td align="center">0.0016</td><td align="center">-0.0014</td><td align="center">2%</td></tr><tr><td align="left">MER</td><td align="center">93</td><td align="center">1 012</td><td align="center">0.15</td><td align="center">-0.04</td><td align="center">10.41</td><td align="center">0.91</td><td align="center">1.53</td><td align="center">0.0000</td><td align="center">0.0001</td><td align="center">0.0001</td><td align="center">0%</td></tr><tr><td align="left">PER</td><td align="center">183</td><td align="center">2 461</td>