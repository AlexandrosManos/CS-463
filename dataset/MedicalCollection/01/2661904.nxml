e><source>Eur Heart J</source><volume>26</volume><issue>2</issue><fpage>193</fpage><lpage>200</lpage><pub-id pub-id-type="pmid">15618077</pub-id></citation></ref><ref id="b12-ehp-117-361"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Drazen</surname><given-names>JM</given-names></name><name><surname>O&#x02019;Cain</surname><given-names>CF</given-names></name><name><surname>Ingram</surname><given-names>RH</given-names><suffix>Jr</suffix></name></person-group><year>1982</year><article-title>Experimental induction of chronic bronchitis in dogs: effects on airway obstruction and responsiveness</article-title><source>Am Rev Respir Dis</source><volume>126</volume><issue>1</issue><fpage>75</fpage><lpage>79</lpage><pub-id pub-id-type="pmid">6953777</pub-id></citation></ref><ref id="b13-ehp-117-361"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Fitzmaurice</surname><given-names>GM</given-names></name><name><surname>Laird</surname><given-names>NM</given-names></name><name><surname>Ware</surname><given-names>JH</given-names></name></person-group><year>2004</year><source>Applied Longitudinal Analysis </source><publisher-loc>Hoboken, NJ</publisher-loc><publisher-name>Wiley-Interscience</publisher-name></citation></ref><ref id="b14-ehp-117-361"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Godleski</surname><given-names>JJ</given-names></name><name><surname>Verrier</surname><given-names>RL</given-names></name><name><surname>Koutrakis</surname><given-names>P</given-names></name><name><surname>Catalano</surname><given-names>P</given-names></name><name><surname>Coull</surname><given-names>B</given-names></name><name><surname>Reinisch</surname><given-names>U</given-names></name><etal/></person-group><year>2000</year><article-title>Mechanisms of morbidity and mortality from exposure to ambient air particles</article-title><source>Res Rep Health Eff Inst</source><issue>91</issue><fpage>5</fpage><lpage>103</lpage><pub-id pub-id-type="pmid">10817681</pub-id></citation></ref><ref id="b15-ehp-117-361"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldstein</surname><given-names>DS</given-names></name></person-group><year>1983</year><article-title>Arterial baroreflex sensitivity, plasma cat-echolamines, and pressor responsiveness in essential hypertension</article-title><source>Circulation</source><volume>68</volume><issue>2</issue><fpage>234</fpage><lpage>240</lpage><pub-id pub-id-type="pmid">6407776</pub-id></citation></ref><ref id="b16-ehp-117-361"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Graham</surname><given-names>RM</given-names></name></person-group><year>1984</year><article-title>Selective alpha1-adrenergic antagonists: therapeutically relevant antihypertensive agents</article-title><source>Am J Cardiol</source><volume>53</volume><issue>3</issue><fpage>16A</fpage><lpage>20A</lpage></citation></ref><ref id="b17-ehp-117-361"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harrabi</surname><given-names>I</given-names></name><name><surname>Rondeau</surname><given-names>V</given-names></name><name><surname>Dartigues</surname><given-names>JF</given-names></name><name><surname>Tessier</surname><given-names>JF</given-names></name><name><surname>Filleul</surname><given-names>L</given-names></name></person-group><year>2006</year><article-title>Effects of particulate air pollution on systolic blood pressure: a population-based approach</article-title><source>Environ Res</source><volume>101</volume><issue>1</issue><fpage>89</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">16563371</pub-id></citation></ref><ref id="b18-ehp-117-361"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ibald-Mulli</surname><given-names>A</given-names></name><name><surname>Stie