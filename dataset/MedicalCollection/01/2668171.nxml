>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Abu-Zant</surname><given-names>A</given-names></name><name><surname>Santic</surname><given-names>M</given-names></name><name><surname>Molmeret</surname><given-names>M</given-names></name><name><surname>Jones</surname><given-names>S</given-names></name><name><surname>Helbig</surname><given-names>J</given-names></name><etal/></person-group><year>2005</year><article-title>Incomplete activation of macrophage apoptosis during intracellular replication of <italic>Legionella pneumophila</italic>.</article-title><source>Infect Immun</source><volume>73</volume><fpage>5339</fpage><lpage>5349</lpage><pub-id pub-id-type="pmid">16113249</pub-id></citation></ref><ref id="pone.0005210-Fischer1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fischer</surname><given-names>SF</given-names></name><name><surname>Schwarz</surname><given-names>C</given-names></name><name><surname>Vier</surname><given-names>J</given-names></name><name><surname>H&#x000e4;cker</surname><given-names>G</given-names></name></person-group><year>2001</year><article-title>Characterization of antiapoptotic activities of <italic>Chlamydia pneumoniae</italic> in human cells.</article-title><source>Infect Immun</source><volume>69</volume><fpage>7121</fpage><lpage>7129</lpage><pub-id pub-id-type="pmid">11598088</pub-id></citation></ref><ref id="pone.0005210-Hcker1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>H&#x000e4;cker</surname><given-names>G</given-names></name><name><surname>Kirschnek</surname><given-names>S</given-names></name><name><surname>Fischer</surname><given-names>SF</given-names></name></person-group><year>2006</year><article-title>Apoptosis in infectious disease: how bacteria interfere with the apoptotic apparatus.</article-title><source>Med Microbiol Immunol</source><volume>195</vo