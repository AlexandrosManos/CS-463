son-group><source>Golden Leaf, Barren Harvest</source><year>2001</year><publisher-name>Washington DC: CFTFK</publisher-name></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Giang</surname><given-names>KB</given-names></name><name><surname>Allebeck</surname><given-names>P</given-names></name></person-group><article-title>Self-reported illness and use of health services in a rural district of Vietnam: findings from an epidemiological field laboratory</article-title><source>Scand J Public Health Suppl</source><year>2003</year><volume>62</volume><fpage>52</fpage><lpage>58</lpage><pub-id pub-id-type="pmid">14649642</pub-id><pub-id pub-id-type="doi">10.1080/14034950310015112</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mackenbach</surname><given-names>JP</given-names></name></person-group><article-title>Income inequality and population health</article-title><year>2002</year><volume>324</volume><fpage>1</fpage><lpage>2</lpage><pub-id pub-id-type="pmid">11777781</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yiengprugsawan</surname><given-names>V</given-names></name><name><surname>Lim</surname><given-names>L</given-names></name><name><surname>Carmichael</surname><given-names>G</given-names></name><name><surname>Sidorenko</surname><given-names>A</given-names></name><name><surname>Sleigh</surname><given-names>A</given-names></name></person-group><article-title>Measuring and decomposing inequity in self-reported morbidity and self-assessed health in Thailand</article-title><year>2007</year><volume>6</volume><fpage>23</fpage><pub-id pub-id-type="pmid">18088434</pub-id></citation></ref></ref-list></back></article>