an="1">3.0 &#x02013; 1&#x02019;</td><td align="center" rowspan="1" colspan="1">4.0 &#x02013; 1&#x02019;</td><td align="center" rowspan="1" colspan="1">5.0 &#x02013; 1&#x02019;</td></tr><tr><td align="left" rowspan="1" colspan="1">Running</td><td align="center" rowspan="1" colspan="1">12.0 &#x02013;1&#x02019;</td><td align="center" rowspan="1" colspan="1">13.0 &#x02013;1&#x02019;</td><td align="center" rowspan="1" colspan="1">12.0 &#x02013;1&#x02019;</td><td align="center" rowspan="1" colspan="1">13.0 &#x02013;1&#x02019;</td><td align="center" rowspan="1" colspan="1">15.0 &#x02013;1&#x02019;</td></tr><tr><td align="left" rowspan="1" colspan="1">Jogging</td><td align="center" rowspan="1" colspan="1">8.0 &#x02013; 2&#x02019;</td><td align="center" rowspan="1" colspan="1">9.0 &#x02013; 2&#x02019;</td><td align="center" rowspan="1" colspan="1">8.0 &#x02013; 2&#x02019;</td><td align="center" rowspan="1" colspan="1">9.0 &#x02013; 2&#x02019;</td><td align="center" rowspan="1" colspan="1">10.0 &#x02013; 2&#x02019;</td></tr><tr><td align="left" rowspan="1" colspan="1">Sprinting</td><td align="center" rowspan="1" colspan="1">18.0 &#x02013; 1&#x02019;</td><td align="center" rowspan="1" colspan="1">19.0 &#x02013; 1&#x02019;</td><td align="center" rowspan="1" colspan="1">18.0 &#x02013; 1&#x02019;</td><td align="center" rowspan="1" colspan="1">19.0 &#x02013; 1&#x02019;</td><td align="center" rowspan="1" colspan="1">19.0 &#x02013; 1&#x02019;</td></tr></tbody></table><table-wrap-foot><fn id="tfn1-cln63_1p0027"><p><bold>Note:</bold> A complete battery is composed of five phases with a covered distance equivalent to 4418 m.</p></fn></table-wrap-foot></table-wrap><table-wrap id="t2-cln63_1p0027" position="float"><label>Table 2</label><caption><p>Perception of fatigue verified by the subjective Borg scale in three batteries of exercise in soccer players using carbohydrate (CARBO) and the mixture carbohydrate and peptide glutamine (CARBOGLUT).</p></caption><table frame="hsides" rules="gr