><surname>Remington</surname><given-names>K</given-names></name><name><surname>Rusch</surname><given-names>DB</given-names></name><name><surname>Delcher</surname><given-names>AL</given-names></name><name><surname>Pop</surname><given-names>M</given-names></name><name><surname>Wang</surname><given-names>W</given-names></name><name><surname>Fraser</surname><given-names>CM</given-names></name><etal></etal></person-group><article-title>The dog genome: survey sequencing and comparative analysis</article-title><source>Science</source><year>2003</year><volume>301</volume><fpage>1898</fpage><lpage>1903</lpage><pub-id pub-id-type="pmid">14512627</pub-id><pub-id pub-id-type="doi">10.1126/science.1086432</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rogic</surname><given-names>S</given-names></name><name><surname>Mackworth</surname><given-names>AK</given-names></name><name><surname>Ouellette</surname><given-names>FB</given-names></name></person-group><article-title>Evaluation of gene-finding programs on mammalian sequences</article-title><source>Genome research</source><year>2001</year><volume>11</volume><fpage>817</fpage><lpage>832</lpage><pub-id pub-id-type="pmid">11337477</pub-id><pub-id pub-id-type="doi">10.1101/gr.147901</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lagerstrom</surname><given-names>MC</given-names></name><name><surname>Hellstrom</surname><given-names>AR</given-names></name><name><surname>Gloriam</surname><given-names>DE</given-names></name><name><surname>Larsson</surname><given-names>TP</given-names></name><name><surname>Schioth</surname><given-names>HB</given-names></name><name><surname>Fredriksson</surname><given-names>R</given-names></name></person-group><article-title>The G Protein-Coupled Receptor Subset of the Chicken Genome</article-title><source>PLoS Comput Biol</source><year>2006</year>