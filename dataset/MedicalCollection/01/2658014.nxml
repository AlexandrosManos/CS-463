l>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Xue</surname><given-names>D</given-names></name><name><surname>Shi</surname><given-names>H</given-names></name><name><surname>Smith</surname><given-names>JD</given-names></name><name><surname>Chen</surname><given-names>X</given-names></name><name><surname>Noe</surname><given-names>DA</given-names></name><name><surname>Cedervall</surname><given-names>T</given-names></name><etal/></person-group><article-title>A lupus-like syndrome develops in mice lacking the Ro 60-kDa protein, a major lupus autoantigen</article-title><source>Proc Natl Acad Sci U S A</source><year>2003</year><volume>100</volume><fpage>7503</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">12788971</pub-id></citation></ref><ref id="b13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Familian</surname><given-names>A</given-names></name><name><surname>Zwart</surname><given-names>B</given-names></name><name><surname>Huisman</surname><given-names>HG</given-names></name><name><surname>Rensink</surname><given-names>I</given-names></name><name><surname>Roem</surname><given-names>D</given-names></name><name><surname>Hordijk</surname><given-names>PL</given-names></name><etal/></person-group><article-title>Chromatin-independent binding of serum amyloid P component to apoptotic cells</article-title><source>J Immunol</source><year>2001</year><volume>167</volume><fpage>647</fpage><lpage>54</lpage><pub-id pub-id-type="pmid">11441067</pub-id></citation></ref><ref id="b14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bygrave</surname><given-names>AE</given-names></name><name><surname>Rose</surname><given-names>KL</given-names></name><name><surname>Cortes-Hernandez</surname><given-names>J</given-names></name><name><surname>Warren</surname><given-names>J</given-names></name><name><surname>Rigby</surname><given-names>RJ</given-names></name><name><surname>Cook</surname><given-names>HT</given-names></name><etal/></person-group><article-title>Spontaneous autoimmunity in 129 and C57BL/6 mice&#x02014;implications for autoimmunity described in gene-targeted mice</article-title><source>PLoS Biol</source><year>2004</year><volume>2</volume><fpage>E243</fpage><pub-id pub-id-type="pmid">15314659</pub-id></citation></ref><ref id="b15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Obata</surname><given-names>Y</given-names></name><name><surname>Tanaka</surname><given-names>T</given-names></name><name><surname>Stockert</surname><given-names>E</given-names></name><name><surname>Good</surname><given-names>RA</given-names></name></person-group><article-title>Autoimmune and lymphoproliferative disease in (B6-G<sub>IX</sub><sup>+</sup> &#x000d7; 129)F<sub>1</sub> mice: relation to naturally occurring antibodies against murine leukemia virus-related cell surface antigens</article-title><source>Proc Natl Acad Sci U S A</source><year>1979</year><volume>76</volume><fpage>5289</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">228283</pub-id></citation></ref><ref id="b16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Botto</surname><given-names>M</given-names></name><name><surname>Dell'Agnola</surname><given-names>C</given-names></name><name><surname>Bygrave</surname><given-names>AE</given-names></name><name><surname>Thompson</surname><given-names>EM</given-names></name><name><surname>Cook</surname><given-names>HT</given-names></name><name><surname>Petry</surname><given-names>F</given-names></name><etal/></person-group><article-title>Homozygous C1q deficiency causes glomerulonephritis associated with multiple apoptotic bodies</article-title><source>Nat Genet</source><year>1998</year><volume>19</volume><fpage>56</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">95902