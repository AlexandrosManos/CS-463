ames></name><name><surname>Xu</surname><given-names>L</given-names></name><name><surname>Sun</surname><given-names>J</given-names></name><etal/></person-group><year>2003</year><article-title>Transcriptional regulation of type I diabetes by NF-kappa B.</article-title><source>J Immunol</source><volume>171</volume><fpage>4886</fpage><lpage>4892</lpage><pub-id pub-id-type="pmid">14568969</pub-id></citation></ref><ref id="pone.0005028-Hilliard1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hilliard</surname><given-names>BA</given-names></name><name><surname>Mason</surname><given-names>N</given-names></name><name><surname>Xu</surname><given-names>L</given-names></name><name><surname>Sun</surname><given-names>J</given-names></name><name><surname>Lamhamedi-Cherradi</surname><given-names>SE</given-names></name><etal/></person-group><year>2002</year><article-title>Critical roles of c-Rel in autoimmune inflammation and helper T cell differentiation.</article-title><source>J Clin Invest</source><volume>110</volume><fpage>843</fpage><lpage>850</lpage><pub-id pub-id-type="pmid">12235116</pub-id></citation></ref><ref id="pone.0005028-Finn1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Finn</surname><given-names>PW</given-names></name><name><surname>He</surname><given-names>H</given-names></name><name><surname>Ma</surname><given-names>C</given-names></name><name><surname>Mueller</surname><given-names>T</given-names></name><name><surname>Stone</surname><given-names>JR</given-names></name><etal/></person-group><year>2002</year><article-title>Molecular profiling of the role of the NF-kappaB family of transcription factors during alloimmunity.</article-title><source>J Leukoc Biol</source><volume>72</volume><fpage>1054</fpage><lpage>1062</lpage><pub-id pub-id-type="pmid">12429729</pub-id></citation></ref><ref id="pone.0005028-Yang1"><label>21</label><citation citat