 align="left" rowspan="1" colspan="1">Age:</td><td align="left" rowspan="1" colspan="1">&#x0003c;24</td><td align="left" rowspan="1" colspan="1">33</td><td align="left" rowspan="1" colspan="1">18 (54.5)</td><td align="left" rowspan="1" colspan="1">9 (27.3)</td><td align="left" rowspan="1" colspan="1">6 (18.2)</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">25&#x02013;34</td><td align="left" rowspan="1" colspan="1">44</td><td align="left" rowspan="1" colspan="1">28 (63.6)</td><td align="left" rowspan="1" colspan="1">11 (25.0)</td><td align="left" rowspan="1" colspan="1">5 (11.4)</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">&#x0003e;35</td><td align="left" rowspan="1" colspan="1">26</td><td align="left" rowspan="1" colspan="1">14 (53.8)</td><td align="left" rowspan="1" colspan="1">3 (11.5)</td><td align="left" rowspan="1" colspan="1">9 (34.6)</td></tr><tr><td align="left" rowspan="1" colspan="1">Education:</td><td align="left" rowspan="1" colspan="1">Less than High School</td><td align="left" rowspan="1" colspan="1">64</td><td align="left" rowspan="1" colspan="1">40 (62.5)</td><td align="left" rowspan="1" colspan="1">14 (21.9)</td><td align="left" rowspan="1" colspan="1">10 (15.6)</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">High School and above</td><td align="left" rowspan="1" colspan="1">39</td><td align="left" rowspan="1" colspan="1">20 (51.3)</td><td align="left" rowspan="1" colspan="1">9 (23.1)</td><td align="left" rowspan="1" colspan="1">10 (25.6)</td></tr></tbody></table></table-wrap><table-wrap id="pone-0005164-t004" position="float"><object-id pub-id-type="doi">10.1371/journal.pone.0005164.t004</object-id><label>Table 4</label><caption><title>Use of Hormonal Contraceptives by Participant Characteristics<xref ref-type="table-fn" rid="nt101">&#x0002a;</xref></title></caption><graphic id="pone-0005164-t004-4" xlin