r><tr><td align="center"><bold>His (H)</bold></td><td align="right">2.2</td><td align="right">2.0</td><td align="right">2.3</td><td align="right">2.1</td><td align="right">2.3</td><td align="right">1.9</td><td align="right">2.1</td><td align="right">0.2</td><td align="right">2.1</td><td align="right">2.1</td><td align="right">2.3</td><td align="right">1.9</td><td align="right">2.4</td><td align="right">1.8</td><td align="right">2.1</td><td align="right">0.2</td><td align="right">0.206</td></tr><tr><td align="center"><bold>Ile (I)</bold></td><td align="right">7.2</td><td align="right">7.1</td><td align="right">6.9</td><td align="right">7.4</td><td align="right">6.2</td><td align="right">5.0</td><td align="right">6.6</td><td align="right">0.9</td><td align="right">7.1</td><td align="right">7.2</td><td align="right">6.0</td><td align="right">6.3</td><td align="right">6.0</td><td align="right">7.9</td><td align="right">6.8</td><td align="right">0.8</td><td align="right">-0.298</td></tr><tr><td align="center"><bold>Lys (K)</bold></td><td align="right">6.1</td><td align="right">5.7</td><td align="right">5.2</td><td align="right">6.1</td><td align="right">5.1</td><td align="right">3.3</td><td align="right">5.2</td><td align="right">1.0</td><td align="right">6.3</td><td align="right">8.9</td><td align="right">4.4</td><td align="right">4.3</td><td align="right">4.9</td><td align="right">8.1</td><td align="right">6.2</td><td align="right">2.0</td><td align="right">-1.019</td></tr><tr><td align="center"><bold>Leu (L)</bold></td><td align="right">10.3</td><td align="right">10.4</td><td align="right">10.1</td><td align="right">10.7</td><td align="right">10.1</td><td align="right">10.4</td><td align="right">10.3</td><td align="right">0.2</td><td align="right">10.5</td><td align="right">11.2</td><td align="right">10.7</td><td align="right">11.4</td><td align="right">10.8</td><td align="right">9.6</td><td align="right">10.7</td><td align="right">0.6</td><td align="right"><bold>-1.3