align="top">3107</td><td colspan="1" rowspan="1" align="center" valign="top">17</td><td colspan="1" rowspan="1" align="center" valign="top">43</td><td colspan="1" rowspan="1" align="center" valign="top">40</td><td colspan="1" rowspan="1" align="center" valign="top">4.5 (2.4 to 8.7)</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Other</td><td colspan="1" rowspan="1" align="center" valign="top">239</td><td colspan="1" rowspan="1" align="center" valign="top">26</td><td colspan="1" rowspan="1" align="center" valign="top">40</td><td colspan="1" rowspan="1" align="center" valign="top">34</td><td colspan="1" rowspan="1" align="center" valign="top">3.4 (1.5 to 7.6)</td></tr><tr><td colspan="7" rowspan="1" align="left" valign="top">Marital status:</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Married</td><td colspan="1" rowspan="1" align="center" valign="top">924</td><td colspan="1" rowspan="1" align="center" valign="top">33</td><td colspan="1" rowspan="1" align="center" valign="top">46</td><td colspan="1" rowspan="1" align="center" valign="top">22</td><td colspan="1" rowspan="3" align="center" valign="middle">0.0001</td><td colspan="1" rowspan="1" align="center" valign="top">1.0</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Unmarried couple</td><td colspan="1" rowspan="1" align="center" valign="top">273</td><td colspan="1" rowspan="1" align="center" valign="top">11</td><td colspan="1" rowspan="1" align="center" valign="top">54</td><td colspan="1" rowspan="1" align="center" valign="top">35</td><td colspan="1" rowspan="1" align="center" valign="top">2.5 (1.6 to 4.0)</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Single/widowed/divorced</td><td colspan="1" rowspan="1" align="center" valign="top">3618</td><td colspan="1" rowspan="1" align="center" valign="top">20</td><td colspan="1" rowspan="1" align="center" valign="top">42</td><td colspan="1" rowspan="1" align="center" valign="top">38</td><td co