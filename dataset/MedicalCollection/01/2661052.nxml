-title>Thermodynamic scaling behavior in genechips</article-title><source>BMC Bioinformatics</source><year>2009</year><volume>10</volume><fpage>3</fpage><pub-id pub-id-type="pmid">19123958</pub-id><pub-id pub-id-type="doi">10.1186/1471-2105-10-3</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burden</surname><given-names>CJ</given-names></name><name><surname>Pittelkow</surname><given-names>Y</given-names></name><name><surname>Wilson</surname><given-names>SR</given-names></name></person-group><article-title>Adsorption models of hybridization and post-hybridization behaviour on oligonucleotide microarrays</article-title><source>J Phys: Cond Matt</source><year>2006</year><volume>18</volume><fpage>5545</fpage><pub-id pub-id-type="doi">10.1088/0953-8984/18/23/024</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Held</surname><given-names>GA</given-names></name><name><surname>Grinstein</surname><given-names>G</given-names></name><name><surname>Tu</surname><given-names>Y</given-names></name></person-group><article-title>Relationship between gene expression and observed intensities in DNA microarrays-a modeling study</article-title><source>Nucleic Acids Res</source><year>2006</year><volume>34</volume><fpage>e70</fpage><pub-id pub-id-type="pmid">16723429</pub-id><pub-id pub-id-type="doi">10.1093/nar/gkl122</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Skvortsov</surname><given-names>D</given-names></name><name><surname>Abdueva</surname><given-names>D</given-names></name><name><surname>Curtis</surname><given-names>C</given-names></name><name><surname>Schaub</surname><given-names>B</given-names></name><name><surname>Tavar&#x000e9;</surname><given-names>S</given-names></name></person-group><article-title>Explaining differences in saturati