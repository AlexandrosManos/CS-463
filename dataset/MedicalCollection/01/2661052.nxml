oup person-group-type="author"><name><surname>Lipshutz</surname><given-names>RJ</given-names></name><name><surname>Fodor</surname><given-names>SPA</given-names></name><name><surname>Gingeras</surname><given-names>TR</given-names></name><name><surname>Lockhart</surname><given-names>DJ</given-names></name></person-group><article-title>High density synthetic oligonucleotide arrays</article-title><source>Nat Genet</source><year>1999</year><volume>21</volume><fpage>20</fpage><pub-id pub-id-type="pmid">9915496</pub-id><pub-id pub-id-type="doi">10.1038/4447</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Binder</surname><given-names>H</given-names></name></person-group><article-title>Thermodynamics of competitive surface adsorption on DNA microarrays</article-title><source>J Phys: Cond Matt</source><year>2006</year><volume>18</volume><fpage>S491</fpage><pub-id pub-id-type="doi">10.1088/0953-8984/18/18/S02</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carlon</surname><given-names>E</given-names></name><name><surname>Heim</surname><given-names>T</given-names></name></person-group><article-title>Thermodynamics of RNA/DNA hybridization in high-density oligonucleotide microarrays</article-title><source>Physica A</source><year>2006</year><volume>362</volume><fpage>433</fpage><pub-id pub-id-type="doi">10.1016/j.physa.2005.09.067</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sugimoto</surname><given-names>N</given-names></name><etal></etal></person-group><article-title>Thermodynamic Parameters To Predict Stability of RNA/DNA Hybrid Duplexes</article-title><source>Biochemistry</source><year>1995</year><volume>34</volume><fpage>11211</fpage><pub-id pub-id-type="pmid">7545436</pub-id><pub-id pub-id-type="doi">10.1021/bi00035a029</pub-id></cita