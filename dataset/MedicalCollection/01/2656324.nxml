pe="table-fn" rid="tfn1-ndt-3-823">*</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Withdrawal secondary to adverse events</td><td align="left" rowspan="1" colspan="1">4.3%</td><td align="left" rowspan="1" colspan="1">6.4% <xref ref-type="table-fn" rid="tfn1-ndt-3-823">*</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Adverse Events, total</td><td align="left" rowspan="1" colspan="1">77.1%</td><td align="left" rowspan="1" colspan="1">90.0% <xref ref-type="table-fn" rid="tfn1-ndt-3-823">*</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Somnolence</td><td align="left" rowspan="1" colspan="1">12.9%</td><td align="left" rowspan="1" colspan="1">37.1% <xref ref-type="table-fn" rid="tfn1-ndt-3-823">*</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Headache</td><td align="left" rowspan="1" colspan="1">18.6%</td><td align="left" rowspan="1" colspan="1">21.4% <xref ref-type="table-fn" rid="tfn1-ndt-3-823">*</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Dizziness</td><td align="left" rowspan="1" colspan="1">10.0%</td><td align="left" rowspan="1" colspan="1">22.1% <xref ref-type="table-fn" rid="tfn1-ndt-3-823">*</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Hypertonia</td><td align="left" rowspan="1" colspan="1">2.9%</td><td align="left" rowspan="1" colspan="1">11.4% <xref ref-type="table-fn" rid="tfn1-ndt-3-823">*</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Nausea</td><td align="left" rowspan="1" colspan="1">10.0%</td><td align="left" rowspan="1" colspan="1">11.4% <xref ref-type="table-fn" rid="tfn1-ndt-3-823">*</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Akathisia</td><td align="left" rowspan="1" colspan="1">5.7%</td><td align="left" rowspan="1" colspan="1">10.7% <xref ref-type="table-fn" rid="tfn1-ndt-3-823">*</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">Mean QTc</td><td align="left" rowspan="1" colspan="1">Not reported</td><td align="left" row