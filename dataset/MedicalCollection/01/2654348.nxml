erson-group person-group-type="author"><name><surname>Schwarz</surname><given-names>T</given-names></name><name><surname>Luger</surname><given-names>TA</given-names></name></person-group><article-title>Effect of UV irradiation on epidermal cell cytokine production</article-title><source>J Photochem Photobiol B</source><year>1989</year><volume>4</volume><issue>1</issue><fpage>1</fpage><lpage>13</lpage></citation><citation citation-type="display-unstructured">Schwarz T, Luger TA (1989) Effect of UV irradiation on epidermal cell cytokine production. J Photochem Photobiol B 4(1):1&#x02013;13 <pub-id pub-id-type="pmid">2509656</pub-id></citation></ref><ref id="CR13"><label>13.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marathe</surname><given-names>GK</given-names></name><etal/></person-group><article-title>Ultraviolet B radiation generates platelet-activating factor-like phospholipids underlying cutaneous damage</article-title><source>J Biol Chem</source><year>2005</year><volume>280</volume><issue>42</issue><fpage>35448</fpage><lpage>35457</lpage></citation><citation citation-type="display-unstructured">Marathe GK et al (2005) Ultraviolet B radiation generates platelet-activating factor-like phospholipids underlying cutaneous damage. J Biol Chem 280(42):35448&#x02013;35457 <pub-id pub-id-type="pmid">16115894</pub-id></citation></ref><ref id="CR14"><label>14.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pei</surname><given-names>Y</given-names></name><etal/></person-group><article-title>Activation of the epidermal platelet-activating factor receptor results in cytokine and cyclooxygenase-2 biosynthesis</article-title><source>J Immunol</source><year>1998</year><volume>161</volume><issue>4</issue><fpage>1954</fpage><lpage>1961</lpage></citation><citation citation-type="display-unstructured">Pei Y et al (1998) Activation of the epidermal platelet-activating factor receptor results in cytokine and cyclooxygenase-2 biosynthesis. J Immunol 161(4):1954&#x02013;1961 <pub-id pub-id-type="pmid">9712066</pub-id></citation></ref><ref id="CR15"><label>15.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Walterscheid</surname><given-names>JP</given-names></name><name><surname>llrich</surname><given-names>SE</given-names></name><name><surname>Nghiem</surname><given-names>DX</given-names></name></person-group><article-title>Platelet-activating factor, a molecular sensor for cellular damage, activates systemic immune suppression</article-title><source>J Exp Med</source><year>2002</year><volume>195</volume><issue>2</issue><fpage>171</fpage><lpage>179</lpage></citation><citation citation-type="display-unstructured">Walterscheid JP, llrich SE, Nghiem DX (2002) Platelet-activating factor, a molecular sensor for cellular damage, activates systemic immune suppression. J Exp Med 195(2):171&#x02013;179 <pub-id pub-id-type="pmid">11805144</pub-id></citation></ref><ref id="CR16"><label>16.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ullrich</surname><given-names>SE</given-names></name></person-group><article-title>Mechanisms underlying UV-induced immune suppression</article-title><source>Mutat Res</source><year>2005</year><volume>571</volume><issue>1&#x02013;2</issue><fpage>185</fpage><lpage>205</lpage></citation><citation citation-type="display-unstructured">Ullrich SE (2005) Mechanisms underlying UV-induced immune suppression. Mutat Res 571(1&#x02013;2):185&#x02013;205 <pub-id pub-id-type="pmid">15748647</pub-id></citation></ref><ref id="CR17"><label>17.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hsu</surname><given-names>MY</given-names></name><name><surname>Meier</surname><given-names>F</given-names></name><name><surname>Herlyn</surname><given-names>M</given-names></name></person-group><article-title>Melanoma development and progression: a conspiracy between tumor and host</article-title><source>Differentiation</source><year>2002</year><volume>70</volume><issue>9&#x02013;10</issue><fpage>522</fpage><lpage>536</lpage></citation><citation citation-type="display-unstructured">Hsu MY, Meier F, Herlyn M (2002) Melanoma development and progression: a conspiracy between tumor and host. Differentiation 70(9&#x02013;10):522&#x02013;536 <pub-id pub-id-type="pmid">12492494</pub-id></citation></ref><ref id="CR18"><label>18.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gaggioli</surname><given-names>C</given-names></name><etal/></person-group><article-title>Fibroblast-led collective invasion of carcinoma cells with differing roles for RhoGTPases in leading and following cells</article-title><source>Nat Cell Biol</source><year>2007</year><volume>9</volume><issue>12</issue><fpage>1392</fpage><lpage>1400</lpage></citation><citation citation-type="display-unstructured">Gaggioli C et al (2007) Fibroblast-led collective invasion of carcinoma cells with differing roles for RhoGTPases in leading and following cells. Nat Cell Biol 9(12):1392&#x02013;1400 <pub-id pub-id-type="pmid">18037882</pub-id></citation></ref><ref id="CR19"><label>19.</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Palma</surname><given-names>M</given-names></name><etal/></person-group><article-title>Tie2 identifies a hematopoietic lineage of proangiogenic monocytes required for tumor vessel formation and a mesenchymal population of pericyte progenitors</article-title><source>Cancer Cell</source><year>2005</year><volume>8</volume><issue>3</issue><fpage>211</fpage><lpage>226</lpage></citation><citation citation-type="display-unstructured">De Palma M et al (2005) Tie2 identifies a hematopoietic lineage of proangiogenic monocytes required for tumor vessel formation and a mesenchymal population of pericyte progeni