"ref8"><mixed-citation id="cit8" publication-type="journal"><name><surname>Blasiak</surname><given-names>L. C.</given-names></name>; <name><surname>Vaillancourt</surname><given-names>F. H.</given-names></name>; <name><surname>Walsh</surname><given-names>C. T.</given-names></name>; <name><surname>Drennan</surname><given-names>C. L.</given-names></name> <source>Nature</source> <year>2006</year>, <volume>440</volume>, 368&#x02013;71.<pub-id pub-id-type="pmid">16541079</pub-id></mixed-citation></ref><ref id="ref9"><mixed-citation id="cit9" publication-type="journal"><name><surname>Vaillancourt</surname><given-names>F. H.</given-names></name>; <name><surname>Vosburg</surname><given-names>D. A.</given-names></name>; <name><surname>Walsh</surname><given-names>C. T.</given-names></name> <source>Chembiochem</source> <year>2006</year>, <volume>7</volume>, 748&#x02013;752.<pub-id pub-id-type="pmid">16528784</pub-id></mixed-citation></ref><ref id="ref10"><mixed-citation id="cit10" publication-type="journal"><name><surname>Chenna</surname><given-names>R.</given-names></name>; <name><surname>Sugawara</surname><given-names>H.</given-names></name>; <name><surname>Koike</surname><given-names>T.</given-names></name>; <name><surname>Lopez</surname><given-names>R.</given-names></name>; <name><surname>Gibson</surname><given-names>T. J.</given-names></name>; <name><surname>Higgins</surname><given-names>D. G.</given-names></name>; <name><surname>Thompson</surname><given-names>J. D.</given-names></name> <source>Nucleic Acids Res.</source> <year>2003</year>, <volume>31</volume>, 3497&#x02013;3500.<pub-id pub-id-type="pmid">12824352</pub-id></mixed-citation></ref><ref id="ref11"><mixed-citation id="cit11" publication-type="journal"><name><surname>Dunwell</surname><given-names>J. M.</given-names></name>; <name><surname>Purvis</surname><given-names>A.</given-names></name>; <name><surname>Khuri</surname><given-names>S.</given-names></name> <source>Phytochemistry</source> <year>2004</year>, <volume>65</volume>, 7&#x02013;17.<pub-id pub-id-type="pmid">14697267</pub-id></mixed-citation></ref><ref id="ref12"><mixed-citation id="cit12" publication-type="journal"><name><surname>Hegg</surname><given-names>E. L.</given-names></name>; <name><surname>Que</surname><given-names>L., Jr.</given-names></name> <source>Eur. J. Biochem.</source> <year>1997</year>, <volume>250</volume>, 625&#x02013;629.<pub-id pub-id-type="pmid">9461283</pub-id></mixed-citation></ref><ref id="ref13"><mixed-citation id="cit13" publication-type="journal"><name><surname>Clifton</surname><given-names>I. J.</given-names></name>; <name><surname>McDonough</surname><given-names>M. A.</given-names></name>; <name><surname>Ehrismann</surname><given-names>D.</given-names></name>; <name><surname>Kershaw</surname><given-names>N. J.</given-names></name>; <name><surname>Granatino</surname><given-names>N.</given-names></name>; <name><surname>Schofield</surname><given-names>C. J.</given-names></name> <source>J. Inorg. Biochem.</source> <year>2006</year>, <volume>100</volume>, 644&#x02013;669.<pub-id pub-id-type="pmid">16513174</pub-id></mixed-citation></ref><ref id="ref14"><mixed-citation id="cit14" publication-type="journal"><name><surname>Price</surname><given-names>J. C.</given-names></name>; <name><surname>Barr</surname><given-names>E. W.</given-names></name>; <name><surname>Tirupati</surname><given-names>B.</given-names></name>; <name><surname>Bollinger</surname><given-names>J. M.</given-names></name>; <name><surname>Krebs</surname><given-names>C.</given-names></name> <source>Biochemistry</source> <year>2004</year>, <volume>43</volume>, 1134&#x02013;1134.</mixed-citation></ref><ref id="ref15"><mixed-citation id="cit15" publication-type="journal"><name><surname>Price</surname><given-names>J. C.</given-names></name>; <name><surname>Barr</surname><given-names>E. W.</given-names></name>; <name><surname>Glass</surname><given-names>T. E.</given-names></name>; <name><surname>Krebs</surname><given-names>C.</giv