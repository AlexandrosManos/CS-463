e><surname>Arntzen</surname><given-names>A</given-names></name><name><surname>Samuelsen</surname><given-names>SO</given-names></name><name><surname>Dalteveit</surname><given-names>AK</given-names></name><name><surname>Stolttenberg</surname><given-names>C</given-names></name></person-group><article-title>Post-neonatal mortality in Norway 1969&#x02013;95: a cause-specific analysis</article-title><source>Int J Epidemiol</source><year>2006</year><volume>35</volume><fpage>1083</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">16556644</pub-id></citation></ref><ref id="B15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stone</surname><given-names>DH</given-names></name><name><surname>Womersley</surname><given-names>J</given-names></name></person-group><article-title>Distribution of congenital anomalies within a city: associations with housing type</article-title><source>Eur J Epidemiol</source><year>1989</year><volume>5</volume><fpage>255</fpage></citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ericson</surname><given-names>A</given-names></name><name><surname>Eriksson</surname><given-names>M</given-names></name><name><surname>Zetterstrom</surname><given-names>R</given-names></name></person-group><article-title>The incidence of congenital malformations in various socio-occupational groups in Sweden</article-title><source>Acta Paediatr Scand</source><year>1984</year><volume>73</volume><fpage>664</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">6485786</pub-id></citation></ref><ref id="B17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tuohy</surname><given-names>PG</given-names></name><name><surname>Counsell</surname><given-names>AM</given-names></name><name><surname>Geddis</surname><given-names>DC</given-names></name></person-group><article-title>The Plunket Nation