r"><name><surname>Lepor</surname><given-names>H</given-names></name></person-group><article-title>Long-term evaluation of tamsulosin in benign prostatic hyperplasia: placebo-controlled, double-blind extension of phase III trial. The Tamsulosin Investigator Group</article-title><source>Urology</source><year>1998</year><volume>51</volume><fpage>901</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">9609624</pub-id></citation></ref><ref id="b18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lepor</surname><given-names>H</given-names></name></person-group><article-title>Phase III multicenter placebo-controlled study of tamsulosin in benign prostatic hyperplasia. Tamsulosin Investigator Group</article-title><source>Urology</source><year>1998</year><volume>51</volume><fpage>892</fpage><lpage>900</lpage><pub-id pub-id-type="pmid">9609623</pub-id></citation></ref><ref id="b19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dickersin</surname><given-names>K</given-names></name><name><surname>Scherer</surname><given-names>R</given-names></name><name><surname>Lefebvre</surname><given-names>C</given-names></name></person-group><article-title>Identifying relevant studies for systematic reviews</article-title><source>BMJ</source><year>1994</year><volume>309</volume><fpage>1286</fpage><lpage>91</lpage><pub-id pub-id-type="pmid">7718048</pub-id></citation></ref><ref id="b20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jadad</surname><given-names>AR</given-names></name><name><surname>Moore</surname><given-names>A</given-names></name><name><surname>Carroll</surname><given-names>D</given-names></name><etal/></person-group><article-title>Assessing the quality of reports of randomized clinical trials: Is blinding necessary?</article-title><source>Controlled Clin Trials</source><year>1996</year><volume>17</v