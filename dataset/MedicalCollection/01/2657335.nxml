e-title>Flexor tendon surgery. Part 1: primary flexor tendon repair</article-title><source>J Hand Surg</source><year>1989</year><volume>14B</volume><fpage>261</fpage><lpage>272</lpage></mixed-citation></ref><ref id="CR7"><label>7.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Tang</surname><given-names>JB</given-names></name><name><surname>Shi</surname><given-names>D</given-names></name></person-group><article-title>Subdivision of flexor tendon &#x0201c;no man&#x02019;s land&#x0201d; and different treatment methods in each sub-zone. A preliminary report</article-title><source>Chin Med J</source><year>1992</year><volume>105</volume><fpage>60</fpage><lpage>68</lpage><pub-id pub-id-type="pmid">1576873</pub-id></mixed-citation></ref><ref id="CR8"><label>8.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Tang</surname><given-names>JB</given-names></name><name><surname>Shi</surname><given-names>D</given-names></name><name><surname>Gu</surname><given-names>YQ</given-names></name><name><surname>Chen</surname><given-names>JC</given-names></name><name><surname>Zhou</surname><given-names>B</given-names></name></person-group><article-title>Double and multiple looped suture tendon repair</article-title><source>J Hand Surg</source><year>1994</year><volume>19B</volume><fpage>699</fpage><lpage>703</lpage></mixed-citation></ref><ref id="CR9"><label>9.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Tang</surname><given-names>JB</given-names></name></person-group><article-title>Clinical outcomes associated with flexor tendon repair</article-title><source>Hand Clinic</source><year>2005</year><volume>21</volume><fpage>199</fpage><lpage>210</lpage><pub-id pub-id-type="doi">10.1016/j.hcl.2004.11.005</pub-id></mixed-citation></ref><ref id="CR10"><label>10.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Boyes</surname><given-names>JH</given-names></name></person-group><article-title>Flexor tendon grafts in the fingers and thumb: an evaluation of end results</article-title><source>J Bone Joint Surg</source><year>1950</year><volume>32A</volume><fpage>489</fpage><lpage>499</lpage><pub-id pub-id-type="pmid">15428471</pub-id></mixed-citation></ref><ref id="CR11"><label>11.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Strickland</surname><given-names>JW</given-names></name></person-group><article-title>Flexor tendon repair</article-title><source>Hand Clinic</source><year>1985</year><volume>1</volume><fpage>55</fpage><lpage>68</lpage></mixed-citation></ref><ref id="CR12"><label>12.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Strickland</surname><given-names>JW</given-names></name></person-group><article-title>Flexor Tendon Injuries: I. Foundation of treatment</article-title><source>J Am Acad Orthop Surg</source><year>1995</year><volume>3</volume><fpage>44</fpage><lpage>54</lpage><pub-id pub-id-type="pmid">10790652</pub-id></mixed-citation></ref><ref id="CR13"><label>13.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Strickland</surname><given-names>JW</given-names></name></person-group><article-title>Development of flexor tendon surgery: twenty-five years of progress</article-title><source>J Hand Surg</source><year>2000</year><volume>25A</volume><fpage>214</fpage><lpage>235</lpage></mixed-citation></ref><ref id="CR14"><label>14.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lewis</surname><given-names>N</given-names></name><name><surname>Quitkin</surname><given-names>HM</given-names></name></person-group><article-title>Strength analysis and comparison of the Teno Fix tendon repair system with the two-strand modified Kessler repair in the Achilles tendon</article-title><source>Foot Ankle Int</source><year>2003</year><volume>24</volume><fpage>857</fpage><lpage>860</lpage><pub-id pub-id-type="pmid">14655891</pub-id></mixed-citation></ref><ref id="CR15"><label>15.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Robertson</surname><given-names>GA</given-names></name><name><surname>Al-Quattan</surname><given-names>MM</given-names></name></person-group><article-title>A biomechanical analysis of a new interlock suture for flexor tendon repair</article-title><source>Journal of Hand Surg</source><year>1992</year><volume>17B</volume><fpage>92</fpage><lpage>93</lpage></mixed-citation></ref><ref id="CR16"><label>16.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wade</surname><given-names>PJ</given-names></name><name><surname>Wetherell</surname><given-names>RG</given-names></name><name><surname>Amis</surname><given-names>AA</given-names></name></person-group><article-title>Flexor tendon repair: significant gain in strength from the Halsted peripheral suture technique</article-title><source>J Hand Surg</source><year>1989</year><volume>14B</volume><fpage>232</fpage><lpage>235</lpage></mixed-citation></ref><ref id="CR17"><label>17.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Trail</surname><given-names>IA</given-names></name><name><surname>Powell</surname><given-names>ES</given-names></name><name><surname>Noble</surname><given-names>J</given-names></name></person-group><article-title>The mechanical strength of various suture techniques</article-title><source>J Hand Surg</source><year>1992</year><volume>17B</volume><fpage>89</fpage><lpage>91</lpage></mixed-citation></ref><ref id="CR18"><label>18.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Seradge</surname><given-names>H</given-names></name></person-group><article-title>Elongation of the repair configuration following flexor tendon repair</article-title><source>J Hand Surg</source><year>1983</year><volume>8A</volume><fpage>182</fpage><lpage>185</lpage></mixed-citation></ref><ref id="CR19"><label>19.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Barrie</surname><given-names>KA</given-names></name><name><surname>Tomak</surname><given-names>SL</given-names></name><name><surname>Cholewicki</surname><given-names>J</given-names></name></person-group><article-title>Effect of suture locking and suture calibre on fatigue strength of flexor tendon repairs</article-title><source>J Hand Surg</source><year>2001</year><volume>26A</volume><fpage>340</fpage><lpage>346</lpage></mixed-citation></ref><ref id="CR20"><label>20.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wong</surname><given-names>JKF</given-names></name><name><surname>Cerovac</surname><given-names>S</given-names></name><name><surname>Ferguson</surname><given-names>MWJ</given-names></name><name><surname>McGrouther</surname><given-names>DA</given-names></name></person-group><article-title>The Cellular effect of a single interrupted suture on tendon</article-title><source>J Hand Surg</source><year>2006</year><volume>31B</volume><fpage>358</fpage><lpage>367</lpage></mixed-citation></ref><ref id="CR21"><label>21.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gelberman</surname><given-names>RH</given-names></name><name><surname>Woo</surname><given-names>SL</given-names></name><name><surname>Amiel</surname><given-names>D</given-names></name><name><surname>Horibe</surname><given-names>S</given-names></name><name><surname>Lee</surname><given-names>D</given-names></name></person-group><article-title>Influences of flexor sheath continuity and early motion on tendon healing in dogs</article-title><source>J Hand Surg</source><year>1990</year><volume>15A</volume><fpage>69</fpage><lpage>77</lpage></mixed-citation></ref><ref id="CR22"><label>22.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ketchum</surname><given-names>LD</given-names></name></person-group><article-title>Suture materials and suture techniques used in tendon repair</article-title><source>Hand Clinic</source><year>1985</year><volume>1</volume><fpage>43</fpage><lpage>53</lpage></mixed-citation></ref></ref-list></back></article>