-group><article-title>Apresenta&#x000e7;&#x000e3;o por est&#x000e1;dios do c&#x000e2;ncer de mama entre mulheres que procuraram o instituto nacional de c&#x000e2;ncer entre Janeiro de 1983 e Dezembro de 2005</article-title><source>XVIII IEA World Congress of Epidemiology</source><year>2008</year><publisher-name>Porto Alegre: ABRASCO</publisher-name></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>de Moraes</surname><given-names>AB</given-names></name><name><surname>Zanini</surname><given-names>RR</given-names></name><name><surname>Turchiello</surname><given-names>MS</given-names></name><name><surname>Riboldi</surname><given-names>J</given-names></name><name><surname>de Medeiros</surname><given-names>LR</given-names></name></person-group><article-title>Survival study of breast cancer patients treated at the hospital of the Federal University in Santa Maria, Rio Grande do Sul, Brazil</article-title><source>Cad Saude Publica</source><year>2006</year><volume>22</volume><fpage>2219</fpage><lpage>2228</lpage><pub-id pub-id-type="pmid">16951894</pub-id></citation></ref><ref id="B11"><citation citation-type="book"><person-group person-group-type="author"><collab>Minist&#x000e9;rio da Sa&#x000fa;de</collab></person-group><source>Estimativa 2008 &#x02013; Incid&#x000ea;ncia de C&#x000e2;ncer no Brasil</source><year>2007</year><publisher-name>Rio de Janeiro: INCA</publisher-name><fpage>76</fpage></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><collab>Instituto Brasileiro de Geografia e Estat&#x000ed;stica</collab></person-group><source>Pesquisa Nacional por Amostra de Domic&#x000ed;lios &#x02013; Acesso e Utiliza&#x000e7;&#x000e3;o de Servi&#x000e7;os de Sa&#x000fa;de</source><year>2003</year><publisher-name>Rio de Janeiro</publisher-name></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><collab>Mini