n-type="journal"><person-group person-group-type="author"><name><surname>Ginis</surname><given-names>I</given-names></name><name><surname>Luo</surname><given-names>Y</given-names></name><name><surname>Miura</surname><given-names>T</given-names></name><name><surname>Thies</surname><given-names>S</given-names></name><name><surname>Brandenberger</surname><given-names>R</given-names></name><etal/></person-group><year>2004</year><article-title>Differences between human and mouse embryonic stem cells.</article-title><source>Dev Biol</source><volume>269</volume><fpage>360</fpage><lpage>380</lpage><pub-id pub-id-type="pmid">15110706</pub-id></citation></ref><ref id="pone.0004970-Pera1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Pera</surname><given-names>MF</given-names></name><name><surname>Trounson</surname><given-names>AO</given-names></name></person-group><year>2004</year><article-title>Human embryonic stem cells: prospects for development.</article-title><source>Development</source><volume>131</volume><fpage>5515</fpage><lpage>5525</lpage><pub-id pub-id-type="pmid">15509763</pub-id></citation></ref><ref id="pone.0004970-Koestenbauer1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Koestenbauer</surname><given-names>S</given-names></name><name><surname>Zech</surname><given-names>NH</given-names></name><name><surname>Juch</surname><given-names>H</given-names></name><name><surname>Vanderzwalmen</surname><given-names>P</given-names></name><name><surname>Schoonjans</surname><given-names>L</given-names></name><etal/></person-group><year>2006</year><article-title>Embryonic stem cells: similarities and differences between human and murine embryonic stem cells.</article-title><source>Am J Reprod Immunol</source><volume>55</volume><fpage>169</fpage><lpage>180</lpage><pub-id pub-id-type="pmid">16451351</pub-id></citation></ref><ref id="pone.0004970-Silva1"><