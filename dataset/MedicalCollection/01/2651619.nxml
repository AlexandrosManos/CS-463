688</td></tr></tbody></table></table-wrap><table-wrap id="T4" position="float"><label>Table 4</label><caption><p>The effect of diabetes on the association between birth weight and gender in subjects with coronary artery disease.</p></caption><table frame="hsides" rules="groups"><thead valign="top"><tr><th colspan="3" rowspan="1"/><th colspan="4" rowspan="1">NON DIABETIC</th><th colspan="2" rowspan="1">DIABETIC</th></tr><tr><th colspan="3" rowspan="1"/><th colspan="3" rowspan="1">females</th><th rowspan="1" colspan="1">males</th><th rowspan="1" colspan="1">females</th><th rowspan="1" colspan="1">males</th></tr></thead><tbody valign="top"><tr><td colspan="3" rowspan="1">Birth Weight</td><td colspan="3" rowspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td colspan="3" rowspan="1">&#x02264; 2500 g</td><td colspan="3" rowspan="1">9.1%</td><td rowspan="1" colspan="1">2.2%</td><td rowspan="1" colspan="1">7.1%</td><td rowspan="1" colspan="1">0.0%</td></tr><tr><td colspan="3" rowspan="1">&#x0003e;2500 g &#x02264;3500 g</td><td colspan="3" rowspan="1">79.5%</td><td rowspan="1" colspan="1">52.2%</td><td rowspan="1" colspan="1">50.0%</td><td rowspan="1" colspan="1">75.0%</td></tr><tr><td colspan="3" rowspan="1">&#x0003e;3500 g</td><td colspan="3" rowspan="1">11.4%</td><td rowspan="1" colspan="1">45.7%</td><td rowspan="1" colspan="1">42.9%</td><td rowspan="1" colspan="1">25.0%</td></tr><tr><td colspan="3" rowspan="1">Total n&#x000b0;</td><td colspan="3" rowspan="1">44</td><td rowspan="1" colspan="1">46</td><td rowspan="1" colspan="1">14</td><td rowspan="1" colspan="1">20</td></tr><tr><td colspan="2" rowspan="1">Chi square</td><td rowspan="1" colspan="1">&#x003c7;<sup>2</sup></td><td colspan="4" rowspan="1">13.659</td><td colspan="2" rowspan="1">3.036</td></tr><tr><td colspan="2" rowspan="1">test of</td><td rowspan="1" colspan="1">df</td><td colspan="4" rowspan="1">2</td><td colspan="2" rowspan="1">2</td></tr><tr><td cols