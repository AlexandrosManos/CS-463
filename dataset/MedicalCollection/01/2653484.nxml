son-group person-group-type="author"><name><surname>Laraia</surname><given-names>BA</given-names></name><name><surname>Siega-Riz</surname><given-names>AM</given-names></name><name><surname>Kaufman</surname><given-names>JS</given-names></name><name><surname>Jones</surname><given-names>SJ</given-names></name></person-group><article-title>Proximity of supermarkets is positively associated with diet quality index for pregnancy</article-title><source>Preventive Medicine</source><year>2004</year><volume>39</volume><fpage>869</fpage><lpage>875</lpage><pub-id pub-id-type="pmid">15475018</pub-id><pub-id pub-id-type="doi">10.1016/j.ypmed.2004.03.018</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rose</surname><given-names>D</given-names></name><name><surname>Richards</surname><given-names>R</given-names></name></person-group><article-title>Food store access and household fruit and vegetable use among participants in the US Food Stamp Program</article-title><source>Public Health Nutrition</source><year>2004</year><volume>7</volume><fpage>1081</fpage><lpage>1088</lpage><pub-id pub-id-type="pmid">15548347</pub-id><pub-id pub-id-type="doi">10.1079/PHN2004648</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cheadle</surname><given-names>A</given-names></name><name><surname>Psaty</surname><given-names>BM</given-names></name><name><surname>Curry</surname><given-names>S</given-names></name><name><surname>Wagner</surname><given-names>E</given-names></name><name><surname>Diehr</surname><given-names>P</given-names></name><name><surname>Koepsell</surname><given-names>T</given-names></name><name><surname>Kristal</surname><given-names>A</given-names></name></person-group><article-title>Can Measures of the Grocery Store Environment Be Used to Track Community-Level Dietary Changes?</article-title><source>Preventive Medicine</source>