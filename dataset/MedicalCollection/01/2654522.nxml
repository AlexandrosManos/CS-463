eft" rowspan="1" colspan="1">453</td><td align="left" rowspan="1" colspan="1">55</td><td align="left" rowspan="1" colspan="1">12.1</td></tr><tr><td align="left" rowspan="1" colspan="1">Fluvoxamine</td><td align="left" rowspan="1" colspan="1">1306</td><td align="left" rowspan="1" colspan="1">63</td><td align="left" rowspan="1" colspan="1">4.8</td></tr><tr><td align="left" rowspan="1" colspan="1">Milnacipran</td><td align="left" rowspan="1" colspan="1">916</td><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">0.7</td></tr></tbody></table><table-wrap-foot><fn id="tfn1-ndt-3-181"><p><bold>Note:</bold> Significances between subgroups:</p></fn><fn id="tfn2-ndt-3-181"><label>&#x02022;</label><p>Paroxetine vs fluvoxamine, p &#x0003c; 0.001 (&#x003c7;<sup>2</sup> = 28.78, df = 1).</p></fn><fn id="tfn3-ndt-3-181"><label>&#x02022;</label><p>Paroxetine vs milnacipran, p &#x0003c; 0.001 (&#x003c7;<sup>2</sup> = 93.93, df = 1).</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>