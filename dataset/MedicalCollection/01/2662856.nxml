 applications</article-title><source>Acad Emerg Med</source><year>1998</year><volume>5</volume><fpage>637</fpage><lpage>46</lpage><pub-id pub-id-type="pmid">9660293</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bhende</surname><given-names>M</given-names></name></person-group><article-title>Capnography in the pediatric emergency department</article-title><source>Pediatr Emerg Care</source><year>1999</year><volume>15</volume><fpage>64</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">10069319</pub-id><pub-id pub-id-type="doi">10.1097/00006565-199902000-00019</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Soto</surname><given-names>RG</given-names></name><name><surname>Fu</surname><given-names>ES</given-names></name><name><surname>Vila</surname><given-names>H</given-names><suffix>Jr</suffix></name><name><surname>Miguel</surname><given-names>RV</given-names></name></person-group><article-title>Capnography accurately detects apnea during monitored anesthesia care</article-title><source>Anesth Analg</source><year>2004</year><volume>99</volume><fpage>379</fpage><lpage>82</lpage><comment>table of contents</comment><pub-id pub-id-type="pmid">15271710</pub-id><pub-id pub-id-type="doi">10.1213/01.ANE.0000131964.67524.E7</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McQuillen</surname><given-names>KK</given-names></name><name><surname>Steele</surname><given-names>DW</given-names></name></person-group><article-title>Capnography during sedation/analgesia in the pediatric emergency department</article-title><source>Pediatr Emerg Care</source><year>2000</year><volume>16</volume><fpage>401</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">11138881</pub-id><pub-id pub-id-type="doi">10.1097/00006565-200012000-00005</pub-id></citation></ref><r