on citation-type="journal"><person-group person-group-type="author"><name><surname>Salmen</surname><given-names>S</given-names></name><name><surname>Teran</surname><given-names>G</given-names></name><name><surname>Borges</surname><given-names>L</given-names></name><name><surname>Goncalves</surname><given-names>L</given-names></name><name><surname>Albarr&#x000e0;n</surname><given-names>B</given-names></name><name><surname>Urdaneta</surname><given-names>H</given-names></name><name><surname>Montes</surname><given-names>H</given-names></name><name><surname>Berrueta</surname><given-names>L</given-names></name></person-group><article-title>Increased Fas-mediated apoptosis in polymorphonuclear cells from HIV-infected patients</article-title><source>Clin Exp Immunol</source><year>2004</year><volume>137</volume><fpage>166</fpage><lpage>172</lpage><pub-id pub-id-type="pmid">15196258</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2249.2004.02503.x</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bastian</surname><given-names>A</given-names></name><name><surname>Schafer</surname><given-names>H</given-names></name></person-group><article-title>Human alpha-defensin 1 (HNP-1) inhibits adenoviral infection in vitro</article-title><source>Regul Pept</source><year>2001</year><volume>101</volume><fpage>157</fpage><lpage>161</lpage><pub-id pub-id-type="pmid">11495691</pub-id><pub-id pub-id-type="doi">10.1016/S0167-0115(01)00282-8</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fujisawa</surname><given-names>H</given-names></name></person-group><article-title>Inhibitory role of neutrophils on influenza virus multiplication in the lungs of mice</article-title><source>Microbiol Immunol</source><year>2001</year><volume>45</volume><fpage>679</fpage><lpage>688</lpage><pub-id pub-id-type="pmid">11762750</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yasin</surname><given-names>B</given-names></name><name><surname>Wang</surname><given-names>W</given-names></name><name><surname>Pang</surname><given-names>M</given-names></name><name><surname>Cheshenko</surname><given-names>N</given-names></name><name><surname>Hong</surname><given-names>T</given-names></name><name><surname>Waring</surname><given-names>AJ</given-names></name><name><surname>Herold</surname><given-names>BC</given-names></name><name><surname>Wagar</surname><given-names>EA</given-names></name><name><surname>Lehrer</surname><given-names>RI</given-names></name></person-group><article-title>Theta defensins protect cells from infection by herpes simplex virus by unhibiting viral adhesion and entry</article-title><source>J Virol</source><year>2004</year><volume>78</volume><fpage>5147</fpage><lpage>5156</lpage><pub-id pub-id-type="pmid">15113897</pub-id><pub-id pub-id-type="doi">10.1128/JVI.78.10.5147-5156.2004</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wu</surname><given-names>Z</given-names></name><name><surname>Cicchi</surname><given-names>F</given-names></name><name><surname>Gentles</surname><given-names>D</given-names></name><name><surname>Ericksen</surname><given-names>B</given-names></name><name><surname>Lubkowski</surname><given-names>J</given-names></name><name><surname>Devico</surname><given-names>A</given-names></name><name><surname>Lehrer</surname><given-names>RI</given-names></name><name><surname>Lu</surname><given-names>W</given-names></name></person-group><article-title>Human neutrophil alpha-defensin 4 inhibits HIV-1 infection in vitro</article-title><source>FEBS Lett</source><year>2005</year><volume>579</volume><fpage>162</fpage><lpage>166</lpage><pub-id pub-id-type="pmid">15620707</pub-id><pub-id pub-id-type="doi">10.1016/j.febslet.2004.11.062</pub-id></citat