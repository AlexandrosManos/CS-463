lspan="1">42 (29 to 55)</td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>Alcohol use</bold><xref ref-type="table-fn" rid="nt144">b</xref></td><td align="left" rowspan="1" colspan="1">Cardiovascular diseases</td><td align="left" rowspan="1" colspan="1">NA</td><td align="left" rowspan="1" colspan="1">11 (4 to 34)</td><td align="left" rowspan="1" colspan="1">131 (93 to 159)</td><td align="left" rowspan="1" colspan="1">&#x02212;42 (&#x02212;75 to &#x02212;7)</td><td align="left" rowspan="1" colspan="1">105 (85 to 126)</td><td align="left" rowspan="1" colspan="1">&#x02212;5 (&#x02212;26 to 15)</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Cancers</td><td align="left" rowspan="1" colspan="1">NA</td><td align="left" rowspan="1" colspan="1">5 (4 to 6)</td><td align="left" rowspan="1" colspan="1">55 (49 to 61)</td><td align="left" rowspan="1" colspan="1">40 (34 to 46)</td><td align="left" rowspan="1" colspan="1">64 (58 to 69)</td><td align="left" rowspan="1" colspan="1">36 (31 to 42)</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Diabetes mellitus</td><td align="left" rowspan="1" colspan="1">NA</td><td align="left" rowspan="1" colspan="1">5 (4 to 6)</td><td align="left" rowspan="1" colspan="1">44 (40 to 49)</td><td align="left" rowspan="1" colspan="1">51 (46 to 55)</td><td align="left" rowspan="1" colspan="1">50 (45 to 55)</td><td align="left" rowspan="1" colspan="1">50 (45 to 55)</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Other noncommunicable diseases<xref ref-type="table-fn" rid="nt145">c</xref></td><td align="left" rowspan="1" colspan="1">NA</td><td align="left" rowspan="1" colspan="1">15 (14 to 16)</td><td align="left" rowspan="1" colspan="1">68 (66 to 71)</td><td align="left" rowspan="1" colspan="1">17 (15 to 19)</td><td align="left" rowspan="1" colspan="1">74 (72 to 76)</td><td align="left" rowspan="1" colsp