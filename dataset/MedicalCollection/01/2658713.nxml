Hepatology</source><year>2004</year><volume>39</volume><fpage>862</fpage><lpage>863</lpage><comment>author reply 863</comment><pub-id pub-id-type="pmid">14999708</pub-id></citation></ref><ref id="b30"><label>30</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Burroughs</surname><given-names>AK</given-names></name><name><surname>Cholongitas</surname><given-names>E</given-names></name></person-group><article-title>Non-invasive tests for liver fibrosis: encouraging or discouraging results?</article-title><source>J Hepatol</source><year>2007</year><volume>46</volume><fpage>751</fpage><lpage>755</lpage><pub-id pub-id-type="pmid">17383047</pub-id></citation></ref><ref id="b31"><label>31</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sebastiani</surname><given-names>G</given-names></name><name><surname>Vario</surname><given-names>A</given-names></name><name><surname>Guido</surname><given-names>M</given-names></name><etal/></person-group><article-title>Stepwise combination algorithms of non-invasive markers to diagnose significant fibrosis in chronic hepatitis C</article-title><source>J Hepatol</source><year>2006</year><volume>44</volume><fpage>686</fpage><lpage>693</lpage><pub-id pub-id-type="pmid">16490278</pub-id></citation></ref></ref-list><glossary><def-list><title>Abbreviations:</title><def-item><term>ALT</term><def><p>alanine aminotransferase</p></def></def-item><def-item><term>AUC</term><def><p>area under the curve</p></def></def-item><def-item><term>BMI</term><def><p>body mass index</p></def></def-item><def-item><term>CPDR</term><def><p>cumulative per cent dose recovered</p></def></def-item><def-item><term>HCV</term><def><p>hepatitis C virus</p></def></def-item><def-item><term>MBT</term><def><p>methacetin breath test</p></def></def-item><def-item><term>NALT</term><def><p>normal alanine aminotransferase</p></def></def-item><def-item><term>PDR</term><def><p>per cent dose recovered</p></def></def-item><def-item><term>ROC</term><def><p>receiver operating characteristic</p></def></def-item><def-item><term>SD</term><def><p>standard deviation</p></def></def-item></def-list></glossary></back></article>