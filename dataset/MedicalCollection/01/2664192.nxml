" rid="b23-cln63_1p0121">23</xref></td><td align="left" rowspan="1" colspan="1">NHBD</td><td align="left" rowspan="1" colspan="1">91</td><td align="left" rowspan="1" colspan="1">91</td><td align="left" rowspan="1" colspan="1">84</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">HBD</td><td align="left" rowspan="1" colspan="1">94</td><td align="left" rowspan="1" colspan="1">92</td><td align="left" rowspan="1" colspan="1">90</td></tr><tr><td align="left" rowspan="1" colspan="1">Gok et al<xref ref-type="bibr" rid="b36-cln63_1p0121">36</xref></td><td align="left" rowspan="1" colspan="1">NHBD</td><td align="left" rowspan="1" colspan="1">92.1</td><td align="left" rowspan="1" colspan="1">-</td><td align="left" rowspan="1" colspan="1">-</td></tr><tr><td align="left" rowspan="1" colspan="1">Muiesan et al<xref ref-type="bibr" rid="b46-cln63_1p0121">46</xref></td><td align="left" rowspan="1" colspan="1">NHBD</td><td align="left" rowspan="1" colspan="1">87</td><td align="left" rowspan="1" colspan="1">-</td><td align="left" rowspan="1" colspan="1">-</td></tr></tbody></table><table-wrap-foot><fn id="tfn10-cln63_1p0121"><p>nhbd-non-heart-beating donor;hbd-heart-beating donor;y-year.</p></fn></table-wrap-foot></table-wrap><table-wrap id="t10-cln63_1p0121" position="float"><label>Table 10</label><caption><p>England centres and variations of non-heart-beating donors programmes.</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1">Centre</th><th align="left" rowspan="1" colspan="1">NHBD technique</th><th align="left" rowspan="1" colspan="1">In situ Perfusion</th><th align="left" rowspan="1" colspan="1">Immunossupression</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">Cambridge</td><td align="left" rowspan="1" colspan="1">Laparotomy + aortic cannula</td><td align="left" rowspan="1" colspan="1">UW</td><td align="left" rowspan="1" colspan="1">CSA/AZA/PRED</td></tr><tr><td a