0.001</td><td align="left" rowspan="1" colspan="1">1.78</td><td align="left" rowspan="1" colspan="1">1.33</td><td align="left" rowspan="1" colspan="1">0.067</td><td align="left" rowspan="1" colspan="1">&#x02212;2.251<xref ref-type="table-fn" rid="nt112">&#x0002a;&#x0002a;</xref></td><td align="left" rowspan="1" colspan="1">&#x02212;2.480<xref ref-type="table-fn" rid="nt112">&#x0002a;&#x0002a;</xref></td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Volga-Ural<xref ref-type="table-fn" rid="nt114">&#x0002a;2</xref></td><td align="left" rowspan="1" colspan="1">50</td><td align="left" rowspan="1" colspan="1">18 (0.36)</td><td align="left" rowspan="1" colspan="1">17</td><td align="left" rowspan="1" colspan="1">18</td><td align="left" rowspan="1" colspan="1">0.819&#x000b1;0.049</td><td align="left" rowspan="1" colspan="1">0.006&#x000b1;0.001</td><td align="left" rowspan="1" colspan="1">1.61</td><td align="left" rowspan="1" colspan="1">1.39</td><td align="left" rowspan="1" colspan="1">0.050</td><td align="left" rowspan="1" colspan="1">&#x02212;1.884<xref ref-type="table-fn" rid="nt111">&#x0002a;</xref></td><td align="left" rowspan="1" colspan="1">&#x02212;1.966</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Finland<xref ref-type="table-fn" rid="nt114">&#x0002a;2</xref></td><td align="left" rowspan="1" colspan="1">31</td><td align="left" rowspan="1" colspan="1">16 (0.52)</td><td align="left" rowspan="1" colspan="1">15</td><td align="left" rowspan="1" colspan="1">16</td><td align="left" rowspan="1" colspan="1">0.908&#x000b1;0.035</td><td align="left" rowspan="1" colspan="1">0.009&#x000b1;0.001</td><td align="left" rowspan="1" colspan="1">2.42</td><td align="left" rowspan="1" colspan="1">1.53</td><td align="left" rowspan="1" colspan="1">0.092</td><td align="left" rowspan="1" colspan="1">&#x02212;1.338</td><td align="left" rowspan="1" colspan="1">&#x02212;1.083</td></tr><tr><td align