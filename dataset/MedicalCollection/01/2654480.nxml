e><given-names>K</given-names></name><name><surname>Fletcher</surname><given-names>S</given-names></name><name><surname>Honeyman</surname><given-names>K</given-names></name><name><surname>Agrawal</surname><given-names>S</given-names></name><etal></etal></person-group><article-title>Specific removal of the nonsense mutation from the mdx dystrophin mRNA using antisense oligonucleotides</article-title><source>Neuromuscul Disord</source><year>1999</year><volume>9</volume><fpage>330</fpage><lpage>338</lpage><pub-id pub-id-type="pmid">10407856</pub-id><pub-id pub-id-type="doi">10.1016/S0960-8966(99)00010-3</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kole</surname><given-names>R</given-names></name><name><surname>Sazani</surname><given-names>P</given-names></name></person-group><article-title>Antisense effects in the cell nucleus: modification of splicing</article-title><source>Curr Opin Mol Ther</source><year>2001</year><volume>3</volume><fpage>229</fpage><lpage>234</lpage><pub-id pub-id-type="pmid">11497345</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dunckley</surname><given-names>MG</given-names></name><name><surname>Manoharan</surname><given-names>M</given-names></name><name><surname>Villiet</surname><given-names>P</given-names></name><name><surname>Eperon</surname><given-names>IC</given-names></name><name><surname>Dickson</surname><given-names>G</given-names></name></person-group><article-title>Modification of splicing in the dystrophin gene in cultured Mdx muscle cells by antisense oligoribonucleotides</article-title><source>Hum Mol Genet</source><year>1998</year><volume>7</volume><fpage>1083</fpage><lpage>1090</lpage><pub-id pub-id-type="pmid">9618164</pub-id><pub-id pub-id-type="doi">10.1093/hmg/7.7.1083</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-g