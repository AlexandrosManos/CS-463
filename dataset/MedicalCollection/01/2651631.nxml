e><given-names>J. S.</given-names></name>; <name><surname>Turteltaub</surname><given-names>K. W. In</given-names></name></person-group><source>Mathematical Modeling in Experimental Medicine and Biology</source>; <person-group person-group-type="editor"><name><surname>Clifford</surname><given-names>A. J.</given-names></name>, <name><surname>M&#x000fc;ller</surname><given-names>H. G.</given-names></name></person-group>, Eds.; <publisher-name>Plenum</publisher-name>: <publisher-loc>New York</publisher-loc>, <year>1998</year>; pp <fpage>397</fpage>&#x02212;<lpage>410</lpage></mixed-citation></ref><ref id="ref11"><mixed-citation id="cit11" publication-type="journal"><name><surname>Liberman</surname><given-names>R. G.</given-names></name>; <name><surname>Skipper</surname><given-names>P. L.</given-names></name>; <name><surname>Prakash</surname><given-names>C.</given-names></name>; <name><surname>Shaffer</surname><given-names>C. L.</given-names></name>; <name><surname>Flarakos</surname><given-names>J.</given-names></name>; <name><surname>Tannenbaum</surname><given-names>S. R.</given-names></name> <source>Nucl. Instrum. Methods Phys. Res., Sect. B</source> <year>2007</year>, <volume>259</volume>, 773&#x02013;778.</mixed-citation></ref><ref id="ref12"><mixed-citation id="cit12" publication-type="journal"><name><surname>Vogel</surname><given-names>J. S.</given-names></name> <source>Radiocarbon</source> <year>1992</year>, <volume>34</volume>, 344&#x02013;350.</mixed-citation></ref><ref id="ref13"><mixed-citation id="cit13" publication-type="journal"><name><surname>Marzaioli</surname><given-names>F.</given-names></name>; <name><surname>Borriello</surname><given-names>G.</given-names></name>; <name><surname>Passariello</surname><given-names>I.</given-names></name>; <name><surname>Lubritto</surname><given-names>C.</given-names></name>; <name><surname>De Cesare</surname><given-names>N.</given-names></name>; <name><surname>D&#x02019;Onofrio</surname><given-names>A.</given-names></name>; <name><surname>Terrasi</surname><given-names>F.</given-names></name> <source>Radiocarbon</source> <year>2008</year>, <volume>50</volume>, 139&#x02013;149.</mixed-citation></ref><ref id="ref14"><mixed-citation id="cit14" publication-type="journal"><name><surname>Ognibene</surname><given-names>T. J.</given-names></name>; <name><surname>Bench</surname><given-names>G.</given-names></name>; <name><surname>Vogel</surname><given-names>J. S.</given-names></name>; <name><surname>Peaslee</surname><given-names>G. F.</given-names></name>; <name><surname>Murov</surname><given-names>S.</given-names></name> <source>Anal. Chem.</source> <year>2003</year>, <volume>75</volume>, 2192&#x02013;2196.<pub-id pub-id-type="pmid">12720362</pub-id></mixed-citation></ref><ref id="ref15"><mixed-citation id="cit15" publication-type="journal"><name><surname>Getachew</surname><given-names>G.</given-names></name>; <name><surname>Kim</surname><given-names>S. H.</given-names></name>; <name><surname>Burri</surname><given-names>B. J.</given-names></name>; <name><surname>Kelly</surname><given-names>P. B.</given-names></name>; <name><surname>Haack</surname><given-names>K. W.</given-names></name>; <name><surname>Ognibene</surname><given-names>T. J.</given-names></name>; <name><surname>Buchholz</surname><given-names>B. A.</given-names></name>; <name><surname>Vogel</surname><given-names>J. S.</given-names></name>; <name><surname>Modrow</surname><given-names>J.</given-names></name>; <name><surname>Clifford</surname><given-names>A. J.</given-names></name> <source>Radiocarbon</source> <year>2006</year>, <volume>48</volume>, 325&#x02013;336.</mixed-citation></ref><ref id="ref16"><mixed-citation id="cit16" publication-type="journal"><name><surname>Mann</surname><given-names>W. B.</given-names></name> <source>Radiocarbon</source> <year>1983</year>, <volume>25</volume>, 519&#x02013;527.</mixed-citation></ref><ref id="ref17"><mixed-citation publication-type="book" id="cit17"><person-group person-group-type="al