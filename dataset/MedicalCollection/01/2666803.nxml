pe="journal"><person-group person-group-type="author"><name><surname>Trinidad</surname><given-names>JC</given-names></name><name><surname>Thalhammer</surname><given-names>A</given-names></name><name><surname>Specht</surname><given-names>CG</given-names></name><name><surname>Lynn</surname><given-names>AJ</given-names></name><name><surname>Baker</surname><given-names>PR</given-names></name><etal/></person-group><year>2008</year><article-title>Quantitative analysis of synaptic phosphorylation and protein expression.</article-title><source>Mol Cell Proteomics</source><volume>7</volume><fpage>684</fpage><lpage>696</lpage><pub-id pub-id-type="pmid">18056256</pub-id></citation></ref><ref id="pone.0005251-Dosemeci1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dosemeci</surname><given-names>A</given-names></name><name><surname>Makusky</surname><given-names>AJ</given-names></name><name><surname>Jankowska-Stephens</surname><given-names>E</given-names></name><name><surname>Yang</surname><given-names>X</given-names></name><name><surname>Slotta</surname><given-names>DJ</given-names></name><etal/></person-group><year>2007</year><article-title>Composition of the synaptic PSD-95 complex.</article-title><source>Mol Cell Proteomics</source><volume>6</volume><fpage>1749</fpage><lpage>1760</lpage><pub-id pub-id-type="pmid">17623647</pub-id></citation></ref><ref id="pone.0005251-Dosemeci2"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dosemeci</surname><given-names>A</given-names></name><name><surname>Tao-Cheng</surname><given-names>JH</given-names></name><name><surname>Vinade</surname><given-names>L</given-names></name><name><surname>Jaffe</surname><given-names>H</given-names></name></person-group><year>2006</year><article-title>Preparation of postsynaptic density fraction from hippocampal slices and proteomic analysis.</article-title><source>Biochem Biophys Res Co