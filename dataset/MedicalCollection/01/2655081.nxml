ft" valign="top" rowspan="1" colspan="1">PGTC<break/>(in IGE)</td><td align="left" valign="top" rowspan="1" colspan="1">72.2%<break/>(PLB =45.2%)</td><td align="left" valign="top" rowspan="1" colspan="1">24.1%<break/>(PLB = 8.3%)</td><td align="left" valign="top" rowspan="1" colspan="1">NR</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b14-ndt-3-409">Glauser et al 2002</xref><break/>(n = 24)</td><td align="left" valign="top" rowspan="1" colspan="1">Prospective, Open-label</td><td align="left" valign="top" rowspan="1" colspan="1">Partial only</td><td align="left" valign="top" rowspan="1" colspan="1">52.2%</td><td align="left" valign="top" rowspan="1" colspan="1">8.7%</td><td align="left" valign="top" rowspan="1" colspan="1">SG&#x0003e;CP&#x0003e;SP</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b60-ndt-3-409">Wheless and Ng 2002</xref><break/>(n = 39)</td><td align="left" valign="top" rowspan="1" colspan="1">Prospective, open-label</td><td align="left" valign="top" rowspan="1" colspan="1">Partial and generalized</td><td align="left" valign="top" rowspan="1" colspan="1">33.3%</td><td align="left" valign="top" rowspan="1" colspan="1">7.7%</td><td align="left" valign="top" rowspan="1" colspan="1">P &#x0003e; G</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b22-ndt-3-409">Lagae et al 2003</xref><break/>(n = 21)</td><td align="left" valign="top" rowspan="1" colspan="1">Prospective, open-label</td><td align="left" valign="top" rowspan="1" colspan="1">Partial and generalized</td><td align="left" valign="top" rowspan="1" colspan="1">47%</td><td align="left" valign="top" rowspan="1" colspan="1">4.8%</td><td align="left" valign="top" rowspan="1" colspan="1">P = G</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b15-ndt-3-409">Grosso et al 2005</xref><break/>(n = 110)</td><td align="left" valign="top" rowspan="1" colspan="1">Prospective, open-label</td><td align="left" valign="top" rowspan="1" colspan="1">Partial and generalized</td><td align="left" valign="top" rowspan="1" colspan="1">39%</td><td align="left" valign="top" rowspan="1" colspan="1">9%</td><td align="left" valign="top" rowspan="1" colspan="1">P &#x0003e; G</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b21-ndt-3-409">Lagae et al 2005</xref><break/>(n = 67)</td><td align="left" valign="top" rowspan="1" colspan="1">Prospective, open-label</td><td align="left" valign="top" rowspan="1" colspan="1">Partial and generalized</td><td align="left" valign="top" rowspan="1" colspan="1">49%</td><td align="left" valign="top" rowspan="1" colspan="1">5%</td><td align="left" valign="top" rowspan="1" colspan="1">P = G</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b35-ndt-3-409">Opp et al 2005</xref><break/>(n = 209)</td><td align="left" valign="top" rowspan="1" colspan="1">Retrospective, open-label</td><td align="left" valign="top" rowspan="1" colspan="1">Partial and generalized</td><td align="left" valign="top" rowspan="1" colspan="1">25%</td><td align="left" valign="top" rowspan="1" colspan="1">6%</td><td align="left" valign="top" rowspan="1" colspan="1">SG and SP &#x0003e; others</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b16-ndt-3-409">Herranz et al 2003</xref><break/>(n = 43)</td><td align="left" valign="top" rowspan="1" colspan="1">Retrospective, open-label</td><td align="left" valign="top" rowspan="1" colspan="1">Partial and generalized</td><td align="left" valign="top" rowspan="1" colspan="1">65%</td><td align="left" valign="top" rowspan="1" colspan="1">14%</td><td align="left" valign="top" rowspan="1" colspan="1">P &#x0003e; G</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b28-ndt-3-409">Mandelbaum et al 2005</xref><break/>(n = 59)</td><td align="left" valign="top" rowspan="1" colspan="1">Retrospective, open-label</td><td align="left" valign="top" rowspan="1" colspan="1">Partial and generalized</td><td align="left" valign="top" rowspan="1" colspan="1">53%</td><td align="left" valign="top" rowspan="1" colspan="1">20%</td><td align="left" valign="top" rowspan="1" colspan="1">G &#x0003e; P</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b55-ndt-3-409">Tan and Appleton, 2004</xref><break/>(n = 26)</td><td align="left" valign="top" rowspan="1" colspan="1">Retrospective, open-label</td><td align="left" valign="top" rowspan="1" colspan="1">Partial and generalized</td><td align="left" valign="top" rowspan="1" colspan="1">61%</td><td align="left" valign="top" rowspan="1" colspan="1">8%</td><td align="left" valign="top" rowspan="1" colspan="1">P = G</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b7-ndt-3-409">Collins et al 2006</xref><break/>(n = 20)</td><td align="left" valign="top" rowspan="1" colspan="1">Retrospective, open-label</td><td align="left" valign="top" rowspan="1" colspan="1">CP, GTC, SG, M<break/>(in tuberous sclerosis)</td><td align="left" valign="top" rowspan="1" colspan="1">40%</td><td align="left" valign="top" rowspan="1" colspan="1">20%</td><td align="left" valign="top" rowspan="1" colspan="1">unable to determine</td></tr></tbody></table><table-wrap-foot><fn id="tfn1-ndt-3-409"><label>a</label><p>Responder rates were calculated as either the percent of patients with &#x0003e;50% seizure reduction or =50% seizure reduction. Additionally, rates may have been calculated over different durations of time and the methods for collecting seizure counts (diaries vs more subjective methods) may have differed between studies.</p></fn><fn id="tfn2-ndt-3-409"><label>b</label><p>Differences in response rate based on seizure type were usually reported without any statistical analysis. Most investigators based their conclusions on an informal inspection of the data.</p></fn><fn id="tfn3-ndt-3-409"><p><bold>Abbreviations:</bold> CP, complex partial; G, generalized (all subtypes); GTC, generalized tonic-clonic; IGE, idiopathic generalized epilepsy; LEV, levitiracetam; M, myoclonic; JME, juvenile myoclonic epilepsies; PGTC, primary generalized tonic-clonic; PLB, placebo; P, partial (all subtypes); NR, not reported; SG, secondarily generalized; SP, simple partial.</p></fn></table-wrap-foot></table-wrap><table-wrap id="t2-ndt-3-409" position="float"><label>Table 2</label><caption><p>Results of class I trials of newer AEDs for refractory pediatric partial epilepsy<xref ref-type="table-fn" rid="tfn4-ndt-3-409">a</xref></p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="1" colspan="1">Drug-Placebo difference</th><th align="left" rowspan="1" colspan="1">LEV</th><th align="left" rowspan="1" colspan="1">TPM</th><th align="left" rowspan="1" colspan="1">LTG</th><th align="left" rowspan="1" colspan="1">OXC</th><th align="left" rowspan="1" colspan="1">GBP</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">Median % reduction in partial seizures</td><td align="left" rowspan="1" colspan="1">27</td><td align="left" rowspan="1" colspan="1">22.6</td><td align="left" rowspan="1" colspan="1">29.4</td><td align="left" rowspan="1" colspan="1">26</td><td align="left" rowspan="1" colspan="1">10.5</td></tr><tr><td align="left" rowspan="1" colspan="1">Responders (&#x0003e;50% seizure reduction) (%)</td><td align="left" rowspan="1" colspan="1">25</td><td align="left" rowspan="1" colspan="1">19</td><td align="left" rowspan="1" colspan="1">26</td><td align="left" rowspan="1" colspan="1">19</td><td align="left" rowspan="1" colspan="1">3.7</td></tr><tr><td align="left" rowspan="1" colspan="1">% Seizure free</td><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">5</td><td align="left" rowspan="1" colspan="1">NR<sup>b</sup></td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">2</td></tr></tbody></table><table-wrap-foot><fn id="tfn4-ndt-3-409"><label>a</label><p>Data are extracted from the single class I trial that has been reported for each AED. Adapted from <xref ref-type="bibr" rid="b57-ndt-3-409">Verdru P. 2005</xref>. Epilepsy in children: the evidence for new antiepileptic drugs. <italic>Acta neurol Scand</italic>: 112(Suppl 181):17&#x02013;20. With permission from Blackwell Publishing.</p></fn><fn id="tfn5-ndt-3-409"><p><bold>Abbreviations:</bold> GBP, gabapentin; LEV, levetiracetam; LTG, lamotrigine; NR, not reported; OXC, oxcarbazepine; TPM, topiramate.</p></fn></table-wrap-foot></table-wrap><table-wrap id="t3-ndt-3-409" position="float"><label>Table 3</label><caption><p>Tolerability of LEV in pediatric trials</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" valign="top" rowspan="1" colspan="1">Study/year</th><th align="left" valign="top" rowspan="1" colspan="1">Study type</th><th align="left" valign="top" rowspan="1" colspan="1">Overall incidence of AEs</th><th align="left" valign="top" rowspan="1" colspan="1">Most common AEs</th><th align="left" valign="top" rowspan="1" colspan="1">Study withdrawals</th><th align="left" valign="top" rowspan="1" colspan="1">Positive psychotropic effects</th></tr></thead><tbody><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b14-ndt-3-409">Glauser et al 2002</xref><break/>(n = 24)</td><td align="left" valign="top" rowspan="1" colspan="1">Open-label</td><td align="left" valign="top" rowspan="1" colspan="1">not reported</td><td align="left" valign="top" rowspan="1" colspan="1">headache infection anorexia somnolence</td><td align="left" valign="top" rowspan="1" colspan="1">n = 2 (8%)<break/>(inefficacy)</td><td align="left" valign="top" rowspan="1" colspan="1">NR</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b13-ndt-3-409">Glauser et al 2006</xref><break/>(n = 198)</td><td align="left" valign="top" rowspan="1" colspan="1">Double-blind</td><td align="left" valign="top" rowspan="1" colspan="1">LEV: 88%<break/>PLB: 92%</td><td align="left" valign="top" rowspan="1" colspan="1">somnolence accidental injury vomiting anorexia rhinitis</td><td align="left" valign="top" rowspan="1" colspan="1">LEV: n = 7 (7%)<break/>(5% for AEs)<break/>PLB: n = 1 (14%)<break/>(9% for AEs)</td><td align="left" valign="top" rowspan="1" colspan="1">NR</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b60-ndt-3-409">Wheless and Ng 2002</xref><break/>(n = 39)</td><td align="left" valign="top" rowspan="1" colspan="1">Open-label</td><td align="left" valign="top" rowspan="1" colspan="1">51%</td><td align="left" valign="top" rowspan="1" colspan="1">sedation aggression hyperactivity headache</td><td align="left" valign="top" rowspan="1" colspan="1">n = 14 (36%)<break/>(5% for AEs)</td><td align="left" valign="top" rowspan="1" colspan="1">26% reported improved behavior and/or cognition</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b22-ndt-3-409">Lagae et al 2003</xref><break/>(n = 21)</td><td align="left" valign="top" rowspan="1" colspan="1">Open-label</td><td align="left" valign="top" rowspan="1" colspan="1">19%</td><td align="left" valign="top" rowspan="1" colspan="1">somnolence headache behavior</td><td align="left" valign="top" rowspan="1" colspan="1">n = 1 (5%)<break/>(5% for AEs)</td><td align="left" valign="top" rowspan="1" colspan="1">19% reported increased alertness</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b15-ndt-3-409">Grosso et al 2005</xref><break/>(n = 110)</td><td align="left" valign="top" rowspan="1" colspan="1">Open-label</td><td align="left" valign="top" rowspan="1" colspan="1">14%</td><td align="left" valign="top" rowspan="1" colspan="1">drowsiness nervousness</td><td align="left" valign="top" rowspan="1" colspan="1">n = 65 (59%)<xref ref-type="table-fn" rid="tfn6-ndt-3-409">a</xref><break/>(3% for AEs)</td><td align="left" valign="top" rowspan="1" colspan="1">17% reported better behavior and concentration</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b21-ndt-3-409">Lagae et al 2005</xref><break/>(n = 67)</td><td align="left" valign="top" rowspan="1" colspan="1">Open-label</td><td align="left" valign="top" rowspan="1" colspan="1">38%</td><td align="left" valign="top" rowspan="1" colspan="1">tiredness aggressiveness headache</td><td align="left" valign="top" rowspan="1" colspan="1">n = 18 (27%)<break/>(3% for AEs)</td><td align="left" valign="top" rowspan="1" colspan="1">27% reported increased alertness, 24% better behavior</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b35-ndt-3-409">Opp et al 2005</xref><break/>(n = 285)<xref ref-type="table-fn" rid="tfn7-ndt-3-409">b</xref></td><td align="left" valign="top" rowspan="1" colspan="1">Open-label</td><td align="left" valign="top" rowspan="1" colspan="1">45%</td><td align="left" valign="top" rowspan="1" colspan="1">somnolence aggression loss of appetite sleep disturbance</td><td align="left" valign="top" rowspan="1" colspan="1">n = 170 (60%)<break/>(17% for AEs)</td><td align="left" valign="top" rowspan="1" colspan="1">9% reported improvement in cognition, speech, mood, or ataxia</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b16-ndt-3-409">Herranz et al 2003</xref><break/>(n = 43)</td><td align="left" valign="top" rowspan="1" colspan="1">Open-label</td><td align="left" valign="top" rowspan="1" colspan="1">28%</td><td align="left" valign="top" rowspan="1" colspan="1">somnolence</td><td align="left" valign="top" rowspan="1" colspan="1">overall rate not reported<break/>(5% for AEs)</td><td align="left" valign="top" rowspan="1" colspan="1">35% reported improvement in cognition or social behavior</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b28-ndt-3-409">Mandelbaum et al 2005</xref><break/>(n = 59)</td><td align="left" valign="top" rowspan="1" colspan="1">Open-label</td><td align="left" valign="top" rowspan="1" colspan="1">54% at 3 months<break/>44% at 12 months</td><td align="left" valign="top" rowspan="1" colspan="1">lethargy behavior</td><td align="left" valign="top" rowspan="1" colspan="1">n = 18 (31%)<break/>(14% for AEs)</td><td align="left" valign="top" rowspan="1" colspan="1">not reported</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b55-ndt-3-409">Tan and Appleton 2004</xref><break/>(n = 26)</td><td align="left" valign="top" rowspan="1" colspan="1">Open-label</td><td align="left" valign="top" rowspan="1" colspan="1">4%<break/>(n = 1)</td><td align="left" valign="top" rowspan="1" colspan="1">sleepiness</td><td align="left" valign="top" rowspan="1" colspan="1">n = 5 (19%)<break/>(4% for AEs)</td><td align="left" valign="top" rowspan="1" colspan="1">not reported</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b7-ndt-3-409">Collins et al 2006</xref><break/>(n = 20)</td><td align="left" valign="top" rowspan="1" colspan="1">Open-label<break/>(in tuberous sclerosis)</td><td align="left" valign="top" rowspan="1" colspan="1">75%</td><td align="left" valign="top" rowspan="1" colspan="1">irritability/agitation poor sleep aggression</td><td align="left" valign="top" rowspan="1" colspan="1">n = 14 (70%)<break/>(15% for AEs only)</td><td align="left" valign="top" rowspan="1" colspan="1">not reported</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"><xref ref-type="bibr" rid="b1-ndt-3-409">Aeby et al 2005</xref><break/>(n = 12)</td><td align="left" valign="top" rowspan="1" colspan="1">Open-label<break/>(in CSWS)</td><td align="left" valign="top" rowspan="1" colspan="1">not reported</td><td align="left" valign="top" rowspan="1" colspan="1">dizziness</td><td align="left" valign="top" rowspan="1" colspan="1">n = 4 (33%) at 2 months<break/>(1 for AE)<break/>n = 8 (67%) by 1 year (1 for AEs)<xref ref-type="table-fn" rid="tfn8-ndt-3-409">c</xref></td><td align="left" valign="top" rowspan="1" colspan="1">75% with improved neuropsychological evaluation or behavior at 2 months</td></tr></tbody></table><table-wrap-foot><fn id="tfn6-ndt-3-409"><label>a</label><p>Patients with less than a 50% seizure reduction were discontinued except for 2 patients who were continued on LEV because of increased alertness.</p></fn><fn id="tfn7-ndt-3-409"><label>b</label><p>Safety population includes all patients on LEV, including those not evaluable for efficacy and those on LEV monotherapy (n = 10).</p></fn><fn id="tfn8-ndt-3-409"><label>c</label><p>Results at 1 year are cumulative.</p></fn><fn id="tfn9-ndt-3-409"><p><bold>Abbreviations:</bold> AEs, adverse events; CSWS, slow-wave sleep; LEV, levetiracetam; NR, not reported; PLB, placebo.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>