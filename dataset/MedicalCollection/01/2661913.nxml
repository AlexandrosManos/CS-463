73 &#x000b1; 0.03</td><td align="center" rowspan="1" colspan="1">0.71 &#x000b1; 0.02</td><td align="center" rowspan="1" colspan="1">0.69 &#x000b1; 0.02</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Seminal vesicles<xref ref-type="table-fn" rid="tfn2-ehp-117-426">b</xref> (g)</td><td align="center" rowspan="1" colspan="1">0.23 &#x000b1; 0.01</td><td align="center" rowspan="1" colspan="1">0.25 &#x000b1; 0.02</td><td align="center" rowspan="1" colspan="1">0.23 &#x000b1; 0.01</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Prostate gland<xref ref-type="table-fn" rid="tfn2-ehp-117-426">b</xref> (g)</td><td align="center" rowspan="1" colspan="1">0.49 &#x000b1; 0.02</td><td align="center" rowspan="1" colspan="1">0.57 &#x000b1; 0.03<xref ref-type="table-fn" rid="tfn3-ehp-117-426">*</xref></td><td align="center" rowspan="1" colspan="1">0.41 &#x000b1; 0.01</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Testosterone (ng/mL)</td><td align="center" rowspan="1" colspan="1">5.54 &#x000b1; 0.87</td><td align="center" rowspan="1" colspan="1">4.53 &#x000b1; 0.51</td><td align="center" rowspan="1" colspan="1">4.40 &#x000b1; 0.81</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Sperm count (&#x000d7; 10<sup>6</sup>)</td><td align="center" rowspan="1" colspan="1">10.40 &#x000b1; 0.58</td><td align="center" rowspan="1" colspan="1">9.46 &#x000b1; 1.15</td><td align="center" rowspan="1" colspan="1">11.22 &#x000b1; 0.46</td></tr><tr><td colspan="4" align="left" rowspan="1">&#x02003;Females</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02003;Ovaries<xref ref-type="table-fn" rid="tfn2-ehp-117-426">b</xref> (g)</td><td align="center" rowspan="1" colspan="1">0.12 &#x000b1; 0.006</td><td align="center" rowspan="1" colspan="1">0.13 &#x000b1; 0.009</td><td align="center" rowspan="1" colspan="1">0.12 &#x000b1; 0.004</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x0