query: 'Int J Cancer||4|650||bib12|'--></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kirsch</surname><given-names>DG</given-names></name><name><surname>Ledezma</surname><given-names>CJ</given-names></name><name><surname>Mathews</surname><given-names>CS</given-names></name><name><surname>Bhan</surname><given-names>AK</given-names></name><name><surname>Ancukiewicz</surname><given-names>M</given-names></name><name><surname>Hochberg</surname><given-names>FH</given-names></name><name><surname>Loeffler</surname><given-names>JS</given-names></name></person-group><article-title>Survival after brain metastases from breast cancer in the trastuzumab era</article-title><source>J Clin Oncol</source><year>2005</year><volume>23</volume><fpage>2114</fpage><lpage>2116</lpage><!--PubMed citation query: 'J Clin Oncol||23|2114||bib13|'--><pub-id pub-id-type="pmid">15774813</pub-id></citation></ref><ref id="bib14"><citation citation-type="book"><person-group person-group-type="author"><collab>Korea National Statistical Office</collab></person-group><article-title/><source>Death rate statistics of Korea, 2005</source><year>2007</year><publisher-name>Korea National Statistical Office: Korea</publisher-name></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lin</surname><given-names>NU</given-names></name><name><surname>Bellon</surname><given-names>JR</given-names></name><name><surname>Winer</surname><given-names>EP</given-names></name></person-group><article-title>CNS metastases in breast cancer</article-title><source>J Clin Oncol</source><year>2004</year><volume>22</volume><fpage>3608</fpage><lpage>3617</lpage><!--PubMed citation query: 'J Clin Oncol||22|3608||bib15|'--><pub-id pub-id-type="pmid">15337811</pub-id></citation></ref><ref id="bib16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lin</su