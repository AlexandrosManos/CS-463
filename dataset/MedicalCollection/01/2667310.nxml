align="center" rowspan="1" colspan="1">Healthy volunteer</td><td align="center" rowspan="1" colspan="1">5</td><td align="center" rowspan="1" colspan="1">367</td><td align="center" rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">C</td><td align="center" rowspan="1" colspan="1"><italic>a/</italic>&#x003b1;</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">766</td><td align="center" rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">A</td><td align="center" rowspan="1" colspan="1"><italic>a/</italic>&#x003b1;</td></tr><tr><td align="left" rowspan="1" colspan="1">Student11</td><td align="center" rowspan="1" colspan="1">Healthy volunteer</td><td align="center" rowspan="1" colspan="1">6</td><td align="center" rowspan="1" colspan="1">155</td><td align="center" rowspan="1" colspan="1">2</td><td align="center" rowspan="1" colspan="1">A</td><td align="center" rowspan="1" colspan="1"><italic>a/</italic>&#x003b1;</td></tr><tr><td align="left" rowspan="1" colspan="1">Student12</td><td align="center" rowspan="1" colspan="1">Healthy volunteer</td><td align="center" rowspan="1" colspan="1">6</td><td align="center" rowspan="1" colspan="1">855</td><td align="center" rowspan="1" colspan="1">6</td><td align="center" rowspan="1" colspan="1">B</td><td align="center" rowspan="1" colspan="1"><italic>a/</italic>&#x003b1;</td></tr><tr><td align="left" rowspan="1" colspan="1">Vag01</td><td align="center" rowspan="1" colspan="1">Vaginitis patient</td><td align="center" rowspan="1" colspan="1">6</td><td align="center" rowspan="1" colspan="1">1014</td><td align="center" rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">A</td><td align="center" rowspan="1" colspan="1"><italic>a/</italic>&#x003b1;</td></tr><tr><td align="left" rowspan="1" colspan="1">Vag02</td><td align="center" rowspan="1" colspan="1">Vaginitis patie