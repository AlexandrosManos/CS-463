ign="center" rowspan="1" colspan="1">6</td><td align="center" rowspan="1" colspan="1">857</td><td align="center" rowspan="1" colspan="1">2</td><td align="center" rowspan="1" colspan="1">A</td><td align="center" rowspan="1" colspan="1"><italic>a/</italic>&#x003b1;</td></tr><tr><td align="left" rowspan="1" colspan="1">Student06</td><td align="center" rowspan="1" colspan="1">Healthy volunteer</td><td align="center" rowspan="1" colspan="1">2</td><td align="center" rowspan="1" colspan="1">4</td><td align="center" rowspan="1" colspan="1">2</td><td align="center" rowspan="1" colspan="1">A</td><td align="center" rowspan="1" colspan="1"><italic>a/</italic>&#x003b1;</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">4</td><td align="center" rowspan="1" colspan="1">232</td><td align="center" rowspan="1" colspan="1">2</td><td align="center" rowspan="1" colspan="1">A</td><td align="center" rowspan="1" colspan="1"><italic>a/</italic>&#x003b1;</td></tr><tr><td align="left" rowspan="1" colspan="1">Student07</td><td align="center" rowspan="1" colspan="1">Healthy volunteer</td><td align="center" rowspan="1" colspan="1">4</td><td align="center" rowspan="1" colspan="1">1025</td><td align="center" rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">B</td><td align="center" rowspan="1" colspan="1"><italic>a/</italic>&#x003b1;</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">1026</td><td align="center" rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">B</td><td align="center" rowspan="1" colspan="1"><italic>a/</italic>&#x003b1;</td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">1082</td><td align="center" rowspan="1" colspan="1">1</td><td align="center" rowspan=