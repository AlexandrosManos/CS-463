e><name><surname>Kopeckova</surname><given-names>P</given-names></name><name><surname>Wang</surname><given-names>D</given-names></name><name><surname>Yang</surname><given-names>J</given-names></name><name><surname>Miller</surname><given-names>S</given-names></name><etal/></person-group><year>2006</year><article-title>Water-soluble HPMA copolymer&#x02013;prostaglandin E1 conjugates containing a cathepsin K sensitive spacer.</article-title><source>J Drug Target</source><volume>14</volume><fpage>425</fpage><lpage>435</lpage><pub-id pub-id-type="pmid">17092842</pub-id></citation></ref><ref id="pone.0005233-SatchiFainaro2"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Satchi-Fainaro</surname><given-names>R</given-names></name><name><surname>Puder</surname><given-names>M</given-names></name><name><surname>Davies</surname><given-names>JW</given-names></name><name><surname>Tran</surname><given-names>HT</given-names></name><name><surname>Sampson</surname><given-names>DA</given-names></name><etal/></person-group><year>2004</year><article-title>Targeting angiogenesis with a conjugate of HPMA copolymer and TNP-470.</article-title><source>Nat Med</source><volume>10</volume><fpage>255</fpage><lpage>261</lpage><pub-id pub-id-type="pmid">14981512</pub-id></citation></ref><ref id="pone.0005233-SatchiFainaro3"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Satchi-Fainaro</surname><given-names>R</given-names></name><name><surname>Mamluk</surname><given-names>R</given-names></name><name><surname>Wang</surname><given-names>L</given-names></name><name><surname>Short</surname><given-names>SM</given-names></name><name><surname>Nagy</surname><given-names>JA</given-names></name><etal/></person-group><year>2005</year><article-title>Inhibition of vessel permeability by TNP-470 and its polymer conjugate, caplostatin.</article-title><source>Cancer Cell</source><volume>7</volume><fpage>251</fpage><lpage>261</lpage><pub-id pub-id-type="pmid">15766663</pub-id></citation></ref><ref id="pone.0005233-Haag1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haag</surname><given-names>R</given-names></name><name><surname>Kratz</surname><given-names>F</given-names></name></person-group><year>2006</year><article-title>Polymer therapeutics: concepts and applications.</article-title><source>Angew Chem Int Ed Engl</source><volume>45</volume><fpage>1198</fpage><lpage>1215</lpage><pub-id pub-id-type="pmid">16444775</pub-id></citation></ref><ref id="pone.0005233-Becker1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Becker</surname><given-names>CM</given-names></name><name><surname>Wright</surname><given-names>RD</given-names></name><name><surname>Satchi-Fainaro</surname><given-names>R</given-names></name><name><surname>Funakoshi</surname><given-names>T</given-names></name><name><surname>Folkman</surname><given-names>J</given-names></name><etal/></person-group><year>2006</year><article-title>A novel noninvasive model of endometriosis for monitoring the efficacy of antiangiogenic therapy.</article-title><source>Am J Pathol</source><volume>168</volume><fpage>2074</fpage><lpage>2084</lpage><pub-id pub-id-type="pmid">16723720</pub-id></citation></ref><ref id="pone.0005233-Ingber1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ingber</surname><given-names>D</given-names></name><name><surname>Fujita</surname><given-names>T</given-names></name><name><surname>Kishimoto</surname><given-names>S</given-names></name><name><surname>Sudo</surname><given-names>K</given-names></name><name><surname>Kanamaru</surname><given-names>T</given-names></name><etal/></person-group><year>1990</year><article-title>Synthetic analogues of fumagillin that inhibit angiogenesis and suppress tumour growth.</art