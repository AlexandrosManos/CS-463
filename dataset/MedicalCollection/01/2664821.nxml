n></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mackinnon</surname><given-names>MJ</given-names></name></person-group><article-title>Drug resistance models for malaria</article-title><source>Acta Trop</source><year>2005</year><volume>94</volume><fpage>207</fpage><lpage>217</lpage><pub-id pub-id-type="pmid">15894181</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barnes</surname><given-names>KI</given-names></name><name><surname>Lindegardh</surname><given-names>N</given-names></name><name><surname>Ogundahunsi</surname><given-names>O</given-names></name><name><surname>Olliaro</surname><given-names>P</given-names></name><name><surname>Plowe</surname><given-names>CV</given-names></name><name><surname>Randrianarivelojosia</surname><given-names>M</given-names></name><name><surname>Gbotosho</surname><given-names>GO</given-names></name><name><surname>Watkins</surname><given-names>WM</given-names></name><name><surname>Sibley</surname><given-names>CH</given-names></name><name><surname>White</surname><given-names>NJ</given-names></name></person-group><article-title>World Antimalarial Resistance Network (WARN) IV: clinical pharmacology</article-title><source>Malar J</source><year>2007</year><volume>6</volume><fpage>122</fpage><pub-id pub-id-type="pmid">17822537</pub-id></citation></ref></ref-list></back></article>