                <mml:mi mathvariant="script">A</mml:mi>                                                         <mml:mo stretchy="false">(</mml:mo>                                                         <mml:mi>&#x003bb;</mml:mi>                                                         <mml:mo stretchy="false">)</mml:mo>                                                      </mml:mrow>                                                   </mml:msub>                                                </mml:mrow>                                                <mml:mo>)</mml:mo>                                             </mml:mrow>                                          </mml:mrow>                                          <mml:mrow>                                             <mml:mo>&#x02212;</mml:mo>                                             <mml:mn>1</mml:mn>                                          </mml:mrow>                                       </mml:msup>                                       <mml:msub>                                          <mml:mn>1</mml:mn>                                          <mml:mrow>                                             <mml:mi mathvariant="script">A</mml:mi>                                             <mml:mo stretchy="false">(</mml:mo>                                             <mml:mi>&#x003bb;</mml:mi>                                             <mml:mo stretchy="false">)</mml:mo>                                          </mml:mrow>                                       </mml:msub>                                    </mml:mrow>                                    <mml:mo>)</mml:mo>                                 </mml:mrow>                              </mml:mrow>                              <mml:mrow>                                 <mml:mo>&#x02212;</mml:mo>                                 <mml:mfrac>                                    <mml:mn>1</mml:mn>                                    <mml:mn>2</mml:mn>                                 </mml:mfrac>                              </mml:mrow>                           </mml:msup>                        </mml:mrow>                                             </mml:semantics>                  </mml:math></disp-formula></p><p>and</p><p><disp-formula id="bmcM25"><label>(25)</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M103" name="1471-2105-9-355-i67" overflow="scroll">                     <mml:semantics>                        <mml:mrow>                           <mml:msub>                              <mml:mi>u</mml:mi>                              <mml:mrow>                                 <mml:mi mathvariant="script">A</mml:mi>                                 <mml:mo stretchy="false">(</mml:mo>                                 <mml:mi>&#x003bb;</mml:mi>                                 <mml:mo stretchy="false">)</mml:mo>                              </mml:mrow>                           </mml:msub>                           <mml:mo>=</mml:mo>                           <mml:msub>                              <mml:mi>&#x003a6;</mml:mi>                              <mml:mrow>                                 <mml:mi mathvariant="script">A</mml:mi>                                 <mml:mo stretchy="false">(</mml:mo>                                 <mml:mi>&#x003bb;</mml:mi>                                 <mml:mo stretchy="false">)</mml:mo>                              </mml:mrow>                           </mml:msub>                           <mml:msub>                              <mml:mi>B</mml:mi>                              <mml:mrow>                                 <mml:mi mathvariant="script">A</mml:mi>                                 <mml:mo stretchy="false">(</mml:mo>                                 <mml:mi>&#x003bb;</mml:mi>                                 <mml:mo stretchy="false">)</mml:mo>                              </mml:mrow>                           </mml:msub>                           <mml:msup>                              <mml:mrow>                                 <mml:mrow>                                    <mml:mo>(</mml:mo>                                    <mml:mrow>                                       <mml:msubsup>                                          <mml:mi>&#x003a6;</mml:mi>                                          <mml:mrow>                                             <mml:mi mathvariant="script">A</mml:mi>                                             <mml:mo stretchy="false">(</mml:mo>                                             <mml:mi>&#x003bb;</mml:mi>                                             <mml:mo stretchy="false">)</mml:mo>                                          </mml:mrow>                                          <mml:mi>T</mml:mi>                                       </mml:msubsup>                                       <mml:msub>                                          <mml:mi>&#x003a6;</mml:mi>                                          <mml:mrow>                                             <mml:mi mathvariant="script">A</mml:mi>                                             <mml:mo stretchy="false">(</mml:mo>                                             <mml:mi>&#x003bb;</mml:mi>                                             <mml:mo stretchy="false">)</mml:mo>                                          </mml:mrow>                                       </mml:msub>                                    </mml:mrow>                                    <mml:mo>)</mml:mo>                                 </mml:mrow>                              </mml:mrow>                              <mml:mrow>                                 <mml:mo>&#x02212;</mml:mo>                                 <mml:mn>1</mml:mn>                              </mml:mrow>                           </mml:msup>                           <mml:msub>                              <mml:mn>1</mml:mn>                              <mml:mrow>                                 <mml: