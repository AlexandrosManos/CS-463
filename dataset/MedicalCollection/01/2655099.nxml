mml:mi>                                                         <mml:mo stretchy="false">(</mml:mo>                                                         <mml:mi>&#x003bb;</mml:mi>                                                         <mml:mo stretchy="false">)</mml:mo>                                                      </mml:mrow>                                                      <mml:mi>q</mml:mi>                                                   </mml:msubsup>                                                </mml:mrow>                                                <mml:mo>)</mml:mo>                                             </mml:mrow>                                          </mml:mrow>                                          <mml:mi>T</mml:mi>                                       </mml:msup>                                       <mml:msub>                                          <mml:mi>&#x003a6;</mml:mi>                                          <mml:mrow>                                             <mml:mi mathvariant="script">A</mml:mi>                                             <mml:mo stretchy="false">(</mml:mo>                                             <mml:mi>&#x003bb;</mml:mi>                                             <mml:mo stretchy="false">)</mml:mo>                                          </mml:mrow>                                       </mml:msub>                                       <mml:mo>.</mml:mo>                                    </mml:mrow>                                 </mml:mtd>                              </mml:mtr>                           </mml:mtable>                        </mml:mrow>                                             </mml:semantics>                  </mml:math></disp-formula></p><p>Using this result,</p><p><disp-formula id="bmcM31"><label>(31)</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M111" name="1471-2105-9-355-i75" overflow="scroll">                     <mml:semantics> 