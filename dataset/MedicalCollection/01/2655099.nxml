  <mml:mn>0</mml:mn>                                    </mml:mrow>                                 </mml:mtd>                              </mml:mtr>                              <mml:mtr columnalign="left">                                 <mml:mtd columnalign="left">                                    <mml:mrow>                                       <mml:mo>&#x021d4;</mml:mo>                                       <mml:msup>                                          <mml:mi>s</mml:mi>                                          <mml:mi>T</mml:mi>                                       </mml:msup>                                       <mml:mrow>                                          <mml:mo>(</mml:mo>                                          <mml:mrow>                                             <mml:msub>                                                <mml:mi>&#x003a6;</mml:mi>                                                <mml:mrow>                                                   <mml:mi mathvariant="script">A</mml:mi>                                                   <mml:msub>                                                      <mml:mrow>                                                         <mml:mo stretchy="false">(</mml:mo>                                                         <mml:mi>&#x003bb;</mml:mi>                                                         <mml:mo stretchy="false">)</mml:mo>                                                      </mml:mrow>                                                      <mml:mo>+</mml:mo>                                                   </mml:msub>                                                </mml:mrow>                                             </mml:msub>                                             <mml:msubsup>                                                <mml:mover accent="true">                                                   <mml:mi>c</mml:mi>                                                   <mml:mo>^</mml:mo>                                                </mml:mover>                                                <mml:mrow>                                                   <mml:mi mathvariant="script">A</mml:mi>                                                   <mml:msub>                                                      <mml:mrow>                                                         <mml:mo stretchy="false">(</mml:mo>                                                         <mml:mi>&#x003bb;</mml:mi>                                                         <mml:mo stretchy="false">)</mml:mo>                                                      </mml:mrow>                                                      <mml:mo>+</mml:mo>                                                   </mml:msub>                                                </mml:mrow>                                                <mml:mi>q</mml:mi>                                             </mml:msubsup>                                             <mml:mo>&#x02212;</mml:mo>                                             <mml:msub>                                                <mml:mi>&#x003a6;</mml:mi>                                                <mml:mrow>                                                   <mml:mi mathvariant="script">A</mml:mi>                                                   <mml:mo stretchy="false">(</mml:mo>                                                   <mml:mi>&#x003bb;</mml:mi>                                                   <mml:mo stretchy="false">)</mml:mo>                                                </mml:mrow>                                             </mml:msub>                                             <mml:msubsup>                                                <mml:mover accent="true">                                                   <mml:mi>c</mml:mi>                                                   <mml:mo>^</mml:mo>                                                </mml:mover>                                                <mml:mrow>                                                   <mml:mi mathvariant="script">A</mml:mi>                                                   <mml:mo stretchy="false">(</mml:mo>                                                   <mml:mi>&#x003bb;</mml:mi>                                                   <mml:mo stretchy="false">)</mml:mo>                                                </mml:mrow>                                                <mml:mi>q</mml:mi>                                             </mml:msubsup>                                          </mml:mrow>                                          <mml:mo>)</mml:mo>                                       </mml:mrow>                                       <mml:mo>&#x02265;</mml:mo>                                       <mml:mn>0.</mml:mn>                                    </mml:mrow>                                 </mml:mtd>                              </mml:mtr>                           </mml:mtable>                        </mml:mrow>                                             </mml:semantics>                  </mml:math></disp-formula></p><p>Using the construction of <inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M106" name="1471-2105-9-355-i70" overflow="scroll"><mml:semantics><mml:mrow><mml:msub><mml:mi>&#x003a6;</mml:mi><mml:mrow><mml:mi mathvariant="script">A</mml:mi><mml:msub><mml:mrow><mml:mo stretchy="false">(</mml:mo><mml:mi>&#x003bb;</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mrow><mml:mo>+</mml:mo></mml:msub></mml:mrow></mml:msub><mml:msubsup><mml:mover accent="true"><mml:mi>c</mml:mi><mml:mo>^</mml:mo></mml:mover><mml:mrow><mml:mi mathvariant="script">A</mml:mi><mml:msub><mml:mrow><mml:mo stretchy="false">(</mml:mo><mml:mi>&#x003bb;</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mrow><mml:mo>+</mml:mo></mml:msub></mml:mrow><mml:mi>q</mml:mi></mml:msubsup></mml:mrow></mml:semantics></mml:math></inline-formula> from above, this leads to</p><p><disp-formula id="bmcM28"><label>(28)</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M107" name="1471-2105-9-355-i71" overflow="scroll">                     <mml:semantics>                        <mml:mrow>                           <mml:mtable columnalign="right">                              <mml:mtr columnalign="right">                                 <mml:mtd columnalign="right">                                    <mml:mrow>                                       <mml:mo>&#x021d4;</mml:mo>                                       <mml:msup>                                          <mml:mi>s</mml:mi>                                          <mml:mi>T</mml:mi>                                       </mml:msup>                                       <mml:mrow>                                          <mml:mo>(</mml:mo>                                          <mml:mrow>                                             <mml:msub>                                                <mml:mi>&#x003a6;</mml:mi>                                                <mml:mrow>                                                   <mml:mi mathvariant="script">A</mml:mi>                                                   <mml:mo stretchy="false">(</mml:mo>                                                   <mml:mi>&#x003bb;</mml:mi>                                                   <mml:mo stretchy="false">)</mml:mo>                                                </mml:mrow>                                             </mml:msub>                                             <mml:msubsup>                                                <mml:mover accent="true">                                                   <mml:mi>c</mml:mi>                                                   <mml:mo>^</mml:mo>                                                </mml:mover>                                                <mml:mrow>                                                   <mml:mi mathvariant="script">A</mml:mi>                                                   <mml:mo stretchy="false">(</mml:mo>                                                   <mml:mi>&#x003bb;</mml:mi>                                                   <mml:mo stretchy="false">)</mml:mo>                                                </mml:mrow>                                                <mml:mi>q</mml:mi>                                             </mml:msubsup>                                             <mml:mo>+</mml:mo>                                             <mml:mover accent="true">                                                <mml:mi>&#x003b3;</mml:mi>                                                <mml:mo>^</mml:mo>                                             </mml:mover>                                             <mml:msub>                                                <mml:mi>u</mml:mi>                                                <mml:mrow>                                                   <mml:mi mathvariant="script">A</mml:mi>                                                   <mml:msub>                                                      <mml:mrow>                                                         <mml:mo stretchy="false">(</mml:mo>                                                         <mml:mi>&#x003bb;</mml:mi>                                                         <mml:mo stretchy="false">)</mml:mo>                                                      </mml:mrow>                                                      <mml:mo>+</mml:mo>                                                   </mml:msub>                                                </mml:mrow>                                             </mml:msub>                                             <mml:mo>&#x02212;</mml:mo>                                             <mml:msub>                                                <mml:mi>&#x003a6;</mml:mi>                                                <mml:mrow>                                                   <mml:mi mathvariant="script">A</mml:mi>                                                   <mml:mo stretchy="false">(</mml:mo>                                                   <mml:mi>&#x003bb;</mml:mi>                                                   <mml:mo stretchy="false">)</mml:mo>                                                </mml:mrow>                                             </mml:msub>                                             <mml:msubsup>                                                <mml:mover accent="true">                                                   <mml:mi>c</mml:mi>                                                   <mml:mo>^</mml:mo>                                                </mml:mover>                                                <mml:mrow>                                                   <mml:mi mathvariant="script">A</mml:mi>                                                   <mml:mo stretchy="false">(</mml:mo>                                                   <mml:mi>&#x003bb;</mml:mi>                                                   <mml:mo stretchy="false">)</mml:mo>                                                </mml:mrow>                                                <mml:mi>q</mml:mi>                                             </mml:msubsup>                                          </mml:mrow>                                          <mml:mo>)</mml:mo>                                       </mml:mrow>                                       <mml:mo>&#x02265;</mml:mo>                                       <mml:mn>0</mml:mn>                                    </mml:mrow>                                 </mml:mtd>                              </mml:mtr>                              <mml:mtr columnalign="right">                                 <mml:mtd columnalign="right">                                    <mml:mrow>                                       <mml:mo>&#x021d4;</mml:mo>                                       <mml:msup>                                          <mml:mi>s</mml:mi>                                          <mml:mi>T</mml:mi>                                       </mml:msup>                                       <mml:mo stretchy="false">(</mml:mo>                                       <mml:mover accent="true">                                          <mml:mi>&#x003b3;</mml:mi>                                          <mml:mo>^</mml:mo>                                       </mml:mover>                                       <mml:msub>                                          <mml:mi>u</mml:mi>                                          <mml:mrow>                                             <mml:mi mathvariant="script">A</mml:mi>                                             <mml:msub>                                                <mml:mrow>                                                   <mml:mo stretchy="false">(</mml:mo>                                                   <mml:mi>&#x003bb;</mml:mi>                                                   <mml:mo stretchy="false">)</mml:mo>                                                </mml:mrow>                                                <mml:mo>+</mml:mo>                                             </mml:msub>                                          </mml:mrow>                                       </mml:msub>                                       <mml:mo stretchy="false">)</mml:mo>                                       <mml:mo>&#x02265;</mml:mo>                                       <mml:mn>0.</mml:mn>                                    </mml:mrow>                                 </mml:mtd>                              </mml:mtr>                           </mml:mtable>                        </mml:mrow>                                             </mml:semantics>                  </mml:math></disp-formula></p><p>It is known from its definition that <inline-formula><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M108" name="1471-2105-9-355-i72" overflow="scroll"><mml:semantics><mml:mover accent="true"><mml:mi>&#x003b3;</mml:mi><mml:mo>^</mml:mo></mml:mover></mml:semantics></mml:math></inline-formula> is strictly positive, thus it can be dropped from the inequality and</p><p><disp-formula id="bmcM29"><label>(29)</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M109" name="1471-2105-9-355-i73" overflow="scroll">                     <mml:semantics>                        <mml:mrow>                           <mml:mtable columnalign="right">                              <mml:mtr columnalign="right">                                 <mml:mtd columnalign="right">                                    <mml:mrow>                                       <mml:msup>                                          <mml:mi>s</mml:mi>                                          <mml:mi>T</mml:mi>                                       </mml:msup>                                       <mml:msub>                                          <mml:mi>u</mml:mi>                                          <mml:mo>+</mml:mo>                                       </mml:msub>                                       <mml:mo>&#x02265;</mml:mo>                                       <mml:mn>0</mml:mn>                                    </mml:mrow>                                 </mml:mtd>                              </mml:mtr>                              <mml:mtr columnalign="right">                                 <mml:mtd columnalign="right">                                    <mml:mrow>                                       <mml:mo>&#x021d4;</mml:mo>                                       <mml:msup>                                          <mml:mi>s</mml:mi>                                          <mml:mi>T</mml:mi>                                       </mml:msup>                                       <mml:msub>                                          <mml:mi>&#x003a6;</mml:mi>                                          <mml:mrow>                                             <mml:mi mathvariant="script">A</mml:mi>                                             <mml:msub>                                                <mml:mrow>                                                   <mml:mo stretchy="false">(</mml:mo>                                                   <mml:mi>&#x003bb;</mml:mi>                                                   <mml:mo stretchy="false">)</mml:mo>                                                </mml:mrow>                                                <mml:mo>+</mml:mo>                                             </mml:msub>                                          </mml:mrow>                                       </mml:msub>                                       <mml:msub>                                          <mml:mi>B</mml:mi>                                          <mml:mrow>                                             <mml:mi mathvariant="script">A</mml:mi>                                             <mml:msub>                                                <mml:mrow>                                                   <mml:mo stretchy="false">(</mml:mo>                                                   <mml:mi>&#x003bb;</mml:mi>                                                   <mml:mo stretchy="false">)</mml:mo>                                                </mml:mrow>                                                <mml:mo>+</mml:mo>                                             </mml:msub>                                          </mml:mrow>                                       </mml:msub>                                       <mml:msup>                                          <mml:mrow>                                             <mml:mrow>                                                <mml:mo>(</mml:mo>                                                <mml:mrow>                                                   <mml:msubsup>                                                      <mml:mi>&#x003a6;</mml:mi>                                                      <mml:mrow>                                                         <mml:mi mathvariant="script">A</mml:mi>                                                         <mml:msub>                                                            <mml:mrow>                                                               <mml:mo stretchy="false">(</mml:mo>                                                               <mml:mi>&#x003bb;</mml:mi>                                                               <mml:mo stretchy="false">)</mml:mo>                                                            </mml:mrow>                                                            <mml:mo>+</mml:mo>                                                         </mml:msub>                                                      </mml:mrow>                                                      <mml:mi>T</mml:mi>                                                   </mml:msubsup>                                                   <mml:msub>                                                      <mml:mi>&#x003a6;</mml:mi>                                                      <mml:mrow>                                                         <mml:mi mathvariant="script">A</mml:mi>                                                         <mml:msub>                                                            <mml:mrow>                                                               <mml:mo stretchy="false">(</mml:mo>                                                               <mml:mi>&#x003bb;</mml:mi>                                                               <mml:mo stretchy="false">)</mml:mo>                                                            </mml:mrow>                                                            <mml:mo>+</mml:mo>                                                         </mml:msub>                                                      </mml:mrow>                                                   </mml:msub>                                                </mml:mrow>                                                <mml:mo>)</mml:mo>                                             </mml:mrow>                                          </mml:mrow>                                          <mml:mrow>                                             <mml:mo>&#x02212;</mml:mo>                                             <mml:mn>1</mml:mn>                                          </mml:mrow>                                       </mml:msup>                                       <mml:msub>                                          <mml:mn>1</mml:mn>                                          <mml:mrow>                                             <mml:mi mathvariant="script">A</mml:mi>                                             <mml:msub>                                                <mml:mrow>                                                   <mml:mo stretchy="false">(</mml:mo>                                                   <mml:mi>&#x003bb;</mml:mi>                                                   <mml:mo stretchy="false">)</mml:mo>                                                </mml:mrow>                                                <mml:mo>+</mml:mo>                                             </mml:msub>                                          </mml:mrow>                                       </mml:msub>                                       <mml:mo>&#x02265;</mml:mo>                                       <mml:mn>0.</mml:mn>                                    </mml:mrow>                                 </mml:mtd>                              </mml:mtr>                           </mml:mtable>                        </mml:mrow>                                             </mml:semantics>                  </mml:math></disp-formula></p><p>It is also known from the idea of the non-negative lasso that all variables in <italic>X</italic><sub><italic>A </italic></sub>are positively correlated with the remaining residuals, so</p><p><disp-formula id="bmcM30"><label>(30)</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M110" name="1471-2105-9-355-i74" overflow="scroll">                     <mml:semantics>                        <mml:mrow>                           <mml:mtable columnalign="left">                              <mml:mtr columnalign="left">                                 <mml:mtd columnalign="left">                                    <mml:mrow>                                       <mml:mi>cov</mml:mi>                                       <mml:mo>&#x02061;</mml:mo>                                       <mml:mrow>                                          <mml:mo>(</mml:mo>                                          <mml:mrow>                                             <mml:msub>                                                <mml:mi>&#x003a6;</mml:mi>                                                <mml:mrow>                                                   <mml:mi mathvariant="script">A</mml:mi>                                                   <mml:mo stretchy="false">(</mml:mo>                                                   <mml:mi>&#x003bb;</mml:mi>                                                   <mml:mo stretchy="false">)</mml:mo>                                                </mml:mrow>                                             </mml:msub>                                             <mml:mo>,</mml:mo>                                             <mml:mi>s</mml:mi>                                             <mml:mo>&#x02212;</mml:mo>                                             <mml:msub>                                                <mml:mi>&#x003a6;</mml:mi>                                                <mml:mrow>                                                   <mml:mi mathvariant="script">A</mml:mi>                                                   <mml:mo stretchy="false">(</mml:mo>                                                   <mml:mi>&#x003bb;</mml:mi>                                                   <mml:mo stretchy="false">)</mml:mo>                                                </mml:mrow>                                             </mml:msub>                                             <mml:msubsup>                                                <mml:mover accent="true">                                                   <mml:mi>c</mml:mi>                                                   <mml:mo>^</mml:mo>                                                </mml:mover>                                                <mml:mrow>                                                   <mml:mi mathvariant="script">A</mml:mi>                                                   <mml:mo stretchy="false">(</mml:mo>                                                   <mml:mi>&#x003bb;</mml:mi>                                                   <mml:mo stretchy="false">)</mml:mo>                                                </mml:mrow>                                                <mml:mi>q</mml:mi>                                             </mml:msubsup>                                          </mml:mrow>                                          <mml:mo>)</mml:mo>                                       </mml:mrow>                                       <mml:mo>&#x02265;</mml:mo>                                       <mml:mn>0</mml:mn>                                    </mml:mrow>                                 </mml:mtd>                              </mml:mtr>                              <mml:mtr columnalign="left">                                 <mml:mtd columnalign="left">                                    <mml:mrow>                                       <mml:mo>&#x021d4;</mml:mo>                                       <mml:msup>                                          <mml:mrow>                                             <mml:mrow>                                                <mml:mo>(</mml:mo>                                                <mml:mrow>                                                   <mml:mi>s</mml:mi>                                                   <mml:mo>&#x02212;</mml:mo>                                                   <mml:msub>                                                      <mml:mi>&#x003a6;</mml:mi>                                                      <mml:mrow>                                                         <mml:mi mathvariant="script">A</mml:mi>                                                         <mml:mo stretchy="false">(</mml:mo>                                                         <mml:mi>&#x003bb;</mml:mi>                                                         <mml:mo stretchy="false">)</mml:mo>                                                      </mml:mrow>                                                   </mml:msub>                                                   <mml:msubsup>                                                      <mml:mover accent="true">                                                         <mml:mi>c</mml:mi>                                                         <mml:mo>^</mml:mo>                                                      </mml:mover>                                                      <mml:mrow>                                                         <mml:mi mathvariant="script">A</mml:mi>                                                         <mml:mo stretchy="false">(</mml:mo>                                                         <mml:mi>&#x003bb;</mml:mi>                                                         <mml:mo stretchy="false">)</mml:mo>                                                      </mml:mrow>                                                      <mml:mi>q</mml:mi>                                                   </mml:msubsup>                                                </mml:mrow>                                                <mml:mo>)</mml:mo>                                             </mml:mrow>                                          </mml:mrow>                                          <mml:mi>T</mml:mi>                                       </mml:msup>                                       <mml:msub>                                          <mml:mi>&#x003a6;</mml:mi>                                          <mml:mrow>                                             <mml:mi mathvariant="script">A</mml:mi>                                             <mml:mo stretchy="false">(</mml:mo>                                             <mml:mi>&#x003bb;</mml:mi>                                             <mml:mo stretchy="false">)</mml:mo>                                          </mml:mrow>                                       </mml:msub>                                       <mml:mo>&#x02265;</mml:mo>                                       <mml:mn>0</mml:mn>                                    </mml:mrow>                                 </mml:mtd>                              </mml:mtr>                              <mml:mtr columnalign="left">                                 <mml:mtd columnalign="left">                                    <mml:mrow>                                       <mml:mo>&#x021d4;</mml:mo>                                       <mml:msup>                                          <mml:mi>s</mml:mi>                                          <mml:mi>T</mml:mi>                                       </mml:msup>                                       <mml:msub>                                          <mml:mi>&#x003a6;</mml:mi>                      