-group-type="author"><name><surname>Siracusa</surname><given-names>A</given-names></name><name><surname>Desrosiers</surname><given-names>M</given-names></name><name><surname>Marabini</surname><given-names>A</given-names></name></person-group><article-title>Epidemiology of occupational rhinitis: prevalence, aetiology and determinants</article-title><source>Clin Exp Allergy</source><year>2000</year><volume>30</volume><fpage>1519</fpage><lpage>34</lpage><pub-id pub-id-type="pmid">11069559</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2222.2000.00946.x</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gautrin</surname><given-names>D</given-names></name><name><surname>Desrosiers</surname><given-names>M</given-names></name><name><surname>Castano</surname><given-names>R</given-names></name></person-group><article-title>Occupational rhinitis</article-title><source>Curr Opin Allergy Clin Immunol</source><year>2006</year><volume>6</volume><fpage>77</fpage><lpage>84</lpage><pub-id pub-id-type="pmid">16520669</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Walusiak</surname><given-names>J</given-names></name></person-group><article-title>Occupational upper airway disease</article-title><source>Curr Opin Allergy Clin Immunol</source><year>2006</year><volume>6</volume><fpage>1</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">16505604</pub-id></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Christiani</surname><given-names>DC</given-names></name><name><surname>Malo</surname><given-names>JL</given-names></name><name><surname>Siracusa</surname><given-names>A</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Bernstein IL, Chan-Yeung M, Malo JL, Bernstein DI</surname></name></person-group><article-title>Upper airways involvement</article-title><source>Asthma in the workplace</source><year>2006</year><publisher-name>New York: Taylor &#x00026; Francis</publisher-name><fpage>785</fpage><lpage>796</lpage></citation></ref><ref id="B13"><citation citation-type="journal"><article-title>International Consensus Report on the diagnosis and management of rhinitis. International Rhinitis Management Working Group</article-title><source>Allergy</source><year>1994</year><volume>49</volume><issue>19</issue><fpage>1</fpage><lpage>34</lpage></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ng</surname><given-names>ML</given-names></name><name><surname>Warlow</surname><given-names>RS</given-names></name><name><surname>Chrishanthan</surname><given-names>N</given-names></name><name><surname>Ellis</surname><given-names>C</given-names></name><name><surname>Walls</surname><given-names>R</given-names></name></person-group><article-title>Preliminary criteria for the definition of allergic rhinitis: a systematic evaluation of clinical parameters in a disease cohort (I)</article-title><source>Clin Exp Allergy</source><year>2000</year><volume>30</volume><fpage>1314</fpage><lpage>31</lpage><pub-id pub-id-type="pmid">10971479</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2222.2000.00853.x</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>DY</given-names></name><name><surname>Niti</surname><given-names>M</given-names></name><name><surname>Smith</surname><given-names>JD</given-names></name><name><surname>Yeoh</surname><given-names>KH</given-names></name><name><surname>Ng</surname><given-names>TP</given-names></name></person-group><article-title>Rhinitis: do diagnostic criteria affect the prevalence and treatment?</article-title><source>Allergy</source><year>2002</year><volume>57</volume><fpage>150</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">11929419</pub-id><pub-id pub-id-type="doi">10.1034/j.1398-9995.2002.1s3402.x</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Castano</surname><given-names>R</given-names></name><name><surname>Theriault</surname><given-names>G</given-names></name><name><surname>Gautrin</surname><given-names>D</given-names></name></person-group><article-title>The definition of rhinitis and occupational rhinitis needs to be revisited</article-title><source>Acta Otolaryngol</source><year>2006</year><volume>126</volume><fpage>1118</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">16923722</pub-id><pub-id pub-id-type="doi">10.1080/00016480600606798</pub-id></citation></ref><ref id="B17"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Salvaggio</surname><given-names>JE</given-names></name><name><surname>Taylor</surname><given-names>G</given-names></name><name><surname>Weill</surname><given-names>H</given-names></name></person-group><article-title>Occupational asthma and rhinitis in occupational respiratory disease</article-title><source>US Department of Health and Human Services Washington, DC</source><year>1986</year></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dykewicz</surname><given-names>MS</given-names></name><name><surname>Fineman</surname><given-names>S</given-names></name><name><surname>Skoner</surname><given-names>DP</given-names></name><name><surname>Nicklas</surname><given-names>R</given-names></name><name><surname>Lee</surname><given-names>R</given-names></name><name><surname>Blessing-Moore</surname><given-names>J</given-names></name><etal></etal></person-group><article-title>Diagnosis and management of rhinitis: complete guidelines of the Joint Task Force on Practice Parameters in Allergy, Asthma and Immunology. American Academy of Allergy, Asthma, and Immunology</art