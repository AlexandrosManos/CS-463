names></name><etal/></person-group><year>2006</year><article-title>Organizing a series of education and support conferences for caregivers of individuals with frontotemporal dementia and primary progressive aphasia</article-title><source>Alzheimer&#x02019;s Care Quarterly</source><volume>7</volume><fpage>243</fpage><lpage>50</lpage></citation></ref><ref id="b7-ndt-3-745"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Banks</surname><given-names>S</given-names></name><name><surname>Weintraub</surname><given-names>S</given-names></name></person-group><comment>In press</comment><article-title>Neuropsychiatric symptoms in behavioral variant frontotemporal dementia and primary progressive aphasia</article-title><source>Journal of Geriatric Psychiatry and Neurology</source></citation></ref><ref id="b8-ndt-3-745"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bozeat</surname><given-names>S</given-names></name><name><surname>Lambon Ralph</surname><given-names>MA</given-names></name><name><surname>Patterson</surname><given-names>K</given-names></name><etal/></person-group><year>2000</year><article-title>Non-verbal semantic impairment in semantic dementia</article-title><source>Neuropsychologia</source><volume>38</volume><fpage>1207</fpage><lpage>15</lpage><pub-id pub-id-type="pmid">10865096</pub-id></citation></ref><ref id="b9-ndt-3-745"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>J</given-names></name><name><surname>Ashworth</surname><given-names>A</given-names></name><name><surname>Gydesen</surname><given-names>S</given-names></name><etal/></person-group><year>1995</year><article-title>Familial non-specific dementia maps to chromosome 3</article-title><source>Hum Mol Genet</source><volume>4</volume><fpage>1625</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">8541850</pub-id></citation></ref><ref id="b10-ndt-3-745"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Brown</surname><given-names>J</given-names></name><name><surname>Gydesen</surname><given-names>S</given-names></name><name><surname>Johannsen</surname><given-names>P</given-names></name><etal/></person-group><year>2004</year><article-title>Frontotemporal dementia linked to chromosome 3</article-title><source>Dement Geriatr Cogn Disord</source><volume>17</volume><fpage>274</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">15178935</pub-id></citation></ref><ref id="b11-ndt-3-745"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Caselli</surname><given-names>RJ</given-names></name><name><surname>Windebank</surname><given-names>AJ</given-names></name><name><surname>Petersen</surname><given-names>RC</given-names></name><etal/></person-group><year>1993</year><article-title>Rapidly progressive aphasic dementia and motor neuron disease</article-title><source>Ann Neurol</source><volume>33</volume><fpage>200</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">8257465</pub-id></citation></ref><ref id="b12-ndt-3-745"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chawluk</surname><given-names>JB</given-names></name><name><surname>Mesulam</surname><given-names>MM</given-names></name><name><surname>Hurtig</surname><given-names>H</given-names></name><etal/></person-group><year>1986</year><article-title>Slowly progressive aphasia without generalized dementia: studies with positron emission tomography</article-title><source>Ann Neurol</source><volume>19</volume><fpage>68</fpage><lpage>74</lpage><pub-id pub-id-type="pmid">3484931</pub-id></citation></ref><ref id="b13-ndt-3-745"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chow</surname><given-names>TW</given-names></name></person-group><year>2005</year><article-title>Treatment approaches to symptoms associated with frontotemporal degeneration</article-title><source>Curr Psychiatry Rep</source><volume>7</volume><fpage>376</fpage><lpage>80</lpage><pub-id pub-id-type="pmid">16216158</pub-id></citation></ref><ref id="b14-ndt-3-745"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clark</surname><given-names>DG</given-names></name><name><surname>Charuvastra</surname><given-names>A</given-names></name><name><surname>Miller</surname><given-names>BL</given-names></name><etal/></person-group><year>2005</year><article-title>Fluent versus nonfluent primary progressive aphasia: a comparison of clinical and functional neuroimaging features</article-title><source>Brain Lang</source><volume>94</volume><fpage>54</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">15896383</pub-id></citation></ref><ref id="b15-ndt-3-745"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cooke</surname><given-names>A</given-names></name><name><surname>Devita</surname><given-names>C</given-names></name><name><surname>Gee</surname><given-names>J</given-names></name><etal/></person-group><year>2003</year><article-title>Neural basis for sentence comprehension deficits in frontotemporal dementia</article-title><source>Brain Lang</source><volume>85</volume><fpage>211</fpage><lpage>21</lpage><pub-id pub-id-type="pmid">12735939</pub-id></citation></ref><ref id="b16-ndt-3-745"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cooke</surname><given-names>A</given-names></name><name><surname>Grossman</surname><given-names>M</given-names></name><name><surname>Devita</surname><given-names>C</given-names></name><etal/></person-group><year>2006</year><article-title>Large-scale neural network for sentence processing</article-title><source>Brain Lang</source><volume>96</volume><fpage>14</fpage><lpage>36</lpage><pub-id pub-id-type="pmid">16168473</pub-id></citation></ref><ref id="b17-ndt-3-745"><citation citation-ty