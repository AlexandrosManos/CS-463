person-group><year>1997</year><article-title>Generation of papillomavirus-immortalized cell lines from normal human ectocervical, endocervical, and vaginal epithelium that maintain expression of tissue-specific differentiation proteins.</article-title><source>Biol Reprod</source><volume>57</volume><fpage>847</fpage><lpage>855</lpage><pub-id pub-id-type="pmid">9314589</pub-id></citation></ref><ref id="pone.0005207-Hogan1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hogan</surname><given-names>VK</given-names></name><name><surname>Culhane</surname><given-names>JF</given-names></name><name><surname>Hitti</surname><given-names>J</given-names></name><name><surname>Rauh</surname><given-names>VA</given-names></name><name><surname>McCollum</surname><given-names>KF</given-names></name><etal/></person-group><year>2007</year><article-title>Relative performance of three methods for diagnosing bacterial vaginosis during pregnancy.</article-title><source>Matern Child Health J</source><volume>11</volume><fpage>532</fpage><lpage>539</lpage><pub-id pub-id-type="pmid">17874288</pub-id></citation></ref><ref id="pone.0005207-Amsel1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Amsel</surname><given-names>R</given-names></name><name><surname>Totten</surname><given-names>PA</given-names></name><name><surname>Spiegel</surname><given-names>CA</given-names></name><name><surname>Chen</surname><given-names>KC</given-names></name><name><surname>Eschenbach</surname><given-names>D</given-names></name><etal/></person-group><year>1983</year><article-title>Nonspecific vaginitis. Diagnostic criteria and microbial and epidemiologic associations.</article-title><source>Am J Med</source><volume>74</volume><fpage>14</fpage><lpage>22</lpage><pub-id pub-id-type="pmid">6600371</pub-id></citation></ref><ref id="pone.0005207-Keane1"><label>15</label><citation citation-type="journal"><p