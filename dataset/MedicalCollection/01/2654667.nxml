ce><year>1982</year><volume>74</volume><fpage>777</fpage><lpage>784</lpage><pub-id pub-id-type="doi">10.2307/3792864</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Du</surname><given-names>M</given-names></name><name><surname>Schard</surname><given-names>CL</given-names></name><name><surname>Nuckles</surname><given-names>EM</given-names></name><name><surname>Vaillancourt</surname><given-names>LJ</given-names></name></person-group><article-title>Using mating-type gene sequences for improved phylogenetic resolution of <italic>Collectotrichum </italic>species complexes</article-title><source>Mycologia</source><year>2005</year><volume>97</volume><fpage>641</fpage><lpage>658</lpage><pub-id pub-id-type="pmid">16392253</pub-id><pub-id pub-id-type="doi">10.3852/mycologia.97.3.641</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sukno</surname><given-names>SA</given-names></name><name><surname>Garc&#x000ed;a</surname><given-names>VM</given-names></name><name><surname>Shaw</surname><given-names>BD</given-names></name><name><surname>Thon</surname><given-names>MR</given-names></name></person-group><article-title>Root infection and systemic colonization of maize by <italic>Colletotrichum graminicola</italic></article-title><source>Applied and environmental microbiology</source><year>2008</year><volume>74</volume><fpage>823</fpage><lpage>832</lpage><pub-id pub-id-type="pmid">18065625</pub-id><pub-id pub-id-type="doi">10.1128/AEM.01165-07</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heath</surname><given-names>MC</given-names></name><name><surname>Heath</surname><given-names>IB</given-names></name></person-group><article-title>Ultrastructural changes associated with the haustorial mother cell ceptum during haustorium formation in <italic>U