lpage>991</lpage><pub-id pub-id-type="pmid">8855855</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(96)02536-6</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sheridan</surname><given-names>J</given-names></name><name><surname>Strang</surname><given-names>J</given-names></name><name><surname>Barber</surname><given-names>N</given-names></name><name><surname>Glanz</surname><given-names>A</given-names></name></person-group><article-title>Role of community pharmacies in relation to HIV prevention and drug misuse: findings from the 1995 national survey in England and Wales</article-title><source>BMJ</source><year>1996</year><volume>313</volume><fpage>272</fpage><lpage>274</lpage><pub-id pub-id-type="pmid">8704541</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Strang</surname><given-names>J</given-names></name><name><surname>Sheridan</surname><given-names>J</given-names></name><name><surname>Barber</surname><given-names>N</given-names></name></person-group><article-title>Prescribing injectable and oral methadone to opiate addicts: results from the 1995 national postal survey of community pharmacies in England and Wales</article-title><source>BMJ</source><year>1996</year><volume>313</volume><fpage>270</fpage><lpage>272</lpage><pub-id pub-id-type="pmid">8704540</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lurie</surname><given-names>P</given-names></name><name><surname>Jones</surname><given-names>TS</given-names></name><name><surname>Foley</surname><given-names>J</given-names></name></person-group><article-title>A sterile syringe for every drug user injection: how many injections take place annually, and how might pharmacists contribute to syringe distribution?</article-title><source>J Acquir Immune Defic Syndr Hum Retrovirol</so