e><given-names>JS</given-names></name><name><surname>Fahland</surname><given-names>T</given-names></name><name><surname>Church</surname><given-names>GM</given-names></name><name><surname>Palsson</surname><given-names>BO</given-names></name></person-group><year>2001</year><article-title>Dynamic simulation of the human red blood cell metabolic network.</article-title><source>Bioinformatics</source><volume>17</volume><fpage>286</fpage><lpage>287</lpage><pub-id pub-id-type="pmid">11294796</pub-id></citation></ref><ref id="pone.0004967-Rojas1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rojas</surname><given-names>I</given-names></name><name><surname>Golebiewski</surname><given-names>M</given-names></name><name><surname>Kania</surname><given-names>R</given-names></name><name><surname>Krebs</surname><given-names>O</given-names></name><name><surname>Mir</surname><given-names>S</given-names></name><etal/></person-group><year>2007</year><article-title>SABIO-RK: a database for biochemical reactions and their kinetics.</article-title><source>BMC Systems Biology</source><volume>1</volume><fpage>S6</fpage></citation></ref><ref id="pone.0004967-Rojas2"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rojas</surname><given-names>I</given-names></name><name><surname>Golebiewski</surname><given-names>M</given-names></name><name><surname>Kania</surname><given-names>R</given-names></name><name><surname>Krebs</surname><given-names>O</given-names></name><name><surname>Mir</surname><given-names>S</given-names></name><etal/></person-group><year>2007</year><article-title>Storing and annotating of kinetic data.</article-title><source>In Silico Biol</source><volume>7</volume><fpage>S37</fpage><lpage>44</lpage><pub-id pub-id-type="pmid">17822389</pub-id></citation></ref><ref id="pone.0004967-Funahashi1"><label>21</label><citation citation-type="journal"><person-group person