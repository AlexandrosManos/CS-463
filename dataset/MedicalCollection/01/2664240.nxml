7</td><td align="center" rowspan="1" colspan="1">0.044</td><td align="center" rowspan="1" colspan="1">0.162</td></tr><tr><td align="left" rowspan="1" colspan="1">A / C moderate</td><td align="center" rowspan="1" colspan="1">0.031</td><td align="center" rowspan="1" colspan="1">&#x02212;0.038 to 0.099</td><td align="center" rowspan="1" colspan="1">0.035</td><td align="center" rowspan="1" colspan="1">0.381</td></tr><tr><td align="left" rowspan="1" colspan="1">A / C strict</td><td align="center" rowspan="1" colspan="1">0.021</td><td align="center" rowspan="1" colspan="1">&#x02212;0.052 to 0.094</td><td align="center" rowspan="1" colspan="1">0.037</td><td align="center" rowspan="1" colspan="1">0.581</td></tr><tr><td align="left" rowspan="1" colspan="1">C liberal/C moderate</td><td align="center" rowspan="1" colspan="1">0.031</td><td align="center" rowspan="1" colspan="1">&#x02212;0.042 to 0.103</td><td align="center" rowspan="1" colspan="1">0.037</td><td align="center" rowspan="1" colspan="1">0.408</td></tr><tr><td align="left" rowspan="1" colspan="1">C liberal/C strict</td><td align="center" rowspan="1" colspan="1">0.082</td><td align="center" rowspan="1" colspan="1">&#x02212;0.009 to 0.172</td><td align="center" rowspan="1" colspan="1">0.046</td><td align="center" rowspan="1" colspan="1">0.078</td></tr><tr><td align="left" rowspan="1" colspan="1">C moderate/C strict</td><td align="center" rowspan="1" colspan="1">0.051</td><td align="center" rowspan="1" colspan="1">&#x02212;0.014 to 0.117</td><td align="center" rowspan="1" colspan="1">0.033</td><td align="center" rowspan="1" colspan="1">0.127</td></tr></tbody></table><table-wrap-foot><fn id="tfn2-cln63_3p0333"><p>A: Anderson; C: Caprioli</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>