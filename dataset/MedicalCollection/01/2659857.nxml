>Other</td><td colspan="1" rowspan="1" align="center" valign="top">7.90</td><td colspan="1" rowspan="1" align="center" valign="top">4.26</td><td colspan="1" rowspan="1" align="center" valign="top">2.39</td><td colspan="1" rowspan="1" align="center" valign="top">0.74</td><td colspan="1" rowspan="1" align="center" valign="top">0.29</td><td colspan="1" rowspan="1" align="center" valign="top">0.13</td></tr><tr><td colspan="7" rowspan="1" align="left" valign="top" content-type="TableSubHead"><bold>Men</bold></td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">White/not recorded</td><td colspan="1" rowspan="1" align="center" valign="top">14.93</td><td colspan="1" rowspan="1" align="center" valign="top">7.72</td><td colspan="1" rowspan="1" align="center" valign="top">4.21</td><td colspan="1" rowspan="1" align="center" valign="top">1.43</td><td colspan="1" rowspan="1" align="center" valign="top">0.54</td><td colspan="1" rowspan="1" align="center" valign="top">0.20</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Indian</td><td colspan="1" rowspan="1" align="center" valign="top">20.52</td><td colspan="1" rowspan="1" align="center" valign="top">13.07</td><td colspan="1" rowspan="1" align="center" valign="top">8.55</td><td colspan="1" rowspan="1" align="center" valign="top">4.21</td><td colspan="1" rowspan="1" align="center" valign="top">2.09</td><td colspan="1" rowspan="1" align="center" valign="top">1.20</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Pakistani</td><td colspan="1" rowspan="1" align="center" valign="top">27.21</td><td colspan="1" rowspan="1" align="center" valign="top">19.32</td><td colspan="1" rowspan="1" align="center" valign="top">13.93</td><td colspan="1" rowspan="1" align="center" valign="top">7.42</td><td colspan="1" rowspan="1" align="center" valign="top">3.68</td><td colspan="1" rowspan="1" align="center" valign="top">2.19</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Bangladeshi