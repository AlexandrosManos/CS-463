><given-names>MC</given-names></name><name><surname>Nishikawa</surname><given-names>J</given-names></name><name><surname>Hayward</surname><given-names>RSA</given-names></name><article-title>The well-built clinical question: a key to evidence-based decisions</article-title><source>ACP J Club</source><year>1995</year><volume>123</volume><issue>3</issue><fpage>A12</fpage><lpage>A13</lpage><pub-id pub-id-type="pmid">7582737</pub-id></mixed-citation></ref><ref id="B35"><mixed-citation publication-type="journal"><name><surname>Demner-Fushman</surname><given-names>D</given-names></name><name><surname>Few</surname><given-names>B</given-names></name><name><surname>Hauser</surname><given-names>SE</given-names></name><name><surname>Thoma</surname><given-names>GR</given-names></name><article-title>Automatically Identifying Health Outcome Information in MEDLINE Records</article-title><source>Journal of the American Medical Informatics Association</source><year>2006</year><volume>13</volume><issue>1</issue><fpage>52</fpage><lpage>60</lpage><pub-id pub-id-type="pmid">16221937</pub-id><pub-id pub-id-type="doi">10.1197/jamia.M1911</pub-id></mixed-citation></ref><ref id="B36"><mixed-citation publication-type="book"><name><surname>Xu</surname><given-names>R</given-names></name><name><surname>Garten</surname><given-names>Y</given-names></name><name><surname>Supekar</surname><given-names>KS</given-names></name><name><surname>Das</surname><given-names>AK</given-names></name><name><surname>Altman</surname><given-names>RB</given-names></name><name><surname>Garber</surname><given-names>AM</given-names></name><person-group person-group-type="editor">et al KK</person-group><article-title>Extracting Subject Demographic Information from Abstracts of Randomized Clinical Trial Reports</article-title><source>Proceedings of MedInfo</source><year>2007</year><publisher-name>IOS Press</publisher-name></mixed-citation></ref><ref id="B37"><mixed-citation publication-type="journal"><name><surname>Dawes</