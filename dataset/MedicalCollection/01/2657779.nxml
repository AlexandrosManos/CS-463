gn="center">0.96</td></tr><tr><td align="center">Conclusion</td><td align="center">0.99</td><td align="center">0.99</td><td align="center">0.99</td><td align="center">1.00</td><td align="center">1.00</td><td align="center">1.00</td><td align="center">0.97</td><td align="center">0.97</td><td align="center">0.97</td></tr><tr><td colspan="10"><hr/></td></tr><tr><td align="center"><bold>System 3</bold></td><td align="center" colspan="3">Accuracy = 94.77%</td><td align="center" colspan="3">Accuracy = 94.89%</td><td align="center" colspan="3">Accuracy = 94.07%</td></tr><tr><td/><td colspan="9"><hr/></td></tr><tr><td align="center">Aim</td><td align="center">0.98</td><td align="center">0.99</td><td align="center">0.99</td><td align="center">0.98</td><td align="center">0.99</td><td align="center">0.99</td><td align="center">0.98</td><td align="center">0.98</td><td align="center">0.98</td></tr><tr><td align="center">Method</td><td align="center">0.89</td><td align="center">0.89</td><td align="center">0.89</td><td align="center">0.89</td><td align="center">0.88</td><td align="center">0.89</td><td align="center">0.90</td><td align="center">0.88</td><td align="center">0.89</td></tr><tr><td align="center"><bold>Outcome Measure</bold></td><td align="center"><bold>0.81</bold></td><td align="center"><bold>0.77</bold></td><td align="center"><bold>0.79</bold></td><td align="center"><bold>0.82</bold></td><td align="center"><bold>0.77</bold></td><td align="center"><bold>0.79</bold></td><td align="center"><bold>0.78</bold></td><td align="center"><bold>0.77</bold></td><td align="center"><bold>0.78</bold></td></tr><tr><td align="center">Results</td><td align="center">0.98</td><td align="center">0.99</td><td align="center">0.98</td><td align="center">0.98</td><td align="center">0.99</td><td align="center">0.99</td><td align="center">0.96</td><td align="center">0.98</td><td align="center">0.97</td></tr><tr><td align="center">Conclusion</td><td align="center">0.99</td><td align="center">0.99</td><td align="center">0.99</td><td align="center">1.00</td><td align="center">1.00</td><td align="center">1.00</td><td align="center">0.99</td><td align="center">0.98</td><td align="center">0.98</td></tr><tr><td colspan="10"><hr/></td></tr><tr><td align="center"><bold>System 4</bold></td><td align="center" colspan="3">Accuracy = 95.60%</td><td align="center" colspan="3">Accuracy = 96.71%</td><td align="center" colspan="3">Accuracy = 93.09%</td></tr><tr><td/><td colspan="9"><hr/></td></tr><tr><td align="center">Aim</td><td align="center">0.99</td><td align="center">0.98</td><td align="center">0.98</td><td align="center">1.00</td><td align="center">1.00</td><td align="center">1.00</td><td align="center">0.96</td><td align="center">0.95</td><td align="center">0.96</td></tr><tr><td align="center">Method</td><td align="center">0.91</td><td align="center">0.89</td><td align="center">0.90</td><td align="center">0.92</td><td align="center">0.91</td><td align="center">0.92</td><td align="center">0.91</td><td align="center">0.85</td><td align="center">0.88</td></tr><tr><td align="center"><bold>Outcome Measure</bold></td><td align="center"><bold>0.82</bold></td><td align="center"><bold>0.85</bold></td><td align="center"><bold>0.84</bold></td><td align="center"><bold>0.85</bold></td><td align="center"><bold>0.86</bold></td><td align="center"><bold>0.85</bold></td><td align="center"><bold>0.76</bold></td><td align="center"><bold>0.83</bold></td><td align="center"><bold>0.79</bold></td></tr><tr><td align="center">Results</td><td align="center">0.99</td><td align="center">0.99</td><td align="center">0.99</td><td align="center">1.00</td><td align="center">1.00</td><td align="center">1.00</td><td align="center">0.96</td><td align="center">0.97</td><td align="center">0.96</td></tr><tr><td align="center">Conclusion</td><td align="center">0.99</td><td align="center">0.99</td><td align="center">0.99</td><td align="center">1.00</td><td align="center">1.00</td><td align="center">1.00</t