"pntd.0000419-Cummings1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cummings</surname><given-names>KL</given-names></name><name><surname>Tarleton</surname><given-names>RL</given-names></name></person-group><year>2003</year><article-title>Rapid quantitation of <italic>Trypanosoma cruzi</italic> in host tissue by real-time PCR.</article-title><source>Mol Biochem Parasitol</source><volume>129</volume><fpage>53</fpage><lpage>59</lpage><pub-id pub-id-type="pmid">12798506</pub-id></citation></ref><ref id="pntd.0000419-Piron1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Piron</surname><given-names>M</given-names></name><name><surname>Fisa</surname><given-names>R</given-names></name><name><surname>Casamitjana</surname><given-names>N</given-names></name><name><surname>L&#x000f3;pez-Chejade</surname><given-names>P</given-names></name><name><surname>Puig</surname><given-names>L</given-names></name><etal/></person-group><year>2007</year><article-title>Development of a real-time PCR assay for <italic>Trypanosoma cruzi</italic> detection in blood samples.</article-title><source>Acta Trop</source><volume>103</volume><fpage>195</fpage><lpage>200</lpage><pub-id pub-id-type="pmid">17662227</pub-id></citation></ref><ref id="pntd.0000419-Virreira1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Virreira</surname><given-names>M</given-names></name><name><surname>Martinez</surname><given-names>S</given-names></name><name><surname>Alonso-Vega</surname><given-names>C</given-names></name><name><surname>Torrico</surname><given-names>F</given-names></name><name><surname>Solano</surname><given-names>M</given-names></name><etal/></person-group><year>2006</year><article-title>Amniotic fluid is not useful for diagnosis of congenital <italic>Trypanosoma cruzi</italic> infection.</article-title><source>Am J Trop Me