e>221</lpage><pub-id pub-id-type="pmid">1662334</pub-id></citation></ref><ref id="pntd.0000419-Altcheh1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Altcheh</surname><given-names>J</given-names></name><name><surname>Biancardi</surname><given-names>M</given-names></name><name><surname>Lape&#x000f1;a</surname><given-names>A</given-names></name><name><surname>Ballering</surname><given-names>G</given-names></name><name><surname>Freilij</surname><given-names>H</given-names></name></person-group><year>2005</year><article-title>Congenital Chagas disease: experience in the Hospital de Ni&#x000f1;os, Ricardo Guti&#x000e9;rrez, Buenos Aires, Argentina.</article-title><source>Rev Soc Bras Med Trop</source><volume>2</volume><fpage>41</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">16482812</pub-id></citation></ref><ref id="pntd.0000419-Diez1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Diez</surname><given-names>M</given-names></name><name><surname>Favaloro</surname><given-names>L</given-names></name><name><surname>Bertolotti</surname><given-names>A</given-names></name><name><surname>Burgos</surname><given-names>JM</given-names></name><name><surname>Vigliano</surname><given-names>C</given-names></name><etal/></person-group><year>2007</year><article-title>Usefulness of PCR strategies for early diagnosis of Chagas' disease reactivation and treatment follow-up in heart transplantation.</article-title><source>Am J Transplant</source><volume>7</volume><fpage>1633</fpage><lpage>1640</lpage><pub-id pub-id-type="pmid">17511688</pub-id></citation></ref><ref id="pntd.0000419-Schijman1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schijman</surname><given-names>AG</given-names></name><name><surname>Altcheh</surname><given-names>J</given-names></name><name><surname>Burgos</surname><given-names>JM</give