ge>162</lpage><pub-id pub-id-type="pmid">8273735</pub-id></citation></ref><ref id="pntd.0000419-Elias1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Elias</surname><given-names>MC</given-names></name><name><surname>Vargas</surname><given-names>NS</given-names></name><name><surname>Zingales</surname><given-names>B</given-names></name><name><surname>Schenkman</surname><given-names>S</given-names></name></person-group><year>2003</year><article-title>Organization of satellite DNA in the genome of <italic>Trypanosoma cruzi</italic>.</article-title><source>Mol Biochem Parasitol</source><volume>129</volume><fpage>1</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">12798501</pub-id></citation></ref><ref id="pntd.0000419-Martins1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martins</surname><given-names>C</given-names></name><name><surname>Baptista</surname><given-names>CS</given-names></name><name><surname>Ienne</surname><given-names>S</given-names></name><name><surname>Cerqueira</surname><given-names>GC</given-names></name><name><surname>Bartholomeu</surname><given-names>DC</given-names></name><name><surname>Zingales</surname><given-names>B</given-names></name></person-group><year>2008</year><article-title>Genomic organization and transcription analysis of the 195-bp satellite DNA in <italic>Trypanosoma cruzi</italic>.</article-title><source>Mol Biochem Parasitol</source><volume>160</volume><fpage>60</fpage><lpage>64</lpage><pub-id pub-id-type="pmid">18440654</pub-id></citation></ref><ref id="pntd.0000419-Vargas1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vargas</surname><given-names>N</given-names></name><name><surname>Pedroso</surname><given-names>A</given-names></name><name><surname>Zingales</surname><given-names>B</given-names></name></person-group><year>2004</year><article-title>Chro