d="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hirsch</surname><given-names>AM</given-names></name><name><surname>Bang</surname><given-names>M</given-names></name><name><surname>Ausubel</surname><given-names>FM</given-names></name></person-group><article-title>Ultrastructural analysis of ineffective alfalfa nodules formed by <italic>nif</italic>::Tn5 mutants of <italic>Rhizobium meliloti</italic></article-title><source>Journal of Bacteriology</source><year>1983</year><volume>155</volume><fpage>367</fpage><lpage>380</lpage><pub-id pub-id-type="pmid">6575011</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hirsch</surname><given-names>AM</given-names></name><name><surname>Smith</surname><given-names>CA</given-names></name></person-group><article-title>Effects of <italic>Rhizobium meliloti nif</italic> and <italic>fix</italic> mutants on alfalfa root nodule development</article-title><source>Journal of Bacteriology</source><year>1987</year><volume>169</volume><fpage>1137</fpage><lpage>1146</lpage><pub-id pub-id-type="pmid">3818542</pub-id></citation></ref><ref id="bib14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hussain</surname><given-names>A</given-names></name><name><surname>Jiang</surname><given-names>QY</given-names></name><name><surname>Broughton</surname><given-names>WJ</given-names></name><name><surname>Gresshoff</surname><given-names>PM</given-names></name></person-group><article-title><italic>Lotus japonicus</italic> nodulates and fixes nitrogen with the broad host range <italic>Rhizobium</italic> sp. NGR234</article-title><source>Plant and Cell Physiology</source><year>1999</year><volume>40</volume><fpage>894</fpage><lpage>899</lpage></citation></ref><ref id="bib15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jones</surname><given-na