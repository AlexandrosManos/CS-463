 load (corrected for parasite load and body condition)body condition</td><td align="char" char="." rowspan="1" colspan="1">11</td><td align="char" char="." rowspan="1" colspan="1">207.987194.716</td><td align="char" char="." rowspan="1" colspan="1">4.9974.6781</td><td align="char" char="." rowspan="1" colspan="1">0.0364<sup>*</sup>0.0422<sup>*</sup></td></tr><tr><td colspan="5" rowspan="1">(<italic>b</italic>) SSI&#x02014;<italic>polynomial regression</italic>&#x02014;<italic>optimum</italic></td><td rowspan="1" colspan="1"/><td align="char" char="." rowspan="1" colspan="1"/><td align="char" char="." rowspan="1" colspan="1"/><td align="char" char="." rowspan="1" colspan="1"/><td align="char" char="." rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">&#x02003;MHC class II <italic>B</italic></td><td align="char" char="." rowspan="1" colspan="1">0.02</td><td align="char" char="." rowspan="1" colspan="1">0.0157</td><td align="char" char="." rowspan="1" colspan="1">1.27</td><td align="char" char="." rowspan="1" colspan="1">0.215</td><td colspan="5" rowspan="1">(<italic>d</italic>) parasite load&#x02014;<italic>ANCOVA</italic></td></tr><tr><td rowspan="1" colspan="1">&#x02003;MHC class II <italic>B</italic> (quadratic)</td><td align="char" char="." rowspan="1" colspan="1">0.0567</td><td align="char" char="." rowspan="1" colspan="1">0.0169</td><td align="char" char="." rowspan="1" colspan="1">3.36</td><td align="char" char="." rowspan="1" colspan="1">0.0025<sup>**</sup></td><td rowspan="1" colspan="1">&#x02003;enclosure</td><td align="char" char="." rowspan="1" colspan="1">5</td><td align="char" char="." rowspan="1" colspan="1">2.212</td><td align="char" char="." rowspan="1" colspan="1">4.145</td><td align="char" char="." rowspan="1" colspan="1">0.0036<sup>**</sup></td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">&#x02003;sex</td><td align="char" char="." rowspan="1" colspan="1">1</td><td align="char" char="." rowspan="1" colspan="1">1.401</td><td align="char" char="." rowspan="1" colspan="1">13.123</td><td align="char" char="." rowspan="1" colspan="1">0.0008<sup>***</sup></td></tr><tr><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1">&#x02003;body condition (corrected body condition and sex)</td><td align="char" char="." rowspan="1" colspan="1">1</td><td align="char" char="." rowspan="1" colspan="1">0.086</td><td align="char" char="." rowspan="1" colspan="1">0.8061</td><td align="char" char="." rowspan="1" colspan="1">0.3742</td></tr></tbody></table></table-wrap></floats-wrap></article>