><surname>Van Cutsem</surname><given-names>E</given-names></name><name><surname>Benson</surname><given-names>AB</given-names><suffix>III</suffix></name><name><surname>Blanke</surname><given-names>CD</given-names></name><name><surname>Diasio</surname><given-names>RB</given-names></name><name><surname>Grothey</surname><given-names>A</given-names></name><name><surname>Lenz</surname><given-names>HJ</given-names></name><name><surname>Meropol</surname><given-names>NJ</given-names></name><name><surname>Ramanathan</surname><given-names>RK</given-names></name><name><surname>Becerra</surname><given-names>CH</given-names></name><name><surname>Wickham</surname><given-names>R</given-names></name><name><surname>Armstrong</surname><given-names>D</given-names></name><name><surname>Viele</surname><given-names>C</given-names></name></person-group><article-title>The continuum of care: a paradigm for the management of metastatic colorectal cancer</article-title><source>Oncologist</source><year>2007</year><volume>12</volume><fpage>38</fpage><lpage>50</lpage><!--PubMed citation query: 'Oncologist||12|38||bib10|'--><pub-id pub-id-type="pmid">17227899</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Green</surname><given-names>JB</given-names></name><name><surname>Timmcke</surname><given-names>AE</given-names></name><name><surname>Mitchell</surname><given-names>WT</given-names></name><name><surname>Hicks</surname><given-names>TC</given-names></name><name><surname>Gathright</surname><given-names>JB</given-names><suffix>Jr</suffix></name><name><surname>Ray</surname><given-names>JE</given-names></name></person-group><article-title>Mucinous carcinoma&#x02014;just another colon cancer</article-title><source>Dis Colon Rectum</source><year>1993</year><volume>36</volume><fpage>49</fpage><lpage>54</lpage><!--PubMed citation query: 'Dis Colon Rectum||36|49||bib11|'--><pub-id pub-id-type="pmid">8380140</pub-id></citatio