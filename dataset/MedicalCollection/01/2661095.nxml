d="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Tiercy</surname><given-names>JM</given-names></name><name><surname>Grundschober</surname><given-names>C</given-names></name><name><surname>Jeannet</surname><given-names>M</given-names></name><name><surname>Mach</surname><given-names>B</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Hui KM, Bidwell JL</surname></name></person-group><article-title>A comprehensive HLA-DRB, -DQB, and -DPB oligotyping procedure by hybridization with sequence-specific oligonucleotide probes</article-title><source>Handbook of HLA Typing Techniques</source><year>1993</year><publisher-name>Boca Raton, FL: CRC Press, Inc</publisher-name><fpage>117</fpage><lpage>148</lpage></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nepom</surname><given-names>GT</given-names></name><name><surname>Byers</surname><given-names>P</given-names></name><name><surname>Seyfried</surname><given-names>C</given-names></name><name><surname>Healey</surname><given-names>LA</given-names></name><name><surname>Wilske</surname><given-names>KR</given-names></name><name><surname>Stage</surname><given-names>D</given-names></name><name><surname>Nepom</surname><given-names>BS</given-names></name></person-group><article-title>HLA genes associated with rheumatoid arthritis. Identification of susceptibility alleles using specific oligonucleotide probes</article-title><source>Arthritis Rheum</source><year>1989</year><volume>32</volume><fpage>15</fpage><lpage>21</lpage><pub-id pub-id-type="pmid">2492197</pub-id><pub-id pub-id-type="doi">10.1002/anr.1780320104</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haddock</surname><given-names>SH</given-names></name><name><surname>Quartararo</surname><given-names>C</given-names></name><name><surname>Coole