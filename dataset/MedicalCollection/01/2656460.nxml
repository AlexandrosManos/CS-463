surname>Karimzadeh</surname><given-names>F</given-names></name><name><surname>Moosavi-Movahedi</surname><given-names>AA</given-names></name><name><surname>Sarrafnejhad</surname><given-names>AA</given-names></name><name><surname>Sabouni</surname><given-names>F</given-names></name><name><surname>Bakhti</surname><given-names>M</given-names></name></person-group><article-title>Microglial Cell Death Induced by Glycated Bovine Serum Albumin: Nitric Oxide Involvement</article-title><source>J Biochem</source><year>2008</year><volume>144</volume><fpage>197</fpage><lpage>206</lpage><pub-id pub-id-type="pmid">18463114</pub-id><pub-id pub-id-type="doi">10.1093/jb/mvn059</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Verbeke</surname><given-names>P</given-names></name><name><surname>Siboska</surname><given-names>GE</given-names></name><name><surname>Clark</surname><given-names>BF</given-names></name><name><surname>Rattan</surname><given-names>SI</given-names></name></person-group><article-title>Kinetin inhibits protein oxidation and glycoxidation in vitro</article-title><source>Biochem Biophys Res Commun</source><year>2000</year><volume>276</volume><fpage>1265</fpage><lpage>1270</lpage><pub-id pub-id-type="pmid">11027621</pub-id><pub-id pub-id-type="doi">10.1006/bbrc.2000.3616</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Syrovy</surname><given-names>I</given-names></name></person-group><article-title>Glycation of albumin: reaction with glucose, fructose, galactose, ribose or glyceraldehyde measured using four methods</article-title><source>J Biochem Biophys Methods</source><year>1994</year><volume>28</volume><fpage>115</fpage><lpage>121</lpage><pub-id pub-id-type="pmid">8040561</pub-id><pub-id pub-id-type="doi">10.1016/0165-022X(94)90025-6</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Khalifah</surname><given-names>RG</given-names></name><name><surname>Todd</surname><given-names>P</given-names></name><name><surname>Booth</surname><given-names>AA</given-names></name><name><surname>Yang</surname><given-names>SX</given-names></name><name><surname>Mott</surname><given-names>JD</given-names></name><name><surname>Hudson</surname><given-names>BG</given-names></name></person-group><article-title>Kinetics of nonenzymatic glycation of ribonuclease A leading to advanced glycation end products. Paradoxical inhibition by ribose leads to facile isolation of protein intermediate for rapid post-Amadori studies</article-title><source>Biochemistry</source><year>1996</year><volume>35</volume><fpage>4645</fpage><lpage>4654</lpage><pub-id pub-id-type="pmid">8664253</pub-id><pub-id pub-id-type="doi">10.1021/bi9525942</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tanaka</surname><given-names>S</given-names></name><name><surname>Avigad</surname><given-names>G</given-names></name><name><surname>Brodsky</surname><given-names>B</given-names></name><name><surname>Eikenberry</surname><given-names>EF</given-names></name></person-group><article-title>Glycation induces expansion of the molecular packing of collagen</article-title><source>J Mol Biol</source><year>1988</year><volume>203</volume><fpage>495</fpage><lpage>505</lpage><pub-id pub-id-type="pmid">3143838</pub-id><pub-id pub-id-type="doi">10.1016/0022-2836(88)90015-0</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Luciano Viviani</surname><given-names>G</given-names></name><name><surname>Puddu</surname><given-names>A</given-names></name><name><surname>Sacchi</surname><given-names>G</given-names></name><name><surname>Garuti</surname><given-names>A</given-names></name><name><surname>Storace</surname><given-names>D</given-names></name><name><surname>Durante</surname><given-names>A</given-names></name><name><surname>Monacelli</surname><given-names>F</given-names></name><name><surname>Odetti</surname><given-names>P</given-names></name></person-group><article-title>Glycated fetal calf serum affects the viability of an insulin-secreting cell line in vitro</article-title><source>Metabolism</source><year>2008</year><volume>57</volume><fpage>163</fpage><lpage>169</lpage><pub-id pub-id-type="pmid">18191044</pub-id><pub-id pub-id-type="doi">10.1016/j.metabol.2007.08.020</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kikuchi</surname><given-names>S</given-names></name><name><surname>Shinpo</surname><given-names>K</given-names></name><name><surname>Takeuchi</surname><given-names>M</given-names></name><name><surname>Yamagishi</surname><given-names>S</given-names></name><name><surname>Makita</surname><given-names>Z</given-names></name><name><surname>Sasaki</surname><given-names>N</given-names></name><name><surname>Tashiro</surname><given-names>K</given-names></name></person-group><article-title>Glycation &#x02013; a sweet tempter for neuronal death</article-title><source>Brain Res Brain Res Rev</source><year>2003</year><volume>41</volume><fpage>306</fpage><lpage>323</lpage><pub-id pub-id-type="pmid">12663085</pub-id><pub-id pub-id-type="doi">10.1016/S0165-0173(02)00273-4</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chetyrkin</surname><given-names>SV</given-names></name><name><surname>Mathis</surname><given-names>ME</given-names></name><name><surname>Ham</surname><given-names>AJ</given-names></name><name><surname>Hachey</surname><given-names>DL</given-names></name><name><surname>Hudson</surname><given-names>BG</given-names></name><name><surname>Voziyan</surname><given-names>PA</given-names></name></person-group><article-tit