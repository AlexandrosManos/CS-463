cle-title>Electromechanical time delay estimated by electromyography during cycling at different pedaling frequencies</article-title><source>J Elec Myo Kinesiol</source><year>2004</year><volume>14</volume><fpage>647</fpage><lpage>652</lpage><pub-id pub-id-type="doi">10.1016/j.jelekin.2004.04.004</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Reddy</surname><given-names>NP</given-names></name><name><surname>Buch</surname><given-names>O</given-names></name></person-group><article-title>Committee neural networks for speaker verification</article-title><source>Comput Progr Meth Biomed</source><year>2003</year><volume>72</volume><fpage>109</fpage><lpage>115</lpage><pub-id pub-id-type="doi">10.1016/S0169-2607(02)00127-X</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Das</surname><given-names>A</given-names></name><name><surname>Reddy</surname><given-names>NP</given-names></name><name><surname>Narayanan</surname><given-names>J</given-names></name></person-group><article-title>Hybrid fuzzy logic committee neural networks for recognition of swallow acceleration signals</article-title><source>Comput Meth Prog in Biomed</source><year>2001</year><volume>64</volume><fpage>87</fpage><lpage>99</lpage><pub-id pub-id-type="doi">10.1016/S0169-2607(00)00099-7</pub-id></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Reddy</surname><given-names>NP</given-names></name><name><surname>Prabhu</surname><given-names>D</given-names></name><name><surname>Palreddy</surname><given-names>S</given-names></name><name><surname>Gupta</surname><given-names>V</given-names></name><name><surname>Suryanarayanan</surname><given-names>S</given-names></name><name><surname>Canilang</surname><given-names>EP</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Dagli C, Akay A, Philips C, Fernadez B, Ghosh J</surname></name></person-group><article-title>Redundant neural networks for medical diagnosis: diagnosis of dysphagia</article-title><source>Intelligent Systems through Artificial Neural Networks</source><year>1995</year><volume>5</volume><publisher-name>New York:ASME Press</publisher-name><fpage>699</fpage><lpage>704</lpage></citation></ref></ref-list></back></article>