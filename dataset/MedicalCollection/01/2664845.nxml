e><name><surname>Mooy</surname><given-names>CM</given-names></name><name><surname>de Bruijn</surname><given-names>WC</given-names></name><name><surname>Mulder</surname><given-names>PG</given-names></name><name><surname>de Jong</surname><given-names>PT</given-names></name></person-group><article-title>Morphometric analysis of Bruch&#x02019;membrane, the choriocapillaris, and the choroid in aging.</article-title><source>Invest Ophthalmol Vis Sci</source><year>1994</year><volume>35</volume><fpage>2857</fpage><lpage>64</lpage><pub-id pub-id-type="pmid">8188481</pub-id></citation></ref><ref id="r13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Majji</surname><given-names>AB</given-names></name><name><surname>Cao</surname><given-names>J</given-names></name><name><surname>Chang</surname><given-names>KY</given-names></name><name><surname>Hayashi</surname><given-names>A</given-names></name><name><surname>Aggarwal</surname><given-names>S</given-names></name><name><surname>Grebe</surname><given-names>RR</given-names></name><name><surname>De Juan</surname><given-names>E</given-names><suffix>Jr</suffix></name></person-group><article-title>Age-related retinal pigment epithelium and Bruch&#x02019;s membrane degeneration in senescence-accelerated mouse.</article-title><source>Invest Ophthalmol Vis Sci</source><year>2000</year><volume>41</volume><fpage>3936</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">11053297</pub-id></citation></ref><ref id="r14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cousins</surname><given-names>SW</given-names></name><name><surname>Marin-Castano</surname><given-names>ME</given-names></name><name><surname>Espinosa-Heidmann</surname><given-names>DG</given-names></name><name><surname>Alexandridou</surname><given-names>A</given-names></name><name><surname>Striker</surname><given-names>L</given-names></name><name><surname>Elliot</su