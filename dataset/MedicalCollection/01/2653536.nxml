F4A2 (intron 8)</td></tr><tr><td></td><td></td><td></td><td align="left">28S-3875</td><td align="left">4+5 nt (3')</td><td></td><td></td><td align="left">E3</td><td></td></tr><tr><td></td><td></td><td></td><td align="left">28S-3976</td><td align="left">4+7 nt (5')</td><td align="left">snR37</td><td></td><td align="left">SNORA82/ACA10</td><td></td></tr><tr><td align="left">GGgACA31</td><td align="left">1</td><td align="left">130</td><td align="left">28S-1618</td><td align="left">5+5 nt (5')</td><td align="left">snR43</td><td></td><td align="left">ACA9</td><td align="left">mRNA CR391354 (intron 2)</td></tr><tr><td></td><td></td><td></td><td align="left">28S-1701</td><td align="left">6+4 nt (3')</td><td align="left">snR33</td><td></td><td align="left">ACA9</td><td></td></tr><tr><td align="left">GGgACA32</td><td align="left">1</td><td align="left">132</td><td align="left">28S-1664</td><td align="left">6+7 nt (5')</td><td align="left">snR5</td><td align="left">snoR81</td><td align="left">ACA52</td><td align="left">RPLP2 (intron 2)</td></tr><tr><td align="left">GGgACA33</td><td align="left">1</td><td align="left">138</td><td align="left">28S-1699</td><td align="left">6+4 nt (5')</td><td></td><td></td><td align="left">HBI-115</td><td align="left">mRNA CR523168 (intron 1)</td></tr><tr><td align="left">GGgACA34</td><td align="left">1</td><td align="left">123</td><td align="left">28S-1781</td><td align="left">7+4 nt (5')</td><td align="left">snR5</td><td></td><td align="left">ACA32</td><td align="left">ENSGALESTG00000033205 (intron 11)</td></tr><tr><td align="left">GGgACA35</td><td align="left">1</td><td align="left">134</td><td align="left">28S-2269</td><td align="left">8+3 nt (5')</td><td></td><td></td><td align="left">ACA61</td><td align="left">EST CK986810 (intron 3)</td></tr><tr><td align="left">GGgACA36</td><td align="left">1</td><td align="left">156</td><td align="left">28S-3126</td><td align="left">5+6 nt (5')</td><td align="left">snR3</td><td></td><td align="left">AC