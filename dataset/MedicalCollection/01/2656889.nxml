><surname>Anderson</surname><given-names>TJ</given-names></name><name><surname>Walker</surname><given-names>JR</given-names></name><name><surname>Krause</surname><given-names>A</given-names></name><name><surname>Evans</surname><given-names>DB</given-names></name><name><surname>Dixon</surname><given-names>JM</given-names></name></person-group><article-title>Predicting response and resistance to endocrine therapy: profiling patients on aromatase inhibitors</article-title><source>Cancer</source><year>2008</year><volume>112</volume><issue>3 Suppl</issue><fpage>689</fpage><lpage>694</lpage><pub-id pub-id-type="pmid">18072233</pub-id><pub-id pub-id-type="doi">10.1002/cncr.23187</pub-id></citation></ref><ref id="B5"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bonnefoi</surname><given-names>H</given-names></name><name><surname>Potti</surname><given-names>A</given-names></name><name><surname>Delorenzi</surname><given-names>M</given-names></name><name><surname>Mauriac</surname><given-names>L</given-names></name><name><surname>Campone</surname><given-names>M</given-names></name><name><surname>Tubiana-Hulin</surname><given-names>M</given-names></name><name><surname>Petit</surname><given-names>T</given-names></name><name><surname>Rouanet</surname><given-names>P</given-names></name><name><surname>Jassem</surname><given-names>J</given-names></name><name><surname>Blot</surname><given-names>E</given-names></name><name><surname>Becette</surname><given-names>V</given-names></name><name><surname>Farmer</surname><given-names>P</given-names></name><name><surname>Andre</surname><given-names>S</given-names></name><name><surname>Acharya</surname><given-names>CR</given-names></name><name><surname>Mukherjee</surname><given-names>S</given-names></name><name><surname>Cameron</surname><given-names>D</given-names></name><name><surname>Bergh</surname><given-names>J</given-names></name><name><surname>Nevins</surname><given-names>JR</given-names></name><