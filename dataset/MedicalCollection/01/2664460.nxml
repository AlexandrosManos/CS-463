d="B9"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sato</surname><given-names>M</given-names></name></person-group><article-title>Intraoviductal introduction of plasmid DNA and subsequent electroporation for efficient in vivo gene transfer to murine oviductal epithelium</article-title><source><italic>Molecular Reproduction and Development</italic></source><year>2005</year><volume>71</volume><issue>3</issue><fpage>321</fpage><lpage>330</lpage><pub-id pub-id-type="pmid">15803457</pub-id></citation></ref><ref id="B10"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>DG</given-names></name><name><surname>Kang</surname><given-names>HM</given-names></name><name><surname>Jang</surname><given-names>SK</given-names></name><name><surname>Shin</surname><given-names>H-S</given-names></name></person-group><article-title>Construction of a bifunctional mRNA in the mouse by using the internal ribosomal entry site of the encephalomyocarditis virus</article-title><source><italic>Molecular and Cellular Biology</italic></source><year>1992</year><volume>12</volume><issue>8</issue><fpage>3636</fpage><lpage>3643</lpage><pub-id pub-id-type="pmid">1321342</pub-id></citation></ref><ref id="B11"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mountford</surname><given-names>P</given-names></name><name><surname>Zevnik</surname><given-names>B</given-names></name><name><surname>D&#x000fc;wel</surname><given-names>A</given-names></name><etal/></person-group><article-title>Dicistronic targeting constructs: reporters and modifiers of mammalian gene expression</article-title><source><italic>Proceedings of the National Academy of Sciences of the United States of America</italic></source><year>1994</year><volume>91</volume><issue>10</issue><fpage>4303</fpage><lpage>4307</lpage><pub-id pub-id-type="pm