old></td><td align="left" rowspan="1" colspan="1"><bold>M</bold></td><td align="left" rowspan="1" colspan="1"><bold>+</bold></td><td align="left" rowspan="1" colspan="1"><bold>+</bold></td><td align="left" rowspan="1" colspan="1"><bold>+</bold></td><td align="left" rowspan="1" colspan="1"><bold>1</bold></td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>S-SSM2</bold></td><td align="left" rowspan="1" colspan="1"><bold>WH 8102</bold></td><td align="left" rowspan="1" colspan="1"><bold>W Sargasso Sea/34&#x000b0;24&#x02032;N, 72&#x000b0;03&#x02032;W</bold></td><td align="left" rowspan="1" colspan="1">&#x000a0;&#x000a0;&#x000a0;&#x000a0;<bold>0</bold></td><td align="left" rowspan="1" colspan="1"><bold>22 September 2001</bold></td><td align="left" rowspan="1" colspan="1"><bold>M</bold></td><td align="left" rowspan="1" colspan="1"><bold>+</bold></td><td align="left" rowspan="1" colspan="1"><bold>+</bold></td><td align="left" rowspan="1" colspan="1"><bold>+</bold></td><td align="left" rowspan="1" colspan="1"><bold>1</bold></td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>S-SSM5</bold></td><td align="left" rowspan="1" colspan="1"><bold>WH 8102</bold></td><td align="left" rowspan="1" colspan="1"><bold>W Sargasso Sea/34&#x000b0;24&#x02032;N, 72&#x000b0;03&#x02032;W</bold></td><td align="left" rowspan="1" colspan="1">&#x000a0;&#x000a0;<bold>95</bold></td><td align="left" rowspan="1" colspan="1"><bold>22 September 2001</bold></td><td align="left" rowspan="1" colspan="1"><bold>M</bold></td><td align="left" rowspan="1" colspan="1"><bold>+</bold></td><td align="left" rowspan="1" colspan="1"><bold>+</bold></td><td align="left" rowspan="1" colspan="1"><bold>+</bold></td><td align="left" rowspan="1" colspan="1"><bold>2</bold></td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>Syn 19</bold></td><td align="left" rowspan="1" colspan="1"><bold>WH 8109</bold></td><td align="left" rowspan="1" colspan="1"><bold>Sargasso Sea/34&#x000b0;06&#x02032;N, 61&#x000b0;01&#