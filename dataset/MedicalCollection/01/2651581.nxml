<surname>Szolovits</surname><given-names>P</given-names></name><name><surname>Pauker</surname><given-names>SG</given-names></name><article-title>Categorical and probabilistic reasoning in medical diagnosis.</article-title><source>Artif Intell Med</source><year>1978</year><volume>11</volume><fpage>115</fpage><lpage>144</lpage></mixed-citation></ref><ref id="B22"><mixed-citation publication-type="journal"><name><surname>Schwartz</surname><given-names>WB</given-names></name><name><surname>Patil</surname><given-names>RS</given-names></name><name><surname>Szolovits</surname><given-names>P</given-names></name><article-title>Artificial intelligence in medicine: where do we stand?</article-title><source>N Engl J Med</source><year>1987</year><volume>316</volume><fpage>685</fpage><lpage>688</lpage><pub-id pub-id-type="pmid">3821801</pub-id></mixed-citation></ref><ref id="B23"><mixed-citation publication-type="book"><name><surname>Arrow</surname><given-names>KJ</given-names></name><source>Social Choice and Individual Values</source><year>1951</year><publisher-name>New York: Wiley</publisher-name></mixed-citation></ref></ref-list></back></article>