<year>2003</year><article-title>Early modern human cranial remains from the Pestera cu Oase, Romania.</article-title><source>J Hum Evol</source><volume>45</volume><fpage>245</fpage><lpage>253</lpage><pub-id pub-id-type="pmid">14580595</pub-id></citation></ref><ref id="pone.0005151-Zilho1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zilh&#x000e3;o</surname><given-names>J</given-names></name></person-group><year>2002</year><fpage>52</fpage><lpage>69</lpage><comment>Aurignacian, behavior, modern: issues of definition in the emergence of the European Upper Paleolithic, Lisbonne</comment></citation></ref><ref id="pone.0005151-Trinkaus2"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Trinkaus</surname><given-names>E</given-names></name></person-group><year>2006</year><article-title>Modern Human versus Neandertal Evolutionary Distinctiveness.</article-title><source>Current Anthropology</source><volume>47</volume><fpage>597</fpage><lpage>619</lpage></citation></ref><ref id="pone.0005151-Vandermeersch1"><label>11</label><citation citation-type="other"><person-group person-group-type="author"><name><surname>Vandermeersch</surname><given-names>B</given-names></name></person-group><year>1981</year><article-title>Les hommes fossiles de Qafzeh (Isra&#x000eb;l).</article-title><fpage>319</fpage><comment>Paris</comment></citation></ref><ref id="pone.0005151-BarYosef1"><label>12</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bar Yosef</surname><given-names>O</given-names></name><name><surname>Vandermeersch</surname><given-names>B</given-names></name></person-group><year>1991</year><article-title>Premiers hommes modernes et N&#x000e9;anderthaliens au Proche-Orient : chronologie et culture.</article-title><source>Aux origines d'Homo sapiens</source><publisher-loc>Paris</publisher-loc><publisher-name>P.U.F</publisher-name><fpage>217</fpage><lpage>250</lpage><comment>In: (eds) JJHeAMT,</comment></citation></ref><ref id="pone.0005151-BarYosef2"><label>13</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Bar Yosef</surname><given-names>O</given-names></name></person-group><year>1995</year><article-title>The Lower and Middle Palaeolithic in the Southern Levant: Chronology, and Cultural entities.</article-title><publisher-loc>Li&#x000e8;ge</publisher-loc><publisher-name>E.R.A.U.L. 62</publisher-name><fpage>247</fpage><lpage>263</lpage><comment>In: (&#x000e9;d) HU, editor.</comment></citation></ref><ref id="pone.0005151-Condemi2"><label>14</label><citation citation-type="other"><person-group person-group-type="author"><name><surname>Condemi</surname><given-names>S</given-names></name></person-group><year>2007</year><article-title>Are the Neanderthals in the levant?</article-title><person-group person-group-type="editor"><name><surname>Faerman LKH</surname><given-names>M</given-names></name><name><surname>Kahana et Uri Zilberman</surname><given-names>T</given-names></name></person-group><fpage>28</fpage><lpage>35</lpage><comment>BAR International Series 1603., editor. In: Faces from the Past -Diachronic Patterns in the Biology of Human Populations from the Eastern Southern. Archaeopress. Oxford</comment></citation></ref><ref id="pone.0005151-Lumleyde1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lumley (de)</surname><given-names>MA</given-names></name></person-group><year>1973</year><article-title>Ant&#x000e9;n&#x000e9;andertaliens et N&#x000e9;andertaliens du bassin m&#x000e9;diterran&#x000e9;en western europ&#x000e9;en, &#x000c9;tudes quaternaire 2.</article-title><source>Marseille</source></citation></ref><ref id="pone.0005151-Hambcken1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamb&#x000fc;cken</surname><given-names>A</given-names></name></person-group><year>1997</year><article-title>La variabilit&#x000e9; g&#x000e9;ographique des n&#x000e9;anderthaliens: apport de l'&#x000e9;tude du membre sup&#x000e9;rieur.</article-title><source>Anthropol Pr&#x000e9;hist</source><volume>108</volume><fpage>109</fpage><lpage>120</lpage></citation></ref><ref id="pone.0005151-Condemi3"><label>17</label><citation citation-type="other"><person-group person-group-type="author"><name><surname>Condemi</surname><given-names>S</given-names></name></person-group><year>2001</year><article-title>Les N&#x000e9;anderthaliens de La Chaise. Editions du Comit&#x000e9; des Travaux Historiques et Scientifiques CTHS.</article-title><fpage>178</fpage><comment>Documents pr&#x000e9;histoire, 15, Paris</comment></citation></ref><ref id="pone.0005151-Rosas1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rosas</surname><given-names>A</given-names></name><name><surname>Martinez-Maza</surname><given-names>C</given-names></name><name><surname>Bastir</surname><given-names>M</given-names></name><name><surname>Garcia-Tabernero</surname><given-names>A</given-names></name><name><surname>Lalueza-Fox</surname><given-names>C</given-names></name><etal/></person-group><year>2006</year><article-title>Paleobiology and comparative morphology of a late Neandertal sample from El Sidron, Asturias, Spain.</article-title><source>Proc Natl Acad Sci U S A</source><volume>103</volume><fpage>19266</fpage><lpage>19271</lpage><pub-id pub-id-type="pmid">17164326</pub-id></citation></ref><ref id="pone.0005151-Serre1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Serre</surname><given-names>D</given-names></name><name><surname>Langaney</surname><given-names>A</given-names></name><name><surname>Chech</surname><given-names>M</given-names></name><name><surname>Teschler-Nicola</surname><given-names>M</given-names></name><name><su