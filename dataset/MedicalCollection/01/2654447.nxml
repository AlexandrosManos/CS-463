ame><given-names>B</given-names></name><name><surname>Gustafsson</surname><given-names>LL</given-names></name><article-title>Design and implementation of a point-of-care computerized system for drug therapy in Stockholm metropolitan health region-Bridging the gap between knowledge and practice</article-title><source>Int J Med Inform</source><year>2007</year><volume>76</volume><fpage>497</fpage><lpage>506</lpage><pub-id pub-id-type="doi">10.1016/j.ijmedinf.2006.02.010</pub-id><pub-id pub-id-type="pmid">16621683</pub-id></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="journal"><name><surname>Kristensen</surname><given-names>N</given-names></name><article-title>[Danish pharmacies have a safe and quick electronic service] In Danish: Danske apoteker har en sikker og hurtig e-handelslosning</article-title><source>Ugeskr Laeger</source><year>2005</year><volume>167</volume><fpage>1546</fpage><pub-id pub-id-type="pmid">15887760</pub-id></mixed-citation></ref><ref id="B19"><mixed-citation publication-type="journal"><name><surname>Grimsmo</surname><given-names>A</given-names></name><article-title>[Electronic prescriptions&#x02013;without side-effects?] In Norwegian: Elektronisk resept&#x02013;uten bivirkninger?</article-title><source>Tidsskr Nor Laegeforen</source><year>2006</year><volume>126</volume><fpage>1740</fpage><lpage>1743</lpage><pub-id pub-id-type="pmid">16794667</pub-id></mixed-citation></ref><ref id="B20"><mixed-citation publication-type="journal"><name><surname>Koppel</surname><given-names>R</given-names></name><name><surname>Metlay</surname><given-names>JP</given-names></name><name><surname>Cohen</surname><given-names>A</given-names></name><name><surname>Abaluck</surname><given-names>B</given-names></name><name><surname>Localio</surname><given-names>AR</given-names></name><name><surname>Kimmel</surname><given-names>SE</given-names></name><name><surname>Strom</surname><given-names>BL</given-names></name><article-title>Role of computerized physician order entry systems in facilitating medication errors</article-title><source>Jama</source><year>2005</year><volume>293</volume><fpage>1197</fpage><lpage>1203</lpage><pub-id pub-id-type="doi">10.1001/jama.293.10.1197</pub-id><pub-id pub-id-type="pmid">15755942</pub-id></mixed-citation></ref><ref id="B21"><mixed-citation publication-type="journal"><name><surname>&#x000c5;strand</surname><given-names>B</given-names></name><name><surname>Hovstadius</surname><given-names>B</given-names></name><name><surname>Antonov</surname><given-names>K</given-names></name><name><surname>Petersson</surname><given-names>G</given-names></name><article-title>The Swedish National Pharmacy Register</article-title><source>Stud Health Technol Inform</source><year>2007</year><volume>129</volume><fpage>345</fpage><lpage>349</lpage><pub-id pub-id-type="pmid">17911736</pub-id></mixed-citation></ref><ref id="B22"><mixed-citation publication-type="journal"><name><surname>Wettermark</surname><given-names>B</given-names></name><name><surname>Hammar</surname><given-names>N</given-names></name><name><surname>Fored</surname><given-names>CM</given-names></name><name><surname>Leimanis</surname><given-names>A</given-names></name><name><surname>Otterblad Olausson</surname><given-names>P</given-names></name><name><surname>Bergman</surname><given-names>U</given-names></name><name><surname>Persson</surname><given-names>I</given-names></name><name><surname>Sundstrom</surname><given-names>A</given-names></name><name><surname>Westerholm</surname><given-names>B</given-names></name><name><surname>Rosen</surname><given-names>M</given-names></name><article-title>The new Swedish Prescribed Drug Register-Opportunities for pharmacoepidemiological research and experience from the first six months</article-title><source>Pharmacoepidemiol Drug Saf</source><year>2007</year><volume>16</volume><fpage>726</fpage><lpage>735</lpage><pub-id pub-id-type="doi">10.1002/pds.1294</pub-id><pub-id pub-id-type="pmid">16897791</pub