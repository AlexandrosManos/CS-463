nt membranes</article-title><source>Mol Biol Cell</source><year>2001</year><volume>12</volume><issue>8</issue><fpage>2453</fpage><lpage>68</lpage><pub-id pub-id-type="pmid">11514628</pub-id></mixed-citation></ref><ref id="B10"><mixed-citation publication-type="journal"><name><surname>Larsson</surname><given-names>R</given-names></name><name><surname>Nygren</surname><given-names>P</given-names></name><article-title>A rapid fluorometric method for semiautomated determination of cytotoxicity and cellular proliferation of human tumor cell lines in microculture</article-title><source>Anticancer Res</source><year>1989</year><volume>9</volume><issue>4</issue><fpage>1111</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">2817793</pub-id></mixed-citation></ref><ref id="B11"><mixed-citation publication-type="journal"><name><surname>Johansson</surname><given-names>D</given-names></name><article-title>Verotoxin-1 induction of apoptosis in Gb3-expressing human glioma cell lines</article-title><source>Cancer Biol Ther</source><year>2006</year><volume>5</volume><issue>9</issue><fpage>1211</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">16929170</pub-id></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><name><surname>Johansson</surname><given-names>D</given-names></name><name><surname>Johansson</surname><given-names>A</given-names></name><name><surname>Behnam-Motlagh</surname><given-names>P</given-names></name><article-title>alpha-Toxin of Staphylococcus aureus overcomes acquired cisplatin-resistance in malignant mesothelioma cells</article-title><source>Cancer Lett</source><year>2008</year><volume>265</volume><issue>1</issue><fpage>67</fpage><lpage>75</lpage><pub-id pub-id-type="pmid">18362050</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Korzeniewski</surname><given-names>C</given-names></name><name><surname>Callewaert</surname><given-names>DM</given-names></name><article-title>An enzyme-release assay for natural cytotoxicity</article-title><source>J Immunol Methods</source><year>1983</year><volume>64</volume><issue>3</issue><fpage>313</fpage><lpage>20</lpage><pub-id pub-id-type="pmid">6199426</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Gitig</surname><given-names>DM</given-names></name><name><surname>Koff</surname><given-names>A</given-names></name><article-title>Cdk pathway: cyclin-dependent kinases and cyclin-dependent kinase inhibitors</article-title><source>Mol Biotechnol</source><year>2001</year><volume>19</volume><issue>2</issue><fpage>179</fpage><lpage>88</lpage><pub-id pub-id-type="pmid">11725487</pub-id></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="journal"><name><surname>Larsen</surname><given-names>JK</given-names></name><article-title>"Washless" procedures for nuclear antigen detection</article-title><source>Methods Cell Biol</source><year>1994</year><volume>41</volume><fpage>377</fpage><lpage>88</lpage><pub-id pub-id-type="pmid">7532266</pub-id></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="journal"><name><surname>Jimeno</surname><given-names>A</given-names></name><name><surname>Hidalgo</surname><given-names>M</given-names></name><article-title>Blockade of epidermal growth factor receptor (EGFR) activity</article-title><source>Crit Rev Oncol Hematol</source><year>2005</year><volume>53</volume><issue>3</issue><fpage>179</fpage><lpage>92</lpage><pub-id pub-id-type="pmid">15718144</pub-id></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="journal"><name><surname>Abe</surname><given-names>A</given-names></name><article-title>Improved inhibitors of glucosylceramide synthase</article-title><source>J Biochem</source><year>1992</year><volume>111</volume><issue>2</issue><fpage>191</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">1533217</pub-id></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="journal"><name><surname>Bold</surname><given-names>RJ</given-names></name><name><surname>Termuhlen</surname><given-names>PM</given-names></name><name><surname>McConkey</surname><given-names>DJ</given-names></name><article-title>Apoptosis, cancer and cancer therapy</article-title><source>Surg Oncol</source><year>1997</year><volume>6</volume><issue>3</issue><fpage>133</fpage><lpage>42</lpage><pub-id pub-id-type="pmid">9576629</pub-id></mixed-citation></ref><ref id="B19"><mixed-citation publication-type="journal"><name><surname>Mese</surname><given-names>H</given-names></name><article-title>Regulation of apoptosis reduction in the cisplatin-resistant A431 cell line by Bcl-2 and CPP32</article-title><source>Chemotherapy</source><year>2000</year><volume>46</volume><issue>1</issue><fpage>69</fpage><lpage>76</lpage><pub-id pub-id-type="pmid">10601800</pub-id></mixed-citation></ref><ref id="B20"><mixed-citation publication-type="journal"><name><surname>Igney</surname><given-names>FH</given-names></name><name><surname>Krammer</surname><given-names>PH</given-names></name><article-title>Death and anti-death: tumour resistance to apoptosis</article-title><source>Nat Rev Cancer</source><year>2002</year><volume>2</volume><issue>4</issue><fpage>277</fpage><lpage>88</lpage><pub-id pub-id-type="pmid">12001989</pub-id></mixed-citation></ref><ref id="B21"><mixed-citation publication-type="journal"><name><surname>Arab</surname><given-names>S</given-names></name><article-title>Verotoxins inhibit the growth of and induce apoptosis in human astrocytoma cells</article-title><source>J Neurooncol</source><year>1998</year><volume>40</volume><issue>2</issue><fpage>137</fpage><lpage>50</lpage><pub-id pub-id-type="pmid">9892096</pub-id></mixed-citation></ref><ref id="B22"><mixed-citation publication-type="journal"><name><surname>Bhattacharjee</surname><given-names>RN</given-names></name><article-title>Escherichia coli verotoxin 1 mediates apoptosis in human HCT116 colon cancer cells by inducing overexpr