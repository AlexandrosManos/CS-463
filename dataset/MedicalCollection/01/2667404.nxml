<name><surname>&#x000d8;stergaard</surname><given-names>L</given-names></name></person-group><article-title>Population-based strategies for outreach screening of urogenital <italic>Chlamydia trachomatis </italic>infections: a randomized, controlled trial</article-title><source>J Infect Dis</source><year>2002</year><volume>185</volume><fpage>252</fpage><lpage>258</lpage><pub-id pub-id-type="pmid">11807700</pub-id><pub-id pub-id-type="doi">10.1086/338268</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ethier</surname><given-names>KA</given-names></name><name><surname>Kershaw</surname><given-names>T</given-names></name><name><surname>Niccolai</surname><given-names>L</given-names></name><name><surname>Lewis</surname><given-names>JB</given-names></name><name><surname>Ickovics</surname><given-names>JR</given-names></name></person-group><article-title>Adolescent women underestimate their susceptibility to sexually transmitted infections</article-title><source>Sex Trans Infect</source><year>2003</year><volume>79</volume><fpage>408</fpage><lpage>411</lpage><pub-id pub-id-type="doi">10.1136/sti.79.5.408</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fenton</surname><given-names>KA</given-names></name><name><surname>Copas</surname><given-names>A</given-names></name><name><surname>Mitchell</surname><given-names>K</given-names></name><name><surname>Elam</surname><given-names>G</given-names></name><name><surname>Carder</surname><given-names>C</given-names></name><name><surname>Ridgway</surname><given-names>G</given-names></name><name><surname>Wellings</surname><given-names>K</given-names></name><name><surname>Erens</surname><given-names>B</given-names></name><name><surname>Field</surname><given-names>J</given-names></name><name><surname>Johnson</surname><given-names>AM</given-names></name></person-group><article-title>T