-title><source>AlChe Annual Meeting: 20 November 2003; San Francisco</source></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wingren</surname><given-names>AA</given-names></name><name><surname>Galbe</surname><given-names>MM</given-names></name><name><surname>Zacchi</surname><given-names>GG</given-names></name></person-group><article-title>Techno-economic evaluation of producing ethanol from softwood: comparison of SSF and SHF and identification of bottlenecks</article-title><source>Biotechnol Progress</source><year>2003</year><volume>19</volume><fpage>1109</fpage><lpage>1117</lpage><pub-id pub-id-type="doi">10.1021/bp0340180</pub-id></citation></ref><ref id="B9"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Antti</surname><given-names>A</given-names></name><name><surname>Harri</surname><given-names>L</given-names></name><name><surname>Sanna</surname><given-names>P</given-names></name><name><surname>Timo</surname><given-names>K</given-names></name><name><surname>Juha</surname><given-names>L</given-names></name></person-group><source>Forest Energy Potential in Europe (EU27)</source><year>2008</year><publisher-name>Helsinki: Finnish Forest Research Institute</publisher-name></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Edwards</surname><given-names>RAH</given-names></name><name><surname>&#x00160;&#x000fa;ri</surname><given-names>M</given-names></name><name><surname>Huld</surname><given-names>TA</given-names></name><name><surname>Dallemand</surname><given-names>JF</given-names></name></person-group><article-title>GIS-based assessment of cereal straw energy in the European Union</article-title><source>Cereals Straw Resources for Bioenergy in the European Union: 18&#x02013;19 October 2006; Pamplona</source><publisher-name>Brussels: European Commission</publisher-name></citation></ref><ref id="B11"><citation citation-type="other"><person-group person-group-type="author"><collab>Sekab Group</collab></person-group><ext-link ext-link-type="uri" xlink:href="http://www.sekab.com"/></citation></ref><ref id="B12"><citation citation-type="other"><person-group person-group-type="author"><collab>Tore H&#x000f6;gn&#x000e4;s</collab></person-group><article-title>A comparison of timber haulage in Great Britain and Finland</article-title><source>Forestry Publications of Mets&#x000e4;hallitus 39: Vantaa: Mets&#x000e4;hallitus</source><year>2001</year></citation></ref><ref id="B13"><citation citation-type="other"><person-group person-group-type="author"><collab>Bioregional</collab></person-group><source>Straw Availability in the UK Wallington</source><year>2003</year></citation></ref><ref id="B14"><citation citation-type="other"><person-group person-group-type="author"><collab>Department for Environment Food and Rural Affairs/Department for Transport/Department for Trade and Industry</collab></person-group><source>UK Biomass Strategy London</source><year>2007</year></citation></ref><ref id="B15"><citation citation-type="other"><person-group person-group-type="author"><collab>RISI</collab></person-group><source>World Timber Price Quarterly</source><year>2004</year></citation></ref><ref id="B16"><citation citation-type="other"><person-group person-group-type="author"><collab>Forestry Commission</collab></person-group><source>Forestry Statistics 2006 &#x02013; Finance and Prices Edinburgh</source><year>2006</year></citation></ref><ref id="B17"><citation citation-type="other"><person-group person-group-type="author"><collab>Confederation of European Paper Industries</collab></person-group><source>Competitiveness and Europe's Pulp and Paper Industry Brussels</source><year>2005</year></citation></ref><ref id="B18"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Wingren</surname><given-names>A</given-names></name></person-group><source>Ethanol from Softwood: Techno-economic Evaluation for Development of the Enzymatic Process</source><year>2005</year><publisher-name>Lund: Department of Chemical Engineering, Lund University</publisher-name></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wingren</surname><given-names>A</given-names></name><name><surname>Soderstrom</surname><given-names>J</given-names></name><name><surname>Galbe</surname><given-names>MM</given-names></name><name><surname>Zacchi</surname><given-names>GG</given-names></name></person-group><article-title>Process considerations and economic evaluation of two-step steam pretreatment for production of fuel ethanol from softwood</article-title><source>Biotechnol Prog</source><year>2004</year><volume>20</volume><fpage>1421</fpage><pub-id pub-id-type="pmid">15458326</pub-id><pub-id pub-id-type="doi">10.1021/bp049931v</pub-id></citation></ref><ref id="B20"><citation citation-type="other"><person-group person-group-type="author"><collab>United Nations Economic Commission for Europe</collab></person-group><source>Forest ProductsAnnual Market Review 2004&#x02013;5 Geneva</source><year>2005</year></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamelinck</surname><given-names>CN</given-names></name><name><surname>Hooijdonk</surname><given-names>G</given-names></name><name><surname>Faaij</surname><given-names>A</given-names></name></person-group><article-title>Ethanol from lignocellulosic biomass: techno-economic performance in short-, middle- and long-term</article-title><source>Biomass Bioenergy</source><year>2005</year><volume>28</volume><fpage>384</fpage><pub-id pub-id-type="doi">10.1016/j.biombioe.2004.09.002</pub-id></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Suurs</surname><given-names>R</given-names></name></person-group><source>Long distance bioenergy logistics</source><year>2002</year><publisher-name>University of Utrecht, Copernicus Institute, Department of Science Technology and Society</publisher-name><pub-id pub-id-type="pmid">12172021</pub-id></citation></ref><ref id="B23"><citation citation-type="other"><person-group person-group-type="author"><collab>IPA Consulting and Mitsui Babcock</collab></person-group><source>The Economics of Co-firing, Report to DTI London</source><year>2006</year></citation></ref><ref id="B24"><citation citation-type="other"><person-group person-group-type="author"><collab>AEA Technology</collab></person-group><source>Renewable Heat and Heat from Combined Heat and Power Plants Study and Analysis; Report to DTI and DEFRA Didcot</source><year>2005</year></citation></ref><ref id="B25"><citation citation-type="other"><article-title>Recycled Paper Prices</article-title><ext-link ext-link-type="uri" xlink:href="http://www.letsrecycle.com/prices/paperPrices.jsp"/></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sassner</surname><given-names>P</given-names></name><name><surname>Galbe</surname><given-names>M</given-names></name><name><surname>Zacchi</surname><given-names>G</given-names></name></person-group><article-title>Techno-economic evaluation of bioethanol production from three different lignocellulosic materials</article-title><source>Biomass Bioenergy</source><year>2008</year><volume>32</volume><fpage>422</fpage><lpage>430</lpage><pub-id pub-id-type="doi">10.1016/j.biombioe.2007.10.014</pub-id></citation></ref><ref id="B27"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Peters</surname><given-names>MS</given-names></name><name><surname>Timmerhaus</surname><given-names>KD</given-names></name><name><surname>West</surname><given-names>R</given-names></name></person-group><source>Plant Design and Economics for Chemical Engineers</source><year>2003</year><edition>5</edition><publisher-name>London: McGraw-Hill</publisher-name></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Arrow</surname><given-names>KJ</given-names></name></person-group><article-title>The economic implications of learning by doing</article-title><source>Rev Econ Stud</source><year>1962</year><volume>29</volume><fpage>155</fpage><pub-id pub-id-type="doi">10.2307/2295952</pub-id></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Argote</surname><given-names>L</given-names></name><name><surname>Epple</surname><given-names>D</given-names></name></person-group><article-title>Learning curves in manufacturing</article-title><source>Science</source><year>1990</year><volume>247</volume><fpage>920</fpage><pub-id pub-id-type="pmid">17776451</pub-id><pub-id pub-id-type="doi">10.1126/science.247.4945.920</pub-id></citation></ref><ref id="B30"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Goldemberg</surname><given-names>J</given-names></name><name><surname>Coelho</surname><given-names>ST</given-names></name><name><surname>Nastari</surname><given-names>PM</given-names></name><name><surname>Lucon</surname><given-names>O</given-names></name></person-group><article-title>Ethanol learning curve &#x02013; the Brazilian experience</article-title><source>Biomass Bioenergy</source><year>2004</year><volume>26</volume><fpage>301</fpage><pub-id pub-id-type="doi">10.1016/S0961-9534(03)00125-9</pub-id></citation></ref><ref id="B31"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Coltrain</surname><given-names>D</given-names></name></person-group><source>Economic Issues with Ethanol, Revisited</source><year>2004</year><publisher-name>Manhattan, KS: Kansas Cooperative Development Center, Kansas State University, Department of Agricultural Economics</publisher-name></citation></ref><ref id="B32"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Reynolds</surname><given-names>R</given-names></name></person-group><source>The Current Fuel Ethanol Industry Transportation Marketing Distribution and Technical Considerations</source><year>2000</year><publisher-name>Oak Ridge National Laboratory. TN</publisher-name></citation></ref><ref id="B33"><citation citation-type="other"><person-group person-group-type="author"><collab>UK Petroleum Industry Association Limited</collab></person-group><source>Statistical Review 2006 London</source><year>2006</year><fpage>22</fpage></citation></ref></ref-list></back></article>