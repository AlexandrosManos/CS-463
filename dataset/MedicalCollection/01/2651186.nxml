le-title><italic>Zymomonas mobilis </italic>&#x02013; science and industrial application</article-title><source>Crit Rev Biotechnol</source><year>1993</year><volume>13</volume><fpage>57</fpage><lpage>98</lpage><pub-id pub-id-type="pmid">8477453</pub-id><pub-id pub-id-type="doi">10.3109/07388559309069198</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kalnenieks</surname><given-names>U</given-names></name></person-group><article-title>Physiology of <italic>Zymomonas mobilis</italic>: some unanswered questions</article-title><source>Adv Microb Physiol</source><year>2006</year><volume>51</volume><fpage>73</fpage><lpage>117</lpage><pub-id pub-id-type="pmid">17010696</pub-id><pub-id pub-id-type="doi">10.1016/S0065-2911(06)51002-1</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Swings</surname><given-names>J</given-names></name><name><surname>De Ley</surname><given-names>J</given-names></name></person-group><article-title>The biology of <italic>Zymomonas</italic></article-title><source>Bacteriol Rev</source><year>1977</year><volume>41</volume><fpage>1</fpage><lpage>46</lpage><pub-id pub-id-type="pmid">16585</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Deanda</surname><given-names>K</given-names></name><name><surname>Zhang</surname><given-names>M</given-names></name><name><surname>Eddy</surname><given-names>C</given-names></name><name><surname>Picataggio</surname><given-names>S</given-names></name></person-group><article-title>Development of an arabinose-fermenting <italic>Zymomonas mobilis </italic>strain by metabolic pathway engineering</article-title><source>Appl Environ Microbiol</source><year>1996</year><volume>62</volume><fpage>4465</fpage><lpage>4470</lpage><pub-id pub-id-type="pmid">8953718</pub-id></citation></ref><ref id=