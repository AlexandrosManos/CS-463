lign="left" rowspan="1" colspan="1">1.5</td><td align="left" rowspan="1" colspan="1">4.86</td><td align="left" rowspan="1" colspan="1">4.06</td></tr><tr><td align="left" rowspan="1" colspan="1">5005</td><td align="left" rowspan="1" colspan="1">267</td><td align="left" rowspan="1" colspan="1">19</td><td align="left" rowspan="1" colspan="1">0</td><td align="left" rowspan="1" colspan="1">ABC, NVP, SGC, NFV</td><td align="left" rowspan="1" colspan="1">2.0</td><td align="left" rowspan="1" colspan="1">5.30</td><td align="left" rowspan="1" colspan="1">4.99</td></tr><tr><td align="left" rowspan="1" colspan="1">4033</td><td align="left" rowspan="1" colspan="1">173</td><td align="left" rowspan="1" colspan="1">28</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">IDV, RTV, 3TC, ABC, NVP</td><td align="left" rowspan="1" colspan="1">3.5</td><td align="left" rowspan="1" colspan="1">4.83</td><td align="left" rowspan="1" colspan="1">5.23</td></tr><tr><td align="left" rowspan="1" colspan="1">4051</td><td align="left" rowspan="1" colspan="1">344</td><td align="left" rowspan="1" colspan="1">26</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">AZT, 3TC, EFV</td><td align="left" rowspan="1" colspan="1">2.0</td><td align="left" rowspan="1" colspan="1">5.61</td><td align="left" rowspan="1" colspan="1">5.41</td></tr><tr><td align="left" rowspan="1" colspan="1">5003</td><td align="left" rowspan="1" colspan="1">234</td><td align="left" rowspan="1" colspan="1">39</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">NFV, d4T, ABC</td><td align="left" rowspan="1" colspan="1">1.5</td><td align="left" rowspan="1" colspan="1">3.31</td><td align="left" rowspan="1" colspan="1">4.33</td></tr><tr><td align="left" rowspan="1" colspan="1">7036</td><td align="left" rowspan="1" colspan="1">267</td><td align="left" rowspan="1" colspan="1">150</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">AZT, 3TC, NVP</td><td align="left" rowspan="1" colspan="1">2.5</td><td align="left" rowspan="1" colspan="1">5.12</td><td align="left" rowspan="1" colspan="1">5.37</td></tr><tr><td align="left" rowspan="1" colspan="1">4013</td><td align="left" rowspan="1" colspan="1">148</td><td align="left" rowspan="1" colspan="1">6</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">3TC, NVP, NFV, d4T</td><td align="left" rowspan="1" colspan="1">2.0</td><td align="left" rowspan="1" colspan="1">4.62</td><td align="left" rowspan="1" colspan="1">4.75</td></tr><tr><td align="left" rowspan="1" colspan="1">4059</td><td align="left" rowspan="1" colspan="1">53</td><td align="left" rowspan="1" colspan="1">1</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">AZT, 3TC, LPVr</td><td align="left" rowspan="1" colspan="1">2.5</td><td align="left" rowspan="1" colspan="1">5.31</td><td align="left" rowspan="1" colspan="1">5.08</td></tr><tr><td align="left" rowspan="1" colspan="1">5002</td><td align="left" rowspan="1" colspan="1">59</td><td align="left" rowspan="1" colspan="1">23</td><td align="left" rowspan="1" colspan="1">3</td><td align="left" rowspan="1" colspan="1">3TC, NVP, NFV, ABC</td><td align="left" rowspan="1" colspan="1">2.5</td><td align="left" rowspan="1" colspan="1">4.24</td><td align="left" rowspan="1" colspan="1">5.32</td></tr><tr><td align="left" rowspan="1" colspan="1">7115</td><td align="left" rowspan="1" colspan="1">50</td><td align="left" rowspan="1" colspan="1">9</td><td align="left" rowspan="1" colspan="1">2</td><td align="left" rowspan="1" colspan="1">AZT, 3TC, LPVr</td><td align="left" rowspan="1" colspan="1">2.5</td><td align="left" rowspan="1" colspan="1">5.87</td><td align="left" rowspan="1" colspan="1">4.85</td></tr></tbody></table><table-wrap-foot><fn id="nt101"><label>a</label><p>Baseline samples.</p></fn><fn id="nt102"><label>b</label><p>Average CSF white blood cell counts over the first 14 days of antiretroviral therapy.</p></fn><fn id="nt103"><label>c</label><p>ADC staging: <xref ref-type="bibr" rid="ppat.1000395-Price2">&#x0005b;68&#x0005d;</xref>.</p></fn><fn id="nt104"><label>d</label><p>CNS Penetration Effectiveness Rank total. The CPE ranks for each drug in the regimen were summed to get the CPE total.</p></fn></table-wrap-foot></table-wrap><table-wrap id="ppat-1000395-t002" position="float"><object-id pub-id-type="doi">10.1371/journal.ppat.1000395.t002</object-id><label>Table 2</label><caption><title>HIV-1 variant decay.</title></caption><graphic id="ppat-1000395-t002-2" xlink:href="ppat.1000395.t002"/><table frame="hsides" rules="groups" alternate-form-of="ppat-1000395-t002-2"><colgroup span="1"><col align="left" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/></colgroup><thead><tr><td align="left" rowspan="1" colspan="1">Subject ID</td><td colspan="2" align="left" rowspan="1">&#x00025; HIV-1 RNA decrease (days on HAART)</td><td align="left" rowspan="1" colspan="1">Plasma Half-life (days)</td><td colspan="2" align="left" rowspan="1">CSF-Compartmentalized Variant Data</td><td colspan="2" align="left" rowspan="1">CSF Shared Variant Data</td><td align="left" rowspan="1" colspan="1">&#x00025; Diff.<xref ref-type="table-fn" rid="nt107">c</xref></td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">Plasma</td><td align="left" rowspan="1" colspan="1">CSF</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">&#x00025; CSF VL<xref ref-type="table-fn" rid="nt105">a</xref></td><td align="left" rowspan="1" colspan="1">Half-life (days)<xref ref-type="table-fn" rid="nt106">b</xref></td><td align="left" rowspan="1" colspan="1">&#x00025;