sue><fpage>94</fpage><lpage>101</lpage><pub-id pub-id-type="doi">10.1006/bbrc.1999.0591</pub-id><pub-id pub-id-type="pmid">10222241</pub-id></mixed-citation></ref><ref id="B7"><mixed-citation publication-type="journal"><name><surname>Stanley</surname><given-names>SA</given-names></name><name><surname>Raghavan</surname><given-names>S</given-names></name><name><surname>Hwang</surname><given-names>WW</given-names></name><name><surname>Cox</surname><given-names>JS</given-names></name><article-title>Acute infection and macrophage subversion by <italic>Mycobacterium tuberculosis </italic>require a specialized secretion system</article-title><source>Proc Natl Acad Sci USA</source><year>2003</year><volume>100</volume><issue>22</issue><fpage>13001</fpage><lpage>13006</lpage><pub-id pub-id-type="pmid">14557536</pub-id><pub-id pub-id-type="doi">10.1073/pnas.2235593100</pub-id></mixed-citation></ref><ref id="B8"><mixed-citation publication-type="journal"><name><surname>Ulrichs</surname><given-names>T</given-names></name><name><surname>Munk</surname><given-names>ME</given-names></name><name><surname>Mollenkopf</surname><given-names>H</given-names></name><name><surname>Behr-Perst</surname><given-names>S</given-names></name><name><surname>Colangeli</surname><given-names>R</given-names></name><name><surname>Gennaro</surname><given-names>ML</given-names></name><name><surname>Kaufmann</surname><given-names>SH</given-names></name><article-title>Differential T cell responses to <italic>Mycobacterium tuberculosis </italic>ESAT-6 in tuberculosis patients and healthy donors</article-title><source>Eur J Immunol</source><year>1998</year><volume>28</volume><issue>12</issue><fpage>3949</fpage><lpage>3958</lpage><pub-id pub-id-type="pmid">9862331</pub-id><pub-id pub-id-type="doi">10.1002/(SICI)1521-4141(199812)28:12&#x0003c;3949::AID-IMMU3949&#x0003e;3.0.CO;2-4</pub-id></mixed-citation></ref><ref id="B9"><mixed-citation publication-type="journal"><name><surname>Hsu</surname><given-names>T</giv