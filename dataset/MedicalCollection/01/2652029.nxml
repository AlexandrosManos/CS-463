ft" rowspan="1" colspan="1">30.0%</td><td align="left" rowspan="1" colspan="1">12.0%</td><td align="left" rowspan="1" colspan="1">5.8%</td><td align="left" rowspan="1" colspan="1">11.6%</td><td align="left" rowspan="1" colspan="1">13.7%</td><td align="left" rowspan="1" colspan="1">11.5%</td><td align="left" rowspan="1" colspan="1">6.1%</td><td align="left" rowspan="1" colspan="1">9.1%</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">23.8&#x02013;37.0</td><td align="left" rowspan="1" colspan="1">7.7&#x02013;18.4</td><td align="left" rowspan="1" colspan="1">3.5&#x02013;9.6</td><td align="left" rowspan="1" colspan="1">9.2&#x02013;14.4</td><td align="left" rowspan="1" colspan="1">9.7&#x02013;19.0</td><td align="left" rowspan="1" colspan="1">7.8&#x02013;16.8</td><td align="left" rowspan="1" colspan="1">4.0&#x02013;9.3</td><td align="left" rowspan="1" colspan="1">7.2&#x02013;11.5</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x000a0;&#x000a0;&#x000a0;&#x000a0;Bases WT (UWT)</td><td align="left" rowspan="1" colspan="1">103 (172)</td><td align="left" rowspan="1" colspan="1">200 (150)</td><td align="left" rowspan="1" colspan="1">344 (264)</td><td align="left" rowspan="1" colspan="1">647 (586)</td><td align="left" rowspan="1" colspan="1">117 (202)</td><td align="left" rowspan="1" colspan="1">224 (189)</td><td align="left" rowspan="1" colspan="1">357 (310)</td><td align="left" rowspan="1" colspan="1">698 (701)</td></tr><tr><td colspan="9" align="left" rowspan="1">Inconsistent condom use during vaginal and anal heterosexual intercourse in past 4 weeks (95% CI)</td></tr><tr><td align="left" rowspan="1" colspan="1">Married or cohabiting</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan=