<person-group person-group-type="author"><name><surname>Slaton</surname><given-names>MR</given-names></name><name><surname>Smith</surname><given-names>WK</given-names></name></person-group><article-title>Mesophyll architecture and cell exposure to intercellular air space in alpine, desert, and forest species</article-title><source>Int. J. Plant Sci</source><year>2002</year><volume>163</volume><fpage>937</fpage><lpage>948</lpage></citation></ref><ref id="b26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Slaton</surname><given-names>MR</given-names></name><name><surname>Hunt</surname><given-names>RE</given-names><suffix>Jr</suffix></name><name><surname>Smith</surname><given-names>WK</given-names></name></person-group><article-title>Estimating near-infrared leaf reflectance from leaf structural characteristics</article-title><source>Am. J. Bot</source><year>2001</year><volume>88</volume><fpage>278</fpage><lpage>284</lpage><pub-id pub-id-type="pmid">11222250</pub-id></citation></ref><ref id="b27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Turrell</surname><given-names>FM</given-names></name></person-group><article-title>The area of the internal exposed surface of dicotyledon leaves</article-title><source>Am. J. Bot</source><year>1936</year><volume>4</volume><fpage>255</fpage><lpage>264</lpage></citation></ref><ref id="b28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ustin</surname><given-names>SL</given-names></name><name><surname>Jacquemoud</surname><given-names>S</given-names></name><name><surname>Govaerts</surname><given-names>Y</given-names></name></person-group><article-title>Simulation of photon transport in a three-dimensional leaf: Implications for photosynthesis</article-title><source>Plant Cell Environ</source><year>2001</year><volume>24</volume><fpage>1095</fpage><lpage>1103</lpage></citation></ref><ref id="b29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Uwins</surname><given-names>PJR</given-names></name><name><surname>Murray</surname><given-names>M</given-names></name><name><surname>Gould</surname><given-names>RJ</given-names></name></person-group><article-title>Effects of four different processing techniques on the microstructure of potatoes: comparison with fresh samples in the ESEM</article-title><source>Microsc. Res. Techn</source><year>1993</year><volume>25</volume><fpage>412</fpage><lpage>418</lpage></citation></ref><ref id="b30"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Weibel</surname><given-names>ER</given-names></name></person-group><article-title>Stereological methods</article-title><source>Practical Methods for Biological Morphometry</source><year>1979</year><volume>1</volume><publisher-loc>London</publisher-loc><publisher-name>Academic Press</publisher-name></citation></ref></ref-list></back></article>