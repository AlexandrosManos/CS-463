me>Aso</surname><given-names>T</given-names></name><name><surname>Chen</surname><given-names>DY</given-names></name><name><surname>Garrett</surname><given-names>KP</given-names></name><name><surname>Conaway</surname><given-names>RC</given-names></name><name><surname>Conaway</surname><given-names>JW</given-names></name><name><surname>Linehan</surname><given-names>WM</given-names></name><name><surname>Klausner</surname><given-names>RD</given-names></name></person-group><source>Science</source><year>1995</year><volume>269</volume><fpage>1402</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">7660122</pub-id></citation></ref><ref id="R12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Elvert</surname><given-names>G</given-names></name><name><surname>Kappel</surname><given-names>A</given-names></name><name><surname>Heidenreich</surname><given-names>R</given-names></name><name><surname>Englmeier</surname><given-names>U</given-names></name><name><surname>Lanz</surname><given-names>S</given-names></name><name><surname>Acker</surname><given-names>T</given-names></name><name><surname>Rauter</surname><given-names>M</given-names></name><name><surname>Plate</surname><given-names>K</given-names></name><name><surname>Sieweke</surname><given-names>M</given-names></name><name><surname>Breier</surname><given-names>G</given-names></name><name><surname>Flamme</surname><given-names>I</given-names></name></person-group><source>J Biol Chem</source><year>2003</year><volume>278</volume><fpage>7520</fpage><lpage>30</lpage><pub-id pub-id-type="pmid">12464608</pub-id></citation></ref><ref id="R13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Epstein</surname><given-names>AC</given-names></name><name><surname>Gleadle</surname><given-names>JM</given-names></name><name><surname>McNeill</surname><given-names>LA</given-names></name><name><surname>Hewitson</surname><given-names>KS</given-names></name><name><surnam