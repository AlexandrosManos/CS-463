gn="char" char=".">&#x000a0;</td><td style="border:none;">1 + 0(<italic>C</italic><sub><italic>s</italic></sub>)</td><td style="border:none;" align="char" char=".">&#x02212;11.34</td><td style="border:none;" align="left">(&#x02212;0.8)</td><td style="border:none;" align="char" char=".">&#x02212;10.99</td><td style="border:none;" align="left">(&#x02212;0.5)</td><td style="border:none;" align="char" char=".">&#x02212;10.62</td><td style="border:none;" align="left">(&#x02212;0.1)</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="left">&#x000a0;</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="left">&#x000a0;</td><td style="border:none;">&#x02212;10.5<sup><xref ref-type="bibr" rid="ref178">178</xref>,<xref ref-type="bibr" rid="ref181">181</xref></sup></td></tr><tr><td style="border:none;">&#x000a0;</td><td style="border:none;" align="char" char=".">2</td><td style="border:none;">2 + 0(<italic>C</italic><sub>2<italic>h</italic></sub>)</td><td style="border:none;" align="char" char=".">&#x02212;22.27</td><td style="border:none;" align="left">(&#x02212;2.2)</td><td style="border:none;" align="char" char=".">&#x02212;21.59</td><td style="border:none;" align="left">(&#x02212;1.5)</td><td style="border:none;" align="char" char=".">&#x02212;20.87</td><td style="border:none;" align="left">(&#x02212;0.8)</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="left">&#x000a0;</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="left">&#x000a0;</td><td style="border:none;">&#x02212;20.1(<xref ref-type="bibr" rid="ref178">178</xref>)</td></tr><tr><td style="border:none;">&#x000a0;</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;">2 + 0(<italic>C</italic><sub>1</sub>)</td><td style="border:none;" align="char" char=".">&#x02212;23.61</td><td style="border:none;" align