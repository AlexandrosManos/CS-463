></sub>)</td><td style="border:none;" align="char" char=".">2.68</td><td style="border:none;" align="char" char=".">2.82</td><td style="border:none;" align="char" char=".">2.74</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="char" char=".">2.61(<xref ref-type="bibr" rid="ref178">178</xref>)</td></tr><tr><td style="border:none;">Cl<sup>-</sup></td><td style="border:none;">1 + 0(<italic>C</italic><sub><italic>s</italic></sub>)</td><td style="border:none;" align="char" char=".">3.09</td><td style="border:none;" align="char" char=".">3.26</td><td style="border:none;" align="char" char=".">3.21</td><td style="border:none;" align="char" char=".">3.08</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="char" char=".">3.12<sup><xref ref-type="bibr" rid="ref178">178</xref>,<xref ref-type="bibr" rid="ref180">180</xref></sup></td></tr><tr><td style="border:none;">&#x000a0;</td><td style="border:none;">1 + 0(<italic>C</italic><sub>2<italic>v</italic></sub>)</td><td style="border:none;" align="char" char=".">3.15</td><td style="border:none;" align="char" char=".">3.30</td><td style="border:none;" align="char" char=".">3.26</td><td style="border:none;" align="char" char=".">3.14</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="char" char=".">3.20(<xref ref-type="bibr" rid="ref178">178</xref>)</td></tr><tr><td style="border:none;">Br<sup>-</sup></td><td style="border:none;">1 + 0(<italic>C</italic><sub><italic>s</italic></sub>)</td><td style="border:none;" align="char" char=".">3.26</td><td style="border:none;" align="char" char=".">3.38</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="char" char=".">3.32(<xref ref-type="bibr" rid="ref178">178</xref>)</td></tr><tr><td style="border:none;">&#x000a0;</td><td style="border:none;">1 + 0(<italic>C</italic><sub>2<italic>v</italic></sub>)</td><td style="border:none;" align="char" char=".">3.30</td><td style="border:none;" align="char" char=".">3.42</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="char" char=".">3.35(<xref ref-type="bibr" rid="ref178">178</xref>)</td></tr><tr><td style="border:none;">I<sup>-</sup></td><td style="border:none;">1 + 0(<italic>C</italic><sub><italic>s</italic></sub>)</td><td style="border:none;" align="char" char=".">3.48</td><td style="border:none;" align="char" char=".">3.64</td><td style="border:none;" align="char" char=".">3.62</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="char" char=".">3.61<sup><xref ref-type="bibr" rid="ref178">178</xref>,<xref ref-type="bibr" rid="ref181">181</xref></sup></td></tr><tr><td style="border:none;">&#x000a0;</td><td style="border:none;">1 + 0(<italic>C</italic><sub>2<italic>v</italic></sub>)</td><td style="border:none;" align="char" char=".">3.51</td><td style="border:none;" align="char" char=".">3.65</td><td style="border:none;" align="char" char=".">3.64</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="char" char=".">3.61<sup><xref ref-type="bibr" rid="ref178">178</xref>,<xref ref-type="bibr" rid="ref181">181</xref></sup></td></tr><tr><td style="border:none;">rms</td><td style="border:none;">&#x000a0;</td><td style="border:none;" align="char" char=".">0.06</td><td style="border:none;" align="char" char=".">0.14</td><td style="border:none;" align="char" char=".">0.08</td><td style="border:none;" align="char" char=".">0.03</td><td style="border:none;" align="char" char=".">0.06</td><td style="border:none;" align="char" char=".">&#x000a0;</td></tr></tbody></table><table-wrap-foot><fn id="tbl6-fn1"><label>a</label><p>Shown are the single water oxygen&#x02212;ion distances for various geometries (as shown in Figures <xref rid="fig1" ref-type="fig">1</xref> and <xref rid="fig2" ref-type="fig">2</xref>) for distinct ion parameter sets with TIP3P water. The reference values are averages of one or more ab initio calculations. The distances have units of &#x000c5;. The levels of QM theory applied for each reference cited are as follows: ref (<xref ref-type="bibr" rid="ref172">172</xref>), HF/6&#x02212;31++G(d,p); ref (<xref ref-type="bibr" rid="ref173">173</xref>), MP2/aug-cc-pVDZ; ref (<xref ref-type="bibr" rid="ref174">174</xref>), HF/TZ2P; ref (<xref ref-type="bibr" rid="ref175">175</xref>), MP2/TZ2P; ref (<xref ref-type="bibr" rid="ref176">176</xref>), MP2/aVDZ; ref (<xref ref-type="bibr" rid="ref177">177</xref>),;MP2/aVTZ ref (<xref ref-type="bibr" rid="ref178">178</xref>), MP2/6&#x02212;311++G**; ref (<xref ref-type="bibr" rid="ref179">179</xref>), MP2/aug-cc-pVDZ; ref (<xref ref-type="bibr" rid="ref180">180</xref>), MP2/aug-cc-pVDZ; ref (<xref ref-type="bibr" rid="ref181">181</xref>), MP2/aug-cc-pVDZ+diff</p></fn></table-wrap-foot></table-wrap><table-wrap id="tbl7" position="float"><label>Table 7</label><caption><title>Comparison of the TIP4P<sub>EW</sub> Single Water&#x02212;Ion Binding Distances for Various Ion Parameter Sets<xref rid="tbl7-fn1" ref-type="table-fn">a</xref></title></caption><table frame="hsides" rules="groups" border="1"><colgroup><col/><col/><col align="char" char="."/><col align="char" char="."/><col align="char" char="."/><col align="char" char="."/><col align="char" char="."/><col align="char" char="."/></colgroup><thead valign="middle"><tr><th style="border:none;" align="center">&#x000a0;</th><th style="border:none;" align="center" valign="bottom">structures</th><th style="border:none;" align="center" valign="bottom" char=".">thisresearch</th><th style="border:none;" align="center" valign="bottom" char=".">Jensen andJorgensen</th><th style="border:none;" align="center" valign="bottom" char=".">Smith&#x02212;Dang&#x02212;Garrett</th><th style="border:none;" align="center" valign="bottom" char=".">Beglovand Roux</th><th style="border:none;" align="center" valign="bottom" char=".">&#x000c5;qvist</th><th style="border:none;" align="center" valign="bottom" char=".">reference<bold/>values</th></tr></thead><tbody><tr><td style="border:none;">Li<sup>+</sup></td><td style="border:none;">1 + 0(<italic>C</italic><sub>2<italic>v</italic></sub>)</td><td style="border:none;" align="char" char=".">1.86</td><td style="border:none;" align="char" char=".">1.98</td><td style="border:none;" align="char" char=".">1.93</td><td style="border:none;" align="char" char=".">&#x000a0;</td><td style="border:none;" align="char" char=".">1.97</td><td style="border:none;" align="char" char=".">1.86<sup><xref ref-type="bibr" rid="ref172">172</xref>,<xref ref-type="bibr" rid="ref173">173</xref></sup></td></tr><tr><td style="border:none;">Na<sup>+</sup></td><td style="border:none;">1 + 0(<italic>C</italic><sub>2<italic>v</italic></sub>)</td><td style="border:none;" align="char" char=".">2.25</td><td style="border:none;" align="char" char=".">2.43</td><td style="border:none;" align="char" char=".">2.31</td><td style="border:none;" align="char" char=".">2.24</td><td style="border:none;" align="char" char=".">2.34</td><td style="border:none;" align="char" char=".">2.23(<xref ref-type="bibr" rid="ref174">174</xref>)</td></tr><tr><td style="border:none;">K<sup>+</sup></td><td style="border:none;">1 + 0(<italic>C</italic><sub>2<italic>v</italic></sub>)</td><td style="border:none;" align="char" char=".">2.63</td><td style="border:none;" align="char" char=".">2.79</td><td style="border:none;" align="char" char=".">2.76</td><td