/name><name><surname>Heo</surname><given-names>WD</given-names></name><etal/></person-group><article-title>STIM is a Ca2+ sensor essential for Ca2+-store-depletion-triggered Ca2+ influx</article-title><source>Curr Biol</source><year>2005</year><volume>15</volume><fpage>1235</fpage><lpage>41</lpage><pub-id pub-id-type="pmid">16005298</pub-id></element-citation></ref><ref id="b7"><label>7</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Zhang</surname><given-names>SL</given-names></name><name><surname>Yu</surname><given-names>Y</given-names></name><name><surname>Roos</surname><given-names>J</given-names></name><etal/></person-group><article-title>STIM1 is a Ca2+ sensor that activates CRAC channels and migrates from the Ca2+ store to the plasma membrane</article-title><source>Nature</source><year>2005</year><volume>437</volume><fpage>902</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">16208375</pub-id></element-citation></ref><ref id="b8"><label>8</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Mercer</surname><given-names>JC</given-names></name><name><surname>Dehaven</surname><given-names>WI</given-names></name><name><surname>Smyth</surname><given-names>JT</given-names></name><etal/></person-group><article-title>Large store-operated calcium-selective currents due to co-expression of Orai1 or Orai2 with the intracellular calcium sensor, Stim1</article-title><source>J Biol Chem</source><year>2006</year><volume>281</volume><fpage>24979</fpage><lpage>90</lpage><pub-id pub-id-type="pmid">16807233</pub-id></element-citation></ref><ref id="b9"><label>9</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Yeromin</surname><given-names>AV</given-names></name><name><surname>Zhang</surname><given-names>SL</given-names></name><name><surname>Jiang</surname><given-names>W</given-names></name><etal/></person-group><article-title>Molecular identification of the CRAC channel by altered ion selectivity in a mutant of Orai</article-title><source>Nature</source><year>2006</year><volume>443</volume><fpage>226</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">16921385</pub-id></element-citation></ref><ref id="b10"><label>10</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Luik</surname><given-names>RM</given-names></name><name><surname>Wu</surname><given-names>MM</given-names></name><name><surname>Buchanan</surname><given-names>J</given-names></name><etal/></person-group><article-title>The elementary unit of store-operated Ca2+ entry: local activation of CRAC channels by STIM1 at ER-plasma membrane junctions</article-title><source>J Cell Biol</source><year>2006</year><volume>174</volume><fpage>815</fpage><lpage>25</lpage><pub-id pub-id-type="pmid">16966423</pub-id></element-citation></ref><ref id="b11"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Prakriya</surname><given-names>M</given-names></name><name><surname>Feske</surname><given-names>S</given-names></name><name><surname>Gwack</surname><given-names>Y</given-names></name><etal/></person-group><article-title>Orai1 is an essential pore subunit of the CRAC channel</article-title><source>Nature</source><year>2006</year><volume>443</volume><fpage>230</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">16921383</pub-id></element-citation></ref><ref id="b12"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Vig</surname><given-names>M</given-names></name><name><surname>Beck</surname><given-names>A</given-names></name><name><surname>Billingsley</surname><given-names>JM</given-names></name><etal/></person-group><article-title>CRACM1 multimers form the ion-selective pore of the CRAC channel</article-title><source>Curr Biol</source><year>2