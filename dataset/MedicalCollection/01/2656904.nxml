me>Cristofanilli</surname><given-names>M</given-names></name></person-group><article-title>Prognostic value of body mass index in locally advanced breast cancer</article-title><source>Clin Cancer Res</source><year>2008</year><volume>14</volume><fpage>1718</fpage><lpage>1725</lpage><pub-id pub-id-type="pmid">18347172</pub-id><pub-id pub-id-type="doi">10.1158/1078-0432.CCR-07-1479</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hede</surname><given-names>K</given-names></name></person-group><article-title>Fat may fuel breast cancer growth</article-title><source>J Natl Cancer Inst</source><year>2008</year><volume>100</volume><fpage>298</fpage><lpage>299</lpage><pub-id pub-id-type="pmid">18314468</pub-id><pub-id pub-id-type="doi">10.1093/jnci/djn050</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sellahewa</surname><given-names>C</given-names></name><name><surname>Nightingale</surname><given-names>P</given-names></name><name><surname>Carmichael</surname><given-names>AR</given-names></name></person-group><article-title>Obesity and HER 2 overexpression: a common factor for poor prognosis of breast cancer</article-title><source>Int Semin Surg Oncol</source><year>2008</year><volume>5</volume><fpage>2</fpage><pub-id pub-id-type="pmid">18294401</pub-id><pub-id pub-id-type="doi">10.1186/1477-7800-5-2</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barnett</surname><given-names>GC</given-names></name><name><surname>Shah</surname><given-names>M</given-names></name><name><surname>Redman</surname><given-names>K</given-names></name><name><surname>Easton</surname><given-names>DF</given-names></name><name><surname>Ponder</surname><given-names>BA</given-names></name><name><surname>Pharoah</surname><given-names>PD</given-names></name></person-group><