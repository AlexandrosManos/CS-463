tation-type="journal"><person-group person-group-type="author"><name><surname>Mohle-Boetani</surname><given-names>JC</given-names></name><name><surname>Grosser</surname><given-names>S</given-names></name><name><surname>Whittemore</surname><given-names>AS</given-names></name><name><surname>Malec</surname><given-names>M</given-names></name><name><surname>Kampert</surname><given-names>JB</given-names></name><name><surname>Paffenbarger</surname><given-names>RS</given-names><suffix>Jr</suffix></name></person-group><article-title>Body size, reproductive factors, and breast cancer survival</article-title><source>Prev Med</source><year>1988</year><volume>17</volume><fpage>634</fpage><lpage>642</lpage><pub-id pub-id-type="pmid">3237661</pub-id><pub-id pub-id-type="doi">10.1016/0091-7435(88)90056-4</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Oestreicher</surname><given-names>N</given-names></name><name><surname>White</surname><given-names>E</given-names></name><name><surname>Malone</surname><given-names>KE</given-names></name><name><surname>Porter</surname><given-names>PL</given-names></name></person-group><article-title>Hormonal factors and breast tumor proliferation: do factors that affect cancer risk also affect tumor growth?</article-title><source>Breast Cancer Res Treat</source><year>2004</year><volume>85</volume><fpage>133</fpage><lpage>142</lpage><pub-id pub-id-type="pmid">15111771</pub-id><pub-id pub-id-type="doi">10.1023/B:BREA.0000025402.70958.3e</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Schouten</surname><given-names>LJ</given-names></name><name><surname>Hupperets</surname><given-names>PS</given-names></name><name><surname>Jager</surname><given-names>JJ</given-names></name><name><surname>Volovics</surname><given-names>L</given-names></name><name><surname>Wils</surname><given-names>JA</given-names