n-names></name><article-title>Online focus groups: Electronic discussions for research</article-title><source>Forum Qualitative Sozialforschung/Forum: Qualitative Social Research</source><year>2000</year><volume>1</volume><ext-link ext-link-type="uri" xlink:href="http://www.qualitative-research.net/fqs-texte/1-00/1-00rezabek-e.htm">http://www.qualitative-research.net/fqs-texte/1-00/1-00rezabek-e.htm</ext-link><comment>(Date of access: August 9, 2005)</comment></mixed-citation></ref><ref id="B12"><mixed-citation publication-type="journal"><name><surname>Birnbaum</surname><given-names>MH</given-names></name><article-title>Human research and data collection via the internet</article-title><source>Annu Rev Psychol</source><year>2004</year><volume>55</volume><fpage>803</fpage><lpage>832</lpage><pub-id pub-id-type="doi">10.1146/annurev.psych.55.090902.141601</pub-id><pub-id pub-id-type="pmid">14744235</pub-id></mixed-citation></ref><ref id="B13"><mixed-citation publication-type="journal"><name><surname>Koch</surname><given-names>NS</given-names></name><name><surname>Emrey</surname><given-names>JA</given-names></name><article-title>The Internet and opinion measurement: surveying marginalized populations</article-title><source>Social Science Quarterly</source><year>2001</year><volume>82</volume><fpage>131</fpage><lpage>138</lpage><pub-id pub-id-type="doi">10.1111/0038-4941.00012</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Fox</surname><given-names>FE</given-names></name><name><surname>Morris</surname><given-names>M</given-names></name><name><surname>Rumsey</surname><given-names>N</given-names></name><article-title>Doing synchronous online focus groups with young people: methodological reflections</article-title><source>Qual Health Res</source><year>2007</year><volume>17</volume><fpage>539</fpage><lpage>547</lpage><pub-id pub-id-type="doi">10.1177/1049732306298754</pub-id><pub-id pub-id-type="pmid">17416707</pub-id></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="journal"><name><surname>Campbell</surname><given-names>MK</given-names></name><name><surname>Meier</surname><given-names>A</given-names></name><name><surname>Carr</surname><given-names>C</given-names></name><name><surname>Enga</surname><given-names>Z</given-names></name><name><surname>James</surname><given-names>AS</given-names></name><name><surname>Reedy</surname><given-names>J</given-names></name><article-title>Health behavior changes after colon cancer: a comparison of findings from face-to-face and on-line focus groups</article-title><source>Fam Community Health</source><year>2001</year><volume>24</volume><fpage>88</fpage><lpage>103</lpage><pub-id pub-id-type="pmid">11563947</pub-id></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="journal"><name><surname>Suzuki</surname><given-names>LK</given-names></name><name><surname>Calzo</surname><given-names>JP</given-names></name><article-title>The search for peer advice in cyberspace: An examination of online teen bulletin boards about health and sexuality</article-title><source>Applied Developmental Psychology</source><year>2004</year><volume>25</volume><fpage>685</fpage><lpage>698</lpage><pub-id pub-id-type="doi">10.1016/j.appdev.2004.09.002</pub-id></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="journal"><name><surname>Wouden</surname><given-names>JC van der</given-names></name><name><surname>Blankenstein</surname><given-names>AH</given-names></name><name><surname>Huibers</surname><given-names>MJ</given-names></name><name><surname>Windt</surname><given-names>DA van der</given-names></name><name><surname>Stalman</surname><given-names>WA</given-names></name><name><surname>Verhagen</surname><given-names>AP</given-names></name><article-title>Survey among 78 studies showed that Lasagna's law holds in Dutch primary care research</article-title><source>J Clin Epidemiol</source><year>2007</year><volume>60</volume><fpage>819</fpage><lpage>824</lpage><pub-id pub-id-type="doi">10.1016/j.jclinepi.2006.11.010</pub-id><pub-id pub-id-type="pmid">17606178</pub-id></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="journal"><name><surname>Powell</surname><given-names>RA</given-names></name><name><surname>Single</surname><given-names>HM</given-names></name><article-title>Focus groups</article-title><source>Int J Qual Health Care</source><year>1996</year><volume>8</volume><fpage>499</fpage><lpage>504</lpage><pub-id pub-id-type="pmid">9117204</pub-id></mixed-citation></ref><ref id="B19"><mixed-citation publication-type="journal"><name><surname>Kitzinger</surname><given-names>J</given-names></name><article-title>Qualitative research. Introducing focus groups</article-title><source>BMJ</source><year>1995</year><volume>311</volume><fpage>299</fpage><lpage>302</lpage><pub-id pub-id-type="pmid">7633241</pub-id></mixed-citation></ref><ref id="B20"><mixed-citation publication-type="book"><name><surname>Morgan</surname><given-names>DL</given-names></name><name><surname>Krueger</surname><given-names>RA</given-names></name><source>The focus group kit (1): the focus group guide book</source><year>1998</year><publisher-name>Thousand Oaks: Sage</publisher-name></mixed-citation></ref><ref id="B21"><mixed-citation publication-type="journal"><name><surname>Elwyn</surname><given-names>G</given-names></name><name><surname>Edwards</surname><given-names>A</given-names></name><name><surname>Gwyn</surname><given-names>R</given-names></name><name><surname>Grol</surname><given-names>R</given-names></name><article-title>Towards a feasible model for shared decision making: focus group study with general practice registrars</article-title><source>BMJ</source><year>1999</year><volume>319</volume><fpage>753</fpage><lpage>756</lpage><pub-id pub-id-type="pmid">10488002</pub-id></mixed-citation></ref><ref id="B22"><mixed-citation publication-type="journal"><name><surname>Naik</surname><given-names>