rname><given-names>PE</given-names></name><name><surname>Thiem</surname><given-names>VD</given-names></name><name><surname>Rheingans</surname><given-names>R</given-names></name><name><surname>Tho le</surname><given-names>H</given-names></name><name><surname>Glass</surname><given-names>RI</given-names></name><name><surname>Bresee</surname><given-names>JS</given-names></name></person-group><article-title>Health care costs of diarrheal disease and estimates of the cost-effectiveness of rotavirus vaccination in Vietnam</article-title><source>J Infect Dis</source><year>2005</year><volume>192</volume><fpage>1720</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">16235169</pub-id><pub-id pub-id-type="doi">10.1086/497339</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Podewils</surname><given-names>LJ</given-names></name><name><surname>Antil</surname><given-names>L</given-names></name><name><surname>Hummelman</surname><given-names>E</given-names></name><name><surname>Bresee</surname><given-names>J</given-names></name><name><surname>Parashar</surname><given-names>UD</given-names></name><name><surname>Rheingans</surname><given-names>R</given-names></name></person-group><article-title>Projected cost-effectiveness of rotavirus vaccination for children in Asia</article-title><source>J Infect Dis</source><year>2005</year><volume>192</volume><fpage>S133</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">16088797</pub-id><pub-id pub-id-type="doi">10.1086/431513</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Isakbaeva</surname><given-names>ET</given-names></name><etal></etal></person-group><article-title>Rotavirus disease in Uzbekistan: Cost-effectiveness of a new vaccine</article-title><source>Vaccine</source><year>2007</year><volume>25</volume><fpage>373</fpage><lpage>380</lpage><pub-id pub-id-type="pmid">16930784</pub-id