>&#x02014;</td><td align="center" rowspan="1" colspan="1">5</td></tr><tr><td rowspan="1" colspan="1">Ca<sub>V</sub>1.2 HotA, &#x003b2;<sub>2a</sub></td><td align="center" rowspan="1" colspan="1">8.9 &#x000b1; 4.1</td><td align="center" rowspan="1" colspan="1">ND</td><td align="center" rowspan="1" colspan="1">23.6 &#x000b1; 7.2</td><td align="center" rowspan="1" colspan="1">601 &#x000b1; 211</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">5</td></tr><tr><td rowspan="1" colspan="1">Ca<sub>V</sub>1.2 GGG, &#x003b2;<sub>2a</sub></td><td align="center" rowspan="1" colspan="1">13.2 &#x000b1; 2.5</td><td align="center" rowspan="1" colspan="1">ND</td><td align="center" rowspan="1" colspan="1">30.0 &#x000b1; 6.6</td><td align="center" rowspan="1" colspan="1">489 &#x000b1; 130</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">11</td></tr><tr><td rowspan="1" colspan="1">Ca<sub>V</sub>1.2 6G, &#x003b2;<sub>2a</sub></td><td align="center" rowspan="1" colspan="1">13.0 &#x000b1; 5.6</td><td align="center" rowspan="1" colspan="1">ND</td><td align="center" rowspan="1" colspan="1">34.2 &#x000b1; 3.4</td><td align="center" rowspan="1" colspan="1">485 &#x000b1; 155</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">6</td></tr><tr><td rowspan="1" colspan="1">Ca<sub>V</sub>1.2 GGG/HotA, &#x003b2;<sub>2a</sub></td><td align="center" rowspan="1" colspan="1">8.9 &#x000b1; 5.6</td><td align="center" rowspan="1" colspan="1">ND</td><td align="center" rowspan="1" colspan="1">21.7 &#x000b1; 7.6</td><td align="center" rowspan="1" colspan="1">607 &#x000b1; 277</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">7</td></tr><tr><td rowspan="1" colspan="1">Ca<sub>V</sub>1.2 GGG</td><td align="center" rowspan="1" colspan="1">28.1 &#x000b1; 3.6</td><td align="center" rowspan="1" colspan="1">ND</td><td align="center" rowspan="1" colspan="1">41.9 &#x000b1; 3.8</td><td align="center" rowspan="1" colspan="1">255 &#x000b1; 20</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">7</td></tr><tr><td rowspan="1" colspan="1">Ca<sub>V</sub>1.2 GGG, &#x003b2;<sub>1</sub></td><td align="center" rowspan="1" colspan="1">59.6 &#x000b1; 4.3</td><td align="center" rowspan="1" colspan="1">ND</td><td align="center" rowspan="1" colspan="1">79.2 &#x000b1; 3.7</td><td align="center" rowspan="1" colspan="1">202 &#x000b1; 12</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">6</td></tr><tr><td rowspan="1" colspan="1">Ca<sub>V</sub>1.2 GGG, &#x003b2;<sub>2b</sub></td><td align="center" rowspan="1" colspan="1">42.8 &#x000b1; 3.2</td><td align="center" rowspan="1" colspan="1">ND</td><td align="center" rowspan="1" colspan="1">66.0 &#x000b1; 1.7</td><td align="center" rowspan="1" colspan="1">264 &#x000b1; 14</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">6</td></tr><tr><td rowspan="1" colspan="1">Ca<sub>V</sub>1.2 GGG, ss&#x003b2;<sub>2a</sub></td><td align="center" rowspan="1" colspan="1">47.7 &#x000b1; 2.8</td><td align="center" rowspan="1" colspan="1">ND</td><td align="center" rowspan="1" colspan="1">72.0 &#x000b1; 5.6</td><td align="center" rowspan="1" colspan="1">262 &#x000b1; 14</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">5</td></tr><tr><td rowspan="1" colspan="1">Ca<sub>V</sub>2.1, &#x003b2;<sub>2a</sub></td><td align="center" rowspan="1" colspan="1">6.5 &#x000b1; 1.2</td><td align="center" rowspan="1" colspan="1">ND</td><td align="center" rowspan="1" colspan="1">9.7 &#x000b1; 1.5</td><td align="center" rowspan="1" colspan="1">308 &#x000b1; 80</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">10</td></tr><tr><td rowspan="1" colspan="1">Ca<sub>V</sub>2.1 GGG, &#x003b2;<sub>2a</sub></td><td align="center" rowspan="1" colspan="1">36.9 &#x000b1; 4.1</td><td align="center" rowspan="1" colspan="1">ND</td><td align="center" rowspan="1" colspan="1">59.3 &#x000b1; 8.6</td><td align="center" rowspan="1" colspan="1">439 &#x000b1; 42</td><td align="center" rowspan="1" colspan="1">9.2 &#x000b1; 1.9</td><td align="center" rowspan="1" colspan="1">17.8 &#x000b1; 2.2</td><td align="center" rowspan="1" colspan="1">6</td></tr><tr><td rowspan="1" colspan="1">Ca<sub>V</sub>2.1 6G, &#x003b2;<sub>2a</sub></td><td align="center" rowspan="1" colspan="1">39.5 &#x000b1; 9.8</td><td align="center" rowspan="1" colspan="1">ND</td><td align="center" rowspan="1" colspan="1">45.3 &#x000b1; 8.0</td><td align="center" rowspan="1" colspan="1">326 &#x000b1; 31</td><td align="center" rowspan="1" colspan="1">14.5 &#x000b1; 4.1</td><td align="center" rowspan="1" colspan="1">13.0 &#x000b1; 2.3</td><td align="center" rowspan="1" colspan="1">7</td></tr><tr><td rowspan="1" colspan="1">Ca<sub>V</sub>2.1 AAA, &#x003b2;<sub>2a</sub></td><td align="center" rowspan="1" colspan="1">8.2 &#x000b1; 1.2</td><td align="center" rowspan="1" colspan="1">ND</td><td align="center" rowspan="1" colspan="1">11.9 &#x000b1; 1.6</td><td align="center" rowspan="1" colspan="1">283 &#x000b1; 53</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" rowspan="1" colspan="1">&#x02014;</td><td align="center" r