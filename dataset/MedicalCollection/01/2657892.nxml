me><surname>Pearce</surname><given-names>BR</given-names></name><name><surname>Rollin</surname><given-names>F</given-names></name><name><surname>Simon</surname><given-names>P</given-names></name><name><surname>Tama</surname><given-names>N</given-names></name><name><surname>Nie</surname><given-names>H</given-names></name><name><surname>Vandeputte</surname><given-names>S</given-names></name><name><surname>Lien</surname><given-names>S</given-names></name><name><surname>Longeri</surname><given-names>M</given-names></name><name><surname>Fredholm</surname><given-names>M</given-names></name><name><surname>Harvey</surname><given-names>RJ</given-names></name><name><surname>Georges</surname><given-names>M</given-names></name></person-group><article-title>Highly effective SNP-based association mapping and management of recessive defects in livestock</article-title><source>Nat Genet</source><year>2008</year><volume>40</volume><issue>4</issue><fpage>449</fpage><lpage>454</lpage><pub-id pub-id-type="pmid">18344998</pub-id></citation></ref><ref id="B8"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Myers</surname><given-names>RK</given-names></name><name><surname>McGavin</surname><given-names>MD</given-names></name></person-group><person-group person-group-type="editor"><name><surname>McGavin MD, Zachary JF</surname></name></person-group><article-title>Cellular and Tissue Responses to Injury: Lipofuscin-Ceroid</article-title><source>Pathologic Basis of Veterinary Disease</source><year>2007</year><edition>4</edition><publisher-name>St. Louis:Mosby Elsevier</publisher-name><fpage>52</fpage><lpage>53</lpage></citation></ref><ref id="B9"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Maxie</surname><given-names>MG</given-names></name><name><surname>Newman</surname><given-names>SJ</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Maxie MG</surname></name></person-gro