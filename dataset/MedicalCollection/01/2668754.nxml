d;</xref>&#x02013;<xref ref-type="bibr" rid="ppat.1000375-Morgan1">&#x0005b;82&#x0005d;</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">PSLT073</td><td align="left" rowspan="1" colspan="1">traM</td><td align="left" rowspan="1" colspan="1">conjugative transfer: mating signal</td><td align="left" rowspan="1" colspan="1">2.38</td><td align="left" rowspan="1" colspan="1">70&#x00025;</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">PSLT075</td><td align="left" rowspan="1" colspan="1">traJ</td><td align="left" rowspan="1" colspan="1">conjugative transfer: regulation</td><td align="left" rowspan="1" colspan="1">2.43</td><td align="left" rowspan="1" colspan="1">75&#x00025;</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">PSLT102</td><td align="left" rowspan="1" colspan="1">traS</td><td align="left" rowspan="1" colspan="1">conjugative transfer: surface exclusion</td><td align="left" rowspan="1" colspan="1">2.21</td><td align="left" rowspan="1" colspan="1">60&#x00025;</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">STM2087</td><td align="left" rowspan="1" colspan="1">rfbV</td><td align="left" rowspan="1" colspan="1">LPS side chain defect: abequosyltransferase</td><td align="left" rowspan="1" colspan="1">2.60</td><td align="left" rowspan="1" colspan="1">85&#x00025;</td><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="ppat.1000375-Lawley1">&#x0005b;80&#x0005d;</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">STM2088</td><td align="left" rowspan="1" colspan="1">rfbX</td><td align="left" rowspan="1" colspan="1">LPS side chain defect: putative O-antigen transferase</td><td align="left" rowspan="1" colspan="1">2.38</td><td align="left" rowspan="1" colspan="1">70&#x00025;</td><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="ppat.1000375-Lawley1">&#x0005b;80&#x0005d;</xref>,<xref re