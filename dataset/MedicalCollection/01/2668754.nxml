old>hypothetical protein</bold></td><td align="left" rowspan="1" colspan="1"><bold>1.80</bold></td><td align="left" rowspan="1" colspan="1"><bold>40&#x00025;</bold></td><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="ppat.1000375-Li1">&#x0005b;<bold>90</bold>&#x0005d;</xref></td></tr><tr><td align="left" rowspan="1" colspan="1">CT148</td><td align="left" rowspan="1" colspan="1">mhpA</td><td align="left" rowspan="1" colspan="1">Monooxygenase</td><td align="left" rowspan="1" colspan="1">1.41</td><td align="left" rowspan="1" colspan="1">25&#x00025;</td><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1"><bold>CT154</bold></td><td align="left" rowspan="1" colspan="1"><bold>-</bold></td><td align="left" rowspan="1" colspan="1"><bold>Phospholipase D Endonuclease</bold></td><td align="left" rowspan="1" colspan="1"><bold>2.10</bold></td><td align="left" rowspan="1" colspan="1"><bold>50&#x00025;</bold></td><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="ppat.1000375-Nelson1">&#x0005b;<bold>93</bold>&#x0005d;</xref></td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>CT155</bold></td><td align="left" rowspan="1" colspan="1"><bold>-</bold></td><td align="left" rowspan="1" colspan="1"><bold>Phospholipase D Endonuclease</bold></td><td align="left" rowspan="1" colspan="1"><bold>1.53</bold></td><td align="left" rowspan="1" colspan="1"><bold>30&#x00025;</bold></td><td align="left" rowspan="1" colspan="1"><xref ref-type="bibr" rid="ppat.1000375-Nelson1">&#x0005b;<bold>93</bold>&#x0005d;</xref></td></tr><tr><td align="left" rowspan="1" colspan="1"><bold>CT157</bold></td><td align="left" rowspan="1" colspan="1"><bold>-</bold></td><td align="left" rowspan="1" colspan="1"><bold>Phospholipase D Endonuclease</bold></td><td align="left" rowspan="1" colspan="1"><bold>2.42</bold></td><td align="left" rowspan="1" colspan="1"><bold>75&#x00025;</bold></td><td align="left" rowspan="1" colspan="1"><xref ref-ty