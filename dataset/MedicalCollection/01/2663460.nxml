n-names></name></person-group><year>2005</year><article-title>Renin, pro-renin and the putative (pro)renin receptor</article-title><source>Hypertension</source><volume>46</volume><fpage>1069</fpage><lpage>76</lpage><pub-id pub-id-type="pmid">16186442</pub-id></citation></ref><ref id="b13-vhrm-4-1205"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dellipizzi</surname><given-names>AM</given-names></name><name><surname>Hilchey</surname><given-names>SD</given-names></name><name><surname>Bell-Quilley</surname><given-names>CP</given-names></name></person-group><year>1994</year><article-title>Natriuretic action of angiotensin (1&#x02013;7)</article-title><source>Br J Pharmacol</source><volume>111</volume><fpage>1</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">8012686</pub-id></citation></ref><ref id="b14-vhrm-4-1205"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dieterle</surname><given-names>W</given-names></name><name><surname>Corynen</surname><given-names>S</given-names></name><name><surname>Mann</surname><given-names>J</given-names></name></person-group><year>2004</year><article-title>Effect of the oral renin inhibitor aliskiren on the pharmacokinetics and pharmacodynamics of a single dose of warfarin in health subjects</article-title><source>Br J Clin Pharmacol</source><volume>58</volume><fpage>433</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">15373937</pub-id></citation></ref><ref id="b15-vhrm-4-1205"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dieterich</surname><given-names>H</given-names></name><name><surname>Kemp</surname><given-names>C</given-names></name><name><surname>Vaidyanathan</surname><given-names>S</given-names></name><etal/></person-group><year>2006</year><article-title>Aliskiren, the first in a new class of orally effective renin inhibitors, has no clinically significant interactions with digoxin in healthy volunte