citation-type="journal"><person-group person-group-type="author"><name><surname>Costanzi</surname><given-names>S</given-names></name></person-group><year>2008</year><article-title>On the applicability of GPCR homology models to computer-aided drug discovery: a comparison between in silico and crystal structures of the beta2-adrenergic receptor.</article-title><source>J Med Chem</source><volume>51</volume><fpage>2907</fpage><lpage>2914</lpage><pub-id pub-id-type="pmid">18442228</pub-id></citation></ref><ref id="pone.0004681-Harris1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Harris</surname><given-names>CJ</given-names></name><name><surname>Stevens</surname><given-names>AP</given-names></name></person-group><year>2006</year><article-title>Chemogenomics: structuring the drug discovery process to gene families.</article-title><source>Drug Discovery Today</source><volume>11</volume><fpage>880</fpage><lpage>888</lpage><pub-id pub-id-type="pmid">16997137</pub-id></citation></ref><ref id="pone.0004681-Klabunde1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Klabunde</surname><given-names>T</given-names></name><name><surname>Hessler</surname><given-names>G</given-names></name></person-group><year>2002</year><article-title>Drug design strategies for targeting G-protein-coupled receptors.</article-title><source>Chembiochem</source><volume>3</volume><fpage>928</fpage><lpage>944</lpage><pub-id pub-id-type="pmid">12362358</pub-id></citation></ref><ref id="pone.0004681-Klabunde2"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Klabunde</surname><given-names>T</given-names></name><name><surname>Jager</surname><given-names>R</given-names></name></person-group><year>2006</year><article-title>Chemogenomics approaches to G-protein coupled receptor lead finding.</article-title><source>Ernst Schering Resea