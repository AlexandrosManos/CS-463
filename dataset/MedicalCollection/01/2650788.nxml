><person-group person-group-type="author"><name><surname>Oliveira</surname><given-names>L</given-names></name><name><surname>Paiva</surname><given-names>ACM</given-names></name><name><surname>Vriend</surname><given-names>G</given-names></name></person-group><year>2002</year><article-title>Correlated mutation analyses on very large sequence families.</article-title><source>ChemBioChem</source><volume>3</volume><fpage>1010</fpage><lpage>1017</lpage><pub-id pub-id-type="pmid">12362367</pub-id></citation></ref><ref id="pone.0004681-Ye1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ye</surname><given-names>K</given-names></name><name><surname>Lameijer</surname><given-names>EW</given-names></name><name><surname>Beukers</surname><given-names>MW</given-names></name><name><surname>IJzerman</surname><given-names>AP</given-names></name></person-group><year>2006</year><article-title>A two-entropies analysis to identify functional positions in the transmembrane region of class A G protein-coupled receptors.</article-title><source>Proteins: Structure, Function and Bioinformatics</source><volume>63</volume><fpage>1018</fpage><lpage>1030</lpage></citation></ref><ref id="pone.0004681-Costanzi2"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Costanzi</surname><given-names>S</given-names></name><name><surname>Mamedova</surname><given-names>L</given-names></name><name><surname>Gao</surname><given-names>ZG</given-names></name><name><surname>Jacobson</surname><given-names>KA</given-names></name></person-group><year>2004</year><article-title>Architecture of P2Y nucleotide receptors: Structural comparison based on sequence analysis, mutagenesis, and homology modeling.</article-title><source>J Med Chem</source><volume>47</volume><fpage>5393</fpage><lpage>5404</lpage><pub-id pub-id-type="pmid">15481977</pub-id></citation></ref><ref id="pone.0004681-Costanzi3"><label>21</l