</name><name><surname>Fingar</surname><given-names>DC</given-names></name><name><surname>Blenis</surname><given-names>J</given-names></name></person-group><article-title>Molecular interpretation of ERK signal duration by immediate early gene products</article-title><source>Nature Cell Biology</source><year>2002</year><volume>4</volume><fpage>556</fpage><lpage>564</lpage><pub-id pub-id-type="pmid">12134156</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Santos</surname><given-names>SDM</given-names></name><name><surname>Verveer</surname><given-names>PJ</given-names></name><name><surname>Bastiaens</surname><given-names>PIH</given-names></name></person-group><article-title>Growth factor-induced MAPK network topology shapes Erk response determining PC-12 cell fate</article-title><source>Nature Cell Biology</source><year>2007</year><volume>9</volume><fpage>324</fpage><lpage>U139</lpage><pub-id pub-id-type="pmid">17310240</pub-id><pub-id pub-id-type="doi">10.1038/ncb1543</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sasagawa</surname><given-names>S</given-names></name><name><surname>Ozaki</surname><given-names>Y</given-names></name><name><surname>Fujita</surname><given-names>K</given-names></name><name><surname>Kuroda</surname><given-names>S</given-names></name></person-group><article-title>Prediction and validation of the distinct dynamics of transient and sustained ERK activation</article-title><source>Nature Cell Biology</source><year>2005</year><volume>7</volume><fpage>365</fpage><lpage>U331</lpage><pub-id pub-id-type="pmid">15793571</pub-id><pub-id pub-id-type="doi">10.1038/ncb1233</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marshall</surname><given-names>CJ</given-names></name></person-group><article-title>Specificity of Receptor Tyrosine Kinase Signaling &#x02013; Transient Versus Sustained Extracellular Signal-Regulated Kinase Activation</article-title><source>Cell</source><year>1995</year><volume>80</volume><fpage>179</fpage><lpage>185</lpage><pub-id pub-id-type="pmid">7834738</pub-id><pub-id pub-id-type="doi">10.1016/0092-8674(95)90401-8</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Asthagiri</surname><given-names>AR</given-names></name><name><surname>Lauffenburger</surname><given-names>DA</given-names></name></person-group><article-title>A computational study of feedback effects on signal dynamics in a mitogen-activated protein kinase (MAPK) pathway model</article-title><source>Biotechnology Progress</source><year>2001</year><volume>17</volume><fpage>227</fpage><lpage>239</lpage><pub-id pub-id-type="pmid">11312698</pub-id><pub-id pub-id-type="doi">10.1021/bp010009k</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ferrell</surname><given-names>JE</given-names></name><name><surname>Machleder</surname><given-names>EM</given-names></name></person-group><article-title>The biochemical basis of an all-or-none cell fate switch in Xenopus oocytes</article-title><source>Science</source><year>1998</year><volume>280</volume><fpage>895</fpage><lpage>898</lpage><pub-id pub-id-type="pmid">9572732</pub-id><pub-id pub-id-type="doi">10.1126/science.280.5365.895</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Swain</surname><given-names>PS</given-names></name><name><surname>Siggia</surname><given-names>ED</given-names></name></person-group><article-title>The role of proofreading in signal transduction specificity</article-title><source>Biophysical Journal</source><year>2002</year><volume>82</volume><fpage>2928</fpage><lpage>2933</lpage><pub-id pub-id-type="pmid">12023215</pub-id><pub-id pub-id-type="doi">10.1016/S0006-3495(02)75633-6</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thattai</surname><given-names>M</given-names></name><name><surname>van Oudenaarden</surname><given-names>A</given-names></name></person-group><article-title>Attenuation of noise in ultrasensitive signaling cascades</article-title><source>Biophysical Journal</source><year>2002</year><volume>82</volume><fpage>2943</fpage><lpage>2950</lpage><pub-id pub-id-type="pmid">12023217</pub-id><pub-id pub-id-type="doi">10.1016/S0006-3495(02)75635-X</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chaves</surname><given-names>M</given-names></name><name><surname>Sontag</surname><given-names>EA</given-names></name><name><surname>Dinerstein</surname><given-names>RJ</given-names></name></person-group><article-title>Optimal length and signal amplification in weakly activated signal transduction cascades</article-title><source>Journal of Physical Chemistry B</source><year>2004</year><volume>108</volume><fpage>15311</fpage><lpage>15320</lpage><pub-id pub-id-type="doi">10.1021/jp048935f</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Heinrich</surname><given-names>R</given-names></name><name><surname>Neel</surname><given-names>BG</given-names></name><name><surname>Rapoport</surname><given-names>TA</given-names></name></person-group><article-title>Mathematical models of protein kinase signal transduction</article-title><source>Molecular Cell</source><year>2002</year><volume>9</volume><fpage>957</fpage><lpage>970</lpage><pub-id pub-id-type="pmid">12049733</pub-id><pub-id pub-id-type="doi">10.1016/S1097-2765(02)00528-2</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Locasale</surname><given-names>JW</given-names></name><name><surname>Shaw</surname><given-names>AS</given-names></name><name><surname>Chakraborty</surname><given-names>AK</given-names></name></person-group><article-title>Scaffold proteins confer diverse regulatory properties to protein kinase cascades</article-title><source>Proc Natl Acad Sci USA</source><year>2007</year><volume>104</volume><fpage>13307</fpage><lpage>13312</lpage><pub-id pub-id-type="pmid">17686969</pub-id><pub-id pub-id-type="doi">10.1073/pnas.0706311104</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Locasale</surname><given-names>JW</given-names></name><name><surname>Chakraborty</surname><given-names>AK</given-names></name></person-group><article-title>Regulation of signal duration and the statistical dynamics of kinase activation by scaffold proteins</article-title><source>Plos Computational Biology</source><year>2008</year><volume>4</volume><fpage>e1000099</fpage><pub-id pub-id-type="pmid">18584022</pub-id><pub-id pub-id-type="doi">10.1371/journal.pcbi.1000099</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Behar</surname><given-names>M</given-names></name><name><surname>Hao</surname><given-names>N</given-names></name><name><surname>Dohlman</surname><given-names>HG</given-names></name><name><surname>Elston</surname><given-names>TC</given-names></name></person-group><article-title>Mathematical and computational analysis of adaptation via feedback inhibition in signal transduction pathways</article-title><source>Biophysical Journal</source><year>2007</year><volume>93</volume><fpage>806</fpage><lpage>821</lpage><pub-id pub-id-type="pmid">17513354</pub-id><pub-id pub-id-type="doi">10.1529/biophysj.107.107516</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><nam