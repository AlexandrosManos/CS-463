pan="1" colspan="1">96.5</td></tr><tr><td align="left" rowspan="1" colspan="1">45&#x02013;54</td><td align="left" rowspan="1" colspan="1">47.4</td><td align="left" rowspan="1" colspan="1">67.9</td><td align="left" rowspan="1" colspan="1">89.4</td><td align="left" rowspan="1" colspan="1">89.8</td><td align="left" rowspan="1" colspan="1">90.3</td><td align="left" rowspan="1" colspan="1">91.0</td><td align="left" rowspan="1" colspan="1">98.5</td><td align="left" rowspan="1" colspan="1">97.2</td><td align="left" rowspan="1" colspan="1">98.2</td><td align="left" rowspan="1" colspan="1">96.8</td><td align="left" rowspan="1" colspan="1">97.7</td><td align="left" rowspan="1" colspan="1">97.9</td></tr><tr><td align="left" rowspan="1" colspan="1">55+</td><td align="left" rowspan="1" colspan="1">38.4</td><td align="left" rowspan="1" colspan="1">52.6</td><td align="left" rowspan="1" colspan="1">&#x02013;</td><td align="left" rowspan="1" colspan="1">&#x02013;</td><td align="left" rowspan="1" colspan="1">&#x02013;</td><td align="left" rowspan="1" colspan="1">&#x02013;</td><td align="left" rowspan="1" colspan="1">98.7</td><td align="left" rowspan="1" colspan="1">98.1</td><td align="left" rowspan="1" colspan="1">99.2</td><td align="left" rowspan="1" colspan="1">&#x02013;</td><td align="left" rowspan="1" colspan="1">&#x02013;</td><td align="left" rowspan="1" colspan="1">&#x02013;</td></tr><tr><td align="left" rowspan="1" colspan="1">N</td><td align="left" rowspan="1" colspan="1">1595</td><td align="left" rowspan="1" colspan="1">2448</td><td align="left" rowspan="1" colspan="1">4281</td><td align="left" rowspan="1" colspan="1">3362</td><td align="left" rowspan="1" colspan="1">6491</td><td align="left" rowspan="1" colspan="1">6245</td><td align="left" rowspan="1" colspan="1">6603</td><td align="left" rowspan="1" colspan="1">6346</td><td align="left" rowspan="1" colspan="1">7213</td><td align="left" rowspan="1" colspan="1">5113</td><td align="left" rowspan="1" colspan="1">4804</td><td 