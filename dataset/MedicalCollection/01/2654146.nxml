rson-group-type="author"><name><surname>Gregson</surname><given-names>S</given-names></name><name><surname>Zhuwau</surname><given-names>T</given-names></name><name><surname>Ndlovu</surname><given-names>J</given-names></name><etal/></person-group> <article-title>Methods to reduce social desirability bias in sex surveys in low-development settings: experience in Zimbabwe.</article-title><source>Sex Transm Dis</source><year>2002</year>;<volume>29</volume>:<fpage>568</fpage>&#x02013;<lpage>75</lpage><pub-id pub-id-type="pmid">12370523</pub-id></citation></ref><ref id="b13"><label>13</label><citation citation-type="journal"><collab>Africa Centre for Health and Population Studies</collab> <comment><ext-link ext-link-type="uri" xlink:href="www.africacentre.ac.za">www.africacentre.ac.za</ext-link> (accessed 19 Nov 2008)</comment></citation></ref><ref id="b14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tanser</surname><given-names>F</given-names></name><name><surname>Hosegood</surname><given-names>V</given-names></name><name><surname>Barnighausen</surname><given-names>T</given-names></name><etal/></person-group> <article-title>Cohort Profile: Africa Centre Demographic Information System (ACDIS) and population-based HIV survey.</article-title><source>Int J Epidemiol</source><year>2008</year>;<volume>37</volume>:<fpage>956</fpage>&#x02013;<lpage>62</lpage><pub-id pub-id-type="pmid">17998242</pub-id></citation></ref><ref id="b15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wawer</surname><given-names>MJ</given-names></name><name><surname>Gray</surname><given-names>RH</given-names></name><name><surname>Sewankambo</surname><given-names>NK</given-names></name><etal/></person-group> <article-title>A randomized, community trial of intensive sexually transmitted disease control for AIDS prevention, Rakai, Uganda.</article-title><source>AIDS</source><year>1998</year>;<volume>12</volume>:<fpage>1211</fpage>&#x02013;<lpage>25</lpage><pub-id pub-id-type="pmid">9677171</pub-id></citation></ref><ref id="b16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wawer</surname><given-names>MJ</given-names></name><name><surname>Sewankambo</surname><given-names>NK</given-names></name><name><surname>Serwadda</surname><given-names>D</given-names></name><etal/></person-group> <article-title>Control of sexually transmitted diseases for AIDS prevention in Uganda: a randomised community trial. Rakai Project Study Group.</article-title><source>Lancet</source><year>1999</year>;<volume>353</volume>:<fpage>525</fpage>&#x02013;<lpage>35</lpage><pub-id pub-id-type="pmid">10028980</pub-id></citation></ref><ref id="b17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kamali</surname><given-names>A</given-names></name><name><surname>Carpenter</surname><given-names>LM</given-names></name><name><surname>Whitworth</surname><given-names>JAG</given-names></name><etal/></person-group> <article-title>Seven-year trends in HIV-1 infection rates, and changes in sexual behaviour, among adults in rural Uganda.</article-title><source>AIDS</source><year>2000</year>;<volume>14</volume>:<fpage>427</fpage>&#x02013;<lpage>34</lpage><pub-id pub-id-type="pmid">10770546</pub-id></citation></ref><ref id="b18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Konde-Lule</surname><given-names>JK</given-names></name><name><surname>Wawer</surname><given-names>MJ</given-names></name><name><surname>Sewankambo</surname><given-names>NK</given-names></name><etal/></person-group> <article-title>Adolescents, sexual behaviour and HIV-1 in rural Rakai district, Uganda.</article-title><source>AIDS</source><year>1997</year>;<volume>11</volume>:<fpage>791</fpage>&#x02013;<lpage>9</lpage><pub-id pub-id-type="pmid">9143612</pub-id></citation></ref><ref id="b19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hosegood</surname><given-names>V</given-names></name><name><surname>McGrath</surname><given-names>N</given-names></name><name><surname>Moultrie</surname><given-names>T</given-names></name></person-group> <article-title>Dispensing with marriage: marital and partnership trends in rural KwaZulu-Natal, South Africa.</article-title><source>Demogr Res</source><comment>2009 (in press).</comment></citation></ref><ref id="b20"><label>20</label><citation citation-type="book"><collab>Central Statistical Office, Harare (Zimbabwe), Macro International</collab> <source>Zimbabwe Demographic and Health Survey 2005&#x02013;06</source> <publisher-loc>Maryland, USA</publisher-loc>: <publisher-name>Claverton</publisher-name>, <year>2007</year></citation></ref><ref id="b21"><label>21</label><citation citation-type="book"><collab>Ministry of Health, Kampala (Uganda), Macro International</collab> <source>Uganda HIV/AIDS sero-behavioural survey 2004&#x02013;2005</source> <publisher-loc>Maryland, USA</publisher-loc>: <publisher-name>Claverton</publisher-name>, <year>2006</year></citation></ref><ref id="b22"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Marston</surname><given-names>M</given-names></name><name><surname>Slaymaker</surname><given-names>E</given-names></name><name><surname>Cremin</surname><given-names>I</given-names></name><etal/></person-group> <article-title>Trends in marriage and time spent single in sub-Saharan Africa: a comparative analysis of six population-based cohort studies and nine Demographic and Health Surveys.</article-title><source>Sex Transm Infect</source><comment>2009;<bold>85</bold>(Suppl I)</comment>:<fpage>i64</fpage>&#x02013;<lpage>i71</lpage></citation></ref><ref id="b23"><label>23</label><citation citation-type="journal"><person-group person-gr