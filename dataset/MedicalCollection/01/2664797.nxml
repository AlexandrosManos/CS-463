d-type="doi">10.1016/S0301-0082(98)00052-5</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ryter</surname><given-names>SWOL</given-names></name><name><surname>Morse</surname><given-names>D</given-names></name><name><surname>Choi</surname><given-names>AM</given-names></name></person-group><article-title>Heme oxygenase/carbon monoxide signaling pathways: regulation and functional significance</article-title><source>Mol Cell Biochem</source><year>2002</year><volume>234&#x02013;235</volume><fpage>249</fpage><lpage>263</lpage><pub-id pub-id-type="doi">10.1023/A:1015957026924</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kaplovitz</surname><given-names>NOM</given-names></name></person-group><article-title>The regulation of hepatic glutathione</article-title><source>Annu Rev Toxicol</source><year>1985</year><volume>25</volume><fpage>715</fpage><lpage>719</lpage><pub-id pub-id-type="doi">10.1146/annurev.pa.25.040185.003435</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Dr&#x000f6;ge</surname><given-names>W</given-names></name></person-group><article-title>Aging-related changes in the thiol/disulfide redox state: implications for the use of thiol antioxidants</article-title><source>Exp Gerontol</source><year>2002</year><volume>37</volume><fpage>1333</fpage><lpage>1345</lpage><pub-id pub-id-type="pmid">12559403</pub-id><pub-id pub-id-type="doi">10.1016/S0531-5565(02)00175-4</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meister</surname><given-names>A</given-names></name><name><surname>Anderson</surname><given-names>ME</given-names></name></person-group><article-title>Glutathione</article-title><source>Annu Rev Biochem</source><year>1983</year><volume>52<