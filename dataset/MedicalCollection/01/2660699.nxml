">15158068</pub-id></citation></ref><ref id="R7"><label>7. </label><citation citation-type="journal"><string-name><surname>Chung</surname> <given-names>JY</given-names></string-name>, <string-name><surname>Han</surname> <given-names>TH</given-names></string-name>, <string-name><surname>Kim</surname> <given-names>CK</given-names></string-name>, <string-name><surname>Kim</surname> <given-names>SW</given-names></string-name> <article-title>Bocavirus infection in hospitalized children, South Korea.</article-title><source>Emerg Infect Dis</source> <year>2006</year>;<volume>12</volume>:<fpage>1254</fpage>&#x02013;<lpage>6</lpage><pub-id pub-id-type="pmid">16965708</pub-id></citation></ref><ref id="R8"><label>8. </label><citation citation-type="journal"><string-name><surname>Norja</surname> <given-names>P</given-names></string-name>, <string-name><surname>Ubillos</surname> <given-names>I</given-names></string-name>, <string-name><surname>Templeton</surname> <given-names>K</given-names></string-name>, <string-name><surname>Simmonds</surname> <given-names>P</given-names></string-name> <article-title>No evidence for an association between infections with WU and KI polyomaviruses and respiratory disease.</article-title><source>J Clin Virol</source> <year>2007</year>;<volume>40</volume>:<fpage>307</fpage>&#x02013;<lpage>11</lpage> <pub-id pub-id-type="doi">10.1016/j.jcv.2007.09.008</pub-id><pub-id pub-id-type="pmid">17997354</pub-id></citation></ref><ref id="R9"><label>9. </label><citation citation-type="journal"><string-name><surname>Abed</surname> <given-names>Y</given-names></string-name>, <string-name><surname>Wang</surname> <given-names>D</given-names></string-name>, <string-name><surname>Boivin</surname> <given-names>G</given-names></string-name> <article-title>WU polyomavirus in children, Canada.</article-title><source>Emerg Infect Dis</source> <year>2007</year>;<volume>13</volume>:<fpage>1939</fpage>&#x02013;<lpage>41</lpage><pub-id pub-id-type="pmid">18258053</pub-id><