e><name><surname>Papagno</surname><given-names>L</given-names></name><etal/></person-group><article-title>Memory CD8+ T cells vary in differentiation phenotype in different persistent virus infections</article-title><source>Nat Med</source><year>2002</year><volume>8</volume><fpage>379</fpage><lpage>85</lpage><pub-id pub-id-type="pmid">11927944</pub-id></citation></ref><ref id="b11-16-0109"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>EC</given-names></name><name><surname>Borysiewicz</surname><given-names>LK</given-names></name></person-group><article-title>The role of CD8+, CD57+ cells in human cytomegalovirus and other viral infections</article-title><source>Scand J Infect Dis</source><year>1995</year><issue>Suppl 99</issue><fpage>S69</fpage><lpage>77</lpage></citation></ref><ref id="b12-16-0109"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Morley</surname><given-names>JK</given-names></name><name><surname>Batliwalla</surname><given-names>FM</given-names></name><name><surname>Hingorani</surname><given-names>R</given-names></name><name><surname>Gregersen</surname><given-names>PK</given-names></name></person-group><article-title>Oligoclonal CD8+ T cells are preferentially expanded in the CD57+ subset</article-title><source>J Immunol</source><year>1995</year><volume>154</volume><fpage>6182</fpage><lpage>90</lpage><pub-id pub-id-type="pmid">7538544</pub-id></citation></ref><ref id="b13-16-0109"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lieberman</surname><given-names>J</given-names></name><name><surname>Trimble</surname><given-names>LA</given-names></name><name><surname>Friedman</surname><given-names>RS</given-names></name><name><surname>Lisziewicz</surname><given-names>J</given-names></name><name><surname>Lori</surname><given-names>F</given-names></name><n