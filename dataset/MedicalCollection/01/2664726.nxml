Clin Exp Immunol</source><year>1998</year><volume>111</volume><fpage>345</fpage><lpage>52</lpage><pub-id pub-id-type="pmid">9486402</pub-id></citation></ref><ref id="b16-16-0109"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Frassanito</surname><given-names>MA</given-names></name><name><surname>Silvestris</surname><given-names>F</given-names></name><name><surname>Cafforio</surname><given-names>P</given-names></name><name><surname>Dammacco</surname></name></person-group><article-title>F CD8+/CD57 cells and apoptosis suppress T-cell functions in multiple myeloma</article-title><source>Br J Haematol</source><year>1998</year><volume>100</volume><fpage>469</fpage><lpage>77</lpage><pub-id pub-id-type="pmid">9504628</pub-id></citation></ref><ref id="b17-16-0109"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sze</surname><given-names>DM</given-names></name><name><surname>Giesajtis</surname><given-names>G</given-names></name><name><surname>Brown</surname><given-names>RD</given-names></name><name><surname>Raitakari</surname><given-names>M</given-names></name><name><surname>Gibson</surname><given-names>J</given-names></name><name><surname>Ho</surname><given-names>J</given-names></name><etal/></person-group><article-title>Clonal cytotoxic T cells are expanded in myeloma and reside in the CD8(+)CD57(+)CD28(&#x02212;) compartment</article-title><source>Blood</source><year>2001</year><volume>98</volume><fpage>2817</fpage><lpage>27</lpage><pub-id pub-id-type="pmid">11675356</pub-id></citation></ref><ref id="b18-16-0109"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Merino</surname><given-names>J</given-names></name><name><surname>Martinez-Gonzalez</surname><given-names>MA</given-names></name><name><surname>Rubio</surname><given-names>M</given-names></name><name><surname>Inoges</surname><given-names>S</