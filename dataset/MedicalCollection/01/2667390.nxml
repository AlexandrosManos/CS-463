erson-group person-group-type="author"><name><surname>El-Hattab</surname><given-names>OH</given-names></name><name><surname>Nouh</surname><given-names>MA</given-names></name></person-group><article-title>Epidemiology of cancer</article-title><source>NCI</source><year>1998</year><publisher-name>El-Bolkainy, MN: Topographic pathology of cancer</publisher-name></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gold</surname><given-names>EL</given-names></name><name><surname>Goldi</surname><given-names>SB</given-names></name></person-group><article-title>Epidemiology of and risk factors for pancreatic cancer</article-title><source>Surg Oncol Clin N Am</source><year>1998</year><volume>7</volume><fpage>67</fpage><lpage>91</lpage><pub-id pub-id-type="pmid">9443987</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Smeenk</surname><given-names>HG</given-names></name><name><surname>de Castro</surname><given-names>SM</given-names></name><name><surname>Jeekel</surname><given-names>JJ</given-names></name><name><surname>Kazemier</surname><given-names>G</given-names></name><name><surname>Busch</surname><given-names>OR</given-names></name><name><surname>Incrocci</surname><given-names>L</given-names></name><name><surname>Erdmann</surname><given-names>J</given-names></name><name><surname>Hop</surname><given-names>WC</given-names></name><name><surname>Gouma</surname><given-names>DJ</given-names></name><name><surname>van Eijck</surname><given-names>CH</given-names></name></person-group><article-title>Locally advanced pancreatic cancer treated with radiation and 5-fluorouracil: A first step to neoadjuvant treatment?</article-title><source>Digestive Surgery</source><year>2005</year><volume>22</volume><fpage>191</fpage><lpage>197</lpage><pub-id pub-id-type="pmid">16137997</pub-id><pub-id pub-id-type="doi">10.1159/000087973</pub-id></citation></