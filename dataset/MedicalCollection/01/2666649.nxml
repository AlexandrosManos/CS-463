ents?</article-title><source>Lancet</source><year>2007</year><volume>369</volume><fpage>779</fpage><lpage>786</lpage><pub-id pub-id-type="pmid">17336655</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(07)60364-X</pub-id></citation></ref><ref id="B10"><citation citation-type="book"><person-group person-group-type="author"><collab>WHO</collab></person-group><source>The Health Metrics Network Framework</source><year>2008</year><edition>2</edition><ext-link ext-link-type="uri" xlink:href="http://www.who.int/healthmetrics/en/"/></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bullen</surname><given-names>N</given-names></name><name><surname>Moon</surname><given-names>G</given-names></name><name><surname>Jones</surname><given-names>K</given-names></name></person-group><article-title>Defining localities for health planning: a GIS approach</article-title><source>Soc Sci Med</source><year>1996</year><volume>42</volume><fpage>801</fpage><lpage>816</lpage><pub-id pub-id-type="pmid">8778994</pub-id><pub-id pub-id-type="doi">10.1016/0277-9536(95)00180-8</pub-id></citation></ref><ref id="B12"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gatrell</surname><given-names>AC</given-names></name><name><surname>Markku</surname><given-names>L</given-names></name></person-group><person-group person-group-type="editor"><name><surname>Anthony C, Gatrell, Markku, Loytonen</surname></name></person-group><source>GIS and health</source><year>1998</year><publisher-name>Taylor and Francis, London</publisher-name><fpage>3</fpage><lpage>16</lpage></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Hewitt</surname><given-names>A</given-names></name><name><surname>Tinline</surname><given-names>R</given-names></name></person-group><source>GIS and health care: spatial accessibility of cancer clinics in Hamilton, Ontario</