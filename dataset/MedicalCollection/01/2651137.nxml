volume>274</volume><fpage>700</fpage><lpage>705</lpage><pub-id pub-id-type="pmid">7650822</pub-id><pub-id pub-id-type="doi">10.1001/jama.274.9.700</pub-id></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Thomson O'Brien</surname><given-names>M</given-names></name><name><surname>Oxman</surname><given-names>A</given-names></name><name><surname>Davis</surname><given-names>D</given-names></name><name><surname>Haynes</surname><given-names>R</given-names></name><name><surname>Freemantle</surname><given-names>N</given-names></name><name><surname>Harvey</surname><given-names>E</given-names></name></person-group><source>Educational outreach visits: effects on professional practice and health care outcomes (Cochrane Review)</source><year>2003</year><publisher-name>The Cochrane Library, Issue 2, 2003 Oxford: Update Software</publisher-name></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hussey</surname><given-names>S</given-names></name><name><surname>Hoddinott</surname><given-names>P</given-names></name><name><surname>Wilson</surname><given-names>P</given-names></name><name><surname>Dowell</surname><given-names>J</given-names></name><name><surname>Barbour</surname><given-names>R</given-names></name></person-group><article-title>Sickness certification system in the United Kingdom: qualitative study of views of general practitioners in Scotland</article-title><source>BMJ</source><year>2004</year><volume>328</volume><fpage>88</fpage><pub-id pub-id-type="pmid">14691065</pub-id><pub-id pub-id-type="doi">10.1136/bmj.37949.656389.EE</pub-id></citation></ref><ref id="B22"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Fishbein</surname><given-names>M</given-names></name><name><surname>Ajzen</surname><given-names>I</given-names></name></person-group><source>Belief, attitude, intention and behaviour: an introduction to theory and research</source><year>1975</year><publisher-name>Reading, Mass: Addison-Wesley</publisher-name></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tellnes</surname><given-names>G</given-names></name><name><surname>Sandvik</surname><given-names>L</given-names></name><name><surname>Moum</surname><given-names>T</given-names></name></person-group><article-title>Inter-doctor variation in sickness certification</article-title><source>Scand J Prim Health Care</source><year>1990</year><volume>8</volume><fpage>45</fpage><lpage>52</lpage><pub-id pub-id-type="pmid">2141431</pub-id><pub-id pub-id-type="doi">10.3109/02813439008994928</pub-id></citation></ref><ref id="B24"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Sandberg</surname><given-names>J</given-names></name></person-group><article-title>Human competence at work &#x02013; an interpretative approach</article-title><source>PhD thesis</source><year>1994</year><publisher-name>G&#x000f6;teborgs universitet, Economic Sciences</publisher-name></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamberg</surname><given-names>K</given-names></name><name><surname>Johansson</surname><given-names>E</given-names></name><name><surname>Lindgren</surname><given-names>G</given-names></name><name><surname>Westman</surname><given-names>G</given-names></name></person-group><article-title>Scientific rigour in qualitative research &#x02013; examples from a study of women's health in family practice</article-title><source>Fam Pract</source><year>1994</year><volume>11</volume><fpage>176</fpage><lpage>181</lpage><pub-id pub-id-type="pmid">7958583</pub-id><pub-id pub-id-type="doi">10.1093/fampra/11.2.176</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sandberg</surname><given-names>J</given-names></name></person-group><article-title>Are phenomenographic results reliable?</article-title><source>J Nordic Educ Research</source><year>1995</year><volume>15</volume><fpage>156</fpage><lpage>161</lpage></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Aspegren</surname><given-names>K</given-names></name></person-group><article-title>BEME Guide No. 2: Teaching and learning communication skills in medicine-a review with quality grading of articles</article-title><source>Med Teach</source><year>1999</year><volume>21</volume><fpage>563</fpage><lpage>570</lpage><pub-id pub-id-type="doi">10.1080/01421599978979</pub-id></citation></ref><ref id="B28"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Maguire</surname><given-names>P</given-names></name><name><surname>Pitceathly</surname><given-names>C</given-names></name></person-group><article-title>Key communication skills and how to acquire them</article-title><source>BMJ</source><year>2002</year><volume>325</volume><fpage>697</fpage><lpage>700</lpage><pub-id pub-id-type="pmid">12351365</pub-id><pub-id pub-id-type="doi">10.1136/bmj.325.7366.697</pub-id></citation></ref></ref-list></back></article>