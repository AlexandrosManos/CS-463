valign="top" align="left" rowspan="1" colspan="1"/></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1">	18&#x02013;44 y</td><td valign="top" align="center" rowspan="1" colspan="1">26.3</td><td valign="top" align="center" rowspan="1" colspan="1">26.8</td><td valign="top" align="center" rowspan="1" colspan="1">26.9</td><td valign="top" align="center" rowspan="1" colspan="1">26.1</td><td valign="top" align="center" rowspan="1" colspan="1">28.1</td><td valign="top" align="center" rowspan="1" colspan="1">29.1</td><td valign="top" align="center" rowspan="1" colspan="1">30.7</td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1">	45&#x02013;64 y</td><td valign="top" align="center" rowspan="1" colspan="1">24.4</td><td valign="top" align="center" rowspan="1" colspan="1">25.2</td><td valign="top" align="center" rowspan="1" colspan="1">24.4</td><td valign="top" align="center" rowspan="1" colspan="1">23.2</td><td valign="top" align="center" rowspan="1" colspan="1">24.3</td><td valign="top" align="center" rowspan="1" colspan="1">25.5</td><td valign="top" align="center" rowspan="1" colspan="1">27.4</td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1">	65&#x02013;84 y</td><td valign="top" align="center" rowspan="1" colspan="1">22.8</td><td valign="top" align="center" rowspan="1" colspan="1">23.7</td><td valign="top" align="center" rowspan="1" colspan="1">23.3</td><td valign="top" align="center" rowspan="1" colspan="1">22.8</td><td valign="top" align="center" rowspan="1" colspan="1">23.8</td><td valign="top" align="center" rowspan="1" colspan="1">24.9</td><td valign="top" align="center" rowspan="1" colspan="1">27.8</td></tr><tr><td valign="top" align="left" scope="row" rowspan="1" colspan="1"><underline>&#x0003e;</underline>85 y<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">22.1<hr/></td><td valign="top" align="center" rowspan="1" colspan="1">24.4<hr/></td><td valign="top" align="center" row