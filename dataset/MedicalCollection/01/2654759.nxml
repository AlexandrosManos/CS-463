thor"><name><surname>Samuel</surname><given-names>BS</given-names></name><name><surname>Gordon</surname><given-names>JI</given-names></name></person-group><year>2006</year><article-title>A humanized gnotobiotic mouse model of host-archaeal-bacterial mutualism.</article-title><source>Proc Natl Acad Sci U S A</source><volume>103</volume><fpage>10011</fpage><lpage>10016</lpage><pub-id pub-id-type="pmid">16782812</pub-id></element-citation></ref><ref id="pone.0004893-Macdonald1"><label>11</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Macdonald</surname><given-names>TT</given-names></name><name><surname>Monteleone</surname><given-names>G</given-names></name></person-group><year>2005</year><article-title>Immunity, inflammation, and allergy in the gut.</article-title><source>Science</source><volume>307</volume><fpage>1920</fpage><lpage>1925</lpage><pub-id pub-id-type="pmid">15790845</pub-id></element-citation></ref><ref id="pone.0004893-Walker1"><label>12</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Walker</surname><given-names>WA</given-names></name></person-group><year>2008</year><article-title>Mechanisms of action of probiotics.</article-title><source>Clin Infect Dis</source><volume>46</volume><issue>Suppl 2</issue><fpage>S87</fpage><lpage>91; discussion S144&#x02013;151</lpage><pub-id pub-id-type="pmid">18181730</pub-id></element-citation></ref><ref id="pone.0004893-OMahony1"><label>13</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>O'Mahony</surname><given-names>C</given-names></name><name><surname>Scully</surname><given-names>P</given-names></name><name><surname>O'Mahony</surname><given-names>D</given-names></name><name><surname>Murphy</surname><given-names>S</given-names></name><name><surname>O'Brien</surname><given-names>F</given-names></name><etal/></person-group><year>2008</year><a