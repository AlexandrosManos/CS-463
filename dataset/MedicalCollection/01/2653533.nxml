age><lpage>25</lpage><pub-id pub-id-type="doi">10.1016/S0531-5565(02)00161-4</pub-id><pub-id pub-id-type="pmid">12543257</pub-id></mixed-citation></ref><ref id="B14"><mixed-citation publication-type="journal"><name><surname>Twamley</surname><given-names>EW</given-names></name><name><surname>Ropacki</surname><given-names>SA</given-names></name><name><surname>Bondi</surname><given-names>MW</given-names></name><article-title>Neuropsychological and neuroimaging changes in preclinical Alzheimer'sdisease</article-title><source>J Int Neuropsychol Soc</source><year>2006</year><volume>5</volume><issue>5</issue><fpage>707</fpage><lpage>735</lpage><pub-id pub-id-type="doi">10.1017/S1355617706060863</pub-id><pub-id pub-id-type="pmid">16961952</pub-id></mixed-citation></ref><ref id="B15"><mixed-citation publication-type="journal"><name><surname>Hubacek</surname><given-names>JA</given-names></name><name><surname>Pitha</surname><given-names>J</given-names></name><name><surname>Skodova</surname><given-names>Z</given-names></name><name><surname>Adamkova</surname><given-names>V</given-names></name><name><surname>Lanska</surname><given-names>V</given-names></name><name><surname>Poledne</surname><given-names>R</given-names></name><article-title>A possible role of apolipoprotien E polymorphism in predisposition to highereducation</article-title><source>Neuropsychobiology</source><year>2001</year><volume>5</volume><fpage>200</fpage><lpage>203</lpage><pub-id pub-id-type="doi">10.1159/000054890</pub-id><pub-id pub-id-type="pmid">11287800</pub-id></mixed-citation></ref><ref id="B16"><mixed-citation publication-type="book"><name><surname>Adams</surname><given-names>RD</given-names></name><person-group person-group-type="editor">Birren JE, Sloane RB</person-group><article-title>Morphological aspects of aging in the human nervous system</article-title><source>Handbook of Mental Health and Aging</source><year>1980</year><publisher-name>Englewood Cliffs, NJ: Prentice Hall</publisher-name><fpage>