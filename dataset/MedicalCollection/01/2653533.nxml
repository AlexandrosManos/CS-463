lume>5</volume><fpage>347</fpage><lpage>348</lpage><pub-id pub-id-type="doi">10.1016/S0197-4580(00)00250-5</pub-id><pub-id pub-id-type="pmid">11378236</pub-id></mixed-citation></ref><ref id="B22"><mixed-citation publication-type="journal"><name><surname>Plomin</surname><given-names>R</given-names></name><name><surname>McGuffin</surname><given-names>P</given-names></name><article-title>Psychopathology in the postgenomic era</article-title><source>Ann Rev Psychol</source><year>2003</year><volume>5</volume><fpage>205</fpage><lpage>228</lpage><pub-id pub-id-type="doi">10.1146/annurev.psych.54.101601.145108</pub-id><pub-id pub-id-type="pmid">12172001</pub-id></mixed-citation></ref><ref id="B23"><mixed-citation publication-type="journal"><name><surname>Ernst</surname><given-names>RL</given-names></name><name><surname>Hay</surname><given-names>JW</given-names></name><article-title>The US economic and social costs of Alzheimer's disease revisited</article-title><source>Am J Public Health</source><year>1994</year><volume>5</volume><issue>8</issue><fpage>1261</fpage><lpage>1264</lpage><pub-id pub-id-type="doi">10.2105/AJPH.84.8.1261</pub-id><pub-id pub-id-type="pmid">8059882</pub-id></mixed-citation></ref><ref id="B24"><mixed-citation publication-type="journal"><name><surname>Hood</surname><given-names>E</given-names></name><name><surname>Jenkins</surname><given-names>KP</given-names></name><article-title>Evolutionary Medicine: A Powerful Tool for Improving Human Health</article-title><source>Evolution: Education and Outreach</source><year>2008</year><volume>5</volume><fpage>114</fpage><lpage>120</lpage><pub-id pub-id-type="doi">10.1007/s12052-008-0036-9</pub-id></mixed-citation></ref><ref id="B25"><mixed-citation publication-type="book"><name><surname>Nesse</surname><given-names>R</given-names></name><name><surname>Williams</surname><given-names>G</given-names></name><source>Why We Get Sick</source><year>1995</year><publisher-name>New York: Random House</publisher-name></mix