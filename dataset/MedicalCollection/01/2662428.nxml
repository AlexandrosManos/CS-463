-id pub-id-type="pmid">9171586</pub-id></citation></ref><ref id="pone.0005216-Renfrew1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Renfrew</surname><given-names>MJ</given-names></name><name><surname>Lang</surname><given-names>S</given-names></name><name><surname>Woolridge</surname><given-names>MW</given-names></name></person-group><year>2000</year><article-title>Early versus delayed initiation of breastfeeding.</article-title><source>Cochrane Database Syst Rev</source><volume>2</volume><fpage>CD000043</fpage><pub-id pub-id-type="pmid">10796101</pub-id></citation></ref><ref id="pone.0005216-Hwang1"><label>26</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hwang</surname><given-names>CP</given-names></name></person-group><year>1980</year><article-title>Aspects of the mother-infant relationship during nursing, 1 and 6 weeks after early extended post-partum contact.</article-title><source>Early Human Development</source><volume>5</volume><fpage>279</fpage><lpage>287</lpage><pub-id pub-id-type="pmid">7261991</pub-id></citation></ref><ref id="pone.0005216-Hales1"><label>27</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hales</surname><given-names>DJ</given-names></name><name><surname>Lozoff</surname><given-names>B</given-names></name><name><surname>Sosa</surname><given-names>R</given-names></name><name><surname>Kennell</surname><given-names>JH</given-names></name></person-group><year>1977</year><article-title>Defining the limits of the maternal sensitive period.</article-title><source>Dev Med Child Neurol</source><volume>19</volume><fpage>451</fpage><lpage>461</lpage></citation></ref><ref id="pone.0005216-Jansson1"><label>28</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jansson</surname><given-names>UM</given-names></name><name><surname>Mustafa</surname><given-n