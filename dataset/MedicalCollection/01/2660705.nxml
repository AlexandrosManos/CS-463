d pub-id-type="doi">10.1046/j.1198-743x.2001.00282.x</pub-id><pub-id pub-id-type="pmid">11678928</pub-id></citation></ref><ref id="R14"><label>14. </label><citation citation-type="journal"><string-name><surname>Dautel</surname> <given-names>H</given-names></string-name>, <string-name><surname>Dippel</surname> <given-names>C</given-names></string-name>, <string-name><surname>Oehme</surname> <given-names>R</given-names></string-name>, <string-name><surname>Hartelt</surname> <given-names>K</given-names></string-name>, <string-name><surname>Schettler</surname> <given-names>E</given-names></string-name> <article-title>Evidence for an increased geographical distribution of <italic>Dermacentor reticulatus</italic> in Germany and detection of <italic>Rickettsia</italic> sp. RpA4.</article-title><source>Int J Med Microbiol</source> <year>2006</year>;<volume>296</volume>(<issue>Suppl 40</issue>):<fpage>149</fpage>&#x02013;<lpage>56</lpage> <pub-id pub-id-type="doi">10.1016/j.ijmm.2006.01.013</pub-id><pub-id pub-id-type="pmid">16524777</pub-id></citation></ref><ref id="R15"><label>15. </label><citation citation-type="journal"><string-name><surname>Mediannikov</surname> <given-names>O</given-names></string-name>, <string-name><surname>Matsumoto</surname> <given-names>K</given-names></string-name>, <string-name><surname>Samoylenko</surname> <given-names>I</given-names></string-name>, <string-name><surname>Drancourt</surname> <given-names>M</given-names></string-name>, <string-name><surname>Roux</surname> <given-names>V</given-names></string-name>, <string-name><surname>Rydkina</surname> <given-names>E</given-names></string-name>, <etal/><article-title><italic>Rickettsia raoultii</italic> sp. nov., a spotted fever group rickettsia associated with <italic>Dermacentor</italic> ticks in Europe and Russia.</article-title><source>Int J Syst Evol Microbiol</source> <year>2008</year>;<volume>58</volume>:<fpage>1635</fpage>&#x02013;<lpage>9</lpage> <pub-id pub-id-type="doi">10.1099/ijs.0.64952-0</pub-id><pub-id pub-id-type="pmid">18599708</pub-id></citation></ref></ref-list></back></article>