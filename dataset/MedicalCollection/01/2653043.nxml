><fpage>957</fpage><lpage>62</lpage><pub-id pub-id-type="pmid">16974058</pub-id><pub-id pub-id-type="doi">10.2169/internalmedicine.45.1589</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eggebrecht</surname><given-names>H</given-names></name><name><surname>Naber</surname><given-names>CK</given-names></name><name><surname>Bruch</surname><given-names>C</given-names></name><name><surname>Kr&#x000f6;ger</surname><given-names>K</given-names></name><name><surname>von Birgelen</surname><given-names>C</given-names></name><name><surname>Schmermund</surname><given-names>A</given-names></name><name><surname>Wichert</surname><given-names>M</given-names></name><name><surname>Bartel</surname><given-names>T</given-names></name><name><surname>Mann</surname><given-names>K</given-names></name><name><surname>Erbel</surname><given-names>R</given-names></name></person-group><article-title>Value of plasma fibrin D-dimers for detection of acute aortic dissection</article-title><source>J Am Coll Cardiol</source><year>2004</year><volume>44</volume><fpage>804</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">15312863</pub-id><pub-id pub-id-type="doi">10.1016/j.jacc.2004.04.053</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ayrik</surname><given-names>C</given-names></name><name><surname>Cece</surname><given-names>H</given-names></name><name><surname>Aslan</surname><given-names>O</given-names></name><name><surname>Karcioglu</surname><given-names>O</given-names></name><name><surname>Yilmaz</surname><given-names>E</given-names></name></person-group><article-title>Seeing the invisible: painless aortic dissection in the emergency setting</article-title><source>Emerg Med J</source><year>2006</year><volume>23</volume><fpage>24</fpage><pub-id pub-id-type="doi">10.1136/emj.2004.021790</pub-id></citation></ref><ref id="B14"><citation citatio