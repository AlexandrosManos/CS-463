><tr><td align="left" valign="top" charoff="50">Positive nodes (<italic>P</italic>=0.23)</td><td align="char" valign="top" char="(" charoff="50">39&#x00025; (12/31)</td><td align="char" valign="top" char="(" charoff="50">33&#x00025; (13/40)</td><td align="char" valign="top" char="(" charoff="50">48&#x00025; (47/98)</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">NPI, mean (s.d.) (<italic>P</italic>&#x0003c;0.001)</td><td align="char" valign="top" char="(" charoff="50">3.8 (1.3)</td><td align="char" valign="top" char="(" charoff="50">4.0 (1.2)</td><td align="char" valign="top" char="(" charoff="50">4.9 (1.2)</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">&#x000a0;</td></tr><tr><td align="left" valign="top" charoff="50">ER&#x0002b; cases<sup>a</sup> (<italic>P</italic>=0.08)</td><td align="char" valign="top" char="(" charoff="50">100&#x00025; (73.9&#x02013;100&#x00025;)</td><td align="char" valign="top" char="(" charoff="50">100&#x00025; (100&#x02013;100&#x00025;)</td><td align="char" valign="top" char="(" charoff="50">88.9&#x00025; (0&#x02013;100&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50">PR&#x0002b; cases<sup>a</sup> (<italic>P</italic>=0.14)</td><td align="char" valign="top" char="(" charoff="50">72.4&#x00025; (35.8&#x02013;100&#x00025;)</td><td align="char" valign="top" char="(" charoff="50">92.2&#x00025; (47&#x02013;100&#x00025;)</td><td align="char" valign="top" char="(" charoff="50">18.8&#x00025; (0&#x02013;97.8&#x00025;)</td></tr><tr><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">&#x000a0;</td><td align="char" valign="top" char="(" charoff="50">&#x000a0;</td></tr><tr><td colspan="4" align="left" valign="top" charoff="50"><italic>Her-2</italic></td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;0</td><td align="char" valign="top" char="(" charoff="50">66.7&#x00025; (22/33)</td><td align="char" valign="top" char="(" charoff="50">68.2&#x00025; (30/44)</td><td align="char" valign="top" char="(" charoff="50">53.3&#x00025; (56/105)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;1&#x0002b;</td><td align="char" valign="top" char="(" charoff="50">15.2&#x00025; (5/33)</td><td align="char" valign="top" char="(" charoff="50">18&#x00025; (8/44)</td><td align="char" valign="top" char="(" charoff="50">19&#x00025; (20/105)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;2&#x0002b;</td><td align="char" valign="top" char="(" charoff="50">9.1&#x00025; (3/33)</td><td align="char" valign="top" char="(" charoff="50">4.5&#x00025; (2/44)</td><td align="char" valign="top" char="(" charoff="50">7.6&#x00025; (8/105)</td></tr><tr><td align="left" valign="top" charoff="50">&#x02003;3&#x0002b; (<italic>P</italic>=0.45)</td><td align="char" valign="top" char="(" charoff="50">9.1&#x00025; (3/33)</td><td align="char" valign="top" char="(" charoff="50">9.1&#x00025; (4/44)</td><td align="char" valign="top" char="(" charoff="50">20&#x00025; (21/105)</td></tr></tbody></table><table-wrap-foot><fn id="t1-fn1"><label/><p>ER=oestrogen receptor; NPI=Nottingham Prognostic Index; PR=progesterone receptor.</p></fn><fn id="t1-fn2"><label/><p><sup>a</sup>Median (interquartile ranges).</p></fn><fn id="t1-fn3"><label/><p><sup>&#x0002a;</sup>Significant association restricted to phenotype III.</p></fn></table-wrap-foot></table-wrap></floats-wrap></article>