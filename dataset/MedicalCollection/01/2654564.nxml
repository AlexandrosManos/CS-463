d="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hamba</surname><given-names>M</given-names></name><name><surname>Muro</surname><given-names>M</given-names></name><name><surname>Hiraide</surname><given-names>T</given-names></name><etal></etal></person-group><article-title>Expression of c-fos like protein of in the rat brain after injection of interleukin-1-beta into the gingiva</article-title><source>Brain Res Bull</source><year>1994</year><volume>34</volume><fpage>61</fpage><lpage>68</lpage><pub-id pub-id-type="pmid">8193934</pub-id><pub-id pub-id-type="doi">10.1016/0361-9230(94)90187-2</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Shibata</surname><given-names>K</given-names></name><name><surname>Takeda</surname><given-names>M</given-names></name><name><surname>Ito</surname><given-names>A</given-names></name><etal></etal></person-group><article-title>Ovariectomy-induced hyperalgesia and antinociceptive effect of elcatonin, a synthetic eel calcitonin</article-title><source>Pharmacol Biochem Behav</source><year>1998</year><volume>60</volume><fpage>371</fpage><lpage>376</lpage><pub-id pub-id-type="pmid">9632219</pub-id><pub-id pub-id-type="doi">10.1016/S0091-3057(98)00015-X</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Molander</surname><given-names>C</given-names></name><name><surname>Xu</surname><given-names>Q</given-names></name><name><surname>Grant</surname><given-names>G</given-names></name></person-group><article-title>The cytoarchitectonic organization of the spinal cord in the rat : the lower thoratic and lumbosacral cord</article-title><source>J Comp Neurol</source><year>1984</year><volume>230</volume><fpage>133</fpage><lpage>141</lpage><pub-id pub-id-type="pmid">6512014</pub-id><pub-id pub-id-type="doi">10.1002/cne.902300112</pub-id></citation></