itation></ref><ref id="B16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wildman</surname><given-names>RP</given-names></name><name><surname>Gu</surname><given-names>D</given-names></name><name><surname>Muntner</surname><given-names>P</given-names></name><etal/></person-group><article-title>Alcohol intake and hypertension subtypes in Chinese men</article-title><source><italic>Journal of Hypertension</italic></source><year>2005</year><volume>23</volume><issue>4</issue><fpage>737</fpage><lpage>743</lpage><pub-id pub-id-type="pmid">15775777</pub-id></element-citation></ref><ref id="B17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Henningsen</surname><given-names>NC</given-names></name><name><surname>Ohlsson</surname><given-names>O</given-names></name><name><surname>Mattiasson</surname><given-names>I</given-names></name><name><surname>Trell</surname><given-names>E</given-names></name><name><surname>Kristensson</surname><given-names>H</given-names></name><name><surname>Hood</surname><given-names>B</given-names></name></person-group><article-title>Hypertension, levels of serum gamma glutamyl transpeptidase and degree of blood pressure control in middle-aged males</article-title><source><italic>Acta Medica Scandinavica</italic></source><year>1980</year><volume>207</volume><issue>4</issue><fpage>245</fpage><lpage>251</lpage><pub-id pub-id-type="pmid">6104414</pub-id></element-citation></ref><ref id="B18"><label>18</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Garg</surname><given-names>JP</given-names></name><name><surname>Elliott</surname><given-names>WJ</given-names></name><name><surname>Folker</surname><given-names>A</given-names></name><name><surname>Izhar</surname><given-names>M</given-names></name><name><surname>Black</surname><given-names>HR</given-names></name>