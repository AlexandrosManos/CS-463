</fpage><lpage>2363</lpage><pub-id pub-id-type="pmid">17978762</pub-id></citation></ref><ref id="B16"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Danish</surname><given-names>M</given-names></name><name><surname>Alt</surname><given-names>HG</given-names></name><name><surname>Badshah</surname><given-names>A</given-names></name><name><surname>Ali</surname><given-names>S</given-names></name><name><surname>Mazhar</surname><given-names>M</given-names></name><name><surname>Islam</surname><given-names>N</given-names></name></person-group><source>J Organomet Chem</source><year>1995</year><volume>486</volume><fpage>51</fpage><lpage>56</lpage></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yared</surname><given-names>E</given-names></name><name><surname>McMillan</surname><given-names>TJ</given-names></name><name><surname>Martin</surname><given-names>FL</given-names></name></person-group><source>Mutagenesis</source><year>2002</year><volume>17</volume><fpage>345</fpage><lpage>352</lpage><pub-id pub-id-type="pmid">12110632</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hammiche</surname><given-names>A</given-names></name><name><surname>German</surname><given-names>MJ</given-names></name><name><surname>Hewitt</surname><given-names>R</given-names></name><name><surname>Pollock</surname><given-names>HM</given-names></name><name><surname>Martin</surname><given-names>FL</given-names></name></person-group><source>Biophys J</source><year>2005</year><volume>88</volume><fpage>3699</fpage><lpage>3706</lpage><pub-id pub-id-type="pmid">15722424</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barber</surname><given-names>JL</given-names></name><name><surname>Walsh</surname><given-names>MJ</given-names></name><name><surname>Hewitt</surname><given-names>R</given-names></name><name><surname>Jones</surname><given-names>KC</given-names></name><name><surname>Martin</surname><given-names>FL</given-names></name></person-group><source>Mutagenesis</source><year>2006</year><volume>21</volume><fpage>351</fpage><lpage>360</lpage><pub-id pub-id-type="pmid">16980705</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kalantzi</surname><given-names>OI</given-names></name><name><surname>Hewitt</surname><given-names>R</given-names></name><name><surname>Ford</surname><given-names>KJ</given-names></name><name><surname>Cooper</surname><given-names>L</given-names></name><name><surname>Alcock</surname><given-names>RE</given-names></name><name><surname>Thomas</surname><given-names>GO</given-names></name><name><surname>Morris</surname><given-names>JA</given-names></name><name><surname>McMillan</surname><given-names>TJ</given-names></name><name><surname>Jones</surname><given-names>KC</given-names></name><name><surname>Martin</surname><given-names>FL</given-names></name></person-group><source>Carcinogenesis</source><year>2004</year><volume>25</volume><fpage>613</fpage><lpage>622</lpage><pub-id pub-id-type="pmid">14688026</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Martin</surname><given-names>FL</given-names></name><name><surname>Cole</surname><given-names>KJ</given-names></name><name><surname>Williams</surname><given-names>JA</given-names></name><name><surname>Millar</surname><given-names>BC</given-names></name><name><surname>Harvey</surname><given-names>D</given-names></name><name><surname>Weaver</surname><given-names>G</given-names></name><name><surname>Grover</surname><given-names>PL</given-names></name><name><surname>Phillips</surname><given-names>DH</given-names></name></person-group><source>Mutat Res</source><year>2000</year><volume>470</v