citation citation-type="journal"><person-group person-group-type="author"><name><surname>Wilkins</surname><given-names>RC</given-names></name><name><surname>Lis</surname><given-names>JT</given-names></name></person-group><year>1998</year><article-title>GAGA factor binding to DNA via a single trinucleotide sequence element.</article-title><source>Nucleic Acids Res</source><volume>26</volume><fpage>2672</fpage><lpage>2678</lpage><pub-id pub-id-type="pmid">9592153</pub-id></citation></ref><ref id="pone.0004701-v.Steensel1"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>v. Steensel</surname><given-names>B</given-names></name><name><surname>Delrow</surname><given-names>J</given-names></name><name><surname>Bussemaker</surname><given-names>HJ</given-names></name></person-group><year>2003</year><article-title>Genomewide analysis of Drosophila GAGA factor target genes reveals context-dependent DNA binding.</article-title><source>Proc Natl Acad Sci USA</source><volume>100</volume><fpage>2580</fpage><lpage>2585</lpage><pub-id pub-id-type="pmid">12601174</pub-id></citation></ref><ref id="pone.0004701-Kroeger1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kroeger</surname><given-names>PE</given-names></name><name><surname>Morimoto</surname><given-names>RI</given-names></name></person-group><year>1994</year><article-title>Selection of new HSF1 and HSF2 DNA-binding sites reveals difference in trimer cooperativity.</article-title><source>Mol Cell Biol</source><volume>14</volume><fpage>7592</fpage><lpage>7603</lpage><pub-id pub-id-type="pmid">7935474</pub-id></citation></ref><ref id="pone.0004701-Weintraub1"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weintraub</surname><given-names>H</given-names></name><name><surname>Groudine</surname><given-names>M</given-names></name></person-group><year>1976</year><article-title>Chromosomal subunits in active genes have an altered conformation.</article-title><source>Science</source><volume>193</volume><fpage>848</fpage><lpage>856</lpage><pub-id pub-id-type="pmid">948749</pub-id></citation></ref><ref id="pone.0004701-Petesch1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Petesch</surname><given-names>SJ</given-names></name><name><surname>Lis</surname><given-names>JT</given-names></name></person-group><year>2008</year><article-title>Rapid, transcription-independent loss of nucleosomes over a large chromatin domain at Hsp70 loci.</article-title><source>Cell</source><volume>134</volume><fpage>74</fpage><lpage>84</lpage><pub-id pub-id-type="pmid">18614012</pub-id></citation></ref><ref id="pone.0004701-Kosak1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kosak</surname><given-names>ST</given-names></name><name><surname>Scalzo</surname><given-names>D</given-names></name><name><surname>Alworth</surname><given-names>SV</given-names></name><name><surname>Li</surname><given-names>F</given-names></name><name><surname>Palmer</surname><given-names>S</given-names></name><etal/></person-group><year>2007</year><article-title>Coordinate Gene Regulation during Hematopoiesis Is Related to Genomic Organization.</article-title><source>PLoS Biology</source><volume>Vol. 5, No. 11</volume><fpage>e309</fpage><comment>doi:10.1371/journal.pbio.0050309</comment><pub-id pub-id-type="pmid">18031200</pub-id></citation></ref><ref id="pone.0004701-Chu1"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chu</surname><given-names>WM</given-names></name><name><surname>Liu</surname><given-names>WM</given-names></name><name><surname>Schmid</surname><given-names>CW</given-names></name></person-group><year>1995</year><article-title>RNA polymerase III promoter and terminator elements affect AIu RNA expression.</article-title><source>Nucleic Acids Res</source><volume>23</volume><fpage>1750</fpage><lpage>1757</lpage><pub-id pub-id-type="pmid">7540287</pub-id></citation></ref><ref id="pone.0004701-Kim1"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>C</given-names></name><name><surname>Rubin</surname><given-names>CM</given-names></name><name><surname>Schmid</surname><given-names>CW</given-names></name></person-group><year>2001</year><article-title>Genome-wide chromatin remodeling modulates the Alu heat shock response.</article-title><source>Gene</source><volume>276</volume><fpage>127</fpage><lpage>133</lpage><pub-id pub-id-type="pmid">11591479</pub-id></citation></ref><ref id="pone.0004701-Chu2"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Chu</surname><given-names>WM</given-names></name><name><surname>Ballard</surname><given-names>R</given-names></name><name><surname>Carpick</surname><given-names>BW</given-names></name><name><surname>Williams</surname><given-names>BR</given-names></name><name><surname>Schmid</surname><given-names>CW</given-names></name></person-group><year>1998</year><article-title>Potential Alu function: regulation of the activity of double-stranded RNA-activated kinase PKR.</article-title><source>Mol Cell Bio</source><volume>18</volume><fpage>58</fpage><lpage>68</lpage><pub-id pub-id-type="pmid">9418853</pub-id></citation></ref><ref id="pone.0004701-JulienHsler1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Julien H&#x000e4;sler</surname><given-names>J</given-names></name><name><surname>Strub</surname><given-names>K</given-names></name></person-group><year>2006</year><article-title><italic>Alu</italic> RNP and <italic>Alu</italic> RNA regulate translation initiation <italic>in vitro</italic>.</article-title><source>Nucleic Acids Res</source><volume>34(8)</volume><fpage>2374</fpage><lpage>2385</lpage><pub-id pub-id-type="pmid">16682445</pub-id></citation></ref><ref id="pone.0004701-Hagan1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hagan</surname><given-names>CR</given-names></name><name><surname>Sheffield</surname><given-names>RF</given-names></name><name><surname>Rudin</surname><given-names>CM</given-names></name></person-group><year>2003</year><article-title>Human Alu element retrotransposition induced by genotoxic stress.</article-title><source>Nat Gen</source><volume>35</volume><fpage>219</fpage><lpage>220</lpage></citation></ref></ref-list><fn-group><fn fn-type="conflict"><p><bold>Competing Interests: </bold>The author has declared that no competing interests exist.</p></fn><fn fn-type="financial-disclosure"><p><bold>Funding: </bold>No funding was received for this article. The salary of the author came in part from the Robert Laughlin Rea Endowed Chair held by the author.</p></fn></fn-group></back></article>