 citation-type="journal"><person-group person-group-type="author"><name><surname>Anderson</surname><given-names>VA</given-names></name><name><surname>Godber</surname><given-names>T</given-names></name><name><surname>Smibert</surname><given-names>E</given-names></name><name><surname>Weiskop</surname><given-names>S</given-names></name><name><surname>Ekert</surname><given-names>H</given-names></name></person-group><article-title>Impairments of attention following treatment with cranial irradiation and chemotherapy in children</article-title><source>J Clin Exp Neuropsychol</source><year>2004</year><volume>26</volume><fpage>684</fpage><lpage>97</lpage><pub-id pub-id-type="pmid">15370390</pub-id></citation></ref><ref id="b7"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kingma</surname><given-names>A</given-names></name><name><surname>van Dommelen</surname><given-names>RI</given-names></name><name><surname>Mooyaart</surname><given-names>EL</given-names></name><name><surname>Wilmink</surname><given-names>JT</given-names></name><name><surname>Deelman</surname><given-names>BG</given-names></name><name><surname>Kamps</surname><given-names>WA</given-names></name></person-group><article-title>No major cognitive impairment in young children with acute lymphoblastic leukemia using chemotherapy only: a prospective longitudinal study</article-title><source>J Pediatr Hematol Oncol</source><year>2002</year><volume>24</volume><fpage>106</fpage><lpage>14</lpage><pub-id pub-id-type="pmid">11990695</pub-id></citation></ref><ref id="b8"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Waber</surname><given-names>DP</given-names></name><name><surname>Tarbell</surname><given-names>NJ</given-names></name><name><surname>Fairclough</surname><given-names>D</given-names></name><name><surname>Atmore</surname><given-names>K</given-names></name><name><surname>Castro</surname><given-n