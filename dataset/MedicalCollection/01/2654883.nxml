</citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Agha</surname><given-names>R</given-names></name><name><surname>Cooper</surname><given-names>D</given-names></name><name><surname>Muir</surname><given-names>G</given-names></name></person-group><article-title>The reporting quality of randomised controlled trials in surgery: A systematic review</article-title><source>Int J Surg</source><year>2007</year><volume>5</volume><fpage>413</fpage><lpage>422</lpage><pub-id pub-id-type="pmid">18029237</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bhandari</surname><given-names>M</given-names></name><name><surname>Guyatt</surname><given-names>GH</given-names></name><name><surname>Lochner</surname><given-names>H</given-names></name><name><surname>Sprague</surname><given-names>S</given-names></name><name><surname>Tronetta</surname><given-names>P</given-names></name></person-group><article-title>Application of the consolidated standards of reporting trials (CONSORT) in the fracture care literature</article-title><source>J Bone Joint Surg Am</source><year>2002</year><volume>84A</volume><fpage>485</fpage><lpage>489</lpage><pub-id pub-id-type="pmid">11886922</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hall</surname><given-names>JC</given-names></name><name><surname>Mills</surname><given-names>B</given-names></name><name><surname>Nguyen</surname><given-names>H</given-names></name><name><surname>Hall</surname><given-names>JL</given-names></name></person-group><article-title>Methodologic standards in surgical trials</article-title><source>Surgery</source><year>1996</year><volume>119</volume><fpage>466</fpage><lpage>472</lpage><pub-id pub-id-type="pmid">8644014</pub-id></citation></ref><ref id="B21"><citation citation-type="journal"><person-group person-g