>JM</given-names></name><name><surname>Fauci</surname><given-names>AS</given-names></name></person-group><article-title>Both a precursor and a mature population of dendritic cells can bind HIV: however, only the mature population that expresses CD80 can pass infection to unstimulated CD4<sup>+</sup> T cells</article-title><source><italic>The Journal of Immunology</italic></source><year>1995</year><volume>155</volume><issue>8</issue><fpage>4111</fpage><lpage>4117</lpage><pub-id pub-id-type="pmid">7561124</pub-id></citation></ref><ref id="B13"><label>13</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Saeki</surname><given-names>S</given-names></name><name><surname>Matsuse</surname><given-names>H</given-names></name><name><surname>Kondo</surname><given-names>Y</given-names></name><etal/></person-group><article-title>Effects of antiasthmatic agents on the functions of peripheral blood monocyte-derived dendritic cells from atopic patients</article-title><source><italic>Journal of Allergy and Clinical Immunology</italic></source><year>2004</year><volume>114</volume><issue>3</issue><fpage>538</fpage><lpage>544</lpage><pub-id pub-id-type="pmid">15356554</pub-id></citation></ref><ref id="B14"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tanaka</surname><given-names>A</given-names></name><name><surname>Minoguchi</surname><given-names>K</given-names></name><name><surname>Samson</surname><given-names>KTR</given-names></name><etal/></person-group><article-title>Inhibitory effects of suplatast tosilate on the differentiation and function of monocyte-derived dendritic cells from patients with asthma</article-title><source><italic>Clinical &#x00026; Experimental Allergy</italic></source><year>2007</year><volume>37</volume><issue>7</issue><fpage>1083</fpage><lpage>1089</lpage><pub-id pub-id-type="pmid">17581203</pub-id></citation></ref><ref id="B15"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Machida</surname><given-names>I</given-names></name><name><surname>Matsuse</surname><given-names>H</given-names></name><name><surname>Kondo</surname><given-names>Y</given-names></name><etal/></person-group><article-title>Cysteinyl leukotrienes regulate dendritic cell functions in a murine model of asthma</article-title><source><italic>The Journal of Immunology</italic></source><year>2004</year><volume>172</volume><issue>3</issue><fpage>1833</fpage><lpage>1838</lpage><pub-id pub-id-type="pmid">14734767</pub-id></citation></ref><ref id="B16"><label>16</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Machida</surname><given-names>I</given-names></name><name><surname>Matsuse</surname><given-names>H</given-names></name><name><surname>Kondo</surname><given-names>Y</given-names></name><etal/></person-group><article-title>Effects of various anti-asthmatic agents on mite allergen-pulsed murine bone marrow-derived dendritic cells</article-title><source><italic>Clinical &#x00026; Experimental Allergy</italic></source><year>2005</year><volume>35</volume><issue>7</issue><fpage>884</fpage><lpage>888</lpage><pub-id pub-id-type="pmid">16008674</pub-id></citation></ref><ref id="B17"><label>17</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lutz</surname><given-names>MB</given-names></name><name><surname>Kukutsch</surname><given-names>N</given-names></name><name><surname>Ogilvie</surname><given-names>ALJ</given-names></name><etal/></person-group><article-title>An advanced culture method for generating large quantities of highly pure dendritic cells from mouse bone marrow</article-title><source><italic>Journal of Immunological Methods</italic></source><year>1999</year><volume>223</volume><issue>1</issue><fpage>77</fpage><lpage>92</lpage><pub-id pub-id-type="pmid">10037236</pub-id></citation></ref><ref id="B18"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gudmundsson</surname><given-names>G</given-names></name><name><surname>Hunninghake</surname><given-names>GW</given-names></name></person-group><article-title>Interferon-<italic>&#x003b3;</italic> is necessary for the expression of hypersensitivity pneumonitis</article-title><source><italic>The Journal of Clinical Investigation</italic></source><year>1997</year><volume>99</volume><issue>10</issue><fpage>2386</fpage><lpage>2390</lpage><pub-id pub-id-type="pmid">9153280</pub-id></citation></ref><ref id="B19"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bellinghausen</surname><given-names>I</given-names></name><name><surname>Brand</surname><given-names>U</given-names></name><name><surname>Knop</surname><given-names>J</given-names></name><name><surname>Saloga</surname><given-names>J</given-names></name></person-group><article-title>Comparison of allergen-stimulated dendritic cells from atopic and nonatopic donors dissecting their effect on autologous naive and memory T helper cells of such donors</article-title><source><italic>Journal of Allergy and Clinical Immunology</italic></source><year>2000</year><volume>105</volume><issue>5</issue><fpage>988</fpage><lpage>996</lpage><pub-id pub-id-type="pmid">10808181</pub-id></citation></ref><ref id="B20"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Meyts</surname><given-names>I</given-names></name><name><surname>Hellings</surname><given-names>PW</given-names></name><name><surname>Hens</surname><given-names>G</given-names></name><etal/></person-group><article-title>IL-12 contributes to allergen-induced airway inflammation in experimental asthma</article-title><source><italic>The Journal of Immunology</italic></source><year>2006</year><volume>177</volume><issue>9</issue><fpage>6460</fpage><lpage>6470<