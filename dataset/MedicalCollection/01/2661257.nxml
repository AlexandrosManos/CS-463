oup-type="author"><name><surname>Gold</surname><given-names>DV</given-names></name><name><surname>Modrak</surname><given-names>DE</given-names></name><name><surname>Ying</surname><given-names>Z</given-names></name><name><surname>Cardillo</surname><given-names>TM</given-names></name><name><surname>Sharkey</surname><given-names>RM</given-names></name><etal/></person-group><year>2006</year><article-title>New MUC1 serum immunoassay differentiates pancreatic cancer from pancreatitis.</article-title><source>J Clin Oncol</source><volume>24</volume><fpage>252</fpage><lpage>258</lpage><pub-id pub-id-type="pmid">16344318</pub-id></citation></ref><ref id="pmed.1000046-Hwang1"><label>14</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hwang</surname><given-names>RF</given-names></name><name><surname>Moore</surname><given-names>T</given-names></name><name><surname>Arumugam</surname><given-names>T</given-names></name><name><surname>Ramachandran</surname><given-names>V</given-names></name><name><surname>Amos</surname><given-names>KD</given-names></name><etal/></person-group><year>2008</year><article-title>Cancer-associated stromal fibroblasts promote pancreatic tumor progression.</article-title><source>Cancer Res</source><volume>68</volume><fpage>918</fpage><lpage>926</lpage><pub-id pub-id-type="pmid">18245495</pub-id></citation></ref><ref id="pmed.1000046-Infante1"><label>15</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Infante</surname><given-names>JR</given-names></name><name><surname>Matsubayashi</surname><given-names>H</given-names></name><name><surname>Sato</surname><given-names>N</given-names></name><name><surname>Tonascia</surname><given-names>J</given-names></name><name><surname>Klein</surname><given-names>AP</given-names></name><etal/></person-group><year>2007</year><article-title>Peritumoral fibroblast SPARC expression and patient outcome with resectable pancreatic adenoca