>1</volume><fpage>63</fpage><lpage>69</lpage></citation></ref><ref id="B9"><citation citation-type="other"><article-title>Food Standards Agency</article-title><ext-link ext-link-type="uri" xlink:href="http://www.food.gov.uk"/></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cunningham</surname><given-names>C</given-names></name><name><surname>Hikima</surname><given-names>J</given-names></name><name><surname>Jenny</surname><given-names>MJ</given-names></name><name><surname>Chapman</surname><given-names>RW</given-names></name><name><surname>Fang</surname><given-names>GC</given-names></name><name><surname>Saski</surname><given-names>C</given-names></name><name><surname>Lundqvist</surname><given-names>ML</given-names></name><name><surname>Wing</surname><given-names>RA</given-names></name><name><surname>Cupit</surname><given-names>PM</given-names></name><name><surname>Gross</surname><given-names>PS</given-names></name><name><surname>Warr</surname><given-names>GW</given-names></name><name><surname>Tomkins</surname><given-names>JP</given-names></name></person-group><article-title>New resources for marine genomics: bacterial artificial chromosome libraries for the Eastern and Pacific oysters (<italic>Crassostrea virginica </italic>and <italic>C. gigas</italic>)</article-title><source>Marine biotechnology</source><year>2006</year><volume>8</volume><fpage>521</fpage><lpage>533</lpage><pub-id pub-id-type="pmid">16896533</pub-id></citation></ref><ref id="B11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Sodergren</surname><given-names>E</given-names></name><name><surname>Weinstock</surname><given-names>GM</given-names></name><name><surname>Davidson</surname><given-names>EH</given-names></name><name><surname>Cameron</surname><given-names>RA</given-names></name><name><surname>Gibbs</surname><given-names>RA</given-names></name><name><surname>Angerer</surname><given-names>RC</given-names></name><name><surname>Angerer</surname><given-names>LM</given-names></name><name><surname>Arnone</surname><given-names>MI</given-names></name><name><surname>Burgess</surname><given-names>DR</given-names></name><name><surname>Burke</surname><given-names>RD</given-names></name><name><surname>Coffman</surname><given-names>JA</given-names></name><name><surname>Dean</surname><given-names>M</given-names></name><name><surname>Elphick</surname><given-names>MR</given-names></name><name><surname>Ettensohn</surname><given-names>CA</given-names></name><name><surname>Foltz</surname><given-names>KR</given-names></name><name><surname>Hamdoun</surname><given-names>A</given-names></name><name><surname>Hynes</surname><given-names>RO</given-names></name><name><surname>Klein</surname><given-names>WH</given-names></name><name><surname>Marzluff</surname><given-names>W</given-names></name><name><surname>McClay</surname><given-names>DR</given-names></name><name><surname>Morris</surname><given-names>RL</given-names></name><name><surname>Mushegian</surname><given-names>A</given-names></name><name><surname>Rast</surname><given-names>JP</given-names></name><name><surname>Smith</surname><given-names>LC</given-names></name><name><surname>Thorndyke</surname><given-names>MC</given-names></name><name><surname>Vacquier</surname><given-names>VD</given-names></name><name><surname>Wessel</surname><given-names>GM</given-names></name><name><surname>Wray</surname><given-names>G</given-names></name><name><surname>Zhang</surname><given-names>L</given-names></name><name><surname>Elsik</surname><given-names>CG</given-names></name><etal></etal></person-group><article-title>The genome of the sea urchin <italic>Strongylocentrotus purpuratus </italic></article-title><source>Science</source><year>2006</year><volume>314</volume><fpage>941</fpage><lpage>952</lpage><pub-id pub-id-type="pmid">17095691</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-gr