 Epidemiol</source><year>2006</year><volume>35</volume><fpage>1417</fpage><lpage>1422</lpage><pub-id pub-id-type="pmid">17060332</pub-id><pub-id pub-id-type="doi">10.1093/ije/dyl223</pub-id></citation></ref><ref id="B22"><citation citation-type="other"><person-group person-group-type="author"><collab>World Health Organization</collab></person-group><source>Obesity preventive and managing the global epidemiology Report of a WHO consultation on Obesity Geneva</source><year>1998</year></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bes-Rastrollo</surname><given-names>M</given-names></name><name><surname>P&#x000e9;rez</surname><given-names>JR</given-names></name><name><surname>S&#x000e1;nchez-Villegas</surname><given-names>A</given-names></name><name><surname>Alonso</surname><given-names>A</given-names></name><name><surname>Mart&#x000ed;nez-Gonz&#x000e1;lez</surname><given-names>MA</given-names></name></person-group><article-title>Validaci&#x000f3;n del peso e &#x000ed;ndice de masa corporal auto-declarados de los participantes de una cohorte de graduados universitarios</article-title><source>Rev Esp Obes</source><year>2005</year><volume>3</volume><fpage>352</fpage><lpage>358</lpage></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Stunkard</surname><given-names>A</given-names></name></person-group><article-title>Old and new scales for assessment of body image</article-title><source>Percept Mot Skills</source><year>2000</year><volume>90</volume><fpage>930</fpage><pub-id pub-id-type="pmid">10883782</pub-id><pub-id pub-id-type="doi">10.2466/PMS.90.3.930-930</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McElhone</surname><given-names>S</given-names></name><name><surname>Kearney</surname><given-names>JM</given-names></name><name><surname>Giachetti</su