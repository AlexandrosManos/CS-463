d-type="doi">10.1046/j.1365-2796.2003.01218.x</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Carlh&#x000e4;ll</surname><given-names>C</given-names></name><name><surname>Hatle</surname><given-names>L</given-names></name><name><surname>Nylander</surname><given-names>E</given-names></name></person-group><article-title>A novel method to assess systolic ventricular function using atrioventricular plane displacement &#x02013; a study in young healthy males and patients with heart disease</article-title><source>Clin Physiol Funct Imaging</source><year>2004</year><volume>24</volume><fpage>190</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">15233832</pub-id><pub-id pub-id-type="doi">10.1111/j.1475-097X.2004.00547.x</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mele</surname><given-names>D</given-names></name><name><surname>Pedini</surname><given-names>I</given-names></name><name><surname>Alboni</surname><given-names>P</given-names></name><name><surname>Levine</surname><given-names>RA</given-names></name></person-group><article-title>Anatomic M-mode: a new technique for quantitative assessment of left ventricular size and function</article-title><source>Am J Cardiol</source><year>1998</year><volume>81</volume><fpage>82G</fpage><lpage>85G</lpage><pub-id pub-id-type="pmid">9662234</pub-id><pub-id pub-id-type="doi">10.1016/S0002-9149(98)00060-5</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Strotmann</surname><given-names>JM</given-names></name><name><surname>Kvitting</surname><given-names>J-PE</given-names></name><name><surname>Wilkenshoff</surname><given-names>UM</given-names></name><name><surname>Wranne</surname><given-names>B</given-names></name><name><surname>Hatle</surname><given-names>L</given-names></name><name><surname>Suther