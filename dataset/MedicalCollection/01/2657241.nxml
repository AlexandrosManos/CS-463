<!DOCTYPE article PUBLIC "-//NLM//DTD JATS (Z39.96) Journal Archiving and Interchange DTD v1.0 20120330//EN" "JATS-archivearticle1.dtd"><article xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Int J Emerg Med</journal-id><journal-title-group><journal-title>International Journal of Emergency Medicine</journal-title></journal-title-group><issn pub-type="ppub">1865-1372</issn><issn pub-type="epub">1865-1380</issn><publisher><publisher-name>Springer-Verlag</publisher-name><publisher-loc>London</publisher-loc></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">19384668</article-id><article-id pub-id-type="pmc">2657241</article-id><article-id pub-id-type="publisher-id">25</article-id><article-id pub-id-type="doi">10.1007/s12245-008-0025-3</article-id><article-categories><subj-group subj-group-type="heading"><subject>Clinical Images</subject></subj-group></article-categories><title-group><article-title>Pneumoencephalus after one missed step</article-title></title-group><contrib-group><contrib contrib-type="author" corresp="yes"><name><surname>Cabrera</surname><given-names>Daniel</given-names></name><address><phone>+1-507-2842511</phone><email>cabrera.daniel@mayo.edu</email></address><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Gilmore</surname><given-names>Rachel</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Klocke</surname><given-names>David L.</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><aff id="Aff1"><label>1</label>Department of Emergency Medicine, Mayo Clinic College of Medicine, Rochester, MN USA </aff><aff id="Aff2"><label>2</label>Department of Medicine, Mayo Clinic College of Medicine, Rochester, MN USA </aff><aff id="Aff3"><label>3</label>200 First Street SW, Rochester, MN 55901 USA </aff></contrib-group><pub-date pub-type="epub"><day>29</day><month>5</month><year>2008</year></pub-date><pub-date pub-type="pmc-release"><day>29</day><month>5</month><year>2008</year></pub-date><pub-date pub-type="collection"><month>6</month><year>2008</year></pub-date><volume>1</volume><issue>2</issue><fpage>145</fpage><lpage>145</lpage><history><date date-type="received"><day>28</day><month>12</month><year>2007</year></date><date date-type="accepted"><day>31</day><month>3</month><year>2008</year></date></history><permissions><copyright-statement>&#x000a9; Springer-Verlag London Ltd 2008</copyright-statement></permissions><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; Springer-Verlag London Ltd 2008</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Case</title><p>An 82-year-old female sustained a ground level fall after missing a single step while Christmas shopping. She arrived at the emergency department with stable vital signs, but with massive facial bleeding threatening her airway. We proceeded with emergent nasal packing and endotracheal intubation. CT of head and face revealed massive pneumoencephalus (Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>) secondary to complete disruption of the facial complex from the cranium, consistent with LeFort I, II and III fractures (Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>). The patient was taken to surgery and subsequently extubated on day 2 without neurological deficit.<fig id="Fig1"><label>Fig.&#x000a0;1</label><caption><p>CT of head and face revealed massive pneumoencephalus</p></caption><graphic xlink:href="12245_2008_25_Fig1_HTML" id="MO1"/></fig><fig id="Fig2"><label>Fig.&#x000a0;2</label><caption><p>Complete disruption of the facial complex from the cranium, consistent with LeFort I, II and III fractures</p></caption><graphic xlink:href="12245_2008_25_Fig2_HTML" id="MO2"/></fig></p></sec></body></article>