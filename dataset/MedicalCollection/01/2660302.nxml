id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kawichai</surname><given-names>S</given-names></name><name><surname>Beyrer</surname><given-names>C</given-names></name><name><surname>Khamboonruand</surname><given-names>C</given-names></name><name><surname>Celentanod</surname><given-names>D</given-names></name><name><surname>Natpratan</surname><given-names>C</given-names></name><name><surname>Rungruengthanakit</surname><given-names>K</given-names></name><name><surname>Nelsonk</surname><given-names>E</given-names></name></person-group><article-title>HIV incidence and risk behaviors after voluntary HIV counseling and testing(VCT) among adults aged 19&#x02013;35 years living in peri urban communities around Chiang Mai city in northern Thailand</article-title><source>AIDS Care</source><year>2004</year><volume>16</volume><fpage>21</fpage><lpage>35</lpage><pub-id pub-id-type="pmid">14660141</pub-id><pub-id pub-id-type="doi">10.1080/09540120310001633949</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Jereni1</surname><given-names>BwanaliH</given-names></name><name><surname>Muula</surname><given-names>AdamsonS</given-names></name></person-group><article-title>Availability of supplies and motivations for accessing voluntary HIV counseling and testing services in Blantyre, Malawi</article-title><source>BMC Health Serv Res</source><year>2008</year><volume>8</volume><fpage>17</fpage><pub-id pub-id-type="pmid">18215263</pub-id><pub-id pub-id-type="doi">10.1186/1472-6963-8-17</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Weiser</surname><given-names>SD</given-names></name><name><surname>Heisler</surname><given-names>M</given-names></name><name><surname>Leiter</surname><given-names>K</given-names></name><name><surname>Percy-de Korte</surname><give