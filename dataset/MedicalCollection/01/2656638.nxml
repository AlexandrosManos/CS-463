-loc>University of Copenhagen</publisher-loc><publisher-name>Museum Tusculanum Press</publisher-name></citation></ref><ref id="pone.0005023-Ramachandran1"><label>23</label><citation citation-type="other"><person-group person-group-type="author"><name><surname>Ramachandran</surname><given-names>VS</given-names></name><name><surname>Hirstein</surname><given-names>W</given-names></name></person-group><year>1999</year><comment>The Science of Art. J. Consciousness Stud. 6</comment></citation></ref><ref id="pone.0005023-CalvoMerino2"><label>24</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Calvo-Merino</surname><given-names>B</given-names></name><name><surname>Grezes</surname><given-names>J</given-names></name><name><surname>Glaser</surname><given-names>DE</given-names></name><name><surname>Passingham</surname><given-names>RE</given-names></name><name><surname>Haggard</surname><given-names>P</given-names></name></person-group><year>2006</year><article-title>Seeing or doing? Influence of visual and motor familiarity in action observation.</article-title><source>Curr Biol</source><volume>16</volume><fpage>1905</fpage><lpage>10</lpage><pub-id pub-id-type="pmid">17027486</pub-id></citation></ref><ref id="pone.0005023-Gallese1"><label>25</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gallese</surname><given-names>V</given-names></name><name><surname>Freedberg</surname><given-names>D</given-names></name></person-group><year>2007</year><article-title>Motion, emotion and empathy in aesthetic experience.</article-title><source>Trends Cogn Sci</source><volume>11</volume><fpage>197</fpage><lpage>203</lpage><pub-id pub-id-type="pmid">17347026</pub-id></citation></ref><ref id="pone.0005023-Gombrich1"><label>26</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Gombrich</surname><given-names>EH</given-names></name></person-group><year>1950</year><source>The story of art</source><publisher-loc>London</publisher-loc><publisher-name>Phaidon Press (ed. 16, 1995)</publisher-name></citation></ref><ref id="pone.0005023-Dawkins1"><label>27</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Dawkins</surname><given-names>R</given-names></name></person-group><year>1976</year><source>The Selfish Gene</source><publisher-loc>USA</publisher-loc><publisher-name>Oxford University Press</publisher-name></citation></ref><ref id="pone.0005023-Clark1"><label>28</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Clark</surname><given-names>HH</given-names></name></person-group><year>1973</year><article-title>The language-as-fixed effect fallacy: A critique of language statistics in psychological research.</article-title><source>J Verbal Learn Verbal Behav</source><volume>12</volume><fpage>335</fpage><lpage>59</lpage></citation></ref></ref-list><fn-group><fn fn-type="conflict"><p><bold>Competing Interests: </bold>The authors have declared that no competing interests exist.</p></fn><fn fn-type="financial-disclosure"><p><bold>Funding: </bold>This research was funded by a Leverhulme Trust project grant, and a BBSRC ISIS grant awarded to PH. The funders had no role in study design, data collection and analysis, decision to publish, or preparation of the manuscript.</p></fn></fn-group></back></article>