xford University Press</publisher-name></citation></ref><ref id="B26"><citation citation-type="book"><person-group person-group-type="author"><collab>World Health Organization</collab></person-group><source>The world health report 2000 &#x02013; Health systems: improving performance</source><publisher-name>Geneva: World Health Organization</publisher-name></citation></ref><ref id="B27"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Satpathy</surname><given-names>SK</given-names></name><name><surname>Venkatesh</surname><given-names>S</given-names></name></person-group><article-title>Human Resources for Health in India's National Rural Health Mission: Dimension and Challenges</article-title><source>Regional Health Forum</source><year>2006</year><volume>10</volume><fpage>29</fpage><lpage>37</lpage></citation></ref><ref id="B28"><citation citation-type="book"><person-group person-group-type="author"><collab>Ministry of Health &#x00026; Family Welfare, Infrastructure Division</collab></person-group><source>Bulletin on Rural Health Statistics in India</source><year>2006</year><publisher-name>New Delhi: Government of India</publisher-name></citation></ref><ref id="B29"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mullan</surname><given-names>F</given-names></name></person-group><article-title>The metrics of the physician brain drain</article-title><source>N Engl J Med</source><year>2005</year><volume>353</volume><fpage>1810</fpage><lpage>1818</lpage><pub-id pub-id-type="pmid">16251537</pub-id><pub-id pub-id-type="doi">10.1056/NEJMsa050004</pub-id></citation></ref><ref id="B30"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Solheim</surname><given-names>K</given-names></name><name><surname>Marks</surname><given-names>B</given-names></name></person-group><source>Feasibility study report: Advancing nursing education at Bel-air hospital. Chicago: The 