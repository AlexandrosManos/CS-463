<pub-id pub-id-type="pmid">16282492</pub-id></citation></ref><ref id="pone.0004857-Snelgrove1"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Snelgrove</surname><given-names>RJ</given-names></name><name><surname>Goulding</surname><given-names>J</given-names></name><name><surname>Didierlaurent</surname><given-names>AM</given-names></name><name><surname>Lyonga</surname><given-names>D</given-names></name><name><surname>Vekaria</surname><given-names>S</given-names></name><etal/></person-group><year>2008</year><article-title>A critical function for CD200 in lung immune homeostasis and the severity of influenza infection.</article-title><source>Nat Immunol</source><volume>9</volume><fpage>1074</fpage><lpage>1083</lpage><pub-id pub-id-type="pmid">18660812</pub-id></citation></ref><ref id="pone.0004857-GeurtsvanKessel1"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>GeurtsvanKessel</surname><given-names>CH</given-names></name><name><surname>Willart</surname><given-names>MA</given-names></name><name><surname>van Rijt</surname><given-names>LS</given-names></name><name><surname>Muskens</surname><given-names>F</given-names></name><name><surname>Kool</surname><given-names>M</given-names></name><etal/></person-group><year>2008</year><article-title>Clearance of influenza virus from the lung depends on migratory langerin&#x0002b;CD11b- but not plasmacytoid dendritic cells.</article-title><source>J Exp Med</source><volume>205</volume><fpage>1621</fpage><lpage>1634</lpage><pub-id pub-id-type="pmid">18591406</pub-id></citation></ref><ref id="pone.0004857-McGill1"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McGill</surname><given-names>J</given-names></name><name><surname>Van Rooijen</surname><given-names>N</given-names></name><name><surname>Legge</surname><given-names>KL</given-names></name></person-group