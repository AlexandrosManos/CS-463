<lpage>3482</lpage><!--PubMed citation query: 'J Clin Endocrinol Metab||92|3476||bib10|'--><pub-id pub-id-type="pmid">17579201</pub-id></citation></ref><ref id="bib11"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hagemeister</surname><given-names>FB</given-names></name><name><surname>Tannir</surname><given-names>N</given-names></name><name><surname>McLaughlin</surname><given-names>P</given-names></name><name><surname>Salvador</surname><given-names>P</given-names></name><name><surname>Riggs</surname><given-names>S</given-names></name><name><surname>Velasquez</surname><given-names>WS</given-names></name><name><surname>Cabanillas</surname><given-names>F</given-names></name></person-group><article-title>MIME chemotherapy (methyl-GAG, ifosfamide, methotrexate, etoposide) as treatment for recurrent Hodgkin's disease</article-title><source>J Clin Oncol</source><year>1987</year><volume>5</volume><fpage>556</fpage><lpage>561</lpage><!--PubMed citation query: 'J Clin Oncol||5|556||bib11|'--><pub-id pub-id-type="pmid">3559649</pub-id></citation></ref><ref id="bib12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hollender</surname><given-names>A</given-names></name><name><surname>Kvaloy</surname><given-names>S</given-names></name><name><surname>Lote</surname><given-names>K</given-names></name><name><surname>Nome</surname><given-names>O</given-names></name><name><surname>Holte</surname><given-names>H</given-names></name></person-group><article-title>Prognostic factors in 140 adult patients with non-Hodgkin's lymphoma with systemic central nervous system (CNS) involvement. A single centre analysis</article-title><source>Eur J Cancer</source><year>2000</year><volume>36</volume><fpage>1762</fpage><lpage>1768</lpage><!--PubMed citation query: 'Eur J Cancer||36|1762||bib12|'--><pub-id pub-id-type="pmid">10974623</pub-id></citation></ref><ref id="bib13"><citation citation-type="journal"><person-gr