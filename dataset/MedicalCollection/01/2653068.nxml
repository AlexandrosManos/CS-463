d><pub-id pub-id-type="doi">10.1186/1475-2875-6-170</pub-id></citation></ref><ref id="B13"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Akogbeto</surname><given-names>M</given-names></name></person-group><article-title>Etude des aspects &#x000e9;pid&#x000e9;miologiques du paludisme c&#x000f4;tier lagunaire au B&#x000e9;nin</article-title><source>Th&#x000e8;se de Doctorat &#x000e8;s-Science</source><year>1992</year><publisher-name>Universit&#x000e9; de Paris XI</publisher-name></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Akogbeto</surname><given-names>M</given-names></name><name><surname>Modiano</surname><given-names>D</given-names></name><name><surname>Bosman</surname><given-names>A</given-names></name></person-group><article-title>Malaria transmission in the lagoon area of Cotonou, Benin</article-title><source>Parassitologia</source><year>1992</year><volume>34</volume><fpage>147</fpage><lpage>154</lpage><pub-id pub-id-type="pmid">1339969</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>N'Guessan</surname><given-names>R</given-names></name><name><surname>Corbel</surname><given-names>V</given-names></name><name><surname>Akogb&#x000e9;to</surname><given-names>M</given-names></name><name><surname>Rowland</surname><given-names>M</given-names></name></person-group><article-title>Reduced efficacy of insecticide-treated nets and indoor residual spraying for malaria control in pyrethroid resistance area, Benin</article-title><source>Emerg Infect Dis</source><year>2007</year><volume>13</volume><fpage>199</fpage><lpage>206</lpage><pub-id pub-id-type="pmid">17479880</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><collab>World Health Organization</collab></person-group><article-title>Severe falciparum malaria</article-title><source>Trans R Soc Trop Med Hyg</source><year>2000</year><volume>94</volume><fpage>1</fpage><lpage>90</lpage><pub-id pub-id-type="pmid">10748883</pub-id><pub-id pub-id-type="doi">10.1016/S0035-9203(00)90300-6</pub-id></citation></ref><ref id="B17"><citation citation-type="book"><person-group person-group-type="author"><collab>World Health Organization</collab></person-group><source>Assessment and monitoring of antimalarial drug efficay for the treatment of uncomplicated falciparum malaria</source><year>2003</year><publisher-name>Geneva; World Health Organization</publisher-name></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Plowe</surname><given-names>CV</given-names></name><name><surname>Djimde</surname><given-names>A</given-names></name><name><surname>Bouare</surname><given-names>M</given-names></name><name><surname>Doumbo</surname><given-names>O</given-names></name><name><surname>Wellems</surname><given-names>TE</given-names></name></person-group><article-title>Pyrimethamine and proguanil resistance-conferring mutations in <italic>Plasmodium falciparum </italic>dihydrofolate reductase: polymerase chain reaction methods for surveillance in Africa</article-title><source>Am J Trop Med Hyg</source><year>1995</year><volume>52</volume><fpage>565</fpage><lpage>568</lpage><pub-id pub-id-type="pmid">7611566</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ranford-Cartwright</surname><given-names>LC</given-names></name><name><surname>Balfe</surname><given-names>P</given-names></name><name><surname>Carter</surname><given-names>R</given-names></name><name><surname>Walliker</surname><given-names>D</given-names></name></person-group><article-title>Frequency of cross-fertilization in the human malaria parasite <italic>Plasmodium falciparum</italic></article-title><source>Parasitology</source><year>1993</year><volume>10