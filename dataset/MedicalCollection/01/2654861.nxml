">9822923</pub-id><pub-id pub-id-type="doi">10.1046/j.1365-2559.1998.00486.x</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Haugen</surname><given-names>BR</given-names></name><name><surname>Larson</surname><given-names>LL</given-names></name><name><surname>Pugazhenthi</surname><given-names>U</given-names></name><name><surname>Hays</surname><given-names>WR</given-names></name><name><surname>Klopper</surname><given-names>JP</given-names></name><name><surname>Kramer</surname><given-names>CA</given-names></name><etal></etal></person-group><article-title>Retinoic acid and retinoid &#x000d7; receptors are differentially expressed in thyroid cancer and thyroid carcinoma cell lines and predict response to treatment with retinoids</article-title><source>J Clin Endocrinol Metab</source><year>2004</year><volume>89</volume><fpage>272</fpage><lpage>280</lpage><pub-id pub-id-type="pmid">14715861</pub-id><pub-id pub-id-type="doi">10.1210/jc.2003-030770</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Klopper</surname><given-names>JP</given-names></name><name><surname>Hays</surname><given-names>WR</given-names></name><name><surname>Sharma</surname><given-names>V</given-names></name><name><surname>Baumbusch</surname><given-names>MA</given-names></name><name><surname>Hershman</surname><given-names>JM</given-names></name><name><surname>Haugen</surname><given-names>BR</given-names></name></person-group><article-title>Retinoid &#x000d7; receptor-gamma and peroxisome proliferator-activated receptor-gamma expression predicts thyroid carcinoma cell response to retinoid and thiazolidinedione treatment</article-title><source>Mol Cancer Ther</source><year>2004</year><volume>3</volume><fpage>1011</fpage><lpage>1020</lpage><pub-id pub-id-type="pmid">15299084</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person