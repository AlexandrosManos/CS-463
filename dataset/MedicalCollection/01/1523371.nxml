<name><surname>Maurice</surname><given-names>YM</given-names></name><name><surname>Lipton</surname><given-names>ME</given-names></name><name><surname>Berstock</surname><given-names>D</given-names></name><name><surname>Jones</surname><given-names>IR</given-names></name></person-group><article-title>Peliosis of the spleen with massive recurrent haemorrhagic ascites, despite splenectomy, and associated with elevated levels of vascular endothelial growth factor</article-title><source>Eur J Gastroenterol Hepatol</source><year>2004</year><volume>16</volume><fpage>1401</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">15618852</pub-id><pub-id pub-id-type="doi">10.1097/00042737-200412000-00027</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Celebrezze</surname><given-names>JP</given-names><suffix>Jr</suffix></name><name><surname>Cottrell</surname><given-names>DJ</given-names></name><name><surname>Williams</surname><given-names>GB</given-names></name></person-group><article-title>Spontaneous splenic rupture due to isolated splenic peliosis</article-title><source>South Med J</source><year>1998</year><volume>91</volume><fpage>763</fpage><lpage>4</lpage><pub-id pub-id-type="pmid">9715226</pub-id></citation></ref><ref id="B13"><citation citation-type="other"><source>Med Pathol</source><year>2004</year><volume>25</volume><fpage>251</fpage><lpage>4</lpage></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gabor</surname><given-names>S</given-names></name><name><surname>Back</surname><given-names>F</given-names></name><name><surname>Csiffary</surname><given-names>D</given-names></name></person-group><article-title>Peliosis Lienis: Uncommon Cause of Rupture of the Spleen</article-title><source>Path Res Pract</source><year>1992</year><volume>188</volume><fpage>380</fpage><lpage>2</lpage><comment>discussion 382-3</comment><pub-id pub-id-type="pmid">1626002</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kohr</surname><given-names>RM</given-names></name><name><surname>Haendiges</surname><given-names>M</given-names></name><name><surname>Taube</surname><given-names>RR</given-names></name></person-group><article-title>Peliosis of the Spleen: A Rare Cause of Spontaneous Splenic Rupture with Surgical Implications</article-title><source>Am Surg</source><year>1993</year><volume>59</volume><fpage>197</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">8476160</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Katkhouda</surname><given-names>N</given-names></name><name><surname>Mavor</surname><given-names>E</given-names></name></person-group><article-title>Laparoscopic Splenectomy</article-title><source>Surg Clin North Am</source><year>2000</year><volume>80</volume><fpage>1285</fpage><lpage>97</lpage><pub-id pub-id-type="pmid">10987036</pub-id><pub-id pub-id-type="doi">10.1016/S0039-6109(05)70225-5</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zia</surname><given-names>H</given-names></name><name><surname>Zemon</surname><given-names>H</given-names></name><name><surname>Brody</surname><given-names>F</given-names></name></person-group><article-title>Laparoscopic splenectomy for isolated sarcoidosis of the spleen</article-title><source>J Laparoendosc Adv Surg Tech A</source><year>2005</year><volume>15</volume><fpage>160</fpage><lpage>2</lpage><pub-id pub-id-type="pmid">15898908</pub-id><pub-id pub-id-type="doi">10.1089/lap.2005.15.160</pub-id></citation></ref></ref-list><sec sec-type="display-objects"><title>Figures and Tables</title><fig position="float" id="F1"><label>Figure 1</label><caption><p>Case 1. Contrast-enhanced CT (CECT) demonstrates a splenic laceration extending to the splenic surface from a focal hypodense cyst-like lesion. There is a large perisplenic haematoma and abdominal free fluid.</p></caption><graphic xlink:href="1471-2482-6-9-1"/></fig><fig position="float" id="F2"><label>Figure 2</label><caption><p>Case 1. Splenic vessels course through the cyst-like lesions of the splenic parenchyma without mass effect. The lesions show areas of contrast enhancement on the portal venous phase of CECT.</p></caption><graphic xlink:href="1471-2482-6-9-2"/></fig><fig position="float" id="F3"><label>Figure 3</label><caption><p>Case 1. CECT identified a 1.5 cm lesion of low attenuation in the dome of the right lobe of the liver (arrow). The lesion demonstrates nodular peripheral enhancement on the portal venous phase.</p></caption><graphic xlink:href="1471-2482-6-9-3"/></fig><fig position="float" id="F4"><label>Figure 4</label><caption><p>Case 2. CECT shows a laceration through the anterosuperior portion of the spleen with perisplenic haematoma and abdominal free fluid.</p></caption><graphic xlink:href="1471-2482-6-9-4"/></fig><fig position="float" id="F5"><label>Figure 5</label><caption><p>Case 2. Areas of contrast enhancement are seen more inferiorly in the spleen on CECT. These lie adjacent to a hypodense cyst-like lesion and further lacerations. The splenic capsule is disrupted anteriorly.</p></caption><graphic xlink:href="1471-2482-6-9-5"/></fig><fig position="float" id="F6"><label>Figure 6</label><caption><p>Case 1. Low power section demonstrating unlined, blood-filled spaces.</p></caption><graphic xlink:href="1471-2482-6-9-6"/></fig><fig position="float" id="F7"><label>Figure 7</label><caption><p>Case 1. High power section demonstrating unlined, blood-filled spaces.</p></caption><graphic xlink:href="1471-2482-6-9-7"/></fig><fig position="float" id="F8"><label>Figure 8</label><caption><p>Case 1. Warthin-Finkeldey cells.</p></caption><graphic xlink:href="1471-2482-6-9-8"/></fig><fig position="float" id="F9"><label>Figure 9</label><caption><p>Case 2. Sectioned spleen showing multiple blood-filled spaces throughout the parenchyma.</p></caption><graphic xlink:href="1471-2482-6-9-9"/></fig><fig position="float" id="F10"><label>Figure 10</label><caption><p>Case 2. Low power section demonstrating unlined, blood-filled spaces.</p></caption><graphic xlink:href="1471-2482-6-9-10"/></fig><fig position="float" id="F11"><label>Figure 11</label><caption><p>Case 2. High power section demonstrating unlined, blood-filled spaces.</p></caption><graphic xlink:href="1471-2482-6-9-11"/></fig></sec></back></article>