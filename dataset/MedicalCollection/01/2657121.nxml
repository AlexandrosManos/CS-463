f><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Evans</surname><given-names>BJ</given-names></name><name><surname>Supriatna</surname><given-names>J</given-names></name><name><surname>Melnick</surname><given-names>DJ</given-names></name></person-group><article-title>Hybridization and population genetics of two macaque species in Sulawesi, Indonesia</article-title><source>Evolution</source><year>2001</year><volume>55</volume><fpage>1686</fpage><lpage>1702</lpage><pub-id pub-id-type="pmid">11580028</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cort&#x000e9;s-Ortiz</surname><given-names>L</given-names></name><name><surname>Duda</surname><given-names>TF</given-names><suffix>Jr</suffix></name><name><surname>Canales-Espinosa</surname><given-names>D</given-names></name><name><surname>Garcia-Orduna</surname><given-names>F</given-names></name><name><surname>Rodriguez-Luna</surname><given-names>E</given-names></name><name><surname>Bermingham</surname><given-names>E</given-names></name></person-group><article-title>Hybridization in large-bodied New World primates</article-title><source>Genetics</source><year>2007</year><volume>176</volume><fpage>2421</fpage><lpage>2425</lpage><pub-id pub-id-type="pmid">17603105</pub-id><pub-id pub-id-type="doi">10.1534/genetics.107.074278</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rabarivola</surname><given-names>C</given-names></name><name><surname>Meyers</surname><given-names>D</given-names></name><name><surname>Rumpler</surname><given-names>Y</given-names></name></person-group><article-title>Distribution and morphological character of inermediate forms between the black lemur (<italic>Eulemur macaco macaco</italic>) and the sclater's lemur (<italic>E. m. flavifrons</italic>)</article-title><source>Primates</source><yea