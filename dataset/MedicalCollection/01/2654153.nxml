e><surname>Scholl</surname><given-names>D</given-names></name><name><surname>Adhya</surname><given-names>SL</given-names></name></person-group><year>2003</year><article-title>The prospect for bacteriophage therapy in Western medicine.</article-title><source>Nat Rev Drug Discov</source><volume>2</volume><fpage>489</fpage><lpage>497</lpage><pub-id pub-id-type="pmid">12776223</pub-id></citation></ref><ref id="pone.0004944-Sulakvelidze1"><label>11</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Sulakvelidze</surname><given-names>A</given-names></name><name><surname>Kutter</surname><given-names>E</given-names></name></person-group><year>2005</year><article-title>Bacteriophage therapy in humans.</article-title><person-group person-group-type="editor"><name><surname>Kutter</surname><given-names>E</given-names></name><name><surname>Sulakvelidze</surname><given-names>A</given-names></name></person-group><source>Bacteriophages: Biology and Applications</source><publisher-loc>Boca Raton</publisher-loc><publisher-name>CRC Press</publisher-name><fpage>381</fpage><lpage>436</lpage></citation></ref><ref id="pone.0004944-Calendar1"><label>12</label><citation citation-type="book"><person-group person-group-type="editor"><name><surname>Calendar</surname><given-names>R</given-names></name><name><surname>Abedon</surname><given-names>S</given-names></name></person-group><year>2006</year><source>The bacteriophages</source><publisher-loc>Oxford</publisher-loc><publisher-name>Oxford Univ Press</publisher-name><fpage>746p</fpage></citation></ref><ref id="pone.0004944-Villareal1"><label>13</label><citation citation-type="book"><person-group person-group-type="author"><name><surname>Villareal</surname><given-names>LP</given-names></name></person-group><year>2005</year><article-title>Overall issues of virus and host evolution.</article-title><person-group person-group-type="editor"><name><surname>Villareal</surname><given-names>LP</given-names></na