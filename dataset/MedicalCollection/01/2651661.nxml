/given-names></name>; <name><surname>King</surname><given-names>M. A.</given-names></name> <source>J. Phys. Chem. B</source> <year>2003</year>, <volume>107</volume>, 13703&#x02013;13710.</mixed-citation></ref><ref id="ref6"><mixed-citation id="cit6" publication-type="journal"><name><surname>Hamelberg</surname><given-names>D.</given-names></name>; <name><surname>Mongan</surname><given-names>J.</given-names></name>; <name><surname>McCammon</surname><given-names>J. A.</given-names></name> <source>J. Chem. Phys.</source> <year>2004</year>, <volume>120</volume>, 11919&#x02013;11929.<pub-id pub-id-type="pmid">15268227</pub-id></mixed-citation></ref><ref id="ref7"><mixed-citation id="cit7" publication-type="journal"><name><surname>Markwick</surname><given-names>P. R. L.</given-names></name>; <name><surname>Bouvignies</surname><given-names>G.</given-names></name>; <name><surname>Blackledge</surname><given-names>M.</given-names></name> <source>J. Am. Chem. Soc.</source> <year>2007</year>, <volume>129</volume>, 4724&#x02013;4730.<pub-id pub-id-type="pmid">17375925</pub-id></mixed-citation></ref><ref id="ref8"><mixed-citation id="cit8" publication-type="journal"><name><surname>Shen</surname><given-names>T.</given-names></name>; <name><surname>Hamelberg</surname><given-names>D.</given-names></name> <source>J. Chem. Phys.</source> <year>2008</year>, <volume>129</volume>, 034103.<pub-id pub-id-type="pmid">18647012</pub-id></mixed-citation></ref><ref id="ref9"><mixed-citation id="cit9" publication-type="journal"><name><surname>Xu</surname><given-names>C.</given-names></name>; <name><surname>Wang</surname><given-names>J.</given-names></name>; <name><surname>Liu</surname><given-names>H.</given-names></name> <source>J. Chem. Theory Comput.</source> <year>2008</year>, <volume>4</volume>, 1348&#x02013;1359.</mixed-citation></ref><ref id="ref10"><mixed-citation id="cit10" publication-type="journal"><name><surname>Hamelberg</surname><given-names>D.</given-names></name>; <name><surname>de Oliveira</surname><given-names>C. A. F.</given-names></name>; <name><surname>McCammon</surname><given-names>J. A.</given-names></name> <source>J. Chem. Phys.</source> <year>2007</year>, <volume>127</volume>, 155102.<pub-id pub-id-type="pmid">17949218</pub-id></mixed-citation></ref><ref id="ref11"><mixed-citation id="cit11" publication-type="journal"><name><surname>Abraham</surname><given-names>M. J.</given-names></name>; <name><surname>Gready</surname><given-names>J. E.</given-names></name> <source>J. Chem. Theory Comput.</source> <year>2008</year>, <volume>4</volume>, 1119&#x02013;1128.</mixed-citation></ref><ref id="ref12"><mixed-citation id="cit12" publication-type="journal"><name><surname>Pearlman</surname><given-names>D. A.</given-names></name>; <name><surname>Case</surname><given-names>D. A.</given-names></name>; <name><surname>Caldwell</surname><given-names>J. W.</given-names></name>; <name><surname>Ross</surname><given-names>W. S.</given-names></name>; <name><surname>Cheatham</surname><given-names>T. E.</given-names></name>; <name><surname>DeBolt</surname><given-names>S.</given-names></name>; <name><surname>Ferguson</surname><given-names>D.</given-names></name>; <name><surname>Seibel</surname><given-names>G.</given-names></name>; <name><surname>Kollman</surname><given-names>P.</given-names></name> <source>Comput. Phys. Commun.</source> <year>1995</year>, <volume>91</volume>, 1&#x02013;41.</mixed-citation></ref></ref-list></back></article>