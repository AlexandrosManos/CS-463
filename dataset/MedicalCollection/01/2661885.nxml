nal Center for Health Statistics</collab></person-group><article-title>Third National Health and Nutrition Examination Survey, 1988&#x02013;1994, NHANES III reference manuals and reports</article-title><source>Public use data files Centers for Disease Control and Prevention Home Page</source><year>1996</year><ext-link ext-link-type="uri" xlink:href="http://www.cdc.gov/nchs/about/major/nhanes/nh3rrm.htm"/><comment>Accessed on 2/7/05</comment></citation></ref><ref id="B17"><citation citation-type="other"><person-group person-group-type="author"><collab>National Center for Health Statistics</collab></person-group><article-title>Third National Health and Nutrition Examination Survey, 1988&#x02013;1994; NHANES III examination data file</article-title><source>Public use data files Centers for Disease Control and Prevention Home Page</source><year>1996</year><ext-link ext-link-type="uri" xlink:href="ftp://ftp.cdc.gov/pub/Health_Statistics/NCHS/Datasets/NHANES/NHANESIII/1A/exam.dat"/><comment>Accessed on 2/7/05</comment></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Frohlich</surname><given-names>ED</given-names></name></person-group><article-title>Recommendations for blood pressure determination by sphygmomanometry</article-title><source>Ann Intern Med 1988, 109:612</source><year>1988</year><volume>109</volume><fpage>612</fpage></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><collab>Agriculture Research Service</collab></person-group><source>Survey nutrient data bases for NHANES III, Phase 1 and Phase 2</source><publisher-name>U.S. Department of Agriculture, Riverdale, MD</publisher-name></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ford</surname><given-names>ES</given-names></name><name><surname>Liu</surname><given-names>S</given-names></name></person-group><article-title