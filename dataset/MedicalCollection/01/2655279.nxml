<year>2008</year><volume>18</volume><fpage>77</fpage><lpage>80</lpage><pub-id pub-id-type="pmid">18306441</pub-id><pub-id pub-id-type="doi">10.1002/rmv.562</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Tondella</surname><given-names>ML</given-names></name><name><surname>Talkington</surname><given-names>DF</given-names></name><name><surname>Holloway</surname><given-names>BP</given-names></name><name><surname>Dowell</surname><given-names>SF</given-names></name><name><surname>Cowley</surname><given-names>K</given-names></name><name><surname>Soriano-Gabarro</surname><given-names>M</given-names></name><name><surname>Elkind</surname><given-names>MS</given-names></name><name><surname>Fields</surname><given-names>BS</given-names></name></person-group><article-title>Development and evaluation of real-time PCR-based fluorescence assays for detection of Chlamydia pneumoniae</article-title><source>J Clin Microbiol</source><year>2002</year><volume>40</volume><fpage>575</fpage><lpage>583</lpage><pub-id pub-id-type="pmid">11825973</pub-id><pub-id pub-id-type="doi">10.1128/JCM.40.2.575-583.2002</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Ursi</surname><given-names>D</given-names></name><name><surname>Dirven</surname><given-names>K</given-names></name><name><surname>Loens</surname><given-names>K</given-names></name><name><surname>Ieven</surname><given-names>M</given-names></name><name><surname>Goossens</surname><given-names>H</given-names></name></person-group><article-title>Detection of <italic>Mycoplasma pneumoniae </italic>in respiratory samples by real-time PCR using an inhibition control</article-title><source>J Microbiol Methods</source><year>2003</year><volume>55</volume><fpage>149</fpage><lpage>153</lpage><pub-id pub-id-type="pmid">14500006</pub-id><pub-id pub-id-type="doi">10.1016/S0167-7012(03)00131-3</pub-i