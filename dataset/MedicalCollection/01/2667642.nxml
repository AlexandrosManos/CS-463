/source><volume>336</volume><fpage>202</fpage><lpage>205</lpage><pub-id pub-id-type="pmid">18199700</pub-id></citation></ref><ref id="pmed.1000063-Bisoffi1"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bisoffi</surname><given-names>Z</given-names></name><name><surname>Van den Ende</surname><given-names>J</given-names></name></person-group><year>2008</year><article-title>Costs of treating malaria according to test results.</article-title><source>BMJ</source><volume>336</volume><fpage>168</fpage><lpage>169</lpage><pub-id pub-id-type="pmid">18199699</pub-id></citation></ref><ref id="pmed.1000063-DAcremont1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>D'Acremont</surname><given-names>V</given-names></name><name><surname>Lengeler</surname><given-names>C</given-names></name><name><surname>Mshinda</surname><given-names>H</given-names></name><name><surname>Mtasiwa</surname><given-names>D</given-names></name><name><surname>Tanner</surname><given-names>M</given-names></name><etal/></person-group><year>2009</year><article-title>Time to move from presumptive malaria treatment to laboratory-confirmed diagnosis and treatment in African children with fever.</article-title><source>PLoS Med</source><volume>6</volume><fpage>e252</fpage><comment>doi:10.1371/journal.pmed.0050252</comment><pub-id pub-id-type="pmid">19127974</pub-id></citation></ref><ref id="pmed.1000063-English1"><label>8</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>English</surname><given-names>M</given-names></name><name><surname>Reyburn</surname><given-names>H</given-names></name><name><surname>Goodman</surname><given-names>C</given-names></name><name><surname>Snow</surname><given-names>RW</given-names></name></person-group><year>2009</year><article-title>Abandoning presumptive antimalarial treatment for febrile children aged less than five years&#x02014;A case of running before we can walk?</article-title><source>PLoS Med</source><volume>6</volume><fpage>e1000015</fpage><comment>doi:10.1371/journal.pmed.1000015</comment><pub-id pub-id-type="pmid">19127977</pub-id></citation></ref><ref id="pmed.1000063-Msellem1"><label>9</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Msellem</surname><given-names>MI</given-names></name><name><surname>M&#x000e5;rtensson</surname><given-names>A</given-names></name><name><surname>Rotllant</surname><given-names>G</given-names></name><name><surname>Bhattarai</surname><given-names>A</given-names></name><name><surname>Str&#x000f6;mberg</surname><given-names>J</given-names></name><etal/></person-group><year>2009</year><article-title>Influence of rapid malaria diagnostic tests on treatment and health outcome in fever patients, Zanzibar&#x02014;A crossover validation study.</article-title><source>PLoS Med</source><volume>6</volume><fpage>e1000070</fpage><comment>doi:10.1371/journal.pmed.1000070</comment><pub-id pub-id-type="pmid">19399156</pub-id></citation></ref><ref id="pmed.1000063-Zurovac1"><label>10</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zurovac</surname><given-names>D</given-names></name><name><surname>Njogu</surname><given-names>J</given-names></name><name><surname>Akhwale</surname><given-names>W</given-names></name><name><surname>Hamer</surname><given-names>DH</given-names></name><name><surname>Larson</surname><given-names>BA</given-names></name><etal/></person-group><year>2008</year><article-title>Effects of revised diagnostic recommendations on malaria treatment practices across age groups in Kenya.</article-title><source>Trop Med Int Health</source><volume>13</volume><fpage>784</fpage><lpage>787</lpage><pub-id pub-id-type="pmid">18482078</pub-id></citation></ref><ref id="pmed.1000063-Bisoffi2"><label>11</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bisoffi</surname><given-names>Z</given-names></name><name><surname>Sirima</surname><given-names>BS</given-names></name><name><surname>Angheben</surname><given-names>A</given-names></name><name><surname>Lodesani</surname><given-names>C</given-names></name><name><surname>Gobbi</surname><given-names>F</given-names></name><etal/></person-group><year>2009</year><article-title>Rapid malaria diagnostic tests versus clinical management of malaria in rural Burkina Faso: Safety and effect on clinical decisions. A randomized trial.</article-title><source>Trop Med Int Health</source><comment>E-pub 14 February 2009</comment></citation></ref><ref id="pmed.1000063-Bhattarai1"><label>12</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bhattarai</surname><given-names>A</given-names></name><name><surname>Ali</surname><given-names>AS</given-names></name><name><surname>Kachur</surname><given-names>SP</given-names></name><name><surname>M&#x000e5;rtensson</surname><given-names>A</given-names></name><name><surname>Abbas</surname><given-names>AK</given-names></name><etal/></person-group><year>2007</year><article-title>Impact of artemisinin-based combination therapy and insecticide-treated nets on malaria burden in Zanzibar.</article-title><source>PLoS Med</source><volume>4</volume><fpage>e309</fpage><comment>doi:10.1371/journal.pmed.0040309</comment><pub-id pub-id-type="pmid">17988171</pub-id></citation></ref></ref-list><glossary><title>Abbreviations</title><def-list><def-item><term>ACT</term><def><p>artemisinin-based combination therapy</p></def></def-item><def-item><term>CD</term><def><p>clinical diagnosis</p></def></def-item><def-item><term>RDT</term><def><p>rapid diagnostic test</p></def></def-item></def-list></glossary><fn-group><fn fn-type="conflict"><p>The authors have declared that no competing interests exist.</p></fn><fn fn-type="financial-disclosure"><p>The authors received no financial support for writing this paper.</p></fn><fn fn-type="other"><p><bold>Provenance:</bold> Commissioned; not externally peer reviewed</p></fn></fn-group></back></article>