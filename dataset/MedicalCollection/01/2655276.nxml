ource>2005 Annual Report</source><year>2006</year><publisher-name>Health Mo</publisher-name></citation></ref><ref id="B18"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Ooman</surname><given-names>N</given-names></name><name><surname>Bernstein</surname><given-names>M</given-names></name><name><surname>Rosenzweig</surname><given-names>S</given-names></name></person-group><article-title>Following the Funding for HIV/AIDS</article-title><source>HIV/AIDS Monitor Washington, DC</source><year>2007</year></citation></ref><ref id="B19"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Ooman</surname><given-names>N</given-names></name><name><surname>Bernstein</surname><given-names>M</given-names></name><name><surname>Rosenzweig</surname><given-names>S</given-names></name></person-group><article-title>The Numbers Behind the Stories</article-title><source>HIV/AIDS Monitor</source><year>2008</year><publisher-name>Development CfG ed. Washington, DC</publisher-name></citation></ref><ref id="B20"><citation citation-type="book"><person-group person-group-type="author"><collab>Worldbank</collab></person-group><person-group person-group-type="editor"><name><surname>Bank W</surname></name></person-group><source>ZANARA</source><year>2001</year></citation></ref></ref-list></back></article>