l"><person-group person-group-type="author"><name><surname>Boyd</surname><given-names>O</given-names></name><name><surname>Bennett</surname><given-names>D</given-names></name></person-group><article-title>Enhancement of perioperative tissue perfusion as a therapeutic strategy for major surgery.</article-title><source>New Horiz</source><year>1996</year><volume>4</volume><fpage>453</fpage><lpage>465</lpage><pub-id pub-id-type="pmid">8968978</pub-id></citation></ref><ref id="B31"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Taylor</surname><given-names>RW</given-names><suffix>Jr</suffix></name><name><surname>Calvin</surname><given-names>JE</given-names></name><name><surname>Matuschak</surname><given-names>GM</given-names></name></person-group><article-title>Pulmonary Artery Catheter Consensus Conference: the first step.</article-title><source>Crit Care Med</source><year>1997</year><volume>25</volume><fpage>2060</fpage><lpage>2063</lpage><pub-id pub-id-type="pmid">9403760</pub-id></citation></ref><ref id="B32"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lewis</surname><given-names>FR</given-names></name><name><surname>Elings</surname><given-names>VB</given-names></name><name><surname>Hill</surname><given-names>SL</given-names></name><name><surname>Christensen</surname><given-names>J</given-names></name></person-group><article-title>Measurement of extravscular lung water by thermal-green dye indicator dilution.</article-title><source>Ann NY Acad Sci</source><year>1982</year><volume>384</volume><fpage>394</fpage><lpage>400</lpage><pub-id pub-id-type="pmid">7046565</pub-id></citation></ref><ref id="B33"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Hudson</surname><given-names>E</given-names></name><name><surname>Beale</surname><given-names>R</given-names></name></person-group><article-title>Lung water and blood volume measurements in the c