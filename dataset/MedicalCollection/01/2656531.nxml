tion citation-type="journal"><person-group person-group-type="author"><name><surname>Moroz</surname><given-names>LL</given-names></name><name><surname>Edwards</surname><given-names>JR</given-names></name><name><surname>Puthanveettil</surname><given-names>SV</given-names></name><name><surname>Kohn</surname><given-names>AB</given-names></name><name><surname>Ha</surname><given-names>T</given-names></name><name><surname>Heyland</surname><given-names>A</given-names></name><name><surname>Knudsen</surname><given-names>B</given-names></name><name><surname>Sahni</surname><given-names>A</given-names></name><name><surname>Yu</surname><given-names>F</given-names></name><name><surname>Liu</surname><given-names>L</given-names></name><name><surname>Jezzini</surname><given-names>S</given-names></name><name><surname>Lovell</surname><given-names>P</given-names></name><name><surname>Iannucculli</surname><given-names>W</given-names></name><name><surname>Chen</surname><given-names>M</given-names></name><name><surname>Nguyen</surname><given-names>T</given-names></name><name><surname>Sheng</surname><given-names>H</given-names></name><name><surname>Shaw</surname><given-names>R</given-names></name><name><surname>Kalachikov</surname><given-names>S</given-names></name><name><surname>Panchin</surname><given-names>YV</given-names></name><name><surname>Farmerie</surname><given-names>W</given-names></name><name><surname>Russo</surname><given-names>JJ</given-names></name><name><surname>Ju</surname><given-names>J</given-names></name><name><surname>Kandel</surname><given-names>ER</given-names></name></person-group><article-title>Neuronal transcriptome of <italic>Aplysia</italic>: Neuronal compartments and circuitry</article-title><source>Cell</source><year>2006</year><volume>127</volume><fpage>1453</fpage><lpage>1467</lpage><pub-id pub-id-type="pmid">17190607</pub-id><pub-id pub-id-type="doi">10.1016/j.cell.2006.09.052</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Raible</surname><given-names>F</given-names></name><name><surname>Tessmar-Raible</surname><given-names>K</given-names></name><name><surname>Osoegawa</surname><given-names>K</given-names></name><name><surname>Wincker</surname><given-names>P</given-names></name><name><surname>Jubin</surname><given-names>C</given-names></name><name><surname>Balavoine</surname><given-names>G</given-names></name><name><surname>Ferrier</surname><given-names>D</given-names></name><name><surname>Benes</surname><given-names>V</given-names></name><name><surname>de Jong</surname><given-names>P</given-names></name><name><surname>Weissenbach</surname><given-names>J</given-names></name><name><surname>Bork</surname><given-names>P</given-names></name><name><surname>Arendt</surname><given-names>D</given-names></name></person-group><article-title>Vertebrate-type intron-rich genes in the marine annelid <italic>Platynereis dumerilii</italic></article-title><source>Science</source><year>2005</year><volume>310</volume><fpage>1325</fpage><lpage>1326</lpage><pub-id pub-id-type="pmid">16311335</pub-id><pub-id pub-id-type="doi">10.1126/science.1119089</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>De Robertis</surname><given-names>EM</given-names></name></person-group><article-title>Evo-Devo: Variations on ancestral themes</article-title><source>Cell</source><year>2008</year><volume>132</volume><fpage>185</fpage><lpage>195</lpage><pub-id pub-id-type="pmid">18243095</pub-id><pub-id pub-id-type="doi">10.1016/j.cell.2008.01.003</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fahrbach</surname><given-names>SE</given-names></name><name><surname>Robinson</surname><given-names>GE</given-names></name></person-group><article-title>Behavioral development in the honey bee: Toward the study of learning under natural