up><article-title>Safety of sputum induction in moderate-to-severe chronic obstructive pulmonary disease</article-title><source>Respir Med</source><year>2002</year><volume>96</volume><fpage>482</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">12194630</pub-id><pub-id pub-id-type="doi">10.1053/rmed.2002.1342</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bhowmik</surname><given-names>A</given-names></name><name><surname>Seemungal</surname><given-names>TA</given-names></name><name><surname>Sapsford</surname><given-names>RJ</given-names></name><name><surname>Devalia</surname><given-names>JL</given-names></name><name><surname>Wedzicha</surname><given-names>JA</given-names></name></person-group><article-title>Comparison of spontaneous and induced sputum for investigation of airway inflammation in chronic obstructive pulmonary disease</article-title><source>Thorax</source><year>1998</year><volume>53</volume><fpage>953</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">10193394</pub-id></citation></ref><ref id="B9"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Taube</surname><given-names>C</given-names></name><name><surname>Holz</surname><given-names>O</given-names></name><name><surname>Mucke</surname><given-names>M</given-names></name><name><surname>Jorres</surname><given-names>RA</given-names></name><name><surname>Magnussen</surname><given-names>H</given-names></name></person-group><article-title>Airway response to inhaled hypertonic saline in patients with moderate to severe chronic obstructive pulmonary disease</article-title><source>Am J Respir Crit Care Med</source><year>2001</year><volume>164</volume><fpage>1810</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">11734428</pub-id></citation></ref><ref id="B10"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rytila</surname><given-names>PH</given-names></