d-type="pmid">2138363</pub-id></mixed-citation></ref><ref id="B10"><label>10.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Croce</surname><given-names>E</given-names></name><name><surname>Olmi</surname><given-names>S</given-names></name></person-group><article-title>Extracorporeal knotting simplified with a new instrument</article-title>. <source>Surg Endosc</source>. <year>1997</year>;<volume> 11</volume>:<fpage>963</fpage>&#x02013;<lpage>964</lpage><pub-id pub-id-type="pmid">9294284</pub-id></mixed-citation></ref><ref id="B11"><label>11.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Croce</surname><given-names>E</given-names></name><name><surname>Azzola</surname><given-names>M</given-names></name><name><surname>Russo</surname><given-names>R</given-names></name><name><surname>Golia</surname><given-names>M</given-names></name><name><surname>Olmi</surname><given-names>S</given-names></name></person-group><article-title>Videolaparoappendicectomia: variazioni di tecnica su 100 casi consecutivi</article-title>. <source>Chirurgia</source>. <year>1996</year>;<volume>9</volume>:<fpage>372</fpage>&#x02013;<lpage>375</lpage></mixed-citation></ref><ref id="B12"><label>12.</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Croce</surname><given-names>E</given-names></name><name><surname>Olmi</surname><given-names>S</given-names></name><name><surname>Azzola</surname><given-names>M</given-names></name><name><surname>Russo</surname><given-names>R</given-names></name><name><surname>Golia</surname><given-names>M</given-names></name></person-group><article-title>Appendicectomie vid&#x000e9;o-laparoscopique par voie laparoscopique et mini-laparoscopique: notre exp&#x000e9;rience</article-title>. <source>Le Journal de CaelioChirurgie</source>. <year>1998</year>;<volume>25</volume>:<fpage>35</fpage>&#x02013;<lpag