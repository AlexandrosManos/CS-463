ame><given-names>RJ</given-names></name><name><surname>Chang</surname><given-names>F</given-names></name></person-group><year>2002</year><article-title>Actin dynamics in the contractile ring during cytokinesis in fission yeast.</article-title><source>Nature</source><volume>419</volume><fpage>82</fpage><lpage>86</lpage><pub-id pub-id-type="pmid">12214236</pub-id></citation></ref><ref id="pone.0004892-Barr1"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Barr</surname><given-names>FA</given-names></name><name><surname>Gruneberg</surname><given-names>U</given-names></name></person-group><year>2007</year><article-title>Cytokinesis: placing and making the final cut.</article-title><source>Cell</source><volume>131</volume><fpage>847</fpage><lpage>860</lpage><pub-id pub-id-type="pmid">18045532</pub-id></citation></ref><ref id="pone.0004892-Odell1"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Odell</surname><given-names>GM</given-names></name><name><surname>Foe</surname><given-names>VE</given-names></name></person-group><year>2008</year><article-title>An agent-based model contrasts opposite effects of dynamic and stable microtubules on cleavage furrow positioning.</article-title><source>J Cell Biol</source><volume>183</volume><fpage>471</fpage><lpage>483</lpage><pub-id pub-id-type="pmid">18955556</pub-id></citation></ref><ref id="pone.0004892-Murthy1"><label>23</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Murthy</surname><given-names>K</given-names></name><name><surname>Wadsworth</surname><given-names>P</given-names></name></person-group><year>2005</year><article-title>Myosin-II-dependent localization and dynamics of F-actin during cytokinesis.</article-title><source>Curr Biol</source><volume>15</volume><fpage>724</fpage><lpage>731</lpage><pub-id pub-id-type="pmid">15854904</pub-id></citation></ref><ref