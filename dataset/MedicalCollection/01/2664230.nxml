page>73</fpage><lpage>85</lpage></citation></ref><ref id="b18-cln63_3p0321"><label>18</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coimbra</surname><given-names>R</given-names></name><name><surname>Loomis</surname><given-names>W</given-names></name><name><surname>Melbostad</surname><given-names>H</given-names></name><name><surname>Tobar</surname><given-names>M</given-names></name><name><surname>Porcides</surname><given-names>RD</given-names></name><name><surname>Hoyt</surname><given-names>D</given-names></name></person-group><article-title>LPS-Stimulated PMN activation and proinflammatory mediator synthesis is downregulated by phosphodiesterase inhibition: Role of pentoxifylline</article-title><source>J Trauma</source><year>2004</year><volume>57</volume><fpage>1157</fpage><lpage>63</lpage><pub-id pub-id-type="pmid">15625444</pub-id></citation></ref><ref id="b19-cln63_3p0321"><label>19</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coimbra</surname><given-names>R</given-names></name><name><surname>Melbostad</surname><given-names>H</given-names></name><name><surname>Hoyt</surname><given-names>DB</given-names></name></person-group><article-title>Effects of phosphodiesterase inhibition on the inflammatory response following shock: Role of pentoxifylline</article-title><source>J Trauma</source><year>2004</year><volume>56</volume><fpage>442</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">14960994</pub-id></citation></ref><ref id="b20-cln63_3p0321"><label>20</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Coimbra</surname><given-names>R</given-names></name><name><surname>Melbostad</surname><given-names>H</given-names></name><name><surname>Loomis</surname><given-names>W</given-names></name><name><surname>Wolf</surname><given-names>P</given-names></name><name><surname>Tobar</surname><given-names>M</given-names></name><name><surname>Hoyt</surname><given-names>DB</given-names></name></person-group><article-title>LPS-induced acute lung injury is attenuated by phosphodiesterase inhibition: Effects on proinflammatory mediators, metalloproteinases, NF-kB, and ICAM-1 expression</article-title><source>J Trauma</source><year>2006</year><volume>60</volume><fpage>115</fpage><lpage>25</lpage><pub-id pub-id-type="pmid">16456445</pub-id></citation></ref><ref id="b21-cln63_3p0321"><label>21</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yada-Langui</surname><given-names>MM</given-names></name><name><surname>Coimbra</surname><given-names>R</given-names></name><name><surname>Lancellotti</surname><given-names>C</given-names></name><name><surname>Mimica</surname><given-names>I</given-names></name><name><surname>Garcia</surname><given-names>C</given-names></name><name><surname>Correia</surname><given-names>N</given-names><suffix>Jr</suffix></name><etal/></person-group><article-title>Hypertonic saline and pentoxifylline prevent lung injury and bacterial translocation after hemorrhagic shock</article-title><source>Shock</source><year>2000</year><volume>14</volume><fpage>594</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">11131907</pub-id></citation></ref><ref id="b22-cln63_3p0321"><label>22</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Yada-Langui</surname><given-names>MM</given-names></name><name><surname>Anjos-Valotta</surname><given-names>EA</given-names></name><name><surname>Sannomiya</surname><given-names>P</given-names></name><name><surname>Rocha-e Silva</surname><given-names>M</given-names></name><name><surname>Coimbra</surname><given-names>R</given-names></name></person-group><article-title>Resuscitation affects microcirculatory polymorphonuclear leukocyte behavior after hemorrhagic shock: Role of hypertonic saline and pentoxifylline</article-title><source>Exp Biol Med</source><year>2004</year><vol