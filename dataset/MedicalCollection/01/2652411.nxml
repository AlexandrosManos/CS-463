 align="left" rowspan="1" colspan="1">45.5</td><td align="left" rowspan="1" colspan="1">174</td><td align="left" rowspan="1" colspan="1">7.3 (3.6&#x02013;14.1)</td></tr><tr><td align="left" rowspan="1" colspan="1">Kiechkuon</td><td align="left" rowspan="1" colspan="1">2002</td><td align="left" rowspan="1" colspan="1">1,738</td><td align="left" rowspan="1" colspan="1">1,530</td><td align="left" rowspan="1" colspan="1">88.0</td><td align="left" rowspan="1" colspan="1">37.9</td><td align="left" rowspan="1" colspan="1">125</td><td align="left" rowspan="1" colspan="1">8.2 (6.5&#x02013;10.3)</td></tr><tr><td align="left" rowspan="1" colspan="1">Mankien</td><td align="left" rowspan="1" colspan="1">2005</td><td align="left" rowspan="1" colspan="1">3,976</td><td align="left" rowspan="1" colspan="1">3,567</td><td align="left" rowspan="1" colspan="1">89.7</td><td align="left" rowspan="1" colspan="1">44.5</td><td align="left" rowspan="1" colspan="1">341</td><td align="left" rowspan="1" colspan="1">9.6 (70&#x02013;13.0)</td></tr><tr><td align="left" rowspan="1" colspan="1">Katigiri</td><td align="left" rowspan="1" colspan="1">2001</td><td align="left" rowspan="1" colspan="1">1,743</td><td align="left" rowspan="1" colspan="1">1,642</td><td align="left" rowspan="1" colspan="1">94.2</td><td align="left" rowspan="1" colspan="1">43.5</td><td align="left" rowspan="1" colspan="1">12</td><td align="left" rowspan="1" colspan="1">0.7 (0.2&#x02013;2.3)</td></tr><tr><td align="left" rowspan="1" colspan="1">Tali</td><td align="left" rowspan="1" colspan="1">2001</td><td align="left" rowspan="1" colspan="1">1,530</td><td align="left" rowspan="1" colspan="1">1,433</td><td align="left" rowspan="1" colspan="1">93.7</td><td align="left" rowspan="1" colspan="1">42.6</td><td align="left" rowspan="1" colspan="1">32</td><td align="left" rowspan="1" colspan="1">2.2 (1.3&#x02013;3.4)</td></tr><tr><td align="left" rowspan="1" colspan="1">Narus</td><td align="left" rowspan="1" colspan="1">2004</td><td align="left" rowspan="1" colspan="1">2,049</td><td align="left" rowspan="1" colspan="1">1,681</td><td align="left" rowspan="1" colspan="1">82.0</td><td align="left" rowspan="1" colspan="1">35.1</td><td align="left" rowspan="1" colspan="1">51</td><td align="left" rowspan="1" colspan="1">3.0 (2.1&#x02013;4.3)</td></tr><tr><td align="left" rowspan="1" colspan="1">Kimotong</td><td align="left" rowspan="1" colspan="1">2004</td><td align="left" rowspan="1" colspan="1">1,735</td><td align="left" rowspan="1" colspan="1">1,586</td><td align="left" rowspan="1" colspan="1">91.4</td><td align="left" rowspan="1" colspan="1">40.1</td><td align="left" rowspan="1" colspan="1">159</td><td align="left" rowspan="1" colspan="1">10.0 (5.1&#x02013;18.8)</td></tr><tr><td align="left" rowspan="1" colspan="1">Ayod</td><td align="left" rowspan="1" colspan="1">2006</td><td align="left" rowspan="1" colspan="1">2,605</td><td align="left" rowspan="1" colspan="1">2,561</td><td align="left" rowspan="1" colspan="1">98.3</td><td align="left" rowspan="1" colspan="1">48.0</td><td align="left" rowspan="1" colspan="1">182</td><td align="left" rowspan="1" colspan="1">7.1 (5.8&#x02013;10.8)</td></tr><tr><td align="left" rowspan="1" colspan="1">Total</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">26,354</td><td align="left" rowspan="1" colspan="1">23,139</td><td align="left" rowspan="1" colspan="1">87.8</td><td align="left" rowspan="1" colspan="1">43.0</td><td align="left" rowspan="1" colspan="1">1,377</td><td align="left" rowspan="1" colspan="1">6.0 (5.2&#x02013;7.0)</td></tr></tbody></table></table-wrap><table-wrap id="pntd-0000396-t002" position="float"><object-id pub-id-type="doi">10.1371/journal.pntd.0000396.t002</object-id><label>Table 2</label><caption><title>Distribution of predicted proportions of vision status by age group and gender in persons with trichiasis in Mankien district (n&#x0200a;&#x0003d;&#x0200a;319).</title></caption><graphic id="pntd-0000396-t00