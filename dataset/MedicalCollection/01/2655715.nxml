-title><source>Circulation</source><volume>92</volume><fpage>1479</fpage><lpage>1486</lpage><pub-id pub-id-type="pmid">7664430</pub-id></citation></ref><ref id="pone.0004871-Nozaki1"><label>5</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Nozaki</surname><given-names>N</given-names></name><name><surname>Yamaguchi</surname><given-names>S</given-names></name><name><surname>Shirakabe</surname><given-names>M</given-names></name><name><surname>Nakamura</surname><given-names>H</given-names></name><name><surname>Tomoike</surname><given-names>H</given-names></name></person-group><year>1997</year><article-title>Soluble tumor necrosis factor receptors are elevated in relation to severity of congestive heart failure.</article-title><source>Jpn Circ J</source><volume>61</volume><fpage>657</fpage><lpage>664</lpage><pub-id pub-id-type="pmid">9276770</pub-id></citation></ref><ref id="pone.0004871-Keith1"><label>6</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Keith</surname><given-names>M</given-names></name><name><surname>Geranmayegan</surname><given-names>A</given-names></name><name><surname>Sole</surname><given-names>MJ</given-names></name><name><surname>Kurian</surname><given-names>R</given-names></name><name><surname>Robinson</surname><given-names>A</given-names></name><etal/></person-group><year>1998</year><article-title>Increased oxidative stress in patients with congestive heart failure.</article-title><source>J Am Coll Cardiol</source><volume>31</volume><fpage>1352</fpage><lpage>1356</lpage><pub-id pub-id-type="pmid">9581732</pub-id></citation></ref><ref id="pone.0004871-Rauchhaus1"><label>7</label><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Rauchhaus</surname><given-names>M</given-names></name><name><surname>Doehner</surname><given-names>W</given-names></name><name><surname>Francis</surname><given-names>DP</given-names></name><