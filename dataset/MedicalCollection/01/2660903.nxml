e><fpage>37</fpage><lpage>43</lpage><pub-id pub-id-type="pmid">10385045</pub-id><pub-id pub-id-type="doi">10.1016/S0022-510X(99)00044-1</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gay</surname><given-names>PC</given-names></name><name><surname>Westbrook</surname><given-names>PR</given-names></name><name><surname>Daube</surname><given-names>JR</given-names></name><etal></etal></person-group><article-title>Effects of alterations in pulmonary function and sleep variables on survival in patients with amyotrophic lateral sclerosis</article-title><source>Mayo Clin Proc</source><year>1991</year><volume>66</volume><fpage>686</fpage><lpage>94</lpage><pub-id pub-id-type="pmid">2072756</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Newsom-Davis</surname><given-names>IC</given-names></name><name><surname>Lyall</surname><given-names>RA</given-names></name><name><surname>Leigh</surname><given-names>PN</given-names></name><etal></etal></person-group><article-title>The effect of non-invasive positive pressure ventilation (NIPPV) on cognitive function in amyotrophic lateral sclerosis (ALS): a prospective study</article-title><source>J Neurol Neurosurg Psychiatry</source><year>2001</year><volume>71</volume><fpage>482</fpage><lpage>7</lpage><pub-id pub-id-type="pmid">11561031</pub-id><pub-id pub-id-type="doi">10.1136/jnnp.71.4.482</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Santos</surname><given-names>C</given-names></name><name><surname>Braghiroli</surname><given-names>A</given-names></name><name><surname>Mazzini</surname><given-names>L</given-names></name><etal></etal></person-group><article-title>Sleep-related breathing disorders in amyotrophic lateral sclerosis</article-title><source>Monaldi Arch Chest Dis</source><year>2003</year><