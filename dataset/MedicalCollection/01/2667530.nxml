><article-title>Definitive enzymatic assays in polyphosphate analysis</article-title><source>Prog Mol Subcell Biol</source><year>1999</year><volume>23</volume><fpage>241</fpage><lpage>252</lpage><pub-id pub-id-type="pmid">10448680</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cardona</surname><given-names>S</given-names></name><name><surname>Ch&#x000e1;vez</surname><given-names>F</given-names></name><name><surname>Jerez</surname><given-names>C</given-names></name></person-group><article-title>The exopolyphosphatase gene from <italic>Sulfolobus solfataricus</italic>: characterization of the first gene found to be involved in polyphosphate metabolism in archaea</article-title><source>Appl Environ Microbiol</source><year>2002</year><volume>68</volume><fpage>4812</fpage><lpage>4819</lpage><pub-id pub-id-type="pmid">12324325</pub-id><pub-id pub-id-type="doi">10.1128/AEM.68.10.4812-4819.2002</pub-id></citation></ref></ref-list></back></article>