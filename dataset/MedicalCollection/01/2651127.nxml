ume><fpage>269</fpage><lpage>271</lpage><pub-id pub-id-type="doi">10.1007/BF01386390</pub-id></citation></ref><ref id="B23"><citation citation-type="other"><article-title>Bicycle Velocity Prediction</article-title><ext-link ext-link-type="uri" xlink:href="http://bikecalculator.com/"/></citation></ref><ref id="B24"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Ray</surname><given-names>N</given-names></name><name><surname>Ebener</surname><given-names>S</given-names></name></person-group><article-title>ACCESSMOD3. Physical Accessibility to Health Care and Population coverage Modeling &#x02013; User Manual</article-title><source>WHO, Geneva</source><year>2008</year></citation></ref><ref id="B25"><citation citation-type="other"><person-group person-group-type="author"><name><surname>Siek</surname><given-names>JG</given-names></name><name><surname>Lee</surname><given-names>L</given-names></name><name><surname>Lumsdaine</surname><given-names>A</given-names></name></person-group><article-title>The Boost Graph Library: User Guide and Reference Manual</article-title><source>Addison Wesley Professional</source><year>2001</year></citation></ref><ref id="B26"><citation citation-type="other"><article-title>GTOPO30: a global digital elevation model at 30 arc-second resolution</article-title><ext-link ext-link-type="uri" xlink:href="http://edc.usgs.gov/products/elevation/gtopo30.html"/></citation></ref><ref id="B27"><citation citation-type="other"><article-title>LandScanTM Global Population Database</article-title><ext-link ext-link-type="uri" xlink:href="http://www.ornl.gov/landscan"/></citation></ref><ref id="B28"><citation citation-type="other"><article-title>Global Rural-Urban Mapping Project (GRUMP): Gridded population of the world</article-title><ext-link ext-link-type="uri" xlink:href="http://sedac.ciesin.columbia.edu/gpw"/></citation></ref><ref id="B29"><citation citation-type="other"><article-title>National health facilities inven