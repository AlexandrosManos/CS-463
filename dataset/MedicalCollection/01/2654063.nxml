lspan="1">&#x02212;66</td><td align="left" rowspan="1" colspan="1">&#x02212;64</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x003a8;</td><td align="left" rowspan="1" colspan="1">&#x02212;25</td><td align="left" rowspan="1" colspan="1">127</td><td align="left" rowspan="1" colspan="1">61</td><td align="left" rowspan="1" colspan="1">102</td><td align="left" rowspan="1" colspan="1">121</td><td align="left" rowspan="1" colspan="1">98</td><td align="left" rowspan="1" colspan="1">148</td><td align="left" rowspan="1" colspan="1">163</td><td align="left" rowspan="1" colspan="1">&#x02212;53</td><td align="left" rowspan="1" colspan="1">&#x02212;48</td><td align="left" rowspan="1" colspan="1">&#x02212;37</td><td align="left" rowspan="1" colspan="1">&#x02212;33</td><td align="left" rowspan="1" colspan="1">&#x02212;34</td><td align="left" rowspan="1" colspan="1">&#x02212;40</td><td align="left" rowspan="1" colspan="1">&#x02212;33</td></tr><tr><td align="left" rowspan="1" colspan="1"><italic>Sso</italic>RadA 2ZUD_A</td><td align="left" rowspan="1" colspan="1">68</td><td align="left" rowspan="1" colspan="1">69</td><td align="left" rowspan="1" colspan="1">70</td><td align="left" rowspan="1" colspan="1">71</td><td align="left" rowspan="1" colspan="1">72</td><td align="left" rowspan="1" colspan="1">73</td><td align="left" rowspan="1" colspan="1">74</td><td align="left" rowspan="1" colspan="1">75</td><td align="left" rowspan="1" colspan="1">76</td><td align="left" rowspan="1" colspan="1">77</td><td align="left" rowspan="1" colspan="1">78</td><td align="left" rowspan="1" colspan="1">79</td><td align="left" rowspan="1" colspan="1">80</td><td align="left" rowspan="1" colspan="1">81</td><td align="left" rowspan="1" colspan="1">82</td></tr><tr><td align="left" rowspan="1" colspan="1">a. a. sequence</td><td align="left" rowspan="1" colspan="1">A</td><td align="left" rowspan="1" colspan="1">L</td><td align="left" rowspan="1" colspan="1">D</td><td align="left" rowspan="1" colspan="1"