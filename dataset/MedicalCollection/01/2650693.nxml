article-title>Knowledge and attitude concerning mental health of primary health care workers in Nigeria</article-title><source>Int J Soc Psychiatry</source><year>1991</year><volume>Summer; 37</volume><fpage>113</fpage><lpage>20</lpage><pub-id pub-id-type="pmid">1917368</pub-id><pub-id pub-id-type="doi">10.1177/002076409103700206</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Murthy</surname><given-names>RS</given-names></name><name><surname>Wig</surname><given-names>NN</given-names></name></person-group><article-title>The WHO collaborative study on strategies for extending mental health care IV: A training approach to enhancing the availability of mental health man power in a developing country</article-title><source>Am J Psychiatry</source><year>1983</year><volume>Nov: 140</volume><fpage>1486</fpage><lpage>90</lpage><pub-id pub-id-type="pmid">6624997</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Liptak</surname><given-names>GS</given-names></name><name><surname>Orlando</surname><given-names>M</given-names></name><name><surname>Yingling</surname><given-names>JT</given-names></name><name><surname>Theurer-Kaufman</surname><given-names>KL</given-names></name><name><surname>Malay</surname><given-names>DP</given-names></name><name><surname>Tompkins</surname><given-names>LA</given-names></name><name><surname>Flynn</surname><given-names>JR</given-names></name></person-group><article-title>Satisfaction with primary health care received by families of children with developmental disabilities</article-title><source>J Pediatr Health Care</source><year>2006</year><volume>Jul&#x02013;Aug; 20</volume><fpage>245</fpage><lpage>52</lpage><pub-id pub-id-type="doi">10.1016/j.pedhc.2005.12.008</pub-id></citation></ref><ref id="B25"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Thyen</surname><given-names>U</given-names></name><name><surname>Sperner</surname><given-names>J</given-names></name><name><surname>Morfeld</surname><given-names>M</given-names></name><name><surname>Meyer</surname><given-names>C</given-names></name><name><surname>Ravens-Sieberer</surname><given-names>U</given-names></name></person-group><article-title>Unmet health care needs and impact on families with children with disabilities in Germany</article-title><source>Ambul Pediatr</source><year>2003</year><volume>Mar&#x02013;Apr; 3</volume><fpage>74</fpage><lpage>81</lpage><pub-id pub-id-type="doi">10.1367/1539-4409(2003)003&#x0003c;0074:UHCNAI&#x0003e;2.0.CO;2</pub-id></citation></ref><ref id="B26"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Olatawura</surname><given-names>M</given-names></name></person-group><article-title>Culture and child psychiatric disorders: A Nigerian perspective</article-title><source>Psychiatr Clin North Am</source><year>2001</year><volume>24</volume><fpage>497</fpage><lpage>504</lpage><pub-id pub-id-type="pmid">11593859</pub-id><pub-id pub-id-type="doi">10.1016/S0193-953X(05)70243-4</pub-id></citation></ref><ref id="B27"><citation citation-type="other"><article-title>Child rights in Nigeria: Problem and panacea</article-title><ext-link ext-link-type="uri" xlink:href="http://sites.unu.edu/ic/alums/wp-content/uploads/2006/10/esther.pdf"/></citation></ref></ref-list></back></article>