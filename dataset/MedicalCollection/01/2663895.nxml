/ref><ref id="ref7"><mixed-citation id="cit7" publication-type="journal"><name><surname>Blumberg</surname><given-names>P. M.</given-names></name>; <name><surname>Acs</surname><given-names>G.</given-names></name>; <name><surname>Areces</surname><given-names>L. B.</given-names></name>; <name><surname>Kazanietz</surname><given-names>M. G.</given-names></name>; <name><surname>Lewin</surname><given-names>N. E.</given-names></name>; <name><surname>Szallasi</surname><given-names>Z.</given-names></name> <source>Prog. Clin. Biol. Res.</source> <year>1994</year>, <volume>387</volume>, 3&#x02013;19.<pub-id pub-id-type="pmid">7972255</pub-id></mixed-citation></ref><ref id="ref8"><mixed-citation id="cit8" publication-type="journal"><name><surname>Bogi</surname><given-names>K.</given-names></name>; <name><surname>Lorenzo</surname><given-names>P. S.</given-names></name>; <name><surname>Szallasi</surname><given-names>Z.</given-names></name>; <name><surname>Acs</surname><given-names>P.</given-names></name>; <name><surname>Wagner</surname><given-names>G. S.</given-names></name>; <name><surname>Blumberg</surname><given-names>P. M.</given-names></name> <source>Cancer Res.</source> <year>1998</year>, <volume>58</volume>, 1423&#x02013;1428.<pub-id pub-id-type="pmid">9537243</pub-id></mixed-citation></ref><ref id="ref9"><mixed-citation id="cit9" publication-type="journal"><name><surname>Nacro</surname><given-names>K.</given-names></name>; <name><surname>Bienfait</surname><given-names>B.</given-names></name>; <name><surname>Lee</surname><given-names>J.</given-names></name>; <name><surname>Han</surname><given-names>K. C.</given-names></name>; <name><surname>Kang</surname><given-names>J. H.</given-names></name>; <name><surname>Benzaria</surname><given-names>S.</given-names></name>; <name><surname>Lewin</surname><given-names>N. E.</given-names></name>; <name><surname>Bhattacharyya</surname><given-names>D. K.</given-names></name>; <name><surname>Blumberg</surname><given-names>P. M.</given-name