>, 115&#x02013;125.<pub-id pub-id-type="pmid">8872364</pub-id></mixed-citation></ref><ref id="ref13"><mixed-citation id="cit13" publication-type="journal"><name><surname>Murphy</surname><given-names>T. V.</given-names></name>; <name><surname>Prountzos</surname><given-names>C.</given-names></name>; <name><surname>Kotsonis</surname><given-names>P.</given-names></name>; <name><surname>Iannazzo</surname><given-names>L.</given-names></name>; <name><surname>Majewski</surname><given-names>H.</given-names></name> <source>Eur. J. Pharmacol.</source> <year>1999</year>, <volume>381</volume>, 77&#x02013;84.<pub-id pub-id-type="pmid">10528137</pub-id></mixed-citation></ref><ref id="ref14"><mixed-citation id="cit14" publication-type="journal"><name><surname>Rullas</surname><given-names>J.</given-names></name>; <name><surname>Bermejo</surname><given-names>M.</given-names></name>; <name><surname>Garcia-Perez</surname><given-names>J.</given-names></name>; <name><surname>Beltan</surname><given-names>M.</given-names></name>; <name><surname>Gonzalez</surname><given-names>N.</given-names></name>; <name><surname>Hezareh</surname><given-names>M.</given-names></name>; <name><surname>Brown</surname><given-names>S. J.</given-names></name>; <name><surname>Alcami</surname><given-names>J.</given-names></name> <source>Antiviral Ther.</source> <year>2004</year>, <volume>9</volume>, 545&#x02013;554.</mixed-citation></ref><ref id="ref15"><mixed-citation id="cit15" publication-type="journal"><name><surname>Szallasi</surname><given-names>Z.</given-names></name>; <name><surname>Krsmanovic</surname><given-names>L.</given-names></name>; <name><surname>Blumberg</surname><given-names>P. M.</given-names></name> <source>Cancer Res.</source> <year>1993</year>, <volume>53</volume>, 2507&#x02013;2512.<pub-id pub-id-type="pmid">8495413</pub-id></mixed-citation></ref><ref id="ref16"><mixed-citation id="cit16" publication-type="journal"><name><surname>Gulakowski</surname><given-names>R. J.</given-names></name>; <