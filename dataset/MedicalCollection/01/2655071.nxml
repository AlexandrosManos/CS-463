pub-id-type="pmid">17599676</pub-id></element-citation></ref><ref id="R13"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rashba</surname><given-names>EJ</given-names></name><etal/></person-group><article-title>Influence of QRS duration on the prognostic value of T wave alternans</article-title><source>J Cardiovasc Electrophysiol</source><year>2002</year><volume>13</volume><fpage>770</fpage><lpage>775</lpage><pub-id pub-id-type="pmid">12212695</pub-id></element-citation></ref><ref id="R14"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chow</surname><given-names>T</given-names></name><etal/></person-group><article-title>Prognostic utility of microvolt T-wave alternans in risk stratification of patients with ischemic cardiomyopath</article-title><source>J Am Coll Cardiol</source><year>2006</year><volume>47</volume><fpage>1820</fpage><lpage>1827</lpage><pub-id pub-id-type="pmid">16682307</pub-id></element-citation></ref><ref id="R15"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Madias</surname><given-names>JE</given-names></name><etal/></person-group><article-title>Effects of bundle branch block on microvolt T-wave alternans (letter to the Editor)</article-title><source>Heart Rhythm</source><year>2007</year><volume>4</volume><fpage>1370</fpage><pub-id pub-id-type="pmid">17905348</pub-id></element-citation></ref><ref id="R16"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Paz</surname><given-names>O</given-names></name><etal/></person-group><article-title>Detection of T-wave alternans using an implantable cardioverter-defibrillator</article-title><source>Heart Rhythm</source><year>2006</year><volume>3</volume><fpage>791</fpage><lpage>797</lpage><pub-id pub-id-type="pmid">16818208</pub-id></element-citation></ref><ref id="R17"><element-citation publication