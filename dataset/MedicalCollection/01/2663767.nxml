oc</source><year>1997</year><volume>97</volume><fpage>1110</fpage><lpage>1115</lpage><pub-id pub-id-type="pmid">9336557</pub-id><pub-id pub-id-type="doi">10.1016/S0002-8223(97)00271-X</pub-id></citation></ref><ref id="B22"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Gross</surname><given-names>D</given-names></name><name><surname>Shenkman</surname><given-names>Z</given-names></name><name><surname>Bleiberg</surname><given-names>B</given-names></name><name><surname>Dayan</surname><given-names>M</given-names></name><name><surname>Gittelson</surname><given-names>M</given-names></name><name><surname>Efrat</surname><given-names>R</given-names></name></person-group><article-title>Ginseng improves pulmonary functions and exercise capacity in patients with COPD</article-title><source>Monaldi Arch Chest Dis</source><year>2002</year><volume>57</volume><fpage>242</fpage><lpage>246</lpage><pub-id pub-id-type="pmid">12814035</pub-id></citation></ref><ref id="B23"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>JH</given-names></name><name><surname>Park</surname><given-names>CY</given-names></name><name><surname>Lee</surname><given-names>SJ</given-names></name></person-group><article-title>Effects of sun ginseng on subjective quality of life in cancer patients: a double-blind, placebo-controlled pilot trial</article-title><source>J Clin Pharm Ther</source><year>2006</year><volume>31</volume><fpage>331</fpage><lpage>334</lpage><pub-id pub-id-type="pmid">16882101</pub-id><pub-id pub-id-type="doi">10.1111/j.1365-2710.2006.00740.x</pub-id></citation></ref><ref id="B24"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>McElhaney</surname><given-names>JE</given-names></name><name><surname>Gravenstein</surname><given-names>S</given-names></name><name><surname>Cole</surname><given-names>SK</given-names></name><name><surname>Davidson</sur