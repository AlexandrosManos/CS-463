"><name><surname>Sun</surname><given-names>H</given-names></name><name><surname>Skogerbo</surname><given-names>G</given-names></name><name><surname>Chen</surname><given-names>R</given-names></name></person-group><article-title>Conserved distances between vertebrate highly conserved elements</article-title><source>Hum Mol Genet</source><year>2006</year><volume>15</volume><fpage>2911</fpage><lpage>2922</lpage><pub-id pub-id-type="pmid">16923797</pub-id><pub-id pub-id-type="doi">10.1093/hmg/ddl232</pub-id></citation></ref><ref id="B6"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Eichler</surname><given-names>EE</given-names></name><name><surname>Sankoff</surname><given-names>D</given-names></name></person-group><article-title>Structural dynamics of eukaryotic chromosome evolution</article-title><source>Science</source><year>2003</year><volume>301</volume><fpage>793</fpage><lpage>797</lpage><pub-id pub-id-type="pmid">12907789</pub-id><pub-id pub-id-type="doi">10.1126/science.1086132</pub-id></citation></ref><ref id="B7"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bourque</surname><given-names>G</given-names></name><name><surname>Pevzner</surname><given-names>PA</given-names></name><name><surname>Tesler</surname><given-names>G</given-names></name></person-group><article-title>Reconstructing the genomic architecture of ancestral mammals: lessons from human, mouse, and rat genomes</article-title><source>Genome Res</source><year>2004</year><volume>14</volume><fpage>507</fpage><lpage>516</lpage><pub-id pub-id-type="pmid">15059991</pub-id><pub-id pub-id-type="doi">10.1101/gr.1975204</pub-id></citation></ref><ref id="B8"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bourque</surname><given-names>G</given-names></name><name><surname>Zdobnov</surname><given-names>EM</given-names></name><name><surname>Bork</surname><given-names>P</given-names></na