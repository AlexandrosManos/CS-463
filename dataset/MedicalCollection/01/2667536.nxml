id="B16"><mixed-citation publication-type="journal"><name><surname>Gilliver</surname><given-names>SC</given-names></name><name><surname>Ashworth</surname><given-names>JJ</given-names></name><name><surname>Mills</surname><given-names>SJ</given-names></name><name><surname>Hardman</surname><given-names>MJ</given-names></name><name><surname>Ashcroft</surname><given-names>GS</given-names></name><article-title>Androgens modulate the inflammatory response during acute wound healing</article-title><source>J Cell Sci</source><year>2006</year><volume>119</volume><fpage>722</fpage><lpage>732</lpage><pub-id pub-id-type="doi">10.1242/jcs.02786</pub-id><pub-id pub-id-type="pmid">16449322</pub-id></mixed-citation></ref><ref id="B17"><mixed-citation publication-type="journal"><name><surname>Roach</surname><given-names>M</given-names><suffix>3rd</suffix></name><article-title>Current status of androgen suppression and radiotherapy for patients with prostate cancer</article-title><source>J Steroid Biochem Mol Biol</source><year>1999</year><volume>69</volume><fpage>239</fpage><lpage>45</lpage><pub-id pub-id-type="doi">10.1016/S0960-0760(99)00040-0</pub-id><pub-id pub-id-type="pmid">10418997</pub-id></mixed-citation></ref><ref id="B18"><mixed-citation publication-type="journal"><name><surname>Lee</surname><given-names>AK</given-names></name><article-title>Radiation therapy combined with hormone therapy for prostate cancer</article-title><source>Semin Radiat Oncol</source><year>2006</year><volume>16</volume><fpage>20</fpage><lpage>8</lpage><pub-id pub-id-type="doi">10.1016/j.semradonc.2005.08.003</pub-id><pub-id pub-id-type="pmid">16378903</pub-id></mixed-citation></ref><ref id="B19"><mixed-citation publication-type="journal"><name><surname>Toth</surname><given-names>B</given-names></name><name><surname>Alexander</surname><given-names>M</given-names></name><name><surname>Daniel</surname><given-names>T</given-names></name><name><surname>Chaudry</surname><given-names>IH</given-names></name