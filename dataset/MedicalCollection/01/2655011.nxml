r" char="(" rowspan="1" colspan="1">5.10 (2.65&#x02013;9.83)<xref ref-type="table-fn" rid="tblfn6">&#x02021;</xref></td><td align="char" char="(" rowspan="1" colspan="1">0.72 (0.36&#x02013;1.43)</td></tr><tr><td rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;No</td><td align="char" char="." rowspan="1" colspan="1">1.0</td><td align="char" char="." rowspan="1" colspan="1">1.0</td><td align="char" char="." rowspan="1" colspan="1">1.0</td></tr><tr><td rowspan="1" colspan="1">Household income</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;&#x0003c;$15,000</td><td align="char" char="(" rowspan="1" colspan="1">1.30 (0.89&#x02013;1.89)</td><td align="char" char="(" rowspan="1" colspan="1">1.20 (0.83&#x02013;1.74)</td><td align="char" char="(" rowspan="1" colspan="1">0.91 (0.60&#x02013;1.39)</td></tr><tr><td rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;$15,000 to &#x0003c;$45,000</td><td align="char" char="(" rowspan="1" colspan="1">1.03 (0.74&#x02013;1.43)</td><td align="char" char="(" rowspan="1" colspan="1">0.97 (0.73&#x02013;1.28)</td><td align="char" char="(" rowspan="1" colspan="1">0.92 (0.66&#x02013;1.29)</td></tr><tr><td rowspan="1" colspan="1">&#x02003;&#x02003;&#x02003;&#x02003;&#x02265;$45,000</td><td align="char" char="." rowspan="1" colspan="1">1.0</td><td align="char" char="." rowspan="1" colspan="1">1.0</td><td align="char" char="." rowspan="1" colspan="1">1.0</td></tr></tbody></table><table-wrap-foot><fn><p><italic>Notes:</italic> OR = odds ratio; CI = confidence interval.</p></fn><fn id="tblfn4"><label>*</label><p><italic>p</italic> &#x02264; .05.</p></fn><fn id="tblfn6"><label>&#x02021;</label><p><italic>p</italic> &#x02264; .001.</p></fn></table-wrap-foot></table-wrap><table-wrap id="tbl4" position="float"><label>Table 4.</label><caption><p>Logistic Regression Models of Predictors of Awareness, Treatment, and Con