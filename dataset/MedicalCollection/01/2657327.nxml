<!DOCTYPE article PUBLIC "-//NLM//DTD JATS (Z39.96) Journal Archiving and Interchange DTD v1.0 20120330//EN" "JATS-archivearticle1.dtd"><article xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="calendar"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">J Orthop Traumatol</journal-id><journal-title-group><journal-title>Journal of Orthopaedics and Traumatology : Official Journal of the Italian Society of Orthopaedics and Traumatology</journal-title></journal-title-group><issn pub-type="ppub">1590-9921</issn><issn pub-type="epub">1590-9999</issn><publisher><publisher-name>Springer-Verlag</publisher-name><publisher-loc>Milan</publisher-loc></publisher></journal-meta><article-meta><article-id pub-id-type="pmc">2657327</article-id><article-id pub-id-type="publisher-id">35</article-id><article-id pub-id-type="doi">10.1007/s10195-008-0035-1</article-id><article-categories><subj-group subj-group-type="heading"><subject>Acknowledgement to Referees</subject></subj-group></article-categories><title-group><article-title>Referees2008</article-title></title-group><pub-date pub-type="epub"><day>22</day><month>11</month><year>2008</year></pub-date><pub-date pub-type="pmc-release"><day>22</day><month>11</month><year>2008</year></pub-date><pub-date pub-type="ppub"><month>12</month><year>2008</year></pub-date><volume>9</volume><issue>4</issue><fpage>239</fpage><lpage>239</lpage><permissions><copyright-statement>&#x000a9; Springer-Verlag 2008</copyright-statement></permissions><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; Springer-Verlag 2008</meta-value></custom-meta></custom-meta-group></article-meta></front><body><p>The quality of the <italic>Journal of Orthopaedics and Traumatology</italic> depends on the qualified and regular collaboration of renowned scientists who devoted their time to constructively review the submitted articles. We ar