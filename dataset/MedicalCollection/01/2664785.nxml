Lancet</source><year>2005</year><volume>366</volume><fpage>427</fpage><lpage>520</lpage><pub-id pub-id-type="pmid">16089000</pub-id><pub-id pub-id-type="doi">10.1016/S0140-6736(05)66836-5</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Magadi</surname><given-names>MA</given-names></name><name><surname>Madise</surname><given-names>NJ</given-names></name><name><surname>Rodrigues</surname><given-names>RN</given-names></name></person-group><article-title>Frequency and timing of antenatal care in Kenya: explaining the variations between women of different communities</article-title><source>Social Science &#x00026; Medicine</source><year>2000</year><volume>51</volume><fpage>551</fpage><lpage>561</lpage><pub-id pub-id-type="pmid">10868670</pub-id><pub-id pub-id-type="doi">10.1016/S0277-9536(99)00495-5</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van Eijk</surname><given-names>AM</given-names></name><name><surname>Bles</surname><given-names>HM</given-names></name><name><surname>Odhiambo</surname><given-names>F</given-names></name><name><surname>Ayis</surname><given-names>JG</given-names></name><name><surname>Blokland</surname><given-names>IE</given-names></name><name><surname>Rosen</surname><given-names>DH</given-names></name><name><surname>Adazu</surname><given-names>K</given-names></name><name><surname>Slutsker</surname><given-names>L</given-names></name><name><surname>Slutsker</surname><given-names>KA</given-names></name></person-group><article-title>Use of antenatal services and delivery care among women in rural western Kenya: a community based survey</article-title><source>Reproductive Health</source><year>2006</year><volume>3</volume><fpage>2</fpage><pub-id pub-id-type="pmid">16597344</pub-id><pub-id pub-id-type="doi">10.1186/1742-4755-3-2</pub-id></citation></ref><ref id="B20"><citation citation-type="jo