n="1" colspan="1">(n&#x0200a;&#x0003d;&#x0200a;58)</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">8&#x02013;&#x0003c;12 (n&#x0200a;&#x0003d;&#x0200a;122)</td><td align="left" rowspan="1" colspan="1">5 (7.8)</td><td align="left" rowspan="1" colspan="1">5 (8.6)</td><td align="left" rowspan="1" colspan="1">51 (79.6)</td><td align="left" rowspan="1" colspan="1">45 (77.5)</td><td align="left" rowspan="1" colspan="1">12 (18.7)</td><td align="left" rowspan="1" colspan="1">15 (25.8)</td><td align="left" rowspan="1" colspan="1">9 (14.0)</td><td align="left" rowspan="1" colspan="1">11 (18.9)</td><td align="left" rowspan="1" colspan="1">44 (68.7)</td><td align="left" rowspan="1" colspan="1">32 (55.1)</td><td align="left" rowspan="1" colspan="1">37 (57.8)</td><td align="left" rowspan="1" colspan="1">30 (51.7)</td><td align="left" rowspan="1" colspan="1">12 (18.7)</td><td align="left" rowspan="1" colspan="1">18 (31.0)</td><td align="left" rowspan="1" colspan="1">22 (34.3)</td><td align="left" rowspan="1" colspan="1">18 (31.0)</td></tr><tr><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1">(n&#x0200a;&#x0003d;&#x0200a;67)</td><td align="left" rowspan="1" colspan="1">(n&#x0200a;&#x0003d;&#x0200a;62)</td><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1"/><td align="left" rowspan="1" colspan="1