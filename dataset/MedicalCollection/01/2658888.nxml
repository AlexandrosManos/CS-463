</td></tr><tr><td rowspan="1" colspan="1">189-192</td><td rowspan="1" colspan="1">KTTS</td><td rowspan="1" colspan="1">KXX<italic>[pS/pT]</italic></td><td rowspan="1" colspan="1">PKA</td><td rowspan="1" colspan="1">A568G_C569A_A570C_A571G_C572A</td><td rowspan="1" colspan="1">F:5'-actttgctgttcctgtccccgaaaagacgactcttacccaacaccaaggccc-3' R:5'-gggccttggtgttgggtaagagtcgtcttttcggggacaggaacagcaaagt-3'</td></tr><tr><td rowspan="1" colspan="1">195-197</td><td rowspan="1" colspan="1">TPR</td><td rowspan="1" colspan="1"><italic>[pS/pT]</italic>X[R/K]</td><td rowspan="1" colspan="1">PKA</td><td rowspan="1" colspan="1">A589G_G590A_G591C</td><td rowspan="2" colspan="1">F:5'-aaaacaacctcttacccaacaccagacccctatccaaaacctgca-3' R:5'-tgcaggttttggataggggtctggtgttgggtaagaggttgtttt-3'</td></tr><tr><td rowspan="1" colspan="1">195-197</td><td rowspan="1" colspan="1">TPR</td><td rowspan="1" colspan="1"><italic>[pS/pT]</italic>X[R/K]</td><td rowspan="1" colspan="1">PKC</td><td rowspan="1" colspan="1">A589G_G590A_G591C</td></tr></tbody></table></table-wrap></floats-wrap></article>