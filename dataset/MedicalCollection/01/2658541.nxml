r" valign="top" charoff="50">4.08E&#x02212;13</td><td align="char" valign="top" char="." charoff="50">&#x02212;2.03</td></tr><tr><td align="left" valign="top" charoff="50"><italic>SSBP2</italic></td><td align="char" valign="top" char="." charoff="50">23635</td><td align="left" valign="top" charoff="50">203787_at</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="center" valign="top" charoff="50">1.93E&#x02212;07</td><td align="char" valign="top" char="." charoff="50">&#x02212;1.23</td><td align="center" valign="top" charoff="50">1.29E&#x02212;12</td><td align="char" valign="top" char="." charoff="50">&#x02212;2.47</td></tr><tr><td align="left" valign="top" charoff="50"><italic>VDR</italic></td><td align="char" valign="top" char="." charoff="50">7421</td><td align="left" valign="top" charoff="50">204254_s_at</td><td align="left" valign="top" charoff="50">T00885</td><td align="left" valign="top" charoff="50">Cys4 zinc finger of nuclear receptor type</td><td align="center" valign="top" charoff="50">2.43E&#x02212;06</td><td align="char" valign="top" char="." charoff="50">&#x02212;1.20</td><td align="center" valign="top" charoff="50">4.03E&#x02212;08</td><td align="char" valign="top" char="." charoff="50">&#x02212;1.36</td></tr><tr><td align="left" valign="top" charoff="50"><italic>ZBTB16</italic></td><td align="char" valign="top" char="." charoff="50">7704</td><td align="left" valign="top" charoff="50">205883_at</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">C2H2 zinc finger<sup>g</sup></td><td align="center" valign="top" charoff="50">6.86E&#x02212;08</td><td align="char" valign="top" char="." charoff="50">&#x02212;1.32</td><td align="center" valign="top" charoff="50">6.74E&#x02212;13</td><td align="char" valign="top" char="." charoff="50">&#x02212;1.36</td></tr><tr><td align="left" valign="top" charoff="50"><italic>ARNTL2</italic></td><td align="char" valign="top" char="." charoff="50">56938</td><td align="left" valign="top" charoff="50">220658_s_at</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">Basic helix&#x02013;loop&#x02013;helix<sup>g</sup></td><td align="center" valign="top" charoff="50">1.74E&#x02212;05</td><td align="char" valign="top" char="." charoff="50">1.58</td><td align="center" valign="top" charoff="50">2.28E&#x02212;06</td><td align="char" valign="top" char="." charoff="50">1.93</td></tr><tr><td align="left" valign="top" charoff="50"><italic>BHLHB2</italic></td><td align="char" valign="top" char="." charoff="50">8553</td><td align="left" valign="top" charoff="50">201170_s_at</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">Basic helix&#x02013;loop&#x02013;helix<sup>g</sup></td><td align="center" valign="top" charoff="50">5.07E&#x02212;08</td><td align="char" valign="top" char="." charoff="50">1.96</td><td align="center" valign="top" charoff="50">1.29E&#x02212;11</td><td align="char" valign="top" char="." charoff="50">2.01</td></tr><tr><td align="left" valign="top" charoff="50"><italic>CBFB</italic></td><td align="char" valign="top" char="." charoff="50">865</td><td align="left" valign="top" charoff="50">202370_s_at</td><td align="left" valign="top" charoff="50">T02259</td><td align="left" valign="top" charoff="50">CBF_beta</td><td align="center" valign="top" charoff="50">2.12E&#x02212;06</td><td align="char" valign="top" char="." charoff="50">1.32</td><td align="center" valign="top" charoff="50">1.49E&#x02212;13</td><td align="char" valign="top" char="." charoff="50">1.49</td></tr><tr><td align="left" valign="top" charoff="50"><italic>CBX4</italic></td><td align="char" valign="top" char="." charoff="50">8535</td><td align="left" valign="top" charoff="50">206724_at</td><td align="left" valign="top" charoff="50">&#x000a0;</td><td align="left" valign="top" charoff="50">&#x00