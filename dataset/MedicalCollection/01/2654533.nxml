</pub-id></citation></ref><ref id="b12-ndt-3-117"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>van den Broek</surname><given-names>M</given-names></name><name><surname>Beghi</surname><given-names>E</given-names></name></person-group><collab>for the RESt-1 group</collab><year>2004</year><article-title>Accidents in patients with epilepsy: types, circumstances and complications: a European cohort study</article-title><source>Epilepsia</source><volume>45</volume><fpage>667</fpage><lpage>72</lpage><pub-id pub-id-type="pmid">15144432</pub-id></citation></ref><ref id="b13-ndt-3-117"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bosley</surname><given-names>CM</given-names></name><name><surname>Fosbury</surname><given-names>JA</given-names></name><name><surname>Cochrane</surname><given-names>GM</given-names></name></person-group><year>1995</year><article-title>The psychological factors associated with poor compliance with treatment in asthma</article-title><source>Eur Respir J</source><volume>8</volume><fpage>899</fpage><lpage>904</lpage><pub-id pub-id-type="pmid">7589375</pub-id></citation></ref><ref id="b14-ndt-3-117"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Browne</surname><given-names>TR</given-names></name><name><surname>Holmes</surname><given-names>GL</given-names></name></person-group><year>2004</year><source>Handbook of epilepsy</source><edition>3rd ed</edition><publisher-loc>Philadelphia</publisher-loc><publisher-name>Lippincott Williams and Wilkins</publisher-name></citation></ref><ref id="b15-ndt-3-117"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buck</surname><given-names>D</given-names></name><name><surname>Baker</surname><given-names>GA</given-names></name><name><surname>Jacoby</surname><given-names>A</given-names></name><etal/></person-group><year>1997a</year><article-title>Patients&#x02019; experiences of injury as a result of epilepsy</article-title><source>Epilepsia</source><volume>38</volume><fpage>439</fpage><lpage>44</lpage><pub-id pub-id-type="pmid">9118849</pub-id></citation></ref><ref id="b16-ndt-3-117"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buck</surname><given-names>D</given-names></name><name><surname>Jacoby</surname><given-names>A</given-names></name><name><surname>Baker</surname><given-names>GA</given-names></name><etal/></person-group><year>1997b</year><article-title>Factors influencing compliance with antiepileptic drug regimes</article-title><source>Seizure</source><volume>6</volume><fpage>87</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">9153719</pub-id></citation></ref><ref id="b17-ndt-3-117"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Buelow</surname><given-names>JM</given-names></name><name><surname>Smith</surname><given-names>MC</given-names></name></person-group><year>2004</year><article-title>Medication management by the person with epilepsy: perception versus reality</article-title><source>Epilepsy Behav</source><volume>5</volume><fpage>401</fpage><lpage>6</lpage><pub-id pub-id-type="pmid">15145311</pub-id></citation></ref><ref id="b18-ndt-3-117"><citation citation-type="book"><person-group person-group-type="author"><name><surname>Carter</surname><given-names>S</given-names></name><name><surname>Taylor</surname><given-names>D</given-names></name><name><surname>Levenson</surname><given-names>R</given-names></name></person-group><year>2005</year><source>A question of choice &#x02013; compliance in medicine taking a preliminary review</source><edition>3rd ed</edition><publisher-name>Medicines Partnership Task Force, Department of Health</publisher-name></citation></ref><ref id="b19-ndt-3-117"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Casebeer</surname><given-names>AL</given