="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Balcezak</surname><given-names>TJ</given-names></name><name><surname>Lynch</surname><given-names>P</given-names></name><name><surname>Jackson</surname><given-names>S</given-names></name><name><surname>Richter</surname><given-names>J</given-names></name><name><surname>Jaffe</surname><given-names>CC</given-names></name><name><surname>Cadman</surname><given-names>EC</given-names></name></person-group><article-title>A web-based risk management and medical-legal curriculum for graduate medical education</article-title><source>J Biocommun</source><year>1998</year><volume>25</volume><fpage>2</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">9924687</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Lowdermilk</surname><given-names>DL</given-names></name><name><surname>Hopkins</surname><given-names>FA</given-names></name></person-group><article-title>Computer simulations as a measure of nursing students' decision-making skills</article-title><source>J Nurs Educ</source><year>1991</year><volume>30</volume><fpage>34</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">1847408</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>DiBartola</surname><given-names>LM</given-names></name><name><surname>Miller</surname><given-names>MK</given-names></name><name><surname>Turley</surname><given-names>CL</given-names></name></person-group><article-title>Do learning styles and learning environment affect learning outcome?</article-title><source>J Allied Health</source><year>2001</year><volume>30</volume><fpage>112</fpage><lpage>5</lpage><pub-id pub-id-type="pmid">11398227</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fox</surname><given-names>CR</given-names></name><name><surname>Kirk</surname><given-names>SE</given-names></name></person-group><article-title>Subspecialty training in the ambulatory clinic: a preliminary investigation of an endocrinology curriculum</article-title><source>Acad Med</source><year>2003</year><volume>78</volume><fpage>1170</fpage><lpage>1174</lpage><pub-id pub-id-type="pmid">14604882</pub-id><pub-id pub-id-type="doi">10.1097/00001888-200311000-00020</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Fincher</surname><given-names>RM</given-names></name><name><surname>Lewis</surname><given-names>LA</given-names></name><name><surname>Kuske</surname><given-names>TT</given-names></name></person-group><article-title>Relationships of interns' performances to their self-assessments of their preparedness for internship and to their academic performances in medical school</article-title><source>Acad Med</source><year>1993</year><volume>68</volume><fpage>S47</fpage><lpage>S50</lpage><pub-id pub-id-type="pmid">8431253</pub-id></citation></ref><ref id="B17"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Zonia</surname><given-names>SC</given-names></name><name><surname>Stommel</surname><given-names>M</given-names></name></person-group><article-title>Interns' self-evaluations compared with their faculty's evaluations</article-title><source>Acad Med</source><year>2000</year><volume>75</volume><fpage>742</fpage><pub-id pub-id-type="pmid">10926027</pub-id><pub-id pub-id-type="doi">10.1097/00001888-200007000-00020</pub-id></citation></ref><ref id="B18"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cook</surname><given-names>DA</given-names></name><name><surname>Dupras</surname><given-names>DM</given-names></name></person-group><article-title>A practical guide to developing effective Web-based learning</article-title><source>J Gen Intern Med</source><year>2004</year><volume>19</volume><fpage>698</fpage><lpage>707</lpage><pub-id pub-id-type="pmid">15209610</pub-id><pub-id pub-id-type="doi">10.1111/j.1525-1497.2004.30029.x</pub-id></citation></ref><ref id="B19"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Cook</surname><given-names>DA</given-names></name><name><surname>Thompson</surname><given-names>WG</given-names></name><name><surname>Thomas</surname><given-names>KG</given-names></name><name><surname>Thomas</surname><given-names>MR</given-names></name><name><surname>Pankratz</surname><given-names>VS</given-names></name></person-group><article-title>Impact of self-assessment questions and learning styles in web-based learning: a randomized, controlled crossover trial</article-title><source>Acad Med</source><year>2006</year><volume>81</volume><fpage>231</fpage><lpage>238</lpage><pub-id pub-id-type="pmid">16501263</pub-id><pub-id pub-id-type="doi">10.1097/00001888-200603000-00005</pub-id></citation></ref><ref id="B20"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Friedman</surname><given-names>CP</given-names></name></person-group><article-title>Anatomy of the clinical simulation</article-title><source>Acad Med</source><year>1995</year><volume>70</volume><fpage>205</fpage><lpage>209</lpage><pub-id pub-id-type="pmid">7873008</pub-id><pub-id pub-id-type="doi">10.1097/00001888-199503000-00011</pub-id></citation></ref></ref-list></back></article>