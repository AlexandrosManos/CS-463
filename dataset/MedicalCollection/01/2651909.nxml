><name><surname>Ishimaru</surname><given-names>T</given-names></name><name><surname>Mc Gregor</surname><given-names>DH</given-names></name><name><surname>Akada</surname><given-names>H</given-names></name><name><surname>Steer</surname><given-names>A</given-names></name></person-group><article-title>Autopsy study of granulocytic sarcoma (chloroma) in patients with myelogenous leukemia, Hiroshima- Nagasaki 1949&#x02013;1969</article-title><source>Cancer</source><year>1973</year><volume>31</volume><fpage>948</fpage><lpage>55</lpage><pub-id pub-id-type="pmid">4513297</pub-id><pub-id pub-id-type="doi">10.1002/1097-0142(197304)31:4&#x0003c;948::AID-CNCR2820310428&#x0003e;3.0.CO;2-N</pub-id></citation></ref><ref id="B12"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Panda</surname><given-names>A</given-names></name><name><surname>Dayal</surname><given-names>Y</given-names></name></person-group><article-title>Acute proptosis in myeloid leukaemia</article-title><source>Indian J Ophthalmol</source><year>1984</year><volume>34</volume><fpage>239</fpage><lpage>41</lpage><pub-id pub-id-type="pmid">6599841</pub-id></citation></ref><ref id="B13"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Vemuganti</surname><given-names>GK</given-names></name><name><surname>Naik</surname><given-names>M</given-names></name><name><surname>Honavar</surname><given-names>SG</given-names></name><name><surname>Shekar</surname><given-names>GC</given-names></name></person-group><article-title>Rapid Intraoperative Diagnosis of Tumors of the Eye and Orbit by Squash and Imprint Cytology</article-title><source>Ophthalmology</source><year>2004</year><volume>111</volume><fpage>1009</fpage><lpage>1015</lpage><pub-id pub-id-type="pmid">15121381</pub-id><pub-id pub-id-type="doi">10.1016/j.ophtha.2003.08.041</pub-id></citation></ref><ref id="B14"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Bidar</surname><given-names>M</given-names></name><name><surname>Wilson</surname><given-names>MW</given-names></name><name><surname>Laquis</surname><given-names>SJ</given-names></name><etal></etal></person-group><article-title>Clincal and imaging characteristics of orbital leukemic tumors</article-title><source>Ophthal Plast Reconstr Surg</source><year>2007</year><volume>23</volume><fpage>87</fpage><lpage>93</lpage><pub-id pub-id-type="pmid">17413619</pub-id><pub-id pub-id-type="doi">10.1097/IOP.0b013e3180333a85</pub-id></citation></ref><ref id="B15"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Mc Carty</surname><given-names>KS</given-names><suffix>Jr</suffix></name><name><surname>Wortmen</surname><given-names>J</given-names></name><name><surname>Daly</surname><given-names>J</given-names></name><name><surname>Rundles</surname><given-names>RW</given-names></name><name><surname>Hanker</surname><given-names>JS</given-names></name></person-group><article-title>Chloroma without evidence of leukemia: facilitated light microscopic diagnosis</article-title><source>Blood</source><year>1980</year><volume>56</volume><fpage>104</fpage><lpage>108</lpage><pub-id pub-id-type="pmid">6155960</pub-id></citation></ref><ref id="B16"><citation citation-type="journal"><person-group person-group-type="author"><name><surname>Neiman</surname><given-names>RS</given-names></name><name><surname>Barcos</surname><given-names>M</given-names></name><name><surname>Berard</surname><given-names>C</given-names></name><etal></etal></person-group><article-title>Granulocytic sarcoma: a clinicopathologic study of 61 biopsied cases</article-title><source>Cancer</source><year>1981</year><volume>48</volume><fpage>1426</fpage><lpage>37</lpage><pub-id pub-id-type="pmid">7023656</pub-id><pub-id pub-id-type="doi">10.1002/1097-0142(19810915)48:6&#x0003c;1426::AID-CNCR2820480626&#x0003e;3.0.CO;2-G</pub-id></citation></ref></ref-list></back></article>